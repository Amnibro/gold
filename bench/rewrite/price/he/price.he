namespace price
use regex
use os
isdig(c byte) bool: c >= '0' && c <= '9'
struct OcrLine { text byte[..256], left int, top int, right int, bottom int }
height(l OcrLine) int: l.bottom - l.top
center_y(l OcrLine) f32: ((l.top + l.bottom) / 2) as f32
money_format(cents int) byte[>..]:
	out byte[>..] ~= []
	a ~= cents
	if cents < 0: a = -cents; out.push('-')
	ds byte[>..] ~= []
	format(ds, a / 100)
	out.push('$')
	for i ds.len:
		if i > 0 && (ds.len - i) % 3 == 0: out.push(',')
		out.push(ds[i])
	c := a % 100
	out.push('.')
	out.push(('0' + c / 10) as byte)
	out.push(('0' + c % 10) as byte)
	out
money_parse(text byte[:]) int, bool:
	k byte[>..] ~= []
	has_dot ~= false
	for ch text:
		if isdig(ch) || ch == '.' || ch == ',' || ch == '-': k.push(ch)
		if ch == '.': has_dot = true
	if k.len == 0: return 0, false
	s byte[>..] ~= []
	for ch k:
		if ch == ',':
			if !has_dot: s.push('.')
		else:
			s.push(ch)
	i ~= 0
	neg ~= false
	if s[0] == '-': neg = true; i = 1
	ip ~= 0
	nd ~= 0
	while i < s.len && isdig(s[i]):
		ip = ip * 10 + ((s[i] as int) - '0')
		nd += 1
		i += 1
	f ~= 0
	fd ~= 0
	if i < s.len && s[i] == '.':
		i += 1
		while i < s.len && isdig(s[i]):
			if fd < 3: f = f * 10 + ((s[i] as int) - '0')
			fd += 1
			nd += 1
			i += 1
	if i != s.len || nd == 0: return 0, false
	n3 ~= min(fd, 3)
	while n3 < 3: f *= 10; n3 += 1
	c := ip * 100 + f / 10 + (if f % 10 >= 5 { 1 } else { 0 })
	if neg: return -c, true
	return c, true
money_plain(cents int) byte[>..]:
	out byte[>..] ~= []
	a ~= cents
	if cents < 0: a = -cents; out.push('-')
	format(out, a / 100)
	c := a % 100
	out.push('.')
	out.push(('0' + c / 10) as byte)
	out.push(('0' + c % 10) as byte)
	out
enum BaseUnit { GRAM, MILLILITER, COUNT }
struct Quantity { amount real, base BaseUnit, source byte[..64] }
base_kind(b BaseUnit) int:
	match b:
		GRAM => 0
		MILLILITER => 1
		COUNT => 2
unit_factor(unit byte[:]) real, BaseUnit, bool:
	k byte[>..] ~= []
	for ch unit:
		if ch == '.' || ch == ' ': continue
		k.push(if ch >= 'A' && ch <= 'Z' { ch + 32 } else { ch })
	if k == "floz": return 29.5735, BaseUnit.MILLILITER, true
	if k == "oz": return 28.3495, BaseUnit.GRAM, true
	if k == "lb" || k == "lbs": return 453.592, BaseUnit.GRAM, true
	if k == "kg": return 1000.0, BaseUnit.GRAM, true
	if k == "g" || k == "gr": return 1.0, BaseUnit.GRAM, true
	if k == "mg": return 0.001, BaseUnit.GRAM, true
	if k == "ml": return 1.0, BaseUnit.MILLILITER, true
	if k == "l" || k == "ltr" || k == "liter" || k == "liters" || k == "litre" || k == "litres": return 1000.0, BaseUnit.MILLILITER, true
	if k == "gal": return 3785.41, BaseUnit.MILLILITER, true
	if k == "qt": return 946.353, BaseUnit.MILLILITER, true
	if k == "pt": return 473.176, BaseUnit.MILLILITER, true
	if k == "ct" || k == "count" || k == "pk" || k == "pack" || k == "ea": return 1.0, BaseUnit.COUNT, true
	return 0.0, BaseUnit.COUNT, false
lower_copy(s byte[:]) byte[>..]:
	out byte[>..] ~= []
	for ch s: out.push(if ch >= 'A' && ch <= 'Z' { ch + 32 } else { ch })
	out
var re_unit regex::Regex
var mc_unit regex::Machine
rd_unit ~= false
unit_parse(text byte[:]) Quantity, bool:
	if trim(text).len == 0: return default<Quantity>(), false
	if !rd_unit: re_unit = regex::compile("(\\d+([.,]\\d+)?)\\s*(fl\\.?\\s*oz|oz|lbs?|kg|g|gr|mg|ml|l|ltr|liters?|litres?|gal|qt|pt|ct|count|pk|pack|ea)\\b"); rd_unit = true
	lo := lower_copy(text)
	if !regex::run(re_unit, mc_unit, lo, 0): return default<Quantity>(), false
	s := mc_unit.best[0]
	e := mc_unit.best[1]
	num byte[>..] ~= []
	for i mc_unit.best[2]..mc_unit.best[3]:
		num.push(if lo[i] == ',' { '.' } else { lo[i] })
	amt, aok := parse_flt(num)
	if !aok || amt <= 0.0: return default<Quantity>(), false
	f, bu, fok := unit_factor(lo[mc_unit.best[6]..mc_unit.best[7]])
	if !fok: return default<Quantity>(), false
	mt := trim(text[s..e])
	q ~= Quantity{amount: amt * f, base: bu, ..}
	q.source.append(mt[..min(mt.len, 64)])
	return q, true
default_imperial() bool:
	v byte[>..] ~= []
	if !env("LC_ALL", v) || v.len == 0:
		v.clear()
		if !env("LANG", v): return true
	u ~= -1
	for i v.len:
		if v[i] == '_' && u < 0: u = i
	if u < 0 || u + 2 >= v.len: return true
	a := v[u + 1] | 32
	b := v[u + 2] | 32
	if a < 'a' || a > 'z' || b < 'a' || b > 'z': return true
	(a == 'u' && b == 's') || (a == 'l' && b == 'r') || (a == 'm' && b == 'm')
rung_of(base BaseUnit, imperial bool, i int) real, const byte[:]:
	k := base_kind(base)
	if k == 0:
		if imperial:
			if i == 0: return 28.3495, "oz"
			return 453.592, "lb"
		if i == 0: return 100.0, "100 g"
		return 1000.0, "kg"
	if k == 1:
		if imperial:
			if i == 0: return 29.5735, "fl oz"
			return 946.353, "qt"
		if i == 0: return 100.0, "100 ml"
		return 1000.0, "L"
	return 1.0, "ea"
unit_price_label(price int, q Quantity, imperial bool = default_imperial()) byte[>..]:
	p0, l0 := rung_of(q.base, imperial, 0)
	p1, l1 := rung_of(q.base, imperial, 1)
	use0 := price * p0 / q.amount >= 10.0
	per := if use0 { p0 } else { p1 }
	label := if use0 { l0 } else { l1 }
	v := price * per / q.amount
	x := v + 0.5
	t ~= x as int
	if (t as real) > x: t -= 1
	out ~= money_format(t)
	out.append(" / ")
	out.append(label)
	out
price_per_base(price int, q Quantity) real: price / q.amount
struct PriceCandidate { cents int, score f32, is_unit bool, line byte[..256] }
struct ShelfTagResult { price int, has_price bool, name byte[..256], has_name bool, size byte[..64], has_size bool, on_sale bool, candidates PriceCandidate[>..] }
var re_multi_for regex::Regex
var mc_multi_for regex::Machine
rd_multi_for ~= false
init_multi_for(): if !rd_multi_for: re_multi_for = regex::compile("(\\d{1,2})\\s*for\\s*\\$?\\s*(\\d{1,4}([.,]\\d{2})?)"); rd_multi_for = true
var re_multi_slash regex::Regex
var mc_multi_slash regex::Machine
rd_multi_slash ~= false
init_multi_slash(): if !rd_multi_slash: re_multi_slash = regex::compile("(\\d{1,2})\\s*/\\s*\\$\\s*(\\d{1,4}([.,]\\d{2})?)"); rd_multi_slash = true
var re_decimal regex::Regex
var mc_decimal regex::Machine
rd_decimal ~= false
init_decimal(): if !rd_decimal: re_decimal = regex::compile("\\$?\\s*(\\d{1,4})\\s?[.,]\\s?(\\d{2})"); rd_decimal = true
var re_dsc regex::Regex
var mc_dsc regex::Machine
rd_dsc ~= false
init_dsc(): if !rd_dsc: re_dsc = regex::compile("\\$\\s*(\\d{1,3})\\s+(\\d{2})"); rd_dsc = true
var re_dwhole regex::Regex
var mc_dwhole regex::Machine
rd_dwhole ~= false
init_dwhole(): if !rd_dwhole: re_dwhole = regex::compile("\\$\\s*(\\d{1,4})"); rd_dwhole = true
var re_bare_spaced regex::Regex
var mc_bare_spaced regex::Machine
rd_bare_spaced ~= false
init_bare_spaced(): if !rd_bare_spaced: re_bare_spaced = regex::compile("^\\s*(\\d{1,2})\\s+(\\d{2})\\s*$"); rd_bare_spaced = true
var re_bare_run regex::Regex
var mc_bare_run regex::Machine
rd_bare_run ~= false
init_bare_run(): if !rd_bare_run: re_bare_run = regex::compile("^\\s*(\\d{3,4})\\s*$"); rd_bare_run = true
var re_split_dollars regex::Regex
var mc_split_dollars regex::Machine
rd_split_dollars ~= false
init_split_dollars(): if !rd_split_dollars: re_split_dollars = regex::compile("^\\s*\\$?\\s*(\\d{1,2})\\s*$"); rd_split_dollars = true
var re_split_cents regex::Regex
var mc_split_cents regex::Machine
rd_split_cents ~= false
init_split_cents(): if !rd_split_cents: re_split_cents = regex::compile("^\\s*(\\d{2})\\s*(¢|c)?\\s*$"); rd_split_cents = true
var re_cents regex::Regex
var mc_cents regex::Machine
rd_cents ~= false
init_cents(): if !rd_cents: re_cents = regex::compile("(\\d{1,2})\\s*(¢|c)"); rd_cents = true
var re_name_noise regex::Regex
var mc_name_noise regex::Machine
rd_name_noise ~= false
init_name_noise(): if !rd_name_noise: re_name_noise = regex::compile("\\b(price|everyday|rewards?|you pay|with card|limit|guiding stars?|each|ea|per|retail|aisle|shelf)\\b"); rd_name_noise = true
var re_unit_hint regex::Regex
var mc_unit_hint regex::Machine
rd_unit_hint ~= false
init_unit_hint(): if !rd_unit_hint: re_unit_hint = regex::compile("(\\bper\\b|/\\s*(oz|lb|kg|g|ml|l|ct|each|ea|100\\s?g|100\\s?ml|fl\\s?oz|qt|gal)\\b|unit\\s*price)"); rd_unit_hint = true
var re_sale_hint regex::Regex
var mc_sale_hint regex::Machine
rd_sale_hint ~= false
init_sale_hint(): if !rd_sale_hint: re_sale_hint = regex::compile("\\b(sale|save|savings|special|deal|clearance|rollback|bogo|promo|\\d+%\\s*off)\\b"); rd_sale_hint = true
var re_noise_hint regex::Regex
var mc_noise_hint regex::Machine
rd_noise_hint ~= false
init_noise_hint(): if !rd_noise_hint: re_noise_hint = regex::compile("\\b(sku|upc|plu|item\\s*#|reg(ular)?\\s*price|was)\\b"); rd_noise_hint = true
var re_barcode regex::Regex
var mc_barcode regex::Machine
rd_barcode ~= false
init_barcode(): if !rd_barcode: re_barcode = regex::compile("^[IlL1|!iNMHVWUJ\\[\\]]{6,}$"); rd_barcode = true
has_unit_hint(text byte[:]) bool:
	init_unit_hint()
	lo := lower_copy(text)
	regex::run(re_unit_hint, mc_unit_hint, lo, 0)
has_noise_hint(text byte[:]) bool:
	init_noise_hint()
	lo := lower_copy(text)
	regex::run(re_noise_hint, mc_noise_hint, lo, 0)
has_name_noise(text byte[:]) bool:
	init_name_noise()
	lo := lower_copy(text)
	regex::run(re_name_noise, mc_name_noise, lo, 0)
has_sale_hint(text byte[:]) bool:
	init_sale_hint()
	lo := lower_copy(text)
	regex::run(re_sale_hint, mc_sale_hint, lo, 0)
fully(re regex::Regex&, m regex::Machine&, s byte[:]) bool:
	if !regex::run(re, m, s, 0): return false
	m.best[0] == 0 && m.best[1] == s.len
bad_before(kind int, c byte) bool:
	if kind == 1: return isdig(c)
	if kind == 2: return isdig(c) || c == '.' || c == ','
	if kind == 4: return isdig(c) || c == '.'
	return false
bad_after(kind int, c byte) bool:
	if kind == 1: return isdig(c)
	if kind == 2: return isdig(c) || c == '%'
	if kind == 3: return isdig(c) || c == '.' || c == ','
	if kind == 5: return c >= 'a' && c <= 'z'
	return false
find_chk(re regex::Regex&, m regex::Machine&, text byte[:], st int, bk int, ak int) bool:
	at ~= st
	while at <= text.len:
		if !regex::run(re, m, text, at): return false
		s := m.best[0]
		e := m.best[1]
		if s > 0 && bad_before(bk, text[s - 1]): at = s + 1; continue
		if e < text.len && bad_after(ak, text[e]): at = s + 1; continue
		return true
	return false
struct Cand { cents int, bonus f32 }
dval(s byte[:]) int:
	v ~= 0
	for ch s: v = v * 10 + ((ch as int) - '0')
	v
is_free(used int[:], s int, e int) bool:
	i ~= 0
	while i + 1 < used.len:
		if s < used[i + 1] && used[i] < e: return false
		i += 2
	return true
push_c(out Cand[>..]&, used int[>..]&, cents int, b f32, s int, e int):
	out.push(Cand{cents: cents, bonus: b})
	used.push(s)
	used.push(e);
find_multi(re regex::Regex&, m regex::Machine&, text byte[:], st int) int, int, int, bool:
	at ~= st
	while at <= text.len:
		if !regex::run(re, m, text, at): return 0, 0, 0, false
		s := m.best[0]
		e ~= m.best[1]
		a1 ~= m.best[5]
		if s > 0 && isdig(text[s - 1]): at = s + 1; continue
		if e < text.len && isdig(text[e]):
			cut ~= -1
			for i m.best[4]..a1:
				if text[i] == '.' || text[i] == ',': cut = i
			if cut < 0: at = s + 1; continue
			e = cut
			a1 = cut
		return s, e, a1, true
	return 0, 0, 0, false
add_multi(re regex::Regex&, m regex::Machine&, lo byte[:], out Cand[>..]&, used int[>..]&):
	at ~= 0
	while at <= lo.len:
		s, e, a1, ok := find_multi(re, m, lo, at)
		if !ok: break
		q, qok := parse_int(lo[m.best[2]..m.best[3]])
		t, tok := money_parse(lo[m.best[4]..a1])
		if qok && tok && q > 0 && is_free(used, s, e): push_c(out, used, (t + q / 2) / q, 0.4 as f32, s, e)
		at = max(e, s + 1)
step_decimal(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_decimal()
	at ~= 0
	while at <= lo.len && find_chk(re_decimal, mc_decimal, lo, at, 2, 2):
		s := mc_decimal.best[0]
		e := mc_decimal.best[1]
		g1 := dval(lo[mc_decimal.best[2]..mc_decimal.best[3]])
		g2 := dval(lo[mc_decimal.best[4]..mc_decimal.best[5]])
		if is_free(used, s, e):
			dollar ~= false
			for i s..e:
				if lo[i] == '$': dollar = true
			bonus := if dollar { 0.3 as f32 } else { 0.1 as f32 }
			push_c(out, used, g1 * 100 + g2, bonus, s, e)
		at = max(e, s + 1)
step_dsc(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_dsc()
	at ~= 0
	while at <= lo.len && find_chk(re_dsc, mc_dsc, lo, at, 0, 1):
		s := mc_dsc.best[0]
		e := mc_dsc.best[1]
		g1 := dval(lo[mc_dsc.best[2]..mc_dsc.best[3]])
		g2 := dval(lo[mc_dsc.best[4]..mc_dsc.best[5]])
		if is_free(used, s, e): push_c(out, used, g1 * 100 + g2, 0.25 as f32, s, e)
		at = max(e, s + 1)
step_dwhole(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_dwhole()
	at ~= 0
	while at <= lo.len && find_chk(re_dwhole, mc_dwhole, lo, at, 0, 3):
		s := mc_dwhole.best[0]
		e := mc_dwhole.best[1]
		g1 := dval(lo[mc_dwhole.best[2]..mc_dwhole.best[3]])
		nd := mc_dwhole.best[3] - mc_dwhole.best[2]
		if is_free(used, s, e): push_c(out, used, if nd >= 3 { g1 } else { g1 * 100 }, 0.15 as f32, s, e)
		at = max(e, s + 1)
step_bare_spaced(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_bare_spaced()
	if regex::run(re_bare_spaced, mc_bare_spaced, lo, 0):
		s := mc_bare_spaced.best[0]
		e := mc_bare_spaced.best[1]
		g1 := dval(lo[mc_bare_spaced.best[2]..mc_bare_spaced.best[3]])
		g2 := dval(lo[mc_bare_spaced.best[4]..mc_bare_spaced.best[5]])
		if is_free(used, s, e): push_c(out, used, g1 * 100 + g2, 0.2 as f32, s, e);
step_bare_run(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_bare_run()
	if regex::run(re_bare_run, mc_bare_run, lo, 0):
		s := mc_bare_run.best[0]
		e := mc_bare_run.best[1]
		g1 := dval(lo[mc_bare_run.best[2]..mc_bare_run.best[3]])
		if is_free(used, s, e): push_c(out, used, g1, (-0.05) as f32, s, e);
step_cents(lo byte[:], used int[>..]&, out Cand[>..]&):
	init_cents()
	at ~= 0
	while at <= lo.len && find_chk(re_cents, mc_cents, lo, at, 4, 5):
		s := mc_cents.best[0]
		e := mc_cents.best[1]
		g1 := dval(lo[mc_cents.best[2]..mc_cents.best[3]])
		if is_free(used, s, e): push_c(out, used, g1, 0.1 as f32, s, e)
		at = max(e, s + 1)
candidates_in(text byte[:]) Cand[>..]:
	out Cand[>..] ~= []
	used int[>..] ~= []
	lo := lower_copy(text)
	init_multi_for()
	add_multi(re_multi_for, mc_multi_for, lo, out, used)
	init_multi_slash()
	add_multi(re_multi_slash, mc_multi_slash, lo, out, used)
	step_decimal(lo, used, out)
	step_dsc(lo, used, out)
	step_dwhole(lo, used, out)
	step_bare_spaced(lo, used, out)
	step_bare_run(lo, used, out)
	step_cents(lo, used, out)
	out
same_line(x OcrLine, y OcrLine) bool: x.text == y.text && x.left == y.left && x.top == y.top && x.right == y.right && x.bottom == y.bottom
join_superscript(lines OcrLine[:]) OcrLine[>..]:
	init_split_dollars()
	init_split_cents()
	used bool[>..] ~= []
	for i lines.len: used.push(false)
	em OcrLine[>..] ~= []
	cp bool[>..] ~= []
	for ai lines.len:
		if used[ai]: continue
		let a .= lines[ai]
		if !regex::run(re_split_dollars, mc_split_dollars, a.text, 0):
			em.push(a)
			cp.push(true)
			continue
		d byte[>..] ~= []
		d.append(a.text[mc_split_dollars.best[2]..mc_split_dollars.best[3]])
		ah := height(a)
		found ~= -1
		cents byte[>..] ~= []
		if ah > 0:
			lim := max((ah * 0.8) as int, 2)
			acyr := center_y(a) as real
			for bi lines.len:
				if found >= 0: break
				if bi == ai || used[bi]: continue
				let b .= lines[bi]
				bh := height(b)
				if bh < 1 || bh >= lim: continue
				if b.left < a.right - ah / 3: continue
				if b.left - a.right > ah: continue
				cy := center_y(b) as real
				if cy < a.top - ah * 0.3 || cy > acyr + ah * 0.15: continue
				lo := lower_copy(b.text)
				if !regex::run(re_split_cents, mc_split_cents, lo, 0): continue
				cents.append(lo[mc_split_cents.best[2]..mc_split_cents.best[3]])
				found = bi
		if found >= 0:
			used[found] = true
			nl ~= OcrLine{left: a.left, top: a.top, right: lines[found].right, bottom: a.bottom, ..}
			nl.text.append("$")
			nl.text.append(d)
			nl.text.append(".")
			nl.text.append(cents)
			em.push(nl)
			cp.push(false)
		else:
			em.push(a)
			cp.push(true)
	res OcrLine[>..] ~= []
	for k em.len:
		drop ~= false
		if cp[k]:
			for j lines.len:
				if used[j] && same_line(lines[j], em[k]): drop = true
		if !drop: res.push(em[k])
	res
guess_name(lines OcrLine[:], price_line byte[:], has_price_line bool) byte[>..], bool:
	out byte[>..] ~= []
	best_i ~= -1
	best_s ~= -1
	init_sale_hint()
	init_barcode()
	for i lines.len:
		let l .= lines[i]
		if has_price_line && l.text == price_line: continue
		if has_unit_hint(l.text) || has_noise_hint(l.text) || has_name_noise(l.text): continue
		t := trim(l.text)
		tl := lower_copy(t)
		if fully(re_sale_hint, mc_sale_hint, tl): continue
		if fully(re_barcode, mc_barcode, t): continue
		letters ~= 0
		total ~= 0
		for ch l.text:
			if (ch & 0xC0) == 0x80: continue
			total += 1
			if ch >= 0x80 || (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z'): letters += 1
		if letters >= 3 && (letters as real) / (total as real) > 0.5:
			sc := max(height(l), 1) * 10 + letters
			if sc > best_s: best_s = sc; best_i = i
	if best_i < 0: return out, false
	out.append(trim(lines[best_i].text))
	return out, true
parse(raw OcrLine[:]) ShelfTagResult:
	res ~= default<ShelfTagResult>()
	if raw.len == 0: return res
	lines := join_superscript(raw)
	mh ~= 1
	for i lines.len: mh = max(mh, height(lines[i]))
	max_h := mh as f32
	for i lines.len:
		let l .= lines[i]
		h := height(l)
		rel := if h > 0 { (h as f32) / max_h } else { 0.5 as f32 }
		unit := has_unit_hint(l.text)
		noise := has_noise_hint(l.text)
		cs := candidates_in(l.text)
		for c cs:
			sc ~= rel + c.bonus
			if unit: sc -= 1.0 as f32
			if noise: sc -= 0.6 as f32
			if c.cents >= 1 && c.cents <= 999999:
				pc ~= PriceCandidate{cents: c.cents, score: sc, is_unit: unit, ..}
				pc.line.append(l.text)
				res.candidates.push(pc)
	bi ~= -1
	for i res.candidates.len:
		let cd .= res.candidates[i]
		if !cd.is_unit && (bi < 0 || cd.score > res.candidates[bi].score): bi = i
	bline byte[>..] ~= []
	if bi >= 0: bline.append(res.candidates[bi].line)
	pool OcrLine[>..] ~= []
	anc ~= -1
	if bi >= 0:
		for i lines.len:
			if anc < 0 && lines[i].text == bline: anc = i
	if anc >= 0:
		ah := height(lines[anc])
		acy := center_y(lines[anc])
		for i lines.len:
			let l .= lines[i]
			if ah <= 0 || (abs(center_y(l) - acy) as real) <= ah * 3.5: pool.push(l)
	else:
		for i lines.len: pool.push(lines[i])
	nm, nok := guess_name(pool, bline, bi >= 0)
	if nok: res.name.append(nm); res.has_name = true
	for i lines.len:
		let l .= lines[i]
		if !res.has_size:
			q, ok := unit_parse(l.text)
			if ok: res.size.append(q.source); res.has_size = true
		if has_sale_hint(l.text): res.on_sale = true
	if bi >= 0: res.price = res.candidates[bi].cents; res.has_price = true
	stable_sort(res.candidates) { a, b => a.score > b.score }
	res
add_line(lines OcrLine[>..]&, s byte[:]):
	if trim(s).len == 0: return
	l ~= default<OcrLine>()
	l.text.append(s[..min(s.len, 256)])
	lines.push(l);
parse_text(text byte[:]) ShelfTagResult:
	lines OcrLine[>..] ~= []
	st ~= 0
	i ~= 0
	while i < text.len:
		c := text[i]
		if c == '\n' || c == '\r':
			add_line(lines, text[st..i])
			if c == '\r' && i + 1 < text.len && text[i + 1] == '\n': i += 1
			st = i + 1
		i += 1
	add_line(lines, text[st..])
	parse(lines)
