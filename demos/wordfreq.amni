struct WC { word byte[..16], count int }
fn top_words(text byte[:], n int) WC[>..] {
	var low byte[>..] = [];
	for c in text {
		if c >= 'A' && c <= 'Z' { low.push(c + 32); } else { low.push(c); }
	}
	var all WC[>..] = [];
	var i = 0;
	while i < low.len {
		if low[i] < 'a' || low[i] > 'z' { i++; continue; }
		let start = i;
		while i < low.len && low[i] >= 'a' && low[i] <= 'z' { i++; }
		let w = low[start..i];
		var found = false;
		for &e in all {
			if e.word == w { e.count += 1; found = true; }
		}
		if !found {
			let e .= all.push(WC { count: 1, .. });
			e.word.append(w);
		}
	}
	sort(all) { a, b => a.count > b.count || (a.count == b.count && compare(a.word, b.word) < 0) };
	var out WC[>..] = [];
	for k in min(n, all.len) { out.push(all[k]); }
	out
}
fn main() {
	let text = "The cat and the hat. The bat sat on the cat!";
	let top = top_words(text, 3);
	for e in top { print(e.word, ": ", e.count); }
	let everything = top_words(text, 1000);
	var total = 0;
	for e in everything { total += e.count; }
	print("total: ", total);
}
