expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,9,4] cache=3 hits=0
test: list=7
expect: cached 1 results
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	print("cached ", g.n, " results");
	out.i = g.n;
	out
}
@end
@entry 7483d6878ba653c1
kind: step
verb: check
noun: errors
modifier: none
context: core
phrase: check errors
phrase: check for errors
phrase: make sure nothing failed
test: input=5 list=1,2,3
expect: no errors in 3 results
expect: => i=5 r=0.0 ok=true s="checked" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: input=0
expect: no errors in 0 results
expect: => i=0 r=0.0 ok=true s="checked" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.errors > 0 {
		print("error: ", g.err, " (", g.errors, " total)");
		out.ok = false;
		out.s.append("failed");
	} else {
		print("no errors in ", g.n, " results");
		out.s.append("checked");
	}
	out
}
@end
