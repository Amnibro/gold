code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var sqCount = 0;
	for i in g.n {
		if ${ID}_is_sq(g.res[i]) { sqCount++; }
	}
	out.i = sqCount * t;
	out.s.clear();
	format(out.s, "found squares: ", out.i);
	g.steps += t;
	out
}
@end
