phrase: truncate list front items {count} times
slot: count int
test: list=10,20,30,40,50 count=2
expect: => i=2 r=0.0 ok=true s="dropped front items" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3 count=1
expect: => i=1 r=0.0 ok=true s="dropped front items" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var shift = k;
	if shift > g.n { shift = g.n; }
	if shift < 0 { shift = 0; }
	let rem = g.n - shift;
	for i in rem {
		g.res[i] = g.res[i + shift];
	}
	g.n = rem;
	g.steps += shift;
	out.i = shift;
	out.s.clear();
	format(out.s, "dropped front items");
	out
}
@end
