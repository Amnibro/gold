code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${length};
	let num = if req < g.n { if req > 0 { req } else { 0 } } else { g.n };
	let start = g.n - num;
	var m = 0;
	var i = 0;
	while i < num {
		let x = g.res[start + i];
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "suffix rotated unique");
	out
}
@end
