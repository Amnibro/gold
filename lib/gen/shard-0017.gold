@entry 5abb733c605bc229
kind: step
verb: drop
noun: histogram
modifier: safely
context: core
phrase: drop histogram counts below frequency threshold {threshold}
phrase: remove elements with histogram occurrence under {threshold}
slot: threshold int
test: list=1,2,2,3,2 threshold=2
expect: => i=3 r=0.0 ok=true s="retained 3" errors=0 n=3 res=[2,2,2] cache=0 hits=0
test: list=5,5,6 threshold=1
expect: => i=3 r=0.0 ok=true s="retained 3" errors=0 n=3 res=[5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == val { freq++; } }
		if freq >= ${threshold} {
			kept[count] = val;
			count++;
		}
	}
	g.n = 0;
	for k in count { gold_push(g, kept[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "retained ", count);
	out
}
@end
