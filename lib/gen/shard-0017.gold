@entry 1f682d6983de8e1e
kind: fn
verb: return
noun: sequence
modifier: pairwise
context: compare
phrase: return pairwise differences across digit sequence
phrase: compute sum of pairwise adjacent digit distances
test: arg=1482,951
expect: 13
expect: 8
test: arg=111,258
expect: 0
expect: 6
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var digits int[..32] = [];
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	var diff_sum = 0;
	var i = digits.len - 1;
	while i > 0 {
		var d = digits[i] - digits[i - 1];
		if d < 0 { d = -d; }
		diff_sum += d;
		i--;
	}
	diff_sum
}
@end
@entry 6a86322c827c1ead
kind: pred
verb: validate
noun: words
modifier: every_other
context: compare
phrase: validate alternating digits satisfy parity condition
phrase: check if every other digit is even in compare value
test: arg=21436,2244
expect: true
expect: true
test: arg=1234,80808
expect: false
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return true; }
	var digits int[..32] = [];
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	var i = digits.len - 1;
	var step = 0;
	while i >= 0 {
		if step % 2 == 0 {
			if digits[i] % 2 != 0 { return false; }
		}
		step++;
		if i == 0 { break; }
		i--;
	}
	true
}
@end
