fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var modified = 0;
	for i in g.n {
		if g.res[i] < b {
			g.res[i] = b;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped at_least");
	out
}
@end
@entry ff6f73ba36cbece2
kind: step
verb: limit
noun: tally
modifier: recursively
context: loop
phrase: limit tally recursively until under {max_tally}
phrase: reduce tally recursively below limit {max_tally}
slot: max_tally int
test: list=10,20,30,40 max_tally=50
expect: => i=2 r=0.0 ok=true s="limited tally recursively" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 max_tally=30
expect: => i=1 r=0.0 ok=true s="limited tally recursively" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_tally};
	var passes = 0;
	while passes < 50 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum <= lim || g.n == 0 { break; }
		g.n--;
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "limited tally recursively");
	out
}
@end
