		var exists = false;
		for j in u { if seen[j] == x { exists = true; break; } }
		if !exists { seen[u] = x; u++; }
	}
	out.i = u;
	out.s.clear();
	format(out.s, "unique retry count: ", u);
	g.steps += u;
	out
}
@end
