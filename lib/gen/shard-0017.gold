@entry 7e1d400e999327d1
kind: step
verb: swap
noun: series
modifier: every_other
context: list
phrase: swap series every other element separated by {step}
phrase: swap alternating items with stride {step} in series
slot: step int
test: list=1,2,3,4,5,6 step=1
expect: => i=3 r=0.0 ok=true s="swapped count: 3" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
test: list=10,20,30,40 step=2
expect: => i=1 r=0.0 ok=true s="swapped count: 1" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var swaps = 0;
	if s > 0 {
		var i = 0;
		while i + s < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[i + s];
			g.res[i + s] = tmp;
			swaps++;
			i += 2 * s;
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped count: ", swaps);
	out
}
@end
@entry d6cc95265e5d2475
kind: step
verb: scale
noun: streak
modifier: with_cache
context: list
phrase: scale streak with cache multiplier {factor} in list
phrase: multiply repeated run items using factor {factor} with cache
slot: factor int
test: list=2,2,3,3,2,2 factor=10
expect: => i=1 r=0.0 ok=true s="hits: 1" errors=0 n=6 res=[20,20,30,30,20,20] cache=2 hits=1
test: list=1,2,3 factor=5
expect: => i=0 r=0.0 ok=true s="hits: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		var run = 1;
		while i + run < g.n && g.res[i + run] == g.res[i] {
			run++;
		}
		if run > 1 {
			let val = g.res[i];
			let cached, ok = gold_cache_get(g, val);
			let scaled = if ok { cached } else { val * f };
			if !ok { gold_cache_put(g, val, scaled); }
			for k in run {
				g.res[i + k] = scaled;
			}
		}
		i += run;
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "hits: ", g.hits);
	out
}
@end
