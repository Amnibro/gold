phrase: keep duplicate items up to {limit} copies
phrase: restrict duplicate elements up to count {limit}
slot: limit int
test: list=1,1,1,2,2,3 limit=2
expect: => i=5 r=0.0 ok=true s="kept duplicates up to limit" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5,6 limit=1
expect: => i=2 r=0.0 ok=true s="kept duplicates up to limit" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = 0;
		for j in write_idx {
			if g.res[j] == val { seen++; }
		}
		if seen < cap {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept duplicates up to limit");
	out
}
@end
