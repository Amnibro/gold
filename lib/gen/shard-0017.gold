fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	let idx = if ${k} < g.n && ${k} >= 0 { ${k} } else { 0 };
	out.i = if g.n > 0 { g.res[idx] } else { 0 };
	out.s.clear();
	format(out.s, "sorted at index: ", out.i);
	out
}
@end
@entry e2c3364cda11ff27
kind: step
verb: compare
noun: text
modifier: any
context: core
phrase: compare text any substring presence against {match}
phrase: verify text contains any match for {match}
slot: match text
test: text="hello world" match="world"
expect: => i=1 r=0.0 ok=true s="contains match" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world" match="xyz"
expect: => i=0 r=0.0 ok=false s="no match" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pat = ${match};
	var found = false;
	if pat.len == 0 {
		found = true;
	} else if v.s.len >= pat.len {
		var i = 0;
		while i + pat.len <= v.s.len {
			var eq = true;
			for j in pat.len {
				if v.s[i + j] != pat[j] { eq = false; break; }
			}
			if eq { found = true; break; }
			i++;
		}
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found { out.s.append("contains match"); }
	else { out.s.append("no match"); }
	out
}
@end
