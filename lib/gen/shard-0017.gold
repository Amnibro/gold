fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${count};
	var dropped = 0;
	while g.n > 0 && dropped < max_d && g.res[g.n - 1] % 2 == 0 {
		g.n--;
		dropped++;
	}
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped evens: ", dropped);
