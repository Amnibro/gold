fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_merge_primes_with_retry_10 = true;
	if !mark_merge_primes_with_retry_10 { return out; }

	let val = ${base};
	if g.n < 3 && g.n < 64 {
		g.res[g.n] = val;
		g.n += 1;
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		format(out.s, "list merged with base padding");
	} else {
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		format(out.s, "list already sufficient");
	}

	out
}
