code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${f};
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[i] = g.res[i] * f;
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " even items");
	out
}
@end
@entry 87e82b1cecf408bd
kind: step
verb: check
noun: threshold
modifier: up_to
context: stats
phrase: check threshold up to count {k} below {cutoff}
phrase: verify observations up to {k} under {cutoff}
slot: k int
slot: cutoff int
test: list=5,8,12,20,25 k=3 cutoff=15
expect: => i=1 r=0.0 ok=true s="threshold check: true" errors=0 n=5 res=[5,8,12,20,25] cache=0 hits=0
test: list=10,25,30 k=2 cutoff=20
expect: => i=0 r=0.0 ok=false s="threshold check: false" errors=0 n=3 res=[10,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	let lim = ${cutoff};
	if count > g.n { count = g.n; }
	var valid = true;
	for i in count {
		if g.res[i] > lim { valid = false; break; }
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "threshold check: ", valid);
	out
}
@end
