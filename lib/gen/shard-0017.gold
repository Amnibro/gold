@entry a42623fc72f4079a
kind: step
verb: rank
noun: loop
modifier: running
context: retry
phrase: rank running loop progress up to iterations {step_cap}
phrase: measure retry loop steps capped by limit {step_cap}
slot: step_cap int
test: list=12,24,36 step_cap=10
expect: => i=10 r=0.0 ok=true s="running loop steps: 10" errors=0 n=3 res=[12,24,36] cache=0 hits=0
test: list=5,10 step_cap=4
expect: => i=4 r=0.0 ok=true s="running loop steps: 4" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${step_cap};
	var steps = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 1 && steps < cap {
			if x % 2 == 0 { x /= 2; } else { x = x * 3 + 1; }
			steps++;
		}
	}
	out.i = steps;
	out.s.clear();
	format(out.s, "running loop steps: ", steps);
	g.steps += steps;
	out
}
@end
@entry 105b4bb2f0429216
kind: step
verb: dedupe
noun: tail
modifier: in_reverse
context: retry
phrase: dedupe tail retry items in reverse across count {count}
phrase: filter duplicate retry tail values backward for count {count}
slot: count int
test: list=1,2,5,3,5,4 count=4
expect: => i=5 r=0.0 ok=true s="deduped tail length: 5" errors=0 n=5 res=[1,2,3,5,4] cache=0 hits=0
test: list=10,20,30,20 count=3
expect: => i=3 r=0.0 ok=true s="deduped tail length: 3" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let k = if c < g.n { c } else { g.n };
	let start = g.n - k;
	var tmp = [0; 512];
	var u = 0;
	var i = g.n - 1;
	while i >= start {
		let x = g.res[i];
		var seen = false;
		for j in u {
			if tmp[j] == x { seen = true; break; }
		}
		if !seen { tmp[u] = x; u++; }
		i--;
	}
	for j in u { g.res[start + j] = tmp[u - 1 - j]; }
	g.n = start + u;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped tail length: ", g.n);
	g.steps += u;
	out
}
@end
