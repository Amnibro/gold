phrase: collect odd observations until reaching {limit}
slot: limit int
test: list=1,3,5,7,9 limit=8
expect: => i=4 r=0.0 ok=true s="selected 2 odds with sum 4" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=1,5,7,9 limit=15
expect: => i=13 r=0.0 ok=true s="selected 3 odds with sum 13" errors=0 n=3 res=[1,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var count = 0;
	var out_n = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			if total + x > lim { break; }
			total += x;
			g.res[out_n] = x;
			out_n++;
			count++;
		}
	}
	g.n = out_n;
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "selected ", count, " odds with sum ", total);
	out
}
@end
