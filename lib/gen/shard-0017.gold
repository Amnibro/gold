expect: => i=3 r=0.0 ok=true s="searched pairs in reverse: 3" errors=0 n=6 res=[8,2,1,9,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ts = ${target_sum};
	var tmp int[512] = [0; 512];
	var tn = 0;
	var i = g.n - 2;
	while i >= 0 {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a + b == ts {
			tmp[tn] = a;
			tmp[tn + 1] = b;
			tn += 2;
		}
		i -= 2;
	}
	for k in tn {
		g.res[k] = tmp[k];
	}
	g.n = tn;
	g.steps += tn;
	out.i = tn / 2;
	out.s.clear();
	format(out.s, "searched pairs in reverse: ", tn / 2);
	out
}
@end
