fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needed = ${target};
	var max_freq = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	var satisfied = 0;
	if max_freq >= needed { satisfied = 1; }
	g.steps += g.n * g.n;
	out.i = satisfied;
	out.s.clear();
	format(out.s, "histogram max frequency target satisfied: ", satisfied);
	out
}
@end
