@entry 022c943c3b944bc9
kind: step
verb: filter
noun: results
modifier: recursively
context: filter
slot: cutoff int
phrase: filter results recursively removing elements below {cutoff}
phrase: recursively filter results exceeding threshold {cutoff}
test: list=5,12,3,18,7,22 cutoff=10
expect: => i=3 r=0.0 ok=true s="recursively filtered results: 3" errors=0 n=3 res=[12,18,22] cache=0 hits=0
test: list=14,2,8,25,30 cutoff=15
expect: => i=2 r=0.0 ok=true s="recursively filtered results: 2" errors=0 n=2 res=[25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var changed = true;
	while changed {
		changed = false;
		var m = 0;
		var i = 0;
		while i < g.n {
			let x = g.res[i];
			if x >= cut {
				g.res[m] = x;
				m++;
			} else {
				changed = true;
			}
			i++;
		}
		g.n = m;
		g.steps += i;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively filtered results: ", g.n);
	out
}
@end
