context: stats
phrase: merge suffix first count {k}
phrase: combine leading items of suffix count {k}
slot: k int
test: list=10,20,30,40,50 k=2
expect: => i=90 r=0.0 ok=true s="merged suffix sum: 90" errors=0 n=4 res=[10,20,30,90] cache=0 hits=0
test: list=1,2,3,4,5,6 k=3
expect: => i=15 r=0.0 ok=true s="merged suffix sum: 15" errors=0 n=4 res=[1,2,3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	let start = g.n - count;
	var sum_val = 0;
	for i in count { sum_val += g.res[start + i]; }
	g.res[start] = sum_val;
	g.n = start + 1;
	g.steps += count;
	out.i = sum_val;
	out.s.clear();
	format(out.s, "merged suffix sum: ", sum_val);
	out
}
@end
@entry 58f6cb44a56e7185
kind: step
verb: pair
noun: window
modifier: each
context: stats
phrase: pair window each width {w}
phrase: compute sliding window pairwise deltas width {w}
slot: w int
test: list=10,20,30,40,50 w=3
expect: => i=60 r=0.0 ok=true s="window span sum: 60" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=2,5,9,14,20 w=2
expect: => i=18 r=0.0 ok=true s="window span sum: 18" errors=0 n=5 res=[2,5,9,14,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if g.n < win || win < 2 {
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient elements for window");
		return out;
	}
	var count = 0;
	var diff_sum = 0;
	for i in (g.n - win + 1) {
		let span = g.res[i + win - 1] - g.res[i];
		diff_sum += span;
		count++;
	}
	g.steps += count;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "window span sum: ", diff_sum);
	out
}
@end
@entry 988caffe7bb57b78
kind: step
verb: keep
noun: steps
modifier: first
context: stats
phrase: keep steps first count {k}
phrase: retain first {k} sample steps
slot: k int
test: list=1,4,9,16,25 k=3
expect: => i=3 r=0.0 ok=true s="kept 3 initial steps" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=10,25,45,70 k=2
expect: => i=2 r=0.0 ok=true s="kept 2 initial steps" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count >= g.n { count = g.n - 1; }
	if count < 1 {
		out.ok = false;
		out.s.clear();
		format(out.s, "invalid step count");
		return out;
	}
	for i in count {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " initial steps");
	out
}
@end
@entry e25982ac1b926aba
kind: step
