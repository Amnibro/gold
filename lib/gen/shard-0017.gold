fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_bound = ${span};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < 0 {
			g.res[i] = 0;
			clamped++;
		} else if g.res[i] > max_bound {
			g.res[i] = max_bound;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "normalized counters: ", clamped);
	out
}
