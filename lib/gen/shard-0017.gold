modifier: pairwise
context: error
phrase: collect error average pairwise across digits
phrase: compute error average pairwise across digits
test: arg=246,888
expect: 4
expect: 8
test: arg=5
expect: 5
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val < 10 {
		return val;
	}
	var total_avg = 0;
	var pairs = 0;
	var prev = val % 10;
	val = val / 10;
	while val > 0 {
		var curr = val % 10;
		total_avg = total_avg + ((prev + curr) / 2);
		pairs = pairs + 1;
		prev = curr;
		val = val / 10;
	}
	return total_avg / pairs;
}
@end
