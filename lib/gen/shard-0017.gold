expect: => i=2 r=0.0 ok=true s="odd pairs: 2" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pair_count = 0;
	var cur_sum = 0;
	var i = 0;
	while i + 1 < g.n && cur_sum <= lim {
		if g.res[i] % 2 != 0 && g.res[i + 1] % 2 != 0 {
			let psum = g.res[i] + g.res[i + 1];
			cur_sum += psum;
			pair_count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "odd pairs: ", pair_count);
	out
}
@end
