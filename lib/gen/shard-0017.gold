fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${r} <= 0.0 || ${h} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "crater_tier", "", o);
	o.append(" cyl 0,0,");
