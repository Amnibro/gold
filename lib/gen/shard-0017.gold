fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > cut {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	var j = 0;
	while j < g.n {
		var k = j + 1;
		while k < g.n {
			if g.res[j] > g.res[k] {
				let tmp = g.res[j];
				g.res[j] = g.res[k];
				g.res[k] = tmp;
			}
			k++;
		}
		j++;
	}
	g.steps += m * 2;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted threshold count: ", m);
	out
}
@end
