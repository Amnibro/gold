code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var left = 1;
		var right = g.n - 2;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.n;
	out.s.clear();
	let mid_count = if g.n > 2 { g.n - 2 } else { 0 };
	format(out.s, "middle reversed: ", mid_count, " items");
	out
}
@end
