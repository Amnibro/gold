@entry 4da039c3313e827c
kind: step
verb: check
noun: maximum
modifier: nested
context: list
phrase: check maximum nested bound {limit} in list
phrase: verify list maximum within nested limit {limit}
slot: limit int
test: list=10,45,20 limit=50
expect: => i=45 r=0.0 ok=true s="max within limit: 45" errors=0 n=3 res=[10,45,20] cache=0 hits=0
test: list=10,65,20 limit=50
expect: => i=65 r=0.0 ok=false s="exceeded: 65" errors=1 n=3 res=[10,65,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list");
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	if max_val > lim {
		gold_fail(g, "maximum exceeded nested limit");
		out.ok = false;
		out.i = max_val;
		out.s.clear();
		format(out.s, "exceeded: ", max_val);
	} else {
		out.ok = true;
		out.i = max_val;
		out.s.clear();
		format(out.s, "max within limit: ", max_val);
	}
	g.steps += g.n;
	out
}
@end
