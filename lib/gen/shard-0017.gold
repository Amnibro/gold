code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${mincount};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var cnt = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == x { cnt++; }
			j++;
		}
		if cnt >= req {
			var seen = false;
			var k = 0;
			while k < m {
				if g.res[k] == x { seen = true; break; }
				k++;
			}
			if !seen {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += g.n * g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "histogram times");
	out
}
@end
