fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur_len = 0;
	for b in v.s {
		if b == 32 || b == 9 || b == 10 {
			if cur_len > 0 {
				gold_push(g, cur_len);
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		gold_push(g, cur_len);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "split into ", g.n, " word lengths");
	out
}
@end
