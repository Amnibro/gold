expect: => i=25 r=0.0 ok=true s="merged digits: 25" errors=0 n=4 res=[2,5,8,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var combined = 0;
	let lim = if md < g.n { md } else { g.n };
	for i in lim {
		let d = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		combined = combined * 10 + (d % 10);
	}
	gold_push(g, combined);
	g.steps += lim;
	out.i = combined;
	out.s.clear();
	format(out.s, "merged digits: ", combined);
	out
}
@end
