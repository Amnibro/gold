expect: => img: 32x32 min=0 max=1 sum8=105200 hash=598968
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 4, g.iw / 4, ${u});
		}
	}
	var mn_1 = g.img[0];
	var mx_1 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn_1 { mn_1 = g.img[k]; } if g.img[k] > mx_1 { mx_1 = g.img[k]; } }
	if mx_1 - mn_1 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn_1) / (mx_1 - mn_1); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.52 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bark");
	out
}
@end
