fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${factor};
	for i in g.n {
		let rev_idx = g.n - 1 - i;
		g.res[rev_idx] = g.res[rev_idx] * (base + i);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " items in reverse order");
	out
}
@end
