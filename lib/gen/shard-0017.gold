	var found = -1;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
		if g.res[i] == tgt { found = i; }
	}
	out.i = found;
	out.s.clear();
	format(out.s, "searched values recursively");
	out
}
@end
