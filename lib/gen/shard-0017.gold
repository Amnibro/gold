code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty running cache");
		return out;
	}
	var cur_max = g.res[0];
	for i in g.n {
		if g.res[i] > cur_max {
			cur_max = g.res[i];
		}
		gold_cache_put(g, i, cur_max);
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "cached ", g.n, " running peaks");
	out
}
@end
