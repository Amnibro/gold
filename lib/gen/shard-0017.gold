code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in g.n {
		let target = (i + s) % g.n;
		gold_cache_put(g, target, g.res[i]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated sequence with retry");
	out
}
@end
