@entry 037eedae25d4a9fa
kind: step
verb: emboss
noun: bark
modifier: dark
context: texture
phrase: emboss dark bark diffuse map with seed {u}
phrase: render dark bark surface texture using seed {u}
slot: u int
model: noise c=4 u=${u}; contrast a=1.2
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.004 max=1 sum8=36608 hash=239831
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=118255 hash=395427
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.2 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bark");
	out
}
@end
