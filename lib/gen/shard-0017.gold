code:
fn ${ID}_abs(x int) int { if x < 0 { -x } else { x } }
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { out.i = g.n; return out; }
	var spent = 0;
	var kept = 1;
	var i = 1;
	while i < g.n {
		let diff = ${ID}_abs(g.res[i] - g.res[i - 1]);
		if spent + diff <= ${budget} {
			spent += diff;
			kept++;
			i++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept);
	out
}
@end
