expect: => i=6 r=0.0 ok=false s="backward sum differed: 6" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var i = g.n;
	while i > 0 {
		i--;
		sum += g.res[i];
	}
	g.steps += g.n;
	out.i = sum;
	out.ok = (sum == tgt);
	out.s.clear();
	if sum == tgt {
		format(out.s, "backward sum matched: ", sum);
	} else {
		gold_fail(g, "backward sum mismatch");
		format(out.s, "backward sum differed: ", sum);
	}
	out
}
@end
