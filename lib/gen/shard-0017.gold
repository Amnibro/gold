	let max_freq = ${ceiling};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq <= max_freq {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items within frequency ceiling");
	out
}
@end
@entry 4ca097138969731e
kind: step
verb: map
noun: runs
modifier: recursively
context: list
phrase: map identical runs recursively with {sub}
phrase: recursively transform contiguous runs using {sub}
slot: sub fn
test: list=4,4,4,7,7 sub=double
expect: => i=4 r=0.0 ok=true s="mapped 2 runs recursively" errors=0 n=4 res=[8,3,14,2] cache=0 hits=0
test: list=5,5 sub=inc
expect: => i=2 r=0.0 ok=true s="mapped 1 runs recursively" errors=0 n=2 res=[6,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_res int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			run_len++;
			i++;
		}
		let mapped_val = ${sub}(g.res[i]);
		new_res[count] = mapped_val;
		count++;
		new_res[count] = run_len;
		count++;
		i++;
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped ", count / 2, " runs recursively");
	out
}
@end
