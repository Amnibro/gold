fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let check = ${cp};
	var i = 0;
	var diff_sum = 0;
	while i < g.n {
		let diff = if g.res[i] >= check { g.res[i] - check } else { check - g.res[i] };
