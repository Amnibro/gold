code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_count = 0;
	let n = g.n;
	var i = 0;
	while i < n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[n - 1 - i];
		g.res[n - 1 - i] = tmp;
		i++;
	}
	for j in n {
		let x = g.res[j];
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { sq_count++; break; }
				r++;
			}
		}
	}
	g.steps += n;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "reversed list with ", sq_count, " squares");
	out
}
@end
