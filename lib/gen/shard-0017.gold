fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var m = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			let sum = g.res[i] + g.res[i + 1];
			if sum >= lo && sum <= hi {
				g.res[m] = sum;
				m++;
			}
			i++;
		}
		g.n = m;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "pairs between returned");
	out
}
@end
@entry 5f40b10fbcc4808f
kind: step
verb: sort
noun: values
modifier: until
context: filter
slot: stop int
phrase: sort values until sentinel {stop}
phrase: filter sort values until encountering {stop}
test: list=9,4,7,2,0,8,5 stop=0
expect: => i=4 r=0.0 ok=true s="values sorted until" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=15,3,10,-1,20 stop=-1
expect: => i=3 r=0.0 ok=true s="values sorted until" errors=0 n=3 res=[3,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stop};
	var cut = g.n;
	var i = 0;
	while i < g.n {
		if g.res[i] == st { cut = i; break; }
		i++;
	}
	g.n = cut;
	var p = 0;
	while p < g.n {
		var q = p + 1;
		while q < g.n {
			if g.res[p] > g.res[q] {
				let tmp = g.res[p];
				g.res[p] = g.res[q];
				g.res[q] = tmp;
			}
			q++;
		}
		p++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "values sorted until");
	out
}
@end
@entry ff7096f137e6210f
kind: step
verb: sort
noun: total
modifier: nested
context: filter
slot: chunk int
phrase: sort total nested chunk size {chunk}
phrase: filter sort total nested blocks {chunk}
test: list=1,4,2,3,5,1 chunk=2
expect: => i=3 r=0.0 ok=true s="total nested sorted" errors=0 n=3 res=[5,5,6] cache=0 hits=0
test: list=10,20,5,15,30,0 chunk=3
expect: => i=2 r=0.0 ok=true s="total nested sorted" errors=0 n=2 res=[35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	var m = 0;
	if sz > 0 {
		var i = 0;
		while i < g.n {
			var tot = 0;
			var k = 0;
			while k < sz && i + k < g.n {
				tot += g.res[i + k];
				k++;
			}
			g.res[m] = tot;
			m++;
			i += sz;
		}
		g.n = m;
		var p = 0;
		while p < g.n {
			var q = p + 1;
			while q < g.n {
				if g.res[p] > g.res[q] {
					let tmp = g.res[p];
					g.res[p] = g.res[q];
					g.res[q] = tmp;
				}
				q++;
			}
			p++;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "total nested sorted");
	out
}
@end
