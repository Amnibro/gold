expect: => i=2 r=0.0 ok=true s="limited to 2 items" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if sum + g.res[i] <= limit {
			sum += g.res[i];
			g.res[count] = g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited to ", count, " items");
	out
}
@end
