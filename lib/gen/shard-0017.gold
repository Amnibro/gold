@entry 061c43cc15a7dfa7
kind: step
verb: reverse
noun: list
modifier: times
context: stats
phrase: reverse list times multiplier {factor}
phrase: invert observation order scaled by {factor}
slot: factor int
test: list=1,2,3,4,5 factor=2
expect: => i=5 r=0.0 ok=true s="reversed and scaled 5 items" errors=0 n=5 res=[10,8,6,4,2] cache=0 hits=0
test: list=10,20,30 factor=3
expect: => i=3 r=0.0 ok=true s="reversed and scaled 3 items" errors=0 n=3 res=[90,60,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right] * f;
		g.res[right] = tmp * f;
		left++;
		right--;
	}
	if left == right { g.res[left] = g.res[left] * f; }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed and scaled ", g.n, " items");
	out
}
@end
@entry 602454c8485021a8
kind: step
verb: scale
noun: runs
modifier: all
context: stats
phrase: scale runs all with contiguous length
phrase: multiply all contiguous sample runs by length
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="scaled 3 contiguous runs" errors=0 n=6 res=[2,2,2,9,9,9] cache=0 hits=0
test: list=5,5,5,10,10
expect: => i=2 r=0.0 ok=true s="scaled 2 contiguous runs" errors=0 n=5 res=[15,15,15,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var runs = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		let len = j - i;
		for k in len { g.res[i + k] = val * len; }
		runs++;
		i = j;
	}
	g.steps += runs;
	out.i = runs;
	out.s.clear();
	format(out.s, "scaled ", runs, " contiguous runs");
	out
}
@end
