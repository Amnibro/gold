code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if st <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var modified = 0;
	var i = 0;
	while i < g.n {
		g.res[i] = ${sub}(g.res[i]);
		modified++;
		i += st;
	}
	g.steps += modified;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped ", modified, " nested checkpoints");
	out
}
@end
@entry 8ef6320eca51e21f
kind: step
verb: measure
noun: middle
modifier: with_retry
context: list
phrase: measure middle element seeking {target} with retry limit {max_tries}
phrase: inspect center item for {target} with retry count {max_tries}
slot: target int
slot: max_tries int
test: list=1,3,5,7,9 target=5 max_tries=3
expect: => i=5 r=0.0 ok=true s="measured middle with 1 retry tries" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=1,2,3,4 target=10 max_tries=2
expect: => i=2 r=0.0 ok=false s="measured middle with 2 retry tries" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let tries = ${max_tries};
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		return out;
	}
	var left = 0;
	var right = g.n - 1;
	var attempts = 0;
	var found = false;
	var mid_val = 0;
	while left <= right && attempts < tries {
		let mid = (left + right) / 2;
		mid_val = g.res[mid];
		attempts++;
		if mid_val == tgt {
			found = true;
			break;
		}
		left++;
		right--;
	}
	g.steps += attempts;
	out.i = mid_val;
	out.ok = found;
	out.s.clear();
	format(out.s, "measured middle with ", attempts, " retry tries");
	out
}
@end
