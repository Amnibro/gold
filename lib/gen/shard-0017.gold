@entry c9e1eab682fff80d
kind: step
verb: scale
noun: runs
modifier: last
context: list
phrase: scale runs last repeated sequence by factor {factor}
phrase: multiply final contiguous run by multiplier {factor} in list
slot: factor int
test: list=1,2,3,3,3 factor=2
expect: => i=3 r=0.0 ok=true s="scaled run: 3" errors=0 n=5 res=[1,2,6,6,6] cache=0 hits=0
test: list=5,10,20 factor=3
expect: => i=1 r=0.0 ok=true s="scaled run: 1" errors=0 n=3 res=[5,10,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var last_val = g.res[g.n - 1];
	var run = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		run++;
		i--;
	}
	for k in run {
		g.res[g.n - 1 - k] *= f;
	}
	g.steps += run;
	out.i = run;
	out.s.clear();
	format(out.s, "scaled run: ", run);
	out
}
@end
