test: list=4,4,4,5,5 max_len=3
expect: => i=1 r=0.0 ok=true s="paired runs: 1" errors=0 n=5 res=[4,4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var run_count = 0;
	var r = 0;
	while r < g.n {
		let val = g.res[r];
		var cur_len = 0;
		while r < g.n && g.res[r] == val {
			cur_len++;
			r++;
		}
		if cur_len <= ml {
			run_count++;
		}
	}
	let paired_runs = run_count / 2;
	g.steps += g.n;
	out.i = paired_runs;
	out.s.clear();
	format(out.s, "paired runs: ", paired_runs);
	out
}
@end
@entry bbb6062fb28198d4
kind: step
verb: check
noun: squares
modifier: each
context: sort
phrase: check squares each entry up to count {max_check}
phrase: verify each element is square up to {max_check}
slot: max_check int
test: list=1,4,9,16 max_check=4
expect: => i=4 r=0.0 ok=true s="checked squares: 4" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
test: list=2,4,8,16 max_check=3
expect: => i=1 r=0.0 ok=false s="checked squares: 1" errors=0 n=4 res=[2,4,8,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_check};
	let lim = if mc < g.n { mc } else { g.n };
	var all_sq = true;
	var count = 0;
	for i in lim {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x {
					is_sq = true;
				}
				r++;
			}
		}
		if is_sq {
			count++;
		} else {
			all_sq = false;
		}
	}
	out.ok = all_sq;
	out.i = count;
	g.steps += lim;
	out.s.clear();
	format(out.s, "checked squares: ", count);
	out
}
@end
