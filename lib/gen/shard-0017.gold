test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="stone" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=36208 hash=665813
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="stone" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=124042 hash=922717
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 8, g.iw / 8, ${u});
		}
	}
	for y in g.ih / 2 {
		for x in g.iw {
			let src = y * g.iw + x;
			let dst = (g.ih - 1 - y) * g.iw + x;
			let tmp = g.img[src];
			g.img[src] = g.img[dst];
			g.img[dst] = tmp;
		}
	}
	var mn_2 = g.img[0];
	var mx_2 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn_2 { mn_2 = g.img[k]; } if g.img[k] > mx_2 { mx_2 = g.img[k]; } }
	if mx_2 - mn_2 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn_2) / (mx_2 - mn_2); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stone");
	out
}
@end
