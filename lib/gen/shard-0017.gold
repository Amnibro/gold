code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	g.n = 0;
	for b in out.s {
		gold_push(g, b as int);
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if lim < g.n { g.n = lim; }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted count: ", g.n);
	out
}
@end
