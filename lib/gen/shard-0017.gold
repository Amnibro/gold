code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_len};
	let lim = if m > g.n { g.n } else if m < 0 { 0 } else { m };
	for i in lim / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[lim - 1 - i];
		g.res[lim - 1 - i] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed safely length: ", lim);
	out
}
@end
@entry 997e1674912b2f13
kind: step
verb: reverse
noun: text
modifier: between
context: list
phrase: reverse text between {start_idx} and {end_idx} in list
phrase: reverse range between {start_idx} and {end_idx} items
slot: start_idx int
slot: end_idx int
test: list=1,2,3,4,5 start_idx=1 end_idx=3
expect: => i=3 r=0.0 ok=true s="reversed count: 3" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30 start_idx=0 end_idx=1
expect: => i=2 r=0.0 ok=true s="reversed count: 2" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s0 = ${start_idx};
	let e0 = ${end_idx};
	let start = if s0 < 0 { 0 } else { s0 };
	let end = if e0 >= g.n { g.n - 1 } else { e0 };
	if start < end {
		var i = start;
		var j = end;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	let count = if end >= start { end - start + 1 } else { 0 };
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed count: ", count);
	out
}
@end
@entry 0a41dd73a5012ca9
kind: step
verb: keep
noun: cache
modifier: times
context: list
phrase: keep cache times seen at least {min_hits} in list
phrase: retain cached items appearing at least {min_hits} times
slot: min_hits int
test: list=1,2,2,3,2,1 min_hits=2
expect: => i=5 r=0.0 ok=true s="kept count: 5" errors=0 n=5 res=[1,2,2,2,1] cache=2 hits=0
test: list=1,2,3 min_hits=2
expect: => i=0 r=0.0 ok=true s="kept count: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_hits};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq >= limit {
			gold_cache_put(g, val, freq);
			g.res[kept] = val;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept count: ", kept);
	out
}
@end
