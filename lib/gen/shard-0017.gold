expect: => img: 32x32 min=0 max=1 sum8=100816 hash=535009
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var mn = g.img[0];
	var mx = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn { mn = g.img[k]; } if g.img[k] > mx { mx = g.img[k]; } }
	if mx - mn < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn) / (mx - mn); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "grime");
	out
}
@end
