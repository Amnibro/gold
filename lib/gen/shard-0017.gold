code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { out.i = g.n; return out; }
	var kept int[512] = [0; 512];
	kept[0] = g.res[0];
	var count = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[i - 1] {
			kept[count] = g.res[i];
			count++;
		}
		i++;
	}
	g.n = 0;
	for k in count { gold_push(g, kept[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "unique adjacent: ", count);
	out
}
@end
