fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let flr = ${floor};
	var min_val = 999999;
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let ok = min_val >= flr;
	out.ok = ok;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum check: ", ok);
	out
}
@end
