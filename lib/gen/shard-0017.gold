code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens++; }
	}
	out.i = evens;
	out.s.clear();
	format(out.s, "found evens count: ", evens);
	g.steps += g.n;
	out
}
@end
@entry ddf5549013e54cd1
kind: step
verb: dedupe
noun: limit
modifier: times
context: retry
phrase: dedupe retry items keeping at most {max_dupes} times
phrase: restrict duplicate retry elements to frequency {max_dupes}
slot: max_dupes int
test: list=2,2,2,3,3,3,4 max_dupes=2
expect: => i=5 r=0.0 ok=true s="deduped frequency count: 5" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,5 max_dupes=1
expect: => i=1 r=0.0 ok=true s="deduped frequency count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dupes};
	if md <= 0 { g.n = 0; out.i = 0; return out; }
	var tmp = [0; 512];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt = 0;
		for j in u { if tmp[j] == x { cnt++; } }
		if cnt < md { tmp[u] = x; u++; }
	}
	for i in u { g.res[i] = tmp[i]; }
	g.n = u;
	out.i = u;
	out.s.clear();
	format(out.s, "deduped frequency count: ", u);
	g.steps += u;
	out
}
@end
@entry bb3d757c3aae1fdf
kind: step
verb: sort
noun: maximum
modifier: until
context: retry
phrase: sort maximum retry values until reaching bound {bound}
phrase: order largest retry elements before bound {bound}
slot: bound int
test: list=15,3,25,8,40 bound=20
expect: => i=2 r=0.0 ok=true s="sorted maximum count: 2" errors=0 n=5 res=[40,25,15,3,8] cache=0 hits=0
test: list=10,5,30,2 bound=15
expect: => i=1 r=0.0 ok=true s="sorted maximum count: 1" errors=0 n=4 res=[30,10,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	for i in g.n {
		if g.res[i] >= b { count++; }
	}
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] < g.res[j] && g.res[j] >= b {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "sorted maximum count: ", count);
	g.steps += g.n;
	out
}
@end
@entry d824debb6a5b575c
kind: step
