code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "safe sort: ", swaps, " swaps");
	out.i = swaps;
	g.steps += swaps + g.n;
	out
}
@end
