code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_prime = true;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if !is_p { all_prime = false; break; }
		i++;
	}
	out.ok = all_prime;
	out.s.clear();
	format(out.s, "all primes: ", all_prime);
	out.i = if all_prime { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
