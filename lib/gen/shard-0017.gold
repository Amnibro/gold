expect: 0
expect: 12
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var digits int[..32] = [];
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	var score = 0;
	var i = digits.len - 1;
	var pos = 0;
	while i >= 0 {
		if pos % 2 == 1 {
			score += digits[i];
		}
		pos++;
		if i == 0 { break; }
		i--;
	}
	score
}
@end
@entry 1be9fbb14a4e7ec2
kind: fn
verb: return
noun: range
modifier: while
context: compare
phrase: compute digit boundary range while comparing values
phrase: span between extremal digits during compare scan
test: arg=1839,4444
expect: 8
expect: 0
test: arg=123,901
expect: 2
expect: 9
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val < 10 { return 0; }
	var lo_digit = 9;
	var hi_digit = 0;
	while val > 0 {
		let cur = val % 10;
		if cur < lo_digit { lo_digit = cur; }
		if cur > hi_digit { hi_digit = cur; }
		val /= 10;
	}
	hi_digit - lo_digit
}
@end
