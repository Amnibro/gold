			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tally count: ", count);
	out
}
@end
@entry 6cddf37b8e5f92fa
kind: step
verb: map
noun: maximum
modifier: first
context: sort
phrase: map maximum element to first position in segment {k}
phrase: place maximum value first across segment {k}
slot: k int
test: list=1,3,7,2,5 k=3
expect: => i=7 r=0.0 ok=true s="maximum moved first" errors=0 n=5 res=[7,3,1,2,5] cache=0 hits=0
test: list=2,8,4,6 k=4
expect: => i=8 r=0.0 ok=true s="maximum moved first" errors=0 n=4 res=[8,2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let seg = ${k};
	let bound = if seg < g.n { seg } else { g.n };
	if bound > 0 {
		var max_idx = 0;
		for i in 1..bound {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		let tmp = g.res[0];
		g.res[0] = g.res[max_idx];
		g.res[max_idx] = tmp;
		out.i = g.res[0];
	}
	g.steps += bound;
	out.s.clear();
	format(out.s, "maximum moved first");
	out
}
@end
