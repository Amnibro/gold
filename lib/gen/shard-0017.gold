fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_err_idx = -1;
	for i in g.n {
		if g.res[i] < 0 { last_err_idx = i; }
	}
	if last_err_idx >= 0 {
		var i = last_err_idx;
		while i < g.n - 1 {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.n--;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "dropped last error");
	out
}
@end
