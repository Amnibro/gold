fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var k = 0;
	while k < g.n && g.res[k] >= th {
		k++;
	}
	for i in k / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[k - 1 - i];
		g.res[k - 1 - i] = tmp;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed prefix length: ", k);
	out
}
@end
