code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var take = w;
	if take > g.n { take = g.n; }
	let start = (g.n - take) / 2;
	var buf int[512] = [0; 512];
	for i in take {
		buf[i] = g.res[start + i];
	}
	for i in take {
		g.res[i] = buf[i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "kept ", take, " middle elements first");
	out
}
@end
