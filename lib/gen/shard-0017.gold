fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_len};
	var found = false;
	var match_val = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			run_len++;
			i++;
		}
		if run_len >= tgt {
			found = true;
			match_val = g.res[i];
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.i = match_val;
	out.ok = found;
	out.s.clear();
	format(out.s, "retried runs until length reached");
	out
}
@end
