noun: suffix
modifier: pairwise
context: stats
phrase: scale suffix pairwise trailing items by {factor}
phrase: multiply trailing observation pairs by {factor}
slot: k int
slot: factor int
test: list=1,3,6,10,15 k=3 factor=2
expect: => i=3 r=0.0 ok=true s="scaled 3 suffix items" errors=0 n=5 res=[1,3,12,20,30] cache=0 hits=0
