@entry 892ce082dd6703d2
kind: step
verb: scan
noun: evens
modifier: with_retry
context: list
phrase: scan even numbers with retry passes {attempts}
phrase: search even elements using retry allowance {attempts}
slot: attempts int
test: list=2,3,4 attempts=2
expect: => i=2 r=0.0 ok=true s="scanned evens with 1 passes" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=1,3,5 attempts=2
expect: => i=3 r=0.0 ok=true s="scanned evens with 2 passes" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var evens = 0;
	var passes = 0;
	while passes < max_att {
		evens = 0;
		for i in g.n {
			if g.res[i] % 2 == 0 { evens++; }
		}
		passes++;
		if evens > 0 { break; }
		for i in g.n { g.res[i] += 1; }
	}
	g.steps += g.n * passes;
	out.i = evens;
	out.s.clear();
	format(out.s, "scanned evens with ", passes, " passes");
	out
}
@end
