		i++;
	}
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
@entry 7e56761a6ab86480
kind: step
verb: validate
noun: pairs
modifier: unique
context: filter
phrase: validate pairs unique adjacent check
phrase: filter validate pairs unique consecutive duplicates
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="pairs validated unique" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,1,2,3,3
expect: => i=1 r=0.0 ok=true s="pairs validated unique" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		let is_dup = (i > 0 && g.res[i] == g.res[i - 1]) ||
		             (i + 1 < g.n && g.res[i] == g.res[i + 1]);
		if !is_dup {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "pairs validated unique");
	out
}
@end
