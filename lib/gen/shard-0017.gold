fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var count = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let span = g.res[i + 1] - g.res[i];
			let abs_span = if span < 0 { -span } else { span };
			if abs_span >= d { count++; }
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "pairs with minimum gap: ", count);
	out
}
