fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	for i in g.n {
		for j in i {
			if g.res[i] == g.res[j] {
				gold_cache_put(g, dups, g.res[i]);
				dups++;
				break;
			}
		}
	}
	out.i = dups;
	out.s.clear();
	format(out.s, "searched duplicates any");
	out
}
