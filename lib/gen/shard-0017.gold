fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var stopping = false;
	for i in g.n {
		if !stopping && ${p}(g.res[i]) {
			stopping = true;
		}
		if stopping || g.res[i] % 2 == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "dropped odds leaving ", kept, " items");
	out
}
@end
