noun: list
modifier: while
context: list
slot: p pred
phrase: shift list while condition {p} holds
phrase: rotate list items while satisfying {p}
test: list=2,4,6,7,9 p=is_even
expect: => i=3 r=0.0 ok=true s="shifted count: 3" errors=0 n=5 res=[7,9,2,4,6] cache=0 hits=0
