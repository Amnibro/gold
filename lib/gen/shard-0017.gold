code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let cached, ok = gold_cache_get(g, out.i);
	let res = if ok { cached } else { out.i * f };
	if !ok { gold_cache_put(g, out.i, res); }
	gold_push(g, res);
	g.steps += 1;
	out.i = res;
	out.s.clear();
	format(out.s, "scaled item: ", res);
	out
}
@end
