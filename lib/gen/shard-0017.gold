test: list=1,2,1
expect: => i=0 r=0.0 ok=true s="reverse symmetry diff sum 0" errors=0 n=3 res=[0,2,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	let half = g.n / 2;
	for i in half {
		let j = g.n - 1 - i;
		let d = if g.res[i] >= g.res[j] { g.res[i] - g.res[j] } else { g.res[j] - g.res[i] };
		g.res[i] = d;
		g.res[j] = d;
		diff_sum += d * 2;
	}
	g.steps += g.n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "reverse symmetry diff sum ", diff_sum);
	out
}
@end
