expect: => i=9 r=0.0 ok=true s="average sorted searched" errors=0 n=3 res=[5,8,12] cache=0 hits=0
test: list=1,3,7,9,15
expect: => i=7 r=0.0 ok=true s="average sorted searched" errors=0 n=3 res=[3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var m = 0;
	var j = 0;
	while j < g.n {
		let x = g.res[j];
		let diff = if x >= avg { x - avg } else { avg - x };
		if diff <= 4 {
			g.res[m] = x;
			m++;
		}
		j++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "average sorted searched");
	out
}
@end
