kind: step
verb: sort
noun: histogram
modifier: times
context: retry
phrase: sort retry histogram passes count {iterations}
phrase: order retry frequency histogram across cycles {iterations}
slot: iterations int
test: list=5,3,8,1 iterations=2
expect: => i=4 r=0.0 ok=true s="sorted histogram size: 4" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
test: list=12,7,19 iterations=3
expect: => i=3 r=0.0 ok=true s="sorted histogram size: 3" errors=0 n=3 res=[7,12,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let it = ${iterations};
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted histogram size: ", g.n);
	g.steps += g.n * it;
	out
}
@end
