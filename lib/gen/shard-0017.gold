@entry 5844c7c9eb643fc5
kind: step
verb: filter
noun: streak
modifier: any
context: filter
slot: minlen int
phrase: filter streak any of run length {minlen}
phrase: keep streaks any meeting run size {minlen}
test: list=1,1,2,3,3,3,4 minlen=2
expect: => i=5 r=0.0 ok=true s="filtered streak any" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,6,7,7 minlen=3
expect: => i=0 r=0.0 ok=true s="filtered streak any" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${minlen};
	var out_list int[512] = [0; 512];
	var m = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= req {
			var k = i;
			while k < j {
				if m < 512 { out_list[m] = g.res[k]; m++; }
				k++;
			}
		}
		i = j;
	}
	var k = 0;
	while k < m {
		g.res[k] = out_list[k];
		k++;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered streak any");
	out
}
@end
@entry 4ece077129178d7d
kind: step
verb: filter
noun: words
modifier: nested
context: filter
slot: minlen int
phrase: filter words nested with length {minlen}
phrase: keep words nested meeting size {minlen}
test: text="cat elephant dog butterfly" minlen=4
expect: => i=18 r=0.0 ok=true s="elephant butterfly" errors=0 n=0 res=[] cache=0 hits=0
test: text="a quick brown fox" minlen=5
expect: => i=11 r=0.0 ok=true s="quick brown" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${minlen};
	var res_s byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		let start = i;
		while i < out.s.len && out.s[i] != ' ' { i++; }
		let wlen = i - start;
		if wlen >= req {
			if res_s.len > 0 && res_s.len < 200 { res_s.push(' '); }
			var k = start;
			while k < i {
				if res_s.len < 200 { res_s.push(out.s[k]); }
				k++;
			}
		}
	}
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
@entry f35dcd1f72345cb9
kind: step
verb: filter
noun: window
modifier: unique
context: filter
slot: winsize int
phrase: filter window unique span {winsize}
phrase: keep window unique blocks size {winsize}
test: list=1,2,3,2,4,5 winsize=3
expect: => i=3 r=0.0 ok=true s="unique windows filtered" errors=0 n=3 res=[1,3,2] cache=0 hits=0
test: list=1,1,2,3,4 winsize=2
expect: => i=3 r=0.0 ok=true s="unique windows filtered" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${winsize};
	var m = 0;
	if w > 1 && g.n >= w {
		var i = 0;
		while i <= g.n - w {
			var unique = true;
			var p = i;
			while p < i + w {
				var q = p + 1;
				while q < i + w {
					if g.res[p] == g.res[q] { unique = false; break; }
					q++;
				}
				if !unique { break; }
				p++;
			}
			if unique {
				g.res[m] = g.res[i];
				m++;
			}
			i++;
		}
		g.n = m;
	} else if w <= 1 {
		m = g.n;
	} else {
		g.n = 0;
	}
	g.steps += g.n + m;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique windows filtered");
	out
}
@end
@entry 8cf2546139e592b5
kind: step
verb: repeat
noun: values
modifier: first
context: filter
slot: count int
phrase: repeat values first slice {count}
phrase: filter repeat values first items {count}
test: list=1,2,3,4 count=2
expect: => i=4 r=0.0 ok=true s="values repeated first" errors=0 n=4 res=[1,2,1,2] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=2 r=0.0 ok=true s="values repeated first" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let num = if k < g.n { if k > 0 { k } else { 0 } } else { g.n };
	var buf int[512] = [0; 512];
	var i = 0;
	while i < num {
		buf[i] = g.res[i];
		i++;
	}
	var m = 0;
	var rep = 0;
	while rep < 2 {
		var j = 0;
		while j < num {
			if m < 512 { buf[m] = g.res[j]; m++; }
			j++;
		}
		rep++;
	}
	var p = 0;
	while p < m {
		g.res[p] = buf[p];
		p++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "values repeated first");
	out
}
@end
@entry 7d5978f3606f4d01
kind: step
verb: dedupe
noun: item
modifier: between
context: filter
slot: low int
slot: high int
phrase: dedupe item between range {low} through {high}
phrase: filter dedupe item between bounds {low} with {high}
test: list=10,5,10,20,5,30 low=5 high=15
expect: => i=4 r=0.0 ok=true s="items deduped between" errors=0 n=4 res=[10,5,20,30] cache=0 hits=0
test: list=2,2,8,8,12,12 low=1 high=10
expect: => i=4 r=0.0 ok=true s="items deduped between" errors=0 n=4 res=[2,8,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			var j = 0;
			while j < m {
				if g.res[j] == x { seen = true; break; }
				j++;
			}
			if !seen {
				g.res[m] = x;
				m++;
			}
		} else {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "items deduped between");
	out
}
@end
