code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached_val, found = gold_cache_get(g, k);
	if found {
		out.i = cached_val;
	} else {
		if g.n > 0 {
			var min_val = g.res[0];
			for i in 1..g.n {
				if g.res[i] < min_val {
					min_val = g.res[i];
				}
			}
			gold_cache_put(g, k, min_val);
			out.i = min_val;
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "min cached");
	out
}
@end
