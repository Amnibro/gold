code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	var res = 0;
	for step in 10 {
		let d = 9 - step;
		var temp = val;
		while temp > 0 {
			if temp % 10 == d {
				res = res * 10 + d;
			}
			temp /= 10;
		}
	}
	res
}
@end
