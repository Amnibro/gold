fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 { return out; }
	let idx = g.n / 2;
	if g.res[idx] > b { g.res[idx] = b; }
	out.i = g.res[idx];
	out.s.clear();
	format(out.s, "clamped tail first: ", out.i);
	g.steps += 1;
	out
}
