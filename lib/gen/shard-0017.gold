code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var rnk = 1;
		for j in g.n {
			if g.res[j] < g.res[i] { rnk++; }
		}
		gold_cache_put(g, i, rnk);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked number entries");
	out
}
@end
