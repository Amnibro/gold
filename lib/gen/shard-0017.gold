test: list=12,25,37,42 binsize=10
expect: => i=4 r=0.0 ok=true s="histogram grouped safely" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=3,7,14,19 binsize=5
expect: => i=4 r=0.0 ok=true s="histogram grouped safely" errors=0 n=4 res=[0,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${binsize};
	if b <= 0 {
		gold_fail(g, "binsize must be positive");
		out.ok = false;
		return out;
	}
	for i in g.n {
		let val = g.res[i];
		let bucket = (val / b) * b;
		g.res[i] = bucket;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "histogram grouped safely");
	out
}
@end
