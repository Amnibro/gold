code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	let prev, found = gold_cache_get(g, cut);
	if found {
		out.i = prev;
		out.s.clear();
		format(out.s, "memoized filter count: ", prev);
		return out;
	}
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > cut {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	gold_cache_put(g, cut, m);
	g.steps += m + i;
	out.i = m;
	out.s.clear();
	format(out.s, "memoized filter count: ", m);
	out
}
@end
