code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	let last_val, found = gold_cache_get(g, g.n - 1);
	if found {
		out.i = last_val;
	} else {
		out.i = -1;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "found last cache");
	out
}
@end
@entry 8dbfd1e552160b18
kind: step
verb: normalize
noun: step
modifier: recursively
context: loop
phrase: normalize step recursively by division factor {factor}
phrase: reduce elements recursively scaling by step {factor}
slot: factor int
test: list=80,40 factor=2
expect: => i=5 r=0.0 ok=true s="normalized step recursively" errors=0 n=2 res=[10,10] cache=0 hits=0
test: list=100 factor=3
expect: => i=3 r=0.0 ok=true s="normalized step recursively" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f <= 0 {
		gold_fail(g, "factor must be positive");
		out.ok = false;
		return out;
	}
	var steps_taken = 0;
	for i in g.n {
		while g.res[i] > 10 && steps_taken < 100 {
			g.res[i] /= f;
			steps_taken++;
		}
	}
	g.steps += steps_taken;
	out.i = steps_taken;
	out.s.clear();
	format(out.s, "normalized step recursively");
	out
}
@end
