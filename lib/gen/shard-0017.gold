fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let maximum = ${cap};
	var total = 0;
	for i in g.n {
		let doubled = g.res[i] * 2;
		if doubled > maximum {
			g.res[i] = maximum;
		} else {
			g.res[i] = doubled;
		}
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled numbers under cap: ", total);
	out
}
