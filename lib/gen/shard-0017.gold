fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "no pairwise streak to sum");
		return out;
	}
	let new_cnt = g.n - 1;
	for i in new_cnt {
		g.res[i] = g.res[i] + g.res[i + 1];
	}
	g.steps += g.n;
	g.n = new_cnt;
	out.i = new_cnt;
	out.s.clear();
	format(out.s, "pairwise sum of ", new_cnt, " pairs");
	out
}
@end
