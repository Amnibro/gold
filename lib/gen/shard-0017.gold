expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: part cyl 0,0,0 0,0,0.1 r0.05
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${cnt} <= 1 || ${sp} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "post", "", o);
	o.append(" tube 0,0,");
	o.append("0 0,");
	o.append("0,0.");
	o.append("04 r");
	o.append("0.0");
	o.append("15 sh");
	o.append("0.0");
	o.append("05 m:metal a");
	format(o, ${cnt});
	o.append(":");
	gold_fnum(o, ${sp});
	o.append(",0,0");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "patternstandoff");
	out
}
@end
