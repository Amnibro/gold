code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	if d != 0 && sum % d == 0 {
		out.ok = true;
		out.i = sum / d;
		out.s.clear();
		format(out.s, "multiple: ", out.i);
	} else {
		gold_fail(g, "total not divisible");
		out.ok = false;
		out.i = sum;
		out.s.clear();
		format(out.s, "sum not divisible: ", sum);
	}
	g.steps += g.n;
	out
}
@end
