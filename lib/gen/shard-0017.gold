kind: step
verb: merge
noun: streak
modifier: while
context: list
phrase: merge streak while below sum {limit}
phrase: combine contiguous streak while under sum {limit}
slot: limit int
test: list=2,3,4,10 limit=6
expect: => i=3 r=0.0 ok=true s="merged streak while within limit" errors=0 n=3 res=[5,4,10] cache=0 hits=0
test: list=1,1,1,1,10 limit=3
expect: => i=3 r=0.0 ok=true s="merged streak while within limit" errors=0 n=3 res=[3,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var merged int[512] = [0; 512];
	var count = 0;
	var cur_sum = 0;
	for i in g.n {
		let x = g.res[i];
		if cur_sum + x <= lim && cur_sum > 0 {
			cur_sum += x;
			merged[count - 1] = cur_sum;
		} else {
			cur_sum = x;
			merged[count] = cur_sum;
			count++;
		}
	}
	for i in count { g.res[i] = merged[i]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged streak while within limit");
	out
}
@end
