noun: light
modifier: spaced
context: scene
phrase: duplicate light along row count {n} spacing {dx}
phrase: repeat light fixtures count {n} spaced {dx}
slot: n int
slot: dx real
test: n=2 dx=3.0 doc="floor box 0,0,-.5 10,10,1|lamp light point 0,0,3 w200"
expect: => i=4 r=0.0 ok=true s="duplightspace" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: floor box 0,0,-.5 10,10,1
expect: => doc: lamp light point 0,0,3 w200
expect: => doc: lamp3 light point 3,0,3 w200
expect: => doc: lamp4 light point 6,0,3 w200
test: n=3 dx=2.5 doc="floor box 0,0,-.5 10,10,1|spot light spot 0,0,4 0,0,0 w300"
expect: => i=5 r=0.0 ok=true s="duplightspace" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: floor box 0,0,-.5 10,10,1
expect: => doc: spot light spot 0,0,4 0,0,0 w300
expect: => doc: lamp3 light point 2.5,0,3 w200
expect: => doc: lamp4 light point 5,0,3 w200
expect: => doc: lamp5 light point 7.5,0,3 w200
test: n=0 dx=3.0
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} <= 0 || ${dx} <= 0.0 { out.ok = false; return out; }
	var i = 1;
	while i <= ${n} {
		var o byte[>..] = [];
		var name byte[>..] = [];
		gold_dnews(g, "lamp", "", name);
		o.append(name);
		o.append(" light point ");
		gold_fnum(o, (i as real) * ${dx});
		o.append(",0,3 w");
		o.append("20");
		o.append("0");
		gold_doc(g, o);
		i = i + 1;
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "duplightspace");
	out
}
@end
