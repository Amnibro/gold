@entry 7766f2c3101f815c
kind: step
verb: filter
noun: memo
modifier: recursively
context: filter
slot: cutoff int
phrase: filter memo recursively above cutoff {cutoff}
phrase: memoize filtered elements exceeding cutoff {cutoff}
test: list=5,12,18,3,25 cutoff=10
expect: => i=3 r=0.0 ok=true s="memoized filter count: 3" errors=0 n=3 res=[12,18,25] cache=1 hits=0
