@entry f0fdfe775c38e260
kind: step
verb: compare
noun: tally
modifier: recursively
context: core
slot: target int
phrase: compare tally recursively matching target {target}
phrase: check recursive tally against benchmark {target}
test: list=1,2,3,4 target=1
expect: => i=1 r=0.0 ok=true s="recursive tally matched: 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=9,9,9 target=9
expect: => i=9 r=0.0 ok=true s="recursive tally matched: 9" errors=0 n=3 res=[9,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum < 0 { sum = -sum; }
	while sum >= 10 {
		var next_sum = 0;
		var x = sum;
		while x > 0 {
			next_sum += x % 10;
			x /= 10;
		}
		sum = next_sum;
	}
	g.steps += g.n;
	out.i = sum;
	out.ok = (sum == tgt);
	out.s.clear();
	if sum == tgt {
		format(out.s, "recursive tally matched: ", sum);
	} else {
		gold_fail(g, "recursive tally mismatch");
		format(out.s, "recursive tally differed: ", sum);
	}
	out
}
@end
