code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_shift = ${limit};
	var count = 0;
	if g.n > 0 {
		let val = g.res[0];
		while count < max_shift && g.n > 0 && g.res[0] == val {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "streak shifted: ", count);
	out
}
@end
@entry 0f340ec8d39bea34
kind: step
verb: split
noun: spaces
modifier: unique
context: list
slot: min_gap int
phrase: split spaces unique with minimum gap {min_gap}
phrase: partition unique spaces separated by {min_gap}
test: list=10,15,18,30,35 min_gap=4
expect: => i=2 r=0.0 ok=true s="unique spaces: 2" errors=0 n=2 res=[5,12] cache=0 hits=0
test: list=1,3,5 min_gap=6
expect: => i=0 r=0.0 ok=true s="unique spaces: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var dst = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			if d >= gap {
				var dup = false;
				for j in dst {
					if g.res[j] == d { dup = true; break; }
				}
				if !dup {
					g.res[dst] = d;
					dst++;
				}
			}
		}
	}
	g.n = dst;
	g.steps += dst;
	out.i = dst;
	out.s.clear();
	format(out.s, "unique spaces: ", dst);
	out
}
@end
@entry 125e934911b1aa4e
kind: step
verb: normalize
noun: text
modifier: between
context: list
slot: lo int
slot: hi int
phrase: normalize text between lower {lo} to upper {hi}
phrase: keep characters bounded from {lo} through {hi}
test: text="Hello 123" lo=97 hi=122
expect: => i=4 r=0.0 ok=true s="ello" errors=0 n=0 res=[] cache=0 hits=0
test: text="Amni List" lo=65 hi=90
expect: => i=2 r=0.0 ok=true s="AL" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var filtered byte[>..] = [];
	for b in out.s {
		let code = b as int;
		if code >= low && code <= high {
			filtered.push(b);
		}
	}
	out.s.clear();
	for b in filtered { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry d4fbd2ab99370598
kind: step
verb: drop
noun: minimum
modifier: each
context: list
slot: min_val int
phrase: drop minimum each below floor {min_val}
phrase: discard each element under threshold {min_val}
test: list=5,12,3,25,8 min_val=10
expect: => i=3 r=0.0 ok=true s="dropped items: 3" errors=0 n=2 res=[12,25] cache=0 hits=0
test: list=2,4,6,1 min_val=4
expect: => i=2 r=0.0 ok=true s="dropped items: 2" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_lim = ${min_val};
	var dst = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] >= floor_lim {
			g.res[dst] = g.res[i];
			dst++;
		} else {
			dropped++;
		}
	}
	g.n = dst;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped items: ", dropped);
	out
}
@end
