@entry f26ececd23e7d1b3
kind: step
verb: cache
noun: minimum
modifier: up_to
context: core
phrase: cache minimum up to index limit {limit}
phrase: store minimum value up to position {limit} in cache
slot: limit int
test: list=8,3,5,9 limit=3
expect: => i=3 r=0.0 ok=true s="cached min 3" errors=0 n=4 res=[8,3,5,9] cache=1 hits=0
test: list=12,7,15 limit=2
expect: => i=7 r=0.0 ok=true s="cached min 7" errors=0 n=3 res=[12,7,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	let bound = if ${limit} < g.n { ${limit} } else { g.n };
	var min_val = g.res[0];
	for k in bound {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	gold_cache_put(g, 0, min_val);
	out.i = min_val;
	out.s.clear();
	format(out.s, "cached min ", min_val);
	out
}
@end
@entry 7120f9763c57e272
kind: step
verb: cache
noun: suffix
modifier: with_cache
context: core
phrase: cache suffix sum with cache lookup for {k} items
phrase: retrieve or store suffix sum with cache for length {k}
slot: k int
test: list=1,2,3,4 k=2
expect: => i=7 r=0.0 ok=true s="suffix sum 7" errors=0 n=4 res=[1,2,3,4] cache=1 hits=0
test: list=5,10,15 k=1
expect: => i=15 r=0.0 ok=true s="suffix sum 15" errors=0 n=3 res=[5,10,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	let cached, hit = gold_cache_get(g, key);
	if hit {
		out.i = cached;
	} else {
		var sum = 0;
		let start = if g.n > key { g.n - key } else { 0 };
		var i = start;
		while i < g.n { sum += g.res[i]; i++; }
		gold_cache_put(g, key, sum);
		out.i = sum;
	}
	out.s.clear();
	format(out.s, "suffix sum ", out.i);
	out
}
@end
@entry 9687e7e7c3d3b641
kind: step
verb: find
noun: sequence
modifier: at_least
context: core
phrase: find sequence run length of at least {min_len}
phrase: locate matching sequence streak at least length {min_len}
slot: min_len int
test: list=2,2,2,3,4 min_len=2
expect: => i=3 r=0.0 ok=true s="streak length 3" errors=0 n=5 res=[2,2,2,3,4] cache=0 hits=0
test: list=1,2,3 min_len=2
expect: => i=0 r=0.0 ok=true s="no streak" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i++;
	}
	out.i = if max_streak >= ${min_len} { max_streak } else { 0 };
	out.s.clear();
	if out.i > 0 {
		format(out.s, "streak length ", out.i);
	} else {
		out.s.append("no streak");
	}
	out
}
@end
