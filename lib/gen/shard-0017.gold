	for o in 2 { if !gold_img_square(g, c0_0) { out.ok = false; return out; } c0_0 = c0_0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc_0 = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc_0, g.iw / cc_0, ${u} + o); norm += amp; amp *= 0.5; cc_0 = cc_0 / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.52 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "wood");
	out
}
@end
