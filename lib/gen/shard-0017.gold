fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} <= 0 || ${dy} <= 0.0 { out.ok = false; return out; }
	var i = 1;
	while i <= ${n} {
		var o byte[>..] = [];
		var name byte[>..] = [];
		gold_dnews(g, "torch", "", name);
		o.append(name);
		o.append(" cyl 0,");
		gold_fnum(o, (i as real) * ${dy});
		o.append(",1 0,");
		gold_fnum(o, (i as real) * ${dy});
		o.append(",1.5 r");
		o.append("0.1 m:matte #");
		o.append("4a2e");
		o.append("18");
		gold_doc(g, o);
		i = i + 1;
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "duptorchspace");
	out
}
@end
