	let mv = ${max_val};
	var sum = 0;
	var count = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq <= mv {
			sum += sq;
			count++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded squares sum: ", sum);
	g.steps += count;
	out
}
@end
