code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var m = 0;
	var j = 0;
