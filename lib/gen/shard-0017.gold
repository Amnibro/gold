phrase: populate prefix items between {lo} to {hi} with value {val}
slot: lo int
slot: hi int
slot: val int
test: list=1,2,3,4,5 lo=1 hi=3 val=9
expect: => i=3 r=0.0 ok=true s="filled prefix between" errors=0 n=5 res=[1,9,9,9,5] cache=0 hits=0
test: list=10,20,30 lo=0 hi=1 val=7
expect: => i=2 r=0.0 ok=true s="filled prefix between" errors=0 n=3 res=[7,7,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	let rep = ${val};
	var count = 0;
	var i = 0;
	while i < g.n {
		if i >= l && i <= h {
			g.res[i] = rep;
			count++;
		}
		i++;
	}
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "filled prefix between");
	out
}
@end
