@entry 926abbde8a4c373a
kind: step
verb: fold
noun: gaps
modifier: with_retry
context: filter
slot: maxgap int
phrase: fold gaps with retry limit {maxgap}
phrase: filter fold gaps with retry threshold {maxgap}
test: list=1,5,15,18 maxgap=6
expect: => i=1 r=0.0 ok=true s="gaps folded with retry" errors=0 n=3 res=[4,6,3] cache=0 hits=0
test: list=2,4,8,20 maxgap=3
expect: => i=2 r=0.0 ok=true s="gaps folded with retry" errors=0 n=3 res=[2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${maxgap};
	var retries = 0;
	if g.n > 1 {
		var m = 0;
		var i = 0;
		while i < g.n - 1 {
			var gap = g.res[i + 1] - g.res[i];
			if gap > lim {
				gap = lim;
				retries++;
			}
			g.res[m] = gap;
			m++;
			i++;
		}
		g.n = m;
	} else {
		g.n = 0;
	}
	g.steps += g.n + retries;
	out.i = retries;
	out.s.clear();
	format(out.s, "gaps folded with retry");
	out
}
@end
@entry 1837e5d9e2de1ead
kind: step
verb: rank
noun: letters
modifier: with_cache
context: filter
phrase: rank letters with cache frequency count
phrase: filter rank letters with cache usage
test: text="banana"
expect: => i=3 r=0.0 ok=true s="ban" errors=0 n=0 res=[] cache=3 hits=3
test: text="mississippi"
expect: => i=4 r=0.0 ok=true s="misp" errors=0 n=0 res=[] cache=4 hits=7
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res_s byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		let k = b as int;
		let prev, found = gold_cache_get(g, k);
		if found {
			gold_cache_put(g, k, prev + 1);
		} else {
			gold_cache_put(g, k, 1);
			if res_s.len < 200 { res_s.push(b); }
		}
		i++;
	}
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
