expect: => i=2 r=0.0 ok=true s="limited all duplicates" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_count};
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in write_idx {
			if g.res[j] == x { seen++; }
		}
		if seen < lim {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	let removed = g.n - write_idx;
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "limited all duplicates");
	out
}
@end
@entry 40517db05d475194
kind: step
verb: limit
noun: middle
modifier: unique
context: loop
phrase: limit middle unique segment retaining distinct items
phrase: deduplicate middle region of sequence uniquely
test: list=10,2,2,3,3,20
expect: => i=2 r=0.0 ok=true s="middle made unique" errors=0 n=4 res=[10,2,3,20] cache=0 hits=0
test: list=1,4,4,4,9
expect: => i=1 r=0.0 ok=true s="middle made unique" errors=0 n=3 res=[1,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var mid_unique int[512] = [0; 512];
	var mid_n = 0;
	var i = 1;
	while i < g.n - 1 {
		let x = g.res[i];
		var seen = false;
		for j in mid_n {
			if mid_unique[j] == x { seen = true; break; }
		}
		if !seen {
			mid_unique[mid_n] = x;
			mid_n++;
		}
		i++;
	}
	let last_val = g.res[g.n - 1];
	for j in mid_n {
		g.res[1 + j] = mid_unique[j];
	}
	g.res[1 + mid_n] = last_val;
	g.n = 2 + mid_n;
	g.steps += g.n;
	out.i = mid_n;
	out.s.clear();
	format(out.s, "middle made unique");
	out
}
@end
