@entry 1e279ae7c20acc53
kind: step
verb: drop
noun: runs
modifier: with_retry
context: core
phrase: drop runs with retry exceeding run length {max_run}
phrase: discard contiguous runs longer than {max_run}
slot: max_run int
test: list=1,1,1,2,3 max_run=2
expect: => i=2 r=0.0 ok=true s="kept after dropping runs: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=4,4,5,6 max_run=2
expect: => i=4 r=0.0 ok=true s="kept after dropping runs: 4" errors=0 n=4 res=[4,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var kept int[512] = [0; 512];
	var k_len = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len <= ${max_run} {
			for idx in run_len {
				kept[k_len] = g.res[i + idx];
				k_len++;
			}
		}
		i = j;
	}
	g.n = 0;
	for k in k_len { gold_push(g, kept[k]); }
	out.i = k_len;
	out.s.clear();
	format(out.s, "kept after dropping runs: ", k_len);
	out
}
@end
