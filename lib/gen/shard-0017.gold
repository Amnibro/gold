fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept {
		for j in (i + 1)..kept {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n + kept * kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " sorted items");
	out
}
@end
