fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let check = ${cp};
	var last_idx = -1;
	for i in g.n {
		if g.res[i] == check {
			last_idx = i;
		}
	}
	if last_idx < 0 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "checkpoint not found");
		return out;
	}
	var count = 0;
	for i in (last_idx + 1)..g.n {
		g.res[count] = g.res[i];
		count++;
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "retained ", count, " items after checkpoint");
	out
}
@end
