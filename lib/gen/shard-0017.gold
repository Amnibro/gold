phrase: adjust consecutive gaps to limit {max_gap}
slot: max_gap int
test: list=10,30,40 max_gap=5
expect: => i=2 r=0.0 ok=true s="clamped 2 gaps" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=0,20,50 max_gap=10
expect: => i=2 r=0.0 ok=true s="clamped 2 gaps" errors=0 n=3 res=[0,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n <= 1 || mg <= 0 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "normalized gaps");
		return out;
	}
	var clamped = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " gaps");
	out
}
@end
