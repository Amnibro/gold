code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "pairwise: [");
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if pairs > 0 { format(out.s, ", "); }
		format(out.s, s);
		pairs++;
		i += 2;
	}
	format(out.s, "]");
	out.i = pairs;
	g.steps += g.n;
	out
}
@end
@entry 65ee864882beb228
kind: step
verb: fold
noun: squares
modifier: each
context: format
phrase: fold squares of each element into total
phrase: accumulate sum of squares for each item
test: list=1,2,3
expect: => i=14 r=0.0 ok=true s="sum of squares: 14" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=2,4,5
