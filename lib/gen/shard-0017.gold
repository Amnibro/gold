@entry 06680142f18ad3fa
kind: step
verb: streak
noun: leather
modifier: banded
context: texture
phrase: streak banded leather diffuse map with seed {u}
phrase: render banded leather surface texture using seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; contrast a=1.5; quantize n=4
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=46495 hash=954394
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=115855 hash=738740
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	for k in g.iw * g.ih {
		var q = (g.img[k] * 4.0) as! int;
		if q > 3 { q = 3; }
		g.img[k] = (q as real) / 3.0;
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
@end
