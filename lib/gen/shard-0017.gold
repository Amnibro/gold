code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	if out.s.len > ml {
		var truncated byte[>..] = [];
		var i = 0;
		while i < ml {
			truncated.push(out.s[i]);
			i++;
		}
		out.s.clear();
		for b in truncated { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
