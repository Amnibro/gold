code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var above = 0;
	var j = 0;
	while j < g.n {
		if g.res[j] > avg { above++; }
		j++;
	}
	out.s.clear();
	format(out.s, "above avg ", avg, ": ", above);
	out.i = above;
	g.steps += g.n * 2;
	out
}
@end
