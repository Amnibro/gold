fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		return out;
	}
	let last_idx = g.n - 1;
	var val = g.res[last_idx];
	var is_sq = false;
	var r = 0;
	while r * r <= val {
