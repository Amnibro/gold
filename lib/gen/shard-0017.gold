fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		for i in g.n { g.res[i] -= avg; }
		let transformed = ${f}(avg);
		gold_cache_put(g, 0, transformed);
		out.i = avg;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "mean offset: ", out.i);
	out
}
