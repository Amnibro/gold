		let is_vowel = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		               b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U';
		if exp.len < 200 { exp.push(b); }
		if is_vowel && exp.len < 200 { exp.push(b); }
		i++;
	}
	out.s.clear();
	var j = 0;
	while j < exp.len {
		out.s.push(exp[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
