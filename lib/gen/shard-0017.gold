fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		var res = 0;
		if ok {
			res = cached;
		} else {
			res = ${f}(x);
			gold_cache_put(g, x, res);
		}
		g.res[i] = res;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached items: ", g.n);
	out
}
@end
