expect: => i=4 r=0.0 ok=true s="range filtered count: 4" errors=0 n=4 res=[2,4,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var tmp = [0; 512];
	var u = 0;
	var matchIdx = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h {
			if matchIdx % 2 == 0 {
				tmp[u] = x;
				u++;
			}
			matchIdx++;
		} else {
			tmp[u] = x;
			u++;
		}
	}
	for i in u { g.res[i] = tmp[i]; }
	g.n = u;
	out.i = u;
	out.s.clear();
	format(out.s, "range filtered count: ", u);
	g.steps += u;
	out
}
@end
@entry d3fecf38fbc3cde1
kind: step
verb: trace
noun: pairs
modifier: until
context: retry
phrase: trace retry pairs until difference reaches target {stop_diff}
phrase: record adjacent retry pairs stopping at diff {stop_diff}
slot: stop_diff int
test: list=2,5,8,18,20 stop_diff=10
expect: => i=3 r=0.0 ok=true s="matched pair index: 3" errors=0 n=5 res=[2,5,8,18,20] cache=0 hits=0
test: list=1,4,9,14 stop_diff=5
expect: => i=2 r=0.0 ok=true s="matched pair index: 2" errors=0 n=4 res=[1,4,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sd = ${stop_diff};
	var matchedPair = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let d = g.res[i + 1] - g.res[i];
			let diff = if d < 0 { -d } else { d };
			if diff == sd {
				matchedPair = i + 1;
				break;
			}
		}
	}
	out.i = matchedPair;
	out.s.clear();
	format(out.s, "matched pair index: ", matchedPair);
	g.steps += g.n;
	out
}
@end
