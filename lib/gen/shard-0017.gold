@entry fa18b34b426ea3e0
kind: step
verb: drop
noun: maximum
modifier: times
context: transform
phrase: drop maximum value {times} times
phrase: remove highest element {times} times
slot: times int
test: list=3,9,5,9,2 times=1
expect: => i=1 r=0.0 ok=true s="dropped maximum 1 times" errors=0 n=4 res=[3,5,9,2] cache=0 hits=0
test: list=12,4,8,12 times=2
expect: => i=2 r=0.0 ok=true s="dropped maximum 2 times" errors=0 n=2 res=[4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var drops = 0;
	while drops < t && g.n > 0 {
		var max_idx = 0;
		for i in 1..g.n {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		for i in max_idx..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
		drops++;
	}
	g.steps += drops * g.n;
	out.i = drops;
	out.s.clear();
	format(out.s, "dropped maximum ", drops, " times");
	out
}
@end
