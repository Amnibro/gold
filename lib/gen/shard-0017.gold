code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps found");
		return out;
	}
	var u_diffs int[512] = [0; 512];
	var un = 0;
	for i in 0..(g.n - 1) {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		var exists = false;
		for j in un {
			if u_diffs[j] == diff {
				exists = true;
				break;
			}
		}
		if !exists {
			u_diffs[un] = diff;
			un++;
		}
	}
	for i in un {
		g.res[i] = u_diffs[i];
	}
	g.steps += g.n + un * un;
	g.n = un;
	out.i = un;
	out.s.clear();
	format(out.s, "found ", un, " unique gaps");
	out
}
@end
@entry 740af400d268da3b
kind: step
verb: run
noun: gaps
modifier: until
context: transform
phrase: run gaps until predicate {p}
phrase: fill missing steps until {p}
slot: p pred
test: list=2,20 p=under_10
expect: => i=3 r=0.0 ok=true s="expanded gaps to 3 items" errors=0 n=3 res=[2,11,20] cache=0 hits=0
test: list=0,40 p=under_10
expect: => i=3 r=0.0 ok=true s="expanded gaps to 3 items" errors=0 n=3 res=[0,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "insufficient items");
		return out;
	}
	var new_res int[512] = [0; 512];
	var count = 0;
	new_res[0] = g.res[0];
	count = 1;
	for i in 0..(g.n - 1) {
		let a = g.res[i];
		let b = g.res[i + 1];
		let mid = (a + b) / 2;
		if !${p}(b - a) && count < 511 {
			new_res[count] = mid;
			count++;
		}
		if count < 512 {
			new_res[count] = b;
			count++;
		}
	}
	for i in count {
		g.res[i] = new_res[i];
	}
	g.steps += g.n + count;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "expanded gaps to ", count, " items");
	out
}
@end
