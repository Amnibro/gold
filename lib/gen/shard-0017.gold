expect: => i=3 r=0.0 ok=true s="collected 3 sorted runs" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no runs in empty list");
		return out;
	}
	var counts int[512] = [0; 512];
	var cn = 0;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			counts[cn] = cur_run;
			cn++;
			cur_run = 1;
		}
	}
	counts[cn] = cur_run;
	cn++;
	for i in cn {
		for j in (i + 1)..cn {
			if counts[j] < counts[i] {
				let tmp = counts[i];
				counts[i] = counts[j];
				counts[j] = tmp;
			}
		}
	}
	for i in cn {
		g.res[i] = counts[i];
	}
	g.steps += g.n + cn * cn;
	g.n = cn;
	out.i = cn;
	out.s.clear();
	format(out.s, "collected ", cn, " sorted runs");
	out
}
@end
