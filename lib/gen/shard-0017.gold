@entry 699e26526df6b0fc
kind: step
verb: dedupe
noun: words
modifier: all
context: filter
phrase: dedupe all words in text
phrase: filter duplicate words from string
test: text="apple banana apple orange banana"
expect: => i=3 r=0.0 ok=true s="apple banana orange" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two three one two"
expect: => i=3 r=0.0 ok=true s="one two three" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = words(out.s);
	var res byte[>..] = [];
	var count = 0;
	for w, i in ws {
		var seen = false;
		for prev, j in ws {
			if j < i && prev == w { seen = true; }
		}
		if !seen {
			if count > 0 { res.push(' '); }
			res.append(w);
			count++;
		}
	}
	g.steps += ws.len;
	out.i = count;
	out.s.clear();
	for b in res { if out.s.len < 200 { out.s.push(b); } }
	out
}
@end
@entry f3af3fcd08b89bf8
kind: step
