fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sum = 0;
	var triggered = false;
	for i in g.n {
		if !triggered {
			if ${cond}(g.res[i]) {
				triggered = true;
			} else {
				sum += g.res[i];
				count++;
			}
		}
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = count;
	out.ok = triggered;
	out.s.clear();
	format(out.s, "grouped count: ", count);
	out
}
@end
