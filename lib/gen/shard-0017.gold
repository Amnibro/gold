	let limit = ${budget};
	var swapped = false;
	if g.steps < limit {
		if g.n > 1 {
			let tmp = g.res[0];
			g.res[0] = g.res[g.n - 1];
			g.res[g.n - 1] = tmp;
			swapped = true;
		}
	}
	g.steps += 1;
	out.ok = swapped;
	out.s.clear();
	format(out.s, if swapped { "budget swap ok" } else { "budget exceeded" });

	out
}
