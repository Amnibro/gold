	let factor = ${mul};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	g.res[mid] = g.res[mid] * factor;
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "middle element scaled: ", total);
	out
}
@end
