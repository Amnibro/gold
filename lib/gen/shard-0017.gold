expect: => i=36 r=0.0 ok=true s="maximum scaled" errors=0 n=5 res=[3,7,36,36,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n > 0 {
		var max_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
			}
		}
		var scaled_count = 0;
		for i in g.n {
			if g.res[i] == max_val {
				g.res[i] *= f;
				scaled_count++;
			}
		}
		out.i = max_val * f;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "maximum scaled");
	out
}
@end
