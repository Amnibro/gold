@entry be799b3d717feda5
kind: step
verb: check
noun: number
modifier: with_cache
context: list
phrase: check number {target} with cache lookup
phrase: verify number {target} present with cache
slot: target int
test: list=10,20,30 target=20
expect: => i=1 r=0.0 ok=true s="checked number with cache update" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=false s="checked number with cache update" errors=0 n=3 res=[5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached_idx, found_in_cache = gold_cache_get(g, tgt);
	if found_in_cache {
		out.i = cached_idx;
		out.ok = (cached_idx >= 0);
		out.s.clear();
		format(out.s, "number found in cache");
		return out;
	}
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	gold_cache_put(g, tgt, idx);
	g.steps += g.n;
	out.i = idx;
	out.ok = (idx >= 0);
	out.s.clear();
	format(out.s, "checked number with cache update");
	out
}
@end
