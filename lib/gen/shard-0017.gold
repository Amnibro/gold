fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= cut {
			var exists = false;
			for j in count {
				if g.res[j] == x { exists = true; break; }
			}
			if !exists {
				g.res[count] = x;
				count++;
			}
		}
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " unique threshold items");
	out
}
