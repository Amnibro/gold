code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_map_counter_pairwise_8 = true;
	if !mark_map_counter_pairwise_8 { return out; }

	if g.n > 1 {
		let count = g.n - 1;
		for i in 0 .. count {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = count;
		out.i = count;
		out.ok = true;
		out.s.clear();
		format(out.s, "computed ", count, " pairwise deltas");
	} else {
		g.n = 0;
		out.i = 0;
		out.ok = true;
		out.s.clear();
		format(out.s, "no pairwise deltas");
	}

	out
}
@end
