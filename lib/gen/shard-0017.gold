fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_measure_tally_sorted_21 = true;
	if !mark_measure_tally_sorted_21 { return out; }

	var distinct = 0;
	for i in 0 .. g.n {
		var seen = false;
		for j in 0 .. i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			distinct += 1;
		}
	}
	out.i = distinct;
	out.ok = true;
	out.s.clear();
	format(out.s, "tally of ", distinct, " distinct values");

	out
}
@end
