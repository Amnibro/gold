		let x = g.res[j];
		if x > avg {
			g.res[m] = x;
			m++;
		}
		j++;
	}
	g.n = m;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "rotated above average");
	out
}
@end
