@entry 8db05b0d9782f173
kind: step
verb: rotate
noun: sequence
modifier: at_least
context: filter
slot: threshold int
phrase: rotate sequence at least threshold {threshold}
phrase: filter rotate sequence at least value {threshold}
test: list=2,8,4,10,1 threshold=5
expect: => i=2 r=0.0 ok=true s="sequence rotated at least" errors=0 n=2 res=[10,8] cache=0 hits=0
test: list=12,3,15,1 threshold=10
expect: => i=2 r=0.0 ok=true s="sequence rotated at least" errors=0 n=2 res=[15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var m = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= th {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sequence rotated at least");
	out
}
@end
