fn ${ID}_tolower(b byte) byte {
	if b >= 'A' && b <= 'Z' { (b as int + 32) as! byte } else { b }
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var chars byte[>..] = [];
	for b in v.s {
		chars.push(${ID}_tolower(b));
	}
	for i in chars.len {
		var j = i;
		while j > 0 && chars[j - 1] > chars[j] {
			let tmp = chars[j - 1];
			chars[j - 1] = chars[j];
			chars[j] = tmp;
			j--;
		}
	}
	out.s.clear();
	for b in chars { out.s.push(b); }
	out.i = chars.len;
	out
}
@end
