@entry 8b570cad0b11070c
kind: step
verb: merge
noun: checkpoint
modifier: running
context: aggregate
slot: val int
phrase: merge running checkpoint value {val} into aggregate
phrase: record running checkpoint with value {val}
test: list=10,30,50 val=25
expect: => i=115 r=0.0 ok=true s="running checkpoint merged sum: 115" errors=0 n=4 res=[10,25,30,50] cache=0 hits=0
test: list=5,15,25 val=10
expect: => i=55 r=0.0 ok=true s="running checkpoint merged sum: 55" errors=0 n=4 res=[5,10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${val};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	gold_push(g, p);
	var k = g.n - 1;
	while k > 0 && g.res[k] < g.res[k - 1] {
		let tmp = g.res[k];
		g.res[k] = g.res[k - 1];
		g.res[k - 1] = tmp;
		k--;
	}
	var total = 0;
	for m in g.n { total += g.res[m]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "running checkpoint merged sum: ", total);
	out
}
@end
@entry d95128b1965d17e1
kind: step
verb: reverse
noun: minimum
modifier: with_cache
context: aggregate
slot: k int
phrase: reverse elements up to minimum storing in cache {k}
phrase: cache reversed prefix up to minimum value under {k}
test: list=10,20,5,30 k=1
expect: => i=5 r=0.0 ok=true s="reversed up to minimum: 5" errors=0 n=4 res=[5,20,10,30] cache=1 hits=0
test: list=15,3,8 k=2
expect: => i=3 r=0.0 ok=true s="reversed up to minimum: 3" errors=0 n=3 res=[3,15,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	if g.n == 0 { out.ok = false; return out; }
	var min_val = g.res[0];
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var i = 0;
	var j = min_idx;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	gold_cache_put(g, key, min_val);
	g.steps += min_idx + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "reversed up to minimum: ", min_val);
	out
}
@end
