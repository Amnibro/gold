@entry 06109a29bddae61f
kind: step
verb: split
noun: histogram
modifier: sorted
context: transform
phrase: split histogram sorted by frequency
phrase: build sorted frequency histogram
test: list=5,5,5,2,2,8
expect: => i=3 r=0.0 ok=true s="histogram sorted with 3 bins" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,2,3,3,3,4,4,4,4
expect: => i=4 r=0.0 ok=true s="histogram sorted with 4 bins" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty histogram");
		return out;
	}
	var uvals int[512] = [0; 512];
	var ucnt int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in un {
			if uvals[j] == x {
				found = j;
				break;
			}
		}
		if found >= 0 {
			ucnt[found]++;
		} else {
			uvals[un] = x;
			ucnt[un] = 1;
			un++;
		}
	}
	for i in un {
		for j in (i + 1)..un {
			if ucnt[j] < ucnt[i] {
				let tmp = ucnt[i];
				ucnt[i] = ucnt[j];
				ucnt[j] = tmp;
			}
		}
	}
	for i in un {
		g.res[i] = ucnt[i];
	}
	g.steps += g.n + un * un;
	g.n = un;
	out.i = un;
	out.s.clear();
	format(out.s, "histogram sorted with ", un, " bins");
	out
}
@end
