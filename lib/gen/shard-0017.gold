test: list=1,1,1,2,3
expect: => i=3 r=0.0 ok=true s="unique values retained: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "unique values retained: ", write_idx);
	out
}
@end
