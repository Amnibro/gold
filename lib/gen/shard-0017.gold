	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc_0 = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc_0, g.iw / cc_0, ${u} + o); norm += amp; amp *= 0.5; cc_0 = cc_0 / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s_s1 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_s1[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_s1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.36 + 0.5); }
	out.i = g.iw * g.ih;
