	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted function results");
	out
}
@end
