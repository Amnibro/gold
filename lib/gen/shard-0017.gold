code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	if g.n >= 2 {
		var i = g.n - 1;
		while i > 0 {
			if g.res[i] < g.res[i - 1] { ok = false; break; }
			i--;
		}
	}
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "reverse step check: ", ok);
	out
}
@end
