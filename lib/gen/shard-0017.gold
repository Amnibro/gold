fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = min(${k}, g.n);
	let mul = ${times};
	var suffix_sum = 0;
	var start = g.n - count;
	var i = start;
	while i < g.n {
		suffix_sum += g.res[i];
		i++;
	}
	let total = suffix_sum * mul;
	g.steps += count * mul;
	out.i = total;
	out.s.clear();
	format(out.s, "repeated suffix scan total: ", total);
	out
}
