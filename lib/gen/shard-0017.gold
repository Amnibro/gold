fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop_b = ${stop_char} as byte;
	var cut = out.s.len;
	for i in out.s.len {
		if out.s[i] == stop_b && cut == out.s.len {
			cut = i;
		}
	}
	var res byte[..200] = "";
	for i in cut { res.push(out.s[i]); }
	g.steps += out.s.len;
	out.s = res;
	out.i = cut;
	out
}
@end
@entry f348ae49595abcf2
kind: step
verb: group
noun: results
modifier: recursively
context: core
slot: bucket_size int
phrase: group results recursively by chunk size {bucket_size}
phrase: cluster results recursively in buckets of {bucket_size}
test: list=1,2,3,4,5,6 bucket_size=2
expect: => i=3 r=0.0 ok=true s="grouped buckets count: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 bucket_size=3
expect: => i=2 r=0.0 ok=true s="grouped buckets count: 2" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket_size};
	if b <= 0 {
		gold_fail(g, "invalid bucket size");
		out.ok = false;
		return out;
	}
	var new_res int[256];
	var nn = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		for k in b {
			if i + k < g.n { sum += g.res[i + k]; }
		}
		if nn < 256 { new_res[nn] = sum; nn++; }
		i += b;
	}
	for k in nn { g.res[k] = new_res[k]; }
	g.n = nn;
	g.steps += g.n;
	out.i = nn;
	out.s.clear();
	format(out.s, "grouped buckets count: ", nn);
	out
}
@end
