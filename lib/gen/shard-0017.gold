expect: 15
expect: 15
code:
fn ${ID}(n int) int {
	let limit = ${thresh};
	var val = if n < 0 { -n } else { n };
	var sum_sq = 0;
	while val >= 10 {
		let d1 = val % 10;
		let d2 = (val / 10) % 10;
		sum_sq += d1 * d1 + d2 * d2;
		val /= 10;
	}
	if limit > 0 && sum_sq > limit { limit } else { sum_sq }
}
@end
