code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var a int[16] = [0; 16];
	var len = 0;
	while x > 0 && len < 16 {
		a[len] = x % 10;
		len++;
		x /= 10;
	}
	var inversions = 0;
	for i in len {
		var j = i + 1;
		while j < len {
			if a[i] > a[j] { inversions++; }
			j++;
		}
	}
	inversions
}
