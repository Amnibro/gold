expect: => i=2 r=0.0 ok=true s="swaps executed: 2" errors=0 n=4 res=[2,6,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${max_swaps};
	var swaps = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 && swaps < budget {
			var j = 0;
			while j < g.n - 1 - i && swaps < budget {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
					swaps++;
				}
				j++;
			}
			i++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps executed: ", swaps);
	g.steps += swaps;
	out
}
@end
