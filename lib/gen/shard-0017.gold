fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lim};
	let pairs = g.n / 2;
	for i in pairs {
		let s = g.res[2 * i] + g.res[2 * i + 1];
		g.res[i] = if s > bound { bound } else { s };
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired items: ", pairs);
	out
}
@end
