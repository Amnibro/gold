			retries++;
		}
		i++;
	}
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = retries;
	g.steps += out.s.len + retries;
	out
}
@end
