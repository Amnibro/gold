slot: key int
phrase: reverse first {k} elements caching original head under {key}
phrase: cache initial element under {key} reversing first {k}
test: list=10,20,30,40 k=3 key=1
expect: => i=60 r=0.0 ok=true s="reversed first elements total: 60" errors=0 n=4 res=[30,20,10,40] cache=1 hits=0
test: list=5,15,25 k=2 key=2
expect: => i=20 r=0.0 ok=true s="reversed first elements total: 20" errors=0 n=3 res=[15,5,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = min(${k}, g.n);
	let cache_key = ${key};
	if g.n == 0 { out.ok = false; return out; }
	gold_cache_put(g, cache_key, g.res[0]);
	var i = 0;
	var j = count - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	var total = 0;
	for m in count { total += g.res[m]; }
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "reversed first elements total: ", total);
	out
}
@end
