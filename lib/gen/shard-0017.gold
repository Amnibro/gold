@entry 67df8955e806206a
kind: step
verb: select
noun: primes
modifier: up_to
context: sort
phrase: select primes up to ceiling limit {ceiling}
phrase: filter sorted prime values up to {ceiling}
slot: ceiling int
test: list=2,3,4,5,6,7,8,9 ceiling=7
expect: => i=4 r=0.0 ok=true s="primes up to limit: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=10,11,12,13,14,15 ceiling=14
expect: => i=2 r=0.0 ok=true s="primes up to limit: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= ceil && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
				}
				d++;
			}
			if is_p {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "primes up to limit: ", w);
	out
}
@end
