expect: => i=2 r=0.0 ok=true s="split pivot: 2" errors=0 n=4 res=[2,4,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var buf int[512] = [0; 512];
	var dst = 0;
	var less_count = 0;
	for i in g.n {
		if g.res[i] < p {
			buf[dst] = g.res[i];
			dst++;
			less_count++;
		}
	}
	for i in g.n {
		if g.res[i] == p {
			buf[dst] = g.res[i];
			dst++;
		}
	}
	for i in g.n {
		if g.res[i] > p {
			buf[dst] = g.res[i];
			dst++;
		}
	}
	for i in dst { g.res[i] = buf[i]; }
	g.n = dst;
	g.steps += dst;
	out.i = less_count;
	out.s.clear();
	format(out.s, "split pivot: ", less_count);
	out
}
@end
