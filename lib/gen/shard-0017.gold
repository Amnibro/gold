fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n <= 3 { return out; }
	let len = g.n - 2;
	let k = ((sh % len) + len) % len;
	var tmp = [0; 512];
	for i in len { tmp[i] = g.res[1 + i]; }
	for i in len {
		g.res[1 + ((i + k) % len)] = tmp[i];
	}
	gold_cache_put(g, k, g.res[1]);
	out.i = g.res[1];
	out.s.clear();
	format(out.s, "rotated middle element: ", out.i);
	g.steps += len;
	out
}
@end
