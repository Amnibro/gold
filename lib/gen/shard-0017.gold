noun: threshold
modifier: until
context: sort
phrase: retry threshold until elements exceed value {thresh}
phrase: filter threshold until reaching cutoff {thresh}
slot: thresh int
test: list=2,4,7,12,18 thresh=6
expect: => i=3 r=0.0 ok=true s="filtered count: 3" errors=0 n=3 res=[7,12,18] cache=0 hits=0
test: list=1,3,5,10,15 thresh=8
expect: => i=2 r=0.0 ok=true s="filtered count: 2" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var w = 0;
	var started = false;
	for i in g.n {
		if !started {
			if g.res[i] >= t {
				started = true;
				g.res[w] = g.res[i];
				w++;
			}
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "filtered count: ", w);
	out
}
@end
