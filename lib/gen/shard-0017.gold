code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_len};
	if out.s.len >= m {
		var truncated byte[>..] = [];
		for i in m {
			truncated.push(out.s[i]);
		}
		out.s.clear();
		for b in truncated { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
