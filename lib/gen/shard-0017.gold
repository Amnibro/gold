expect: => i=2 r=0.0 ok=true s="scaled 2 suffix items" errors=0 n=4 res=[2,4,24,48] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${k};
	let f = ${factor};
	if cnt > g.n { cnt = g.n; }
	let start = g.n - cnt;
	for i in cnt {
		g.res[start + i] = g.res[start + i] * f;
	}
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "scaled ", cnt, " suffix items");
	out
}
@end
