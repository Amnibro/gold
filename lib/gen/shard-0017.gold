fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_count};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let is_letter = (x >= 65 && x <= 90) || (x >= 97 && x <= 122);
		if is_letter && kept < lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept letters: ", kept);
	out
}
@end
