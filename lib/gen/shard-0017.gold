@entry 7d58c28bfb4e55cc
kind: step
verb: normalize
noun: streak
modifier: recursively
context: list
slot: max_streak int
phrase: normalize streak recursively to length {max_streak}
phrase: cap repeated streak runs at {max_streak}
test: list=3,3,3,3,5,5 max_streak=2
expect: => i=4 r=0.0 ok=true s="capped streak: 4" errors=0 n=4 res=[3,3,5,5] cache=0 hits=0
test: list=1,1,1,2,2,2,2 max_streak=1
expect: => i=2 r=0.0 ok=true s="capped streak: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_streak};
	if cap <= 0 {
		gold_fail(g, "invalid streak cap");
		out.ok = false;
		return out;
	}
	var dst = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let keep = if run_len < cap { run_len } else { cap };
		for k in keep {
			g.res[dst] = g.res[i];
			dst++;
		}
		i = j;
	}
	g.n = dst;
	g.steps += dst;
	out.i = dst;
	out.s.clear();
	format(out.s, "capped streak: ", dst);
	out
}
@end
