code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lim};
	let k = if l < g.n { l } else { g.n };
	var i = 0;
	var j = k - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.n = k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed items: ", k);
	g.steps += k;
	out
}
@end
