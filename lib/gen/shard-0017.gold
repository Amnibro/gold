@entry c864a018a461754d
kind: step
verb: apply
noun: streak
modifier: nested
context: list
slot: factor int
phrase: apply streak nested scaling by {factor}
phrase: multiply run streak values with factor {factor}
test: list=2,2,5,3,3,3 factor=2
expect: => i=6 r=0.0 ok=true s="processed streak: 6" errors=0 n=6 res=[4,4,5,6,6,6] cache=0 hits=0
test: list=1,1,9 factor=3
expect: => i=3 r=0.0 ok=true s="processed streak: 3" errors=0 n=3 res=[3,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len > 1 {
			for k in i..j {
				g.res[k] *= f;
			}
		}
		i = j;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "processed streak: ", g.n);
	out
}
@end
