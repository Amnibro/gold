	if g.n < 2 { out.ok = false; return out; }
	let pair_sum = g.res[0] + g.res[1];
	g.res[0] = pair_sum;
	for i in 1..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = pair_sum;
	out.s.clear();
	format(out.s, "first pair sum: ", pair_sum);
