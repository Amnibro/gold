fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean byte[..200] = "";
	var in_space = false;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if !in_space {
				if clean.len < 200 { clean.push(' '); }
				in_space = true;
			}
		} else {
			if clean.len < 200 { clean.push(b); }
			in_space = false;
		}
		i++;
	}
	out.s.clear();
	var j = 0;
	while j < clean.len {
		out.s.push(clean[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
