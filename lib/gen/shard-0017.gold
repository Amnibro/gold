	let limit = ${max_words};
	var words_seen = 0;
	var cur_len = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if cur_len > 0 && words_seen < limit {
				gold_cache_put(g, words_seen, cur_len);
				words_seen++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 && words_seen < limit {
		gold_cache_put(g, words_seen, cur_len);
		words_seen++;
	}
	g.steps += v.s.len;
	out.i = words_seen;
	out.s.clear();
