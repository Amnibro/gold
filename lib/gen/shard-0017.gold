fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[count] = x;
			count++;
		}
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "paired ", count, " unique values");
	out
}
@end
