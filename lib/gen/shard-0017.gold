@entry 7097694861641b8e
kind: step
verb: find
noun: spaces
modifier: first
context: core
slot: max_check int
phrase: find spaces first within character limit {max_check}
phrase: locate first space position up to {max_check}
test: text="hello world" max_check=10
expect: => i=5 r=0.0 ok=true s="first space found at: 5" errors=0 n=0 res=[] cache=0 hits=0
test: text="foo bar baz" max_check=3
expect: => i=-1 r=0.0 ok=false s="space absent" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_check};
	let bound = if limit < out.s.len { limit } else { out.s.len };
	var found = false;
	var pos = -1;
	var i = 0;
	while i < bound && !found {
		if out.s[i] == ' ' {
			found = true;
			pos = i;
		}
		i++;
	}
	g.steps += bound;
	out.ok = found;
	out.i = pos;
	out.s.clear();
	if found {
		format(out.s, "first space found at: ", pos);
	} else {
		gold_fail(g, "space not found");
		format(out.s, "space absent");
	}
	out
}
@end
