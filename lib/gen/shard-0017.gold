code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid = g.n / 2;
	let val = g.res[mid];
	let cached, ok = gold_cache_get(g, val);
	let scaled = if ok { cached } else { val * f };
	if !ok { gold_cache_put(g, val, scaled); }
	g.res[mid] = scaled;
	g.steps += 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "middle scaled: ", scaled);
	out
}
@end
