		if b == '(' || b == '[' {
			depth++;
			if depth > maxDepth { maxDepth = depth; }
		} else if b == ')' || b == ']' {
			if depth > 0 { depth--; }
		}
	}
	out.i = maxDepth;
	out.s.clear();
	format(out.s, "nested text depth: ", maxDepth);
