fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_unique = true;
	var i = 0;
	while i < out.s.len {
		var j = i + 1;
		while j < out.s.len {
			if out.s[i] == out.s[j] {
				is_unique = false;
				break;
			}
			j++;
		}
		if !is_unique { break; }
		i++;
	}
	out.ok = is_unique;
	out.s.clear();
	format(out.s, "letters unique: ", is_unique);
	out.i = if is_unique { 1 } else { 0 };
	g.steps += out.s.len;
	out
}
@end
