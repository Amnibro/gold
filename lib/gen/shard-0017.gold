fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let pairs = g.n - 1;
	for i in pairs {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		g.res[i] = if abs_diff < fl { fl } else { abs_diff };
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise differences: ", pairs);
	out
}
