	let k = ${count};
	var res_s byte[..200] = "";
	var found = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		if b >= '0' && b <= '9' {
			if found < k {
				if res_s.len < 200 { res_s.push(b); }
				found++;
			}
		}
		i++;
	}
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
