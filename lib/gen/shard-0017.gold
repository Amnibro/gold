code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_select_subfunction_recursively_12 = true;
	if !mark_select_subfunction_recursively_12 { return out; }

	let m = ${mod};
	var kept = 0;
	if m != 0 {
		for i in 0 .. g.n {
			if g.res[i] % m == 0 {
				g.res[kept] = g.res[i];
				kept += 1;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "kept ", kept, " items matching mod");

	out
}
@end
