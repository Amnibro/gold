fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = 0;
	var new_s byte[..200] = "";
	for b in out.s {
		if b >= 'a' && b <= 'z' {
			new_s.push(b - 32);
			changed++;
		} else {
			new_s.push(b);
		}
	}
	out.s = new_s;
	out.i = changed;
	g.steps += out.s.len;
	out
}
@end
