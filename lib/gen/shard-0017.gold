fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		let val = g.res[i];
		var first = true;
		for j in i {
			if g.res[j] == val { first = false; break; }
		}
		if first {
			var occurrences = 0;
			for k in g.n {
				if g.res[k] == val { occurrences++; }
			}
			if occurrences > 1 { dup_count++; }
		}
	}
	out.i = dup_count;
	out.s.clear();
	format(out.s, "duplicates: ", dup_count);
	out
}
@end
