test: list=5,5,5,20 budget=12
expect: => i=2 r=0.0 ok=true s="dropped within budget" errors=0 n=2 res=[5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var drop_count = 0;
	while drop_count < g.n && spent + g.res[drop_count] <= b {
		spent += g.res[drop_count];
		drop_count++;
	}
	let rem = g.n - drop_count;
	for i in rem {
		g.res[i] = g.res[i + drop_count];
	}
	g.n = rem;
	g.steps += drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped within budget");
	out
}
@end
