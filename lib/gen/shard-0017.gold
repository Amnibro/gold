code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var d int[..32] = [];
	while x > 0 { d.push(x % 10); x /= 10; }
	var gap_sum = 0;
	var prev_gap = -1;
	var monotonic = 1;
	var i = d.len - 1;
	while i > 0 {
		var g = d[i - 1] - d[i];
		if g < 0 { g = -g; }
		gap_sum += g;
		if prev_gap >= 0 && g < prev_gap { monotonic = 0; }
		prev_gap = g;
		i--;
	}
	gap_sum + monotonic * 10
}
@end
