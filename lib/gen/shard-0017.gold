slot: dur real
test: dur=4.0 doc="wall box 0,3,1.5 4,0.3,3"
expect: => i=2 r=0.0 ok=true s="orbitwall" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: wall box 0,3,1.5 4,0.3,3
expect: => doc: wall.rot anim 0:0,0,0 4:0,0,360 loop
test: dur=8.0 doc="floor box 0,0,-.5 12,12,1|barrier box 0,4,1 5,0.4,2"
expect: => i=3 r=0.0 ok=true s="orbitwall" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: floor box 0,0,-.5 12,12,1
expect: => doc: barrier box 0,4,1 5,0.4,2
expect: => doc: barrier.rot anim 0:0,0,0 8:0,0,360 loop
test: dur=0.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var anim byte[>..] = [];
	var target byte[>..] = [];
	if !gold_dlast(g, target) { out.ok = false; return out; }
	if ${dur} <= 0.0 { out.ok = false; return out; }
	anim.append(target);
	anim.append(".rot anim 0:0,");
	anim.append("0,0 ");
	gold_fnum(anim, ${dur});
	anim.append(":0,0,");
	anim.append("36");
	anim.append("0 loop");
	gold_doc(g, anim);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "orbitwall");
	out
}
@end
