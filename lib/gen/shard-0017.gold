code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			let shifted = (((b as int - 'a' as int + s) % 26 + 26) % 26) + 'a' as int;
			out.s[i] = shifted as byte;
		}
	}
	g.steps += out.s.len;
	out.i = s;
	out
}
@end
@entry 61e75fbbe0524b68
kind: step
verb: drop
noun: streak
modifier: in_reverse
context: core
slot: streak_len int
phrase: drop streak in reverse exceeding length {streak_len}
phrase: remove trailing streaks backward if longer than {streak_len}
test: list=1,2,3,3,3 streak_len=2
expect: => i=3 r=0.0 ok=true s="dropped streak: 3" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,6,7,8 streak_len=3
expect: => i=0 r=0.0 ok=true s="dropped streak: 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${streak_len};
	if g.n == 0 { return out; }
	var k = 1;
	let last_val = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 && g.res[i - 1] == last_val {
		k++;
		i--;
	}
	if k >= limit {
		g.n -= k;
		out.i = k;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "dropped streak: ", out.i);
	out
}
@end
