expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: hand bone 0.5,0,1 0.7,0,1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${len} <= 0.0 || ${drop} < 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "finger", "", o);
	o.append(" bone 0.");
	o.append("7,");
	o.append("0,");
	o.append("1 ");
	gold_fnum(o, 0.7 + ${len});
	o.append(",0,");
	gold_fnum(o, 1.0 - ${drop});
	o.append(" ^hand");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "attachfinger");
	out
}
@end
