@entry 57b5fbeaf9ae225e
kind: step
verb: compare
noun: step
modifier: at_least
context: transform
phrase: compare step at least size {min_step}
phrase: filter step jumps at least {min_step}
slot: min_step int
test: list=10,15,16,22,25 min_step=5
expect: => i=2 r=0.0 ok=true s="kept 2 significant steps" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=2,10,12,30 min_step=8
expect: => i=2 r=0.0 ok=true s="kept 2 significant steps" errors=0 n=2 res=[8,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_step};
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "no steps to compare");
		return out;
	}
	var count = 0;
	for i in 0..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= ms {
			g.res[count] = diff;
			count++;
		}
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " significant steps");
	out
}
@end
