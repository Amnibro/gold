expect: => i=2 r=0.0 ok=true s="dropped max: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drops = ${k};
	if g.n > 0 {
		var mx = g.res[0];
		for i in g.n { if g.res[i] > mx { mx = g.res[i]; } }
		var dst = 0;
		var dropped = 0;
		for i in g.n {
			if g.res[i] == mx && dropped < max_drops {
				dropped++;
			} else {
				g.res[dst] = g.res[i];
				dst++;
			}
		}
		g.n = dst;
		out.i = dropped;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "dropped max: ", out.i);
	out
}
@end
