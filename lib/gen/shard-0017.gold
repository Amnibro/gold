test: list=10,20,30,40,50 target=30
expect: => i=3 r=0.0 ok=true s="prefix found" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25,35 target=99
expect: => i=0 r=0.0 ok=true s="prefix missed" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
		i++;
	}
	if idx >= 0 {
		g.n = idx + 1;
		out.i = g.n;
		out.s.clear();
		format(out.s, "prefix found");
	} else {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "prefix missed");
	}
	g.steps += i + 1;
	out
}
@end
