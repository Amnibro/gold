code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_diff};
	var dst = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			if d <= m {
				var dup = false;
				for j in dst {
					if g.res[j] == d { dup = true; break; }
				}
				if !dup {
					g.res[dst] = d;
					dst++;
				}
			}
		}
	}
	g.n = dst;
	g.steps += dst;
	out.i = dst;
	out.s.clear();
	format(out.s, "unique spaces: ", dst);
	out
}
@end
