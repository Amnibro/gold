code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_sq = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		sum_sq += x * x;
		i++;
	}
	out.s.clear();
	format(out.s, "sum of squares: ", sum_sq);
	out.i = sum_sq;
	g.steps += g.n;
	out
}
@end
