test: list=10,10,10,20,30
expect: => i=3 r=0.0 ok=true s="in-place dedupe: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.s.clear();
		format(out.s, "in-place dedupe: 0");
		out.i = 0;
		return out;
	}
	var m = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[m - 1] {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	out.s.clear();
	format(out.s, "in-place dedupe: ", m);
	out.i = m;
	g.steps += g.n;
	out
}
@end
