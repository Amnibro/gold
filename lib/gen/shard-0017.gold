phrase: count values in range until limit {stop}
slot: stop int
test: list=2,5,8,12,15 stop=10
expect: => i=3 r=0.0 ok=true s="range until 10: 3" errors=0 n=5 res=[2,5,8,12,15] cache=0 hits=0
test: list=1,3,4,6,7 stop=5
expect: => i=3 r=0.0 ok=true s="range until 5: 3" errors=0 n=5 res=[1,3,4,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stop};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= s { break; }
		count++;
		i++;
	}
	out.s.clear();
	format(out.s, "range until ", s, ": ", count);
	out.i = count;
	g.steps += i;
	out
}
@end
