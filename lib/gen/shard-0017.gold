fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1] + b;
		gold_cache_put(g, i, sum);
		pairs++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached pair count: ", pairs);
	out
}
