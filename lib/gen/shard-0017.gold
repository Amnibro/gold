@entry d330d9881c86a7f2
kind: step
verb: cache
noun: histogram
modifier: in_place
context: list
slot: bucket int
phrase: cache histogram in place with bucket {bucket}
phrase: record histogram counts partitioned by {bucket}
test: list=12,18,25,29 bucket=10
expect: => i=4 r=0.0 ok=true s="histogram bins: 4" errors=0 n=4 res=[1,1,2,2] cache=2 hits=2
test: list=5,8,15 bucket=5
expect: => i=3 r=0.0 ok=true s="histogram bins: 3" errors=0 n=3 res=[1,1,3] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b <= 0 {
		gold_fail(g, "invalid bucket");
		out.ok = false;
		return out;
	}
	for i in g.n {
		let key = g.res[i] / b;
		let prev, ok = gold_cache_get(g, key);
		gold_cache_put(g, key, prev + 1);
		g.res[i] = key;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "histogram bins: ", g.n);
	out
}
@end
