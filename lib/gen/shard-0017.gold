	let m = ${mult};
	var total = 0;
	for i in g.n {
		for j in i..g.n {
			total += (g.res[j] - g.res[i]) * m;
		}
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "loop scaled: ", total);
	out
}
@end
