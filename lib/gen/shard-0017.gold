fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		if i >= out.s.len { break; }
		var start = i;
		while i < out.s.len && out.s[i] != ' ' { i++; }
		let wlen = i - start;
		if !${p}(wlen) { break; }
		count++;
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "words matched while");
	out
}
@end
