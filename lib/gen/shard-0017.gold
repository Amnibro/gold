fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= mv {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	// Bubble sort ascending
	for i in kept {
		for j in kept - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted count: ", kept);
	out
}
@end
