@entry da375b736970575a
kind: step
verb: keep
noun: runs
modifier: with_cache
context: aggregate
slot: k int
phrase: keep longest run of identical values caching count under {k}
phrase: cache length of longest identical run under key {k}
test: list=2,3,3,3,4,4 k=1
expect: => i=9 r=0.0 ok=true s="longest run kept total: 9" errors=0 n=3 res=[3,3,3] cache=1 hits=0
test: list=5,5,6,7,7,7,7 k=2
expect: => i=28 r=0.0 ok=true s="longest run kept total: 28" errors=0 n=4 res=[7,7,7,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cache_key = ${k};
	if g.n == 0 { out.ok = false; return out; }
	var best_len = 1;
	var best_start = 0;
	var cur_len = 1;
	var cur_start = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 1;
			cur_start = i;
		}
	}
	let best_val = g.res[best_start];
	for i in best_len {
		g.res[i] = best_val;
	}
	g.n = best_len;
	gold_cache_put(g, cache_key, best_len);
	var total = 0;
	for i in g.n { total += g.res[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "longest run kept total: ", total);
	out
}
@end
