code:
fn ${ID}_sum_digits(n int) int {
	var x = if n < 0 { -n } else { n };
	var s = 0;
	while x > 0 { s += x % 10; x /= 10; }
	s
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = 0;
	for k in g.n {
		if ${ID}_sum_digits(g.res[k]) <= ${limit} {
			found++;
		}
	}
	out.i = found;
	out.s.clear();
	format(out.s, "found ", found);
	out
}
@end
