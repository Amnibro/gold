	if ${n} < 1 {
		gold_fail(g, "retry limit must be positive");
		out.ok = false;
		return out;
	}
	var attempts = 0;
	for i in ${n} {
		attempts++;
		if out.ok {
			break;
		}
		if g.errors > 0 {
			out.ok = true;
		}
	}
	out.i = attempts;
	out.s.clear();
	format(out.s, "retry");
	out
}
@end
