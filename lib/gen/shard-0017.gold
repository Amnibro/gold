phrase: retain leading items while digit count at most {max_digits}
slot: max_digits int
test: list=5,12,34,500,6 max_digits=2
expect: => i=3 r=0.0 ok=true s="kept prefix: 3" errors=0 n=3 res=[5,12,34] cache=0 hits=0
test: list=100,200 max_digits=2
expect: => i=0 r=0.0 ok=true s="kept prefix: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_digits};
	var k = 0;
	while k < g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 { digits = 1; }
		while x > 0 {
			digits++;
			x /= 10;
		}
		if digits > lim {
			break;
		}
		k++;
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "kept prefix: ", k);
	out
}
@end
