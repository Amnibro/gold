code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_idx = 0;
	var min_val = 999999;
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var left = 0;
	var right = min_idx;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += (min_idx + 1);
	out.i = min_idx + 1;
	out.s.clear();
	format(out.s, "reversed prefix of ", min_idx + 1, " items to min");
	out
}
@end
