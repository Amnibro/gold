@entry 716bebefd9e2e96f
kind: step
verb: spin
noun: bridge
modifier: weathered
context: scene
phrase: spin bridge span with weathered styling duration {dur}
phrase: rotate weathered bridge section across {dur} seconds
slot: dur real
test: dur=6.0 doc="bridge box 0,0,0.5 12,2,0.6 m:matte #5c4033"
expect: => i=2 r=0.0 ok=true s="spinbridge" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: bridge box 0,0,0.5 12,2,0.6 m:matte #5c4033
expect: => doc: bridge.rot anim linear 0:0,0,0 6:0,0,360 loop
test: dur=8.0 doc="ground box 0,0,-.5 20,20,1|bridge box 0,0,0.4 10,2,0.5 m:matte #4a3525"
expect: => i=3 r=0.0 ok=true s="spinbridge" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: bridge box 0,0,0.4 10,2,0.5 m:matte #4a3525
expect: => doc: bridge.rot anim linear 0:0,0,0 8:0,0,360 loop
test: dur=0.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last byte[>..] = [];
	if !gold_dlast(g, last) || ${dur} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	o.append(last);
	o.append(".rot anim linear 0:0,");
	o.append("0,0 ");
	gold_fnum(o, ${dur});
	o.append(":0,0,");
	o.append("36");
	o.append("0 loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "spinbridge");
	out
}
@end
