expect: => i=1 r=0.0 ok=true s="split pivot count: 1" errors=0 n=4 res=[1,4,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let piv = ${pivot};
	var low int[256];
	var high int[256];
	var ln = 0;
	var hn = 0;
	for i in g.n {
		if g.res[i] <= piv {
			if ln < 256 { low[ln] = g.res[i]; ln++; }
		} else {
			if hn < 256 { high[hn] = g.res[i]; hn++; }
		}
	}
	for i in ln { g.res[i] = low[i]; }
	for i in hn { g.res[ln + i] = high[i]; }
	g.steps += g.n;
	out.i = ln;
	out.s.clear();
	format(out.s, "split pivot count: ", ln);
	out
}
@end
