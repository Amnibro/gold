phrase: recheck historical sorted sequence safely below {cap}
slot: cap int
test: list=1,5,3,8 cap=10
expect: => i=1 r=0.0 ok=true s="fixed inversions: 1" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
test: list=2,7,4,9,6 cap=8
expect: => i=1 r=0.0 ok=true s="fixed inversions: 1" errors=0 n=5 res=[2,4,7,9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var fixed = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] <= limit && g.res[i + 1] <= limit {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				fixed++;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = fixed;
	out.s.clear();
	format(out.s, "fixed inversions: ", fixed);
	out
}
@end
