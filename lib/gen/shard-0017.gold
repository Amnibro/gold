@entry 159d35ad25f35526
kind: step
verb: search
noun: values
modifier: with_cache
context: retry
phrase: search target value {target} in retry cache
phrase: query cached retry values looking for item {target}
slot: target int
test: list=10,20,30 target=20
expect: => i=1 r=0.0 ok=true s="search cache result: 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25 target=7
expect: => i=-1 r=0.0 ok=false s="search cache result: -1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cv, found = gold_cache_get(g, tgt);
	if found {
		out.i = cv;
		out.ok = true;
	} else {
		var idx = -1;
		for i in g.n {
			if g.res[i] == tgt { idx = i; break; }
		}
		if idx >= 0 {
			gold_cache_put(g, tgt, idx);
			out.i = idx;
			out.ok = true;
		} else {
			out.i = -1;
			out.ok = false;
		}
	}
	out.s.clear();
	format(out.s, "search cache result: ", out.i);
	g.steps += 1;
	out
}
@end
