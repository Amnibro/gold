code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			prime_count++;
		}
	}
	out.i = prime_count;
	out.s.clear();
	format(out.s, "primes found: ", prime_count);
	out
}
@end
@entry 218e4e90a9bd8b68
kind: step
verb: group
noun: duplicates
modifier: each
context: core
phrase: group duplicates each run into value with length
phrase: compress each duplicate run to value with count
test: list=2,2,3,3,3
expect: => i=4 r=0.0 ok=true s="grouped runs: 2" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=7,7
expect: => i=2 r=0.0 ok=true s="grouped runs: 1" errors=0 n=2 res=[7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var packed int[512] = [0; 512];
	var p_len = 0;
	var cur_val = g.res[0];
	var cur_len = 1;
	var runs = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			packed[p_len] = cur_val; p_len++;
			packed[p_len] = cur_len; p_len++;
			runs++;
			cur_val = g.res[i];
			cur_len = 1;
		}
		i++;
	}
	packed[p_len] = cur_val; p_len++;
	packed[p_len] = cur_len; p_len++;
	runs++;
	g.n = 0;
	for k in p_len { gold_push(g, packed[k]); }
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped runs: ", runs);
	out
}
@end
