test: list=10,8
expect: => i=3 r=0.0 ok=true s="filled sorted range of 3 items" errors=0 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty range");
		return out;
	}
	var mn = g.res[0];
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
	}
	let count = mx - mn + 1;
	let lim = if count > 512 { 512 } else { count };
	for i in lim {
		g.res[i] = mn + i;
	}
	g.steps += g.n + lim;
	g.n = lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "filled sorted range of ", lim, " items");
	out
}
@end
