@entry 66e5b7799775f58d
kind: step
verb: drop
noun: condition
modifier: last
context: core
slot: cond pred
phrase: drop condition last element matching {cond}
phrase: remove tail item when satisfying {cond}
test: list=1,2,3,4 cond=is_even
expect: => i=1 r=0.0 ok=true s="dropped tail item" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,3 cond=is_even
expect: => i=0 r=0.0 ok=true s="tail item retained" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	if ${cond}(last_val) {
		g.n--;
		out.i = 1;
		out.s.clear();
		format(out.s, "dropped tail item");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "tail item retained");
	}
	g.steps += 1;
	out
}
@end
