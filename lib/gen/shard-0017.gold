verb: dedupe
noun: steps
modifier: any
context: format
phrase: dedupe steps eliminating any repeating values
phrase: remove duplicate step occurrences across list
test: list=5,5,10,15,10,20
expect: => i=4 r=0.0 ok=true s="deduped steps: 4" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=1,2,2,3,3,4
expect: => i=4 r=0.0 ok=true s="deduped steps: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < m {
			if g.res[j] == g.res[i] { found = true; break; }
			j++;
		}
		if !found {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	out.s.clear();
	format(out.s, "deduped steps: ", m);
	out.i = m;
	g.steps += g.n + m;
	out
}
@end
@entry 2b705b8e2266259d
kind: step
verb: validate
noun: duplicates
modifier: in_reverse
context: format
phrase: validate duplicate occurrences scanned in reverse
phrase: check duplicate pattern moving backwards across list
test: list=1,2,3,3
expect: => i=1 r=0.0 ok=true s="reverse dup: true" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=4,5,6,7
expect: => i=0 r=0.0 ok=false s="reverse dup: false" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dups = false;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i] == g.res[i - 1] {
			has_dups = true;
			break;
		}
		i--;
	}
	out.ok = has_dups;
	out.s.clear();
	format(out.s, "reverse dup: ", has_dups);
	out.i = if has_dups { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
@entry d5997821b60789f6
kind: step
verb: rotate
noun: tally
modifier: unique
context: format
phrase: rotate unique tally counts by offset {shift}
phrase: cycle unique tally values using shift {shift}
slot: shift int
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="tally rotated by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
test: list=5,15,25,35 shift=2
expect: => i=2 r=0.0 ok=true s="tally rotated by 2" errors=0 n=4 res=[25,35,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 0 {
		let k = s % g.n;
		var temp int[512] = [0; 512];
		var i = 0;
		while i < g.n {
			temp[(i + k) % g.n] = g.res[i];
			i++;
		}
		var j = 0;
		while j < g.n {
			g.res[j] = temp[j];
			j++;
		}
	}
	out.s.clear();
	format(out.s, "tally rotated by ", s);
	out.i = s;
	g.steps += g.n;
	out
}
@end
@entry 44d66eeac8ca9b91
kind: step
verb: rank
noun: average
modifier: safely
context: format
phrase: rank elements exceeding average safely
phrase: count items strictly above average value safely
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="above avg 25: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,15,25
