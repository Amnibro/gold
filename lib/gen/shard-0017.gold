fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped results");
	out
}
@end
