noun: pairs
modifier: each
context: filter
slot: min_diff int
phrase: return each pair having difference at least {min_diff}
phrase: filter adjacent pairs exceeding gap {min_diff}
test: list=2,8,10,12,15,25 min_diff=5
expect: => i=2 r=0.0 ok=true s="returned pairs count: 2" errors=0 n=4 res=[2,8,15,25] cache=0 hits=0
test: list=1,3,10,20,30,32 min_diff=8
expect: => i=1 r=0.0 ok=true s="returned pairs count: 1" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_diff};
	var m = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d >= md {
			g.res[m] = g.res[i];
			g.res[m + 1] = g.res[i + 1];
			m += 2;
		}
		i += 2;
	}
	g.n = m;
	g.steps += m;
	out.i = m / 2;
	out.s.clear();
	format(out.s, "returned pairs count: ", m / 2);
	out
}
@end
