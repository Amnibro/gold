code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var buf int[512] = [0; 512];
	var m = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if x > cut {
			buf[m] = x;
			m++;
		}
		i--;
	}
	var j = 0;
	while j < m {
		g.res[j] = buf[j];
		j++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "loop validated in reverse");
	out
}
@end
