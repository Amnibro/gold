fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end_val};
	let st = if s < 0 { 0 } else { s };
	let en = if e >= g.n { g.n - 1 } else { e };
	var sum = 0;
	if st <= en && g.n > 0 {
		for i in st..(en + 1) { sum += g.res[i]; }
	}
	gold_cache_put(g, st * 100 + en, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "cached range sum: ", sum);
	g.steps += 1;
	out
}
@end
