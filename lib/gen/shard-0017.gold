@entry 5ff1328890ddff0b
kind: step
verb: rank
noun: vowels
modifier: sorted
context: format
phrase: rank vowel counts in sorted alphabetical order
phrase: count vowels rendered in alphabetical sequence
test: text="education"
expect: => i=5 r=0.0 ok=true s="a:1 e:1 i:1 o:1 u:1" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world"
expect: => i=3 r=0.0 ok=true s="a:0 e:1 i:0 o:2 u:0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ca = 0;
	var ce = 0;
	var ci = 0;
	var co = 0;
	var cu = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'A' { ca++; }
		else if b == 'e' || b == 'E' { ce++; }
		else if b == 'i' || b == 'I' { ci++; }
		else if b == 'o' || b == 'O' { co++; }
		else if b == 'u' || b == 'U' { cu++; }
		i++;
	}
	let tot = ca + ce + ci + co + cu;
	out.s.clear();
	format(out.s, "a:", ca, " e:", ce, " i:", ci, " o:", co, " u:", cu);
	out.i = tot;
	g.steps += out.s.len;
	out
}
@end
