test: list=4,4,5,5,6
expect: => i=4 r=0.0 ok=true s="swapped first runs count: 4" errors=0 n=5 res=[5,5,4,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var len1 = 1;
	while len1 < g.n && g.res[len1] == g.res[0] { len1++; }
	if len1 >= g.n { return out; }
	var len2 = 1;
	while (len1 + len2) < g.n && g.res[len1 + len2] == g.res[len1] { len2++; }
	var tmp_arr int[512] = [0; 512];
	for k in (len1 + len2) { tmp_arr[k] = g.res[k]; }
	for k in len2 { g.res[k] = tmp_arr[len1 + k]; }
	for k in len1 { g.res[len2 + k] = tmp_arr[k]; }
	g.steps += (len1 + len2);
	out.i = len1 + len2;
	out.s.clear();
	format(out.s, "swapped first runs count: ", len1 + len2);
	out
}
@end
