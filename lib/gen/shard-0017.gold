@entry 581abe4f03802978
kind: step
verb: sort
noun: head
modifier: between
context: filter
slot: low int
slot: high int
phrase: sort head between range {low} through {high}
phrase: filter sort head between bounds {low} with {high}
test: list=5,12,3,8,20,15 low=5 high=15
expect: => i=4 r=0.0 ok=true s="head sorted" errors=0 n=4 res=[5,8,12,15] cache=0 hits=0
test: list=30,10,25,5 low=8 high=26
expect: => i=2 r=0.0 ok=true s="head sorted" errors=0 n=2 res=[10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	var p = 0;
	while p < g.n {
		var q = p + 1;
		while q < g.n {
			if g.res[p] > g.res[q] {
				let tmp = g.res[p];
				g.res[p] = g.res[q];
				g.res[q] = tmp;
			}
			q++;
		}
		p++;
	}
	g.steps += g.n * g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "head sorted");
	out
}
@end
