@entry 77d791a068c1c7ab
kind: step
verb: group
noun: histogram
modifier: nested
context: core
phrase: group histogram nested within bucket size {bucket}
phrase: partition nested histogram using bucket interval {bucket}
slot: bucket int
test: list=2,3,7,8,12 bucket=5
expect: => i=3 r=0.0 ok=true s="bins: 3" errors=0 n=3 res=[2,2,1] cache=0 hits=0
test: list=1,2,3,10 bucket=5
expect: => i=3 r=0.0 ok=true s="bins: 3" errors=0 n=3 res=[3,0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 || ${bucket} <= 0 { out.i = 0; return out; }
	var max_val = g.res[0];
	for k in g.n { if g.res[k] > max_val { max_val = g.res[k]; } }
	let num_bins = (max_val / ${bucket}) + 1;
	var bins int[512] = [0; 512];
	for k in g.n {
		let b = g.res[k] / ${bucket};
		if b >= 0 && b < 512 { bins[b]++; }
	}
	g.n = 0;
	for b in num_bins {
		gold_push(g, bins[b]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "bins: ", g.n);
	out
}
@end
