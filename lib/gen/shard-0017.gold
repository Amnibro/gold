code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] && j + 1 < g.n {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped duplicates recursively ", swaps, " times");
	out
}
@end
@entry 157a444fdd2c7b13
kind: step
verb: scan
noun: histogram
modifier: each
context: list
phrase: scan histogram frequencies for each unique value
phrase: compute frequency histogram for each distinct item
test: list=5,5,9
expect: => i=2 r=0.0 ok=true s="scanned histogram for 2 items" errors=0 n=4 res=[5,2,9,1] cache=0 hits=0
test: list=7,8,7
expect: => i=2 r=0.0 ok=true s="scanned histogram for 2 items" errors=0 n=4 res=[7,2,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hist int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count {
			if hist[j * 2] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for k in g.n {
				if g.res[k] == x { freq++; }
			}
			hist[count * 2] = x;
			hist[count * 2 + 1] = freq;
			count++;
		}
	}
	let total_len = count * 2;
	for k in total_len { g.res[k] = hist[k]; }
	g.n = total_len;
	g.steps += total_len;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned histogram for ", count, " items");
	out
}
@end
