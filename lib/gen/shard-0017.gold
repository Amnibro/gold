code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let maxv = ${maxval};
	var m = 0;
	let half = g.n / 2;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if i >= half {
			if x <= maxv {
				g.res[m] = x;
				m++;
			}
		} else {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "tail validated up to");
	out
}
@end
