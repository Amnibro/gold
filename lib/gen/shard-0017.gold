		suffix_acc = suffix_acc * 10 + d;
		val /= 10;
	}
	suffix_acc
}
@end
@entry ddfbe01b30adf96e
kind: fn
verb: rank
noun: runs
modifier: in_place
context: compare
phrase: rank runs in place by maximum length
phrase: determine longest consecutive identical run rank
test: arg=11122,1234
expect: 3
expect: 1
test: arg=5555,7
expect: 4
expect: 1
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val == 0 { return 1; }
	var max_len = 0;
	var cur_run = 0;
	var last_digit = -1;
	while val > 0 {
		let cur = val % 10;
		if cur == last_digit {
			cur_run++;
		} else {
			last_digit = cur;
			cur_run = 1;
		}
		if cur_run > max_len { max_len = cur_run; }
		val /= 10;
	}
	max_len
}
@end
