kind: step
verb: measure
noun: duplicates
modifier: between
context: aggregate
slot: lo int
slot: hi int
phrase: measure duplicate elements from index {lo} to {hi}
phrase: count duplicate items from position {lo} to {hi}
test: list=2,4,2,6,4,8 lo=0 hi=5
expect: => i=2 r=0.0 ok=true s="duplicate items measured: 2" errors=0 n=6 res=[2,4,2,6,4,8] cache=0 hits=0
test: list=5,6,7,8 lo=0 hi=4
expect: => i=0 r=0.0 ok=true s="duplicate items measured: 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = max(0, ${lo});
	let finish = min(${hi}, g.n);
	var duplicates = 0;
	var i = start;
	while i < finish {
		let x = g.res[i];
		var seen = false;
		var j = start;
		while j < i {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if seen { duplicates++; }
		i++;
	}
	g.steps += (finish - start);
	out.i = duplicates;
	out.s.clear();
	format(out.s, "duplicate items measured: ", duplicates);
	out
}
@end
@entry d035eb98f99ebbe9
kind: step
verb: map
noun: gaps
modifier: while
context: aggregate
slot: bound int
slot: mul int
phrase: map adjacent gaps while differences stay under {bound}
phrase: transform consecutive gaps while difference below {bound}
test: list=2,5,9,20 bound=5 mul=2
expect: => i=14 r=0.0 ok=true s="mapped gaps sum while bounded: 14" errors=0 n=4 res=[2,5,9,20] cache=0 hits=0
test: list=10,14,18,30 bound=5 mul=3
expect: => i=24 r=0.0 ok=true s="mapped gaps sum while bounded: 24" errors=0 n=4 res=[10,14,18,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${bound};
	let factor = ${mul};
	var total = 0;
	var i = 0;
	while (i + 1) < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if gap < max_gap {
			total += gap * factor;
		} else {
			break;
		}
		i++;
	}
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped gaps sum while bounded: ", total);
	out
}
@end
