@entry d7fcff0cda1fcc68
kind: step
verb: dedupe
noun: digits
modifier: every_other
context: cache
phrase: dedupe alternate digits to cache
phrase: filter every other digit entry into cache
test: list=12,23,34
expect: => i=2 r=0.0 ok=true s="deduped alternate digits" errors=0 n=3 res=[12,23,34] cache=2 hits=0
test: list=10,20
expect: => i=1 r=0.0 ok=true s="deduped alternate digits" errors=0 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if i % 2 == 0 {
			gold_cache_put(g, i, g.res[i]);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "deduped alternate digits");
	out
}
@end
@entry 76c57542102c1f19
kind: step
verb: repeat
noun: gaps
modifier: recursively
context: cache
phrase: repeat gap calculation recursively to depth {depth}
phrase: recurse gap intervals to cache depth {depth}
slot: depth int
test: list=2,6,14 depth=2
expect: => i=4 r=0.0 ok=true s="repeated gaps recursively" errors=0 n=3 res=[2,6,14] cache=4 hits=0
test: list=1,4,10 depth=3
expect: => i=6 r=0.0 ok=true s="repeated gaps recursively" errors=0 n=3 res=[1,4,10] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var count = 0;
	for step in d {
		var i = 1;
		while i < g.n {
			let diff = (g.res[i] - g.res[i - 1]) * (step + 1);
			gold_cache_put(g, count, diff);
			count++;
			i++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "repeated gaps recursively");
	out
}
@end
