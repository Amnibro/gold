context: error
phrase: fill error gaps in reverse order
phrase: compute error gaps in reverse order
test: arg=142,555
expect: 5
expect: 0
test: arg=15
expect: 4
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val < 10 {
		return 0;
	}
	var sum_gaps = 0;
	var prev = val % 10;
	val = val / 10;
	while val > 0 {
		var curr = val % 10;
		var diff = curr - prev;
		if diff < 0 {
			diff = -diff;
		}
		sum_gaps = sum_gaps + diff;
		prev = curr;
		val = val / 10;
	}
	return sum_gaps;
}
@end
