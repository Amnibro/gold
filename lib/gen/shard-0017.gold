code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var dsum = 0;
		var tmp = if x < 0 { -x } else { x };
		while tmp > 0 {
			dsum += tmp % 10;
			tmp /= 10;
		}
		if dsum <= ms {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += m * 2;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered digits up to: ", m);
	out
}
@end
