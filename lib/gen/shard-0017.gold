@entry 07aee4b830380607
kind: step
verb: keep
noun: duplicates
modifier: up_to
context: sort
phrase: keep duplicates up to limit {max_dup}
phrase: retain duplicate values up to count {max_dup}
slot: max_dup int
test: list=1,1,1,2,2,3 max_dup=2
expect: => i=5 r=0.0 ok=true s="kept duplicates: 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,4,4,4,5,5 max_dup=1
expect: => i=2 r=0.0 ok=true s="kept duplicates: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_dup};
	if g.n == 0 { return out; }
	var w = 0;
	var r = 0;
	while r < g.n {
		let val = g.res[r];
		var run_len = 0;
		while r < g.n && g.res[r] == val {
			if run_len < limit {
				g.res[w] = val;
				w++;
			}
			run_len++;
			r++;
		}
	}
	g.n = w;
	g.steps += r;
	out.i = w;
	out.s.clear();
	format(out.s, "kept duplicates: ", w);
	out
}
@end
