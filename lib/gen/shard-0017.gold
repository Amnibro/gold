@entry fe04c3517e8e033b
kind: step
verb: group
noun: loop
modifier: times
context: core
slot: rounds int
phrase: group loop times repeating cycles {rounds}
phrase: combine loop items through {rounds} iterations
test: list=1,2,3,4 rounds=1
expect: => i=2 r=0.0 ok=true s="grouped loop size: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,1,1,1 rounds=2
expect: => i=1 r=0.0 ok=true s="grouped loop size: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var cycle = 0;
	while cycle < r && g.n > 1 {
		let half = g.n / 2;
		for i in half {
			g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
		}
		g.n = half;
		cycle++;
	}
	g.steps += cycle * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped loop size: ", g.n);
	out
}
@end
