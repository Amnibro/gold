phrase: exchange squared values from index {idx_a} to {idx_b}
test: list=2,3,4 idx_a=0 idx_b=2
expect: => i=20 r=0.0 ok=true s="swapped squared elements sum: 20" errors=0 n=3 res=[16,3,4] cache=0 hits=0
test: list=5,1,2 idx_a=1 idx_b=2
expect: => i=5 r=0.0 ok=true s="swapped squared elements sum: 5" errors=0 n=3 res=[5,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let a = ${idx_a};
	let b = ${idx_b};
	if a >= g.n || b >= g.n {
		out.ok = false;
		return out;
	}
	let sq_a = g.res[a] * g.res[a];
	let sq_b = g.res[b] * g.res[b];
	g.res[a] = sq_b;
	g.res[b] = sq_a;
	let total = sq_a + sq_b;
	g.steps += 2;
	out.i = total;
	out.s.clear();
	format(out.s, "swapped squared elements sum: ", total);
	out
}
@end
