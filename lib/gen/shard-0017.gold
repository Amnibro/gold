expect: => i=2 r=0.0 ok=true s="shifted count: 2" errors=0 n=4 res=[4,6,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < g.n && ${p}(g.res[0]) {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted count: ", count);
	out
}
@end
