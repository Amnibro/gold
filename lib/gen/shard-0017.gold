code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var u_buf int[512] = [0; 512];
	var u_count = 0;
	var u_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_count {
			if u_buf[j] == x { seen = true; break; }
		}
		if !seen {
			u_buf[u_count] = x;
			u_count++;
			u_sum += x;
		}
	}
	let avg = u_sum / u_count;
	var kept = 0;
	for i in u_count {
		if u_buf[i] >= avg {
			g.res[kept] = u_buf[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + u_count;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " unique items above average");
	out
}
@end
