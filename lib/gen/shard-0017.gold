expect: => i=3 r=0.0 ok=true s="interior unique count: 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { out.i = g.n; return out; }
	var kept int[512] = [0; 512];
	kept[0] = g.res[0];
	var k_len = 1;
	var i = 1;
	while i + 1 < g.n {
		let val = g.res[i];
		var dup = false;
		var j = 1;
		while j < k_len {
			if kept[j] == val { dup = true; break; }
			j++;
		}
		if !dup {
			kept[k_len] = val;
			k_len++;
		}
		i++;
	}
	kept[k_len] = g.res[g.n - 1];
	k_len++;
	g.n = 0;
	for k in k_len { gold_push(g, kept[k]); }
	out.i = k_len;
	out.s.clear();
	format(out.s, "interior unique count: ", k_len);
	out
}
@end
