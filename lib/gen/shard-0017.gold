noun: window
modifier: each
context: list
slot: win_size int
phrase: fill window each of length {win_size}
phrase: compute rolling window sums with span {win_size}
test: list=1,2,3,4,5 win_size=2
expect: => i=4 r=0.0 ok=true s="windows: 4" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30 win_size=3
expect: => i=1 r=0.0 ok=true s="windows: 1" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window");
		out.ok = false;
		return out;
	}
	let num_windows = g.n - w + 1;
	for i in num_windows {
		var sum = 0;
		for k in w { sum += g.res[i + k]; }
		g.res[i] = sum;
	}
	g.n = num_windows;
	g.steps += num_windows;
	out.i = num_windows;
	out.s.clear();
	format(out.s, "windows: ", num_windows);
	out
}
@end
@entry 2a9977aa51b5e9df
kind: step
verb: collect
noun: runs
modifier: with_cache
context: list
slot: min_run int
phrase: collect runs with cache above length {min_run}
phrase: gather repeated runs exceeding {min_run}
test: list=2,2,2,3,4,4,4,4 min_run=3
expect: => i=2 r=0.0 ok=true s="runs collected: 2" errors=0 n=2 res=[2,4] cache=2 hits=0
test: list=5,5,9,8 min_run=2
expect: => i=1 r=0.0 ok=true s="runs collected: 1" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_run};
	var dst = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= m {
			gold_cache_put(g, g.res[i], run_len);
			g.res[dst] = g.res[i];
			dst++;
		}
		i = j;
	}
	g.n = dst;
	g.steps += dst;
	out.i = dst;
	out.s.clear();
	format(out.s, "runs collected: ", dst);
	out
}
@end
