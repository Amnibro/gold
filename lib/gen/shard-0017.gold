@entry 89383908d1645411
kind: step
verb: drop
noun: primes
modifier: with_retry
context: loop
phrase: drop primes with_retry budget of {retries} removals
phrase: remove prime elements allowing up to {retries} attempts
slot: retries int
test: list=2,3,4,5,6 retries=2
expect: => i=2 r=0.0 ok=true s="primes dropped with retry" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=7,11,13 retries=1
expect: => i=1 r=0.0 ok=true s="primes dropped with retry" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${retries};
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p && dropped < limit {
			dropped++;
		} else {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "primes dropped with retry");
	out
}
@end
