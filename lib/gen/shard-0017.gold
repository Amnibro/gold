slot: expected int
test: list=10,20,30 expected=60
expect: => i=60 r=0.0 ok=true s="checked tally in place: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 expected=50
expect: => i=20 r=0.0 ok=false s="checked tally in place: 20" errors=1 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let matches = (sum == exp);
	out.ok = matches;
	out.i = sum;
	if !matches {
		gold_fail(g, "tally mismatch");
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "checked tally in place: ", sum);
	out
}
@end
