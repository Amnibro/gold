test: list=4,4,4,5,5 max_len=1
expect: => i=0 r=0.0 ok=true s="streak count: 0" errors=0 n=5 res=[4,4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var matched = 0;
	var i = 0;
	while i < g.n {
		var run = 1;
		while i + run < g.n && g.res[i + run] == g.res[i] {
			run++;
		}
		if run <= limit {
			matched += run;
		}
		i += run;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "streak count: ", matched);
	out
}
@end
