fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == val { seen_before = true; break; }
			j += 2;
		}
		if seen_before { dups++; }
		i += 2;
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found ", dups, " alternate duplicates");
	out
}
@end
