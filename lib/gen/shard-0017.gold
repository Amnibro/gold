@entry 83b445fd026f5da0
kind: fn
verb: scan
noun: list
modifier: while
context: stats
phrase: scan list while elements under {limit}
phrase: sum list numbers while below {limit}
slot: limit int
test: arg=123,456 limit=4
expect: 6
expect: 0
test: arg=12,23 limit=3
expect: 3
expect: 0
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var total = 0;
	while x > 0 {
		let d = x % 10;
		if d >= lim { break; }
		total += d;
		x /= 10;
	}
	total
}
@end
@entry 367edf569bf04074
kind: pred
verb: check
noun: total
modifier: recursively
context: stats
phrase: check recursive digital root matches {root}
phrase: verify recursive total reaches single digit {root}
slot: root int
test: arg=39,45 root=3
expect: true
expect: false
test: arg=100,99 root=9
expect: false
expect: true
code:
fn ${ID}(n int) bool {
	let target = ${root};
	var x = if n < 0 { -n } else { n };
	while x >= 10 {
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		x = s;
	}
	x == target
}
@end
