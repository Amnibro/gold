fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let start = if g.n > sp { g.n - sp } else { 0 };
	var valid = true;
	var i = start;
	while i + 1 < g.n {
		if g.res[i + 1] <= g.res[i] {
			valid = false;
		}
		i++;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "validated last spaces: ", out.i);
	out
}
@end
