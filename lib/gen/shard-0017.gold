kind: step
verb: drop
noun: checkpoint
modifier: times
context: transform
phrase: drop checkpoint {cp} exactly {k} times
phrase: remove checkpoint value {cp} up to {k} occurrences
slot: cp int
slot: k int
test: list=9,5,9,9,2 cp=9 k=2
expect: => i=2 r=0.0 ok=true s="dropped checkpoint 2 times" errors=0 n=3 res=[5,9,2] cache=0 hits=0
test: list=3,3,3,3 cp=3 k=1
expect: => i=1 r=0.0 ok=true s="dropped checkpoint 1 times" errors=0 n=3 res=[3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let check = ${cp};
	let limit = ${k};
	var dropped = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] == check && dropped < limit {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped checkpoint ", dropped, " times");
	out
}
@end
@entry 9f1d4af080a13f65
kind: step
verb: compare
noun: total
modifier: in_reverse
context: transform
phrase: compare total in reverse order
phrase: compute difference from total backwards
test: list=1,2,3
expect: => i=6 r=0.0 ok=true s="compared reverse with total 6" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20
expect: => i=30 r=0.0 ok=true s="compared reverse with total 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	var new_res int[512] = [0; 512];
	for i in g.n {
		let rev_idx = g.n - 1 - i;
		new_res[i] = total - g.res[rev_idx];
	}
	for i in g.n {
		g.res[i] = new_res[i];
	}
	g.steps += g.n * 2;
	out.i = total;
	out.s.clear();
	format(out.s, "compared reverse with total ", total);
	out
}
@end
