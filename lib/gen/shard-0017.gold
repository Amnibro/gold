	let exp = ${expected};
	var pos = 0;
	for i in g.n {
		if g.res[i] > 0 { pos++; }
	}
	g.steps += g.n;
	out.i = pos;
	out.ok = (pos == exp);
	out.s.clear();
	if pos == exp {
		format(out.s, "counter matched: ", pos);
	} else {
		gold_fail(g, "counter mismatch");
		format(out.s, "counter differed: ", pos);
	}
	out
}
