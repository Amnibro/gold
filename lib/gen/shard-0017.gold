	let max_val = ${cap};
	var total = 0;
	for i in g.n {
		if g.res[i] <= max_val {
			total += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "merged values at most cap: ", total);
	out
}
@end
