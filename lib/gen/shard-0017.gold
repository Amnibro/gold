code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > lim { break; }
		gaps[count] = diff;
		count++;
		i++;
	}
	for k in count { g.res[k] = gaps[k]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned ", count, " gaps");
	out
}
@end
