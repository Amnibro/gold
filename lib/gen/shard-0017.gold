test: list=10,20,30 target_avg=20
expect: => i=20 r=0.0 ok=true s="retried average first found 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=2,4,6 target_avg=10
expect: => i=2 r=0.0 ok=false s="retried average first found 2" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_avg};
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		return out;
	}
	var count = g.n;
	var found = false;
	var avg = 0;
	while count > 0 {
		var sum = 0;
		for i in count { sum += g.res[i]; }
		avg = sum / count;
		if avg >= tgt {
			found = true;
			break;
		}
		count--;
	}
	g.steps += g.n;
	out.i = avg;
	out.ok = found;
	out.s.clear();
	format(out.s, "retried average first found ", avg);
	out
}
@end
