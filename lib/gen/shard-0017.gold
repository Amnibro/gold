expect: => i=4 r=0.0 ok=true s="limited streak to 4 items" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
test: list=1,1,1,2,2,2,2,3 max_streak=1
expect: => i=3 r=0.0 ok=true s="limited streak to 3 items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${max_streak};
	if max_s <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "cleared list");
		return out;
	}
	var count = 0;
	var cur_streak = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			cur_streak = 1;
			g.res[count] = g.res[i];
			count++;
		} else {
			if cur_streak < max_s {
				cur_streak++;
				g.res[count] = g.res[i];
				count++;
			}
		}
		i++;
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited streak to ", count, " items");
	out
}
@end
