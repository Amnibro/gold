fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	let start = g.n / 2;
	var clamped = 0;
	var i = start;
	while i < g.n {
		if g.res[i] > mv {
			g.res[i] = mv;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "normalized tail up_to");
	out
}
