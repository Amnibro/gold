code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cutoff};
	var sum_val = 0;
	var count = 0;
	for i in g.n {
		if sum_val + g.res[i] > lim { break; }
		sum_val += g.res[i];
		count++;
	}
	let avg = if count > 0 { sum_val / count } else { 0 };
	g.steps += count;
	out.i = avg;
	out.s.clear();
	format(out.s, "average until cutoff: ", avg);
	out
}
@end
