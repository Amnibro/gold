fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let split = ${mid};
	if split > 0 && split < g.n {
		for i in 0..g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged in place");
