@entry 6955ec1fa1e9ee4d
kind: step
verb: swap
noun: average
modifier: all
context: list
phrase: swap elements around average across all entries
phrase: exchange values above average across all items
test: list=10,2,30,4
expect: => i=1 r=0.0 ok=true s="swapped around average 1 times" errors=0 n=4 res=[10,2,4,30] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="swapped around average 0 times" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var swaps = 0;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		if g.res[left] > avg && g.res[right] <= avg {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			swaps++;
			left++;
			right--;
		} else {
			if g.res[left] <= avg { left++; }
			if g.res[right] > avg { right--; }
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped around average ", swaps, " times");
	out
}
@end
