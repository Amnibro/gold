@entry 597b6f4f06e331cf
kind: step
verb: merge
noun: values
modifier: up_to
context: list
phrase: merge adjacent values up to maximum {threshold}
phrase: condense pairwise values up to sum {threshold}
slot: threshold int
test: list=2,3,8,9 threshold=6
expect: => i=3 r=0.0 ok=true s="merged values up to threshold" errors=0 n=3 res=[5,8,9] cache=0 hits=0
test: list=1,2,3,4 threshold=10
expect: => i=2 r=0.0 ok=true s="merged values up to threshold" errors=0 n=2 res=[3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var new_res int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] + g.res[i + 1] <= limit {
			new_res[count] = g.res[i] + g.res[i + 1];
			count++;
			i += 2;
		} else {
			new_res[count] = g.res[i];
			count++;
			i++;
		}
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged values up to threshold");
	out
}
@end
