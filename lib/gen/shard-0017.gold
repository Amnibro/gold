@entry 64773c6b1e55636d
kind: step
verb: find
noun: window
modifier: nested
context: core
slot: win_size int
phrase: find window nested with span size {win_size}
phrase: locate best nested window of width {win_size}
test: list=1,5,2,8,3 win_size=2
expect: => i=11 r=0.0 ok=true s="max window sum: 11" errors=0 n=5 res=[1,5,2,8,3] cache=0 hits=0
test: list=10,2,3,4 win_size=3
expect: => i=15 r=0.0 ok=true s="max window sum: 15" errors=0 n=4 res=[10,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var max_sum = 0;
	for i in w { max_sum += g.res[i]; }
	var best_idx = 0;
	var cur_sum = max_sum;
	var i = 1;
	while i + w <= g.n {
		cur_sum = cur_sum - g.res[i - 1] + g.res[i + w - 1];
		if cur_sum > max_sum {
			max_sum = cur_sum;
			best_idx = i;
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "max window sum: ", max_sum);
	out
}
@end
