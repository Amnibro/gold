@entry 0e14a800f390510c
kind: step
verb: normalize
noun: range
modifier: nested
context: core
slot: target int
phrase: normalize range nested within target span {target}
phrase: scale nested values to range bound {target}
test: list=10,20,30 target=100
expect: => i=100 r=0.0 ok=true s="range normalized to: 100" errors=0 n=3 res=[0,50,100] cache=0 hits=0
test: list=5,15 target=50
expect: => i=50 r=0.0 ok=true s="range normalized to: 50" errors=0 n=2 res=[0,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${target};
	if g.n == 0 { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	for i in g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
	}
	let diff = mx - mn;
	for i in g.n {
		let norm = if diff > 0 { ((g.res[i] - mn) * span) / diff } else { 0 };
		g.res[i] = norm;
	}
	g.steps += g.n * 2;
	out.i = span;
	out.s.clear();
	format(out.s, "range normalized to: ", span);
	out
}
@end
