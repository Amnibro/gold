noun: average
modifier: none
context: stats
phrase: count average none exceeding mean
phrase: tally observations above mean value
test: list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="items above mean: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,5,5,15,20
expect: => i=2 r=0.0 ok=true s="items above mean: 2" errors=0 n=5 res=[5,5,5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.s.clear();
		format(out.s, "empty dataset");
		return out;
	}
	var sum_val = 0;
	for i in g.n { sum_val += g.res[i]; }
	let avg = sum_val / g.n;
	var count = 0;
	for i in g.n {
		if g.res[i] > avg { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "items above mean: ", count);
	out
}
@end
@entry 7618473eb4f6c9a3
kind: step
verb: count
noun: histogram
modifier: with_cache
context: stats
phrase: count histogram with cache frequencies
phrase: tally frequency distribution into cache
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="cached histogram of 3 bins" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=0
test: list=10,10,20,30,30,30
expect: => i=3 r=0.0 ok=true s="cached histogram of 3 bins" errors=0 n=6 res=[10,10,20,30,30,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for k in g.n { if g.res[k] == x { freq++; } }
			gold_cache_put(g, x, freq);
			distinct++;
		}
	}
	g.steps += distinct;
	out.i = distinct;
	out.s.clear();
	format(out.s, "cached histogram of ", distinct, " bins");
	out
}
@end
