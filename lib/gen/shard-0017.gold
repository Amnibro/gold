code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var running = 0;
	var count = 0;
	var i = 0;
	while i < g.n && i < d {
		running += g.res[i];
		gold_cache_put(g, i, running);
		count++;
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached prefix recursively");
	out
}
@end
