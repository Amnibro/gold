@entry 4274437d2e82bfac
kind: fn
verb: scale
noun: primes
modifier: sorted
context: loop
slot: factor int
phrase: scale primes sorted by multiplier {factor}
phrase: sum prime factors sorted with scale {factor}
test: arg=12,15 factor=2
expect: 14
expect: 16
test: arg=7,14 factor=3
expect: 21
expect: 27
code:
fn ${ID}(n int) int {
	let mult = ${factor};
	var x = if n < 0 { -n } else { n };
	var factor_sum = 0;
	var d = 2;
	while d * d <= x {
		while x % d == 0 {
			factor_sum += d;
			x /= d;
		}
		d++;
	}
	if x > 1 { factor_sum += x; }
	factor_sum * mult
}
@end
