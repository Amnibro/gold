@entry d5602c1a97d0f89a
kind: step
verb: check
noun: step
modifier: pairwise
context: aggregate
slot: tol int
phrase: check step pairwise differences exceeding tolerance {tol}
phrase: verify pairwise step differences within tolerance {tol}
test: list=2,5,7,10 tol=3
expect: => i=1 r=0.0 ok=true s="pairwise steps verified" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=2,8,9,11 tol=3
expect: => i=0 r=0.0 ok=true s="pairwise step exceeded tolerance" errors=0 n=4 res=[2,8,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tol};
	var ok_steps = 1;
	var i = 1;
	while i < g.n {
		let diff = abs(g.res[i] - g.res[i - 1]);
		if diff > tol {
			ok_steps = 0;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.i = ok_steps;
	out.s.clear();
	if ok_steps == 1 {
		format(out.s, "pairwise steps verified");
	} else {
		format(out.s, "pairwise step exceeded tolerance");
	}
	out
}
@end
@entry c9def30e567b8365
kind: step
verb: scan
noun: errors
modifier: with_retry
context: aggregate
slot: limit int
phrase: scan errors with retry budget {limit}
phrase: aggregate scan checking errors with retry count {limit}
test: list=10,-2,30 limit=2
expect: => i=40 r=0.0 ok=true s="scanned with valid errors count: 1" errors=0 n=3 res=[10,-2,30] cache=0 hits=0
test: list=5,-1,-2,-3 limit=1
expect: => i=5 r=0.0 ok=false s="retry limit exceeded on negative elements" errors=1 n=4 res=[5,-1,-2,-3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var errs = 0;
	var valid_sum = 0;
	for i in g.n {
		if g.res[i] < 0 {
			errs++;
		} else {
			valid_sum += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = valid_sum;
	out.s.clear();
	if errs > lim {
		gold_fail(g, "too many errors");
		out.ok = false;
		format(out.s, "retry limit exceeded on negative elements");
	} else {
		format(out.s, "scanned with valid errors count: ", errs);
	}
	out
}
@end
@entry 6e87084630c00697
kind: step
verb: pair
noun: minimum
modifier: up_to
context: aggregate
slot: idx int
phrase: pair adjacent elements computing minimum up to index {idx}
phrase: aggregate adjacent pairs finding minimum up to {idx}
test: list=10,5,8,2 idx=2
expect: => i=10 r=0.0 ok=true s="minimum pair sum up to index: 10" errors=0 n=4 res=[10,5,8,2] cache=0 hits=0
test: list=3,9,1,4 idx=2
expect: => i=5 r=0.0 ok=true s="minimum pair sum up to index: 5" errors=0 n=4 res=[3,9,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_idx = ${idx};
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var min_pair = 2147483647;
	var i = 0;
	while i <= limit_idx && (i + 1) < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum < min_pair { min_pair = pair_sum; }
		i++;
	}
	g.steps += i;
	out.i = min_pair;
	out.s.clear();
	format(out.s, "minimum pair sum up to index: ", min_pair);
	out
}
@end
