code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let minVal = ${minimum};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum < minVal {
		let diff = minVal - sum;
		gold_push(g, diff);
		sum += diff;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "joined total sum: ", sum);
	g.steps += g.n;
	out
}
@end
