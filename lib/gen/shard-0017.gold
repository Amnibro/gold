fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key1 = ${k1};
	let key2 = ${k2};
	if g.n >= 2 {
		gold_cache_put(g, key1, g.res[0]);
		gold_cache_put(g, key2, g.res[1]);
	}
	let v1, f1 = gold_cache_get(g, key1);
	let v2, f2 = gold_cache_get(g, key2);
	if f1 && f2 {
		gold_cache_put(g, key1, v2);
		gold_cache_put(g, key2, v1);
	}
	g.steps += 4;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cache swapped");
	out
}
@end
