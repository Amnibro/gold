fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list");
		return out;
	}
	var count = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] && ${p}(g.res[i]) {
			continue;
		}
		g.res[count] = g.res[i];
		count++;
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited duplicates to ", count, " items");
	out
}
