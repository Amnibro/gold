code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if s > 1 {
		var m = 0;
		var i = 0;
		while i < g.n {
			g.res[m] = g.res[i];
			m++;
			i += s;
		}
		g.n = m;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced sequence recursively count: ", g.n);
	out
}
@end
