fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let start = g.n / 2;
	for i in start..g.n {
		if g.res[i] > b { g.res[i] = b; }
	}
	for i in start..g.n {
		var j = i;
		while j > start && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "clamped suffix items: ", out.i);
	g.steps += g.n;
	out
}
@end
