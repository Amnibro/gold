noun: average
modifier: times
context: transform
phrase: group average times window {k}
phrase: compute mean over groups of {k}
slot: k int
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="grouped 2 window averages" errors=0 n=2 res=[15,35] cache=0 hits=0
test: list=3,6,9,12,15,18 k=3
expect: => i=2 r=0.0 ok=true s="grouped 2 window averages" errors=0 n=2 res=[6,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${k};
	if win <= 0 {
		gold_fail(g, "invalid group window");
		out.ok = false;
		return out;
	}
	var count = 0;
	var i = 0;
	while i + win <= g.n {
		var sum = 0;
		for j in win {
			sum += g.res[i + j];
		}
		g.res[count] = sum / win;
		count++;
		i += win;
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped ", count, " window averages");
	out
}
@end
