kind: step
verb: sum
noun: step
modifier: pairwise
context: loop
phrase: sum step pairwise adjacent item pairs
phrase: calculate pairwise sums across consecutive steps
test: list=1,2,4,8
expect: => i=21 r=0.0 ok=true s="pairwise step sum" errors=0 n=3 res=[3,6,12] cache=0 hits=0
test: list=10,20,30
expect: => i=80 r=0.0 ok=true s="pairwise step sum" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var total = 0;
	var new_n = g.n - 1;
	for i in new_n {
		let psum = g.res[i] + g.res[i + 1];
		g.res[i] = psum;
		total += psum;
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = total;
	out.s.clear();
	format(out.s, "pairwise step sum");
	out
}
@end
