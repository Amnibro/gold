noun: errors
modifier: last
context: list
phrase: reverse last items handling errors
phrase: invert order of last elements on error
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="reversed list with last errors handled" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed list with last errors handled" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var i = 0;
	while i < n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[n - 1 - i];
		g.res[n - 1 - i] = tmp;
		i++;
	}
	if g.errors > 0 {
		out.ok = false;
	}
	g.steps += n;
	out.i = n;
	out.s.clear();
	format(out.s, "reversed list with last errors handled");
	out
}
@end
