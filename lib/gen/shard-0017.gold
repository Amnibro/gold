code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_i = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_i] { min_i = j; }
		}
		if min_i != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_i];
			g.res[min_i] = tmp;
