fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bucket = ${size};
	var out_n = 0;
	var i = 0;
	while i < g.n {
		var sum_val = 0;
		var k = 0;
		while k < bucket && i < g.n {
			sum_val += g.res[i];
			k++;
			i++;
		}
		g.res[out_n] = sum_val;
		out_n++;
	}
	g.n = out_n;
	g.steps += out_n;
	out.i = out_n;
	out.s.clear();
	format(out.s, "merged into ", out_n, " checkpoints");
	out
}
@end
