fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if ${p}(s) {
			break;
		}
		g.res[count] = s;
		count++;
		i += 2;
	}
	g.steps += i;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped ", count, " pairs");
	out
}
@end
