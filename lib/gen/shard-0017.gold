code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp = [0; 512];
	var u = 0;
	var lastOdd = -999999;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			if x != lastOdd {
				tmp[u] = x;
				u++;
				lastOdd = x;
			}
		} else {
			tmp[u] = x;
			u++;
		}
	}
	for i in u { g.res[i] = tmp[i]; }
	g.n = u;
	out.i = u;
	out.s.clear();
	format(out.s, "deduped odds length: ", u);
	g.steps += u;
	out
}
@end
@entry b4644b7f018cab63
kind: step
verb: fold
noun: prefix
modifier: while
context: retry
phrase: fold retry prefix while values remain below cap {cap}
phrase: accumulate prefix retry elements while under cap {cap}
slot: cap int
test: list=2,4,6,8,10 cap=15
expect: => i=12 r=0.0 ok=true s="folded prefix sum: 12" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,3,5,7 cap=8
expect: => i=4 r=0.0 ok=true s="folded prefix sum: 4" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var sum = 0;
	var i = 0;
	while i < g.n && sum + g.res[i] <= c {
		sum += g.res[i];
		i++;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded prefix sum: ", sum);
	g.steps += i;
	out
}
@end
