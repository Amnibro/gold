code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	var rounds = 0;
	if f > 1 {
		while total >= f && rounds < 100 {
			total /= f;
			rounds++;
		}
	}
	g.steps += g.n + rounds;
	out.i = rounds;
	out.s.clear();
	format(out.s, "reduction rounds: ", rounds);
	out
}
@end
