expect: => doc: hand bone 0.5,0,1 0.7,0,1
expect: => doc: finger2 bone 0.7,0,1 0.8,0,0.96 ^hand
test: len=0.08 drop=0.03 doc="ground box 0,0,-.5 20,20,1|hand bone 0.5,0,1 0.7,0,1"
expect: => i=3 r=0.0 ok=true s="attachfinger" errors=0 n=0 res=[] cache=0 hits=0
