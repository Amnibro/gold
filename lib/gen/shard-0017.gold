@entry ea3166d4d0001087
kind: step
verb: swap
noun: odds
modifier: with_retry
context: list
phrase: swap odd values with retry passes {attempts}
phrase: order adjacent odds with retry limit {attempts}
slot: attempts int
test: list=9,3,7,2,5 attempts=3
expect: => i=2 r=0.0 ok=true s="swapped odds with 2 retry passes" errors=0 n=5 res=[3,7,9,2,5] cache=0 hits=0
test: list=5,1 attempts=1
expect: => i=1 r=0.0 ok=true s="swapped odds with 1 retry passes" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var passes = 0;
	var total_swaps = 0;
	while passes < max_att {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] % 2 != 0 && g.res[i + 1] % 2 != 0 {
				if g.res[i] > g.res[i + 1] {
					let tmp = g.res[i];
					g.res[i] = g.res[i + 1];
					g.res[i + 1] = tmp;
					swapped = true;
					total_swaps++;
				}
			}
			i++;
		}
		passes++;
		if !swapped { break; }
	}
	g.steps += total_swaps;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "swapped odds with ", passes, " retry passes");
	out
}
@end
