@entry 50d1189eb9976142
kind: step
verb: group
noun: tally
modifier: recursively
context: transform
phrase: group tally recursively by frequency
phrase: count occurrences into tally list
test: list=7,7,7,3,3,9
expect: => i=3 r=0.0 ok=true s="tallied 3 distinct frequencies" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=1,1,2,2,3,3
expect: => i=3 r=0.0 ok=true s="tallied 3 distinct frequencies" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uvals int[512] = [0; 512];
	var ucnt int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in un {
			if uvals[j] == x {
				found = j;
				break;
			}
		}
		if found >= 0 {
			ucnt[found]++;
		} else {
			uvals[un] = x;
			ucnt[un] = 1;
			un++;
		}
	}
	for i in un {
		g.res[i] = ucnt[i];
	}
	g.steps += g.n + un * un;
	g.n = un;
	out.i = un;
	out.s.clear();
	format(out.s, "tallied ", un, " distinct frequencies");
	out
}
@end
