test: arg=1234,581
expect: 2134
expect: 851
test: arg=49,7
expect: 94
expect: 7
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val < 10 { return val; }
	var temp = val;
	var power = 1;
	while temp >= 10 {
		power *= 10;
		temp /= 10;
	}
	let first = val / power;
	let rest = val % power;
	let second_power = power / 10;
	if second_power == 0 {
		return rest * 10 + first;
	}
	let second = rest / second_power;
	let tail = rest % second_power;
	second * power + first * second_power + tail
}
@end
