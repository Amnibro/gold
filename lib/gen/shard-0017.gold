code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var hit = -1;
	var k = g.n;
	while k > 0 {
		k--;
		gold_cache_put(g, k, g.res[k]);
		if g.res[k] == tgt && hit < 0 { hit = k; }
	}
	out.i = hit;
	out.s.clear();
	format(out.s, "searched function in reverse");
	out
}
@end
