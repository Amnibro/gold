code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let rot = ((sum % g.n) + g.n) % g.n;
	var tmp = [0; 512];
	for i in g.n { tmp[i] = g.res[i]; }
	for i in g.n { g.res[(i + rot) % g.n] = tmp[i]; }
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated by total: ", rot);
	g.steps += g.n;
	out
}
@end
