phrase: weathered brick wall texture blend using seed {u}
slot: u int
model: checker c=4; contrast a=1.5; blur
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=32640 hash=354567
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=130560 hash=905686
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 4 < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 4 + y / 4) % 2) as real;
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
