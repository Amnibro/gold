code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient elements for gaps");
		return out;
	}
	var pairs = g.n - 1;
	for i in pairs {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "computed ", pairs, " pairwise gaps");
	out
}
@end
@entry b2194b2cc712ca41
kind: step
verb: pair
noun: tail
modifier: each
context: stats
phrase: pair tail each trailing count {k}
phrase: compute pairwise deltas for trailing {k} items
slot: k int
test: list=10,20,30,45,60 k=3
expect: => i=40 r=0.0 ok=true s="tail pairwise delta sum: 40" errors=0 n=5 res=[10,20,30,45,60] cache=0 hits=0
test: list=1,4,9,16,25 k=2
expect: => i=16 r=0.0 ok=true s="tail pairwise delta sum: 16" errors=0 n=5 res=[1,4,9,16,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count >= g.n { count = g.n - 1; }
	if count < 1 {
		out.ok = false;
		out.s.clear();
		format(out.s, "invalid tail count");
		return out;
	}
	let start = g.n - count;
	var diff_sum = 0;
	for i in count {
		let idx = start + i;
		diff_sum += g.res[idx] - g.res[idx - 1];
	}
	g.steps += count;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "tail pairwise delta sum: ", diff_sum);
	out
}
@end
@entry 1ffd13a389f764d0
kind: step
verb: merge
noun: limit
modifier: all
context: stats
phrase: merge limit all within ceiling {lim}
phrase: combine adjacent samples below limit {lim}
slot: lim int
test: list=1,2,3,4,5 lim=6
expect: => i=3 r=0.0 ok=true s="merged into 3 limited buckets" errors=0 n=3 res=[6,4,5] cache=0 hits=0
test: list=10,20,30,15 lim=35
expect: => i=3 r=0.0 ok=true s="merged into 3 limited buckets" errors=0 n=3 res=[30,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	var out_n = 0;
	var i = 0;
	while i < g.n {
		var cur = g.res[i];
		while i + 1 < g.n && cur + g.res[i + 1] <= ceiling {
			cur += g.res[i + 1];
			i++;
		}
		g.res[out_n] = cur;
		out_n++;
		i++;
	}
	g.n = out_n;
	g.steps += out_n;
	out.i = out_n;
	out.s.clear();
	format(out.s, "merged into ", out_n, " limited buckets");
	out
}
@end
