@entry c6835941a4583d43
kind: step
verb: apply
noun: streak
modifier: at_least
context: core
slot: min_streak int
phrase: apply streak at least minimum repeat {min_streak}
phrase: scale streaks having at least {min_streak} identical items
test: list=1,2,2,2,3 min_streak=3
expect: => i=3 r=0.0 ok=true s="modified streak items: 3" errors=0 n=5 res=[1,4,4,4,3] cache=0 hits=0
test: list=4,4,5,6 min_streak=2
expect: => i=2 r=0.0 ok=true s="modified streak items: 2" errors=0 n=4 res=[8,8,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_streak};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= min_s {
			for k in len { g.res[i + k] = g.res[i + k] * 2; }
			modified += len;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "modified streak items: ", modified);
	out
}
@end
