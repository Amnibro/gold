code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted sequence of ", g.n, " items");
	out
}
@end
@entry 5479a9c6aa3218fd
kind: step
verb: keep
noun: steps
modifier: safely
context: stats
phrase: keep steps safely within step delta {max_step}
phrase: filter observations safely bounded by step {max_step}
slot: max_step int
test: list=1,3,6,12,15 max_step=3
expect: => i=4 r=0.0 ok=true s="kept 4 safe step items" errors=0 n=4 res=[1,3,6,15] cache=0 hits=0
test: list=10,15,22,25 max_step=5
expect: => i=3 r=0.0 ok=true s="kept 3 safe step items" errors=0 n=3 res=[10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${max_step};
	var out_n = 0;
	if g.n > 0 {
		g.res[out_n] = g.res[0];
		out_n++;
		for i in (g.n - 1) {
			let idx = i + 1;
			let diff = g.res[idx] - g.res[idx - 1];
			let abs_d = if diff < 0 { -diff } else { diff };
			if abs_d <= max_s {
				g.res[out_n] = g.res[idx];
				out_n++;
			}
		}
	}
	g.n = out_n;
	g.steps += out_n;
	out.i = out_n;
	out.s.clear();
	format(out.s, "kept ", out_n, " safe step items");
	out
}
@end
