@entry ee9136c94e426971
kind: step
verb: normalize
noun: duplicates
modifier: all
context: loop
phrase: normalize duplicates all across active list
phrase: deduplicate all items maintaining order
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="normalized all duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="normalized all duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "normalized all duplicates");
	out
}
@end
