fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	if req > 0 && g.n > req {
		let start = (g.n - req) / 2;
		var m = 0;
		var i = 0;
		while i < req {
			g.res[m] = g.res[start + i];
			m++;
			i++;
		}
		g.n = m;
	} else if req <= 0 {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "middle up to filtered");
	out
}
@end
