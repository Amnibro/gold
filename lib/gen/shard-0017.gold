@entry 0057c184e849a4ed
kind: step
verb: drop
noun: words
modifier: all
context: core
slot: min_len int
phrase: drop words all shorter than length {min_len}
phrase: filter out short words below length {min_len}
test: text="the quick brown fox" min_len=4
expect: => i=2 r=0.0 ok=true s="quick brown" errors=0 n=0 res=[] cache=0 hits=0
test: text="a big blue sky" min_len=3
expect: => i=3 r=0.0 ok=true s="big blue sky" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	var filtered byte[..200] = "";
	var word byte[..32] = "";
	var kept = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if word.len >= min_l {
				if filtered.len > 0 { filtered.push(' '); }
				for b in word { filtered.push(b); }
				kept++;
			}
			word.clear();
		} else {
			if word.len < 32 { word.push(c); }
		}
	}
	if word.len >= min_l {
		if filtered.len > 0 { filtered.push(' '); }
		for b in word { filtered.push(b); }
		kept++;
	}
	g.steps += v.s.len;
	out.s = filtered;
	out.i = kept;
	out
}
@end
