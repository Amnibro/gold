test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=41128 hash=446130
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=116075 hash=178468
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0_0 = 8;
	for o in 3 { if !gold_img_square(g, c0_0) { out.ok = false; return out; } c0_0 = c0_0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc_0 = 8;
			for o in 3 { t += amp * gold_vnoise(x, y, cc_0, g.iw / cc_0, ${u} + o); norm += amp; amp *= 0.5; cc_0 = cc_0 / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var mn_1 = g.img[0];
	var mx_1 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn_1 { mn_1 = g.img[k]; } if g.img[k] > mx_1 { mx_1 = g.img[k]; } }
	if mx_1 - mn_1 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn_1) / (mx_1 - mn_1); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.2 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "grime");
	out
}
@end
