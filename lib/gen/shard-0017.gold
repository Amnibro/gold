code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	g.n = 0;
	for b in out.s {
		gold_push(g, b as int);
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	var k = if lim < g.n { lim } else { g.n };
	for i in k { sum += g.res[i]; }
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "letter sum: ", sum);
	out
}
@end
