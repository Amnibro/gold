@entry 7ce3858ab7ae5ae5
kind: step
verb: dedupe
noun: primes
modifier: last
context: format
phrase: dedupe prime numbers keeping last occurrences
phrase: remove earlier duplicate prime values
test: list=2,3,2,5,3,7
expect: => i=4 r=0.0 ok=true s="deduped primes: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,13,11,17
expect: => i=3 r=0.0 ok=true s="deduped primes: 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	out.s.clear();
	format(out.s, "deduped primes: ", m);
	out.i = m;
	g.steps += g.n * g.n;
	out
}
@end
