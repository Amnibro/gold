slot: limit int
phrase: select gaps while differences remain below {limit}
phrase: collect pairwise gaps while below limit {limit}
test: list=2,5,9,20 limit=5
expect: => i=2 r=0.0 ok=true s="selected gaps count: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=1,2,3,4,10 limit=2
expect: => i=3 r=0.0 ok=true s="selected gaps count: 3" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${limit};
	var write_idx = 0;
	var i = 0;
	while (i + 1) < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if gap < max_gap {
			g.res[write_idx] = gap;
			write_idx++;
		} else {
			break;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "selected gaps count: ", write_idx);
	out
}
@end
