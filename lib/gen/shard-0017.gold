code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no runs in reverse");
		return out;
	}
	var count = 0;
	var cur_len = 1;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			g.res[count] = cur_len;
			count++;
			cur_len = 1;
		}
		i--;
	}
	g.res[count] = cur_len;
	count++;
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " reverse runs");
	out
}
@end
