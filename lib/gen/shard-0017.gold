@entry 143a4ad7cae4d610
kind: step
verb: pair
noun: primes
modifier: in_reverse
context: list
phrase: pair primes in reverse multiplied by {mult} in list
phrase: reverse order prime items scaled by {mult} across list
slot: mult int
test: list=2,4,3,8,5 mult=2
expect: => i=3 r=0.0 ok=true s="primes modified: 3" errors=0 n=5 res=[10,4,6,8,4] cache=0 hits=0
test: list=4,6,8 mult=3
expect: => i=0 r=0.0 ok=true s="primes modified: 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var p_idx int[..64] = [];
	for i in g.n {
		if core_is_prime(g.res[i]) {
			p_idx.push(i);
		}
	}
	let total_p = p_idx.len;
	for j in total_p / 2 {
		let i1 = p_idx[j];
		let i2 = p_idx[total_p - 1 - j];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
	}
	for j in total_p {
		let idx = p_idx[j];
		g.res[idx] *= m;
	}
	g.steps += total_p;
	out.i = total_p;
	out.s.clear();
	format(out.s, "primes modified: ", total_p);
	out
}
@end
@entry 5bc1a2c1c3716173
kind: step
verb: scan
noun: limit
modifier: all
context: list
phrase: scan limit all items cumulative sum bound {lim} in list
phrase: running scan clamp all results to limit {lim}
slot: lim int
test: list=5,10,20,10 lim=25
expect: => i=25 r=0.0 ok=true s="final sum: 25" errors=0 n=4 res=[5,15,25,25] cache=0 hits=0
test: list=2,3,4 lim=50
expect: => i=9 r=0.0 ok=true s="final sum: 9" errors=0 n=3 res=[2,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lim};
	var run = 0;
	for i in g.n {
		run += g.res[i];
		if run > bound {
			run = bound;
		}
		g.res[i] = run;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "final sum: ", out.i);
	out
}
@end
@entry f8e734b17627f05a
kind: step
verb: swap
noun: digits
modifier: times
context: list
phrase: swap digits {count} times for each item in list
phrase: reverse first last digits {count} times across list
slot: count int
test: list=12,34,5 count=1
expect: => i=1 r=0.0 ok=true s="digits swapped times: 1" errors=0 n=3 res=[21,43,5] cache=0 hits=0
test: list=12,34 count=2
expect: => i=2 r=0.0 ok=true s="digits swapped times: 2" errors=0 n=2 res=[12,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k % 2 != 0 {
		for i in g.n {
			var x = g.res[i];
			let neg = x < 0;
			if neg { x = -x; }
			if x >= 10 {
				var rev = 0;
				while x > 0 {
					rev = rev * 10 + (x % 10);
					x /= 10;
				}
				g.res[i] = if neg { -rev } else { rev };
			}
		}
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "digits swapped times: ", k);
	out
}
@end
@entry 672432920f244eeb
kind: step
verb: pair
noun: minimum
modifier: all
context: list
phrase: pair minimum all elements with list minimum plus {offset}
phrase: add minimum plus {offset} across all list items
slot: offset int
test: list=5,10,15 offset=1
expect: => i=5 r=0.0 ok=true s="minimum: 5" errors=0 n=3 res=[11,16,21] cache=0 hits=0
test: list=2,8 offset=0
expect: => i=2 r=0.0 ok=true s="minimum: 2" errors=0 n=2 res=[4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	let addend = min_val + off;
	for i in g.n {
		g.res[i] += addend;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum: ", min_val);
	out
}
@end
