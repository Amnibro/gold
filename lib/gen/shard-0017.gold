fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var pass = 0;
	while pass < r && pass < g.n {
		var max_idx = pass;
		var i = pass + 1;
		while i < g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
			i++;
		}
		let tmp = g.res[pass];
		g.res[pass] = g.res[max_idx];
		g.res[max_idx] = tmp;
		pass++;
	}
	g.steps += pass * g.n;
	out.i = pass;
	out.s.clear();
	format(out.s, "sorted maximum passes: ", pass);
	out
}
@end
