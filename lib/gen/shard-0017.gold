expect: => i=0 r=0.0 ok=false s="running total checked" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var sum = 0;
	var found = false;
	var match_step = 0;
	for i in g.n {
		sum += g.res[i];
		if sum == t {
			found = true;
			match_step = i + 1;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = match_step;
	out.s.clear();
	format(out.s, "running total checked");
	out
}
@end
@entry 4c26f4eef72b3580
kind: step
verb: apply
noun: words
modifier: in_reverse
context: loop
phrase: apply words in_reverse loop order
phrase: process text words in_reverse sequence
test: text="cats dogs birds"
expect: => i=3 r=0.0 ok=true s="birds dogs cats" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two three"
expect: => i=3 r=0.0 ok=true s="three two one" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var starts int[32] = [0; 32];
	var ends int[32] = [0; 32];
	var wc = 0;
	var in_w = false;
	for i in out.s.len {
		let c = out.s[i];
		if c != ' ' {
			if !in_w {
				if wc < 32 { starts[wc] = i; }
				in_w = true;
			}
		} else {
			if in_w {
				if wc < 32 { ends[wc] = i; wc++; }
				in_w = false;
			}
		}
	}
	if in_w && wc < 32 { ends[wc] = out.s.len; wc++; }
	var res byte[>..] = [];
	var k = wc;
	while k > 0 {
		k--;
		if res.len > 0 { res.push(' '); }
		var p = starts[k];
		while p < ends[k] {
			res.push(out.s[p]);
			p++;
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += wc;
	out.i = wc;
	out
}
@end
