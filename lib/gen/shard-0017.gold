fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			let a = g.res[i];
			let b = g.res[i + 1];
			g.res[m] = if a < b { a } else { b };
			m++;
			i += 2;
		}
		g.n = m;
		var p = 0;
		while p < g.n {
			var q = p + 1;
			while q < g.n {
				if g.res[p] > g.res[q] {
					let tmp = g.res[p];
					g.res[p] = g.res[q];
					g.res[q] = tmp;
				}
				q++;
			}
			p++;
		}
	} else {
		g.n = 0;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise minimums sorted");
	out
}
@end
