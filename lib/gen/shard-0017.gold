	var i = 0;
	while i < g.n && i < limit_idx {
		if g.res[i] >= 100 {
			valid = false;
			break;
		}
		i++;
	}
	out.ok = valid;
	out.s.clear();
	format(out.s, "below threshold: ", valid);
	out.i = if valid { 1 } else { 0 };
	g.steps += i;
	out
}
@end
