@entry b0a29344ec244812
kind: step
verb: reverse
noun: series
modifier: first
context: list
phrase: reverse series first {count} items in list
phrase: list reverse first {count} elements of series
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed series" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed series" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let lim = if k > g.n { g.n } else if k < 0 { 0 } else { k };
	for i in lim / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[lim - 1 - i];
		g.res[lim - 1 - i] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed series");
	out
}
@end
