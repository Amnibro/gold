code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_span};
	var span = 0;
	if g.n > 1 {
		span = g.res[g.n - 1] - g.res[0];
	}
	out.ok = span <= ms;
	out.i = span;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "span: ", span);
	out
}
@end
