kind: step
verb: keep
noun: step
modifier: recursively
context: sort
phrase: keep step recursively retaining every stride {stride}
phrase: filter entries recursively by step stride {stride}
slot: stride int
test: list=10,20,30,40,50 stride=2
expect: => i=3 r=0.0 ok=true s="strided count: 3" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=5,15,25,35,45 stride=3
expect: => i=2 r=0.0 ok=true s="strided count: 2" errors=0 n=2 res=[5,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let strd = ${stride};
	if strd <= 0 { return out; }
	var w = 0;
	var i = 0;
	while i < g.n {
		g.res[w] = g.res[i];
		w++;
		i += strd;
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "strided count: ", w);
	out
}
@end
@entry 37d2b66480d2831a
kind: step
verb: keep
noun: maximum
modifier: recursively
context: sort
phrase: keep maximum recursively through levels {levels}
phrase: retain recursive maximum elements across levels {levels}
slot: levels int
test: list=2,8,5,12,7 levels=2
expect: => i=12 r=0.0 ok=true s="recursive max: 12" errors=0 n=2 res=[12,7] cache=0 hits=0
test: list=3,15,9,21 levels=1
expect: => i=15 r=0.0 ok=true s="recursive max: 15" errors=0 n=2 res=[15,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lvls = ${levels};
	var cur_n = g.n;
	for l in lvls {
		if cur_n > 1 {
			var w = 0;
			var i = 0;
			while i < cur_n {
				if i + 1 < cur_n {
					let m = if g.res[i] > g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
					g.res[w] = m;
					w++;
					i += 2;
				} else {
					g.res[w] = g.res[i];
					w++;
					i++;
				}
			}
			cur_n = w;
		}
	}
	g.n = cur_n;
	g.steps += g.n;
	out.i = if cur_n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "recursive max: ", out.i);
	out
}
@end
