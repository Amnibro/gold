modifier: sorted
context: filter
phrase: sort spaces into sorted order
phrase: calculate gaps between elements into sorted order
test: list=1,8,4,15,10
expect: => i=4 r=0.0 ok=true s="sorted spaces count: 4" errors=0 n=4 res=[-5,-4,7,11] cache=0 hits=0
test: list=20,10,35,5
expect: => i=3 r=0.0 ok=true s="sorted spaces count: 3" errors=0 n=3 res=[-30,-10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		g.res[m] = diff;
		m++;
		i++;
	}
	g.n = m;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.steps += m * 2;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted spaces count: ", m);
	out
}
@end
