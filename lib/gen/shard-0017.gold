code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var rot = 0;
	while rot < g.n {
		if g.res[0] == tgt { break; }
		let first = g.res[0];
		var j = 0;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[g.n - 1] = first;
		rot++;
	}
	g.steps += rot;
	out.i = rot;
	out.s.clear();
	format(out.s, "value rotated");
	out
}
@end
