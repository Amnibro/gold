fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient history elements");
		return out;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[g.n - 1];
	g.res[g.n - 1] = tmp;
	g.steps += 1;
	out.i = 1;
	out.s.clear();
	format(out.s, "swapped history bounds");
	out
}
@end
