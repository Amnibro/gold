fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var first_val = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			first_val = g.res[i];
			found = true;
			break;
		}
	}
	if found {
		g.res[0] = first_val;
		g.n = 1;
		out.i = first_val;
		out.s.clear();
		format(out.s, "kept first matching subfunction: ", first_val);
	} else {
		g.n = 0;
		out.i = 0;
		out.ok = false;
		out.s.clear();
		format(out.s, "no element matched subfunction");
	}
	g.steps += g.n;
	out
}
@end
