	if g.n == 0 {
		out.s.clear();
		format(out.s, "filter last: empty");
		out.i = 0;
		return out;
	}
	let target = g.res[g.n - 1];
	var m = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == target {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	out.s.clear();
	format(out.s, "matched ", target, ": ", m);
	out.i = m;
	g.steps += g.n;
	out
}
@end
