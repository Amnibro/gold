@entry 3a5bce2b0667f2d4
kind: step
verb: join
noun: value
modifier: with_cache
context: retry
phrase: join retry value into cache using key {key} with item {item}
phrase: store joined retry value under key {key} alongside item {item}
slot: key int
slot: item int
test: list=10,20 key=1 item=5
expect: => i=5 r=0.0 ok=true s="joined cache value: 5" errors=0 n=3 res=[10,20,5] cache=1 hits=0
test: list=30,40 key=2 item=8
expect: => i=8 r=0.0 ok=true s="joined cache value: 8" errors=0 n=3 res=[30,40,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let it = ${item};
	let prev, found = gold_cache_get(g, k);
	let newVal = if found { prev + it } else { it };
	gold_cache_put(g, k, newVal);
	gold_push(g, newVal);
	out.i = newVal;
	out.s.clear();
	format(out.s, "joined cache value: ", newVal);
	g.steps += 1;
	out
}
@end
