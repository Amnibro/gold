	let lim = ${limit};
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	if avg > lim {
		var j = 0;
		while j < g.n {
