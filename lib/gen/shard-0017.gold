@entry 94f12a65cc5eb9ce
kind: step
verb: duplicate
noun: floor
modifier: glossy
context: scene
phrase: duplicate floor with glossy finish count {n} spacing {dy}
phrase: repeat glossy floor tiles count {n} along y by {dy}
slot: n int
slot: dy real
test: n=2 dy=4.0 doc="tile box 0,0,0 3,3,0.2 m:plastic #222222"
expect: => i=3 r=0.0 ok=true s="dupfloorglos" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: tile box 0,0,0 3,3,0.2 m:plastic #222222
expect: => doc: floor2 box 0,4,0 3,3,0.2 m:plastic #222222
expect: => doc: floor3 box 0,8,0 3,3,0.2 m:plastic #222222
test: n=3 dy=2.5 doc="slab box 0,0,0 2,2,0.1 m:plastic #111111"
expect: => i=4 r=0.0 ok=true s="dupfloorglos" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: slab box 0,0,0 2,2,0.1 m:plastic #111111
expect: => doc: floor2 box 0,2.5,0 3,3,0.2 m:plastic #222222
expect: => doc: floor3 box 0,5,0 3,3,0.2 m:plastic #222222
expect: => doc: floor4 box 0,7.5,0 3,3,0.2 m:plastic #222222
test: n=0 dy=2.0
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} <= 0 || ${dy} <= 0.0 { out.ok = false; return out; }
	var i = 1;
	while i <= ${n} {
		var o byte[>..] = [];
		var name byte[>..] = [];
		gold_dnews(g, "floor", "", name);
		o.append(name);
		o.append(" box 0,");
		gold_fnum(o, (i as real) * ${dy});
		o.append(",0 3,");
		o.append("3,0.");
		o.append("2 m:plastic #2");
		o.append("22");
		o.append("22");
		o.append("2");
		gold_doc(g, o);
		i = i + 1;
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "dupfloorglos");
	out
}
@end
