code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	for i in out.s.len {
		var code = out.s[i] as int;
		if code < low { code = low; }
		if code > high { code = high; }
		out.s[i] = code as byte;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
