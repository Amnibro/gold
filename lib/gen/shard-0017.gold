	var r = ${retries};
	out.s.clear();
	format(out.s, "joined: [");
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= 0 {
			if count > 0 { format(out.s, ", "); }
			format(out.s, g.res[i]);
			count++;
		} else if r > 0 {
