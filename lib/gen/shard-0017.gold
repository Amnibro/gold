@entry b78ec215bcd77419
kind: step
verb: rank
noun: average
modifier: unique
context: filter
phrase: rank unique elements above average
phrase: filter unique items exceeding list average
test: list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="ranked unique above average: 2" errors=0 n=2 res=[40,50] cache=0 hits=0
test: list=2,4,4,8,12
expect: => i=2 r=0.0 ok=true s="ranked unique above average: 2" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "ranked average empty");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > avg {
			var seen = false;
			var j = 0;
			while j < m {
				if g.res[j] == x { seen = true; }
				j++;
			}
			if !seen {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += m + g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "ranked unique above average: ", m);
	out
}
@end
