	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.28 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (5 as real)) as! int;
		if t > 5 - 1 { t = 5 - 1; }
		g.img[k] = (t as real) / ((5 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "metal");
	out
}
