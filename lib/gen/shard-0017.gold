code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var m = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x > limit { x = limit; }
		g.res[m] = x;
		m++;
		i += 2;
	}
	g.n = m;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated every other");
	out
}
@end
