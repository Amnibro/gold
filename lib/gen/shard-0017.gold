fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] > th {
			sum += g.res[i];
			count++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded threshold sum: ", sum);
	g.steps += count;
	out
}
@end
