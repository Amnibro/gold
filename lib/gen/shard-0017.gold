phrase: apply duplicates with cache recording duplicate counts
phrase: store duplicate value frequencies into cache
test: list=2,3,2,4,2
expect: => i=1 r=0.0 ok=true s="cached 1 duplicates" errors=0 n=5 res=[2,3,2,4,2] cache=1 hits=0
test: list=7,8,7,8
expect: => i=2 r=0.0 ok=true s="cached 2 duplicates" errors=0 n=4 res=[7,8,7,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_recorded = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in i { if g.res[j] == val { seen = true; break; } }
		if !seen {
			var occurrences = 0;
			for k in g.n { if g.res[k] == val { occurrences++; } }
			if occurrences > 1 {
				gold_cache_put(g, val, occurrences);
				dup_recorded++;
			}
		}
	}
	out.i = dup_recorded;
	out.s.clear();
	format(out.s, "cached ", dup_recorded, " duplicates");
	out
}
@end
