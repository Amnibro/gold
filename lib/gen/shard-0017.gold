	while i < g.n {
		if g.res[i] > lim {
			gold_fail(g, "alternating item over limit");
			errs++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = errs;
	out.s.clear();
	format(out.s, "errors alternating: ", errs);
	out
}
@end
@entry 428b9ea4f6844afe
kind: step
verb: compare
noun: value
modifier: unique
context: list
slot: target int
phrase: compare value unique occurrences of {target}
phrase: count unique matches matching target {target}
test: list=1,2,3,2 target=1
