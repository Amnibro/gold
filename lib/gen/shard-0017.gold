@entry 35d94bed4d9a96a1
kind: step
verb: rank
noun: runs
modifier: with_retry
context: retry
phrase: rank consecutive runs within retry allowance {budget}
phrase: measure run sequences under retry budget {budget}
slot: budget int
test: list=1,2,3,1,2,3,4 budget=5
expect: => i=4 r=0.0 ok=true s="ranked run length: 4" errors=0 n=7 res=[1,2,3,1,2,3,4] cache=0 hits=0
test: list=5,4,3,2,1 budget=3
expect: => i=1 r=0.0 ok=true s="ranked run length: 1" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n == 0 { out.i = 0; return out; }
	var maxRun = 1;
	var curRun = 1;
	for i in 1..g.n {
		if g.res[i] >= g.res[i - 1] {
			curRun++;
			if curRun > maxRun { maxRun = curRun; }
		} else {
			curRun = 1;
		}
	}
	let result = if maxRun > b { b } else { maxRun };
	out.i = result;
	out.s.clear();
	format(out.s, "ranked run length: ", result);
	g.steps += g.n;
	out
}
@end
