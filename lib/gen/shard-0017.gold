kind: step
verb: blend
noun: tiles
modifier: coarse
context: texture
phrase: blend coarse ceramic pavers with seed {u}
phrase: rough coarse mosaic tiles blend from seed {u}
slot: u int
model: checker c=8; contrast a=1.8; quantize n=4
test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=32640 hash=566549
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=130560 hash=774075
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 8 < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 8 + y / 8) % 2) as real;
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.8 + 0.5); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 4 < 2 || 4 > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
