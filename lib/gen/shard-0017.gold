@entry 5e646c1fc9a1cb54
kind: step
verb: merge
noun: history
modifier: unique
context: stats
phrase: merge history unique distinct observations
phrase: deduplicate history observations into unique list
test: list=1,2,2,3,4,4,5
expect: => i=5 r=0.0 ok=true s="merged unique history count: 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="merged unique history count: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if uniq[j] == x { exists = true; break; }
		}
		if !exists && un < 512 {
			uniq[un] = x;
			un++;
		}
	}
	for i in un { g.res[i] = uniq[i]; }
	g.n = un;
	g.steps += un;
	out.i = un;
	out.s.clear();
	format(out.s, "merged unique history count: ", un);
	out
}
@end
@entry 3a7b7337669d7424
kind: step
verb: measure
noun: average
modifier: until
context: stats
phrase: measure average until reaching cutoff {cutoff}
phrase: compute running average until exceeding {cutoff}
slot: cutoff int
test: list=10,20,30,40 cutoff=35
expect: => i=15 r=0.0 ok=true s="average until cutoff: 15" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
