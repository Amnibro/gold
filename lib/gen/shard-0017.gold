code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var mul = 1;
	while x > 0 {
		let d1 = x % 10;
		x /= 10;
		if x > 0 {
			let d2 = x % 10;
			x /= 10;
			res += (d2 + d1 * 10) * mul;
		} else {
			res += d1 * mul;
		}
		mul *= 100;
	}
	res
}
@end
