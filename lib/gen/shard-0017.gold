@entry 2046efa15fbac7a7
kind: step
verb: rotate
noun: function
modifier: nested
context: format
phrase: rotate function entries using nested offset {offset}
phrase: shift list sequence with nested rotation {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="rotated by 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,10,15,20 offset=2
expect: => i=2 r=0.0 ok=true s="rotated by 2" errors=0 n=4 res=[15,20,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${offset};
	if g.n > 0 {
		let shift = k % g.n;
		var temp int[512] = [0; 512];
		var i = 0;
		while i < g.n {
			temp[(i + shift) % g.n] = g.res[i];
			i++;
		}
		var j = 0;
		while j < g.n {
			g.res[j] = temp[j];
			j++;
		}
	}
	out.s.clear();
	format(out.s, "rotated by ", k);
	out.i = k;
	g.steps += g.n;
	out
}
@end
@entry 281a537f4642281a
kind: step
verb: rotate
noun: budget
modifier: up_to
context: format
phrase: rotate budget elements up to limit {limit}
phrase: cycle budget items bounded up to {limit}
slot: limit int
test: list=1,2,3,4,5 limit=3
expect: => i=3 r=0.0 ok=true s="rotated prefix 3" errors=0 n=5 res=[2,3,1,4,5] cache=0 hits=0
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="rotated prefix 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	if bound > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < bound {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[bound - 1] = first;
	}
	out.s.clear();
	format(out.s, "rotated prefix ", bound);
	out.i = bound;
	g.steps += bound;
	out
}
@end
@entry 68106ad786653637
kind: step
verb: rank
noun: step
modifier: between
context: format
phrase: rank step differences between bounds {lo} to {hi}
phrase: count formatted steps falling between {lo} {hi}
slot: lo int
slot: hi int
test: list=1,4,7,12 lo=2 hi=5
expect: => i=3 r=0.0 ok=true s="steps between: 3" errors=0 n=4 res=[1,4,7,12] cache=0 hits=0
test: list=10,20,25 lo=4 hi=8
expect: => i=1 r=0.0 ok=true s="steps between: 1" errors=0 n=3 res=[10,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= l && diff <= h { count++; }
		i++;
	}
	out.s.clear();
	format(out.s, "steps between: ", count);
	out.i = count;
	g.steps += g.n;
	out
}
@end
