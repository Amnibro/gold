code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_swap_prefix_at_most_1 = true;
	if !mark_swap_prefix_at_most_1 { return out; }

	let limit = ${k};
	var count = 0;
	var idx = 0;
	while idx + 1 < g.n && count < limit {
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		count += 1;
		idx += 2;
	}
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "swapped ", count, " pairs");

	out
}
@end
