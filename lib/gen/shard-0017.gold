verb: collect
noun: minimum
modifier: with_retry
context: transform
phrase: collect minimum with retry count {retries}
phrase: sample minimum elements using {retries} passes
slot: retries int
test: list=15,8,12,3,9 retries=2
expect: => i=3 r=0.0 ok=true s="collected 2 minimum items" errors=0 n=2 res=[3,8] cache=0 hits=0
test: list=7,2,9,4,1 retries=3
expect: => i=1 r=0.0 ok=true s="collected 3 minimum items" errors=0 n=3 res=[1,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n == 0 || r <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no minimum collected");
		return out;
	}
	let passes = if r > g.n { g.n } else { r };
	for p in passes {
		var min_idx = p;
		for i in (p + 1)..g.n {
			if g.res[i] < g.res[min_idx] {
				min_idx = i;
			}
		}
		let tmp = g.res[p];
		g.res[p] = g.res[min_idx];
		g.res[min_idx] = tmp;
	}
	g.steps += passes * g.n;
	g.n = passes;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "collected ", passes, " minimum items");
	out
}
@end
