@entry f15c2bc012ab2694
kind: step
verb: filter
noun: spaces
modifier: with_cache
context: format
phrase: filter spaces with cache memoization
phrase: format text filtering spaces using cache
test: text="a b c"
expect: => i=2 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=1 hits=0
test: text="hello world test"
expect: => i=2 r=0.0 ok=true s="helloworldtest" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res_s byte[..200] = "";
	var i = 0;
	var spaces = 0;
	while i < out.s.len {
		let b = out.s[i];
		if b == ' ' {
			spaces++;
		} else {
			if res_s.len < 200 { res_s.push(b); }
		}
		i++;
	}
	gold_cache_put(g, 1, spaces);
	out.s.clear();
	var j = 0;
	while j < res_s.len {
		out.s.push(res_s[j]);
		j++;
	}
	out.i = spaces;
	g.steps += out.s.len;
	out
}
@end
@entry 61bf0dd7196fda86
kind: step
verb: repeat
noun: maximum
modifier: up_to
context: format
phrase: repeat maximum value up to count {limit}
phrase: render repeated maximum up to {limit} copies
slot: limit int
test: list=3,9,5 limit=3
expect: => i=9 r=0.0 ok=true s="rep max: [9, 9, 9]" errors=0 n=3 res=[3,9,5] cache=0 hits=0
test: list=12,4,8 limit=2
expect: => i=12 r=0.0 ok=true s="rep max: [12, 12]" errors=0 n=3 res=[12,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_v = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] > max_v { max_v = g.res[i]; }
		i++;
	}
	out.s.clear();
	format(out.s, "rep max: [");
	var k = 0;
	while k < lim {
		format(out.s, max_v);
		if k + 1 < lim { format(out.s, ", "); }
		k++;
	}
	format(out.s, "]");
	out.i = max_v;
	g.steps += lim + g.n;
	out
}
@end
@entry 88bb909028f98163
kind: step
verb: rank
noun: range
modifier: until
context: format
