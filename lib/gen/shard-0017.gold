@entry 487b61716a9676b7
kind: step
verb: pair
noun: prefix
modifier: unique
context: stats
phrase: pair prefix unique distinct values
phrase: combine adjacent unique prefix observations
test: list=1,1,2,3,3,4,5
expect: => i=4 r=0.0 ok=true s="unique prefix pairs: 4" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,20,30
expect: => i=2 r=0.0 ok=true s="unique prefix pairs: 2" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var un = 0;
	var u_arr int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un { if u_arr[j] == x { seen = true; break; } }
		if !seen && un < 512 { u_arr[un] = x; un++; }
	}
	if un >= 2 {
		let pairs = un - 1;
		for i in pairs { g.res[i] = u_arr[i] + u_arr[i + 1]; }
		g.n = pairs;
		out.i = pairs;
	} else {
		out.ok = false;
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "unique prefix pairs: ", out.i);
	out
}
@end
