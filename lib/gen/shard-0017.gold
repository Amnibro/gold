code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var occurrences = 0;
	for i in g.n {
		if g.res[i] == tgt { occurrences++; }
	}
	let is_uniq = if occurrences == 1 { 1 } else { 0 };
	g.steps += g.n;
	out.i = is_uniq;
	out.s.clear();
	format(out.s, "unique occurrences: ", is_uniq);
	out
}
@end
@entry 76c9e9173808d96d
kind: step
verb: cache
noun: counter
modifier: recursively
context: list
slot: step_val int
phrase: cache counter recursively stepping by {step_val}
phrase: increment recursive counter cached with step {step_val}
test: list=1,2,3 step_val=5
expect: => i=15 r=0.0 ok=true s="counter cached: 15" errors=0 n=3 res=[1,2,3] cache=1 hits=0
test: list=10,20 step_val=2
expect: => i=4 r=0.0 ok=true s="counter cached: 4" errors=0 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_val};
	let prev, ok = gold_cache_get(g, 0);
	let next_val = prev + st * g.n;
	gold_cache_put(g, 0, next_val);
	g.steps += 1;
	out.i = next_val;
	out.s.clear();
	format(out.s, "counter cached: ", next_val);
	out
}
@end
