@entry 65f314dc9ce5ac8b
kind: step
verb: join
noun: streak
modifier: with_retry
context: format
phrase: join streak elements with allowed gap count {retries}
phrase: combine streak sequence using retry budget {retries}
slot: retries int
test: list=1,2,5,3,4 retries=1
expect: => i=5 r=0.0 ok=true s="streak: [1, 2, 5, 3, 4]" errors=0 n=5 res=[1,2,5,3,4] cache=0 hits=0
test: list=10,20,30,50,40 retries=0
expect: => i=4 r=0.0 ok=true s="streak: [10, 20, 30, 50]" errors=0 n=5 res=[10,20,30,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var r = ${retries};
	out.s.clear();
	format(out.s, "streak: [");
	var len_s = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] >= g.res[i - 1] {
			if len_s > 0 { format(out.s, ", "); }
			format(out.s, g.res[i]);
			len_s++;
		} else if r > 0 {
			r--;
			if len_s > 0 { format(out.s, ", "); }
			format(out.s, g.res[i]);
			len_s++;
		} else {
			break;
		}
		i++;
	}
	format(out.s, "]");
	out.i = len_s;
	g.steps += i;
	out
}
@end
@entry fce72e83c39a8583
kind: step
verb: dedupe
noun: digits
modifier: nested
context: format
phrase: dedupe digits using nested scan comparison
phrase: remove duplicate digits by nested search
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="unique digits: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=9,9,8,7,8
expect: => i=3 r=0.0 ok=true s="unique digits: 3" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == g.res[i] { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	out.s.clear();
	format(out.s, "unique digits: ", m);
	out.i = m;
	g.steps += g.n * g.n;
	out
}
@end
@entry 41446b6e22514df7
kind: step
verb: repeat
noun: budget
modifier: any
context: format
phrase: repeat budget indicator across any items
phrase: render budget repetition for any entries
slot: budget int
test: list=10,20,30 budget=50
expect: => i=2 r=0.0 ok=true s="budget 50 covers 2 items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,10 budget=20
expect: => i=2 r=0.0 ok=true s="budget 20 covers 2 items" errors=0 n=3 res=[5,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var covered = 0;
	var i = 0;
	while i < g.n {
		if sum + g.res[i] <= b {
			sum += g.res[i];
			covered++;
		} else {
			break;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "budget ", b, " covers ", covered, " items");
	out.i = covered;
	g.steps += g.n;
	out
}
@end
