	var count = 0;
	var new_res int[512] = [0; 512];
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum <= b {
			new_res[count] = g.res[i];
			new_res[count + 1] = g.res[i + 1];
			count += 2;
		}
		i += 2;
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count;
	out.i = count / 2;
	out.s.clear();
	format(out.s, "selected ", count / 2, " pairs under budget");
	out
}
@end
