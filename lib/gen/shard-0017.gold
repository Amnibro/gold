code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n >= ml && g.n > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated running streak: ", g.n);
	out
}
@end
@entry b2a08ce6fd5ccf49
kind: step
verb: search
noun: squares
modifier: in_reverse
context: filter
phrase: search squares in reverse order
phrase: filter perfect squares backwards in sequence
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="found squares in reverse: 3" errors=0 n=3 res=[16,9,4] cache=0 hits=0
test: list=2,25,30,36,40
expect: => i=2 r=0.0 ok=true s="found squares in reverse: 2" errors=0 n=2 res=[36,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp int[512] = [0; 512];
	var tn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var k = 0;
			while k * k <= x {
				if k * k == x { is_sq = true; }
				k++;
			}
		}
		if is_sq {
			tmp[tn] = x;
			tn++;
		}
		i--;
	}
	for j in tn {
		g.res[j] = tmp[j];
	}
	g.n = tn;
	g.steps += g.n * 2;
	out.i = tn;
	out.s.clear();
	format(out.s, "found squares in reverse: ", tn);
	out
}
@end
@entry dacf0704b1402141
kind: step
verb: join
noun: suffix
modifier: sorted
context: filter
slot: count int
phrase: join sorted suffix of {count} filtered elements
phrase: filter sequence joining sorted suffix of size {count}
test: list=10,50,40,20,30 count=3
expect: => i=3 r=0.0 ok=true s="joined sorted suffix count: 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=9,8,7,6,5,4 count=4
expect: => i=4 r=0.0 ok=true s="joined sorted suffix count: 4" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let start = if g.n > cnt { g.n - cnt } else { 0 };
	var m = 0;
	var i = start;
	while i < g.n {
		g.res[m] = g.res[i];
		m++;
		i++;
	}
	g.n = m;
	var j = 0;
	while j < g.n {
		var k = j + 1;
		while k < g.n {
			if g.res[j] > g.res[k] {
				let tmp = g.res[j];
				g.res[j] = g.res[k];
				g.res[k] = tmp;
			}
			k++;
		}
		j++;
	}
	g.steps += m * 2;
	out.i = m;
	out.s.clear();
	format(out.s, "joined sorted suffix count: ", m);
	out
}
@end
