phrase: record adjacent gaps into cache until condition {p}
slot: p pred
test: list=1,4,10,150 p=over_100
expect: => i=6 r=0.0 ok=true s="max gap 6" errors=0 n=4 res=[1,4,10,150] cache=1 hits=0
test: list=2,7,8 p=is_even
expect: => i=5 r=0.0 ok=true s="max gap 5" errors=0 n=3 res=[2,7,8] cache=1 hits=0
code:
fn ${ID}_abs(x int) int { if x < 0 { -x } else { x } }
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { out.i = 0; return out; }
	var max_gap = 0;
	var i = 1;
	while i < g.n {
		if ${p}(g.res[i]) { break; }
		let diff = ${ID}_abs(g.res[i] - g.res[i - 1]);
		if diff > max_gap { max_gap = diff; }
		i++;
	}
	gold_cache_put(g, 0, max_gap);
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap ", max_gap);
	out
}
@end
