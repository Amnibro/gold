	var pairs = 0;
	if g.n >= 2 {
		pairs = g.n - 1;
		for i in pairs {
			let prod = g.res[i] * g.res[i + 1];
			gold_cache_put(g, i, prod);
		}
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "scanned ", pairs, " pairwise products");
	out
}
