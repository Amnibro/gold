			if ok {
				g.res[i] += cached;
			} else {
				gold_cache_put(g, g.res[i], g.res[i]);
			}
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "cache hits: ", g.hits);
	out
}
