fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res_s byte[..200] = "";
	var retries = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		let is_alpha = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
		if is_alpha {
			if res_s.len < 200 { res_s.push(b); }
