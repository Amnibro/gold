@entry 0a688396c1d5d1f1
kind: step
verb: validate
noun: gaps
modifier: at_least
context: cache
phrase: validate gap intervals of at least {min_gap}
phrase: verify spacing between values at least {min_gap}
slot: min_gap int
test: list=2,7,15 min_gap=4
expect: => i=2 r=0.0 ok=true s="validated gaps at least" errors=0 n=3 res=[2,7,15] cache=2 hits=0
test: list=1,3,10 min_gap=3
expect: => i=1 r=0.0 ok=true s="validated gaps at least" errors=0 n=3 res=[1,3,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var valid = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff >= mg {
			gold_cache_put(g, valid, diff);
			valid++;
		}
		i++;
	}
	out.i = valid;
	out.s.clear();
	format(out.s, "validated gaps at least");
	out
}
@end
