			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih {
		var t = (g.img[k] * (7 as real)) as! int;
		if t > 7 - 1 { t = 7 - 1; }
		g.img[k] = (t as real) / ((7 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
