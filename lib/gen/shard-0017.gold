			s2[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s2;
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] * 0.75); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
