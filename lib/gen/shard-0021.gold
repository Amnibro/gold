@entry 81f1d8899ab62b8a
kind: step
verb: tile
noun: rust
modifier: coarse
context: texture
phrase: tile rust coarse surface using seed {u}
phrase: generate coarse rust layer with seed {u}
slot: u int
model: noise c=4 u=${u}; contrast a=1.15; quantize n=3
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=37155 hash=543274
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=114984 hash=399367
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.15 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (3 as real)) as! int;
		if t > 3 - 1 { t = 3 - 1; }
		g.img[k] = (t as real) / ((3 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "rust");
	out
}
@end
@entry d814df1c737674cb
kind: step
verb: blend
noun: leather
modifier: layered
context: texture
phrase: blend leather layered surface using seed {u}
phrase: generate layered leather layer with seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; threshold a=0.44; blur
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=56099 hash=777781
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=150450 hash=145178
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.44 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
@end
