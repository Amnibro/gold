fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var p = 1;
	if x == 0 { return 0; }
	while x > 0 {
		var d = x % 10;
		if d > 5 { d = 5; }
		res += d * p;
		p *= 10;
		x /= 10;
	}
	res
}
@end
@entry 14ac178accfedc38
kind: fn
verb: rotate
noun: history
modifier: in_reverse
context: format
phrase: rotate history in reverse format
phrase: format rotate history reverse
test: arg=123,456
expect: 132
expect: 465
test: arg=100
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	var len = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		len++;
		x /= 10;
	}
	if len <= 1 { return rev; }
	let last = rev % 10;
	rev = (rev / 10);
	var p = 1;
	var t = rev;
	while t > 0 { p *= 10; t /= 10; }
	last * p + rev
}
@end
