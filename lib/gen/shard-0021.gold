@entry f49e5362b8635d68
kind: step
verb: shift
noun: digits
modifier: unique
context: stats
slot: shift int
phrase: shift digits unique values offset {shift}
phrase: adjust sample digits unique step {shift}
test: list=2,2,3,5 shift=1
expect: => i=3 r=0.0 ok=true s="unique count: 3" errors=0 n=4 res=[3,3,4,6] cache=0 hits=0
test: list=7,7,7 shift=2
expect: => i=1 r=0.0 ok=true s="unique count: 1" errors=0 n=3 res=[9,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var unique_count = 0;
	for i in g.n {
		var first_seen = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first_seen = false;
				break;
			}
		}
		if first_seen { unique_count++; }
	}
	for i in g.n {
		g.res[i] += sh;
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique count: ", unique_count);
	out
}
@end
