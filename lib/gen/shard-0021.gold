@entry 34b8c58eb5e42c3c
kind: step
verb: check
noun: loop
modifier: with_retry
context: list
phrase: check loop sequence with retry attempts {retries} for {target}
phrase: verify loop condition with retry count {retries} seeking {target}
slot: retries int
slot: target int
test: list=1,2,3 retries=2 target=2
expect: => i=0 r=0.0 ok=true s="target found on attempt 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,3 retries=2 target=5
expect: => i=0 r=0.0 ok=false s="target not found after retries" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ret = ${retries};
	let tgt = ${target};
	var found = false;
	var attempt = 0;
	while attempt <= ret {
		for i in g.n {
			if g.res[i] == tgt {
				found = true;
				break;
			}
		}
		if found { break; }
		attempt++;
	}
	g.steps += attempt + 1;
	if found {
		out.ok = true;
		out.s.clear();
		format(out.s, "target found on attempt ", attempt);
	} else {
		out.ok = false;
		g.errors++;
		out.s.clear();
		format(out.s, "target not found after retries");
	}
	out
}
@end
