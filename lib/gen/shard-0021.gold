fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for k in g.n {
		g.res[k] *= f;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " sorted items");
	out
}
@end
