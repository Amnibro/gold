phrase: locate target {target} searching from list middle first
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="middle search index: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,2,3,4,5 target=1
expect: => i=0 r=0.0 ok=true s="middle search index: 0" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	let mid = g.n / 2;
	var offset = 0;
	while offset <= mid {
		let right = mid + offset;
		if right < g.n && g.res[right] == tgt {
			found_idx = right;
			break;
		}
		let left = mid - offset;
		if left >= 0 && g.res[left] == tgt {
			found_idx = left;
			break;
		}
		offset++;
	}
	g.steps += offset + 1;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "middle search index: ", found_idx);
	out
}
@end
