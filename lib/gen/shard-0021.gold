@entry 971892a45ea6db8a
kind: step
verb: scan
noun: history
modifier: until
context: error
phrase: scan history until error code {target}
phrase: inspect history log until matching {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="found target at 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,12,19,25 target=19
expect: => i=2 r=0.0 ok=true s="found target at 2" errors=0 n=4 res=[5,12,19,25] cache=0 hits=0
test: list=10,20 target=-5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${target} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var idx = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == ${target} { idx = i; break; }
		i++;
	}
	g.steps += i + 1;
	if idx < 0 {
		gold_fail(g, "target not found in history");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target not found");
		return out;
	}
