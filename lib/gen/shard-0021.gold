@entry 907f80e853034fad
kind: step
verb: join
noun: budget
modifier: safely
context: cache
phrase: join cache entries safely within budget {budget}
phrase: accumulate cache values guarded by budget {budget}
slot: budget int
test: list=10,20,30 budget=35
expect: => i=30 r=0.0 ok=true s="joined budget safely" errors=0 n=3 res=[10,20,30] cache=2 hits=0
test: list=5,15,25 budget=22
expect: => i=20 r=0.0 ok=true s="joined budget safely" errors=0 n=3 res=[5,15,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var rem = b;
	for i in g.n {
		if g.res[i] <= rem {
			rem -= g.res[i];
			gold_cache_put(g, i, g.res[i]);
		}
	}
	out.i = b - rem;
	out.s.clear();
	format(out.s, "joined budget safely");
	out
}
@end
@entry 83f05aa793320ff6
kind: step
verb: filter
noun: values
modifier: in_reverse
context: cache
phrase: filter values in reverse order to cache
phrase: sift items backwards into cache store
test: list=10,0,30
expect: => i=2 r=0.0 ok=true s="filtered values in reverse" errors=0 n=3 res=[10,0,30] cache=2 hits=0
test: list=0,5,15,0
expect: => i=2 r=0.0 ok=true s="filtered values in reverse" errors=0 n=4 res=[0,5,15,0] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if g.res[k] > 0 {
			gold_cache_put(g, count, g.res[k]);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "filtered values in reverse");
	out
}
@end
