kind: step
verb: reverse
noun: odds
modifier: until
context: aggregate
slot: limit int
phrase: reverse odds until reaching index {limit}
phrase: invert odd numbers until boundary position {limit}
test: list=1,2,3,4,5,6,7 limit=5
expect: => i=3 r=0.0 ok=true s="reversed 3 odd numbers until limit 5" errors=0 n=7 res=[5,2,3,4,1,6,7] cache=0 hits=0
test: list=11,12,13,14,15 limit=4
expect: => i=2 r=0.0 ok=true s="reversed 2 odd numbers until limit 4" errors=0 n=5 res=[13,12,11,14,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var idxs int[256] = [0; 256];
	var count = 0;
	var cap = lim;
	if cap > g.n { cap = g.n; }
	for k in cap {
		if g.res[k] % 2 != 0 {
			idxs[count] = k;
			count++;
		}
	}
	for k in count / 2 {
		let i1 = idxs[k];
		let i2 = idxs[count - 1 - k];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
	}
	g.steps += cap;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " odd numbers until limit ", lim);
	out
}
@end
