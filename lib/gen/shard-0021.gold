code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var match_arr = [0; 256];
	var other_arr = [0; 256];
	var mn = 0;
	var on = 0;
	for i in g.n {
		if ${cond}(g.res[i]) && mn < 256 {
			match_arr[mn] = g.res[i];
			mn++;
		} else if on < 256 {
			other_arr[on] = g.res[i];
			on++;
		}
	}
	for i in mn { g.res[i] = match_arr[i]; }
	for i in on { g.res[mn + i] = other_arr[i]; }
	g.steps += g.n;
	out.i = mn;
	out.s.clear();
	format(out.s, "sorted ", mn, " conditional matches to front");
	out
}
@end
