@entry 06fe225480daec64
kind: step
verb: limit
noun: tally
modifier: pairwise
context: error
phrase: limit pairwise tally differences {diff_limit}
phrase: enforce pairwise tally gap {diff_limit}
slot: diff_limit int
test: list=10,14,18 diff_limit=5
expect: => i=3 r=0.0 ok=true s="tally valid" errors=0 n=3 res=[10,14,18] cache=0 hits=0
test: list=10,20 diff_limit=5
expect: => i=0 r=0.0 ok=false s="gap too large" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${diff_limit};
	var idx = 1;
	while idx < g.n {
		var diff = g.res[idx] - g.res[idx - 1];
		if diff < 0 {
			diff = -diff;
		}
		if diff > max_gap {
			gold_fail(g, "limit tally: pairwise gap exceeded");
			out.ok = false;
			out.s.clear();
			format(out.s, "gap too large");
			return out;
		}
		idx++;
	}
	out.i = idx;
	out.s.clear();
	format(out.s, "tally valid");
	out
}
@end
