	let tf = ${target_first};
	if g.n == 0 { return out; }
	let diff = tf - g.res[0];
	for i in g.n {
		g.res[i] += diff;
	}
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "rebased series by offset: ", diff);
	out
}
