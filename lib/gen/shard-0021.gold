fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var valid = 0;
	for k in g.n - 1 {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		if diff <= md { valid++; }
	}
	g.steps += g.n;
	out.i = valid;
	out.s.clear();
	format(out.s, "checked ", valid, " pairs within threshold diff ", md);
	out
}
@end
