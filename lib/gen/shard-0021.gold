phrase: find nested difference step matching target {target}
test: list=10,15,30,25 target=5
expect: => i=2 r=0.0 ok=true s="nested step pairs matched: 2" errors=0 n=4 res=[10,15,30,25] cache=0 hits=0
test: list=2,7,12,20 target=10
expect: => i=1 r=0.0 ok=true s="nested step pairs matched: 1" errors=0 n=4 res=[2,7,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var pairs = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			let diff = g.res[j] - g.res[i];
			let pos = if diff < 0 { -diff } else { diff };
			if pos == t { pairs++; }
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "nested step pairs matched: ", pairs);
	out
}
@end
