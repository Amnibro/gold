noun: middle
modifier: none
context: list
slot: span int
phrase: sum middle none excluding central span {span}
phrase: aggregate middle slice across span width {span}
phrase: accumulate central elements over span {span}
test: list=1,2,3,4,5,6,7 span=3
expect: => i=12 r=0.0 ok=true s="middle slice sum: 12" errors=0 n=7 res=[1,2,3,4,5,6,7] cache=0 hits=0
test: list=10,20,30,40,50 span=2
expect: => i=50 r=0.0 ok=true s="middle slice sum: 50" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let mid = g.n / 2;
	var start = mid - sp / 2;
	if start < 0 { start = 0; }
	var end = start + sp;
	if end > g.n { end = g.n; }
	var s = 0;
	var i = start;
	while i < end {
		s += g.res[i];
		i++;
	}
	g.steps += end - start;
	out.i = s;
	out.s.clear();
	format(out.s, "middle slice sum: ", s);
	out
}
@end
