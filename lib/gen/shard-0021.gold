	var dn = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i > 1 {
			var k = i;
			while k < j {
				dups[dn] = g.res[k];
				dn++;
				k++;
			}
		}
		i = j;
	}
	let take = if kc < dn { kc } else { dn };
	gold_clear(g);
	let start = dn - take;
	for k in take {
		gold_push(g, dups[start + k]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " trailing duplicate items");
	out
}
@end
