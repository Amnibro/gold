fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var matches = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff == d {
			matches++;
		} else {
			break;
		}
		i++;
	}
	g.steps += i;
	out.i = matches;
	out.s.clear();
	format(out.s, "found ", matches, " pairwise prefix matches");
	out
}
@end
