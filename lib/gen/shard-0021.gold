test: input=7 list=2,3,5
expect: => i=7 r=0.0 ok=true s="prime shifted" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: input=9 list=2,3
expect: => i=9 r=0.0 ok=false s="not prime" errors=1 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i < 2 {
		gold_fail(g, "shift primes: value below two");
		out.ok = false;
		out.s.clear();
		format(out.s, "invalid prime");
		return out;
	}
	var d = 2;
	var is_prime = true;
	while d * d <= out.i {
		if out.i % d == 0 {
			is_prime = false;
		}
		d++;
	}
	if !is_prime {
		gold_fail(g, "shift primes: composite number");
		out.ok = false;
		out.s.clear();
		format(out.s, "not prime");
		return out;
	}
	gold_push(g, out.i);
	out.s.clear();
	format(out.s, "prime shifted");
	out
}
@end
