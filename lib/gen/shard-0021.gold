@entry 20ef0e5544476a08
kind: step
verb: repeat
noun: window
modifier: recursively
context: cache
phrase: repeat window recursively across span {span}
phrase: recurse over cache window of span {span}
slot: span int
test: list=1,2,3,4,5,6 span=2
expect: => i=3 r=0.0 ok=true s="repeated window recursively" errors=0 n=6 res=[1,2,3,4,5,6] cache=3 hits=0
test: list=10,20,30,40 span=2
expect: => i=2 r=0.0 ok=true s="repeated window recursively" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	var k = 0;
	var idx = 0;
	while k + s <= g.n && s > 0 {
		var sum = 0;
		for j in s { sum += g.res[k + j]; }
		gold_cache_put(g, idx, sum);
		idx++;
		k += s;
	}
	out.i = idx;
	out.s.clear();
	format(out.s, "repeated window recursively");
	out
}
@end
