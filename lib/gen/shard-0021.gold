code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if st <= 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i += st;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "subsampled step items: ", kept);
	out
}
@end
