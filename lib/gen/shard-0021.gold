fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	gold_cache_put(g, k, min_val);
	var i = min_idx;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "ranked cached minimum ", min_val);
	out
}
@end
