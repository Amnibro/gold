test: arg=4213,512
expect: 1234
expect: 125
test: arg=803
expect: 38
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	if v == 0 {
		return 0;
	}
	var res = 0;
	var d = 1;
	while d <= 9 {
		var tmp = v;
		while tmp > 0 {
			let rem = tmp % 10;
			if rem == d {
				res = res * 10 + d;
			}
			tmp /= 10;
		}
		d++;
	}
	return res;
}
@end
@entry a00ae8e81c105f20
kind: fn
verb: dedupe
noun: cache
modifier: in_reverse
context: retry
phrase: dedupe cache in reverse digit scan
phrase: remove duplicate retry cache entries scanning backward
test: arg=12233,5451
expect: 321
expect: 154
test: arg=777
expect: 7
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	var seen = 0;
	var res = 0;
	while v > 0 {
		let d = v % 10;
		let bit = 1 << d;
