expect: => i=3 r=0.0 ok=true s="split to 3 items in runs" errors=0 n=3 res=[5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_runs};
	var distinct = 0;
	var cut = g.n;
	var i = 0;
	while i < g.n {
		distinct++;
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if distinct == mr {
			cut = j;
			break;
		}
		i = j;
	}
	g.n = cut;
	out.i = cut;
	out.s.clear();
	format(out.s, "split to ", cut, " items in runs");
	out
}
@end
