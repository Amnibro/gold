	let sc = ${scale};
	var mx = 0;
	for i in g.n { if g.res[i] > mx { mx = g.res[i]; } }
	if mx <= 0 { mx = 1; }
	for i in g.n {
		g.res[i] = (g.res[i] * sc) / mx;
	}
	g.steps += g.n * 2;
	out.i = mx;
	gold_text(out, "normalized all numbers");
	return out;
}
