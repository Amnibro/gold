code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var min_idx = 0;
		var i = 1;
		while i < g.n {
			if g.res[i] < g.res[min_idx] {
				min_idx = i;
			}
			i++;
		}
		let tmp = g.res[0];
		g.res[0] = g.res[min_idx];
		g.res[min_idx] = tmp;
		out.i = g.res[0];
		out.s.clear();
		format(out.s, "moved minimum ", out.i, " to head");
	} else if g.n == 1 {
		out.i = g.res[0];
		out.s.clear();
		format(out.s, "single element at head");
	}
	g.steps += g.n;
	out
}
@end
