@entry 1d0cec83ce847c09
kind: step
verb: scale
noun: memo
modifier: at_most
context: list
phrase: scale memoized list entries at most {cap} times by {factor}
phrase: apply scale factor {factor} to cached list values up to {cap}
slot: cap int
slot: factor int
test: list=4,5,6 cap=2 factor=3
expect: => i=2 r=0.0 ok=true s="scaled memo 2" errors=0 n=3 res=[12,15,6] cache=2 hits=0
test: list=10,20 cap=1 factor=2
expect: => i=1 r=0.0 ok=true s="scaled memo 1" errors=0 n=2 res=[20,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let f = ${factor};
	var k = c;
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	for i in k {
		let x = g.res[i];
		let v_cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = v_cached * f;
		} else {
			gold_cache_put(g, x, x * f);
			g.res[i] = x * f;
		}
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "scaled memo ", k);
	out
}
@end
