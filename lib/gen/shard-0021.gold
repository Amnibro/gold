test: list=15,22,29 k=1
expect: => i=2 r=0.0 ok=true s="mapped spaces with retry" errors=0 n=2 res=[7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		gold_text(out, "no spaces to map");
		return out;
	}
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff <= 0 { diff = ${k}; }
		g.res[i - 1] = diff;
	}
	g.n = g.n - 1;
	out.i = g.n;
	gold_text(out, "mapped spaces with retry");
	return out;
}
@end
