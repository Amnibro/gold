@entry e3deb19a2c200055
kind: step
verb: validate
noun: average
modifier: between
context: filter
phrase: validate average between bounds {low} to {high}
phrase: check sequence average is between {low} to {high}
slot: low int
slot: high int
test: list=10,20,30,40 low=15 high=35
expect: => i=25 r=0.0 ok=true s="validated average: 25" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,4,6,8 low=10 high=20
expect: => i=5 r=0.0 ok=false s="validated average: 5" errors=1 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n == 0 {
		gold_fail(g, "empty sequence for average validation");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	g.steps += g.n;
	let ok = avg >= lo && avg <= hi;
	if !ok {
		gold_fail(g, "average outside specified bounds");
		out.ok = false;
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "validated average: ", avg);
	out
}
@end
