fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x <= 1 { return x; }
	var low = 1;
	var high = x;
	var ans = 1;
	while low <= high {
		let mid = low + (high - low) / 2;
		if mid <= x / mid {
			ans = mid;
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
