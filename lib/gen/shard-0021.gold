expect: 9
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var p = 1;
	var t = x;
	while t >= 10 { p *= 10; t /= 10; }
	let head = t;
	(x % p) * 10 + head
}
@end
