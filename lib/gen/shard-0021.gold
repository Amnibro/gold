code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let first = g.res[0];
		for i in 1..g.n { gold_cache_put(g, i - 1, g.res[i]); }
		gold_cache_put(g, g.n - 1, first);
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "rotated cache first");
	out
}
@end
