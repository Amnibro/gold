expect: => i=1 r=0.0 ok=true s="scaled 1 items within budget" errors=0 n=3 res=[3,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	let f = ${factor};
	var count = 0;
	for i in g.n {
		if rem <= 0 { break; }
		g.res[i] *= f;
		rem -= g.res[i];
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " items within budget");
	out
}
@end
@entry 5f096bd8e52d500c
kind: step
verb: merge
noun: minimum
modifier: first
context: list
phrase: merge first {count} minimum values into single total
phrase: combine leading {count} minimum elements into sum
slot: count int
test: list=10,2,5,1,8 count=3
expect: => i=8 r=0.0 ok=true s="merged 3 minimums into 8" errors=0 n=3 res=[8,10,8] cache=0 hits=0
test: list=7,3,9 count=2
expect: => i=10 r=0.0 ok=true s="merged 2 minimums into 10" errors=0 n=2 res=[10,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = if ${count} > g.n { g.n } else { ${count} };
	var i = 0;
	while i < c {
		var min_idx = i;
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
			j++;
		}
		let tmp = g.res[i];
		g.res[i] = g.res[min_idx];
		g.res[min_idx] = tmp;
		i++;
	}
	var sum = 0;
	for k in c { sum += g.res[k]; }
	g.res[0] = sum;
	var w = 1;
	var k = c;
	while k < g.n {
		g.res[w] = g.res[k];
		w++;
		k++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged ", c, " minimums into ", sum);
	out
}
@end
