@entry d2485406cf9cbc20
kind: step
verb: sort
noun: history
modifier: nested
context: filter
slot: span int
phrase: sort history nested chunks spanning size {span}
phrase: order historical results within nested chunk span {span}
test: list=4,2,8,6,3,1 span=2
expect: => i=6 r=0.0 ok=true s="sorted nested history: 6" errors=0 n=6 res=[2,4,6,8,1,3] cache=0 hits=0
test: list=9,5,1,8,4,2 span=3
expect: => i=6 r=0.0 ok=true s="sorted nested history: 6" errors=0 n=6 res=[1,5,9,2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp > 1 {
		var start = 0;
		while start < g.n {
			var end = start + sp;
			if end > g.n { end = g.n; }
			for i in start..end {
				for j in i + 1..end {
					if g.res[i] > g.res[j] {
						let t = g.res[i];
						g.res[i] = g.res[j];
						g.res[j] = t;
					}
				}
			}
			start += sp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted nested history: ", g.n);
	out
}
@end
@entry 63c0cf6710da972a
kind: step
verb: join
noun: list
modifier: unique
context: filter
slot: pad int
phrase: join list unique elements inserting pad {pad}
phrase: interleave unique elements of list using pad {pad}
test: list=1,1,2,2,3 pad=0
expect: => i=3 r=0.0 ok=true s="unique elements joined: 3" errors=0 n=5 res=[1,0,2,0,3] cache=0 hits=0
test: list=5,5,8,8 pad=-1
expect: => i=2 r=0.0 ok=true s="unique elements joined: 2" errors=0 n=3 res=[5,-1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pad};
	var u = [0; 256];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
		}
		if !seen && un < 256 {
			u[un] = x;
			un++;
		}
	}
	g.n = 0;
	for i in un {
		if i > 0 && g.n < 512 {
			g.res[g.n] = p;
			g.n++;
		}
		if g.n < 512 {
			g.res[g.n] = u[i];
			g.n++;
		}
	}
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "unique elements joined: ", un);
	out
}
@end
@entry 59425a7ca24fb003
kind: step
verb: join
noun: threshold
modifier: any
context: filter
slot: cutoff int
phrase: join threshold any values crossing level {cutoff}
phrase: combine filtered elements passing threshold level {cutoff}
test: list=10,25,30,5,40 cutoff=20
expect: => i=95 r=0.0 ok=true s="threshold joined sum: 95" errors=0 n=4 res=[25,30,40,95] cache=0 hits=0
test: list=12,8,15,4 cutoff=10
expect: => i=27 r=0.0 ok=true s="threshold joined sum: 27" errors=0 n=3 res=[12,15,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= cut {
			sum += x;
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	if g.n < 512 {
		g.res[g.n] = sum;
		g.n++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "threshold joined sum: ", sum);
	out
}
@end
@entry 92db4607bcdc3514
kind: step
verb: repeat
noun: runs
modifier: unique
context: filter
slot: times int
phrase: repeat runs unique elements by factor {times}
phrase: duplicate unique run values by count {times}
test: list=2,2,3,4,4,5 times=2
expect: => i=4 r=0.0 ok=true s="unique values repeated: 4" errors=0 n=8 res=[2,3,4,5,2,3,4,5] cache=0 hits=0
test: list=10,10,20 times=3
expect: => i=2 r=0.0 ok=true s="unique values repeated: 2" errors=0 n=6 res=[10,20,10,20,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tm = ${times};
	var u = [0; 256];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
		}
		if !seen && un < 256 {
			u[un] = x;
			un++;
		}
	}
	g.n = 0;
	var r = 0;
	while r < tm {
		var i = 0;
		while i < un && g.n < 512 {
			g.res[g.n] = u[i];
			g.n++;
			i++;
		}
		r++;
	}
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "unique values repeated: ", un);
	out
}
@end
