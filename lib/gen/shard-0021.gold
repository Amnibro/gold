fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	let r = ${retries};
	var start = g.n - tl;
	if start < 0 { start = 0; }
	var pass = 0;
	while pass < r {
		var i = start;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
		pass++;
	}
	g.steps += g.n * r;
	out.i = pass;
	out.s.clear();
	format(out.s, "tail retries completed: ", pass);
	out
}
@end
