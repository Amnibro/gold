test: arg=312459,7531
expect: 12
expect: 7
test: arg=258
expect: 25
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var digits int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var left = 0;
	var right = len - 1;
	while left < right {
		let tmp = digits[left];
		digits[left] = digits[right];
		digits[right] = tmp;
		left++;
		right--;
	}
	var start = 0;
	var count = 1;
	var i = 1;
	while i < len {
		if digits[i] > digits[i - 1] {
			count++;
			if count >= 2 {
				start = i - count + 1;
				break;
			}
		} else {
			count = 1;
		}
		i++;
	}
	var res = 0;
	for j in count {
		res = res * 10 + digits[start + j];
	}
	res
}
@end
