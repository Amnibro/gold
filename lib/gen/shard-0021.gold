noun: middle
modifier: nested
context: stats
slot: depth int
phrase: cache middle nested sample element {depth}
phrase: store middle nested quantile value {depth}
test: list=10,20,30 depth=1
expect: => i=20 r=0.0 ok=true s="cached middle: 20" errors=0 n=3 res=[10,20,30] cache=1 hits=0
