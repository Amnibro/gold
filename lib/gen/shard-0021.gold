@entry 086d1060b279ae87
kind: step
verb: drop
noun: pairs
modifier: while
context: stats
slot: max_sum int
phrase: drop pairs while sum under {max_sum}
phrase: remove sample pairs while total below {max_sum}
test: list=2,3,4,5,10,12 max_sum=8
expect: => i=1 r=0.0 ok=true s="dropped pairs: 1" errors=0 n=4 res=[4,5,10,12] cache=0 hits=0
test: list=1,1,2,2 max_sum=5
expect: => i=2 r=0.0 ok=true s="dropped pairs: 2" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var offset = 0;
	while (offset + 1) < g.n {
		let s = g.res[offset] + g.res[offset + 1];
		if s <= ms {
			offset += 2;
		} else {
			break;
		}
	}
	let dropped_pairs = offset / 2;
	let remaining = g.n - offset;
	for i in remaining {
		g.res[i] = g.res[offset + i];
	}
	g.n = remaining;
	g.steps += g.n;
	out.i = dropped_pairs;
	out.s.clear();
	format(out.s, "dropped pairs: ", dropped_pairs);
	out
}
@end
@entry a1e134bebffdef0b
kind: step
verb: drop
noun: condition
modifier: safely
context: stats
slot: limit int
phrase: drop condition safely ceiling {limit}
phrase: remove sample outliers safely above {limit}
test: list=5,20,12,30 limit=15
expect: => i=2 r=0.0 ok=true s="safely dropped: 2" errors=0 n=2 res=[5,12] cache=0 hits=0
test: list=10,25 limit=20
expect: => i=1 r=0.0 ok=true s="safely dropped: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if x > lim && (g.n - dropped) > 1 {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "safely dropped: ", dropped);
	out
}
@end
@entry 85d41caa3b1790de
kind: step
verb: cache
noun: letters
modifier: each
context: stats
slot: max_count int
phrase: cache letters each unique entry {max_count}
phrase: store frequency letters each item {max_count}
test: list=65,66,67 max_count=2
expect: => i=2 r=0.0 ok=true s="letters cached: 2" errors=0 n=3 res=[65,66,67] cache=2 hits=0
test: list=10,20 max_count=3
expect: => i=2 r=0.0 ok=true s="letters cached: 2" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var cached = 0;
	for i in g.n {
		if cached < mc {
			gold_cache_put(g, i, g.res[i]);
			cached++;
		}
	}
	g.steps += cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "letters cached: ", cached);
	out
}
@end
