expect: => i=1 r=0.0 ok=true s="swapped primes in range 0 to 5" errors=0 n=6 res=[4,11,8,9,3,14] cache=0 hits=0
test: list=6,7,10,12,13,16 low=1 high=5
expect: => i=1 r=0.0 ok=true s="swapped primes in range 1 to 5" errors=0 n=6 res=[6,13,10,12,7,16] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var first_p = -1;
	var last_p = -1;
	for k in g.n {
		if k >= lo && k <= hi {
			if ${ID}_is_prime(g.res[k]) {
				if first_p == -1 { first_p = k; }
				last_p = k;
			}
		}
	}
	if first_p != -1 && last_p != -1 && first_p != last_p {
		let tmp = g.res[first_p];
		g.res[first_p] = g.res[last_p];
		g.res[last_p] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped primes in range ", lo, " to ", hi);
	out
}
@end
