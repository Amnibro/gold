@entry c19c5a0efae2fc8c
kind: step
verb: shift
noun: range
modifier: at_most
context: stats
slot: max_shift int
phrase: shift range at most bound {max_shift}
phrase: adjust sample range at most offset {max_shift}
test: list=10,15,20 max_shift=5
expect: => i=5 r=0.0 ok=true s="range shift: 5" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=8,12 max_shift=10
expect: => i=8 r=0.0 ok=true s="range shift: 8" errors=0 n=2 res=[0,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_shift};
	if g.n > 0 {
		var min_val = g.res[0];
		for i in g.n {
			if g.res[i] < min_val { min_val = g.res[i]; }
		}
		var sh = min_val;
		if sh > ms { sh = ms; }
		if sh < 0 { sh = 0; }
		for i in g.n {
			g.res[i] -= sh;
		}
		out.i = sh;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "range shift: ", out.i);
	out
}
@end
@entry fc9ce341a4e35cfc
kind: step
verb: split
noun: budget
modifier: up_to
context: stats
slot: budget int
phrase: split budget up to allocation {budget}
phrase: partition sample budget up to limit {budget}
test: list=10,20,30 budget=25
expect: => i=2 r=0.0 ok=true s="budget items: 2" errors=0 n=2 res=[10,15] cache=0 hits=0
test: list=5,5,5 budget=12
expect: => i=3 r=0.0 ok=true s="budget items: 3" errors=0 n=3 res=[5,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var rem = b;
	var kept = 0;
	for i in g.n {
		if g.res[i] <= rem {
			rem -= g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else if rem > 0 {
			g.res[kept] = rem;
			rem = 0;
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "budget items: ", kept);
	out
}
@end
@entry dc986073a280fdb6
kind: step
verb: sum
noun: gaps
modifier: all
context: stats
slot: stride int
phrase: sum gaps all across sample stride {stride}
phrase: total consecutive gaps all stride {stride}
test: list=2,5,10,6 stride=1
expect: => i=12 r=0.0 ok=true s="total gaps: 12" errors=0 n=4 res=[2,5,10,6] cache=0 hits=0
test: list=10,20 stride=1
expect: => i=10 r=0.0 ok=true s="total gaps: 10" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	var total_gap = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		total_gap += diff;
		i++;
	}
	g.steps += g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "total gaps: ", total_gap);
	out
}
@end
@entry 179c4caec2d2543d
kind: step
verb: drop
noun: number
modifier: while
context: stats
slot: threshold int
phrase: drop number while below threshold {threshold}
phrase: prune sample while under bound {threshold}
test: list=2,4,10,15 threshold=8
expect: => i=2 r=0.0 ok=true s="leading dropped: 2" errors=0 n=2 res=[10,15] cache=0 hits=0
test: list=1,3,5 threshold=2
expect: => i=1 r=0.0 ok=true s="leading dropped: 1" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var idx = 0;
	while idx < g.n && g.res[idx] < th {
		idx++;
	}
	let dropped = idx;
	let remaining = g.n - idx;
	for i in remaining {
		g.res[i] = g.res[idx + i];
	}
	g.n = remaining;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "leading dropped: ", dropped);
	out
}
@end
@entry b378cfcfe00dd80b
kind: step
verb: shift
noun: maximum
modifier: at_least
context: stats
slot: amount int
phrase: shift maximum at least decrement {amount}
phrase: reduce sample maximum at least step {amount}
test: list=10,25,18 amount=10
expect: => i=15 r=0.0 ok=true s="shifted maximum: 15" errors=0 n=3 res=[10,15,18] cache=0 hits=0
test: list=5,3 amount=2
expect: => i=3 r=0.0 ok=true s="shifted maximum: 3" errors=0 n=2 res=[3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let amt = ${amount};
	if g.n > 0 {
		var max_idx = 0;
		for i in g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
		}
		var new_val = g.res[max_idx] - amt;
		if new_val < 0 { new_val = 0; }
		g.res[max_idx] = new_val;
		out.i = new_val;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "shifted maximum: ", out.i);
	out
}
@end
@entry 8bd1bfa95ff84a84
kind: step
verb: sum
noun: sequence
modifier: between
context: stats
slot: low int
slot: high int
phrase: sum sequence between min {low} max {high}
phrase: total sample sequence between lower {low} upper {high}
test: list=5,10,15,20,25 low=10 high=20
expect: => i=45 r=0.0 ok=true s="sequence sum: 45" errors=0 n=5 res=[5,10,15,20,25] cache=0 hits=0
test: list=2,4,6 low=3 high=5
expect: => i=4 r=0.0 ok=true s="sequence sum: 4" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi { total += x; }
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sequence sum: ", total);
	out
}
@end
@entry 659ab66bdda61dac
kind: step
verb: fill
noun: duplicates
modifier: between
context: stats
slot: fill_val int
phrase: fill duplicates between slots with {fill_val}
phrase: overwrite sample duplicates between positions {fill_val}
test: list=2,3,2,5,3 fill_val=0
expect: => i=2 r=0.0 ok=true s="duplicates filled: 2" errors=0 n=5 res=[2,3,0,5,0] cache=0 hits=0
test: list=7,7 fill_val=-1
expect: => i=1 r=0.0 ok=true s="duplicates filled: 1" errors=0 n=2 res=[7,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fv = ${fill_val};
	var replaced = 0;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] {
				g.res[i] = fv;
				replaced++;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "duplicates filled: ", replaced);
	out
}
@end
