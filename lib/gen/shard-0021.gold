expect: => i=5 r=0.0 ok=true s="repeated loop up to 5 items" errors=0 n=5 res=[4,8,4,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n == 0 || c <= g.n { return out; }
	let orig_n = g.n;
	while g.n < c && g.n < 512 {
		let val = g.res[g.n % orig_n];
		gold_push(g, val);
	}
	g.steps += g.n - orig_n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated loop up to ", g.n, " items");
	out
}
@end
