@entry d0db93d7e9bc6eb8
kind: step
verb: rotate
noun: gaps
modifier: nested
context: retry
slot: max_gap int
phrase: rotate gaps nested difference ceiling {max_gap}
phrase: cycle retry gaps nested bound {max_gap}
test: list=2,10,11 max_gap=4
expect: => i=1 r=0.0 ok=false s="gap rotated: true" errors=0 n=3 res=[11,2,10] cache=0 hits=0
test: list=2,4,6 max_gap=3
expect: => i=0 r=0.0 ok=true s="gap rotated: false" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var large_gap = false;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > mg { large_gap = true; break; }
		i++;
	}
	if large_gap && g.n > 1 {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.ok = !large_gap;
	out.i = if large_gap { 1 } else { 0 };
	out.s.clear();
	format(out.s, "gap rotated: ", large_gap);
	out
}
@end
