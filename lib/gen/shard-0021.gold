noun: items
modifier: last
context: retry
slot: count int
phrase: rotate items last segment to front {count}
phrase: shift retry items last slice by {count}
test: list=1,2,3,4 count=1
expect: => i=1 r=0.0 ok=true s="rotated count: 1" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="rotated count: 2" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n > 1 && c > 0 {
		let k = c % g.n;
		var r = 0;
		while r < k {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
			r++;
		}
	}
	g.steps += g.n;
	out.i = c;
	out.s.clear();
	format(out.s, "rotated count: ", c);
	out
}
