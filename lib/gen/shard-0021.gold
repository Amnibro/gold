fn ${ID}(n int) int {
	let max_fixes = ${limit};
	var x = if n < 0 { -n } else { n };
	var digits int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var fixes = 0;
	var idx = len - 1;
	while idx >= 0 {
		if digits[idx] % 2 != 0 && fixes < max_fixes {
			digits[idx] = (digits[idx] + 1) % 10;
