		if g.res[k] % 2 != 0 {
			if g.res[k] < prev { ok = false; }
			prev = g.res[k];
		}
	}
	g.steps++;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "chk_odds_sorted");
	out
}
@end
