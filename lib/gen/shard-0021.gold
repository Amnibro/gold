test: list=1,2,3,4,5,6 modulus=2
expect: => i=2 r=0.0 ok=true s="grouped loop elements" errors=0 n=6 res=[2,4,6,1,3,5] cache=0 hits=0
test: list=10,11,12,13 modulus=3
expect: => i=3 r=0.0 ok=true s="grouped loop elements" errors=0 n=4 res=[12,10,13,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	if m <= 0 { gold_fail(g, "modulus must be positive"); out.ok = false; return out; }
	var tmp = [0; 512];
	var w = 0;
	for rem in m {
		for i in g.n {
			var r = g.res[i] % m;
			if r < 0 { r += m; }
			if r == rem {
				tmp[w] = g.res[i];
				w++;
			}
		}
	}
	for i in w { g.res[i] = tmp[i]; }
	g.steps += g.n * m;
	out.i = m;
	gold_text(out, "grouped loop elements");
	return out;
}
@end
