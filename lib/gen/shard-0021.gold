	let l = ${len};
	var k = l;
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed prefix: ", k);
	out
}
