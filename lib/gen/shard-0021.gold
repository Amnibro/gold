	for k in g.n {
		g.res[k] = ${step_fn}(g.res[k]);
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped list in reverse: ", g.n);
	out
}
