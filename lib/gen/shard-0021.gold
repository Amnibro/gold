code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var factors = 0;
		var d = 2;
		while d * d <= x {
			while x % d == 0 {
				factors++;
				x /= d;
			}
			d++;
		}
		if x > 1 { factors++; }
		g.res[k] = factors;
	}
	g.steps += g.n * 10;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked prime factors: ", g.n);
	out
}
@end
