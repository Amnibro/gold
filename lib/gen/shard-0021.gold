phrase: sort letters at least minimum code point {min_code}
phrase: order character code points at least {min_code}
test: list=99,97,65,100,66 min_code=90
expect: => i=3 r=0.0 ok=true s="sorted letters count: 3" errors=0 n=3 res=[97,99,100] cache=0 hits=0
test: list=80,65,90,70 min_code=75
expect: => i=2 r=0.0 ok=true s="sorted letters count: 2" errors=0 n=2 res=[80,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_code};
	var m = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= mc {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	var a = 0;
	while a < m {
		var b = a + 1;
		while b < m {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.n = m;
	g.steps += i + m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted letters count: ", m);
	out
}
@end
