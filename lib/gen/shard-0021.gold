	o.append("0.0");
	o.append("1,0.");
	o.append("03 r");
	o.append("0.0");
	o.append("08 - a");
	o.append("3:");
	gold_fnum(o, ${p});
	o.append(",0,0");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "rib");
	return out;
}
@end
