fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var sum = 0;
	var count = 0;
	while count < g.n && sum < th {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "selected sum: ", sum);
	out
}
@end
