phrase: rank item running counting elements greater than initial value
phrase: track running rank of items exceeding first element in math
test: list=5,2,8,1,9,5
expect: => i=2 r=0.0 ok=true s="items greater than base: 2" errors=0 n=6 res=[5,2,8,1,9,5] cache=0 hits=0
test: list=10,12,15,8,20
expect: => i=3 r=0.0 ok=true s="items greater than base: 3" errors=0 n=5 res=[10,12,15,8,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var greater = 0;
	if g.n > 1 {
		let base = g.res[0];
		var i = 1;
		while i < g.n {
			if g.res[i] > base {
				greater++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = greater;
	out.s.clear();
	format(out.s, "items greater than base: ", greater);
	out
}
@end
