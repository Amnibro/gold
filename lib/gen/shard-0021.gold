fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	if g.n <= mc {
		out.ok = true;
	} else {
		g.n = mc;
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "validated counter: ", g.n);
	out
}
