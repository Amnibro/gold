fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${block_size};
	let val = ${v};
	if bsz <= 0 { gold_fail(g, "invalid block size"); out.ok = false; return out; }
	var filled = 0;
	var i = 0;
	while i < g.n {
		let end = if i + bsz < g.n { i + bsz } else { g.n };
		let mid = i + (end - i) / 2;
		for k in mid..end {
			g.res[k] = val;
			filled++;
		}
		i += bsz;
	}
	g.steps += g.n;
	out.i = filled;
	gold_text(out, "filled nested items");
	return out;
}
