fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	var count = 0;
	while count < g.n && ${cond}(g.res[count]) {
		sum += g.res[count];
		count++;
	}
	if count > 0 {
		g.res[0] = sum;
		var w = 1;
		for i in count..g.n {
			g.res[w] = g.res[i];
			w++;
		}
		g.n = w;
	}
	out.i = sum;
	gold_text(out, "merged items while condition holds");
	return out;
}
@end
