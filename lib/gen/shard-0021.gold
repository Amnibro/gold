code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${min_total};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum < mt && g.n > 0 {
		let diff = mt - sum;
		g.res[g.n - 1] += diff;
		sum = mt;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "total ensured: ", sum);
	out
}
@end
