fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = out.i;
	let c, hit = gold_cache_get(g, k);
	if hit {
		out.i = c;
	} else {
		gold_cache_put(g, k, g.n);
		out.i = g.n;
	}
	g.steps++;
	out.s.clear();
	format(out.s, "meas_chk_cache");
	out
}
