@entry 7d9434e7ee783e0a
kind: step
verb: repeat
noun: window
modifier: running
context: math
slot: size int
phrase: repeat window running averages of size {size}
phrase: compute repeated running window averages of width {size}
test: list=10,20,30,40 size=2
expect: => i=3 r=0.0 ok=true s="window running results: 3" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=3,6,9,12,15 size=3
expect: => i=3 r=0.0 ok=true s="window running results: 3" errors=0 n=3 res=[6,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n < w {
		gold_fail(g, "repeat window running: window exceeds list length");
		out.ok = false;
		return out;
	}
	var count = g.n - w + 1;
	var i = 0;
	while i < count {
		var sum = 0;
		var j = 0;
		while j < w {
			sum += g.res[i + j];
			j++;
		}
		g.res[i] = sum / w;
		i++;
	}
	g.n = count;
	g.steps += count * w;
	out.i = count;
	out.s.clear();
	format(out.s, "window running results: ", count);
	out
}
