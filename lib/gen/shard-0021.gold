fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let first = g.res[0];
	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = first;
	out.s.clear();
	format(out.s, "rotated head element ", first);
	out
}
@end
@entry 51447bc77901e3d3
