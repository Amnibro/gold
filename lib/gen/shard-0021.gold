fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_steps = ${limit};
	if out.i <= 0 {
		gold_fail(g, "run cache: starting value non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "cache error");
		return out;
	}
	var k = 0;
	while out.i > 0 && k < max_steps {
		gold_push(g, out.i);
		out.i--;
		k++;
	}
	out.s.clear();
	format(out.s, "cache ran");
	out
}
@end
