code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_depth};
	var all_converged = true;
	for k in g.n {
		var x = g.res[k];
		var steps = 0;
		while x > 1 && steps < md {
			x = core_collatz(x);
			steps++;
		}
		if x != 1 {
			all_converged = false;
		}
	}
	g.steps += g.n * md;
	out.ok = all_converged;
	out.i = if all_converged { 1 } else { 0 };
	out.s.clear();
	format(out.s, "recursive step validation: ", out.i);
	out
}
@end
