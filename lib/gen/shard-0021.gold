expect: => i=20 r=0.0 ok=true s="merged history total: 20" errors=0 n=3 res=[5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n > lim { g.n = lim; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged history total: ", sum);
	out
}
@end
@entry 3c5d4d28efc4714a
kind: step
verb: measure
noun: threshold
modifier: times
context: list
slot: level int
phrase: measure threshold times level {level} crossed in list
phrase: count crossings to measure threshold times at {level}
test: list=5,15,8,22,3 level=10
expect: => i=4 r=0.0 ok=true s="threshold crossings: 4" errors=0 n=5 res=[5,15,8,22,3] cache=0 hits=0
test: list=2,4,6 level=20
expect: => i=0 r=0.0 ok=true s="threshold crossings: 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lvl = ${level};
	var crosses = 0;
	var k = 0;
	while k + 1 < g.n {
		let a = g.res[k];
		let b = g.res[k + 1];
		if (a < lvl && b >= lvl) || (a >= lvl && b < lvl) {
			crosses++;
		}
		k++;
	}
	g.steps += g.n;
	out.i = crosses;
	out.s.clear();
	format(out.s, "threshold crossings: ", crosses);
	out
}
@end
@entry 870381d7c2fef275
kind: step
verb: reverse
noun: minimum
modifier: nested
context: list
phrase: reverse minimum nested prefix up to smallest element
phrase: locate smallest element to reverse minimum nested prefix
test: list=10,20,5,30,40
expect: => i=3 r=0.0 ok=true s="reversed prefix length: 3" errors=0 n=5 res=[5,20,10,30,40] cache=0 hits=0
test: list=4,3,2,1
expect: => i=4 r=0.0 ok=true s="reversed prefix length: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_idx = 0;
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	var i = 0;
	var j = min_idx;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = min_idx + 1;
	out.s.clear();
	format(out.s, "reversed prefix length: ", out.i);
	out
}
@end
