@entry 302fa116cb51e970
kind: step
verb: sort
noun: runs
modifier: unique
context: math
phrase: sort runs unique lengths in ascending order
phrase: collect sorted unique run lengths from sequence
test: list=1,1,2,3,3,3,4,4
expect: => i=3 r=0.0 ok=true s="unique run lengths: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,5,9,9
expect: => i=2 r=0.0 ok=true s="unique run lengths: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var lens int[256] = [0; 256];
	var n_lens = 0;
	var cur = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
		} else {
			lens[n_lens] = cur;
			n_lens++;
			cur = 1;
		}
		i++;
	}
	lens[n_lens] = cur;
	n_lens++;
	var uniq int[256] = [0; 256];
	var n_uniq = 0;
	for k in n_lens {
		let l = lens[k];
		var exists = false;
		for u in n_uniq {
			if uniq[u] == l { exists = true; break; }
		}
		if !exists {
			uniq[n_uniq] = l;
			n_uniq++;
		}
	}
	var a = 0;
	while a < n_uniq {
		var b = a + 1;
		while b < n_uniq {
			if uniq[a] > uniq[b] {
				let tmp = uniq[a];
				uniq[a] = uniq[b];
				uniq[b] = tmp;
			}
			b++;
		}
		a++;
	}
	for k in n_uniq { g.res[k] = uniq[k]; }
	g.n = n_uniq;
	g.steps += i + n_uniq * n_uniq;
	out.i = n_uniq;
	out.s.clear();
	format(out.s, "unique run lengths: ", n_uniq);
	out
}
@end
@entry 37151b0a04898a96
kind: step
verb: clamp
noun: step
modifier: running
context: math
slot: max_step int
phrase: clamp step running deltas to bound {max_step}
phrase: limit running step transitions to maximum {max_step}
test: list=10,25,12,30 max_step=5
expect: => i=4 r=0.0 ok=true s="clamped running transitions: 4" errors=0 n=4 res=[10,15,12,17] cache=0 hits=0
test: list=0,20,5 max_step=8
expect: => i=3 r=0.0 ok=true s="clamped running transitions: 3" errors=0 n=3 res=[0,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	if g.n <= 1 || ms <= 0 { return out; }
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > ms {
			g.res[i] = g.res[i - 1] + ms;
		} else if diff < -ms {
			g.res[i] = g.res[i - 1] - ms;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped running transitions: ", g.n);
	out
}
@end
