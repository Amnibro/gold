fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let val, ok = gold_cache_get(g, 0);
	if ok {
		let tmp = g.res[0];
		g.res[0] = val;
		gold_cache_put(g, 0, tmp);
		out.i = 1;
	} else {
		gold_cache_put(g, 0, g.res[0]);
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swap list with cache hit: ", out.i);
	out
}
@end
