@entry 51974ddefe291ab6
kind: step
verb: rotate
noun: counter
modifier: sorted
context: retry
slot: shift int
phrase: rotate counter sorted elements by shift {shift}
phrase: cycle retry counter sorted list with shift {shift}
test: list=5,1,3 shift=1
expect: => i=1 r=0.0 ok=true s="rotated shift: 1" errors=0 n=3 res=[5,1,3] cache=0 hits=0
test: list=10,20,5,15 shift=2
expect: => i=2 r=0.0 ok=true s="rotated shift: 2" errors=0 n=4 res=[15,20,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	if g.n > 1 && sh > 0 {
		var k = 0;
		let s = sh % g.n;
		while k < s {
			let last = g.res[g.n - 1];
			var idx = g.n - 1;
			while idx > 0 {
				g.res[idx] = g.res[idx - 1];
				idx--;
			}
			g.res[0] = last;
			k++;
		}
	}
	g.steps += g.n;
	out.i = sh;
	out.s.clear();
	format(out.s, "rotated shift: ", sh);
	out
}
@end
