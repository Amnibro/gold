phrase: rotate condition at most until first value exceeds {th}
phrase: cyclically shift until head meets condition {th}
test: list=2,4,8,1 th=5
expect: => i=2 r=0.0 ok=true s="rotations performed: 2" errors=0 n=4 res=[8,1,2,4] cache=0 hits=0
test: list=10,3,7 th=5
expect: => i=0 r=0.0 ok=true s="rotations performed: 0" errors=0 n=3 res=[10,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${th};
	var rotations = 0;
	if g.n > 1 {
		while rotations < g.n && g.res[0] <= target {
			let first = g.res[0];
			var i = 0;
			while i + 1 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
			rotations++;
		}
	}
	g.steps += rotations * g.n;
	out.i = rotations;
	out.s.clear();
	format(out.s, "rotations performed: ", rotations);
	out
}
@end
