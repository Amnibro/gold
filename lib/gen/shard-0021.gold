phrase: restrict distinct items to cap {max_items}
slot: max_items int
test: list=1,2,2,3,3,4 max_items=2
expect: => i=2 r=0.0 ok=true s="limited list unique" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,5,6,7,7 max_items=3
expect: => i=3 r=0.0 ok=true s="limited list unique" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_items};
	if cap <= 0 { gold_fail(g, "invalid capacity"); out.ok = false; return out; }
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for k in w { if g.res[k] == x { seen = true; break; } }
		if !seen && w < cap {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	gold_text(out, "limited list unique");
	return out;
}
@end
