code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	var d = 0;
	var count = 0;
	while d < max_d && d < g.n {
		if g.res[d] > 0 { count++; }
		d++;
	}
	g.steps += max_d;
	out.i = count;
	out.s.clear();
	format(out.s, "recursive trace steps: ", count);
	out
}
@end
