phrase: order checkpoint elements safely bounded by {mark}
slot: mark int
test: list=9,3,7,1,5 mark=3
expect: => i=3 r=0.0 ok=true s="safely sorted checkpoint through 3" errors=0 n=5 res=[3,7,9,1,5] cache=0 hits=0
test: list=8,6,4,2,0 mark=4
expect: => i=4 r=0.0 ok=true s="safely sorted checkpoint through 4" errors=0 n=5 res=[2,4,6,8,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mark};
	let bound = if m < g.n { m } else { g.n };
	if bound > 1 {
		var i = 0;
		while i < bound - 1 {
			var j = 0;
			while j < bound - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "safely sorted checkpoint through ", bound);
	out
}
@end
@entry 71d117cb7030cfa7
kind: step
verb: fold
noun: window
modifier: last
context: filter
phrase: fold window over last {span} items
phrase: combine trailing window of size {span}
slot: span int
test: list=1,2,3,4,5,6 span=3
expect: => i=15 r=0.0 ok=true s="folded last window into sum 15" errors=0 n=4 res=[1,2,3,15] cache=0 hits=0
test: list=10,20,30,40 span=2
expect: => i=70 r=0.0 ok=true s="folded last window into sum 70" errors=0 n=3 res=[10,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if g.n == 0 || sp <= 0 { return out; }
	let count = if sp < g.n { sp } else { g.n };
	let start = g.n - count;
	var sum = 0;
	for i in start..g.n {
		sum += g.res[i];
	}
	g.n = start;
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded last window into sum ", sum);
	out
}
@end
