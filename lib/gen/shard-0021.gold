		var found = false;
		for j in count {
			if g.cv[j] == g.res[i] { found = true; break; }
		}
		if !found {
			gold_cache_put(g, count, g.res[i]);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "deduped history each");
	out
}
@end
