phrase: multiply all prime factors in retry interval
test: arg=12,25
expect: 7
expect: 10
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	if v <= 1 {
		return 0;
	}
	var sum = 0;
	var d = 2;
	while d * d <= v {
		while v % d == 0 {
			sum += d;
			v /= d;
		}
		d++;
	}
	if v > 1 {
		sum += v;
	}
	return sum;
}
@end
@entry 390093d681f1e1c9
kind: pred
