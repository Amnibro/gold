fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	if v == 0 {
		return 0;
	}
	var min_d = 9;
	while v > 0 {
		let d = v % 10;
		if d < min_d {
			min_d = d;
		}
		v /= 10;
	}
	return min_d;
}
