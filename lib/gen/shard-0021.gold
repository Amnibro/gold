	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var total = 0;
	for i in len { total += digits[i]; }
	var left_sum = 0;
	var split_idx = -1;
	var idx = len - 1;
	while idx > 0 {
		left_sum += digits[idx];
		let right_sum = total - left_sum;
		if left_sum == right_sum {
			split_idx = len - idx;
			break;
		}
		idx--;
	}
	split_idx
}
