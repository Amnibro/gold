fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${word_size};
	var words = 0;
	if ws > 0 {
		words = g.n / ws;
		if words > 1 {
			let last_offset = (words - 1) * ws;
			for k in ws {
				let tmp = g.res[k];
				g.res[k] = g.res[last_offset + k];
				g.res[last_offset + k] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = words;
	out.s.clear();
	format(out.s, "words rotated: ", words);
	out
}
@end
