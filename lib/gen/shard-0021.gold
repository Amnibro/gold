test: arg=10203,7700 ceil=3
expect: 3
expect: 2
test: arg=9999 ceil=1
expect: 1
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	let limit = ${ceil};
	var count = 0;
	while v > 0 {
		let d = v % 10;
		if d > 0 {
			count++;
		}
		v /= 10;
	}
	if count > limit {
		return limit;
	}
	return count;
}
@end
