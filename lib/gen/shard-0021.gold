code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cnt = 0;
	for k in g.n {
		if g.res[k] <= lim { cnt++; }
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "tally up to: ", cnt);
	out
}
@end
@entry fb833a8a8717623c
kind: step
verb: select
noun: range
modifier: first
context: list
slot: low int
slot: high int
phrase: select range first slice between {low} to {high}
phrase: filter select range first bounds {low} to {high}
test: list=5,15,25,8,30 low=10 high=25
expect: => i=2 r=0.0 ok=true s="selected range count: 2" errors=0 n=2 res=[15,25] cache=0 hits=0
test: list=1,2,3 low=10 high=20
expect: => i=0 r=0.0 ok=true s="selected range count: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected range count: ", kept);
	out
}
@end
@entry 6d0ccd7cd9e0d304
kind: step
verb: reverse
noun: gaps
modifier: nested
context: list
phrase: reverse gaps nested differences between adjacent list items
phrase: compute reverse gaps nested delta sequence in list
test: list=10,14,20,30
expect: => i=3 r=0.0 ok=true s="reversed gaps count: 3" errors=0 n=3 res=[10,6,4] cache=0 hits=0
test: list=5,15,10
expect: => i=2 r=0.0 ok=true s="reversed gaps count: 2" errors=0 n=2 res=[-5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var m = 0;
	var k = 1;
	while k < g.n {
		g.res[m] = g.res[k] - g.res[k - 1];
		m++;
		k++;
	}
	g.n = m;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed gaps count: ", g.n);
	out
}
@end
@entry 5fcd76dd0f859d4e
kind: step
verb: merge
noun: history
modifier: at_most
context: list
