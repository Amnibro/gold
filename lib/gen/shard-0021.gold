fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${r} <= 0.0 || ${h} <= 0.0 { gold_fail(g, "flatisland dimensions invalid"); out.ok = false; return out; }
	gold_dnews(g, "islandflat", "", o);
	o.append(" cyl 0,"); o.append("0,0 "); o.append("0,0,");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:matte ");
	gold_hex(o, 178, 158, 116);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "flatisland");
	out
}
@end
