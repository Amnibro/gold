fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	var sum = 0;
	var k = st;
	if k < 0 { k = 0; }
	while k < g.n {
		sum += g.res[k];
		k++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "scan tail all sum: ", sum);
	out
}
