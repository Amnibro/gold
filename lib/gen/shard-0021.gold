code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${key_offset};
	var total = 0;
	for i in g.n {
		let k = i + off;
		let val, ok = gold_cache_get(g, k);
		if ok {
			total += val;
		} else {
			gold_cache_put(g, k, g.res[i]);
			total += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "cached fold total: ", total);
	out
}
@end
