fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var total = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		total += x;
		g.res[kept] = x;
		kept++;
		if total >= thresh { break; }
	}
	g.n = kept;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded total: ", total);
	out
}
@end
