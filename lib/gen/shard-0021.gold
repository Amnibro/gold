fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var s = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if s + x > ms { break; }
		s += x;
		kept++;
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped running excess: ", dropped);
	out
}
@end
