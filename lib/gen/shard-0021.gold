expect: => i=1 r=0.0 ok=true s="series steps: 1" errors=0 n=4 res=[1,2,7,9] cache=0 hits=0
test: list=5,8,2,4 passes=2
expect: => i=2 r=0.0 ok=true s="series steps: 2" errors=0 n=4 res=[2,4,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var step = 0;
	while step < p && step < g.n {
		var min_idx = step;
		var j = step + 1;
		while j < g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
			j++;
		}
		if min_idx != step {
			let tmp = g.res[step];
			g.res[step] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		step++;
	}
	g.steps += g.n;
	out.i = step;
	out.s.clear();
	format(out.s, "series steps: ", step);
	out
}
@end
