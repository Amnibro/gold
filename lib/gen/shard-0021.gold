expect: => i=0 r=0.0 ok=true s="traced matches: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mark};
	var matches = 0;
	for i in g.n {
		if g.res[i] == m { matches++; }
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "traced matches: ", matches);
	out
}
@end
