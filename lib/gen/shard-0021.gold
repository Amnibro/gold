@entry 369db0054b04719d
kind: step
verb: apply
noun: primes
modifier: each
context: sort
phrase: sort apply primes each adding increment {add_val}
phrase: increment every prime entry in sorted sequence by {add_val}
slot: add_val int
test: list=2,4,5,6 add_val=1
expect: => i=2 r=0.0 ok=true s="incremented 2 primes" errors=0 n=4 res=[3,4,6,6] cache=0 hits=0
test: list=3,7,9 add_val=2
expect: => i=2 r=0.0 ok=true s="incremented 2 primes" errors=0 n=3 res=[5,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let inc = ${add_val};
	var modified = 0;
	for i in g.n {
		let val = g.res[i];
		var is_p = val >= 2;
		var d = 2;
		while d * d <= val {
			if val % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] += inc;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "incremented ", modified, " primes");
	out
}
@end
