@entry 2ff175984dc4b5d6
kind: step
verb: rotate
noun: head
modifier: all
context: math
phrase: rotate head all elements across list
phrase: cyclically rotate all head elements in list
test: list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="rotated head count: 2" errors=0 n=5 res=[20,10,30,40,50] cache=0 hits=0
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="rotated head count: 2" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let h = g.n / 2;
	if h > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < h {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[h - 1] = first;
	}
	g.steps += g.n;
	out.i = h;
	out.s.clear();
	format(out.s, "rotated head count: ", h);
	out
}
@end
@entry 74ea21ed79fd4788
kind: step
verb: trace
noun: step
modifier: all
context: math
phrase: trace step all cumulative differentials in math list
phrase: record all cumulative step variances across list
test: list=1,4,2,8
expect: => i=11 r=0.0 ok=true s="total step variance: 11" errors=0 n=4 res=[1,4,2,8] cache=0 hits=0
test: list=10,20,5
expect: => i=25 r=0.0 ok=true s="total step variance: 25" errors=0 n=3 res=[10,20,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			let d = g.res[i] - g.res[i - 1];
			total += if d < 0 { -d } else { d };
			i++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "total step variance: ", total);
	out
}
@end
@entry fe40dfb606d3045d
kind: step
verb: trace
noun: runs
modifier: each
context: math
phrase: trace runs each monotonic sequence length in list
phrase: record length of each monotonic run in sequence
test: list=1,2,5,3,4
expect: => i=2 r=0.0 ok=true s="monotonic runs detected: 2" errors=0 n=2 res=[3,2] cache=0 hits=0
test: list=5,4,3,2
expect: => i=4 r=0.0 ok=true s="monotonic runs detected: 4" errors=0 n=4 res=[1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run_lens int[256] = [0; 256];
	var num_runs = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			run_lens[num_runs] = cur_len;
			num_runs++;
			cur_len = 1;
		}
		i++;
	}
	run_lens[num_runs] = cur_len;
	num_runs++;
	for k in num_runs {
		g.res[k] = run_lens[k];
	}
	g.n = num_runs;
	g.steps += i;
	out.i = num_runs;
	out.s.clear();
	format(out.s, "monotonic runs detected: ", num_runs);
	out
}
@end
@entry f48d6d0d56e8e715
kind: step
verb: repeat
noun: errors
modifier: at_least
context: math
slot: min_errors int
phrase: repeat errors at least {min_errors} occurrences
phrase: verify error count at least {min_errors} threshold
test: min_errors=0
expect: => i=0 r=0.0 ok=true s="verified error count: 0" errors=0 n=0 res=[] cache=0 hits=0
test: min_errors=2
expect: => i=1 r=0.0 ok=false s="verified error count: 1" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_errors};
	if g.errors < req {
		gold_fail(g, "repeat errors at least: below minimum threshold");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps++;
	out.i = g.errors;
	out.s.clear();
	format(out.s, "verified error count: ", g.errors);
	out
}
@end
