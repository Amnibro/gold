code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 1 { gold_fail(g, "depth must be greater than 1"); out.ok = false; return out; }
	var w = 0;
	var dropped = 0;
	for i in g.n {
		if (i + 1) % d != 0 {
			g.res[w] = g.res[i];
			w++;
		} else {
			dropped++;
