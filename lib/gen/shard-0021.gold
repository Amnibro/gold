@entry 01e190693bb21cf5
kind: step
verb: filter
noun: tail
modifier: none
context: retry
slot: count int
phrase: filter tail none from retry buffer count {count}
phrase: prune tail errors none remaining count {count}
test: list=10,20,-1,-2 count=2
expect: => i=2 r=0.0 ok=true s="tail pruned: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,-3,8 count=1
expect: => i=0 r=0.0 ok=true s="tail pruned: 0" errors=0 n=3 res=[5,-3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var removed = 0;
	if c > 0 && g.n > 0 {
		var start = g.n - c;
		if start < 0 { start = 0; }
		var kept = 0;
		for i in g.n {
			if i >= start && g.res[i] < 0 {
				removed++;
			} else {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "tail pruned: ", removed);
	out
}
@end
