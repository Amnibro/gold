phrase: verify retry backoff is prime number
test: arg=7,9
expect: true
expect: false
test: arg=13
expect: true
code:
fn ${ID}(n int) bool {
	var v = n;
	if v <= 1 {
		return false;
	}
	if v == 2 || v == 3 {
		return true;
	}
	if v % 2 == 0 || v % 3 == 0 {
		return false;
	}
	var i = 5;
	while i * i <= v {
		if v % i == 0 || v % (i + 2) == 0 {
			return false;
		}
		i += 6;
	}
	return true;
}
@end
@entry 3189320b443dc946
