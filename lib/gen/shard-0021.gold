	var o byte[>..] = [];
	gold_dnews(g, "door", "", o);
	o.append(" box 0,0,");
	o.append("1 1.");
	o.append("2,0.");
	o.append("1,2 m:metal");
	gold_doc(g, o);
	var a byte[>..] = [];
	var last byte[>..] = [];
	gold_dlast(g, last);
	a.append(last);
	a.append(".loc anim linear 0:0,");
	a.append("0,1 ");
	gold_fnum(a, ${t} * 0.5);
	a.append(":1.2,");
	a.append("0,1 ");
	gold_fnum(a, ${t});
	a.append(":0,0,");
	a.append("1 loop");
	gold_doc(g, a);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "loopdoor");
	out
}
@end
