@entry 9f771b6c201b85e1
kind: step
verb: constrain
noun: foot
modifier: walking
context: char
phrase: constrain walking foot roll to {deg} degrees
phrase: clamp walking foot heel across {deg} degrees
slot: deg real
test: deg=25.0 doc="hip bone 0,0,1 0,0,1.4"
expect: => i=2 r=0.0 ok=true s="footcst" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: hip bone 0,0,1 0,0,1.4
expect: => doc: lim2 limitrot hip x0,25
test: deg=40.0 doc="body capsule 0,0,.5 0,0,1.3 r.35|armL bone .3,0,1.3 .8,0,1"
expect: => i=3 r=0.0 ok=true s="footcst" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: body capsule 0,0,.5 0,0,1.3 r.35
expect: => doc: armL bone .3,0,1.3 .8,0,1
expect: => doc: lim3 limitrot armL x0,40
test: deg=-5.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${deg} <= 0.0 || ${deg} > 180.0 { out.ok = false; return out; }
	gold_dnews(g, "lim", "", o);
	o.append(" limitrot ");
	o.append(last);
	o.append(" x0,");
	gold_fnum(o, ${deg});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "footcst");
	out
}
@end
