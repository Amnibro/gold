test: list=3,7 count=2
expect: => i=6 r=0.0 ok=true s="safely repeated total: 6" errors=0 n=6 res=[3,7,3,7,3,7] cache=0 hits=0
test: list=1,2,3 count=1
expect: => i=6 r=0.0 ok=true s="safely repeated total: 6" errors=0 n=6 res=[1,2,3,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 { return out; }
	let orig_n = g.n;
	if orig_n * (c + 1) > 512 {
		gold_fail(g, "repeat items safely: buffer overflow risk");
		out.ok = false;
		return out;
	}
	for rep in c {
		for k in orig_n {
			gold_push(g, g.res[k]);
		}
	}
	g.steps += orig_n * c;
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely repeated total: ", g.n);
	out
}
@end
