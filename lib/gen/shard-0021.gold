		}
	}
	for i in on {
		g.res[i] = odds[on - 1 - i];
	}
	g.steps += g.n + on;
	g.n = on;
	out.i = on;
	out.s.clear();
	format(out.s, "filtered ", on, " odd items in reverse");
	out
}
@end
@entry 6cedb9cd767e7ba3
