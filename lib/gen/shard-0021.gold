@entry 639b114b6bc6f03b
kind: step
verb: split
noun: minimum
modifier: unique
context: list
slot: parts int
phrase: split minimum unique value into partitions {parts}
phrase: divide smallest unique element by partition {parts}
phrase: subdivide lowest unique list item into {parts}
test: list=5,5,12,20 parts=2
expect: => i=12 r=0.0 ok=true s="split unique min: 12" errors=0 n=5 res=[5,5,6,20,6] cache=0 hits=0
test: list=10,10,30,40 parts=3
expect: => i=30 r=0.0 ok=true s="split unique min: 30" errors=0 n=5 res=[10,10,10,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	var min_idx = -1;
	var min_val = 10000000;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt == 1 && g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	if min_idx >= 0 && p > 1 {
		let q = min_val / p;
		g.res[min_idx] = q;
		gold_push(g, min_val - q);
		out.i = min_val;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "split unique min: ", out.i);
	out
}
@end
