				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted total: ", g.n);
	out
}
@end
