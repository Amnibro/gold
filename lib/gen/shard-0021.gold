@entry 65ceb05db66542e2
kind: step
verb: drop
noun: range
modifier: all
context: stats
slot: low int
slot: high int
phrase: drop range all spanning interval {low} to {high}
phrase: remove sample range all from {low} to {high}
test: list=5,12,18,25 low=10 high=20
expect: => i=2 r=0.0 ok=true s="range dropped: 2" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=2,8,15 low=5 high=10
expect: => i=1 r=0.0 ok=true s="range dropped: 1" errors=0 n=2 res=[2,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "range dropped: ", dropped);
	out
}
@end
