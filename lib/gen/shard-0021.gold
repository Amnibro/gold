code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch > 1 {
		var start = 0;
		while start < g.n {
			var end = start + ch;
			if end > g.n { end = g.n; }
			for i in start..end {
				for j in i + 1..end {
					if g.res[i] < g.res[j] {
						let t = g.res[i];
						g.res[i] = g.res[j];
						g.res[j] = t;
					}
				}
			}
			start += ch;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested items sorted: ", g.n);
	out
}
@end
@entry ac2ec5012d6ad8ef
kind: step
verb: fold
noun: odds
modifier: sorted
context: filter
slot: cutoff int
phrase: fold odds sorted above threshold {cutoff}
phrase: sum odd elements keeping sorted values over {cutoff}
test: list=15,4,9,2,21,7 cutoff=8
expect: => i=45 r=0.0 ok=true s="folded sorted odds: 45" errors=0 n=3 res=[9,15,21] cache=0 hits=0
test: list=11,13,6,1,25 cutoff=10
expect: => i=49 r=0.0 ok=true s="folded sorted odds: 49" errors=0 n=3 res=[11,13,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > cut {
			total += x;
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded sorted odds: ", total);
	out
}
@end
