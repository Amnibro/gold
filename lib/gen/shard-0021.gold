code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = -1;
	for i in g.n {
		if g.res[i] == ${k} {
			idx = i;
			break;
		}
	}
	out.i = idx;
	gold_text(out, "scanned items up to target");
	return out;
}
@end
@entry 16872cafb00fe67e
kind: step
verb: scale
noun: item
modifier: between
context: transform
phrase: scale items falling between bounds {lo} through {hi}
phrase: multiply elements situated between limits {lo} up to {hi}
slot: lo int
slot: hi int
test: list=5,15,25,35 lo=10 hi=30
expect: => i=2 r=0.0 ok=true s="scaled items between bounds" errors=0 n=4 res=[5,30,50,35] cache=0 hits=0
test: list=2,4,8,16 lo=3 hi=10
expect: => i=2 r=0.0 ok=true s="scaled items between bounds" errors=0 n=4 res=[2,8,16,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var scaled = 0;
	for i in g.n {
		if g.res[i] >= ${lo} && g.res[i] <= ${hi} {
			g.res[i] = g.res[i] * 2;
			scaled++;
		}
	}
	out.i = scaled;
	gold_text(out, "scaled items between bounds");
	return out;
}
@end
@entry 4f4104b2b238d30a
kind: step
verb: scan
noun: range
modifier: every_other
context: transform
phrase: scan range accumulating every other element value
phrase: inspect range stepping across every other index
test: list=2,4,6,8,10
expect: => i=18 r=0.0 ok=true s="scanned range every other" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,3,5,7,9
expect: => i=15 r=0.0 ok=true s="scanned range every other" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 2;
	}
	out.i = sum;
	gold_text(out, "scanned range every other");
	return out;
}
@end
@entry 34acdc070022bc3c
kind: step
verb: reverse
noun: spaces
modifier: at_most
context: transform
phrase: reverse elements spanning at most count {k}
phrase: invert sequence ordering at most prefix length {k}
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="reversed elements at most" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="reversed elements at most" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${k};
	if lim > g.n { lim = g.n; }
	if lim < 0 { lim = 0; }
	var left = 0;
	var right = lim - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = lim;
	gold_text(out, "reversed elements at most");
	return out;
}
@end
