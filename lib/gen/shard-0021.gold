@entry d47d434a118c50a4
kind: fn
verb: join
noun: steps
modifier: times
context: retry
phrase: join steps times retry multiplier {mult}
phrase: combine retry steps multiplied by {mult}
slot: mult int
test: arg=3,4 mult=2
expect: 12
expect: 20
test: arg=1 mult=5
expect: 5
code:
fn ${ID}(n int) int {
	let m = ${mult};
	var attempts = n;
	if attempts <= 0 {
		return 0;
	}
	if attempts > 20 {
		attempts = 20;
	}
	var total = 0;
	var step = 1;
	while step <= attempts {
		total += step * m;
		step++;
	}
	return total;
}
@end
