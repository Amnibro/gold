test: list=10,20,-3,-4 span=2
expect: => i=2 r=0.0 ok=true s="retried trailing errors: 2" errors=0 n=4 res=[10,20,3,4] cache=0 hits=0
test: list=5,15,25,-1 span=1
expect: => i=1 r=0.0 ok=true s="retried trailing errors: 1" errors=0 n=4 res=[5,15,25,1] cache=0 hits=0
test: list=10,20 span=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${span} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if ${span} > g.n {
		gold_fail(g, "span exceeds list size");
		out.ok = false;
		return out;
	}
	var fixed = 0;
	var i = g.n - ${span};
	while i < g.n {
		if g.res[i] < 0 {
			g.res[i] = 0 - g.res[i];
			fixed++;
		}
		i++;
	}
	g.steps += ${span};
	out.i = fixed;
	out.s.clear();
	format(out.s, "retried trailing errors: ", fixed);
	out
}
@end
@entry 0b7871a755e55dc2
kind: step
verb: count
noun: average
modifier: running
context: error
phrase: count average running deviations over {max_dev}
phrase: track running average violations exceeding {max_dev}
slot: max_dev int
test: list=10,12,30,11 max_dev=8
expect: => i=1 r=0.0 ok=true s="average violations: 1" errors=0 n=4 res=[10,12,30,11] cache=0 hits=0
test: list=20,22,50,21 max_dev=15
expect: => i=1 r=0.0 ok=true s="average violations: 1" errors=0 n=4 res=[20,22,50,21] cache=0 hits=0
test: list=10,20 max_dev=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${max_dev} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var sum = 0;
	var violations = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		let avg = sum / (i + 1);
		var dev = g.res[i] - avg;
		if dev < 0 { dev = 0 - dev; }
		if dev > ${max_dev} { violations++; }
		i++;
	}
	g.steps += g.n;
	out.i = violations;
	out.s.clear();
	format(out.s, "average violations: ", violations);
	out
}
@end
