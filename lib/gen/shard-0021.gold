kind: step
verb: dedupe
noun: limit
modifier: while
context: filter
phrase: dedupe elements while drop count under limit {limit}
phrase: eliminate duplicate values bounded by drop limit {limit}
slot: limit int
test: list=1,1,2,2,3,3,4 limit=2
expect: => i=2 r=0.0 ok=true s="deduped 2 items under limit" errors=0 n=5 res=[1,2,3,3,4] cache=0 hits=0
test: list=5,5,5,5,6,6 limit=3
expect: => i=3 r=0.0 ok=true s="deduped 3 items under limit" errors=0 n=3 res=[5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n <= 1 || lim <= 0 { return out; }
	var dropped = 0;
	var kept = 0;
	for i in g.n {
		var is_dup = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
		}
		if is_dup && dropped < lim {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped ", dropped, " items under limit");
	out
}
@end
