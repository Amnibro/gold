fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "series items in range: ", kept);
	out
}
@end
@entry c0af977e35659247
