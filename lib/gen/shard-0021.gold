fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		if x > th {
			for j in kept {
				if g.res[j] == x { seen = true; }
			}
		}
		if seen {
			removed++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped count: ", removed);
	out
}
@end
