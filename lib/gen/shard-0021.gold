code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_size};
	if g.n <= 1 { return out; }
	var m = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] - g.res[i - 1] == st {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered steps matching: ", m);
	out
}
@end
