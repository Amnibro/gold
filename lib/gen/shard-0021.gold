@entry 60040d918f0fdd49
kind: step
verb: apply
noun: gaps
modifier: with_retry
context: sort
phrase: sort apply gaps with retry budget {retries}
phrase: adjust adjacent intervals with retry allocation {retries}
slot: retries int
test: list=1,4,9,16 retries=2
expect: => i=3 r=0.0 ok=true s="computed 3 adjacent gaps" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=10,20,35 retries=1
expect: => i=2 r=0.0 ok=true s="computed 2 adjacent gaps" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n > 1 {
		var prev = g.res[0];
		for i in g.n - 1 {
			let cur = g.res[i + 1];
			g.res[i] = cur - prev;
			prev = cur;
		}
		g.n--;
	} else {
		gold_clear(g);
	}
	g.steps += r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed ", g.n, " adjacent gaps");
	out
}
@end
