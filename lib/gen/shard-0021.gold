		gold_fail(g, "window length exceeds list size");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < ${win_len} {
		sum += g.res[g.n - 1 - i];
		i++;
	}
	g.steps += ${win_len};
	out.i = sum;
	out.s.clear();
	format(out.s, "reverse window sum: ", sum);
	out
}
@end
@entry 82ba356783a8f5d7
kind: step
verb: reverse
noun: histogram
modifier: last
context: error
phrase: reverse histogram last frequency slots {bins}
phrase: invert order of last histogram bins {bins}
slot: bins int
test: list=1,2,3,4,5 bins=3
expect: => i=3 r=0.0 ok=true s="reversed histogram bins: 3" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 bins=2
expect: => i=2 r=0.0 ok=true s="reversed histogram bins: 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
test: list=1,2 bins=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${bins} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if ${bins} > g.n {
		gold_fail(g, "bins exceed results length");
		out.ok = false;
		return out;
	}
	var a = g.n - ${bins};
	var b = g.n - 1;
	while a < b {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		a++;
		b--;
	}
	g.steps += ${bins};
	out.i = ${bins};
	out.s.clear();
	format(out.s, "reversed histogram bins: ", ${bins});
	out
}
@end
