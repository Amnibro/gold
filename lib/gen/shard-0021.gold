	if matches == 0 {
		for i in g.n {
			let diff = if g.res[i] > tgt { g.res[i] - tgt } else { tgt - g.res[i] };
			if diff <= ret { matches++; }
		}
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "ranked series matches: ", matches);
	out
}
@end
@entry 44925877f8f4a806
kind: step
verb: dedupe
noun: streak
modifier: up_to
context: filter
slot: max_streak int
phrase: dedupe streak up to run limit {max_streak}
phrase: compress repeating streaks up to length {max_streak}
test: list=1,1,1,1,2,2,2,3 max_streak=2
expect: => i=5 r=0.0 ok=true s="compressed streaks kept: 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,6,6,7 max_streak=1
expect: => i=3 r=0.0 ok=true s="compressed streaks kept: 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		var count = j - i;
		if count > ms { count = ms; }
		for k in count {
			g.res[kept] = g.res[i];
			kept++;
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "compressed streaks kept: ", kept);
	out
}
@end
