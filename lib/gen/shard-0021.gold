@entry 70c66c4707e17f9e
kind: step
verb: find
noun: series
modifier: last
context: transform
phrase: find last arithmetic series sequence with difference {diff}
phrase: isolate last progressive series with step {diff}
slot: diff int
test: list=1,3,5,10,12 diff=2
expect: => i=3 r=0.0 ok=true s="found last series" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,5,8,1,4 diff=3
expect: => i=3 r=0.0 ok=true s="found last series" errors=0 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var best_start = -1;
	var best_len = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] - g.res[j - 1] == d { j++; }
		let cur_len = j - i;
		if cur_len >= 2 && cur_len >= best_len {
			best_start = i;
			best_len = cur_len;
		}
		i = if j > i + 1 { j - 1 } else { j };
	}
	if best_len >= 2 {
		for k in best_len { g.res[k] = g.res[best_start + k]; }
		g.n = best_len;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = best_len;
	gold_text(out, "found last series");
	return out;
}
@end
