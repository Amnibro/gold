code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${rad} <= 0.0 || ${span} <= 0.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var last_item byte[>..] = [];
	if !gold_dlast(g, last_item) { out.ok = false; return out; }
	gold_dnews(g, "tgt", "", obuf);
	obuf.append(" ik ");
	obuf.append(last_item);
	obuf.append(" ");
	gold_fnum(obuf, ${rad});
	obuf.append(",0,");
	gold_fnum(obuf, ${span});
	obuf.append(" n2");
	gold_doc(g, obuf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "chaintarget");
	out
}
@end
