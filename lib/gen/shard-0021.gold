code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	if g.cn > 0 {
		g.cv[g.cn - 1] *= f;
		out.i = g.cv[g.cn - 1];
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "scaled last cache entry by ", f);
	out
}
@end
@entry e22fb4a4c73a0679
kind: step
verb: map
noun: budget
modifier: until
context: aggregate
slot: budget int
phrase: map budget until total allocated reaches {budget}
phrase: distribute budget until reaching ceiling {budget}
test: list=10,20,30,40 budget=45
expect: => i=45 r=0.0 ok=true s="allocated 45 of budget 45" errors=0 n=4 res=[10,20,15,0] cache=0 hits=0
test: list=15,25,35 budget=30
expect: => i=30 r=0.0 ok=true s="allocated 30 of budget 30" errors=0 n=3 res=[15,15,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var rem = b;
	var allocated = 0;
	for k in g.n {
		if rem <= 0 {
			g.res[k] = 0;
		} else if g.res[k] <= rem {
			rem -= g.res[k];
			allocated += g.res[k];
		} else {
			g.res[k] = rem;
			allocated += rem;
			rem = 0;
		}
	}
	g.steps += g.n;
	out.i = allocated;
	out.s.clear();
	format(out.s, "allocated ", allocated, " of budget ", b);
	out
}
@end
