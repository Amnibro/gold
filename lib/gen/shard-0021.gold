@entry e66d39a77396d7d1
kind: step
verb: dedupe
noun: tally
modifier: in_place
context: math
phrase: dedupe tally in place recording item frequencies
phrase: compress duplicates in place with tally counts
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="duplicates removed: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="duplicates removed: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < m {
			if g.res[j] == x {
				exists = true;
				break;
			}
			j++;
		}
		if !exists {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	let dupes = g.n - m;
	g.n = m;
	g.steps += i * m;
	out.i = dupes;
	out.s.clear();
	format(out.s, "duplicates removed: ", dupes);
	out
}
@end
