expect: => i=50 r=0.0 ok=true s="maximum window sum: 50" errors=0 n=5 res=[10,20,5,15,30] cache=0 hits=0
test: list=4,8,16,32 win_size=2
expect: => i=48 r=0.0 ok=true s="maximum window sum: 48" errors=0 n=4 res=[4,8,16,32] cache=0 hits=0
test: list=10,20 win_size=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${win_size} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if ${win_size} > g.n {
		gold_fail(g, "window size exceeds results");
		out.ok = false;
		return out;
	}
	var max_sum = 0;
	var i = 0;
	while i + ${win_size} <= g.n {
		var sum = 0;
		var j = 0;
		while j < ${win_size} {
			sum += g.res[i + j];
			j++;
		}
		if sum > max_sum { max_sum = sum; }
		i++;
	}
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "maximum window sum: ", max_sum);
	out
}
@end
@entry adb00c25528e88c0
kind: step
verb: merge
noun: condition
modifier: recursively
context: error
phrase: merge condition recursively under sum bound {bound}
phrase: collapse adjacent elements recursively while below {bound}
slot: bound int
test: list=2,3,4,5 bound=8
expect: => i=1 r=0.0 ok=true s="recursive condition merges: 1" errors=0 n=3 res=[5,4,5] cache=0 hits=0
test: list=1,1,2,2 bound=5
expect: => i=2 r=0.0 ok=true s="recursive condition merges: 2" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=1,2 bound=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${bound} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var merges = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] < ${bound} {
			g.res[i] = g.res[i] + g.res[i + 1];
			var j = i + 1;
			while j + 1 < g.n {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.n--;
			merges++;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = merges;
	out.s.clear();
	format(out.s, "recursive condition merges: ", merges);
	out
}
@end
