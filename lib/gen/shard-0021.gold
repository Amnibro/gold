code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var w = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			var esum = g.res[i];
			while i + 1 < g.n && g.res[i + 1] % 2 == 0 {
				i++;
				esum += g.res[i];
			}
			g.res[w] = esum;
			w++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	out.i = w;
	gold_text(out, "merged evens in place");
	return out;
}
@end
