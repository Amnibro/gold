fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 10 && x <= 50 {
			g.res[count] = x;
			count++;
		}
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "keep_runs_between");
	out
}
