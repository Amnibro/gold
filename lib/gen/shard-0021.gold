expect: => i=2 r=0.0 ok=true s="cached middle items: 2" errors=0 n=4 res=[1,2,3,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let mid = g.n / 2;
	var st = mid - sp / 2;
	if st < 0 { st = 0; }
	var en = st + sp;
	if en > g.n { en = g.n; }
	var cached = 0;
	var i = st;
	while i < en {
		gold_cache_put(g, i, g.res[i]);
		cached++;
		i++;
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "cached middle items: ", cached);
	out
}
@end
@entry b5a22f08a73edb00
kind: step
verb: limit
noun: steps
modifier: between
context: list
slot: max_diff int
phrase: limit steps between adjacent bounds {max_diff}
phrase: cap consecutive differences under step {max_diff}
phrase: bound adjacent step differences to {max_diff}
test: list=10,50,60,100 max_diff=15
expect: => i=3 r=0.0 ok=true s="adjusted steps count: 3" errors=0 n=4 res=[10,25,40,55] cache=0 hits=0
test: list=5,25,30 max_diff=10
expect: => i=2 r=0.0 ok=true s="adjusted steps count: 2" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var adjusted = 0;
	var i = 1;
	while i < g.n {
		let prev = g.res[i - 1];
		let diff = g.res[i] - prev;
		if diff > md {
			g.res[i] = prev + md;
			adjusted++;
		} else if diff < -md {
			g.res[i] = prev - md;
			adjusted++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted steps count: ", adjusted);
	out
}
@end
