@entry 71a765a2daee7d73
kind: step
verb: fold
noun: list
modifier: times
context: math
slot: rounds int
phrase: fold list times repeating sum reduction {rounds} iterations
phrase: reduce list folding adjacent sums {rounds} iterations
test: list=1,2,3,4 rounds=1
expect: => i=2 r=0.0 ok=true s="folded list count: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,2,3,4 rounds=2
expect: => i=1 r=0.0 ok=true s="folded list count: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var rep = 0;
	while rep < r && g.n > 1 {
		var m = 0;
		var i = 0;
		while i + 1 < g.n {
			g.res[m] = g.res[i] + g.res[i + 1];
			m++;
			i += 2;
		}
		if i < g.n {
			g.res[m] = g.res[i];
			m++;
		}
		g.n = m;
		rep++;
	}
	g.steps += rep * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "folded list count: ", g.n);
	out
}
@end
