@entry 20fd9244d52dc724
kind: step
verb: select
noun: subfunction
modifier: sorted
context: list
phrase: select items by subfunction {sub} sorted
phrase: filter results using subfunction {sub} in sorted order
slot: sub fn
test: list=4,1,3 sub=double
expect: => i=3 r=0.0 ok=true s="sorted 3 items by subfunction" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=10,2,8 sub=inc
expect: => i=3 r=0.0 ok=true s="sorted 3 items by subfunction" errors=0 n=3 res=[2,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < g.n {
		let key = g.res[i];
		let key_val = ${sub}(key);
		var j = i - 1;
		while j >= 0 && ${sub}(g.res[j]) > key_val {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
		i++;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items by subfunction");
	out
}
@end
