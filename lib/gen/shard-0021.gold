expect: => i=2 r=0.0 ok=true s="odds dropped: 2" errors=0 n=3 res=[2,4,5] cache=0 hits=0
test: list=7,8 max_drop=1
expect: => i=1 r=0.0 ok=true s="odds dropped: 1" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_drop};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && dropped < md {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "odds dropped: ", dropped);
	out
}
@end
@entry 2d53cab9c0ea1045
kind: step
verb: cache
noun: maximum
modifier: sorted
context: stats
slot: k int
phrase: cache maximum sorted sample count {k}
phrase: store maximum sorted distribution slot {k}
test: list=7,2,15,4 k=1
expect: => i=15 r=0.0 ok=true s="cached maximum: 15" errors=0 n=4 res=[2,4,7,15] cache=1 hits=0
test: list=20,8,12 k=1
expect: => i=20 r=0.0 ok=true s="cached maximum: 20" errors=0 n=3 res=[8,12,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var max_val = 0;
	if g.n > 0 { max_val = g.res[g.n - 1]; }
	gold_cache_put(g, 0, max_val);
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "cached maximum: ", max_val);
	out
}
@end
