@entry 421768c253a85bcf
kind: step
verb: dedupe
noun: evens
modifier: safely
context: filter
phrase: dedupe even values safely leaving odds untouched
phrase: remove duplicate even numbers preserving odd entries
test: list=2,3,2,4,5,4,6
expect: => i=5 r=0.0 ok=true s="safely deduped evens to 5 items" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=10,1,10,2,20,20
expect: => i=4 r=0.0 ok=true s="safely deduped evens to 4 items" errors=0 n=4 res=[10,1,2,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		if val % 2 == 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == val {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[kept] = val;
				kept++;
			}
		} else {
			g.res[kept] = val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "safely deduped evens to ", kept, " items");
	out
}
@end
@entry 8096d0bc3f2657a5
kind: step
verb: sort
noun: errors
modifier: nested
context: filter
phrase: sort error values moving negative numbers forward
phrase: partition negative errors ascending before positive items
test: list=10,-5,20,-2,-8
expect: => i=3 r=0.0 ok=true s="sorted 3 negative error items forward" errors=0 n=5 res=[-8,-5,-2,10,20] cache=0 hits=0
test: list=4,-1,3,-7,0
expect: => i=2 r=0.0 ok=true s="sorted 2 negative error items forward" errors=0 n=5 res=[-7,-1,4,3,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var neg = [0; 256];
	var pos = [0; 256];
	var nn = 0;
	var pn = 0;
	for i in g.n {
		if g.res[i] < 0 && nn < 256 {
			neg[nn] = g.res[i];
			nn++;
		} else if pn < 256 {
			pos[pn] = g.res[i];
			pn++;
		}
	}
	if nn > 1 {
		var i = 0;
		while i < nn - 1 {
			var j = 0;
			while j < nn - 1 - i {
				if neg[j] > neg[j + 1] {
					let tmp = neg[j];
					neg[j] = neg[j + 1];
					neg[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	for i in nn { g.res[i] = neg[i]; }
	for i in pn { g.res[nn + i] = pos[i]; }
	g.steps += g.n * 2;
	out.i = nn;
	out.s.clear();
	format(out.s, "sorted ", nn, " negative error items forward");
	out
}
@end
