code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let f = ${factor};
	let sp = if c > g.n { g.n } else { c };
	let start = g.n - sp;
	var i = start;
	while i < g.n {
		g.res[i] *= f;
		i++;
	}
	g.steps += sp;
	out.i = sp;
	out.s.clear();
	format(out.s, "scaled ", sp, " suffix items");
	out
}
@end
@entry 8286630c7c681aaa
