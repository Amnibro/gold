slot: cap int
test: arg=1987,5432 cap=50
expect: 1507
expect: 5432
test: arg=9871,6543 cap=30
expect: 9301
expect: 6303
code:
fn ${ID}(n int) int {
	let c = ${cap};
	var x = if n < 0 { -n } else { n };
	if x < 100 { return x; }
	let last = x % 10;
	var temp = x / 10;
	var mult = 1;
	while temp >= 10 {
		mult *= 10;
		temp /= 10;
	}
	let first = temp;
	let mid = (x / 10) % mult;
	let capped_mid = if mid > c { c } else { mid };
	(first * mult * 10) + (capped_mid * 10) + last
}
@end
