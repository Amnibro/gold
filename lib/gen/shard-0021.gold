expect: => i=25 r=0.0 ok=true s="cached middle: 25" errors=0 n=4 res=[5,15,25,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var mid_val = 0;
	if g.n > 0 {
		let mid_idx = g.n / 2;
		mid_val = g.res[mid_idx];
		gold_cache_put(g, 0, mid_val);
	}
	g.steps += 1;
