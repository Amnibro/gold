@entry 9c2d59a60e2b436c
kind: step
verb: swap
noun: window
modifier: while
context: list
phrase: swap window elements while above {threshold}
phrase: exchange adjacent items in window while exceeding {threshold}
slot: threshold int
test: list=10,8,4,2 threshold=5
expect: => i=1 r=0.0 ok=true s="swapped 1 window pairs" errors=0 n=4 res=[8,10,4,2] cache=0 hits=0
test: list=3,15,12,2 threshold=10
expect: => i=1 r=0.0 ok=true s="swapped 1 window pairs" errors=0 n=4 res=[3,12,15,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var swapped = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > th && g.res[i + 1] > th {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " window pairs");
	out
}
@end
