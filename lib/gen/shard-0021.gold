@entry 6811d833ba44b2b5
kind: step
verb: retry
noun: suffix
modifier: at_most
context: list
phrase: retry suffix scan at most {max_tries} times for {target}
phrase: repeat suffix search at most {max_tries} seeking {target}
slot: max_tries int
slot: target int
test: list=4,5,6 max_tries=3 target=6
expect: => i=1 r=0.0 ok=true s="suffix matched target on try 1" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=1,2,3 max_tries=2 target=9
expect: => i=0 r=0.0 ok=false s="suffix failed to match target" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tries};
	let tgt = ${target};
	var found = false;
	var tries = 0;
	while tries < mt {
		tries++;
		if g.n > 0 && g.res[g.n - 1] == tgt {
			found = true;
			break;
		}
	}
	g.steps += tries;
	if found {
		out.ok = true;
		out.i = tries;
		out.s.clear();
		format(out.s, "suffix matched target on try ", tries);
	} else {
		out.ok = false;
		g.errors++;
		out.s.clear();
		format(out.s, "suffix failed to match target");
	}
	out
}
@end
