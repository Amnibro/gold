	let d = ${div};
	if d != 0 {
		for i in g.n {
			g.res[i] /= d;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized count: ", g.n);
	out
}
@end
