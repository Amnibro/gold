context: list
phrase: scale items while remaining budget over {budget} by {factor}
phrase: multiply sequence values while budget exceeds {budget} with {factor}
slot: budget int
slot: factor int
test: list=2,3,4,5 budget=5 factor=2
expect: => i=2 r=0.0 ok=true s="scaled 2 items within budget" errors=0 n=4 res=[4,6,4,5] cache=0 hits=0
