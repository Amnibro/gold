fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${max_probes} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var probes = 0;
	var i = 0;
	while i < g.n && probes < ${max_probes} {
		let val, hit = gold_cache_get(g, g.res[i]);
		if !hit { gold_cache_put(g, g.res[i], i); }
		probes++;
		i++;
	}
	g.steps += probes;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "active cache entries: ", g.cn);
	out
}
@end
