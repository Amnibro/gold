expect: => i=1 r=0.0 ok=true s="dropped squares: 1" errors=0 n=2 res=[2,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x > b && x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped squares: ", dropped);
	out
}
@end
