fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	var limit = k;
	if limit > g.n { limit = g.n; }
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var is_uniq = 1;
	var i = 0;
	while i + 1 < limit {
		if g.res[i] == g.res[i + 1] {
			is_uniq = 0;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.i = is_uniq;
	out.s.clear();
	format(out.s, "prefix unique: ", is_uniq);
	out
}
@end
