phrase: invert streak sequence between bounds {low} through {high}
test: list=10,20,30,40,50 low=1 high=3
expect: => i=3 r=0.0 ok=true s="reversed streak of 3 elements" errors=0 n=5 res=[10,40,30,20,50] cache=0 hits=0
test: list=5,15,25,35,45,55 low=2 high=4
expect: => i=3 r=0.0 ok=true s="reversed streak of 3 elements" errors=0 n=6 res=[5,15,45,35,25,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo < 0 || hi >= g.n || lo >= hi { return out; }
	let span = hi - lo + 1;
	for k in span / 2 {
		let tmp = g.res[lo + k];
		g.res[lo + k] = g.res[hi - k];
		g.res[hi - k] = tmp;
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed streak of ", span, " elements");
	out
}
@end
