fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${step_cap};
	var inv = 0;
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] { inv++; }
			j++;
		}
	}
	g.steps += if inv < sc { inv } else { sc };
	out.i = inv;
	out.s.clear();
	format(out.s, "tallied ", inv, " nested inversions");
	out
}
@end
