phrase: execute recursive checkpoint smoothing for {rounds} passes
slot: rounds int
test: list=2,6,10,14 rounds=1
expect: => i=3 r=0.0 ok=true s="ran recursive checkpoint" errors=0 n=3 res=[4,8,12] cache=0 hits=0
test: list=10,20,30,40 rounds=2
expect: => i=2 r=0.0 ok=true s="ran recursive checkpoint" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if r <= 0 { gold_fail(g, "invalid rounds"); out.ok = false; return out; }
	for pass in r {
		if g.n >= 2 {
			for i in (g.n - 1) {
				g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
			}
			g.n--;
		}
	}
	g.steps += r * g.n;
	out.i = g.n;
	gold_text(out, "ran recursive checkpoint");
	return out;
}
@end
