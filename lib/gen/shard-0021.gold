	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var max_len = 1;
	var cur_len = 1;
	var last = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur >= last {
			cur_len++;
		} else {
			if cur_len > max_len { max_len = cur_len; }
			cur_len = 1;
		}
		last = cur;
		x /= 10;
	}
	if cur_len > max_len { max_len = cur_len; }
	if max_len > lim { lim } else { max_len }
}
@end
