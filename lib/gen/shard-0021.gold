expect: => i=2 r=0.0 ok=true s="kept sorted: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 cutoff=10
expect: => i=1 r=0.0 ok=true s="kept sorted: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var kept = 0;
	while kept < g.n && g.res[kept] < cut {
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept sorted: ", kept);
	out
}
@end
