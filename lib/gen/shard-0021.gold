code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var splits = 0;
	let orig_n = g.n;
	for i in orig_n {
		let x = g.res[i];
		if x >= t {
			let h = x / 2;
			g.res[i] = h;
			gold_push(g, x - h);
			splits++;
		}
	}
	g.steps += orig_n;
	out.i = splits;
	out.s.clear();
	format(out.s, "elements split: ", splits);
	out
}
@end
