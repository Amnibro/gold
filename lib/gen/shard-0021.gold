fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gt = ${gap_threshold};
	var cut = g.n;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] > gt {
			cut = i + 1;
			break;
		}
		i++;
	}
	g.n = cut;
