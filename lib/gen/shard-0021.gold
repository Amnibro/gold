@entry 1f9a58b959ff6ef8
kind: pred
verb: check
noun: runs
modifier: until
context: aggregate
phrase: check runs until aggregate threshold {threshold}
phrase: test consecutive run length up to {threshold}
slot: threshold int
test: arg=1112,1234 threshold=3
expect: true
expect: false
test: arg=5522,9999 threshold=4
expect: false
expect: true
code:
fn ${ID}(n int) bool {
	let th = ${threshold};
	var x = if n < 0 { -n } else { n };
	var max_run = 0;
	var cur_run = 1;
	var last = -1;
	while x > 0 {
		let d = x % 10;
		if d == last {
			cur_run++;
		} else {
			if cur_run > max_run { max_run = cur_run; }
			cur_run = 1;
			last = d;
		}
		x /= 10;
	}
	if cur_run > max_run { max_run = cur_run; }
	max_run >= th
}
@end
