@entry 95ba144cd752efff
kind: step
verb: check
noun: pairs
modifier: safely
context: list
phrase: check pairs safely with maximum difference {max_diff}
phrase: verify adjacent pair differences safely bounded by {max_diff}
slot: max_diff int
test: list=2,4,7,9 max_diff=3
expect: => i=0 r=0.0 ok=true s="all pair differences within 3" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=2,10,12 max_diff=5
expect: => i=0 r=0.0 ok=false s="pair difference exceeded 5" errors=1 n=3 res=[2,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var ok_pairs = true;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i] > g.res[i + 1] { g.res[i] - g.res[i + 1] } else { g.res[i + 1] - g.res[i] };
		if diff > md {
			ok_pairs = false;
			break;
		}
		i++;
	}
	g.steps += g.n;
	if ok_pairs {
		out.ok = true;
		out.s.clear();
		format(out.s, "all pair differences within ", md);
	} else {
		out.ok = false;
		g.errors++;
		out.s.clear();
		format(out.s, "pair difference exceeded ", md);
	}
	out
}
@end
@entry 24b1c6171ea30815
kind: step
verb: check
noun: histogram
modifier: every_other
context: list
phrase: check histogram of every other element under {max_count}
phrase: verify alternating item histogram counts bounded by {max_count}
slot: max_count int
test: list=1,9,1,8,1 max_count=2
expect: => i=0 r=0.0 ok=false s="alternating histogram count exceeded 2" errors=1 n=5 res=[1,9,1,8,1] cache=0 hits=0
test: list=1,9,2,8,3 max_count=2
expect: => i=0 r=0.0 ok=true s="alternating histogram counts within limit" errors=0 n=5 res=[1,9,2,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var exceeded = false;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var cnt = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == x { cnt++; }
			j += 2;
		}
		if cnt > mc {
			exceeded = true;
			break;
		}
		i += 2;
	}
	g.steps += g.n;
	if exceeded {
		out.ok = false;
		g.errors++;
		out.s.clear();
		format(out.s, "alternating histogram count exceeded ", mc);
	} else {
		out.ok = true;
		out.s.clear();
		format(out.s, "alternating histogram counts within limit");
	}
	out
}
@end
