code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped loop values: ", kept);
	out
}
@end
@entry 8c8ceb24d8f293a7
kind: step
verb: rank
noun: function
modifier: with_cache
context: filter
slot: base int
phrase: rank function with cache offset {base}
phrase: score filtered items using cache ranking base {base}
test: list=2,4,6 base=10
expect: => i=120 r=0.0 ok=true s="ranked cached score: 120" errors=0 n=3 res=[2,4,6] cache=3 hits=0
test: list=3,5 base=20
expect: => i=160 r=0.0 ok=true s="ranked cached score: 160" errors=0 n=2 res=[3,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var score = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			score += val;
		} else {
			let calc = k * b;
			gold_cache_put(g, k, calc);
			score += calc;
		}
	}
	g.steps += g.n;
	out.i = score;
	out.s.clear();
	format(out.s, "ranked cached score: ", score);
	out
}
@end
@entry fcda5893c5c7a2a0
kind: step
verb: join
noun: checkpoint
modifier: while
context: filter
slot: mark int
phrase: join checkpoint while values stay under {mark}
phrase: insert checkpoint marker {mark} while list continues
test: list=5,8,12 mark=10
expect: => i=5 r=0.0 ok=true s="joined checkpoint list: 5" errors=0 n=5 res=[5,10,8,10,12] cache=0 hits=0
test: list=2,4,6,15 mark=8
expect: => i=7 r=0.0 ok=true s="joined checkpoint list: 7" errors=0 n=7 res=[2,8,4,8,6,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mark};
	var orig = [0; 512];
	let old_n = g.n;
	for i in old_n { orig[i] = g.res[i]; }
	g.n = 0;
	for i in old_n {
		if orig[i] < m && g.n < 512 {
			g.res[g.n] = orig[i];
			g.n++;
			if g.n < 512 {
				g.res[g.n] = m;
				g.n++;
			}
		} else if g.n < 512 {
			g.res[g.n] = orig[i];
			g.n++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined checkpoint list: ", g.n);
	out
}
@end
