@entry 16b70db2487bdddf
kind: step
verb: shift
noun: runs
modifier: up_to
context: transform
phrase: shift consecutive runs by {shift} up to bound {cap}
phrase: offset identical sequence runs by {shift} up to maximum {cap}
slot: shift int
slot: cap int
test: list=2,2,5,7,7,7 shift=3 cap=8
expect: => i=5 r=0.0 ok=true s="shifted runs up to cap" errors=0 n=6 res=[5,5,5,8,8,8] cache=0 hits=0
test: list=1,1,1,4 shift=5 cap=10
expect: => i=3 r=0.0 ok=true s="shifted runs up to cap" errors=0 n=4 res=[6,6,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	let limit = ${cap};
	var shifted = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= 2 {
			for k in i..j {
				let nv = g.res[k] + sh;
				g.res[k] = if nv > limit { limit } else { nv };
				shifted++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	out.i = shifted;
	gold_text(out, "shifted runs up to cap");
	return out;
}
@end
