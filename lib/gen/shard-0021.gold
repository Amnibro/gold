expect: => i=9 r=0.0 ok=true s="scanned condition across 3 passes total matches 9" errors=0 n=4 res=[3,-2,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var total_matches = 0;
	for pass in t {
		for k in g.n {
			if g.res[k] > 0 {
				total_matches++;
			}
		}
	}
	g.steps += g.n * t;
	out.i = total_matches;
	out.s.clear();
	format(out.s, "scanned condition across ", t, " passes total matches ", total_matches);
	out
}
@end
