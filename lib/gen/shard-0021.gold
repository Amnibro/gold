fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_streak = 0;
	var cur_streak = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 0;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak ", max_streak, " items");
	out
}
@end
