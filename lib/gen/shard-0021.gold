@entry 574e2275730d5e7e
kind: step
verb: weather
noun: fabric
modifier: tiled
context: texture
phrase: weather fabric tiled surface using seed {u}
phrase: generate tiled fabric layer with seed {u}
slot: u int
model: worley c=4 u=${u}; blur; contrast a=1.15
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="fabric" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.186 max=0.783 sum8=27631 hash=494026
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="fabric" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.164 max=0.838 sum8=106941 hash=223260
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.15 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "fabric");
	out
}
@end
@entry 84ef668caabe6d9d
kind: step
verb: weather
noun: metal
modifier: smooth
context: texture
phrase: weather smooth metal texture with seed {u}
phrase: render smooth metal pattern from seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; threshold a=0.44; blur
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="metal" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=56099 hash=777781
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="metal" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=150450 hash=145178
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.44 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "metal");
	out
}
@end
