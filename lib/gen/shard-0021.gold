kind: step
verb: group
noun: limit
modifier: at_least
context: list
slot: chunk_size int
phrase: group limit at least holding size {chunk_size}
phrase: partition list chunks at least reaching {chunk_size}
phrase: cluster list items at least of size {chunk_size}
test: list=1,2,3,4,5,6 chunk_size=2
expect: => i=3 r=0.0 ok=true s="grouped into chunks: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
