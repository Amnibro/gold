expect: => doc: thigh bone 0.15,0,1 0.15,0,0.5 ^hip
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${deg} < -90.0 || ${deg} > 90.0 || ${deg} == 0.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var bname byte[>..] = [];
	if !gold_dlast(g, bname) { out.ok = false; return out; }
	obuf.append(bname);
	obuf.append(".rot anim 0:0,");
	obuf.append("0,0 ");
	obuf.append("1:0,");
	gold_fnum(obuf, ${deg});
	obuf.append(",0");
	gold_doc(g, obuf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "bendleg");
	out
}
@end
@entry 335e9010cd01831e
kind: step
verb: twist
noun: bone
modifier: walking
context: char
slot: twist_ang real
slot: pace real
phrase: twist bone walking alternation of {twist_ang} degrees pacing {pace}
phrase: apply walking twist rotation {twist_ang} with duration {pace}
test: twist_ang=14.0 pace=1.2 doc="pelvis bone 0,0,0.9 0,0,1.1"
expect: => i=2 r=0.0 ok=true s="twistbone" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: pelvis bone 0,0,0.9 0,0,1.1
expect: => doc: pelvis.rot anim 0:0,0,0 0.6:0,0,14 1.2:0,0,-14 loop
test: twist_ang=22.0 pace=1.6 doc="ground box 0,0,-.5 20,20,1|pelvis bone 0,0,0.9 0,0,1.1"
expect: => i=3 r=0.0 ok=true s="twistbone" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: pelvis bone 0,0,0.9 0,0,1.1
expect: => doc: pelvis.rot anim 0:0,0,0 0.8:0,0,22 1.6:0,0,-22 loop
test: twist_ang=0.0 pace=1.2 doc="pelvis bone 0,0,0.9 0,0,1.1"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: pelvis bone 0,0,0.9 0,0,1.1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${twist_ang} <= 0.0 || ${pace} <= 0.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var bname byte[>..] = [];
	if !gold_dlast(g, bname) { out.ok = false; return out; }
	obuf.append(bname);
	obuf.append(".rot anim 0:0,");
	obuf.append("0,0 ");
	gold_fnum(obuf, ${pace} * 0.5);
	obuf.append(":0,0,");
	gold_fnum(obuf, ${twist_ang});
	obuf.append(" ");
	gold_fnum(obuf, ${pace});
	obuf.append(":0,0,-");
	gold_fnum(obuf, ${twist_ang});
	obuf.append(" loop");
	gold_doc(g, obuf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "twistbone");
	out
}
@end
