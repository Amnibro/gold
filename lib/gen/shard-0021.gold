	var i = start;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
		i++;
	}
	if !sorted {
		var a = start;
		while a < g.n {
			var b = a + 1;
			while b < g.n {
				if g.res[b] < g.res[a] {
					let tmp = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = tmp;
				}
				b++;
			}
			a++;
		}
	}
	g.steps += g.n;
	out.i = if sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "history sorted: ", out.i);
	out
}
@end
