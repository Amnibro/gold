fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = ${k};
	if len > g.n { len = g.n; }
	if len < 0 { len = 0; }
	var left = 0;
	var right = len - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = len;
	gold_text(out, "reversed prefix up to count");
	return out;
}
@end
