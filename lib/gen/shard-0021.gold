code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	var sz = w;
	if sz > g.n { sz = g.n; }
	if sz < 0 { sz = 0; }
	var i = 0;
	while i < sz {
		var j = i + 1;
		while j < sz {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var max_val = 0;
	if sz > 0 { max_val = g.res[sz - 1]; }
	g.steps += sz;
	out.i = max_val;
	out.s.clear();
	format(out.s, "window max: ", max_val);
	out
}
@end
@entry 02ba5b8accf31a3d
kind: step
verb: dedupe
noun: tally
modifier: up_to
context: retry
slot: max_tally int
phrase: dedupe tally up to occurrence ceiling {max_tally}
phrase: restrict tally duplicates up to limit {max_tally}
test: list=1,1,1,2,2 max_tally=2
expect: => i=1 r=0.0 ok=true s="tally dropped: 1" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=3,3,3,3 max_tally=1
expect: => i=3 r=0.0 ok=true s="tally dropped: 3" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tally};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in kept {
			if g.res[j] == x { count++; }
		}
		if count < mt {
			g.res[kept] = x;
			kept++;
		} else {
			dropped++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "tally dropped: ", dropped);
	out
}
@end
@entry faf127a33ef849fa
