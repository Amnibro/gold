fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	g.steps += g.n * 2;
	out.i = g.n;
	gold_text(out, "grouped function sorted");
	return out;
}
