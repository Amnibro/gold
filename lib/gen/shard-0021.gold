	for k in g.n {
		let d = ((g.res[k] % 10) + 10) % 10;
		counts[d]++;
	}
	let shift = if b <= 0 { 0 } else { b % 10 };
	var rotated int[10] = [0; 10];
	for d in 10 {
		rotated[(d + shift) % 10] = counts[d];
	}
	for d in 10 {
		if d < g.n { g.res[d] = rotated[d]; }
	}
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "histogram rotated bins: ", shift);
	out
}
