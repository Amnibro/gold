@entry 5fff984496d46e79
kind: step
verb: compare
noun: tail
modifier: sorted
context: transform
phrase: compare sorted tail of length {k}
phrase: evaluate trailing {k} items after sorting
slot: k int
test: list=9,2,7,4,5 k=3
expect: => i=3 r=0.0 ok=true s="compared tail sorted" errors=0 n=3 res=[5,7,9] cache=0 hits=0
test: list=10,1,30,20 k=2
expect: => i=2 r=0.0 ok=true s="compared tail sorted" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let start = if g.n > count { g.n - count } else { 0 };
	let w = g.n - start;
	for i in w { g.res[i] = g.res[start + i]; }
	g.n = w;
	g.steps += g.n * 2;
	out.i = w;
	gold_text(out, "compared tail sorted");
	return out;
}
@end
