@entry b7aeb11564718240
kind: step
verb: check
noun: step
modifier: with_cache
context: error
phrase: check step with_cache lookup key {key}
phrase: verify step execution against cached key {key}
slot: key int
test: list=10,20 key=5
expect: => i=0 r=0.0 ok=true s="cache miss for key: 5" errors=0 n=2 res=[10,20] cache=1 hits=0
test: list=30,40 key=8
expect: => i=0 r=0.0 ok=true s="cache miss for key: 8" errors=0 n=2 res=[30,40] cache=1 hits=0
test: list=10,20 key=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${key} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	let val, hit = gold_cache_get(g, ${key});
	if !hit {
		gold_cache_put(g, ${key}, 1);
		out.i = 0;
		out.s.clear();
		format(out.s, "cache miss for key: ", ${key});
	} else {
		out.i = val;
		out.s.clear();
		format(out.s, "cache hit for key: ", ${key});
	}
	g.steps++;
	out
}
@end
