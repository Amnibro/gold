@entry 5d85c8505a7b3cf6
kind: step
verb: rotate
noun: minimum
modifier: each
context: retry
slot: stride int
phrase: rotate minimum each position to head stride {stride}
phrase: place minimum each cycle to front stride {stride}
test: list=8,4,2,6 stride=1
expect: => i=2 r=0.0 ok=true s="minimum to front: 2" errors=0 n=4 res=[2,8,4,6] cache=0 hits=0
test: list=15,3,9 stride=1
expect: => i=3 r=0.0 ok=true s="minimum to front: 3" errors=0 n=3 res=[3,15,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if g.n > 1 {
		var min_idx = 0;
		for i in g.n {
			if g.res[i] < g.res[min_idx] {
				min_idx = i;
			}
		}
		let min_val = g.res[min_idx];
		var j = min_idx;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = min_val;
		out.i = min_val;
	} else if g.n == 1 {
		out.i = g.res[0];
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "minimum to front: ", out.i);
	out
}
@end
