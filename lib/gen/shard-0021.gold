@entry d0f10e80c721d570
kind: step
verb: reverse
noun: steps
modifier: recursively
context: sort
slot: span int
phrase: reverse steps recursively by block span {span}
phrase: chunked reverse steps recursively interval {span}
test: list=1,2,3,4,5,6 span=3
expect: => i=2 r=0.0 ok=true s="reversed step blocks: 2" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 span=2
expect: => i=2 r=0.0 ok=true s="reversed step blocks: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var blocks = 0;
	var start = 0;
	while start < g.n {
		var end = start + sp - 1;
		if end >= g.n { end = g.n - 1; }
		var i = start;
		var j = end;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		blocks++;
		start += sp;
	}
	g.steps += g.n;
	out.i = blocks;
	out.s.clear();
	format(out.s, "reversed step blocks: ", blocks);
	out
}
@end
