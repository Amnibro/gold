@entry 8731eff7acc13945
kind: step
verb: cache
noun: counter
modifier: until
context: sort
phrase: sort cache counter until reaching threshold {limit}
phrase: store frequency counts in cache until threshold {limit}
slot: limit int
test: list=1,1,2,2,3,3 limit=2
expect: => i=2 r=0.0 ok=true s="cached 2 frequency entries" errors=0 n=6 res=[1,1,2,2,3,3] cache=2 hits=0
test: list=4,4,5,6 limit=1
expect: => i=1 r=0.0 ok=true s="cached 1 frequency entries" errors=0 n=4 res=[4,4,5,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cached = 0;
	var i = 0;
	while i < g.n && cached < lim {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		gold_cache_put(g, g.res[i], freq);
		cached++;
		i = j;
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " frequency entries");
	out
}
@end
@entry b8470c5b40290902
kind: step
verb: apply
noun: window
modifier: all
context: sort
phrase: sort apply window all averaging width {wsize}
phrase: smooth all sorted entries across sliding window {wsize}
slot: wsize int
test: list=1,2,3,4,5 wsize=3
expect: => i=3 r=0.0 ok=true s="generated 3 window sums" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=2,4,6,8 wsize=2
expect: => i=3 r=0.0 ok=true s="generated 3 window sums" errors=0 n=3 res=[6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = if ${wsize} > 0 { ${wsize} } else { 1 };
	if g.n >= ws {
		var new_n = g.n - ws + 1;
		var buf int[512] = [0; 512];
		for i in new_n {
			var sum = 0;
			for k in ws { sum += g.res[i + k]; }
			buf[i] = sum;
		}
		gold_clear(g);
		for i in new_n { gold_push(g, buf[i]); }
	} else {
		gold_clear(g);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "generated ", g.n, " window sums");
	out
}
@end
