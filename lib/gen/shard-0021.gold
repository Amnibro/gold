code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var steps = 0;
	while x >= 10 && steps < 10 {
		var s = 0;
		while x > 0 { s += x % 10; x /= 10; }
		x = s;
		steps++;
	}
	x
}
@end
