phrase: cluster items into groups up to sum {max_sum}
test: list=10,15,20,5,30 max_sum=30
expect: => i=3 r=0.0 ok=true s="buckets formed: 3" errors=0 n=3 res=[25,25,30] cache=0 hits=0
test: list=5,5,5,12 max_sum=15
expect: => i=2 r=0.0 ok=true s="buckets formed: 2" errors=0 n=2 res=[15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	if g.n == 0 { return out; }
	var buckets = 0;
	var cur_sum = 0;
	for i in g.n {
		let x = g.res[i];
		if cur_sum + x > ms && cur_sum > 0 {
			g.res[buckets] = cur_sum;
			buckets++;
			cur_sum = x;
		} else {
			cur_sum += x;
		}
	}
	if cur_sum > 0 {
		g.res[buckets] = cur_sum;
		buckets++;
	}
	g.n = buckets;
	g.steps += g.n;
	out.i = buckets;
	out.s.clear();
	format(out.s, "buckets formed: ", buckets);
	out
}
@end
