@entry 2cacc316daabc40d
kind: step
verb: sum
noun: duplicates
modifier: in_reverse
context: error
phrase: sum duplicates in reverse direction
phrase: collect duplicate values in reverse
test: input=4 list=1,4,2,4,4
expect: => i=12 r=0.0 ok=true s="duplicates summed" errors=0 n=5 res=[1,4,2,4,4] cache=0 hits=0
test: input=7 list=1,2,3
expect: => i=7 r=0.0 ok=false s="no duplicates" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] == out.i {
			count++;
		}
		idx--;
	}
	if count == 0 {
		gold_fail(g, "sum duplicates: target not found");
		out.ok = false;
		out.s.clear();
		format(out.s, "no duplicates");
		return out;
	}
	out.i = count * out.i;
	out.s.clear();
	format(out.s, "duplicates summed");
	out
}
@end
