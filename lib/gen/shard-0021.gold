@entry 6e4f313fb7986326
kind: step
verb: validate
noun: sequence
modifier: last
context: filter
slot: min_len int
phrase: validate sequence last suffix meeting length {min_len}
phrase: confirm trailing sequence passes minimum length {min_len}
test: list=10,5,2,4,6,8 min_len=3
expect: => i=4 r=0.0 ok=true s="validated trailing length: 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=20,1,3,7 min_len=2
expect: => i=3 r=0.0 ok=true s="validated trailing length: 3" errors=0 n=3 res=[1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var run = 1;
	var i = g.n - 1;
	while i > 0 && g.res[i] > g.res[i - 1] {
		run++;
		i--;
	}
	if run >= ml {
		var k = 0;
		while i < g.n {
			g.res[k] = g.res[i];
			k++;
			i++;
		}
		g.n = k;
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "validated trailing length: ", g.n);
	out
}
@end
