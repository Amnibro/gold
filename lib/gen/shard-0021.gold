fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let mid_val = g.res[g.n / 2];
	let cached_rank, hit = gold_cache_get(g, mid_val);
	if hit {
		out.i = cached_rank;
	} else {
		var count = 0;
		for k in g.n {
			if g.res[k] <= mid_val { count++; }
		}
		gold_cache_put(g, mid_val, count);
		out.i = count;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "middle rank: ", out.i);
	out
}
@end
