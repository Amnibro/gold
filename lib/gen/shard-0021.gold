expect: => i=30 r=0.0 ok=true s="tail matched 30" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,10,15 expected=20
expect: => i=15 r=0.0 ok=false s="tail mismatch expected 20 got 15" errors=1 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	if g.n == 0 {
		g.errors++;
		out.ok = false;
		out.s.clear();
		format(out.s, "list empty for tail check");
		return out;
	}
	let last_val = g.res[g.n - 1];
	out.i = last_val;
	if last_val != exp {
		g.errors++;
		out.ok = false;
		out.s.clear();
		format(out.s, "tail mismatch expected ", exp, " got ", last_val);
	} else {
		out.s.clear();
		format(out.s, "tail matched ", exp);
	}
	out
}
@end
