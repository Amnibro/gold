test: list=2,2,3,4 passes=1
expect: => i=1 r=0.0 ok=true s="nested duplicates shifted: 1" errors=0 n=4 res=[2,3,4,2] cache=0 hits=0
test: list=1,2,3,3 passes=1
expect: => i=1 r=0.0 ok=true s="nested duplicates shifted: 1" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var dupes = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			let dup_val = g.res[i];
			var j = i;
			while j < g.n - 1 {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.res[g.n - 1] = dup_val;
			dupes++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = dupes;
	out.s.clear();
	format(out.s, "nested duplicates shifted: ", dupes);
	out
}
@end
