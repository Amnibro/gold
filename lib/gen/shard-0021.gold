@entry 6b89c8128e56b48e
kind: step
verb: sort
noun: streak
modifier: sorted
context: retry
slot: min_len int
phrase: sort streak sorted segments exceeding {min_len}
phrase: arrange streak sorted runs above length {min_len}
test: list=1,3,5,2 min_len=3
expect: => i=3 r=0.0 ok=true s="initial streak: 3" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
test: list=4,2,7 min_len=2
expect: => i=1 r=0.0 ok=true s="initial streak: 1" errors=0 n=3 res=[4,2,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var streak = 1;
	if g.n == 0 { streak = 0; }
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			streak++;
		} else {
			break;
		}
		i++;
	}
	if streak >= ml {
		var a = 0;
		while a < g.n {
			var b = a + 1;
			while b < g.n {
				if g.res[b] < g.res[a] {
					let tmp = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = tmp;
				}
				b++;
			}
			a++;
		}
	}
	g.steps += g.n;
	out.i = streak;
	out.s.clear();
	format(out.s, "initial streak: ", streak);
	out
}
@end
