code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var primes = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_prime(x) {
			g.res[k] *= m;
			primes++;
		}
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "scaled prime count: ", primes);
	out
}
@end
