expect: => i=0 r=0.0 ok=true s="merged prefix up to budget 0" errors=0 n=2 res=[12,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bg = ${max_budget};
	var sum = 0;
	var count = 0;
	while count < g.n && sum + g.res[count] <= bg {
		sum += g.res[count];
		count++;
	}
	g.steps += count;
	if count > 1 {
		g.res[0] = sum;
		var w = 1;
		var i = count;
		while i < g.n {
			g.res[w] = g.res[i];
			w++;
			i++;
		}
		g.n = w;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "merged prefix up to budget ", sum);
	out
}
@end
