@entry 6f119b69b3f01d7d
kind: step
verb: retry
noun: total
modifier: between
context: sort
slot: low int
slot: high int
phrase: retry total between limits low {low} high {high}
phrase: bound sorted retry total between {low} through {high}
test: list=8,2,5,1,10 low=5 high=12
expect: => i=8 r=0.0 ok=true s="retry total: 8" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=4,3,2 low=1 high=6
expect: => i=5 r=0.0 ok=true s="retry total: 5" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var total = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if total + x <= hi {
			g.res[kept] = x;
			total += x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "retry total: ", total);
	out
}
@end
