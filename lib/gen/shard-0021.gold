fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	var recovered = 0;
	while g.errors > 0 && recovered < mr {
		g.errors--;
		recovered++;
	}
	g.steps += recovered;
	out.i = recovered;
	out.s.clear();
	format(out.s, "cleared ", recovered, " previous errors");
	out
}
