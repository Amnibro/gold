context: error
phrase: keep odds at_most limit of {max_keep}
phrase: retain odd values at_most count {max_keep}
slot: max_keep int
test: list=1,2,3,4,5,7 max_keep=2
expect: => i=2 r=0.0 ok=true s="kept odds count: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=3,5,9,11 max_keep=3
expect: => i=3 r=0.0 ok=true s="kept odds count: 3" errors=0 n=3 res=[3,5,9] cache=0 hits=0
test: list=1,2,3 max_keep=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${max_keep} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var kept = 0;
	var new_n = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			if kept < ${max_keep} {
				g.res[new_n] = g.res[i];
				new_n++;
				kept++;
			}
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		i++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept odds count: ", kept);
	out
}
@end
@entry 67f28768fa4b5077
kind: step
verb: merge
noun: tail
modifier: running
context: error
phrase: merge tail running sum across length {tail_len}
phrase: collapse tail results into running sum of {tail_len}
slot: tail_len int
test: list=10,20,30,40 tail_len=2
expect: => i=70 r=0.0 ok=true s="merged tail sum: 70" errors=0 n=3 res=[10,20,70] cache=0 hits=0
test: list=5,15,25,35,45 tail_len=3
expect: => i=105 r=0.0 ok=true s="merged tail sum: 105" errors=0 n=3 res=[5,15,105] cache=0 hits=0
test: list=10,20 tail_len=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${tail_len} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if ${tail_len} > g.n {
		gold_fail(g, "tail length exceeds list size");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = g.n - ${tail_len};
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.n = g.n - ${tail_len};
	gold_push(g, sum);
	g.steps += ${tail_len};
	out.i = sum;
	out.s.clear();
	format(out.s, "merged tail sum: ", sum);
	out
}
@end
