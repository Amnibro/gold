fn ${ID}(n int) int {
	let f = ${factor};
	var x = if n < 0 { -n } else { n };
	var max_diff = 0;
	while x >= 10 {
		let a = x % 10;
		let b = (x / 10) % 10;
		let diff = if a >= b { a - b } else { b - a };
