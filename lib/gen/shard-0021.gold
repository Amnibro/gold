kind: step
verb: compare
noun: primes
modifier: all
context: sort
phrase: sort compare primes all matching count against {target}
phrase: verify total prime entries in sorted set against {target}
slot: target int
test: list=2,3,5,8,9 target=3
expect: => i=3 r=0.0 ok=true s="counted 3 primes" errors=0 n=5 res=[2,3,5,8,9] cache=0 hits=0
test: list=1,4,6,8 target=1
expect: => i=0 r=0.0 ok=false s="counted 0 primes" errors=0 n=4 res=[1,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var primes = 0;
	for i in g.n {
		let val = g.res[i];
		var is_p = val >= 2;
		var d = 2;
		while d * d <= val {
			if val % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { primes++; }
	}
	out.i = primes;
	out.ok = primes == tgt;
	out.s.clear();
	format(out.s, "counted ", primes, " primes");
	out
}
@end
@entry 9a5bd47a0f0be74c
kind: step
verb: group
noun: duplicates
modifier: first
context: sort
phrase: sort group duplicates first up to size {max_group}
phrase: cluster repeated values at head of sorted results within {max_group}
slot: max_group int
test: list=1,2,2,3,3,3,4 max_group=4
expect: => i=4 r=0.0 ok=true s="grouped 4 duplicate items" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=5,5,6,7,8 max_group=3
expect: => i=2 r=0.0 ok=true s="grouped 2 duplicate items" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_group};
	var kept = 0;
	var i = 0;
	while i < g.n && kept < mg {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let cnt = j - i;
		if cnt > 1 {
			var k = 0;
			while k < cnt && kept < mg {
				g.res[kept] = g.res[i];
				kept++;
				k++;
			}
		}
		i = j;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " duplicate items");
	out
}
@end
@entry 0aaf79320e7b2191
kind: step
verb: compare
noun: spaces
modifier: at_least
context: sort
phrase: sort compare spaces at least separating elements by {min_gap}
phrase: verify minimum spacing across sorted array is at least {min_gap}
slot: min_gap int
test: list=2,5,9,14 min_gap=3
expect: => i=3 r=0.0 ok=true s="min gap was 3" errors=0 n=4 res=[2,5,9,14] cache=0 hits=0
test: list=1,2,5,8 min_gap=3
expect: => i=1 r=0.0 ok=false s="min gap was 1" errors=0 n=4 res=[1,2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var ok_gap = true;
	var min_found = 999999;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff < min_found { min_found = diff; }
		if diff < mg { ok_gap = false; }
		i++;
	}
	if g.n <= 1 { min_found = 0; }
	out.i = min_found;
	out.ok = ok_gap;
	out.s.clear();
	format(out.s, "min gap was ", min_found);
	out
}
@end
@entry cc1ede4d6ca0d9c1
kind: step
verb: group
noun: spaces
modifier: sorted
context: sort
phrase: sort group spaces sorted into intervals of size {bucket}
phrase: partition sorted values into interval spans of {bucket}
slot: bucket int
test: list=2,5,11,14,21 bucket=10
expect: => i=3 r=0.0 ok=true s="partitioned into 3 buckets" errors=0 n=5 res=[2,5,11,14,21] cache=0 hits=0
test: list=1,2,3 bucket=5
expect: => i=1 r=0.0 ok=true s="partitioned into 1 buckets" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = if ${bucket} > 0 { ${bucket} } else { 1 };
	var buckets = 0;
	var last_b = -1;
	for i in g.n {
		let b = g.res[i] / bsize;
		if b != last_b {
			buckets++;
			last_b = b;
		}
	}
	out.i = buckets;
	out.s.clear();
