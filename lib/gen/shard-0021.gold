verb: constrain
noun: clip
modifier: chained
context: char
slot: offset real
phrase: constrain clip chained animation keyframe offset by {offset} seconds
phrase: apply chained clip timing offset {offset} to motion track
test: offset=0.5 doc="leg bone 0.1,0,0.8 0.1,0,0.2"
expect: => i=2 r=0.0 ok=true s="conclip" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: leg bone 0.1,0,0.8 0.1,0,0.2
expect: => doc: leg.rot anim 0.5:0,0,0 1.5:20,0,0 loop
test: offset=0.8 doc="ground box 0,0,-.5 20,20,1|leg bone 0.1,0,0.8 0.1,0,0.2"
expect: => i=3 r=0.0 ok=true s="conclip" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: leg bone 0.1,0,0.8 0.1,0,0.2
expect: => doc: leg.rot anim 0.8:0,0,0 1.8:20,0,0 loop
test: offset=-0.5 doc="leg bone 0.1,0,0.8 0.1,0,0.2"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: leg bone 0.1,0,0.8 0.1,0,0.2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${offset} < 0.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var leg_bone byte[>..] = [];
	if !gold_dlast(g, leg_bone) { out.ok = false; return out; }
	obuf.append(leg_bone);
	obuf.append(".rot anim ");
	gold_fnum(obuf, ${offset});
	obuf.append(":0,0,");
	obuf.append("0 ");
	gold_fnum(obuf, ${offset} + 1.0);
	obuf.append(":20,");
	obuf.append("0,0 loop");
	gold_doc(g, obuf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "conclip");
	out
}
@end
