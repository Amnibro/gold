expect: => i=2 r=0.0 ok=true s="deduped sequence count: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_dupes};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = 0;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen++; }
			j++;
		}
		if seen < cap {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i * m;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped sequence count: ", m);
	out
}
@end
