@entry 211facb779543207
kind: step
verb: limit
noun: streak
modifier: any
context: transform
phrase: limit any element streak run length to {cap}
phrase: truncate identical streak occurrences exceeding {cap}
slot: cap int
test: list=3,3,3,3,5,5,5 cap=2
expect: => i=4 r=0.0 ok=true s="limited streak run" errors=0 n=4 res=[3,3,5,5] cache=0 hits=0
test: list=1,1,2,2,2,3 cap=1
expect: => i=3 r=0.0 ok=true s="limited streak run" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if limit <= 0 { gold_fail(g, "invalid streak limit"); out.ok = false; return out; }
	var cur_val = 0;
	var run = 0;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if i == 0 || x != cur_val {
			cur_val = x;
			run = 1;
			g.res[w] = x;
			w++;
		} else if run < limit {
			run++;
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "limited streak run");
	return out;
}
@end
