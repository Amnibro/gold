fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var counts int[512] = [0; 512];
	for i in g.n {
		var c = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { c++; }
		}
		counts[i] = c * m;
	}
	for i in g.n {
		g.res[i] = counts[i];
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tallies scaled: ", g.n);
	out
}
@end
