fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let half = g.n / 2;
	var clamped = 0;
	var i = half;
	while i < g.n {
		if g.res[i] > b {
			g.res[i] = b;
			clamped++;
		}
		i++;
	}
	g.steps += g.n - half;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped tail elements: ", clamped);
	out
}
@end
