	var kept = 0;
	var dropped = 0;
	var prev_zero = false;
	for i in g.n {
		let x = g.res[i];
		if x == 0 {
			if prev_zero {
				dropped++;
			} else {
				g.res[kept] = x;
				kept++;
				prev_zero = true;
			}
		} else {
			g.res[kept] = x;
			kept++;
			prev_zero = false;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "spaces deduped: ", dropped);
