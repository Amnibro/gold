@entry e17ad454e2355794
kind: step
verb: drop
noun: sequence
modifier: at_least
context: list
slot: min_len int
phrase: drop sequence at least spanning length {min_len}
phrase: remove identical sequence at least of length {min_len}
phrase: filter list dropping runs at least of {min_len}
test: list=1,2,2,2,3,4,4 min_len=3
expect: => i=3 r=0.0 ok=true s="dropped run items: 3" errors=0 n=4 res=[1,3,4,4] cache=0 hits=0
test: list=5,5,6,7,7,7,8 min_len=2
expect: => i=5 r=0.0 ok=true s="dropped run items: 5" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var kept = 0;
	var i = 0;
	var dropped = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= ml {
			dropped += run_len;
		} else {
			var k = i;
			while k < j {
				g.res[kept] = g.res[k];
				kept++;
				k++;
			}
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped run items: ", dropped);
	out
}
@end
