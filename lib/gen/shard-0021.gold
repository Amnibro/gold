noun: bushes
modifier: clustered
context: env
phrase: fence clustered bushes with {n} posts spacing {sp}
phrase: enclose bush clusters with {n} stakes interval {sp}
slot: n int
slot: sp real
test: n=6 sp=1.2 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="bushfence" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: bush_fence3 cyl 0,0,0 0,0,1 r.04 m:matte #6b4a2b a6:1.2,0,0
test: n=4 sp=0.8 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=3 r=0.0 ok=true s="bushfence" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: bush_fence3 cyl 0,0,0 0,0,1 r.04 m:matte #6b4a2b a4:0.8,0,0
test: n=0 sp=1.2
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} <= 0 || ${sp} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "bush_fence", "", o);
	o.append(" cyl 0,0,");
	o.append("0 0,");
	o.append("0,1 r.");
	o.append("04 m:matte ");
	gold_hex(o, 107, 74, 43);
	o.append(" a");
	format(o, ${n});
	o.append(":");
	gold_fnum(o, ${sp});
	o.append(",0,0");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "bushfence");
	out
}
@end
