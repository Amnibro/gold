expect: => i=2 r=0.0 ok=true s="pairwise mapped length: 2" errors=0 n=2 res=[31,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var k = 0;
	while k + 1 < g.n {
		g.res[m] = ${step_fn}(g.res[k] + g.res[k + 1]);
		m++;
		k += 2;
	}
	if k < g.n {
		g.res[m] = g.res[k];
		m++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "pairwise mapped length: ", m);
	out
}
@end
