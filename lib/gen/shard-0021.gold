expect: => i=0 r=0.0 ok=true s="head shifted: 0" errors=0 n=3 res=[3,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var shifted = 0;
	if g.n > 1 && g.res[0] >= mv {
		let head = g.res[0];
		var i = 1;
		while i < g.n && g.res[i] < head {
			g.res[i - 1] = g.res[i];
			shifted++;
			i++;
		}
		g.res[i - 1] = head;
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "head shifted: ", shifted);
	out
}
@end
