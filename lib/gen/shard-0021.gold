context: error
phrase: normalize total with cache verification
phrase: scale total with cache lookup
test: input=5 list=10,15,25
expect: => i=10 r=0.0 ok=true s="total normalized" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: input=0 list=10,20
expect: => i=0 r=0.0 ok=false s="zero divisor" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i == 0 {
		gold_fail(g, "normalize total: zero divisor");
		out.ok = false;
		out.s.clear();
		format(out.s, "zero divisor");
		return out;
	}
	var sum = 0;
	var idx = 0;
	while idx < g.n {
		sum += g.res[idx];
		idx++;
	}
	out.i = sum / out.i;
	out.s.clear();
	format(out.s, "total normalized");
	out
}
@end
