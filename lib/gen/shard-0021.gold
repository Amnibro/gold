fn ${ID}(n int) int {
	let fl = ${floor_val};
	var x = if n < 0 { -n } else { n };
	var max_odd = 0;
	var max_even = 0;
	while x > 0 {
		let d = x % 10;
		if d % 2 != 0 {
			if d > max_odd { max_odd = d; }
		} else {
			if d > max_even { max_even = d; }
		}
