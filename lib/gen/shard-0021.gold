@entry 302d539d31fd2076
kind: step
verb: scan
noun: duplicates
modifier: none
context: list
phrase: scan duplicates none leaving unique items in list
phrase: remove repeated values to scan duplicates none across list
test: list=1,2,2,3,1,4
expect: => i=2 r=0.0 ok=true s="duplicates removed: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,7
expect: => i=0 r=0.0 ok=true s="duplicates removed: 0" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "duplicates removed: ", removed);
	out
}
@end
