code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let h = g.res[0];
	for k in g.n {
		let diff = g.res[k] - h;
		if diff < 0 { g.res[k] = -diff; } else { g.res[k] = diff; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "head differences measured: ", g.n);
	out
}
@end
