fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 { digits = 1; }
		while x > 0 {
			digits++;
			x /= 10;
		}
		if digits <= md { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "numbers within digit bound: ", count);
	out
}
