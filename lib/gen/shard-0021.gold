expect: => i=2 r=0.0 ok=true s="sorted prefix: 2" errors=0 n=4 res=[10,20,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var len = if g.n > 0 { 1 } else { 0 };
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			len++;
		} else {
			break;
		}
		i++;
	}
	if len >= ml {
		g.n = len;
	}
	g.steps += g.n;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted prefix: ", len);
	out
}
@end
