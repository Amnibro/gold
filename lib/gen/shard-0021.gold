code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 { return out; }
	var prev = g.res[0];
	var i = 1;
	while i < g.n {
		let cur = g.res[i];
		g.res[i] = cur + prev + off;
		prev = cur;
		i++;
	}
	g.steps += g.n;
	out.i = g.n - 1;
	out.s.clear();
	format(out.s, "shifted pairwise pairs: ", g.n - 1);
	out
}
@end
