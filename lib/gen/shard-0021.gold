@entry b21ad1ed351cec0d
kind: step
verb: scale
noun: runs
modifier: last
context: error
phrase: scale runs last sequence by multiplier {factor}
phrase: multiply last run entries by factor {factor}
slot: factor int
test: list=1,2,5,5,5 factor=2
expect: => i=3 r=0.0 ok=true s="scaled last run count: 3" errors=0 n=5 res=[1,2,10,10,10] cache=0 hits=0
test: list=10,20,8,8 factor=3
expect: => i=2 r=0.0 ok=true s="scaled last run count: 2" errors=0 n=4 res=[10,20,24,24] cache=0 hits=0
test: list=1,2 factor=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${factor} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if g.n == 0 {
		gold_fail(g, "empty results list");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		g.res[i] = g.res[i] * ${factor};
		count++;
		i--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled last run count: ", count);
	out
}
@end
