expect: => i=2 r=0.0 ok=true s="safely clamped middle: 2" errors=0 n=4 res=[2,50,50,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	let start = g.n / 4;
	let end = (3 * g.n) / 4;
	var clamped = 0;
	var i = start;
	while i < end && i < g.n {
		if g.res[i] < low {
			g.res[i] = low;
			clamped++;
		} else if g.res[i] > high {
			g.res[i] = high;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "safely clamped middle: ", clamped);
	out
}
@end
