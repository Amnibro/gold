@entry 0052c628bf60257f
kind: step
verb: join
noun: duplicates
modifier: all
context: retry
slot: target int
phrase: join duplicates all matching value {target}
phrase: combine duplicate entries all equal to {target}
test: list=2,5,5,5,8 target=5
expect: => i=3 r=0.0 ok=true s="duplicates combined: 3" errors=0 n=3 res=[2,15,8] cache=0 hits=0
test: list=4,4,1 target=4
expect: => i=2 r=0.0 ok=true s="duplicates combined: 2" errors=0 n=2 res=[8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for i in g.n {
		if g.res[i] == tgt { count++; }
	}
	if count > 1 {
		let total = count * tgt;
		var kept = 0;
		var placed = false;
		for i in g.n {
			if g.res[i] == tgt {
				if !placed {
					g.res[kept] = total;
					kept++;
					placed = true;
				}
			} else {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "duplicates combined: ", count);
	out
}
@end
