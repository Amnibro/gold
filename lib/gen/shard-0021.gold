slot: limit int
test: list=2,5,8 limit=10
expect: => i=2 r=0.0 ok=true s="evens shifted" errors=0 n=3 res=[3,5,9] cache=0 hits=0
test: list=1,3,5 limit=10
expect: => i=0 r=0.0 ok=false s="no evens" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var evens = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] % 2 == 0 && g.res[idx] <= lim {
			g.res[idx] += 1;
			evens++;
		}
		idx++;
	}
	if evens == 0 {
		gold_fail(g, "shift evens: no eligible evens");
		out.ok = false;
		out.s.clear();
		format(out.s, "no evens");
		return out;
	}
	out.i = evens;
	out.s.clear();
	format(out.s, "evens shifted");
	out
}
@end
