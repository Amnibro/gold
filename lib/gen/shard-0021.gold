@entry e37100d1bd95a434
kind: step
verb: reverse
noun: total
modifier: nested
context: aggregate
slot: chunk int
phrase: reverse total nested sums across blocks of {chunk}
phrase: invert nested total accumulations with block size {chunk}
test: list=1,2,3,4,5,6 chunk=2
expect: => i=21 r=0.0 ok=true s="reversed nested totals across 3 chunks" errors=0 n=3 res=[11,7,3] cache=0 hits=0
test: list=10,20,30,40 chunk=2
expect: => i=100 r=0.0 ok=true s="reversed nested totals across 2 chunks" errors=0 n=2 res=[70,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch <= 0 || g.n == 0 { return out; }
	var num_chunks = g.n / ch;
	var sums int[256] = [0; 256];
	var grand_total = 0;
	for c in num_chunks {
		var cur = 0;
		for j in ch { cur += g.res[c * ch + j]; }
		sums[c] = cur;
		grand_total += cur;
	}
	for c in num_chunks {
		g.res[c] = sums[num_chunks - 1 - c];
	}
	g.n = num_chunks;
	g.steps += num_chunks;
	out.i = grand_total;
	out.s.clear();
	format(out.s, "reversed nested totals across ", num_chunks, " chunks");
	out
}
@end
@entry 9f673d88d62a3779
kind: step
verb: keep
noun: series
modifier: last
context: aggregate
slot: count int
phrase: keep series last elements count {count}
phrase: retain series trailing elements count {count}
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="kept last 3 series items" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=5,10,15,20 count=2
expect: => i=2 r=0.0 ok=true s="kept last 2 series items" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 { g.n = 0; out.i = 0; return out; }
	if c >= g.n { out.i = g.n; return out; }
	let start = g.n - c;
	for k in c {
		g.res[k] = g.res[start + k];
	}
	g.n = c;
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "kept last ", c, " series items");
	out
}
@end
@entry 02fa4f07a0007e23
kind: step
verb: reverse
noun: results
modifier: running
context: aggregate
phrase: reverse results running cumulative totals
phrase: invert order of running results accumulations
test: list=1,2,3,4
expect: => i=10 r=0.0 ok=true s="reversed running totals final sum 10" errors=0 n=4 res=[10,6,3,1] cache=0 hits=0
test: list=5,10,15
expect: => i=30 r=0.0 ok=true s="reversed running totals final sum 30" errors=0 n=3 res=[30,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run = 0;
	for k in g.n {
		run += g.res[k];
		g.res[k] = run;
	}
	for k in g.n / 2 {
		let tmp = g.res[k];
		g.res[k] = g.res[g.n - 1 - k];
		g.res[g.n - 1 - k] = tmp;
	}
	g.steps += g.n * 2;
	out.i = run;
	out.s.clear();
	format(out.s, "reversed running totals final sum ", run);
	out
}
@end
@entry 6d09e718a66d2a51
kind: step
