code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k < 0 { gold_fail(g, "negative limit"); out.ok = false; return out; }
	let lim = if k > out.s.len { out.s.len } else { k };
	for i in lim { gold_cache_put(g, i, out.s[i] as int); } out.i = g.cn;
	g.steps += out.s.len;
	out
}
@end
