@entry 52d9384319b389bd
kind: step
verb: sum words
noun: words
modifier: sorted
context: stats
slot: count int
phrase: sum words sorted sample count {count}
phrase: aggregate sample words sorted slice {count}
test: list=9,2,7,4 count=2
expect: => i=6 r=0.0 ok=true s="sorted words sum: 6" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=10,5 count=1
expect: => i=5 r=0.0 ok=true s="sorted words sum: 5" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var k = c;
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	var total = 0;
	for i in k { total += g.res[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sorted words sum: ", total);
	out
}
@end
@entry b4e71a1e9ed61445
kind: step
verb: split
noun: function
modifier: last
context: stats
slot: divisor int
phrase: split function last item by {divisor}
phrase: partition sample function last divisor {divisor}
test: list=10,25 divisor=4
expect: => i=6 r=0.0 ok=true s="split quotient: 6" errors=0 n=3 res=[10,6,1] cache=0 hits=0
test: list=8,17 divisor=5
expect: => i=3 r=0.0 ok=true s="split quotient: 3" errors=0 n=3 res=[8,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if g.n > 0 && d > 0 {
		let last = g.res[g.n - 1];
		let q = last / d;
		let r = last % d;
		g.res[g.n - 1] = q;
		gold_push(g, r);
		out.i = q;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "split quotient: ", out.i);
	out
}
@end
@entry f9587b9975e0e4fd
kind: step
verb: collect
noun: pairs
modifier: in_reverse
context: stats
slot: stride int
phrase: collect pairs in reverse maximum stride {stride}
phrase: aggregate sample pairs in reverse stride {stride}
test: list=2,8,10,4 stride=1
expect: => i=2 r=0.0 ok=true s="pairs collected: 2" errors=0 n=2 res=[10,8] cache=0 hits=0
test: list=5,3 stride=1
expect: => i=1 r=0.0 ok=true s="pairs collected: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	let pairs = g.n / 2;
	for p in pairs {
		let x = g.res[2 * p];
		let y = g.res[2 * p + 1];
		g.res[p] = if x > y { x } else { y };
	}
	var left = 0;
	var right = pairs - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairs collected: ", pairs);
	out
}
@end
