@entry b0d653ece55dc195
kind: step
verb: fold
noun: range
modifier: recursively
context: retry
slot: depth int
phrase: fold range recursively depth {depth}
phrase: reduce range recursively iterations {depth}
test: list=1,2,3,4 depth=1
expect: => i=3 r=0.0 ok=true s="recursive fold: 3" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,2,3,4 depth=2
expect: => i=10 r=0.0 ok=true s="recursive fold: 10" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var steps = 0;
	while steps < d && g.n > 1 {
		let pairs = g.n / 2;
		for i in pairs {
			g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
		}
		g.n = pairs;
		steps++;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "recursive fold: ", out.i);
	out
}
@end
