@entry 6d696b7dfe6394d4
kind: step
verb: scan
noun: maximum
modifier: any
context: list
phrase: scan list maximum under ceiling {ceiling}
phrase: find any maximum in list bounded by {ceiling}
slot: ceiling int
test: list=10,25,8,19 ceiling=20
expect: => i=19 r=0.0 ok=true s="found maximum 19 under ceiling" errors=0 n=4 res=[10,25,8,19] cache=0 hits=0
test: list=5,15,30 ceiling=10
expect: => i=5 r=0.0 ok=true s="found maximum 5 under ceiling" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var best = -1000000;
	var found = false;
	for i in g.n {
		if g.res[i] < ceil && (!found || g.res[i] > best) {
			best = g.res[i];
			found = true;
		}
	}
	g.steps += g.n;
	if found {
		out.i = best;
		out.s.clear();
		format(out.s, "found maximum ", best, " under ceiling");
	} else {
		out.i = 0;
		out.ok = false;
		g.errors++;
		out.s.clear();
		format(out.s, "no item found under ceiling ", ceil);
	}
	out
}
@end
