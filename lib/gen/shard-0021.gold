fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 { gold_fail(g, "invalid depth"); out.ok = false; return out; }
	for pass in d {
		for i in g.n {
			let x = g.res[i];
			g.res[i] = if x > 0 { x - 1 } else { 0 };
		}
	}
	g.steps += d * g.n;
	out.i = d;
	gold_text(out, "shifted checkpoint recursively");
	return out;
}
@end
