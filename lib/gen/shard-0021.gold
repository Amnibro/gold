expect: => i=3 r=0.0 ok=true s="chaintarget" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: root bone 0,0,1 0,0,1.4
expect: => doc: tgt3 ik root 0.6,0,1.5 n2
