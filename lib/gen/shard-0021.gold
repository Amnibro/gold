@entry 8204bb8299ed92c5
kind: step
verb: scale
noun: item
modifier: up_to
context: transform
phrase: scale items upward up to ceiling {cap}
phrase: multiply elements up to boundary limit {cap}
slot: cap int
test: list=2,5,10 cap=15
expect: => i=2 r=0.0 ok=true s="scaled up to ceiling" errors=0 n=3 res=[4,10,10] cache=0 hits=0
test: list=4,8,12 cap=12
expect: => i=1 r=0.0 ok=true s="scaled up to ceiling" errors=0 n=3 res=[8,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let prod = g.res[i] * 2;
		if prod <= ${cap} {
			g.res[i] = prod;
			count++;
		}
	}
	out.i = count;
	gold_text(out, "scaled up to ceiling");
	return out;
}
@end
