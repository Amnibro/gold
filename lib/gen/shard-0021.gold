fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var idx = 1;
	while idx < g.n {
		if g.res[idx - 1] > g.res[idx] {
			gold_fail(g, "limit range: unsorted sequence");
			out.ok = false;
			out.s.clear();
			format(out.s, "unsorted range");
