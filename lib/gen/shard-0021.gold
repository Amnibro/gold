	var out = v;
	let c = ${cap};
	var excess = 0;
	for i in g.n {
		if g.res[i] > c {
			excess += g.res[i] - c;
			g.res[i] = c;
		}
	}
	g.steps += g.n;
	out.i = excess;
	out.s.clear();
