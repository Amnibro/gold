code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var norm_sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let sq = x * x;
		if norm_sum + sq > lim * lim { break; }
		norm_sum += sq;
		count++;
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced space coordinates: ", count);
	out
}
@end
