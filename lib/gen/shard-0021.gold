slot: k int
test: list=10,50,40,20,30 k=3
expect: => i=3 r=0.0 ok=true s="sorted suffix items: 3" errors=0 n=5 res=[10,50,20,30,40] cache=0 hits=0
test: list=1,9,8,7,6 k=4
expect: => i=4 r=0.0 ok=true s="sorted suffix items: 4" errors=0 n=5 res=[1,6,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	var count = req;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	for i in count {
		for j in count - 1 {
			let idx1 = start + j;
			let idx2 = start + j + 1;
			if g.res[idx1] > g.res[idx2] {
				let tmp = g.res[idx1];
				g.res[idx1] = g.res[idx2];
				g.res[idx2] = tmp;
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted suffix items: ", count);
	out
}
@end
