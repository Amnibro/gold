expect: => i=3 r=0.0 ok=true s="filtered sequence gaps to 3 items" errors=0 n=3 res=[1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n <= 1 { return out; }
	var kept = 1;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[kept - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= mg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered sequence gaps to ", kept, " items");
	out
}
@end
