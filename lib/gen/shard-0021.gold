code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.78 + 0.5); }
	for k in g.iw * g.ih { if g.img[k] >= 0.54 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "concrete");
	out
}
@end
