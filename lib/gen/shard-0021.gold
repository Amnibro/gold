code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${prefix_len} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	if ${prefix_len} > g.n {
		gold_fail(g, "prefix length exceeds elements");
		out.ok = false;
		return out;
	}
	var a = 0;
	var b = ${prefix_len} - 1;
	while a < b {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		a++;
		b--;
	}
	g.steps += ${prefix_len};
	out.i = ${prefix_len};
	out.s.clear();
	format(out.s, "reversed nested prefix: ", ${prefix_len});
	out
}
@end
