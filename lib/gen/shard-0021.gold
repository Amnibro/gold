test: list=1,3,4,6,8 p=is_even
expect: => i=3 r=0.0 ok=true s="rank pairs any matches: 3" errors=0 n=5 res=[1,3,4,6,8] cache=0 hits=0
test: list=2,5,7,9,11 p=is_even
expect: => i=3 r=0.0 ok=true s="rank pairs any matches: 3" errors=0 n=5 res=[2,5,7,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			if ${p}(g.res[i] + g.res[i + 1]) {
				matches++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "rank pairs any matches: ", matches);
	out
}
@end
