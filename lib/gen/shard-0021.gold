	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1 <= m; }
	var longest = 0;
	var cur_run = 0;
	var last_digit = -1;
	while x > 0 {
		let d = x % 10;
		if d == last_digit {
			cur_run++;
		} else {
			last_digit = d;
			cur_run = 1;
		}
		if cur_run > longest { longest = cur_run; }
		x /= 10;
	}
	longest <= m
}
@end
