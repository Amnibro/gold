code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		var seen = false;
		for j in count {
			if g.cv[j] == g.res[k] { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, count, g.res[k]);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "deduped text in reverse");
	out
}
@end
