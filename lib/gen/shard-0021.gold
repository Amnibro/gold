fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		if val % 2 != 0 && val <= limit {
			// drop
		} else {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements");
	out
}
