@entry 30c10278e36d3512
kind: step
verb: keep
noun: number
modifier: at_most
context: list
phrase: keep list numbers at most {limit}
phrase: retain list values at most {limit}
slot: limit int
test: list=10,25,5,30,15 limit=15
expect: => i=3 r=0.0 ok=true s="kept 3 numbers" errors=0 n=3 res=[10,5,15] cache=0 hits=0
test: list=40,2,8,19,1 limit=10
expect: => i=3 r=0.0 ok=true s="kept 3 numbers" errors=0 n=3 res=[2,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var w = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] <= lim {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.steps += i;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "kept ", w, " numbers");
	out
}
@end
