@entry feac3dba4a5fe66d
kind: step
verb: limit
noun: tail
modifier: looping
context: char
phrase: limit tail rotation to angle {ang} across cycle duration {sec}
phrase: restrict tail looping swing to {ang} degrees over {sec} seconds
slot: ang real
slot: sec real
test: ang=30.0 sec=1.5 doc="hip bone 0,0,1 0,0,1.4|tail bone 0,-0.1,1 0,-0.4,0.9 ^hip"
expect: => i=4 r=0.0 ok=true s="limittail" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: hip bone 0,0,1 0,0,1.4
expect: => doc: tail bone 0,-0.1,1 0,-0.4,0.9 ^hip
expect: => doc: limtail3 limitrot tail z-30,30
expect: => doc: tail.rot anim 0:0,0,0 1.5:0,0,30 loop
test: ang=45.0 sec=2.0 doc="ground box 0,0,-.5 20,20,1|hip bone 0,0,1 0,0,1.4|tail bone 0,-0.1,1 0,-0.4,0.9 ^hip"
expect: => i=5 r=0.0 ok=true s="limittail" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: hip bone 0,0,1 0,0,1.4
expect: => doc: tail bone 0,-0.1,1 0,-0.4,0.9 ^hip
expect: => doc: limtail4 limitrot tail z-45,45
expect: => doc: tail.rot anim 0:0,0,0 2:0,0,45 loop
test: ang=0.0 sec=1.5 doc="hip bone 0,0,1 0,0,1.4|tail bone 0,-0.1,1 0,-0.4,0.9 ^hip"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: hip bone 0,0,1 0,0,1.4
expect: => doc: tail bone 0,-0.1,1 0,-0.4,0.9 ^hip
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${ang} <= 0.0 || ${sec} <= 0.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnews(g, "limtail", "", o);
	o.append(" limitrot ");
	o.append(last);
	o.append(" z-");
	gold_fnum(o, ${ang});
	o.append(",");
	gold_fnum(o, ${ang});
	gold_doc(g, o);
	o.clear();
	o.append(last);
	o.append(".rot anim 0:0,"); o.append("0,0 ");
	gold_fnum(o, ${sec});
	o.append(":0,0,");
	gold_fnum(o, ${ang});
	o.append(" loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "limittail");
	out
}
@end
