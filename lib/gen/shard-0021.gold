code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${item} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var found = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == ${item} { found = i; break; }
		i++;
	}
	g.steps += i + 1;
	if found < 0 {
		gold_fail(g, "item not found");
		out.ok = false;
		return out;
	}
	out.i = found;
	out.s.clear();
	format(out.s, "item found at: ", found);
	out
}
@end
