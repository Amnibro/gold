phrase: merge item last using placeholder {dummy}
phrase: insert merge item last with flag {dummy}
test: list=2,5,8,12,6 dummy=0
expect: => i=2 r=0.0 ok=true s="merged shifts: 2" errors=0 n=5 res=[2,5,6,8,12] cache=0 hits=0
test: list=10,20,30,5 dummy=0
expect: => i=3 r=0.0 ok=true s="merged shifts: 3" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${dummy};
	var shifts = 0;
	if g.n > 1 {
		let item = g.res[g.n - 1];
		var i = g.n - 2;
		while i >= 0 && g.res[i] > item {
			g.res[i + 1] = g.res[i];
			shifts++;
			i--;
		}
		g.res[i + 1] = item;
	}
	g.steps += g.n + d;
	out.i = shifts;
	out.s.clear();
	format(out.s, "merged shifts: ", shifts);
	out
}
@end
@entry dea23d18d072b8a0
kind: step
verb: swap
noun: duplicates
modifier: none
context: sort
slot: dummy int
phrase: swap duplicates none using option {dummy}
phrase: sort swap duplicates none with {dummy}
test: list=4,2,4,3,2 dummy=0
expect: => i=2 r=0.0 ok=true s="duplicates removed: 2" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=5,1,5,5 dummy=0
expect: => i=2 r=0.0 ok=true s="duplicates removed: 2" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${dummy};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var kept = 0;
	if g.n > 0 {
		kept = 1;
		for i in g.n {
			if i > 0 && g.res[i] != g.res[i - 1] {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n + d;
	out.i = removed;
	out.s.clear();
	format(out.s, "duplicates removed: ", removed);
	out
}
@end
