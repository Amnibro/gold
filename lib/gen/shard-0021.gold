fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	let ceil = ${ceiling};
	var shifted = 0;
	for i in g.n {
		var x = g.res[i];
		while x < ceil {
			x += d;
			shifted++;
		}
		gold_cache_put(g, g.res[i], x);
		g.res[i] = x;
	}
	g.steps += g.n + shifted;
	out.i = shifted;
	gold_text(out, "shifted memo while below ceiling");
	return out;
}
@end
