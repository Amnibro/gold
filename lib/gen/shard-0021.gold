expect: => i=2 r=0.0 ok=true s="grouped into chunks: 2" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${chunk_size};
	if cs <= 0 || g.n == 0 { return out; }
	var num_groups = 0;
	var i = 0;
	while i < g.n {
		var s = 0;
		var j = 0;
		while j < cs && i + j < g.n {
			s += g.res[i + j];
			j++;
		}
		g.res[num_groups] = s;
		num_groups++;
		i += cs;
	}
	g.n = num_groups;
	g.steps += g.n;
	out.i = num_groups;
	out.s.clear();
	format(out.s, "grouped into chunks: ", num_groups);
	out
}
@end
@entry c3b648ca4cab7580
kind: step
verb: drop
noun: step
modifier: between
context: list
slot: max_step int
phrase: drop step between adjacent delta exceeding {max_step}
phrase: remove items with step between greater than {max_step}
phrase: filter list dropping step delta exceeding {max_step}
test: list=1,3,10,12,25 max_step=5
expect: => i=2 r=0.0 ok=true s="dropped steep steps: 2" errors=0 n=3 res=[1,3,12] cache=0 hits=0
test: list=10,20,22,50 max_step=10
expect: => i=1 r=0.0 ok=true s="dropped steep steps: 1" errors=0 n=3 res=[10,20,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	if g.n <= 1 { return out; }
	var kept = 1;
	var dropped = 0;
	var i = 1;
	while i < g.n {
		var d = g.res[i] - g.res[i - 1];
		if d < 0 { d = -d; }
		if d > ms {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped steep steps: ", dropped);
	out
}
@end
