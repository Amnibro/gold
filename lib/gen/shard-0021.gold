@entry 83ce09c8b24dd789
kind: step
verb: dedupe
noun: condition
modifier: any
context: filter
slot: bucket int
phrase: dedupe condition any elements sharing bucket {bucket}
phrase: remove duplicate condition matches across bucket size {bucket}
test: list=12,18,25,29,31 bucket=10
expect: => i=3 r=0.0 ok=true s="deduped condition buckets: 3" errors=0 n=3 res=[12,25,31] cache=0 hits=0
test: list=5,8,12,15,22 bucket=5
expect: => i=4 r=0.0 ok=true s="deduped condition buckets: 4" errors=0 n=4 res=[5,12,15,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b <= 0 { return out; }
	var kept = 0;
	for i in g.n {
		let b_id = g.res[i] / b;
		var seen = false;
		for j in kept {
			if g.res[j] / b == b_id {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped condition buckets: ", kept);
	out
}
@end
