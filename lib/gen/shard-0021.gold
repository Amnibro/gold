fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var altered = 0;
	for i in g.n {
		if i % 2 == 1 {
			g.res[i] += sh;
			altered++;
		}
	}
	g.steps += g.n;
	out.i = altered;
	out.s.clear();
	format(out.s, "rotated alternate numbers: ", altered);
	out
}
@end
