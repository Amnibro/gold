expect: => i=2 r=0.0 ok=false s="sorted margin inversions: 2" errors=1 n=4 res=[10,8,15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	var inversions = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				inversions++;
			}
		}
	}
	g.steps += g.n;
	if inversions > m {
		gold_fail(g, "sequence exceeds allowed sorted margin");
		out.ok = false;
	}
	out.i = inversions;
	out.s.clear();
	format(out.s, "sorted margin inversions: ", inversions);
	out
}
@end
