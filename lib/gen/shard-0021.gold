code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var k = 0;
	while k < g.n {
		if k + 1 < g.n && g.res[k] % 2 != 0 && g.res[k + 1] % 2 != 0 {
			g.res[m] = g.res[k] + g.res[k + 1];
			m++;
			k += 2;
		} else {
			g.res[m] = g.res[k];
			m++;
			k++;
		}
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "paired odds length: ", m);
	out
}
