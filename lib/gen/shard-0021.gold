noun: cache
modifier: pairwise
context: list
slot: max_diff int
phrase: drop cache pairwise entries within difference {max_diff}
phrase: purge cached pairs matching span diff {max_diff}
phrase: clear adjacent cache values closer than {max_diff}
test: list=10,12,20,25 max_diff=3
expect: => i=1 r=0.0 ok=true s="pairwise close cache hits: 1" errors=0 n=4 res=[10,12,20,25] cache=4 hits=0
test: list=1,5,6,10 max_diff=2
expect: => i=1 r=0.0 ok=true s="pairwise close cache hits: 1" errors=0 n=4 res=[1,5,6,10] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var dropped = 0;
	var i = 1;
	while i < g.cn {
		var diff = g.cv[i] - g.cv[i - 1];
		if diff < 0 { diff = -diff; }
		if diff <= md {
			dropped++;
		}
		i++;
	}
	out.i = dropped;
	out.s.clear();
	format(out.s, "pairwise close cache hits: ", dropped);
	out
}
@end
