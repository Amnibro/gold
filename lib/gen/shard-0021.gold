@entry 2ccd7cf7df060230
kind: step
verb: shift
noun: primes
modifier: nested
context: sort
phrase: sort shift primes nested by step {step}
phrase: advance nested prime values in sorted results by {step}
slot: step int
test: list=2,3,4,5,6 step=10
expect: => i=3 r=0.0 ok=true s="shifted 3 primes" errors=0 n=5 res=[12,13,4,15,6] cache=0 hits=0
test: list=4,6,8,9 step=5
expect: => i=0 r=0.0 ok=true s="shifted 0 primes" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var is_p = val >= 2;
		var d = 2;
		while d * d <= val {
			if val % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] += s;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " primes");
	out
}
@end
