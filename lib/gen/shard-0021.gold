@entry c51bb9d216fd4714
kind: step
verb: swap
noun: limit
modifier: any
context: list
phrase: swap any elements exceeding limit {limit}
phrase: exchange positions for any items above limit {limit}
slot: limit int
test: list=5,20,10,30,8 limit=15
expect: => i=1 r=0.0 ok=true s="swapped outer elements exceeding limit" errors=0 n=5 res=[5,30,10,20,8] cache=0 hits=0
test: list=2,4,6 limit=10
expect: => i=0 r=0.0 ok=true s="no swap performed" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var first_idx = -1;
	var last_idx = -1;
	for i in g.n {
		if g.res[i] > lim {
			if first_idx < 0 { first_idx = i; }
			last_idx = i;
		}
	}
	g.steps += g.n;
	if first_idx >= 0 && last_idx > first_idx {
		let tmp = g.res[first_idx];
		g.res[first_idx] = g.res[last_idx];
		g.res[last_idx] = tmp;
		out.i = 1;
		out.s.clear();
		format(out.s, "swapped outer elements exceeding limit");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "no swap performed");
	}
	out
}
@end
