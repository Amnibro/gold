code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= base {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "folded average: ", avg);
	out
}
@end
@entry 1148381b07daf986
kind: step
verb: sort
noun: function
modifier: with_retry
context: filter
slot: attempts int
phrase: sort filter function with retry count {attempts}
phrase: order filtered values applying function retry limit {attempts}
test: list=45,12,89,23 attempts=3
expect: => i=12 r=0.0 ok=true s="sorted with retry passes: 3" errors=0 n=4 res=[12,23,45,89] cache=0 hits=0
test: list=19,5,72,31 attempts=2
expect: => i=5 r=0.0 ok=true s="sorted with retry passes: 2" errors=0 n=4 res=[5,19,31,72] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var pass = 0;
	while pass < att {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
		pass++;
	}
	g.steps += g.n * att;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "sorted with retry passes: ", att);
	out
}
@end
@entry 35b4d0e9c9eefc6a
kind: step
verb: trace
noun: runs
modifier: any
context: filter
slot: min_len int
phrase: trace runs any meeting consecutive count {min_len}
phrase: filter sequence tracing any runs passing length {min_len}
test: list=1,1,2,3,3,3,4 min_len=2
expect: => i=5 r=0.0 ok=true s="traced run elements: 5" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,5,5,6,7,7,8 min_len=3
expect: => i=3 r=0.0 ok=true s="traced run elements: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= ml {
			var k = i;
			while k < j {
				g.res[kept] = g.res[k];
				kept++;
				k++;
			}
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "traced run elements: ", kept);
	out
}
@end
