@entry fbf2304bb56f537d
kind: step
verb: sort
noun: tally
modifier: first
context: filter
phrase: sort sequence by descending frequency tally
phrase: order items placing most frequent tallies first
test: list=3,1,3,2,1,3
expect: => i=3 r=0.0 ok=true s="sorted by tally, max frequency: 3" errors=0 n=6 res=[3,3,3,1,1,2] cache=0 hits=0
test: list=5,8,5,8,8,2
expect: => i=3 r=0.0 ok=true s="sorted by tally, max frequency: 3" errors=0 n=6 res=[8,8,8,5,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var counts = [0; 256];
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
		if i < 256 { counts[i] = freq; }
	}
	var i = 0;
	while i < g.n - 1 {
		var j = 0;
		while j < g.n - 1 - i {
			if counts[j] < counts[j + 1] || (counts[j] == counts[j + 1] && g.res[j] > g.res[j + 1]) {
				let tmp_c = counts[j];
				counts[j] = counts[j + 1];
				counts[j + 1] = tmp_c;
				let tmp_v = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp_v;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = counts[0];
	out.s.clear();
	format(out.s, "sorted by tally, max frequency: ", counts[0]);
	out
}
@end
