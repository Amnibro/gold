code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if g.n > 0 && d > 0 {
		let last = g.res[g.n - 1];
		let q = last / d;
		let r = last % d;
		g.res[g.n - 1] = q;
		gold_push(g, r);
		out.i = q;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "split last quotient: ", out.i);
	out
}
