	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "boss");
	out
}
@end
