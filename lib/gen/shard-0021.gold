@entry 0a4a7d007e795d4a
kind: step
verb: compare
noun: minimum
modifier: sorted
context: transform
phrase: compare sorted minimum elements against pivot {pivot}
phrase: evaluate minimum of sorted items against benchmark {pivot}
slot: pivot int
test: list=9,3,7 pivot=5
expect: => i=2 r=0.0 ok=true s="compared minimum sorted" errors=0 n=3 res=[5,9,11] cache=0 hits=0
test: list=8,12,6 pivot=10
expect: => i=4 r=0.0 ok=true s="compared minimum sorted" errors=0 n=3 res=[10,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let min_v = if g.n > 0 { g.res[0] } else { 0 };
	var diff = min_v - p;
	if diff < 0 { diff = -diff; }
	for i in g.n { g.res[i] += diff; }
	g.steps += g.n * 2;
	out.i = diff;
	gold_text(out, "compared minimum sorted");
	return out;
}
@end
