@entry 775d2b94580b96ef
kind: step
verb: keep
noun: squares
modifier: with_retry
context: error
phrase: keep squares with_retry attempts allowed {retries}
phrase: filter squares allowing retry attempts {retries}
slot: retries int
test: list=4,5,9,12 retries=2
expect: => i=2 r=0.0 ok=true s="verified squares kept: 2" errors=0 n=2 res=[4,9] cache=0 hits=0
test: list=1,3,16,20 retries=3
expect: => i=2 r=0.0 ok=true s="verified squares kept: 2" errors=0 n=2 res=[1,16] cache=0 hits=0
test: list=4,5 retries=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${retries} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var kept = 0;
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var is_sq = false;
		var r = 1;
		while r * r <= g.res[i] {
			if r * r == g.res[i] { is_sq = true; break; }
			r++;
		}
		if is_sq {
			g.res[new_n] = g.res[i];
			new_n++;
			kept++;
		}
		i++;
	}
	g.n = new_n;
	g.steps += g.n + ${retries};
	out.i = kept;
	out.s.clear();
	format(out.s, "verified squares kept: ", kept);
	out
}
@end
