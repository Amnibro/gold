@entry f405536d861dd9fc
kind: step
verb: measure
noun: prefix
modifier: at_least
context: sort
slot: min_len int
phrase: measure prefix at least length {min_len}
phrase: check sorted prefix at least bound {min_len}
test: list=2,5,8,3,9 min_len=2
expect: => i=3 r=0.0 ok=true s="sorted prefix: 3" errors=0 n=3 res=[2,5,8] cache=0 hits=0
