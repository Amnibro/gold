expect: => i=1 r=0.0 ok=true s="clamped 1 prefix elements until limit" errors=0 n=5 res=[4,7,12,6,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var modified = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > lim {
			g.res[i] = lim;
			modified++;
		}
		if g.res[i] == lim {
			i++;
			break;
		}
		i++;
	}
	g.steps += i;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " prefix elements until limit");
	out
}
@end
@entry d4e1adaa9ce87f07
kind: step
verb: rotate
noun: average
modifier: recursively
context: filter
phrase: rotate average recursively with factor {factor}
phrase: cycle sequence around average with scale {factor}
slot: factor int
test: list=10,20,30,40 factor=2
expect: => i=25 r=0.0 ok=true s="rotated average with factor 2" errors=0 n=4 res=[22,27,32,17] cache=0 hits=0
test: list=5,15,25,35 factor=3
expect: => i=20 r=0.0 ok=true s="rotated average with factor 3" errors=0 n=4 res=[11,15,18,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n <= 1 || f <= 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n {
		g.res[i] = (g.res[i] + avg) / f;
	}
	let first = g.res[0];
	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n * 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "rotated average with factor ", f);
	out
}
@end
@entry 0d5b75de53b364a0
kind: step
verb: sort
noun: squares
modifier: last
context: filter
phrase: sort squares moving square numbers to end
phrase: partition sequence placing perfect squares last
test: list=9,4,7,16,5
expect: => i=3 r=0.0 ok=true s="partitioned 3 squares last" errors=0 n=5 res=[7,5,4,9,16] cache=0 hits=0
test: list=25,3,1,8,4
expect: => i=3 r=0.0 ok=true s="partitioned 3 squares last" errors=0 n=5 res=[3,8,1,4,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var non_sq = [0; 256];
	var sq = [0; 256];
	var n_non = 0;
	var n_sq = 0;
	for i in g.n {
		let x = g.res[i];
		var r = 0;
		while r * r < x { r++; }
		if r * r == x && x > 0 && n_sq < 256 {
			sq[n_sq] = x;
			n_sq++;
		} else if n_non < 256 {
			non_sq[n_non] = x;
			n_non++;
		}
	}
	if n_sq > 1 {
		var i = 0;
		while i < n_sq - 1 {
			var j = 0;
			while j < n_sq - 1 - i {
				if sq[j] > sq[j + 1] {
					let tmp = sq[j];
					sq[j] = sq[j + 1];
					sq[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	for i in n_non { g.res[i] = non_sq[i]; }
	for i in n_sq { g.res[n_non + i] = sq[i]; }
	g.steps += g.n * 2;
	out.i = n_sq;
	out.s.clear();
	format(out.s, "partitioned ", n_sq, " squares last");
	out
}
@end
