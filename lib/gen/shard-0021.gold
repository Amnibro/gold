code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	var cnt = 0;
	for k in g.n {
		if g.res[k] > lo && g.res[k] < hi { cnt++; }
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "numbers between bounds: ", cnt);
	out
}
@end
@entry 556931bd97279f74
kind: step
verb: keep
noun: middle
modifier: times
context: list
slot: span int
phrase: keep middle times count {span} elements from list center
phrase: extract center slice to keep middle times length {span}
test: list=1,2,3,4,5 span=3
expect: => i=3 r=0.0 ok=true s="kept middle elements: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10,20,30,40 span=2
expect: => i=2 r=0.0 ok=true s="kept middle elements: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp >= g.n || sp <= 0 { return out; }
	let drop = (g.n - sp) / 2;
	for k in sp {
		g.res[k] = g.res[drop + k];
	}
	g.n = sp;
	g.steps += g.n;
	out.i = sp;
	out.s.clear();
	format(out.s, "kept middle elements: ", sp);
	out
}
@end
