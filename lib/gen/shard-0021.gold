@entry 9af9c1d43ccc2024
kind: step
verb: merge
noun: budget
modifier: nested
context: list
phrase: merge nested blocks of size {block_size} under budget {budget}
phrase: combine nested items in groups of {block_size} within budget {budget}
slot: block_size int
slot: budget int
test: list=1,2,3,4,5,6 block_size=2 budget=15
expect: => i=10 r=0.0 ok=true s="merged nested blocks within budget" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=5,5,10,10 block_size=2 budget=12
expect: => i=10 r=0.0 ok=true s="merged nested blocks within budget" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = if ${block_size} <= 0 { 1 } else { ${block_size} };
	let bg = ${budget};
	var w = 0;
	var total = 0;
	var i = 0;
	while i < g.n {
		var block_sum = 0;
		var j = 0;
		while j < bs && i + j < g.n {
			block_sum += g.res[i + j];
			j++;
		}
		if total + block_sum > bg { break; }
		g.res[w] = block_sum;
		w++;
		total += block_sum;
		i += bs;
	}
	g.n = w;
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "merged nested blocks within budget");
	out
}
@end
