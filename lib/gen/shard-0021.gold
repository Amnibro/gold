code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let pairs = g.n / 2;
	var splits = 0;
	for p in pairs {
		let s = g.res[2 * p] + g.res[2 * p + 1];
		if s >= th {
			g.res[2 * p] /= 2;
			g.res[2 * p + 1] /= 2;
			splits++;
		}
	}
	g.steps += pairs;
	out.i = splits;
	out.s.clear();
	format(out.s, "pairs split: ", splits);
	out
}
@end
