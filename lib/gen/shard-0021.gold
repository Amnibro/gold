		while i + 1 < g.n {
			if g.res[i] < g.res[i + 1] {
				inc_steps++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = inc_steps;
	out.s.clear();
	format(out.s, "increasing sequence steps: ", inc_steps);
	out
}
@end
@entry 22285399c9bb1564
kind: step
verb: validate
noun: limit
modifier: between
context: math
phrase: validate limit between low {lo} to high {hi} thresholds in math
phrase: check all values fall within limits {lo} to {hi} in math
slot: lo int
slot: hi int
test: list=5,10,15 lo=0 hi=20
expect: => i=1 r=0.0 ok=true s="values within limits" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=2,25,8 lo=5 hi=20
expect: => i=0 r=0.0 ok=false s="value exceeded bounds" errors=1 n=3 res=[2,25,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var valid = true;
	for i in g.n {
		if g.res[i] < l || g.res[i] > h {
			valid = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "values within limits");
	} else {
		gold_fail(g, "value exceeded bounds");
		format(out.s, "value exceeded bounds");
	}
	out
}
@end
