test: list=1,2,3,4,5,6 w=2
expect: => i=3 r=0.0 ok=true s="split nested windows" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30 w=3
expect: => i=1 r=0.0 ok=true s="split nested windows" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 { gold_fail(g, "invalid window size"); out.ok = false; return out; }
	var wcount = 0;
	var w = 0;
	var i = 0;
	while i + win <= g.n {
		var sum = 0;
		for j in win { sum += g.res[i + j]; }
		g.res[w] = sum;
		w++;
		wcount++;
		i += win;
	}
	g.n = w;
	g.steps += g.n;
	out.i = wcount;
	gold_text(out, "split nested windows");
	return out;
}
@end
