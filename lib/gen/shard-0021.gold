@entry 22116ce48fb513c2
kind: step
verb: swap
noun: tally
modifier: any
context: list
phrase: swap tally counts for any matching value {target}
phrase: exchange positions of any item matching target {target}
slot: target int
test: list=10,20,30,40 target=20
expect: => i=1 r=0.0 ok=true s="swapped matching item to tail" errors=0 n=4 res=[10,40,30,20] cache=0 hits=0
test: list=5,15,25 target=7
expect: => i=-1 r=0.0 ok=true s="target item not found for swap" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	g.steps += g.n;
	if idx >= 0 && g.n > 0 {
		let tmp = g.res[idx];
		g.res[idx] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		out.i = idx;
		out.s.clear();
		format(out.s, "swapped matching item to tail");
	} else {
		out.i = -1;
		out.s.clear();
		format(out.s, "target item not found for swap");
	}
	out
}
@end
@entry b1139cfc36e41e91
kind: step
verb: scale
noun: suffix
modifier: at_most
context: list
phrase: scale suffix at most {count} items by {factor}
phrase: multiply list suffix elements at most {count} with {factor}
slot: count int
slot: factor int
test: list=2,3,4,5 count=2 factor=3
expect: => i=2 r=0.0 ok=true s="scaled 2 suffix items" errors=0 n=4 res=[2,3,12,15] cache=0 hits=0
