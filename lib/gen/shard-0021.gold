kind: step
verb: sort
noun: results
modifier: running
context: filter
slot: min_val int
phrase: sort filtered results running above baseline {min_val}
phrase: order running results maintaining minimum value {min_val}
test: list=20,5,15,40,10 min_val=12
expect: => i=3 r=0.0 ok=true s="sorted running count: 3" errors=0 n=3 res=[15,20,40] cache=0 hits=0
test: list=8,30,4,22,18 min_val=15
expect: => i=3 r=0.0 ok=true s="sorted running count: 3" errors=0 n=3 res=[18,22,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mv {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted running count: ", g.n);
	out
}
@end
@entry 905d9fe6da0bcb68
kind: step
verb: repeat
noun: step
modifier: times
context: filter
slot: iterations int
phrase: repeat filter step exactly {iterations} times
phrase: apply step filtering repeated {iterations} times
test: list=10,50,20,40,30 iterations=2
expect: => i=3 r=0.0 ok=true s="repeated filter remaining: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=15,25,5,35 iterations=1
expect: => i=3 r=0.0 ok=true s="repeated filter remaining: 3" errors=0 n=3 res=[15,25,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let it = ${iterations};
	var step_count = 0;
	while step_count < it && g.n > 1 {
		var max_idx = 0;
		for i in 1..g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
		}
		var j = max_idx;
		while j + 1 < g.n {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n--;
		step_count++;
	}
	g.steps += g.n + step_count;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated filter remaining: ", g.n);
	out
}
@end
