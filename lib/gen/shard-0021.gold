@entry fe24b5f4cbf08dd2
kind: step
verb: repeat
noun: range
modifier: running
context: filter
slot: factor int
phrase: repeat range running values multiplied by {factor}
phrase: replicate running range elements by factor {factor}
test: list=2,5,8 factor=2
expect: => i=6 r=0.0 ok=true s="running range total: 6" errors=0 n=6 res=[2,2,5,5,8,8] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=6 r=0.0 ok=true s="running range total: 6" errors=0 n=6 res=[10,10,10,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var orig = [0; 512];
	let old_n = g.n;
	for i in old_n { orig[i] = g.res[i]; }
	g.n = 0;
	for i in old_n {
		var k = 0;
		while k < fac && g.n < 512 {
			g.res[g.n] = orig[i];
			g.n++;
			k++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "running range total: ", g.n);
	out
}
@end
