@entry 5c9c4d90fc482528
kind: pred
verb: dedupe
noun: loop
modifier: until
context: retry
phrase: dedupe loop until digit sum reaches {limit}
phrase: halt duplicate loop when digit sum reaches {limit}
slot: limit int
test: arg=15,35 limit=7
expect: false
expect: true
test: arg=44 limit=7
expect: true
code:
fn ${ID}(n int) bool {
	let lim = ${limit};
	var attempts = n;
	if attempts < 0 {
		attempts = -attempts;
	}
	var cycle = 0;
	while attempts > 0 {
		cycle += attempts % 10;
		attempts /= 10;
	}
	return cycle >= lim;
}
@end
@entry 3b82fc1d25e3aa7f
