@entry 6a940da60b2c6eb8
kind: step
verb: fold
noun: window
modifier: first
context: filter
slot: win_size int
phrase: fold window first elements across span {win_size}
phrase: sum initial window of filtered items {win_size}
test: list=10,20,30,40,50 win_size=3
expect: => i=60 r=0.0 ok=true s="folded window sum: 60" errors=0 n=3 res=[60,40,50] cache=0 hits=0
test: list=5,15,25,35 win_size=2
expect: => i=20 r=0.0 ok=true s="folded window sum: 20" errors=0 n=3 res=[20,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var span = if ws > g.n { g.n } else { ws };
	if span < 0 { span = 0; }
	var sum = 0;
	for i in span { sum += g.res[i]; }
	var kept = 1;
	g.res[0] = sum;
	var i = span;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded window sum: ", sum);
	out
}
@end
@entry a39a8055a4660d7d
kind: step
verb: repeat
noun: histogram
modifier: safely
context: filter
slot: factor int
phrase: repeat histogram safely multiplying counts by {factor}
phrase: expand item frequency histogram safely by {factor}
test: list=10,20 factor=2
expect: => i=4 r=0.0 ok=true s="repeated histogram total: 4" errors=0 n=4 res=[10,10,20,20] cache=0 hits=0
test: list=5,15,25 factor=1
expect: => i=3 r=0.0 ok=true s="repeated histogram total: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var orig = [0; 512];
	let old_n = g.n;
	for i in old_n { orig[i] = g.res[i]; }
	g.n = 0;
	for i in old_n {
		var k = 0;
		while k < fac && g.n < 512 {
			g.res[g.n] = orig[i];
			g.n++;
			k++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated histogram total: ", g.n);
	out
}
@end
