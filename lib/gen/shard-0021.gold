test: list=12,18,24
expect: => i=12 r=0.0 ok=true s="adjacent pair gcd sum: 12" errors=0 n=3 res=[12,18,24] cache=0 hits=0
test: list=15,28,7
expect: => i=8 r=0.0 ok=true s="adjacent pair gcd sum: 8" errors=0 n=3 res=[15,28,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_gcd = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			var a = g.res[i];
			var b = g.res[i + 1];
			if a < 0 { a = -a; }
			if b < 0 { b = -b; }
			while b != 0 {
				let t = b;
				b = a % b;
				a = t;
			}
			total_gcd += a;
			i++;
		}
	}
	g.steps += g.n;
	out.i = total_gcd;
	out.s.clear();
	format(out.s, "adjacent pair gcd sum: ", total_gcd);
	out
}
@end
