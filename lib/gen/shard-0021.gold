fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_avg};
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	out.ok = (avg <= m);
	out.i = avg;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "average ", avg, " at most ", m);
	out
}
