	var i = 0;
	while i < g.n {
		let mid = i + sp / 2;
		if mid < g.n {
			g.res[kept] = g.res[mid];
			kept++;
		}
		i += sp;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "middle values extracted: ", kept);
