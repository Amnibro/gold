@entry b5a3ae22cdcb5fd3
kind: step
verb: drop
noun: minimum
modifier: recursively
context: stats
slot: times int
phrase: drop minimum recursively iterations {times}
phrase: remove sample minimum recursively count {times}
test: list=8,2,6,4 times=1
expect: => i=1 r=0.0 ok=true s="minimums dropped: 1" errors=0 n=3 res=[8,6,4] cache=0 hits=0
test: list=15,3,9,1 times=2
expect: => i=2 r=0.0 ok=true s="minimums dropped: 2" errors=0 n=2 res=[15,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var dropped = 0;
	while dropped < t && g.n > 0 {
		var min_idx = 0;
		for i in g.n {
			if g.res[i] < g.res[min_idx] { min_idx = i; }
		}
		var j = min_idx;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n--;
		dropped++;
	}
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "minimums dropped: ", dropped);
	out
}
@end
