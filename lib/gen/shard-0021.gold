fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var k = g.n - 1;
	while k >= 0 {
		if k % 2 == 0 {
			g.res[count] = g.res[k];
			count++;
		}
		k--;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "sel_chk_rev");
	out
}
@end
