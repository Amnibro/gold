@entry 1fb3610c87cf5cd9
kind: step
verb: mottle
noun: stone
modifier: noisy
context: texture
phrase: mottle noisy stone texture with seed {u}
phrase: render noisy stone pattern from seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; contrast a=1.15; blur
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="stone" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.2 max=0.897 sum8=41115 hash=174824
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="stone" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.045 max=0.913 sum8=123176 hash=570690
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.15 + 0.5); }
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stone");
	out
}
@end
