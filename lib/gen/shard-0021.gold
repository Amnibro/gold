code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var span = if ws > g.n { g.n } else { ws };
	if span < 0 { span = 0; }
	for i in span {
		for j in i + 1..span {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += span * span;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted window size: ", span);
	out
}
@end
