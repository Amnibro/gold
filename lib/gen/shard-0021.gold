code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for k in g.n {
		g.res[k] = g.res[k] * g.res[k];
	}
	var limit = t;
	if limit > g.n / 2 { limit = g.n / 2; }
	for p in limit {
		g.res[p] = g.res[p * 2] + g.res[p * 2 + 1];
	}
	if limit > 0 { g.n = limit; }
	g.steps += g.n + limit;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged squares ", limit, " times");
	out
}
@end
