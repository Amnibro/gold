@entry e006ef5e3fa5e001
kind: fn
verb: rotate
noun: budget
modifier: none
context: retry
phrase: rotate budget none without allocation change
phrase: cycle retry budget slots preserving total
test: arg=123,45
expect: 231
expect: 54
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	if v < 10 {
		return v;
	}
	var mul = 1;
	var rem = v;
	while rem >= 10 {
		mul *= 10;
		rem /= 10;
	}
	let lead = rem;
	let rest = v % mul;
	return rest * 10 + lead;
}
@end
