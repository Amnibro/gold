@entry 763ca0d065a32f5b
kind: step
verb: limit
noun: window
modifier: unique
context: sort
phrase: sort limit window unique preserving first {k} distinct entries
phrase: restrict sorted sequence to first {k} unique values
slot: k int
test: list=1,1,2,3,3,4 k=2
expect: => i=3 r=0.0 ok=true s="limited sequence to 3 elements" errors=0 n=3 res=[1,1,2] cache=0 hits=0
test: list=5,5,6,7 k=1
expect: => i=1 r=0.0 ok=true s="limited sequence to 1 elements" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	var distinct = 0;
	var cut = g.n;
	var i = 0;
	while i < g.n {
		distinct++;
		if distinct == req {
			cut = i + 1;
			break;
		}
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		i = j;
	}
	g.n = cut;
	out.i = cut;
	out.s.clear();
	format(out.s, "limited sequence to ", cut, " elements");
	out
}
@end
