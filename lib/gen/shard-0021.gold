code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var w = 0;
	var i = 0;
	while i < g.n {
		var cur = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == cur {
			cur += g.res[j];
			j++;
		}
		g.res[w] = cur;
		w++;
		i = j;
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "merged duplicates ", w);
	out
}
@end
