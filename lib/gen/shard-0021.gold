fn ${ID}(n int) int {
	let st = ${stride};
	if st <= 0 { return 0; }
	var x = if n < 0 { -n } else { n };
	var chunk_sum = 0;
	var total = 0;
	var idx = 0;
	while x > 0 {
		let d = x % 10;
		chunk_sum += d;
		idx++;
		if idx % st == 0 {
			total += chunk_sum;
			chunk_sum = 0;
		}
		x /= 10;
	}
	total + chunk_sum
}
@end
@entry 1b4007eb07fd4eb2
kind: fn
verb: find
noun: maximum
modifier: all
context: core
phrase: find maximum all digits bias {offset}
phrase: locate maximum digit with bias {offset}
slot: offset int
test: arg=294,158 offset=10
expect: 19
expect: 18
test: arg=731,902 offset=5
expect: 12
expect: 14
code:
fn ${ID}(n int) int {
	let off = ${offset};
	var x = if n < 0 { -n } else { n };
	var max_d = 0;
	if x == 0 { return off; }
	while x > 0 {
		let d = x % 10;
		if d > max_d { max_d = d; }
		x /= 10;
	}
	max_d + off
}
@end
