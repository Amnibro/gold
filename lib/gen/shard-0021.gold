@entry ba202fb6e58a0694
kind: fn
verb: fill
noun: odds
modifier: unique
context: core
phrase: fill odds unique count weight {weight}
phrase: score unique odd digits with weight {weight}
slot: weight int
test: arg=113355,2468 weight=7
expect: 21
expect: 0
test: arg=13579,999 weight=4
expect: 20
expect: 4
code:
fn ${ID}(n int) int {
	let w = ${weight};
	var x = if n < 0 { -n } else { n };
	var seen = 0;
	var count = 0;
	while x > 0 {
		let d = x % 10;
		if d % 2 != 0 {
			let mask = 1 << d;
			if (seen & mask) == 0 {
				seen = seen | mask;
				count++;
			}
		}
		x /= 10;
	}
	count * w
}
@end
