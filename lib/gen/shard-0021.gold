kind: step
verb: limit
noun: sequence
modifier: in_reverse
context: transform
phrase: limit sequence elements in reverse to count {cap}
phrase: truncate reversed sequence items to limit {cap}
slot: cap int
test: list=1,2,3,4,5 cap=3
expect: => i=3 r=0.0 ok=true s="limited sequence in reverse" errors=0 n=3 res=[5,4,3] cache=0 hits=0
test: list=10,20,30 cap=2
expect: => i=2 r=0.0 ok=true s="limited sequence in reverse" errors=0 n=2 res=[30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if limit <= 0 { gold_fail(g, "invalid limit"); out.ok = false; return out; }
	var p1 = 0;
	var p2 = g.n - 1;
	while p1 < p2 {
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		p1++;
		p2--;
	}
	if g.n > limit { g.n = limit; }
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "limited sequence in reverse");
	return out;
}
@end
