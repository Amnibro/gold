@entry 85f82f5c8340dd9e
kind: step
verb: merge
noun: minimum
modifier: recursively
context: error
phrase: merge minimum recursively up to depth {depth}
phrase: reduce pairs taking minimum recursively {depth} times
slot: depth int
test: list=10,4,8,2 depth=2
expect: => i=1 r=0.0 ok=true s="merged minimum remaining: 1" errors=0 n=1 res=[2] cache=0 hits=0
test: list=20,15,30,5 depth=1
expect: => i=2 r=0.0 ok=true s="merged minimum remaining: 2" errors=0 n=2 res=[15,5] cache=0 hits=0
test: list=1,2 depth=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${depth} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var d = 0;
	while d < ${depth} && g.n > 1 {
		var new_n = 0;
		var i = 0;
		while i < g.n {
			if i + 1 < g.n {
				let m = if g.res[i] < g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
				g.res[new_n] = m;
				i += 2;
		} else {
				g.res[new_n] = g.res[i];
				i++;
		}
			new_n++;
		}
		g.n = new_n;
		d++;
	}
	g.steps += d;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged minimum remaining: ", g.n);
	out
}
@end
