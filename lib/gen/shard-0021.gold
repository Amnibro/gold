fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var max_val = 0;
	var ok = true;
	for i in g.n {
		if i == 0 || g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	if max_val > c {
		ok = false;
		gold_fail(g, "exceeded maximum");
	}
	g.steps += g.n;
	out.ok = ok;
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum: ", max_val);
	out
}
@end
