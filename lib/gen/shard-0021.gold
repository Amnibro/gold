code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let t = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = t;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rev_list_at_least");
	out
}
@end
