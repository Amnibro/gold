code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${min_bound};
	let mx = ${max_bound};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mn && x <= mx {
			g.res[kept] = x;
			kept++;
		}
	}
	if kept > 0 {
		g.n = kept;
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "safely filtered in range: ", kept);
	out
}
@end
