@entry 043d395e225366ec
kind: step
verb: fill
noun: gaps
modifier: safely
context: list
slot: step_inc int
phrase: fill gaps safely with increment step {step_inc}
phrase: interpolate list gaps safely using step {step_inc}
phrase: bridge list intervals safely with step {step_inc}
test: list=1,10,20 step_inc=5
expect: => i=2 r=0.0 ok=true s="interpolated gaps added: 2" errors=0 n=5 res=[1,6,10,15,20] cache=0 hits=0
test: list=2,8 step_inc=2
expect: => i=2 r=0.0 ok=true s="interpolated gaps added: 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let inc = ${step_inc};
	if g.n <= 1 || inc <= 0 { return out; }
	var temp int[512] = [0; 512];
	var tn = 0;
	temp[0] = g.res[0];
	tn++;
	var i = 1;
	while i < g.n {
		let prev = temp[tn - 1];
		let cur = g.res[i];
		var fill = prev + inc;
		while fill < cur && tn < 500 {
			temp[tn] = fill;
			tn++;
			fill += inc;
		}
		if tn < 512 {
			temp[tn] = cur;
			tn++;
		}
		i++;
	}
	for j in tn { g.res[j] = temp[j]; }
	g.steps += tn;
	out.i = tn - g.n;
	g.n = tn;
	out.s.clear();
	format(out.s, "interpolated gaps added: ", out.i);
	out
}
@end
