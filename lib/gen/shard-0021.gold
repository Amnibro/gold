fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var run = 0;
	var kept = 0;
	for k in g.n {
		if run + g.res[k] > ms { break; }
		run += g.res[k];
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = run;
	out.s.clear();
	format(out.s, "selected prefix of ", kept, " items total ", run);
	out
}
@end
