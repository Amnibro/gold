expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${cr}; let gr = ${cg}; let b = ${cb};
	if r < 0 || r > 255 || gr < 0 || gr > 255 || b < 0 || b > 255 { gold_fail(g, "invalid rgb parameters"); out.ok = false; return out; }
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "gate not found"); out.ok = false; return out; }
	var o byte[>..] = [];
	o.push(' ');
	o.append("m:emissive ");
	gold_hex(o, r, gr, b);
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tintgate");
	out
}
@end
