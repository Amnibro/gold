fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let k = ${count};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= fl && kept < k {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept first condition: ", kept);
	out
}
@end
