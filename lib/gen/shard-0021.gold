fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	gold_words_of(g, out.s);
	var kept = 0;
	for k in g.wn {
		if g.wl[k].len <= lim {
			if kept != k {
				g.wl[kept].clear();
				for b in g.wl[k] { g.wl[kept].push(b); }
			}
			kept++;
		}
	}
	g.wn = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " words");
	out
}
@end
