@entry 3793764b34bbc571
kind: pred
verb: compare
noun: average
modifier: between
context: core
phrase: compare average between bounds {bound}
phrase: test core digit average between threshold {bound}
slot: bound int
test: arg=135,246 bound=3
expect: true
expect: true
test: arg=102,99 bound=5
expect: false
expect: true
code:
fn ${ID}(n int) bool {
	let b = ${bound};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0 >= b; }
	var sum = 0;
	var count = 0;
	while x > 0 {
		sum += x % 10;
		count++;
		x /= 10;
	}
	let avg = sum / count;
	avg >= b
}
@end
