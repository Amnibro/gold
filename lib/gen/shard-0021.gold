kind: step
verb: join
noun: pairs
modifier: in_reverse
context: retry
slot: stride int
phrase: join pairs in reverse order stride {stride}
phrase: combine adjacent pairs in reverse stride {stride}
test: list=1,2,3,4 stride=1
expect: => i=2 r=0.0 ok=true s="joined pairs: 2" errors=0 n=2 res=[7,3] cache=0 hits=0
test: list=10,20,30,40,50,60 stride=1
expect: => i=3 r=0.0 ok=true s="joined pairs: 3" errors=0 n=3 res=[110,70,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	let pairs = g.n / 2;
	var i = 0;
	while i < pairs {
		let p1 = g.res[2 * i];
		let p2 = g.res[2 * i + 1];
		g.res[i] = p1 + p2;
		i++;
	}
	var left = 0;
	var right = pairs - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "joined pairs: ", pairs);
	out
}
@end
