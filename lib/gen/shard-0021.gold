fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bgt = ${budget};
	var sum = 0;
	var kept = 0;
	while kept < g.n {
		if sum + g.res[kept] > bgt { break; }
		sum += g.res[kept];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "budget kept elements: ", kept);
	out
}
@end
@entry 7c75696bbf584c7a
kind: step
verb: swap
noun: runs
modifier: safely
context: list
phrase: swap runs safely between boundaries in list
phrase: safely swap runs of equal values across list
test: list=1,1,3,4,5,5
expect: => i=2 r=0.0 ok=true s="swapped runs safely: 2" errors=0 n=6 res=[5,5,3,4,1,1] cache=0 hits=0
test: list=2,2,3
expect: => i=1 r=0.0 ok=true s="swapped runs safely: 1" errors=0 n=3 res=[3,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var first = -1;
	var last = -1;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] == g.res[k + 1] {
			if first < 0 { first = k; }
			last = k;
		}
		k++;
	}
	if first >= 0 && last >= 0 && first != last {
		let tmp0 = g.res[first];
		let tmp1 = g.res[first + 1];
		g.res[first] = g.res[last];
		g.res[first + 1] = g.res[last + 1];
		g.res[last] = tmp0;
		g.res[last + 1] = tmp1;
		out.i = 2;
	} else {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		out.i = 1;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped runs safely: ", out.i);
	out
}
@end
@entry 19010e68449a0542
kind: step
verb: reverse
noun: checkpoint
modifier: at_least
context: list
slot: threshold int
phrase: reverse checkpoint at least threshold {threshold} boundary in list
phrase: list reverse checkpoint at least value {threshold} span
test: list=1,10,2,3,20,4 threshold=10
expect: => i=4 r=0.0 ok=true s="reversed checkpoint span: 4" errors=0 n=6 res=[1,20,3,2,10,4] cache=0 hits=0
test: list=5,6,7 threshold=20
expect: => i=0 r=0.0 ok=true s="reversed checkpoint span: 0" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var first = -1;
	var last = -1;
	for k in g.n {
		if g.res[k] >= th {
			if first < 0 { first = k; }
			last = k;
		}
	}
	if first >= 0 && last > first {
		var i = first;
		var j = last;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		out.i = last - first + 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reversed checkpoint span: ", out.i);
	out
}
@end
