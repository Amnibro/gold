code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var count = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > mg { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "large gaps: ", count);
	out
}
@end
