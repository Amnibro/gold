phrase: move maximum to end with cache entry {dummy}
test: list=3,9,1,5 dummy=0
expect: => i=9 r=0.0 ok=true s="maximum cached: 9" errors=0 n=4 res=[3,5,1,9] cache=1 hits=0
test: list=12,4,8 dummy=0
expect: => i=12 r=0.0 ok=true s="maximum cached: 12" errors=0 n=3 res=[8,4,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${dummy};
	var max_idx = 0;
	if g.n > 0 {
		for i in g.n {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		let max_val = g.res[max_idx];
		let tmp = g.res[g.n - 1];
		g.res[g.n - 1] = max_val;
		g.res[max_idx] = tmp;
		gold_cache_put(g, 0, max_val);
		out.i = max_val;
	} else {
		out.i = 0;
	}
	g.steps += g.n + d;
	out.s.clear();
	format(out.s, "maximum cached: ", out.i);
	out
}
@end
