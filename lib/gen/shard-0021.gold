fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var low_idx = -1;
	var high_idx = -1;
	for i in g.n {
		if g.res[i] < th && low_idx < 0 { low_idx = i; }
		if g.res[i] >= th { high_idx = i; }
	}
	g.steps += g.n;
	if low_idx >= 0 && high_idx >= 0 && low_idx != high_idx {
		let tmp = g.res[low_idx];
		g.res[low_idx] = g.res[high_idx];
		g.res[high_idx] = tmp;
		out.i = 1;
		out.s.clear();
		format(out.s, "swapped elements across threshold");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "no threshold swap performed");
	}
	out
}
@end
