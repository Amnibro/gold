expect: => i=6 r=0.0 ok=true s="reverse histogram ordered: 6" errors=0 n=6 res=[3,3,3,2,2,1] cache=0 hits=0
test: list=5,5,10
expect: => i=3 r=0.0 ok=true s="reverse histogram ordered: 3" errors=0 n=3 res=[5,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			var fi = 0;
			var fj = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { fi++; }
				if g.res[k] == g.res[j] { fj++; }
			}
			if fj > fi || (fj == fi && g.res[j] > g.res[i]) {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse histogram ordered: ", g.n);
	out
}
@end
