phrase: select threshold unique values above {threshold}
phrase: extract unique sorted items above threshold {threshold}
test: list=5,8,3,8,2,9 threshold=5
expect: => i=3 r=0.0 ok=true s="unique above threshold: 3" errors=0 n=3 res=[5,8,9] cache=0 hits=0
test: list=1,1,4,4,2 threshold=3
expect: => i=1 r=0.0 ok=true s="unique above threshold: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= th {
			if kept == 0 || g.res[kept - 1] != x {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique above threshold: ", kept);
	out
}
@end
