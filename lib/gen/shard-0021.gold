code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var dsum = 0;
		while x > 0 {
			dsum += x % 10;
			x /= 10;
		}
		g.res[k] = dsum;
		total_digits += dsum;
	}
	g.steps += g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "scanned digits total sum ", total_digits);
	out
}
@end
