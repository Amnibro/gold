code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ${cap} {
			g.res[i] = ${cap};
			clamped++;
		}
	}
	out.i = clamped;
	gold_text(out, "mapped threshold at most");
	return out;
}
@end
@entry f867403a7000b306
kind: step
verb: retry
noun: limit
modifier: recursively
context: transform
phrase: retry limit reduction recursively until ceiling {cap}
phrase: reduce values above limit recursively down toward {cap}
slot: cap int
test: list=35,50,15 cap=20
expect: => i=3 r=0.0 ok=true s="retried limit recursively" errors=0 n=3 res=[17,12,15] cache=0 hits=0
test: list=100,80,10 cap=30
expect: => i=4 r=0.0 ok=true s="retried limit recursively" errors=0 n=3 res=[25,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var steps = 0;
	for i in g.n {
		while g.res[i] > ${cap} {
			g.res[i] /= 2;
			steps++;
		}
	}
	out.i = steps;
	gold_text(out, "retried limit recursively");
	return out;
}
@end
