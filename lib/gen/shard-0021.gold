fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	let start = if g.n > count { g.n - count } else { 0 };
	var sum = 0;
	for i in start..g.n { sum += g.res[i]; }
	g.res[0] = sum;
	g.n = 1;
	g.steps += count;
	out.i = sum;
	gold_text(out, "summed last results");
	return out;
}
@end
@entry 219d34d467856aef
kind: step
verb: group
noun: list
modifier: in_reverse
context: transform
phrase: group list elements reversed within chunk size {size}
phrase: partition into chunks of size {size} in reverse
slot: size int
test: list=1,2,3,4,5,6 size=3
expect: => i=6 r=0.0 ok=true s="grouped list in reverse" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=4 r=0.0 ok=true s="grouped list in reverse" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 { gold_fail(g, "invalid chunk size"); out.ok = false; return out; }
	var i = 0;
	while i < g.n {
		let end = if i + sz < g.n { i + sz } else { g.n };
		var p1 = i;
		var p2 = end - 1;
		while p1 < p2 {
			let tmp = g.res[p1];
			g.res[p1] = g.res[p2];
			g.res[p2] = tmp;
			p1++;
			p2--;
		}
		i += sz;
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "grouped list in reverse");
	return out;
}
@end
