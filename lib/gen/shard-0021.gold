test: list=2,3 cap=-10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${cap} <= 0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var clamped = 0;
	var i = 0;
	while i < g.n {
		let sq = g.res[i] * g.res[i];
		if sq > ${cap} {
			g.res[i] = ${cap};
			clamped++;
		} else {
			g.res[i] = sq;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped squares: ", clamped);
	out
}
@end
