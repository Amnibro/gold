@entry 67cf8c7d303e23c1
kind: step
verb: clamp
noun: counter
modifier: unique
context: math
slot: max_unique int
phrase: clamp counter unique items to maximum {max_unique}
phrase: restrict unique element count to limit {max_unique}
test: list=1,1,2,2,3,4,5 max_unique=2
expect: => i=2 r=0.0 ok=true s="unique elements clamped: 2" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=10,20,30,40 max_unique=3
expect: => i=3 r=0.0 ok=true s="unique elements clamped: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mu = ${max_unique};
	var seen int[256] = [0; 256];
	var n_seen = 0;
	var cut_idx = g.n;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		for s in n_seen {
			if seen[s] == x { exists = true; break; }
		}
		if !exists {
			if n_seen >= mu {
				cut_idx = i;
				break;
			}
			seen[n_seen] = x;
			n_seen++;
		}
		i++;
	}
	g.n = cut_idx;
	g.steps += i;
	out.i = n_seen;
	out.s.clear();
	format(out.s, "unique elements clamped: ", n_seen);
	out
}
@end
