code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	let val, ok = gold_cache_get(g, out.i);
	if ok {
		out.i = val;
	} else {
		out.i = fb;
	}
	gold_push(g, out.i);
	g.steps++;
	out.s.clear();
	format(out.s, "safely returned cache value ", out.i);
	out
}
@end
@entry beb8fd3846fe95d9
kind: step
verb: fold
noun: runs
modifier: in_reverse
context: filter
phrase: fold consecutive runs in reverse direction
phrase: collapse identical sequence runs backwards
test: list=2,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="folded 3 runs in reverse" errors=0 n=3 res=[4,3,2] cache=0 hits=0
test: list=1,1,1,5,5,6,6
expect: => i=3 r=0.0 ok=true s="folded 3 runs in reverse" errors=0 n=3 res=[6,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var collapsed = [0; 256];
	var cn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var run_len = 1;
		while i > 0 && g.res[i - 1] == val {
			run_len++;
			i--;
		}
		if cn < 256 {
			collapsed[cn] = val;
			cn++;
		}
		i--;
	}
	for j in cn { g.res[j] = collapsed[j]; }
	g.steps += g.n;
	g.n = cn;
	out.i = cn;
	out.s.clear();
	format(out.s, "folded ", cn, " runs in reverse");
	out
}
@end
