code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r < n { r++; }
	r * r == n
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_sq(x) {
			var dup = false;
			for j in kept {
				if g.res[j] == x { dup = true; break; }
			}
			if !dup {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n + kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " unique squares");
	out
}
@end
