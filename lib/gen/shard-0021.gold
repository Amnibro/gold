@entry 3dc97b5f201e82f6
kind: step
verb: check
noun: loop
modifier: times
context: sort
slot: times int
phrase: check loop times passes count {times}
phrase: verify sorting check loop times iterations {times}
test: list=3,2,1 times=1
expect: => i=0 r=0.0 ok=true s="sorted after loops: 0" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=3,2,1 times=2
expect: => i=1 r=0.0 ok=true s="sorted after loops: 1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var step = 0;
	while step < t {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
		step++;
	}
	var is_sorted = 1;
	var j = 0;
	while j + 1 < g.n {
		if g.res[j] > g.res[j + 1] {
			is_sorted = 0;
			break;
		}
		j++;
	}
	g.steps += step * g.n;
	out.i = is_sorted;
	out.s.clear();
	format(out.s, "sorted after loops: ", is_sorted);
	out
}
@end
@entry 172af32dee8ae4d6
kind: step
verb: check
noun: steps
modifier: while
context: sort
slot: max_steps int
phrase: check steps while unsorted up to limit {max_steps}
phrase: trace check steps while ordering passes {max_steps}
test: list=1,3,2,4 max_steps=5
expect: => i=2 r=0.0 ok=true s="sort steps taken: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2,3 max_steps=5
expect: => i=1 r=0.0 ok=true s="sort steps taken: 1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${max_steps};
	var steps_taken = 0;
	while steps_taken < max_s {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		steps_taken++;
		if !swapped { break; }
	}
	g.steps += steps_taken * g.n;
	out.i = steps_taken;
	out.s.clear();
	format(out.s, "sort steps taken: ", steps_taken);
	out
}
@end
