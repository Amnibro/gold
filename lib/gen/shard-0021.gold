test: list=50,15,30 bound=20
expect: => i=15 r=0.0 ok=true s="repeated first bounded: 15" errors=0 n=4 res=[15,50,15,30] cache=0 hits=0
test: list=40,8,12 bound=10
expect: => i=8 r=0.0 ok=true s="repeated first bounded: 8" errors=0 n=4 res=[8,40,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var match_idx = -1;
	for i in g.n {
		if g.res[i] <= b { match_idx = i; break; }
	}
	if match_idx >= 0 && g.n < 512 {
		let val = g.res[match_idx];
		var i = g.n;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = val;
		g.n++;
		out.i = val;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "repeated first bounded: ", out.i);
	out
}
@end
