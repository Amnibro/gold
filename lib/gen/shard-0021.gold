fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > limit {
			let overflow = g.res[i] - limit;
			gold_cache_put(g, i, overflow);
			g.res[i] = limit;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	gold_text(out, "limited numbers with cache");
	return out;
}
@end
