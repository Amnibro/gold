@entry 507d79d1b51dbaf2
kind: step
verb: reverse
noun: threshold
modifier: all
context: aggregate
slot: threshold int
phrase: reverse threshold all elements exceeding {threshold}
phrase: invert order of all values above {threshold}
test: list=5,20,8,25,30 threshold=15
expect: => i=3 r=0.0 ok=true s="reversed 3 items above threshold 15" errors=0 n=5 res=[5,30,8,25,20] cache=0 hits=0
test: list=12,4,18,9,22 threshold=10
expect: => i=3 r=0.0 ok=true s="reversed 3 items above threshold 10" errors=0 n=5 res=[22,4,18,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var idxs int[256] = [0; 256];
	var count = 0;
	for k in g.n {
		if g.res[k] > th {
			idxs[count] = k;
			count++;
		}
	}
	for k in count / 2 {
		let i1 = idxs[k];
		let i2 = idxs[count - 1 - k];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " items above threshold ", th);
	out
}
@end
@entry 6dab079ed2b71bff
kind: step
verb: count
noun: histogram
modifier: running
context: aggregate
slot: bucket_size int
phrase: count histogram running buckets of size {bucket_size}
phrase: tally running histogram buckets sized {bucket_size}
test: list=5,8,12,19 bucket_size=10
expect: => i=4 r=0.0 ok=true s="counted 4 running histogram buckets" errors=0 n=4 res=[5,8,12,19] cache=0 hits=0
test: list=10,25,15,30 bucket_size=20
expect: => i=4 r=0.0 ok=true s="counted 4 running histogram buckets" errors=0 n=4 res=[10,25,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bucket_size};
	if bs <= 0 { return out; }
	var run = 0;
	var last_bucket = -1;
	var buckets = 0;
	for k in g.n {
		run += g.res[k];
		let b = run / bs;
		if b != last_bucket {
			buckets++;
			last_bucket = b;
		}
	}
	g.steps += g.n;
	out.i = buckets;
	out.s.clear();
	format(out.s, "counted ", buckets, " running histogram buckets");
	out
}
@end
