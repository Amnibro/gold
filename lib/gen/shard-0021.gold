code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let off = ${offset};
	var k = c;
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	let start = g.n - k;
	var i = start;
	while i < g.n {
		g.res[i] -= off;
		i++;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "tail normalized count: ", k);
	out
}
@end
