fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let sc = ${scale};
	var k = c;
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	if sc > 0 {
		let start = g.n - k;
		var i = start;
		while i < g.n {
			g.res[i] /= sc;
			i++;
		}
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "tail normalized: ", k);
	out
}
