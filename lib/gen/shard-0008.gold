code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	var u_arr int[512] = [0; 512];
	var u_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_cnt {
			if u_arr[j] == x { seen = true; }
		}
		if !seen {
			u_arr[u_cnt] = x;
			u_cnt++;
			if u_cnt == target { break; }
		}
	}
	for i in u_cnt {
		gold_push(g, u_arr[i]);
	}
	g.steps += g.n + u_cnt;
	out.i = u_cnt;
	out.s.clear();
	format(out.s, "repeated ", u_cnt, " unique head items");
	out
}
@end
