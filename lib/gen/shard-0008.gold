fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_word = true;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c == ' ' {
			new_word = true;
		} else if new_word {
			if c >= 'a' && c <= 'z' {
				out.s[i] = (c - 32) as byte;
