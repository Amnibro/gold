kind: step
verb: drop
noun: condition
modifier: until
context: sort
phrase: drop sorted elements until reaching value {threshold}
phrase: discard leading items strictly smaller than {threshold}
slot: threshold int
test: list=2,5,8,12,18 threshold=10
expect: => i=2 r=0.0 ok=true s="retained 2 items from threshold" errors=0 n=2 res=[12,18] cache=0 hits=0
