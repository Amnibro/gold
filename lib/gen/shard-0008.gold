fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let first = g.res[0];
	for i in g.n - 1 {
		g.res[i] = g.res[i] + g.res[i + 1];
	}
	g.res[g.n - 1] = g.res[g.n - 1] + first;
	g.steps += g.n + 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired loop all count ", g.n);
	out
}
