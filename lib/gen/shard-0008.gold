test: arg=1234 limit=1
expect: 1243
test: arg=123456 limit=2
expect: 124365
code:
fn ${ID}(n int) int {
	let max_swaps = ${limit};
	var x = if n < 0 { -n } else { n };
	var digits = [0; 20];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < len && swaps < max_swaps {
		let tmp = digits[i];
		digits[i] = digits[i + 1];
		digits[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	var res = 0;
	var idx = len - 1;
	while idx >= 0 {
		res = res * 10 + digits[idx];
		idx--;
	}
	res
}
@end
