@entry de10d6af2ba49934
kind: step
verb: keep
noun: runs
modifier: last
context: compare
phrase: keep final run of equal comparison values
phrase: retain last run of identical results
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="kept last run of 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=5,6,7
expect: => i=1 r=0.0 ok=true s="kept last run of 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		g.steps++;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		count++;
		i--;
	}
	g.n = count;
	for k in count {
		g.res[k] = last_val;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "kept last run of ", count);
	g.steps += count;
	out
}
@end
