code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		g.steps++;
		return out;
	}
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		g.res[count] = diff;
		count++;
		i += 2;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise differences count: ", count);
	g.steps += count;
	out
}
