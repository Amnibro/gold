test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="grouped primes count 3" errors=0 n=5 res=[2,3,5,4,6] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var non_primes int[512] = [0; 512];
	var pn = 0;
	var non_pn = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		} else {
			non_primes[non_pn] = g.res[i];
			non_pn++;
		}
	}
	for i in pn {
		g.res[i] = primes[i];
	}
	for i in non_pn {
		g.res[pn + i] = non_primes[i];
	}
	out.i = pn;
	out.s.clear();
	format(out.s, "grouped primes count ", pn);
	g.steps += g.n + 2;
	out
}
@end
