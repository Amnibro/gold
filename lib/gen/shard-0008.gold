@entry d24c637330c34dbe
kind: step
verb: group
noun: tail
modifier: all
context: text
phrase: group all tail characters into reversed suffix
phrase: collect all trailing characters into text tail
test: input=3 text="abcdef"
expect: => i=3 r=0.0 ok=true s="grouped all 3 tail characters" errors=0 n=3 res=[100,101,102] cache=0 hits=0
test: input=2 text="hello"
expect: => i=2 r=0.0 ok=true s="grouped all 2 tail characters" errors=0 n=2 res=[108,111] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = v.i;
	gold_clear(g);
	if k <= 0 || out.s.len == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty tail");
		return out;
	}
	var start = out.s.len - k;
	if start < 0 {
		start = 0;
	}
	var i = start;
	while i < out.s.len {
		gold_push(g, out.s[i] as int);
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped all ", g.n, " tail characters");
	g.steps += g.n;
	out
}
@end
