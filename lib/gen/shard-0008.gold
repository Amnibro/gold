code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_avg};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	if avg >= limit && g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "average check: ", avg);
	g.steps += g.n + 1;
	out
}
@end
