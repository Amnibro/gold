@entry b66eedc8a763f658
kind: step
verb: pull
noun: average
modifier: in_place
context: math
phrase: pull item closest to average to output in place
phrase: select element nearest to mean in place
test: list=10,22,50
expect: => i=22 r=0.0 ok=true s="pulled 22 nearest to mean 27" errors=0 n=3 res=[10,22,50] cache=0 hits=0
test: list=2,9
expect: => i=2 r=0.0 ok=true s="pulled 2 nearest to mean 5" errors=0 n=2 res=[2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("empty list");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	var best = g.res[0];
	var best_dist = best - avg;
	if best_dist < 0 {
		best_dist = -best_dist;
	}
	i = 1;
	while i < g.n {
		let x = g.res[i];
		var dist = x - avg;
		if dist < 0 {
			dist = -dist;
		}
		if dist < best_dist {
			best_dist = dist;
			best = x;
		}
		i += 1;
	}
	out.i = best;
	out.ok = true;
	out.s.clear();
	format(out.s, "pulled ", best, " nearest to mean ", avg);
	g.steps += g.n;
	out
}
@end
