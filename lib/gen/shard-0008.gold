test: input=482
expect: => i=3 r=0.0 ok=true s="collected 3 digits" errors=0 n=3 res=[4,8,2] cache=0 hits=0
test: input=-5
expect: => i=-5 r=0.0 ok=false s="error: negative input" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i < 0 {
		gold_fail(g, "negative input has no valid digits");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative input");
		return out;
	}
	var num = out.i;
	var d_count = 0;
	if num == 0 {
		gold_push(g, 0);
		d_count = 1;
	} else {
		var temp = num;
		var rev = 0;
		while temp > 0 {
			rev = rev * 10 + (temp % 10);
			temp /= 10;
			d_count++;
		}
		while rev > 0 {
			gold_push(g, rev % 10);
			rev /= 10;
		}
	}
	g.steps += d_count;
	out.i = d_count;
	out.s.clear();
	format(out.s, "collected ", d_count, " digits");
	out
}
@end
