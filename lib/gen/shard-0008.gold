expect: => i=1 r=0.0 ok=true s="clamped range times applied: 1" errors=0 n=3 res=[5,8,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let max_c = ${count};
	var clamped = 0;
	for i in g.n {
		if clamped < max_c {
			if g.res[i] < lo {
				g.res[i] = lo;
				clamped++;
			} else if g.res[i] > hi {
				g.res[i] = hi;
				clamped++;
			}
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped range times applied: ", clamped);
	g.steps += g.n + 1;
	out
}
@end
