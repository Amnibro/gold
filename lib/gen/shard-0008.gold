@entry 0aee67d2fa55a81b
kind: step
verb: split
noun: counter
modifier: unique
context: list
phrase: split sequence counting unique distinct elements
phrase: tally occurrences of unique items in list
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="counted 3 unique elements" errors=0 n=1 res=[3] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="counted 1 unique elements" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				found = true;
				break;
			}
			j += 1;
		}
		if !found {
			uniq += 1;
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, uniq);
	out.i = uniq;
	out.ok = true;
	out.s.clear();
	format(out.s, "counted ", uniq, " unique elements");
	g.steps += g.n * g.n + 1;
	out
}
@end
