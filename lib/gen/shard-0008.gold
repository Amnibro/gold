@entry 22f6ba76b418bb2a
kind: step
verb: reverse
noun: tally
modifier: last
context: text
phrase: reverse last {k} characters of text
phrase: invert final {k} text characters
phrase: flip last {k} letters of text
slot: k int
test: text="abcdef" k=3
expect: => i=3 r=0.0 ok=true s="abcfed" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" k=2
expect: => i=2 r=0.0 ok=true s="helol" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let n = out.s.len;
	let lim = if count > n { n } else { count };
	var i = 0;
	var j = lim - 1;
	let start = n - lim;
	while i < j {
		let tmp = out.s[start + i];
		out.s[start + i] = out.s[start + j];
		out.s[start + j] = tmp;
		i++;
		j--;
	}
	g.steps += lim;
	out.i = lim;
	out
}
@end
