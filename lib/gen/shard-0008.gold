	let lo = g.n / 4;
	let hi = g.n - lo;
	var count = 0;
	for i in lo..(hi - 1) {
		g.res[count] = g.res[i + 1] - g.res[i];
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "measured ", count, " middle pairs");
