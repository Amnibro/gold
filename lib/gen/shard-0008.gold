@entry 255bc9e9ce0fbb74
kind: step
verb: cache
noun: tally
modifier: times
context: sort
phrase: cache element frequency tally exceeding times {threshold}
phrase: record repeated sorted items with count surpassing {threshold}
slot: threshold int
test: list=2,2,2,5,5,9 threshold=2
expect: => i=1 r=0.0 ok=true s="cached 1 frequent values" errors=0 n=6 res=[2,2,2,5,5,9] cache=1 hits=0
test: list=1,3,7 threshold=1
expect: => i=0 r=0.0 ok=true s="cached 0 frequent values" errors=0 n=3 res=[1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var cached = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var count = 0;
		while i < g.n && g.res[i] == x {
			count++;
			i++;
		}
		if count > th {
			gold_cache_put(g, x, count);
			cached++;
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " frequent values");
	out
}
@end
