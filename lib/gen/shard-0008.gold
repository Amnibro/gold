fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	out.i = total;
	out.s.clear();
	if total <= limit {
		out.ok = true;
		format(out.s, "budget ", total, " within cap ", limit);
	} else {
		gold_fail(g, "budget exceeded cap");
		out.ok = false;
		format(out.s, "budget ", total, " exceeded cap ", limit);
	}
	gold_cache_put(g, limit, total);
	g.steps += g.n;
	out
}
@end
