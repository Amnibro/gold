code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = ${cutoff};
	var kept = 0;
	for i in g.n {
		if g.res[i] <= c {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		c *= 2;
		for i in g.n {
			if g.res[i] <= c {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
		g.steps += g.n * 2;
		out.i = kept;
		out.s.clear();
		format(out.s, "retry kept ", kept, " items");
		return out;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
