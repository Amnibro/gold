fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.s.clear();
		format(out.s, "empty results");
		return out;
	}
	let min_val = g.res[0];
	for k in 1..g.n {
		g.res[k - 1] = g.res[k];
	}
	g.n--;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "pruned minimum element: ", min_val);
	out
}
@end
