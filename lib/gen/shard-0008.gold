kind: step
verb: group
noun: maximum
modifier: until
context: search
phrase: accumulate maximum search values until reaching {stop_val}
phrase: scan search peaks until surpassing {stop_val}
slot: stop_val int
test: list=2,5,12,20 stop_val=10
expect: => i=12 r=0.0 ok=true s="scanned to index 3 peak: 12" errors=0 n=3 res=[2,5,12] cache=0 hits=0
