expect: 39
code:
fn ${ID}(n int) int {
	let r = ${retries};
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var d0 = 0;
	while d0 < 10 {
		var tmp = x;
		while tmp > 0 {
			if tmp % 10 == d0 {
				res = res * 10 + d0;
			}
			tmp /= 10;
		}
		d0++;
	}
	res + r
}
@end
