code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_t = ${tries};
	var retries = max_t;
	var passed = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			passed++;
		} else {
			if retries > 0 {
				retries--;
			} else {
				break;
			}
		}
	}
	out.i = passed;
	out.s.clear();
	format(out.s, "passed count: ", passed);
	g.steps += g.n + 1;
	out
}
@end
