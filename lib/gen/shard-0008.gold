fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var runs = 0;
	var i = 0;
	while i < g.n {
		var sm = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			sm += g.res[j];
			j++;
		}
		gold_cache_put(g, runs, sm);
		runs++;
		i = j;
	}
	out.i = runs;
	out.s.clear();
	format(out.s, "runs cached: ", runs);
	g.steps += runs + 1;
	out
}
@end
