code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${lo};
	let max_d = ${hi};
	var ok = true;
	for k in out.s.len - 1 {
		let diff = abs((out.s[k + 1] as int) - (out.s[k] as int));
		if diff < min_d || diff > max_d {
			ok = false;
			break;
		}
	}
	if !ok {
		gold_fail(g, "pairwise difference out of range");
	}
	out.ok = ok;
	g.steps += out.s.len;
	out
}
@end
