@entry d8b63e8062c72a30
kind: step
verb: shift
noun: letters
modifier: any
context: stats
phrase: shift letter codes by offset {delta}
phrase: apply Caesar shift of {delta} to letters
phrase: offset character bytes by amount {delta}
slot: delta int
test: text="abc" delta=1
expect: => i=1 r=0.0 ok=true s="bcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="XYZ" delta=3
expect: => i=3 r=0.0 ok=true s="ABC" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift_val = ${delta};
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			out.s[i] = (((b - 'a' as! int + shift_val) % 26) + 'a' as! int) as! byte;
		} else if b >= 'A' && b <= 'Z' {
			out.s[i] = (((b - 'A' as! int + shift_val) % 26) + 'A' as! int) as! byte;
		}
	}
	g.steps += out.s.len;
	out.i = shift_val;
	out
}
@end
