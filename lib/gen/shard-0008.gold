code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${passes};
	var p = 0;
	while p < passes {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
		p++;
	}
	for k in g.n {
		g.res[k] = ${op}(g.res[k]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped sorted runs with retry: ", g.n);
	g.steps += passes * g.n + 1;
	out
}
@end
