code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	var seen int[512] = [0; 512];
	var sn = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim {
			var is_dup = false;
			for j in sn {
				if seen[j] == x { is_dup = true; }
			}
			if !is_dup {
				seen[sn] = x;
				sn++;
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped range to ", kept, " items");
	out
}
@end
