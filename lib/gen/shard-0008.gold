kind: step
verb: find
noun: pairs
modifier: unique
context: search
phrase: find unique adjacent pairs in search results
phrase: identify distinct consecutive pairs in search items
test: list=1,3,5,9
expect: => i=2 r=0.0 ok=true s="found 2 unique pair differences" errors=0 n=4 res=[1,3,5,9] cache=0 hits=0
test: list=2,4,6,8
expect: => i=1 r=0.0 ok=true s="found 1 unique pair differences" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_diffs = 0;
	if g.n > 1 {
		var diffs int[512] = [0; 512];
		var nd = 0;
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			var found = false;
			for j in nd {
				if diffs[j] == d { found = true; break; }
			}
			if !found {
				diffs[nd] = d;
				nd++;
			}
		}
		distinct_diffs = nd;
	}
	g.steps += g.n * g.n;
	out.i = distinct_diffs;
	out.s.clear();
	format(out.s, "found ", distinct_diffs, " unique pair differences");
	out
}
@end
