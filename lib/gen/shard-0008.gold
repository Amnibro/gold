@entry f669987a4b11dd84
kind: step
verb: find
noun: limit
modifier: in_reverse
context: error
phrase: find limit boundary in reverse scan {bound}
phrase: search for limit from reverse direction safely {bound}
phrase: locate limit bound backwards with error check {bound}
slot: bound int
test: list=10,25,5,40,15 bound=20
expect: => i=40 r=0.0 ok=true s="found limit value 40 at index 3" errors=0 n=5 res=[10,25,5,40,15] cache=0 hits=0
test: list=1,2,3 bound=50
expect: => i=0 r=0.0 ok=false s="error: bound not found" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var found_idx = -1;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] >= b {
			found_idx = k;
			break;
		}
		k--;
	}
	if found_idx < 0 {
		gold_fail(g, "limit bound not found in reverse search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: bound not found");
		return out;
	}
	g.steps += g.n - k;
	out.i = g.res[found_idx];
	out.s.clear();
