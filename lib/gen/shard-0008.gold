code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${size};
	var count = if s < g.n { s } else { g.n };
	if count > 1 {
		var l = g.n - count;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed suffix of ", count);
	g.steps += count;
	out
}
