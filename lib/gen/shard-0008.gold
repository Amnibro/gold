expect: => i=0 r=0.0 ok=true s="reordered 0 odd items first" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			temp[count] = g.res[k];
			count++;
		}
	}
	let odd_count = count;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			temp[count] = g.res[k];
			count++;
		}
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "reordered ", odd_count, " odd items first");
	out
}
@end
