@entry 9e0ba7505bd67fea
kind: step
verb: rotate
noun: memo
modifier: while
context: compare
phrase: rotate memo while condition {p} holds
phrase: cycle memo entries while matching predicate {p}
slot: p pred
test: list=2,4,6,3,5 p=is_even
expect: => i=3 r=0.0 ok=true s="rotated memo while predicate count: 3" errors=0 n=5 res=[3,5,2,4,6] cache=0 hits=0
test: list=1,3,5,2,4 p=is_odd
expect: => i=3 r=0.0 ok=true s="rotated memo while predicate count: 3" errors=0 n=5 res=[2,4,1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var rotations = 0;
	while rotations < g.n && ${p}(g.res[0]) {
		let first = g.res[0];
		for i in (g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rotations++;
	}
	g.steps += rotations * g.n;
	out.i = rotations;
	out.s.clear();
	format(out.s, "rotated memo while predicate count: ", rotations);
	out
}
@end
