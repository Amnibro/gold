expect: => i=1 r=0.0 ok=true s="checked histogram none 1" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=1,2,3,2,5
expect: => i=0 r=0.0 ok=false s="checked histogram none 0" errors=0 n=5 res=[1,2,3,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dup = false;
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				has_dup = true;
			}
			j++;
		}
	}
	g.steps += g.n * 2 + 1;
	out.ok = !has_dup;
	out.i = if !has_dup { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked histogram none ", out.i);
	out
}
@end
@entry 9e9a882ff99aff4d
kind: step
verb: map
noun: words
modifier: recursively
context: core
phrase: map words reversing letters recursively
phrase: invert each word characters recursively
test: text="hello world"
expect: => i=11 r=0.0 ok=true s="olleh dlrow" errors=0 n=0 res=[] cache=0 hits=0
test: text="simple test"
expect: => i=11 r=0.0 ok=true s="elpmis tset" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_start = 0;
	var i = 0;
	while i <= out.s.len {
		if i == out.s.len || out.s[i] == ' ' {
			if i > word_start {
				var l = word_start;
				var r = i - 1;
				while l < r {
					let tmp = out.s[l];
					out.s[l] = out.s[r];
					out.s[r] = tmp;
					l++;
					r--;
				}
			}
			word_start = i + 1;
		}
		i++;
	}
	g.steps += out.s.len + 4;
	out.i = out.s.len;
	out
}
@end
@entry 7bc36f30c4de760d
kind: step
verb: check
noun: streak
modifier: times
context: core
phrase: check streak length exceeding {min_len} times
phrase: verify ascending streak reaches length {min_len}
slot: min_len int
test: list=1,2,3,2,1 min_len=3
expect: => i=3 r=0.0 ok=true s="checked streak length 3" errors=0 n=5 res=[1,2,3,2,1] cache=0 hits=0
test: list=5,4,3,2 min_len=3
expect: => i=1 r=0.0 ok=false s="checked streak length 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_len};
	var max_streak = if g.n > 0 { 1 } else { 0 };
	var cur = 1;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			if g.res[i] >= g.res[i - 1] {
				cur++;
				if cur > max_streak { max_streak = cur; }
			} else {
				cur = 1;
			}
			i++;
		}
	}
	let passes = max_streak >= target;
	g.steps += g.n + 2;
	out.ok = passes;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "checked streak length ", max_streak);
	out
}
@end
@entry 8ef158a84c8827c0
kind: step
verb: swap
noun: total
modifier: while
context: core
phrase: swap elements while total stays below {cap}
phrase: exchange boundary items while sum under {cap}
slot: cap int
test: list=5,10,20,8 cap=50
expect: => i=8 r=0.0 ok=true s="swapped total result 8" errors=0 n=4 res=[8,10,20,5] cache=0 hits=0
test: list=40,10,20,50 cap=50
expect: => i=40 r=0.0 ok=true s="swapped total result 40" errors=0 n=4 res=[40,10,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n >= 2 {
		let sum = g.res[0] + g.res[g.n - 1];
		if sum < limit {
			let tmp = g.res[0];
			g.res[0] = g.res[g.n - 1];
			g.res[g.n - 1] = tmp;
		}
	}
	g.steps += 3;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "swapped total result ", out.i);
	out
}
@end
