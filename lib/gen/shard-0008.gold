fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var running = 0;
	var count = 0;
	for i in g.n {
		let transformed = ${op}(g.res[i]);
		if running + transformed > limit {
			break;
		}
		g.res[i] = transformed;
		running += transformed;
		count++;
	}
	g.n = count;
	out.i = running;
	out.s.clear();
	format(out.s, "applied total capped ", running);
	g.steps += count + 1;
	out
}
