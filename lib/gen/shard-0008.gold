kind: step
verb: rank
noun: gaps
modifier: unique
context: list
phrase: rank unique spacing gap differences in sequence
phrase: count distinct gap intervals between list elements
test: list=1,3,5,8
expect: => i=2 r=0.0 ok=true s="found 2 unique gap differences" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
test: list=10,20,30,40
expect: => i=1 r=0.0 ok=true s="found 1 unique gap differences" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "found 0 unique gap differences");
		return out;
	}
	var u_gaps int[512] = [0; 512];
	var un = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		var seen = false;
		for j in un {
			if u_gaps[j] == gap { seen = true; }
		}
		if !seen {
			u_gaps[un] = gap;
			un++;
		}
	}
	g.steps += g.n * un;
	out.i = un;
	out.s.clear();
	format(out.s, "found ", un, " unique gap differences");
	out
}
@end
@entry 5822a3c8c4955a6a
kind: step
verb: join
noun: value
modifier: at_most
context: list
phrase: join adjacent values summing at most {max_sum}
phrase: combine consecutive numbers bounded at most {max_sum}
slot: max_sum int
test: list=4,5,20,30 max_sum=15
expect: => i=3 r=0.0 ok=true s="joined values to 3 items" errors=0 n=3 res=[9,20,30] cache=0 hits=0
test: list=10,20 max_sum=50
expect: => i=1 r=0.0 ok=true s="joined values to 1 items" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_sum};
	var tmp int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && (g.res[i] + g.res[i + 1]) <= limit {
			tmp[kn] = g.res[i] + g.res[i + 1];
			kn++;
			i += 2;
		} else {
			tmp[kn] = g.res[i];
			kn++;
			i++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, tmp[k]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "joined values to ", kn, " items");
	out
}
@end
