fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for i in pairs {
		let idx = i * 2;
		if g.res[idx] > g.res[idx + 1] {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
		}
	}
	g.steps += pairs + 2;
	out.i = pairs;
	out.s.clear();
	format(out.s, "ordered pairwise minimums ", pairs);
	out
}
@end
