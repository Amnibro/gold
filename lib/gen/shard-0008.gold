code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum_all = 0;
	for k in g.n { sum_all += g.res[k]; }
	let avg = sum_all / g.n;
	var total_above = 0;
	for k in g.n {
		if g.res[k] > avg {
			total_above += g.res[k];
		}
	}
	gold_cache_put(g, avg, total_above);
	g.steps += g.n;
	out.i = total_above;
	out.s.clear();
	format(out.s, "sum above average ", avg, " is ", total_above);
	out
}
@end
