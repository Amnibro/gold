	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		pairs[count] = (g.res[i] + g.res[i + 1]) * k;
		count++;
		i += 2;
	}
	if i < g.n {
		pairs[count] = g.res[i] * k;
		count++;
	}
	gold_clear(g);
	for j in count { gold_push(g, pairs[j]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled all pairs into ", count, " items");
	out
}
@end
