fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var i = 0;
	while i < g.n {
		if total + g.res[i] > lim { break; }
		total += g.res[i];
		i++;
	}
	gold_clear(g);
	gold_push(g, total);
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "merged loop sum ", total);
	out
}
@end
