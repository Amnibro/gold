fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached = 0;
	if g.n > 2 {
		var i = g.n - 2;
		while i >= 1 {
			gold_cache_put(g, g.res[i], i);
			cached++;
			i--;
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached middle items in reverse");
	out
}
