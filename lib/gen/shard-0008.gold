code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("built empty sequence");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	let mid = g.n / 2;
	i = 0;
	while i < g.n {
		g.res[i] = avg + (i - mid);
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "built ", g.n, " items around mean ", avg);
	g.steps += g.n;
	out
}
