code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for i in g.n {
		var x = g.res[i];
		for step in d {
			gold_cache_put(g, x, step);
			x += 1;
		}
	}
	g.steps += g.n * d;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "measured cache recursive count ", g.cn);
	out
}
@end
