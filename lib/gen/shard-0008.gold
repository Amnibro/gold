fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in (g.n - 1) {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n--;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "first pairwise delta: ", out.i);
	g.steps += g.n + 1;
	out
}
