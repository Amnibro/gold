		let a = out.s[i] as int;
		let b = out.s[i + 1] as int;
		if a == target || b == target {
			let tmp = out.s[i];
			out.s[i] = out.s[i + 1];
			out.s[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out
}
