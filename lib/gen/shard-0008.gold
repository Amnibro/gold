fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var letters = 0;
	for i in out.s.len {
		if i >= limit { break; }
		let b = out.s[i];
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') { letters++; }
	}
	g.steps += letters;
	out.i = letters;
	out.s.clear();
	format(out.s, "tallied ", letters, " letters");
	out
}
@end
@entry 515c2deb1f3f8f60
kind: step
verb: merge
noun: tail
modifier: until
context: compare
phrase: merge tail elements until comparing threshold {threshold}
phrase: sum trailing items until value reaches {threshold}
slot: threshold int
test: list=1,2,10,20,30 threshold=15
expect: => i=10 r=0.0 ok=true s="merged tail sum 10" errors=0 n=5 res=[1,2,10,20,30] cache=0 hits=0
test: list=5,6,8,12 threshold=7
expect: => i=0 r=0.0 ok=true s="merged tail sum 0" errors=0 n=4 res=[5,6,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	let half = g.n / 2;
	var total = 0;
	var i = half;
	while i < g.n && g.res[i] < thresh {
		total += g.res[i];
		i++;
	}
	g.steps += g.n - half;
	out.i = total;
	out.s.clear();
	format(out.s, "merged tail sum ", total);
	out
}
@end
