fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_count};
	var passed = 0;
	var kept = 0;
	for i in g.n {
		if ${cond}(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
			passed++;
		}
	}
	g.n = kept;
	out.ok = (passed >= min_c);
	out.i = passed;
	out.s.clear();
	format(out.s, "validated condition passed: ", passed);
	g.steps += g.n + 1;
	out
}
