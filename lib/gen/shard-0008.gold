kind: step
verb: fold
noun: histogram
modifier: at_most
context: aggregate
phrase: fold histogram frequencies capped at most {max_freq}
phrase: aggregate frequency counts capping values at most {max_freq}
slot: max_freq int
test: list=2,2,2,3,3,4 max_freq=2
expect: => i=5 r=0.0 ok=true s="folded histogram total: 5" errors=0 n=6 res=[2,2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,5,6 max_freq=1
expect: => i=2 r=0.0 ok=true s="folded histogram total: 2" errors=0 n=5 res=[5,5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	var total = 0;
	var i = 0;
	while i < g.n {
		var seen_before = false;
		for j in i {
			if g.res[j] == g.res[i] { seen_before = true; break; }
		}
		if !seen_before {
			var freq = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { freq++; }
			}
			let capped = if freq > mf { mf } else { freq };
			total += capped;
		}
		i++;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "folded histogram total: ", total);
	g.steps += g.n + 1;
	out
}
@end
