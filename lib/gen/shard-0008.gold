	if g.n > 1 {
		let k = ((s % g.n) + g.n) % g.n;
		var temp int[512] = [0; 512];
		for i in g.n {
			temp[(i + k) % g.n] = g.res[i];
		}
		for i in g.n {
			g.res[i] = temp[i];
		}
		out.i = k;
		out.s.clear();
