kind: step
verb: measure
noun: subfunction
modifier: pairwise
context: error
phrase: measure pairwise differences with subfunction raising error on odd
phrase: evaluate pairwise subfunction gaps checking parity error
test: list=10,20,30,50
expect: => i=30 r=0.0 ok=true s="measured pairwise subfunction sum: 30" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=false s="odd element count for pairwise subfunction" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 {
		gold_fail(g, "odd count for pairwise subfunction measurement");
		out.ok = false;
		out.i = 0;
	} else {
		var sum = 0;
		var i = 0;
		while i + 1 < g.n {
			let diff = g.res[i + 1] - g.res[i];
			sum += if diff < 0 { -diff } else { diff };
			i += 2;
		}
		out.i = sum;
	}
	out.s.clear();
	if out.ok {
		format(out.s, "measured pairwise subfunction sum: ", out.i);
	} else {
		out.s.append("odd element count for pairwise subfunction");
	}
	g.steps += g.n + 1;
	out
}
@end
