code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_var};
	var iters = 0;
	while true {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		if sum <= limit || iters >= 50 { break; }
		for k in g.n { g.res[k] = g.res[k] / 2; }
		iters++;
	}
	g.steps += iters * g.n;
	out.i = iters;
	out.s.clear();
	format(out.s, "normalized across ", iters, " iterations");
	out
}
@end
