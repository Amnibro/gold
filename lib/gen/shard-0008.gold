expect: => i=0 r=0.0 ok=true s="appended 0 duplicate values" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var d_count = 0;
	for i in g.n {
		var matches = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { matches++; }
		}
		if matches > 1 {
			var seen = false;
			for k in d_count {
				if dups[k] == g.res[i] { seen = true; }
			}
			if !seen {
				dups[d_count] = g.res[i];
				d_count++;
			}
		}
	}
	for k in d_count {
		gold_push(g, dups[k]);
	}
	out.i = d_count;
	out.s.clear();
	format(out.s, "appended ", d_count, " duplicate values");
	g.steps += d_count;
	out
}
@end
