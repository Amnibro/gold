@entry 772e1fd8204fbc4f
kind: step
verb: group
noun: primes
modifier: first
context: list
phrase: group prime numbers first in list
phrase: place prime elements at beginning of list
test: list=4,3,2,6,5
expect: => i=3 r=0.0 ok=true s="grouped primes: 3" errors=0 n=5 res=[3,2,5,4,6] cache=0 hits=0
test: list=10,12,7,8,11
expect: => i=2 r=0.0 ok=true s="grouped primes: 2" errors=0 n=5 res=[7,11,10,12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[..64] = [];
	var non_primes int[..64] = [];
	for i in g.n {
		let x = g.res[i];
		var p = true;
		if x < 2 {
			p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { p = false; break; }
				d++;
			}
		}
		if p {
			primes.push(x);
		} else {
			non_primes.push(x);
		}
	}
	var idx = 0;
	for i in primes.len {
		g.res[idx] = primes[i];
		idx++;
	}
	for i in non_primes.len {
		g.res[idx] = non_primes[i];
		idx++;
	}
	out.i = primes.len;
	out.s.clear();
	format(out.s, "grouped primes: ", primes.len);
	g.steps += g.n;
	out
}
@end
@entry b06c570ca69ca14c
kind: step
verb: shift
noun: steps
modifier: times
context: list
phrase: shift elements forward by {steps} positions {times} times
phrase: cycle list forward {steps} slots repeatedly {times} times
slot: steps int
slot: times int
test: list=1,2,3,4,5 steps=1 times=2
expect: => i=2 r=0.0 ok=true s="shifted steps times: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 steps=2 times=1
expect: => i=2 r=0.0 ok=true s="shifted steps times: 2" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	let t = ${times};
	let total_shift = if g.n > 0 { (s * t) % g.n } else { 0 };
	if g.n > 1 && total_shift > 0 {
		for step in total_shift {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	out.i = total_shift;
	out.s.clear();
	format(out.s, "shifted steps times: ", total_shift);
	g.steps += g.n;
	out
}
@end
