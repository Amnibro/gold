code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var pairs = 0;
	var running = 0;
	var i = 0;
	while i + 1 < g.n {
		let p_sum = g.res[i] + g.res[i + 1];
		if running + p_sum > limit {
			break;
		}
		running += p_sum;
		g.res[pairs] = p_sum;
		pairs++;
		i += 2;
	}
	g.n = pairs;
	out.i = running;
	out.s.clear();
