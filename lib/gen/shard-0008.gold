@entry 1db44c6dc0fade35
kind: step
verb: scale
noun: digits
modifier: sorted
context: core
phrase: scale sorted elements by multiplier {factor}
phrase: multiply sorted sequence values by scale {factor}
slot: factor int
test: list=4,2,7,1 factor=3
expect: => i=3 r=0.0 ok=true s="scaled sorted first: 3" errors=0 n=4 res=[3,6,12,21] cache=0 hits=0
test: list=9,3,6 factor=2
expect: => i=6 r=0.0 ok=true s="scaled sorted first: 6" errors=0 n=3 res=[6,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	for i in g.n {
		g.res[i] = g.res[i] * mul;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "scaled sorted first: ", out.i);
	g.steps += g.n + 1;
	out
}
@end
