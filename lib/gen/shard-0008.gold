fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for r in g.n {
		if g.res[r] > 0 {
			g.res[w] = g.res[r];
			w++;
		}
	}
	g.n = w;
	if w == 0 {
		gold_fail(g, "no positive tally elements found");
		out.ok = false;
	}
	out.i = w;
	out.s.clear();
	if out.ok {
		format(out.s, "retained positive tally count: ", w);
	} else {
		out.s.append("zero positive tallies retained");
	}
	g.steps += g.n + 1;
	out
}
@end
