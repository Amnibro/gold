@entry 408f6e1dc66ab5fc
kind: step
verb: drop
noun: gaps
modifier: up_to
context: format
phrase: drop elements where gap to prior is up to {max_gap}
phrase: discard items with small interval under {max_gap}
slot: max_gap int
test: list=10,12,20,22,35 max_gap=3
expect: => i=3 r=0.0 ok=true s="kept large gaps: 3" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=5,6,15,16 max_gap=2
expect: => i=2 r=0.0 ok=true s="kept large gaps: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > mg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept large gaps: ", kept);
	g.steps += kept + 1;
	out
}
@end
