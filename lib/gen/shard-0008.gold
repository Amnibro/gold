code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	let first = g.res[0];
	let last = g.res[g.n - 1];
	out.s.clear();
	if first > last {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		format(out.s, "reversed results");
		out.i = 1;
	} else {
		format(out.s, "kept results");
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
