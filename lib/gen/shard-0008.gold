fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var count = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		   c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' {
			gold_push(g, i);
			count += 1;
		}
		i += 1;
	}
	out.i = count;
	out.ok = count > 0;
	out.s.clear();
	format(out.s, "found all ", count, " vowel positions");
	g.steps += v.s.len;
	out
}
@end
@entry 6e9a3ddd07a5a450
kind: step
verb: split
noun: maximum
modifier: last
context: list
phrase: split maximum element moving it to last position
phrase: relocate highest value to last index
test: list=10,50,20,30
expect: => i=50 r=0.0 ok=true s="moved maximum 50 to last index" errors=0 n=4 res=[10,30,20,50] cache=0 hits=0
test: list=99,1,2
expect: => i=99 r=0.0 ok=true s="moved maximum 99 to last index" errors=0 n=3 res=[2,1,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("list too short for maximum split");
		return out;
	}
	var max_idx = 0;
	var max_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
		i += 1;
	}
	let last = g.n - 1;
	let tmp = g.res[last];
	g.res[last] = max_val;
	g.res[max_idx] = tmp;
	out.i = max_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "moved maximum ", max_val, " to last index");
	g.steps += g.n;
	out
}
@end
