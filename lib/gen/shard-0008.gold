fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_neg = false;
	for i in g.n {
		if g.res[i] < 0 { has_neg = true; }
	}
	if has_neg {
		for i in g.n { g.res[i] *= 2; }
	}
	g.steps += g.n + 2;
	out.ok = has_neg;
	out.i = if has_neg { 1 } else { 0 };
	out.s.clear();
	format(out.s, "scaled condition status ", out.i);
	out
}
@end
