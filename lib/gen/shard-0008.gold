fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if out.s.len > c {
		var temp: byte[>..] = [];
		for i in c { temp.push(out.s[i]); }
		out.s.clear();
		for b in temp { out.s.push(b); }
	}
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
