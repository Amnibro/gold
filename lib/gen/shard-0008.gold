fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	var left = half;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	var run = 0;
	for i in half..g.n {
		run += g.res[i];
	}
	g.steps += g.n - half;
	out.i = run;
	out.s.clear();
	format(out.s, "reversed suffix running sum ", run);
	out
}
@end
