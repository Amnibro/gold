fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${stepsize};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		var mx = g.res[i];
		var j = i;
		while j < g.n && j < i + sz {
			if g.res[j] > mx {
				mx = g.res[j];
			}
			j++;
		}
		g.res[count] = mx;
		count++;
		i += sz;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "split into step chunks ", count);
	g.steps += g.n + 1;
	out
}
@end
