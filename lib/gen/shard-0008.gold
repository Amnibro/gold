test: list=10,20,30,40 count=2 scale=10
expect: => i=4 r=0.0 ok=true s="normalized suffix last: 4" errors=0 n=4 res=[10,20,3,4] cache=0 hits=0
test: list=5,10,15 count=1 scale=5
expect: => i=3 r=0.0 ok=true s="normalized suffix last: 3" errors=0 n=3 res=[5,10,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let s = ${scale};
	if g.n > 0 && s > 0 {
		var start = g.n - c;
		if start < 0 { start = 0; }
		for i in start..g.n {
			g.res[i] = g.res[i] / s;
		}
		out.i = g.res[g.n - 1];
	}
	out.s.clear();
	format(out.s, "normalized suffix last: ", out.i);
	g.steps += c + 1;
	out
}
@end
