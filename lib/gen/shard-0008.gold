fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var count = 0;
	for k in g.n {
		if g.res[k] == max_val { count++; }
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	if count == 1 {
		format(out.s, "unique maximum found: ", max_val);
	} else {
		format(out.s, "maximum ", max_val, " repeated ", count, " times");
	}
	out
}
@end
