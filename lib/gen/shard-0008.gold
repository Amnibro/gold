fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let limit = if g.n < c { g.n } else { c };
	if limit == 0 {
		out.i = 0;
	} else {
		var sum = 0;
		for i in limit { sum += g.res[i]; }
		out.i = sum / limit;
	}
	out.s.clear();
	format(out.s, "searched first average: ", out.i);
	g.steps += g.n + 1;
	out
}
@end
@entry 2406721298084e83
kind: step
verb: dedupe
noun: subfunction
modifier: with_retry
context: core
phrase: dedupe subfunction {f} mapped values with retry
phrase: filter duplicate results after applying function {f}
slot: f fn
test: list=2,3,2,4 f=double
expect: => i=3 r=0.0 ok=true s="deduped subfunction count: 3" errors=0 n=3 res=[4,6,8] cache=0 hits=0
test: list=1,2,1 f=square
expect: => i=2 r=0.0 ok=true s="deduped subfunction count: 2" errors=0 n=2 res=[1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = ${f}(g.res[i]);
		var seen = false;
		for j in kept {
			if g.res[j] == val { seen = true; break; }
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped subfunction count: ", kept);
	g.steps += g.n + 1;
	out
}
@end
