fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_cost = ${cost};
	var total = 0;
	var count = 0;
	while count < g.n && total + g.res[count] <= max_cost {
		total += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += count + 2;
	out.i = total;
	out.s.clear();
	format(out.s, "merged budget total ", total);
	out
}
@end
