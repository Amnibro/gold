@entry 5284dfdc30643e6c
kind: step
verb: collect
noun: middle
modifier: with_cache
context: search
phrase: collect middle search elements within margin {margin}
phrase: extract central search values within margin {margin}
slot: margin int
test: list=10,20,30,40,50 margin=1
expect: => i=3 r=0.0 ok=true s="collected 3 central items" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=1,2,3,4,5,6 margin=0
expect: => i=1 r=0.0 ok=true s="collected 1 central items" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n == 0 { return out; }
	let mid_idx = g.n / 2;
	let start = if mid_idx - m > 0 { mid_idx - m } else { 0 };
	let end = if mid_idx + m + 1 < g.n { mid_idx + m + 1 } else { g.n };
	var kept = 0;
	for i in start..end {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " central items");
	out
}
@end
