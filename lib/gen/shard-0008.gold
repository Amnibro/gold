code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.cn {
		gold_push(g, g.ck[i]);
	}
	// sort all results ascending
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n + 3;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged cache sorted count ", g.n);
	out
}
@end
