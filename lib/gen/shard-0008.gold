kind: step
verb: swap
noun: primes
modifier: in_reverse
context: transform
phrase: swap prime values traversing in reverse order
phrase: exchange prime elements backwards in reverse
test: list=2,4,3,8,5
expect: => i=1 r=0.0 ok=true s="swapped primes in reverse count 1" errors=0 n=5 res=[2,4,5,8,3] cache=0 hits=0
test: list=7,6,11,4
expect: => i=1 r=0.0 ok=true s="swapped primes in reverse count 1" errors=0 n=4 res=[11,6,7,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_indices int[512] = [0; 512];
	var pn = 0;
	var i = g.n - 1;
	while i >= 0 {
		if core_is_prime(g.res[i]) {
			prime_indices[pn] = i;
			pn++;
		}
		i--;
	}
	var swaps = 0;
	var k = 0;
	while k + 1 < pn {
		let idx1 = prime_indices[k];
		let idx2 = prime_indices[k + 1];
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		swaps++;
		k += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped primes in reverse count ", swaps);
	out
}
@end
@entry 4abd827a1d119b77
kind: step
verb: keep
noun: prefix
modifier: every_other
context: transform
phrase: keep alternating elements within prefix length {len}
phrase: retain every other item in prefix {len}
slot: len int
test: list=1,2,3,4,5,6 len=4
expect: => i=2 r=0.0 ok=true s="kept prefix every other count 2" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=10,20,30,40,50 len=3
expect: => i=2 r=0.0 ok=true s="kept prefix every other count 2" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	let bound = if g.n < k { g.n } else { k };
	var kept = 0;
	var i = 0;
	while i < bound {
		g.res[kept] = g.res[i];
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += bound;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept prefix every other count ", kept);
	out
}
@end
@entry 5cd96874d00d7776
kind: step
verb: merge
noun: window
modifier: recursively
context: transform
phrase: merge window pairs recursively with depth {depth}
phrase: recursively combine window elements depth {depth}
slot: depth int
test: list=1,2,3,4 depth=1
expect: => i=2 r=0.0 ok=true s="merged window recursively count 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=10,20,30,40 depth=2
expect: => i=1 r=0.0 ok=true s="merged window recursively count 1" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var cur_n = g.n;
	for step in d {
		if cur_n < 2 { break; }
		let pairs = cur_n / 2;
		for i in pairs {
			g.res[i] = g.res[i * 2] + g.res[i * 2 + 1];
		}
		cur_n = pairs;
	}
	g.n = cur_n;
	g.steps += g.n * d;
	out.i = cur_n;
	out.s.clear();
	format(out.s, "merged window recursively count ", cur_n);
	out
}
@end
