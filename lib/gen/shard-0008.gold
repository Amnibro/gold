expect: => i=2 r=0.0 ok=true s="swapped 2 range chunks" errors=0 n=6 res=[30,20,10,60,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${span};
	if k <= 1 {
		out.i = 0;
		return out;
	}
	var i = 0;
	var count = 0;
	while i + k <= g.n {
		for j in k / 2 {
			let tmp = g.res[i + j];
			g.res[i + j] = g.res[i + k - 1 - j];
			g.res[i + k - 1 - j] = tmp;
		}
		count++;
		i += k;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " range chunks");
	out
}
@end
