@entry 70a78231949d0ea8
kind: step
verb: keep
noun: total
modifier: with_retry
context: loop
phrase: keep running total within {max_total} retrying {retries} items
phrase: accumulate total under {max_total} with retry count {retries}
slot: max_total int
slot: retries int
test: list=10,20,50,15 max_total=40 retries=1
expect: => i=30 r=0.0 ok=true s="kept running total 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,8,12,30 max_total=20 retries=0
expect: => i=13 r=0.0 ok=true s="kept running total 13" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_total};
	let r_max = ${retries};
	var total = 0;
	var kept = 0;
	var skipped = 0;
	for i in g.n {
		let x = g.res[i];
		if total + x <= ceiling {
			total += x;
			g.res[kept] = x;
			kept++;
		} else if skipped < r_max {
			skipped++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "kept running total ", total);
	out
}
@end
