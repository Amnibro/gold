fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var count = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff <= ms {
				gold_cache_put(g, k, diff);
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " steps within bound");
	out
}
