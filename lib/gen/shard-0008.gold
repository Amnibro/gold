test: list=10,10,10,10
expect: => i=40 r=0.0 ok=true s="normalized tally on total 40" errors=0 n=4 res=[25,25,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tot = 0;
	for k in g.n { tot += g.res[k]; }
	if tot <= 0 {
		gold_fail(g, "zero total tally");
		out.ok = false;
		return out;
	}
	for k in g.n {
		g.res[k] = (g.res[k] * 100) / tot;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "normalized tally on total ", tot);
	out
}
@end
