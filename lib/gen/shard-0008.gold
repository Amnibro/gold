fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var found = -1;
	for k in g.n {
		if g.res[k] < b {
			found = g.res[k];
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found != -1 {
		format(out.s, "last element below bound: ", found);
	} else {
		format(out.s, "no element found below bound");
	}
	out
}
@end
