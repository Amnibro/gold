fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			pairs++;
			i += 2;
		} else {
			break;
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "consecutive even pairs: ", pairs);
	g.steps += pairs + 1;
	out
}
