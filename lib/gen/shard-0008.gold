fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var max_depth = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == '(' {
			depth += 1;
			if depth > max_depth {
				max_depth = depth;
			}
		} else if c == ')' {
			if depth > 0 {
				depth -= 1;
			}
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, max_depth);
	out.i = max_depth;
	out.ok = max_depth > 0;
	out.s.clear();
	format(out.s, "maximum nesting depth ", max_depth);
	g.steps += v.s.len;
	out
}
