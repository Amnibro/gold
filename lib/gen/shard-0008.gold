code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end};
	var count = 0;
	for i in g.n {
		if i >= s && i <= e {
			g.res[i] += 1;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "shifted items between: ", count);
	g.steps += g.n;
	out
}
