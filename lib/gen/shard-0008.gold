code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim >= g.n { g.n - 1 } else { lim };
	if count <= 0 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "trivial prefix validation");
		return out;
	}
	for i in count {
		if g.res[i + 1] <= g.res[i] {
			gold_fail(g, "prefix not strictly increasing");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "prefix validation failed at index ", i + 1);
			return out;
		}
	}
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "prefix up to ", count, " validated increasing");
	out
}
@end
