fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${lo};
	let max_d = ${hi};
	var best = -1;
	for k in g.n - 1 {
		let diff = abs(g.res[k + 1] - g.res[k]);
		if diff >= min_d && diff <= max_d && diff > best {
			best = diff;
		}
	}
	g.steps += g.n;
	out.i = if best < 0 { 0 } else { best };
	out
}
@end
