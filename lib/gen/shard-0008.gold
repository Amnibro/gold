fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_val};
	for i in g.n {
		var x = g.res[i];
		var r = 0;
		while x < target && r < 5 {
			x = ${fn}(x);
			r++;
		}
		g.res[i] = x;
	}
	g.steps += g.n * 5;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retried subfunction across ", g.n, " elements");
	out
}
@end
