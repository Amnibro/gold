@entry 5b50555cc2dd68c8
kind: step
verb: cache
noun: gaps
modifier: up_to
context: sort
phrase: cache consecutive sorted gaps bounded up to {max_gap}
phrase: record adjacent gaps in cache up to bound {max_gap}
slot: max_gap int
test: list=1,3,7,8 max_gap=3
expect: => i=2 r=0.0 ok=true s="cached 2 small gaps" errors=0 n=4 res=[1,3,7,8] cache=2 hits=0
test: list=10,30,60 max_gap=10
expect: => i=0 r=0.0 ok=true s="cached 0 small gaps" errors=0 n=3 res=[10,30,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var cached = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			let gap = g.res[k + 1] - g.res[k];
			if gap <= mg {
				gold_cache_put(g, k, gap);
				cached++;
			}
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " small gaps");
	out
}
@end
