slot: num_digits int
test: arg=1234,56789 num_digits=2
expect: 12
expect: 56
test: arg=890 num_digits=1
expect: 8
code:
fn ${ID}(n int) int {
	let k = ${num_digits};
	var x = if n < 0 { -n } else { n };
	var total_digits = 0;
	var tmp = x;
	while tmp > 0 { tmp /= 10; total_digits++; }
	if total_digits <= k { return x; }
	var drop = total_digits - k;
	for i in drop { x /= 10; }
	x
}
@end
@entry 3fc73b3fb293e742
kind: fn
verb: sort
noun: odds
modifier: at_most
context: format
phrase: sort odd digits placing at most {max_odds} items
phrase: extract sorted odd digits up to limit {max_odds}
slot: max_odds int
test: arg=9531,712 max_odds=2
expect: 13
expect: 17
test: arg=1357 max_odds=3
expect: 135
code:
fn ${ID}(n int) int {
	let mo = ${max_odds};
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var placed = 0;
	var d = 1;
	while d < 10 && placed < mo {
		var tmp = x;
		while tmp > 0 && placed < mo {
			if tmp % 10 == d {
				res = res * 10 + d;
				placed++;
			}
			tmp /= 10;
