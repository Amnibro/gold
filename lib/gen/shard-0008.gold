fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	let span = if g.n > k { k } else { g.n };
	var kept = 0;
	for i in span {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += span;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged unique prefix of ", kept);
	out
}
@end
