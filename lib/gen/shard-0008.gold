@entry be05faa22cb1f2cd
kind: step
verb: retry
noun: histogram
modifier: nested
context: list
phrase: retry nested histogram across {bins} bins under max {max_bin}
phrase: build nested histogram with {bins} bins checking {max_bin}
phrase: compute nested histogram over {bins} buckets capping at {max_bin}
slot: bins int
slot: max_bin int
test: list=0,1,2,3,4 bins=3 max_bin=3
expect: => i=3 r=0.0 ok=true s="histogram generated with 3 bins" errors=0 n=3 res=[2,2,1] cache=0 hits=0
test: list=1,1,1,1 bins=2 max_bin=2
expect: => i=2 r=0.0 ok=false s="histogram generated with 2 bins" errors=1 n=2 res=[0,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	let cap = ${max_bin};
	if b <= 0 {
		gold_fail(g, "bins must be positive");
		out.ok = false;
		return out;
	}
	var hist int[256] = [0; 256];
	var overflow = false;
	for i in g.n {
		let idx = abs(g.res[i]) % b;
		if idx < 256 {
			hist[idx]++;
			if hist[idx] > cap { overflow = true; }
		}
	}
	gold_clear(g);
	for k in b {
		if k < 256 { gold_push(g, hist[k]); }
	}
	g.steps += g.n;
	out.ok = !overflow;
	if overflow { gold_fail(g, "histogram bin exceeded cap"); }
	out.i = b;
	out.s.clear();
	format(out.s, "histogram generated with ", b, " bins");
	out
}
@end
