	let req = ${min_err};
	if out.i < 0 {
		gold_fail(g, "negative input error");
	}
	let passes = g.errors >= req;
	g.steps += 2;
	out.ok = passes;
	out.i = g.errors;
	out.s.clear();
	format(out.s, "merged errors status ", out.i);
