fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let lim = ${max_idx};
	let count = if lim >= g.n { g.n } else if lim < 0 { 0 } else { lim + 1 };
	var found_idx = -1;
	for i in count {
		if g.res[i] >= tgt {
			found_idx = i;
			break;
		}
	}
	g.steps += count;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		out.ok = true;
		format(out.s, "checkpoint ", g.res[found_idx], " found at index ", found_idx);
	} else {
		gold_fail(g, "checkpoint not found");
		out.ok = false;
		format(out.s, "checkpoint not reached within limit");
	}
	out
}
@end
