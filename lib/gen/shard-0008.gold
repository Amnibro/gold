fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("not enough items to pull delta");
		return out;
	}
	let diff = g.res[1] - g.res[0];
	out.i = diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "pulled leading delta ", diff);
	g.steps += 1;
	out
}
@end
