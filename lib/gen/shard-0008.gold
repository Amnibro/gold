fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let num_pairs = g.n - 1;
	for i in num_pairs {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = diff;
	}
	g.n = num_pairs;
	g.steps += num_pairs;
	out.i = num_pairs;
	out.s.clear();
	format(out.s, "paired pairwise count ", num_pairs);
	out
}
