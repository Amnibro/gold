fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var stopped = false;
	var clamped_cnt = 0;
	for i in g.n {
		if !stopped {
			if g.res[i] < 0 {
				stopped = true;
			} else if g.res[i] > ceil {
				g.res[i] = ceil;
				clamped_cnt++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped_cnt;
	out.s.clear();
	format(out.s, "clamped ", clamped_cnt, " items until sentinel");
