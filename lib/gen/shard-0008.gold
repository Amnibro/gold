test: list=10,50,20,60 cap=30
expect: => i=2 r=0.0 ok=true s="dropped exceeding limit" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=70,80,90 cap=40
expect: => i=3 r=0.0 ok=true s="retried by clamping" errors=0 n=3 res=[40,40,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var kept = 0;
	for i in g.n {
		if g.res[i] <= c {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		for i in g.n {
			g.res[i] = c;
		}
		kept = g.n;
		out.s.clear();
		format(out.s, "retried by clamping");
	} else {
		g.n = kept;
		out.s.clear();
		format(out.s, "dropped exceeding limit");
	}
	out.i = kept;
	g.steps += g.n + 2;
	out
}
@end
