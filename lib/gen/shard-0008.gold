fn ${ID}_is_vowel(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var pairs = 0;
	for k in out.s.len - 1 {
		if ${ID}_is_vowel(out.s[k]) && ${ID}_is_vowel(out.s[k + 1]) {
			pairs++;
		}
	}
	g.steps += out.s.len;
	out.i = pairs * fac;
	out
}
@end
