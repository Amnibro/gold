fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	// sort ascending
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted odds count ", g.n);
	g.steps += g.n * 2 + 36;
	out
}
