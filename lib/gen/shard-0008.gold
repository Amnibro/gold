fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	var scaled = 0;
	for i in g.n {
		if g.res[i] > lim {
			g.res[i] *= 2;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled threshold in place count ", scaled);
	out
}
@end
