expect: => i=-1 r=0.0 ok=true s="tail descending" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		g.steps++;
		return out;
	}
	let a = g.res[g.n - 2];
	let b = g.res[g.n - 1];
	out.s.clear();
	if a < b {
		format(out.s, "tail ascending");
		out.i = 1;
	} else if a > b {
		format(out.s, "tail descending");
		out.i = -1;
	} else {
		format(out.s, "tail equal");
		out.i = 0;
	}
	g.steps += 2;
	out
}
@end
