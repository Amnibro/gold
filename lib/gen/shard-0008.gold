@entry a1ce3df8892d8857
kind: step
verb: shift
noun: prefix
modifier: sorted
context: list
phrase: shift prefix of size {len} into sorted order
phrase: sort initial prefix segment of length {len}
slot: len int
test: list=4,2,7,1,9 len=3
expect: => i=3 r=0.0 ok=true s="sorted prefix size: 3" errors=0 n=5 res=[2,4,7,1,9] cache=0 hits=0
test: list=50,10,30,5,1 len=4
expect: => i=4 r=0.0 ok=true s="sorted prefix size: 4" errors=0 n=5 res=[5,10,30,50,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	let k = if l < g.n { l } else { g.n };
	if k > 1 {
		for i in k {
			for j in (k - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = k;
	out.s.clear();
	format(out.s, "sorted prefix size: ", k);
	g.steps += k * k;
	out
}
@end
