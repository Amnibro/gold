	var out = v;
	if g.n < 4 { return out; }
	let last_even = if (g.n - 1) % 2 == 0 { g.n - 1 } else { g.n - 2 };
	let tmp = g.res[last_even];
	var i = last_even;
	while i >= 2 {
		g.res[i] = g.res[i - 2];
		i -= 2;
	}
	g.res[0] = tmp;
	g.steps += g.n;
	out.i = last_even;
	out.s.clear();
	format(out.s, "rotated every other number count: ", last_even);
	out
}
@end
