	let cs = ${chunk_size};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var max_val = g.res[i];
		var j = 1;
		while j < cs && i + j < g.n {
			if g.res[i + j] > max_val { max_val = g.res[i + j]; }
			j++;
		}
		g.res[kept] = max_val;
		kept++;
		i += cs;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked nested chunks kept: ", kept);
	g.steps += g.n + 1;
