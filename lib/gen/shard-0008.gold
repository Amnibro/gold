code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a <= b {
			g.res[kept] = a;
			g.res[kept + 1] = b;
			kept += 2;
		}
		i += 2;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted pairs kept ", kept);
	g.steps += kept + 1;
	out
}
@end
