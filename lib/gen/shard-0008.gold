@entry 781a217e86daafd5
kind: step
verb: dedupe
noun: function
modifier: sorted
context: aggregate
phrase: dedupe function {f} mapped outputs in sorted order
phrase: map function {f} across list removing duplicate sorted values
slot: f fn
test: list=3,1,3,2 f=double
expect: => i=3 r=0.0 ok=true s="deduped sorted mapped count: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=4,2,2 f=square
expect: => i=2 r=0.0 ok=true s="deduped sorted mapped count: 2" errors=0 n=2 res=[4,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { g.res[i] = ${f}(g.res[i]); }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var kept = 0;
	var k = 0;
	while k < g.n {
		if kept == 0 || g.res[k] != g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
		k++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped sorted mapped count: ", kept);
	g.steps += g.n + 1;
	out
}
@end
