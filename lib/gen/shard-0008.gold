@entry f49a928007dcd453
kind: step
verb: search
noun: average
modifier: recursively
context: filter
phrase: search average recursively toward target value {target}
phrase: find recursive average threshold reaching target {target}
slot: target int
test: list=10,20,30,40 target=25
expect: => i=0 r=0.0 ok=true s="searched average in rounds: 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,10,15 target=30
expect: => i=2 r=0.0 ok=true s="searched average in rounds: 2" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var rounds = 0;
	while rounds < 10 && g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		if avg >= tgt { break; }
		var kept = 0;
		for i in g.n {
			if g.res[i] >= avg {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		if kept == g.n { break; }
		g.n = kept;
		rounds++;
	}
	out.i = rounds;
	out.s.clear();
	format(out.s, "searched average in rounds: ", rounds);
	g.steps += rounds + 1;
	out
}
@end
