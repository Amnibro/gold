phrase: shift prime comparison numbers by offset {shift}
slot: shift int
test: list=2,3,5,8,10 shift=1
expect: => i=1 r=0.0 ok=true s="rotated primes running offset: 1" errors=0 n=5 res=[3,5,8,10,2] cache=0 hits=0
test: list=7,11,4,6 shift=1
expect: => i=1 r=0.0 ok=true s="rotated primes running offset: 1" errors=0 n=4 res=[11,4,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s <= 0 { return out; }
	var prime_count = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) { prime_count++; }
	}
	let rot = ((s + prime_count) % (g.n - 1)) + 1;
	var tmp int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[(i + rot) % g.n];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n + 1;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated primes running offset: ", rot);
	out
}
@end
