expect: => i=135 r=0.0 ok=true s="filled budget to 135" errors=0 n=3 res=[40,50,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${limit};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	var added = 0;
	let add_val = if g.n > 0 { sum / g.n } else { 10 };
	let step_val = if add_val > 0 { add_val } else { 1 };
	while sum < target && g.n < 512 {
		gold_push(g, step_val);
		sum += step_val;
		added++;
	}
	g.steps += added;
	out.i = sum;
	out.s.clear();
	format(out.s, "filled budget to ", sum);
	out
}
@end
