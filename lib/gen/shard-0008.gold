	let count = ${k};
	if count <= 1 || count > g.n { return out; }
	for i in count {
		for j in (i + 1)..count {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted tally prefix count: ", count);
	out
}
@end
