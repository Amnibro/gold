	while i < g.n {
		g.res[i] += inc;
		modified++;
		i += 2;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "incremented ", modified, " alternate positions");
	out
}
@end
@entry 438f4be631139cda
kind: step
verb: limit
noun: tail
modifier: with_retry
context: sort
phrase: limit tail element to ceiling {ceiling} with retry
phrase: cap trailing sorted item to bound {ceiling}
slot: ceiling int
test: list=10,20,50 ceiling=30
expect: => i=30 r=0.0 ok=true s="tail capped to ceiling" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,10,15 ceiling=20
expect: => i=15 r=0.0 ok=true s="tail within limit" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let c = ${ceiling};
	let last_idx = g.n - 1;
	if g.res[last_idx] > c {
		g.res[last_idx] = c;
		out.s.clear();
		format(out.s, "tail capped to ceiling");
	} else {
		out.s.clear();
		format(out.s, "tail within limit");
	}
	g.steps += g.n;
	out.i = g.res[last_idx];
	out
}
@end
