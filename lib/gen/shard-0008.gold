code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	let lim = ${limit};
	var count = 0;
	if s > 0 {
		for i in g.n {
			if count < lim {
				g.res[i] = g.res[i] / s;
				count++;
			} else {
				break;
			}
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "normalized count: ", count);
	g.steps += count + 1;
	out
}
@end
