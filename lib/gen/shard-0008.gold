fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${n_items};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	let start = if g.cn > want { g.cn - want } else { 0 };
	var count = 0;
	var idx = start;
	while idx < g.cn {
		g.res[count] = g.cv[idx];
		count++;
		idx++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned last cache values: ", count);
	g.steps += g.cn + 1;
	out
}
