@entry 1ee7163ef0d30033
kind: step
verb: normalize
noun: item
modifier: with_cache
context: math
phrase: normalize first item by {scale} caching previous value
phrase: scale head element using divisor {scale} with cache backup
slot: scale int
test: list=20,40 scale=5
expect: => i=4 r=0.0 ok=true s="normalized head: 4" errors=0 n=2 res=[4,40] cache=1 hits=0
test: list=18,36 scale=6
expect: => i=3 r=0.0 ok=true s="normalized head: 3" errors=0 n=2 res=[3,36] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	if g.n > 0 && s != 0 {
		gold_cache_put(g, 0, g.res[0]);
		g.res[0] = g.res[0] / s;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "normalized head: ", out.i);
	g.steps += 1;
	out
}
@end
@entry 42e145ee7ece4a28
kind: step
verb: fill
noun: window
modifier: sorted
context: math
phrase: fill sorted window of {count} items with value {val}
phrase: overwrite sorted leading window using {val} across {count}
slot: val int
slot: count int
test: list=5,1,8,3 count=2 val=0
expect: => i=0 r=0.0 ok=true s="filled window: 0" errors=0 n=4 res=[0,0,5,8] cache=0 hits=0
test: list=20,10,40 count=1 val=9
expect: => i=9 r=0.0 ok=true s="filled window: 9" errors=0 n=3 res=[9,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	let c = ${count};
	let v_val = ${val};
	for i in c {
		if i < g.n {
			g.res[i] = v_val;
		}
	}
	out.i = v_val;
	out.s.clear();
	format(out.s, "filled window: ", v_val);
	g.steps += g.n + 1;
	out
}
@end
@entry 60f8fcb7914d7a34
kind: step
verb: fill
noun: average
modifier: up_to
context: math
phrase: fill results with average value bounded up to {cap}
phrase: replace elements with mean clamped at ceiling {cap}
slot: cap int
test: list=10,20,30 cap=15
expect: => i=15 r=0.0 ok=true s="filled average: 15" errors=0 n=3 res=[15,15,15] cache=0 hits=0
test: list=10,30,50 cap=40
expect: => i=30 r=0.0 ok=true s="filled average: 30" errors=0 n=3 res=[30,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = if g.n > 0 { sum / g.n } else { 0 };
	let ceil = ${cap};
	if avg > ceil { avg = ceil; }
	for i in g.n { g.res[i] = avg; }
	out.i = avg;
	out.s.clear();
	format(out.s, "filled average: ", avg);
	g.steps += g.n + 1;
	out
}
@end
