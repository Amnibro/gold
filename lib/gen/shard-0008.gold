expect: => i=2 r=0.0 ok=true s="split values safely around mean" errors=0 n=4 res=[2,4,9,15] cache=0 hits=0
test: list=10,10,10
expect: => i=0 r=0.0 ok=true s="split values safely around mean" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var below = 0;
	var above = 0;
	for i in g.n {
		if g.res[i] < avg { below++; }
		else { above++; }
	}
	g.steps += g.n;
	out.i = below;
	out.s.clear();
	format(out.s, "split values safely around mean");
	out
}
@end
