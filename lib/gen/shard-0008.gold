code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var swapped = false;
	if g.n >= 2 {
		let diff = abs(g.res[g.n - 1] - g.res[g.n - 2]);
		if diff > mg {
			let tmp = g.res[g.n - 1];
			g.res[g.n - 1] = g.res[g.n - 2];
			g.res[g.n - 2] = tmp;
			swapped = true;
		}
	}
	out.ok = swapped;
	g.steps++;
	out
}
@end
