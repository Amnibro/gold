@entry 37636cf28b1f72dd
kind: step
verb: drop
noun: memo
modifier: safely
context: list
phrase: drop memo cache entry safely at key {key}
phrase: remove cached memo value safely for key {key}
slot: key int
test: list=1,2,3 key=0
expect: => i=0 r=0.0 ok=false s="dropped memo key: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20 key=5
expect: => i=0 r=0.0 ok=false s="dropped memo key: 5" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var found = false;
	for i in g.cn {
		if g.ck[i] == k {
			found = true;
			for j in (i + 1)..g.cn {
				g.ck[j - 1] = g.ck[j];
				g.cv[j - 1] = g.cv[j];
			}
			g.cn--;
			break;
		}
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
