fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "word collection limit must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	let w = words(out.s);
	if w.len == 0 {
		gold_fail(g, "no words available in text");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no words");
		return out;
	}
	var count = 0;
	for word in w {
		if count < lim {
			gold_push(g, word.len);
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " word lengths");
	out
}
