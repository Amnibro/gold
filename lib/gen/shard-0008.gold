@entry 6d322e07a8533665
kind: step
verb: drop
noun: squares
modifier: between
context: search
phrase: drop perfect squares falling between {low} to {high}
phrase: remove square search values between {low} to {high}
slot: low int
slot: high int
test: list=4,7,9,12,16 low=5 high=10
expect: => i=4 r=0.0 ok=true s="kept 4 non matching square items" errors=0 n=4 res=[4,7,12,16] cache=0 hits=0
test: list=1,4,9 low=1 high=20
expect: => i=0 r=0.0 ok=true s="kept 0 non matching square items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if !(is_sq && x >= l && x <= h) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " non matching square items");
	out
}
@end
