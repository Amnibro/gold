fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] <= bound {
			gold_cache_put(g, g.res[i], g.res[i + 1]);
			pairs++;
