			g.res[kept] = g.res[k];
			kept++;
		}
	}
	gold_cache_put(g, md, kept);
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items with at least min digits");
