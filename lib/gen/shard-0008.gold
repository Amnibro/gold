test: list=7,7,8,9
expect: => i=7 r=0.0 ok=true s="most frequent item 7" errors=0 n=4 res=[7,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_val = g.res[0];
	var best_freq = 0;
	for i in g.n {
		let target = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == target { freq++; }
		}
		if freq > best_freq {
			best_freq = freq;
			best_val = target;
		}
	}
	g.steps += g.n * g.n + 2;
	out.i = best_val;
	out.s.clear();
	format(out.s, "most frequent item ", best_val);
	out
}
@end
