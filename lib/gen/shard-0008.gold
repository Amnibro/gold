code:
recursive fn ${ID}_helper(out const byte[:], idx int, cur_run int, max_allowed int) bool {
	if idx >= out.len { return true; }
	let next_run = if idx > 0 && out[idx] == out[idx - 1] { cur_run + 1 } else { 1 };
	if next_run > max_allowed { return false; }
	${ID}_helper(out, idx + 1, next_run, max_allowed)
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_run};
	let ok = ${ID}_helper(out.s[..], 0, 0, cap);
	if !ok {
		gold_fail(g, "consecutive run exceeded limit");
	}
	out.ok = ok;
	g.steps += out.s.len;
	out
}
@end
