fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_swaps};
	var swaps = 0;
	for i in g.n - 1 {
		if swaps >= limit { break; }
		if g.res[i] == g.res[i + 1] {
			g.res[i + 1] += 1;
			swaps++;
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "adjusted ", swaps, " duplicates up to limit");
	out
}
@end
