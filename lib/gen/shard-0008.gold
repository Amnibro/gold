code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var shifts = 0;
	while g.n > 1 && g.res[0] < limit && shifts < g.n {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted values until thresh: ", shifts);
	g.steps += shifts + 1;
	out
}
@end
