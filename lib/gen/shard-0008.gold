@entry 630522c812e39fbb
kind: step
verb: swap
noun: list
modifier: with_retry
context: transform
phrase: swap list endpoints with retry threshold {threshold}
phrase: exchange list ends with retry threshold {threshold}
slot: threshold int
test: list=50,20,10 threshold=15
expect: => i=1 r=0.0 ok=true s="endpoints swapped" errors=0 n=3 res=[10,20,50] cache=0 hits=0
test: list=20,30,15 threshold=15
expect: => i=0 r=0.0 ok=true s="endpoints kept" errors=0 n=3 res=[20,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n <= 1 {
		out.i = 0;
		g.steps++;
		return out;
	}
	let first = g.res[0];
	let last = g.res[g.n - 1];
	out.s.clear();
	if first - last > thresh {
		g.res[0] = last;
		g.res[g.n - 1] = first;
		out.i = 1;
		format(out.s, "endpoints swapped");
	} else {
		out.i = 0;
