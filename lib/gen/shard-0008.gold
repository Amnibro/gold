noun: history
modifier: until
context: math
phrase: shift results left until first reaches limit {limit}
phrase: cycle items leftward stopping when head equals {limit}
slot: limit int
test: list=5,8,12,20 limit=12
expect: => i=2 r=0.0 ok=true s="shifted history: 2" errors=0 n=4 res=[12,20,5,8] cache=0 hits=0
test: list=1,2,3,4 limit=3
expect: => i=2 r=0.0 ok=true s="shifted history: 2" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${limit};
	var shifts = 0;
	while g.n > 1 && g.res[0] != target && shifts < g.n {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted history: ", shifts);
	g.steps += shifts + 1;
	out
}
@end
