@entry 20f4c0ad97de7e80
kind: step
verb: rotate
noun: step
modifier: each
context: core
phrase: rotate step shifting each element by step offset {step}
phrase: apply cyclic step rotation by offset {step}
slot: step int
test: list=1,2,3,4,5 step=2
expect: => i=5 r=0.0 ok=true s="rotated step each count: 5" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 step=1
expect: => i=3 r=0.0 ok=true s="rotated step each count: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n > 1 {
		let shift = s % g.n;
		var temp: int[512] = [0; 512];
		for i in g.n {
			let new_idx = (i + shift) % g.n;
			temp[new_idx] = g.res[i];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated step each count: ", g.n);
	g.steps += g.n + 1;
	out
}
@end
