test: list=5,4,3 threshold=10
expect: => i=0 r=0.0 ok=false s="no nested swap" errors=0 n=3 res=[5,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var swapped = false;
	var i = 0;
	while i + 1 < g.n && !swapped {
		if g.res[i] > thresh && g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped = true;
		}
		i++;
	}
	out.ok = swapped;
	out.s.clear();
	if swapped {
		format(out.s, "swapped nested pair");
		out.i = 1;
	} else {
		format(out.s, "no nested swap");
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
