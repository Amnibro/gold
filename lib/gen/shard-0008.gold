	let mg = ${max_gap};
	var adjusted = 0;
	if g.n > 1 {
		for k in 1..g.n {
			let d = g.res[k] - g.res[k - 1];
			if d > mg {
				g.res[k] = g.res[k - 1] + mg;
				adjusted++;
			}
		}
	}
	gold_cache_put(g, mg, adjusted);
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted ", adjusted, " consecutive spaces");
	out
}
