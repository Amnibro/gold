		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.res[g.n / 2];
	g.steps += g.n * g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "sorted history median is ", mid);
	out
}
