expect: => i=4 r=0.0 ok=true s="deduped between range: 4" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= lo && val <= hi {
			var seen = false;
			for j in kept {
				if g.res[j] == val { seen = true; break; }
			}
			if !seen {
				g.res[kept] = val;
				kept++;
			}
		} else {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped between range: ", kept);
	g.steps += g.n + 1;
	out
}
@end
