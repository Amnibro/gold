fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var len = 0;
	var temp = x;
	while temp > 0 { len++; temp /= 10; }
	var half = len / 2;
	var div = 1;
	while half > 0 { div *= 10; half--; }
	let lower = x % div;
	let upper = x / div;
	upper + lower
}
