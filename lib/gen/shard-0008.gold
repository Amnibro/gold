@entry 4be6ce0f425906c8
kind: step
verb: rank
noun: step
modifier: in_reverse
context: filter
phrase: rank step in reverse order checking step size {min_step}
phrase: filter reverse sequence keeping step jumps at least {min_step}
slot: min_step int
test: list=2,5,8,12 min_step=3
expect: => i=4 r=0.0 ok=true s="ranked reverse step items: 4" errors=0 n=4 res=[12,8,5,2] cache=0 hits=0
test: list=1,4,6,10 min_step=4
expect: => i=3 r=0.0 ok=true s="ranked reverse step items: 3" errors=0 n=3 res=[10,6,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_step};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	var kept = 0;
	if g.n > 0 {
		kept = 1;
		var last_val = g.res[0];
		var k = 1;
		while k < g.n {
			let diff = last_val - g.res[k];
			let step = if diff < 0 { -diff } else { diff };
			if step >= ms {
				g.res[kept] = g.res[k];
				last_val = g.res[k];
				kept++;
			}
			k++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked reverse step items: ", kept);
	g.steps += g.n + 1;
	out
}
@end
@entry 245babd299887fc2
kind: step
verb: validate
noun: window
modifier: pairwise
context: filter
phrase: validate window pairwise differences bounded by {max_diff}
phrase: check adjacent element pairs within window bound {max_diff}
slot: max_diff int
test: list=2,4,5,7 max_diff=3
expect: => i=1 r=0.0 ok=true s="pairwise window valid: 1" errors=0 n=4 res=[2,4,5,7] cache=0 hits=0
test: list=1,8,10 max_diff=5
expect: => i=0 r=0.0 ok=false s="pairwise window valid: 0" errors=1 n=3 res=[1,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var valid = true;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > md {
			valid = false;
			break;
		}
		k++;
	}
	out.ok = valid;
	if !valid {
		gold_fail(g, "pairwise window validation exceeded bound");
	}
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "pairwise window valid: ", out.i);
	g.steps += g.n + 1;
	out
}
@end
