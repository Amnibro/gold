		for k in g.n {
			if g.res[k] % m == 0 {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " items");
	out
}
