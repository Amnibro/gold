@entry bc670b0906fc0069
kind: step
verb: map
noun: gaps
modifier: unique
context: transform
phrase: map unique difference gaps between adjacent items
phrase: transform adjacent gaps preserving unique differences
test: list=10,12,14,20
expect: => i=2 r=0.0 ok=true s="mapped 2 unique gaps" errors=0 n=2 res=[2,6] cache=0 hits=0
test: list=5,10,15,20
expect: => i=1 r=0.0 ok=true s="mapped 1 unique gaps" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		g.steps++;
		return out;
	}
	var u_gaps int[512] = [0; 512];
	var u_count = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		var seen = false;
		for j in u_count {
			if u_gaps[j] == gap { seen = true; }
		}
		if !seen {
			u_gaps[u_count] = gap;
			u_count++;
		}
		i++;
	}
	for k in u_count { g.res[k] = u_gaps[k]; }
	g.n = u_count;
	out.i = u_count;
	out.s.clear();
	format(out.s, "mapped ", u_count, " unique gaps");
	g.steps += u_count;
	out
}
@end
