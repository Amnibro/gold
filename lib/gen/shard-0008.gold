slot: factor int
test: list=2,5,5,5 factor=3
expect: => i=3 r=0.0 ok=true s="scaled last run of 3 values" errors=0 n=4 res=[2,15,15,15] cache=0 hits=0
test: list=10,20,20 factor=2
expect: => i=2 r=0.0 ok=true s="scaled last run of 2 values" errors=0 n=3 res=[10,40,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let mult = ${factor};
	let target = g.res[g.n - 1];
	var start = g.n - 1;
	while start > 0 && g.res[start - 1] == target { start--; }
	let len = g.n - start;
	for i in start..g.n { g.res[i] = g.res[i] * mult; }
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "scaled last run of ", len, " values");
	out
}
@end
