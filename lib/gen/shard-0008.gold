@entry 88a8518c14a45694
kind: step
verb: select
noun: streak
modifier: sorted
context: aggregate
phrase: select longest sorted streak from results
phrase: extract maximal ascending sorted sequence
test: list=1,3,2,4,5,6,1
expect: => i=4 r=0.0 ok=true s="selected sorted streak of length 4" errors=0 n=4 res=[2,4,5,6] cache=0 hits=0
test: list=9,8,7,2,3,4
expect: => i=3 r=0.0 ok=true s="selected sorted streak of length 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len {
		best_len = cur_len;
		best_start = cur_start;
	}
	var j = 0;
	while j < best_len {
		g.res[j] = g.res[best_start + j];
		j++;
	}
	g.n = best_len;
	g.steps += g.n + 5;
	out.i = best_len;
	out.s.clear();
	format(out.s, "selected sorted streak of length ", best_len);
	out
}
@end
