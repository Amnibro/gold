fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var cleaned byte[..200] = "";
	var count = 0;
	var i = 0;
	while i < out.s.len {
		if out.s[i] == ' ' && i + 1 < out.s.len && out.s[i + 1] == ' ' && count < cap {
			count++;
		} else {
			if cleaned.len < 200 { cleaned.push(out.s[i]); }
		}
		i++;
	}
	out.s.clear();
	for b in cleaned { out.s.push(b); }
	g.steps += out.s.len;
	out.i = count;
	out
}
