phrase: reverse prefix slice calculating running sum
phrase: invert first {k} elements computing running total
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=6 r=0.0 ok=true s="reversed prefix running sum 6" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=30 r=0.0 ok=true s="reversed prefix running sum 30" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${k};
	let count = if bound < g.n { bound } else { g.n };
	if count > 1 {
		var l = 0;
		var r = count - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	var sum = 0;
	for i in count { sum += g.res[i]; }
	g.steps += count + 2;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed prefix running sum ", sum);
	out
}
@end
