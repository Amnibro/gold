fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		if x == 0 { total_digits++; }
		while x > 0 {
			total_digits++;
			x /= 10;
		}
	}
	g.steps += g.n * 2 + 1;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "counted total digits ", total_digits);
	out
}
@end
