@entry 68d9278c64cc7ef4
kind: step
verb: keep
noun: squares
modifier: running
context: core
phrase: keep square values replacing with running sum
phrase: track running accumulation of perfect squares
test: list=1,4,3,9,16
expect: => i=4 r=0.0 ok=true s="running squares kept 4" errors=0 n=4 res=[1,5,14,30] cache=0 hits=0
test: list=2,4,8,16
