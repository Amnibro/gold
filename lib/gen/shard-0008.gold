fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_neg = false;
	for i in g.n {
		if g.res[i] < 0 { has_neg = true; }
	}
	if has_neg && g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[1];
		g.res[1] = tmp;
	}
	g.steps += g.n + 1;
	out.ok = has_neg;
	out.i = if has_neg { 1 } else { 0 };
	out.s.clear();
	format(out.s, "swapped prefix status ", out.i);
	out
}
@end
