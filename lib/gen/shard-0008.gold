@entry 7ceae50f66cf3a09
kind: step
verb: shift
noun: window
modifier: in_reverse
context: list
phrase: shift window elements in reverse by {count}
phrase: rotate window backwards by {count} steps
slot: count int
test: list=1,2,3,4,5 count=1
expect: => i=1 r=0.0 ok=true s="shifted window reverse: 1" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="shifted window reverse: 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n > 1 && c > 0 {
		let shift_amt = c % g.n;
		for step in shift_amt {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	out.i = c;
	out.s.clear();
	format(out.s, "shifted window reverse: ", c);
	g.steps += g.n;
	out
}
@end
