slot: offset int
test: text="abc" offset=1
expect: => i=3 r=0.0 ok=true s="bcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" offset=3
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in out.s.len {
		let b = out.s[i];
		if b >= 97 && b <= 122 {
			var shifted = (b as int) + off;
			while shifted > 122 { shifted -= 26; }
			while shifted < 97 { shifted += 26; }
			out.s[i] = shifted as byte;
		}
	}
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
