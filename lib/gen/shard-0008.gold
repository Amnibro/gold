@entry cfe7f1086978a70f
kind: step
verb: swap
noun: odds
modifier: at_most
context: loop
phrase: swap odd numbers up to at most {limit} times
phrase: exchange adjacent odd elements at most {limit}
slot: limit int
test: list=1,3,5,7 limit=2
expect: => i=2 r=0.0 ok=true s="swapped 2 odd pairs" errors=0 n=4 res=[3,1,7,5] cache=0 hits=0
test: list=9,11,4,13,15 limit=1
expect: => i=1 r=0.0 ok=true s="swapped 1 odd pairs" errors=0 n=5 res=[11,9,4,13,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && swaps < lim {
		if core_is_odd(g.res[i]) && core_is_odd(g.res[i + 1]) {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " odd pairs");
	out
}
@end
@entry 57285a34ade1ec92
kind: step
verb: scale
noun: memo
modifier: unique
context: loop
phrase: scale unique loop items recording memo cache by {mult}
phrase: multiply distinct values in loop memo by {mult}
slot: mult int
test: list=2,3,2,4,3 mult=5
expect: => i=5 r=0.0 ok=true s="scaled 5 unique memo items" errors=0 n=5 res=[10,15,10,20,15] cache=3 hits=0
test: list=1,1,1,2,3 mult=10
expect: => i=5 r=0.0 ok=true s="scaled 5 unique memo items" errors=0 n=5 res=[10,10,10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in unique_count {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			let scaled = x * m;
			gold_cache_put(g, x, scaled);
			g.res[unique_count] = scaled;
			unique_count++;
		}
	}
	g.n = unique_count;
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "scaled ", unique_count, " unique memo items");
	out
}
