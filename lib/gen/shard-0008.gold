@entry 19e5dc620fc12dcc
kind: step
verb: retry
noun: items
modifier: until
context: sort
phrase: retry sorting items until limit {limit}
phrase: reorder items with pass limit {limit}
slot: limit int
test: list=5,3,1 limit=5
expect: => i=3 r=0.0 ok=true s="sorted items in passes: 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=10,20,5 limit=1
expect: => i=1 r=0.0 ok=true s="sorted items in passes: 1" errors=0 n=3 res=[10,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var pass = 0;
	while pass < limit {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		pass++;
		if !swapped { break; }
	}
	out.i = pass;
	out.s.clear();
	format(out.s, "sorted items in passes: ", pass);
	g.steps += pass * g.n + 1;
	out
}
@end
