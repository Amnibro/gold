@entry fb27ed885b1d1910
kind: step
verb: trace
noun: streak
modifier: with_retry
context: filter
phrase: trace streak of increasing values with retry attempts {retries} target {min_len}
phrase: filter longest increasing streak using {retries} retries seeking {min_len}
slot: min_len int
slot: retries int
test: list=1,2,5,3,4,8,9 min_len=4 retries=2
expect: => i=4 r=0.0 ok=true s="traced streak length: 4" errors=0 n=4 res=[3,4,8,9] cache=0 hits=0
test: list=10,5,6,7,2,3 min_len=3 retries=1
expect: => i=3 r=0.0 ok=true s="traced streak length: 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let max_r = ${retries};
	var best_start = 0;
	var best_len = 0;
	var r = 0;
	while r <= max_r {
		var start = r;
		while start < g.n {
			var len = 1;
			while start + len < g.n && g.res[start + len] > g.res[start + len - 1] {
				len++;
			}
			if len > best_len {
				best_len = len;
				best_start = start;
			}
			start += len;
		}
		if best_len >= ml { break; }
		r++;
	}
	var kept = 0;
	for k in best_len {
		g.res[kept] = g.res[best_start + k];
		kept++;
	}
	g.n = kept;
	out.i = best_len;
	out.s.clear();
	format(out.s, "traced streak length: ", best_len);
	g.steps += g.n + 1;
	out
}
@end
