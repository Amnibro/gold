fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let ok = sum < lim;
	if !ok {
		gold_fail(g, "sum exceeded limit");
	}
	out.ok = ok;
	out.i = sum;
	g.steps += g.n;
	out
}
