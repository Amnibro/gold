fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	for k in g.n {
		if g.res[k] > 0 && g.res[k] < min_val { min_val = g.res[k]; }
	}
	if min_val == 999999 { min_val = 1; }
	var replaced = 0;
	for k in g.n {
		if g.res[k] == 0 {
			g.res[k] = min_val;
			replaced++;
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "filled ", replaced, " zeros with minimum ", min_val);
	out
}
@end
