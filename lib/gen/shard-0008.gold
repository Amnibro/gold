fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${limit};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= bound { break; }
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " steps until boundary");
	out
}
@end
