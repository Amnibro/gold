code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 {
		gold_fail(g, "uneven segments for average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: uneven segments for average");
		return out;
	}
	var pairs = g.n / 2;
	var last_avg = 0;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let avg = (a + b) / 2;
		gold_cache_put(g, k, avg);
		last_avg = avg;
	}
	g.steps += g.n;
	out.i = last_avg;
	out.r = last_avg as real;
	out.s.clear();
	format(out.s, "cached ", pairs, " segment averages");
	out
}
@end
