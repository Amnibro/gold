@entry 78ca203adc97acd4
kind: step
verb: select
noun: number
modifier: recursively
context: cache
phrase: select cached numbers recursively with depth {depth}
phrase: follow recursive cache pointers with depth {depth}
slot: depth int
test: list=1,2,3,0 depth=3
expect: => i=3 r=0.0 ok=true s="traversed recursive cache pointer: 3" errors=0 n=4 res=[1,2,3,0] cache=4 hits=3
test: list=2,0,1 depth=2
expect: => i=1 r=0.0 ok=true s="traversed recursive cache pointer: 1" errors=0 n=3 res=[2,0,1] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let depth = ${depth};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var cur = 0;
	var step = 0;
	while step < depth {
		let next_val, ok = gold_cache_get(g, cur);
		if !ok { break; }
		cur = next_val;
		step++;
	}
	out.i = cur;
	out.s.clear();
	format(out.s, "traversed recursive cache pointer: ", cur);
	g.steps += step + 1;
	out
}
@end
