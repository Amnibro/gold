fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for k in 0..(g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		gold_cache_put(g, k, diff);
	}
	g.steps += g.n - 1;
	out.i = g.n - 1;
	out.s.clear();
	format(out.s, "cached ", g.n - 1, " pairwise differences");
	out
}
