fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	let head = g.res[0];
	var any_match = false;
	var i = 1;
	while i < g.n {
		if g.res[i] == head { any_match = true; }
		i++;
	}
	out.s.clear();
	if any_match {
		g.res[0] = tgt;
		out.i = tgt;
		format(out.s, "duplicate head replaced");
	} else {
		out.i = head;
		format(out.s, "head unique");
	}
	g.steps += g.n;
	out
}
@end
