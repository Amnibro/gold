fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = v.i;
	var i = 0;
	while i < g.n {
		gold_cache_put(g, i, g.res[i]);
		i += 1;
	}
	var kept = 0;
	i = 0;
	while i < g.cn {
		if g.cv[i] >= thresh {
			g.res[kept] = g.cv[i];
			kept += 1;
		}
		i += 1;
	}
	g.n = kept;
	out.i = kept;
	out.ok = kept > 0;
	out.s.clear();
	format(out.s, "collected ", kept, " cached values at least ", thresh);
	g.steps += g.cn + kept;
	out
}
