@entry 2c784160c934163c
kind: step
verb: measure
noun: vowels
modifier: while
context: core
phrase: measure vowel count while consonants under {max_c}
phrase: count vowels in string while consonant limit {max_c}
slot: max_c int
test: text="aeioubcdf" max_c=2
expect: => i=5 r=0.0 ok=true s="measured vowels count 5" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world" max_c=3
expect: => i=1 r=0.0 ok=true s="measured vowels count 1" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_c};
	var vowels = 0;
	var consonants = 0;
	var i = 0;
	while i < out.s.len && consonants < limit {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels++;
		} else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			consonants++;
		}
		i++;
	}
	g.steps += i + 2;
	out.i = vowels;
	out.s.clear();
	format(out.s, "measured vowels count ", vowels);
	out
}
@end
@entry 9441c6b59dc0ff16
kind: step
verb: check
noun: runs
modifier: until
context: core
phrase: check consecutive equal runs until bound {lim}
phrase: verify contiguous runs up to limit {lim}
slot: lim int
test: list=1,1,2,2,3,4 lim=2
expect: => i=1 r=0.0 ok=true s="checked runs valid 1" errors=0 n=6 res=[1,1,2,2,3,4] cache=0 hits=0
test: list=5,5,5,6 lim=2
expect: => i=0 r=0.0 ok=false s="checked runs valid 0" errors=0 n=4 res=[5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	var valid = true;
	if g.n > 0 {
		var cur_len = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_len++;
				if cur_len > ceiling { valid = false; }
			} else {
				cur_len = 1;
			}
			i++;
		}
	}
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked runs valid ", out.i);
	out
}
@end
@entry 4de060c21e5d74ba
kind: step
verb: swap
noun: sequence
modifier: in_reverse
context: core
phrase: swap entire sequence in reverse order
phrase: invert sequence reversing element order completely
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="swapped sequence reversed 3" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="swapped sequence reversed 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n + 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped sequence reversed ", g.n);
	out
}
@end
@entry f68b013dfc56365a
kind: step
verb: retry
noun: suffix
modifier: sorted
context: core
phrase: retry suffix elements sorting in place
phrase: sort trailing suffix items ascending
slot: count int
test: list=10,50,40,30,20 count=4
expect: => i=4 r=0.0 ok=true s="sorted suffix count 4" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=9,8,7 count=2
expect: => i=2 r=0.0 ok=true s="sorted suffix count 2" errors=0 n=3 res=[9,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var i = start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += (g.n - start) + 4;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "sorted suffix count ", out.i);
	out
}
@end
@entry 7480017b8477e69d
kind: step
