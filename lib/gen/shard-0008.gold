fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var swaps = 0;
	for i in g.n {
		let d1 = g.res[i] / 10;
		let d2 = g.res[i] % 10;
		if d1 >= low && d1 <= high && d2 >= low && d2 <= high && d1 > d2 {
			g.res[i] = d2 * 10 + d1;
			swaps++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped digits count ", swaps);
	out
}
@end
