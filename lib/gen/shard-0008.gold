@entry 1daf0d10221b1d4c
kind: step
verb: fold
noun: gaps
modifier: unique
context: aggregate
phrase: fold gaps between unique elements in sequence
phrase: aggregate differences across consecutive unique items
test: list=2,5,5,9,14
expect: => i=12 r=0.0 ok=true s="folded unique gaps sum: 12" errors=0 n=4 res=[2,5,9,14] cache=0 hits=0
test: list=10,15,15,20,30
expect: => i=20 r=0.0 ok=true s="folded unique gaps sum: 20" errors=0 n=4 res=[10,15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	var total_gap = 0;
	var k = 1;
	while k < g.n {
		let diff = g.res[k] - g.res[k - 1];
		total_gap += if diff < 0 { -diff } else { diff };
		k++;
	}
	out.i = total_gap;
	out.s.clear();
	format(out.s, "folded unique gaps sum: ", total_gap);
	g.steps += g.n + 1;
	out
}
@end
