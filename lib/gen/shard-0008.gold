fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var cur_depth = 0;
	var max_depth = 0;
	for b in out.s {
		if b == 40 {
			cur_depth++;
			if cur_depth > max_depth { max_depth = cur_depth; }
		} else if b == 41 {
			cur_depth--;
			if cur_depth < 0 {
				gold_fail(g, "unmatched closing parenthesis");
				out.ok = false;
				out.s.clear();
				format(out.s, "error: unmatched parenthesis");
				return out;
			}
		}
	}
	if cur_depth != 0 {
		gold_fail(g, "unbalanced open parentheses");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: unbalanced parentheses");
		return out;
	}
	if max_depth > d {
		gold_fail(g, "nested depth exceeds limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: depth exceeded");
		return out;
	}
	g.steps += out.s.len;
	out.i = max_depth;
	out.s.clear();
	format(out.s, "max nested depth is ", max_depth);
	out
}
@end
