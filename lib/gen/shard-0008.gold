@entry 6a7ff658bef06281
kind: step
verb: sort
noun: average
modifier: in_place
context: math
phrase: sort items by distance from average in place
phrase: order elements by deviation from mean in place
test: list=10,20,5,30
expect: => i=4 r=0.0 ok=true s="sorted 4 items by deviation from mean 16" errors=0 n=4 res=[20,10,5,30] cache=0 hits=0
test: list=1,9,4
expect: => i=3 r=0.0 ok=true s="sorted 3 items by deviation from mean 4" errors=0 n=3 res=[4,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		out.s.append("trivial list");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	var a = 0;
	while a < g.n - 1 {
		var b = 0;
		while b < g.n - 1 - a {
			var dev1 = g.res[b] - avg;
			if dev1 < 0 {
				dev1 = -dev1;
			}
			var dev2 = g.res[b + 1] - avg;
			if dev2 < 0 {
				dev2 = -dev2;
			}
			if dev1 > dev2 {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
			}
			b += 1;
		}
		a += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items by deviation from mean ", avg);
	g.steps += g.n * g.n;
	out
}
@end
