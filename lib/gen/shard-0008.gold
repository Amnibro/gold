@entry e5f9b396d24c6b0e
kind: step
verb: drop
noun: value
modifier: in_reverse
context: math
phrase: drop matching value scanning sequence in reverse
phrase: remove first occurrence of target {target} from tail
slot: target int
test: list=1,2,3,2,4 target=2
expect: => i=1 r=0.0 ok=true s="dropped index: 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,7 target=6
expect: => i=1 r=0.0 ok=true s="dropped index: 1" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var drop_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			drop_idx = i;
			break;
		}
		i--;
	}
	if drop_idx >= 0 {
		for j in (drop_idx + 1)..g.n {
			g.res[j - 1] = g.res[j];
		}
		g.n--;
	}
	out.i = if drop_idx >= 0 { 1 } else { 0 };
	out.s.clear();
	format(out.s, "dropped index: ", drop_idx);
	g.steps += g.n + 1;
	out
}
@end
