code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rev int[512] = [0; 512];
	var rn = 0;
	let old_n = g.n;
	for i in old_n {
		let x = g.res[old_n - 1 - i];
		let cv, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, 1);
			rev[rn] = x;
			rn++;
		}
	}
	gold_clear(g);
	for i in rn {
		gold_push(g, rev[rn - 1 - i]);
	}
	g.steps += old_n;
	out.i = rn;
	out.s.clear();
	format(out.s, "filtered in reverse to ", rn, " items");
	out
}
@end
