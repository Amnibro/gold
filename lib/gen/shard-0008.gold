		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var k = if count < g.n { count } else { g.n };
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "reversed sorted head count: ", k);
	g.steps += g.n + 1;
	out
}
@end
@entry f43852b22d930e6b
kind: step
verb: count
noun: window
modifier: recursively
context: sort
phrase: count sorted windows recursively with size {w}
phrase: recursively tally sorted windows of length {w}
slot: w int
test: list=1,3,2,4,5 w=3
expect: => i=1 r=0.0 ok=true s="sorted windows counted: 1" errors=0 n=5 res=[1,3,2,4,5] cache=0 hits=0
test: list=5,4,3,2,1 w=2
expect: => i=0 r=0.0 ok=true s="sorted windows counted: 0" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${w};
	var valid_windows = 0;
	if w >= 2 && g.n >= w {
		var start = 0;
		while start + w <= g.n {
			var is_sorted = true;
			var idx = start;
			while idx + 1 < start + w {
				if g.res[idx] > g.res[idx + 1] {
					is_sorted = false;
					break;
				}
				idx++;
			}
			if is_sorted { valid_windows++; }
			start++;
		}
	}
	out.i = valid_windows;
	out.s.clear();
	format(out.s, "sorted windows counted: ", valid_windows);
	g.steps += g.n + 1;
	out
}
@end
@entry f8745f2da8f9bc90
kind: step
verb: merge
noun: head
modifier: until
context: sort
phrase: merge sorted head values until sum reaches {limit}
phrase: combine head elements in sorted array until {limit}
slot: limit int
test: list=4,1,3,2 limit=5
expect: => i=3 r=0.0 ok=true s="merged head sum: 3" errors=0 n=3 res=[3,3,4] cache=0 hits=0
test: list=10,5,2 limit=12
expect: => i=7 r=0.0 ok=true s="merged head sum: 7" errors=0 n=2 res=[7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	var idx = 0;
	while idx < g.n && sum + g.res[idx] <= limit {
		sum += g.res[idx];
		idx++;
	}
	if idx > 0 {
		g.res[0] = sum;
		var w = 1;
		while idx < g.n {
			g.res[w] = g.res[idx];
			w++;
			idx++;
		}
		g.n = w;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "merged head sum: ", sum);
	g.steps += g.n + 1;
	out
}
@end
