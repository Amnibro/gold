code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sn = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			g.res[sn] = cur_len;
			sn++;
			cur_len = 1;
		}
	}
	g.res[sn] = cur_len;
	sn++;
	g.n = sn;
	g.steps += g.n;
	out.i = sn;
	out.s.clear();
	format(out.s, "compressed to ", sn, " streaks");
	out
}
@end
