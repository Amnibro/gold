fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	var idx = 0;
	while idx + win <= out.s.len {
		var has_sp = false;
		for j in win {
			if out.s[idx + j] == ' ' { has_sp = true; }
		}
		if has_sp { break; }
		idx++;
	}
	g.steps += idx;
	out.i = idx;
	out
}
@end
