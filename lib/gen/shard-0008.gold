fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = v.i;
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		gold_cache_put(g, i, g.res[i]);
		sum += g.res[i];
		count += 1;
		if sum >= thresh {
			break;
		}
		i += 1;
	}
	out.i = count;
	out.ok = sum >= thresh;
	out.s.clear();
	format(out.s, "cached ", count, " steps with sum ", sum);
	g.steps += count;
	out
}
@end
