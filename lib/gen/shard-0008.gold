@entry d796021f9eca5210
kind: step
verb: cache
noun: histogram
modifier: any
context: format
phrase: cache frequency histogram of any element
phrase: memoize distinct element frequencies into cache
test: list=5,10,5,20,10
expect: => i=3 r=0.0 ok=true s="histogram cached distinct: 3" errors=0 n=5 res=[5,10,5,20,10] cache=3 hits=0
test: list=7,7,7,8
expect: => i=2 r=0.0 ok=true s="histogram cached distinct: 2" errors=0 n=4 res=[7,7,7,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			var freq = 0;
			for k in g.n {
				if g.res[k] == val { freq++; }
			}
			gold_cache_put(g, val, freq);
			distinct++;
		}
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "histogram cached distinct: ", distinct);
	g.steps += distinct + 1;
	out
}
@end
