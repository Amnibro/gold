fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_threshold};
	var rounds = 0;
	while rounds < 10 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum >= thresh { break; }
		for i in g.n {
			g.res[i] = ${op}(g.res[i]);
		}
		rounds++;
	}
	var final_sum = 0;
	for i in g.n { final_sum += g.res[i]; }
	out.i = final_sum;
	out.s.clear();
	format(out.s, "repeated subfunction sum: ", final_sum);
	g.steps += rounds + 1;
	out
}
@end
