code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	let span = if g.n > k { k } else { g.n };
	for i in span / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[span - 1 - i];
		g.res[span - 1 - i] = tmp;
	}
	for i in span {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed prefix of ", span);
	out
}
@end
