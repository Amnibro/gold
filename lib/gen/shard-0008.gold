kind: step
verb: filter
noun: squares
modifier: with_retry
context: list
phrase: filter perfect squares with retry fallback shift
phrase: keep square numbers in list using retry
test: list=3,4,8,9,12
expect: => i=2 r=0.0 ok=true s="kept 2 square items" errors=0 n=2 res=[4,9] cache=0 hits=0
test: list=3,8,15
