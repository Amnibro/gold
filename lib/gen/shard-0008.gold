code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${max_digits};
	var num = if out.i < 0 { -out.i } else { out.i };
	var d_count = 0;
	if num == 0 {
		d_count = 1;
	} else {
		while num > 0 {
			d_count++;
			num /= 10;
		}
	}
	if d_count > max_d {
		gold_fail(g, "digit count exceeds maximum allowed");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too many digits");
		return out;
	}
	g.steps += d_count;
	out.i = d_count;
	out.s.clear();
	format(out.s, "digit count ", d_count, " within bound ", max_d);
	out
}
@end
