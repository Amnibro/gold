code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_v = -1000000;
	for i in g.n {
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	var boosted = 0;
	for i in g.n {
		var r = 0;
		while g.res[i] < max_v && r < 4 {
			g.res[i] += 2;
			r++;
			boosted++;
		}
	}
	g.steps += boosted;
	out.i = max_v;
	out.s.clear();
	format(out.s, "retried maximum all reached ", max_v);
	out
}
@end
