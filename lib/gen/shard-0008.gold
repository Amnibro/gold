fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var valid_cnt = 0;
	var idx = 1;
	while idx < g.n {
		if g.res[idx] <= 0 {
			gold_fail(g, "non-positive tail element");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "tail validation failed at index ", idx);
			return out;
		}
		valid_cnt++;
		idx += 2;
	}
	g.steps += valid_cnt;
	out.i = valid_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated ", valid_cnt, " alternate tail items");
	out
}
