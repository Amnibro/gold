fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached, ok = gold_cache_get(g, k);
	if ok {
		out.i = cached;
		out.ok = (g.steps >= cached);
	} else {
		gold_cache_put(g, k, g.steps);
		out.i = g.steps;
		out.ok = true;
	}
	out.s.clear();
	format(out.s, "step check key ", k);
	g.steps += 7;
	out
}
