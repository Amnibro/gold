@entry 536e95b23942b9c7
kind: step
verb: split
noun: steps
modifier: any
context: cache
phrase: split results at first step difference exceeding {max_diff}
phrase: partition sequence where adjacent gap exceeds {max_diff}
slot: max_diff int
test: list=10,12,15,30,35 max_diff=5
expect: => i=3 r=0.0 ok=true s="split at position 3" errors=0 n=3 res=[10,12,15] cache=1 hits=0
test: list=1,2,3 max_diff=10
expect: => i=3 r=0.0 ok=true s="split at position 3" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var cut = g.n;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff > md {
				cut = k + 1;
				break;
			}
		}
	}
	g.n = cut;
	gold_cache_put(g, md, cut);
	g.steps += g.n;
	out.i = cut;
	out.s.clear();
	format(out.s, "split at position ", cut);
	out
}
@end
