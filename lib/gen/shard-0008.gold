kind: step
verb: check
noun: range
modifier: running
context: list
phrase: check running range does not exceed {span}
phrase: verify running differences remain within {span}
phrase: confirm running gaps stay under {span}
slot: span int
test: list=10,12,15,18 span=4
expect: => i=3 r=0.0 ok=true s="max running gap was 3" errors=0 n=4 res=[10,12,15,18] cache=0 hits=0
test: list=10,20,25 span=5
expect: => i=10 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${span};
	var max_diff = 0;
	for i in g.n - 1 {
		let diff = abs(g.res[i + 1] - g.res[i]);
		if diff > max_diff { max_diff = diff; }
		if diff > limit {
			gold_fail(g, "running gap exceeded span");
			out.ok = false;
			out.i = diff;
			return out;
		}
	}
	g.steps += g.n;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "max running gap was ", max_diff);
	out
}
@end
