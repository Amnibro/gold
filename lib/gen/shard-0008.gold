@entry 83c81a98e9aacbcf
kind: step
verb: reverse
noun: total
modifier: last
context: cache
phrase: reverse last cached items summing total {limit}
phrase: invert tail cache values up to total {limit}
slot: limit int
test: list=5,10,15,20 limit=40
expect: => i=35 r=0.0 ok=true s="reversed tail cache sum: 35" errors=0 n=4 res=[5,10,15,20] cache=4 hits=0
test: list=2,4,6 limit=10
expect: => i=10 r=0.0 ok=true s="reversed tail cache sum: 10" errors=0 n=3 res=[2,4,6] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var sum = 0;
	var start = g.cn;
	while start > 0 && sum + g.cv[start - 1] <= limit {
		start--;
		sum += g.cv[start];
	}
	var left = start;
	var right = g.cn - 1;
	while left < right {
		let tmp = g.cv[left];
		g.cv[left] = g.cv[right];
		g.cv[right] = tmp;
		left++;
		right--;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed tail cache sum: ", sum);
	g.steps += g.cn + 1;
	out
}
@end
