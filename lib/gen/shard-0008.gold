	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var swapped = false;
	if g.cn >= 2 && ${p}(g.cv[0]) {
		let tmp = g.cv[0];
		g.cv[0] = g.cv[g.cn - 1];
		g.cv[g.cn - 1] = tmp;
		swapped = true;
	}
	out.ok = swapped;
	out.i = g.cn;
	out.s.clear();
	if swapped {
		out.s.append("swapped extreme cached letters");
	} else {
		out.s.append("retained cached letters without swap");
	}
	g.steps += g.cn + 1;
	out
}
@end
