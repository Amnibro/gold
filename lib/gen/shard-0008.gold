code:
fn ${ID}_has_digit(n int, d int) bool {
	var x = n;
	if x < 0 { x = -x; }
	if x == 0 && d == 0 { return true; }
	while x > 0 {
		if x % 10 == d { return true; }
		x /= 10;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var matched = 0;
	for i in g.n {
		if ${ID}_has_digit(g.res[i], target) {
			g.res[i] = 1;
			matched++;
		} else {
			g.res[i] = 0;
		}
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "matched digits ", matched);
	g.steps += g.n + 2;
	out
}
@end
