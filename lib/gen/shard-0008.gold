@entry 293992b2f246dea6
kind: step
verb: sum
noun: deviation
modifier: pairwise
context: math
phrase: sum pairwise absolute deviations of adjacent elements
phrase: accumulate pairwise deviation totals
test: list=10,14,11,20
expect: => i=16 r=0.0 ok=true s="accumulated 16 total pairwise deviation" errors=0 n=4 res=[10,14,11,20] cache=0 hits=0
test: list=5,2
expect: => i=3 r=0.0 ok=true s="accumulated 3 total pairwise deviation" errors=0 n=2 res=[5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff < 0 {
				total -= diff;
			} else {
				total += diff;
			}
			i += 1;
		}
	}
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "accumulated ", total, " total pairwise deviation");
	g.steps += g.n;
	out
}
@end
