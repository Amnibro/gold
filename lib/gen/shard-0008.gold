fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	for k in out.s.len - 1 {
		let diff = (out.s[k + 1] as int) - (out.s[k] as int);
		gold_push(g, diff * fac);
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
