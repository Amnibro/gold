fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n > 0 {
		let last_idx = g.n - 1;
		g.res[last_idx] *= f;
		out.i = g.res[last_idx];
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "scaled last by ", f);
	g.steps += 11;
	out
}
@end
