test: list=3,9
expect: => i=1 r=0.0 ok=true s="grouped 1 absolute pairwise deltas" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("grouped 0 absolute pairwise deltas");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		let diff = g.res[i + 1] - g.res[i];
		if diff < 0 {
			g.res[i] = -diff;
		} else {
			g.res[i] = diff;
		}
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped ", np, " absolute pairwise deltas");
	g.steps += np;
	out
}
@end
