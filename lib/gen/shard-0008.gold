noun: runs
modifier: at_least
context: search
phrase: count identical value runs reaching at least {min_len}
phrase: search runs of equal elements of at least {min_len}
phrase: find consecutive streaks having length at least {min_len}
slot: min_len int
test: list=1,1,1,2,3,3,3,3 min_len=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=8 res=[1,1,1,2,3,3,3,3] cache=0 hits=0
