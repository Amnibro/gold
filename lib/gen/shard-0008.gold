fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_lim = ${limit};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	let ok_status = min_val <= max_lim;
	g.steps += g.n + 2;
	out.ok = ok_status;
	out.i = min_val;
	out.s.clear();
	format(out.s, "checked minimum under ceiling ", min_val);
	out
}
