fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var count = 0;
	for i in g.n {
		if g.res[i] >= th {
			count++;
		}
	}
	out.i = count;
	out.ok = (count > 0);
	out.s.clear();
	format(out.s, "threshold met count ", count);
	g.steps += g.n + 10;
	out
}
@end
