fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${thresh};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var kept = 0;
	for i in g.n {
		let val, ok = gold_cache_get(g, i);
		if ok && val > thresh {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached items above threshold: ", kept);
	g.steps += g.n + 1;
	out
