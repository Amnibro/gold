code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, x * 2);
			cached++;
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached memo comparison for each item");
	out
}
@end
@entry 64247deb69ec9b65
