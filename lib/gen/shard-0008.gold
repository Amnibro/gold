expect: => i=90 r=0.0 ok=true s="repeated number target: 90" errors=0 n=2 res=[45,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	let target = ${min_target};
	var rounds = 0;
	while rounds < 10 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum >= target { break; }
		for i in g.n { g.res[i] *= m; }
		rounds++;
	}
	var final_sum = 0;
	for i in g.n { final_sum += g.res[i]; }
	out.i = final_sum;
	out.s.clear();
	format(out.s, "repeated number target: ", final_sum);
	g.steps += rounds + 1;
	out
}
@end
