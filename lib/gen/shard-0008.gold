fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient elements to merge head");
		out.ok = false;
		out.i = 0;
	} else {
		let combined = g.res[0] + g.res[1];
		g.res[0] = combined;
		var i = 1;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.n--;
		out.i = combined;
	}
	out.s.clear();
	if out.ok {
		format(out.s, "merged first step: ", out.i);
	} else {
		out.s.append("insufficient elements to merge first step");
	}
	g.steps += g.n + 1;
	out
}
