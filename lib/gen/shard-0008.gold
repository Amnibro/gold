code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	var is_sorted = true;
	if half > 1 {
		for i in (half - 1) {
			if g.res[i] > g.res[i + 1] {
				is_sorted = false;
				gold_fail(g, "head elements unsorted");
				break;
			}
		}
	}
	g.steps += half;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, if is_sorted { "head sorted" } else { "head unsorted" });
	out
}
@end
