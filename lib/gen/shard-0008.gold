test: list=2,2,2
expect: => i=1 r=0.0 ok=true s="cleared zero deltas leaving 1 items" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		format(out.s, "cleared zero deltas leaving ", g.n, " items");
		return out;
	}
	var kept = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept += 1;
		}
		i += 1;
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "cleared zero deltas leaving ", kept, " items");
	g.steps += g.n;
	out
}
@end
