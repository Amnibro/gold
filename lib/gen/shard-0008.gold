@entry 80e80b91e3af03d9
kind: step
verb: scale
noun: limit
modifier: safely
context: cache
phrase: scale cached values safely below limit {cap}
phrase: multiply cached entries safely under ceiling {cap}
slot: cap int
test: list=3,8 cap=15
expect: => i=1 r=0.0 ok=true s="safely scaled cached values: 1" errors=0 n=2 res=[3,8] cache=2 hits=0
test: list=10,20 cap=25
expect: => i=1 r=0.0 ok=true s="safely scaled cached values: 1" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var scaled = 0;
	for k in g.cn {
		if g.cv[k] * 2 <= cap {
			g.cv[k] *= 2;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "safely scaled cached values: ", scaled);
	g.steps += g.cn + 1;
	out
}
@end
