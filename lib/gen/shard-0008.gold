@entry 330da3755b0acf46
kind: step
verb: run
noun: primes
modifier: recursively
context: text
phrase: run recursive prime factor text formatting
phrase: format recursive prime factorization of number
test: input=12
expect: => i=3 r=0.0 ok=true s="factored into 3 prime factors" errors=0 n=3 res=[2,2,3] cache=0 hits=0
test: input=18
expect: => i=3 r=0.0 ok=true s="factored into 3 prime factors" errors=0 n=3 res=[2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var n = v.i;
	if n <= 1 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("no prime factors");
		return out;
	}
	var d = 2;
	while d * d <= n {
		while n % d == 0 {
			gold_push(g, d);
			n /= d;
		}
		d += 1;
	}
	if n > 1 {
		gold_push(g, n);
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "factored into ", g.n, " prime factors");
	g.steps += g.n + 1;
	out
}
@end
