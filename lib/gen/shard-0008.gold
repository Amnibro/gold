fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${min_val};
	var idx = 0;
	while idx < g.n && g.res[idx] < cutoff {
		idx++;
	}
	for i in 0..(g.n - idx) {
		g.res[i] = g.res[i + idx];
	}
	g.n -= idx;
	g.steps += idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "dropped ", idx, " items below threshold");
	out
}
@end
