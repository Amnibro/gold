fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let n = g.n;
	let start = if n >= k { n - k } else { 0 };
	let len = n - start;
	for i in len {
		for j in len - 1 {
			if g.res[start + j] > g.res[start + j + 1] {
				let tmp = g.res[start + j];
				g.res[start + j] = g.res[start + j + 1];
				g.res[start + j + 1] = tmp;
			}
		}
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted tail of ", len, " values");
	out
}
