fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tokens = 0;
	var in_word = false;
	var i = 0;
	while i < v.s.len {
		if v.s[i] != ' ' {
			if !in_word {
				tokens += 1;
				in_word = true;
			}
		} else {
			in_word = false;
		}
		i += 1;
	}
	g.cn = 0;
	out.i = tokens;
	out.ok = true;
	out.s.clear();
	format(out.s, "cleared cache across each of ", tokens, " tokens");
	g.steps += v.s.len;
	out
}
@end
