code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var err_count = 0;
	for i in g.n {
		let x = g.res[i];
		let abs_x = if x < 0 { -x } else { x };
		if x < 0 && abs_x >= limit {
			err_count++;
			g.errors++;
		}
	}
	out.i = err_count;
	out.s.clear();
	format(out.s, "severe errors count: ", err_count);
	g.steps += err_count + 1;
	out
}
@end
