fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_prime};
	var modified = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p && x > cap {
			g.res[k] = cap;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "limited ", modified, " primes");
	out
}
@end
