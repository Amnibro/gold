@entry 5fd73e195b35de71
kind: step
verb: retry
noun: words
modifier: in_reverse
context: transform
phrase: retry words in reverse order limit {retries}
phrase: inspect words backwards in reverse limit {retries}
slot: retries int
test: text="apple banana orange" retries=2
expect: => i=3 r=0.0 ok=true s="retried words in reverse count 3" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world" retries=1
expect: => i=2 r=0.0 ok=true s="retried words in reverse count 2" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var words_count = 0;
	for i in out.s.len {
		if out.s[i] == 32 { words_count++; }
	}
	if out.s.len > 0 { words_count++; }
	var left = 0;
	var right = out.s.len - 1;
	var r = 0;
	while left < right && r < r_max * 4 {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		left++;
		right--;
		r++;
	}
	g.steps += out.s.len;
	out.i = words_count;
	out.s.clear();
	format(out.s, "retried words in reverse count ", words_count);
	out
}
@end
