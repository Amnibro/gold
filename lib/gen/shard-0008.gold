fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in i {
			if out.s[j] == b {
				seen = true;
				break;
			}
		}
		if !seen && b >= 97 && b <= 122 {
			var sh = (b as int) + off;
			if sh > 122 { sh -= 26; }
			out.s[i] = sh as byte;
		}
	}
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
