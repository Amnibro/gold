fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${factor};
	var max_prod = -1000000;
	let pairs = g.n / 2;
	for i in pairs {
		let p = g.res[i * 2] * g.res[i * 2 + 1];
