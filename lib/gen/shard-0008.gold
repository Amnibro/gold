fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp: byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		let k = c as int;
		let _, hit = gold_cache_get(g, k);
		if !hit {
			gold_cache_put(g, k, 1);
			temp.push(c);
		}
	}
	out.s.clear();
	for b in temp { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
