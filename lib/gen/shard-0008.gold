expect: => i=7 r=0.0 ok=true s="a b cde" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two three" max_sp=1
expect: => i=12 r=0.0 ok=true s="one twothree" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_sp};
	var sp_count = 0;
	var kept = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if sp_count < limit {
				out.s[kept] = c;
				kept++;
				sp_count++;
			}
		} else {
			out.s[kept] = c;
			kept++;
		}
		i++;
	}
	out.s.resize(kept, 0);
	g.steps += out.s.len + 2;
	out.i = kept;
	out
}
@end
