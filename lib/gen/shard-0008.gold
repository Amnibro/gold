fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var blocks = 0;
	if sz > 0 {
		var i = 0;
		while i + sz <= g.n {
			var sm = 0;
			for j in sz {
				sm += g.res[i + j];
			}
			gold_cache_put(g, blocks, sm);
			g.res[blocks] = sm;
			blocks++;
			i += sz;
		}
	}
	g.n = blocks;
	out.i = blocks;
	out.s.clear();
	format(out.s, "cached tally nested ", blocks);
	g.steps += blocks + 1;
	out
}
@end
