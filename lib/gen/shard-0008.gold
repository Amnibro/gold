fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[new_n] = g.res[i] * g.res[i + 1];
		new_n++;
		i += 2;
	}
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "paired sequence count: ", new_n);
	g.steps += new_n;
	out
}
@end
