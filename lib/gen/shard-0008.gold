@entry 2c3909a068dcd4e9
kind: step
verb: normalize
noun: primes
modifier: pairwise
context: search
phrase: normalize adjacent prime pairs by replacing with average
phrase: average pairwise prime search candidates
phrase: balance consecutive prime pairs across search list
test: list=3,5,11,13
expect: => i=2 r=0.0 ok=true s="balanced 2 prime pairs" errors=0 n=4 res=[4,4,12,12] cache=0 hits=0
test: list=7,11,20
expect: => i=1 r=0.0 ok=true s="balanced 1 prime pairs" errors=0 n=3 res=[9,9,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var balanced = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var is_pa = a >= 2;
		var d = 2;
		while d * d <= a { if a % d == 0 { is_pa = false; break; } d++; }
		var is_pb = b >= 2;
		d = 2;
		while d * d <= b { if b % d == 0 { is_pb = false; break; } d++; }
		if is_pa && is_pb {
			let avg = (a + b) / 2;
			g.res[i] = avg;
			g.res[i + 1] = avg;
			balanced++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = balanced;
	out.s.clear();
	format(out.s, "balanced ", balanced, " prime pairs");
	out
}
@end
@entry 661067aca9e0e7f4
kind: step
verb: shift
noun: average
modifier: at_most
context: search
phrase: shift search values toward average by at most {step_size}
phrase: nudge search candidates toward mean by at most {step_size}
phrase: adjust search points toward center by at most {step_size}
slot: step_size int
test: list=10,20,60 step_size=5
expect: => i=30 r=0.0 ok=true s="shifted toward average 30" errors=0 n=3 res=[15,25,55] cache=0 hits=0
test: list=5,15,40 step_size=3
expect: => i=20 r=0.0 ok=true s="shifted toward average 20" errors=0 n=3 res=[8,18,37] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let step_val = ${step_size};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for k in g.n {
		if g.res[k] < avg {
			g.res[k] += step_val;
		} else if g.res[k] > avg {
			g.res[k] -= step_val;
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "shifted toward average ", avg);
	out
}
@end
