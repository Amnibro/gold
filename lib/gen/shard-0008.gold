kind: step
verb: trace
noun: budget
modifier: nested
context: filter
phrase: trace budget across nested chunks of {chunk_size} under {budget}
phrase: filter nested partitions tracking budget total {budget} by {chunk_size}
slot: budget int
slot: chunk_size int
test: list=2,3,4,5,6,7 budget=15 chunk_size=2
expect: => i=14 r=0.0 ok=true s="traced nested budget spent: 14" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=1,2,3,4,5,6 budget=10 chunk_size=3
expect: => i=6 r=0.0 ok=true s="traced nested budget spent: 6" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let cs = ${chunk_size};
	var spent = 0;
	var kept = 0;
	var i = 0;
	while i < g.n {
		var chunk_sum = 0;
		var j = 0;
		while j < cs && i + j < g.n {
			chunk_sum += g.res[i + j];
			j++;
		}
		if spent + chunk_sum <= b {
			spent += chunk_sum;
			for k in j {
				g.res[kept] = g.res[i + k];
				kept++;
			}
		}
		i += cs;
	}
	g.n = kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "traced nested budget spent: ", spent);
	g.steps += g.n + 1;
	out
}
@end
