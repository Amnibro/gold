fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	var longest = 0;
	var current = 0;
	for i in g.n {
		if i == 0 || g.res[i] >= g.res[i - 1] {
			current++;
		} else {
			current = 1;
		}
		if current > longest { longest = current; }
		if longest >= limit { break; }
	}
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "longest run was ", longest);
	out
}
