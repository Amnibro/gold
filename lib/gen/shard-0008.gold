code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var kept = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			if count % 2 == 0 {
				g.res[kept] = g.res[i];
				kept++;
			}
			count++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "split alternating primes count ", kept);
	g.steps += g.n + 2;
	out
}
@end
@entry fd176efbf1e19de1
kind: step
verb: collect
noun: minimum
modifier: unique
context: transform
phrase: collect minimum unique value from results
phrase: identify lowest unique non duplicate element
test: list=5,3,5,2,4,3
expect: => i=2 r=0.0 ok=true s="unique min 2" errors=0 n=1 res=[2] cache=0 hits=0
test: list=10,20,10,30,20
expect: => i=30 r=0.0 ok=true s="unique min 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var min_val = 1000000;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
		if freq == 1 {
			if !found || g.res[i] < min_val {
				min_val = g.res[i];
				found = true;
			}
		}
	}
	if found {
		g.n = 1;
		g.res[0] = min_val;
		out.i = min_val;
		out.ok = true;
		out.s.clear();
		format(out.s, "unique min ", min_val);
	} else {
		gold_fail(g, "no unique minimum");
		out.ok = false;
	}
	g.steps += g.n + 2;
	out
}
@end
