fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s0 = ${start};
	var s1 = ${stop};
	if s0 < 0 { s0 = 0; }
	if s1 >= g.n { s1 = g.n - 1; }
	var cached = 0;
	if s0 <= s1 {
		for k in s0..(s1 + 1) {
			gold_cache_put(g, k, g.res[k]);
			cached++;
		}
	}
	g.steps += cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " historical entries");
	out
}
@end
