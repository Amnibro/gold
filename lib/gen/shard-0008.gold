fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_w = ${limit};
	var words = 0;
	var in_w = false;
	for k in out.s.len {
		if out.s[k] != ' ' {
			if !in_w {
				words++;
				in_w = true;
				if words >= max_w { break; }
			}
		} else {
			in_w = false;
		}
	}
	g.steps += out.s.len;
	out.i = words;
	out
}
@end
