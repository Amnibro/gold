fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var i = start;
	var swaps = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n - start;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " tail pairs");
	out
}
@end
