expect: => i=5 r=0.0 ok=true s="hello" errors=0 n=0 res=[] cache=0 hits=0
test: text="plain"
expect: => i=5 r=0.0 ok=false s="plain" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = out.s.len;
	var i = 0;
	while i < out.s.len {
		if out.s[i] == '.' {
			pos = i;
			break;
		}
		i += 1;
	}
	while out.s.len > pos {
		out.s.pop();
	}
	out.i = out.s.len;
	out.ok = pos < v.s.len;
	g.steps += pos;
	out
}
@end
@entry 73c376365c8a610d
