code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			g.res[k] = if d < 0 { -d } else { d };
		}
		g.n--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed ", g.n, " pairwise gaps");
	out
}
@end
