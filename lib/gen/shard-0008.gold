fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found_idx = -1;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		out.ok = true;
		format(out.s, "found ", g.res[found_idx], " at index ", found_idx);
	} else {
		gold_fail(g, "no value between bounds");
		out.ok = false;
		format(out.s, "no value found between bounds");
	}
	out
}
