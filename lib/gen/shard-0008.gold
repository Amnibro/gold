fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if limit <= 1 || limit > g.n { return out; }
	for i in limit {
		for j in (i + 1)..limit {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += limit * limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted series up to count: ", limit);
	out
}
@end
@entry 3c9879d24cf8eb7c
kind: step
verb: dedupe
noun: words
modifier: between
context: compare
phrase: dedupe words between markers {start} to {finish}
phrase: prune duplicate words between boundaries {start} to {finish}
slot: start int
slot: finish int
test: list=5,5,5,10,10,20,30 start=0 finish=4
expect: => i=4 r=0.0 ok=true s="deduped words between range remaining: 4" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
test: list=1,2,2,3,3,3,4 start=1 finish=5
expect: => i=4 r=0.0 ok=true s="deduped words between range remaining: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	let fn_idx = ${finish};
	if st < 0 || fn_idx >= g.n || st >= fn_idx { return out; }
	var tmp int[512] = [0; 512];
	var w = 0;
	for i in st {
		tmp[w] = g.res[i];
		w++;
	}
	for i in st..(fn_idx + 1) {
		var dup = false;
		for j in st..i {
			if g.res[j] == g.res[i] { dup = true; break; }
		}
		if !dup {
			tmp[w] = g.res[i];
			w++;
		}
	}
	for i in (fn_idx + 1)..g.n {
		tmp[w] = g.res[i];
		w++;
	}
	for i in w {
		g.res[i] = tmp[i];
	}
	g.steps += g.n - w + 1;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped words between range remaining: ", w);
	out
}
@end
@entry 37c64576cabd9a54
kind: step
verb: validate
noun: gaps
modifier: in_reverse
context: compare
phrase: validate gaps in reverse max allowed gap {max_gap}
phrase: check descending gaps backwards limit {max_gap}
slot: max_gap int
test: list=10,14,18,22 max_gap=5
expect: => i=1 r=0.0 ok=true s="validated reverse gaps result: 1" errors=0 n=4 res=[10,14,18,22] cache=0 hits=0
test: list=5,15,20,30 max_gap=6
expect: => i=0 r=0.0 ok=false s="validated reverse gaps result: 0" errors=0 n=4 res=[5,15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n <= 1 || mg <= 0 { return out; }
	var valid = true;
	var i = g.n - 1;
	while i >= 1 {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > mg {
			valid = false;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validated reverse gaps result: ", out.i);
	out
}
@end
