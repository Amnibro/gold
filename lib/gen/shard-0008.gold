@entry f724a135fc10bfa2
kind: step
verb: select
noun: limit
modifier: at_most
context: filter
phrase: select at most {count} smallest elements
phrase: filter to retain lowest values bounded by {count}
slot: count int
test: list=45,12,88,23,7 count=3
expect: => i=3 r=0.0 ok=true s="selected 3 smallest" errors=0 n=3 res=[7,12,23] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="selected 1 smallest" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	// sort ascending
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	if g.n > k {
		g.n = k;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected ", g.n, " smallest");
	g.steps += g.n + 8;
	out
}
@end
