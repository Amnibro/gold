kind: step
verb: fold
noun: range
modifier: sorted
context: aggregate
phrase: fold range sorted summing elements between {low} to {high}
phrase: aggregate sorted items within interval bounds {low} through {high}
slot: low int
slot: high int
test: list=25,5,15,30,10 low=10 high=25
expect: => i=50 r=0.0 ok=true s="folded sorted range sum: 50" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: list=40,2,12,8 low=5 high=20
expect: => i=20 r=0.0 ok=true s="folded sorted range sum: 20" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	var kept = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded sorted range sum: ", sum);
	g.steps += g.n + 1;
	out
}
@end
