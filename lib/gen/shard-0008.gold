expect: => i=4 r=0.0 ok=true s="validated 4 non negative gaps in place" errors=0 n=5 res=[2,5,5,10,12] cache=0 hits=0
test: list=10,5,8
expect: => i=0 r=0.0 ok=false s="negative spacing at index 0" errors=1 n=3 res=[10,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "trivially validated spacing");
		return out;
	}
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		if gap < 0 {
			gold_fail(g, "negative gap detected");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "negative spacing at index ", i);
			return out;
		}
	}
	g.steps += g.n - 1;
	out.i = g.n - 1;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated ", g.n - 1, " non negative gaps in place");
	out
}
@end
