@entry 474ab22d21aad97f
kind: step
verb: find
noun: duplicates
modifier: times
context: transform
phrase: find duplicates occurring multiple times above {threshold}
phrase: count values repeated times exceeding {threshold}
slot: threshold int
test: list=2,3,2,4,2,3 threshold=1
expect: => i=2 r=0.0 ok=true s="frequent duplicates 2" errors=0 n=6 res=[2,3,2,4,2,3] cache=0 hits=0
test: list=5,5,5,5,6,7 threshold=2
expect: => i=1 r=0.0 ok=true s="frequent duplicates 1" errors=0 n=6 res=[5,5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var matching = 0;
	for i in g.n {
		var first_idx = -1;
		for j in g.n {
			if g.res[j] == g.res[i] {
				first_idx = j;
				break;
			}
		}
		if first_idx == i {
			var freq = 0;
			for j in g.n {
				if g.res[j] == g.res[i] {
					freq++;
				}
			}
			if freq > th {
				matching++;
			}
		}
	}
	out.i = matching;
	out.s.clear();
	format(out.s, "frequent duplicates ", matching);
	g.steps += g.n + 2;
	out
}
@end
