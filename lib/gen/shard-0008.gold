kind: step
verb: shift
noun: middle
modifier: at_most
context: error
phrase: shift middle elements at most {amount} positions
phrase: safely shift middle values at most {amount}
phrase: rotate middle entries at most {amount} places
slot: amount int
test: list=1,2,3,4,5 amount=1
expect: => i=1 r=0.0 ok=true s="shifted middle by 1" errors=0 n=5 res=[1,3,4,2,5] cache=0 hits=0
test: list=1,2 amount=1
expect: => i=0 r=0.0 ok=false s="error: not enough items" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let amt = ${amount};
	if g.n < 3 {
		gold_fail(g, "need at least three items for middle shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: not enough items");
		return out;
	}
	if amt <= 0 || amt >= g.n - 2 {
		gold_fail(g, "shift amount exceeds middle bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: amount out of bounds");
		return out;
	}
	let mid_len = g.n - 2;
	let first_mid = g.res[1];
	for k in 1..g.n - 2 {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 2] = first_mid;
	g.steps += mid_len;
	out.i = amt;
	out.s.clear();
	format(out.s, "shifted middle by ", amt);
	out
}
