test: list=10,50,20,30
expect: => i=50 r=0.0 ok=true s="swapped maximum to front 50" errors=0 n=4 res=[50,10,20,30] cache=0 hits=0
test: list=5,1,9,4
expect: => i=9 r=0.0 ok=true s="swapped maximum to front 9" errors=0 n=4 res=[9,1,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_idx = 0;
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	if max_idx != 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[max_idx];
		g.res[max_idx] = tmp;
	}
	g.steps += g.n + 2;
	out.i = max_val;
	out.s.clear();
	format(out.s, "swapped maximum to front ", max_val);
	out
}
@end
