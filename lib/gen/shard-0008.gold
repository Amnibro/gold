@entry a41e1c73a1a7dd56
kind: step
verb: retry
noun: values
modifier: in_reverse
context: sort
phrase: retry sorting values in reverse order with {passes}
phrase: descending sort values with retry passes {passes}
slot: passes int
test: list=1,3,2,4 passes=1
expect: => i=1 r=0.0 ok=true s="reverse sort passes: 1" errors=0 n=4 res=[3,2,4,1] cache=0 hits=0
test: list=1,3,2,4 passes=3
expect: => i=3 r=0.0 ok=true s="reverse sort passes: 3" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${passes};
	var p = 0;
	while p < passes {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] < g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		p++;
		if !swapped { break; }
	}
	out.i = p;
	out.s.clear();
	format(out.s, "reverse sort passes: ", p);
	g.steps += p * g.n + 1;
	out
}
@end
