code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 {
		out.i = 0;
		g.steps++;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for i in c {
		gold_push(g, avg);
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "merged average ", c, " times");
	g.steps += c;
	out
}
@end
