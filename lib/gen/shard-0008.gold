fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for k in g.n {
		if g.res[k] == tgt {
			found = k;
			break;
		}
	}
	if found != -1 {
		gold_cache_put(g, tgt, found);
		out.s.clear();
		format(out.s, "found target at index: ", found);
	} else {
		out.s.clear();
		format(out.s, "target not found");
	}
	g.steps += g.n;
	out.i = found;
	out
}
@end
@entry cb203b29c318920e
kind: step
verb: limit
noun: primes
modifier: each
context: cache
phrase: restrict prime cached elements to ceiling {max_prime}
phrase: clamp prime values exceeding threshold {max_prime}
slot: max_prime int
test: list=3,11,17 max_prime=10
expect: => i=2 r=0.0 ok=true s="limited 2 prime numbers" errors=0 n=3 res=[3,10,10] cache=1 hits=0
test: list=2,5 max_prime=10
expect: => i=0 r=0.0 ok=true s="limited 0 prime numbers" errors=0 n=2 res=[2,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_prime};
	var modified = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p && x > cap {
			g.res[k] = cap;
			modified++;
		}
	}
	gold_cache_put(g, cap, modified);
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "limited ", modified, " prime numbers");
	out
}
@end
