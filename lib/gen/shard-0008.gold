expect: => i=3 r=0.0 ok=true s="last digits: 3 4 5 " errors=0 n=3 res=[10,20,345] cache=0 hits=0
test: list=7,89
expect: => i=2 r=0.0 ok=true s="last digits: 8 9 " errors=0 n=2 res=[7,89] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("last digits: ");
	if g.n > 0 {
		var x = g.res[g.n - 1];
		if x < 0 { x = -x; }
		var digits = [0; 20];
		var len = 0;
		while x > 0 {
			digits[len] = x % 10;
			len++;
			x /= 10;
		}
		var idx = len - 1;
		while idx >= 0 {
			format(out.s, digits[idx], " ");
			idx--;
		}
	}
	out.i = g.n;
	g.steps += 1;
	out
}
@end
