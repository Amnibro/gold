code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = v.i;
	if k >= out.s.len {
		out.s.clear();
		out.i = 0;
		out.ok = true;
		return out;
	}
	var i = 0;
	while i + k < out.s.len {
		out.s[i] = out.s[i + k];
		i += 1;
	}
	var drop_cnt = k;
	while drop_cnt > 0 {
		out.s.pop();
		drop_cnt -= 1;
	}
	out.i = out.s.len;
	out.ok = true;
	g.steps += k;
	out
}
@end
