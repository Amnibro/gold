fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit_val};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 && kept < lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " odd elements");
	out
}
@end
