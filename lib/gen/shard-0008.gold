test: list=10,50,20,60 cutoff=30
expect: => i=2 r=0.0 ok=true s="filtered cache comparison count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,12,25,40 cutoff=20
expect: => i=2 r=0.0 ok=true s="filtered cache comparison count: 2" errors=0 n=2 res=[5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var i = 0;
	var removed = 0;
	while i < g.n {
		if g.res[i] > limit {
			for j in (g.n - 1 - i) {
				g.res[i + j] = g.res[i + 1 + j];
			}
			g.n--;
			removed++;
		} else {
			i++;
		}
	}
	g.steps += g.n + removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered cache comparison count: ", removed);
	out
}
@end
