@entry f325d2b933483908
kind: step
verb: sort
noun: prefix
modifier: unique
context: core
phrase: sort prefix unique elements for first {count} items
phrase: dedupe order initial prefix segment of size {count}
slot: count int
test: list=5,2,5,1,8,9 count=4
expect: => i=3 r=0.0 ok=true s="sorted prefix unique count: 3" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=4,4,3,2 count=3
expect: => i=2 r=0.0 ok=true s="sorted prefix unique count: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let limit = if g.n < c { g.n } else { c };
	var kept = 0;
	var i = 0;
	while i < limit {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	var a = 0;
	while a < kept {
		var b = a + 1;
		while b < kept {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted prefix unique count: ", kept);
	g.steps += g.n + 1;
	out
}
@end
