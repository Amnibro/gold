kind: step
verb: scale
noun: suffix
modifier: running
context: loop
phrase: scale suffix elements by running multiplier {factor}
phrase: multiply trailing items using running factor {factor}
slot: factor int
test: list=1,2,3,4 factor=5
expect: => i=2 r=0.0 ok=true s="scaled 2 suffix items" errors=0 n=4 res=[1,2,15,20] cache=0 hits=0
test: list=10,20,30,40,50 factor=2
expect: => i=3 r=0.0 ok=true s="scaled 3 suffix items" errors=0 n=5 res=[10,20,60,80,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${factor};
	let half = g.n / 2;
	for i in half..g.n {
		g.res[i] *= m;
	}
	g.steps += g.n - half;
	out.i = g.n - half;
	out.s.clear();
	format(out.s, "scaled ", out.i, " suffix items");
	out
}
@end
