code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n / 2;
	out.s.clear();
	format(out.s, "swapped ", out.i, " pairs");
	out
}
@end
