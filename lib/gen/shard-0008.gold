code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var min_idx = 0;
	for k in g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	let min_val = g.res[min_idx];
	var temp int[512] = [0; 512];
	for k in g.n {
		temp[k] = g.res[(min_idx + k) % g.n];
	}
	for k in g.n { g.res[k] = temp[k]; }
	out.i = min_val;
	out.s.clear();
	format(out.s, "placed minimum ", min_val, " at head");
	g.steps += g.n;
	out
}
@end
