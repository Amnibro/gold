fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var squares int[512] = [0; 512];
	var count = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if ${ID}_is_sq(g.res[i]) {
			squares[count] = g.res[i];
			count++;
		}
	}
	gold_clear(g);
	for j in count { gold_push(g, squares[j]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " squares backward");
	out
}
@end
