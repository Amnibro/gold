@entry 04dcffc9e05b6393
kind: step
verb: select
noun: errors
modifier: in_place
context: cache
phrase: select cached items marking errors in place
phrase: validate cache contents in place recording errors
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="cache validated without errors" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,-2,15
expect: => i=3 r=0.0 ok=false s="cache contains invalid negative values" errors=1 n=3 res=[5,-2,15] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var has_err = false;
	for k in g.cn {
		if g.cv[k] < 0 {
			gold_fail(g, "negative cached value detected");
			has_err = true;
			break;
		}
	}
	out.ok = !has_err;
	out.i = g.cn;
	out.s.clear();
	if has_err {
		out.s.append("cache contains invalid negative values");
	} else {
		out.s.append("cache validated without errors");
	}
	g.steps += g.cn + 1;
	out
}
@end
@entry 05dcf56a05c79e36
kind: step
verb: reverse
noun: errors
modifier: up_to
context: cache
phrase: reverse cache contents up to error limit {max_err}
phrase: invert cached entries if errors stay below {max_err}
slot: max_err int
test: list=1,2,3 max_err=0
expect: => i=3 r=0.0 ok=true s="reversed cache under error bound: 3" errors=0 n=3 res=[1,2,3] cache=3 hits=0
test: list=10,20 max_err=5
expect: => i=2 r=0.0 ok=true s="reversed cache under error bound: 2" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_err = ${max_err};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	if g.errors <= max_err {
		var left = 0;
		var right = g.cn - 1;
		while left < right {
			let tmp = g.cv[left];
			g.cv[left] = g.cv[right];
			g.cv[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed cache under error bound: ", g.cn);
	g.steps += g.cn + 1;
	out
}
@end
