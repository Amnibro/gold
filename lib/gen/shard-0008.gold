phrase: truncate any prime search scores above ceiling {cap}
slot: cap int
test: list=7,12,11,15 cap=10
expect: => i=1 r=0.0 ok=true s="clamped 1 prime hits" errors=0 n=4 res=[7,12,10,15] cache=0 hits=0
test: list=2,4,13 cap=5
expect: => i=1 r=0.0 ok=true s="clamped 1 prime hits" errors=0 n=3 res=[2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var modified = 0;
	for k in g.n {
		let n = g.res[k];
		var is_p = n >= 2;
		var d = 2;
		while d * d <= n {
			if n % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && g.res[k] > ceiling {
			g.res[k] = ceiling;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " prime hits");
	out
}
@end
