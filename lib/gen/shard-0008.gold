code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 {
		gold_fail(g, "odd range length for pairwise swap");
		out.ok = false;
	} else {
		var i = 0;
		while i + 1 < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			i += 2;
		}
	}
	out.i = g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "swapped pairwise range: ", g.n);
	} else {
		out.s.append("pairwise swap aborted on odd length");
	}
	g.steps += g.n + 1;
	out
}
@end
