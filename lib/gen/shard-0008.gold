test: list=5,15,25,35
expect: => i=0 r=0.0 ok=true s="dropped 0 cached values" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let _, hit = gold_cache_get(g, g.res[k]);
		if !hit {
			gold_cache_put(g, g.res[k], 1);
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " cached values");
	out
}
@end
