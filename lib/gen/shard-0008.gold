slot: offset int
test: list=1,2,3,4,5 offset=2
expect: => i=15 r=0.0 ok=true s="rotated all elements total: 15" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 offset=1
expect: => i=60 r=0.0 ok=true s="rotated all elements total: 60" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if g.n > 1 {
		let shift = off % g.n;
		var temp: int[512] = [0; 512];
		for i in g.n {
			let new_idx = (i + shift) % g.n;
			temp[new_idx] = g.res[i];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated all elements total: ", sum);
	g.steps += g.n + 1;
	out
}
@end
