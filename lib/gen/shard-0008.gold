code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var len = 0;
		if x == 0 { len = 1; }
		while x > 0 { len++; x /= 10; }
		g.res[k] = len;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed digit lengths for ", g.n, " items");
	out
}
@end
