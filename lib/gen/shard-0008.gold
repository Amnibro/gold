expect: => i=1 r=0.0 ok=true s="longest streak: 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		g.steps++;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
		i++;
	}
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak: ", max_streak);
	g.steps += g.n;
	out
}
@end
