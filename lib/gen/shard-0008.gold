			count++;
		} else {
			if retries_left > 0 {
				retries_left--;
			} else {
				break;
			}
		}
	}
	for i in count {
		g.res[i] = temp[i];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected sequence: ", count);
	g.steps += count + 1;
	out
}
@end
