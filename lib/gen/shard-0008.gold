test: list=10,20,5,15
expect: => i=2 r=0.0 ok=true s="filled pairwise minimum: 2" errors=0 n=4 res=[10,10,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var pairs = 0;
	while i + 1 < g.n {
		let m = if g.res[i] < g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
		g.res[i] = m;
		g.res[i + 1] = m;
		pairs++;
		i += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "filled pairwise minimum: ", pairs);
	g.steps += g.n;
	out
}
@end
@entry 085975ebb0570d44
kind: step
verb: run
noun: minimum
modifier: in_reverse
context: list
phrase: run prefix minimum scan in reverse order
phrase: calculate running suffix minimum across list
test: list=4,7,2,5,9
expect: => i=2 r=0.0 ok=true s="running reverse minimum: 2" errors=0 n=5 res=[2,2,2,5,9] cache=0 hits=0
test: list=10,8,6,4
expect: => i=4 r=0.0 ok=true s="running reverse minimum: 4" errors=0 n=4 res=[4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var cur_min = g.res[g.n - 1];
		var i = g.n - 1;
		while i >= 0 {
			if g.res[i] < cur_min {
				cur_min = g.res[i];
			}
			g.res[i] = cur_min;
			i--;
		}
		out.i = cur_min;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "running reverse minimum: ", out.i);
	g.steps += g.n;
	out
}
@end
