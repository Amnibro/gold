@entry a96ef6f955ce824f
kind: step
verb: limit
noun: middle
modifier: with_cache
context: text
phrase: limit middle text segment using cached bounds
phrase: extract middle string slice with cached limit
test: input=2 text="abcdefgh"
expect: => i=2 r=0.0 ok=true s="extracted middle 2 bytes with cached limit 2" errors=0 n=2 res=[100,101] cache=1 hits=0
test: input=1 text="hello"
expect: => i=1 r=0.0 ok=true s="extracted middle 1 bytes with cached limit 1" errors=0 n=1 res=[108] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = v.i;
	gold_cache_put(g, 0, span);
	let mid = out.s.len / 2;
	var start = mid - span / 2;
	if start < 0 {
		start = 0;
	}
	var count = 0;
	gold_clear(g);
	var i = start;
	while i < out.s.len && count < span {
		gold_push(g, out.s[i] as int);
		count += 1;
		i += 1;
	}
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "extracted middle ", count, " bytes with cached limit ", span);
	g.steps += count + 1;
	out
}
@end
@entry 95026cc639ad1e32
kind: step
verb: keep
noun: values
modifier: at_most
context: filter
phrase: keep values at most threshold {cap}
phrase: filter values exceeding upper bound {cap}
slot: cap int
test: list=10,25,5,40,15 cap=20
expect: => i=3 r=0.0 ok=true s="filtered at most 20" errors=0 n=3 res=[10,5,15] cache=0 hits=0
test: list=50,60 cap=30
expect: => i=0 r=0.0 ok=true s="filtered at most 30" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	for i in g.n {
		if g.res[i] <= limit {
			g.res[write] = g.res[i];
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "filtered at most ", limit);
	g.steps += g.n + 1;
	out
}
@end
