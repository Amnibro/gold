@entry 3f3b99da56a4e616
kind: step
verb: limit
noun: history
modifier: pairwise
context: list
phrase: limit pairwise history differences to {max_delta}
phrase: cap adjacent step history deltas by {max_delta}
slot: max_delta int
test: list=1,10,2,30 max_delta=4
expect: => i=2 r=0.0 ok=true s="limited pairwise deltas: 2" errors=0 n=4 res=[1,5,2,6] cache=0 hits=0
test: list=5,20,5 max_delta=2
expect: => i=1 r=0.0 ok=true s="limited pairwise deltas: 1" errors=0 n=3 res=[5,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_delta};
	var count = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > md {
			g.res[i] = g.res[i - 1] + md;
			count++;
		} else if diff < -md {
			g.res[i] = g.res[i - 1] - md;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "limited pairwise deltas: ", count);
	g.steps += g.n;
	out
}
@end
