fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x > 1000000 - total {
			gold_fail(g, "tally overflow");
			out.ok = false;
			return out;
		}
		total += x;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "safe tally sum ", total);
	g.steps += g.n + 1;
	out
}
@end
