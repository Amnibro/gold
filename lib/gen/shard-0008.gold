fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_digits};
	var kept = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var len = 0;
		if x == 0 { len = 1; }
		while x > 0 { len++; x /= 10; }
		if len >= md {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items with at least min digits");
	out
}
@end
@entry c2d379d4559c6a25
kind: step
verb: fill
noun: checkpoint
modifier: sorted
context: search
phrase: sort search results into checkpoint order
phrase: arrange search items in ascending sorted order
test: list=40,10,30,20
expect: => i=4 r=0.0 ok=true s="checkpoint sorted 4 items" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,1
expect: => i=2 r=0.0 ok=true s="checkpoint sorted 2 items" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// Selection sort
	for i in g.n {
		var min_idx = i;
		for j in i + 1..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "checkpoint sorted ", g.n, " items");
	out
}
@end
