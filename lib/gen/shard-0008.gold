code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			acc += (g.res[i + 1] - g.res[i]);
			i += 1;
		}
	}
	out.i = acc;
	out.ok = true;
	out.s.clear();
	format(out.s, "folded delta sum ", acc);
	g.steps += g.n;
	out
}
@end
