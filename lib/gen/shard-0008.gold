code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var pairs = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] + g.res[j] == tgt {
				gold_cache_put(g, pairs * 2, g.res[i]);
				gold_cache_put(g, pairs * 2 + 1, g.res[j]);
				pairs++;
			}
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "matching pairs count: ", pairs);
	g.steps += pairs + 1;
	out
}
