code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_letters = true;
	var temp: byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		let is_letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
		if is_letter {
			temp.push(c);
		} else {
			all_letters = false;
		}
	}
	out.s.clear();
	for b in temp { out.s.push(b); }
	out.ok = all_letters;
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
