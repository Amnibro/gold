@entry 2959937c0d96f355
kind: step
verb: rank
noun: maximum
modifier: with_retry
context: filter
phrase: rank maximum elements with retry limit {retries}
phrase: filter top ranked maximum values using retries {retries}
slot: retries int
test: list=5,12,18,9,20 retries=2
expect: => i=3 r=0.0 ok=true s="ranked maximum retries used: 1" errors=0 n=3 res=[12,18,20] cache=0 hits=0
test: list=30,10,25 retries=1
expect: => i=2 r=0.0 ok=true s="ranked maximum retries used: 1" errors=0 n=2 res=[30,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var r = 0;
	var threshold = 0;
	for i in g.n {
		if g.res[i] > threshold { threshold = g.res[i]; }
	}
	while r < max_r {
		var count = 0;
		for i in g.n {
			if g.res[i] >= threshold { count++; }
		}
		if count >= 2 || threshold <= 0 { break; }
		threshold /= 2;
		r++;
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] >= threshold {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked maximum retries used: ", r);
	g.steps += r + 1;
	out
}
@end
