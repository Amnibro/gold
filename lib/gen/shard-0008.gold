@entry e84800722351f2fb
kind: step
verb: cache
noun: gaps
modifier: until
context: filter
phrase: cache consecutive element gaps until gap exceeds threshold {max_gap}
phrase: memoize difference intervals until reaching limit {max_gap}
slot: max_gap int
test: list=10,12,15,25,30 max_gap=5
expect: => i=3 r=0.0 ok=true s="cached gaps until 3" errors=0 n=3 res=[2,3,10] cache=3 hits=0
test: list=10,20,30 max_gap=5
expect: => i=1 r=0.0 ok=true s="cached gaps until 1" errors=0 n=1 res=[10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 {
			diff = -diff;
		}
		gold_cache_put(g, count, diff);
		g.res[count] = diff;
		count++;
		if diff > limit {
			break;
		}
		i++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached gaps until ", count);
	g.steps += count + 1;
	out
}
@end
