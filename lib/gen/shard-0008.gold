	while i < g.n {
		var m = g.res[i];
		var j = 1;
		while j < cs && i + j < g.n {
			if g.res[i + j] > m { m = g.res[i + j]; }
			j++;
		}
		total += m;
		i += cs;
	}
	out.i = total;
	out.s.clear();
