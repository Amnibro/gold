code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least three elements for nested steps");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	let n1 = g.n - 1;
	for i in n1 - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = n1 - 1;
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested steps computed: ", g.n, " items");
	out
}
@end
