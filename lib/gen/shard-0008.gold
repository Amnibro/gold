code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	if g.n > 1 {
		for k in 1..g.n {
			let gap = g.res[k] - g.res[k - 1];
			g.res[k] = g.res[k - 1] + gap * f;
			scaled++;
		}
	}
	gold_cache_put(g, f, scaled);
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " gaps with cache");
	out
}
@end
