modifier: pairwise
context: format
phrase: trace streak pairwise summing differences between adjacent digits
phrase: sum total pairwise differences across consecutive digits
test: arg=136,972
expect: 5
expect: 7
test: arg=55
expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var sum = 0;
	var last_d = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		let diff = if d > last_d { d - last_d } else { last_d - d };
		sum += diff;
		last_d = d;
		x /= 10;
	}
	sum
}
@end
@entry f4ac49df9eda7ad8
kind: fn
verb: repeat
noun: histogram
modifier: unique
context: format
phrase: count unique digit frequencies in format histogram
phrase: number of distinct decimal digits present
test: arg=112233,456
expect: 3
expect: 3
test: arg=9999
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var seen = 0;
	var count = 0;
	if x == 0 { return 1; }
	while x > 0 {
		let d = x % 10;
		var m = 1;
		for i in d { m *= 2; }
		if (seen / m) % 2 == 0 {
			seen += m;
			count++;
		}
		x /= 10;
	}
	count
}
@end
