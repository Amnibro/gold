expect: => i=4 r=0.0 ok=true s="scanned to index 3 peak: 4" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_val = ${stop_val};
	var running_max = -1000000;
	var stop_idx = g.n;
	for k in g.n {
		if g.res[k] > running_max { running_max = g.res[k]; }
		if running_max >= limit_val {
			stop_idx = k + 1;
			break;
		}
	}
	g.n = stop_idx;
	g.steps += g.n;
	out.i = running_max;
	out.s.clear();
	format(out.s, "scanned to index ", stop_idx, " peak: ", running_max);
	out
}
@end
@entry 4d617f0bdde812a7
kind: step
