fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("diffs: ");
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if count > 0 { out.s.append(", "); }
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		format(out.s, diff);
		count++;
		i += 2;
	}
	out.i = count;
	g.steps += count + 1;
	out
}
@end
