expect: => i=1 r=0.0 ok=true s="traced increasing streak: 1" errors=0 n=3 res=[10,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_streak};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "traced increasing streak: 0");
		return out;
	}
	var best = 1;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
	}
	let result = if best > cap { cap } else { best };
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "traced increasing streak: ", result);
	out
}
@end
