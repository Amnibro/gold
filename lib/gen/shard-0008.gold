code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty sequence for safe average");
		out.i = 0;
	} else {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		out.ok = true;
		out.i = sum / g.n;
	}
	out.s.clear();
	format(out.s, "searched average safely: ", out.i);
	g.steps += g.n + 1;
	out
}
@end
