		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	for k in g.n { g.res[k] -= avg; }
	out.i = avg;
	out.s.clear();
	format(out.s, "mapped sorted items by average: ", avg);
	g.steps += g.n + 1;
	out
}
