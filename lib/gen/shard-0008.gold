fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		let _, hit = gold_cache_get(g, val);
		if hit {
			g.res[kept] = val;
			kept++;
		} else {
			gold_cache_put(g, val, 1);
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "repeated cache hits retained: ", kept);
	g.steps += g.n + 1;
	out
}
@end
