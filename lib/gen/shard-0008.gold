noun: items
modifier: each
context: aggregate
phrase: reverse each individual item digits
phrase: invert digit order of each result item
test: list=12,345,67
expect: => i=21 r=0.0 ok=true s="reversed digits each item count 3" errors=0 n=3 res=[21,543,76] cache=0 hits=0
test: list=19,82,730
expect: => i=91 r=0.0 ok=true s="reversed digits each item count 3" errors=0 n=3 res=[91,28,37] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		let neg = x < 0;
		if neg { x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		g.res[i] = if neg { -rev } else { rev };
	}
	g.steps += g.n * 3 + 2;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "reversed digits each item count ", g.n);
	out
}
@end
