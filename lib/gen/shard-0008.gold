noun: spaces
modifier: in_reverse
context: error
phrase: scan trailing zeros in reverse flagging missing space error
phrase: inspect trailing blank spaces in reverse checking absence error
test: list=1,2,0,0
expect: => i=2 r=0.0 ok=true s="scanned trailing zeros: 2" errors=0 n=4 res=[1,2,0,0] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=false s="no trailing zero spaces found" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] == 0 {
			count++;
		} else {
			break;
		}
		idx--;
	}
	if count == 0 {
		gold_fail(g, "zero spaces missing in reverse scan");
		out.ok = false;
	}
	out.i = count;
	out.s.clear();
	if out.ok {
		format(out.s, "scanned trailing zeros: ", count);
	} else {
		out.s.append("no trailing zero spaces found");
	}
	g.steps += g.n + 1;
	out
}
@end
@entry ddd4d6b134879ec9
kind: step
verb: count
noun: duplicates
modifier: any
context: error
phrase: count any duplicate values flagging duplicate error
phrase: tally identical elements raising error on duplicates
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="no duplicates detected" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2,2,3
expect: => i=1 r=0.0 ok=false s="duplicate pairs detected: 1" errors=1 n=4 res=[1,2,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				dups++;
			}
			j++;
		}
		i++;
	}
	if dups > 0 {
		gold_fail(g, "duplicate values found in collection");
		out.ok = false;
	}
	out.i = dups;
	out.s.clear();
	if out.ok {
		out.s.append("no duplicates detected");
	} else {
		format(out.s, "duplicate pairs detected: ", dups);
	}
	g.steps += g.n + 1;
	out
}
@end
