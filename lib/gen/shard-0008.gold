@entry 9fdbba4bdb0e129c
kind: step
verb: dedupe
noun: series
modifier: first
context: math
phrase: dedupe first {k} series entries
phrase: remove duplicate items within initial {k} series numbers
slot: k int
test: list=4,4,5,4,9,9 k=4
expect: => i=4 r=0.0 ok=true s="deduped first 4 items to length 4" errors=0 n=4 res=[4,5,9,9] cache=0 hits=0
test: list=2,2,2,2 k=3
expect: => i=2 r=0.0 ok=true s="deduped first 3 items to length 2" errors=0 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let count = if limit > g.n { g.n } else if limit < 0 { 0 } else { limit };
	var kept = 0;
	var tmp int[512] = [0; 512];
	for i in count {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if tmp[j] == x { seen = true; }
		}
		if !seen {
			tmp[kept] = x;
			kept++;
		}
	}
	let tail_start = count;
	let tail_len = g.n - count;
	for i in tail_len {
		tmp[kept + i] = g.res[tail_start + i];
	}
	let new_n = kept + tail_len;
	gold_clear(g);
	for i in new_n {
		gold_push(g, tmp[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped first ", count, " items to length ", g.n);
	out
}
@end
