fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${maxlen};
	if g.n > limit {
		g.n = limit;
		out.s.clear();
		format(out.s, "truncated sequence to ", limit);
	} else if g.n > 0 && g.n < limit {
		let last = g.res[g.n - 1];
		gold_push(g, last);
		out.s.clear();
		format(out.s, "retried padding sequence");
	} else {
		out.s.clear();
		format(out.s, "sequence length maintained");
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
