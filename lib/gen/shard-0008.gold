expect: => i=2 r=0.0 ok=true s="merged 2 windows" errors=0 n=2 res=[15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	let off = ${offset};
	if w <= 0 || g.n < w {
		gold_fail(g, "window size exceeds list length");
		out.ok = false;
		return out;
	}
	var sums int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i + w <= g.n {
		var s = 0;
		for j in w { s += g.res[i + j]; }
		if s < 0 { s += off; }
		sums[count] = s;
		count++;
		i += w;
	}
	gold_clear(g);
	for k in count { gold_push(g, sums[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged ", count, " windows");
	out
}
@end
