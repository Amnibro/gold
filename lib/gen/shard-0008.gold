code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n >= 2 {
		for c in t {
			let first0 = g.res[0];
			let first1 = g.res[1];
			for i in 2..g.n {
				g.res[i - 2] = g.res[i];
			}
			g.res[g.n - 2] = first0;
			g.res[g.n - 1] = first1;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted pairs ", t, " times");
	g.steps += t + 1;
	out
}
@end
