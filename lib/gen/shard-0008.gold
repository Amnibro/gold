@entry b42a1e95e13c7b94
kind: step
verb: shift
noun: words
modifier: last
context: search
phrase: shift search query words keeping last {count}
phrase: extract trailing {count} words from search query
phrase: retain last {count} words in search buffer
slot: count int
test: text="search query terms final" count=2
expect: => i=2 r=0.0 ok=true s="terms final" errors=0 n=0 res=[] cache=0 hits=0
test: text="find best route here" count=1
expect: => i=1 r=0.0 ok=true s="here" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var spaces = 0;
	for i in out.s.len {
		if out.s[i] == ' ' { spaces++; }
	}
	let skip_spaces = if spaces >= k { spaces - k + 1 } else { 0 };
	var seen = 0;
	var start_idx = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			seen++;
			if seen == skip_spaces {
				start_idx = i + 1;
				break;
			}
		}
	}
	var new_s byte[..200] = "";
	for i in start_idx..out.s.len {
		new_s.push(out.s[i]);
	}
	out.s.clear();
	for i in new_s.len { out.s.push(new_s[i]); }
	g.steps += out.s.len;
	out.i = k;
	out
}
@end
@entry cb10d4da9dd34d12
kind: step
verb: fill
noun: runs
modifier: safely
context: search
phrase: fill repeated search runs safely
phrase: extend identical search candidate runs safely
phrase: pad duplicate search match runs safely
test: list=3,3,7,7,7
expect: => i=2 r=0.0 ok=true s="extended 2 runs safely" errors=0 n=7 res=[3,3,3,7,7,7,7] cache=0 hits=0
test: list=2,5,5
expect: => i=1 r=0.0 ok=true s="extended 1 runs safely" errors=0 n=4 res=[2,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp: int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		for k in 0..run_len { if tn < 512 { temp[tn] = g.res[i]; tn++; } }
		if run_len > 1 && tn < 512 {
			temp[tn] = g.res[i];
			tn++;
		}
		i = j;
	}
	for k in tn { g.res[k] = temp[k]; }
	let added = tn - g.n;
	g.n = tn;
	g.steps += tn;
	out.i = added;
	out.s.clear();
	format(out.s, "extended ", added, " runs safely");
	out
}
@end
