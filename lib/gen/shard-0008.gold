code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	for k in out.s.len {
		let cost = out.s[k] as int;
		if spent + cost > b { break; }
		gold_push(g, cost);
		spent += cost;
	}
	g.steps += g.n;
	out.i = spent;
	out
}
@end
