fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let sv = ${stop_val};
	var clamped = 0;
	for i in g.n {
		if g.res[i] == sv { break; }
		if g.res[i] < fl {
			g.res[i] = fl;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped minimum until count: ", clamped);
	g.steps += g.n + 1;
	out
}
