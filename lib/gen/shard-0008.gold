	var changed = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = rep;
			changed++;
		}
	}
	out.i = changed;
	out.s.clear();
	format(out.s, "filled odds ", changed);
	g.steps += g.n + 1;
	out
}
@end
@entry 89bab8a237ec49a4
kind: step
verb: compare
noun: digits
modifier: any
context: transform
phrase: compare digits checking if any match {val}
phrase: inspect digit sequence finding any presence of {val}
slot: val int
test: list=12,34,52,78 val=2
expect: => i=2 r=0.0 ok=true s="matched digits 2" errors=0 n=4 res=[1,0,1,0] cache=0 hits=0
test: list=105,20,33 val=5
