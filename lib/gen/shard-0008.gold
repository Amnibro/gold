fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${limit};
	var max_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let passes = max_val <= ceiling;
	g.steps += g.n + 1;
	out.ok = passes;
	out.i = max_val;
	out.s.clear();
	format(out.s, "checked threshold max ", max_val);
	out
}
