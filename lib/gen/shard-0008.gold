fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_pos = 1000000;
	for i in g.n {
		if g.res[i] > 0 && g.res[i] < min_pos {
			min_pos = g.res[i];
		}
	}
	var replaced = 0;
	for i in g.n {
		if g.res[i] < 0 {
			g.res[i] = min_pos;
			replaced++;
		}
	}
	out.i = replaced;
	out.s.clear();
	format(out.s, "replaced negatives count: ", replaced);
	g.steps += replaced + 1;
