kind: step
verb: reverse
noun: checkpoint
modifier: between
context: core
phrase: reverse results between bounds {start} to {end}
phrase: invert range of items between indices {start} through {end}
slot: start int
slot: end int
test: list=1,2,3,4,5,6 start=1 end=4
expect: => i=6 r=0.0 ok=true s="reversed checkpoint between indices" errors=0 n=6 res=[1,5,4,3,2,6] cache=0 hits=0
test: list=10,20,30,40,50 start=0 end=2
expect: => i=5 r=0.0 ok=true s="reversed checkpoint between indices" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${end};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	while s < e {
		let tmp = g.res[s];
		g.res[s] = g.res[e];
		g.res[e] = tmp;
		s++;
		e--;
	}
	g.steps += g.n + 3;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed checkpoint between indices");
	out
}
@end
