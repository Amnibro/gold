@entry bec40b973ab84a2d
kind: step
verb: normalize
noun: window
modifier: with_retry
context: error
phrase: normalize window values with retry allowance {retries}
phrase: scale window elements with retry limit {retries}
phrase: adjust window span allowing {retries} retries safely
slot: retries int
test: list=10,20,30,40 retries=2
expect: => i=30 r=0.0 ok=true s="normalized window with span 30" errors=0 n=4 res=[0,10,20,30] cache=0 hits=0
test: list=5,5,5 retries=0
expect: => i=0 r=0.0 ok=false s="error: zero variance" errors=1 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n == 0 {
		gold_fail(g, "empty window cannot be normalized");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty window");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	if min_val == max_val {
		gold_fail(g, "zero variance in window elements");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero variance");
		return out;
	}
	let span = max_val - min_val;
	for k in g.n {
		g.res[k] -= min_val;
	}
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "normalized window with span ", span);
	out
}
@end
@entry 3660da959fffabe6
kind: step
verb: sum
noun: primes
modifier: in_place
context: error
phrase: sum primes in place checking for composite errors
phrase: accumulate prime values in place safely
phrase: total prime numbers in results with validation
test: list=2,3,5,8,11
expect: => i=21 r=0.0 ok=true s="sum of 4 primes is 21" errors=0 n=5 res=[2,3,5,8,11] cache=0 hits=0
test: list=4,6,8,10
expect: => i=0 r=0.0 ok=false s="error: no primes" errors=1 n=4 res=[4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			total += x;
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no primes found in results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no primes");
		return out;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum of ", count, " primes is ", total);
	out
}
@end
