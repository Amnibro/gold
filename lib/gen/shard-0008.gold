context: sort
phrase: drop duplicate elements having count between {min_c} to {max_c}
phrase: filter sorted items whose multiplicity falls between {min_c} to {max_c}
slot: min_c int
slot: max_c int
test: list=1,2,2,3,3,3,4 min_c=2 max_c=2
expect: => i=5 r=0.0 ok=true s="retained 5 items" errors=0 n=5 res=[1,3,3,3,4] cache=0 hits=0
test: list=7,7,7 min_c=1 max_c=3
expect: => i=0 r=0.0 ok=true s="retained 0 items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_c};
	let hi = ${max_c};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if !(count >= lo && count <= hi) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items");
	out
}
@end
@entry 0950b57e00292369
kind: step
verb: split
noun: squares
modifier: first
context: sort
phrase: keep first {count_val} perfect squares in sorted results
phrase: split sorted elements isolating first {count_val} squares
slot: count_val int
test: list=1,4,5,9,16 count_val=2
expect: => i=2 r=0.0 ok=true s="found 2 initial squares" errors=0 n=2 res=[1,4] cache=0 hits=0
test: list=2,3,5 count_val=3
expect: => i=0 r=0.0 ok=true s="found 0 initial squares" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count_val};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq && kept < c {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " initial squares");
	out
}
@end
