code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var valid = true;
	var kept = if g.n > 0 { 1 } else { 0 };
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= md {
			g.res[kept] = g.res[i];
			kept++;
		} else {
			valid = false;
		}
		i++;
	}
	g.n = kept;
	out.ok = valid;
	out.i = kept;
	out.s.clear();
	format(out.s, "validated running steps: ", kept);
	g.steps += g.n + 1;
	out
}
@end
