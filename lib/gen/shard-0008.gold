fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var temp int[512] = [0; 512];
	var count = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) {
			if total + x <= limit {
				temp[count] = x;
				total += x;
				count++;
			}
		}
	}
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	out.i = total;
	out.s.clear();
	format(out.s, "budget spent: ", total);
	g.steps += g.n + 1;
	out
}
@end
