code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var lim = if k < g.n { k } else { g.n };
	if lim > 1 {
		var l = 0;
		var r = lim - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed first ", lim, " steps");
	g.steps += lim;
	out
}
@end
