code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	fn is_sq(n int) bool {
		if n < 0 { return false; }
		var r = 0;
		while r * r < n { r++; }
		r * r == n
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if is_sq(x) {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n * 2 + 3;
	out.i = kept;
	out.s.clear();
	format(out.s, "retried unique squares count ", kept);
	out
}
@end
