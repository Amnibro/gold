kind: step
verb: rotate
noun: value
modifier: any
context: list
phrase: rotate list placing any matching value {target} at head
phrase: pivot sequence to begin with value {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="rotated to place 30 at index 0" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=5,6,7 target=99
expect: => i=-1 r=0.0 ok=false s="value 99 not found for rotate" errors=1 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = ${target};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == val {
			found_idx = i;
			break;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "value not found");
		out.ok = false;
		out.i = -1;
		out.s.clear();
		format(out.s, "value ", val, " not found for rotate");
		return out;
	}
	var tmp int[512] = [0; 512];
	for i in g.n { tmp[i] = g.res[i]; }
	for i in g.n {
		let src_idx = (i + found_idx) % g.n;
		g.res[i] = tmp[src_idx];
	}
	g.steps += g.n;
	out.i = found_idx;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated to place ", val, " at index 0");
	out
}
@end
