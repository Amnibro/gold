fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	if out.s.len > 1 {
		for i in (out.s.len - 1) {
			let d = (out.s[i + 1] as int) - (out.s[i] as int);
			gold_push(g, d);
		}
	}
	g.steps += out.s.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped ", g.n, " pairwise char deltas");
	out
}
