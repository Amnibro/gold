	let target = ${key};
	let val, found = gold_cache_get(g, target);
	if found {
		out.i = val;
	} else {
		let computed = target * 3;
		gold_cache_put(g, target, computed);
		out.i = computed;
	}
	g.steps += 3;
	out.s.clear();
	format(out.s, "retried cache with value ", out.i);
