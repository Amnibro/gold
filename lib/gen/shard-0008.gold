expect: => i=6 r=0.0 ok=true s="counted 6 steps up to limit" errors=0 n=2 res=[2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_steps = ${limit};
	var total_steps = 0;
	for i in g.n {
		var x = g.res[i];
		var steps = 0;
		while steps < max_steps && x > 1 {
			x = ${f}(x);
			steps++;
		}
		total_steps += steps;
		g.res[i] = x;
	}
	g.steps += total_steps;
	out.i = total_steps;
	out.s.clear();
	format(out.s, "counted ", total_steps, " steps up to limit");
	out
}
@end
