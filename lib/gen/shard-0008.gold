test: list=3,7,12,20
expect: => i=3 r=0.0 ok=true s="validated 3 increasing pairs" errors=0 n=4 res=[3,7,12,20] cache=0 hits=0
test: list=5,9,4,10
expect: => i=0 r=0.0 ok=false s="pair at index 1 failed increasing check" errors=1 n=4 res=[5,9,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "trivial pair validation");
		return out;
	}
	for i in g.n - 1 {
		if g.res[i + 1] <= g.res[i] {
			gold_fail(g, "pair not strictly increasing");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "pair at index ", i, " failed increasing check");
			return out;
		}
	}
	let pairs = g.n - 1;
	g.steps += pairs;
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated ", pairs, " increasing pairs");
	out
}
@end
