fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var step = v.i;
	if step > 2 {
		step = 2;
	}
	var i = 0;
	while i < out.s.len {
		out.s[i] = (out.s[i] + (step as byte)) as byte;
		i += 1;
	}
	out.i = step;
	out.ok = true;
	g.steps += out.s.len;
	out
}
@end
@entry a862f926f4429bcf
kind: step
verb: limit
noun: pairs
modifier: times
context: text
phrase: limit repeated character pairs to maximum times
phrase: truncate duplicate adjacent pairs by count limit
test: input=2 text="aabbcc"
expect: => i=2 r=0.0 ok=true s="found 2 duplicate pairs up to limit 2" errors=0 n=1 res=[2] cache=0 hits=0
test: input=1 text="xxyy"
expect: => i=1 r=0.0 ok=true s="found 1 duplicate pairs up to limit 1" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_pairs = v.i;
	var pairs = 0;
	var i = 0;
	while i < v.s.len - 1 && pairs < max_pairs {
		if v.s[i] == v.s[i + 1] {
			pairs += 1;
			i += 1;
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, pairs);
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "found ", pairs, " duplicate pairs up to limit ", max_pairs);
	g.steps += v.s.len;
	out
}
@end
