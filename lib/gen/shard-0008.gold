code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		g.steps++;
		return out;
	}
	let last = g.res[g.n - 1];
	var count = 0;
	for k in g.n - 1 {
		g.res[k] = g.res[k] + last - b;
		count++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "paired ", count, " items with last");
	g.steps += count;
	out
}
@end
