fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${maxlen};
	if g.n > limit {
		let shift = g.n - limit;
		for i in limit {
			g.res[i] = g.res[i + shift];
		}
		g.n = limit;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited history size ", g.n);
	g.steps += g.n + 1;
	out
}
