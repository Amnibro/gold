fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		g.steps++;
		return out;
	}
	var temp int[512] = [0; 512];
	temp[0] = g.res[0];
	var kept = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[i - 1] {
			temp[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ascending: ", kept);
	g.steps += kept;
	out
}
