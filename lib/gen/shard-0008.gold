@entry 5d017e7e0acadc3b
kind: step
verb: drop
noun: maximum
modifier: in_reverse
context: search
phrase: drop last maximum search hit in reverse scan
phrase: remove trailing peak search value in reverse
phrase: discard final maximum candidate scanning backward
test: list=10,50,30,50,20
expect: => i=50 r=0.0 ok=true s="dropped maximum 50" errors=0 n=4 res=[10,50,30,20] cache=0 hits=0
test: list=5,9,9,2
expect: => i=9 r=0.0 ok=true s="dropped maximum 9" errors=0 n=3 res=[5,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var drop_idx = -1;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] == max_val {
			drop_idx = k;
			break;
		}
		k--;
	}
	if drop_idx >= 0 {
		for i in drop_idx..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "dropped maximum ", max_val);
	out
}
@end
