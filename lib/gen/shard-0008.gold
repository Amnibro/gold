fn ${ID}_is_lower(c byte) bool {
	c >= 'a' && c <= 'z'
}
fn ${ID}_is_upper(c byte) bool {
	c >= 'A' && c <= 'Z'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var low = 0;
