fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if seen {
			dup_count++;
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "found ", dup_count, " running duplicates");
	out
}
