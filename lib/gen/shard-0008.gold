		if x >= 0 && x < lim {
			counts[x]++;
		}
	}
	var distinct = 0;
	for i in lim {
		if counts[i] > 0 {
			distinct++;
		}
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "distinct buckets: ", distinct);
	g.steps += g.n + 1;
