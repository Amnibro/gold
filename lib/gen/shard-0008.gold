fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var clamped = 0;
	for i in g.n {
		if !${cond}(g.res[i]) { break; }
		if g.res[i] > limit {
			g.res[i] = limit;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped numbers count: ", clamped);
	g.steps += g.n + 1;
	out
}
