code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_count};
	var a_count = 0;
	var idx = 0;
	while idx < out.s.len && a_count < target {
		let b = out.s[idx];
		if b == 97 || b == 115 {
			a_count++;
		}
		idx++;
	}
	g.steps += idx;
	out.i = a_count;
	out.ok = (a_count >= target);
	out.s.clear();
	format(out.s, "scanned letters count ", a_count);
	out
}
@end
