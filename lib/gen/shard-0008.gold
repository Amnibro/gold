@entry 1cf03c9e8f1eab2c
kind: step
verb: compute
noun: deviation
modifier: pairwise
context: math
phrase: compute pairwise deviation from average of adjacent items
phrase: calculate distance of adjacent pair to mean
test: list=10,20,40
expect: => i=2 r=0.0 ok=true s="computed 2 pairwise deviation pairs" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,6
expect: => i=1 r=0.0 ok=true s="computed 1 pairwise deviation pairs" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("computed 0 pairwise deviation pairs");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		let mid = (g.res[i] + g.res[i + 1]) / 2;
		let dev = g.res[i + 1] - mid;
		if dev < 0 {
			g.res[i] = -dev;
		} else {
			g.res[i] = dev;
		}
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed ", np, " pairwise deviation pairs");
	g.steps += np;
	out
}
@end
