fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[i] += off;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "safely updated primes: ", count);
	g.steps += g.n;
	out
}
@end
