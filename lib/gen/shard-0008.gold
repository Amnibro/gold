test: list=45,10,20
expect: => i=45 r=0.0 ok=true s="validated first item 45 into cache" errors=0 n=3 res=[45,10,20] cache=1 hits=0
test: list=-8,2,3
expect: => i=-8 r=0.0 ok=false s="first item validation failed: negative" errors=1 n=3 res=[-8,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for first item cache validation");
		out.ok = false;
		out.i = 0;
		return out;
	}
	let first = g.res[0];
	out.i = first;
	out.s.clear();
	if first < 0 {
		gold_fail(g, "negative first element");
		out.ok = false;
		format(out.s, "first item validation failed: negative");
		return out;
	}
	let cv, hit = gold_cache_get(g, first);
	if hit {
		format(out.s, "first item ", first, " cache hit: ", cv);
	} else {
		gold_cache_put(g, first, 1);
		format(out.s, "validated first item ", first, " into cache");
	}
	g.steps += 1;
	out
}
@end
@entry 774396b33fc383da
kind: step
verb: filter
noun: streak
modifier: at_least
context: list
phrase: filter increasing streaks of length at least {min_streak}
phrase: retain elements in ascending runs of at least {min_streak}
slot: min_streak int
test: list=10,20,30,5,8 min_streak=3
expect: => i=3 r=0.0 ok=true s="kept 3 items in streaks of at least 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,4,3,2 min_streak=2
expect: => i=0 r=0.0 ok=true s="kept 0 items in streaks of at least 2" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_streak};
	var tmp int[512] = [0; 512];
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] > g.res[j - 1] { j++; }
		let streak_len = j - i;
		if streak_len >= min_s {
			for k in streak_len {
				tmp[kept] = g.res[i + k];
				kept++;
			}
		}
		i = j;
	}
	gold_clear(g);
	for k in kept { gold_push(g, tmp[k]); }
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items in streaks of at least ", min_s);
	out
}
@end
