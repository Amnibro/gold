phrase: select longest streak recursively
phrase: extract longest streak of items recursively
phrase: find longest identical streak recursively
test: list=1,2,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="selected streak of length 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=5,5,5,5,6
expect: => i=4 r=0.0 ok=true s="selected streak of length 4" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
recursive fn ${ID}_helper(g Gold&, idx int, best_start int&, best_len int&) {
	if idx >= g.n { return; }
	var j = idx;
	while j < g.n && g.res[j] == g.res[idx] { j++; }
	let len = j - idx;
	if len > best_len {
		best_len = len;
		best_start = idx;
	}
	${ID}_helper(g, j, best_start, best_len);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var b_start = 0;
	var b_len = 0;
	${ID}_helper(g, 0, b_start, b_len);
	var streak int[512] = [0; 512];
	for k in b_len {
		streak[k] = g.res[b_start + k];
	}
	gold_clear(g);
	for m in b_len {
		gold_push(g, streak[m]);
	}
	g.steps += b_len;
	out.i = b_len;
	out.s.clear();
	format(out.s, "selected streak of length ", b_len);
	out
}
@end
