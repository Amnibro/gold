code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${block_size};
	if k <= 1 { return out; }
	var i = 0;
	while i < g.n {
		let end = if i + k < g.n { i + k } else { g.n };
		var p = i;
		var q = end - 1;
		while p < q {
			let tmp = g.res[p];
			g.res[p] = g.res[q];
			g.res[q] = tmp;
			p++;
			q--;
		}
		i += k;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed nested blocks of size ", k);
	out
}
@end
