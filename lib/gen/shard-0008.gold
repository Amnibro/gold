fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		if g.res[i] >= lim {
			break;
		}
		if g.res[i] % 2 == 0 {
			g.res[i] += d;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "shifted evens: ", count);
	g.steps += g.n;
	out
}
