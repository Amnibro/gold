@entry d4c6d6b5d2410c89
kind: step
verb: pair
noun: average
modifier: sorted
context: compare
phrase: pair adjacent elements comparing sorted averages
phrase: group pairs sorting results by average value
test: list=1,9,2,8
expect: => i=2 r=0.0 ok=true s="sorted 2 pair averages" errors=0 n=2 res=[5,5] cache=0 hits=0
test: list=10,30,5,15
expect: => i=2 r=0.0 ok=true s="sorted 2 pair averages" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let num_pairs = g.n / 2;
	for i in num_pairs {
		let avg = (g.res[i * 2] + g.res[i * 2 + 1]) / 2;
		g.res[i] = avg;
	}
	g.n = num_pairs;
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " pair averages");
	out
}
@end
