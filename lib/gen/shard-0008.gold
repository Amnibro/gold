slot: end int
test: list=1,2,3,4,5 start=1 end=3
expect: => i=3 r=0.0 ok=true s="swapped range of 3" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30 start=0 end=1
expect: => i=2 r=0.0 ok=true s="swapped range of 2" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${end};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	var l = s;
	var r = e;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	let span = if e >= s { e - s + 1 } else { 0 };
	out.i = span;
	out.s.clear();
	format(out.s, "swapped range of ", span);
	g.steps += span;
	out
}
@end
