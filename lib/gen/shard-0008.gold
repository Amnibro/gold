code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${k};
	let count = if len > g.n { g.n } else if len < 0 { 0 } else { len };
	var tmp int[512] = [0; 512];
	let start = g.n - count;
	var running = 0;
	for i in count {
		running += g.res[start + i];
		tmp[i] = running;
	}
	gold_clear(g);
	for i in count { gold_push(g, tmp[i]); }
	g.steps += count;
	out.i = running;
	out.s.clear();
	format(out.s, "computed ", count, " nested suffix sums");
	out
}
@end
