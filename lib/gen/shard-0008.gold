expect: => i=0 r=0.0 ok=false s="sequence failed condition" errors=1 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var all_match = true;
	for k in g.n {
		if !${p}(g.res[k]) {
			all_match = false;
			break;
		}
	}
	out.ok = all_match;
	out.s.clear();
	if all_match {
		out.s.append("sequence matched condition");
	} else {
		gold_fail(g, "sequence element violated condition");
		out.s.append("sequence failed condition");
	}
	g.steps += g.n + 1;
	out
}
@end
