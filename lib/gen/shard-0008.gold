test: list=1,2,2,2,3 min_count=3
expect: => i=3 r=0.0 ok=true s="retained 3 frequent items" errors=0 n=3 res=[2,2,2] cache=0 hits=0
test: list=4,4,5,6 min_count=2
expect: => i=2 r=0.0 ok=true s="retained 2 frequent items" errors=0 n=2 res=[4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_count};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if count >= min_c {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " frequent items");
	out
}
@end
