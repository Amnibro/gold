@entry a4277852d3191c32
kind: step
verb: drop
noun: maximum
modifier: until
context: math
phrase: drop maximum values repeatedly until largest is under {thresh}
phrase: remove peak elements until sequence max is below {thresh}
slot: thresh int
test: list=50,20,40,10 thresh=30
expect: => i=2 r=0.0 ok=true s="dropped max count: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
test: list=100,80,60 thresh=70
expect: => i=2 r=0.0 ok=true s="dropped max count: 2" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var drops = 0;
	while g.n > 0 && drops < 10 {
		var max_idx = 0;
		for i in 1..g.n {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		if g.res[max_idx] >= limit {
			for i in (max_idx + 1)..g.n {
				g.res[i - 1] = g.res[i];
			}
			g.n--;
			drops++;
		} else {
			break;
		}
	}
	out.i = drops;
	out.s.clear();
	format(out.s, "dropped max count: ", drops);
	g.steps += drops + 1;
	out
}
@end
