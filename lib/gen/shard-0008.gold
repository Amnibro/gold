fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tlen = ${target_len};
	let fval = ${fill_val};
	while g.n < tlen && g.n < 512 {
		gold_push(g, fval);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "padded list to length ", g.n);
	out
}
@end
@entry 1989e05ee3e58738
kind: step
verb: shift
noun: digits
modifier: safely
context: sort
phrase: replace sorted items with their digit sums safely
phrase: transform ordered sequence by summing element digits
test: list=12,34,50
expect: => i=3 r=0.0 ok=true s="transformed 3 digit sums" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=9,99
expect: => i=2 r=0.0 ok=true s="transformed 2 digit sums" errors=0 n=2 res=[9,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var sum = 0;
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
		g.res[k] = sum;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "transformed ", g.n, " digit sums");
	out
}
@end
