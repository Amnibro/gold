fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for k in g.n {
		g.res[k] = g.res[k] * f;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " items");
	out
}
