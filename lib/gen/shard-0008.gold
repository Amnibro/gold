	var dup_cnt = 0;
	if g.n >= 2 {
		for k in g.n {
			var is_dup = false;
			if k > 0 && g.res[k] == g.res[k - 1] { is_dup = true; }
			if k + 1 < g.n && g.res[k] == g.res[k + 1] { is_dup = true; }
			if is_dup {
				g.res[k] = g.res[k] * f;
				dup_cnt++;
			}
		}
	}
	g.steps += g.n;
	out.i = dup_cnt;
	out
}
@end
