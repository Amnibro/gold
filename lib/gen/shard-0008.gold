code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_t = ${tries};
	var count = 0;
	var attempt = 0;
	while attempt < max_t {
		attempt++;
		count = 0;
		for k in g.n {
			if g.res[k] == tgt { count++; }
		}
		if count > 0 { break; }
	}
	g.steps += attempt * g.n;
	out.i = count;
	out
}
