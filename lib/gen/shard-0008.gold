expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	var count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= req { count++; }
		i = j;
	}
	g.steps += g.n;
	out.i = count;
	out
}
@end
