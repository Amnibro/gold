code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let lim = if limit > g.n { g.n } else { limit };
	var i = 0;
	var j = lim - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += lim;
	out.i = lim;
	out
}
@end
