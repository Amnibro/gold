code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var a = 0;
	while a < g.n - 1 {
		var b = 0;
		while b < g.n - 1 - a {
			if g.res[b] > g.res[b + 1] {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
			}
			b += 1;
		}
		a += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", g.n, " result items");
	g.steps += g.n * g.n;
	out
}
@end
