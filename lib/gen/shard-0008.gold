fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for i in g.n {
		var x = g.res[i];
		for step in d {
			x = (x / 2) + 1;
		}
		g.res[i] = x;
	}
	g.steps += g.n * d;
	out.i = d;
	out.s.clear();
	format(out.s, "mapped range with depth ", d);
	out
}
@end
@entry 6ac8869187bef924
kind: step
verb: check
noun: vowels
modifier: times
context: loop
phrase: check text contains vowels at least {count} times
phrase: verify vowel count in string reaches {count}
slot: count int
test: text="education" count=5
expect: => i=5 r=0.0 ok=true s="found 5 vowels" errors=0 n=0 res=[] cache=0 hits=0
test: text="sky" count=1
expect: => i=0 r=0.0 ok=false s="found 0 vowels" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	var vowels = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == 97 || b == 101 || b == 105 || b == 111 || b == 117 ||
		   b == 65 || b == 69 || b == 73 || b == 79 || b == 85 {
			vowels++;
		}
	}
	g.steps += out.s.len;
	out.i = vowels;
	out.ok = (vowels >= target);
	if !out.ok {
		gold_fail(g, "insufficient vowels in text");
	}
