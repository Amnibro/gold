@entry caa05dd5b7215d50
kind: step
verb: dedupe
noun: gaps
modifier: with_cache
context: core
phrase: dedupe gaps with cache removing duplicate difference intervals
phrase: filter adjacent spacing differences storing unique gaps in cache
test: list=1,3,5,9,13
expect: => i=2 r=0.0 ok=true s="deduped gaps with cache: 2" errors=0 n=2 res=[2,4] cache=2 hits=0
test: list=2,5,8,11
expect: => i=1 r=0.0 ok=true s="deduped gaps with cache: 1" errors=0 n=1 res=[3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == gap { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, kept, gap);
			g.res[kept] = gap;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped gaps with cache: ", kept);
	g.steps += g.n + 1;
	out
}
@end
