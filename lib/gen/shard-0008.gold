@entry 3b8679f622b7b0fd
kind: step
verb: fill
noun: runs
modifier: at_least
context: stats
phrase: extend short runs to length at least {min_len}
phrase: pad repeated runs to span at least {min_len} items
phrase: lengthen sample runs to reach at least {min_len}
slot: min_len int
test: list=5,5,9 min_len=3
expect: => i=3 r=0.0 ok=true s="padded 3 run items" errors=0 n=6 res=[5,5,5,9,9,9] cache=0 hits=0
test: list=2,3,3 min_len=3
expect: => i=3 r=0.0 ok=true s="padded 3 run items" errors=0 n=6 res=[2,2,2,3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${min_len};
	var temp: int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		for k in 0..run_len { if tn < 512 { temp[tn] = g.res[i]; tn++; } }
		if run_len < target_len {
			for k in 0..(target_len - run_len) { if tn < 512 { temp[tn] = g.res[i]; tn++; } }
		}
		i = j;
	}
	for k in tn { g.res[k] = temp[k]; }
	let added = tn - g.n;
	g.n = tn;
	g.steps += tn;
	out.i = added;
	out.s.clear();
	format(out.s, "padded ", added, " run items");
	out
}
@end
