@entry 25046336342a3ee3
kind: step
verb: pair
noun: histogram
modifier: at_most
context: loop
phrase: pair frequency counts into histogram at most {cap}
phrase: group histogram pairs capped at most {cap}
slot: cap int
test: list=5,5,5,8,8 cap=2
expect: => i=2 r=0.0 ok=true s="paired 2 histogram bins" errors=0 n=4 res=[5,2,8,2] cache=0 hits=0
test: list=1,2,2,3,3,3 cap=5
expect: => i=3 r=0.0 ok=true s="paired 3 histogram bins" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${cap};
	var temp_v int[512] = [0; 512];
	var temp_c int[512] = [0; 512];
	var num_bins = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in num_bins {
			if temp_v[j] == x { found = j; break; }
		}
		if found >= 0 {
			if temp_c[found] < max_c { temp_c[found]++; }
		} else {
			temp_v[num_bins] = x;
			temp_c[num_bins] = 1;
			num_bins++;
		}
	}
	gold_clear(g);
	for j in num_bins {
		gold_push(g, temp_v[j]);
		gold_push(g, temp_c[j]);
	}
	g.steps += num_bins;
	out.i = num_bins;
	out.s.clear();
	format(out.s, "paired ", num_bins, " histogram bins");
	out
}
@end
