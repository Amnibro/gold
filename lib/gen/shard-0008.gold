fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	var valid = false;
	if g.n >= req && req > 0 {
		let target = g.res[g.n - 1];
		valid = true;
		var i = 0;
		while i < req {
			if g.res[g.n - 1 - i] != target {
				valid = false;
			}
			i++;
		}
	}
	g.steps += req + 2;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked suffix repeat ", out.i);
	out
}
@end
