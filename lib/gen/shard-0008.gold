expect: => i=2 r=0.0 ok=true s="merged sorted pairs count: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=5,2,1,4
expect: => i=0 r=0.0 ok=false s="unsorted pair detected during merge" errors=1 n=4 res=[5,2,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var has_error = false;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			has_error = true;
			break;
		}
		i += 2;
	}
	if has_error || g.n % 2 != 0 {
		gold_fail(g, "unsorted pair or odd length detected");
		out.ok = false;
		out.i = 0;
	} else {
		var w = 0;
		var r = 0;
		while r + 1 < g.n {
			g.res[w] = g.res[r] + g.res[r + 1];
			w++;
			r += 2;
		}
		g.n = w;
		out.i = w;
	}
	out.s.clear();
	if out.ok {
		format(out.s, "merged sorted pairs count: ", out.i);
	} else {
		out.s.append("unsorted pair detected during merge");
	}
	g.steps += g.n + 1;
	out
}
@end
