code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var last_even = -1000000;
	for i in g.n {
		if core_is_even(g.res[i]) {
			if g.res[i] < last_even {
				is_sorted = false;
				gold_fail(g, "even elements not sorted");
				break;
			}
			last_even = g.res[i];
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, if is_sorted { "evens sorted" } else { "evens unsorted" });
	out
}
@end
