expect: => i=3 r=0.0 ok=true s="clamped gaps between count: 3" errors=0 n=4 res=[5,8,14,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	let xg = ${max_gap};
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap < mg {
			g.res[i] = g.res[i - 1] + mg;
			clamped++;
		} else if gap > xg {
			g.res[i] = g.res[i - 1] + xg;
			clamped++;
		}
		i++;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped gaps between count: ", clamped);
	g.steps += g.n + 1;
	out
}
@end
