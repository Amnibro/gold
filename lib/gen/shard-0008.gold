	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	if g.n > 1 {
		let shift = c % g.n;
		var temp: int[512] = [0; 512];
		for i in g.n {
			let new_idx = (i + shift) % g.n;
			temp[new_idx] = g.res[i];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	out.i = spent;
	out.s.clear();
	format(out.s, "rotated budget items sum: ", spent);
	g.steps += g.n + 1;
	out
}
@end
