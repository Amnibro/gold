fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = v.i;
	if k < 0 {
		k = 0;
	}
	if k > g.n {
		k = g.n;
	}
	var kept = 0;
	var i = k;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept += 1;
		i += 1;
	}
	g.n = kept;
	out.i = k;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped ", k, " leading items");
	g.steps += g.n;
	out
}
@end
