expect: => i=0 r=0.0 ok=true s="found 0 unique values" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var count = 0;
		while i < g.n && g.res[i] == x {
			count++;
			i++;
		}
		if count == 1 {
			unique_count++;
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "found ", unique_count, " unique values");
	out
}
@end
