	var left = 0;
	var right = c - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "reversed ", c, " head items");
	out
}
