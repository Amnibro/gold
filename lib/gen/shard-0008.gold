@entry e22a478e5aff6ce8
kind: step
verb: dedupe
noun: number
modifier: none
context: compare
phrase: dedupe number none comparison distinct count
phrase: filter duplicate numbers across comparison history
test: list=10,20,10,30,20
expect: => i=2 r=0.0 ok=true s="deduped comparison numbers count: 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=1,2,3,1
expect: => i=1 r=0.0 ok=true s="deduped comparison numbers count: 1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var removed = 0;
	while i < g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if !first {
			for j in (g.n - 1 - i) {
				g.res[i + j] = g.res[i + 1 + j];
			}
			g.n--;
			removed++;
		} else {
			i++;
		}
	}
	g.steps += g.n + removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped comparison numbers count: ", removed);
	out
}
@end
