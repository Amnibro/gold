@entry 4183eab67e8a5bde
kind: step
verb: scale
noun: prefix
modifier: sorted
context: transform
phrase: scale sorted prefix elements by factor {factor}
phrase: multiply ascending prefix values by factor {factor}
slot: factor int
test: list=2,4,6,3 factor=3
expect: => i=3 r=0.0 ok=true s="scaled prefix count 3" errors=0 n=4 res=[6,12,18,3] cache=0 hits=0
test: list=1,5,10,2 factor=2
expect: => i=3 r=0.0 ok=true s="scaled prefix count 3" errors=0 n=4 res=[2,10,20,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${factor};
	var count = if g.n > 0 { 1 } else { 0 };
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			count++;
			i++;
		} else {
			break;
		}
	}
	for j in count {
		g.res[j] *= m;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled prefix count ", count);
	out
}
@end
