				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var buckets = 0;
	if g.n > 0 {
		let max_val = g.res[g.n - 1];
		buckets = (max_val / b) + 1;
	}
	out.i = buckets;
	out.s.clear();
	format(out.s, "histogram buckets calculated: ", buckets);
	g.steps += g.n + 1;
	out
}
@end
