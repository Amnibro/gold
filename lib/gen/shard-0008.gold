code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let base = g.res[0];
	for i in g.n {
		g.res[i] = g.res[i] - base;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized series to first ", base);
	g.steps += g.n + 1;
	out
}
@end
