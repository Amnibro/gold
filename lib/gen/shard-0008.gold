code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_idx = -1;
	var sq_val = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				found_idx = i;
				sq_val = x;
				break;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	if found_idx >= 0 {
		out.i = sq_val;
		out.ok = true;
		format(out.s, "first square ", sq_val, " found at index ", found_idx);
	} else {
		gold_fail(g, "no square found");
		out.i = -1;
		out.ok = false;
		format(out.s, "no square found in sequence");
	}
	out
}
@end
