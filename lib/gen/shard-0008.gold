@entry c1f41e20838cc43b
kind: step
verb: rotate
noun: series
modifier: nested
context: list
phrase: rotate series halves in nested opposing directions
phrase: apply nested cyclical rotations to series halves
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="nested rotated 4 series items" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=10,20,30,40,50,60
expect: => i=6 r=0.0 ok=true s="nested rotated 6 series items" errors=0 n=6 res=[30,10,20,50,60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	if half > 1 {
		let last_first = g.res[half - 1];
		var i = half - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last_first;
		let first_second = g.res[half];
		var j = half;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[g.n - 1] = first_second;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested rotated ", g.n, " series items");
	out
}
@end
