code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		out.s.append("not enough items for window");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized ", np, " window averages in place");
	g.steps += np;
	out
}
@end
