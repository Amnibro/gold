fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${plen};
	var attempts = 0;
	while attempts < 3 {
		attempts++;
		if out.s.len >= target_len {
			out.s.resize(target_len, 0);
			out.i = target_len;
			g.steps += attempts;
			return out;
		}
		if g.n > 0 {
			format(out.s, g.res[0]);
		} else {
			format(out.s, "x");
		}
	}
	if out.s.len > target_len {
		out.s.resize(target_len, 0);
	}
	out.i = out.s.len;
	g.steps += attempts + 2;
	out
}
@end
