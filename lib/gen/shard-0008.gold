fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n <= m * 2 {
		out.i = g.n;
		return out;
	}
	var kept int[512] = [0; 512];
	var count = 0;
	for i in m {
		kept[count] = g.res[i];
		count++;
	}
	var j = g.n - m;
	while j < g.n {
		kept[count] = g.res[j];
		count++;
		j++;
	}
	gold_clear(g);
	for k in count { gold_push(g, kept[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " boundary items dropping middle");
	out
}
