fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			gold_fail(g, "loop unsorted inversion found");
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, if is_sorted { "loop elements sorted" } else { "unsorted loop found" });
	out
}
@end
