expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[3,3,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	let f = ${factor};
	var count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= min_l {
			var k = i;
			while k < j {
				g.res[k] = g.res[k] * f;
				k++;
			}
			count++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = count;
	out
}
@end
