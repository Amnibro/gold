@entry 92af69eab0418d5d
kind: step
verb: find
noun: average
modifier: sorted
context: text
phrase: find average word length sorted ascending
phrase: compute sorted word lengths with average calculation
test: text="a bb ccc"
expect: => i=2 r=0.0 ok=true s="sorted 3 lengths with average 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: text="hi world"
expect: => i=3 r=0.0 ok=true s="sorted 2 lengths with average 3" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur = 0;
	var i = 0;
	while i < v.s.len {
		if v.s[i] == ' ' {
			if cur > 0 {
				gold_push(g, cur);
				cur = 0;
			}
		} else {
			cur += 1;
		}
		i += 1;
	}
	if cur > 0 {
		gold_push(g, cur);
	}
	// Bubble sort
	var a = 0;
	while a < g.n - 1 {
		var b = 0;
		while b < g.n - 1 - a {
			if g.res[b] > g.res[b + 1] {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
			}
			b += 1;
		}
		a += 1;
	}
	var sum = 0;
	i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	out.i = avg;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", g.n, " lengths with average ", avg);
	g.steps += g.n * g.n;
	out
}
@end
@entry 164f8addd5ec61fa
kind: step
verb: limit
noun: primes
modifier: safely
context: text
phrase: limit prime ascii character codes safely
phrase: filter prime character values safely up to limit
test: input=2 text="abcdef"
expect: => i=2 r=0.0 ok=true s="found 2 prime codes safely up to limit 2" errors=0 n=2 res=[97,101] cache=0 hits=0
test: input=1 text="xyz"
expect: => i=0 r=0.0 ok=false s="found 0 prime codes safely up to limit 1" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = v.i;
	gold_clear(g);
	var i = 0;
	while i < v.s.len && g.n < limit {
		let code = v.s[i] as int;
		if core_is_prime(code) {
			gold_push(g, code);
		}
		i += 1;
	}
	out.i = g.n;
	out.ok = g.n > 0;
	out.s.clear();
	format(out.s, "found ", g.n, " prime codes safely up to limit ", limit);
	g.steps += v.s.len;
	out
}
@end
@entry cce45090a4bc28c9
kind: step
verb: apply
noun: squares
modifier: every_other
context: text
phrase: apply squaring to alternating digit characters
phrase: square alternating numeric digits in string
test: text="12345"
expect: => i=3 r=0.0 ok=true s="squared 3 alternating digits" errors=0 n=3 res=[1,9,25] cache=0 hits=0
test: text="246"
expect: => i=2 r=0.0 ok=true s="squared 2 alternating digits" errors=0 n=2 res=[4,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			gold_push(g, d * d);
		}
		i += 2;
	}
	out.i = g.n;
	out.ok = g.n > 0;
	out.s.clear();
	format(out.s, "squared ", g.n, " alternating digits");
	g.steps += v.s.len;
	out
}
@end
