phrase: partition adjacent elements under threshold difference {gap}
slot: gap int
test: list=1,2,4,5,9 gap=2
expect: => i=2 r=0.0 ok=true s="pairwise groups: 2" errors=0 n=5 res=[1,2,4,5,9] cache=0 hits=0
test: list=10,12,20,22,25 gap=3
expect: => i=2 r=0.0 ok=true s="pairwise groups: 2" errors=0 n=5 res=[10,12,20,22,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${gap};
	var groups = if g.n > 0 { 1 } else { 0 };
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = -diff; }
			if diff > limit {
				groups++;
			}
		}
	}
	out.i = groups;
	out.s.clear();
	format(out.s, "pairwise groups: ", groups);
	g.steps += g.n + 1;
	out
}
@end
