fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var mapped = 0;
	for i in g.n {
		let d = g.res[i] % 10;
		if d >= low && d <= high {
			g.res[i] += 10;
			mapped++;
		}
	}
	g.steps += g.n;
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped digits between count ", mapped);
	out
}
@end
