code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 {
			return false;
		}
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var write = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			g.res[write] = g.res[i];
			write++;
			primes++;
		}
	}
	g.n = write;
	out.i = primes;
	out.ok = (primes > 0);
	out.s.clear();
	format(out.s, "found primes ", primes);
	g.steps += g.n + 20;
	out
}
@end
