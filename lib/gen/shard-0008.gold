@entry b9a49f93d52cb1c9
kind: step
verb: compute
noun: average
modifier: in_place
context: math
phrase: compute deviation from mean for all items in place
phrase: center items around mean in place
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="centered 3 items around mean 20" errors=0 n=3 res=[-10,0,10] cache=0 hits=0
test: list=2,8
expect: => i=2 r=0.0 ok=true s="centered 2 items around mean 5" errors=0 n=2 res=[-3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty list centered");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	i = 0;
	while i < g.n {
		g.res[i] = g.res[i] - avg;
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "centered ", g.n, " items around mean ", avg);
	g.steps += g.n;
	out
}
@end
@entry fcd93253d261e950
kind: step
verb: count
noun: average
modifier: in_place
context: math
phrase: count items strictly below average in place
phrase: count items smaller than mean keeping count in place
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="counted 2 items below average 25" errors=0 n=1 res=[2] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="counted 0 items below average 5" errors=0 n=1 res=[0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_clear(g);
		gold_push(g, 0);
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("counted 0 items in empty list");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	var cnt = 0;
	i = 0;
	while i < g.n {
		if g.res[i] < avg {
			cnt += 1;
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, cnt);
	out.i = cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "counted ", cnt, " items below average ", avg);
	g.steps += g.n;
	out
}
@end
