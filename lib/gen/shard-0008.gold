@entry 9df238a084efdfa6
kind: step
verb: measure
noun: range
modifier: with_cache
context: loop
phrase: measure range span of loop with cache lookup
phrase: compute span of values in loop recording cache
test: list=5,15,30
expect: => i=25 r=0.0 ok=true s="measured range span 25" errors=0 n=3 res=[5,15,30] cache=1 hits=0
test: list=2,8,20,50
expect: => i=48 r=0.0 ok=true s="measured range span 48" errors=0 n=4 res=[2,8,20,50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	gold_cache_put(g, span, g.n);
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "measured range span ", span);
	out
}
@end
@entry 05deaec8f3a49747
kind: step
verb: keep
noun: gaps
modifier: between
context: loop
phrase: keep pairwise gaps between {min_gap} upper {max_gap}
phrase: filter adjacent differences between {min_gap} inclusive {max_gap}
slot: min_gap int
slot: max_gap int
test: list=10,15,22,35 min_gap=4 max_gap=8
expect: => i=2 r=0.0 ok=true s="kept 2 valid gaps" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=1,10,12,30 min_gap=1 max_gap=5
expect: => i=1 r=0.0 ok=true s="kept 1 valid gaps" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${min_gap};
	let high = ${max_gap};
	if g.n < 2 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	for i in (g.n - 1) {
		let gap = g.res[i + 1] - g.res[i];
		if gap >= low && gap <= high {
			g.res[kept] = gap;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " valid gaps");
	out
}
@end
