@entry cc04bf8837ac4bb8
kind: step
verb: shift
noun: cache
modifier: in_reverse
context: error
phrase: shift cached entries in reverse order
phrase: reverse shift cache keys safely
phrase: invert cache ordering with error check
test: list=10,20
expect: => i=2 r=0.0 ok=true s="reversed 2 cache entries" errors=0 n=2 res=[10,20] cache=2 hits=0
test: list=10
expect: => i=0 r=0.0 ok=false s="error: cache too small" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn < 2 {
		if g.n < 2 {
			gold_fail(g, "not enough items or cache entries to reverse");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: cache too small");
			return out;
		}
		for k in g.n {
			gold_cache_put(g, k, g.res[k]);
		}
	}
	var left = 0;
	var right = g.cn - 1;
	while left < right {
		let tmp_k = g.ck[left];
		let tmp_v = g.cv[left];
		g.ck[left] = g.ck[right];
		g.cv[left] = g.cv[right];
		g.ck[right] = tmp_k;
		g.cv[right] = tmp_v;
		left++;
		right--;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed ", g.cn, " cache entries");
	out
}
@end
