phrase: compute nested sliding window means of length {size}
phrase: extract moving average statistics for window {size}
slot: size int
test: list=10,20,30,40,50 size=3
expect: => i=3 r=0.0 ok=true s="extracted 3 window means" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=2,4,6,8 size=2
expect: => i=3 r=0.0 ok=true s="extracted 3 window means" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || w > g.n {
		out.i = 0;
		return out;
	}
	var wn = 0;
	for i in 0..(g.n - w + 1) {
		var sum = 0;
		for j in 0..w { sum += g.res[i + j]; }
		g.res[wn] = sum / w;
		wn++;
	}
	g.n = wn;
	g.steps += g.n * w;
	out.i = wn;
	out.s.clear();
	format(out.s, "extracted ", wn, " window means");
	out
}
@end
