@entry 41d15ce120e06a07
kind: step
verb: select
noun: gaps
modifier: sorted
context: core
phrase: select differences between items in sorted sequence
phrase: compute adjacent gaps sorting results ascending
test: list=1,10,3,20
expect: => i=3 r=0.0 ok=true s="selected sorted gaps count 3" errors=0 n=3 res=[2,7,10] cache=0 hits=0
test: list=5,2,8
expect: => i=2 r=0.0 ok=true s="selected sorted gaps count 2" errors=0 n=2 res=[3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	let gaps = g.n - 1;
	for i in gaps {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = gaps;
	g.steps += g.n * 2 + 3;
	out.i = gaps;
	out.s.clear();
	format(out.s, "selected sorted gaps count ", gaps);
	out
}
@end
