@entry 6bfa3257429b6cb7
kind: step
verb: clamp
noun: threshold
modifier: sorted
context: filter
phrase: clamp threshold values between {low} through {high} keeping sorted
phrase: restrict sorted elements within bounds {low} to {high}
slot: low int
slot: high int
test: list=35,10,5,20 low=10 high=30
expect: => i=2 r=0.0 ok=true s="clamped sorted count: 2" errors=0 n=4 res=[10,10,20,30] cache=0 hits=0
test: list=50,15,40 low=20 high=45
expect: => i=2 r=0.0 ok=true s="clamped sorted count: 2" errors=0 n=3 res=[20,40,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var clamped = 0;
	for k in g.n {
		if g.res[k] < lo {
			g.res[k] = lo;
			clamped++;
		} else if g.res[k] > hi {
			g.res[k] = hi;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped sorted count: ", clamped);
	g.steps += g.n + 1;
	out
}
@end
