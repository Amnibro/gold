fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			total += x;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "unique total: ", total);
	g.steps += g.n + 1;
	out
}
@end
