fn ${ID}_divs(x int) int {
	if x <= 0 { return 0; }
	var c = 0;
	var i = 1;
	while i <= x {
		if x % i == 0 { c++; }
		i++;
	}
	c
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${ID}_divs(g.res[k]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped ", g.n, " divisor counts");
	g.steps += g.n;
	out
}
