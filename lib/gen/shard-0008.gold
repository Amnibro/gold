fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n <= 1 || k <= 1 {
		g.steps++;
		return out;
	}
	let start = if g.n - k > 0 { g.n - k } else { 0 };
	var l = start;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "reversed suffix of ", out.i);
	g.steps += g.n;
	out
}
