code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = g.n;
	var i = g.n - 1;
	while i >= 0 {
		if ${ID}_is_p(g.res[i]) {
			start = i;
		} else {
			break;
		}
		i--;
	}
	let kept = g.n - start;
	for j in kept {
		g.res[j] = g.res[start + j];
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept trailing primes ", kept);
	g.steps += kept + 22;
	out
}
@end
