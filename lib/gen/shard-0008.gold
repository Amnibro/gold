test: list=5,5,5,6,6,6 chunk_size=3
expect: => i=2 r=0.0 ok=true s="deduped nested history: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${chunk_size};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let chunk_end = if i + cs < g.n { i + cs } else { g.n };
		var k = i;
		while k < chunk_end {
			var seen = false;
			var j = i;
			while j < k {
				if g.res[j] == g.res[k] { seen = true; break; }
				j++;
			}
			if !seen {
				g.res[kept] = g.res[k];
				kept++;
			}
			k++;
		}
		i += cs;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped nested history: ", kept);
	g.steps += g.n + 1;
	out
}
@end
