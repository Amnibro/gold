test: input=9875 max_steps=2
expect: => i=11 r=0.0 ok=true s="reduced digits to 11 after 2 rounds" errors=0 n=0 res=[] cache=0 hits=0
test: input=49 max_steps=1
expect: => i=13 r=0.0 ok=true s="reduced digits to 13 after 1 rounds" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_steps};
	var cur = if out.i < 0 { -out.i } else { out.i };
	var rounds = 0;
	while rounds < limit && cur >= 10 {
		var s = 0;
		var temp = cur;
		while temp > 0 {
			s += temp % 10;
			temp /= 10;
		}
		cur = s;
		rounds++;
	}
	g.steps += rounds + 1;
	out.i = cur;
	out.s.clear();
	format(out.s, "reduced digits to ", cur, " after ", rounds, " rounds");
	out
}
@end
