fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cap = v.i;
	if cap < 0 {
		cap = 0;
	}
	var count = 0;
	var i = 0;
	while i < g.n && count < cap {
		gold_cache_put(g, i, g.res[i]);
		count += 1;
		i += 1;
	}
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached safely at most ", count, " items");
	g.steps += count;
	out
}
@end
