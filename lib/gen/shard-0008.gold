code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("split into 0 pairwise delta signs");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		let diff = g.res[i + 1] - g.res[i];
		var sign = 0;
		if diff > 0 {
			sign = 1;
		} else if diff < 0 {
			sign = -1;
		}
		g.res[i] = sign;
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "split into ", np, " pairwise delta signs");
	g.steps += np;
	out
}
@end
