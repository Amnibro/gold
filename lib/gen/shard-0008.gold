test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="selected evens first count 3" errors=0 n=6 res=[2,4,6,1,3,5] cache=0 hits=0
test: list=7,8,9,10
expect: => i=2 r=0.0 ok=true s="selected evens first count 2" errors=0 n=4 res=[8,10,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var en = 0;
	var on = 0;
	for i in g.n {
		if core_is_even(g.res[i]) {
			evens[en] = g.res[i];
			en++;
		} else {
			odds[on] = g.res[i];
			on++;
		}
	}
	gold_clear(g);
	for i in en { gold_push(g, evens[i]); }
	for i in on { gold_push(g, odds[i]); }
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "selected evens first count ", en);
	out
}
@end
