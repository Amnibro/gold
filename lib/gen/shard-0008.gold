		out.i = 0;
		g.steps++;
		return out;
	}
	var diff_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = if g.res[i] > g.res[i + 1] { g.res[i] - g.res[i + 1] } else { g.res[i + 1] - g.res[i] };
		diff_sum += d;
		i++;
	}
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "pair difference sum: ", diff_sum);
	g.steps += g.n;
	out
}
