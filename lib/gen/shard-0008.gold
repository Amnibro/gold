@entry 6bcc22e6fa4e8dc1
kind: step
verb: clamp
noun: total
modifier: in_place
context: compare
phrase: clamp total in place ceiling {max_sum}
phrase: restrict cumulative comparison total to limit {max_sum}
slot: max_sum int
test: list=10,20,30,40,50 max_sum=60
expect: => i=60 r=0.0 ok=true s="clamped total in place to: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=15,25,35,45 max_sum=50
expect: => i=50 r=0.0 ok=true s="clamped total in place to: 50" errors=0 n=3 res=[15,25,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_sum};
	if g.n <= 0 || cap <= 0 { return out; }
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] <= cap {
			running += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			let rem = cap - running;
			if rem > 0 {
				g.res[kept] = rem;
				running += rem;
				kept++;
			}
			break;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = running;
	out.s.clear();
	format(out.s, "clamped total in place to: ", running);
	out
}
@end
