@entry b9d5a831d6a452aa
kind: step
verb: keep
noun: gaps
modifier: last
context: sort
phrase: keep last sorted items with gap {min_gap}
phrase: filter tail sorted values with minimum gap {min_gap}
slot: min_gap int
test: list=1,4,5,9 min_gap=3
expect: => i=3 r=0.0 ok=true s="kept elements with gap: 3" errors=0 n=4 res=[1,4,5,9] cache=0 hits=0
test: list=2,3,7,8 min_gap=4
expect: => i=2 r=0.0 ok=true s="kept elements with gap: 2" errors=0 n=4 res=[2,3,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${min_gap};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n > 0 {
		var kept = 1;
		var last_val = g.res[g.n - 1];
		var k = g.n - 2;
		while k >= 0 {
			if last_val - g.res[k] >= min_gap {
				last_val = g.res[k];
				kept++;
			}
			k--;
		}
		out.i = kept;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "kept elements with gap: ", out.i);
	g.steps += g.n + 1;
	out
}
@end
