@entry 07a00a236a8ffa20
kind: step
verb: measure
noun: vowels
modifier: unique
context: compare
phrase: count unique remainders modulo {divisor} across results
phrase: measure unique modulo {divisor} residues in comparison
slot: divisor int
test: list=10,12,15,17 divisor=5
expect: => i=2 r=0.0 ok=true s="unique residues: 2" errors=0 n=4 res=[10,12,15,17] cache=0 hits=0
test: list=10,20,30 divisor=5
expect: => i=1 r=0.0 ok=true s="unique residues: 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${divisor};
	var seen int[256] = [0; 256];
	var unique = 0;
	for k in g.n {
		let rem = g.res[k] % div;
		if rem >= 0 && rem < 256 {
			if seen[rem] == 0 {
				seen[rem] = 1;
				unique++;
			}
		}
	}
	out.i = unique;
	out.s.clear();
	format(out.s, "unique residues: ", unique);
	g.steps += g.n;
	out
}
@end
