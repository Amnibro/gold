	var clamped = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped at most ceiling count: ", clamped);
	g.steps += g.n + 1;
	out
}
@end
