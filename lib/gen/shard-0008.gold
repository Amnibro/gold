@entry 5e9df91083de70c4
kind: step
verb: rotate
noun: steps
modifier: in_place
context: math
phrase: rotate results in place by {k} steps
phrase: shift sequence entries in place by {k} offsets
slot: k int
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="rotated in place by 2 steps" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3 k=1
expect: => i=1 r=0.0 ok=true s="rotated in place by 1 steps" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let steps = ${k} % g.n;
	var shift = if steps < 0 { steps + g.n } else { steps };
	var tmp int[512] = [0; 512];
	for i in g.n { tmp[i] = g.res[i]; }
	for i in g.n {
		let dest = (i + shift) % g.n;
		g.res[dest] = tmp[i];
	}
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated in place by ", shift, " steps");
	out
}
@end
