@entry 179d3250723eb979
kind: step
verb: drop
noun: counter
modifier: times
context: math
phrase: drop elements from start of results {count} times
phrase: discard leading items bounded by count {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="remaining count: 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,6,7 count=1
expect: => i=2 r=0.0 ok=true s="remaining count: 2" errors=0 n=2 res=[6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var drop_n = c;
	if drop_n > g.n { drop_n = g.n; }
	for i in (g.n - drop_n) {
		g.res[i] = g.res[i + drop_n];
	}
	g.n -= drop_n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "remaining count: ", g.n);
