phrase: run recursive digit summation to root
phrase: compute digital root recursively from digits
test: input=987
expect: => i=6 r=0.0 ok=true s="digital root is 6 after 2 steps" errors=0 n=1 res=[6] cache=0 hits=0
test: input=49
expect: => i=4 r=0.0 ok=true s="digital root is 4 after 2 steps" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = v.i;
	if n < 0 {
		n = -n;
	}
	var steps = 0;
	while n >= 10 {
		var s = 0;
		while n > 0 {
			s += n % 10;
			n /= 10;
		}
		n = s;
		steps += 1;
	}
	gold_clear(g);
	gold_push(g, n);
	out.i = n;
	out.ok = true;
	out.s.clear();
	format(out.s, "digital root is ", n, " after ", steps, " steps");
	g.steps += steps + 1;
	out
}
@end
