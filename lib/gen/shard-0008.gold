expect: => i=24 r=0.0 ok=true s="scaled duplicate sum 24" errors=0 n=4 res=[4,4,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var dup_sum = 0;
	for i in g.n {
		var seen_before = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen_before = true;
				break;
			}
		}
		if seen_before {
			dup_sum += g.res[i];
		}
	}
	let result = dup_sum * mult;
	out.i = result;
	out.s.clear();
	format(out.s, "scaled duplicate sum ", result);
	g.steps += g.n + 1;
	out
}
@end
@entry 556e15e7c4aed5d5
kind: step
verb: limit
noun: gaps
modifier: at_most
context: transform
phrase: limit gaps between adjacent values to at most {maxgap}
phrase: cap step gaps between consecutive elements at {maxgap}
slot: maxgap int
test: list=10,30,35,70 maxgap=10
expect: => i=3 r=0.0 ok=true s="adjusted gaps 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,50,52 maxgap=20
expect: => i=2 r=0.0 ok=true s="adjusted gaps 2" errors=0 n=3 res=[5,25,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${maxgap};
	var adjusted = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
			adjusted++;
		} else if diff < -mg {
			g.res[i] = g.res[i - 1] - mg;
			adjusted++;
		}
		i++;
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted gaps ", adjusted);
	g.steps += g.n + 1;
	out
}
@end
