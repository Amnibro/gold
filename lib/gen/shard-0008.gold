	var less_count = 0;
	for k in g.n {
		if g.res[k] < p { less_count++; }
	}
	g.steps += g.n;
	out.i = less_count;
	out.s.clear();
	format(out.s, "partitioned around unique pivot with ", less_count, " smaller");
