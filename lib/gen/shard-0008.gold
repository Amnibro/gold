fn ${ID}_is_sq(x int) bool {
	if x < 0 { return false; }
	var i = 0;
	while i * i <= x {
		if i * i == x { return true; }
		i++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${ID}_is_sq(g.res[i]) {
			temp[count] = g.res[i];
			count++;
		}
		i--;
	}
	for k in count { g.res[k] = temp[k]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " squares");
	g.steps += count;
	out
}
@end
