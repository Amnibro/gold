fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${max_retries};
	var i = g.n - 1;
	var fixed = 0;
	while i > 0 {
		var r = 0;
		while g.res[i] < g.res[i - 1] && r < r_max {
			g.res[i] += 2;
			r++;
		}
		if g.res[i] >= g.res[i - 1] { fixed++; }
		i--;
	}
	g.steps += g.n;
	out.i = fixed;
	out.s.clear();
	format(out.s, "retried in reverse fixed ", fixed);
	out
}
@end
