fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] < g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted loop descending");
	out
}
