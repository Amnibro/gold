	let count = ${k};
	let cached_val, hit = gold_cache_get(g, count);
	if hit {
		out.i = cached_val;
		return out;
	}
	var sum = 0;
	let lim = if count > g.n { g.n } else { count };
	for i in lim { sum += g.res[i]; }
	gold_cache_put(g, count, sum);
	g.steps += lim;
	out.i = sum;
	out.s.clear();
	format(out.s, "computed prefix sum ", sum);
	out
}
@end
