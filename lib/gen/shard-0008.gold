fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_run = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var r = 0;
		while i < g.n && g.res[i] == x {
			r++;
			i++;
		}
		if r > max_run { max_run = r; }
	}
	gold_cache_put(g, 0, max_run);
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest run: ", max_run);
	out
}
@end
