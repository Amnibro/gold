code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 {
			pos = i;
			break;
		}
		i += 1;
	}
	if pos >= 0 {
		g.n = pos;
		out.i = pos;
		out.ok = true;
		out.s.clear();
		format(out.s, "split loop at index ", pos);
	} else {
		out.i = g.n;
		out.ok = false;
		out.s.clear();
		format(out.s, "no split found in ", g.n, " items");
	}
	g.steps += g.n;
	out
}
@end
@entry 1c4099f3559d465f
kind: step
verb: count
noun: steps
modifier: until
context: transform
phrase: count transformation steps until target {target}
phrase: count steps until reaching target {target}
slot: target int
test: list=1,2,5,10 target=5
expect: => i=3 r=0.0 ok=true s="reached target in 3 steps" errors=0 n=4 res=[1,2,5,10] cache=0 hits=0
test: list=1,2,3 target=5
expect: => i=3 r=0.0 ok=true s="target not reached" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var steps = 0;
	var found = false;
	while steps < g.n && !found {
		if g.res[steps] == tgt {
			found = true;
		}
		steps++;
	}
	out.i = steps;
	out.s.clear();
	if found {
		format(out.s, "reached target in ", steps, " steps");
	} else {
		format(out.s, "target not reached");
	}
	g.steps += steps;
	out
}
@end
