fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var cur_max = -1000000;
	var i = 0;
	while i < g.n {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
		g.res[kept] = cur_max;
		kept++;
		i += 2;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " running maximums");
	out
}
@end
