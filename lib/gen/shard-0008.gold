code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_retries = ${max_r};
	var matches = 0;
	var retries = max_retries;
	for i in v.s.len {
		if v.s[i] == tgt {
			matches++;
		} else {
			if retries > 0 {
				retries--;
			} else {
				break;
			}
		}
	}
	out.i = matches;
	out.s.clear();
	format(out.s, "letter count with retry: ", matches);
	g.steps += v.s.len + 1;
	out
}
@end
