	let k = ${key};
	gold_cache_put(g, 10, 100);
	var found = false;
	var res_val = 0;
	for i in g.n {
		if g.res[i] == k {
			let cv, ok = gold_cache_get(g, k);
			if ok {
				found = true;
				res_val = cv;
			}
		}
	}
	out.i = res_val;
	out.s.clear();
	if found {
		format(out.s, "found cached value");
	} else {
		format(out.s, "not in cache");
	}
	g.steps += g.n;
	out
}
@end
