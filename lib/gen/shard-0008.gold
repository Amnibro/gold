fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	// sort in place
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var max_gap = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		if gap > max_gap {
			max_gap = gap;
		}
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max sorted space ", max_gap);
	g.steps += g.n * 2;
	out
}
@end
@entry 5d826fcd7a7789d4
kind: step
verb: pair
noun: total
modifier: until
context: filter
phrase: pair adjacent elements until sum exceeds {cap}
phrase: combine pairwise totals stopping before limit {cap}
slot: cap int
test: list=3,5,2,8,4 cap=10
expect: => i=8 r=0.0 ok=true s="paired total 8" errors=0 n=1 res=[8] cache=0 hits=0
test: list=10,20,30 cap=5
