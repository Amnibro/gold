@entry e7848d235858839b
kind: step
verb: group
noun: runs
modifier: at_least
context: filter
phrase: group consecutive equal runs with length at least {min_len}
phrase: retain items belonging to uniform runs of at least {min_len} elements
slot: min_len int
test: list=1,1,1,2,3,3,4 min_len=2
expect: => i=5 r=0.0 ok=true s="grouped runs at least 5" errors=0 n=5 res=[1,1,1,3,3] cache=0 hits=0
test: list=1,2,3,4 min_len=2
expect: => i=0 r=0.0 ok=true s="grouped runs at least 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let run_len = j - i;
		if run_len >= ml {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped runs at least ", kept);
	g.steps += kept + 1;
	out
}
@end
