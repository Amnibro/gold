fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_merges};
	var merges = 0;
	var merged int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		if merges < limit && i + 1 < g.n && ${p}(g.res[i]) && ${p}(g.res[i + 1]) {
			merged[count] = g.res[i] + g.res[i + 1];
			count++;
			merges++;
			i += 2;
		} else {
			merged[count] = g.res[i];
			count++;
			i++;
		}
	}
	gold_clear(g);
	for k in count { gold_push(g, merged[k]); }
	g.steps += count;
	out.i = merges;
	out.s.clear();
