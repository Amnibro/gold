	var last_sq = -1;
	for i in g.n {
		if core_is_square(g.res[i]) {
			if last_sq >= 0 && g.res[i] < last_sq {
				is_sorted = false;
				gold_fail(g, "squares not sorted");
				break;
			}
			last_sq = g.res[i];
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, if is_sorted { "squares sorted" } else { "squares unsorted" });
	out
}
@end
