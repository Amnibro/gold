code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for step progression");
		out.ok = false;
		return out;
	}
	let diff = g.res[g.n - 1] - g.res[g.n - 2];
	let nxt = g.res[g.n - 1] + diff;
	gold_push(g, nxt);
	g.steps += 1;
	out.i = nxt;
	out.s.clear();
	format(out.s, "safely added step to ", nxt);
	out
}
@end
@entry 859a6d9fbb5c884e
kind: step
verb: fold
noun: streak
modifier: times
context: list
phrase: fold longest streak sum repeated {times} times
phrase: sum ascending streak entries repeated {times} times
slot: times int
test: list=10,2,4,6,1 times=2
expect: => i=12 r=0.0 ok=true s="folded streak 12 repeated 2 times" errors=0 n=2 res=[12,12] cache=0 hits=0
test: list=5,7 times=1
expect: => i=12 r=0.0 ok=true s="folded streak 12 repeated 1 times" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 { return out; }
	var best_len = 1;
	var best_sum = g.res[0];
	var cur_len = 1;
	var cur_sum = g.res[0];
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_len++;
			cur_sum += g.res[i];
			if cur_len > best_len {
				best_len = cur_len;
				best_sum = cur_sum;
			}
		} else {
			cur_len = 1;
			cur_sum = g.res[i];
		}
	}
	gold_clear(g);
	for i in t { gold_push(g, best_sum); }
	g.steps += g.n + t;
	out.i = best_sum;
	out.s.clear();
	format(out.s, "folded streak ", best_sum, " repeated ", t, " times");
	out
}
@end
