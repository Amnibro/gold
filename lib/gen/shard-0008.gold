phrase: execute function {f} repeatedly while predicate {p} holds
slot: f fn
slot: p pred
test: list=1 f=double p=under_10
expect: => i=4 r=0.0 ok=true s="function retried iterations: 4" errors=0 n=1 res=[16] cache=0 hits=0
test: list=2 f=double p=is_even
expect: => i=10 r=0.0 ok=false s="function retry exceeded iteration limit" errors=1 n=1 res=[2048] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	if g.n > 0 {
		while ${p}(g.res[0]) {
			g.res[0] = ${f}(g.res[0]);
			count++;
			if count >= 10 {
				gold_fail(g, "retry loop exceeded iteration limit");
				out.ok = false;
				break;
			}
		}
	}
	out.i = count;
	out.s.clear();
	if out.ok {
		format(out.s, "function retried iterations: ", count);
	} else {
		out.s.append("function retry exceeded iteration limit");
	}
	g.steps += count + 1;
	out
}
@end
