expect: => i=3 r=0.0 ok=true s="grouped range buckets 3" errors=0 n=3 res=[10,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${limit};
	var groups int[512] = [0; 512];
	var gn = 0;
	var curr_sum = 0;
	for i in g.n {
		curr_sum += g.res[i];
		if curr_sum >= th {
			groups[gn] = curr_sum;
			gn++;
			curr_sum = 0;
		}
	}
	if curr_sum > 0 {
		groups[gn] = curr_sum;
		gn++;
	}
	for i in gn {
		g.res[i] = groups[i];
	}
	g.n = gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "grouped range buckets ", gn);
	g.steps += g.n + 2;
	out
}
@end
