		out.i = 0;
		out.ok = true;
		return out;
	}
	var i = 0;
	while i < v.s.len {
		var chunk_len = step;
		if i + chunk_len > v.s.len {
			chunk_len = v.s.len - i;
		}
		gold_push(g, chunk_len);
		i += step;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "split into ", g.n, " chunks of at most ", step);
	g.steps += g.n;
	out
}
