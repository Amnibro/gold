expect: => i=2 r=0.0 ok=true s="cached rolling window sums: 2" errors=0 n=2 res=[60,90] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var count = 0;
	if ws > 0 && g.n >= ws {
		var i = 0;
		while i + ws <= g.n {
			var w_sum = 0;
			for j in ws { w_sum += g.res[i + j]; }
			gold_cache_put(g, i, w_sum);
			g.res[count] = w_sum;
			count++;
			i++;
		}
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached rolling window sums: ", count);
	g.steps += g.n + 1;
	out
}
@end
