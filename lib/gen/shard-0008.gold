code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty sequence");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	i = 0;
	while i < g.n {
		var diff = g.res[i] - avg;
		if diff < 0 {
			diff = -diff;
		}
		g.res[i] = diff;
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "split ", g.n, " items into absolute deviations");
	g.steps += g.n;
	out
}
@end
