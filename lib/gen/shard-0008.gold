code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_cost};
	var groups = 0;
	var cur_sum = 0;
	var kept = 0;
	for k in g.n {
		cur_sum += g.res[k];
		if cur_sum >= target {
			g.res[kept] = cur_sum;
			kept++;
			groups++;
			cur_sum = 0;
		}
	}
	if cur_sum > 0 {
		g.res[kept] = cur_sum;
		kept++;
		groups++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped into ", groups, " batches");
	out
}
@end
