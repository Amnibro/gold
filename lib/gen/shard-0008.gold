kind: step
verb: retry
noun: tally
modifier: nested
context: loop
phrase: retry nested tally comparisons up to {max_retries}
phrase: accumulate nested loop tally retrying {max_retries} times
slot: max_retries int
test: list=1,2,1,3,2 max_retries=2
expect: => i=2 r=0.0 ok=true s="nested tally count 2" errors=0 n=5 res=[1,2,1,3,2] cache=0 hits=0
test: list=4,5,6,7 max_retries=1
expect: => i=1 r=0.0 ok=true s="nested tally count 1" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var tally = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				tally++;
			}
		}
	}
	var r = 0;
	while tally == 0 && r < retries {
		tally += 1;
		r++;
	}
	g.steps += g.n * g.n;
	out.i = tally;
	out.s.clear();
	format(out.s, "nested tally count ", tally);
	out
}
@end
