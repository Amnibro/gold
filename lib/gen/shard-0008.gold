@entry 216551fe27702718
kind: step
verb: repeat
noun: vowels
modifier: sorted
context: core
phrase: repeat vowels in text sorted alphabetically
phrase: sort extracted vowel characters from text
test: text="education"
expect: => i=5 r=0.0 ok=true s="aeiou" errors=0 n=0 res=[] cache=0 hits=0
test: text="amni"
expect: => i=2 r=0.0 ok=true s="ai" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels: byte[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		let is_v = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		            b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U');
		if is_v { vowels.push(b); }
	}
	var i = 0;
	while i < vowels.len {
		var j = i + 1;
		while j < vowels.len {
			if vowels[i] > vowels[j] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	for b in vowels { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
@entry cd3fc0dc9a82f742
kind: step
verb: rotate
noun: streak
modifier: with_retry
context: core
phrase: rotate streak elements with retry attempts {retries}
phrase: cyclically rotate streak elements using retry count {retries}
slot: retries int
test: list=1,2,3,4,5 retries=2
expect: => i=5 r=0.0 ok=true s="rotated streak count: 5" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 retries=1
expect: => i=3 r=0.0 ok=true s="rotated streak count: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n > 1 {
		let shift = r % g.n;
		var temp: int[512] = [0; 512];
		for i in g.n {
			let new_idx = (i + shift) % g.n;
			temp[new_idx] = g.res[i];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated streak count: ", g.n);
	g.steps += g.n + 1;
	out
}
@end
