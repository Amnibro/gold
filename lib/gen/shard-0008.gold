code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	fn is_sq(n int) bool {
		if n < 0 { return false; }
		var r = 0;
		while r * r < n { r++; }
		r * r == n
	}
	var kept = 0;
	var run = 0;
	for i in g.n {
		let x = g.res[i];
		if is_sq(x) {
			run += x;
			g.res[kept] = run;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * 2 + 3;
	out.i = kept;
	out.s.clear();
	format(out.s, "running squares kept ", kept);
	out
}
@end
