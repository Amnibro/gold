		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if !is_sq {
			gold_fail(g, "element is not a perfect square");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: not a square");
			return out;
		}
		if k > 0 && g.res[k] < g.res[k - 1] {
			gold_fail(g, "squares are not sorted");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: unsorted squares");
			return out;
		}
	}
	let first = g.res[0];
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " sorted squares");
	out
}
@end
