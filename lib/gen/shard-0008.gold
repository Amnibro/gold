	var out = v;
	let lo = ${low};
	let hi = ${high};
	let f = ${factor};
	var scaled = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			g.res[k] = g.res[k] * f;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out
}
