fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${thresh};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	if sum > thresh {
		gold_fail(g, "sorted tally exceeded threshold");
		out.ok = false;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "checked sorted tally: ", sum);
	g.steps += g.n + 1;
	out
}
@end
