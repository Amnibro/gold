@entry ee9ae96425edece5
kind: step
verb: retry
noun: cache
modifier: until
context: list
phrase: retry cache lookups using {f} until {target_hits} hits
phrase: populate cache with {f} until {target_hits} matches
phrase: lookup cache values with {f} targeting {target_hits} hits
slot: f fn
slot: target_hits int
test: list=5,5,5,5 f=double target_hits=2
expect: => i=2 r=0.0 ok=true s="gained 2 cache hits" errors=0 n=4 res=[10,10,10,5] cache=1 hits=2
test: list=2,3,4 f=inc target_hits=1
expect: => i=0 r=0.0 ok=true s="gained 0 cache hits" errors=0 n=3 res=[3,4,5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_hits};
	var initial_hits = g.hits;
	for i in g.n {
		let key = g.res[i];
		let val, ok = gold_cache_get(g, key);
		if ok {
			g.res[i] = val;
		} else {
			let computed = ${f}(key);
			gold_cache_put(g, key, computed);
			g.res[i] = computed;
		}
		if (g.hits - initial_hits) >= target { break; }
	}
	g.steps += g.n;
	let new_hits = g.hits - initial_hits;
	out.i = new_hits;
	out.s.clear();
	format(out.s, "gained ", new_hits, " cache hits");
	out
}
@end
