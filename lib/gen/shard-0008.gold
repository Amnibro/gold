fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	let mid = g.n / 2;
	for k in mid..g.n - 1 {
		g.res[k] = g.res[k + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pruned middle element remaining count: ", g.n);
	out
}
@end
