code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("unique: ");
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			if count > 0 { out.s.append(", "); }
			format(out.s, val);
			count++;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out
}
@end
