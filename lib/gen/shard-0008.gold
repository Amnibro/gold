	let sv = ${stop_val};
	var kept = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == sv { break; }
		if kept == 0 || g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined runs until count: ", kept);
	g.steps += g.n + 1;
	out
}
