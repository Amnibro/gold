@entry ccc9f4a59ffc02cf
kind: step
verb: split
noun: pairs
modifier: at_most
context: sort
phrase: count adjacent pairs with difference at most {max_diff}
phrase: evaluate consecutive pairs within gap {max_diff}
slot: max_diff int
test: list=2,5,6,10,12 max_diff=3
expect: => i=3 r=0.0 ok=true s="found 3 close pairs" errors=0 n=5 res=[2,5,6,10,12] cache=0 hits=0
