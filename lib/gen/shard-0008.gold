fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cut};
	if c < 0 || c * 2 >= g.n { return out; }
	let end = g.n - c;
	for i in c..end {
		for j in (i + 1)..end {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let len = end - c;
	g.steps += len * len;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted nested interior count: ", len);
	out
}
@end
