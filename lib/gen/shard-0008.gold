@entry 7904b8317cb9bd03
kind: step
verb: split
noun: spaces
modifier: with_retry
context: sort
phrase: split sorted items at first spacing exceeding {min_gap}
phrase: partition ordered list where consecutive gap exceeds {min_gap}
slot: min_gap int
test: list=10,12,14,25,30 min_gap=5
expect: => i=3 r=0.0 ok=true s="partitioned at index 3" errors=0 n=3 res=[10,12,14] cache=0 hits=0
test: list=1,2,3 min_gap=10
expect: => i=3 r=0.0 ok=true s="partitioned at index 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_lim = ${min_gap};
	var split_at = g.n;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k + 1] - g.res[k] > g_lim {
				split_at = k + 1;
				break;
			}
		}
	}
	g.n = split_at;
	g.steps += g.n;
	out.i = split_at;
	out.s.clear();
	format(out.s, "partitioned at index ", split_at);
	out
}
@end
@entry 0e2796a5bf0d09ff
kind: step
verb: normalize
noun: budget
modifier: pairwise
context: sort
phrase: normalize pairwise differences capping at budget {budget}
phrase: clamp consecutive sorted gaps to maximum budget {budget}
slot: budget int
test: list=10,18,30 budget=5
expect: => i=2 r=0.0 ok=true s="adjusted 2 pairwise gaps" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,2,3 budget=10
expect: => i=0 r=0.0 ok=true s="adjusted 0 pairwise gaps" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var adjusted = 0;
	if g.n > 1 {
		for k in 1..g.n {
			let diff = g.res[k] - g.res[k - 1];
			if diff > b {
				g.res[k] = g.res[k - 1] + b;
				adjusted++;
			}
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted ", adjusted, " pairwise gaps");
	out
}
@end
@entry 6ce1cc6b4bc27e7c
kind: step
verb: drop
noun: average
modifier: at_least
context: sort
phrase: drop sorted elements with value at least list average
phrase: remove ordered items exceeding or equal to average
test: list=2,4,6,8,10
expect: => i=2 r=0.0 ok=true s="retained 2 items below average 6" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,10,10
expect: => i=0 r=0.0 ok=true s="retained 0 items below average 10" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var kept = 0;
	for k in g.n {
		if g.res[k] < avg {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items below average ", avg);
	out
}
@end
@entry 19cc76d3252ad7fa
kind: step
verb: collect
noun: evens
modifier: between
context: sort
phrase: collect sorted even numbers bounded between {low} to {high}
phrase: extract ordered even elements within range {low} to {high}
slot: low int
slot: high int
test: list=1,2,4,7,8,11,14 low=3 high=9
expect: => i=2 r=0.0 ok=true s="collected 2 bounded evens" errors=0 n=2 res=[4,8] cache=0 hits=0
test: list=1,3,5 low=1 high=10
expect: => i=0 r=0.0 ok=true s="collected 0 bounded evens" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 && x >= l && x <= h {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " bounded evens");
	out
}
@end
