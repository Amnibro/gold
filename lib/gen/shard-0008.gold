expect: => i=3 r=0.0 ok=true s="rotated 3 alternate series items" errors=0 n=5 res=[50,2,10,4,30] cache=0 hits=0
test: list=1,100,2,200
expect: => i=2 r=0.0 ok=true s="rotated 2 alternate series items" errors=0 n=4 res=[2,100,1,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		g.steps += 1;
		return out;
	}
	var count = 0;
	var last_idx = 0;
	for i in g.n {
		if i % 2 == 0 {
			count++;
			last_idx = i;
		}
	}
	let last_val = g.res[last_idx];
	var prev = last_val;
	for i in g.n {
		if i % 2 == 0 {
			let tmp = g.res[i];
			g.res[i] = prev;
			prev = tmp;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated ", count, " alternate series items");
	out
}
@end
