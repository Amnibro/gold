code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two elements to pair range start");
		out.ok = false;
	} else {
		let combined = g.res[0] + g.res[1];
		g.res[0] = combined;
		var k = 1;
		while k + 1 < g.n {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.n--;
	}
	out.i = g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "paired leading elements: ", g.res[0]);
	} else {
		out.s.append("insufficient elements for leading pair");
	}
	g.steps += g.n + 1;
	out
}
@end
