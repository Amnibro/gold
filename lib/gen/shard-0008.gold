			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += count + 3;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed prefix length ", count);
	out
}
@end
