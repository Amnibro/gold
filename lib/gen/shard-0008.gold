test: list=1,1,1,2,2,3
expect: => i=3 r=0.0 ok=true s="found 3 distinct streaks" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,6,7,7,7
expect: => i=3 r=0.0 ok=true s="found 3 distinct streaks" errors=0 n=3 res=[2,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var streaks: int[512] = [0; 512];
	var sn = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			streaks[sn] = cur_len;
			sn++;
			cur_len = 1;
		}
	}
	streaks[sn] = cur_len;
	sn++;
	for k in sn { g.res[k] = streaks[k]; }
	g.n = sn;
	g.steps += sn;
	out.i = sn;
	out.s.clear();
	format(out.s, "found ", sn, " distinct streaks");
	out
}
@end
