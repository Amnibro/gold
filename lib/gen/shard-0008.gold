@entry 9a4a3ceb0de38407
kind: step
verb: measure
noun: middle
modifier: unique
context: loop
phrase: measure count of unique middle elements
phrase: find distinct values within middle loop section
test: list=10,2,2,3,4,4,50
expect: => i=3 r=0.0 ok=true s="measured 3 unique middle items" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=1,5,5,5,9
expect: => i=1 r=0.0 ok=true s="measured 1 unique middle items" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		return out;
	}
	let lo = g.n / 4;
	let hi = g.n - lo;
	var kept = 0;
	for i in lo..hi {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += hi - lo;
	out.i = kept;
	out.s.clear();
	format(out.s, "measured ", kept, " unique middle items");
	out
}
@end
