	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list average: 0");
		return out;
	}
	var total = 0;
	var count = 0;
	for i in g.n {
		if i % 2 == 0 {
			total += g.res[i];
			count++;
		}
	}
	let avg = total / count;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "alternate average: ", avg, " across ", count, " items");
	out
}
