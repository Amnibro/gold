expect: => i=30 r=0.0 ok=true s="cached first duplicate: 30" errors=0 n=6 res=[10,20,30,40,30,50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var dup = 0;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] {
				dup = g.res[i];
				found = true;
				break;
			}
		}
		if found { break; }
	}
	if found {
		gold_cache_put(g, 0, dup);
		out.i = dup;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "cached first duplicate: ", out.i);
	g.steps += g.n;
	out
}
@end
