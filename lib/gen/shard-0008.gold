fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_s};
	var run = 0;
	var kept = 0;
	while kept < g.n && run + g.res[kept] <= limit {
		run += g.res[kept];
		kept++;
	}
	g.n = kept;
	g.steps += kept + 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected running prefix count ", kept);
	out
}
