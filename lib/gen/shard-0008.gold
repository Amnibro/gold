@entry 4fa1bd52cef78301
kind: step
verb: fill
noun: pairs
modifier: any
context: stats
phrase: fill adjacent pairs with average when gap exceeds {gap}
phrase: interpolate between pairs exceeding difference {gap}
phrase: insert midpoint for any pair with gap over {gap}
slot: gap int
test: list=10,40,50 gap=20
expect: => i=1 r=0.0 ok=true s="inserted 1 midpoints" errors=0 n=4 res=[10,25,40,50] cache=0 hits=0
test: list=5,15,30 gap=12
expect: => i=1 r=0.0 ok=true s="inserted 1 midpoints" errors=0 n=4 res=[5,15,22,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${gap};
	var temp: int[512] = [0; 512];
	var tn = 0;
	for k in g.n {
		if k > 0 && tn < 510 {
			let diff = if g.res[k] > g.res[k - 1] { g.res[k] - g.res[k - 1] } else { g.res[k - 1] - g.res[k] };
			if diff > threshold {
				temp[tn] = (g.res[k] + g.res[k - 1]) / 2;
				tn++;
			}
		}
		if tn < 512 {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	let inserted = tn - g.n;
	g.n = tn;
	g.steps += tn;
	out.i = inserted;
	out.s.clear();
	format(out.s, "inserted ", inserted, " midpoints");
	out
}
@end
