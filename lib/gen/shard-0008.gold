fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = v.i;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap > max_gap {
			g.res[i] = g.res[i - 1] + max_gap;
		}
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized gaps across ", g.n, " items to at most ", max_gap);
	g.steps += g.n;
	out
}
@end
