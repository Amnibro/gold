@entry 9e062bb1edb687e1
kind: step
verb: filter
noun: spaces
modifier: unique
context: compare
phrase: filter spaces unique comparison intervals above {gap}
phrase: isolate unique comparison spacing distances above {gap}
slot: gap int
test: list=10,25,30,50 gap=8
expect: => i=2 r=0.0 ok=true s="filtered unique gap spaces: 2" errors=0 n=2 res=[15,20] cache=0 hits=0
test: list=5,20,30,60 gap=12
expect: => i=2 r=0.0 ok=true s="filtered unique gap spaces: 2" errors=0 n=2 res=[15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	if g.n < 2 { return out; }
	var uniq_gaps int[64] = [0; 64];
	var count = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff > min_gap {
			var exists = false;
			for j in count {
				if uniq_gaps[j] == diff {
					exists = true;
					break;
				}
			}
			if !exists && count < 64 {
				uniq_gaps[count] = diff;
				count++;
			}
		}
	}
	gold_clear(g);
	for k in count { gold_push(g, uniq_gaps[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered unique gap spaces: ", count);
	out
}
@end
