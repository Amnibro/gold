kind: step
verb: run
noun: average
modifier: recursively
context: transform
phrase: run average recursively smoothing across depth {depth}
phrase: recursively smooth list with running average depth {depth}
slot: depth int
test: list=10,20,30,40 depth=2
expect: => i=2 r=0.0 ok=true s="recursive passes 2" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=4,8,16 depth=1
expect: => i=1 r=0.0 ok=true s="recursive passes 1" errors=0 n=2 res=[6,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var passes = 0;
	while passes < d && g.n > 1 {
		for i in g.n - 1 {
			g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
		}
		g.n--;
		passes++;
	}
	out.i = passes;
	out.s.clear();
	format(out.s, "recursive passes ", passes);
	g.steps += passes + g.n;
	out
}
@end
