@entry 10176d5067001a87
kind: step
verb: check
noun: checkpoint
modifier: with_retry
context: loop
phrase: check checkpoint state with retry limit {retries}
phrase: verify loop checkpoint status retrying {retries} times
slot: retries int
test: list=5,-2,8 retries=3
expect: => i=1 r=0.0 ok=true s="checkpoint verified fixed 1" errors=0 n=3 res=[5,0,8] cache=0 hits=0
test: list=10,-10,4 retries=2
expect: => i=0 r=0.0 ok=false s="checkpoint verified fixed 0" errors=1 n=3 res=[10,-8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var fixed = 0;
	for i in g.n {
		if g.res[i] < 0 {
			var r = 0;
			while g.res[i] < 0 && r < r_max {
				g.res[i] += 1;
				r++;
			}
			if g.res[i] >= 0 {
				fixed++;
			} else {
				gold_fail(g, "checkpoint failed after retries");
			}
		}
	}
	g.steps += g.n;
	out.i = fixed;
	out.ok = (g.errors == 0);
	out.s.clear();
	format(out.s, "checkpoint verified fixed ", fixed);
	out
}
@end
