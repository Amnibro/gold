noun: loop
modifier: running
context: math
phrase: split running sequence when value drops below previous
phrase: divide running items into segments on decrease
test: list=1,2,3,1,2
expect: => i=1 r=0.0 ok=true s="running splits: 1" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=5,6,2,3,4
expect: => i=1 r=0.0 ok=true s="running splits: 1" errors=0 n=5 res=[5,6,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var splits = 0;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] < g.res[i - 1] {
				splits++;
			}
		}
	}
	out.i = splits;
	out.s.clear();
	format(out.s, "running splits: ", splits);
	g.steps += g.n + 1;
	out
}
@end
