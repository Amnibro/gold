		if g.res[i] >= min_val {
			found = true;
			matched = g.res[i];
			break;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if found {
		out.ok = true;
		out.i = matched;
		format(out.s, "validated element ", matched, " meets minimum ", min_val);
	} else {
		gold_fail(g, "no element meets minimum");
		out.ok = false;
		out.i = 0;
		format(out.s, "no element meets minimum ", min_val);
	}
	out
}
