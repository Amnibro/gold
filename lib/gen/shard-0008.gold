@entry 4feb42ce4e07dabe
kind: step
verb: reverse
noun: primes
modifier: with_cache
context: search
phrase: reverse positions of prime values caching non prime elements
phrase: reverse prime numbers searching results with prime cache
phrase: search results reversing prime elements using cached positions
test: list=4,3,8,5,7,12
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[4,7,8,5,3,12] cache=0 hits=0
test: list=2,9,11,15
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[11,9,2,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_idx int[64] = [0; 64];
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && count < 64 {
				p_idx[count] = k as int;
				count++;
			}
		}
	}
	var left = 0;
	var right = count - 1;
	while left < right {
		let il = p_idx[left];
		let ir = p_idx[right];
		let tmp = g.res[il];
		g.res[il] = g.res[ir];
		g.res[ir] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = count;
	out
}
@end
