@entry 4c96b403e9e706c6
kind: step
verb: drop
noun: squares
modifier: every_other
context: list
phrase: drop perfect squares located at every other index
phrase: remove square values found on alternate positions
test: list=4,3,9,5,16
expect: => i=3 r=0.0 ok=true s="dropped alternate squares: 3" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=1,2,4,8,9
expect: => i=3 r=0.0 ok=true s="dropped alternate squares: 3" errors=0 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if i % 2 == 0 && x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			dropped++;
		} else {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.n = new_n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped alternate squares: ", dropped);
	g.steps += g.n;
	out
}
@end
