fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[26] = [-1; 26];
	for k in out.s.len {
		let c = out.s[k];
		if c >= 'a' && c <= 'z' {
			let idx = (c - 'a') as int;
			if seen[idx] < 0 {
				seen[idx] = k as int;
				gold_push(g, k as int);
			}
		}
	}
	g.steps += out.s.len;
	out.i = g.n;
	out
}
