code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${stop_val};
	var idx = g.n;
	for i in g.n {
		if g.res[i] == sv {
			idx = i;
			break;
		}
	}
	g.n = idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "returned items until marker: ", idx);
	g.steps += g.n + 1;
	out
}
@end
