@entry 59fcbc3e6e69a12d
kind: step
verb: reverse
noun: total
modifier: any
context: error
phrase: reverse total elements raising error on negative sum
phrase: invert list order checking total sum negativity
test: list=10,20,30
expect: => i=60 r=0.0 ok=true s="reversed total sum: 60" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test: list=-50,10,-20
expect: => i=-60 r=0.0 ok=false s="negative total sum on reverse: -60" errors=1 n=3 res=[-20,10,-50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	var l = 0;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	if sum < 0 {
		gold_fail(g, "negative sum encountered during total reverse");
		out.ok = false;
	}
	out.i = sum;
	out.s.clear();
	if out.ok {
		format(out.s, "reversed total sum: ", sum);
	} else {
		format(out.s, "negative total sum on reverse: ", sum);
	}
	g.steps += g.n + 1;
	out
}
@end
