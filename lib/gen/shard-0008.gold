@entry 172b7f06c4839cdb
kind: step
verb: group
noun: range
modifier: last
context: search
phrase: group search items within range span {span} from last
phrase: filter search values within span {span} of trailing element
slot: span int
test: list=10,25,12,30 span=5
expect: => i=2 r=0.0 ok=true s="grouped 2 items near last" errors=0 n=2 res=[25,30] cache=0 hits=0
test: list=1,100,200 span=10
expect: => i=1 r=0.0 ok=true s="grouped 1 items near last" errors=0 n=1 res=[200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	var kept = 0;
	for k in g.n {
		let diff = g.res[k] - last_val;
		let dist = if diff < 0 { -diff } else { diff };
		if dist <= sp {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " items near last");
	out
}
@end
