fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_dups};
	var dup_count = 0;
	var i = 0;
	while i + 1 < g.n && dup_count < lim {
		if g.res[i] == g.res[i + 1] {
			g.res[i] = -g.res[i];
			dup_count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "marked ", dup_count, " duplicate pairs");
	out
}
