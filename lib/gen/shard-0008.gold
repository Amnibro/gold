code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${target};
	var found = 0;
	if g.n > 0 {
		var cur_val = g.res[0];
		var cur_count = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == cur_val {
				cur_count++;
			} else {
				if cur_count >= req {
					g.res[found] = cur_val;
					found++;
				}
				cur_val = g.res[i];
				cur_count = 1;
			}
			i++;
		}
		if cur_count >= req {
			g.res[found] = cur_val;
			found++;
		}
	}
	g.n = found;
	g.steps += g.n + 3;
	out.i = found;
	out.s.clear();
	format(out.s, "selected streaks matching count ", found);
	out
}
@end
