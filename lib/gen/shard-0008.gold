@entry 9c7ab15ce267d11d
kind: step
verb: scan
noun: histogram
modifier: in_reverse
context: compare
phrase: scan histogram bins backwards in reverse order
phrase: inspect frequency counts comparing in reverse
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="scanned 3 histogram bins in reverse" errors=0 n=6 res=[3,3,2,2,1,1] cache=0 hits=0
test: list=5,5,8,9,9
expect: => i=3 r=0.0 ok=true s="scanned 3 histogram bins in reverse" errors=0 n=6 res=[9,2,8,1,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp_v int[512] = [0; 512];
	var temp_c int[512] = [0; 512];
	var bins = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var found = -1;
		for j in bins {
			if temp_v[j] == x { found = j; break; }
		}
		if found >= 0 {
			temp_c[found]++;
		} else {
			temp_v[bins] = x;
			temp_c[bins] = 1;
			bins++;
		}
		i--;
	}
	gold_clear(g);
	for j in bins {
		gold_push(g, temp_v[j]);
		gold_push(g, temp_c[j]);
	}
	g.steps += bins;
	out.i = bins;
	out.s.clear();
	format(out.s, "scanned ", bins, " histogram bins in reverse");
	out
}
@end
@entry 15a0db023f9e8ec6
kind: step
verb: find
noun: range
modifier: between
context: stats
phrase: find sample range between index {start} to {stop}
phrase: measure interval range between bounds {start} through {stop}
phrase: compute span between indices {start} to {stop}
slot: start int
slot: stop int
test: list=10,40,25,80,15 start=1 stop=3
expect: => i=55 r=0.0 ok=true s="range span 55" errors=0 n=5 res=[10,40,25,80,15] cache=0 hits=0
test: list=5,12,3,9,18 start=0 stop=2
expect: => i=9 r=0.0 ok=true s="range span 9" errors=0 n=5 res=[5,12,3,9,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s0 = ${start};
	var s1 = ${stop};
	if s0 < 0 { s0 = 0; }
	if s1 >= g.n { s1 = g.n - 1; }
	if s0 > s1 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var mn = g.res[s0];
	var mx = g.res[s0];
	for k in s0..(s1 + 1) {
		if g.res[k] < mn { mn = g.res[k]; }
		if g.res[k] > mx { mx = g.res[k]; }
	}
	let span = mx - mn;
	g.steps += s1 - s0 + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "range span ", span);
	out
}
@end
