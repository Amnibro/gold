@entry d924b48ffcc7f8aa
kind: step
verb: retry
noun: condition
modifier: recursively
context: cache
phrase: retry cache query recursively until condition {p}
phrase: follow recursive cached links until predicate {p}
slot: p pred
test: list=1,2,3,4 p=is_even
expect: => i=2 r=0.0 ok=true s="recursive cache condition reached: 2" errors=0 n=4 res=[1,2,3,4] cache=3 hits=1
test: list=2,3,5 p=is_odd
expect: => i=3 r=0.0 ok=true s="recursive cache condition reached: 3" errors=0 n=3 res=[2,3,5] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		gold_cache_put(g, g.res[i], g.res[i + 1]);
		i++;
	}
	var cur = if g.n > 0 { g.res[0] } else { 0 };
	var steps = 0;
	while steps < 10 {
		if ${p}(cur) { break; }
		let nxt, ok = gold_cache_get(g, cur);
		if !ok { break; }
		cur = nxt;
		steps++;
	}
	out.i = cur;
	out.s.clear();
	format(out.s, "recursive cache condition reached: ", cur);
	g.steps += steps + 1;
	out
}
@end
