code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var kept = 0;
	if g.n > 0 {
		kept = 1;
		var last_val = g.res[0];
		var k = 1;
		while k < g.n {
			if g.res[k] - last_val >= mg {
				g.res[kept] = g.res[k];
				last_val = g.res[k];
				kept++;
			}
			k++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked sorted gaps kept: ", kept);
	g.steps += g.n + 1;
	out
}
@end
