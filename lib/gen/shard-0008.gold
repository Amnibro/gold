fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < max_c {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped numbers to ", kept, " items");
	out
}
@end
