@entry 8e3706cc2eab5f8c
kind: step
verb: retry
noun: primes
modifier: at_least
context: core
phrase: retry primes counting at least {req}
phrase: count prime numbers verifying minimum {req}
slot: req int
test: list=2,3,5,7,4 req=3
expect: => i=4 r=0.0 ok=true s="retried primes count 4" errors=0 n=5 res=[2,3,5,7,4] cache=0 hits=0
test: list=4,6,8,9 req=1
expect: => i=0 r=0.0 ok=false s="retried primes count 0" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${req};
	fn is_p(n int) bool {
		if n < 2 { return false; }
		var d = 2;
		while d * d <= n {
			if n % d == 0 { return false; }
			d++;
		}
		true
	}
	var count = 0;
	for i in g.n {
		if is_p(g.res[i]) { count++; }
	}
	let passes = count >= target;
	g.steps += g.n + 2;
	out.ok = passes;
	out.i = count;
	out.s.clear();
	format(out.s, "retried primes count ", count);
	out
}
@end
