code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let half = g.n / 2;
	var left = 0;
	var right = half - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	var sum = 0;
	for i in half {
		sum += g.res[i];
	}
	g.steps += g.n + 3;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed head sum ", sum);
	out
}
@end
