code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == tgt || g.res[i + 1] == tgt {
			break;
		}
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped history count ", swaps);
	out
}
@end
