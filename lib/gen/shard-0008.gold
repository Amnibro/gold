@entry 6a1f81704901ddb4
kind: step
verb: drop
noun: runs
modifier: at_least
context: stats
phrase: drop repeated runs of length at least {min_streak}
phrase: remove streaks spanning at least {min_streak} identical items
phrase: discard consecutive duplicates appearing at least {min_streak} times
slot: min_streak int
test: list=1,2,2,2,3,4 min_streak=3
expect: => i=3 r=0.0 ok=true s="dropped 3 streak elements" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=5,5,6,7,7,7 min_streak=2
expect: => i=5 r=0.0 ok=true s="dropped 5 streak elements" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_streak};
	var temp: int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len < threshold {
			for k in i..j {
				temp[tn] = g.res[k];
				tn++;
			}
		}
		i = j;
	}
	for k in tn { g.res[k] = temp[k]; }
	let dropped = g.n - tn;
	g.n = tn;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " streak elements");
	out
}
@end
