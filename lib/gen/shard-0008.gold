code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	if kept == 0 && g.n > 0 {
		for i in g.n {
			let x = g.res[i] + 1;
			if x >= 0 {
				var r = 0;
				while r * r < x { r++; }
				if r * r == x {
					g.res[kept] = x;
					kept++;
				}
			}
		}
		g.n = kept;
		g.steps += g.n * 2;
		out.i = kept;
		out.s.clear();
		format(out.s, "retry kept ", kept, " square items");
		return out;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " square items");
	out
}
@end
