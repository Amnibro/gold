fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff >= thresh { count++; }
		i++;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "gaps count: ", count);
	g.steps += g.n;
	out
}
