fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var found = false;
		for j in i {
			if g.res[j] == g.res[i] { found = true; break; }
		}
		if !found { unique_count++; }
	}
	g.steps += g.n * g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "distinct items count: ", unique_count);
	out
}
@end
