fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	g.res[mid - 1] += g.res[mid];
	var i = mid;
	while i + 1 < g.n {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.n--;
	g.steps++;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged middle pair, new length ", g.n);
	out
}
@end
