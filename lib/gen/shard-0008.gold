	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let pairs = kept / 2;
	for k in pairs {
		g.res[k] = g.res[k * 2] + g.res[k * 2 + 1];
	}
	g.n = pairs;
	g.steps += kept * 2 + 3;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired unique items count ", pairs);
	out
}
@end
