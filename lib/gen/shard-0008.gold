fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var modified = 0;
	for k in g.n {
		if g.res[k] > b {
			g.res[k] = b;
			modified++;
		} else if g.res[k] < -b {
			g.res[k] = -b;
			modified++;
		}
	}
	gold_cache_put(g, b, modified);
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " values to bound");
	out
}
