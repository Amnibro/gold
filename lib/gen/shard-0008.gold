phrase: search cached suffix values with cache checking {target}
slot: target int
test: list=10,20,30,20,40 target=20
expect: => i=3 r=0.0 ok=true s="suffix target at 3" errors=0 n=5 res=[10,20,30,20,40] cache=5 hits=2
test: list=5,15,25 target=15
expect: => i=1 r=0.0 ok=true s="suffix target at 1" errors=0 n=3 res=[5,15,25] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var i = g.n - 1;
	while i >= 0 {
		let val, ok = gold_cache_get(g, i);
		if ok && val == tgt {
			found_idx = i;
			break;
		}
		i--;
	}
	out.i = found_idx;
	out.ok = (found_idx >= 0);
	out.s.clear();
	format(out.s, "suffix target at ", found_idx);
	g.steps += g.n + 2;
	out
}
@end
