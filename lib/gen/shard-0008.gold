phrase: locate position of target {target} in sorted list
slot: target int
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="found at index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35,45 target=12
expect: => i=-1 r=0.0 ok=true s="found at index -1" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needle = ${target};
	var low = 0;
	var high = g.n - 1;
	var found_pos = -1;
	while low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == needle {
			found_pos = mid;
			break;
		} else if g.res[mid] < needle {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found_pos;
	out.s.clear();
	format(out.s, "found at index ", found_pos);
	out
}
@end
@entry 978a3cd01bc3f08d
kind: step
verb: limit
noun: primes
modifier: all
context: search
phrase: limit all prime search results to ceiling {cap}
phrase: clamp all prime candidates to maximum {cap}
phrase: restrict all prime search values to ceiling {cap}
slot: cap int
test: list=2,3,4,5,6,7 cap=4
expect: => i=2 r=0.0 ok=true s="clamped 2 primes" errors=0 n=6 res=[2,3,4,4,6,4] cache=0 hits=0
test: list=11,12,13,14 cap=10
expect: => i=2 r=0.0 ok=true s="clamped 2 primes" errors=0 n=4 res=[10,12,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var clamped = 0;
	for k in g.n {
		let n = g.res[k];
		var is_p = n >= 2;
		var d = 2;
		while d * d <= n {
			if n % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && g.res[k] > ceiling {
			g.res[k] = ceiling;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " primes");
	out
}
@end
