@entry 0cdff85d6d8b7034
kind: step
verb: measure
noun: primes
modifier: last
context: search
phrase: search trailing {count} results measuring count of primes
phrase: measure prime numbers among last {count} results
phrase: count prime values in last {count} result items
slot: count int
test: list=4,5,7,9,11 count=4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[4,5,7,9,11] cache=0 hits=0
test: list=8,9,10 count=2
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let take = ${count};
	var start = 0;
	if g.n > take {
		start = g.n - take;
	}
	var primes = 0;
	var i = start;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
		i++;
	}
	g.steps += g.n - start;
	out.i = primes;
	out
}
@end
