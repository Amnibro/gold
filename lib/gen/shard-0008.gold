expect: => i=4 r=0.0 ok=true s="reversed and limited 4 items" errors=0 n=4 res=[10,10,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_val};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let a = if g.res[i] > cap { cap } else { g.res[i] };
		let b = if g.res[j] > cap { cap } else { g.res[j] };
		g.res[i] = b;
		g.res[j] = a;
		i++;
		j--;
	}
	if i == j {
		if g.res[i] > cap { g.res[i] = cap; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed and limited ", g.n, " items");
	out
}
@end
