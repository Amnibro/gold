kind: step
verb: drop
noun: tail
modifier: safely
context: sort
phrase: drop tail element safely from sorted list
phrase: prune last item safely from ordered results
test: list=10,20,30,40
expect: => i=40 r=0.0 ok=true s="pruned tail element: 40" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5
expect: => i=5 r=0.0 ok=true s="pruned tail element: 5" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.s.clear();
		format(out.s, "list already empty");
		return out;
	}
	let dropped = g.res[g.n - 1];
	g.n--;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "pruned tail element: ", dropped);
	out
}
@end
@entry 2380c6c2b7afbd3d
kind: step
verb: run
noun: sequence
modifier: sorted
context: sort
phrase: verify sorted items follow arithmetic sequence with step {step_val}
phrase: test ordered sequence consistency with step {step_val}
slot: step_val int
test: list=3,7,11,15 step_val=4
expect: => i=4 r=0.0 ok=true s="valid sequence length: 4" errors=0 n=4 res=[3,7,11,15] cache=0 hits=0
test: list=2,5,9 step_val=3
expect: => i=0 r=0.0 ok=true s="invalid sequence broken at index 2" errors=0 n=3 res=[2,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_val};
	var valid = true;
	var broken_at = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k + 1] - g.res[k] != s {
				valid = false;
				broken_at = k + 1;
				break;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	if valid {
		out.i = g.n;
		format(out.s, "valid sequence length: ", g.n);
	} else {
		out.i = 0;
		format(out.s, "invalid sequence broken at index ", broken_at);
	}
	out
}
@end
