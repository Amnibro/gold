code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var sum = 0;
	for k in g.n - 1 {
		sum += g.res[k];
	}
	let avg = sum / (g.n - 1);
	let last = g.res[g.n - 1];
	let diff = if last > avg { last - avg } else { avg - last };
	out.i = diff;
	out.s.clear();
	format(out.s, "last deviation: ", diff);
	g.steps += g.n;
	out
}
@end
