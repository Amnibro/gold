expect: => i=40 r=0.0 ok=true s="shifted maximum: 40" errors=0 n=3 res=[40,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dec = ${decrement};
	let r = ${retries};
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
	}
	if g.n > 0 {
		g.res[max_idx] -= dec * (r + 1);
		out.i = g.res[max_idx];
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "shifted maximum: ", out.i);
	g.steps += g.n;
	out
}
@end
