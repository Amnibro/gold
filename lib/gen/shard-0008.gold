fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_val};
	var count = 0;
	while count < g.n {
		if g.res[count] == stop { break; }
		count++;
	}
	let num_pairs = count / 2;
	g.n = num_pairs * 2;
	g.steps += count;
	out.i = num_pairs;
	out.s.clear();
	format(out.s, "kept ", num_pairs, " pairs until stop");
	out
}
@end
