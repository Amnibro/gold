code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var kept = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var len = 0;
		if x == 0 { len = 1; }
		while x > 0 {
			len++;
			x /= 10;
		}
		if len <= md {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items within digit bound");
	out
}
@end
