noun: streak
modifier: at_least
context: aggregate
phrase: longest run length of identical digits
phrase: maximum streak length of repeated digits
test: arg=112223
expect: 3
test: arg=12345
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var prev = -1;
	var cur_len = 0;
	var max_len = 0;
	while x > 0 {
		let d = x % 10;
		if d == prev {
			cur_len++;
		} else {
			prev = d;
			cur_len = 1;
		}
		if cur_len > max_len {
			max_len = cur_len;
		}
		x /= 10;
	}
	max_len
}
@end
