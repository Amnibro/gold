fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var count = 0;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
		if g.res[i] >= low && g.res[i] <= high {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "checked ", count, " items between bounds");
	out
}
