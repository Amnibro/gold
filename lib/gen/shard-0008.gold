expect: => i=2 r=0.0 ok=true s="mapped first streak of length 2" errors=0 n=5 res=[3,3,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = -1;
	var len = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= 2 {
			start = i;
			len = j - i;
			break;
		}
		i = j;
	}
	if start >= 0 {
		for k in len {
			g.res[start + k] = ${f}(g.res[start + k]);
		}
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "mapped first streak of length ", len);
	out
}
@end
