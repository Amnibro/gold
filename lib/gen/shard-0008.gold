code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_val = 0;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x >= lim { break; }
		if !found || x > max_val {
			max_val = x;
			found = true;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if found {
		out.i = max_val;
		out.ok = true;
		format(out.s, "maximum while under limit: ", max_val);
	} else {
		gold_fail(g, "no element under limit");
		out.i = 0;
		out.ok = false;
		format(out.s, "no items under limit");
	}
	out
}
@end
