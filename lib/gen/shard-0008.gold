code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var sum = 0;
	var idx = 0;
	while idx < g.n && sum < cut {
		sum += g.res[idx];
		idx++;
	}
	var l = 0;
	var r = idx - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = idx;
	out.s.clear();
	format(out.s, "reversed prefix of ", idx);
	g.steps += g.n;
	out
}
@end
