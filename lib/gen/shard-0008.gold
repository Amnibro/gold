code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if i % 2 == 0 {
			g.res[i] = g.res[i] * g.res[i];
			count++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "squared ", count, " alternate list entries");
	out
}
@end
