code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var start_idx = g.n;
	for k in g.n {
		if g.res[k] >= th {
			start_idx = k;
			break;
		}
	}
	var kept = 0;
	for k in start_idx..g.n {
		g.res[kept] = g.res[k];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items from threshold");
	out
}
@end
