test: list=10,20,30,40,50 wsize=2
expect: => i=5 r=0.0 ok=true s="normalized windows" errors=0 n=5 res=[15,25,35,45,50] cache=0 hits=0
test: list=4,8,12,16 wsize=3
expect: => i=4 r=0.0 ok=true s="normalized windows" errors=0 n=4 res=[8,12,14,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	if w <= 1 || g.n == 0 {
		out.i = g.n;
		return out;
	}
	for i in g.n {
		var s = 0;
		var c = 0;
		var j = i;
		while j < g.n && j < i + w {
			s += g.res[j];
			c++;
			j++;
		}
		if c > 0 {
			g.res[i] = s / c;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized windows");
	g.steps += g.n + 1;
	out
}
@end
