fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var eq = false;
	if g.n > 0 {
		eq = g.res[0] == g.res[g.n - 1];
	}
	g.steps += 2;
	out.ok = eq;
	out.i = if eq { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked prefix equals last ", out.i);
	out
}
@end
@entry ff1b3a8c5f5b78e5
kind: step
verb: select
noun: primes
modifier: until
context: math
phrase: select prime numbers until ceiling {cap}
phrase: filter primes stopping when value reaches {cap}
slot: cap int
test: list=2,3,4,5,6,7,11 cap=6
expect: => i=3 r=0.0 ok=true s="selected primes under cap 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=1,2,3,5,7,11,13 cap=12
expect: => i=5 r=0.0 ok=true s="selected primes under cap 5" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	fn is_p(n int) bool {
		if n < 2 { return false; }
		var d = 2;
		while d * d <= n {
			if n % d == 0 { return false; }
			d++;
		}
		true
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if is_p(x) && x <= limit {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected primes under cap ", kept);
	out
}
@end
