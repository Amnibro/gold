fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_word};
	var stop_idx = -1;
	for i in out.s.len {
		var is_match = true;
		for j in stop.len {
			if i + j >= out.s.len || out.s[i + j] != stop[j] {
				is_match = false;
				break;
			}
		}
		if is_match {
			stop_idx = i;
			break;
		}
	}
	let end_pos = if stop_idx >= 0 { stop_idx } else { out.s.len };
	var left = 0;
	var right = end_pos - 1;
	while left < right {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		left++;
		right--;
	}
	g.steps += out.s.len;
	out.i = end_pos;
	out.s.clear();
	format(out.s, "reversed words until length ", end_pos);
	out
}
@end
