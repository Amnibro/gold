fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let cur_len = out.s.len;
	let start = if cur_len > k { cur_len - k } else { 0 };
	var tmp byte[..200] = "";
	for i in start..cur_len {
		tmp.push(out.s[i]);
	}
	out.s.clear();
	for b in tmp {
		out.s.push(b);
	}
	g.steps += 1;
	out.i = out.s.len;
	out
}
