	if !${p}(g.res[idx]) { return false; }
	${ID}_rec(g, idx + 1)
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ok = ${ID}_rec(g, 0);
	g.steps += g.n;
	out.ok = ok;
	if !ok {
