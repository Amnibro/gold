	let c = ${cap};
	let d = ${delta};
	for i in g.n {
		let next_val = g.res[i] + d;
		if next_val > c {
			g.res[i] = c;
		} else {
			g.res[i] = next_val;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied value clamp");
	g.steps += g.n + 1;
	out
}
