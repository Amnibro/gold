code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${factor};
	var last_pos = -1;
	gold_clear(g);
	for i in out.s.len {
		let b = out.s[i];
		let is_v = (b == 97 || b == 101 || b == 105 || b == 111 || b == 117);
		if is_v {
			if last_pos >= 0 {
				let dist = (i - last_pos) * m;
				gold_push(g, dist);
			}
			last_pos = i;
		}
	}
	g.steps += out.s.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " vowel distances");
	out
}
@end
