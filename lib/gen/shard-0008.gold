test: list=10,20,30,40 steps=2
expect: => i=2 r=0.0 ok=true s="shifted tail by 2 positions" errors=0 n=4 res=[10,30,40,20] cache=0 hits=0
test: list=10 steps=2
expect: => i=0 r=0.0 ok=false s="error: insufficient items" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n < 3 {
		gold_fail(g, "need at least three items for tail shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	if s <= 0 || s >= g.n - 1 {
		gold_fail(g, "tail shift steps out of bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: steps out of bounds");
		return out;
	}
	for step in s {
		let last_val = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 1 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[1] = last_val;
	}
	g.steps += s * (g.n - 1);
	out.i = s;
	out.s.clear();
	format(out.s, "shifted tail by ", s, " positions");
	out
}
@end
