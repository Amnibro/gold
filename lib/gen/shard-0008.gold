expect: => i=2 r=0.0 ok=true s="shifted evens count: 2" errors=0 n=4 res=[8,10,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ec = 0;
	var oc = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[ec] = g.res[i];
			ec++;
		} else {
			odds[oc] = g.res[i];
			oc++;
		}
	}
	for i in ec { g.res[i] = evens[i]; }
	for i in oc { g.res[ec + i] = odds[i]; }
	out.i = ec;
	out.s.clear();
	format(out.s, "shifted evens count: ", ec);
	g.steps += g.n + 1;
	out
}
@end
