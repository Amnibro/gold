kind: step
verb: reverse
noun: checkpoint
modifier: pairwise
context: error
phrase: reverse checkpoint pairs raising error on odd length
phrase: swap adjacent checkpoint pairs checking odd parity error
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="reversed checkpoint pairs: 2" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=false s="odd checkpoint count for pairwise reverse" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 {
		gold_fail(g, "odd number of checkpoints cannot be paired");
		out.ok = false;
		out.i = 0;
	} else {
		var i = 0;
		while i + 1 < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			i += 2;
		}
		out.i = g.n / 2;
	}
	out.s.clear();
	if out.ok {
		format(out.s, "reversed checkpoint pairs: ", out.i);
	} else {
		out.s.append("odd checkpoint count for pairwise reverse");
	}
	g.steps += g.n + 1;
	out
}
@end
@entry fa5e38b57747e570
kind: step
verb: count
noun: loop
modifier: unique
context: error
phrase: count unique loop elements raising error on duplicates
phrase: inspect loop elements checking unique values requirement
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="all loop elements unique: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,10
expect: => i=2 r=0.0 ok=false s="duplicate loop elements detected: 2" errors=1 n=3 res=[10,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	var dups = 0;
	var i = 0;
	while i < g.n {
		var is_dup = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
			j++;
		}
		if is_dup {
			dups++;
		} else {
			unique++;
		}
		i++;
	}
	if dups > 0 {
		gold_fail(g, "duplicate values found in loop list");
		out.ok = false;
	}
	out.i = unique;
	out.s.clear();
	if out.ok {
		format(out.s, "all loop elements unique: ", unique);
	} else {
		format(out.s, "duplicate loop elements detected: ", unique);
	}
	g.steps += g.n + 1;
	out
}
@end
