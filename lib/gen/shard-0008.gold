@entry 5b518dd57b9e3fb2
kind: step
verb: drop
noun: counter
modifier: pairwise
context: cache
phrase: drop adjacent pairs whose sum is less than {min_sum}
phrase: filter pairwise sums at least {min_sum}
slot: min_sum int
test: list=1,2,5,8 min_sum=5
expect: => i=2 r=0.0 ok=true s="retained 2 elements" errors=0 n=2 res=[5,8] cache=1 hits=0
test: list=10,20 min_sum=50
expect: => i=0 r=0.0 ok=true s="retained 0 elements" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] >= ms {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
		}
		i += 2;
	}
	gold_cache_put(g, ms, kept);
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " elements");
	out
}
@end
