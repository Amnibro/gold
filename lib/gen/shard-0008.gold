@entry bbd1f5743801f5bc
kind: step
verb: drop
noun: primes
modifier: with_retry
context: search
phrase: drop prime search candidates with retry limit {retries}
phrase: remove prime numbers from search list with {retries}
phrase: filter out primes during search with {retries}
slot: retries int
test: list=2,3,4,5,6 retries=1
expect: => i=1 r=0.0 ok=true s="dropped 1 primes" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=7,11,12 retries=2
expect: => i=2 r=0.0 ok=true s="dropped 2 primes" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drops = ${retries};
	var drops = 0;
	var kept = 0;
	for k in g.n {
		let n = g.res[k];
		var is_p = n >= 2;
		var d = 2;
		while d * d <= n {
			if n % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && drops < max_drops {
			drops++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = drops;
	out.s.clear();
	format(out.s, "dropped ", drops, " primes");
	out
}
@end
@entry 10f9a9adf2b758a8
kind: step
verb: group
noun: total
modifier: sorted
context: search
phrase: group search items by accumulated sum in sorted order
phrase: partition search scores into sorted sum groups of size {size}
phrase: aggregate sorted search list into groups of size {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=3 r=0.0 ok=true s="formed 3 sum groups" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=2 r=0.0 ok=true s="formed 2 sum groups" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bucket_size = ${size};
	if bucket_size <= 0 { return out; }
	var gn = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		for j in 0..bucket_size {
			if i + j < g.n { sum += g.res[i + j]; }
		}
		g.res[gn] = sum;
		gn++;
		i += bucket_size;
	}
	g.n = gn;
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "formed ", gn, " sum groups");
	out
}
@end
@entry 4c87582f3719b02b
kind: step
verb: group
noun: threshold
modifier: safely
context: search
phrase: group search scores around threshold {cutoff} safely
phrase: partition search results across threshold {cutoff} safely
phrase: categorize search list above below threshold {cutoff} safely
slot: cutoff int
test: list=5,15,8,20,3 cutoff=10
expect: => i=3 r=0.0 ok=true s="grouped 3 items below cutoff" errors=0 n=5 res=[5,8,3,15,20] cache=0 hits=0
test: list=12,4,18,2 cutoff=10
expect: => i=2 r=0.0 ok=true s="grouped 2 items below cutoff" errors=0 n=4 res=[4,2,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let split_val = ${cutoff};
	var temp: int[512] = [0; 512];
	var low_cnt = 0;
	for k in g.n {
		if g.res[k] < split_val {
			temp[low_cnt] = g.res[k];
			low_cnt++;
		}
	}
	var high_cnt = low_cnt;
	for k in g.n {
		if g.res[k] >= split_val {
			temp[high_cnt] = g.res[k];
			high_cnt++;
		}
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n;
	out.i = low_cnt;
	out.s.clear();
	format(out.s, "grouped ", low_cnt, " items below cutoff");
	out
}
@end
