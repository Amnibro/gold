fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let baseline = ${floor};
	var changed = false;
	if g.res[g.n - 1] < baseline {
		g.res[g.n - 1] = baseline;
		changed = true;
	}
	g.steps++;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "clamped last element to ", out.i);
	out
}
@end
