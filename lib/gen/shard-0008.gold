code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " sorted squares");
	out
}
@end
