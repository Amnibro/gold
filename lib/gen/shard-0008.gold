@entry 63b0d586f6ef5e5d
kind: step
verb: split
noun: primes
modifier: up_to
context: filter
phrase: split prime values up to threshold {limit}
phrase: filter prime entries bounded by ceiling {limit}
slot: limit int
test: list=4,7,10,13,15,19 limit=15
expect: => i=2 r=0.0 ok=true s="split primes up to 2" errors=0 n=2 res=[7,13] cache=0 hits=0
test: list=2,3,5,8,9 limit=5
expect: => i=3 r=0.0 ok=true s="split primes up to 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && x >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_prime = false;
					break;
				}
				d++;
			}
			if is_prime {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "split primes up to ", kept);
	g.steps += kept + 1;
	out
}
@end
