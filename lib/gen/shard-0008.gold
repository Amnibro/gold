code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var new_n = 0;
		for i in 1..g.n {
			let avg = (g.res[i - 1] + g.res[i]) / 2;
			g.res[new_n] = avg;
			new_n++;
		}
		g.n = new_n;
		out.i = new_n;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "collected pairwise averages: ", out.i);
	g.steps += g.n;
	out
}
@end
