fn ${ID}_is_sq(x int) bool {
	if x < 0 { return false; }
	var i = 0;
	while i * i <= x {
		if i * i == x { return true; }
		i++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		if !${ID}_is_sq(g.res[k]) {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " non squares");
	g.steps += kept;
	out
}
@end
