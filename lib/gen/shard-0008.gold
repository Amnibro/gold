@entry 4f3a7000338b6b33
kind: step
verb: run
noun: results
modifier: unique
context: list
phrase: run unique filtering across results
phrase: retain only distinct items within results
test: list=1,2,2,3,4,4,5
expect: => i=5 r=0.0 ok=true s="unique results count: 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="unique results count: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[..64] = [];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in uniq.len {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen {
			uniq.push(x);
		}
	}
	for i in uniq.len {
		g.res[i] = uniq[i];
	}
	g.n = uniq.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique results count: ", g.n);
	g.steps += g.n;
	out
}
@end
