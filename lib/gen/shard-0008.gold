code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo < 0 || hi >= g.n || lo > hi {
		gold_fail(g, "range bounds invalid for summation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid range bounds");
		return out;
	}
	var total = 0;
	var k = lo;
	while k <= hi {
		total += g.res[k];
		k++;
	}
	g.steps += (hi - lo + 1);
	out.i = total;
	out.s.clear();
	format(out.s, "sum between bounds is ", total);
	out
}
@end
