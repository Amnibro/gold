fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var acc = 0;
	var kept = 0;
	for i in g.n {
		acc += ${op}(g.res[i]);
		if acc <= lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded running total: ", acc);
	g.steps += g.n + 1;
	out
}
@end
