code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = v.i;
	var i = 0;
	while i < g.n {
		let sq = g.res[i] * g.res[i];
		if sq > cap {
			g.res[i] = cap;
		} else {
			g.res[i] = sq;
		}
		i += 1;
	}
	out.i = cap;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed squares capped at ", cap);
	g.steps += g.n;
	out
}
@end
