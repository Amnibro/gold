@entry f7e115f40d34fefd
kind: step
verb: filter
noun: history
modifier: sorted
context: core
phrase: filter history sorted keeping elements above {min_val}
phrase: sort preserved history entries exceeding threshold {min_val}
slot: min_val int
test: list=10,2,25,5,15 min_val=8
expect: => i=3 r=0.0 ok=true s="filtered history sorted count: 3" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: list=4,30,12 min_val=10
expect: => i=2 r=0.0 ok=true s="filtered history sorted count: 2" errors=0 n=2 res=[12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept = 0;
	for i in g.n {
		if g.res[i] > mv {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	var a = 0;
	while a < kept {
		var b = a + 1;
		while b < kept {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered history sorted count: ", kept);
	g.steps += g.n + 1;
	out
}
@end
