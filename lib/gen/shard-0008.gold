fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty list");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i += 1;
	}
	let avg = sum / g.n;
	var kept = 0;
	i = 0;
	while i < g.n {
		if g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept += 1;
		}
		i += 1;
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped items below mean ", avg, " leaving ", kept);
	g.steps += g.n;
	out
}
@end
