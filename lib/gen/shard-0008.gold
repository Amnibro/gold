@entry 62078333727efe78
kind: step
verb: cache
noun: tally
modifier: unique
context: text
phrase: cache tally of unique characters in text
phrase: store count of distinct characters into cache
test: text="banana"
expect: => i=3 r=0.0 ok=true s="cached tally of 3 unique characters" errors=0 n=0 res=[] cache=1 hits=0
test: text="hello"
expect: => i=4 r=0.0 ok=true s="cached tally of 4 unique characters" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	var i = 0;
	while i < v.s.len {
		var found = false;
		var j = 0;
		while j < i {
			if v.s[j] == v.s[i] {
				found = true;
				break;
			}
			j += 1;
		}
		if !found {
			uniq += 1;
		}
		i += 1;
	}
	gold_cache_put(g, 0, uniq);
	out.i = uniq;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached tally of ", uniq, " unique characters");
	g.steps += v.s.len * v.s.len + 1;
	out
}
@end
@entry 477f3586702ad691
kind: step
verb: sum
noun: squares
modifier: at_least
context: text
phrase: sum squared digit values meeting at least threshold
phrase: accumulate squares of digits at least minimum
test: input=5 text="12345"
expect: => i=50 r=0.0 ok=true s="summed 3 squared digits reaching 50" errors=0 n=0 res=[] cache=0 hits=0
test: input=20 text="98"
expect: => i=145 r=0.0 ok=true s="summed 2 squared digits reaching 145" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = v.i;
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			let sq = d * d;
			if sq >= thresh {
				sum += sq;
				count += 1;
			}
		}
		i += 1;
	}
	out.i = sum;
	out.ok = count > 0;
	out.s.clear();
	format(out.s, "summed ", count, " squared digits reaching ", sum);
	g.steps += v.s.len;
	out
}
@end
