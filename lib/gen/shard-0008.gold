expect: => i=3 r=0.0 ok=true s="paired 3 range spans" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let count = g.n - 1;
	for i in count {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff < 0 { -diff } else { diff };
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "paired ", count, " range spans");
	out
}
@end
