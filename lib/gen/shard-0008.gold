@entry 4ef3a0444190c105
kind: step
verb: retry
noun: spaces
modifier: at_most
context: search
phrase: search text collapsing consecutive spaces at most {limit} times
phrase: compress repeated spaces up to at most {limit} occurrences
phrase: collapse adjacent spaces in text at most {limit} times
slot: limit int
test: text="a  b  c" limit=1
expect: => i=1 r=0.0 ok=true s="a b  c" errors=0 n=0 res=[] cache=0 hits=0
test: text="x   y" limit=2
expect: => i=2 r=0.0 ok=true s="x y" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sp = ${limit};
	var collapsed = 0;
	var wr = 0;
	var prev_space = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			if prev_space && collapsed < max_sp {
				collapsed++;
			} else {
				out.s[wr] = c;
				wr++;
				prev_space = true;
			}
		} else {
			out.s[wr] = c;
			wr++;
			prev_space = false;
		}
	}
	while out.s.len > wr {
		out.s.pop();
	}
	g.steps += out.s.len + collapsed;
	out.i = collapsed;
	out
}
@end
