expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniques int[512] = [0; 512];
	var ucount = 0;
	for k in g.n {
		let x = g.res[k];
		var exists = false;
		for j in ucount {
			if uniques[j] == x { exists = true; break; }
		}
		if !exists {
			uniques[ucount] = x;
			ucount++;
		}
	}
	gold_clear(g);
	for i in ucount {
		gold_push(g, uniques[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
