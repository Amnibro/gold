kind: step
verb: limit
noun: gaps
modifier: in_place
context: list
phrase: limit difference gaps in place to maximum {max_gap}
phrase: clamp consecutive step gaps in place using {max_gap}
slot: max_gap int
test: list=10,30,35,70 max_gap=10
expect: => i=3 r=0.0 ok=true s="limited gaps in place: 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,100 max_gap=5
expect: => i=1 r=0.0 ok=true s="limited gaps in place: 1" errors=0 n=2 res=[1,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var adjusted = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
			adjusted++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "limited gaps in place: ", adjusted);
	g.steps += g.n;
	out
}
@end
