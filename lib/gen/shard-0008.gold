code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	fn is_p(n int) bool {
		if n < 2 { return false; }
		var d = 2;
		while d * d <= n {
			if n % d == 0 { return false; }
			d++;
		}
		true
	}
	var prime_sum = 0;
	var count = 0;
	for i in g.n {
		if is_p(g.res[i]) {
			prime_sum += g.res[i];
			count++;
		}
	}
	g.steps += g.n + count + 2;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "merged all primes sum ", prime_sum);
	out
}
@end
