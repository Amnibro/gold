fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		out.s.clear();
		format(out.s, "shifted first to last: ", first);
		out.i = first;
		g.steps += 1;
	}
	out
}
@end
