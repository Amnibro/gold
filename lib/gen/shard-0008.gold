code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for head validation");
		out.ok = false;
		return out;
	}
	let h = g.res[0];
	out.i = h;
	out.s.clear();
	if h < 0 {
		gold_fail(g, "negative head element");
		out.ok = false;
		format(out.s, "head validation failed: negative");
		return out;
	}
	let cv, hit = gold_cache_get(g, h);
	if hit {
		format(out.s, "head cached hit: ", cv);
	} else {
		gold_cache_put(g, h, 1);
		format(out.s, "head validated via cache: 1");
	}
	g.steps += 1;
	out
}
@end
