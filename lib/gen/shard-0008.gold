	let limit = ${cap};
	var tot = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] < limit {
			tot += g.res[i];
			count++;
		} else {
			break;
		}
	}
	out.i = tot;
	out.s.clear();
	format(out.s, "tally while under cap: ", tot);
	g.steps += count + 1;
	out
}
@end
