slot: freq int
test: arg=11223 freq=2
expect: 3
test: arg=45556 freq=3
expect: 46
code:
fn ${ID}(n int) int {
	let f_limit = ${freq};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0; }
	var counts = [0; 10];
	var temp = x;
	while temp > 0 {
		let d = temp % 10;
		counts[d]++;
		temp /= 10;
	}
	var res = 0;
	var mul = 1;
	temp = x;
	while temp > 0 {
		let d = temp % 10;
		if counts[d] < f_limit {
			res += d * mul;
			mul *= 10;
		}
		temp /= 10;
	}
	res
}
@end
