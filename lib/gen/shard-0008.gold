fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	if idx >= 0 {
		g.n = idx + 1;
		out.i = idx;
		out.ok = true;
	} else {
		out.i = -1;
		out.ok = false;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "first occurrence index ", out.i);
	out
}
@end
