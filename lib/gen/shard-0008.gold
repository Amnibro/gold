fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lim};
	let t = ${times};
	for i in g.n {
		if g.res[i] > bound { g.res[i] = bound; }
	}
	if g.n > 1 {
		let shift = (t % g.n + g.n) % g.n;
		var tmp int[512] = [0; 512];
		for i in g.n { tmp[i] = g.res[i]; }
		for i in g.n {
			let dest = (i + shift) % g.n;
			g.res[dest] = tmp[i];
		}
	}
	g.steps += g.n * 2;
	out.i = t;
	out.s.clear();
	format(out.s, "rotated ", t, " times with cap ", bound);
	out
}
@end
@entry c123ec7e648acf54
kind: step
verb: join
noun: runs
modifier: recursively
context: math
phrase: join adjacent matching runs recursively
phrase: collapse equal neighbor runs recursively by summation
test: list=2,2,4,8
expect: => i=1 r=0.0 ok=true s="joined runs recursively to 1 items" errors=0 n=1 res=[16] cache=0 hits=0
test: list=3,3,5
expect: => i=2 r=0.0 ok=true s="joined runs recursively to 2 items" errors=0 n=2 res=[6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = true;
	var passes = 0;
	while changed && passes < 20 {
		changed = false;
		passes++;
		var kept = 0;
		var i = 0;
		var tmp int[512] = [0; 512];
		while i < g.n {
			if i + 1 < g.n && g.res[i] == g.res[i + 1] {
				tmp[kept] = g.res[i] * 2;
				kept++;
				i += 2;
				changed = true;
			} else {
				tmp[kept] = g.res[i];
				kept++;
				i++;
			}
		}
		gold_clear(g);
		for k in kept { gold_push(g, tmp[k]); }
	}
	g.steps += passes * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined runs recursively to ", g.n, " items");
	out
}
@end
