fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	var w = 0;
	for r in g.n {
		if ${p}(g.res[r]) {
			g.res[w] = g.res[r];
			w++;
		}
	}
	g.n = w;
	if !is_sorted {
		gold_fail(g, "input list was not sorted");
		out.ok = false;
	}
	out.i = w;
	out.s.clear();
	if out.ok {
		format(out.s, "selected matching elements: ", w);
	} else {
		format(out.s, "input was unsorted: ", w);
	}
	g.steps += g.n + 1;
	out
}
