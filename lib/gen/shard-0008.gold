fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var sum = 0;
	for i in start..g.n { sum += g.res[i]; }
	gold_push(g, sum);
	g.steps += g.n - start;
	out.i = sum;
	out.s.clear();
	format(out.s, "appended group sum ", sum);
	out
}
@end
