fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_val};
	let tgt = ${target};
	gold_clear(g);
	var cur = out.i;
	gold_push(g, cur);
	while cur < tgt {
		cur += s;
		if cur > tgt { cur = tgt; }
		gold_push(g, cur);
	}
	g.steps += g.n;
	out.i = cur;
	out.s.clear();
	format(out.s, "clamped step to ", cur, " in ", g.n, " items");
	out
}
@end
