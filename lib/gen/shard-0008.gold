@entry 34b6d799023ce445
kind: step
verb: count
noun: threshold
modifier: sorted
context: math
phrase: count elements exceeding threshold {t} in sorted results
phrase: tally items reaching floor {t} in sorted sequence
slot: t int
test: list=10,50,20,40 t=25
expect: => i=2 r=0.0 ok=true s="sorted threshold count 2" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=5,15,3 t=20
expect: => i=0 r=0.0 ok=true s="sorted threshold count 0" errors=0 n=3 res=[3,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${t};
	// sort ascending
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] >= cutoff { count++; }
	}
	g.steps += g.n * 2 + 2;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted threshold count ", count);
	out
}
@end
