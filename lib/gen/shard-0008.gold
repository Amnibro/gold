kind: step
verb: normalize
noun: suffix
modifier: until
context: math
phrase: normalize suffix elements until encountering threshold {limit}
phrase: reduce trailing values until reaching boundary {limit}
slot: limit int
test: list=10,20,40,60,80 limit=50
expect: => i=2 r=0.0 ok=true s="normalized count: 2" errors=0 n=5 res=[10,20,40,50,50] cache=0 hits=0
test: list=5,15,25,35 limit=20
expect: => i=2 r=0.0 ok=true s="normalized count: 2" errors=0 n=4 res=[5,15,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var modified = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > lim {
			g.res[i] = lim;
			modified++;
			i--;
		} else {
			break;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized count: ", modified);
	g.steps += modified + 1;
	out
}
@end
