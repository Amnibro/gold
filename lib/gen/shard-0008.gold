code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var left int[512] = [0; 512];
	var right int[512] = [0; 512];
	var ln = 0;
	var rn = 0;
	for i in g.n {
		if g.res[i] < th {
			left[ln] = g.res[i];
			ln++;
		} else {
			right[rn] = g.res[i];
			rn++;
		}
	}
	for i in ln { g.res[i] = left[i]; }
	for i in rn { g.res[ln + i] = right[i]; }
	out.i = ln;
	out.s.clear();
	format(out.s, "split count below ", ln);
	g.steps += g.n + 2;
	out
}
@end
