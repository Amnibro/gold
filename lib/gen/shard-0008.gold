fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${interval};
	if step <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var running = 0;
	var count = 0;
	for i in g.n {
		running += g.res[i];
		if (i + 1) % step == 0 {
			g.res[count] = running;
			count++;
		}
	}
	g.n = count;
	out.i = running;
	out.s.clear();
	format(out.s, "checkpoint final total ", running);
	g.steps += g.n + 1;
	out
}
@end
