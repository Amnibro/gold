expect: => i=2 r=0.0 ok=true s="filtered sorted gaps count: 2" errors=0 n=2 res=[5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var kept = 0;
	if g.n > 0 {
		g.res[0] = g.res[0];
		kept = 1;
		var last_val = g.res[0];
		var k = 1;
		while k < g.n {
			if g.res[k] - last_val >= mg {
				g.res[kept] = g.res[k];
				last_val = g.res[k];
				kept++;
			}
			k++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered sorted gaps count: ", kept);
	g.steps += g.n + 1;
	out
}
@end
