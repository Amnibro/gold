code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			dropped++;
		} else {
			break;
		}
	}
	if dropped > 0 {
		for i in dropped..g.n {
			g.res[i - dropped] = g.res[i];
		}
		g.n -= dropped;
	}
	gold_cache_put(g, 100, dropped);
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped streak: ", dropped);
	g.steps += dropped + 1;
	out
}
@end
