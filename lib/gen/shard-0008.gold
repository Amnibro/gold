fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var clamped = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
		i--;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped threshold in reverse: ", clamped);
	g.steps += g.n + 1;
	out
}
@end
