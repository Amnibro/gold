fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${limit};
	var sum = 0;
	var count = 0;
	for k in g.n {
		sum += g.res[k];
		count++;
		if sum >= threshold { break; }
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "reached sum ", sum, " after ", count, " steps");
	out
}
