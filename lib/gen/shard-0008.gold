fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt = 0;
	var sign = 1;
	var i = g.n - 1;
	while i >= 0 {
		alt += sign * g.res[i];
		sign = -sign;
		i--;
	}
	g.steps += g.n + 1;
	out.i = alt;
	out.s.clear();
	format(out.s, "scanned list reversed alt sum ", alt);
	out
}
