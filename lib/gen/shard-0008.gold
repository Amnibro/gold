fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_diff = ${diff};
	var count = 0;
	if g.n >= 2 {
		var i = 0;
		while i + 1 < g.n {
			let d = g.res[i + 1] - g.res[i];
			let abs_d = if d < 0 { -d } else { d };
			if abs_d >= min_diff {
				count++;
			}
			i++;
		}
	}
	g.steps += g.n + 3;
	out.i = count;
	out.s.clear();
	format(out.s, "selected pairs difference count ", count);
	out
}
@end
@entry 232b8c304adedb27
kind: step
