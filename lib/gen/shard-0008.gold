expect: => i=0 r=0.0 ok=false s="error: condition not matched" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "group limit must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: nonpositive limit");
		return out;
	}
	var kept = 0;
	for k in g.n {
		if ${p}(g.res[k]) && kept < lim {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	if kept == 0 {
		gold_fail(g, "no items satisfied condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: condition not matched");
		return out;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " items meeting condition");
	out
}
@end
