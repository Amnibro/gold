noun: streak
modifier: at_most
context: loop
phrase: reverse streak of matching signs at most {max_len}
phrase: invert run of positive elements at most {max_len}
slot: max_len int
test: list=1,2,3,4,-1 max_len=3
expect: => i=3 r=0.0 ok=true s="reversed streak of size 3" errors=0 n=5 res=[3,2,1,4,-1] cache=0 hits=0
test: list=5,6,-2,8 max_len=2
expect: => i=2 r=0.0 ok=true s="reversed streak of size 2" errors=0 n=4 res=[6,5,-2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var streak = 0;
	while streak < g.n && g.res[streak] > 0 && streak < limit {
		streak++;
	}
	for i in streak / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[streak - 1 - i];
		g.res[streak - 1 - i] = tmp;
	}
	g.steps += streak;
	out.i = streak;
	out.s.clear();
	format(out.s, "reversed streak of size ", streak);
	out
}
@end
