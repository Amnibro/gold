fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	gold_clear(g);
	var cur_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur_len > 0 {
				if cur_len >= lo && cur_len <= hi {
					gold_push(g, cur_len);
					gold_push(g, cur_len);
				}
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		if cur_len >= lo && cur_len <= hi {
			gold_push(g, cur_len);
			gold_push(g, cur_len);
		}
	}
	g.steps += out.s.len + g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated ", g.n, " word sizes between limits");
	out
}
@end
@entry 2e8161a0cf5a7b17
kind: step
verb: join
noun: step
modifier: pairwise
context: math
phrase: join adjacent steps pairwise by summation
phrase: sum neighbor steps pairwise across sequence
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="joined pairwise to 2 items" errors=0 n=2 res=[30,70] cache=0 hits=0
test: list=1,2,3
expect: => i=2 r=0.0 ok=true s="joined pairwise to 2 items" errors=0 n=2 res=[3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var tmp int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			tmp[kn] = g.res[i] + g.res[i + 1];
			kn++;
			i += 2;
		} else {
			tmp[kn] = g.res[i];
			kn++;
			i++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, tmp[k]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "joined pairwise to ", kn, " items");
	out
}
@end
