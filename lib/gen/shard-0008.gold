fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var temp: byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if i < lim {
			var seen = false;
			for j in temp.len {
				if temp[j] == c { seen = true; break; }
			}
			if !seen { temp.push(c); }
		} else {
			temp.push(c);
		}
		i++;
	}
	out.s.clear();
	for b in temp { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
