fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var min_i = 0;
	var max_i = 0;
	for k in g.n {
		if g.res[k] < g.res[min_i] { min_i = k; }
		if g.res[k] > g.res[max_i] { max_i = k; }
	}
	let tmp = g.res[min_i];
	g.res[min_i] = g.res[max_i];
	g.res[max_i] = tmp;
	out.i = min_i;
	out.s.clear();
	format(out.s, "swapped extremes");
	g.steps += g.n;
	out
}
@end
