fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = v.i;
	var pairs = 0;
	if v.s.len >= 2 {
		var i = v.s.len - 1;
		while i > 0 && pairs < limit {
			if v.s[i] == v.s[i - 1] {
				pairs += 1;
				i -= 1;
			}
			i -= 1;
		}
	}
	gold_clear(g);
	gold_push(g, pairs);
	out.i = pairs;
	out.ok = pairs > 0;
	out.s.clear();
	format(out.s, "found ", pairs, " duplicate pairs in reverse");
	g.steps += v.s.len;
	out
}
@end
