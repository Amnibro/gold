@entry 1ab4352ebdf68e4c
kind: step
verb: compare
noun: histogram
modifier: recursively
context: error
phrase: compare histogram bins recursively for anomalies {threshold}
phrase: recursively compare histogram levels for errors {threshold}
phrase: evaluate histogram depths recursively bounded by {threshold}
slot: threshold int
test: list=1,2,2,3 threshold=3
expect: => i=2 r=0.0 ok=true s="histogram max frequency is 2" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
test: list=2,2,2,2 threshold=2
expect: => i=0 r=0.0 ok=false s="error: frequency overflow" errors=1 n=4 res=[2,2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	if lim <= 0 {
		gold_fail(g, "threshold must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid threshold");
		return out;
	}
	var max_freq = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	if max_freq > lim {
		gold_fail(g, "histogram frequency exceeds threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: frequency overflow");
		return out;
	}
	g.steps += g.n * g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "histogram max frequency is ", max_freq);
	out
}
@end
