code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var running = 0;
	var count = 0;
	for i in g.n {
		if running + g.res[i] <= cap {
			running += g.res[i];
			g.res[count] = g.res[i];
			count++;
		}
	}
	g.n = count;
	out.i = running;
	out.s.clear();
	format(out.s, "capped total at ", running);
	g.steps += count + 1;
	out
}
@end
