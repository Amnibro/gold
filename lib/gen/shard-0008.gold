test: list=10,14,25
expect: => i=3 r=0.0 ok=true s="recorded deltas for each of 3 history items" errors=0 n=3 res=[0,4,11] cache=0 hits=0
test: list=3,9
expect: => i=2 r=0.0 ok=true s="recorded deltas for each of 2 history items" errors=0 n=2 res=[0,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("not enough history");
		return out;
	}
	var prev = g.res[0];
	g.res[0] = 0;
	var i = 1;
	while i < g.n {
		let cur = g.res[i];
		g.res[i] = cur - prev;
		prev = cur;
		i += 1;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "recorded deltas for each of ", g.n, " history items");
	g.steps += g.n;
	out
}
@end
