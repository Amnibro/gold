fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	for i in g.n - 1 {
		if g.res[i] + g.res[i + 1] == tgt {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		out.ok = true;
		format(out.s, "pair at ", found_idx, " matches total ", tgt);
	} else {
		gold_fail(g, "no pair sums to total");
		out.ok = false;
		format(out.s, "no pair matches total ", tgt);
	}
	out
}
