@entry 956ba30eaf24421b
kind: step
verb: group
noun: items
modifier: nested
context: filter
phrase: group items into nested chunks of size {size}
phrase: partition items into nested groups sized {size}
slot: size int
test: list=12,5,8,15,3,9 size=2
expect: => i=3 r=0.0 ok=true s="grouped nested items 3" errors=0 n=3 res=[5,8,3] cache=0 hits=0
test: list=20,10,30,40,5,25 size=3
expect: => i=2 r=0.0 ok=true s="grouped nested items 2" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		var mn = g.res[i];
		var j = 1;
		while j < sz && i + j < g.n {
			if g.res[i + j] < mn {
				mn = g.res[i + j];
			}
			j++;
		}
		g.res[count] = mn;
		count++;
		i += sz;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped nested items ", count);
	g.steps += count + 1;
	out
}
@end
