phrase: reduce peak value by {decrement} over {retries} attempts
slot: decrement int
slot: retries int
test: list=1,10,3 decrement=2 retries=2
expect: => i=4 r=0.0 ok=true s="shifted maximum: 4" errors=0 n=3 res=[1,4,3] cache=0 hits=0
