expect: => i=23 r=0.0 ok=false s="validated span: 23" errors=0 n=3 res=[2,25,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_span};
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	out.ok = (span <= ms);
	out.i = span;
	out.s.clear();
	format(out.s, "validated span: ", span);
	g.steps += g.n + 1;
	out
}
@end
