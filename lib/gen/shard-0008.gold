expect: => i=85 r=0.0 ok=true s="split half diff 85" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var s1 = 0;
	var s2 = 0;
	for k in 0..mid { s1 += g.res[k]; }
	for k in mid..g.n { s2 += g.res[k]; }
	let diff = if s1 > s2 { s1 - s2 } else { s2 - s1 };
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "split half diff ", diff);
	out
}
@end
@entry 90a350a442745112
kind: step
verb: apply
noun: duplicates
modifier: up_to
context: search
phrase: apply scaling {mult} to duplicate search items up to {lim}
phrase: multiply duplicate search matches by {mult} up to limit {lim}
phrase: boost repeated search values by factor {mult} up to {lim}
slot: mult int
slot: lim int
test: list=2,2,3,3,3 mult=2 lim=2
expect: => i=2 r=0.0 ok=true s="boosted 2 duplicates" errors=0 n=5 res=[2,4,3,6,3] cache=0 hits=0
test: list=5,5,5,6 mult=3 lim=1
expect: => i=1 r=0.0 ok=true s="boosted 1 duplicates" errors=0 n=4 res=[5,15,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${mult};
	let limit = ${lim};
	var boosted = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] && boosted < limit {
			g.res[i] = g.res[i] * factor;
			boosted++;
		}
	}
	g.steps += g.n;
	out.i = boosted;
	out.s.clear();
	format(out.s, "boosted ", boosted, " duplicates");
	out
}
@end
@entry 60eb70e2dcb43361
kind: step
verb: split
noun: range
modifier: none
context: search
phrase: split search interval range evenly into {k} parts
phrase: partition search space range into {k} buckets
phrase: divide search range into {k} equal segments
slot: k int
test: list=0,100 k=4
expect: => i=4 r=0.0 ok=true s="split range into 4 parts" errors=0 n=5 res=[0,25,50,75,100] cache=0 hits=0
test: list=10,70 k=3
expect: => i=3 r=0.0 ok=true s="split range into 3 parts" errors=0 n=4 res=[10,30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let low = g.res[0];
	let high = g.res[g.n - 1];
	let parts = ${k};
	if parts <= 0 { return out; }
	let span = high - low;
	let step_size = span / parts;
	gold_clear(g);
	for i in 0..(parts + 1) {
		gold_push(g, low + i * step_size);
	}
	g.steps += parts;
	out.i = parts;
	out.s.clear();
	format(out.s, "split range into ", parts, " parts");
	out
}
@end
@entry cbb122338f587d7f
kind: step
verb: sum
noun: minimum
modifier: with_retry
context: search
phrase: sum smallest {k} search values with retry limit {k}
phrase: accumulate minimum {k} search candidates with retry
phrase: calculate total of {k} lowest search scores with retry
slot: k int
test: list=15,8,22,4,19 k=2
expect: => i=12 r=0.0 ok=true s="summed lowest 2 items to 12" errors=0 n=5 res=[4,8,15,19,22] cache=0 hits=0
test: list=30,10,20 k=1
expect: => i=10 r=0.0 ok=true s="summed lowest 1 items to 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total = 0;
	let lim = if count > g.n { g.n } else { count };
	for i in lim { total += g.res[i]; }
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed lowest ", lim, " items to ", total);
	out
}
@end
