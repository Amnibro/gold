test: list=1,2,3,4 delta=5
expect: => i=4 r=0.0 ok=true s="reversed 4 items with delta 5" errors=0 n=4 res=[9,8,7,6] cache=0 hits=0
test: list=10,20,30 delta=1
expect: => i=3 r=0.0 ok=true s="reversed 3 items with delta 1" errors=0 n=3 res=[31,21,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j] + d;
		g.res[j] = tmp + d;
		i++;
		j--;
	}
	if i == j {
		g.res[i] += d;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " items with delta ", d);
	out
}
@end
