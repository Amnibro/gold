		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "kept alternate items count: ", g.n);
	} else {
		out.s.append("cannot keep alternate items from empty list");
	}
	g.steps += g.n + 1;
	out
}
