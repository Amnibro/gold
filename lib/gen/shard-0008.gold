context: filter
phrase: filter pairs until total sum reaches {limit}
phrase: collect adjacent pair elements stopping when sum reaches {limit}
slot: limit int
test: list=2,3,4,5,6,7 limit=10
expect: => i=5 r=0.0 ok=true s="filtered pairs sum: 5" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,1,2,2,3,3 limit=5
expect: => i=2 r=0.0 ok=true s="filtered pairs sum: 2" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if sum + pair_sum > lim { break; }
		g.res[kept] = g.res[i];
		g.res[kept + 1] = g.res[i + 1];
		kept += 2;
		sum += pair_sum;
		i += 2;
	}
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "filtered pairs sum: ", sum);
	g.steps += g.n + 1;
	out
}
@end
