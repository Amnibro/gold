fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var i = 0;
	while i < v.s.len {
		if v.s[i] == ',' || v.s[i] == ';' || v.s[i] == '|' {
			found = true;
			break;
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, v.s.len);
