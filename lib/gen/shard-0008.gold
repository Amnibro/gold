kind: step
verb: swap
noun: limit
modifier: running
context: loop
phrase: swap elements exceeding running limit {limit}
phrase: exchange values over running ceiling {limit}
slot: limit int
test: list=5,10,15,20 limit=20
expect: => i=2 r=0.0 ok=true s="swapped 2 over running limit" errors=0 n=4 res=[5,15,20,10] cache=0 hits=0
test: list=2,3,4,50 limit=10
expect: => i=1 r=0.0 ok=true s="swapped 1 over running limit" errors=0 n=4 res=[2,3,50,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var running = 0;
	var swaps = 0;
	for i in g.n {
		running += g.res[i];
		if running > lim && i > 0 {
			let tmp = g.res[i];
			g.res[i] = g.res[i - 1];
			g.res[i - 1] = tmp;
			swaps++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " over running limit");
	out
}
@end
@entry 6f0165eb26d01a0b
kind: step
verb: retry
noun: primes
modifier: in_reverse
context: loop
phrase: retry prime search in reverse order limit {max_retries}
phrase: search backwards for prime elements retrying up to {max_retries}
slot: max_retries int
test: list=4,8,10 max_retries=3
expect: => i=3 r=0.0 ok=true s="retried in reverse found 3 primes" errors=0 n=3 res=[3,7,7] cache=0 hits=0
test: list=14,20 max_retries=2
expect: => i=2 r=0.0 ok=true s="retried in reverse found 2 primes" errors=0 n=2 res=[13,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var i = g.n - 1;
	var found = 0;
	while i >= 0 {
		var x = g.res[i];
		var r = 0;
		while !core_is_prime(x) && r < retries {
			x--;
			r++;
		}
		if core_is_prime(x) {
			g.res[i] = x;
			found++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "retried in reverse found ", found, " primes");
	out
}
@end
