code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${cp};
	var found_pos = -1;
	var dist = 0;
	for k in g.n {
		let idx = g.n - 1 - k;
		if g.res[idx] == target && found_pos < 0 {
			found_pos = idx;
			dist = k + 1;
		}
	}
	g.steps += g.n + dist;
	out.i = found_pos;
	out.ok = found_pos >= 0;
	out
}
@end
