code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var best = 1;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
	}
	gold_clear(g);
	for i in t { gold_push(g, best); }
	g.steps += g.n + t;
	out.i = best;
	out.s.clear();
	format(out.s, "streak rank ", best, " repeated ", t, " times");
	out
}
@end
