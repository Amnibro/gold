fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_divisions = 0;
	for k in g.n {
		while g.res[k] != 0 && g.res[k] % 2 == 0 {
			g.res[k] /= 2;
			total_divisions++;
		}
	}
	g.steps += g.n + total_divisions;
	out.i = total_divisions;
	out.s.clear();
	format(out.s, "reduced evens with ", total_divisions, " divisions");
	out
}
@end
