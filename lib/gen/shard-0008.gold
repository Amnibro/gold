@entry 5322fa20013d87bb
kind: step
verb: keep
noun: cache
modifier: between
context: loop
phrase: keep cached values between {lo} inclusive {hi}
phrase: preserve cache items within bounds {lo} upper {hi}
slot: lo int
slot: hi int
test: list=5,15,25,35,45 lo=10 hi=40
expect: => i=3 r=0.0 ok=true s="cached 3 items between bounds" errors=0 n=3 res=[15,25,35] cache=3 hits=0
test: list=2,4,6,8,10 lo=3 hi=7
expect: => i=2 r=0.0 ok=true s="cached 2 items between bounds" errors=0 n=2 res=[4,6] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			gold_cache_put(g, i, x);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached ", kept, " items between bounds");
	out
}
@end
