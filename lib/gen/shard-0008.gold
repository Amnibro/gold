	let k = ${count};
	let lim = if k > g.n { g.n } else if k < 0 { 0 } else { k };
	for i in lim {
		if g.res[i] <= 0 {
			gold_fail(g, "non-positive item in prefix");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "item ", i, " failed positive validation: ", g.res[i]);
			return out;
		}
	}
	g.steps += lim;
	out.i = lim;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated first ", lim, " items positive");
	out
}
