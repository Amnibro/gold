code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let sh = ${offset} % g.n;
	var temp: int[512] = [0; 512];
	for k in g.n {
		let new_pos = (k + g.n - sh) % g.n;
		temp[new_pos] = g.res[k];
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n;
	out.i = sh;
	out.s.clear();
	format(out.s, "shifted list in reverse by ", sh);
	out
}
@end
