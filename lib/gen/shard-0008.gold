@entry 3b55dba2becf782d
kind: step
verb: sort
noun: gaps
modifier: in_place
context: math
phrase: sort consecutive gap differences in place
phrase: order adjacent gaps in place by magnitude
test: list=2,15,20,25
expect: => i=3 r=0.0 ok=true s="sorted 3 gaps in place" errors=0 n=3 res=[5,5,13] cache=0 hits=0
test: list=1,10,12
expect: => i=2 r=0.0 ok=true s="sorted 2 gaps in place" errors=0 n=2 res=[2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = g.n - 1;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " gaps in place");
	out
}
@end
