noun: maximum
modifier: recursively
context: math
phrase: dedupe maximum peak recursively across list
phrase: prune duplicate maximum entries recursively in results
test: list=4,9,2,9,9,5
expect: => i=9 r=0.0 ok=true s="deduped maximum 9 leaving 1 copy" errors=0 n=4 res=[4,9,2,5] cache=0 hits=0
test: list=10,10,1
expect: => i=10 r=0.0 ok=true s="deduped maximum 10 leaving 1 copy" errors=0 n=2 res=[10,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] > mx { mx = g.res[i]; }
	}
	var seen = false;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x == mx {
			if !seen {
				g.res[kept] = x;
				kept++;
				seen = true;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
