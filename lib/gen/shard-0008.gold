test: list=4,5,6,8
expect: => i=1 r=0.0 ok=false s="measured 1 primes" errors=1 n=4 res=[4,5,6,8] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) { prime_count++; }
	}
	g.steps += g.n;
	out.i = prime_count;
	if prime_count > 0 {
		gold_fail(g, "primes detected in list");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.s.clear();
	format(out.s, "measured ", prime_count, " primes");
	out
}
@end
