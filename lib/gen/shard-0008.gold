context: error
phrase: split values by function {f} with cache validation
phrase: partition elements via function {f} using cache safely
phrase: divide items using function {f} checking cached values
slot: f fn
test: list=2,4,6 f=double
expect: => i=3 r=0.0 ok=true s="applied function with cache to 3 items" errors=0 n=3 res=[4,8,12] cache=3 hits=0
test: list=5 f=negate
expect: => i=0 r=0.0 ok=false s="error: negative value" errors=1 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for function split");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		var fx = 0;
		let cached, hit = gold_cache_get(g, x);
		if hit {
			fx = cached;
		} else {
			fx = ${f}(x);
			gold_cache_put(g, x, fx);
		}
		if fx < 0 {
			gold_fail(g, "function produced negative result");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: negative value");
			return out;
		}
		g.res[k] = fx;
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "applied function with cache to ", count, " items");
	out
}
@end
