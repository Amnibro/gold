@entry 29f24b209b9d0d34
kind: step
verb: merge
noun: middle
modifier: times
context: transform
phrase: merge middle section elements scaling {multiplier} times
phrase: sum center items multiplying {multiplier} times
slot: multiplier int
test: list=1,10,20,2 multiplier=2
expect: => i=60 r=0.0 ok=true s="merged middle sum 60" errors=0 n=1 res=[60] cache=0 hits=0
test: list=5,2,3,8 multiplier=3
expect: => i=15 r=0.0 ok=true s="merged middle sum 15" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	let lo = g.n / 4;
	let hi = g.n - lo;
	var total = 0;
	for i in lo..hi {
		total += g.res[i];
	}
	let res = total * m;
	gold_clear(g);
	gold_push(g, res);
	g.steps += hi - lo;
	out.i = res;
	out.s.clear();
	format(out.s, "merged middle sum ", res);
	out
}
@end
