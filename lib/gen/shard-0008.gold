code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "list too short to extract middle slice");
		out.ok = false;
		g.n = 0;
	} else {
		var i = 1;
		while i < g.n - 1 {
			g.res[i - 1] = g.res[i];
			i++;
		}
		g.n -= 2;
	}
	out.i = g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "retained middle elements: ", g.n);
	} else {
		out.s.append("insufficient elements for middle slice");
	}
	g.steps += g.n + 1;
	out
}
@end
