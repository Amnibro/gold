kind: step
verb: split
noun: numbers
modifier: none
context: stats
phrase: split numbers into positive negative partitions
phrase: partition numbers without dropping elements
phrase: separate sample numbers into distinct signs
test: list=5,-3,8,-2,10
expect: => i=3 r=0.0 ok=true s="split 3 positives" errors=0 n=5 res=[5,8,10,-3,-2] cache=0 hits=0
test: list=-1,-4,7,2
expect: => i=2 r=0.0 ok=true s="split 2 positives" errors=0 n=4 res=[7,2,-1,-4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp: int[512] = [0; 512];
	var pos_cnt = 0;
	for k in g.n {
		if g.res[k] >= 0 {
			temp[pos_cnt] = g.res[k];
			pos_cnt++;
		}
	}
	var neg_cnt = pos_cnt;
	for k in g.n {
		if g.res[k] < 0 {
			temp[neg_cnt] = g.res[k];
			neg_cnt++;
		}
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n;
	out.i = pos_cnt;
	out.s.clear();
	format(out.s, "split ", pos_cnt, " positives");
	out
}
@end
