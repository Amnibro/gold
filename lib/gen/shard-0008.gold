fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
