code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let f = ${factor};
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	g.res[min_idx] *= f;
	gold_cache_put(g, f, g.res[min_idx]);
	g.steps += g.n;
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "scaled minimum to ", g.res[min_idx]);
	out
}
@end
