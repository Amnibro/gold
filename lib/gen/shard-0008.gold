test: list=10,20,5,30
expect: => i=2 r=0.0 ok=true s="nested errors count 2" errors=1 n=4 res=[10,20,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errs = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				errs++;
			}
		}
	}
	if errs > 0 {
		gold_fail(g, "nested inversions detected");
	}
	g.steps += g.n * g.n;
	out.i = errs;
	out.s.clear();
	format(out.s, "nested errors count ", errs);
	out
}
@end
