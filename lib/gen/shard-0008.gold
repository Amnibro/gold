@entry e8a1e06994bc6aef
kind: step
verb: normalize
noun: series
modifier: any
context: list
phrase: normalize series dividing by minimum positive element
phrase: rescale series values by lowest positive factor
test: list=10,20,30
expect: => i=10 r=0.0 ok=true s="normalized series by factor 10" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=6,9,15
expect: => i=6 r=0.0 ok=true s="normalized series by factor 6" errors=0 n=3 res=[1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty series");
		return out;
	}
	var min_pos = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > 0 {
			if min_pos == 0 || x < min_pos {
				min_pos = x;
			}
		}
		i += 1;
	}
	if min_pos <= 0 {
		min_pos = 1;
	}
	i = 0;
	while i < g.n {
		g.res[i] = g.res[i] / min_pos;
		i += 1;
	}
	out.i = min_pos;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized series by factor ", min_pos);
	g.steps += g.n;
	out
}
@end
