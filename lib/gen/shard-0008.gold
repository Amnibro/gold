expect: => i=1 r=0.0 ok=true s="vowels in range: 1" errors=0 n=4 res=[97,100,105,110] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s_idx = ${start};
	var e_idx = ${end};
	if s_idx < 0 { s_idx = 0; }
	if e_idx >= g.n { e_idx = g.n - 1; }
	var vowels = 0;
	if s_idx <= e_idx {
		for i in s_idx..(e_idx + 1) {
			let c = g.res[i];
			let is_v = c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117;
			if is_v { vowels++; }
		}
	}
	out.i = vowels;
	out.s.clear();
	format(out.s, "vowels in range: ", vowels);
	g.steps += vowels + 1;
	out
}
@end
