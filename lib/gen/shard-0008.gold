fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n > 1 {
		let shift = off % g.n;
		var temp: int[512] = [0; 512];
		for i in g.n {
			let new_idx = (i + shift) % g.n;
			temp[new_idx] = g.res[i];
		}
		for i in g.n {
			g.res[i] = temp[i];
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated steps count: ", g.n);
	g.steps += g.n + 1;
	out
}
@end
@entry 94f1172589c592c8
kind: step
verb: filter
noun: cache
modifier: at_least
context: filter
phrase: filter cache entries with hits at least {min_hits}
phrase: retain elements having cache frequency at least {min_hits}
slot: min_hits int
test: list=10,20,10,10,20 min_hits=2
expect: => i=5 r=0.0 ok=true s="filtered cached items meeting threshold: 5" errors=0 n=5 res=[10,20,10,10,20] cache=2 hits=8
test: list=5,5,5,8,9 min_hits=3
expect: => i=3 r=0.0 ok=true s="filtered cached items meeting threshold: 3" errors=0 n=3 res=[5,5,5] cache=3 hits=7
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mh = ${min_hits};
	for i in g.n {
		let val = g.res[i];
		let count, hit = gold_cache_get(g, val);
		if hit {
			gold_cache_put(g, val, count + 1);
		} else {
			gold_cache_put(g, val, 1);
		}
	}
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		let count, _ = gold_cache_get(g, val);
		if count >= mh {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered cached items meeting threshold: ", kept);
	g.steps += g.n + 1;
	out
}
@end
