code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	// sort descending
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n * 2 + 5;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "reversed step sorted max ", g.res[0]);
	out
}
@end
