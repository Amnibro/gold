fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	var found = false;
	if w > 0 && out.s.len >= w {
		for i in out.s.len - w + 1 {
			var has_digit = false;
			for j in w {
				let b = out.s[i + j];
				if b >= '0' && b <= '9' { has_digit = true; }
			}
			if has_digit { found = true; break; }
		}
	}
	g.steps += out.s.len;
	out.ok = found;
	out
}
@end
