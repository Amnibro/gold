code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= lo && val <= hi {
			g.res[kept] = val * 2;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "mapped ", kept, " bounded items");
	g.steps += kept + 9;
	out
}
@end
