code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	let mid_len = g.n - 2;
	for i in 1..g.n - 1 {
		for j in i + 1..g.n - 1 {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += mid_len * mid_len;
	out.i = mid_len;
	out.s.clear();
	format(out.s, "sorted ", mid_len, " middle elements");
	out
}
@end
