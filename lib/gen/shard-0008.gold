@entry 984658a108f7b2db
kind: step
verb: track
noun: delta
modifier: pairwise
context: math
phrase: track running accumulation of pairwise differences
phrase: record prefix sums of adjacent deltas
test: list=10,13,18
expect: => i=2 r=0.0 ok=true s="tracked 2 running deltas" errors=0 n=2 res=[3,8] cache=0 hits=0
test: list=2,5
expect: => i=1 r=0.0 ok=true s="tracked 1 running deltas" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("tracked 0 running deltas");
		return out;
	}
	let np = g.n - 1;
	var run = 0;
	var i = 0;
	while i < np {
		run += (g.res[i + 1] - g.res[i]);
		g.res[i] = run;
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "tracked ", np, " running deltas");
	g.steps += np;
	out
}
@end
@entry edfdc64cf6832189
kind: step
verb: check
noun: delta
modifier: pairwise
context: math
phrase: check all pairwise differences are positive
phrase: verify strictly ascending adjacent deltas
test: list=2,5,9
expect: => i=2 r=0.0 ok=true s="all 2 pairwise deltas are strictly positive" errors=0 n=3 res=[2,5,9] cache=0 hits=0
test: list=4,4,7
expect: => i=0 r=0.0 ok=false s="non positive delta found at index 0" errors=1 n=3 res=[4,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("trivial sequence strictly positive");
		return out;
	}
	var i = 0;
	while i < g.n - 1 {
		if g.res[i + 1] <= g.res[i] {
			g.errors += 1;
			out.i = i;
			out.ok = false;
			out.s.clear();
			format(out.s, "non positive delta found at index ", i);
			return out;
		}
		i += 1;
	}
	out.i = i;
	out.ok = true;
	out.s.clear();
	format(out.s, "all ", i, " pairwise deltas are strictly positive");
	g.steps += i;
	out
}
@end
