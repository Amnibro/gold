fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let m = ${multiplier};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let cost = g.res[i] * m;
		if spent + cost <= b {
			spent += cost;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "ranked budget spent: ", spent);
	g.steps += g.n + 1;
	out
}
@end
