fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var s1 = 0;
	var s2 = 0;
	for i in mid { s1 += g.res[i]; }
	for i in mid..g.n { s2 += g.res[i]; }
	let diff = if s1 > s2 { s1 - s2 } else { s2 - s1 };
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "split partition difference computed");
