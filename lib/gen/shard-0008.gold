@entry 501fc68d2562957e
kind: step
verb: reverse
noun: total
modifier: safely
context: sort
phrase: reverse sorted total safely with floor {floor}
phrase: invert sorted order safely if total exceeds {floor}
slot: floor int
test: list=3,1,2 floor=5
expect: => i=6 r=0.0 ok=true s="safely evaluated total: 6" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=3,1,2 floor=10
expect: => i=6 r=0.0 ok=true s="safely evaluated total: 6" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${floor};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var total = 0;
	for k in g.n { total += g.res[k]; }
	if total > floor {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "safely evaluated total: ", total);
	g.steps += g.n + 1;
	out
}
@end
