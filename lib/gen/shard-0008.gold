code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	if g.n > 1 {
		let tmp = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = tmp;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated subfunction running count: ", g.n);
	g.steps += g.n + 1;
	out
}
@end
