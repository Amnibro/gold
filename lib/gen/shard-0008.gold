test: list=5,1,15,2,25
expect: => i=20 r=0.0 ok=true s="every other range: 20" errors=0 n=5 res=[5,1,15,2,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var mn = g.res[0];
		var mx = g.res[0];
		var i = 0;
		while i < g.n {
			let x = g.res[i];
			if x < mn { mn = x; }
			if x > mx { mx = x; }
			i += 2;
		}
		let diff = mx - mn;
		out.i = diff;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "every other range: ", out.i);
	g.steps += g.n;
	out
}
@end
