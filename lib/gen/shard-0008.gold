@entry a44d989530ecc17b
kind: step
verb: shift
noun: evens
modifier: recursively
context: math
phrase: shift even elements rightward across sequence
phrase: cycle even items to following even positions
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="shifted evens count: 3" errors=0 n=5 res=[6,3,2,5,4] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="shifted evens count: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[count] = g.res[i];
			count++;
		}
	}
	if count > 1 {
		let last = evens[count - 1];
		var e_idx = 0;
		for i in g.n {
			if g.res[i] % 2 == 0 {
				if e_idx == 0 {
					g.res[i] = last;
				} else {
					g.res[i] = evens[e_idx - 1];
				}
				e_idx++;
			}
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "shifted evens count: ", count);
	g.steps += g.n + 1;
	out
}
@end
