expect: => i=0 r=0.0 ok=true s="found 0 close pairs" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var close_pairs = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k + 1] - g.res[k] <= md {
				close_pairs++;
			}
		}
	}
	g.steps += g.n;
	out.i = close_pairs;
	out.s.clear();
	format(out.s, "found ", close_pairs, " close pairs");
	out
}
@end
