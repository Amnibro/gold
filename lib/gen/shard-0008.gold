code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		gold_clear(g);
		gold_push(g, 0);
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("counted 0 interior items");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
		i += 1;
	}
	var cnt = 0;
	i = 0;
	while i < g.n {
		if g.res[i] > min_val && g.res[i] < max_val {
			cnt += 1;
		}
		i += 1;
	}
	gold_clear(g);
	gold_push(g, cnt);
	out.i = cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "counted ", cnt, " interior items");
	g.steps += 1;
	out
}
@end
