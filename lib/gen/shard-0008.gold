	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var k = 0;
	while k + 1 < g.cn {
		g.cv[k] += g.cv[k + 1];
		k += 2;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "merged cached values in place: ", g.cn);
	g.steps += g.cn + 1;
	out
}
