fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen { u_sum += x; }
	}
	if g.n > 1 && u_sum > 5 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n;
	out.i = u_sum;
	out.s.clear();
	format(out.s, "unique total is ", u_sum);
	out
}
@end
