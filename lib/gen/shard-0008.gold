fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var total = 0;
	for k in g.n { total += g.res[k]; }
	let first = g.res[0];
	let rest = total - first;
	out.i = total;
	out.s.clear();
	if first < rest {
		format(out.s, "first less than rest");
	} else {
		format(out.s, "first not less than rest");
	}
	g.steps++;
	out
}
@end
