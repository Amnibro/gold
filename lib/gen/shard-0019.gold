	let s_idx = if ${start_idx} > 0 { 1 } else { 0 };
	var kept = 0;
	var i = s_idx;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " alternate values");
