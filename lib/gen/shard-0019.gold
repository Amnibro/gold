expect: => i=1 r=0.0 ok=true s="cycled order for 1 repetitions" errors=0 n=4 res=[16,9,4,1] cache=0 hits=0
test: list=2,5,10,17 reps=2
expect: => i=2 r=0.0 ok=true s="cycled order for 2 repetitions" errors=0 n=4 res=[2,5,10,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	if r % 2 != 0 {
		for i in g.n / 2 {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	g.steps += g.n + 1;
	out.i = r;
	out.s.clear();
	format(out.s, "cycled order for ", r, " repetitions");
	out
}
@end
@entry fdf85e1f5b9d1fa5
kind: step
verb: measure
noun: history
modifier: in_place
context: sort
slot: span int
phrase: sort measure history in place span {span}
phrase: evaluate sorted order progress over span {span}
test: list=1,2,4,8,16 span=3
expect: => i=3 r=0.0 ok=true s="measured history span diff sum 3" errors=0 n=5 res=[1,2,4,8,16] cache=0 hits=0
test: list=5,10,15,20 span=2
expect: => i=5 r=0.0 ok=true s="measured history span diff sum 5" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = if ${span} < g.n { ${span} } else { g.n };
	var diff_sum = 0;
	if sp > 1 {
		for i in 1..sp {
			diff_sum += g.res[i] - g.res[i - 1];
		}
	}
	g.steps += sp + 1;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "measured history span diff sum ", diff_sum);
	out
}
@end
