@entry 73ed162d03927e3a
kind: step
verb: select
noun: tail
modifier: unique
context: stats
phrase: select unique tail distribution sample {k}
phrase: isolate distinct tail elements {k}
slot: k int
test: list=10,20,30,20,40,40 k=4
expect: => i=3 r=0.0 ok=true s="tail unique count 3" errors=0 n=6 res=[10,20,30,20,40,40] cache=0 hits=0
test: list=5,15,25,25,35 k=3
expect: => i=2 r=0.0 ok=true s="tail unique count 2" errors=0 n=5 res=[5,15,25,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tail_len = ${k};
	let start_pos = if g.n > tail_len { g.n - tail_len } else { 0 };
	var uniq = 0;
	var i = start_pos;
	while i < g.n {
		var dup = false;
		var j = start_pos;
		while j < i {
			if g.res[j] == g.res[i] { dup = true; break; }
			j++;
		}
		if !dup { uniq++; }
		i++;
	}
	out.i = uniq;
	g.steps += tail_len;
	out.s.clear();
	format(out.s, "tail unique count ", uniq);
	out
}
@end
