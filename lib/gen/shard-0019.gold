code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			g.res[k] = if g.res[k] % 2 == 0 { g.res[k] + 1 } else { g.res[k] - 1 };
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "adjusted ", modified, " prime values");
	out
}
@end
