fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	for i in orig_n {
		gold_cache_put(g, i, g.res[i]);
		gold_push(g, g.res[i]);
	}
	g.steps += orig_n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated list to ", g.n, " elements");
	out
}
