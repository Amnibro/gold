@entry e1c6d9a354ed04c7
kind: step
verb: join
noun: primes
modifier: times
context: format
phrase: format prime index elements repeated {factor} times
phrase: render prime position items multiplied by {factor}
phrase: display scaled prime index elements by {factor}
slot: factor int
test: list=10,20,30,40,50,60,70 factor=2
expect: => i=3 r=0.0 ok=true s="primes_scaled(2): [2->60, 3->80, 5->120]" errors=0 n=7 res=[10,20,30,40,50,60,70] cache=0 hits=0
test: list=1,2,3 factor=5
expect: => i=1 r=0.0 ok=true s="primes_scaled(5): [2->15]" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,5 factor=-2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let scale = ${factor};
	var out = v;
	out.s.clear();
	if scale <= 0 {
		gold_fail(g, "factor must be positive");
		out.ok = false;
		return out;
	}
	format(out.s, "primes_scaled(", scale, "): [");
	var p_found = 0;
	for i in g.n {
		var is_p = true;
		if i < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= i {
				if i % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			if p_found > 0 { format(out.s, ", "); }
			let scaled_val = g.res[i] * scale;
			format(out.s, i, "->", scaled_val);
			p_found++;
		}
	}
	format(out.s, "]");
	out.i = p_found;
	g.steps += g.n;
	out
}
@end
