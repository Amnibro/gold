code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var clamped = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let prev = g.res[i - 1];
			let cur = g.res[i];
			if cur - prev > mg {
				g.res[i] = prev + mg;
				clamped++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " score gaps recursively");
	out
}
@end
