@entry bb637372142db4b0
kind: step
verb: repeat
noun: suffix
modifier: recursively
context: format
phrase: format trailing suffix segment repeated {count} times
phrase: render suffix duplication loop {count} times
phrase: display repeated tail suffix pattern {count} times
slot: count int
test: list=1,2,3,4 count=3
expect: => i=6 r=0.0 ok=true s="suffix x3: [3 4] + [3 4] + [3 4]" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20 count=2
expect: => i=4 r=0.0 ok=true s="suffix x2: [10 20] + [10 20]" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5 count=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let k = ${count};
	var out = v;
	out.s.clear();
	if k <= 0 {
		gold_fail(g, "count must be positive");
		out.ok = false;
		return out;
	}
	var suf int[2] = [0; 2];
	let s_len = if g.n >= 2 { 2 } else { g.n };
	for i in s_len {
		suf[i] = g.res[g.n - s_len + i];
	}
	format(out.s, "suffix x", k, ": ");
	for r in k {
		if r > 0 { format(out.s, " + "); }
		format(out.s, "[");
		for i in s_len {
			if i > 0 { format(out.s, " "); }
			format(out.s, suf[i]);
		}
		format(out.s, "]");
	}
	out.i = k * s_len;
	g.steps += k * s_len;
	out
}
@end
