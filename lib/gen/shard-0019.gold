fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a % 2 == 0 && b % 2 == 0 {
			g.res[pairs] = a + b;
			pairs++;
		}
		i += 2;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pair_evens_any: ", pairs);
	out
}
@end
