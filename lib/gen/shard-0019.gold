@entry c803955aa8838d5f
kind: step
verb: clamp
noun: middle
modifier: in_place
context: math
slot: lo int
slot: hi int
phrase: clamp middle elements in place between lower {lo} upper {hi}
phrase: restrict interior numbers in place from {lo} to {hi}
test: list=100,5,50,20,100 lo=10 hi=40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[100,10,40,20,100] cache=0 hits=0
test: list=0,90,15,80,0 lo=20 hi=70
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[0,70,20,70,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if g.n <= 2 { return out; }
	var modified = 0;
	var i = 1;
	while i < g.n - 1 {
		if g.res[i] < low {
			g.res[i] = low;
			modified++;
		} else if g.res[i] > high {
			g.res[i] = high;
			modified++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = modified;
	out
}
@end
