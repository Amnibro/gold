code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "pair_sums: [");
	var p_count = 0;
	var i = 0;
	while i + 1 < g.n {
		if p_count > 0 { format(out.s, ", "); }
		let pair_sum = g.res[i] + g.res[i + 1];
		format(out.s, pair_sum);
		p_count++;
		i += 2;
	}
	if i < g.n {
		if p_count > 0 { format(out.s, ", "); }
		format(out.s, "(rem:", g.res[i], ")");
	}
	format(out.s, "]");
	out.i = p_count;
	g.steps += g.n;
	out
}
