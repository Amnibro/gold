test: arg=112233,44455
expect: 123
expect: 45
test: arg=123,9988
expect: 123
expect: 98
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	var rev_digits int[32] = [0; 32];
	var count = 0;
	var last_seen = -1;
	while val > 0 {
		let d = val % 10;
		if d != last_seen {
			rev_digits[count] = d;
			count++;
			last_seen = d;
		}
		val /= 10;
	}
	var res = 0;
	var i = count - 1;
	while i >= 0 {
		res = res * 10 + rev_digits[i];
		i--;
	}
	res
}
@end
