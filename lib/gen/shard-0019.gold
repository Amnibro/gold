noun: path
modifier: clustered
context: env
phrase: wind clustered trail segments of count {n} across {a}
phrase: trace {n} clustered winding pathway stones spanning {a} meters
slot: n int
slot: a real
test: n=4 a=12.0
expect: => i=4 r=0.0 ok=true s="trail_cluster" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: trail1 box -6,1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail2 box -3,-1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail3 box 0,1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail4 box 3,-1,.25 2,2,.5 m:matte #5c5042
test: n=6 a=18.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=6 r=0.0 ok=true s="trail_cluster" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: trail3 box -9,1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail4 box -6,-1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail5 box -3,1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail6 box 0,-1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail7 box 3,1,.25 2,2,.5 m:matte #5c5042
expect: => doc: trail8 box 6,-1,.25 2,2,.5 m:matte #5c5042
test: n=0 a=8.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 || ${a} <= 0.0 { gold_fail(g, "count or span out of range"); out.ok = false; return out; }
	for q in ${n} {
		let frac = (q as real) / (${n} as real);
		let px = -${a} * 0.5 + ${a} * frac;
		let py = if q % 2 == 0 { 1.0 } else { -1.0 };
		o.clear();
		gold_dnews(g, "trail", "", o);
		o.append(" box ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("25");
		o.append(" 2,2,.");
		o.append("5");
		o.append(" m:matte ");
		gold_hex(o, 92, 80, 66);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "trail_cluster");
	out
}
@end
