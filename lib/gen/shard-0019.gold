@entry 0e37a31faa3e93b7
kind: step
verb: trace
noun: items
modifier: with_retry
context: compare
phrase: compare trace items with retry attempts {retries}
phrase: log comparison trace across items with retry budget {retries}
slot: retries int
test: list=10,20,30,40 retries=2
expect: => i=4 r=0.0 ok=true s="traced 4 items with retry" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,15,25 retries=1
expect: => i=3 r=0.0 ok=true s="traced 3 items with retry" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var tracked = 0;
	for i in g.n {
		let x = g.res[i];
		gold_cache_put(g, i, x);
		tracked++;
	}
	g.steps += g.n + r;
	out.i = tracked;
	out.s.clear();
	format(out.s, "traced ", tracked, " items with retry");
	out
}
@end
@entry 879141bc7ce219a1
kind: step
verb: search
noun: numbers
modifier: last
context: compare
phrase: compare search numbers for last matching value {val}
phrase: find last occurrence of number in comparison {val}
slot: val int
test: list=10,20,30,20,40 val=20
expect: => i=3 r=0.0 ok=true s="last match found at index: 3" errors=0 n=5 res=[10,20,30,20,40] cache=0 hits=0
test: list=5,10,15 val=99
expect: => i=-1 r=0.0 ok=true s="target value not found" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var last_idx = -1;
	for i in g.n {
		if g.res[i] == target {
			last_idx = i;
		}
	}
	g.steps += g.n;
	out.i = last_idx;
	out.s.clear();
	if last_idx >= 0 {
		format(out.s, "last match found at index: ", last_idx);
	} else {
		format(out.s, "target value not found");
	}
	out
}
@end
@entry 3f86c64879857ce0
kind: step
verb: sort
noun: cache
modifier: none
context: compare
phrase: compare sort cache elements ascending
phrase: order cached comparison records directly
test: list=50,10,40,20
expect: => i=4 r=0.0 ok=true s="sorted 4 comparison values" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=8,3,1
expect: => i=3 r=0.0 ok=true s="sorted 3 comparison values" errors=0 n=3 res=[1,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " comparison values");
	out
}
@end
