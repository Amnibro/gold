expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if g.n <= 1 || w <= 0 { return out; }
	var out_list: int[512] = [0; 512];
	var on = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var dup = false;
		var start = if on > w { on - w } else { 0 };
		var j = start;
		while j < on {
			if out_list[j] == x { dup = true; break; }
			j++;
		}
		if !dup {
			out_list[on] = x;
			on++;
		}
		i++;
	}
	gold_clear(g);
	var k = 0;
	while k < on {
		gold_push(g, out_list[k]);
		k++;
	}
	g.steps += g.n;
	out.i = on;
	out
}
@end
