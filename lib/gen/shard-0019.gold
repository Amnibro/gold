kind: step
verb: validate
noun: suffix
modifier: pairwise
context: format
phrase: format pairwise non decreasing check flags
phrase: render monotonicity validation indicators string
phrase: display adjacent pair order validity flags
test: list=1,2,2,4,3
expect: => i=0 r=0.0 ok=true s="monotonic: [+ + + -]" errors=0 n=5 res=[1,2,2,4,3] cache=0 hits=0
test: list=5,10,15
expect: => i=1 r=0.0 ok=true s="monotonic: [+ +]" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=8
expect: => i=1 r=0.0 ok=true s="monotonic: trivial" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n < 2 {
		format(out.s, "monotonic: trivial");
		out.i = 1;
		return out;
	}
	format(out.s, "monotonic: [");
	let pairs = g.n - 1;
	var mono_ok = true;
	for i in pairs {
		if i > 0 { format(out.s, " "); }
		let pass = g.res[i] <= g.res[i + 1];
		if !pass { mono_ok = false; }
		format(out.s, if pass { "+" } else { "-" });
	}
	format(out.s, "]");
	out.i = if mono_ok { 1 } else { 0 };
	g.steps += pairs;
	out
}
@end
