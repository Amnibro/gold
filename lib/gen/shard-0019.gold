fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let take = if k > g.n { g.n } else { k };
	var rev: int[512] = [0; 512];
	var i = 0;
	while i < take {
		rev[i] = g.res[g.n - 1 - i];
		i++;
	}
	gold_clear(g);
	var j = 0;
	while j < take {
		gold_push(g, rev[j]);
		j++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
