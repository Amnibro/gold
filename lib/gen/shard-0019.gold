code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	for i in g.n {
		if g.res[i] == ${target} { running++; }
		g.res[i] = running;
	}
	out.i = running;
	out.s.clear();
	format(out.s, "total: ", running);
	out
}
@end
@entry cd4bd623646548dc
kind: step
verb: select
noun: budget
modifier: none
context: core
phrase: select budget items within maximum cost {budget}
phrase: keep budget items fitting allowance {budget}
slot: budget int
test: list=2,3,5,10 budget=8
expect: => i=2 r=0.0 ok=true s="budget spent: 5" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,2,3,4 budget=6
expect: => i=3 r=0.0 ok=true s="budget spent: 6" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var count = 0;
	var spent = 0;
	for i in g.n {
		let x = g.res[i];
		if spent + x <= ${budget} {
			spent += x;
			kept[count] = x;
			count++;
		}
	}
	g.n = 0;
	for j in count { gold_push(g, kept[j]); }
	out.i = count;
	out.s.clear();
	format(out.s, "budget spent: ", spent);
	out
}
@end
