@entry 5a91c7466fbb9693
kind: step
verb: trace
noun: total
modifier: recursively
context: cache
phrase: trace total recursively through cache levels {levels}
phrase: recurse cache levels {levels} tracing running total
slot: levels int
test: list=3,4,5 levels=3
expect: => i=84 r=0.0 ok=true s="traced total 84" errors=0 n=3 res=[3,4,5] cache=3 hits=0
test: list=1,2 levels=2
expect: => i=9 r=0.0 ok=true s="traced total 9" errors=0 n=2 res=[1,2] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lev = ${levels};
	var sum = 0;
	var mul = 1;
	for l in lev {
		for i in g.n { sum += g.res[i] * mul; }
		gold_cache_put(g, l, sum);
		mul *= 2;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "traced total ", sum);
	out
}
@end
@entry 5a5ecadf308c6863
kind: step
verb: fold
noun: items
modifier: while
context: cache
phrase: fold items while meeting minimum {threshold}
phrase: accumulate items into cache while exceeding {threshold}
slot: threshold int
test: list=50,40,30,10,5 threshold=20
expect: => i=120 r=0.0 ok=true s="folded 3 items sum 120" errors=0 n=5 res=[50,40,30,10,5] cache=3 hits=0
test: list=100,80,10 threshold=50
expect: => i=180 r=0.0 ok=true s="folded 2 items sum 180" errors=0 n=3 res=[100,80,10] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${threshold};
	var acc = 0;
	var cnt = 0;
	while cnt < g.n {
		let x = g.res[cnt];
		if x < min_val { break; }
		acc += x;
		gold_cache_put(g, cnt, acc);
		cnt++;
	}
	out.i = acc;
	out.s.clear();
	format(out.s, "folded ", cnt, " items sum ", acc);
	out
}
@end
@entry 04acefa38d16fad9
kind: step
verb: trace
noun: results
modifier: between
context: cache
phrase: trace results between lower {low} upper {high}
phrase: record results in cache between bounds {low} to {high}
slot: low int
slot: high int
test: list=5,12,18,25,30 low=10 high=20
expect: => i=2 r=0.0 ok=true s="traced 2 between bounds" errors=0 n=5 res=[5,12,18,25,30] cache=2 hits=0
test: list=1,8,15,22 low=5 high=16
expect: => i=2 r=0.0 ok=true s="traced 2 between bounds" errors=0 n=4 res=[1,8,15,22] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= lo && val <= hi {
			gold_cache_put(g, i, val);
			found++;
		}
	}
	out.i = found;
	out.s.clear();
	format(out.s, "traced ", found, " between bounds");
	out
}
@end
@entry 9b0bf5f49d865ed8
kind: step
verb: trace
noun: middle
modifier: pairwise
context: cache
phrase: trace middle pairwise differences in cache
phrase: compute pairwise middle deltas for cache
test: list=10,20,35,45
expect: => i=15 r=0.0 ok=true s="middle delta 15" errors=0 n=4 res=[10,20,35,45] cache=1 hits=0
test: list=5,15,25,40,50
expect: => i=10 r=0.0 ok=true s="middle delta 10" errors=0 n=5 res=[5,15,25,40,50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff = 0;
	if g.n >= 2 {
		let mid = g.n / 2;
		diff = g.res[mid] - g.res[mid - 1];
		gold_cache_put(g, mid, diff);
	}
	out.i = diff;
	out.s.clear();
	format(out.s, "middle delta ", diff);
	out
}
@end
@entry cad343994522cfe2
kind: step
verb: dedupe
noun: tail
modifier: nested
context: cache
phrase: dedupe tail nested elements within depth {depth}
phrase: filter nested duplicates from tail up to {depth}
slot: depth int
test: list=1,2,3,3,2 depth=3
expect: => i=2 r=0.0 ok=true s="tail uniques 2" errors=0 n=5 res=[1,2,3,3,2] cache=2 hits=0
test: list=10,20,30,20 depth=2
expect: => i=2 r=0.0 ok=true s="tail uniques 2" errors=0 n=4 res=[10,20,30,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let start = if g.n > d { g.n - d } else { 0 };
	var uniques = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in start..i { if g.res[j] == x { seen = true; break; } }
		if !seen {
			gold_cache_put(g, x, i);
			uniques++;
		}
	}
	out.i = uniques;
	out.s.clear();
	format(out.s, "tail uniques ", uniques);
	out
}
@end
@entry 14c32eb3787d4601
kind: step
verb: search
noun: pairs
modifier: safely
context: cache
phrase: search pairs safely matching target sum {target}
phrase: find safe pair sums in cache for {target}
slot: target int
test: list=1,3,5,7,9 target=10
expect: => i=2 r=0.0 ok=true s="found 2 pairs" errors=0 n=5 res=[1,3,5,7,9] cache=2 hits=0
test: list=2,4,6,8 target=8
expect: => i=1 r=0.0 ok=true s="found 1 pairs" errors=0 n=4 res=[2,4,6,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var pairs = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] + g.res[j] == tgt {
				gold_cache_put(g, pairs, tgt);
				pairs++;
			}
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " pairs");
	out
}
@end
