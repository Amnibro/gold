	let max_r = ${max_runs};
	if g.n == 0 { return out; }
	var runs = 1;
	for i in (g.n - 1) {
		if g.res[i] != g.res[i + 1] {
			runs++;
		}
	}
	if runs <= max_r {
		for i in g.n {
			g.res[i] *= 2;
		}
	}
	g.steps += g.n + 1;
	out.i = runs;
	out.s.clear();
	format(out.s, "nested runs count: ", runs);
	out
}
