fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	if g.n == 0 { return out; }
	let mid = g.n / 2;
	let mid_val = g.res[mid];
	let old_v, ok = gold_cache_get(g, k);
	if ok {
		gold_push(g, mid_val + old_v);
	} else {
		gold_cache_put(g, k, mid_val);
		gold_push(g, mid_val);
	}
	g.steps += 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired middle with cache: ", mid_val);
	out
}
@end
