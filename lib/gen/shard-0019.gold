kind: step
verb: swap
noun: evens
modifier: times
context: stats
phrase: swap even parity items count {num} iterations
phrase: exchange even elements across {num} passes
slot: num int
test: list=2,4,6,8 num=2
expect: => i=4 r=0.0 ok=true s="performed 4 even element swaps" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,20,30,40 num=1
expect: => i=2 r=0.0 ok=true s="performed 2 even element swaps" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${num};
	var swaps = 0;
	for p in passes {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i += 2;
		}
	}
	out.i = swaps;
	g.steps += passes * g.n;
	out.s.clear();
	format(out.s, "performed ", swaps, " even element swaps");
	out
}
@end
