@entry ae921743a6f7e8f3
kind: step
verb: retry
noun: steps
modifier: unique
context: stats
phrase: retry deduplication steps recording distinct items
phrase: evaluate unique steps filtering redundant entries
test: list=3,5,3,7,5
expect: => i=3 r=0.0 ok=true s="deduplicated to 3 unique steps" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=2,2,4,4,6
expect: => i=3 r=0.0 ok=true s="deduplicated to 3 unique steps" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var exists = false;
		var j = 0;
		while j < write_idx {
			if g.res[j] == g.res[i] { exists = true; break; }
			j++;
		}
		if !exists {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	out.i = write_idx;
	g.steps += i;
	out.s.clear();
	format(out.s, "deduplicated to ", write_idx, " unique steps");
	out
}
@end
