fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let take = if k > g.n { g.n } else { k };
	var prod = 1;
	var i = 0;
	while i < take {
		prod *= g.res[g.n - 1 - i];
		i++;
	}
	g.steps += take;
	out.i = prod;
	out.s.clear();
	format(out.s, "product of last steps: ", prod);
	out
}
@end
