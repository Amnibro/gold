@entry 1eab3a5627004877
kind: step
verb: scale
noun: item
modifier: recursively
context: sort
slot: ratio int
phrase: sort scale item recursively by ratio {ratio}
phrase: recursively adjust sorted items by ratio {ratio}
test: list=10,20,30 ratio=3
expect: => i=1 r=0.0 ok=true s="scaled 1 divisible items" errors=0 n=3 res=[10,20,10] cache=0 hits=0
test: list=4,8,16 ratio=2
expect: => i=3 r=0.0 ok=true s="scaled 3 divisible items" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${ratio};
	var adjusted = 0;
	if r != 0 {
		for i in g.n {
			if g.res[i] % r == 0 {
				g.res[i] = g.res[i] / r;
				adjusted++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "scaled ", adjusted, " divisible items");
	out
}
@end
