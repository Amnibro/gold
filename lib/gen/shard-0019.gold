expect: => i=3 r=0.0 ok=true s="clamped series with retry across 3 items" errors=0 n=3 res=[1,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	var non_zero = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
		}
		if g.res[i] > 0 { non_zero++; }
	}
	if non_zero == 0 && g.n > 0 {
		g.res[0] = 1;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped series with retry across ", g.n, " items");
	out
}
@end
