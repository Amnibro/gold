@entry d4e952fe59587a62
kind: step
verb: group
noun: limit
modifier: at_most
context: error
phrase: group error chunks summing at most {maxsum}
phrase: bundle faults into sums at most limit {maxsum}
slot: maxsum int
test: list=10,20,30,40 maxsum=35
expect: => i=3 r=0.0 ok=true s="grouped limit chunks: 3" errors=0 n=3 res=[30,30,40] cache=0 hits=0
test: list=5,10,15 maxsum=100
expect: => i=1 r=0.0 ok=true s="grouped limit chunks: 1" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${maxsum};
	var groups = 0;
	var cur_sum = 0;
	var m = 0;
	for i in g.n {
		if cur_sum + g.res[i] > cap && cur_sum > 0 {
			g.res[m] = cur_sum;
			m++;
			cur_sum = g.res[i];
			groups++;
		} else {
			cur_sum += g.res[i];
		}
	}
	if cur_sum > 0 {
		g.res[m] = cur_sum;
		m++;
		groups++;
	}
	g.n = m;
	g.steps += g.n + groups;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped limit chunks: ", groups);
	out
}
@end
@entry a5a27ec8fae0ed3a
kind: step
verb: compare
noun: items
modifier: with_retry
context: error
phrase: compare error items against {target} with {retries} retries
phrase: search fault items for {target} allowing {retries} retries
slot: target int
slot: retries int
test: list=100,404,500 target=404 retries=3
expect: => i=1 r=0.0 ok=true s="comparison attempts: 1" errors=0 n=3 res=[100,404,500] cache=0 hits=0
test: list=200,300 target=500 retries=2
expect: => i=2 r=0.0 ok=false s="comparison attempts: 2" errors=1 n=2 res=[200,300] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var found = false;
	var attempts = 0;
	while attempts < max_r && attempts < g.n {
		if g.res[attempts] == tgt {
			found = true;
			break;
		}
		attempts++;
	}
	if !found {
		gold_fail(g, "target error not found within retries");
		out.ok = false;
	}
	g.steps += attempts + 1;
	out.i = attempts;
	out.s.clear();
	format(out.s, "comparison attempts: ", attempts);
	out
}
@end
