fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = ${extra_val};
	if g.n < 512 {
		gold_push(g, val);
		var j = g.n - 1;
		while j > 0 && g.res[j] < g.res[j - 1] {
			let tmp = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = tmp;
			j--;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged value into sorted list of ", g.n, " items");
	out
}
