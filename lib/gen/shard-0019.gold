expect: => i=3 r=0.0 ok=true s="nested duplicates: 3" errors=0 n=5 res=[8,8,8,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_val};
	var dup_count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] && g.res[i] > lim {
				dup_count++;
				break;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "nested duplicates: ", dup_count);
	out
}
@end
@entry 9a47d0e536231b92
kind: step
verb: dedupe
noun: letters
modifier: while
context: math
slot: max_len int
phrase: dedupe string letters while length remains under {max_len}
phrase: prune duplicate letters while count below limit {max_len}
test: text="aabbcdeeff" max_len=6
expect: => i=6 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" max_len=5
expect: => i=4 r=0.0 ok=true s="misp" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var clean: byte[..200] = [];
	var i = 0;
	while i < out.s.len && clean.len < lim {
		let b = out.s[i];
		var found = false;
		for c in clean {
			if c == b { found = true; break; }
		}
		if !found {
			clean.push(b);
		}
		i++;
	}
	out.s = clean;
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry 6b5b4b0d5cf2e356
kind: step
verb: rotate
noun: threshold
modifier: at_least
context: math
slot: min_val int
phrase: rotate elements exceeding threshold at least {min_val}
phrase: cycle list values having magnitude at least {min_val}
test: list=12,3,25,8,30 min_val=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[30,12,25] cache=0 hits=0
test: list=5,50,6,60 min_val=20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[60,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_val};
	var high: int[512] = [0; 512];
	var hn = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= thresh {
			high[hn] = g.res[i];
			hn++;
		}
		i++;
	}
	if hn > 1 {
		let last = high[hn - 1];
		var j = hn - 1;
		while j > 0 {
			high[j] = high[j - 1];
			j--;
		}
		high[0] = last;
	}
	gold_clear(g);
	var k = 0;
	while k < hn {
		gold_push(g, high[k]);
		k++;
	}
	g.steps += g.n;
	out.i = hn;
	out
}
@end
