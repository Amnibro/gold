code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] * f + g.res[2 * i + 1];
	}
	g.n = pairs;
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired into ", pairs, " combined items");
	out
}
@end
