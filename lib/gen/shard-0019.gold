fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${lim};
	var match_cnt = 0;
	for i in g.n {
		if g.res[i] < cutoff {
			g.res[i] = -g.res[i];
			match_cnt++;
		}
	}
	out.i = match_cnt;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "inverted ", match_cnt, " sub-minimum items");
	out
}
