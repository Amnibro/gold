code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_sum};
	var running = 0;
	var w = 0;
	for i in g.n {
		running += g.res[i];
		if running < cap {
			g.res[w] = g.res[i];
			w++;
		} else {
			break;
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "kept ", w, " items under running sum");
	out
}
@end
