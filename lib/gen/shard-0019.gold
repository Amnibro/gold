slot: limit int
test: arg=10,15 limit=20
expect: 4
expect: 6
test: arg=5 limit=10
expect: 3
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	let bound = if n < lim { n } else { lim };
	if bound < 2 { return 0; }
	var count = 0;
	var candidate = 2;
	while candidate <= bound {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { count++; }
		candidate++;
	}
	count
}
@end
