code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k <= 0 { return out; }
	var sum = 0;
	for i in k { sum += g.res[i]; }
	var rest = [0; 512];
	var r_len = 0;
	var idx = k;
	while idx < g.n {
		rest[r_len] = g.res[idx];
		r_len++;
		idx++;
	}
	g.n = 0;
	gold_push(g, sum);
	for j in r_len { gold_push(g, rest[j]); }
	out.i = sum;
	out.s.clear();
	format(out.s, "first sum: ", sum);
	out
}
@end
