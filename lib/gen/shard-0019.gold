@entry 02b56c922a470233
kind: step
verb: cycle
noun: sequence
modifier: head
context: list
phrase: cycle sequence head element to back
phrase: rotate first element to tail of sequence
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="cycle sequence head: 1" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=10,20
expect: => i=10 r=0.0 ok=true s="cycle sequence head: 10" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var head = 0;
	if g.n > 1 {
		head = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = head;
	} else if g.n == 1 {
		head = g.res[0];
	}
	out.i = head;
	out.s.clear();
	format(out.s, "cycle sequence head: ", head);
	out
}
@end
