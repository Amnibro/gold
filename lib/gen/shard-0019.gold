test: arg=112233,123
expect: 3
expect: 3
test: arg=777
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var runs = 0;
	var prev = -1;
	while x > 0 {
		let cur = x % 10;
		if cur != prev {
			runs++;
			prev = cur;
		}
		x /= 10;
	}
	runs
}
@end
