code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in ${count} {
		let key = ${start} + k;
		let val, ok = gold_cache_get(g, key);
		if ok {
			gold_push(g, val);
		} else {
			let comp = key * 2;
			gold_cache_put(g, key, comp);
			gold_push(g, comp);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "range populated: ", g.n);
	out
}
@end
