@entry af57f2fbd69722a7
kind: step
verb: swap
noun: words
modifier: at_least
context: transform
phrase: swap adjacent items with difference at least {diff}
phrase: exchange neighboring elements differing by at least {diff}
slot: diff int
test: list=1,10,2,20 diff=5
expect: => i=2 r=0.0 ok=true s="swapped words at least diff: 2" errors=0 n=4 res=[10,1,20,2] cache=0 hits=0
test: list=5,15,4,25 diff=8
expect: => i=2 r=0.0 ok=true s="swapped words at least diff: 2" errors=0 n=4 res=[15,5,25,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let delta = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if delta >= d {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
		}
		i += 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped words at least diff: ", swaps);
	out
}
@end
