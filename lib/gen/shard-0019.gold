fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	var streak = 0;
	var clamped = 0;
	for i in g.n {
		if g.res[i] > 0 {
			streak++;
			if streak > ms {
				g.res[i] = 0;
				clamped++;
			}
		} else {
			streak = 0;
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " running streak elements");
	out
}
@end
@entry 2d1ebba2b7f494d7
kind: step
verb: dedupe
noun: steps
modifier: none
context: search
phrase: dedupe steps from search trace
phrase: remove duplicate steps in search trace
test: list=10,20,10,30,20
expect: => i=2 r=0.0 ok=true s="deduped 2 search steps" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,5,8,9,8
expect: => i=3 r=0.0 ok=true s="deduped 3 search steps" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " search steps");
	out
}
@end
@entry 1d867776ea875d5e
kind: step
verb: sort
noun: threshold
modifier: in_place
context: search
slot: thresh int
phrase: sort threshold in place around score {thresh}
phrase: partition search items in place by threshold {thresh}
test: list=50,10,40,20 thresh=30
expect: => i=4 r=0.0 ok=true s="sorted in place around threshold 30" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=100,5,80,15 thresh=50
expect: => i=4 r=0.0 ok=true s="sorted in place around threshold 50" errors=0 n=4 res=[5,15,80,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			let swap_needed = (g.res[i] >= th && g.res[j] < th) || (g.res[i] > g.res[j] && ((g.res[i] < th && g.res[j] < th) || (g.res[i] >= th && g.res[j] >= th)));
			if swap_needed {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted in place around threshold ", th);
	out
}
@end
