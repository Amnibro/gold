@entry 5cd894dae64dbef2
kind: step
verb: trace
noun: average
modifier: in_reverse
context: search
phrase: trace average in reverse over search scores
phrase: compute backward running average across search scores
test: list=10,20,30,40
expect: => i=25 r=0.0 ok=true s="backward average search score: 25" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=100,50,25
expect: => i=58 r=0.0 ok=true s="backward average search score: 58" errors=0 n=3 res=[100,50,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	var k = g.n - 1;
	while k >= 0 {
		sum += g.res[k];
		k--;
	}
	let avg = sum / g.n;
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "backward average search score: ", avg);
	out
}
@end
