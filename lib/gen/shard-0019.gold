fn ${ID}(n int) int {
	var x = n;
	if x < 0 {
		x = -x;
	}
	var sum = 0;
	var temp = x;
	while temp > 0 {
		sum += temp % 10;
		temp = temp / 10;
	}
	sum * 1000 + (x % 100) + 1
}
@end
