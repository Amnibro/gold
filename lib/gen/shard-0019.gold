expect: => i=46 r=0.0 ok=true s="merged 2 items into sum 46" errors=0 n=5 res=[8,18,28,38,46] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l_val = ${lo};
	let h_val = ${hi};
	var merged_sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= l_val && g.res[i] <= h_val {
			merged_sum += g.res[i];
			count++;
		}
	}
	gold_push(g, merged_sum);
	out.i = merged_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "merged ", count, " items into sum ", merged_sum);
	out
}
@end
