code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid_gaps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let gap = g.res[i] - g.res[i - 1];
			if gap > mg { break; }
			valid_gaps++;
		}
	}
	g.steps += valid_gaps + 1;
	out.i = valid_gaps;
	out.s.clear();
	format(out.s, "counted ", valid_gaps, " gaps within limit");
	out
}
@end
