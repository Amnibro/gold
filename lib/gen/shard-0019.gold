phrase: invert items up to checkpoint sentinel {target}
slot: target int
test: list=1,2,3,9,5 target=9
expect: => i=3 r=0.0 ok=true s="reversed until checkpoint: 3" errors=0 n=5 res=[9,3,2,1,5] cache=0 hits=0
test: list=4,5,6,7 target=6
expect: => i=2 r=0.0 ok=true s="reversed until checkpoint: 2" errors=0 n=4 res=[6,5,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var mark = -1;
	for i in g.n {
		if g.res[i] == tgt {
			mark = i;
			break;
		}
	}
	if mark > 0 {
		var l = 0;
		var r = mark;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n + 1;
	out.i = mark;
	out.s.clear();
	format(out.s, "reversed until checkpoint: ", mark);
	out
}
@end
