@entry 0dd6aaf7cd3128ea
kind: step
verb: apply
noun: series
modifier: last
context: error
phrase: apply series progression backwards from last error
phrase: cumulate fault series backwards from trailing value
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="applied series from last: 3" errors=0 n=3 res=[6,5,3] cache=0 hits=0
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="applied series from last: 4" errors=0 n=4 res=[100,90,70,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var acc = g.res[g.n - 1];
		var i = g.n - 2;
		while i >= 0 {
			g.res[i] += acc;
			acc = g.res[i];
			i--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied series from last: ", g.n);
	out
}
@end
@entry d8c073d7c41e437b
kind: step
verb: shift
noun: average
modifier: every_other
context: error
phrase: shift error values by every other average
phrase: offset faults using alternate index average
test: list=10,20,30,40
expect: => i=20 r=0.0 ok=true s="shifted by average: 20" errors=0 n=4 res=[-10,0,10,20] cache=0 hits=0
test: list=100,50,300
expect: => i=200 r=0.0 ok=true s="shifted by average: 200" errors=0 n=3 res=[-100,-150,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no errors to shift");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var cnt = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		cnt++;
		i += 2;
	}
	let avg = if cnt > 0 { sum / cnt } else { 0 };
	for j in g.n {
		g.res[j] -= avg;
	}
	g.steps += g.n + cnt;
	out.i = avg;
	out.s.clear();
	format(out.s, "shifted by average: ", avg);
	out
}
@end
@entry dc7176edda7bc86f
kind: step
verb: cache
noun: gaps
modifier: at_most
context: error
phrase: cache error gaps at most {maxgap}
phrase: store fault intervals at most limit {maxgap} in cache
slot: maxgap int
test: list=10,12,20,23 maxgap=5
expect: => i=2 r=0.0 ok=true s="cached gaps at most: 2" errors=0 n=4 res=[10,12,20,23] cache=2 hits=0
test: list=10,50 maxgap=5
expect: => i=0 r=0.0 ok=true s="cached gaps at most: 0" errors=0 n=2 res=[10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${maxgap};
	var stored = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let gap = if diff < 0 { -diff } else { diff };
			if gap <= mg {
				gold_cache_put(g, i, gap);
				stored++;
			}
		}
	}
	g.steps += g.n + stored;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached gaps at most: ", stored);
	out
}
@end
@entry 32c5ecc87a46bc35
kind: step
verb: apply
noun: digits
modifier: nested
context: error
phrase: apply nested digit reduction to depth {depth}
phrase: reduce error digits iteratively to level {depth}
slot: depth int
test: list=599,488 depth=2
expect: => i=2 r=0.0 ok=true s="nested digit reduction: 2" errors=0 n=2 res=[5,2] cache=0 hits=0
test: list=12,34 depth=1
expect: => i=2 r=0.0 ok=true s="nested digit reduction: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		while d < max_d && x >= 10 {
			var sum = 0;
			while x > 0 {
				sum += x % 10;
				x /= 10;
			}
			x = sum;
			d++;
		}
		g.res[i] = x;
	}
	g.steps += g.n * max_d;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested digit reduction: ", g.n);
	out
}
@end
