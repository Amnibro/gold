expect: => doc: cliff1 box 0,6,2 16,3,4 m:matte #6e5f4d
expect: => doc: cave2 capsule -6,6,1 -6,3,1 r1.2 m:matte #3a352f
expect: => doc: cave3 capsule -2,6,1 -2,3,1 r1.2 m:matte #3a352f
expect: => doc: cave4 capsule 2,6,1 2,3,1 r1.2 m:matte #3a352f
