fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 0 .. g.n / 2 {
		let t = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = t;
	}
	var prime_count = 0;
	for i in 0 .. g.n {
		let x = g.res[i];
		if x >= 5 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prime_count++; }
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "reverse_primes_at_least: ", prime_count);
	out
}
@end
