fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			let s1 = ${f}(g.res[i]);
			let s2 = ${f}(g.res[j]);
			if s1 > s2 {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items by function");
	out
}
@end
@entry bc6b8fa5f75bdf96
kind: step
verb: sort
noun: steps
modifier: between
context: search
slot: lo int
slot: hi int
phrase: sort steps between indices {lo} to {hi}
phrase: order search steps between bounds {lo} to {hi}
test: list=50,40,30,20,10 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted subrange between 1 and 3" errors=0 n=5 res=[50,20,30,40,10] cache=0 hits=0
test: list=9,8,7,6,5,4 lo=2 hi=4
expect: => i=3 r=0.0 ok=true s="sorted subrange between 2 and 4" errors=0 n=6 res=[9,8,5,6,7,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = if ${lo} < 0 { 0 } else { ${lo} };
	let high = if ${hi} >= g.n { g.n - 1 } else { ${hi} };
	if low < high {
		var i = low;
		while i <= high {
			var j = i + 1;
			while j <= high {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n + 1;
	out.i = high - low + 1;
	out.s.clear();
	format(out.s, "sorted subrange between ", low, " and ", high);
	out
}
@end
