fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * p;
	out.i = p;
	out.s.clear();
	format(out.s, "sorted steps with ", p, " retry passes");
	out
}
