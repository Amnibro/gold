	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var cached = 0;
	let pairs = g.n - 1;
	for k in pairs {
		let sum_val = g.res[k] + g.res[k + 1];
		if cached < ${cap} {
			gold_cache_put(g, k + 10, sum_val);
			cached++;
		}
		g.res[k] = sum_val;
	}
	g.n = pairs;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " pairwise sums until limit");
	out
}
@end
