phrase: count search occurrences with cache for {target}
test: list=10,20,10,30,10 target=10
expect: => i=3 r=0.0 ok=true s="returned tally for 10: 3" errors=0 n=5 res=[10,20,10,30,10] cache=1 hits=0
test: list=5,8,5,9 target=5
expect: => i=2 r=0.0 ok=true s="returned tally for 5: 2" errors=0 n=4 res=[5,8,5,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var tally = 0;
	for i in g.n {
		if g.res[i] == tgt { tally++; }
	}
	gold_cache_put(g, tgt, tally);
	g.steps += g.n + 1;
	out.i = tally;
	out.s.clear();
	format(out.s, "returned tally for ", tgt, ": ", tally);
	out
}
@end
@entry 334187795acdda59
kind: step
verb: repeat
noun: errors
modifier: all
context: search
slot: factor int
phrase: repeat errors all search failures by {factor}
phrase: amplify all search error codes by {factor}
test: list=-1,20,-3 factor=2
expect: => i=5 r=0.0 ok=true s="repeated error occurrences to 5 items" errors=0 n=5 res=[-1,-1,20,-3,-3] cache=0 hits=0
test: list=-5,-2,10 factor=3
expect: => i=7 r=0.0 ok=true s="repeated error occurrences to 7 items" errors=0 n=7 res=[-5,-5,-5,-2,-2,-2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var temp int[512] = [0; 512];
	var t_n = 0;
	for i in g.n {
		let x = g.res[i];
		let count = if x < 0 { f } else { 1 };
		for k in count {
			if t_n < 512 {
				temp[t_n] = x;
				t_n++;
			}
		}
	}
	for i in t_n { g.res[i] = temp[i]; }
	g.n = t_n;
	g.steps += t_n + 1;
	out.i = t_n;
	out.s.clear();
	format(out.s, "repeated error occurrences to ", t_n, " items");
	out
}
@end
