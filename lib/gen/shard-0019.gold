fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let temp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = temp;
			}
		}
	}
	let last = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.i = last;
	out.s.clear();
	format(out.s, "sort sequence ascending: ", g.n);
	out
}
