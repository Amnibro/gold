expect: => i=4 r=0.0 ok=true s="swapped evens: 2" errors=0 n=5 res=[20,10,3,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[count] = i;
			count++;
		}
	}
	var p = 0;
	while p + 1 < count {
		let idx1 = evens[p];
		let idx2 = evens[p + 1];
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		p += 2;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "swapped evens: ", count / 2);
	out
}
@end
