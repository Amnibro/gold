fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept int[64];
	var kn = 0;
	kept[0] = g.res[0];
	kn = 1;
	for i in g.n {
		if i > 0 && g.res[i] >= kept[kn - 1] {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	gold_clear(g);
	for i in kn {
		gold_push(g, kept[i]);
	}
	g.steps += kn + 1;
	out.i = kn;
	out.s.clear();
	format(out.s, "selected sorted list items: ", kn);
	out
}
