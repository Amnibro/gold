code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence");
		out.ok = false;
		return out;
	}
	let cached, hit = gold_cache_get(g, ${k});
	if hit {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached");
		return out;
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	gold_cache_put(g, ${k}, total);
	out.i = total;
	out.s.clear();
	format(out.s, "computed");
	out
}
@end
