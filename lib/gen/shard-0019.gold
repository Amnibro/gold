	var steps = 0;
	while curr > 1 && steps < 50 {
		if curr % 2 == 0 { curr /= 2; }
		else { curr = 3 * curr + 1; }
		if curr > max_seen { max_seen = curr; }
		steps++;
	}
	if max_seen > cap { cap } else { max_seen }
}
@end
