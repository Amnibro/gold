fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var m = 0;
	for i in g.n {
		let val = g.res[i];
		if val > t {
			var found = false;
			for j in m {
				if g.res[j] == val { found = true; break; }
