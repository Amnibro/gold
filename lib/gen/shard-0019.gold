noun: range
modifier: at_least
context: stats
phrase: scale sample range at least meeting minimum {m}
phrase: expand spread range at least exceeding {m}
slot: m int
test: list=10,20,50 m=30
expect: => i=40 r=0.0 ok=true s="sample range 40" errors=0 n=3 res=[20,40,100] cache=0 hits=0
test: list=5,15,40 m=25
expect: => i=35 r=0.0 ok=true s="sample range 35" errors=0 n=3 res=[10,30,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	for i in g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
	}
	let rng = mx - mn;
	let req = ${m};
	if rng >= req {
		for i in g.n { g.res[i] *= 2; }
	}
	out.i = rng;
	g.steps += g.n * 2;
	out.s.clear();
	format(out.s, "sample range ", rng);
	out
}
@end
@entry 57293fb9d8b0e09d
kind: step
verb: swap
noun: evens
modifier: in_reverse
context: stats
phrase: swap even values in reverse order
phrase: reverse even parity sample observations
test: list=2,5,4,7,6
expect: => i=3 r=0.0 ok=true s="reversed 3 even items" errors=0 n=5 res=[6,5,4,7,2] cache=0 hits=0
test: list=8,3,10,1,12
expect: => i=3 r=0.0 ok=true s="reversed 3 even items" errors=0 n=5 res=[12,3,10,1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ev_count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { ev_count++; }
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		while left < right && g.res[left] % 2 != 0 { left++; }
		while left < right && g.res[right] % 2 != 0 { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = ev_count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reversed ", ev_count, " even items");
	out
}
@end
