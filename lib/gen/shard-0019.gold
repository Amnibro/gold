@entry 1de2791318b05a1e
kind: step
verb: return
noun: average
modifier: recursively
context: math
slot: depth int
phrase: return recursive average up to depth {depth}
phrase: compute recursive smoothing average with depth {depth}
test: list=10,20,30,40 depth=2
expect: => i=20 r=0.0 ok=true s="" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=100,200 depth=1
expect: => i=150 r=0.0 ok=true s="" errors=0 n=1 res=[150] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 { return out; }
	var round = 0;
	while round < d && g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
			i++;
		}
		g.n--;
		round++;
	}
	g.steps += round * g.n;
	out.i = g.res[0];
	out
}
@end
