@entry 842c4f571793e6ff
kind: step
verb: splice
noun: items
modifier: index
context: list
slot: at_index int
slot: new_val int
phrase: splice items replacing at index {at_index} with {new_val}
phrase: overwrite element at index {at_index} with {new_val}
test: list=10,20,30 at_index=1 new_val=99
expect: => i=99 r=0.0 ok=true s="splice items index: ok" errors=0 n=3 res=[10,99,30] cache=0 hits=0
test: list=10,20 at_index=5 new_val=99
expect: => i=0 r=0.0 ok=true s="splice items index: out_of_bounds" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${at_index};
	let elem = ${new_val};
	if idx >= 0 && idx < g.n {
		g.res[idx] = elem;
		out.i = elem;
		out.s.clear();
		format(out.s, "splice items index: ok");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "splice items index: out_of_bounds");
	}
	out
}
@end
