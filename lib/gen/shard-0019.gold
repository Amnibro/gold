test: list=10,12,14,100
expect: => i=36 r=12.0 ok=true s="measured trimmed average" errors=0 n=4 res=[10,12,14,100] cache=0 hits=0
test: list=20,22,24,200
expect: => i=66 r=22.0 ok=true s="measured trimmed average" errors=0 n=4 res=[20,22,24,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.r = 0.0;
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var sum_val = 0;
	var count = 0;
	for k in g.n {
		if g.n > 2 && k == max_idx { continue; }
		sum_val += g.res[k];
		count++;
	}
	let avg = sum_val as real / count as real;
	out.r = avg;
	out.i = sum_val;
	out.s.clear();
	format(out.s, "measured trimmed average");
	out
}
@end
@entry d2bb2c3f9019b760
kind: step
verb: select
noun: items
modifier: nested
context: loop
phrase: select items where nested divisor count exceeds {min_div}
phrase: filter items having nested factor count above {min_div}
slot: min_div int
test: list=12,7,18,11 min_div=3
expect: => i=2 r=0.0 ok=true s="selected 2 items meeting divisor threshold" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=8,9,13,16 min_div=2
expect: => i=3 r=0.0 ok=true s="selected 3 items meeting divisor threshold" errors=0 n=3 res=[8,9,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var div_count = 0;
		var d = 1;
		while d <= x {
			if x % d == 0 { div_count++; }
			d++;
		}
		if div_count > ${min_div} {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " items meeting divisor threshold");
	out
}
@end
