noun: item
modifier: running
context: loop
phrase: limit running items under ceiling {ceiling}
phrase: cap running item values at ceiling {ceiling}
slot: ceiling int
test: list=20,30,40,50 ceiling=60
expect: => i=2 r=0.0 ok=true s="limited items running: 2" errors=0 n=4 res=[20,30,10,0] cache=0 hits=0
test: list=10,15,25 ceiling=35
expect: => i=1 r=0.0 ok=true s="limited items running: 1" errors=0 n=3 res=[10,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var run = 0;
	var clamped = 0;
	for i in g.n {
		if run + g.res[i] > cap {
			g.res[i] = cap - run;
			if g.res[i] < 0 { g.res[i] = 0; }
			clamped++;
		}
		run += g.res[i];
	}
	g.steps += g.n + clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited items running: ", clamped);
	out
}
@end
