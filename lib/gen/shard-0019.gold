test: list=1,1,2,3,3,4 shift=10
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[11,12,13,14] cache=0 hits=0
test: list=5,5,5,8,9 shift=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[7,10,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n == 0 { return out; }
	var w = 1;
	var r = 1;
	while r < g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
		r++;
	}
	g.n = w;
	var i = 0;
	while i < g.n {
		g.res[i] += s;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
