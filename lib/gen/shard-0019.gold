test: img=32 u=3
expect: => i=1024 r=0.0 ok=true s="metal" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=124610 hash=276461
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 4;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "metal");
	out
}
@end
