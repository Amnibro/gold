code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${t};
	var run_sum = 0;
	var clamped = 0;
	for i in g.n {
		run_sum += g.res[i];
		if run_sum > thresh {
			g.res[i] = 0;
			clamped++;
		}
	}
	g.steps += g.n + clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "normalized running threshold: ", clamped);
	out
}
@end
