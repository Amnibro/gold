fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnew(g, "hole", o);
	o.append(" cyl ");
	o.append("0,");
	o.append("0,");
	o.append("0 ");
	o.append("0,");
	o.append("0,");
	o.append("0.");
	o.append("05 r");
	gold_fnum(o, ${r});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "shlholenone");
	out
}
@end
