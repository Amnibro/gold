fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var swaps = 0;
	for pass in g.n {
		for i in (g.n - 1) {
			if swaps < b && g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "budgeted swaps in place: ", swaps);
	out
}
@end
