@entry 0a82c5a5a287f5c4
kind: step
verb: scale
noun: gaps
modifier: up_to
context: sort
slot: max_scale int
phrase: sort scale gaps up to bound {max_scale}
phrase: expand adjacent intervals up to factor {max_scale}
test: list=1,3,6,10 max_scale=2
expect: => i=4 r=0.0 ok=true s="scaled gaps up to factor 2" errors=0 n=4 res=[1,5,11,19] cache=0 hits=0
test: list=2,5,9 max_scale=3
expect: => i=3 r=0.0 ok=true s="scaled gaps up to factor 3" errors=0 n=3 res=[2,11,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_scale};
	if g.n > 1 {
		var prev = g.res[0];
		for i in 1..g.n {
			let gap = g.res[i] - prev;
			prev = g.res[i];
			g.res[i] = g.res[i - 1] + gap * ms;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled gaps up to factor ", ms);
	out
}
@end
@entry 1dffd72aa2b185c4
kind: step
verb: check
noun: runs
modifier: safely
context: sort
slot: min_run int
phrase: sort check runs safely for length {min_run}
phrase: safely inspect ordered runs for threshold {min_run}
test: list=1,2,3,5,6 min_run=3
expect: => i=3 r=0.0 ok=true s="longest consecutive run was 3" errors=0 n=5 res=[1,2,3,5,6] cache=0 hits=0
test: list=1,3,5,7 min_run=3
expect: => i=1 r=0.0 ok=false s="longest consecutive run was 1" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var max_run = if g.n > 0 { 1 } else { 0 };
	var cur_run = 1;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] + 1 {
				cur_run++;
				if cur_run > max_run { max_run = cur_run; }
			} else {
				cur_run = 1;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = max_run;
	out.ok = max_run >= mr;
	out.s.clear();
	format(out.s, "longest consecutive run was ", max_run);
	out
}
@end
@entry bf18cb8c2048f0a5
