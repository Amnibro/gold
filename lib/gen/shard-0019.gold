fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in 0 .. g.n {
		if g.res[i] > 0 { sum += g.res[i]; }
	}
	if sum == 0 {
		for i in 0 .. g.n {
			let abs_v = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
			sum += abs_v;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "measure_subfunction_with_retry: ", sum);
	out
}
