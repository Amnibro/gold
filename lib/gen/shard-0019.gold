code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		return out;
	}
	var first_gaps int[512] = [0; 512];
	let n1 = g.n - 1;
	for i in n1 {
		first_gaps[i] = g.res[i + 1] - g.res[i];
	}
	let n2 = n1 - 1;
	for i in n2 {
		g.res[i] = first_gaps[i + 1] - first_gaps[i];
	}
	g.n = n2;
	out.i = n2;
	out.s.clear();
	format(out.s, "mapped ", n2, " recursive gap differences");
	out
}
@end
