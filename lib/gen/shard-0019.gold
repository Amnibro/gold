code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var target = -1;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] % 2 == 0 {
			target = g.res[idx];
			break;
		}
		idx--;
	}
	g.steps += g.n;
	if target >= 0 {
		out.i = target;
		out.ok = true;
	} else {
		gold_fail(g, "retry evens last not found");
		out.i = 0;
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "retry_evens_last: ", out.i);
	out
}
@end
