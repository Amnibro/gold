test: text="one two three four five" max_words=3
expect: => i=5 r=0.0 ok=false s="one two three four five" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_words};
	var words = 0;
	var in_w = false;
	for b in out.s {
		if b == ' ' || b == '	' {
			in_w = false;
		} else if !in_w {
			in_w = true;
			words++;
		}
	}
	g.steps += words;
	out.i = words;
	out.ok = words <= lim;
	if !out.ok {
		gold_fail(g, "word limit exceeded");
	}
	out
}
@end
