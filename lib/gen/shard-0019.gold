fn ${ID}(g Gold&, v Val) Val {
	let ceiling = ${cap};
	var out = v;
	out.s.clear();
	if ceiling <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		return out;
	}
	format(out.s, "hist_cap(", ceiling, "): [");
	var distinct = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first {
			var occ = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { occ++; }
			}
			let capped_occ = if occ > ceiling { ceiling } else { occ };
			if distinct > 0 { format(out.s, ", "); }
			format(out.s, g.res[i], ":", capped_occ);
			distinct++;
		}
	}
	format(out.s, "]");
	out.i = distinct;
	g.steps += g.n * g.n;
	out
}
@end
