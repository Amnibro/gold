fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	for i in g.n {
		if !found {
			for j in i {
				if g.res[j] == g.res[i] {
					g.res[i] = 0;
					found = true;
					break;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "normalized first duplicate: ", out.i);
	out
}
