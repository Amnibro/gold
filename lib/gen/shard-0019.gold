expect: => i=4 r=0.0 ok=true s="counted prime elements: 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=10,12,14,16
expect: => i=0 r=0.0 ok=true s="counted prime elements: 0" errors=0 n=4 res=[10,12,14,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "counted prime elements: ", primes);
	out
}
@end
