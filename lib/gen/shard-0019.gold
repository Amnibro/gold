expect: 52
expect: 124
test: arg=789 decay=1
expect: 218
test: arg=0 decay=2
expect: 0
code:
fn ${ID}(n int) int {
	let d = ${decay};
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var weight = 10;
	while x > 0 {
		let digit = x % 10;
		res += digit * weight;
		weight = if weight > d { weight - d } else { 1 };
		x /= 10;
	}
	res
}
@end
