fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var freqs int[512] = [0; 512];
	for i in g.n {
		var c = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { c++; }
		}
		freqs[i] = c;
	}
	for i in g.n {
		g.res[i] = freqs[i];
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped unique tallies");
	out
}
@end
