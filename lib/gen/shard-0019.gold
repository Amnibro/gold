fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${lim};
	let half = g.n / 2;
	var sfx_cnt = 0;
	var i = half;
	while i < g.n {
		if g.res[i] > cutoff { sfx_cnt++; }
		i++;
	}
	out.i = sfx_cnt;
	g.steps += g.n - half;
	out.s.clear();
	format(out.s, "suffix items above bound: ", sfx_cnt);
	out
}
@end
