noun: window
modifier: in_reverse
context: search
slot: w_len int
phrase: repeat window in reverse span {w_len}
phrase: mirror search window in reverse size {w_len}
test: list=10,20,30,40 w_len=3
expect: => i=3 r=0.0 ok=true s="mirrored reverse window of 3 items" errors=0 n=7 res=[10,20,30,40,40,30,20] cache=0 hits=0
test: list=1,2,3,4,5 w_len=2
expect: => i=2 r=0.0 ok=true s="mirrored reverse window of 2 items" errors=0 n=7 res=[1,2,3,4,5,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${w_len};
	let win_size = if w < g.n { w } else { g.n };
	let orig_n = g.n;
	var appended = 0;
	var k = orig_n - 1;
	while k >= orig_n - win_size && g.n < 512 {
		g.res[g.n] = g.res[k];
		g.n++;
		appended++;
		k--;
	}
	g.steps += appended + 1;
	out.i = appended;
	out.s.clear();
	format(out.s, "mirrored reverse window of ", appended, " items");
	out
}
@end
