fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	for i in g.n {
		g.res[i] = g.res[i] * m;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " items in reverse");
	out
}
