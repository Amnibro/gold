fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${cap} <= 0 || ${step} < 0 {
		gold_fail(g, "cap must be positive and step non-negative");
		out.ok = false;
		return out;
	}
	var total = out.i + ${step};
	if total > ${cap} {
		total = ${cap};
	}
	out.i = total;
	out.s.clear();
	format(out.s, "running");
	out
}
