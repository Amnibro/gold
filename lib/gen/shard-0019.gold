code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count < 0 { gold_fail(g, "count cannot be negative"); out.ok = false; return out; }
	let take = if count > g.n { g.n } else { count };
	let start = g.n - take;
	for i in take {
		g.res[i] = g.res[start + i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "collected list last: ", take);
	out
}
@end
