@entry a8a0022ed3f65616
kind: step
verb: dedupe
noun: item
modifier: between
context: search
slot: lo int
slot: hi int
phrase: dedupe item between search limits {lo} to {hi}
phrase: remove duplicate search items between {lo} to {hi}
test: list=5,10,20,10,30,20,50 lo=10 hi=25
expect: => i=2 r=0.0 ok=true s="deduped 2 items in range" errors=0 n=5 res=[5,10,20,30,50] cache=0 hits=0
test: list=2,8,8,12,12,20 lo=5 hi=15
expect: => i=2 r=0.0 ok=true s="deduped 2 items in range" errors=0 n=4 res=[2,8,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		if x >= low && x <= high {
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " items in range");
	out
}
@end
