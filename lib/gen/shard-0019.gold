@entry b30e6c2857e37d73
kind: step
verb: shift
noun: results
modifier: times
context: error
phrase: shift error results {times} times
phrase: rotate fault sequence {times} cycles
slot: times int
test: list=10,20,30,40 times=1
expect: => i=1 r=0.0 ok=true s="shifted results: 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=1,2,3 times=2
expect: => i=2 r=0.0 ok=true s="shifted results: 2" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 1 && t > 0 {
		for step in (t % g.n) {
			let first = g.res[0];
			for i in (g.n - 1) {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n + t;
	out.i = t;
	out.s.clear();
	format(out.s, "shifted results: ", t);
	out
}
@end
