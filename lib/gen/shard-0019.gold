test: list=1,1,2,3,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var w = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var len = 0;
		while i < g.n && g.res[i] == val {
			len++;
			i++;
		}
		g.res[w] = len;
		w++;
	}
	g.n = w;
	out.i = w;
	out
}
@end
