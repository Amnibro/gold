fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start_idx = if g.n > k { g.n - k } else { 0 };
	var win_sum = 0;
	var i = start_idx;
	while i < g.n {
		win_sum += g.res[i];
		i++;
	}
	gold_push(g, win_sum);
	out.i = win_sum;
	g.steps += g.n - start_idx;
	out.s.clear();
	format(out.s, "merged last tally sum ", win_sum);
	out
}
@end
