modifier: each
context: error
phrase: reverse decimal digit pairs in number
phrase: invert each pair of adjacent digits
test: arg=12345,6789
expect: 13254
expect: 7698
test: arg=42
expect: 24
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[16] = [0; 16];
	var len = 0;
	while x > 0 { d[len] = x % 10; len++; x /= 10; }
	var i = 0;
	while i + 1 < len {
		let tmp = d[i];
		d[i] = d[i + 1];
		d[i + 1] = tmp;
		i += 2;
	}
	var res = 0;
	var k = len - 1;
	while k >= 0 { res = res * 10 + d[k]; k--; }
	res
}
@end
