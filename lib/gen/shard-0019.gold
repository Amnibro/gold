@entry 706a1f8dc26aee5f
kind: pred
verb: pair
noun: evens
modifier: none
context: error
phrase: check error code contains no even digit pairs
phrase: verify error pattern has zero paired evens
test: arg=1357,2468
expect: true
expect: false
test: arg=2345
expect: true
test: arg=24
expect: false
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var prev_even = false;
	while x > 0 {
		let d = x % 10;
		let is_even = (d % 2 == 0);
		if is_even && prev_even { return false; }
		prev_even = is_even;
		x /= 10;
	}
	true
}
@end
