@entry 4bc48d3288dc10e9
kind: fn
verb: count
noun: evens
modifier: pairwise
context: sort
phrase: count evens pairwise adjacent digits
phrase: measure count evens pairwise in key
test: arg=246,135
expect: 2
expect: 0
test: arg=248
expect: 2
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	var count = 0;
	while v >= 10 {
		let d1 = v % 10;
		let d2 = (v / 10) % 10;
		if (d1 % 2 == 0) && (d2 % 2 == 0) {
			count++;
		}
		v /= 10;
	}
	count
}
@end
