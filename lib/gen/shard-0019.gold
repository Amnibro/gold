kind: step
verb: hollow
noun: terrain
modifier: cave
context: env
phrase: hollow a cave at {x} {y} radius {r}
phrase: tunnel into the rock at {x} {y} with radius {r}
slot: x real
slot: y real
slot: r real
test: x=0.0 y=4.0 r=1.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="cave" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: cave3 capsule 0,4,1 0,2,1 r1 - ~.1
test: x=2.0 y=6.0 r=0.5 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=3 r=0.0 ok=true s="cave" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: cave3 capsule 2,6,0.5 2,3,0.5 r0.5 - ~.1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "cave", "", o);
	o.append(" capsule ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	gold_fnum(o, ${r});
	o.append(" ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y} * 0.5);
	o.append(",");
	gold_fnum(o, ${r});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" - ~.");
	o.append("1");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "cave");
	out
}
@end
@entry 86f0587286c2be1e
kind: step
verb: run
noun: odds
modifier: nested
context: error
phrase: run odd error codes with nested depth {depth}
phrase: execute nested odd fault checks to depth {depth}
slot: depth int
test: list=101,200,303 depth=2
expect: => i=4 r=0.0 ok=true s="ran nested odd errors: 4" errors=0 n=3 res=[101,200,303] cache=0 hits=0
test: list=404,500,502 depth=3
expect: => i=0 r=0.0 ok=true s="ran nested odd errors: 0" errors=0 n=3 res=[404,500,502] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var count = 0;
	for i in g.n {
		let err_code = g.res[i];
		if err_code % 2 != 0 {
			count += d;
		}
	}
	g.steps += count + g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "ran nested odd errors: ", count);
	out
}
@end
