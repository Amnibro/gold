code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var s = ${shift} % g.n;
	if s < 0 { s += g.n; }
	var temp: int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		temp[(i + s) % g.n] = g.res[i];
		i++;
	}
	i = 0;
	while i < g.n {
		g.res[i] = temp[i];
		i++;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out
}
@end
@entry 39b959eee2d4e3ec
kind: step
verb: sort
noun: gaps
modifier: first
context: math
slot: limit int
phrase: sort gaps between first elements up to {limit}
phrase: order consecutive gaps for first items capped by {limit}
test: list=10,12,18,22 limit=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=3,9,14,20 limit=8
expect: => i=5 r=0.0 ok=true s="" errors=0 n=3 res=[5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n <= 1 { return out; }
	var gaps: int[512] = [0; 512];
	var gn = 0;
	var i = 0;
	while i < g.n - 1 && gn < lim {
		let d = g.res[i + 1] - g.res[i];
		gaps[gn] = if d < 0 { -d } else { d };
		gn++;
		i++;
	}
	gold_clear(g);
	var k = 0;
	while k < gn {
		gold_push(g, gaps[k]);
		k++;
	}
	// sort gaps
	i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out
}
@end
