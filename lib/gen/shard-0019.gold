fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var u_count = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first { u_count++; }
	}
	format(out.s, "distinct count: ", u_count, " of ", g.n);
	out.i = u_count;
	g.steps += g.n;
	out
}
