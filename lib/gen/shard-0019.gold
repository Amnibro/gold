fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cur = out.i;
	var steps = 0;
	while steps < 100 {
		if cur >= lim && lim > 1 { break; }
		if lim == 1 && cur == 1 { break; }
		cur = ${f}(cur);
		steps++;
	}
	out.i = steps;
	g.steps += steps + 1;
	out.s.clear();
	format(out.s, "measured function running steps: ", steps);
