@entry 9767dd96e4413f02
kind: step
verb: retry
noun: maximum
modifier: pairwise
context: stats
phrase: retry pairwise maximum adjacent delta scan
phrase: evaluate adjacent pairwise peak differences
test: list=10,15,12,25
expect: => i=13 r=0.0 ok=true s="peak adjacent delta 13" errors=0 n=4 res=[10,15,12,25] cache=0 hits=0
test: list=5,20,15,30
expect: => i=15 r=0.0 ok=true s="peak adjacent delta 15" errors=0 n=4 res=[5,20,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_diff = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		let diff = if a > b { a - b } else { b - a };
		if diff > max_diff { max_diff = diff; }
		i++;
	}
	out.i = max_diff;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "peak adjacent delta ", max_diff);
	out
}
@end
