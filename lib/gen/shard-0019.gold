fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= th { break; }
		count++;
		i++;
	}
	out.i = count;
	g.steps += i;
	out.s.clear();
	format(out.s, "measured ", count, " entries below threshold");
	out
}
@end
