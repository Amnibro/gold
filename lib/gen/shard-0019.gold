fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		if i % 2 == 0 {
			sum += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded alternate positions sum: ", sum);
	out
}
@end
