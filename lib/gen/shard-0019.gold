fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_val = if g.n > 0 { g.res[0] } else { 0 };
	var inspected = 0;
	for i in g.n {
		let x = g.res[i];
		inspected++;
		if x > max_val { max_val = x; }
		if ${stop_pred}(x) { break; }
	}
	g.steps += inspected + 1;
	out.i = max_val;
	out.s.clear();
	format(out.s, "search maximum until stop: ", max_val);
	out
}
@end
