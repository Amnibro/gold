fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mode_val = g.res[0];
	var max_count = 0;
	for i in 0 .. g.n {
		var cnt = 0;
		for j in 0 .. g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt > max_count {
			max_count = cnt;
			mode_val = g.res[i];
		}
	}
	var write = 0;
	for i in 0 .. g.n {
		if g.res[i] == mode_val {
			g.res[write] = mode_val;
			write++;
		}
	}
	g.n = write;
	g.steps += g.n;
	out.i = write;
	out.s.clear();
	format(out.s, "select_histogram_in_place: ", write);
	out
}
@end
