code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var a = 0;
	var b = 0;
	for i in g.n {
		for j in g.n {
			if i < j && g.res[i] + g.res[j] == ${target} {
				a = g.res[i];
				b = g.res[j];
				found = true;
				break;
			}
		}
		if found { break; }
	}
	g.n = 0;
	if found {
		gold_push(g, a);
		gold_push(g, b);
		out.i = 2;
		out.s.clear();
		format(out.s, "paired");
	} else {
		out.ok = false;
	}
	out
}
@end
