fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let base = g.res[0];
		for i in g.n {
			g.res[i] -= base;
		}
		let last = g.res[g.n - 1];
		out.i = last;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "flatten sequence delta: ", g.n);
	out
}
@end
