@entry b369030b8994a354
kind: step
verb: swap
noun: maximum
modifier: with_retry
context: stats
phrase: swap maximum element with last position with retry
phrase: relocate peak value to end with retry
test: list=10,40,20,30
expect: => i=40 r=0.0 ok=true s="swapped max value 40 to end" errors=0 n=4 res=[10,30,20,40] cache=0 hits=0
test: list=5,25,15,10
expect: => i=25 r=0.0 ok=true s="swapped max value 25 to end" errors=0 n=4 res=[5,10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	let last = g.n - 1;
	let tmp = g.res[last];
	g.res[last] = g.res[max_idx];
	g.res[max_idx] = tmp;
	out.i = max_val;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped max value ", max_val, " to end");
	out
}
@end
