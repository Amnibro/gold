@entry 0304522f79599d49
kind: fn
verb: fill
noun: items
modifier: pairwise
context: core
phrase: fill items pairwise differences
phrase: compute items pairwise deltas sum
test: arg=1357,111
expect: 6
expect: 0
test: arg=909
expect: 18
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var sum_diff = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		sum_diff += diff;
		prev = cur;
		x /= 10;
	}
	sum_diff
}
@end
