test: list=7,8,9 shifts=-3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let s = ${shifts};
	var out = v;
	out.s.clear();
	if s < 0 {
		gold_fail(g, "shifts must be non-negative");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		format(out.s, "rotated: []");
		out.i = 0;
		return out;
	}
	let k = s % g.n;
	format(out.s, "shifted(", k, "): [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		let src = (i + k) % g.n;
		format(out.s, g.res[src]);
	}
	format(out.s, "]");
	out.i = k;
	g.steps += g.n;
	out
}
@end
@entry d64dbe6ecba8e2fc
kind: step
verb: clamp
noun: text
modifier: safely
context: format
phrase: format elements clamped between safe bounds {lo} to {hi}
phrase: render safely bounded values from {lo} to {hi}
phrase: display elements constrained within safe range {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,15,25,8,40 lo=10 hi=30
expect: => i=90 r=0.0 ok=true s="bounded[10..30]: [10, 15, 25, 10, 30]" errors=0 n=5 res=[3,15,25,8,40] cache=0 hits=0
test: list=1,2,3 lo=5 hi=10
expect: => i=15 r=0.0 ok=true s="bounded[5..10]: [5, 5, 5]" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=20,30 lo=50 hi=20
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let low = ${lo};
	let high = ${hi};
	var out = v;
	out.s.clear();
	if low > high {
		gold_fail(g, "lower bound cannot exceed upper bound");
		out.ok = false;
		return out;
	}
	format(out.s, "bounded[", low, "..", high, "]: [");
	var total = 0;
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		var v_val = g.res[i];
		if v_val < low { v_val = low; }
		else if v_val > high { v_val = high; }
		total += v_val;
		format(out.s, v_val);
	}
	format(out.s, "]");
	out.i = total;
	g.steps += g.n;
	out
}
@end
