kind: pred
verb: check
noun: primes
modifier: in_reverse
context: core
phrase: check primes in reverse
phrase: test reversed digits form prime
test: arg=31
expect: true
test: arg=24
expect: false
test: arg=73
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	if rev < 2 { return false; }
	if rev == 2 || rev == 3 { return true; }
	if rev % 2 == 0 || rev % 3 == 0 { return false; }
	var d = 5;
	while d * d <= rev {
		if rev % d == 0 || rev % (d + 2) == 0 { return false; }
		d += 6;
	}
	true
}
@end
