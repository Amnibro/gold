@entry d660a510f116d602
kind: step
verb: rotate
noun: digits
modifier: until
context: math
slot: target int
phrase: rotate number digits until leading digit matches {target}
phrase: cyclically shift digits until first matches {target}
test: input=3451 target=1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
test: input=872 target=7
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[7,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var num = out.i;
	if num < 0 { num = -num; }
	var digs: int[32] = [0; 32];
	var dn = 0;
	while num > 0 {
		digs[dn] = num % 10;
		dn++;
		num /= 10;
	}
	if dn == 0 { return out; }
	// reverse into normal order
	var l = 0;
	var r = dn - 1;
	while l < r {
		let t = digs[l];
		digs[l] = digs[r];
		digs[r] = t;
		l++;
		r--;
	}
	var turns = 0;
	while turns < dn && digs[0] != tgt {
		let first = digs[0];
		var i = 0;
		while i < dn - 1 {
			digs[i] = digs[i + 1];
			i++;
		}
		digs[dn - 1] = first;
		turns++;
	}
	gold_clear(g);
	var k = 0;
	while k < dn {
		gold_push(g, digs[k]);
		k++;
	}
	g.steps += turns;
	out.i = turns;
	out
}
@end
