code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var escalations = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			if g.res[i + 1] > g.res[i] {
				escalations++;
			}
		}
	}
	g.steps += g.n;
	out.i = escalations;
	out.s.clear();
	format(out.s, "nested error escalations: ", escalations);
	out
}
@end
