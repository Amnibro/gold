fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = if ${denom} != 0 { ${denom} } else { 1 };
	for i in g.n {
		g.res[i] = (g.res[i] * g.res[i]) / d;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " squares");
	out
}
