code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var val = g.res[i];
		var dsum = 0;
		while val > 0 {
			dsum += val % 10;
			val /= 10;
		}
		total += dsum;
		g.res[i] = total;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "grouped running digits: ", total);
	out
}
@end
