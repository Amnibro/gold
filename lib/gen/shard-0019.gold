code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n < 2 {
		format(out.s, "steps: single");
		out.i = 0;
		return out;
	}
	format(out.s, "steps: ");
	let pairs = g.n - 1;
	for i in pairs {
		if i > 0 { format(out.s, " "); }
		let a = g.res[i];
		let b = g.res[i + 1];
		let sym = if a < b { "<" } else if a > b { ">" } else { "=" };
		format(out.s, a, sym, b);
	}
	out.i = pairs;
	g.steps += pairs;
	out
}
@end
