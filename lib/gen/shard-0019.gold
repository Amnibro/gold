code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_max = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
		g.res[i] = cur_max;
		i--;
	}
	out.i = cur_max;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "kept reverse running maximum ", cur_max);
	out
}
@end
