@entry 3d64060aff5e38cd
kind: step
verb: merge
noun: item
modifier: while
context: loop
phrase: merge items while cumulative total under {bound}
phrase: combine items while running sum below {bound}
slot: bound int
test: list=10,20,30,40 bound=50
expect: => i=30 r=0.0 ok=true s="merged 2 items while under bound" errors=0 n=3 res=[30,30,40] cache=0 hits=0
test: list=5,8,12,25 bound=30
expect: => i=25 r=0.0 ok=true s="merged 3 items while under bound" errors=0 n=2 res=[25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var idx = 0;
	while idx < g.n && total + g.res[idx] < ${bound} {
		total += g.res[idx];
		idx++;
	}
	if idx > 0 {
		var new_n = 1 + (g.n - idx);
		var temp int[512] = [0; 512];
		temp[0] = total;
		var dest = 1;
		for i in idx..g.n {
			temp[dest] = g.res[i];
			dest++;
		}
		for i in new_n { g.res[i] = temp[i]; }
		g.n = new_n;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "merged ", idx, " items while under bound");
	out
}
@end
