test: list=2,3,4,5
expect: => i=3 r=0.0 ok=true s="cached 3 pairwise products" errors=0 n=3 res=[6,12,20] cache=3 hits=0
test: list=6,7,8
expect: => i=2 r=0.0 ok=true s="cached 2 pairwise products" errors=0 n=2 res=[42,56] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let pairs = g.n - 1;
	for k in pairs {
		let prod = g.res[k] * g.res[k + 1];
		gold_cache_put(g, k + 1, prod);
		g.res[k] = prod;
	}
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached ", pairs, " pairwise products");
	out
}
@end
