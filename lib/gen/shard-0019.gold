@entry 33d34e2c04ddb3be
kind: step
verb: reverse
noun: sequence
modifier: in_place
context: list
phrase: reverse sequence in_place
phrase: invert order of elements in_place
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="reverse sequence in_place: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20
expect: => i=2 r=0.0 ok=true s="reverse sequence in_place: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for i in half {
		let opp = g.n - 1 - i;
		let temp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = temp;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse sequence in_place: ", g.n);
	out
}
@end
