@entry 4d70ef4b5d1050f2
kind: step
verb: check
noun: histogram
modifier: recursively
context: sort
slot: min_freq int
phrase: sort check histogram recursively for frequency {min_freq}
phrase: recursively verify distribution frequencies against {min_freq}
test: list=1,1,1,2,3 min_freq=2
expect: => i=3 r=0.0 ok=true s="max frequency was 3" errors=0 n=5 res=[1,1,1,2,3] cache=0 hits=0
test: list=5,6,7,8 min_freq=2
expect: => i=1 r=0.0 ok=false s="max frequency was 1" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var max_freq = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let cnt = j - i;
		if cnt > max_freq { max_freq = cnt; }
		i = j;
	}
	g.steps += g.n + 1;
	out.i = max_freq;
	out.ok = max_freq >= mf;
	out.s.clear();
	format(out.s, "max frequency was ", max_freq);
	out
}
@end
@entry 77f5275bacbe92b5
kind: step
verb: check
noun: duplicates
modifier: none
context: sort
slot: lim int
phrase: sort check duplicates none within limit {lim}
phrase: confirm no repeated sorted elements up to bound {lim}
test: list=1,2,3,4 lim=4
expect: => i=0 r=0.0 ok=true s="no duplicates found" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=2,2,5,7 lim=4
expect: => i=1 r=0.0 ok=false s="duplicates found" errors=0 n=4 res=[2,2,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = if ${lim} < g.n { ${lim} } else { g.n };
	var has_dup = false;
	if bound > 1 {
		for i in 1..bound {
			if g.res[i] == g.res[i - 1] {
				has_dup = true;
				break;
			}
		}
	}
	g.steps += bound + 1;
	out.ok = !has_dup;
	out.i = if has_dup { 1 } else { 0 };
	out.s.clear();
	if has_dup {
		format(out.s, "duplicates found");
	} else {
		format(out.s, "no duplicates found");
	}
	out
}
@end
