code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_size = ${delta};
	var passes = 0;
	if g.n > 0 && step_size > 0 {
		passes = g.res[g.n - 1] / step_size;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "ranked recursive limit passes: ", passes);
	out
}
@end
