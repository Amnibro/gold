phrase: count maximum repeated cache streak length
test: arg=7,15
expect: 13
expect: 12
test: arg=0
expect: 16
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var max_streak = 0;
	var cur_streak = 0;
	var last_bit = -1;
	for i in 16 {
		let b = x % 2;
		if b == last_bit {
			cur_streak++;
		} else {
			last_bit = b;
			cur_streak = 1;
		}
		if cur_streak > max_streak {
			max_streak = cur_streak;
		}
		x /= 2;
	}
	max_streak
}
@end
