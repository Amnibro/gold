code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var matched = 0;
	var i = 0;
	while i < g.n && i < 3 {
		if g.res[i] >= limit { matched++; }
		i++;
	}
	out.i = matched;
	g.steps += i;
	out.s.clear();
	format(out.s, "counted ", matched, " leading items over threshold");
	out
}
@end
