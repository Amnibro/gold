	if g.n > 1 {
		for i in 0..g.n - 1 {
			if swaps >= lim { break; }
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += swaps + 1;
