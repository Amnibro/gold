expect: => i=2 r=0.0 ok=true s="selected positive streak length 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best_len = 0;
	var best_start = 0;
	var cur_len = 0;
	var cur_start = 0;
	for k in g.n {
		if g.res[k] > 0 {
			if cur_len == 0 { cur_start = k; }
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 0;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	out.i = best_len;
	out.s.clear();
	format(out.s, "selected positive streak length ", best_len);
	out
}
@end
