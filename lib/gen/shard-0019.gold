code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if g.n == 0 { return out; }
	let mid = g.n / 2;
	var start = mid - r;
	if start < 0 { start = 0; }
	var end = mid + r;
	if end >= g.n { end = g.n - 1; }
	var slice int[64];
	var sn = 0;
	for i in g.n {
		if i >= start && i <= end {
			slice[sn] = g.res[i];
			sn++;
		}
	}
	gold_clear(g);
	for i in sn {
		gold_push(g, slice[i]);
	}
	g.steps += sn + 1;
	out.i = sn;
	out.s.clear();
	format(out.s, "scanned middle safely count: ", sn);
	out
}
@end
