test: list=1,2,3,4 factor=3
expect: => i=2 r=0.0 ok=true s="scaled tail by 3" errors=0 n=4 res=[1,2,9,12] cache=0 hits=0
test: list=10,20,30 factor=2
expect: => i=2 r=0.0 ok=true s="scaled tail by 2" errors=0 n=3 res=[10,40,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	if g.n >= 2 {
		g.res[g.n - 1] *= f;
		g.res[g.n - 2] *= f;
		scaled = 2;
	} else if g.n == 1 {
		g.res[0] *= f;
		scaled = 1;
	}
	g.steps += scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled tail by ", f);
	out
}
@end
