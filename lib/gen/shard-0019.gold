@entry cc626722f26dc017
kind: step
verb: check
noun: duplicates
modifier: times
context: sort
slot: repeat_limit int
phrase: sort check duplicates times ceiling {repeat_limit}
phrase: verify no duplicate exceeds repeat limit {repeat_limit}
test: list=1,1,1,2,3 repeat_limit=2
expect: => i=3 r=0.0 ok=false s="maximum duplicate frequency was 3" errors=0 n=5 res=[1,1,1,2,3] cache=0 hits=0
test: list=4,4,5,5,5,5 repeat_limit=3
expect: => i=4 r=0.0 ok=false s="maximum duplicate frequency was 4" errors=0 n=6 res=[4,4,5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rl = ${repeat_limit};
	var max_freq = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		if freq > max_freq { max_freq = freq; }
		i = j;
	}
	g.steps += g.n + 1;
	out.ok = max_freq <= rl;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "maximum duplicate frequency was ", max_freq);
	out
}
@end
@entry 740ede856ec84856
kind: step
verb: swap
noun: minimum
modifier: at_most
context: sort
slot: max_swaps int
phrase: sort swap minimum at most count {max_swaps}
phrase: selection swap smallest elements at most {max_swaps}
test: list=8,3,5,1,9 max_swaps=1
expect: => i=1 r=0.0 ok=true s="swapped 1 minimum elements" errors=0 n=5 res=[1,3,5,8,9] cache=0 hits=0
test: list=7,2,6,4,1 max_swaps=2
expect: => i=1 r=0.0 ok=true s="swapped 1 minimum elements" errors=0 n=5 res=[1,2,6,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_swaps};
	var swaps = 0;
	for i in ms {
		if i >= g.n { break; }
		var min_idx = i;
		for j in i + 1..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
			swaps++;
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " minimum elements");
	out
}
@end
