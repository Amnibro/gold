fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			let applied = ${step_fn}(g.res[i]);
			acc += applied;
			count++;
		}
		i++;
	}
	g.steps += count;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded evens: ", acc);
	out
}
