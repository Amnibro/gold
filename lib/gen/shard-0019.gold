code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt = 0;
	var sign = 1;
	var idx = g.n - 1;
	while idx >= 0 {
		alt += sign * g.res[idx];
		sign = -sign;
		idx--;
	}
	g.steps += g.n;
	out.i = alt;
	out.s.clear();
	format(out.s, "measure_number_in_reverse: ", alt);
	out
}
@end
@entry e1291ee79445392f
kind: step
verb: map
noun: primes
modifier: each
context: aggregate
phrase: map primes each occurrence in sequence
phrase: transform primes each element accordingly
test: list=2,4,5,9
expect: => i=27 r=0.0 ok=true s="map_primes_each: 27" errors=0 n=4 res=[4,4,10,9] cache=0 hits=0
test: list=3,6,7,10
expect: => i=36 r=0.0 ok=true s="map_primes_each: 36" errors=0 n=4 res=[6,6,14,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in 0 .. g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] *= 2;
		}
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "map_primes_each: ", total);
	out
}
@end
