fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var rem = tgt;
	for i in g.n {
		if rem >= g.res[i] {
			rem -= g.res[i];
		} else {
			g.res[i] = rem;
			rem = 0;
		}
	}
	g.steps += g.n;
	out.i = tgt - rem;
	out.s.clear();
	format(out.s, "consumed budget in place: ", out.i);
	out
}
@end
