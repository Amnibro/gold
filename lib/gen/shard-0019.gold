@entry e9939e9f62d90f23
kind: step
verb: tone
noun: sand
modifier: seeded
context: texture
phrase: tone seeded sand dunes using seed {u}
phrase: render seeded sand ripples with seed {u}
slot: u int
model: noise c=4 u=${u}; blur; brighten a=0.15
test: img=16 u=11
expect: => i=256 r=0.0 ok=true s="sand" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.33 max=1 sum8=51368 hash=955471
test: img=32 u=13
expect: => i=1024 r=0.0 ok=true s="sand" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.228 max=1 sum8=166420 hash=238821
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.15); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
