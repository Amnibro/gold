expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var seen = 0;
	var unique_digits = 0;
	while x > 0 {
		let d = x % 10;
		let mask = 1 << (d as uint);
		if (seen & mask) == 0 {
			seen |= mask;
			unique_digits++;
		}
		x /= 10;
	}
	unique_digits
}
@end
