@entry 1fef8d83cb88d118
kind: step
verb: trace
noun: average
modifier: unique
context: search
phrase: trace average unique search scores
phrase: calculate mean of distinct search scores
test: list=10,20,10,30
expect: => i=20 r=0.0 ok=true s="unique search score average: 20" errors=0 n=4 res=[10,20,10,30] cache=0 hits=0
test: list=5,15,5,25
expect: => i=15 r=0.0 ok=true s="unique search score average: 15" errors=0 n=4 res=[5,15,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_sum = 0;
	var u_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			u_sum += x;
			u_count++;
		}
	}
	let avg = if u_count > 0 { u_sum / u_count } else { 0 };
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "unique search score average: ", avg);
	out
}
@end
