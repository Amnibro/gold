fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in 0 .. g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	for i in 0 .. g.n / 2 {
		let t = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = t;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "keep_squares_in_reverse: ", g.n);
	out
}
