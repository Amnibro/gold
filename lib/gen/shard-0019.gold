				g.res[i] /= 2;
			} else {
				g.res[i] = g.res[i] * 3 + 1;
			}
			ops++;
		}
	}
	g.steps += ops;
	out.i = ops;
	out.s.clear();
	format(out.s, "applied nested function: ", ops);
	out
}
@end
@entry 56d9feb5ff24bcde
kind: step
