test: list=8,16,32 radix=2
expect: => i=12 r=0.0 ok=true s="grouped loop recursively: 12" errors=0 n=3 res=[8,16,32] cache=0 hits=0
test: list=9,27,81 radix=3
expect: => i=9 r=0.0 ok=true s="grouped loop recursively: 9" errors=0 n=3 res=[9,27,81] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rad = ${radix};
	if rad <= 1 { gold_fail(g, "radix must exceed one"); out.ok = false; return out; }
	var groups = 0;
	for i in g.n {
		var val = g.res[i];
		var depth = 0;
		while val >= rad {
			val /= rad;
			depth++;
		}
		groups += depth;
	}
	g.steps += g.n + groups;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped loop recursively: ", groups);
	out
}
@end
