test: list=10,20,30,10,20
expect: => i=3 r=0.0 ok=true s="backward memo deduped to 3 items" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[kept] = x;
			kept++;
		}
		k--;
	}
	for i in kept {
		g.res[i] = temp[kept - 1 - i];
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "backward memo deduped to ", kept, " items");
	out
}
@end
