@entry 8c709e4ae60f3f1b
kind: step
verb: find
noun: window
modifier: any
context: list
slot: size int
phrase: find window of any elements of size {size}
phrase: locate sliding window of size {size}
test: list=1,4,2,5,3 size=2
expect: => i=8 r=0.0 ok=true s="find window any: 8" errors=0 n=5 res=[1,4,2,5,3] cache=0 hits=0
test: list=10,20 size=1
expect: => i=20 r=0.0 ok=true s="find window any: 20" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	var best = 0;
	if w > 0 && g.n >= w {
		for i in 0..(g.n - w + 1) {
			var cur = 0;
			for k in w {
				cur += g.res[i + k];
			}
			if i == 0 || cur > best {
				best = cur;
			}
		}
	}
	out.i = best;
	out.s.clear();
	format(out.s, "find window any: ", best);
	out
}
@end
