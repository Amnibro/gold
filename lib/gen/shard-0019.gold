noun: step
modifier: sorted
context: loop
phrase: find step delta in sorted sequence
phrase: detect sorted step increments
test: list=10,14,20,25
expect: => i=4 r=0.0 ok=true s="found sorted step: 4" errors=0 n=4 res=[10,14,20,25] cache=0 hits=0
test: list=1,5,7,12
expect: => i=2 r=0.0 ok=true s="found sorted step: 2" errors=0 n=4 res=[1,5,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_step = 999999;
	if g.n < 2 { min_step = 0; }
	else {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d < min_step { min_step = d; }
		}
	}
	g.steps += g.n;
	out.i = min_step;
	out.s.clear();
	format(out.s, "found sorted step: ", min_step);
	out
}
@end
