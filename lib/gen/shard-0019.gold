fn ${ID}(n int) int {
	var num = if n < 0 { -n } else { n };
	var prev_digit = -1;
	var total_gap = 0;
	while num > 0 {
		let curr = num % 10;
		if prev_digit >= 0 {
			let diff = if curr > prev_digit { curr - prev_digit } else { prev_digit - curr };
			total_gap += diff;
		}
		prev_digit = curr;
		num /= 10;
	}
	total_gap
}
@end
