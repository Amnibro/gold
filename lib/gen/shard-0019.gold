code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var total = 0;
	var count = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if total + sq > limit { break; }
		total += sq;
		count++;
	}
	g.steps += count + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "measured ", count, " squares up to ", total);
	out
}
