kind: step
verb: return
noun: budget
modifier: unique
context: search
slot: budget int
phrase: return budget unique search items ceiling {budget}
phrase: yield unique search budget limit {budget}
test: list=10,20,10,30,20,40 budget=3
expect: => i=3 r=0.0 ok=true s="returned 3 unique budgeted items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,6,7,7 budget=2
expect: => i=2 r=0.0 ok=true s="returned 2 unique budgeted items" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in unique_count {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen && unique_count < b {
			g.res[unique_count] = x;
			unique_count++;
		}
	}
	g.n = unique_count;
	g.steps += g.n + 1;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "returned ", unique_count, " unique budgeted items");
	out
}
@end
