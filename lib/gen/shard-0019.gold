@entry 39ae941a44f5a498
kind: step
verb: join
noun: tail
modifier: nested
context: math
slot: factor int
phrase: join nested tail elements scaled by {factor}
phrase: collect inner tail math terms with scale {factor}
test: list=10,20,30,40 factor=2
expect: => i=180 r=0.0 ok=true s="tail sum: 180" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 factor=3
expect: => i=120 r=0.0 ok=true s="tail sum: 120" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${factor};
	if g.n <= 1 { return out; }
	var sum = 0;
	var i = 1;
	while i < g.n {
		sum += g.res[i] * sc;
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "tail sum: ", sum);
	out
}
@end
