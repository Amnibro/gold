@entry e517b039f31553b9
kind: step
verb: mask
noun: numbers
modifier: parity
context: list
slot: mask_val int
phrase: mask numbers by parity zeroing odds with {mask_val}
phrase: replace odd numbers with mask {mask_val}
test: list=1,2,3,4 mask_val=0
expect: => i=2 r=0.0 ok=true s="mask numbers parity: 2" errors=0 n=4 res=[0,2,0,4] cache=0 hits=0
test: list=2,4,6 mask_val=-1
expect: => i=0 r=0.0 ok=true s="mask numbers parity: 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mask_val};
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = m;
			count += 1;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "mask numbers parity: ", count);
	out
}
@end
@entry c8352bd224466295
kind: step
verb: fill
noun: sequence
modifier: constant
context: list
slot: count int
slot: val int
phrase: fill sequence with constant count {count} of value {val}
phrase: initialize sequence count {count} with {val}
test: list=1,2 count=3 val=7
expect: => i=7 r=0.0 ok=true s="fill sequence constant: 3" errors=0 n=3 res=[7,7,7] cache=0 hits=0
test: list= count=2 val=42
expect: => i=42 r=0.0 ok=true s="fill sequence constant: 2" errors=0 n=2 res=[42,42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let elem = ${val};
	let lim = if k <= 128 { k } else { 128 };
	for i in lim {
		g.res[i] = elem;
	}
	g.n = lim;
	out.i = elem;
	out.s.clear();
	format(out.s, "fill sequence constant: ", lim);
	out
}
@end
@entry 3cdd0a32480fa12a
kind: step
verb: ramp
noun: sequence
modifier: linear
context: list
slot: start int
slot: count int
phrase: ramp sequence linearly from {start} count {count}
phrase: generate linear ramp beginning {start} count {count}
test: list= start=5 count=4
expect: => i=8 r=0.0 ok=true s="ramp sequence linear: 4" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
test: list= start=0 count=3
expect: => i=2 r=0.0 ok=true s="ramp sequence linear: 3" errors=0 n=3 res=[0,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let k = ${count};
	let lim = if k <= 128 { k } else { 128 };
	for i in lim {
		g.res[i] = s + i;
	}
	g.n = lim;
	let last = if lim > 0 { s + lim - 1 } else { 0 };
	out.i = last;
	out.s.clear();
	format(out.s, "ramp sequence linear: ", lim);
	out
}
@end
@entry 47dbaab5fe3bb340
kind: step
verb: mirror
noun: sequence
modifier: append
context: list
phrase: mirror sequence by appending inverted copy
phrase: reflect sequence to create palindrome
test: list=1,2,3
expect: => i=6 r=0.0 ok=true s="mirror sequence append: 6" errors=0 n=6 res=[1,2,3,3,2,1] cache=0 hits=0
test: list=5
expect: => i=2 r=0.0 ok=true s="mirror sequence append: 2" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig = g.n;
	if orig > 0 && orig * 2 <= 128 {
		for i in orig {
			g.res[orig + i] = g.res[orig - 1 - i];
		}
		g.n = orig * 2;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "mirror sequence append: ", g.n);
	out
}
@end
@entry 5601ebfabee2c374
kind: step
verb: squeeze
noun: numbers
modifier: range
context: list
slot: min_val int
slot: max_val int
phrase: squeeze numbers outside range {min_val} to {max_val}
phrase: discard numbers beyond boundaries {min_val} to {max_val}
test: list=1,5,10,15,20 min_val=5 max_val=15
expect: => i=3 r=0.0 ok=true s="squeeze numbers range: 3" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=1,2,3 min_val=10 max_val=20
expect: => i=0 r=0.0 ok=true s="squeeze numbers range: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var j = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			g.res[j] = g.res[i];
			j += 1;
		}
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "squeeze numbers range: ", j);
	out
}
@end
@entry bbfdfd249b3f084b
kind: step
verb: project
noun: numbers
modifier: modulo
context: list
slot: modulus int
phrase: project numbers under modulo divisor {modulus}
phrase: apply modulo {modulus} across elements
test: list=5,12,19 modulus=5
expect: => i=4 r=0.0 ok=true s="project numbers modulo: 3" errors=0 n=3 res=[0,2,4] cache=0 hits=0
test: list=10,20 modulus=10
expect: => i=0 r=0.0 ok=true s="project numbers modulo: 2" errors=0 n=2 res=[0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	var last = 0;
	if m != 0 {
		for i in g.n {
			g.res[i] = g.res[i] % m;
			last = g.res[i];
		}
	}
	out.i = last;
	out.s.clear();
	format(out.s, "project numbers modulo: ", g.n);
	out
}
@end
@entry f66d42d087fe98fc
kind: step
verb: normalize
noun: numbers
modifier: baseline
context: list
phrase: normalize numbers by subtracting baseline min
phrase: shift sequence so minimum becomes zero
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="normalize numbers baseline: 3" errors=0 n=3 res=[0,10,20] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="normalize numbers baseline: 3" errors=0 n=3 res=[0,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var min_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] < min_val {
				min_val = g.res[i];
			}
		}
		for i in g.n {
			g.res[i] -= min_val;
		}
		let last = g.res[g.n - 1];
		out.i = last;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "normalize numbers baseline: ", g.n);
	out
}
@end
