fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	var last_val = -999999;
	for k in g.n {
		if g.res[k] != last_val {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		last_val = g.res[k];
	}
	out.i = max_streak;
	out.s.clear();
	format(out.s, "measured longest non repeating streak ", max_streak);
	out
}
@end
