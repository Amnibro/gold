code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let count = g.n - 1;
	var k = g.n - 1;
	while k > 0 {
		g.res[k - 1] = g.res[k] - g.res[k - 1];
		k--;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned ", count, " suffix pairwise differences");
	out
}
@end
