code:
fn ${ID}(g Gold&, v Val) Val {
	let limit = ${cap};
	var out = v;
	out.s.clear();
	if limit <= 0 {
		gold_fail(g, "budget cap must be positive");
		out.ok = false;
		return out;
	}
	format(out.s, "budget_cap(", limit, "): [");
	var sum_clamped = 0;
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		let val = if g.res[i] > limit { limit } else { g.res[i] };
		sum_clamped += val;
		format(out.s, val);
	}
	format(out.s, "]");
	out.i = sum_clamped;
	g.steps += g.n;
	out
}
@end
