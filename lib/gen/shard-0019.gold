@entry 85a8e1a482c35290
kind: step
verb: dedupe
noun: threshold
modifier: at_least
context: format
phrase: format deduped values exceeding limit {threshold}
phrase: render unique items at least {threshold}
phrase: display deduped list above {threshold}
slot: threshold int
test: list=5,10,10,20,5,30 threshold=8
expect: => i=3 r=0.0 ok=true s="unique >= 8: [10, 20, 30]" errors=0 n=6 res=[5,10,10,20,5,30] cache=0 hits=0
test: list=1,2,3 threshold=5
expect: => i=0 r=0.0 ok=true s="unique >= 5: []" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=15,15,15 threshold=10
expect: => i=1 r=0.0 ok=true s="unique >= 10: [15]" errors=0 n=3 res=[15,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let cutoff = ${threshold};
	var out = v;
	out.s.clear();
	format(out.s, "unique >= ", cutoff, ": [");
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= cutoff {
			var seen_before = false;
			for j in i {
				if g.res[j] == val {
					seen_before = true;
					break;
				}
			}
			if !seen_before {
				if count > 0 { format(out.s, ", "); }
				format(out.s, val);
				count++;
			}
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
