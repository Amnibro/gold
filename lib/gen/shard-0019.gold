fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 0 .. g.n / 2 {
		let t = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = t;
	}
	var unique_primes = 0;
	for i in 0 .. g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			var first = true;
			for j in 0 .. i {
				if g.res[j] == x { first = false; break; }
			}
			if first { unique_primes++; }
		}
	}
	g.steps += g.n;
	out.i = unique_primes;
	out.s.clear();
	format(out.s, "reverse_primes_unique: ", unique_primes);
	out
}
@end
