code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${len} <= 0.0 || ${len} >= ${h} {
		gold_fail(g, "length must be positive and less than hip height");
		out.ok = false;
		return out;
	}
	let half = ${len} * 0.5;
	let mid = ${h} - half;
	let bot = ${h} - ${len};
	gold_dnews(g, "thigh", "", o);
	o.append(" bone 0,0,");
	gold_fnum(o, ${h});
	o.append(" 0,0,");
	gold_fnum(o, mid);
	gold_doc(g, o);
	var thigh byte[>..] = [];
	thigh.append(g.dname);
	o.clear();
	gold_dnews(g, "shin", "", o);
	o.append(" bone 0,0,");
	gold_fnum(o, mid);
	o.append(" 0,0,");
	gold_fnum(o, bot);
	o.append(" ^");
	o.append(thigh);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "leg");
	out
}
@end
