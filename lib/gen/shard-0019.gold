@entry 7f07656cf6710835
kind: step
verb: group
noun: squares
modifier: in_reverse
context: stats
phrase: group statistical sum of squares in reverse pairs
phrase: combine squared statistical deviations in reverse
test: list=1,2,3,4
expect: => i=30 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=2,3,4,5
expect: => i=54 r=0.0 ok=true s="" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var idx = g.n - 1;
	while idx >= 1 {
		let a = g.res[idx];
		let b = g.res[idx - 1];
		total += (a * a) + (b * b);
		idx -= 2;
	}
	out.i = total;
	out
}
@end
