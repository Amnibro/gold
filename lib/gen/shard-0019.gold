@entry ca2a43f62745d299
kind: step
verb: check
noun: gaps
modifier: recursively
context: loop
phrase: check gap differences decrease recursively across sequence
phrase: verify recursive convexity of differences between gaps
test: list=1,6,10,13,15
expect: => i=1 r=0.0 ok=true s="checked gaps decreasing recursively: true" errors=0 n=5 res=[1,6,10,13,15] cache=0 hits=0
test: list=1,3,7,12,14
expect: => i=0 r=0.0 ok=false s="checked gaps decreasing recursively: false" errors=0 n=5 res=[1,3,7,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.ok = true;
		out.i = 1;
		return out;
	}
	var strictly_decreasing = true;
	var prev_gap = g.res[1] - g.res[0];
	for k in 1..(g.n - 1) {
		let cur_gap = g.res[k + 1] - g.res[k];
		if cur_gap >= prev_gap {
			strictly_decreasing = false;
			break;
		}
		prev_gap = cur_gap;
	}
	out.ok = strictly_decreasing;
	out.i = if strictly_decreasing { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked gaps decreasing recursively: ", strictly_decreasing);
	out
}
@end
