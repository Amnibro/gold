@entry 214cf2f327b2da94
kind: step
verb: shift
noun: total
modifier: with_retry
context: loop
phrase: shift total with retry attempts {retries}
phrase: retry shifting total limit {retries}
slot: retries int
test: list=80,80,80 retries=3
expect: => i=2 r=0.0 ok=true s="shifted total with retries: 2" errors=0 n=3 res=[20,20,20] cache=0 hits=0
test: list=200,200 retries=1
expect: => i=1 r=0.0 ok=true s="shifted total with retries: 1" errors=0 n=2 res=[100,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var attempts = 0;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	while sum > 100 && attempts < max_r {
		for i in g.n {
			g.res[i] /= 2;
		}
		sum = 0;
		for i in g.n { sum += g.res[i]; }
		attempts++;
	}
	g.steps += g.n * (attempts + 1);
	out.i = attempts;
	out.s.clear();
	format(out.s, "shifted total with retries: ", attempts);
	out
}
@end
