fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var k = 0;
		while k < i {
			if g.res[k] == g.res[i] { seen = true; break; }
			k++;
		}
		if !seen { distinct++; }
		i++;
	}
	out.i = distinct;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "mapped ", distinct, " unique values");
	out
}
@end
