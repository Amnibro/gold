expect: => i=3 r=0.0 ok=true s="selected digits times 3" errors=0 n=3 res=[15,18,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		var x = g.res[i];
		var dsum = 0;
		while x > 0 {
			dsum += x % 10;
			x /= 10;
		}
		g.res[i] = dsum * f;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected digits times ", f);
	out
}
@end
