fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var keep = 0;
	var i = g.n - 1;
	while i >= 0 {
		let cost = if g.res[i] > 0 { g.res[i] } else { 1 };
		if rem >= cost {
			rem -= cost;
			keep++;
		} else {
			break;
		}
		i--;
	}
	g.n = keep;
	g.steps += keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "budget kept reverse: ", keep);
	out
}
@end
