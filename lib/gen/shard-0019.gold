code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	if l < 0 { gold_fail(g, "suffix length cannot be negative"); out.ok = false; return out; }
	let k = if l > g.n { g.n } else { l };
	let start = g.n - k;
	for i in k {
		g.res[i] = g.res[start + i];
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "collected suffix safely: ", k);
	out
}
@end
