			gold_cache_put(g, i, g.res[i]);
			checkpoints++;
		}
	}
	g.steps += g.n + checkpoints;
	out.i = checkpoints;
	out.s.clear();
	format(out.s, "collected checkpoints with cache: ", checkpoints);
	out
}
