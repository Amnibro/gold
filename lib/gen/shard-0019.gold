test: list=10,20 min_val=25 max_val=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let lo = ${min_val};
	let hi = ${max_val};
	var out = v;
	out.s.clear();
	if lo > hi {
		gold_fail(g, "min bound cannot exceed max bound");
		out.ok = false;
		return out;
	}
	format(out.s, "range[", lo, "..", hi, "]: [");
	var hit = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if hit > 0 { format(out.s, ", "); }
			format(out.s, x);
			hit++;
		}
	}
	format(out.s, "]");
	out.i = hit;
	g.steps += g.n;
	out
}
@end
@entry ac0e1be0da04263e
kind: step
verb: rotate
noun: cache
modifier: until
context: format
phrase: format cyclic rotation until match {target}
phrase: render rotated sequence stopping at {target}
phrase: display cyclic shift halting at {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="rotated to 30: [30, 40, 10, 20]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,2,3 target=1
expect: => i=0 r=0.0 ok=true s="rotated to 1: [1, 2, 3]" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,6,7 target=99
expect: => i=-1 r=0.0 ok=true s="target not found: 99" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let needle = ${target};
	var out = v;
	out.s.clear();
	var pivot = -1;
	for i in g.n {
		if g.res[i] == needle {
			pivot = i;
			break;
		}
	}
	if pivot < 0 {
		format(out.s, "target not found: ", needle);
		out.i = -1;
		return out;
	}
	format(out.s, "rotated to ", needle, ": [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		let idx = (pivot + i) % g.n;
		format(out.s, g.res[idx]);
	}
	format(out.s, "]");
	out.i = pivot;
	g.steps += g.n;
	out
}
@end
