code:
fn ${ID}_dsum(n int) int {
	var x = if n < 0 { -n } else { n };
	var s = 0;
	while x > 0 {
		s += x % 10;
		x /= 10;
	}
	s
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let ds = ${ID}_dsum(g.res[i]);
		g.res[i] = ds;
		total += ds;
	}
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped all digits sum: ", total);
	out
}
@end
