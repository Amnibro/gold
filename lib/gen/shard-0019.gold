code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	var missed = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if !ok {
			gold_cache_put(g, k, fb);
			missed++;
		}
	}
	g.steps += g.n + 1;
	out.i = missed;
	out.s.clear();
	format(out.s, "cached ", missed, " missing entries");
	out
}
@end
