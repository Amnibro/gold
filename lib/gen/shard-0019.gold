test: list=1,2,3,4,5,6 k=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 k=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = max(${k}, 1);
	var w = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		for step in win {
			if i + step < g.n { sum += g.res[i + step]; }
		}
		g.res[w] = sum;
		w++;
		i += win;
	}
	g.n = w;
	out.i = w;
	out
}
@end
