@entry 9da86417c4a7d219
kind: step
verb: validate
noun: suffix
modifier: unique
context: compare
phrase: compare validate suffix is unique by count {k}
phrase: verify comparison suffix elements are unique for length {k}
slot: k int
test: list=10,20,30,40 k=2
expect: => i=1 r=0.0 ok=true s="suffix elements are unique" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20,30,30 k=2
expect: => i=0 r=0.0 ok=true s="duplicate elements in suffix" errors=0 n=4 res=[10,20,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var ok_unique = true;
	let start = if g.n > count { g.n - count } else { 0 };
	for i in start .. g.n {
		for j in i + 1 .. g.n {
			if g.res[i] == g.res[j] {
				ok_unique = false;
				break;
			}
		}
		if !ok_unique { break; }
	}
	g.steps += count;
	out.i = if ok_unique { 1 } else { 0 };
	out.s.clear();
	if ok_unique {
		format(out.s, "suffix elements are unique");
	} else {
		format(out.s, "duplicate elements in suffix");
	}
	out
}
@end
