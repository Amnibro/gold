code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${limit};
	var mx = -1000000000;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x <= ceiling {
			if !found || x > mx {
				mx = x;
				found = true;
			}
		}
	}
	g.steps += g.n;
	if found {
		out.i = mx;
		out.s.clear();
		format(out.s, "found maximum under limit: ", mx);
	} else {
		gold_fail(g, "no elements below limit");
		out.ok = false;
	}
	out
}
@end
