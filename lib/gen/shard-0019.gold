@entry 3f99812111a9a541
kind: step
verb: clamp
noun: cache
modifier: none
context: search
slot: lim int
phrase: search clamp cache values to ceiling {lim}
phrase: restrict query cache entries to ceiling {lim}
test: list=10,50,20 lim=25
expect: => i=1 r=0.0 ok=true s="clamped 1 search cache entries" errors=0 n=3 res=[10,50,20] cache=3 hits=0
test: list=5,15,35,45 lim=30
expect: => i=2 r=0.0 ok=true s="clamped 2 search cache entries" errors=0 n=4 res=[5,15,35,45] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var clamped = 0;
	for i in g.n {
		let k = g.res[i];
		let old_val, ok = gold_cache_get(g, k);
		let val = if ok { old_val } else { k };
		if val > limit {
			gold_cache_put(g, k, limit);
			clamped++;
		} else {
			gold_cache_put(g, k, val);
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " search cache entries");
	out
}
@end
@entry 809bb88033eadb68
kind: step
verb: repeat
noun: prefix
modifier: until
context: search
slot: target_len int
phrase: repeat prefix until search length {target_len}
phrase: extend search query prefix until length {target_len}
test: list=10,20 target_len=5
expect: => i=5 r=0.0 ok=true s="extended prefix search length: 5" errors=0 n=5 res=[10,20,10,20,10] cache=0 hits=0
test: list=3,6,9 target_len=6
expect: => i=6 r=0.0 ok=true s="extended prefix search length: 6" errors=0 n=6 res=[3,6,9,3,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	if g.n == 0 || g.n >= target {
		g.steps += 1;
		out.i = g.n;
		out.s.clear();
		format(out.s, "prefix length unchanged: ", g.n);
		return out;
	}
	let orig_n = g.n;
	var i = 0;
	while g.n < target && g.n < 512 {
		g.res[g.n] = g.res[i % orig_n];
		g.n++;
		i++;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "extended prefix search length: ", g.n);
	out
}
@end
