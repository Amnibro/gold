fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vals int[64];
	var counts int[64];
	var vn = 0;
	for i in g.n {
		if i % 2 == 0 {
			let x = g.res[i];
			var found = -1;
			for k in vn {
				if vals[k] == x { found = k; break; }
			}
			if found >= 0 {
				counts[found]++;
			} else if vn < 64 {
				vals[vn] = x;
				counts[vn] = 1;
				vn++;
			}
		}
	}
	gold_clear(g);
	for k in vn {
		gold_push(g, counts[k]);
	}
	g.steps += vn + 1;
	out.i = vn;
	out.s.clear();
	format(out.s, "histogram every other categories: ", vn);
	out
}
