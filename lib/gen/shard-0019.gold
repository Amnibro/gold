code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	let limit = (g.n + 1) / 2;
	var modified = 0;
	var i = 0;
	while i < limit {
		g.res[i] *= m;
		modified++;
		i += 2;
	}
	out.i = modified;
	g.steps += limit;
	out.s.clear();
	format(out.s, "mapped ", modified, " alternating head items");
	out
}
@end
