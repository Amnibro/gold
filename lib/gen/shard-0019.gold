test: list=2,2,3,4,4,5 times=2
expect: => i=4 r=0.0 ok=true s="kept 4 elements from matching runs" errors=0 n=4 res=[2,2,4,4] cache=0 hits=0
test: list=1,1,1,2,3,3 times=3
expect: => i=3 r=0.0 ok=true s="kept 3 elements from matching runs" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == g.res[i] {
			run_len++;
		}
		if run_len == ${times} {
			for j in run_len {
				g.res[kept] = g.res[i + j];
				kept++;
			}
		}
		i += run_len;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements from matching runs");
	out
}
@end
