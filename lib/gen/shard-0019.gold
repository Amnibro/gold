code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	let end_idx = if ${limit} < g.n - 1 { ${limit} } else { g.n - 2 };
	var sum = 0;
	var i = 1;
	while i <= end_idx {
		sum += g.res[i];
		i++;
	}
	var new_res = [0; 512];
	new_res[0] = g.res[0];
	new_res[1] = sum;
	var c = 2;
	var idx = end_idx + 1;
	while idx < g.n {
		new_res[c] = g.res[idx];
		c++;
		idx++;
	}
	g.n = 0;
	for j in c { gold_push(g, new_res[j]); }
	out.i = sum;
	out.s.clear();
	format(out.s, "middle merged: ", sum);
	out
}
@end
