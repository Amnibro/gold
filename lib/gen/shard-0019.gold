test: list=1,2,3,4 stop_pred=is_even
expect: => i=1 r=0.0 ok=true s="swapped at index 1" errors=0 n=4 res=[1,3,2,4] cache=0 hits=0
test: list=2,3,4,5 stop_pred=is_odd
expect: => i=1 r=0.0 ok=true s="swapped at index 1" errors=0 n=4 res=[2,4,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped_idx = -1;
	if g.n > 1 {
		for i in 0..g.n - 1 {
			if ${stop_pred}(g.res[i]) {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped_idx = i;
				break;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = swapped_idx;
	out.s.clear();
	format(out.s, "swapped at index ", swapped_idx);
	out
}
@end
