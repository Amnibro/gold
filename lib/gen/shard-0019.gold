kind: step
verb: drop
noun: range
modifier: in_place
context: loop
phrase: drop range in place start {start} count {count}
phrase: excise slice in place from {start} length {count}
slot: start int
slot: count int
test: list=10,20,30,40,50 start=1 count=2
expect: => i=2 r=0.0 ok=true s="dropped range in place: 2" errors=0 n=3 res=[10,40,50] cache=0 hits=0
test: list=1,2,3,4 start=0 count=1
expect: => i=1 r=0.0 ok=true s="dropped range in place: 1" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let c = ${count};
	if s < 0 || c < 0 { gold_fail(g, "range bounds invalid"); out.ok = false; return out; }
	var w = 0;
	for i in g.n {
		if i < s || i >= s + c {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped range in place: ", dropped);
	out
}
@end
