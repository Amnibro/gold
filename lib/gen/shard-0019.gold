slot: shifts int
test: list=1,2,3,4,5 shifts=2
expect: => i=2 r=0.0 ok=true s="shifted(2): [3, 4, 5, 1, 2]" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20 shifts=1
