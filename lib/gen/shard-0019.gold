fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	let start = if m < g.n { m } else { g.n };
	let end = if g.n - m > start { g.n - m } else { start };
	let span = end - start;
	for i in span / 2 {
		let tmp = g.res[start + i];
		g.res[start + i] = g.res[end - 1 - i];
		g.res[end - 1 - i] = tmp;
	}
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed middle span of ", span, " elements");
	out
}
