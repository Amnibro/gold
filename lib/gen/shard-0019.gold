@entry 7879376c20a10d83
kind: step
verb: split
noun: threshold
modifier: sorted
context: error
phrase: split errors around threshold {threshold} sorted
phrase: partition fault values by sorted threshold {threshold}
slot: threshold int
test: list=50,10,60,20 threshold=30
expect: => i=2 r=0.0 ok=true s="split threshold count: 2" errors=0 n=4 res=[10,20,50,60] cache=0 hits=0
test: list=5,15,25 threshold=50
expect: => i=3 r=0.0 ok=true s="split threshold count: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var low int[256] = [0; 256];
	var high int[256] = [0; 256];
	var ln = 0;
	var hn = 0;
	for i in g.n {
		if g.res[i] <= t {
			if ln < 256 { low[ln] = g.res[i]; ln++; }
		} else {
			if hn < 256 { high[hn] = g.res[i]; hn++; }
		}
	}
	for i in ln { g.res[i] = low[i]; }
	for j in hn { g.res[ln + j] = high[j]; }
	g.steps += g.n;
	out.i = ln;
	out.s.clear();
	format(out.s, "split threshold count: ", ln);
	out
}
@end
@entry 68812518e069fc02
kind: step
verb: shift
noun: odds
modifier: until
context: error
phrase: shift odd errors until condition {stop_cond} met
phrase: advance odd faults until predicate {stop_cond} fires
slot: stop_cond pred
test: list=3,5,6,7 stop_cond=is_even
expect: => i=2 r=0.0 ok=true s="shifted odds until condition: 2" errors=0 n=4 res=[4,6,6,7] cache=0 hits=0
test: list=1,3,5 stop_cond=is_even
expect: => i=3 r=0.0 ok=true s="shifted odds until condition: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	for i in g.n {
		if ${stop_cond}(g.res[i]) { break; }
		if g.res[i] % 2 != 0 {
			g.res[i] += 1;
			shifted++;
		}
	}
	g.steps += g.n + shifted;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted odds until condition: ", shifted);
	out
}
@end
