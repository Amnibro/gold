expect: => i=30 r=0.0 ok=true s="fold[5..18]: sum=30 count=3" errors=0 n=5 res=[3,10,15,20,5] cache=0 hits=0
test: list=1,2,3 low=10 high=20
expect: => i=0 r=0.0 ok=true s="fold[10..20]: sum=0 count=0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=50,25,10 low=30 high=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[50,25,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let lo = ${low};
	let hi = ${high};
	var out = v;
	out.s.clear();
	if lo > hi {
		gold_fail(g, "low bound cannot exceed high bound");
		out.ok = false;
		return out;
	}
	var total = 0;
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			total += x;
			matched++;
		}
	}
	format(out.s, "fold[", lo, "..", hi, "]: sum=", total, " count=", matched);
	out.i = total;
	g.steps += g.n;
	out
}
@end
