@entry 92a417459e853c27
kind: step
verb: reverse
noun: runs
modifier: safely
context: core
phrase: reverse runs safely within span {max_len}
phrase: invert runs safely under length {max_len}
slot: max_len int
test: list=1,2,3,4,5,6 max_len=2
expect: => i=6 r=0.0 ok=true s="runs reversed" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
test: list=10,20,30,40 max_len=2
expect: => i=4 r=0.0 ok=true s="runs reversed" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${max_len};
	if span <= 1 { return out; }
	var i = 0;
	while i + span <= g.n {
		var l = i;
		var r = i + span - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		i += span;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "runs reversed");
	out
}
@end
