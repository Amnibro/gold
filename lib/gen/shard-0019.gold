noun: digits
modifier: at_most
context: search
slot: max_digits int
phrase: validate digits at most ceiling {max_digits}
phrase: verify search score digits at most {max_digits}
test: list=12,345,67 max_digits=3
expect: => i=1 r=0.0 ok=true s="digits at most verified: true" errors=0 n=3 res=[12,345,67] cache=0 hits=0
test: list=99,1001,4 max_digits=2
expect: => i=0 r=0.0 ok=false s="digits at most verified: false" errors=1 n=3 res=[99,1001,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var valid = true;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 {
			d++;
			x /= 10;
		}
		if d > md {
			valid = false;
			break;
		}
	}
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	if !valid { gold_fail(g, "digit count exceeded"); }
	out.s.clear();
	format(out.s, "digits at most verified: ", valid);
	out
}
@end
