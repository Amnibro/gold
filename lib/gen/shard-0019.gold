code:
fn ${ID}_test_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_increments = 0;
	for k in g.n {
		var x = g.res[k];
		while !${ID}_test_prime(x) {
			x++;
			total_increments++;
		}
		g.res[k] = x;
	}
	out.i = total_increments;
	out.s.clear();
	format(out.s, "retried numbers to primes with increments ", total_increments);
	out
}
@end
