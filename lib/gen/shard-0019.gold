@entry 579ed0aee27405ca
kind: step
verb: check
noun: duplicates
modifier: running
context: sort
slot: window int
phrase: sort check duplicates running in window {window}
phrase: scan running adjacent duplicates across window {window}
test: list=1,2,2,4,5 window=3
expect: => i=1 r=0.0 ok=false s="found running duplicate" errors=0 n=5 res=[1,2,2,4,5] cache=0 hits=0
test: list=1,3,5,7,9 window=4
expect: => i=0 r=0.0 ok=true s="no running duplicate" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	var found = false;
	if g.n > 1 {
		let lim = if w < g.n { w } else { g.n };
		for i in 1..lim {
			if g.res[i] == g.res[i - 1] {
				found = true;
				break;
			}
		}
	}
	g.steps += g.n + 1;
	out.ok = !found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found {
		format(out.s, "found running duplicate");
	} else {
		format(out.s, "no running duplicate");
	}
	out
}
@end
