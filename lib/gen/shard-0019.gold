noun: histogram
modifier: with_retry
context: stats
phrase: drop histogram statistical outliers with {retries} retries
phrase: prune statistical histogram bins with retry count {retries}
slot: retries int
test: list=50,10,30,5,40 retries=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[50,30,40] cache=0 hits=0
test: list=100,20,80 retries=1
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[100,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var r = ${retries};
	while r > 0 && g.n > 1 {
		var min_idx = 0;
		for k in 1..g.n {
			if g.res[k] < g.res[min_idx] { min_idx = k; }
		}
		for k in min_idx..g.n - 1 {
			g.res[k] = g.res[k + 1];
		}
		g.n--;
		r--;
	}
	out.i = g.n;
	out
}
@end
