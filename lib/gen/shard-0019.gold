test: list=8
expect: => i=8 r=0.0 ok=true s="min_unique: 8" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var min_u = 0;
	var found = false;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt == 1 {
			if !found || g.res[i] < min_u {
				min_u = g.res[i];
				found = true;
			}
		}
	}
	if found {
		format(out.s, "min_unique: ", min_u);
		out.i = min_u;
	} else {
		format(out.s, "min_unique: none");
		out.i = 0;
	}
	g.steps += g.n * g.n;
	out
}
@end
