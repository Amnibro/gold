test: list=1,2,3,4,5,6 k=2
expect: => i=2 r=0.0 ok=true s="reversed tail nested" errors=0 n=6 res=[1,2,4,3,6,5] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="reversed tail nested" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}_rev(g Gold&, start int, len int) {
	var l = start;
	var r = start + len - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k > 0 && g.n >= 2 * k {
		${ID}_rev(g, g.n - 2 * k, k);
		${ID}_rev(g, g.n - k, k);
	}
	out.i = k;
	out.s.clear();
	format(out.s, "reversed tail nested");
	out
}
@end
@entry a6b26cead6a76c80
kind: step
verb: swap
noun: budget
modifier: pairwise
context: core
phrase: swap budget pairwise elements under cost {budget}
phrase: exchange budget pairwise adjacent values within {budget}
slot: budget int
test: list=5,2,8,1 budget=10
expect: => i=1 r=0.0 ok=true s="budget swaps: 1" errors=0 n=4 res=[2,5,8,1] cache=0 hits=0
test: list=3,1,4,2 budget=12
expect: => i=2 r=0.0 ok=true s="budget swaps: 2" errors=0 n=4 res=[1,3,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var i = 0;
	var count = 0;
	while i + 1 < g.n {
		let cost = g.res[i] + g.res[i + 1];
		if cost <= rem {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			rem -= cost;
			count++;
		}
		i += 2;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "budget swaps: ", count);
	out
}
@end
