fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_diff = ${diff};
	var pairs = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let delta = g.res[i + 1] - g.res[i];
			let d = if delta < 0 { -delta } else { delta };
			if d <= max_diff { pairs++; }
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found pairs at most: ", pairs);
	out
}
@end
@entry 1d68589a5cfdd2d4
kind: step
verb: drop
noun: duplicates
modifier: times
context: loop
phrase: drop duplicates repeating more than {k} times
phrase: cull items recurring past count {k}
slot: k int
test: list=4,4,4,5,5,6 k=2
expect: => i=1 r=0.0 ok=true s="dropped duplicates times: 1" errors=0 n=5 res=[4,4,5,5,6] cache=0 hits=0
test: list=1,1,1,1,2,2 k=1
expect: => i=4 r=0.0 ok=true s="dropped duplicates times: 4" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_occ = ${k};
	if max_occ <= 0 { gold_fail(g, "count must be positive"); out.ok = false; return out; }
	var w = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_count = 0;
		for j in w {
			if g.res[j] == x { seen_count++; }
		}
		if seen_count < max_occ {
			g.res[w] = x;
			w++;
		} else {
			dropped++;
		}
	}
	g.n = w;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped duplicates times: ", dropped);
	out
}
@end
