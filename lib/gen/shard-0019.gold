fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	var folded = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) {
			gold_cache_put(g, matched, x);
			folded += x;
			matched++;
		}
	}
	g.steps += g.n + 1;
	out.i = folded;
	out.s.clear();
	format(out.s, "folded ", matched, " matching cache items sum: ", folded);
