@entry a0fda5c5686cab59
kind: step
verb: dedupe
noun: evens
modifier: while
context: math
slot: bound int
phrase: dedupe even numbers while values stay under {bound}
phrase: prune duplicate evens while below threshold {bound}
test: list=2,2,4,4,12,6 bound=10
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,4,12,6] cache=0 hits=0
test: list=8,8,6,6,20 bound=15
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[8,6,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n <= 1 { return out; }
	var w = 1;
	var r = 1;
	while r < g.n {
		let cur = g.res[r];
		let prev = g.res[w - 1];
		if cur % 2 == 0 && cur == prev && cur < b {
			// skip duplicate even
		} else {
			g.res[w] = cur;
			w++;
		}
		r++;
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out
}
@end
@entry fd477dfb3fe32acf
kind: step
verb: rotate
noun: errors
modifier: while
context: math
slot: max_steps int
phrase: rotate error records while steps stay under {max_steps}
phrase: cycle error markers while iteration count below {max_steps}
test: list=1,2,3 max_steps=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=4,5,6,7 max_steps=8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_steps};
	if g.n <= 1 { return out; }
	var step = 0;
	while step < lim {
		let first = g.res[0];
		var i = 0;
		while i < g.n - 1 {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		step++;
	}
	g.steps += step;
	out.i = g.res[0];
	out
}
@end
@entry af4d562bf8949293
kind: step
verb: return
noun: sequence
modifier: unique
context: math
slot: min_val int
phrase: return sequence of unique elements above {min_val}
phrase: collect unique sequence items strictly greater than {min_val}
test: list=3,5,3,7,9,5 min_val=4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,7,9] cache=0 hits=0
test: list=1,2,2,8,10 min_val=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${min_val};
	var unique: int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > low {
			var seen = false;
			var j = 0;
			while j < un {
				if unique[j] == x { seen = true; break; }
				j++;
			}
			if !seen {
				unique[un] = x;
				un++;
			}
		}
		i++;
	}
	gold_clear(g);
	var k = 0;
	while k < un {
		gold_push(g, unique[k]);
		k++;
	}
	g.steps += g.n;
	out.i = un;
	out
}
@end
