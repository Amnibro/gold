fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[16] = [0; 16];
	var len = 0;
	var max_d = -1;
	while x > 0 {
		let dig = x % 10;
		d[len] = dig;
		if dig > max_d { max_d = dig; }
		len++;
		x /= 10;
	}
	var res = 0;
	var kept_max = false;
	var i = len - 1;
	while i >= 0 {
		let dig = d[i];
		if dig == max_d {
			if !kept_max {
				res = res * 10 + dig;
				kept_max = true;
			}
		} else {
			res = res * 10 + dig;
		}
		i--;
	}
	res
}
@end
