@entry bc09382a22d30fba
kind: step
verb: pair
noun: range
modifier: pairwise
context: sort
slot: factor int
phrase: sort pair range pairwise product {factor}
phrase: combine consecutive sorted pairs with factor {factor}
test: list=1,2,3,4 factor=10
expect: => i=2 r=0.0 ok=true s="paired into 2 combined items" errors=0 n=2 res=[12,34] cache=0 hits=0
