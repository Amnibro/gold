expect: => doc: boulders3 sphere 0,0,1 r3.5 m:matte #787570
test: r=0.0
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// env: border boulders none item 1
	var out_1 = v;
	if ${r} <= 0.0 { out_1.ok = false; return out_1; }
	var o_1 byte[>..] = [];
	gold_dnews(g, "boulders", "", o_1);
	o_1.append(" sphere ");
	o_1.append("0,");
	o_1.append("0,");
	o_1.append("1 r");
	gold_fnum(o_1, ${r});
	o_1.append(" m:matte ");
	gold_hex(o_1, 120, 117, 112);
	gold_doc(g, o_1);
	out_1.i = g.dn;
	out_1.s.clear();
	format(out_1.s, "boulders");
	out_1
}
@end
