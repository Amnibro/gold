fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if s > 1 && g.n > 0 {
		var j = 0;
		var i = 0;
		while i < g.n {
			g.res[j] = g.res[i];
			j += 1;
			i += s;
		}
		g.n = j;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "select sequence stride: ", g.n);
	out
}
