code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${a} <= 0.0 || ${h} <= 0.0 { gold_fail(g, "invalid flood dimensions"); out.ok = false; return out; }
	gold_dnews(g, "flood", "", o);
	o.append(" box ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.5);
	o.append(" ");
	gold_fnum(o, ${a});
	o.append(",");
	gold_fnum(o, ${a});
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" m:glass ");
	gold_hex(o, 30, 77, 107);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "dense_flood");
	out
}
@end
