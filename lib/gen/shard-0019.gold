code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.iw < 2 { gold_fail(g, "texture too narrow"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (x as real) / ((g.iw - 1) as real);
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (${n} as real)) as! int;
		if t > ${n} - 1 { t = ${n} - 1; }
		g.img[k] = (t as real) / ((${n} - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "concrete");
	out
}
@end
