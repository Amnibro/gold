@entry a1e3b7c4746c7746
kind: fn
verb: pair
noun: series
modifier: until
context: error
phrase: sum adjacent digit pairs until equal digits
phrase: pair series of digits until duplicate match
test: arg=1325,8441
expect: 70
expect: 41
test: arg=77
expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var total = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev { break; }
		total += cur * 10 + prev;
		prev = cur;
		x /= 10;
	}
	total
}
@end
