code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 2 < 1 || 2 > 5 { gold_fail(g, "octaves must be in range"); out.ok = false; return out; }
	var c0 = 16;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 16;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.3); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "marble");
	out
}
@end
@entry e8ec47acc8a5892d
kind: step
verb: pair
noun: counter
modifier: until
context: stats
phrase: pair adjacent counter tallies until limit {lim}
phrase: sum consecutive counter pairs until ceiling {lim}
slot: lim int
test: list=2,3,4,5,6 lim=15
expect: => i=2 r=0.0 ok=true s="paired 2 segments up to limit" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=1,4,2,5,3 lim=10
expect: => i=1 r=0.0 ok=true s="paired 1 segments up to limit" errors=0 n=5 res=[1,4,2,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var pair_count = 0;
	var running_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let p_sum = g.res[i] + g.res[i + 1];
		if running_sum + p_sum > limit { break; }
		running_sum += p_sum;
		pair_count++;
		i += 2;
	}
	out.i = pair_count;
	g.steps += i;
	out.s.clear();
	format(out.s, "paired ", pair_count, " segments up to limit");
	out
}
@end
