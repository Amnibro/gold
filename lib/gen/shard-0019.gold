	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var rounds = 0;
	while rounds < 100 {
		var min_val = g.res[0];
		for k in 1..g.n {
			if g.res[k] < min_val { min_val = g.res[k]; }
		}
		if min_val >= ${target} { break; }
		for k in g.n { g.res[k]++; }
		rounds++;
	}
	out.i = rounds;
	out.s.clear();
	format(out.s, "retried boosting elements across ", rounds, " rounds");
	out
}
