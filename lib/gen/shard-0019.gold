code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "freq: ");
	var printed = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first {
			var occ = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { occ++; }
			}
			if printed > 0 { format(out.s, " "); }
			format(out.s, g.res[i], "#", occ);
			printed++;
		}
	}
	out.i = printed;
	g.steps += g.n * g.n;
	out
}
@end
