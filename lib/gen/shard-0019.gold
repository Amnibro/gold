fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${n};
	var dups = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] { dups++; }
	}
	g.steps += passes * dups;
	out.i = dups;
	out.s.clear();
	format(out.s, "reversed duplicates ", passes, " times");
