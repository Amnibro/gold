fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var prod_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		prod_sum += g.res[i] * g.res[i + 1];
		i++;
	}
	out.i = prod_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "pairwise product series sum ", prod_sum);
	out
}
@end
