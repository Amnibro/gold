@entry b6437a8beedf1428
kind: step
verb: select
noun: tally
modifier: sorted
context: transform
phrase: select tally counts in sorted order
phrase: rank tally elements by ascending frequency
test: list=3,1,3,2,1,1
expect: => i=6 r=0.0 ok=true s="sorted 6 items" errors=0 n=6 res=[1,1,1,2,3,3] cache=0 hits=0
test: list=7,8,7,9,8,7
expect: => i=6 r=0.0 ok=true s="sorted 6 items" errors=0 n=6 res=[7,7,7,8,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// bubble sort in place
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items");
	out
}
@end
