expect: => i=6 r=0.0 ok=true s="dropped budget up to: 6" errors=0 n=3 res=[6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var dropped = 0;
	while dropped < g.n && sum + g.res[dropped] <= lim {
		sum += g.res[dropped];
		dropped++;
	}
	var w = 0;
	for i in (g.n - dropped) {
		g.res[w] = g.res[dropped + i];
		w++;
	}
	g.n = w;
	g.steps += g.n + dropped;
	out.i = sum;
	out.s.clear();
	format(out.s, "dropped budget up to: ", sum);
	out
}
@end
