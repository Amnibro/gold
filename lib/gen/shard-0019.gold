fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n <= 1 { return out; }
	var pairs: int[256] = [0; 256];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		pairs[pn] = (g.res[i] + g.res[i + 1]) * sc;
		pn++;
		i += 2;
	}
	gold_clear(g);
	var k = 0;
	while k < pn {
		gold_push(g, pairs[k]);
		k++;
	}
	g.steps += g.n;
	out.i = pn;
	out
}
@end
