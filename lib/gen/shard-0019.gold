code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var result byte[>..] = [];
	var cur byte[>..] = [];
	var word_count = 0;
	for b in out.s {
		if b == ' ' {
			if cur.len >= ${min_len} {
				if result.len > 0 { result.push(' '); }
				result.append(cur);
				word_count++;
			}
			cur.clear();
		} else {
			cur.push(b);
		}
	}
	if cur.len >= ${min_len} {
		if result.len > 0 { result.push(' '); }
		result.append(cur);
		word_count++;
	}
	out.s.clear();
	for b in result { out.s.push(b); }
	out.i = word_count;
	out
}
@end
@entry 42e8c9d72929ad10
kind: step
verb: keep
noun: digits
modifier: each
context: loop
phrase: keep even digits of each result
phrase: filter each number retaining even digits
test: list=1234,5678
expect: => i=2 r=0.0 ok=true s="filtered even digits for 2 items" errors=0 n=2 res=[24,68] cache=0 hits=0
test: list=357,2468
expect: => i=2 r=0.0 ok=true s="filtered even digits for 2 items" errors=0 n=2 res=[0,2468] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		let neg = x < 0;
		if neg { x = -x; }
		var d int[32] = [0; 32];
		var dcount = 0;
		while x > 0 {
			let rem = x % 10;
			if rem % 2 == 0 {
				d[dcount] = rem;
				dcount++;
			}
			x /= 10;
		}
		var rebuilt = 0;
		while dcount > 0 {
			dcount--;
			rebuilt = rebuilt * 10 + d[dcount];
		}
		g.res[k] = if neg { -rebuilt } else { rebuilt };
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered even digits for ", g.n, " items");
	out
}
@end
