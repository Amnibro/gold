code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	var max_len = 0;
	var best_start = 0;
	var i = 0;
	while i < g.n {
		var cur_len = 1;
		while i + cur_len < g.n && g.res[i + cur_len] > g.res[i + cur_len - 1] {
			cur_len++;
		}
		if cur_len > max_len {
			max_len = cur_len;
			best_start = i;
		}
		i += cur_len;
	}
	for k in 0 .. max_len {
		g.res[k] = g.res[best_start + k];
	}
	g.n = max_len;
	g.steps += g.n;
	out.i = max_len;
	out.s.clear();
	format(out.s, "select_series_any: ", max_len);
	out
}
@end
