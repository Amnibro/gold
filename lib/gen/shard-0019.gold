@entry e72ee145a5109a70
kind: step
verb: join
noun: gaps
modifier: sorted
context: compare
phrase: compare join gaps in sorted order
phrase: bridge comparison gaps with ascending sequence
test: list=10,30,50
expect: => i=5 r=0.0 ok=true s="bridged gaps to 5 items" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=2,6
expect: => i=3 r=0.0 ok=true s="bridged gaps to 3 items" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var new_res int[128];
		var w = 0;
		for i in g.n - 1 {
			let a = g.res[i];
			let b = g.res[i + 1];
			new_res[w] = a;
			w++;
			let mid = (a + b) / 2;
			new_res[w] = mid;
			w++;
		}
		new_res[w] = g.res[g.n - 1];
		w++;
		for i in w {
			g.res[i] = new_res[i];
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "bridged gaps to ", g.n, " items");
	out
}
@end
