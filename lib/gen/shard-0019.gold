test: list=10,25,30,50 max_diff=10
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise divergences" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,20,15,40 max_diff=8
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise divergences" errors=0 n=4 res=[5,13,15,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var clamped = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > md {
				g.res[i] = g.res[i - 1] + md;
				clamped++;
			} else if diff < -md {
				g.res[i] = g.res[i - 1] - md;
				clamped++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " pairwise divergences");
	out
}
@end
@entry 9a805d0661a082fa
kind: step
verb: rank
noun: function
modifier: up_to
context: search
slot: f fn
slot: limit int
phrase: rank function {f} up to score limit {limit}
phrase: order search items by function {f} up to {limit}
test: list=2,5,8 f=double limit=12
expect: => i=2 r=0.0 ok=true s="ranked 2 search items up to limit" errors=0 n=2 res=[4,10] cache=0 hits=0
test: list=10,20,30 f=halve limit=12
expect: => i=2 r=0.0 ok=true s="ranked 2 search items up to limit" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let score = ${f}(g.res[i]);
		if score <= lim {
			g.res[kept] = score;
			kept++;
		}
	}
	var i = 0;
	while i < kept {
		var j = i + 1;
		while j < kept {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n * g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked ", kept, " search items up to limit");
	out
}
@end
