fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var count = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let abs_d = if diff < 0 { -diff } else { diff };
			if abs_d <= md {
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured pairs up to diff: ", count);
	out
}
