test: list=1,2 factor=2
expect: => i=4 r=0.0 ok=true s="repeat items times: 4" errors=0 n=4 res=[1,2,1,2] cache=0 hits=0
test: list=10 factor=3
expect: => i=3 r=0.0 ok=true s="repeat items times: 3" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let orig = g.n;
	if f > 1 && orig > 0 && orig * f <= 128 {
		for rep in 1..f {
			for i in orig {
				g.res[rep * orig + i] = g.res[i];
			}
		}
		g.n = orig * f;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeat items times: ", g.n);
	out
}
@end
