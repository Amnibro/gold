@entry 75b2fa149476c45e
kind: step
verb: reverse
noun: values
modifier: nested
context: loop
phrase: reverse nested chunk values of size {chunk}
phrase: invert values in nested blocks of {chunk}
slot: chunk int
test: list=1,2,3,4,5,6 chunk=3
expect: => i=6 r=0.0 ok=true s="reversed values in nested chunks: 3" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=1,2,3,4 chunk=2
expect: => i=4 r=0.0 ok=true s="reversed values in nested chunks: 2" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 1 || g.n == 0 { return out; }
	var base = 0;
	while base + c <= g.n {
		var l = base;
		var r = base + c - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		base += c;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed values in nested chunks: ", c);
	out
}
@end
