@entry f1dc18916b104cba
kind: step
verb: apply
noun: odds
modifier: unique
context: loop
phrase: apply unique odd values filter
phrase: deduplicate odd elements in place
test: list=3,3,4,5,5,6
expect: => i=2 r=0.0 ok=true s="unique odds filter removed: 2" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=1,1,1,2
expect: => i=2 r=0.0 ok=true s="unique odds filter removed: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		} else {
			g.res[w] = x;
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n + removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "unique odds filter removed: ", removed);
	out
}
@end
