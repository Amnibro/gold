code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnew(g, "bushing", o);
	o.append(" cyl ");
	o.append("0,");
	o.append("0,");
	o.append("0 ");
	o.append("0,");
	o.append("0,");
	o.append("0.");
	o.append("05 r");
	gold_fnum(o, ${r});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "shlbshhlw");
	out
}
@end
@entry 6e03a4239d1c4fc9
kind: step
verb: search
noun: series
modifier: sorted
context: format
phrase: format sorted series representation
phrase: render sorted values in stream
phrase: display elements arranged in ascending order
test: list=5,2,8,1,4
expect: => i=5 r=0.0 ok=true s="sorted: [1, 2, 4, 5, 8]" errors=0 n=5 res=[5,2,8,1,4] cache=0 hits=0
test: list=10,3
expect: => i=2 r=0.0 ok=true s="sorted: [3, 10]" errors=0 n=2 res=[10,3] cache=0 hits=0
test: list=7
expect: => i=1 r=0.0 ok=true s="sorted: [7]" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "sorted: []");
		out.i = 0;
		return out;
	}
	var arr int[16] = [0; 16];
	let m = if g.n < 16 { g.n } else { 16 };
	for i in m { arr[i] = g.res[i]; }
	for i in m {
		var j = i;
		while j > 0 && arr[j - 1] > arr[j] {
			let tmp = arr[j];
			arr[j] = arr[j - 1];
			arr[j - 1] = tmp;
			j--;
		}
	}
	format(out.s, "sorted: [");
	for i in m {
		if i > 0 { format(out.s, ", "); }
		format(out.s, arr[i]);
	}
	format(out.s, "]");
	out.i = m;
	g.steps += m;
	out
}
@end
