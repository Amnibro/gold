expect: => i=1 r=0.0 ok=true s="kept 1 items meeting threshold" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		if g.res[k] >= ${thresh} {
			g.res[count] = g.res[k];
			count++;
		}
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " items meeting threshold");
	out
}
@end
