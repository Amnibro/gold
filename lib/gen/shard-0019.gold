@entry c51a5b311b3bc080
kind: step
verb: repeat
noun: minimum
modifier: sorted
context: compare
phrase: compare repeat minimum element sorted count {times}
phrase: append copies of minimum value {times}
slot: times int
test: list=30,10,20 times=2
expect: => i=10 r=0.0 ok=true s="repeated minimum 2 times" errors=0 n=5 res=[30,10,20,10,10] cache=0 hits=0
test: list=8,16 times=1
expect: => i=8 r=0.0 ok=true s="repeated minimum 1 times" errors=0 n=3 res=[8,16,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${times};
	if g.n == 0 {
		gold_fail(g, "no elements to repeat minimum");
		out.ok = false;
		return out;
	}
	var mn = g.res[0];
	for i in g.n {
		if g.res[i] < mn {
			mn = g.res[i];
		}
	}
	for i in count {
		gold_push(g, mn);
	}
	g.steps += g.n + count;
	out.i = mn;
	out.s.clear();
	format(out.s, "repeated minimum ", count, " times");
	out
}
@end
@entry d7ed61ae960f53f5
