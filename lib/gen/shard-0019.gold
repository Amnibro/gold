fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	for d in 100 {
		let div = d + 2;
		if div * div > n { break; }
		if n % div == 0 { return false; }
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var count = 0;
	for i in g.n {
		if i % 2 == 0 && ${ID}_is_prime(g.res[i]) {
			g.res[i] *= f;
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled alternate primes: ", count);
	out
}
@end
