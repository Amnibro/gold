@entry 2bec839946aa306c
kind: step
verb: dedupe
noun: total
modifier: sorted
context: compare
phrase: dedupe total of sorted results
phrase: sum unique elements from sorted list
test: list=1,1,2,3,3,4
expect: => i=10 r=0.0 ok=true s="summed" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,10
expect: => i=15 r=0.0 ok=true s="summed" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "list is empty");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			gold_fail(g, "list not sorted");
			out.ok = false;
			return out;
		}
	}
	var j = 1;
	var total = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[j - 1] {
			g.res[j] = g.res[i];
			total += g.res[j];
			j++;
		}
		i++;
	}
	g.n = j;
	out.i = total;
	out.s.clear();
	format(out.s, "summed");
	out
}
@end
