fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	var all_ok = true;
	if d == 0 { out.ok = false; return out; }
	for i in g.n {
		if g.res[i] % d != 0 {
			all_ok = false;
			break;
		}
	}
	out.ok = all_ok;
	out.i = if all_ok { 1 } else { 0 };
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "condition all checked divisor: ", d);
	out
}
@end
