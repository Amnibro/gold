fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	if g.n >= 2 && reps % 2 != 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	out.i = reps;
	g.steps += reps;
	out.s.clear();
	format(out.s, "swapped ends for ", reps, " iterations");
	out
}
