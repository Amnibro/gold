expect: 12
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var d1 = (x / 10) % 10;
	var d0 = x % 10;
	if d1 > d0 {
		let tmp = d1;
		d1 = d0;
		d0 = tmp;
	}
	let res = (d1 * 10) + d0;
	if res > lim { lim } else { res }
}
@end
@entry 5358fc91e4474f0a
kind: fn
verb: map
noun: duplicates
modifier: times
context: error
phrase: map duplicate error occurrences {mult} times
phrase: amplify repeated error occurrences {mult} times
slot: mult int
test: arg=11223,4445 mult=3
expect: 6
expect: 6
test: arg=12345 mult=3
expect: 0
test: arg=9999 mult=2
expect: 6
code:
fn ${ID}(n int) int {
	let m = ${mult};
	var x = if n < 0 { -n } else { n };
	var counts int[10] = [0; 10];
	if x == 0 { counts[0] = 1; }
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var dup_sum = 0;
	for i in 10 {
		if counts[i] > 1 {
			dup_sum += (counts[i] - 1) * m;
		}
	}
	dup_sum
}
@end
