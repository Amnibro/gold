code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	for d in 100 {
		let div = d + 2;
		if div * div > n { break; }
		if n % div == 0 { return false; }
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	for i in g.n {
		if ${ID}_is_p(g.res[i]) {
			let sq = g.res[i] * g.res[i];
			g.res[i] = if sq > c { c } else { sq };
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped primes at most ceiling: ", count);
	out
}
@end
