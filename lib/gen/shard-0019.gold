@entry 207bd05b14c17e9f
kind: step
verb: rotate
noun: gaps
modifier: first
context: search
slot: k int
phrase: rotate gaps first search span {k}
phrase: cycle first {k} search score intervals
test: list=10,15,25,40,60 k=3
expect: => i=3 r=0.0 ok=true s="rotated first 3 score gaps" errors=0 n=5 res=[10,20,35,40,60] cache=0 hits=0
test: list=2,6,12,20 k=2
expect: => i=2 r=0.0 ok=true s="rotated first 2 score gaps" errors=0 n=4 res=[2,8,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${k};
	if g.n <= 1 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps to rotate");
		return out;
	}
	var num_gaps = g.n - 1;
	var gaps int[512] = [0; 512];
	for i in num_gaps {
		gaps[i] = g.res[i + 1] - g.res[i];
	}
	let limit = if span < num_gaps { span } else { num_gaps };
	if limit > 1 {
		let first = gaps[0];
		for i in 1..limit {
			gaps[i - 1] = gaps[i];
		}
		gaps[limit - 1] = first;
	}
	for i in num_gaps {
		g.res[i + 1] = g.res[i] + gaps[i];
	}
	g.steps += g.n + 1;
	out.i = limit;
	out.s.clear();
	format(out.s, "rotated first ", limit, " score gaps");
	out
}
@end
