expect: => i=10 r=0.0 ok=true s="diff sum: 10" errors=0 n=4 res=[1,4,2,7] cache=0 hits=0
test: list=10,20,15
expect: => i=15 r=0.0 ok=true s="diff sum: 15" errors=0 n=3 res=[10,20,15] cache=0 hits=0
code:
fn ${ID}_abs(x int) int { if x < 0 { -x } else { x } }
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		diff_sum += ${ID}_abs(g.res[i + 1] - g.res[i]);
		i++;
	}
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "diff sum: ", diff_sum);
	out
}
@end
@entry daa51c6c2fe68ab0
kind: step
verb: measure
noun: odds
modifier: until
context: core
phrase: measure odds until condition {p} holds
phrase: count odds until predicate {p} matches
slot: p pred
test: list=1,3,5,4,7 p=is_even
expect: => i=3 r=0.0 ok=true s="odds until: 3" errors=0 n=5 res=[1,3,5,4,7] cache=0 hits=0
test: list=9,11,2,13 p=is_even
expect: => i=2 r=0.0 ok=true s="odds until: 2" errors=0 n=4 res=[9,11,2,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) { break; }
		if x % 2 != 0 { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "odds until: ", count);
	out
}
@end
