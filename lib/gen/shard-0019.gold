code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var unique = 0;
	var i = 0;
	while i < g.n && g.res[i] <= mv {
		unique++;
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		i = j;
	}
	g.steps += g.n + 1;
	out.i = unique;
	out.s.clear();
	format(out.s, "counted ", unique, " unique items bounded");
	out
}
@end
