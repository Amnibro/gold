fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n < 2 {
		format(out.s, "deltas: []");
		out.i = 0;
		return out;
	}
	format(out.s, "deltas: [");
	let pairs = g.n - 1;
	for i in pairs {
		if i > 0 { format(out.s, ", "); }
		let diff = g.res[i + 1] - g.res[i];
		format(out.s, diff);
	}
	format(out.s, "]");
	out.i = pairs;
	g.steps += pairs;
	out
}
@end
