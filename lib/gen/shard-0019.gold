code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${k};
	let limit = if span > g.n { g.n } else { span };
	if limit > 1 {
		let first = g.res[0];
		for i in 1..limit {
			g.res[i - 1] = g.res[i];
		}
		g.res[limit - 1] = first;
	}
	g.steps += limit + 1;
	out.i = limit;
	out.s.clear();
	format(out.s, "rotated first ", limit, " search values");
	out
}
@end
@entry eaa6ce84fc8aa8bf
kind: step
verb: join
noun: squares
modifier: nested
context: search
slot: chunk_size int
phrase: join squares nested search blocks of size {chunk_size}
phrase: combine nested squared search weights in blocks {chunk_size}
test: list=1,2,3,4 chunk_size=2
expect: => i=2 r=0.0 ok=true s="nested squared search blocks: 2" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=2,3,4 chunk_size=3
expect: => i=1 r=0.0 ok=true s="nested squared search blocks: 1" errors=0 n=1 res=[29] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk_size};
	if c <= 0 || g.n == 0 { return out; }
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum_sq = 0;
		var j = 0;
		while j < c && (i + j) < g.n {
			let x = g.res[i + j];
			sum_sq += x * x;
			j++;
		}
		g.res[new_n] = sum_sq;
		new_n++;
		i += c;
	}
	g.steps += i + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "nested squared search blocks: ", new_n);
	out
}
@end
