@entry f4ac63f8c4d46b3c
kind: step
verb: scale
noun: cache
modifier: between
context: stats
phrase: scale cached observations between bounds {low} to {high}
phrase: store scaled values between range {low} to {high} in cache
slot: low int
slot: high int
test: list=5,15,25,35 low=10 high=30
expect: => i=2 r=0.0 ok=true s="cached 2 scaled values in range" errors=0 n=4 res=[5,15,25,35] cache=2 hits=0
test: list=12,22,32,42 low=20 high=40
expect: => i=2 r=0.0 ok=true s="cached 2 scaled values in range" errors=0 n=4 res=[12,22,32,42] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var matched = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			let val = g.res[i] * 2;
			gold_cache_put(g, g.res[i], val);
			matched++;
		}
	}
	out.i = matched;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached ", matched, " scaled values in range");
	out
}
@end
