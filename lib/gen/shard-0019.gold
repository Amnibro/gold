fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	var i = 1;
	while i < g.n {
		let bin = g.res[i] / 100;
		g.res[i] += bin;
		shifted++;
		i += 2;
	}
	g.steps += shifted;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted histogram alternate: ", shifted);
	out
}
