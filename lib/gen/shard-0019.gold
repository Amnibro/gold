fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = if ${max_len} < g.n { ${max_len} } else { g.n };
	var dups = 0;
	if bound > 1 {
		for i in 1..bound {
			if g.res[i] == g.res[i - 1] { dups++; }
		}
	}
	g.steps += bound + 1;
	out.i = dups;
	out.s.clear();
	format(out.s, "counted ", dups, " running duplicates");
	out
}
