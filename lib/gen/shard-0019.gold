code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var modified = 0;
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			modified += 1;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			modified += 1;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "clamp sequence bounds: ", modified);
	out
}
@end
