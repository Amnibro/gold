fn ${ID}(g Gold&, v Val) Val {
	// step_shlpltlin_box_shl
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnew(g, "plate", o);
	o.append(" box ");
	o.append("0,");
	o.append("0,");
	o.append("0.");
	o.append("02 ");
	o.append("0.");
	o.append("04,");
	o.append("0.");
	o.append("04,");
	gold_fnum(o, ${w});
	o.append(" sh0.0");
	o.append("03 m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "shlpltlin");
	out
}
@end
