kind: step
verb: apply
noun: numbers
modifier: between
context: error
phrase: apply function {f} to errors between {low} to {high}
phrase: transform faults between bounds {low} through {high} with {f}
slot: f fn
slot: low int
slot: high int
test: list=10,25,50,75 f=double low=20 high=60
expect: => i=2 r=0.0 ok=true s="applied between range: 2" errors=0 n=4 res=[10,50,100,75] cache=0 hits=0
test: list=5,15 f=double low=20 high=30
expect: => i=0 r=0.0 ok=true s="applied between range: 0" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			g.res[i] = ${f}(g.res[i]);
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "applied between range: ", count);
	out
}
@end
