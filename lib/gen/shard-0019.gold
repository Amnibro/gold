expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${count} <= 0 || ${step} <= 0 {
		gold_fail(g, "count and step must be positive");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in ${count} {
		total += (i + 1) * ${step};
	}
	out.i = total;
	out.s.clear();
	format(out.s, "running");
	out
}
@end
