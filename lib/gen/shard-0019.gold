expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: cliff3 box 0,6,2 16,3,4 m:matte #6e5f4d
expect: => doc: cave4 capsule -6,6,1 -6,3,1 r1.5 m:matte #3a352f
expect: => doc: cave5 capsule -3,6,1 -3,3,1 r1.5 m:matte #3a352f
expect: => doc: cave6 capsule 0,6,1 0,3,1 r1.5 m:matte #3a352f
expect: => doc: cave7 capsule 3,6,1 3,3,1 r1.5 m:matte #3a352f
test: n=0 r=1.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${r} <= 0.0 { gold_fail(g, "count or radius out of range"); out.ok = false; return out; }
	gold_dnews(g, "cliff", "", o);
	o.append(" box 0,6,");
	o.append("2 ");
	gold_fnum(o, 16.0);
	o.append(",3,4 m:matte ");
	gold_hex(o, 110, 95, 77);
	gold_doc(g, o);
	for q in ${n} {
		let px = -6.0 + 12.0 * ((q as real) / (${n} as real));
		o.clear();
		gold_dnews(g, "cave", "", o);
		o.append(" capsule ");
		gold_fnum(o, px);
		o.append(",6,1 ");
		gold_fnum(o, px);
		o.append(",3,1 r");
		gold_fnum(o, ${r});
		o.append(" m:matte ");
		gold_hex(o, 58, 53, 47);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ridge_caves");
	out
}
@end
