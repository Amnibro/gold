kind: step
verb: reverse
noun: head
modifier: recursively
context: stats
phrase: reverse head elements up to depth {depth}
phrase: invert leading head partition to depth {depth}
slot: depth int
test: list=1,2,3,4,5,6 depth=4
expect: => i=4 r=0.0 ok=true s="reversed head partition of size 4" errors=0 n=6 res=[4,3,2,1,5,6] cache=0 hits=0
test: list=10,20,30,40 depth=3
expect: => i=3 r=0.0 ok=true s="reversed head partition of size 3" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let bound = if d < g.n { d } else { g.n };
	var l = 0;
	var r = bound - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = bound;
	g.steps += bound;
	out.s.clear();
	format(out.s, "reversed head partition of size ", bound);
	out
}
@end
