fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in 0 .. g.n {
		let doubled = g.res[i] * 2;
		if doubled <= 50 {
			g.res[i] = doubled;
		} else {
			g.res[i] = 50;
		}
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scale_items_up_to: ", total);
	out
}
@end
