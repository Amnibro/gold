fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_sum = 0;
	var new_n = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			odd_sum += x;
		} else {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.res[new_n] = odd_sum;
	new_n++;
	g.n = new_n;
	out.i = odd_sum;
	out.s.clear();
	format(out.s, "merged all odds into total ", odd_sum);
	out
}
@end
