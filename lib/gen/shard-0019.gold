code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget};
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] <= cap {
			total += g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "merged budget: ", total);
	out
}
@end
