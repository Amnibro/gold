@entry e2daa61e488af600
kind: fn
verb: find
noun: minimum
modifier: times
context: core
phrase: find minimum times repeated
phrase: count minimum times present occurrences
test: arg=12131,456
expect: 3
expect: 1
test: arg=9988
expect: 2
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var min_d = 9;
	var count = 0;
	var temp = x;
	while temp > 0 {
		let d = temp % 10;
		if d < min_d { min_d = d; }
		temp /= 10;
	}
	while x > 0 {
		if x % 10 == min_d { count++; }
		x /= 10;
	}
	count
}
@end
