code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idxs int[128];
	for i in g.n {
		if i % 2 == 0 {
			idxs[count] = i;
			count++;
		}
	}
	for i in count {
		for j in count - 1 {
			let i1 = idxs[j];
			let i2 = idxs[j + 1];
			if g.res[i1] > g.res[i2] {
				let tmp = g.res[i1];
				g.res[i1] = g.res[i2];
				g.res[i2] = tmp;
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted ", count, " alternate elements");
	out
}
@end
