			if g.res[i] != g.res[i - 1] {
				g.res[w] = g.res[i];
				w++;
			}
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "selected unique runs: ", w);
	out
}
@end
@entry 69d46a1eda60b062
kind: step
verb: scan
noun: minimum
modifier: in_reverse
context: transform
phrase: scan running minimum in reverse list order
phrase: track backward minimum values in reverse traversal
test: list=4,2,7,1,5
expect: => i=5 r=0.0 ok=true s="scanned minimum in reverse" errors=0 n=5 res=[1,1,1,1,5] cache=0 hits=0
test: list=10,8,12,6
expect: => i=4 r=0.0 ok=true s="scanned minimum in reverse" errors=0 n=4 res=[6,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var cur_min = g.res[g.n - 1];
		var i = g.n - 1;
		while i >= 0 {
			if g.res[i] < cur_min { cur_min = g.res[i]; }
			g.res[i] = cur_min;
			i--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scanned minimum in reverse");
	out
}
@end
@entry 8699e24939f405c0
kind: step
verb: scale
noun: results
modifier: in_reverse
context: transform
phrase: scale reversed results by multiplying factor {mult}
phrase: multiply results in reverse order by {mult}
slot: mult int
test: list=1,2,3 mult=4
expect: => i=3 r=0.0 ok=true s="scaled reversed results by 4" errors=0 n=3 res=[12,8,4] cache=0 hits=0
test: list=10,20 mult=2
expect: => i=2 r=0.0 ok=true s="scaled reversed results by 2" errors=0 n=2 res=[40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	for i in (g.n / 2) {
		let t = g.res[i];
		g.res[i] = g.res[g.n - 1 - i] * m;
		g.res[g.n - 1 - i] = t * m;
	}
	if g.n % 2 == 1 {
		g.res[g.n / 2] *= m;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled reversed results by ", m);
	out
}
@end
