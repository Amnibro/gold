slot: thresh int
test: list=1,-1,2,-2 thresh=3
expect: => i=4 r=0.0 ok=true s="merged tally with retry: 4" errors=0 n=5 res=[1,1,2,2,4] cache=0 hits=0
test: list=5,6,7 thresh=2
expect: => i=3 r=0.0 ok=true s="merged tally with retry: 3" errors=0 n=4 res=[5,6,7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var pos = 0;
	for i in g.n {
		if g.res[i] > 0 { pos++; }
	}
	if pos < t {
		for i in g.n {
			if g.res[i] < 0 { g.res[i] = -g.res[i]; }
		}
		pos = 0;
		for i in g.n {
			if g.res[i] > 0 { pos++; }
		}
	}
	gold_push(g, pos);
	g.steps += g.n + 1;
	out.i = pos;
	out.s.clear();
	format(out.s, "merged tally with retry: ", pos);
	out
}
@end
