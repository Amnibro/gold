fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_tallied = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		let bucket = if freq > ${cap} { ${cap} } else { freq };
		g.res[i] = bucket;
		total_tallied += bucket;
	}
	out.i = total_tallied;
	out.s.clear();
	format(out.s, "histogram buckets capped at most ", ${cap});
	out
}
@end
