@entry c003c88a06571ce2
kind: step
verb: dedupe
noun: minimum
modifier: up_to
context: math
slot: ceiling int
phrase: dedupe minimum values bounded up to {ceiling}
phrase: prune duplicate minima restricted up to {ceiling}
test: list=3,3,7,3,12 ceiling=8
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,7,12] cache=0 hits=0
test: list=5,5,20,5 ceiling=15
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		i++;
	}
	var filtered: int[512] = [0; 512];
	var fn_len = 0;
	var seen_min = false;
	i = 0;
	while i < g.n {
		if g.res[i] == min_val && g.res[i] <= c {
			if !seen_min {
				filtered[fn_len] = g.res[i];
				fn_len++;
				seen_min = true;
			}
		} else {
			filtered[fn_len] = g.res[i];
			fn_len++;
		}
		i++;
	}
	gold_clear(g);
	var k = 0;
	while k < fn_len {
		gold_push(g, filtered[k]);
		k++;
	}
	g.steps += g.n;
	out.i = fn_len;
	out
}
@end
