code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var i = 0;
	while i < g.n {
		if g.res[i] > c { g.res[i] = c; }
		i++;
	}
	// sort descending
	i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] < g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out
}
@end
