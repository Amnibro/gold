fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		let t = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = t;
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse_subfunction_every_other: ", g.n);
	out
}
@end
