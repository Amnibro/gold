fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pos};
	let sz = ${size};
	let cd = ${code};
	var count = 0;
	for i in sz {
		let idx = p + i;
		if idx >= 0 && idx < g.n {
			g.res[idx] = cd;
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "filled window entries: ", count);
	out
}
@end
