expect: => doc: crate box 1,2,.5 1,1,1 nz0.02:0.2
test: a=0.05 b=0.5 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=2 r=0.0 ok=true s="roughen" errors=0 n=0 res=[] cache=0 hits=0
