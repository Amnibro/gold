test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="counted 2 middle partition items" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		out.s.clear();
		format(out.s, "sample too small for middle");
		return out;
	}
	let start = g.n / 4;
	let end = g.n - start;
	var mid_count = 0;
	var j = start;
	while j < end {
		mid_count++;
		j++;
	}
	out.i = mid_count;
	g.steps += mid_count;
	out.s.clear();
	format(out.s, "counted ", mid_count, " middle partition items");
	out
}
@end
