		for j in i + 1 .. g.n {
			if g.res[i] == g.res[j] {
				is_last = false;
				break;
			}
		}
		if is_last {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped down to ", w, " elements");
