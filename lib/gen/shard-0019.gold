phrase: sum digits of {n} safely
phrase: safely sum the digits of {n}
slot: n int
test: n=482
expect: => i=14 r=0.0 ok=true s="safely" errors=0 n=0 res=[] cache=0 hits=0
test: n=9051
expect: => i=15 r=0.0 ok=true s="safely" errors=0 n=0 res=[] cache=0 hits=0
test: n=-5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 0 || ${n} > 1000000000 {
		gold_fail(g, "value out of safe range");
		out.ok = false;
		return out;
	}
	var num = ${n};
	var total = 0;
	while num > 0 {
		total += num % 10;
		num /= 10;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "safely");
	out
}
@end
