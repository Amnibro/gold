@entry 00cc230aa9e1e673
kind: step
verb: keep
noun: histogram
modifier: with_retry
context: sort
slot: retries int
phrase: sort keep histogram with retry attempt {retries}
phrase: sort retain frequencies with retry budget {retries}
test: list=2,2,3,4,4,4 retries=2
expect: => i=3 r=0.0 ok=true s="tallied 3 histogram entries" errors=0 n=6 res=[2,2,3,4,4,4] cache=3 hits=0
test: list=10,10,20,30,30 retries=1
expect: => i=3 r=0.0 ok=true s="tallied 3 histogram entries" errors=0 n=5 res=[10,10,20,30,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var distinct = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		gold_cache_put(g, g.res[i], freq);
		distinct++;
		i = j;
	}
	g.steps += g.n + max_r;
	out.i = distinct;
	out.s.clear();
	format(out.s, "tallied ", distinct, " histogram entries");
	out
}
