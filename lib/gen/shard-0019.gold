test: list=9,16,25
expect: => i=3 r=0.0 ok=true s="scanned factors nested for 3 numbers" errors=0 n=3 res=[3,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var val = g.res[k];
		if val < 0 { val = -val; }
		var factors = 0;
		var d = 1;
		while d <= val {
			if val % d == 0 { factors++; }
			d++;
		}
		g.res[k] = factors;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "scanned factors nested for ", g.n, " numbers");
	out
}
@end
