code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var truncated = 0;
	for k in d {
		let idx = g.n - 1 - k;
		if idx >= 0 && g.res[idx] > 50 {
			g.res[idx] = 50;
			truncated++;
		}
	}
	g.steps += truncated + g.n;
	out.i = truncated;
	out.s.clear();
	format(out.s, "limited tail nested: ", truncated);
	out
}
@end
@entry fef4f3ac9612e477
kind: step
verb: drop
noun: runs
modifier: safely
context: loop
phrase: drop consecutive runs safely threshold {t}
phrase: remove repeating runs safely length {t}
slot: t int
test: list=1,2,2,2,3,4 t=3
expect: => i=3 r=0.0 ok=true s="dropped runs safely: 3" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=5,5,6,7,7,7 t=2
expect: => i=5 r=0.0 ok=true s="dropped runs safely: 5" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${t};
	if lim <= 1 { gold_fail(g, "run threshold must exceed one"); out.ok = false; return out; }
	var w = 0;
	var r = 0;
	var dropped = 0;
	while r < g.n {
		var count = 1;
		while r + count < g.n && g.res[r + count] == g.res[r] {
			count++;
		}
		if count >= lim {
			dropped += count;
			r += count;
		} else {
			for k in count {
				g.res[w] = g.res[r + k];
				w++;
			}
			r += count;
		}
	}
	g.n = w;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped runs safely: ", dropped);
	out
}
@end
@entry dae5f922a7b32e9e
kind: step
verb: normalize
noun: maximum
modifier: recursively
context: loop
phrase: normalize maximum recursively divisor {d}
phrase: scale peak values recursively by {d}
slot: d int
test: list=10,500,20 d=2
expect: => i=3 r=0.0 ok=true s="normalized maximum recursively: 3" errors=0 n=3 res=[10,62,20] cache=0 hits=0
test: list=50,1000,80 d=5
expect: => i=2 r=0.0 ok=true s="normalized maximum recursively: 2" errors=0 n=3 res=[50,40,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${d};
	if div <= 1 { gold_fail(g, "divisor must exceed one"); out.ok = false; return out; }
	var steps = 0;
	var max_idx = -1;
	var max_val = -1;
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	if max_idx >= 0 {
		while g.res[max_idx] > 100 {
			g.res[max_idx] /= div;
			steps++;
		}
	}
	g.steps += g.n + steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "normalized maximum recursively: ", steps);
	out
}
@end
@entry bbbfb8c170716b95
kind: step
