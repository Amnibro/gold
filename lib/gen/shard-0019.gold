fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	var i = g.n - k;
	while i < g.n {
		var x = g.res[i];
		if x < ${low} { x = ${low}; }
		else if x > ${high} { x = ${high}; }
		g.res[i] = x;
		i++;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "suffix clamped");
	out
}
@end
@entry 9dbf8be8e319ed3d
kind: step
verb: keep
noun: errors
modifier: unique
context: core
phrase: keep errors unique count within threshold {limit}
phrase: filter errors unique occurrences below limit {limit}
slot: limit int
test: list=1,2,2,3,3,3 limit=5
expect: => i=3 r=0.0 ok=true s="unique: 3" errors=3 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,5,6,6 limit=4
expect: => i=3 r=0.0 ok=true s="unique: 3" errors=2 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count {
			if kept[j] == x { seen = true; break; }
		}
		if !seen && count < ${limit} {
			kept[count] = x;
			count++;
		} else if seen {
			g.errors++;
		}
	}
	g.n = 0;
	for j in count { gold_push(g, kept[j]); }
	out.i = count;
	out.s.clear();
	format(out.s, "unique: ", count);
	out
}
@end
