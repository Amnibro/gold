code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let last_val = g.res[g.n - 1];
	for i in (g.n - 1) {
		g.res[i] += last_val;
	}
	g.steps += g.n;
	out.i = last_val;
	out.s.clear();
	format(out.s, "shifted prefix by last: ", last_val);
	out
}
@end
