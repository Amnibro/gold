fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let bound = if count < g.n { count } else { g.n };
	let start = g.n - bound;
	for i in bound {
		g.res[i] = g.res[start + i];
	}
	g.n = bound;
	g.steps += bound + 1;
	out.i = bound;
	out.s.clear();
	format(out.s, "kept ", bound, " tail elements");
	out
}
