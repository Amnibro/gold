expect: => doc: post cyl 0,0,0 0,0,2 r.1 nz0.05:0.5
test: a=1.0 b=1.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no item yet"); out.ok = false; return out; }
	o.push(' ');
	o.append("nz");
	gold_fnum(o, ${a});
	o.append(":");
	gold_fnum(o, ${b});
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "roughen");
	out
}
@end
