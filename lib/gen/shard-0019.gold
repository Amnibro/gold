phrase: filter error checkpoints every {step} intervals
slot: step int
test: list=10,20,30,40,50 step=2
expect: => i=3 r=0.0 ok=true s="checkpoint samples: 3" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=1,2,3 step=1
expect: => i=3 r=0.0 ok=true s="checkpoint samples: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if s <= 0 { return out; }
	var m = 0;
	var i = 0;
	while i < g.n {
		g.res[m] = g.res[i];
		m++;
		i += s;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "checkpoint samples: ", m);
	out
}
@end
