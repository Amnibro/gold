code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${threshold};
	var max_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	g.steps += g.n + 1;
	out.i = max_val;
	out.ok = (max_val >= target);
	if !out.ok {
		gold_fail(g, "peak score below threshold");
	}
	out.s.clear();
	format(out.s, "peak search score ", max_val, " status: ", out.ok);
	out
}
@end
