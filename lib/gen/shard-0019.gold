@entry 1d7ee2576cfffe47
kind: step
verb: normalize
noun: items
modifier: while
context: error
phrase: normalize error items while above {cutoff}
phrase: scale fault entries while exceeding {cutoff}
slot: cutoff int
test: list=150,220,80 cutoff=100
expect: => i=3 r=0.0 ok=true s="normalized items: 3" errors=0 n=3 res=[50,20,80] cache=0 hits=0
test: list=50,75,90 cutoff=100
expect: => i=0 r=0.0 ok=true s="normalized items: 0" errors=0 n=3 res=[50,75,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var changed = 0;
	for i in g.n {
		while g.res[i] > cut {
			g.res[i] -= cut;
			changed++;
		}
	}
	g.steps += g.n + changed;
	out.i = changed;
