@entry c183b8bd51805e3a
kind: step
verb: sort
noun: letters
modifier: every_other
context: math
slot: shift int
phrase: sort alternate letters every other step offset {shift}
phrase: reorder every other letter character adding {shift}
test: text="dbca" shift=1
expect: => i=4 r=0.0 ok=true s="dbea" errors=0 n=0 res=[] cache=0 hits=0
test: text="geca" shift=2
expect: => i=4 r=0.0 ok=true s="eeia" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	var evens: byte[..100] = [];
	var i = 0;
	while i < out.s.len {
		evens.push(out.s[i]);
		i += 2;
	}
	// sort evens
	var p = 0;
	while p < evens.len {
		var q = p + 1;
		while q < evens.len {
			if evens[p] > evens[q] {
				let t = evens[p];
				evens[p] = evens[q];
				evens[q] = t;
			}
			q++;
		}
		p++;
	}
	// place back
	var idx = 0;
	var k = 0;
	while k < out.s.len {
		out.s[k] = (evens[idx] as int + s) as! byte;
		idx++;
		k += 2;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
