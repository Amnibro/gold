	if ${stride} <= 0 {
		out.ok = false;
		return out;
	}
	var count = 0;
	var k = 0;
	while k < g.n {
		g.res[count] = g.res[k];
		count++;
		k += ${stride};
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " stride elements in place");
	out
}
