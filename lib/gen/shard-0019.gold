noun: function
modifier: running
context: aggregate
phrase: merge function running successive totals
phrase: apply function running accumulation step
test: list=2,3,4,5
expect: => i=38 r=0.0 ok=true s="merge_function_running: 38" errors=0 n=3 res=[6,12,20] cache=0 hits=0
test: list=1,4,2,3
expect: => i=18 r=0.0 ok=true s="merge_function_running: 18" errors=0 n=3 res=[4,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	if g.n >= 2 {
		for i in 0 .. g.n - 1 {
			let prod = g.res[i] * g.res[i + 1];
			g.res[i] = prod;
			sum += prod;
		}
		g.n--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merge_function_running: ", sum);
	out
}
@end
@entry 3a3db56f8e7e261e
kind: step
verb: retry
noun: history
modifier: between
context: aggregate
phrase: retry history between low high interval
phrase: scan history between range limits retry
test: list=10,25,50,15
expect: => i=25 r=0.0 ok=true s="retry_history_between: 25" errors=0 n=4 res=[10,25,50,15] cache=0 hits=0
test: list=5,12,30,8
expect: => i=30 r=0.0 ok=true s="retry_history_between: 30" errors=0 n=4 res=[5,12,30,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_val = 0;
	var ok = false;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] >= 20 && g.res[idx] <= 40 {
			found_val = g.res[idx];
			ok = true;
			break;
		}
		idx--;
	}
	g.steps += g.n;
	out.i = found_val;
	out.ok = ok;
	out.s.clear();
	format(out.s, "retry_history_between: ", found_val);
	out
}
@end
