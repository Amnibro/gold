@entry fb392d69dcf6ce5f
kind: step
verb: normalize
noun: sequence
modifier: while
context: stats
phrase: normalize statistical sequence while sum exceeds {cap}
phrase: scale down statistical variance sequence while over {cap}
slot: cap int
test: list=40,60,80 cap=50
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=10,20,30 cap=40
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var iters = 0;
	while iters < 10 {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		if sum <= ceiling { break; }
		for k in g.n { g.res[k] /= 2; }
		iters++;
	}
	out.i = iters;
	out
}
@end
@entry bb14558ac474a9a9
kind: step
verb: normalize
noun: streak
modifier: each
context: stats
phrase: normalize each consecutive statistical run streak
phrase: standardize each repeated statistical measurement streak
