@entry 3ab56e2635610e55
kind: step
verb: group
noun: counter
modifier: each
context: error
phrase: group counter for each distinct error
phrase: tally frequencies for each error code
test: list=500,500,404,500,200
expect: => i=3 r=0.0 ok=true s="grouped error counts: 3" errors=0 n=3 res=[3,1,1] cache=0 hits=0
test: list=100,200,300
expect: => i=3 r=0.0 ok=true s="grouped error counts: 3" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var codes int[64] = [0; 64];
	var counts int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let code = g.res[i];
		var found = false;
		for j in uc {
			if codes[j] == code {
				counts[j]++;
				found = true;
				break;
			}
		}
		if !found && uc < 64 {
			codes[uc] = code;
			counts[uc] = 1;
			uc++;
		}
	}
	for j in uc {
		g.res[j] = counts[j];
	}
	g.n = uc;
	g.steps += g.n + uc;
	out.i = uc;
	out.s.clear();
	format(out.s, "grouped error counts: ", uc);
	out
}
@end
@entry 45586d16037d3484
kind: step
verb: limit
noun: range
modifier: last
context: error
phrase: limit range of last errors between {low} to {high}
phrase: restrict last fault range from {low} to {high}
slot: low int
slot: high int
test: list=100,404,500,503 low=400 high=502
expect: => i=2 r=0.0 ok=true s="limited range last errors: 2" errors=0 n=2 res=[404,500] cache=0 hits=0
test: list=200,201,204 low=400 high=500
expect: => i=0 r=0.0 ok=true s="limited range last errors: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var valid = 0;
	var k = 0;
	while k < g.n {
		let code = g.res[k];
		if code >= lo && code <= hi {
			g.res[valid] = code;
			valid++;
		}
		k++;
	}
	g.n = valid;
	g.steps += g.n + valid;
	out.i = valid;
	out.s.clear();
	format(out.s, "limited range last errors: ", valid);
	out
}
@end
@entry e02820977cbe27f5
kind: step
verb: cache
noun: subfunction
modifier: every_other
context: error
phrase: cache transformed errors every other index using {sub}
phrase: store alternate subfunction {sub} error results in cache
slot: sub fn
test: list=10,20,30,40 sub=double
expect: => i=2 r=0.0 ok=true s="cached alternate subfunction: 2" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=5 sub=double
expect: => i=1 r=0.0 ok=true s="cached alternate subfunction: 1" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached = 0;
	var i = 0;
	while i < g.n {
		let val = ${sub}(g.res[i]);
		gold_cache_put(g, i, val);
		cached++;
		i += 2;
	}
	g.steps += cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached alternate subfunction: ", cached);
	out
}
@end
