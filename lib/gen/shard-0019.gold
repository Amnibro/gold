@entry 30fdb674b3021368
kind: step
verb: map
noun: evens
modifier: up_to
context: loop
phrase: map even numbers up to ceiling {limit}
phrase: transform even values bounded up to {limit}
slot: limit int
test: list=2,3,4,8 limit=5
expect: => i=2 r=0.0 ok=true s="mapped evens up to ceiling: 2" errors=0 n=4 res=[4,3,8,8] cache=0 hits=0
test: list=1,6,7,12 limit=10
expect: => i=1 r=0.0 ok=true s="mapped evens up to ceiling: 1" errors=0 n=4 res=[1,12,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && g.res[i] <= lim {
			g.res[i] *= 2;
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped evens up to ceiling: ", count);
	out
}
@end
@entry 553367b8b0ae1247
kind: step
verb: merge
noun: results
modifier: sorted
context: loop
phrase: merge extra value into sorted results {extra}
phrase: insert item into sorted results list {extra}
slot: extra int
test: list=1,3,5 extra=4
expect: => i=4 r=0.0 ok=true s="merged into sorted results: 4" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
test: list=10,20,40 extra=15
expect: => i=4 r=0.0 ok=true s="merged into sorted results: 4" errors=0 n=4 res=[10,15,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = ${extra};
	var inserted = false;
	var temp int[64];
	var tn = 0;
	for i in g.n {
		if !inserted && val < g.res[i] {
			temp[tn] = val;
			tn++;
			inserted = true;
		}
		temp[tn] = g.res[i];
		tn++;
	}
	if !inserted {
		temp[tn] = val;
		tn++;
	}
	gold_clear(g);
	for i in tn {
