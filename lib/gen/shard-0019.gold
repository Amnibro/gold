test: list=100,200 maxsum=50
expect: => i=0 r=0.0 ok=true s="limited running tail: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${maxsum};
	var sum = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if sum + g.res[i] <= cap {
			sum += g.res[i];
			count++;
		} else {
			break;
		}
		i--;
	}
	var m = 0;
	let start = g.n - count;
	while m < count {
		g.res[m] = g.res[start + m];
		m++;
	}
	g.n = count;
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited running tail: ", count);
	out
}
@end
