@entry 3995c33a21d2021e
kind: step
verb: return
noun: maximum
modifier: at_most
context: compare
phrase: compare return maximum capped at most {cap}
phrase: extract maximum comparison value up to ceiling {cap}
slot: cap int
test: list=10,45,30,80 cap=50
expect: => i=45 r=0.0 ok=true s="capped maximum value: 45" errors=0 n=4 res=[10,45,30,80] cache=0 hits=0
test: list=5,15,25 cap=20
expect: => i=15 r=0.0 ok=true s="capped maximum value: 15" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var mx = -1000000000;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x <= ceiling {
			if !found || x > mx {
				mx = x;
				found = true;
			}
		}
	}
	g.steps += g.n;
	if found {
		out.i = mx;
		out.s.clear();
