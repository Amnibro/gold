test: img=16 u=34
expect: => i=256 r=0.0 ok=true s="sand" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.078 max=0.953 sum8=29060 hash=198301
test: img=32 u=35
expect: => i=1024 r=0.0 ok=true s="sand" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.103 max=0.94 sum8=105461 hash=487771
test: u=1
