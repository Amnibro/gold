slot: budget int
test: list=10,20,30,40 budget=2
expect: => i=2 r=0.0 ok=true s="checked tail: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 budget=1
expect: => i=1 r=0.0 ok=true s="checked tail: 1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var b = ${budget};
	var checked = 0;
	var i = g.n - 1;
	while i >= 0 && b > 0 {
		checked++;
		b--;
		i--;
	}
	g.steps += checked;
	out.i = checked;
	out.s.clear();
	format(out.s, "checked tail: ", checked);
	out
}
@end
@entry 9dfdcbc344133575
kind: step
verb: swap
noun: tally
modifier: between
context: transform
phrase: swap tally between items across stride {stride}
phrase: exchange tally values across span {stride}
slot: stride int
test: list=10,20,30,40 stride=2
expect: => i=1 r=0.0 ok=true s="swapped tally across stride 2" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
test: list=1,2,3,4,5 stride=1
expect: => i=1 r=0.0 ok=true s="swapped tally across stride 1" errors=0 n=5 res=[2,1,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	var swaps = 0;
	if s > 0 && s < g.n {
		let t = g.res[0];
		g.res[0] = g.res[s];
		g.res[s] = t;
		swaps++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped tally across stride ", s);
	out
}
@end
@entry 2c5f9f76904ec05a
kind: step
verb: pair
noun: runs
modifier: running
context: transform
phrase: pair running runs of consecutive equal values
phrase: group adjacent running runs into pairs
test: list=1,1,2,2,3,3
expect: => i=3 r=0.0 ok=true s="paired 3 running runs" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=4,4,4,5,5
expect: => i=2 r=0.0 ok=true s="paired 2 running runs" errors=0 n=5 res=[4,4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " running runs");
	out
}
@end
