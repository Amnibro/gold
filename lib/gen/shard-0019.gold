code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		var cnt = 0;
		for j in i + 1 {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt > limit { g.res[i] = 0; }
	}
	out.i = g.n;
	out
}
@end
