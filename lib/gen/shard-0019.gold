expect: => i=1 r=0.0 ok=true s="last streak length: 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 1;
	if g.n == 0 { streak = 0; }
	else {
		var k = g.n - 1;
		while k > 0 && g.res[k] == g.res[k - 1] {
			streak++;
			k--;
		}
	}
	g.steps += streak;
	out.i = streak;
	out.s.clear();
	format(out.s, "last streak length: ", streak);
	out
}
@end
