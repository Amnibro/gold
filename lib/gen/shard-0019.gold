code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_allowed};
	var filtered: int[512] = [0; 512];
	var fn_len = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var c = 0;
		var j = 0;
		while j < fn_len {
			if filtered[j] == x { c++; }
			j++;
		}
		if c < cap {
			filtered[fn_len] = x;
			fn_len++;
		}
		i++;
	}
	gold_clear(g);
	var k = 0;
	while k < fn_len {
		gold_push(g, filtered[k]);
		k++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
