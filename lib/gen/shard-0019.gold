kind: step
verb: check
noun: streak
modifier: nested
context: transform
phrase: check nested streaks exceeding length {k}
phrase: verify nested streaks above threshold {k}
slot: k int
test: list=1,1,2,2,2,3 k=2
expect: => i=2 r=0.0 ok=true s="found 2 streaks" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=5,5,5,5,6 k=3
expect: => i=1 r=0.0 ok=true s="found 1 streaks" errors=0 n=5 res=[5,5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	var streaks = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len >= limit { streaks++; }
			cur_len = 1;
		}
	}
	if g.n > 0 && cur_len >= limit { streaks++; }
	g.steps += g.n;
	out.i = streaks;
	out.s.clear();
	format(out.s, "found ", streaks, " streaks");
	out
}
@end
