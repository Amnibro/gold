		return out;
	}
	format(out.s, "recurring(>=", req, "): [");
	var matched = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first {
			var occ = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { occ++; }
			}
			if occ >= req {
				if matched > 0 { format(out.s, ", "); }
				format(out.s, g.res[i]);
				matched++;
			}
		}
	}
	format(out.s, "]");
	out.i = matched;
	g.steps += g.n * g.n;
	out
}
@end
