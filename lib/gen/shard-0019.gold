fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found = i;
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = found;
	out.ok = found >= 0;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found target at index ", found);
	} else {
		format(out.s, "target not found");
	}
	out
}
