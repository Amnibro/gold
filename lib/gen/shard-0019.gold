	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		let ok = g.res[i] <= max_bound;
		if ok { valid_count++; }
		format(out.s, if ok { "ok" } else { "err" });
	}
	format(out.s, "]");
	out.i = valid_count;
	g.steps += g.n;
	out
}
@end
