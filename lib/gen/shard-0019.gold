fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_tot = ${floor};
	var alt_sum = 0;
	var i = 0;
	while i < g.n {
		alt_sum += g.res[i];
		i += 2;
	}
	out.i = alt_sum;
	out.ok = alt_sum >= min_tot;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "alternating total ", alt_sum, " against floor ", min_tot);
	out
}
@end
