fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			var scaled = x * ${factor};
			if scaled > ${limit} { scaled = ${limit}; }
			gold_cache_put(g, x, scaled);
			g.res[i] = scaled;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled with cache");
	out
}
@end
