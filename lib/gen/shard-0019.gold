fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in 0 .. g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pair_gaps_pairwise: ", out.i);
	out
}
