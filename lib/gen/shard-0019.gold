@entry 8468dd4acafc64b1
kind: step
verb: rotate
noun: number
modifier: recursively
context: format
phrase: format cyclical digit shifts of initial element
phrase: render recursive digit rotations of leading item
phrase: display cyclic permutations of first value
test: list=1234,50
expect: => i=4 r=0.0 ok=true s="rot_cycle(1234): [1234, 2341, 3412, 4123]" errors=0 n=2 res=[1234,50] cache=0 hits=0
test: list=42
expect: => i=2 r=0.0 ok=true s="rot_cycle(42): [42, 24]" errors=0 n=1 res=[42] cache=0 hits=0
test: list=7
expect: => i=1 r=0.0 ok=true s="rot_cycle(7): [7]" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "rot: empty");
		out.i = 0;
		return out;
	}
	var num = g.res[0];
	if num < 0 { num = -num; }
	format(out.s, "rot_cycle(", num, "): [");
	var d int[16] = [0; 16];
	var len = 0;
	var temp = num;
	while temp > 0 {
		d[len] = temp % 10;
		len++;
		temp /= 10;
	}
	if len == 0 {
		format(out.s, "0]");
		out.i = 0;
		return out;
	}
	for shift in len {
		if shift > 0 { format(out.s, ", "); }
		var rot_val = 0;
		for j in len {
			let idx = (len - 1 - j + len - shift) % len;
			rot_val = rot_val * 10 + d[idx];
		}
		format(out.s, rot_val);
	}
	format(out.s, "]");
	out.i = len;
	g.steps += len;
	out
}
@end
