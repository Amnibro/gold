fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in 0 .. g.n {
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	if total >= 50 {
		out.ok = true;
	} else {
		gold_fail(g, "check tally all below threshold");
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "check_tally_all: ", total);
	out
}
@end
