fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget_cap};
	var allocated = 0;
	var kept = 0;
	for i in g.n {
		let rank_cost = i + 1;
		if allocated + rank_cost <= cap {
			allocated += rank_cost;
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "allocated rank budget to ", kept, " items");
	out
}
