code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= ${min_val} && ${ID}_is_prime(x) {
			sum += x;
		}
	}
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "prime sum: ", sum);
	out
}
@end
