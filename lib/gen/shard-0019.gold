noun: average
modifier: in_place
context: list
phrase: reverse digits around mean average in place
phrase: reflect number digits relative to digit average
test: arg=1234,9870
expect: 123
expect: 12543
test: arg=505,100
expect: 161
expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	var count = 0;
	var tmp = x;
	while tmp > 0 {
		sum += tmp % 10;
		count++;
		tmp /= 10;
	}
	if count == 0 { return 0; }
	let avg = sum / count;
	var rev = 0;
	while x > 0 {
		let d = x % 10;
		let shifted = if d >= avg { avg - (d - avg) } else { avg + (avg - d) };
		rev = rev * 10 + (if shifted < 0 { 0 } else { shifted });
		x /= 10;
	}
	rev
}
@end
