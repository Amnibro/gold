code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	var max_idx = 0;
	for i in g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let tmp = g.res[min_idx];
	g.res[min_idx] = g.res[max_idx];
	g.res[max_idx] = tmp;
	out.i = 2;
	out.s.clear();
	format(out.s, "swapped extremes");
	out
}
@end
