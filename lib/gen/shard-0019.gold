expect: => i=0 r=0.0 ok=false s="pairwise monotonic search series: false" errors=1 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i - 1] < g.res[i] {
				valid = false;
				break;
			}
		}
	}
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	if !valid { gold_fail(g, "series pairwise order violation"); }
	out.s.clear();
	format(out.s, "pairwise monotonic search series: ", valid);
	out
}
@end
