code:
fn ${ID}_chk_prime(n int) bool {
	if n < 2 { return false; }
	for d in 100 {
		let div = d + 2;
		if div * div > n { break; }
		if n % div == 0 { return false; }
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[64];
	var pn = 0;
	for i in g.n {
		if ${ID}_chk_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		}
	}
	gold_clear(g);
	for i in pn {
		gold_push(g, primes[i]);
	}
	g.steps += g.n + 1;
	out.i = pn;
	out.s.clear();
	format(out.s, "scanned primes recursively count: ", pn);
	out
}
@end
