expect: => i=3 r=0.0 ok=true s="filtered loop between bounds" errors=0 n=3 res=[6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var write_idx = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filtered loop between bounds");
	out
}
@end
@entry 92db0307067dfe24
kind: step
verb: search
noun: letters
modifier: every_other
context: compare
phrase: search letters every other position for {target}
phrase: compare alternate letters seeking target {target}
slot: target text
test: text="abcdef" target="c"
expect: => i=2 r=0.0 ok=true s="searched letters every other" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana" target="b"
expect: => i=0 r=0.0 ok=true s="searched letters every other" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if tgt.len == 0 {
		out.i = -1;
		return out;
	}
	let target_char = tgt[0];
	var found_idx = -1;
	var i = 0;
	while i < out.s.len {
		if out.s[i] == target_char {
			found_idx = i;
			break;
		}
		i += 2;
	}
	out.i = found_idx;
	g.steps += out.s.len;
	out.s.clear();
	format(out.s, "searched letters every other");
	out
}
@end
@entry e6e8849661b17659
kind: step
verb: count
noun: primes
modifier: last
context: stats
phrase: count primes in the last {n} numbers up to {m}
phrase: count the primes among the last {n} values up to {m}
slot: n int
slot: m int
test: n=5 m=10
expect: => i=1 r=0.0 ok=true s="primes" errors=0 n=0 res=[] cache=0 hits=0
test: n=10 m=20
expect: => i=4 r=0.0 ok=true s="primes" errors=0 n=0 res=[] cache=0 hits=0
test: n=5 m=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 1 || ${m} < 1 || ${n} > ${m} {
		gold_fail(g, "invalid range");
		out.ok = false;
		return out;
	}
	var count = 0;
	var start = ${m} - ${n} + 1;
	for k in ${n} {
		var x = start + k;
		if x >= 2 {
			var is_p = true;
			for d in x - 2 {
				var div = d + 2;
				if div * div <= x && x % div == 0 { is_p = false; }
			}
			if is_p { count++; }
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "primes");
	out
}
@end
