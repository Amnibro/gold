code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rep};
	if r <= 0 { gold_fail(g, "repetitions must be positive"); out.ok = false; return out; }
	for k in r {
		for i in g.n {
			var val = g.res[i];
			var dsum = 0;
			while val > 0 {
				dsum += val % 10;
				val /= 10;
			}
			g.res[i] = dsum;
		}
	}
	g.steps += g.n * r;
	out.i = r;
	out.s.clear();
	format(out.s, "applied digits times: ", r);
	out
}
@end
