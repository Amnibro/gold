fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 24 || ${a} <= 0.0 { gold_fail(g, "count or span out of range"); out.ok = false; return out; }
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${a};
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * ${a};
		o.clear();
		gold_dnews(g, "mound", "", o);
		o.append(" ellipsoid ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("2");
		o.append(" ");
		gold_fnum(o, 2.5);
		o.append(",");
		gold_fnum(o, 2.5);
		o.append(",.6 ~.4 m:matte ");
		gold_hex(o, 92, 122, 66);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "shallow_mounds");
	out
}
@end
