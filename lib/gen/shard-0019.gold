test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.736 max=1 sum8=58071 hash=24652
test: img=32 u=3
expect: => i=1024 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.529 max=1 sum8=202921 hash=361024
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 3 < 1 || 3 > 5 { gold_fail(g, "octaves must be in range"); out.ok = false; return out; }
	var c0 = 16;
	for o in 3 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 16;
			for o in 3 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.1); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
