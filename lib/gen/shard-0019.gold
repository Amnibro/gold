code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_val = ${thresh};
	var acc = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= limit_val { break; }
		acc += g.res[i];
		i++;
	}
	gold_push(g, acc);
	out.i = acc;
	g.steps += i;
	out.s.clear();
	format(out.s, "merged sub-threshold sum ", acc);
