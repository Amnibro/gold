test: arg=132,123
expect: 1
expect: 0
test: arg=321
expect: 2
code:
fn ${ID}(n int) int {
	var v = if n < 0 { -n } else { n };
	var errs = 0;
	var prev = -1;
	while v > 0 {
		let cur = v % 10;
		if prev != -1 && cur > prev {
			errs++;
		}
		prev = cur;
		v /= 10;
	}
	errs
}
@end
