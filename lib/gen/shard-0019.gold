fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	let m = ${min_sum};
	var count = 0;
	if s > 0 && g.n >= s {
		for i in (g.n - s + 1) {
			var sum = 0;
			for k in s {
				sum += g.res[i + k];
			}
			if sum >= m {
				count++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "counted windows at least min sum: ", count);
	out
}
