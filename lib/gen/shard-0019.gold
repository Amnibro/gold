code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	let start = if g.n > ${size} { g.n - ${size} } else { 0 };
	var k = start;
	while k + 1 < g.n {
		if g.res[k] > g.res[k + 1] {
			sorted = false;
			break;
		}
		k++;
	}
	out.ok = sorted;
	out.i = if sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked last window sorted: ", sorted);
	out
}
@end
