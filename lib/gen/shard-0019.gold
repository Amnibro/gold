test: list=4,2,4,7,2
expect: => i=2 r=0.0 ok=true s="measure_duplicates_sorted: 2" errors=0 n=5 res=[2,2,4,4,7] cache=0 hits=0
test: list=9,5,1,5,3
expect: => i=1 r=0.0 ok=true s="measure_duplicates_sorted: 1" errors=0 n=5 res=[1,3,5,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	for i in 0 .. g.n {
		for j in i + 1 .. g.n {
			if g.res[j] == g.res[i] {
				dups++;
				break;
			}
		}
	}
	for i in 0 .. g.n {
		for j in i + 1 .. g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "measure_duplicates_sorted: ", dups);
	out
}
@end
