@entry af73f065b82a1586
kind: step
verb: scale
noun: cache
modifier: sorted
context: stats
phrase: scale sorted sample populating cache {mul}
phrase: record sorted scaled observations in cache {mul}
slot: mul int
test: list=3,1,4,2 mul=10
expect: => i=4 r=0.0 ok=true s="cached min/max of sorted scaled sample" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
test: list=8,5,9 mul=5
expect: => i=3 r=0.0 ok=true s="cached min/max of sorted scaled sample" errors=0 n=3 res=[25,40,45] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mul};
	for i in g.n {
		var j = 0;
		while j + 1 < g.n {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	for i in g.n { g.res[i] *= m; }
	if g.n > 0 {
		gold_cache_put(g, g.res[0], g.res[g.n - 1]);
	}
	out.i = g.n;
	g.steps += g.n * 2;
	out.s.clear();
	format(out.s, "cached min/max of sorted scaled sample");
	out
}
@end
