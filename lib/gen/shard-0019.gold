slot: k int
test: list=15,25,35,45 k=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[0,10,20,45] cache=0 hits=0
test: list=10,20,5 k=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[0,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = min(${k}, g.n);
	if len <= 0 { return out; }
	var min_val = g.res[0];
	for i in len {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var idx = len - 1;
	while idx >= 0 {
		g.res[idx] -= min_val;
		idx--;
	}
	out.i = len;
	out
}
@end
