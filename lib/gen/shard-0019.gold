@entry 83fccd99ba2fc4e8
kind: step
verb: repeat
noun: digits
modifier: at_most
context: math
slot: max_reps int
phrase: repeat number digits at most {max_reps} times
phrase: duplicate each digit bounded at most by {max_reps}
test: input=123 max_reps=2
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: input=405 max_reps=3
expect: => i=9 r=0.0 ok=true s="" errors=0 n=9 res=[4,4,4,0,0,0,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_reps};
	var num = out.i;
	if num < 0 { num = -num; }
	var digs: int[32] = [0; 32];
	var dn = 0;
	while num > 0 {
		digs[dn] = num % 10;
		dn++;
		num /= 10;
	}
	gold_clear(g);
	var i = dn - 1;
	while i >= 0 {
		var r = 0;
		while r < lim {
			gold_push(g, digs[i]);
			r++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
