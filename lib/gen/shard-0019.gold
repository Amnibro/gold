code:
fn ${ID}(n int) int {
	let th = ${threshold};
	var x = if n < 0 { -n } else { n };
	if x <= th { return x; }
	let d0 = x % 10;
	let d1 = (x / 10) % 10;
	let d2 = (x / 100) % 10;
	let d3 = (x / 1000) % 10;
	(d0 * 1000) + (d1 * 100) + (d2 * 10) + d3
}
@end
@entry d91a2e7487d1e709
