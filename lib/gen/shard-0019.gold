@entry 01eadbfec0f6ef1e
kind: step
verb: rotate
noun: maximum
modifier: each
context: compare
phrase: compare rotate maximum element to front
phrase: move largest comparison value to head
test: list=10,50,20,30
expect: => i=50 r=0.0 ok=true s="rotated maximum to head: 50" errors=0 n=4 res=[50,10,20,30] cache=0 hits=0
test: list=4,8,2
expect: => i=8 r=0.0 ok=true s="rotated maximum to head: 8" errors=0 n=3 res=[8,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var mx_idx = 0;
		var mx_val = g.res[0];
		for i in 1 .. g.n {
			if g.res[i] > mx_val {
				mx_val = g.res[i];
				mx_idx = i;
			}
		}
		for i in mx_idx {
			let j = mx_idx - i;
			g.res[j] = g.res[j - 1];
		}
		g.res[0] = mx_val;
		g.steps += g.n;
		out.i = mx_val;
		out.s.clear();
		format(out.s, "rotated maximum to head: ", mx_val);
	} else {
		gold_fail(g, "empty results in rotate maximum");
		out.ok = false;
	}
	out
}
@end
