fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if g.res[i] > 0 {
			g.res[i] = ${f}(g.res[i]);
			count++;
		} else {
			gold_fail(g, "skipped non positive error code");
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "safely applied: ", count);
	out
}
@end
@entry 59b9cb70b364a214
kind: step
verb: find
noun: memo
modifier: with_retry
context: error
phrase: find memo error entry with {retries} retries
phrase: lookup fault memo table allowing {retries} retries
slot: retries int
test: list=404,500 retries=3
expect: => i=0 r=0.0 ok=true s="found memo with retry: 0" errors=0 n=2 res=[404,500] cache=0 hits=0
test: list=200 retries=1
expect: => i=0 r=0.0 ok=true s="found memo with retry: 0" errors=0 n=1 res=[200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${retries};
	var found = 0;
	for i in g.n {
		var attempts = 0;
		var ok = false;
		while attempts < limit && !ok {
			let val, hit = gold_cache_get(g, g.res[i]);
			if hit {
				g.res[i] = val;
				ok = true;
				found++;
			}
			attempts++;
		}
	}
	g.steps += g.n + found;
	out.i = found;
	out.s.clear();
	format(out.s, "found memo with retry: ", found);
	out
}
@end
