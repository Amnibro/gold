@entry 6542871a13ede818
kind: step
verb: clamp
noun: average
modifier: in_reverse
context: math
slot: lo int
slot: hi int
phrase: clamp running average in reverse between lower {lo} upper {hi}
phrase: restrict backward running average from {lo} to {hi}
test: list=10,20,30,40 lo=15 hi=35
expect: => i=10 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,35] cache=0 hits=0
test: list=5,15,45 lo=10 hi=25
expect: => i=5 r=0.0 ok=true s="" errors=0 n=3 res=[5,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if g.n == 0 { return out; }
	var sum = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		sum += g.res[i];
		count++;
		let avg = sum / count;
		if avg < low { g.res[i] = low; }
		else if avg > high { g.res[i] = high; }
		i--;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out
}
@end
