code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 && x <= b {
			for r in 100 {
				if r * r == x { is_sq = true; break; }
				if r * r > x { break; }
			}
		}
		if is_sq {
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "found squares nested: ", count);
	out
}
@end
