fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_cap};
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		if sum > cap {
			sum = cap;
			gold_fail(g, "accumulation limit exceeded");
			out.ok = false;
			break;
		}
		i++;
	}
	g.steps += i;
	out.i = sum;
	out.s.clear();
	format(out.s, "traced sum: ", sum);
	out
}
@end
