test: list=4,6,8,10
expect: => i=7 r=0.0 ok=true s="" errors=0 n=4 res=[-3,-1,1,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let mean = sum / g.n;
	gold_cache_put(g, 0, mean);
	for k in g.n { g.res[k] -= mean; }
	out.i = mean;
	out
}
@end
