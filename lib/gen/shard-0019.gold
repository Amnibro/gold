fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		let win = g.res[i] + g.res[i + 1];
		gold_cache_put(g, i / 2, win);
		i += 2;
	}
	out.i = g.cn;
	out
}
