fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for k in g.n {
		if g.res[k] % 2 == 0 {
			var x = g.res[k];
			for step in t { x *= 2; }
			g.res[k] = x;
		}
	}
	out.i = g.n;
	out
}
