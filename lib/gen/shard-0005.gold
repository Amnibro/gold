fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var converted = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'A' && c <= 'Z' {
			out.s[i] = (c + 32) as byte;
			converted++;
		}
	}
	g.steps += out.s.len + 1;
	out.i = converted;
	out
}
