fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[256] = [0; 256];
	var seen_freq int[256] = [0; 256];
	var unique_freqs = 0;
	for c in out.s {
		let idx = c as int;
		counts[idx]++;
		let f = counts[idx];
		if seen_freq[f] == 0 {
			seen_freq[f] = 1;
			gold_push(g, f);
			unique_freqs++;
		}
	}
	g.steps += out.s.len;
	out.i = unique_freqs;
	out.s.clear();
	format(out.s, "unique frequencies: ", unique_freqs);
	out
}
@end
