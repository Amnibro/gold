code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_p = ${passes};
	var pass = 0;
	while pass < max_p {
		var swapped = false;
		for i in 0..(out.s.len - 1) {
			if out.s[i] > out.s[i + 1] {
				let tmp = out.s[i];
			out.s[i] = out.s[i + 1];
			out.s[i + 1] = tmp;
				swapped = true;
			}
		}
		if !swapped { break; }
		pass++;
	}
	out.i = pass;
	out
}
@end
