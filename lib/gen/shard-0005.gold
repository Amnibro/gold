phrase: duplicate streak between range {low} to {high}
slot: low int
slot: high int
test: list=5 low=1 high=3
expect: => i=2 r=0.0 ok=true s="repeated streak to length 2" errors=0 n=2 res=[5,5] cache=0 hits=0
