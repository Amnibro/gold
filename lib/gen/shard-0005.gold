expect: => i=2 r=0.0 ok=true s="unique prefix items 2" errors=0 n=4 res=[1,1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { uniq++; }
	}
	out.i = uniq;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "unique prefix items ", uniq);
	out
}
@end
