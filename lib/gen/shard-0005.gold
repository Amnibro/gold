@entry 53521c7413da6e47
kind: step
verb: apply
noun: average
modifier: none
context: sort
phrase: apply average none replacing with mean {bias}
phrase: center sorted sequence with mean bias {bias}
slot: bias int
test: list=10,20,30 bias=5
expect: => i=25 r=0.0 ok=true s="applied average result 25" errors=0 n=1 res=[25] cache=0 hits=0
test: list=4,8,12 bias=2
expect: => i=10 r=0.0 ok=true s="applied average result 10" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = (total / g.n) + b;
	gold_clear(g);
	gold_push(g, avg);
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "applied average result ", avg);
	out
}
@end
