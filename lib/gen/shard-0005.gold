@entry 64e8f1b1dd3ed36e
kind: step
verb: reverse
noun: steps
modifier: running
context: retry
phrase: reverse running step sequence across retry attempts
phrase: invert running step order during retry cycle
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="reversed steps running: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20
expect: => i=2 r=0.0 ok=true s="reversed steps running: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for k in half {
		let t = g.res[k];
		g.res[k] = g.res[g.n - 1 - k];
		g.res[g.n - 1 - k] = t;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed steps running: ", g.n);
	out
}
@end
@entry 362f9b7cadbd8a5e
kind: step
verb: swap
noun: spaces
modifier: sorted
context: retry
phrase: swap sorted spaces across retry buffer
phrase: exchange sorted gap spaces during retry pass
test: list=10,20,30,40
expect: => i=3 r=0.0 ok=true s="swapped spaces sorted: 3" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,15
expect: => i=1 r=0.0 ok=true s="swapped spaces sorted: 1" errors=0 n=2 res=[15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			let gap = core_abs_val(g.res[k + 1] - g.res[k]);
			if gap % 2 == 0 {
				let t = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = t;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped spaces sorted: ", swaps);
	out
}
@end
@entry 5d5488e454aa3c91
kind: step
verb: scan
noun: number
modifier: nested
context: retry
phrase: scan nested number retries up to limit {limit}
phrase: count nested retry numbers within ceiling {limit}
slot: limit int
test: list=2,4,6,8 limit=5
expect: => i=2 r=0.0 ok=true s="scanned nested number count: 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,20 limit=5
expect: => i=0 r=0.0 ok=false s="scanned nested number count: 0" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for k in g.n {
		if g.res[k] <= lim { count++; }
	}
	if count == 0 {
		gold_fail(g, "no nested numbers below limit");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned nested number count: ", count);
	out
}
@end
@entry 48813839c64bebd5
kind: step
verb: pair
noun: limit
modifier: times
context: retry
phrase: pair items within limit {limit} repeated times {times}
phrase: group bounded pairs below limit {limit} count {times}
slot: limit int
slot: times int
test: list=1,2,3,4 limit=10 times=2
expect: => i=4 r=0.0 ok=true s="paired limit times: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2 limit=10 times=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let t = ${times};
	if t <= 0 {
		gold_fail(g, "zero times error");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			if (g.res[k] + g.res[k + 1]) <= lim { pairs++; }
			k += 2;
		}
	}
	g.steps += pairs * t;
	out.i = pairs * t;
	out.s.clear();
	format(out.s, "paired limit times: ", out.i);
	out
}
@end
