slot: cutoff int
test: list=3,12,5,18,2 cutoff=10
expect: => i=3 r=0.0 ok=true s="recursively dropped steps 3" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=8,4,15,6,22 cutoff=8
expect: => i=2 r=0.0 ok=true s="recursively dropped steps 2" errors=0 n=3 res=[8,15,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] < cut {
			dropped++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "recursively dropped steps ", dropped);
	out
}
@end
