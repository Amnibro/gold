fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	out.s.clear();
	format(out.s, "scaled: [");
	for k in g.n {
		if k > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, g.res[k] * f);
	}
	format(out.s, "]");
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
@entry d1845e6e21303049
kind: step
verb: apply
noun: runs
modifier: with_cache
context: format
phrase: format run lengths with cache slot {slot_id}
phrase: display run lengths cached in slot {slot_id}
slot: slot_id int
test: list=1,1,2,2,2,3 slot_id=12
expect: => i=3 r=0.0 ok=true s="cache[12] runs=3" errors=0 n=6 res=[1,1,2,2,2,3] cache=1 hits=0
test: list=5,5,9 slot_id=4
expect: => i=2 r=0.0 ok=true s="cache[4] runs=2" errors=0 n=3 res=[5,5,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sid = ${slot_id};
	var runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		runs++;
		i = j;
	}
	gold_cache_put(g, sid, runs);
	out.s.clear();
	format(out.s, "cache[", sid, "] runs=", runs);
	g.steps += g.n;
	out.i = runs;
	out
}
@end
