	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		g.res[k] = (a + b) / 2;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "split ", pairs, " pairs");
	out
}
