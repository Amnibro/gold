phrase: check step none smooth adjacent transition
phrase: verify all adjacent digits differ by at most one
test: arg=12321
expect: true
test: arg=1479
expect: false
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		if diff > 1 { return false; }
		prev = cur;
		x /= 10;
	}
	true
}
@end
