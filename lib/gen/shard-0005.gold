kind: step
verb: clamp
noun: streak
modifier: in_reverse
context: math
phrase: clamp trailing streak in reverse to {max_run}
phrase: restrict final run in reverse direction {max_run}
slot: max_run int
test: list=1,2,3,3,3,3 max_run=2
expect: => i=4 r=0.0 ok=true s="clamped trailing streak to 4" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=5,6,7,7,7 max_run=1
expect: => i=3 r=0.0 ok=true s="clamped trailing streak to 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_run};
	if g.n <= 1 { return out; }
	let last = g.res[g.n - 1];
	var streak = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last {
		streak++;
		i--;
	}
	if streak > cap {
		let drop = streak - cap;
		g.n -= drop;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped trailing streak to ", g.n);
	out
}
@end
