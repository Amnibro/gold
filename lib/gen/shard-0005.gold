code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${filler};
	var new_s byte[..200] = "";
	var replaced = 0;
	for b in out.s {
		if b == ' ' {
			for rb in rep {
				if new_s.len < 200 { new_s.push(rb); }
			}
			replaced++;
		} else {
			if new_s.len < 200 { new_s.push(b); }
		}
	}
	g.steps += out.s.len + 1;
	out.s = new_s;
	out.i = replaced;
	out
}
@end
