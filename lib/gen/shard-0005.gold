code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var dup_items = 0;
	var counts int[50] = [0; 50];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var c = 0;
			for k in g.n { if g.res[k] == x { c++; } }
			if c > 1 { dup_items++; }
		}
	}
	format(out.s, "duplicate items: ", dup_items);
	out.i = dup_items;
	g.steps += g.n;
	out
}
@end
