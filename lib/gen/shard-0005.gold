noun: evens
modifier: nested
context: filter
phrase: dedupe evens nested in results
phrase: filter unique even numbers nested
phrase: remove duplicate evens nested
test: list=2,4,2,6,4,8
expect: => i=2 r=0.0 ok=true s="deduped 2 duplicate evens" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,2,1,2,3
expect: => i=1 r=0.0 ok=true s="deduped 1 duplicate evens" errors=0 n=4 res=[1,2,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " duplicate evens");
	out
}
@end
