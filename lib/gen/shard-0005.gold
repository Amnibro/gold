code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for idx in 1..g.n {
		if g.res[idx] != g.res[kept - 1] {
			g.res[kept] = g.res[idx];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "collapsed runs to ", kept);
	out
}
@end
