expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_v = 0;
	var ok = true;
	for c in out.s {
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			let code = c as int;
			if code < last_v {
				ok = false;
				break;
			}
			last_v = code;
		}
	}
	g.steps += out.s.len;
	out.ok = ok;
	out.s.clear();
	if ok {
		format(out.s, "vowels sorted properly");
	} else {
		gold_fail(g, "vowels unsorted");
	}
	out
}
@end
@entry 4c9e551a9d2d3f16
kind: step
verb: rotate
noun: value
modifier: none
context: sort
phrase: rotate value elements by offset {shift}
phrase: cycle sorted values by offset {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=40 r=0.0 ok=true s="first rotated 40" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 shift=2
expect: => i=4 r=0.0 ok=true s="first rotated 4" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		for step in (s % g.n) {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "first rotated ", g.res[0]);
	out
}
@end
