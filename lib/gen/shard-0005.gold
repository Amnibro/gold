code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var matches = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff == d { matches++; }
		}
	}
	g.steps += g.n + 1;
	out.i = matches;
	out.s.clear();
	format(out.s, "unique gap matches ", matches);
	out
}
