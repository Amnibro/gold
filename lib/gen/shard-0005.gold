@entry d0e5861aa75e6266
kind: step
verb: limit
noun: range
modifier: none
context: sort
phrase: limit range none capping span to {max_span}
phrase: restrict overall sorted range span under {max_span}
slot: max_span int
test: list=10,20,50 max_span=25
expect: => i=25 r=0.0 ok=true s="bounded sorted range span 25" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=5,15,45 max_span=20
expect: => i=20 r=0.0 ok=true s="bounded sorted range span 20" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_span};
	if g.n > 0 {
		let base = g.res[0];
		for i in g.n {
			if g.res[i] - base > ms {
				g.res[i] = base + ms;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = g.res[g.n - 1] - g.res[0];
	out.s.clear();
	format(out.s, "bounded sorted range span ", out.i);
	out
}
@end
