	var out = v;
	var alt byte[256] = [0; 256];
	var n_alt = 0;
	var idx = 1;
	while idx < out.s.len {
		alt[n_alt] = out.s[idx];
		n_alt++;
		idx += 2;
	}
	var placed = 0;
	idx = 1;
	while idx < out.s.len {
		out.s[idx] = alt[n_alt - 1 - placed];
		placed++;
		idx += 2;
	}
	out.i = n_alt;
	out
}
