kind: step
verb: merge
noun: minimum
modifier: with_cache
context: core
phrase: merge minimum value with cache slot {slotid}
phrase: combine minimum item using cache key {slotid}
slot: slotid int
test: list=5,3,9 slotid=1
expect: => i=3 r=0.0 ok=true s="merged minimum with cache" errors=0 n=3 res=[5,3,9] cache=1 hits=0
test: list=10,20 slotid=2
expect: => i=10 r=0.0 ok=true s="merged minimum with cache" errors=0 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${slotid};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let prev, hit = gold_cache_get(g, key);
	if hit {
		if prev < min_val { min_val = prev; }
	}
	gold_cache_put(g, key, min_val);
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "merged minimum with cache");
	out
}
@end
