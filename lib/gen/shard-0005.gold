	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	g.res[0] = avg;
	out.i = avg;
	out.s.clear();
	format(out.s, "first element set to mean ", avg);
	out
}
