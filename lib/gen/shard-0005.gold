expect: 6
test: arg=77555
expect: 15
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var best_streak = 1;
	var best_digit = x % 10;
	var cur_streak = 1;
	var cur_digit = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d == cur_digit {
			cur_streak++;
		} else {
			if cur_streak > best_streak {
				best_streak = cur_streak;
				best_digit = cur_digit;
			}
			cur_digit = d;
			cur_streak = 1;
		}
		x /= 10;
	}
	if cur_streak > best_streak {
		best_streak = cur_streak;
		best_digit = cur_digit;
	}
	best_streak * best_digit
}
@end
