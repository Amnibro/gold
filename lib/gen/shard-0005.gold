expect: => i=3 r=0.0 ok=true s="reversed and mapped 3 items" errors=0 n=3 res=[60,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for idx in 0..(g.n / 2) {
		let opp = g.n - 1 - idx;
		let tmp = g.res[idx];
		g.res[idx] = ${fn_slot}(g.res[opp]);
		g.res[opp] = ${fn_slot}(tmp);
	}
	if g.n % 2 != 0 {
		let mid = g.n / 2;
		g.res[mid] = ${fn_slot}(g.res[mid]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed and mapped ", g.n, " items");
	out
}
@end
