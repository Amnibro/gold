code:
fn ${ID}(g Gold&, v Val) Val {
	let passes = ${times};
	var out = v;
	for p in passes {
		for i in g.n {
			var num = g.res[i];
			if num < 0 { num = -num; }
			var dsum = 0;
			while num > 0 {
				dsum += num % 10;
				num /= 10;
			}
			g.res[i] = dsum;
		}
	}
	out.i = g.n;
	g.steps += passes * g.n;
	out.s.clear();
	format(out.s, "digit sum passes complete ", passes);
	out
}
@end
