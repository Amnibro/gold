fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 { out.ok = false; return out; }
	var total = 0;
	for i in out.s.len { total += out.s[i] as int; }
	let avg = total / out.s.len;
	var has_above = false;
	for i in out.s.len {
		if (out.s[i] as int) > avg { has_above = true; break; }
	}
	g.steps += out.s.len + 1;
	out.ok = has_above;
	out.i = avg;
	out
}
