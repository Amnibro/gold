@entry 9461ab77719c1ef2
kind: step
verb: sum
noun: primes
modifier: at_least
context: list
phrase: sum primes at least value {minval}
phrase: add prime numbers reaching at least {minval}
slot: minval int
test: list=2,3,5,7,11 minval=5
expect: => i=23 r=0.0 ok=true s="sum primes at least" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=3,4,5,13 minval=7
expect: => i=13 r=0.0 ok=true s="sum primes at least" errors=0 n=4 res=[3,4,5,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${minval};
	var total = 0;
	for i in g.n {
		let num = g.res[i];
		if num >= mv && num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				total += num;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "sum primes at least");
	out
}
@end
@entry fc885b97582b0f44
kind: step
verb: apply
noun: numbers
modifier: sorted
context: list
phrase: apply numbers sorted using transform {fn}
phrase: process sorted numbers with {fn}
slot: fn fn
test: list=3,1,2 fn=double
expect: => i=3 r=0.0 ok=true s="apply numbers sorted" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=9,5,7 fn=square
expect: => i=3 r=0.0 ok=true s="apply numbers sorted" errors=0 n=3 res=[25,49,81] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in g.n {
		g.res[i] = ${fn}(g.res[i]);
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "apply numbers sorted");
	out
}
@end
