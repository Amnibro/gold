code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var freqs int[256] = [0; 256];
	for i in g.n {
		var f = 0;
		for j in g.n { if g.res[j] == g.res[i] { f++; } }
		freqs[i] = f;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if freqs[j] > freqs[i] {
				let tf = freqs[i]; freqs[i] = freqs[j]; freqs[j] = tf;
				let tr = g.res[i]; g.res[i] = g.res[j]; g.res[j] = tr;
			}
		}
	}
	if freqs[0] > 2 { gold_fail(g, "high frequency errors"); }
	g.steps += g.n * g.n;
	out.i = freqs[0];
	out.s.clear();
	format(out.s, "top freq ", freqs[0]);
	out
}
@end
