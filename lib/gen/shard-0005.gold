fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds byte[512] = [0; 512];
	var odd_vals int[512] = [0; 512];
	var n_odd = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odd_vals[n_odd] = g.res[k];
			n_odd++;
		}
	}
	var placed = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			g.res[k] = odd_vals[n_odd - 1 - placed];
			placed++;
		}
	}
	out.i = n_odd;
	out.s.clear();
	format(out.s, "reversed ", n_odd, " odd values");
	out
}
@end
