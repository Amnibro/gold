kind: step
verb: limit
noun: errors
modifier: running
context: search
phrase: limit running search errors to cap {cap}
phrase: bound running deviation errors within limit {cap}
slot: cap int
test: list=10,12,15,25 cap=10
expect: => i=7 r=0.0 ok=true s="running error capped at 7" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=10,11,12 cap=5
expect: => i=3 r=0.0 ok=true s="running error capped at 3" errors=0 n=3 res=[10,11,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_dev = ${cap};
	var running_err = 0;
	var kept = 0;
	for i in g.n {
		let dev = core_abs_val(g.res[i] - 10);
		if running_err + dev > max_dev { break; }
		running_err += dev;
		kept++;
	}
	g.n = kept;
	out.i = running_err;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "running error capped at ", running_err);
	out
}
@end
