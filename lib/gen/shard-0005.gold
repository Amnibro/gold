expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${start_ch};
	let ec = ${end_ch};
	let s_byte = if sc.len > 0 { sc[0] } else { 0 as byte };
	let e_byte = if ec.len > 0 { ec[0] } else { 0 as byte };
	var start_idx = -1;
	var end_idx = -1;
	for i in out.s.len {
		if out.s[i] == s_byte && start_idx < 0 { start_idx = i; }
		if out.s[i] == e_byte && start_idx >= 0 && i > start_idx { end_idx = i; break; }
	}
	if start_idx >= 0 && end_idx > start_idx {
		var kept byte[..200] = "";
		for i in (end_idx - start_idx - 1) {
			kept.push(out.s[start_idx + 1 + i]);
		}
		out.s.clear();
		out.s.append(kept);
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
