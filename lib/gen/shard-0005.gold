code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var reductions = 0;
	if b > 1 {
		for i in g.n {
			while g.res[i] > 0 && g.res[i] % b == 0 {
				g.res[i] = g.res[i] / b;
				reductions++;
			}
		}
	}
	out.i = reductions;
	g.steps += reductions + g.n + 1;
	out.s.clear();
	format(out.s, "recursively reduced ", reductions);
	out
}
@end
