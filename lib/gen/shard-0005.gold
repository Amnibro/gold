fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let me = ${max_err};
	if out.i > 0 {
		for k in out.i { gold_fail(g, "error"); }
	}
	let valid = g.errors <= me;
	g.steps += 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "errors valid ", valid);
	out
}
@end
