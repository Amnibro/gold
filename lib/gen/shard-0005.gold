code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	var count = 0;
	if g.n >= 2 {
		let orig_n = g.n;
		for i in 0..(orig_n - 1) {
			var diff = core_abs_val(g.res[i + 1] - g.res[i]);
			if diff > limit { diff = limit; }
			gold_push(g, diff);
			count++;
		}
	}
	out.i = count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "limited pairwise histogram ", count);
	out
}
@end
