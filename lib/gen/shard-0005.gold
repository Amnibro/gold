code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tries = 0;
	while !${pred}(out.i) && tries < 10 {
		out.i++;
		tries++;
	}
	g.steps += tries;
	out.s.clear();
	if ${pred}(out.i) {
		format(out.s, "succeeded after ", tries, " retries");
	} else {
		gold_fail(g, "condition failed after max retries");
		out.ok = false;
		format(out.s, "retry limit exhausted");
	}
	out
}
@end
