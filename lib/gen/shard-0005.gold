fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var matches = 0;
	var i = 0;
	while i + 2 < g.n {
		let diff = g.res[i + 2] - g.res[i];
		if diff >= th { matches++; }
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = matches;
	out.s.clear();
	format(out.s, "alternating space matches ", matches);
	out
}
