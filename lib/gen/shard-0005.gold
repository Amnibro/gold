code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n > 0 {
		let last = g.res[g.n - 1];
		format(out.s, "shifted by ", last, ": [");
		for k in g.n {
			if k > 0 { out.s.push(','); out.s.push(' '); }
			format(out.s, g.res[k] + last);
		}
		format(out.s, "]");
		out.i = last;
	} else {
		format(out.s, "empty");
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
