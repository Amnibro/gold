@entry 9bd4caeb4ca18e9d
kind: step
verb: keep
noun: budget
modifier: unique
context: stats
phrase: keep unique observations within cumulative sum budget {budget}
phrase: deduplicate sample values under total budget {budget}
slot: budget int
test: list=10,20,10,30,40 budget=50
expect: => i=2 r=0.0 ok=true s="kept 2 unique values within budget" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,5,10 budget=20
expect: => i=2 r=0.0 ok=true s="kept 2 unique values within budget" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	var kept = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			if total + x <= max_b {
				g.res[kept] = x;
				total += x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " unique values within budget");
	out
}
@end
