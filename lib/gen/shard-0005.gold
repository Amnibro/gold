fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let lim = ${limit};
	let scan_len = if lim < g.n { lim } else { g.n };
	let start_pos = g.n - scan_len;
	var matches = 0;
	for k in scan_len {
		if g.res[start_pos + k] == tgt {
			matches++;
