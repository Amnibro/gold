expect: => i=1 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp byte[..200] = "";
	var spaces_removed = 0;
	var in_space = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			if !in_space {
				temp.push(c);
				in_space = true;
			} else {
				spaces_removed++;
			}
		} else {
			in_space = false;
			temp.push(c);
		}
	}
	out.s.clear();
	out.s.append(temp);
	g.steps += spaces_removed + 1;
	out.i = spaces_removed;
	out
}
@end
