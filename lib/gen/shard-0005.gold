fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results list");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var run_len = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		run_len++;
		i--;
	}
	for r in run_len { gold_push(g, last_val); }
	if run_len > 2 { gold_fail(g, "long run repeated"); }
	g.steps += run_len;
	out.i = run_len;
	out.s.clear();
	format(out.s, "repeated run ", run_len);
	out
}
@end
