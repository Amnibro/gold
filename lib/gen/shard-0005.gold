expect: true
expect: false
test: arg=13579
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	var sorted = true;
	while x > 0 {
		let d = x % 10;
		if d > prev {
			sorted = false;
			break;
		}
		prev = d;
		x /= 10;
	}
	sorted
}
@end
