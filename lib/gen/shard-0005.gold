fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = if g.n < 4 { g.n } else { 4 };
	if g.n < 4 {
		gold_fail(g, "underflow space");
	}
	for i in lim {
		for j in (i + 1)..lim {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += lim * lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "sorted prefix ", lim);
	out
}
@end
