@entry 0815eda1d85a86ed
kind: step
verb: dedupe
noun: results
modifier: last
context: format
phrase: format deduplicated results keeping last occurrence
phrase: display results deduped from trailing end
test: list=1,2,1,3,2
expect: => i=3 r=0.0 ok=true s="dedup_last: [1, 3, 2]" errors=0 n=5 res=[1,2,1,3,2] cache=0 hits=0
test: list=4,4,5
expect: => i=2 r=0.0 ok=true s="dedup_last: [4, 5]" errors=0 n=3 res=[4,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = g.n;
	while i > 0 {
		i--;
		let x = g.res[i];
		var seen = false;
		for j in kn {
			if kept[j] == x { seen = true; break; }
		}
		if !seen {
			kept[kn] = x;
			kn++;
		}
	}
	out.s.clear();
	format(out.s, "dedup_last: [");
	var p = kn;
	var printed = 0;
	while p > 0 {
		p--;
		if printed > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, kept[p]);
		printed++;
	}
	format(out.s, "]");
	g.steps += g.n * g.n;
	out.i = kn;
	out
}
@end
