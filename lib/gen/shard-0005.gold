code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_hist};
	let count = if cap < out.s.len { cap } else { out.s.len };
	for i in count {
		gold_push(g, out.s[i] as int);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced history: ", count);
	out
}
@end
