test: list=10,20,30 threshold=25
expect: => i=30 r=0.0 ok=true s="dropped total 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var dropped_sum = 0;
	var dropped_count = 0;
	while g.n > 0 && dropped_sum < thresh {
		dropped_sum += g.res[g.n - 1];
		g.n--;
		dropped_count++;
	}
	g.steps += dropped_count + 1;
	out.i = dropped_sum;
	out.s.clear();
	format(out.s, "dropped total ", dropped_sum);
	out
}
@end
