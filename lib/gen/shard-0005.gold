code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	let min_t = ${min_total};
	var s = 0;
	for i in g.n {
		s += g.res[i];
	}
	let scaled = s * m;
	let valid = scaled >= min_t;
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled total ", scaled);
	out
}
