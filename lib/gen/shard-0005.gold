fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_double_space = false;
	if out.s.len > 1 {
		for i in (out.s.len - 1) {
			if out.s[i] == ' ' && out.s[i + 1] == ' ' {
				has_double_space = true;
				break;
			}
		}
	}
	g.steps += out.s.len + 1;
	out.ok = !has_double_space;
	if has_double_space { gold_fail(g, "consecutive gaps found"); }
	out.i = out.s.len;
	out
}
@end
