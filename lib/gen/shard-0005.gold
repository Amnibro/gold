expect: => i=30 r=0.0 ok=true s="prefix running sum 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || g.n < w {
		g.steps++;
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in w { sum += g.res[k]; }
	gold_clear(g);
	gold_push(g, sum);
	g.steps += w + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "prefix running sum ", sum);
	out
}
@end
