phrase: reverse up to {width} trailing error digits
slot: width int
test: arg=12345,987 width=3
expect: 12543
expect: 789
test: arg=50 width=2
expect: 5
code:
fn ${ID}(n int) int {
	let w = ${width};
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	var k = 0;
	var pow = 1;
	while k < w && x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
		pow *= 10;
		k++;
	}
	x * pow + rev
}
@end
