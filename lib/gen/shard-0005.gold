fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_g};
	let hi = ${max_g};
	var matched = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			let gap = core_abs_val(g.res[k + 1] - g.res[k]);
			if gap >= lo && gap <= hi {
				matched++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = matched;
	out.s.clear();
	format(out.s, "measured gaps: ", matched);
	out
}
