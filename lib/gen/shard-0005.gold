fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var sum = 0;
	if g.n >= 2 {
		sum = (g.res[0] + g.res[1]) * sc;
		g.res[0] = sum;
		for i in 1..g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped head scaled ", sum);
	out
}
@end
