@entry e793d254308a2864
kind: step
verb: scale
noun: squares
modifier: in_place
context: compare
phrase: scale squares in place by {factor}
phrase: multiply square numbers in place with {factor}
slot: factor int
test: list=4,5,9,16 factor=2
expect: => i=3 r=0.0 ok=true s="scaled squares count 3" errors=0 n=4 res=[8,5,18,32] cache=0 hits=0
test: list=2,3,5 factor=10
expect: => i=0 r=0.0 ok=true s="scaled squares count 0" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r < n { r++; }
	r * r == n
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for idx in g.n {
		if ${ID}_is_sq(g.res[idx]) {
			g.res[idx] = g.res[idx] * f;
			scaled++;
		}
	}
	out.i = scaled;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "scaled squares count ", scaled);
	out
}
@end
