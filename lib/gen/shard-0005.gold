test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="no prime found" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			found = true;
			out.i = g.res[k];
			break;
		}
	}
	out.ok = found;
	g.steps += g.n;
	out.s.clear();
	format(out.s, if found { "prime found" } else { "no prime found" });
	out
}
@end
