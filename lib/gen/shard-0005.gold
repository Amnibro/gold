code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	let cap = ${max_err};
	for i in g.n {
		if g.res[i] > cap { g.res[i] = cap; }
	}
	out.i = g.n;
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "capped sorted errors to ", cap);
	out
}
@end
