fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var primes int[512] = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var is_p = true;
			if x < 2 { is_p = false; }
			else {
				var d = 2;
				while d * d <= x {
					if x % d == 0 { is_p = false; break; }
					d++;
				}
			}
			if is_p {
				primes[pn] = x;
				pn++;
			}
		}
	}
	gold_clear(g);
	for i in pn { gold_push(g, primes[i]); }
	g.steps += g.n;
	out.i = pn;
	out.s.clear();
	format(out.s, "primes bounded count: ", pn);
	out
}
@end
