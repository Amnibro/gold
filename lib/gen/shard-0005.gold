fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n <= 1 { return out; }
	var new_res int[512] = [0; 512];
	let pairs = g.n - 1;
	for k in pairs {
		new_res[k] = g.res[k] * g.res[k + 1] * f;
	}
	for k in pairs { g.res[k] = new_res[k]; }
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " scaled values");
	out
}
