phrase: scan search sequence in reverse by {step}
slot: step int
test: list=10,20,30 step=2
expect: => i=28 r=0.0 ok=true s="reversed sequence first 28" errors=0 n=3 res=[28,18,8] cache=0 hits=0
test: list=5,15,25 step=3
expect: => i=22 r=0.0 ok=true s="reversed sequence first 22" errors=0 n=3 res=[22,12,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j] - s;
		g.res[j] = tmp - s;
		i++;
		j--;
	}
	if i == j { g.res[i] -= s; }
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "reversed sequence first ", g.res[0]);
	out
}
@end
@entry fd0b27a8c8aaede2
kind: step
verb: cache
noun: list
modifier: between
context: search
phrase: cache list between bounds {low} to {high}
phrase: record search results list between {low} through {high}
slot: low int
slot: high int
test: list=10,25,40,55 low=20 high=50
expect: => i=2 r=0.0 ok=true s="cached range count 2" errors=0 n=4 res=[10,25,40,55] cache=2 hits=0
test: list=5,15,35,60 low=10 high=40
expect: => i=2 r=0.0 ok=true s="cached range count 2" errors=0 n=4 res=[5,15,35,60] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var stored = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			gold_cache_put(g, stored, x);
			stored++;
		}
	}
	g.steps += stored + 1;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached range count ", stored);
	out
}
@end
