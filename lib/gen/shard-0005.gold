code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var inside = 0;
	var outside = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			inside++;
		} else {
			outside++;
		}
	}
	gold_clear(g);
	gold_push(g, inside);
	gold_push(g, outside);
	g.steps += g.n;
	out.i = inside;
	out.s.clear();
	format(out.s, "inside: ", inside, ", outside: ", outside);
	out
}
@end
