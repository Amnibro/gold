	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var count = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == val { count++; }
			j++;
		}
		if count > 1 {
			d.push(val);
		}
		i++;
	}
	var kept = 0;
	var k = d.len - 1;
	while k >= 0 {
		g.res[kept] = d[k];
		kept++;
		k--;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "reversed duplicate elements ", kept);
	out
}
@end
