fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n_parts = ${parts};
	let seg_len = if n_parts > 0 { out.s.len / n_parts } else { 0 };
	out.i = seg_len;
	gold_push(g, seg_len);
	g.steps += out.s.len + 1;
	out.s.clear();
	format(out.s, "segment length ", seg_len);
	out
}
@end
