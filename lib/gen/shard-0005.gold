expect: => i=4 r=0.0 ok=true s="swapped evens: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var swaps = 0;
	for round in t {
		var k = 0;
		while k + 1 < g.n {
			if g.res[k] % 2 == 0 && g.res[k + 1] % 2 == 0 {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				swaps++;
				k += 2;
			} else {
				k++;
			}
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped evens: ", swaps);
	out
}
