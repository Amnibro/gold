test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="checked memo in reverse hits 0" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for memo check");
		out.ok = false;
		return out;
	}
	var hits_count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let item = g.res[i];
		let val, found = gold_cache_get(g, item);
		if found {
			hits_count++;
		} else {
			gold_cache_put(g, item, i);
		}
		if i == 0 { break; }
		i--;
	}
	g.steps += g.n;
	out.i = hits_count;
	out.s.clear();
	format(out.s, "checked memo in reverse hits ", hits_count);
	out
}
@end
