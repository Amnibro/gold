code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var runs = 0;
	if g.n > 0 {
		runs = 1;
		var i = g.n - 2;
		while i >= 0 {
			if g.res[i] != g.res[i + 1] {
				runs += 1;
			}
			i -= 1;
		}
	}
	format(out.s, "reverse runs count: ", runs);
	g.steps += 1;
	out.i = runs;
	out
}
@end
