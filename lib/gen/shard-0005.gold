@entry 726a29a1bba8e0fc
kind: step
verb: cache
noun: tail
modifier: any
context: search
phrase: cache tail any items count {count}
phrase: store search tail any items count {count}
slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="cached tail items 2" errors=0 n=5 res=[1,2,3,4,5] cache=2 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="cached tail items 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var stored = 0;
	if c > 0 && g.n >= c {
		let start = g.n - c;
		var i = start;
		while i < g.n {
			gold_cache_put(g, stored, g.res[i]);
			stored++;
			i++;
		}
	}
	g.steps += stored + 1;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached tail items ", stored);
	out
}
@end
