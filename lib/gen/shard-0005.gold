fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (g.n - 1) {
			if g.res[j] < g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " numbers in reverse");
	out
}
@end
