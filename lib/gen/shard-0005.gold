@entry feae4962438e8fd3
kind: step
verb: group
noun: loop
modifier: nested
context: stats
phrase: group loop nested with tier {tier}
phrase: aggregate nested loop categories by tier {tier}
slot: tier int
test: list=1,2,3,4,5,6 tier=3
expect: => i=6 r=0.0 ok=true s="grouped tier count 2" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 tier=2
expect: => i=30 r=0.0 ok=true s="grouped tier count 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${tier};
	if t <= 0 || g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = i;
		while j < g.n && j < i + t {
			sum += g.res[j];
			j++;
		}
		g.res[new_n] = sum;
		new_n++;
		i += t;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "grouped tier count ", new_n);
	out
}
@end
