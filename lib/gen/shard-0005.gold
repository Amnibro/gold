fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	if out.s.len > 1 {
		for i in (out.s.len - 1) {
			if out.s[i] == out.s[i + 1] { pairs++; }
		}
	}
	g.steps += out.s.len + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairs: ", pairs);
	out
}
