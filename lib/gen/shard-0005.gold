expect: => i=3 r=0.0 ok=true s="kept 3 items within total budget" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	var run_sum = 0;
	var kept = 0;
	for k in g.n {
		if run_sum + g.res[k] <= max_b {
			run_sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items within total budget");
	out
}
@end
