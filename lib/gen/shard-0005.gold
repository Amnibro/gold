@entry 16aefdb2364826ed
kind: step
verb: merge
noun: numbers
modifier: up_to
context: list
phrase: merge consecutive numbers up to total {cap}
phrase: condense adjacent elements up to sum limit {cap}
slot: cap int
test: list=2,3,4,8,3,5 cap=10
expect: => i=3 r=0.0 ok=true s="merged into 3 blocks" errors=0 n=3 res=[9,8,8] cache=0 hits=0
test: list=1,1,1,1,1 cap=3
expect: => i=2 r=0.0 ok=true s="merged into 2 blocks" errors=0 n=2 res=[3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write_idx = 0;
	var read_idx = 0;
	while read_idx < g.n {
		var block_sum = g.res[read_idx];
		var next_idx = read_idx + 1;
		while next_idx < g.n && block_sum + g.res[next_idx] <= limit {
			block_sum += g.res[next_idx];
			next_idx++;
		}
		g.res[write_idx] = block_sum;
		write_idx++;
		read_idx = next_idx;
	}
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged into ", write_idx, " blocks");
	out
}
@end
