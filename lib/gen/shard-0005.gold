modifier: with_cache
context: compare
phrase: retry odds with cache limit {max_tries}
phrase: adjust to odd values with memo {max_tries}
slot: max_tries int
test: list=2,4,6 max_tries=3
expect: => i=3 r=0.0 ok=true s="retried odds adjustments 3" errors=0 n=3 res=[3,5,7] cache=3 hits=0
test: list=1,3,5 max_tries=2
expect: => i=0 r=0.0 ok=true s="retried odds adjustments 0" errors=0 n=3 res=[1,3,5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tries};
	var adjusted = 0;
	for idx in g.n {
		var x = g.res[idx];
		let cv, hit = gold_cache_get(g, x);
		if hit {
			g.res[idx] = cv;
		} else {
			var t = 0;
			while x % 2 == 0 && t < mt {
				x++;
				t++;
				adjusted++;
			}
			gold_cache_put(g, g.res[idx], x);
			g.res[idx] = x;
		}
	}
	out.i = adjusted;
	g.steps += adjusted + g.n + 1;
	out.s.clear();
	format(out.s, "retried odds adjustments ", adjusted);
	out
}
@end
