code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if rep <= 1 || out.s.len == 0 {
		out.i = out.s.len;
		return out;
	}
	let orig_len = out.s.len;
	var extra = 1;
	while extra < rep && out.s.len + orig_len <= 190 {
		for k in orig_len {
			out.s.push(out.s[k]);
		}
		extra++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
