fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "reversed unique: [");
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in i + 1..g.n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			if count > 0 { format(out.s, ", "); }
			format(out.s, x);
			count++;
		}
		i--;
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
