fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var attempts = 0;
	var valid = 0;
	for j in g.n {
		var cur = g.res[j];
		var tries = 0;
		while !${check_fn}(cur) && tries < 4 {
			cur += 1;
			tries++;
			attempts++;
		}
		g.res[j] = cur;
		if ${check_fn}(cur) { valid++; }
	}
	out.i = valid;
	g.steps += attempts + g.n + 1;
	out.s.clear();
	format(out.s, "retried words valid ", valid);
	out
}
@end
