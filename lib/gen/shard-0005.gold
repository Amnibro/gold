code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d < g.n && d >= 0 {
		let start = g.n - d;
		for i in d {
			g.res[i] = g.res[start + i];
		}
		g.n = d;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited history depth ", g.n);
	out
}
@end
