code:
fn ${ID}(g Gold&, v Val) Val {
	let limit = ${max_diff};
	var out = v;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > limit {
			g.res[k] = g.res[k - 1] + limit;
		} else if diff < -limit {
			g.res[k] = g.res[k - 1] - limit;
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "clamped series pairwise");
	out
}
@end
