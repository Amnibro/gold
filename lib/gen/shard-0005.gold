@entry 2c8364d71b247725
kind: step
verb: validate
noun: average
modifier: up_to
context: text
phrase: validate average character code up to {cap}
phrase: verify mean letter code up to limit {cap}
slot: cap int
test: text="abc" cap=100
expect: => i=98 r=0.0 ok=true s="average valid: 98" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" cap=110
expect: => i=121 r=0.0 ok=false s="average invalid: 121" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if out.s.len == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var sum = 0;
	for c in out.s { sum += c as int; }
	let avg = sum / out.s.len;
	let ok_val = avg <= limit;
	out.ok = ok_val;
	out.i = avg;
	g.steps += out.s.len;
	out.s.clear();
	if ok_val {
		format(out.s, "average valid: ", avg);
	} else {
		gold_fail(g, "average code exceeds limit");
		format(out.s, "average invalid: ", avg);
	}
	out
}
@end
