@entry dcbb2880b7cce3c1
kind: step
verb: rotate
noun: head
modifier: any
context: text
phrase: rotate any head prefix by {shift}
phrase: shift initial text slice by {shift}
slot: shift int
test: text="abcdef" shift=1
expect: => i=4 r=0.0 ok=true s="dabcef" errors=0 n=0 res=[] cache=0 hits=0
test: text="12345" shift=2
expect: => i=4 r=0.0 ok=true s="34125" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = if out.s.len < 4 { out.s.len } else { 4 };
	if count > 1 {
		var s = ${shift} % count;
		if s < 0 { s += count; }
		var tmp byte[4] = [0; 4];
		for i in count { tmp[i] = out.s[i]; }
		for i in count {
			let src = (i - s + count) % count;
			out.s[i] = tmp[src];
		}
	}
	g.steps += count;
	out.i = count;
	out
}
@end
