@entry 0116fc81486b7b7f
kind: fn
verb: rotate
noun: loop
modifier: until
context: error
phrase: rotate error loop until zero bounded by {max_rot}
phrase: rotate error digits until zero within {max_rot} steps
slot: max_rot int
test: arg=305,123 max_rot=4
expect: 530
expect: 312
test: arg=70 max_rot=2
expect: 70
code:
fn ${ID}(n int) int {
	let limit = ${max_rot};
	var x = if n < 0 { -n } else { n };
	var steps = 0;
	while x > 0 && (x % 10) != 0 && steps < limit {
		let last = x % 10;
		var rest = x / 10;
		var pow = 1;
		while rest >= pow {
			pow *= 10;
		}
		x = last * pow + rest;
		steps++;
	}
	x
}
@end
@entry 1f39137ce8747148
kind: fn
verb: dedupe
noun: function
modifier: recursively
context: error
phrase: dedupe error function recursively
phrase: recursive deduplication of error code digits
test: arg=112211,555
expect: 121
expect: 5
test: arg=123
expect: 123
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var changed = true;
	var guard_iter = 0;
	while changed && guard_iter < 20 {
		changed = false;
		guard_iter++;
		var rev = 0;
		var cur = x;
		while cur > 0 {
			rev = rev * 10 + (cur % 10);
			cur /= 10;
		}
		var out = 0;
		var prev = -1;
		while rev > 0 {
			let d = rev % 10;
			if d != prev {
				out = out * 10 + d;
				prev = d;
