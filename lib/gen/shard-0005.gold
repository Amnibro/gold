noun: prefix
modifier: with_cache
context: compare
phrase: merge prefix with cache length {prefix_len}
phrase: sum prefix elements with memo {prefix_len}
slot: prefix_len int
test: list=2,4,6,8 prefix_len=3
expect: => i=12 r=0.0 ok=true s="merged prefix sum 12" errors=0 n=4 res=[2,4,6,8] cache=1 hits=0
test: list=10,20 prefix_len=1
expect: => i=10 r=0.0 ok=true s="merged prefix sum 10" errors=0 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	let bound = if pl < g.n { pl } else { g.n };
	let cached, hit = gold_cache_get(g, bound);
	if hit {
		out.i = cached;
		out.s.clear();
		out.s.append("prefix sum cache hit");
	} else {
		var sum = 0;
		for idx in bound {
			sum += g.res[idx];
		}
		gold_cache_put(g, bound, sum);
		out.i = sum;
		out.s.clear();
		format(out.s, "merged prefix sum ", sum);
	}
	g.steps += bound + 1;
	out
}
@end
