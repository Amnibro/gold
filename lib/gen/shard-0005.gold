expect: => i=3 r=0.0 ok=true s="merged items to 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var merged = 0;
	var cur = 0;
	for idx in g.n {
		let x = g.res[idx];
		if cur + x <= b {
			cur += x;
		} else {
			if cur > 0 {
				g.res[merged] = cur;
				merged++;
			}
			cur = x;
		}
	}
	if cur > 0 {
		g.res[merged] = cur;
		merged++;
	}
	g.n = merged;
	out.i = merged;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "merged items to ", merged);
	out
}
@end
