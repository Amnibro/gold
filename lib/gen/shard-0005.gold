expect: 234
test: arg=15
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	var out = 0;
	var last_vowel = false;
	while rev > 0 {
		let d = rev % 10;
		let is_v = (d == 1 || d == 5 || d == 9);
		if !(is_v && last_vowel) {
			out = out * 10 + d;
		}
		last_vowel = is_v;
		rev /= 10;
	}
	out
}
@end
