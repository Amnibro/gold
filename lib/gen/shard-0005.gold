code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_depth};
	var passes = 0;
	if g.n > 1 {
		while passes < md {
			let last = g.n - 1;
			if g.res[last] > g.res[last - 1] {
				g.res[last] = g.res[last] - g.res[last - 1];
				passes++;
			} else {
				break;
			}
		}
	}
	out.i = passes;
	g.steps += passes + 1;
	out.s.clear();
	format(out.s, "tail recursive reduction rounds ", passes);
	out
}
@end
