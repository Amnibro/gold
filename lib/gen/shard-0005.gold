code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n <= 2 * m {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let kept = g.n - 2 * m;
	for i in kept {
		g.res[i] = g.res[i + m];
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "trimmed middle to ", kept);
	out
}
@end
@entry 450867fe2e1eeae2
kind: step
verb: rotate
noun: steps
modifier: sorted
context: math
phrase: rotate steps after sorting values
phrase: sort elements cyclically rotate steps by one
test: list=3,1,4,2
expect: => i=4 r=0.0 ok=true s="sorted and rotated 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=9,5,7
expect: => i=3 r=0.0 ok=true s="sorted and rotated 3" errors=0 n=3 res=[9,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	// sort ascending
	for i in g.n {
		for j in 0..(g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	// rotate right by 1
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted and rotated ", g.n);
	out
}
@end
