@entry 2d3ee8bb7fa8ec1f
kind: step
verb: pair
noun: streak
modifier: at_least
context: list
phrase: pair elements in streaks of at least {min_len}
phrase: combine runs of at least {min_len} equal items
slot: min_len int
test: list=2,2,2,5,5,5,5,9 min_len=3
expect: => i=3 r=0.0 ok=true s="paired streaks into 3 items" errors=0 n=3 res=[4,10,9] cache=0 hits=0
test: list=1,1,2,2,3,3 min_len=4
expect: => i=6 r=0.0 ok=true s="paired streaks into 6 items" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_len};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= lim {
			let pair_val = g.res[i] * 2;
			g.res[kept] = pair_val;
			kept++;
		} else {
			for idx in i..j {
				g.res[kept] = g.res[idx];
				kept++;
			}
		}
		i = j;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "paired streaks into ", kept, " items");
	out
}
@end
