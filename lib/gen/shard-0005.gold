@entry 2880eacb52dd7672
kind: step
verb: reverse
noun: spaces
modifier: pairwise
context: math
phrase: reverse spaces between adjacent pairs
phrase: invert pairwise differences in results
test: list=1,3,7,12
expect: => i=4 r=0.0 ok=true s="reversed spaces pairwise" errors=0 n=4 res=[1,6,10,12] cache=0 hits=0
test: list=10,12,18
expect: => i=3 r=0.0 ok=true s="reversed spaces pairwise" errors=0 n=3 res=[10,16,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var diffs int[512] = [0; 512];
		for i in (g.n - 1) {
			diffs[i] = g.res[i + 1] - g.res[i];
		}
		for i in ((g.n - 1) / 2) {
			let j = g.n - 2 - i;
			let tmp = diffs[i];
			diffs[i] = diffs[j];
			diffs[j] = tmp;
		}
		for i in (g.n - 1) {
			g.res[i + 1] = g.res[i] + diffs[i];
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed spaces pairwise");
	out
}
@end
