fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in w {
			if g.res[j] == x { count++; }
		}
		if count < c {
			g.res[w] = x;
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped duplicates ", dropped);
	out
}
@end
