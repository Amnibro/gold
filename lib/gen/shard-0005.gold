phrase: prune nested sorted values below baseline {baseline}
slot: baseline int
test: list=2,8,14,20 baseline=10
expect: => i=2 r=0.0 ok=true s="nested values dropped 2" errors=0 n=2 res=[14,20] cache=0 hits=0
test: list=5,12,18,25 baseline=15
expect: => i=2 r=0.0 ok=true s="nested values dropped 2" errors=0 n=2 res=[18,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] < base {
			dropped++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "nested values dropped ", dropped);
	out
}
@end
