fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_neg = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 { last_neg = i; }
		i++;
	}
	if last_neg >= 0 {
		var kept = 0;
		var j = last_neg;
		while j < g.n {
			g.res[kept] = g.res[j];
			kept++;
			j++;
		}
		g.n = kept;
	}
	out.i = g.n;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "suffix from negative ", g.n);
	out
}
@end
