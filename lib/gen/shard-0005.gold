fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	// bubble sort only elements <= limit
	for i in g.n {
		for j in 0..(g.n - 1) {
			if g.res[j] <= limit && g.res[j + 1] <= limit {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted under limit ", limit);
	out
}
@end
