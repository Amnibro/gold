	out.s.clear();
	let cap = ${limit};
	var sum = 0;
	var i = g.n - 1;
	while i >= 0 {
		sum += g.res[i];
		if sum >= cap { break; }
		i--;
	}
	format(out.s, "suffix sum: ", sum);
	out.i = sum;
	g.steps += g.n;
	out
}
