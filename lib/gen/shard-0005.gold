noun: evens
modifier: with_retry
context: stats
phrase: check even observations with retry attempts {retries}
phrase: verify even values in sample allowing {retries} retries
slot: retries int
test: list=1,3,4,5 retries=2
expect: => i=0 r=0.0 ok=false s="even check: 0" errors=1 n=4 res=[1,3,4,5] cache=0 hits=0
test: list=1,3,5,7 retries=2
expect: => i=0 r=0.0 ok=false s="even check: 0" errors=1 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var found = false;
	var tries = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			found = true;
			break;
		}
		tries++;
		if tries >= max_r { break; }
	}
	if !found {
		gold_fail(g, "no even observation within retries");
		out.ok = false;
	}
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "even check: ", out.i);
	out
}
@end
@entry bd175f8648adb0cc
kind: step
verb: scan
noun: gaps
modifier: unique
context: stats
phrase: scan unique gap sizes between consecutive observations
phrase: accumulate distinct differences across consecutive sample items
test: list=10,12,14,16,19
expect: => i=2 r=0.0 ok=true s="found 2 unique gap sizes" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,5,10,15
expect: => i=2 r=0.0 ok=true s="found 2 unique gap sizes" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var diffs int[512] = [0; 512];
	let count = g.n - 1;
	for k in count {
		let d = g.res[k + 1] - g.res[k];
		diffs[k] = if d < 0 { -d } else { d };
	}
	var kept = 0;
	for i in count {
		var seen = false;
		for j in kept {
			if g.res[j] == diffs[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = diffs[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " unique gap sizes");
	out
}
@end
