expect: => i=2 r=0.0 ok=true s="ranked sorted primes" errors=0 n=4 res=[10,11,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { p_count++; }
	}
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "ranked sorted primes");
	out
}
@end
