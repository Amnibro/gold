@entry a3f1fccb30a06560
kind: step
verb: repeat
noun: duplicates
modifier: unique
context: stats
phrase: repeat unique duplicated elements {times} times
phrase: append distinct duplicate items {times} times
slot: times int
test: list=1,2,2,3,4,4,4 times=1
expect: => i=2 r=0.0 ok=true s="" errors=0 n=9 res=[1,2,2,3,4,4,4,2,4] cache=0 hits=0
test: list=5,5,6,7,7 times=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=9 res=[5,5,6,7,7,5,7,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${times};
	var dupes int[100] = [0; 100];
	var dn = 0;
	for i in g.n {
		var c = 0;
		for j in g.n { if g.res[j] == g.res[i] { c++; } }
		if c > 1 {
			var seen = false;
			for k in dn { if dupes[k] == g.res[i] { seen = true; break; } }
			if !seen && dn < 100 { dupes[dn] = g.res[i]; dn++; }
		}
	}
	for step in r {
		for k in dn { gold_push(g, dupes[k]); }
	}
	g.steps += g.n;
	out.i = dn;
	out
}
@end
