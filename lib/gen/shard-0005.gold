kind: step
verb: drop
noun: vowels
modifier: running
context: stats
phrase: drop vowels from running text summary
phrase: filter vowels across running categorical string
test: text="sample statistic"
expect: => i=5 r=0.0 ok=true s="smpl sttstc" errors=0 n=0 res=[] cache=0 hits=0
test: text="data distribution"
expect: => i=7 r=0.0 ok=true s="dt dstrbtn" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var buf byte[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		if b == 97 || b == 101 || b == 105 || b == 111 || b == 117 {
			dropped++;
		} else {
			buf.push(b);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = dropped;
	g.steps += out.s.len + 1;
	out
}
@end
