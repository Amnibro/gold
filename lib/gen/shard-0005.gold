			cur++;
			if cur > max_streak { max_streak = cur; }
		} else {
			cur = 0;
		}
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "found streak ", max_streak);
	out
}
