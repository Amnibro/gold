fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var matching = 0;
	if f > 0 {
		for i in g.n {
			var c = 0;
			for j in g.n { if g.res[j] == g.res[i] { c++; } }
			if c % f == 0 { matching++; }
