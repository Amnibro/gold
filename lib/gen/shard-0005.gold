fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	for i in g.n {
		if sum + g.res[i] > limit { break; }
		sum += g.res[i];
	}
	out.i = sum;
	gold_push(g, sum);
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "series sum at most ", sum);
	out
}
@end
