expect: => i=1 r=0.0 ok=true s="recursively dropped 1 items" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 {
		out.i = 0;
		return out;
	}
	let drop_count = if d < g.n { d } else { g.n };
	let remain = g.n - drop_count;
	for k in remain {
		g.res[k] = g.res[k + drop_count];
	}
	g.n = remain;
	g.steps += drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "recursively dropped ", drop_count, " items");
	out
}
@end
@entry b111f3d75aa1ed17
kind: step
verb: shift
noun: history
modifier: last
context: transform
phrase: shift last {count} history items
phrase: rotate last {count} elements in history
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="shifted last 3 history elements" errors=0 n=5 res=[1,2,5,3,4] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="shifted last 2 history elements" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 1 || g.n < c {
		out.i = 0;
		return out;
	}
	let start = g.n - c;
	let last_val = g.res[g.n - 1];
	var k = g.n - 1;
	while k > start {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[start] = last_val;
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "shifted last ", c, " history elements");
	out
}
@end
