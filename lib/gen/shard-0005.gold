fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var new_res int[512] = [0; 512];
	let count = g.n - 1;
	for k in count {
		let diff = g.res[k + 1] - g.res[k];
		new_res[k] = if diff < 0 { -diff } else { diff };
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count;
	out.i = count;
