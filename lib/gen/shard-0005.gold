fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		if !${cond}(g.res[idx]) || !${cond}(g.res[idx + 1]) { break; }
		g.res[write_pos] = g.res[idx] + g.res[idx + 1];
		write_pos++;
		idx += 2;
	}
	while idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
		idx++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged pairs resulting in ", write_pos, " items");
	out
}
@end
