expect: => i=150 r=0.0 ok=true s="scaled suffix sum 150" errors=0 n=5 res=[5,15,25,35,150] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let factor = ${scale};
	var sum = 0;
	if g.n > 0 {
		var start = if g.n > count { g.n - count } else { 0 };
		while start < g.n {
			sum += g.res[start];
			start++;
		}
	}
	let res = sum * factor;
	out.i = res;
	gold_push(g, res);
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "scaled suffix sum ", res);
	out
}
@end
