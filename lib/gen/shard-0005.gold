@entry 5616ea4fe8977dce
kind: step
verb: dedupe
noun: tally
modifier: at_least
context: text
phrase: dedupe characters with tally at least {min_rep}
phrase: remove duplicate letters appearing at least {min_rep} times
slot: min_rep int
test: text="mississippi" min_rep=3
expect: => i=6 r=0.0 ok=true s="mispp" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana" min_rep=2
expect: => i=3 r=0.0 ok=true s="ban" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_rep};
	var counts int[256] = [0; 256];
	for c in out.s { counts[c as int]++; }
	var res byte[..200] = "";
	var seen int[256] = [0; 256];
	for c in out.s {
		let idx = c as int;
		if counts[idx] >= thresh {
			if seen[idx] == 0 {
				if res.len < 200 { res.push(c); }
				seen[idx] = 1;
			}
		} else {
			if res.len < 200 { res.push(c); }
		}
	}
	let dropped = out.s.len - res.len;
	out.s = res;
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
