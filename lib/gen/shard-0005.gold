kind: step
verb: swap
noun: range
modifier: while
context: list
phrase: swap adjacent elements while condition {cond} holds
phrase: exchange neighbouring items while {cond} is met
slot: cond pred
test: list=4,2,6,8,5,10 cond=is_even
expect: => i=2 r=0.0 ok=true s="swapped 2 pairs" errors=0 n=6 res=[2,4,8,6,5,10] cache=0 hits=0
test: list=1,3,5,7,2 cond=is_odd
expect: => i=2 r=0.0 ok=true s="swapped 2 pairs" errors=0 n=5 res=[3,1,7,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var idx = 0;
	while idx + 1 < g.n {
		if !${cond}(g.res[idx]) || !${cond}(g.res[idx + 1]) { break; }
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		swaps++;
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " pairs");
	out
}
@end
