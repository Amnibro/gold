@entry dc3ebd7b3acd203f
kind: step
verb: swap
noun: threshold
modifier: running
context: search
phrase: swap adjacent search items when running sum reaches {threshold}
phrase: exchange neighbouring candidates once cumulative total exceeds {threshold}
slot: threshold int
test: list=5,10,15,20 threshold=20
expect: => i=1 r=0.0 ok=true s="performed 1 threshold swaps" errors=0 n=4 res=[5,10,20,15] cache=0 hits=0
test: list=1,2,3,4 threshold=50
expect: => i=0 r=0.0 ok=true s="performed 0 threshold swaps" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var run_sum = 0;
	var swaps = 0;
	var idx = 0;
	while idx + 1 < g.n {
		run_sum += g.res[idx];
		if run_sum >= th {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			swaps++;
		}
		run_sum += g.res[idx + 1];
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " threshold swaps");
	out
}
@end
