code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} > g.n { g.n } else { ${k} };
	if limit <= 0 { return out; }
	var head_sum = 0;
	for i in limit { head_sum += g.res[i]; }
	g.res[0] = head_sum;
	var write_pos = 1;
	for i in limit..g.n {
		g.res[write_pos] = g.res[i];
		write_pos++;
	}
	g.n = write_pos;
	out.i = head_sum;
	out.s.clear();
	format(out.s, "merged head sum: ", head_sum);
	out
}
@end
