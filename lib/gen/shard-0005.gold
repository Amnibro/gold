kind: step
verb: cache
noun: window
modifier: until
context: search
phrase: cache window sums of size {win_size} until {bound}
phrase: store search window totals of {win_size} until {bound}
slot: win_size int
slot: bound int
test: list=2,3,4,5,6 win_size=2 bound=8
expect: => i=2 r=0.0 ok=true s="cached window sums 2" errors=0 n=5 res=[2,3,4,5,6] cache=2 hits=0
test: list=1,2,3,4 win_size=2 bound=4
expect: => i=1 r=0.0 ok=true s="cached window sums 1" errors=0 n=4 res=[1,2,3,4] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	let max_s = ${bound};
	var cached = 0;
	if g.n >= w && w > 0 {
		for i in 0..(g.n - w + 1) {
			var sum = 0;
			for j in w { sum += g.res[i + j]; }
			if sum > max_s { break; }
			gold_cache_put(g, i, sum);
			cached++;
		}
	}
	out.i = cached;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "cached window sums ", cached);
	out
}
@end
