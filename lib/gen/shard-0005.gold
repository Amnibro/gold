	var vals int[512] = [0; 512];
	for k in g.n {
		vals[k] = ${f}(g.res[k]);
	}
	var is_uniq = true;
	for i in g.n {
		for j in (i + 1)..g.n {
			if vals[i] == vals[j] { is_uniq = false; break; }
		}
		if !is_uniq { break; }
	}
	if !is_uniq {
		gold_fail(g, "duplicate values found");
		out.ok = false;
