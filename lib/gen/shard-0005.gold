code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			for j in (i + 1)..g.n {
				if g.res[j] % 2 != 0 && g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "odd elements sorted ", g.n);
	out
}
@end
