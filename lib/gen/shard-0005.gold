@entry 99f114fa6d159d14
kind: step
verb: clamp
noun: item
modifier: with_cache
context: text
phrase: clamp item character count with cache bound {item}
phrase: limit item character occurrences with cache limit {item}
slot: item text
test: text="mississippi" item="s"
expect: => i=2 r=0.0 ok=true s="missiippi" errors=0 n=0 res=[] cache=1 hits=0
test: text="banana" item="a"
expect: => i=2 r=0.0 ok=true s="banan" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let it = ${item};
	var cached_limit = gold_cache_get(g, 0);
	if cached_limit <= 0 {
		cached_limit = 2;
		gold_cache_put(g, 0, cached_limit);
	}
	var res byte[>..] = [];
	var count = 0;
	if it.len > 0 {
		let target = it[0];
		for c in out.s {
			if c == target {
				if count < cached_limit {
					res.push(c);
					count++;
				}
			} else {
				res.push(c);
			}
		}
	} else {
		for c in out.s { res.push(c); }
	}
	out.s.clear();
	for c in res { out.s.push(c); }
	g.steps += out.s.len;
	out.i = count;
	out
}
@end
