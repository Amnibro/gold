code:
fn ${ID}_is_p(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	for i in g.n {
		if ${ID}_is_p(g.res[i]) { p_count++; }
	}
	out.i = p_count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "prime elements grouped ", p_count);
	out
}
@end
