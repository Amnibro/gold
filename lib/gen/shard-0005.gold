fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n >= 2 {
		var w = 1;
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			let gap = if diff < 0 { -diff } else { diff };
			if gap > mg {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "remaining items ", g.n);
	out
}
@end
@entry 1ab2916bb5a728f4
kind: step
verb: collect
noun: step
modifier: sorted
context: core
phrase: collect step sorted stride {step_size}
phrase: sample elements collect step sorted with {step_size}
slot: step_size int
test: list=9,2,7,1,5,3 step_size=2
expect: => i=3 r=0.0 ok=true s="collected step sorted 3" errors=0 n=3 res=[5,7,9] cache=0 hits=0
test: list=8,10,4,1,6,3 step_size=3
expect: => i=2 r=0.0 ok=true s="collected step sorted 2" errors=0 n=2 res=[1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_size};
	if st <= 0 {
		gold_fail(g, "invalid step stride");
		out.ok = false;
		return out;
	}
	var w = 0;
	var i = 0;
	while i < g.n {
		g.res[w] = g.res[i];
		w++;
		i += st;
	}
	g.n = w;
	if g.n > 1 {
		for a in g.n {
			for b in 0..(g.n - 1 - a) {
				if g.res[b] > g.res[b + 1] {
					let tmp = g.res[b];
					g.res[b] = g.res[b + 1];
					g.res[b + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected step sorted ", g.n);
	out
}
@end
