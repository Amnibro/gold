context: transform
phrase: drop elements matching condition {cond} up to limit {limit}
phrase: remove items using predicate {cond} bounded by {limit}
slot: cond pred
slot: limit int
test: list=2,4,5,6,7 cond=is_even limit=2
expect: => i=2 r=0.0 ok=true s="dropped 2 matching elements" errors=0 n=3 res=[5,6,7] cache=0 hits=0
test: list=1,3,5,6,8 cond=is_odd limit=1
expect: => i=1 r=0.0 ok=true s="dropped 1 matching elements" errors=0 n=4 res=[3,5,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dropped = 0;
	var kept = 0;
	for k in g.n {
		if ${cond}(g.res[k]) && dropped < lim {
			dropped++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " matching elements");
	out
}
@end
