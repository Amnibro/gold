fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_pos int[200] = [0; 200];
	var vn = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			v_pos[vn] = i;
			vn++;
		}
	}
	var i = 0;
	while i + 1 < vn {
		let p1 = v_pos[i];
		let p2 = v_pos[i + 1];
		let tmp = out.s[p1];
		out.s[p1] = out.s[p2];
		out.s[p2] = tmp;
		i += 2;
	}
	g.steps += out.s.len;
	out.i = vn;
	out
}
@end
