test: list=12,9999
expect: => i=6 r=0.0 ok=true s="total digits evaluated 6" errors=0 n=2 res=[12,9999] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var d = 0;
		while x > 0 { d++; x /= 10; }
		total_digits += if d == 0 { 1 } else { d };
	}
	out.i = total_digits;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "total digits evaluated ", total_digits);
	out
}
@end
