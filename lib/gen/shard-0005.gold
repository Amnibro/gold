@entry aa40f979e12a02c4
kind: step
verb: scale
noun: runs
modifier: unique
context: list
phrase: scale counts of unique runs by multiplier {factor}
phrase: multiply unique value frequencies by {factor}
slot: factor int
test: list=1,1,2,3,3,3 factor=5
expect: => i=3 r=0.0 ok=true s="scaled 3 unique runs" errors=0 n=3 res=[7,11,18] cache=0 hits=0
test: list=4,5,5,6 factor=2
expect: => i=3 r=0.0 ok=true s="scaled 3 unique runs" errors=0 n=3 res=[9,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var write_pos = 0;
	var read_pos = 0;
	while read_pos < g.n {
		var scan_pos = read_pos;
		while scan_pos < g.n && g.res[scan_pos] == g.res[read_pos] { scan_pos++; }
		let run_sz = scan_pos - read_pos;
		g.res[write_pos] = g.res[read_pos] * mult + run_sz;
		write_pos++;
		read_pos = scan_pos;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "scaled ", write_pos, " unique runs");
	out
}
@end
