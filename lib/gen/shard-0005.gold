@entry 86df1cfbec40ed8c
kind: step
verb: group
noun: tail
modifier: nested
context: stats
phrase: group tail nested chunks of size {chunk}
phrase: partition tail nested items by {chunk}
slot: chunk int
test: list=10,20,30,40 chunk=2
expect: => i=70 r=0.0 ok=true s="grouped tail sum 70" errors=0 n=3 res=[10,20,70] cache=0 hits=0
test: list=5,15,25,35,45 chunk=3
expect: => i=105 r=0.0 ok=true s="grouped tail sum 105" errors=0 n=3 res=[5,15,105] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || g.n < c {
		g.steps++;
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = g.n - c;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.n = g.n - c;
	gold_push(g, sum);
	g.steps += c;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped tail sum ", sum);
	out
}
@end
@entry 79f565d796011a8e
kind: step
verb: group
noun: maximum
modifier: at_most
context: stats
phrase: group maximum at most size {size}
phrase: aggregate chunk maximums at most {size}
slot: size int
test: list=3,8,2,7,5 size=2
expect: => i=8 r=0.0 ok=true s="grouped maximum chunks 3" errors=0 n=3 res=[8,7,5] cache=0 hits=0
test: list=1,9,4,6,2 size=3
expect: => i=9 r=0.0 ok=true s="grouped maximum chunks 2" errors=0 n=2 res=[9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var mx = g.res[i];
		var j = i + 1;
		while j < g.n && j < i + sz {
			if g.res[j] > mx { mx = g.res[j]; }
			j++;
		}
		g.res[new_n] = mx;
		new_n++;
		i += sz;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "grouped maximum chunks ", new_n);
	out
}
@end
