fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var i = 0;
	while i < out.s.len {
		var j = i;
		while j < out.s.len && out.s[j] == out.s[i] { j++; }
		let run_len = j - i;
		if run_len > max_streak { max_streak = run_len; }
		i = j;
	}
	g.steps += out.s.len;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max streak: ", max_streak);
	out
}
