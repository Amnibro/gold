fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	for i in g.n {
		if g.res[i] < 0 {
			let mag = -g.res[i];
			if mag >= lo && mag <= hi { count++; }
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "errors in range count ", count);
	out
}
