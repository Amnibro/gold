expect: => i=3 r=0.0 ok=true s="cached streak entries 3" errors=0 n=4 res=[1,2,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 1;
	for i in g.n - 1 {
		if g.res[i] == g.res[i + 1] {
			streak++;
		} else {
			gold_cache_put(g, g.res[i], streak);
			streak = 1;
		}
	}
	if g.n > 0 {
		gold_cache_put(g, g.res[g.n - 1], streak);
	}
	out.i = g.cn;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached streak entries ", g.cn);
	out
}
@end
