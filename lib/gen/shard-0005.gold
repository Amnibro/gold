code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var write_pos = 1;
	for read_pos in 1..g.n {
		if g.res[read_pos] != g.res[write_pos - 1] {
			g.res[write_pos] = g.res[read_pos];
			write_pos++;
		}
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "condensed to ", write_pos, " unique pairwise items");
	out
}
@end
