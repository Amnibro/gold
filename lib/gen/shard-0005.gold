expect: 4
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return 1;
	}
	var runs = 1;
	var last = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur != last {
			runs++;
			last = cur;
		}
		x /= 10;
	}
	runs
}
@end
