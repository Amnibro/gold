	if g.n >= 2 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			gap_sum += if d < 0 { -d } else { d };
		}
	}
	g.steps += g.n;
	out.i = gap_sum;
	out.s.clear();
	format(out.s, "total gap ", gap_sum);
	out
}
@end
