	var guard_iter = 0;
	while x >= 10 && guard_iter < 30 {
		var sum = 0;
		var cnt = 0;
		var cur = x;
		while cur > 0 {
			sum += cur % 10;
			cnt++;
			cur /= 10;
		}
		x = if cnt > 0 { sum / cnt } else { 0 };
		guard_iter++;
	}
	x
}
