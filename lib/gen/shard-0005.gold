fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_len};
	if g.n >= lim && g.n > 0 {
		let mid_val = g.res[g.n / 2];
		var count = 0;
		for i in g.n {
			if g.res[i] >= mid_val { count++; }
		}
		out.i = count;
		gold_push(g, count);
	} else {
		out.i = 0;
		gold_fail(g, "sample length below threshold");
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "split middle count ", out.i);
	out
}
@end
