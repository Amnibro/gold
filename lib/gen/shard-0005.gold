@entry a89517677781394e
kind: step
verb: apply
noun: average
modifier: sorted
context: core
phrase: apply average to sorted results
phrase: compute average after sorting results
test: list=4,1,7,8
expect: => i=5 r=0.0 ok=true s="applied average sorted" errors=0 n=4 res=[-4,-1,2,3] cache=0 hits=0
test: list=10,2,6
expect: => i=6 r=0.0 ok=true s="applied average sorted" errors=0 n=3 res=[-4,0,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n { g.res[i] -= avg; }
	g.steps += g.n * g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "applied average sorted");
	out
}
@end
@entry e1df63b213276fd8
kind: step
verb: merge
noun: checkpoint
modifier: with_retry
context: core
phrase: merge checkpoint results with retry threshold {threshold}
phrase: combine checkpoint items using retry threshold {threshold}
slot: threshold int
test: list=10,20,5,15 threshold=20
expect: => i=2 r=0.0 ok=true s="merged checkpoints with retry" errors=0 n=2 res=[30,20] cache=0 hits=0
test: list=3,4,1,2 threshold=10
expect: => i=0 r=0.0 ok=true s="merged checkpoints with retry" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var merged = 0;
	var i = 0;
	var new_n = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s >= thresh {
			g.res[new_n] = s;
			merged++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
			g.res[new_n] = g.res[i + 1];
		}
		new_n++;
		i += 2;
	}
	while i < g.n {
		g.res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged checkpoints with retry");
	out
}
@end
