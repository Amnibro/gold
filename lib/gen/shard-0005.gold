	let c = ${cap};
	if g.n > 0 {
		var min_idx = 0;
		for k in g.n {
			if g.res[k] < g.res[min_idx] {
				min_idx = k;
			}
		}
		let scaled = g.res[min_idx] * 3;
		g.res[min_idx] = if scaled > c { c } else { scaled };
	}
	g.steps += g.n + 1;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "scaled min capped: ", out.i);
	out
}
@end
