test: list=1,1,2,2,3
expect: => i=3 r=0.0 ok=true s="cached 3 distinct values" errors=0 n=3 res=[1,2,3] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let _, seen = gold_cache_get(g, x);
		if !seen {
			gold_cache_put(g, x, 1);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached ", kept, " distinct values");
	out
}
@end
