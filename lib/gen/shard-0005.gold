phrase: display attempts up to at most {max_tries}
slot: max_tries int
test: list=1,3,5,6 max_tries=5
expect: => i=4 r=0.0 ok=true s="attempts: 4 ok=true" errors=0 n=4 res=[1,3,5,6] cache=0 hits=0
test: list=1,3,5,7 max_tries=3
expect: => i=3 r=0.0 ok=false s="attempts: 3 ok=false" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	let cap = ${max_tries};
	var tries = 0;
	var success = false;
	for i in g.n {
		tries++;
		if g.res[i] % 2 == 0 {
			success = true;
			break;
		}
		if tries >= cap { break; }
	}
	format(out.s, "attempts: ", tries, " ok=", success);
	out.ok = success;
	out.i = tries;
	g.steps += tries;
	out
}
@end
