code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${min_len};
	let mx = ${max_len};
	var run_len = 1;
	var valid_runs = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] >= g.res[i] {
				run_len++;
			} else {
				if run_len >= mn && run_len <= mx { valid_runs++; }
				run_len = 1;
			}
		}
		if run_len >= mn && run_len <= mx { valid_runs++; }
	}
	g.steps += g.n + 1;
	out.i = valid_runs;
	out.s.clear();
	format(out.s, "valid run counts ", valid_runs);
	out
}
@end
