fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				passes++;
			}
			j++;
		}
		i++;
	}
	out.i = passes;
	g.steps += passes + g.n + 1;
	out.s.clear();
	format(out.s, "checkpoint sorted swaps ", passes);
	out
}
@end
