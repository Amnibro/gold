@entry 16887051fcddb91d
kind: step
verb: clamp
noun: cache
modifier: sorted
context: math
phrase: clamp sorted cache entries to capacity {cap}
phrase: bound sorted cache elements at cap {cap}
slot: cap int
test: list=10,20,30 cap=2
expect: => i=2 r=0.0 ok=true s="cache clamped to 2" errors=0 n=3 res=[10,20,30] cache=2 hits=0
test: list=5,15,25,35 cap=3
expect: => i=3 r=0.0 ok=true s="cache clamped to 3" errors=0 n=4 res=[5,15,25,35] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	for i in g.n {
		gold_cache_put(g, g.res[i], i);
	}
	// sort cache keys
	for i in g.cn {
		for j in 0..(g.cn - 1) {
			if g.ck[j] > g.ck[j + 1] {
				let tk = g.ck[j];
				g.ck[j] = g.ck[j + 1];
				g.ck[j + 1] = tk;
				let tv = g.cv[j];
				g.cv[j] = g.cv[j + 1];
				g.cv[j + 1] = tv;
			}
		}
	}
	if g.cn > c {
		g.cn = c;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cache clamped to ", g.cn);
	out
}
@end
