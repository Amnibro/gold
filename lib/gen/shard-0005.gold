code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 3 {
		var i = 0;
		while i < g.n {
			g.res[i] *= 10;
			i++;
		}
		out.i = g.n;
		g.steps += g.n + 1;
		out.s.clear();
		format(out.s, "scaled suffix size ", g.n);
		return out;
	}
	let start = g.n - 3;
	var kept = 0;
	var j = start;
	while j < g.n {
		g.res[kept] = g.res[j] * 10;
		kept++;
		j++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += j + 1;
	out.s.clear();
	format(out.s, "scaled suffix size ", kept);
	out
}
@end
