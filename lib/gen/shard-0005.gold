@entry 88758ee0f48949f3
kind: step
verb: run
noun: maximum
modifier: unique
context: stats
phrase: run maximum unique with fallback {fallback}
phrase: calculate unique maximum or fallback {fallback}
slot: fallback int
test: list=5,8,3,8,2 fallback=0
expect: => i=5 r=0.0 ok=true s="unique max 5" errors=0 n=5 res=[5,8,3,8,2] cache=0 hits=0
test: list=7,7,4,4 fallback=-1
expect: => i=-1 r=0.0 ok=false s="unique max -1" errors=0 n=4 res=[7,7,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	var found = false;
	var best = -1000000;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { cnt++; }
		}
		if cnt == 1 && (!found || g.res[i] > best) {
			best = g.res[i];
			found = true;
		}
	}
	g.steps += g.n + 1;
	if found {
		out.i = best;
		out.ok = true;
	} else {
		out.i = fb;
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "unique max ", out.i);
	out
}
@end
