code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		if core_is_prime(g.res[k]) {
			primes[pn] = g.res[k];
			pn++;
		}
	}
	gold_clear(g);
	var k = pn;
	while k > 0 {
		k--;
		gold_push(g, primes[k]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined ", g.n, " reverse primes");
	out
}
@end
