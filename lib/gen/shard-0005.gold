@entry 904c02b627f85098
kind: step
verb: keep
noun: duplicates
modifier: any
context: search
phrase: keep any duplicate items from search results
phrase: filter candidate values retaining only repeated elements
test: list=10,20,10,30,20,40
expect: => i=2 r=0.0 ok=true s="kept 2 duplicate candidate values" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="kept 0 duplicate candidate values" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dups int[512] = [0; 512];
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt >= 2 {
			var already = false;
			for k in kept {
				if dups[k] == g.res[i] { already = true; break; }
			}
			if !already {
				dups[kept] = g.res[i];
				kept++;
			}
		}
	}
	for k in kept {
		g.res[k] = dups[k];
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " duplicate candidate values");
	out
}
@end
@entry 6ac5dc543293b814
kind: step
verb: rotate
noun: steps
modifier: at_least
context: loop
phrase: rotate steps at least {min_steps} passes
phrase: cycle rotate steps at least {min_steps} iterations
slot: min_steps int
test: list=1,2,3,4 min_steps=2
expect: => i=4 r=0.0 ok=true s="rotated steps" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=10,20,30 min_steps=1
expect: => i=3 r=0.0 ok=true s="rotated steps" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_steps};
	if g.n > 1 && ms > 0 {
		var cnt = ms % g.n;
		while cnt > 0 {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
			cnt--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated steps");
	out
}
@end
@entry aac37314b051479d
kind: step
