noun: tally
modifier: each
context: list
phrase: retry tallying occurrences of item {target} with {attempts} tries
phrase: tally occurrences of value {target} allowing {attempts} attempts
slot: target int
slot: attempts int
test: list=3,5,3,3,7 target=3 attempts=2
expect: => i=3 r=0.0 ok=true s="tallied 3 after 1 tries" errors=0 n=5 res=[3,5,3,3,7] cache=0 hits=0
test: list=1,2,4 target=9 attempts=3
expect: => i=1 r=0.0 ok=true s="tallied 1 after 2 tries" errors=0 n=3 res=[9,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_tries = ${attempts};
	var tally = 0;
	var tries = 0;
	while tries < max_tries {
		tries++;
		tally = 0;
		for k in g.n {
			if g.res[k] == tgt { tally++; }
		}
		if tally > 0 { break; }
		if g.n > 0 { g.res[0] = tgt; }
	}
	out.i = tally;
	out.s.clear();
	format(out.s, "tallied ", tally, " after ", tries, " tries");
	out
}
@end
@entry b5142d281d96444b
kind: step
verb: pair
noun: gaps
modifier: in_reverse
context: list
phrase: pair differences between elements in reverse order
phrase: calculate gaps between adjacent items backwards
test: list=10,25,30,55
expect: => i=2 r=0.0 ok=true s="computed 2 reverse gaps" errors=0 n=2 res=[25,0] cache=0 hits=0
test: list=3,7,12,18,25
expect: => i=2 r=0.0 ok=true s="computed 2 reverse gaps" errors=0 n=2 res=[7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var write_pos = 0;
	var idx = g.n - 1;
	while idx > 0 {
		let diff = g.res[idx] - g.res[idx - 1];
		g.res[write_pos] = diff;
		write_pos++;
		idx -= 2;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "computed ", write_pos, " reverse gaps");
	out
}
@end
