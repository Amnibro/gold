fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${keep_n};
	if k < g.n {
		let start = g.n - k;
		for i in k {
			g.res[i] = g.res[start + i];
		}
		g.n = k;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
