@entry eb8e5112cc5af4d1
kind: step
verb: sort
noun: digits
modifier: with_cache
context: filter
phrase: sort digits with cache filtering
phrase: order digits with cache lookup
phrase: filter sorted digits with cache
test: list=42,19,30
expect: => i=3 r=0.0 ok=true s="sorted 3 items by digit sum" errors=0 n=3 res=[30,42,19] cache=3 hits=6
test: list=95,12
expect: => i=2 r=0.0 ok=true s="sorted 2 items by digit sum" errors=0 n=2 res=[12,95] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var ds = 0;
		while x > 0 { ds += x % 10; x /= 10; }
		gold_cache_put(g, g.res[k], ds);
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			let d1, _ = gold_cache_get(g, g.res[i]);
			let d2, _ = gold_cache_get(g, g.res[j]);
			if d1 > d2 {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items by digit sum");
	out
}
@end
