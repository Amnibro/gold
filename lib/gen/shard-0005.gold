test: text="abde"
expect: => i=0 r=0.0 ok=false s="steps invalid" errors=1 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	if out.s.len > 1 {
		let expected = (out.s[1] as int) - (out.s[0] as int);
		gold_cache_put(g, 0, expected);
		for i in 1..(out.s.len - 1) {
			let diff = (out.s[i + 1] as int) - (out.s[i] as int);
			if diff != expected {
				valid = false;
				break;
			}
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += out.s.len;
	out.s.clear();
	if valid {
		format(out.s, "steps valid");
	} else {
		gold_fail(g, "inconsistent character step delta");
		format(out.s, "steps invalid");
	}
	out
}
@end
