	let lim = ${bound};
	var kept = 0;
	var match_count = 0;
	for k in g.n {
		if g.res[k] > lim {
			if match_count % 2 == 0 {
				g.res[kept] = g.res[k];
				kept++;
			}
			match_count++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
