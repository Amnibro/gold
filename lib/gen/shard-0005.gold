expect: => i=2 r=0.0 ok=true s="elements retained above average 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,5,15
expect: => i=1 r=0.0 ok=true s="elements retained above average 1" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var new_n = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	out.i = new_n;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "elements retained above average ", new_n);
	out
}
@end
