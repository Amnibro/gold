code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements for minimum search");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	var retries = 0;
	var adjusted = min_val;
	while adjusted < 10 && retries < 5 {
		adjusted += 2;
		retries++;
	}
	g.res[min_idx] = adjusted;
	g.steps += g.n + retries;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "minimum adjusted to ", adjusted, " after ", retries, " retries");
	out
}
@end
