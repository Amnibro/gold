@entry 2286fa1c8f0e3478
kind: step
verb: reverse
noun: primes
modifier: first
context: retry
phrase: reverse prime retry numbers first
phrase: invert prime retry sequence first
test: list=2,3,5,8,9
expect: => i=3 r=0.0 ok=true s="reversed 3 primes" errors=0 n=5 res=[5,3,2,8,9] cache=0 hits=0
test: list=4,6,7,11
expect: => i=2 r=0.0 ok=true s="reversed 2 primes" errors=0 n=4 res=[4,6,11,7] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			count++;
		}
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < j && !${ID}_is_prime(g.res[i]) { i++; }
		while i < j && !${ID}_is_prime(g.res[j]) { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " primes");
	out
}
@end
