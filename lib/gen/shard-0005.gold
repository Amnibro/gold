@entry 50c1bcec630acabe
kind: step
verb: sort
noun: suffix
modifier: all
context: retry
phrase: sort suffix all elements starting at {start}
phrase: order suffix all items from offset {start}
slot: start int
test: list=10,9,8,7,6 start=2
expect: => i=3 r=0.0 ok=true s="sorted suffix from offset" errors=0 n=5 res=[10,9,6,7,8] cache=0 hits=0
test: list=5,4,3,2,1 start=1
expect: => i=4 r=0.0 ok=true s="sorted suffix from offset" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	var sorted = false;
	while !sorted {
		sorted = true;
		var i = st;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
			i++;
		}
	}
	out.i = g.n - st;
	out.s.clear();
	format(out.s, "sorted suffix from offset");
	out
}
@end
@entry 08a05ac95ae65470
kind: step
verb: dedupe
noun: values
modifier: at_most
context: retry
phrase: dedupe values at most {count} duplicates
phrase: restrict dedupe values at most {count} occurrences
slot: count int
test: list=1,1,1,2,2,3 count=2
expect: => i=5 r=0.0 ok=true s="deduped values count 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 count=1
expect: => i=1 r=0.0 ok=true s="deduped values count 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${count};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == val {
				seen++;
			}
		}
		if seen < max_c {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped values count ", kept);
	out
}
@end
@entry c31a30b41819ff15
kind: step
verb: rotate
noun: runs
modifier: any
context: retry
phrase: rotate runs any distance {shift} positions
phrase: cycle runs any offset {shift} slots
slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=4 r=0.0 ok=true s="rotated runs" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=3 r=0.0 ok=true s="rotated runs" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		var sh = s % g.n;
		while sh > 0 {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
			sh--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated runs");
	out
}
@end
