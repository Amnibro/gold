code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${char_idx};
	var res byte[>..] = [];
	var k = if idx < 0 { 0 } else { idx };
	while k < out.s.len {
		res.push(out.s[k]);
		k++;
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry fef3d94e30d28947
