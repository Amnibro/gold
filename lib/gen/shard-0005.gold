	if idx < g.n {
		g.res[write_pos] = core_digit_sum(g.res[idx]);
		write_pos++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "paired digit sums into ", write_pos, " entries");
