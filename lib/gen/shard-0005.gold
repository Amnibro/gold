@entry af5021f5194186f7
kind: step
verb: clamp
noun: primes
modifier: unique
context: stats
phrase: clamp prime values to maximum bound {max_prime}
phrase: limit unique prime numbers to ceiling {max_prime}
slot: max_prime int
test: list=2,3,11,13,17 max_prime=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,10,10,10] cache=0 hits=0
test: list=5,7,23,29 max_prime=20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[5,7,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_prime};
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && x > limit {
				g.res[i] = limit;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out
}
@end
