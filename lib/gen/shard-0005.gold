code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_digits};
	var matched = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d <= lim {
			matched++;
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched ", matched, " items with at most ", lim, " digits");
	out
}
@end
