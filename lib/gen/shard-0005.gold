code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var count = 0;
	for k in g.n {
		if g.res[k] == min_val { count++; }
	}
	if count > 1 {
		gold_fail(g, "minimum not unique");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "min count ", count);
	out
}
@end
