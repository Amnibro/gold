code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let reps = if hi > lo { hi - lo } else { 1 };
	let orig_n = g.n;
	for r in 1..reps {
		for k in orig_n {
			gold_push(g, g.res[k]);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated streak to length ", g.n);
	out
}
@end
