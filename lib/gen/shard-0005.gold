code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sym = true;
	for i in g.n / 2 {
		let opp = g.n - 1 - i;
		if g.res[i] != g.res[opp] {
			is_sym = false;
			break;
		}
	}
	out.ok = is_sym;
	out.i = if is_sym { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reverse symmetry check ", is_sym);
	out
}
@end
