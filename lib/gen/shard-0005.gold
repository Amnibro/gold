code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${bound};
	if g.n > 0 {
		var min_v = g.res[0];
		for i in g.n {
			if g.res[i] < min_v { min_v = g.res[i]; }
		}
		if min_v <= cap {
			gold_cache_put(g, min_v, min_v);
			out.i = min_v;
		} else {
			out.i = -1;
		}
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "minimum check ", out.i);
	out
}
@end
