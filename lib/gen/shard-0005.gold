test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="folded into 2 pairs" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items");
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var k = 0;
	while k + 1 < g.n {
		g.res[new_n] = g.res[k] + g.res[k + 1];
		new_n++;
		k += 2;
	}
	if k < g.n {
		g.res[new_n] = g.res[k];
		new_n++;
	}
	g.n = new_n;
	g.steps += new_n;
	out.s.clear();
	format(out.s, "folded into ", new_n, " pairs");
	out
}
@end
