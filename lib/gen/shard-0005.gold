fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for idx in g.n {
		var x = g.res[idx];
		var sign = 1;
		if x < 0 { sign = -1; x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x = x / 10;
		}
		g.res[idx] = rev * sign;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reversed digits of ", g.n, " numbers");
	out
}
