fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	var max_run = 0;
	var cur_run = 0;
	for k in g.n {
		if g.res[k] <= limit {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 0;
		}
	}
	out.i = max_run;
	out.s.clear();
	format(out.s, "max sequence at most ceiling is ", max_run);
	out
}
