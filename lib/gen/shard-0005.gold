@entry 427fc17714e9ef27
kind: step
verb: join
noun: primes
modifier: pairwise
context: sort
phrase: join primes pairwise adjacent in results
phrase: sum pairwise adjacent prime products in sorted list
test: list=2,3,5,7,11
expect: => i=43 r=0.0 ok=true s="pairwise prime sum 43" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=3,5,8,11,13
expect: => i=32 r=0.0 ok=true s="pairwise prime sum 32" errors=0 n=5 res=[3,5,8,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in 1..g.n {
		let a = g.res[k - 1];
		let b = g.res[k];
		var pa = if a >= 2 { true } else { false };
		var d = 2;
		while d * d <= a { if a % d == 0 { pa = false; break; } d++; }
		var pb = if b >= 2 { true } else { false };
		d = 2;
		while d * d <= b { if b % d == 0 { pb = false; break; } d++; }
		if pa && pb { sum += a + b; }
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "pairwise prime sum ", sum);
	out
}
@end
