	let factor = ${times};
	if g.n > keep_n {
		let start = g.n - keep_n;
		for i in keep_n {
			g.res[i] = g.res[start + i] * factor;
		}
		g.n = keep_n;
	} else {
		for i in g.n { g.res[i] *= factor; }
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "limited history size ", g.n);
	out
}
@end
