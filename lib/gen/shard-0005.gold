fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${bound};
	var violated = false;
	for i in g.n {
		if g.res[i] > max_b {
			violated = true;
			break;
		}
	}
	if violated {
		gold_fail(g, "element exceeded bound");
		out.ok = false;
		out.i = 0;
	} else {
		out.ok = true;
		out.i = g.n;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "none above bound ", max_b);
	out
}
@end
