expect: => i=12 r=0.0 ok=false s="compared maximum times factor" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let fac = ${factor};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let exceeds = max_val >= lim * fac;
	out.ok = exceeds;
	out.i = max_val;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "compared maximum times factor");
	out
}
@end
