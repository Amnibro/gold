fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var running = 0;
	var stored = 0;
	for i in g.n {
		running += g.res[i];
		if running <= cap {
			gold_cache_put(g, i, running);
			stored++;
		}
	}
	out.i = stored;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "cached ", stored, " loop sums");
	out
}
@end
