@entry a190789b866b13db
kind: step
verb: search
noun: window
modifier: up_to
context: loop
phrase: search window up to sum ceiling {max_sum}
phrase: scan search window up to threshold {max_sum}
slot: max_sum int
test: list=1,2,3,4,5 max_sum=6
expect: => i=3 r=0.0 ok=true s="longest window length 3" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30 max_sum=25
expect: => i=1 r=0.0 ok=true s="longest window length 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_sum};
	var max_len = 0;
	for i in g.n {
		var sum = 0;
		var j = i;
		while j < g.n {
			sum += g.res[j];
			if sum <= lim {
				let cur_len = j - i + 1;
				if cur_len > max_len { max_len = cur_len; }
			} else {
				break;
			}
			j++;
		}
	}
	out.i = max_len;
	out.s.clear();
	format(out.s, "longest window length ", max_len);
	out
}
@end
