code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tail_len = ${k};
	var start = if tail_len >= g.n { 0 } else { g.n - tail_len };
	var unique_tail = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in start..i {
			if g.res[j] == x { seen = true; }
		}
		if !seen { unique_tail++; }
	}
	g.steps += g.n + 1;
	out.i = unique_tail;
	out.s.clear();
	format(out.s, "unique tail ", unique_tail);
	out
}
@end
