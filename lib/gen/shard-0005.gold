fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let num_last = ${count};
	if num_last <= 0 || g.n == 0 {
		gold_fail(g, "no items to reverse digits");
		out.ok = false;
		return out;
	}
	let start_pos = if g.n > num_last { g.n - num_last } else { 0 };
	var rev_sum = 0;
	for k in start_pos..g.n {
		let rev = core_reverse_digits(g.res[k]);
		g.res[k] = rev;
		rev_sum += rev;
	}
	g.steps += g.n - start_pos;
	out.i = rev_sum;
	out.s.clear();
	format(out.s, "reversed last digits total sum ", rev_sum);
	out
}
