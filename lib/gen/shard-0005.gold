kind: step
verb: limit
noun: primes
modifier: safely
context: list
phrase: limit primes safely up to count {maxcount}
phrase: bound prime numbers safely to {maxcount}
slot: maxcount int
test: list=2,3,4,5,6,7 maxcount=2
expect: => i=4 r=0.0 ok=true s="limit primes safely" errors=0 n=4 res=[2,3,4,6] cache=0 hits=0
test: list=11,13,14,17 maxcount=1
expect: => i=2 r=0.0 ok=true s="limit primes safely" errors=0 n=2 res=[11,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${maxcount};
	var kept = 0;
	for i in g.n {
		let num = g.res[i];
		var is_p = num >= 2;
		var d = 2;
		while d * d <= num {
			if num % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			if kept < mc {
				g.res[kept] = num;
				kept++;
			}
		} else {
			g.res[kept] = num;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "limit primes safely");
	out
}
@end
