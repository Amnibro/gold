fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${count};
	var done = 0;
	var idx = 0;
	while idx + 1 < g.n && done < max_swaps {
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		done++;
		idx += 2;
	}
	out.i = done;
	out.s.clear();
	format(out.s, "swapped ", done, " initial pairs");
	out
}
@end
