fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let sum_digits = core_digit_sum(g.res[idx]) + core_digit_sum(g.res[idx + 1]);
		g.res[write_pos] = sum_digits;
		write_pos++;
		idx += 2;
