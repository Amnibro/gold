fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		out.i = 0;
		return out;
	}
	// sort text characters
	for i in out.s.len {
		for j in 0..(out.s.len - 1) {
			if out.s[j] > out.s[j + 1] {
				let tmp = out.s[j];
				out.s[j] = out.s[j + 1];
				out.s[j + 1] = tmp;
			}
		}
	}
	var sum = 0;
	for c in out.s { sum += c as int; }
	let avg = sum / out.s.len;
	g.steps += out.s.len;
	out.i = avg;
	out
}
