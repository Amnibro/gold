	let head_len = g.n / 2;
	var sum_head = 0;
	var i = 0;
	while i < head_len {
		sum_head += g.res[i];
		i += 2;
	}
	g.steps += head_len;
	out.i = sum_head;
	out.s.clear();
	format(out.s, "scanned head alternating total ", sum_head);
	out
}
@end
