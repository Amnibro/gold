	if out.s.len < 2 { return out; }
	let mid = out.s.len / 2;
	let tmp = out.s[mid - 1];
	out.s[mid - 1] = out.s[mid];
	out.s[mid] = tmp;
	out.i = mid;
	out
}
@end
