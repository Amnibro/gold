fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[..200] = [];
	var prev_space = false;
	for b in out.s {
		if b == ' ' {
			if !prev_space { buf.push(b); }
			prev_space = true;
		} else {
			buf.push(b);
			prev_space = false;
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
