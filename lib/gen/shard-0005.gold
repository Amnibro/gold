@entry 4889d3efa545c542
kind: step
verb: search
noun: average
modifier: with_retry
context: sort
phrase: search average with retry tolerance range {tolerance}
phrase: locate sorted element closest to mean within {tolerance}
slot: tolerance int
test: list=10,20,30,40 tolerance=5
expect: => i=20 r=0.0 ok=true s="average match 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,2,9,10 tolerance=2
expect: => i=-1 r=0.0 ok=true s="average match -1" errors=0 n=4 res=[1,2,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n == 0 { out.ok = false; return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var found = -1;
	for k in g.n {
		var diff = g.res[k] - avg;
		if diff < 0 { diff = -diff; }
		if diff <= tol {
			found = g.res[k];
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "average match ", found);
	out
}
@end
