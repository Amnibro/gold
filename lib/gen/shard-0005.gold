expect: => i=2 r=0.0 ok=true s="even count 2 odd count 1" errors=0 n=3 res=[10,32,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 512];
	var odds = [0; 512];
	var en = 0;
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		} else {
			odds[on] = g.res[i];
			on++;
		}
	}
	for i in en { g.res[i] = evens[i]; }
	for i in on { g.res[en + i] = odds[i]; }
	out.i = en;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "even count ", en, " odd count ", on);
	out
}
@end
