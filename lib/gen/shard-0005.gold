test: list=10,10,20,30
expect: => i=3 r=0.0 ok=true s="sampled histogram bins=3" errors=0 n=4 res=[10,2,30,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	var vals int[512] = [0; 512];
	var cnts int[512] = [0; 512];
	for k in g.n {
		let x = g.res[k];
		var found = false;
		for j in u {
			if vals[j] == x {
				cnts[j]++;
				found = true;
				break;
			}
		}
		if !found && u < 256 {
			vals[u] = x;
			cnts[u] = 1;
			u++;
		}
	}
	var new_n = 0;
	var i = 0;
	while i < u {
		g.res[new_n] = vals[i];
		new_n++;
		g.res[new_n] = cnts[i];
		new_n++;
		i += 2;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = u;
	out.s.clear();
	format(out.s, "sampled histogram bins=", u);
	out
}
@end
