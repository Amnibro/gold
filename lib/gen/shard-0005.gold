	while i < g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; }
		}
		if seen { dups++; }
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = dups;
	out.s.clear();
	format(out.s, "alternate duplicates ", dups);
	out
}
