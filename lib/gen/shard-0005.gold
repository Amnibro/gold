code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var count = 0;
	var i = 0;
	while i < g.n {
		let num = g.res[i];
		if core_is_prime(num) {
			count += 1;
		}
		i += 1;
	}
	format(out.s, "running primes found: ", count);
	g.steps += 1;
	out.i = count;
	out
}
@end
