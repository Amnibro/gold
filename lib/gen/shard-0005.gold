@entry d7df4b3355932500
kind: fn
verb: cache
noun: budget
modifier: with_retry
context: aggregate
phrase: maximum prime factor below budget {budget}
phrase: largest prime factor up to budget {budget}
slot: budget int
test: arg=84 budget=10
expect: 7
test: arg=95 budget=10
expect: 5
code:
fn ${ID}(n int) int {
	let max_p = ${budget};
	var x = if n < 2 { 2 } else { n };
	var best = 0;
	var d = 2;
	while d * d <= x {
		if x % d == 0 {
			if d <= max_p && d > best { best = d; }
			while x % d == 0 { x /= d; }
		}
		d++;
	}
	if x > 1 && x <= max_p && x > best {
		best = x;
	}
	best
}
@end
