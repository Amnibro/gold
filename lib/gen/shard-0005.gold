@entry dd985531de7c85a5
kind: step
verb: run
noun: histogram
modifier: sorted
context: aggregate
phrase: run histogram across sorted frequencies
phrase: compute frequency histogram in sorted order
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="histogram bins: 3" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=10,10,10,20
expect: => i=2 r=0.0 ok=true s="histogram bins: 2" errors=0 n=2 res=[3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var freqs int[512] = [0; 512];
	var fn_cnt = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		freqs[fn_cnt] = j - i;
		fn_cnt++;
		i = j;
	}
	gold_clear(g);
	for k in fn_cnt {
		gold_push(g, freqs[k]);
	}
	g.steps += g.n;
	out.i = fn_cnt;
	out.s.clear();
	format(out.s, "histogram bins: ", fn_cnt);
	out
}
@end
