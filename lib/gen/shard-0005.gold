fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var min_val = 999999;
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var filled = 0;
	for i in g.n {
		if filled < count {
			g.res[i] = min_val;
			filled++;
		}
	}
	g.steps += g.n + filled;
	out.i = min_val;
	out.s.clear();
	format(out.s, "fill minimum in place");
	out
}
@end
