	let l = ${len};
	let count = if l < g.n { l } else { g.n };
	let start = g.n - count;
	let pairs = count / 2;
	for k in pairs {
		let idx1 = start + k * 2;
		let idx2 = idx1 + 1;
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
	}
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "reversed suffix pairs: ", pairs);
