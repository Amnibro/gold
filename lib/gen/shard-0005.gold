@entry 28d9b7a0602f8dc2
kind: step
verb: dedupe
noun: items
modifier: sorted
context: cache
phrase: dedupe items sorted with cache gap {gap}
phrase: purge duplicate sorted items keeping cache gap {gap}
slot: gap int
test: list=1,2,3,5,6 gap=2
expect: => i=3 r=0.0 ok=true s="deduped sorted count 3" errors=0 n=3 res=[1,3,5] cache=1 hits=0
test: list=10,11,15,16,20 gap=3
expect: => i=3 r=0.0 ok=true s="deduped sorted count 3" errors=0 n=3 res=[10,15,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_gap = ${gap};
	var new_n = 0;
	if g.n > 0 {
		g.res[new_n] = g.res[0];
		new_n++;
		for i in 1..g.n {
			if g.res[i] - g.res[new_n - 1] >= g_gap {
				g.res[new_n] = g.res[i];
				new_n++;
			}
		}
	}
	g.n = new_n;
	gold_cache_put(g, 0, new_n);
	g.steps += g.n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped sorted count ", new_n);
	out
}
@end
