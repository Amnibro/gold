test: list=3,1 count=2
expect: => i=0 r=0.0 ok=true s="repeated sequence to 4 items" errors=0 n=4 res=[1,3,1,3] cache=0 hits=0
test: list=5 count=3
expect: => i=0 r=0.0 ok=true s="repeated sequence to 3 items" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let reps = ${count};
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let orig_n = g.n;
	var r = 1;
	while r < reps && g.n + orig_n <= 512 {
		for k in orig_n {
			g.res[g.n] = g.res[k];
			g.n++;
		}
		r++;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "repeated sequence to ", g.n, " items");
	out
}
@end
