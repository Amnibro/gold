code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 {
		out.i = 0;
		return out;
	}
	var chunks = 0;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz {
			sum += g.res[i + j];
		}
		g.res[chunks] = sum;
		chunks++;
		i += sz;
	}
	g.n = chunks;
	g.steps += i;
	out.i = chunks;
	out.s.clear();
	format(out.s, "grouped ", chunks, " chunks");
	out
}
@end
