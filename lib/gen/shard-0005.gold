@entry e225cbb37ca50841
kind: step
verb: find
noun: suffix
modifier: times
context: core
phrase: find suffix times target {times} with size {sz}
phrase: detect repeated suffix times frequency {times} span {sz}
slot: sz int
slot: times int
test: list=1,2,3,1,2,3 sz=3 times=2
expect: => i=2 r=0.0 ok=true s="suffix count 2" errors=0 n=6 res=[1,2,3,1,2,3] cache=0 hits=0
test: list=1,2,3,4,5 sz=2 times=2
expect: => i=1 r=0.0 ok=false s="suffix count 1" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${sz};
	let t = ${times};
	if s <= 0 || g.n < s {
		out.i = 0;
		return out;
	}
	var count = 0;
	let suffix_start = g.n - s;
	var i = 0;
	while i + s <= g.n {
		var matches = true;
		for j in s {
			if g.res[i + j] != g.res[suffix_start + j] { matches = false; }
		}
		if matches { count++; }
		i++;
	}
	g.steps += g.n * s + 1;
	out.i = count;
	out.ok = count >= t;
	out.s.clear();
	format(out.s, "suffix count ", count);
	out
}
@end
