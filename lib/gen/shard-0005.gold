fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "runs: ");
	if g.n == 0 { return out; }
	var cur_val = g.res[0];
	var cur_len = 1;
	var run_count = 0;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			if run_count > 0 { format(out.s, ","); }
			format(out.s, cur_val, ":", cur_len);
			gold_cache_put(g, cur_val, cur_len);
			run_count++;
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	if run_count > 0 { format(out.s, ","); }
	format(out.s, cur_val, ":", cur_len);
	gold_cache_put(g, cur_val, cur_len);
	out.i = run_count + 1;
	g.steps += g.n;
	out
}
@end
