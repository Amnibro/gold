fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_f = ${bound};
	var cached = 0;
	for i in g.n {
		let item = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == item { freq++; }
		}
		if freq <= max_f {
			gold_cache_put(g, item, freq);
			cached++;
		}
	}
	out.i = cached;
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "cached counter frequencies ", cached);
	out
}
@end
