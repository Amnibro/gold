code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if out.i < 0 { -out.i } else { out.i };
	g.n = 0;
	if x == 0 {
		gold_push(g, 0);
	} else {
		while x > 0 {
			gold_push(g, x % 10);
			x /= 10;
		}
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "extracted and sorted digits");
	out
}
@end
