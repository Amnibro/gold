@entry da65fc05a00d5d13
kind: step
verb: rank
noun: window
modifier: running
context: retry
phrase: rank window running span of {size} items
phrase: compute rank window running length {size}
slot: size int
test: list=10,20,30,40 size=2
expect: => i=70 r=0.0 ok=true s="window sum 70" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,5,25 size=3
expect: => i=45 r=0.0 ok=true s="window sum 45" errors=0 n=4 res=[5,15,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var sum = 0;
	var k = if g.n >= sz { g.n - sz } else { 0 };
	while k < g.n {
		sum += g.res[k];
		k++;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "window sum ", sum);
	out
}
@end
