code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_pairs};
	let total_p = g.n / 2;
	let take = if total_p < mp { total_p } else { mp };
	for k in take {
		g.res[k] = g.res[k * 2] + g.res[k * 2 + 1];
	}
	g.n = take;
	g.steps += take + 1;
	out.i = take;
	out.s.clear();
	format(out.s, "paired items up to: ", take);
	out
}
@end
