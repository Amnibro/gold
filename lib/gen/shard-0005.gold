fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for idx in g.n {
		let val = g.res[idx];
		let cv, hit = gold_cache_get(g, val);
		if !hit {
			gold_cache_put(g, val, 1);
			g.res[unique_count] = val;
			unique_count++;
		}
	}
	g.n = unique_count;
	out.i = unique_count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "merged unique memo count ", unique_count);
	out
}
@end
