code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var sum = 0;
	var taken = 0;
	var i = g.n - 1;
	while i >= 0 && taken < c {
		sum += g.res[i];
		taken++;
		i--;
	}
	g.steps += taken;
	out.i = sum;
	out.s.clear();
	format(out.s, "reverse range sum ", sum);
	out
}
@end
