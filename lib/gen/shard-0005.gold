fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < g.n && ${p}(g.res[0]) {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		count++;
	}
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "shifted words count ", count);
	out
}
