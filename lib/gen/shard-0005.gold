code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let def_val = ${fallback};
	var replaced = 0;
	for k in g.n {
		let orig = g.res[k];
		let res_val = ${f}(orig);
		if res_val < 0 || res_val > 5000 {
			g.res[k] = def_val;
			replaced++;
		} else {
			g.res[k] = res_val;
		}
	}
	out.i = replaced;
	out.s.clear();
	format(out.s, "safely applied with ", replaced, " fallbacks");
	out
}
@end
@entry 107a989dac49c967
kind: step
verb: merge
noun: prefix
modifier: unique
context: list
phrase: merge prefix of {count} unique elements
phrase: condense first {count} distinct values into sum
slot: count int
test: list=2,2,3,4,4,5 count=3
expect: => i=11 r=0.0 ok=true s="merged prefix of 3 unique items" errors=0 n=3 res=[11,4,5] cache=0 hits=0
test: list=10,10,20,30 count=2
expect: => i=40 r=0.0 ok=true s="merged prefix of 2 unique items" errors=0 n=2 res=[40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_unique = ${count};
	var unique_seen = 0;
	var p_sum = 0;
	var idx = 0;
	while idx < g.n && unique_seen < target_unique {
		var is_first = true;
		for j in idx {
			if g.res[j] == g.res[idx] { is_first = false; break; }
		}
		if is_first { unique_seen++; }
		p_sum += g.res[idx];
		idx++;
	}
	if idx > 1 {
		g.res[0] = p_sum;
		for k in idx..g.n {
			g.res[k - idx + 1] = g.res[k];
		}
		g.n = g.n - idx + 1;
	}
	out.i = p_sum;
	out.s.clear();
	format(out.s, "merged prefix of ", unique_seen, " unique items");
	out
}
@end
