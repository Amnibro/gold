code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var new_n = 0;
	for i in g.n {
		let x = g.res[i];
		var sq = false;
		var r = 1;
		while r * r <= x {
			if r * r == x { sq = true; break; }
			r++;
		}
		if sq && x <= c {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.n = new_n;
	gold_cache_put(g, 0, new_n);
	g.steps += g.n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "unique squares selected ", new_n);
	out
}
@end
