kind: step
verb: find
noun: prefix
modifier: pairwise
context: transform
phrase: find pairwise common prefix digits
phrase: compare adjacent elements pairwise for common prefix
test: list=123,124,128
expect: => i=2 r=0.0 ok=true s="found pairwise prefixes" errors=0 n=2 res=[1,1] cache=0 hits=0
test: list=950,951,800
expect: => i=2 r=0.0 ok=true s="found pairwise prefixes" errors=0 n=2 res=[9,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var pairs = g.n - 1;
	for k in pairs {
		var a = core_abs_val(g.res[k]);
		var b = core_abs_val(g.res[k + 1]);
		while a >= 10 { a /= 10; }
		while b >= 10 { b /= 10; }
		g.res[k] = if a == b { a } else { 0 };
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found pairwise prefixes");
	out
}
@end
