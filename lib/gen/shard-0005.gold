fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cur byte[..200] = "";
	for k in out.s.len {
		let b = out.s[k];
		if cur.len == 0 || b != cur[cur.len - 1] {
			if cur.len < 200 { cur.push(b); }
		}
	}
	out.s.clear();
	for b in cur { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
