noun: step
modifier: with_cache
context: retry
phrase: trace step with cache lookup key {key}
phrase: record trace step with cache probe {key}
slot: key int
test: list=10,20 key=0
expect: => i=10 r=0.0 ok=true s="found cached step" errors=0 n=2 res=[10,20] cache=2 hits=1
test: list=5 key=99
expect: => i=-1 r=0.0 ok=false s="cache miss" errors=1 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	let val, ok = gold_cache_get(g, k);
	out.s.clear();
	if ok {
		out.i = val;
		format(out.s, "found cached step");
	} else {
		gold_fail(g, "cache miss on trace step");
		out.ok = false;
		out.i = -1;
		format(out.s, "cache miss");
	}
	out
}
@end
