code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for middle check");
		out.ok = false;
		return out;
	}
	let mid_idx = g.n / 2;
	let mid_val = g.res[mid_idx];
	var count = 0;
	for k in g.n {
		if g.res[k] == mid_val {
			count++;
		}
	}
	out.s.clear();
	if count == 1 {
		out.i = mid_val;
		format(out.s, "middle element unique");
	} else {
		gold_fail(g, "middle element duplicated");
		out.ok = false;
		format(out.s, "middle duplicate detected");
	}
	out
}
@end
