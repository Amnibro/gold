code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_freq};
	var matched = 0;
	for i in g.n {
		let item = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == item { freq++; }
		}
		if freq >= thresh {
			gold_push(g, item);
			matched++;
		}
	}
	out.i = matched;
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "frequent counter items ", matched);
	out
}
@end
