code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${count};
	if rep <= 0 || g.n == 0 {
		gold_fail(g, "invalid measurement parameters");
		out.ok = false;
		return out;
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	let agg = total * rep;
	g.steps += g.n * rep;
	out.i = agg;
	out.s.clear();
	format(out.s, "measured values ", rep, " times total ", agg);
	out
}
@end
@entry dd685e645e3bf70a
kind: step
verb: scan
noun: subfunction
modifier: unique
context: aggregate
phrase: scan unique items applying subfunction {sub}
phrase: aggregate unique elements with subfunction {sub}
slot: sub fn
test: list=2,3,2,5 sub=double
expect: => i=24 r=0.0 ok=true s="scanned 4 unique items total 24" errors=0 n=4 res=[4,6,4,10] cache=0 hits=0
test: list=4,4,4 sub=inc
expect: => i=15 r=0.0 ok=true s="scanned 3 unique items total 15" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for unique scan");
		out.ok = false;
		return out;
	}
	var ucount = 0;
	var sum_uniq = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in ucount {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			let transformed = ${sub}(x);
			g.res[ucount] = transformed;
			sum_uniq += transformed;
			ucount++;
		}
	}
	g.n = ucount;
	g.steps += g.n;
	out.i = sum_uniq;
	out.s.clear();
	format(out.s, "scanned ", ucount, " unique items total ", sum_uniq);
	out
}
@end
