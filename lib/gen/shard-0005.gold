@entry 0b1f76cd0b8fae6c
kind: step
verb: return
noun: primes
modifier: first
context: error
phrase: return primes first error check
phrase: partition prime results ahead of errors
test: list=4,7,9,11,15
expect: => i=2 r=0.0 ok=true s="primes 2" errors=0 n=5 res=[7,11,4,9,15] cache=0 hits=0
test: list=2,3,5,-1,8
expect: => i=3 r=0.0 ok=true s="primes 3" errors=1 n=5 res=[2,3,5,-1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[256] = [0; 256];
	var others int[256] = [0; 256];
	var np = 0;
	var no = 0;
	for k in g.n {
		let x = g.res[k];
		if x < 0 { gold_fail(g, "negative error code"); }
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p { primes[np] = x; np++; }
		else { others[no] = x; no++; }
	}
	for i in np { g.res[i] = primes[i]; }
	for i in no { g.res[np + i] = others[i]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "primes ", np);
	out
}
@end
@entry e8e3f54c4dc5e9f0
kind: step
verb: dedupe
noun: digits
modifier: safely
context: error
phrase: dedupe digits safely in error codes
phrase: clean duplicate digits safely for errors
test: list=1122,3434
expect: => i=2 r=0.0 ok=true s="cleaned 2" errors=1 n=2 res=[12,34] cache=0 hits=0
test: list=123,456
expect: => i=0 r=0.0 ok=true s="cleaned 0" errors=0 n=2 res=[123,456] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var seen int[10] = [0; 10];
		var digits int[20] = [0; 20];
		var len = 0;
		while x > 0 {
			digits[len] = x % 10;
			len++;
			x /= 10;
		}
		var clean = 0;
		var i = len - 1;
		while i >= 0 {
			let d = digits[i];
			if seen[d] == 0 {
				clean = clean * 10 + d;
				seen[d] = 1;
			}
			i--;
		}
		if clean != g.res[k] { modified++; g.res[k] = clean; }
	}
	if modified > 0 { gold_fail(g, "duplicate digits cleaned"); }
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "cleaned ", modified);
	out
}
@end
