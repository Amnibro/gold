test: list=1,2,3,4 min_len=3
expect: => i=4 r=0.0 ok=true s="reversed items at least: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20 min_len=5
expect: => i=2 r=0.0 ok=true s="reversed items at least: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n >= ml {
		let half = g.n / 2;
		for k in half {
			let t = g.res[k];
			g.res[k] = g.res[g.n - 1 - k];
			g.res[g.n - 1 - k] = t;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed items at least: ", g.n);
	out
}
@end
