@entry 5779b9370ec885e5
kind: step
verb: collect
noun: digits
modifier: in_place
context: stats
phrase: collect digits in place with modulo {base}
phrase: extract digit totals in place modulo {base}
slot: base int
test: list=15,28,49 base=10
expect: => i=9 r=0.0 ok=true s="collected digits sum 9" errors=0 n=3 res=[6,0,3] cache=0 hits=0
test: list=102,305,409 base=5
expect: => i=9 r=0.0 ok=true s="collected digits sum 9" errors=0 n=3 res=[3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if b > 0 { s %= b; }
		g.res[i] = s;
		total += s;
	}
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "collected digits sum ", total);
	out
}
@end
@entry 6bfb42c414db3d1a
kind: step
verb: compare
noun: window
modifier: times
context: stats
phrase: compare window times repeated {window}
phrase: evaluate moving windows repeated {window}
slot: window int
test: list=2,4,7,11,16 window=2
expect: => i=5 r=0.0 ok=true s="max window span 5" errors=0 n=5 res=[2,4,7,11,16] cache=0 hits=0
test: list=5,10,20,35 window=3
expect: => i=25 r=0.0 ok=true s="max window span 25" errors=0 n=4 res=[5,10,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || g.n < w {
		g.steps++;
		out.ok = false;
		return out;
	}
	var max_diff = 0;
	for i in g.n - w + 1 {
		let diff = g.res[i + w - 1] - g.res[i];
		if diff > max_diff { max_diff = diff; }
	}
	g.steps += g.n + 1;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "max window span ", max_diff);
	out
}
@end
