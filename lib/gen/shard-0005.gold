fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_streak = 0;
	var cur_streak = 0;
	for idx in g.n {
		let x = g.res[idx];
		if x >= lo && x <= hi {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 0;
		}
	}
	out.i = max_streak;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "longest streak ", max_streak);
	out
}
@end
