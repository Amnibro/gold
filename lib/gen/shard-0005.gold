code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_err};
	if g.errors > cap {
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = g.errors;
	out.s.clear();
	format(out.s, "error allowance at most ", cap, " actual ", g.errors);
	g.steps++;
	out
}
@end
