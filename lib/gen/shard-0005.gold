code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_v = ${cap};
	var v_count = 0;
	var buf byte[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		let is_v = (b == 97 || b == 101 || b == 105 || b == 111 || b == 117);
		if is_v {
			if v_count < max_v {
				buf.push(b);
				v_count++;
			}
		} else {
			buf.push(b);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = v_count;
	g.steps += out.s.len + 1;
	out
}
@end
