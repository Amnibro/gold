code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let inv = ${interval};
	if inv <= 0 {
		gold_fail(g, "invalid bucket interval");
		out.ok = false;
		return out;
	}
	g.steps += out.i;
	let bucket = g.steps / inv;
	out.i = bucket;
	out.s.clear();
	format(out.s, "step bucket ", bucket);
	out
}
@end
