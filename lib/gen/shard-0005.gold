code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for k in g.n {
		let val = g.res[k];
		let cached_val, hit = gold_cache_get(g, val);
		if hit {
			gold_cache_put(g, val, cached_val + 1);
		} else {
			gold_cache_put(g, val, 1);
			unique_count++;
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "grouped series into ", unique_count, " cached keys");
	out
}
@end
