expect: => i=3 r=0.0 ok=true s="clamped duplicates count: 3" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var temp int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == x { j++; }
		let count = j - i;
		var keep_count = count;
		if count > 1 {
			if keep_count < lo { keep_count = lo; }
			if keep_count > hi { keep_count = hi; }
		}
		for k in keep_count {
			if tn < 512 {
				temp[tn] = x;
				tn++;
			}
		}
		i = j;
	}
	gold_clear(g);
	for k in tn { gold_push(g, temp[k]); }
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "clamped duplicates count: ", tn);
	out
}
@end
