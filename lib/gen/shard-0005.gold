fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	if m <= 0 { return out; }
	var counts int[256] = [0; 256];
	for c in out.s { counts[c as int]++; }
	var res byte[..200] = "";
	for c in out.s {
		if counts[c as int] % m == 0 {
			if res.len < 200 { res.push(c); }
		}
	}
	out.s = res;
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
