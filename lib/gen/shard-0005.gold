fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	while start + 1 < g.n && ${pred}(g.res[start]) && g.res[start] == g.res[start + 1] {
		start++;
	}
	var kept = 0;
	var i = start;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped head");
	out
}
