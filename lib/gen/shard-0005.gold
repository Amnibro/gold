fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var words = 0;
	var in_word = false;
	for b in out.s {
		if b == ' ' {
			if in_word {
				words++;
				in_word = false;
				if words >= c { break; }
			}
		} else {
			in_word = true;
		}
	}
	if in_word && words < c { words++; }
	gold_cache_put(g, 0, words);
	g.steps += out.s.len + 1;
	out.i = words;
	out.s.clear();
	format(out.s, "split first words count ", words);
	out
}
@end
