code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var cached = 0;
	while cached < g.n && cached < lim {
		gold_cache_put(g, cached, g.res[cached]);
		cached++;
	}
	g.steps += g.n + cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached sorted items ", cached);
	out
}
@end
