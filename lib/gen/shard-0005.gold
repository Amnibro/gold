fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var kept = 0;
	var seen_max = false;
	for k in g.n {
		if g.res[k] == max_val {
			if !seen_max {
				g.res[kept] = g.res[k];
				kept++;
				seen_max = true;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " duplicate max values");
	out
}
@end
