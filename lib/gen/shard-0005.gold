code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var kept = 0;
	for k in g.n {
		if g.res[k] > avg {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.r = avg as real;
	out.s.clear();
	format(out.s, "kept ", kept, " above average");
	out
}
@end
