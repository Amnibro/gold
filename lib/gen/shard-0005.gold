	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var count = 0;
	for k in (g.n - 1) {
		let s = g.res[k] + g.res[k + 1];
		if core_is_prime(s) {
			gold_cache_put(g, k, s);
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " prime pair sums");
	out
}
