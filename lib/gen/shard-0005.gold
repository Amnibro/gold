fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_pts};
	if g.n >= req && g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		gold_push(g, avg);
		out.i = avg;
	} else {
		out.i = 0;
		gold_fail(g, "insufficient history points");
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "history avg ", out.i);
	out
}
@end
