fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let d = g.res[idx + 1] - g.res[idx];
		g.res[count] = if d < 0 { -d } else { d };
		count++;
		idx += 2;
	}
	if idx < g.n {
		g.res[count] = g.res[idx];
		count++;
	}
	g.n = count;
	out.i = count;
	g.steps += idx + 1;
	out.s.clear();
	format(out.s, "in place range pairs ", count);
	out
}
@end
