@entry 95d5d52d19403456
kind: step
verb: rotate
noun: step
modifier: between
context: stats
phrase: rotate step elements between indices {low} to {high}
phrase: cycle list values between bounds {low} to {high}
slot: low int
slot: high int
test: list=1,2,3,4,5 low=1 high=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,4,2,3,5] cache=0 hits=0
test: list=10,20,30,40,50,60 low=0 high=4
expect: => i=5 r=0.0 ok=true s="" errors=0 n=6 res=[50,10,20,30,40,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${low};
	var hi = ${high};
	if lo < 0 { lo = 0; }
	if hi >= g.n { hi = g.n - 1; }
	if lo < hi {
		let last = g.res[hi];
		var i = hi;
		while i > lo {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[lo] = last;
		g.steps += (hi - lo + 1);
	}
	out.i = if hi >= lo { hi - lo + 1 } else { 0 };
	out
}
@end
