code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for merge");
		out.ok = false;
		return out;
	}
	var acc = g.res[0];
	var k = 1;
	while k < g.n {
		acc = ${sub}(acc + g.res[k]);
		if ${stop}(acc) {
			break;
		}
		k++;
	}
	g.steps += k;
	out.i = acc;
	out.s.clear();
	format(out.s, "merged until condition stopped at ", acc);
	out
}
@end
