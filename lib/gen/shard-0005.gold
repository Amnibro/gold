code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	let lo = ${min_val};
	let hi = ${max_val};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = if g.n > 0 { sum / g.n } else { 0 };
	if avg < lo { avg = lo; }
	else if avg > hi { avg = hi; }
	format(out.s, "clamped avg: ", avg);
	out.i = avg;
	g.steps += g.n;
	out
}
@end
