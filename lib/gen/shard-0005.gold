code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var count = 0;
	var idx = g.cn - 1;
	while idx >= 0 {
		let val, ok = gold_cache_get(g, idx);
		if ok { count++; }
		idx--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "validated cache in reverse count ", count);
	out
}
@end
