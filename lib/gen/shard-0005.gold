kind: step
verb: validate
noun: loop
modifier: nested
context: stats
phrase: validate nested loop differences exceed {min_gap}
phrase: verify all pairwise element gaps exceed {min_gap}
slot: min_gap int
test: list=10,20,30 min_gap=5
expect: => i=1 r=0.0 ok=true s="nested check passed" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,12,30 min_gap=5
expect: => i=0 r=0.0 ok=false s="nested check failed" errors=1 n=3 res=[10,12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var valid = true;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				let diff = g.res[i] - g.res[j];
				let d = if diff < 0 { -diff } else { diff };
				if d < mg {
					valid = false;
					break;
				}
			}
			if !valid { break; }
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	if valid {
		format(out.s, "nested check passed");
	} else {
		gold_fail(g, "nested gap below threshold");
		format(out.s, "nested check failed");
	}
	out
}
@end
