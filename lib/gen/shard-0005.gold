code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lp = ${len_prefix};
	let bound = if lp < g.n { lp } else { g.n };
	if bound > 1 {
		var l = 0;
		var r = bound - 1;
		while l < r {
			let t = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = t;
			l++;
			r--;
		}
	}
	out.i = bound;
	g.steps += bound + 1;
	out.s.clear();
	format(out.s, "reversed in place prefix ", bound);
	out
}
@end
