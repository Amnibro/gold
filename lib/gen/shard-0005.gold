code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n > 0 {
		var min_idx = 0;
		for k in g.n {
			if g.res[k] < g.res[min_idx] {
				min_idx = k;
			}
		}
		while g.res[min_idx] < tgt {
			g.res[min_idx] *= 2;
			g.steps++;
		}
	}
	g.steps += g.n + 1;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "scaled minimum: ", out.i);
	out
}
@end
