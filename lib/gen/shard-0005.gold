fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${step_max};
	var kept = if g.n > 0 { 1 } else { 0 };
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let diff = core_abs_val(g.res[i + 1] - g.res[i]);
			if diff > max_d { break; }
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "split step kept ", kept);
	out
}
@end
