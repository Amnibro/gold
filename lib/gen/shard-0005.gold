expect: => i=3 r=0.0 ok=true s="selected 3 items" errors=0 n=3 res=[5,8,10] cache=0 hits=0
test: list=4,4,4,6,7
expect: => i=2 r=0.0 ok=true s="selected 2 items" errors=0 n=2 res=[6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] == min_val { continue; }
		var already = false;
		for j in kept {
			if g.res[j] == g.res[k] { already = true; break; }
		}
		if !already {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " items");
	out
}
@end
