code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var swapped = 0;
	if g.n >= 4 && c > 0 {
		let mid = g.n / 2;
		let tmp = g.res[mid - 1];
		g.res[mid - 1] = g.res[mid];
		g.res[mid] = tmp;
		swapped = 1;
	}
	gold_cache_put(g, 1, swapped);
	g.steps += swapped + 1;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped middle count ", swapped);
	out
}
@end
