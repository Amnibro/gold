expect: => i=0 r=0.0 ok=true s="extracted 0 unique odds" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "extracted ", kept, " unique odds");
	out
}
@end
