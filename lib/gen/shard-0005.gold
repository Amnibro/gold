fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	if g.cn == 0 {
		gold_cache_put(g, 1, 10);
		gold_cache_put(g, 2, 2);
	}
	let thresh, ok = gold_cache_get(g, key);
	var w = 0;
	if ok {
		for i in g.n {
			if g.res[i] > thresh {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered size ", g.n);
	out
}
@end
