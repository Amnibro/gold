phrase: display adjacent pair totals between {min_val} to {max_val}
slot: min_val int
slot: max_val int
test: list=1,4,2,8 min_val=4 max_val=9
expect: => i=1 r=0.0 ok=true s="pairs: [5]" errors=0 n=4 res=[1,4,2,8] cache=0 hits=0
test: list=10,20,5,15 min_val=15 max_val=25
expect: => i=1 r=0.0 ok=true s="pairs: [20]" errors=0 n=4 res=[10,20,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	out.s.clear();
	var count = 0;
	format(out.s, "pairs: [");
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s >= lo && s <= hi {
			if count > 0 { out.s.push(','); out.s.push(' '); }
			format(out.s, s);
			count++;
		}
		i += 2;
	}
	format(out.s, "]");
	g.steps += g.n;
	out.i = count;
	out
}
@end
