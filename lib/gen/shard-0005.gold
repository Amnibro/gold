@entry 512851b0e6835520
kind: step
verb: find
noun: step
modifier: between
context: search
phrase: find step between bounds {low} to {high}
phrase: search step interval between {low} through {high}
slot: low int
slot: high int
test: list=2,8,15,30 low=5 high=10
expect: => i=6 r=0.0 ok=true s="found step match 6" errors=0 n=4 res=[2,8,15,30] cache=0 hits=0
test: list=10,12,18,40 low=15 high=25
expect: => i=22 r=0.0 ok=true s="found step match 22" errors=0 n=4 res=[10,12,18,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var matched_step = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff >= lo && diff <= hi {
				matched_step = diff;
				found = true;
				break;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = matched_step;
	out.ok = found;
	out.s.clear();
	format(out.s, "found step match ", matched_step);
	out
}
@end
@entry c57d8afac23c1cee
kind: step
verb: group
noun: odds
modifier: nested
context: search
phrase: group odds nested into buckets of {bucket}
phrase: cluster search odd items nested by {bucket}
slot: bucket int
test: list=1,3,5,7,9 bucket=2
expect: => i=3 r=0.0 ok=true s="grouped odds count 3" errors=0 n=3 res=[4,12,9] cache=0 hits=0
test: list=2,3,5,7,11 bucket=3
expect: => i=2 r=0.0 ok=true s="grouped odds count 2" errors=0 n=2 res=[15,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b <= 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var cur_sum = 0;
	var in_b = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			cur_sum += g.res[i];
			in_b++;
			if in_b == b {
				g.res[new_n] = cur_sum;
				new_n++;
				cur_sum = 0;
				in_b = 0;
			}
		}
	}
	if in_b > 0 {
		g.res[new_n] = cur_sum;
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped odds count ", new_n);
	out
}
@end
