	out.s.clear();
	let cap = ${max_avg};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	let valid = avg <= cap;
	format(out.s, "avg=", avg, " valid=", valid);
	out.ok = valid;
	out.i = avg;
	g.steps += g.n;
	out
}
