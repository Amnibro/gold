modifier: recursively
context: stats
phrase: rank error deviations recursively around mean
phrase: count recursive outlier errors from mean
test: list=10,12,14,100
expect: => i=1 r=0.0 ok=false s="" errors=1 n=4 res=[10,12,14,100] cache=0 hits=0
test: list=5,6,7,50,60
expect: => i=1 r=0.0 ok=false s="" errors=1 n=5 res=[5,6,7,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var outliers = 0;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		for i in g.n {
			let diff = g.res[i] - avg;
			let d = if diff < 0 { -diff } else { diff };
			if d > avg {
				gold_fail(g, "outlier error detected");
				outliers++;
			}
		}
	}
	g.steps += g.n;
	out.i = outliers;
	out.ok = outliers == 0;
	out
}
@end
