phrase: compute running window max with span {window_size}
slot: window_size int
test: arg=12345,9182 window_size=2
expect: 9
expect: 10
test: arg=5555 window_size=3
expect: 15
code:
fn ${ID}(n int) int {
	let w = ${window_size};
	var x = if n < 0 { -n } else { n };
	var xs int[>..] = [];
	while x > 0 { xs.push(x % 10); x /= 10; }
	if xs.len == 0 { xs.push(0); }
	if w <= 0 || xs.len < w { return 0; }
	var max_sum = 0;
	for i in (xs.len - w + 1) {
		var cur = 0;
		for j in w { cur += xs[i + j]; }
		if cur > max_sum { max_sum = cur; }
	}
	max_sum
}
@end
@entry 585314223ae1002f
kind: pred
verb: validate
noun: window
modifier: running
context: list
phrase: validate window running differences within {max_diff}
phrase: check adjacent running differences under {max_diff}
slot: max_diff int
test: arg=12345,1928 max_diff=2
expect: true
expect: false
test: arg=159 max_diff=5
expect: true
code:
fn ${ID}(n int) bool {
	let lim = ${max_diff};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	var ok = true;
	while x > 0 {
		let d = x % 10;
		let diff = if d > prev { d - prev } else { prev - d };
		if diff > lim {
			ok = false;
			break;
		}
		prev = d;
		x /= 10;
	}
	ok
}
@end
