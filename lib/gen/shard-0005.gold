@entry 8b6850b3c4ca6e37
kind: step
verb: rotate
noun: primes
modifier: all
context: aggregate
phrase: rotate all prime numbers forward in collection
phrase: shift all prime elements forward by one position
test: list=2,3,5,7,11
expect: => i=5 r=0.0 ok=true s="rotated 5 primes" errors=0 n=5 res=[11,2,3,5,7] cache=0 hits=0
test: list=4,2,6,3,8,5
expect: => i=3 r=0.0 ok=true s="rotated 3 primes" errors=0 n=6 res=[4,5,6,2,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_indices int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		if core_is_prime(g.res[k]) {
			p_indices[pn] = k;
			pn++;
		}
	}
	if pn > 1 {
		let last_val = g.res[p_indices[pn - 1]];
		var k = pn - 1;
		while k > 0 {
			g.res[p_indices[k]] = g.res[p_indices[k - 1]];
			k--;
		}
		g.res[p_indices[0]] = last_val;
	}
	g.steps += g.n + pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "rotated ", pn, " primes");
	out
}
@end
