expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[20,30,40,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_freq = 0;
	for i in g.n {
		var f = 0;
		for j in g.n { if g.res[j] == g.res[i] { f++; } }
		if f > max_freq { max_freq = f; }
	}
	if g.n > 1 && max_freq > 0 {
		let shift = max_freq % g.n;
		for step in shift {
			let first = g.res[0];
			for i in 0..(g.n - 1) {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = max_freq;
	out
}
@end
