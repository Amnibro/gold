fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p1 = ${start};
	let p2 = ${end_idx};
	if p1 < 0 || p2 < 0 || p1 >= g.n || p2 >= g.n || p1 == p2 {
		gold_fail(g, "invalid swap indices");
		out.ok = false;
		return out;
	}
	let temp = g.res[p1];
	g.res[p1] = g.res[p2];
	g.res[p2] = temp;
	let total_pair = g.res[p1] + g.res[p2];
	g.steps += 1;
	out.i = total_pair;
	out.s.clear();
	format(out.s, "swapped items sum ", total_pair);
	out
}
