fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 {
		gold_fail(g, "not enough items for middle pairing");
		out.ok = false;
		return out;
	}
	var pairs_built = 0;
	var i = 1;
	while i + 1 < g.n - 1 {
		let pair_sum = g.res[i] + g.res[i + 1];
		if ${stop}(pair_sum) {
			break;
		}
		g.res[pairs_built] = pair_sum;
		pairs_built++;
		i += 2;
	}
	g.n = pairs_built;
	g.steps += i + 1;
	out.i = pairs_built;
	out.s.clear();
	format(out.s, "middle pairs created ", pairs_built);
	out
}
@end
