code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	for i in g.n {
		g.res[g.n - 1 - i] = b + i;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled reverse values ", g.n);
	out
}
