fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	// sort all ascending first
	for i in g.n {
		for j in 0..(g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var sum = 0;
	var kept = 0;
	for i in g.n {
		if sum + g.res[i] <= max_b {
			sum += g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "kept ", kept, " items within budget ", sum);
	out
}
@end
