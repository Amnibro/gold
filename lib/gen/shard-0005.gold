fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var running = 0;
	var valid = true;
	for k in g.n {
		running += g.res[k];
		if running > thresh {
			valid = false;
			gold_fail(g, "running threshold exceeded");
			break;
		}
	}
	g.steps += g.n;
	out.i = running;
	out.ok = valid;
	out.s.clear();
	format(out.s, "running sum ", running, " threshold ", thresh);
	out
}
@end
