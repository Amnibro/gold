fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var k = ${shift} % g.n;
	if k < 0 { k += g.n; }
	var temp int[512] = [0; 512];
	for i in g.n {
		let target = (i - k + g.n) % g.n;
		temp[target] = g.res[i];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated left by ", k);
	out
}
@end
