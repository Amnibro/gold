test: list=5,5,5,5 times=1
expect: => i=4 r=0.0 ok=true s="longest streak 4 scaled 1 times to 4" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${times};
	if count <= 0 || g.n == 0 {
		gold_fail(g, "invalid streak parameters");
		out.ok = false;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	let total_score = max_streak * count;
	g.steps += g.n * count;
	out.i = total_score;
	out.s.clear();
	format(out.s, "longest streak ", max_streak, " scaled ", count, " times to ", total_score);
	out
}
@end
