phrase: cyclic shift of nested error digits
test: arg=1234,95
expect: 4123
expect: 59
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return x;
	}
	let last = x % 10;
	let rest = x / 10;
	var pow = 1;
	while rest >= pow {
		pow *= 10;
	}
	last * pow + rest
}
@end
