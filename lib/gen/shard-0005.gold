@entry b7fc43efbf92eab1
kind: step
verb: group
noun: memo
modifier: safely
context: sort
phrase: group memo safely into chunks of {chunk}
phrase: cluster sorted memo items safely by {chunk}
slot: chunk int
test: list=1,2,3,4,5,6 chunk=3
expect: => i=2 r=0.0 ok=true s="safe memo chunks count 2" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 chunk=2
expect: => i=2 r=0.0 ok=true s="safe memo chunks count 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = i;
		while j < g.n && j < i + c {
			sum += g.res[j];
			j++;
		}
		g.res[new_n] = sum;
		new_n++;
		i += c;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "safe memo chunks count ", new_n);
	out
}
@end
