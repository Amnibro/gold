@entry 950b3fc43e39aefc
kind: step
verb: clamp
noun: duplicates
modifier: none
context: error
phrase: clamp duplicates none error policy
phrase: strip all duplicate error codes
test: list=5,10,5,20,10
expect: => i=2 r=0.0 ok=true s="unique total 3" errors=1 n=3 res=[5,10,20] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="unique total 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dups = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept { if g.res[j] == x { seen = true; break; } }
		if !seen {
			g.res[kept] = x;
			kept++;
		} else {
			dups++;
		}
	}
	if dups > 0 { gold_fail(g, "duplicates purged entirely"); }
	g.n = kept;
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "unique total ", kept);
	out
}
@end
