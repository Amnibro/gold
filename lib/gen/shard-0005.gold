fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var matches = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var cnt = 0;
		while i < g.n && g.res[i] == x {
			cnt++;
			i++;
		}
		if cnt >= mf { matches++; }
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "qualifying bins ", matches);
	out
}
@end
