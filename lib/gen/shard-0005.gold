fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var w = 0;
	var in_w = false;
	for k in out.s.len {
		let c = out.s[k];
		if c != ' ' {
			if !in_w {
				w++;
				in_w = true;
			}
		} else {
			in_w = false;
		}
	}
	if w == 0 {
		gold_fail(g, "no words found in text");
		out.ok = false;
	}
	g.steps += w * t;
	out.i = w * t;
	out.s.clear();
	format(out.s, "counted words times: ", out.i);
	out
}
@end
