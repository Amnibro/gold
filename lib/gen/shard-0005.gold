fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var new_n = 0;
	var p_count = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			if p_count < c {
				g.res[new_n] = g.res[i];
				new_n++;
				p_count++;
			}
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = p_count;
	out.s.clear();
	format(out.s, "limited prime count ", p_count);
	out
}
@end
