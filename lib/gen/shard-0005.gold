@entry 64fbfc8a3238f160
kind: step
verb: repeat
noun: streak
modifier: with_retry
context: aggregate
phrase: repeat streak elements with retry multiplier {factor}
phrase: duplicate streak length with retry factor {factor}
slot: factor int
test: list=5,5,5,1,2 factor=2
expect: => i=6 r=0.0 ok=true s="repeated streak of 5 count 6" errors=0 n=6 res=[5,5,5,5,5,5] cache=0 hits=0
test: list=9,9,3 factor=3
expect: => i=6 r=0.0 ok=true s="repeated streak of 9 count 6" errors=0 n=6 res=[9,9,9,9,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 || f <= 1 {
		out.i = 0;
		return out;
	}
	let first_val = g.res[0];
	var streak = 0;
	while streak < g.n && g.res[streak] == first_val {
		streak++;
	}
	gold_clear(g);
	for k in (streak * f) {
		gold_push(g, first_val);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated streak of ", first_val, " count ", g.n);
	out
}
@end
