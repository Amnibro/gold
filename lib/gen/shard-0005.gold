fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] > cut {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "mapped in reverse above cutoff count=", kept);
	out
}
