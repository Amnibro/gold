fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ranks int[512] = [0; 512];
	for i in g.n {
		var r = 0;
		for j in g.n {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks[i] = r;
