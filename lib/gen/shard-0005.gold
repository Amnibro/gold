code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${size};
	if win < 2 || g.n < win {
		gold_fail(g, "window size invalid for list");
		out.ok = false;
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i + win <= g.n {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "window swaps executed ", swaps);
	out
}
@end
