fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			run++;
			i++;
		}
		g.res[kept] = val * run;
		kept++;
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "scaled runs total ", kept);
	out
}
@end
