expect: => i=2 r=0.0 ok=true s="kept 2 items outside range" errors=0 n=2 res=[1,20] cache=0 hits=0
test: list=2,8,12,18 low=6 high=14
expect: => i=2 r=0.0 ok=true s="kept 2 items outside range" errors=0 n=2 res=[2,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x <= lo || x >= hi {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items outside range");
	out
}
@end
