@entry 1a9a0396005c56c2
kind: step
verb: sort
noun: item
modifier: last
context: aggregate
phrase: sort last {count} items in collection
phrase: arrange last {count} elements in ascending order
slot: count int
test: list=5,1,9,3,7 count=3
expect: => i=3 r=0.0 ok=true s="sorted last 3 items" errors=0 n=5 res=[5,1,3,7,9] cache=0 hits=0
test: list=20,10,50,40,30 count=4
expect: => i=4 r=0.0 ok=true s="sorted last 4 items" errors=0 n=5 res=[20,10,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 1 || g.n < c {
		out.i = 0;
		return out;
	}
	let start = g.n - c;
	for i in c {
		for j in (c - 1) {
			let idx = start + j;
			if g.res[idx] > g.res[idx + 1] {
				let tmp = g.res[idx];
				g.res[idx] = g.res[idx + 1];
				g.res[idx + 1] = tmp;
			}
		}
	}
	g.steps += c * c;
	out.i = c;
	out.s.clear();
	format(out.s, "sorted last ", c, " items");
	out
}
@end
