fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[on] = g.res[i];
			on++;
		}
	}
	g.n = on;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = g.n;
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "collected sorted odds ", g.n);
	out
}
@end
