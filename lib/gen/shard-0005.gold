fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	out.s.clear();
	let take = if sz < g.n { sz } else { g.n };
	let start = g.n - take;
	format(out.s, "window: [");
	for k in take {
		if k > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, g.res[start + k]);
	}
	format(out.s, "]");
	g.steps += take;
	out.i = take;
	out
}
@end
