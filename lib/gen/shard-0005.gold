code:
fn ${ID}(g Gold&, v Val) Val {
	let limit = ${max_len};
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results list");
		out.ok = false;
		return out;
	}
	let start = if g.n > limit { g.n - limit } else { 0 };
	for k in start..g.n {
		g.res[k] *= 2;
	}
	g.steps += (g.n - start);
	out.s.clear();
	format(out.s, "mapped suffix of ", g.n - start, " items");
	out
}
@end
