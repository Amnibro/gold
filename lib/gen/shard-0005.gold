code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			count++;
		} else {
			break;
		}
		i += 2;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "budget items: ", count);
	out
}
@end
