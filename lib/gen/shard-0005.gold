kind: step
verb: normalize
noun: memo
modifier: between
context: core
phrase: normalize memo between keys {low} to {high} with {div}
phrase: scale memo between bounds {low} through {high} by {div}
slot: low int
slot: high int
slot: div int
test: low=1 high=3 div=2
expect: => i=2 r=0.0 ok=true s="normalized memo 2" errors=0 n=0 res=[] cache=3 hits=0
test: low=4 high=6 div=5
expect: => i=1 r=0.0 ok=true s="normalized memo 1" errors=0 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let d = ${div};
	if d == 0 {
		gold_fail(g, "zero divisor");
		out.ok = false;
		return out;
	}
	if g.cn == 0 {
		gold_cache_put(g, 1, 20);
		gold_cache_put(g, 2, 40);
		gold_cache_put(g, 5, 50);
	}
	var modified = 0;
	for i in g.cn {
		if g.ck[i] >= lo && g.ck[i] <= hi {
			g.cv[i] /= d;
			modified++;
		}
	}
	g.steps += g.cn + 1;
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized memo ", modified);
	out
}
@end
