fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_lens int[64] = [0; 64];
	var nwords = 0;
	var cur_len = 0;
	for k in out.s.len {
		if out.s[k] == ' ' {
			if cur_len > 0 && nwords < 64 {
				word_lens[nwords] = cur_len;
				nwords++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 && nwords < 64 {
		word_lens[nwords] = cur_len;
		nwords++;
	}
	var pairs_sum = 0;
	var idx = 0;
	while idx + 2 < nwords {
		pairs_sum += word_lens[idx] + word_lens[idx + 2];
		idx += 2;
	}
	g.steps += nwords;
	out.i = pairs_sum;
	out.s.clear();
	format(out.s, "alternating word pairs sum ", pairs_sum);
	out
}
@end
