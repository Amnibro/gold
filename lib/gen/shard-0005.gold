fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var sq = x * x;
		if f > 0 { sq /= f; }
		g.res[i] = sq;
		sum += sq;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "normalized squares sum ", sum);
	out
}
@end
