slot: attempts int
test: list=5,4,3,2,1 attempts=2
expect: => i=2 r=0.0 ok=true s="completed 2 sorting passes" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=3,1,2 attempts=1
expect: => i=1 r=0.0 ok=true s="completed 1 sorting passes" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_p = ${attempts};
	var pass = 0;
	while pass < max_p {
		var swapped = false;
		for i in 0..(g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
		}
		if !swapped { break; }
		pass++;
	}
	out.i = pass;
	out.s.clear();
	format(out.s, "completed ", pass, " sorting passes");
	out
}
@end
