fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim, found = gold_cache_get(g, 1);
	let actual_lim = if found { lim } else { 50 };
	if !found { gold_cache_put(g, 1, 50); }
	var kept = 0;
	for k in g.n {
		if g.res[k] <= actual_lim {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	if kept < g.n { gold_fail(g, "items exceeded cached limit"); }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached limit kept ", kept);
	out
}
@end
