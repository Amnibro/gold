fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${max_val};
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= ceil && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[write_idx] = x;
				write_idx++;
			}
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out
}
@end
