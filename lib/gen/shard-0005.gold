code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var count = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let delta = g.res[i + 1] - g.res[i];
			if delta > tol { count++; }
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "steps above tolerance ", count);
	out
}
