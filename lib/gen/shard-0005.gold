@entry 6578b21ae15596d2
kind: step
verb: fold
noun: primes
modifier: until
context: sort
phrase: fold primes until stop condition {stop}
phrase: sum sorted primes until predicate {stop} matches
slot: stop pred
test: list=2,3,5,8,11 stop=is_even
expect: => i=10 r=0.0 ok=true s="folded prime sum 10" errors=0 n=5 res=[2,3,5,8,11] cache=0 hits=0
test: list=3,5,7,12 stop=over_100
expect: => i=15 r=0.0 ok=true s="folded prime sum 15" errors=0 n=4 res=[3,5,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n {
		let x = g.res[k];
		if ${stop}(x) && k > 0 { break; }
		var is_p = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { sum += x; }
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded prime sum ", sum);
	out
}
@end
