fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		if g.res[k] < 0 { g.res[k] = 0; }
	}
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	for k in g.n {
		g.res[k] -= min_val;
	}
	g.steps += g.n * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized condition min=", min_val);
	out
}
@end
