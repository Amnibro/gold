	if g.n <= 1 {
		g.steps += 1;
		return out;
	}
	var kept = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " elements");
