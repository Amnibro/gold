fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var ok = true;
	for k in out.s.len {
		if out.s[k] == '(' { depth++; }
		else if out.s[k] == ')' {
			if depth == 0 { ok = false; break; }
			depth--;
		}
	}
	if depth != 0 { ok = false; }
	if !ok {
		gold_fail(g, "unbalanced parentheses");
		out.ok = false;
	}
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked parentheses");
	out
}
@end
