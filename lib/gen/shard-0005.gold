test: list=1,2,3,4 sz=2
expect: => i=7 r=0.0 ok=true s="merged suffix 7" errors=0 n=3 res=[1,2,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${sz};
	if s > 0 && s <= g.n {
		var sum_tail = 0;
		let start_idx = g.n - s;
		for i in start_idx..g.n {
			sum_tail += g.res[i];
		}
		g.res[start_idx] = sum_tail;
		g.n = start_idx + 1;
		out.i = sum_tail;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "merged suffix ", out.i);
	out
}
@end
