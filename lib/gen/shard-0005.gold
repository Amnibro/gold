fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${limit};
	var count = 0;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let gap = core_abs_val(g.res[i + 1] - g.res[i]);
			if gap <= max_gap { count++; }
		}
	}
	out.i = count;
	gold_push(g, count);
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "gaps up to limit ", count);
	out
}
