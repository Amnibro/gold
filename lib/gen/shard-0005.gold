test: list=10,25,15,25,5
expect: => i=4 r=0.0 ok=true s="unique peak distances 4" errors=0 n=4 res=[15,0,10,20] cache=0 hits=0
test: list=30,10,20,30
expect: => i=3 r=0.0 ok=true s="unique peak distances 3" errors=0 n=3 res=[0,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
		i++;
	}
	var kept = 0;
	i = 0;
	while i < g.n {
		let diff = max_val - g.res[i];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == diff { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[kept] = diff;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "unique peak distances ", kept);
	out
}
@end
