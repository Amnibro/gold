expect: => i=-1 r=0.0 ok=false s="traced value with retry" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var found = false;
	var idx = -1;
	var attempts = 0;
	while attempts < max_r && !found {
		attempts++;
		for i in g.n {
			if g.res[i] == tgt {
				found = true;
				idx = i;
				break;
			}
		}
	}
	g.steps += attempts * g.n;
	out.i = idx;
	out.ok = found;
	out.s.clear();
	format(out.s, "traced value with retry");
	out
}
@end
