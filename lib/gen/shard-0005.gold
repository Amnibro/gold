fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} > g.n { g.n } else { ${k} };
	for i in 0..(limit / 2) {
		let opp = limit - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = tmp;
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "reversed head of ", limit, " items");
	out
}
@end
@entry 0e3aa5381bd805f6
kind: step
verb: pair
noun: limit
modifier: until
context: stats
phrase: pair adjacent observations up to limit {bound} until {cond} fails
phrase: combine neighbouring sample values bounded by {bound} until {cond} fails
slot: bound int
slot: cond pred
test: list=2,4,6,8,1 bound=10 cond=is_even
expect: => i=1 r=0.0 ok=true s="paired 1 observation sets" errors=0 n=5 res=[4,2,6,8,1] cache=0 hits=0
