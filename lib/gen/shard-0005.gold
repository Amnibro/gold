code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var max_streak = 0;
	var cur_streak = 0;
	var prev byte = 0 as byte;
	for i in out.s.len {
		if out.s[i] == prev {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
			prev = out.s[i];
		}
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	g.steps += out.s.len + 1;
	out.ok = max_streak >= ml;
	out.i = max_streak;
	out
}
@end
