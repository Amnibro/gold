fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	for k in g.n {
		if g.res[k] < 0 {
			valid = false;
			gold_fail(g, "negative item in nested list");
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked list nested: ", valid);
	out
}
@end
@entry ea6f0d5119177b44
kind: step
verb: scan
noun: value
modifier: until
context: retry
phrase: scan list until target value {target}
phrase: search sequence until reaching value {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="scanned value until: true" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20 target=99
expect: => i=2 r=0.0 ok=false s="scanned value until: false" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = 0;
	var found = false;
	while idx < g.n {
		if g.res[idx] == tgt {
			found = true;
			break;
		}
		idx++;
	}
	if !found {
		gold_fail(g, "target value not reached");
		out.ok = false;
	}
	g.steps += idx + 1;
	out.i = idx;
	out.s.clear();
	format(out.s, "scanned value until: ", found);
	out
}
@end
