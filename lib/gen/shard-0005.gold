fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i] * f;
		g.res[i] = g.res[j] * f;
		g.res[j] = tmp;
	}
	if g.n % 2 != 0 {
		g.res[g.n / 2] *= f;
	}
	gold_cache_put(g, 0, g.res[0]);
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "swapped counter first ", g.res[0]);
	out
}
