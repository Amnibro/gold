@entry 007eb08d64b9e5da
kind: step
verb: trace
noun: primes
modifier: at_most
context: retry
phrase: trace primes at most count {count}
phrase: find trace primes at most {count} values
slot: count int
test: count=3
expect: => i=3 r=0.0 ok=true s="traced 3 primes" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: count=5
expect: => i=5 r=0.0 ok=true s="traced 5 primes" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	var num = 2;
	var found = 0;
	while found < target {
		var is_p = true;
		var d = 2;
		while d * d <= num {
			if num % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			gold_push(g, num);
			found++;
		}
		num++;
	}
	out.i = found;
	out.s.clear();
	format(out.s, "traced ", found, " primes");
	out
}
@end
