fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n < 2 { return out; }
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	if min_idx <= limit && min_idx > 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[min_idx];
		g.res[min_idx] = tmp;
	}
	out.i = min_idx;
	out.s.clear();
	format(out.s, "swapped minimum at index ", min_idx);
	out
}
