code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		var first = true;
		for j in k {
			if g.res[j] == g.res[k] { first = false; }
		}
		if first {
			g.res[k] = ${step_fn}(g.res[k]);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "applied function to ", count, " unique items");
	out
}
@end
