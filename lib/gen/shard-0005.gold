fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let avg = (g.res[i] + g.res[i + 1]) / 2;
			diff_sum += avg;
		}
	}
	g.steps += g.n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "compare average pairwise");
	out
}
