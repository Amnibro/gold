expect: => i=3 r=0.0 ok=true s="histogram bins: 3" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=0
test: list=5,5,10
expect: => i=2 r=0.0 ok=true s="histogram bins: 2" errors=0 n=3 res=[5,5,10] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bins = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
			}
		}
		if !seen {
			gold_cache_put(g, bins, g.res[i]);
			bins++;
		}
	}
	g.steps += g.n + 1;
	out.i = bins;
	out.s.clear();
	format(out.s, "histogram bins: ", bins);
	out
}
@end
