code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 0 && t > 0 {
		let min_val = g.res[0];
		for step in t {
			if g.n < 500 {
				gold_push(g, min_val);
			}
		}
	}
	g.steps += t;
	out.i = g.n;
	out.s.clear();
	format(out.s, "total elements ", g.n);
	out
}
@end
