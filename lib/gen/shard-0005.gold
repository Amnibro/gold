fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		if avg >= th {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	out.i = swaps;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "swapped ", swaps, " pairs");
	out
}
@end
