code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	for idx in 0..(min_idx / 2) {
		let tmp = g.res[idx];
		g.res[idx] = g.res[min_idx - 1 - idx];
		g.res[min_idx - 1 - idx] = tmp;
	}
	out.i = min_idx;
	out.s.clear();
	format(out.s, "reversed ", min_idx, " items before minimum");
	out
}
@end
