@entry 2f91a860aa511814
kind: step
verb: dedupe
noun: tally
modifier: until
context: stats
phrase: dedupe repeated numbers until tally reaches {limit}
phrase: prune duplicate items until count ceiling {limit}
slot: limit int
test: list=1,1,2,2,3,3,4 limit=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,3,4] cache=0 hits=0
test: list=5,5,5,6,6,7 limit=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[5,5,6,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dupes_removed = 0;
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var is_dup = false;
		for j in write_idx {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
		}
		if is_dup && dupes_removed < lim {
			dupes_removed++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = dupes_removed;
	out
}
@end
