fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		gold_push(g, sum);
		pairs++;
		i += 2;
	}
	if pairs == 0 && g.n > 0 {
		gold_push(g, g.res[0] * 2);
		pairs = 1;
	}
	out.i = pairs;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "grouped ", pairs, " checkpoints");
	out
}
