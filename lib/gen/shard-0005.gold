fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var matched = 0;
	var failed = 0;
	for k in g.n {
		if ${p}(g.res[k]) {
			matched++;
		} else {
			failed++;
			if failed > r { break; }
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched items ", matched);
	out
}
