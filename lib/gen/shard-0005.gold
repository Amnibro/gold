fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var odds int[512] = [0; 512];
	var on = 0;
	for k in g.n {
		if core_is_odd(g.res[k]) && on < lim {
			odds[on] = g.res[k];
			on++;
		}
	}
	out.s.clear();
	format(out.s, "rev_odds: [");
	var k = on;
	var printed = 0;
	while k > 0 {
		k--;
		if printed > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, odds[k]);
		printed++;
	}
	format(out.s, "]");
	g.steps += g.n + on;
	out.i = on;
	out
}
@end
