slot: span int
test: list=1,4,10,12 span=5
expect: => i=2 r=0.0 ok=true s="selected spaces between" errors=0 n=4 res=[1,4,10,12] cache=0 hits=0
test: list=10,20,25 span=8
expect: => i=1 r=0.0 ok=true s="selected spaces between" errors=0 n=3 res=[10,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var count = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = abs(g.res[i + 1] - g.res[i]);
			if diff <= sp { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "selected spaces between");
	out
}
@end
