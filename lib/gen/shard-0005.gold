@entry dba75c9afa07ad14
kind: step
verb: rotate
noun: limit
modifier: running
context: sort
phrase: rotate limit running values exceeding {max_val}
phrase: shift values past limit {max_val} in sorted array
slot: max_val int
test: list=2,4,6,8,10 max_val=5
expect: => i=3 r=0.0 ok=true s="rotated count 3" errors=0 n=5 res=[8,10,2,4,6] cache=0 hits=0
test: list=1,3,5,7 max_val=4
expect: => i=2 r=0.0 ok=true s="rotated count 2" errors=0 n=4 res=[5,7,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_val};
	var count = 0;
	for k in g.n {
		if g.res[k] > lim { count++; }
	}
	if g.n > 0 && count > 0 {
		for step in (count % g.n) {
			let first = g.res[0];
			for i in (g.n - 1) {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated count ", count);
	out
}
@end
