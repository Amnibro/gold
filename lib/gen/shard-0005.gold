kind: step
verb: shift
noun: list
modifier: sorted
context: search
phrase: shift sorted search list entries by {delta}
phrase: offset sorted candidate list values by {delta}
slot: delta int
test: list=30,10,20 delta=5
expect: => i=3 r=0.0 ok=true s="shifted sorted list by 5" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=8,2,5 delta=-2
expect: => i=3 r=0.0 ok=true s="shifted sorted list by -2" errors=0 n=3 res=[0,3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	let offset = ${delta};
	for i in g.n { g.res[i] += offset; }
	out.i = g.n;
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "shifted sorted list by ", offset);
	out
}
@end
