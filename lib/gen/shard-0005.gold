fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	var changed = 0;
	for k in bound {
		if g.res[k] < c {
			g.res[k] = c;
			changed++;
		}
	}
	g.steps += bound;
	out.i = changed;
	out.s.clear();
	format(out.s, "applied minimum to ", changed, " items");
	out
}
@end
@entry a02fec2ad5b2392c
kind: step
verb: drop
noun: history
modifier: with_retry
context: transform
phrase: drop history items with retry limit {max_tries}
phrase: discard history entries using retry bound {max_tries}
slot: max_tries int
test: list=10,20,30,40 max_tries=2
expect: => i=2 r=0.0 ok=true s="dropped 2 history items" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15,25 max_tries=5
expect: => i=3 r=0.0 ok=true s="dropped 3 history items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tries = ${max_tries};
	if tries <= 0 {
		gold_fail(g, "retry limit must be positive");
		out.ok = false;
		return out;
	}
	let drop_count = if tries < g.n { tries } else { g.n };
	let remain = g.n - drop_count;
	for k in remain {
		g.res[k] = g.res[k + drop_count];
	}
	g.n = remain;
	g.steps += drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " history items");
	out
}
@end
@entry f79939c10d8d7034
kind: step
verb: group
noun: sequence
modifier: at_least
context: transform
phrase: group sequence runs of length at least {min_size}
phrase: aggregate sequence blocks having at least {min_size} elements
slot: min_size int
test: list=1,1,1,2,3,3 min_size=2
expect: => i=2 r=0.0 ok=true s="grouped 2 sequence runs" errors=0 n=4 res=[1,3,3,2] cache=0 hits=0
test: list=4,4,5,6,6,6,6 min_size=3
expect: => i=1 r=0.0 ok=true s="grouped 1 sequence runs" errors=0 n=2 res=[6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_size};
	if g.n == 0 || min_len <= 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= min_len {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = run_len;
			kept += 2;
		}
		i = j;
	}
	g.n = kept;
	g.steps += i;
	out.i = kept / 2;
	out.s.clear();
	format(out.s, "grouped ", kept / 2, " sequence runs");
	out
}
@end
