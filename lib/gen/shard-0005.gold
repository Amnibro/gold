fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_len};
	if out.s.len >= lim {
		for i in 0..(out.s.len / 2) {
			let opp = out.s.len - 1 - i;
			let tmp = out.s[i];
			out.s[i] = out.s[opp];
			out.s[opp] = tmp;
		}
		out.i = out.s.len;
	} else {
		gold_fail(g, "length below minimum");
		out.ok = false;
	}
	out
}
