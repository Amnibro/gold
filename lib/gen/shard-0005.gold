phrase: pairwise adjacent digit differences total
test: arg=1528
expect: 13
test: arg=9876
expect: 3
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var total = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		total += diff;
		prev = cur;
		x /= 10;
	}
	total
}
@end
