test: list=10,20,35,55 scale=2
expect: => i=2 r=0.0 ok=true s="cached 2 alternate gaps" errors=0 n=4 res=[10,20,35,55] cache=2 hits=0
test: list=5,15,30,60,100 scale=3
expect: => i=2 r=0.0 ok=true s="cached 2 alternate gaps" errors=0 n=5 res=[5,15,30,60,100] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var count = 0;
	if g.n >= 2 {
		var i = 0;
		while i + 1 < g.n {
			let gap = (g.res[i + 1] - g.res[i]) * sc;
			gold_cache_put(g, count, gap);
			count++;
			i += 2;
		}
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " alternate gaps");
	out
}
@end
