kind: step
verb: group
noun: steps
modifier: nested
context: core
phrase: group steps into nested batches of {size}
phrase: partition steps using nested bucket size {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=3 r=0.0 ok=true s="grouped steps nested" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30 size=2
expect: => i=2 r=0.0 ok=true s="grouped steps nested" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		let lim = if i + sz < g.n { i + sz } else { g.n };
		for k in i..lim { sum += g.res[k]; }
		g.res[new_n] = sum;
		new_n++;
		i += sz;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped steps nested");
	out
}
@end
