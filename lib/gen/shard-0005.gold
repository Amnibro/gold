fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let f = ${factor};
	let take = if c > g.n { g.n } else { c };
	let start = g.n - take;
	for k in start..g.n {
		g.res[k] *= f;
	}
	out.i = take;
	out.s.clear();
	format(out.s, "scaled ", take, " trailing items");
