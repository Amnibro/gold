code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x >= lo && x <= hi {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "collect evens between");
	out
}
@end
