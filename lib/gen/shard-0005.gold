	let sz = ${win_size};
	if sz <= 0 { return out; }
	var write_pos = 0;
	var read_pos = 0;
	while read_pos < g.n {
		var w_sum = 0;
		var count = 0;
		while count < sz && read_pos < g.n {
			w_sum += g.res[read_pos];
			count++;
			read_pos++;
		}
		g.res[write_pos] = w_sum;
		write_pos++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "condensed ", write_pos, " windows");
	out
}
@end
