@entry 5440c90956267bbb
kind: step
verb: fill
noun: streak
modifier: in_place
context: transform
phrase: fill streak in place with replacement {fill_val}
phrase: overwrite streak in place using {fill_val}
slot: fill_val int
test: list=1,1,1,2,3 fill_val=9
expect: => i=3 r=0.0 ok=true s="filled streak of length 3" errors=0 n=5 res=[9,9,9,2,3] cache=0 hits=0
test: list=4,5,5,5,5 fill_val=0
expect: => i=4 r=0.0 ok=true s="filled streak of length 4" errors=0 n=5 res=[4,0,0,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${fill_val};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var max_streak = 0;
	var best_start = 0;
	var cur_start = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			if cur_len > max_streak {
				max_streak = cur_len;
				best_start = cur_start;
			}
			cur_start = k;
			cur_len = 1;
		}
	}
	if cur_len > max_streak {
		max_streak = cur_len;
		best_start = cur_start;
	}
	if max_streak > 1 {
		for k in best_start..(best_start + max_streak) {
			g.res[k] = rep;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "filled streak of length ", max_streak);
	out
}
@end
