code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < out.s.len {
		let diff = core_abs_val((out.s[idx] as int) - (out.s[idx + 1] as int));
		out.s[write_pos] = ('0' as int + (diff % 10)) as byte;
		write_pos++;
		idx += 2;
	}
	if idx < out.s.len {
		out.s[write_pos] = out.s[idx];
		write_pos++;
	}
	out.s.resize(write_pos, 0 as byte);
	out.i = write_pos;
	out
}
@end
