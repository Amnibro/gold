code:
fn ${ID}(g Gold&, v Val) Val {
	let reps = ${times};
	var out = v;
	if g.n < 2 { return out; }
	var k = 0;
	while k < reps && k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		gold_cache_put(g, k, diff);
		k++;
	}
	g.steps += k;
	out.s.clear();
	format(out.s, "cached ", k, " gaps");
	out
}
@end
