expect: => i=15 r=0.0 ok=true s="shifted running step 15" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n >= 2 {
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1] - g.res[i] + off;
		}
		g.n--;
	}
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "shifted running step ", g.res[0]);
	out
}
@end
