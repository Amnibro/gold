noun: duplicates
modifier: running
context: retry
phrase: merge running duplicates in retry items
phrase: combine consecutive duplicate retry values
test: list=2,2,3,4,4,4
expect: => i=0 r=0.0 ok=true s="merged into 4 items" errors=0 n=4 res=[4,3,8,4] cache=0 hits=0
test: list=5,5,10
expect: => i=0 r=0.0 ok=true s="merged into 1 items" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var write_idx = 0;
	var read_idx = 0;
	while read_idx < g.n {
		var val = g.res[read_idx];
		var next_idx = read_idx + 1;
		while next_idx < g.n && g.res[next_idx] == val {
			val += g.res[next_idx];
			next_idx++;
		}
		g.res[write_idx] = val;
		write_idx++;
		read_idx = next_idx;
	}
	g.steps += g.n;
	g.n = write_idx;
	out.s.clear();
	format(out.s, "merged into ", write_idx, " items");
	out
}
@end
