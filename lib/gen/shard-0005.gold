code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_count = 0;
	var even_count = 0;
	for idx in g.n {
		let x = g.res[idx];
		let is_odd = (x % 2 != 0);
		if is_odd {
			odd_count++;
			gold_cache_put(g, x, 1);
		} else {
			even_count++;
			gold_cache_put(g, x, 0);
		}
	}
	out.i = odd_count - even_count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "odds compared to evens balance ", out.i);
	out
}
@end
