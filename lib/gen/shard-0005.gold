noun: value
modifier: with_cache
context: loop
phrase: scan value with cache for key {target}
phrase: probe cache lookup for value {target}
slot: target int
test: list=7,8,7,9 target=7
expect: => i=2 r=0.0 ok=true s="cache miss computed" errors=0 n=4 res=[7,8,7,9] cache=1 hits=0
test: list=1,2,3 target=99
expect: => i=0 r=0.0 ok=true s="cache miss computed" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached, hit = gold_cache_get(g, tgt);
	if hit {
		out.i = cached;
		out.s.clear();
		out.s.append("cache hit");
	} else {
		var sum = 0;
		for k in g.n { if g.res[k] == tgt { sum += 1; } }
		gold_cache_put(g, tgt, sum);
		out.i = sum;
		out.s.clear();
		out.s.append("cache miss computed");
	}
	g.steps += 1;
	out
}
@end
