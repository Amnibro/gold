@entry 7c64a200272eebcd
kind: step
verb: select
noun: condition
modifier: last
context: stats
phrase: select last {count} observations matching condition {cond}
phrase: keep trailing {count} sample values satisfying {cond}
slot: count int
slot: cond pred
test: list=1,2,3,4,5,6 count=2 cond=is_even
expect: => i=2 r=0.0 ok=true s="selected 2 trailing observations" errors=0 n=2 res=[4,6] cache=0 hits=0
test: list=10,12,14 count=1 cond=is_even
expect: => i=1 r=0.0 ok=true s="selected 1 trailing observations" errors=0 n=1 res=[14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${count};
	var matched int[512] = [0; 512];
	var m_count = 0;
	for k in g.n {
		if ${cond}(g.res[k]) {
			matched[m_count] = g.res[k];
			m_count++;
		}
	}
	let take = if lim > m_count { m_count } else { lim };
	let start = m_count - take;
	for k in take {
		g.res[k] = matched[start + k];
	}
	g.n = take;
	out.i = take;
	out.s.clear();
	format(out.s, "selected ", take, " trailing observations");
	out
}
@end
