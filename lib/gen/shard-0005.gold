code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_diff = 0;
	for k in 1..g.n {
		let diff = if g.res[k] >= g.res[k - 1] { g.res[k] - g.res[k - 1] } else { g.res[k - 1] - g.res[k] };
		if diff > max_diff { max_diff = diff; }
	}
	if max_diff > 50 {
		gold_fail(g, "excessive pairwise jump");
	}
	g.steps += g.n;
	out.i = max_diff;
