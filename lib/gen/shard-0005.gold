fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_pairs};
	var sum = 0;
	var count = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n && count < limit {
			sum += g.res[i] + g.res[i + 1];
			count++;
			i++;
		}
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "pairs sum: ", sum);
	out
}
