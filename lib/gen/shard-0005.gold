expect: => i=4 r=0.0 ok=true s="dropped unique kept 4 duplicates" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=10,10,20,30,30,40
expect: => i=4 r=0.0 ok=true s="dropped unique kept 4 duplicates" errors=0 n=4 res=[10,10,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if count > 1 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "dropped unique kept ", kept, " duplicates");
	out
}
@end
