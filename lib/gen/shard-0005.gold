expect: => i=3 r=0.0 ok=true s="scaled prefix 3" errors=0 n=3 res=[50,50,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for idx in g.n {
		var seen = false;
		for prev in idx {
			if g.res[prev] == g.res[idx] { seen = true; }
		}
		if !seen {
			g.res[idx] = g.res[idx] * f;
			scaled++;
		}
	}
	out.i = scaled;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "scaled prefix ", scaled);
	out
}
@end
