code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var stored = 0;
	var start = g.n - c;
	if start < 0 {
		start = 0;
	}
	for i in start..g.n {
		gold_cache_put(g, i, g.res[i]);
		stored++;
	}
	g.steps += stored + 1;
	out.i = stored;
	out.s.clear();
	format(out.s, "cache runs last");
	out
}
@end
