code:
fn ${ID}(g Gold&, v Val) Val {
	let count = ${k};
	var out = v;
	let limit = if count < g.n { count } else { g.n };
	var head_sum = 0;
	for i in limit {
		head_sum += g.res[i];
	}
	out.i = head_sum;
	g.steps += limit;
	out.s.clear();
	format(out.s, "head sum evaluated safely ", head_sum);
	out
}
@end
