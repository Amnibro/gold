code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		if g.res[k] == tgt {
			dropped++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " occurrences of value");
	out
}
@end
