@entry 7565c5ecc63e174f
kind: step
verb: scale
noun: average
modifier: with_retry
context: retry
phrase: scale average value with retry limit {max_retries}
phrase: multiply mean metric with retry budget {max_retries}
slot: max_retries int
test: list=10,20,30 max_retries=2
expect: => i=40 r=0.0 ok=true s="scaled average with retry: 40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20,30 max_retries=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	if mr <= 0 || g.n == 0 {
		gold_fail(g, "invalid retry budget or empty list");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	let res = avg * mr;
	gold_push(g, res);
	g.steps += g.n + mr;
	out.i = res;
	out.s.clear();
	format(out.s, "scaled average with retry: ", res);
	out
}
@end
