	if x < 10 { return x; }
	var counts int[10] = [0; 10];
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var res = 0;
	for d in 10 {
		if d % 2 == 0 {
			var c = counts[d];
			while c > 0 { res = res * 10 + d; c--; }
		}
	}
	for d in 10 {
		if d % 2 != 0 {
