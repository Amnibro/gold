@entry 329159f7a27dd41a
kind: step
verb: merge
noun: suffix
modifier: unique
context: retry
phrase: merge unique items in suffix after retry
phrase: combine unique suffix elements across retry pass
test: list=1,2,2,3
expect: => i=4 r=0.0 ok=true s="merged suffix unique: 4" errors=0 n=5 res=[1,2,2,3,4] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=false s="merged suffix unique: 0" errors=1 n=4 res=[5,5,5,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var occurrences = 0;
		for j in g.n {
			if g.res[j] == x { occurrences++; }
		}
		if occurrences == 1 {
			sum += x;
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no unique suffix elements");
		out.ok = false;
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged suffix unique: ", sum);
	out
}
@end
@entry 64f232dc94db5aea
kind: step
verb: reverse
noun: duplicates
modifier: with_retry
context: retry
phrase: reverse duplicate entries with retry limit {max_retries}
phrase: invert duplicate values with retry budget {max_retries}
slot: max_retries int
test: list=1,2,2,3,3,4 max_retries=2
expect: => i=2 r=0.0 ok=true s="reversed duplicates with retry: 2" errors=0 n=6 res=[1,2,2,3,3,4] cache=0 hits=0
test: list=1,2,3 max_retries=1
expect: => i=0 r=0.0 ok=false s="reversed duplicates with retry: 0" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	var dups = 0;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] == g.res[j] { dups++; break; }
			}
		}
	}
	if dups == 0 {
		gold_fail(g, "no duplicates found to reverse");
		out.ok = false;
	}
	g.steps += dups * mr;
	out.i = dups;
	out.s.clear();
	format(out.s, "reversed duplicates with retry: ", dups);
	out
}
@end
