@entry aac735461ab2df51
kind: step
verb: pair
noun: tail
modifier: recursively
context: math
phrase: pair tail recursively folding depth {depth}
phrase: combine tail elements recursively using {depth}
slot: depth int
test: list=1,2,3,4,5 depth=2
expect: => i=2 r=0.0 ok=true s="folded pairs 2" errors=0 n=3 res=[1,2,12] cache=0 hits=0
test: list=10,20,30 depth=1
expect: => i=1 r=0.0 ok=true s="folded pairs 1" errors=0 n=2 res=[10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var folds = 0;
	while g.n >= 2 && folds < d {
		let s = g.res[g.n - 1] + g.res[g.n - 2];
		g.res[g.n - 2] = s;
		g.n--;
		folds++;
	}
	g.steps += folds + 1;
	out.i = folds;
	out.s.clear();
	format(out.s, "folded pairs ", folds);
	out
}
@end
@entry e7b8244b6cb6af40
kind: step
verb: retry
noun: condition
modifier: nested
context: math
phrase: retry condition nested allowance {retries} matching {p}
phrase: check condition nested with retry count {retries} for {p}
slot: p pred
slot: retries int
test: list=1,3,4,5 p=is_even retries=2
expect: => i=1 r=0.0 ok=true s="retry condition matched true" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
test: list=1,3,5,7 p=is_even retries=1
expect: => i=0 r=0.0 ok=false s="retry condition matched false" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_limit = ${retries};
	var fails = 0;
	var matched = false;
	for i in g.n {
		if ${p}(g.res[i]) {
			matched = true;
			break;
		} else {
			fails++;
			if fails > r_limit { break; }
		}
	}
	g.steps += fails + 1;
	out.ok = matched;
	out.i = if matched { 1 } else { 0 };
	out.s.clear();
	format(out.s, "retry condition matched ", matched);
	out
}
@end
