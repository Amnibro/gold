		}
	}
	var new_n = 0;
	for i in idx..g.n {
		g.res[new_n] = g.res[i];
		new_n++;
	}
	g.n = new_n;
	out.i = new_n;
	g.steps += idx;
	out.s.clear();
	format(out.s, "dropped prefix remaining ", new_n);
	out
}
