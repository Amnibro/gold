code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var paired = 0;
	if g.n >= ml {
		var start = g.n - ml;
		while start + 1 < g.n {
			let sum = g.res[start] + g.res[start + 1];
			g.res[paired] = sum;
			paired++;
			start += 2;
		}
		g.n = paired;
	}
	out.i = paired;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "tail pairs ", paired);
	out
}
@end
