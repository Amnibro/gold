code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty results for min validation");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	out.s.clear();
	if min_val <= lim {
		out.i = min_val;
		format(out.s, "minimum within bound");
	} else {
		gold_fail(g, "minimum exceeds limit");
		out.ok = false;
		format(out.s, "limit exceeded");
	}
	out
}
@end
@entry 6d806c5892408362
kind: step
verb: merge
noun: odds
modifier: all
context: search
phrase: merge all odd search items into single sum
phrase: combine all odd candidates across results
test: list=1,2,3,4,5
expect: => i=9 r=0.0 ok=true s="merged odd sum: 9" errors=0 n=3 res=[9,2,4] cache=0 hits=0
test: list=10,21,30,41
expect: => i=62 r=0.0 ok=true s="merged odd sum: 62" errors=0 n=3 res=[62,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_sum = 0;
	var has_odd = false;
	var evens int[512] = [0; 512];
	var e_cnt = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odd_sum += g.res[k];
			has_odd = true;
		} else {
			evens[e_cnt] = g.res[k];
			e_cnt++;
		}
	}
	var write_pos = 0;
	if has_odd {
		g.res[write_pos] = odd_sum;
		write_pos++;
	}
	for k in e_cnt {
		g.res[write_pos] = evens[k];
		write_pos++;
	}
	g.n = write_pos;
	out.i = odd_sum;
	out.s.clear();
	format(out.s, "merged odd sum: ", odd_sum);
	out
}
@end
