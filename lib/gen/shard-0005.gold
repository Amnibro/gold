test: list=10,20,30 multiplier=2
expect: => i=2 r=0.0 ok=true s="retried 2 scaled pairs" errors=0 n=2 res=[60,100] cache=0 hits=0
test: list=5,15,25 multiplier=3
expect: => i=2 r=0.0 ok=true s="retried 2 scaled pairs" errors=0 n=2 res=[60,120] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	if g.n <= 1 { return out; }
	var new_res int[512] = [0; 512];
	let pairs = g.n - 1;
	for k in pairs {
		new_res[k] = (g.res[k] + g.res[k + 1]) * m;
	}
	for k in pairs { g.res[k] = new_res[k]; }
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "retried ", pairs, " scaled pairs");
	out
}
@end
