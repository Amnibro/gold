fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var valid_pairs = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff <= md { valid_pairs++; }
		}
	}
	g.steps += g.n + 1;
	out.i = valid_pairs;
	out.s.clear();
	format(out.s, "pairs within diff ", valid_pairs);
	out
}
@end
