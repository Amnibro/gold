code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_r = 1;
	var cur_r = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_r++;
			if cur_r > max_r { max_r = cur_r; }
		} else {
			cur_r = 1;
		}
	}
	out.i = max_r;
	out.s.clear();
	format(out.s, "longest run ", max_r);
	out
}
@end
