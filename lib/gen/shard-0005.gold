code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = -1;
	var count = 0;
	for k in g.n {
		if g.res[k] < 0 {
			if start < 0 { start = k; }
			if k == start + count { count++; }
		} else if count > 0 {
			break;
		}
	}
	if count > 0 {
		for i in count { g.res[i] = g.res[start + i]; }
		g.n = count;
		gold_fail(g, "error streak found");
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "streak length ", count);
	out
}
@end
