fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let d0 = g.res[1] - g.res[0];
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if d0 >= 0 && x >= 0 {
			g.res[kept] = x;
			kept++;
		} else if d0 < 0 && x < 0 {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "matched step sign count ", kept);
	out
}
@end
