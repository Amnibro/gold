code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var dropped = 0;
	while g.n > 0 && sum > b {
		sum -= g.res[g.n - 1];
		g.n--;
		dropped++;
	}
	gold_cache_put(g, 0, dropped);
	g.steps += dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped budget items ", dropped);
	out
}
@end
