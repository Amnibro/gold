fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in kept {
			if g.res[j] == x { count++; }
		}
		if count < limit {
