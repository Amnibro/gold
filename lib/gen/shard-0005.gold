code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	var sum = 0;
	for i in g.n {
		var d = g.res[i];
		if d < 0 { d = -d; }
		if m > 0 { d %= m; }
		g.res[i] = d;
		sum += d;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped digit bins sum ", sum);
	out
}
@end
