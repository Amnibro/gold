fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for k in g.n {
		var num = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		if num == 0 {
			total_digits += 1;
		} else {
			while num > 0 {
				total_digits += 1;
				num /= 10;
			}
		}
	}
	g.steps += g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "measured total digits ", total_digits);
	out
}
