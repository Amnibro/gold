fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_uniq = true;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq { break; }
	}
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	if is_uniq {
		format(out.s, "all items unique");
	} else {
		gold_fail(g, "duplicate element found");
		format(out.s, "duplicates present");
	}
	out
}
@end
@entry 5321e92a1be6a1d9
kind: step
verb: dedupe
noun: duplicates
modifier: times
context: stats
phrase: dedupe duplicates appearing times threshold {thresh}
phrase: remove elements repeated times frequency {thresh}
slot: thresh int
test: list=1,2,2,3,3,3 thresh=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,20,30,40 thresh=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n { if g.res[j] == g.res[i] { freq++; } }
		if freq >= t {
			var already = false;
			for k in write_idx { if g.res[k] == g.res[i] { already = true; break; } }
			if !already {
				g.res[write_idx] = g.res[i];
				write_idx++;
			} else {
				dropped++;
			}
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = dropped;
	out
}
@end
