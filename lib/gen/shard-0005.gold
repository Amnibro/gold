@entry 980946e858660e68
kind: step
verb: sort
noun: step
modifier: with_retry
context: math
phrase: sort step results with retry budget {retries}
phrase: order step list using retry attempts {retries}
slot: retries int
test: list=50,10,40,20 retries=2
expect: => i=4 r=0.0 ok=true s="sorted step with retry" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=9,3,7 retries=3
expect: => i=3 r=0.0 ok=true s="sorted step with retry" errors=0 n=3 res=[3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n * r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted step with retry");
	out
}
@end
