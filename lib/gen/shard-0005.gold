kind: step
verb: run
noun: range
modifier: between
context: stats
phrase: run range between bounds {low} to {high}
phrase: calculate sample range between {low} through {high}
slot: low int
slot: high int
test: list=10,25,40,15,80 low=10 high=50
expect: => i=30 r=0.0 ok=true s="range between 30" errors=0 n=5 res=[10,25,40,15,80] cache=0 hits=0
test: list=5,12,18,33,55 low=20 high=60
expect: => i=22 r=0.0 ok=true s="range between 22" errors=0 n=5 res=[5,12,18,33,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var min_val = 1000000;
	var max_val = -1000000;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if x < min_val { min_val = x; }
			if x > max_val { max_val = x; }
			count++;
		}
	}
	g.steps += g.n + 1;
	if count > 0 {
		out.i = max_val - min_val;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "range between ", out.i);
	out
}
@end
