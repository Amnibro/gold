expect: => i=0 r=0.0 ok=true s="compare checkpoint with retry" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 retries=3 target=40
expect: => i=0 r=0.0 ok=false s="compare checkpoint with retry" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	let tgt = ${target};
	var matched = false;
	var diff = 0;
	for attempt in r {
		for i in g.n {
			if g.res[i] == tgt {
				matched = true;
				diff = g.res[i] - tgt;
				break;
			}
		}
		if matched {
			break;
		}
	}
	g.steps += r + 1;
	out.ok = matched;
	out.i = diff;
	out.s.clear();
	format(out.s, "compare checkpoint with retry");
	out
}
@end
