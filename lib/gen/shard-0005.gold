fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = (total * sc) / g.n;
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "average scaled ", avg);
	out
}
@end
