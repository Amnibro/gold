@entry 060d87d12fc1852f
kind: step
verb: group
noun: digits
modifier: in_place
context: search
phrase: group digits in place using divisor {divisor}
phrase: bucket search digits in place by {divisor}
slot: divisor int
test: list=12,25,39 divisor=10
expect: => i=16 r=0.0 ok=true s="grouped search digits 16" errors=0 n=3 res=[2,5,9] cache=0 hits=0
test: list=14,28,42 divisor=7
expect: => i=0 r=0.0 ok=true s="grouped search digits 0" errors=0 n=3 res=[0,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	var sum = 0;
	for i in g.n {
		var rem = g.res[i];
		if rem < 0 { rem = -rem; }
		if d > 0 { rem %= d; }
		g.res[i] = rem;
		sum += rem;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped search digits ", sum);
	out
}
@end
