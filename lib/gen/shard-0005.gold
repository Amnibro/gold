@entry 4b170befc5b3e859
kind: step
verb: dedupe
noun: step
modifier: with_cache
context: math
phrase: dedupe step execution using cache lookup
phrase: avoid duplicate step execution with cache
test: list=1,2,1,3,2
expect: => i=2 r=0.0 ok=true s="deduped step with cache" errors=0 n=3 res=[1,2,3] cache=3 hits=2
test: list=4,4,5,6
expect: => i=1 r=0.0 ok=true s="deduped step with cache" errors=0 n=3 res=[4,5,6] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for i in g.n {
		let val, hit = gold_cache_get(g, g.res[i]);
		if !hit {
			gold_cache_put(g, g.res[i], 1);
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	let dropped = g.n - new_n;
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped step with cache");
	out
}
@end
