code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var pairs = g.n / 2;
	var kept = 0;
	var p = 0;
	while p < pairs {
		g.res[kept] = g.res[p * 2];
		g.res[kept + 1] = g.res[p * 2 + 1];
		kept += 2;
		p += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept / 2;
	out.s.clear();
	format(out.s, "grouped ", kept / 2, " alternating pairs");
	out
}
@end
