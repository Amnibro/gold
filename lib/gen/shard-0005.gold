@entry 6e5f3524e9ba4cdc
kind: step
verb: clamp
noun: average
modifier: until
context: text
phrase: clamp character values until average reaches {target}
phrase: reduce character codes until target average {target}
slot: target int
test: text="zzzzz" target=110
expect: => i=5 r=0.0 ok=true s="nnnnn" errors=0 n=0 res=[] cache=0 hits=0
test: text="world" target=100
expect: => i=4 r=0.0 ok=true s="ddddd" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_avg = ${target};
	var clamped = 0;
	if out.s.len > 0 {
		var sum = 0;
		for c in out.s { sum += c as int; }
		var i = 0;
		while (sum / out.s.len) > target_avg && i < out.s.len {
			let cur = out.s[i] as int;
			if cur > target_avg {
				let diff = cur - target_avg;
				out.s[i] = target_avg as byte;
				sum -= diff;
				clamped++;
			}
			i++;
		}
	}
	g.steps += out.s.len;
	out.i = clamped;
	out
}
@end
