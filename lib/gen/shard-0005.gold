fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (g.n - 1) {
			if core_is_prime(g.res[j]) && core_is_prime(g.res[j + 1]) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked primes");
	out
}
@end
