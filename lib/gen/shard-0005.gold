fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cnt, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cnt + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	for k in g.n {
		let cnt, _ = gold_cache_get(g, g.res[k]);
		g.res[k] = cnt;
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "merged with cache unique=", g.cn);
	out
}
@end
