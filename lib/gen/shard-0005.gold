code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		let val = ${f}(g.res[i]);
		var seen = false;
		for j in i {
			if ${f}(g.res[j]) == val { seen = true; }
		}
		if !seen { unique_count++; }
	}
	g.steps += g.n * 2;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique subfunction ", unique_count);
	out
}
@end
