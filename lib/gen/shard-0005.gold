@entry 6a067bd0a9955127
kind: step
verb: rotate
noun: suffix
modifier: every_other
context: stats
phrase: rotate alternating elements in list suffix {tail_len}
phrase: shift every other element in suffix {tail_len}
slot: tail_len int
test: list=1,2,3,4,5,6 tail_len=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=6 res=[1,2,5,4,3,6] cache=0 hits=0
test: list=10,20,30,40,50 tail_len=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${tail_len};
	let count = if t < g.n { t } else { g.n };
	let start = g.n - count;
	var pos int[100] = [0; 100];
	var pn = 0;
	var i = start;
	while i < g.n {
		pos[pn] = i;
		pn++;
		i += 2;
	}
	if pn > 1 {
		let last = g.res[pos[pn - 1]];
		var j = pn - 1;
		while j > 0 {
			g.res[pos[j]] = g.res[pos[j - 1]];
			j--;
		}
		g.res[pos[0]] = last;
	}
	g.steps += pn;
	out.i = pn;
	out
}
@end
@entry ff1dd8294c6267fe
kind: step
verb: clamp
noun: average
modifier: all
context: stats
phrase: clamp all list values to average deviation {dev}
phrase: restrict all elements within average spread {dev}
slot: dev int
test: list=10,20,30,40 dev=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[20,20,30,30] cache=0 hits=0
test: list=100,200,300 dev=50
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[150,200,250] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${dev};
	var clamped = 0;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		let low = avg - d;
		let high = avg + d;
		for i in g.n {
			if g.res[i] < low {
				g.res[i] = low;
				clamped++;
			} else if g.res[i] > high {
				g.res[i] = high;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out
}
@end
