fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	gold_push(g, out.i);
	while !${stop}(out.i) {
		out.i = ${f}(out.i);
		gold_push(g, out.i);
		k++;
		if k >= 500 {
			gold_fail(g, "run subfunction until: limit exceeded");
			out.ok = false;
			return out;
		}
	}
	g.steps += k;
	out.s.clear();
	format(out.s, "ran ", k, " steps");
	out
}
@end
