fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == val { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "distinct history count ", kept);
	out
}
@end
