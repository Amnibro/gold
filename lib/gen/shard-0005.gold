phrase: shift text numeric characters safely {shift} times
slot: shift int
test: text="item1234end" shift=2
expect: => i=4 r=0.0 ok=true s="item3412end" errors=0 n=0 res=[] cache=0 hits=0
test: text="a89b" shift=1
expect: => i=2 r=0.0 ok=true s="a98b" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits byte[200] = [0; 200];
	var pos int[200] = [0; 200];
	var dn = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			digits[dn] = c;
			pos[dn] = i;
			dn++;
		}
	}
	if dn > 1 {
		var s = ${shift} % dn;
		if s < 0 { s += dn; }
		for i in dn {
			let src = (i - s + dn) % dn;
			out.s[pos[i]] = digits[src];
		}
	}
	g.steps += out.s.len;
	out.i = dn;
	out
}
@end
