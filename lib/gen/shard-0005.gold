@entry da6f09fa15196f92
kind: step
verb: rotate
noun: duplicates
modifier: up_to
context: text
phrase: rotate duplicate characters up to limit {cap}
phrase: cycle repeated letters bounded up to {cap}
slot: cap int
test: text="bookkeeper" cap=2
expect: => i=7 r=0.0 ok=true s="beeookkper" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana" cap=1
expect: => i=5 r=0.0 ok=true s="baanan" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[256] = [0; 256];
	for c in out.s { counts[c as int]++; }
	var dup_pos int[200] = [0; 200];
	var dn = 0;
	for i in out.s.len {
		if counts[out.s[i] as int] > 1 {
			dup_pos[dn] = i;
			dn++;
		}
	}
	if dn > 1 {
		let shift = ${cap} % dn;
		var saved byte[200] = [0; 200];
		for i in dn { saved[i] = out.s[dup_pos[i]]; }
		for i in dn {
			let src = (i - shift + dn) % dn;
			out.s[dup_pos[i]] = saved[src];
		}
	}
	g.steps += out.s.len;
	out.i = dn;
	out
}
@end
