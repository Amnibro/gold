@entry ec9d787018d958ef
kind: step
verb: group
noun: window
modifier: times
context: search
phrase: group window times with size {size}
phrase: aggregate search window times in blocks of {size}
slot: size int
test: list=2,4,6,8,10 size=2
expect: => i=6 r=0.0 ok=true s="grouped window blocks 3" errors=0 n=3 res=[6,14,10] cache=0 hits=0
test: list=1,3,5,7,9,11 size=3
expect: => i=9 r=0.0 ok=true s="grouped window blocks 2" errors=0 n=2 res=[9,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = i;
		while j < g.n && j < i + sz {
			sum += g.res[j];
			j++;
		}
		g.res[new_n] = sum;
		new_n++;
		i += sz;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "grouped window blocks ", new_n);
	out
}
@end
