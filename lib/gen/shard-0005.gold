fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let temp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = temp;
		left++;
		right--;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reversed ", g.n, " items");
	out
}
