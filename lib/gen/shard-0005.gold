fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	let first = g.res[0];
	for i in (g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = first;
	out.s.clear();
	format(out.s, "shifted first sequence item");
	out
}
@end
