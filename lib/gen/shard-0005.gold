expect: 23
code:
fn ${ID}(n int) int {
	let limit = ${threshold};
	var x = if n < 0 { -n } else { n };
	var steps = 0;
	while x > limit && steps < 50 {
		var s = 0;
		while x > 0 {
			let d = x % 10;
			s += d * d;
			x /= 10;
		}
		x = s;
		steps++;
	}
	x
}
@end
