@entry 2f0603da7d1ae912
kind: step
verb: pair
noun: memo
modifier: between
context: aggregate
phrase: pair memo values between bounds {low} to {high}
phrase: aggregate cached pairs in range {low} to {high}
slot: low int
slot: high int
test: list=10,15,20,25 low=12 high=22
expect: => i=1 r=0.0 ok=true s="paired memo between bounds count 1" errors=0 n=1 res=[35] cache=1 hits=0
test: list=2,4,6,8 low=3 high=9
expect: => i=1 r=0.0 ok=true s="paired memo between bounds count 1" errors=0 n=1 res=[10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_bound = ${low};
	let max_bound = ${high};
	var filtered_n = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= min_bound && x <= max_bound {
			g.res[filtered_n] = x;
			filtered_n++;
		}
	}
	var pairs_count = 0;
	var idx = 0;
	while idx + 1 < filtered_n {
		let sum_pair = g.res[idx] + g.res[idx + 1];
		gold_cache_put(g, idx, sum_pair);
		g.res[pairs_count] = sum_pair;
		pairs_count++;
		idx += 2;
	}
	g.n = pairs_count;
	g.steps += filtered_n;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "paired memo between bounds count ", pairs_count);
	out
}
@end
