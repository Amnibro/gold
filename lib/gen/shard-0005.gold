kind: step
verb: check
noun: average
modifier: until
context: loop
phrase: check average until target {target}
phrase: monitor average until reaching {target}
slot: target int
test: list=10,20,30,40 target=25
expect: => i=4 r=0.0 ok=true s="target not reached" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,4,6 target=100
expect: => i=3 r=0.0 ok=true s="target not reached" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var count = 0;
	var reached = false;
	while count < g.n {
		sum += g.res[count];
		count++;
		let avg = sum / count;
		if avg >= tgt {
			reached = true;
			break;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out.s.clear();
	if reached {
		format(out.s, "target reached in ", count, " items");
	} else {
		out.s.append("target not reached");
	}
	out
}
@end
