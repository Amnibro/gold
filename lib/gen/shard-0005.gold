fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp > 1 && sp <= out.s.len {
		let first = out.s[0];
		for i in (sp - 1) {
			out.s[i] = out.s[i + 1];
		}
		out.s[sp - 1] = first;
	}
	g.steps += sp + 1;
	out.i = sp;
	out
}
