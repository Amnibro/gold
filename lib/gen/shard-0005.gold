code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if out.i <= lim {
		gold_push(g, out.i);
		out.s.clear();
		format(out.s, "value within limit");
	} else {
		gold_fail(g, "value exceeded retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "limit reached");
	}
	out
}
@end
