phrase: accumulate history backwards in steps {step_size}
slot: step_size int
test: list=1,2,3,4,5,6 step_size=2
expect: => i=21 r=0.0 ok=true s="reverse merged history 21" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,20,30 step_size=3
expect: => i=60 r=0.0 ok=true s="reverse merged history 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ss = ${step_size};
	if ss <= 0 || g.n == 0 { return out; }
	var merged_sum = 0;
	var idx = g.n;
	while idx > 0 {
		var chunk_sum = 0;
		var c = 0;
		while c < ss && idx > 0 {
			idx--;
			chunk_sum += g.res[idx];
			c++;
		}
		merged_sum += chunk_sum;
	}
	out.i = merged_sum;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reverse merged history ", merged_sum);
	out
}
@end
