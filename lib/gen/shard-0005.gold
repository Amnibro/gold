code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "not enough items for middle");
		out.ok = false;
		return out;
	}
	let start = g.n / 4;
	let end_idx = g.n - start;
	var count = 0;
	var sum_val = 0;
	var i = start;
	while i < end_idx {
		g.res[count] = g.res[i];
		sum_val += g.res[i];
		count++;
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = sum_val;
	out.s.clear();
	format(out.s, "selected ", count, " middle items total ", sum_val);
	out
}
@end
