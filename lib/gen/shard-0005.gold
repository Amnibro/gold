expect: => i=3 r=0.0 ok=true s="collected sorted 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	if g.n > 1 {
		for i in g.n {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n * 2 + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected sorted ", g.n);
	out
}
@end
