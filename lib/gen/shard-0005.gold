fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 { return out; }
	var kept byte[..200] = "";
	var last byte = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c != last {
			kept.push(c);
			last = c;
		}
	}
