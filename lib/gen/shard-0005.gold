@entry 40502b32cd03478f
kind: step
verb: dedupe
noun: streak
modifier: times
context: cache
phrase: dedupe streak times with threshold {limit}
phrase: compact repeated streak items by cache limit {limit}
slot: limit int
test: list=2,2,2,3,3,4 limit=2
expect: => i=5 r=0.0 ok=true s="deduped streak count 5" errors=0 n=5 res=[2,2,3,3,4] cache=1 hits=0
test: list=5,5,5,5,6,7 limit=1
expect: => i=3 r=0.0 ok=true s="deduped streak count 3" errors=0 n=3 res=[5,6,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var new_n = 0;
	var run_len = 0;
	for i in g.n {
		if i > 0 && g.res[i] == g.res[i - 1] {
			run_len++;
		} else {
			run_len = 1;
		}
		if run_len <= lim {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	gold_cache_put(g, 0, new_n);
	g.steps += g.n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped streak count ", new_n);
	out
}
@end
