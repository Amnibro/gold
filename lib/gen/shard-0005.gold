expect: => i=0 r=0.0 ok=true s="frequent values 0" errors=0 n=4 res=[5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_dups};
	var multi = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; }
		}
		if !seen_before {
			var occ = 0;
			for j in g.n {
				if g.res[j] == x { occ++; }
			}
			if occ > md { multi++; }
		}
	}
	g.steps += g.n * 2 + 1;
	out.i = multi;
	out.s.clear();
	format(out.s, "frequent values ", multi);
	out
}
@end
