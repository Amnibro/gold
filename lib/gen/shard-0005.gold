@entry e852ef288c35f2f3
kind: step
verb: normalize
noun: checkpoint
modifier: recursively
context: core
phrase: normalize checkpoint values recursively with divisor {divisor}
phrase: scale checkpoint items recursively using divisor {divisor}
slot: divisor int
test: list=16,32,64 divisor=2
expect: => i=15 r=0.0 ok=true s="normalized checkpoints recursively" errors=0 n=3 res=[1,1,1] cache=0 hits=0
test: list=27,81 divisor=3
expect: => i=7 r=0.0 ok=true s="normalized checkpoints recursively" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${divisor};
	if div <= 1 {
		gold_fail(g, "invalid divisor");
		out.ok = false;
		return out;
	}
	var ops = 0;
	for k in g.n {
		var x = g.res[k];
		while x > 1 && x % div == 0 {
			x /= div;
			ops++;
		}
		g.res[k] = x;
	}
	g.steps += ops;
	out.i = ops;
	out.s.clear();
	format(out.s, "normalized checkpoints recursively");
	out
}
@end
@entry 4e1186d6c3920623
kind: step
verb: sort
noun: squares
modifier: all
context: core
phrase: sort all items by square magnitude
phrase: order all numbers according to squares
test: list=-3,2,-1,4
expect: => i=4 r=0.0 ok=true s="sorted all squares" errors=0 n=4 res=[-1,2,-3,4] cache=0 hits=0
test: list=5,-2,0,1
expect: => i=4 r=0.0 ok=true s="sorted all squares" errors=0 n=4 res=[0,1,-2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			let sj = g.res[j] * g.res[j];
			let sm = g.res[min_idx] * g.res[min_idx];
			if sj < sm { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted all squares");
	out
}
@end
