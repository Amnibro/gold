noun: checkpoint
modifier: unique
context: math
phrase: return checkpoint count of unique elements
phrase: record checkpoint for distinct mathematical elements
test: list=1,2,2,3,4,4
expect: => i=4 r=0.0 ok=true s="returned unique checkpoint" errors=0 n=6 res=[1,2,2,3,4,4] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="returned unique checkpoint" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] { first = false; break; }
		}
		if first { uniq++; }
	}
	g.steps += g.n * g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "returned unique checkpoint");
	out
}
@end
@entry dab04f6d5cd6ae2d
kind: step
verb: find
noun: threshold
modifier: with_retry
context: math
phrase: find threshold {target} with retry allowance {tries}
phrase: search threshold {target} using retry budget {tries}
slot: target int
slot: tries int
test: list=10,20,30 target=20 tries=3
expect: => i=1 r=0.0 ok=true s="found threshold with retry" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,10 target=50 tries=2
expect: => i=-1 r=0.0 ok=false s="found threshold with retry" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_t = ${tries};
	var idx = -1;
	var attempt = 0;
	while attempt < max_t && idx < 0 {
		attempt++;
		for i in g.n {
			if g.res[i] >= tgt { idx = i; break; }
		}
	}
	g.steps += attempt * g.n;
	out.i = idx;
	out.ok = idx >= 0;
	out.s.clear();
	format(out.s, "found threshold with retry");
	out
}
@end
