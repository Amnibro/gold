slot: max_times int
test: list=10,50,20,80,90 threshold=40 max_times=2
expect: => i=3 r=0.0 ok=false s="found 3 over limit" errors=1 n=5 res=[10,50,20,80,90] cache=0 hits=0
test: list=5,10,15,20 threshold=50 max_times=1
expect: => i=0 r=0.0 ok=true s="found 0 over limit" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let allowed = ${max_times};
	var excess = 0;
	for k in g.n {
		if g.res[k] > th { excess++; }
	}
	if excess > allowed {
		gold_fail(g, "limit occurrence exceeded");
		out.ok = false;
	}
	out.i = excess;
	out.s.clear();
	format(out.s, "found ", excess, " over limit");
	out
}
@end
