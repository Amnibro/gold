expect: => i=7 r=0.0 ok=true s="filtered streaks: 7" errors=0 n=7 res=[5,5,5,7,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_len};
	var temp int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= thresh {
			for k in i..j {
				temp[tn] = g.res[k];
				tn++;
			}
		}
		i = j;
	}
	gold_clear(g);
	for k in tn { gold_push(g, temp[k]); }
	g.steps += g.n;
	out.i = tn;
	out.s.clear();
	format(out.s, "filtered streaks: ", tn);
	out
}
@end
