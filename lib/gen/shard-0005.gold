fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid = false;
	if g.n >= 2 {
		let diff = g.res[g.n - 1] - g.res[g.n - 2];
		let d = if diff < 0 { -diff } else { diff };
		valid = d <= mg;
		out.i = d;
	}
	out.ok = valid;
	g.steps += 1;
	out.s.clear();
	if valid {
		format(out.s, "last gap valid: ", out.i);
	} else {
		gold_fail(g, "last gap exceeded limit");
		format(out.s, "last gap invalid: ", out.i);
	}
	out
}
