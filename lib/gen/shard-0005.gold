@entry 030e38cfb9fd2e66
kind: step
verb: keep
noun: histogram
modifier: times
context: filter
phrase: keep histogram times frequent items
phrase: filter elements appearing multiple times
test: list=1,2,2,3,3,3,4
expect: => i=2 r=0.0 ok=true s="kept repeated histogram 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,6,5,7,8,7
expect: => i=2 r=0.0 ok=true s="kept repeated histogram 2" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let target = g.res[i];
		var freq = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == target { freq++; }
			j++;
		}
		if freq >= 2 {
			var already = false;
			var k = 0;
			while k < kept {
				if g.res[k] == target { already = true; break; }
				k++;
			}
			if !already {
				g.res[kept] = target;
				kept++;
			}
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "kept repeated histogram ", kept);
	out
}
@end
