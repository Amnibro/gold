expect: => i=40 r=0.0 ok=true s="clamped max 40" errors=0 n=3 res=[10,50,30] cache=0 hits=0
test: list=5,12,8 cap=20
expect: => i=12 r=0.0 ok=true s="clamped max 12" errors=0 n=3 res=[5,12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	if max_val > c { max_val = c; }
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "clamped max ", max_val);
	out
}
@end
