fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	for idx in 0..(g.n / 2) {
		let opp = g.n - 1 - idx;
		let tmp = g.res[idx];
		g.res[idx] = g.res[opp];
		g.res[opp] = tmp;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely reversed ", g.n, " cached elements");
	out
}
@end
