fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${limit};
	if cutoff <= 0 || g.n == 0 {
		gold_fail(g, "invalid cutoff index");
		out.ok = false;
		return out;
	}
	let end_point = if cutoff > g.n { g.n } else { cutoff };
	var merged_val = 0;
	for k in end_point {
		merged_val += g.res[k];
	}
	g.res[0] = merged_val;
	var write_pos = 1;
	for k in end_point..g.n {
		g.res[write_pos] = g.res[k];
		write_pos++;
	}
	g.n = write_pos;
	g.steps += g.n;
	out.i = merged_val;
	out.s.clear();
	format(out.s, "merged up to cutoff sum ", merged_val);
	out
}
@end
