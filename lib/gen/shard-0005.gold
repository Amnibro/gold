code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${k};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	var idx = 0;
	while idx < g.n && idx < lim {
		sum += g.res[idx];
		idx++;
	}
	g.steps += g.n + idx;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed minimum items ", sum);
	out
}
@end
