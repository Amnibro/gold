expect: => i=4 r=0.0 ok=true s="max streak 4" errors=0 n=6 res=[5,5,4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no streak");
		return out;
	}
	var max_s = 1;
	var cur_s = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_s++;
			if cur_s > max_s { max_s = cur_s; }
		} else {
			cur_s = 1;
		}
	}
	out.i = max_s;
	out.s.clear();
	format(out.s, "max streak ", max_s);
	out
}
@end
@entry 8882a8b16bfa975b
kind: step
verb: sort
noun: threshold
modifier: until
context: retry
phrase: sort threshold until limit {bound} reached
phrase: order threshold until maximum {bound} met
slot: bound int
test: list=5,1,4,2,8 bound=4
expect: => i=3 r=0.0 ok=true s="sorted items under bound count 3" errors=0 n=3 res=[1,2,4] cache=0 hits=0
test: list=9,7,3 bound=5
expect: => i=1 r=0.0 ok=true s="sorted items under bound count 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var kept = 0;
	for k in g.n {
		if g.res[k] <= b {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	var sorted = false;
	while !sorted {
		sorted = true;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				sorted = false;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted items under bound count ", g.n);
	out
}
@end
@entry 11a2be884d3e89c3
kind: step
verb: dedupe
noun: memo
modifier: until
context: retry
phrase: dedupe memo until target size {size}
phrase: compact memo until capacity {size}
slot: size int
test: list=1,1,2,2,3,3,4 size=2
expect: => i=2 r=0.0 ok=true s="deduped memo to size 2" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,5,6,6 size=1
expect: => i=1 r=0.0 ok=true s="deduped memo to size 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var kept = 0;
	for k in g.n {
		if kept >= sz { break; }
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[k] { seen = true; }
		}
		if !seen {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped memo to size ", kept);
	out
}
@end
