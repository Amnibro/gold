test: list=10,20,30,40 limit=45
expect: => i=30 r=0.0 ok=true s="selected 2 items reaching sum 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,5,5 limit=12
expect: => i=10 r=0.0 ok=true s="selected 2 items reaching sum 10" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${limit};
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] > max_sum {
			break;
		}
		running += g.res[i];
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "selected ", kept, " items reaching sum ", running);
	out
}
@end
