@entry a1c9173aefdec5f2
kind: step
verb: apply
noun: primes
modifier: up_to
context: format
phrase: format primes up to limit {limit}
phrase: display prime factors bounded by {limit}
slot: limit int
test: list=2,3,4,5,6,7,8 limit=5
expect: => i=3 r=0.0 ok=true s="primes: [2, 3, 5]" errors=0 n=7 res=[2,3,4,5,6,7,8] cache=0 hits=0
test: list=11,12,13,14 limit=12
expect: => i=1 r=0.0 ok=true s="primes: [11]" errors=0 n=4 res=[11,12,13,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	let bound = ${limit};
	format(out.s, "primes: [");
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= bound {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				if count > 0 { format(out.s, ", "); }
				format(out.s, x);
				count++;
			}
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
@entry 260425c2fd896caa
kind: step
verb: rotate
noun: vowels
modifier: last
context: format
phrase: move trailing vowels to front of buffer
phrase: format string rotating last vowel
test: text="hello"
expect: => i=1 r=0.0 ok=true s="ohell" errors=0 n=0 res=[] cache=0 hits=0
test: text="world"
expect: => i=1 r=0.0 ok=true s="owrld" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_vowel_idx = -1;
	var last_vowel byte = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			last_vowel_idx = i;
			last_vowel = b;
		}
	}
	if last_vowel_idx >= 0 {
		var buf byte[..200] = [];
		buf.push(last_vowel);
		for i in out.s.len {
			if i != last_vowel_idx { buf.push(out.s[i]); }
		}
		out.s.clear();
		for b in buf { out.s.push(b); }
		out.i = 1;
	}
	g.steps += out.s.len;
	out
}
@end
