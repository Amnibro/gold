@entry 77f40a0848a1aa44
kind: step
verb: retry
noun: pairs
modifier: recursively
context: aggregate
phrase: retry aggregating pairs recursively
phrase: recursive retry of pairwise combinations
test: list=1,2,3,4,5,6,7,8
expect: => i=36 r=0.0 ok=true s="recursive pairs reduced to 36 in rounds 3" errors=0 n=1 res=[36] cache=0 hits=0
test: list=10,20,30,40
expect: => i=100 r=0.0 ok=true s="recursive pairs reduced to 100 in rounds 2" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for recursive pairs");
		out.ok = false;
		return out;
	}
	var rounds = 0;
	while g.n > 1 && rounds < 4 {
		var next_n = 0;
		var i = 0;
		while i + 1 < g.n {
			g.res[next_n] = g.res[i] + g.res[i + 1];
			next_n++;
			i += 2;
		}
		if i < g.n {
			g.res[next_n] = g.res[i];
			next_n++;
		}
		g.n = next_n;
		rounds++;
	}
	g.steps += rounds * 10;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "recursive pairs reduced to ", g.res[0], " in rounds ", rounds);
	out
}
@end
