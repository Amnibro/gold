code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid = g.n / 2;
		let val = g.res[mid];
		for i in mid..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = val;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated middle last");
	out
}
@end
