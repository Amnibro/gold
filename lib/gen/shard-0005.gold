fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	let cv, hit = gold_cache_get(g, t);
	if hit {
		out.i = cv;
	} else {
		var found_idx = -1;
		for i in g.n {
			if g.res[i] == t { found_idx = i; break; }
		}
		gold_cache_put(g, t, found_idx);
		out.i = found_idx;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "found index ", out.i);
	out
}
@end
