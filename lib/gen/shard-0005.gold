	while idx + 1 < g.n {
		if g.res[idx] + g.res[idx + 1] > lim {
			let t = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = t;
			swap_count++;
		}
		idx += 2;
	}
	out.i = swap_count;
	g.steps += idx + 1;
	out.s.clear();
	format(out.s, "swapped limit exceeding pairs ", swap_count);
	out
}
@end
