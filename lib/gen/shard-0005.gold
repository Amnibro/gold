test: list=10,20,30,40 thresh=50
expect: => i=2 r=0.0 ok=true s="checkpoints: [10, 30]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,10,15 thresh=20
expect: => i=2 r=0.0 ok=true s="checkpoints: [5, 15]" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var total = 0;
	var count = 0;
	out.s.clear();
	format(out.s, "checkpoints: [");
	while count < g.n && total + g.res[count] <= th {
		total += g.res[count];
		if count > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, total);
		count++;
	}
	format(out.s, "]");
	g.steps += count + 1;
	out.i = count;
	out
}
@end
@entry adf7cd45a56c6de7
kind: step
verb: rotate
noun: prefix
modifier: times
context: format
phrase: format prefix rotation repeated {times} times
phrase: display prefix elements shifted {times} times
slot: times int
test: list=1,2,3,4,5 times=1
expect: => i=5 r=0.0 ok=true s="prefix_rot: [2, 3, 4, 5, 1]" errors=0 n=5 res=[2,3,4,5,1] cache=0 hits=0
test: list=10,20,30 times=2
expect: => i=3 r=0.0 ok=true s="prefix_rot: [30, 10, 20]" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 1 {
		for step in t {
			let first = g.res[0];
			for k in (g.n - 1) {
				g.res[k] = g.res[k + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	out.s.clear();
	format(out.s, "prefix_rot: [");
	for k in g.n {
		if k > 0 { out.s.push(','); out.s.push(' '); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	g.steps += g.n * (t + 1);
	out.i = g.n;
	out
}
@end
