fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 { return out; }
	var write_pos = 1;
	for read_pos in 1..out.s.len {
		if out.s[read_pos] != out.s[write_pos - 1] {
			out.s[write_pos] = out.s[read_pos];
			write_pos++;
		}
	}
	out.s.resize(write_pos, 0 as byte);
	out.i = write_pos;
	out
}
@end
