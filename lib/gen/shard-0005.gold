@entry b3ca829de5499bb2
kind: fn
verb: rotate
noun: sequence
modifier: every_other
context: aggregate
phrase: rotate sequence alternating step
phrase: cyclic rotate sequence every other position
test: arg=1234
expect: 2143
test: arg=5678
expect: 6587
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var digits int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var i = 0;
	while i + 1 < len {
		let tmp = digits[i];
		digits[i] = digits[i + 1];
		digits[i + 1] = tmp;
		i += 2;
	}
	var res = 0;
	var p = 1;
	for k in len {
		res += digits[k] * p;
		p *= 10;
	}
	res
}
@end
@entry 178a2849ccadceb1
kind: pred
verb: validate
noun: prefix
modifier: running
context: aggregate
phrase: validate prefix running non decreasing
phrase: verify leading digits are monotonic non decreasing
test: arg=1247
expect: true
test: arg=7421
expect: false
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = 10;
	while x > 0 {
		let cur = x % 10;
		if cur > prev {
			return false;
		}
		prev = cur;
		x /= 10;
	}
	true
}
@end
