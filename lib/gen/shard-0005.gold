@entry 8e85af0b17c9db6b
kind: step
verb: count
noun: primes
modifier: with_cache
context: loop
phrase: count primes with cache table
phrase: inspect prime numbers with memo cache
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="prime count 3" errors=0 n=5 res=[2,3,4,5,6] cache=5 hits=0
test: list=8,9,10
expect: => i=0 r=0.0 ok=true s="prime count 0" errors=0 n=3 res=[8,9,10] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pcount = 0;
	for pos in g.n {
		let num = g.res[pos];
		let cv, ok = gold_cache_get(g, num);
		if ok {
			if cv == 1 { pcount++; }
		} else {
			var is_p = 1;
			if num < 2 { is_p = 0; }
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = 0; }
				d++;
			}
			gold_cache_put(g, num, is_p);
			if is_p == 1 { pcount++; }
		}
	}
	out.i = pcount;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "prime count ", pcount);
	out
}
@end
