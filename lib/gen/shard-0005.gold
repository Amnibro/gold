noun: letters
modifier: last
context: compare
phrase: shift last {k} letters in sequence
phrase: rotate last {k} characters
slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=1 r=0.0 ok=true s="shifted last letters flag 1" errors=0 n=5 res=[1,2,3,5,4] cache=0 hits=0
test: list=10,20,30 k=1
expect: => i=1 r=0.0 ok=true s="shifted last letters flag 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let cnt = ${k};
	var out = v;
	if g.n > 1 && cnt > 0 {
		let last_idx = g.n - 1;
		let prev_idx = if g.n > cnt { g.n - cnt } else { 0 };
		let tmp = g.res[last_idx];
		g.res[last_idx] = g.res[prev_idx];
		g.res[prev_idx] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "shifted last letters flag ", out.i);
	out
}
@end
