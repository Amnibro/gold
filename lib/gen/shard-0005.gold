test: list=10,20,30 parts=2
expect: => i=30 r=0.0 ok=true s="split retry tally share 30" errors=0 n=2 res=[30,30] cache=0 hits=0
test: list=12,24,36 parts=3
expect: => i=24 r=0.0 ok=true s="split retry tally share 24" errors=0 n=3 res=[24,24,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let share = sum / p;
	gold_clear(g);
	for k in p { gold_push(g, share); }
	g.steps += p + 1;
	out.i = share;
	out.s.clear();
	format(out.s, "split retry tally share ", share);
	out
}
@end
