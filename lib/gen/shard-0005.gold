code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.ok = max_streak >= thresh;
	out.s.clear();
	format(out.s, "longest streak: ", max_streak);
	out
}
@end
