fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var streaks int[512] = [0; 512];
	streaks[0] = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			streaks[k] = streaks[k - 1] + 1;
		} else {
			streaks[k] = 1;
		}
	}
	for k in g.n {
		g.res[k] = streaks[k];
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "measured streaks for ", g.n, " items");
