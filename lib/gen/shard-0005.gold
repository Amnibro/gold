code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			out.s[i] = (((c - 'a' + off) % 26) + 'a') as! byte;
		} else if c >= 'A' && c <= 'Z' {
			out.s[i] = (((c - 'A' + off) % 26) + 'A') as! byte;
		}
	}
	g.steps += out.s.len;
	out.i = off;
	out
}
@end
