fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = [false; 256];
	var kept byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		let idx = c as int;
		if idx >= 0 && idx < 256 && !seen[idx] {
			seen[idx] = true;
			kept.push(c);
		}
	}
	out.s.clear();
	for c in kept { out.s.push(c); }
	g.steps += out.s.len;
	out
}
@end
