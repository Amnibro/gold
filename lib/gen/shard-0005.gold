fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var wlens = [0; 32];
	var wn = 0;
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == 32 {
			if cur > 0 && wn < 32 { wlens[wn] = cur; wn++; }
			cur = 0;
		} else {
			cur++;
		}
	}
	if cur > 0 && wn < 32 { wlens[wn] = cur; wn++; }
	var pairs = 0;
	if wn > 1 {
		for i in wn {
			for j in (i + 1)..wn {
				if wlens[i] == wlens[j] { pairs++; }
			}
		}
	}
	out.i = pairs;
	gold_push(g, pairs);
	g.steps += out.s.len + 1;
	out.s.clear();
	format(out.s, "matching word length pairs ", pairs);
	out
}
