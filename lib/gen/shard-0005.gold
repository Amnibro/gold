fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var dropped = 0;
	var new_s byte[>..] = [];
	for b in out.s {
		if (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u') && dropped < c {
			dropped++;
		} else {
			new_s.push(b);
