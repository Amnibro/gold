kind: step
verb: rotate
noun: items
modifier: with_cache
context: format
phrase: rotate items storing head in cache
phrase: format cyclic shift recording head in cache
test: list=10,20,30
expect: => i=10 r=0.0 ok=true s="rotated head cached: 10" errors=0 n=3 res=[20,30,10] cache=1 hits=0
test: list=5,6,7,8
expect: => i=5 r=0.0 ok=true s="rotated head cached: 5" errors=0 n=4 res=[6,7,8,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n > 0 {
		let head = g.res[0];
		gold_cache_put(g, 0, head);
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = head;
		format(out.s, "rotated head cached: ", head);
		out.i = head;
	}
	g.steps += g.n;
	out
}
@end
