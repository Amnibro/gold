code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_meas = 0;
	for k in g.n {
		let x = g.res[k];
		let cached_val, found = gold_cache_get(g, x);
		if found {
			total_meas += cached_val;
		} else {
			let computed = ${sub}(x);
			gold_cache_put(g, x, computed);
			total_meas += computed;
		}
	}
	g.steps += g.n;
	out.i = total_meas;
	out.s.clear();
	format(out.s, "measured subfunction cached total ", total_meas);
	out
}
@end
