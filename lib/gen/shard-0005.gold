code:
fn ${ID}_is_p(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tot = 0;
	var p_count = 0;
	for i in g.n {
		if ${ID}_is_p(g.res[i]) {
			if p_count % 2 == 0 { tot += g.res[i]; }
			p_count++;
		}
	}
	out.i = tot;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "alternating prime sum ", tot);
	out
}
@end
