code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var dropped = 0;
	while g.n > 0 && dropped < r && g.res[g.n - 1] < 0 {
		g.n--;
		dropped++;
	}
	g.steps += dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "pruned suffix count ", dropped);
	out
}
@end
@entry bf8b9f148f7308d9
kind: step
verb: group
noun: spaces
modifier: first
context: stats
phrase: group spaces first using gap {gap}
phrase: cluster initial spacing with gap {gap}
slot: gap int
test: list=2,4,6,15,25 gap=3
expect: => i=3 r=0.0 ok=true s="grouped initial cluster 3" errors=0 n=5 res=[2,4,6,15,25] cache=0 hits=0
test: list=5,10,25,30 gap=6
expect: => i=2 r=0.0 ok=true s="grouped initial cluster 2" errors=0 n=4 res=[5,10,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_lim = ${gap};
	var clustered = 1;
	if g.n > 1 {
		while clustered < g.n {
			let diff = g.res[clustered] - g.res[clustered - 1];
			if diff > g_lim { break; }
			clustered++;
		}
	}
	g.steps += clustered + 1;
	out.i = clustered;
	out.s.clear();
	format(out.s, "grouped initial cluster ", clustered);
	out
}
@end
@entry be858a643eb350ab
kind: step
verb: apply
noun: squares
modifier: nested
context: stats
phrase: apply squares nested in blocks of {chunk}
phrase: square nested blocks of size {chunk}
slot: chunk int
test: list=2,3,4,5 chunk=2
expect: => i=13 r=0.0 ok=true s="nested squares blocks 2" errors=0 n=2 res=[13,41] cache=0 hits=0
test: list=1,2,3 chunk=3
expect: => i=14 r=0.0 ok=true s="nested squares blocks 1" errors=0 n=1 res=[14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum_sq = 0;
		var j = i;
		while j < g.n && j < i + c {
			let x = g.res[j];
			sum_sq += x * x;
			j++;
		}
		g.res[new_n] = sum_sq;
		new_n++;
		i += c;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "nested squares blocks ", new_n);
	out
}
@end
