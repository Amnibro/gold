expect: => i=4 r=0.0 ok=true s="sorted token count 4" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: text="one two three four"
expect: => i=4 r=0.0 ok=true s="sorted token count 4" errors=0 n=4 res=[3,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lens = [0; 32];
	var ln = 0;
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == 32 {
			if cur > 0 && ln < 32 { lens[ln] = cur; ln++; }
			cur = 0;
		} else {
			cur++;
		}
	}
	if cur > 0 && ln < 32 { lens[ln] = cur; ln++; }
	if ln > 1 {
		for i in 0..(ln - 1) {
			for j in 0..(ln - 1 - i) {
				if lens[j] > lens[j + 1] {
					let tmp = lens[j];
					lens[j] = lens[j + 1];
					lens[j + 1] = tmp;
				}
			}
		}
	}
	for i in ln { gold_push(g, lens[i]); }
	out.i = ln;
	g.steps += out.s.len + ln * 2 + 1;
	out.s.clear();
	format(out.s, "sorted token count ", ln);
	out
}
@end
