modifier: in_place
context: transform
phrase: compare adjacent gaps in place
phrase: transform series into gaps in place
test: list=3,7,12,20
expect: => i=8 r=0.0 ok=true s="max gap 8" errors=0 n=3 res=[4,5,8] cache=0 hits=0
test: list=10,25,30
expect: => i=15 r=0.0 ok=true s="max gap 15" errors=0 n=2 res=[15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	for k in (g.n - 1) {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n--;
	g.steps += g.n;
	var max_gap = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_gap { max_gap = g.res[k]; }
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap ", max_gap);
	out
}
@end
