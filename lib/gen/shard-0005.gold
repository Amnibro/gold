@entry ed922415269fad9c
kind: step
verb: map
noun: tally
modifier: unique
context: aggregate
phrase: map unique elements into frequency tallies
phrase: count unique element occurrences across collection
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="mapped 3 unique tallies" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,9,9,9,9
expect: => i=2 r=0.0 ok=true s="mapped 2 unique tallies" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_vals int[512] = [0; 512];
	var tallies int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in un {
			if unique_vals[j] == x {
				tallies[j]++;
				found = true;
				break;
			}
		}
		if !found {
			unique_vals[un] = x;
			tallies[un] = 1;
			un++;
		}
	}
	gold_clear(g);
	for k in un {
		gold_push(g, tallies[k]);
	}
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "mapped ", un, " unique tallies");
	out
}
@end
@entry 1acc80fbb1818596
