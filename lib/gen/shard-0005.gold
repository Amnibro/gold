phrase: split checkpoint pairwise with scale {scale}
phrase: divide pairwise checkpoints scaled by {scale}
slot: scale int
test: list=10,25,50 scale=2
expect: => i=30 r=0.0 ok=true s="split pairwise checkpoints 2" errors=0 n=2 res=[30,50] cache=0 hits=0
test: list=5,15,20 scale=3
expect: => i=30 r=0.0 ok=true s="split pairwise checkpoints 2" errors=0 n=2 res=[30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n < 2 {
		g.steps++;
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = (g.res[i + 1] - g.res[i]) * sc;
	}
	g.n--;
	g.steps += g.n + 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "split pairwise checkpoints ", g.n);
	out
}
@end
