expect: => i=3 r=0.0 ok=true s="normalized 3 items" errors=0 n=3 res=[0,20,40] cache=0 hits=0
test: list=5,8,12 factor=3
expect: => i=3 r=0.0 ok=true s="normalized 3 items" errors=0 n=3 res=[0,9,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if g.n > 0 {
		var min_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] < min_val { min_val = g.res[i]; }
		}
		for i in g.n {
			g.res[i] = (g.res[i] - min_val) * fac;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized ", g.n, " items");
	out
}
@end
