kind: step
verb: dedupe
noun: sequence
modifier: recursively
context: sort
phrase: dedupe sequence recursively removing adjacent duplicates
phrase: compact adjacent duplicates in sorted sequence
test: list=1,1,2,3,3,3,4
expect: => i=4 r=0.0 ok=true s="compacted sequence 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,10,10,15
expect: => i=3 r=0.0 ok=true s="compacted sequence 3" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var kept = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "compacted sequence ", kept);
	out
}
@end
