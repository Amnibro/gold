	var spaces = 0;
	for i in out.s.len {
		if out.s[i] == ' ' { spaces++; }
	}
	let tot = spaces * mul;
	out.i = tot;
	g.steps += out.s.len;
	out.s.clear();
	format(out.s, "scaled space count ", tot);
	out
}
@end
