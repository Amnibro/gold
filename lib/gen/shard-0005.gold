fn ${ID}(g Gold&, v Val) Val {
	let thresh = ${min_len};
	var out = v;
	if g.n >= thresh && g.n > 1 {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "shifted list status ", out.i);
	out
}
@end
