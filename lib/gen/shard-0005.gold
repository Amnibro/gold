expect: => i=2 r=0.0 ok=true s="vowel_pairs: [ae, io]" errors=0 n=0 res=[] cache=0 hits=0
test: text="boat"
expect: => i=1 r=0.0 ok=true s="vowel_pairs: [oa]" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[>..] = [];
	for k in out.s.len {
		let c = out.s[k];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		   c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' {
			vowels.push(c);
		}
	}
	out.s.clear();
	var pairs = 0;
	format(out.s, "vowel_pairs: [");
	var i = 0;
	while i + 1 < vowels.len {
		if pairs > 0 { out.s.push(','); out.s.push(' '); }
		out.s.push(vowels[i]);
		out.s.push(vowels[i + 1]);
		pairs++;
		i += 2;
	}
	format(out.s, "]");
	g.steps += out.s.len;
	out.i = pairs;
	out
}
@end
