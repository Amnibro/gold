kind: step
verb: merge
noun: budget
modifier: any
context: list
phrase: merge list items while staying within budget {budget}
phrase: pack elements into single total under budget {budget}
slot: budget int
test: list=10,20,30,40,50 budget=65
expect: => i=60 r=0.0 ok=true s="merged 3 items under budget" errors=0 n=3 res=[60,40,50] cache=0 hits=0
test: list=5,5,5,100 budget=20
expect: => i=15 r=0.0 ok=true s="merged 3 items under budget" errors=0 n=2 res=[15,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	var cur_sum = 0;
	var count = 0;
	while count < g.n && cur_sum + g.res[count] <= max_b {
		cur_sum += g.res[count];
		count++;
	}
	if count > 1 {
		g.res[0] = cur_sum;
		for k in count..g.n {
			g.res[k - count + 1] = g.res[k];
		}
		g.n = g.n - count + 1;
	}
	out.i = cur_sum;
	out.s.clear();
	format(out.s, "merged ", count, " items under budget");
	out
}
@end
