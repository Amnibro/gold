fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == x { seen = true; break; }
			j += 2;
		}
		if !seen {
			g.res[kept] = x;
			if i + 1 < g.n {
				g.res[kept + 1] = g.res[i + 1];
				kept += 2;
			} else {
				kept += 1;
			}
		}
		i += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped alternate elements count=", kept);
	out
}
@end
