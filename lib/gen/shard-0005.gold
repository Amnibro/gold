	for i in g.n {
		for j in 0..(g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var temp int[512] = [0; 512];
	var tn = 0;
	for i in g.n {
		for r in rep {
			if tn < 512 {
				temp[tn] = g.res[i];
				tn++;
			}
		}
	}
	gold_clear(g);
	for i in tn { gold_push(g, temp[i]); }
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "repeated sorted elements: ", tn);
	out
}
@end
