expect: => i=3 r=0.0 ok=true s="filtered sequence count 3" errors=0 n=3 res=[3,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > 0 {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	if kept == 0 && g.n > 0 {
		g.res[0] = 0;
		kept = 1;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "filtered sequence count ", kept);
	out
}
@end
