fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var write_idx = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	let removed = g.n - write_idx;
	g.n = write_idx;
	out.i = removed;
	out
}
@end
