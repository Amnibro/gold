expect: => i=3 r=0.0 ok=true s="find function unique" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=3,3,4,5 fn=square
expect: => i=3 r=0.0 ok=true s="find function unique" errors=0 n=3 res=[9,16,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		let val = ${fn}(g.res[i]);
		var seen = false;
		for j in uniq {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[uniq] = val;
			uniq++;
		}
	}
	g.n = uniq;
	g.steps += g.n * 2;
	out.i = uniq;
	out.s.clear();
	format(out.s, "find function unique");
	out
}
@end
