code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${attempts};
	var kept = 0;
	var tries = 0;
	while tries < max_tries {
		tries++;
		kept = 0;
		for k in out.s.len {
			if out.s[k] >= 'a' && out.s[k] <= 'z' {
				out.s[kept] = out.s[k];
				kept++;
			}
		}
		if kept > 0 { break; }
	}
	out.s.resize(kept, 0 as byte);
	out.i = kept;
	out
}
@end
