fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			dups++;
			gold_cache_put(g, g.res[i], dups);
		}
		i++;
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicate count ", dups);
	out
}
