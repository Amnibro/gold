test: text="hello:world" stop_char=":"
expect: => i=5 r=0.0 ok=true s="olleh:world" errors=0 n=0 res=[] cache=0 hits=0
test: text="abc" stop_char=","
expect: => i=3 r=0.0 ok=true s="cba" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${stop_char};
	if sc.len == 0 || out.s.len == 0 { return out; }
	let mark = sc[0];
	var stop_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] == mark {
			stop_idx = i;
			break;
		}
	}
	var l = 0;
	var r = stop_idx - 1;
	while l < r {
		let c = out.s[l];
		out.s[l] = out.s[r];
		out.s[r] = c;
		l++;
		r--;
	}
	out.i = stop_idx;
	g.steps += stop_idx + 1;
	out
}
@end
