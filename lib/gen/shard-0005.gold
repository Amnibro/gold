fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var sum = 0;
	let start = if g.n >= c { g.n - c } else { 0 };
	var k = start;
	while k < g.n {
		sum += g.res[k];
		k++;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "joined last range sum ", sum);
	out
}
