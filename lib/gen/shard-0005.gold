fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var count = 0;
	var pos = g.n;
	while pos > 0 {
		pos--;
		if g.res[pos] % 2 != 0 {
			g.res[pos] = g.res[pos] * m;
			count++;
		}
	}
	out.i = count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "scaled reverse odds ", count);
	out
}
@end
