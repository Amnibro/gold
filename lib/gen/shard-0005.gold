code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_len};
	let hi = ${max_len};
	var matching = 0;
	var cur_len = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == 32 {
			if cur_len >= lo && cur_len <= hi { matching++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len >= lo && cur_len <= hi { matching++; }
	out.i = matching;
	gold_push(g, matching);
	g.steps += out.s.len + 1;
	out.s.clear();
	format(out.s, "spaced words matched ", matching);
	out
}
@end
