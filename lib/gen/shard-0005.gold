code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var p_sum = 0;
	while p_count < g.n && core_is_prime(g.res[p_count]) {
		p_sum += g.res[p_count];
		p_count++;
	}
	if p_count > 1 {
		g.res[0] = p_sum;
		for k in p_count..g.n {
			g.res[k - p_count + 1] = g.res[k];
		}
		g.n = g.n - p_count + 1;
	}
	out.i = p_sum;
	out.s.clear();
	format(out.s, "merged ", p_count, " initial primes");
	out
}
@end
