fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var left = 0;
	var right = out.s.len - 1;
	while left < right && ${cond}(out.s[left] as int) {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		swaps++;
		left++;
		right--;
	}
	out.i = swaps;
	out
}
@end
