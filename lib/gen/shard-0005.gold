expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var counts int[10] = [0; 10];
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var gap_sum = 0;
	var prev = -1;
	for d in 10 {
		var c = counts[d];
		while c > 0 {
			if prev >= 0 { gap_sum += (d - prev); }
			prev = d;
			c--;
		}
	}
	gap_sum
}
