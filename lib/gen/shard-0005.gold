code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var count = 0;
	for k in g.n {
		if g.res[k] <= rem {
			rem -= g.res[k];
			count++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "budgeted items ", count);
	out
}
@end
