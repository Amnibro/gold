expect: => i=1 r=0.0 ok=true s="paired 1 observation sets" errors=0 n=4 res=[3,1,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${bound};
	var pairs = 0;
	var idx = 0;
	while idx + 1 < g.n {
		if !${cond}(g.res[idx]) || !${cond}(g.res[idx + 1]) { break; }
		let total = g.res[idx] + g.res[idx + 1];
		if total > lim { break; }
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		pairs++;
		idx += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " observation sets");
	out
}
@end
@entry 97238157bac4ff47
kind: step
verb: swap
noun: results
modifier: at_least
context: stats
phrase: swap adjacent observations with difference at least {min_diff}
phrase: exchange neighbouring values differing by at least {min_diff}
slot: min_diff int
test: list=10,30,15,40 min_diff=15
expect: => i=2 r=0.0 ok=true s="swapped 2 observation pairs" errors=0 n=4 res=[30,10,40,15] cache=0 hits=0
test: list=5,8,12 min_diff=10
expect: => i=0 r=0.0 ok=true s="swapped 0 observation pairs" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_diff};
	var swaps = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let diff = g.res[idx + 1] - g.res[idx];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d >= md {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			swaps++;
		}
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " observation pairs");
	out
}
@end
@entry 63c88996a3995224
kind: step
verb: merge
noun: value
modifier: at_least
context: stats
phrase: merge adjacent observations with sum at least {min_val}
phrase: combine neighbouring values when sum reaches at least {min_val}
slot: min_val int
test: list=10,20,5,6,15 min_val=25
expect: => i=4 r=0.0 ok=true s="merged into 4 items" errors=0 n=4 res=[30,5,6,15] cache=0 hits=0
test: list=30,40,50 min_val=60
expect: => i=2 r=0.0 ok=true s="merged into 2 items" errors=0 n=2 res=[70,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let s = g.res[idx] + g.res[idx + 1];
		if s >= mv {
			g.res[write_pos] = s;
			write_pos++;
			idx += 2;
		} else {
			g.res[write_pos] = g.res[idx];
			write_pos++;
			idx++;
		}
	}
	if idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged into ", write_pos, " items");
	out
}
@end
@entry 3f076be96d3daaaf
kind: step
verb: check
noun: middle
modifier: running
context: stats
phrase: check running middle values against threshold {bound}
phrase: verify middle observations stay below {bound}
slot: bound int
test: list=1,2,3,4,5 bound=10
expect: => i=1 r=0.0 ok=true s="middle check result: 1" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=1,20,30,4 bound=15
expect: => i=0 r=0.0 ok=false s="middle check result: 0" errors=1 n=4 res=[1,20,30,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	if g.n < 3 {
		gold_fail(g, "not enough observations");
		out.ok = false;
		return out;
	}
	let start = g.n / 3;
	let end = g.n * 2 / 3;
	var ok = true;
	for k in start..end {
		if g.res[k] > limit { ok = false; break; }
	}
	if !ok {
		gold_fail(g, "middle value exceeds bound");
		out.ok = false;
	}
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "middle check result: ", out.i);
	out
}
@end
