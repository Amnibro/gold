noun: average
modifier: at_least
context: search
phrase: apply average at least threshold {threshold}
phrase: filter search average at least {threshold}
slot: threshold int
test: list=10,20,30 threshold=15
expect: => i=20 r=0.0 ok=true s="average check 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,8,12 threshold=20
expect: => i=8 r=0.0 ok=false s="average check 8" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n == 0 {
		g.steps++;
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	g.steps += g.n + 1;
	out.i = avg;
	out.ok = avg >= th;
	out.s.clear();
	format(out.s, "average check ", avg);
	out
}
@end
