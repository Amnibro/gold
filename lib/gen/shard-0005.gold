code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mono = true;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] >= g.res[i + 1] {
				mono = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = mono;
	out.i = if mono { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked series pairwise");
	out
}
@end
@entry 1fec11f19c4cb72f
kind: step
verb: split
noun: list
modifier: with_retry
context: math
phrase: split list with retry pivot {pivot}
phrase: partition list using retry pivot {pivot}
slot: pivot int
test: list=10,50,20,60 pivot=30
expect: => i=2 r=0.0 ok=true s="split list with retry pivot" errors=0 n=4 res=[10,20,50,60] cache=0 hits=0
test: list=5,15 pivot=10
expect: => i=1 r=0.0 ok=true s="split list with retry pivot" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let piv = ${pivot};
	var lo int[512] = [0; 512];
	var hi int[512] = [0; 512];
	var n_lo = 0;
	var n_hi = 0;
	for i in g.n {
		if g.res[i] < piv {
			lo[n_lo] = g.res[i];
			n_lo++;
		} else {
			hi[n_hi] = g.res[i];
			n_hi++;
		}
	}
	for i in n_lo { g.res[i] = lo[i]; }
	for i in n_hi { g.res[n_lo + i] = hi[i]; }
	g.steps += g.n;
	out.i = n_lo;
	out.s.clear();
	format(out.s, "split list with retry pivot");
	out
}
@end
