fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dups = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] && dups < lim {
				dups++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found duplicates up to limit");
	out
}
@end
@entry afc1b504caf4dbb7
kind: step
verb: merge
noun: results
modifier: up_to
context: math
phrase: merge results up to maximum sum {max_sum}
phrase: combine results up to ceiling total {max_sum}
slot: max_sum int
test: list=10,15,20,5 max_sum=30
expect: => i=2 r=0.0 ok=true s="merged results up to sum" errors=0 n=2 res=[25,25] cache=0 hits=0
test: list=5,10,20 max_sum=15
expect: => i=2 r=0.0 ok=true s="merged results up to sum" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_sum};
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var s = g.res[i];
		var j = i + 1;
		while j < g.n && s + g.res[j] <= cap {
			s += g.res[j];
			j++;
		}
		g.res[new_n] = s;
		new_n++;
		i = j;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged results up to sum");
	out
}
@end
@entry 367925306eb38e38
kind: step
verb: sort
noun: streak
modifier: at_most
context: math
phrase: sort streak of at most {size} numbers
phrase: order subsegment streak at most {size} length
slot: size int
test: list=5,3,1,9,4 size=3
expect: => i=3 r=0.0 ok=true s="sorted streak at most" errors=0 n=5 res=[1,3,5,9,4] cache=0 hits=0
test: list=10,8,6,2 size=2
expect: => i=2 r=0.0 ok=true s="sorted streak at most" errors=0 n=4 res=[8,10,6,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	let lim = if sz < g.n { sz } else { g.n };
	for i in lim {
		var min_idx = i;
		for j in (i + 1)..lim {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += lim * lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "sorted streak at most");
	out
}
@end
@entry 6aaa4657563003ea
kind: step
verb: repeat
noun: results
modifier: until
context: math
phrase: repeat results until target length {target_len}
phrase: duplicate results cycle until reaching {target_len}
slot: target_len int
test: list=1,2 target_len=5
expect: => i=5 r=0.0 ok=true s="repeated results until length" errors=0 n=5 res=[1,2,1,2,1] cache=0 hits=0
test: list=10,20,30 target_len=4
expect: => i=4 r=0.0 ok=true s="repeated results until length" errors=0 n=4 res=[10,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_len};
	let original = g.n;
	if original == 0 || tgt <= original {
		out.i = g.n;
		return out;
	}
	while g.n < tgt && g.n < 500 {
		let src_idx = (g.n - original) % original;
		gold_push(g, g.res[src_idx]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated results until length");
	out
}
@end
