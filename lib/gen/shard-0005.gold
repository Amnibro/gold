slot: threshold int
test: list=10,30,35,60 threshold=15
expect: => i=2 r=0.0 ok=true s="found 2 pairwise differences exceeding threshold" errors=0 n=4 res=[10,30,35,60] cache=0 hits=0
test: list=5,8,12 threshold=10
expect: => i=0 r=0.0 ok=true s="found 0 pairwise differences exceeding threshold" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	for k in (g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d >= th { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " pairwise differences exceeding threshold");
	out
}
@end
