slot: min_gap int
test: list=1,10,12,25 min_gap=5
expect: => i=2 r=0.0 ok=true s="gaps: [9, 13]" errors=0 n=4 res=[1,10,12,25] cache=0 hits=0
test: list=2,4,6 min_gap=3
expect: => i=0 r=0.0 ok=true s="gaps: []" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	out.s.clear();
	var gaps_found = 0;
	format(out.s, "gaps: [");
	var i = 0;
	while i + 1 < g.n {
		let diff = core_abs_val(g.res[i + 1] - g.res[i]);
		if diff >= mg {
			if gaps_found > 0 { out.s.push(','); out.s.push(' '); }
			format(out.s, diff);
			gaps_found++;
		}
		i++;
	}
	format(out.s, "]");
	g.steps += g.n;
	out.i = gaps_found;
	out
}
@end
