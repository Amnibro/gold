fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var pairs = 0;
	if out.s.len > 1 {
		var i = 0;
		while i + 1 < out.s.len {
			if out.s[i] == out.s[i + 1] {
				pairs++;
				if pairs >= limit { break; }
				i += 2;
			} else {
				i++;
			}
		}
	}
	g.steps += out.s.len;
	out.i = pairs;
	out.s.clear();
	format(out.s, "ranked pairs: ", pairs);
	out
}
@end
