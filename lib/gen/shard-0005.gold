fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var out_of_bounds = 0;
	for i in g.n {
		if g.res[i] < -100 || g.res[i] > 100 { out_of_bounds++; }
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if out_of_bounds > 0 { gold_fail(g, "items out of limits"); }
	g.steps += g.n * g.n;
	out.i = out_of_bounds;
	out.s.clear();
	format(out.s, "bounded items sorted ", g.n);
	out
}
