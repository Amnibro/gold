slot: f fn
test: list=10,3,7 f=double
expect: => i=40 r=0.0 ok=true s="sorted function sum 40" errors=0 n=4 res=[3,7,10,40] cache=0 hits=0
test: list=5,1 f=square
expect: => i=26 r=0.0 ok=true s="sorted function sum 26" errors=0 n=3 res=[1,5,26] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var sum = 0;
	for i in g.n {
		let applied = ${f}(g.res[i]);
		sum += applied;
	}
	out.i = sum;
	gold_push(g, sum);
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "sorted function sum ", sum);
	out
}
@end
