code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var mid_sum = 0;
		for idx in 1..g.n - 1 {
			mid_sum += g.res[idx];
		}
		g.res[1] = mid_sum;
		g.res[2] = g.res[g.n - 1];
		g.n = 3;
		out.i = mid_sum;
	} else {
		out.i = 0;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "merged middle sum ", out.i);
	out
}
@end
