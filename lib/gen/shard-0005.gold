fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_primes = ${cap};
	var found = 0;
	for i in g.n {
		if found >= max_primes { break; }
		if core_is_prime(g.res[i]) {
			gold_cache_put(g, g.res[i], found);
			found++;
		}
	}
	out.i = found;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "cached primes ", found);
	out
}
@end
