	var out = v;
	var digits = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			gold_cache_put(g, c as int, i);
			digits++;
		}
	}
	out.i = digits;
	out.ok = digits > 0;
	g.steps += out.s.len;
	out.s.clear();
	if digits > 0 {
		format(out.s, "cached digits: ", digits);
	} else {
		gold_fail(g, "no digits found");
		format(out.s, "no digits");
	}
	out
}
@end
