code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var cur_max = g.res[0];
	for i in 1..g.n {
		if g.res[i] > cur_max {
			cur_max = g.res[i];
		} else {
			g.res[i] = cur_max;
		}
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "folded running maximum");
	out
}
@end
