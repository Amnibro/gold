expect: => i=2 r=0.0 ok=false s="counter match 2" errors=0 n=4 res=[2,2,4,6] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	gold_cache_put(g, 0, tgt);
	var count = 0;
	for i in g.n {
		if g.res[i] == g.res[0] { count++; }
	}
	let val, ok = gold_cache_get(g, 0);
	g.steps += count + 1;
	out.i = count;
	out.ok = (count == val);
	out.s.clear();
	format(out.s, "counter match ", count);
	out
}
@end
