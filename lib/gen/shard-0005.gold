fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		if !${cond}(b) { break; }
		buf.push(b);
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
