code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var matched int[512] = [0; 512];
	var others int[512] = [0; 512];
	var nm = 0;
	var no = 0;
	for k in g.n {
		if g.res[k] == target {
			matched[nm] = g.res[k];
			nm++;
		} else {
			others[no] = g.res[k];
			no++;
		}
	}
	for k in nm { g.res[k] = matched[k]; }
	for k in no { g.res[nm + k] = others[k]; }
	g.steps += g.n;
	out.i = nm;
	out.s.clear();
	format(out.s, "grouped ", nm, " target values");
	out
}
@end
