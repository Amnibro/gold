@entry cf4fff6292bb8282
kind: step
verb: pair
noun: tail
modifier: unique
context: aggregate
phrase: pair unique elements in tail
phrase: aggregate unique pairs from tail
test: list=1,2,3,3,4,4,5
expect: => i=1 r=0.0 ok=true s="paired unique tail items count 1" errors=0 n=1 res=[7] cache=0 hits=0
test: list=10,20,20,30,40
expect: => i=1 r=0.0 ok=true s="paired unique tail items count 1" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "list too short for tail pairing");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	var uniq_count = 0;
	var temp_tail int[256] = [0; 256];
	for i in mid..g.n {
		let x = g.res[i];
		var seen = false;
		for j in uniq_count {
			if temp_tail[j] == x { seen = true; break; }
		}
		if !seen && uniq_count < 256 {
			temp_tail[uniq_count] = x;
			uniq_count++;
		}
	}
	var pairs = 0;
	var p = 0;
	while p + 1 < uniq_count {
		g.res[pairs] = temp_tail[p] + temp_tail[p + 1];
		pairs++;
		p += 2;
	}
	g.n = pairs;
	g.steps += g.n + uniq_count;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired unique tail items count ", pairs);
	out
}
@end
