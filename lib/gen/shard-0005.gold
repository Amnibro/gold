code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		g.res[write_pos] = g.res[idx] + g.res[idx + 1];
		write_pos++;
		idx += 2;
	}
	if idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
	}
	g.n = write_pos;
	var sorted = true;
	for k in 1..g.n {
		if g.res[k] < g.res[k - 1] { sorted = false; break; }
	}
	if !sorted {
		gold_fail(g, "merged results not sorted");
		out.ok = false;
	}
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged checkpoints into ", write_pos, " items");
	out
}
@end
