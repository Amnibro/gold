code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_even = -1;
	var total_gap = 0;
	for idx in g.n {
		let x = g.res[idx];
		if x % 2 == 0 {
			if last_even >= 0 {
				let gap = x - last_even;
				total_gap += if gap < 0 { -gap } else { gap };
			}
			last_even = x;
		}
	}
	out.i = total_gap;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "total consecutive even gap ", total_gap);
	out
}
