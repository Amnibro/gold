code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_pairs};
	var paired = 0;
	var i = 0;
	while i + 1 < g.n && paired < mp {
		if ${ID}_is_prime(g.res[i]) && ${ID}_is_prime(g.res[i + 1]) {
			g.res[paired] = g.res[i] + g.res[i + 1];
			paired++;
			i += 2;
		} else {
			i++;
		}
	}
	if paired > 0 { g.n = paired; }
	out.i = paired;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "paired prime count ", paired);
	out
}
@end
