@entry ee566db989e8c217
kind: step
verb: sort
noun: errors
modifier: all
context: math
phrase: sort all items by deviation errors from {target}
phrase: order items according to error distance from {target}
slot: target int
test: list=10,25,5,30 target=20
expect: => i=4 r=0.0 ok=true s="sorted all items by errors" errors=0 n=4 res=[25,10,30,5] cache=0 hits=0
test: list=1,8,4,12 target=6
expect: => i=4 r=0.0 ok=true s="sorted all items by errors" errors=0 n=4 res=[8,4,1,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			let ej = abs(g.res[j] - tgt);
			let em = abs(g.res[min_idx] - tgt);
			if ej < em { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted all items by errors");
	out
}
@end
