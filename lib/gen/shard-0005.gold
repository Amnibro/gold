fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var sum = 0;
		for idx in g.n - 1 {
			sum += g.res[idx];
		}
		let last_idx = g.n - 1;
		let prev_last = g.res[last_idx];
		g.res[last_idx] = sum;
		out.i = sum - prev_last;
	} else {
		out.i = 0;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "last tally updated discrepancy ", out.i);
	out
}
@end
