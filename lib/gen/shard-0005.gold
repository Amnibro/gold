noun: gaps
modifier: times
context: stats
phrase: cache gaps scaled {factor} times between points
phrase: store sample interval gaps multiplied {factor} times
slot: factor int
test: list=10,14,20 factor=2
expect: => i=2 r=0.0 ok=true s="cached gaps count 2" errors=0 n=3 res=[10,14,20] cache=2 hits=0
test: list=5,12,15 factor=3
expect: => i=2 r=0.0 ok=true s="cached gaps count 2" errors=0 n=3 res=[5,12,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var cached = 0;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let gap = core_abs_val(g.res[i + 1] - g.res[i]);
			let scaled_gap = gap * mult;
			gold_cache_put(g, i, scaled_gap);
			cached++;
		}
	}
	out.i = cached;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "cached gaps count ", cached);
	out
}
@end
