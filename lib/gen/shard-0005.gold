kind: step
verb: collect
noun: range
modifier: unique
context: transform
phrase: collect unique values within range {low} to {high}
phrase: gather distinct elements between range limits {low} to {high}
slot: low int
slot: high int
test: list=1,5,5,10,12,12,20 low=5 high=15
expect: => i=3 r=0.0 ok=true s="collected 3 unique range values" errors=0 n=3 res=[5,10,12] cache=0 hits=0
test: list=2,4,4,6,8,8 low=3 high=7
expect: => i=2 r=0.0 ok=true s="collected 2 unique range values" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var is_dup = false;
			for j in kept {
				if g.res[j] == x { is_dup = true; }
			}
			if !is_dup {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " unique range values");
	out
}
@end
