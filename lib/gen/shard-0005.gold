@entry 5ec6b5106c734c9f
kind: step
verb: retry
noun: primes
modifier: at_most
context: loop
phrase: retry primes at most limit {max_steps}
phrase: increment toward primes at most {max_steps} times
slot: max_steps int
test: list=4,8,10 max_steps=3
expect: => i=3 r=0.0 ok=true s="resolved prime candidates 3" errors=0 n=3 res=[5,11,11] cache=0 hits=0
test: list=14,20 max_steps=5
expect: => i=2 r=0.0 ok=true s="resolved prime candidates 2" errors=0 n=2 res=[17,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_steps};
	var primes_found = 0;
	for idx in g.n {
		var x = g.res[idx];
		var tries = 0;
		while tries < ms {
			var is_p = true;
			if x < 2 { is_p = false; }
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { break; }
			x++;
			tries++;
		}
		g.res[idx] = x;
		primes_found++;
	}
	out.i = primes_found;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "resolved prime candidates ", primes_found);
	out
}
@end
