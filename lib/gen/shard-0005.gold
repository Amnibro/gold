code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${times};
	if out.s.len > 1 && count > 0 {
		var total = 0;
		for c in out.s { total += c as int; }
		let shift = (total % out.s.len) + 1;
		for step in count {
			for k in shift {
				let first = out.s[0];
				for i in out.s.len - 1 {
					out.s[i] = out.s[i + 1];
				}
				out.s[out.s.len - 1] = first;
			}
		}
		out.i = total;
	}
	g.steps += out.s.len;
	out
}
@end
