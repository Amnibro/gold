test: list=12,25,35 ceiling=30
expect: => i=35 r=0.0 ok=false s="nested threshold check 35" errors=0 n=3 res=[12,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var valid = true;
	for i in g.n {
		if g.res[i] > ceil {
			valid = false;
			break;
		}
	}
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "nested threshold check ", out.i);
	out
}
@end
