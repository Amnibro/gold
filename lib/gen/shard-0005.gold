expect: => i=0 r=0.0 ok=true s="performed 0 swaps until condition" errors=0 n=4 res=[3,6,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need multiple items to swap");
		out.ok = false;
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let applied = ${fn}(g.res[i]);
		if ${done}(applied) {
			break;
		}
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += i + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " swaps until condition");
	out
}
@end
