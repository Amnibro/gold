code:
fn ${ID}(g Gold&, v Val) Val {
	let lim = ${limit};
	var out = v;
	var clamped = 0;
	for i in g.n {
		if g.res[i] > lim {
			g.res[i] = lim;
			clamped++;
		}
	}
	out.i = clamped;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "window clamped count ", clamped);
	out
}
@end
