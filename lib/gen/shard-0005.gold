expect: => i=20 r=0.0 ok=true s="split tally share 20" errors=0 n=3 res=[20,20,20] cache=0 hits=0
test: list=5,15,25,35 parts=2
expect: => i=40 r=0.0 ok=true s="split tally share 40" errors=0 n=2 res=[40,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 {
		gold_fail(g, "parts must be positive");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let share = sum / p;
	gold_clear(g);
	for k in p { gold_push(g, share); }
	g.steps += p + 1;
	out.i = share;
	out.s.clear();
	format(out.s, "split tally share ", share);
	out
}
@end
