expect: => i=2 r=0.0 ok=true s="collected reverse pairs 2" errors=0 n=6 res=[10,20,30,40,70,30] cache=0 hits=0
test: list=2,4,6
expect: => i=1 r=0.0 ok=true s="collected reverse pairs 1" errors=0 n=4 res=[2,4,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var collected = 0;
	if g.n >= 2 {
		var i = g.n - 1;
		while i >= 1 {
			let sum = g.res[i] + g.res[i - 1];
			gold_push(g, sum);
			collected++;
			i -= 2;
		}
	}
	out.i = collected;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "collected reverse pairs ", collected);
	out
}
@end
@entry b05c68a02b9541e8
kind: step
verb: sum
noun: digits
modifier: up_to
context: search
phrase: sum digits of search query up to {limit}
phrase: accumulate digits from query integer up to {limit}
slot: limit int
test: input=12345 limit=3
expect: => i=6 r=0.0 ok=true s="sum digits up to limit 6" errors=0 n=0 res=[] cache=0 hits=0
test: input=98765 limit=2
expect: => i=17 r=0.0 ok=true s="sum digits up to limit 17" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${limit};
	var val = core_abs_val(out.i);
	var digits = [0; 10];
	var dn = 0;
	while val > 0 && dn < 10 {
		digits[dn] = val % 10;
		val /= 10;
		dn++;
	}
	var sum = 0;
	var count = 0;
	var i = dn - 1;
	while i >= 0 && count < bound {
		sum += digits[i];
		count++;
		i--;
	}
	out.i = sum;
	g.steps += dn + 1;
	out.s.clear();
	format(out.s, "sum digits up to limit ", sum);
	out
}
@end
