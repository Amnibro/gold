fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			i++;
		}
		let take = if run_len > 2 { 2 } else { run_len };
		for t in take {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped items ", kept);
	out
}
@end
