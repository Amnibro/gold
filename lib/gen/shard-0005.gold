fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var reversed = false;
	if g.errors == 0 && g.n > 1 {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let t = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = t;
			l++;
			r--;
		}
		reversed = true;
	}
	out.ok = reversed;
	g.steps += g.n + 1;
	out.s.clear();
	if reversed {
		out.s.append("reversed without errors");
	} else {
		out.s.append("no reversal performed");
	}
	out
}
@end
