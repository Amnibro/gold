fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	for k in 1..g.n {
		if g.res[k] < g.res[k - 1] { sorted = false; break; }
	}
	if !sorted {
		gold_fail(g, "sample not sorted");
		out.ok = false;
		return out;
	}
	for k in g.n {
		g.res[k] = ${f}(g.res[k]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " sorted items");
	out
}
@end
@entry b389bbd34fa6df1a
kind: step
