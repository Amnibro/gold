code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var val = core_abs_val(out.i);
	var digits = [0; 10];
	var dlen = 0;
	while val > 0 && dlen < 10 {
		digits[dlen] = val % 10;
		val /= 10;
		dlen++;
	}
	var collected = 0;
	var i = dlen - 1;
	while i >= 0 {
		let d = digits[i];
		if !${cond}(d) { break; }
		gold_push(g, d);
		collected++;
		i--;
	}
	out.i = collected;
	g.steps += dlen + 1;
	out.s.clear();
	format(out.s, "collected ", collected, " digits");
	out
}
@end
