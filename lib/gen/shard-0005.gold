kind: step
verb: dedupe
noun: gaps
modifier: any
context: math
phrase: dedupe any adjacent gap values
phrase: remove duplicate adjacent gaps anywhere
test: list=1,3,5,8,10
expect: => i=2 r=0.0 ok=true s="deduped gaps count: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=10,20,25,35,45
expect: => i=2 r=0.0 ok=true s="deduped gaps count: 2" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps to dedupe");
		return out;
	}
	var unique_gaps int[512] = [0; 512];
	var gn = 0;
	for i in 0..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		var found = false;
		for j in gn {
			if unique_gaps[j] == diff { found = true; break; }
		}
		if !found {
			unique_gaps[gn] = diff;
			gn++;
		}
	}
	gold_clear(g);
	for k in gn { gold_push(g, unique_gaps[k]); }
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "deduped gaps count: ", gn);
	out
}
@end
