code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let keep_n = ${k};
	if g.n > keep_n {
		let start = g.n - keep_n;
		for i in keep_n { g.res[i] = g.res[start + i]; }
		g.n = keep_n;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "limited to last numbers ", g.n);
	out
}
@end
@entry 43567dc11f655c4b
kind: step
verb: limit
noun: middle
modifier: while
context: search
phrase: limit sample candidates around middle while within {margin}
phrase: filter search window around middle value within {margin}
slot: margin int
test: list=10,20,22,25,40 margin=5
expect: => i=3 r=0.0 ok=true s="kept around middle 3" errors=0 n=3 res=[20,22,25] cache=0 hits=0
test: list=5,15,30 margin=3
expect: => i=1 r=0.0 ok=true s="kept around middle 1" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${margin};
	if g.n > 0 {
		let mid = g.res[g.n / 2];
		var kept = 0;
		for i in g.n {
			if core_abs_val(g.res[i] - mid) <= tol {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
		out.i = kept;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "kept around middle ", out.i);
	out
}
@end
