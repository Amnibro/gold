@entry a68826defe207296
kind: step
verb: merge
noun: primes
modifier: recursively
context: core
phrase: merge primes recursively with factor {factor}
phrase: combine prime numbers recursively by {factor}
slot: factor int
test: list=2,3,4,5 factor=2
expect: => i=3 r=0.0 ok=true s="merged primes recursively" errors=0 n=4 res=[4,6,4,10] cache=0 hits=0
test: list=7,8,9 factor=3
expect: => i=1 r=0.0 ok=true s="merged primes recursively" errors=0 n=3 res=[21,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] *= f;
			primes++;
		}
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "merged primes recursively");
	out
}
@end
