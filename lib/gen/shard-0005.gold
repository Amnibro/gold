fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	var pos = g.n;
	while pos > 0 {
		pos--;
		if g.res[pos] >= th {
			g.res[kept] = g.res[pos];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "selected reverse above threshold ", kept);
	out
}
@end
