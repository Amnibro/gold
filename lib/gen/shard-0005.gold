fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	var greater = 0;
	for i in g.n {
		if g.res[i] > base {
			g.res[i] = 1;
			greater++;
		} else if g.res[i] < base {
			g.res[i] = -1;
		} else {
			g.res[i] = 0;
		}
	}
	g.steps += g.n;
	out.i = greater;
	out.s.clear();
	format(out.s, "greater count ", greater);
	out
}
