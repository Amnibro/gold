noun: window
modifier: at_least
context: math
phrase: merge window of at least {size} items
phrase: combine sliding window reaching at least {size} elements
slot: size int
test: list=1,2,3,4,5 size=3
expect: => i=3 r=0.0 ok=true s="merged window at least" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=3 r=0.0 ok=true s="merged window at least" errors=0 n=3 res=[30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz > g.n {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	for i in (g.n - sz + 1) {
		var s = 0;
		for k in sz { s += g.res[i + k]; }
		g.res[new_n] = s;
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n * sz;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged window at least");
	out
}
@end
