expect: => i=1 r=0.0 ok=true s="dropped head gaps 1" errors=0 n=3 res=[50,55,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dropped = 0;
	while g.n > 1 {
		let gap = g.res[1] - g.res[0];
		if gap <= lim { break; }
		for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
		g.n--;
		dropped++;
	}
	g.steps += dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped head gaps ", dropped);
	out
}
@end
