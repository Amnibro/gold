@entry f92a31be430bcca3
kind: step
verb: cache
noun: range
modifier: in_reverse
context: stats
phrase: cache sample range in reverse order
phrase: store range stats backwards in cache
test: list=10,20,5,30
expect: => i=25 r=0.0 ok=true s="reversed range 25" errors=0 n=4 res=[30,5,20,10] cache=1 hits=0
test: list=7,2,9
expect: => i=7 r=0.0 ok=true s="reversed range 7" errors=0 n=3 res=[9,2,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var lo = g.res[0];
		var hi = g.res[0];
		for i in g.n {
			let x = g.res[i];
			if x < lo { lo = x; }
			if x > hi { hi = x; }
		}
		let rng = hi - lo;
		gold_cache_put(g, rng, rng);
		out.i = rng;
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reversed range ", out.i);
	out
}
@end
