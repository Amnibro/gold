code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	var left int[512] = [0; 512];
	var right int[512] = [0; 512];
	var nl = 0;
	var nr = 0;
	for i in g.n {
		if g.res[i] < bnd {
			left[nl] = g.res[i];
			nl++;
		} else {
			right[nr] = g.res[i];
			nr++;
		}
	}
	for i in nl { g.res[i] = left[i]; }
	for i in nr { g.res[nl + i] = right[i]; }
	g.steps += g.n;
	out.i = nl;
	out.s.clear();
	format(out.s, "grouped numbers first");
	out
}
@end
