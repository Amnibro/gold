noun: middle
modifier: at_least
context: aggregate
phrase: filter middle elements reaching at least {threshold}
phrase: keep middle values having magnitude at least {threshold}
slot: threshold int
test: list=1,10,20,30,5 threshold=15
expect: => i=2 r=0.0 ok=true s="kept 2 middle items" errors=0 n=4 res=[1,20,30,5] cache=0 hits=0
test: list=2,5,8,12,3 threshold=7
expect: => i=2 r=0.0 ok=true s="kept 2 middle items" errors=0 n=4 res=[2,8,12,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n <= 2 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	for k in 1..(g.n - 1) {
		if g.res[k] >= th {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.res[kept] = g.res[g.n - 1];
	kept++;
	g.steps += g.n;
	g.n = kept;
	out.i = kept - 2;
	out.s.clear();
	format(out.s, "kept ", kept - 2, " middle items");
	out
}
@end
