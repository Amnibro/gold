fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_ch};
	if s.len == 0 || out.s.len == 0 {
		out.i = -1;
		return out;
	}
	let target = s[0];
	var last_idx = -1;
	var i = out.s.len - 1;
	while i >= 0 {
		if out.s[i] == target {
			last_idx = i;
			break;
		}
		i--;
	}
	g.steps += out.s.len;
	out.i = last_idx;
	out.s.clear();
	format(out.s, "last index: ", last_idx);
	out
}
@end
