phrase: truncate sorted search candidates within total {max_total}
slot: max_total int
test: list=30,10,20 max_total=40
expect: => i=30 r=0.0 ok=true s="sorted total limited to 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=50,15,10 max_total=30
expect: => i=25 r=0.0 ok=true s="sorted total limited to 25" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	let max_t = ${max_total};
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] > max_t { break; }
		running += g.res[i];
		kept++;
	}
	g.n = kept;
	out.i = running;
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "sorted total limited to ", running);
	out
}
@end
