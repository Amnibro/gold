code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x >= thresh {
			evens[en] = x;
			en++;
		}
	}
	// sort evens
	for i in en {
		for j in 0..(en - 1) {
			if evens[j] > evens[j + 1] {
				let tmp = evens[j];
				evens[j] = evens[j + 1];
				evens[j + 1] = tmp;
			}
		}
	}
	gold_clear(g);
	for i in en { gold_push(g, evens[i]); }
	g.steps += en;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted ", en, " evens at least threshold");
	out
}
@end
