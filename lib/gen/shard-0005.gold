fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var err_sum = 0;
	for i in g.n {
		if g.res[i] < 0 {
			let mag = -g.res[i];
			if err_sum + mag <= c {
				err_sum += mag;
			} else {
				break;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = err_sum;
	out.s.clear();
	format(out.s, "summed errors while ", err_sum);
	out
}
