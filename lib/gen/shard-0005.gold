code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let s = ${sep};
	var buf byte[..200] = "";
	let k = if lim < out.s.len { lim } else { out.s.len };
	for i in k {
		if i > 0 {
			for b in s {
				if buf.len < 195 { buf.push(b); }
			}
		}
		if buf.len < 195 { buf.push(out.s[i]); }
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += 1;
	out.i = k;
	out
}
@end
