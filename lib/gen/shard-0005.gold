test: list=10,20,10,30,20 max_total=45
expect: => i=30 r=0.0 ok=true s="unique total clamped to 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,10,15 max_total=50
expect: => i=30 r=0.0 ok=true s="unique total clamped to 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_total};
	var uniq int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in un {
			if uniq[j] == x { found = true; break; }
		}
		if !found {
			uniq[un] = x;
			un++;
		}
	}
	gold_clear(g);
	var sum = 0;
	for i in un {
		if sum + uniq[i] <= cap {
			sum += uniq[i];
			gold_push(g, uniq[i]);
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "unique total clamped to ", sum);
	out
}
@end
@entry 2054804a49b1b0cc
kind: step
verb: repeat
noun: digits
modifier: all
context: math
phrase: repeat all individual digits across items
phrase: expand numbers into repeated digit values
test: list=12,34
expect: => i=4 r=0.0 ok=true s="extracted 4 digits" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=508,7
expect: => i=4 r=0.0 ok=true s="extracted 4 digits" errors=0 n=4 res=[5,0,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		let x = g.res[i];
		var temp = if x < 0 { -x } else { x };
		if temp == 0 {
			digits[dn] = 0;
			dn++;
		} else {
			var cur_d int[32] = [0; 32];
			var cn = 0;
			while temp > 0 {
				cur_d[cn] = temp % 10;
				cn++;
				temp /= 10;
			}
			var j = cn - 1;
			while j >= 0 {
				digits[dn] = cur_d[j];
				dn++;
				j--;
			}
		}
	}
	gold_clear(g);
	for i in dn { gold_push(g, digits[i]); }
	g.steps += dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "extracted ", dn, " digits");
	out
}
@end
