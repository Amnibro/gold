expect: => i=2 r=0.0 ok=true s="tally: unique=2" errors=0 n=5 res=[3,3,5,5,5] cache=2 hits=3
test: list=8,8,8,8
expect: => i=1 r=0.0 ok=true s="tally: unique=1" errors=0 n=4 res=[8,8,8,8] cache=1 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "tally: ");
	var unique = 0;
	for i in g.n {
		let x = g.res[i];
		let prev, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, prev + 1);
		} else {
			gold_cache_put(g, x, 1);
			unique++;
		}
	}
	format(out.s, "unique=", unique);
	out.i = unique;
	g.steps += g.n;
	out
}
@end
