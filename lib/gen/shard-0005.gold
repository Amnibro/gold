	var out = v;
	if g.n == 0 { return out; }
	var count = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			count++;
		} else {
			break;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "running head length: ", count);
	out
}
@end
