fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var zeroed = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if seen {
			g.res[i] = 0;
			zeroed++;
		}
	}
	g.steps += g.n * g.n;
	out.i = zeroed;
	out.s.clear();
	format(out.s, "zeroed ", zeroed, " duplicates");
	out
}
@end
@entry 2ac109713722e784
kind: step
verb: limit
noun: runs
modifier: up_to
context: aggregate
phrase: limit contiguous runs up to length {max_run}
phrase: truncate identical runs to bound {max_run}
slot: max_run int
test: list=1,1,1,1,2,2,2 max_run=2
expect: => i=4 r=0.0 ok=true s="limited runs kept 4 elements" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=7,7,7,7,7 max_run=3
expect: => i=3 r=0.0 ok=true s="limited runs kept 3 elements" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	if g.n == 0 || limit <= 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let take = if run_len < limit { run_len } else { limit };
		for k in take {
			g.res[kept] = g.res[i];
			kept++;
		}
		i = j;
	}
	g.steps += i;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited runs kept ", kept, " elements");
	out
}
@end
