phrase: shift prefix by {delta} if any satisfies {p}
phrase: adjust sample prefix by {delta} on any condition {p}
slot: p pred
slot: delta int
test: list=1,3,4,7 p=is_even delta=5
expect: => i=2 r=0.0 ok=true s="shifted prefix count 2" errors=0 n=4 res=[6,8,4,7] cache=0 hits=0
test: list=1,3,5 p=is_even delta=5
expect: => i=0 r=0.0 ok=true s="shifted prefix count 0" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let offset = ${delta};
	var matched = false;
	for i in g.n {
		if ${p}(g.res[i]) {
			matched = true;
			break;
		}
	}
	if matched {
		let half = g.n / 2;
		for i in half { g.res[i] += offset; }
		out.i = half;
	} else {
		out.i = 0;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "shifted prefix count ", out.i);
	out
}
@end
