code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var no = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[no] = g.res[k];
			no++;
		}
	}
	for i in no {
		for j in (i + 1)..no {
			if odds[i] > odds[j] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
		}
	}
	var total = 0;
	for k in no {
		g.res[k] = odds[k];
		total += odds[k];
	}
	g.n = no;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sorted odds sum=", total);
	out
}
@end
