code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < out.s.len && ${ch}(out.s[count] as int) {
		count++;
	}
	if count > 1 {
		for i in count {
			for j in 0..(count - 1) {
				if out.s[j] > out.s[j + 1] {
					let tmp = out.s[j];
					out.s[j] = out.s[j + 1];
					out.s[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += count;
	out.i = count;
	out
}
@end
@entry ac13c4abccde5b10
kind: step
verb: rotate
noun: limit
modifier: nested
context: text
phrase: rotate characters below limit nested {lim}
phrase: shift letter values under limit nested {lim}
slot: lim int
test: text="fedcba" lim=100
expect: => i=4 r=0.0 ok=true s="feadcb" errors=0 n=0 res=[] cache=0 hits=0
test: text="XYZabc" lim=90
expect: => i=3 r=0.0 ok=true s="ZXYabc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var pos int[200] = [0; 200];
	var pn = 0;
	for i in out.s.len {
		if (out.s[i] as int) <= limit {
			pos[pn] = i;
			pn++;
		}
	}
	if pn > 1 {
		let last = out.s[pos[pn - 1]];
		var i = pn - 1;
		while i > 0 {
			out.s[pos[i]] = out.s[pos[i - 1]];
			i--;
		}
		out.s[pos[0]] = last;
	}
	g.steps += out.s.len;
	out.i = pn;
	out
}
@end
