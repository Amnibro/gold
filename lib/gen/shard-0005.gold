fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dsum = 0;
	if g.n > 0 {
		var x = g.res[0];
		if x < 0 { x = -x; }
		while x > 0 {
			dsum += x % 10;
			x /= 10;
		}
	}
	out.i = dsum;
	g.steps += 1;
	out.s.clear();
	format(out.s, "first item digit sum ", dsum);
	out
}
