@entry 4b038b10c571cd6e
kind: step
verb: rank
noun: streak
modifier: at_most
context: math
phrase: rank streak lengths at most {limit}
phrase: score consecutive run lengths at most {limit}
slot: limit int
test: list=2,2,2,2,3,3 limit=3
expect: => i=3 r=0.0 ok=true s="streak ranked at most 3" errors=0 n=6 res=[2,2,2,2,3,3] cache=0 hits=0
test: list=5,5,6,6,6,6,6 limit=4
expect: => i=4 r=0.0 ok=true s="streak ranked at most 4" errors=0 n=7 res=[5,5,6,6,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var max_streak = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len > max_streak { max_streak = run_len; }
		i = j;
	}
	let ranked = if max_streak > cap { cap } else { max_streak };
	g.steps += g.n;
	out.i = ranked;
	out.s.clear();
	format(out.s, "streak ranked at most ", ranked);
	out
}
@end
