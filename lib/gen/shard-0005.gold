expect: => i=2 r=0.0 ok=true s="retained count 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,5,5
expect: => i=3 r=0.0 ok=true s="retained count 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		var kept = 0;
		for i in g.n {
			if g.res[i] >= avg {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		if kept == 0 {
			g.n = 1;
		} else {
			g.n = kept;
		}
		out.i = g.n;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "retained count ", out.i);
	out
}
@end
