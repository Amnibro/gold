fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct int[512] = [0; 512];
	var freqs int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in dn {
			if distinct[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			freqs[idx] += 1;
		} else {
			distinct[dn] = x;
			freqs[dn] = 1;
			dn++;
		}
	}
	gold_clear(g);
	var kept = 0;
	for i in dn {
		if i % 2 == 0 {
			gold_push(g, freqs[i]);
			kept++;
		}
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "alternate histogram bins: ", kept);
	out
}
@end
@entry 0cda18b30e359160
kind: step
verb: rotate
noun: range
modifier: sorted
context: math
phrase: rotate sorted range between indices {start} to {stop}
phrase: cycle ordered range from {start} through {stop}
slot: start int
slot: stop int
test: list=10,50,40,30,20 start=1 stop=3
expect: => i=3 r=0.0 ok=true s="range rotated len 3" errors=0 n=5 res=[10,50,30,40,20] cache=0 hits=0
test: list=9,4,3,2,1 start=0 stop=2
expect: => i=3 r=0.0 ok=true s="range rotated len 3" errors=0 n=5 res=[9,3,4,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let a = ${start};
	let b = ${stop};
	if a < 0 || b >= g.n || a >= b { return out; }
	// sort range [a..b]
	for i in a..(b + 1) {
		for j in a..b {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	// rotate [a..b] right by 1
	let last = g.res[b];
	var k = b;
	while k > a {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[a] = last;
	g.steps += b - a + 1;
	out.i = b - a + 1;
	out.s.clear();
	format(out.s, "range rotated len ", out.i);
	out
}
@end
