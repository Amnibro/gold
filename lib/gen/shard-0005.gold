fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	while passes < 10 {
		var any_match = false;
		for i in g.n {
			if ${p}(g.res[i]) { any_match = true; break; }
		}
		if any_match { break; }
		for i in g.n {
			g.res[i] /= 2;
		}
		passes++;
	}
	out.i = passes;
	g.steps += passes;
	out.s.clear();
	format(out.s, "range normalization passes ", passes);
	out
}
@end
