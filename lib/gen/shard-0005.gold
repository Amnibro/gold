fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var clamped = 0;
	for k in g.n {
		if g.res[k] < lo {
			g.res[k] = lo;
			clamped++;
		} else if g.res[k] > hi {
			g.res[k] = hi;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values safely");
	out
}
@end
