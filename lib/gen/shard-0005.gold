fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	var i = 0;
	while i + 1 < g.n {
		if core_is_prime(g.res[i]) && core_is_prime(g.res[i + 1]) {
			let temp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = temp;
			prime_count += 2;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "swapped adjacent primes count ", prime_count);
	out
}
