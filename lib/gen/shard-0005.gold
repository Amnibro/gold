code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${target};
	if g.n >= 2 {
		let step = g.res[g.n - 1] - g.res[g.n - 2];
		var curr = g.res[g.n - 1];
		while curr + step <= bound && step > 0 {
			curr += step;
			gold_push(g, curr);
		}
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "filled series to size ", g.n);
	out
}
@end
