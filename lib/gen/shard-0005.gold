fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in 1..g.n {
		if g.res[k] < g.res[k - 1] {
			g.res[k] = g.res[k - 1];
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "running maximum peak: ", out.i);
	out
}
