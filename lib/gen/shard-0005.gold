code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${maxdrop};
	var dropped = 0;
	var start = 0;
	while start < g.n && dropped < md && g.res[start] % 2 == 0 {
		dropped++;
		start++;
	}
	var kept = 0;
	for i in start..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n + dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop evens first");
	out
}
@end
