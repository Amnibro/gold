fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sample");
		out.ok = false;
		return out;
	}
	let start = if g.n >= 2 { g.n - 2 } else { 0 };
	var found_val = 0;
	var ok = false;
	for k in start..g.n {
		if ${cond}(g.res[k]) {
			found_val = g.res[k];
			ok = true;
			break;
		}
	}
	if !ok {
		gold_fail(g, "no suffix match");
		out.ok = false;
	}
	out.i = found_val;
	out.s.clear();
	format(out.s, "suffix match: ", found_val);
	out
}
@end
