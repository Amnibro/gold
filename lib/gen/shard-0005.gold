code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var stored = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = (g.res[i + 1] - g.res[i]) * sc;
			gold_cache_put(g, stored, diff);
			stored++;
		}
	}
	g.steps += stored + 1;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached pairwise history ", stored);
	out
}
@end
