@entry fe602fa76707cf77
kind: step
verb: repeat
noun: streak
modifier: times
context: text
phrase: repeat longest letter streak {times} times
phrase: duplicate longest character run {times} times
slot: times int
test: text="abbcccde" times=2
expect: => i=3 r=0.0 ok=true s="abbcccdecc" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" times=3
expect: => i=2 r=0.0 ok=true s="mississippisss" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${times};
	if out.s.len == 0 { return out; }
	var max_streak = 0;
	var best_char = out.s[0];
	var i = 0;
	while i < out.s.len {
		var j = i;
		while j < out.s.len && out.s[j] == out.s[i] { j++; }
		let run_len = j - i;
		if run_len > max_streak {
			max_streak = run_len;
			best_char = out.s[i];
		}
		i = j;
	}
	for _ in r {
		if out.s.len < 200 { out.s.push(best_char); }
	}
	g.steps += out.s.len;
	out.i = max_streak;
	out
}
@end
