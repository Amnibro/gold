fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var space_count = 0;
	var end_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] == ' ' {
			space_count++;
			if space_count == d {
				end_idx = i;
				break;
			}
		}
	}
	out.s.resize(end_idx, ' ');
	g.steps += 1;
	out.i = space_count;
	out
}
