phrase: exchange items transformed by {sub} up to position {cap}
slot: sub fn
slot: cap int
test: list=9,2,8,3,7 sub=square cap=4
expect: => i=2 r=0.0 ok=true s="performed 2 subfunction swaps" errors=0 n=5 res=[2,9,3,8,7] cache=0 hits=0
test: list=15,12,30,10 sub=digit_sum cap=3
expect: => i=2 r=0.0 ok=true s="performed 2 subfunction swaps" errors=0 n=4 res=[12,15,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var swaps = 0;
	var idx = 0;
	while idx + 1 < g.n && idx < limit {
		if ${sub}(g.res[idx]) > ${sub}(g.res[idx + 1]) {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			swaps++;
		}
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " subfunction swaps");
	out
}
@end
