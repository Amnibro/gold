fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_freq = ${min_count};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq >= min_freq {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept elements with count at least ", min_freq, " total ", kept);
	out
}
@end
