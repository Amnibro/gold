fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = if g.n >= 3 { g.n - 3 } else { 0 };
	for i in start..g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	out.i = g.cn;
	g.steps += (g.n - start);
	out.s.clear();
	format(out.s, "tail cached count ", g.cn);
	out
}
