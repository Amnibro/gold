	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var bound = if g.n < count { g.n } else { count };
	var total_gap = 0;
	for k in 0..bound - 1 {
		let diff = g.res[k + 1] - g.res[k];
		total_gap += if diff < 0 { -diff } else { diff };
	}
	out.i = total_gap;
	g.steps += bound;
	out.s.clear();
	format(out.s, "total gap in first items: ", total_gap);
	out
}
@end
