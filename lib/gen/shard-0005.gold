@entry 7fbd58f0cd6595ce
kind: step
verb: reverse
noun: memo
modifier: with_cache
context: core
phrase: reverse memo table with cache update
phrase: invert memoized entries into cache
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="memo reversed: 3" errors=0 n=3 res=[30,20,10] cache=3 hits=0
test: list=5,15,25,35
expect: => i=4 r=0.0 ok=true s="memo reversed: 4" errors=0 n=4 res=[35,25,15,5] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for k in half {
		let t = g.res[k];
		g.res[k] = g.res[g.n - 1 - k];
		g.res[g.n - 1 - k] = t;
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "memo reversed: ", g.n);
	out
}
@end
