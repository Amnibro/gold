fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 || tgt <= g.n {
		g.steps += 1;
		return out;
	}
	let orig = g.n;
	var idx = 0;
	while g.n < tgt && g.n < 512 {
		gold_push(g, g.res[idx % orig]);
		idx++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated pattern to length ", g.n);
	out
}
@end
