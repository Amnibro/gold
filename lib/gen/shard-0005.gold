@entry 416e693c3f50fc2c
kind: step
verb: swap
noun: history
modifier: in_reverse
context: stats
phrase: swap observation history elements from outer bounds inward
phrase: exchange symmetrical pairs across sample history in reverse
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="performed 2 outer history swaps" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="performed 3 outer history swaps" errors=0 n=6 res=[6,5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		swaps++;
		left++;
		right--;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " outer history swaps");
	out
}
@end
