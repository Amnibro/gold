code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var sum_sq = 0;
	var stored = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sum_sq + sq <= c {
			gold_cache_put(g, stored, sq);
			sum_sq += sq;
			stored++;
		} else {
			break;
		}
	}
	g.steps += stored + 1;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached squares count ", stored);
	out
}
@end
