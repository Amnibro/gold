fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let bound = if c < g.n { c } else { g.n };
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = bound;
	g.steps += bound + 1;
	out.s.clear();
	format(out.s, "sorted prefix span ", bound);
	out
}
@end
