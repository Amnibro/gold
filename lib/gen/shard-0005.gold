code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[>..] = [];
	var in_space = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			if !in_space {
				res.push(' ');
				in_space = true;
			}
		} else {
			res.push(c);
			in_space = false;
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
