expect: => i=2 r=0.0 ok=true s="grouped safely into 2 totals" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 { return out; }
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		var sum = 0;
		for k in sz {
			if idx + k < g.n { sum += g.res[idx + k]; }
		}
		new_res[new_n] = sum;
		new_n++;
		idx += sz;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped safely into ", new_n, " totals");
	out
}
@end
