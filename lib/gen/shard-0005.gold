@entry 13898989b8e36aa5
kind: step
verb: pair
noun: prefix
modifier: safely
context: retry
phrase: pair prefix elements safely within retry cap {cap}
phrase: group prefix pairs safely up to bound {cap}
slot: cap int
test: list=10,20,30,40 cap=2
expect: => i=2 r=0.0 ok=true s="paired prefix safely: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10 cap=2
expect: => i=0 r=0.0 ok=false s="paired prefix safely: 0" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var pairs = 0;
	var bound = c * 2;
	if bound > g.n { bound = g.n; }
	if bound >= 2 {
		var k = 0;
		while k + 1 < bound {
			pairs++;
			k += 2;
		}
	} else {
		gold_fail(g, "insufficient prefix items");
		out.ok = false;
	}
	g.steps += bound;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired prefix safely: ", pairs);
	out
}
@end
@entry ff99503932bf737f
kind: step
verb: scale
noun: pairs
modifier: at_least
context: retry
phrase: scale pairs of at least threshold {min_val}
phrase: multiply pair sums of at least bound {min_val}
slot: min_val int
test: list=10,20,5,15 min_val=25
expect: => i=1 r=0.0 ok=true s="scaled pairs at least: 1" errors=0 n=4 res=[20,40,5,15] cache=0 hits=0
test: list=2,4 min_val=20
expect: => i=0 r=0.0 ok=false s="scaled pairs at least: 0" errors=1 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var scaled = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			let s = g.res[k] + g.res[k + 1];
			if s >= mv {
				g.res[k] *= 2;
				g.res[k + 1] *= 2;
				scaled++;
			}
			k += 2;
		}
	}
	if scaled == 0 {
		gold_fail(g, "no pairs met threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled pairs at least: ", scaled);
	out
}
@end
@entry 6a838ea84de813d0
kind: step
verb: clamp
noun: budget
modifier: until
context: math
phrase: clamp budget sum until limit {lim}
phrase: restrict budget total until {lim}
slot: lim int
test: list=10,20,30,40 lim=55
expect: => i=30 r=0.0 ok=true s="budget clamped at 2 items" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 lim=100
expect: => i=30 r=0.0 ok=true s="budget sum 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] > limit {
			break;
		}
		sum += g.res[k];
		count++;
	}
	let orig_n = g.n;
	g.n = count;
	g.steps += count;
	out.i = sum;
	out.s.clear();
	if count < orig_n {
		format(out.s, "budget clamped at ", count, " items");
	} else {
		format(out.s, "budget sum ", sum);
	}
	out
}
@end
@entry 4ba572a815b3a5f0
kind: step
verb: sort
noun: tally
modifier: last
context: math
phrase: sort tally count of last {cnt} items
phrase: order frequencies of trailing {cnt} values
slot: cnt int
test: list=10,20,50,30,40 cnt=3
expect: => i=3 r=0.0 ok=true s="sorted last 3 elements" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,9,8,2 cnt=2
expect: => i=2 r=0.0 ok=true s="sorted last 2 elements" errors=0 n=4 res=[1,9,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cnt};
	let start = if g.n > c { g.n - c } else { 0 };
	for i in start..g.n {
		for j in start..(g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "sorted last ", out.i, " elements");
	out
}
@end
@entry c4527c774957936c
kind: step
verb: validate
noun: step
modifier: with_cache
context: math
phrase: validate progression steps using cached delta
phrase: verify sequence increments with cache validation
test: list=2,4,6,8
expect: => i=1 r=0.0 ok=true s="steps valid with diff 2" errors=0 n=4 res=[2,4,6,8] cache=1 hits=0
test: list=1,3,7,9
expect: => i=0 r=0.0 ok=false s="invalid step progression" errors=0 n=4 res=[1,3,7,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 1;
		return out;
	}
	let expected_diff = g.res[1] - g.res[0];
	gold_cache_put(g, 0, expected_diff);
	var valid = true;
	for i in 1..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff != expected_diff {
			valid = false;
			break;
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	if valid {
		format(out.s, "steps valid with diff ", expected_diff);
	} else {
		format(out.s, "invalid step progression");
	}
	out
}
@end
