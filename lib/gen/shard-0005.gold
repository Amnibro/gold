expect: => i=14 r=0.0 ok=true s="nested diff sum 14" errors=0 n=3 res=[5,12,14] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_diff = 0;
	if g.n > 1 {
		for i in g.n {
			for j in g.n {
				let diff = core_abs_val(g.res[i] - g.res[j]);
				total_diff += diff;
				gold_cache_put(g, diff, diff);
			}
		}
	}
	out.i = total_diff;
	gold_push(g, total_diff);
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "nested diff sum ", total_diff);
	out
}
@end
