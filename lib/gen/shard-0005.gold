phrase: filter duplicate running digit totals
test: list=12,21,30,14
expect: => i=2 r=0.0 ok=true s="kept 2 distinct digit sums" errors=0 n=2 res=[12,14] cache=0 hits=0
test: list=101,20,11,111
expect: => i=2 r=0.0 ok=true s="kept 2 distinct digit sums" errors=0 n=2 res=[101,111] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[512] = [0; 512];
	var sn = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var dsum = 0;
		var temp = if x < 0 { -x } else { x };
		while temp > 0 { dsum += temp % 10; temp /= 10; }
		var found = false;
		for j in sn {
			if seen[j] == dsum { found = true; break; }
		}
		if !found {
			seen[sn] = dsum;
			sn++;
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " distinct digit sums");
	out
}
@end
@entry 5eb6c35a11e41d6f
kind: step
verb: filter
noun: steps
modifier: at_most
context: math
phrase: filter step deltas at most {max_step}
phrase: keep consecutive steps at most {max_step}
slot: max_step int
test: list=1,3,7,8,15 max_step=3
expect: => i=3 r=0.0 ok=true s="filtered steps to 3" errors=0 n=3 res=[1,3,8] cache=0 hits=0
test: list=10,12,18,19 max_step=2
expect: => i=3 r=0.0 ok=true s="filtered steps to 3" errors=0 n=3 res=[10,12,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_step};
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= limit {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered steps to ", kept);
	out
}
@end
@entry ff5bde3a463e054d
kind: step
verb: sort
noun: tally
modifier: sorted
context: math
phrase: sort elements by tally frequency sorted
phrase: order items by occurrence count sorted
test: list=5,2,5,3,2,5
expect: => i=6 r=0.0 ok=true s="sorted tally of 6 items" errors=0 n=6 res=[3,2,2,5,5,5] cache=0 hits=0
test: list=9,8,8,7,7,7
expect: => i=6 r=0.0 ok=true s="sorted tally of 6 items" errors=0 n=6 res=[9,8,8,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// bubble sort by frequency ascending, then by value
	for i in g.n {
		for j in 0..(g.n - 1) {
			let a = g.res[j];
			let b = g.res[j + 1];
			var fa = 0;
			var fb = 0;
			for k in g.n {
				if g.res[k] == a { fa++; }
				if g.res[k] == b { fb++; }
			}
			if fa > fb || (fa == fb && a > b) {
				g.res[j] = b;
				g.res[j + 1] = a;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted tally of ", g.n, " items");
	out
}
@end
