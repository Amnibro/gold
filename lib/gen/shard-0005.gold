@entry ca6464e2d0dbe591
kind: step
verb: dedupe
noun: values
modifier: nested
context: stats
phrase: dedupe list values using nested search
phrase: remove repeated items via nested scan
test: list=3,1,3,2,1,4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[3,1,2,4] cache=0 hits=0
test: list=9,9,8,7,8
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		var seen = false;
		for j in write_idx {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	let dropped = g.n - write_idx;
	g.steps += g.n;
	g.n = write_idx;
	out.i = dropped;
	out
}
@end
