fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var count = 0;
	for i in g.n - 1 {
		let d = g.res[i + 1] - g.res[i];
		g.res[count] = if d < 0 { -d } else { d };
		count++;
	}
	g.n = count;
	out.i = count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "pairwise differences mapped ", count);
	out
}
@end
