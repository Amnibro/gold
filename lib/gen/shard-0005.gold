@entry ec25d81eb900b1b5
kind: step
verb: validate
noun: window
modifier: safely
context: retry
phrase: validate retry window safely within {max_span}
phrase: ensure retry window span safely below {max_span}
slot: max_span int
test: list=10,12,15 max_span=10
expect: => i=5 r=0.0 ok=true s="window span is 5" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=10,25 max_span=10
expect: => i=15 r=0.0 ok=false s="window span is 15" errors=0 n=2 res=[10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let limit = ${max_span};
	var out = v;
	if g.n <= 1 {
		out.ok = true;
		return out;
	}
	var min_v = g.res[0];
	var max_v = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_v { min_v = g.res[k]; }
		if g.res[k] > max_v { max_v = g.res[k]; }
	}
	let span = max_v - min_v;
	out.ok = (span <= limit);
	out.i = span;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "window span is ", span);
	out
}
@end
