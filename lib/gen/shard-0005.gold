fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_errs int[256] = [0; 256];
	var counts int[256] = [0; 256];
	var nu = 0;
	for k in g.n {
		let x = g.res[k];
		if x < 0 {
			var found = -1;
			for j in nu { if uniq_errs[j] == x { found = j; break; } }
			if found >= 0 { counts[found]++; }
			else { uniq_errs[nu] = x; counts[nu] = 1; nu++; }
		}
	}
	if nu > 0 { gold_fail(g, "distinct errors found"); }
	for i in nu { g.res[i] = counts[i]; }
	g.n = nu;
	g.steps += g.n;
	out.i = nu;
	out.s.clear();
	format(out.s, "distinct errors ", nu);
	out
}
@end
