@entry 405fd26af75396ef
kind: step
verb: drop
noun: streak
modifier: running
context: core
phrase: drop running streak exceeding length {maxlen}
phrase: trim running streak longer than {maxlen}
slot: maxlen int
test: list=1,1,1,2,2 maxlen=2
expect: => i=1 r=0.0 ok=true s="dropped running streak" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,5,5,6 maxlen=1
expect: => i=3 r=0.0 ok=true s="dropped running streak" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${maxlen};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let streak = j - i;
		let keep_count = if streak < ml { streak } else { ml };
		for k in keep_count {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		i = j;
	}
	let dropped = g.n - new_n;
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped running streak");
	out
}
@end
