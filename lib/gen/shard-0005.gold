noun: history
modifier: pairwise
context: sort
phrase: cache history pairwise sorted ranks using scale {scale}
phrase: record pairwise sorted history metrics scaled by {scale}
slot: scale int
test: list=10,25,40,55 scale=2
expect: => i=3 r=0.0 ok=true s="cached pairwise history 3" errors=0 n=4 res=[10,25,40,55] cache=3 hits=0
