code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = true;
	while changed {
		changed = false;
		var cur byte[..200] = "";
		for k in out.s.len {
			let b = out.s[k];
			if cur.len == 0 || b != cur[cur.len - 1] {
				cur.push(b);
			} else {
				changed = true;
			}
		}
		out.s.clear();
		for b in cur { out.s.push(b); }
	}
	out.i = out.s.len;
	out
}
@end
