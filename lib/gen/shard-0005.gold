fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${k};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if lim < g.n && lim >= 0 { g.n = lim; }
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted history count ", g.n);
	out
}
@end
