fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < out.s.len && !${cond}(out.s[idx] as int) {
		idx++;
	}
	for i in 0..(idx / 2) {
		let tmp = out.s[i];
		out.s[i] = out.s[idx - 1 - i];
		out.s[idx - 1 - i] = tmp;
	}
	out.i = idx;
	out
}
