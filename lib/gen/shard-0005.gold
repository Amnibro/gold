@entry bff306824c108566
kind: step
verb: compare
noun: loop
modifier: unique
context: search
phrase: compare loop search results counting unique values
phrase: count distinct candidate values in search loop
test: list=10,20,10,30,20
expect: => i=3 r=0.0 ok=true s="unique count 3" errors=0 n=6 res=[10,20,10,30,20,3] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="unique count 1" errors=0 n=4 res=[5,5,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { unique_count++; }
	}
	out.i = unique_count;
	gold_push(g, unique_count);
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "unique count ", unique_count);
	out
}
@end
