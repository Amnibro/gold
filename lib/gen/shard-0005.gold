code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} > g.n { g.n } else { ${k} };
	let f = ${factor};
	let t = ${times};
	var mult = 1;
	for rep in t { mult *= f; }
	for i in limit {
		g.res[i] *= mult;
	}
	out.i = mult;
	out.s.clear();
	format(out.s, "scaled head of ", limit, " items by ", mult);
	out
}
@end
