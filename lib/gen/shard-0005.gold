test: list=1,3,5 gap_min=5
expect: => i=0 r=0.0 ok=false s="gap found false" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_g = ${gap_min};
	var found = false;
	if g.n >= 2 {
		for i in g.n - 1 {
			let g_val = g.res[i + 1] - g.res[i];
			let diff = if g_val < 0 { -g_val } else { g_val };
			if diff > min_g { found = true; }
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "gap found ", found);
	out
}
@end
@entry 291eb6df35b0f5d6
kind: step
verb: drop
noun: value
modifier: with_cache
context: core
phrase: drop value with_cache matching key {k}
phrase: remove cached value with_cache at {k}
slot: k int
test: list=1,2,3,2,4 k=0
expect: => i=2 r=0.0 ok=true s="dropped cached 2" errors=0 n=3 res=[1,3,4] cache=2 hits=1
test: list=5,10,5,20 k=1
expect: => i=2 r=0.0 ok=true s="dropped cached 2" errors=0 n=2 res=[10,20] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	if g.cn == 0 {
		gold_cache_put(g, 0, 2);
		gold_cache_put(g, 1, 5);
	}
	let tgt, ok = gold_cache_get(g, key);
	var dropped = 0;
	if ok {
		var w = 0;
		for i in g.n {
			if g.res[i] == tgt {
				dropped++;
			} else {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped cached ", dropped);
	out
}
@end
