expect: => i=1 r=0.0 ok=true s="dropped alternating primes 1" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_drop};
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		if i % 2 == 0 && core_is_prime(g.res[i]) && dropped < md {
			dropped++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped alternating primes ", dropped);
	out
}
@end
