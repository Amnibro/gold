code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in out.s.len {
		var max_idx = i;
		for j in (i + 1)..out.s.len {
			if out.s[j] > out.s[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = out.s[i];
			out.s[i] = out.s[max_idx];
			out.s[max_idx] = tmp;
		}
	}
	g.steps += out.s.len * out.s.len;
	out.i = out.s.len;
