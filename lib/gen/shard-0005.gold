	out.s.clear();
	for b in new_s { out.s.push(b); }
	gold_cache_put(g, 0, dropped);
	g.steps += out.s.len + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped vowels first ", dropped);
	out
}
