	out.s.clear();
	let cap = ${budget};
	format(out.s, "budgeted: [");
	var sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if sum + x > cap { break; }
		if count > 0 { format(out.s, ", "); }
		format(out.s, x);
		sum += x;
		count++;
	}
	format(out.s, "] total=", sum);
	out.i = sum;
	g.steps += count;
	out
}
@end
