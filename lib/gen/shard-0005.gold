@entry 3abb48d95e07256b
kind: step
verb: dedupe
noun: window
modifier: sorted
context: text
phrase: dedupe sorted characters in window {w}
phrase: remove duplicates within sorted window {w}
slot: w int
test: text="aaabbbccc" w=3
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcde" w=2
expect: => i=5 r=0.0 ok=true s="abcde" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 1 { return out; }
	var res byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let end_idx = if i + win < out.s.len { i + win } else { out.s.len };
		var prev = 0 as byte;
		for j in i..end_idx {
			let c = out.s[j];
			if j == i || c != prev {
				if res.len < 200 { res.push(c); }
				prev = c;
			}
		}
		i = end_idx;
	}
	out.s = res;
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
