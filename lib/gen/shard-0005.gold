@entry b25b1a8bd6e18aa3
kind: step
verb: scan
noun: text
modifier: last
context: format
phrase: format last {count} characters of text
phrase: display trailing suffix of text buffer by count {count}
slot: count int
test: text="hello world" count=5
expect: => i=5 r=0.0 ok=true s="world" errors=0 n=0 res=[] cache=0 hits=0
test: text="foobar" count=3
expect: => i=3 r=0.0 ok=true s="bar" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let take = if c < out.s.len { c } else { out.s.len };
	let start = out.s.len - take;
	var res byte[>..] = [];
	for k in take {
		res.push(out.s[start + k]);
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += take;
	out.i = take;
	out
}
@end
