noun: function
modifier: any
context: retry
phrase: rotate retry results by {shift} positions
phrase: cyclic rotation of retry values by {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=0 r=0.0 ok=true s="rotated results by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=0 r=0.0 ok=true s="rotated results by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let s = ${shift};
	var out = v;
	if g.n <= 1 { return out; }
	let k = ((s % g.n) + g.n) % g.n;
	if k == 0 { return out; }
	var tmp = [0; 512];
	for i in g.n {
		tmp[(i + k) % g.n] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated results by ", k);
	out
}
@end
