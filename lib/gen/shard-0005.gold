code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${min_err};
	let mx = ${max_err};
	let within = g.errors >= mn && g.errors <= mx;
	if !within {
		gold_fail(g, "error count outside allowable range");
	}
	out.ok = within;
	out.i = g.errors;
	g.steps += 1;
	out.s.clear();
	if within {
		out.s.append("errors within tolerance");
	} else {
		out.s.append("errors out of tolerance");
	}
	out
}
@end
