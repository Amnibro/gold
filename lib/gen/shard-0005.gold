	let span = if c < g.n { c } else { g.n };
	if span > 1 {
		var l = g.n - span;
		var r = g.n - 1;
		while l < r {
			let t = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = t;
			l++;
			r--;
		}
	}
	out.i = span;
	g.steps += span + 1;
	out.s.clear();
	format(out.s, "reversed tail span ", span);
	out
}
@end
