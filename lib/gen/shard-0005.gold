fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var diff_sum = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		diff_sum += if cur >= prev { cur - prev } else { prev - cur };
		prev = cur;
		x /= 10;
	}
	diff_sum
}
@end
