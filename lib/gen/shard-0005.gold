@entry 665a490b36794080
kind: step
verb: search
noun: checkpoint
modifier: recursively
context: sort
phrase: search checkpoint recursively for target value {target}
phrase: find binary search checkpoint recursively for {target}
slot: target int
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="checkpoint index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35 target=99
expect: => i=-1 r=0.0 ok=true s="checkpoint index -1" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "checkpoint index ", found);
	out
}
@end
@entry 26c46dfd3d632d89
kind: step
verb: join
noun: sequence
modifier: with_retry
context: sort
phrase: join sequence with retry tolerance {retries} step {step}
phrase: accumulate sorted sequence with retry allowance {retries} step {step}
slot: retries int
slot: step int
test: list=2,4,6,9,10 retries=1 step=2
expect: => i=12 r=0.0 ok=true s="sequence sum 12" errors=0 n=5 res=[2,4,6,9,10] cache=0 hits=0
test: list=1,3,5,7,9 retries=0 step=2
expect: => i=25 r=0.0 ok=true s="sequence sum 25" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	let st = ${step};
	var sum = 0;
	var errors = 0;
	if g.n > 0 {
		sum += g.res[0];
		for k in 1..g.n {
			let diff = g.res[k] - g.res[k - 1];
			if diff == st {
				sum += g.res[k];
			} else {
				errors++;
				if errors > r { break; }
			}
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "sequence sum ", sum);
	out
}
@end
