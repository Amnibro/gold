fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var count = 0;
	if m > 0 {
		for i in g.n {
			var x = g.res[i];
			if x < 0 { x = -x; }
			var d = 0;
			while x > 0 { d++; x /= 10; }
			if d == 0 { d = 1; }
			if d % m == 0 { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "matching digit count: ", count);
	out
}
