code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 { digits = 1; }
		while x > 0 {
			digits++;
			x /= 10;
		}
		if digits % 2 == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "even digit count kept ", kept);
	out
}
@end
