fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	var streak = 0;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i >= 0 && g.res[i] == last_val {
			streak++;
			i--;
		}
	}
	let valid = streak >= ms;
	out.ok = valid;
	out.i = streak;
	g.steps += streak;
	out.s.clear();
	if valid {
		format(out.s, "last streak valid: ", streak);
	} else {
		gold_fail(g, "last streak too short");
		format(out.s, "last streak invalid: ", streak);
	}
	out
}
