code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let sc = ${scale};
	var idx = 0;
	while idx < g.n && idx < ml {
		g.res[idx] *= sc;
		idx++;
	}
	g.steps += idx + 1;
	out.i = idx;
	out.s.clear();
	format(out.s, "normalized prefix count ", idx);
	out
}
