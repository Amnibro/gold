fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var total = 0;
	for k in g.n { total += g.res[k]; }
	let avg = total / g.n;
	for k in g.n {
		g.res[k] *= avg;
