expect: => i=2 r=0.0 ok=true s="last maximum at index 2" errors=0 n=4 res=[5,3,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = -1;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var last_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == max_val {
			last_idx = i;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = last_idx;
	out.s.clear();
	format(out.s, "last maximum at index ", last_idx);
	out
}
@end
