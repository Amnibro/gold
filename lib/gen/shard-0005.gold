kind: step
verb: select
noun: squares
modifier: unique
context: cache
phrase: select squares unique up to cap {cap}
phrase: gather unique square elements below {cap}
slot: cap int
test: list=1,4,9,16 cap=10
expect: => i=3 r=0.0 ok=true s="unique squares selected 3" errors=0 n=3 res=[1,4,9] cache=1 hits=0
