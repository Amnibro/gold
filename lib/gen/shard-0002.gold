fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp = [0; 512];
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == 1 {
			tmp[kept] = x;
			kept++;
		}
	}
	for i in kept {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
