code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = if ${limit} < g.n { ${limit} } else { g.n };
	for i in lim / 2 {
		let j = lim - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed prefix of ", lim, " items");
	out
}
@end
