@entry e964cdd1ca5a276c
kind: step
verb: shift
noun: values
modifier: times
context: math
phrase: shift values cyclic times {times}
phrase: rotate list elements {times} times
slot: times int
test: list=1,2,3,4 times=1
expect: => i=4 r=0.0 ok=true s="shifted values count: 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30,40 times=2
expect: => i=4 r=0.0 ok=true s="shifted values count: 4" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 1 {
		let rot = t % g.n;
		for r in rot {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted values count: ", g.n);
	out
}
@end
