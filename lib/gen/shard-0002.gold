fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for idx in g.n {
		let x = g.res[idx];
		if core_is_even(x) {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
