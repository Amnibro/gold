	let limit = ${cap};
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = 0; }
		if x > limit { x = limit; }
		g.res[i] = x;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
