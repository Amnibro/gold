fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 { odds++; }
	}
	gold_cache_put(g, k, odds);
	if odds > 0 {
		let old_n = g.n;
		for i in old_n {
			if g.res[i] % 2 != 0 {
				gold_push(g, g.res[i]);
			}
		}
	}
	g.steps += g.n + 1;
	out.i = odds;
	out.s.clear();
	format(out.s, "cached ", odds, " odds");
	out
}
@end
