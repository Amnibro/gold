fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 {
		out.i = 0;
		return out;
	}
	var identical_pairs = 0;
	for k in (out.s.len - 1) {
		if out.s[k] == out.s[k + 1] {
			identical_pairs++;
		}
	}
	g.steps += out.s.len;
	out.i = identical_pairs;
	out.s.clear();
	format(out.s, "found ", identical_pairs, " adjacent identical letter pairs");
	out
}
@end
