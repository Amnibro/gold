expect: => i=4 r=0.0 ok=true s="grouped duplicates across 4 items" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=3,1,3,1,3
expect: => i=5 r=0.0 ok=true s="grouped duplicates across 5 items" errors=0 n=5 res=[3,3,3,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] == g.res[i] {
				let tmp = g.res[j];
				var p = j;
				while p > i + 1 {
					g.res[p] = g.res[p - 1];
					p--;
				}
				g.res[i + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped duplicates across ", g.n, " items");
	out
}
@end
