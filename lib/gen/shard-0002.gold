test: list=1,2,3,1,2,3,4,0
expect: => i=4 r=0.0 ok=true s="longest sorted streak: 4" errors=0 n=8 res=[1,2,3,1,2,3,4,0] cache=0 hits=0
test: list=5,4,3,2
expect: => i=1 r=0.0 ok=true s="longest sorted streak: 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = if g.n > 0 { 1 } else { 0 };
	var cur_streak = if g.n > 0 { 1 } else { 0 };
	var idx = 1;
	while idx < g.n {
		if g.res[idx] >= g.res[idx - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		idx++;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest sorted streak: ", max_streak);
	out
}
@end
