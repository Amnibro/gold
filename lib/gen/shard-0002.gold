@entry 9aba8eb2cbd832e1
kind: step
verb: repeat
noun: squares
modifier: at_most
context: filter
phrase: repeat square numbers at most {limit}
phrase: replicate filtered squares at most count {limit}
slot: limit int
test: list=4,9,5 limit=5
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[4,9,4,9,4] cache=0 hits=0
test: list=16,2,25 limit=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[16,25,16,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var sq int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if core_is_square(x) { sq.push(x); }
	}
	if sq.len == 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var count = 0;
	gold_clear(g);
	while count < cap && count < 500 {
		let idx = count % sq.len;
		gold_push(g, sq[idx]);
		count++;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
@entry 2361cc375029712c
kind: step
verb: filter
noun: total
modifier: each
context: filter
phrase: filter elements above total mean each
