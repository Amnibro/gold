fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let min_val = g.res[min_idx];
	let t = g.res[0];
	g.res[0] = min_val;
	g.res[min_idx] = t;
	out.i = min_val;
	g.steps += g.n + 1;
	out
}
