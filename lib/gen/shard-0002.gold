fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in kept.len {
			if kept[j] == c { seen = true; break; }
		}
		if seen { break; }
		if kept.len < 200 { kept.push(c); }
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
