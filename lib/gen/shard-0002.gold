code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty history");
		out.ok = false;
		g.steps++;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var rank = 0;
	for i in g.n {
		if g.res[i] <= last_val {
			rank++;
		}
	}
	out.i = rank;
	g.steps += g.n + 1;
	out
}
@end
