fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${length};
	let n = out.s.len;
	let span = if k > n { n } else { k };
	if span > 1 {
		let start = n - span;
		for i in span / 2 {
			let j = span - 1 - i;
			let tmp = out.s[start + i];
		out.s[start + i] = out.s[start + j];
		out.s[start + j] = tmp;
		}
	}
	g.steps += span;
	out.i = span;
	out
}
@end
