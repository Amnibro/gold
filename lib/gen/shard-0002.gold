noun: window
modifier: while
context: core
phrase: rotate window left by {steps} positions
phrase: cycle elements left by {steps} steps
slot: steps int
test: list=1,2,3,4,5 steps=2
expect: => i=2 r=0.0 ok=true s="rotated window by 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 steps=1
expect: => i=1 r=0.0 ok=true s="rotated window by 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n <= 1 || s <= 0 {
		g.steps++;
		return out;
	}
	for step in s {
		let first = g.res[0];
		for k in 0..(g.n - 1) { g.res[k] = g.res[k + 1]; }
		g.res[g.n - 1] = first;
	}
	g.steps += s * g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated window by ", s);
	out
}
@end
