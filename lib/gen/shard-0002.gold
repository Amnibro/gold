code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	for k in g.n {
		let x = g.res[k];
		let cached, found = gold_cache_get(g, x);
		if found {
			g.res[k] = cached;
		} else {
			let shifted = x + d;
			gold_cache_put(g, x, shifted);
			g.res[k] = shifted;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " items with cache");
	out
}
@end
