fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	let mx = g.res[max_idx];
	var i = max_idx;
	while i + 1 < g.n {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[g.n - 1] = mx;
	g.steps += g.n;
	out.i = mx;
	out
}
@end
@entry 734d743a34a65f85
kind: step
