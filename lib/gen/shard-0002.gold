	while i >= 0 {
		var x = core_abs_val(g.res[i]);
		var d = if x == 0 { 1 } else { 0 };
		while x > 0 { d++; x /= 10; }
		total_digits += d;
		i--;
	}
	gold_cache_put(g, 0, total_digits);
	out.i = total_digits;
	g.steps += g.n + 1;
	out
}
@end
@entry f7c61b77237726fc
kind: step
verb: keep
noun: digits
modifier: at_most
context: cache
phrase: keep elements with digits at most {max_len}
phrase: filter items exceeding digit limit {max_len} into cache
slot: max_len int
test: list=5,123,45,6789 max_len=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,45] cache=1 hits=0
test: list=100,200 max_len=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_len};
	var write_idx = 0;
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		var d = if x == 0 { 1 } else { 0 };
		while x > 0 { d++; x /= 10; }
		if d <= m {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	let dropped = g.n - write_idx;
	g.n = write_idx;
	gold_cache_put(g, m, dropped);
	out.i = dropped;
	g.steps += g.n + 1;
	out
}
@end
