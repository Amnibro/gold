		var suffix byte[..200] = "";
		var i = last_space + 1;
		while i < out.s.len {
			if suffix.len < 200 { suffix.push(out.s[i]); }
			i += 1;
		}
		out.s.clear();
		for b in suffix { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = last_space;
	out
}
@end
