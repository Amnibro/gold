fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	if out.s.len >= 2 {
		for i in 0..(out.s.len - 1) {
			let d = (out.s[i] as int) - (out.s[i + 1] as int);
			diff_sum += core_abs_val(d);
		}
	}
	out.i = diff_sum;
	g.steps += out.s.len;
	out
}
@end
