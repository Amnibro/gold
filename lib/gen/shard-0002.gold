test: text="a bb ccc dddd"
expect: => i=2 r=0.0 ok=true s="a bb ccc dddd" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: text="hello to world"
expect: => i=1 r=0.0 ok=true s="hello to world" errors=0 n=2 res=[5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_lens int[512] = [0; 512];
	var wn = 0;
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if cur > 0 { word_lens[wn] = cur; wn++; cur = 0; }
		} else {
			cur++;
		}
	}
	if cur > 0 { word_lens[wn] = cur; wn++; }
	var pairs int[512] = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < wn {
		pairs[pn] = word_lens[i]; pn++;
		pairs[pn] = word_lens[i + 1]; pn++;
		i += 2;
	}
	gold_clear(g);
	for k in pn { gold_push(g, pairs[k]); }
	out.i = pn / 2;
	g.steps += out.s.len;
	out
}
@end
