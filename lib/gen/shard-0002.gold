code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var dsum = 0;
		while x > 0 {
			dsum += x % 10;
			x /= 10;
		}
		acc += dsum;
		g.res[k] = acc;
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "computed running digit sum ", acc);
	out
}
@end
