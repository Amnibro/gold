@entry f5836f123e992ab1
kind: step
verb: filter
noun: range
modifier: pairwise
context: stats
phrase: filter range pairwise keeping differences within {max_diff}
phrase: retain adjacent pairs with pairwise range at most {max_diff}
slot: max_diff int
test: list=10,12,25,27,30 max_diff=3
expect: => i=6 r=0.0 ok=true s="filtered pairwise count: 6" errors=0 n=6 res=[10,12,25,27,27,30] cache=0 hits=0
test: list=5,20,22,50 max_diff=4
expect: => i=2 r=0.0 ok=true s="filtered pairwise count: 2" errors=0 n=2 res=[20,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_diff};
	if g.n > 1 {
		var kept = 0;
		for k in 0..(g.n - 1) {
			let a = g.res[k];
			let b = g.res[k + 1];
			let diff = if a > b { a - b } else { b - a };
			if diff <= lim {
				g.res[kept] = a;
				kept++;
				g.res[kept] = b;
				kept++;
			}
		}
		g.n = kept;
		out.i = kept;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filtered pairwise count: ", out.i);
	out
}
@end
