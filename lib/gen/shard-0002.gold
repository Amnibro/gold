fn ${ID}_check(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let is_prime = ${ID}_check(g.res[k]);
		if k % 2 == 1 && is_prime {
			// drop
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n * 2;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " observations");
	out
}
@end
