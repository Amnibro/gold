kind: step
verb: scale
noun: threshold
modifier: sorted
context: stats
phrase: scale threshold sorted data exceeding {threshold} by {multiplier}
phrase: scale sorted observations above {threshold} by {multiplier}
slot: threshold int
slot: multiplier int
test: list=8,2,14,5 threshold=6 multiplier=3
expect: => i=2 r=0.0 ok=true s="scaled 2 sorted values" errors=0 n=4 res=[2,5,24,42] cache=0 hits=0
test: list=20,10,30 threshold=15 multiplier=2
expect: => i=2 r=0.0 ok=true s="scaled 2 sorted values" errors=0 n=3 res=[10,40,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let mult = ${multiplier};
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var scaled = 0;
	for k in g.n {
		if g.res[k] > th {
			g.res[k] = g.res[k] * mult;
			scaled++;
		}
	}
	g.steps += g.n * 2;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " sorted values");
	out
}
@end
@entry bd1255557ecef697
kind: step
verb: fill
noun: histogram
modifier: recursively
context: stats
phrase: fill histogram recursively with {bins} intervals
phrase: populate frequency histogram recursively across {bins} bins
slot: bins int
test: list=1,3,4,8,9,10 bins=2
expect: => i=2 r=0.0 ok=true s="histogram filled with 2 bins" errors=0 n=2 res=[3,3] cache=0 hits=0
test: list=5,15,25,35 bins=4
expect: => i=4 r=0.0 ok=true s="histogram filled with 4 bins" errors=0 n=4 res=[1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	if g.n == 0 || b <= 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	let span = if max_val > min_val { max_val - min_val + 1 } else { 1 };
	var counts int[512] = [0; 512];
	for k in g.n {
		let offset = g.res[k] - min_val;
		var bin_idx = (offset * b) / span;
		if bin_idx >= b { bin_idx = b - 1; }
		counts[bin_idx] = counts[bin_idx] + 1;
	}
	gold_clear(g);
	for i in b {
		gold_push(g, counts[i]);
	}
	g.steps += g.n + b;
	out.i = b;
	out.s.clear();
	format(out.s, "histogram filled with ", b, " bins");
	out
}
@end
