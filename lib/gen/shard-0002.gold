@entry 9700ed030870a419
kind: step
verb: validate
noun: gaps
modifier: until
context: aggregate
phrase: validate element gaps until exceeding {max_gap}
phrase: check sequence gap sizes up to {max_gap}
slot: max_gap int
test: list=1,3,5,10 max_gap=2
expect: => i=2 r=0.0 ok=true s="validated 2 consecutive gaps" errors=0 n=4 res=[1,3,5,10] cache=0 hits=0
test: list=1,10 max_gap=5
expect: => i=0 r=0.0 ok=true s="validated 0 consecutive gaps" errors=0 n=2 res=[1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var count = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		let gap = if diff < 0 { -diff } else { diff };
		if gap <= mg {
			count++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "validated ", count, " consecutive gaps");
	out
}
@end
