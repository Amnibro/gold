fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, found = gold_cache_get(g, k);
	out.s.clear();
	if found {
		gold_push(g, val);
		out.i = val;
		format(out.s, "retrieved from cache: ", val);
	} else {
		gold_cache_put(g, k, out.i);
		gold_push(g, out.i);
		format(out.s, "inserted into cache: ", out.i);
	}
	g.steps += 1;
	out
}
@end
