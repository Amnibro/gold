fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n { total += g.res[i]; }
	if total < 0 { total = 0 - total; }
	while total >= 10 {
		var s = 0;
		while total > 0 {
			s += total % 10;
			total /= 10;
		}
		total = s;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "aggregated ", total);
	out
}
@end
