fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let start = if g.n > k { g.n - k } else { 0 };
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n - start;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "suffix max ", out.i);
	out
}
