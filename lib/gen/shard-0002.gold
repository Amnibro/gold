noun: sequence
modifier: until
context: compare
phrase: swap adjacent sequence elements until reaching cutoff {cutoff}
phrase: reorder sequence pairwise until encountering cutoff {cutoff}
slot: cutoff int
test: list=5,3,8,2,9 cutoff=8
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[3,5,8,2,9] cache=0 hits=0
test: list=10,4,20,1 cutoff=20
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[4,10,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == cut || g.res[i + 1] == cut {
			break;
		}
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
		}
		i++;
	}
	out.i = i;
	g.steps += g.n;
	out
}
@end
