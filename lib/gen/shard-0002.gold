@entry 86fe997c1722c4ba
kind: step
verb: limit
noun: primes
modifier: until
context: aggregate
phrase: limit primes until upper {limit}
phrase: count primes until ceiling {limit}
slot: limit int
test: list=2,3,4,5,11,15 limit=10
expect: => i=3 r=0.0 ok=true s="aggregated 3" errors=0 n=6 res=[2,3,4,5,11,15] cache=0 hits=0
test: list=7,8,9,13,17 limit=15
expect: => i=2 r=0.0 ok=true s="aggregated 2" errors=0 n=5 res=[7,8,9,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= lim {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
			if is_p { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "aggregated ", count);
	out
}
@end
