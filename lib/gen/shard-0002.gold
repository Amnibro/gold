fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for step in t {
		if g.n > 1 {
			for k in 0..(g.n - 1) {
				g.res[k] = (g.res[k] + g.res[k + 1]) / 2;
			}
			g.n--;
		}
	}
	g.steps += g.n * (t + 1);
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged down to ", g.n, " points");
	out
}
