fn ${ID}_is_vowel(c byte) bool {
	c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
	c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = 0;
	while idx + 1 < out.s.len {
		if ${ID}_is_vowel(out.s[idx]) && ${ID}_is_vowel(out.s[idx + 1]) {
			count++;
		}
		idx++;
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "vowel pairs: ", count);
	out
}
