fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total_err = 0;
	for i in g.n {
		if g.res[i] < 0 { total_err += -g.res[i]; }
	}
	if total_err > b {
		gold_fail(g, "error budget exhausted");
		out.ok = false;
	}
	out.i = total_err;
	g.steps += g.n + 1;
	out
}
