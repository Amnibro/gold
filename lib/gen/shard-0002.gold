kind: step
verb: validate
noun: words
modifier: nested
context: stats
phrase: validate words nested with minimum length {min_len}
phrase: verify text word length distribution against {min_len}
slot: min_len int
test: text="mean mode distribution" min_len=4
expect: => i=3 r=0.0 ok=true s="all 3 words valid" errors=0 n=0 res=[] cache=0 hits=0
test: text="a to in" min_len=3
expect: => i=3 r=0.0 ok=false s="invalid word lengths" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var valid = true;
	var cur_len = 0;
	var word_count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 32 {
			if cur_len > 0 {
				word_count++;
				if cur_len < ml { valid = false; }
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		word_count++;
		if cur_len < ml { valid = false; }
	}
	g.steps += out.s.len;
	out.ok = valid;
	out.i = word_count;
	out.s.clear();
	if valid {
		format(out.s, "all ", word_count, " words valid");
	} else {
		gold_fail(g, "word below minimum length");
		format(out.s, "invalid word lengths");
	}
	out
}
@end
