code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	if g.n > 0 {
		g.res[0] = ${f}(g.res[0]);
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
