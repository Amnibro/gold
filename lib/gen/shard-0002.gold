kind: step
verb: shift
noun: primes
modifier: between
context: stats
phrase: shift primes between {lo} to {hi} by offset
phrase: adjust prime values between {lo} to {hi} in stats
slot: lo int
slot: hi int
test: list=2,4,5,8,11 lo=3 hi=10
expect: => i=1 r=0.0 ok=true s="shifted 1 primes" errors=0 n=5 res=[2,4,6,8,11] cache=0 hits=0
test: list=7,12,13,17 lo=10 hi=15
expect: => i=1 r=0.0 ok=true s="shifted 1 primes" errors=0 n=4 res=[7,12,14,17] cache=0 hits=0
code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var shifted = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= low && x <= high && ${ID}_is_p(x) {
			g.res[k] = x + 1;
			shifted++;
		}
	}
	g.steps += g.n * 2;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted, " primes");
	out
}
@end
