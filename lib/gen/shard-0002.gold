fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k_items = if ${k} < g.n { ${k} } else { g.n };
	var rev int[512] = [0; 512];
	for i in k_items {
		rev[i] = g.res[g.n - 1 - i];
	}
	for i in k_items {
		g.res[i] = rev[i];
	}
	g.n = k_items;
	g.steps += k_items;
	out.i = k_items;
	out.s.clear();
	format(out.s, "tail in reverse count: ", k_items);
	out
}
@end
