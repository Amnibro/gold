fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var i = 0;
	while i < g.n {
		if core_is_prime(g.res[i]) {
			let tmp = g.res[i];
			var j = i;
			while j > p_count {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[p_count] = tmp;
			p_count++;
		}
		i++;
	}
	out.i = p_count;
	g.steps += g.n * g.n + 1;
	out
}
@end
