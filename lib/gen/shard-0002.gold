fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	let pairs = g.n / 2;
	var kept = 0;
	for k in pairs {
		let s = g.res[k * 2] + g.res[k * 2 + 1];
		if s >= ms {
			g.res[kept * 2] = g.res[k * 2];
			g.res[kept * 2 + 1] = g.res[k * 2 + 1];
			kept++;
		}
	}
	g.n = kept * 2;
	g.steps += pairs;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " pairs meeting minimum sum");
	out
}
@end
