code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	let span = if lim < 0 { 0 } else if lim > g.n { g.n } else { lim };
	var kept = 0;
	for k in span {
		let x = g.res[k];
		if ${check}(x) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += span;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered prefix to ", kept, " elements");
	out
}
@end
