@entry 12674032fdefc75f
kind: step
verb: reverse
noun: histogram
modifier: last
context: transform
phrase: reverse last unique elements across histogram counts
phrase: invert trailing frequencies in histogram transform
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,2,3,2,2] cache=0 hits=0
test: list=4,4,5,6,6,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[4,4,5,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = g.n / 2;
	var i = start;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n - start;
	g.steps += g.n;
	out
}
@end
@entry e82b10be3b02d609
kind: step
verb: rank
noun: squares
modifier: times
context: search
phrase: count square numbers scaled by factor {factor}
phrase: score perfect squares multiplied by {factor}
slot: factor int
test: list=4,7,9,16 factor=10
expect: => i=30 r=0.0 ok=true s="" errors=0 n=4 res=[4,7,9,16] cache=0 hits=0
test: list=2,3,5 factor=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { count++; }
		}
	}
	out.i = count * ${factor};
	g.steps += g.n;
	out
}
@end
@entry 03f98967c3e5203e
kind: step
verb: select
noun: sequence
modifier: last
context: transform
phrase: select last {count} items from sequence
phrase: keep final trailing slice of size {count} from sequence
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c < g.n && c >= 0 {
		var kept int[512] = [0; 512];
		var kn = 0;
		var i = g.n - c;
		while i < g.n {
			kept[kn] = g.res[i];
			kn++;
			i++;
		}
		gold_clear(g);
		for k in kn { gold_push(g, kept[k]); }
		out.i = kn;
	} else {
		out.i = g.n;
	}
	g.steps += g.n;
	out
}
@end
