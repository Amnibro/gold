expect: => i=21 r=0.0 ok=true s="pairs:2 sum:21" errors=0 n=3 res=[3,5,8] cache=0 hits=0
test: list=1,2,2,3,4,4
expect: => i=15 r=0.0 ok=true s="pairs:3 sum:15" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	var pair_sum = 0;
	var pair_count = 0;
	for k in 1..g.n {
		pair_sum += g.res[k - 1] + g.res[k];
		pair_count++;
	}
	out.s.clear();
	format(out.s, "pairs:", pair_count, " sum:", pair_sum);
	out.i = pair_sum;
	g.steps += g.n;
	out
}
@end
