fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	var odds = 0;
	for k in g.n {
		if k % 2 == 0 {
			evens += g.res[k];
		} else {
			odds += g.res[k];
		}
	}
	gold_clear(g);
	gold_push(g, evens);
	gold_push(g, odds);
	g.steps += g.n;
	out.i = evens + odds;
	out.s.clear();
	format(out.s, "alternating sums: ", evens, " and ", odds);
	out
}
@end
