@entry 24f9957796b4d4d3
kind: step
verb: swap
noun: range
modifier: nested
context: search
phrase: swap range nested invert items from {lo} to {hi}
phrase: reverse subarray bounded within limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=1,15,20,25,2 lo=1 hi=3
expect: => i=5 r=0.0 ok=true s="swapped nested range" errors=0 n=5 res=[1,25,20,15,2] cache=0 hits=0
test: list=50,60,70,80 lo=0 hi=2
expect: => i=4 r=0.0 ok=true s="swapped nested range" errors=0 n=4 res=[70,60,50,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${lo};
	var r = ${hi};
	if l < 0 { l = 0; }
	if r >= g.n { r = g.n - 1; }
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped nested range");
	out
}
@end
