test: list=-2,5,-2,-3,8,-3
expect: => i=-5 r=0.0 ok=true s="unique error sum -5" errors=0 n=6 res=[-2,5,-2,-3,8,-3] cache=0 hits=0
test: list=-5,-10,-5,20
expect: => i=-15 r=0.0 ok=true s="unique error sum -15" errors=0 n=4 res=[-5,-10,-5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = [0; 64];
	var seen_count = 0;
	var total_err = 0;
	for k in g.n {
		let x = g.res[k];
		if x < 0 {
			var dup = false;
			for j in seen_count {
				if seen[j] == x { dup = true; break; }
			}
			if !dup && seen_count < 64 {
				seen[seen_count] = x;
				seen_count++;
				total_err += x;
			}
		}
	}
	g.steps += g.n;
	out.i = total_err;
	out.s.clear();
	format(out.s, "unique error sum ", total_err);
	out
}
@end
