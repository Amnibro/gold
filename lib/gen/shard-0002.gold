phrase: locate checkpoint in place matching value {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="checkpoint found at 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=true s="checkpoint missing" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for k in g.n {
		if g.res[k] == tgt {
			found = k;
			break;
		}
	}
	if found < 0 {
		gold_clear(g);
		out.i = -1;
		out.s.clear();
		format(out.s, "checkpoint missing");
		return out;
	}
	let count = g.n - found;
	for k in count {
		g.res[k] = g.res[found + k];
	}
	g.n = count;
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "checkpoint found at ", found);
	out
}
@end
