noun: streak
modifier: last
context: filter
phrase: rank streak length of final run
phrase: count trailing streak of last values
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="streak 3" errors=0 n=5 res=[1,2,3,3,3] cache=0 hits=0
test: list=4,5,6,7
expect: => i=1 r=0.0 ok=true s="streak 1" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		count++;
		i--;
	}
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "streak ", count);
	out
}
@end
@entry baf6373bb1ad6b97
kind: step
verb: sort
noun: range
modifier: any
context: filter
phrase: sort range any subslice {start} {len}
phrase: order window range any portion {start} {len}
slot: start int
slot: len int
test: list=10,9,8,7,6 start=1 len=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[10,7,8,9,6] cache=0 hits=0
test: list=5,4,3,2,1 start=0 len=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,4,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let l = ${len};
	if s >= 0 && l > 0 && s + l <= g.n {
		var i = 0;
		while i < l {
			var j = 0;
			while j < l - 1 - i {
				let p1 = s + j;
				let p2 = s + j + 1;
				if g.res[p1] > g.res[p2] {
					let tmp = g.res[p1];
					g.res[p1] = g.res[p2];
					g.res[p2] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = l;
	out
}
@end
