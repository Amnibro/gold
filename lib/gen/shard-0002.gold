expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[1,2] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var i = 0;
	var j = g.cn - 1;
	var count = 0;
	while i < j {
		let tmp_k = g.ck[i];
		let tmp_v = g.cv[i];
		g.ck[i] = g.ck[j];
		g.cv[i] = g.cv[j];
		g.ck[j] = tmp_k;
		g.cv[j] = tmp_v;
		count++;
		i++;
		j--;
	}
	out.i = count;
	g.steps += g.cn + 1;
	out
}
@end
