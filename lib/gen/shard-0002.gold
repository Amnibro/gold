test: list=10,25,15 ceiling=30
expect: => i=25 r=0.0 ok=true s="maximum safely validated" errors=0 n=3 res=[10,25,15] cache=0 hits=0
test: list=40,12,5 ceiling=20
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[40,12,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	var mx = g.res[0];
	for k in 1..g.n {
		if g.res[k] > mx { mx = g.res[k]; }
	}
	if mx > limit {
		gold_fail(g, "maximum exceeds ceiling");
		out.ok = false;
		return out;
	}
	out.i = mx;
	g.steps += g.n;
	out.s.clear();
	out.s.append("maximum safely validated");
	out
}
@end
