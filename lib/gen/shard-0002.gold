phrase: grab central results bounded at most {cap}
slot: cap int
test: list=1,2,3,4,5 cap=3
expect: => i=3 r=0.0 ok=true s="returned 3 middle items" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10,20 cap=1
expect: => i=1 r=0.0 ok=true s="returned 1 middle items" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${cap};
	if max_len <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("no middle");
		g.steps += 1;
		return out;
	}
	let take_len = min(g.n, max_len);
	let start_idx = (g.n - take_len) / 2;
	for k in take_len {
		g.res[k] = g.res[start_idx + k];
	}
	g.n = take_len;
	g.steps += take_len;
	out.i = take_len;
	out.s.clear();
	format(out.s, "returned ", take_len, " middle items");
	out
}
@end
