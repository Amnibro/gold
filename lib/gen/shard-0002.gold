code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || count >= g.n { return out; }
	var tmp int[512] = [0; 512];
	var tn = 0;
	let split_pt = g.n - count;
	for i in split_pt..g.n {
		tmp[tn] = g.res[i];
		tn++;
	}
	for i in split_pt {
		tmp[tn] = g.res[i];
		tn++;
	}
	gold_clear(g);
	for i in tn { gold_push(g, tmp[i]); }
	out.i = count;
	g.steps += g.n + 1;
	out
}
@end
