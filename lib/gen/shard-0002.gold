fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "kept 0 items");
		return out;
	}
	let new_n = g.n - 2;
	for i in new_n {
		g.res[i] = g.res[i + 1];
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept ", new_n, " items");
	out
}
@end
