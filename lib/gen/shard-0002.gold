@entry c293d83b1b6e666a
kind: step
verb: find
noun: condition
modifier: first
context: transform
phrase: find first index matching condition {cond}
phrase: locate first position satisfying condition {cond}
slot: cond pred
test: list=1,3,6,7,9 cond=is_even
expect: => i=2 r=0.0 ok=true s="first matching index is 2" errors=0 n=3 res=[6,7,9] cache=0 hits=0
test: list=2,4,5 cond=is_odd
expect: => i=2 r=0.0 ok=true s="first matching index is 2" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = -1;
	for k in g.n {
		if ${cond}(g.res[k]) {
			found = k;
			break;
		}
	}
	if found < 0 {
		gold_clear(g);
		out.i = -1;
		out.s.clear();
		format(out.s, "no item matching condition");
		return out;
	}
	let rem = g.n - found;
	for k in rem {
		g.res[k] = g.res[found + k];
	}
	g.n = rem;
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "first matching index is ", found);
	out
}
@end
