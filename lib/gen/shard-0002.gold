}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_vowels = true;
	for k in out.s.len {
		if !${ID}_v(out.s[k]) {
			all_vowels = false;
			break;
		}
	}
	if !all_vowels {
		gold_fail(g, "non-vowel character found");
		out.ok = false;
	}
	g.steps += out.s.len;
	out.i = if all_vowels { 1 } else { 0 };
	out.s.clear();
	format(out.s, if all_vowels { "all vowels" } else { "contains consonants" });
	out
}
