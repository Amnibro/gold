fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let n = out.s.len;
	if n >= 2 && d > 0 {
		let first = out.s[0];
		let last = out.s[n - 1];
		var res byte[..200] = "";
		if res.len < 200 { res.push(first); }
		for step in d {
			for i in 1..(n - 1) {
				if res.len < 200 { res.push(out.s[i]); }
			}
		}
		if res.len < 200 { res.push(last); }
		out.s.clear();
		for b in res { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
