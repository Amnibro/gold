	for i in g.n { orig[i] = g.res[i]; }
	let total = g.n;
	gold_clear(g);
	for i in total {
		var cnt = 0;
		for j in total {
			if orig[i] == orig[j] { cnt++; }
		}
		if cnt == 1 { gold_push(g, orig[i]); }
	}
	g.steps += total;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retained ", g.n, " solitary items");
	out
}
@end
