code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let me = ${max_err};
	var errs = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			if g.res[k] > g.res[k + 1] { errs++; }
		}
	}
	if errs > me {
		gold_fail(g, "too many sort order errors");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = errs;
	out.s.clear();
	format(out.s, "detected ", errs, " sort order errors");
	out
}
@end
