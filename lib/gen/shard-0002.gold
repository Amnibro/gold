@entry 4e4e6860f23e2a91
kind: step
verb: dedupe
noun: head
modifier: unique
context: list
phrase: dedupe head of list to keep unique items up to {count}
phrase: remove duplicate values from prefix of {count} items
phrase: deduplicate first {count} elements uniquely
slot: count int
test: list=1,1,2,2,3,4 count=4
expect: => i=2 r=0.0 ok=true s="deduped head, removed 2 duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5 count=3
expect: => i=2 r=0.0 ok=true s="deduped head, removed 2 duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	var kept = 0;
	var prefix_len = if limit < g.n { limit } else { g.n };
	for k in prefix_len {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = prefix_len - kept;
	var write_pos = kept;
	var r = prefix_len;
	while r < g.n {
		g.res[write_pos] = g.res[r];
		write_pos++;
		r++;
	}
	g.n = write_pos;
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped head, removed ", removed, " duplicates");
	out
}
@end
