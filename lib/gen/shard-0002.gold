@entry 73fc3c3fcb12c6e4
kind: step
verb: drop
noun: average
modifier: in_place
context: retry
phrase: drop below average retry attempts in place
phrase: in place removal of below average retry runs
test: list=10,20,30,40
expect: => i=25 r=0.0 ok=true s="" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15
expect: => i=10 r=0.0 ok=true s="" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var total = 0;
	var i = 0;
	while i < g.n {
		total += g.res[i];
		i++;
	}
	let avg = total / g.n;
	var kept = 0;
	i = 0;
	while i < g.n {
		if g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = avg;
	g.steps += g.n;
	out
}
@end
@entry 3ef2dfca859fb32a
