kind: step
verb: rotate
noun: total
modifier: times
context: aggregate
phrase: rotate list elements total {shift} times
phrase: cycle items total {shift} positions
slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=1 r=0.0 ok=true s="rotated list by 1 positions" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=10,20 shift=0
expect: => i=0 r=0.0 ok=true s="rotated list by 0 positions" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n <= 1 || sh <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "rotated list by 0 positions");
		return out;
	}
	let eff_shift = sh % g.n;
	for step in eff_shift {
		let first_val = g.res[0];
		for k in (g.n - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[g.n - 1] = first_val;
	}
	g.steps += eff_shift * g.n;
	out.i = eff_shift;
	out.s.clear();
	format(out.s, "rotated list by ", eff_shift, " positions");
	out
}
@end
