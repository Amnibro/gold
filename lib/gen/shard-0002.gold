expect: => i=3 r=0.0 ok=true s="kept 3 items" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_p = ${count};
	var kept = 0;
	var i = 0;
	while i < g.n && kept < max_p {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
			if is_p {
				g.res[kept] = x;
				kept++;
			}
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
