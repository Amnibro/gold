@entry f15775e5eada956a
kind: step
verb: rotate
noun: maximum
modifier: last
context: core
phrase: rotate maximum value to last position
phrase: move peak element to last slot
test: list=10,50,20,30
expect: => i=50 r=0.0 ok=true s="rotated max to end 50" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=99,12,34,56
expect: => i=99 r=0.0 ok=true s="rotated max to end 99" errors=0 n=4 res=[12,34,56,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	let max_val = g.res[max_idx];
	for k in max_idx..(g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 1] = max_val;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "rotated max to end ", max_val);
	out
}
@end
@entry 428beafd25368e07
kind: step
verb: return
noun: primes
modifier: last
context: core
phrase: return prime numbers last in list
phrase: move prime values to end of results
test: list=2,4,3,6,8,5
expect: => i=3 r=0.0 ok=true s="moved primes to end 3" errors=0 n=6 res=[4,6,8,2,3,5] cache=0 hits=0
test: list=7,10,12,11
expect: => i=2 r=0.0 ok=true s="moved primes to end 2" errors=0 n=4 res=[10,12,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_primes int[512] = [0; 512];
	var primes int[512] = [0; 512];
	var np_cnt = 0;
	var p_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { primes[p_cnt] = x; p_cnt++; }
		else { non_primes[np_cnt] = x; np_cnt++; }
	}
	for i in np_cnt { g.res[i] = non_primes[i]; }
	for j in p_cnt { g.res[np_cnt + j] = primes[j]; }
	g.steps += g.n;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "moved primes to end ", p_cnt);
	out
}
@end
