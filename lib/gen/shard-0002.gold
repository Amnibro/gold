code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "no items to sum maximum");
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var sum_max = 0;
	var occurrences = 0;
	for k in g.n {
		if g.res[k] == max_val {
			sum_max += max_val;
			occurrences++;
		}
	}
	format(out.s, "max:", max_val, " total:", sum_max, " count:", occurrences);
	out.i = sum_max;
	g.steps += g.n;
	out
}
@end
@entry 79a68943376c9413
kind: step
