fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var rounds = 0;
	while sum > b && rounds < 10 {
		sum = 0;
		for i in g.n {
			g.res[i] = g.res[i] / 2;
			sum += g.res[i];
		}
		rounds++;
	}
	out.i = sum;
	g.steps += rounds * g.n;
	out
}
