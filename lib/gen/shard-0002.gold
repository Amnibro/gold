test: list=66,65,67,69,68
expect: => i=2 r=0.0 ok=true s="partitioned vowels 2" errors=0 n=5 res=[65,69,66,67,68] cache=0 hits=0
test: list=100,97,105,102
expect: => i=2 r=0.0 ok=true s="partitioned vowels 2" errors=0 n=4 res=[97,105,100,102] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels int[512] = [0; 512];
	var others int[512] = [0; 512];
	var vn = 0;
	var on = 0;
	for k in g.n {
		let c = g.res[k];
		let is_v = c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117;
		if is_v { vowels[vn] = c; vn++; }
		else { others[on] = c; on++; }
	}
	for i in vn { g.res[i] = vowels[i]; }
	for j in on { g.res[vn + j] = others[j]; }
	g.steps += g.n;
	out.i = vn;
	out.s.clear();
	format(out.s, "partitioned vowels ", vn);
	out
}
@end
