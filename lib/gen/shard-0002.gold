slot: start_idx int
test: text="aedcb" start_idx=1
expect: => i=5 r=0.0 ok=true s="abcde" errors=0 n=0 res=[] cache=0 hits=0
test: text="zzyx" start_idx=2
expect: => i=4 r=0.0 ok=true s="zzxy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${start_idx};
	if start < out.s.len {
		var p = start;
		while p < out.s.len {
			var q = p + 1;
			while q < out.s.len {
				if (out.s[q] as int) < (out.s[p] as int) {
					let swap_c = out.s[p];
					out.s[p] = out.s[q];
					out.s[q] = swap_c;
				}
				q += 1;
			}
			p += 1;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
