expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[1,3,5,8,11] cache=0 hits=0
test: list=10,20,30,40
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gaps int[>..] = [];
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let d = g.res[i + 1] - g.res[i];
			var seen = false;
			for j in gaps.len {
				if gaps[j] == d { seen = true; break; }
			}
			if !seen { gaps.push(d); }
		}
	}
	out.i = gaps.len;
	g.steps += g.n;
	out
}
@end
