code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var i = 0;
	while i < g.n {
		var len = 1;
		while i + len < g.n && g.res[i + len] == g.res[i] { len++; }
		if len > 1 {
			for j in i..i + len { g.res[j] = g.res[j] * fac; }
		}
		i += len;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
