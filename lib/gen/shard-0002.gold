@entry 8bc72c08caa3c6fb
kind: step
verb: collect
noun: gaps
modifier: with_retry
context: cache
phrase: collect cache interval gaps with retry adjustment
phrase: record differences across cache indices with fallback
test: list=2,5,9,14
expect: => i=5 r=4.0 ok=true s="" errors=0 n=4 res=[2,5,9,14] cache=3 hits=0
test: list=10,25,35
expect: => i=15 r=12.5 ok=true s="" errors=0 n=3 res=[10,25,35] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_gap = 0;
	var sum_gaps = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		sum_gaps += gap;
		gold_cache_put(g, i, gap);
		if gap > max_gap { max_gap = gap; }
	}
	out.i = max_gap;
	out.r = (sum_gaps as real) / ((g.n - 1) as real);
	g.steps += g.n + 1;
	out
}
@end
@entry 98d7a8327adbbe29
kind: step
verb: split
noun: vowels
modifier: pairwise
context: cache
phrase: split adjacent vowel pairs across cached characters
phrase: partition consecutive vowel sequences in cache
test: text="queue"
expect: => i=1 r=0.0 ok=true s="queue" errors=0 n=0 res=[] cache=1 hits=0
test: text="audio"
expect: => i=1 r=0.0 ok=true s="audio" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < out.s.len {
		let a = out.s[i];
		let b = out.s[i + 1];
		let va = a == 'a' || a == 'e' || a == 'i' || a == 'o' || a == 'u';
		let vb = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u';
		if va && vb {
			pairs++;
			gold_cache_put(g, i, 2);
		}
		i += 2;
	}
	out.i = pairs;
	g.steps += out.s.len + 1;
	out
}
@end
@entry b60c88f2597103cc
kind: step
verb: run
noun: prefix
modifier: with_retry
context: cache
phrase: run cached prefix verification with retry limit {max_retries}
phrase: evaluate prefix keys in cache with retry limit {max_retries}
slot: max_retries int
test: list=1,2,3,4 max_retries=3
expect: => i=0 r=0.0 ok=false s="" errors=0 n=4 res=[1,2,3,4] cache=4 hits=0
test: list=10,20 max_retries=1
expect: => i=0 r=0.0 ok=false s="" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var matched = 0;
	for i in g.n {
		let _, ok = gold_cache_get(g, g.res[i]);
		if ok { matched++; }
		else if retries > 0 { gold_cache_put(g, g.res[i], 1); }
	}
	out.i = matched;
	out.ok = matched > 0;
	g.steps += g.n + 1;
	out
}
@end
@entry 9f47843e039954cb
kind: step
verb: normalize
noun: runs
modifier: none
context: cache
phrase: normalize equal value runs without cache modification
phrase: compact identical runs in sequence without cache change
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,5,10,10
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
