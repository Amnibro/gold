test: list=2,3,4,7
expect: => i=0 r=0.0 ok=false s="all prime valid false" errors=1 n=4 res=[2,3,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_prime = true;
	for k in g.n {
		let x = g.res[k];
		var p = true;
		if x < 2 { p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { p = false; break; }
				d++;
			}
		}
		if !p {
			all_prime = false;
			gold_fail(g, "composite element found");
			break;
		}
	}
	g.steps += g.n;
	out.ok = all_prime;
	out.i = if all_prime { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all prime valid ", all_prime);
	out
}
@end
