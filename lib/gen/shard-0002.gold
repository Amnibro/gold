fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var updated = 0;
	for i in g.n {
		let c, hit = gold_cache_get(g, g.res[i]);
		if !hit {
			let fallback_val = ${fb}(g.res[i]);
			gold_cache_put(g, g.res[i], fallback_val);
			g.res[i] = fallback_val;
			updated++;
		}
	}
	out.i = updated;
	g.steps += g.n + 1;
	out
}
