fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var err_count = 0;
	for k in g.n {
		if g.res[k] < 0 { err_count++; }
	}
	gold_text(out, if err_count > 0 { "errors present" } else { "clean" });
	out.i = err_count;
	g.steps += g.n * g.n + 1;
	out
}
