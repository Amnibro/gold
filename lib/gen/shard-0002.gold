fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let first_val = g.res[0];
		for k in (g.n - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[g.n - 1] = first_val;
		out.i = first_val;
	} else if g.n == 1 {
		out.i = g.res[0];
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated search sequence left by 1");
	out
}
@end
