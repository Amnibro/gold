fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_square(x) {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
