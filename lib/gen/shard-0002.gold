@entry e6e779998285597e
kind: step
verb: drop
noun: items
modifier: while
context: retry
phrase: drop retry items while beneath {cutoff}
phrase: discard retry entries while under {cutoff}
slot: cutoff int
test: list=2,4,8,12,3 cutoff=6
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[8,12,3] cache=0 hits=0
test: list=10,20 cutoff=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var start = 0;
	while start < g.n && g.res[start] < cut {
		start++;
	}
	var kept = 0;
	var i = start;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.n = kept;
	out.i = start;
	g.steps += g.n;
	out
}
@end
