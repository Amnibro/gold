@entry 25ea61b0c120e310
kind: step
verb: measure
noun: gaps
modifier: each
context: filter
phrase: measure gaps each distance {gap}
phrase: filter gaps each delta {gap}
slot: gap int
test: list=10,12,20,22,35 gap=5
expect: => i=3 r=0.0 ok=true s="kept 3 items" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=1,10,12,30 gap=8
expect: => i=3 r=0.0 ok=true s="kept 3 items" errors=0 n=3 res=[1,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let min_gap = ${gap};
	var kept = 1;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = 0 - diff; }
		if diff >= min_gap {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
