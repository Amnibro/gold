fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
		}
	}
	var u int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		if un == 0 || u[un - 1] != g.res[i] {
			u[un] = g.res[i];
			un++;
		}
	}
	gold_clear(g);
	for k in un { gold_push(g, u[k]); }
	out.i = un;
	g.steps += g.n * g.n;
	out
}
@end
