fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var matched = 0;
	var cur_len = 0;
	for b in out.s {
		if b == 32 {
			if cur_len > 0 && cur_len <= limit { matched++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 && cur_len <= limit { matched++; }
	g.steps += out.s.len + 1;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched words count ", matched);
	out
}
