	if iters > 3 { iters = 3; }
	for s in iters {
		for k in g.n { g.res[k] += 1; }
		gold_cache_put(g, s, g.res[0]);
	}
	g.steps += g.n + iters;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "repeated cached steps ", iters);
	out
}
