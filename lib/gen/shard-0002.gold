@entry 3967664bd61cdd1b
kind: step
verb: collect
noun: loop
modifier: none
context: cache
phrase: collect distinct loop values without cache modification
phrase: gather unique sequence items without changing cache
test: list=1,2,2,3,3,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,10,20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n * g.n + 1;
	out
}
@end
