@entry a3705cafc14cee50
kind: step
verb: dedupe
noun: odds
modifier: with_retry
context: filter
phrase: dedupe odd results with retry mechanism
phrase: remove duplicate odd values with retry policy
test: list=1,2,1,3,2,3,4
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,2,4] cache=0 hits=0
test: list=5,5,5,6,7
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_even(x) {
			g.res[kept] = x;
			kept++;
		} else {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
