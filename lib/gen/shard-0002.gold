fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	if g.n > 0 {
		while shifts < g.n && !${stop}(g.res[0]) {
			let first = g.res[0];
			for k in 0..g.n - 1 {
				g.res[k] = g.res[k + 1];
			}
			g.res[g.n - 1] = first;
			shifts++;
		}
	}
	g.steps += shifts + 1;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted ", shifts, " times");
	out
}
@end
