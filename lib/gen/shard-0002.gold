code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_odd = false;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			has_odd = true;
			break;
		}
	}
	if has_odd {
		gold_fail(g, "odd number present");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if has_odd { 0 } else { 1 };
	out.s.clear();
	format(out.s, if has_odd { "found odd" } else { "none odd" });
	out
}
@end
