noun: words
modifier: sorted
context: search
phrase: shift words sorted insertion step {val}
phrase: insert value {val} into sorted search results
slot: val int
test: list=10,20,40,50 val=30
expect: => i=2 r=0.0 ok=true s="inserted element at index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15 val=2
expect: => i=0 r=0.0 ok=true s="inserted element at index 0" errors=0 n=3 res=[2,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let v_in = ${val};
	var idx = g.n;
	for k in g.n {
		if v_in < g.res[k] {
			idx = k;
			break;
		}
	}
	var k = g.n;
	while k > idx {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[idx] = v_in;
	g.n++;
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "inserted element at index ", idx);
	out
}
@end
