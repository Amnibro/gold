@entry b36e46184d855cc4
kind: step
verb: fold
noun: primes
modifier: sorted
context: search
phrase: collect sorted prime search elements
phrase: filter prime matches sorting ascending
test: list=9,7,4,2,5
expect: => i=14 r=0.0 ok=true s="" errors=0 n=3 res=[2,5,7] cache=0 hits=0
test: list=8,6,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var pn = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				primes[pn] = x;
				pn++;
				sum += x;
			}
		}
	}
	var i = 0;
	while i < pn {
		var j = i + 1;
		while j < pn {
			if primes[i] > primes[j] {
				let tmp = primes[i];
				primes[i] = primes[j];
				primes[j] = tmp;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	out.i = sum;
	g.steps += g.n;
	out
}
@end
