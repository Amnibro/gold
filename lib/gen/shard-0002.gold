code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let val = g.res[k];
		let dummy, found = gold_cache_get(g, val);
		if !found {
			gold_cache_put(g, val, 1);
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped using cache ", kept);
	out
}
@end
@entry 8093f58438ff5f80
kind: step
verb: repeat
noun: limit
modifier: nested
context: core
phrase: repeat elements nested to depth {depth} ceiling {cap}
phrase: duplicate values nested depth {depth} under {cap}
slot: depth int
slot: cap int
test: list=2,4 depth=2 cap=10
expect: => i=4 r=0.0 ok=true s="repeated nested count 4" errors=0 n=4 res=[2,2,4,4] cache=0 hits=0
test: list=5,10 depth=3 cap=15
expect: => i=6 r=0.0 ok=true s="repeated nested count 6" errors=0 n=6 res=[5,5,5,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let c = ${cap};
	var new_n = 0;
	var buf int[512] = [0; 512];
	for k in g.n {
		let val = g.res[k];
		for step in d {
			if new_n < c && new_n < 512 {
				buf[new_n] = val;
				new_n++;
			}
		}
	}
	for i in new_n { g.res[i] = buf[i]; }
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "repeated nested count ", new_n);
	out
}
@end
