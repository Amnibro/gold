@entry 4c3219c541163e30
kind: step
verb: measure
noun: odds
modifier: unique
context: error
phrase: measure count of unique odd error codes
phrase: tally distinct odd parity error values
test: list=-3,-3,-5,-4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[-3,-3,-5,-4] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_odd_errs = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 && core_is_odd(g.res[i]) {
			var seen = false;
			var j = 0;
			while j < i {
				if g.res[j] == g.res[i] { seen = true; break; }
				j++;
			}
			if !seen { distinct_odd_errs++; }
		}
		i++;
	}
	out.i = distinct_odd_errs;
	g.steps += g.n * g.n + 1;
	out
}
@end
