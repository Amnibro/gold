@entry d9905690360adc18
kind: step
verb: filter
noun: streak
modifier: at_least
context: format
phrase: filter streaks of at least length
phrase: retain consecutive runs at least threshold
slot: min_len int
test: list=1,1,1,2,3,3,3,3 min_len=3
expect: => i=7 r=0.0 ok=true s="streak items retained:7" errors=0 n=7 res=[1,1,1,3,3,3,3] cache=0 hits=0
test: list=5,5,6,7,7,7 min_len=2
expect: => i=5 r=0.0 ok=true s="streak items retained:5" errors=0 n=5 res=[5,5,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= ml {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.s.clear();
	format(out.s, "streak items retained:", kept);
	out.i = kept;
	out
}
@end
