@entry fee86deb86984eed
kind: step
verb: rotate
noun: loop
modifier: safely
context: search
phrase: rotate loop safely by offset count {offset}
phrase: cycle search loop positions safely by {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="safely rotated loop by 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,6,7 offset=2
