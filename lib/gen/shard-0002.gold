test: text="xyz" shift=2
expect: => i=3 r=0.0 ok=true s="zab" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for k in out.s.len {
		let b = out.s[k];
		if b >= 97 && b <= 122 {
			let shifted = ((b - 97 + (s as byte)) % 26) + 97;
			out.s[k] = shifted;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
