test: input=10 cutoff=10
expect: => i=2 r=0.0 ok=true s="dropped 2 cache items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	gold_cache_put(g, 1, 50);
	gold_cache_put(g, 2, 150);
	var dropped = 0;
	var kept = 0;
	for k in g.cn {
		if g.cv[k] <= cut {
			g.ck[kept] = g.ck[k];
			g.cv[kept] = g.cv[k];
			kept++;
		} else {
			dropped++;
		}
	}
	g.cn = kept;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " cache items");
	out
}
@end
