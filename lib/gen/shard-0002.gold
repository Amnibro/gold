	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var len = 1;
	var k = g.n - 1;
	while k > 0 && g.res[k] == g.res[k - 1] {
		len++;
		k--;
	}
	out.i = len;
	g.steps += g.n;
	out
}
@end
