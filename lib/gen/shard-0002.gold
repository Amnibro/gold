@entry e7dbc6d2b6c6e859
kind: step
verb: split
noun: squares
modifier: times
context: sort
phrase: split squares times partitioning square numbers ahead
phrase: group square numbers ahead of other elements
test: list=2,4,7,9,16
expect: => i=3 r=0.0 ok=true s="partitioned 3 square values first" errors=0 n=5 res=[4,9,16,2,7] cache=0 hits=0
test: list=3,5,7
expect: => i=0 r=0.0 ok=true s="partitioned 0 square values first" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq int[512] = [0; 512];
	var nsq int[512] = [0; 512];
	var sc = 0;
	var nc = 0;
	for k in g.n {
		if ${ID}_is_sq(g.res[k]) {
			sq[sc] = g.res[k];
			sc++;
		} else {
			nsq[nc] = g.res[k];
			nc++;
		}
	}
	for i in sc { g.res[i] = sq[i]; }
	for i in nc { g.res[sc + i] = nsq[i]; }
	g.steps += g.n * 2;
	out.i = sc;
	out.s.clear();
	format(out.s, "partitioned ", sc, " square values first");
	out
}
@end
