code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		gold_cache_put(g, runs, j - i);
		runs++;
		i = j;
	}
	g.steps += g.n;
	out.i = runs;
