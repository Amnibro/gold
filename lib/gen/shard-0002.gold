fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	var sum = 0;
	for k in g.n {
		if g.res[k] < 0 {
			valid = false;
			break;
		}
		sum += g.res[k];
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = sum;
	out.s.clear();
	if valid {
		format(out.s, "counters valid sum ", sum);
	} else {
		gold_fail(g, "negative counter detected");
		format(out.s, "invalid counters");
	}
	out
}
@end
