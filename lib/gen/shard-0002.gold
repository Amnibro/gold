fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${times};
	if g.n == 0 {
		return out;
	}
	let last_val = g.res[g.n - 1];
	var i = 0;
	while i < k {
		gold_push(g, last_val);
		i++;
	}
	out.i = last_val;
	g.steps += k;
	out
}
@end
