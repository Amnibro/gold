code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 100 {
		return 0;
	}
	v = v / 10;
	var sum = 0;
	while v >= 10 {
		sum = sum + (v % 10);
		v = v / 10;
	}
	sum
}
@end
@entry dd99398df1451a31
kind: fn
verb: merge
noun: streak
modifier: running
context: transform
phrase: merge streak running length
phrase: longest running streak length
test: arg=12223,12345
expect: 3
expect: 1
test: arg=7777,50055
expect: 4
expect: 2
code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return 1;
	}
	var max_streak = 1;
	var current_streak = 1;
	var last_digit = v % 10;
	v = v / 10;
	while v > 0 {
		let d = v % 10;
		if d == last_digit {
			current_streak = current_streak + 1;
			if current_streak > max_streak {
				max_streak = current_streak;
			}
		} else {
			current_streak = 1;
			last_digit = d;
		}
		v = v / 10;
	}
	max_streak
}
@end
@entry 478cd00e9bc719c5
kind: fn
verb: drop
noun: numbers
modifier: with_cache
context: transform
phrase: drop numbers with_cache filter
phrase: drop even numbers with_cache
test: arg=12345,2468
expect: 135
expect: 0
test: arg=709,3
expect: 79
expect: 3
code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	var rev = 0;
	var has_odd = false;
	while v > 0 {
		let d = v % 10;
		if d % 2 != 0 {
			rev = rev * 10 + d;
			has_odd = true;
		}
		v = v / 10;
	}
	if !has_odd {
		return 0;
	}
	var res = 0;
	while rev > 0 {
		res = res * 10 + (rev % 10);
		rev = rev / 10;
	}
	res
}
@end
