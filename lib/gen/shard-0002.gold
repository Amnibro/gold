code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let a = g.res[g.n - 2];
		let b = g.res[g.n - 1];
		let diff = if a > b { a - b } else { b - a };
		let cv, hit = gold_cache_get(g, diff);
		if hit {
			out.i = cv;
		} else {
			gold_cache_put(g, diff, diff * 2);
			out.i = diff;
		}
		gold_push(g, diff);
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "paired tail diff ", out.i);
	out
}
@end
