fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var below int[512] = [0; 512];
	var above int[512] = [0; 512];
	var bc = 0;
	var ac = 0;
	for k in g.n {
		if g.res[k] < p {
			below[bc] = g.res[k];
			bc++;
		} else {
			above[ac] = g.res[k];
			ac++;
		}
	}
	for i in bc { g.res[i] = below[i]; }
	for i in ac { g.res[bc + i] = above[i]; }
	g.steps += g.n * 2;
	out.i = bc;
	out.s.clear();
	format(out.s, "grouped ", bc, " minimum elements below pivot");
	out
}
@end
