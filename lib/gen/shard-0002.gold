code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs int[512] = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		let sq = x * x;
		gold_cache_put(g, x, sq);
		pairs[pn] = x; pn++;
		pairs[pn] = sq; pn++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, pairs[k]); }
	out.i = pn / 2;
	g.steps += g.n;
	out
}
@end
