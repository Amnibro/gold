fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 {
		gold_fail(g, "negative limit");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for k in g.n {
		if k <= lim {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered at most limit");
	out
}
@end
