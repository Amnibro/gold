fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	while g.n > 1 {
		let pairs = g.n / 2;
		for k in pairs {
			g.res[k] = g.res[2 * k] + g.res[2 * k + 1];
		}
		if g.n % 2 != 0 {
			g.res[pairs] = g.res[g.n - 1];
			g.n = pairs + 1;
		} else {
			g.n = pairs;
		}
	}
	g.steps += 10;
	if g.n > 0 { out.i = g.res[0]; }
	out.s.clear();
	format(out.s, "recursive reduction sum ", out.i);
	out
}
@end
