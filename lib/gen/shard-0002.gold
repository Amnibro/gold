code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for tail validation");
		out.ok = false;
		out.i = -1;
		return out;
	}
	let last = g.res[g.n - 1];
	let valid = ${p}(last);
	if !valid {
		gold_fail(g, "tail validation failed");
		out.ok = false;
	}
	g.steps += 1;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, if valid { "tail valid" } else { "tail invalid" });
	out
}
@end
