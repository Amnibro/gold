code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	gold_cache_put(g, 0, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed total sum is ", sum);
	out
}
@end
@entry e6e912b3df964adf
kind: step
verb: limit
noun: runs
modifier: safely
context: aggregate
phrase: limit consecutive runs safely to {max_run}
phrase: restrict repeated runs safely up to {max_run}
slot: max_run int
test: list=2,2,2,2,3,3 max_run=2
expect: => i=4 r=0.0 ok=true s="limited runs to 4 elements" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=5,5,5 max_run=1
expect: => i=1 r=0.0 ok=true s="limited runs to 1 elements" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_run};
	if cap <= 0 || g.n == 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			if run_len < cap {
				g.res[kept] = val;
				kept++;
				run_len++;
			}
			i++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited runs to ", kept, " elements");
	out
}
@end
