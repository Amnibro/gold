code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var steps_taken = 0;
	while steps_taken < g.n && g.res[0] != tgt {
		let first = g.res[0];
		for k in 0..(g.n - 1) { g.res[k] = g.res[k + 1]; }
		g.res[g.n - 1] = first;
		steps_taken++;
	}
	g.steps += steps_taken;
	out.i = steps_taken;
	out
}
@end
