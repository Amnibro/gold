@entry b01c3bc89c3128d3
kind: step
verb: filter
noun: words
modifier: at_most
context: text
phrase: filter words keeping at most {limit} items
phrase: retain at most {limit} words in text
slot: limit int
test: text="one two three four" limit=2
expect: => i=3 r=0.0 ok=true s="one two " errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha beta gamma" limit=1
expect: => i=2 r=0.0 ok=true s="alpha " errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var words = 0;
	var in_word = false;
	var end_idx = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b != 32 as byte {
			if !in_word {
				words++;
				in_word = true;
				if words > lim { break; }
			}
		} else {
			in_word = false;
		}
		end_idx = i + 1;
	}
	var res byte[..200] = "";
	for i in end_idx {
		if res.len < 200 { res.push(out.s[i]); }
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = words;
	out
}
@end
