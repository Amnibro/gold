code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " prime candidates");
	out
}
@end
