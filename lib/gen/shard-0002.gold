test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="reversed 4 retry steps" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let swap_val = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = swap_val;
		left++;
		right--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " retry steps");
	g.steps += g.n + 1;
	out
}
@end
