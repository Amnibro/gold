code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var converted = 0;
	var r = 0;
	while r < r_max {
		for i in out.s.len {
			let c = out.s[i];
			if c >= 'A' && c <= 'Z' {
				out.s[i] = c + 32;
				converted++;
			}
		}
		r++;
	}
	g.steps += out.s.len + 1;
	out.i = converted;
	out
}
@end
