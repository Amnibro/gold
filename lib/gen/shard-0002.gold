code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_v = g.res[0];
	var max_v = g.res[0];
	for i in 1..g.n {
		let x = g.res[i];
		if x < min_v { min_v = x; }
		if x > max_v { max_v = x; }
	}
	let diff = max_v - min_v;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "formatted ", diff);
	out
}
@end
