fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
