code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var r = 0;
	var changed = false;
	while r < max_r {
		var any_even = false;
		for k in g.n {
			if g.res[k] % 2 == 0 {
				g.res[k] /= 2;
				any_even = true;
				changed = true;
			}
		}
		r++;
		if !any_even { break; }
	}
	g.steps += r;
	out.i = r;
	out.s.clear();
	if changed {
		format(out.s, "normalized across ", r, " passes");
	} else {
		out.s.append("no changes needed");
	}
	out
}
@end
