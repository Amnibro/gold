code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${lim};
	let cap = if k > g.n { g.n } else { k };
	for i in 1..cap {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	out.i = cap;
	g.steps += cap + 1;
	out
}
@end
