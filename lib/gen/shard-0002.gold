code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o1 = -1;
	var o2 = -1;
	var i = g.n - 1;
	while i >= 0 {
		if core_is_odd(g.res[i]) {
			if o1 == -1 { o1 = i; }
			else if o2 == -1 { o2 = i; break; }
		}
		i--;
	}
	if o1 != -1 && o2 != -1 {
		let tmp = g.res[o1];
		g.res[o1] = g.res[o2];
		g.res[o2] = tmp;
		gold_cache_put(g, o2, o1);
		out.ok = true;
	} else {
		out.ok = false;
	}
	out.i = if out.ok { 1 } else { 0 };
	g.steps += g.n + 1;
	out
}
@end
