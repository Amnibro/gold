fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	while g.n > 0 && passes < 5 && ${cond}(g.res[0]) {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
			}
		}
		passes++;
	}
	out.i = passes;
	g.steps += passes * g.n + 1;
	out
}
