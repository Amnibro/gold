code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	while start < g.n {
		let x = g.res[start];
		if !core_is_square(x) { break; }
		start++;
	}
	let kept = g.n - start;
	for k in kept {
		g.res[k] = g.res[start + k];
	}
	g.n = kept;
	out.s.clear();
	format(out.s, "dropped leading squares:", start, " remaining:", kept);
	out.i = kept;
	g.steps += g.n;
	out
}
@end
