fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n > 0 {
		var x = g.res[0];
		var k = 0;
		while x < tgt && k < 100 {
			let cached, ok = gold_cache_get(g, x);
			if ok {
				x = cached;
			} else {
				let next_x = ${f}(x);
				gold_cache_put(g, x, next_x);
				x = next_x;
			}
			k++;
		}
		g.res[0] = x;
		out.i = x;
		g.steps += k;
	}
	out
}
@end
