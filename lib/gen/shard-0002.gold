code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var buf byte[..200] = "";
	for i in out.s.len {
		if out.s[i] == ' ' {
			var k = 0;
			while k < fac && buf.len < 190 { buf.push(' '); k++; }
		} else {
			if buf.len < 190 { buf.push(out.s[i]); }
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
