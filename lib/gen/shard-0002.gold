code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let skip = if k < 0 { 0 } else if k > g.n { g.n } else { k };
	let new_n = g.n - skip;
	for i in new_n {
		g.res[i] = g.res[i + skip];
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept ", new_n, " items");
	out
}
@end
