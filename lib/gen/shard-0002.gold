code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i] * fac;
			en++;
		}
	}
	var i = 0;
	var j = en - 1;
	while i < j {
		let t = evens[i]; evens[i] = evens[j]; evens[j] = t;
		i++;
		j--;
	}
	gold_clear(g);
	for k in en { gold_push(g, evens[k]); }
	out.i = en;
	g.steps += g.n;
	out
}
@end
