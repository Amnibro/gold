fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_even = -1;
	for i in g.n {
		if g.res[i] % 2 == 0 { last_even = i; }
	}
	if last_even >= 0 && g.n > 0 {
		let t = g.res[0]; g.res[0] = g.res[last_even]; g.res[last_even] = t;
	}
	out.i = last_even;
	g.steps += g.n;
	out
}
@end
