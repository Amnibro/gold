code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var n = out.i;
	var clamped = 0;
	var mul = 1;
	while n > 0 {
		var d = n % 10;
		if d > limit { d = limit; }
		clamped += d * mul;
		mul *= 10;
		n /= 10;
	}
	g.steps += 10;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped digits ", clamped);
	out
}
@end
