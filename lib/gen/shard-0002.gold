code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var step_sum = 0;
	if g.n > 1 {
		var k = g.n - 1;
		while k > 0 {
			let delta = g.res[k] - g.res[k - 1];
			step_sum += delta;
			k--;
		}
	}
	gold_push(g, step_sum);
	g.steps += g.n;
	out.i = step_sum;
	out.s.clear();
	format(out.s, "joined step sum ", step_sum);
	out
}
@end
@entry 0a0609281c2b9597
kind: step
verb: dedupe
noun: condition
modifier: each
context: math
phrase: dedupe values satisfying modulo condition {factor}
phrase: remove duplicate numbers matching condition {factor}
slot: factor int
test: list=1,4,7,10,2,5 factor=3
expect: => i=2 r=0.0 ok=true s="deduped condition count 2" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=2,6,10,14,3,7 factor=4
expect: => i=2 r=0.0 ok=true s="deduped condition count 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var kept = 0;
	if f > 0 {
		var seen_mod = [0; 64];
		var mod_count = 0;
		for k in g.n {
			let rem = (g.res[k] % f + f) % f;
			var seen = false;
			for m in mod_count {
				if seen_mod[m] == rem { seen = true; break; }
			}
			if !seen {
				if mod_count < 64 {
					seen_mod[mod_count] = rem;
					mod_count++;
				}
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped condition count ", kept);
	out
}
@end
