test: list=3,3,4,5,5,6
expect: => i=4 r=0.0 ok=true s="deduped retry count 4" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="deduped retry count 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var retry = 0;
	while retry < 3 {
		var kept = 0;
		for i in g.n {
			var dup = false;
			for j in kept {
				if g.res[j] == g.res[i] { dup = true; break; }
			}
			if !dup {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
		retry++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped retry count ", g.n);
	out
}
@end
