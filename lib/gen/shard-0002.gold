	var best_val = 0;
	var best_cnt = 0;
	for i in g.cn {
		if g.cv[i] > best_cnt {
			best_cnt = g.cv[i];
			best_val = g.ck[i];
		}
	}
	out.i = best_val;
	g.steps += g.n;
	out
}
