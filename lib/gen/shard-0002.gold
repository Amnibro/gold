code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var filled = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			g.res[k] = x - lo;
			filled++;
		}
	}
	g.steps += g.n;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " values in run");
	out
}
@end
