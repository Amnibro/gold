@entry 85d9264d760d61f6
kind: fn
verb: sort
noun: total
modifier: until
context: format
phrase: accumulate triangular format size until {limit}
phrase: compute triangular total until bound {limit}
slot: limit int
test: arg=4,8 limit=20
expect: 10
expect: 15
test: arg=10 limit=15
expect: 15
code:
fn ${ID}(n int) int {
	let bound = ${limit};
	var total = 0;
	var i = 1;
	while i <= n && total + i <= bound {
		total += i;
		i++;
	}
	total
}
@end
@entry 6fa3a976639fb6f0
kind: step
verb: find
noun: list
modifier: pairwise
context: cache
phrase: find duplicate consecutive elements pairwise in cache entries
phrase: locate adjacent identical values pairwise across cache list
test: list=10,10,20,30,30,40
expect: => i=1 r=0.0 ok=true s="" errors=0 n=6 res=[10,10,20,30,30,40] cache=1 hits=0
test: list=5,10,15,20
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			dups++;
			gold_cache_put(g, dups, g.res[i]);
		}
		i += 2;
	}
	out.i = dups;
	g.steps += g.n + 1;
	out
}
@end
@entry 29764e3cccad1ef1
kind: step
verb: apply
noun: middle
modifier: at_most
context: cache
phrase: apply cache bounds to middle segment at most {cap}
phrase: clamp central cache entries to at most {cap}
slot: cap int
test: list=10,50,60,70,20 cap=40
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[10,40,40,40,20] cache=3 hits=0
test: list=5,30,25,15 cap=20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[5,20,20,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	if g.n < 3 { return out; }
	var clamped = 0;
	for i in 1..(g.n - 1) {
		if g.res[i] > ceiling {
			g.res[i] = ceiling;
			clamped++;
		}
		gold_cache_put(g, i, g.res[i]);
	}
	out.i = clamped;
	g.steps += g.n + 1;
	out
}
@end
@entry 29daba76112f1a6b
kind: step
verb: normalize
noun: values
modifier: each
context: cache
phrase: normalize each cached value against baseline {base}
phrase: shift each cache element relative to {base}
slot: base int
test: list=10,20,30 base=5
expect: => i=45 r=0.0 ok=true s="" errors=0 n=3 res=[5,15,25] cache=3 hits=0
test: list=100,200 base=50
expect: => i=200 r=0.0 ok=true s="" errors=0 n=2 res=[50,150] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var total = 0;
	for i in g.n {
		g.res[i] -= b;
		gold_cache_put(g, i, g.res[i]);
		total += g.res[i];
	}
	out.i = total;
	g.steps += g.n + 1;
	out
}
@end
@entry bd2f532285c7ba7e
kind: step
verb: normalize
noun: items
modifier: first
context: cache
phrase: normalize first {count} cached items by offset {offset}
phrase: adjust leading {count} cache entries by {offset}
slot: count int
slot: offset int
test: list=10,20,30,40 count=2 offset=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[15,25,30,40] cache=2 hits=0
test: list=5,15,25 count=1 offset=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[15,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let off = ${offset};
	let lim = if k > g.n { g.n } else { if k < 0 { 0 } else { k } };
	for i in lim {
		g.res[i] += off;
		gold_cache_put(g, i, g.res[i]);
	}
	out.i = lim;
	g.steps += lim + 1;
	out
}
@end
@entry dcce0aa846b4684e
kind: step
verb: shift
noun: prefix
modifier: none
context: cache
phrase: shift prefix elements without altering cache keys
phrase: rotate leading values without cache key translation
