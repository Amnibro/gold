fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var valid = true;
	for k in g.n {
		if g.res[k] > c {
			valid = false;
			break;
		}
	}
	if !valid {
		gold_fail(g, "value exceeded maximum cap");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, if valid { "valid maximum" } else { "exceeded maximum" });
	out
}
