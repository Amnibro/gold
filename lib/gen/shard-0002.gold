fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		if kept == 0 || g.res[kept - 1] != g.res[k] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.s.clear();
	format(out.s, "pairwise deduped count:", kept);
	out.i = kept;
	out
}
@end
