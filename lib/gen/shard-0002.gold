fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	var i = 0;
	while i < kept {
		var j = i + 1;
		while j < kept {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n + kept * kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
