fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < g.n && g.res[count] < 0 { count++; }
	var i = 0;
	var j = count - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = count;
	g.steps += count + 1;
	out
}
@end
