code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ec = 0;
	var oc = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[ec] = g.res[k];
			ec++;
		} else {
			odds[oc] = g.res[k];
			oc++;
		}
	}
	for i in ec { g.res[i] = evens[i]; }
	for i in oc { g.res[ec + i] = odds[i]; }
	g.steps += g.n * 2;
	out.i = ec;
	out.s.clear();
	format(out.s, "grouped ", ec, " evens ahead of odds");
	out
}
@end
