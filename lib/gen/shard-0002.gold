@entry 18d1b6d758ceb5a8
kind: step
verb: dedupe
noun: subfunction
modifier: any
context: list
phrase: dedupe list elements having any duplicate subfunction value
phrase: remove elements sharing duplicate transformed values
phrase: filter list items by removing any duplicate mapped outputs
test: list=2,-2,3,-3,5
expect: => i=2 r=0.0 ok=true s="deduped 2 duplicate mapped items" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="deduped 0 duplicate mapped items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let val_norm = if x >= 0 { x } else { -x };
		var seen = false;
		for j in kept {
			let prev = g.res[j];
			let prev_norm = if prev >= 0 { prev } else { -prev };
			if val_norm == prev_norm { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " duplicate mapped items");
	out
}
@end
