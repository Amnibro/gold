fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matches = 0;
	if g.n > 1 {
		for k in 0..(g.n - 1) {
			if g.res[k] + g.res[k + 1] == tgt { matches++; }
		}
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "matched pairwise ", matches);
	out
}
@end
