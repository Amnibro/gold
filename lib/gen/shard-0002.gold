slot: cap int
test: list=1,1,1,2,2,3 cap=2
expect: => i=5 r=0.0 ok=true s="filtered items remaining:5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5,5 cap=1
expect: => i=1 r=0.0 ok=true s="filtered items remaining:1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen_count = 0;
		for j in kept {
			if g.res[j] == x { seen_count++; }
		}
		if seen_count < limit {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.s.clear();
	format(out.s, "filtered items remaining:", kept);
	out.i = kept;
	out
}
@end
@entry 7519b1a100492741
kind: step
verb: limit
noun: letters
modifier: pairwise
context: format
phrase: limit consecutive matching letters pairwise
phrase: condense duplicate adjacent characters pairwise
test: text="aabbcddde"
expect: => i=5 r=0.0 ok=true s="abcde" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyyyz"
expect: => i=3 r=0.0 ok=true s="xyz" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		out.i = 0;
		return out;
	}
	var new_len = 0;
	var buf byte[200] = [0; 200];
	for k in out.s.len {
		let c = out.s[k];
		if new_len == 0 || buf[new_len - 1] != c {
			buf[new_len] = c;
			new_len++;
		}
	}
	out.s.clear();
	for k in new_len {
		out.s.push(buf[k]);
	}
	out.i = new_len;
	g.steps++;
	out
}
@end
