@entry a0dc570002468300
kind: step
verb: dedupe
noun: primes
modifier: none
context: list
phrase: dedupe prime numbers in list sequence
phrase: remove duplicate prime values across list
test: list=2,3,2,5,3,7,4
expect: => i=5 r=0.0 ok=true s="deduped primes count 5" errors=0 n=5 res=[2,3,5,7,4] cache=0 hits=0
test: list=5,5,11,11,13
expect: => i=3 r=0.0 ok=true s="deduped primes count 3" errors=0 n=3 res=[5,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		var drop = false;
		if is_p {
			for j in kept {
				if g.res[j] == x { drop = true; break; }
			}
		}
		if !drop {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped primes count ", kept);
	out
}
@end
