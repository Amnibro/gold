code:
fn ${ID}_is_vowel(b byte) bool {
	b == 97 || b == 101 || b == 105 || b == 111 || b == 117
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var consonants = 0;
	for k in out.s.len {
		let b = out.s[k];
		if (b >= 97 && b <= 122) && !${ID}_is_vowel(b) {
			consonants++;
		}
	}
	g.steps += out.s.len;
	out.i = consonants;
	out.s.clear();
	format(out.s, "folded ", consonants, " consonant letters");
	out
}
@end
