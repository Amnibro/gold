fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in out.s.len {
		let b = out.s[i];
		let is_alnum = (b >= 48 as byte && b <= 57 as byte) || (b >= 65 as byte && b <= 90 as byte) || (b >= 97 as byte && b <= 122 as byte);
		if !is_alnum {
			gold_push(g, i);
		}
	}
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] < g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += out.s.len;
	out.i = g.n;
	out
}
