test: list=10,20,30,40 max_rot=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${max_rot};
	var rot = 0;
	while rot < max_r && g.n > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		rot++;
	}
	out.i = rot;
	g.steps += g.n;
	out
}
@end
