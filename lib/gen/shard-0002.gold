	var out = v;
	let limit = ${thresh};
	var running_sum = 0;
	var kept = 0;
	for i in g.n {
		if running_sum + g.res[i] <= limit {
			running_sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = running_sum;
	g.steps += kept + 1;
	out
}
@end
