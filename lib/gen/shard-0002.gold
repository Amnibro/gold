code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${length};
	let bound = if lim < out.s.len { lim } else { out.s.len };
	var left = 0;
	var right = bound - 1;
	while left < right {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		left += 1;
		right -= 1;
	}
	g.steps += out.s.len;
	out.i = bound;
	out
}
@end
