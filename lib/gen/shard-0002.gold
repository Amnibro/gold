@entry d5bc8abbce02adb3
kind: step
verb: normalize
noun: evens
modifier: safely
context: retry
phrase: safely normalize even retry attempts by {scale}
phrase: even retry attempt safe normalization {scale}
slot: scale int
test: list=10,15,20,25 scale=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,10,25] cache=0 hits=0
test: list=4,8,12 scale=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	if s <= 0 {
		return out;
	}
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			g.res[i] /= s;
		}
		i++;
	}
	out.i = s;
	g.steps += g.n;
	out
}
@end
@entry b375bf7d2fa48b22
kind: step
verb: find
noun: minimum
modifier: nested
context: retry
phrase: find nested minimum retry latency above {floor}
phrase: minimum nested retry search over {floor}
slot: floor int
test: list=15,8,40,25 floor=10
expect: => i=15 r=0.0 ok=true s="" errors=0 n=4 res=[15,8,40,25] cache=0 hits=0
test: list=5,9,12 floor=20
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[5,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var mn = 999999;
	var found = false;
	var i = 0;
	while i < g.n {
		if g.res[i] >= fl && g.res[i] < mn {
			mn = g.res[i];
			found = true;
		}
		i++;
	}
	if found {
		out.i = mn;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
