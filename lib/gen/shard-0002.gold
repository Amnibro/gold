fn ${ID}(n int) int {
	var candidate = n;
	if candidate < 2 {
		candidate = 2;
	}
	var found = false;
	while !found {
		var is_prime = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 {
				is_prime = false;
				d = candidate;
			}
			d = d + 1;
		}
		if is_prime {
			return candidate;
		}
		candidate = candidate + 1;
	}
	candidate
}
@end
