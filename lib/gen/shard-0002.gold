code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	gold_clear(g);
	let slen = out.s.len;
	let lim = if k > slen { slen } else { if k < 0 { 0 } else { k } };
	let start = slen - lim;
	for idx in start..slen {
		let b = out.s[idx] as int;
		gold_push(g, b);
		gold_cache_put(g, idx, b);
	}
	out.i = lim;
	g.steps += lim + 1;
	out
}
@end
