@entry 60ee97dcf2a4aa24
kind: step
verb: clamp
noun: gaps
modifier: running
context: core
phrase: clamp running gaps to limit {max_gap}
phrase: restrict step differences to margin {max_gap}
slot: max_gap int
test: list=10,25,30,50 max_gap=10
expect: => i=2 r=0.0 ok=true s="clamped gaps 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,12,30 max_gap=8
expect: => i=1 r=0.0 ok=true s="clamped gaps 1" errors=0 n=3 res=[5,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${max_gap};
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var clamped = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > gap {
			g.res[k] = g.res[k - 1] + gap;
			clamped++;
		} else if diff < -gap {
			g.res[k] = g.res[k - 1] - gap;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped gaps ", clamped);
	out
}
@end
