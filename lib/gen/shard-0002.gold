expect: => i=40 r=0.0 ok=true s="nested range span 40" errors=0 n=4 res=[10,50,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var span = 0;
	if g.n > 0 {
		var mn = g.res[0];
		var mx = g.res[0];
		for k in 1..g.n {
			if g.res[k] < mn { mn = g.res[k]; }
			if g.res[k] > mx { mx = g.res[k]; }
		}
		span = mx - mn;
	}
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "nested range span ", span);
	out
}
@end
