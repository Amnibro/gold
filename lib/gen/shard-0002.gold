code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in out.s.len {
		for j in i + 1..out.s.len {
			if out.s[i] > out.s[j] {
				let t = out.s[i]; out.s[i] = out.s[j]; out.s[j] = t;
			}
		}
	}
	var distinct = 0;
	for i in out.s.len {
		if i == 0 || out.s[i] != out.s[i - 1] { distinct++; }
	}
	out.i = distinct;
	g.steps += out.s.len * out.s.len;
	out
}
@end
