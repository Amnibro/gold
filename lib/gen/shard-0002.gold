fn ${ID}(n int) int {
	var v = n;
	if v <= 1 {
		return 0;
	}
	var steps = 0;
	while v > 1 {
		if v % 3 == 0 {
			v = v / 3;
		} else if v % 2 == 0 {
			v = v / 2;
		} else {
			v = v - 1;
		}
		steps = steps + 1;
	}
	steps
}
@end
@entry 22938f13c9d8acc9
kind: fn
verb: dedupe
noun: numbers
modifier: while
context: transform
phrase: dedupe numbers while scanning
phrase: strip adjacent duplicate digits
test: arg=11223,5555
expect: 123
expect: 5
test: arg=1002,7
expect: 102
expect: 7
code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return v;
	}
	var rev = 0;
	while v > 0 {
		rev = rev * 10 + (v % 10);
		v = v / 10;
	}
	var result = 0;
	var last_digit = -1;
	while rev > 0 {
		let d = rev % 10;
		if d != last_digit {
			result = result * 10 + d;
			last_digit = d;
		}
		rev = rev / 10;
	}
	result
}
@end
