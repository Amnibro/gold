@entry 357bfba3c1cbdad0
kind: step
verb: return
noun: digits
modifier: every_other
context: math
phrase: return alternate digits taking every other one
phrase: extract every other digit from integer value
test: input=123456
expect: => i=135 r=0.0 ok=true s="alternate digits value 135" errors=0 n=0 res=[] cache=0 hits=0
test: input=98765
expect: => i=975 r=0.0 ok=true s="alternate digits value 975" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.i;
	if n < 0 { n = -n; }
	var digits = [0; 32];
	var count = 0;
	while n > 0 {
		digits[count] = n % 10;
		count++;
		n /= 10;
	}
	var res_val = 0;
	var pos = count - 1;
	var take = true;
	while pos >= 0 {
		if take { res_val = res_val * 10 + digits[pos]; }
		take = !take;
		pos--;
	}
	out.i = res_val;
	g.steps += count + 1;
	out.s.clear();
	format(out.s, "alternate digits value ", res_val);
	out
}
@end
