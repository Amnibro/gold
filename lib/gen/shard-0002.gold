fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_digit = false;
	for i in out.s.len {
		if out.s[i] >= '0' && out.s[i] <= '9' { has_digit = true; break; }
	}
	if has_digit { out.s.clear(); out.ok = false; }
	else { out.ok = true; }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
