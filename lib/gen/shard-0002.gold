fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var kept = 0;
	for k in g.n {
		if sum + g.res[k] <= b {
			sum += g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "budget allowed ", kept, " elements");
	out
}
@end
