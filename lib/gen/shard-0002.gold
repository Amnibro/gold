fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
