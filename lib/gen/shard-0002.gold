fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var res byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		var run = 0;
		while i < out.s.len && out.s[i] == b {
			run++;
			i++;
		}
		var keep = run;
		if keep < lo { keep = lo; }
		if keep > hi { keep = hi; }
		for k in keep {
			if res.len < 200 { res.push(b); }
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
