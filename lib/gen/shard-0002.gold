code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var kept = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = 0 - diff; }
		if diff >= mg {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
