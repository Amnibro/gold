code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var target = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			target = x;
			found = true;
			break;
		}
	}
	if found {
		out.i = target;
		out.s.clear();
		format(out.s, "head found ", target);
	} else {
		gold_fail(g, "no item found in range");
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
