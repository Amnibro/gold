fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = g.n / 2;
	if pairs > lim { pairs = lim; }
	var sum = 0;
	for k in pairs {
		sum += g.res[2 * k] + g.res[2 * k + 1];
	}
	out.s.clear();
	format(out.s, "paired:", pairs, " sum:", sum);
	out.i = sum;
	g.steps += g.n;
	out
}
@end
