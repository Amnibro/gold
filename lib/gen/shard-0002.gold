code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var avg = 0;
	if g.n > 0 {
		var tot = 0;
		for k in g.n { tot += g.res[k]; }
		avg = tot / g.n;
		for k in g.n { g.res[k] -= avg; }
	}
	g.steps += g.n * 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "subtracted average baseline: ", avg);
	out
}
@end
