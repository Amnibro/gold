expect: => i=2 r=0.0 ok=true s="aggregated 2" errors=0 n=4 res=[12,35,42,89] cache=0 hits=0
test: list=70,17,85,77 digit=7
expect: => i=3 r=0.0 ok=true s="aggregated 3" errors=0 n=4 res=[70,17,85,77] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${digit};
	var count = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = 0 - x; }
		var has_d = false;
		if x == 0 && tgt == 0 { has_d = true; }
		while x > 0 {
			if x % 10 == tgt { has_d = true; }
			x /= 10;
		}
		if has_d { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "aggregated ", count);
	out
}
@end
