code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	var sign = 1;
	var idx = out.s.len;
	while idx > 0 {
		idx -= 1;
		acc += sign * (out.s[idx] as int);
		sign = -sign;
	}
	g.steps += out.s.len;
	out.i = acc;
	out
}
@end
