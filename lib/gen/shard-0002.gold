@entry 94cf8a62c30c39a8
kind: step
verb: dedupe
noun: items
modifier: in_place
context: math
phrase: dedupe items in place removing repeated values
phrase: eliminate duplicate elements in place across list
test: list=1,2,2,3,3,4
expect: => i=4 r=0.0 ok=true s="deduped in place count: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,10,15
expect: => i=3 r=0.0 ok=true s="deduped in place count: 3" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[k] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped in place count: ", kept);
	out
}
@end
