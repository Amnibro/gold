test: text="a   b   c"
expect: => i=5 r=0.0 ok=true s="a b c" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello   world"
expect: => i=11 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[..200] = "";
	var last_was_space = false;
	for i in out.s.len {
		let ch = out.s[i];
		if ch == ' ' {
			if !last_was_space {
				buf.push(ch);
				last_was_space = true;
			}
		} else {
			buf.push(ch);
			last_was_space = false;
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
