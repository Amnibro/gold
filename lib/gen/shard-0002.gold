fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	for i in 0..(g.n - 1) {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted full sequence ", g.n);
	out
}
@end
@entry eb5456c6a349c86c
kind: step
verb: validate
noun: prefix
modifier: at_most
context: core
phrase: validate prefix of {count} items under ceiling {cap}
phrase: check prefix total of {count} values within {cap}
slot: count int
slot: cap int
test: list=5,10,15 count=2 cap=20
expect: => i=15 r=0.0 ok=true s="prefix under ceiling 15" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=10,20,30 count=3 cap=40
expect: => i=60 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let ceiling = ${cap};
	var prefix_sum = 0;
	let lim = if cnt < g.n { cnt } else { g.n };
	for k in lim { prefix_sum += g.res[k]; }
	if prefix_sum > ceiling {
		gold_fail(g, "prefix exceeds ceiling");
		out.ok = false;
		out.i = prefix_sum;
		return out;
	}
	g.steps += lim;
	out.i = prefix_sum;
	out.s.clear();
	format(out.s, "prefix under ceiling ", prefix_sum);
	out
}
@end
