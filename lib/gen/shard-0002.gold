fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_count = 1;
	if g.n > 1 {
		var inc = g.res[1] >= g.res[0];
		for k in 1..(g.n - 1) {
			let next_inc = g.res[k + 1] >= g.res[k];
			if next_inc != inc {
				run_count++;
				inc = next_inc;
