@entry 5f238148ddf2eb95
kind: step
verb: dedupe
noun: head
modifier: safely
context: list
phrase: dedupe head of list safely up to limit {lim}
phrase: deduplicate list head safely within bound {lim}
phrase: safely remove head duplicates across first {lim} items
slot: lim int
test: list=2,2,3,3,4 lim=4
expect: => i=2 r=0.0 ok=true s="safely deduped head, removed 2 duplicates" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=1,2,3 lim=5
expect: => i=0 r=0.0 ok=true s="safely deduped head, removed 0 duplicates" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	if limit <= 0 {
		g.steps += 1;
		out.i = 0;
		return out;
	}
	var prefix_len = if limit < g.n { limit } else { g.n };
	var kept = 0;
	for k in prefix_len {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = prefix_len - kept;
	var write_pos = kept;
	var r = prefix_len;
	while r < g.n {
		g.res[write_pos] = g.res[r];
		write_pos++;
		r++;
	}
	g.n = write_pos;
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "safely deduped head, removed ", removed, " duplicates");
	out
}
@end
