code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx + 1 < out.s.len {
		let c1 = out.s[idx];
		let c2 = out.s[idx + 1];
		if c1 >= '0' && c1 <= '9' && c2 >= '0' && c2 <= '9' {
			out.s[idx] = c2;
			out.s[idx + 1] = c1;
			idx += 2;
		} else {
			idx += 1;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
