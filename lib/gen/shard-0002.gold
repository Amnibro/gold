code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	var i = 0;
	while i <= out.s.len {
		if i == out.s.len || out.s[i] == ' ' {
			var l = start;
			var r = i - 1;
			while l < r {
				let t = out.s[l]; out.s[l] = out.s[r]; out.s[r] = t;
				l++;
				r--;
			}
			start = i + 1;
		}
		i++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
