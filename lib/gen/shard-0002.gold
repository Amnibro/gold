code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	var d = 0;
	var res byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		if b == 40 as byte || b == 91 as byte {
			d++;
			if res.len < 200 { res.push(b); }
		} else if b == 41 as byte || b == 93 as byte {
			if d > 0 { d--; }
			if res.len < 200 { res.push(b); }
		} else if b == 32 as byte {
			if d == 0 || d > max_d {
				if res.len < 200 { res.push(b); }
			}
		} else {
			if res.len < 200 { res.push(b); }
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
