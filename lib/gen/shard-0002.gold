fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var reps = ${times};
	if reps < 1 { reps = 1; }
	if reps > 5 { reps = 5; }
	out.s.clear();
	for k in reps {
		if k > 0 { format(out.s, " "); }
		format(out.s, "term");
	}
	g.steps += reps;
	out.i = reps;
	out
}
