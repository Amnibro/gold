expect: 450
expect: 7
code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return v;
	}
	var rev = 0;
	while v > 0 {
		rev = rev * 10 + (v % 10);
		v = v / 10;
	}
	var seen_mask = 0;
	var res = 0;
	while rev > 0 {
		let d = rev % 10;
		var bit = 1;
		var i = 0;
		while i < d {
			bit = bit * 2;
			i = i + 1;
		}
		if (seen_mask / bit) % 2 == 0 {
			res = res * 10 + d;
			seen_mask = seen_mask + bit;
		}
		rev = rev / 10;
	}
	res
}
@end
