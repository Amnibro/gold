	var out = v;
	var kept byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		var seen_later = false;
		var j = i + 1;
		while j < out.s.len {
			if out.s[j] == c { seen_later = true; break; }
			j += 1;
		}
		if !seen_later {
			if kept.len < 200 { kept.push(c); }
		}
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
