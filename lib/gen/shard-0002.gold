fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var word_idx = 0;
	var cur_len = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			if cur_len > 0 {
				if word_idx % 2 == 0 {
					gold_push(g, cur_len);
				}
				word_idx++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		if word_idx % 2 == 0 {
			gold_push(g, cur_len);
		}
		word_idx++;
	}
	g.steps += out.s.len + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "measured ", g.n, " alternating words");
	out
}
@end
