fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var kept = 0;
	for i in g.n {
		var ok = false;
		if i > 0 && g.res[i] + g.res[i - 1] >= thresh { ok = true; }
		if i + 1 < g.n && g.res[i] + g.res[i + 1] >= thresh { ok = true; }
		if ok {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
