@entry ef6942745e23e7da
kind: step
verb: compare
noun: tally
modifier: between
context: compare
phrase: compare tally frequencies between {lo} to {hi}
phrase: count items with frequency between {lo} to {hi}
slot: lo int
slot: hi int
test: list=2,2,3,4,4,4 lo=2 hi=3
expect: => i=2 r=0.0 ok=true s="tally in range count 2" errors=0 n=6 res=[2,2,3,4,4,4] cache=0 hits=0
test: list=5,5,5,6,7 lo=1 hi=2
expect: => i=2 r=0.0 ok=true s="tally in range count 2" errors=0 n=5 res=[5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x { freq++; }
			}
			if freq >= lo && freq <= hi {
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tally in range count ", count);
	out
}
@end
