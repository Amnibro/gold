fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var min_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i >= 0 {
			if g.res[i] < min_val {
				min_val = g.res[i];
			}
			g.res[i] = min_val;
			i--;
		}
		out.i = min_val;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "folded min in reverse: ", out.i);
	out
}
