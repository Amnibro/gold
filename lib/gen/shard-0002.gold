@entry c4f2da3e2c859baf
kind: step
verb: run
noun: gaps
modifier: running
context: sort
phrase: run consecutive differences across sorted values
phrase: compute running spacing gaps along sequence
test: list=1,4,9,16
expect: => i=7 r=5.0 ok=true s="" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
test: list=10,15,25,40
expect: => i=15 r=10.0 ok=true s="" errors=0 n=4 res=[10,15,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_diff = 0;
	var total_gap = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		total_gap += diff;
		if diff > max_diff { max_diff = diff; }
	}
	out.i = max_diff;
	out.r = if g.n > 1 { (total_gap as real) / ((g.n - 1) as real) } else { 0.0 };
	g.steps += g.n + 1;
	out
}
@end
