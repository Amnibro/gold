		for i in g.n { s += g.res[i]; }
		let avg = s / g.n;
		gold_push(g, avg);
		out.i = avg;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filled average value ", out.i);
	out
}
@end
