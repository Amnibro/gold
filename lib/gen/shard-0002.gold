kind: step
verb: split
noun: steps
modifier: nested
context: stats
phrase: split steps nested around threshold {threshold}
phrase: partition sample steps nested by cutoff {threshold}
slot: threshold int
test: list=10,25,5,40,15 threshold=20
expect: => i=3 r=0.0 ok=true s="split at threshold: 3 below" errors=0 n=5 res=[10,5,15,25,40] cache=0 hits=0
test: list=2,4,8,12 threshold=6
expect: => i=2 r=0.0 ok=true s="split at threshold: 2 below" errors=0 n=4 res=[2,4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var below = 0;
	for k in g.n {
		if g.res[k] <= th { below++; }
	}
	var low_idx = 0;
	var high_idx = below;
	var buf int[512] = [0; 512];
	for k in g.n {
		if g.res[k] <= th {
			buf[low_idx] = g.res[k];
			low_idx++;
		} else {
			buf[high_idx] = g.res[k];
			high_idx++;
		}
	}
	for k in g.n {
		g.res[k] = buf[k];
	}
	g.steps += g.n * 2;
	out.i = below;
	out.s.clear();
	format(out.s, "split at threshold: ", below, " below");
	out
}
@end
