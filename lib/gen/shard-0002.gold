fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var ok = true;
	for k in g.n {
		if g.res[k] > thresh {
			ok = false;
			break;
		}
	}
	if !ok {
		gold_fail(g, "threshold exceeded");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, if ok { "valid" } else { "invalid" });
	out
}
