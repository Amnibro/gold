expect: => i=1 r=0.0 ok=true s="reverse budget valid true" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=20,30,40 total_budget=50
expect: => i=0 r=0.0 ok=false s="reverse budget valid false" errors=1 n=3 res=[20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${total_budget};
	var sum = 0;
	var valid = true;
	var k = g.n - 1;
	while k >= 0 {
		sum += g.res[k];
		if sum > b {
			valid = false;
			gold_fail(g, "budget exceeded in reverse");
			break;
		}
		k--;
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "reverse budget valid ", valid);
	out
}
@end
