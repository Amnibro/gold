code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var runs int[512] = [0; 512];
	var rn = 0;
	var i = 0;
	while i < g.n {
		var cur = 1;
		while i + 1 < g.n && g.res[i] == g.res[i + 1] {
			cur++;
			i++;
		}
		if cur > lim { cur = lim; }
		runs[rn] = cur;
		rn++;
		i++;
	}
	gold_clear(g);
	for k in rn { gold_push(g, runs[k]); }
	out.i = rn;
	g.steps += g.n;
	out
}
@end
