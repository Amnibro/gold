expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	var u int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < k && i < g.n {
		var seen = false;
		for j in un { if u[j] == g.res[i] { seen = true; break; } }
		if !seen { u[un] = g.res[i]; un++; }
		i++;
	}
	gold_clear(g);
	for idx in un { gold_push(g, u[idx]); }
	out.i = un;
	g.steps += g.n;
	out
}
@end
