fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_zeros = 0;
	for k in g.n {
		var x = core_abs_val(g.res[k]);
		var zeros = 0;
		if x > 0 {
			while x % 10 == 0 {
				zeros++;
				x /= 10;
			}
		}
		g.res[k] = zeros;
		total_zeros += zeros;
	}
	out.i = total_zeros;
	g.steps += g.n;
	out
}
@end
