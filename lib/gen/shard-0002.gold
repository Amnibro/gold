fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = g.res[2 * k] + g.res[2 * k + 1];
	}
	if g.n % 2 != 0 {
		g.res[pairs] = g.res[g.n - 1];
		g.n = pairs + 1;
	} else {
		g.n = pairs;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined sequence len ", g.n);
	out
}
@end
