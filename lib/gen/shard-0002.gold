code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var safe = true;
	for k in g.n {
		if g.res[k] > cap { safe = false; break; }
	}
	if !safe {
		gold_fail(g, "value exceeds ceiling");
		out.ok = false;
		out.i = 0;
		return out;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "all under ceiling ", g.n);
	out
}
@end
