@entry 67ef96b907e7745d
kind: step
verb: dedupe
noun: squares
modifier: every_other
context: aggregate
phrase: dedupe perfect square values at every other position
phrase: filter duplicate squares at alternating positions
test: list=1,4,3,4,5,4
expect: => i=2 r=0.0 ok=true s="filtered 2 duplicate squares" errors=0 n=6 res=[1,4,3,0,5,0] cache=0 hits=0
test: list=2,9,4,9
expect: => i=1 r=0.0 ok=true s="filtered 1 duplicate squares" errors=0 n=4 res=[2,9,4,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[512] = [0; 512];
	var seen_count = 0;
	var cleared = 0;
	for k in g.n {
		if k % 2 == 1 {
			let x = g.res[k];
			if core_is_square(x) {
				var found = false;
				for j in seen_count {
					if seen[j] == x { found = true; break; }
				}
				if found {
					g.res[k] = 0;
					cleared++;
				} else {
					seen[seen_count] = x;
					seen_count++;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = cleared;
	out.s.clear();
	format(out.s, "filtered ", cleared, " duplicate squares");
	out
}
@end
