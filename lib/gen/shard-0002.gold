expect: => i=3 r=0.0 ok=true s="clamped maximum count 3" errors=0 n=5 res=[5,15,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var clamped_count = 0;
	if g.n > 0 {
		var k = g.n - 1;
		while k >= 0 {
			if g.res[k] > cap {
				g.res[k] = cap;
				clamped_count++;
			}
			k--;
		}
	}
	g.steps += g.n;
	out.i = clamped_count;
	out.s.clear();
	format(out.s, "clamped maximum count ", clamped_count);
	out
}
@end
