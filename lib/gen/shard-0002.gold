@entry bb66171d2815f927
kind: step
verb: scan
noun: digits
modifier: with_retry
context: stats
phrase: scan digits with retry validation
phrase: tally digit sums with retry pass
test: list=12,34,56
expect: => i=21 r=0.0 ok=true s="scanned digit sum: 21" errors=0 n=3 res=[12,34,56] cache=0 hits=0
test: list=7,89,101
expect: => i=26 r=0.0 ok=true s="scanned digit sum: 26" errors=0 n=3 res=[7,89,101] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum1 = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		while x > 0 {
			sum1 += x % 10;
			x /= 10;
		}
	}
	var sum2 = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		var x = if g.res[idx] < 0 { -g.res[idx] } else { g.res[idx] };
		while x > 0 {
			sum2 += x % 10;
			x /= 10;
		}
		idx--;
	}
	g.steps += g.n * 2;
	out.ok = sum1 == sum2;
	out.i = sum1;
	out.s.clear();
	format(out.s, "scanned digit sum: ", sum1);
	out
}
@end
