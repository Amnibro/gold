fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	var len = 1;
	if g.n > 0 {
		while start + 1 < g.n && g.res[start] != g.res[start + 1] {
			start++;
		}
		if start + 1 < g.n {
			var k = start;
			while k + 1 < g.n && g.res[k] == g.res[k + 1] {
				len++;
				k++;
			}
		}
	}
	gold_clear(g);
	gold_push(g, start);
	gold_push(g, len);
	out.i = len;
	g.steps += g.n;
	out
}
@end
