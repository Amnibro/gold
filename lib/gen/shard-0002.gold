code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	var idx = 0;
	while idx + 1 < g.n && count < lim {
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		count++;
		idx += 2;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " pairs");
	out
}
@end
