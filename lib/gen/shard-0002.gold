expect: => i=4 r=0.0 ok=true s="filtered count 4" errors=0 n=4 res=[10,15,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if d != 0 {
		var kept = 0;
		for k in g.n {
			if g.res[k] % d == 0 {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		g.n = kept;
		out.i = kept;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filtered count ", out.i);
	out
}
@end
