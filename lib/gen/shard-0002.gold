fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 {
		g.steps++;
		return out;
	}
	var write_idx = 1;
	for idx in 1..out.s.len {
		if out.s[idx] != out.s[write_idx - 1] {
			out.s[write_idx] = out.s[idx];
			write_idx++;
		}
	}
	out.s.resize(write_idx, 0);
	out.i = write_idx;
	g.steps += write_idx + 1;
	out
}
@end
