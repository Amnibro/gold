	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_p = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if ${ID}_is_p(g.res[k]) { sum_p += g.res[k]; }
	}
	g.steps += g.n;
	out.i = sum_p;
	out.s.clear();
	format(out.s, "folded primes in reverse sum: ", sum_p);
	out
}
@end
