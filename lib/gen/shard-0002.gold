@entry 122a544e62212efd
kind: step
verb: dedupe
noun: range
modifier: until
context: error
phrase: dedupe error range until threshold {thresh}
phrase: remove duplicate error codes until reaching {thresh}
slot: thresh int
test: list=1,1,2,2,10,10 thresh=10
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,10,10] cache=0 hits=0
test: list=3,3,3,5 thresh=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${thresh};
	var kept = 0;
	var stopped = false;
	for i in g.n {
		let x = g.res[i];
		if x >= lim { stopped = true; }
		if stopped {
			g.res[kept] = x;
			kept++;
		} else {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
