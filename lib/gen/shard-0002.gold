code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_idx};
	let e = ${end_idx};
	if g.n == 0 || s >= g.n || s > e {
		out.ok = false;
		return out;
	}
	let right = if e < g.n { e } else { g.n - 1 };
	var max_val = g.res[s];
	var i = s + 1;
	while i <= right {
		if g.res[i] > max_val { max_val = g.res[i]; }
		i++;
	}
	gold_cache_put(g, 0, max_val);
	out.i = max_val;
	out.ok = true;
	g.steps += g.n + 1;
	out
}
@end
