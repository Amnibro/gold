code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var kept = 2;
	for i in 2..g.n {
		let g1 = g.res[i] - g.res[i - 1];
		let g2 = g.res[i - 1] - g.res[i - 2];
		if g1 != g2 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
@entry fd4004d7e5cb284b
kind: step
verb: rotate
noun: letters
modifier: recursively
context: filter
phrase: rotate letters by shift offset {shift}
phrase: cycle alphabet letters with shift {shift}
slot: shift int
test: text="abc" shift=1
expect: => i=3 r=0.0 ok=true s="bcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" shift=3
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let base = c - 'a';
			let rot = (base as int + s) % 26;
			out.s[i] = ('a' as int + rot) as byte;
		}
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
