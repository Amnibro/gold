noun: duplicates
modifier: all
context: core
phrase: return all duplicate values in list
phrase: extract all repeated elements from results
test: list=1,2,2,3,4,4,5
expect: => i=2 r=0.0 ok=true s="found duplicates 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20,30,20,10
expect: => i=2 r=0.0 ok=true s="found duplicates 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { count++; }
		}
		if count > 1 {
			var seen = false;
			for k in dn { if dups[k] == g.res[i] { seen = true; break; } }
			if !seen { dups[dn] = g.res[i]; dn++; }
		}
	}
	for k in dn { g.res[k] = dups[k]; }
	g.n = dn;
	g.steps += g.n;
	out.i = dn;
	out.s.clear();
	format(out.s, "found duplicates ", dn);
	out
}
@end
