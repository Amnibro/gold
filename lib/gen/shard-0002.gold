kind: step
verb: dedupe
noun: prefix
modifier: any
context: list
phrase: dedupe initial prefix segment of size {prefix_len}
phrase: remove duplicate items from prefix length {prefix_len}
slot: prefix_len int
test: list=1,1,2,2,3,4,5 prefix_len=4
expect: => i=5 r=0.0 ok=true s="deduped prefix count 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=7,7,7,8,9 prefix_len=3
expect: => i=3 r=0.0 ok=true s="deduped prefix count 3" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let plen = ${prefix_len};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var drop = false;
		if i < plen {
			for j in kept {
				if g.res[j] == x { drop = true; break; }
			}
		}
		if !drop {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped prefix count ", kept);
	out
}
@end
