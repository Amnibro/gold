phrase: truncate suffix retaining values exceeding {threshold}
slot: threshold int
test: list=1,2,8,9,10 threshold=5
expect: => i=3 r=0.0 ok=true s="suffix len 3" errors=0 n=3 res=[8,9,10] cache=0 hits=0
test: list=10,3,15,20 threshold=12
expect: => i=2 r=0.0 ok=true s="suffix len 2" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var start_idx = g.n;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] >= th { start_idx = k; }
		else { break; }
		k--;
	}
	let new_len = g.n - start_idx;
	for i in new_len {
		g.res[i] = g.res[start_idx + i];
	}
	g.n = new_len;
	g.steps += g.n;
	out.i = new_len;
	out.s.clear();
	format(out.s, "suffix len ", new_len);
	out
}
@end
@entry a774424affa0825d
kind: step
verb: join
noun: step
modifier: sorted
context: math
phrase: accumulate sorted step increments across sequence
phrase: aggregate sorted step differences into total
test: list=9,2,7,4
expect: => i=7 r=0.0 ok=true s="sorted step sum 7" errors=0 n=5 res=[2,4,7,9,7] cache=0 hits=0
test: list=25,10,40,15
expect: => i=30 r=0.0 ok=true s="sorted step sum 30" errors=0 n=5 res=[10,15,25,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var step_sum = 0;
	if g.n > 1 {
		for k in 0..(g.n - 1) {
			step_sum += g.res[k + 1] - g.res[k];
		}
	}
	gold_push(g, step_sum);
	g.steps += g.n + 1;
	out.i = step_sum;
	out.s.clear();
	format(out.s, "sorted step sum ", step_sum);
	out
}
@end
