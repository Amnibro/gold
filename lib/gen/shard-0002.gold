@entry c4936382b0bc89a5
kind: step
verb: dedupe
noun: odds
modifier: at_least
context: core
phrase: dedupe odd elements seen at least {threshold} times
phrase: remove duplicate odds appearing at least {threshold} times
phrase: filter repeated odd items with count at least {threshold}
slot: threshold int
test: list=3,3,3,5,5 threshold=3
expect: => i=3 r=0.0 ok=true s="removed 3 repeated odds" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=1,1 threshold=3
expect: => i=0 r=0.0 ok=true s="removed 0 repeated odds" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var occ = 0;
			for j in g.n {
				if g.res[j] == x { occ++; }
			}
			if occ >= th {
				var already = false;
				for k in kept {
					if g.res[k] == x { already = true; break; }
				}
				if already {
					removed++;
					continue;
				}
			}
		}
		g.res[kept] = x;
		kept++;
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " repeated odds");
	out
}
@end
