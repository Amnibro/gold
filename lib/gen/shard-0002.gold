code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	var total = 0;
	while i < g.n {
		let val = g.res[i];
		var sum = val;
		var j = i + 1;
		while j < g.n && g.res[j] == val {
			sum += val;
			j++;
		}
		g.res[kept] = sum;
		kept++;
		total += sum;
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "aggregated ", kept, " streaks");
	out
}
@end
