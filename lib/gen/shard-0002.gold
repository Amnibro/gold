phrase: drop history each maximum
phrase: remove history each peak
test: arg=5293,88
expect: 523
expect: 8
test: arg=105,4
expect: 10
expect: 0
code:
fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return 0;
	}
	var max_d = 0;
	var temp = v;
	while temp > 0 {
		let d = temp % 10;
		if d > max_d {
			max_d = d;
		}
		temp = temp / 10;
	}
	var res = 0;
	var mult = 1;
	var dropped = false;
	while v > 0 {
		let d = v % 10;
		if d == max_d && !dropped {
			dropped = true;
		} else {
			res = res + d * mult;
			mult = mult * 10;
		}
		v = v / 10;
	}
	res
}
@end
