code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		if ${ID}_is_sq(g.res[k]) { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " perfect squares in sort");
	out
}
@end
