code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceil};
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		var res = 0;
		if ok {
			res = cached;
		} else {
			res = ${f}(x);
			gold_cache_put(g, x, res);
		}
		if res > limit {
			res = limit;
		}
		g.res[k] = res;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied function with ceiling ", limit);
	out
}
@end
