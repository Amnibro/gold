		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	let total_rank = max_freq * mul;
	g.steps += g.n;
	out.i = total_rank;
	out.s.clear();
