fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let head = g.res[0];
	let cached, found = gold_cache_get(g, head);
	if found {
		out.i = cached;
	} else {
		var rank = 1;
		for k in g.n {
			if g.res[k] < head {
				rank++;
			}
		}
		gold_cache_put(g, head, rank);
		out.i = rank;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "head rank: ", out.i);
	out
}
