expect: => i=2 r=0.0 ok=false s="probed 2 times" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_tries};
	let tgt = out.i;
	var tries = 0;
	var found = false;
	for i in g.n {
		if tries >= lim { break; }
		tries++;
		if g.res[i] == tgt {
			found = true;
			break;
		}
	}
	g.steps += tries;
	out.ok = found;
	out.i = tries;
	out.s.clear();
	format(out.s, "probed ", tries, " times");
	out
}
@end
