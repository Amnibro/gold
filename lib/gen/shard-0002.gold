fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${digit};
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = 0 - x; }
		var has_d = false;
		if x == 0 && tgt == 0 { has_d = true; }
		while x > 0 {
			if x % 10 == tgt { has_d = true; }
			x /= 10;
		}
		if has_d {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
