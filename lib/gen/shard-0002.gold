fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var s = 0;
		for i in g.n { s += g.res[i]; }
		let avg = s / g.n;
		var w = 0;
		for r in g.n {
			if g.res[r] >= avg {
				g.res[w] = g.res[r];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept above average ", g.n);
	out
}
@end
