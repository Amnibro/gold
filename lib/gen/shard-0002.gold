fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var word_count = 0;
	var in_word = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			in_word = false;
		} else {
			if !in_word {
				word_count++;
				in_word = true;
			}
		}
	}
	var pairs = word_count / 2;
	if pairs > lim { pairs = lim; }
	out.s.clear();
	format(out.s, "paired words:", pairs, " of words:", word_count);
	out.i = pairs;
	g.steps++;
	out
}
@end
