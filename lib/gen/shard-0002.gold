noun: range
modifier: until
context: text
phrase: apply range until delimiter ascii code {stop_ascii}
phrase: transform character prefix before encountering code {stop_ascii}
slot: stop_ascii int
test: text="hello-world" stop_ascii=45
expect: => i=11 r=0.0 ok=true s="HELLO-world" errors=0 n=0 res=[] cache=0 hits=0
test: text="foo:bar" stop_ascii=58
expect: => i=7 r=0.0 ok=true s="FOO:bar" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_ascii};
	for k in out.s.len {
		if (out.s[k] as int) == stop { break; }
		let c = out.s[k];
		if c >= 'a' && c <= 'z' {
			out.s[k] = (c as int - 32) as byte;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
