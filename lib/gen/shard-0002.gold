	if g.n <= 1 { return out; }
	var kept = 1;
	while kept < g.n && g.res[kept] >= g.res[kept - 1] {
		kept++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += kept + 1;
	out
}
