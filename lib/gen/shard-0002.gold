@entry 772f31a29300e105
kind: step
verb: filter
noun: words
modifier: up_to
context: core
phrase: filter words up to maximum length {maxlen}
phrase: trim text words keeping length under {maxlen}
slot: maxlen int
test: text="alpha beta gamma" maxlen=4
expect: => i=1 r=0.0 ok=true s="beta" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two three" maxlen=3
expect: => i=2 r=0.0 ok=true s="one two" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${maxlen};
	var kept byte[..200] = "";
	var word byte[..200] = "";
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if word.len > 0 && word.len <= max_len {
				if kept.len > 0 { kept.push(' '); }
				for b in word { kept.push(b); }
				count++;
			}
			word.clear();
		} else {
			word.push(c);
		}
	}
	if word.len > 0 && word.len <= max_len {
		if kept.len > 0 { kept.push(' '); }
		for b in word { kept.push(b); }
		count++;
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	g.steps += out.s.len;
	out.i = count;
	out
}
@end
