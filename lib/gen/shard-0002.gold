fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${cut};
	if g.n == 0 {
		return out;
	}
	var max_val = g.res[0];
	for k in g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
		}
	}
	var filled = 0;
	for k in g.n {
		if g.res[k] < cutoff {
			g.res[k] = max_val;
			filled++;
		}
	}
	g.steps += g.n * 2;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " items with maximum ", max_val);
	out
}
@end
