code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let num_pairs = g.n / 2;
	if num_pairs > 1 {
		for i in 0..(num_pairs - 1) {
			for j in 0..(num_pairs - 1 - i) {
				let y1 = g.res[2 * j + 1];
				let y2 = g.res[2 * (j + 1) + 1];
				if y1 > y2 {
					let x_tmp = g.res[2 * j];
					let y_tmp = g.res[2 * j + 1];
					g.res[2 * j] = g.res[2 * (j + 1)];
					g.res[2 * j + 1] = g.res[2 * (j + 1) + 1];
					g.res[2 * (j + 1)] = x_tmp;
					g.res[2 * (j + 1) + 1] = y_tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = num_pairs;
	out.s.clear();
	format(out.s, "sorted pairs count ", num_pairs);
	out
}
@end
