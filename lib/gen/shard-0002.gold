noun: subfunction
modifier: in_place
context: aggregate
phrase: sort results in place using function {step_fn}
phrase: order elements in place by function {step_fn}
slot: step_fn fn
test: list=3,1,4,2 step_fn=double
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,5,20 step_fn=square
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[25,100,400] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { g.res[k] = ${step_fn}(g.res[k]); }
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
