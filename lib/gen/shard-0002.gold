@entry 2185e06148295de3
kind: step
verb: pair
noun: threshold
modifier: first
context: core
phrase: pair first elements exceeding threshold {threshold}
phrase: find first adjacent pair meeting threshold {threshold}
phrase: check first pair above threshold {threshold}
slot: threshold int
test: list=2,3,10,12 threshold=20
expect: => i=22 r=0.0 ok=true s="found pair at index 2" errors=0 n=4 res=[2,3,10,12] cache=0 hits=0
test: list=1,2,3 threshold=50
expect: => i=0 r=0.0 ok=false s="pair missing" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var found = false;
	var idx = 0;
	while idx + 1 < g.n {
		let pair_sum = g.res[idx] + g.res[idx + 1];
		if pair_sum >= th {
			out.i = pair_sum;
			found = true;
			break;
		}
		idx++;
	}
	g.steps += idx + 1;
	out.s.clear();
	if found {
		format(out.s, "found pair at index ", idx);
	} else {
		gold_fail(g, "no pair reached threshold");
		out.ok = false;
		out.s.append("pair missing");
	}
	out
}
@end
@entry 00bcdfbe6b955b0a
kind: step
verb: dedupe
noun: average
modifier: none
context: core
phrase: dedupe results computing average value
phrase: remove duplicate results computing average
phrase: dedupe entries yielding average
test: list=2,2,4,4,6
expect: => i=2 r=4.0 ok=true s="removed 2 duplicates" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=10,10,10
expect: => i=2 r=10.0 ok=true s="removed 2 duplicates" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var sum = 0;
	for k in g.n {
		var is_dup = false;
		for j in kept {
			if g.res[j] == g.res[k] {
				is_dup = true;
				break;
			}
		}
		if !is_dup {
			g.res[kept] = g.res[k];
			sum += g.res[k];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	if kept > 0 {
		out.r = (sum as real) / (kept as real);
	}
	g.steps += g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " duplicates");
	out
}
@end
