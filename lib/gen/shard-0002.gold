@entry a8c1bc3da92f0f54
kind: step
verb: compare
noun: vowels
modifier: safely
context: sort
phrase: compare vowel counts safely between halves
phrase: verify vowel balance safely across query
test: text="banana"
expect: => i=3 r=0.0 ok=false s="banana" errors=0 n=0 res=[] cache=0 hits=0
test: text="apple"
expect: => i=2 r=0.0 ok=true s="apple" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = out.s.len / 2;
	var left_vowels = 0;
	var right_vowels = 0;
	for i in mid {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' { left_vowels++; }
	}
	for i in mid..out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' { right_vowels++; }
	}
	let balanced = left_vowels == right_vowels;
	out.ok = balanced;
	out.i = left_vowels + right_vowels;
	g.steps += out.s.len + 1;
	out
}
@end
