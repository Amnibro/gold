fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	if min_val < fl {
		gold_fail(g, "value below permitted minimum");
		out.ok = false;
	}
	out.i = min_val;
	g.steps += g.n + 1;
	out
}
@end
