	var count = ${k};
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "extracted last ", count, " elements");
	out
}
