code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var indices int[512] = [0; 512];
	var count = 0;
	for k in g.n {
		let idx = g.n - 1 - k;
		if g.res[idx] == tgt {
			indices[count] = idx;
			count++;
		}
	}
	gold_clear(g);
	for k in count {
		gold_push(g, indices[k]);
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " reverse checkpoints");
	out
}
@end
