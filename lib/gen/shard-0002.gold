@entry b4d72f49a136ab76
kind: step
verb: dedupe
noun: head
modifier: pairwise
context: list
phrase: dedupe head elements by checking adjacent pairs
phrase: eliminate adjacent duplicate pairs in list head
phrase: drop consecutive duplicate items from head
test: list=1,1,2,3,3,4
expect: => i=2 r=0.0 ok=true s="pairwise dedupe removed 2 duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6
expect: => i=2 r=0.0 ok=true s="pairwise dedupe removed 2 duplicates" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps += 1;
		out.i = 0;
		return out;
	}
	var kept = 1;
	var dups = 0;
	var k = 1;
	while k < g.n {
		if g.res[k] == g.res[k - 1] {
			dups++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
		k++;
	}
	g.n = kept;
	g.steps += g.n + dups;
	out.i = dups;
	out.s.clear();
	format(out.s, "pairwise dedupe removed ", dups, " duplicates");
	out
}
@end
