code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 1 || g.n < cnt {
		g.steps += 1;
		out.s.clear();
		out.s.append("no suffix grouped");
		return out;
	}
	var sum = 0;
	for k in 0..cnt {
		sum += g.res[g.n - 1 - k];
	}
	g.n = g.n - cnt;
	gold_push(g, sum);
	g.steps += cnt;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped suffix sum ", sum);
	out
}
@end
@entry bb1902ff578e20c9
kind: step
verb: dedupe
noun: squares
modifier: recursively
context: core
phrase: dedupe square numbers recursively in list
phrase: remove duplicate squares recursively from results
phrase: filter repeated square values recursively
test: list=4,9,4,16,9
expect: => i=2 r=0.0 ok=true s="removed 2 square duplicates" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="removed 0 square duplicates" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dups = 0;
	for k in g.n {
		let x = g.res[k];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { is_sq = true; }
		}
		var is_dup = false;
		if is_sq {
			for j in kept {
				if g.res[j] == x { is_dup = true; break; }
			}
		}
		if is_dup {
			dups++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = dups;
	out.s.clear();
	format(out.s, "removed ", dups, " square duplicates");
	out
}
@end
