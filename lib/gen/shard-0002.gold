@entry 489ff19ea98a5ac9
kind: step
verb: merge
noun: spaces
modifier: at_most
context: error
phrase: merge contiguous zero spaces at most {cap}
phrase: collapse duplicate empty space errors limit {cap}
slot: cap int
test: list=1,0,0,0,2 cap=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[1,0,2] cache=0 hits=0
test: list=1,2,3 cap=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write_idx = 0;
	var merged = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == 0 && write_idx > 0 && g.res[write_idx - 1] == 0 && merged < limit {
			merged++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	out.i = merged;
	g.steps += g.n + 1;
	out
}
@end
