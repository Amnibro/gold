test: list=10,5,30,20
expect: => i=2 r=0.0 ok=true s="split pairs swapped 2" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
test: list=4,8,12,6
expect: => i=1 r=0.0 ok=true s="split pairs swapped 1" errors=0 n=4 res=[4,8,6,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "split pairs swapped ", swaps);
	out
}
@end
