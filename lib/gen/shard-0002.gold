	while i + 1 < g.n {
		g.res[pairs] = (g.res[i] + g.res[i + 1]) / 2;
		pairs++;
		i += 2;
	}
	g.n = pairs;
	out.i = pairs;
	g.steps += pairs + 1;
	out
}
@end
