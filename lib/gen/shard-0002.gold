slot: width int
test: list=1,2,3,4,5 width=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10,20,30,40,50,60 width=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 || g.n == 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var start = (g.n - w) / 2;
	if start < 0 { start = 0; }
	var mid int[512] = [0; 512];
	var mn = 0;
	var k = start;
	while k < start + w && k < g.n {
		mid[mn] = g.res[k];
		mn++;
		k++;
	}
	gold_clear(g);
	for i in mn { gold_push(g, mid[i]); }
	out.i = mn;
	g.steps += g.n;
	out
}
@end
