code:
fn ${ID}_is_p(n int) bool {
	if n <= 1 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_count = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			if ${ID}_is_p(g.res[i]) && ${ID}_is_p(g.res[i + 1]) {
				pair_count++;
			}
		}
	}
	g.steps += g.n;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "pairwise prime pairs ", pair_count);
	out
}
@end
