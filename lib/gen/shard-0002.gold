test: list=3,10,3
expect: => i=0 r=0.0 ok=true s="squares match" errors=0 n=3 res=[3,10,3] cache=0 hits=0
test: list=4,1,5
expect: => i=-9 r=0.0 ok=false s="square difference -9" errors=0 n=3 res=[4,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need boundary values");
		out.ok = false;
		out.s.clear();
		out.s.append("too few items");
		return out;
	}
	let sq1 = g.res[0] * g.res[0];
	let sq2 = g.res[g.n - 1] * g.res[g.n - 1];
	let diff = sq1 - sq2;
	out.i = diff;
	out.ok = (diff == 0);
	g.steps += 1;
	out.s.clear();
	if diff == 0 {
		out.s.append("squares match");
	} else {
		format(out.s, "square difference ", diff);
	}
	out
}
@end
