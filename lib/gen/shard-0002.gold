fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let lim = if k < 0 { 0 } else if k > g.n { g.n } else { k };
	let start = g.n - lim;
	for i in lim {
		g.res[i] = g.res[start + i];
	}
	g.steps += g.n;
	g.n = lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "kept ", lim, " items");
	out
}
