code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_val = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x <= max_val {
			var r = 0;
			var is_sq = false;
			while r * r <= x {
				if r * r == x { is_sq = true; }
				r++;
			}
			if is_sq {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
