fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to scale");
		out.ok = false;
		g.steps++;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let tgt = ${target};
	if g.res[min_idx] < tgt {
		g.res[min_idx] = tgt;
	}
	out.i = g.res[min_idx];
	g.steps += g.n + 1;
	out
}
