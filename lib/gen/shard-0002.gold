	if g.n <= 1 { return out; }
	var write_idx = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	let removed = g.n - write_idx;
	g.n = write_idx;
	out.i = removed;
	g.steps += g.n + 1;
	out
}
@end
