fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let first = g.res[0];
		var k = 0;
		while k < g.n - 1 {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.res[g.n - 1] = first;
		out.i = first;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated first element: ", out.i);
	out
}
