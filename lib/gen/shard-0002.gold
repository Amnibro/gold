code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = if ${size} > 0 { ${size} } else { 1 };
	var sums int[512] = [0; 512];
	for i in g.n {
		var s = 0;
		for j in sz {
			if i + j < g.n {
				s += g.res[i + j];
			}
		}
		sums[i] = s;
	}
	for i in g.n {
		g.res[i] = sums[i];
	}
	g.steps += g.n * sz;
	out.i = g.n;
	out.s.clear();
	format(out.s, "window traced size ", sz);
	out
}
@end
