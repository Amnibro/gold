code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var unique = true;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] { unique = false; }
		}
	}
	out.ok = unique;
	out.i = if unique { 1 } else { 0 };
	g.steps += g.n + 1;
	out
}
@end
