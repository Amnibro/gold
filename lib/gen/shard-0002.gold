fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	if g.n > 0 {
		var max_so_far = g.res[0];
		var i = 1;
		while i < g.n {
			if g.res[i] > max_so_far {
				count++;
				max_so_far = g.res[i];
			}
			i++;
		}
	}
	out.i = count;
	g.steps += g.n;
	out
}
