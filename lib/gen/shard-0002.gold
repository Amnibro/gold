kind: step
verb: repeat
noun: evens
modifier: unique
context: core
phrase: repeat unique even numbers into list
phrase: collect distinct even values without duplicates
test: list=2,4,2,6,4,8
expect: => i=4 r=0.0 ok=true s="unique evens count: 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,2,5,2
expect: => i=1 r=0.0 ok=true s="unique evens count: 1" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[512] = [0; 512];
	var u_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var exists = false;
			for j in u_count {
				if unique[j] == x { exists = true; break; }
			}
			if !exists {
				unique[u_count] = x;
				u_count++;
			}
		}
	}
	for j in u_count {
		g.res[j] = unique[j];
	}
	g.n = u_count;
	g.steps += g.n;
	out.i = u_count;
	out.s.clear();
	format(out.s, "unique evens count: ", u_count);
	out
}
@end
