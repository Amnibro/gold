code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var letters = 0;
	var res byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		let is_letter = (b >= 65 as byte && b <= 90 as byte) || (b >= 97 as byte && b <= 122 as byte);
		if is_letter {
			if letters < lim {
				letters++;
				if res.len < 200 { res.push(b); }
			}
		} else {
			if res.len < 200 { res.push(b); }
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = letters;
	out
}
@end
