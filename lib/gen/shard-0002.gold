test: list=10,20,20,20,30
expect: => i=3 r=0.0 ok=true s="deduped steps len 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = true;
	var iters = 0;
	while changed && iters < 10 {
		changed = false;
		if g.n > 1 {
			var write_idx = 1;
			for k in 1..g.n {
				if g.res[k] != g.res[write_idx - 1] {
					g.res[write_idx] = g.res[k];
					write_idx++;
				} else {
					changed = true;
				}
			}
			g.n = write_idx;
		}
		iters++;
	}
	g.steps += g.n + iters;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped steps len ", g.n);
	out
}
@end
