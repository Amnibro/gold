noun: evens
modifier: any
context: stats
phrase: split evens any remaining odds separated
phrase: reorder sample splitting evens before any odds
test: list=3,4,1,6,8,5
expect: => i=3 r=0.0 ok=true s="split 3 evens and 3 odds" errors=0 n=6 res=[4,6,8,3,1,5] cache=0 hits=0
test: list=2,7,9,12
expect: => i=2 r=0.0 ok=true s="split 2 evens and 2 odds" errors=0 n=4 res=[2,12,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ec = 0;
	var oc = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[ec] = g.res[k];
			ec++;
		} else {
			odds[oc] = g.res[k];
			oc++;
		}
	}
	for i in ec { g.res[i] = evens[i]; }
	for i in oc { g.res[ec + i] = odds[i]; }
	g.steps += g.n * 2;
	out.i = ec;
	out.s.clear();
	format(out.s, "split ", ec, " evens and ", oc, " odds");
	out
}
@end
