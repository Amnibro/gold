test: list=10,20,30,40 bucket_size=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=4,6,8,12 bucket_size=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bucket_size};
	if bs <= 0 || g.n < 2 {
		return out;
	}
	var pairs = g.n / 2;
	var i = 0;
	while i < pairs {
		g.res[i] = (g.res[i * 2] + g.res[i * 2 + 1]) / bs;
		i++;
	}
	g.n = pairs;
	out.i = pairs;
	g.steps += pairs;
	out
}
@end
