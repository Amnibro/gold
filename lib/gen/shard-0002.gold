code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= mv {
			count++;
		}
		i++;
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
