noun: pairs
modifier: while
context: search
phrase: dedupe consecutive duplicate elements in results
phrase: collapse adjacent identical matches in buffer
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,7,7
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept int[512] = [0; 512];
	var kn = 1;
	kept[0] = g.res[0];
	for i in 1..g.n {
		if g.res[i] != kept[kn - 1] {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	let removed = g.n - kn;
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = removed;
	g.steps += g.n;
	out
}
@end
