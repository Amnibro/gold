@entry 206723209617d558
kind: step
verb: drop
noun: streak
modifier: last
context: aggregate
phrase: drop last streak of identical items
phrase: remove trailing streak of identical elements
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="dropped trailing streak of 3 items" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=4,4,4
expect: => i=3 r=0.0 ok=true s="dropped trailing streak of 3 items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var streak_len = 0;
	var idx = g.n - 1;
	while idx >= 0 && g.res[idx] == last_val {
		streak_len++;
		idx--;
	}
	g.n -= streak_len;
	g.steps += streak_len;
	out.i = streak_len;
	out.s.clear();
	format(out.s, "dropped trailing streak of ", streak_len, " items");
	out
}
@end
