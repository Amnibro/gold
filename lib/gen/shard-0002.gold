@entry 25d36ff355e9485e
kind: step
verb: keep
noun: condition
modifier: with_cache
context: loop
phrase: keep elements satisfying condition {p} with cache
phrase: filter values matching condition {p} using memoized lookups
slot: p pred
test: list=2,4,5,6,7 p=is_even
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=5 hits=0
test: list=1,3,9,11 p=is_prime
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,11] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		var passed = false;
		if ok {
			passed = (cached == 1);
		} else {
			passed = ${p}(x);
			let cval = if passed { 1 } else { 0 };
			gold_cache_put(g, x, cval);
		}
		if passed {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
