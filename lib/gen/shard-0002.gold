fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = lim;
	if bound > g.n { bound = g.n; }
	if bound > 1 {
		let first = g.res[0];
		for k in (bound - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[bound - 1] = first;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "rotated prefix elements up to ", bound);
	out
}
