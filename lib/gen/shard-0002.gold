slot: low int
slot: high int
test: list=5,12,3,20 low=6 high=15
expect: => i=6 r=0.0 ok=true s="clamped minimum to 6" errors=0 n=4 res=[5,12,6,20] cache=0 hits=0
test: list=2,4,1,8 low=5 high=10
expect: => i=5 r=0.0 ok=true s="clamped minimum to 5" errors=0 n=4 res=[2,4,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n > 0 {
		var min_idx = 0;
		for k in 1..g.n {
			if g.res[k] < g.res[min_idx] { min_idx = k; }
		}
		var m = g.res[min_idx];
		if m < lo { m = lo; }
		if m > hi { m = hi; }
		g.res[min_idx] = m;
		out.i = m;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "clamped minimum to ", out.i);
	out
}
@end
@entry 791ff168fddb7271
kind: step
verb: dedupe
noun: streak
modifier: pairwise
context: math
phrase: dedupe adjacent duplicate pairs in streak
phrase: compress pairwise identical values along sequence
test: list=1,1,2,2,2,3,3
expect: => i=3 r=0.0 ok=true s="deduped streak len 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,7,7,8
expect: => i=4 r=0.0 ok=true s="deduped streak len 4" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var write_idx = 1;
		for k in 1..g.n {
			if g.res[k] != g.res[write_idx - 1] {
				g.res[write_idx] = g.res[k];
				write_idx++;
			}
		}
		g.n = write_idx;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped streak len ", g.n);
	out
}
@end
@entry f21e8b64074525a3
kind: step
verb: dedupe
noun: evens
modifier: first
context: math
phrase: dedupe even numbers keeping first occurrence
phrase: remove duplicate even values retaining first
test: list=2,4,2,6,4,8
expect: => i=4 r=0.0 ok=true s="deduped evens count 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,3,10,5,12,12
expect: => i=4 r=0.0 ok=true s="deduped evens count 4" errors=0 n=4 res=[10,3,5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var drop = false;
		if x % 2 == 0 {
			for j in kept {
				if g.res[j] == x { drop = true; break; }
			}
		}
		if !drop {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped evens count ", kept);
	out
}
@end
