code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var off = ${offset};
	if g.n > 0 {
		off = off % g.n;
		if off < 0 { off += g.n; }
		var tmp int[512] = [0; 512];
		for k in g.n {
			tmp[k] = g.res[(k + off) % g.n];
		}
		for k in g.n {
			g.res[k] = tmp[k];
		}
	}
	g.steps += g.n;
	out.i = off;
	out.s.clear();
	format(out.s, "safely rotated loop by ", off);
	out
}
@end
