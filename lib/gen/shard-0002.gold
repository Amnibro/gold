@entry 3303c07a8cc85b5a
kind: step
verb: pair
noun: budget
modifier: any
context: search
phrase: pair budget any search pair summing to {budget}
phrase: locate two elements whose total equals {budget}
slot: budget int
test: list=10,20,30,40 budget=50
expect: => i=1 r=0.0 ok=true s="budget pair found true" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=1,2,3 budget=100
expect: => i=0 r=0.0 ok=false s="budget pair found false" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var found = false;
	var p0 = 0;
	var p1 = 0;
	for i in g.n {
		for j in i {
			if g.res[i] + g.res[j] == b {
				found = true;
				p0 = g.res[j];
				p1 = g.res[i];
				break;
			}
		}
		if found { break; }
	}
	g.steps += g.n;
	if found {
		gold_clear(g);
		gold_push(g, p0);
		gold_push(g, p1);
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "budget pair found ", found);
	out
}
@end
