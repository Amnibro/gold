expect: => i=10 r=0.0 ok=true s="" errors=0 n=4 res=[2,3,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var mid_sum = 0;
	if g.n > 2 {
		for idx in 1..(g.n - 1) {
			mid_sum += g.res[idx];
		}
	}
	out.i = mid_sum;
	g.steps += g.n + 1;
	out
}
@end
