@entry f5dfca530be8fc27
kind: step
verb: run
noun: window
modifier: at_least
context: transform
phrase: run window transform with size at least {min_len}
phrase: process window of size at least {min_len}
slot: min_len int
test: list=1,2,3,4 min_len=2
expect: => i=3 r=0.0 ok=true s="windowed 3 results" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=5,10 min_len=3
expect: => i=0 r=0.0 ok=true s="list shorter than minimum window" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${min_len};
	if g.n < w || w <= 1 {
		out.s.clear();
		format(out.s, "list shorter than minimum window");
		out.i = 0;
		return out;
	}
	let count = g.n - w + 1;
	for i in count {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[i] = sum;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "windowed ", count, " results");
	out
}
@end
@entry 49bb43954781e000
