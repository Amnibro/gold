@entry 634d00d15c9ad46b
kind: step
verb: filter
noun: series
modifier: with_cache
context: filter
phrase: filter series using cache duplicate lookup
phrase: prune series results with cache store
test: list=10,20,30,20,10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=3 hits=2
test: list=5,6,7,8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,6,7,8] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let _, found = gold_cache_get(g, x);
		if !found {
			gold_cache_put(g, x, 1);
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
@entry f4de1dda3055c3a7
kind: step
verb: fold
noun: pairs
modifier: between
context: filter
phrase: fold filtered pairs between bounds {low} {high}
phrase: combine matching pairs between range {low} {high}
slot: low int
slot: high int
test: list=2,5,8,3,6 low=3 high=7
expect: => i=18 r=0.0 ok=true s="pair sum 18" errors=0 n=5 res=[2,5,8,3,6] cache=0 hits=0
test: list=10,20,30 low=5 high=25
expect: => i=200 r=0.0 ok=true s="pair sum 200" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a >= lo && a <= hi && b >= lo && b <= hi {
			sum += a * b;
		}
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "pair sum ", sum);
	out
}
@end
@entry f3d7072ebb1270df
kind: step
verb: search
noun: list
modifier: at_most
context: filter
phrase: search list for value at most {limit}
phrase: locate highest item at most ceiling {limit}
slot: limit int
test: list=15,22,8,30,12 limit=20
expect: => i=15 r=0.0 ok=true s="found 15" errors=0 n=5 res=[15,22,8,30,12] cache=0 hits=0
test: list=50,70,90 limit=40
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[50,70,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${limit};
	var found = false;
	var best = 0;
	for k in g.n {
		let x = g.res[k];
		if x <= ceil {
			if !found || x > best {
				best = x;
				found = true;
			}
		}
	}
	if found {
		out.i = best;
		out.s.clear();
		format(out.s, "found ", best);
	} else {
		out.ok = false;
		gold_fail(g, "no element at most limit");
	}
	g.steps += g.n;
	out
}
@end
