fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return 1;
	}
	let max_allowed = ${limit};
	var max_streak = 1;
	var cur = 1;
	var last = v % 10;
	v = v / 10;
	while v > 0 {
		let d = v % 10;
		if d == last {
			cur = cur + 1;
			if cur > max_streak {
				max_streak = cur;
			}
		} else {
			cur = 1;
			last = d;
		}
		v = v / 10;
	}
	if max_streak > max_allowed {
		return max_allowed;
	}
	max_streak
}
@end
