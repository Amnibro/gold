code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i+1] > g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
		gold_cache_put(g, i, diff);
		i += 2;
	}
	out.i = i / 2;
	g.steps += g.n + 1;
	out
}
@end
