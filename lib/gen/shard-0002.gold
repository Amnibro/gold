test: list=5,8
expect: => i=8 r=0.0 ok=true s="shifted last item to head: 8" errors=0 n=2 res=[8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last_val;
		out.i = last_val;
	} else if g.n == 1 {
		out.i = g.res[0];
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "shifted last item to head: ", out.i);
	out
}
@end
