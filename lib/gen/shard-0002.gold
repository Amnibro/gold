fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var pairs = g.n - 1;
		for k in pairs {
			let diff = g.res[k + 1] - g.res[k];
			g.res[k] = if diff > 0 { 1 } else if diff < 0 { -1 } else { 0 };
		}
		g.n = pairs;
		out.i = pairs;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "pairwise tally count: ", out.i);
	out
}
