@entry 638b99402753cc7c
kind: step
verb: repeat
noun: head
modifier: any
context: core
phrase: repeat head element {times} times
phrase: duplicate leading value {times} times
slot: times int
test: list=42,10,20 times=3
expect: => i=5 r=0.0 ok=true s="repeated head total 5" errors=0 n=5 res=[42,42,42,10,20] cache=0 hits=0
test: list=7,8 times=2
expect: => i=3 r=0.0 ok=true s="repeated head total 3" errors=0 n=3 res=[7,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 || t <= 0 {
		g.steps++;
		return out;
	}
	let head = g.res[0];
	var buf int[512] = [0; 512];
	var total = 0;
	for i in t {
		if total < 512 { buf[total] = head; total++; }
	}
	for k in 1..g.n {
		if total < 512 { buf[total] = g.res[k]; total++; }
	}
	for i in total { g.res[i] = buf[i]; }
	g.n = total;
	g.steps += total;
	out.i = total;
	out.s.clear();
	format(out.s, "repeated head total ", total);
	out
}
@end
