@entry 9d05ed416844f514
kind: step
verb: fold
noun: streak
modifier: in_place
context: filter
phrase: fold streak in place identical sums
phrase: collapse repeated streak in place
test: list=2,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,9,4] cache=0 hits=0
test: list=5,5,10,10
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			sum += g.res[j];
			j++;
		}
		g.res[kept] = sum;
		kept++;
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
