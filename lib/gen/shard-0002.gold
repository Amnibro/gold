@entry a2ad4564cfa905fa
kind: step
verb: select
noun: window
modifier: running
context: transform
phrase: select running sum over window of size {size}
phrase: compute running totals across window size {size}
slot: size int
test: list=1,2,3,4,5 size=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30 size=1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var sums int[512] = [0; 512];
	var sn = 0;
	var i = 0;
	while i + sz <= g.n {
		var s = 0;
		for j in i..i + sz { s += g.res[j]; }
		sums[sn] = s;
		sn++;
		i++;
	}
	gold_clear(g);
	for k in sn { gold_push(g, sums[k]); }
	out.i = sn;
	g.steps += g.n * sz;
	out
}
@end
