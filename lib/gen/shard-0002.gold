code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	gold_clear(g);
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if cur > 0 { gold_push(g, cur * fac); cur = 0; }
		} else {
			cur++;
		}
	}
	if cur > 0 { gold_push(g, cur * fac); }
	out.i = g.n;
	g.steps += out.s.len;
	out
}
@end
