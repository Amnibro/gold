code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_val = ${val};
	var matched int[512] = [0; 512];
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] == target_val {
			matched[count] = target_val;
			count++;
		}
		idx--;
	}
	for i in count {
		g.res[i] = matched[i];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " reverse values");
	out
}
@end
