noun: prefix
modifier: in_reverse
context: transform
phrase: sum prefix of size {count} in reverse order
phrase: calculate prefix sum of size {count} in reverse
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=6 r=0.0 ok=true s="reverse prefix sum is 6" errors=0 n=3 res=[6,5,3] cache=0 hits=0
test: list=10,20 count=2
expect: => i=30 r=0.0 ok=true s="reverse prefix sum is 30" errors=0 n=2 res=[30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let lim = if c < 0 { 0 } else if c > g.n { g.n } else { c };
	var acc = 0;
	for k in lim {
		let idx = lim - 1 - k;
		acc += g.res[idx];
	}
	var cur = acc;
	for k in lim {
		let val = g.res[k];
		g.res[k] = cur;
		cur -= val;
	}
	g.n = lim;
	g.steps += lim;
	out.i = acc;
	out.s.clear();
	format(out.s, "reverse prefix sum is ", acc);
	out
}
@end
