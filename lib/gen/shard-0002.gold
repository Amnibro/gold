fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if rep <= 0 {
		out.s.clear();
		out.i = 0;
		return out;
	}
	var base byte[>..] = [];
	base.append(out.s);
	out.s.clear();
	var count = 0;
	while count < rep && out.s.len + base.len <= 190 {
		out.s.append(base);
		count++;
	}
	g.steps += count;
	out.i = out.s.len;
	out
}
