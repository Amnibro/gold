@entry c624a07215e6cb6f
kind: step
verb: trace
noun: digits
modifier: sorted
context: core
phrase: trace sorted digits of input number
phrase: sort digits of current value tracing sequence
phrase: extract sorted digit sequence into results
test: input=4231
expect: => i=4 r=0.0 ok=true s="traced 4 sorted digits" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: input=905
expect: => i=3 r=0.0 ok=true s="traced 3 sorted digits" errors=0 n=3 res=[0,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if out.i < 0 { -out.i } else { out.i };
	var d_count = 0;
	let start_idx = g.n;
	if x == 0 {
		gold_push(g, 0);
		d_count = 1;
	} else {
		while x > 0 {
			gold_push(g, x % 10);
			x /= 10;
			d_count++;
		}
	}
	for i in d_count {
		for j in 0..d_count - 1 - i {
			let idx1 = start_idx + j;
			let idx2 = idx1 + 1;
			if g.res[idx1] > g.res[idx2] {
				let tmp = g.res[idx1];
				g.res[idx1] = g.res[idx2];
				g.res[idx2] = tmp;
			}
		}
	}
	g.steps += d_count + 1;
	out.i = d_count;
	out.s.clear();
	format(out.s, "traced ", d_count, " sorted digits");
	out
}
@end
