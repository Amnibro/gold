code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kn {
			if kept[j] == x { seen = true; break; }
		}
		if !seen {
			kept[kn] = x;
			kn++;
		}
	}
	let removed = g.n - kn;
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = removed;
	g.steps += g.n;
	out
}
@end
