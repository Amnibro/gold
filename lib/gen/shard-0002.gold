code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_u = 0;
	var count_u = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			sum_u += x;
			count_u++;
		}
	}
	let avg = if count_u > 0 { sum_u / count_u } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "aggregated ", avg);
	out
}
@end
