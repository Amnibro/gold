	let orig = g.n;
	if orig == 0 || orig * 2 > 512 {
		g.steps++;
		return out;
	}
	for k in orig {
		g.res[orig + k] = g.res[k];
	}
	g.n = orig * 2;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "duplicated list size ", g.n);
	out
}
@end
