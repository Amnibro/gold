code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		g.res[i] = x * x;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
