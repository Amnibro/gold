code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let f = ${factor};
	var max_idx = g.n - 1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
		i--;
	}
	g.res[max_idx] *= f;
	out.i = g.res[max_idx];
	g.steps += g.n + 1;
	out
}
@end
