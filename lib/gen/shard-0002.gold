test: list=2,3,2,5,6,6 p=is_even
expect: => i=2 r=0.0 ok=true s="matched 2 of 4 unique" errors=0 n=4 res=[2,3,5,6] cache=0 hits=0
test: list=1,4,9,4,16 p=is_square
expect: => i=4 r=0.0 ok=true s="matched 4 of 4 unique" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_n = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in unique_n {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists {
			g.res[unique_n] = x;
			unique_n++;
		}
	}
	g.n = unique_n;
	var match_count = 0;
	for k in g.n {
		if ${p}(g.res[k]) { match_count++; }
	}
	g.steps += g.n * 2;
	out.i = match_count;
	out.s.clear();
	format(out.s, "matched ", match_count, " of ", g.n, " unique");
	out
}
@end
