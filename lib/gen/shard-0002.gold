code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_err = g.n;
	for i in g.n {
		if g.res[i] < 0 { first_err = i; break; }
	}
	var i = 0;
	var j = first_err - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = first_err;
	g.steps += g.n + 1;
	out
}
@end
