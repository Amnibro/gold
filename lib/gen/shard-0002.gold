fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let head = g.res[0];
	var greater = 0;
	for k in g.n {
		if k > 0 && g.res[k] > head {
			greater++;
		}
	}
	g.steps += g.n;
	out.i = greater;
	out.s.clear();
	format(out.s, "greater than head: ", greater);
	out
}
