@entry d3fa92fa6e388d78
kind: step
verb: fold
noun: gaps
modifier: at_least
context: search
phrase: sum gaps between matches at least {min_gap}
phrase: accumulate distance intervals exceeding {min_gap}
slot: min_gap int
test: list=2,10,12,25 min_gap=5
expect: => i=21 r=0.0 ok=true s="" errors=0 n=4 res=[2,10,12,25] cache=0 hits=0
test: list=1,3,4 min_gap=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_gap};
	var total = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if gap >= limit {
			total += gap;
		}
		i++;
	}
	out.i = total;
	g.steps += g.n;
	out
}
@end
@entry 35d8f52e5bdaabd4
kind: step
verb: reverse
noun: squares
modifier: with_retry
context: transform
phrase: reverse square elements with retry limit {limit}
phrase: invert square numbers in results up to limit {limit}
slot: limit int
test: list=4,9,16,25 limit=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[16,9,4,25] cache=0 hits=0
test: list=1,4,9 limit=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[4,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sq_idx int[512] = [0; 512];
	var sn = 0;
	for i in g.n {
		if sn < lim && core_is_square(g.res[i]) {
			sq_idx[sn] = i;
			sn++;
		}
	}
	var i = 0;
	var j = sn - 1;
	while i < j {
		let idx1 = sq_idx[i];
		let idx2 = sq_idx[j];
		let t = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = t;
		i++;
		j--;
	}
	out.i = sn;
	g.steps += g.n;
	out
}
@end
