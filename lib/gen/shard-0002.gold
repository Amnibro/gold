code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var count = g.n;
		while count > 1 {
			for i in count / 2 {
				g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
			}
			count = count / 2;
		}
		g.n = count;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "condensed to ", out.i);
	out
}
@end
