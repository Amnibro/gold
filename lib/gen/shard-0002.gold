code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var modified = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if core_is_square(x) && x > ceiling {
			g.res[i] = ceiling;
			modified++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = modified;
	out
}
@end
