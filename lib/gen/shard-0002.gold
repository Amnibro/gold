expect: => i=4 r=0.0 ok=true s="rotated series len 4" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n > 1 && sh > 0 {
		let eff = sh % g.n;
		for step in eff {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated series len ", g.n);
	out
}
@end
@entry 7f3614c3a7cd4536
kind: step
verb: rotate
noun: primes
modifier: while
context: math
phrase: rotate leading prime numbers while present
phrase: cycle prime elements while at sequence start
test: list=2,3,5,8,9
expect: => i=3 r=0.0 ok=true s="rotated primes 3" errors=0 n=5 res=[8,9,2,3,5] cache=0 hits=0
test: list=7,11,4,13
expect: => i=2 r=0.0 ok=true s="rotated primes 2" errors=0 n=4 res=[4,13,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rotated = 0;
	while g.n > 1 && rotated < g.n {
		let x = g.res[0];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if !is_p { break; }
		for k in 0..(g.n - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[g.n - 1] = x;
		rotated++;
	}
	g.steps += g.n;
	out.i = rotated;
	out.s.clear();
	format(out.s, "rotated primes ", rotated);
	out
}
@end
