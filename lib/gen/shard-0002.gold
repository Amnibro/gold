noun: text
modifier: nested
context: core
phrase: validate nested balance in results
phrase: check balanced nesting depth in list
test: list=40,41,40,41
expect: => i=1 r=0.0 ok=true s="nested structure valid" errors=0 n=4 res=[40,41,40,41] cache=0 hits=0
test: list=40,40,41
expect: => i=1 r=0.0 ok=false s="" errors=1 n=3 res=[40,40,41] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var balanced = true;
	for k in g.n {
		let c = g.res[k];
		if c == 40 { depth++; }
		else if c == 41 {
			depth--;
			if depth < 0 { balanced = false; break; }
		}
	}
	if depth != 0 { balanced = false; }
	if !balanced {
		gold_fail(g, "unbalanced nesting");
		out.ok = false;
		out.i = depth;
		return out;
	}
	g.steps += g.n;
	out.i = 1;
	out.s.clear();
	format(out.s, "nested structure valid");
	out
}
@end
