fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_gaps int[..200] = [];
	if out.s.len >= 2 {
		for i in (out.s.len - 1) {
			let diff = (out.s[i + 1] as int) - (out.s[i] as int);
			let gap = if diff >= 0 { diff } else { -diff };
			var seen = false;
			for j in unique_gaps.len {
				if unique_gaps[j] == gap { seen = true; break; }
			}
			if !seen && unique_gaps.len < 200 { unique_gaps.push(gap); }
		}
	}
	g.steps += out.s.len + 1;
	out.i = unique_gaps.len;
	out
}
