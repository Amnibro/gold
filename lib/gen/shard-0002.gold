phrase: clamp histogram recursively capping repeated character frequencies to {max_freq}
phrase: limit consecutive duplicate character occurrences to {max_freq}
slot: max_freq int
test: text="aaaaabbb" max_freq=2
expect: => i=4 r=0.0 ok=true s="aabb" errors=0 n=0 res=[] cache=0 hits=0
test: text="helloooo" max_freq=1
expect: => i=4 r=0.0 ok=true s="helo" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_freq};
	var res byte[..200] = "";
	var run_len = 0;
	var prev_c: byte = 0;
	for k in out.s.len {
		let c = out.s[k];
		if k > 0 && c == prev_c {
			run_len += 1;
		} else {
			prev_c = c;
			run_len = 1;
		}
		if run_len <= cap {
			if res.len < 200 { res.push(c); }
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
