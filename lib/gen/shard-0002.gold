fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] >= lo && g.res[j] <= hi && g.res[j + 1] >= lo && g.res[j + 1] <= hi {
					if g.res[j] > g.res[j + 1] {
						let tmp = g.res[j];
						g.res[j] = g.res[j + 1];
						g.res[j + 1] = tmp;
					}
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted range count ", g.n);
	out
}
@end
