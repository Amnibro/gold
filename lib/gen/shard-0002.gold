code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var gap_cnt = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d >= th { gap_cnt++; }
		}
	}
	g.steps += g.n;
	out.i = gap_cnt;
	out.s.clear();
	format(out.s, "found ", gap_cnt, " pairwise gaps");
	out
}
@end
