expect: => i=0 r=0.0 ok=true s="kept 0 odd values" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	var orig int[512] = [0; 512];
	for i in g.n { orig[i] = g.res[i]; }
	let total = g.n;
	gold_clear(g);
	for i in total {
		if g.n >= lim { break; }
		if orig[i] % 2 != 0 { gold_push(g, orig[i]); }
	}
	g.steps += total;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " odd values");
	out
}
@end
