fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var total_gap = 0;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = 0 - diff; }
		total_gap += diff;
	}
	g.steps += g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "aggregated ", total_gap);
	out
}
@end
