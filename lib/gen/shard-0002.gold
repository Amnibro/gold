code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let val = g.res[0];
	var j = 1;
	while j < g.n && g.res[j] < val {
		g.res[j - 1] = g.res[j];
		j++;
	}
	g.res[j - 1] = val;
	out.i = j - 1;
	g.steps += g.n + 1;
	out
}
@end
