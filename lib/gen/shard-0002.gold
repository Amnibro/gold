@entry 3c8f3cb2b0f84ad8
kind: step
verb: merge
noun: threshold
modifier: with_cache
context: core
phrase: merge threshold with cache lookup {threshold}
phrase: combine threshold values using cache {threshold}
slot: threshold int
test: list=3,8,4,9 threshold=5
expect: => i=2 r=0.0 ok=true s="merged 2 items" errors=0 n=4 res=[3,16,4,18] cache=2 hits=0
test: list=12,2,15 threshold=10
expect: => i=2 r=0.0 ok=true s="merged 2 items" errors=0 n=3 res=[24,2,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var modified = 0;
	for k in g.n {
		let x = g.res[k];
		if x > thresh {
			let cached, found = gold_cache_get(g, x);
			if found {
				g.res[k] = cached;
			} else {
				let computed = x * 2;
				gold_cache_put(g, x, computed);
				g.res[k] = computed;
			}
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "merged ", modified, " items");
	out
}
@end
