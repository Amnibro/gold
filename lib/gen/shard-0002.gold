	var low_bucket = 0;
	var high_bucket = 0;
	for k in 0..g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= 5 {
			low_bucket++;
		} else {
			high_bucket++;
		}
	}
	g.steps += low_bucket + high_bucket + 1;
	out.i = low_bucket;
