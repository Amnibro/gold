expect: => i=20 r=0.0 ok=true s="normalized mean: 20" errors=0 n=3 res=[-20,0,20] cache=0 hits=0
test: list=4,8,12 scale=3
expect: => i=8 r=0.0 ok=true s="normalized mean: 8" errors=0 n=3 res=[-12,0,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	if g.n > 0 {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		let mean = sum / g.n;
		for k in g.n {
			g.res[k] = (g.res[k] - mean) * s;
		}
		out.i = mean;
	}
	g.steps += g.n * 2;
	out.s.clear();
	format(out.s, "normalized mean: ", out.i);
	out
}
@end
