verb: select
noun: primes
modifier: with_retry
context: transform
phrase: select prime numbers with retry limit {limit}
phrase: filter prime elements from results bounded by {limit}
slot: limit int
test: list=2,3,4,5,6,7,8 limit=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=11,12,13,14 limit=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var primes int[512] = [0; 512];
	var pn = 0;
	for i in g.n {
		if pn < lim && core_is_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		}
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	out.i = pn;
	g.steps += g.n;
	out
}
@end
@entry 9ad1a6e3d5ef0f39
kind: step
verb: validate
noun: item
modifier: sorted
context: search
phrase: validate whether search items are sorted ascending
phrase: verify match list is in nondecreasing order
test: list=1,3,5,7
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
test: list=5,2,8
expect: => i=1 r=0.0 ok=false s="" errors=0 n=3 res=[5,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var inversions = 0;
	for k in g.n {
		if k > 0 && g.res[k] < g.res[k - 1] {
			is_sorted = false;
			inversions++;
		}
	}
	out.ok = is_sorted;
	out.i = inversions;
	g.steps += g.n;
	out
}
@end
@entry 3fbddee9104a064d
kind: step
verb: swap
noun: errors
modifier: first
context: transform
phrase: swap first adjacent inverted pair in sequence
phrase: correct first inversion error by swapping neighbors
test: list=1,4,3,2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,4,2] cache=0 hits=0
test: list=5,2,3,4
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[2,5,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i]; g.res[i] = g.res[i + 1]; g.res[i + 1] = t;
			found = true;
			break;
		}
		i++;
	}
	out.ok = found;
	out.i = if found { i } else { 0 };
	g.steps += g.n;
	out
}
@end
