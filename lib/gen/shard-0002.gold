expect: => i=1 r=0.0 ok=true s="large gaps count 1" errors=0 n=4 res=[10,12,30,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gt = ${gap_threshold};
	var large_gaps = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let gap = if diff < 0 { -diff } else { diff };
			if gap > gt { large_gaps++; }
		}
	}
	g.steps += g.n;
	out.i = large_gaps;
	out.s.clear();
	format(out.s, "large gaps count ", large_gaps);
	out
}
@end
