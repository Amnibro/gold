fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var drop_count = 0;
	while drop_count < g.n && ${cond}(g.res[drop_count]) {
		drop_count++;
	}
	if drop_count > 0 {
		for k in 0..g.n - drop_count {
			g.res[k] = g.res[k + drop_count];
		}
		g.n -= drop_count;
	}
	g.steps += drop_count + 1;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " matching items");
	out
}
@end
