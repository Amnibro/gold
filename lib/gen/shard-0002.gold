fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_byte};
	let hi = ${max_byte};
	var valid = true;
	for i in out.s.len {
		let b = out.s[i] as int;
		if b < lo || b > hi {
			valid = false;
			gold_fail(g, "character out of bounds");
			break;
		}
	}
	g.steps += out.s.len + 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out
}
