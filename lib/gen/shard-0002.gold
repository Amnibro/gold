@entry 573058f5d79bd2ae
kind: step
verb: measure
noun: subfunction
modifier: until
context: search
phrase: measure subfunction until target match located
phrase: count comparisons until search target found
test: list=10,20,30,40 input=30
expect: => i=3 r=0.0 ok=true s="searched 3 steps" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,2,3 input=99
expect: => i=3 r=0.0 ok=false s="searched 3 steps" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = out.i;
	var found = false;
	var steps = 0;
	for i in g.n {
		steps++;
		if g.res[i] == tgt {
			found = true;
			break;
		}
	}
	g.steps += steps;
	out.ok = found;
	out.i = steps;
	out.s.clear();
	format(out.s, "searched ", steps, " steps");
	out
}
@end
