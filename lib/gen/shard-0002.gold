fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${count};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && swaps < max_swaps {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i++;
	}
	out.i = swaps;
	g.steps += swaps + 1;
	out
}
