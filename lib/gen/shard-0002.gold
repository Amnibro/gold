fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	for i in g.n {
		if g.res[i] > 0 { g.res[i]--; }
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
