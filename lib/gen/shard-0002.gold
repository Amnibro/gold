code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let n = out.s.len;
	var found = false;
	if n >= sp && sp > 0 {
		for i in 0..(n - sp + 1) {
			var is_sorted = true;
			for j in 0..(sp - 1) {
				if out.s[i + j] > out.s[i + j + 1] {
					is_sorted = false;
					break;
				}
			}
			if is_sorted {
				found = true;
				break;
			}
		}
	}
	g.steps += n;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out
}
@end
