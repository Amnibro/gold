code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tally};
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > mt {
			clamped++;
			gold_cache_put(g, x, mt);
		} else {
			gold_cache_put(g, x, freq);
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped tallies count ", clamped);
	out
}
@end
