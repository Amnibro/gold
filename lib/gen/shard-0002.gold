verb: filter
noun: average
modifier: until
context: format
phrase: clamp deviation from baseline {target} to {max_dev}
phrase: limit difference from target {target} to max deviation {max_dev}
slot: target int
slot: max_dev int
test: arg=15,30 target=20 max_dev=5
expect: 15
expect: 25
test: arg=8 target=20 max_dev=5
expect: 15
code:
fn ${ID}(n int) int {
	let tgt = ${target};
	let max_d = ${max_dev};
	let diff = n - tgt;
	if diff > max_d { tgt + max_d }
	else if diff < -max_d { tgt - max_d }
	else { n }
}
@end
@entry 236262d1850d358d
kind: fn
verb: search
noun: window
modifier: between
context: format
phrase: pad window size between limits {low} {high}
phrase: fit display window between limits {low} {high}
slot: low int
slot: high int
test: arg=14,4 low=8 high=16
expect: 14
expect: 12
test: arg=30 low=8 high=16
expect: 14
code:
fn ${ID}(n int) int {
	let lo = ${low};
	let hi = ${high};
	let span = hi - lo;
	if span <= 0 { return lo; }
	lo + ((n - lo) % span)
}
@end
@entry 4ae031b6f3438cca
kind: fn
verb: dedupe
noun: window
modifier: times
context: format
phrase: round to format tab stop {tab_size}
phrase: align column width to tab size {tab_size}
slot: tab_size int
test: arg=7,16 tab_size=8
expect: 8
expect: 16
test: arg=25 tab_size=10
expect: 30
code:
fn ${ID}(n int) int {
	let t = ${tab_size};
	if t <= 0 { return n; }
	let rem = n % t;
	if rem == 0 { n } else { n + (t - rem) }
}
@end
