fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stored = 0;
	if out.s.len >= 2 {
		for i in (out.s.len - 1) {
			let pair_val = (out.s[i] as int) * 256 + (out.s[i + 1] as int);
			gold_cache_put(g, i, pair_val);
			stored++;
		}
	}
	g.steps += stored + 1;
	out.i = stored;
	out
}
