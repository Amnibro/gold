fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if d == 0 {
		gold_fail(g, "zero divisor");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[k] /= d;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "normalized ", count, " even numbers");
