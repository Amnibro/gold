fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	var steps_recorded = 0;
	if g.n > 1 {
		var limit = g.n - 1;
		if cnt < limit { limit = cnt; }
		for k in 0..limit {
			let diff = g.res[k + 1] - g.res[k];
			gold_cache_put(g, k, diff);
			steps_recorded++;
		}
	}
	g.steps += g.n;
	out.i = steps_recorded;
	out.s.clear();
	format(out.s, "recorded steps count ", steps_recorded);
	out
}
@end
