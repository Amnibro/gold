	var err_fixes = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			err_fixes++;
		}
		i++;
	}
	g.steps += err_fixes + 1;
	out.i = err_fixes;
	out.ok = err_fixes == 0;
	out
}
@end
@entry 92526e02bb2c228e
kind: step
verb: scale
noun: average
modifier: recursively
context: error
phrase: scale errors exceeding average magnitude by {factor}
phrase: amplify above average errors with factor {factor}
slot: factor int
test: list=2,10,2 factor=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[2,30,2] cache=0 hits=0
test: list=5,5,5 factor=2
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let f = ${factor};
	var sum = 0;
	for i in g.n { sum += core_abs_val(g.res[i]); }
	let avg = sum / g.n;
	var scaled = 0;
	for i in g.n {
		if core_abs_val(g.res[i]) > avg {
			g.res[i] *= f;
			scaled++;
		}
	}
	out.i = scaled;
	g.steps += g.n * 2 + 1;
	out
}
@end
