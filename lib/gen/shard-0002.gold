kind: step
verb: reverse
noun: subfunction
modifier: at_most
context: core
phrase: reverse subfunction {f} across at most {limit} items
phrase: apply subfunction {f} backward on at most {limit} elements
phrase: run subfunction {f} in reverse at most {limit} times
slot: f fn
slot: limit int
test: list=1,2,3,4 f=double limit=2
expect: => i=2 r=0.0 ok=true s="reversed 2 items" errors=0 n=4 res=[1,2,6,8] cache=0 hits=0
test: list=10,20 f=inc limit=-1
expect: => i=0 r=0.0 ok=false s="limit error" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		out.s.clear();
		out.s.append("limit error");
		return out;
	}
	let count = min(g.n, lim);
	var k = 0;
	while k < count {
		let idx = g.n - 1 - k;
		g.res[idx] = ${f}(g.res[idx]);
		k++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " items");
	out
}
@end
