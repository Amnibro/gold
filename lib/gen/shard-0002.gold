expect: => i=2 r=0.0 ok=true s="kept 2 items" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x > min_val && x < max_val {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
@entry f1107a5dd1368f12
kind: step
verb: sum
noun: number
modifier: in_place
context: filter
phrase: sum number in_place digits {limit}
phrase: digit sum number in_place {limit}
slot: limit int
test: list=12,39,45,7 limit=10
expect: => i=1 r=0.0 ok=true s="kept 1 items" errors=0 n=1 res=[39] cache=0 hits=0
test: list=55,88,14 limit=10
expect: => i=2 r=0.0 ok=true s="kept 2 items" errors=0 n=2 res=[55,88] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = 0 - x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s >= lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
