code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let first = g.res[0];
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " items");
	out
}
@end
