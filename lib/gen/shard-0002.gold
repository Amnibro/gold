code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ranks int[>..] = [];
	for i in g.n {
		var r = 0;
		for j in 0..i {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks.push(r);
	}
	for i in g.n { g.res[i] = ranks[i]; }
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
