code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	fn is_p(x int) bool {
		if x < 2 { return false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { return false; }
			d++;
		}
		true
	}
	var orig int[512] = [0; 512];
	for i in g.n { orig[i] = g.res[i]; }
	let total = g.n;
	gold_clear(g);
	for i in total {
		if is_p(orig[i]) { gold_push(g, orig[i]); }
	}
	g.steps += total;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retained ", g.n, " primes");
	out
}
@end
