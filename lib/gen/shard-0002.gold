		return v;
	}
	var changed = true;
	while changed {
		var rev = 0;
		var temp = v;
		while temp > 0 {
			rev = rev * 10 + (temp % 10);
			temp = temp / 10;
		}
		var next_v = 0;
		var last = -1;
		while rev > 0 {
			let d = rev % 10;
			if d != last {
				next_v = next_v * 10 + d;
				last = d;
			}
			rev = rev / 10;
		}
		if next_v == v {
			changed = false;
		} else {
			v = next_v;
		}
	}
	v
}
@end
