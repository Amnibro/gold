fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let v = g.res[i];
		var exists = false;
		for j in distinct {
			if g.res[j] == v { exists = true; break; }
		}
		if !exists {
			g.res[distinct] = v;
			distinct++;
		}
	}
	g.n = distinct;
	out.i = distinct;
	g.steps += g.n + 1;
	out
}
@end
