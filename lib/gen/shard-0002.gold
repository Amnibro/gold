@entry 221bf86fb4e8e707
kind: step
verb: sort
noun: step
modifier: every_other
context: filter
phrase: sort step entries at every other position
phrase: order alternating step results every other index
test: list=9,1,5,2,1,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,5,2,9,3] cache=0 hits=0
test: list=8,0,4,0,2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,0,4,0,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = (g.n + 1) / 2;
	var i = 0;
	while i < count {
		var j = 0;
		while j < count - 1 - i {
			let idx1 = j * 2;
			let idx2 = (j + 1) * 2;
			if g.res[idx1] > g.res[idx2] {
				let tmp = g.res[idx1];
				g.res[idx1] = g.res[idx2];
				g.res[idx2] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out
}
@end
@entry 684ebd446795456d
kind: step
