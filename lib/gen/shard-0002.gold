test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[30,20,10] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var mid = n / 2;
	for i in mid {
		let t = g.res[i];
		g.res[i] = g.res[n - 1 - i];
		g.res[n - 1 - i] = t;
	}
	for i in n {
		gold_cache_put(g, i, g.res[i]);
	}
	out.i = n;
	g.steps += n + 1;
	out
}
@end
