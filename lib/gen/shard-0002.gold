@entry 67758a09f1b7dbf4
kind: step
verb: check
noun: histogram
modifier: with_retry
context: sort
phrase: check histogram with retry finding maximum frequency
phrase: measure peak frequency mode in sorted list
test: list=2,2,2,5,8,8
expect: => i=3 r=0.0 ok=true s="peak sorted frequency: 3" errors=0 n=6 res=[2,2,2,5,8,8] cache=0 hits=0
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="peak sorted frequency: 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_freq = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let count = j - i;
		if count > max_freq { max_freq = count; }
		i = j;
	}
	g.steps += g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "peak sorted frequency: ", max_freq);
	out
}
@end
