expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	g.steps += g.n + 1;
	out
}
@end
@entry 9d95148c4208bf1e
kind: step
verb: limit
noun: runs
modifier: in_place
context: compare
phrase: limit comparison run lengths in place to {max_run}
phrase: cap consecutive equal run sequences in place at {max_run}
slot: max_run int
test: list=1,1,1,2,2,3 max_run=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 max_run=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${max_run};
	if g.n == 0 {
		g.steps++;
		return out;
	}
	var kept = 0;
	var cur_run = 0;
	var prev = g.res[0] - 1;
	for i in g.n {
		if g.res[i] == prev {
			cur_run++;
		} else {
			prev = g.res[i];
			cur_run = 1;
		}
		if cur_run <= max_r {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
