@entry 8cdb89a2077b7436
kind: step
verb: keep
noun: primes
modifier: in_place
context: cache
phrase: keep only prime items in place caching dropped
phrase: retain prime elements filtering composites into cache
test: list=4,5,6,7,8,9
expect: => i=4 r=0.0 ok=true s="" errors=0 n=2 res=[5,7] cache=1 hits=0
test: list=11,13,17
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[11,13,17] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	let dropped = g.n - write_idx;
	g.n = write_idx;
	gold_cache_put(g, 0, dropped);
	out.i = dropped;
	g.steps += g.n + 1;
	out
}
@end
