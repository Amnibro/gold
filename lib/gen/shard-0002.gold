@entry 876bdb93668b7105
kind: step
verb: reverse
noun: threshold
modifier: last
context: sort
phrase: reverse suffix exceeding threshold {cut} to end
phrase: invert trailing elements past threshold {cut}
slot: cut int
test: list=2,4,6,8,10 cut=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,10,8,6] cache=0 hits=0
test: list=1,3,5,7 cut=9
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cut};
	var start = g.n;
	for i in g.n {
		if g.res[i] >= c { start = i; break; }
	}
	var i = start;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = if start < g.n { g.n - start } else { 0 };
	g.steps += g.n + 1;
	out
}
@end
