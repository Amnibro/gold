phrase: reverse threshold nested values exceeding {min_val}
phrase: invert order of elements meeting threshold {min_val}
slot: min_val int
test: list=10,50,20,60,30 min_val=40
expect: => i=2 r=0.0 ok=true s="reversed 2 elements meeting threshold" errors=0 n=5 res=[10,60,20,50,30] cache=0 hits=0
test: list=5,15,25 min_val=30
expect: => i=0 r=0.0 ok=true s="reversed 0 elements meeting threshold" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var ge int[512] = [0; 512];
	var gc = 0;
	for k in g.n {
		if g.res[k] >= mv {
			ge[gc] = g.res[k];
			gc++;
		}
	}
	var rev = gc - 1;
	for k in g.n {
		if g.res[k] >= mv {
			g.res[k] = ge[rev];
			rev--;
		}
	}
	g.steps += g.n * 2;
	out.i = gc;
	out.s.clear();
	format(out.s, "reversed ", gc, " elements meeting threshold");
	out
}
@end
