fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_v = g.res[0];
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x > max_v { max_v = x; }
		total += x;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "aggregated ", total);
	out
}
@end
