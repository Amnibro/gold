code:
fn ${ID}(n int) int {
	var v = n;
	if v == 0 {
		return 1;
	}
	if v < 0 {
		v = 0 - v;
	}
	var distinct = 0;
	var d = 0;
	while d <= 9 {
		var temp = v;
		var found = false;
		while temp > 0 {
			if temp % 10 == d {
				found = true;
			}
			temp = temp / 10;
		}
		if found {
			distinct = distinct + 1;
		}
		d = d + 1;
	}
	distinct
}
@end
