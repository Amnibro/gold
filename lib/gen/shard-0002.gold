fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for k in g.n { g.res[k] -= avg; }
	g.steps += g.n;
