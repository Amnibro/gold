modifier: recursively
context: format
phrase: normalize gaps recursively across elements
phrase: standardize spacing recursively in sequence
test: list=2,6,14
expect: => i=6 r=0.0 ok=true s="average gap size:6" errors=0 n=3 res=[2,6,14] cache=0 hits=0
test: list=10,30,70
expect: => i=30 r=0.0 ok=true s="average gap size:30" errors=0 n=3 res=[10,30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n <= 1 {
		format(out.s, "insufficient items for gaps");
		out.i = 0;
		return out;
	}
	var total_gap = 0;
	for k in 0..(g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		total_gap += diff;
	}
	let avg_gap = total_gap / (g.n - 1);
	format(out.s, "average gap size:", avg_gap);
	out.i = avg_gap;
	g.steps += g.n;
	out
}
@end
