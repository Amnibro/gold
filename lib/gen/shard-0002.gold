code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var kept = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ascending steps ", kept);
	out
}
@end
@entry b78f06e360477457
kind: step
verb: rotate
noun: histogram
modifier: while
context: core
phrase: rotate histogram while head below {cutoff}
phrase: cycle list while leading value under {cutoff}
slot: cutoff int
test: list=2,4,10,12 cutoff=8
expect: => i=2 r=0.0 ok=true s="rotated histogram steps 2" errors=0 n=4 res=[10,12,2,4] cache=0 hits=0
test: list=15,20,5 cutoff=10
expect: => i=0 r=0.0 ok=true s="rotated histogram steps 0" errors=0 n=3 res=[15,20,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var count = 0;
	while g.n > 1 && g.res[0] < cut && count < g.n {
		let first = g.res[0];
		for k in 0..(g.n - 1) { g.res[k] = g.res[k + 1]; }
		g.res[g.n - 1] = first;
		count++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated histogram steps ", count);
	out
}
@end
