expect: => i=3 r=0.0 ok=true s="cached sorted errors 3" errors=0 n=4 res=[-5,-2,-8,3] cache=3 hits=0
test: list=-12,-4,-15,10
expect: => i=3 r=0.0 ok=true s="cached sorted errors 3" errors=0 n=4 res=[-12,-4,-15,10] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errs int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] < 0 {
			errs[count] = g.res[i];
			count++;
		}
	}
	if count > 1 {
		for i in count {
			for j in (i + 1)..count {
				if errs[i] > errs[j] {
					let tmp = errs[i];
					errs[i] = errs[j];
					errs[j] = tmp;
				}
			}
		}
	}
	for i in count {
		gold_cache_put(g, i, errs[i]);
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "cached sorted errors ", count);
	out
}
@end
