kind: step
verb: reverse
noun: range
modifier: in_place
context: loop
phrase: reverse subrange from {start} to {stop} in place
phrase: invert elements between indices {start} to {stop} in place
slot: start int
slot: stop int
test: list=1,2,3,4,5 start=1 stop=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30,40,50 start=0 stop=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = ${start};
	var j = ${stop};
	if i < 0 { i = 0; }
	if j >= g.n { j = g.n - 1; }
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
