@entry 923dcd5325240a1e
kind: step
verb: keep
noun: runs
modifier: recursively
context: stats
phrase: keep runs recursively in sample sequence
phrase: record lengths of monotonic runs recursively
test: list=1,2,3,2,3,4,5
expect: => i=2 r=0.0 ok=true s="recorded 2 monotonic runs" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,5,15,25
expect: => i=2 r=0.0 ok=true s="recorded 2 monotonic runs" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var runs_count = 0;
	var cur_run = 1;
	for k in 0..(g.n - 1) {
		if g.res[k + 1] >= g.res[k] {
			cur_run++;
		} else {
			g.res[runs_count] = cur_run;
			runs_count++;
			cur_run = 1;
		}
	}
	g.res[runs_count] = cur_run;
	runs_count++;
	g.n = runs_count;
	g.steps += g.n + 1;
	out.i = runs_count;
	out.s.clear();
	format(out.s, "recorded ", runs_count, " monotonic runs");
	out
}
@end
