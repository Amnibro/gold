code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mn = g.res[0];
	for k in 1..g.n {
		if g.res[k] < mn { mn = g.res[k]; }
	}
	var kept = 0;
	var seen_min = false;
	for k in g.n {
		if g.res[k] == mn {
			if !seen_min {
				g.res[kept] = g.res[k];
				kept++;
				seen_min = true;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
