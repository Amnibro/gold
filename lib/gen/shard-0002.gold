code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sub = ${reps};
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			g.res[i] = if diff > sub { diff - sub } else { 0 };
		}
		g.n--;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
