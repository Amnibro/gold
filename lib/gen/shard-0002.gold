@entry efae5d584f11334e
kind: step
verb: reverse
noun: suffix
modifier: in_place
context: loop
phrase: reverse suffix of length {k} in place
phrase: invert trailing suffix of size {k} in loop
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k > 1 && k <= g.n {
		var i = g.n - k;
		var j = g.n - 1;
		while i < j {
			let t = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = t;
			i++;
			j--;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
