@entry 61776d9cefdf4196
kind: step
verb: drop
noun: budget
modifier: unique
context: filter
phrase: drop budget unique excess
phrase: prune budget unique elements
slot: budget int
test: list=10,20,10,30,5 budget=25
expect: => i=3 r=0.0 ok=true s="kept 3 items" errors=0 n=3 res=[10,20,5] cache=0 hits=0
test: list=50,15,50,12 budget=40
expect: => i=2 r=0.0 ok=true s="kept 2 items" errors=0 n=2 res=[15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= max_b {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items");
	out
}
@end
