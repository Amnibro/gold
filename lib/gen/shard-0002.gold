@entry 42dae6f7ba3482a4
kind: step
verb: select
noun: runs
modifier: any
context: search
phrase: select runs any matching sequence minimum run {min_run}
phrase: filter search elements keeping clusters of size {min_run}
slot: min_run int
test: list=1,1,2,3,3,3 min_run=2
expect: => i=5 r=0.0 ok=true s="selected 5 qualifying runs" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=4,5,6 min_run=2
expect: => i=0 r=0.0 ok=true s="selected 0 qualifying runs" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var matched = 0;
	var i = 0;
	var tmp int[512] = [0; 512];
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= mr {
			var k = i;
			while k < j {
				tmp[matched] = g.res[k];
				matched++;
				k++;
			}
		}
		i = j;
	}
	for k in matched { g.res[k] = tmp[k]; }
	g.n = matched;
	g.steps += g.n + 1;
	out.i = matched;
	out.s.clear();
	format(out.s, "selected ", matched, " qualifying runs");
	out
}
@end
