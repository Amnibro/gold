code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var streak_len = 0;
	while streak_len < g.n && streak_len < lim && g.res[streak_len] > 0 {
		streak_len++;
	}
	var i = 0;
	var j = streak_len - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += streak_len + 1;
	out.i = streak_len;
	out.s.clear();
	format(out.s, "reversed streak of ", streak_len);
	out
}
@end
