phrase: prune values exceeding cache threshold {threshold}
slot: threshold int
test: list=10,50,20,60 threshold=30
expect: => i=20 r=0.0 ok=true s="max kept: 20" errors=0 n=2 res=[10,20] cache=1 hits=0
test: list=5,15,25 threshold=20
expect: => i=15 r=0.0 ok=true s="max kept: 15" errors=0 n=2 res=[5,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var kept = 0;
	var max_val = 0;
	for k in g.n {
		let x = g.res[k];
		if x <= thresh {
			g.res[kept] = x;
			kept++;
			if x > max_val { max_val = x; }
		}
	}
	g.n = kept;
	gold_cache_put(g, thresh, max_val);
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "max kept: ", max_val);
	out
}
@end
