expect: => i=3 r=0.0 ok=true s="ban" errors=0 n=0 res=[] cache=0 hits=0
test: text="letter"
expect: => i=4 r=0.0 ok=true s="letr" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in uniq.len {
			if uniq[j] == c { seen = true; break; }
		}
		if !seen {
			if uniq.len < 200 { uniq.push(c); }
		}
	}
	out.s.clear();
	for b in uniq { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
