@entry dacfd33ff46394fb
kind: step
verb: fold
noun: duplicates
modifier: in_reverse
context: math
phrase: fold consecutive duplicates backwards in reverse
phrase: combine repeated numbers in reverse direction
test: list=2,2,3,4,4,4
expect: => i=4 r=0.0 ok=true s="folded duplicates len 4" errors=0 n=4 res=[4,3,4,8] cache=0 hits=0
test: list=5,5,5,10,10
expect: => i=3 r=0.0 ok=true s="folded duplicates len 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var write_idx = g.n - 1;
		var read_idx = g.n - 2;
		while read_idx >= 0 {
			if g.res[read_idx] == g.res[write_idx] {
				g.res[write_idx] += g.res[read_idx];
			} else {
				write_idx--;
				g.res[write_idx] = g.res[read_idx];
			}
			read_idx--;
		}
		let new_len = g.n - write_idx;
		for k in new_len {
			g.res[k] = g.res[write_idx + k];
		}
		g.n = new_len;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "folded duplicates len ", g.n);
	out
}
@end
