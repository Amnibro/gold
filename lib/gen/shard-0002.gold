fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let csz = ${chunk};
	gold_clear(g);
	if csz <= 0 { return out; }
	var num_chunks = 0;
	var i = 0;
	while i < out.s.len {
		gold_push(g, out.s[i] as int);
		gold_cache_put(g, num_chunks, i);
		num_chunks++;
		i += csz;
	}
	out.i = num_chunks;
	g.steps += num_chunks + 1;
	out
}
@end
