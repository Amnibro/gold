fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	while kept < g.n && !${stop_check}(g.res[kept]) {
		kept++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += kept + 1;
	out
}
