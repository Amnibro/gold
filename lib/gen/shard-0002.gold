@entry a4bd2c1d8dec9f5e
kind: step
verb: filter
noun: squares
modifier: recursively
context: core
phrase: filter perfect squares recursively from list
phrase: purge square numbers recursively
test: list=2,4,5,9,16,7
expect: => i=3 r=0.0 ok=true s="purged squares remaining 3" errors=0 n=3 res=[2,5,7] cache=0 hits=0
test: list=1,8,25,10
expect: => i=2 r=0.0 ok=true s="purged squares remaining 2" errors=0 n=2 res=[8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if !is_sq {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "purged squares remaining ", kept);
	out
}
@end
