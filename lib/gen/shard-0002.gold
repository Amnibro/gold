@entry 6e3cb3c98431d63d
kind: step
verb: return
noun: evens
modifier: pairwise
context: stats
phrase: return evens pairwise differences
phrase: compute pairwise deltas of consecutive evens
test: list=2,4,7,8,12
expect: => i=3 r=0.0 ok=true s="even pairwise differences: 3" errors=0 n=3 res=[2,4,4] cache=0 hits=0
test: list=10,20,30,5
expect: => i=2 r=0.0 ok=true s="even pairwise differences: 2" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ec = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[ec] = g.res[k];
			ec++;
		}
	}
	if ec > 1 {
		var pairs = ec - 1;
		for k in pairs {
			let a = g.res[k];
			let b = g.res[k + 1];
			g.res[k] = if b > a { b - a } else { a - b };
		}
		g.n = pairs;
		out.i = pairs;
	} else {
		g.n = 0;
		out.i = 0;
	}
	g.steps += g.n * 2 + 1;
	out.s.clear();
	format(out.s, "even pairwise differences: ", out.i);
	out
}
@end
@entry f17e0357f3af3907
kind: step
verb: find
noun: tail
modifier: nested
context: stats
phrase: find tail nested {k} items mean
phrase: calculate tail mean across nested {k} observations
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=40 r=0.0 ok=true s="tail mean: 40" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35 k=2
expect: => i=30 r=0.0 ok=true s="tail mean: 30" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count > 0 && g.n >= count {
		var sum = 0;
		let start = g.n - count;
		for i in 0..count {
			sum += g.res[start + i];
		}
		out.i = sum / count;
		out.s.clear();
		format(out.s, "tail mean: ", out.i);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient tail points");
	}
	g.steps += count + 1;
	out
}
@end
