	var diffs int[512] = [0; 512];
	var dn = 0;
	var i = 0;
	while i + 1 < g.n {
		diffs[dn] = g.res[i + 1] - g.res[i];
		dn++;
		i += 2;
	}
	gold_clear(g);
	for k in dn { gold_push(g, diffs[k]); }
	out.i = dn;
	g.steps += g.n + 1;
	out
}
