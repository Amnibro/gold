fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] > mx { mx = g.res[i]; }
	}
	gold_clear(g);
	gold_push(g, mx);
	out.i = mx;
	g.steps += g.n;
	out
}
@end
