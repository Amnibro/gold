@entry 08e79ae0c688903a
kind: step
verb: dedupe
noun: duplicates
modifier: with_retry
context: aggregate
phrase: dedupe duplicate elements with retry
phrase: remove duplicate items with retry
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="deduped to 4 unique items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="deduped to 1 unique items" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " unique items");
	out
}
@end
