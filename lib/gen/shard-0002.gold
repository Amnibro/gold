fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_sum = 0;
	var odd_sum = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			even_sum += g.res[k];
		} else {
			odd_sum += g.res[k];
		}
	}
	gold_clear(g);
	gold_push(g, even_sum);
	gold_push(g, odd_sum);
	g.steps += g.n + 2;
	out.i = even_sum + odd_sum;
	out.s.clear();
	format(out.s, "grouped totals: even=", even_sum, " odd=", odd_sum);
	out
}
@end
