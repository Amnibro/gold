code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c > 0 && c < g.n {
		let remaining = g.n - c;
		for k in remaining {
			g.res[k] = g.res[c + k];
		}
		g.n = remaining;
	} else if c >= g.n {
		g.n = 0;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "trimmed to ", g.n, " items");
	out
}
@end
@entry 8e990247d9e8cfaf
kind: step
verb: clamp
noun: budget
modifier: in_place
context: stats
phrase: clamp budget in place to total {max_sum}
phrase: constrain cumulative sum budget to {max_sum} in place
slot: max_sum int
test: list=10,20,30,40 max_sum=50
expect: => i=50 r=0.0 ok=true s="budget clamped to 50" errors=0 n=3 res=[10,20,20] cache=0 hits=0
test: list=5,15,25 max_sum=30
expect: => i=30 r=0.0 ok=true s="budget clamped to 30" errors=0 n=3 res=[5,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${max_sum};
	var running = 0;
	var kept = 0;
	for k in g.n {
		if running + g.res[k] <= budget {
			running += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			let rem = budget - running;
			if rem > 0 {
				g.res[kept] = rem;
				running += rem;
				kept++;
			}
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "budget clamped to ", running);
	out
}
@end
