code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 && out.i > 0 {
		gold_cache_put(g, out.i, 1);
	}
	var valid_count = 0;
	var idx = 0;
	while idx < g.n {
		let val = g.res[idx];
		let res_val, is_cached = gold_cache_get(g, val);
		if is_cached {
			g.res[valid_count] = val;
			valid_count++;
		}
		idx++;
	}
	g.n = valid_count;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "retained ", valid_count, " memo entries");
	g.steps += g.n + 1;
	out
}
@end
