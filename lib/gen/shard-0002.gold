context: retry
phrase: find nested retry cost within budget {budget}
phrase: calculate nested retry allowance against budget {budget}
slot: budget int
test: list=10,20,15 budget=60
expect: => i=15 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,15] cache=0 hits=0
test: list=25,35 budget=40
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var i = 0;
	while i < g.n {
		spent += g.res[i];
		i++;
	}
	if spent > b {
		gold_fail(g, "retry budget exceeded");
		out.ok = false;
		return out;
	}
	out.i = b - spent;
	g.steps += g.n;
	out
}
@end
