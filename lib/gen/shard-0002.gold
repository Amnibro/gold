expect: => i=2 r=0.0 ok=true s="elements between range 2" errors=0 n=4 res=[2,8,14,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "elements between range ", count);
	out
}
@end
