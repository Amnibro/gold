@entry ea25a56808a09f3b
kind: step
verb: filter
noun: prefix
modifier: recursively
context: core
phrase: filter prefix recursively until limit {limit}
phrase: prune prefix elements repeatedly up to size {limit}
slot: limit int
test: list=2,4,10,15,20 limit=8
expect: => i=3 r=0.0 ok=true s="filtered prefix, remaining: 3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,2,3,10 limit=5
expect: => i=1 r=0.0 ok=true s="filtered prefix, remaining: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var start = 0;
	while start < g.n && g.res[start] < lim {
		start++;
	}
	var new_n = 0;
	var idx = start;
	while idx < g.n {
		g.res[new_n] = g.res[idx];
		new_n++;
		idx++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filtered prefix, remaining: ", new_n);
	out
}
@end
