@entry 565d2d9978448c8a
kind: step
verb: swap
noun: histogram
modifier: all
context: compare
phrase: swap all inverted pairs based on histogram frequency comparison
phrase: reorder all elements comparing frequency counts
test: list=3,1,3,2,1,1
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,1,3,3,2] cache=3 hits=33
test: list=4,5,4,5,5
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[5,5,5,4,4] cache=2 hits=23
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cnt, ok = gold_cache_get(g, x);
		if ok { gold_cache_put(g, x, cnt + 1); }
		else { gold_cache_put(g, x, 1); }
	}
	for i in g.n {
		for j in i + 1..g.n {
			let ci, _ = gold_cache_get(g, g.res[i]);
			let cj, _ = gold_cache_get(g, g.res[j]);
			if ci < cj {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
