fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let avg = (g.res[idx] + g.res[idx + 1]) / 2;
		g.res[count] = avg;
		count++;
		idx += 2;
	}
	g.n = count;
	out.i = count;
	g.steps += count + 1;
	out
}
