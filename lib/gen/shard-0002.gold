fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var new_n = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in new_n {
			if g.res[j] == x { seen++; }
		}
		if seen < limit {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.steps += g.n * g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "capped repeats to ", new_n);
	out
}
@end
