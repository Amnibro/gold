code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_min = ${min_val};
	if g.n > 0 {
		var max_idx = 0;
		var max_val = g.res[0];
		for k in g.n {
			if g.res[k] > max_val {
				max_val = g.res[k];
				max_idx = k;
			}
		}
		if max_val < target_min {
			g.res[max_idx] = target_min;
			max_val = target_min;
		}
		out.i = max_val;
	} else {
		out.i = target_min;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "maximum shifted: ", out.i);
	out
}
@end
