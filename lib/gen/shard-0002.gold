code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_sz = ${count};
	if limit_sz <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	if g.n > limit_sz {
		let drop_count = g.n - limit_sz;
		for i in limit_sz {
			g.res[i] = g.res[i + drop_count];
		}
		g.n = limit_sz;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
