code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var d = ${depth};
	if d < 1 { d = 1; }
	if d > 4 { d = 4; }
	for step in d {
		let cur_n = g.n;
		for k in cur_n {
			if g.n < 500 {
				gold_push(g, g.res[k] * 2);
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "expanded range len ", g.n);
	out
}
@end
