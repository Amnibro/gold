@entry 82d3daaf268d5c1d
kind: step
verb: search
noun: runs
modifier: running
context: aggregate
phrase: search running runs of length at least {min_len}
phrase: detect running streaks of length {min_len}
slot: min_len int
test: list=1,1,1,2,2,3,3,3,3 min_len=3
expect: => i=2 r=0.0 ok=true s="found 2 matching running streaks" errors=0 n=9 res=[1,1,1,2,2,3,3,3,3] cache=0 hits=0
test: list=1,2,3 min_len=2
expect: => i=0 r=0.0 ok=true s="found 0 matching running streaks" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	var count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			i++;
		}
		if run_len >= min_l { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " matching running streaks");
	out
}
@end
