@entry f0b160dcd1191458
kind: step
verb: rotate
noun: primes
modifier: each
context: search
phrase: rotate search buffer by count of prime elements
phrase: cycle result array based on prime match count
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[5,6,2,3,4] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	if g.n > 1 && primes > 0 {
		let shift = primes % g.n;
		var tmp int[512] = [0; 512];
		for i in g.n {
			tmp[i] = g.res[(i + shift) % g.n];
		}
		for i in g.n {
			g.res[i] = tmp[i];
		}
	}
	out.i = primes;
	g.steps += g.n;
	out
}
@end
