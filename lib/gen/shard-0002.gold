expect: => i=15 r=0.0 ok=false s="middle element out of range" errors=0 n=3 res=[5,15,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var valid = false;
	if g.n > 0 {
		let mid = g.res[g.n / 2];
		valid = mid >= l && mid <= h;
		out.i = mid;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.ok = valid;
	out.s.clear();
	if valid {
		format(out.s, "middle element is valid: ", out.i);
	} else {
		format(out.s, "middle element out of range");
	}
	out
}
@end
