code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_mod = ${retries};
	var mods = 0;
	var i = 1;
	while i < out.s.len && mods < max_mod {
		let b = out.s[i];
		if b >= 65 as byte && b <= 90 as byte {
			out.s[i] = (b as int + 32) as byte;
			mods++;
		}
		i += 2;
	}
	g.steps += out.s.len;
	out.i = mods;
	out
}
@end
