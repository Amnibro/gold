fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_space = -1;
	for i in out.s.len {
		if out.s[i] == ' ' { last_space = i; }
	}
	if last_space >= 0 {
		let start = last_space + 1;
		let new_len = out.s.len - start;
		for j in new_len {
			out.s[j] = out.s[start + j];
		}
		out.s.resize(new_len, 0);
	}
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
