code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		out.i = 0;
		return out;
	}
	let middle_count = g.n - 2;
	for k in 1..(g.n - 1) {
		let avg = (g.res[k - 1] + g.res[k] + g.res[k + 1]) / 3;
		g.res[k] = avg;
	}
	g.steps += middle_count;
	out.i = middle_count;
	out.s.clear();
	format(out.s, "smoothed ", middle_count, " middle elements");
	out
}
@end
