fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty series for histogram");
		out.ok = false;
		return out;
	}
	let target = g.res[0];
	var count = 0;
	for k in g.n {
		if g.res[k] == target {
			count++;
		}
	}
	let mapped = ${f}(count);
	g.steps += g.n;
	out.i = mapped;
	out.s.clear();
	format(out.s, "first count ", count, " mapped to ", mapped);
	out
}
@end
