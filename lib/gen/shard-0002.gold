code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = if out.i < 0 { -out.i } else { out.i };
	var rev = 0;
	while n > 0 {
		rev = rev * 10 + (n % 10);
		n /= 10;
		g.steps += 1;
	}
	out.i = if out.i < 0 { -rev } else { rev };
	out.s.clear();
	format(out.s, "reversed number: ", out.i);
	out
}
@end
