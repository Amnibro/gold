	let cp = ${checkpoint};
	var pos = g.n;
	for k in g.n {
		if g.res[k] == cp {
			pos = k;
			break;
		}
	}
	g.steps += pos + 1;
	out.i = pos;
	out.s.clear();
	format(out.s, "checkpoint index ", pos);
	out
}
@end
