expect: => i=3 r=0.0 ok=true s="budget repeat len 3" errors=0 n=3 res=[5,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let orig_n = g.n;
	var idx = 0;
	while sum + g.res[idx % orig_n] <= b && g.n < 500 {
		let val = g.res[idx % orig_n];
		gold_push(g, val);
		sum += val;
		idx++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "budget repeat len ", g.n);
	out
}
@end
