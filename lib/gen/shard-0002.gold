code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		if k % 2 == 0 {
			g.res[k] = ${x}(g.res[k]);
		}
	}
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "alternating sorted items:", g.n);
	out.i = g.n;
	out
}
@end
