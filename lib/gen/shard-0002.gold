@entry 5a85a14ddd978c71
kind: step
verb: rotate
noun: numbers
modifier: all
context: aggregate
phrase: rotate all results by {shift} steps
phrase: cycle all numbers by offset {shift}
slot: shift int
test: list=1,2,3,4,5 shift=1
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let s = ${shift} % g.n;
	var rot = if s < 0 { s + g.n } else { s };
	while rot > 0 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
		rot--;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
