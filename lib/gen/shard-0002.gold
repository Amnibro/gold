kind: step
verb: dedupe
noun: function
modifier: between
context: math
phrase: dedupe evaluations falling between bounds {low} to {high}
phrase: remove duplicate math values between range {low} to {high}
slot: low int
slot: high int
test: list=5,10,10,15,15,20 low=8 high=18
expect: => i=4 r=0.0 ok=true s="deduped between bounds 4" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=1,2,2,3,4,4,5 low=2 high=4
expect: => i=5 r=0.0 ok=true s="deduped between bounds 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var drop = false;
		if x >= lo && x <= hi {
			for j in kept {
				if g.res[j] == x { drop = true; break; }
			}
		}
		if !drop {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped between bounds ", kept);
	out
}
@end
