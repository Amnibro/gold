code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	if w <= 0 || g.n < w {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let count = g.n - w + 1;
	for i in count {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[i] = sum;
	}
	g.n = count;
	g.steps += count * w;
	out.i = count;
	out.s.clear();
	format(out.s, "window in place produced ", count, " sums");
	out
}
@end
