phrase: exchange adjacent items until condition {stop}
phrase: swap checkpoint neighbors until reaching {stop}
slot: stop pred
test: list=10,20,30,40 stop=over_100
expect: => i=2 r=0.0 ok=true s="swapped 2 pairs" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
test: list=10,20,105,40 stop=over_100
expect: => i=1 r=0.0 ok=true s="swapped 1 pairs" errors=0 n=4 res=[20,10,105,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	var swapped = 0;
	while idx + 1 < g.n {
		if ${stop}(g.res[idx]) || ${stop}(g.res[idx + 1]) {
			break;
		}
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		swapped++;
		idx += 2;
	}
	g.steps += swapped;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " pairs");
	out
}
@end
