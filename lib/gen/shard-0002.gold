kind: step
verb: repeat
noun: budget
modifier: sorted
context: core
phrase: repeat item {item} within total budget {budget}
phrase: populate value {item} until budget limit {budget}
slot: item int
slot: budget int
test: item=10 budget=35
expect: => i=3 r=0.0 ok=true s="budget filled count 3" errors=0 n=3 res=[10,10,10] cache=0 hits=0
test: item=5 budget=12
expect: => i=2 r=0.0 ok=true s="budget filled count 2" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let it = ${item};
	let b = ${budget};
	gold_clear(g);
	if it <= 0 || b <= 0 {
		g.steps++;
		return out;
	}
	var cur_sum = 0;
	while cur_sum + it <= b && g.n < 512 {
		gold_push(g, it);
		cur_sum += it;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "budget filled count ", g.n);
	out
}
@end
