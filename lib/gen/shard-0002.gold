@entry 02c8e6ca7649d2dd
kind: step
verb: run
noun: histogram
modifier: sorted
context: stats
phrase: run sorted histogram frequencies across series
phrase: compute sorted frequency counts for series observations
test: list=3,1,3,2,1,3
expect: => i=3 r=0.0 ok=true s="computed 3 frequency bins" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,8,5,8,8
expect: => i=2 r=0.0 ok=true s="computed 2 frequency bins" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var u_vals int[512] = [0; 512];
	var u_cnts int[512] = [0; 512];
	var un = 0;
	for k in g.n {
		let x = g.res[k];
		var found = false;
		for j in un {
			if u_vals[j] == x {
				u_cnts[j]++;
				found = true;
				break;
			}
		}
		if !found {
			u_vals[un] = x;
			u_cnts[un] = 1;
			un++;
		}
	}
	for i in un {
		for j in un - 1 {
			if u_cnts[j] > u_cnts[j + 1] {
				let tc = u_cnts[j];
				u_cnts[j] = u_cnts[j + 1];
				u_cnts[j + 1] = tc;
			}
		}
	}
	for i in un {
		g.res[i] = u_cnts[i];
	}
	g.n = un;
	g.steps += g.n + un * un;
	out.i = un;
	out.s.clear();
	format(out.s, "computed ", un, " frequency bins");
	out
}
@end
