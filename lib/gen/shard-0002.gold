fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		return out;
	}
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	let offset = min_val * f;
	for k in g.n {
		g.res[k] -= offset;
	}
	g.steps += g.n * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized with minimum ", min_val);
	out
}
@end
@entry bf48b4971f38d14b
kind: step
verb: swap
noun: average
modifier: recursively
context: stats
phrase: swap observations around average recursively
phrase: partition series recursively about mean
test: list=10,50,20,40
expect: => i=1 r=30.0 ok=true s="swapped 1 items around average" errors=0 n=4 res=[10,20,50,40] cache=0 hits=0
test: list=1,9,3,7
expect: => i=1 r=5.0 ok=true s="swapped 1 items around average" errors=0 n=4 res=[1,3,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	var left = 0;
	var right = g.n - 1;
	var swaps = 0;
	while left < right {
		while left < right && g.res[left] <= avg {
			left++;
		}
		while left < right && g.res[right] > avg {
			right--;
		}
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			swaps++;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.r = (sum as real) / (g.n as real);
	out.s.clear();
	format(out.s, "swapped ", swaps, " items around average");
	out
}
@end
