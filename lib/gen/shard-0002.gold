noun: range
modifier: any
context: text
phrase: sort text character range from {start} to {end}
phrase: order character slice between indices {start} to {end}
slot: start int
slot: end int
test: text="aedcbf" start=1 end=4
expect: => i=6 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
test: text="943210" start=0 end=3
expect: => i=6 r=0.0 ok=true s="234910" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end};
	let n = out.s.len;
	if s >= 0 && e < n && s < e {
		let count = e - s + 1;
		for i in 0..(count - 1) {
			for j in 0..(count - 1 - i) {
				let p1 = s + j;
				let p2 = p1 + 1;
				if out.s[p1] > out.s[p2] {
					let tmp = out.s[p1];
					out.s[p1] = out.s[p2];
					out.s[p2] = tmp;
				}
			}
		}
	}
	g.steps += n;
	out.i = n;
	out
}
@end
