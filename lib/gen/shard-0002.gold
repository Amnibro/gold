@entry f46959706357eddd
kind: step
verb: rotate
noun: tail
modifier: recursively
context: aggregate
phrase: rotate tail elements recursively by {rot}
phrase: cycle trailing items recursively with offset {rot}
slot: rot int
test: list=1,2,3,4,5 rot=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,4,5,2,3] cache=0 hits=0
test: list=10,20,30,40 rot=1
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[10,40,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rot};
	if g.n <= 2 { return out; }
	let tail_len = g.n - 1;
	var shift = r % tail_len;
	if shift < 0 { shift += tail_len; }
	while shift > 0 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 1 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[1] = last;
		shift--;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
