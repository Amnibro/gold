fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	for k in g.n {
		if g.res[k] == tgt {
			found_idx = k;
			break;
		}
	}
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "target:", tgt, " found at index:", found_idx);
		out.i = found_idx;
	} else {
		format(out.s, "target:", tgt, " was not located");
		out.i = -1;
	}
	g.steps += g.n;
	out
}
@end
