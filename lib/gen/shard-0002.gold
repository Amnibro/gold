fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cur = 0;
	var last_len = -1;
	var max_diff = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if last_len >= 0 {
				let d = if cur > last_len { cur - last_len } else { last_len - cur };
				if d > max_diff { max_diff = d; }
			}
			last_len = cur;
			cur = 0;
		} else {
			cur++;
		}
	}
	if last_len >= 0 {
		let d = if cur > last_len { cur - last_len } else { last_len - cur };
		if d > max_diff { max_diff = d; }
	}
	out.i = max_diff;
	g.steps += out.s.len;
	out
}
@end
