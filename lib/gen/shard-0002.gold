fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var i = 0;
	while i + 1 < g.n && i < b {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i]; g.res[i] = g.res[i + 1]; g.res[i + 1] = t;
		}
		i++;
	}
	out.i = i;
	g.steps += g.n;
	out
}
