@entry b34a53638ba598f3
kind: step
verb: sum
noun: duplicates
modifier: in_place
context: error
phrase: sum duplicate error flags in place
phrase: condense duplicate error codes in place
test: list=-2,-2,-3,-3,-3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[-4,-9] cache=0 hits=0
test: list=1,1,2,2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var cur_val = g.res[i];
		var cur_sum = cur_val;
		var j = i + 1;
		while j < g.n && g.res[j] == cur_val {
			cur_sum += g.res[j];
			j++;
		}
		g.res[write_idx] = cur_sum;
		write_idx++;
		i = j;
	}
	g.n = write_idx;
	out.i = write_idx;
	g.steps += g.n + 1;
	out
}
@end
