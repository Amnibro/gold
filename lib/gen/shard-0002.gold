@entry bbabb760e834f51e
kind: step
verb: scale
noun: gaps
modifier: sorted
context: loop
phrase: scale sorted loop gaps by factor {m}
phrase: multiply gaps between sorted loop items by {m}
slot: m int
test: list=8,2,5 m=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[6,6] cache=0 hits=0
test: list=20,10,30 m=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	let mult = ${m};
	if g.n >= 2 {
		for i in g.n - 1 {
			g.res[i] = (g.res[i + 1] - g.res[i]) * mult;
		}
		g.n--;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
@entry 04a1faf6ea56bd52
kind: step
verb: compare
noun: step
modifier: in_place
context: loop
phrase: compare adjacent loop steps in place
phrase: record delta of consecutive loop steps in place
