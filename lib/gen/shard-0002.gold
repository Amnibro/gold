		total += g.res[k];
	}
	g.steps += g.n;
	out.i = total;
	if g.n > 0 {
		out.r = (total as real) / (g.n as real);
	}
	out.s.clear();
	format(out.s, "summed ", g.n, " results");
	out
}
@end
