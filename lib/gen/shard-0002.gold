code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var changed = true;
	while changed {
		changed = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				changed = true;
			}
			i++;
		}
		if changed { passes++; }
	}
	out.i = passes;
	g.steps += passes * g.n + 1;
	out
}
@end
