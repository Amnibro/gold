fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for k in g.n {
		let transformed = ${sub}(g.res[k]);
		if transformed <= lim {
			g.res[k] = transformed;
			count++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " elements before limit");
	out
}
@end
