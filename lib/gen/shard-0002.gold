kind: step
verb: clamp
noun: history
modifier: sorted
context: aggregate
phrase: clamp history items to sorted range {low} {high}
phrase: bound historical results within sorted {low} {high}
slot: low int
slot: high int
test: list=1,10,20,30 low=5 high=25
expect: => i=2 r=0.0 ok=true s="clamped 2" errors=0 n=4 res=[5,10,20,25] cache=0 hits=0
test: list=2,4,6 low=3 high=5
expect: => i=2 r=0.0 ok=true s="clamped 2" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${low};
	let max_val = ${high};
	var modified = 0;
	var idx = 0;
	while idx < g.n {
		let current = g.res[idx];
		if current < min_val {
			g.res[idx] = min_val;
			modified++;
		} else if current > max_val {
			g.res[idx] = max_val;
			modified++;
		}
		idx++;
	}
	out.i = modified;
	g.steps += idx;
	out.s.clear();
	format(out.s, "clamped ", modified);
	out
}
@end
