@entry 5d1a3a415c4ab03f
kind: step
verb: find
noun: window
modifier: every_other
context: transform
phrase: find every other window of size {wsize}
phrase: extract alternating windows of width {wsize}
slot: wsize int
test: list=1,2,3,4,5,6 wsize=2
expect: => i=3 r=0.0 ok=true s="extracted 3 alternating windows" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30 wsize=2
expect: => i=1 r=0.0 ok=true s="extracted 1 alternating windows" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	if w <= 0 || g.n < w {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i + w <= g.n {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[kept] = sum;
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += kept * w;
	out.i = kept;
	out.s.clear();
	format(out.s, "extracted ", kept, " alternating windows");
	out
}
@end
@entry 172d40cb469e6fca
kind: step
verb: limit
noun: duplicates
modifier: last
context: transform
phrase: limit duplicates from last up to count {max_count}
phrase: restrict duplicate values from trailing end to {max_count}
slot: max_count int
test: list=1,2,1,2,2 max_count=1
expect: => i=2 r=0.0 ok=true s="retained 2 items under duplicate limit" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,5,5 max_count=2
expect: => i=2 r=0.0 ok=true s="retained 2 items under duplicate limit" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_count};
	if cap <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	for k in g.n {
		let idx = g.n - 1 - k;
		let val = g.res[idx];
		var seen = 0;
		for j in kept {
			if g.res[j] == val { seen++; }
		}
		if seen < cap {
			g.res[kept] = val;
			kept++;
		}
	}
	for i in kept / 2 {
		let j = kept - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items under duplicate limit");
	out
}
@end
