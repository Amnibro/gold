@entry 1f141ec2e57003f5
kind: step
verb: rotate
noun: items
modifier: nested
context: stats
phrase: rotate items nested by {shift} steps
phrase: perform nested circular shift of items by {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=5 r=0.0 ok=true s="rotated items by 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=3 r=0.0 ok=true s="rotated items by 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 {
		let k = s % g.n;
		for step in k {
			let first = g.res[0];
			for i in 0..(g.n - 1) {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n * (s + 1);
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated items by ", s);
	out
}
@end
