code:
fn ${ID}_is_vowel(b byte) bool {
	b == 97 || b == 101 || b == 105 || b == 111 || b == 117
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200];
	var consonants byte[..200];
	for k in out.s.len {
		let b = out.s[k];
		if ${ID}_is_vowel(b) {
			vowels.push(b);
		} else {
			consonants.push(b);
		}
	}
	out.s.clear();
	for b in vowels { out.s.push(b); }
	for b in consonants { out.s.push(b); }
	g.steps += out.s.len;
	out.i = vowels.len;
	out
}
@end
