modifier: in_reverse
context: filter
phrase: dedupe numbers in reverse order keeping last
phrase: preserve final occurrence of numbers in reverse
test: list=1,2,3,2,1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,6,7,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[>..] = [];
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in kept.len {
			if kept[j] == x { seen = true; break; }
		}
		if !seen { kept.push(x); }
		i--;
	}
	gold_clear(g);
	var k = kept.len - 1;
	while k >= 0 {
		gold_push(g, kept[k]);
		k--;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
