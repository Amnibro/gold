expect: => i=-1 r=0.0 ok=false s="last duplicate is -1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_dup = -1;
	var found = false;
	var k = g.n;
	while k > 0 {
		k--;
		for j in k {
			if g.res[j] == g.res[k] {
				last_dup = g.res[k];
				found = true;
				break;
			}
		}
		if found { break; }
	}
	g.steps += g.n;
	out.ok = found;
	out.i = last_dup;
	out.s.clear();
	format(out.s, "last duplicate is ", last_dup);
	out
}
@end
