code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var sum_init = 0;
		for i in 0..(g.n - 1) {
			sum_init += g.res[i];
		}
		let diff = sum_init - last_val;
		out.i = diff;
		out.ok = diff >= 0;
	} else {
		out.i = 0;
		out.ok = false;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "split total diff ", out.i);
	out
}
@end
@entry 58ff5e7091e66430
kind: step
verb: shift
noun: prefix
modifier: in_place
context: compare
phrase: shift prefix of {k} items in_place
phrase: offset prefix sequence of {k} elements in_place
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=30 r=0.0 ok=true s="shifted prefix head 30" errors=0 n=5 res=[30,10,20,40,50] cache=0 hits=0
test: list=2,4,6,8 k=2
expect: => i=4 r=0.0 ok=true s="shifted prefix head 4" errors=0 n=4 res=[4,2,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let bound = if limit < g.n { limit } else { g.n };
	if bound > 1 {
		let last = g.res[bound - 1];
		var j = bound - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += bound;
	out.i = if bound > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "shifted prefix head ", out.i);
	out
}
@end
@entry e455f46f128e6bb3
kind: step
