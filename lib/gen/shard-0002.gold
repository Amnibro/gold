code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var count = 0;
	for i in g.n {
		if rem >= g.res[i] {
			rem -= g.res[i];
			count++;
		} else {
			break;
		}
	}
	out.i = count;
	g.steps += count;
	out
}
@end
