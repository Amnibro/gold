fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var clamped = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		let mx = if a > b { a } else { b };
		let val = if mx > limit { limit } else { mx };
		gold_cache_put(g, i, val);
		clamped++;
		i += 2;
	}
	out.i = clamped;
	g.steps += g.n;
	out
}
@end
