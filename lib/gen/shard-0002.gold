@entry 02f48a7658935825
kind: step
verb: limit
noun: suffix
modifier: last
context: cache
phrase: limit cache items to last {count} elements
phrase: keep only last {count} entries in cached results
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[30,40,50] cache=3 hits=0
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	if g.n > k {
		let drop_amt = g.n - k;
		for i in k {
			g.res[i] = g.res[i + drop_amt];
			gold_cache_put(g, i, g.res[i]);
		}
		g.n = k;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
