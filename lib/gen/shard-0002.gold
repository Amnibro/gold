@entry 7b06b1ef0c7ea123
kind: step
verb: split
noun: value
modifier: with_retry
context: compare
phrase: split value around pivot {pivot} with_retry limit {max_retries}
phrase: partition values against {pivot} allowing retries {max_retries}
slot: pivot int
slot: max_retries int
test: list=10,50,20,60,30 pivot=25 max_retries=2
expect: => i=1 r=0.0 ok=true s="partition diff 1" errors=0 n=5 res=[10,50,20,60,30] cache=0 hits=0
test: list=5,15,25,35 pivot=20 max_retries=0
expect: => i=0 r=0.0 ok=true s="partition diff 0" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	let max_r = ${max_retries};
	var less = 0;
	var greater = 0;
	for i in g.n {
		if g.res[i] < p { less++; }
		if g.res[i] > p { greater++; }
	}
	let diff = if less > greater { less - greater } else { greater - less };
	if diff > max_r {
		gold_fail(g, "partition imbalance exceeds retries");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "partition diff ", diff);
	out
}
@end
