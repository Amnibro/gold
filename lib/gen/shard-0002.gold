test: list=97,98,99,101,105
expect: => i=3 r=0.0 ok=true s="split vowels count 3" errors=0 n=5 res=[97,101,105,98,99] cache=0 hits=0
code:
fn ${ID}_is_v(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 ||
	c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var v_cnt = 0;
	var c_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_v(x) {
			temp[v_cnt] = x;
			v_cnt++;
		}
	}
	c_cnt = v_cnt;
	for i in g.n {
		let x = g.res[i];
		if !${ID}_is_v(x) {
			temp[c_cnt] = x;
			c_cnt++;
		}
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = v_cnt;
	out.s.clear();
	format(out.s, "split vowels count ", v_cnt);
	out
}
@end
