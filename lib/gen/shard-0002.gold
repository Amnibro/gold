code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	var max_run = 0;
	if g.n > 0 {
		var cur_run = 1;
		max_run = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
				if cur_run > max_run { max_run = cur_run; }
			} else {
				cur_run = 1;
			}
		}
	}
	if max_run > lim { max_run = lim; }
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest run is ", max_run);
	out
}
@end
