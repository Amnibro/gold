noun: suffix
modifier: pairwise
context: error
phrase: keep error suffix pairwise differences
phrase: retain pairwise differences of error suffix
slot: count int
test: list=10,20,35,55 count=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[15,20] cache=0 hits=0
test: list=1,3,6,10 count=4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	let len = g.n - start;
	if len <= 1 {
		g.steps++;
		return out;
	}
	for i in len - 1 {
		g.res[i] = g.res[start + i + 1] - g.res[start + i];
	}
	g.n = len - 1;
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
@entry 64f2001259f612b0
kind: step
verb: dedupe
noun: suffix
modifier: each
context: error
phrase: dedupe suffix error codes for each run
phrase: prune duplicate error suffix elements
slot: count int
test: list=1,2,5,5,6 count=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,5,6] cache=0 hits=0
test: list=10,10,10 count=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var kept = start;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in start..kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
