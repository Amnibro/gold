fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var distinct = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		while i < g.n && g.res[i] == val {
			i++;
		}
		distinct++;
	}
	out.i = distinct;
	g.steps += g.n * 2;
	out.s.clear();
	format(out.s, "distinct bins: ", distinct);
	out
}
@end
