@entry 20be283b9a051a26
kind: step
verb: scale
noun: number
modifier: in_reverse
context: core
phrase: scale each number in reverse order by {factor}
phrase: multiply numbers backward using factor {factor}
phrase: scale elements in reverse with factor {factor}
slot: factor int
test: list=1,2,3 factor=5
expect: => i=3 r=0.0 ok=true s="reversed and scaled 3 items" errors=0 n=3 res=[15,10,5] cache=0 hits=0
test: list=10,20 factor=-1
expect: => i=2 r=0.0 ok=true s="reversed and scaled 2 items" errors=0 n=2 res=[-20,-10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	for k in g.n {
		g.res[k] *= fac;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
