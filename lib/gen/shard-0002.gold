code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_primes = 0;
	var i = 0;
	while i < g.n {
		if core_is_prime(g.res[i]) {
			var seen = false;
			var j = 0;
			while j < i {
				if g.res[j] == g.res[i] { seen = true; break; }
				j++;
			}
			if !seen { distinct_primes++; }
		}
		i++;
	}
	out.i = distinct_primes;
	g.steps += g.n * g.n + 1;
	out
}
@end
