fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	if out.s.len > 0 && ml >= 0 {
		let first = out.s[0];
		var run = 0;
		while run < out.s.len && out.s[run] == first {
			run++;
		}
		let keep = if run > ml { ml } else { run };
		var res byte[..200] = "";
		for k in keep {
			if res.len < 200 { res.push(first); }
		}
		for k in run..out.s.len {
			if res.len < 200 { res.push(out.s[k]); }
		}
		out.s.clear();
		for b in res { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
