fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = g.n - 1;
	var rev_idx = 0;
	while idx >= 0 {
		gold_cache_put(g, rev_idx, g.res[idx]);
		rev_idx++;
		idx--;
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "applied cache in reverse: ", g.cn);
	out
}
@end
@entry 298b6499d8d0e96a
kind: step
verb: limit
noun: letters
modifier: each
context: stats
phrase: limit letters each word to {cap}
phrase: truncate text letters for each word at {cap}
slot: cap int
test: text="statistical distributions" cap=5
expect: => i=11 r=0.0 ok=true s="stati distr" errors=0 n=0 res=[] cache=0 hits=0
test: text="mean variance covariance" cap=4
expect: => i=14 r=0.0 ok=true s="mean vari cova" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var buf byte[..200] = "";
	var word_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 32 {
			if buf.len < 200 { buf.push(c); }
			word_len = 0;
		} else {
			if word_len < limit {
				if buf.len < 200 { buf.push(c); }
				word_len++;
		}
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
