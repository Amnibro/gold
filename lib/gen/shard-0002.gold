@entry 5de42dc200564c91
kind: step
verb: search
noun: gaps
modifier: recursively
context: search
phrase: search pair with exact target gap {target_gap}
phrase: find match pair having difference {target_gap}
slot: target_gap int
test: list=2,8,15,19 target_gap=6
expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[2,8] cache=0 hits=0
test: list=1,4,10 target_gap=2
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target_gap};
	var found = false;
	var a = 0;
	var b = 0;
	var i = 0;
	while i < g.n && !found {
		var j = i + 1;
		while j < g.n && !found {
			if g.res[j] - g.res[i] == tg {
				found = true;
				a = g.res[i];
				b = g.res[j];
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	if found {
		gold_push(g, a);
		gold_push(g, b);
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
