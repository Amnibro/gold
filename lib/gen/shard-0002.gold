fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	let fl = ${floor};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var scaled = avg * fac;
	if scaled < fl { scaled = fl; }
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled average to ", scaled);
	out
}
@end
