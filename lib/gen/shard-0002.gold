phrase: dedupe square numbers in place
phrase: filter duplicate square values in list
test: list=4,9,4,16,9
expect: => i=3 r=0.0 ok=true s="deduped in place count 3" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,4,1,9
expect: => i=3 r=0.0 ok=true s="deduped in place count 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped in place count ", kept);
	out
}
@end
