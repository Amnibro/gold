	var out = v;
	let p = ${penalty};
	var errs = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 {
			errs++;
		}
		i++;
	}
	out.i = errs * p;
	g.steps += g.n;
	out
}
