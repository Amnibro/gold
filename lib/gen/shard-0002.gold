fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	if g.n > 0 {
		for k in g.n {
			if g.res[k] < min_val { min_val = g.res[k]; }
		}
		for k in g.n {
			g.res[k] -= min_val;
		}
	} else {
