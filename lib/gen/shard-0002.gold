fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	var tmp int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[(min_idx + i) % g.n];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	out.i = g.res[0];
	g.steps += g.n;
	out
}
@end
