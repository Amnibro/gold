@entry 1513da522d72a1f9
kind: step
verb: group
noun: items
modifier: pairwise
context: cache
phrase: group adjacent items pairwise into cached sums
phrase: combine consecutive entries pairwise into cache
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,7] cache=2 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[30,70] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sums int[512] = [0; 512];
	var sn = 0;
	var i = 0;
	while i + 1 < g.n {
		sums[sn] = g.res[i] + g.res[i + 1];
		gold_cache_put(g, sn, sums[sn]);
		sn++;
		i += 2;
	}
	gold_clear(g);
	for k in sn { gold_push(g, sums[k]); }
	out.i = sn;
	g.steps += g.n + 1;
	out
}
@end
@entry c71df58358cccffa
kind: step
verb: cache
noun: primes
modifier: up_to
context: cache
phrase: cache prime numbers up to upper limit {lim}
phrase: store primes up to ceiling {lim} into cache
slot: lim int
test: input=10 lim=15
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[2,3,5,7,11,13] cache=6 hits=0
test: input=5 lim=12
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,5,7,11] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	gold_clear(g);
	var count = 0;
	for cand in 2..(ceiling + 1) {
		if core_is_prime(cand) {
			gold_push(g, cand);
			gold_cache_put(g, count, cand);
			count++;
		}
	}
	out.i = count;
	g.steps += ceiling + 1;
