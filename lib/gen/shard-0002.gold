slot: f fn
test: input=5 f=double
expect: => i=10 r=0.0 ok=true s="memo result: 10" errors=0 n=0 res=[] cache=1 hits=0
test: input=10 f=square
expect: => i=100 r=0.0 ok=true s="memo result: 100" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = out.i;
	let cached, found = gold_cache_get(g, k);
	if found {
		out.i = cached;
	} else {
		let res = ${f}(k);
		gold_cache_put(g, k, res);
		out.i = res;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "memo result: ", out.i);
	out
}
@end
