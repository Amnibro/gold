fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var sum = 0;
	var k = g.n;
	while k > 0 {
		k--;
		let val, _ = gold_cache_get(g, k);
		sum += val;
		g.res[k] = sum;
	}
	out.i = sum;
	g.steps += g.n;
	out
}
