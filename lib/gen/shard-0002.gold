	var unique_pairs = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			if g.res[k] != g.res[k + 1] {
				unique_pairs++;
			}
		}
	}
	g.steps += g.n;
	out.i = unique_pairs;
	out.s.clear();
	format(out.s, "found ", unique_pairs, " distinct adjacent pairs");
	out
}
@end
