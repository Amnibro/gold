code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	if g.n > 1 {
		for k in (g.n - 1) {
			if g.res[k] >= g.res[k + 1] {
				valid = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	if valid {
		out.i = g.n;
		format(out.s, "monotonic streak valid with ", g.n, " elements");
	} else {
		out.i = 0;
		format(out.s, "monotonic streak broken");
	}
	out
}
@end
