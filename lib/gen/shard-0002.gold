code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stp = ${step_val};
	if stp == 0 {
		gold_fail(g, "zero step value");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n {
		if k % 2 == 1 {
			g.res[k] /= stp;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "adjusted ", count, " alternating steps");
	out
}
@end
