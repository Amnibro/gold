fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	let off = ${offset};
	if g.n < min_l || min_l <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "suffix length below minimum");
		return out;
	}
	let start = g.n - min_l;
	for k in start..g.n {
		g.res[k] += off;
	}
	g.steps += min_l;
	out.i = min_l;
	out.s.clear();
	format(out.s, "shifted suffix elements by offset");
	out
}
@end
