code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${divisor};
	if div <= 1 {
		gold_fail(g, "divisor must exceed one");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	let mid = g.n / 2;
	var val = g.res[mid];
	var count = 0;
	while val >= div {
		val /= div;
		count++;
	}
	g.res[mid] = val;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split middle ", count, " times");
	out
}
@end
