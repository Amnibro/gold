fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n > 1 && c > 0 {
		var shifts = c % g.n;
		var s = 0;
		while s < shifts {
			let first = g.res[0];
			for k in (g.n - 1) {
				g.res[k] = g.res[k + 1];
			}
			g.res[g.n - 1] = first;
			s++;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated results by ", c, " positions");
	out
}
@end
