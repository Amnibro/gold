fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var swapped = 0;
	var idx = 0;
	while idx + 1 < g.n && swapped < c {
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
		swapped++;
		idx += 2;
	}
	g.steps += swapped * 2;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " pairs");
	out
}
