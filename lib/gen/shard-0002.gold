fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var windows = 0;
	if sz > 0 && g.n >= sz {
		for i in 0..(g.n - sz + 1) {
			var w_sum = 0;
			for j in 0..sz {
				w_sum += g.res[i + j];
			}
			gold_cache_put(g, i, w_sum);
			windows++;
		}
	}
	g.steps += g.n;
	out.i = windows;
	out.s.clear();
	format(out.s, "sliding windows count ", windows);
	out
}
@end
