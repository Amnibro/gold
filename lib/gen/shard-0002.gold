fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
			if is_p { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "formatted ", count);
	out
}
@end
