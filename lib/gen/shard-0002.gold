	let lo = ${low};
	let hi = ${high};
	var ok = true;
	var evens = 0;
	for i in g.n {
		if core_is_even(g.res[i]) {
			evens++;
			if g.res[i] < lo || g.res[i] > hi { ok = false; }
		}
	}
	out.ok = ok && evens > 0;
	out.i = evens;
	g.steps += g.n + 1;
	out
}
