@entry 080576d56446ae25
kind: step
verb: collect
noun: letters
modifier: with_cache
context: sort
phrase: collect sorted character codes with cache
phrase: gather sorted label letters using cache lookup
test: text="cba"
expect: => i=3 r=0.0 ok=true s="cba" errors=0 n=3 res=[97,98,99] cache=1 hits=0
test: text="edc"
expect: => i=3 r=0.0 ok=true s="edc" errors=0 n=3 res=[99,100,101] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	for b in out.s {
		gold_push(g, b as int);
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	gold_cache_put(g, g.n, g.res[0]);
	out.i = g.n;
	g.steps += g.n * g.n + 1;
	out
}
@end
