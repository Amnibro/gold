fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var shifted = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			g.res[k] = g.res[k] + 1;
			shifted++;
		}
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted, " numbers");
