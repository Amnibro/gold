fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			total += d * d;
			count++;
		}
	}
	g.steps += out.s.len + 1;
	out.i = total;
	out
}
