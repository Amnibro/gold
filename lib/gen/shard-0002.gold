code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		return out;
	}
	for k in g.n - 1 {
		let a = g.res[k];
		let b = g.res[k + 1];
		g.res[k] = if a < b { 1 } else if a > b { -1 } else { 0 };
	}
	g.n--;
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
