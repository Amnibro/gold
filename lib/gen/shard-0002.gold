fn ${ID}_is_v(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	var count = 0;
	while i < j {
		while i < j && !${ID}_is_v(g.res[i]) { i++; }
		while i < j && !${ID}_is_v(g.res[j]) { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			count++;
			i++;
			j--;
		}
	}
	gold_cache_put(g, 0, count);
	out.i = count;
	g.steps += g.n + 1;
	out
}
@end
