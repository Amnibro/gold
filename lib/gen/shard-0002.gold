code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var write_idx = 1;
		for k in 1..g.n {
			if g.res[k] != g.res[write_idx - 1] {
				g.res[write_idx] = g.res[k];
				write_idx++;
			}
		}
		g.n = write_idx;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped in place count ", g.n);
	out
}
@end
