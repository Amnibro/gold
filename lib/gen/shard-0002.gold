@entry 369b3e869bcf27d5
kind: step
verb: trace
noun: middle
modifier: recursively
context: core
phrase: trace middle value recursively stepping by {step}
phrase: record middle element recursively with step {step}
phrase: trace central item recursively using step {step}
slot: step int
test: list=10,25,30 step=7
expect: => i=3 r=0.0 ok=true s="traced 3 steps" errors=0 n=6 res=[10,25,30,18,11,4] cache=0 hits=0
test: list=5,8 step=10
expect: => i=0 r=0.0 ok=true s="traced 0 steps" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	if st <= 0 {
		gold_fail(g, "step must be positive");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		out.s.clear();
		out.s.append("no items to trace");
		return out;
	}
	let mid = g.n / 2;
	var cur = g.res[mid];
	var count = 0;
	while cur > st {
		cur -= st;
		gold_push(g, cur);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced ", count, " steps");
	out
}
@end
@entry d45745e89c5e3002
kind: step
