code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	if w > 1 {
		for i in w {
			for j in (i + 1)..w {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "unique sorted size ", w);
	out
}
@end
