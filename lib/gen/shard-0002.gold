kind: step
verb: return
noun: tally
modifier: with_retry
context: core
phrase: return tally with retry attempts {attempts}
phrase: compute tally using retry limit {attempts}
phrase: tally positive results with retry count {attempts}
slot: attempts int
test: list=0,-1,-2 attempts=3
expect: => i=1 r=0.0 ok=true s="tally 1 after 1 retries" errors=0 n=3 res=[1,0,-1] cache=0 hits=0
test: list=5,10,-1 attempts=2
expect: => i=2 r=0.0 ok=true s="tally 2 after 0 retries" errors=0 n=3 res=[5,10,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var att = 0;
	var pos = 0;
	while att <= max_att {
		pos = 0;
		for k in g.n {
			if g.res[k] > 0 { pos++; }
		}
		if pos > 0 || att == max_att { break; }
		for k in g.n {
			g.res[k] += 1;
		}
		att++;
	}
	g.steps += att + pos;
	out.i = pos;
	out.s.clear();
	format(out.s, "tally ", pos, " after ", att, " retries");
	out
}
@end
