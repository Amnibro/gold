slot: max_val int
test: list=15,20,25 min_val=10 max_val=20
expect: => i=15 r=0.0 ok=true s="head in bounds 15" errors=0 n=3 res=[15,20,25] cache=0 hits=0
test: list=5,10,15 min_val=10 max_val=20
expect: => i=5 r=0.0 ok=false s="" errors=1 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	let head = g.res[0];
	let ok = head >= lo && head <= hi;
	if !ok {
		gold_fail(g, "head out of range");
		out.ok = false;
		out.i = head;
		return out;
	}
	g.steps++;
	out.i = head;
	out.s.clear();
	format(out.s, "head in bounds ", head);
	out
}
@end
