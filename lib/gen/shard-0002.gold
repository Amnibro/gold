@entry a34da8633361dba5
kind: step
verb: rank
noun: runs
modifier: safely
context: format
phrase: rank consecutive runs safely
phrase: compute run lengths with safe bounds
test: list=2,2,2,5,5,7
expect: => i=3 r=0.0 ok=true s="runs count:3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=1,1,3,3,3,3
expect: => i=2 r=0.0 ok=true s="runs count:2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "no runs in empty list");
		out.i = 0;
		return out;
	}
	var num_runs = 0;
	var cur_len = 1;
	var run_lens int[512] = [0; 512];
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			run_lens[num_runs] = cur_len;
			num_runs++;
			cur_len = 1;
		}
	}
	run_lens[num_runs] = cur_len;
	num_runs++;
	for k in num_runs {
		g.res[k] = run_lens[k];
	}
	g.n = num_runs;
	format(out.s, "runs count:", num_runs);
	out.i = num_runs;
	g.steps += g.n;
	out
}
@end
