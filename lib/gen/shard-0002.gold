fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_times};
	var fixed = 0;
	var i = 0;
	while i < g.n && fixed < limit {
		if core_is_odd(g.res[i]) {
			g.res[i]++;
			fixed++;
		}
		i++;
	}
	out.i = fixed;
	g.steps += g.n + 1;
