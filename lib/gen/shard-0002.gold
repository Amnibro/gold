fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		if g.res[k] < 0 {
			gold_fail(g, "negative number encountered");
			out.ok = false;
			return out;
		}
	}
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
