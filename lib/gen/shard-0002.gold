fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var kept = 1;
		var k = 1;
		while k < g.n {
			if g.res[k] != g.res[kept - 1] {
				g.res[kept] = g.res[k];
				kept++;
			}
			k++;
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique sorted sequence length: ", g.n);
	out
}
