noun: evens
modifier: in_reverse
context: filter
phrase: rotate even values in reverse order
phrase: reverse even elements in filtered list
test: list=2,5,4,7,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[6,5,4,7,2] cache=0 hits=0
test: list=10,3,20,5,30
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[30,3,20,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[>..] = [];
	for k in g.n {
		if core_is_even(g.res[k]) { evens.push(g.res[k]); }
	}
	var e_idx = evens.len - 1;
	for k in g.n {
		if core_is_even(g.res[k]) {
			g.res[k] = evens[e_idx];
			e_idx--;
		}
	}
	g.steps += g.n;
	out.i = evens.len;
	out
}
@end
