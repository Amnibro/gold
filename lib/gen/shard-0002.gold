expect: => i=5 r=0.0 ok=true s="odd expanded count:5" errors=0 n=5 res=[1,1,2,3,3] cache=0 hits=0
test: list=4,6,8 times=3
expect: => i=3 r=0.0 ok=true s="odd expanded count:3" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var new_n = 0;
	var temp int[512] = [0; 512];
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			var rep = t;
			if rep < 1 { rep = 1; }
			for _ in rep {
				if new_n < 512 {
					temp[new_n] = x;
					new_n++;
				}
			}
		} else {
			if new_n < 512 {
				temp[new_n] = x;
				new_n++;
			}
		}
	}
	for k in new_n {
		g.res[k] = temp[k];
	}
	g.n = new_n;
	out.s.clear();
	format(out.s, "odd expanded count:", new_n);
	out.i = new_n;
	g.steps += g.n;
	out
}
@end
@entry b6bf294fa406d93e
kind: step
verb: sort
noun: gaps
modifier: times
context: format
phrase: sort gap intervals between values
phrase: arrange differences between consecutive entries
test: list=10,1,15,4
expect: => i=3 r=0.0 ok=true s="sorted gaps count:3" errors=0 n=3 res=[9,11,14] cache=0 hits=0
test: list=20,5,30
expect: => i=2 r=0.0 ok=true s="sorted gaps count:2" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n <= 1 {
		format(out.s, "not enough items for gaps");
		out.i = 0;
		return out;
	}
	let num_gaps = g.n - 1;
	for k in num_gaps {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		g.res[k] = diff;
	}
	g.n = num_gaps;
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	format(out.s, "sorted gaps count:", g.n);
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
