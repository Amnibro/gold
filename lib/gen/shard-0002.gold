fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		g.steps++;
		return out;
	}
	for i in 1..(g.n - 1) {
		for j in 1..(g.n - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n - 1;
	out.s.clear();
	format(out.s, "sorted tail size ", g.n - 1);
	out
}
@end
