	if v < 0 {
		v = 0 - v;
	}
	if v < 10 {
		return 0;
	}
	var pairs = 0;
	while v >= 10 {
		let d1 = v % 10;
		let d2 = (v / 10) % 10;
		if d1 % 2 == 0 && d2 % 2 == 0 {
			pairs = pairs + 1;
		}
		v = v / 10;
	}
	pairs
}
