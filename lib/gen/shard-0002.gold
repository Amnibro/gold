@entry 7dea58733308e71c
kind: step
verb: dedupe
noun: number
modifier: any
context: text
phrase: dedupe number any digits leaving single occurrence per digit
phrase: filter digits retaining only first appearance of each digit
test: text="a1b2a1c2"
expect: => i=6 r=0.0 ok=true s="a1b2ac" errors=0 n=0 res=[] cache=0 hits=0
test: text="998877"
expect: => i=3 r=0.0 ok=true s="987" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept byte[..200] = "";
	var seen_digits: int = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c >= '0' && c <= '9' {
			let d = (c as int) - 48;
			let mask = 1 << d;
			if (seen_digits & mask) == 0 {
				seen_digits |= mask;
				if kept.len < 200 { kept.push(c); }
			}
		} else {
			if kept.len < 200 { kept.push(c); }
		}
