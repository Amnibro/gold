fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_val = 0;
	var found = false;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if i == 0 || x > max_val {
			max_val = x;
		}
		count++;
		if max_val >= lim {
			found = true;
			break;
		}
	}
	g.steps += count;
	out.i = max_val;
	out.s.clear();
	if found {
		format(out.s, "reached limit ", lim, " with max ", max_val);
	} else {
		format(out.s, "stopped with max ", max_val);
	}
	out
}
@end
