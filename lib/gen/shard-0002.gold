code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	for i in g.n {
		if g.res[i] > b { count++; }
	}
	var i = 0;
	var j = count - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	gold_text(out, "reversed qualified prefix");
	out.i = count;
	g.steps += g.n + count + 1;
	out
}
@end
