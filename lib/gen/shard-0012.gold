code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_run = if g.n > 0 { 1 } else { 0 };
	var curr_run = 1;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] >= g.res[i - 1] {
				curr_run++;
				if curr_run > max_run { max_run = curr_run; }
			} else {
				curr_run = 1;
			}
		}
	}
	gold_push(g, max_run);
	g.steps += g.n + 1;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest sorted run length ", max_run);
	out
}
@end
