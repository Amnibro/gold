@entry 6d9f0e5546af5311
kind: step
verb: limit
noun: streak
modifier: last
context: sort
phrase: limit streak last consecutive run to {max_len}
phrase: truncate final sorted streak to {max_len}
slot: max_len int
test: list=1,2,3,3,3,3 max_len=2
expect: => i=4 r=0.0 ok=true s="truncated streak to 4 items" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=5,6,6,6 max_len=1
expect: => i=2 r=0.0 ok=true s="truncated streak to 2 items" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_len};
	if g.n == 0 { return out; }
	var streak = 1;
	var i = g.n - 1;
	while i > 0 && g.res[i] == g.res[i - 1] {
		streak++;
		i--;
	}
	let excess = if streak > cap { streak - cap } else { 0 };
	g.n = g.n - excess;
	g.steps += streak;
	out.i = g.n;
	out.s.clear();
	format(out.s, "truncated streak to ", g.n, " items");
	out
}
@end
