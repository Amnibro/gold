code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let total = ${total};
	let cost = ${cost};
	if cost <= 0 {
		return out;
	}
	var rem = total;
	var collected = 0;
	while rem >= cost {
		gold_push(g, cost);
		rem -= cost;
		collected++;
	}
	g.steps += collected;
	out.i = collected;
	out.s.clear();
	format(out.s, "collected ", collected, " items from budget");
	out
}
@end
