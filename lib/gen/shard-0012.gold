fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var unique_count = 0;
	for i in out.s.len {
		var dup = false;
		for j in i {
			if out.s[i] == out.s[j] { dup = true; break; }
		}
		if !dup { unique_count++; }
	}
	let res = unique_count * f;
	g.steps += out.s.len;
	out.i = res;
	out
}
