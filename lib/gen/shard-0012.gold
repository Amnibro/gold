@entry 2166e80b039f9516
kind: step
verb: retry
noun: condition
modifier: with_retry
context: aggregate
slot: cond pred
slot: max_retries int
phrase: test aggregate condition {cond} with retry limit {max_retries}
phrase: verify condition {cond} on aggregate allowing {max_retries} retries
test: list=10,20,30 cond=is_even max_retries=2
expect: => i=1 r=0.0 ok=true s="condition passed after retries" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,7,9 cond=is_even max_retries=3
expect: => i=1 r=0.0 ok=true s="condition passed after retries" errors=0 n=3 res=[6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var pass = true;
	for k in g.n {
		if !${cond}(g.res[k]) { pass = false; break; }
	}
	if !pass {
		var attempt = 0;
		while attempt < retries {
			attempt++;
			for k in g.n { g.res[k] += 1; }
			var all_ok = true;
			for k in g.n { if !${cond}(g.res[k]) { all_ok = false; break; } }
			if all_ok { pass = true; break; }
		}
	}
	g.steps += g.n;
	out.ok = pass;
	out.i = if pass { 1 } else { 0 };
	out.s.clear();
	format(out.s, if pass { "condition passed after retries" } else { "condition failed all retries" });
	out
}
@end
