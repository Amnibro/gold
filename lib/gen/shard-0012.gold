code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] < g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n * g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "sorted descending max: ", out.i);
	out
}
@end
