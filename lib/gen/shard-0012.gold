@entry 9f09f529fc7e31b9
kind: step
verb: dedupe
noun: value
modifier: first
context: filter
phrase: dedupe filtered values keeping first occurrence
phrase: retain first seen instance of each filtered value
test: list=10,20,10,30,20,40
expect: => i=4 r=0.0 ok=true s="deduped first occurrences kept: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,1,5,2,1,3
expect: => i=4 r=0.0 ok=true s="deduped first occurrences kept: 4" errors=0 n=4 res=[5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped first occurrences kept: ", kept);
	out
}
@end
@entry cba7c5cac9b3cd8a
kind: step
verb: clamp
noun: maximum
modifier: each
context: filter
slot: cap int
phrase: clamp maximum value of each filtered item to {cap}
phrase: restrict each filtered element to maximum {cap}
test: list=10,50,120,70 cap=60
expect: => i=2 r=0.0 ok=true s="clamped maximum on 2 filtered items" errors=0 n=4 res=[10,50,60,60] cache=0 hits=0
test: list=25,100,75,150 cap=80
expect: => i=2 r=0.0 ok=true s="clamped maximum on 2 filtered items" errors=0 n=4 res=[25,80,75,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let upper = ${cap};
	var modified = 0;
	for i in g.n {
		if g.res[i] > upper {
			g.res[i] = upper;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped maximum on ", modified, " filtered items");
	out
}
@end
@entry 776e6e6d44334251
kind: step
verb: rotate
noun: values
modifier: any
context: filter
slot: shift int
phrase: rotate filtered values by shift amount {shift}
phrase: shift any filtered values by offset {shift}
test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="rotated filtered elements by 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,15,25,35,45 shift=2
expect: => i=2 r=0.0 ok=true s="rotated filtered elements by 2" errors=0 n=5 res=[35,45,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s == 0 {
		g.steps++;
		out.i = 0;
		return out;
	}
	let k = s % g.n;
	var temp = [0; 512];
	for i in g.n {
		let new_pos = (i + k) % g.n;
		temp[new_pos] = g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated filtered elements by ", k);
	out
}
@end
