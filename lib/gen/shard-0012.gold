kind: step
verb: select
noun: average
modifier: at_most
context: filter
phrase: select items at most equal to average
phrase: filter elements no greater than mean value
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="selected 2 items at most average" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35,45
expect: => i=3 r=0.0 ok=true s="selected 3 items at most average" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] <= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * 2;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " items at most average");
	out
}
@end
