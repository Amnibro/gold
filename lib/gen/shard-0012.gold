fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty elements for alternate search");
		out.ok = false;
		return out;
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > th { count++; }
		i += 2;
	}
	if count == 0 {
		gold_fail(g, "no alternate values exceeded threshold");
		out.ok = false;
	}
	g.steps += g.n;
