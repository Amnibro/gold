code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[i];
	}
	var write_idx = 0;
	for i in g.n {
		if tmp[i] % 2 != 0 {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	let odds = write_idx;
	for i in g.n {
		if tmp[i] % 2 == 0 {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	out.i = odds;
	out.s.clear();
	format(out.s, "shifted ", odds, " odds to front recursively");
	out
}
@end
