fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_letter = (c >= 65 as byte && c <= 90 as byte) || (c >= 97 as byte && c <= 122 as byte);
		if is_letter {
			out.s[w] = c;
			w++;
		}
	}
	out.s.resize(w, 0 as byte);
	out.i = w;
	g.steps += out.s.len;
	out
}
@end
