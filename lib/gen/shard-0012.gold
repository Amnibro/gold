fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_budget};
	var run = 0;
	var kept = 0;
	out.s.clear();
	format(out.s, "budget items: [");
	for k in g.n {
		if run + g.res[k] <= limit {
			if kept > 0 { format(out.s, ", "); }
			format(out.s, g.res[k]);
			run += g.res[k];
			kept++;
		}
	}
	format(out.s, "]");
	out.i = run;
	g.steps += g.n;
	out
}
@end
