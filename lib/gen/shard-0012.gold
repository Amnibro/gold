code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		let sq = x * x;
		g.res[k] = if sq > 50 { ${sub}(sq) } else { sq };
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "processed nested squares with subfunction");
	out
}
@end
