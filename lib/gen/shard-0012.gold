@entry b5465248df8819bd
kind: step
verb: rotate
noun: maximum
modifier: at_most
context: list
phrase: rotate elements prefix bounded at most {bound}
phrase: cycle list values bounded at most {bound}
slot: bound int
test: list=10,20,30,40 bound=3
expect: => i=3 r=0.0 ok=true s="rotated prefix of 3 items" errors=0 n=4 res=[30,10,20,40] cache=0 hits=0
test: list=1,2,3,4,5 bound=2
expect: => i=2 r=0.0 ok=true s="rotated prefix of 2 items" errors=0 n=5 res=[2,1,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var k = b;
	if k > g.n {
		k = g.n;
	}
	if k <= 1 {
		return out;
	}
	let last = g.res[k - 1];
	var i = k - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated prefix of ", k, " items");
	out
}
@end
