code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${times};
	if k <= 1 || g.n == 0 {
		return out;
	}
	let orig = g.n;
	var t = 1;
	while t < k {
		var i = 0;
		while i < orig {
			gold_push(g, g.res[i]);
			i++;
		}
		t++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated series to ", g.n, " elements");
	out
}
@end
