test: list=5,10,20 cap=6
expect: => i=1 r=0.0 ok=true s="dropped 1 prefix items within cap" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var sum = 0;
	var drop_count = 0;
	while drop_count < g.n {
		if sum + g.res[drop_count] > cap {
			break;
		}
		sum += g.res[drop_count];
		drop_count++;
	}
	var write_idx = 0;
	for i in drop_count..g.n {
		g.res[write_idx] = g.res[i];
		write_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " prefix items within cap");
	out
}
@end
