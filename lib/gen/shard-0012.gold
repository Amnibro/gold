@entry 159472a690ddd76f
kind: step
verb: search
noun: primes
modifier: up_to
context: aggregate
slot: limit int
phrase: search aggregate primes up to limit {limit}
phrase: locate prime numbers within aggregate up to {limit}
test: list=4,7,11,15,19,20 limit=15
expect: => i=18 r=0.0 ok=true s="found 2 primes up to limit sum: 18" errors=0 n=6 res=[4,7,11,15,19,20] cache=0 hits=0
test: list=2,6,8,13,17,21 limit=20
expect: => i=32 r=0.0 ok=true s="found 3 primes up to limit sum: 32" errors=0 n=6 res=[2,6,8,13,17,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var prime_sum = 0;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				prime_sum += x;
				prime_count++;
			}
		}
	}
	g.steps += g.n * 10;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "found ", prime_count, " primes up to limit sum: ", prime_sum);
	out
}
@end
