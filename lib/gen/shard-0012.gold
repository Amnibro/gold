phrase: verify checkpoint presence for target value {target}
slot: target int
test: list=10,20,30 target=20
expect: => i=20 r=0.0 ok=true s="validated checkpoint 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 target=99
expect: => i=0 r=0.0 ok=false s="validation failed for 99" errors=1 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	for i in g.n {
		if g.res[i] == tgt {
			found = true;
			break;
		}
	}
	if !found {
		gold_fail(g, "target checkpoint not found");
		out.ok = false;
		out.s.clear();
		format(out.s, "validation failed for ", tgt);
		return out;
	}
	g.steps += g.n;
	out.ok = true;
	out.i = tgt;
	out.s.clear();
	format(out.s, "validated checkpoint ", tgt);
	out
}
@end
