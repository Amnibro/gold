expect: => i=3 r=0.0 ok=true s="letter lengths: [3, 3, 5]" errors=0 n=3 res=[3,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur = 0;
	out.s.clear();
	format(out.s, "letter lengths: [");
	var first = true;
	for b in v.s {
		if b == ' ' {
			if cur > 0 {
				gold_push(g, cur);
				if !first { format(out.s, ", "); }
				format(out.s, cur);
				first = false;
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 {
		gold_push(g, cur);
		if !first { format(out.s, ", "); }
		format(out.s, cur);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += v.s.len;
	out
}
@end
