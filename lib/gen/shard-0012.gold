@entry 19b92ec17a552e7b
kind: step
verb: drop
noun: value
modifier: at_most
context: sort
phrase: drop value at most {limit} matching occurrences
phrase: remove sorted matches at most {limit} times {target}
slot: limit int
slot: target int
test: list=1,2,2,2,3 limit=2 target=2
expect: => i=2 r=0.0 ok=true s="dropped 2 occurrences of value" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6 limit=1 target=5
expect: => i=1 r=0.0 ok=true s="dropped 1 occurrences of value" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drop = ${limit};
	let tgt = ${target};
	var dropped = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] == tgt && dropped < max_drop {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " occurrences of value");
	out
}
@end
