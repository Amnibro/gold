	let upper = ${cap};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let result = if min_val > upper { upper } else { min_val };
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "search minimum capped at ", result);
	out
}
@end
