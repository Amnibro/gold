slot: k int
test: list=4,7,11,13 k=3
expect: => i=3 r=0.0 ok=true s="tail primes 3" errors=0 n=4 res=[4,7,11,13] cache=0 hits=0
test: list=2,4,6 k=2
expect: => i=0 r=0.0 ok=true s="tail primes 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let count = ${k};
	var out = v;
	var primes = 0;
	let start = if g.n > count { g.n - count } else { 0 };
	for i in start..g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; }
			d++;
		}
		if is_p { primes++; }
	}
	out.i = primes;
	out.s.clear();
	format(out.s, "tail primes ", primes);
	out
}
@end
