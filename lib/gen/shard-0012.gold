code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	out.s.clear();
	format(out.s, "mapped: [");
	for k in g.n {
		g.res[k] = ${sub}(g.res[k]);
		total += g.res[k];
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = total;
	g.steps += g.n;
	out
}
@end
