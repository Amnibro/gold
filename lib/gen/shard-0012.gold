	let lo = ${low};
	let hi = ${high};
	var valid_pairs = 0;
	var i = 0;
	var kept = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum >= lo && pair_sum <= hi {
			g.res[kept] = pair_sum;
			kept++;
			valid_pairs++;
		}
		i += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = valid_pairs;
	out.s.clear();
	format(out.s, "checked ", valid_pairs, " pairs between bounds");
	out
}
