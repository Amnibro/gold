test: input=16 max_depth=10
expect: => i=1 r=0.0 ok=true s="reduced value recursively in 4 steps" errors=0 n=0 res=[] cache=0 hits=0
test: input=20 max_depth=2
expect: => i=5 r=0.0 ok=false s="reduced value recursively in 2 steps" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let depth = ${max_depth};
	var curr = out.i;
	var steps = 0;
	while curr > 1 && steps < depth {
		if curr % 2 == 0 { curr /= 2; }
		else { curr = curr - 1; }
		steps++;
	}
	if curr > 1 {
		gold_fail(g, "recursive step limit exceeded");
		out.ok = false;
	}
	g.steps += steps;
	out.i = curr;
	out.s.clear();
	format(out.s, "reduced value recursively in ", steps, " steps");
	out
}
@end
