fn ${ID}(g Gold&, v Val) Val {
    let min_k = ${min_len};
    var write_pos = 0;
    var i = 0;
    while i < g.n {
        let val = g.res[i];
        var count = 1;
        while i + 1 < g.n && g.res[i + 1] == val {
            count += 1;
            i += 1;
        }
        if count >= min_k {
            for j in 0..count {
                g.res[write_pos] = val;
                write_pos += 1;
            }
        }
        i += 1;
    }
    g.n = write_pos;
    v.i = write_pos;
    v.ok = write_pos > 0;
    v
}
