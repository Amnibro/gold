@entry 72b09f4fd52e9a25
kind: step
verb: compare
noun: squares
modifier: at_least
context: loop
slot: min_squares int
phrase: compare squares requiring at least match count {min_squares}
phrase: check perfect square count meets at least {min_squares}
test: list=4,9,16,20,25 min_squares=3
expect: => i=4 r=0.0 ok=true s="found squares count 4" errors=0 n=5 res=[4,9,16,20,25] cache=0 hits=0
test: list=2,3,5 min_squares=1
expect: => i=0 r=0.0 ok=true s="found squares count 0" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_squares};
	var squares = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { squares++; }
		}
	}
	let satisfied = squares >= req;
	g.steps += g.n;
	out.i = squares;
	out.s.clear();
	format(out.s, "found squares count ", squares);
	out
}
@end
@entry 980b44f32bad0a8d
kind: step
verb: pair
noun: sequence
modifier: in_reverse
context: math
phrase: compute adjacent pair differences in reverse order
phrase: pairwise differences of sequence taken in reverse
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[10,10] cache=0 hits=0
test: list=5,15,30,50
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diffs int[512] = [0; 512];
	var dc = 0;
	var i = 0;
	while i + 1 < g.n {
		diffs[dc] = g.res[i + 1] - g.res[i];
		dc++;
		i += 2;
	}
	gold_clear(g);
	var k = dc - 1;
	while k >= 0 {
		gold_push(g, diffs[k]);
		k--;
	}
	out.i = dc;
	g.steps += g.n + dc;
	out
}
@end
@entry 74a73a6f453818aa
kind: step
verb: cache
noun: duplicates
modifier: between
context: loop
slot: lo int
slot: hi int
phrase: cache duplicates occurring between loop bounds {lo} to {hi}
phrase: store count of duplicate values between {lo} through {hi}
test: list=5,5,10,10,20 lo=0 hi=3
expect: => i=2 r=0.0 ok=true s="cached duplicates count 2" errors=0 n=5 res=[5,5,10,10,20] cache=1 hits=0
test: list=1,2,3,4 lo=0 hi=3
expect: => i=0 r=0.0 ok=true s="cached duplicates count 0" errors=0 n=4 res=[1,2,3,4] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var dups = 0;
	for i in g.n {
		if i >= l && i <= h {
			for j in (i + 1)..g.n {
				if j <= h && g.res[j] == g.res[i] {
					dups++;
					break;
				}
			}
		}
	}
	gold_cache_put(g, 4, dups);
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "cached duplicates count ", dups);
	out
}
@end
