@entry 3651c5a8293beec2
kind: step
verb: dedupe
noun: budget
modifier: recursively
context: search
phrase: dedupe search results within cost budget {budget}
phrase: prune duplicate queries under cost budget {budget}
slot: budget int
test: list=2,2,3,4,4 budget=6
expect: => i=2 r=0.0 ok=true s="deduped 2 items under budget" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,5,10 budget=15
expect: => i=2 r=0.0 ok=true s="deduped 2 items under budget" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${budget};
	var new_n = 0;
	var cost = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in new_n {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			if cost + x <= budget {
				cost += x;
				g.res[new_n] = x;
				new_n++;
			}
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped ", new_n, " items under budget");
	out
}
@end
@entry 674c19a43ba67c16
kind: step
