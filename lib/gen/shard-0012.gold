fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var bad = 0;
	for i in 0..g.n {
		if g.res[i] >= 0 && g.res[i] <= 9 {
			g.res[w] = g.res[i];
			w++;
		} else {
			gold_fail(g, "multidigit value rejected");
			bad++;
		}
	}
	g.n = w;
	out.i = bad;
	out.ok = (bad == 0);
	out.s.clear();
	format(out.s, "kept single digits ", w);
	out
}
@end
