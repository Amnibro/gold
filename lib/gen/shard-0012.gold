fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop};
	var count = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == stop {
			break;
		}
		if b == 97 || b == 101 || b == 105 || b == 111 || b == 117 ||
		   b == 65 || b == 69 || b == 73 || b == 79 || b == 85 {
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " vowels before stop");
	out
}
@end
