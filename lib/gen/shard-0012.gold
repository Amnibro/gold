expect: => i=2 r=0.0 ok=true s="ranked 2 cached pairs at most difference" errors=0 n=3 res=[5,7,9] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_diff = ${max_diff};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var count = 0;
	if g.cn > 1 {
		for k in g.cn - 1 {
			let diff = g.cv[k + 1] - g.cv[k];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff <= max_diff {
				count++;
			}
		}
	}
	g.steps += g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked ", count, " cached pairs at most difference");
	out
}
@end
