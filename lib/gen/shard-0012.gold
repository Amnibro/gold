@entry e8f6b4704b902cc2
kind: step
verb: fold
noun: step
modifier: between
context: transform
phrase: sum absolute differences between consecutive result items
phrase: fold pairwise distances between adjacent elements
test: list=1,5,2,8
expect: => i=13 r=0.0 ok=true s="pairwise differences 13" errors=0 n=4 res=[1,5,2,8] cache=0 hits=0
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="pairwise differences 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var sum_diff = 0;
	for i in g.n - 1 {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		sum_diff += diff;
	}
	out.i = sum_diff;
	g.steps += g.n - 1;
	out.s.clear();
	format(out.s, "pairwise differences ", sum_diff);
	out
}
@end
