fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	var best_streak = 0;
	var cur_streak = 0;
	for i in g.n {
		if g.res[i] > 0 {
			cur_streak++;
			if cur_streak > best_streak { best_streak = cur_streak; }
		} else {
			cur_streak = 0;
		}
	}
	g.steps += g.n * rep;
	out.i = best_streak;
	out.s.clear();
	format(out.s, "measured streak of ", best_streak, " over ", rep, " times");
	out
}
