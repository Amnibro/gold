code:
fn ${ID}(g Gold&, v Val) Val {
    var ceiling = ${cap};
    let step_down = ${step};
    var total_sum = 0;
    for attempt in 0..3 {
        total_sum = 0;
        for i in 0..g.n {
            if g.res[i] > ceiling {
                g.res[i] = ceiling;
            }
            total_sum += g.res[i];
        }
        if total_sum <= ceiling * 2 || ceiling <= step_down {
            break;
        }
        ceiling -= step_down;
    }
    v.i = total_sum;
    v.ok = total_sum > 0;
    v
}
@end
