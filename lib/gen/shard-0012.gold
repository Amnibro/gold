fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_len};
	var max_streak = 0;
	var curr_streak = 0;
	var last_val = -999999;
	for k in g.n {
		if g.res[k] == last_val {
			curr_streak++;
		} else {
			last_val = g.res[k];
			curr_streak = 1;
		}
		if curr_streak > max_streak {
			max_streak = curr_streak;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	if max_streak < min_len {
		gold_fail(g, "longest streak below required length");
		out.ok = false;
		out.s.clear();
		format(out.s, "streak too short");
	} else {
		out.s.clear();
		format(out.s, "found unique streak of ", max_streak);
	}
	out
}
@end
