@entry 6b5d95405bbfc24b
kind: step
verb: measure
noun: range
modifier: pairwise
context: filter
phrase: measure pairwise range between adjacent values
phrase: filter pairwise distances across list elements
test: list=5,9,14,20
expect: => i=3 r=0.0 ok=true s="measured 3 pairwise ranges" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=3,10,12
expect: => i=2 r=0.0 ok=true s="measured 2 pairwise ranges" errors=0 n=2 res=[7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var ranges = 0;
	for idx in (g.n - 1) {
		var diff = g.res[idx + 1] - g.res[idx];
		if diff < 0 { diff = -diff; }
		g.res[idx] = diff;
		ranges++;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = ranges;
	out.s.clear();
	format(out.s, "measured ", ranges, " pairwise ranges");
	out
}
@end
