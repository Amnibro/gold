fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var below = 0;
	for i in g.n {
		if g.res[i] < avg { below++; }
	}
	g.steps += g.n;
	out.i = below;
	out.s.clear();
	format(out.s, "found ", below, " sorted items below average");
	out
}
@end
