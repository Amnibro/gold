fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${total_budget};
	var remaining = b;
	for i in g.n {
		let take = if remaining > g.res[i] { g.res[i] } else { remaining };
		g.res[i] = take;
		remaining -= take;
	}
	g.steps += g.n;
	out.i = remaining;
	out.s.clear();
	format(out.s, "budget mapped remainder: ", remaining);
	out
}
@end
