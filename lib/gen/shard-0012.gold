fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_so_far = g.res[0];
	var peaks = 0;
	for q in g.n {
		if g.res[q] >= max_so_far {
			max_so_far = g.res[q];
			peaks++;
		} else {
			g.res[q] = max_so_far - g.res[q];
		}
	}
	g.steps += g.n;
	out.i = peaks;
	out.s.clear();
	format(out.s, "split at ", peaks, " running peaks");
	out
}
@end
