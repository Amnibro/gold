fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_chars};
	gold_clear(g);
	var w_len = 0;
	var qualified = 0;
	for c_idx in out.s.len {
		let ch = out.s[c_idx];
		if ch == ' ' || ch == '	' || ch == '
' {
			if w_len >= mc {
				gold_push(g, w_len);
				qualified++;
			}
			w_len = 0;
		} else {
			w_len++;
		}
	}
	if w_len >= mc {
		gold_push(g, w_len);
		qualified++;
	}
	g.steps += out.s.len;
	out.i = qualified;
	out.s.clear();
	format(out.s, "split ", qualified, " words of length at least ", mc);
	out
}
@end
