fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${limit};
	var tally = 0;
	var attempt = 0;
	while attempt < max_r {
		tally = 0;
		for pos in g.n {
			if g.res[pos] > attempt { tally++; }
		}
		attempt++;
	}
	gold_push(g, tally);
	g.steps += g.n * attempt;
	out.i = tally;
	out.s.clear();
	format(out.s, "found tally ", tally, " with retries");
	out
}
@end
