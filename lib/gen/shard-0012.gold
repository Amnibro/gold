@entry 6f4f41a7a133a1be
kind: step
verb: check
noun: squares
modifier: at_most
context: list
slot: max_count int
phrase: check square numbers appear at most {max_count} times in list
phrase: verify at most {max_count} perfect squares in results
test: list=4,9,16,20 max_count=2
expect: => i=3 r=0.0 ok=false s="square count found: 3" errors=0 n=4 res=[4,9,16,20] cache=0 hits=0
test: list=1,2,3,4 max_count=2
expect: => i=2 r=0.0 ok=true s="square count found: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_count};
	var sq_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq_count++; }
		}
	}
	g.steps += g.n;
	out.ok = sq_count <= limit;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "square count found: ", sq_count);
	out
}
@end
@entry bf18e64aa9e1771e
kind: step
verb: reverse
noun: threshold
modifier: at_most
context: list
slot: cutoff int
phrase: reverse elements of list that are at most {cutoff}
phrase: invert order of items in list having at most value {cutoff}
test: list=15,4,2,8,25 cutoff=10
expect: => i=3 r=0.0 ok=true s="reversed items under threshold: 3" errors=0 n=5 res=[15,8,2,4,25] cache=0 hits=0
test: list=1,12,3,14,5 cutoff=10
expect: => i=3 r=0.0 ok=true s="reversed items under threshold: 3" errors=0 n=5 res=[5,12,3,14,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cutoff};
	var indices = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] <= lim {
			indices[count] = i;
			count++;
		}
	}
	var left = 0;
	var right = count - 1;
	while left < right {
		let li = indices[left];
		let ri = indices[right];
		let tmp = g.res[li];
		g.res[li] = g.res[ri];
		g.res[ri] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed items under threshold: ", count);
	out
}
@end
