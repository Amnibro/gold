code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var uniq int[512] = [0; 512];
	for i in g.n {
		let val = g.res[i];
		var exists = false;
		for j in unique_count {
			if uniq[j] == val { exists = true; }
		}
		if !exists {
			uniq[unique_count] = val;
			unique_count++;
		}
	}
	g.n = unique_count;
	for i in unique_count {
		g.res[i] = uniq[i];
	}
	g.steps += g.n + 1;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "grouped unique loop elements ", unique_count);
	out
}
@end
