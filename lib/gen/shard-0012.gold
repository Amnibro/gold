@entry 152c7cc2c38cfce2
kind: step
verb: swap
noun: average
modifier: sorted
context: aggregate
phrase: partition aggregate by swapping elements around sorted average
phrase: swap aggregate values into sorted order relative to average
test: list=10,2,30,4,50
expect: => i=19 r=0.0 ok=true s="partitioned around average 19" errors=0 n=5 res=[10,2,4,30,50] cache=0 hits=0
test: list=20,5,40,10
expect: => i=18 r=0.0 ok=true s="partitioned around average 18" errors=0 n=4 res=[10,5,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < j && g.res[i] <= avg { i++; }
		while i < j && g.res[j] > avg { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "partitioned around average ", avg);
	out
}
@end
