@entry 8b7b7aaa61ec8943
kind: step
verb: check
noun: average
modifier: with_retry
context: loop
phrase: check average with retry adjustments in loop
phrase: verify average with retry scaling across loop
slot: target int
test: list=2,4,6 target=10
expect: => i=3 r=0.0 ok=true s="adjusted average in 3 retries" errors=0 n=3 res=[8,10,12] cache=0 hits=0
test: list=1,3,5 target=8
expect: => i=3 r=0.0 ok=true s="adjusted average in 3 retries" errors=0 n=3 res=[7,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_avg = ${target};
	if g.n == 0 { return out; }
	var retries = 0;
	while retries < 10 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		if avg >= min_avg { break; }
		for i in g.n { g.res[i] = g.res[i] + 2; }
		retries++;
	}
	g.steps += retries * g.n;
	out.i = retries;
	out.s.clear();
	format(out.s, "adjusted average in ", retries, " retries");
	out
}
@end
