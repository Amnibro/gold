code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if s <= 0 || s * 2 > g.n { return out; }
	for i in s {
		let tmp = g.res[i];
		let other = g.n - s + i;
		g.res[i] = g.res[other];
		g.res[other] = tmp;
	}
	g.steps += s;
	out.i = s;
	out.s.clear();
	format(out.s, "safely swapped span of ", s, " items");
	out
}
@end
