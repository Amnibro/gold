fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var kept = 0;
	for i in g.n {
		let val = g.res[i] * mult;
		if kept == 0 || g.res[kept - 1] != val {
			g.res[kept] = val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped scaled checkpoints: ", kept);
	out
}
@end
@entry 6a0cda4a3840355d
kind: step
