fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_valid = true;
	if g.n > 1 {
		for k in g.n - 1 {
			let a = ${f}(g.res[k]);
			let b = ${f}(g.res[k + 1]);
			if a > b {
				is_valid = false;
				break;
			}
		}
	}
	g.steps += g.n;
	if is_valid {
		out.i = g.n;
		out.s.clear();
		format(out.s, "pairwise subfunction verified");
	} else {
		gold_fail(g, "pairwise subfunction order violated");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "subfunction pair error");
	}
	out
}
@end
