fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	if len > 1 {
		let first = out.s[0];
		for k in len - 1 {
			out.s[k] = out.s[k + 1];
		}
		out.s[len - 1] = first;
	}
	g.steps += len;
	out.i = len;
	out
}
