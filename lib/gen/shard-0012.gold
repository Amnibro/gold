	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "sorted ", g.n, " counters safely");
	out
}
@end
