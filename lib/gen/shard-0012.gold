code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var swapped = true;
	var passes = 0;
	while swapped {
		swapped = false;
		var s_pos = 0;
		while s_pos + 1 < g.n {
			if g.res[s_pos] > g.res[s_pos + 1] {
				let tmp = g.res[s_pos];
				g.res[s_pos] = g.res[s_pos + 1];
				g.res[s_pos + 1] = tmp;
				swapped = true;
			}
			s_pos++;
		}
		passes++;
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "sorted sequence in ", passes, " passes");
	out
}
@end
