fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if out.i > 0 { out.i } else { 5 };
	var count = 0;
	for k in out.s.len {
		let b = out.s[k];
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			count++;
			if count >= limit { break; }
		}
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "letters up to limit ", count);
	out
}
