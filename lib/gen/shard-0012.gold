		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] { is_sorted = false; break; }
			sorted_count++;
		}
	}
	out.ok = is_sorted;
	out.i = sorted_count;
	out.s.clear();
	format(out.s, if is_sorted { "series sorted" } else { "series unsorted" });
	g.steps += g.n;
	out
}
