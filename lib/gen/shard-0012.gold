code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 || g.n == 0 {
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var k = 0;
		while k < cap && i < g.n {
			sum += g.res[i];
			i++;
			k++;
		}
		g.res[new_n] = sum;
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped numbers into ", new_n, " buckets");
	out
}
@end
