fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var new_n = g.n - 1;
	for i in new_n {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[i] = if a > b { a } else { b };
	}
	g.n = new_n;
	g.steps += new_n;
	out.s.clear();
	format(out.s, "pairwise maximum");
	out
}
