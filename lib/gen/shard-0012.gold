code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	for pass in g.n {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted with ", swaps, " pair swaps");
	out
}
