@entry 723549f2e9c81a90
kind: step
verb: limit
noun: items
modifier: unique
context: math
phrase: limit list to first {limit} unique elements
phrase: retain at most {limit} unique items in results
slot: limit int
test: list=1,2,2,3,1,4 limit=2
expect: => i=2 r=0.0 ok=true s="limited to 2 unique items" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,5,6,7,7 limit=3
expect: => i=3 r=0.0 ok=true s="limited to 3 unique items" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	if limit <= 0 || g.n == 0 {
		g.n = 0;
		return out;
	}
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[write_idx] = val;
			write_idx++;
			if write_idx >= limit {
				break;
			}
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "limited to ", write_idx, " unique items");
	out
}
@end
