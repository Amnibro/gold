fn ${ID}(g Gold&, v Val) Val {
    let max_freq = ${frequency};
    var matching_bins = 0;
    for i in 0..g.n {
        let val = g.res[i];
        var first_seen = true;
        for j in 0..i {
            if g.res[j] == val { first_seen = false; break; }
        }
        if first_seen {
            var count = 0;
            for j in 0..g.n {
                if g.res[j] == val { count += 1; }
            }
            if count <= max_freq {
                matching_bins += 1;
            }
        }
    }
    gold_push(g, matching_bins);
    v.i = matching_bins;
    v.ok = matching_bins > 0;
    v
}
