code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	for i in min_idx..g.n - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "dropped minimum value ", min_val);
	out
}
@end
@entry 43137c22f7ac3b5b
kind: step
verb: normalize
noun: pairs
modifier: between
context: list
phrase: clamp adjacent differences between bounds {lo} {hi}
phrase: bound pairwise item changes within range {lo} {hi}
slot: lo int
slot: hi int
test: list=1,10,20 lo=2 hi=5
expect: => i=3 r=0.0 ok=true s="normalized pairs between bounds length 3" errors=0 n=3 res=[1,6,11] cache=0 hits=0
test: list=5,25,30 lo=3 hi=8
expect: => i=3 r=0.0 ok=true s="normalized pairs between bounds length 3" errors=0 n=3 res=[5,13,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if g.n <= 1 {
		return out;
	}
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < lo {
			diff = lo;
		} else if diff > hi {
			diff = hi;
		}
		g.res[i] = g.res[i - 1] + diff;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized pairs between bounds length ", g.n);
	out
}
@end
