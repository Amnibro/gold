code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	var prime_pairs = 0;
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		if a > 1 && b > 1 {
			prime_pairs++;
		}
	}
	g.steps += pairs;
	out.i = prime_pairs;
	out.s.clear();
	format(out.s, "checked ", pairs, " pairs, found ", prime_pairs, " prime candidates");
	out
}
@end
@entry 7a17d8544a5c97c5
kind: step
