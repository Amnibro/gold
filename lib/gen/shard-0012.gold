@entry 7db78cf834ea8a25
kind: step
verb: merge
noun: text
modifier: up_to
context: format
slot: max_words int
phrase: format text words merged up to count {max_words}
phrase: display merged words bounded up to {max_words} items
test: text="one two three four" max_words=2
expect: => i=2 r=0.0 ok=true s="one-two" errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha beta gamma delta" max_words=3
expect: => i=3 r=0.0 ok=true s="alpha-beta-gamma" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_words};
	var words = 0;
	out.s.clear();
	var cur byte[>..] = [];
	for b in v.s {
		if b == ' ' {
			if cur.len > 0 {
				if words > 0 { out.s.push('-'); }
				out.s.append(cur);
				words++;
				cur.clear();
				if words >= lim { break; }
			}
		} else {
			cur.push(b);
		}
	}
	if cur.len > 0 && words < lim {
		if words > 0 { out.s.push('-'); }
		out.s.append(cur);
		words++;
	}
	out.i = words;
	g.steps += v.s.len;
	out
}
@end
