	let goal = ${target};
	var sum = 0;
	var found = false;
	var idx = -1;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		if sum == goal {
			found = true;
			idx = i;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.ok = found;
	out.i = idx;
	out.s.clear();
	if found {
		format(out.s, "total reached at index");
	} else {
		format(out.s, "none reached target total");
	}
	out
}
@end
