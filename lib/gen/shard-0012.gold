code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var min_val = out.i;
	let lim = if b < g.n { b } else { g.n };
	for idx in lim {
		if g.res[idx] < min_val {
			min_val = g.res[idx];
		}
	}
	gold_cache_put(g, 10, min_val);
	g.steps += lim + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum loop value up to bound is ", min_val);
	out
}
@end
