fn ${ID}(g Gold&, v Val) Val {
	let m = ${max_len};
	var out = v;
	let k = if g.n < m { g.n } else { m };
	for i in 0..k / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[k - 1 - i];
		g.res[k - 1 - i] = tmp;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "range reversed ", k);
	out
}
