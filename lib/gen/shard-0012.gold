fn ${ID}(g Gold&, v Val) Val {
    let lim = ${target};
    var steps_checked = 0;
    if g.n > 1 {
        for idx in 1..g.n {
            steps_checked += 1;
            let diff = g.res[idx] - g.res[idx - 1];
            if diff >= lim { break; }
        }
    }
    gold_push(g, steps_checked);
    v.i = steps_checked;
    v.ok = steps_checked > 0;
    v
}
