@entry 600bd3401e32ceb2
kind: step
verb: search
noun: pairs
modifier: while
context: error
phrase: search adjacent pairs while difference within limit {limit}
phrase: scan consecutive pairs while condition holds catching jump errors
slot: limit int
test: list=10,12,14 limit=3
expect: => i=2 r=0.0 ok=true s="scanned 2 pairs within limit" errors=0 n=3 res=[10,12,14] cache=0 hits=0
test: list=10,15,16 limit=3
expect: => i=0 r=0.0 ok=false s="pair jump error" errors=1 n=3 res=[10,15,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var valid_pairs = 0;
	var has_err = false;
	if g.n > 1 {
		for k in g.n - 1 {
			let diff = g.res[k + 1] - g.res[k];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff > limit {
				has_err = true;
				break;
			}
			valid_pairs++;
		}
	}
	g.steps += g.n;
	if has_err {
		gold_fail(g, "pair difference exceeded limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "pair jump error");
	} else {
		out.i = valid_pairs;
		out.s.clear();
		format(out.s, "scanned ", valid_pairs, " pairs within limit");
	}
	out
}
@end
