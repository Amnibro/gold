test: text="hello   world  braid"
expect: => i=3 r=0.0 ok=true s="hello world braid" errors=0 n=0 res=[] cache=1 hits=0
test: text="helium   gold   cache   transform"
expect: => i=4 r=0.0 ok=true s="helium gold cache transform" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var compacted byte[..200] = "";
	var in_space = false;
	var word_count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if !in_space {
				compacted.push(' ');
				in_space = true;
			}
		} else {
			if in_space || compacted.len == 0 { word_count++; }
			compacted.push(c);
			in_space = false;
		}
	}
	out.s = compacted;
	gold_cache_put(g, word_count, compacted.len);
	g.steps += out.s.len;
	out.i = word_count;
	out
}
@end
