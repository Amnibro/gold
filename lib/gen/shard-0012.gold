test: list=2,2,4,4,5 p=is_even
expect: => i=2 r=0.0 ok=true s="duplicates while: [2, 4]" errors=0 n=5 res=[2,2,4,4,5] cache=0 hits=0
test: list=3,3,7,7,2 p=is_odd
expect: => i=2 r=0.0 ok=true s="duplicates while: [3, 7]" errors=0 n=5 res=[3,3,7,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	out.s.clear();
	format(out.s, "duplicates while: [");
	var first = true;
	for i in g.n {
		if !${p}(g.res[i]) { break; }
		for j in i + 1..g.n {
			if g.res[j] == g.res[i] {
				if !first { format(out.s, ", "); }
				format(out.s, g.res[i]);
				first = false;
				dups++;
				break;
			}
		}
	}
	format(out.s, "]");
	out.i = dups;
	g.steps += g.n * g.n;
	out
}
@end
@entry 4a8b4ccbea04bd75
kind: step
verb: keep
noun: counter
modifier: sorted
context: format
phrase: format item frequencies keeping sorted occurrence counter
phrase: display frequency counter values in sorted order
test: list=3,1,3,2,1,3
expect: => i=3 r=0.0 ok=true s="sorted counts: [2:1, 1:2, 3:3]" errors=0 n=6 res=[3,1,3,2,1,3] cache=0 hits=0
test: list=5,5,10,10,10
expect: => i=2 r=0.0 ok=true s="sorted counts: [5:2, 10:3]" errors=0 n=5 res=[5,5,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	var vals int[512] = [0; 512];
	var freqs int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for u in unique { if vals[u] == x { idx = u; break; } }
		if idx >= 0 { freqs[idx] += 1; }
		else {
			vals[unique] = x;
			freqs[unique] = 1;
			unique++;
		}
	}
	for i in unique {
		for j in i + 1..unique {
			if freqs[j] < freqs[i] {
				let tf = freqs[i]; freqs[i] = freqs[j]; freqs[j] = tf;
				let tv = vals[i]; vals[i] = vals[j]; vals[j] = tv;
			}
		}
	}
	out.s.clear();
	format(out.s, "sorted counts: [");
	for u in unique {
		if u > 0 { format(out.s, ", "); }
		format(out.s, vals[u], ":", freqs[u]);
	}
	format(out.s, "]");
	out.i = unique;
	g.steps += g.n * g.n;
	out
}
@end
