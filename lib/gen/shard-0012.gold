test: list=5,10,15
expect: => i=10 r=0.0 ok=true s="nested spread 10" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_v = g.res[0];
	var max_v = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_v { min_v = g.res[i]; }
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	let spread = max_v - min_v;
	if spread > 50 {
		gold_fail(g, "excessive nested spread");
	}
	out.i = spread;
	out.s.clear();
	format(out.s, "nested spread ", spread);
	out
}
@end
