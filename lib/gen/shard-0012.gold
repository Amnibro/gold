fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = val;
		} else {
			gold_cache_put(g, k, k * 2);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied memo lookups to ", g.n, " items");
