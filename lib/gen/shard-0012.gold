fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			v_count++;
		}
	}
	gold_push(g, v_count);
	g.steps += out.s.len;
	out.i = v_count;
	out.s.clear();
	format(out.s, "clamped sorted vowel count: ", v_count);
	out
}
