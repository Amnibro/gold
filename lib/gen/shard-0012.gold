code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot clamp empty list in reverse");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list error");
		return out;
	}
	var clamped = 0;
	var k = g.n - 1;
	while k >= 0 {
		if ${p}(g.res[k]) {
			g.res[k] = 0;
			clamped++;
		}
		k--;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " condition matches in reverse");
	out
}
@end
