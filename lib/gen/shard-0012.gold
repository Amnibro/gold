fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var d = 0;
		while x > 0 { d++; x /= 10; }
		if d == 0 { d = 1; }
		total_digits += d;
	}
	out.i = total_digits;
	g.steps += g.n;
	out
}
