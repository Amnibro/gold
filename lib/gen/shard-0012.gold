@entry 2b3d90d07a1926d8
kind: step
verb: clamp
noun: maximum
modifier: unique
context: text
phrase: clamp text keeping only unique characters up to maximum {max_chars}
phrase: restrict text to unique characters capped at maximum {max_chars}
slot: max_chars int
test: text="banana" max_chars=2
expect: => i=2 r=0.0 ok=true s="ba" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" max_chars=3
expect: => i=3 r=0.0 ok=true s="mis" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_chars = ${max_chars};
	if out.s.len == 0 || max_chars <= 0 {
		out.s.clear();
		out.i = 0;
		return out;
	}
	var write_idx = 0;
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in write_idx {
			if out.s[j] == c {
				seen = true;
				break;
			}
		}
		if !seen {
			out.s[write_idx] = c;
			write_idx++;
			if write_idx >= max_chars {
				break;
			}
		}
	}
	out.s.resize(write_idx, 0 as byte);
	g.steps += out.s.len;
	out.i = write_idx;
	out
}
@end
