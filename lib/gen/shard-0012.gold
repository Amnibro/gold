fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var m = k;
	if m > g.n {
		m = g.n;
	}
	var i = 0;
	while i < m {
		var j = i + 1;
		while j < m {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if m > 0 {
		gold_cache_put(g, 1, g.res[0]);
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted head of ", m, " items");
	out
}
