@entry 30eae782f14b6ba0
kind: step
verb: search
noun: window
modifier: none
context: text
phrase: search window for duplicate characters of size {size}
phrase: check sliding window has no duplicates {size}
slot: size int
test: text="abcdef" size=3
expect: => i=0 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
test: text="aabc" size=3
expect: => i=1 r=0.0 ok=false s="aabc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${size};
	var has_dup = false;
	var i = 0;
	while i + k <= out.s.len {
		var a = i;
		while a < i + k {
			var b = a + 1;
			while b < i + k {
				if out.s[a] == out.s[b] {
					has_dup = true;
					break;
				}
				b++;
			}
			if has_dup { break; }
			a++;
		}
		if has_dup { break; }
		i++;
	}
	g.steps += out.s.len;
	out.ok = !has_dup;
	if has_dup {
		out.i = 1;
	} else {
		out.i = 0;
	}
	out
}
@end
