		if !swapped && g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped = true;
		}
	}
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "item swapped in place ", out.i);
	out
}
@end
