@entry d86cf26b57cdb56d
kind: step
verb: rank
noun: condition
modifier: all
context: cache
phrase: rank all cached entries satisfying condition {p}
phrase: partition cache by rule {p} placing matches first
slot: p pred
test: list=1,2,3,4 p=is_even
expect: => i=2 r=0.0 ok=true s="ranked 2 condition matches" errors=0 n=4 res=[2,4,1,3] cache=4 hits=0
test: list=10,20,30 p=is_odd
expect: => i=0 r=0.0 ok=true s="ranked 0 condition matches" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches int[512] = [0; 512];
	var non_matches int[512] = [0; 512];
	var m_count = 0;
	var nm_count = 0;
	for k in g.n {
		let x = g.res[k];
		if ${p}(x) {
			matches[m_count] = x;
			m_count++;
		} else {
			non_matches[nm_count] = x;
			nm_count++;
		}
	}
	for k in m_count {
		g.res[k] = matches[k];
	}
	for k in nm_count {
		g.res[m_count + k] = non_matches[k];
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = m_count;
	out.s.clear();
	format(out.s, "ranked ", m_count, " condition matches");
	out
}
@end
