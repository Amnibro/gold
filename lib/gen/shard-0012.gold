code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			let tmp = g.res[i];
			var j = i;
			while j > evens {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[evens] = tmp;
			evens++;
		}
	}
	g.steps += g.n;
	out.i = evens;
	out.s.clear();
	format(out.s, "partitioned ", evens, " evens to front");
	out
}
@end
