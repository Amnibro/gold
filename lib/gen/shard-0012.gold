code:
fn ${ID}(g Gold&, v Val) Val {
	let th = ${threshold};
	var out = v;
	var running = 0;
	var breaches = 0;
	for i in 0..g.n {
		running += g.res[i];
		if running > th {
			breaches++;
			gold_fail(g, "running threshold breached");
		}
	}
	out.i = breaches;
	out.ok = (breaches == 0);
	out.s.clear();
	format(out.s, "threshold breaches ", breaches);
	out
}
@end
