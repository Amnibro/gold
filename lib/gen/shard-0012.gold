@entry 7c6f98225aed699a
kind: step
verb: fill
noun: minimum
modifier: unique
context: core
phrase: fill results with smallest {count} unique elements
phrase: extract lowest {count} unique values into results
slot: count int
test: list=5,2,8,2,9,5 count=2
expect: => i=2 r=0.0 ok=true s="filled 2 smallest unique elements" errors=0 n=2 res=[2,5] cache=0 hits=0
test: list=10,40,20,30 count=3
expect: => i=3 r=0.0 ok=true s="filled 3 smallest unique elements" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if g.n == 0 || count <= 0 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	var u = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in u {
			if tmp[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			tmp[u] = val;
			u++;
		}
	}
	for i in u {
		for j in u - 1 - i {
			if tmp[j] > tmp[j + 1] {
				let t = tmp[j];
				tmp[j] = tmp[j + 1];
				tmp[j + 1] = t;
			}
		}
	}
	let keep = if count < u { count } else { u };
	gold_clear(g);
	for k in keep {
		gold_push(g, tmp[k]);
	}
	g.steps += keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "filled ", keep, " smallest unique elements");
	out
}
@end
