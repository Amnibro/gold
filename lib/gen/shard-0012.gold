fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < out.s.len {
		let b = out.s[idx];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' { idx++; }
		else { break; }
	}
	var kept byte[..200] = "";
	while idx < out.s.len {
		if kept.len < 200 { kept.push(out.s[idx]); }
		idx++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in kept { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
