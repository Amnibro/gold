code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let last = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated total across all items");
	out
}
@end
