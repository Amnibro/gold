expect: 1
code:
fn ${ID}(n int) int {
	if n <= 0 {
		return 0;
	}
	if n == 1 {
		return 1;
	}
	var a = 1;
	var b = 1;
	var index = 2;
	while b <= n {
		let next = a + b;
		a = b;
		b = next;
		index = index + 1;
	}
	return index - 1;
}
@end
