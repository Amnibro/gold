fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errors_found = 0;
	for i in g.n {
		let idx = g.n - 1 - i;
		if g.res[idx] < 0 {
			gold_fail(g, "negative sorted value error");
			errors_found++;
		}
	}
	g.steps += g.n;
	out.i = errors_found;
	out.s.clear();
	format(out.s, "detected ", errors_found, " negative sorted errors");
	out
}
@end
