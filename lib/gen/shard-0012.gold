fn ${ID}(g Gold&, v Val) Val {
    let csize = ${chunk_size};
    var write_idx = 0;
    if csize > 0 && g.n > 0 {
        var i = 0;
        while i < g.n {
            var chunk_sum = 0;
            var j = 0;
            while j < csize && (i + j) < g.n {
                chunk_sum += g.res[i + j];
                j += 1;
            }
            g.res[write_idx] = chunk_sum;
            write_idx += 1;
            i += csize;
        }
        g.n = write_idx;
    }
    v.i = g.n;
    v.ok = g.n > 0;
    v
}
