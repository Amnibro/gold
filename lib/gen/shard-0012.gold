kind: step
verb: shift
noun: items
modifier: unique
context: error
phrase: shift unique error items to front of results
phrase: move distinct error items into unique prefix
test: list=2,3,2,5,3
expect: => i=3 r=0.0 ok=true s="shifted unique items count 3" errors=1 n=5 res=[2,3,5,2,3] cache=0 hits=0
test: list=7,8,9
expect: => i=3 r=0.0 ok=true s="shifted unique items count 3" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for unique items shift");
		out.ok = false;
		return out;
	}
	var u = 0;
	var dups = 0;
	for i in g.n {
		var found = false;
		for j in u {
			if g.res[j] == g.res[i] { found = true; break; }
		}
		if !found {
			let tmp = g.res[u];
			g.res[u] = g.res[i];
			g.res[i] = tmp;
			u++;
		} else {
			dups++;
		}
	}
	if dups > 0 {
		gold_fail(g, "duplicate items encountered during shift");
	}
	g.steps += g.n;
	out.i = u;
	out.s.clear();
	format(out.s, "shifted unique items count ", u);
	out
}
@end
