code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var count = 0;
	while count < g.n && ${ID}_is_prime(g.res[0]) {
		let first = g.res[0];
		for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated primes while count ", count);
	out
}
@end
