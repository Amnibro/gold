kind: step
verb: dedupe
noun: odds
modifier: nested
context: transform
phrase: remove all duplicate odd values from results collection
phrase: dedupe odd numbered elements in transformed results
test: list=1,3,1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="deduped odds" errors=0 n=5 res=[1,3,2,4,5] cache=0 hits=0
test: list=7,7,7,8
expect: => i=0 r=0.0 ok=true s="deduped odds" errors=0 n=2 res=[7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen_odd int[..32] = [];
	var new_n = 0;
	for i in g.n {
		let val = g.res[i];
		if val % 2 != 0 {
			var found = false;
			for j in seen_odd.len {
				if seen_odd[j] == val { found = true; break; }
			}
			if !found {
				seen_odd.push(val);
				g.res[new_n] = val;
				new_n++;
			}
		} else {
			g.res[new_n] = val;
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "deduped odds");
	out
}
@end
