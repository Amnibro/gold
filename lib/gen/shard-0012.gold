@entry 962af4f7b37e0eee
kind: step
verb: select
noun: average
modifier: with_cache
context: aggregate
phrase: select items exceeding average storing average in cache
phrase: filter elements above aggregate average using cache memo
test: list=10,20,30,40,50
expect: => i=30 r=0.0 ok=true s="selected 2 elements above average 30" errors=0 n=2 res=[40,50] cache=1 hits=0
test: list=2,4,6,8,20
expect: => i=8 r=0.0 ok=true s="selected 1 elements above average 8" errors=0 n=1 res=[20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	gold_cache_put(g, 0, avg);
	var kept = 0;
	for k in g.n {
		if g.res[k] > avg {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = avg;
	out.s.clear();
	format(out.s, "selected ", kept, " elements above average ", avg);
	out
}
@end
