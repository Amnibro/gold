expect: => i=2 r=0.0 ok=true s="grouped alternating suffix of 2 items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	var actual = if count > g.n { g.n } else { count };
	var start = g.n - actual;
	var tmp: int[512] = [0; 512];
	for i in actual {
		tmp[i] = g.res[start + i];
	}
	var write_idx = start;
	var i = 0;
	while i < actual {
		g.res[write_idx] = tmp[i];
		write_idx++;
		i += 2;
	}
	var j = 1;
	while j < actual {
		g.res[write_idx] = tmp[j];
		write_idx++;
		j += 2;
	}
	g.steps += actual;
	out.i = actual;
	out.s.clear();
	format(out.s, "grouped alternating suffix of ", actual, " items");
	out
}
@end
