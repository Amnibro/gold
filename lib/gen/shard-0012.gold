expect: => i=3 r=0.0 ok=true s="parsed words count 3" errors=0 n=0 res=[] cache=0 hits=0
test: text="bad? err!"
expect: => i=2 r=0.0 ok=false s="parsed words count 2" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var words = 0;
	var has_error = false;
	var in_word = false;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if in_word { words++; in_word = false; }
		} else {
			if b == '!' || b == '?' { has_error = true; }
			in_word = true;
		}
	}
	if in_word { words++; }
	if has_error {
		gold_fail(g, "word string contains error token");
		out.ok = false;
	}
	g.steps += out.s.len + 1;
	out.i = words;
	out.s.clear();
	format(out.s, "parsed words count ", words);
	out
}
@end
