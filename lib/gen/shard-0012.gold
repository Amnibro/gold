	var i = 0;
	var j = bound - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.s.clear();
	format(out.s, "reversed up to limit: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = bound;
	g.steps += bound;
