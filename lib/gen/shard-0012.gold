kind: step
verb: search
noun: squares
modifier: in_reverse
context: error
phrase: search square roots in reverse order
phrase: locate perfect squares backwards catching non square errors
test: list=9,16,25
expect: => i=3 r=0.0 ok=true s="found 3 squares in reverse" errors=0 n=3 res=[9,16,25] cache=0 hits=0
test: list=9,10
expect: => i=0 r=0.0 ok=false s="non square error" errors=1 n=2 res=[9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var has_err = false;
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		if x < 0 { has_err = true; break; }
		var r = 0;
		while r * r < x { r++; }
		if r * r != x { has_err = true; break; }
		count++;
		k--;
	}
	g.steps += g.n;
	if has_err {
		gold_fail(g, "non square element detected");
		out.ok = false;
		out.i = 0;
		out.s.clear();
