kind: step
verb: retry
noun: history
modifier: with_retry
context: list
slot: max_steps int
phrase: retry history updates with retry limit {max_steps} on list
phrase: replay history adjustments on results up to {max_steps} retries
test: list=1,2,3 max_steps=2
expect: => i=2 r=0.0 ok=true s="retried history adjustments: 2" errors=0 n=3 res=[3,4,5] cache=0 hits=0
