kind: step
verb: run
noun: digits
modifier: any
context: search
phrase: run digits any search match for {target_digit}
phrase: check any item contains target digit {target_digit}
slot: target_digit int
test: list=14,25,37 target_digit=5
expect: => i=0 r=0.0 ok=true s="digit search found target" errors=0 n=3 res=[14,25,37] cache=0 hits=0
test: list=10,20,30 target_digit=9
expect: => i=0 r=0.0 ok=false s="digit search missed target" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_digit};
	var found = false;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while x > 0 {
			if x % 10 == tgt { found = true; break; }
			x /= 10;
		}
		if found { break; }
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	format(out.s, "digit search ", if found { "found" } else { "missed" }, " target");
	out
}
@end
