	if neg_count > 0 {
		gold_fail(g, "negative errors found in sorted sequence");
		out.ok = false;
	}
	g.steps += g.n * g.n;
	out.i = neg_count;
	out.s.clear();
	format(out.s, "sorted counter negative count ", neg_count);
	out
}
