code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_odds};
	if g.n == 0 {
		gold_fail(g, "empty elements for collecting odd errors");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			gold_push(g, g.res[i]);
			count++;
			if count >= limit { break; }
		}
	}
	if count == 0 {
		gold_fail(g, "no odd error codes found");
		out.ok = false;
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected odd error items ", count);
	out
}
@end
