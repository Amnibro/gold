code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_diff = 0;
	var last_odd = -1;
	for i in 0..g.n {
		if g.res[i] % 2 != 0 {
			if last_odd >= 0 {
				var diff = g.res[i] - last_odd;
				if diff < 0 { diff = -diff; }
				if diff > max_diff { max_diff = diff; }
			}
			last_odd = g.res[i];
		}
	}
	gold_cache_put(g, 21, max_diff);
	out.i = max_diff;
	out.s.clear();
	format(out.s, "odd max diff ", max_diff);
	out
}
@end
