	var count = 0;
	while i + 1 < v.s.len {
		if count > 0 { format(out.s, ", "); }
		out.s.push(v.s[i]);
		out.s.push(v.s[i + 1]);
		count++;
		i += 2;
	}
	format(out.s, "]");
	out.i = count;
	g.steps += v.s.len;
