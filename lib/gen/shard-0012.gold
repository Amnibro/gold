code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " results in range");
	out
}
@end
