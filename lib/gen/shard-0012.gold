phrase: advance sliding window at least {min_shift} steps
slot: min_shift int
test: list=1,2,3,4,5 min_shift=2
expect: => i=2 r=0.0 ok=true s="shifted window by 2 at least positions" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30,40 min_shift=3
expect: => i=3 r=0.0 ok=true s="shifted window by 3 at least positions" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${min_shift};
	if s < 1 { s = 1; }
	if g.n <= 1 { return out; }
	let eff = s % g.n;
	for step in eff {
		let first_el = g.res[0];
		for idx in (g.n - 1) {
			g.res[idx] = g.res[idx + 1];
		}
		g.res[g.n - 1] = first_el;
	}
	g.steps += g.n * eff;
	out.i = eff;
	out.s.clear();
	format(out.s, "shifted window by ", eff, " at least positions");
	out
}
@end
