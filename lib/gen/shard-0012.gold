fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = 10;
	let hi = 30;
	var kept = 0;
	for i in g.n {
		if g.res[i] < lo || g.res[i] > hi {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " bounded tail items");
	out
}
@end
