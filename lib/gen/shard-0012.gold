fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var start = if g.n > 3 { g.n - 3 } else { 0 };
	for i in start..g.n {
		sum += g.res[i];
	}
	gold_cache_put(g, 99, sum);
	out.i = sum;
	g.steps += (g.n - start);
	out.s.clear();
	format(out.s, "cached suffix sum ", sum);
	out
}
