fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var sum = 0;
	var count = 0;
	while count < g.n {
		if sum + g.res[count] > cap {
			break;
		}
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "found prefix of ", count, " items within total");
	out
}
@end
@entry bfb43565cf99252f
kind: step
verb: shift
noun: vowels
modifier: at_least
context: list
phrase: shift vowels in text leaving at least {count} consonants
phrase: move vowel characters forward preserving at least {count} consonants
slot: count int
test: text="banana" count=2
expect: => i=3 r=0.0 ok=true s="aaabnn" errors=0 n=0 res=[] cache=0 hits=0
test: text="apple" count=1
expect: => i=2 r=0.0 ok=true s="aeppl" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_cons = ${count};
	var vowels = 0;
	var cons = 0;
	var write_idx = 0;
	var tmp: byte[..200] = "";
	for i in out.s.len {
		tmp.push(out.s[i]);
	}
	for i in tmp.len {
		let b = tmp[i];
		let is_v = (b == 97 || b == 101 || b == 105 || b == 111 || b == 117);
		if is_v {
			out.s[write_idx] = b;
			write_idx++;
			vowels++;
		}
	}
	for i in tmp.len {
		let b = tmp[i];
		let is_v = (b == 97 || b == 101 || b == 105 || b == 111 || b == 117);
		if !is_v {
			out.s[write_idx] = b;
			write_idx++;
			cons++;
		}
	}
	g.steps += out.s.len;
	out.i = vowels;
	out.ok = (cons >= min_cons);
	out
}
@end
