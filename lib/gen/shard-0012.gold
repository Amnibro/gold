fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		g.res[i] = rev;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated digits");
	out
}
