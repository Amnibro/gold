fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write_i = 0;
	for r in g.n {
		var seen = 0;
		for prev in write_i {
			if g.res[prev] == g.res[r] { seen++; }
		}
		if seen < limit {
			g.res[write_i] = g.res[r];
			write_i++;
		}
	}
	g.steps += g.n * g.n;
	g.n = write_i;
	out.i = write_i;
	out.s.clear();
	format(out.s, "clamped each tally to ", limit);
	out
}
@end
