@entry 4b3978af625f48ff
kind: step
verb: repeat
noun: value
modifier: with_retry
context: cache
phrase: repeat cached value lookup with retry attempts {retries}
phrase: retry fetching cache value repeatedly up to {retries} times
slot: retries int
test: list=10,20 retries=3
expect: => i=10 r=0.0 ok=true s="repeated cache lookup in 1 attempts" errors=0 n=2 res=[10,20] cache=2 hits=1
test: list=5 retries=2 input=99
expect: => i=198 r=0.0 ok=true s="repeated cache lookup in 2 attempts" errors=0 n=1 res=[5] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var attempts = 0;
	var found = false;
	while attempts < retries {
		attempts++;
		let val, ok = gold_cache_get(g, out.i);
		if ok {
			found = true;
			out.i = val;
			break;
		} else {
			gold_cache_put(g, out.i, out.i * 2);
		}
	}
	g.steps += attempts;
	out.ok = found;
	out.s.clear();
	format(out.s, "repeated cache lookup in ", attempts, " attempts");
	out
}
@end
