fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	if g.cn == 0 {
		gold_cache_put(g, 1, 10);
		gold_cache_put(g, 2, 20);
		gold_cache_put(g, 3, 30);
	}
	var sum = 0;
	var i = 0;
	while i < g.cn {
		sum += g.cv[i];
		if sum >= limit {
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded cache until threshold");
	out
}
@end
