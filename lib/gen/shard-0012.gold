code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			odd_count++;
			var j = i + 1;
			while j < g.n {
				if g.res[j] % 2 != 0 && g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "sorted ", odd_count, " odd values");
	out
}
@end
