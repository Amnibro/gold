code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val, ok = gold_cache_get(g, g.res[i]);
		if ok {
			gold_cache_put(g, g.res[i], val + 1);
		} else {
			gold_cache_put(g, g.res[i], 1);
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "joined memo entries: ", g.cn, " unique items: ", kept);
	out
}
@end
