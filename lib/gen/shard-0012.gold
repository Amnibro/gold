code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	if g.n < 3 {
		gold_fail(g, "list too short for middle filter");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 1;
	while i < g.n - 1 {
		g.res[kept] = g.res[i] * mult;
		kept++;
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined ", kept, " middle items scaled times factor");
	out
}
@end
