test: text="world" count=4
expect: => i=4 r=0.0 ok=true s="wORLD" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	let s_len = out.s.len;
	var actual = if count > s_len { s_len } else { count };
	var modified = 0;
	var i = s_len - actual;
	while i < s_len {
		let b = out.s[i];
		if b >= 97 && b <= 122 {
			out.s[i] = b - 32;
			modified++;
		}
		i++;
	}
	g.steps += actual;
	out.i = modified;
	out
}
@end
