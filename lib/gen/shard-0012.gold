code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200] = "";
	var k = 0;
	while k < out.s.len {
		let b = out.s[k];
		if b == ' ' || b == '.' || b == '!' { break; }
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			if vowels.len < 200 { vowels.push(b); }
		}
		k++;
	}
	g.steps += k;
	out.s.clear();
	for b in vowels { out.s.push(b); }
	out.i = vowels.len;
	out
}
@end
