modifier: safely
context: stats
phrase: repeat gaps safely by factor {times}
phrase: replicate gaps safely by count {times}
slot: times int
test: list=10,15,22 times=2
expect: => i=4 r=0.0 ok=true s="repeated gaps safely" errors=0 n=4 res=[5,7,5,7] cache=0 hits=0
test: list=5,8,14 times=3
expect: => i=6 r=0.0 ok=true s="repeated gaps safely" errors=0 n=6 res=[3,6,3,6,3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	if g.n <= 1 || reps <= 0 {
		return out;
	}
	var gaps = [0; 64];
	var gc = 0;
	var i = 1;
	while i < g.n && gc < 64 {
		gaps[gc] = g.res[i] - g.res[i - 1];
		gc++;
		i++;
	}
	gold_clear(g);
	var r = 0;
	while r < reps {
		var j = 0;
		while j < gc && g.n < 512 {
			gold_push(g, gaps[j]);
			j++;
		}
		r++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated gaps safely");
	out
}
@end
@entry a5b155de2674c5c0
kind: step
verb: repeat
noun: histogram
modifier: at_most
context: stats
phrase: repeat histogram bins at most {max_total}
phrase: expand histogram frequencies at most {max_total}
slot: max_total int
test: list=3,5,3 max_total=5
expect: => i=5 r=0.0 ok=true s="repeated histogram at most" errors=0 n=5 res=[3,3,5,3,3] cache=0 hits=0
