phrase: retrieve items from cache checking for missing key errors
slot: cap int
test: list=10,20,30 cap=2
expect: => i=2 r=0.0 ok=true s="returned 2 cached items" errors=0 n=2 res=[10,20] cache=3 hits=2
test: list=5 cap=3
expect: => i=1 r=0.0 ok=false s="cache missing item error" errors=1 n=1 res=[5] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var hits = 0;
	var missing = false;
	for k in cap {
		let val, ok = gold_cache_get(g, k);
		if ok {
			hits++;
		} else {
			missing = true;
			break;
		}
	}
	g.steps += cap;
	if missing {
		gold_fail(g, "cache lookup failed for requested item");
		out.ok = false;
		out.i = hits;
		out.s.clear();
		format(out.s, "cache missing item error");
	} else {
		g.n = hits;
		out.i = hits;
		out.s.clear();
		format(out.s, "returned ", hits, " cached items");
	}
	out
}
@end
