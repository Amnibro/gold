@entry 87349cfa93b4989e
kind: step
verb: return
noun: odds
modifier: last
context: filter
slot: count int
phrase: return last filtered odd elements up to {count}
phrase: collect trailing odd filtered items count {count}
test: list=1,2,3,4,5,6,7 count=2
expect: => i=2 r=0.0 ok=true s="returned 2 trailing odd items" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=11,13,15,16,18,21 count=3
expect: => i=3 r=0.0 ok=true s="returned 3 trailing odd items" errors=0 n=3 res=[13,15,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var odds = [0; 512];
	var odd_count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[odd_count] = g.res[i];
			odd_count++;
		}
	}
	var start = odd_count - k;
	if start < 0 { start = 0; }
	var kept = 0;
	var i = start;
	while i < odd_count {
		g.res[kept] = odds[i];
		kept++;
		i++;
	}
	g.steps += g.n + odd_count;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " trailing odd items");
	out
}
@end
