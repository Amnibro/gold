phrase: sort unique elements inverting tail positions
test: arg=5132,1122
expect: 1253
expect: 12
test: arg=97531
expect: 13975
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[..16] = [];
	while x > 0 {
		let dig = x % 10;
		var seen = false;
		for i in 0..d.len {
			if d[i] == dig { seen = true; }
		}
		if !seen { d.push(dig); }
		x /= 10;
	}
	if d.len < 2 { return if d.len == 1 { d[0] } else { 0 }; }
	for i in 0..d.len {
		for j in i + 1..d.len {
			if d[i] > d[j] {
				let tmp = d[i];
				d[i] = d[j];
				d[j] = tmp;
			}
		}
	}
	let mid = d.len / 2;
	let tail_len = d.len - mid;
	for k in 0..tail_len / 2 {
		let tmp = d[mid + k];
		d[mid + k] = d[d.len - 1 - k];
		d[d.len - 1 - k] = tmp;
	}
	var res = 0;
	for i in 0..d.len {
		res = res * 10 + d[i];
	}
	res
}
@end
