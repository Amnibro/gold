phrase: reverse results if no zero gap spaces exist
phrase: invert results list verifying no spaces are zero
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="reversed without zero spaces" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,6
expect: => i=3 r=0.0 ok=false s="reversed without zero spaces" errors=1 n=3 res=[5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_zero = false;
	for i in 0..g.n - 1 {
		if g.res[i + 1] - g.res[i] == 0 {
			has_zero = true;
			gold_fail(g, "zero space found");
		}
	}
	if !has_zero && g.n > 0 {
		for i in 0..g.n / 2 {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	out.i = g.n;
	out.ok = !has_zero;
	out.s.clear();
	format(out.s, "reversed without zero spaces");
	out
}
@end
