code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var rounds = 0;
	while g.n > 1 {
		rounds++;
		var new_n = 0;
		var k = 0;
		while k < g.n {
			let sum = if k + 1 < g.n { g.res[k] + g.res[k + 1] } else { g.res[k] };
			g.res[new_n] = sum;
			gold_cache_put(g, new_n, sum);
			new_n++;
			k += 2;
		}
		g.n = new_n;
		if rounds >= 10 { break; }
	}
	g.steps += rounds;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "joined memo recursively in ", rounds, " passes");
	out
}
@end
