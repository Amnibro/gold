@entry 99c5dbfca6e5420c
kind: step
verb: pair
noun: sequence
modifier: unique
context: text
phrase: count unique adjacent bigram pairs in text
phrase: find distinct consecutive letter pairs across text
test: text="banana"
expect: => i=3 r=0.0 ok=true s="banana" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcdef"
expect: => i=5 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_pairs = 0;
	var i = 0;
	while i + 1 < out.s.len {
		let c1 = out.s[i];
		let c2 = out.s[i + 1];
		var seen = false;
		for j in i {
			if out.s[j] == c1 && out.s[j + 1] == c2 { seen = true; break; }
		}
		if !seen { unique_pairs++; }
		i++;
	}
	g.steps += out.s.len;
	out.i = unique_pairs;
	out
}
@end
@entry e517cd7634ab9354
kind: step
verb: merge
noun: words
modifier: at_most
context: text
slot: max_words int
phrase: merge at most {max_words} words from text
phrase: truncate text to at most {max_words} words
test: text="one two three four five" max_words=3
expect: => i=3 r=0.0 ok=true s="one two three" errors=0 n=0 res=[] cache=0 hits=0
test: text="apple pear orange" max_words=2
expect: => i=2 r=0.0 ok=true s="apple pear" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_words};
	var words = 0;
	var end_idx = out.s.len;
	var in_word = false;
	for k in out.s.len {
		if out.s[k] != ' ' {
			if !in_word {
				words++;
				if words > lim { end_idx = k; break; }
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	while end_idx > 0 && out.s[end_idx - 1] == ' ' { end_idx--; }
	var temp byte[..200] = "";
	for k in end_idx { temp.push(out.s[k]); }
	out.s.clear();
	for b in temp { out.s.push(b); }
	g.steps += out.s.len;
	out.i = words - 1;
	out
}
@end
