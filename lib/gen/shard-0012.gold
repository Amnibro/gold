code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[i];
	}
	var write_idx = 0;
	for i in g.n {
		if tmp[i] % 2 == 0 {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	let evens = write_idx;
	for i in g.n {
		if tmp[i] % 2 != 0 {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	out.i = g.n - evens;
	out.s.clear();
	format(out.s, "moved ", g.n - evens, " odd items to last");
	out
}
@end
@entry fe400c997eb9e52f
kind: step
verb: collect
noun: budget
modifier: each
context: core
phrase: collect items subtracting cost {cost} from budget {total}
phrase: spend total budget {total} collecting each item with cost {cost}
slot: total int
slot: cost int
test: total=10 cost=3
expect: => i=3 r=0.0 ok=true s="collected 3 items from budget" errors=0 n=3 res=[3,3,3] cache=0 hits=0
