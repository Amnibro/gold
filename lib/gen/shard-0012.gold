code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var sum = 0;
	for i in g.n {
		if kept == 0 || g.res[kept - 1] != g.res[i] {
			g.res[kept] = g.res[i];
			sum += g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "deduped aggregate count: ", kept, " sum: ", sum);
	out
}
@end
@entry 69b4ac709db83083
kind: step
verb: rotate
noun: runs
modifier: pairwise
context: aggregate
phrase: rotate aggregate runs pairwise across list
phrase: swap adjacent run pairs in aggregate
test: list=10,20,30,40,50
expect: => i=150 r=0.0 ok=true s="pairwise rotated sum: 150" errors=0 n=5 res=[20,10,40,30,50] cache=0 hits=0
test: list=1,2,3,4,5,6
expect: => i=21 r=0.0 ok=true s="pairwise rotated sum: 21" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var total = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		total += g.res[i] + g.res[i + 1];
		i += 2;
	}
	if i < g.n { total += g.res[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "pairwise rotated sum: ", total);
	out
}
@end
