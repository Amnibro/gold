fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var has_err = false;
	var word_count = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		let start = i;
		while i < out.s.len && out.s[i] != ' ' { i++; }
		let len = i - start;
		if len > 0 {
			word_count++;
			if len < 2 || len > 10 { has_err = true; }
		}
	}
	if has_err {
		gold_fail(g, "word failed length comparison checks");
		out.ok = false;
	}
	g.steps += out.s.len + 1;
	out.i = word_count;
	out.s.clear();
	format(out.s, "compared words count ", word_count);
	out
}
@end
