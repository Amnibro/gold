@entry 023c33c93d20c879
kind: step
verb: reverse
noun: maximum
modifier: in_reverse
context: format
phrase: format elements up to maximum reversed in order
phrase: display values inverted relative to maximum position
test: list=2,8,4,1
expect: => i=2 r=0.0 ok=true s="reversed to max: [8, 2, 4, 1]" errors=0 n=4 res=[8,2,4,1] cache=0 hits=0
test: list=10,20,50,30
expect: => i=10 r=0.0 ok=true s="reversed to max: [50, 20, 10, 30]" errors=0 n=4 res=[50,20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var i = 0;
	var j = max_idx;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.s.clear();
	format(out.s, "reversed to max: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = g.res[max_idx];
	g.steps += g.n;
	out
}
@end
