expect: => i=2 r=0.0 ok=true s="tail trace: [40, 50]" errors=0 n=2 res=[40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	if tl <= 0 || g.n == 0 {
		g.steps++;
		out.i = 0;
		return out;
	}
	var start = g.n - tl;
	if start < 0 { start = 0; }
	var kept = 0;
	out.s.clear();
	format(out.s, "tail trace: [");
	var i = start;
	while i < g.n {
		if kept > 0 { format(out.s, ", "); }
		format(out.s, g.res[i]);
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	format(out.s, "]");
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out
}
@end
