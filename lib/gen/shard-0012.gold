fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		return out;
	}
	var head = g.res[0];
	var m = 1;
	var i = 1;
	while i + 1 < g.n {
		g.res[m] = g.res[i] + g.res[i + 1];
		m++;
		i += 2;
	}
	if i < g.n {
		g.res[m] = g.res[i];
		m++;
	}
	g.steps += g.n;
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "joined tail to ", m, " elements");
	out
}
@end
