noun: minimum
modifier: all
context: transform
phrase: remove all occurrences of minimum value in results
phrase: strip smallest elements from transformed collection
test: list=1,2,1,3,1
expect: => i=0 r=0.0 ok=true s="removed minimum" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,10,20
expect: => i=0 r=0.0 ok=true s="removed minimum" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var new_n = 0;
	for i in g.n {
		if g.res[i] != min_val {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "removed minimum");
	out
}
@end
