@entry b6d70f8250284161
kind: step
verb: drop
noun: digits
modifier: safely
context: search
phrase: drop digits safely matching search target {digit}
phrase: remove matching digit safely across search results {digit}
slot: digit int
test: list=12,25,32,45,52 digit=2
expect: => i=3 r=0.0 ok=true s="dropped 3 items safely matching digit" errors=0 n=2 res=[25,45] cache=0 hits=0
test: list=10,15,20,25 digit=5
expect: => i=2 r=0.0 ok=true s="dropped 2 items safely matching digit" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${digit};
	var kept = 0;
	for i in g.n {
		let last_d = if g.res[i] < 0 { (-g.res[i]) % 10 } else { g.res[i] % 10 };
		if last_d != target {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	let dropped = g.n - kept;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items safely matching digit");
	out
}
@end
