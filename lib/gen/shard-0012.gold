	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			count++;
		}
	}
	gold_push(g, count);
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "found counter between range ", count);
	out
}
@end
