fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var unique = 0;
	out.s.clear();
	format(out.s, "scaled unique steps: [");
	for i in g.n {
		var first = true;
		for j in i { if g.res[j] == g.res[i] { first = false; break; } }
		if first {
			if unique > 0 { format(out.s, ", "); }
			format(out.s, g.res[i] * mult);
			unique++;
		}
	}
	format(out.s, "]");
	out.i = unique;
	g.steps += g.n * g.n;
	out
}
@end
