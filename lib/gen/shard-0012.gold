@entry d618de287162bde1
kind: step
verb: dedupe
noun: duplicates
modifier: until
context: core
phrase: dedupe duplicates until reaching limit index {limit}
phrase: remove duplicate items until position {limit}
slot: limit int
test: list=1,1,2,2,3,3 limit=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=5,5,5 limit=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	var w = 0;
	for i in bound {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { g.res[w] = g.res[i]; w++; }
	}
	for i in g.n - bound {
		g.res[w] = g.res[bound + i];
		w++;
	}
	g.n = w;
	out.i = w;
	g.steps += g.n;
	out
}
@end
