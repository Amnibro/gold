test: list=3,6,9 bound=5
expect: => i=1 r=0.0 ok=true s="clamped 1 odd values in place" errors=0 n=3 res=[3,6,5] cache=3 hits=0
test: list=7,11 bound=6
expect: => i=2 r=0.0 ok=true s="clamped 2 odd values in place" errors=0 n=2 res=[6,6] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	var clamped = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			if x > bound {
				g.res[k] = bound;
				clamped++;
			}
		}
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " odd values in place");
	out
}
@end
