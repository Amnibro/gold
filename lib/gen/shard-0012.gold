expect: => i=0 r=0.0 ok=true s="middle duplicates cleared: 0" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var deduped = 0;
	if g.n > 2 {
		let mid_start = 1;
		let mid_end = g.n - 1;
		var i = mid_start;
		while i < mid_end {
			var j = i + 1;
			while j < mid_end {
				if g.res[i] == g.res[j] && g.res[j] != 0 {
					g.res[j] = 0;
					deduped += 1;
				}
				j += 1;
			}
			i += 1;
		}
	}
	g.steps += g.n;
	out.i = deduped;
	out.s.clear();
	format(out.s, "middle duplicates cleared: ", deduped);
	out
}
@end
