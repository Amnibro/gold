phrase: locate cached values with digits between {low} bounds {high}
slot: low int
slot: high int
test: list=5,25,350,4200 low=2 high=3
expect: => i=2 r=0.0 ok=true s="found 2 cached numbers with digits in range" errors=0 n=2 res=[25,350] cache=4 hits=0
test: list=7,9 low=2 high=3
expect: => i=0 r=0.0 ok=true s="found 0 cached numbers with digits in range" errors=0 n=0 res=[] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var count = 0;
	for k in g.cn {
		var x = g.cv[k];
		if x < 0 { x = -x; }
		var digits = if x == 0 { 1 } else { 0 };
		while x > 0 { digits++; x /= 10; }
		if digits >= low && digits <= high {
			g.res[count] = g.cv[k];
			count++;
		}
	}
	g.n = count;
	g.steps += g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " cached numbers with digits in range");
	out
}
@end
