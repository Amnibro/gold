@entry e949cc7f0eef09f9
kind: step
verb: search
noun: tail
modifier: safely
context: aggregate
slot: count int
phrase: search tail aggregate safely for minimum of {count}
phrase: find minimum safely in trailing {count} aggregate elements
test: list=50,40,30,20,10 count=3
expect: => i=10 r=0.0 ok=true s="tail minimum: 10" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
test: list=15,25,35,5,45 count=2
expect: => i=5 r=0.0 ok=true s="tail minimum: 5" errors=0 n=5 res=[15,25,35,5,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var seg_len = k;
	if seg_len > g.n { seg_len = g.n; }
	if seg_len <= 0 {
		gold_fail(g, "empty tail for search");
		out.ok = false;
		return out;
	}
	var min_val = 999999;
	var i = g.n - seg_len;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i++;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "tail minimum: ", min_val);
	out
}
@end
@entry b0ec0007dd0d4991
kind: step
verb: rank
noun: streak
modifier: until
context: aggregate
slot: target int
phrase: rank increasing streak until matching target {target}
phrase: measure consecutive growth streak until value {target}
test: list=2,5,8,10,12 target=10
expect: => i=4 r=0.0 ok=true s="streak length until target: 4" errors=0 n=5 res=[2,5,8,10,12] cache=0 hits=0
test: list=3,6,9,15,20 target=9
expect: => i=3 r=0.0 ok=true s="streak length until target: 3" errors=0 n=5 res=[3,6,9,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var streak = 0;
	var stopped = false;
	for i in g.n {
		if g.res[i] == tgt {
			stopped = true;
			streak++;
			break;
		}
		if i == 0 || g.res[i] > g.res[i - 1] {
			streak++;
		} else {
			streak = 1;
		}
	}
	g.steps += g.n;
	out.i = streak;
	out.s.clear();
	format(out.s, "streak length until target: ", streak);
	out
}
@end
@entry 786e92803ef50f79
kind: step
verb: join
noun: window
modifier: at_least
context: aggregate
slot: min_sum int
phrase: join sliding window segments totaling at least {min_sum}
phrase: combine aggregate window blocks reaching at least {min_sum}
test: list=10,20,5,30,40 min_sum=35
expect: => i=105 r=0.0 ok=true s="joined windows sum: 105" errors=0 n=2 res=[35,70] cache=0 hits=0
test: list=15,10,25,30,12 min_sum=40
expect: => i=97 r=0.0 ok=true s="joined windows sum: 97" errors=0 n=2 res=[55,42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	var kept = 0;
	var total = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let win = g.res[i] + g.res[i + 1];
			if win >= ms {
				g.res[kept] = win;
				total += win;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "joined windows sum: ", total);
	out
}
@end
@entry d976cf369b4a412b
kind: step
verb: rotate
noun: gaps
modifier: times
context: aggregate
slot: factor int
phrase: rotate aggregate gap sizes multiplied times {factor}
phrase: cycle adjacent difference gaps times scale {factor}
test: list=2,5,9,15 factor=2
expect: => i=3 r=0.0 ok=true s="rotated 3 scaled gaps" errors=0 n=3 res=[12,6,8] cache=0 hits=0
test: list=10,20,35,55 factor=3
expect: => i=3 r=0.0 ok=true s="rotated 3 scaled gaps" errors=0 n=3 res=[60,30,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	if g.n < 2 {
		g.steps++;
		out.i = 0;
		return out;
	}
	var gaps = [0; 512];
	var count = g.n - 1;
	for i in count {
		gaps[i] = (g.res[i + 1] - g.res[i]) * mult;
	}
	for i in count {
		let next_pos = (i + 1) % count;
		g.res[next_pos] = gaps[i];
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated ", count, " scaled gaps");
	out
}
@end
@entry 1f0997ecdd7a65f8
kind: step
verb: swap
noun: primes
modifier: nested
context: math
slot: limit int
phrase: swap prime elements with nested factor {limit}
phrase: swap adjacent prime numbers bounded by {limit}
test: list=2,3,4,5 limit=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[3,2,4,5] cache=0 hits=0
test: list=7,11,13,8 limit=20
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[11,7,13,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var is_p_a = a >= 2 && a <= lim;
		var d = 2;
		while d * d <= a { if a % d == 0 { is_p_a = false; break; } d++; }
		var is_p_b = b >= 2 && b <= lim;
		d = 2;
		while d * d <= b { if b % d == 0 { is_p_b = false; break; } d++; }
		if is_p_a && is_p_b {
			g.res[i] = b;
			g.res[i + 1] = a;
			swaps++;
		}
		i += 2;
	}
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
@entry c86a64b0e47269c1
kind: step
verb: rotate
noun: minimum
modifier: safely
context: aggregate
phrase: rotate aggregate sequence safely to place minimum first
phrase: cycle aggregate list safely bringing smallest item forward
test: list=30,40,10,20
expect: => i=10 r=0.0 ok=true s="rotated minimum 10 to front" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=50,15,25,35,45
expect: => i=15 r=0.0 ok=true s="rotated minimum 15 to front" errors=0 n=5 res=[15,25,35,45,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps++;
		out.i = 0;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var temp = [0; 512];
	for i in g.n {
		let new_pos = (i + g.n - min_idx) % g.n;
		temp[new_pos] = g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "rotated minimum ", min_val, " to front");
	out
}
@end
