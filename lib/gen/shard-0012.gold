fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		total += g.res[i];
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "safely sorted ", g.n, " items sum: ", total);
	out
}
