@entry 50c4fb87e7070dd8
kind: step
verb: dedupe
noun: counter
modifier: running
context: list
phrase: dedupe consecutive elements running tally
phrase: remove adjacent duplicate values with running counter
test: list=1,1,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="removed 3 running duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,5
expect: => i=3 r=0.0 ok=true s="removed 3 running duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var kept = 1;
	var removed = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[kept - 1] {
			removed++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " running duplicates");
	out
}
@end
