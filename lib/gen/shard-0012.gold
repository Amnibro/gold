fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	for i in 1..g.n - 1 {
		for j in i + 1..g.n - 1 {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.res[g.n / 2];
	gold_cache_put(g, 0, mid);
	g.steps += g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "sorted middle with median ", mid);
	out
}
