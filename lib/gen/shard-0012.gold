code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var invalid = 0;
	for i in g.n {
		if g.res[i] <= 0 { invalid++; }
	}
	if invalid > 0 {
		gold_fail(g, "invalid retry result code");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n - invalid;
	out.s.clear();
	format(out.s, "validated ", out.i, " valid results");
	out
}
@end
