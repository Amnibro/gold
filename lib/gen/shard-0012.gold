@entry a360d95f3f854049
kind: step
verb: fill
noun: value
modifier: sorted
context: error
slot: fill_val int
phrase: fill sorted error gaps with replacement value {fill_val}
phrase: populate sorted error missing entries using {fill_val}
test: list=1,5 fill_val=0
expect: => i=1 r=0.0 ok=true s="filled sorted gaps count 1" errors=0 n=3 res=[1,5,0] cache=0 hits=0
test: list=1,2,3 fill_val=0
expect: => i=0 r=0.0 ok=true s="filled sorted gaps count 0" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fill_v = ${fill_val};
	if g.n < 2 {
		gold_fail(g, "insufficient items for gap filling");
		out.ok = false;
		return out;
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var filled = 0;
	let orig_n = g.n;
	for i in orig_n - 1 {
		if g.res[i + 1] - g.res[i] > 1 {
			gold_push(g, fill_v);
			filled++;
		}
	}
	if filled == 0 {
		gold_fail(g, "no gaps found between sorted elements");
	}
	g.steps += orig_n * orig_n + filled;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled sorted gaps count ", filled);
	out
}
@end
