test: list=8,9,10,11,13
expect: => i=2 r=0.0 ok=true s="selected 2 primes with cache" errors=0 n=2 res=[11,13] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = false;
		let cached, ok = gold_cache_get(g, x);
		if ok {
			is_p = cached == 1;
		} else {
			if x >= 2 {
				is_p = true;
				var d = 2;
				while d * d <= x {
					if x % d == 0 { is_p = false; break; }
					d++;
				}
			}
			gold_cache_put(g, x, if is_p { 1 } else { 0 });
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " primes with cache");
	out
}
@end
