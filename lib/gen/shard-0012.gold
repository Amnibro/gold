fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_ptr = 0;
	for item_idx in g.n {
		let mapped = ${sub}(g.res[item_idx]);
		var is_present = false;
		for check_idx in write_ptr {
			if g.res[check_idx] == mapped {
				is_present = true;
				break;
			}
		}
		if !is_present {
			g.res[write_ptr] = mapped;
			write_ptr++;
		}
	}
	g.steps += g.n * 2;
	g.n = write_ptr;
	out.i = write_ptr;
	out.s.clear();
	format(out.s, "collected ", write_ptr, " unique results");
	out
}
@end
@entry 860230dce2188742
kind: step
