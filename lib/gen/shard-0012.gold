phrase: verify nested cache values meet average threshold {thresh}
slot: thresh int
test: list=10,20,30 thresh=15
expect: => i=20 r=0.0 ok=true s="nested cache average meets threshold" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=2,4,6 thresh=10
expect: => i=4 r=0.0 ok=false s="nested cache average below threshold" errors=0 n=3 res=[2,4,6] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${thresh};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var total = 0;
	for k in g.cn {
		total += g.cv[k];
	}
	let avg = if g.cn > 0 { total / g.cn } else { 0 };
	g.steps += g.cn;
	out.i = avg;
	out.ok = (avg >= thresh);
	out.s.clear();
	if out.ok {
		format(out.s, "nested cache average meets threshold");
	} else {
		format(out.s, "nested cache average below threshold");
	}
	out
}
@end
