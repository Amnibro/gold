fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let drop_n = if k > g.n { g.n } else { k };
	let rem = g.n - drop_n;
	for i in rem {
		g.res[i] = g.res[drop_n + i];
	}
	g.n = rem;
	g.steps += rem;
	out.i = drop_n;
	out.s.clear();
	format(out.s, "dropped ", drop_n, " leading sorted items");
	out
}
