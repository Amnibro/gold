fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let slen = ${suffix_len};
	let take = if slen < g.n { slen } else { g.n };
	let start = g.n - take;
	var scaled = 0;
	for i in take {
		if g.res[start + i] <= b {
			g.res[start + i] *= 2;
			scaled++;
		}
	}
	g.steps += take + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "applied suffix up to bound count ", scaled);
	out
}
@end
