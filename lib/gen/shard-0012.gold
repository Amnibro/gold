noun: runs
modifier: pairwise
context: aggregate
phrase: run pairwise differences across consecutive runs
phrase: evaluate pairwise step deltas between consecutive runs
test: list=2,2,5,5,5,1
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,-4] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var write_idx = 0;
    var i = 0;
    while i < g.n {
        let val = g.res[i];
        g.res[write_idx] = val;
        write_idx += 1;
        while i + 1 < g.n && g.res[i + 1] == val {
            i += 1;
        }
        i += 1;
    }
    g.n = write_idx;
    if g.n >= 2 {
        for j in 0..(g.n - 1) {
            g.res[j] = g.res[j + 1] - g.res[j];
        }
        g.n = g.n - 1;
    }
    v.i = g.n;
    v.ok = g.n > 0;
    v
}
@end
