code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${key};
	let cached, found = gold_cache_get(g, key);
	if found {
		out.i = cached;
	} else {
		let res = ${f}(key);
		gold_cache_put(g, key, res);
		out.i = res;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "memo value is ", out.i);
	out
}
@end
