@entry 50fd75b86b67cd66
kind: step
verb: shift
noun: checkpoint
modifier: at_least
context: math
phrase: shift checkpoint values reaching at least threshold {min}
phrase: move items reaching at least checkpoint {min} to front
slot: min int
test: list=3,8,2,9,5 min=6
expect: => i=2 r=0.0 ok=true s="shifted 2 checkpoint values to front" errors=0 n=5 res=[8,9,3,2,5] cache=0 hits=0
test: list=10,20,5 min=15
expect: => i=1 r=0.0 ok=true s="shifted 1 checkpoint values to front" errors=0 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min};
	if g.n <= 1 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[i];
	}
	var write_idx = 0;
	for i in g.n {
		if tmp[i] >= min_v {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	let qual = write_idx;
	for i in g.n {
		if tmp[i] < min_v {
			g.res[write_idx] = tmp[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	out.i = qual;
	out.s.clear();
	format(out.s, "shifted ", qual, " checkpoint values to front");
	out
}
@end
