code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for memo trace");
		out.ok = false;
		return out;
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	let last_val, ok = gold_cache_get(g, g.n - 1);
	g.steps += g.n;
	out.i = last_val;
	out.s.clear();
	format(out.s, "last memoized aggregate value: ", last_val);
	out
}
@end
