@entry 26f851e8433e71f0
kind: step
verb: search
noun: value
modifier: with_cache
context: search
phrase: search target value {target} using query cache
phrase: locate search value {target} with cache lookup
slot: target int
test: list=10,20,30 target=20
expect: => i=1 r=0.0 ok=true s="found target in search list" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=false s="target value not found" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	let cached, hit = gold_cache_get(g, target);
	if hit {
		out.i = cached;
		out.ok = true;
		out.s.clear();
		format(out.s, "found target in cache");
		return out;
	}
	var found_idx = -1;
	for k in g.n {
		if g.res[k] == target {
			found_idx = k;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		gold_cache_put(g, target, found_idx);
		out.ok = true;
		format(out.s, "found target in search list");
	} else {
		out.ok = false;
		format(out.s, "target value not found");
	}
	out
}
@end
