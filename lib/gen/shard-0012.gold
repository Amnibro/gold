code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	if g.n < 3 {
		gold_fail(g, "list too short for middle aggregate clamp");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = 1;
	while i < g.n - 1 {
		g.res[i] = g.res[i] * mult;
		sum += g.res[i];
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "clamped middle sum: ", sum);
	out
}
@end
