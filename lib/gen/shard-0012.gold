fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_gap = 0;
	var i = g.n - 1;
	while i > 0 {
		let diff = g.res[i] - g.res[i - 1];
		let d = if diff < 0 { -diff } else { diff };
		total_gap += d;
		i--;
	}
	out.i = total_gap;
	g.steps += g.n;
	out
}
