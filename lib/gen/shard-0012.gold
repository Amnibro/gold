fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${f}(g.res[k]);
	}
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached sorted transform results");
	out
}
@end
