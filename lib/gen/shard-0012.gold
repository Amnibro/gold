	let s = if ${start_idx} < 0 { 0 } else { ${start_idx} };
	let e = if ${end_idx} >= g.n { g.n - 1 } else { ${end_idx} };
	var count = 0;
	if s <= e && s < g.n {
		var k = s;
		while k <= e {
			g.res[k] = ${f}(g.res[k]);
			count++;
			k++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped ", count, " items between checkpoints");
	out
}
