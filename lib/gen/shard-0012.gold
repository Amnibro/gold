phrase: count consecutive equal streaks reaching length {length}
slot: length int
test: list=1,1,2,3,3,3,4 length=2
expect: => i=2 r=0.0 ok=true s="found 2 qualifying streaks" errors=0 n=7 res=[1,1,2,3,3,3,4] cache=0 hits=0
test: list=1,2,3 length=2
expect: => i=0 r=0.0 ok=true s="found 0 qualifying streaks" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${length};
	if g.n == 0 {
		return out;
	}
	var count = 0;
	var curr_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			curr_len++;
		} else {
			if curr_len >= min_len {
				count++;
			}
			curr_len = 1;
		}
		i++;
	}
	if curr_len >= min_len {
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " qualifying streaks");
	out
}
@end
