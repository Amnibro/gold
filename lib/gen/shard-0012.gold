code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val < 10 {
		return val;
	}
	var rev = 0;
	while val > 0 {
		rev = rev * 10 + (val % 10);
		val = val / 10;
	}
	var res = 0;
	while rev >= 10 {
		let curr = rev % 10;
		let next = (rev / 10) % 10;
		if curr >= next {
			res = res * 10 + curr;
		}
		rev = rev / 10;
	}
	res = res * 10 + (rev % 10);
	return res;
}
@end
