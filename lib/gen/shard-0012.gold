@entry cb4f630c631037eb
kind: step
verb: sort
noun: gaps
modifier: first
context: loop
phrase: sort difference gaps between consecutive loop values
phrase: order adjacent interval gaps from loop sequence
test: list=10,25,12,30
expect: => i=3 r=0.0 ok=true s="sorted gaps first" errors=0 n=3 res=[13,15,18] cache=0 hits=0
test: list=1,9,4,15
expect: => i=3 r=0.0 ok=true s="sorted gaps first" errors=0 n=3 res=[5,8,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var gaps int[..512] = [];
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		gaps.push(if diff < 0 { -diff } else { diff });
	}
	for i in gaps.len {
		for j in i + 1..gaps.len {
			if gaps[j] < gaps[i] {
				let tmp = gaps[i];
				gaps[i] = gaps[j];
				gaps[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for gap in gaps { gold_push(g, gap); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted gaps first");
	out
}
@end
