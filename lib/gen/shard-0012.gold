expect: => i=0 r=0.0 ok=true s="streak sum at most cap is 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if out.s.len == 0 {
		out.i = 0;
		return out;
	}
	var total = 0;
	var i = 0;
	while i < out.s.len {
		var j = i;
		while j < out.s.len && out.s[j] == out.s[i] {
			j++;
		}
		let streak = j - i;
		if streak <= cap {
			total += streak;
		}
		i = j;
	}
	g.steps += out.s.len;
	out.i = total;
	out.s.clear();
	format(out.s, "streak sum at most cap is ", total);
	out
}
@end
