fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	gold_clear(g);
	for i in g.cn {
		gold_push(g, g.cv[i]);
	}
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied sorted history length ", g.n);
	out
}
