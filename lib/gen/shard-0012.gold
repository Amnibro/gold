fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + x % 10;
			x /= 10;
		}
		g.res[i] = if g.res[i] < 0 { -rev } else { rev };
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed digits of ", g.n, " items");
	out
}
