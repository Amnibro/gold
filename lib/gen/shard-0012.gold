@entry f96d72356a725c4f
kind: step
verb: rotate
noun: digits
modifier: safely
context: stats
phrase: rotate digits safely by count {shifts}
phrase: shift digits safely by offset {shifts}
slot: shifts int
test: input=1234 shifts=1
expect: => i=2341 r=0.0 ok=true s="rotated digits safely" errors=0 n=0 res=[] cache=0 hits=0
test: input=5821 shifts=2
expect: => i=2158 r=0.0 ok=true s="rotated digits safely" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${shifts};
	var num = out.i;
	if num <= 0 || k <= 0 {
		return out;
	}
	var d = [0; 32];
	var len = 0;
	while num > 0 {
		d[len] = num % 10;
		len++;
		num /= 10;
	}
	var rev = [0; 32];
	var idx = 0;
	while idx < len {
		rev[idx] = d[len - 1 - idx];
		idx++;
	}
	var rot = 0;
	var i = 0;
	while i < len {
		rot = rot * 10 + rev[(i + k) % len];
		i++;
	}
	g.steps += len;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated digits safely");
	out
}
@end
@entry 2bc56f92a205375c
kind: step
verb: filter
noun: errors
modifier: any
context: stats
phrase: filter errors any exceeding tolerance {tolerance}
phrase: remove error spikes any beyond {tolerance}
slot: tolerance int
test: list=10,12,11,50,9 tolerance=10
expect: => i=1 r=0.0 ok=true s="filtered any errors" errors=0 n=4 res=[10,12,11,9] cache=0 hits=0
test: list=20,22,80,21 tolerance=15
expect: => i=1 r=0.0 ok=true s="filtered any errors" errors=0 n=3 res=[20,22,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n == 0 {
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let mean = sum / g.n;
	var write_idx = 0;
	var removed = 0;
	i = 0;
	while i < g.n {
		let x = g.res[i];
		let diff = if x >= mean { x - mean } else { mean - x };
		if diff <= tol {
			g.res[write_idx] = x;
			write_idx++;
		} else {
			removed++;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += i;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered any errors");
	out
}
@end
