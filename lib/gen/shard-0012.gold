@entry 06c597144410705a
kind: step
verb: shift
noun: streak
modifier: at_least
context: error
slot: min_streak int
phrase: shift error streak of at least length {min_streak}
phrase: move error run meeting at least streak size {min_streak}
test: list=1,2,2,2,3 min_streak=3
expect: => i=3 r=0.0 ok=true s="shifted streak elements count 3" errors=0 n=5 res=[2,2,2,1,3] cache=0 hits=0
test: list=1,2,3 min_streak=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_streak};
	if g.n < min_s {
		gold_fail(g, "results length smaller than streak requirement");
		out.ok = false;
		return out;
	}
	var best_start = -1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
			if cur_len >= min_s && best_start < 0 {
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
	}
	if best_start < 0 {
		gold_fail(g, "no streak met the minimum length requirement");
		out.ok = false;
		return out;
	}
	let val = g.res[best_start];
	var w = 0;
	for i in g.n {
		if g.res[i] == val {
			let tmp = g.res[w];
			g.res[w] = g.res[i];
			g.res[i] = tmp;
			w++;
		}
	}
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "shifted streak elements count ", w);
	out
}
@end
