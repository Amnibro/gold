noun: budget
modifier: first
context: filter
slot: budget int
phrase: trace first filtered items within budget {budget}
phrase: record initial filtered entries up to budget {budget}
test: list=10,20,30,40 budget=50
expect: => i=30 r=0.0 ok=true s="budget spent: 30 items: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35 budget=30
expect: => i=20 r=0.0 ok=true s="budget spent: 20 items: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	var kept = 0;
	for i in g.n {
		if total + g.res[i] <= b {
			total += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "budget spent: ", total, " items: ", kept);
	out
}
@end
