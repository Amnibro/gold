fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		let val = g.res[idx];
		if val % 2 == 0 {
			g.res[kept] = val;
			kept++;
		}
		idx++;
	}
	g.n = kept;
	out.i = kept;
	g.steps += idx;
	out
}
