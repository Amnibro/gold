				valid = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = valid;
	out.s.clear();
	if valid {
		format(out.s, "pairwise increasing verified");
	} else {
		format(out.s, "pairwise order check failed");
	}
	out
}
