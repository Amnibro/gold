fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let r = ${f}(x);
			gold_cache_put(g, x, r);
			g.res[i] = r;
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "memo map hits: ", g.hits);
	out
}
