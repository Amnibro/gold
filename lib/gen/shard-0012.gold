code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var dropped = 0;
	var write_idx = 0;
	for i in out.s.len {
		let b = out.s[i];
		let is_letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
		if is_letter && dropped < limit {
			dropped++;
		} else {
			out.s[write_idx] = b;
			write_idx++;
		}
	}
	out.s.resize(write_idx, 0 as byte);
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
