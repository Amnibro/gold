code:
fn ${ID}(n int) int {
	let ceiling = ${cap};
	var count = 0;
	var p = 2;
	while p <= n && count < ceiling {
		var is_p = true;
		var d = 2;
		while d * d <= p && is_p {
			if p % d == 0 {
				is_p = false;
			}
			d = d + 1;
		}
		if is_p {
			count = count + 1;
		}
		p = p + 1;
	}
	return count;
}
@end
