phrase: cycle aggregate items safely using shift {shift}
test: list=10,20,30,40 shift=1
expect: => i=100 r=0.0 ok=true s="rotated aggregate safely by 1 total: 100" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,15,25,35,45 shift=2
expect: => i=125 r=0.0 ok=true s="rotated aggregate safely by 2 total: 125" errors=0 n=5 res=[35,45,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s <= 0 {
		g.steps++;
		out.i = 0;
		return out;
	}
	let k = s % g.n;
	var temp = [0; 512];
	var total = 0;
	for i in g.n {
		let pos = (i + k) % g.n;
		temp[pos] = g.res[i];
		total += g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "rotated aggregate safely by ", k, " total: ", total);
	out
}
@end
