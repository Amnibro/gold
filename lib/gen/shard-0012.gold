fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var small_diffs = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff <= 5 { small_diffs++; }
		}
	}
	gold_cache_put(g, 5, small_diffs);
	g.steps += g.n + 1;
	out.i = small_diffs;
	out.s.clear();
	format(out.s, "cached pairwise diff histogram count ", small_diffs);
	out
}
@end
