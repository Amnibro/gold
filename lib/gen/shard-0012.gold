code:
fn ${ID}_is_p(num int) bool {
	if num < 2 { return false; }
	var div = 2;
	while div * div <= num {
		if num % div == 0 { return false; }
		div++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_idx = 0;
	var prime_sum = 0;
	var matched = 0;
	for i in g.n {
		if ${ID}_is_p(g.res[i]) {
			if prime_idx % 2 == 0 {
				prime_sum += g.res[i];
				matched++;
			}
			prime_idx++;
		}
	}
	gold_push(g, prime_sum);
	g.steps += g.n;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "grouped ", matched, " alternating primes");
	out
}
@end
