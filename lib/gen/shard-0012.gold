@entry a197206ac92c874c
kind: step
verb: limit
noun: number
modifier: pairwise
context: compare
slot: bound int
phrase: limit number pairwise adjacent sums bounded by {bound}
phrase: clamp pairwise adjacent totals to bound {bound}
test: list=10,20,30,40 bound=25
expect: => i=3 r=0.0 ok=true s="limited pairwise numbers count 3" errors=0 n=4 res=[10,15,10,15] cache=0 hits=0
test: list=5,8,4 bound=15
expect: => i=0 r=0.0 ok=true s="limited pairwise numbers count 0" errors=0 n=3 res=[5,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] + g.res[i + 1] > b {
				g.res[i + 1] = b - g.res[i];
				clamped++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited pairwise numbers count ", clamped);
	out
}
@end
