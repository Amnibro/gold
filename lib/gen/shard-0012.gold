fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		var seen = false;
		for j in write {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[write] = g.res[i];
			write += 1;
		}
	}
	g.n = write;
	g.steps += write;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped count: ", write);
	out
}
