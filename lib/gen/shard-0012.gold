code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = out.s.len - 1;
	while i >= 0 && out.s[i] == 32 {
		i--;
	}
	while i >= 0 && out.s[i] != 32 {
		i--;
	}
	let new_len = if i < 0 { 0 } else { i };
	let dropped = out.s.len - new_len;
	out.s.resize(new_len, 0 as byte);
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
