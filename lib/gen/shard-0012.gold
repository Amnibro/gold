@entry 9e4c7db2800b7edd
kind: step
verb: apply
noun: primes
modifier: with_retry
context: loop
slot: retries int
phrase: apply primes with retry allowance {retries}
phrase: retry testing loop primes up to attempts {retries}
test: input=14 retries=5
expect: => i=17 r=0.0 ok=true s="applied primes with retry found 17" errors=0 n=1 res=[17] cache=0 hits=0
test: input=24 retries=6
expect: => i=29 r=0.0 ok=true s="applied primes with retry found 29" errors=0 n=1 res=[29] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var found = false;
	var candidate = out.i;
	var attempt = 0;
	while attempt < r && !found {
		candidate++;
		if core_is_prime(candidate) {
			found = true;
		}
		attempt++;
	}
	if found {
		out.i = candidate;
		gold_push(g, candidate);
	} else {
		gold_fail(g, "no prime found within retry limit");
		out.ok = false;
	}
	g.steps += attempt + 1;
	out.s.clear();
	format(out.s, "applied primes with retry found ", out.i);
	out
}
@end
