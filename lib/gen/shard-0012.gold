code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_res = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n && count < 512 {
		let x = g.res[i];
		new_res[count] = x;
		count++;
		if i % 2 == 0 && x % 2 == 0 && count < 512 {
			new_res[count] = x;
			count++;
		}
		i++;
	}
	g.n = count;
	i = 0;
	while i < count {
		g.res[i] = new_res[i];
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated evens every other");
	out
}
@end
