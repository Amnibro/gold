@entry bea4afb3cbabfb37
kind: step
verb: compare
noun: pairs
modifier: any
context: error
slot: target int
phrase: compare any error pairs matching difference {target}
phrase: check if any error pair has span {target}
test: list=10,15,30,35 target=5
expect: => i=1 r=0.0 ok=true s="pair difference matched status 1" errors=0 n=4 res=[10,15,30,35] cache=0 hits=0
test: list=1,2,3 target=10
expect: => i=0 r=0.0 ok=false s="pair difference matched status 0" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let diff = ${target};
	if g.n < 2 {
		gold_fail(g, "insufficient items to compare pairs");
		out.ok = false;
		return out;
	}
	var found = false;
	for i in g.n - 1 {
		let d = g.res[i + 1] - g.res[i];
		let abs_d = if d < 0 { -d } else { d };
		if abs_d == diff {
			found = true;
			break;
		}
	}
	if !found {
		gold_fail(g, "target difference not matched in any pair");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "pair difference matched status ", out.i);
	out
}
@end
