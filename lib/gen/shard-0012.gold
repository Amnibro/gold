	for i in 0..g.n {
		if g.res[i] > lim {
			var x = g.res[i];
			var rev = 0;
			while x > 0 {
				rev = rev * 10 + (x % 10);
				x /= 10;
			}
			g.res[i] = rev;
			reversed_cnt++;
			gold_fail(g, "value exceeded limit");
		}
	}
	out.i = reversed_cnt;
	out.s.clear();
	format(out.s, "reversed count ", reversed_cnt);
	out
}
@end
