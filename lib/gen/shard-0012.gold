fn ${ID}(g Gold&, v Val) Val {
    var alt_streak_sum = 0;
    var streak_idx = 0;
    var i = 0;
    while i < g.n {
        var run_len = 1;
        while i + 1 < g.n && g.res[i + 1] == g.res[i] {
            run_len += 1;
            i += 1;
        }
        if streak_idx % 2 == 0 {
            alt_streak_sum += run_len;
        }
        streak_idx += 1;
        i += 1;
    }
    gold_push(g, alt_streak_sum);
    v.i = alt_streak_sum;
    v.ok = alt_streak_sum > 0;
    v
}
@end
