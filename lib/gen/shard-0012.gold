fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched int[512] = [0; 512];
	var idxs int[512] = [0; 512];
	var mc = 0;
	for k in g.n {
		if ${cond}(g.res[k]) {
			matched[mc] = g.res[k];
			idxs[mc] = k;
			mc++;
		}
	}
	for i in mc {
		g.res[idxs[i]] = matched[mc - 1 - i];
	}
	out.i = mc;
	g.steps += g.n + mc;
	out
}
@end
