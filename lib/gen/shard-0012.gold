@entry 076633c3ed9fc32f
kind: step
verb: sum
noun: head
modifier: unique
context: loop
slot: count int
phrase: sum head unique loop elements taking {count}
phrase: accumulate unique initial loop values up to {count}
test: list=2,2,3,4,3 count=4
expect: => i=9 r=0.0 ok=true s="summed unique head loop values 9" errors=0 n=6 res=[2,2,3,4,3,9] cache=0 hits=0
test: list=5,5,5,10 count=3
expect: => i=5 r=0.0 ok=true s="summed unique head loop values 5" errors=0 n=5 res=[5,5,5,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let lim = if c < g.n { c } else { g.n };
	var sum = 0;
	for i in lim {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			sum += x;
		}
	}
	g.steps += lim + 1;
	out.i = sum;
	gold_push(g, sum);
	out.s.clear();
	format(out.s, "summed unique head loop values ", sum);
	out
}
@end
