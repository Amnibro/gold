code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	for r in rep {
		if g.n < 2 { break; }
		var min_idx = 0;
		var max_idx = 0;
		for k in 1..g.n {
			if g.res[k] < g.res[min_idx] { min_idx = k; }
			if g.res[k] > g.res[max_idx] { max_idx = k; }
		}
		let tmp = g.res[min_idx];
		g.res[min_idx] = g.res[max_idx];
		g.res[max_idx] = tmp;
	}
	out.i = rep;
	g.steps += g.n * rep;
	out
}
@end
