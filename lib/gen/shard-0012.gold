@entry 8819c19853ba7f93
kind: step
verb: limit
noun: spaces
modifier: each
context: list
phrase: limit contiguous space sequences to each single space
phrase: collapse multiple adjacent spaces to single space each
test: text="a  b   c"
expect: => i=3 r=0.0 ok=true s="a b c" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello   world"
expect: => i=2 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var in_space = false;
	var removed = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == 32 {
			if in_space {
				removed++;
			} else {
				out.s[write_idx] = b;
				write_idx++;
				in_space = true;
			}
		} else {
			out.s[write_idx] = b;
			write_idx++;
			in_space = false;
		}
	}
	out.s.resize(write_idx, 0 as byte);
	g.steps += out.s.len;
	out.i = removed;
	out
}
@end
