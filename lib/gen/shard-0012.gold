fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let plen = ${prefix_len};
	if plen <= 0 || plen > g.n {
		gold_fail(g, "invalid prefix length");
		out.ok = false;
		return out;
	}
	var prefix_sum = 0;
	for i in plen {
		prefix_sum += g.res[i];
	}
	let cmp = if prefix_sum > out.i { 1 } else if prefix_sum < out.i { -1 } else { 0 };
	gold_push(g, cmp);
	g.steps += plen + 1;
	out.i = cmp;
	out.s.clear();
	format(out.s, "safely compared prefix result ", cmp);
	out
}
@end
