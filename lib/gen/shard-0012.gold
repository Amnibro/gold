@entry fde02c7e7c490a62
kind: step
verb: map
noun: duplicates
modifier: in_reverse
context: format
phrase: format duplicate items mapped in reverse order
phrase: display reversed list of repeated duplicate values
test: list=2,3,2,4,3,5
expect: => i=2 r=0.0 ok=true s="reversed duplicates: [3, 2]" errors=0 n=6 res=[2,3,2,4,3,5] cache=0 hits=0
test: list=1,1,2,2,3,3
expect: => i=3 r=0.0 ok=true s="reversed duplicates: [3, 2, 1]" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dc = 0;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] == g.res[i] {
				var seen = false;
				for d in dc { if dups[d] == g.res[i] { seen = true; break; } }
				if !seen {
					dups[dc] = g.res[i];
					dc++;
				}
				break;
			}
		}
	}
	out.s.clear();
	format(out.s, "reversed duplicates: [");
	var k = dc - 1;
	var first = true;
	while k >= 0 {
		if !first { format(out.s, ", "); }
		format(out.s, dups[k]);
		first = false;
		k--;
	}
	format(out.s, "]");
	out.i = dc;
	g.steps += g.n * g.n;
	out
}
@end
