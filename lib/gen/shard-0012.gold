expect: => i=1 r=0.0 ok=true s="found 1 gaps exceeding 10" errors=0 n=1 res=[13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var gap_count = 0;
	var kept = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff >= mg {
				gap_count++;
				g.res[kept] = diff;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = gap_count;
	out.s.clear();
	format(out.s, "found ", gap_count, " gaps exceeding ", mg);
	out
}
@end
