code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var capped = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] > g.res[i] + b {
			g.res[i + 1] = g.res[i] + b;
			capped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = capped;
	out.s.clear();
	format(out.s, "limited ", capped, " pairwise items");
	out
}
@end
