code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${key};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let val, ok = gold_cache_get(g, key);
	g.steps += g.cn;
	if !ok {
		gold_fail(g, "cache key not found for rotate");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "cache missing error");
		return out;
	}
	if g.n > 1 {
		let prev = g.res[0];
		g.res[0] = val;
		g.res[1] = prev;
	}
	out.i = val;
	out.s.clear();
	format(out.s, "rotated cached item to front");
	out
}
@end
