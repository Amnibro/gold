fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted series each");
	out
}
@end
