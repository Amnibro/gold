noun: steps
modifier: in_reverse
context: text
phrase: swap text characters in reverse order step by step
phrase: reverse text string swapping characters step by step
test: text="hello"
expect: => i=5 r=0.0 ok=true s="olleh" errors=0 n=0 res=[] cache=0 hits=0
test: text="world"
expect: => i=5 r=0.0 ok=true s="dlrow" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	if n <= 1 {
		return out;
	}
	for i in n / 2 {
		let opp = n - 1 - i;
		let tmp = out.s[i];
		out.s[i] = out.s[opp];
		out.s[opp] = tmp;
	}
	g.steps += n;
	out.i = n;
	out
}
@end
