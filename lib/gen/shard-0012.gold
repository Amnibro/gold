@entry 1ef91af2d7cff832
kind: step
verb: scale
noun: results
modifier: until
context: list
slot: factor int
slot: limit int
phrase: scale results by {factor} until sum exceeds {limit}
phrase: multiply list by {factor} until total reaches {limit}
test: list=1,2,3 factor=2 limit=20
expect: => i=2 r=0.0 ok=true s="scaled results rounds: 2" errors=0 n=3 res=[4,8,12] cache=0 hits=0
test: list=2,3,4 factor=3 limit=50
expect: => i=2 r=0.0 ok=true s="scaled results rounds: 2" errors=0 n=3 res=[18,27,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let lim = ${limit};
	var rounds = 0;
	while rounds < 100 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum >= lim { break; }
		for i in g.n { g.res[i] *= f; }
		rounds++;
	}
	g.steps += rounds;
	out.i = rounds;
	out.s.clear();
	format(out.s, "scaled results rounds: ", rounds);
	out
}
@end
@entry 6de2606525a12b97
kind: step
verb: scale
noun: maximum
modifier: recursively
context: list
slot: factor int
phrase: scale list maximum element recursively by factor {factor}
phrase: reduce list maximum recursively dividing by {factor}
test: list=12,24,64 factor=2
expect: => i=8 r=0.0 ok=true s="scaled max down to: 8" errors=0 n=3 res=[12,24,8] cache=0 hits=0
test: list=5,10,81 factor=3
expect: => i=9 r=0.0 ok=true s="scaled max down to: 9" errors=0 n=3 res=[5,10,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 || f <= 1 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var steps = 0;
	while g.res[max_idx] > 10 && steps < 50 {
		g.res[max_idx] /= f;
		steps++;
	}
	g.steps += steps + g.n;
	out.i = g.res[max_idx];
	out.s.clear();
	format(out.s, "scaled max down to: ", g.res[max_idx]);
	out
}
@end
