fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var temp = [0; 512];
	var count = 0;
	for i in g.n {
		for k in f {
			if count < 512 {
				temp[count] = g.res[i];
				count++;
			}
		}
	}
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged sequence size: ", count);
	out
}
@end
