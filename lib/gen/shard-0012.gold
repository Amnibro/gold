@entry 99241c329a6838b5
kind: step
verb: clamp
noun: budget
modifier: pairwise
context: format
slot: cap int
phrase: clamp budget pairwise by cap {cap}
phrase: restrict budget pairs with cap {cap}
test: list=6,7,3,4 cap=10
expect: => i=1 r=0.0 ok=true s="budget pairs adjusted: 1" errors=0 n=4 res=[6,4,3,4] cache=0 hits=0
test: list=4,4 cap=5
expect: => i=1 r=0.0 ok=true s="budget pairs adjusted: 1" errors=0 n=2 res=[4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var adjusted = 0;
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum > c {
			let excess = pair_sum - c;
			if g.res[i + 1] >= excess {
				g.res[i + 1] -= excess;
			} else {
				g.res[i] -= excess;
			}
			adjusted += 1;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "budget pairs adjusted: ", adjusted);
	out
}
@end
