fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	var i = s;
	if i < 0 {
		i = 0;
	}
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n - s;
	out.s.clear();
	format(out.s, "sorted tail elements");
	out
}
