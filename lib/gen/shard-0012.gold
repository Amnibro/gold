fn ${ID}(g Gold&, v Val) Val {
	let a = ${lo};
	let b = ${hi};
	var out = v;
	if a >= 0 && b < g.n && a < b {
		let cnt = (b - a + 1) / 2;
		for k in 0..cnt {
			let tmp = g.res[a + k];
			g.res[a + k] = g.res[b - k];
			g.res[b - k] = tmp;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "prefix slice reversed");
	out
}
@end
