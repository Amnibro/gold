@entry 468dac66be1c1e6c
kind: step
verb: shift
noun: step
modifier: while
context: loop
slot: threshold int
phrase: shift loop step while under threshold {threshold}
phrase: advance loop step while below threshold {threshold}
test: input=2 threshold=20
expect: => i=23 r=0.0 ok=true s="shifted step while under threshold count 3" errors=0 n=1 res=[23] cache=0 hits=0
test: input=3 threshold=50
