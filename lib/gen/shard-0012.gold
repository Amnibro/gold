@entry 5bf4d4f55ef96c27
kind: step
verb: return
noun: middle
modifier: until
context: aggregate
slot: bound int
phrase: return middle aggregate items until reaching bound {bound}
phrase: collect central aggregate elements until threshold {bound}
test: list=5,10,20,30,40 bound=25
expect: => i=10 r=0.0 ok=true s="middle items sum under bound: 10" errors=0 n=1 res=[10] cache=0 hits=0
test: list=2,15,25,35,50 bound=30
expect: => i=15 r=0.0 ok=true s="middle items sum under bound: 15" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	if g.n < 3 {
		gold_fail(g, "list too short for middle aggregate");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var kept = 0;
	var i = 1;
	while i < g.n - 1 {
		if sum + g.res[i] <= limit {
			sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "middle items sum under bound: ", sum);
	out
}
@end
