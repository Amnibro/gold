fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	for i in g.n / 2 {
		let opp = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " step elements");
	out
}
