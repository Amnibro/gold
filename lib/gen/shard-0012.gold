	let take = if c < g.n { c } else { g.n };
	var span = 0;
	if take > 0 {
		var min_val = g.res[0];
		var max_val = g.res[0];
		for i in 1..take {
			if g.res[i] < min_val { min_val = g.res[i]; }
			if g.res[i] > max_val { max_val = g.res[i]; }
		}
		span = max_val - min_val;
	}
	gold_push(g, span);
	g.steps += take + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "grouped first step span ", span);
	out
}
