fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no pairwise gaps");
		return out;
	}
	var diff_count = g.n - 1;
	for pos in diff_count {
		g.res[pos] = g.res[pos + 1] - g.res[pos];
	}
	g.steps += diff_count;
	g.n = diff_count;
	out.i = diff_count;
	out.s.clear();
	format(out.s, "applied ", diff_count, " pairwise gaps");
	out
}
@end
