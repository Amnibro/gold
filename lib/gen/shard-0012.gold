expect: => i=100 r=0.0 ok=true s="folded unique sum: 100" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var sum = 0;
	for i in g.n {
		var found = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				found = true;
				break;
			}
		}
		if !found {
			g.res[kept] = g.res[i];
			sum += g.res[i];
			kept++;
		}
	}
	g.steps += g.n * kept;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded unique sum: ", sum);
	out
}
@end
