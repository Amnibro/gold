@entry 74ef114e318f0c8e
kind: step
verb: sort
noun: loop
modifier: pairwise
context: error
phrase: sort loop pairwise passes catching inversion errors
phrase: perform pairwise loop sort passes catching timeout errors
test: list=3,1,2
expect: => i=3 r=0.0 ok=true s="sorted pairwise loop in order" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,-2
expect: => i=0 r=0.0 ok=false s="negative sort error" errors=1 n=2 res=[5,-2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		if g.res[k] < 0 {
			gold_fail(g, "negative element invalid in sort loop");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "negative sort error");
			return out;
		}
	}
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted pairwise loop in order");
	out
}
@end
