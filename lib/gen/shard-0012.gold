test: list=2,3,4,5,6,7,8 cap=2
expect: => i=2 r=0.0 ok=true s="grouped primes at most count 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=10,11,12,13,17 cap=4
expect: => i=3 r=0.0 ok=true s="grouped primes at most count 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var primes int[512] = [0; 512];
	var pn = 0;
	for i in g.n {
		if pn >= c { break; }
		if core_is_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		}
	}
	g.n = pn;
	for i in pn {
		g.res[i] = primes[i];
	}
	g.steps += g.n + 1;
	out.i = pn;
	out.s.clear();
	format(out.s, "grouped primes at most count ", pn);
	out
}
@end
