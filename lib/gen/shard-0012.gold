@entry 5a4497e28b9679c9
kind: step
verb: sort
noun: values
modifier: with_retry
context: error
phrase: sort values with retry attempts up to limit {retries}
phrase: order results with retry passes catching unsorted errors
slot: retries int
test: list=3,2,1 retries=5
expect: => i=3 r=0.0 ok=true s="sorted values in 3 retries" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=3,2,1 retries=1
expect: => i=1 r=0.0 ok=false s="retry limit exceeded" errors=1 n=3 res=[2,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	var passes = 0;
	var swapped = true;
	while swapped && passes < retries {
		swapped = false;
		passes++;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				swapped = true;
			}
		}
	}
	var is_sorted = true;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] { is_sorted = false; break; }
		}
	}
	g.steps += passes * g.n;
	out.i = passes;
	if is_sorted {
		out.s.clear();
		format(out.s, "sorted values in ", passes, " retries");
	} else {
		gold_fail(g, "sort not converged within retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "retry limit exceeded");
	}
	out
}
@end
