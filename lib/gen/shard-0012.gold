code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	var neg = false;
	if num < 0 {
		neg = true;
		num = -num;
	}
	var rev = 0;
	while num > 0 {
		rev = rev * 10 + (num % 10);
		num /= 10;
	}
	if neg {
		rev = -rev;
	}
	out.i = rev;
	out.s.clear();
	format(out.s, "reversed number ", rev);
	g.steps++;
	out
}
@end
