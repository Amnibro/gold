code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		gold_fail(g, "none available to select");
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	g.steps += g.n;
	gold_clear(g);
	gold_push(g, min_val);
	out.i = min_val;
	out.s.clear();
	format(out.s, "selected minimum value: ", min_val);
	out
}
@end
