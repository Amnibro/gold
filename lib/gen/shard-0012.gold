fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_indices int[..32] = [];
	for i in 0..g.n {
		if g.res[i] % 2 != 0 {
			odd_indices.push(i);
		}
	}
	let oc = odd_indices.len;
	for k in 0..oc / 2 {
		let i1 = odd_indices[k];
		let i2 = odd_indices[oc - 1 - k];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
	}
	gold_cache_put(g, 13, oc);
	out.i = oc;
	out.s.clear();
	format(out.s, "odds reversed ", oc);
	out
}
