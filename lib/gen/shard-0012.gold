@entry e98a3fcce586d06f
kind: step
verb: reverse
noun: gaps
modifier: last
context: aggregate
slot: count int
phrase: calculate reverse gaps for last {count} items
phrase: invert order of last {count} difference gaps in aggregate
test: list=5,10,20,35 count=3
expect: => i=3 r=0.0 ok=true s="reversed 3 trailing gaps" errors=0 n=3 res=[15,10,5] cache=0 hits=0
test: list=2,4,8,16,32 count=4
expect: => i=4 r=0.0 ok=true s="reversed 4 trailing gaps" errors=0 n=4 res=[16,8,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n < 2 { return out; }
	let bound = if c < g.n - 1 { c } else { g.n - 1 };
	var gaps int[512] = [0; 512];
	let start = g.n - 1 - bound;
	for k in bound {
		gaps[k] = g.res[start + k + 1] - g.res[start + k];
	}
	gold_clear(g);
	var k = bound - 1;
	while k >= 0 {
		gold_push(g, gaps[k]);
		k--;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "reversed ", bound, " trailing gaps");
	out
}
@end
