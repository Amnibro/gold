fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var prods int[..512] = [];
	var i = 0;
	while i + 1 < g.n {
		prods.push(g.res[i] * g.res[i + 1]);
		i += 2;
	}
	gold_clear(g);
	for p in prods { gold_push(g, p); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise loop values");
	out
}
@end
