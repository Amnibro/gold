fn ${ID}(g Gold&, v Val) Val {
    var cur_sum = 0;
    for i in 0..v.s.len {
        let b = v.s[i];
        if b >= '0' && b <= '9' {
            cur_sum += (b - '0') as int;
        }
    }
    while cur_sum >= 10 {
        var next_sum = 0;
        var temp = cur_sum;
        while temp > 0 {
            next_sum += temp % 10;
            temp = temp / 10;
        }
        cur_sum = next_sum;
    }
    gold_push(g, cur_sum);
    v.i = cur_sum;
    v.ok = cur_sum > 0;
    v
}
@end
