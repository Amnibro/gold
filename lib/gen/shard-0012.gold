fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let s = g.res[g.n - 2] + g.res[g.n - 1];
		g.res[g.n - 2] = s;
		g.n--;
		out.i = s;
	} else {
		out.i = 0;
	}
	g.steps++;
	out.s.clear();
	format(out.s, "paired last values sum: ", out.i);
	out
}
@end
@entry 78f23622cb7d9fbe
kind: step
verb: reverse
noun: suffix
modifier: in_reverse
context: list
slot: count int
phrase: reverse suffix of {count} items in list backwards
phrase: invert trailing suffix of {count} elements in results
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed suffix of size: 3" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed suffix of size: 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var start = g.n - k;
	if start < 0 { start = 0; }
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "reversed suffix of size: ", out.i);
	out
}
@end
