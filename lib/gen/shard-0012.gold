expect: => i=2 r=0.0 ok=true s="grouped tally for each of 2 distinct items" errors=0 n=2 res=[2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	var freqs: int[512] = [0; 512];
	var keys: int[512] = [0; 512];
	for i in g.n {
		let val = g.res[i];
		var found_idx = -1;
		for j in u {
			if keys[j] == val {
				found_idx = j;
				break;
			}
		}
		if found_idx >= 0 {
			freqs[found_idx] += 1;
		} else {
			keys[u] = val;
			freqs[u] = 1;
			u++;
		}
	}
	gold_clear(g);
	for k in u {
		gold_push(g, freqs[k]);
	}
	g.steps += u;
	out.i = u;
	out.s.clear();
	format(out.s, "grouped tally for each of ", u, " distinct items");
	out
}
@end
