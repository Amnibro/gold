fn ${ID}(g Gold&, v Val) Val {
	let cap = ${limit};
	var out = v;
	var over = 0;
	for i in 0..g.n {
		if g.res[i] > cap { over++; }
	}
	if over > 0 {
		gold_fail(g, "value exceeded limit");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = over;
	out.s.clear();
	format(out.s, "exceeded count ", over);
	out
}
