code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_zero = false;
	for i in 0..g.n {
		if g.res[i] == 0 { has_zero = true; }
	}
	if has_zero {
		gold_fail(g, "zero in loop results");
		out.ok = false;
	} else {
		for i in 0..g.n / 2 {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
		out.ok = true;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "loop reversed ", g.n);
	out
}
@end
