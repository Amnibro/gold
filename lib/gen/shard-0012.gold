fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var err_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			err_count++;
		}
	}
	g.steps += g.n;
	out.i = err_count;
	out.s.clear();
	if err_count > 0 {
		gold_fail(g, "errors found in range");
		out.ok = false;
		format(out.s, "found ", err_count, " error entries");
	} else {
		format(out.s, "no errors in range");
	}
	out
}
@end
