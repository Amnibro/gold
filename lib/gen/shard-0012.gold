@entry a6a1f7197391cb2d
kind: step
verb: limit
noun: average
modifier: unique
context: sort
phrase: limit average unique sorted values {cap}
phrase: cap average of distinct sorted items at {cap}
slot: cap int
test: list=2,2,4,6,6 cap=5
expect: => i=4 r=0.0 ok=true s="unique sorted average capped at 4" errors=0 n=5 res=[2,2,4,6,6] cache=0 hits=0
test: list=10,20,20 cap=12
expect: => i=12 r=0.0 ok=true s="unique sorted average capped at 12" errors=0 n=3 res=[10,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var unique_sum = 0;
	var unique_cnt = 0;
	for i in g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			unique_sum += g.res[i];
			unique_cnt++;
		}
	}
	let avg = if unique_cnt > 0 { unique_sum / unique_cnt } else { 0 };
	let capped = if avg > limit { limit } else { avg };
	g.steps += g.n;
	out.i = capped;
	out.s.clear();
	format(out.s, "unique sorted average capped at ", capped);
	out
}
@end
