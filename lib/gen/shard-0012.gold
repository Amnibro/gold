code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = -1;
	var pos = -1;
	var i = g.n - 1;
	while i >= 0 {
		let val = ${f}(g.res[i]);
		if val % 2 == 0 {
			found = g.res[i];
			pos = i;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if pos >= 0 {
		format(out.s, "found last filter match ", found, " at position ", pos);
	} else {
		gold_fail(g, "no matching item found in filter search");
		out.ok = false;
		format(out.s, "no match");
	}
	out
}
