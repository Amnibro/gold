code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 0;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		var k = g.n - 1;
		while k >= 0 && g.res[k] == last_val {
			streak++;
			k--;
		}
	}
	out.i = streak;
	g.steps += g.n;
	out
}
@end
