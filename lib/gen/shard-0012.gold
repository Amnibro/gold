fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lv = ${limit_val};
	let reps = ${repetitions};
	var clamped = 0;
	for _ in reps {
		for i in g.n {
			if g.res[i] > lv {
				g.res[i] = lv;
				clamped++;
			}
		}
	}
	g.steps += reps * g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited list elements count ", clamped);
	out
}
@end
