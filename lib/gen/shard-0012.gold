@entry c6e85d34f3bec75c
kind: step
verb: keep
noun: duplicates
modifier: recursively
context: aggregate
phrase: recursively identify duplicate items in aggregate
phrase: filter aggregate to retain duplicate elements recursively
test: list=1,2,3,2,4,1,5
expect: => i=4 r=0.0 ok=true s="kept 4 duplicate items" errors=0 n=4 res=[1,2,2,1] cache=0 hits=0
test: list=8,9,8,10,10,11
expect: => i=4 r=0.0 ok=true s="kept 4 duplicate items" errors=0 n=4 res=[8,8,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_dup = false;
		for j in g.n {
			if i != j && g.res[j] == x { is_dup = true; break; }
		}
		if is_dup {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " duplicate items");
	out
}
@end
@entry b4253c401b16815b
kind: step
verb: check
noun: gaps
modifier: any
context: aggregate
slot: max_gap int
phrase: check whether any aggregate gaps exceed {max_gap}
phrase: verify if any consecutive differences exceed {max_gap}
test: list=10,15,25,30 max_gap=8
expect: => i=10 r=0.0 ok=false s="gap exceeded limit" errors=0 n=4 res=[10,15,25,30] cache=0 hits=0
test: list=1,3,5,7 max_gap=3
expect: => i=2 r=0.0 ok=true s="all gaps within limit" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	var exceeded = false;
	var max_found = 0;
	if g.n >= 2 {
		for k in g.n - 1 {
			let diff = if g.res[k + 1] > g.res[k] { g.res[k + 1] - g.res[k] } else { g.res[k] - g.res[k + 1] };
			if diff > max_found { max_found = diff; }
			if diff > limit { exceeded = true; }
		}
	}
	g.steps += g.n;
	out.ok = !exceeded;
	out.i = max_found;
	out.s.clear();
	format(out.s, if exceeded { "gap exceeded limit" } else { "all gaps within limit" });
	out
}
@end
