slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="rotated all values by 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated all values by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var s = ${shift} % g.n;
	if s < 0 {
		s += g.n;
	}
	var temp int[512] = [0; 512];
	for i in g.n {
		temp[(i + s) % g.n] = g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n * 2;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated all values by ", s);
	out
}
@end
