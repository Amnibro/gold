fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	let mid = g.n / 2;
	var left_sum = 0;
	for i in mid {
		left_sum += g.res[i];
	}
	var right_sum = 0;
	for i in mid..g.n {
		right_sum += g.res[i];
	}
	gold_clear(g);
	gold_push(g, left_sum);
	gold_push(g, right_sum);
	g.steps += 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split results into 2 sums");
	out
}
@end
