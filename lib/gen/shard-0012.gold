code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = g.n;
	while count > 1 {
		var write_idx = 0;
		var i = 0;
		while i < count {
			if i + 1 < count {
				g.res[write_idx] = g.res[i] + g.res[i + 1];
			} else {
				g.res[write_idx] = g.res[i];
			}
			write_idx++;
			i += 2;
		}
		count = write_idx;
		g.steps += count;
	}
	g.n = 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "folded recursively");
	out
}
@end
