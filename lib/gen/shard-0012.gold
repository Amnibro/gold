@entry e017d202022e5819
kind: step
verb: dedupe
noun: histogram
modifier: last
context: search
phrase: dedupe search frequency histogram keeping last occurrence
phrase: retain last duplicate in query score histogram
test: list=2,3,2,4,3
expect: => i=3 r=0.0 ok=true s="deduped histogram keeping last" errors=0 n=3 res=[2,4,3] cache=0 hits=0
test: list=5,5,6,5
expect: => i=2 r=0.0 ok=true s="deduped histogram keeping last" errors=0 n=2 res=[6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for k in g.n {
		let x = g.res[k];
		var is_last = true;
		var j = k + 1;
		while j < g.n {
			if g.res[j] == x {
				is_last = false;
				break;
			}
			j++;
		}
		if is_last {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped histogram keeping last");
	out
}
@end
