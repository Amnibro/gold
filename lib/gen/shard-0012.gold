fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "paired results: [");
	var i = 0;
	var first = true;
	while i + 1 < g.n {
		if !first { format(out.s, ", "); }
		format(out.s, "(", g.res[i], ":", g.res[i + 1], ")");
		first = false;
		i += 2;
	}
	if i < g.n {
		if !first { format(out.s, ", "); }
		format(out.s, "(", g.res[i], ")");
	}
	format(out.s, "]");
	g.steps += g.n;
	out.i = g.n;
	out
}
