@entry 2623b4acef33cf9e
kind: step
verb: dedupe
noun: number
modifier: at_least
context: error
phrase: dedupe numbers keeping values at least threshold {floor}
phrase: filter distinct numbers at least minimum bound {floor}
slot: floor int
test: list=10,20,10,5 floor=10
expect: => i=2 r=0.0 ok=true s="deduped 2 numbers at least floor" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=2,4,3 floor=10
expect: => i=0 r=0.0 ok=false s="no elements error" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${floor};
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= floor {
			var seen = false;
			for j in count {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[count] = x;
				count++;
			}
		}
	}
	g.n = count;
	g.steps += g.n;
	if count == 0 {
		gold_fail(g, "no elements meet minimum dedupe floor");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "no elements error");
	} else {
		out.i = count;
		out.s.clear();
		format(out.s, "deduped ", count, " numbers at least floor");
	}
	out
}
@end
