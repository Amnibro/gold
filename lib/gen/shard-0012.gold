@entry 229d5c5e812895a0
kind: step
verb: pair
noun: evens
modifier: unique
context: list
phrase: pair unique even numbers from list
phrase: group distinct even integers from results into pairs
test: list=2,4,2,6,8
expect: => i=2 r=0.0 ok=true s="unique even pairs formed: 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,4,6,10
expect: => i=1 r=0.0 ok=true s="unique even pairs formed: 1" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var dup = false;
			for j in kept {
				if g.res[j] == x { dup = true; break; }
			}
			if !dup {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	if kept % 2 != 0 { kept--; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept / 2;
	out.s.clear();
	format(out.s, "unique even pairs formed: ", kept / 2);
	out
}
@end
