fn ${ID}(g Gold&, v Val) Val {
	let lim = ${limit};
	var out = v;
	if g.n > lim && lim > 0 {
		let drop = (g.n - lim) / 2;
		gold_cache_put(g, 1, g.res[0]);
		for i in 0..lim {
			g.res[i] = g.res[drop + i];
		}
		g.n = lim;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "middle kept ", g.n);
	out
}
@end
@entry d6ab8fca84e8b272
kind: step
verb: compare
noun: item
modifier: recursively
context: aggregate
phrase: compare item total recursively up to depth {limit}
phrase: evaluate recursive item comparisons within depth {limit}
slot: limit int
test: list=10,20,15,30,5 limit=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[10,20,15,30,5,3] cache=0 hits=0
test: list=5,4,3,2,1 limit=1
expect: => i=4 r=0.0 ok=true s="" errors=0 n=6 res=[5,4,3,2,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let lim = ${limit};
    var comparisons = 0;
    var depth = 0;
    while depth < lim && depth < g.n {
        for idx in 0..(g.n - 1 - depth) {
            if g.res[idx] > g.res[idx + 1] {
                comparisons += 1;
            }
        }
        depth += 1;
    }
    gold_push(g, comparisons);
    v.i = comparisons;
    v.ok = comparisons > 0;
    v
}
@end
@entry c2c8205d35eea1a8
kind: step
verb: run
noun: budget
modifier: with_cache
context: aggregate
phrase: execute budget aggregation with cache up to {cap}
phrase: run budgeted summation using cache limit {cap}
slot: cap int
test: list=10,20,30 cap=45
expect: => i=30 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,30] cache=1 hits=0
test: list=5,15,25 cap=20
expect: => i=20 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,25,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let budget = ${cap};
    let cached, hit = gold_cache_get(g, budget);
    if hit {
        v.i = cached;
        v.ok = true;
        gold_push(g, cached);
        return v;
    }
    var total = 0;
    for k in 0..g.n {
        if total + g.res[k] > budget { break; }
        total += g.res[k];
    }
    gold_cache_put(g, budget, total);
    gold_push(g, total);
    v.i = total;
    v.ok = total > 0;
    v
}
@end
