code:
fn ${ID}(g Gold&, v Val) Val {
    var win = ${window};
    if win > g.n { win = g.n; }
    var sum = 0;
    while win > 0 {
        sum = 0;
        for idx in 0..win {
            sum += g.res[idx];
        }
        if sum > 0 { break; }
        win -= 1;
    }
    gold_push(g, sum);
    v.i = sum;
    v.ok = sum > 0;
    v
}
@end
