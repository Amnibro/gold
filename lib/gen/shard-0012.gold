expect: => i=120 r=0.0 ok=false s="boundary sum exceeded budget" errors=0 n=4 res=[50,10,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${max_budget};
	if g.n < 2 { return out; }
	let sum = g.res[0] + g.res[g.n - 1];
	var swapped = false;
	if sum <= b {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		swapped = true;
	}
	g.steps += g.n;
	out.ok = swapped;
	out.i = sum;
	out.s.clear();
	format(out.s, if swapped { "swapped boundaries within budget" } else { "boundary sum exceeded budget" });
	out
}
@end
