	if g.n >= 2 {
		var min_v = g.res[0];
		var max_v = g.res[0];
		for i in 1..g.n {
			if g.res[i] < min_v { min_v = g.res[i]; }
			if g.res[i] > max_v { max_v = g.res[i]; }
		}
		g.res[0] = min_v;
		g.res[1] = max_v;
		g.n = 2;
		out.i = max_v - min_v;
	}
	out.s.clear();
	format(out.s, "paired range bounds");
