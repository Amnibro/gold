fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 3 { return out; }
	for i in 1..(g.n - 1) {
		for j in (i + 1)..(g.n - 1) {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n - 2;
	out.s.clear();
	format(out.s, "sorted ", g.n - 2, " middle elements");
	out
}
@end
