phrase: aggregate running window values using size {size}
slot: size int
test: list=1,2,3,4,5 size=2
expect: => i=24 r=0.0 ok=true s="" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30,40 size=3
expect: => i=150 r=0.0 ok=true s="" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let win = ${size};
    var total_acc = 0;
    if win > 0 && g.n >= win {
        let num_windows = g.n - win + 1;
        for i in 0..num_windows {
            var cur_sum = 0;
            for j in 0..win {
                cur_sum += g.res[i + j];
            }
            g.res[i] = cur_sum;
            total_acc += cur_sum;
        }
        g.n = num_windows;
    }
    v.i = total_acc;
    v.ok = total_acc > 0;
    v
}
@end
@entry 7b306e6459b7829b
kind: step
