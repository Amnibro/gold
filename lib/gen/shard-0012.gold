fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let half = g.n / 2;
	var matched = 0;
	for i in g.n - half {
		let val = g.res[half + i];
		if val >= lo && val <= hi {
			matched++;
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "counted ", matched, " suffix items between bounds");
	out
}
