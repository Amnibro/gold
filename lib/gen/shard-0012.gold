@entry 524f35a9fd23052f
kind: step
verb: collect
noun: gaps
modifier: until
context: error
slot: threshold int
phrase: collect error gap sizes until threshold reached
phrase: scan error gaps until limit exceeded
test: list=10,25,30,50 threshold=12
expect: => i=1 r=0.0 ok=false s="collected gaps count 1" errors=1 n=4 res=[10,25,30,50] cache=0 hits=0
test: list=2,4,6,8 threshold=10
expect: => i=3 r=0.0 ok=true s="collected gaps count 3" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		gold_fail(g, "insufficient elements for error gap analysis");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need at least two items");
		return out;
	}
	var count = 0;
	var last_gap = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		if gap > th {
			last_gap = gap;
			count++;
			break;
		}
		count++;
	}
	if last_gap > th {
		gold_fail(g, "error gap exceeded limit");
		out.ok = false;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected gaps count ", count);
	out
}
@end
