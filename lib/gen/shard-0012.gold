@entry 99dd5f657e58e9e2
kind: step
verb: limit
noun: primes
modifier: with_cache
context: search
phrase: limit primes with cache verification search
phrase: filter search items to prime numbers using cache
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="retained 4 prime search items" errors=0 n=4 res=[2,3,5,7] cache=6 hits=0
test: list=8,9,10,11,12
expect: => i=1 r=0.0 ok=true s="retained 1 prime search items" errors=0 n=1 res=[11] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = false;
		let cached, ok = gold_cache_get(g, x);
		if ok {
			is_p = cached == 1;
		} else {
			if x >= 2 {
				is_p = true;
				var d = 2;
				while d * d <= x {
					if x % d == 0 { is_p = false; break; }
					d++;
				}
			}
			gold_cache_put(g, x, if is_p { 1 } else { 0 });
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " prime search items");
	out
}
@end
