	var k = 1;
	while k < g.n {
		if g.res[k] >= last_val {
			last_val = g.res[k];
			g.res[new_n] = last_val;
			new_n++;
		}
		k++;
	}
	g.n = new_n;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered ", g.n, " sorted loop items");
