fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var streak = 0;
	for k in g.cn {
		if g.cv[k] > 0 {
			streak++;
			if streak >= cap { break; }
		} else {
			streak = 0;
		}
	}
	g.steps += g.cn;
	out.i = streak;
	out.s.clear();
	format(out.s, "found cache streak of ", streak);
	out
}
@end
