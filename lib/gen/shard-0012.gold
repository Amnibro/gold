phrase: rearrange last {count} elements taking every other
slot: count int
test: list=1,2,3,4,5,6 count=4
expect: => i=4 r=0.0 ok=true s="grouped alternating suffix of 4 items" errors=0 n=6 res=[1,2,3,5,4,6] cache=0 hits=0
