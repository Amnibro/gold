fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clamped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > 0 {
			break;
		}
		if g.res[i] < 0 {
			g.res[i] = 0;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " leading negative errors");
	out
}
@end
