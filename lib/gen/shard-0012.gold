code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_rev = ${limit};
	var count = if g.n < max_rev { g.n } else { max_rev };
	for i in count / 2 {
		let opp = count - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = tmp;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " duplicate items");
	out
}
@end
