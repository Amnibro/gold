test: list=9,3,7,1
expect: => i=9 r=0.0 ok=true s="sorted and rotated numbers" errors=0 n=4 res=[9,1,3,7] cache=0 hits=0
test: list=20,5,15
expect: => i=20 r=0.0 ok=true s="sorted and rotated numbers" errors=0 n=3 res=[20,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let last = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = last;
	out.s.clear();
	format(out.s, "sorted and rotated numbers");
	out
}
@end
