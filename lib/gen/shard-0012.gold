@entry a3352014ea06dfde
kind: step
verb: clamp
noun: squares
modifier: in_place
context: cache
phrase: clamp squared cache values in place up to limit {bound}
phrase: constrain cache squares in place below {bound}
slot: bound int
test: list=3,5 bound=20
expect: => i=1 r=0.0 ok=true s="clamped 1 squares in place" errors=0 n=2 res=[9,20] cache=2 hits=0
test: list=4,5 bound=50
expect: => i=0 r=0.0 ok=true s="clamped 0 squares in place" errors=0 n=2 res=[16,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	var clamped = 0;
	for k in g.n {
		let sq = g.res[k] * g.res[k];
		if sq > bound {
			g.res[k] = bound;
			clamped++;
		} else {
			g.res[k] = sq;
		}
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " squares in place");
	out
}
@end
