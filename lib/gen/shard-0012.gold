code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${size};
	var m = k;
	if m > g.n {
		m = g.n;
	}
	var i = 0;
	while i < m {
		var j = i + 1;
		while j < m {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted prefix of size ", m);
	out
}
@end
