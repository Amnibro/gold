@entry 245b306f5eb9e63a
kind: step
verb: join
noun: window
modifier: nested
context: filter
slot: win_size int
phrase: join nested filter window segments of {win_size}
phrase: combine nested window blocks of size {win_size}
test: list=2,4,6,8,10 win_size=2
expect: => i=2 r=0.0 ok=true s="joined 2 window averages" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=3,6,9,12,15 win_size=3
expect: => i=1 r=0.0 ok=true s="joined 1 window averages" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	if ws <= 0 || ws > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i + ws <= g.n {
		var win_sum = 0;
		for k in ws {
			win_sum += g.res[i + k];
		}
		g.res[kept] = win_sum / ws;
		kept++;
		i += ws;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined ", kept, " window averages");
	out
}
@end
