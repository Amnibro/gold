fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_len};
	let hi = ${max_len};
	var matched = 0;
	var cur_len = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if cur_len >= lo && cur_len <= hi { matched++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len >= lo && cur_len <= hi { matched++; }
	g.steps += out.s.len;
	out.i = matched;
	out.s.clear();
	format(out.s, "found ", matched, " words within length range");
	out
}
@end
