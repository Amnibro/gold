fn ${ID}(g Gold&, v Val) Val {
	let min_v = ${lo};
	let max_v = ${hi};
	var out = v;
	var found = 0;
	for i in 0..g.n - 1 {
		let sum = g.res[i] + g.res[i + 1];
		if sum >= min_v && sum <= max_v {
			gold_fail(g, "pair in error range");
			found++;
		}
	}
	out.i = found;
	out.ok = (g.errors == 0);
	out.s.clear();
	format(out.s, "paired errors ", found);
	out
}
