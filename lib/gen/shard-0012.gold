context: search
phrase: find squares in place search list
phrase: identify perfect squares in place during search
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="found 3 perfect squares in search" errors=0 n=5 res=[4,7,9,12,16] cache=0 hits=0
test: list=1,3,25,30
expect: => i=2 r=0.0 ok=true s="found 2 perfect squares in search" errors=0 n=4 res=[1,3,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " perfect squares in search");
	out
}
@end
