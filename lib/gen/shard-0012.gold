@entry 14f80a1cb572b066
kind: step
verb: limit
noun: text
modifier: unique
context: aggregate
phrase: limit unique word lengths in text to {capacity}
phrase: collect at most {capacity} unique word lengths
slot: capacity int
test: text="red green blue red blue yellow" capacity=2
expect: => i=2 r=0.0 ok=true s="red green blue red blue yellow" errors=0 n=2 res=[3,5] cache=0 hits=0
test: text="cat bat rat cow" capacity=3
expect: => i=1 r=0.0 ok=true s="cat bat rat cow" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let cap = ${capacity};
    var current_len = 0;
    var unique_count = 0;
    for idx in 0..v.s.len {
        let ch = v.s[idx];
        if ch == ' ' {
            if current_len > 0 {
                var found = false;
                for k in 0..g.n {
                    if g.res[k] == current_len { found = true; break; }
                }
                if !found && unique_count < cap {
                    gold_push(g, current_len);
                    unique_count += 1;
                }
                current_len = 0;
            }
        } else {
            current_len += 1;
        }
    }
    if current_len > 0 && unique_count < cap {
        var found = false;
        for k in 0..g.n {
            if g.res[k] == current_len { found = true; break; }
        }
        if !found {
            gold_push(g, current_len);
            unique_count += 1;
        }
    }
    v.i = unique_count;
    v.ok = unique_count > 0;
    v
}
@end
@entry 57585563fa58cba0
kind: step
verb: drop
noun: squares
modifier: running
context: aggregate
phrase: drop running square values from results
phrase: remove perfect squares from running aggregate
test: list=4,7,9,12,16
expect: => i=29 r=0.0 ok=true s="" errors=0 n=2 res=[7,12] cache=0 hits=0
test: list=1,2,3,4,25
expect: => i=30 r=0.0 ok=true s="" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var dropped = 0;
    var running_sum = 0;
    var write_pos = 0;
    for read_pos in 0..g.n {
        let val = g.res[read_pos];
        var is_square = false;
        if val >= 0 {
            var root = 0;
            while root * root <= val {
                if root * root == val {
                    is_square = true;
                    break;
                }
                root += 1;
            }
        }
        if is_square {
            dropped += 1;
            running_sum += val;
        } else {
            g.res[write_pos] = val;
            write_pos += 1;
        }
    }
    g.n = write_pos;
    v.i = running_sum;
    v.ok = dropped > 0;
    v
}
@end
