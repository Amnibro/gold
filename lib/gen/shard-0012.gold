@entry cd8f6e039d4554b2
kind: step
verb: shift
noun: primes
modifier: with_cache
context: error
phrase: shift prime error codes storing count with cache
phrase: relocate prime error values using cached tally
test: list=4,3,6,5,8,7
expect: => i=3 r=0.0 ok=true s="shifted primes count 3" errors=0 n=6 res=[3,5,7,4,8,6] cache=1 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="shifted primes count 0" errors=1 n=4 res=[4,6,8,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for prime error shift");
		out.ok = false;
		return out;
	}
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		if x > 2 && x % 2 == 0 { is_p = false; }
		var d = 3;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d += 2;
		}
		if is_p {
			let tmp = g.res[p];
			g.res[p] = g.res[i];
			g.res[i] = tmp;
			p++;
		}
	}
	if p == 0 {
		gold_fail(g, "no prime error codes found");
		out.ok = false;
	}
	gold_cache_put(g, 3, p);
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "shifted primes count ", p);
	out
}
@end
@entry 9b4117236de57782
kind: step
verb: shift
noun: values
modifier: until
context: error
slot: stop_val int
phrase: shift error values until stop mark reached {stop_val}
phrase: rotate error values until terminator encountered {stop_val}
test: list=10,20,30,40 stop_val=30
expect: => i=2 r=0.0 ok=true s="shifted values until index 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=1,2,3 stop_val=99
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${stop_val};
	if g.n == 0 {
		gold_fail(g, "empty results for value shift");
		out.ok = false;
		return out;
	}
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == target {
			found_idx = i;
			break;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "stop value not found in error results");
		out.ok = false;
		out.i = 0;
		return out;
	}
	for _ in found_idx {
		let first = g.res[0];
		for j in g.n - 1 {
			g.res[j] = g.res[j + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n + found_idx;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "shifted values until index ", found_idx);
	out
}
@end
