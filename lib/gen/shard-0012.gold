fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	var actual = if count > g.n { g.n } else { count };
	var start = g.n - actual;
	for i in actual {
		gold_cache_put(g, i, g.res[start + i]);
	}
	g.n = start;
	g.steps += actual;
	out.i = actual;
	out.s.clear();
	format(out.s, "split last ", actual, " items into memo");
	out
}
@end
@entry 7c50aacf9209e841
kind: step
verb: shift
noun: runs
modifier: at_least
context: list
phrase: keep contiguous duplicate runs of at least length {len}
phrase: filter sequence retaining runs of at least length {len}
slot: len int
test: list=1,1,2,3,3,3,4 len=2
expect: => i=5 r=0.0 ok=true s="retained 5 items in qualifying runs" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,5,5,6 len=3
expect: => i=3 r=0.0 ok=true s="retained 3 items in qualifying runs" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${len};
	if g.n == 0 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[i];
	}
	let orig_n = g.n;
	gold_clear(g);
	var i = 0;
	while i < orig_n {
		var j = i;
		while j < orig_n && tmp[j] == tmp[i] {
			j++;
		}
		let run_len = j - i;
		if run_len >= min_len {
			while i < j {
				gold_push(g, tmp[i]);
				i++;
			}
		} else {
			i = j;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retained ", g.n, " items in qualifying runs");
	out
}
@end
