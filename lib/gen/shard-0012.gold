@entry 50aa76b0fdc383e1
kind: step
verb: rotate
noun: odds
modifier: times
context: error
phrase: rotate odd numbers times count {steps}
phrase: cycle odd values by shift count {steps} safely
slot: steps int
test: list=2,3,5 steps=1
expect: => i=2 r=0.0 ok=true s="rotated 2 odd values" errors=0 n=3 res=[2,5,3] cache=0 hits=0
test: list=2,4,6 steps=1
expect: => i=0 r=0.0 ok=false s="no odds error" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let steps = ${steps};
	var odd_count = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 { odd_count++; }
	}
	if odd_count == 0 && steps > 0 {
		gold_fail(g, "no odd numbers to rotate");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "no odds error");
		return out;
	}
	if odd_count > 1 && steps > 0 {
		var first_odd_idx = -1;
		var last_odd_idx = -1;
		for k in g.n {
			if g.res[k] % 2 != 0 {
				if first_odd_idx == -1 { first_odd_idx = k; }
				last_odd_idx = k;
			}
		}
		let tmp = g.res[first_odd_idx];
		g.res[first_odd_idx] = g.res[last_odd_idx];
		g.res[last_odd_idx] = tmp;
	}
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "rotated ", odd_count, " odd values");
	out
}
@end
