code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${start};
	let end = ${end};
	var new_n = 0;
	if start >= 0 && start < g.n && end >= start {
		let max_idx = if end < g.n { end } else { g.n - 1 };
		var k = start;
		while k <= max_idx {
			g.res[new_n] = g.res[k];
			new_n++;
			k++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "returned ", new_n, " items between indices");
	out
}
@end
