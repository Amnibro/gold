code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_misses = if v.i > 0 { v.i } else { 2 };
	var misses = 0;
	var hits = 0;
	for i in g.n {
		let _, ok = gold_cache_get(g, g.res[i]);
		if ok {
			hits++;
		} else {
			misses++;
			if misses >= max_misses { break; }
		}
	}
	g.steps += hits + misses;
	out.i = hits;
	out.s.clear();
	format(out.s, "completed with ", hits, " hits, ", misses, " misses");
	out
}
@end
