@entry 7290dc28fa186ead
kind: step
verb: repeat
noun: digits
modifier: every_other
context: retry
phrase: repeat alternating digits in retry transaction identifier
phrase: duplicate every other digit in retry tracking number
test: input=123
expect: => i=11233 r=0.0 ok=true s="repeated digits to 11233" errors=0 n=0 res=[] cache=0 hits=0
test: input=456
expect: => i=44566 r=0.0 ok=true s="repeated digits to 44566" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if out.i < 0 { -out.i } else { out.i };
	var digits int[..64] = [];
	if x == 0 { digits.push(0); }
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	var res = 0;
	var k = digits.len - 1;
	var alt = 0;
	while k >= 0 {
		let d = digits[k];
		res = res * 10 + d;
		if alt % 2 == 0 { res = res * 10 + d; }
		alt++;
		k--;
	}
	g.steps += digits.len;
	out.i = res;
	out.s.clear();
	format(out.s, "repeated digits to ", res);
	out
}
@end
