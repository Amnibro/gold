noun: items
modifier: between
context: search
phrase: return search items between range indices {start} to {end}
phrase: slice query items between positions {start} through {end}
slot: start int
slot: end int
test: list=10,20,30,40,50 start=1 end=3
expect: => i=3 r=0.0 ok=true s="returned 3 items between indices" errors=0 n=3 res=[20,30,40] cache=0 hits=0
