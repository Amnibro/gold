code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_items};
	let bound = if lim < g.n { lim } else { g.n };
	out.s.clear();
	format(out.s, "reversed limit: [");
	var k = bound - 1;
	while k >= 0 {
		if k < bound - 1 { format(out.s, ", "); }
		format(out.s, g.res[k]);
		k--;
	}
	format(out.s, "]");
	out.i = bound;
	g.steps += bound;
	out
}
@end
