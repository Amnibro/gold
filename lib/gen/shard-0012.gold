expect: => i=20 r=0.0 ok=true s="pair rank total difference: 20" errors=0 n=5 res=[5,8,12,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var score = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff > 0 { score += diff; }
			else { score -= diff; }
		}
	}
	g.steps += g.n;
	out.i = score;
	out.s.clear();
	format(out.s, "pair rank total difference: ", score);
	out
}
@end
