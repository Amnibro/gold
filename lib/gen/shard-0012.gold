code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${trim_count};
	if t * 2 < g.n {
		var kept = 0;
		for k in t..g.n - t {
			g.res[kept] = g.res[k];
			kept++;
		}
		g.n = kept;
	} else {
		g.n = 0;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
