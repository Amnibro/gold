@entry 9b385b2fcfbe5815
kind: step
verb: split
noun: streak
modifier: with_cache
context: loop
slot: min_streak int
phrase: split streak with cache tracking min length {min_streak}
phrase: partition loop streak into cache exceeding {min_streak}
test: list=1,1,1,2,2,3,3,3,3 min_streak=2
expect: => i=4 r=0.0 ok=true s="cached loop streak length 4" errors=0 n=9 res=[1,1,1,2,2,3,3,3,3] cache=1 hits=0
test: list=5,5,6,7,7,7,8 min_streak=3
expect: => i=3 r=0.0 ok=true s="cached loop streak length 3" errors=0 n=7 res=[5,5,6,7,7,7,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_streak};
	var longest = 0;
	var curr = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			curr++;
		} else {
			if curr >= m && curr > longest { longest = curr; }
			curr = 1;
		}
	}
	if curr >= m && curr > longest { longest = curr; }
	gold_cache_put(g, 15, longest);
	g.steps += g.n + 1;
	out.i = longest;
	out.s.clear();
	format(out.s, "cached loop streak length ", longest);
	out
}
@end
@entry 12ba0c1aa270a530
kind: step
verb: group
noun: items
modifier: safely
context: loop
slot: chunk_size int
phrase: group items safely into chunk size {chunk_size}
phrase: partition loop items safely by chunk {chunk_size}
test: list=1,2,3,4,5,6 chunk_size=2
expect: => i=6 r=0.0 ok=true s="safely grouped items into chunks 6" errors=0 n=12 res=[1,2,3,4,5,6,3,7,11,10,21,21] cache=0 hits=0
test: list=10,20,30,40 chunk_size=3
expect: => i=2 r=0.0 ok=true s="safely grouped items into chunks 2" errors=0 n=6 res=[10,20,30,40,60,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${chunk_size};
	if cs <= 0 {
		gold_fail(g, "chunk size must be positive");
		out.ok = false;
		return out;
	}
	var chunks = 0;
	var idx = 0;
	while idx < g.n {
		var sum = 0;
		for c in cs {
			if idx + c < g.n {
				sum += g.res[idx + c];
			}
		}
		gold_push(g, sum);
		chunks++;
		idx += cs;
	}
	g.steps += chunks + 1;
	out.i = chunks;
	out.s.clear();
	format(out.s, "safely grouped items into chunks ", chunks);
	out
}
@end
