	var out = v;
	let pairs = g.n / 2;
	for i in pairs {
		let idx1 = 2 * i;
		let idx2 = 2 * i + 1;
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "reversed ", pairs, " result pairs");
	out
}
@end
