	var base byte[..200] = "";
	for c in out.s { base.push(c); }
	while out.s.len + base.len <= lim && out.s.len < 200 {
		for c in base {
			if out.s.len < 200 { out.s.push(c); }
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
