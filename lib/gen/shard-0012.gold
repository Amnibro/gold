code:
fn ${ID}(n int) int {
	let lim = ${bound};
	var val = n;
	if val > lim {
		return lim;
	}
	var temp = val;
	var mult = 1;
	while temp >= 10 {
		mult = mult * 10;
		temp = temp / 10;
	}
	let first = val / mult;
	let rest = val % mult;
	let rot = rest * 10 + first;
	if rot <= lim {
		return rot;
	}
	return val;
}
