phrase: combine first {count} items into total
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=6 r=0.0 ok=true s="grouped first items sum 6" errors=0 n=3 res=[6,4,5] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=30 r=0.0 ok=true s="grouped first items sum 30" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 1 || g.n == 0 { return out; }
	var lim = c;
	if lim > g.n { lim = g.n; }
	var acc = 0;
	for el in lim { acc += g.res[el]; }
	g.res[0] = acc;
	var dest = 1;
	var src = lim;
	while src < g.n {
		g.res[dest] = g.res[src];
		dest++;
		src++;
	}
	g.steps += g.n;
	g.n = dest;
	out.i = acc;
	out.s.clear();
	format(out.s, "grouped first items sum ", acc);
	out
}
@end
@entry 566d964092e7884a
kind: step
verb: split
noun: series
modifier: at_most
context: transform
phrase: split series into at most {parts} segments
phrase: divide series into at most {parts} portions
slot: parts int
test: list=1,2,3,4,5,6 parts=2
expect: => i=2 r=0.0 ok=true s="split series into 2 parts" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 parts=3
expect: => i=3 r=0.0 ok=true s="split series into 3 parts" errors=0 n=3 res=[10,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 || g.n == 0 { return out; }
	var seg_len = g.n / p;
	if seg_len < 1 { seg_len = 1; }
	var seg_count = 0;
	var read_pos = 0;
	var write_pos = 0;
	while read_pos < g.n && seg_count < p {
		var chunk_sum = 0;
		var cnt = 0;
		while read_pos < g.n && (cnt < seg_len || seg_count == p - 1) {
			chunk_sum += g.res[read_pos];
			cnt++;
			read_pos++;
		}
		g.res[write_pos] = chunk_sum;
		write_pos++;
		seg_count++;
	}
	g.steps += g.n;
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "split series into ", write_pos, " parts");
	out
}
@end
