@entry 8d08411fc25459c6
kind: step
verb: repeat
noun: pairs
modifier: in_reverse
context: filter
phrase: repeat filtered pairs in reverse direction
phrase: duplicate filter item pairs backwards
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="repeated 4 pairs in reverse" errors=0 n=8 res=[3,4,3,4,1,2,1,2] cache=0 hits=0
test: list=10,20,30,40,50,60
expect: => i=6 r=0.0 ok=true s="repeated 6 pairs in reverse" errors=0 n=12 res=[50,60,50,60,30,40,30,40,10,20,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 1 {
		temp[count] = g.res[i - 1];
		temp[count + 1] = g.res[i];
		temp[count + 2] = g.res[i - 1];
		temp[count + 3] = g.res[i];
		count += 4;
		i -= 2;
	}
	for k in count {
		g.res[k] = temp[k];
	}
	g.steps += g.n + count;
	g.n = count;
	out.i = count / 2;
	out.s.clear();
	format(out.s, "repeated ", out.i, " pairs in reverse");
	out
}
@end
