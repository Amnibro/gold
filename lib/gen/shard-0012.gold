fn ${ID}(g Gold&, v Val) Val {
	let t = ${times};
	var out = v;
	if g.n >= 2 && t > 0 {
		var min_i = 0;
		var max_i = 0;
		for i in 1..g.n {
			if g.res[i] < g.res[min_i] { min_i = i; }
			if g.res[i] > g.res[max_i] { max_i = i; }
		}
		let tmp = g.res[min_i];
		g.res[min_i] = g.res[max_i];
		g.res[max_i] = tmp;
		gold_cache_put(g, 1, g.res[min_i]);
		gold_cache_put(g, 2, g.res[max_i]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "values swapped");
	out
}
