code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var max_val = -999999;
	var found = false;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h {
			if !found || g.res[i] > max_val {
				max_val = g.res[i];
				found = true;
			}
		}
	}
	if found {
		gold_push(g, max_val);
		out.i = max_val;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
