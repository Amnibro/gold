@entry 40ea698244443b23
kind: step
verb: trace
noun: duplicates
modifier: sorted
context: cache
phrase: trace duplicate cache entries into sorted list
phrase: record sorted duplicate values using cache frequency
test: list=5,2,5,3,2
expect: => i=2 r=0.0 ok=true s="traced 2 sorted duplicates" errors=0 n=2 res=[2,5] cache=2 hits=0
test: list=9,9,9,1
expect: => i=1 r=0.0 ok=true s="traced 1 sorted duplicates" errors=0 n=1 res=[9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { count++; }
		}
		if count > 1 {
			var seen = false;
			for j in dupes {
				if g.res[j] == g.res[i] { seen = true; break; }
			}
			if !seen {
				let val = g.res[i];
				g.res[dupes] = val;
				gold_cache_put(g, dupes, val);
				dupes++;
			}
		}
	}
	g.n = dupes;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = dupes;
	out.s.clear();
	format(out.s, "traced ", dupes, " sorted duplicates");
	out
}
@end
