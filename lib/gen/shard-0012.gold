code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_size = ${interval};
	if step_size <= 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i += step_size;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " checkpoint results");
	out
}
@end
