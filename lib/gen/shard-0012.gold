kind: step
verb: dedupe
noun: series
modifier: nested
context: aggregate
phrase: dedupe nested series values in aggregate
phrase: remove repeated elements across nested series
test: list=10,20,10,30,20,40
expect: => i=100 r=0.0 ok=true s="deduped series unique items: 4 sum: 100" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,15,5,25,15
expect: => i=45 r=0.0 ok=true s="deduped series unique items: 3 sum: 45" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var sum = 0;
	for i in g.n {
		var found = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				found = true;
				break;
			}
		}
		if !found {
			g.res[kept] = g.res[i];
			sum += g.res[i];
			kept++;
		}
	}
	g.steps += g.n * kept;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "deduped series unique items: ", kept, " sum: ", sum);
	out
}
@end
