fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	var modified = 0;
	var run_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			run_len++;
			if run_len > ms {
				g.res[i] = 0;
				modified++;
			}
		} else {
			run_len = 1;
		}
	}
	g.steps += g.n + 1;
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized streak count ", modified);
	out
}
