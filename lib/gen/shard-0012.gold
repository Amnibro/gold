code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	while out.i < th && count < 50 {
		out.i = out.i * 2 + 1;
		count++;
		g.steps++;
	}
	gold_push(g, out.i);
	out.s.clear();
	format(out.s, "shifted step while under threshold count ", count);
	out
}
@end
