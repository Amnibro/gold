		return out;
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		let cur_freq, found = gold_cache_get(g, val);
		let next_freq = if found { cur_freq + 1 } else { 1 };
		gold_cache_put(g, val, next_freq);
		count++;
		if next_freq >= cap {
			break;
		}
		i++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " items until histogram cap");
	out
}
