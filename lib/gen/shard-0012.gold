test: input=80308
expect: => i=3 r=0.0 ok=true s="sorted unique digits" errors=0 n=3 res=[0,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 {
		num = -num;
	}
	gold_clear(g);
	if num == 0 {
		gold_push(g, 0);
		out.i = 1;
		return out;
	}
	var present = [false; 10];
	while num > 0 {
		let d = num % 10;
		present[d] = true;
		num /= 10;
	}
	var count = 0;
	var d = 0;
	while d < 10 {
		if present[d] {
			gold_push(g, d);
			count++;
		}
		d++;
	}
	g.steps += 10;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted unique digits");
	out
}
@end
@entry ef4c2f494f78d551
kind: step
verb: join
noun: runs
modifier: in_reverse
context: stats
phrase: join run lengths in reverse sequence
phrase: append run lengths in reverse order
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="joined runs in reverse" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=5,5,5,5,9
expect: => i=2 r=0.0 ok=true s="joined runs in reverse" errors=0 n=2 res=[1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var runs = [0; 64];
	var rc = 0;
	var cur_val = g.res[0];
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			if rc < 64 {
				runs[rc] = cur_len;
				rc++;
			}
			cur_val = g.res[i];
			cur_len = 1;
		}
		i++;
	}
	if rc < 64 {
		runs[rc] = cur_len;
		rc++;
	}
	gold_clear(g);
	var j = rc - 1;
	while j >= 0 {
		gold_push(g, runs[j]);
		j--;
	}
	g.steps += g.n + rc;
	out.i = rc;
	out.s.clear();
	format(out.s, "joined runs in reverse");
	out
}
@end
