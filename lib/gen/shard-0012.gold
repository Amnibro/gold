test: list=6,8 max_tries=3
expect: => i=2 r=0.0 ok=true s="filtered prefix cache with retry in 2 tries" errors=0 n=2 res=[6,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${max_tries};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var tries = 0;
	var kept = 0;
	var thresh = 10;
	while tries < max_tries {
		tries++;
		kept = 0;
		for k in g.cn {
			if g.cv[k] >= thresh {
				g.res[kept] = g.cv[k];
				kept++;
			}
		}
		if kept > 0 { break; }
		thresh /= 2;
	}
	g.n = kept;
	g.steps += tries;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered prefix cache with retry in ", tries, " tries");
	out
}
@end
