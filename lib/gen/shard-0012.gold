		if g.res[i] >= max_seen {
			max_seen = g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "running filter kept: ", kept);
	out
}
@end
@entry 94d8d531d244de60
kind: step
verb: dedupe
noun: gaps
modifier: running
context: filter
phrase: dedupe running gaps between filtered elements
phrase: remove duplicate adjacent gap sizes while filtering
test: list=2,5,8,12,15
expect: => i=4 r=0.0 ok=true s="deduped running gaps kept: 4" errors=0 n=4 res=[2,5,12,15] cache=0 hits=0
test: list=10,20,30,45,55
expect: => i=4 r=0.0 ok=true s="deduped running gaps kept: 4" errors=0 n=4 res=[10,20,45,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		g.steps++;
		out.i = g.n;
		return out;
	}
	var kept = 2;
	var last_gap = g.res[1] - g.res[0];
	var i = 2;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap != last_gap {
			g.res[kept] = g.res[i];
			kept++;
			last_gap = gap;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped running gaps kept: ", kept);
	out
}
@end
@entry afa676f3f66691c7
kind: step
verb: return
noun: number
modifier: times
context: filter
slot: count int
phrase: return filtered number of times {count}
phrase: output filtered frequency count {count}
test: list=3,5,3,7,3,9 count=3
expect: => i=3 r=0.0 ok=true s="matched frequency elements: 3" errors=0 n=6 res=[3,5,3,7,3,9] cache=0 hits=0
test: list=2,4,2,6,8,2 count=2
expect: => i=0 r=0.0 ok=true s="matched frequency elements: 0" errors=0 n=6 res=[2,4,2,6,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_count = ${count};
	var matched = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { freq++; }
		}
		if freq == target_count {
			matched++;
		}
	}
	g.steps += g.n * g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched frequency elements: ", matched);
	out
}
@end
@entry 7759644509f94270
