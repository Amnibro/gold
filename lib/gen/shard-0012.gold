code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
		}
	}
	out.s.clear();
	format(out.s, "sorted after ", swaps, " swaps: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = swaps;
	g.steps += g.n * g.n;
	out
}
@end
