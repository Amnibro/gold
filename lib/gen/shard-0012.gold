test: list=10,20,30,40
expect: => i=30 r=0.0 ok=true s="rotated values at least" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for _ in 2 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated values at least");
	out
}
@end
