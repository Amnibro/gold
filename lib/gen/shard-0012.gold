noun: middle
modifier: sorted
context: compare
slot: margin int
phrase: run middle sorted range within comparison margin {margin}
phrase: filter sorted middle elements within margin {margin}
test: list=2,5,10,12,15,20,30 margin=5
expect: => i=3 r=0.0 ok=true s="elements within sorted middle margin 3" errors=0 n=8 res=[2,5,10,12,15,20,30,3] cache=0 hits=0
test: list=1,10,20 margin=2
expect: => i=1 r=0.0 ok=true s="elements within sorted middle margin 1" errors=0 n=4 res=[1,10,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid_val = g.res[g.n / 2];
	var within = 0;
	for i in g.n {
		let diff = g.res[i] - mid_val;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= m { within++; }
	}
	gold_push(g, within);
	g.steps += g.n + 1;
	out.i = within;
	out.s.clear();
	format(out.s, "elements within sorted middle margin ", within);
	out
}
@end
