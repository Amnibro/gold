@entry dd0d6bc6f990e3a6
kind: step
verb: dedupe
noun: primes
modifier: until
context: list
phrase: dedupe prime elements until threshold {limit}
phrase: remove duplicate prime entries below {limit}
slot: limit int
test: list=2,2,3,4,3,5 limit=10
expect: => i=2 r=0.0 ok=true s="deduped 2 prime duplicates" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=7,7,7,9 limit=10
expect: => i=2 r=0.0 ok=true s="deduped 2 prime duplicates" errors=0 n=2 res=[7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	var removed = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = x >= 2 && x <= lim;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		var duplicate = false;
		if is_p {
			for j in kept {
				if g.res[j] == x {
					duplicate = true;
					break;
				}
			}
		}
		if duplicate {
			removed++;
		} else {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " prime duplicates");
	out
}
@end
@entry 00a9567225ace19f
kind: step
verb: dedupe
noun: histogram
modifier: up_to
context: list
phrase: dedupe list histogram up to frequency {limit}
phrase: restrict repeated occurrences up to {limit}
slot: limit int
test: list=1,1,1,2,2,3 limit=2
expect: => i=1 r=0.0 ok=true s="removed 1 excess duplicates" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 limit=1
expect: => i=3 r=0.0 ok=true s="removed 3 excess duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_freq = ${limit};
	var kept = 0;
	var removed = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		for j in kept {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq < max_freq {
			g.res[kept] = x;
			kept++;
		} else {
			removed++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " excess duplicates");
	out
}
@end
