code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var total = 0;
	var retried = 0;
	for i in g.n {
		if g.res[i] < 0 {
			retried++;
			total += -g.res[i];
		} else {
			total += g.res[i];
		}
	}
	if retried > retries {
		gold_fail(g, "retry attempts exceeded in error total grouping");
		out.ok = false;
	}
	gold_push(g, total);
	g.steps += g.n + retried;
	out.i = total;
	out.s.clear();
	format(out.s, "grouped total with retry ", total);
	out
}
@end
