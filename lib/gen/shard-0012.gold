fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var start = if g.n > 3 { g.n - 3 } else { 0 };
	var i = start;
	while i < g.n {
		if g.res[i] < l { g.res[i] = l; }
		if g.res[i] > h { g.res[i] = h; }
		i++;
	}
	out.i = g.n - start;
	g.steps += g.n - start;
	out
}
@end
