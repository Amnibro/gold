@entry 7a71b59132f446ec
kind: step
verb: repeat
noun: budget
modifier: at_least
context: list
phrase: repeat elements until list reaches at least {target}
phrase: extend list repeating items to length {target}
slot: target int
test: list=1,2 target=5
expect: => i=5 r=0.0 ok=true s="extended list to 5 items" errors=0 n=5 res=[1,2,1,2,1] cache=0 hits=0
test: list=10,20,30 target=4
expect: => i=4 r=0.0 ok=true s="extended list to 4 items" errors=0 n=4 res=[10,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	if g.n == 0 || g.n >= goal {
		return out;
	}
	let orig = g.n;
	var i = 0;
	while g.n < goal {
		gold_push(g, g.res[i % orig]);
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "extended list to ", g.n, " items");
	out
}
@end
@entry c198c36a80809660
kind: step
