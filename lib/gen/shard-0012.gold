@entry 24afa8972c32e0cd
kind: step
verb: drop
noun: text
modifier: each
context: text
phrase: drop each matching character {target} from text
phrase: remove each occurrence of target byte {target} from text
slot: target int
test: text="banana" target=97
expect: => i=3 r=0.0 ok=true s="bnn" errors=0 n=0 res=[] cache=0 hits=0
