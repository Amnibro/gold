@entry 2b25df7fdeeda319
kind: step
verb: merge
noun: spaces
modifier: at_least
context: text
slot: min_spaces int
phrase: merge multiple spaces into single space if at least {min_spaces}
phrase: collapse consecutive space runs of at least {min_spaces} in text
test: text="a   b  c" min_spaces=2
expect: => i=5 r=0.0 ok=true s="a b c" errors=0 n=0 res=[] cache=0 hits=0
test: text="x    y z" min_spaces=3
expect: => i=5 r=0.0 ok=true s="x y z" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_spaces};
	var temp byte[..200] = "";
	var spaces = 0;
	for k in out.s.len {
		if out.s[k] == ' ' {
			spaces++;
		} else {
			if spaces >= min_s {
				if temp.len < 200 { temp.push(' '); }
			} else {
				for s in spaces {
					if temp.len < 200 { temp.push(' '); }
				}
			}
			spaces = 0;
