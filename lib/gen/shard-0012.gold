@entry 04d30710f88ee7f4
kind: step
verb: check
noun: limit
modifier: last
context: search
phrase: check whether last search result meets limit {limit}
phrase: verify trailing item value against limit {limit}
slot: limit int
test: list=10,20,30 limit=25
expect: => i=30 r=0.0 ok=true s="last meets limit: true" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,10,15 limit=20
expect: => i=15 r=0.0 ok=false s="last meets limit: false" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let lim = ${limit};
	let last = g.res[g.n - 1];
	let meets = last >= lim;
	g.steps += 1;
	out.ok = meets;
	out.i = last;
	out.s.clear();
	format(out.s, "last meets limit: ", meets);
	out
}
@end
@entry 6a45deca38ae23f2
kind: step
verb: merge
noun: vowels
modifier: in_place
context: search
phrase: merge vowels in place within query text
phrase: filter query text in place retaining vowels
test: text="search query"
expect: => i=4 r=0.0 ok=true s="eaue" errors=0 n=0 res=[] cache=0 hits=0
test: text="algorithm"
expect: => i=3 r=0.0 ok=true s="aoi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			out.s[kept] = c;
			kept++;
		}
	}
	while out.s.len > kept {
		out.s.pop();
	}
	g.steps += out.s.len;
	out.i = kept;
	out
}
@end
@entry 068c40aedf52f967
kind: step
verb: scale
noun: squares
modifier: unique
context: search
phrase: scale unique values by their squared rank
phrase: multiply distinct search elements by square of {factor}
slot: factor int
test: list=2,2,3,3 factor=2
expect: => i=4 r=0.0 ok=true s="scaled 4 unique items" errors=0 n=4 res=[8,8,12,12] cache=0 hits=0
test: list=5,5,5 factor=3
expect: => i=3 r=0.0 ok=true s="scaled 3 unique items" errors=0 n=3 res=[45,45,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let mult = f * f;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var is_first = true;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { is_first = false; break; }
			j++;
		}
		if is_first {
			g.res[unique_count] = g.res[i] * mult;
			unique_count++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	g.n = unique_count;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "scaled ", unique_count, " unique items");
	out
}
@end
