code:
fn ${ID}_isp(num int) bool {
	if num < 2 { return false; }
	var d = 2;
	while d * d <= num {
		if num % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var filled = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${ID}_isp(g.res[i]) && ${ID}_isp(g.res[i + 1]) {
			let avg = (g.res[i] + g.res[i + 1]) / 2;
			g.res[i] = avg;
			filled++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " prime pairs");
	out
}
@end
