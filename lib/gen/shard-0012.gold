test: list=2,5,9,15 step_size=3 retries=2
expect: => i=3 r=0.0 ok=true s="ranked steps with retries: 3" errors=0 n=4 res=[2,5,9,15] cache=0 hits=0
test: list=1,2,3 step_size=5 retries=1
expect: => i=0 r=0.0 ok=true s="ranked steps with retries: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ss = ${step_size};
	let r = ${retries};
	var count = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d >= ss { count += 1; }
		}
	}
	g.steps += g.n * r + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked steps with retries: ", count);
	out
}
@end
