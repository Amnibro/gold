fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var new_n = 1;
	var max_val = g.res[0];
	var k = 1;
	while k < g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			g.res[new_n] = max_val;
			new_n++;
		}
		k++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filtered tail to ", new_n, " running peaks");
	out
}
