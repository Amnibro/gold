@entry 629059e6e24b742d
kind: step
verb: sort
noun: budget
modifier: in_reverse
context: aggregate
slot: budget int
phrase: sort aggregate under budget {budget} in reverse
phrase: order reverse aggregate items bounded by budget {budget}
test: list=10,50,20,40,30 budget=80
expect: => i=80 r=0.0 ok=true s="sorted reverse budget sum: 80 items: 2" errors=0 n=2 res=[50,30] cache=0 hits=0
test: list=5,25,15,35,45 budget=60
expect: => i=60 r=0.0 ok=true s="sorted reverse budget sum: 60 items: 2" errors=0 n=2 res=[45,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] < g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var total = 0;
	var kept = 0;
	for i in g.n {
		if total + g.res[i] <= b {
			total += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "sorted reverse budget sum: ", total, " items: ", kept);
	out
}
@end
