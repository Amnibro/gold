phrase: compare final cache streak against baseline limit
phrase: evaluate trailing hit streak against target
test: input=1 list=5,10,15
expect: => i=0 r=0.0 ok=false s="last streak 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: input=3 list=2,4
expect: => i=0 r=0.0 ok=false s="last streak 0" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let baseline = if v.i > 0 { v.i } else { 2 };
	var tail_streak = 0;
	var i = g.n - 1;
	while i >= 0 {
		let _, found = gold_cache_get(g, g.res[i]);
		if found { tail_streak++; } else { break; }
		i--;
	}
	g.steps += g.n;
	out.ok = tail_streak >= baseline;
	out.i = tail_streak;
	out.s.clear();
	format(out.s, "last streak ", tail_streak);
	out
}
@end
