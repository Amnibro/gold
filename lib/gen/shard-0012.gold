test: list=5,5,5,5,6,7 cap=3
expect: => i=14 r=0.0 ok=true s="rank counter total score: 14" errors=0 n=6 res=[5,5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${cap};
	var total_rank = 0;
	var kept = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { freq++; }
		}
		if freq > max_c { freq = max_c; }
		total_rank += freq;
		if freq <= max_c {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = total_rank;
	out.s.clear();
	format(out.s, "rank counter total score: ", total_rank);
	out
}
@end
@entry ae4ed95efd25d460
kind: step
verb: return
noun: average
modifier: up_to
context: filter
slot: limit int
phrase: return filtered average up to limit {limit}
phrase: compute average of filtered elements up to index {limit}
test: list=10,20,30,40 limit=3
expect: => i=20 r=0.0 ok=true s="filtered average up to limit: 20" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=100,200,300,400 limit=2
expect: => i=150 r=0.0 ok=true s="filtered average up to limit: 150" errors=0 n=1 res=[200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 || lim <= 0 {
		gold_fail(g, "invalid bounds for average filter");
		out.ok = false;
		return out;
	}
	var count = 0;
	var sum = 0;
	for i in g.n {
		if i >= lim { break; }
		sum += g.res[i];
		count++;
	}
	let avg = sum / count;
	var kept = 0;
	for i in g.n {
		if i < lim && g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = avg;
	out.s.clear();
	format(out.s, "filtered average up to limit: ", avg);
	out
}
@end
