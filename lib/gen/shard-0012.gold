code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept {
		var j = i + 1;
		while j < kept {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var sum = 0;
	for i in kept {
		sum += g.res[i];
	}
	g.steps += g.n + kept * kept;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded ", kept, " sorted evens: ", sum);
	out
}
