@entry b0ca6320c84147ea
kind: step
verb: pair
noun: histogram
modifier: unique
context: math
phrase: compute unique pairwise products from histogram
phrase: pair unique histogram frequencies across elements
test: list=1,1,2,2,3
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,4,4,5,5,6
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[4,4,4,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	var vals int[512] = [0; 512];
	var freqs int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for u in unique { if vals[u] == x { idx = u; break; } }
		if idx >= 0 { freqs[idx] += 1; }
		else {
			vals[unique] = x;
			freqs[unique] = 1;
			unique++;
		}
	}
	var total = 0;
	var i = 0;
	while i + 1 < unique {
		total += freqs[i] * freqs[i + 1];
		i += 2;
	}
	out.i = total;
	g.steps += g.n * g.n;
	out
}
@end
