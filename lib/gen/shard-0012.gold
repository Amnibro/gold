@entry f1715c797e5c459b
kind: step
verb: limit
noun: pairs
modifier: recursively
context: transform
phrase: recursively limit adjacent pair sums to {ceiling}
phrase: iteratively cap consecutive pair sums by {ceiling}
slot: ceiling int
test: list=30,40,50 ceiling=60
expect: => i=2 r=0.0 ok=true s="limited pairs recursively in 2 passes" errors=0 n=3 res=[25,24,35] cache=0 hits=0
test: list=15,25,35 ceiling=40
expect: => i=1 r=0.0 ok=true s="limited pairs recursively in 1 passes" errors=0 n=3 res=[15,16,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var adjustments = 0;
	var changed = true;
	while changed && adjustments < 50 {
		changed = false;
		var p_idx = 0;
		while p_idx + 1 < g.n {
			let pair_sum = g.res[p_idx] + g.res[p_idx + 1];
			if pair_sum > lim {
				g.res[p_idx] = (g.res[p_idx] * lim) / pair_sum;
				g.res[p_idx + 1] = (g.res[p_idx + 1] * lim) / pair_sum;
				changed = true;
				adjustments++;
			}
			p_idx++;
		}
	}
	g.steps += adjustments * g.n;
	out.i = adjustments;
	out.s.clear();
	format(out.s, "limited pairs recursively in ", adjustments, " passes");
	out
}
@end
