fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var above = 0;
	for i in g.n {
		if g.res[i] >= avg { above++; }
	}
	g.steps += g.n;
	out.i = above;
	out.s.clear();
	format(out.s, "grouped ", above, " items at or above average ", avg);
	out
}
