code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var max_idx = 0;
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	for i in max_idx..g.n - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "dropped maximum value ", max_val);
	out
}
@end
