fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	var actual = if count > g.n { g.n } else { count };
	var sum = 0;
	var i = g.n - actual;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += actual;
	out.i = sum;
	out.s.clear();
	format(out.s, "suffix sum is ", sum);
