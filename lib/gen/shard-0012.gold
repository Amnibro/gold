@entry 466d6f9ee8d4204a
kind: step
verb: drop
noun: budget
modifier: sorted
context: core
phrase: drop elements exceeding budget {limit} after sorting
phrase: sort list discarding elements beyond budget {limit}
slot: limit int
test: list=4,1,3,2 limit=6
expect: => i=1 r=0.0 ok=true s="dropped 1 items exceeding budget" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,5,15 limit=12
expect: => i=2 r=0.0 ok=true s="dropped 2 items exceeding budget" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var sum = 0;
	var keep = 0;
	while keep < g.n {
		if sum + g.res[keep] > limit {
			break;
		}
		sum += g.res[keep];
		keep++;
	}
	let dropped = g.n - keep;
	g.n = keep;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items exceeding budget");
	out
}
@end
