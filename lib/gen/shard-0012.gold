fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	if sum <= ms && g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		out.ok = true;
	} else {
		out.ok = false;
	}
	out.i = sum;
	g.steps += g.n;
	out
}
@end
