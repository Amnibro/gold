code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for k in g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
		}
	}
	for k in retries {
		gold_push(g, max_val);
	}
	g.steps += retries;
	out.i = max_val;
	out.s.clear();
	format(out.s, "repeated maximum ", retries, " times");
	out
}
@end
