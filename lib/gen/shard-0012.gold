@entry 8c4dda7b558eb702
kind: step
verb: swap
noun: gaps
modifier: at_least
context: format
slot: min_gap int
phrase: format list after swapping gaps reaching at least {min_gap}
phrase: display values with swapped pairs having difference at least {min_gap}
test: list=10,25,30,50 min_gap=15
expect: => i=2 r=0.0 ok=true s="gap swapped: [25, 10, 50, 30]" errors=0 n=4 res=[25,10,50,30] cache=0 hits=0
test: list=1,20,30,32 min_gap=10
expect: => i=1 r=0.0 ok=true s="gap swapped: [20, 1, 30, 32]" errors=0 n=4 res=[20,1,30,32] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff >= mg {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	out.s.clear();
	format(out.s, "gap swapped: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
