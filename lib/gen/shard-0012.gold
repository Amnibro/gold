@entry 82d31a2cf9037534
kind: step
verb: dedupe
noun: odds
modifier: times
context: search
phrase: dedupe odd search values appearing multiple times
phrase: prune duplicate odd scores in query results
test: list=3,4,3,5,3,6
expect: => i=2 r=0.0 ok=true s="deduped 2 repeated odds" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=7,7,8,9,7
expect: => i=2 r=0.0 ok=true s="deduped 2 repeated odds" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	var removed = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			var seen = false;
			for j in new_n {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if seen {
				removed++;
				continue;
			}
		}
		g.res[new_n] = x;
		new_n++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " repeated odds");
	out
}
@end
