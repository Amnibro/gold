@entry 88f8a335864c1fbc
kind: step
verb: cache
noun: tally
modifier: with_cache
context: filter
phrase: cache element frequency tally in storage
phrase: record distinct item tally with cache
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="cached tally of 3 unique keys" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=3
test: list=10,10,20,20,30
expect: => i=3 r=0.0 ok=true s="cached tally of 3 unique keys" errors=0 n=5 res=[10,10,20,20,30] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			gold_cache_put(g, k, val + 1);
		} else {
			gold_cache_put(g, k, 1);
			distinct++;
		}
	}
	g.steps += g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "cached tally of ", distinct, " unique keys");
	out
}
@end
@entry 170a5f3b4a14a518
kind: step
verb: sort
noun: series
modifier: between
context: filter
phrase: sort series elements between indices {start} upper {stop}
phrase: order series slice between {start} upper {stop}
slot: start int
slot: stop int
test: list=5,4,3,2,1 start=1 stop=3
expect: => i=3 r=0.0 ok=true s="sorted series between 1 upper 3" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=9,8,7,6,5 start=0 stop=2
expect: => i=3 r=0.0 ok=true s="sorted series between 0 upper 2" errors=0 n=5 res=[7,8,9,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${stop};
	var valid_e = e;
	if valid_e >= g.n { valid_e = g.n - 1; }
	if s >= 0 && s < valid_e {
		for i in s..(valid_e + 1) {
			for j in (i + 1)..(valid_e + 1) {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = valid_e - s + 1;
	out.s.clear();
	format(out.s, "sorted series between ", s, " upper ", valid_e);
	out
}
@end
