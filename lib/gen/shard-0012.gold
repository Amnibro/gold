code:
fn ${ID}_chk_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let p1 = ${ID}_chk_p(g.res[i]);
		let p2 = ${ID}_chk_p(g.res[i + 1]);
		if p1 && p2 {
			prime_pairs++;
		} else {
			g.res[i] = 0;
			g.res[i + 1] = 0;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = prime_pairs;
	out.s.clear();
	format(out.s, "split ", prime_pairs, " pairwise primes");
	out
}
@end
