code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	let suf_len = g.n - half;
	let pairs = suf_len / 2;
	for i in pairs {
		let idx1 = half + 2 * i;
		let idx2 = half + 2 * i + 1;
		g.res[i] = g.res[idx1] + g.res[idx2];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " suffix items");
	out
}
@end
