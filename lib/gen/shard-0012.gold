code:
fn ${ID}(g Gold&, v Val) Val {
    var detected_period = 0;
    if g.n >= 2 {
        for period in 1..(g.n / 2 + 1) {
            var is_periodic = true;
            for i in period..g.n {
                if g.res[i] != g.res[i - period] {
                    is_periodic = false;
                    break;
                }
            }
            if is_periodic {
                detected_period = period;
                break;
            }
        }
    }
    gold_push(g, detected_period);
    v.i = detected_period;
    v.ok = detected_period > 0;
    v
}
@end
