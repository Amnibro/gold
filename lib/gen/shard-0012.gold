code:
fn ${ID}(n int) bool {
	let target = ${min_count};
	var x = if n < 0 { -n } else { n };
	var mask = 0;
	var count = 0;
	while x > 0 {
		let dig = x % 10;
		let bit = 1 << dig;
		if (mask & bit) == 0 {
			mask |= bit;
			count++;
		}
		x /= 10;
	}
	count >= target
}
@end
