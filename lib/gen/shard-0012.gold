code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for idx in half {
		let tmp = g.res[idx];
		let opp = g.n - 1 - idx;
		g.res[idx] = g.res[opp];
		g.res[opp] = tmp;
	}
	g.steps += half;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed all ", g.n, " checkpoint items");
	out
}
@end
