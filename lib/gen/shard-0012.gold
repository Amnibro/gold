	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j + 1] >= g.res[j] { j++; }
		if j > i {
			var left = i;
			var right = j;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			run_count++;
			i = j + 1;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = run_count;
	out.s.clear();
	format(out.s, "reversed ", run_count, " monotonic runs safely");
	out
}
@end
