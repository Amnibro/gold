@entry 1b48be4d59956783
kind: step
verb: validate
noun: squares
modifier: until
context: list
phrase: validate elements are squares until index {count}
phrase: check prefix values are perfect squares through {count}
slot: count int
test: list=4,9,16,5 count=3
expect: => i=3 r=0.0 ok=true s="validated 3 squares" errors=0 n=4 res=[4,9,16,5] cache=0 hits=0
test: list=4,5,9 count=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[4,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var m = k;
	if m > g.n {
		m = g.n;
	}
	var i = 0;
	while i < m {
		let x = g.res[i];
		var sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x {
					sq = true;
					break;
				}
				r++;
			}
		}
		if !sq {
			gold_fail(g, "element not a square");
			out.ok = false;
			return out;
		}
		i++;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "validated ", m, " squares");
	out
}
@end
