	var out = v;
	if g.n == 0 { return out; }
	var min_i = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_i] { min_i = i; }
	}
	g.res[min_i] = -g.res[min_i];
	if g.res[min_i] < 0 {
		gold_fail(g, "inverted value became negative");
	}
	out.i = g.res[min_i];
	out.s.clear();
	format(out.s, "inverted min ", g.res[min_i]);
	out
}
@end
