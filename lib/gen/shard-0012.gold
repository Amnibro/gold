@entry c0f3376f82a0d14a
kind: step
verb: measure
noun: text
modifier: running
context: format
phrase: measure running character lengths formatting text
phrase: display running text measurements across words
test: text="hello brave world"
expect: => i=15 r=0.0 ok=true s="running lengths: [5, 10, 15]" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: text="simple test run"
expect: => i=13 r=0.0 ok=true s="running lengths: [6, 10, 13]" errors=0 n=3 res=[6,10,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var run = 0;
	out.s.clear();
	format(out.s, "running lengths: [");
	var word_len = 0;
	var count = 0;
	for b in v.s {
		if b == ' ' {
			if word_len > 0 {
				run += word_len;
				gold_push(g, run);
				if count > 0 { format(out.s, ", "); }
				format(out.s, run);
				count++;
				word_len = 0;
			}
		} else {
			word_len++;
		}
	}
	if word_len > 0 {
		run += word_len;
		gold_push(g, run);
		if count > 0 { format(out.s, ", "); }
		format(out.s, run);
		count++;
	}
	format(out.s, "]");
	out.i = run;
	g.steps += v.s.len;
	out
}
@end
