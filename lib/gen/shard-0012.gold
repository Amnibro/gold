@entry 14b1d4daa76e71ab
kind: step
verb: drop
noun: items
modifier: pairwise
context: loop
phrase: drop items pairwise across loop results
phrase: remove adjacent duplicate loop elements pairwise
test: list=1,1,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="dropped pairwise loop duplicates 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6,7,8,8
expect: => i=2 r=0.0 ok=true s="dropped pairwise loop duplicates 2" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.steps += 1;
		return out;
	}
	var kept int[512] = [0; 512];
	var kn = 0;
	kept[kn] = g.res[0];
	kn++;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	let dropped = g.n - kn;
	g.n = kn;
	for i in kn {
		g.res[i] = kept[i];
	}
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped pairwise loop duplicates ", dropped);
	out
}
@end
