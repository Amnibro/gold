expect: => i=50 r=0.0 ok=false s="validation failed sum: 50" errors=1 n=4 res=[15,2,25,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var valid = true;
	var total = 0;
	for i in g.n {
		if g.res[i] < mv {
			valid = false;
		}
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	if valid {
		format(out.s, "all items valid sum: ", total);
	} else {
		gold_fail(g, "aggregate items failed minimum validation");
		out.ok = false;
		format(out.s, "validation failed sum: ", total);
	}
	out
}
@end
