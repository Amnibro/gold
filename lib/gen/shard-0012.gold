code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_words};
	var words = 0;
	var in_word = false;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if in_word { words++; in_word = false; }
		} else {
			in_word = true;
		}
	}
	if in_word { words++; }
	if words < limit {
		gold_fail(g, "word count below error cache threshold");
		out.ok = false;
	} else {
		gold_cache_put(g, 2, words);
	}
	g.steps += out.s.len + 1;
	out.i = words;
	out.s.clear();
	format(out.s, "cached words count ", words);
	out
}
@end
