code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	var write_idx = 0;
	var dropped = 0;
	for i in out.s.len {
		let b = out.s[i] as int;
		if b == target {
			dropped++;
		} else {
			out.s[write_idx] = out.s[i];
			write_idx++;
		}
	}
	out.s.resize(write_idx, 0 as byte);
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
