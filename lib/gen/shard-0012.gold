expect: => i=2 r=0.0 ok=true s="normalized last window count 2" errors=0 n=3 res=[5,0,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${window_size};
	let take = if ws < g.n { ws } else { g.n };
	let start = g.n - take;
	if take > 0 {
		var min_val = g.res[start];
		for i in 1..take {
			if g.res[start + i] < min_val { min_val = g.res[start + i]; }
		}
		for i in take {
			g.res[start + i] -= min_val;
		}
	}
	g.steps += take + 1;
	out.i = take;
	out.s.clear();
	format(out.s, "normalized last window count ", take);
	out
}
@end
