@entry f62e026f26c8b3f1
kind: step
verb: dedupe
noun: primes
modifier: at_most
context: cache
phrase: dedupe prime numbers into cache at most limit {cap}
phrase: filter unique primes in cache up to {cap} values
slot: cap int
test: list=2,3,4,5,2 cap=5
expect: => i=3 r=0.0 ok=true s="deduped 3 primes at most limit" errors=0 n=3 res=[2,3,5] cache=3 hits=0
test: list=7,11,13 cap=2
expect: => i=2 r=0.0 ok=true s="deduped 2 primes at most limit" errors=0 n=2 res=[7,11] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var pcount = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			var seen = false;
			for j in pcount {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen && pcount < cap {
				g.res[pcount] = x;
				gold_cache_put(g, pcount, x);
				pcount++;
			}
		}
	}
	g.n = pcount;
	g.steps += g.n;
	out.i = pcount;
	out.s.clear();
	format(out.s, "deduped ", pcount, " primes at most limit");
	out
}
@end
