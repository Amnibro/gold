@entry 4420a4cd9a1e6374
kind: step
verb: rotate
noun: maximum
modifier: unique
context: list
phrase: rotate unique maximum element to front
phrase: place peak value at list start
test: list=2,8,3,5
expect: => i=8 r=0.0 ok=true s="moved maximum 8 to front" errors=0 n=4 res=[8,2,3,5] cache=0 hits=0
test: list=10,20,5
expect: => i=20 r=0.0 ok=true s="moved maximum 20 to front" errors=0 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var max_idx = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
		i++;
	}
	let max_val = g.res[max_idx];
	i = max_idx;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = max_val;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "moved maximum ", max_val, " to front");
	out
}
@end
