code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	gold_clear(g);
	var pairs = 0;
	var i = 0;
	while i + 1 < out.s.len {
		let b1 = out.s[i] as int;
		let b2 = out.s[i + 1] as int;
		if b1 == target || b2 == target {
			break;
		}
		gold_push(g, b1 + b2);
		pairs++;
		i++;
	}
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " items until target");
	out
}
@end
