fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var tmp: int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[i];
	}
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		g.res[write_idx] = tmp[i];
		write_idx++;
		i += 2;
	}
	var j = 1;
	while j < g.n {
		g.res[write_idx] = tmp[j];
		write_idx++;
		j += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped alternating numbers count ", g.n);
	out
}
