code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let last = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = last;
	out.s.clear();
	format(out.s, "rotated retry window");
	out
}
@end
