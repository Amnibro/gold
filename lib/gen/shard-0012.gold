fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${stop_char};
	if sc.len == 0 { return out; }
	let target = sc[0];
	var pos = out.s.len;
	for k in out.s.len {
		if out.s[k] == target {
			pos = k;
			break;
		}
	}
	var temp byte[..200] = "";
	for k in pos { temp.push(out.s[k]); }
	out.s.clear();
	for b in temp { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
