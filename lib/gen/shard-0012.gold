@entry ed32190c4d8fb25a
kind: step
verb: repeat
noun: budget
modifier: at_least
context: aggregate
slot: min_sum int
phrase: repeat aggregate items until budget reaches at least {min_sum}
phrase: duplicate aggregate entries until total is at least {min_sum}
test: list=10,20 min_sum=70
expect: => i=70 r=0.0 ok=true s="repeated until budget reached: 70" errors=0 n=5 res=[10,20,10,20,10] cache=0 hits=0
test: list=5,15,25 min_sum=80
expect: => i=90 r=0.0 ok=true s="repeated until budget reached: 90" errors=0 n=6 res=[5,15,25,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_sum};
	if g.n == 0 {
		gold_fail(g, "empty list for budget repetition");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	var i = 0;
	while total < target && g.n < 500 {
		let val = g.res[i % g.n];
		gold_push(g, val);
		total += val;
		i++;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "repeated until budget reached: ", total);
	out
}
@end
