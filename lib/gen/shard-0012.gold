code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	var i = 0;
	while i <= out.s.len {
		if i == out.s.len || out.s[i] == ' ' {
			var left = start;
			var right = i - 1;
			while left < right {
				let tmp = out.s[left];
				out.s[left] = out.s[right];
				out.s[right] = tmp;
				left++;
				right--;
			}
			start = i + 1;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
