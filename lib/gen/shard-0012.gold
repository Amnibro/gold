test: list=2,4,8 bin_size=5
expect: => i=1 r=0.0 ok=true s="normalized histogram non zero bins 1" errors=0 n=3 res=[0,0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bin_size};
	if bs <= 0 {
		gold_fail(g, "bin size must be positive");
		out.ok = false;
		return out;
	}
	var non_zero = 0;
	for i in g.n {
		let bin_idx = g.res[i] / bs;
		g.res[i] = bin_idx;
		if bin_idx > 0 { non_zero++; }
	}
	g.steps += g.n + 1;
	out.i = non_zero;
	out.s.clear();
	format(out.s, "normalized histogram non zero bins ", non_zero);
	out
}
@end
