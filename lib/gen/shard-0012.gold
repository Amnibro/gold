code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${start};
	let end_idx = ${end};
	let s_len = out.s.len;
	var lo = if start < 0 { 0 } else { start };
	var hi = if end_idx > s_len { s_len } else { end_idx };
	if lo > hi {
		lo = hi;
	}
	let new_len = hi - lo;
	for i in new_len {
		out.s[i] = out.s[lo + i];
	}
	out.s.resize(new_len, 0 as byte);
	g.steps += new_len;
	out.i = new_len;
	out
}
@end
