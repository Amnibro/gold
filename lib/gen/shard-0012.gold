code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	var start = g.n - tl;
	if start < 0 { start = 0; }
	var max_val = -999999;
	var i = start;
	while i < g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "tail peak value: ", max_val);
	out
}
@end
@entry 21a4ab8238351eb1
