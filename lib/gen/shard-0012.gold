modifier: while
context: text
phrase: rotate text right by shift amount {shift}
phrase: cyclic shift string right by offset {shift}
slot: shift int
test: text="hello" shift=1
expect: => i=1 r=0.0 ok=true s="ohell" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcd" shift=2
expect: => i=2 r=0.0 ok=true s="cdab" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 {
		out.i = 0;
		return out;
	}
	var s = ${shift} % out.s.len;
	if s < 0 { s += out.s.len; }
	var rotated byte[..200] = "";
	var i = out.s.len - s;
	while i < out.s.len {
		rotated.push(out.s[i]);
		i++;
	}
	i = 0;
	while i < out.s.len - s {
		rotated.push(out.s[i]);
		i++;
	}
	out.s.clear();
	for c in rotated { out.s.push(c); }
	g.steps += out.s.len;
	out.i = s;
	out
}
@end
