expect: => i=-1 r=0.0 ok=false s="no item within cap" errors=1 n=4 res=[60,70,80,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let upper = ${cap};
	var found = false;
	var min_val = 999999;
	for i in g.n {
		if g.res[i] <= upper && g.res[i] < min_val {
			min_val = g.res[i];
			found = true;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if found {
		out.i = min_val;
		format(out.s, "found minimum capped value: ", min_val);
	} else {
		gold_fail(g, "no aggregate item below cap");
		out.ok = false;
		out.i = -1;
		format(out.s, "no item within cap");
	}
	out
}
@end
