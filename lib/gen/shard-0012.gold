fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_count = 0;
	var last_pos = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found_count++;
			last_pos = i;
		}
	}
	g.steps += g.n;
	out.i = found_count;
	out.s.clear();
	if found_count > 0 {
		format(out.s, "found target ", tgt, " times: ", found_count);
	} else {
		gold_fail(g, "target not found in filter history");
		out.ok = false;
		format(out.s, "target missing");
	}
	out
}
@end
