@entry bb15dbfd65114960
kind: step
verb: group
noun: vowels
modifier: sorted
context: compare
phrase: group vowels sorted alphabetically within text buffer
phrase: order vowel characters in comparison string ascending
test: text="education"
expect: => i=5 r=0.0 ok=true s="aeiou" errors=0 n=0 res=[] cache=0 hits=0
test: text="helium"
expect: => i=3 r=0.0 ok=true s="eiu" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[200] = [0; 200];
	var vn = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels[vn] = c;
			vn++;
		}
	}
	if vn >= 2 {
		for i in vn {
			for j in (i + 1)..vn {
				if vowels[i] > vowels[j] {
					let tmp = vowels[i];
					vowels[i] = vowels[j];
					vowels[j] = tmp;
				}
			}
		}
	}
	g.steps += out.s.len + vn + 1;
	out.i = vn;
	out.s.clear();
	for i in vn { out.s.push(vowels[i]); }
	out
}
@end
