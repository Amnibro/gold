	var out = v;
	var running = 0;
	var write_idx = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			running += g.res[i];
			g.res[write_idx] = running;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "running even total reached ", running);
	out
}
@end
