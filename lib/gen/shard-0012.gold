noun: tail
modifier: at_most
context: cache
phrase: truncate cached tail entries to bounded count
phrase: restrict trailing cache keys to limit
test: input=2 list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="limited tail count 2" errors=0 n=2 res=[40,50] cache=0 hits=0
test: input=3 list=1,2,3,4
expect: => i=3 r=0.0 ok=true s="limited tail count 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = if v.i > 0 { v.i } else { 3 };
	var write = 0;
	if g.n > bound {
		write = g.n - bound;
		for i in bound {
			g.res[i] = g.res[write + i];
		}
		g.n = bound;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited tail count ", g.n);
	out
}
@end
