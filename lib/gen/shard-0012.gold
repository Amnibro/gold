test: list=1,2,3,4,5 min_count=3
expect: => i=0 r=0.0 ok=false s="" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let needed = ${min_count};
    var padded = 0;
    if g.n < needed {
        let diff = needed - g.n;
        for i in 0..g.n {
            let src = g.n - 1 - i;
            g.res[src + diff] = g.res[src];
        }
        for i in 0..diff {
            g.res[i] = 0;
            padded += 1;
        }
        g.n = needed;
    }
    v.i = padded;
    v.ok = padded > 0;
    v
}
@end
