test: list=5,10,15,5,20
expect: => i=1 r=0.0 ok=true s="filtered nested duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == x {
				freq++;
			}
			j++;
		}
		if freq > 1 {
			var already = false;
			var k = 0;
			while k < write_idx {
				if g.res[k] == x {
					already = true;
					break;
				}
				k++;
			}
			if !already {
				g.res[write_idx] = x;
				write_idx++;
			}
		}
		i++;
	}
	g.n = write_idx;
	g.steps += i;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "filtered nested duplicates");
	out
}
@end
@entry 84a260abc366160c
kind: step
