@entry 5f63137ef2a477a3
kind: step
verb: retry
noun: steps
modifier: until
context: list
slot: limit int
phrase: retry stepping through list until value reaches {limit}
phrase: retry steps on results until threshold {limit}
test: list=2,4,7,12,18 limit=10
expect: => i=12 r=0.0 ok=true s="retried steps count: 4" errors=0 n=5 res=[2,4,7,12,18] cache=0 hits=0
test: list=3,6,9,15,21 limit=14
expect: => i=15 r=0.0 ok=true s="retried steps count: 4" errors=0 n=5 res=[3,6,9,15,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var steps_taken = 0;
	var found = false;
	for i in g.n {
		steps_taken++;
		if g.res[i] >= lim {
			found = true;
			out.i = g.res[i];
			break;
		}
	}
	g.steps += steps_taken;
	out.ok = found;
	out.s.clear();
	format(out.s, "retried steps count: ", steps_taken);
	out
}
@end
@entry 0ceefe906f0cfbc9
kind: step
verb: measure
noun: digits
modifier: sorted
context: list
phrase: measure total digits after sorting list items
phrase: count digits of sorted list elements
test: list=45,9,123
expect: => i=6 r=0.0 ok=true s="sorted list digit count: 6" errors=0 n=3 res=[9,45,123] cache=0 hits=0
test: list=1000,20,5
expect: => i=7 r=0.0 ok=true s="sorted list digit count: 7" errors=0 n=3 res=[5,20,1000] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total_digits = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		if x == 0 { total_digits++; }
		while x > 0 { total_digits++; x /= 10; }
	}
	g.steps += g.n * g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "sorted list digit count: ", total_digits);
	out
}
@end
