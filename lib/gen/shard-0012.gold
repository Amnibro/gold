@entry 2ea09da83bbb97b6
kind: step
verb: check
noun: digits
modifier: at_least
context: aggregate
slot: min_digits int
phrase: check whether numbers have at least {min_digits} digits
phrase: verify aggregate items contain at least {min_digits} digits
test: list=15,250,3500 min_digits=2
expect: => i=1 r=0.0 ok=true s="all items have required digit count" errors=0 n=3 res=[15,250,3500] cache=0 hits=0
test: list=5,120,45 min_digits=3
expect: => i=0 r=0.0 ok=false s="item found with insufficient digits" errors=0 n=3 res=[5,120,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_digits};
	var all_ok = true;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var d = 0;
		while x > 0 { d++; x /= 10; }
		if d == 0 { d = 1; }
		if d < req { all_ok = false; break; }
	}
	g.steps += g.n;
	out.ok = all_ok;
	out.i = if all_ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, if all_ok { "all items have required digit count" } else { "item found with insufficient digits" });
	out
}
@end
@entry 17ee8e22a5d70030
kind: step
verb: reverse
noun: words
modifier: unique
context: aggregate
phrase: reverse unique word length measurements in aggregate
phrase: collect unique word counts outputting in reverse
test: text="apple banana cherry"
expect: => i=2 r=0.0 ok=true s="collected 2 unique lengths in reverse" errors=0 n=2 res=[6,5] cache=0 hits=0
test: text="cat dog cat fish"
expect: => i=2 r=0.0 ok=true s="collected 2 unique lengths in reverse" errors=0 n=2 res=[4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur = 0;
	for b in v.s {
		if b == ' ' {
			if cur > 0 {
				var seen = false;
				for k in g.n { if g.res[k] == cur { seen = true; break; } }
				if !seen { gold_push(g, cur); }
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 {
		var seen = false;
		for k in g.n { if g.res[k] == cur { seen = true; break; } }
		if !seen { gold_push(g, cur); }
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += v.s.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected ", g.n, " unique lengths in reverse");
	out
}
@end
