phrase: cycle all odd filtered values with step {step_count}
test: list=1,2,3,4,5 step_count=1
expect: => i=3 r=0.0 ok=true s="rotated 3 odd filtered elements" errors=0 n=5 res=[5,2,1,4,3] cache=0 hits=0
test: list=11,12,13,14,15,16,17 step_count=2
expect: => i=4 r=0.0 ok=true s="rotated 4 odd filtered elements" errors=0 n=7 res=[15,12,17,14,11,16,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${step_count};
	var odd_count = 0;
	var odds = [0; 512];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[odd_count] = g.res[i];
			odd_count++;
		}
	}
	if odd_count > 1 && sc > 0 {
		let shift = sc % odd_count;
		var temp = [0; 512];
		for i in odd_count {
			temp[(i + shift) % odd_count] = odds[i];
		}
		var o_idx = 0;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				g.res[i] = temp[o_idx];
				o_idx++;
			}
		}
	}
	g.steps += g.n + odd_count;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "rotated ", odd_count, " odd filtered elements");
	out
}
@end
