code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var temp = [0; 512];
	var count = 0;
	for i in g.n {
		if count < limit {
			temp[count] = g.res[i];
			count++;
		}
		if g.res[i] % 2 == 0 && count < limit {
			temp[count] = g.res[i];
			count++;
		}
	}
	for i in count {
		g.res[i] = temp[i];
	}
	g.steps += g.n + count;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated evens safely length: ", count);
	out
}
@end
