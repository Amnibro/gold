@entry 84947e6349af6ddf
kind: step
verb: drop
noun: average
modifier: safely
context: core
phrase: safely drop elements falling below average value
phrase: drop values strictly below mean average safely
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="safely dropped 2 items below average" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=2,4,6,8,100
expect: => i=4 r=0.0 ok=true s="safely dropped 4 items below average" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] < avg {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "safely dropped ", dropped, " items below average");
	out
}
@end
