fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
		i++;
	}
	gold_cache_put(g, g.n, max_streak);
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max streak found");
	out
}
@end
