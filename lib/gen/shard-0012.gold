@entry dd52a0d343652131
kind: step
verb: return
noun: average
modifier: last
context: aggregate
slot: count int
phrase: return average of last {count} aggregate items
phrase: compute trailing average across last {count} values
test: list=10,20,30,40,50 count=3
expect: => i=40 r=0.0 ok=true s="last 3 items average: 40" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35 count=2
expect: => i=30 r=0.0 ok=true s="last 2 items average: 30" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var seg_len = k;
	if seg_len > g.n { seg_len = g.n; }
	if seg_len <= 0 {
		gold_fail(g, "invalid count for trailing average");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = g.n - seg_len;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / seg_len;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "last ", seg_len, " items average: ", avg);
	out
}
@end
