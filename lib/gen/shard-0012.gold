code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	if g.n >= 3 {
		for i in 0..g.n - 2 {
			let a1 = g.res[i] + g.res[i + 1];
			let a2 = g.res[i + 1] + g.res[i + 2];
			if a1 > a2 { sorted = false; }
		}
	}
	if !sorted {
		gold_fail(g, "averages out of order");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "averages checked ", g.n);
	out
}
@end
