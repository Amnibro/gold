			cur_min = g.res[i];
		}
		i++;
	}
	if cur_min < min_req {
		gold_fail(g, "minimum below threshold");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	out.i = cur_min;
	out.s.clear();
	format(out.s, "validated minimum in place");
	out
}
