expect: => i=105 r=0.0 ok=true s="clamped reverse streak sum: 105" errors=0 n=5 res=[5,15,25,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var total = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > ceiling {
			g.res[i] = ceiling;
		}
		total += g.res[i];
		i--;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "clamped reverse streak sum: ", total);
	out
}
@end
