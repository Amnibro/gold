code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var is_sorted = true;
	for t in p {
		for i in 1..g.n {
			if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		}
	}
	g.steps += g.n * p;
	out.ok = is_sorted;
	out.s.clear();
	format(out.s, "verified sorted order across ", p, " passes");
	out
}
@end
