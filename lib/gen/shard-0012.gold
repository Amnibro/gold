code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_count = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j + 1] == g.res[i] { j++; }
		let len = j - i + 1;
		gold_cache_put(g, g.res[i], len);
		run_count++;
		i = j + 1;
	}
	g.steps += g.n;
	out.i = run_count;
	out.s.clear();
	format(out.s, "scanned ", run_count, " runs into cache");
	out
}
