code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n == 0 || b <= 0 { return out; }
	var total_cost = 0;
	for pos in g.n { total_cost += g.res[pos]; }
	if total_cost > b {
		for item in g.n {
			g.res[item] = (g.res[item] * b) / total_cost;
		}
	}
	g.steps += g.n * 2;
	out.i = b;
	out.s.clear();
	format(out.s, "normalized budget to ", b);
	out
}
@end
