@entry 41683c1c77525962
kind: step
verb: split
noun: number
modifier: times
context: core
phrase: split input number into equal parts {count} times
phrase: partition number into equal segments by count {count}
slot: count int
test: input=10 count=3
expect: => i=3 r=0.0 ok=true s="split number into 3 equal parts" errors=0 n=3 res=[4,3,3] cache=0 hits=0
test: input=25 count=4
expect: => i=4 r=0.0 ok=true s="split number into 4 equal parts" errors=0 n=4 res=[7,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if count <= 0 {
		return out;
	}
	gold_clear(g);
	let base = out.i / count;
	let rem = out.i % count;
	for k in count {
		let part = if k < rem { base + 1 } else { base };
		gold_push(g, part);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split number into ", count, " equal parts");
	out
}
@end
