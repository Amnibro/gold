fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_range};
	if g.n < 2 {
		gold_fail(g, "insufficient data to compare range");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let spread = max_val - min_val;
	if spread < min_s {
		gold_fail(g, "error range spread below requirement");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = spread;
	out.s.clear();
	format(out.s, "verified error range spread ", spread);
	out
}
@end
