@entry 825f8973b79a1c12
kind: step
verb: check
noun: primes
modifier: in_place
context: error
phrase: check results for composite numbers in place
phrase: inspect elements reporting nonprime values
test: list=2,3,4,5
expect: => i=1 r=0.0 ok=false s="composites found 1" errors=1 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=7,11,13
expect: => i=0 r=0.0 ok=true s="composites found 0" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var composites = 0;
	for i in 0..g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; }
			d++;
		}
		if !is_p {
			composites++;
			gold_fail(g, "composite number found");
		}
	}
	out.i = composites;
	out.ok = (composites == 0);
	out.s.clear();
	format(out.s, "composites found ", composites);
	out
}
@end
