test: list=8,2,10 budget=15
expect: => i=10 r=0.0 ok=true s="budget sorted total: 10" errors=0 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var total = 0;
	var kept = 0;
	for i in g.n {
		if total + g.res[i] <= b {
			total += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "budget sorted total: ", total);
	out
}
@end
