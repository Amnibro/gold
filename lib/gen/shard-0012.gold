phrase: check cumulative sum while values stay below {max_sum}
test: list=10,20,30 max_sum=70
expect: => i=60 r=0.0 ok=true s="total valid under limit: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=25,35,45 max_sum=60
expect: => i=105 r=0.0 ok=false s="total exceeded limit: 105" errors=1 n=3 res=[25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var running = 0;
	var exceeded = false;
	for i in g.n {
		running += g.res[i];
		if running > ms {
			exceeded = true;
			break;
		}
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	if !exceeded {
		format(out.s, "total valid under limit: ", running);
	} else {
		gold_fail(g, "running total exceeded maximum while validating");
		out.ok = false;
		format(out.s, "total exceeded limit: ", running);
	}
	out
}
@end
