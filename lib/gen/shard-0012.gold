phrase: invert sequence order between offsets {start} {end}
slot: start int
slot: end int
test: list=10,20,30,40,50 start=1 end=3
expect: => i=5 r=0.0 ok=true s="step segment reversed" errors=0 n=5 res=[10,40,30,20,50] cache=0 hits=0
test: list=1,2,3 start=0 end=2
expect: => i=3 r=0.0 ok=true s="step segment reversed" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let s = ${start};
	let e = ${end};
	var out = v;
	if s >= 0 && e < g.n && s < e {
		let len = (e - s + 1) / 2;
		for k in 0..len {
			let tmp = g.res[s + k];
			g.res[s + k] = g.res[e - k];
			g.res[e - k] = tmp;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "step segment reversed");
	out
}
@end
