fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var total_spaces = 0;
	var gap_count = g.n - 1;
	for loc in gap_count {
		let diff = g.res[loc + 1] - g.res[loc] - 1;
		if diff > 0 {
			total_spaces += diff;
			g.res[loc] = diff;
		} else {
			g.res[loc] = 0;
		}
	}
	g.n = gap_count;
	g.steps += gap_count;
	out.i = total_spaces;
	out.s.clear();
	format(out.s, "found all ", total_spaces, " empty spaces");
	out
}
@end
