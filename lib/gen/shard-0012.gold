expect: => i=2 r=0.0 ok=true s="limited unique sequence count 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_u = ${max_unique};
	var u = 0;
	for i in g.n {
		var exists = false;
		for j in u {
			if g.res[j] == g.res[i] { exists = true; break; }
		}
		if !exists && u < max_u {
			g.res[u] = g.res[i];
			u++;
		}
	}
	g.n = u;
	g.steps += g.n;
	out.i = u;
	out.s.clear();
	format(out.s, "limited unique sequence count ", u);
	out
}
@end
