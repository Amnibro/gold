@entry 35fc6015786e797a
kind: step
verb: repeat
noun: primes
modifier: last
context: format
slot: count int
phrase: repeat last prime candidate {count} times
phrase: duplicate final prime value by {count}
test: list=4,7,8,11,12 count=3
expect: => i=11 r=0.0 ok=true s="repeated last prime: 11" errors=0 n=8 res=[4,7,8,11,12,11,11,11] cache=0 hits=0
test: list=10,13 count=2
expect: => i=13 r=0.0 ok=true s="repeated last prime: 13" errors=0 n=4 res=[10,13,13,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var rep = c;
	if rep > 20 { rep = 20; }
	if rep < 0 { rep = 0; }
	var last_val = 0;
	if g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			let num = g.res[i];
			if num > 1 {
				var is_p = true;
				var d = 2;
				while d * d <= num {
					if (num % d) == 0 {
						is_p = false;
						break;
					}
					d += 1;
				}
				if is_p {
					last_val = num;
					break;
				}
			}
			i -= 1;
		}
		for j in rep {
			gold_push(g, last_val);
		}
	}
	g.steps += rep + 1;
	out.i = last_val;
	out.s.clear();
	format(out.s, "repeated last prime: ", last_val);
	out
}
@end
