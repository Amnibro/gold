	for i in g.n {
		if ${cond}(g.res[i]) {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	if found_idx >= 0 {
		out.i = found_idx;
		out.ok = true;
		out.s.clear();
		format(out.s, "found matching condition at index ", found_idx);
	} else {
		gold_fail(g, "condition not met with retry");
		out.i = -1;
		out.ok = false;
		out.s.clear();
		format(out.s, "condition not found");
	}
	out
}
