@entry e97fbba8e86078b4
kind: step
verb: cache
noun: memo
modifier: recursively
context: list
phrase: cache sequence recursively count {steps}
phrase: store recursive sequence in memo cache {steps}
slot: steps int
test: steps=4
expect: => i=4 r=0.0 ok=true s="cached 4 recursive memo values" errors=0 n=0 res=[] cache=4 hits=0
test: steps=6
expect: => i=6 r=0.0 ok=true s="cached 6 recursive memo values" errors=0 n=0 res=[] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let steps = ${steps};
	if steps <= 0 {
		return out;
	}
	var a = 0;
	var b = 1;
	gold_cache_put(g, 0, a);
	if steps > 1 {
		gold_cache_put(g, 1, b);
	}
	var k = 2;
	while k < steps {
		let next_fib = a + b;
		gold_cache_put(g, k, next_fib);
		a = b;
		b = next_fib;
		k++;
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "cached ", steps, " recursive memo values");
	out
}
@end
@entry db43396116726bee
kind: step
