fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${attempts};
	var total_sum = 0;
	var tries = 0;
	while tries < max_tries {
		total_sum = 0;
		for elem in g.n {
			total_sum += g.res[elem];
		}
		tries++;
	}
	gold_push(g, total_sum);
	g.steps += g.n * tries;
	out.i = total_sum;
	out.s.clear();
	format(out.s, "summed numbers with ", tries, " tries");
	out
}
@end
