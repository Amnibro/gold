@entry 60b8597cf1409814
kind: step
verb: clamp
noun: odds
modifier: with_retry
context: error
phrase: clamp odd numbers with retry limit {max_tries}
phrase: constrain odd values with retry verification up to {max_tries}
slot: max_tries int
test: list=15,7 max_tries=5
expect: => i=4 r=0.0 ok=true s="clamped odds within retry limit" errors=0 n=2 res=[9,7] cache=0 hits=0
test: list=25,7 max_tries=2
expect: => i=2 r=0.0 ok=false s="retry limit exceeded" errors=1 n=2 res=[21,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${max_tries};
	var tries = 0;
	var has_large_odd = true;
	while has_large_odd && tries < max_tries {
		has_large_odd = false;
		for k in g.n {
			if g.res[k] % 2 != 0 && g.res[k] > 10 {
				g.res[k] -= 2;
				has_large_odd = true;
			}
		}
		tries++;
	}
	var still_exceeds = false;
	for k in g.n {
		if g.res[k] % 2 != 0 && g.res[k] > 10 {
			still_exceeds = true;
			break;
		}
	}
	g.steps += tries * g.n;
	out.i = tries;
	if still_exceeds {
		gold_fail(g, "odds clamp failed to converge");
		out.ok = false;
		out.s.clear();
		format(out.s, "retry limit exceeded");
	} else {
		out.s.clear();
		format(out.s, "clamped odds within retry limit");
	}
	out
}
@end
