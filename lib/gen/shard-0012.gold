code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let first = g.res[0];
	for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = first;
	out.s.clear();
	format(out.s, "sorted and rotated number");
	out
}
@end
