@entry fd66eeb77dcf6c52
kind: step
verb: cache
noun: minimum
modifier: up_to
context: loop
slot: bound int
phrase: cache minimum loop value up to bound {bound}
phrase: store minimum loop element up to bound {bound}
test: input=15 list=8,4,12,3,9 bound=3
expect: => i=4 r=0.0 ok=true s="minimum loop value up to bound is 4" errors=0 n=5 res=[8,4,12,3,9] cache=1 hits=0
