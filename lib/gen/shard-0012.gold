phrase: sort trailing elements until stop value {stop}
phrase: order suffix items until matching {stop}
slot: stop int
test: list=5,4,2,3,10,1 stop=10
expect: => i=4 r=0.0 ok=true s="sorted 4 items until stop" errors=0 n=6 res=[2,3,4,5,10,1] cache=0 hits=0
test: list=3,1,2,0,9 stop=0
expect: => i=3 r=0.0 ok=true s="sorted 3 items until stop" errors=0 n=5 res=[1,2,3,0,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${stop};
	var m = 0;
	while m < g.n && g.res[m] != target {
		m++;
	}
	var i = 0;
	while i < m {
		var j = i + 1;
		while j < m {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted ", m, " items until stop");
	out
}
@end
