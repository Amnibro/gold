fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] < g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items recursively");
	out
}
@end
@entry 670ff5a1130a18e4
kind: step
verb: clamp
noun: gaps
modifier: running
context: search
phrase: clamp running gaps between successive search hits to {max_gap}
phrase: bound running differences across query ranks by {max_gap}
slot: max_gap int
test: list=10,30,60 max_gap=10
expect: => i=2 r=0.0 ok=true s="clamped running gaps" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,40 max_gap=5
expect: => i=2 r=0.0 ok=true s="clamped running gaps" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${max_gap};
	var clamped = 0;
	if g.n > 1 {
		var k = 1;
		while k < g.n {
			let diff = g.res[k] - g.res[k - 1];
			if diff > max_gap {
				g.res[k] = g.res[k - 1] + max_gap;
				clamped++;
			}
			k++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped running gaps");
	out
}
@end
