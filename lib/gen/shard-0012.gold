expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] >= mv && g.res[i + 1] >= mv {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
@entry 83ea1044c54b7df7
kind: step
verb: find
noun: gaps
modifier: in_place
context: loop
slot: threshold int
phrase: find gaps in place exceeding step threshold {threshold}
phrase: detect step gaps in place greater than {threshold}
test: list=10,25,30,55 threshold=12
expect: => i=2 r=0.0 ok=true s="found gaps in place 2" errors=0 n=3 res=[15,5,25] cache=0 hits=0
test: list=2,4,6,8 threshold=10
expect: => i=0 r=0.0 ok=true s="found gaps in place 0" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var count = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		let abs_gap = if gap < 0 { -gap } else { gap };
		if abs_gap > th { count++; }
		g.res[i] = abs_gap;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found gaps in place ", count);
	out
}
@end
@entry 9637bedb2a518aaf
kind: step
verb: repeat
noun: average
modifier: at_least
context: aggregate
slot: min_avg int
phrase: repeat aggregate elements until average reaches at least {min_avg}
phrase: duplicate aggregate values until mean is at least {min_avg}
test: list=10,20,30 min_avg=22
expect: => i=22 r=0.0 ok=true s="repeated elements added: 1 new average: 22" errors=0 n=4 res=[10,20,30,30] cache=0 hits=0
test: list=5,15,25 min_avg=18
expect: => i=19 r=0.0 ok=true s="repeated elements added: 2 new average: 19" errors=0 n=5 res=[5,15,25,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_avg = ${min_avg};
	if g.n == 0 {
		gold_fail(g, "empty list for average repetition");
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = sum / g.n;
	var added = 0;
	while avg < target_avg && g.n < 500 && max_val > avg {
		gold_push(g, max_val);
		sum += max_val;
		avg = sum / g.n;
		added++;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "repeated elements added: ", added, " new average: ", avg);
	out
}
@end
