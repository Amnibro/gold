fn ${ID}(g Gold&, v Val) Val {
    var cur_len = 0;
    var unique_lens = 0;
    for i in 0..v.s.len {
        let ch = v.s[i];
        if ch == ' ' {
            if cur_len > 0 {
                var exists = false;
                for j in 0..g.n {
                    if g.res[j] == cur_len { exists = true; break; }
                }
                if !exists {
                    gold_push(g, cur_len);
                    unique_lens += 1;
                }
                cur_len = 0;
            }
        } else {
            cur_len += 1;
        }
    }
    if cur_len > 0 {
        var exists = false;
        for j in 0..g.n {
            if g.res[j] == cur_len { exists = true; break; }
        }
        if !exists {
            gold_push(g, cur_len);
            unique_lens += 1;
        }
    }
    v.i = unique_lens;
    v.ok = unique_lens > 0;
    v
}
@end
