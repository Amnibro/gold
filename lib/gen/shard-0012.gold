	for i in g.n + 1 {
		g.res[i] = temp[i];
	}
	g.steps += g.n + 1;
	g.n = g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined reversed aggregate sum: ", sum);
