	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		diff_sum += diff;
		i++;
	}
	g.steps += g.n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "pairwise difference sum: ", diff_sum);
	out
}
@end
