@entry 63118289e080310c
kind: step
verb: shift
noun: duplicates
modifier: none
context: core
phrase: shift duplicate values toward end leaving none adjacent
phrase: eliminate duplicate neighbors without leaving any adjacent
test: list=1,1,2,3,3,4
expect: => i=2 r=0.0 ok=true s="removed 2 adjacent duplicate items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6,7,7
expect: => i=3 r=0.0 ok=true s="removed 3 adjacent duplicate items" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var write_idx = 1;
	var removed = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[write_idx - 1] {
			removed++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
