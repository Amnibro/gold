fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if out.s.len == 0 || count <= 0 {
		return out;
	}
	let last_char = out.s[out.s.len - 1];
	var added = 0;
	for k in count {
		if k % 2 == 0 {
			out.s.push(last_char);
			added++;
