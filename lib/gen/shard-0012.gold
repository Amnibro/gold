	for i in g.n - 1 {
		running += g.res[i] + g.res[i + 1];
		pair_sums.push(running);
	}
	gold_clear(g);
	for s in pair_sums { gold_push(g, s); }
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "traced running pairs ", running);
