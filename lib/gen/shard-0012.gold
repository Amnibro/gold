fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for subfunction check");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	let ok = ${p}(last);
	g.steps += 1;
	out.ok = ok;
	out.i = last;
	out.s.clear();
	format(out.s, if ok { "last element satisfied predicate" } else { "last element failed predicate" });
	out
}
