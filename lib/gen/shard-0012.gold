fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_letters = v.s.len > 0;
	for b in v.s {
		let is_alpha = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
		if !is_alpha { all_letters = false; break; }
	}
	out.ok = all_letters;
	out.s.clear();
	format(out.s, if all_letters { "all letters" } else { "not all letters" });
	out.i = if all_letters { 1 } else { 0 };
	g.steps += v.s.len;
	out
}
@end
