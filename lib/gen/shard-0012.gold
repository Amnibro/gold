code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var count = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		let cached, found = gold_cache_get(g, sum);
		let res_val = if found { cached } else {
			let computed = ${f}(sum);
			gold_cache_put(g, sum, computed);
			computed
		};
		g.res[count] = res_val;
		count++;
		i += 2;
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "evaluated ", count, " cached pair functions");
	out
}
