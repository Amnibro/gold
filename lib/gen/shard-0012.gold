@entry c8c735e1254c3820
kind: step
verb: map
noun: duplicates
modifier: between
context: search
phrase: map duplicate items bounded between {low} to {high}
phrase: find duplicate values within bounds {low} through {high}
slot: low int
slot: high int
test: list=1,2,2,3,3,10 low=2 high=5
expect: => i=2 r=0.0 ok=true s="found 2 duplicates within bounds" errors=0 n=6 res=[1,2,2,3,3,10] cache=0 hits=0
test: list=5,5,8,8,12 low=4 high=9
expect: => i=2 r=0.0 ok=true s="found 2 duplicates within bounds" errors=0 n=5 res=[5,5,8,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] && g.res[i] >= lo && g.res[i] <= hi {
			count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " duplicates within bounds");
	out
}
@end
@entry addd6bf299a500e2
kind: step
verb: select
noun: middle
modifier: pairwise
context: search
phrase: select middle adjacent pair from search results
phrase: extract central pairwise elements from dataset
test: list=1,2,3,4,5,6
expect: => i=7 r=0.0 ok=true s="selected middle pair sum 7" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,30,40
expect: => i=50 r=0.0 ok=true s="selected middle pair sum 50" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	let a = g.res[mid - 1];
	let b = g.res[mid];
	g.res[0] = a;
	g.res[1] = b;
	g.n = 2;
	g.steps += 2;
	out.i = a + b;
	out.s.clear();
	format(out.s, "selected middle pair sum ", a + b);
	out
}
@end
@entry ad01edd422bf713c
kind: step
verb: retry
noun: step
modifier: unique
context: search
phrase: retry step finding unique values in search
phrase: verify whether all search results are distinct
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="all search items distinct: true" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2,2,3
expect: => i=0 r=0.0 ok=false s="all search items distinct: false" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_distinct = true;
	var i = 0;
	while i < g.n && is_distinct {
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] { is_distinct = false; break; }
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = is_distinct;
	out.i = if is_distinct { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all search items distinct: ", is_distinct);
	out
}
@end
@entry dce0da31d0af9ae0
kind: step
verb: scan
noun: gaps
modifier: while
context: search
phrase: scan gaps while differences remain below {ceiling}
phrase: measure consecutive gaps while under {ceiling}
slot: ceiling int
test: list=1,3,6,15,20 ceiling=5
expect: => i=2 r=0.0 ok=true s="scanned 2 gaps under ceiling" errors=0 n=5 res=[1,3,6,15,20] cache=0 hits=0
test: list=10,12,14,16 ceiling=3
expect: => i=3 r=0.0 ok=true s="scanned 3 gaps under ceiling" errors=0 n=4 res=[10,12,14,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var valid_gaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap >= lim { break; }
		valid_gaps++;
		i++;
	}
	g.steps += i;
	out.i = valid_gaps;
	out.s.clear();
	format(out.s, "scanned ", valid_gaps, " gaps under ceiling");
	out
}
@end
