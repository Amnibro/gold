code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let _, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduplicated to ", kept, " sorted items");
	out
}
@end
