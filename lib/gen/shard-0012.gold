code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " alternate step items");
	out
}
