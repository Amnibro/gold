verb: fold
noun: tail
modifier: at_least
context: aggregate
slot: min_val int
phrase: fold tail aggregate elements at least {min_val}
phrase: sum trailing aggregate items reaching at least {min_val}
test: list=5,10,25,30,8 min_val=20
expect: => i=55 r=0.0 ok=true s="folded 2 tail items >= 20 sum: 55" errors=0 n=5 res=[5,10,25,30,8] cache=0 hits=0
test: list=12,4,16,18,22 min_val=15
expect: => i=56 r=0.0 ok=true s="folded 3 tail items >= 15 sum: 56" errors=0 n=5 res=[12,4,16,18,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var sum = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= mv {
			sum += g.res[i];
			count++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded ", count, " tail items >= ", mv, " sum: ", sum);
	out
}
@end
