expect: => i=3 r=0.0 ok=true s="shifted 3 suffix elements" errors=0 n=5 res=[2,2,7,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var modified = 0;
	var p = g.n / 2;
	while p < g.n {
		var unique = true;
		for u in g.n {
			if u != p && g.res[u] == g.res[p] {
				unique = false;
				break;
			}
		}
		if unique {
			g.res[p] += off;
			modified++;
		}
		p++;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "shifted ", modified, " suffix elements");
	out
}
@end
