expect: => i=15 r=0.0 ok=true s="average adjusted steps: 15" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_avg};
	let hi = ${max_avg};
	var steps = 0;
	while steps < 20 && g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let avg = sum / g.n;
		if avg >= lo && avg <= hi { break; }
		if avg < lo {
			for i in g.n { g.res[i] += 1; }
		} else {
			for i in g.n { g.res[i] -= 1; }
		}
		steps++;
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "average adjusted steps: ", steps);
	out
}
@end
