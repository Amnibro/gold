test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="dropped gap items 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = 10;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let prev, ok = gold_cache_get(g, 0);
		if !ok || x - prev <= max_gap {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped gap items ", dropped);
	out
}
@end
