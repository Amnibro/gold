expect: => i=3 r=0.0 ok=true s="found 3 tail items between bounds" errors=0 n=5 res=[0,2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > lo && g.res[i] < hi {
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " tail items between bounds");
	out
}
@end
