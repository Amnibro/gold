	var out = v;
	var dup_pairs = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k] == g.res[k + 1] {
				dup_pairs++;
			}
		}
	}
	gold_cache_put(g, 0, dup_pairs);
	g.steps += g.n;
	out.i = dup_pairs;
	out.s.clear();
	format(out.s, "ranked ", dup_pairs, " duplicate pairs");
	out
}
@end
