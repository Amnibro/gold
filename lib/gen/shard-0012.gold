fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	var avg = 0;
	if g.n > 0 { avg = sum / g.n; }
	var write = 0;
	for i in g.n {
		if g.res[i] > avg {
			g.res[write] = g.res[i];
			write += 1;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "retained ", write, " above mean ", avg);
	out
}
