code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		let lo = 1;
		let hi = g.n - 2;
		var i = lo;
		var j = hi;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
