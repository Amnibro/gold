@entry 98934d2c3d958fc6
kind: step
verb: sum
noun: pairs
modifier: recursively
context: loop
slot: depth int
phrase: sum pairs recursively across loop iterations up to depth {depth}
phrase: accumulate adjacent pairs recursively within loop depth {depth}
test: list=1,2,3,4 depth=2
expect: => i=35 r=0.0 ok=true s="summed loop pairs recursively total 35" errors=0 n=2 res=[8,12] cache=0 hits=0
test: list=2,4,6 depth=1
expect: => i=16 r=0.0 ok=true s="summed loop pairs recursively total 16" errors=0 n=2 res=[6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var total = 0;
	for _ in d {
		if g.n >= 2 {
			var next_n = 0;
			var temp int[512] = [0; 512];
			for i in g.n - 1 {
				let pair_sum = g.res[i] + g.res[i + 1];
				temp[next_n] = pair_sum;
				next_n++;
				total += pair_sum;
			}
			g.n = next_n;
			for i in next_n {
				g.res[i] = temp[i];
			}
		}
	}
	g.steps += d + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "summed loop pairs recursively total ", total);
	out
}
@end
