fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		gold_cache_put(g, 0, g.res[0]);
		for i in 0..g.n / 2 {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed in place");
	out
}
