code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_len};
	if g.n < min_len {
		gold_fail(g, "sequence too short for requested suffix");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "suffix length error");
		return out;
	}
	let start = g.n - min_len;
	for k in min_len {
		g.res[k] = g.res[start + k];
	}
	g.n = min_len;
	g.steps += min_len;
	out.i = min_len;
	out.s.clear();
	format(out.s, "returned suffix of ", min_len, " items");
	out
}
@end
