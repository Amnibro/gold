code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var norm_sum = 0;
	if g.cn > 1 {
		var i = 0;
		while i + 1 < g.cn {
			let avg = (g.cv[i] + g.cv[i + 1]) / 2;
			norm_sum += avg;
			pairs++;
			i += 2;
		}
	}
	g.steps += pairs;
	out.i = norm_sum;
	out.s.clear();
	format(out.s, "normalized total sum ", norm_sum);
	out
}
@end
