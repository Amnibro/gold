expect: => i=3 r=0.0 ok=true s="findfindfind" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	let base = copy(out.s);
	var count = 1;
	while count < r && out.s.len + base.len <= 200 {
		out.s.append(base);
		count++;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
