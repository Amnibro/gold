expect: => i=3 r=0.0 ok=true s="grouped pairwise primes to 3 elements" errors=0 n=3 res=[5,4,5] cache=0 hits=0
code:
fn ${ID}_pr(n int) bool {
	if n < 2 { return false; }
	var factor = 2;
	while factor * factor <= n {
		if n % factor == 0 { return false; }
		factor++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_i = 0;
	var cur = 0;
	while cur + 1 < g.n {
		if ${ID}_pr(g.res[cur]) && ${ID}_pr(g.res[cur + 1]) {
			g.res[write_i] = g.res[cur] + g.res[cur + 1];
			write_i++;
			cur += 2;
		} else {
			g.res[write_i] = g.res[cur];
			write_i++;
			cur++;
		}
	}
	if cur < g.n {
		g.res[write_i] = g.res[cur];
		write_i++;
	}
	g.n = write_i;
	g.steps += g.n;
	out.i = write_i;
	out.s.clear();
	format(out.s, "grouped pairwise primes to ", write_i, " elements");
	out
}
@end
