fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tlen = ${tail_len};
	if tlen <= 0 || g.n == 0 {
		gold_fail(g, "tail length must be positive");
		out.ok = false;
		return out;
	}
	let take = if tlen < g.n { tlen } else { g.n };
	let start = g.n - take;
	var max_val = g.res[start];
	for i in 1..take {
		if g.res[start + i] > max_val {
			max_val = g.res[start + i];
		}
	}
	gold_push(g, max_val);
	g.steps += take + 1;
	out.i = max_val;
	out.s.clear();
	format(out.s, "safely found tail maximum ", max_val);
	out
}
@end
