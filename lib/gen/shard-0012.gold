		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] { is_s = false; break; }
		}
	}
	out.ok = is_s;
	out.s.clear();
	format(out.s, if is_s { "sequence is sorted" } else { "sequence is unsorted" });
	out.i = if is_s { 1 } else { 0 };
	g.steps += g.n;
	out
}
