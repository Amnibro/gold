code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n < 2 || r <= 0 { return out; }
	let half = g.n / 2;
	var att = 0;
	while att < r {
		for s_idx in half..g.n {
			g.res[s_idx] += 1;
		}
		att++;
	}
	g.steps += (g.n - half) * att;
	out.i = att;
	out.s.clear();
	format(out.s, "shifted suffix across ", att, " retries");
	out
}
@end
