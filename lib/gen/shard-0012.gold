fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var new_n = 1;
	var last_val = g.res[0];
	var k = 1;
	while k < g.n {
		if g.res[k] >= last_val {
			last_val = g.res[k];
			g.res[new_n] = last_val;
			new_n++;
		}
		k++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filtered ", new_n, " sorted items");
	out
}
@end
