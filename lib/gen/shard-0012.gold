fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n == 0 {
		gold_fail(g, "empty results for error limit constraint");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
	}
	if clamped > 0 {
		gold_fail(g, "error limit exceeded and clamped");
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped error items count ", clamped);
	out
}
@end
