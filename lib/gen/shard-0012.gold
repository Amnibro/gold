code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if out.s.len == 0 { return out; }
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < out.s.len {
		if out.s[i] == out.s[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i++;
	}
	if max_streak > limit { max_streak = limit; }
	g.steps += out.s.len;
	out.i = max_streak;
	out
}
@end
