fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if total + g.res[i] > b {
			gold_fail(g, "reverse sum exceeded error budget");
			out.ok = false;
			break;
		}
		total += g.res[i];
		count++;
		i--;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed under budget in reverse ", total);
	out
}
@end
