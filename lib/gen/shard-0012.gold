fn ${ID}_rev(n int) int {
	var num = n;
	var rev = 0;
	while num > 0 {
		rev = rev * 10 + (num % 10);
		num /= 10;
	}
	rev
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for pos in g.n {
		g.res[pos] = ${ID}_rev(g.res[pos]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed digits for ", g.n, " elements");
	out
}
@end
@entry 33424e513298ca50
kind: step
verb: group
noun: step
modifier: times
context: transform
phrase: group elements by step window size {window}
phrase: partition results into steps of size {window}
slot: window int
test: list=1,2,3,4,5,6 window=2
expect: => i=3 r=0.0 ok=true s="grouped into 3 steps" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 window=3
expect: => i=2 r=0.0 ok=true s="grouped into 2 steps" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if win <= 0 || g.n == 0 { return out; }
	var out_len = 0;
	var curr = 0;
	while curr < g.n {
		var step_sum = 0;
		var taken = 0;
		while curr < g.n && taken < win {
			step_sum += g.res[curr];
			taken++;
			curr++;
		}
		g.res[out_len] = step_sum;
		out_len++;
	}
	g.steps += g.n;
	g.n = out_len;
	out.i = out_len;
	out.s.clear();
	format(out.s, "grouped into ", out_len, " steps");
	out
}
@end
