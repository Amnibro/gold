fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "pairwise ranges: [");
	var i = 0;
	var count = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if count > 0 { format(out.s, ", "); }
		format(out.s, diff);
