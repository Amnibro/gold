fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 && g.res[idx] == last_val {
		g.res[idx] += d;
		count++;
		idx--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted trailing streak of ", count, " items");
	out
}
