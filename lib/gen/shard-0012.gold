@entry d56947500e9069e1
kind: step
verb: sort
noun: squares
modifier: safely
context: error
phrase: sort squares safely catching negative overflow errors
phrase: square each item safely sorting results in ascending order
test: list=3,-2,4
expect: => i=3 r=0.0 ok=true s="sorted squares safely" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=200
expect: => i=0 r=0.0 ok=false s="square overflow error" errors=1 n=1 res=[200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_overflow = false;
	for k in g.n {
		let sq = g.res[k] * g.res[k];
		if sq > 10000 {
			has_overflow = true;
			break;
		}
	}
	if has_overflow {
		gold_fail(g, "square overflowed maximum limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "square overflow error");
		return out;
	}
	for k in g.n {
		g.res[k] = g.res[k] * g.res[k];
	}
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted squares safely");
	out
}
@end
