fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		var exists = false;
		for j in write {
			if g.res[j] == g.res[i] {
				exists = true;
				break;
			}
		}
		if !exists {
			g.res[write] = g.res[i];
			write += 1;
		}
	}
	g.n = write;
	g.steps += write;
	out.i = write;
	out.s.clear();
	format(out.s, "unique function results: ", write);
	out
}
@end
