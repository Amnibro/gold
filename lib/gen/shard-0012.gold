test: list=1,5,10,20
expect: => i=3 r=0.0 ok=true s="unique spaces 3" errors=0 n=4 res=[1,5,10,20] cache=0 hits=0
test: list=2,4,6
expect: => i=1 r=0.0 ok=true s="unique spaces 1" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var spaces int[..16] = [];
	for i in 0..g.n - 1 {
		var sp = g.res[i + 1] - g.res[i];
		if sp < 0 { sp = -sp; }
		var seen = false;
		for j in 0..spaces.len {
			if spaces[j] == sp { seen = true; }
		}
		if !seen { spaces.push(sp); }
	}
	if spaces.len > 3 {
		gold_fail(g, "excessive unique spaces");
	}
	out.i = spaces.len;
	out.s.clear();
	format(out.s, "unique spaces ", spaces.len);
	out
}
@end
