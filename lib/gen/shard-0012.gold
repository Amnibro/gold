@entry ff82e37ca53a4978
kind: step
verb: sort
noun: loop
modifier: recursively
context: cache
phrase: sort cache entries via loop recursively
phrase: order cached elements repeatedly by recursive passes
test: list=30,10,20
expect: => i=2 r=0.0 ok=true s="sorted cache loop in 2 recursive passes" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,2
expect: => i=2 r=0.0 ok=true s="sorted cache loop in 2 recursive passes" errors=0 n=2 res=[2,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var passes = 0;
	var swapped = true;
	while swapped {
		swapped = false;
		passes++;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				swapped = true;
			}
		}
		if passes >= 100 { break; }
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "sorted cache loop in ", passes, " recursive passes");
	out
}
@end
