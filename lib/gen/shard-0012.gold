fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for i in g.n {
		let v_item, ok = gold_cache_get(g, g.res[i]);
		if ok {
			hits++;
		} else {
			gold_cache_put(g, g.res[i], i);
		}
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "compared loop with cache hits ", hits);
	out
}
@end
