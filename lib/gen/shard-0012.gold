code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var weight = 1;
	var i = g.n - 1;
	while i >= 0 {
		sum += g.res[i] * weight;
		weight++;
		if i == 0 { break; }
		i--;
	}
	out.i = sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "weighted reverse sum ", sum);
	out
}
@end
