code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept int[..512] = [];
	for i in g.n {
		if g.res[i] >= avg { kept.push(g.res[i]); }
	}
	gold_clear(g);
	for k in kept { gold_push(g, k); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered pairwise average ", g.n);
	out
}
@end
