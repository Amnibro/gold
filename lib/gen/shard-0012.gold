	for _ in d {
		if g.n >= 2 {
			let mid = g.n / 2;
			var left_sum = 0;
			var right_sum = 0;
			for i in mid { left_sum += g.res[i]; }
			for i in mid..g.n { right_sum += g.res[i]; }
			diff = left_sum - right_sum;
		}
	}
	gold_push(g, diff);
	g.steps += d * g.n + 1;
	out.i = diff;
	out.s.clear();
	format(out.s, "split recursive comparison diff ", diff);
	out
}
