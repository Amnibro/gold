		let c = out.s[k];
		if c != 'a' && c != 'e' && c != 'i' && c != 'o' && c != 'u' && c != ' ' {
			consonants++;
		}
	}
	g.steps += out.s.len;
	out.i = consonants + ret;
	out
}
@end
