@entry 78d0ade81cd888ba
kind: step
verb: validate
noun: window
modifier: sorted
context: format
slot: window_size int
phrase: validate sliding window is sorted
phrase: check sorted order within window {window_size}
test: list=1,3,5,7,9 window_size=3
expect: => i=1 r=0.0 ok=true s="windows of size 3 sorted" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=1,8,2,9 window_size=2
expect: => i=0 r=0.0 ok=false s="window not sorted" errors=1 n=4 res=[1,8,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${window_size};
	var valid = true;
	if ws > 1 && g.n >= ws {
		var i = 0;
		while i + ws <= g.n {
			for j in ws - 1 {
				if g.res[i + j] > g.res[i + j + 1] {
					valid = false;
					break;
				}
			}
			if !valid { break; }
			i += 1;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if valid {
		out.i = 1;
		format(out.s, "windows of size ", ws, " sorted");
