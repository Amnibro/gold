fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	for i in out.s.len {
		gold_push(g, out.s[i] as int);
	}
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " characters sorted");
	out
}
@end
