noun: checkpoint
modifier: all
context: filter
phrase: dedupe all checkpoint items preserving first occurrence
phrase: remove duplicate checkpoint entries across list
test: list=10,20,10,30,20,40
expect: => i=4 r=0.0 ok=true s="deduped all checkpoints to 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,1,2,1,3
expect: => i=4 r=0.0 ok=true s="deduped all checkpoints to 4" errors=0 n=4 res=[5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_len = 0;
	for read_idx in g.n {
		var found = false;
		for u in unique_len {
			if g.res[u] == g.res[read_idx] {
				found = true;
				break;
			}
		}
		if !found {
			g.res[unique_len] = g.res[read_idx];
			unique_len++;
		}
	}
	g.steps += g.n * g.n;
	g.n = unique_len;
	out.i = unique_len;
	out.s.clear();
	format(out.s, "deduped all checkpoints to ", unique_len);
	out
}
@end
