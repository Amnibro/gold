code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur_len = 0;
	for k in out.s.len {
		let b = out.s[k];
		if b == ' ' {
			if cur_len > 0 { gold_push(g, cur_len); cur_len = 0; }
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 { gold_push(g, cur_len); }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n + out.s.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " word lengths");
	out
}
@end
