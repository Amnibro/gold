			let cur, ok = gold_cache_get(g, d);
			gold_cache_put(g, d, if ok { cur + 1 } else { 1 });
			digit_count++;
		}
	}
	g.steps += out.s.len;
	out.i = digit_count;
	out.s.clear();
	format(out.s, "cached ", digit_count, " digits");
