code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	if sz <= 0 {
		gold_fail(g, "invalid checkpoint interval");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		gold_cache_put(g, idx, g.res[idx]);
		g.res[kept] = g.res[idx];
		kept++;
		idx += sz;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined ", kept, " cached checkpoints");
	out
}
@end
