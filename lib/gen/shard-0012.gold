noun: values
modifier: at_most
context: compare
slot: cap int
phrase: shift values at most bounded by comparison cap {cap}
phrase: adjust list values by at most cap {cap}
test: input=10 list=20,5,30,12 cap=5
expect: => i=2 r=0.0 ok=true s="shifted values at most cap count 2" errors=0 n=4 res=[15,5,25,12] cache=0 hits=0
test: input=15 list=16,14,15 cap=5
expect: => i=0 r=0.0 ok=true s="shifted values at most cap count 0" errors=0 n=3 res=[16,14,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var shifts = 0;
	for i in g.n {
		let diff = g.res[i] - out.i;
		if diff > c {
			g.res[i] -= c;
			shifts++;
		} else if diff < -c {
			g.res[i] += c;
			shifts++;
		}
	}
	g.steps += g.n + 1;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted values at most cap count ", shifts);
	out
}
@end
