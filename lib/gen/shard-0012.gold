@entry 20950e0ee2d34634
kind: step
verb: drop
noun: runs
modifier: safely
context: error
slot: max_run int
phrase: safely drop consecutive error runs
phrase: prune consecutive error run sequences safely
test: list=4,4,4,5,6 max_run=2
expect: => i=3 r=0.0 ok=true s="safely dropped error runs count 3" errors=1 n=2 res=[5,6] cache=0 hits=0
test: list=1,2,3 max_run=3
expect: => i=0 r=0.0 ok=true s="safely dropped error runs count 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	if g.n == 0 {
		gold_fail(g, "empty results for safe run drop");
		out.ok = false;
		return out;
	}
	var w = 0;
	var i = 0;
	var dropped = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len > limit {
			dropped += run_len;
		} else {
			for k in i..j {
				g.res[w] = g.res[k];
				w++;
			}
		}
		i = j;
	}
	if dropped > 0 {
		gold_fail(g, "dropped excessive error runs");
	}
	g.n = w;
	g.steps += i;
	out.i = dropped;
	out.s.clear();
	format(out.s, "safely dropped error runs count ", dropped);
	out
}
@end
