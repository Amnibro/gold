@entry d604b8c8a3c37bbf
kind: fn
verb: sort
noun: items
modifier: nested
context: compare
phrase: sort digits of compare value in descending order
phrase: order nested items of number from highest to lowest
test: arg=1234,4829
expect: 4321
expect: 9842
test: arg=505,10
expect: 550
expect: 10
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var digits int[..32] = [];
	if x == 0 { return 0; }
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	for i in digits.len {
		for j in i + 1..digits.len {
			if digits[j] > digits[i] {
				let tmp = digits[i];
				digits[i] = digits[j];
				digits[j] = tmp;
			}
		}
	}
	var res = 0;
	for d in digits {
		res = res * 10 + d;
	}
	res
}
@end
