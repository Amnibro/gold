test: text="dry sky"
expect: => i=0 r=0.0 ok=true s="dry sky" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_pos int[..32] = [];
	for i in 0..out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			v_pos.push(i);
		}
	}
	let vc = v_pos.len;
	for k in 0..vc / 2 {
		let p1 = v_pos[k];
		let p2 = v_pos[vc - 1 - k];
		let tmp = out.s[p1];
		out.s[p1] = out.s[p2];
		out.s[p2] = tmp;
	}
	if vc == 0 {
		gold_fail(g, "no vowels in error text");
	}
	out.i = vc;
	out
}
@end
