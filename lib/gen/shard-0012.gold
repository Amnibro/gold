slot: target int
test: list=3,10,20 target=25
expect: => i=48 r=0.0 ok=true s="scaled minimum to 48 in 4 steps" errors=0 n=3 res=[48,10,20] cache=0 hits=0
test: list=2,8,12 target=15
expect: => i=16 r=0.0 ok=true s="scaled minimum to 16 in 3 steps" errors=0 n=3 res=[16,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_val = ${target};
	if g.n == 0 { return out; }
	var min_idx = 0;
	for i in g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	var steps = 0;
	while g.res[min_idx] < floor_val && steps < 50 {
		g.res[min_idx] = g.res[min_idx] * 2;
		steps++;
	}
	g.steps += steps;
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "scaled minimum to ", g.res[min_idx], " in ", steps, " steps");
	out
}
@end
