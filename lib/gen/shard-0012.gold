fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for sorted normalization");
		out.ok = false;
		return out;
	}
	var negative_count = 0;
	for i in g.n {
		if g.res[i] < 0 {
			g.res[i] = 0;
			negative_count++;
		}
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if negative_count > 0 {
		gold_fail(g, "normalized negative error items");
	}
	g.steps += g.n * g.n;
	out.i = negative_count;
	out.s.clear();
	format(out.s, "normalized sorted error list with ", negative_count, " fixes");
	out
}
@end
