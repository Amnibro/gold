	if out.s.len == 0 {
		gold_fail(g, "empty error text cannot be reversed");
		out.ok = false;
		return out;
	}
	var rev byte[..200] = "";
	var i = out.s.len - 1;
	while i >= 0 {
		rev.push(out.s[i]);
		i--;
	}
	out.s.clear();
	for b in rev { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
