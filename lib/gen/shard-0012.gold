code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var oc = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[oc] = g.res[k];
			oc++;
		}
	}
	gold_clear(g);
	var k = oc - 1;
	while k >= 0 {
		gold_push(g, odds[k]);
		k--;
	}
	out.i = oc;
	g.steps += g.n + oc;
	out
}
@end
