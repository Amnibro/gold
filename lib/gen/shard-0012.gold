test: text="abcabc"
expect: => i=3 r=0.0 ok=true s="unique letters count: 3" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	var seen byte[256] = [0; 256];
	for b in v.s {
		let is_alpha = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
		if is_alpha {
			let idx = b;
			if seen[idx] == 0 {
				seen[idx] = 1;
				unique++;
			}
		}
	}
	out.s.clear();
	format(out.s, "unique letters count: ", unique);
	out.i = unique;
	g.steps += v.s.len;
	out
}
