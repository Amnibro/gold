@entry fa08bc3c5b70ab9b
kind: step
verb: drop
noun: sequence
modifier: safely
context: search
phrase: drop sequence safely from search start {count}
phrase: remove leading sequence items safely {count}
slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="safely dropped 2 leading items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="safely dropped 1 leading items" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let drop_n = ${count};
	let actual_drop = if drop_n > g.n { g.n } else { drop_n };
	let remaining = g.n - actual_drop;
	for i in remaining {
		g.res[i] = g.res[actual_drop + i];
	}
	g.n = remaining;
	g.steps += remaining;
	out.i = actual_drop;
	out.s.clear();
	format(out.s, "safely dropped ", actual_drop, " leading items");
	out
}
@end
