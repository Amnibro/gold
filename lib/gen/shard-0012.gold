code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_n = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in u_n {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[u_n] = x;
			u_n++;
		}
	}
	g.n = u_n;
	for k in u_n {
		gold_push(g, g.res[k]);
	}
	g.steps += u_n;
	out.i = u_n;
	out.s.clear();
	format(out.s, "repeated ", u_n, " unique numbers");
	out
}
@end
