@entry 030a24ff1432c28e
kind: step
verb: shift
noun: window
modifier: safely
context: transform
phrase: safely shift sliding window by {offset}
phrase: advance window safely by step {offset}
slot: offset int
test: list=1,2,3,4,5 offset=1
expect: => i=1 r=0.0 ok=true s="safely shifted window by 1" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
test: list=10,20,30 offset=2
expect: => i=2 r=0.0 ok=true s="safely shifted window by 2" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 || off <= 0 { return out; }
	let shift_amount = off % g.n;
	for step in shift_amount {
		let last_val = g.res[g.n - 1];
		var idx = g.n - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last_val;
	}
	g.steps += g.n * shift_amount;
	out.i = shift_amount;
	out.s.clear();
	format(out.s, "safely shifted window by ", shift_amount);
	out
}
@end
