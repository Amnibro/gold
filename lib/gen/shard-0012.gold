fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var expanded int[..512] = [];
	for i in g.n {
		expanded.push(g.res[i]);
		var is_dup = false;
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] { is_dup = true; break; }
		}
		if is_dup && expanded.len < 512 { expanded.push(g.res[i]); }
	}
	gold_clear(g);
	for e in expanded { gold_push(g, e); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated duplicates to ", g.n);
	out
}
@end
