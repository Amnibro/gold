	format(out.s, "threshold items: [");
	for k in g.n {
		if g.res[k] >= lim && count < mc {
			if count > 0 { format(out.s, ", "); }
			format(out.s, g.res[k]);
			count++;
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
