expect: => i=2 r=0.0 ok=true s="selected and sorted by digits: 2" errors=0 n=2 res=[7,88] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_digits};
	var kept = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d <= lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept {
		for j in i + 1..kept {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.n = kept;
	g.steps += kept * kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected and sorted by digits: ", kept);
	out
}
@end
