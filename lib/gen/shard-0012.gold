fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	for i in g.n {
		if g.res[i] < 10 { g.res[i] = 10; }
		else if g.res[i] > 50 { g.res[i] = 50; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped pairs in reverse");
	out
}
@end
