expect: => i=2 r=0.0 ok=true s="found last item exceeding limit at index 2" errors=0 n=4 res=[5,8,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	var last_idx = -1;
	for i in g.n {
		let idx = g.n - 1 - i;
		if g.res[idx] > limit {
			last_idx = idx;
			break;
		}
	}
	g.steps += g.n;
	out.i = last_idx;
	out.s.clear();
	format(out.s, "found last item exceeding limit at index ", last_idx);
	out
}
@end
