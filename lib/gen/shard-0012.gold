	var ranks int[512] = [0; 512];
	for i in g.n {
		var r = 1;
		for j in g.n {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks[i] = r;
	}
	for i in g.n { g.res[i] = ranks[i]; }
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " checkpoint items");
	out
}
@end
