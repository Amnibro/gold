expect: => i=4 r=0.0 ok=true s="repeated histogram at most" errors=0 n=4 res=[2,2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_total};
	var original = [0; 64];
	var count = if g.n < 64 { g.n } else { 64 };
	var i = 0;
	while i < count {
		original[i] = g.res[i];
		i++;
	}
	gold_clear(g);
	var total_added = 0;
	var j = 0;
	while j < count && total_added < limit {
		let x = original[j];
		var freq = 0;
		var k = 0;
		while k < count {
			if original[k] == x {
				freq++;
			}
			k++;
		}
		var r = 0;
		while r < freq && total_added < limit {
			gold_push(g, x);
			total_added++;
			r++;
		}
		j++;
	}
	g.steps += total_added;
	out.i = total_added;
	out.s.clear();
	format(out.s, "repeated histogram at most");
	out
}
@end
