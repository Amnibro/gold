code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 {
		gold_fail(g, "negative number not allowed");
		out.ok = false;
		return out;
	}
	var steps = 0;
	while num >= 10 {
		var sum = 0;
		while num > 0 {
			sum += num % 10;
			num /= 10;
		}
		num = sum;
		steps++;
	}
	g.steps += steps;
	out.i = num;
	out.s.clear();
	format(out.s, "validated recursively to ", num);
	out
}
@end
