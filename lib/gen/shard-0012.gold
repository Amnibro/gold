@entry 4883a00db8a77895
kind: step
verb: dedupe
noun: range
modifier: none
context: format
slot: min_val int
slot: max_val int
phrase: dedupe range elements without fallback from {min_val} to {max_val}
phrase: filter duplicate numbers in range {min_val} through {max_val}
test: list=2,5,5,8,12,12 min_val=4 max_val=10
expect: => i=1 r=0.0 ok=true s="deduped in range: 1" errors=0 n=5 res=[2,5,8,12,12] cache=0 hits=0
test: list=1,1,1,1 min_val=2 max_val=5
expect: => i=0 r=0.0 ok=true s="deduped in range: 0" errors=0 n=4 res=[1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var deduped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			var j = i + 1;
			while j < g.n {
				if g.res[j] == g.res[i] {
					var k = j;
					while k + 1 < g.n {
						g.res[k] = g.res[k + 1];
						k += 1;
					}
					g.n -= 1;
					deduped += 1;
				} else {
					j += 1;
				}
			}
		}
		i += 1;
	}
	g.steps += g.n;
	out.i = deduped;
	out.s.clear();
	format(out.s, "deduped in range: ", deduped);
	out
}
@end
