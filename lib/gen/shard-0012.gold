code:
fn ${ID}(g Gold&, v Val) Val {
	let req = ${target};
	var out = v;
	var sum = 0;
	for i in 0..g.n { sum += g.res[i]; }
	if sum < req && g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	out.i = sum;
	out.ok = (sum >= req);
	out.s.clear();
	format(out.s, "total evaluated ", sum);
	out
}
@end
