fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let first = g.res[0];
		gold_cache_put(g, 0, first);
		if g.n > 1 {
			for k in g.n - 1 {
				g.res[k] = g.res[k + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated items with cache");
	out
}
