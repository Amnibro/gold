@entry 00a48c2938846e2b
kind: step
verb: reverse
noun: condition
modifier: sorted
context: format
slot: cond pred
phrase: format sorted elements meeting condition {cond} in reverse
phrase: display reversed sorted values matching condition {cond}
test: list=1,4,2,5,3 cond=is_even
expect: => i=2 r=0.0 ok=true s="reversed sorted: [4, 2]" errors=0 n=5 res=[1,4,2,5,3] cache=0 hits=0
test: list=10,3,7,8,2 cond=is_odd
expect: => i=2 r=0.0 ok=true s="reversed sorted: [7, 3]" errors=0 n=5 res=[10,3,7,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched int[512] = [0; 512];
	var mc = 0;
	for k in g.n {
		if ${cond}(g.res[k]) {
			matched[mc] = g.res[k];
			mc++;
		}
	}
	for i in mc {
		for j in i + 1..mc {
			if matched[j] < matched[i] {
				let tmp = matched[i];
				matched[i] = matched[j];
				matched[j] = tmp;
			}
		}
	}
	out.s.clear();
	format(out.s, "reversed sorted: [");
	var k = mc - 1;
	var first = true;
	while k >= 0 {
		if !first { format(out.s, ", "); }
		format(out.s, matched[k]);
		first = false;
		k--;
	}
	format(out.s, "]");
	out.i = mc;
	g.steps += g.n + mc * mc;
	out
}
@end
