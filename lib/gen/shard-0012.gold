test: list=10,50,20
expect: => i=0 r=0.0 ok=true s="sorted every other cache element with 0 swaps" errors=0 n=3 res=[10,50,20] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				count++;
			}
			j += 2;
		}
		i += 2;
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted every other cache element with ", count, " swaps");
	out
}
@end
