code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cyc = ${cycles};
	var total_squares = 0;
	for _ in cyc {
		for i in g.n {
			if core_is_square(g.res[i]) {
				total_squares++;
			}
		}
	}
	gold_push(g, total_squares);
	g.steps += cyc * g.n + 1;
	out.i = total_squares;
	out.s.clear();
	format(out.s, "split square comparisons total ", total_squares);
	out
}
