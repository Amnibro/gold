code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${prefix_len};
	var bound = if p < g.n { p } else { g.n };
	if bound < 0 { bound = 0; }
	if bound > 1 {
		let first = g.res[0];
		for i in bound - 1 { g.res[i] = g.res[i + 1]; }
		g.res[bound - 1] = first;
	}
	out.i = bound;
	g.steps += bound;
	out
}
@end
