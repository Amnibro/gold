test: list=12,23
expect: => i=3 r=0.0 ok=true s="found 3 unique digits" errors=0 n=2 res=[12,23] cache=0 hits=0
test: list=10,-5
expect: => i=0 r=0.0 ok=false s="negative digit error" errors=1 n=2 res=[10,-5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[10] = [0; 10];
	for k in g.n {
		if g.res[k] < 0 {
			gold_fail(g, "negative value invalid for digits");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "negative digit error");
			return out;
		}
		var x = g.res[k];
		if x == 0 { seen[0] = 1; }
		while x > 0 {
			let d = x % 10;
			seen[d] = 1;
			x /= 10;
		}
	}
	var count = 0;
	for k in 10 {
		if seen[k] == 1 { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " unique digits");
	out
}
@end
