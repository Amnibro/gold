fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise drop");
		out.ok = false;
		return out;
	}
	var w = 1;
	var dropped = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			dropped++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	if dropped == 0 {
		gold_fail(g, "no adjacent duplicate error pairs dropped");
	}
	g.n = w;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped pairwise error duplicates ", dropped);
	out
}
@end
