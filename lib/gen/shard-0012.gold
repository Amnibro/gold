fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	for i in g.n / 2 {
		let opp = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied function and reversed ", g.n, " items");
	out
}
@end
