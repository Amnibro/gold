@entry 2cfcefe326726b25
kind: step
verb: drop
noun: tally
modifier: with_retry
context: aggregate
phrase: drop tally results below {threshold} with retry {attempts}
phrase: prune tally items below {threshold} retrying up to {attempts} times
slot: threshold int
slot: attempts int
test: list=1,2,2,3,3,3 threshold=2 attempts=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[2,2,3,3,3] cache=0 hits=0
test: list=5,5,6 threshold=3 attempts=1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let thresh = ${threshold};
    let max_tries = ${attempts};
    var dropped = 0;
    var attempt = 0;
    while attempt < max_tries {
        var write_idx = 0;
        dropped = 0;
        for read_idx in 0..g.n {
            let item = g.res[read_idx];
            var count = 0;
            for j in 0..g.n {
                if g.res[j] == item { count += 1; }
            }
            if count >= (thresh - attempt) {
                g.res[write_idx] = item;
                write_idx += 1;
            } else {
                dropped += 1;
            }
        }
        g.n = write_idx;
        if g.n > 0 || attempt + 1 >= max_tries { break; }
        attempt += 1;
    }
    v.i = dropped;
    v.ok = dropped > 0;
    v
}
@end
