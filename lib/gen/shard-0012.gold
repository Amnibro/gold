@entry d8aa27a3c70cf56d
kind: step
verb: validate
noun: budget
modifier: with_retry
context: aggregate
slot: budget int
phrase: validate aggregate budget with retry allowance under {budget}
phrase: check aggregate sum against budget limit {budget}
test: list=10,20,30 budget=70
expect: => i=60 r=0.0 ok=true s="budget satisfied sum: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=20,30,40 budget=60
expect: => i=50 r=0.0 ok=true s="budget satisfied sum: 50" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	var retried = false;
	if total > b && g.n > 0 {
		total -= g.res[g.n - 1];
		g.n = g.n - 1;
		retried = true;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	if total <= b {
		format(out.s, "budget satisfied sum: ", total);
	} else {
		gold_fail(g, "budget exceeded despite retry drop");
		out.ok = false;
		format(out.s, "budget exceeded: ", total);
	}
	out
}
@end
