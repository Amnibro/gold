code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] % 2 != 0 {
			sum += g.res[i];
		}
		i--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed backwards odds ", sum);
	out
}
@end
