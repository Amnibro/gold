verb: group
noun: number
modifier: with_cache
context: loop
slot: modulus int
phrase: group numbers into buckets with cache using modulus {modulus}
phrase: partition loop number counts with cache using {modulus}
test: list=10,11,12,13,14 modulus=3
expect: => i=1 r=0.0 ok=true s="grouped numbers in modulus zero bucket 1" errors=0 n=5 res=[10,11,12,13,14] cache=1 hits=0
test: list=2,4,6,8 modulus=2
expect: => i=4 r=0.0 ok=true s="grouped numbers in modulus zero bucket 4" errors=0 n=4 res=[2,4,6,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	var zero_bucket = 0;
	for i in g.n {
		if g.res[i] % m == 0 {
			zero_bucket++;
		}
	}
	gold_cache_put(g, m, zero_bucket);
	g.steps += g.n;
	out.i = zero_bucket;
	out.s.clear();
	format(out.s, "grouped numbers in modulus zero bucket ", zero_bucket);
	out
}
@end
