	if times <= 0 {
		return out;
	}
	gold_clear(g);
	for k in times {
		gold_push(g, out.i);
	}
	g.steps += times;
	out.s.clear();
	format(out.s, "filled tally of ", out.i, " count ", times);
	out
}
@end
