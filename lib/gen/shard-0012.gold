	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	g.steps += g.n;
	out.i = avg;
	if avg > max_avg {
		gold_fail(g, "average exceeded maximum ceiling");
		out.ok = false;
		out.s.clear();
		format(out.s, "average exceeded ceiling");
	} else {
		out.s.clear();
		format(out.s, "average is ", avg);
	}
	out
}
@end
