kind: step
verb: search
noun: gaps
modifier: in_place
context: filter
slot: min_gap int
phrase: search filtered gaps in place above {min_gap}
phrase: locate in place filter gaps exceeding {min_gap}
test: list=5,10,25,30,50 min_gap=12
expect: => i=2 r=0.0 ok=true s="found 2 gaps exceeding 12" errors=0 n=2 res=[15,20] cache=0 hits=0
