fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var modified = 0;
	while i < out.s.len {
		let b = out.s[i];
		if b >= 97 && b <= 122 {
			out.s[i] = b - 32;
			modified++;
		}
		i += 2;
	}
	g.steps += out.s.len;
	out.i = modified;
	out
}
@end
