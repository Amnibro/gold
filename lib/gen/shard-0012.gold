@entry a7989b8a9219adb8
kind: step
verb: pair
noun: digits
modifier: unique
context: format
phrase: format unique digit pairs extracted from numbers
phrase: display distinct adjacent digit pairs in formatted string
test: list=1223,4455
expect: => i=6 r=0.0 ok=true s="unique digit pairs: [23, 22, 12, 55, 45, 44]" errors=0 n=2 res=[1223,4455] cache=0 hits=0
test: list=9887,6655
expect: => i=6 r=0.0 ok=true s="unique digit pairs: [87, 88, 98, 55, 65, 66]" errors=0 n=2 res=[9887,6655] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	var pairs int[512] = [0; 512];
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		while x >= 10 {
			let pair_val = x % 100;
			var seen = false;
			for u in unique { if pairs[u] == pair_val { seen = true; break; } }
			if !seen {
				pairs[unique] = pair_val;
				unique++;
			}
			x /= 10;
		}
	}
	out.s.clear();
	format(out.s, "unique digit pairs: [");
	for u in unique {
		if u > 0 { format(out.s, ", "); }
		format(out.s, pairs[u]);
	}
	format(out.s, "]");
	out.i = unique;
	g.steps += g.n * 10;
	out
}
@end
