test: list=10,20,15,30,40 prefix_len=3
expect: => i=4 r=0.0 ok=true s="filtered prefix pairwise kept: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	var limit = pl;
	if limit > g.n { limit = g.n; }
	var kept = 0;
	if limit >= 1 {
		g.res[kept] = g.res[0];
		kept++;
	}
	var i = 1;
	while i < limit {
		if g.res[i] >= g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered prefix pairwise kept: ", kept);
	out
}
@end
