code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_steps};
	var retries = 0;
	while retries < lim {
		for i in g.n { g.res[i] += 1; }
		retries++;
	}
	g.steps += g.n * retries;
	out.i = retries;
	out.s.clear();
	format(out.s, "retried history adjustments: ", retries);
	out
}
@end
@entry 5d9272902c7adbca
kind: step
verb: keep
noun: total
modifier: recursively
context: list
phrase: keep reducing list total recursively until single digit
phrase: compute recursive digit sum total of list elements
test: list=15,28,34
expect: => i=5 r=0.0 ok=true s="recursive total digit: 5" errors=0 n=3 res=[15,28,34] cache=0 hits=0
test: list=99,88
expect: => i=7 r=0.0 ok=true s="recursive total digit: 7" errors=0 n=2 res=[99,88] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var steps = 0;
	var cur = if sum < 0 { -sum } else { sum };
	while cur >= 10 && steps < 50 {
		var next_sum = 0;
		while cur > 0 { next_sum += cur % 10; cur /= 10; }
		cur = next_sum;
		steps++;
	}
	g.steps += g.n + steps;
	out.i = cur;
	out.s.clear();
	format(out.s, "recursive total digit: ", cur);
	out
}
@end
