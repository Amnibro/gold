	var count = 0;
	out.s.clear();
	format(out.s, "primes: [");
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if count > 0 { format(out.s, ", "); }
			format(out.s, x);
			count++;
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
