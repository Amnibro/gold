code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = g.n / 2;
	var i = start;
	while i < g.n {
		g.res[i] *= 2;
		i++;
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "scaled ", out.i, " tail items in place");
	out
}
@end
