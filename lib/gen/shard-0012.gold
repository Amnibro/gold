test: list=10,20,30 budget=15
expect: => i=1 r=0.0 ok=true s="budgeted 1 items in cache" errors=0 n=1 res=[10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${budget};
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	var sum = 0;
	var new_n = 0;
	for k in g.n {
		if sum + g.res[k] <= budget {
			sum += g.res[k];
			g.res[new_n] = g.res[k];
			new_n++;
		}
	}
	g.n = new_n;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "budgeted ", new_n, " items in cache");
	out
}
@end
