fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${prefix_len};
	let bound = if p < g.n { p } else { g.n };
	out.s.clear();
	format(out.s, "reversed prefix: [");
	var k = bound - 1;
	while k >= 0 {
		if k < bound - 1 { format(out.s, ", "); }
		format(out.s, g.res[k]);
		k--;
	}
	format(out.s, "]");
	out.i = bound;
	g.steps += bound;
	out
}
