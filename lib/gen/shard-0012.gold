kind: step
verb: rank
noun: average
modifier: while
context: search
phrase: rank search hits exceeding average cutoff {thresh}
phrase: order results while score surpasses average {thresh}
slot: thresh int
test: list=20,10,40,30 thresh=15
expect: => i=3 r=0.0 ok=true s="ranked 3 items above average" errors=0 n=3 res=[40,30,20] cache=0 hits=0
test: list=5,25,15,35 thresh=20
expect: => i=2 r=0.0 ok=true s="ranked 2 items above average" errors=0 n=2 res=[35,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${thresh};
	var new_n = 0;
	for k in g.n {
		if g.res[k] > thresh {
			g.res[new_n] = g.res[k];
			new_n++;
		}
	}
	g.n = new_n;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] < g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items above average");
	out
}
@end
@entry 18b36bd4e91d345f
kind: step
verb: return
noun: pairs
modifier: sorted
context: search
phrase: return adjacent search score pairs sorted
phrase: compute sorted adjacent differences across query hits
test: list=10,25,30
expect: => i=2 r=0.0 ok=true s="returned 2 sorted pairs" errors=0 n=2 res=[5,15] cache=0 hits=0
test: list=4,20,22
expect: => i=2 r=0.0 ok=true s="returned 2 sorted pairs" errors=0 n=2 res=[2,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let pairs = g.n - 1;
	for k in pairs {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n = pairs;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			var j = 0;
			while j < g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned ", g.n, " sorted pairs");
	out
}
@end
