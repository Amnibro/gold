	if x == 0 { return 1; }
	var digits int[..16] = [];
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	let first_val = digits[digits.len - 1];
	var rank = 1;
	for i in 0..digits.len - 1 {
