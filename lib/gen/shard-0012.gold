expect: => i=3 r=0.0 ok=true s="rotated search cache" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	if g.cn > 1 {
		let fk = g.ck[0];
		let fv = g.cv[0];
		for k in g.cn - 1 {
			g.ck[k] = g.ck[k + 1];
			g.cv[k] = g.cv[k + 1];
		}
		g.ck[g.cn - 1] = fk;
		g.cv[g.cn - 1] = fv;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "rotated search cache");
	out
}
@end
