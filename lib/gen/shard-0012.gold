fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = g.n / 2;
	var sum = 0;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += g.n - start;
	out.i = sum;
	out.s.clear();
	format(out.s, "tail sum ", sum);
	out
}
@end
@entry c3b5926f1ba367c4
kind: step
verb: map
noun: streak
modifier: with_retry
context: search
phrase: map longest matching streak with retry limit {max_retries}
phrase: find longest streak of equal items bounded by {max_retries}
slot: max_retries int
test: list=1,1,1,2,2 max_retries=4
expect: => i=3 r=0.0 ok=true s="longest streak bounded 3" errors=0 n=5 res=[1,1,1,2,2] cache=0 hits=0
test: list=5,6,6,6,6 max_retries=3
expect: => i=3 r=0.0 ok=true s="longest streak bounded 3" errors=0 n=5 res=[5,6,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_retries};
	var max_streak = 0;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
		}
		i++;
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	if max_streak > lim { max_streak = lim; }
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak bounded ", max_streak);
	out
}
@end
