code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${streak_len};
	var streaks = 0;
	var curr_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			curr_run++;
			if curr_run == slen {
				streaks++;
				g.res[i] = 0;
			}
		} else {
			curr_run = 1;
		}
	}
	g.steps += g.n + 1;
	out.i = streaks;
	out.s.clear();
	format(out.s, "split streaks in place count ", streaks);
	out
}
@end
