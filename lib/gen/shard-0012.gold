@entry a31cf821b299d736
kind: step
verb: validate
noun: step
modifier: recursively
context: format
slot: max_gap int
phrase: validate step transitions recursively within {max_gap}
phrase: check consecutive step distances do not exceed {max_gap}
test: list=10,15,18,22 max_gap=6
expect: => i=5 r=0.0 ok=true s="steps valid max gap: 5" errors=0 n=4 res=[10,15,18,22] cache=0 hits=0
test: list=5,20,25 max_gap=10
expect: => i=15 r=0.0 ok=false s="step gap exceeded limit: 15" errors=1 n=3 res=[5,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	var valid = true;
	var max_seen = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d > max_seen { max_seen = d; }
			if d > limit { valid = false; }
		}
	}
	g.steps += g.n;
	out.i = max_seen;
	out.s.clear();
	if valid {
		format(out.s, "steps valid max gap: ", max_seen);
	} else {
		gold_fail(g, "step difference exceeded allowed gap");
		out.ok = false;
		format(out.s, "step gap exceeded limit: ", max_seen);
	}
	out
}
@end
