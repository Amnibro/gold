code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var zeroed = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if seen {
			g.res[i] = 0;
			zeroed++;
		}
	}
	g.steps += g.n;
	out.i = zeroed;
	out.s.clear();
	format(out.s, "safely zeroed ", zeroed, " duplicates");
	out
}
@end
