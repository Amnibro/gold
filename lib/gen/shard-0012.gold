code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var seg_len = k;
	if seg_len > g.n { seg_len = g.n; }
	var start = g.n - seg_len;
	let end_pos = g.n;
	var added = 0;
	var i = start;
	while i < end_pos {
		gold_push(g, g.res[i]);
		added++;
		i++;
	}
	g.steps += g.n;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated ", added, " tail items");
	out
}
@end
