fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var count = 0;
	var merged = 0;
	for i in g.n {
		if g.res[i] == max_val && count < att {
			merged += g.res[i];
			count++;
		}
	}
	gold_push(g, merged);
	g.steps += g.n + count;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged maximum with retries sum: ", merged);
	out
}
