fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	for i in g.n {
		for j in i {
			if g.res[i] == g.res[j] {
				dups++;
				break;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found ", dups, " nested search duplicates");
	out
}
