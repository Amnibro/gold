@entry 83cc16bcf33e83ec
kind: step
verb: find
noun: total
modifier: with_retry
context: aggregate
phrase: find total sum with retry count {retries}
phrase: aggregate total sum retrying up to {retries} passes
slot: retries int
test: list=-10,5,15 retries=1
expect: => i=10 r=0.0 ok=true s="" errors=0 n=4 res=[-10,5,15,10] cache=0 hits=0
test: list=-20,-10,5,30 retries=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[-20,-10,5,30,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    let max_retries = ${retries};
    var current_sum = 0;
    var attempt = 0;
    while attempt <= max_retries {
        current_sum = 0;
        for i in 0..g.n {
            current_sum += g.res[i];
        }
        if current_sum > 0 || attempt == max_retries || g.n == 0 {
            break;
        }
        var min_idx = 0;
        for i in 1..g.n {
            if g.res[i] < g.res[min_idx] {
                min_idx = i;
            }
        }
        for i in min_idx..(g.n - 1) {
            g.res[i] = g.res[i + 1];
        }
        g.n -= 1;
        attempt += 1;
    }
    gold_push(g, current_sum);
    v.i = current_sum;
    v.ok = current_sum > 0;
    v
}
@end
