fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	for i in out.s.len {
		let b = out.s[i] as int;
		if core_is_prime(b) {
			var seen = false;
			for j in g.cn {
				let cached, found = gold_cache_get(g, j);
				if found && cached == b {
					seen = true;
					break;
				}
			}
			if !seen {
				gold_cache_put(g, g.cn, b);
				gold_push(g, b);
			}
		}
	}
	g.steps += out.s.len;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cached ", g.cn, " unique prime codes");
	out
}
@end
