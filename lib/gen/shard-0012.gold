    var dropped = 0;
    var write_idx = 0;
    for read_idx in 0..g.n {
        let val = g.res[read_idx];
        if val == needle {
            dropped += 1;
        } else {
            g.res[write_idx] = val;
            write_idx += 1;
        }
    }
    g.n = write_idx;
    v.i = dropped;
    v.ok = dropped > 0;
    v
}
@end
