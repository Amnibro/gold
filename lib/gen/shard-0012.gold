code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_streak};
	if g.n < 2 {
		gold_fail(g, "insufficient items for streak limit check");
		out.ok = false;
		return out;
	}
	var longest = 1;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
			if cur > longest { longest = cur; }
		} else {
			cur = 1;
		}
	}
	if longest > limit {
		gold_fail(g, "pairwise error streak exceeded limit");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "checked longest streak ", longest);
	out
}
@end
