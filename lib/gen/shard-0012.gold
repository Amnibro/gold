@entry 56ee8df50ade0f7f
kind: step
verb: normalize
noun: spaces
modifier: any
context: error
phrase: normalize any consecutive spaces in error text
phrase: collapse redundant spaces across error message string
test: text="disk   read   fail"
expect: => i=4 r=0.0 ok=true s="disk read fail [fixed 4]" errors=0 n=0 res=[] cache=0 hits=0
test: text=""
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty error text for space normalization");
		out.ok = false;
		return out;
	}
	var clean byte[..200] = "";
	var prev_space = false;
	var fixed = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if !prev_space {
				clean.push(b);
				prev_space = true;
			} else {
				fixed++;
			}
		} else {
			clean.push(b);
			prev_space = false;
		}
	}
	out.s.clear();
	for b in clean { out.s.push(b); }
	g.steps += out.s.len + fixed;
	out.i = fixed;
	format(out.s, " [fixed ", fixed, "]");
	out
}
@end
