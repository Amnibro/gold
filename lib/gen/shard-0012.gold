@entry f10f8b4487a8e20f
kind: step
verb: count
noun: tally
modifier: any
context: search
phrase: count tally of any values exceeding {thresh}
phrase: tally any search items greater than {thresh}
slot: thresh int
test: list=5,10,15,20 thresh=12
expect: => i=2 r=0.0 ok=true s="tally above threshold: 2" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=1,2,3 thresh=5
expect: => i=0 r=0.0 ok=true s="tally above threshold: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${thresh};
	var count = 0;
	for k in g.n {
		if g.res[k] > lim { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tally above threshold: ", count);
	out
}
@end
@entry 68b387cc0f983a34
kind: step
verb: merge
noun: odds
modifier: running
context: search
phrase: merge running sum of odd numbers in search
phrase: accumulate running totals across odd elements
test: list=1,2,3,4,5
expect: => i=9 r=0.0 ok=true s="running odd sum 9" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: list=3,5,7
expect: => i=15 r=0.0 ok=true s="running odd sum 15" errors=0 n=3 res=[3,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			sum += g.res[k];
			g.res[count] = sum;
			count++;
		}
	}
	g.steps += g.n;
	g.n = count;
	out.i = sum;
	out.s.clear();
	format(out.s, "running odd sum ", sum);
	out
}
@end
@entry 1d418048522fda43
kind: step
verb: keep
noun: prefix
modifier: last
context: search
phrase: keep prefix ending at last value {last_val}
phrase: retain initial items up to last occurrence of {last_val}
slot: last_val int
test: list=1,2,3,2,5 last_val=2
expect: => i=4 r=0.0 ok=true s="kept prefix size 4" errors=0 n=4 res=[1,2,3,2] cache=0 hits=0
test: list=10,20,30 last_val=20
expect: => i=2 r=0.0 ok=true s="kept prefix size 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${last_val};
	var last_idx = -1;
	for k in g.n {
		if g.res[k] == target { last_idx = k; }
	}
	if last_idx >= 0 {
		g.n = last_idx + 1;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept prefix size ", g.n);
	out
}
@end
@entry e7e7c189a4fb4008
kind: step
verb: scale
noun: results
modifier: with_retry
context: search
phrase: scale search results with retry limit {max_retries}
phrase: multiply result values bounded by retries {max_retries}
slot: max_retries int
test: list=1,2,3,4 max_retries=2
expect: => i=2 r=0.0 ok=true s="scaled 2 items with retry bound" errors=0 n=4 res=[3,6,3,4] cache=0 hits=0
test: list=5,10 max_retries=1
expect: => i=1 r=0.0 ok=true s="scaled 1 items with retry bound" errors=0 n=2 res=[15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_retries};
	var scaled = 0;
	while scaled < g.n && scaled < lim {
		g.res[scaled] *= 3;
		scaled++;
	}
	g.steps += scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " items with retry bound");
	out
}
@end
@entry a494e8015d732935
kind: step
verb: scale
noun: number
modifier: while
context: search
phrase: scale numbers while values stay below {cap}
phrase: multiply search items while under ceiling {cap}
slot: cap int
test: list=2,4,8,16,32 cap=10
expect: => i=3 r=0.0 ok=true s="scaled 3 numbers under cap" errors=0 n=5 res=[4,8,16,16,32] cache=0 hits=0
test: list=1,2,5,10 cap=4
expect: => i=2 r=0.0 ok=true s="scaled 2 numbers under cap" errors=0 n=4 res=[2,4,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var count = 0;
	for k in g.n {
		if g.res[k] >= ceiling { break; }
		g.res[k] *= 2;
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " numbers under cap");
	out
}
@end
