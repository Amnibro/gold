fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sl = ${step_len};
	var seg_len = sl;
	if seg_len > g.n { seg_len = g.n; }
	var sum = 0;
	var i = g.n - seg_len;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined last ", seg_len, " steps sum: ", sum);
	out
}
@end
