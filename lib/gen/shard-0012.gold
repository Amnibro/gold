expect: => i=2 r=0.0 ok=true s="sorted every other pair with 2 swaps" errors=0 n=6 res=[10,20,50,40,15,30] cache=0 hits=0
test: list=100,50,80,60,40,20
expect: => i=2 r=0.0 ok=true s="sorted every other pair with 2 swaps" errors=0 n=6 res=[50,100,80,60,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if (i / 2) % 2 == 0 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted every other pair with ", swaps, " swaps");
	out
}
@end
@entry 1dedfd2087a4418c
kind: step
verb: return
noun: cache
modifier: while
context: filter
slot: bound int
phrase: return cached filter elements while under {bound}
phrase: collect cache hits while values stay below {bound}
test: list=10,20,30,40 bound=25
expect: => i=2 r=0.0 ok=true s="returned cache while under bound: 2" errors=0 n=2 res=[10,20] cache=3 hits=3
test: list=5,15,25,35,45 bound=20
expect: => i=2 r=0.0 ok=true s="returned cache while under bound: 2" errors=0 n=2 res=[5,15] cache=3 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var hits = 0;
	var kept = 0;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
		let val, ok = gold_cache_get(g, i);
		if ok && val < b {
			g.res[kept] = val;
			kept++;
			hits++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = hits;
	out.s.clear();
	format(out.s, "returned cache while under bound: ", hits);
	out
}
@end
