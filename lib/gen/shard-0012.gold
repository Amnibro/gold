@entry 71e323ade8efd1c4
kind: step
verb: shift
noun: average
modifier: until
context: math
phrase: shift elements toward average until target count {count}
phrase: adjust values toward mean until reaching count {count}
slot: count int
test: list=10,30,50 count=2
expect: => i=2 r=0.0 ok=true s="shifted 2 values toward average" errors=0 n=3 res=[11,30,50] cache=0 hits=0
test: list=2,20,40,60 count=3
expect: => i=3 r=0.0 ok=true s="shifted 3 values toward average" errors=0 n=4 res=[3,21,39,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if g.n == 0 || count <= 0 {
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var actual = if count > g.n { g.n } else { count };
	for i in actual {
		if g.res[i] < avg {
			g.res[i] += 1;
		} else if g.res[i] > avg {
			g.res[i] -= 1;
		}
	}
	g.steps += actual;
	out.i = actual;
	out.s.clear();
	format(out.s, "shifted ", actual, " values toward average");
	out
}
@end
