			for j in (i + 1)..g.n {
				if g.res[i] * g.res[j] > th {
					matches++;
				}
			}
		}
	}
	gold_push(g, matches);
	g.steps += g.n * g.n + 1;
	out.i = matches;
	out.s.clear();
	format(out.s, "nested pair product matches ", matches);
	out
}
