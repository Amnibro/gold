code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var temp int[512] = [0; 512];
	var m = 0;
	var dups = 0;
	for i in g.n {
		temp[m] = g.res[i];
		m++;
		if g.res[i] == max_val {
			temp[m] = max_val;
			m++;
			dups++;
		}
	}
	for i in m {
		g.res[i] = temp[i];
	}
	g.n = m;
	g.steps += m;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicated maximum ", dups, " times");
	out
}
@end
