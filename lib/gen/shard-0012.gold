fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x <= 1 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		g.res[i] = if is_p { 1 } else { 0 };
		if is_p {
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "traced primes in place");
	out
}
@end
