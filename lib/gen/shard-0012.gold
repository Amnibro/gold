noun: window
modifier: running
context: stats
phrase: sort window running of width {k}
phrase: order elements within running window {k}
slot: k int
test: list=5,3,8,2,6,1 k=3
expect: => i=6 r=0.0 ok=true s="sorted window running" errors=0 n=6 res=[3,5,8,1,2,6] cache=0 hits=0
test: list=4,1,9,2 k=2
expect: => i=4 r=0.0 ok=true s="sorted window running" errors=0 n=4 res=[1,4,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${k};
	if w <= 1 || g.n <= 1 {
		return out;
	}
	var start = 0;
	while start + w <= g.n {
		var i = start + 1;
		while i < start + w {
			let val = g.res[i];
			var j = i - 1;
			while j >= start && g.res[j] > val {
				g.res[j + 1] = g.res[j];
				j--;
			}
			g.res[j + 1] = val;
			i++;
		}
		start += w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted window running");
	out
}
@end
