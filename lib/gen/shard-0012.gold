expect: => i=2 r=0.0 ok=true s="found memo entry meeting threshold" errors=0 n=3 res=[10,20,30] cache=3 hits=3
test: list=5,15,35 target=40
expect: => i=-1 r=0.0 ok=true s="no memo entry reached threshold" errors=0 n=3 res=[5,15,35] cache=3 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var found_key = -1;
	for k in g.n {
		let val, ok = gold_cache_get(g, k);
		if ok && val >= tgt { found_key = k; break; }
	}
	g.steps += g.n;
	out.i = found_key;
	out.s.clear();
	format(out.s, if found_key >= 0 { "found memo entry meeting threshold" } else { "no memo entry reached threshold" });
	out
}
@end
