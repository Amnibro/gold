		var i = 0;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
