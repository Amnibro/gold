test: list=5,8,4,12,6 cap=15
expect: => i=4 r=0.0 ok=true s="merged safely into 4 elements" errors=0 n=4 res=[13,4,12,6] cache=0 hits=0
test: list=10,2,3,20 cap=15
expect: => i=2 r=0.0 ok=true s="merged safely into 2 elements" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 { return out; }
	var write_i = 0;
	var i = 0;
	while i < g.n {
		var cur = g.res[i];
		while i + 1 < g.n && cur + g.res[i + 1] <= limit {
			cur += g.res[i + 1];
			i++;
		}
		g.res[write_i] = cur;
		write_i++;
		i++;
	}
	g.steps += g.n;
	g.n = write_i;
	out.i = write_i;
	out.s.clear();
	format(out.s, "merged safely into ", write_i, " elements");
	out
}
@end
