fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i + 1, g.res[i]); }
	let pairs = g.cn / 2;
	for i in pairs {
		let k1 = g.ck[2 * i];
		let v1 = g.cv[2 * i];
		g.ck[2 * i] = g.ck[2 * i + 1];
		g.cv[2 * i] = g.cv[2 * i + 1];
		g.ck[2 * i + 1] = k1;
		g.cv[2 * i + 1] = v1;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "reversed ", pairs, " cache pairs");
	out
}
@end
