@entry 4282519bec1f6ec7
kind: step
verb: split
noun: suffix
modifier: first
context: loop
slot: suffix_len int
phrase: split suffix first loop elements with length {suffix_len}
phrase: isolate leading suffix loop items of length {suffix_len}
test: list=10,20,30,40,50 suffix_len=3
expect: => i=30 r=0.0 ok=true s="split first suffix element 30" errors=0 n=6 res=[10,20,30,40,50,30] cache=0 hits=0
test: list=7,14,21 suffix_len=2
expect: => i=14 r=0.0 ok=true s="split first suffix element 14" errors=0 n=4 res=[7,14,21,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	if slen <= 0 || g.n == 0 {
		gold_fail(g, "invalid suffix length");
		out.ok = false;
		return out;
	}
	let start = if g.n >= slen { g.n - slen } else { 0 };
	let first_elem = g.res[start];
	out.i = first_elem;
	gold_push(g, first_elem);
	g.steps += slen + 1;
	out.s.clear();
	format(out.s, "split first suffix element ", first_elem);
	out
}
@end
