code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	var kept = 0;
	for i in g.n {
		var is_dup = false;
		for j in i {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
		}
		if is_dup {
			g.res[kept] = g.res[i];
			kept++;
			dup_count++;
		}
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "selected ", dup_count, " duplicate items");
	out
}
@end
