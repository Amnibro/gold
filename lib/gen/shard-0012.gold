fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_run};
	var matching_runs = 0;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
		} else {
			if cur >= req { matching_runs++; }
			cur = 1;
		}
	}
	if cur >= req { matching_runs++; }
	g.steps += g.n;
	out.i = matching_runs;
	out.s.clear();
	format(out.s, "found ", matching_runs, " runs of length at least ", req);
