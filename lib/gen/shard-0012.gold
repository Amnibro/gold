noun: subfunction
modifier: recursively
context: math
slot: sub fn
phrase: scan elements applying recursive subfunction {sub}
phrase: apply subfunction {sub} across list items
test: list=1,2,3,4 sub=square
expect: => i=30 r=0.0 ok=true s="mapped: [1, 4, 9, 16]" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
