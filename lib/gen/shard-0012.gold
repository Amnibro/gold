code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches int[512] = [0; 512];
	var non_matches int[512] = [0; 512];
	var m_count = 0;
	var nm_count = 0;
	for i in g.n {
		if ${cond}(g.res[i]) {
			matches[m_count] = g.res[i];
			m_count++;
		} else {
			non_matches[nm_count] = g.res[i];
			nm_count++;
		}
	}
	for i in m_count { g.res[i] = matches[i]; }
	for i in nm_count { g.res[m_count + i] = non_matches[i]; }
	g.steps += g.n;
	out.i = m_count;
	out.s.clear();
	format(out.s, "grouped ", m_count, " matching elements");
	out
}
@end
