@entry ab6fb2302303766c
kind: step
verb: split
noun: squares
modifier: unique
context: compare
phrase: split squares unique gathering distinct square values
phrase: isolate unique perfect squares from comparison results
test: list=4,9,4,16,9,25
expect: => i=4 r=0.0 ok=true s="split unique squares count 4" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=2,3,5,7
expect: => i=0 r=0.0 ok=true s="split unique squares count 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_squares int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_square(x) {
			var seen = false;
			for j in un {
				if uniq_squares[j] == x { seen = true; break; }
			}
			if !seen {
				uniq_squares[un] = x;
				un++;
			}
		}
	}
	g.n = un;
	for i in un {
		g.res[i] = uniq_squares[i];
	}
	g.steps += g.n + 1;
	out.i = un;
	out.s.clear();
	format(out.s, "split unique squares count ", un);
	out
}
@end
