kind: step
verb: clamp
noun: steps
modifier: running
context: retry
phrase: clamp steps running cumulative ceiling {step_cap}
phrase: bound steps running cumulative limit {step_cap}
slot: step_cap int
test: list=5,10,15,20 step_cap=25
expect: => i=25 r=0.0 ok=true s="running clamped total: 25" errors=0 n=4 res=[5,10,10,0] cache=0 hits=0
test: list=2,3,4 step_cap=10
expect: => i=9 r=0.0 ok=true s="running clamped total: 9" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${step_cap};
	var running = 0;
	var clamped_count = 0;
	for i in g.n {
		running += g.res[i];
		if running > cap {
			g.res[i] = cap - (running - g.res[i]);
			running = cap;
			clamped_count++;
		}
	}
	g.steps += clamped_count;
	out.i = running;
	out.s.clear();
	format(out.s, "running clamped total: ", running);
	out
}
@end
