	var i = 0;
	while i + stride < g.n {
		if g.res[i] > g.res[i + stride] {
			valid = false;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	if !valid {
		gold_fail(g, "pairs every other order violation");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = i;
	out.s.clear();
	format(out.s, "validated interval pairs: ", i);
	out
}
