noun: checkpoint
modifier: none
context: stats
phrase: find cumulative midpoint checkpoint in sample series
phrase: locate half total checkpoint index across observations
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="checkpoint at: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,5,15,30
expect: => i=3 r=0.0 ok=true s="checkpoint at: 3" errors=0 n=5 res=[5,5,5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let half = total / 2;
	var running = 0;
	var idx = 0;
	for i in g.n {
		running += g.res[i];
		if running >= half {
			idx = i;
			break;
		}
	}
	out.i = idx;
	out.s.clear();
	format(out.s, "checkpoint at: ", idx);
	out
}
@end
