@entry 3757e1273c53bc59
kind: step
verb: search
noun: counter
modifier: sorted
context: filter
phrase: search counter sorted matches for target {target}
phrase: count counter sorted occurrences of value {target}
slot: target int
test: list=4,2,4,1,4,3 target=4
expect: => i=3 r=0.0 ok=true s="found sorted target occurrences: 3" errors=0 n=6 res=[1,2,3,4,4,4] cache=0 hits=0
test: list=7,7,2,8 target=7
expect: => i=2 r=0.0 ok=true s="found sorted target occurrences: 2" errors=0 n=4 res=[2,7,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var p = 0;
	while p < g.n {
		var q = 0;
		while q + 1 < g.n {
			if g.res[q] > g.res[q + 1] {
				let t = g.res[q];
				g.res[q] = g.res[q + 1];
				g.res[q + 1] = t;
			}
			q++;
		}
		p++;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == tgt { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found sorted target occurrences: ", count);
	out
}
@end
