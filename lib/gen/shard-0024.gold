expect: => i=20 r=0.0 ok=true s="pair gaps times factor total: 20" errors=0 n=4 res=[10,14,20,20] cache=0 hits=0
test: list=5,15 multiplier=3
expect: => i=30 r=0.0 ok=true s="pair gaps times factor total: 30" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var total_gap = 0;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		let ag = if gap < 0 { -gap } else { gap };
		total_gap += ag;
		i++;
	}
	let result = total_gap * m;
	gold_push(g, result);
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "pair gaps times factor total: ", result);
	out
}
@end
