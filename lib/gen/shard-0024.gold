@entry cdca4ecd8e8ad118
kind: step
verb: scale
noun: results
modifier: with_retry
context: stats
slot: factor int
slot: max_allowed int
phrase: scale results with retry factor {factor} under {max_allowed}
phrase: multiply results with retry threshold {max_allowed} by {factor}
test: list=2,5,10 factor=2 max_allowed=50
expect: => i=3 r=0.0 ok=true s="scaled results with retry factor: 2" errors=0 n=3 res=[4,10,20] cache=0 hits=0
test: list=10,30 factor=3 max_allowed=50
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let max_lim = ${max_allowed};
	var overflow = false;
	var i = 0;
	while i < g.n {
		let scaled = g.res[i] * f;
		if scaled > max_lim {
			overflow = true;
			break;
		}
		g.res[i] = scaled;
		i++;
	}
	g.steps += i;
	if overflow {
		gold_fail(g, "scale results with retry: threshold exceeded");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "scaled results with retry factor: ", f);
	}
	out
}
@end
@entry 36552a71afd3313b
kind: step
