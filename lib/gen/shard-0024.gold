fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 || k > g.n {
		gold_fail(g, "sample count exceeds available items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid sample count");
		return out;
	}
	var sum = 0;
	for i in k {
		sum += g.res[i];
	}
	let avg = sum / k;
	out.i = avg;
	out.s.clear();
	format(out.s, "collected first average: ", avg);
	out
}
@end
@entry a21ba7cd96a7f948
kind: step
verb: drop
noun: tail
modifier: until
context: error
phrase: drop tail items backwards until finding cutoff {cutoff}
phrase: prune tail elements until matching boundary {cutoff}
slot: cutoff int
test: list=5,8,12,8,2 cutoff=12
expect: => i=3 r=0.0 ok=true s="tail pruned to length: 3" errors=0 n=3 res=[5,8,12] cache=0 hits=0
test: list=5,8,2 cutoff=99
expect: => i=0 r=0.0 ok=false s="error: cutoff not found" errors=1 n=3 res=[5,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var cut_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == cut {
			cut_idx = i;
			break;
		}
		i--;
	}
	if cut_idx < 0 {
		gold_fail(g, "tail cutoff value not encountered");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cutoff not found");
		return out;
	}
	g.n = cut_idx + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail pruned to length: ", g.n);
	out
}
@end
