expect: => i=3 r=0.0 ok=true s="deduped tail count: 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let md = ${max_dups};
	let start = if g.n > sp { g.n - sp } else { 0 };
	var kept = start;
	for i in start..g.n {
		let x = g.res[i];
		var seen = 0;
		for j in start..kept {
			if g.res[j] == x { seen++; }
		}
		if seen < md {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped tail count: ", kept);
	out
}
@end
