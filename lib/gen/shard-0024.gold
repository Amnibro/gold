@entry 513f77af25c2d1d6
kind: step
verb: merge
noun: odds
modifier: safely
context: stats
phrase: merge odds safely into sample total
phrase: accumulate odd sample values safely
test: list=1,4,5,8
expect: => i=6 r=0.0 ok=true s="merged odd values safely sum: 6" errors=0 n=5 res=[1,4,5,8,6] cache=0 hits=0
test: list=3,7,2
expect: => i=10 r=0.0 ok=true s="merged odd values safely sum: 10" errors=0 n=4 res=[3,7,2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let is_odd = if x < 0 { (-x) % 2 == 1 } else { x % 2 == 1 };
		if is_odd {
			sum += x;
		}
		i++;
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged odd values safely sum: ", sum);
	out
}
@end
@entry 9228d6fbdce3f2b5
kind: step
verb: reverse
noun: minimum
modifier: last
context: stats
phrase: reverse minimum last element across sample
phrase: place minimum sample value at last index
test: list=10,2,30,40
expect: => i=2 r=0.0 ok=true s="moved minimum to last position: 2" errors=0 n=4 res=[10,40,30,2] cache=0 hits=0
test: list=5,20,1
expect: => i=1 r=0.0 ok=true s="moved minimum to last position: 1" errors=0 n=3 res=[5,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
		i++;
	}
	let last = g.n - 1;
	let tmp = g.res[min_idx];
	g.res[min_idx] = g.res[last];
	g.res[last] = tmp;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "moved minimum to last position: ", min_val);
	out
}
@end
