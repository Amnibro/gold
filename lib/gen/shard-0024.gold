fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${offset} == 0 {
		gold_fail(g, "offset cannot be zero");
		out.ok = false;
		return out;
	}
	var running = 0;
	for i in g.n {
		running += ${offset};
		g.res[i] += running;
	}
	out.i = running;
	out.s.clear();
	format(out.s, "recursive total shift ", running);
	out
}
@end
