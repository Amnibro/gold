fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_drop_max_atleast_b334 = 0;
	let fl = ${floor};
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var dropped = 0;
	if max_val >= fl {
		var w = 0;
		for i in g.n {
			if g.res[i] == max_val {
				dropped++;
			} else {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += dropped + mark_drop_max_atleast_b334;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped max: ", dropped);
	out
}
