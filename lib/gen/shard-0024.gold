fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	gold_cache_put(g, 1, min_val);
	var kept = 0;
	for i in g.n {
		if g.res[i] != min_val {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = min_val;
	out.s.clear();
	format(out.s, "dropped min: ", min_val);
	out
}
@end
@entry 5091a30a8d016a4d
kind: step
verb: group
noun: streak
modifier: between
context: stats
phrase: group sample streaks with length from {minlen} to {maxlen}
phrase: identify observation streaks bounded by {minlen} through {maxlen}
slot: minlen int
slot: maxlen int
test: list=1,2,3,1,2,5,6,7,2 minlen=2 maxlen=4
expect: => i=1 r=0.0 ok=true s="streaks grouped: 1" errors=0 n=1 res=[3] cache=0 hits=0
test: list=10,20,5,15,25,35,45,2 minlen=3 maxlen=5
expect: => i=1 r=0.0 ok=true s="streaks grouped: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${minlen};
	let mx = ${maxlen};
	var streak_lens = [0; 512];
	var count = 0;
	var cur = 1;
	if g.n == 0 { return out; }
	for i in g.n - 1 {
		if g.res[i + 1] >= g.res[i] {
			cur++;
		} else {
			if cur >= mn && cur <= mx {
				streak_lens[count] = cur;
				count++;
			}
			cur = 1;
		}
	}
	if cur >= mn && cur <= mx {
		streak_lens[count] = cur;
		count++;
	}
	for i in count { g.res[i] = streak_lens[i]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "streaks grouped: ", count);
	out
}
@end
@entry 37054a7d277c2461
kind: step
verb: cache
noun: middle
modifier: at_most
context: stats
phrase: cache central sample observations at most {limit}
phrase: store at most {limit} central sample values in cache
slot: limit int
test: list=10,20,30,40,50 limit=3
expect: => i=3 r=0.0 ok=true s="cached middle: 3" errors=0 n=5 res=[10,20,30,40,50] cache=3 hits=0
test: list=4,8,12,16,20,24 limit=2
expect: => i=2 r=0.0 ok=true s="cached middle: 2" errors=0 n=6 res=[4,8,12,16,20,24] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 { return out; }
	let mid = g.n / 2;
	var start = mid - lim / 2;
	if start < 0 { start = 0; }
	var cached = 0;
	var idx = start;
	while idx < g.n && cached < lim {
		gold_cache_put(g, idx, g.res[idx]);
		cached++;
		idx++;
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "cached middle: ", cached);
	out
}
@end
