			g.img[y_weather_stone_layered * g.iw + x_weather_stone_layered] = t_weather_stone_layered / norm_weather_stone_layered;
		}
	}
	for k_weather_stone_layered in g.iw * g.ih {
		var q_weather_stone_layered = (g.img[k_weather_stone_layered] * 4.0) as! int;
		if q_weather_stone_layered > 3 { q_weather_stone_layered = 3; }
