	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.25); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "grime");
