test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="duplicates" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	while i < g.n {
		var count = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
			j++;
		}
		if count > 1 {
			var seen = false;
			var k = 0;
			while k < w {
				if g.res[k] == g.res[i] {
					seen = true;
					break;
				}
				k++;
			}
			if !seen {
				g.res[w] = g.res[i];
				gold_cache_put(g, g.res[w], count);
				w++;
			}
		}
		i++;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "duplicates");
	out
}
@end
