code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tuft_steep_buf byte[>..] = [];
	if ${n} < 1 || ${n} > 20 || ${h} <= 0.0 { gold_fail(g, "grass tuft params invalid"); out.ok = false; return out; }
	for tuft_i in ${n} {
		let tx_coord = (tuft_i as real) * 1.5;
		let tz_incline = (tuft_i as real) * 0.8;
		tuft_steep_buf.clear();
		gold_dnews(g, "grass", "", tuft_steep_buf);
		tuft_steep_buf.append(" cone ");
		gold_fnum(tuft_steep_buf, tx_coord);
		tuft_steep_buf.append(",0,");
		gold_fnum(tuft_steep_buf, tz_incline);
		tuft_steep_buf.append(" ");
		gold_fnum(tuft_steep_buf, tx_coord);
		tuft_steep_buf.append(",0,");
		gold_fnum(tuft_steep_buf, tz_incline + ${h});
		tuft_steep_buf.append(" r0.3 m:matte ");
		gold_hex(tuft_steep_buf, 80, 140, 60);
		gold_doc(g, tuft_steep_buf);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "steep grass paved");
	out
}
@end
