expect: => i=3 r=0.0 ok=true s="reversed series prefix of size 3" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
test: list=1,2 count=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${count} <= 0 {
		gold_fail(g, "count must be positive");
		out.ok = false;
		return out;
	}
	let k = if ${count} > g.n { g.n } else { ${count} };
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "reversed series prefix of size ", k);
	out
}
@end
