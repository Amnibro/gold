code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${radius} <= 0.0 || ${radius} > 1.0 { gold_fail(g, "radius invalid"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var last_ref byte[>..] = [];
	if !gold_dlast(g, last_ref) { out.ok = false; return out; }
	gold_dnews(g, "tgt_idle", "", obuf);
	obuf.append(" sphere ");
	obuf.append("0");
	obuf.append(",");
	obuf.append("0");
	obuf.append(",");
	obuf.append("1.4 ");
	obuf.append("r");
	gold_fnum(obuf, ${radius});
	obuf.append(" ^");
	obuf.append(last_ref);
	gold_doc(g, obuf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tgt_idle");
	out
}
@end
