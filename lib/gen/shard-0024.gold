code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_f = ${freq};
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		let x = g.res[i];
		var c = 0;
		for j in g.n { if g.res[j] == x { c++; } }
		if c >= min_f {
			buf[bn] = x;
			bn++;
		}
	}
	gold_clear(g);
	for i in bn { gold_push(g, buf[i]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "frequent count: ", bn);
	out
}
@end
