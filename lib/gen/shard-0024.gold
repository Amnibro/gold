code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_coll_words_while_b334 = 0;
	let ml = ${max_len};
	gold_clear(g);
	var cur_len = 0;
	var collected = 0;
	var stop = false;
	for b in v.s {
		if b == ' ' || b == '\t' || b == '\n' {
			if cur_len > 0 {
				if cur_len > ml { stop = true; break; }
				gold_push(g, cur_len);
				collected++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if !stop && cur_len > 0 {
		if cur_len <= ml {
			gold_push(g, cur_len);
			collected++;
		}
	}
	g.steps += collected + mark_coll_words_while_b334;
	out.i = collected;
	out.s.clear();
	format(out.s, "words: ", collected);
	out
}
@end
