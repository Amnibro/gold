@entry b8acdbc8249bba1d
kind: step
verb: sort
noun: limit
modifier: unique
context: filter
phrase: sort limit unique elements bounded by {limit}
phrase: order limit unique values capped at {limit}
slot: limit int
test: list=5,2,5,1,2,8 limit=3
expect: => i=3 r=0.0 ok=true s="unique sorted count: 3" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=9,4,9,4,1,3 limit=4
expect: => i=4 r=0.0 ok=true s="unique sorted count: 4" errors=0 n=4 res=[1,3,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var uniq = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for k in un {
			if uniq[k] == x { seen = true; break; }
		}
		if !seen {
			uniq[un] = x;
			un++;
		}
	}
	var p = 0;
	while p < un {
		var q = 0;
		while q + 1 < un {
			if uniq[q] > uniq[q + 1] {
				let tmp = uniq[q];
				uniq[q] = uniq[q + 1];
				uniq[q + 1] = tmp;
			}
			q++;
		}
		p++;
	}
	gold_clear(g);
	var count = 0;
	while count < un && count < lim {
		gold_push(g, uniq[count]);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "unique sorted count: ", count);
	out
}
@end
