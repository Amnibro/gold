@entry 3764b0d1d85a386f
kind: step
verb: drop
noun: primes
modifier: every_other
context: list
slot: start int
phrase: drop primes every_other occurrence starting at {start} in list
phrase: remove alternating prime numbers beginning from index {start} across list
test: list=2,3,4,5,6,7,8 start=0
expect: => i=2 r=0.0 ok=true s="dropped primes: 2" errors=0 n=5 res=[3,4,6,7,8] cache=0 hits=0
test: list=10,11,13,14,17 start=1
expect: => i=1 r=0.0 ok=true s="dropped primes: 1" errors=0 n=4 res=[10,11,14,17] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_drop_primes_eo_b334 = 0;
	let st = ${start};
	var p_count = 0;
	var w = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			if p_count >= st && (p_count - st) % 2 == 0 {
				dropped++;
			} else {
				g.res[w] = x;
				w++;
			}
			p_count++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += dropped + mark_drop_primes_eo_b334;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped primes: ", dropped);
	out
}
@end
