@entry ff340cda8a924232
kind: step
verb: validate
noun: budget
modifier: with_retry
context: math
phrase: validate budget ceiling with allowed retry reductions {limit} {retries}
phrase: verify total stays within budget permitting retry {limit} {retries}
slot: limit int
slot: retries int
test: list=10,20,30 limit=40 retries=2
expect: => i=30 r=0.0 ok=true s="budget valid sum: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 limit=50 retries=1
expect: => i=30 r=0.0 ok=true s="budget valid sum: 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let max_r = ${retries};
	var r = 0;
	while r <= max_r {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum <= lim {
			out.i = sum;
			out.s.clear();
			format(out.s, "budget valid sum: ", sum);
			return out;
		}
		if g.n > 0 {
			g.n--;
		}
		r++;
	}
	gold_fail(g, "budget exceeded after retries");
	out.ok = false;
	out
}
@end
