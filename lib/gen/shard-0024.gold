noun: squares
modifier: pairwise
context: list
phrase: keep squares pairwise adjacent threshold {limit}
phrase: retain squares pairwise adjacent ceiling {limit}
slot: limit int
test: list=1,4,9,2,3 limit=10
expect: => i=2 r=0.0 ok=true s="pairwise square items: 2" errors=0 n=2 res=[1,4] cache=0 hits=0
test: list=16,25,3 limit=30
expect: => i=2 r=0.0 ok=true s="pairwise square items: 2" errors=0 n=2 res=[16,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = [0; 512];
	var kn = 0;
	if g.n >= 2 {
		var i = 0;
		while i < g.n - 1 {
			let a = g.res[i];
			let b = g.res[i + 1];
			if core_is_square(a) && core_is_square(b) && a <= lim && b <= lim {
				kept[kn] = a;
				kn++;
				kept[kn] = b;
				kn++;
			}
			i += 2;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "pairwise square items: ", kn);
	out
}
@end
