noun: counter
modifier: running
context: cache
phrase: clamp counter running sum limit
phrase: bound running counter sum cache
test: list=10,20,30
expect: => i=45 r=0.0 ok=true s="counter" errors=0 n=3 res=[10,20,15] cache=3 hits=0
test: list=5,5,5
expect: => i=15 r=0.0 ok=true s="counter" errors=0 n=3 res=[5,5,5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run = 0;
	var i = 0;
	while i < g.n {
		run += g.res[i];
		if run > 45 {
			g.res[i] -= run - 45;
			run = 45;
		}
		gold_cache_put(g, i, run);
		i++;
	}
	out.i = run;
	out.s.clear();
	format(out.s, "counter");
	out
}
@end
