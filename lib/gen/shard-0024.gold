fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let me = ${max_entries};
	gold_cache_put(g, 10, 1);
	gold_cache_put(g, 20, 2);
	gold_cache_put(g, 30, 3);
	if g.cn > me {
		let remove_count = g.cn - me;
		g.cn -= remove_count;
		g.steps += remove_count;
	} else {
		g.steps++;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "retained cache count: ", g.cn);
	out
}
