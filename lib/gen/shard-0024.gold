@entry 37e0c914318ac157
kind: step
verb: sum
noun: suffix
modifier: unique
context: stats
phrase: sum suffix unique entries over tail {k_tail}
phrase: accumulate unique values in suffix of length {k_tail}
slot: k_tail int
test: list=2,4,4,6,6 k_tail=4
expect: => i=10 r=0.0 ok=true s="suffix uniq sum: 10" errors=0 n=1 res=[10] cache=0 hits=0
test: list=10,20,20,30 k_tail=3
expect: => i=50 r=0.0 ok=true s="suffix uniq sum: 50" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${k_tail};
	var start = g.n - span;
	if start < 0 { start = 0; }
	var uniq = [0; 512];
	var un = 0;
	var total = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in un { if uniq[j] == x { seen = true; break; } }
		if !seen {
			uniq[un] = x;
			un++;
			total += x;
		}
	}
	gold_clear(g);
	gold_push(g, total);
	out.i = total;
	out.s.clear();
	format(out.s, "suffix uniq sum: ", total);
	out
}
@end
