phrase: amplify streak sequence until hitting ceiling value {cap}
test: list=2,3,4,1,2 cap=20
expect: => i=6 r=0.0 ok=true s="streak product reached 6" errors=0 n=5 res=[2,6,4,1,2] cache=0 hits=0
test: list=2,2,5,3 cap=15
expect: => i=4 r=0.0 ok=true s="streak product reached 4" errors=0 n=4 res=[2,4,5,3] cache=0 hits=0
test: list=1,2 cap=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${cap} <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		return out;
	}
	var prod = 1;
	for i in g.n {
		if prod * g.res[i] <= ${cap} {
			prod *= g.res[i];
			g.res[i] = prod;
		} else {
			break;
		}
	}
	out.i = prod;
	out.s.clear();
	format(out.s, "streak product reached ", prod);
	out
}
@end
