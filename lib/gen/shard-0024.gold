expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: peak3 cone -5,0,0 -5,0,6 r3 m:matte #5a5046
expect: => doc: peak4 cone 0,0,0 0,0,6 r3.5 m:matte #5a5046
test: n=0 h=8.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var range_peak_buf byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${h} <= 0.0 { gold_fail(g, "mountain cluster bounds"); out.ok = false; return out; }
	for pk_idx in ${n} {
		let pk_x = (pk_idx as real) * 5.0 - 5.0;
		let pk_r = 3.0 + (pk_idx as real) * 0.5;
		range_peak_buf.clear();
		gold_dnews(g, "peak", "", range_peak_buf);
		range_peak_buf.append(" cone ");
		gold_fnum(range_peak_buf, pk_x);
		range_peak_buf.append(",0,");
		range_peak_buf.append("0 ");
		gold_fnum(range_peak_buf, pk_x);
		range_peak_buf.append(",0,");
		gold_fnum(range_peak_buf, ${h});
		range_peak_buf.append(" r");
		gold_fnum(range_peak_buf, pk_r);
		range_peak_buf.append(" m:matte ");
		gold_hex(range_peak_buf, 90, 80, 70);
		gold_doc(g, range_peak_buf);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "clustered mountains");
	out
}
@end
