fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_drop};
	var dropped = 0;
	while dropped < g.n && dropped < lim {
		if ${p}(g.res[dropped]) {
			dropped++;
		} else {
			break;
		}
	}
	var rem = g.n - dropped;
	for i in rem { g.res[i] = g.res[i + dropped]; }
	g.n = rem;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped match: ", dropped);
	out
}
@end
@entry dac360e3e9c0fbc0
kind: step
verb: find
noun: errors
modifier: nested
context: stats
phrase: find errors nested outside variance tolerance {tol}
phrase: detect nested outlier errors exceeding tolerance {tol}
slot: tol int
test: list=10,12,11,40 tol=10
expect: => i=1 r=0.0 ok=true s="outliers: 1" errors=0 n=4 res=[10,12,11,40] cache=0 hits=0
test: list=5,5,25 tol=5
expect: => i=3 r=0.0 ok=true s="outliers: 3" errors=0 n=3 res=[5,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${tol};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "errors: 0");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	var outliers = 0;
	for i in g.n {
		var diff = g.res[i] - mean;
		if diff < 0 { diff = -diff; }
		if diff > t { outliers++; }
	}
	out.i = outliers;
	out.s.clear();
	format(out.s, "outliers: ", outliers);
	out
}
@end
