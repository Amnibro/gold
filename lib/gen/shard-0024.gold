	let lo = ${low};
	let hi = ${high};
	var matched = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			matched[count] = x;
			count++;
		}
	}
	gold_clear(g);
	var i = count - 1;
	while i >= 0 {
		gold_push(g, matched[i]);
		i--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected: ", count);
	out
}
