@entry ce51ceaaa1e4f8ec
kind: step
verb: fill
noun: gaps
modifier: in_reverse
context: error
phrase: fill gaps in reverse order verifying maximum step {max_gap}
phrase: inspect backwards intervals filling gaps up to {max_gap}
slot: max_gap int
test: list=2,5,9 max_gap=5
expect: => i=7 r=0.0 ok=true s="reverse gaps filled: 7" errors=0 n=3 res=[2,5,9] cache=0 hits=0
test: list=1,10 max_gap=4
expect: => i=0 r=0.0 ok=false s="error: gap tolerance exceeded" errors=1 n=2 res=[1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "insufficient items for reverse gap check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var total_gap = 0;
	var i = g.n - 1;
	while i > 0 {
		let diff = g.res[i] - g.res[i - 1];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > mg {
			gold_fail(g, "gap exceeds tolerance limit");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: gap tolerance exceeded");
			return out;
		}
		total_gap += gap;
		i--;
	}
	out.i = total_gap;
	out.s.clear();
	format(out.s, "reverse gaps filled: ", total_gap);
	out
}
@end
