test: img=16 c=4
expect: => i=256 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.75 sum8=18336 hash=547421
test: img=32 c=8
expect: => i=1024 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.75 sum8=83488 hash=847673
test: c=4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	// texture step blend bricks dark
	if ${c} < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c} + y / ${c}) % 2) as real;
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.25); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
