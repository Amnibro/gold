modifier: glossy
context: scene
phrase: illuminate glossy door with wattage {w}
phrase: light door glossy intensity {w} watts
phrase: cast glossy light onto door power {w}
slot: w real
test: w=100.0 doc="ground box 0,0,-.5 20,20,1 m:matte"
expect: => i=2 r=0.0 ok=true s="ltdoor" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1 m:matte
expect: => doc: do_lt2 light point 0,0,2.5 w100 #ffeedd
test: w=250.0 doc="pillar cyl 0,0,0 0,0,4 r.3 m:ceramic"
expect: => i=2 r=0.0 ok=true s="ltdoor" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: pillar cyl 0,0,0 0,0,4 r.3 m:ceramic
expect: => doc: do_lt2 light point 0,0,2.5 w250 #ffeedd
test: w=-50.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_light_door_glossy_alpha = 0;
	let w = ${w};
	if w <= 0.0 { gold_fail(g, "invalid power"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "do_lt", "", o);
	o.append(" light point 0,0,");
	o.append("2.5 w");
	gold_fnum(o, w);
	o.append(" #ffeedd");
	gold_doc(g, o);
	out.i = g.dn + mark_light_door_glossy_alpha;
	out.s.clear();
	format(out.s, "ltdoor");
	out
}
@end
