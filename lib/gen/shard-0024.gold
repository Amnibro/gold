code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_min = g.res[0];
	var count = 0;
	g.res[count] = cur_min;
	count++;
	for i in g.n - 1 {
		let val = g.res[i + 1];
		if val < cur_min {
			cur_min = val;
			g.res[count] = cur_min;
			count++;
		}
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "unique min count: ", count);
	out
}
@end
