@entry a050fa4c3b70bb66
kind: step
verb: sort
noun: checkpoint
modifier: all
context: filter
phrase: sort checkpoint all active values order {ascending}
phrase: order checkpoint all active entries flag {ascending}
slot: ascending int
test: list=5,0,2,0,9,1 ascending=1
expect: => i=4 r=0.0 ok=true s="sorted active checkpoints: 4" errors=0 n=6 res=[1,0,2,0,5,9] cache=0 hits=0
test: list=8,0,3,0,12 ascending=0
expect: => i=3 r=0.0 ok=true s="sorted active checkpoints: 3" errors=0 n=5 res=[12,0,8,0,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let asc = ${ascending};
	var act = [0; 512];
	var an = 0;
	for i in g.n {
		if g.res[i] != 0 {
			act[an] = g.res[i];
			an++;
		}
	}
	var p = 0;
	while p < an {
		var q = 0;
		while q + 1 < an {
			var swap = false;
			if asc > 0 && act[q] > act[q + 1] { swap = true; }
			if asc <= 0 && act[q] < act[q + 1] { swap = true; }
			if swap {
				let t = act[q];
				act[q] = act[q + 1];
				act[q + 1] = t;
			}
			q++;
		}
		p++;
	}
	var k = 0;
	for i in g.n {
		if g.res[i] != 0 {
			g.res[i] = act[k];
			k++;
		}
	}
	g.steps += an;
	out.i = an;
	out.s.clear();
	format(out.s, "sorted active checkpoints: ", an);
	out
}
@end
