fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${filler};
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		buf[bn] = g.res[i];
		bn++;
		if i + 1 < g.n && g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 && bn < 512 {
			buf[bn] = fl;
			bn++;
		}
	}
	g.n = 0;
	for k in bn { gold_push(g, buf[k]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "joined evens size: ", bn);
	out
}
