	o.append(" b");
	gold_fnum(o, ${r} * 0.1);
	o.append(" m:metal");
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "stud", "", o);
	o.append(" cyl ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
