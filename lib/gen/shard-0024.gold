	var odds = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		let is_odd = if x < 0 { (-x) % 2 != 0 } else { x % 2 != 0 };
		if is_odd {
			if x > cap {
				gold_fail(g, "odd value exceeds allowed cap");
				out.ok = false;
				out.s.clear();
				format(out.s, "error: odd cap exceeded");
				return out;
			}
			odds++;
		}
		i--;
	}
	out.i = odds;
	out.s.clear();
	format(out.s, "reverse odds verified: ", odds);
	out
}
@end
@entry 9fdafe48450bf375
kind: step
verb: find
noun: gaps
modifier: with_cache
context: error
phrase: find gaps matching target {target_gap} with cache lookup
phrase: locate interval gaps equal to {target_gap} using memoized cache
slot: target_gap int
test: list=10,15,20 target_gap=5
expect: => i=5 r=0.0 ok=true s="found target gap: 5" errors=0 n=3 res=[10,15,20] cache=2 hits=0
test: list=10,12 target_gap=5
expect: => i=0 r=0.0 ok=false s="error: target gap missing" errors=1 n=2 res=[10,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_gap};
	if g.n < 2 {
		gold_fail(g, "insufficient elements for gap search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var found = false;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		gold_cache_put(g, i, gap);
		if gap == tgt {
			found = true;
		}
		i++;
	}
	if !found {
		gold_fail(g, "target gap not found in results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target gap missing");
		return out;
	}
	out.i = tgt;
	out.s.clear();
	format(out.s, "found target gap: ", tgt);
	out
}
@end
