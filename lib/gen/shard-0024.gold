code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_allowed};
	if out.i > 0 {
		g.errors += out.i;
	}
	var excess = 0;
	if g.errors > ma {
		excess = g.errors - ma;
	}
	g.steps += excess + 1;
	out.i = excess;
	out.s.clear();
	format(out.s, "running error excess: ", excess);
	out
}
@end
