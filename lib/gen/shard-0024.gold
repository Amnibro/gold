fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mapped = [0; 512];
	var mn = 0;
	var dup = false;
	for i in g.n {
		let y = ${f}(g.res[i]);
		for k in mn {
			if mapped[k] == y { dup = true; break; }
		}
		if dup { break; }
		mapped[mn] = y;
		mn++;
	}
	g.steps += mn;
	if dup {
		gold_fail(g, "subfunction produced duplicate output");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = mn;
	out.s.clear();
	format(out.s, "unique mappings count: ", mn);
	out
}
