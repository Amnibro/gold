@entry 3d76568ed50f45f3
kind: step
verb: apply
noun: streak
modifier: at_most
context: stats
phrase: apply streak length limit at most {cap} to samples
phrase: cap consecutive observation streak counts at most {cap}
slot: cap int
test: list=1,1,1,1,2,2,3,3,3,3,3 cap=2
expect: => i=6 r=0.0 ok=true s="streak capped: 6" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=5,5,5,7,7,8,8,8,8 cap=1
expect: => i=3 r=0.0 ok=true s="streak capped: 3" errors=0 n=3 res=[5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	if g.n == 0 || cp <= 0 { return out; }
	var kept = 0;
	var cur_run = 1;
	g.res[kept] = g.res[0];
	kept++;
	for i in g.n - 1 {
		let val = g.res[i + 1];
		if val == g.res[i] {
			cur_run++;
			if cur_run <= cp {
				g.res[kept] = val;
				kept++;
			}
		} else {
			cur_run = 1;
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "streak capped: ", kept);
	out
}
@end
