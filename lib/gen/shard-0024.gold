code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let delta = ${step_val};
	if g.n == 0 {
		gold_fail(g, "merge step last: empty list");
		out.ok = false;
		return out;
	}
	let last = g.n - 1;
	g.res[last] += delta;
	g.steps += 1;
	out.i = g.res[last];
	out.s.clear();
	format(out.s, "merged step into last element: ", g.res[last]);
	out
}
@end
@entry cf2516e53158bb43
kind: step
verb: pair
noun: minimum
modifier: unique
context: stats
phrase: pair minimum unique sum across list
phrase: identify unique minimum adjacent pair sum
test: list=10,5,20,3
expect: => i=15 r=0.0 ok=true s="minimum unique pair sum: 15" errors=0 n=5 res=[10,5,20,3,15] cache=0 hits=0
test: list=8,2,9
expect: => i=10 r=0.0 ok=true s="minimum unique pair sum: 10" errors=0 n=4 res=[8,2,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "pair minimum unique: insufficient pairs");
		out.ok = false;
		return out;
	}
	var min_pair = g.res[0] + g.res[1];
	var i = 2;
	while i < g.n {
		let p = g.res[i - 1] + g.res[i];
		if p < min_pair {
			min_pair = p;
		}
		i++;
	}
	gold_push(g, min_pair);
	g.steps += g.n;
	out.i = min_pair;
	out.s.clear();
	format(out.s, "minimum unique pair sum: ", min_pair);
	out
}
@end
