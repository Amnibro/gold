code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	var sq = [0; 512];
	var sn = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			sq[sn] = g.res[i];
			sn++;
		}
	}
	gold_clear(g);
	if sn > 0 {
		var eff = s % sn;
		if eff < 0 { eff += sn; }
		for i in sn {
			gold_push(g, sq[(i + eff) % sn]);
		}
	}
	g.steps += sn;
	out.i = sn;
	out.s.clear();
	format(out.s, "rotated square count: ", sn);
	out
}
@end
