expect: => i=2 r=0.0 ok=true s="history shifted: 2" errors=0 n=4 res=[15,25,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let dc = ${decay};
	if g.n == 0 || count <= 0 { return out; }
	var actual = count;
	if actual > g.n { actual = g.n; }
	let start = g.n - actual;
	for i in actual {
		g.res[start + i] -= dc;
	}
	out.i = actual;
	out.s.clear();
	format(out.s, "history shifted: ", actual);
	out
}
@end
