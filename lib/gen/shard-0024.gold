@entry 6ad6943869b90892
kind: step
verb: group
noun: item
modifier: between
context: loop
slot: lo int
slot: hi int
phrase: group item between bounds {lo} through {hi}
phrase: cluster items between range {lo} across {hi}
test: list=5,12,18,25,30 lo=10 hi=20
expect: => i=2 r=0.0 ok=true s="grouped items: 2" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=1,2,3,4 lo=2 hi=3
expect: => i=2 r=0.0 ok=true s="grouped items: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var matched = [0; 512];
	var mn = 0;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h {
			matched[mn] = g.res[i];
			mn++;
		}
	}
	gold_clear(g);
	for i in mn { gold_push(g, matched[i]); }
	out.i = mn;
	out.s.clear();
	format(out.s, "grouped items: ", mn);
	out
}
@end
