	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "shifted squares: 0");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	var total_var = 0;
	for i in g.n {
		let diff = g.res[i] - mean;
		let sq = diff * diff;
		g.res[i] = sq;
		total_var += sq;
	}
	out.i = total_var;
	out.s.clear();
	format(out.s, "variance sum: ", total_var);
	out
}
@end
@entry 0a9505426f66e7c4
kind: step
verb: apply
noun: maximum
modifier: any
context: stats
phrase: apply maximum any cap boundary {cap}
phrase: restrict sample values to maximum ceiling {cap}
slot: cap int
test: list=15,45,80,25 cap=40
expect: => i=2 r=0.0 ok=true s="capped: 2" errors=0 n=4 res=[15,40,40,25] cache=0 hits=0
test: list=5,12,9,30 cap=10
expect: => i=2 r=0.0 ok=true s="capped: 2" errors=0 n=4 res=[5,10,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var count = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "capped: ", count);
	out
}
@end
@entry 3059791ee378c12f
kind: step
verb: find
noun: suffix
modifier: any
context: stats
phrase: find suffix any values exceeding cutoff {cutoff}
phrase: locate suffix span containing values above {cutoff}
slot: cutoff int
test: list=5,12,30,40,50 cutoff=25
expect: => i=3 r=0.0 ok=true s="suffix len: 3" errors=0 n=5 res=[5,12,30,40,50] cache=0 hits=0
test: list=10,20,15,80 cutoff=50
expect: => i=1 r=0.0 ok=true s="suffix len: 1" errors=0 n=4 res=[10,20,15,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${cutoff};
	var start = g.n;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= thresh {
			start = i;
		} else {
			break;
		}
		i--;
	}
	let len = g.n - start;
	out.i = len;
	out.s.clear();
	format(out.s, "suffix len: ", len);
	out
}
@end
@entry f790847850363c6a
kind: step
verb: split
noun: values
modifier: nested
context: stats
phrase: split values nested around central pivot {mid}
phrase: partition sample values nested around {mid}
slot: mid int
test: list=12,4,18,7,25 mid=10
expect: => i=2 r=0.0 ok=true s="lower count: 2" errors=0 n=5 res=[4,7,12,18,25] cache=0 hits=0
test: list=50,15,30,80 mid=40
expect: => i=2 r=0.0 ok=true s="lower count: 2" errors=0 n=4 res=[15,30,50,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pivot = ${mid};
	var lo = [0; 512];
	var hi = [0; 512];
	var ln = 0;
	var hn = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= pivot {
			lo[ln] = x;
			ln++;
		} else {
			hi[hn] = x;
			hn++;
		}
	}
	gold_clear(g);
	for i in ln { gold_push(g, lo[i]); }
	for i in hn { gold_push(g, hi[i]); }
	out.i = ln;
	out.s.clear();
	format(out.s, "lower count: ", ln);
	out
}
@end
@entry bac682c7edb98831
kind: step
verb: shift
noun: checkpoint
modifier: sorted
context: stats
phrase: shift checkpoint sorted markers past {mark}
phrase: advance sorted sample values past checkpoint {mark}
slot: mark int
test: list=3,7,15,22 mark=10
expect: => i=2 r=0.0 ok=true s="checkpoint shift: 2" errors=0 n=4 res=[13,17,15,22] cache=0 hits=0
test: list=5,20,35,50 mark=25
expect: => i=2 r=0.0 ok=true s="checkpoint shift: 2" errors=0 n=4 res=[30,45,35,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${mark};
	var shifted = 0;
	for i in g.n {
		if g.res[i] < cp {
			g.res[i] += cp;
			shifted++;
		}
	}
	out.i = shifted;
	out.s.clear();
	format(out.s, "checkpoint shift: ", shifted);
	out
}
@end
