	var kept = 1;
	for i in 1..g.n {
		let gap = g.res[i] - g.res[kept - 1];
		let abs_gap = if gap < 0 { -gap } else { gap };
		if abs_gap > d {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "pairwise deduped count: ", kept);
	out
}
@end
@entry 93a48af447362993
kind: step
verb: sort
noun: steps
modifier: between
context: math
phrase: sort steps falling strictly between range limits {start_val} {end_val}
phrase: order intermediate values bounded between endpoints {start_val} {end_val}
slot: start_val int
slot: end_val int
test: list=10,8,2,6,4,12 start_val=3 end_val=9
expect: => i=3 r=0.0 ok=true s="steps sorted between: 3" errors=0 n=6 res=[10,4,2,6,8,12] cache=0 hits=0
test: list=20,15,5,12,18 start_val=10 end_val=19
expect: => i=3 r=0.0 ok=true s="steps sorted between: 3" errors=0 n=5 res=[20,12,5,15,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${start_val};
	let ev = ${end_val};
	var matched = [0; 512];
	var mn = 0;
	for i in g.n {
		if g.res[i] >= sv && g.res[i] <= ev {
			matched[mn] = g.res[i];
			mn++;
		}
	}
	for p in mn {
		for q in 0..(mn - 1) {
			if matched[q] > matched[q + 1] {
				let tmp = matched[q];
				matched[q] = matched[q + 1];
				matched[q + 1] = tmp;
			}
		}
	}
	var midx = 0;
	for i in g.n {
		if g.res[i] >= sv && g.res[i] <= ev {
			g.res[i] = matched[midx];
			midx++;
		}
	}
	out.i = mn;
	out.s.clear();
	format(out.s, "steps sorted between: ", mn);
	out
}
@end
@entry 45d15138c0bcc3c7
kind: step
verb: filter
noun: tail
modifier: running
context: math
phrase: filter tail section according to running total exceeding {threshold}
phrase: screen tail elements while running sum satisfies {threshold}
slot: threshold int
test: list=1,2,3,4,5 threshold=9
expect: => i=2 r=0.0 ok=true s="tail kept count: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
test: list=10,20,30 threshold=45
expect: => i=1 r=0.0 ok=true s="tail kept count: 1" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var run_sum = 0;
	var kept_idx = g.n;
	var i = g.n - 1;
	while i >= 0 {
		run_sum += g.res[i];
		if run_sum <= th {
			kept_idx = i;
		} else {
			break;
		}
		i--;
	}
	var kept = 0;
	for j in kept_idx..g.n {
		g.res[kept] = g.res[j];
		kept++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "tail kept count: ", kept);
	out
}
@end
@entry df50fd49663bbd65
kind: step
verb: fold
noun: minimum
modifier: in_reverse
context: math
phrase: fold running minimum backwards from base value {init}
phrase: accumulate minimum values in reverse starting from {init}
slot: init int
test: list=10,5,8,3 init=100
expect: => i=112 r=0.0 ok=true s="reverse min total: 112" errors=0 n=4 res=[10,5,8,3] cache=0 hits=0
test: list=4,2,6 init=50
expect: => i=60 r=0.0 ok=true s="reverse min total: 60" errors=0 n=3 res=[4,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${init};
	if g.n == 0 { return out; }
	var running_min = g.res[g.n - 1];
	var total = b;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] < running_min { running_min = g.res[i]; }
		total += running_min;
		i--;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "reverse min total: ", total);
	out
}
@end
