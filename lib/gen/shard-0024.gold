@entry 619c57fd7ed32499
kind: step
verb: limit
noun: runs
modifier: running
context: stats
phrase: limit runs running occurrences to {cap}
phrase: cap running duplicate runs to {cap}
slot: cap int
test: list=3,3,3,3,5,5,7 cap=2
expect: => i=5 r=0.0 ok=true s="runs limited: 5" errors=0 n=5 res=[3,3,5,5,7] cache=0 hits=0
test: list=1,1,1,2,2,2,2,3 cap=1
expect: => i=3 r=0.0 ok=true s="runs limited: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${cap};
	if g.n == 0 || max_run <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "runs limited: 0");
		return out;
	}
	var buf = [0; 512];
	var bn = 0;
	var cur_val = g.res[0];
	var cur_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x == cur_val {
			cur_cnt++;
		} else {
			cur_val = x;
			cur_cnt = 1;
		}
		if cur_cnt <= max_run {
			buf[bn] = x;
			bn++;
		}
	}
	gold_clear(g);
	for i in bn { gold_push(g, buf[i]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "runs limited: ", bn);
	out
}
@end
@entry 20c7e39315d4d86b
kind: step
verb: cache
noun: streak
modifier: between
context: stats
phrase: cache streak between duration bounds {min_len} {max_len}
phrase: record consecutive run streaks between {min_len} {max_len}
slot: min_len int
slot: max_len int
test: list=2,2,2,3,4,4 min_len=2 max_len=3
expect: => i=2 r=0.0 ok=true s="streaks cached: 2" errors=0 n=6 res=[2,2,2,3,4,4] cache=2 hits=0
test: list=5,5,5,5,6,6 min_len=2 max_len=2
expect: => i=1 r=0.0 ok=true s="streaks cached: 1" errors=0 n=6 res=[5,5,5,5,6,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_len};
	let hi = ${max_len};
	var streaks = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run = 1;
		while i + run < g.n && g.res[i + run] == val { run++; }
		if run >= lo && run <= hi {
			gold_cache_put(g, streaks, val);
			streaks++;
		}
		i += run;
	}
	out.i = streaks;
	out.s.clear();
	format(out.s, "streaks cached: ", streaks);
	out
}
@end
