@entry 81d98f495d94568b
kind: step
verb: filter
noun: tail
modifier: with_cache
context: math
phrase: filter tail values caching recurring remainder outputs {count}
phrase: screen tail elements through cache verification taking {count}
slot: count int
test: list=1,2,3,4,5,6 count=4
expect: => i=3 r=0.0 ok=true s="tail cached kept: 3" errors=0 n=3 res=[3,4,5] cache=4 hits=0
test: list=10,12,15 count=2
expect: => i=2 r=0.0 ok=true s="tail cached kept: 2" errors=0 n=2 res=[12,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var start = if g.n > k { g.n - k } else { 0 };
	var kept = 0;
	for i in start..g.n {
		let x = g.res[i];
		let cached, hit = gold_cache_get(g, x);
		var score = cached;
		if !hit {
			score = (x * x) % 17;
			gold_cache_put(g, x, score);
		}
		if score > 2 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "tail cached kept: ", kept);
	out
}
@end
