@entry 1045a9801057b286
kind: step
verb: select
noun: histogram
modifier: with_retry
context: aggregate
phrase: select histogram with retry frequency match {target_freq}
phrase: filter histogram with retry occurrence target {target_freq}
slot: target_freq int
test: list=1,2,2,3,3,3 target_freq=2
expect: => i=1 r=0.0 ok=true s="frequency matches: 1" errors=0 n=1 res=[2] cache=0 hits=0
test: list=4,4,5,6,6 target_freq=1
expect: => i=1 r=0.0 ok=true s="frequency matches: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tf = ${target_freq};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		var c = 0;
		for j in g.n {
			if g.res[j] == x { c++; }
		}
		if c == tf {
			var seen = false;
			for k in kn {
				if kept[k] == x { seen = true; break; }
			}
			if !seen {
				kept[kn] = x;
				kn++;
			}
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "frequency matches: ", kn);
	out
}
@end
