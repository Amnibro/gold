fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_lim = ${gap};
	var matched = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= g_lim { matched++; }
		i++;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "steps matched: ", matched);
	out
}
@end
