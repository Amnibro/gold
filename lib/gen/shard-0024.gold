fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${pitch} <= 0.0 || ${pitch} > 60.0 { gold_fail(g, "pitch invalid"); out.ok = false; return out; }
	var obuf byte[>..] = [];
	var last_ref byte[>..] = [];
	if !gold_dlast(g, last_ref) { out.ok = false; return out; }
	obuf.append(last_ref);
	obuf.append(".rot anim ");
	obuf.append("0");
	obuf.append(":");
	obuf.append("0");
	obuf.append(",");
	obuf.append("0");
	obuf.append(",");
	obuf.append("0");
	obuf.append(" ");
	obuf.append("1");
	obuf.append(":");
