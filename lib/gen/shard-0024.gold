fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var shifted = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			g.res[i] += off;
			shifted++;
		}
	}
	out.i = shifted;
	out.s.clear();
	format(out.s, "primes shifted: ", shifted);
	out
}
@end
