fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	if b < 2 {
		gold_fail(g, "base must be at least 2");
		out.ok = false;
		return out;
	}
	gold_clear(g);
	var x = out.i;
	if x < 0 { x = -x; }
	var k = 0;
	while x > 0 {
		let d = x % b;
		gold_push(g, d);
		x /= b;
		k++;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "extracted digits count: ", k);
	out
}
@end
