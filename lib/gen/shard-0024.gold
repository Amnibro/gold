fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0_0 = 8;
	for o in 3 { if !gold_img_square(g, c0_0) { out.ok = false; return out; } c0_0 = c0_0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 3 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.15 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (5 as real)) as! int;
		if t > 5 - 1 { t = 5 - 1; }
		g.img[k] = (t as real) / ((5 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
