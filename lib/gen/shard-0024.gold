fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${multiplier} <= 0 {
		gold_fail(g, "multiplier must be positive");
		out.ok = false;
		return out;
	}
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1] * ${multiplier};
	for i in g.n - 1 {
		g.res[i] += last_val;
	}
	out.i = last_val;
	out.s.clear();
	format(out.s, "paired items with scaled last");
	out
}
