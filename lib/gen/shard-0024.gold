@entry 011d9905468f5f65
kind: step
verb: merge
noun: odds
modifier: in_reverse
context: list
phrase: merge odds in reverse order across list
phrase: collect odd numbers in reverse into list
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="merged reverse odds: 3" errors=0 n=8 res=[1,2,3,4,5,5,3,1] cache=0 hits=0
test: list=2,7,8,11
expect: => i=2 r=0.0 ok=true s="merged reverse odds: 2" errors=0 n=6 res=[2,7,8,11,11,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var count = 0;
	var i = n;
	while i > 0 {
		i--;
		let val = g.res[i];
		let is_odd = if val < 0 { (-val) % 2 == 1 } else { val % 2 == 1 };
		if is_odd {
			gold_push(g, val);
			count++;
		}
	}
	g.steps += n;
	out.i = count;
	out.s.clear();
	format(out.s, "merged reverse odds: ", count);
	out
}
@end
@entry 5c70d2efdaec012d
kind: step
verb: scan
noun: number
modifier: pairwise
context: list
phrase: scan number pairwise differences in list
phrase: evaluate numbers pairwise across elements
test: list=10,15,12,20
expect: => i=3 r=0.0 ok=true s="pairwise scans completed: 3" errors=0 n=7 res=[10,15,12,20,5,3,8] cache=0 hits=0
test: list=3,9
expect: => i=1 r=0.0 ok=true s="pairwise scans completed: 1" errors=0 n=3 res=[3,9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	if n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "pairwise scans completed: 0");
		return out;
	}
	var pairs = 0;
	var i = 1;
	while i < n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		gold_push(g, abs_diff);
		pairs++;
		i++;
	}
	g.steps += n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise scans completed: ", pairs);
	out
}
@end
@entry b8356edc38501532
kind: step
verb: count
noun: streak
modifier: between
context: list
slot: low int
slot: high int
phrase: count streak between limits {low} to {high}
phrase: measure longest streak between bounds {low} through {high}
test: list=2,5,7,8,1,9 low=4 high=8
expect: => i=3 r=0.0 ok=true s="longest streak between limits: 3" errors=0 n=6 res=[2,5,7,8,1,9] cache=0 hits=0
test: list=10,20,30,40 low=15 high=25
expect: => i=1 r=0.0 ok=true s="longest streak between limits: 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_streak = 0;
	var cur_streak = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 0;
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak between limits: ", max_streak);
	out
}
@end
@entry 6da506e0c0d01630
kind: step
verb: pair
noun: tally
modifier: times
context: list
slot: multiplier int
phrase: pair tally times factor {multiplier} across list
phrase: compute adjacent pair tally times {multiplier}
test: list=3,3,5,5,5 multiplier=4
expect: => i=12 r=0.0 ok=true s="pair tally times factor: 12" errors=0 n=6 res=[3,3,5,5,5,12] cache=0 hits=0
test: list=1,2,2,3 multiplier=10
expect: => i=10 r=0.0 ok=true s="pair tally times factor: 10" errors=0 n=5 res=[1,2,2,3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var tally = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			tally++;
		}
		i++;
	}
	let result = tally * m;
	gold_push(g, result);
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "pair tally times factor: ", result);
	out
}
