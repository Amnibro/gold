@entry 1ee0197a3ed2e306
kind: step
verb: repeat
noun: duplicates
modifier: recursively
context: math
phrase: repeat duplicate items recursively to expansion depth {depth}
phrase: replicate duplicate entries across recursive levels {depth}
slot: depth int
test: list=1,2,2,3 depth=2
expect: => i=2 r=0.0 ok=true s="recursively added: 2" errors=0 n=6 res=[1,2,2,3,2,2] cache=0 hits=0
test: list=5,5,6 depth=1
expect: => i=1 r=0.0 ok=true s="recursively added: 1" errors=0 n=4 res=[5,5,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var dup_vals = [0; 512];
	var dn = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq > 1 {
			var already = false;
			for k in dn {
				if dup_vals[k] == g.res[i] { already = true; break; }
			}
			if !already {
				dup_vals[dn] = g.res[i];
				dn++;
			}
		}
	}
	var added = 0;
	for k in dn {
		for rep in d {
			if g.n < 512 {
				g.res[g.n] = dup_vals[k];
				g.n++;
				added++;
			}
		}
	}
	out.i = added;
	out.s.clear();
	format(out.s, "recursively added: ", added);
	out
}
@end
