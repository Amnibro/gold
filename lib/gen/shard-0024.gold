code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${pivot} <= 0 {
		gold_fail(g, "pivot must be positive");
		out.ok = false;
		return out;
	}
	var buf int[512] = [0; 512];
	var k = 0;
	for i in g.n { if g.res[i] < ${pivot} { buf[k] = g.res[i]; k++; } }
	let low_cnt = k;
	for i in g.n { if g.res[i] >= ${pivot} { buf[k] = g.res[i]; k++; } }
	for i in g.n { g.res[i] = buf[i]; }
	out.i = low_cnt;
	out.s.clear();
	format(out.s, "partitioned with ", low_cnt, " low items");
	out
}
@end
@entry 6cf8819fb77c1b94
kind: step
verb: drop
noun: results
modifier: pairwise
context: aggregate
slot: min_diff int
phrase: drop results pairwise removing elements with difference under {min_diff}
phrase: cull adjacent pairs differing by less than {min_diff}
test: list=10,12,20,35,36 min_diff=3
expect: => i=2 r=0.0 ok=true s="preserved 2 pairwise items" errors=0 n=2 res=[20,35] cache=0 hits=0
test: list=5,6,10,11,15 min_diff=2
expect: => i=0 r=0.0 ok=true s="preserved 0 pairwise items" errors=0 n=0 res=[] cache=0 hits=0
test: list=10,20,30 min_diff=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min_diff} <= 0 {
		gold_fail(g, "min_diff must be positive");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= ${min_diff} {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
		}
		i += 2;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "preserved ", kept, " pairwise items");
	out
}
@end
