fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 1 || ${n} > 8 {
		gold_fail(g, "even hole pattern count out of bounds");
		out.ok = false;
		return out;
	}
	var elin byte[>..] = [];
	gold_dnews(g, "hole_even", "", elin);
	elin.append(" cyl 0,0,-");
	elin.append("0.0");
	elin.append("4 0,");
	elin.append("0,0.");
	elin.append("04 r");
	elin.append("0.0");
	elin.append("07 - a");
	format(elin, ${n});
	elin.append(":0.");
	elin.append("03");
	elin.append("5,0,");
	elin.append("0");
	gold_doc(g, elin);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "hole_even");
	out
}
@end
