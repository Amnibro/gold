fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var paired = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] >= mv && g.res[i + 1] >= mv {
			paired[pn] = g.res[i];
			pn++;
			paired[pn] = g.res[i + 1];
			pn++;
		}
		i++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, paired[k]); }
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "paired items count: ", pn);
	out
}
@end
