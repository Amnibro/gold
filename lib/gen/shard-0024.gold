@entry afb9ac1daf3e517c
kind: step
verb: filter
noun: text
modifier: any
context: filter
phrase: filter text any occurrences matching code {target}
phrase: strip text any characters matching byte {target}
slot: target int
test: text="banana" target=97
expect: => i=3 r=0.0 ok=true s="bnn" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" target=108
expect: => i=3 r=0.0 ok=true s="heo" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var kept byte[..200] = "";
	for b in out.s {
		if (b as int) != t {
			kept.push(b);
		}
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len + 1;
	out
}
@end
@entry 10a1f81ffac35558
kind: step
verb: validate
noun: head
modifier: first
context: filter
phrase: validate head first value equals {expected}
phrase: verify head first item against target {expected}
slot: expected int
test: list=42,10,20 expected=42
expect: => i=42 r=0.0 ok=true s="head check: 42" errors=0 n=3 res=[42,10,20] cache=0 hits=0
test: list=7,14,21 expected=99
expect: => i=7 r=0.0 ok=false s="head check: 7" errors=1 n=3 res=[7,14,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	if g.n == 0 {
		gold_fail(g, "head empty list");
		out.ok = false;
		return out;
	}
	g.steps++;
	if g.res[0] != exp {
		gold_fail(g, "head mismatch error");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "head check: ", out.i);
	out
}
@end
@entry 643d19dbef197062
kind: step
verb: join
noun: evens
modifier: up_to
context: filter
phrase: join evens up to item limit {limit}
phrase: collect evens up to maximum count {limit}
slot: limit int
test: list=2,5,4,7,6,9 limit=2
expect: => i=6 r=0.0 ok=true s="2,4" errors=0 n=6 res=[2,5,4,7,6,9] cache=0 hits=0
test: list=10,12,14,16 limit=3
expect: => i=36 r=0.0 ok=true s="10,12,14" errors=0 n=4 res=[10,12,14,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	out.s.clear();
	var count = 0;
	var sum = 0;
	for i in g.n {
		if count >= lim { break; }
		if g.res[i] % 2 == 0 {
			if count > 0 { out.s.push(','); }
			format(out.s, g.res[i]);
			sum += g.res[i];
			count++;
		}
	}
	g.steps += count;
	out.i = sum;
	out
}
@end
@entry f26be8b7a241fdfc
kind: step
verb: fold
noun: digits
modifier: safely
context: filter
phrase: fold digits safely using modulo {radix}
phrase: reduce digits safely scaled by {radix}
slot: radix int
test: input=12345 radix=10
expect: => i=54321 r=0.0 ok=true s="folded digits: 54321" errors=0 n=0 res=[] cache=0 hits=0
test: input=9876 radix=7
expect: => i=2466 r=0.0 ok=true s="folded digits: 2466" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radix};
	if r <= 0 {
		gold_fail(g, "radix must be positive");
		out.ok = false;
		return out;
	}
	var acc = 0;
	var x = out.i;
	if x < 0 { x = -x; }
	var k = 0;
	while x > 0 {
		acc = (acc * r + x % 10) % 1000003;
		x /= 10;
		k++;
	}
	g.steps += k;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded digits: ", acc);
	out
}
@end
@entry 73f18b2f79dc78fd
kind: step
verb: dedupe
noun: evens
modifier: unique
context: filter
phrase: dedupe evens unique elements under ceiling {max_val}
phrase: filter evens unique items below cap {max_val}
slot: max_val int
test: list=2,4,2,6,4,8 max_val=6
expect: => i=3 r=0.0 ok=true s="unique evens count: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=10,12,10,14 max_val=12
expect: => i=2 r=0.0 ok=true s="unique evens count: 2" errors=0 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x <= mv {
			var seen = false;
			for k in kn {
				if kept[k] == x { seen = true; break; }
			}
			if !seen {
				kept[kn] = x;
				kn++;
			}
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "unique evens count: ", kn);
	out
}
@end
