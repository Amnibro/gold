expect: => i=4 r=0.0 ok=true s="data" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var delim = ';' as byte;
	if ${stop_char}.len > 0 {
		delim = ${stop_char}[0];
	}
	var buf: byte[..200] = "";
	for b in out.s {
		if b == delim {
			break;
		}
		buf.push(b);
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
