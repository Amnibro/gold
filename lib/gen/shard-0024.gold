@entry a0ea925baad4f1e0
kind: step
verb: map
noun: duplicates
modifier: recursively
context: aggregate
phrase: map duplicates recursively scaling factor {factor}
phrase: transform duplicates recursively rate {factor}
slot: factor int
test: list=1,2,2,3,3,3 factor=2
expect: => i=3 r=0.0 ok=true s="mapped duplicate entries: 3" errors=0 n=6 res=[1,4,2,6,6,3] cache=0 hits=0
test: list=4,4,5,5 factor=3
expect: => i=2 r=0.0 ok=true s="mapped duplicate entries: 2" errors=0 n=4 res=[12,4,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var mapped = 0;
	var i = 0;
	while i < g.n {
		var is_dup = false;
		for j in g.n {
			if i != j && g.res[i] == g.res[j] { is_dup = true; break; }
		}
		if is_dup {
			g.res[i] *= f;
			mapped++;
		}
		i++;
	}
	g.steps += mapped;
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped duplicate entries: ", mapped);
	out
}
@end
