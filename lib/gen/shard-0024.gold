fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	var deviations = 0;
	for i in g.n {
		let diff = g.res[i] - base;
		if diff < 0 {
			deviations += -diff;
		} else {
			deviations += diff;
		}
	}
	g.steps += g.n;
	out.i = deviations;
	out.s.clear();
	format(out.s, "total deviation: ", deviations);
	out
}
@end
