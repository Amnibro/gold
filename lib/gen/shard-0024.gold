phrase: scan digits any match containing value {digit}
slot: digit int
test: list=12,34,56,47 digit=4
expect: => i=1 r=0.0 ok=true s="digit found at index: 1" errors=0 n=4 res=[12,34,56,47] cache=0 hits=0
test: list=10,20,30 digit=5
expect: => i=-1 r=0.0 ok=true s="digit not found" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${digit};
	var found_idx = -1;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var has_digit = false;
		while x > 0 {
			if x % 10 == d { has_digit = true; break; }
			x /= 10;
		}
		if has_digit {
			found_idx = i;
			break;
		}
	}
	g.steps += 1;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "digit found at index: ", found_idx);
	} else {
		format(out.s, "digit not found");
	}
	out
}
@end
