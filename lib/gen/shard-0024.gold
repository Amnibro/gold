fn ${ID}(g Gold&, v Val) Val {
	var res_weather_bricks_layered = v;
	if !gold_img_ok(g) { res_weather_bricks_layered.ok = false; return res_weather_bricks_layered; }
	var c0_weather_bricks_layered = 8;
	for o_weather_bricks_layered in 2 { if !gold_img_square(g, c0_weather_bricks_layered) { res_weather_bricks_layered.ok = false; return res_weather_bricks_layered; } c0_weather_bricks_layered = c0_weather_bricks_layered / 2; }
	for y_weather_bricks_layered in g.ih {
		for x_weather_bricks_layered in g.iw {
			var t_weather_bricks_layered = 0.0;
			var amp_weather_bricks_layered = 1.0;
			var norm_weather_bricks_layered = 0.0;
			var cc_weather_bricks_layered = 8;
			for o_weather_bricks_layered in 2 { t_weather_bricks_layered += amp_weather_bricks_layered * gold_vnoise(x_weather_bricks_layered, y_weather_bricks_layered, cc_weather_bricks_layered, g.iw / cc_weather_bricks_layered, ${u} + o_weather_bricks_layered); norm_weather_bricks_layered += amp_weather_bricks_layered; amp_weather_bricks_layered *= 0.5; cc_weather_bricks_layered = cc_weather_bricks_layered / 2; }
			g.img[y_weather_bricks_layered * g.iw + x_weather_bricks_layered] = t_weather_bricks_layered / norm_weather_bricks_layered;
		}
	}
	var s_weather_bricks_layered = g.img;
	for y_weather_bricks_layered in g.ih {
		for x_weather_bricks_layered in g.iw {
			var t_weather_bricks_layered = 0.0;
			for dy_weather_bricks_layered in 3 { for dx_weather_bricks_layered in 3 { t_weather_bricks_layered += gold_img_wrap(g, x_weather_bricks_layered + dx_weather_bricks_layered - 1, y_weather_bricks_layered + dy_weather_bricks_layered - 1); } }
			s_weather_bricks_layered[y_weather_bricks_layered * g.iw + x_weather_bricks_layered] = t_weather_bricks_layered / 9.0;
		}
	}
	g.img = s_weather_bricks_layered;
	res_weather_bricks_layered.i = g.iw * g.ih;
	res_weather_bricks_layered.s.clear();
	format(res_weather_bricks_layered.s, "bricks");
	res_weather_bricks_layered
}
@end
