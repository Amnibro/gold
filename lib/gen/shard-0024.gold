@entry 7fede114ee9aec5e
kind: step
verb: retry
noun: gaps
modifier: times
context: aggregate
phrase: retry gaps times repetition count {rounds}
phrase: replicate gaps times cycle rounds {rounds}
slot: rounds int
test: list=1,4,10 rounds=2
expect: => i=4 r=0.0 ok=true s="retried gap elements: 4" errors=0 n=4 res=[3,6,3,6] cache=0 hits=0
test: list=5,15,30 rounds=1
expect: => i=2 r=0.0 ok=true s="retried gap elements: 2" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var gaps = [0; 512];
	var gn = 0;
	var i = 0;
	while i + 1 < g.n {
		gaps[gn] = g.res[i + 1] - g.res[i];
		gn++;
		i++;
	}
	gold_clear(g);
	for round in r {
		for k in gn { gold_push(g, gaps[k]); }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retried gap elements: ", g.n);
	out
}
@end
