fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var dups = 0;
	var i = n;
	while i > 0 {
		i--;
		let val = g.res[i];
		var found_earlier = false;
		var j = 0;
		while j < i {
			if g.res[j] == val {
				found_earlier = true;
			}
			j++;
		}
		if found_earlier {
			gold_push(g, val);
			dups++;
		}
	}
	g.steps += n;
	out.i = dups;
	out.s.clear();
	format(out.s, "selected duplicates in reverse: ", dups);
