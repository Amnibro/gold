expect: => i=5 r=0.0 ok=true s="counter match: 5" errors=0 n=4 res=[5,5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var found_val = -1;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let cnt = j - i;
		if cnt >= mc {
			found_val = g.res[i];
			break;
		}
		i = j;
	}
	out.i = found_val;
	out.ok = found_val >= 0;
	out.s.clear();
	format(out.s, "counter match: ", found_val);
	out
}
@end
