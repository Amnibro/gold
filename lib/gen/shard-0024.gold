noun: digits
modifier: at_least
context: stats
slot: min_digits int
phrase: map digits at least length {min_digits}
phrase: filter numbers with at least {min_digits} digits
test: list=5,12,350,9 min_digits=2
expect: => i=2 r=0.0 ok=true s="numbers with at least min digits: 2" errors=0 n=4 res=[5,12,350,9] cache=0 hits=0
test: list=4,8,7 min_digits=2
expect: => i=0 r=0.0 ok=true s="numbers with at least min digits: 0" errors=0 n=3 res=[4,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_digits};
	var matched = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 {
			digits = 1;
		} else {
			while x > 0 {
				digits++;
				x /= 10;
			}
		}
		if digits >= req {
			matched++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "numbers with at least min digits: ", matched);
	out
}
@end
