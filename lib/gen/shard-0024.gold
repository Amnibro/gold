kind: step
verb: fold
noun: values
modifier: nested
context: retry
phrase: fold values nested chunk size {chunk_size}
phrase: collapse values nested partition size {chunk_size}
slot: chunk_size int
test: list=1,2,3,4,5,6 chunk_size=3
expect: => i=2 r=0.0 ok=true s="folded chunk count: 2" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 chunk_size=2
expect: => i=2 r=0.0 ok=true s="folded chunk count: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${chunk_size};
	if cs <= 0 {
		gold_fail(g, "invalid chunk size");
		out.ok = false;
		return out;
	}
	var folded = [0; 512];
	var fn_cnt = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var k = 0;
		while k < cs && i + k < g.n {
			sum += g.res[i + k];
			k++;
		}
		folded[fn_cnt] = sum;
		fn_cnt++;
		i += cs;
	}
	gold_clear(g);
	for k in fn_cnt { gold_push(g, folded[k]); }
	out.i = fn_cnt;
	out.s.clear();
	format(out.s, "folded chunk count: ", fn_cnt);
	out
}
@end
