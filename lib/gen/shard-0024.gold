test: list=2,15,20 lo=5 hi=25
expect: => i=5 r=0.0 ok=true s="adjusted minimum to 5" errors=0 n=3 res=[5,15,20] cache=0 hits=0
test: list=1,8,12 lo=4 hi=10
expect: => i=4 r=0.0 ok=true s="adjusted minimum to 4" errors=0 n=3 res=[4,8,12] cache=0 hits=0
test: list=1,2 lo=10 hi=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${lo} >= ${hi} {
		gold_fail(g, "lo must be less than hi");
		out.ok = false;
		return out;
	}
	if g.n == 0 { return out; }
	var min_idx = 0;
	for i in g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	if g.res[min_idx] < ${lo} {
		g.res[min_idx] = ${lo};
	} else if g.res[min_idx] > ${hi} {
		g.res[min_idx] = ${hi};
	}
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "adjusted minimum to ", g.res[min_idx]);
	out
}
@end
