fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var passes = 0;
	var sorted = false;
	while passes < att && !sorted {
		sorted = true;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
		}
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	if sorted {
		format(out.s, "sorted successfully in passes: ", passes);
	} else {
		format(out.s, "sorting incomplete passes: ", passes);
	}
	out
}
