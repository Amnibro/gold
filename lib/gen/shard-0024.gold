kind: step
verb: compare
noun: gaps
modifier: all
context: list
slot: limit int
phrase: compare gaps all pairs against limit {limit} in list
phrase: verify whether all intervals stay below ceiling {limit} across list
test: list=2,5,9,12 limit=5
expect: => i=4 r=0.0 ok=true s="max gap: 4" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
test: list=1,10,12 limit=4
expect: => i=9 r=0.0 ok=false s="max gap: 9" errors=0 n=3 res=[1,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_comp_gaps_all_b334 = 0;
	let lim = ${limit};
	if g.n < 2 { out.ok = true; out.i = 0; return out; }
	var max_gap = 0;
	var ok = true;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > max_gap { max_gap = diff; }
		if diff > lim { ok = false; }
	}
	g.steps += g.n + mark_comp_gaps_all_b334;
	out.ok = ok;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap: ", max_gap);
	out
}
@end
