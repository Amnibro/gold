test: arg=14,205,30 bound=2
expect: 42
expect: 522
expect: 23
test: arg=5,810 bound=4
expect: 5
expect: 448
code:
fn ${ID}(n int) int {
	let b = ${bound};
	var x = abs(n);
	if x == 0 { if 0 < b { return b; } return 0; }
	var res = 0;
	while x > 0 {
		var d = x % 10;
		if d < b { d = b; }
		res = res * 10 + d;
		x /= 10;
	}
	res
}
@end
