fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${window} <= 0 {
		gold_fail(g, "window must be positive");
		out.ok = false;
		return out;
	}
	let w = if ${window} > g.n { g.n } else { ${window} };
	var s = 0;
	var i = g.n - w;
	while i < g.n {
		s += g.res[i];
		i++;
	}
	out.i = s;
	out.s.clear();
	format(out.s, "total of last ", w, " items is ", s);
	out
}
