expect: => i=2 r=0.0 ok=true s="nested duplicates measured count: 2" errors=0 n=5 res=[4,7,4,9,7] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="nested duplicates measured count: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				dups++;
				break;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "nested duplicates measured count: ", dups);
	out
}
@end
