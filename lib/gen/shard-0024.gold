@entry 4afdf04036d6ebda
kind: step
verb: dedupe
noun: head
modifier: in_place
context: math
phrase: dedupe head section in place across initial span {span}
phrase: remove repeated values within head window {span}
slot: span int
test: list=1,1,2,2,3,4,4 span=4
expect: => i=5 r=0.0 ok=true s="head deduped: 5" errors=0 n=5 res=[1,2,3,4,4] cache=0 hits=0
test: list=5,5,5,8,9 span=3
expect: => i=3 r=0.0 ok=true s="head deduped: 3" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let limit = if sp < g.n { sp } else { g.n };
	var kept = 0;
	for i in limit {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	for i in limit..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "head deduped: ", kept);
	out
}
@end
