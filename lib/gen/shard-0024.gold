code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${span} <= 0 {
		gold_fail(g, "span must be positive");
		out.ok = false;
		return out;
	}
	let w = if ${span} > g.n { g.n } else { ${span} };
	var unique = 0;
	let start = g.n - w;
	for i in w {
		var is_first = true;
		for j in i {
			if g.res[start + i] == g.res[start + j] {
				is_first = false;
				break;
			}
		}
		if is_first { unique++; }
	}
	out.i = unique;
	out.s.clear();
	format(out.s, "found ", unique, " unique trailing items");
	out
}
@end
@entry 7e5840d230b41371
kind: step
verb: measure
noun: range
modifier: times
context: aggregate
slot: window int
phrase: measure min max spread across window span {window}
phrase: calculate range difference across rolling window of {window}
test: list=10,30,5,40,15 window=3
expect: => i=3 r=0.0 ok=true s="measured 3 range spreads" errors=0 n=3 res=[25,35,35] cache=0 hits=0
test: list=2,8,20,4 window=2
expect: => i=3 r=0.0 ok=true s="measured 3 range spreads" errors=0 n=3 res=[6,12,16] cache=0 hits=0
test: list=1,2 window=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${window} <= 1 {
		gold_fail(g, "window must be at least two");
		out.ok = false;
		return out;
	}
	var j = 0;
	var i = 0;
	while i + ${window} <= g.n {
		var mn = g.res[i];
		var mx = g.res[i];
		for k in ${window} {
			let x = g.res[i + k];
			if x < mn { mn = x; }
			if x > mx { mx = x; }
		}
		g.res[j] = mx - mn;
		j++;
		i++;
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "measured ", j, " range spreads");
	out
}
@end
