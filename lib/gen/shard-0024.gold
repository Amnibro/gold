	let cnt = ${count};
	var c = 0;
	while c < cnt {
		for i in g.n {
			g.res[i] = ${f}(g.res[i]);
		}
		c++;
	}
	g.steps += cnt * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "function applied rounds: ", cnt);
	out
}
@end
