@entry 6583edc89a3ca1df
kind: step
verb: collect
noun: number
modifier: while
context: loop
slot: ceiling int
phrase: collect number while running sum under {ceiling}
phrase: accumulate numbers while sum below {ceiling}
test: list=5,10,15,20 ceiling=25
expect: => i=15 r=0.0 ok=true s="collected sum: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,4,6,8 ceiling=10
expect: => i=6 r=0.0 ok=true s="collected sum: 6" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var sum = 0;
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if sum + g.res[i] <= ceil {
			sum += g.res[i];
			kept[kn] = g.res[i];
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = sum;
	out.s.clear();
	format(out.s, "collected sum: ", sum);
	out
}
@end
