fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${stop_val} < 0 {
		gold_fail(g, "stop value must be non negative");
		out.ok = false;
		return out;
	}
	var idx = -1;
	for i in g.n {
		if g.res[i] == ${stop_val} {
			idx = i;
			break;
		}
	}
	let end = if idx >= 0 { idx } else { g.n };
	var left = 0;
	var right = end - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = end;
	out.s.clear();
	format(out.s, "reversed ", end, " items");
	out
}
@end
