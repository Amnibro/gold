fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for k in r {
		gold_push(g, avg);
	}
	g.steps += r;
	out.i = avg;
	out.s.clear();
	format(out.s, "appended average: ", avg);
	out
}
