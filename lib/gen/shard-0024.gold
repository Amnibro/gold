@entry 86b227cea4ce429b
kind: step
verb: scale
noun: duplicates
modifier: recursively
context: list
phrase: scale duplicates recursively factor {factor} rounds {rounds}
phrase: multiply duplicates recursively factor {factor} passes {rounds}
slot: factor int
slot: rounds int
test: list=2,2,3,4,4,4 factor=2 rounds=2
expect: => i=6 r=0.0 ok=true s="duplicate items scaled: 6" errors=0 n=6 res=[4,2,3,16,16,8] cache=0 hits=0
test: list=5,5,6 factor=3 rounds=1
expect: => i=1 r=0.0 ok=true s="duplicate items scaled: 1" errors=0 n=3 res=[15,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let rnds = ${rounds};
	var total_scaled = 0;
	var r = 0;
	while r < rnds {
		for i in g.n {
			var dup = false;
			var j = 0;
			while j < g.n {
				if i != j && g.res[i] == g.res[j] {
					dup = true;
					break;
				}
				j++;
			}
			if dup {
				g.res[i] *= f;
				total_scaled++;
			}
		}
		r++;
	}
	g.steps += total_scaled;
	out.i = total_scaled;
	out.s.clear();
	format(out.s, "duplicate items scaled: ", total_scaled);
	out
}
@end
