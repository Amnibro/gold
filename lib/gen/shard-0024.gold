phrase: map sequence deltas until accumulated total reaches {limit}
phrase: transform sequential differences until hitting limit {limit}
test: list=2,5,10,20,35 limit=15
expect: => i=8 r=0.0 ok=true s="mapped sequence total 8" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=1,3,7,15 limit=10
expect: => i=6 r=0.0 ok=true s="mapped sequence total 6" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20 limit=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${limit} <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		return out;
	}
	var acc = 0;
	var j = 0;
	var i = 0;
	while i + 1 < g.n {
		let delta = g.res[i + 1] - g.res[i];
		if acc + delta > ${limit} {
			break;
		}
		acc += delta;
		g.res[j] = delta;
		j++;
		i++;
	}
	g.n = j;
	out.i = acc;
	out.s.clear();
	format(out.s, "mapped sequence total ", acc);
	out
}
@end
