phrase: cycle entire collection by window distance {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="window shifted: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=-1
expect: => i=2 r=0.0 ok=true s="window shifted: 2" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n <= 1 { return out; }
	let eff = ((sh % g.n) + g.n) % g.n;
	var tmp = [0; 512];
	for i in g.n {
		let new_pos = (i + eff) % g.n;
		tmp[new_pos] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	out.i = eff;
	out.s.clear();
	format(out.s, "window shifted: ", eff);
	out
}
@end
