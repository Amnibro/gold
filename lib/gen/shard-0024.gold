expect: => i=0 r=0.0 ok=false s="error: no numbers in range" errors=1 n=2 res=[5,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low_bound};
	let hi = ${high_bound};
	var matched = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			matched++;
		}
	}
	if matched == 0 {
		gold_fail(g, "no numbers fall within specified range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no numbers in range");
		return out;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "grouped numbers in range: ", matched);
	out
}
@end
