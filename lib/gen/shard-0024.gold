			if g.ck[q] > g.ck[q + 1] {
				let tk = g.ck[q];
				let tv = g.cv[q];
				g.ck[q] = g.ck[q + 1];
				g.cv[q] = g.cv[q + 1];
				g.ck[q + 1] = tk;
				g.cv[q + 1] = tv;
			}
			q++;
		}
		p++;
	}
	g.steps += g.cn;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "qualifying memo entries: ", valid_count);
	out
}
