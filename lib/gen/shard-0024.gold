expect: 17
expect: 5
code:
fn ${ID}(n int) int {
	let max_steps = ${steps};
	var cur = if n <= 0 { 1 } else { n };
	var s = 0;
	while s < max_steps && cur > 1 {
		if cur % 2 == 0 {
			cur /= 2;
		} else {
			cur = 3 * cur + 1;
		}
		s++;
	}
	cur
}
@end
