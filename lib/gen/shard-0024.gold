@entry b021cfe58428c846
kind: step
verb: split
noun: odds
modifier: last
context: aggregate
slot: offset int
phrase: split odds last placing odd elements toward tail with offset {offset}
phrase: shift odd values to list conclusion adding {offset}
test: list=1,2,3,4,5,6 offset=10
expect: => i=3 r=0.0 ok=true s="moved 3 odd numbers to tail" errors=0 n=6 res=[2,4,6,11,13,15] cache=0 hits=0
test: list=7,8,9,10 offset=0
expect: => i=2 r=0.0 ok=true s="moved 2 odd numbers to tail" errors=0 n=4 res=[8,10,7,9] cache=0 hits=0
test: list=2,4,6 offset=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${offset} < 0 {
		gold_fail(g, "offset must be non-negative");
		out.ok = false;
		return out;
	}
	var buf int[512] = [0; 512];
	var k = 0;
	for i in g.n { if g.res[i] % 2 == 0 { buf[k] = g.res[i]; k++; } }
	let even_cnt = k;
	for i in g.n { if g.res[i] % 2 != 0 { buf[k] = g.res[i] + ${offset}; k++; } }
	for i in g.n { g.res[i] = buf[i]; }
	let odd_cnt = g.n - even_cnt;
	out.i = odd_cnt;
	out.s.clear();
	format(out.s, "moved ", odd_cnt, " odd numbers to tail");
	out
}
@end
