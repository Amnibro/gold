fn ${ID}(g Gold&, v Val) Val {
	var res_emboss_height_light = v;
	if !gold_img_ok(g) { res_emboss_height_light.ok = false; return res_emboss_height_light; }
	for k_emboss_height_light in g.iw * g.ih { g.img[k_emboss_height_light] = gold_clamp01(g.img[k_emboss_height_light] * ${a}); }
	var s_emboss_height_light = g.img;
	for y_emboss_height_light in g.ih {
		for x_emboss_height_light in g.iw {
			var t_emboss_height_light = 0.0;
			for dy_emboss_height_light in 3 { for dx_emboss_height_light in 3 { t_emboss_height_light += gold_img_wrap(g, x_emboss_height_light + dx_emboss_height_light - 1, y_emboss_height_light + dy_emboss_height_light - 1); } }
			s_emboss_height_light[y_emboss_height_light * g.iw + x_emboss_height_light] = t_emboss_height_light / 9.0;
		}
	}
	g.img = s_emboss_height_light;
	res_emboss_height_light.i = g.iw * g.ih;
	res_emboss_height_light.s.clear();
	format(res_emboss_height_light.s, "height");
	res_emboss_height_light
}
