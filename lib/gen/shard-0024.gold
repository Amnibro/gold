@entry a5b066d01f7f6eda
kind: step
verb: select
noun: window
modifier: until
context: stats
slot: ceiling int
phrase: select window until value meets ceiling {ceiling}
phrase: truncate sample window until threshold {ceiling}
test: list=10,20,30,50,60 ceiling=40
expect: => i=3 r=0.0 ok=true s="selected window until ceiling: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,2 ceiling=10
expect: => i=1 r=0.0 ok=true s="selected window until ceiling: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var count = 0;
	var sum = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= ceil {
			break;
		}
		sum += g.res[i];
		count++;
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "selected window until ceiling: ", count);
	out
}
@end
@entry ed2e238f0769b693
kind: step
verb: check
noun: checkpoint
modifier: in_reverse
context: stats
slot: target int
phrase: check checkpoint in reverse matching {target}
phrase: find reverse checkpoint offset for target {target}
test: list=10,20,30,40 target=30
expect: => i=1 r=0.0 ok=true s="reverse checkpoint offset: 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,2,3 target=99
expect: => i=-1 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	var rev_dist = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] == tgt {
			found = true;
			break;
		}
		rev_dist++;
	}
	g.steps += g.n;
	if !found {
		gold_fail(g, "check checkpoint in reverse: target absent");
		out.ok = false;
		out.i = -1;
	} else {
		out.i = rev_dist;
		out.s.clear();
		format(out.s, "reverse checkpoint offset: ", rev_dist);
	}
	out
}
@end
@entry 9747700ff2c674e0
kind: step
verb: reverse
noun: step
modifier: safely
context: stats
slot: step_size int
phrase: reverse step safely with block size {step_size}
phrase: invert initial step block safely with {step_size}
test: list=1,2,3,4,5 step_size=3
expect: => i=3 r=0.0 ok=true s="reversed step block safely: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 step_size=2
expect: => i=2 r=0.0 ok=true s="reversed step block safely: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_size};
	if s <= 1 || g.n < 2 {
		out.i = 0;
		return out;
	}
	var k = s;
	if k > g.n { k = g.n; }
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed step block safely: ", k);
	out
}
@end
