@entry 9cf80b440330bfc2
kind: step
verb: shift
noun: condition
modifier: sorted
context: stats
phrase: shift condition sorted observations past {cutoff}
phrase: align sorted items meeting condition {cutoff}
slot: cutoff int
test: list=10,25,5,40 cutoff=20
expect: => i=2 r=0.0 ok=true s="shifted: 2" errors=0 n=4 res=[10,26,5,41] cache=0 hits=0
test: list=2,8,14,3 cutoff=5
expect: => i=2 r=0.0 ok=true s="shifted: 2" errors=0 n=4 res=[2,9,15,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${cutoff};
	var moved = 0;
	for i in g.n {
		if g.res[i] >= thresh {
			g.res[i] += 1;
			moved++;
		}
	}
	g.steps += g.n;
	out.i = moved;
	out.s.clear();
	format(out.s, "shifted: ", moved);
	out
}
@end
@entry 64dbf9252855ee33
kind: step
verb: group
noun: checkpoint
modifier: between
context: stats
phrase: group checkpoint between range bounds {low} {high}
phrase: isolate checkpoint values between bounds {low} {high}
slot: low int
slot: high int
test: list=5,12,18,25,30 low=10 high=20
expect: => i=2 r=0.0 ok=true s="in checkpoint: 2" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=2,8,14,22 low=5 high=15
expect: => i=2 r=0.0 ok=true s="in checkpoint: 2" errors=0 n=2 res=[8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var inside = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			inside[count] = x;
			count++;
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, inside[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "in checkpoint: ", count);
	out
}
@end
@entry 7934cd87f391e1cb
