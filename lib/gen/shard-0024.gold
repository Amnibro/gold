@entry f4e480bccb490ec3
kind: step
verb: mask
noun: wood
modifier: sharp
context: texture
phrase: mask sharp wood field with seed {u}
phrase: produce sharp wood appearance with seed {u}
slot: u int
model: fbm n=2 c=4 u=${u}; remap a=0.15 b=0.85; contrast a=1.6
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="wood" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.073 max=0.992 sum8=34874 hash=902341
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="wood" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.951 sum8=124877 hash=906987
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 4;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(0.15 + (0.85 - 0.15) * g.img[k]); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "wood");
	out
}
@end
@entry bec73757415d2007
kind: step
verb: speckle
noun: moss
modifier: layered
context: texture
phrase: speckle layered moss texture with seed {u}
phrase: render layered moss pattern from seed {u}
slot: u int
model: worley c=8 u=${u}; blur; darken a=0.13
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.007 max=0.739 sum8=22589 hash=726087
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.004 max=0.785 sum8=79700 hash=34996
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.13); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
