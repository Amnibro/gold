code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${target} <= 0 {
		gold_fail(g, "target must be positive");
		out.ok = false;
		return out;
	}
	var j = 0;
	for i in g.n {
		let x = g.res[i];
		if x != ${target} {
			g.res[j] = x;
			j++;
		}
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "remaining ", j, " items");
	out
}
@end
