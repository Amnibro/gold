phrase: normalize spaces unique characters limit {max_passes}
slot: max_passes int
test: text="word   retry   spacing" max_passes=3
expect: => i=18 r=0.0 ok=true s="word retry spacing" errors=0 n=0 res=[] cache=0 hits=0
test: text="no   extra" max_passes=1
expect: => i=8 r=0.0 ok=true s="no extra" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_passes};
	var buf: byte[..200] = "";
	var prev_space = false;
	for b in out.s {
		if b == ' ' {
			if !prev_space {
				buf.push(b);
				prev_space = true;
			}
		} else {
			buf.push(b);
			prev_space = false;
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += mp;
	out.i = out.s.len;
	out
}
@end
@entry 797fd0f21ed905e7
kind: step
verb: repeat
noun: primes
modifier: times
context: retry
phrase: repeat primes times with retry budget {times}
phrase: cycle prime numbers across rounds {times}
slot: times int
test: list=2,3,4,5 times=2
expect: => i=6 r=0.0 ok=true s="primes repeated count: 6" errors=0 n=6 res=[2,3,5,2,3,5] cache=0 hits=0
test: list=7,9,11 times=1
expect: => i=2 r=0.0 ok=true s="primes repeated count: 2" errors=0 n=2 res=[7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var primes = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				primes[pn] = x;
				pn++;
			}
		}
	}
	gold_clear(g);
	for r in t {
		for i in pn {
			gold_push(g, primes[i]);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "primes repeated count: ", g.n);
	out
}
@end
