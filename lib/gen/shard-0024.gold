fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	var idx = g.n - 1;
	var passes = 0;
	while idx >= 0 {
		passes++;
		if g.res[idx] == tgt {
			found = idx;
			break;
		}
		idx--;
	}
	g.steps += passes;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "target found at index: ", found);
	} else {
		format(out.s, "target not found");
	}
	out
}
@end
