fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	var ev_list = [0; 512];
	for i in g.n {
		if g.res[i] % 2 == 0 {
			ev_list[evens] = g.res[i];
			evens++;
		}
	}
	for i in evens { g.res[i] = ev_list[i]; }
	g.n = evens;
	out.i = evens;
	out.s.clear();
	format(out.s, "evens count: ", evens);
	out
}
@end
