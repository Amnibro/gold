expect: => i=60 r=0.0 ok=true s="merged tail into 60" errors=0 n=4 res=[1,2,3,60] cache=0 hits=0
test: list=5,10,15,20 tail_len=2
expect: => i=35 r=0.0 ok=true s="merged tail into 35" errors=0 n=3 res=[5,10,35] cache=0 hits=0
test: list=1,2 tail_len=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${tail_len} <= 0 {
		gold_fail(g, "tail length must be positive");
		out.ok = false;
		return out;
	}
	let w = if ${tail_len} > g.n { g.n } else { ${tail_len} };
	var s = 0;
	let start = g.n - w;
	var i = start;
	while i < g.n {
		s += g.res[i];
		i++;
	}
	g.res[start] = s;
	g.n = start + 1;
	out.i = s;
	out.s.clear();
	format(out.s, "merged tail into ", s);
	out
}
@end
