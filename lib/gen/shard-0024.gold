code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_found = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_found { min_found = g.res[i]; }
	}
	out.ok = (min_found >= mv);
	out.i = min_found;
	out.s.clear();
	if out.ok { format(out.s, "minimum check passed"); } else { format(out.s, "minimum check failed"); }
	out
}
@end
