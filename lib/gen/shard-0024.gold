kind: step
verb: clamp
noun: streak
modifier: last
context: filter
phrase: clamp streak last run bounded by {max_len}
phrase: truncate streak last sequence cap {max_len}
slot: max_len int
test: list=1,2,3,3,3,3 max_len=2
expect: => i=4 r=0.0 ok=true s="clamped streak list length: 4" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=5,5,5,5 max_len=1
expect: => i=1 r=0.0 ok=true s="clamped streak list length: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var streak = 0;
	var idx = g.n - 1;
	while idx >= 0 && g.res[idx] == last_val {
		streak++;
		idx--;
	}
	if streak > ml {
		let remove_count = streak - ml;
		g.n -= remove_count;
		g.steps += remove_count;
	} else {
		g.steps++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped streak list length: ", g.n);
	out
}
@end
