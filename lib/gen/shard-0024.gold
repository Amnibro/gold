code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if g.n < 2 || cnt <= 0 { return out; }
	let total_pairs = g.n - 1;
	var actual = cnt;
	if actual > total_pairs { actual = total_pairs; }
	let start = total_pairs - actual;
	for i in actual {
		let idx = start + i;
		let prod = g.res[idx] * g.res[idx + 1];
		gold_cache_put(g, idx, prod);
	}
	out.i = actual;
	out.s.clear();
	format(out.s, "pairs cached: ", actual);
	out
}
@end
