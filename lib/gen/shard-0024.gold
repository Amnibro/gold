@entry 3842f1e43269ae33
kind: step
verb: search
noun: threshold
modifier: in_reverse
context: loop
slot: threshold int
phrase: search threshold in reverse order above {threshold}
phrase: scan threshold backwards finding value over {threshold}
test: list=5,12,8,20,3 threshold=10
expect: => i=20 r=0.0 ok=true s="found reverse threshold: 20" errors=0 n=5 res=[3,20,8,12,5] cache=0 hits=0
test: list=1,2,3,4 threshold=15
expect: => i=-1 r=0.0 ok=true s="threshold not matched" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var matched = -1;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] >= th {
			matched = g.res[idx];
			break;
		}
		idx--;
	}
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	out.i = matched;
	out.s.clear();
	if matched >= 0 {
		format(out.s, "found reverse threshold: ", matched);
	} else {
		format(out.s, "threshold not matched");
	}
	out
}
@end
@entry c583c8cc397d01bb
kind: step
verb: compare
noun: subfunction
modifier: recursively
context: loop
slot: depth int
phrase: compare subfunction recursively through depth {depth}
phrase: evaluate subfunction recursive steps {depth}
test: list=10,20,30 depth=3
expect: => i=2 r=0.0 ok=true s="recursive increases: 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 depth=2
expect: => i=2 r=0.0 ok=true s="recursive increases: 2" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var diffs = 0;
	var i = 0;
	while i < g.n - 1 && i < d {
		if g.res[i + 1] > g.res[i] { diffs++; }
		i++;
	}
	g.steps += i;
	out.i = diffs;
	out.s.clear();
	format(out.s, "recursive increases: ", diffs);
	out
}
@end
@entry 69b668f7025b1281
kind: step
verb: group
noun: histogram
modifier: with_retry
context: loop
slot: bins int
phrase: group histogram with retry buckets {bins}
phrase: partition histogram into buckets {bins}
test: list=2,4,7,12,15 bins=3
expect: => i=3 r=0.0 ok=true s="histogram bins: 3" errors=0 n=5 res=[2,4,7,12,15] cache=3 hits=2
test: list=1,3,5 bins=2
expect: => i=1 r=0.0 ok=true s="histogram bins: 1" errors=0 n=3 res=[1,3,5] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	for i in g.n {
		let bucket = g.res[i] % b;
		var cur, ok = gold_cache_get(g, bucket);
		gold_cache_put(g, bucket, cur + 1);
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "histogram bins: ", g.cn);
	out
}
@end
@entry e17a06b0ef273e5e
kind: step
verb: check
noun: cache
modifier: in_reverse
context: loop
slot: key int
phrase: check cache in reverse lookup for {key}
phrase: probe cache entries backwards for {key}
test: input=20 key=10
expect: => i=1 r=0.0 ok=true s="cache key matched" errors=0 n=0 res=[] cache=3 hits=0
test: input=5 key=99
expect: => i=0 r=0.0 ok=false s="cache key missing" errors=0 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	gold_cache_put(g, 10, 100);
	gold_cache_put(g, 20, 200);
	gold_cache_put(g, 30, 300);
	var found = false;
	var idx = g.cn - 1;
	while idx >= 0 {
		if g.ck[idx] == k {
			found = true;
			break;
		}
		idx--;
	}
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found { format(out.s, "cache key matched"); } else { format(out.s, "cache key missing"); }
	out
}
@end
@entry fb76c7c4a72ff953
kind: step
verb: compare
noun: items
modifier: pairwise
context: loop
slot: delta int
phrase: compare items pairwise tolerance {delta}
phrase: check adjacent items pairwise within {delta}
test: list=10,12,15,20 delta=3
expect: => i=2 r=0.0 ok=true s="pairwise matches: 2" errors=0 n=4 res=[10,12,15,20] cache=0 hits=0
test: list=10,30,50 delta=5
expect: => i=0 r=0.0 ok=true s="pairwise matches: 0" errors=0 n=3 res=[10,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var matched = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= d { matched++; }
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "pairwise matches: ", matched);
	out
}
@end
