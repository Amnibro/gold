test: list=10,20 factor=2
expect: => i=2 r=0.0 ok=true s="scaled reverse count: 2" errors=0 n=2 res=[40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		g.res[i] *= f;
	}
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled reverse count: ", g.n);
	out
}
@end
