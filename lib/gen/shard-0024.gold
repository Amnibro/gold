@entry d089d74c46829068
kind: step
verb: search
noun: numbers
modifier: unique
context: loop
slot: target int
phrase: search numbers unique distinct lookup for {target}
phrase: scan unique distinct numbers searching {target}
test: list=3,3,5,7,7 target=5
expect: => i=3 r=0.0 ok=true s="unique target found" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=2,2,4,4 target=9
expect: => i=2 r=0.0 ok=false s="unique target missing" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		var found = false;
		for j in kn {
			if kept[j] == g.res[i] { found = true; break; }
		}
		if !found {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	var matched = false;
	for i in kn {
		if kept[i] == tgt { matched = true; break; }
	}
	out.ok = matched;
	out.i = kn;
	out.s.clear();
	if matched { format(out.s, "unique target found"); } else { format(out.s, "unique target missing"); }
	out
}
@end
