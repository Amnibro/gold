expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${threshold} <= 0 {
		gold_fail(g, "threshold must be positive");
		out.ok = false;
		return out;
	}
	var j = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff >= ${threshold} {
			g.res[j] = g.res[i];
			g.res[j + 1] = g.res[i + 1];
			j += 2;
		}
		i += 2;
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "kept ", j, " pairwise items");
	out
}
@end
