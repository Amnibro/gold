noun: tail
modifier: with_retry
context: stats
slot: attempts int
phrase: measure tail with retry allowance {attempts}
phrase: evaluate sample tail with retry attempts {attempts}
test: list=10,20,30,40 attempts=2
expect: => i=35 r=0.0 ok=true s="measured tail average with retry: 35" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15 attempts=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tries = ${attempts};
	if tries <= 0 || g.n == 0 {
		gold_fail(g, "measure tail with retry: invalid attempts or empty list");
		out.ok = false;
		return out;
	}
	let start = g.n / 2;
	let count = g.n - start;
	var sum = 0;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / count;
	g.steps += count;
	out.i = avg;
	out.s.clear();
	format(out.s, "measured tail average with retry: ", avg);
	out
}
@end
