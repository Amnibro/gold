fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${limit} <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ${limit} {
			g.res[i] = ${limit};
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " spaced items");
	out
}
@end
