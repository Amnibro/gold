@entry de973a5c0a6ce705
kind: step
verb: limit
noun: pairs
modifier: with_cache
context: stats
phrase: limit consecutive sample pair differences with cache to {maxdiff}
phrase: bound adjacent sample differences using cache by {maxdiff}
slot: maxdiff int
test: list=10,25,30,50 maxdiff=10
expect: => i=2 r=0.0 ok=true s="limited pairs: 2" errors=0 n=4 res=[10,25,30,50] cache=2 hits=0
test: list=100,105,130,135 maxdiff=15
expect: => i=1 r=0.0 ok=true s="limited pairs: 1" errors=0 n=4 res=[100,105,130,135] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${maxdiff};
	var limited = 0;
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > md {
			limited++;
			gold_cache_put(g, i, diff);
		}
	}
	out.i = limited;
	out.s.clear();
	format(out.s, "limited pairs: ", limited);
	out
}
@end
