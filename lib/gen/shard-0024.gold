phrase: combine total with retry budget {budget}
slot: budget int
test: list=5,10,15,20 budget=30
expect: => i=2 r=0.0 ok=true s="qualified pair totals: 2" errors=0 n=2 res=[15,25] cache=0 hits=0
test: list=2,4,6,8 budget=12
expect: => i=2 r=0.0 ok=true s="qualified pair totals: 2" errors=0 n=2 res=[6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var paired = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		let tot = g.res[i] + g.res[i + 1];
		if tot <= b {
			paired[pn] = tot;
			pn++;
		}
		i++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, paired[k]); }
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "qualified pair totals: ", pn);
	out
}
@end
