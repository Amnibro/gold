fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let dl = ${delta};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum >= tgt {
		for i in g.n { g.res[i] += dl; }
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "total shifted: ", sum);
	out
}
@end
