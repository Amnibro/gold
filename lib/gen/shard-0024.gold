fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	var counts = [0; 512];
	for i in g.n {
		var c = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { c++; }
		}
		counts[i] = c;
	}
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if counts[i] <= mf {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "histogram filtered count: ", kn);
	out
}
@end
