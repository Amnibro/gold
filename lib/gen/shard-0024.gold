noun: duplicates
modifier: in_place
context: list
phrase: merge duplicates in place preserving order
phrase: deduplicate list elements in place sequentially
test: list=4,7,4,9,7
expect: => i=3 r=0.0 ok=true s="merged duplicates in place remaining: 3" errors=0 n=3 res=[4,7,9] cache=0 hits=0
test: list=2,2,2,2
expect: => i=1 r=0.0 ok=true s="merged duplicates in place remaining: 1" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var write_idx = 0;
	var i = 0;
	while i < n {
		let val = g.res[i];
		var seen = false;
		var j = 0;
		while j < write_idx {
			if g.res[j] == val {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			g.res[write_idx] = val;
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged duplicates in place remaining: ", write_idx);
	out
}
@end
