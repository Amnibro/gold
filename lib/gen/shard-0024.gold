code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var rot = 0;
	while rot < g.n && !${p}(g.res[0]) {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rot++;
	}
	g.steps += rot;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated steps: ", rot);
	out
}
@end
