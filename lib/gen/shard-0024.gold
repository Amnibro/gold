test: list=1,2 min_prime=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}_is_prime(x int) bool {
	if x < 2 { return false; }
	var d = 2;
	while d * d <= x {
		if x % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min_prime} <= 0 {
		gold_fail(g, "min prime must be positive");
		out.ok = false;
		return out;
	}
	var valid_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > ${min_prime} && g.res[i + 1] > ${min_prime} && ${ID}_is_prime(g.res[i]) && ${ID}_is_prime(g.res[i + 1]) {
			valid_pairs++;
		}
		i += 2;
	}
	out.i = valid_pairs;
	out.s.clear();
	format(out.s, "checked ", valid_pairs, " prime pairs");
	out
}
@end
