context: list
phrase: reverse prefix at most count {limit}
phrase: invert prefix at most span {limit}
slot: limit int
test: list=1,2,3,4,5 limit=3
expect: => i=3 r=0.0 ok=true s="reversed prefix elements: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="reversed prefix elements: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var k = lim;
	if k > g.n { k = g.n; }
	var l = 0;
	var r = k - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed prefix elements: ", k);
	out
}
@end
