code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var dup = false;
	var lim = sp;
	if lim > g.n { lim = g.n; }
	var i = 0;
	while i < lim {
		var j = i + 1;
		while j < lim {
			if g.res[i] == g.res[j] { dup = true; break; }
			j++;
		}
		if dup { break; }
		i++;
	}
	g.steps += i + 1;
	if dup {
		gold_fail(g, "head elements contain duplicates");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = lim;
	out.s.clear();
	format(out.s, "head prefix verified: ", lim);
	out
}
@end
