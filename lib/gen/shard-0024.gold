@entry 0b7cef9cf19b7305
kind: pred
verb: compare
noun: runs
modifier: while
context: sort
phrase: compare runs while digits nondecreasing
phrase: digits ordered nondecreasing sequence check
test: arg=123,321,114
expect: true
expect: false
expect: true
test: arg=5,7899
expect: true
expect: true
code:
fn ${ID}(n int) bool {
	var x = n;
	if x < 0 { x = -x; }
	if x < 10 { return true; }
	var last = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur > last { return false; }
		last = cur;
		x /= 10;
	}
	true
}
@end
@entry a24940631a6d43e9
kind: pred
verb: compare
noun: average
modifier: recursively
context: sort
slot: threshold int
phrase: compare average recursively past threshold {threshold}
phrase: check digit sum exceeding threshold {threshold}
test: arg=45,12,-99 threshold=8
expect: true
expect: false
expect: true
test: arg=7,123 threshold=6
expect: true
expect: true
code:
fn ${ID}(n int) bool {
	var x = n;
	let thresh = ${threshold};
	if x < 0 { x = -x; }
	var s = 0;
	while x > 0 {
		s += x % 10;
		x /= 10;
	}
	s >= thresh
}
@end
