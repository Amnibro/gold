kind: step
verb: normalize
noun: primes
modifier: unique
context: aggregate
slot: bonus int
phrase: normalize primes unique rewarding prime items with bonus {bonus}
phrase: boost distinct prime numbers in results by {bonus}
test: list=2,3,4,5,6,7 bonus=5
expect: => i=4 r=0.0 ok=true s="boosted 4 prime elements" errors=0 n=6 res=[7,8,4,10,6,12] cache=0 hits=0
test: list=11,13,11,14 bonus=1
expect: => i=3 r=0.0 ok=true s="boosted 3 prime elements" errors=0 n=4 res=[12,14,12,14] cache=0 hits=0
test: list=4,6,8 bonus=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${bonus} <= 0 {
		gold_fail(g, "bonus must be positive");
		out.ok = false;
		return out;
	}
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] += ${bonus};
			prime_count++;
		}
	}
	out.i = prime_count;
	out.s.clear();
	format(out.s, "boosted ", prime_count, " prime elements");
	out
}
@end
