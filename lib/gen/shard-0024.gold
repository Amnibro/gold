kind: step
verb: rank
noun: runs
modifier: at_most
context: math
phrase: rank consecutive runs capping score at most {max_rank}
phrase: evaluate run lengths bounding rank at most {max_rank}
slot: max_rank int
test: list=3,3,3,5,5,7 max_rank=2
expect: => i=5 r=0.0 ok=true s="total run score: 5" errors=0 n=6 res=[2,2,2,2,2,1] cache=0 hits=0
test: list=1,1,1,1,2,2 max_rank=3
expect: => i=5 r=0.0 ok=true s="total run score: 5" errors=0 n=6 res=[3,3,3,3,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_rank};
	var total_rank = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let r = if run_len > mr { mr } else { run_len };
		for k in i..j {
			g.res[k] = r;
		}
		total_rank += r;
		i = j;
	}
	out.i = total_rank;
	out.s.clear();
	format(out.s, "total run score: ", total_rank);
	out
}
@end
