fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sym = '_' as byte;
	if ${ch}.len > 0 {
		sym = ${ch}[0];
	}
	var swapped = 0;
	var buf: byte[..200] = "";
	for b in out.s {
		if b == ' ' {
			buf.push(sym);
			swapped++;
		} else {
			buf.push(b);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += swapped;
	out.i = swapped;
	out
}
@end
