fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_coll_chk_uniq_b334 = 0;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) {
			var exists = false;
			for prev in kept {
				if prev == x { exists = true; break; }
			}
			if !exists { kept.push(x); }
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n + mark_coll_chk_uniq_b334;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique: ", g.n);
	out
}
@end
