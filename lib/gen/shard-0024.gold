kind: step
verb: duplicate
noun: bridge
modifier: circular
context: scene
phrase: duplicate bridge circular array pattern count {n}
phrase: clone bridge circular elements count {n}
phrase: replicate bridge circular formation count {n}
slot: n int
test: n=3 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=2 r=0.0 ok=true s="dupbrid" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1 ra3
test: n=5 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=2 r=0.0 ok=true s="dupbrid" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1 ra5
test: n=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_duplicate_bridge_circular_alpha = 0;
	let n = ${n};
	if n <= 1 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no item yet"); out.ok = false; return out; }
	var o byte[>..] = [];
	o.append(" ra"); format(o, n);
	gold_dappend(g, k, o);
	out.i = g.dn + mark_duplicate_bridge_circular_alpha;
	out.s.clear();
	format(out.s, "dupbrid");
	out
}
@end
