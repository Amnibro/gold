@entry 60e13befff7d683d
kind: step
verb: sort
noun: middle
modifier: pairwise
context: math
phrase: sort middle entries by comparing pairwise margins {margin}
phrase: order middle elements pairwise within boundary offset {margin}
slot: margin int
test: list=10,9,4,7,2,8 margin=1
expect: => i=5 r=0.0 ok=true s="pairwise swaps: 5" errors=0 n=6 res=[10,2,4,7,9,8] cache=0 hits=0
test: list=100,50,40,30,20 margin=2
expect: => i=0 r=0.0 ok=true s="pairwise swaps: 0" errors=0 n=5 res=[100,50,40,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	let s = if m < g.n { m } else { g.n };
	let e = if g.n - m > s { g.n - m } else { s };
	var swaps = 0;
	if e > s {
		for p in s..e {
			for q in s..(e - 1) {
				if g.res[q] > g.res[q + 1] {
					let tmp = g.res[q];
					g.res[q] = g.res[q + 1];
					g.res[q + 1] = tmp;
					swaps++;
				}
			}
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "pairwise swaps: ", swaps);
	out
}
@end
