fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let orig = out.s.len;
	if orig == 0 {
		gold_fail(g, "empty text");
		out.ok = false;
		return out;
	}
	while out.s.len < ml && out.s.len < 180 {
		for i in orig {
			if out.s.len < 180 { out.s.push(out.s[i]); }
		}
	}
	out.i = out.s.len;
	out
}
@end
