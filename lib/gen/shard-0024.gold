code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	gold_cache_put(g, 1, swaps);
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted");
	out
}
@end
