			while j + 1 < g.n {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	var k = 0;
	while k < g.n {
		gold_cache_put(g, k, g.res[k]);
		k++;
	}
	out.i = g.n;
	out.s.clear();
