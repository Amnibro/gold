fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_grp_primes_atleast_b334 = 0;
	let fl = ${floor};
	var primes int[>..] = [];
	var others int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x >= fl && ${ID}_is_prime(x) {
			primes.push(x);
		} else {
			others.push(x);
		}
	}
	var idx = 0;
	for x in primes { g.res[idx] = x; idx++; }
	for x in others { g.res[idx] = x; idx++; }
	g.steps += g.n + mark_grp_primes_atleast_b334;
	out.i = primes.len;
	out.s.clear();
	format(out.s, "primes grouped: ", primes.len);
	out
}
@end
