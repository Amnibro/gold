fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = g.n;
	var pairs = 0;
	var i = 1;
	while i < n {
		let sum = g.res[i - 1] + g.res[i];
		let val = ${f}(sum);
		gold_push(g, val);
		pairs++;
		i++;
	}
	g.steps += n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired function applications count: ", pairs);
	out
}
