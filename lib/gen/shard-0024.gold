expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${thresh} < 0 {
		gold_fail(g, "threshold must be non-negative");
		out.ok = false;
		return out;
	}
	var dup_sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x > ${thresh} {
			var count = 0;
			for k in g.n { if g.res[k] == x { count++; } }
			if count > 1 { dup_sum += x; }
		}
	}
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "sum of duplicate instances ", dup_sum);
	out
}
@end
@entry d13887a4b0432304
kind: step
verb: sum
noun: window
modifier: sorted
context: aggregate
slot: k int
phrase: sum window sorted taking lowest {k} elements
phrase: sum smallest {k} sorted values from results
test: list=12,5,8,1,19,3 k=3
expect: => i=9 r=0.0 ok=true s="sum of lowest 3 is 9" errors=0 n=6 res=[1,3,5,8,12,19] cache=0 hits=0
test: list=20,10,30,5 k=2
expect: => i=15 r=0.0 ok=true s="sum of lowest 2 is 15" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
test: list=10,20 k=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${k} <= 0 {
		gold_fail(g, "k must be positive");
		out.ok = false;
		return out;
	}
	// Selection sort
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		let tmp = g.res[i];
		g.res[i] = g.res[min_idx];
		g.res[min_idx] = tmp;
	}
	var s = 0;
	let lim = if ${k} < g.n { ${k} } else { g.n };
	for i in lim { s += g.res[i]; }
	out.i = s;
	out.s.clear();
	format(out.s, "sum of lowest ", lim, " is ", s);
	out
}
@end
