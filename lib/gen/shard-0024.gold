fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${delta} <= 0 {
		gold_fail(g, "delta must be positive");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1] + ${delta};
		g.res[i + 1] = tmp + ${delta};
		i += 2;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely swapped adjacent pairs");
	out
}
@end
