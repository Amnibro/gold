expect: => i=3 r=0.0 ok=true s="gaps: 3" errors=0 n=3 res=[2,6,7] cache=0 hits=0
test: list=1,2,4,8,16 count=2
expect: => i=2 r=0.0 ok=true s="gaps: 2" errors=0 n=2 res=[4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_split_gaps_last_b334 = 0;
	let c = ${count};
	if g.n < 2 || c <= 0 { return out; }
	let num_gaps = if c < g.n - 1 { c } else { g.n - 1 };
	var start = (g.n - 1) - num_gaps;
	var gaps int[>..] = [];
	for i in num_gaps {
		let idx = start + i;
		gaps.push(g.res[idx + 1] - g.res[idx]);
	}
	gold_clear(g);
	for x in gaps { gold_push(g, x); }
	g.steps += num_gaps + mark_split_gaps_last_b334;
	out.i = num_gaps;
	out.s.clear();
	format(out.s, "gaps: ", num_gaps);
	out
}
@end
