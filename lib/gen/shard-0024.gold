@entry 6469ede85d2174c3
kind: step
verb: validate
noun: text
modifier: nested
context: retry
phrase: validate text nested bracket nesting depth {depth}
phrase: verify text nested balance level depth {depth}
slot: depth int
test: text="((sample))" depth=2
expect: => i=2 r=0.0 ok=true s="max nesting observed: 2" errors=0 n=0 res=[] cache=0 hits=0
test: text="((bad)" depth=3
expect: => i=2 r=0.0 ok=false s="max nesting observed: 2" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${depth};
	var cur_depth = 0;
	var max_seen = 0;
	var valid = true;
	for b in out.s {
		if b == '(' {
			cur_depth++;
			if cur_depth > max_seen { max_seen = cur_depth; }
			if cur_depth > md { valid = false; break; }
		} else if b == ')' {
			if cur_depth <= 0 { valid = false; break; }
			cur_depth--;
		}
	}
	if cur_depth != 0 { valid = false; }
	if !valid {
		gold_fail(g, "bracket balance error");
		out.ok = false;
	}
	out.i = max_seen;
	out.s.clear();
	format(out.s, "max nesting observed: ", max_seen);
	out
}
@end
