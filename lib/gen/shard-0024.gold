fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${tag}.len == 0 {
		gold_fail(g, "tag cannot be empty");
		out.ok = false;
		return out;
	}
	let matches = out.s == ${tag};
	out.i = if matches { 1 } else { 0 };
	out.s.clear();
	if matches {
		format(out.s, "words matched safely");
	} else {
		format(out.s, "words mismatched safely");
	}
	out
}
@end
