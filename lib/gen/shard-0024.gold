kind: step
verb: swap
noun: series
modifier: in_place
context: stats
slot: count int
phrase: swap series in place segments of size {count}
phrase: exchange series boundaries in place with length {count}
test: list=1,2,3,4,5,6 count=2
expect: => i=2 r=0.0 ok=true s="swapped series in place count: 2" errors=0 n=6 res=[5,6,3,4,1,2] cache=0 hits=0
test: list=10,20,30,40 count=1
expect: => i=1 r=0.0 ok=true s="swapped series in place count: 1" errors=0 n=4 res=[40,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var m = k;
	if m * 2 > g.n { m = g.n / 2; }
	if m < 0 { m = 0; }
	var i = 0;
	while i < m {
		let last_idx = g.n - m + i;
		let tmp = g.res[i];
		g.res[i] = g.res[last_idx];
		g.res[last_idx] = tmp;
		i++;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "swapped series in place count: ", m);
	out
}
@end
