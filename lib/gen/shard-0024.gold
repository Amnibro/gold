phrase: dark speckled metal texture from seed {u}
slot: u int
model: noise c=4 u=${u}; contrast a=1.5; darken a=0.2
test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="metal" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.8 sum8=23735 hash=383667
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="metal" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.8 sum8=90217 hash=676716
test: u=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	// texture step speckle metal dark
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.2); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "metal");
	out
}
@end
