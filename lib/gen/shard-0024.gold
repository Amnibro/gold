@entry 66ff0a5510a7dc07
kind: step
verb: scan
noun: subfunction
modifier: with_cache
context: stats
slot: sub fn
phrase: scan subfunction {sub} with cache enabled
phrase: apply subfunction {sub} with caching across sample
test: list=3,3,4 sub=double
expect: => i=1 r=0.0 ok=true s="cache hits during scan: 1" errors=0 n=3 res=[6,6,8] cache=2 hits=1
test: list=5,5,5 sub=inc
expect: => i=2 r=0.0 ok=true s="cache hits during scan: 2" errors=0 n=3 res=[6,6,6] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let val = ${sub}(x);
			gold_cache_put(g, x, val);
			g.res[i] = val;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "cache hits during scan: ", g.hits);
	out
}
@end
