		if g.res[i] == tgt {
			found = true;
			idx = i;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	if !found {
		gold_fail(g, "retry step any: target absent after scan");
		out.ok = false;
		out.i = -1;
	} else {
		out.i = idx;
		out.s.clear();
		format(out.s, "matched any step at index: ", idx);
	}
	out
}
@end
