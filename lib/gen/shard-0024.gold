code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target_gap};
	var found_idx = -1;
	for i in 0..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff == tg {
			found_idx = i;
			break;
		}
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "gap pair index: ", found_idx);
	out
}
@end
