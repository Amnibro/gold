noun: streak
modifier: up_to
context: aggregate
slot: max_len int
phrase: compare streak up to maximum length limit {max_len}
phrase: measure continuous ascending streak capped at {max_len}
test: list=1,2,3,4,2,3 max_len=3
expect: => i=3 r=0.0 ok=true s="streak up to 3" errors=0 n=6 res=[1,2,3,4,2,3] cache=0 hits=0
test: list=5,6,7,8,9 max_len=6
expect: => i=5 r=0.0 ok=true s="streak up to 5" errors=0 n=5 res=[5,6,7,8,9] cache=0 hits=0
test: list=10,9,8 max_len=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,9,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${max_len} <= 0 {
		gold_fail(g, "max_len must be positive");
		out.ok = false;
		return out;
	}
	var best = 0;
	var cur = if g.n > 0 { 1 } else { 0 };
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur++;
		} else {
			if cur > best { best = cur; }
			cur = 1;
		}
	}
	if cur > best { best = cur; }
	let bounded = if best > ${max_len} { ${max_len} } else { best };
	out.i = bounded;
	out.s.clear();
	format(out.s, "streak up to ", bounded);
	out
}
@end
