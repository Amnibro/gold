noun: counter
modifier: until
context: stats
phrase: drop counter until cumulative mass reaches {target}
phrase: discard leading observations until sum totals {target}
slot: target int
test: list=4,6,10,20 target=12
expect: => i=3 r=0.0 ok=true s="dropped count: 3" errors=0 n=1 res=[20] cache=0 hits=0
test: list=5,15,30 target=18
expect: => i=2 r=0.0 ok=true s="dropped count: 2" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var acc = 0;
	var drop_idx = 0;
	while drop_idx < g.n && acc < tgt {
		acc += g.res[drop_idx];
		drop_idx++;
	}
	var rem = g.n - drop_idx;
	for i in rem { g.res[i] = g.res[i + drop_idx]; }
	g.n = rem;
	out.i = drop_idx;
	out.s.clear();
	format(out.s, "dropped count: ", drop_idx);
	out
}
@end
