@entry db4b9e2dd7ee2941
kind: step
verb: limit
noun: total
modifier: each
context: stats
phrase: limit total each cumulative bin to ceiling {cap}
phrase: restrict running totals to maximum ceiling {cap}
slot: cap int
test: list=10,20,30,40 cap=50
expect: => i=50 r=0.0 ok=true s="total capped: 50" errors=0 n=4 res=[10,20,20,0] cache=0 hits=0
test: list=15,25,35 cap=60
expect: => i=60 r=0.0 ok=true s="total capped: 60" errors=0 n=3 res=[15,25,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var running = 0;
	for i in g.n {
		running += g.res[i];
		if running > ceiling {
			g.res[i] -= (running - ceiling);
			running = ceiling;
		}
	}
	out.i = running;
	out.s.clear();
	format(out.s, "total capped: ", running);
	out
}
@end
