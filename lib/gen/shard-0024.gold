code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > md {
			valid = false;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	if !valid {
		gold_fail(g, "pairwise difference exceeded threshold");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = i;
	out.s.clear();
	format(out.s, "pairwise checked count: ", i);
	out
}
@end
