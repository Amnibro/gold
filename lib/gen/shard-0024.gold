code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var start = -1;
	var len = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == tgt {
			if start == -1 { start = i; }
			len++;
		} else if start != -1 {
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.i = len;
	out.s.clear();
	format(out.s, "streak length reversed: ", len);
	out
}
@end
