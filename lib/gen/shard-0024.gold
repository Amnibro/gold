noun: threshold
modifier: with_cache
context: math
phrase: return threshold filtered elements consulting cache for {cutoff}
phrase: retrieve threshold passing items with cached evaluation {cutoff}
slot: cutoff int
test: list=5,12,3,20,8 cutoff=10
expect: => i=2 r=0.0 ok=true s="above threshold: 2" errors=0 n=2 res=[12,20] cache=5 hits=0
test: list=1,2,4 cutoff=3
expect: => i=1 r=0.0 ok=true s="above threshold: 1" errors=0 n=1 res=[4] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		var effective = val;
		if !hit {
			effective = x;
			gold_cache_put(g, x, effective);
		}
		if effective >= c {
			g.res[kept] = effective;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "above threshold: ", kept);
	out
}
@end
