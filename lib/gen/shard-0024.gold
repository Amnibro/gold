	var cp_count = 0;
	var i = 0;
	while i < g.n {
		var rank_val = 1;
		var j = 0;
		while j < g.n {
			if g.res[j] < g.res[i] { rank_val++; }
			j += iv;
		}
		g.res[i] = rank_val;
		cp_count++;
		i += iv;
	}
	out.i = cp_count;
	out.s.clear();
	format(out.s, "ranked checkpoints: ", cp_count);
	out
}
