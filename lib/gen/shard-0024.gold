	var rhole byte[>..] = [];
	gold_dnews(g, "rib_bore", "", rhole);
	rhole.append(" cyl 0,0,-");
	rhole.append("0.0");
	rhole.append("4 0,");
	rhole.append("0,0.");
	rhole.append("04 r");
	rhole.append("0.0");
	rhole.append("08 - a");
	format(rhole, ${n});
	rhole.append(":0.");
	rhole.append("05");
	rhole.append(",0,");
	rhole.append("0");
	gold_doc(g, rhole);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "rib_bore");
	out
}
@end
