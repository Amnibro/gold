kind: step
verb: merge
noun: total
modifier: at_least
context: aggregate
slot: min_total int
phrase: merge running total elements until reaching at least {min_total}
phrase: combine adjacent values when cumulative total meets at least {min_total}
test: list=10,20,30,40,50 min_total=50
expect: => i=60 r=0.0 ok=true s="merged total reached 60" errors=0 n=3 res=[60,40,50] cache=0 hits=0
test: list=5,10,15,20 min_total=25
expect: => i=30 r=0.0 ok=true s="merged total reached 30" errors=0 n=2 res=[30,20] cache=0 hits=0
test: list=1,2,3 min_total=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min_total} <= 0 {
		gold_fail(g, "min total must be positive");
		out.ok = false;
		return out;
	}
	var acc = 0;
	var count = 0;
	for i in g.n {
		acc += g.res[i];
		count++;
		if acc >= ${min_total} {
			break;
		}
	}
	g.res[0] = acc;
	var j = 1;
	while count < g.n {
		g.res[j] = g.res[count];
		j++;
		count++;
	}
	g.n = j;
	out.i = acc;
	out.s.clear();
	format(out.s, "merged total reached ", acc);
	out
}
@end
