fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	let cx = ((g.iw - 1) as real) / 2.0;
	let cy = ((g.ih - 1) as real) / 2.0;
	var rr = (g.iw as real) / 2.0;
	if g.ih < g.iw { rr = (g.ih as real) / 2.0; }
	for y in g.ih {
		for x in g.iw {
			let a = (x as real) - cx;
			let b = (y as real) - cy;
			g.img[y * g.iw + x] = gold_clamp01(1.0 - sqrt(a * a + b * b) / rr);
		}
	}
	var s2_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tone");
	out
}
@end
