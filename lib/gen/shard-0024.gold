fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	let fn_idx = ${finish};
	var dupes = 0;
	var i = st;
	while i <= fn_idx && i < g.n {
		var j = i + 1;
		while j <= fn_idx && j < g.n {
			if g.res[i] == g.res[j] {
				dupes++;
			}
			j++;
		}
		i++;
	}
	g.steps += i;
	out.i = dupes;
	out.ok = dupes == 0;
	out.s.clear();
	format(out.s, "duplicates found: ", dupes);
	out
}
