slot: factor int
test: list=2,4,10,20 low=3 high=15 factor=2
expect: => i=1 r=0.0 ok=true s="pairs scaled: 1" errors=0 n=4 res=[4,8,10,20] cache=0 hits=0
test: list=5,15,25 low=20 high=30 factor=3
expect: => i=1 r=0.0 ok=true s="pairs scaled: 1" errors=0 n=3 res=[15,45,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let f = ${factor};
	var scaled = 0;
	if g.n >= 2 {
		var i = 0;
		while i < g.n - 1 {
			let s = g.res[i] + g.res[i + 1];
			if s >= lo && s <= hi {
				g.res[i] *= f;
				g.res[i + 1] *= f;
				scaled++;
			}
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "pairs scaled: ", scaled);
	out
}
@end
