expect: => i=1 r=0.0 ok=true s="sorted runs: 1" errors=0 n=3 res=[10,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let co = ${cutoff};
	var runs = 0;
	var cur_run = 1;
	if g.n > 1 {
		for i in g.n - 1 {
			if g.res[i + 1] >= g.res[i] {
				cur_run++;
			} else {
				if cur_run >= co { runs++; }
				cur_run = 1;
			}
		}
		if cur_run >= co { runs++; }
	}
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "sorted runs: ", runs);
	out
}
@end
