fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lw = ${low};
	let hg = ${high};
	let cnt = ${count};
	var dropped = 0;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= lw && val <= hg && dropped < cnt {
			dropped++;
		} else {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped range: ", dropped);
	out
}
