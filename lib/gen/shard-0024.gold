expect: => i=2 r=0.0 ok=true s="kept suffix length: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	let max_l = ${max_len};
	var k = max_l;
	if k > g.n { k = g.n; }
	if k < min_l { k = min_l; }
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	let start = g.n - k;
	var i = 0;
	while i < k {
		g.res[i] = g.res[start + i];
		i++;
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "kept suffix length: ", k);
	out
}
@end
