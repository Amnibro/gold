test: list=1,1,1,2,3,3 cap=1
expect: => i=1 r=0.0 ok=true s="under cap: 1" errors=0 n=6 res=[2,1,1,1,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_split_hist_atmost_b334 = 0;
	let cp = ${cap};
	var low int[>..] = [];
	var high int[>..] = [];
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq <= cp { low.push(g.res[i]); }
		else { high.push(g.res[i]); }
	}
	var idx = 0;
	for x in low { g.res[idx] = x; idx++; }
	for x in high { g.res[idx] = x; idx++; }
	g.steps += g.n + mark_split_hist_atmost_b334;
	out.i = low.len;
	out.s.clear();
	format(out.s, "under cap: ", low.len);
	out
}
