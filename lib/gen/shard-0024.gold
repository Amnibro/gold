	var right = e;
	if left < 0 { left = 0; }
	if right >= g.n { right = g.n - 1; }
	var count = 0;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed range swaps count: ", count);
	out
}
