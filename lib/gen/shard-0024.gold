expect: => i=4 r=0.0 ok=true s="retained duplicate elements: 4" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dups};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for k in kn {
			if kept[k] == x { seen++; }
		}
		if seen < md {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "retained duplicate elements: ", kn);
	out
}
@end
