@entry 1d31abf41dc60497
kind: step
verb: find
noun: text
modifier: any
context: stats
phrase: find text any pattern {pat} in state text
phrase: locate pattern {pat} inside string text
slot: pat text
test: text="sample mean 42" pat="mean"
expect: => i=1 r=0.0 ok=true s="match: 1" errors=0 n=0 res=[] cache=0 hits=0
test: text="variance test" pat="mean"
expect: => i=0 r=0.0 ok=false s="match: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pat};
	var plen = 0;
	for b in p { plen++; }
	var found = false;
	if plen > 0 && v.s.len >= plen {
		var i = 0;
		while i + plen <= v.s.len {
			var is_matched = true;
			var j = 0;
			while j < plen {
				if v.s[i + j] != p[j] { is_matched = false; break; }
				j++;
			}
			if is_matched { found = true; break; }
			i++;
		}
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "match: ", out.i);
	out
}
@end
