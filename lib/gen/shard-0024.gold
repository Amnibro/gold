@entry 44294786a044f18b
kind: step
verb: pair
noun: list
modifier: last
context: list
phrase: pair list last elements count {pairs}
phrase: couple list last entries size {pairs}
slot: pairs int
test: list=1,2,3,4,5,6 pairs=2
expect: => i=42 r=0.0 ok=true s="paired product sum: 42" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,20,30,40 pairs=1
expect: => i=1200 r=0.0 ok=true s="paired product sum: 1200" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pairs};
	var paired_sum = 0;
	if g.n >= 2 {
		var needed = p * 2;
		if needed > g.n { needed = g.n - (g.n % 2); }
		let start = g.n - needed;
		var i = start;
		while i < g.n {
			paired_sum += g.res[i] * g.res[i + 1];
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = paired_sum;
	out.s.clear();
	format(out.s, "paired product sum: ", paired_sum);
	out
}
@end
@entry fc399b9648b21184
kind: step
verb: select
noun: duplicates
modifier: until
context: list
phrase: select duplicates until cap {limit}
phrase: filter duplicates until cap {limit}
slot: limit int
test: list=1,2,2,3,3,3,4 limit=2
expect: => i=2 r=0.0 ok=true s="duplicates gathered: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
