code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dupes = [0; 512];
	var dn = 0;
	var i = 0;
	while i < g.n && dn < lim {
		var is_dup = false;
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				is_dup = true;
				break;
			}
			j++;
		}
		if is_dup {
			dupes[dn] = g.res[i];
			dn++;
		}
		i++;
	}
	gold_clear(g);
	for k in dn { gold_push(g, dupes[k]); }
	g.steps += i;
	out.i = dn;
	out.s.clear();
	format(out.s, "duplicates gathered: ", dn);
	out
}
@end
