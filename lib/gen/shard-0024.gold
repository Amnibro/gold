		if g.res[i] % 2 == 0 { evens++; }
	}
	let odds = g.n - evens;
	let diff = evens - odds;
	out.i = diff;
	out.s.clear();
	format(out.s, "even balance: ", diff);
	out
}
@end
@entry 83aecad7a2ae019d
kind: step
verb: group
noun: duplicates
