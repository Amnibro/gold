fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var matched = -1;
	var idx = 0;
	while idx < g.n && idx < b {
		if ${p}(g.res[idx]) {
			matched = idx;
			break;
		}
		idx++;
	}
	g.steps += idx + 1;
	out.i = matched;
	out.s.clear();
	if matched >= 0 {
		format(out.s, "found at index: ", matched);
	} else {
		format(out.s, "prefix match not found");
	}
	out
}
