test: list=1,2 factor=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${factor} <= 0 {
		gold_fail(g, "factor must be positive");
		out.ok = false;
		return out;
	}
	var j = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[j] = (g.res[i] + g.res[i + 1]) * ${factor};
		j++;
		i += 2;
	}
	if i < g.n {
		g.res[j] = g.res[i] * ${factor};
		j++;
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "merged series into ", j, " items");
	out
}
@end
