@entry 6ce5b364f4879d81
kind: step
verb: run
noun: gaps
modifier: recursively
context: stats
phrase: run gaps recursively across sample differences
phrase: compute successive gap differences recursively
test: list=10,15,22,35
expect: => i=4 r=0.0 ok=true s="gaps final: 4" errors=0 n=1 res=[4] cache=0 hits=0
test: list=3,10,25,50
expect: => i=2 r=0.0 ok=true s="gaps final: 2" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "gaps: 0");
		return out;
	}
	var rounds = 0;
	while g.n > 1 && rounds < 5 {
		var i = 0;
		while i + 1 < g.n {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			g.res[i] = diff;
			i++;
		}
		g.n--;
		rounds++;
	}
	g.steps += rounds;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "gaps final: ", out.i);
	out
}
@end
