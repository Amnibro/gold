phrase: partition observations using condition {cond} with retry
slot: cond pred
test: list=1,3,5,8,10 cond=is_even
expect: => i=2 r=0.0 ok=true s="condition grouped: 2" errors=0 n=2 res=[8,10] cache=0 hits=0
test: list=1,3,5,7 cond=is_even
expect: => i=4 r=0.0 ok=true s="condition grouped: 4" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	var temp = [0; 512];
	for i in g.n {
		if ${cond}(g.res[i]) {
			temp[matched] = g.res[i];
			matched++;
		}
	}
	if matched == 0 {
		for i in g.n {
			if !${cond}(g.res[i]) {
				temp[matched] = g.res[i];
				matched++;
			}
		}
	}
	for i in matched { g.res[i] = temp[i]; }
	g.n = matched;
	out.i = matched;
	out.s.clear();
	format(out.s, "condition grouped: ", matched);
	out
}
@end
@entry 19671eb5499b1ec5
kind: step
verb: apply
noun: duplicates
modifier: in_reverse
context: stats
phrase: identify duplicate sample values scanning in reverse
phrase: count duplicate observation frequencies backwards
test: list=10,20,10,30,20,40
expect: => i=2 r=0.0 ok=true s="dupes reverse: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
test: list=5,7,5,8,7,9
expect: => i=2 r=0.0 ok=true s="dupes reverse: 2" errors=0 n=2 res=[7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == val {
				seen_before = true;
				break;
			}
		}
		if seen_before {
			var already_added = false;
			for k in count {
				if dupes[k] == val {
					already_added = true;
					break;
				}
			}
			if !already_added {
				dupes[count] = val;
				count++;
			}
		}
		i--;
	}
	for k in count { g.res[k] = dupes[k]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "dupes reverse: ", count);
	out
}
@end
@entry ef0bd453e80bd7ef
kind: step
verb: apply
noun: tail
modifier: nested
context: stats
phrase: compute summary statistics of tail observations count {k}
phrase: calculate mean of last {k} sample values
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=40 r=0.0 ok=true s="tail mean: 40" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=5,15,25,35,45 k=2
expect: => i=40 r=0.0 ok=true s="tail mean: 40" errors=0 n=2 res=[35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if g.n == 0 || count <= 0 { return out; }
	var actual = count;
	if actual > g.n { actual = g.n; }
	var sum = 0;
	let start = g.n - actual;
	for i in actual {
		let val = g.res[start + i];
		sum += val;
		g.res[i] = val;
	}
	g.n = actual;
	let avg = sum / actual;
	out.i = avg;
	out.s.clear();
	format(out.s, "tail mean: ", avg);
	out
}
@end
