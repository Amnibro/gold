fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${copies};
	if g.n <= 2 { return out; }
	var buf = [0; 512];
	var bn = 0;
	buf[bn] = g.res[0];
	bn++;
	for i in 1..(g.n - 1) {
		for rep in cp {
			if bn < 512 {
				buf[bn] = g.res[i];
				bn++;
			}
		}
	}
	if bn < 512 {
		buf[bn] = g.res[g.n - 1];
		bn++;
	}
	g.n = 0;
	for k in bn { gold_push(g, buf[k]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "repeated middle size: ", bn);
	out
}
@end
