code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var joined = [0; 512];
	var jn = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && ${p}(g.res[i] + g.res[i + 1]) {
			joined[jn] = g.res[i] + g.res[i + 1];
			jn++;
			i += 2;
		} else {
			joined[jn] = g.res[i];
			jn++;
			i++;
		}
	}
	gold_clear(g);
	for k in jn { gold_push(g, joined[k]); }
	out.i = jn;
	out.s.clear();
	format(out.s, "joined pairs count: ", jn);
	out
}
@end
@entry d188d6fdcf9a48fd
kind: step
verb: sort
noun: sequence
modifier: nested
context: retry
phrase: sort sequence nested chunk length {chunk}
phrase: order sequence nested partition length {chunk}
slot: chunk int
test: list=9,2,7,1,5,3 chunk=3
expect: => i=6 r=0.0 ok=true s="sorted nested sequence: 6" errors=0 n=6 res=[2,7,9,1,3,5] cache=0 hits=0
test: list=4,1,8,2 chunk=2
expect: => i=4 r=0.0 ok=true s="sorted nested sequence: 4" errors=0 n=4 res=[1,4,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 {
		gold_fail(g, "invalid chunk size");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		var end_idx = i + c;
		if end_idx > g.n { end_idx = g.n; }
		var p = i;
		while p < end_idx {
			var q = i;
			while q < end_idx - 1 {
				if g.res[q] > g.res[q + 1] {
					let tmp = g.res[q];
					g.res[q] = g.res[q + 1];
					g.res[q + 1] = tmp;
				}
				q++;
			}
			p++;
		}
		i += c;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted nested sequence: ", g.n);
	out
}
@end
@entry 570a0c345a043e8c
kind: step
verb: filter
noun: gaps
modifier: every_other
context: retry
phrase: filter gaps every other element over threshold {threshold}
phrase: check gap intervals every other item threshold {threshold}
slot: threshold int
test: list=2,10,5,30,8,60 threshold=10
expect: => i=3 r=0.0 ok=true s="kept gap elements: 3" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=1,5,3,9,5 threshold=3
expect: => i=3 r=0.0 ok=true s="kept gap elements: 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if i + 2 < g.n {
			let diff = g.res[i + 2] - g.res[i];
			var d = diff;
			if d < 0 { d = -d; }
			if d <= th {
				kept[kn] = g.res[i];
				kn++;
			}
		} else {
			kept[kn] = g.res[i];
			kn++;
		}
		i += 2;
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "kept gap elements: ", kn);
	out
}
@end
