context: aggregate
slot: pivot int
phrase: split checkpoint with retry segregating elements around {pivot}
phrase: partition list around checkpoint boundary {pivot}
test: list=10,4,15,2,20 pivot=8
expect: => i=2 r=0.0 ok=true s="partitioned with 2 low items" errors=0 n=5 res=[4,2,10,15,20] cache=0 hits=0
test: list=5,12,3,18 pivot=10
