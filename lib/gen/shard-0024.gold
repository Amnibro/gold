fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${target_sum} <= 0 {
		gold_fail(g, "target sum must be positive");
		out.ok = false;
		return out;
	}
	var acc = 0;
	var count = 0;
	for i in g.n {
		acc += g.res[i];
		count++;
		if acc >= ${target_sum} { break; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "summed ", count, " items reaching ", acc);
	out
}
@end
