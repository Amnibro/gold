test: list=1,2 expected_avg=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${expected_avg} <= 0 {
		gold_fail(g, "expected average must be positive");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "list is empty");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let actual_avg = total / g.n;
	let matches = actual_avg == ${expected_avg};
	out.i = if matches { 1 } else { 0 };
	out.s.clear();
	format(out.s, "mean ", actual_avg, " vs expected ", ${expected_avg});
	out
}
@end
@entry f214d82c3dc1045c
kind: step
verb: apply
noun: primes
modifier: last
context: aggregate
slot: scale int
phrase: apply primes last multiplying final prime element by {scale}
phrase: scale rightmost prime in results by factor {scale}
test: list=4,6,7,9,11 scale=3
expect: => i=4 r=0.0 ok=true s="scaled last prime at 4" errors=0 n=5 res=[4,6,7,9,33] cache=0 hits=0
test: list=2,3,5 scale=2
expect: => i=2 r=0.0 ok=true s="scaled last prime at 2" errors=0 n=3 res=[2,3,10] cache=0 hits=0
test: list=4,6,8 scale=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${scale} <= 0 {
		gold_fail(g, "scale must be positive");
		out.ok = false;
		return out;
	}
	var last_prime_idx = -1;
	for i in g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { last_prime_idx = i; }
	}
	if last_prime_idx >= 0 {
		g.res[last_prime_idx] *= ${scale};
	}
	out.i = last_prime_idx;
	out.s.clear();
	format(out.s, "scaled last prime at ", last_prime_idx);
	out
}
@end
