test: list=5,5,6,6,6 min_run=2
expect: => i=2 r=0.0 ok=true s="matching runs: 2" errors=0 n=5 res=[5,5,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var run_count = 0;
	if g.n > 0 {
		var cur_len = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_len++;
			} else {
				if cur_len >= mr { run_count++; }
				cur_len = 1;
			}
		}
		if cur_len >= mr { run_count++; }
	}
	out.i = run_count;
	out.s.clear();
	format(out.s, "matching runs: ", run_count);
	out
}
@end
