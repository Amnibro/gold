@entry a127be586a1a5679
kind: step
verb: group
noun: pairs
modifier: any
context: error
phrase: group adjacent pairs checking for any difference above {threshold}
phrase: partition pairs flagging any difference exceeding {threshold}
slot: threshold int
test: list=2,5,8,12 threshold=5
expect: => i=2 r=0.0 ok=true s="grouped pairs count: 2" errors=0 n=4 res=[2,5,8,12] cache=0 hits=0
test: list=2,10,12 threshold=5
expect: => i=0 r=0.0 ok=false s="error: pair variance exceeded" errors=1 n=3 res=[2,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n < 2 {
		gold_fail(g, "insufficient items for pair grouping");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d > thresh {
			gold_fail(g, "pair difference exceeds threshold");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: pair variance exceeded");
			return out;
		}
		pairs++;
		i += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "grouped pairs count: ", pairs);
	out
}
@end
@entry 9b6b0682782e95eb
kind: step
verb: drop
noun: series
modifier: until
context: error
phrase: drop series prefix items until exceeding threshold {threshold}
phrase: prune series elements continuously until above limit {threshold}
slot: threshold int
test: list=2,4,10,12 threshold=8
expect: => i=2 r=0.0 ok=true s="series remaining count: 2" errors=0 n=2 res=[10,12] cache=0 hits=0
test: list=2,3,4 threshold=10
expect: => i=0 r=0.0 ok=false s="error: series exhausted" errors=1 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var idx = 0;
	while idx < g.n && g.res[idx] <= thresh {
		idx++;
	}
	if idx >= g.n {
		gold_fail(g, "series exhausted without reaching threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: series exhausted");
		return out;
	}
	let new_n = g.n - idx;
	for i in new_n {
		g.res[i] = g.res[i + idx];
	}
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "series remaining count: ", new_n);
	out
}
@end
