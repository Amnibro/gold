code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_even};
	var evens = 0;
	for i in g.n {
		let x = g.res[i];
		let is_even = if x < 0 { (-x) % 2 == 0 } else { x % 2 == 0 };
		if is_even {
			if x > limit {
				gold_fail(g, "even value exceeds specified upper limit");
				out.ok = false;
				out.s.clear();
				format(out.s, "error: even exceeds ceiling");
				return out;
			}
			evens++;
		}
	}
	out.i = evens;
	out.s.clear();
	format(out.s, "valid evens verified: ", evens);
	out
}
@end
