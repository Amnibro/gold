verb: arrange
noun: torch
modifier: wide
context: scene
phrase: arrange torch wide array pattern count {n}
phrase: replicate torch wide formation count {n}
phrase: clone torch wide elements count {n}
slot: n int
test: n=3 doc="ground box 0,0,-.5 20,20,1|stairs box 0,0,.5 2,4,1"
expect: => i=2 r=0.0 ok=true s="arrtorc" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: stairs box 0,0,.5 2,4,1 a3:2,0,0
test: n=5 doc="rock sphere -2,1,.4 r.4|lamp cyl 0,0,0 0,0,2 r.1"
expect: => i=2 r=0.0 ok=true s="arrtorc" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: lamp cyl 0,0,0 0,0,2 r.1 a5:2,0,0
test: n=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_arrange_torch_wide_alpha = 0;
	let n = ${n};
	if n <= 1 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no item yet"); out.ok = false; return out; }
	var o byte[>..] = [];
	o.append(" a");
	format(o, n);
	o.append(":2,0");
	o.append(",0");
	gold_dappend(g, k, o);
	out.i = g.dn + mark_arrange_torch_wide_alpha;
	out.s.clear();
	format(out.s, "arrtorc");
	out
}
@end
