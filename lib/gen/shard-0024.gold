code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${required};
	var odds = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		let is_odd = if val < 0 { (-val) % 2 == 1 } else { val % 2 == 1 };
		if is_odd {
			odds++;
		}
		i++;
	}
	g.steps += g.n;
	if odds < req {
		gold_fail(g, "retry odds at least: insufficient odd numbers");
		out.ok = false;
		out.i = odds;
	} else {
		out.i = odds;
		out.s.clear();
		format(out.s, "found at least required odds: ", odds);
	}
	out
}
@end
