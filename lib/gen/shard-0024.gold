fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var sum = 0;
	if g.n >= 3 {
		let mid = g.n / 2;
		var i = mid;
		var k = 0;
		while i < g.n && k < c {
			sum += g.res[i];
			i++;
			k++;
		}
		let last_val = g.res[g.n - 1];
		gold_push(g, sum + last_val);
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged middle sum: ", sum);
	out
}
@end
