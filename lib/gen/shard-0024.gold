@entry 0df359a7ad312ef3
kind: pred
verb: check
noun: results
modifier: pairwise
context: loop
phrase: check pairwise digit increase in results
phrase: verify adjacent digit results ascend pairwise
test: arg=1358,2468
expect: true
expect: true
test: arg=8531,2431
expect: false
expect: false
code:
fn ${ID}(n int) bool {
	var results_val = if n < 0 { -n } else { n };
	if results_val < 10 { return true; }
	var pairwise_prev = results_val % 10;
	results_val /= 10;
	while results_val > 0 {
		let pairwise_cur = results_val % 10;
		if pairwise_cur >= pairwise_prev { return false; }
		pairwise_prev = pairwise_cur;
		results_val /= 10;
	}
	true
}
@end
@entry 564b2a1c06f42474
kind: fn
verb: map
noun: errors
modifier: all
context: loop
phrase: map errors all faulty digits {bad_digit} blank
phrase: sanitize error digit {bad_digit} in loop
slot: bad_digit int
test: arg=1337,4050 bad_digit=3
expect: 17
expect: 4050
test: arg=8588,2981 bad_digit=8
expect: 5
expect: 291
code:
fn ${ID}(n int) int {
	let bad = ${bad_digit};
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var mul = 1;
	while x > 0 {
		let d = x % 10;
		if d != bad {
			res += d * mul;
			mul *= 10;
		}
		x /= 10;
	}
	if n < 0 { -res } else { res }
}
@end
@entry f645ab80ef28d36e
kind: fn
verb: keep
noun: runs
modifier: at_least
context: loop
phrase: keep runs at least length {min_run}
phrase: preserve repeated digit runs at least {min_run}
slot: min_run int
test: arg=11223,1234 min_run=2
expect: 1122
expect: 0
test: arg=55512,9999 min_run=3
expect: 555
expect: 9999
code:
fn ${ID}(n int) int {
	let mr = ${min_run};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return if mr <= 1 { n } else { 0 }; }
	var digits = [0; 32];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var out = 0;
	var i = len - 1;
	while i >= 0 {
		let d = digits[i];
		var run_len = 0;
		var j = i;
		while j >= 0 && digits[j] == d {
			run_len++;
			j--;
		}
		if run_len >= mr {
			for k in run_len { out = out * 10 + d; }
		}
		i = j;
	}
	if n < 0 { -out } else { out }
}
@end
@entry 410603f07521f095
kind: fn
verb: retry
noun: list
modifier: all
context: loop
phrase: retry list all odd digits transformed
phrase: process all odd digits in number sequence
test: arg=1234,579
expect: 2264
expect: 48
test: arg=2468,135
expect: 2468
expect: 260
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var mul = 1;
	while x > 0 {
		var d = x % 10;
		if d % 2 != 0 { d = (d * 2) % 10; }
		res += d * mul;
		mul *= 10;
		x /= 10;
	}
	if n < 0 { -res } else { res }
}
@end
