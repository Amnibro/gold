fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${stride} <= 0 {
		gold_fail(g, "stride must be positive");
		out.ok = false;
		return out;
	}
	var modified = 0;
	var i = 0;
	while i < g.n {
		g.res[i] *= 2;
		modified++;
		i += ${stride};
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "spaced modified ", modified, " items");
	out
}
@end
