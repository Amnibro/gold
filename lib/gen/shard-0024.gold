expect: => i=3 r=0.0 ok=true s="unique cached: 3" errors=0 n=4 res=[10,20,10,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			let mapped = ${f}(val);
			gold_cache_put(g, val, mapped);
			cached++;
		}
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "unique cached: ", cached);
	out
}
@end
