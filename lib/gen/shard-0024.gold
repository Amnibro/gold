slot: stop_val int
phrase: fill limit until sequence elements meet stop value {stop_val}
phrase: pad results incrementally halting before {stop_val}
test: list=1,2 stop_val=5
expect: => i=2 r=0.0 ok=true s="filled 2 items until stop" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20 stop_val=22
expect: => i=1 r=0.0 ok=true s="filled 1 items until stop" errors=0 n=3 res=[10,20,21] cache=0 hits=0
test: list=1 stop_val=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${stop_val} <= 0 {
		gold_fail(g, "stop value must be positive");
		out.ok = false;
		return out;
	}
	var cur = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	var added = 0;
	while cur + 1 < ${stop_val} && g.n < 16 {
		cur++;
		gold_push(g, cur);
		added++;
	}
	out.i = added;
	out.s.clear();
	format(out.s, "filled ", added, " items until stop");
	out
}
@end
@entry 3edbdbbfbe934837
kind: step
verb: cache
noun: range
modifier: running
context: aggregate
slot: scale int
phrase: cache range running calculating span between extremes times {scale}
phrase: store scaled list range into cache key using {scale}
test: list=5,12,3,25,8 scale=2
expect: => i=44 r=0.0 ok=true s="cached range value 44" errors=0 n=5 res=[5,12,3,25,8] cache=1 hits=0
test: list=10,30,50 scale=3
expect: => i=120 r=0.0 ok=true s="cached range value 120" errors=0 n=3 res=[10,30,50] cache=1 hits=0
test: list=1,2,3 scale=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${scale} <= 0 {
		gold_fail(g, "scale must be positive");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty range");
		return out;
	}
	var mn = g.res[0];
	var mx = g.res[0];
	for i in 1..g.n {
		let x = g.res[i];
		if x < mn { mn = x; }
		if x > mx { mx = x; }
	}
	let r = (mx - mn) * ${scale};
	gold_cache_put(g, 777, r);
	out.i = r;
	out.s.clear();
	format(out.s, "cached range value ", r);
	out
}
@end
