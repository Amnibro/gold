expect: => img: 32x32 min=0 max=1 sum8=130560 hash=968352
test: u=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 4 < 1 { gold_fail(g, "width must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 4) % 2) as real;
		}
	}
	var s2_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "mottle");
	out
}
@end
