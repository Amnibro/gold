expect: => i=1 r=0.0 ok=true s="running prime count across list: 1" errors=0 n=3 res=[9,10,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			primes++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "running prime count across list: ", primes);
	out
}
@end
