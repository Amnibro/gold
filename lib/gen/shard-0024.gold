	let r = ${rounds};
	var pairs = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] <= g.res[i + 1] {
			pairs[pn] = g.res[i];
			pn++;
			pairs[pn] = g.res[i + 1];
			pn++;
		}
		i++;
	}
	gold_clear(g);
	for round in r {
