test: list=2,2,2,2,3,3,4 cap=2
expect: => i=5 r=0.0 ok=true s="retained: 5" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,1,1,1,1 cap=1
expect: => i=2 r=0.0 ok=true s="retained: 2" errors=0 n=2 res=[5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_norm_streak_run_b334 = 0;
	let cp = ${cap};
	if g.n == 0 || cp <= 0 { return out; }
	var w = 0;
	var cur_val = g.res[0];
	var cur_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x == cur_val {
			cur_count++;
		} else {
			cur_val = x;
			cur_count = 1;
		}
		if cur_count <= cp {
			g.res[w] = x;
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	g.steps += dropped + mark_norm_streak_run_b334;
	out.i = w;
	out.s.clear();
	format(out.s, "retained: ", w);
	out
}
@end
