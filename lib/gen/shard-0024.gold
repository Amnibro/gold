fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let max_r = ${retries};
	var sum = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			sum += g.res[i];
		}
	}
	var r = 0;
	while sum > c && r < max_r {
		sum /= 2;
		r++;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded even sum: ", sum);
	out
}
@end
@entry c95e38e4643daca6
kind: step
verb: search
noun: limit
modifier: none
context: math
phrase: search limit threshold finding closest item to {target}
phrase: locate boundary limit matching target target {target}
slot: target int
test: list=10,25,40,70 target=30
expect: => i=25 r=0.0 ok=true s="closest limit item: 25" errors=0 n=4 res=[10,25,40,70] cache=0 hits=0
test: list=5,15,35 target=12
expect: => i=15 r=0.0 ok=true s="closest limit item: 15" errors=0 n=3 res=[5,15,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 { return out; }
	var best_val = g.res[0];
	var best_diff = g.res[0] - tgt;
	if best_diff < 0 { best_diff = -best_diff; }
	for i in 1..g.n {
		var diff = g.res[i] - tgt;
		if diff < 0 { diff = -diff; }
		if diff < best_diff {
			best_diff = diff;
			best_val = g.res[i];
		}
	}
	out.i = best_val;
	out.s.clear();
	format(out.s, "closest limit item: ", best_val);
	out
}
@end
