@entry 55f3ffd142d49cac
kind: step
verb: drop
noun: items
modifier: running
context: stats
phrase: drop items with running value exceeding {cutoff}
phrase: discard running sample values greater than {cutoff}
slot: cutoff int
test: list=10,40,15,50,20 cutoff=30
expect: => i=2 r=0.0 ok=true s="dropped running: 2" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=5,12,8,25,14 cutoff=10
expect: => i=3 r=0.0 ok=true s="dropped running: 3" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] <= cut {
			g.res[kept] = g.res[i];
			kept++;
		} else {
			dropped++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped running: ", dropped);
	out
}
@end
@entry c3c6c60dc0099cc9
kind: step
verb: fill
noun: maximum
modifier: in_reverse
context: stats
phrase: fill running maximum values across samples in reverse
phrase: compute reverse cumulative maximum across observation series
test: list=10,40,25,35,15
expect: => i=40 r=0.0 ok=true s="reverse max: 40" errors=0 n=5 res=[40,40,35,35,15] cache=0 hits=0
test: list=5,12,8,20,18
expect: => i=20 r=0.0 ok=true s="reverse max: 20" errors=0 n=5 res=[20,20,20,20,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_max = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
		g.res[i] = cur_max;
		i--;
	}
	out.i = cur_max;
	out.s.clear();
	format(out.s, "reverse max: ", cur_max);
	out
}
@end
@entry ede5260c4a3a2355
kind: step
verb: fill
noun: average
modifier: any
context: stats
phrase: fill below average sample values with series mean
phrase: replace observations under mean with sample average
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="filled average: 2" errors=0 n=4 res=[25,25,30,40] cache=0 hits=0
test: list=2,18,4,16,10
expect: => i=2 r=0.0 ok=true s="filled average: 2" errors=0 n=5 res=[10,18,10,16,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var filled = 0;
	for i in g.n {
		if g.res[i] < avg {
			g.res[i] = avg;
			filled++;
		}
	}
	out.i = filled;
	out.s.clear();
	format(out.s, "filled average: ", filled);
	out
}
@end
@entry 718078dd520376ac
kind: step
verb: limit
noun: window
modifier: none
context: stats
phrase: limit rolling sample window spread across series
phrase: calculate rolling window range across observation sequence
test: list=10,15,12,20,25,18
expect: => i=13 r=0.0 ok=true s="window max range: 13" errors=0 n=4 res=[5,8,13,7] cache=0 hits=0
test: list=40,50,45,60,70,65
expect: => i=25 r=0.0 ok=true s="window max range: 25" errors=0 n=4 res=[10,15,25,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	var ranges = [0; 512];
	var count = 0;
	var max_range = 0;
	for i in g.n - 2 {
		var mn = g.res[i];
		var mx = g.res[i];
		for j in 3 {
			let val = g.res[i + j];
			if val < mn { mn = val; }
			if val > mx { mx = val; }
		}
		let r = mx - mn;
		ranges[count] = r;
		count++;
		if r > max_range { max_range = r; }
	}
	for i in count { g.res[i] = ranges[i]; }
	g.n = count;
	out.i = max_range;
	out.s.clear();
	format(out.s, "window max range: ", max_range);
	out
}
@end
