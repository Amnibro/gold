fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == val {
				seen = true;
				break;
