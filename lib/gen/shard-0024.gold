@entry 4c3a813495888603
kind: step
verb: fold
noun: streak
modifier: at_most
context: filter
phrase: fold streak at most span limit {max_run}
phrase: accumulate streak at most length bound {max_run}
slot: max_run int
test: list=2,2,2,2,3,3 max_run=3
expect: => i=6 r=0.0 ok=true s="folded streak sum: 6" errors=0 n=6 res=[2,2,2,2,3,3] cache=0 hits=0
test: list=7,7,7,7,7 max_run=2
expect: => i=14 r=0.0 ok=true s="folded streak sum: 14" errors=0 n=5 res=[7,7,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_run};
	var best_val = 0;
	var best_len = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run = 0;
		while i + run < g.n && g.res[i + run] == val {
			run++;
		}
		if run > best_len {
			best_len = run;
			best_val = val;
		}
		i += run;
	}
	var take = best_len;
	if take > mr { take = mr; }
	let sum = best_val * take;
	g.steps += best_len;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded streak sum: ", sum);
	out
}
@end
