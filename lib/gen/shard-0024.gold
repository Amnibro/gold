@entry cdceba4ddfa31677
kind: step
verb: check
noun: streak
modifier: unique
context: aggregate
slot: min_len int
phrase: check presence of unique streak of length at least {min_len}
phrase: detect distinct unbroken sequence of span at least {min_len}
test: list=1,2,2,2,3 min_len=3
expect: => i=3 r=0.0 ok=true s="longest streak length 3" errors=0 n=5 res=[1,2,2,2,3] cache=0 hits=0
test: list=5,5,6,7 min_len=2
expect: => i=2 r=0.0 ok=true s="longest streak length 2" errors=0 n=4 res=[5,5,6,7] cache=0 hits=0
test: list=1,2 min_len=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min_len} <= 0 {
		gold_fail(g, "min length must be positive");
		out.ok = false;
		return out;
	}
	var cur_len = 1;
	var max_len = if g.n > 0 { 1 } else { 0 };
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
			if cur_len > max_len { max_len = cur_len; }
		} else {
			cur_len = 1;
		}
		i++;
	}
	let found = max_len >= ${min_len};
	out.ok = found;
	out.i = max_len;
	out.s.clear();
	format(out.s, "longest streak length ", max_len);
	out
}
@end
