expect: => i=4 r=0.0 ok=true s="extended sequence length: 4" errors=0 n=4 res=[10,20,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${target_len};
	var gaps = [0; 512];
	var gn = 0;
	var i = 0;
	while i + 1 < g.n {
		gaps[gn] = g.res[i + 1] - g.res[i];
		gn++;
		i++;
	}
	if gn == 0 {
		gold_push(g, 0);
	} else {
		var k = 0;
		while g.n < tl && k < 100 {
			gold_push(g, gaps[k % gn]);
			k++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "extended sequence length: ", g.n);
	out
}
@end
