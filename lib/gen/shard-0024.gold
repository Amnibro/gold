code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	while count < g.n && ${p}(g.res[count]) {
		sum += g.res[count];
		count++;
	}
	g.steps += count + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded prefix sum: ", sum);
	out
}
@end
