@entry 23fe7ef46cf3f980
kind: step
verb: repeat
noun: prefix
modifier: between
context: math
phrase: repeat prefix segment between list bounds multiple times {length} {times}
phrase: replicate leading prefix slice bounded by parameters {length} {times}
slot: length int
slot: times int
test: list=1,2,3,4 length=2 times=2
expect: => i=6 r=0.0 ok=true s="expanded prefix size: 6" errors=0 n=6 res=[1,2,1,2,3,4] cache=0 hits=0
test: list=10,20,30 length=1 times=3
expect: => i=5 r=0.0 ok=true s="expanded prefix size: 5" errors=0 n=5 res=[10,10,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${length};
	let tm = ${times};
	let pref_len = if len < g.n { len } else { g.n };
	var buf = [0; 512];
	var bn = 0;
	for rep in tm {
		for i in pref_len {
			if bn < 512 {
				buf[bn] = g.res[i];
				bn++;
			}
		}
	}
	for i in pref_len..g.n {
		if bn < 512 {
			buf[bn] = g.res[i];
			bn++;
		}
	}
	g.n = 0;
	for k in bn { gold_push(g, buf[k]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "expanded prefix size: ", bn);
	out
}
@end
@entry 476ec54cb4401306
kind: step
verb: dedupe
noun: runs
modifier: any
context: math
phrase: dedupe repetitive runs across any position allowing streak {max_streak}
phrase: truncate consecutive runs at any location to streak {max_streak}
slot: max_streak int
test: list=2,2,2,2,3,3,4 max_streak=2
expect: => i=5 r=0.0 ok=true s="deduped runs count: 5" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,5,5 max_streak=1
expect: => i=1 r=0.0 ok=true s="deduped runs count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	if ms <= 0 { g.n = 0; return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let take = if run_len > ms { ms } else { run_len };
		for k in take {
			g.res[kept] = g.res[i];
			kept++;
		}
		i = j;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped runs count: ", kept);
	out
}
@end
