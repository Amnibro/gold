fn ${ID}(n int) int {
	let l = ${lo};
	let h = ${hi};
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	var count = 0;
	while x > 0 {
		let d = x % 10;
		if d >= l && d <= h {
			sum += d;
			count++;
		}
		x /= 10;
	}
	if count == 0 { 0 } else { sum / count }
}
@end
