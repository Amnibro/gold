code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	var valid = true;
	var checked = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > limit {
			break;
		}
		if i > 0 && g.res[i] <= g.res[i - 1] {
			valid = false;
			break;
		}
		checked++;
		i++;
	}
	g.steps += i;
	if !valid {
		gold_fail(g, "check series up to: non-increasing order");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = checked;
		out.s.clear();
		format(out.s, "valid increasing series up to count: ", checked);
	}
	out
}
@end
