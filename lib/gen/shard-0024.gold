fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		total_digits += s;
		i += 2;
	}
	out.i = total_digits;
	out.s.clear();
	format(out.s, "alternate digits sum: ", total_digits);
	out
}
@end
