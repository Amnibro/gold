@entry 5d8a45c264ce1ef6
kind: step
verb: fold
noun: primes
modifier: nested
context: math
phrase: fold prime elements across nested factors modulo {modulus}
phrase: accumulate prime factors in nested passes with modulus {modulus}
slot: modulus int
test: list=2,3,4,5,6,7 modulus=100
expect: => i=10 r=0.0 ok=true s="primes folded: 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=11,13,15 modulus=50
expect: => i=43 r=0.0 ok=true s="primes folded: 2" errors=0 n=3 res=[11,13,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	var prod = 1;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				prod = (prod * (x % m)) % m;
				count++;
			}
		}
	}
	out.i = prod;
	out.s.clear();
	format(out.s, "primes folded: ", count);
	out
}
@end
@entry 23cbef99cfec9bf9
kind: step
verb: filter
noun: counter
modifier: with_retry
context: math
phrase: filter counter occurrences using retry limit {attempts}
phrase: sift counter frequencies allowing up to {attempts} retries
slot: attempts int
test: list=3,3,3,2,2,1 attempts=2
expect: => i=3 r=0.0 ok=true s="filtered items: 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=5,5,6,7 attempts=1
expect: => i=2 r=0.0 ok=true s="filtered items: 2" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var threshold = 3;
	var pass_count = 0;
	var attempt = 0;
	while attempt <= max_att {
		pass_count = 0;
		for i in g.n {
			var freq = 0;
			for j in g.n {
				if g.res[j] == g.res[i] { freq++; }
			}
			if freq >= threshold { pass_count++; }
		}
		if pass_count > 0 || threshold <= 1 { break; }
		threshold--;
		attempt++;
	}
	var kept = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq >= threshold {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered items: ", kept);
	out
}
@end
