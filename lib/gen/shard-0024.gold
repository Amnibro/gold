phrase: invert cache in place limit {limit}
slot: limit int
test: list=10,20 limit=3
expect: => i=3 r=0.0 ok=true s="cache reversed: 3" errors=0 n=2 res=[10,20] cache=3 hits=0
test: list=5 limit=2
expect: => i=2 r=0.0 ok=true s="cache reversed: 2" errors=0 n=1 res=[5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	gold_cache_put(g, 1, 10);
	gold_cache_put(g, 2, 20);
	gold_cache_put(g, 3, 30);
	var k = lim;
	if k > g.cn { k = g.cn; }
	var l = 0;
	var r = k - 1;
	while l < r {
		let tk = g.ck[l];
		let tv = g.cv[l];
		g.ck[l] = g.ck[r];
		g.cv[l] = g.cv[r];
		g.ck[r] = tk;
		g.cv[r] = tv;
		l++;
		r--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "cache reversed: ", k);
	out
}
@end
