code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var word_count = 0;
	var score = 0;
	var in_word = false;
	var cur_len = 0;
	for b in out.s {
		if b == ' ' {
			if in_word {
				score += cur_len;
				word_count++;
				cur_len = 0;
				in_word = false;
				if score >= tg { break; }
			}
		} else {
			in_word = true;
			cur_len++;
		}
	}
	if in_word && score < tg {
		score += cur_len;
		word_count++;
	}
	g.steps += word_count;
	out.i = score;
	out.s.clear();
	format(out.s, "words evaluated: ", word_count);
	out
}
@end
