	if !gold_img_ok(g) { res_emboss_bark_layered.ok = false; return res_emboss_bark_layered; }
	var c0_emboss_bark_layered = 8;
	for o_emboss_bark_layered in 2 { if !gold_img_square(g, c0_emboss_bark_layered) { res_emboss_bark_layered.ok = false; return res_emboss_bark_layered; } c0_emboss_bark_layered = c0_emboss_bark_layered / 2; }
	for y_emboss_bark_layered in g.ih {
		for x_emboss_bark_layered in g.iw {
			var t_emboss_bark_layered = 0.0;
			var amp_emboss_bark_layered = 1.0;
			var norm_emboss_bark_layered = 0.0;
			var cc_emboss_bark_layered = 8;
			for o_emboss_bark_layered in 2 { t_emboss_bark_layered += amp_emboss_bark_layered * gold_vnoise(x_emboss_bark_layered, y_emboss_bark_layered, cc_emboss_bark_layered, g.iw / cc_emboss_bark_layered, ${u} + o_emboss_bark_layered); norm_emboss_bark_layered += amp_emboss_bark_layered; amp_emboss_bark_layered *= 0.5; cc_emboss_bark_layered = cc_emboss_bark_layered / 2; }
			g.img[y_emboss_bark_layered * g.iw + x_emboss_bark_layered] = t_emboss_bark_layered / norm_emboss_bark_layered;
		}
	}
	for k_emboss_bark_layered in g.iw * g.ih { g.img[k_emboss_bark_layered] = gold_clamp01((g.img[k_emboss_bark_layered] - 0.5) * 1.4 + 0.5); }
	res_emboss_bark_layered.i = g.iw * g.ih;
	res_emboss_bark_layered.s.clear();
	format(res_emboss_bark_layered.s, "bark");
	res_emboss_bark_layered
}
@end
