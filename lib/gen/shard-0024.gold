fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_light_light_looping_alpha = 0;
	let w = ${w};
	if w <= 0.0 { gold_fail(g, "invalid power"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "li_lt", "", o);
	o.append(" light point 0,0,");
	o.append("2.5 w");
	gold_fnum(o, w);
	o.append(" #ffeedd");
	gold_doc(g, o);
	out.i = g.dn + mark_light_light_looping_alpha;
	out.s.clear();
	format(out.s, "ltligh");
	out
}
@end
