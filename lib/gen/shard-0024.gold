context: loop
slot: threshold int
phrase: drop checkpoint sorted below cutoff {threshold}
phrase: discard checkpoint values sorted under {threshold}
test: list=50,10,30,5 threshold=20
expect: => i=2 r=0.0 ok=true s="sorted checkpoints retained: 2" errors=0 n=2 res=[30,50] cache=0 hits=0
test: list=40,20,10 threshold=15
expect: => i=2 r=0.0 ok=true s="sorted checkpoints retained: 2" errors=0 n=2 res=[20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if g.res[i] >= th {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	for i in kn {
		for j in kn - 1 {
			if kept[j] > kept[j + 1] {
				let tmp = kept[j];
				kept[j] = kept[j + 1];
				kept[j + 1] = tmp;
			}
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "sorted checkpoints retained: ", kn);
	out
}
@end
