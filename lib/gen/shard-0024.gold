noun: budget
modifier: first
context: math
phrase: dedupe budget retaining unique values until exhaustion {budget}
phrase: eliminate duplicates while cumulative sum respects budget {budget}
slot: budget int
test: list=5,5,10,10,20,30 budget=25
expect: => i=15 r=0.0 ok=true s="budget spent: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,2,3,4,4,1 budget=8
expect: => i=5 r=0.0 ok=true s="budget spent: 5" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			if spent + x <= b {
				spent += x;
				g.res[kept] = x;
				kept++;
			} else {
				break;
			}
		}
	}
	g.n = kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent: ", spent);
	out
}
@end
