code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0_1 = 4;
	for o in 2 { if !gold_img_square(g, c0_1) { out.ok = false; return out; } c0_1 = c0_1 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s2_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "mottle");
	out
}
@end
