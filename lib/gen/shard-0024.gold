fn ${ID}(g Gold&, v Val) Val {
	var res_layer_tiles_worn = v;
	if !gold_img_ok(g) { res_layer_tiles_worn.ok = false; return res_layer_tiles_worn; }
	if ${c} < 1 { gold_fail(g, "cell must be positive"); res_layer_tiles_worn.ok = false; return res_layer_tiles_worn; }
	for y_layer_tiles_worn in g.ih {
		for x_layer_tiles_worn in g.iw {
			g.img[y_layer_tiles_worn * g.iw + x_layer_tiles_worn] = ((x_layer_tiles_worn / ${c} + y_layer_tiles_worn / ${c}) % 2) as real;
		}
	}
	var s_layer_tiles_worn = g.img;
	for y_layer_tiles_worn in g.ih {
		for x_layer_tiles_worn in g.iw {
			var t_layer_tiles_worn = 0.0;
			for dy_layer_tiles_worn in 3 { for dx_layer_tiles_worn in 3 { t_layer_tiles_worn += gold_img_wrap(g, x_layer_tiles_worn + dx_layer_tiles_worn - 1, y_layer_tiles_worn + dy_layer_tiles_worn - 1); } }
			s_layer_tiles_worn[y_layer_tiles_worn * g.iw + x_layer_tiles_worn] = t_layer_tiles_worn / 9.0;
		}
	}
	g.img = s_layer_tiles_worn;
	res_layer_tiles_worn.i = g.iw * g.ih;
	res_layer_tiles_worn.s.clear();
	format(res_layer_tiles_worn.s, "tiles");
	res_layer_tiles_worn
}
@end
