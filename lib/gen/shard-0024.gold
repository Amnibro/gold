@entry 9786df0658440e2c
kind: step
verb: run
noun: head
modifier: sorted
context: error
phrase: run head prefix sorting first {head_count} items
phrase: sort initial head segment of length {head_count}
slot: head_count int
test: list=5,3,8,1 head_count=3
expect: => i=3 r=0.0 ok=true s="head sorted minimum: 3" errors=0 n=4 res=[3,5,8,1] cache=0 hits=0
test: list=5,3 head_count=10
expect: => i=0 r=0.0 ok=false s="error: invalid head count" errors=1 n=2 res=[5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${head_count};
	if k <= 0 || k > g.n {
		gold_fail(g, "head count out of valid range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid head count");
		return out;
	}
	var i = 0;
	while i < k {
		var j = i + 1;
		while j < k {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "head sorted minimum: ", g.res[0]);
	out
}
@end
