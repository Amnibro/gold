noun: budget
modifier: last
context: aggregate
slot: budget int
phrase: reverse trailing items fitting within sum budget {budget}
phrase: invert tail elements bounded by accumulator budget {budget}
test: list=10,20,5,3,2 budget=12
expect: => i=3 r=0.0 ok=true s="reversed 3 budget items" errors=0 n=5 res=[10,20,2,3,5] cache=0 hits=0
test: list=1,2,3,4 budget=8
expect: => i=2 r=0.0 ok=true s="reversed 2 budget items" errors=0 n=4 res=[1,2,4,3] cache=0 hits=0
test: list=1,2 budget=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${budget} <= 0 {
		gold_fail(g, "budget must be positive");
		out.ok = false;
		return out;
	}
	var s = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if s + g.res[i] <= ${budget} {
			s += g.res[i];
			count++;
			i--;
		} else {
			break;
		}
	}
	let start = g.n - count;
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " budget items");
	out
}
@end
