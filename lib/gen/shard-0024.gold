phrase: reverse runs at most length {max_len}
phrase: invert sample runs if at most size {max_len}
test: list=1,2,3,4 max_len=5
expect: => i=4 r=0.0 ok=true s="reversed runs at most length: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30 max_len=2
expect: => i=0 r=0.0 ok=true s="reversed runs at most length: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var reversed = 0;
	if g.n <= lim {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
		reversed = g.n;
	}
	g.steps += g.n;
	out.i = reversed;
	out.s.clear();
	format(out.s, "reversed runs at most length: ", reversed);
	out
}
@end
