fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${mark} < 0 {
		gold_fail(g, "checkpoint mark must be non-negative");
		out.ok = false;
		return out;
	}
	var distinct_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= ${mark} {
			var first_time = true;
			for j in i { if g.res[j] == x { first_time = false; break; } }
			if first_time { distinct_count++; }
		}
	}
	out.i = distinct_count;
	out.s.clear();
	format(out.s, "found ", distinct_count, " unique items past checkpoint");
	out
}
@end
