	for o in 2 { if !gold_img_square(g, c0_1) { out.ok = false; return out; } c0_1 = c0_1 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.3); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stain");
	out
}
@end
