expect: 1098
expect: 23
code:
fn ${ID}(n int) int {
	var x = abs(n);
	var rev = 0;
	while x > 0 { rev = rev * 10 + (x % 10); x /= 10; }
	if n < 0 { return 0 - rev; }
	rev
}
@end
