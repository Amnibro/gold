fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${limit} < 0 {
		gold_fail(g, "limit must be non negative");
		out.ok = false;
		return out;
	}
	var count = 0;
	var j = 0;
	for i in g.n {
		if g.res[i] > 0 && count < ${limit} {
			g.res[j] = g.res[i];
			j++;
			count++;
		}
	}
	g.n = j;
	out.i = count;
	out.s.clear();
	format(out.s, "selected tally ", count);
	out
}
