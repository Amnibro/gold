@entry 9626f14d55a9a083
kind: fn
verb: merge
noun: memo
modifier: recursively
context: stats
phrase: recursive digit sum bounded by depth {depth}
phrase: iterative digital root step limit {depth}
slot: depth int
test: arg=987,99,5 depth=1
expect: 24
expect: 18
expect: 5
test: arg=987,99 depth=2
expect: 6
expect: 9
code:
fn ${ID}(n int) int {
	let d = ${depth};
	var x = abs(n);
	var step = 0;
	while x >= 10 && step < d {
		var s = 0;
		var t = x;
		while t > 0 { s += t % 10; t /= 10; }
		x = s;
		step++;
	}
	x
}
@end
