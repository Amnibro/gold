test: list=1,2,3,4,5,6,7 cap=3
expect: => i=3 r=0.0 ok=true s="tail limited to 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
test: list=10,20,30 cap=5
expect: => i=3 r=0.0 ok=true s="tail limited to 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=1,2,3 cap=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${cap} <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		return out;
	}
	if g.n > ${cap} {
		let start = g.n - ${cap};
		for i in ${cap} {
			g.res[i] = g.res[start + i];
		}
		g.n = ${cap};
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail limited to ", g.n);
	out
}
@end
@entry 7cef0451fb64fe29
kind: step
verb: find
noun: window
modifier: recursively
context: aggregate
slot: span int
phrase: find window recursively locating maximum sum of span {span}
phrase: search recursive sliding window of width {span}
test: list=1,4,2,8,5,1 span=3
expect: => i=15 r=0.0 ok=true s="max window sum 15" errors=0 n=6 res=[1,4,2,8,5,1] cache=0 hits=0
test: list=10,20,5,30,2 span=2
expect: => i=35 r=0.0 ok=true s="max window sum 35" errors=0 n=5 res=[10,20,5,30,2] cache=0 hits=0
test: list=1,2 span=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${span} <= 0 || ${span} > g.n {
		gold_fail(g, "window span out of range");
		out.ok = false;
		return out;
	}
	var best_sum = 0;
	for k in ${span} { best_sum += g.res[k]; }
	var cur = best_sum;
	for i in 1..(g.n - ${span} + 1) {
		cur = cur - g.res[i - 1] + g.res[i + ${span} - 1];
		if cur > best_sum { best_sum = cur; }
	}
	out.i = best_sum;
	out.s.clear();
	format(out.s, "max window sum ", best_sum);
	out
}
@end
