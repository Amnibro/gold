@entry 7e8d75746b32d209
kind: step
verb: map
noun: window
modifier: in_place
context: stats
slot: window_size int
phrase: map window in place with span {window_size}
phrase: smooth sample window in place using span {window_size}
test: list=10,20,30,40 window_size=2
expect: => i=3 r=0.0 ok=true s="mapped moving window in place count: 3" errors=0 n=4 res=[15,25,35,40] cache=0 hits=0
test: list=6,12,18 window_size=3
expect: => i=1 r=0.0 ok=true s="mapped moving window in place count: 1" errors=0 n=3 res=[12,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window_size};
	if w <= 1 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var i = 0;
	while i + w <= g.n {
		var sum = 0;
		var j = 0;
		while j < w {
			sum += g.res[i + j];
			j++;
		}
		g.res[i] = sum / w;
		i++;
	}
	g.steps += i;
	out.i = i;
	out.s.clear();
	format(out.s, "mapped moving window in place count: ", i);
	out
}
@end
