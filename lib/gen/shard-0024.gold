fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${mult} <= 0 {
		gold_fail(g, "multiplier must be positive");
		out.ok = false;
		return out;
	}
	var total_streak_score = 0;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			if cur_run > 1 { total_streak_score += cur_run * ${mult}; }
			cur_run = 1;
		}
	}
	if cur_run > 1 { total_streak_score += cur_run * ${mult}; }
	out.i = total_streak_score;
	out.s.clear();
	format(out.s, "streak multiplied score ", total_streak_score);
	out
}
@end
