fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var cur = g.res[g.n - 1];
	var passes = 0;
	while cur < b && passes < 10 {
		cur *= 2;
		passes++;
	}
	g.res[g.n - 1] = cur;
	g.steps += passes;
	out.i = cur;
	out.s.clear();
	format(out.s, "last scaled: ", cur);
	out
}
