expect: => i=2 r=0.0 ok=true s="matched pairs: 2" errors=0 n=5 res=[10,12,15,30,50] cache=0 hits=0
test: list=5,6,8,9,11 thresh=2
expect: => i=2 r=0.0 ok=true s="matched pairs: 2" errors=0 n=5 res=[5,6,8,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var matched = 0;
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff >= th { matched++; }
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "matched pairs: ", matched);
	out
}
@end
@entry 0bce08d504be0975
kind: step
verb: group
noun: numbers
modifier: sorted
context: stats
phrase: group sorted sample numbers into frequency bins of {step}
phrase: bin sorted observation values with interval size {step}
slot: step int
test: list=15,3,22,8,11,35 step=10
expect: => i=4 r=0.0 ok=true s="sorted bins: 4" errors=0 n=4 res=[2,2,1,1] cache=0 hits=0
test: list=5,2,8,14,19,11 step=5
expect: => i=4 r=0.0 ok=true s="sorted bins: 4" errors=0 n=4 res=[1,2,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	if g.n == 0 || st <= 0 { return out; }
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var bin_counts = [0; 512];
	var bins = 0;
	var cur_bin = g.res[0] / st;
	var cur_count = 0;
	for i in g.n {
		let b = g.res[i] / st;
		if b == cur_bin {
			cur_count++;
		} else {
			bin_counts[bins] = cur_count;
			bins++;
			cur_bin = b;
			cur_count = 1;
		}
	}
	bin_counts[bins] = cur_count;
	bins++;
	for i in bins { g.res[i] = bin_counts[i]; }
	g.n = bins;
	out.i = bins;
	out.s.clear();
	format(out.s, "sorted bins: ", bins);
	out
}
@end
