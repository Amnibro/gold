kind: step
verb: swap
noun: counter
modifier: with_cache
context: list
phrase: swap counter with cache offset {delta}
phrase: exchange counter with cache delta {delta}
slot: delta int
test: list=10,20 delta=5
expect: => i=2 r=0.0 ok=true s="swapped with cache count: 2" errors=0 n=2 res=[105,205] cache=2 hits=2
test: list=1,2 delta=3
expect: => i=2 r=0.0 ok=true s="swapped with cache count: 2" errors=0 n=2 res=[103,203] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	gold_cache_put(g, 1, 100);
	gold_cache_put(g, 2, 200);
	var count = 0;
	for i in g.n {
		let key = i + 1;
		let val, ok = gold_cache_get(g, key);
		if ok {
			let old = g.res[i];
			g.res[i] = val + d;
			gold_cache_put(g, key, old);
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped with cache count: ", count);
	out
}
@end
@entry 7b57317d4406caa5
kind: step
verb: reverse
noun: checkpoint
modifier: until
context: list
phrase: reverse checkpoint until target value {target}
phrase: invert checkpoint until target value {target}
slot: target int
test: list=1,2,3,4,5 target=3
expect: => i=2 r=0.0 ok=true s="checkpoint index: 2" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 target=40
expect: => i=3 r=0.0 ok=true s="checkpoint index: 3" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var end_idx = -1;
	for i in g.n {
		if g.res[i] == tg {
			end_idx = i;
			break;
		}
	}
	if end_idx >= 0 {
		var l = 0;
		var r = end_idx;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n;
	out.i = end_idx;
	out.s.clear();
	format(out.s, "checkpoint index: ", end_idx);
	out
}
@end
