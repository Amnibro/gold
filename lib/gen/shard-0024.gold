fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = [0; 512];
	var evens = [0; 512];
	var no = 0;
	var ne = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[no] = g.res[i];
			no++;
		} else {
			evens[ne] = g.res[i];
			ne++;
		}
	}
	for i in no { g.res[i] = odds[i]; }
	for i in ne { g.res[no + i] = evens[i]; }
	out.i = ne;
	out.s.clear();
	format(out.s, "evens last count: ", ne);
	out
}
@end
