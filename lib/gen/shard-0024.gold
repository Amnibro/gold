code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_gap = 0;
	for i in g.n - 1 {
		var gap = g.res[i + 1] - g.res[i];
		if gap < 0 { gap = -gap; }
		if gap > max_gap { max_gap = gap; }
		g.res[i] = gap;
	}
	g.n = g.n - 1;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap: ", max_gap);
	out
}
@end
