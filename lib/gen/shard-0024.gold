code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	for i in g.n {
		if g.res[i] < lo { g.res[i] = lo; }
		else if g.res[i] > hi { g.res[i] = hi; }
	}
	for p in g.n {
		for q in 0..(g.n - 1) {
			if g.res[q] > g.res[q + 1] {
				let tmp = g.res[q];
				g.res[q] = g.res[q + 1];
				g.res[q + 1] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped and sorted: ", g.n);
	out
}
@end
