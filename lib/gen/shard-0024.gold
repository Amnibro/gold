fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n <= 1 { return out; }
	let c = if k < g.n { k } else { g.n };
	for p in g.n {
		for q in 0..(g.n - 1) {
			if g.res[q] > g.res[q + 1] {
				let tmp = g.res[q];
				g.res[q] = g.res[q + 1];
				g.res[q + 1] = tmp;
