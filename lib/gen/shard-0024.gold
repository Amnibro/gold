test: arg=50,30
expect: 100
expect: 80
test: arg=160
expect: 0
code:
fn ${ID}(n int) int {
	var target = 50;
	var diff = n - target;
	if diff < 0 {
		diff = 0 - diff;
	}
	var score = 100 - diff;
	if score < 0 {
		score = 0;
	}
	return score;
}
@end
