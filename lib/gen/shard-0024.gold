code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "select function safely: empty sample");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let applied = ${f}(g.res[mid]);
	gold_push(g, applied);
	g.steps += 1;
	out.i = applied;
	out.s.clear();
	format(out.s, "applied function safely to median: ", applied);
	out
}
@end
