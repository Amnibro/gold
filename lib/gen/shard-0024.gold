phrase: evaluate step in reverse factor {scale}
slot: scale int
test: list=1,4,10 scale=2
expect: => i=18 r=0.0 ok=true s="reverse measured steps: 18" errors=0 n=3 res=[1,4,10] cache=0 hits=0
test: list=2,8,20 scale=1
expect: => i=18 r=0.0 ok=true s="reverse measured steps: 18" errors=0 n=3 res=[2,8,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var sum = 0;
	var idx = g.n - 1;
	var count = 0;
	while idx > 0 {
		sum += (g.res[idx] - g.res[idx - 1]) * sc;
		count++;
		idx--;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "reverse measured steps: ", sum);
	out
}
@end
