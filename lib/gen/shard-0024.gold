kind: step
verb: rank
noun: primes
modifier: in_place
context: filter
phrase: rank primes in place ordering mode {ascending}
phrase: sort primes in place sequence flag {ascending}
slot: ascending int
test: list=4,7,2,9,5,11 ascending=1
expect: => i=4 r=0.0 ok=true s="sorted prime elements: 4" errors=0 n=4 res=[2,5,7,11] cache=0 hits=0
test: list=13,2,17,8 ascending=0
expect: => i=3 r=0.0 ok=true s="sorted prime elements: 3" errors=0 n=3 res=[17,13,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let asc = ${ascending};
	var primes = [0; 512];
	var pn = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		}
	}
	var p = 0;
	while p < pn {
		var q = 0;
		while q + 1 < pn {
			var swap = false;
			if asc > 0 && primes[q] > primes[q + 1] { swap = true; }
			if asc <= 0 && primes[q] < primes[q + 1] { swap = true; }
			if swap {
				let t = primes[q];
				primes[q] = primes[q + 1];
				primes[q + 1] = t;
			}
			q++;
		}
		p++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "sorted prime elements: ", pn);
	out
}
@end
