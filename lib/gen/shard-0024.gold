code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_drop_min_times_b334 = 0;
	let c = ${count};
	if g.n == 0 || c <= 0 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var dropped = 0;
	var w = 0;
	for i in g.n {
		if g.res[i] == min_val && dropped < c {
			dropped++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += dropped + mark_drop_min_times_b334;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped: ", dropped);
	out
}
@end
