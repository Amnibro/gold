code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 || g.n < w {
		gold_fail(g, "window width invalid");
		out.ok = false;
		return out;
	}
	var count = g.n - w + 1;
	for i in count {
		var sum = 0;
		for j in w { sum += g.res[i + j]; }
		gold_cache_put(g, i, sum);
	}
	out.i = count;
	out.s.clear();
	format(out.s, "windows cached: ", count);
	out
}
@end
