@entry 04bc95584f96fc0b
kind: step
verb: normalize
noun: step
modifier: sorted
context: stats
phrase: normalize step sorted cumulative distribution
phrase: sort sample observations to normalized steps
test: list=15,5,25,10
expect: => i=20 r=0.0 ok=true s="norm max: 20" errors=0 n=4 res=[0,5,10,20] cache=0 hits=0
test: list=40,20,30
expect: => i=20 r=0.0 ok=true s="norm max: 20" errors=0 n=3 res=[0,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "norm steps: 0");
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let min_v = g.res[0];
	for k in g.n { g.res[k] -= min_v; }
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "norm max: ", out.i);
	out
}
@end
