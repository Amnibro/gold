code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 {
		gold_fail(g, "window must be positive");
		out.ok = false;
		return out;
	}
	var sums = [0; 512];
	var sn = 0;
	var i = 0;
	while i < g.n {
		var cur = 0;
		var k = 0;
		while k < w && i + k < g.n {
			cur += g.res[i + k];
			k++;
		}
		sums[sn] = cur;
		sn++;
		i += w;
	}
	gold_clear(g);
	for k in sn { gold_push(g, sums[k]); }
	g.steps += sn;
	out.i = sn;
	out.s.clear();
	format(out.s, "partitioned series sums: ", sn);
	out
}
@end
