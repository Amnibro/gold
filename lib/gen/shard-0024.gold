code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${tail_val} < 0 {
		gold_fail(g, "tail value must be non-negative");
		out.ok = false;
		return out;
	}
	let original_n = g.n;
	if g.n < 5 {
		while g.n < 5 {
			gold_push(g, ${tail_val});
		}
	}
	let added = g.n - original_n;
	out.i = added;
	out.s.clear();
	format(out.s, "padded ", added, " suffix elements");
	out
}
@end
