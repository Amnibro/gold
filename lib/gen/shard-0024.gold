expect: => i=1 r=0.0 ok=true s="suffix items: 1" errors=0 n=3 res=[5,15,26] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_run_sfx_retry_b334 = 0;
	let st = ${start};
	if st < 0 || st >= g.n { return out; }
	var count = 0;
	for i in g.n - st {
		let idx = st + i;
		g.res[idx] = ${x}(g.res[idx]);
		count++;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum < 0 {
		for i in g.n - st {
			let idx = st + i;
			if g.res[idx] < 0 { g.res[idx] = -g.res[idx]; }
		}
	}
	g.steps += count + mark_run_sfx_retry_b334;
	out.i = count;
	out.s.clear();
	format(out.s, "suffix items: ", count);
	out
}
@end
