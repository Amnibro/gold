expect: 4
expect: 6
code:
fn ${ID}(n int) int {
	var nested_root = if n < 0 { -n } else { n };
	while nested_root >= 10 {
		var inner_acc = 0;
		while nested_root > 0 {
			inner_acc += nested_root % 10;
			nested_root /= 10;
		}
		nested_root = inner_acc;
	}
	nested_root
}
@end
