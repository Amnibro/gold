	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} + ${sl});
	o.append(" r");
	gold_fnum(o, ${r} * 0.5);
	o.append(" m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "standoff");
	out
}
