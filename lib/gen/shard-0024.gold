	if ${start_idx} < 0 || ${start_idx} >= 2 {
		gold_fail(g, "start index must be zero or one");
		out.ok = false;
		return out;
	}
	var j = 0;
	var i = ${start_idx};
	while i < g.n {
		g.res[j] = g.res[i];
		j++;
		i += 2;
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "collected ", j, " alternating numbers");
	out
}
