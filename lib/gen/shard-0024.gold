kind: step
verb: group
noun: series
modifier: last
context: stats
phrase: group last {span} observations into mean relative partitions
phrase: classify last {span} sample values against their local mean
slot: span int
test: list=10,20,30,40,50 span=4
expect: => i=35 r=0.0 ok=true s="series local mean: 35" errors=0 n=4 res=[40,50,20,30] cache=0 hits=0
test: list=5,15,25,35,45,55 span=3
expect: => i=45 r=0.0 ok=true s="series local mean: 45" errors=0 n=3 res=[55,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if g.n == 0 || sp <= 0 { return out; }
	var actual = sp;
	if actual > g.n { actual = g.n; }
	let start = g.n - actual;
	var sum = 0;
	for i in actual { sum += g.res[start + i]; }
	let mean = sum / actual;
	var above = [0; 512];
	var below = [0; 512];
	var na = 0;
	var nb = 0;
	for i in actual {
		let val = g.res[start + i];
		if val > mean {
			above[na] = val;
			na++;
		} else {
			below[nb] = val;
			nb++;
		}
	}
	for i in na { g.res[i] = above[i]; }
	for i in nb { g.res[na + i] = below[i]; }
	g.n = actual;
	out.i = mean;
	out.s.clear();
	format(out.s, "series local mean: ", mean);
	out
}
@end
