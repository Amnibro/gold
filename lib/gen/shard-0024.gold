	var buf = [0; 512];
	var bn = 0;
	for i in c..g.n {
		buf[bn] = g.res[i];
		bn++;
	}
	for i in c {
		buf[bn] = g.res[i];
		bn++;
	}
	for i in g.n {
		g.res[i] = buf[i];
	}
	out.i = c;
	out.s.clear();
	format(out.s, "minimums moved: ", c);
	out
}
@end
