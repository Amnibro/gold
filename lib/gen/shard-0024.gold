code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_shift_items_rec_b334 = 0;
	let r = ${rounds};
	if g.n <= 1 || r <= 0 { return out; }
	for step in r {
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last_val;
	}
	g.steps += r * g.n + mark_shift_items_rec_b334;
	out.i = r;
	out.s.clear();
	format(out.s, "rounds: ", r);
	out
}
@end
