@entry 413c07ca1f11647f
kind: step
verb: rotate
noun: odds
modifier: with_cache
context: math
phrase: rotate odd numbers through cache using shift {shift}
phrase: cycle odd elements leveraging cached indices with shift {shift}
slot: shift int
test: list=1,2,3,4,5 shift=1
expect: => i=3 r=0.0 ok=true s="rotated odds: 3" errors=0 n=5 res=[5,2,1,4,3] cache=1 hits=0
test: list=7,8,9,10,11,12 shift=2
expect: => i=3 r=0.0 ok=true s="rotated odds: 3" errors=0 n=6 res=[9,8,11,10,7,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var odds = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[on] = g.res[i];
			on++;
		}
	}
	if on > 1 {
		let eff = ((sh % on) + on) % on;
		gold_cache_put(g, on, eff);
		var rot = [0; 512];
		for k in on {
			rot[(k + eff) % on] = odds[k];
		}
		var oidx = 0;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				g.res[i] = rot[oidx];
				oidx++;
			}
		}
	}
	out.i = on;
	out.s.clear();
	format(out.s, "rotated odds: ", on);
	out
}
@end
