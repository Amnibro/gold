expect: => i=2 r=0.0 ok=true s="reversed windows: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${window_size};
	if ws <= 0 {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var i = 0;
	var windows = 0;
	while i < g.n {
		var r = i + ws - 1;
		if r >= g.n { r = g.n - 1; }
		var l = i;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		windows++;
		i += ws;
	}
	g.steps += g.n;
	out.i = windows;
	out.s.clear();
	format(out.s, "reversed windows: ", windows);
	out
}
@end
