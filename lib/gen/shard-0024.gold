noun: tally
modifier: with_cache
context: aggregate
slot: modulus int
phrase: reverse frequency tally counts caching remainders modulo {modulus}
phrase: invert tally distribution saving values modulo {modulus}
test: list=4,2,4,2,2 modulus=10
expect: => i=5 r=0.0 ok=true s="reversed tally and cached mod results" errors=0 n=5 res=[2,2,4,2,4] cache=5 hits=0
test: list=7,7,3,3,3 modulus=5
expect: => i=5 r=0.0 ok=true s="reversed tally and cached mod results" errors=0 n=5 res=[3,3,3,7,7] cache=5 hits=0
test: list=1,2 modulus=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${modulus} <= 0 {
		gold_fail(g, "modulus must be positive");
		out.ok = false;
		return out;
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i] % ${modulus});
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed tally and cached mod results");
	out
}
@end
