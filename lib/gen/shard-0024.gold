fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tail_len};
	var start = g.n - k;
	if start < 0 { start = 0; }
	var uniq = [0; 512];
	var un = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in un { if uniq[j] == x { seen = true; break; } }
		if !seen {
			uniq[un] = x;
			un++;
		}
	}
	gold_clear(g);
	for i in un { gold_push(g, uniq[i]); }
	out.i = un;
	out.s.clear();
	format(out.s, "suffix uniq: ", un);
	out
}
@end
