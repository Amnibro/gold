test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="stain" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=14988 hash=631345
test: img=32 u=4
expect: => i=1024 r=0.0 ok=true s="stain" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=59948 hash=865164
test: u=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	let cx = ((g.iw - 1) as real) / 2.0;
	let cy = ((g.ih - 1) as real) / 2.0;
	var rr = (g.iw as real) / 2.0;
	if g.ih < g.iw { rr = (g.ih as real) / 2.0; }
	for y in g.ih {
		for x in g.iw {
			let a = (x as real) - cx;
			let b = (y as real) - cy;
			g.img[y * g.iw + x] = gold_clamp01(1.0 - sqrt(a * a + b * b) / rr);
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stain");
	out
}
@end
