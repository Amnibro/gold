fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted_pairs = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			sorted_pairs++;
		}
		i++;
	}
	gold_cache_put(g, g.n, sorted_pairs);
	g.steps += g.n;
	out.i = sorted_pairs;
	out.s.clear();
	format(out.s, "sorted adjacent pairs cached: ", sorted_pairs);
	out
}
@end
@entry 2d15c26bf0475358
kind: step
verb: pair
noun: average
modifier: between
context: stats
slot: low int
slot: high int
phrase: pair average between limits {low} through {high}
phrase: count adjacent pair averages between {low} to {high}
test: list=10,20,30,40 low=15 high=25
expect: => i=2 r=0.0 ok=true s="pair averages between bounds: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,4,6 low=10 high=20
expect: => i=0 r=0.0 ok=true s="pair averages between bounds: 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var i = 1;
	while i < g.n {
		let avg = (g.res[i - 1] + g.res[i]) / 2;
		if avg >= lo && avg <= hi {
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "pair averages between bounds: ", count);
	out
}
@end
@entry 9eb169ac116d463a
kind: step
verb: retry
noun: squares
modifier: in_place
context: stats
slot: max_val int
phrase: retry squares in place under ceiling {max_val}
phrase: compute squares in place with bound {max_val}
test: list=2,3,4 max_val=20
expect: => i=3 r=0.0 ok=true s="squared elements in place: 3" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=3,10 max_val=50
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	var exceeded = false;
	var i = 0;
	while i < g.n {
		let sq = g.res[i] * g.res[i];
		if sq > limit {
			exceeded = true;
			break;
		}
		g.res[i] = sq;
		i++;
	}
	g.steps += i;
	if exceeded {
		gold_fail(g, "retry squares in place: limit exceeded");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "squared elements in place: ", g.n);
	}
	out
}
@end
@entry 8d9cbcdd1044ec29
kind: step
verb: retry
noun: history
modifier: in_place
context: stats
slot: min_val int
phrase: retry history in place above baseline {min_val}
phrase: offset sample history in place using baseline {min_val}
test: list=15,20,30 min_val=10
expect: => i=3 r=0.0 ok=true s="offset history in place: 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
test: list=10,5,20 min_val=8
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[2,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let baseline = ${min_val};
	var failed = false;
	var i = 0;
	while i < g.n {
		let diff = g.res[i] - baseline;
		if diff < 0 {
			failed = true;
			break;
		}
		g.res[i] = diff;
		i++;
	}
	g.steps += i;
	if failed {
		gold_fail(g, "retry history in place: value dropped below baseline");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "offset history in place: ", g.n);
	}
	out
}
@end
