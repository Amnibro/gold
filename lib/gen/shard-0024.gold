kind: step
verb: collect
noun: gaps
modifier: with_retry
context: loop
slot: max_gap int
phrase: collect gaps with retry limit {max_gap}
phrase: filter gap increments with retry threshold {max_gap}
test: list=1,3,10,12 max_gap=4
expect: => i=2 r=0.0 ok=true s="gaps gathered: 2" errors=0 n=2 res=[2,2] cache=0 hits=0
test: list=5,20,25 max_gap=6
expect: => i=1 r=0.0 ok=true s="gaps gathered: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var gaps = [0; 512];
	var gn = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= mg {
			gaps[gn] = diff;
			gn++;
		}
	}
	gold_clear(g);
	for k in gn { gold_push(g, gaps[k]); }
	out.i = gn;
	out.s.clear();
	format(out.s, "gaps gathered: ", gn);
	out
}
@end
@entry 6b6f5fe78c649162
kind: step
verb: split
noun: primes
modifier: each
context: loop
slot: limit int
phrase: split primes each under ceiling limit {limit}
phrase: filter prime values each below {limit}
test: list=2,3,4,5,6 limit=5
expect: => i=3 r=0.0 ok=true s="primes split: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,8,9,11 limit=10
expect: => i=1 r=0.0 ok=true s="primes split: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var primes = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				primes[pn] = x;
				pn++;
			}
		}
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "primes split: ", pn);
	out
}
@end
