context: stats
phrase: group duplicates running sequentially across list
phrase: cluster running duplicate observations together
test: list=4,2,4,5,2,4
expect: => i=6 r=0.0 ok=true s="grouped dupes: 6" errors=0 n=6 res=[4,4,4,2,2,5] cache=0 hits=0
test: list=9,3,9,1,3
expect: => i=5 r=0.0 ok=true s="grouped dupes: 5" errors=0 n=5 res=[9,9,3,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes = [0; 512];
	var dn = 0;
	var seen = [0; 512];
	var sn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_seen = false;
		for j in sn { if seen[j] == x { is_seen = true; break; } }
		if !is_seen {
			seen[sn] = x;
			sn++;
			for j in g.n {
				if g.res[j] == x {
					dupes[dn] = x;
					dn++;
				}
			}
		}
	}
	gold_clear(g);
	for i in dn { gold_push(g, dupes[i]); }
	out.i = dn;
	out.s.clear();
	format(out.s, "grouped dupes: ", dn);
	out
}
@end
