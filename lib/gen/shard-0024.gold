code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var j = 0;
		while j < w {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			g.res[w] = g.res[i];
			gold_cache_put(g, g.res[w], 1);
			w++;
		}
		i++;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "histogram");
	out
}
@end
