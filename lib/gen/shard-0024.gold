fn ${ID}(g Gold&, v Val) Val {
	var res_weather_leather_banded = v;
	if !gold_img_ok(g) { res_weather_leather_banded.ok = false; return res_weather_leather_banded; }
	var c0_weather_leather_banded = 8;
	for o_weather_leather_banded in 2 { if !gold_img_square(g, c0_weather_leather_banded) { res_weather_leather_banded.ok = false; return res_weather_leather_banded; } c0_weather_leather_banded = c0_weather_leather_banded / 2; }
	for y_weather_leather_banded in g.ih {
		for x_weather_leather_banded in g.iw {
			var t_weather_leather_banded = 0.0;
			var amp_weather_leather_banded = 1.0;
			var norm_weather_leather_banded = 0.0;
			var cc_weather_leather_banded = 8;
			for o_weather_leather_banded in 2 { t_weather_leather_banded += amp_weather_leather_banded * gold_vnoise(x_weather_leather_banded, y_weather_leather_banded, cc_weather_leather_banded, g.iw / cc_weather_leather_banded, ${u} + o_weather_leather_banded); norm_weather_leather_banded += amp_weather_leather_banded; amp_weather_leather_banded *= 0.5; cc_weather_leather_banded = cc_weather_leather_banded / 2; }
			g.img[y_weather_leather_banded * g.iw + x_weather_leather_banded] = t_weather_leather_banded / norm_weather_leather_banded;
		}
	}
	for k_weather_leather_banded in g.iw * g.ih {
		var q_weather_leather_banded = (g.img[k_weather_leather_banded] * 3.0) as! int;
		if q_weather_leather_banded > 2 { q_weather_leather_banded = 2; }
		g.img[k_weather_leather_banded] = (q_weather_leather_banded as real) / 2.0;
	}
	res_weather_leather_banded.i = g.iw * g.ih;
	res_weather_leather_banded.s.clear();
	format(res_weather_leather_banded.s, "leather");
	res_weather_leather_banded
}
@end
@entry aabf39412e520e27
kind: step
verb: scale
noun: vowels
modifier: every_other
context: aggregate
phrase: scale vowels every other position by {factor}
phrase: multiply vowels every other occurrence factor {factor}
slot: factor int
test: text="banana" factor=2
expect: => i=485 r=0.0 ok=true s="scaled vowels aggregate: 485" errors=0 n=0 res=[] cache=0 hits=0
test: text="education" factor=3
expect: => i=1149 r=0.0 ok=true s="scaled vowels aggregate: 1149" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum = 0;
	var vcount = 0;
	for b in out.s {
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		   b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U' {
			if vcount % 2 == 0 {
				sum += (b as int) * f;
			} else {
				sum += b as int;
			}
			vcount++;
		}
	}
	g.steps += vcount;
	out.i = sum;
	out.s.clear();
	format(out.s, "scaled vowels aggregate: ", sum);
	out
}
@end
