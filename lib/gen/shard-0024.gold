kind: step
verb: merge
noun: condition
modifier: up_to
context: aggregate
slot: max_merged int
phrase: merge adjacent even numbers satisfying condition up to {max_merged}
phrase: combine matching adjacent pairs up to limit {max_merged}
test: list=2,4,6,8,9 max_merged=2
expect: => i=2 r=0.0 ok=true s="merged 2 pairs" errors=0 n=3 res=[6,14,9] cache=0 hits=0
test: list=10,20,30 max_merged=1
expect: => i=1 r=0.0 ok=true s="merged 1 pairs" errors=0 n=2 res=[30,30] cache=0 hits=0
test: list=2,4 max_merged=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${max_merged} <= 0 {
		gold_fail(g, "max merged must be positive");
		out.ok = false;
		return out;
	}
	var merged = 0;
	var j = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 && merged < ${max_merged} {
			g.res[j] = g.res[i] + g.res[i + 1];
			j++;
			merged++;
			i += 2;
		} else {
			g.res[j] = g.res[i];
			j++;
			i++;
		}
	}
	g.n = j;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged ", merged, " pairs");
	out
}
@end
