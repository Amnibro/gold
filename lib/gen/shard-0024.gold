phrase: drop average every other pair below threshold {thresh}
phrase: filter alternating pair averages beneath cutoff {thresh}
test: list=10,30,2,4,50,70 thresh=15
expect: => i=4 r=0.0 ok=true s="kept 4 elements above pair average" errors=0 n=4 res=[10,30,50,70] cache=0 hits=0
test: list=4,6,10,20,2,2 thresh=8
expect: => i=2 r=0.0 ok=true s="kept 2 elements above pair average" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=1,2 thresh=-5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${thresh} < 0 {
		gold_fail(g, "threshold must be non-negative");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		if avg >= ${thresh} {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
		}
		i += 2;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements above pair average");
	out
}
@end
