@entry 87b9b831d1bb097e
kind: step
verb: reverse
noun: primes
modifier: all
context: list
phrase: reverse primes all positions bound {bound}
phrase: invert primes all positions bound {bound}
slot: bound int
test: list=2,4,3,6,5 bound=10
expect: => i=3 r=0.0 ok=true s="primes reversed: 3" errors=0 n=5 res=[5,4,3,6,2] cache=0 hits=0
test: list=7,8,11,12,13 bound=15
expect: => i=3 r=0.0 ok=true s="primes reversed: 3" errors=0 n=5 res=[13,8,11,12,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var prime_indices = [0; 512];
	var pn = 0;
	var i = 0;
	while i < g.n && g.res[i] <= b {
		if core_is_prime(g.res[i]) {
			prime_indices[pn] = i;
			pn++;
		}
		i++;
	}
	var l = 0;
	var r = pn - 1;
	while l < r {
		let il = prime_indices[l];
		let ir = prime_indices[r];
		let tmp = g.res[il];
		g.res[il] = g.res[ir];
		g.res[ir] = tmp;
		l++;
		r--;
	}
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "primes reversed: ", pn);
	out
}
@end
