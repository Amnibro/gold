fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sparse_gorge_buf byte[>..] = [];
	if ${w} <= 0.0 { gold_fail(g, "valley width nonpositive"); out.ok = false; return out; }
	gold_dnews(g, "gorge", "", sparse_gorge_buf);
	sparse_gorge_buf.append(" crease r");
	gold_fnum(sparse_gorge_buf, ${w});
	sparse_gorge_buf.append(" s0.7 -");
	gold_fnum(sparse_gorge_buf, ${x});
	sparse_gorge_buf.append(",");
	gold_fnum(sparse_gorge_buf, ${y});
	sparse_gorge_buf.append(",0 0,");
	sparse_gorge_buf.append("0,");
	sparse_gorge_buf.append("0 ");
	gold_fnum(sparse_gorge_buf, ${x});
	sparse_gorge_buf.append(",-");
	gold_fnum(sparse_gorge_buf, ${y});
	sparse_gorge_buf.append(",0");
	gold_doc(g, sparse_gorge_buf);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "sparse valley");
	out
}
@end
