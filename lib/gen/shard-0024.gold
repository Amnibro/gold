context: stats
phrase: split sample items into equal halves comparing means
phrase: bisect observation distribution calculating mean difference
test: list=10,20,30,40
expect: => i=20 r=0.0 ok=true s="split mean diff: 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,4,6,8,10,12
expect: => i=6 r=0.0 ok=true s="split mean diff: 6" errors=0 n=6 res=[2,4,6,8,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	var s1 = 0;
	for i in mid { s1 += g.res[i]; }
	var s2 = 0;
	for i in g.n - mid { s2 += g.res[mid + i]; }
	let m1 = s1 / mid;
	let m2 = s2 / (g.n - mid);
	let diff = m2 - m1;
	out.i = diff;
	out.s.clear();
	format(out.s, "split mean diff: ", diff);
	out
}
@end
