fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	for i in g.n {
		if g.res[i] > 0 { count++; }
	}
	var clamped = count;
	if clamped > c { clamped = c; }
	g.steps += count;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped tally result: ", clamped);
	out
}
@end
