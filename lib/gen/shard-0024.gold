		sn++;
		idx += 2;
	}
	var p = 0;
	while p < sn {
		var q = 0;
		while q + 1 < sn {
			if sub[q] > sub[q + 1] {
				let tmp = sub[q];
				sub[q] = sub[q + 1];
				sub[q + 1] = tmp;
			}
			q++;
		}
		p++;
	}
	idx = off;
	for k in sn {
		g.res[idx] = sub[k];
		idx += 2;
	}
	g.steps += sn;
	out.i = sn;
	out.s.clear();
	format(out.s, "sorted alternating entries: ", sn);
	out
}
@end
