fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} < g.n { ${k} } else { g.n };
	for i in limit {
		for j in limit - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
		}
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "prefix sorted: ", limit);
	out
}
@end
