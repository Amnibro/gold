expect: => i=2 r=0.0 ok=true s="clamped to minimum floor in place: 2" errors=0 n=4 res=[10,12,10,20] cache=0 hits=0
test: list=15,30 floor=10
expect: => i=0 r=0.0 ok=true s="clamped to minimum floor in place: 0" errors=0 n=2 res=[15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var clamped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped to minimum floor in place: ", clamped);
	out
}
@end
@entry a1532e22500b7f77
kind: step
verb: scale
noun: digits
modifier: until
context: stats
slot: target int
phrase: scale digits until total reaches {target}
phrase: multiply digits by ten until sum {target}
test: list=1,2 target=25
expect: => i=1 r=0.0 ok=true s="digit scale passes until target: 1" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10 target=12
expect: => i=0 r=0.0 ok=true s="digit scale passes until target: 0" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var passes = 0;
	while passes < 5 {
		var sum = 0;
		var i = 0;
		while i < g.n {
			sum += g.res[i];
			i++;
		}
		if sum >= tgt {
			break;
		}
		var j = 0;
		while j < g.n {
			g.res[j] *= 10;
			j++;
		}
		passes++;
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "digit scale passes until target: ", passes);
	out
}
@end
