@entry 3efd98eb1b4ec493
kind: fn
verb: drop
noun: streak
modifier: times
context: sort
slot: divisor int
phrase: drop streak times under divisor base {divisor}
phrase: longest repeated remainder streak for divisor {divisor}
test: arg=11222,456,-100 divisor=10
expect: 3
expect: 1
expect: 2
test: arg=8,64 divisor=2
expect: 3
expect: 6
code:
fn ${ID}(n int) int {
	var x = n;
	let base = ${divisor};
	if x < 0 { x = -x; }
	if x == 0 { return 1; }
	var max_streak = 0;
	var cur_streak = 0;
	var prev = -1;
	while x > 0 {
		let r = x % base;
		if r == prev {
			cur_streak++;
		} else {
			cur_streak = 1;
			prev = r;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
		x /= base;
	}
	max_streak
}
