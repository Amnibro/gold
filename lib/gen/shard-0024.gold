noun: runs
modifier: recursively
context: retry
phrase: return runs recursively with retry depth {max_depth}
phrase: isolate consecutive runs recursively bound {max_depth}
slot: max_depth int
test: list=1,1,2,2,2,3 max_depth=3
expect: => i=3 r=0.0 ok=true s="consecutive runs: 3" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=4,4,5,6,6 max_depth=2
expect: => i=2 r=0.0 ok=true s="consecutive runs: 2" errors=0 n=5 res=[4,4,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_depth};
	var runs = 0;
	var i = 0;
	while i < g.n && runs < md {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		runs++;
		i = j;
	}
	g.steps += runs;
	out.i = runs;
	out.s.clear();
	format(out.s, "consecutive runs: ", runs);
	out
}
@end
