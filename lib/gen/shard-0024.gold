@entry f038115b6a3bcaa5
kind: step
verb: scale
noun: middle
modifier: in_reverse
context: list
slot: factor int
phrase: scale middle elements in reverse with factor {factor}
phrase: multiply middle slice in reverse by factor {factor}
test: list=10,2,3,4,50 factor=3
expect: => i=3 r=0.0 ok=true s="scaled middle elements in reverse: 3" errors=0 n=5 res=[10,12,9,6,50] cache=0 hits=0
test: list=1,5,6,9 factor=2
expect: => i=2 r=0.0 ok=true s="scaled middle elements in reverse: 2" errors=0 n=4 res=[1,12,10,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n > 2 {
		var i = 1;
		while i < g.n - 1 {
			g.res[i] = g.res[i] * f;
			i++;
		}
		var left = 1;
		var right = g.n - 2;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	let mid_count = if g.n > 2 { g.n - 2 } else { 0 };
	g.steps += g.n;
	out.i = mid_count;
	out.s.clear();
	format(out.s, "scaled middle elements in reverse: ", mid_count);
	out
}
@end
@entry d0964d8c06b890fa
kind: step
verb: retry
noun: window
modifier: up_to
context: list
slot: max_len int
phrase: retry window up to length {max_len} across list
phrase: attempt window scan up to size {max_len}
test: list=2,4,6,1 max_len=2
expect: => i=10 r=0.0 ok=true s="retry window max sum up to: 10" errors=0 n=5 res=[2,4,6,1,10] cache=0 hits=0
test: list=5,8,3 max_len=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[5,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	if limit <= 0 {
		gold_fail(g, "retry window: invalid window limit");
		out.ok = false;
		return out;
	}
	var w = limit;
	if w > g.n { w = g.n; }
	var max_sum = 0;
	var i = 0;
	while i + w <= g.n {
		var cur_sum = 0;
		var j = 0;
		while j < w {
			cur_sum += g.res[i + j];
			j++;
		}
		if i == 0 || cur_sum > max_sum {
			max_sum = cur_sum;
		}
		i++;
	}
	gold_push(g, max_sum);
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "retry window max sum up to: ", max_sum);
	out
}
@end
@entry 50c85b8e56639de1
kind: step
verb: map
noun: window
modifier: until
context: list
slot: target int
phrase: map window pairs until sum reaches {target}
phrase: transform adjacent window until threshold {target}
test: list=2,3,4,10 target=12
expect: => i=2 r=0.0 ok=true s="mapped windows until target: 2" errors=0 n=4 res=[5,7,4,10] cache=0 hits=0
test: list=1,1,10 target=5
expect: => i=1 r=0.0 ok=true s="mapped windows until target: 1" errors=0 n=3 res=[2,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if sum >= tgt {
			break;
		}
		g.res[i] = sum;
		count++;
		i++;
	}
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped windows until target: ", count);
	out
}
@end
@entry c3cdcb8295bbb74b
kind: step
verb: check
noun: primes
modifier: in_place
context: list
phrase: check primes in place across list
phrase: filter prime values in place preserving positions
test: list=2,4,5,9,11
expect: => i=3 r=0.0 ok=true s="checked primes in place count: 3" errors=0 n=5 res=[2,0,5,0,11] cache=0 hits=0
test: list=1,7,8
expect: => i=1 r=0.0 ok=true s="checked primes in place count: 1" errors=0 n=3 res=[0,7,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			primes++;
		} else {
			g.res[i] = 0;
		}
		i++;
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "checked primes in place count: ", primes);
	out
}
@end
@entry b71ebd21680554c3
kind: step
verb: check
noun: history
modifier: none
context: list
phrase: check history none negative across elements
phrase: verify list history has none below zero
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="history contains none negative: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,-2,8
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[5,-2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_negative = false;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 {
			has_negative = true;
			break;
		}
		i++;
	}
	g.steps += g.n;
	if has_negative {
		gold_fail(g, "check history none: negative element encountered");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "history contains none negative: ", g.n);
	}
	out
}
@end
