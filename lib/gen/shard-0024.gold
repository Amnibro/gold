fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${delta} == 0 {
		gold_fail(g, "delta cannot be zero");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[i] += ${delta};
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " even items");
	out
}
@end
