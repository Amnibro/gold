code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let inc = ${step_inc};
	var running = 0;
	for i in g.n {
		running += g.res[i] + inc;
		g.res[i] = running;
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "final running scan: ", running);
	out
}
@end
