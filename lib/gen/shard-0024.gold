expect: => i=8 r=0.0 ok=true s="desrever" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var reversed: byte[..200] = "";
	var k = out.s.len - 1;
	while k >= 0 {
		reversed.push(out.s[k]);
		k--;
	}
	out.s.clear();
	for b in reversed { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
@entry c372ce19a6078c29
kind: step
verb: dedupe
noun: item
modifier: until
context: retry
phrase: dedupe item until unique count meets {target}
phrase: prune item duplicates until reaching count {target}
slot: target int
test: list=1,1,2,2,3,4,4 target=3
expect: => i=3 r=0.0 ok=true s="deduped count reached: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,6 target=2
expect: => i=2 r=0.0 ok=true s="deduped count reached: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var unique = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if unique[j] == x { exists = true; break; }
		}
		if !exists {
			unique[un] = x;
			un++;
			if un >= tg { break; }
		}
	}
	gold_clear(g);
	for i in un { gold_push(g, unique[i]); }
	out.i = un;
	out.s.clear();
	format(out.s, "deduped count reached: ", un);
	out
}
@end
@entry 8548775cf55f53cb
