code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${span} <= 0 {
		gold_fail(g, "span must be positive");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i + ${span} <= g.n {
		var left = i;
		var right = i + ${span} - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
		i += ${span};
	}
	out.i = i;
	out.s.clear();
	format(out.s, "reversed series in place");
	out
}
@end
