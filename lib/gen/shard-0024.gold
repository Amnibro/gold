fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${sep};
	out.s.clear();
	if g.n >= 2 {
		format(out.s, g.res[g.n - 2]);
		out.s.push(s as byte);
		format(out.s, g.res[g.n - 1]);
	}
	g.steps += 2;
	out.i = out.s.len;
	out
}
