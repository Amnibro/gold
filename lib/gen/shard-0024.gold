@entry 243884a408ebe6a7
kind: step
verb: merge
noun: primes
modifier: each
context: aggregate
slot: bonus int
phrase: merge prime values with adjacent element adding bonus {bonus}
phrase: combine each prime result with neighboring item plus {bonus}
test: list=2,4,3,5,6 bonus=10
expect: => i=3 r=0.0 ok=true s="prime merge completed" errors=0 n=3 res=[16,18,6] cache=0 hits=0
test: list=7,8,11,12 bonus=5
expect: => i=2 r=0.0 ok=true s="prime merge completed" errors=0 n=2 res=[20,28] cache=0 hits=0
test: list=1,4,6 bonus=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,4,6] cache=0 hits=0
code:
fn ${ID}_is_prime(x int) bool {
	if x < 2 { return false; }
	var d = 2;
	while d * d <= x {
		if x % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${bonus} <= 0 {
		gold_fail(g, "bonus must be positive");
		out.ok = false;
		return out;
	}
	var j = 0;
	var i = 0;
	while i < g.n {
		if ${ID}_is_prime(g.res[i]) && i + 1 < g.n {
			g.res[j] = g.res[i] + g.res[i + 1] + ${bonus};
			j++;
			i += 2;
		} else {
			g.res[j] = g.res[i];
			j++;
			i++;
		}
	}
	g.n = j;
	out.i = j;
	out.s.clear();
	format(out.s, "prime merge completed");
	out
}
@end
