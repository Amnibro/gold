expect: => doc: river1 box 0,0,0.1 10,2,0.2 m:glass #3c78b4
test: a=6.0 b=1.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="river" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: river3 box 0,0,0.06 6,1,0.12 m:glass #3c78b4
test: a=0.0 b=2.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${a} <= 0.0 || ${b} <= 0.0 {
		gold_fail(g, "dimensions must be positive");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	gold_dnews(g, "river", "", o);
	o.append(" box ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${a} * 0.01);
	o.append(" ");
	gold_fnum(o, ${a});
	o.append(",");
	gold_fnum(o, ${b});
	o.append(",");
	gold_fnum(o, ${a} * 0.02);
	o.append(" m:glass ");
	gold_hex(o, 60, 120, 180);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "river");
	out
}
@end
