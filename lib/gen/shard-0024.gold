phrase: adjust observation baseline safely ensuring minimum is {floor}
slot: floor int
test: list=10,20,30,40 floor=15
expect: => i=5 r=0.0 ok=true s="safe min shift: 5" errors=0 n=4 res=[15,25,35,45] cache=0 hits=0
test: list=2,8,14,20 floor=10
expect: => i=8 r=0.0 ok=true s="safe min shift: 8" errors=0 n=4 res=[10,16,22,28] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	if g.n == 0 { return out; }
	var mn = g.res[0];
	for i in g.n {
		if g.res[i] < mn { mn = g.res[i]; }
	}
	var diff = 0;
	if mn < fl {
		diff = fl - mn;
		for i in g.n { g.res[i] += diff; }
	}
	out.i = diff;
	out.s.clear();
	format(out.s, "safe min shift: ", diff);
	out
}
@end
@entry afbae749d48fe232
kind: step
verb: drop
noun: values
modifier: sorted
context: stats
phrase: drop trimmed outlier values from ends of sorted samples with count {trim}
phrase: trim extreme observation values from sorted dataset by {trim}
slot: trim int
test: list=50,10,30,20,40 trim=1
expect: => i=3 r=0.0 ok=true s="sorted trimmed: 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=80,10,90,20,70,30 trim=2
expect: => i=2 r=0.0 ok=true s="sorted trimmed: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tr = ${trim};
	if g.n == 0 || tr <= 0 { return out; }
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if 2 * tr >= g.n {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let kept = g.n - 2 * tr;
	for i in kept {
		g.res[i] = g.res[tr + i];
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted trimmed: ", kept);
	out
}
@end
