code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var n = g.res[0];
	if n < 0 { n = -n; }
	var sum = 0;
	while n > 0 {
		sum += n % 10;
		n /= 10;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "digit sum: ", sum);
	out
}
@end
