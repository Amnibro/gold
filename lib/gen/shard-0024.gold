expect: => i=-1 r=0.0 ok=true s="not found in suffix" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let half = g.n / 2;
	var found = -1;
	var idx = half;
	while idx < g.n {
		if g.res[idx] == tgt {
			found = idx;
			break;
		}
		idx++;
	}
	g.steps += (idx - half) + 1;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found in suffix at: ", found);
	} else {
		format(out.s, "not found in suffix");
	}
	out
}
@end
