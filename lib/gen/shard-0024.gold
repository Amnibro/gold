@entry 47403e1995117051
kind: step
verb: pair
noun: gaps
modifier: first
context: aggregate
slot: min_gap int
phrase: pair adjacent items having initial gap of at least {min_gap}
phrase: group first adjacent elements separated by minimum gap {min_gap}
test: list=1,10,12,30 min_gap=5
expect: => i=2 r=0.0 ok=true s="found 2 gap pairs" errors=0 n=4 res=[1,10,12,30] cache=0 hits=0
test: list=2,20,25,50 min_gap=8
expect: => i=2 r=0.0 ok=true s="found 2 gap pairs" errors=0 n=4 res=[2,20,25,50] cache=0 hits=0
test: list=1,2 min_gap=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min_gap} <= 0 {
		gold_fail(g, "minimum gap must be positive");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	var j = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff >= ${min_gap} {
			g.res[j] = g.res[i];
			g.res[j + 1] = g.res[i + 1];
			j += 2;
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	g.n = j;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " gap pairs");
	out
}
@end
