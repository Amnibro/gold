		sorted = true;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
		}
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "stable sort passes: ", passes);
	out
}
@end
@entry d7ff16c03ea7e81d
kind: step
verb: return
noun: total
modifier: nested
context: retry
phrase: return total nested partition size {block}
phrase: compute total nested block sum size {block}
slot: block int
test: list=1,2,3,4,5,6 block=3
expect: => i=21 r=0.0 ok=true s="total nested blocks: 21" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,20,30,40 block=2
expect: => i=100 r=0.0 ok=true s="total nested blocks: 100" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block};
	if b <= 0 {
		gold_fail(g, "invalid block size");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = 0;
	while i < g.n {
		var block_sum = 0;
		var k = 0;
		while k < b && i + k < g.n {
			block_sum += g.res[i + k];
			k++;
		}
		total += block_sum;
		i += b;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "total nested blocks: ", total);
	out
}
@end
