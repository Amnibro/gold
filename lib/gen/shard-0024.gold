code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passed = false;
	if g.n > 0 {
		let last_item = g.res[g.n - 1];
		passed = ${p}(last_item);
		out.i = last_item;
	}
	out.ok = passed;
	g.steps += 1;
	out.s.clear();
	if passed {
		format(out.s, "last element matched");
	} else {
		format(out.s, "last element failed");
	}
	out
}
@end
