code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var adjusted = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
			adjusted++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "gaps adjusted: ", adjusted);
	out
}
@end
