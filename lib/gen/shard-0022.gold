expect: => i=3 r=0.0 ok=true s="rotated histogram bins: 3" errors=0 n=4 res=[30,10,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l < 0 || h >= g.n || l >= h {
		gold_fail(g, "invalid histogram rotation bounds");
		out.ok = false;
		return out;
	}
	let last = g.res[h];
	var i = h;
	while i > l {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[l] = last;
	g.steps += (h - l + 1);
	out.i = h - l + 1;
	out.s.clear();
	format(out.s, "rotated histogram bins: ", out.i);
	out
}
@end
