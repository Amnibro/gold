code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${max_err};
	if out.i < 0 {
		gold_fail(g, "negative input error");
	}
	if g.errors > mx {
		let diff = g.errors - mx;
		g.errors = mx;
		out.i = diff;
	} else {
		out.i = mx;
	}
	out.s.clear();
	format(out.s, "clamped errors while");
	out
}
@end
