code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var trimmed = 0;
	while g.n > 0 && ${p}(g.res[g.n - 1]) {
		g.n--;
		trimmed++;
	}
	g.steps += trimmed;
	out.i = trimmed;
	out.s.clear();
	format(out.s, "trimmed tail items: ", trimmed);
	out
}
@end
@entry 7d1d943216c762d3
kind: step
verb: return
noun: tail
modifier: unique
context: search
phrase: return tail search candidates count {count} unique
phrase: hand back unique search hits from tail count {count}
slot: count int
test: list=1,2,3,3,4,4 count=4
expect: => i=2 r=0.0 ok=true s="returned unique tail: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,30,40 count=3
expect: => i=3 r=0.0 ok=true s="returned unique tail: 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let start = if g.n > c { g.n - c } else { 0 };
	var temp = [0; 512];
	var nn = 0;
	var i = start;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		for j in nn {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[nn] = x;
			nn++;
		}
		i++;
	}
	gold_clear(g);
	for j in nn { gold_push(g, temp[j]); }
	g.steps += g.n;
	out.i = nn;
	out.s.clear();
	format(out.s, "returned unique tail: ", nn);
	out
}
@end
