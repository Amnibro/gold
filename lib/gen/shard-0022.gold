@entry 3405472b8512ccc8
kind: step
verb: check
noun: sequence
modifier: running
context: transform
phrase: check sequence running monotonicity step {step}
phrase: running sequence verify order step {step}
slot: step int
test: list=1,2,4,7 step=1
expect: => i=1 r=0.0 ok=true s="sequence monotonic" errors=0 n=4 res=[1,2,4,7] cache=0 hits=0
test: list=5,3,1 step=1
expect: => i=0 r=0.0 ok=false s="sequence irregular" errors=0 n=3 res=[5,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var valid = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] < g.res[i] + s {
				valid = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, if valid { "sequence monotonic" } else { "sequence irregular" });
	out
}
@end
