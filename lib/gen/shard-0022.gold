code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 4 < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 4 + y / 4) % 2) as real;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	var s2_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stone");
	out
}
@end
