expect: 186
expect: 0
code:
fn ${ID}(n int) int {
	let sc = ${scale};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var res = 0;
	var mult = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		res += (diff * sc) * mult;
		mult *= 10;
		prev = cur;
		x /= 10;
	}
	res
}
@end
