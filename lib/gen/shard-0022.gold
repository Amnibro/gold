@entry 4e3935e60a1db58e
kind: step
verb: merge
noun: primes
modifier: recursively
context: stats
phrase: merge primes recursively across dataset
phrase: recursively condense prime observations in sample
test: list=2,4,3,9,5
expect: => i=3 r=0.0 ok=true s="merged 3 primes" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,11,12,13
expect: => i=3 r=0.0 ok=true s="merged 3 primes" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "merged ", w, " primes");
	out
}
@end
