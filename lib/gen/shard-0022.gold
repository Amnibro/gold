phrase: replace runs in_place plateau mark {repl}
slot: repl int
test: list=5,5,5,12,8,8,14 repl=99
expect: => i=5 r=0.0 ok=true s="fill runs in_place: 5" errors=0 n=7 res=[99,99,99,12,99,99,14] cache=0 hits=0
test: list=3,3,7,15,15,15 repl=88
expect: => i=5 r=0.0 ok=true s="fill runs in_place: 5" errors=0 n=6 res=[88,88,7,88,88,88] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_val = ${repl};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= 2 {
			var k = i;
			while k < j { g.res[k] = r_val; k++; modified++; }
		}
		i = j;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "fill runs in_place: ", modified);
	out
}
@end
