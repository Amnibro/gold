test: list=20,10,30
expect: => i=10 r=0.0 ok=true s="minimum to front: 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,40,15,60
expect: => i=15 r=0.0 ok=true s="minimum to front: 15" errors=0 n=4 res=[15,40,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var min_idx = 0;
		for i in 1..g.n {
			if g.res[i] < g.res[min_idx] { min_idx = i; }
		}
		if min_idx != 0 {
			let tmp = g.res[0];
			g.res[0] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		out.i = g.res[0];
		out.s.clear();
		format(out.s, "minimum to front: ", g.res[0]);
	} else if g.n == 1 {
		out.i = g.res[0];
		out.s.clear();
		format(out.s, "single value: ", g.res[0]);
	}
	g.steps += g.n;
	out
}
@end
