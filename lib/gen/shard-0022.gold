slot: stride int
test: list=1,2,3,4,5,6 stride=2
expect: => i=3 r=0.0 ok=true s="chunk count: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40,50,60 stride=3
expect: => i=2 r=0.0 ok=true s="chunk count: 2" errors=0 n=2 res=[60,150] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = if ${stride} > 0 { ${stride} } else { 1 };
	var sums = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		var blk = 0;
		for step in st {
			if i + step < g.n {
				blk += g.res[i + step];
			}
		}
		sums[count] = blk;
		count++;
		i += st;
	}
	g.n = 0;
	for j in count { gold_push(g, sums[j]); }
	out.i = count;
	out.s.clear();
	format(out.s, "chunk count: ", count);
	out
}
@end
@entry ba55db2feff7efb0
kind: step
verb: limit
noun: middle
modifier: with_retry
context: core
phrase: limit middle with_retry bound span {span} ceiling {cap}
phrase: clamp middle with_retry items span {span} to {cap}
slot: span int
slot: cap int
test: list=1,12,15,18,3 span=3 cap=10
expect: => i=3 r=0.0 ok=true s="mid clamped: 3" errors=0 n=5 res=[1,10,10,10,3] cache=0 hits=0
test: list=5,20,30,40,50,6 span=4 cap=25
expect: => i=3 r=0.0 ok=true s="mid clamped: 3" errors=0 n=6 res=[5,20,25,25,25,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = if ${span} < g.n { ${span} } else { g.n };
	let cap = ${cap};
	if span <= 0 { return out; }
	let start = (g.n - span) / 2;
	var clamped = 0;
	for i in span {
		let idx = start + i;
		if g.res[idx] > cap {
			g.res[idx] = cap;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "mid clamped: ", clamped);
	out
}
@end
