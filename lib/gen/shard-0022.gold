fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var clamped = 0;
	var k = 0;
	while k < g.n {
		if g.res[k] > lim {
			g.res[k] = lim;
			clamped++;
		}
		k++;
	}
	g.steps += g.n * 2;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped sorted streaks: ", clamped);
	out
}
@end
