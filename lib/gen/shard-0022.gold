fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_sz};
	var sampled = [0; 512];
	var sn = 0;
	if st > 0 && g.n > 0 {
		var idx = g.n - 1;
		while idx >= 0 {
			sampled[sn] = g.res[idx];
			sn++;
			idx -= st;
		}
	}
	g.n = 0;
	for i in sn { gold_push(g, sampled[i]); }
	out.i = sn;
	out.s.clear();
	format(out.s, "join step in_reverse: ", sn);
	out
}
@end
