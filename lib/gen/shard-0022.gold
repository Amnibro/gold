expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${s} <= 0.0 { gold_fail(g, "scale must be positive"); out.ok = false; return out; }
	o.append(last);
	o.append(".scale anim 0:1,");
	o.append("1,1 ");
	o.append("1:");
	gold_fnum(o, ${s});
	o.push(',');
	gold_fnum(o, ${s});
	o.push(',');
	gold_fnum(o, ${s});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "scalcrsp");
	out
}
@end
