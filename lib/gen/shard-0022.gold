code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${k};
	if lim > g.n { lim = g.n; }
	if lim <= 1 || g.n == 0 { return out; }
	var min_idx = 0;
	for i in lim {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let tmp = g.res[0];
	g.res[0] = g.res[min_idx];
	g.res[min_idx] = tmp;
	g.steps += lim;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "swapped minimum: ", g.res[0]);
	out
}
@end
