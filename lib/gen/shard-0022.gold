@entry 6665f996dd96db48
kind: step
verb: measure
noun: values
modifier: last
context: loop
phrase: measure values span across trailing items count {count}
phrase: calculate range of last result values for size {count}
slot: count int
test: list=10,30,15,45 count=3
expect: => i=30 r=0.0 ok=true s="span: 30" errors=0 n=4 res=[10,30,15,45] cache=0 hits=0
test: list=5,25 count=2
expect: => i=20 r=0.0 ok=true s="span: 20" errors=0 n=2 res=[5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var start = g.n - c;
	if start < 0 { start = 0; }
	if start >= g.n {
		out.i = 0;
		out.s.clear();
		format(out.s, "span: 0");
		return out;
	}
	var min_v = g.res[start];
	var max_v = g.res[start];
	var i = start;
	while i < g.n {
		let x = g.res[i];
		if x < min_v { min_v = x; }
		if x > max_v { max_v = x; }
		i++;
	}
	let span = max_v - min_v;
	out.i = span;
	out.s.clear();
	format(out.s, "span: ", span);
	out
}
@end
