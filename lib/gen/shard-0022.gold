code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sz = ${size};
	if sz > g.n { sz = g.n; }
	for i in sz {
		var j = 0;
		while j + 1 < sz {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
