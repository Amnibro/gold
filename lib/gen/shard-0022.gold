fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${count};
	if g.n == 0 { return out; }
	let head_val = g.res[0];
	var old int[256] = [0; 256];
	let old_n = g.n;
	for i in old_n { old[i] = g.res[i]; }
	gold_clear(g);
	for i in reps {
		gold_push(g, head_val);
		gold_cache_put(g, i, head_val);
	}
	for i in old_n {
		gold_push(g, old[i]);
	}
	g.steps += reps + old_n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated head total=", g.n);
	out
}
