@entry b62d862ac9418930
kind: step
verb: keep
noun: cache
modifier: unique
context: sort
phrase: keep unique sorted values in cache table
phrase: store distinct sorted items in cache mapping
test: list=5,2,5,8,2,9
expect: => i=4 r=0.0 ok=true s="cached unique items: 4" errors=0 n=4 res=[2,5,8,9] cache=4 hits=0
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="cached unique items: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var u = 0;
	for i in g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			gold_cache_put(g, g.res[i], u);
			g.res[u] = g.res[i];
			u++;
		}
	}
	g.n = u;
	g.steps += g.n;
	out.i = u;
	out.s.clear();
	format(out.s, "cached unique items: ", u);
	out
}
@end
@entry e1f7da08ebb898c7
kind: step
verb: keep
noun: streak
modifier: with_retry
context: sort
phrase: keep longest nondecreasing sorted streak with retry
phrase: preserve largest ascending streak with sorting retry mechanism
test: list=1,3,2,4,5,6
expect: => i=4 r=0.0 ok=true s="streak length with retry: 4" errors=0 n=6 res=[1,3,2,4,5,6] cache=0 hits=0
test: list=10,9,8,7
expect: => i=4 r=0.0 ok=true s="streak length with retry: 4" errors=0 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var best_len = 1;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
			if cur_len > best_len { best_len = cur_len; }
		} else {
			cur_len = 1;
		}
	}
	if best_len < g.n / 2 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
				}
			}
		}
		best_len = g.n;
	}
	g.steps += g.n * 2;
	out.i = best_len;
	out.s.clear();
	format(out.s, "streak length with retry: ", best_len);
	out
}
@end
