@entry 9055a406ce47db9a
kind: step
verb: sort
noun: histogram
modifier: between
context: search
phrase: sort search histogram between score levels {lo} through {hi}
phrase: frequency sort search histogram buckets between {lo} with {hi}
slot: lo int
slot: hi int
test: list=1,2,2,3,3,3 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted histogram buckets: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=8,8,8,9,9,9,9 lo=8 hi=10
expect: => i=3 r=0.0 ok=true s="sorted histogram buckets: 3" errors=0 n=3 res=[0,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l > h || (h - l) > 16 {
		gold_fail(g, "histogram range invalid or too wide");
		out.ok = false;
		return out;
	}
	let span = h - l + 1;
	var counts = [0; 32];
	for k in g.n {
		let x = g.res[k];
		if x >= l && x <= h {
			counts[x - l]++;
		}
	}
	gold_clear(g);
	for c in span {
		gold_push(g, counts[c]);
	}
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += span * span;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted histogram buckets: ", g.n);
	out
}
@end
