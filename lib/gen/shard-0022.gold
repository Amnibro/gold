@entry e019c52ec8bab363
kind: step
verb: reverse
noun: head
modifier: times
context: loop
phrase: reverse head times in loop segment size {k}
phrase: invert leading loop head section of size {k}
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=3 r=0.0 ok=true s="reversed head segment: 3" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3,4 k=2
expect: => i=2 r=0.0 ok=true s="reversed head segment: 2" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var span = ${k};
	if span > g.n { span = g.n; }
	if span < 0 { span = 0; }
	var i = 0;
	var j = span - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed head segment: ", out.i);
	out
}
@end
