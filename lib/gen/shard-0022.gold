code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if g.n == 0 || cap <= 0 { return out; }
	var running = 0;
	var splits = 0;
	var chunk_sums = [0; 512];
	var count = 0;
	for i in g.n {
		running += g.res[i];
		if running >= cap {
			chunk_sums[count] = running;
			count++;
			running = 0;
			splits++;
		}
	}
	if running > 0 {
		chunk_sums[count] = running;
		count++;
	}
	g.n = 0;
	for j in count { gold_push(g, chunk_sums[j]); }
	out.i = splits;
	out.s.clear();
	format(out.s, "running splits: ", splits);
	out
}
@end
