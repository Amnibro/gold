test: list=5,4,3,2,1 budget=2
expect: => i=2 r=0.0 ok=true s="budget pairwise swaps: 2" errors=0 n=5 res=[4,3,5,2,1] cache=0 hits=0
test: list=5,4,3,2,1 budget=10
expect: => i=4 r=0.0 ok=true s="budget pairwise swaps: 4" errors=0 n=5 res=[4,3,2,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	if rem < 0 { rem = 0; }
	var swaps = 0;
	for i in (g.n - 1) {
		if rem <= 0 { break; }
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
			rem--;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "budget pairwise swaps: ", swaps);
	out
}
@end
