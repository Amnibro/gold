@entry 044c3045538988ef
kind: step
verb: sort
noun: total
modifier: with_retry
context: search
phrase: sort search results yielding total with retry {attempts}
phrase: order candidate search scores verifying total with retry {attempts}
slot: attempts int
test: list=45,12,88,23 attempts=2
expect: => i=168 r=0.0 ok=true s="sort total with_retry: 168" errors=0 n=4 res=[12,23,45,88] cache=0 hits=0
test: list=30,10,20 attempts=1
expect: => i=60 r=0.0 ok=true s="sort total with_retry: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var passes = 0;
	while passes < att {
		for i in g.n {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
				}
			}
		}
		passes++;
	}
	var sum_val = 0;
	for i in g.n { sum_val += g.res[i]; }
	out.i = sum_val;
	out.s.clear();
	format(out.s, "sort total with_retry: ", sum_val);
	out
}
@end
