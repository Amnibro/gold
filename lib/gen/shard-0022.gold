expect: => i=3 r=0.0 ok=true s="deduped running loop: 3" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "deduped running loop: ", g.n);
		return out;
	}
	var new_res = [0; 512];
	new_res[0] = g.res[0];
	var nn = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[i - 1] {
			new_res[nn] = g.res[i];
			nn++;
		}
		i++;
	}
	for k in nn { g.res[k] = new_res[k]; }
	g.n = nn;
	g.steps += g.n;
	out.i = nn;
	out.s.clear();
	format(out.s, "deduped running loop: ", nn);
	out
}
@end
