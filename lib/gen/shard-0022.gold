@entry 39c8373b3ad21a9c
kind: step
verb: apply
noun: condition
modifier: sorted
context: sort
phrase: apply sorted condition across {n} elements
phrase: test sorted condition for {n} values
slot: n int
test: n=3
expect: => i=3 r=0.0 ok=true s="sorted" errors=0 n=0 res=[] cache=0 hits=0
test: n=4
expect: => i=6 r=0.0 ok=true s="sorted" errors=0 n=0 res=[] cache=0 hits=0
test: n=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 1 || ${n} > 50 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var vals int[>..] = [];
	for q in ${n} {
		vals.push(${n} - q);
	}
	var passes = 0;
	for i in ${n} {
		var j = i;
		while j > 0 && vals[j - 1] > vals[j] {
			let tmp = vals[j];
			vals[j] = vals[j - 1];
			vals[j - 1] = tmp;
			j--;
			passes++;
		}
	}
	out.i = passes;
	out.s.clear();
	format(out.s, "sorted");
	out
}
@end
@entry 770183d61f64eb70
kind: step
verb: run
noun: steps
modifier: unique
context: sort
phrase: run unique sort steps across {n} elements
phrase: execute unique sort steps on {n} items
slot: n int
test: n=3
expect: => i=3 r=0.0 ok=true s="unique_steps" errors=0 n=0 res=[] cache=0 hits=0
test: n=4
expect: => i=4 r=0.0 ok=true s="unique_steps" errors=0 n=0 res=[] cache=0 hits=0
test: n=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 1 || ${n} > 50 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var vals int[>..] = [];
	for q in ${n} {
		vals.push(${n} - q);
	}
	var steps = 0;
	var swapped = true;
	while swapped {
		swapped = false;
		for i in ${n} - 1 {
			if vals[i] > vals[i + 1] {
				let tmp = vals[i];
				vals[i] = vals[i + 1];
				vals[i + 1] = tmp;
				swapped = true;
			}
		}
		steps++;
	}
	out.i = steps;
	out.s.clear();
	format(out.s, "unique_steps");
	out
}
@end
@entry 37ad245c4e056370
kind: step
verb: drop
noun: minimum
modifier: nested
context: sort
phrase: drop the nested minimum across {n} elements
phrase: extract minimum value from {n} nested passes
slot: n int
test: n=3
expect: => i=1 r=0.0 ok=true s="dropmin" errors=0 n=0 res=[] cache=0 hits=0
test: n=4
expect: => i=2 r=0.0 ok=true s="dropmin" errors=0 n=0 res=[] cache=0 hits=0
test: n=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 1 || ${n} > 50 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var vals int[>..] = [];
	for q in ${n} {
		vals.push(${n} - q);
	}
	var drops = 0;
	for i in ${n} {
		var min_idx = i;
		var j = i + 1;
		while j < ${n} {
			if vals[j] < vals[min_idx] {
				min_idx = j;
			}
			j++;
		}
		if min_idx != i {
			let t = vals[i];
			vals[i] = vals[min_idx];
			vals[min_idx] = t;
			drops++;
		}
	}
	out.i = drops;
	out.s.clear();
	format(out.s, "dropmin");
	out
}
@end
