expect: => i=117 r=0.0 ok=true s="swapped total at least: 117" errors=0 n=4 res=[60,5,50,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var first = -1;
	var last = -1;
	for i in g.n {
		if g.res[i] >= mv {
			if first < 0 { first = i; }
			last = i;
		}
	}
	if first >= 0 && last > first {
		let tmp = g.res[first];
		g.res[first] = g.res[last];
		g.res[last] = tmp;
	}
	var sm = 0;
	for i in g.n { sm += g.res[i]; }
	g.steps += g.n;
	out.i = sm;
	out.s.clear();
	format(out.s, "swapped total at least: ", sm);
	out
}
@end
