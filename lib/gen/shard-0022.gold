verb: check
noun: number
modifier: while
context: sort
slot: limit int
phrase: check number while below threshold {limit}
phrase: verify positivity of sorted items while under {limit}
test: list=5,2,8,1 limit=6
expect: => i=1 r=0.0 ok=true s="positive while under limit: 1" errors=0 n=4 res=[1,2,5,8] cache=0 hits=0
test: list=-3,2,6 limit=5
expect: => i=0 r=0.0 ok=false s="positive while under limit: 0" errors=0 n=3 res=[-3,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var all_pos = true;
	var idx = 0;
	while idx < g.n && g.res[idx] < lim {
		if g.res[idx] <= 0 { all_pos = false; break; }
		idx++;
	}
	out.ok = all_pos;
	out.i = if all_pos { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "positive while under limit: ", out.i);
	out
}
@end
