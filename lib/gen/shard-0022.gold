code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let is_asc = ${asc} > 0;
	for i in g.n {
		for j in g.n - 1 - i {
			if (is_asc && g.res[j] > g.res[j + 1]) || (!is_asc && g.res[j] < g.res[j + 1]) {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sort item each: ", g.n);
	out
}
@end
