fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${start};
	let th = ${threshold};
	if idx < 0 || idx >= g.n {
		gold_fail(g, "suffix start out of bounds");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = idx;
	while i < g.n {
		if g.res[i] >= th { total += g.res[i]; }
		i++;
	}
	gold_push(g, total);
	g.steps += (g.n - idx);
	out.i = total;
	out.s.clear();
	format(out.s, "joined qualified suffix: ", total);
	out
}
