phrase: format reverse checkpoint values bounded by {bound}
phrase: display reversed checkpoint items clamped to {bound}
slot: bound int
test: list=10,25,5 bound=15
expect: => i=15 r=0.0 ok=true s="rev clamped: [5, 15, 10]" errors=0 n=3 res=[10,25,5] cache=0 hits=0
test: list=40,20 bound=30
expect: => i=30 r=0.0 ok=true s="rev clamped: [20, 30]" errors=0 n=2 res=[40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let b = ${bound};
	var out = v;
	out.s.clear();
	format(out.s, "rev clamped: [");
	var idx = 0;
	var i = g.n - 1;
	while i >= 0 {
		if idx > 0 { format(out.s, ", "); }
		let val = if g.res[i] > b { b } else { g.res[i] };
		format(out.s, val);
		idx++;
		i--;
	}
	format(out.s, "]");
	out.i = b;
	g.steps += g.n;
	out
}
@end
@entry 32e1b495c55c708b
kind: step
verb: search
noun: histogram
modifier: with_cache
context: format
phrase: format cached peak histogram frequency count
phrase: display maximum histogram bin occurrence cached
test: list=1,2,2,3,2,1
expect: => i=3 r=0.0 ok=true s="peak freq: 3" errors=0 n=6 res=[1,2,2,3,2,1] cache=1 hits=0
test: list=5,5,5,5
expect: => i=4 r=0.0 ok=true s="peak freq: 4" errors=0 n=4 res=[5,5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var max_freq = 0;
	for i in g.n {
		let target = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == target { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	gold_cache_put(g, 0, max_freq);
	format(out.s, "peak freq: ", max_freq);
	out.i = max_freq;
	g.steps += g.n;
	out
}
@end
