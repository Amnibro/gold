fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var prime_sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= limit {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_prime = false; break; }
				d++;
			}
			if is_prime { prime_sum += x; }
		}
	}
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "sum primes up_to: ", prime_sum);
	out
}
@end
