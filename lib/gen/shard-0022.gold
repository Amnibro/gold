fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	var times = ${k};
	if times < 1 { times = 1; }
	for t in times {
		if g.res[mid - 1] > g.res[mid] {
			let tmp = g.res[mid - 1];
			g.res[mid - 1] = g.res[mid];
			g.res[mid] = tmp;
		}
	}
	g.steps += times;
	out.i = g.res[mid];
	out.s.clear();
	format(out.s, "paired middle element: ", g.res[mid]);
	out
}
@end
