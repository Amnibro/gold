fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = 0;
	var neg = 0;
	var zero_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x > 0 { pos++; }
		else if x < 0 { neg++; }
		else { zero_cnt++; }
	}
	g.n = 0;
	gold_push(g, pos);
	gold_push(g, neg);
	gold_push(g, zero_cnt);
	out.i = pos;
	out.s.clear();
	format(out.s, "group tally any: ", pos);
	out
}
@end
