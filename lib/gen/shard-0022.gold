fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 1;
	while i < g.n {
		g.res[w] = g.res[i];
		w++;
		i += 2;
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "returned tail every other count: ", w);
	out
}
@end
