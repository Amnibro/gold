	for i in m {
		for j in (i + 1)..m {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	for i in m..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[a] > g.res[b] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged checkpoint halves: ", g.n);
	out
}
