noun: duplicates
modifier: times
context: search
phrase: repeat search duplicates count times {times}
phrase: amplify duplicated search hits times {times}
slot: times int
test: list=5,8,5,12 times=1
expect: => i=6 r=0.0 ok=true s="expanded duplicate hits: 6" errors=0 n=6 res=[5,5,8,5,5,12] cache=0 hits=0
test: list=3,3,7 times=2
expect: => i=7 r=0.0 ok=true s="expanded duplicate hits: 7" errors=0 n=7 res=[3,3,3,3,3,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t < 0 {
		gold_fail(g, "negative repeat multiplier");
		out.ok = false;
		return out;
	}
	var counts = [0; 512];
	for i in g.n {
		for j in g.n {
			if g.res[j] == g.res[i] { counts[i]++; }
		}
	}
	var new_res = [0; 512];
	var nn = 0;
	for i in g.n {
		if nn < 512 { new_res[nn] = g.res[i]; nn++; }
		if counts[i] > 1 {
			for k in t {
				if nn < 512 { new_res[nn] = g.res[i]; nn++; }
			}
		}
	}
	for i in nn { g.res[i] = new_res[i]; }
	g.n = nn;
	g.steps += nn;
	out.i = nn;
	out.s.clear();
	format(out.s, "expanded duplicate hits: ", nn);
	out
}
@end
