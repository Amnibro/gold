code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if d <= 0 {
		gold_fail(g, "divisor must be positive");
		out.ok = false;
		return out;
	}
	var new_res int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n && count + 2 <= 512 {
		let x = g.res[i];
		new_res[count] = x / d;
		new_res[count + 1] = x % d;
		count += 2;
		i++;
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split values total count: ", count);
	out
}
@end
