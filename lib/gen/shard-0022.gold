code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${k};
	if len <= 1 || len > g.n {
		gold_fail(g, "invalid running prefix length");
		out.ok = false;
		return out;
	}
	let first = g.res[0];
	var i = 0;
	while i < len - 1 {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[len - 1] = first;
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "rotated running prefix: ", len);
	out
}
@end
@entry 2fd6490ab1bdc960
kind: step
verb: repeat
noun: condition
modifier: any
context: search
phrase: repeat search hits matching condition {p} by count {count}
phrase: duplicate any search match for condition {p} instances {count}
slot: p pred
slot: count int
test: list=3,4,5,6 p=is_even count=2
expect: => i=2 r=0.0 ok=true s="repeated conditioned hits: 2" errors=0 n=6 res=[3,4,4,5,6,6] cache=0 hits=0
test: list=1,2,7,8 p=is_even count=3
expect: => i=2 r=0.0 ok=true s="repeated conditioned hits: 2" errors=0 n=8 res=[1,2,2,2,7,8,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		gold_fail(g, "invalid repeat condition count");
		out.ok = false;
		return out;
	}
	var new_res = [0; 512];
	var nn = 0;
	var matched = 0;
	for k in g.n {
		let x = g.res[k];
		if ${p}(x) {
			matched++;
			for j in c {
				if nn < 512 { new_res[nn] = x; nn++; }
			}
		} else {
			if nn < 512 { new_res[nn] = x; nn++; }
		}
	}
	for k in nn { g.res[k] = new_res[k]; }
	g.n = nn;
	g.steps += nn;
	out.i = matched;
	out.s.clear();
	format(out.s, "repeated conditioned hits: ", matched);
	out
}
@end
