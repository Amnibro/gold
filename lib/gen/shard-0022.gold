test: list=5,6,7 min_count=2
expect: => i=0 r=0.0 ok=true s="grouped 0 frequent error bins" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var valid int[512] = [0; 512];
	var vn = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq >= mc {
			var seen = false;
			for k in vn {
				if valid[k] == g.res[i] { seen = true; break; }
			}
			if !seen {
				valid[vn] = g.res[i];
				vn++;
			}
		}
	}
	gold_clear(g);
	for k in vn {
		gold_push(g, valid[k]);
	}
	g.steps += g.n;
	out.i = vn;
	out.s.clear();
	format(out.s, "grouped ", vn, " frequent error bins");
	out
}
@end
