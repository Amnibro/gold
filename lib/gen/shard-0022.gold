expect: => img: 16x16 min=0 max=1 sum8=2295 hash=489357
test: img=32 u=8
expect: => i=1024 r=0.0 ok=true s="marble" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=165490 hash=632626
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0_0 = 8;
	for o in 2 { if !gold_img_square(g, c0_0) { out.ok = false; return out; } c0_0 = c0_0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.55 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	var s2_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "marble");
	out
}
@end
