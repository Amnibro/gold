@entry a03a122b3353db83
kind: step
verb: merge
noun: numbers
modifier: last
context: loop
phrase: merge numbers last segment in loop count {count}
phrase: sum trailing numbers in loop of size {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=70 r=0.0 ok=true s="merged trailing numbers: 70" errors=0 n=3 res=[10,20,70] cache=0 hits=0
test: list=1,2,3,4,5 count=3
expect: => i=12 r=0.0 ok=true s="merged trailing numbers: 12" errors=0 n=3 res=[1,2,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${count};
	if cnt > g.n { cnt = g.n; }
	if cnt <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "merged trailing numbers: 0");
		return out;
	}
	var sum = 0;
	var i = g.n - cnt;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.n = g.n - cnt;
	gold_push(g, sum);
	g.steps += cnt;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged trailing numbers: ", out.i);
	out
}
@end
@entry 3e0f98d1601d6d98
