@entry 37b59483f9a76258
kind: step
verb: fold
noun: average
modifier: in_reverse
context: retry
phrase: fold average in_reverse weighted retry backoff sequence
phrase: compute reverse weighted average of retry delays
test: list=10,20,30,40
expect: => i=20 r=0.0 ok=true s="reverse weighted average: 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25
expect: => i=11 r=0.0 ok=true s="reverse weighted average: 11" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var weighted_sum = 0;
	var total_weight = 0;
	var i = g.n - 1;
	var weight = 1;
	while i >= 0 {
		weighted_sum += g.res[i] * weight;
		total_weight += weight;
		weight++;
		if i == 0 { break; }
		i--;
	}
	let avg = weighted_sum / total_weight;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "reverse weighted average: ", avg);
	out
}
@end
@entry 9caecdc531758a04
kind: step
verb: search
noun: window
modifier: none
context: retry
slot: size int
phrase: search window none find minimum sum window of {size}
phrase: locate smallest cumulative retry interval window of span {size}
test: list=10,5,20,3,15 size=2
expect: => i=15 r=0.0 ok=true s="minimum window sum: 15" errors=0 n=5 res=[10,5,20,3,15] cache=0 hits=0
test: list=8,12,4,6,10,3 size=3
expect: => i=19 r=0.0 ok=true s="minimum window sum: 19" errors=0 n=6 res=[8,12,4,6,10,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n < w {
		gold_fail(g, "search window none: window exceeds list length");
		out.ok = false;
		return out;
	}
	var cur_sum = 0;
	var j = 0;
	while j < w {
		cur_sum += g.res[j];
		j++;
	}
	var min_sum = cur_sum;
	var i = 1;
	while i + w <= g.n {
		cur_sum = cur_sum - g.res[i - 1] + g.res[i + w - 1];
		if cur_sum < min_sum { min_sum = cur_sum; }
		i++;
	}
	g.steps += g.n;
	out.i = min_sum;
	out.s.clear();
	format(out.s, "minimum window sum: ", min_sum);
	out
}
@end
