fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		g.res[i] = g.res[i] + g.res[i + 1] + s;
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired: ", out.i);
	out
}
@end
@entry 730b460f29145eb1
kind: step
verb: retry
noun: duplicates
modifier: between
context: transform
phrase: retry duplicates between {low} with {high}
phrase: between duplicates retry range {low} to {high}
slot: low int
slot: high int
test: list=1,2,2,3,4,4,5 low=2 high=4
expect: => i=2 r=0.0 ok=true s="duplicates between: 2" errors=0 n=7 res=[1,2,2,3,4,4,5] cache=0 hits=0
test: list=10,10,20,20,30 low=5 high=25
expect: => i=2 r=0.0 ok=true s="duplicates between: 2" errors=0 n=5 res=[10,10,20,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var dups = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			if g.res[i] >= lo && g.res[i] <= hi {
				dups++;
			}
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicates between: ", dups);
	out
}
@end
