	var out = v;
	let ms = ${min_score};
	var rank_count = 0;
	for i in g.n {
		if g.res[i] >= ms { rank_count++; } else { break; }
	}
	out.i = rank_count;
	out.s.clear();
	format(out.s, "rank while: ", rank_count);
	out
}
@end
