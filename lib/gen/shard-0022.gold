@entry 516a41ade4654ba3
kind: step
verb: normalize
noun: tail
modifier: between
context: error
phrase: normalize tail errors between limits {lo} to {hi}
phrase: clamp trailing fault scores between limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,20,5,50 lo=10 hi=40
expect: => i=2 r=0.0 ok=true s="clamped 2 tail error scores" errors=0 n=4 res=[10,20,10,40] cache=0 hits=0
test: list=10,20,30 lo=5 hi=35
expect: => i=0 r=0.0 ok=true s="clamped 0 tail error scores" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l > h {
		gold_fail(g, "invalid tail normalization bounds");
		out.ok = false;
		return out;
	}
	let start = g.n / 2;
	var modified = 0;
	var i = start;
	while i < g.n {
		if g.res[i] < l {
			g.res[i] = l;
			modified++;
		} else if g.res[i] > h {
			g.res[i] = h;
			modified++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " tail error scores");
	out
}
@end
