@entry 62e95e78447c3f03
kind: step
verb: cache
noun: primes
modifier: unique
context: transform
phrase: cache unique prime elements from sequence
phrase: record unique primes into cache storage
test: list=2,3,4,5,2,3,7,8
expect: => i=4 r=0.0 ok=true s="cached unique primes: 4" errors=0 n=8 res=[2,3,4,5,2,3,7,8] cache=4 hits=2
test: list=4,6,8,9,10
expect: => i=0 r=0.0 ok=true s="cached unique primes: 0" errors=0 n=5 res=[4,6,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if core_is_prime(x) {
			let _, has = gold_cache_get(g, x);
			if !has {
				gold_cache_put(g, x, count + 1);
				count++;
			}
		}
		i++;
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached unique primes: ", count);
	out
}
@end
@entry dca49b655bde8417
kind: step
verb: run
noun: streak
modifier: at_most
context: transform
slot: max_len int
phrase: run sequence capping consecutive streak at most {max_len}
phrase: truncate repeating element streak at most {max_len}
test: list=5,5,5,5,2,2,2 max_len=2
expect: => i=4 r=0.0 ok=true s="streak capped total items: 4" errors=0 n=4 res=[5,5,2,2] cache=0 hits=0
test: list=1,1,2,3,3,3,3 max_len=1
expect: => i=3 r=0.0 ok=true s="streak capped total items: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if lim <= 0 {
		gold_fail(g, "streak limit must be positive");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var streak = 1;
		while i + 1 < g.n && g.res[i + 1] == x {
			streak++;
			i++;
		}
		let take = if streak < lim { streak } else { lim };
		var k = 0;
		while k < take {
			g.res[kept] = x;
			kept++;
			k++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n + kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "streak capped total items: ", kept);
	out
}
@end
