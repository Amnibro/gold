fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var errs = 0;
	var pos = 0;
	for i in g.n {
		if g.res[i] < 0 {
			errs++;
			pos = i + 1;
			if errs >= lim { break; }
		}
	}
	g.steps += g.n;
	out.i = errs;
	out.s.clear();
	format(out.s, "scanned errors: ", errs);
	out
}
