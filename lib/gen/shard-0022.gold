code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${err_code};
	var shifts = 0;
	while g.n > 0 && g.res[0] == target && shifts < g.n {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted ", shifts, " matching elements");
	out
}
@end
