	var kn = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= 0 { kept[kn] = g.res[i]; kn++; }
		i--;
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "filter errors in_reverse: ", kn);
	out
}
@end
@entry 77acda6d86535f49
kind: step
verb: clamp
noun: tail
modifier: unique
context: search
phrase: clamp unique tail search candidates {k} to limit {cap}
phrase: restrict unique trailing search scores count {k} ceiling {cap}
slot: k int
slot: cap int
test: list=10,20,80,90,80 k=3 cap=50
expect: => i=3 r=0.0 ok=true s="clamp tail: 3" errors=0 n=5 res=[10,20,50,50,50] cache=0 hits=0
test: list=5,15,65,75 k=2 cap=60
expect: => i=2 r=0.0 ok=true s="clamp tail: 2" errors=0 n=4 res=[5,15,60,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k_len = ${k};
	let c = ${cap};
	let start = if g.n >= k_len { g.n - k_len } else { 0 };
	var clamped = 0;
	for i in g.n - start {
		let idx = start + i;
		if g.res[idx] > c {
			g.res[idx] = c;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamp tail: ", clamped);
	out
}
@end
@entry 5ddd04fb8821a335
