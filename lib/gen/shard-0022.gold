@entry c19d48e1fbbfbeb4
kind: step
verb: pair
noun: gaps
modifier: while
context: transform
phrase: pair gaps while under {max_gap}
phrase: while pair gaps within {max_gap}
slot: max_gap int
test: list=1,3,5,10,12 max_gap=3
expect: => i=2 r=0.0 ok=true s="valid gaps count: 2" errors=0 n=2 res=[2,2] cache=0 hits=0
test: list=2,5,9,20,22 max_gap=4
expect: => i=2 r=0.0 ok=true s="valid gaps count: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 { return out; }
	var new_n = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= mg {
			g.res[new_n] = abs_diff;
			new_n++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "valid gaps count: ", new_n);
	out
}
@end
