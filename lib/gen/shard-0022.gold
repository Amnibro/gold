fn ${ID}(g Gold&, v Val) Val {
	let c = ${cap};
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "mid: 0");
		out.i = 0;
		return out;
	}
	let mid_val = g.res[g.n / 2];
	let clamped = if mid_val > c { c } else { mid_val };
	format(out.s, "mid: ", clamped);
	out.i = clamped;
	g.steps += g.n;
	out
}
@end
