fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let fac = ${factor};
	var any_over = false;
	for k in g.n {
		if g.res[k] > lim {
			any_over = true;
			break;
		}
	}
	var scaled = 0;
	if any_over {
		for k in g.n {
			if g.res[k] > lim {
				g.res[k] *= fac;
				scaled++;
			}
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "elements mapped above limit: ", out.i);
	out
}
@end
