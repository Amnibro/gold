	let limit = ${lim};
	var valid = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x <= limit {
			gold_cache_put(g, x, 1);
			valid++;
		}
	}
	g.steps += g.n;
	out.i = valid;
	out.s.clear();
	format(out.s, "validated ", valid, " evens");
	out
}
@end
