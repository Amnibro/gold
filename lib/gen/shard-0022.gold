kind: step
verb: search
noun: text
modifier: with_cache
context: retry
slot: code int
phrase: search text with_cache for retry status code {code}
phrase: check retry log text for code {code} using cache
test: text="retry error 503 timeout" code=101
expect: => i=3 r=0.0 ok=true s="searched retry text occurrences: 3" errors=0 n=0 res=[] cache=1 hits=0
test: text="attempt ok 200 success" code=120
expect: => i=0 r=0.0 ok=true s="searched retry text occurrences: 0" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${code};
	let cached, ok = gold_cache_get(g, c);
	if ok {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached retry status lookup: ", cached);
		return out;
	}
	var found = 0;
	for b in out.s {
		if b as int == c {
			found++;
		}
	}
	gold_cache_put(g, c, found);
	g.steps += out.s.len;
	out.i = found;
	out.s.clear();
	format(out.s, "searched retry text occurrences: ", found);
	out
}
@end
