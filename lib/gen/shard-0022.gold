fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end};
	if s < 0 || e >= g.n || s > e {
		gold_fail(g, "invalid rank range");
		out.ok = false;
		return out;
	}
	var mx = g.res[s];
	for k in s + 1..e + 1 {
		if g.res[k] > mx { mx = g.res[k]; }
	}
	out.i = mx;
	out.s.clear();
	format(out.s, "ranked maximum between");
	out
}
@end
