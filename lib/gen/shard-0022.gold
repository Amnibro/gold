code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] <= b {
			total += g.res[i];
			g.res[count] = g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "selected within budget: ", count);
	out
}
@end
