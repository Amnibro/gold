fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${lim};
	if l > g.n { l = g.n; }
	if l <= 1 { return out; }
	var inv = 0;
	for i in l {
		for j in (i + 1)..l {
			if g.res[i] > g.res[j] { inv++; }
		}
	}
	g.steps += l * l;
	out.i = inv;
	out.s.clear();
	format(out.s, "checkpoint violations: ", inv);
	out
}
@end
@entry 6704b9e1881bb3f0
kind: step
verb: merge
noun: histogram
modifier: at_least
context: sort
phrase: merge histogram buckets with frequency at least {thresh}
phrase: collect items having counts at least {thresh} into sorted list
slot: thresh int
test: list=3,1,3,2,1,3,4 thresh=2
expect: => i=2 r=0.0 ok=true s="frequent items merged: 2" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=5,5,8,9 thresh=3
expect: => i=0 r=0.0 ok=true s="frequent items merged: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var w = 0;
	var i = 0;
	while i < g.n {
		var count = 1;
		while i + 1 < g.n && g.res[i] == g.res[i + 1] {
			count++;
			i++;
		}
		if count >= th {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	g.steps += g.n * 2;
	out.i = w;
	out.s.clear();
	format(out.s, "frequent items merged: ", w);
	out
}
@end
