fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < out.s.len {
		let tmp = out.s[i];
		out.s[i] = out.s[i + 1];
		out.s[i + 1] = tmp;
		i += 2;
	}
	out.i = out.s.len;
	out
}
@end
