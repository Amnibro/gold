expect: => i=2 r=0.0 ok=true s="split tally at_most: 2" errors=0 n=5 res=[15,22,40,70,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var lo = [0; 512];
	var hi = [0; 512];
	var n_lo = 0;
	var n_hi = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= t { lo[n_lo] = x; n_lo++; }
		else { hi[n_hi] = x; n_hi++; }
	}
	g.n = 0;
	for i in n_lo { gold_push(g, lo[i]); }
	for i in n_hi { gold_push(g, hi[i]); }
	out.i = n_lo;
	out.s.clear();
	format(out.s, "split tally at_most: ", n_lo);
	out
}
@end
@entry e5dd7bdd9a152e85
kind: step
verb: shift
noun: tally
modifier: first
context: list
phrase: shift tally first match to tail target {key}
phrase: reposition tally first match value {key}
slot: key int
test: list=10,25,30,25,40 key=25
expect: => i=1 r=0.0 ok=true s="shift tally first: 1" errors=0 n=5 res=[10,30,25,40,25] cache=0 hits=0
test: list=5,8,12,8,20 key=8
expect: => i=1 r=0.0 ok=true s="shift tally first: 1" errors=0 n=5 res=[5,12,8,20,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var found = -1;
	for i in g.n {
		if g.res[i] == k { found = i; break; }
	}
	if found >= 0 && found < g.n - 1 {
		let val = g.res[found];
		for i in g.n - 1 - found {
			g.res[found + i] = g.res[found + i + 1];
		}
		g.res[g.n - 1] = val;
		out.i = 1;
	} else if found == g.n - 1 {
		out.i = 1;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "shift tally first: ", out.i);
	out
}
@end
