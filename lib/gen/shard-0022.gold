fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var steps_traced = 0;
	var i = 0;
	while i < g.n && sum < lim {
		sum += g.res[i];
		steps_traced++;
		i++;
	}
	g.steps += steps_traced;
	out.i = sum;
