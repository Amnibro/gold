	if g.n <= 0 { return out; }
	var count = 1;
	while count < g.n {
		if g.res[count] < g.res[count - 1] { break; }
		count++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "split sequence while: ", count);
	out
}
@end
