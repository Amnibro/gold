fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit_count};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let take = if lim < g.n { lim } else { g.n };
	g.n = take;
	g.steps += g.n * g.n;
	out.i = take;
	out.s.clear();
	format(out.s, "top sorted items found: ", take);
	out
}
