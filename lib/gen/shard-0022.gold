fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tol};
	if g.n < 2 { return out; }
	var jump_errors = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > tol { jump_errors++; }
