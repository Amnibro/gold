context: loop
phrase: check total running loop sum bounded by {limit}
phrase: verify running total throughout loop stays below {limit}
slot: limit int
test: list=10,20,30 limit=100
expect: => i=60 r=0.0 ok=true s="running total checked: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
