@entry 1459848c4661f915
kind: step
verb: sum
noun: window
modifier: in_reverse
context: transform
slot: size int
phrase: sum sliding window of size {size} in reverse order
phrase: accumulate window values of width {size} backwards
test: list=1,2,3,4,5 size=2
expect: => i=4 r=0.0 ok=true s="reversed window sums count: 4" errors=0 n=4 res=[9,7,5,3] cache=0 hits=0
test: list=10,20,30,40 size=3
expect: => i=2 r=0.0 ok=true s="reversed window sums count: 2" errors=0 n=2 res=[90,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var new_res int[512] = [0; 512];
	var count = 0;
	var i = g.n - w;
	while i >= 0 {
		var s = 0;
		var j = 0;
		while j < w {
			s += g.res[i + j];
			j++;
		}
		new_res[count] = s;
		count++;
		i--;
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += count * w;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed window sums count: ", count);
	out
}
@end
