	let limit = ${cap};
	var odds int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 && on < limit {
			odds[on] = g.res[i];
			on++;
		}
	}
	gold_clear(g);
	for i in on {
		gold_push(g, odds[i]);
	}
	g.steps += g.n;
	out.i = on;
	out.s.clear();
	format(out.s, "collected ", on, " odd error codes");
