kind: step
verb: fold
noun: list
modifier: at_least
context: math
phrase: fold math list values at least {threshold}
phrase: sum math list items at least {threshold}
slot: threshold int
test: list=5,12,18,3,25 threshold=10
expect: => i=55 r=0.0 ok=true s="folded list at least" errors=0 n=5 res=[5,12,18,3,25] cache=0 hits=0
test: list=1,2,3,4,5 threshold=3
expect: => i=12 r=0.0 ok=true s="folded list at least" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= th {
			sum += x;
			count++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded list at least");
	out
}
@end
@entry fae418d60e90e3b6
kind: step
verb: return
noun: memo
modifier: in_place
context: math
phrase: return memoized math in place
phrase: apply cached memo math in place
test: list=4,8,12
expect: => i=0 r=0.0 ok=true s="memo applied in place" errors=0 n=3 res=[4,8,12] cache=3 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="memo applied in place" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var updated = 0;
	for k in g.n {
		let x = g.res[k];
		let val, ok = gold_cache_get(g, x);
		if ok {
			g.res[k] = val;
			updated++;
		} else {
			gold_cache_put(g, x, x * 2);
		}
	}
	out.i = updated;
	out.s.clear();
	format(out.s, "memo applied in place");
	out
}
@end
@entry 3ad53fab44747ba6
kind: step
verb: validate
noun: window
modifier: pairwise
context: math
phrase: validate pairwise math window order
phrase: verify adjacent math window pairs
test: list=1,3,5,7,9
expect: => i=5 r=0.0 ok=true s="pairwise window valid" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=2,4,3,8
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[2,4,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.s.clear(); format(out.s, "pairwise window valid"); return out; }
	var valid = true;
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			valid = false;
			break;
		}
	}
	if !valid {
		gold_fail(g, "window order violated");
		out.ok = false;
		return out;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise window valid");
	out
}
@end
@entry b3b62009481b2bfd
kind: step
verb: join
noun: range
modifier: sorted
context: math
phrase: join sorted math range {lo} to {hi}
phrase: collect sorted values in math range {lo} through {hi}
slot: lo int
slot: hi int
test: list=15,3,22,8,11,40 lo=5 hi=25
expect: => i=4 r=0.0 ok=true s="joined sorted range" errors=0 n=4 res=[8,11,15,22] cache=0 hits=0
test: list=100,50,20,80,60 lo=40 hi=90
expect: => i=3 r=0.0 ok=true s="joined sorted range" errors=0 n=3 res=[50,60,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var filtered = [0; 512];
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= low && x <= high {
			filtered[count] = x;
			count++;
		}
	}
	for i in count {
		for j in i + 1..count {
			if filtered[j] < filtered[i] {
				let t = filtered[i];
				filtered[i] = filtered[j];
				filtered[j] = t;
			}
		}
	}
	gold_clear(g);
	for k in count { gold_push(g, filtered[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "joined sorted range");
	out
}
@end
@entry 7fefd5d2e500301c
kind: step
verb: rotate
noun: counter
modifier: every_other
context: math
phrase: rotate every other math counter
phrase: cycle alternate math counter positions
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="rotated counter every other" errors=0 n=6 res=[5,2,1,4,3,6] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="rotated counter every other" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let even_count = (g.n + 1) / 2;
	if even_count <= 1 { out.s.clear(); format(out.s, "counter rotate skipped"); return out; }
	let last_even = g.res[(even_count - 1) * 2];
	var i = even_count - 1;
	while i > 0 {
		g.res[i * 2] = g.res[(i - 1) * 2];
		i--;
	}
	g.res[0] = last_even;
	out.i = even_count;
	out.s.clear();
	format(out.s, "rotated counter every other");
	out
}
@end
