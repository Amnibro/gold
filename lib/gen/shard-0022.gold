expect: => i=3 r=0.0 ok=true s="paired histogram buckets: 3" errors=0 n=6 res=[1,2,2,1,3,3] cache=0 hits=0
test: list=7,7,9
expect: => i=2 r=0.0 ok=true s="paired histogram buckets: 2" errors=0 n=4 res=[7,2,9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var temp int[512] = [0; 512];
	var w = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var count = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			count++;
			i++;
		}
		temp[w] = val;
		temp[w + 1] = count;
		w += 2;
		i++;
	}
	for k in w { g.res[k] = temp[k]; }
	g.n = w;
	g.steps += g.n * 2;
	out.i = w / 2;
	out.s.clear();
	format(out.s, "paired histogram buckets: ", out.i);
	out
}
@end
