code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, ok = gold_cache_get(g, k);
	if ok {
		out.i = val;
		out.ok = true;
		out.s.clear();
		format(out.s, "found in cache: ", val);
	} else {
		let fallback = if k >= 0 && k < g.n { g.res[k] } else { 0 };
		gold_cache_put(g, k, fallback);
		out.i = fallback;
		out.ok = false;
		out.s.clear();
		format(out.s, "fallback cached: ", fallback);
	}
	g.steps++;
	out
}
@end
@entry 1b6d459ba756b14f
kind: step
verb: reverse
noun: gaps
modifier: with_retry
context: stats
phrase: reverse order of adjacent difference gaps
phrase: invert consecutive gaps across sample
test: list=1,4,10,20
expect: => i=3 r=0.0 ok=true s="reversed 3 gaps" errors=0 n=3 res=[10,6,3] cache=0 hits=0
test: list=5,15,30
expect: => i=2 r=0.0 ok=true s="reversed 2 gaps" errors=0 n=2 res=[15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var count = g.n - 1;
		for i in count {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = count;
		var a = 0;
		var b = g.n - 1;
		while a < b {
			let tmp = g.res[a];
			g.res[a] = g.res[b];
			g.res[b] = tmp;
			a++;
			b--;
		}
		out.i = g.n;
		out.s.clear();
		format(out.s, "reversed ", g.n, " gaps");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps");
	}
	g.steps += g.n;
	out
}
@end
