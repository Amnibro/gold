expect: => i=5 r=0.0 ok=true s="sum window in_place: 5" errors=0 n=5 res=[15,25,35,45,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${w};
	if w <= 0 || g.n < w { return out; }
	var rolled = [0; 512];
	var nr = g.n - w + 1;
	for i in nr {
		var s = 0;
		for j in w { s += g.res[i + j]; }
		rolled[i] = s;
	}
	g.n = 0;
	for i in nr { gold_push(g, rolled[i]); }
	out.i = nr;
	out.s.clear();
	format(out.s, "sum window in_place: ", nr);
	out
}
@end
