fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "list is empty");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= ${min} {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered: ", kept);
	out
}
@end
