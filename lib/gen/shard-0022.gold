expect: => i=12 r=0.0 ok=true s="repeated max=12 3 times" errors=0 n=3 res=[4,12,8] cache=3 hits=0
test: list=19,5,11,14 k=4
expect: => i=19 r=0.0 ok=true s="repeated max=19 4 times" errors=0 n=4 res=[19,5,11,14] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${k};
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	for i in times {
		gold_cache_put(g, i, max_val);
	}
	g.steps += g.n + times;
	out.i = max_val;
	out.s.clear();
	format(out.s, "repeated max=", max_val, " ", times, " times");
	out
}
@end
@entry 85b2dcce386f71d6
kind: step
verb: dedupe
noun: history
modifier: nested
context: cache
phrase: dedupe nested history entries in cache
phrase: filter nested history records removing duplicates
test: list=5,8,5,12,8,3
expect: => i=4 r=0.0 ok=true s="deduped history count=4" errors=0 n=4 res=[5,8,12,3] cache=4 hits=2
test: list=10,20,10,30,20,40
expect: => i=4 r=0.0 ok=true s="deduped history count=4" errors=0 n=4 res=[10,20,30,40] cache=4 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = 0;
	var tmp int[512] = [0; 512];
	while i < g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			tmp[unique_count] = x;
			unique_count++;
		}
		i++;
	}
	gold_clear(g);
	for j in unique_count {
		gold_push(g, tmp[j]);
	}
	g.steps += i;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "deduped history count=", unique_count);
	out
}
@end
@entry ebbd62583829e343
kind: step
verb: rotate
noun: odds
modifier: between
context: cache
phrase: rotate odd values between indices {lo} to {hi}
phrase: shift odds positioned from {lo} to {hi}
slot: lo int
slot: hi int
test: list=1,3,5,7,9 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="rotated 3 odds" errors=0 n=5 res=[1,7,3,5,9] cache=3 hits=0
test: list=11,13,15,17,19 lo=0 hi=4
expect: => i=5 r=0.0 ok=true s="rotated 5 odds" errors=0 n=5 res=[19,11,13,15,17] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var odd_pos int[256] = [0; 256];
	var odd_val int[256] = [0; 256];
	var count = 0;
	var i = low;
	while i <= high && i < g.n {
		if g.res[i] % 2 != 0 {
			odd_pos[count] = i;
			odd_val[count] = g.res[i];
			count++;
		}
		i++;
	}
	if count > 1 {
		let last_val = odd_val[count - 1];
		var j = count - 1;
		while j > 0 {
			g.res[odd_pos[j]] = odd_val[j - 1];
			gold_cache_put(g, odd_pos[j], odd_val[j - 1]);
			j--;
		}
		g.res[odd_pos[0]] = last_val;
		gold_cache_put(g, odd_pos[0], last_val);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated ", count, " odds");
	out
}
@end
@entry e73b0424a3cc1271
kind: step
verb: rank
noun: items
modifier: sorted
context: cache
phrase: rank list items into sorted sequence
phrase: order items by rank in sorted sequence
test: list=35,12,77,21
expect: => i=4 r=0.0 ok=true s="ranked 4 items sorted" errors=0 n=4 res=[12,21,35,77] cache=4 hits=0
test: list=50,15,80,42,10
expect: => i=5 r=0.0 ok=true s="ranked 5 items sorted" errors=0 n=5 res=[10,15,42,50,80] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i + 1, g.res[i]);
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items sorted");
	out
}
@end
