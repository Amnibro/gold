code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > b {
			g.res[i] = b;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped attempts to bound: ", clamped);
	out
}
@end
@entry 09410667c5945527
kind: step
verb: repeat
noun: suffix
modifier: at_least
context: retry
slot: min_len int
phrase: repeat suffix at_least minimum window size {min_len}
phrase: duplicate tail retry attempts to reach length {min_len}
test: list=10,20,30 min_len=6
expect: => i=6 r=0.0 ok=true s="repeated suffix to length: 6" errors=0 n=6 res=[10,20,30,30,30,30] cache=0 hits=0
test: list=5,15 min_len=5
expect: => i=5 r=0.0 ok=true s="repeated suffix to length: 5" errors=0 n=5 res=[5,15,15,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${min_len};
	if g.n == 0 || target_len <= g.n { return out; }
	let last = g.res[g.n - 1];
	var added = 0;
	while g.n < target_len && g.n < 512 {
		gold_push(g, last);
		added++;
	}
	g.steps += added;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated suffix to length: ", g.n);
	out
}
@end
@entry 4d91624b527b892a
kind: step
verb: filter
noun: text
modifier: at_most
context: retry
slot: max_len int
phrase: filter text at_most maximum characters {max_len}
phrase: truncate retry failure diagnostic message to length {max_len}
test: text="critical network timeout failure on worker node" max_len=16
expect: => i=16 r=0.0 ok=true s="critical network" errors=0 n=0 res=[] cache=0 hits=0
test: text="short err" max_len=20
expect: => i=9 r=0.0 ok=true s="short err" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if lim < 0 {
		gold_fail(g, "filter text at_most: negative limit");
		out.ok = false;
		return out;
	}
	if out.s.len > lim {
		var truncated byte[..200] = "";
		var i = 0;
		while i < lim {
			truncated.push(out.s[i]);
			i++;
		}
		out.s.clear();
		for b in truncated { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
