code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${penalty};
	for i in g.n {
		g.res[i] += g.errors * p;
	}
	out.i = g.errors;
	out.s.clear();
	format(out.s, "error penalty applied: ", out.i);
	out
}
@end
@entry 29c61a8e5dc165a5
kind: step
verb: map
noun: words
modifier: while
context: loop
phrase: map words in loop sequence while values stay below {cap}
phrase: transform word token representations while bounded by {cap}
slot: cap int
test: list=2,4,6,8,10 cap=7
expect: => i=3 r=0.0 ok=true s="mapped words: 3" errors=0 n=5 res=[4,8,12,8,10] cache=0 hits=0
test: list=1,3,5,7 cap=4
expect: => i=2 r=0.0 ok=true s="mapped words: 2" errors=0 n=4 res=[2,6,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var modified = 0;
	for i in g.n {
		if g.res[i] < c {
			g.res[i] *= 2;
			modified++;
		} else {
			break;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped words: ", modified);
	out
}
@end
@entry c40024fc4efc111a
kind: step
verb: select
noun: subfunction
modifier: in_reverse
context: loop
phrase: select elements matching subfunction criterion in reverse with limit {limit}
phrase: pick qualifying subfunction results backwards constrained by {limit}
slot: limit int
test: list=1,4,2,7,5 limit=3
expect: => i=3 r=0.0 ok=true s="selected reverse: 3" errors=0 n=3 res=[5,7,2] cache=0 hits=0
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="selected reverse: 2" errors=0 n=2 res=[40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var chosen = [0; 512];
	var cn = 0;
	var i = g.n - 1;
	while i >= 0 && cn < lim {
		chosen[cn] = g.res[i];
		cn++;
		i--;
	}
	g.n = 0;
	for j in cn {
		gold_push(g, chosen[j]);
	}
	out.i = cn;
	out.s.clear();
	format(out.s, "selected reverse: ", cn);
	out
}
@end
@entry c6ee7278349793be
kind: step
verb: scale
noun: value
modifier: unique
context: loop
phrase: scale unique values in loop sequence by factor {scale}
phrase: multiply non repeated result values by factor {scale}
slot: scale int
test: list=2,3,2,5 scale=10
expect: => i=2 r=0.0 ok=true s="scaled unique: 2" errors=0 n=4 res=[2,30,2,50] cache=0 hits=0
test: list=4,4,7 scale=3
expect: => i=1 r=0.0 ok=true s="scaled unique: 1" errors=0 n=3 res=[4,4,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if count == 1 {
			g.res[i] *= s;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled unique: ", scaled);
	out
}
@end
