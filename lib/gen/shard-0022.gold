fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_root = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x >= 10 {
			var s = 0;
			while x > 0 {
				s += x % 10;
				x = x / 10;
			}
			x = s;
		}
		g.res[i] = x;
		total_root += x;
	}
	out.i = total_root;
	out.s.clear();
	format(out.s, "fill digits recursively: ", total_root);
	out
}
@end
