@entry 2e8a07f3483b39a4
kind: step
verb: normalize
noun: primes
modifier: between
context: transform
slot: low int
slot: high int
phrase: normalize prime values between bounds {low} to {high}
phrase: scale primes falling between limits {low} {high}
test: list=2,5,7,11,13,17 low=5 high=15
expect: => i=4 r=0.0 ok=true s="normalized primes count: 4" errors=0 n=6 res=[2,0,2,6,8,17] cache=0 hits=0
test: list=3,4,9,12,15 low=10 high=20
expect: => i=0 r=0.0 ok=true s="normalized primes count: 0" errors=0 n=5 res=[3,4,9,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var modified = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if core_is_prime(x) && x >= lo && x <= hi {
			g.res[i] = x - lo;
			modified++;
		}
		i++;
	}
	g.steps += g.n + modified;
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized primes count: ", modified);
	out
}
@end
@entry 6d28e600fb9b4a00
kind: step
verb: split
noun: number
modifier: up_to
context: transform
slot: threshold int
phrase: split numbers exceeding threshold {threshold} up to maximum pieces
phrase: divide large numbers up to bound {threshold}
test: list=10,25,30,8 threshold=15
expect: => i=2 r=0.0 ok=true s="split numbers count: 2" errors=0 n=6 res=[10,12,13,15,15,8] cache=0 hits=0
test: list=4,8,12 threshold=20
expect: => i=0 r=0.0 ok=true s="split numbers count: 0" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var new_res int[512] = [0; 512];
	var count = 0;
	var splits = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > th && count + 2 <= 512 {
			let h1 = x / 2;
			let h2 = x - h1;
			new_res[count] = h1;
			new_res[count + 1] = h2;
			count += 2;
			splits++;
		} else if count < 512 {
			new_res[count] = x;
			count++;
		}
		i++;
	}
	for k in count { g.res[k] = new_res[k]; }
	g.n = count;
	g.steps += g.n + splits;
	out.i = splits;
	out.s.clear();
	format(out.s, "split numbers count: ", splits);
	out
}
@end
@entry ca1073769f90bf5e
kind: step
verb: limit
noun: average
modifier: all
context: transform
slot: max_avg int
phrase: limit sequence ensuring overall average stays under {max_avg}
phrase: prune elements keeping collective average below {max_avg}
test: list=10,20,30,40 max_avg=20
expect: => i=3 r=0.0 ok=true s="items retained under average: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 max_avg=30
expect: => i=3 r=0.0 ok=true s="items retained under average: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_avg = ${max_avg};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	while g.n > 0 && (sum / g.n) > target_avg {
		var max_idx = 0;
		var i = 1;
		while i < g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
			i++;
		}
		sum -= g.res[max_idx];
		var j = max_idx;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n -= 1;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "items retained under average: ", g.n);
	out
}
@end
