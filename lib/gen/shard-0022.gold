@entry fd8295fb535d9c9d
kind: step
verb: merge
noun: primes
modifier: pairwise
context: sort
phrase: merge adjacent prime numbers pairwise in sorted list
phrase: combine consecutive prime values pairwise across sorted results
test: list=2,3,7,11,15
expect: => i=3 r=0.0 ok=true s="merged primes count: 3" errors=0 n=3 res=[5,15,18] cache=0 hits=0
test: list=4,6,8,9
expect: => i=4 r=0.0 ok=true s="merged primes count: 4" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var w = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && core_is_prime(g.res[i]) && core_is_prime(g.res[i + 1]) {
			g.res[w] = g.res[i] + g.res[i + 1];
			w++;
			i += 2;
		} else {
			g.res[w] = g.res[i];
			w++;
			i++;
		}
	}
	g.n = w;
	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[a] > g.res[b] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged primes count: ", g.n);
	out
}
@end
@entry e422c3d431a2d4bc
kind: step
verb: swap
noun: item
modifier: in_reverse
context: sort
phrase: swap out of order items in reverse order
phrase: perform reverse sweep swapping inverted items in list
test: list=3,10,2,8,1
expect: => i=4 r=0.0 ok=true s="reverse swaps count: 4" errors=0 n=5 res=[1,3,10,2,8] cache=0 hits=0
test: list=1,4,2,3
expect: => i=1 r=0.0 ok=true s="reverse swaps count: 1" errors=0 n=4 res=[1,2,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var swaps = 0;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i - 1] > g.res[i] {
			let t = g.res[i - 1];
			g.res[i - 1] = g.res[i];
			g.res[i] = t;
			swaps++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "reverse swaps count: ", swaps);
	out
}
@end
