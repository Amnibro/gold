test: list=7,3,7,2,3,9
expect: => i=4 r=0.0 ok=true s="deduped all items=4" errors=0 n=4 res=[7,3,2,9] cache=4 hits=0
test: list=15,10,15,20,10,25
expect: => i=4 r=0.0 ok=true s="deduped all items=4" errors=0 n=4 res=[15,10,20,25] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_items int[256] = [0; 256];
	var ucount = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		for j in ucount {
			if unique_items[j] == x { seen = true; break; }
		}
		if !seen {
			unique_items[ucount] = x;
			gold_cache_put(g, x, ucount + 1);
			ucount++;
		}
		i++;
	}
	gold_clear(g);
	for k in ucount { gold_push(g, unique_items[k]); }
	g.steps += i;
	out.i = ucount;
	out.s.clear();
	format(out.s, "deduped all items=", ucount);
	out
}
@end
