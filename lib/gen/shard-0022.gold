code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 {
		gold_cache_put(g, 1, 100);
		gold_cache_put(g, 2, 200);
	}
	let limit = if g.n < g.cn { g.n } else { g.cn };
	for k in limit {
		let tmp = g.res[k];
		g.res[k] = g.cv[k];
		g.cv[k] = tmp;
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "cache all swapped: ", out.i);
	out
}
@end
@entry 7e58835e7e990f7f
kind: step
verb: swap
noun: limit
modifier: with_cache
context: loop
phrase: swap limit with cache key {key} threshold {limit}
phrase: exchange cached value at key {key} under limit {limit}
slot: key int
slot: limit int
test: list=50,10 key=1 limit=100
expect: => i=50 r=0.0 ok=true s="cache limit swapped: 50" errors=0 n=2 res=[50,10] cache=1 hits=0
test: list=25,30 key=2 limit=20
expect: => i=25 r=0.0 ok=true s="cache limit swapped: 25" errors=0 n=2 res=[25,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let lim = ${limit};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "cache limit swapped: 0");
		return out;
	}
	let cached, ok = gold_cache_get(g, k);
	if ok && cached <= lim {
		let tmp = g.res[0];
		g.res[0] = cached;
		gold_cache_put(g, k, tmp);
	} else {
		gold_cache_put(g, k, g.res[0]);
	}
	g.steps += 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "cache limit swapped: ", out.i);
	out
}
@end
@entry 350583efe7c5c3be
kind: step
verb: check
noun: series
modifier: all
context: loop
phrase: check series all loop elements strictly increasing
phrase: verify complete loop series satisfies ascending order
test: list=1,3,5,7
expect: => i=1 r=0.0 ok=true s="series strictly increasing: 1" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
test: list=1,5,3,8
expect: => i=0 r=0.0 ok=false s="series strictly increasing: 0" errors=1 n=4 res=[1,5,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] >= g.res[i + 1] {
			ok = false;
			gold_fail(g, "series not strictly increasing");
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "series strictly increasing: ", out.i);
	out
}
@end
@entry 9e393fe208ba3dd1
kind: step
