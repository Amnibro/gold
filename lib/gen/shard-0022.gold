slot: limit int
test: list=10,25,15,30,20 limit=50
expect: => i=50 r=0.0 ok=true s="split budget until: 50" errors=0 n=3 res=[10,25,15] cache=0 hits=0
test: list=12,18,24,30,16 limit=60
expect: => i=54 r=0.0 ok=true s="split budget until: 54" errors=0 n=3 res=[12,18,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var spent = 0;
	var count = 0;
	for i in g.n {
		let cost = g.res[i];
		if spent + cost <= cap {
			spent += cost;
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	out.i = spent;
	out.s.clear();
	format(out.s, "split budget until: ", spent);
	out
}
@end
