fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	var pairs = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			var j = i + 1;
			while j < g.n {
				if g.res[j] % 2 == 0 && g.res[i] + g.res[j] == target {
					pairs++;
				}
				j++;
			}
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "matched pairs: ", pairs);
	out
}
@end
