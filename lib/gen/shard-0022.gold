fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${cap};
	var count = 0;
	var sum = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 && x <= mx {
			count++;
			sum += x;
		}
	}
	out.i = count;
	out.r = if count > 0 { sum as real / count as real } else { 0.0 };
	out.s.clear();
	format(out.s, "ranked evens at most");
	out
}
@end
@entry e9f5836697bd6ac9
kind: step
verb: fold
noun: checkpoint
modifier: unique
context: math
phrase: fold unique math checkpoint
phrase: accumulate distinct values into math checkpoint
test: list=3,5,3,7,5,9
expect: => i=24 r=0.0 ok=true s="folded unique checkpoint" errors=0 n=1 res=[24] cache=0 hits=0
test: list=10,20,10,30,20
expect: => i=60 r=0.0 ok=true s="folded unique checkpoint" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { gold_fail(g, "empty results for checkpoint"); out.ok = false; return out; }
	var sum = 0;
	var ucount = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			sum += x;
			ucount++;
		}
	}
	gold_clear(g);
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "folded unique checkpoint");
	out
}
@end
