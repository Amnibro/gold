	let count = ${k};
	if count <= 0 || g.n == 0 {
		gold_fail(g, "invalid last elements count");
		out.ok = false;
		return out;
	}
	let start = if g.n > count { g.n - count } else { 0 };
	var max_val = g.res[start];
	var i = start;
	while i < g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
		i++;
	}
	g.steps += g.n - start;
	out.i = max_val;
	out.s.clear();
	format(out.s, "last maximum error: ", max_val);
	out
}
