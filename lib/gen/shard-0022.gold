code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	let retries = ${retry};
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			gold_cache_put(g, x, i);
			matched++;
		} else {
			var r = 0;
			while r < retries {
				gold_cache_put(g, 100 * r + x, i);
				r++;
			}
		}
	}
	g.steps += g.n * (retries + 1);
	out.i = matched;
	out.s.clear();
	format(out.s, "traced range matches=", matched);
	out
}
@end
