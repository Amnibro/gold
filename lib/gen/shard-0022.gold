code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var word_idx = 0;
	var curr_len = 0;
	var all_valid = true;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if curr_len > 0 {
				gold_cache_put(g, word_idx, curr_len);
				if curr_len > limit { all_valid = false; }
				word_idx++;
				curr_len = 0;
			}
		} else {
			curr_len++;
		}
	}
	if curr_len > 0 {
		gold_cache_put(g, word_idx, curr_len);
		if curr_len > limit { all_valid = false; }
		word_idx++;
	}
	g.steps += out.s.len;
	out.ok = all_valid;
	out.i = word_idx;
	out.s.clear();
	format(out.s, "validated ", word_idx, " words valid=", all_valid);
	out
}
@end
