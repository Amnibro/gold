fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n >= 2 {
		let mid = g.n / 2;
		let mid_val = g.res[mid - 1] + g.res[mid];
		g.res[mid - 1] = mid_val * sc;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested middle paired: ", out.i);
	out
}
