expect: => i=115 r=0.0 ok=false s="running total checked: 115" errors=1 n=3 res=[25,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var exceeded = false;
	for k in g.n {
		sum += g.res[k];
		if sum > lim {
			exceeded = true;
			gold_fail(g, "running total exceeded limit");
			break;
		}
	}
	g.steps += g.n;
	out.ok = !exceeded;
	out.i = sum;
	out.s.clear();
	format(out.s, "running total checked: ", out.i);
	out
}
@end
@entry be9227b4cacb9abd
kind: step
verb: measure
noun: window
modifier: in_place
context: loop
phrase: measure window in place moving average span {k}
phrase: compute in place moving average across loop window {k}
slot: k int
test: list=10,20,30,40 k=2
expect: => i=3 r=0.0 ok=true s="moving average points: 3" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=3,6,9,12,15 k=3
expect: => i=3 r=0.0 ok=true s="moving average points: 3" errors=0 n=3 res=[6,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${k};
	if win <= 1 || win > g.n {
		out.i = g.n;
		out.s.clear();
		format(out.s, "moving average points: ", out.i);
		return out;
	}
	var i = 0;
	while i + win <= g.n {
		var sum = 0;
		for j in win {
			sum += g.res[i + j];
		}
		g.res[i] = sum / win;
		i++;
	}
	g.n = i;
	g.steps += i;
	out.i = i;
	out.s.clear();
	format(out.s, "moving average points: ", out.i);
	out
}
@end
