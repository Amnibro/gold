kind: step
verb: measure
noun: histogram
modifier: pairwise
context: loop
phrase: measure loop histogram pairwise bucket difference {bucket}
phrase: compute pairwise histogram distribution in loop with bin {bucket}
slot: bucket int
test: list=10,12,15,30,35 bucket=5
expect: => i=2 r=0.0 ok=true s="pairwise histogram count: 2" errors=0 n=6 res=[10,12,15,30,35,2] cache=0 hits=0
test: list=1,10,12,25 bucket=3
expect: => i=1 r=0.0 ok=true s="pairwise histogram count: 1" errors=0 n=5 res=[1,10,12,25,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if g.n < 2 || b <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "pairwise histogram count: 0");
		return out;
	}
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff < b { count++; }
		i++;
	}
	g.steps += g.n;
	gold_push(g, count);
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise histogram count: ", out.i);
	out
}
@end
