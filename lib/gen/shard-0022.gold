@entry cf3a94145446774f
kind: step
verb: repeat
noun: primes
modifier: each
context: format
phrase: format prime elements repeated by scale {scale}
phrase: display filtered primes repeated with scale {scale}
slot: scale int
test: list=2,3,4,5,6 scale=2
expect: => i=3 r=0.0 ok=true s="primes: [4, 6, 10]" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=7,8,9,11 scale=3
expect: => i=2 r=0.0 ok=true s="primes: [21, 33]" errors=0 n=4 res=[7,8,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let sc = ${scale};
	var out = v;
	out.s.clear();
	format(out.s, "primes: [");
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var is_prime = val >= 2;
		var d = 2;
		while d * d <= val {
			if val % d == 0 { is_prime = false; break; }
			d++;
		}
		if is_prime {
			if count > 0 { format(out.s, ", "); }
			format(out.s, val * sc);
			count++;
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
@entry 5143be95871bbcd3
kind: step
verb: rotate
noun: condition
modifier: recursively
context: format
phrase: format rotated elements matching condition shift {shift}
phrase: display recursive rotated items matching parity {shift}
slot: shift int
test: list=1,2,3,4,5 shift=1
expect: => i=1 r=0.0 ok=true s="rotated: [5, 1, 2, 3, 4]" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=2 r=0.0 ok=true s="rotated: [20, 30, 10]" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let sh = ${shift};
	var out = v;
	out.s.clear();
	format(out.s, "rotated: [");
	if g.n > 0 {
		let eff = sh % g.n;
		for i in g.n {
			if i > 0 { format(out.s, ", "); }
			let idx = (g.n - eff + i) % g.n;
			format(out.s, g.res[idx]);
		}
	}
	format(out.s, "]");
	out.i = sh;
	g.steps += g.n;
	out
}
@end
