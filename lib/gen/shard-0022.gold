@entry 6a3cb62523e4ac2b
kind: step
verb: reverse
noun: errors
modifier: between
context: loop
phrase: reverse errors between loop boundaries {lo} through {hi}
phrase: invert error sequence between loop indices {lo} with {hi}
slot: lo int
slot: hi int
test: list=10,-20,-30,40 lo=1 hi=2
expect: => i=2 r=0.0 ok=true s="errors reversed span: 2" errors=0 n=4 res=[10,30,20,40] cache=0 hits=0
test: list=5,-15,-25,-35,50 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="errors reversed span: 3" errors=0 n=5 res=[5,35,25,15,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l < 0 || h >= g.n || l >= h {
		gold_fail(g, "invalid bounds for error reversal");
		out.ok = false;
		return out;
	}
	var i = l;
	var j = h;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	var k = l;
	while k <= h {
		if g.res[k] < 0 {
			g.res[k] = -g.res[k];
		}
		k++;
	}
	g.steps += (h - l + 1);
	out.i = h - l + 1;
	out.s.clear();
	format(out.s, "errors reversed span: ", out.i);
	out
}
@end
