@entry a50f9fb7beb3709e
kind: step
verb: apply
noun: runs
modifier: pairwise
context: error
phrase: apply pairwise check on error runs exceeding limit {limit}
phrase: audit adjacent error run lengths pairwise with threshold {limit}
slot: limit int
test: list=10,12,14,30 limit=5
expect: => i=1 r=0.0 ok=true s="pairwise run jumps: 1" errors=1 n=4 res=[10,12,14,30] cache=0 hits=0
test: list=5,10,15,20 limit=10
expect: => i=0 r=0.0 ok=true s="pairwise run jumps: 0" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 {
		gold_fail(g, "insufficient runs to pair");
		out.ok = false;
		return out;
	}
	var jumps = 0;
	var i = 1;
	while i < g.n {
		let d = g.res[i] - g.res[i - 1];
		let ad = if d < 0 { -d } else { d };
		if ad > lim {
			jumps++;
			gold_fail(g, "run difference exceeded");
		}
		i++;
	}
	g.steps += g.n;
	out.i = jumps;
	out.s.clear();
	format(out.s, "pairwise run jumps: ", jumps);
	out
}
@end
@entry 229c72689c966b0d
kind: step
verb: group
noun: checkpoint
modifier: pairwise
context: error
phrase: group recovery checkpoint deltas pairwise across list
phrase: pair checkpoint error counts sequentially in results
test: list=10,25,30,50
expect: => i=3 r=0.0 ok=true s="pairwise checkpoint deltas: 3" errors=0 n=3 res=[15,5,20] cache=0 hits=0
test: list=100,200
expect: => i=1 r=0.0 ok=true s="pairwise checkpoint deltas: 1" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough checkpoints to pair");
		out.ok = false;
		return out;
	}
	var diffs int[512] = [0; 512];
	for i in g.n - 1 {
		diffs[i] = g.res[i + 1] - g.res[i];
	}
	let new_n = g.n - 1;
	gold_clear(g);
	for i in new_n {
		gold_push(g, diffs[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise checkpoint deltas: ", g.n);
	out
}
@end
