test: list=3,7,2,5,7
expect: => i=3 r=0.0 ok=true s="cycle: 3" errors=0 n=5 res=[3,7,2,5,7] cache=0 hits=0
test: list=1,4,9,2,8,4
expect: => i=4 r=0.0 ok=true s="cycle: 4" errors=0 n=6 res=[1,4,9,2,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	let target = g.res[g.n - 1];
	var found = false;
	var cycle = 0;
	var i = g.n - 2;
	while i >= 0 {
		if g.res[i] == target {
			found = true;
			cycle = (g.n - 1) - i;
			break;
		}
		if i == 0 { break; }
		i--;
	}
	out.ok = found;
	out.i = cycle;
	out.s.clear();
	if found {
		format(out.s, "cycle: ", cycle);
	} else {
		format(out.s, "no cycle");
	}
	out
}
@end
