@entry d0dc545a9b16600a
kind: step
verb: clamp
noun: streak
modifier: sorted
context: format
phrase: format clamped longest streak bound {bound}
phrase: display maximum streak length clamped at {bound}
slot: bound int
test: list=1,1,1,2,2 bound=2
expect: => i=2 r=0.0 ok=true s="clamped streak: 2" errors=0 n=5 res=[1,1,1,2,2] cache=0 hits=0
test: list=5,5,5,5,5 bound=3
expect: => i=3 r=0.0 ok=true s="clamped streak: 3" errors=0 n=5 res=[5,5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let b = ${bound};
	var out = v;
	out.s.clear();
	var max_streak = 0;
	if g.n > 0 {
		var cur_streak = 1;
		max_streak = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_streak++;
				if cur_streak > max_streak { max_streak = cur_streak; }
			} else {
				cur_streak = 1;
			}
		}
	}
	let clamped = if max_streak > b { b } else { max_streak };
	format(out.s, "clamped streak: ", clamped);
	out.i = clamped;
	g.steps += g.n;
