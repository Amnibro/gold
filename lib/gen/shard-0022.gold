phrase: combine running loop values with memoized cache scale {multiplier}
slot: multiplier int
test: list=5,10,5,20 multiplier=2
expect: => i=1 r=0.0 ok=true s="merged running memo items: 1" errors=0 n=4 res=[5,10,15,20] cache=3 hits=1
test: list=7,7,7 multiplier=3
expect: => i=2 r=0.0 ok=true s="merged running memo items: 2" errors=0 n=3 res=[7,28,28] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var merged = 0;
	for k in g.n {
		let item = g.res[k];
		let cached, ok = gold_cache_get(g, item);
		if ok {
			g.res[k] = item + cached * m;
			merged++;
		} else {
			gold_cache_put(g, item, item);
		}
	}
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged running memo items: ", out.i);
	out
}
@end
