@entry 3524891ea9e5ef13
kind: step
verb: find
noun: cache
modifier: with_retry
context: error
phrase: find error resolution in cache key {key} with retry {retries}
phrase: lookup cached fault remedy for key {key} retry bound {retries}
slot: key int
slot: retries int
test: input=500 key=101 retries=2
expect: => i=500 r=0.0 ok=true s="cache lookup success: 500" errors=0 n=0 res=[] cache=1 hits=1
test: input=0 key=202 retries=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let r = ${retries};
	if g.cn == 0 && out.i != 0 {
		gold_cache_put(g, k, out.i);
	}
	var attempts = 0;
	var found = false;
	var val = 0;
	while attempts < r {
		let cv, ok = gold_cache_get(g, k);
		attempts++;
		if ok {
			found = true;
			val = cv;
			break;
		}
	}
	if !found {
		gold_fail(g, "cache lookup failed after retries");
		gold_cache_put(g, k, 0);
		out.ok = false;
		out.i = 0;
	} else {
		out.i = val;
		out.s.clear();
		format(out.s, "cache lookup success: ", val);
	}
	g.steps += attempts;
	out
}
@end
