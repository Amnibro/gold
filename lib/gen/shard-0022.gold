	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		var diff = cur - prev;
		if diff < 0 { diff = -diff; }
		if diff > 3 {
			violations++;
		}
		prev = cur;
		x /= 10;
	}
	violations <= max_r
}
@end
