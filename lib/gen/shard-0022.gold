fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var prod int[512] = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		prod[pn] = g.res[i] * g.res[i + 1];
		pn++;
		i++;
	}
	var k = 0;
	while k < pn {
		g.res[k] = prod[k];
		k++;
	}
	g.n = pn;
	g.steps += g.n + pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "nested pair products generated: ", pn);
