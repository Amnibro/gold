test: list=1,10,100
expect: => i=2 r=0.0 ok=true s="mapped pairs: 2" errors=0 n=2 res=[10,1000] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "mapped pairs: 0");
		return out;
	}
	var i = 0;
	while i + 1 < g.n {
		g.res[i] = g.res[i] * g.res[i + 1];
		i++;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped pairs: ", g.n);
	out
}
@end
