	if lim > g.n { lim = g.n; }
	if lim < 0 { lim = 0; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	for i in lim {
		gold_cache_put(g, i, g.res[i]);
	}
	g.n = lim;
	g.steps += g.n * 2;
	out.i = lim;
	out.s.clear();
	format(out.s, "selected memo minimums: ", lim);
	out
}
@end
