fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = g.n / 2;
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		if a > b {
			g.res[2 * i] = b;
			g.res[2 * i + 1] = a;
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "normalize sequence pairwise: ", pairs);
	out
}
