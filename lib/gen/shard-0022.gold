code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s2_1[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.2); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bark");
	out
}
@end
