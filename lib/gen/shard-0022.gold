@entry 9d122edf4d23ccf4
kind: step
verb: count
noun: digits
modifier: while
context: transform
phrase: count digits while matching {target}
phrase: while count digits matching {target}
slot: target int
test: list=12,23,24,56 target=2
expect: => i=3 r=0.0 ok=true s="target digits count: 3" errors=0 n=4 res=[12,23,24,56] cache=0 hits=0
test: list=111,21,31,40 target=1
expect: => i=5 r=0.0 ok=true s="target digits count: 5" errors=0 n=4 res=[111,21,31,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var occurrences = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var has_target = false;
		if x == 0 && tgt == 0 { occurrences++; continue; }
		while x > 0 {
			if x % 10 == tgt {
				occurrences++;
				has_target = true;
			}
			x /= 10;
		}
		if !has_target { break; }
	}
	g.steps += g.n;
	out.i = occurrences;
	out.s.clear();
	format(out.s, "target digits count: ", occurrences);
	out
}
@end
