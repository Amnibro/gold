phrase: filter close search matches with cache spacing {min_gap}
slot: min_gap int
test: list=10,12,18,20,29 min_gap=5
expect: => i=3 r=0.0 ok=true s="dedupe gaps: 3" errors=0 n=3 res=[10,18,29] cache=3 hits=0
test: list=5,7,15,16,25 min_gap=6
expect: => i=3 r=0.0 ok=true s="dedupe gaps: 3" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if kn == 0 || (x - kept[kn - 1] >= mg) || (kept[kn - 1] - x >= mg) {
			kept[kn] = x; kn++;
			gold_cache_put(g, kn, x);
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "dedupe gaps: ", kn);
	out
}
@end
