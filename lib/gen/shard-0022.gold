fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var sum_sq = 0;
	for i in g.n {
		if i >= l && i <= h {
			let x = g.res[i];
			sum_sq += x * x;
		}
	}
	gold_push(g, sum_sq);
	out.i = sum_sq;
	out.s.clear();
	format(out.s, "merged squares: ", sum_sq);
	out
}
