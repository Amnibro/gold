noun: steps
modifier: with_cache
context: search
phrase: repeat search transformation steps with cache cycles {reps}
phrase: execute search refinement steps with cache passes {reps}
slot: reps int
test: list=10,20,30 reps=2
expect: => i=0 r=0.0 ok=true s="repeat with_cache hits: 0" errors=0 n=3 res=[12,22,32] cache=6 hits=0
test: list=5,15 reps=3
expect: => i=0 r=0.0 ok=true s="repeat with_cache hits: 0" errors=0 n=2 res=[8,18] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	var hits_before = g.hits;
	for step in r {
		for i in g.n {
			let x = g.res[i];
			let cv, ok = gold_cache_get(g, x);
			if ok {
				g.res[i] = cv;
			} else {
				let nx = x + 1;
				gold_cache_put(g, x, nx);
				g.res[i] = nx;
			}
		}
	}
	out.i = g.hits - hits_before;
	out.s.clear();
	format(out.s, "repeat with_cache hits: ", out.i);
	out
}
@end
