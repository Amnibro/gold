@entry 46b33b41dcfd5bab
kind: step
verb: run
noun: digits
modifier: all
context: list
phrase: run digits all constituent components
phrase: expand digits all numeric breakdown
test: list=25,83,14
expect: => i=6 r=0.0 ok=true s="run digits all: 6" errors=0 n=6 res=[2,5,8,3,1,4] cache=0 hits=0
test: list=67,49,52
expect: => i=6 r=0.0 ok=true s="run digits all: 6" errors=0 n=6 res=[6,7,4,9,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dlist = [0; 512];
	var nd = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var stack = [0; 32];
		var sp = 0;
		if x == 0 { stack[sp] = 0; sp++; }
		else {
			while x > 0 && sp < 32 {
				stack[sp] = x % 10;
				sp++;
				x = x / 10;
			}
		}
		var j = sp - 1;
		while j >= 0 && nd < 512 {
			dlist[nd] = stack[j];
			nd++;
			if j == 0 { break; }
			j--;
		}
	}
	g.n = 0;
	for i in nd { gold_push(g, dlist[i]); }
	out.i = nd;
	out.s.clear();
	format(out.s, "run digits all: ", nd);
	out
}
@end
