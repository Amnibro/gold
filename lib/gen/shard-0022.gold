@entry dedc5470f8f2dc71
kind: step
verb: retry
noun: primes
modifier: each
context: sort
slot: boost int
phrase: retry primes each scaled by boost {boost}
phrase: transform each prime in sorted list by boost {boost}
test: list=4,3,2,6,5 boost=10
expect: => i=3 r=0.0 ok=true s="primes modified: 3" errors=0 n=5 res=[20,30,4,50,6] cache=0 hits=0
test: list=9,7,8,1 boost=5
expect: => i=1 r=0.0 ok=true s="primes modified: 1" errors=0 n=4 res=[1,35,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${boost};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_prime = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_prime = false; break; }
			d++;
		}
		if is_prime {
			g.res[k] *= b;
			prime_count++;
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "primes modified: ", prime_count);
	out
}
@end
