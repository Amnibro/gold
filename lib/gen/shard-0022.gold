expect: => doc: scatter_cave_center3 sphere 0,0,1 r3 m:matte #2d2823
test: r=1.5 d=0.9 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=3 r=0.0 ok=true s="scattercavecenter" errors=0 n=0 res=[] cache=0 hits=0
