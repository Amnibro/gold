expect: => i=2 r=0.0 ok=true s="shifted last: 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k < 2 { return out; }
	let start = g.n - k;
	let last_val = g.res[g.n - 1];
	var i = g.n - 1;
	while i > start {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[start] = last_val;
	out.i = k;
	out.s.clear();
	format(out.s, "shifted last: ", k);
	out
}
@end
