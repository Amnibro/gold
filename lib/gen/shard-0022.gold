fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			g.res[i] *= f;
			g.res[i + 1] *= f;
			count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled pairs: ", count);
	out
}
@end
