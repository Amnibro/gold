code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${ckey};
	let b = ${bonus};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		let mid = g.n / 2;
		gold_cache_put(g, k, g.res[mid]);
		let cached_val, has = gold_cache_get(g, k);
		g.res[mid] = cached_val + b;
		out.i = g.res[mid];
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "merged middle cache: ", out.i);
	out
}
@end
@entry 568a6aabd9540cbb
kind: step
verb: merge
noun: runs
modifier: in_reverse
context: sort
phrase: merge runs in_reverse combining odd with inverted evens
phrase: join sorted odds with reversed evens
test: list=6,1,4,3,2,5
expect: => i=6 r=0.0 ok=true s="merged runs in reverse" errors=0 n=6 res=[1,3,5,6,4,2] cache=0 hits=0
test: list=10,7,2,9
expect: => i=4 r=0.0 ok=true s="merged runs in reverse" errors=0 n=4 res=[7,9,10,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var odds int[256] = [0; 256];
	var evens int[256] = [0; 256];
	var on = 0;
	var en = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[on] = g.res[k];
			on++;
		} else {
			evens[en] = g.res[k];
			en++;
		}
	}
	var idx = 0;
	for o in on {
		g.res[idx] = odds[o];
		idx++;
	}
	var e = en - 1;
	while e >= 0 {
		g.res[idx] = evens[e];
		idx++;
		e--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged runs in reverse");
	out
}
@end
