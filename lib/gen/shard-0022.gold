@entry 53af34b477ef7ac0
kind: step
verb: apply
noun: counter
modifier: at_least
context: core
phrase: apply counter at_least frequency threshold {min_freq}
phrase: filter counter at_least occurrences exceeding {min_freq}
slot: min_freq int
test: list=1,2,2,3,3,3 min_freq=2
expect: => i=5 r=0.0 ok=true s="kept frequency: 5" errors=0 n=5 res=[2,2,3,3,3] cache=0 hits=0
test: list=5,5,5,6,7 min_freq=3
expect: => i=3 r=0.0 ok=true s="kept frequency: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_f = ${min_freq};
	var vals = [0; 512];
	var freqs = [0; 512];
	var ucnt = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in ucnt {
			if vals[j] == x { freqs[j]++; found = true; break; }
		}
		if !found {
			vals[ucnt] = x;
			freqs[ucnt] = 1;
			ucnt++;
		}
	}
	var kept = [0; 512];
	var kcnt = 0;
	for i in g.n {
		let x = g.res[i];
		var f = 0;
		for j in ucnt {
			if vals[j] == x { f = freqs[j]; break; }
		}
		if f >= min_f {
			kept[kcnt] = x;
			kcnt++;
		}
	}
	g.n = 0;
	for i in kcnt { gold_push(g, kept[i]); }
	out.i = kcnt;
	out.s.clear();
	format(out.s, "kept frequency: ", kcnt);
	out
}
@end
