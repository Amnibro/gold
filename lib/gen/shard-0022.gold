@entry c7728d1362d2be9e
kind: step
verb: split
noun: tail
modifier: with_retry
context: transform
slot: tail_size int
phrase: split tail segment of size {tail_size} with retry fallback
phrase: partition trailing {tail_size} elements with retry mechanism
test: list=10,20,30,40 tail_size=2
expect: => i=4 r=0.0 ok=true s="split tail final count: 4" errors=0 n=4 res=[10,20,35,35] cache=0 hits=0
test: list=5,15,25 tail_size=3
expect: => i=2 r=0.0 ok=true s="split tail final count: 2" errors=0 n=2 res=[22,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sz = ${tail_size};
	if sz > g.n { sz = g.n; }
	if sz <= 0 {
		gold_fail(g, "empty tail segment");
		out.ok = false;
		return out;
	}
	let start = g.n - sz;
	var i = start;
	var sum_tail = 0;
	while i < g.n {
		sum_tail += g.res[i];
		i++;
	}
	let mid = sum_tail / 2;
	g.res[start] = mid;
	g.res[start + 1] = sum_tail - mid;
	g.n = start + 2;
	g.steps += sz;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split tail final count: ", g.n);
	out
}
@end
