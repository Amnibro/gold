@entry 12956913ce80e917
kind: step
verb: clamp
noun: results
modifier: pairwise
context: search
phrase: clamp search results pairwise difference to {max_delta}
phrase: constrain adjacent search hit gaps pairwise by {max_delta}
slot: max_delta int
test: list=10,50,90,100 max_delta=20
expect: => i=3 r=0.0 ok=true s="pairwise clamped transitions: 3" errors=0 n=4 res=[10,30,50,70] cache=0 hits=0
test: list=5,10,40 max_delta=10
expect: => i=1 r=0.0 ok=true s="pairwise clamped transitions: 1" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_delta};
	if md < 0 {
		gold_fail(g, "negative pairwise max delta");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > md {
			g.res[i] = g.res[i - 1] + md;
			clamped++;
		} else if diff < -md {
			g.res[i] = g.res[i - 1] - md;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "pairwise clamped transitions: ", clamped);
	out
}
@end
