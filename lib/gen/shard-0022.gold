test: list=7,9,11,13,15
expect: => i=31 r=0.0 ok=true s="running prime sum=31" errors=0 n=3 res=[7,18,31] cache=3 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	var prime_sums int[256] = [0; 256];
	var pcount = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			running += x;
			prime_sums[pcount] = running;
			gold_cache_put(g, pcount, running);
			pcount++;
		}
	}
	gold_clear(g);
	for k in pcount { gold_push(g, prime_sums[k]); }
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "running prime sum=", running);
	out
}
@end
