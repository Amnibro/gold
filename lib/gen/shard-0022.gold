test: list=404,404,500,404,200
expect: => i=3 r=0.0 ok=true s="dropped series matching cache: 3" errors=0 n=2 res=[500,200] cache=1 hits=1
test: list=100,200,300
expect: => i=1 r=0.0 ok=true s="dropped series matching cache: 1" errors=0 n=2 res=[200,300] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for series drop");
		out.ok = false;
		return out;
	}
	gold_cache_put(g, 1, g.res[0]);
	let target, _ = gold_cache_get(g, 1);
	var write = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] == target {
			dropped++;
		} else {
			g.res[write] = g.res[i];
			write++;
		}
	}
	g.n = write;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped series matching cache: ", dropped);
	out
}
@end
@entry 9dfa3a7ea5122493
kind: step
verb: split
noun: budget
modifier: with_cache
context: error
phrase: split error budget into allocations with cache parts {parts}
phrase: partition failure budget with cache into segments {parts}
slot: parts int
test: input=100 parts=4
expect: => i=4 r=0.0 ok=true s="budget split into 4 parts" errors=0 n=4 res=[25,25,25,25] cache=1 hits=0
test: input=50 parts=3
expect: => i=3 r=0.0 ok=true s="budget split into 3 parts" errors=0 n=3 res=[16,16,18] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 || out.i < p {
		gold_fail(g, "invalid budget split");
		out.ok = false;
		return out;
	}
	let base = out.i / p;
	let rem = out.i % p;
	gold_clear(g);
	for k in p {
		let alloc = if k == p - 1 { base + rem } else { base };
		gold_push(g, alloc);
	}
	gold_cache_put(g, 101, p);
	g.steps += p;
	out.i = p;
	out.s.clear();
	format(out.s, "budget split into ", p, " parts");
	out
}
@end
