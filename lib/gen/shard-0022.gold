@entry 73cd5905e294aa90
kind: step
verb: apply
noun: maximum
modifier: nested
context: error
phrase: apply nested maximum error limit over window {depth}
phrase: cap maximum fault severity across nested span {depth}
slot: depth int
test: list=10,25,5,40,15,30 depth=2
expect: => i=6 r=0.0 ok=true s="applied nested maximum over windows of 2" errors=0 n=6 res=[25,25,40,40,30,30] cache=0 hits=0
test: list=10,50,30 depth=3
expect: => i=3 r=0.0 ok=true s="applied nested maximum over windows of 3" errors=0 n=3 res=[50,50,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${depth};
	if w <= 0 || g.n == 0 {
		gold_fail(g, "invalid nested window size");
		out.ok = false;
		return out;
	}
	var start = 0;
	while start < g.n {
		let end = if start + w < g.n { start + w } else { g.n };
		var max_val = g.res[start];
		var j = start;
		while j < end {
			if g.res[j] > max_val { max_val = g.res[j]; }
			j++;
		}
		j = start;
		while j < end {
			g.res[j] = max_val;
			j++;
		}
		start = end;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied nested maximum over windows of ", w);
	out
}
@end
