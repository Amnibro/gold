@entry b38c28842a1e7de1
kind: step
verb: shift
noun: loop
modifier: each
context: transform
slot: cycle_shift int
phrase: shift elements cycling sequence positions each by {cycle_shift}
phrase: rotate loop elements displacing each index by {cycle_shift}
test: list=1,2,3,4,5 cycle_shift=2
expect: => i=5 r=0.0 ok=true s="shifted cyclic loop items: 5" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 cycle_shift=1
expect: => i=3 r=0.0 ok=true s="shifted cyclic loop items: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${cycle_shift};
	if g.n > 1 {
		let eff = (sh % g.n + g.n) % g.n;
		var tmp int[512] = [0; 512];
		for i in g.n { tmp[i] = g.res[i]; }
		for i in g.n {
			let ni = (i + eff) % g.n;
			g.res[ni] = tmp[i];
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted cyclic loop items: ", g.n);
	out
}
@end
