noun: streak
modifier: running
context: sort
phrase: reverse running descending streak into ascending order
phrase: invert decreasing streak to restore sorted direction
test: list=1,5,4,3,2,6
expect: => i=6 r=0.0 ok=true s="reversed streak running: 6" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,8,6,12
expect: => i=4 r=0.0 ok=true s="reversed streak running: 4" errors=0 n=4 res=[6,8,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var s = -1;
	var e = -1;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			s = i;
			while i + 1 < g.n && g.res[i] > g.res[i + 1] { i++; }
			e = i;
			break;
		}
		i++;
	}
	if s >= 0 && e > s {
		while s < e {
			let t = g.res[s];
			g.res[s] = g.res[e];
			g.res[e] = t;
			s++;
			e--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed streak running: ", g.n);
	out
}
@end
