	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	var steps = 0;
	while rev > 0 && steps < lim {
		var temp = rev;
		var dsum = 0;
		while temp > 0 {
			dsum += temp % 10;
			temp /= 10;
		}
		if dsum == 0 { break; }
		rev -= dsum;
		steps++;
	}
	steps
}
@end
