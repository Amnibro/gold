code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var swapped = 0;
	var i = 0;
	while i + 1 < g.n {
		let total = g.res[i] + g.res[i + 1];
		if total >= low && total <= high {
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
				swapped++;
			}
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "paired sum swaps: ", swapped);
	out
}
@end
