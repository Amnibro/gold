fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win > g.n || win <= 0 { return out; }
	let num_windows = g.n - win + 1;
	var win_sums int[256] = [0; 256];
	var count = 0;
	var start = g.n - win;
	while start >= 0 {
		var s = 0;
		for j in win { s += g.res[start + j]; }
		win_sums[count] = s;
		gold_cache_put(g, count, s);
		count++;
		start--;
	}
	gold_clear(g);
	for k in count { gold_push(g, win_sums[k]); }
	g.steps += count * win;
	out.i = count;
	out.s.clear();
	format(out.s, "traced reverse windows=", count);
	out
}
@end
