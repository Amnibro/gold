@entry 13cdbdabe489dd60
kind: step
verb: dedupe
noun: value
modifier: at_most
context: search
phrase: prune search results keeping each value at most {cap} times
phrase: limit duplicate search results to at most {cap} occurrences
slot: cap int
test: list=4,2,4,4,2,5 cap=2
expect: => i=1 r=0.0 ok=true s="dedupe at_most: 1" errors=0 n=5 res=[4,2,4,2,5] cache=0 hits=0
test: list=7,7,7,7,3,3 cap=1
expect: => i=4 r=0.0 ok=true s="dedupe at_most: 4" errors=0 n=2 res=[7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c <= 0 { g.n = 0; return out; }
	var kept = [0; 512];
	var kn = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt = 0;
		for j in kn {
			if kept[j] == x { cnt++; }
		}
		if cnt < c {
			kept[kn] = x;
			kn++;
		} else {
			dropped++;
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = dropped;
	out.s.clear();
	format(out.s, "dedupe at_most: ", dropped);
	out
}
@end
