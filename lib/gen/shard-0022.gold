		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.5 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
