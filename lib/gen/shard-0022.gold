test: list=5,15,25,35
expect: => i=-1 r=0.0 ok=true s="last occurrence distance: -1" errors=0 n=5 res=[5,15,25,35,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = -1;
		out.s.clear();
		format(out.s, "sequence too short");
		return out;
	}
	let last = g.res[g.n - 1];
	var dist = -1;
	var i = g.n - 2;
	while i >= 0 {
		if g.res[i] == last {
			dist = (g.n - 1) - i;
			break;
		}
		i--;
	}
	gold_push(g, dist);
	g.steps += g.n;
	out.i = dist;
	out.s.clear();
	format(out.s, "last occurrence distance: ", dist);
	out
}
@end
