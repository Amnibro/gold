code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var count = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		count++;
		i += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped pairs: ", count);
	out
}
@end
