fn ${ID}(n int) int {
	let b = ${bias};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return b; }
	var max_streak = 1;
	var cur_streak = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
			prev = cur;
		}
		x /= 10;
	}
	max_streak + b
}
@end
