fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.55 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.25); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
@end
