fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let h = g.n / 2;
	var i = 0;
	while i < h {
		g.res[i] += g.res[i + h];
		i++;
	}
	g.n = h;
	g.steps += h;
	out.i = h;
	out.s.clear();
	format(out.s, "merged history: ", h);
	out
}
