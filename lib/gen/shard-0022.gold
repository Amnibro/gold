phrase: sum backwards until cumulative total exceeds {limit}
slot: limit int
test: list=5,10,15,20 limit=25
expect: => i=35 r=0.0 ok=true s="reverse sum: 35" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=2,4,6,8,10 limit=15
expect: => i=18 r=0.0 ok=true s="reverse sum: 18" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 && sum < lim {
		sum += g.res[idx];
		count++;
		idx--;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "reverse sum: ", sum);
	out
}
@end
