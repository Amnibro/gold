fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = -g.res[i];
			odd_count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "reversed odd signs: ", odd_count);
	out
}
@end
@entry 58b2cf8603ecedf1
kind: step
verb: merge
noun: budget
modifier: between
context: aggregate
slot: low int
slot: high int
phrase: merge budget between limits {low} to {high}
phrase: sum budget values within {low} through {high}
test: list=5,15,25,35 low=10 high=30
expect: => i=40 r=0.0 ok=true s="merged budget total: 40" errors=0 n=1 res=[40] cache=0 hits=0
test: list=2,8,12,20 low=5 high=15
expect: => i=20 r=0.0 ok=true s="merged budget total: 20" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var total = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			total += x;
		}
		i++;
	}
	g.res[0] = total;
	g.n = 1;
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "merged budget total: ", total);
	out
}
@end
