@entry 65e844d162f3accb
kind: step
verb: merge
noun: runs
modifier: recursively
context: loop
phrase: merge runs recursively in loop depth {depth}
phrase: condense repeating runs across loop recursively levels {depth}
slot: depth int
test: list=2,2,3,3,3,4 depth=1
expect: => i=3 r=0.0 ok=true s="recursive runs remaining: 3" errors=0 n=3 res=[4,9,4] cache=0 hits=0
test: list=1,1,2,2 depth=2
expect: => i=2 r=0.0 ok=true s="recursive runs remaining: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	var d = 0;
	while d < max_d && g.n > 1 {
		var new_n = 0;
		var i = 0;
		var merged_any = false;
		while i < g.n {
			var run_len = 1;
			while i + run_len < g.n && g.res[i + run_len] == g.res[i] {
				run_len++;
			}
			if run_len > 1 {
				g.res[new_n] = g.res[i] * run_len;
				merged_any = true;
			} else {
				g.res[new_n] = g.res[i];
			}
			new_n++;
			i += run_len;
		}
		g.n = new_n;
		d++;
		if !merged_any { break; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursive runs remaining: ", out.i);
	out
}
@end
