expect: => i=2 r=0.0 ok=true s="rotated duplicates every other" errors=0 n=4 res=[2,2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			dups++;
			if dups % 2 == 0 {
				g.res[i] = g.res[i] + 1;
			}
		}
	}
	out.i = dups;
	out.s.clear();
	format(out.s, "rotated duplicates every other");
	out
}
@end
@entry 340dfddaf96341c5
kind: step
verb: search
noun: middle
modifier: recursively
context: math
phrase: search sorted math elements for {target}
phrase: find target {target} in sorted math list
slot: target int
test: list=2,4,6,8,10,12 target=8
expect: => i=3 r=0.0 ok=true s="searched middle recursively" errors=0 n=6 res=[2,4,6,8,10,12] cache=0 hits=0
test: list=1,3,5,7,9 target=4
expect: => i=-1 r=0.0 ok=true s="searched middle recursively" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	var steps = 0;
	while lo <= hi {
		steps++;
		let mid = lo + (hi - lo) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	out.i = found;
	g.steps += steps;
	out.s.clear();
	format(out.s, "searched middle recursively");
	out
}
@end
