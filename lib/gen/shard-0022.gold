fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var perfect = true;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] { perfect = false; }
	}
	if !perfect {
		for a in g.n {
			for b in (a + 1)..g.n {
				if g.res[a] > g.res[b] {
					let t = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = t;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = if perfect { 1 } else { 0 };
	out.s.clear();
	format(out.s, "scanned history verified: ", out.i);
	out
}
@end
