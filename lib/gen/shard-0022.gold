	gold_fnum(o, ${r} * 0.2);
	o.append(",");
	gold_fnum(o, ${r} * 0.1);
	o.append(",");
	gold_fnum(o, ${h} * 1.2);
	o.append(" - ra");
	format(o, ${n});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "gearthrough");
	out
}
