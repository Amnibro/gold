	let k = ${base_key};
	var base, ok = gold_cache_get(g, k);
	if !ok {
		base = 10;
		gold_cache_put(g, k, base);
	}
	for i in g.n {
		g.res[i] = g.res[i] - base;
	}
	g.steps += g.n;
	out.i = base;
	out.s.clear();
	format(out.s, "normalized errors with baseline: ", base);
	out
}
@end
