expect: => i=10 r=0.0 ok=true s="clamped step tail: 10" errors=0 n=4 res=[2,4,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var k = 1;
	while k < g.n {
		if g.res[k] - g.res[k - 1] > limit {
			g.res[k] = g.res[k - 1] + limit;
		}
		k++;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "clamped step tail: ", out.i);
	out
}
@end
