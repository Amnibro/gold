modifier: while
context: transform
slot: p pred
phrase: group elements accumulating values while predicate {p} holds
phrase: aggregate consecutive values while condition {p} remains true
test: list=2,4,6,1,8,10 p=is_even
expect: => i=3 r=0.0 ok=true s="grouped value chunks: 3" errors=0 n=3 res=[12,1,18] cache=0 hits=0
test: list=1,3,5,2,7 p=is_odd
expect: => i=3 r=0.0 ok=true s="grouped value chunks: 3" errors=0 n=3 res=[9,2,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var groups = 0;
	var i = 0;
	while i < g.n {
		if ${p}(g.res[i]) {
			var s = 0;
			while i < g.n && ${p}(g.res[i]) {
				s += g.res[i];
				i++;
			}
			g.res[groups] = s;
			groups++;
		} else {
			g.res[groups] = g.res[i];
			groups++;
			i++;
		}
	}
	g.n = groups;
	g.steps += g.n + groups;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped value chunks: ", groups);
	out
}
@end
