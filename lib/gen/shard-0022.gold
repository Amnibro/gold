kind: step
verb: find
noun: errors
modifier: nested
context: list
phrase: find errors nested within window {w}
phrase: locate errors nested across span {w}
slot: w int
test: list=5,-1,-2,8,-3,9 w=3
expect: => i=3 r=0.0 ok=true s="find errors nested: 3" errors=0 n=6 res=[5,-1,-2,8,-3,9] cache=0 hits=0
test: list=10,-4,3,-2,-5,7 w=2
expect: => i=1 r=0.0 ok=true s="find errors nested: 1" errors=0 n=6 res=[10,-4,3,-2,-5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${w};
	if w <= 0 || g.n < w { return out; }
	var err_windows = 0;
	for i in g.n - w + 1 {
		var cnt = 0;
		for j in w {
			if g.res[i + j] < 0 { cnt++; }
		}
		if cnt >= 2 { err_windows++; }
	}
	out.i = err_windows;
	out.s.clear();
	format(out.s, "find errors nested: ", err_windows);
	out
}
@end
