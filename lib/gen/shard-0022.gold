test: list=4,2,4,1,2 factor=3
expect: => i=3 r=0.0 ok=true s="scaled unique sequence count: 3" errors=0 n=3 res=[3,6,12] cache=0 hits=0
test: list=5,10,5 factor=2
expect: => i=2 r=0.0 ok=true s="scaled unique sequence count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		g.res[i] = g.res[i] * f;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var u = 0;
	for i in g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			g.res[u] = g.res[i];
			u++;
		}
	}
	g.n = u;
	g.steps += g.n * 2;
	out.i = u;
	out.s.clear();
	format(out.s, "scaled unique sequence count: ", u);
	out
}
@end
