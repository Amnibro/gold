fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${limit};
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var count = 0;
	var total = 0;
	while count < g.n && total + g.res[count] <= budget {
		total += g.res[count];
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "descending count: ", count);
	out
}
@end
