fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	var modified = 0;
	for i in g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped threshold at least modified: ", modified);
	out
}
