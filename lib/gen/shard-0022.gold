code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let v_pad = ${val};
	if k <= g.n { return out; }
	var temp = [0; 512];
	let extra = k - g.n;
	for i in extra { temp[i] = v_pad; }
	for i in g.n { temp[extra + i] = g.res[i]; }
	g.n = 0;
	for i in k { gold_push(g, temp[i]); }
	out.i = extra;
	out.s.clear();
	format(out.s, "fill prefix at_least: ", extra);
	out
}
@end
