fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_idx = 0;
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	var tmp int[256] = [0; 256];
	for i in g.n {
		let ni = (i + max_idx) % g.n;
		tmp[i] = g.res[ni];
		gold_cache_put(g, i, tmp[i]);
	}
	for i in g.n { g.res[i] = tmp[i]; }
	g.steps += g.n;
	out.i = max_idx;
	out.s.clear();
	format(out.s, "rotated peak to front offset=", max_idx);
	out
}
@end
