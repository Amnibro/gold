slot: threshold int
test: list=50,60,70 threshold=40
expect: => i=0 r=0.0 ok=true s="trace retries required: 0" errors=0 n=3 res=[50,60,70] cache=0 hits=0
test: list=20,30,80 threshold=50
expect: => i=2 r=0.0 ok=false s="trace retries required: 2" errors=2 n=3 res=[20,30,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var retries_needed = 0;
	for k in g.n {
		if g.res[k] < th {
			retries_needed++;
			gold_fail(g, "search value below trace threshold");
		}
	}
	g.steps += g.n + retries_needed;
	out.i = retries_needed;
	out.ok = (retries_needed == 0);
	out.s.clear();
	format(out.s, "trace retries required: ", retries_needed);
