@entry 6d346a62276abdfb
kind: step
verb: filter
noun: primes
modifier: every_other
context: retry
phrase: filter primes every_other backoff delay in retry list
phrase: retain every alternate prime delay from retry attempts
test: list=2,3,5,7,11,13,17
expect: => i=4 r=0.0 ok=true s="filtered alternate primes: 4" errors=0 n=4 res=[2,5,11,17] cache=0 hits=0
test: list=4,6,7,9,11,12,13,15,17,19
expect: => i=3 r=0.0 ok=true s="filtered alternate primes: 3" errors=0 n=3 res=[7,13,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var prime_cnt = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			if prime_cnt % 2 == 0 {
				kept[kn] = x;
				kn++;
			}
			prime_cnt++;
		}
		i++;
	}
	var j = 0;
	while j < kn {
		g.res[j] = kept[j];
		j++;
	}
	g.n = kn;
	g.steps += g.n + prime_cnt;
	out.i = kn;
	out.s.clear();
	format(out.s, "filtered alternate primes: ", kn);
	out
}
@end
