fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = g.n / 2;
	var maxs = [0; 512];
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		maxs[i] = if a > b { a } else { b };
	}
	g.n = 0;
	for i in pairs { gold_push(g, maxs[i]); }
	out.i = pairs;
	out.s.clear();
	format(out.s, "split maximum pairwise: ", pairs);
	out
}
