fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${r} <= 0.0 || ${d} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "scatter_cave_center", "", o);
	o.append(" sphere 0,0,");
	o.append("1 r");
	gold_fnum(o, ${r});
	o.append(" m:matte ");
	gold_hex(o, 45, 40, 35);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "scattercavecenter");
	out
}
@end
