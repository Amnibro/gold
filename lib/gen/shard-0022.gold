noun: errors
modifier: each
context: loop
phrase: pair errors for each item applying penalty {penalty}
phrase: couple error offsets with each result scaled by {penalty}
slot: penalty int
test: list=10,20,30 penalty=2
expect: => i=0 r=0.0 ok=true s="error penalty applied: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 penalty=1
