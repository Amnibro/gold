fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "gear", "", o);
	o.append(" cyl ");
	o.append("0,0,");
	o.append("0 0,");
	o.append("0,");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:metal");
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "bore", "", o);
	o.append(" cyl ");
	o.append("0,0,-");
	o.append("0.");
	o.append("01 ");
	o.append("0,0,");
	gold_fnum(o, ${h} + 0.01);
	o.append(" r");
	gold_fnum(o, ${t});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "gearthroughbore");
	out
}
@end
