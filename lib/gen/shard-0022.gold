test: list=1,2,3,4,5,6 span=4
expect: => i=2 r=0.0 ok=true s="counted 2 evens" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,15,20 span=2
expect: => i=1 r=0.0 ok=true s="counted 1 evens" errors=0 n=3 res=[10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var start = g.n - sp;
	if start < 0 { start = 0; }
	var evens = 0;
	for i in start..g.n {
		if g.res[i] % 2 == 0 { evens++; }
	}
	g.steps += (g.n - start);
	out.i = evens;
	out.s.clear();
	format(out.s, "counted ", evens, " evens");
	out
}
@end
