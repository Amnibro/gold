	let l = ${lo};
	let h = ${hi};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h && x % 2 == 0 {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "traced evens between count: ", count);
	out
}
@end
@entry 1b4868c74b86921c
kind: step
verb: search
noun: digits
modifier: nested
context: math
phrase: search digits nested finding digit {d} across numbers in math
phrase: nested search for target digit {d} in list values in math
slot: d int
test: list=12,23,42 d=2
expect: => i=3 r=0.0 ok=true s="searched nested digits count: 3" errors=0 n=3 res=[12,23,42] cache=0 hits=0
test: list=105,55,500 d=5
expect: => i=4 r=0.0 ok=true s="searched nested digits count: 4" errors=0 n=3 res=[105,55,500] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${d};
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		if x == 0 && target == 0 {
			total++;
		}
		while x > 0 {
			if x % 10 == target {
				total++;
			}
			x /= 10;
		}
	}
	g.steps += g.n + total;
	out.i = total;
	out.s.clear();
	format(out.s, "searched nested digits count: ", total);
	out
}
@end
@entry 27e176ea1e4034c2
kind: step
verb: join
noun: digits
modifier: in_reverse
context: math
phrase: join digits in reverse forming composite number in math
phrase: reverse join digits across elements into number in math
test: list=1,2,3
expect: => i=321 r=0.0 ok=true s="joined digits in reverse: 321" errors=0 n=4 res=[1,2,3,321] cache=0 hits=0
test: list=4,5,6
expect: => i=654 r=0.0 ok=true s="joined digits in reverse: 654" errors=0 n=4 res=[4,5,6,654] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var combined = 0;
	var i = g.n - 1;
	while i >= 0 {
		var d = g.res[i];
		if d < 0 { d = -d; }
		d = d % 10;
		combined = combined * 10 + d;
		i--;
	}
	gold_push(g, combined);
	g.steps += g.n + 1;
	out.i = combined;
	out.s.clear();
	format(out.s, "joined digits in reverse: ", combined);
	out
}
@end
