expect: => i=4 r=0.0 ok=true s="normalize item unique: 4" errors=0 n=5 res=[1,0,2,0,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var u = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in nu { if u[j] == x { seen = true; break; } }
		if !seen { u[nu] = x; nu++; }
	}
	for i in nu {
		for j in nu - 1 {
			if u[j] > u[j + 1] {
				let tmp = u[j];
				u[j] = u[j + 1];
				u[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		let x = g.res[i];
		for j in nu {
			if u[j] == x { g.res[i] = j; break; }
		}
	}
	out.i = nu;
	out.s.clear();
	format(out.s, "normalize item unique: ", nu);
	out
}
@end
