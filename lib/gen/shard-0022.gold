expect: => i=70 r=0.0 ok=true s="error range span: 70" errors=0 n=4 res=[10,50,30,80] cache=0 hits=0
test: list=20,25,22 min_span=10
expect: => i=5 r=0.0 ok=false s="error range span: 5" errors=1 n=3 res=[20,25,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${min_span};
	if g.n < 2 {
		gold_fail(g, "insufficient error points for range");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let actual_span = max_val - min_val;
	if actual_span < span {
		gold_fail(g, "error range span below threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = actual_span;
	out.s.clear();
	format(out.s, "error range span: ", actual_span);
	out
}
@end
