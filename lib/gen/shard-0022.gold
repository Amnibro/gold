@entry 80715f5544232c4a
kind: step
verb: measure
noun: sequence
modifier: first
context: loop
phrase: measure sequence magnitude across first items bounded by {limit}
phrase: calculate initial sequence span for first elements count {limit}
slot: limit int
test: list=2,4,6,8,10 limit=3
expect: => i=12 r=0.0 ok=true s="first sum: 12" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,3,5 limit=2
expect: => i=4 r=0.0 ok=true s="first sum: 4" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${limit};
	if lim > g.n { lim = g.n; }
	var sum = 0;
	for i in lim { sum += g.res[i]; }
	out.i = sum;
	out.s.clear();
	format(out.s, "first sum: ", sum);
	out
}
@end
@entry 28ec5c5c5bf49a8a
kind: step
verb: swap
noun: head
modifier: in_reverse
context: loop
phrase: swap head items in reverse order spanning width {span}
phrase: invert order of leading loop elements within window {span}
slot: span int
test: list=10,20,30,40 span=3
expect: => i=3 r=0.0 ok=true s="swapped head: 3" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
test: list=5,15,25,35 span=2
expect: => i=2 r=0.0 ok=true s="swapped head: 2" errors=0 n=4 res=[15,5,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${span};
	if s > g.n { s = g.n; }
	var l = 0;
	var r = s - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = s;
	out.s.clear();
	format(out.s, "swapped head: ", s);
	out
}
@end
@entry a36344b9f2a32d8d
kind: step
verb: select
noun: series
modifier: while
context: loop
phrase: select series entries while cumulative sum remains below {max_sum}
phrase: gather series elements while running total does not exceed {max_sum}
slot: max_sum int
test: list=10,20,30,40 max_sum=35
expect: => i=2 r=0.0 ok=true s="series while count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 max_sum=12
expect: => i=1 r=0.0 ok=true s="series while count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var run_sum = 0;
	var count = 0;
	for i in g.n {
		if run_sum + g.res[i] <= ms {
			run_sum += g.res[i];
			g.res[count] = g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "series while count: ", count);
	out
}
@end
@entry 7fd2dd7c5f6d6fb2
kind: step
verb: check
noun: value
modifier: with_retry
context: loop
phrase: check value against target {target} allowing retries count {retries}
phrase: verify target value {target} in loop with retry limit {retries}
slot: target int
slot: retries int
test: list=1,2,5,7 target=5 retries=2
expect: => i=1 r=0.0 ok=true s="checked value: 1" errors=0 n=4 res=[1,2,5,7] cache=0 hits=0
test: list=1,2,3 target=9 retries=1
expect: => i=0 r=0.0 ok=false s="checked value: 0" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	let r = ${retries};
	var found = false;
	var attempts = 0;
	for i in g.n {
		if g.res[i] == t {
			found = true;
			break;
		}
		attempts++;
		if attempts > r { break; }
	}
	if !found {
		gold_fail(g, "value not found within retries");
		out.ok = false;
	}
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked value: ", out.i);
	out
}
@end
@entry f290af89d3b35f96
kind: step
verb: pair
noun: text
modifier: any
context: loop
phrase: pair text character codes exceeding threshold {threshold}
phrase: combine text code entries matching any bound {threshold}
slot: threshold int
test: list=65,70,66,72 threshold=68
expect: => i=2 r=0.0 ok=true s="text pairs: 2" errors=0 n=4 res=[65,70,66,72] cache=0 hits=0
test: list=50,60,70 threshold=55
expect: => i=1 r=0.0 ok=true s="text pairs: 1" errors=0 n=3 res=[50,60,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] >= th || g.res[i + 1] >= th {
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "text pairs: ", pairs);
	out
}
@end
@entry e4766721a930428e
kind: step
verb: scan
noun: results
modifier: sorted
context: loop
phrase: scan results to verify sorted order up to depth {depth}
phrase: inspect result ordering across prefix of size {depth}
slot: depth int
test: list=1,3,5,4 depth=3
expect: => i=1 r=0.0 ok=true s="is sorted: 1" errors=0 n=4 res=[1,3,5,4] cache=0 hits=0
test: list=10,5,20 depth=3
expect: => i=0 r=0.0 ok=true s="is sorted: 0" errors=0 n=3 res=[10,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var d = ${depth};
	if d > g.n { d = g.n; }
	var sorted = true;
	var i = 0;
	while i + 1 < d {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
		i++;
	}
	out.i = if sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "is sorted: ", out.i);
	out
}
@end
@entry 5cf1b3d23c3f5103
kind: step
verb: keep
noun: letters
modifier: between
context: loop
phrase: keep letters with code values between lower {lo} through upper {hi}
phrase: filter character codes falling between minimum {lo} to maximum {hi}
slot: lo int
slot: hi int
test: list=60,65,70,80,95 lo=64 hi=75
expect: => i=2 r=0.0 ok=true s="kept letters: 2" errors=0 n=2 res=[65,70] cache=0 hits=0
test: list=10,20,30,40 lo=15 hi=35
expect: => i=2 r=0.0 ok=true s="kept letters: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept letters: ", kept);
	out
}
@end
@entry 5b1cee1bd8830022
kind: step
verb: keep
noun: step
modifier: all
context: loop
phrase: keep step entries matching interval step size {step_size}
phrase: retain all loop step values divisible by unit {step_size}
slot: step_size int
test: list=5,10,12,15,20 step_size=5
expect: => i=4 r=0.0 ok=true s="kept steps: 4" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=3,6,7,9,11 step_size=3
expect: => i=3 r=0.0 ok=true s="kept steps: 3" errors=0 n=3 res=[3,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	if sz <= 0 { return out; }
	var kept = 0;
	for i in g.n {
		if g.res[i] % sz == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept steps: ", kept);
	out
}
@end
@entry 4a922389d57f237f
kind: step
