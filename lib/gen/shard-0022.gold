code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${query_key};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	let val, ok = gold_cache_get(g, k);
	if ok {
		gold_push(g, val);
		out.i = val;
		out.s.clear();
		format(out.s, "found memo value: ", val);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "memo key not found");
	}
	g.steps += g.n;
	out
}
@end
@entry 18865fe853bac7ce
kind: step
verb: limit
noun: budget
modifier: unique
context: transform
slot: max_cost int
phrase: limit unique values spending from budget {max_cost}
phrase: deduplicate elements within cumulative cost budget {max_cost}
test: list=5,5,10,10,15 max_cost=20
expect: => i=2 r=0.0 ok=true s="unique budget items kept: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=10,20,30 max_cost=15
expect: => i=1 r=0.0 ok=true s="unique budget items kept: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${max_cost};
	var spent = 0;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if !seen && spent + x <= budget {
			g.res[kept] = x;
			spent += x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique budget items kept: ", kept);
	out
}
@end
