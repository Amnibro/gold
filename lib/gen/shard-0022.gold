@entry f19617902d85ef36
kind: step
verb: sort
noun: range
modifier: while
context: search
phrase: sort search range while below score limit {limit}
phrase: order candidate range while values stay under {limit}
slot: limit int
test: list=50,20,30,80,15 limit=60
expect: => i=3 r=0.0 ok=true s="sorted range length: 3" errors=0 n=5 res=[20,30,50,80,15] cache=0 hits=0
test: list=45,10,35,25,90 limit=50
expect: => i=4 r=0.0 ok=true s="sorted range length: 4" errors=0 n=5 res=[10,25,35,45,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var span = 0;
	while span < g.n && g.res[span] < lim {
		span++;
	}
	if span < 2 {
		out.i = span;
		out.s.clear();
		format(out.s, "sorted range length: ", span);
		return out;
	}
	var i = 0;
	while i < span {
		var j = 0;
		while j < span - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += span * span;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted range length: ", span);
	out
}
@end
