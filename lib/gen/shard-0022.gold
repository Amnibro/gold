slot: lo int
slot: hi int
test: list=3,6,15,8,25 lo=5 hi=20
expect: => i=2 r=0.0 ok=true s="clamped nested odds" errors=0 n=5 res=[5,6,15,8,20] cache=0 hits=0
test: list=1,4,7,10,13 lo=2 hi=8
expect: => i=2 r=0.0 ok=true s="clamped nested odds" errors=0 n=5 res=[2,4,7,10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var clamped = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			if x < low { g.res[k] = low; clamped++; }
			else if x > high { g.res[k] = high; clamped++; }
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped nested odds");
	out
}
@end
@entry c76efbd32e8c5002
kind: step
verb: clamp
noun: histogram
modifier: while
context: math
phrase: clamp math histogram while count exceeds {max_freq}
phrase: limit frequency in math histogram to {max_freq}
slot: max_freq int
test: list=2,2,2,2,3,3,4 max_freq=2
expect: => i=2 r=0.0 ok=true s="clamped histogram while" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,6,6,7 max_freq=1
expect: => i=3 r=0.0 ok=true s="clamped histogram while" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_freq};
	if limit <= 0 { gold_fail(g, "invalid histogram limit"); out.ok = false; return out; }
	var kept = [0; 512];
	var kn = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = 0;
		for j in kn { if kept[j] == x { seen++; } }
		if seen < limit {
			kept[kn] = x;
			kn++;
		}
	}
	let dropped = g.n - kn;
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = dropped;
	out.s.clear();
	format(out.s, "clamped histogram while");
	out
}
@end
@entry 5a9454dc1dddc782
kind: step
verb: join
noun: results
modifier: pairwise
context: math
phrase: join math results pairwise
phrase: combine pairwise math results
test: list=2,3,4,5,6,7
expect: => i=68 r=0.0 ok=true s="results joined pairwise" errors=0 n=3 res=[6,20,42] cache=0 hits=0
test: list=1,10,3,4
expect: => i=22 r=0.0 ok=true s="results joined pairwise" errors=0 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { gold_fail(g, "insufficient results for pairwise join"); out.ok = false; return out; }
	var pairs = g.n / 2;
	var temp = [0; 256];
	var sum = 0;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let comb = a * b;
		temp[k] = comb;
		sum += comb;
	}
	gold_clear(g);
	for k in pairs { gold_push(g, temp[k]); }
	out.i = sum;
	out.s.clear();
	format(out.s, "results joined pairwise");
	out
}
@end
