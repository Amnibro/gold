code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var maxes = [0; 512];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		maxes[count] = if a > b { a } else { b };
		count++;
		i += 2;
	}
	g.n = 0;
	for j in count { gold_push(g, maxes[j]); }
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise peaks: ", count);
	out
}
@end
