fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let d = ${delta};
	let count = if k > g.n { g.n } else { k };
	let start = g.n - count;
	var i = start;
	while i < g.n {
		g.res[i] += d;
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped tail: ", count);
	out
}
@end
@entry b96997f8a0565f17
kind: step
verb: count
noun: results
modifier: sorted
context: transform
phrase: count results sorted stride step {step}
phrase: sorted count results with stride {step}
slot: step int
test: list=4,1,3,2,5 step=1
expect: => i=5 r=0.0 ok=true s="sorted results count: 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,15,30,25 step=2
expect: => i=3 r=0.0 ok=true s="sorted results count: 3" errors=0 n=5 res=[10,15,20,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	// simple insertion sort
	for i in 1..g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	var count = 0;
	var idx = 0;
	while idx < g.n {
		count++;
		idx += s;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted results count: ", count);
	out
}
@end
@entry c7bf1e33191fc5b4
kind: step
verb: merge
noun: sequence
modifier: times
context: transform
phrase: merge sequence times count {repeat}
phrase: times merge sequence repeating {repeat}
slot: repeat int
test: list=1,2,3 repeat=2
expect: => i=6 r=0.0 ok=true s="merged sequence: 6" errors=0 n=6 res=[1,2,3,1,2,3] cache=0 hits=0
test: list=5,10 repeat=3
expect: => i=6 r=0.0 ok=true s="merged sequence: 6" errors=0 n=6 res=[5,10,5,10,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${repeat};
	if rep <= 1 || g.n == 0 { return out; }
	let orig_n = g.n;
	var r = 1;
	while r < rep && g.n + orig_n <= 512 {
		for i in orig_n {
			g.res[g.n] = g.res[i];
			g.n++;
		}
		r++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged sequence: ", out.i);
	out
}
@end
@entry 9a73be02fe84e93b
kind: step
verb: select
noun: errors
modifier: sorted
context: transform
phrase: select errors sorted under {threshold}
phrase: sorted select errors below {threshold}
slot: threshold int
test: list=-5,10,-2,20,-8 threshold=0
expect: => i=3 r=0.0 ok=true s="selected errors: 3" errors=0 n=3 res=[-8,-5,-2] cache=0 hits=0
test: list=3,-1,4,-9,2 threshold=0
expect: => i=2 r=0.0 ok=true s="selected errors: 2" errors=0 n=2 res=[-9,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var new_n = 0;
	for i in g.n {
		if g.res[i] < th {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	// sort ascending
	for i in 1..g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected errors: ", out.i);
	out
}
@end
@entry 42f5fcf7f037ac5e
kind: step
verb: measure
noun: primes
modifier: every_other
context: transform
phrase: measure primes every other with bias {bias}
phrase: every other prime measurement bias {bias}
slot: bias int
test: list=2,3,4,5,6,7 bias=1
expect: => i=3 r=0.0 ok=true s="primes every other: 3" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=11,12,13,14,17 bias=0
expect: => i=3 r=0.0 ok=true s="primes every other: 3" errors=0 n=5 res=[11,12,13,14,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var primes = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i] + b;
		if x >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_prime = false; break; }
				d++;
			}
			if is_prime { primes++; }
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "primes every other: ", primes);
	out
}
@end
