@entry e5ac0ca069dd0c84
kind: step
verb: rotate
noun: loop
modifier: times
context: math
phrase: rotate loop times cyclically shifting list elements {k} steps in math
phrase: cyclically rotate list loop elements by {k} positions in math
slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="rotated loop times: 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="rotated loop times: 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	if g.n > 1 {
		let shift = if req < 0 { 0 } else { req % g.n };
		for s in shift {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
		out.i = shift;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated loop times: ", out.i);
	out
}
@end
@entry 4f9396a923cc0f79
kind: step
verb: validate
noun: window
modifier: nested
context: math
phrase: validate window nested checking rolling sum of pairs under {cap} in math
phrase: verify all adjacent pair sums remain below ceiling {cap} in math
slot: cap int
test: list=2,4,3,5 cap=10
expect: => i=1 r=0.0 ok=true s="nested window pair sum valid" errors=0 n=4 res=[2,4,3,5] cache=0 hits=0
test: list=4,7,5,8 cap=11
expect: => i=0 r=0.0 ok=false s="nested window pair sum exceeded" errors=1 n=4 res=[4,7,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var valid = true;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] + g.res[i + 1] > limit {
				valid = false;
				break;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "nested window pair sum valid");
	} else {
		gold_fail(g, "nested window pair sum exceeded");
		format(out.s, "nested window pair sum exceeded");
	}
	out
}
@end
