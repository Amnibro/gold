code:
fn ${ID}(g Gold&, v Val) Val {
	let s = ${shift};
	var out = v;
	out.s.clear();
	format(out.s, "rotated: [");
	if g.n > 0 {
		let eff = s % g.n;
		for i in g.n {
			if i > 0 { format(out.s, ", "); }
			let idx = (g.n - eff + i) % g.n;
			format(out.s, g.res[idx]);
		}
	}
	format(out.s, "]");
	out.i = s;
	g.steps += g.n;
	out
}
@end
