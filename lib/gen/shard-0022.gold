expect: => i=8 r=0.0 ok=true s="tail sum: 8" errors=0 n=5 res=[8,3,7,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	var sum = 0;
	var found = false;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == target {
			found = true;
			break;
		}
		sum += g.res[i];
		if i == 0 { break; }
		i--;
	}
	out.ok = found;
	out.i = sum;
	out.s.clear();
	format(out.s, "tail sum: ", sum);
	out
}
@end
