fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		g.res[i] = (g.res[i] + g.res[i + 1]) / 2 + b;
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "averaged pairs: ", out.i);
	out
}
