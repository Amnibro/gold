test: list=2,2,4,6,8
expect: => i=1 r=0.0 ok=true s="dropped pairs: 1" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var start = 0;
	while start + 1 < g.n && g.res[start] == g.res[start + 1] {
		dropped += 2;
		start += 2;
	}
	if dropped > 0 {
		var remaining = [0; 512];
		let rem_cnt = g.n - start;
		for i in rem_cnt { remaining[i] = g.res[start + i]; }
		g.n = 0;
		for i in rem_cnt { gold_push(g, remaining[i]); }
	}
	out.i = dropped / 2;
	out.s.clear();
	format(out.s, "dropped pairs: ", dropped / 2);
	out
}
@end
