code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			total += x;
			count++;
			gold_cache_put(g, count, total);
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "joined ", count, " odds total=", total);
	out
}
@end
