	var out = v;
	let limit = ${max_occ};
	var kept = [0; 512];
	var nk = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq <= limit { kept[nk] = x; nk++; }
	}
	g.n = 0;
	for i in nk { gold_push(g, kept[i]); }
	out.i = nk;
	out.s.clear();
	format(out.s, "drop tally all: ", nk);
	out
}
@end
@entry f10a2d3d26551903
kind: step
verb: limit
noun: steps
modifier: pairwise
context: list
phrase: limit steps pairwise maximum change {delta}
phrase: constrain steps pairwise slope {delta}
slot: delta int
test: list=10,25,18,40,35 delta=10
expect: => i=2 r=0.0 ok=true s="limit steps pairwise: 2" errors=0 n=5 res=[10,20,18,28,35] cache=0 hits=0
test: list=5,22,12,30,15 delta=8
expect: => i=2 r=0.0 ok=true s="limit steps pairwise: 2" errors=0 n=5 res=[5,13,12,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${delta};
	if g.n < 2 || max_d <= 0 { return out; }
	var clamped = 0;
	for i in g.n - 1 {
		let cur = g.res[i];
		let nxt = g.res[i + 1];
		if nxt - cur > max_d {
			g.res[i + 1] = cur + max_d;
			clamped++;
		} else if cur - nxt > max_d {
			g.res[i + 1] = cur - max_d;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "limit steps pairwise: ", clamped);
	out
}
@end
