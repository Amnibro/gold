	if !gold_img_ok(g) { out.ok = false; return out; }
	let cx = ((g.iw - 1) as real) / 2.0;
	let cy = ((g.ih - 1) as real) / 2.0;
	var rr = (g.iw as real) / 2.0;
	if g.ih < g.iw { rr = (g.ih as real) / 2.0; }
	for y in g.ih {
		for x in g.iw {
			let a = (x as real) - cx;
			let b = (y as real) - cy;
			g.img[y * g.iw + x] = gold_clamp01(1.0 - sqrt(a * a + b * b) / rr);
		}
	}
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.5 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "wood");
	out
}
@end
