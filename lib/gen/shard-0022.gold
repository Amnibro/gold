fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	let n_rot = if win > g.n { g.n } else { win };
	if n_rot > 1 {
		let first_val = g.res[0];
		var i = 0;
		while i < n_rot - 1 {
			g.res[i] = g.res[i + 1];
			gold_cache_put(g, i, g.res[i]);
			i++;
		}
		g.res[n_rot - 1] = first_val;
		gold_cache_put(g, n_rot - 1, first_val);
	}
	g.steps += n_rot;
	out.i = n_rot;
	out.s.clear();
	format(out.s, "rotated window in place=", n_rot);
	out
}
