kind: step
verb: reverse
noun: average
modifier: nested
context: loop
phrase: reverse nested groups of elements using block size {block_size}
phrase: invert nested loop partitions with segment width {block_size}
slot: block_size int
test: list=1,2,3,4,5,6 block_size=3
expect: => i=3 r=0.0 ok=true s="reversed nested blocks: 3" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 block_size=2
expect: => i=2 r=0.0 ok=true s="reversed nested blocks: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block_size};
	if b <= 1 { return out; }
	var i = 0;
	while i < g.n {
		var r = i + b - 1;
		if r >= g.n { r = g.n - 1; }
		var l = i;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		i += b;
	}
	out.i = b;
	out.s.clear();
	format(out.s, "reversed nested blocks: ", b);
	out
}
@end
