context: search
phrase: rotate duplicate search entries by offset {shift}
phrase: shift duplicate candidate results by displacement {shift}
slot: shift int
test: list=4,2,4,5,4 shift=1
expect: => i=5 r=0.0 ok=true s="rotate duplicates none: 5" errors=0 n=5 res=[4,4,2,4,5] cache=0 hits=0
test: list=7,3,7,7,9 shift=2
expect: => i=5 r=0.0 ok=true s="rotate duplicates none: 5" errors=0 n=5 res=[7,9,7,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		let eff = s % g.n;
		var rotated = [0; 512];
		for i in g.n {
			rotated[(i + eff) % g.n] = g.res[i];
		}
		for i in g.n { g.res[i] = rotated[i]; }
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotate duplicates none: ", g.n);
	out
}
@end
@entry 37925dfd072e28bd
kind: step
verb: validate
noun: gaps
modifier: with_retry
context: search
phrase: validate search result gaps {max_gap} with retry {retries}
phrase: check candidate score spacing {max_gap} with retry allowance {retries}
slot: max_gap int
slot: retries int
test: list=10,25,30,55 max_gap=20 retries=1
expect: => i=1 r=0.0 ok=true s="validate gaps: 1" errors=0 n=4 res=[10,25,30,55] cache=0 hits=0
test: list=5,30,60,95 max_gap=15 retries=1
expect: => i=3 r=0.0 ok=false s="validate gaps: 3" errors=1 n=4 res=[5,30,60,95] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	let r = ${retries};
	var violations = 0;
	for i in g.n - 1 {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff > mg { violations++; }
	}
	let valid = violations <= r;
	if !valid {
		gold_fail(g, "gap validation failed");
		out.ok = false;
	}
	out.i = violations;
	out.s.clear();
	format(out.s, "validate gaps: ", violations);
	out
}
@end
