test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="reversed memo count: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed memo count: 3" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed memo count: ", g.n);
	out
}
@end
@entry 844d6cadd66c9d85
kind: step
verb: count
noun: suffix
modifier: sorted
context: aggregate
phrase: count suffix sorted trailing span
phrase: measure longest sorted suffix length
test: list=5,2,4,6,8
expect: => i=4 r=0.0 ok=true s="sorted suffix len: 4" errors=0 n=5 res=[5,2,4,6,8] cache=0 hits=0
test: list=1,7,3,5
expect: => i=2 r=0.0 ok=true s="sorted suffix len: 2" errors=0 n=4 res=[1,7,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "sorted suffix len: 0");
		return out;
	}
	var len = 1;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i - 1] <= g.res[i] {
			len++;
		} else {
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted suffix len: ", len);
	out
}
@end
