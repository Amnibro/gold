@entry 29aef9a581211f83
kind: step
verb: search
noun: digits
modifier: with_retry
context: math
phrase: search digits with retry seeking target digit {target_d} in math
phrase: retry searching for digit {target_d} across list items in math
slot: target_d int
test: list=12,34,56 target_d=4
expect: => i=34 r=0.0 ok=true s="searched digit with retry: 34" errors=0 n=3 res=[12,34,56] cache=0 hits=0
test: list=12,34,56 target_d=7
expect: => i=0 r=0.0 ok=false s="searched digit with retry: 0" errors=0 n=3 res=[12,34,56] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var target = ${target_d};
	var found = false;
	var match_val = 0;
	var attempts = 0;
	while attempts < 2 && !found {
		for i in g.n {
			var x = g.res[i];
			if x < 0 { x = -x; }
			while x > 0 {
				if x % 10 == target {
					found = true;
					match_val = g.res[i];
					break;
				}
				x /= 10;
			}
			if found { break; }
		}
		if !found {
			target++;
			attempts++;
		}
	}
	g.steps += g.n * (attempts + 1);
	out.ok = found;
	out.i = match_val;
	out.s.clear();
	format(out.s, "searched digit with retry: ", match_val);
	out
}
@end
