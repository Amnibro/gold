verb: validate
noun: middle
modifier: nested
context: search
phrase: validate nested middle search candidates across span {span} baseline {expected_min}
phrase: verify nested interior search scores for span {span} minimum {expected_min}
slot: span int
slot: expected_min int
test: list=10,55,65,70,12 span=3 expected_min=50
expect: => i=1 r=0.0 ok=true s="validate middle: 1" errors=0 n=5 res=[10,55,65,70,12] cache=0 hits=0
test: list=5,20,30,40,8 span=3 expected_min=35
expect: => i=0 r=0.0 ok=false s="validate middle: 0" errors=1 n=5 res=[5,20,30,40,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let em = ${expected_min};
	var ok_mid = true;
	if g.n >= sp {
		let start = (g.n - sp) / 2;
		for i in sp {
			if g.res[start + i] < em { ok_mid = false; break; }
		}
	} else {
		ok_mid = false;
	}
	if !ok_mid {
		gold_fail(g, "middle validation failed");
		out.ok = false;
	}
	out.i = if ok_mid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validate middle: ", out.i);
	out
}
@end
