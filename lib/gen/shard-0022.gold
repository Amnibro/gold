expect: => i=4 r=0.0 ok=true s="merged series: 4" errors=0 n=4 res=[10,3,15,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var new_n = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] >= mv && g.res[i + 1] >= mv {
			g.res[new_n] = g.res[i] + g.res[i + 1];
			new_n++;
			i += 2;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
			i++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged series: ", new_n);
	out
}
@end
