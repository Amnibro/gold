code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached, ok = gold_cache_get(g, k);
	if ok {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached vowels: ", cached);
		return out;
	}
	var vowels = 0;
	for b in v.s {
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels++;
		}
	}
	gold_cache_put(g, k, vowels);
	g.steps += v.s.len;
	out.i = vowels;
	out.s.clear();
	format(out.s, "counted vowels: ", vowels);
	out
}
@end
