	var x = if n < 0 { -n } else { n };
	if x < 100 { return x; }
	var pre = x / 1000;
	var sfx = x % 1000;
	var d0 = sfx / 100;
	var d1 = (sfx / 10) % 10;
	var d2 = sfx % 10;
	if d0 > d1 { let t = d0; d0 = d1; d1 = t; }
	if d1 > d2 { let t = d1; d1 = d2; d2 = t; }
	if d0 > d1 { let t = d0; d0 = d1; d1 = t; }
	pre * 1000 + d0 * 100 + d1 * 10 + d2
}
@end
