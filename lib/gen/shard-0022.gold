phrase: accumulate digits up_to digit cap {max_d}
slot: max_d int
test: list=14,28,35 max_d=4
expect: => i=10 r=0.0 ok=true s="sum digits up_to: 10" errors=0 n=3 res=[14,28,35] cache=0 hits=0
test: list=62,19,43 max_d=3
expect: => i=6 r=0.0 ok=true s="sum digits up_to: 6" errors=0 n=3 res=[62,19,43] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_d};
	var sum_d = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		if x == 0 && limit >= 0 { sum_d += 0; }
		while x > 0 {
			let d = x % 10;
			if d <= limit { sum_d += d; }
			x = x / 10;
		}
	}
	out.i = sum_d;
	out.s.clear();
	format(out.s, "sum digits up_to: ", sum_d);
	out
}
@end
