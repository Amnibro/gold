code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k_lim = ${k};
	var kept = [0; 512];
	var kn = 0;
	var seen = [0; 512];
	var sn = 0;
	for i in g.n {
		let x = g.res[i];
		if i < k_lim {
			var is_dup = false;
			for j in sn { if seen[j] == x { is_dup = true; break; } }
			if !is_dup { seen[sn] = x; sn++; kept[kn] = x; kn++; }
		} else {
			kept[kn] = x; kn++;
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "filter duplicates first: ", kn);
	out
}
@end
