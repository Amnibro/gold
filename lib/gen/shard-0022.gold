code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_val = ${gap};
	if g_val <= 0 || g_val >= g.n { return out; }
	var swaps = 0;
	var i = 0;
	while i + g_val < g.n {
		if g.res[i] > g.res[i + g_val] {
			let t = g.res[i];
			g.res[i] = g.res[i + g_val];
			g.res[i + g_val] = t;
			swaps++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "gap pass swaps: ", swaps);
	out
}
@end
