fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[256] = [0; 256];
	var ecount = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			evens[ecount] = x;
			ecount++;
		}
	}
	// Sort evens ascending
	var i = 0;
	while i < ecount {
		var j = i + 1;
		while j < ecount {
			if evens[j] < evens[i] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i, evens[i]);
		i++;
	}
	gold_clear(g);
	for k in ecount { gold_push(g, evens[k]); }
	g.steps += g.n + ecount * ecount;
	out.i = ecount;
	out.s.clear();
	format(out.s, "sorted evens count=", ecount);
	out
}
@end
