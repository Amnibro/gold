@entry d3c4856b3d402b04
kind: step
verb: pair
noun: gaps
modifier: unique
context: loop
phrase: pair gaps unique differences across loop sequence
phrase: couple unique gap intervals between consecutive loop items
test: list=1,3,5,9,11
expect: => i=2 r=0.0 ok=true s="unique gaps paired: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20,25,35,40
expect: => i=2 r=0.0 ok=true s="unique gaps paired: 2" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "unique gaps paired: 0");
		return out;
	}
	var gaps = [0, 0, 0, 0, 0, 0, 0, 0];
	var gn = 0;
	var i = 0;
	while i + 1 < g.n && gn < 8 {
		let diff = g.res[i + 1] - g.res[i];
		var seen = false;
		for k in gn {
			if gaps[k] == diff {
				seen = true;
				break;
			}
		}
		if !seen {
			gaps[gn] = diff;
			gn++;
		}
		i++;
	}
	g.n = 0;
	for k in gn {
		gold_push(g, gaps[k]);
	}
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "unique gaps paired: ", out.i);
	out
}
@end
