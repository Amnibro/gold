noun: streak
modifier: last
context: format
phrase: format search for last streak length
phrase: display length of final consecutive streak
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="last streak: 3" errors=0 n=5 res=[1,2,3,3,3] cache=0 hits=0
test: list=5,5,4,4
expect: => i=2 r=0.0 ok=true s="last streak: 2" errors=0 n=4 res=[5,5,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "last streak: 0");
		out.i = 0;
		return out;
	}
	let target = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == target {
		count++;
		i--;
	}
	format(out.s, "last streak: ", count);
	out.i = count;
	g.steps += g.n;
	out
}
@end
