@entry c63f7c3c8648212d
kind: step
verb: fill
noun: range
modifier: with_retry
context: error
phrase: fill error range across {lo} to {hi} with retry {retries}
phrase: generate fault range from {lo} to {hi} retry limit {retries}
slot: lo int
slot: hi int
slot: retries int
test: lo=3 hi=6 retries=1
expect: => i=4 r=0.0 ok=true s="filled range count: 4" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: lo=10 hi=7 retries=2
expect: => i=4 r=0.0 ok=true s="filled range count: 4" errors=1 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${lo};
	var h = ${hi};
	let r = ${retries};
	if l > h {
		if r > 0 {
			let tmp = l;
			l = h;
			h = tmp;
			gold_fail(g, "inverted bounds recovered via retry");
		} else {
			gold_fail(g, "inverted bounds without retry");
			out.ok = false;
			return out;
		}
	}
	gold_clear(g);
	var cur = l;
	while cur <= h {
		gold_push(g, cur);
		cur++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled range count: ", g.n);
	out
}
@end
