modifier: safely
context: retry
slot: val int
phrase: join value safely into retry delay queue with val {val}
phrase: append retry delay value safely bounded by {val}
test: list=10,20,30 val=40
expect: => i=4 r=0.0 ok=true s="safely appended retry value: 40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15 val=-5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let x = ${val};
	if x < 0 {
		gold_fail(g, "join value safely: negative retry interval rejected");
		out.ok = false;
		return out;
	}
	if g.n >= 512 {
		gold_fail(g, "join value safely: retry buffer overflow");
		out.ok = false;
		return out;
	}
	gold_push(g, x);
	g.steps += 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely appended retry value: ", x);
	out
}
@end
@entry 42cf72fde1a1844e
kind: step
verb: rotate
noun: values
modifier: unique
context: retry
phrase: rotate values unique retry attempt codes cyclically
phrase: cyclically rotate unique retry status values in buffer
test: list=100,200,100,300,200
expect: => i=3 r=0.0 ok=true s="unique rotated retry values: 3" errors=0 n=3 res=[200,300,100] cache=0 hits=0
test: list=5,10,15,20
expect: => i=4 r=0.0 ok=true s="unique rotated retry values: 4" errors=0 n=4 res=[10,15,20,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var u int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < un {
			if u[j] == x { exists = true; break; }
			j++;
		}
		if !exists {
			u[un] = x;
			un++;
		}
		i++;
	}
	if un > 1 {
		let first = u[0];
		var k = 0;
		while k + 1 < un {
			u[k] = u[k + 1];
			k++;
		}
		u[un - 1] = first;
	}
	var m = 0;
	while m < un {
		g.res[m] = u[m];
		m++;
	}
	g.n = un;
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "unique rotated retry values: ", un);
	out
}
@end
@entry 0999c2b712ff461b
kind: step
verb: validate
noun: gaps
modifier: first
context: retry
slot: max_gap int
phrase: validate gaps first interval between retries against max {max_gap}
phrase: check initial retry gap does not exceed bound {max_gap}
test: list=10,25,45 max_gap=20
expect: => i=15 r=0.0 ok=true s="first retry gap valid: 15" errors=0 n=3 res=[10,25,45] cache=0 hits=0
test: list=10,35,40 max_gap=15
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,35,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "validate gaps first: insufficient retry points");
		out.ok = false;
		return out;
	}
	let gap = g.res[1] - g.res[0];
	let abs_gap = if gap < 0 { -gap } else { gap };
	if abs_gap > mg {
		gold_fail(g, "validate gaps first: first gap exceeds threshold");
		out.ok = false;
		return out;
	}
	g.steps += 1;
	out.i = abs_gap;
	out.s.clear();
	format(out.s, "first retry gap valid: ", abs_gap);
	out
}
@end
@entry 6bdf9de08aa4e03f
kind: step
verb: sort
noun: loop
modifier: recursively
context: retry
slot: limit int
phrase: sort loop recursively ordering retry counts up to {limit}
phrase: order retry loop iterations recursively within bound {limit}
test: list=45,12,89,33,5 limit=50
expect: => i=5 r=0.0 ok=true s="recursively sorted retry loop: 5" errors=0 n=5 res=[5,12,33,45,89] cache=0 hits=0
test: list=100,20,60,80,40 limit=3
expect: => i=3 r=0.0 ok=true s="recursively sorted retry loop: 3" errors=0 n=5 res=[20,60,100,80,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var m = g.n;
	if m > lim { m = lim; }
	var i = 0;
	while i < m {
		var j = i + 1;
		while j < m {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "recursively sorted retry loop: ", m);
	out
}
@end
@entry 4027544f66817733
kind: step
verb: dedupe
noun: numbers
modifier: sorted
context: retry
phrase: dedupe numbers sorted across retry sequence
phrase: remove duplicate numbers in sorted retry backoff schedule
test: list=10,10,20,30,30,30,40
expect: => i=4 r=0.0 ok=true s="deduped sorted retry counts: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,5,15,25,25
expect: => i=3 r=0.0 ok=true s="deduped sorted retry counts: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var u int[512] = [0; 512];
	u[0] = g.res[0];
	var un = 1;
	var k = 1;
	while k < g.n {
		if g.res[k] != g.res[k - 1] {
			u[un] = g.res[k];
			un++;
		}
		k++;
	}
	var m = 0;
	while m < un {
		g.res[m] = u[m];
		m++;
	}
	g.n = un;
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "deduped sorted retry counts: ", un);
	out
}
@end
