code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${th};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var w = 0;
	for i in g.cn {
		if g.cv[i] < limit {
			g.ck[w] = g.ck[i];
			g.cv[w] = g.cv[i];
			w++;
		}
	}
	g.cn = w;
	g.steps += g.cn;
	out.i = w;
	out.s.clear();
	format(out.s, "filtered cache entries count: ", w);
	out
}
@end
@entry ca452188dddb1318
kind: step
verb: trace
noun: tail
modifier: last
context: math
phrase: trace tail last keeping {k} trailing values in math
phrase: inspect last tail elements taking {k} items in math
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="traced tail last items: 3" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="traced tail last items: 2" errors=0 n=2 res=[40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	var count = req;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced tail last items: ", count);
	out
}
@end
