expect: 3
expect: 1
test: arg=10,12
expect: 4
expect: 2
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val == 0 {
		return 0;
	}
	var runs = 1;
	var prev_parity = val % 2;
	val /= 2;
	while val > 0 {
		let cur_parity = val % 2;
		if cur_parity != prev_parity {
			runs++;
			prev_parity = cur_parity;
		}
		val /= 2;
	}
	runs
}
@end
