code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if out.i < 0 { -out.i } else { out.i };
	gold_clear(g);
	if x == 0 {
		gold_push(g, 0);
	} else {
		while x > 0 {
			gold_push(g, x % 10);
			x /= 10;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced digits in reverse");
	out
}
@end
