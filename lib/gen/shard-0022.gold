expect: => i=5 r=0.0 ok=true s="scaled runs capped at 2" errors=0 n=5 res=[6,6,6,9,9] cache=0 hits=0
test: list=5,5,5,5 cap=3 factor=2
expect: => i=4 r=0.0 ok=true s="scaled runs capped at 3" errors=0 n=4 res=[10,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let f = ${factor};
	var cur_run = 0;
	for i in g.n {
		if i == 0 || g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			cur_run = 1;
		}
		if cur_run <= c {
			g.res[i] *= f;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled runs capped at ", c);
	out
}
@end
