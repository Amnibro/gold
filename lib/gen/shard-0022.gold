fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_cnt = 0;
	var last_odd = 1;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odd_cnt++;
			last_odd = g.res[i];
