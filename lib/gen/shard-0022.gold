@entry 9a7be9b37a430d74
kind: step
verb: join
noun: histogram
modifier: nested
context: retry
phrase: join histogram nested bucket counts into retry buffer
phrase: compute frequency histogram distribution across retry attempts
test: list=10,20,10,30,20,10
expect: => i=3 r=0.0 ok=true s="joined nested histogram frequencies: 3" errors=0 n=9 res=[10,20,10,30,20,10,3,2,1] cache=0 hits=0
test: list=5,5,5,15,15
expect: => i=2 r=0.0 ok=true s="joined nested histogram frequencies: 2" errors=0 n=7 res=[5,5,5,15,15,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals int[256] = [0; 256];
	var counts int[256] = [0; 256];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var idx = -1;
		var j = 0;
		while j < un {
			if vals[j] == x { idx = j; break; }
			j++;
		}
		if idx >= 0 {
			counts[idx]++;
		} else if un < 256 {
			vals[un] = x;
			counts[un] = 1;
			un++;
		}
		i++;
	}
	var k = 0;
	while k < un && g.n < 512 {
		gold_push(g, counts[k]);
		k++;
	}
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "joined nested histogram frequencies: ", un);
	out
}
@end
