code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ucount = 0;
	var ulist = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == 1 {
			ulist[ucount] = x;
			ucount++;
		}
	}
	gold_clear(g);
	for k in ucount { gold_push(g, ulist[k]); }
	out.i = ucount;
	out.s.clear();
	format(out.s, "searched unique sequence");
	out
}
@end
@entry 8e11d744f57787f9
kind: step
verb: clamp
noun: range
modifier: each
context: math
phrase: clamp each math value across bounds {low} to {high}
phrase: restrict each value to math range {low} to {high}
slot: low int
slot: high int
test: list=5,15,25,35 low=10 high=30
expect: => i=2 r=0.0 ok=true s="clamped range each" errors=0 n=4 res=[10,15,25,30] cache=0 hits=0
test: list=-5,0,50,100 low=0 high=40
expect: => i=3 r=0.0 ok=true s="clamped range each" errors=0 n=4 res=[0,0,40,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo > hi { gold_fail(g, "invalid clamp range"); out.ok = false; return out; }
	var clamped_count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < lo { x = lo; clamped_count++; }
		else if x > hi { x = hi; clamped_count++; }
		g.res[k] = x;
	}
	out.i = clamped_count;
	out.s.clear();
	format(out.s, "clamped range each");
	out
}
@end
@entry 3808468aae0f6261
kind: step
verb: sort
noun: window
modifier: sorted
context: math
phrase: sort sliding math window {win}
phrase: order local math window {win}
slot: win int
test: list=8,3,5,1,9,2 win=3
expect: => i=3 r=0.0 ok=true s="sorted window sorted" errors=0 n=6 res=[3,1,5,2,8,9] cache=0 hits=0
test: list=10,4,7,2 win=2
expect: => i=2 r=0.0 ok=true s="sorted window sorted" errors=0 n=4 res=[4,7,2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 1 || g.n <= 1 { out.s.clear(); format(out.s, "window sort bypassed"); return out; }
	let sz = if w > g.n { g.n } else { w };
	for start in 0..g.n - sz + 1 {
		for i in start..start + sz {
			for j in i + 1..start + sz {
				if g.res[j] < g.res[i] {
					let t = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = t;
				}
			}
		}
	}
	out.i = sz;
	out.s.clear();
	format(out.s, "sorted window sorted");
	out
}
@end
@entry eb183437761c6ed0
kind: step
verb: sort
noun: streak
modifier: pairwise
context: math
phrase: sort pairwise math streak
phrase: order adjacent math streak pairs
test: list=9,2,8,3,7,4
expect: => i=3 r=0.0 ok=true s="sorted streak pairwise" errors=0 n=6 res=[2,9,3,8,4,7] cache=0 hits=0
test: list=5,1,4,2,3,0
expect: => i=3 r=0.0 ok=true s="sorted streak pairwise" errors=0 n=6 res=[1,5,2,4,0,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.s.clear(); format(out.s, "streak sort skipped"); return out; }
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
		}
		i += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted streak pairwise");
	out
}
@end
@entry 19e946f47d674294
kind: step
verb: clamp
noun: limit
modifier: last
context: math
phrase: clamp last math result to limit {limit}
phrase: cap trailing math result at limit {limit}
slot: limit int
test: list=12,24,36 limit=20
expect: => i=20 r=0.0 ok=true s="clamped limit last" errors=0 n=3 res=[12,24,20] cache=0 hits=0
test: list=5,10,15 limit=25
expect: => i=15 r=0.0 ok=true s="clamped limit last" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 { gold_fail(g, "empty results for clamp limit"); out.ok = false; return out; }
	let last_idx = g.n - 1;
	let orig = g.res[last_idx];
	if orig > lim {
		g.res[last_idx] = lim;
		out.i = lim;
	} else {
		out.i = orig;
	}
	out.s.clear();
	format(out.s, "clamped limit last");
	out
}
@end
