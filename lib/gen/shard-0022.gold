expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var digits int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = digits[len - 1];
	var prev = digits[len - 1];
	var i = len - 2;
	while i >= 0 {
		let d = digits[i];
		if d != prev {
			res = res * 10 + d;
			prev = d;
		}
		i--;
	}
	res
}
@end
