code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			gold_cache_put(g, i, diff);
		}
		out.i = g.cn;
		out.s.clear();
		format(out.s, "cached ", g.cn, " gaps");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps to cache");
	}
	g.steps += g.n;
	out
}
@end
