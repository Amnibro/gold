phrase: elevate threshold with_retry baseline {floor} delta {step}
slot: floor int
slot: step int
test: list=5,12,8,20,3 floor=10 step=3
expect: => i=6 r=0.0 ok=true s="shift threshold with_retry: 6" errors=0 n=5 res=[11,12,11,20,12] cache=0 hits=0
test: list=14,7,25,11,9 floor=15 step=4
expect: => i=6 r=0.0 ok=true s="shift threshold with_retry: 6" errors=0 n=5 res=[18,15,25,15,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let st = ${step};
	if st <= 0 { return out; }
	var retries = 0;
	for i in g.n {
		while g.res[i] < fl && retries < 100 {
			g.res[i] += st;
			retries++;
		}
	}
	out.i = retries;
	out.s.clear();
	format(out.s, "shift threshold with_retry: ", retries);
	out
}
@end
@entry ddfaa63cd133abd0
kind: step
verb: drop
noun: histogram
modifier: recursively
context: list
phrase: drop histogram recursively peak elements
phrase: eliminate histogram recursively modal values
test: list=2,5,2,8,5,2,9
expect: => i=3 r=0.0 ok=true s="drop histogram recursively: 3" errors=0 n=4 res=[5,8,5,9] cache=0 hits=0
test: list=7,3,7,3,7,4,8
expect: => i=3 r=0.0 ok=true s="drop histogram recursively: 3" errors=0 n=4 res=[3,3,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var max_freq = 0;
	var mode_val = g.res[0];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > max_freq {
			max_freq = freq;
			mode_val = x;
		}
	}
	var kept = [0; 512];
	var nk = 0;
	for i in g.n {
		if g.res[i] != mode_val {
			kept[nk] = g.res[i];
			nk++;
		}
	}
	g.n = 0;
	for i in nk { gold_push(g, kept[i]); }
	out.i = max_freq;
	out.s.clear();
	format(out.s, "drop histogram recursively: ", max_freq);
	out
}
@end
