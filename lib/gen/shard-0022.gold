code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let l = ${len};
	if s < 0 || s >= g.n || l <= 0 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "empty window");
		return out;
	}
	let end_idx = if s + l < g.n { s + l } else { g.n };
	var temp = [0; 512];
	var nn = 0;
	var i = s;
	while i < end_idx {
		temp[nn] = g.res[i];
		nn++;
		i++;
	}
	gold_clear(g);
	for j in nn { gold_push(g, temp[j]); }
	g.steps += nn;
	out.i = nn;
	out.s.clear();
	format(out.s, "safely returned window: ", nn);
	out
}
@end
