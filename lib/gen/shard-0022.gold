fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var shifts = 0;
	while g.n > 1 && g.res[0] < lim && shifts < g.n {
		let head = g.res[0];
		for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = head;
		shifts++;
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "shift items while: ", shifts);
	out
}
@end
