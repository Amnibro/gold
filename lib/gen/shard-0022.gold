code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { out.s.clear(); format(out.s, "clamp streak none bypassed"); return out; }
	var temp = [0; 512];
	var count = 0;
	var dropped = 0;
	for k in g.n {
		if k == 0 || g.res[k] != g.res[k - 1] {
			temp[count] = g.res[k];
			count++;
		} else {
			dropped++;
		}
	}
	gold_clear(g);
	for k in count { gold_push(g, temp[k]); }
	out.i = dropped;
	out.s.clear();
	format(out.s, "clamped streak none");
	out
}
@end
