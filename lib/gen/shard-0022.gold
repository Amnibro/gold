fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${mul};
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var scaled = 0;
	for k in g.n {
		if g.res[k] <= lim {
			g.res[k] *= factor;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled up to limit: ", scaled);
	out
}
@end
