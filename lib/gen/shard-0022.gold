fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	if sz <= 0 {
		gold_fail(g, "step size must be positive");
		out.ok = false;
		return out;
	}
	var groups = 0;
	var i = 0;
	while i < g.n {
		var s = 0;
		var j = 0;
		while j < sz && i + j < g.n {
			s += g.res[i + j];
			j++;
		}
		g.res[groups] = s;
		groups++;
		i += sz;
	}
	g.n = groups;
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped step count: ", groups);
	out
}
@end
