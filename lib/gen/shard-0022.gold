@entry c36affddcbf4a167
kind: step
verb: dedupe
noun: head
modifier: none
context: cache
phrase: dedupe head elements without filter
phrase: remove duplicates from head elements
test: list=4,4,4,7,9
expect: => i=3 r=0.0 ok=true s="deduped head count=3" errors=0 n=3 res=[4,7,9] cache=1 hits=0
test: list=12,12,15,18
expect: => i=2 r=0.0 ok=true s="deduped head count=2" errors=0 n=3 res=[12,15,18] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let head_val = g.res[0];
	var count = 0;
	var i = 0;
	while i < g.n && g.res[i] == head_val {
		count++;
		i++;
	}
	gold_cache_put(g, head_val, count);
	// Remove duplicate head elements keeping just one
	if count > 1 {
		let remove_n = count - 1;
		var j = 1;
		while j + remove_n < g.n {
			g.res[j] = g.res[j + remove_n];
			j++;
		}
		g.n -= remove_n;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "deduped head count=", count);
	out
}
@end
