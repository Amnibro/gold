@entry 363e9e7cb51dd94f
kind: step
verb: sort
noun: prefix
modifier: unique
context: math
phrase: sort unique prefix elements {len}
phrase: order distinct math prefix {len}
slot: len int
test: list=9,4,9,2,7,1 len=4
expect: => i=3 r=0.0 ok=true s="sorted unique prefix" errors=0 n=5 res=[2,4,9,7,1] cache=0 hits=0
test: list=5,5,3,8,1,2 len=5
expect: => i=4 r=0.0 ok=true s="sorted unique prefix" errors=0 n=5 res=[1,3,5,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pfx = ${len};
	if pfx <= 0 || g.n == 0 { gold_fail(g, "invalid prefix length"); out.ok = false; return out; }
	let limit = if pfx > g.n { g.n } else { pfx };
	var buf = [0; 512];
	for k in limit { buf[k] = g.res[k]; }
	for i in limit {
		for j in i + 1..limit {
			if buf[j] < buf[i] {
				let t = buf[i];
				buf[i] = buf[j];
				buf[j] = t;
			}
		}
	}
	var ucount = 0;
	var ubuf = [0; 512];
	for k in limit {
		if k == 0 || buf[k] != buf[k - 1] {
			ubuf[ucount] = buf[k];
			ucount++;
		}
	}
	var rest = [0; 512];
	let rem = g.n - limit;
	for k in rem { rest[k] = g.res[limit + k]; }
	gold_clear(g);
	for k in ucount { gold_push(g, ubuf[k]); }
	for k in rem { gold_push(g, rest[k]); }
	out.i = ucount;
	out.s.clear();
	format(out.s, "sorted unique prefix");
	out
}
@end
