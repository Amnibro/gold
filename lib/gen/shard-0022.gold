				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	let min_v = g.res[0];
	let max_v = g.res[g.n - 1];
	gold_cache_put(g, 1, min_v);
	gold_cache_put(g, 2, max_v);
	g.steps += g.n * g.n;
	out.i = max_v - min_v;
	out.s.clear();
	format(out.s, "sorted with cache range: ", out.i);
	out
}
