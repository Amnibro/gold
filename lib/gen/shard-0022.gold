@entry e56fa72aca79fb83
kind: step
verb: fold
noun: sequence
modifier: with_cache
context: math
phrase: fold math sequence with cache {len}
phrase: compute folded sequence with cache {len}
slot: len int
test: input=3 len=4
expect: => i=63 r=0.0 ok=true s="folded sequence cached" errors=0 n=4 res=[7,15,31,63] cache=4 hits=0
test: input=5 len=3
expect: => i=47 r=0.0 ok=true s="folded sequence cached" errors=0 n=3 res=[11,23,47] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${len};
	if limit <= 0 { gold_fail(g, "empty sequence length"); out.ok = false; return out; }
	var acc = out.i;
	var i = 1;
	while i <= limit {
		let cached, ok = gold_cache_get(g, acc);
		if ok {
			acc = cached;
		} else {
			let next_val = acc * 2 + 1;
			gold_cache_put(g, acc, next_val);
			acc = next_val;
		}
		gold_push(g, acc);
		i++;
	}
	out.i = acc;
	out.s.clear();
	format(out.s, "folded sequence cached");
	out
}
@end
@entry 446ca1671165d908
kind: step
verb: return
noun: odds
modifier: pairwise
context: math
phrase: return pairwise odd math products
phrase: yield pairwise products of odd math values
test: list=1,3,5,7,9,11
expect: => i=137 r=0.0 ok=true s="returned odds pairwise" errors=0 n=3 res=[3,35,99] cache=0 hits=0
test: list=2,3,4,5,6,7
expect: => i=15 r=0.0 ok=true s="returned odds pairwise" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_count = 0;
	var odds = [0; 512];
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[odd_count] = g.res[k];
			odd_count++;
		}
	}
	gold_clear(g);
	var pairs = odd_count / 2;
	var sum = 0;
	for p in pairs {
		let prod = odds[p * 2] * odds[p * 2 + 1];
		gold_push(g, prod);
		sum += prod;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "returned odds pairwise");
	out
}
@end
