expect: => i=2 r=0.0 ok=true s="pairwise sorted head swaps: 2" errors=0 n=5 res=[3,9,1,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let bound = if limit < g.n { limit } else { g.n };
	var swaps = 0;
	var i = 0;
	while i + 1 < bound {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += bound;
	out.i = swaps;
	out.s.clear();
	format(out.s, "pairwise sorted head swaps: ", swaps);
	out
}
@end
