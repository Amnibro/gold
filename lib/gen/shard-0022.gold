fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient search hits for pairwise trace");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		let ad = if diff < 0 { -diff } else { diff };
		let mapped = ${f}(ad);
		total += mapped;
		i++;
	}
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "pairwise trace total: ", total);
	out
}
