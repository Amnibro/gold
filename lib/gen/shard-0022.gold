expect: => i=4 r=0.0 ok=true s="merged two smallest: 4" errors=0 n=3 res=[4,5,9] cache=0 hits=0
test: list=20,10,40,15
expect: => i=25 r=0.0 ok=true s="merged two smallest: 25" errors=0 n=3 res=[25,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		for i in g.n {
			var min_idx = i;
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[min_idx] { min_idx = j; }
			}
			if min_idx != i {
				let tmp = g.res[i];
				g.res[i] = g.res[min_idx];
				g.res[min_idx] = tmp;
			}
		}
		let sum = g.res[0] + g.res[1];
		g.res[0] = sum;
		for i in 1..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
		out.i = sum;
		out.s.clear();
		format(out.s, "merged two smallest: ", sum);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items");
	}
	g.steps += g.n;
	out
}
@end
