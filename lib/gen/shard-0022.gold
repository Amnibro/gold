fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = -1;
	for k in g.n {
		if g.res[k] == t {
			found = k;
			break;
		}
	}
	g.steps += (if found >= 0 { found + 1 } else { g.n });
	gold_push(g, found);
	out.i = found;
	out.s.clear();
	format(out.s, "scanned target index: ", out.i);
	out
}
@end
@entry 438f83865f91ced5
kind: step
verb: scale
noun: sequence
modifier: at_most
context: loop
phrase: scale loop sequence values at most cap {cap} by factor {factor}
phrase: multiply loop sequence elements bounded at most by {cap} with {factor}
slot: factor int
slot: cap int
test: list=10,25,50 factor=2 cap=40
expect: => i=2 r=0.0 ok=true s="scaled elements clamped: 2" errors=0 n=3 res=[20,40,40] cache=0 hits=0
test: list=5,8,12 factor=3 cap=20
expect: => i=2 r=0.0 ok=true s="scaled elements clamped: 2" errors=0 n=3 res=[15,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	let c = ${cap};
	var clamped = 0;
	for k in g.n {
		var val = g.res[k] * fac;
		if val > c {
			val = c;
			clamped++;
		}
		g.res[k] = val;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "scaled elements clamped: ", out.i);
	out
}
@end
@entry b33489b013b48e68
kind: step
verb: keep
noun: history
modifier: in_reverse
context: loop
phrase: keep history in reverse loop order count {count}
phrase: retain recent loop history items in reverse up to {count}
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="history reversed kept: 3" errors=0 n=3 res=[5,4,3] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="history reversed kept: 2" errors=0 n=2 res=[40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${count};
	if cnt > g.n { cnt = g.n; }
	if cnt <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "history reversed kept: 0");
		return out;
	}
	var i = 0;
	var start = g.n - cnt;
	while i < cnt / 2 {
		let a = start + i;
		let b = g.n - 1 - i;
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		i++;
	}
	for k in cnt {
		g.res[k] = g.res[start + k];
	}
	g.n = cnt;
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "history reversed kept: ", out.i);
	out
}
@end
