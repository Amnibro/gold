@entry 79328445c8813695
kind: step
verb: retry
noun: tally
modifier: in_place
context: sort
phrase: retry inversion tally sorting in place up to {max_tries}
phrase: repeat in place sorting pass until tally drops with limit {max_tries}
slot: max_tries int
test: list=9,7,5,3,1 max_tries=3
expect: => i=1 r=0.0 ok=true s="remaining inversion tally: 1" errors=0 n=5 res=[3,1,5,7,9] cache=0 hits=0
test: list=4,2,3,1 max_tries=1
expect: => i=2 r=0.0 ok=true s="remaining inversion tally: 2" errors=0 n=4 res=[2,3,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tries = ${max_tries};
	if tries < 1 { tries = 1; }
	var remaining_inv = 0;
	for t in tries {
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
	}
	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[a] > g.res[b] { remaining_inv++; }
		}
	}
	g.steps += tries * g.n;
	out.i = remaining_inv;
	out.s.clear();
	format(out.s, "remaining inversion tally: ", remaining_inv);
	out
}
@end
