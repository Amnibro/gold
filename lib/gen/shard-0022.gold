@entry 45b3756060d7c3e0
kind: fn
verb: keep
noun: runs
modifier: in_reverse
context: list
phrase: keep runs in reverse order length {min_len}
phrase: extract reverse runs exceeding length {min_len}
slot: min_len int
test: arg=112223,44445 min_len=2
expect: 5
expect: 4
test: arg=12345,999 min_len=3
expect: 0
expect: 3
code:
fn ${ID}(n int) int {
	let ml = ${min_len};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return if ml <= 1 { 1 } else { 0 }; }
	var cur_run = 1;
	var total_runs = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev {
			cur_run++;
		} else {
			if cur_run >= ml {
				total_runs += cur_run;
			}
			cur_run = 1;
			prev = cur;
		}
		x /= 10;
	}
	if cur_run >= ml {
		total_runs += cur_run;
	}
	total_runs
}
@end
