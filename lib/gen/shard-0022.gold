		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
		i++;
	}
	gold_cache_put(g, max_val, max_idx);
	var rotated int[512] = [0; 512];
	var j = 0;
	while j < g.n {
		rotated[j] = g.res[(max_idx + j) % g.n];
		j++;
	}
	var k = 0;
	while k < g.n {
		g.res[k] = rotated[k];
		k++;
	}
	g.steps += g.n * 2;
	out.i = max_val;
	out.s.clear();
	format(out.s, "rotated maximum delay to head: ", max_val);
	out
}
@end
