expect: => i=4 r=0.0 ok=true s="normalized runs sequence items: 4" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var rlen = 1;
		while i + 1 < g.n && g.res[i + 1] == x {
			rlen++;
			i++;
		}
		if rlen > 1 {
			var k = i - rlen + 1;
			while k <= i {
				g.res[k] = g.res[k] * sc;
				k++;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized runs sequence items: ", g.n);
	out
}
@end
