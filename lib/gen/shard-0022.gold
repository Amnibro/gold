@entry 1df384bfdbcf1e6d
kind: step
verb: sort
noun: step
modifier: sorted
context: cache
phrase: sort pairwise step differences in ascending order
phrase: order consecutive step deltas sorted
test: list=2,10,13,25
expect: => i=3 r=0.0 ok=true s="sorted 3 step deltas" errors=0 n=3 res=[3,8,12] cache=3 hits=0
test: list=5,20,22,40
expect: => i=3 r=0.0 ok=true s="sorted 3 step deltas" errors=0 n=3 res=[2,15,18] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let deltas_n = if g.n > 1 { g.n - 1 } else { 0 };
	var deltas int[256] = [0; 256];
	for i in deltas_n {
		deltas[i] = g.res[i + 1] - g.res[i];
	}
	// Sort deltas ascending
	var i = 0;
	while i < deltas_n {
		var j = i + 1;
		while j < deltas_n {
			if deltas[j] < deltas[i] {
				let tmp = deltas[i];
				deltas[i] = deltas[j];
				deltas[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i, deltas[i]);
		i++;
	}
	gold_clear(g);
	for k in deltas_n { gold_push(g, deltas[k]); }
	g.steps += deltas_n * deltas_n;
	out.i = deltas_n;
	out.s.clear();
	format(out.s, "sorted ", deltas_n, " step deltas");
