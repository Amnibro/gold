fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_dups};
	if limit <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = 0;
		var j = 0;
		while j < kn {
			if kept[j] == x { seen++; }
			j++;
		}
		if seen < limit {
			kept[kn] = x;
			kn++;
		}
		i++;
	}
	var k = 0;
	while k < kn {
		g.res[k] = kept[k];
		k++;
	}
	g.n = kn;
	g.steps += g.n + kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "capped duplicate attempts: ", kn);
	out
}
@end
