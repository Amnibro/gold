test: list=15,75,90,25 depth=1 limit_val=70
expect: => i=4 r=0.0 ok=true s="filter limit nested: 4" errors=0 n=4 res=[15,75,90,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let lim = ${limit_val};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if i < d {
			if g.res[i] <= lim { kept[kn] = g.res[i]; kn++; }
		} else {
			kept[kn] = g.res[i]; kn++;
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "filter limit nested: ", kn);
	out
}
@end
