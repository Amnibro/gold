fn ${ID}(g Gold&, v Val) Val {
	let b = ${base};
	var out = v;
	out.s.clear();
	var min_val = 999999;
	for i in g.n {
		let val = g.res[i];
		if val > b && val < min_val {
			min_val = val;
		}
	}
	if min_val == 999999 { min_val = 0; }
	format(out.s, "deduped min: ", min_val);
	out.i = min_val;
	g.steps += g.n;
	out
}
@end
