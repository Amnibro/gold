fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let count = if k > g.n { g.n } else { k };
	let start = g.n - count;
	var i = start;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed tail count: ", count);
	out
}
@end
