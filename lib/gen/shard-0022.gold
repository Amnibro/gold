fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var above = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > th {
			g.res[i] = 1;
			above++;
		} else if x < th {
			g.res[i] = -1;
		} else {
			g.res[i] = 0;
		}
		i++;
	}
	g.steps += g.n;
	out.i = above;
	out.s.clear();
	format(out.s, "numbers strictly above threshold: ", above);
	out
}
@end
@entry df4c0d80643d8043
kind: step
verb: run
noun: sequence
modifier: recursively
context: transform
slot: rounds int
phrase: run recursive sequence reduction across {rounds} passes
phrase: apply recursive pairwise sum reduction over {rounds} rounds
test: list=1,2,3,4,5 rounds=2
expect: => i=2 r=0.0 ok=true s="completed recursive passes: 2" errors=0 n=3 res=[8,12,16] cache=0 hits=0
test: list=10,20,30 rounds=1
expect: => i=1 r=0.0 ok=true s="completed recursive passes: 1" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if r <= 0 {
		gold_fail(g, "rounds must be positive");
		out.ok = false;
		return out;
	}
	var pass = 0;
	while pass < r && g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			g.res[i] = g.res[i] + g.res[i + 1];
			i++;
		}
		g.n -= 1;
		pass++;
	}
	g.steps += pass * g.n;
	out.i = pass;
	out.s.clear();
	format(out.s, "completed recursive passes: ", pass);
	out
}
@end
@entry a607012504cf3f2a
kind: step
verb: cache
noun: results
modifier: sorted
context: transform
phrase: cache sorted results order into key storage
phrase: sort elements storing ranked results into cache
test: list=9,3,7,1,5
expect: => i=5 r=0.0 ok=true s="cached sorted count: 5" errors=0 n=5 res=[1,3,5,7,9] cache=5 hits=0
test: list=20,10,30
expect: => i=3 r=0.0 ok=true s="cached sorted count: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached sorted count: ", g.n);
	out
}
@end
