@entry 2e237441ef9715df
kind: step
verb: scale
noun: prefix
modifier: unique
context: stats
phrase: scale unique prefix observations by {mult}
phrase: amplify distinct prefix values by {mult}
slot: mult int
test: list=2,3,4 mult=5
expect: => i=3 r=0.0 ok=true s="scaled 3 unique prefix items" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=10,20 mult=3
expect: => i=2 r=0.0 ok=true s="scaled 2 unique prefix items" errors=0 n=2 res=[30,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var p_len = 0;
	while p_len < g.n {
		var dup = false;
		for j in p_len {
			if g.res[j] == g.res[p_len] { dup = true; }
		}
		if dup { break; }
		g.res[p_len] *= m;
		p_len++;
	}
	g.steps += p_len;
	out.i = p_len;
	out.s.clear();
	format(out.s, "scaled ", p_len, " unique prefix items");
	out
}
@end
@entry 76254239a49b94e1
kind: step
verb: swap
noun: errors
modifier: until
context: stats
phrase: swap outliers exceeding {bound} into error position
phrase: reposition values beyond {bound} while tracking errors
slot: bound int
test: list=5,50,15 bound=30
expect: => i=1 r=0.0 ok=true s="swapped 1 error outliers" errors=1 n=3 res=[5,15,50] cache=0 hits=0
test: list=10,20,100 bound=50
expect: => i=1 r=0.0 ok=true s="swapped 1 error outliers" errors=1 n=3 res=[10,20,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var swapped = 0;
	for i in g.n {
		if g.res[i] > b {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1];
			g.res[g.n - 1] = tmp;
			g.errors++;
			swapped++;
			break;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " error outliers");
	out
}
@end
