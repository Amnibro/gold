@entry d05dd5a5371c466d
kind: step
verb: swap
noun: series
modifier: every_other
context: stats
phrase: swap adjacent pairs throughout series
phrase: exchange every other observation in series
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="swapped 2 pairs" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="swapped 2 pairs" errors=0 n=5 res=[20,10,40,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var count = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		i += 2;
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " pairs");
	out
}
@end
