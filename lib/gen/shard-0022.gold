@entry 5a895e3baffc6b9b
kind: step
verb: dedupe
noun: value
modifier: between
context: search
phrase: dedupe search result values between bounds {lo} upper {hi}
phrase: prune duplicate entries between score limits {lo} maximum {hi}
slot: lo int
slot: hi int
test: list=5,12,5,18,12,25,12 lo=10 hi=20
expect: => i=5 r=0.0 ok=true s="dedupe between: 5" errors=0 n=5 res=[5,12,5,18,25] cache=0 hits=0
test: list=30,45,30,60,45,45 lo=25 hi=50
expect: => i=3 r=0.0 ok=true s="dedupe between: 3" errors=0 n=3 res=[30,45,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var seen = [0; 512];
	var sn = 0;
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h {
			var found = false;
			for j in sn { if seen[j] == x { found = true; break; } }
			if !found { seen[sn] = x; sn++; kept[kn] = x; kn++; }
		} else {
			kept[kn] = x; kn++;
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "dedupe between: ", kn);
	out
}
@end
