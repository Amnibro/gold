@entry f9d66400fa539733
kind: step
verb: sort
noun: list
modifier: unique
context: retry
phrase: sort list unique retry delays ascending
phrase: sort distinct retry intervals into unique order
test: list=40,10,30,10,20,40
expect: => i=4 r=0.0 ok=true s="sorted unique retry delays: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=50,25,10,25,5
expect: => i=4 r=0.0 ok=true s="sorted unique retry delays: 4" errors=0 n=4 res=[5,10,25,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var u int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < un {
			if u[j] == x { exists = true; break; }
			j++;
		}
		if !exists {
			u[un] = x;
			un++;
		}
		i++;
	}
	var a = 0;
	while a < un {
		var b = a + 1;
		while b < un {
			if u[a] > u[b] {
				let tmp = u[a];
				u[a] = u[b];
				u[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var k = 0;
	while k < un {
		g.res[k] = u[k];
		k++;
	}
	g.n = un;
	g.steps += g.n + un * un;
	out.i = un;
	out.s.clear();
	format(out.s, "sorted unique retry delays: ", un);
	out
}
@end
