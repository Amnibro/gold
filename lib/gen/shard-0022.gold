code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var gaps = [0; 512];
	let count = g.n - 1;
	for i in count {
		var d = g.res[i + 1] - g.res[i];
		if d < 0 { d = -d; }
		gaps[i] = d;
	}
	g.n = 0;
	for i in count { gold_push(g, gaps[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "gaps count: ", count);
	out
}
@end
