fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var m = g.res[0];
	for i in g.n {
		if g.res[i] < m { m = g.res[i]; }
	}
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "scanned minimum: ", m);
	out
}
