expect: => i=0 r=0.0 ok=true s="inserted value at rank: 0" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = out.i;
	if g.n >= 512 {
		gold_fail(g, "results full for sorted value insert");
		out.ok = false;
		return out;
	}
	var pos = g.n;
	for k in g.n {
		if g.res[k] > val { pos = k; break; }
	}
	var i = g.n;
	while i > pos {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[pos] = val;
	g.n++;
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "inserted value at rank: ", pos);
	out
}
@end
