code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	if rev < 2 { return false; }
	var d = 2;
	while d * d <= rev {
		if rev % d == 0 { return false; }
		d++;
	}
	true
}
