expect: => i=4 r=0.0 ok=true s="collect words unique: 4" errors=0 n=4 res=[15,8,22,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var uniq = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in nu {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen { uniq[nu] = x; nu++; }
	}
	g.n = 0;
	for i in nu { gold_push(g, uniq[i]); }
	out.i = nu;
	out.s.clear();
	format(out.s, "collect words unique: ", nu);
	out
}
@end
