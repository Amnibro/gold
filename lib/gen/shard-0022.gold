@entry 6484adcfd6b2b401
kind: step
verb: filter
noun: streak
modifier: none
context: search
phrase: filter long consecutive streaks of search scores exceeding {streak_len}
phrase: remove run streaks in candidate list beyond {streak_len}
slot: streak_len int
test: list=4,4,4,5,6,6,6,6,7 streak_len=2
expect: => i=2 r=0.0 ok=true s="filter streak: 2" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=9,9,9,9,1,2,2 streak_len=3
expect: => i=3 r=0.0 ok=true s="filter streak: 3" errors=0 n=3 res=[1,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${streak_len};
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len <= max_run {
			for k in run_len { kept[kn] = g.res[i]; kn++; }
		}
		i = j;
	}
	g.n = 0;
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "filter streak: ", kn);
	out
}
@end
