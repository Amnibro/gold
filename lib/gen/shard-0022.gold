test: list=10,15,25 factor=2
expect: => i=30 r=0.0 ok=true s="measured steps: 30" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: list=3,8,12,20 factor=3
expect: => i=51 r=0.0 ok=true s="measured steps: 51" errors=0 n=4 res=[3,8,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "measured steps: 0");
		return out;
	}
	var sum_diff = 0;
	for i in (g.n - 1) {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		sum_diff += diff * f;
	}
	out.i = sum_diff;
	out.s.clear();
	format(out.s, "measured steps: ", sum_diff);
	out
}
@end
