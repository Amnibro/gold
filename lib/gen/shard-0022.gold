noun: maximum
modifier: any
context: search
phrase: locate maximum candidate score exceeding threshold {threshold}
phrase: aggregate maximum search result over cut {threshold}
slot: threshold int
test: list=15,82,45,67,23 threshold=50
expect: => i=82 r=0.0 ok=true s="maximum any: 82" errors=0 n=6 res=[15,82,45,67,23,82] cache=0 hits=0
test: list=10,20,30,25 threshold=40
expect: => i=0 r=0.0 ok=true s="maximum any: 0" errors=0 n=4 res=[10,20,30,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var max_val = -1000000;
	var found = false;
	for i in g.n {
		if g.res[i] > th {
			if g.res[i] > max_val { max_val = g.res[i]; }
			found = true;
		}
	}
	if found {
		gold_push(g, max_val);
		out.i = max_val;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "maximum any: ", out.i);
	out
}
@end
