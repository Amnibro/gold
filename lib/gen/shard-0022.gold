fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp = [0; 512];
	var nn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in nn {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[nn] = x;
			nn++;
		}
	}
	for i in nn { g.res[i] = temp[i]; }
	g.n = nn;
	g.steps += g.n;
	out.i = nn;
	out.s.clear();
	format(out.s, "unique search loop hits: ", nn);
	out
}
