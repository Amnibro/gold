fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_offset};
	if cap < 0 {
		gold_fail(g, "shift cap must be non-negative");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		let delta = if i < cap { i } else { cap };
		g.res[i] += delta;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted elements count: ", g.n);
	out
}
@end
