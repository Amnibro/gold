expect: => i=3 r=0.0 ok=true s="kept last retry delays: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=5,15,25,35,45,55 count=4
expect: => i=4 r=0.0 ok=true s="kept last retry delays: 4" errors=0 n=4 res=[25,35,45,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	if c >= g.n {
		out.i = g.n;
		return out;
	}
	let start = g.n - c;
	var i = 0;
	while i < c {
		g.res[i] = g.res[start + i];
		i++;
	}
	g.n = c;
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "kept last retry delays: ", c);
	out
}
@end
