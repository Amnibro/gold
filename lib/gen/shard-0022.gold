kind: step
verb: scale
noun: total
modifier: while
context: sort
slot: cap int
slot: factor int
phrase: scale total while under cap {cap} by factor {factor}
phrase: multiply accumulated sorted elements under {cap} by {factor}
test: list=5,1,3,8,2 cap=6 factor=3
expect: => i=33 r=0.0 ok=true s="scaled total: 33" errors=0 n=5 res=[1,2,3,5,8] cache=0 hits=0
test: list=10,4,2 cap=12 factor=2
expect: => i=32 r=0.0 ok=true s="scaled total: 32" errors=0 n=3 res=[2,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	var idx = 0;
	while idx < g.n && g.res[idx] <= limit {
		total += g.res[idx];
		idx++;
	}
	total *= mul;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled total: ", total);
	out
}
@end
