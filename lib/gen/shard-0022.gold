			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bark");
	out
}
