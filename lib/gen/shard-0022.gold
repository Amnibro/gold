fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var half = g.n / 2;
	if half == 0 && g.n > 0 { half = 1; }
	var acc = 0;
	for i in half {
		acc += g.res[i] * f;
	}
	out.i = acc;
	out.s.clear();
	format(out.s, "fold first: ", acc);
	out
}
