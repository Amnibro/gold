fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let pos = if x < 0 { -x } else { x };
		g.res[i] = pos % 10;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected safe digits: ", g.n);
	out
}
