fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let mid_idx = g.n / 2;
	let mid_val = g.res[mid_idx];
	for i in g.n {
		var diff = g.res[i] - mid_val;
		if diff < 0 { diff = -diff; }
		g.res[i] = diff;
	}
	g.steps += g.n;
	out.i = mid_val;
	out.s.clear();
	format(out.s, "middle reference: ", mid_val);
	out
}
