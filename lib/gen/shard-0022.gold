code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${a} <= 0.0 || ${h} <= 0.0 || ${r} <= 0.0 {
		gold_fail(g, "invalid ridge dimensions");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	gold_dnews(g, "ridge", "", o);
	o.append(" tube -");
	gold_fnum(o, ${a});
	o.append(",");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(" ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" ");
	gold_fnum(o, ${a});
	o.append(",");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" ~");
	gold_fnum(o, ${r} * 0.5);
	o.append(" m:matte ");
	gold_hex(o, 122, 106, 85);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ridge");
	out
}
@end
