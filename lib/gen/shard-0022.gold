verb: reverse
noun: prefix
modifier: while
context: sort
slot: cap int
phrase: reverse prefix while elements under {cap}
phrase: invert sorted leading items while below {cap}
test: list=8,1,4,3,9 cap=5
expect: => i=3 r=0.0 ok=true s="reversed prefix: 3" errors=0 n=5 res=[4,3,1,8,9] cache=0 hits=0
test: list=20,10,30,5 cap=15
expect: => i=2 r=0.0 ok=true s="reversed prefix: 2" errors=0 n=4 res=[10,5,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	while count < g.n && g.res[count] <= limit {
		count++;
	}
	var left = 0;
	var right = count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed prefix: ", count);
	out
}
@end
