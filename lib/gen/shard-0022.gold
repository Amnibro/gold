expect: => i=1 r=0.0 ok=true s="interval gap violations: 1" errors=0 n=4 res=[10,20,15,30] cache=0 hits=0
test: list=50,40,30,20 retries=1
expect: => i=3 r=0.0 ok=false s="interval gap violations: 3" errors=1 n=4 res=[50,40,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var violations = 0;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap <= 0 {
			violations++;
		}
		i++;
	}
	if violations > max_r {
		gold_fail(g, "error intervals inverted");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = violations;
	out.s.clear();
	format(out.s, "interval gap violations: ", violations);
	out
}
@end
