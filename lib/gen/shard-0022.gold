@entry 33f359effca83205
kind: step
verb: scan
noun: streak
modifier: while
context: sort
slot: cap int
phrase: scan streak while below cap {cap}
phrase: track consecutive run length while under limit {cap}
test: list=1,2,3,8,9 cap=5
expect: => i=3 r=0.0 ok=true s="streak: 3" errors=0 n=5 res=[1,2,3,8,9] cache=0 hits=0
test: list=4,2,3,5,10,11,12,13 cap=3
expect: => i=3 r=0.0 ok=true s="streak: 3" errors=0 n=8 res=[2,3,4,5,10,11,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_streak = 0;
	var cur_streak = 1;
	var k = 1;
	while k < g.n {
		if g.res[k] == g.res[k - 1] + 1 {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
		}
		k++;
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	if max_streak > limit { max_streak = limit; }
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "streak: ", max_streak);
	out
}
@end
@entry b55bc89d8cb5232b
kind: step
verb: select
noun: history
modifier: with_retry
context: sort
slot: fallback int
phrase: select history with_retry fallback {fallback}
phrase: filter sorted items against historical running average with fallback {fallback}
test: list=1,3,2,8,4 fallback=0
expect: => i=5 r=0.0 ok=true s="selected history: 5" errors=0 n=5 res=[1,2,3,4,8] cache=0 hits=0
test: list=5,5,5 fallback=99
expect: => i=1 r=0.0 ok=true s="selected history: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var running_sum = 0;
	for k in g.n {
		let x = g.res[k];
		if k == 0 || x * k > running_sum {
			g.res[kept] = x;
			kept++;
		}
		running_sum += x;
	}
	if kept == 0 {
		g.res[0] = fb;
		kept = 1;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected history: ", kept);
	out
}
@end
@entry 8039791ea1342e45
kind: step
verb: merge
noun: checkpoint
modifier: nested
context: sort
slot: chk int
phrase: merge checkpoint nested value {chk} into sorted list
phrase: insert nested checkpoint value {chk} into ordered results
test: list=10,30,50,20 chk=25
expect: => i=25 r=0.0 ok=true s="merged checkpoint: 25" errors=0 n=5 res=[10,20,25,30,50] cache=0 hits=0
test: list=5,15,3 chk=1
expect: => i=1 r=0.0 ok=true s="merged checkpoint: 1" errors=0 n=4 res=[1,3,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = ${chk};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	gold_push(g, val);
	var k = g.n - 1;
	while k > 0 && g.res[k] < g.res[k - 1] {
		let tmp = g.res[k];
		g.res[k] = g.res[k - 1];
		g.res[k - 1] = tmp;
		k--;
	}
	g.steps += g.n;
	out.i = val;
	out.s.clear();
	format(out.s, "merged checkpoint: ", val);
	out
}
@end
