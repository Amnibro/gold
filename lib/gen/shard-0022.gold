code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no search runs");
		return out;
	}
	var cur_run = 1;
	var max_run = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
		i++;
	}
	gold_push(g, max_run);
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "max sorted run: ", max_run);
	out
}
@end
@entry 5d632cb7c916c11e
kind: step
verb: sort
noun: average
modifier: first
context: search
phrase: sort search average first position in results
phrase: place search average first ordering remaining candidates
test: list=30,10,20
expect: => i=20 r=0.0 ok=true s="search average first: 20" errors=0 n=4 res=[20,10,20,30] cache=0 hits=0
test: list=4,8,12,16
expect: => i=10 r=0.0 ok=true s="search average first: 10" errors=0 n=5 res=[10,4,8,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty search list");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n < 512 {
		var k = g.n;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = avg;
		g.n++;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "search average first: ", avg);
	out
}
@end
