kind: step
verb: find
noun: suffix
modifier: unique
context: core
phrase: find suffix unique distinct elements length {k}
phrase: count suffix unique items in tail size {k}
slot: k int
test: list=1,2,3,3,4,4 k=4
expect: => i=2 r=0.0 ok=true s="suffix unique: 2" errors=0 n=6 res=[1,2,3,3,4,4] cache=0 hits=0
test: list=5,6,7,8,9 k=3
expect: => i=3 r=0.0 ok=true s="suffix unique: 3" errors=0 n=5 res=[5,6,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k <= 0 { out.i = 0; return out; }
	let start = g.n - k;
	var uvals = [0; 512];
	var ucnt = 0;
	for i in k {
		let x = g.res[start + i];
		var seen = false;
		for j in ucnt {
			if uvals[j] == x { seen = true; break; }
		}
		if !seen {
			uvals[ucnt] = x;
			ucnt++;
		}
	}
	out.i = ucnt;
	out.s.clear();
	format(out.s, "suffix unique: ", ucnt);
	out
}
@end
@entry d8e3f3e0fc1f94df
kind: step
verb: limit
noun: duplicates
modifier: every_other
context: core
phrase: limit duplicates every_other alternating frequency to {cap}
phrase: cap duplicates every_other repeating entries by {cap}
slot: cap int
test: list=2,9,2,8,2,7 cap=2
expect: => i=5 r=0.0 ok=true s="capped size: 5" errors=0 n=5 res=[2,9,2,8,7] cache=0 hits=0
test: list=5,1,5,2,5,3,5 cap=1
expect: => i=4 r=0.0 ok=true s="capped size: 4" errors=0 n=4 res=[5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var vals = [0; 512];
	var counts = [0; 512];
	var ucnt = 0;
	var new_res = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var vidx = -1;
		for j in ucnt {
			if vals[j] == x { vidx = j; break; }
		}
		if vidx < 0 {
			vals[ucnt] = x;
			counts[ucnt] = 1;
			vidx = ucnt;
			ucnt++;
		} else {
			counts[vidx]++;
		}
		if counts[vidx] <= cap {
			new_res[new_n] = x;
			new_n++;
		}
		if i + 1 < g.n {
			new_res[new_n] = g.res[i + 1];
			new_n++;
		}
		i += 2;
	}
	g.n = 0;
	for j in new_n { gold_push(g, new_res[j]); }
	out.i = new_n;
	out.s.clear();
	format(out.s, "capped size: ", new_n);
	out
}
@end
