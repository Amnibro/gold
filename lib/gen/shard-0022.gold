@entry b194e77de302052c
kind: step
verb: sort
noun: pairs
modifier: between
context: cache
phrase: sort pairs between indices {lo} to {hi}
phrase: order subrange pairs from {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,50,20,40,30 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted subrange count=3" errors=0 n=5 res=[10,20,40,50,30] cache=3 hits=0
test: list=80,30,60,10,70 lo=0 hi=4
expect: => i=5 r=0.0 ok=true s="sorted subrange count=5" errors=0 n=5 res=[10,30,60,70,80] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = if ${hi} < g.n { ${hi} } else { g.n - 1 };
	var i = low;
	while i <= high {
		var j = i + 1;
		while j <= high {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i, g.res[i]);
		i++;
	}
	g.steps += (high - low + 1) * (high - low + 1);
	out.i = high - low + 1;
	out.s.clear();
	format(out.s, "sorted subrange count=", high - low + 1);
	out
}
@end
