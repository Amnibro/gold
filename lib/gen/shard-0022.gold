code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var c = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		else {
			while x > 0 { d++; x /= 10; }
		}
		if d >= th { c++; }
	}
	g.steps += g.n;
	out.i = c;
	out.s.clear();
	format(out.s, "count digits at least: ", c);
	out
}
@end
