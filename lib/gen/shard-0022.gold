fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let s = ${stride};
	if s <= 0 { return out; }
	var cur = if g.n > 0 { g.res[0] } else { 0 };
	g.n = 0;
	while cur <= b && g.n < 512 {
		gold_push(g, cur);
		cur += s;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "run sequence up_to: ", g.n);
	out
}
