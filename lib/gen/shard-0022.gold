expect: => i=3 r=0.0 ok=true s="streaks safely paired: 3" errors=0 n=6 res=[1,2,2,1,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var vals = [0, 0, 0, 0, 0, 0, 0, 0];
	var lens = [0, 0, 0, 0, 0, 0, 0, 0];
	var sc = 0;
	var i = 0;
	while i < g.n && sc < 8 {
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == g.res[i] {
			run_len++;
		}
		vals[sc] = g.res[i];
		lens[sc] = if run_len > lim { lim } else { run_len };
		sc++;
		i += run_len;
	}
	g.n = 0;
	for k in sc {
		gold_push(g, vals[k]);
		gold_push(g, lens[k]);
	}
	g.steps += g.n;
	out.i = sc;
	out.s.clear();
	format(out.s, "streaks safely paired: ", out.i);
	out
}
@end
