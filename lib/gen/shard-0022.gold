kind: step
verb: retry
noun: step
modifier: between
context: sort
phrase: retry insertion sort step between {lo} and {hi}
phrase: sort subrange items located between {lo} and {hi}
slot: lo int
slot: hi int
test: list=10,9,8,7,6 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted subrange span: 3" errors=0 n=5 res=[10,7,8,9,6] cache=0 hits=0
test: list=5,1,4,2,3 lo=0 hi=2
expect: => i=3 r=0.0 ok=true s="sorted subrange span: 3" errors=0 n=5 res=[1,4,5,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${lo};
	var h = ${hi};
	if l < 0 { l = 0; }
	if h >= g.n { h = g.n - 1; }
	if l >= h { return out; }
	for i in l..(h + 1) {
		for j in (i + 1)..(h + 1) {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += (h - l + 1) * 2;
	out.i = h - l + 1;
	out.s.clear();
	format(out.s, "sorted subrange span: ", out.i);
	out
}
@end
@entry 9711e9fa1556ad9a
kind: step
verb: map
noun: tail
modifier: unique
context: sort
phrase: map sorted unique elements from last {k} items
phrase: extract distinct values from tail {k} in sorted order
slot: k int
test: list=1,8,4,8,2,4 k=4
expect: => i=3 r=0.0 ok=true s="tail unique items: 3" errors=0 n=3 res=[2,4,8] cache=0 hits=0
test: list=10,5,5,5 k=3
expect: => i=1 r=0.0 ok=true s="tail unique items: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${k};
	if lim > g.n { lim = g.n; }
	if lim <= 0 { g.n = 0; return out; }
	let offset = g.n - lim;
	for i in lim {
		g.res[i] = g.res[offset + i];
	}
	g.n = lim;
	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[a] > g.res[b] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
		}
	}
	var u = 0;
	for i in g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			g.res[u] = g.res[i];
			u++;
		}
	}
	g.n = u;
	g.steps += g.n * 2;
	out.i = u;
	out.s.clear();
	format(out.s, "tail unique items: ", u);
	out
}
@end
