@entry 3fe517a992f36402
kind: step
verb: keep
noun: condition
modifier: unique
context: loop
phrase: keep unique elements satisfying minimum threshold {threshold}
phrase: filter distinct items in loop strictly above threshold {threshold}
slot: threshold int
test: list=5,12,5,15,20,12 threshold=10
expect: => i=3 r=0.0 ok=true s="kept unique: 3" errors=0 n=3 res=[12,15,20] cache=0 hits=0
test: list=2,8,8,14 threshold=5
expect: => i=2 r=0.0 ok=true s="kept unique: 2" errors=0 n=2 res=[8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x > th {
			var exists = false;
			for j in kn {
				if kept[j] == x {
					exists = true;
					break;
				}
			}
			if !exists {
				kept[kn] = x;
				kn++;
			}
		}
	}
	g.n = 0;
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "kept unique: ", kn);
	out
}
@end
