	var len = 0;
	while x > 0 && len < 10 {
		digits[len] = x % 10;
		x /= 10;
		len++;
	}
	if len < 3 { return 0; }
	var turns = 0;
	var i = 1;
	while i < len - 1 {
		let a = digits[i - 1];
		let b = digits[i];
		let c = digits[i + 1];
		if (b > a && b > c) || (b < a && b < c) {
			turns++;
		}
		i++;
	}
	turns * f
}
@end
