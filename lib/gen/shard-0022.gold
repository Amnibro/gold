fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${b} < 0 || ${b} > 255 { gold_fail(g, "blue channel out of range"); out.ok = false; return out; }
	var o byte[>..] = [];
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no platform to tint"); out.ok = false; return out; }
	o.push(' ');
	gold_hex(o, 60, 120, ${b});
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tint platform cool");
	out
}
@end
