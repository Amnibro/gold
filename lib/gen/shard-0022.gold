fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		let p = g.res[i] + g.res[i + 1];
		g.res[i] = if p > c { c } else { p };
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped pairs: ", out.i);
	out
}
@end
