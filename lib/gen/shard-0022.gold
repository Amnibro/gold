fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < l {
			g.res[i] = l;
			clamped++;
		} else if g.res[i] > h {
			g.res[i] = h;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped list none count: ", clamped);
	out
}
@end
