code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "every other swaps: ", swaps);
	out
}
@end
