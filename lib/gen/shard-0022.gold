	let bs = ${block_size};
	if bs <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "nested block rotation skipped");
		return out;
	}
	var b = 0;
	while b + bs <= g.n {
		let first = g.res[b];
		var j = b;
		while j < b + bs - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[b + bs - 1] = first;
		b += bs;
	}
	g.steps += g.n;
	out.i = b / bs;
	out.s.clear();
	format(out.s, "rotated nested blocks: ", out.i);
	out
}
