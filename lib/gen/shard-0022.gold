test: list=100
expect: => i=1 r=0.0 ok=true s="seeded cache with last value" errors=0 n=1 res=[100] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for cache compare");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	let cached, ok = gold_cache_get(g, 1);
	if ok {
		if cached == last {
			out.i = 1;
			out.s.clear();
			format(out.s, "matched cached last value");
		} else {
			out.i = 0;
			gold_fail(g, "last value mismatch with cache");
		}
	} else {
		gold_cache_put(g, 1, last);
		out.i = 1;
		out.s.clear();
		format(out.s, "seeded cache with last value");
	}
	g.steps += g.n;
	out
}
@end
