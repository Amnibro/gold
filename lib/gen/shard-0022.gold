context: search
phrase: validate search function {f} at most threshold count {cap}
phrase: check evaluated search function {f} results at most {cap}
slot: f fn
slot: cap int
test: list=20,30,40 f=double cap=1
expect: => i=0 r=0.0 ok=true s="function threshold hits: 0" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=60,70,80 f=double cap=1
expect: => i=3 r=0.0 ok=false s="function threshold hits: 3" errors=1 n=3 res=[60,70,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	for k in g.n {
		let evaluated = ${f}(g.res[k]);
		if evaluated > 100 { count++; }
	}
	if count > c {
		gold_fail(g, "evaluated search threshold exceeded cap");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "function threshold hits: ", count);
	out
}
@end
@entry 4bd576ed8e6fe783
kind: step
verb: rank
noun: loop
modifier: recursively
context: search
phrase: rank search loop recursively using branch base {base}
phrase: compute recursive search loop depth with base {base}
slot: base int
test: list=16,64,8 base=2
expect: => i=13 r=0.0 ok=true s="total loop recursion rank: 13" errors=0 n=3 res=[4,6,3] cache=0 hits=0
test: list=27,81,9 base=3
expect: => i=9 r=0.0 ok=true s="total loop recursion rank: 9" errors=0 n=3 res=[3,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	if b <= 1 {
		gold_fail(g, "invalid loop recursive base");
		out.ok = false;
		return out;
	}
	var total_depth = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var depth = 0;
		while x > 1 && depth < 20 {
			x /= b;
			depth++;
		}
		g.res[k] = depth;
		total_depth += depth;
	}
	g.steps += total_depth;
	out.i = total_depth;
	out.s.clear();
	format(out.s, "total loop recursion rank: ", total_depth);
	out
}
@end
