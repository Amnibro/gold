test: text="world" shift=1
expect: => i=5 r=0.0 ok=true s="orldw" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	let len = out.s.len;
	if len > 1 {
		let k = if s < 0 { 0 } else { s % len };
		for step in k {
			let first = out.s[0];
			for i in len - 1 {
				out.s[i] = out.s[i + 1];
			}
			out.s[len - 1] = first;
		}
	}
	g.steps += len;
	out.i = len;
	out
}
@end
