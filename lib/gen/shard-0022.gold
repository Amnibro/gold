@entry 1a6c818139e417c4
kind: step
verb: rotate
noun: steps
modifier: times
context: math
phrase: rotate math sequence steps {k} times
phrase: cycle math steps {k} times
slot: k int
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="rotated steps times" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3,4 k=1
expect: => i=1 r=0.0 ok=true s="rotated steps times" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n <= 1 || shift == 0 { out.s.clear(); format(out.s, "rotated steps unchanged"); return out; }
	var s = (shift % g.n + g.n) % g.n;
	var temp = [0; 512];
	for i in g.n {
		let src_idx = (i - s + g.n) % g.n;
		temp[i] = g.res[src_idx];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += s;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated steps times");
	out
}
@end
