expect: => i=30 r=0.0 ok=true s="retry middle: 30" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		let mid_idx = g.n / 2;
		let mid_val = g.res[mid_idx];
		out.i = mid_val;
		if mid_val > lim {
			var left = 0;
			var right = g.n - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "retry middle: ", out.i);
	out
}
@end
