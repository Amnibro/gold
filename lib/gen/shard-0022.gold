fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${k};
	var m = lim;
	if m > g.n { m = g.n; }
	if m < 0 { m = 0; }
	var i = 0;
	while i < m {
		var j = i + 1;
		while j < m {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted prefix elements: ", m);
	out
}
