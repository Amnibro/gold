kind: step
verb: reverse
noun: series
modifier: first
context: loop
phrase: reverse series prefix containing first elements count {k}
phrase: invert order of initial series items up to count {k}
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=3 r=0.0 ok=true s="reverse first: 3" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3,4 k=2
expect: => i=2 r=0.0 ok=true s="reverse first: 2" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	var left = 0;
	var right = count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reverse first: ", count);
	out
}
@end
