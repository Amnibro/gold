fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let lim = ${limit};
	var sum = 0;
	var reached = false;
	for i in g.n {
		sum += g.res[i];
		if sum >= tgt {
			reached = true;
			break;
		}
		if sum >= lim { break; }
	}
	if !reached {
		gold_fail(g, "target not reached");
		out.ok = false;
	}
	out.i = if reached { 1 } else { 0 };
	out.s.clear();
	format(out.s, "check until: ", out.i);
	out
}
@end
@entry bf834e0e34ef0525
kind: step
verb: swap
noun: window
modifier: sorted
context: loop
phrase: swap window elements to establish sorted order of size {size}
phrase: reorder elements within sliding window of width {size}
slot: size int
test: list=5,2,8,1,9 size=3
expect: => i=3 r=0.0 ok=true s="sorted window: 3" errors=0 n=5 res=[2,5,8,1,9] cache=0 hits=0
