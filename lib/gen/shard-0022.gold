fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var win = ${w};
	if win > g.n { win = g.n; }
	if win <= 0 { return out; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var max_u = 0;
	for i in (g.n - win + 1) {
		var u = 0;
		for j in win {
			if j == 0 || g.res[i + j] != g.res[i + j - 1] { u++; }
		}
		if u > max_u { max_u = u; }
	}
	g.steps += g.n * win;
	out.i = max_u;
	out.s.clear();
	format(out.s, "max unique in window: ", max_u);
	out
}
@end
