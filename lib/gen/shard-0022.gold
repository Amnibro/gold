verb: place
noun: platform
modifier: cool
context: scene
phrase: place platform with cool ceramic texture size {sz}
phrase: build cool ceramic display platform dimension {sz}
slot: sz real
test: sz=4.0 doc="ground box 0,0,-.5 20,20,1"
expect: => i=2 r=0.0 ok=true s="place platform cool" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: plat2 box 0,0,0.2 4,4,0.4 m:ceramic #6699bb
test: sz=6.0 doc="hall box 0,0,0 12,12,0.3"
expect: => i=2 r=0.0 ok=true s="place platform cool" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: hall box 0,0,0 12,12,0.3
expect: => doc: plat2 box 0,0,0.2 6,6,0.4 m:ceramic #6699bb
test: sz=-1.0 doc="ground box 0,0,-.5 20,20,1"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${sz} <= 0.0 { gold_fail(g, "platform size must be positive"); out.ok = false; return out; }
	var p byte[>..] = [];
	gold_dnews(g, "plat", "", p);
	p.append(" box 0,0,");
	p.append("0.2 ");
	gold_fnum(p, ${sz});
	p.append(",");
	gold_fnum(p, ${sz});
	p.append(",0.4 m:ceramic #");
	p.append("66");
	p.append("99bb");
	gold_doc(g, p);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "place platform cool");
	out
}
@end
