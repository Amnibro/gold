expect: => i=2 r=0.0 ok=true s="checkpoint in_place: 2" errors=0 n=2 res=[40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${checkpoint};
	var write_idx = 0;
	for i in g.n {
		if g.res[i] >= cp {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "checkpoint in_place: ", write_idx);
	out
}
@end
