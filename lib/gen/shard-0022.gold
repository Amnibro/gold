@entry 9d9a40d0296609e7
kind: step
verb: swap
noun: suffix
modifier: while
context: sort
phrase: swap suffix items while out of order from {start}
phrase: sort tail elements from {start} while inversions remain
slot: start int
test: list=1,2,8,4,3 start=2
expect: => i=3 r=0.0 ok=true s="suffix while passes: 3" errors=0 n=5 res=[1,2,3,4,8] cache=0 hits=0
test: list=10,9,5 start=1
expect: => i=2 r=0.0 ok=true s="suffix while passes: 2" errors=0 n=3 res=[10,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	if s < 0 { s = 0; }
	if s >= g.n { return out; }
	var changed = true;
	var passes = 0;
	while changed && passes < 100 {
		changed = false;
		var i = s;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
				changed = true;
			}
			i++;
		}
		passes++;
	}
	g.steps += passes * (g.n - s);
	out.i = passes;
	out.s.clear();
	format(out.s, "suffix while passes: ", passes);
	out
}
@end
