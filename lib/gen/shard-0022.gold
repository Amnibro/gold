@entry 042a01c4dc6319e7
kind: step
verb: sort
noun: squares
modifier: running
context: cache
phrase: sort running sum of squares
phrase: order running squared accumulations
test: list=3,1,2
expect: => i=14 r=0.0 ok=true s="sorted squares total=14" errors=0 n=3 res=[9,10,14] cache=3 hits=0
test: list=4,2,1
expect: => i=21 r=0.0 ok=true s="sorted squares total=21" errors=0 n=3 res=[16,20,21] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	for i in g.n {
		let x = g.res[i];
		running += x * x;
		g.res[i] = running;
	}
	// Sort running sums in ascending order
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i, g.res[i]);
		i++;
	}
	g.steps += g.n * g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "sorted squares total=", running);
	out
}
@end
