code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_even = -1;
	var swaps = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			if first_even < 0 {
				first_even = i;
			} else {
				let tmp = g.res[first_even];
				g.res[first_even] = g.res[i];
				g.res[i] = tmp;
				first_even = -1;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " even pairs");
	out
}
@end
@entry 9182436f34b70fd6
kind: step
verb: merge
noun: pairs
modifier: sorted
context: stats
phrase: merge adjacent pairs into sorted sums
phrase: combine consecutive observation pairs in order
test: list=3,7,2,8
expect: => i=2 r=0.0 ok=true s="merged into 2 sorted pairs" errors=0 n=2 res=[10,10] cache=0 hits=0
test: list=10,20,5,15
expect: => i=2 r=0.0 ok=true s="merged into 2 sorted pairs" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var w = 0;
		var i = 0;
		while i + 1 < g.n {
			g.res[w] = g.res[i] + g.res[i + 1];
			w++;
			i += 2;
		}
		if i < g.n {
			g.res[w] = g.res[i];
			w++;
		}
		g.n = w;
		for a in g.n {
			var m = a;
			for b in (a + 1)..g.n {
				if g.res[b] < g.res[m] { m = b; }
			}
			if m != a {
				let tmp = g.res[a];
				g.res[a] = g.res[m];
				g.res[m] = tmp;
			}
		}
		out.i = g.n;
		out.s.clear();
		format(out.s, "merged into ", g.n, " sorted pairs");
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "too few elements to pair");
	}
	g.steps += g.n;
	out
}
@end
