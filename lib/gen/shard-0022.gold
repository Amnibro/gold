expect: => i=1 r=0.0 ok=true s="alternate evens: 1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var all_even = true;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] % 2 != 0 { all_even = false; break; }
		idx += 2;
	}
	out.ok = all_even;
	out.i = if all_even { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "alternate evens: ", out.i);
	out
}
@end
