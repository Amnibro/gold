fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= lim {
			count++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "running error pairs: ", count);
	out
}
@end
