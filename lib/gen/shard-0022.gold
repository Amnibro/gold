fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c >= 0 && c < g.n {
		g.n = c;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "bounded size to ", g.n);
	out
}
