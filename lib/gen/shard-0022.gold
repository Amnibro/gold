@entry 0dbe6008b1c4771e
kind: step
verb: validate
noun: runs
modifier: any
context: format
phrase: format validation of any run exceeding length {min_len}
phrase: display check status of any run meeting {min_len}
slot: min_len int
test: list=1,2,2,2,3 min_len=3
expect: => i=1 r=0.0 ok=true s="run valid: true" errors=0 n=5 res=[1,2,2,2,3] cache=0 hits=0
test: list=4,4,5,6 min_len=3
expect: => i=0 r=0.0 ok=true s="run valid: false" errors=0 n=4 res=[4,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let ml = ${min_len};
	var out = v;
	out.s.clear();
	var has_run = false;
	if g.n > 0 {
		var cur_len = 1;
		if cur_len >= ml { has_run = true; }
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_len++;
				if cur_len >= ml { has_run = true; }
			} else {
				cur_len = 1;
			}
		}
	}
	format(out.s, "run valid: ", has_run);
	out.i = if has_run { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
