fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${w};
	if w <= 0 || g.n < w { return out; }
	var total_max = 0;
	for i in g.n - w + 1 {
		var mx = g.res[i];
		for j in w {
			if g.res[i + j] > mx { mx = g.res[i + j]; }
		}
		total_max += mx;
	}
	out.i = total_max;
	out.s.clear();
	format(out.s, "normalize maximum nested: ", total_max);
	out
}
@end
