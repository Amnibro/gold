code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_count};
	let tok = ${token};
	var current = 0;
	for i in g.n {
		if g.res[i] == tok { current++; }
	}
	var appended = 0;
	while current < target && g.n < 512 {
		gold_push(g, tok);
		current++;
		appended++;
	}
	out.i = appended;
	out.s.clear();
	format(out.s, "fill words at_least: ", appended);
	out
}
@end
