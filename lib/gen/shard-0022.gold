code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${deg} <= 10.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	var o byte[>..] = [];
	var b_item byte[>..] = [];
	if !gold_dlast(g, b_item) { out.ok = false; return out; }
	gold_dnews(g, "hnd_lim", "", o);
	o.append(" limitrot ");
	o.append(b_item);
	o.append(" x-");
	gold_fnum(o, ${deg});
	o.append(",");
	gold_fnum(o, ${deg});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "hnd_lim");
	out
}
@end
