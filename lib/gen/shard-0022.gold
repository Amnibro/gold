code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_cost = ${budget};
	var filtered int[256] = [0; 256];
	var count = 0;
	for i in g.n {
		if g.res[i] <= max_cost {
			filtered[count] = g.res[i];
			count++;
		}
	}
	// Sort filtered in ascending order
	var i = 0;
	while i < count {
		var j = i + 1;
		while j < count {
			if filtered[j] < filtered[i] {
				let tmp = filtered[i];
				filtered[i] = filtered[j];
				filtered[j] = tmp;
			}
			j++;
		}
		gold_cache_put(g, i, filtered[i]);
		i++;
	}
	gold_clear(g);
	for k in count { gold_push(g, filtered[k]); }
	g.steps += g.n + count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "budget sorted count=", count);
	out
}
@end
