fn ${ID}(g Gold&, v Val) Val {
	let f = ${factor};
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "checkpoint: 0");
		out.i = 0;
		return out;
	}
	let cp = g.res[g.n - 1] * f;
	format(out.s, "checkpoint: ", cp);
	out.i = cp;
	g.steps += g.n;
	out
}
