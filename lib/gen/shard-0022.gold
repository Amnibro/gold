@entry 47f9bf374ac09063
kind: step
verb: scan
noun: histogram
modifier: unique
context: transform
phrase: scan histogram unique with bin {bin_size}
phrase: unique histogram scan step {bin_size}
slot: bin_size int
test: list=1,2,5,6,10 bin_size=5
expect: => i=3 r=0.0 ok=true s="unique bins: 3" errors=0 n=3 res=[0,1,2] cache=0 hits=0
test: list=10,25,30,45 bin_size=10
expect: => i=4 r=0.0 ok=true s="unique bins: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bin_size};
	if b <= 0 || g.n == 0 { return out; }
	var new_n = 0;
	for i in g.n {
		let bin_id = g.res[i] / b;
		var exists = false;
		for j in new_n {
			if g.res[j] == bin_id { exists = true; break; }
		}
		if !exists {
			g.res[new_n] = bin_id;
			new_n++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "unique bins: ", new_n);
	out
}
