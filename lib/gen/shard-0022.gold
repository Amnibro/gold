@entry ade4e49b38848a68
kind: step
verb: pair
noun: words
modifier: with_cache
context: loop
phrase: pair words caching intermediate tokens modulo divisor {mod}
phrase: couple word token pairs in loop with cache bound {mod}
slot: mod int
test: list=10,20,30,40 mod=5
expect: => i=2 r=0.0 ok=true s="cached word pairs: 2" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=7,14,21 mod=3
expect: => i=1 r=0.0 ok=true s="cached word pairs: 1" errors=0 n=3 res=[7,14,21] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mod};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		gold_cache_put(g, i, sum % m);
		pairs++;
		i += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached word pairs: ", pairs);
	out
}
@end
