fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var total = 0;
	for layer in d {
		for i in g.n {
			let val, ok = gold_cache_get(g, i);
			if ok { total += val * (layer + 1); }
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "fold cache recursively: ", total);
	out
}
@end
