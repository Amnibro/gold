phrase: scale budget each value proportion to cap {total_budget}
slot: total_budget int
test: list=20,30,50 total_budget=50
expect: => i=50 r=0.0 ok=true s="budget sum: 50" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: list=10,40,50 total_budget=40
expect: => i=40 r=0.0 ok=true s="budget sum: 40" errors=0 n=3 res=[4,16,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bud = ${total_budget};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	if total <= 0 || bud <= 0 { return out; }
	var new_total = 0;
	for i in g.n {
		g.res[i] = (g.res[i] * bud) / total;
		new_total += g.res[i];
	}
	out.i = new_total;
	out.s.clear();
	format(out.s, "budget sum: ", new_total);
	out
}
@end
