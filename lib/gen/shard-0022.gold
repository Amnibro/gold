test: list=4,2,5,2,4,8
expect: => i=4 r=0.0 ok=true s="dedupe in_reverse: 4" errors=0 n=4 res=[5,2,4,8] cache=0 hits=0
test: list=10,20,10,30,20
expect: => i=3 r=0.0 ok=true s="dedupe in_reverse: 3" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = [0; 512];
	var sn = 0;
	var kept_rev = [0; 512];
	var kn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var found = false;
		for j in sn { if seen[j] == x { found = true; break; } }
		if !found { seen[sn] = x; sn++; kept_rev[kn] = x; kn++; }
		i--;
	}
	g.n = 0;
	var k = kn - 1;
	while k >= 0 { gold_push(g, kept_rev[k]); k--; }
	out.i = kn;
	out.s.clear();
	format(out.s, "dedupe in_reverse: ", kn);
	out
}
@end
