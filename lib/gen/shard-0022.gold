@entry 5bf43d19cf94f35d
kind: step
verb: rank
noun: range
modifier: running
context: retry
slot: span int
phrase: rank range running window variance of span {span}
phrase: compute running range difference across retry spans of {span}
test: list=10,25,15,40,30 span=3
expect: => i=3 r=0.0 ok=true s="running range spans calculated: 3" errors=0 n=3 res=[15,25,25] cache=0 hits=0
test: list=5,8,12,6,14 span=2
expect: => i=4 r=0.0 ok=true s="running range spans calculated: 4" errors=0 n=4 res=[3,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 0 || g.n < w {
		gold_fail(g, "rank range running: window exceeds list length");
		out.ok = false;
		return out;
	}
	var count = g.n - w + 1;
	var i = 0;
	while i < count {
		var min_v = g.res[i];
		var max_v = g.res[i];
		var j = 1;
		while j < w {
			let val = g.res[i + j];
			if val < min_v { min_v = val; }
			if val > max_v { max_v = val; }
			j++;
		}
		g.res[i] = max_v - min_v;
		i++;
	}
	g.n = count;
	g.steps += count * w;
	out.i = count;
	out.s.clear();
	format(out.s, "running range spans calculated: ", count);
	out
}
@end
