code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals = [0; 512];
	var freqs = [0; 512];
	var ucnt = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in ucnt {
			if vals[j] == x {
				freqs[j]++;
				found = true;
				break;
			}
		}
		if !found {
			vals[ucnt] = x;
			freqs[ucnt] = 1;
			ucnt++;
		}
	}
	for i in ucnt {
		for j in ucnt - 1 {
			if freqs[j] > freqs[j + 1] {
				let tf = freqs[j];
				freqs[j] = freqs[j + 1];
				freqs[j + 1] = tf;
			}
		}
	}
	g.n = 0;
	for i in ucnt { gold_push(g, freqs[i]); }
	out.i = ucnt;
	out.s.clear();
	format(out.s, "unique buckets: ", ucnt);
	out
}
@end
@entry ada9f431d55af7d3
kind: step
verb: split
noun: gaps
modifier: times
context: core
phrase: split gaps times delta exceeds bound {gap}
phrase: divide gaps times distance meets ceiling {gap}
slot: gap int
test: list=1,2,10,11,30 gap=5
expect: => i=2 r=0.0 ok=true s="gap splits: 2" errors=0 n=7 res=[1,2,0,10,11,0,30] cache=0 hits=0
test: list=5,6,7,20,21 gap=10
expect: => i=1 r=0.0 ok=true s="gap splits: 1" errors=0 n=6 res=[5,6,7,0,20,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${gap};
	if g.n < 2 { return out; }
	var splits = 0;
	var res_new = [0; 512];
	var cnt = 0;
	res_new[cnt] = g.res[0];
	cnt++;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff >= gap {
			res_new[cnt] = 0;
			cnt++;
			splits++;
		}
		res_new[cnt] = g.res[i + 1];
		cnt++;
	}
	g.n = 0;
	for i in cnt { gold_push(g, res_new[i]); }
	out.i = splits;
	out.s.clear();
	format(out.s, "gap splits: ", splits);
	out
}
@end
