fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${lim};
	if g.n > threshold {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let t = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = t;
			i++;
			j--;
		}
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reversed under size limit: ", out.i);
	out
}
@end
@entry db01c2d2a894b6f3
kind: step
verb: reverse
noun: range
modifier: nested
context: sort
phrase: reverse nested range from {start} with length {span}
phrase: invert inner range starting at {start} spanning {span} items
slot: start int
slot: span int
test: list=1,2,3,4,5,6 start=1 span=4
expect: => i=4 r=0.0 ok=true s="reversed nested span: 4" errors=0 n=6 res=[1,5,4,3,2,6] cache=0 hits=0
test: list=10,20,30,40 start=0 span=3
expect: => i=3 r=0.0 ok=true s="reversed nested span: 3" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var l = ${span};
	if s < 0 { s = 0; }
	if s >= g.n { return out; }
	if s + l > g.n { l = g.n - s; }
	if l <= 1 { return out; }
	var i = s;
	var j = s + l - 1;
	while i < j {
		let t = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = t;
			i++;
			j--;
	}
	g.steps += l;
	out.i = l;
	out.s.clear();
	format(out.s, "reversed nested span: ", l);
	out
}
@end
