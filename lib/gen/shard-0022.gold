fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = if ${span} > 0 { ${span} } else { 1 };
	var sums = [0; 512];
	var count = 0;
	var idx = g.n;
	while idx > 0 {
		var blk = 0;
		for step in span {
			if idx > 0 {
				idx--;
				blk += g.res[idx];
			}
		}
		sums[count] = blk;
		count++;
	}
	g.n = 0;
	for i in count { gold_push(g, sums[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "grouped blocks: ", count);
	out
}
