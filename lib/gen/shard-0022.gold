phrase: combine alternate loop step values using offset {delta}
slot: delta int
test: list=10,20,30,40 delta=5
expect: => i=2 r=0.0 ok=true s="merged steps: 2" errors=0 n=2 res=[35,75] cache=0 hits=0
test: list=1,2,3,4,5 delta=10
expect: => i=3 r=0.0 ok=true s="merged steps: 3" errors=0 n=3 res=[13,17,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n < 2 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "merged steps: ", out.i);
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			g.res[new_n] = g.res[i] + g.res[i + 1] + d;
			new_n++;
			i += 2;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
			i++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged steps: ", out.i);
	out
}
@end
