fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
	}
	if clamped > 0 {
		gold_fail(g, "step ceiling clamped");
