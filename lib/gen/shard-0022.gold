test: list=15,3,7 idx=0
expect: => i=3 r=0.0 ok=true s="selected checkpoint: 3" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = ${idx};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n == 0 { return out; }
	if pos < 0 { pos = 0; }
	if pos >= g.n { pos = g.n - 1; }
	let chosen = g.res[pos];
	g.res[0] = chosen;
	g.n = 1;
	g.steps += g.n;
	out.i = chosen;
	out.s.clear();
	format(out.s, "selected checkpoint: ", chosen);
	out
}
@end
