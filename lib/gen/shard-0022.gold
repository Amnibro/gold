test: list=1,3,5,7,9
expect: => i=5 r=0.0 ok=true s="counted odd values: 5" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=2,5,3,8,11
expect: => i=3 r=0.0 ok=true s="counted odd values: 3" errors=0 n=5 res=[2,3,5,8,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = 0;
	var sorted = true;
	for i in g.n {
		if core_is_odd(g.res[i]) { odds++; }
		if i > 0 && g.res[i] < g.res[i - 1] { sorted = false; }
	}
	if !sorted {
		for a in g.n {
			for b in (a + 1)..g.n {
				if g.res[a] > g.res[b] {
					let t = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = t;
				}
			}
		}
	}
	g.steps += g.n * 2;
	out.i = odds;
	out.s.clear();
	format(out.s, "counted odd values: ", odds);
	out
}
@end
