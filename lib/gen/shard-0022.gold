fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${times};
	var nn = 0;
	var temp = [0; 512];
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d >= min_d {
			temp[nn] = g.res[k];
			nn++;
		}
	}
	for k in nn { g.res[k] = temp[k]; }
	g.n = nn;
	g.steps += g.n;
	out.i = nn;
	out.s.clear();
	format(out.s, "filtered digits entries: ", nn);
	out
}
@end
