@entry 44ef6f11966daf9e
kind: step
verb: split
noun: cache
modifier: any
context: error
phrase: split cache error records where any exceeds {th}
phrase: partition cached fault entries if any surpasses {th}
slot: th int
test: list=10,50,20,80 th=30
expect: => i=2 r=0.0 ok=true s="split cache entries: 2" errors=0 n=2 res=[50,80] cache=4 hits=0
test: list=5,10,15 th=50
expect: => i=0 r=0.0 ok=false s="split cache entries: 0" errors=1 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${th};
	if g.cn == 0 {
		for i in g.n {
			gold_cache_put(g, i + 1, g.res[i]);
		}
	}
	var count = 0;
	gold_clear(g);
	for i in g.cn {
		if g.cv[i] > threshold {
			gold_push(g, g.cv[i]);
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no cache values above threshold");
		out.ok = false;
	}
	g.steps += g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "split cache entries: ", count);
	out
}
@end
@entry 7c3c0c43f4bb697d
kind: step
verb: drop
noun: words
modifier: with_retry
context: error
phrase: drop error log words with retry limit {retry}
phrase: remove fault message words using retry count {retry}
slot: retry int
test: text="err timeout panic failed" retry=2
expect: => i=2 r=0.0 ok=true s="panic failed" errors=0 n=0 res=[] cache=0 hits=0
test: text="bad alloc" retry=1
expect: => i=1 r=0.0 ok=true s="alloc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retry};
	if r <= 0 {
		gold_fail(g, "invalid retry count");
		out.ok = false;
		return out;
	}
	var words_dropped = 0;
	var idx = 0;
	while idx < out.s.len && words_dropped < r {
		while idx < out.s.len && out.s[idx] != ' ' {
			idx++;
		}
		words_dropped++;
		while idx < out.s.len && out.s[idx] == ' ' {
			idx++;
		}
	}
	var new_s byte[..200] = "";
	var j = idx;
	while j < out.s.len {
		if new_s.len < 200 { new_s.push(out.s[j]); }
		j++;
	}
	out.s = new_s;
	g.steps += words_dropped;
	out.i = words_dropped;
	out
}
@end
