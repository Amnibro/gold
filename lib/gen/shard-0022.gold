code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 {
		gold_fail(g, "invalid cache window size");
		out.ok = false;
		return out;
	}
	let limit = if g.n < count { g.n } else { count };
	for i in limit {
		gold_cache_put(g, i + 1, g.res[i]);
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "cached first ", limit, " items");
	out
}
