code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if ${c} < 1 { gold_fail(g, "width must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c}) % 2) as real;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	for k in g.iw * g.ih { if g.img[k] >= 0.5 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "metal");
	out
}
@end
