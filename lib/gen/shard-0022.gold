expect: => i=34 r=0.0 ok=true s="run value nested: 34" errors=0 n=4 res=[6,10,3,15] cache=0 hits=0
test: list=2,6,1,4
expect: => i=35 r=0.0 ok=true s="run value nested: 35" errors=0 n=4 res=[3,21,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var res_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var part = 0;
		var c = 1;
		while c <= x {
			part += c;
			c++;
		}
		res_sum += part;
		g.res[i] = part;
	}
	out.i = res_sum;
	out.s.clear();
	format(out.s, "run value nested: ", res_sum);
	out
}
@end
