expect: => i=3 r=0.0 ok=true s="merged histogram bins: 3" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bin_size};
	if bs <= 0 {
		gold_fail(g, "bin size must be positive");
		out.ok = false;
		return out;
	}
	var max_v = 0;
	for k in g.n {
		if g.res[k] > max_v { max_v = g.res[k]; }
	}
	var bins = [0, 0, 0, 0, 0, 0, 0, 0];
	for k in g.n {
		let b = g.res[k] / bs;
		if b < 8 {
			bins[b]++;
		}
	}
	g.n = 0;
	var non_empty = 0;
	for b in 8 {
		if bins[b] > 0 {
			gold_push(g, bins[b]);
			non_empty++;
		}
	}
	g.steps += g.n;
	out.i = non_empty;
	out.s.clear();
	format(out.s, "merged histogram bins: ", out.i);
	out
}
@end
