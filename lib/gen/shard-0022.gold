fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var mn = g.res[0];
		for i in g.n {
			if g.res[i] < mn { mn = g.res[i]; }
		}
		for i in g.n {
			g.res[i] -= mn;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized nested count: ", g.n);
	out
}
@end
