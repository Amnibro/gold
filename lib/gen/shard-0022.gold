@entry be612d3e48245394
kind: step
verb: swap
noun: average
modifier: recursively
context: sort
phrase: swap elements around average value recursively
phrase: partition around mean recursively for quicksort
test: list=10,2,8,4,6
expect: => i=6 r=0.0 ok=true s="swapped around average: 6" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,9,5
expect: => i=5 r=0.0 ok=true s="swapped around average: 5" errors=0 n=3 res=[1,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		while left < g.n && g.res[left] <= avg { left++; }
		while right >= 0 && g.res[right] > avg { right--; }
		if left < right {
			let t = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = t;
		}
	}
	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[a] > g.res[b] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped around average: ", avg);
	out
}
@end
