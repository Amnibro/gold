test: list=5,10,15 target=50
expect: => i=0 r=0.0 ok=false s="validate checkpoint: 0" errors=1 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var reached = false;
	for i in g.n {
		if g.res[i] >= tg { reached = true; break; }
	}
	if !reached {
		gold_fail(g, "checkpoint target not reached");
		out.ok = false;
	}
	out.i = if reached { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validate checkpoint: ", out.i);
	out
}
@end
