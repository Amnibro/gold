		if ${pred_slot}(g.res[i]) {
			found = true;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found {
		format(out.s, "function match found");
	} else {
