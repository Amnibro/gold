	gold_dnews(g, "wind_terrain_ringed", "", o);
	o.append(" cone 0,0,");
	o.append("0 0,");
	o.append("0,");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:matte ");
	gold_hex(o, 120, 100, 70);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "windterrainringed");
	out
}
