fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var k = 0;
	while k < g.n {
