fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var running = 0;
	for i in g.n {
		running += g.res[i];
		if running > c { running = c; }
		g.res[i] = running;
	}
	out.i = running;
	out.s.clear();
	format(out.s, "mapped total: ", running);
	out
}
