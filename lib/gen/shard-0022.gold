phrase: populate fault memo using cache entries with default {default_code}
slot: default_code int
test: list=1,2,3 default_code=99
expect: => i=3 r=0.0 ok=true s="memo filled with 3 defaults" errors=0 n=3 res=[99,99,99] cache=0 hits=0
test: list=5,10 default_code=0
expect: => i=2 r=0.0 ok=true s="memo filled with 2 defaults" errors=0 n=2 res=[0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let def_c = ${default_code};
	var replaced = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = val;
		} else {
			g.res[i] = def_c;
			replaced++;
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "memo filled with ", replaced, " defaults");
	out
}
@end
@entry 44dd2afb5fca9bdf
kind: step
verb: cache
noun: tail
modifier: between
context: error
phrase: cache tail error values between range {lo} to {hi}
phrase: store trailing fault indicators between bounds {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,25,35,45 lo=20 hi=40
expect: => i=2 r=0.0 ok=true s="cached 2 tail errors" errors=0 n=4 res=[10,25,35,45] cache=2 hits=0
test: list=5,8,12 lo=20 hi=30
expect: => i=0 r=0.0 ok=true s="cached 0 tail errors" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l > h {
		gold_fail(g, "invalid tail range bounds");
		out.ok = false;
		return out;
	}
	var cached_count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if x >= l && x <= h {
			gold_cache_put(g, x, x * 2);
			cached_count++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = cached_count;
	out.s.clear();
	format(out.s, "cached ", cached_count, " tail errors");
	out
}
@end
@entry 201dd093c02f074a
kind: step
verb: drop
noun: runs
modifier: while
context: error
phrase: drop error runs while values exceed {th}
phrase: truncate fault sequences while scores above {th}
slot: th int
test: list=50,60,70,10,20 th=40
expect: => i=3 r=0.0 ok=true s="dropped 3 leading run items" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 th=20
expect: => i=0 r=0.0 ok=true s="dropped 0 leading run items" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${th};
	var start = 0;
	while start < g.n && g.res[start] > limit {
		start++;
	}
	let rem = g.n - start;
	for i in rem {
		g.res[i] = g.res[start + i];
	}
	g.n = rem;
	g.steps += start;
	out.i = start;
	out.s.clear();
	format(out.s, "dropped ", start, " leading run items");
	out
}
@end
@entry 4ab9d28a016b4094
kind: step
verb: apply
noun: item
modifier: in_reverse
context: error
phrase: apply error rollback to each item in reverse
phrase: process fault compensation per item in reverse order
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="reversed 4 items" errors=0 n=4 res=[-4,-3,-2,-1] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed 3 items" errors=0 n=3 res=[-30,-20,-10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for reverse compensation");
		out.ok = false;
		return out;
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = -g.res[j];
		g.res[j] = -tmp;
		i++;
		j--;
	}
	if i == j {
		g.res[i] = -g.res[i];
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " items");
	out
}
@end
