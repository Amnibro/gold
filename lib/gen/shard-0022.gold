expect: => i=2 r=0.0 ok=true s="drop tally unique: 2" errors=0 n=4 res=[8,12,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var nk = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			kept[nk] = x;
			nk++;
		} else {
			dropped++;
		}
	}
	g.n = 0;
	for i in nk { gold_push(g, kept[i]); }
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop tally unique: ", dropped);
	out
}
@end
