fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "series reversed count: ", out.i);
	out
}
@end
