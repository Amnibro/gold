model: worley c=8 u=${u}; contrast a=1.6; invert
test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="marble" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.027 max=1 sum8=41907 hash=39195
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="marble" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=156286 hash=496995
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	for k in g.iw * g.ih { g.img[k] = 1.0 - g.img[k]; }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "marble");
	out
}
@end
