fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k <= 0 { return out; }
	var total = 0;
	var i = k - 1;
	while i >= 0 {
		total += g.res[i];
		if i == 0 { break; }
		i--;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "sum prefix in_reverse: ", total);
	out
}
