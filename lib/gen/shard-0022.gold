code:
fn ${ID}(n int) int {
	let limit = if n < 2 { 2 } else { n };
	var total = 0;
	var candidate = 2;
	while candidate <= limit {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			total += candidate;
		}
		candidate++;
	}
	total
}
@end
