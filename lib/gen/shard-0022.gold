noun: runs
modifier: recursively
context: sort
phrase: reverse runs recursively within sorted partitions
phrase: invert ordered segments recursively
test: list=8,1,6,3,7,2,5,4
expect: => i=8 r=0.0 ok=true s="reversed partitioned runs: 8" errors=0 n=8 res=[4,3,2,1,8,7,6,5] cache=0 hits=0
test: list=9,3,6,1,8,2
expect: => i=6 r=0.0 ok=true s="reversed partitioned runs: 6" errors=0 n=6 res=[3,2,1,9,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let mid = g.n / 2;
	var left = 0;
	var right = mid - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	left = mid;
	right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed partitioned runs: ", g.n);
	out
}
@end
