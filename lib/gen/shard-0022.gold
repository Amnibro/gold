code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bw = ${bin_width};
	var r = ${retries};
	if bw <= 0 {
		gold_fail(g, "bin width must be positive");
		out.ok = false;
		return out;
	}
	for k in g.n {
		if g.res[k] < 0 {
			if r > 0 {
				g.res[k] = 0;
				r--;
			} else {
				gold_fail(g, "negative item in histogram");
			}
		}
	}
	var bins = [0, 0, 0, 0, 0, 0, 0, 0];
	for k in g.n {
		let b = g.res[k] / bw;
		if b < 8 {
			bins[b]++;
		}
	}
	g.n = 0;
	var used = 0;
	for b in 8 {
		if bins[b] > 0 {
			gold_push(g, bins[b]);
			used++;
		}
	}
	g.steps += g.n;
	out.i = used;
	out.s.clear();
	format(out.s, "histogram bins with retry: ", out.i);
	out
}
@end
@entry 500264c60360570c
kind: step
verb: swap
noun: cache
modifier: last
context: loop
phrase: swap cache last key with loop result index {idx}
phrase: exchange last cached value in loop with item at {idx}
slot: idx int
test: list=10,20,30 idx=1
expect: => i=99 r=0.0 ok=true s="swapped cache last: 99" errors=0 n=3 res=[10,99,30] cache=1 hits=0
test: list=5,15,25,35 idx=2
expect: => i=99 r=0.0 ok=true s="swapped cache last: 99" errors=0 n=4 res=[5,15,99,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let i = ${idx};
	if g.cn == 0 {
		gold_cache_put(g, 10, 99);
	}
	if i < 0 || i >= g.n {
		gold_fail(g, "index out of range");
		out.ok = false;
		return out;
	}
	let last_idx = g.cn - 1;
	let tmp = g.cv[last_idx];
	g.cv[last_idx] = g.res[i];
	g.res[i] = tmp;
	g.steps += 1;
	out.i = g.res[i];
	out.s.clear();
	format(out.s, "swapped cache last: ", out.i);
	out
}
@end
