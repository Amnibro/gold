fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cnt, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cnt + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	for i in g.n {
		let x = g.res[i];
		let cnt, _ = gold_cache_get(g, x);
		g.res[i] = cnt;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalize histogram with_cache: ", g.n);
	out
}
@end
