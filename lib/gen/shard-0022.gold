			if g.res[j * 2] < g.res[i * 2] {
				let t = g.res[i * 2];
				g.res[i * 2] = g.res[j * 2];
				g.res[j * 2] = t;
			}
		}
	}
	out.i = evens;
	out.s.clear();
	format(out.s, "sorted list every other");
	out
}
