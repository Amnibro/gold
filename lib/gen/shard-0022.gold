fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = if ${limit} > 0 { ${limit} } else { 0 };
	if g.n < 2 || lim == 0 { return out; }
	var pair_sums = [0; 512];
	var count = 0;
	var i = 0;
	while i + 1 < g.n && count < lim {
		pair_sums[count] = g.res[i] + g.res[i + 1];
		count++;
		i += 2;
	}
	g.n = 0;
	for j in count { gold_push(g, pair_sums[j]); }
	out.i = count;
	out.s.clear();
	format(out.s, "computed pairs: ", count);
	out
}
@end
