test: list=0,10,0,20
expect: => i=2 r=0.0 ok=true s="active loop counters: 2" errors=0 n=4 res=[0,10,0,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		if g.res[k] != 0 {
			count++;
		}
		if g.res[k] < 0 {
			g.res[k] = 0;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "active loop counters: ", out.i);
	out
}
@end
