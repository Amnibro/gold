@entry 0a827a6a39037be9
kind: step
verb: rank
noun: middle
modifier: each
context: math
phrase: rank middle math value against average
phrase: compute relative rank of middle math element
test: list=2,4,9,11,14
expect: => i=1 r=0.0 ok=true s="ranked middle each" errors=0 n=5 res=[2,4,9,11,14] cache=0 hits=0
test: list=10,20,50,40,30
expect: => i=20 r=0.0 ok=true s="ranked middle each" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { gold_fail(g, "empty results for rank middle"); out.ok = false; return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	let mid_idx = g.n / 2;
	let mid_val = g.res[mid_idx];
	out.i = mid_val - avg;
	out.s.clear();
	format(out.s, "ranked middle each");
	out
}
@end
