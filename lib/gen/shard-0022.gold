code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient hits for gaps");
		return out;
	}
	var gaps = [0; 512];
	var gn = 0;
	var i = 1;
	while i < g.n {
		let d = g.res[i] - g.res[i - 1];
		let ad = if d < 0 { -d } else { d };
		var seen = false;
		for j in gn {
			if gaps[j] == ad { seen = true; break; }
		}
		if !seen {
			gaps[gn] = ad;
			gn++;
		}
		i++;
	}
	gold_clear(g);
	for j in gn { gold_push(g, gaps[j]); }
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "unique search gaps: ", gn);
	out
}
@end
@entry d419fcb8ff9e8613
kind: step
verb: dedupe
noun: evens
modifier: times
context: search
phrase: dedupe search evens times limit {times}
phrase: deduplicate even candidate items allowed occurrences {times}
slot: times int
test: list=2,2,2,3,4,4,4 times=1
expect: => i=3 r=0.0 ok=true s="deduped evens count: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=6,6,6,6,7,8,8 times=2
expect: => i=5 r=0.0 ok=true s="deduped evens count: 5" errors=0 n=5 res=[6,6,7,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_occ = ${times};
	if max_occ <= 0 {
		gold_fail(g, "invalid dedupe times limit");
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var temp = [0; 512];
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = 0;
			for j in new_n {
				if temp[j] == x { seen++; }
			}
			if seen < max_occ {
				temp[new_n] = x;
				new_n++;
			}
		} else {
			temp[new_n] = x;
			new_n++;
		}
	}
	for k in new_n { g.res[k] = temp[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped evens count: ", new_n);
	out
}
@end
@entry 39db76cd3d0972cf
kind: step
verb: rotate
noun: squares
modifier: none
context: search
phrase: rotate square search keys none
phrase: cyclically shift perfect square search results
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="rotated square keys: 3" errors=0 n=5 res=[16,7,4,12,9] cache=0 hits=0
test: list=1,3,25,36
expect: => i=3 r=0.0 ok=true s="rotated square keys: 3" errors=0 n=4 res=[36,3,1,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_idx = [0; 64];
	var sq_val = [0; 64];
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x && count < 64 {
				sq_idx[count] = k;
				sq_val[count] = x;
				count++;
			}
		}
	}
	if count > 1 {
		let last = sq_val[count - 1];
		var i = count - 1;
		while i > 0 {
			sq_val[i] = sq_val[i - 1];
			i--;
		}
		sq_val[0] = last;
		for c in count {
			g.res[sq_idx[c]] = sq_val[c];
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated square keys: ", count);
	out
}
@end
