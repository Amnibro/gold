@entry 7ccfc1a68d0a8dfa
kind: step
verb: rotate
noun: errors
modifier: between
context: search
phrase: rotate search errors between index {lo} through {hi}
phrase: cyclically shift search discrepancy items between {lo} with {hi}
slot: lo int
slot: hi int
test: list=10,20,30,40,50 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="rotated search errors: 3" errors=0 n=5 res=[10,30,40,20,50] cache=0 hits=0
test: list=5,15,25,35 lo=0 hi=2
expect: => i=3 r=0.0 ok=true s="rotated search errors: 3" errors=0 n=4 res=[15,25,5,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l < 0 || h >= g.n || l >= h {
		gold_fail(g, "invalid search error rotation bounds");
		out.ok = false;
		return out;
	}
	let first = g.res[l];
	var i = l;
	while i < h {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[h] = first;
	g.steps += (h - l + 1);
	out.i = h - l + 1;
	out.s.clear();
	format(out.s, "rotated search errors: ", out.i);
	out
}
@end
