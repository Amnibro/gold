@entry 05411eaeb18f3f5b
kind: step
verb: validate
noun: minimum
modifier: with_cache
context: math
phrase: validate math minimum with cache against {k}
phrase: verify cached math minimum floor {k}
slot: k int
test: list=12,8,15,20 k=5
expect: => i=8 r=0.0 ok=true s="minimum validated with cache" errors=0 n=4 res=[12,8,15,20] cache=1 hits=0
test: list=10,20,30 k=15
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${k};
	if g.n == 0 { gold_fail(g, "empty results for min validation"); out.ok = false; return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	gold_cache_put(g, floor, min_val);
	if min_val < floor {
		gold_fail(g, "minimum below floor");
		out.ok = false;
		return out;
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum validated with cache");
	out
}
@end
