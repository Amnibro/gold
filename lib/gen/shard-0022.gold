slot: max_diff int
test: list=10,50,60 max_diff=20
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise steps" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=5,10,15 max_diff=10
expect: => i=0 r=0.0 ok=true s="clamped 0 pairwise steps" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var clamped = 0;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			if diff > md {
				g.res[i + 1] = g.res[i] + md;
				clamped++;
			} else if diff < -md {
				g.res[i + 1] = g.res[i] - md;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " pairwise steps");
	out
}
@end
