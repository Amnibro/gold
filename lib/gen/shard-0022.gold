@entry 5c8bc8fe0039f81f
kind: step
verb: dedupe
noun: history
modifier: up_to
context: math
phrase: dedupe history up to limit of {cap} elements in math
phrase: remove duplicate entries up to maximum count {cap} in math
slot: cap int
test: list=1,1,2,2,3,3 cap=2
expect: => i=2 r=0.0 ok=true s="deduped history up to limit: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=4,5,4,6,5,7 cap=3
expect: => i=3 r=0.0 ok=true s="deduped history up to limit: 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var w = 0;
	for i in g.n {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[w] = g.res[i];
			w++;
			if w >= limit {
				break;
			}
		}
	}
	g.n = w;
	g.steps += g.n * w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped history up to limit: ", w);
	out
}
@end
@entry 2a518aa88758844c
kind: step
verb: dedupe
noun: subfunction
modifier: each
context: math
phrase: dedupe subfunction each filtering consecutive outputs from {sub} in math
phrase: filter consecutive duplicate values produced by {sub} in math
slot: sub fn
test: list=2,3,4,5 sub=halve
expect: => i=2 r=0.0 ok=true s="deduped each subfunction remaining: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=6,7,8,9 sub=halve
expect: => i=2 r=0.0 ok=true s="deduped each subfunction remaining: 2" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var w = 1;
		var i = 1;
		while i < g.n {
			if ${sub}(g.res[i]) != ${sub}(g.res[i - 1]) {
				g.res[w] = g.res[i];
				w++;
			}
			i++;
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped each subfunction remaining: ", g.n);
	out
}
@end
