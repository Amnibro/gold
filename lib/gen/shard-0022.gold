@entry 412c997d0100837c
kind: step
verb: dedupe
noun: budget
modifier: sorted
context: search
phrase: deduplicate search results within budget sorted by score {budget}
phrase: prune duplicate candidate items within budget sorted by rank {budget}
slot: budget int
test: list=8,3,8,5,2,3,9 budget=4
expect: => i=4 r=0.0 ok=true s="dedupe budget sorted: 4" errors=0 n=4 res=[2,3,5,8] cache=0 hits=0
test: list=15,20,10,15,30,20 budget=3
expect: => i=3 r=0.0 ok=true s="dedupe budget sorted: 3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bg = ${budget};
	if bg <= 0 { g.n = 0; return out; }
	var unique = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if unique[j] == x { exists = true; break; }
		}
		if !exists { unique[un] = x; un++; }
	}
	for i in un {
		for j in un - 1 - i {
			if unique[j] > unique[j + 1] {
				let tmp = unique[j]; unique[j] = unique[j + 1]; unique[j + 1] = tmp;
			}
		}
	}
	let limit_cnt = if un < bg { un } else { bg };
	g.n = 0;
	for i in limit_cnt { gold_push(g, unique[i]); }
	out.i = limit_cnt;
	out.s.clear();
	format(out.s, "dedupe budget sorted: ", limit_cnt);
	out
}
@end
@entry 433babac2be512ea
kind: step
verb: dedupe
noun: series
modifier: in_reverse
context: search
phrase: dedupe search candidate series in reverse scan order
