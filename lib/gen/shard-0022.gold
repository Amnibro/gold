@entry 3d3dcf68fdaf42ae
kind: step
verb: join
noun: odds
modifier: pairwise
context: search
phrase: combine odd search candidate scores pairwise
phrase: join odd search match values in pairs
test: list=3,5,7,9,11,13
expect: => i=3 r=0.0 ok=true s="join odds pairwise: 3" errors=0 n=3 res=[8,16,24] cache=0 hits=0
test: list=1,3,8,5,7
expect: => i=2 r=0.0 ok=true s="join odds pairwise: 2" errors=0 n=2 res=[4,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 { odds[on] = g.res[i]; on++; }
	}
	var pairs = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < on {
		pairs[pn] = odds[i] + odds[i + 1];
		pn++;
		i += 2;
	}
	g.n = 0;
	for j in pn { gold_push(g, pairs[j]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "join odds pairwise: ", pn);
	out
}
@end
@entry 574a53286bf365b3
kind: step
