fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${max_drop};
	let lim = ${limit};
	var dropped = 0;
	while dropped < max_d && dropped < g.n && g.res[dropped] < lim {
		dropped++;
	}
	var rem = [0; 512];
	let new_n = g.n - dropped;
	for i in new_n { rem[i] = g.res[dropped + i]; }
	g.n = 0;
	for i in new_n { gold_push(g, rem[i]); }
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop prefix at_most: ", dropped);
	out
}
@end
