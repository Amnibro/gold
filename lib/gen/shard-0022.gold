	for k in c { mod *= 10; }
	var num = out.i;
	gold_clear(g);
	while num > 0 {
		gold_push(g, num % mod);
		num /= mod;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped into ", g.n, " digit chunks");
