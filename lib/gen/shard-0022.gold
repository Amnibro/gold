kind: step
verb: shift
noun: sequence
modifier: while
context: error
phrase: shift error sequence elements while equal to {err_code}
phrase: rotate fault sequence while head matches {err_code}
slot: err_code int
test: list=500,500,200,300 err_code=500
expect: => i=2 r=0.0 ok=true s="shifted 2 matching elements" errors=0 n=4 res=[200,300,500,500] cache=0 hits=0
