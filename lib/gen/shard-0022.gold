fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	var rank = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			rank++;
			running += x;
			gold_cache_put(g, x, rank);
			gold_cache_put(g, 1000 + rank, running);
		}
		i++;
	}
	g.steps += i;
	out.i = running;
	out.s.clear();
	format(out.s, "unique rank total=", running);
	out
}
@end
@entry 706595ae66258e9f
kind: step
verb: validate
noun: step
modifier: recursively
context: cache
phrase: validate step increments recursively with bound {step}
phrase: check step transitions recursively under {step}
slot: step int
test: list=2,5,8,11 step=3
expect: => i=3 r=0.0 ok=true s="valid steps=3" errors=0 n=4 res=[2,5,8,11] cache=3 hits=0
test: list=1,4,10,12 step=4
expect: => i=2 r=0.0 ok=true s="valid steps=2" errors=0 n=4 res=[1,4,10,12] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_step = ${step};
	var valid_count = 0;
	var i = 1;
	while i < g.n {
		let delta = g.res[i] - g.res[i - 1];
		if delta <= max_step && delta >= 0 {
			valid_count++;
			gold_cache_put(g, i, delta);
		}
		i++;
	}
	g.steps += g.n;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "valid steps=", valid_count);
	out
}
@end
