noun: list
modifier: times
context: list
phrase: compare list times scaling factor {factor}
phrase: evaluate list times multiplier {factor}
slot: factor int
test: list=5,12,30,8,25 factor=2
expect: => i=3 r=0.0 ok=true s="compare list times: 3" errors=0 n=5 res=[5,12,30,8,25] cache=0 hits=0
test: list=4,15,40,10,35 factor=3
expect: => i=2 r=0.0 ok=true s="compare list times: 2" errors=0 n=5 res=[4,15,40,10,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 2 || f <= 0 { return out; }
	var spikes = 0;
	for i in g.n - 1 {
		if g.res[i + 1] >= g.res[i] * f { spikes++; }
	}
	out.i = spikes;
	out.s.clear();
	format(out.s, "compare list times: ", spikes);
	out
}
@end
