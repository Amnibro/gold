kind: step
verb: scan
noun: sequence
modifier: all
context: loop
phrase: scan sequence inspecting all items relative to target {target}
phrase: evaluate all sequence values against target reference {target}
slot: target int
test: list=10,25,30,45 target=28
expect: => i=30 r=0.0 ok=true s="closest val: 30" errors=0 n=4 res=[10,25,30,45] cache=0 hits=0
test: list=5,12,18 target=11
expect: => i=12 r=0.0 ok=true s="closest val: 12" errors=0 n=3 res=[5,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	if g.n == 0 { return out; }
	var best_diff = 1000000;
	var best_val = g.res[0];
	for i in g.n {
		var diff = g.res[i] - t;
		if diff < 0 { diff = -diff; }
		if diff < best_diff {
			best_diff = diff;
			best_val = g.res[i];
		}
	}
	out.i = best_val;
	out.s.clear();
	format(out.s, "closest val: ", best_val);
	out
}
@end
