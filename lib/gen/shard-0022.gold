noun: loop
modifier: last
context: core
phrase: shift loop last {k} elements cyclically
phrase: rotate loop last {k} results by single position
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="shifted last: 3" errors=0 n=5 res=[1,2,5,3,4] cache=0 hits=0
