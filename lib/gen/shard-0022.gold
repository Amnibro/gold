expect: => i=2 r=0.0 ok=true s="limit digits with_cache: 2" errors=0 n=4 res=[150,75,150,12] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_val};
	if cap <= 0 { return out; }
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		let cv, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cv;
		} else {
			var nx = x;
			if nx > cap { nx = cap; clamped++; }
			else if nx < -cap { nx = -cap; clamped++; }
			gold_cache_put(g, x, nx);
			g.res[i] = nx;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "limit digits with_cache: ", clamped);
	out
}
@end
