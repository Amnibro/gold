code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_tally};
	if cap <= 0 {
		gold_fail(g, "tally limit must be positive");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		var j = 0;
		while j < kept {
			if g.res[j] == x { freq++; }
			j++;
		}
		if freq < cap {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected items under tally: ", kept);
	out
}
@end
