@entry 2a4401e0adc13dbb
kind: step
verb: retry
noun: maximum
modifier: while
context: sort
slot: cap int
phrase: retry maximum while above cap {cap}
phrase: reduce maximum element while exceeding ceiling {cap}
test: list=5,2,16,1 cap=10
expect: => i=8 r=0.0 ok=true s="reduced maximum: 8" errors=0 n=4 res=[1,2,5,8] cache=0 hits=0
test: list=3,64,8 cap=15
expect: => i=8 r=0.0 ok=true s="reduced maximum: 8" errors=0 n=3 res=[3,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	while g.n > 0 && g.res[g.n - 1] > limit {
		g.res[g.n - 1] /= 2;
		var k = g.n - 1;
		while k > 0 && g.res[k] < g.res[k - 1] {
			let tmp = g.res[k];
			g.res[k] = g.res[k - 1];
			g.res[k - 1] = tmp;
			k--;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "reduced maximum: ", out.i);
	out
}
@end
