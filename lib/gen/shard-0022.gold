fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var digits int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = 0;
	var i = len - 2;
	while i >= 0 {
		res = res * 10 + digits[i];
		i--;
	}
	res = res * 10 + digits[len - 1];
	res
}
@end
