slot: cap int
test: list=10,20 cap=15
expect: => i=1 r=0.0 ok=true s="clamped cache entries count: 1" errors=0 n=2 res=[10,20] cache=2 hits=0
test: list=5,30 cap=20
expect: => i=1 r=0.0 ok=true s="clamped cache entries count: 1" errors=0 n=2 res=[5,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] > limit {
			g.cv[i] = limit;
			clamped++;
		}
	}
	g.steps += g.cn;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped cache entries count: ", clamped);
	out
}
@end
