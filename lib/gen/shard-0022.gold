context: search
phrase: rank minimum candidate score while remaining above {threshold}
phrase: evaluate minimum search rank while exceeding level {threshold}
slot: threshold int
test: list=45,28,60,19,55 threshold=20
expect: => i=2 r=0.0 ok=true s="rank minimum: 2" errors=0 n=5 res=[45,28,60,19,55] cache=0 hits=0
test: list=80,75,90,85 threshold=70
expect: => i=1 r=0.0 ok=true s="rank minimum: 1" errors=0 n=4 res=[80,75,90,85] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var min_val = 1000000;
	var found = false;
	for i in g.n {
		if g.res[i] >= th && g.res[i] < min_val {
			min_val = g.res[i];
			found = true;
		}
	}
	if !found { out.i = 0; return out; }
	var rank = 1;
	for i in g.n {
		if g.res[i] < min_val { rank++; }
	}
	out.i = rank;
	out.s.clear();
	format(out.s, "rank minimum: ", rank);
	out
}
@end
@entry 7adabc852555f4f6
kind: step
verb: dedupe
noun: memo
modifier: times
context: search
phrase: dedupe search results scaling memo frequencies {multiplier}
phrase: prune candidate duplicates tracking memo counts times {multiplier}
slot: multiplier int
test: list=5,8,5,12,8,5 multiplier=2
expect: => i=3 r=0.0 ok=true s="dedupe memo times: 3" errors=0 n=3 res=[5,8,12] cache=3 hits=0
test: list=20,30,20,40 multiplier=3
expect: => i=3 r=0.0 ok=true s="dedupe memo times: 3" errors=0 n=3 res=[20,30,40] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var unique = [0; 512];
	var un = 0;
	var counts = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in un {
			if unique[j] == x { counts[j]++; found = true; break; }
		}
		if !found { unique[un] = x; counts[un] = 1; un++; }
	}
	g.n = 0;
	for i in un {
		gold_push(g, unique[i]);
		gold_cache_put(g, unique[i], counts[i] * m);
	}
	out.i = un;
	out.s.clear();
	format(out.s, "dedupe memo times: ", un);
	out
}
@end
