phrase: retry gaps in_reverse widening intervals to {min_gap}
phrase: enforce minimum gaps in_reverse with separation {min_gap}
test: list=10,9,5 min_gap=3
expect: => i=4 r=0.0 ok=true s="adjusted descending gaps" errors=0 n=3 res=[10,7,4] cache=0 hits=0
test: list=20,18,12 min_gap=4
expect: => i=12 r=0.0 ok=true s="adjusted descending gaps" errors=0 n=3 res=[20,16,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var k = 1;
	while k < g.n {
		if g.res[k - 1] - g.res[k] < gap {
			g.res[k] = g.res[k - 1] - gap;
		}
		k++;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "adjusted descending gaps");
	out
}
@end
