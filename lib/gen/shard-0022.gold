context: core
phrase: limit tail in_reverse count {k} ceiling {cap}
phrase: clamp tail in_reverse trailing items {k} to {cap}
slot: k int
slot: cap int
test: list=5,15,25,35 k=2 cap=20
expect: => i=2 r=0.0 ok=true s="tail clamped: 2" errors=0 n=4 res=[5,15,20,20] cache=0 hits=0
test: list=10,12,30,40,50 k=3 cap=25
expect: => i=3 r=0.0 ok=true s="tail clamped: 3" errors=0 n=5 res=[10,12,25,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	let cap = ${cap};
	var clamped = 0;
	for step in k {
		let idx = g.n - 1 - step;
		if g.res[idx] > cap {
			g.res[idx] = cap;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "tail clamped: ", clamped);
	out
}
@end
@entry 2df6cc770acab199
kind: step
verb: apply
noun: duplicates
modifier: recursively
context: core
phrase: apply duplicates recursively collapsing adjacent matches
phrase: reduce duplicates recursively repeating adjacent values
test: list=1,2,2,1,3
expect: => i=4 r=0.0 ok=true s="collapsed size: 4" errors=0 n=4 res=[1,2,1,3] cache=0 hits=0
test: list=4,4,4,5
expect: => i=2 r=0.0 ok=true s="collapsed size: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = true;
	while changed && g.n > 1 {
		changed = false;
		for i in g.n - 1 {
			if g.res[i] == g.res[i + 1] {
				var j = i + 1;
				while j + 1 < g.n {
					g.res[j] = g.res[j + 1];
					j++;
				}
				g.n--;
				changed = true;
				break;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "collapsed size: ", g.n);
	out
}
@end
