code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = ${k};
	if start < 0 { start = 0; }
	if start >= g.n { return out; }
	var swaps = 0;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
				swaps++;
			}
		}
	}
	g.steps += (g.n - start) * (g.n - start);
	out.i = swaps;
	out.s.clear();
	format(out.s, "suffix running swaps: ", swaps);
	out
}
@end
