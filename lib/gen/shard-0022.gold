fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_freq = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	out.i = max_freq;
	out.s.clear();
	format(out.s, "ranked all histogram");
	out
}
