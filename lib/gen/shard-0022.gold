slot: span int
test: list=4,1,3,2,5 span=3
expect: => i=3 r=0.0 ok=true s="merged windows: 3" errors=0 n=3 res=[8,2,5] cache=0 hits=0
test: list=9,7,5,3,1 span=2
expect: => i=3 r=0.0 ok=true s="merged windows: 3" errors=0 n=3 res=[16,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 1 || g.n < w { return out; }
	var new_n = 0;
	var i = 0;
	while i + w <= g.n {
		var sm = 0;
		for k in w { sm += g.res[i + k]; }
		g.res[new_n] = sm;
		new_n++;
		i += w;
	}
	while i < g.n {
		g.res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged windows: ", new_n);
	out
}
@end
