fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inversions = 0;
	for i in (g.n - 1) {
		let d1 = core_digit_sum(g.res[i]);
		let d2 = core_digit_sum(g.res[i + 1]);
		if d1 > d2 { inversions++; }
	}
	if inversions > 0 {
		for a in g.n {
			for b in (a + 1)..g.n {
				if g.res[a] > g.res[b] {
					let t = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = t;
				}
			}
		}
	}
	g.steps += g.n * 2;
	out.i = inversions;
	out.s.clear();
	format(out.s, "pairwise digit inversions: ", inversions);
	out
}
