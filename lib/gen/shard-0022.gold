@entry b4166384de02d4a5
kind: step
verb: collect
noun: middle
modifier: sorted
context: core
phrase: collect middle sorted segment length {k}
phrase: gather middle sorted elements bounded by {k}
slot: k int
test: list=9,2,7,4,5,1,8 k=3
expect: => i=3 r=0.0 ok=true s="collected middle: 3" errors=0 n=3 res=[4,5,7] cache=0 hits=0
test: list=12,5,1,19,8,3 k=4
expect: => i=4 r=0.0 ok=true s="collected middle: 4" errors=0 n=4 res=[1,5,8,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k <= 0 { return out; }
	let start = (g.n - k) / 2;
	var mid = [0; 512];
	for i in k { mid[i] = g.res[start + i]; }
	for i in k {
		for j in k - 1 {
			if mid[j] > mid[j + 1] {
				let tmp = mid[j];
				mid[j] = mid[j + 1];
				mid[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for i in k { gold_push(g, mid[i]); }
	out.i = k;
	out.s.clear();
	format(out.s, "collected middle: ", k);
	out
}
@end
