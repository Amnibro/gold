fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${w} <= 0.0 || ${l} <= 0.0 {
		gold_fail(g, "dimensions must be positive");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	gold_dnew(g, "platform", o);
	o.append(" box ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${z});
	o.append(" ");
	gold_fnum(o, ${w});
	o.append(",");
	gold_fnum(o, ${l});
	o.append(",");
	gold_fnum(o, 0.2);
	o.append(" m:emissive");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "platform");
	out
}
@end
