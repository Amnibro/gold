expect: => i=1 r=0.0 ok=true s="pair diffs: [4]" errors=0 n=3 res=[5,9,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let threshold = ${th};
	var out = v;
	out.s.clear();
	format(out.s, "pair diffs: [");
	var count = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			let d1 = g.res[i];
			let d0 = g.res[i - 1];
			let diff = if d1 > d0 { d1 - d0 } else { d0 - d1 };
			if diff <= threshold {
				if count > 0 { format(out.s, ", "); }
				format(out.s, diff);
				count++;
			}
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
