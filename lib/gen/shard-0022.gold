expect: => i=1 r=0.0 ok=true s="first run length: 1" errors=0 n=4 res=[2,5,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rmin = ${min_run};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var rlen = 0;
	if g.n > 0 {
		let first_val = g.res[0];
		while rlen < g.n && g.res[rlen] == first_val {
			rlen++;
		}
		if rlen >= rmin {
			for k in rlen {
				g.res[k] += 1;
			}
		}
	}
	g.steps += g.n;
	out.i = rlen;
	out.s.clear();
	format(out.s, "first run length: ", rlen);
	out
}
@end
