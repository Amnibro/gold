test: list=10,20,30,40,50,60 stride=2
expect: => i=6 r=0.0 ok=true s="reverse swapped: 6" errors=0 n=6 res=[30,20,10,60,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	if g.n > s {
		var i = g.n - 1;
		while i >= s {
			let tmp = g.res[i];
			g.res[i] = g.res[i - s];
			g.res[i - s] = tmp;
			if i >= s + 1 { i -= (s + 1); } else { break; }
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse swapped: ", out.i);
	out
}
@end
