fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_score};
	if g.n == 0 {
		gold_fail(g, "no search values to validate");
		out.ok = false;
		return out;
	}
	var invalid_count = 0;
	for k in g.n {
		if g.res[k] < ms {
			invalid_count++;
			gold_fail(g, "search value below threshold");
		}
	}
	g.steps += g.n;
	out.i = g.n - invalid_count;
	out.ok = (invalid_count == 0);
	out.s.clear();
	format(out.s, "valid search values: ", out.i);
	out
}
@end
@entry 5eb1e950a4cbd2a2
kind: step
verb: rotate
noun: values
modifier: times
context: search
phrase: rotate search values right times {times}
phrase: cyclically shift search results count times {times}
slot: times int
test: list=10,20,30,40 times=1
expect: => i=1 r=0.0 ok=true s="rotated search values: 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 times=2
expect: => i=2 r=0.0 ok=true s="rotated search values: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n <= 1 || t <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no rotation needed");
		return out;
	}
	let shift = t % g.n;
	var temp = [0; 512];
	for k in g.n {
		let dest = (k + shift) % g.n;
		temp[dest] = g.res[k];
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated search values: ", shift);
	out
}
@end
