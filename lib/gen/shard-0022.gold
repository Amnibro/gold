expect: => i=4 r=0.0 ok=true s="collect window last: 4" errors=0 n=4 res=[35,45,55,65] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${k} < g.n { ${k} } else { g.n };
	if k <= 0 { return out; }
	let start = g.n - k;
	var win = [0; 512];
	for i in k { win[i] = g.res[start + i]; }
	g.n = 0;
	for i in k { gold_push(g, win[i]); }
	out.i = k;
	out.s.clear();
	format(out.s, "collect window last: ", k);
	out
}
@end
