fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l < 0 || h >= g.n || l > h {
		gold_fail(g, "search steps between range invalid");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = l;
	while i <= h {
		total += g.res[i];
		i++;
	}
	gold_push(g, total);
	g.steps += (h - l + 1);
	out.i = total;
	out.s.clear();
	format(out.s, "joined search steps: ", total);
	out
}
@end
