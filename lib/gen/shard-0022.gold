code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let v, ok = gold_cache_get(g, g.res[i]);
		if ok {
			g.res[i] = v;
		} else {
			let r = core_reverse_digits(g.res[i]);
			gold_cache_put(g, g.res[i], r);
			g.res[i] = r;
		}
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed digits sorted: ", g.n);
	out
}
@end
