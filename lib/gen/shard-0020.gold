phrase: rotate values up to maximum digit {limit}
phrase: rotate right until lowest digit under {limit}
test: arg=9871,6543 limit=4
expect: 9871
expect: 6543
test: arg=8792,5431 limit=3
expect: 8792
expect: 5431
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var d int[..16] = [];
	while x > 0 { d.push(x % 10); x /= 10; }
	let len = d.len;
	if len == 0 { return 0; }
	var rot = 0;
	while rot < len && d[0] > lim {
		let first = d[0];
		for i in len - 1 { d[i] = d[i + 1]; }
		d[len - 1] = first;
		rot++;
	}
	var res = 0;
	for i in len { res = res * 10 + d[len - 1 - i]; }
	res
}
@end
