fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let d = ${delta};
	var count = 0;
	for i in g.n {
		if g.res[i] >= th {
			g.res[i] += d;
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted numbers at least threshold: ", count);
	out
}
