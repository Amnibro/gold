@entry 10f02f4a640cf729
kind: step
verb: dedupe
noun: primes
modifier: first
context: retry
slot: max_p int
phrase: dedupe leading prime elements up to {max_p}
phrase: retain first unique primes below {max_p}
test: list=2,3,2,5,7,3 max_p=10
expect: => i=4 r=0.0 ok=true s="deduped primes count 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8 max_p=10
expect: => i=0 r=0.0 ok=true s="deduped primes count 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_p};
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		var is_p = x >= 2 && x <= mp;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			var seen = false;
			for i in w {
				if g.res[i] == x { seen = true; break; }
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped primes count ", w);
	out
}
@end
