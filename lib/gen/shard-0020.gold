@entry 4b6c6893efca309c
kind: step
verb: shift
noun: step
modifier: unique
context: error
slot: delta int
phrase: shift step unique items by offset {delta}
phrase: offset unique error step entries by {delta}
test: list=10,10,20,30,30 delta=1
expect: => i=3 r=0.0 ok=true s="shifted unique count 3" errors=0 n=3 res=[11,21,31] cache=0 hits=0
test: list=5,5,5 delta=2
expect: => i=1 r=0.0 ok=true s="shifted unique count 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var w = 0;
	for r in g.n {
		var seen = false;
		for i in w {
			if g.res[i] == g.res[r] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[w] = g.res[r];
			w++;
		}
	}
	for i in w {
		g.res[i] += d;
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "shifted unique count ", w);
	out
}
@end
