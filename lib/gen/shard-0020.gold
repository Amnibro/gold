code:
fn ${ID}(n int) bool {
	let mr = ${min_run};
	var x = if n < 0 { -n } else { n };
	var prev = -1;
	var run = 0;
	var max_run = 0;
	while x > 0 {
		let d = x % 10;
		if d == prev {
			run++;
		} else {
			if run > max_run { max_run = run; }
			run = 1;
			prev = d;
		}
		x /= 10;
	}
	if run > max_run { max_run = run; }
	max_run >= mr
}
@end
