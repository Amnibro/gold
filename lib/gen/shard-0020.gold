expect: => i=2 r=0.0 ok=true s="shifted words with retry 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let shifts = if g.n < cnt { g.n } else { cnt };
	if shifts > 0 && g.n > 1 {
		for s in shifts {
			let first = g.res[0];
			for k in g.n - 1 {
				g.res[k] = g.res[k + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted words with retry ", shifts);
	out
}
@end
