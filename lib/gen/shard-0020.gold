phrase: exchange minimum with maximum positions in stats sequence
test: list=10,50,20,5,30
expect: => i=5 r=0.0 ok=true s="swapped sequence extrema values" errors=0 n=5 res=[10,5,20,50,30] cache=0 hits=0
