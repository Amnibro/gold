code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = 1.0 - g.img[k]; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4.0 as real)) as! int;
		if t > 3 { t = 3; }
		g.img[k] = (t as real) / ((3.0) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "rust");
	out
}
@end
