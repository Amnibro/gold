@entry f9c549747f414933
kind: step
verb: merge
noun: suffix
modifier: each
context: list
slot: start int
phrase: merge suffix each item starting at index {start} in list
phrase: combine each element of suffix from position {start} across list
test: list=10,20,30,40,50 start=2
expect: => i=120 r=0.0 ok=true s="merged suffix: 120" errors=0 n=5 res=[10,20,60,110,170] cache=0 hits=0
test: list=1,2,3,4,5,6 start=4
expect: => i=11 r=0.0 ok=true s="merged suffix: 11" errors=0 n=6 res=[1,2,3,4,10,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	if st >= 0 && st < g.n {
		var sum = 0;
		for i in g.n - st {
			let idx = st + i;
			sum += g.res[idx];
			g.res[idx] += sum;
		}
		g.steps += g.n - st;
		out.i = sum;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "merged suffix: ", out.i);
	out
}
@end
@entry dce99b5851d42613
kind: step
verb: keep
noun: items
modifier: last
context: list
slot: count int
phrase: keep items last count {count} in list
phrase: retain only final items last count {count} across list
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="kept last items count: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="kept last items count: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var start = g.n - c;
	if start < 0 { start = 0; }
	var m = 0;
	var i = start;
	while i < g.n {
		g.res[m] = g.res[i];
		m++;
		i++;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "kept last items count: ", m);
	out
}
@end
@entry d2c0d14ed8a82368
kind: step
verb: pair
noun: errors
modifier: up_to
context: list
slot: max_errs int
phrase: pair errors up to count {max_errs} in list
phrase: match negative error values up to limit {max_errs} across list
test: list=10,-2,-4,20,-6,-8 max_errs=2
expect: => i=2 r=0.0 ok=true s="paired error count: 2" errors=0 n=6 res=[10,-6,-6,20,-14,-14] cache=0 hits=0
test: list=-1,-3,-5,-7 max_errs=1
expect: => i=1 r=0.0 ok=true s="paired error count: 1" errors=0 n=4 res=[-4,-4,-5,-7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_errs};
	var err_cnt = 0;
	var pairs = 0;
	var last_idx = -1;
	for k in g.n {
		if g.res[k] < 0 && err_cnt < lim * 2 {
			err_cnt++;
			if last_idx < 0 {
				last_idx = k;
			} else {
				let sum = g.res[last_idx] + g.res[k];
				g.res[last_idx] = sum;
				g.res[k] = sum;
				pairs++;
				last_idx = -1;
			}
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired error count: ", pairs);
	out
}
@end
