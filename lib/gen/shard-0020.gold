fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let last_k = ${k};
	for i in g.n {
		var mn = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[mn] { mn = j; }
		}
		if mn != i {
			let tmp = g.res[i];
			g.res[i] = g.res[mn];
			g.res[mn] = tmp;
		}
	}
	let start = if g.n > last_k { g.n - last_k } else { 0 };
	let num_items = g.n - start;
	for i in num_items {
		g.res[i] = g.res[start + i];
	}
	g.n = num_items;
	g.steps += g.n;
	out.i = num_items;
	out.s.clear();
	format(out.s, "grouped last ", num_items, " values");
	out
}
@end
