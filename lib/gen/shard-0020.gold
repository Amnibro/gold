code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	let count = if g.n < cp { g.n } else { cp };
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " results up to cap");
	out
}
@end
