@entry 272ca66a755c5ce6
kind: step
verb: repeat
noun: duplicates
modifier: safely
context: format
slot: max_rep int
phrase: repeat duplicates safely capping maximum occurrences {max_rep}
phrase: format duplicate items repeated safely up to {max_rep}
phrase: render safe duplicate repetitions bounded by {max_rep}
test: list=2,5,2,7,5,5 max_rep=2
expect: => i=4 r=0.0 ok=true s="safe duplicates: [2, 2, 5, 5]" errors=0 n=6 res=[2,5,2,7,5,5] cache=0 hits=0
test: list=9,9,9,3 max_rep=3
expect: => i=3 r=0.0 ok=true s="safe duplicates: [9, 9, 9]" errors=0 n=4 res=[9,9,9,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_rep};
	var dups int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if seen_before {
			var already_added = false;
			for d in dups {
				if d == x { already_added = true; break; }
			}
			if !already_added { dups.push(x); }
		}
	}
	out.s.clear();
	format(out.s, "safe duplicates: [");
	var count = 0;
	for d in dups {
		for r in cap {
			if count > 0 { format(out.s, ", "); }
			format(out.s, d);
			count++;
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
