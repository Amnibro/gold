fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var dups = 0;
	for i in g.n {
		if g.res[i] > th {
			for j in g.n {
				if i < j && g.res[i] == g.res[j] { dups++; }
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicates traced: ", dups);
	out
}
@end
