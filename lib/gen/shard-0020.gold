	if count < g.n {
		let start = g.n - count;
		for j in count {
			g.res[j] = g.res[start + j];
		}
		g.n = count;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retained tail of ", g.n, " items");
	out
}
