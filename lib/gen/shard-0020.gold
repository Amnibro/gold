noun: head
modifier: sorted
context: list
phrase: merge head value {head_val} into sorted digits
phrase: insert head value {head_val} into sorted sequence
slot: head_val int
test: arg=135,28 head_val=4
expect: 1345
expect: 248
test: arg=951 head_val=0
expect: 159
code:
fn ${ID}(n int) int {
	let h = ${head_val};
	var x = if n < 0 { -n } else { n };
	var d int[>..] = [];
	d.push(h);
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	sort(d[..]);
	var res = 0;
	for v in d {
		res = res * 10 + v;
	}
	res
}
@end
@entry 31df63e47a76849c
kind: pred
verb: check
noun: series
modifier: at_least
context: list
phrase: check sequence length is at least {min_len}
phrase: verify digit series has at least {min_len} elements
slot: min_len int
test: arg=12345,12 min_len=4
expect: true
expect: false
test: arg=99 min_len=3
expect: false
code:
fn ${ID}(n int) bool {
	let m = ${min_len};
	var x = if n < 0 { -n } else { n };
	var count = 0;
	if x == 0 { count = 1; }
	while x > 0 {
		count++;
		x /= 10;
	}
	count >= m
}
@end
