phrase: split sorted items while remaining budget positive
phrase: partition items while budget {budget} lasts
slot: budget int
test: list=6,2,3,9 budget=10
expect: => i=2 r=0.0 ok=true s="split items within budget" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=7,5,1 budget=4
expect: => i=1 r=0.0 ok=true s="split items within budget" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	for i in g.n {
		var low = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[low] { low = j; }
		}
		if low != i {
			let sw = g.res[i];
			g.res[i] = g.res[low];
			g.res[low] = sw;
		}
	}
	var keep = 0;
	while keep < g.n && rem >= g.res[keep] {
		rem -= g.res[keep];
		keep++;
	}
	g.n = keep;
	g.steps += g.n;
	out.i = keep;
	out.s.clear();
	format(out.s, "split items within budget");
	out
}
@end
