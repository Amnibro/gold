expect: => i=3 r=0.0 ok=true s="grouped total first" errors=0 n=5 res=[1,5,9,8,4] cache=0 hits=0
test: count=2 list=12,3,7
expect: => i=2 r=0.0 ok=true s="grouped total first" errors=0 n=3 res=[3,12,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: group total first
	var out = v;
	let k = ${count};
	let bound = if k > g.n { g.n } else { k };
	if bound > 1 {
		for i in bound {
			for j in bound - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = bound;
	out.s.clear();
	format(out.s, "grouped total first");
	out
}
@end
