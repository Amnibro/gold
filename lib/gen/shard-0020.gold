@entry 4fe12c3d36fe303e
kind: step
verb: reverse
noun: odds
modifier: times
context: loop
phrase: reverse odd numbers {count} times across list
phrase: invert odd results in loop {count} times
slot: count int
test: list=1,2,3,4,5 count=1
expect: => i=1 r=0.0 ok=true s="reversed odds times" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=9,8,7,6 count=2
expect: => i=2 r=0.0 ok=true s="reversed odds times" errors=0 n=4 res=[9,8,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c % 2 == 1 {
		var odd_idx int[64];
		var on = 0;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				odd_idx[on] = i;
				on++;
			}
		}
		var l = 0;
		var r = on - 1;
		while l < r {
			let tmp = g.res[odd_idx[l]];
			g.res[odd_idx[l]] = g.res[odd_idx[r]];
			g.res[odd_idx[r]] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n + 1;
	out.i = c;
	out.s.clear();
	format(out.s, "reversed odds times");
	out
}
@end
@entry a95ce5c6a0c8273a
