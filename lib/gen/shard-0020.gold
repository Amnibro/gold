@entry 20ed2d73d5c77a3f
kind: fn
verb: group
noun: odds
modifier: recursively
context: transform
phrase: group odds recursively sum digits
phrase: reduce odd digits recursively to total
test: arg=13579,2468
expect: 7
expect: 0
test: arg=12345,97
expect: 9
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	while x > 0 {
		let d = x % 10;
		if d % 2 != 0 { sum += d; }
		x /= 10;
	}
	while sum >= 10 {
		var s2 = 0;
		var temp = sum;
		while temp > 0 {
			s2 += temp % 10;
			temp /= 10;
		}
		sum = s2;
	}
	sum
}
@end
@entry 0f0cf871845e7460
kind: step
verb: reverse
noun: threshold
modifier: all
context: list
slot: threshold int
phrase: reverse threshold all qualifying entries above {threshold} in list
phrase: invert order of all elements exceeding threshold {threshold}
test: list=10,2,30,4,50 threshold=5
expect: => i=3 r=0.0 ok=true s="reversed threshold entries: 3" errors=0 n=5 res=[50,2,30,4,10] cache=0 hits=0
test: list=1,100,2,200,3,300 threshold=50
expect: => i=3 r=0.0 ok=true s="reversed threshold entries: 3" errors=0 n=6 res=[1,300,2,200,3,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var idxs = [0; 512];
	var count = 0;
	for k in g.n {
		if g.res[k] > th {
			idxs[count] = k;
			count++;
		}
	}
	var i = 0;
	var j = count - 1;
	while i < j {
		let p1 = idxs[i];
		let p2 = idxs[j];
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		i++;
		j--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed threshold entries: ", count);
	out
}
@end
@entry 47a8925679b25c1c
kind: step
