fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in 0 .. g.n {
		g.res[i] += 1;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "trace_function_in_place: ", total);
	out
}
