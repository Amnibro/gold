@entry 2fde25d26828c933
kind: step
verb: group
noun: number
modifier: safely
context: sort
phrase: group number safely into buckets of size {bucket_size}
phrase: partition into buckets safely with size {bucket_size}
slot: bucket_size int
test: list=12,3,7,18,5 bucket_size=10
expect: => i=2 r=0.0 ok=true s="grouped into 2 buckets" errors=0 n=2 res=[3,2] cache=0 hits=0
test: list=1,2,3 bucket_size=5
expect: => i=1 r=0.0 ok=true s="grouped into 1 buckets" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${bucket_size};
	if bsz <= 0 {
		gold_fail(g, "invalid bucket size");
		out.ok = false;
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var b_count = 0;
	var idx = 0;
	while idx < g.n {
		let cur_bucket = g.res[idx] / bsz;
		var cnt = 0;
		while idx < g.n && (g.res[idx] / bsz) == cur_bucket {
			cnt++;
			idx++;
		}
		g.res[b_count] = cnt;
		b_count++;
	}
	g.steps += g.n * g.n;
	g.n = b_count;
	out.i = b_count;
	out.s.clear();
	format(out.s, "grouped into ", b_count, " buckets");
	out
}
@end
