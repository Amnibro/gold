noun: spaces
modifier: nested
context: format
phrase: clamp nested spaces {n}
phrase: clamp nested indentation to {n}
slot: n int
test: n=4
expect: => i=4 r=0.0 ok=true s="nested" errors=0 n=0 res=[] cache=0 hits=0
test: n=12
expect: => i=8 r=0.0 ok=true s="nested" errors=0 n=0 res=[] cache=0 hits=0
test: n=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 0 {
		gold_fail(g, "spaces must be non-negative");
		out.ok = false;
		return out;
	}
	var limit = ${n};
	if limit > 8 {
		limit = 8;
	}
	var o byte[>..] = [];
	for i in limit {
		o.push(' ');
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "nested");
	out
}
@end
@entry be482d54af9154b7
kind: step
verb: repeat
noun: counter
modifier: at_least
context: format
phrase: repeat counter {n} at least {min} times
phrase: format counter {n} repeated at least {min} times
slot: n int
slot: min int
test: n=5 min=3
expect: => i=5 r=0.0 ok=true s="at_least" errors=0 n=0 res=[] cache=0 hits=0
test: n=2 min=4
expect: => i=4 r=0.0 ok=true s="at_least" errors=0 n=0 res=[] cache=0 hits=0
test: n=2 min=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${min} < 1 {
		gold_fail(g, "min count must be positive");
		out.ok = false;
		return out;
	}
	var reps = ${n};
	if reps < ${min} {
		reps = ${min};
	}
	if reps > 64 {
		reps = 64;
	}
	var total = 0;
	var buf byte[>..] = [];
	for i in reps {
		format(buf, i, " ");
		total++;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "at_least");
	out
}
@end
