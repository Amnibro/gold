@entry 3c35053567b7949c
kind: step
verb: apply
noun: histogram
modifier: safely
context: sort
phrase: apply histogram safely scaling by factor {factor}
phrase: scale frequency histogram safely with multiplier {factor}
slot: factor int
test: list=2,2,3 factor=3
expect: => i=2 r=0.0 ok=true s="applied scaled histogram across 2 bins" errors=0 n=2 res=[6,3] cache=0 hits=0
test: list=7,7,7 factor=2
expect: => i=1 r=0.0 ok=true s="applied scaled histogram across 1 bins" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		var min_pos = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_pos] { min_pos = j; }
		}
		if min_pos != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_pos];
			g.res[min_pos] = tmp;
		}
	}
	var bins = 0;
	var pos = 0;
	while pos < g.n {
		var tally = 1;
		while pos + 1 < g.n && g.res[pos + 1] == g.res[pos] {
			tally++;
			pos++;
		}
		g.res[bins] = tally * mult;
		bins++;
		pos++;
	}
	g.steps += g.n * g.n;
	g.n = bins;
	out.i = bins;
	out.s.clear();
	format(out.s, "applied scaled histogram across ", bins, " bins");
	out
}
@end
