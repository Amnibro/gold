kind: step
verb: split
noun: prefix
modifier: last
context: aggregate
phrase: split prefix last rotating by {shift} places
phrase: cycle first {shift} elements to tail of list
slot: shift int
test: shift=2 list=1,2,3,4,5
expect: => i=2 r=0.0 ok=true s="split prefix last" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: shift=1 list=10,20,30
expect: => i=1 r=0.0 ok=true s="split prefix last" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: split prefix last
	var out = v;
	let k = ${shift};
	if g.n > 0 && k > 0 && k < g.n {
		var temp int[256];
		for i in k {
			temp[i] = g.res[i];
		}
		for i in (g.n - k) {
			g.res[i] = g.res[i + k];
		}
		for i in k {
			g.res[g.n - k + i] = temp[i];
		}
		out.i = k;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "split prefix last");
	out
}
@end
