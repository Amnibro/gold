@entry 0314c75d26dcf548
kind: step
verb: split
noun: gaps
modifier: first
context: error
slot: gap_min int
phrase: split gaps first exceeding size {gap_min}
phrase: partition error stream at gaps first {gap_min}
test: list=10,12,30,32 gap_min=10
expect: => i=2 r=0.0 ok=true s="split at first gap index 2" errors=0 n=4 res=[10,12,30,32] cache=0 hits=0
test: list=1,2,3,4 gap_min=5
expect: => i=-1 r=0.0 ok=true s="no gap exceeding threshold" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gm = ${gap_min};
	var split_idx = -1;
	if g.n > 1 {
		for k in g.n - 1 {
			let diff = if g.res[k + 1] >= g.res[k] { g.res[k + 1] - g.res[k] } else { g.res[k] - g.res[k + 1] };
			if diff >= gm {
				split_idx = k + 1;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = split_idx;
	out.s.clear();
	if split_idx >= 0 {
		format(out.s, "split at first gap index ", split_idx);
	} else {
		format(out.s, "no gap exceeding threshold");
	}
	out
}
@end
