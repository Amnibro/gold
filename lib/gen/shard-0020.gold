@entry 3a0057d9c96d299b
kind: step
verb: map
noun: digits
modifier: recursively
context: stats
phrase: stats map digits recursively for each observation
phrase: reduce sample values to recursive digit sums
test: list=456,789,123
expect: => i=18 r=0.0 ok=true s="mapped recursive digit roots sum: 18" errors=0 n=3 res=[6,6,6] cache=0 hits=0
test: list=99,1024,5
expect: => i=21 r=0.0 ok=true s="mapped recursive digit roots sum: 21" errors=0 n=3 res=[9,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x >= 10 {
			var s = 0;
			var t = x;
			while t > 0 { s += t % 10; t /= 10; }
			x = s;
		}
		g.res[i] = x;
		total += x;
	}
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped recursive digit roots sum: ", total);
	out
}
@end
@entry d9ca03a356a0381c
kind: step
verb: swap
noun: history
modifier: recursively
context: stats
phrase: stats swap history recursively across pairs
phrase: pairwise exchange sample history elements recursively
test: list=10,20,30,40,50,60
expect: => i=3 r=0.0 ok=true s="swapped history element pairs: 3" errors=0 n=6 res=[20,10,40,30,60,50] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=2 r=0.0 ok=true s="swapped history element pairs: 2" errors=0 n=5 res=[2,1,4,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped history element pairs: ", swaps);
	out
}
@end
@entry 918f02d4dc85d641
kind: step
verb: swap
noun: duplicates
modifier: last
context: stats
phrase: stats swap duplicates last occurrence to end
phrase: move last duplicate sample value to terminal position
test: list=5,12,8,12,9,3
expect: => i=3 r=0.0 ok=true s="swapped last duplicate from index: 3" errors=0 n=6 res=[5,12,8,3,9,12] cache=0 hits=0
test: list=1,2,3,4,2,7
expect: => i=4 r=0.0 ok=true s="swapped last duplicate from index: 4" errors=0 n=6 res=[1,2,3,4,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_dup_idx = -1;
	if g.n > 1 {
		var i = g.n - 1;
		while i >= 0 {
			let x = g.res[i];
			var found = false;
			for j in i {
				if g.res[j] == x { found = true; break; }
			}
			if found { last_dup_idx = i; break; }
			i--;
		}
	}
	if last_dup_idx >= 0 && last_dup_idx < g.n - 1 {
		let tmp = g.res[last_dup_idx];
		g.res[last_dup_idx] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n * g.n + 1;
	out.i = last_dup_idx;
	out.s.clear();
	format(out.s, "swapped last duplicate from index: ", last_dup_idx);
	out
}
@end
@entry 6ce2b81620c8e748
kind: step
verb: reverse
noun: sequence
modifier: in_place
context: stats
phrase: stats reverse sequence in place across sample
phrase: invert stats observation sequence in place
test: list=10,20,30,40,50
expect: => i=5 r=0.0 ok=true s="reversed stats sequence in place: 5" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="reversed stats sequence in place: 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed stats sequence in place: ", g.n);
	out
}
@end
