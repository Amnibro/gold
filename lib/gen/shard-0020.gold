code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let lim = ${limit};
	var scaled = 0;
	for i in g.n {
		var nv = g.res[i] * f;
		if nv > lim { nv = lim; }
		g.res[i] = nv;
		scaled++;
	}
	g.steps += g.n + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled numbers up to limit: ", scaled);
	out
}
@end
