	if k > orig_n { k = orig_n; }
	var evens = 0;
	var i = orig_n - k;
	while i < orig_n {
		if g.res[i] % 2 == 0 {
			gold_push(g, g.res[i]);
			evens++;
		}
		i++;
	}
	g.steps += k + 1;
	out.i = evens;
	out.s.clear();
	format(out.s, "retried evens last");
	out
}
@end
