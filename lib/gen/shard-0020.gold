kind: step
verb: shift
noun: evens
modifier: with_cache
context: sort
phrase: shift even values to front with cache
phrase: reorder even numbers ahead using cache
test: list=5,2,8,1,4
expect: => i=3 r=0.0 ok=true s="shifted 3 even items" errors=0 n=5 res=[2,4,8,1,5] cache=1 hits=0
test: list=3,7,2
expect: => i=1 r=0.0 ok=true s="shifted 1 even items" errors=0 n=3 res=[2,3,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var m = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[m] { m = j; }
		}
		if m != i {
			let tmp = g.res[i];
			g.res[i] = g.res[m];
			g.res[m] = tmp;
		}
	}
	var ev_len = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			let val = g.res[k];
			var j = k;
			while j > ev_len {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[ev_len] = val;
			ev_len++;
		}
	}
	g.cn++;
	g.steps += g.n;
	out.i = ev_len;
	out.s.clear();
	format(out.s, "shifted ", ev_len, " even items");
	out
}
@end
@entry 94d4308fb85a8c86
kind: step
verb: apply
noun: prefix
modifier: in_reverse
context: sort
phrase: apply prefix reverse to sorted elements
phrase: invert first {k} elements after sorting
slot: k int
test: list=9,1,5,3 k=3
expect: => i=3 r=0.0 ok=true s="reversed prefix of 3 items" errors=0 n=4 res=[5,3,1,9] cache=0 hits=0
test: list=8,4,2 k=2
expect: => i=2 r=0.0 ok=true s="reversed prefix of 2 items" errors=0 n=3 res=[4,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cap = ${k};
	if cap > g.n { cap = g.n; }
	for i in g.n {
		var sm = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[sm] { sm = j; }
		}
		if sm != i {
			let swap_val = g.res[i];
			g.res[i] = g.res[sm];
			g.res[sm] = swap_val;
		}
	}
	var left = 0;
	var right = cap - 1;
	while left < right {
		let t = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = t;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = cap;
	out.s.clear();
	format(out.s, "reversed prefix of ", cap, " items");
	out
}
@end
