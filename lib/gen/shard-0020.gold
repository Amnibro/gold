@entry 628b40dcbf9b4781
kind: step
verb: rotate
noun: primes
modifier: every_other
context: filter
slot: offset int
phrase: rotate primes every_other alternate position {offset}
phrase: shift alternating prime values with offset {offset}
test: list=2,4,3,6,5,8,7 offset=10
expect: => i=4 r=0.0 ok=true s="shifted primes: 4" errors=0 n=7 res=[12,4,13,6,15,8,17] cache=0 hits=0
test: list=11,12,13,14,17,18 offset=5
expect: => i=3 r=0.0 ok=true s="shifted primes: 3" errors=0 n=6 res=[16,12,18,14,22,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var shifted = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[i] = x + off;
				shifted++;
			}
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted primes: ", shifted);
	out
}
@end
