kind: step
verb: search
noun: pairs
modifier: unique
context: search
phrase: search unique adjacent pairs in collection
phrase: find distinct neighboring pairs across search
test: list=2,2,4,4,6
expect: => i=4 r=0.0 ok=true s="search_pairs_unique: 4" errors=0 n=5 res=[2,2,4,4,6] cache=0 hits=0
test: list=1,3,1,3,5
expect: => i=3 r=0.0 ok=true s="search_pairs_unique: 3" errors=0 n=5 res=[1,3,1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var unique_pairs = 0;
	for i in 0 .. g.n - 1 {
		let a = g.res[i];
		let b = g.res[i + 1];
		var seen = false;
		for j in 0 .. i {
			if g.res[j] == a && g.res[j + 1] == b { seen = true; break; }
		}
		if !seen { unique_pairs++; }
	}
	g.steps += g.n;
	out.i = unique_pairs;
	out.s.clear();
	format(out.s, "search_pairs_unique: ", unique_pairs);
	out
}
@end
