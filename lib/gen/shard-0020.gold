code:
fn ${ID}(g Gold&, v Val) Val {
	// step: collect maximum sorted
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 - i {
				if g.res[j] < g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "collected maximum sorted");
	out
}
@end
