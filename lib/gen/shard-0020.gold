test: list=5,5,5,6
expect: => i=2 r=0.0 ok=true s="deduped count: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped count: ", kept);
	out
}
@end
