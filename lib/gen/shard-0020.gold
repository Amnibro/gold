@entry 6d2b57cfb06a7b48
kind: step
verb: measure
noun: range
modifier: each
context: list
phrase: measure range each item relative to list minimum
phrase: calculate range delta for each element across list
test: list=10,25,15,40
expect: => i=30 r=0.0 ok=true s="measured range spread: 30" errors=0 n=4 res=[0,15,5,30] cache=0 hits=0
test: list=5,8,12,6
expect: => i=7 r=0.0 ok=true s="measured range spread: 7" errors=0 n=4 res=[0,3,7,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		return out;
	}
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var max_delta = 0;
	for k in g.n {
		let d = g.res[k] - min_val;
		g.res[k] = d;
		if d > max_delta { max_delta = d; }
	}
	g.steps += g.n;
	out.i = max_delta;
	out.s.clear();
	format(out.s, "measured range spread: ", max_delta);
	out
}
@end
