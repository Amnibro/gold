modifier: with_retry
context: format
slot: limit int
phrase: trace values exceeding threshold with_retry fallback {limit}
phrase: format threshold trace computed with_retry pass {limit}
phrase: render threshold progression with fallback retry {limit}
test: list=10,25,5,40 limit=20
expect: => i=2 r=0.0 ok=true s="threshold trace (th=20): [25, 40]" errors=0 n=4 res=[10,25,5,40] cache=0 hits=0
test: list=10,8,6 limit=30
expect: => i=0 r=0.0 ok=true s="retry trace (th=15): []" errors=0 n=3 res=[10,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var th = ${limit};
	var matches int[>..] = [];
	for i in g.n {
		if g.res[i] >= th { matches.push(g.res[i]); }
	}
	var retried = false;
	if matches.len == 0 {
		retried = true;
		th = th / 2;
		for i in g.n {
			if g.res[i] >= th { matches.push(g.res[i]); }
		}
	}
	out.s.clear();
	if retried {
		format(out.s, "retry trace (th=", th, "): [");
	} else {
		format(out.s, "threshold trace (th=", th, "): [");
	}
	for i in matches.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, matches[i]);
	}
	format(out.s, "]");
	out.i = matches.len;
	g.steps += g.n;
	out
}
@end
