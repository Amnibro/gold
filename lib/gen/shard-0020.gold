noun: values
modifier: first
context: list
slot: count int
phrase: reverse values first prefix count {count} in list
phrase: invert initial element sequence first count {count}
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed first values count: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed first values count: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var lim = if c < g.n { c } else { g.n };
	if lim > 1 {
		var i = 0;
		var j = lim - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		g.steps += lim;
	}
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed first values count: ", lim);
	out
}
@end
