@entry 0f246a9a926dec9d
kind: fn
verb: cache
noun: digits
modifier: up_to
context: sort
phrase: cache digits up to {max_len}
phrase: count radix digits up to {max_len}
slot: max_len int
test: arg=7,1234 max_len=3
expect: 1
expect: 3
test: arg=45678 max_len=4
expect: 4
code:
fn ${ID}(n int) int {
	let mx = ${max_len};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var cnt = 0;
	while x > 0 && cnt < mx {
		cnt++;
		x /= 10;
	}
	cnt
}
@end
