	if x < 0 { x = -x; }
	var digits = [0; 16];
	var count = 0;
	while x > 0 && count < 16 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	if count <= 2 { return n; }
	let mid = count / 2;
	if count % 2 == 1 {
		digits[mid]
	} else {
		digits[mid] * 10 + digits[mid - 1]
	}
}
@end
