	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 || ${s} <= 0.0 {
		gold_fail(g, "parameters out of range");
		out.ok = false;
		return out;
	}
	for k in ${n} {
		let x = (k as real) * 3.0;
		o.clear();
		gold_dnews(g, "bushes", "", o);
		o.append(" sphere ");
		gold_fnum(o, x);
		o.append(",");
		o.append("0");
		o.append(",");
		gold_fnum(o, ${s});
		o.append(" r");
		gold_fnum(o, ${s});
		o.append(" m:matte ");
		gold_hex(o, 74, 117, 54);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "bushes");
	out
}
@end
