@entry 96ad45feb7862ec8
kind: step
verb: tone
noun: moss
modifier: smooth
context: texture
phrase: tone smooth moss texture with seed {u}
phrase: generate smooth moss procedural pattern using seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; brighten a=0.1; blur
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.339 max=0.945 sum8=46537 hash=382015
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.202 max=0.959 sum8=150243 hash=644316
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.1); }
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
