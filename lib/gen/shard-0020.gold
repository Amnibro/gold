expect: 30
code:
fn ${ID}(n int) int {
	let s = ${step};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return s; }
	var total_gap = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		let gap = if curr > prev { curr - prev } else { prev - curr };
		total_gap += gap * s;
		prev = curr;
		x /= 10;
	}
	total_gap
}
@end
