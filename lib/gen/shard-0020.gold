expect: => i=1 r=0.0 ok=true s="trace pairs matched: 1" errors=0 n=5 res=[1,2,3,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var matched = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] { matched++; }
		i++;
	}
	if matched == 0 && r > 0 && g.n > 0 {
		gold_push(g, g.res[0]);
		matched++;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "trace pairs matched: ", matched);
	out
}
@end
