fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= req {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += g.n * g.n + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "kept values matching frequency count: ", write);
	out
}
@end
