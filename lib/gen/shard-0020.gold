@entry 71fe22969142ae10
kind: fn
verb: reverse
noun: streak
modifier: in_reverse
context: core
phrase: reverse streak in reverse orientation
phrase: invert increasing prefix streak
test: arg=12395,1352
expect: 93215
expect: 5312
test: arg=987,12
expect: 987
expect: 21
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	var digits = [0; 16];
	var count = 0;
	while x > 0 && count < 16 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	// count is length, digits[count-1] is leading digit
	var k = count - 1;
	while k > 0 && digits[k] < digits[k - 1] {
		k--;
	}
	// reverse digits from count-1 down to k
	var i = count - 1;
	var j = k;
	while j < i {
		let tmp = digits[j];
		digits[j] = digits[i];
		digits[i] = tmp;
		j++;
		i--;
	}
	var out = 0;
	var idx = count - 1;
	while idx >= 0 {
		out = out * 10 + digits[idx];
		idx--;
	}
	out
}
@end
