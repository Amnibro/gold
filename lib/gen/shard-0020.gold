code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "rev squares: [");
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		let x = g.res[k];
		if x >= 0 {
			var root = 0;
			while root * root < x { root++; }
			if root * root == x {
				if count > 0 { format(out.s, ", "); }
				format(out.s, x);
				count++;
			}
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
