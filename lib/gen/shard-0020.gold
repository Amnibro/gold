code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last byte[>..] = [];
	if !gold_dlast(g, last) || ${deg} <= 0.0 {
		gold_fail(g, "no window or invalid angle");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	o.append(last);
	o.append(".rot anim ");
	o.append("0"); o.append(":"); o.append("0,"); o.append("0,0 ");
	o.append("1"); o.append(":"); gold_fnum(o, ${deg}); o.append(",0,0 loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "leanwin");
	out
}
@end
