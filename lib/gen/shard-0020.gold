expect: => i=0 r=0.0 ok=true s="shifted tail observations: 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	let sv = ${shift_val};
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 && g.res[idx] > cut {
		g.res[idx] += sv;
		count++;
		idx--;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted tail observations: ", count);
	out
}
@end
