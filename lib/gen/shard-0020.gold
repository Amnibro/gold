code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.25 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
