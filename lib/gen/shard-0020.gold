expect: => i=3 r=0.0 ok=true s="swapped sequence extrema values" errors=0 n=3 res=[3,15,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var min_i = 0;
		var max_i = 0;
		for i in g.n {
			if g.res[i] < g.res[min_i] { min_i = i; }
			if g.res[i] > g.res[max_i] { max_i = i; }
		}
		let tmp = g.res[min_i];
		g.res[min_i] = g.res[max_i];
		g.res[max_i] = tmp;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped sequence extrema values");
	out
}
@end
@entry 992cd1b4263fe5d3
kind: step
verb: swap
noun: cache
modifier: in_reverse
context: stats
phrase: stats swap cache elements in reverse symmetrical order
phrase: mirror stats sample values by reverse swapping
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="swapped reverse cache pairs: 2" errors=0 n=4 res=[40,30,20,10] cache=4 hits=0
test: list=1,3,5,7,9
expect: => i=2 r=0.0 ok=true s="swapped reverse cache pairs: 2" errors=0 n=5 res=[9,7,5,3,1] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	var swaps = 0;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		gold_cache_put(g, i, g.res[i]);
		gold_cache_put(g, j, g.res[j]);
		swaps++;
		i++;
		j--;
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped reverse cache pairs: ", swaps);
	out
}
@end
