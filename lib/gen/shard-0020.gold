fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t > 1 && g.n > 0 {
		let orig_n = g.n;
		for rep in t - 1 {
			for i in orig_n {
				gold_push(g, g.res[i]);
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "series repeated total: ", g.n);
	out
}
@end
@entry dfdb10c07d15691c
kind: step
verb: retry
noun: gaps
modifier: recursively
context: core
slot: max_gap int
phrase: retry gaps recursively under {max_gap}
phrase: fill sequence gaps recursively bounded by {max_gap}
test: list=1,10,25 max_gap=5
expect: => i=2 r=0.0 ok=true s="gaps adjusted: 2" errors=0 n=3 res=[1,6,11] cache=0 hits=0
test: list=2,4,6 max_gap=3
expect: => i=0 r=0.0 ok=true s="gaps adjusted: 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var adjusted = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > mg {
			g.res[i + 1] = g.res[i] + mg;
			adjusted++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "gaps adjusted: ", adjusted);
	out
}
@end
