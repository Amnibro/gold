test: list=3,10,20,50 factor=3
expect: => i=81 r=0.0 ok=true s="scaled limit: 81" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var lim = 10;
	if g.n > 0 { lim = g.res[0]; }
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim {
			g.res[kept] = x;
			kept++;
		}
	}
	for step in 3 {
		lim *= f;
	}
	g.n = kept;
	g.steps += kept + 3;
	out.i = lim;
	out.s.clear();
	format(out.s, "scaled limit: ", lim);
	out
}
@end
