@entry 67cc599fa4d4a019
kind: step
verb: drop
noun: step
modifier: pairwise
context: core
phrase: drop pairwise step values
phrase: discard consecutive step values
test: list=10,10,20,30,30,40
expect: => i=4 r=0.0 ok=true s="dropped 4 pairwise values" errors=0 n=2 res=[20,40] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="dropped 0 pairwise values" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.steps += g.n;
	let dropped = g.n - kept;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " pairwise values");
	out
}
@end
