@entry 7e2d581fd87edb3f
kind: step
verb: normalize
noun: minimum
modifier: nested
context: error
slot: floor int
phrase: normalize minimum nested error codes above {floor}
phrase: adjust nested minimum fault levels to {floor}
test: list=5,2,8,1,9 floor=4
expect: => i=2 r=0.0 ok=true s="normalized 2 nested minimum errors" errors=0 n=5 res=[5,4,8,4,9] cache=0 hits=0
test: list=10,20,30 floor=15
expect: => i=1 r=0.0 ok=true s="normalized 1 nested minimum errors" errors=0 n=3 res=[15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var adjusted = 0;
	for k in g.n {
		if g.res[k] < fl {
			g.res[k] = fl;
			adjusted++;
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "normalized ", adjusted, " nested minimum errors");
	out
}
@end
