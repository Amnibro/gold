noun: budget
modifier: until
context: stats
phrase: cache observations within budget limit {max_cost}
phrase: store values until cost exceeds budget {max_cost}
slot: max_cost int
test: list=10,20,30 max_cost=25
expect: => i=1 r=0.0 ok=true s="budget cached 1 items" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=50,60 max_cost=25
expect: => i=0 r=0.0 ok=true s="budget cached 0 items" errors=0 n=2 res=[50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_cost};
	var spent = 0;
	var cnt = 0;
	for i in g.n {
		if spent + g.res[i] <= mc {
			gold_cache_put(g, i, g.res[i]);
			spent += g.res[i];
			cnt++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "budget cached ", cnt, " items");
	out
}
@end
