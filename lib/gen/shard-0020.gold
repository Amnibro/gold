fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${window_size};
	var sum = 0;
	var count = 0;
	let limit = if ws < g.n { ws } else { g.n };
	for k in limit {
		sum += g.res[k];
		count++;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	g.steps += count;
	out.i = avg;
	out.s.clear();
	format(out.s, "traced average ", avg);
	out
}
@end
