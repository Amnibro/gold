code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "not enough points");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n - 2 {
		if i % 2 == 0 {
			let diff = g.res[i + 2] - g.res[i];
			sum += if diff < 0 { -diff } else { diff };
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "total alternate spacing ", sum);
	out
}
@end
