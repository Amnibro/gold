fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p_cnt++;
				g.res[k] *= p_cnt;
			}
		}
	}
	g.steps += g.n;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "nested primes scaled: ", p_cnt);
	out
}
