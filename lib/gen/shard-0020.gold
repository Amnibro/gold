test: list=5,1 mult=3
expect: => i=18 r=0.0 ok=true s="summed budget multiplied by factor" errors=0 n=1 res=[18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${mult};
	for i in g.n {
		var min_ix = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_ix] { min_ix = j; }
		}
		if min_ix != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_ix];
			g.res[min_ix] = tmp;
		}
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	let result = total * factor;
	g.res[0] = result;
	g.n = 1;
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "summed budget multiplied by factor");
	out
}
@end
