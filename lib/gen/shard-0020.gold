		o.append(" box ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("8");
		o.append(" 2,2,");

		o.append("1.");
		o.append("6");
		o.append(" m:matte ");
		gold_hex(o, 45, 43, 40);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "ringed wind caves");
	out
}
@end
