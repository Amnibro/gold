fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swap_evens_recursively: ", swaps);
	out
}
@end
