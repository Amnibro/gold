@entry 8b007bf482d2b076
kind: step
verb: dedupe
noun: series
modifier: pairwise
context: retry
slot: max_diff int
phrase: dedupe series pairwise with tolerance {max_diff}
phrase: remove adjacent duplicate series within {max_diff}
test: list=10,11,25,26,40 max_diff=2
expect: => i=2 r=0.0 ok=true s="deduped pairwise removed 2" errors=0 n=3 res=[10,25,40] cache=0 hits=0
test: list=1,5,10,15 max_diff=1
expect: => i=0 r=0.0 ok=true s="deduped pairwise removed 0" errors=0 n=4 res=[1,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n <= 1 { return out; }
	var w = 1;
	for r in 1 .. g.n {
		let diff = if g.res[r] >= g.res[w - 1] { g.res[r] - g.res[w - 1] } else { g.res[w - 1] - g.res[r] };
		if diff > md {
			g.res[w] = g.res[r];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped pairwise removed ", removed);
	out
}
@end
