	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	var res = 0;
	for val in d {
		res = res * 10 + val;
	}
	res
}
@end
@entry 88f54c44ec751b41
kind: fn
