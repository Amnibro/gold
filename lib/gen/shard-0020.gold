@entry f0c6c832d8ab9e91
kind: step
verb: find
noun: loop
modifier: with_cache
context: loop
phrase: find loop occurrence with cache for {target}
phrase: locate loop element using cache key {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="find loop with cache: 2" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
test: list=5,15,25 target=100
expect: => i=-1 r=0.0 ok=true s="find loop with cache: -1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let tgt = ${target};
	let cached, found = gold_cache_get(g, tgt);
	if found {
		out.i = cached;
		format(out.s, "found in cache: ", cached);
		return out;
	}
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	if idx >= 0 {
		gold_cache_put(g, tgt, idx);
	}
	g.steps += g.n + 1;
	out.i = idx;
	out.s.clear();
	format(out.s, "find loop with cache: ", idx);
	out
}
@end
@entry 8aa2dd34079c3dda
kind: step
verb: normalize
noun: counter
modifier: until
context: loop
phrase: normalize counter until reaching {target}
phrase: decrement counter loop until {target}
slot: target int
test: list=10,20,30 target=15
expect: => i=20 r=0.0 ok=true s="normalized counter until target: 20" errors=0 n=3 res=[10,15,15] cache=0 hits=0
test: list=5,8,12 target=20
expect: => i=0 r=0.0 ok=true s="normalized counter until target: 0" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let tgt = ${target};
	var cnt = 0;
	for i in g.n {
		if g.res[i] > tgt {
			let diff = g.res[i] - tgt;
			g.res[i] = tgt;
			cnt += diff;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "normalized counter until target: ", cnt);
	out
}
@end
@entry f0419922c074a9c3
kind: step
verb: collect
noun: series
modifier: until
context: loop
phrase: collect series until total reaches {limit}
phrase: gather series items until sum {limit}
slot: limit int
test: list=5,10,15,20 limit=25
expect: => i=15 r=0.0 ok=true s="collected series until limit: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,4,6,8 limit=10
expect: => i=6 r=0.0 ok=true s="collected series until limit: 6" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let lim = ${limit};
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] <= lim {
			total += g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "collected series until limit: ", total);
	out
}
@end
@entry 66f93a0ad1fa1d65
kind: step
verb: find
noun: steps
modifier: recursively
context: loop
phrase: find steps recursively across stride {stride}
phrase: count recursive steps by stride {stride}
slot: stride int
test: list=10,20,30,40 stride=2
expect: => i=2 r=0.0 ok=true s="found recursive steps: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 stride=1
expect: => i=3 r=0.0 ok=true s="found recursive steps: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let s = ${stride};
	if s <= 0 { out.ok = false; return out; }
	var hops = 0;
	var idx = 0;
	while idx < g.n {
		hops++;
		idx += s;
	}
	g.steps += hops;
	out.i = hops;
	out.s.clear();
	format(out.s, "found recursive steps: ", hops);
	out
}
@end
