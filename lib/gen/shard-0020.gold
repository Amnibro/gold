code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let tl = ${tail_len};
	var is_s = true;
	if tl > 1 && g.n >= tl {
		let start = g.n - tl;
		for i in start + 1..g.n {
			if g.res[i] < g.res[i - 1] {
				is_s = false;
				break;
			}
		}
	}
	g.steps += tl;
	out.ok = is_s;
	out.i = if is_s { 1 } else { 0 };
	out.s.clear();
	format(out.s, "tail sorted status: ", out.i);
	out
}
@end
