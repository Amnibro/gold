expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_bvlbrkmm_box_sub
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnew(g, "bracket", o);
	o.append(" box ");
	o.append("0,");
	o.append("0,");
	o.append("0.");
	o.append("02 ");
	o.append("0.");
	o.append("03,");
	o.append("0.");
	o.append("03,");
	gold_fnum(o, ${w});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
