test: c=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if ${c} < 1 { gold_fail(g, "width must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c}) % 2) as real;
		}
	}
	var s_blur = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_blur[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_blur;
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4.0 as real)) as! int;
		if t > 3 { t = 3; }
		g.img[k] = (t as real) / ((3.0) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
