fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dec = ${decrement};
	var shifts = 0;
	for k in g.n {
		while g.res[k] >= dec && dec > 0 {
			g.res[k] -= dec;
			shifts++;
		}
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted counter recursively count ", shifts);
	out
}
