test: list=10,20,30,40 max_budget=50
expect: => i=30 r=0.0 ok=true s="merged budget until limit" errors=0 n=5 res=[10,20,30,40,30] cache=0 hits=0
test: list=5,15,25,35 max_budget=40
expect: => i=20 r=0.0 ok=true s="merged budget until limit" errors=0 n=5 res=[5,15,25,35,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_budget};
	var spent = 0;
	var count = 0;
	for i in g.n {
		if spent + g.res[i] <= mb {
			spent += g.res[i];
			count++;
		} else {
			break;
		}
	}
	gold_push(g, spent);
	g.steps += count + 1;
	out.i = spent;
	out.s.clear();
	format(out.s, "merged budget until limit");
	out
}
@end
