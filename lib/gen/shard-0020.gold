fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for i in g.n {
		var seen = 0;
		for j in kept {
			if g.res[j] == g.res[i] { seen++; }
		}
		if seen < limit {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "normalized to ", kept, " items");
	out
}
@end
