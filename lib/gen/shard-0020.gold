slot: shift int
phrase: rotate histogram with cache by {shift}
phrase: cycle histogram bins using cache by {shift}
test: list=10,20,30,40 shift=1
expect: => i=40 r=0.0 ok=true s="rotated histogram first bin 40" errors=0 n=4 res=[40,10,20,30] cache=1 hits=0
test: list=1,2,3 shift=2
expect: => i=2 r=0.0 ok=true s="rotated histogram first bin 2" errors=0 n=3 res=[2,3,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		let eff = s % g.n;
		for step in eff {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
		}
		gold_cache_put(g, s, g.res[0]);
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated histogram first bin ", out.i);
	out
}
@end
