	var x = if n < 0 { -n } else { n };
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	if d.len == 0 || w <= 0 { return 0; }
	reverse(d[..]);
	let sz = if w > d.len { d.len } else { w };
	var max_sum = 0;
	for i in 0..(d.len - sz + 1) {
		var cur = 0;
		for j in sz {
			cur += d[i + j];
		}
		if i == 0 || cur > max_sum {
			max_sum = cur;
		}
	}
	max_sum
}
@end
