	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] <= mb {
			sum += g.res[k];
			count++;
		} else {
			break;
		}
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded sorted budget sum ", sum);
	out
}
@end
