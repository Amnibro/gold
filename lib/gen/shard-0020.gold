code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n > 1 {
		let h = g.res[0];
		var lim = if d < g.n { d } else { g.n - 1 };
		for i in lim {
			let idx = i + 1;
			g.res[idx] += h * (i + 1);
		}
		g.steps += lim;
		out.i = lim;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "nested head merge count: ", out.i);
	out
}
@end
