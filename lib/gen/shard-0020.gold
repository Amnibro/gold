fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var u = 0;
	for i in 1 .. g.n - 1 {
		var seen = false;
		for j in 1 .. i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { u++; }
	}
	g.steps += g.n;
	out.i = u;
	out.s.clear();
	format(out.s, "count_middle_unique: ", u);
	out
}
@end
