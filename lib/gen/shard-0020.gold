code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	if d.len <= 1 { return d.len; }
	reverse(d[..]);
	var runs = 1;
	for i in 1..d.len {
		if d[i] < d[i - 1] {
			runs++;
		}
	}
	runs
}
@end
