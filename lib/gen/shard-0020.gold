code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let fv = ${floor_val};
	var updated = 0;
	let start = if g.n > 2 { g.n - 2 } else { 0 };
	for i in start..g.n {
		if g.res[i] < fv {
			g.res[i] = fv;
			updated++;
		}
	}
	g.steps += g.n;
	out.i = updated;
	out.s.clear();
	format(out.s, "normalized threshold on last items: ", updated);
	out
}
@end
