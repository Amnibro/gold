code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let remove_val = ${target};
	for i in g.n {
		var lo = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[lo] { lo = j; }
		}
		if lo != i {
			let tmp = g.res[i];
			g.res[i] = g.res[lo];
			g.res[lo] = tmp;
		}
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] != remove_val {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "dropped occurrences leaving ", kept, " items");
	out
}
@end
