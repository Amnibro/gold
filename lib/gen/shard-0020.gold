fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var w = 0;
	for r in g.n {
		if g.res[r] >= c {
			g.res[w] = g.res[r];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "collected ", w, " numbers at least cutoff");
	out
}
@end
@entry f6271398270307be
kind: step
verb: limit
noun: total
modifier: at_least
context: error
slot: minimum int
phrase: limit total at least floor {minimum}
phrase: constrain error total at least bound {minimum}
test: list=1,2,3 minimum=10
expect: => i=10 r=0.0 ok=true s="limited total at least sum 10" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,10,15 minimum=20
expect: => i=30 r=0.0 ok=true s="limited total at least sum 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_tot = ${minimum};
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	if sum < min_tot {
		let diff = min_tot - sum;
		gold_push(g, diff);
		sum = min_tot;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "limited total at least sum ", sum);
	out
}
@end
