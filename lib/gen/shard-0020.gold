fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pair_count = ${k};
	for i in g.n {
		var low = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[low] { low = j; }
		}
		if low != i {
			let tmp = g.res[i];
			g.res[i] = g.res[low];
			g.res[low] = tmp;
		}
	}
	let max_pairs = if g.n > 1 { g.n - 1 } else { 0 };
	let n_pairs = if pair_count < max_pairs { pair_count } else { max_pairs };
	for p in n_pairs {
		g.res[p] = g.res[p] + g.res[p + 1];
	}
	g.n = n_pairs;
	g.steps += n_pairs;
	out.i = n_pairs;
	out.s.clear();
	format(out.s, "summed ", n_pairs, " pairs");
	out
}
@end
