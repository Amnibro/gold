@entry f88cc50508317c1d
kind: step
verb: fold
noun: primes
modifier: at_most
context: format
slot: max_val int
phrase: fold prime factors bounded at_most by limit {max_val}
phrase: format prime elements folded at_most ceiling {max_val}
phrase: render folded primes not exceeding ceiling {max_val}
test: list=2,3,4,5,11,13 max_val=7
expect: => i=10 r=0.0 ok=true s="folded primes: sum=10 count=3" errors=0 n=6 res=[2,3,4,5,11,13] cache=0 hits=0
test: list=7,11,17,4 max_val=12
expect: => i=18 r=0.0 ok=true s="folded primes: sum=18 count=2" errors=0 n=4 res=[7,11,17,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_val};
	var sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= ceiling {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				sum += x;
				count++;
			}
		}
	}
	out.s.clear();
	format(out.s, "folded primes: sum=", sum, " count=", count);
	out.i = sum;
	g.steps += g.n;
	out
}
@end
