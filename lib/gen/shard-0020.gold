@entry de4692b13f88ca85
kind: fn
verb: count
noun: streak
modifier: at_least
context: core
phrase: count streak at least minimum length
phrase: measure longest consecutive digit streak
test: arg=112223,44445
expect: 3
expect: 4
test: arg=12345,99
expect: 1
expect: 2
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	if x == 0 { return 1; }
	var max_streak = 1;
	var cur_streak = 1;
	var last_digit = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d == last_digit {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
			last_digit = d;
		}
		x /= 10;
	}
	max_streak
}
@end
