expect: => i=2 r=0.0 ok=true s="cached and kept 2 odds" errors=0 n=2 res=[15,17] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let num = g.res[k];
		let is_odd = num % 2 != 0;
		gold_cache_put(g, num, if is_odd { 1 } else { 0 });
		if is_odd {
			g.res[kept] = num;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached and kept ", kept, " odds");
	out
}
@end
