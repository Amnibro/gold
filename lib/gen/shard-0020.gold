fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 0 {
		let last_idx = out.s.len - 1;
		let c = out.s[last_idx];
		if c >= 'a' && c <= 'z' {
			out.s[last_idx] = c - 32;
		}
	}
	g.steps++;
	out.i = out.s.len;
	out
}
@end
