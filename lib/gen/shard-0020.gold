			gaps.push(diff);
		}
	} else {
		gaps.push(v.i);
	}
	if gaps.len > 1 {
		for i in gaps.len {
			for j in gaps.len - 1 {
				if gaps[j] > gaps[j + 1] {
					let tmp = gaps[j];
					gaps[j] = gaps[j + 1];
