fn ${ID}(g Gold&, v Val) Val {
var out = v;
	if ${n} < 1 || ${n} > 16 || ${r} <= 0.0 {
		gold_fail(g, "invalid sand drift parameters");
		out.ok = false;
		return out;
	}
	for k in ${n} {
		var o byte[>..] = [];
		let px = if k == 0 { ${r} } else if k == 1 { 0.0 } else if k == 2 { -${r} } else { 0.0 };
		let py = if k == 0 { 0.0 } else if k == 1 { ${r} } else if k == 2 { 0.0 } else { -${r} };
		gold_dnews(g, "drift", "", o);
		o.append(" cone ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",0 ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",1.5 r");
		o.append("1.8 m:matte ");
		gold_hex(o, 160, 133, 85);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "dotdunecenter");
	out
}
@end
