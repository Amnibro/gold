@entry 7cb367e0ec22cc1b
kind: step
verb: shift
noun: step
modifier: each
context: stats
slot: offset int
phrase: stats shift step each difference by {offset}
phrase: offset sample step each observation using {offset}
test: list=10,15,22,30 offset=2
expect: => i=3 r=0.0 ok=true s="shifted step deltas: 3" errors=0 n=3 res=[7,9,10] cache=0 hits=0
test: list=5,8,12 offset=1
expect: => i=2 r=0.0 ok=true s="shifted step deltas: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	for i in 1 .. g.n {
		let diff = g.res[i] - g.res[i - 1];
		g.res[i - 1] = diff + off;
	}
	g.n -= 1;
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted step deltas: ", g.n);
	out
}
@end
@entry a1086d7c01e09542
kind: step
verb: shift
noun: tally
modifier: recursively
context: stats
slot: shift_val int
phrase: stats shift tally recursively across {shift_val}
phrase: adjust sample frequency tally recursively using {shift_val}
test: list=10,-5,20,-15,30 shift_val=2
expect: => i=2 r=0.0 ok=true s="tally shift applied: 2" errors=0 n=5 res=[12,-3,22,-13,32] cache=0 hits=0
test: list=1,2,3 shift_val=5
expect: => i=15 r=0.0 ok=true s="tally shift applied: 15" errors=0 n=3 res=[16,17,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${shift_val};
	var pos = 0;
	var neg = 0;
	for i in g.n {
		if g.res[i] >= 0 { pos++; } else { neg++; }
	}
	let net_shift = (pos - neg) * sv;
	for i in g.n {
		g.res[i] += net_shift;
	}
	g.steps += g.n + 1;
	out.i = net_shift;
	out.s.clear();
	format(out.s, "tally shift applied: ", net_shift);
	out
}
@end
