code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	if g.n < 2 { return out; }
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		var m = if g.res[i] < g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
		if m > ceil_val { m = ceil_val; }
		g.res[pairs] = m;
		pairs++;
		i += 2;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pair minimum count: ", pairs);
	out
}
@end
