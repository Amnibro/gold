fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var w = 0;
	for k in g.n {
		if g.res[k] <= t {
			g.res[w] = g.res[k];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "recursively filtered ", removed, " elements");
	out
}
@end
