fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let first = g.res[0];
	for k in 0..(g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = first;
	out.s.clear();
	format(out.s, "shifted head element ", first, " to tail");
	out
}
@end
