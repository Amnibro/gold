expect: => i=6 r=0.0 ok=true s="split last item quotient: 6" errors=0 n=3 res=[10,6,1] cache=0 hits=0
test: list=5,17 divisor=5
expect: => i=3 r=0.0 ok=true s="split last item quotient: 3" errors=0 n=3 res=[5,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let d = ${divisor};
	if d == 0 || g.n == 0 { out.ok = false; return out; }
	let last = g.res[g.n - 1];
	let q = last / d;
	let rem = last % d;
	g.res[g.n - 1] = q;
	gold_push(g, rem);
	g.steps += 2;
	out.i = q;
	out.s.clear();
	format(out.s, "split last item quotient: ", q);
	out
}
@end
