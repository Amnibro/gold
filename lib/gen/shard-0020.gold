fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = gold_dfind(g);
	if k < 0 {
		gold_fail(g, "no floor found");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	o.push(' ');
	o.append("m:metal");
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "shadefloor");
	out
}
@end
