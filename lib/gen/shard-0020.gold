@entry 71a31aadf48c1d40
kind: step
verb: check
noun: words
modifier: unique
context: loop
phrase: check words unique across sentence
phrase: verify uniqueness of words in string
test: text="cat dog bird"
expect: => i=3 r=0.0 ok=true s="checked words unique" errors=0 n=0 res=[] cache=0 hits=0
test: text="cat dog cat"
expect: => i=3 r=0.0 ok=false s="checked words unique" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_starts int[32];
	var word_lens int[32];
	var wn = 0;
	var in_word = false;
	var start = 0;
	for i in out.s.len {
		if out.s[i] != ' ' {
			if !in_word {
				in_word = true;
				start = i;
			}
		} else {
			if in_word {
				word_starts[wn] = start;
				word_lens[wn] = i - start;
				wn++;
				in_word = false;
			}
		}
	}
	if in_word {
		word_starts[wn] = start;
		word_lens[wn] = out.s.len - start;
		wn++;
	}
	var unique = true;
	for i in wn {
		var j = i + 1;
		while j < wn {
			if word_lens[i] == word_lens[j] {
				var is_same = true;
				for k in word_lens[i] {
					if out.s[word_starts[i] + k] != out.s[word_starts[j] + k] {
						is_same = false;
						break;
					}
				}
				if is_same { unique = false; break; }
			}
			j++;
		}
		if !unique { break; }
	}
	g.steps += out.s.len + 1;
	out.ok = unique;
	out.i = wn;
	out.s.clear();
	format(out.s, "checked words unique");
	out
}
@end
