code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 0 || w > g.n { return out; }
	var valid_windows = 0;
	var i = 0;
	while i + w <= g.n {
		var increasing = true;
		for j in (w - 1) {
			if g.res[i + j] >= g.res[i + j + 1] {
				increasing = false;
				break;
			}
		}
		if increasing { valid_windows++; }
		i++;
	}
	g.steps += g.n + 1;
	out.i = valid_windows;
	out.s.clear();
	format(out.s, "checked window nested");
	out
}
@end
