slot: marker int
phrase: fill loop between boundary offsets with marker {marker}
phrase: pad loop error gaps between endpoints using {marker}
test: list=10,20,30,40,50 marker=-1
expect: => i=3 r=0.0 ok=true s="filled 3 loop elements between bounds" errors=0 n=5 res=[10,-1,-1,-1,50] cache=0 hits=0
test: list=1,2,3 marker=0
expect: => i=1 r=0.0 ok=true s="filled 1 loop elements between bounds" errors=0 n=3 res=[1,0,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${marker};
	var filled = 0;
	if g.n > 2 {
		for k in 1 .. g.n - 1 {
			g.res[k] = m;
			filled++;
		}
	}
	g.steps += g.n;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " loop elements between bounds");
	out
}
@end
@entry b6ee3d3158d280ee
kind: step
verb: run
noun: values
modifier: recursively
context: error
slot: max_depth int
phrase: run values recursively limiting depth to {max_depth}
phrase: execute error values recursively within depth {max_depth}
test: list=8,16,32 max_depth=3
expect: => i=9 r=0.0 ok=true s="ran values recursively steps 9" errors=0 n=3 res=[1,2,4] cache=0 hits=0
test: list=10,20 max_depth=1
expect: => i=2 r=0.0 ok=true s="ran values recursively steps 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_depth};
	var total_steps = 0;
	for k in g.n {
		var x = g.res[k];
		var d = 0;
		while x % 2 == 0 && d < md {
			x /= 2;
			d++;
		}
		g.res[k] = x;
		total_steps += d;
	}
	g.steps += total_steps;
	out.i = total_steps;
	out.s.clear();
	format(out.s, "ran values recursively steps ", total_steps);
	out
}
@end
@entry c48fd01119c9b032
kind: step
verb: split
noun: maximum
modifier: none
context: error
slot: ceiling int
phrase: split maximum none beyond limit {ceiling}
phrase: divide error stream at maximum none exceeding {ceiling}
test: list=10,50,20,60,30 ceiling=40
expect: => i=1 r=0.0 ok=true s="split at maximum none index 1" errors=0 n=5 res=[10,50,20,60,30] cache=0 hits=0
test: list=5,10,15 ceiling=100
expect: => i=-1 r=0.0 ok=true s="no maximum exceeding ceiling" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var split_idx = -1;
	for k in g.n {
		if g.res[k] > c {
			split_idx = k;
			break;
		}
	}
	g.steps += g.n;
	out.i = split_idx;
	out.s.clear();
	if split_idx >= 0 {
		format(out.s, "split at maximum none index ", split_idx);
	} else {
		format(out.s, "no maximum exceeding ceiling");
	}
	out
}
@end
@entry 87b5cf68d6ad7a32
kind: step
verb: apply
noun: digits
modifier: any
context: error
slot: radix int
phrase: apply digits any invalid radix {radix}
phrase: check error digits any exceeding base {radix}
test: list=18,25,39,42 radix=8
expect: => i=2 r=0.0 ok=true s="found 2 invalid digit entries" errors=0 n=4 res=[18,25,39,42] cache=0 hits=0
test: list=12,23,34 radix=5
expect: => i=0 r=0.0 ok=true s="found 0 invalid digit entries" errors=0 n=3 res=[12,23,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rx = ${radix};
	var invalid_count = 0;
	if rx > 0 {
		for k in g.n {
			var x = g.res[k];
			var has_inv = false;
			while x > 0 {
				if x % 10 >= rx {
					has_inv = true;
					break;
				}
				x /= 10;
			}
			if has_inv {
				invalid_count++;
			}
		}
	} else {
		gold_fail(g, "radix must be positive");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = invalid_count;
	out.s.clear();
	format(out.s, "found ", invalid_count, " invalid digit entries");
	out
}
@end
