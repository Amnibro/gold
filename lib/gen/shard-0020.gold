fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let scaled = total * m;
	g.steps += g.n + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "sum times multiplier: ", scaled);
	out
}
@end
@entry a07e7cb445137ab7
kind: step
verb: normalize
noun: history
modifier: nested
context: stats
slot: scale int
phrase: stats normalize history nested by {scale}
phrase: rescale sample history nested across window {scale}
test: list=20,40,60,80 scale=10
expect: => i=80 r=0.0 ok=true s="normalized history scaled to: 10" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=10,50,100 scale=5
expect: => i=100 r=0.0 ok=true s="normalized history scaled to: 5" errors=0 n=3 res=[0,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var max_val = 1;
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	for i in g.n {
		g.res[i] = (g.res[i] * sc) / max_val;
	}
	g.steps += g.n + 1;
	out.i = max_val;
	out.s.clear();
	format(out.s, "normalized history scaled to: ", sc);
	out
}
@end
@entry 3816702c0efed0e2
kind: step
verb: compare
noun: suffix
modifier: nested
context: stats
slot: span int
phrase: stats compare suffix nested span {span}
phrase: evaluate sample suffix nested across tail {span}
test: list=10,20,30,40,50,60 span=2
expect: => i=40 r=0.0 ok=true s="suffix difference: 40" errors=0 n=6 res=[10,20,30,40,50,60] cache=0 hits=0
test: list=5,10,15,20 span=1
expect: => i=5 r=0.0 ok=true s="suffix difference: 5" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || sp * 2 > g.n {
		gold_fail(g, "span exceeds half sample size");
		out.ok = false;
		return out;
	}
	var sum_tail = 0;
	var sum_prev = 0;
	for i in sp {
		sum_tail += g.res[g.n - 1 - i];
		sum_prev += g.res[g.n - 1 - sp - i];
	}
	let diff = sum_tail - sum_prev;
	g.steps += sp * 2 + 1;
	out.i = diff;
	out.s.clear();
	format(out.s, "suffix difference: ", diff);
	out
}
@end
@entry d50d6939fecec69c
kind: step
verb: fill
noun: checkpoint
modifier: with_cache
context: stats
slot: key int
phrase: stats fill checkpoint with cache key {key}
phrase: populate sample checkpoint with cache entry {key}
test: list=10,20,30 key=15
expect: => i=20 r=0.0 ok=true s="checkpoint filled with: 20" errors=0 n=4 res=[10,20,30,20] cache=1 hits=0
test: key=15
expect: => i=50 r=0.0 ok=true s="checkpoint filled with: 50" errors=0 n=1 res=[50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var val, found = gold_cache_get(g, k);
	if !found {
		var avg = 0;
		if g.n > 0 {
			var s = 0;
			for i in g.n { s += g.res[i]; }
			avg = s / g.n;
		} else {
			avg = 50;
		}
		gold_cache_put(g, k, avg);
		val = avg;
	}
	gold_push(g, val);
	g.steps += 1;
	out.i = val;
	out.s.clear();
	format(out.s, "checkpoint filled with: ", val);
	out
}
@end
@entry fc12b25fafaf4bbc
kind: step
verb: apply
noun: letters
modifier: pairwise
context: stats
slot: offset int
phrase: stats apply letters pairwise with offset {offset}
phrase: transform sample letter pairs pairwise using offset {offset}
test: list=65,68,72,80 offset=3
expect: => i=3 r=0.0 ok=true s="pairwise letter differences: 3" errors=0 n=3 res=[6,7,11] cache=0 hits=0
test: list=97,100,105 offset=2
expect: => i=2 r=0.0 ok=true s="pairwise letter differences: 2" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n < 2 {
		gold_fail(g, "need at least two observations");
		out.ok = false;
		return out;
	}
	var new_n = g.n - 1;
	for i in new_n {
		g.res[i] = (g.res[i + 1] - g.res[i]) + off;
	}
	g.n = new_n;
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise letter differences: ", g.n);
	out
}
@end
