fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
	} else {
		let target = g.res[0];
		var cnt = 0;
		for k in g.n {
			if g.res[k] == target { cnt++; }
		}
		g.steps += g.n;
		out.i = cnt;
	}
	out.s.clear();
	format(out.s, "first number count: ", out.i);
	out
}
@end
