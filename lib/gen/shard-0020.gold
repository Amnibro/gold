expect: => i=5 r=0.0 ok=true s="range joined sum: 5" errors=0 n=4 res=[5,10,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] <= b {
			sum += g.res[i];
			count++;
		}
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "range joined sum: ", sum);
	out
}
@end
