modifier: none
context: retry
slot: bound int
phrase: clamp middle values strictly to {bound}
phrase: constrain center elements to bound {bound}
test: list=10,50,60,20 bound=40
expect: => i=4 r=0.0 ok=true s="clamped middle elements" errors=0 n=4 res=[10,40,40,20] cache=0 hits=0
test: list=5,15,25 bound=30
expect: => i=3 r=0.0 ok=true s="clamped middle elements" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n > 2 {
		for k in 1 .. g.n - 1 {
			if g.res[k] > b {
				g.res[k] = b;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped middle elements");
	out
}
@end
@entry c43d87f678e2c2e0
kind: step
verb: filter
noun: loop
modifier: last
context: retry
slot: cutoff int
phrase: filter loop last items exceeding {cutoff}
phrase: prune loop last elements above {cutoff}
test: list=10,20,30,40,50 cutoff=35
expect: => i=2 r=0.0 ok=true s="filtered loop removed 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,10,15 cutoff=50
expect: => i=0 r=0.0 ok=true s="filtered loop removed 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var w = 0;
	for k in g.n {
		if g.res[k] <= c {
			g.res[w] = g.res[k];
			w++;
		}
	}
	let pruned = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = pruned;
	out.s.clear();
	format(out.s, "filtered loop removed ", pruned);
	out
}
@end
@entry bd22883f122499fd
kind: step
verb: validate
noun: tally
modifier: sorted
context: retry
slot: min_count int
phrase: validate tally sorted above {min_count}
phrase: verify tally sorted exceeding {min_count}
test: list=2,4,6,8,10 min_count=3
expect: => i=5 r=0.0 ok=true s="validated tally count 5" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=5,3,9 min_count=2
expect: => i=0 r=0.0 ok=false s="validated tally count 0" errors=1 n=3 res=[5,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var is_sorted = true;
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			is_sorted = false;
			break;
		}
	}
	if !is_sorted || g.n < mc {
		gold_fail(g, "tally sorted validation failed");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
	}
	out.s.clear();
	format(out.s, "validated tally count ", out.i);
	out
}
@end
