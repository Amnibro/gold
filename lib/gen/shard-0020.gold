fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_cnt = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { u_cnt++; }
	}
	if g.n > 0 {
		let old = g.res[0];
		g.res[0] = u_cnt;
		out.i = old;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "unique total swapped: ", u_cnt);
	out
}
@end
