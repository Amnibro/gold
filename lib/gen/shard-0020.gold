test: arg=112334,1234
expect: 2
expect: 4
test: arg=5555,1001
expect: 0
expect: 2
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	var digits = [0; 16];
	var count = 0;
	while x > 0 && count < 16 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	var isolated = 0;
	for i in 0 .. count {
		var has_pair = false;
		if i > 0 && digits[i] == digits[i - 1] { has_pair = true; }
		if i + 1 < count && digits[i] == digits[i + 1] { has_pair = true; }
		if !has_pair { isolated++; }
	}
	isolated
}
@end
