fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_len = ${suffix_len};
	let mult = ${multiplier};
	var start = g.n - s_len;
	if start < 0 { start = 0; }
	var sum = 0;
	var i = start;
	while i < g.n {
		g.res[i] *= mult;
		sum += g.res[i];
		i++;
	}
	g.steps += g.n - start;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged suffix times sum: ", sum);
	out
}
@end
