	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var modified = 0;
	for k in g.n {
		if g.res[k] < avg {
			g.res[k] = avg * 2 - g.res[k];
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "reversed below average count: ", modified);
	out
}
