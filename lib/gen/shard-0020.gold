@entry 0251650a52d07305
kind: step
verb: group
noun: histogram
modifier: in_reverse
context: loop
phrase: group histogram in reverse across {buckets} bins
phrase: accumulate reverse histogram counts into {buckets} categories
slot: buckets int
test: list=1,2,3,4,5,6 buckets=3
expect: => i=6 r=0.0 ok=true s="grouped reverse histogram total: 6" errors=0 n=3 res=[2,2,2] cache=0 hits=0
test: list=10,20,10,30 buckets=2
expect: => i=4 r=0.0 ok=true s="grouped reverse histogram total: 4" errors=0 n=2 res=[0,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let b = ${buckets};
	if b <= 0 { out.ok = false; return out; }
	var counts = [0; 16];
	for i in g.n {
		let idx = (g.res[i] % b) as int;
		if idx >= 0 && idx < 16 {
			counts[idx] += 1;
		}
	}
	gold_clear(g);
	var sum = 0;
	var k = b - 1;
	while k >= 0 {
		gold_push(g, counts[k]);
		sum += counts[k];
		k--;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped reverse histogram total: ", sum);
	out
}
@end
