@entry 6271677b56fe08ce
kind: fn
verb: sort
noun: history
modifier: last
context: compare
slot: k int
phrase: sort history last reverse trailing {k} digits
phrase: reverse order of lowest {k} digits
test: arg=12345,67890 k=3
expect: 12543
expect: 67098
test: arg=98765,43210 k=2
expect: 98756
expect: 43201
code:
fn ${ID}(n int) int {
	let rev_k = ${k};
	var x = if n < 0 { -n } else { n };
	var d int[..16] = [];
	while x > 0 { d.push(x % 10); x /= 10; }
	let len = d.len;
	let limit = if rev_k > len { len } else { rev_k };
	for i in limit / 2 {
		let tmp = d[i];
		d[i] = d[limit - 1 - i];
		d[limit - 1 - i] = tmp;
	}
	var res = 0;
	for i in len { res = res * 10 + d[len - 1 - i]; }
	res
}
@end
