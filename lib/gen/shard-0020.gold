@entry 68cc43c7157bd0ec
kind: step
verb: measure
noun: function
modifier: unique
context: core
slot: f fn
phrase: measure function unique outputs using {f}
phrase: count unique results from function {f}
test: list=1,-1,2,-2 f=abs_val
expect: => i=2 r=0.0 ok=true s="unique function results: 2" errors=0 n=4 res=[1,-1,2,-2] cache=0 hits=0
test: list=2,3,4 f=inc
expect: => i=3 r=0.0 ok=true s="unique function results: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var transformed = [0; 512];
	for i in g.n {
		transformed[i] = ${f}(g.res[i]);
	}
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in unique_count {
			if transformed[j] == transformed[i] { seen = true; break; }
		}
		if !seen {
			transformed[unique_count] = transformed[i];
			unique_count++;
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique function results: ", unique_count);
	out
}
@end
