phrase: return prime numbers at_least minimum value {min_val}
phrase: format primes discovered at_least threshold {min_val}
phrase: render prime sequence bounded below by {min_val}
test: list=3,4,7,10,13,15 min_val=5
expect: => i=2 r=0.0 ok=true s="primes: [7, 13]" errors=0 n=6 res=[3,4,7,10,13,15] cache=0 hits=0
test: list=2,5,11,17,20 min_val=10
expect: => i=2 r=0.0 ok=true s="primes: [11, 17]" errors=0 n=5 res=[2,5,11,17,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${min_val};
	out.s.clear();
	format(out.s, "primes: [");
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x >= floor {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				if count > 0 { format(out.s, ", "); }
				format(out.s, x);
				count++;
			}
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
