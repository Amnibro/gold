	}
	g.steps += g.n;
	out.ok = ok;
	if !ok { gold_fail(g, "pairwise delta exceeded limit"); }
	out.i = g.n;
	out.s.clear();
	format(out.s, "validated subfunction pairwise: ", g.n);
	out
}
