fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 20 || ${r} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
