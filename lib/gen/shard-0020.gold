@entry 682bbf5c134a2a1c
kind: step
verb: validate
noun: runs
modifier: at_least
context: format
slot: min_len int
phrase: validate monotonic runs of length at_least {min_len}
phrase: format verified ascending runs meeting length {min_len}
phrase: render sequence runs of size at_least {min_len}
test: list=1,2,3,1,2,4,5 min_len=3
expect: => i=2 r=0.0 ok=true s="runs: [[1, 2, 3], [1, 2, 4, 5]]" errors=0 n=7 res=[1,2,3,1,2,4,5] cache=0 hits=0
test: list=5,6,2,3,4 min_len=3
expect: => i=1 r=0.0 ok=true s="runs: [[2, 3, 4]]" errors=0 n=5 res=[5,6,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_len};
	out.s.clear();
	format(out.s, "runs: [");
	var run_count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] > g.res[j - 1] { j++; }
		let len = j - i;
		if len >= limit {
			if run_count > 0 { format(out.s, ", "); }
			format(out.s, "[");
			for k in i .. j {
				if k > i { format(out.s, ", "); }
				format(out.s, g.res[k]);
			}
			format(out.s, "]");
			run_count++;
		}
		i = j;
	}
	format(out.s, "]");
	out.i = run_count;
	g.steps += g.n;
	out
}
@end
