@entry 402a69151316e286
kind: step
verb: swap
noun: text
modifier: at_least
context: list
slot: min_chars int
phrase: swap text at least minimum length {min_chars} in list
phrase: swap elements with text representation at least {min_chars}
test: list=5,120,8,450,2 min_chars=3
expect: => i=2 r=0.0 ok=true s="swapped text length qualifying: 2" errors=0 n=5 res=[5,450,8,120,2] cache=0 hits=0
test: list=10,2,3000,4 min_chars=4
expect: => i=1 r=0.0 ok=true s="swapped text length qualifying: 1" errors=0 n=4 res=[10,2,3000,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_chars};
	var first_idx = -1;
	var last_idx = -1;
	var count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 { digits = 1; }
		while x > 0 { digits++; x /= 10; }
		if digits >= min_c {
			if first_idx < 0 { first_idx = k; }
			last_idx = k;
			count++;
		}
	}
	if first_idx >= 0 && last_idx > first_idx {
		let tmp = g.res[first_idx];
		g.res[first_idx] = g.res[last_idx];
		g.res[last_idx] = tmp;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped text length qualifying: ", count);
	out
}
@end
