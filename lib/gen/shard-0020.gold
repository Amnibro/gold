code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rounds = ${depth};
	for i in g.n {
		var m = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[m] { m = j; }
		}
		if m != i {
			let tmp = g.res[i];
			g.res[i] = g.res[m];
			g.res[m] = tmp;
		}
	}
	for _ in rounds {
		for k in g.n {
			g.res[k] = g.res[k] / 2;
		}
	}
	g.steps += g.n * rounds;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively transformed ", g.n, " items");
	out
}
@end
@entry 1c82a61afbaab663
kind: step
verb: group
noun: window
modifier: with_retry
context: sort
phrase: group sliding window with retry threshold {target}
phrase: accumulate sorted window pairs reaching target {target}
slot: target int
test: list=6,1,4,2 target=5
expect: => i=2 r=0.0 ok=true s="grouped 2 valid windows" errors=0 n=2 res=[6,10] cache=0 hits=0
test: list=9,2,3 target=10
expect: => i=1 r=0.0 ok=true s="grouped 1 valid windows" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold_val = ${target};
	for i in g.n {
		var sm = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[sm] { sm = j; }
		}
		if sm != i {
			let tmp = g.res[i];
			g.res[i] = g.res[sm];
			g.res[sm] = tmp;
		}
	}
	var matched = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			let pair_sum = g.res[k] + g.res[k + 1];
			if pair_sum >= threshold_val {
				g.res[matched] = pair_sum;
				matched++;
			}
		}
	}
	g.n = matched;
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "grouped ", matched, " valid windows");
	out
}
@end
