code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in 0 .. g.n {
		if g.res[i] % 2 == 0 { sum += g.res[i]; }
	}
	var rounds = 0;
	while sum < 40 && rounds < 100 {
		for i in 0 .. g.n {
			if g.res[i] % 2 == 0 {
				g.res[i] += 2;
				sum += 2;
			}
		}
		rounds++;
	}
	g.steps += g.n * rounds;
	out.i = sum;
	out.s.clear();
	format(out.s, "retry_evens_until: ", sum);
	out
}
@end
