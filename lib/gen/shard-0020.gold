fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var running = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if running + x <= tgt {
			running += x;
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = running;
	out.s.clear();
	format(out.s, "running sum: ", running);
	out
}
@end
@entry a01a168f4195b20e
kind: step
verb: search
noun: series
modifier: at_least
context: filter
slot: min_streak int
phrase: search series at_least length threshold {min_streak}
phrase: identify series streak of at_least {min_streak}
test: list=1,2,3,1,2,3,4,5,1 min_streak=4
expect: => i=5 r=0.0 ok=true s="series length: 5" errors=0 n=9 res=[1,2,3,1,2,3,4,5,1] cache=0 hits=0
test: list=10,20,5,6,7,8,1 min_streak=3
expect: => i=4 r=0.0 ok=true s="series length: 4" errors=0 n=7 res=[10,20,5,6,7,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	var best_len = 0;
	var cur_len = 0;
	if g.n > 0 {
		cur_len = 1;
		best_len = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] > g.res[i - 1] {
				cur_len++;
				if cur_len > best_len { best_len = cur_len; }
			} else {
				cur_len = 1;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = best_len;
	if best_len < ms {
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "series length: ", best_len);
	out
}
@end
