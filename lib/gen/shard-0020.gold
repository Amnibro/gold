@entry 55262ae29c048d8b
kind: step
verb: join
noun: primes
modifier: safely
context: retry
slot: max_val int
phrase: join primes safely under {max_val}
phrase: aggregate primes safely below {max_val}
test: list=2,3,4,5,6,7,8,9 max_val=10
expect: => i=17 r=0.0 ok=true s="joined 4 primes safely sum 17" errors=0 n=8 res=[2,3,4,5,6,7,8,9] cache=0 hits=0
test: list=10,12,14 max_val=20
expect: => i=0 r=0.0 ok=true s="joined 0 primes safely sum 0" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var sum = 0;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 && x <= mv {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				sum += x;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined ", count, " primes safely sum ", sum);
	out
}
@end
@entry 7c538a35d71d669c
kind: step
verb: fold
noun: minimum
modifier: first
context: retry
slot: k int
phrase: fold minimum first {k} elements
phrase: reduce smallest first {k} entries
test: list=40,15,30,10,50 k=3
expect: => i=15 r=0.0 ok=true s="folded minimum of first 3 is 15" errors=0 n=5 res=[40,15,30,10,50] cache=0 hits=0
test: list=7,2,9 k=2
expect: => i=2 r=0.0 ok=true s="folded minimum of first 2 is 2" errors=0 n=3 res=[7,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty fold");
		return out;
	}
	let limit = if count < g.n { count } else { g.n };
	var min_val = g.res[0];
	for i in 1 .. limit {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	g.steps += limit;
	out.i = min_val;
	out.s.clear();
	format(out.s, "folded minimum of first ", limit, " is ", min_val);
	out
}
@end
