test: list=2,4 len=5
expect: => i=5 r=0.0 ok=true s="series expanded to 5" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=10,20 len=4
expect: => i=4 r=0.0 ok=true s="series expanded to 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${len};
	if g.n >= 2 {
		let diff = g.res[g.n - 1] - g.res[g.n - 2];
		while g.n < target {
			let next_val = g.res[g.n - 1] + diff;
			gold_push(g, next_val);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "series expanded to ", g.n);
	out
}
@end
