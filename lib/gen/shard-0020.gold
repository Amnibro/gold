code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty history");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	out.i = last;
	gold_push(g, last);
	g.steps += 1;
	out.s.clear();
	format(out.s, "recorded last history ", last);
	out
}
@end
