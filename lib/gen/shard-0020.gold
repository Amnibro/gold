fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid_idx = g.n / 2;
	let scaled_mid = g.res[mid_idx] * f;
	var diff = scaled_mid - g.res[0];
	g.steps += g.n + 1;
	out.i = diff;
	out.s.clear();
	format(out.s, "scaled middle diff: ", diff);
	out
}
@end
