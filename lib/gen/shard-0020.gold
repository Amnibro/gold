test: list=0,10,0
expect: => i=0 r=0.0 ok=true s="centered middle with baseline 0" errors=0 n=3 res=[0,10,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		out.s.clear();
		format(out.s, "too few points to normalize middle");
		return out;
	}
	let baseline = (g.res[0] + g.res[g.n - 1]) / 2;
	for i in 1..(g.n - 1) {
		g.res[i] -= baseline;
	}
	g.steps += g.n;
	out.i = baseline;
	out.s.clear();
	format(out.s, "centered middle with baseline ", baseline);
	out
}
@end
