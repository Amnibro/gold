code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= th {
			g.res[kept] = x;
			sum += x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded sum: ", sum);
	out
}
@end
