@entry 102e7c972ff47aaf
kind: step
verb: rotate
noun: text
modifier: each
context: filter
slot: step int
phrase: rotate text each letter by step {step}
phrase: shift text characters each position with {step}
test: text="abcxyz" step=2
expect: => i=6 r=0.0 ok=true s="cdezab" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" step=1
expect: => i=5 r=0.0 ok=true s="ifmmp" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	var buf byte[>..] = [];
	for b in v.s {
		if b >= 'a' && b <= 'z' {
			let shifted = 'a' as int + ((b as int - 'a' as int + st) % 26 + 26) % 26;
			buf.push(shifted as byte);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
