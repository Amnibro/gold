@entry 8f1f1cab0364f6cb
kind: step
verb: run
noun: items
modifier: pairwise
context: aggregate
phrase: run items pairwise summing adjacent element pairs
phrase: fold pairs of adjacent items together
test: list=1,2,3,4,5
expect: => i=2 r=0.0 ok=true s="ran items pairwise" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="ran items pairwise" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: run items pairwise
	var out = v;
	var pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[i * 2] + g.res[i * 2 + 1];
	}
	if g.n % 2 != 0 {
		g.res[pairs] = g.res[g.n - 1];
		g.n = pairs + 1;
	} else {
		g.n = pairs;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "ran items pairwise");
	out
}
@end
