phrase: verify all adjacent digit steps smooth
test: arg=1234,579
expect: true
expect: true
test: arg=192,810
expect: false
expect: false
code:
fn ${ID}(n int) bool {
	var x = n;
	if x < 0 { x = -x; }
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		var diff = cur - prev;
		if diff < 0 { diff = -diff; }
		if diff > 2 { return false; }
		prev = cur;
		x /= 10;
	}
	true
}
@end
