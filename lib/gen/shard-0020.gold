kind: step
verb: limit
noun: budget
modifier: unique
context: stats
slot: max_unique int
phrase: stats limit budget unique count {max_unique}
phrase: restrict unique sample budget to {max_unique}
test: list=5,5,10,10,20,30 max_unique=2
expect: => i=2 r=0.0 ok=true s="unique budget kept: 2" errors=0 n=4 res=[5,5,10,10] cache=0 hits=0
test: list=1,2,3,4 max_unique=3
expect: => i=3 r=0.0 ok=true s="unique budget kept: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_u = ${max_unique};
	var unique_count = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			if unique_count < max_u {
				g.res[kept] = x;
				kept++;
				unique_count++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique budget kept: ", unique_count);
	out
}
@end
