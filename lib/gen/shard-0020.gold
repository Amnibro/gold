fn ${ID}(g Gold&, v Val) Val {
	// step: run subfunction at most
	var out = v;
	var modified = 0;
	let cap = ${ceiling_val};
	for i in g.n {
		if g.res[i] < cap {
			g.res[i] += 1;
			modified += 1;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "ran subfunction at most");
	out
}
