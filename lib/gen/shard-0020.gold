code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let avg = total / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items above average");
	out
}
@end
