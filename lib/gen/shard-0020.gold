expect: => i=3 r=0.0 ok=true s="reversed middle elements" errors=0 n=5 res=[2,8,6,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_ix = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_ix] { min_ix = j; }
		}
		if min_ix != i {
			let t = g.res[i];
			g.res[i] = g.res[min_ix];
			g.res[min_ix] = t;
		}
	}
	var count = 0;
	if g.n > 2 {
		var l = 1;
		var r = g.n - 2;
		count = (r - l) + 1;
		while l < r {
			let temp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = temp;
			l++;
			r--;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed middle elements");
	out
}
@end
