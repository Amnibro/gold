fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let ceil = ${ceiling};
	var scaled = 0;
	for k in g.n {
		let nxt = g.res[k] * f;
		if nxt > ceil { break; }
		g.res[k] = nxt;
		scaled++;
	}
	g.steps += scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled until limit count: ", scaled);
	out
}
