test: list=12,2
expect: => i=1 r=0.0 ok=true s="split items around average" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[idx] { idx = j; }
		}
		if idx != i {
			let t = g.res[i];
			g.res[i] = g.res[idx];
			g.res[idx] = t;
		}
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	let mean = if g.n > 0 { total / g.n } else { 0 };
	let low_b = mean / 2;
	let high_b = mean * 2;
	var wr = 0;
	for rd in g.n {
		let val = g.res[rd];
		if val >= low_b && val <= high_b {
			g.res[wr] = val;
			wr++;
		}
	}
	g.n = wr;
	g.steps += g.n;
	out.i = wr;
	out.s.clear();
	format(out.s, "split items around average");
	out
}
@end
