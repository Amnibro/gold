@entry 413c895a4952dd71
kind: fn
verb: dedupe
noun: results
modifier: recursively
context: search
phrase: dedupe results recursively through search space {factor}
phrase: compress recursive search outcome duplicates factor {factor}
slot: factor int
test: arg=1223,4445 factor=5
expect: 30
expect: 45
test: arg=9999,1234 factor=2
expect: 18
expect: 2
code:
fn ${ID}(n int) int {
	let f = ${factor};
	var x = if n < 0 { -n } else { n };
	var seen = 0;
	var deduped = 0;
	if x == 0 { return 0; }
	while x > 0 {
		let d = x % 10;
		let mask = 1 << d;
		if (seen & mask) == 0 {
			seen |= mask;
			deduped += d;
		}
		x /= 10;
	}
	var root = deduped;
	while root >= 10 {
		var s = 0;
		var r = root;
		while r > 0 {
			s += r % 10;
			r /= 10;
		}
		root = s;
	}
	root * f
}
@end
