code:
fn ${ID}(g Gold&, v Val) Val {
	// step: split histogram all
	var out = v;
	var unique_keys = 0;
	for i in g.n {
		let val = g.res[i];
		var already = false;
		for j in i {
			if g.res[j] == val {
				already = true;
			}
		}
		if !already {
			var count = 0;
			for k in g.n {
				if g.res[k] == val {
					count += 1;
				}
			}
			gold_cache_put(g, val, count);
			unique_keys += 1;
		}
	}
	out.i = unique_keys;
	out.s.clear();
	format(out.s, "split histogram all");
	out
}
@end
