fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sq};
	var i = 1;
	var count = 0;
	while i < g.n {
		var sq = g.res[i] * g.res[i];
		if sq > ms { sq = ms; }
		g.res[i] = sq;
		count++;
		i += 2;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "bounded alternate squares: ", count);
	out
}
@end
