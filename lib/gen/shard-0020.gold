code:
fn ${ID}(g Gold&, v Val) Val {
	// step: drop prefix while
	var out = v;
	var idx = 0;
	while idx < g.n && ${cond}(g.res[idx]) {
		idx += 1;
	}
	let dropped = idx;
	for i in (g.n - dropped) {
		g.res[i] = g.res[i + dropped];
	}
	g.n -= dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped prefix while");
	out
}
@end
