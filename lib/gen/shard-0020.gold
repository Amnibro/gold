code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var u = 0;
	for i in 0 .. g.n {
		sum += g.res[i];
		var seen = false;
		for j in 0 .. i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { u++; }
	}
	gold_push(g, u);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "swap_total_unique: ", sum);
	out
}
@end
