phrase: swap text with retry count {tries} on boundary elements
phrase: exchange boundary items formatting text with retry limit {tries}
test: list=10,20,30,40 tries=2
expect: => i=2 r=0.0 ok=true s="swapped boundary with retry tries: 2" errors=0 n=4 res=[40,20,30,10] cache=0 hits=0
test: list=5,15,25 tries=1
expect: => i=1 r=0.0 ok=true s="swapped boundary with retry tries: 1" errors=0 n=3 res=[25,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${tries};
	if g.n > 1 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		g.steps += t;
		out.i = t;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "swapped boundary with retry tries: ", out.i);
	out
}
@end
