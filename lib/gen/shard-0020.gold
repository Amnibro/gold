@entry aa183af5ed2be8d1
kind: step
verb: pair
noun: series
modifier: sorted
context: loop
phrase: pair sorted series adjacent values into sums
phrase: combine adjacent sorted series elements into pairs
test: list=1,3,2,5
expect: => i=2 r=0.0 ok=true s="paired sorted series" errors=0 n=6 res=[1,3,2,5,4,7] cache=0 hits=0
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="paired sorted series" errors=0 n=6 res=[2,4,6,8,6,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	if orig_n < 2 { return out; }
	var pairs = 0;
	var i = 0;
	while i < orig_n - 1 {
		if g.res[i] <= g.res[i + 1] {
			gold_push(g, g.res[i] + g.res[i + 1]);
			pairs++;
		}
		i += 2;
	}
	g.steps += orig_n + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired sorted series");
	out
}
@end
@entry 2adbd026dd8cf935
kind: step
verb: reverse
noun: middle
modifier: pairwise
context: loop
phrase: reverse middle pairwise elements inside results
phrase: invert middle loop elements taking pairwise steps
test: list=1,2,3,4,5,6
expect: => i=4 r=0.0 ok=true s="reversed middle pairwise" errors=0 n=6 res=[1,5,4,3,2,6] cache=0 hits=0
test: list=10,20,30,40,50,60,70
expect: => i=5 r=0.0 ok=true s="reversed middle pairwise" errors=0 n=7 res=[10,60,50,40,30,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 { return out; }
	var left = 1;
	var right = g.n - 2;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + 1;
	out.i = g.n - 2;
	out.s.clear();
	format(out.s, "reversed middle pairwise");
	out
}
@end
@entry 410a17c486b2e1c2
kind: step
verb: merge
noun: primes
modifier: each
context: loop
phrase: merge primes with each element plus offset {base}
phrase: add primes to each result with base {base}
slot: base int
test: list=2,3,4,5 base=2
expect: => i=3 r=0.0 ok=true s="merged primes each" errors=0 n=4 res=[4,5,4,7] cache=0 hits=0
test: list=7,8,9,11 base=3
expect: => i=2 r=0.0 ok=true s="merged primes each" errors=0 n=4 res=[10,8,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var modified = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] = x + b;
			modified++;
		}
	}
	g.steps += g.n + 1;
	out.i = modified;
	out.s.clear();
	format(out.s, "merged primes each");
	out
}
@end
