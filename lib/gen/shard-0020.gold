expect: => i=0 r=0.0 ok=true s="boost passes to reach at least sum: 0" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	var passes = 0;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		while sum < ms && passes < 100 {
			passes++;
			g.hits++;
			for i in g.n {
				g.res[i]++;
				sum++;
			}
		}
	}
	g.steps += passes * g.n + 1;
	out.i = passes;
	out.s.clear();
	format(out.s, "boost passes to reach at least sum: ", passes);
	out
}
@end
