fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let last_val = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = last_val;
	g.steps += g.n;
	out.i = last_val;
	out.s.clear();
	format(out.s, "rotated last checkpoint ", last_val);
	out
}
@end
