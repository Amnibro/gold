fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var count = 0;
	for b in out.s {
		if b == '(' || b == '[' {
			depth++;
		} else if b == ')' || b == ']' {
			if depth > 0 { depth--; }
		} else if depth > 0 && b != ' ' {
			count++;
		}
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " nested letters");
	out
}
