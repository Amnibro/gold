code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var total = 0;
	for i in g.n {
		if g.res[i] >= mf {
			total += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed ", total, " occurrences");
	out
}
@end
@entry 7bbc83a51f2ad6f1
kind: step
verb: limit
noun: threshold
modifier: in_reverse
context: stats
phrase: limit threshold scanning in reverse with {min_val}
phrase: cap values below threshold backwards using {min_val}
slot: min_val int
test: list=10,5,20,2 min_val=8
expect: => i=2 r=0.0 ok=true s="clamped 2 values backwards" errors=0 n=4 res=[10,8,20,8] cache=0 hits=0
test: list=15,25 min_val=5
expect: => i=0 r=0.0 ok=true s="clamped 0 values backwards" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var clamped = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if g.res[k] < mv {
			g.res[k] = mv;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values backwards");
	out
}
@end
@entry 17371e2bef4e5305
kind: step
verb: run
noun: maximum
modifier: nested
context: stats
phrase: run maximum search across nested blocks of size {block_size}
phrase: compute maximum values in nested partitions of {block_size}
slot: block_size int
test: list=1,5,3,9,2,8 block_size=2
expect: => i=3 r=0.0 ok=true s="computed 3 nested maximums" errors=0 n=3 res=[5,9,8] cache=0 hits=0
test: list=10,20,5 block_size=3
expect: => i=1 r=0.0 ok=true s="computed 1 nested maximums" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${block_size};
	if bs <= 0 || g.n == 0 {
		gold_fail(g, "invalid block size");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var cur_max = g.res[i];
		var j = 1;
		while j < bs && i + j < g.n {
			if g.res[i + j] > cur_max {
				cur_max = g.res[i + j];
			}
			j++;
		}
		g.res[kept] = cur_max;
		kept++;
		i += bs;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "computed ", kept, " nested maximums");
	out
}
@end
