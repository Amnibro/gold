fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var high = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[high] { high = j; }
		}
		if high != i {
			let sw = g.res[i];
			g.res[i] = g.res[high];
