test: arg=1234,5678
expect: 2413
expect: 6857
test: arg=10,999
expect: 1
expect: 999
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	var evens = 0;
	var odds = 0;
	var emul = 1;
	var omul = 1;
	var idx = 0;
	while x > 0 {
		let d = x % 10;
		if idx % 2 == 0 {
			evens += d * emul;
			emul *= 10;
		} else {
			odds += d * omul;
			omul *= 10;
		}
		x /= 10;
		idx++;
	}
	evens * omul + odds
}
@end
