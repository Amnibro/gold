code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sp = -1;
	for i in out.s.len {
		if out.s[i] == ' ' { sp = i; break; }
	}
	if sp > 0 {
		var first_word byte[..64] = "";
		for i in sp { first_word.push(out.s[i]); }
		var remainder byte[..160] = "";
		for i in (sp + 1)..out.s.len { remainder.push(out.s[i]); }
		out.s.clear();
		format(out.s, remainder, " ", first_word);
	}
	g.steps++;
	out.i = sp;
	out
}
@end
