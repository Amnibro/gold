	let f = ${factor};
	if f == 0 { out.ok = false; return out; }
	var matched = 0;
	var buf = [0; 64];
	for i in g.n {
		if g.res[i] % f == 0 && matched < 64 {
			buf[matched] = g.res[i];
			matched++;
		}
	}
	gold_clear(g);
	for j in matched {
		gold_push(g, buf[j]);
	}
	g.steps += matched;
	out.i = matched;
	out.s.clear();
	format(out.s, "collected nested subfunction: ", matched);
	out
}
@end
