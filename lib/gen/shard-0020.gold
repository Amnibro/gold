fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_count = g.n / 2;
	for i in pair_count {
		g.res[i] = g.res[i * 2] + g.res[i * 2 + 1];
	}
	g.n = pair_count;
	g.steps += pair_count + 1;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "summed adjacent pairs: ", pair_count);
	out
}
@end
@entry cf04f5a2017512ad
kind: step
verb: limit
noun: average
modifier: between
context: stats
slot: low int
slot: high int
phrase: stats limit average between {low} to {high}
phrase: restrict sample average between {low} through {high}
test: list=10,20,30 low=5 high=25
expect: => i=20 r=0.0 ok=true s="sample average: 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=100,200,300 low=10 high=50
expect: => i=200 r=0.0 ok=false s="sample average: 200" errors=1 n=3 res=[100,200,300] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = 0;
	if g.n > 0 { avg = sum / g.n; }
	var ok = avg >= lo && avg <= hi;
	if !ok {
		gold_fail(g, "sample average outside bounds");
		out.ok = false;
	}
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "sample average: ", avg);
	out
}
@end
@entry d26c8d62695392d7
kind: step
verb: run
noun: series
modifier: safely
context: stats
slot: max_steps int
phrase: stats run series safely limit {max_steps}
phrase: execute sample series safely bounded by {max_steps}
test: list=10,20,30,40 max_steps=3
expect: => i=60 r=0.0 ok=true s="series sum safely bounded: 60" errors=0 n=3 res=[10,30,60] cache=0 hits=0
test: list=5,10,15 max_steps=5
expect: => i=30 r=0.0 ok=true s="series sum safely bounded: 30" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_steps};
	var limit = if ms < g.n { ms } else { g.n };
	var running = 0;
	for i in limit {
		running += g.res[i];
		g.res[i] = running;
	}
	g.n = limit;
	g.steps += limit + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "series sum safely bounded: ", running);
	out
}
@end
