expect: => i=3 r=0.0 ok=true s="clamped dups: [5:4, 2:4]" errors=0 n=6 res=[5,2,5,3,2,2] cache=0 hits=0
test: list=8,8,1,8 min_count=2
expect: => i=2 r=0.0 ok=true s="clamped dups: [8:3]" errors=0 n=4 res=[8,8,1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${min_count};
	var dups int[>..] = [];
	var counts int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in dups.len {
			if dups[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			counts[idx] = counts[idx] + 1;
		} else {
			dups.push(x);
			counts.push(1);
		}
	}
	out.s.clear();
	format(out.s, "clamped dups: [");
	var first = true;
	for j in dups.len {
		if counts[j] > 1 {
			var c = counts[j];
			if c < floor { c = floor; }
			if !first { format(out.s, ", "); }
			format(out.s, dups[j], ":", c);
			first = false;
		}
	}
	format(out.s, "]");
	out.i = dups.len;
	g.steps += g.n;
	out
}
@end
