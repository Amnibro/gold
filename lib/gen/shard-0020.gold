test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="selected unique series elements: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[un] = x;
			un++;
		}
	}
	g.n = un;
	g.steps += g.n + 1;
	out.i = un;
	out.s.clear();
	format(out.s, "selected unique series elements: ", un);
	out
}
@end
