fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	gold_cache_put(g, out.i, out.i * 2);
	let val, ok = gold_cache_get(g, tgt);
	if ok {
		out.i = val;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	g.steps++;
	out.s.clear();
	format(out.s, "checkpoint found: ", out.i);
	out
}
@end
@entry b4cd9c80779c6b26
kind: step
verb: group
noun: minimum
modifier: in_reverse
context: core
slot: chunk_size int
phrase: group minimum in reverse chunks of {chunk_size}
phrase: partition minimum in reverse by {chunk_size}
test: list=5,2,8,1,4,7 chunk_size=3
expect: => i=2 r=0.0 ok=true s="grouped reverse count: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=10,30,20,5 chunk_size=2
expect: => i=2 r=0.0 ok=true s="grouped reverse count: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 || g.n == 0 { return out; }
	var out_res = [0; 512];
	var count = 0;
	var i = g.n;
	while i > 0 {
		var min_val = g.res[i - 1];
		for j in sz {
			if i > j {
				let x = g.res[i - 1 - j];
				if x < min_val { min_val = x; }
			}
		}
		out_res[count] = min_val;
		count++;
		if i >= sz { i -= sz; } else { i = 0; }
	}
	for c in count {
		g.res[c] = out_res[c];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped reverse count: ", count);
	out
}
@end
