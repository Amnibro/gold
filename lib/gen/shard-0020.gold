@entry 2c4e7849a367dc16
kind: step
verb: group
noun: runs
modifier: until
context: core
phrase: group consecutive runs until condition {p}
phrase: combine equal runs until predicate {p}
slot: p pred
test: list=1,1,2,2,3,4 p=is_even
expect: => i=4 r=0.0 ok=true s="collapsed runs to 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=3,3,3,1,1,2 p=over_100
expect: => i=3 r=0.0 ok=true s="collapsed runs to 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		g.res[kept] = g.res[i];
		kept++;
		if ${p}(g.res[i]) {
			for k in j..g.n {
				g.res[kept] = g.res[k];
				kept++;
			}
			break;
		}
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collapsed runs to ", kept);
	out
}
@end
