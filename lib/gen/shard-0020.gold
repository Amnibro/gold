fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	var count = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq <= ceil_val {
			g.res[i] = sq;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "squares normalized: ", count);
	out
}
@end
@entry 0c22a4247143a2c9
kind: step
verb: clamp
noun: streak
modifier: in_place
context: core
slot: max_streak int
phrase: clamp streak in place to {max_streak}
phrase: truncate repeated streak in place at {max_streak}
test: list=2,2,2,3,3,3,3 max_streak=2
expect: => i=4 r=0.0 ok=true s="streak clamped to: 4" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=5,5,5,5 max_streak=1
expect: => i=1 r=0.0 ok=true s="streak clamped to: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	if g.n == 0 || ms <= 0 { return out; }
	var kept = 0;
	var streak = 0;
	var prev = 0;
	for i in g.n {
		let x = g.res[i];
		if i == 0 || x != prev {
			prev = x;
			streak = 1;
			g.res[kept] = x;
			kept++;
		} else if streak < ms {
			streak++;
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "streak clamped to: ", kept);
	out
}
@end
