test: list=10,5,10,20,5
expect: => i=3 r=0.0 ok=true s="dedupe_limit_at_least: 3" errors=0 n=3 res=[10,5,20] cache=0 hits=0
test: list=2,8,8,3,8
expect: => i=3 r=0.0 ok=true s="dedupe_limit_at_least: 3" errors=0 n=3 res=[2,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	for i in 0 .. g.n {
		let val = g.res[i];
		if val >= 5 {
			var seen = false;
			for j in 0 .. k {
				if g.res[j] == val { seen = true; break; }
			}
			if !seen {
				g.res[k] = val;
				k++;
			}
		} else {
			g.res[k] = val;
			k++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "dedupe_limit_at_least: ", k);
	out
}
@end
