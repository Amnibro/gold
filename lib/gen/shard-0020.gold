code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotate_step_safely: ", g.n);
	out
}
@end
