		let dist = ${r} * (0.8 + gold_hash01(q, 1, ${u}) * 0.4);
		let px = dist * (gold_hash01(q, 2, ${u}) * 2.0 - 1.0);
		let py = dist * (gold_hash01(q, 3, ${u}) * 2.0 - 1.0);
		o.clear();
		gold_dnews(g, "cliff", "", o);
		o.append(" box ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",2 3,");

		o.append("1,4 m:matte ");
		gold_hex(o, 107, 97, 85);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "ringed ridge cliffs");
	out
}
@end
