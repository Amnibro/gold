code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t_val = ${thresh};
	var l_cap = ${limit};
	if l_cap > g.n { l_cap = g.n; }
	for i in g.n {
		var sm_ix = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[sm_ix] { sm_ix = j; }
		}
		if sm_ix != i {
			let t = g.res[i];
			g.res[i] = g.res[sm_ix];
			g.res[sm_ix] = t;
		}
	}
	var count = 0;
	var idx = 0;
	while idx < l_cap {
		if g.res[idx] < t_val {
			count++;
		}
		idx++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted items below threshold up to limit");
	out
}
@end
