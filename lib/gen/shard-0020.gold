	let ret = ${retries};
	gold_cache_put(g, 1, 10);
	gold_cache_put(g, 2, 20);
	var total = 0;
	for k in g.n {
		let val, ok = gold_cache_get(g, g.res[k]);
		if ok {
			total += val;
