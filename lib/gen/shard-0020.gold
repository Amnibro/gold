expect: => i=2 r=0.0 ok=true s="reversed tail recursively" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${tail_len};
	if k > g.n { k = g.n; }
	if k <= 1 { return out; }
	var l = g.n - k;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += k + 1;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed tail recursively");
	out
}
@end
