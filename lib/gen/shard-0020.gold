@entry e95b831d2718e227
kind: step
verb: split
noun: total
modifier: each
context: stats
slot: parts int
phrase: stats split total each into {parts} shares
phrase: divide sample total each across {parts} bins
test: list=30,70 parts=4
expect: => i=100 r=0.0 ok=true s="split total into shares: 25" errors=0 n=4 res=[25,25,25,25] cache=0 hits=0
test: list=15,25,60 parts=2
expect: => i=100 r=0.0 ok=true s="split total into shares: 50" errors=0 n=2 res=[50,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 {
		gold_fail(g, "parts must be positive");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let share = total / p;
	let rem = total % p;
	g.n = 0;
	for i in p {
		var val = share;
		if i < rem { val += 1; }
		gold_push(g, val);
	}
	g.steps += p + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "split total into shares: ", share);
	out
}
@end
