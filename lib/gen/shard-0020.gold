code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${r} <= 0.0 || ${n} < 1 || ${n} > 16 {
		gold_fail(g, "parameters out of range");
		out.ok = false;
		return out;
	}
	for k in ${n} {
		let x = (k as real) * 2.5;
		o.clear();
		gold_dnews(g, "rocks", "", o);
		o.append(" sphere ");
		gold_fnum(o, x);
		o.append(",");
		o.append("0");
		o.append(",");
		gold_fnum(o, 0.5);
		o.append(" r");
		gold_fnum(o, 1.2);
		o.append(" m:matte ");
		gold_hex(o, 120, 112, 104);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "rocks");
	out
}
@end
