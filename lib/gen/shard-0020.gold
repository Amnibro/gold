fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 0 .. g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var count = 0;
	var i = g.cn - 1;
	while i >= 0 {
		out.i += g.cv[i];
		count++;
		i--;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "return_cache_in_reverse: ", out.i);
	out
}
@end
