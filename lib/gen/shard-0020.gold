test: list=42
expect: => i=2 r=0.0 ok=true s="warmed cache with min and max" errors=0 n=1 res=[42] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no observations to cache");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	gold_cache_put(g, 0, min_val);
	gold_cache_put(g, 1, max_val);
	g.steps += g.n;
	out.i = 2;
	out.s.clear();
	format(out.s, "warmed cache with min and max");
	out
}
@end
