phrase: extract odd values capped at most by {cap}
slot: cap int
test: list=1,4,7,12,15 cap=10
expect: => i=2 r=0.0 ok=true s="retained 2 odd values" errors=0 n=2 res=[1,7] cache=0 hits=0
test: list=2,6,8 cap=10
expect: => i=0 r=0.0 ok=true s="retained 0 odd values" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x <= c {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " odd values");
	out
}
@end
@entry d5f089251945b53c
kind: step
verb: drop
noun: vowels
modifier: in_place
context: stats
phrase: drop vowel codes in place
phrase: filter out vowel ascii values in place
test: list=65,66,67,69
expect: => i=2 r=0.0 ok=true s="dropped 2 vowel codes" errors=0 n=2 res=[66,67] cache=0 hits=0
test: list=70,71,72
expect: => i=0 r=0.0 ok=true s="dropped 0 vowel codes" errors=0 n=3 res=[70,71,72] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let is_vowel = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 || x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if !is_vowel {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " vowel codes");
	out
}
@end
