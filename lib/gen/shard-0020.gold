fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let asc = ${ascending};
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 {
				let swap = if asc > 0 { g.res[j] > g.res[j + 1] } else { g.res[j] < g.res[j + 1] };
				if swap {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned sorted results count ", g.n);
	out
}
