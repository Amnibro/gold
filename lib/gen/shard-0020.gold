	out.s.clear();
	format(out.s, "nested letters: [");
	var first = true;
	for b in v.s {
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			if !first { format(out.s, ", "); }
			var ch byte[>..] = [];
			ch.push(b);
			format(out.s, "[", ch, "]");
			first = false;
		}
	}
	format(out.s, "]");
	out.i = v.s.len;
	g.steps += v.s.len;
	out
}
