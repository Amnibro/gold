test: text="pin: 1234" shift=1
expect: => i=4 r=0.0 ok=true s="0123" errors=0 n=0 res=[] cache=0 hits=0
test: text="code 9870" shift=2
expect: => i=4 r=0.0 ok=true s="7658" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	var digits byte[>..] = [];
	for b in v.s {
		if b >= '0' && b <= '9' {
			let shifted = '0' as int + ((b as int - '0' as int - s) % 10 + 10) % 10;
			digits.push(shifted as byte);
		}
	}
	out.s.clear();
	for b in digits { out.s.push(b); }
	out.i = digits.len;
	g.steps += digits.len;
	out
}
@end
@entry 8018acc7bc9971b5
kind: step
verb: filter
noun: duplicates
modifier: with_retry
context: filter
slot: max_dups int
phrase: filter duplicates with_retry allowance limit {max_dups}
phrase: remove repeated duplicates with_retry bound {max_dups}
test: list=1,1,1,2,2,3,4,4,4 max_dups=2
expect: => i=7 r=0.0 ok=true s="filtered duplicates: 7" errors=0 n=7 res=[1,1,2,2,3,4,4] cache=0 hits=0
test: list=10,10,10,20,30,30 max_dups=1
expect: => i=3 r=0.0 ok=true s="filtered duplicates: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dups};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < md {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered duplicates: ", kept);
	out
}
@end
