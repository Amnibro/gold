code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mul};
	var count = 0;
	for i in g.n {
		if i % 2 == 1 && g.res[i] % 2 != 0 {
			g.res[i] *= m;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "odds scaled: ", count);
	out
}
@end
