kind: step
verb: limit
noun: total
modifier: nested
context: sort
phrase: limit total cumulative sum to ceiling {ceiling}
phrase: cap total running sum at limit {ceiling}
slot: ceiling int
test: list=10,3,5,20,1 ceiling=15
expect: => i=9 r=0.0 ok=true s="limited total to 9 across 3 items" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=12,8 ceiling=10
expect: => i=8 r=0.0 ok=true s="limited total to 8 across 1 items" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${ceiling};
	for i in g.n {
		var mn = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[mn] { mn = j; }
		}
		if mn != i {
			let tmp = g.res[i];
			g.res[i] = g.res[mn];
			g.res[mn] = tmp;
		}
	}
	var acc = 0;
	var kept = 0;
	for k in g.n {
		if acc + g.res[k] <= max_sum {
			acc += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "limited total to ", acc, " across ", kept, " items");
	out
}
@end
@entry 4a55c4a9fe673d21
kind: step
verb: limit
noun: prefix
modifier: last
context: sort
phrase: limit prefix retaining only last {k} items
phrase: keep prefix from sorted ending at last {k} items
slot: k int
test: list=6,2,9,4,1 k=3
expect: => i=3 r=0.0 ok=true s="retained last 3 sorted items" errors=0 n=3 res=[4,6,9] cache=0 hits=0
test: list=10,50,30 k=1
expect: => i=1 r=0.0 ok=true s="retained last 1 sorted items" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let take_last = ${k};
	for i in g.n {
		var p = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[p] { p = j; }
		}
		if p != i {
			let tmp = g.res[i];
			g.res[i] = g.res[p];
			g.res[p] = tmp;
		}
	}
	let start_ix = if g.n > take_last { g.n - take_last } else { 0 };
	let kept_cnt = g.n - start_ix;
	for idx in kept_cnt {
		g.res[idx] = g.res[start_ix + idx];
	}
	g.n = kept_cnt;
	g.steps += g.n;
	out.i = kept_cnt;
	out.s.clear();
	format(out.s, "retained last ", kept_cnt, " sorted items");
	out
}
@end
