code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = ${k};
	if len > g.n { len = g.n; }
	out.s.clear();
	format(out.s, "rotated prefix: [");
	if len > 0 {
		for i in len {
			let idx = (i + 1) % len;
			if i > 0 { format(out.s, ", "); }
			format(out.s, g.res[idx]);
		}
		for i in len .. g.n {
			format(out.s, ", ", g.res[i]);
		}
	}
	format(out.s, "]");
	out.i = len;
	g.steps += g.n;
	out
}
@end
