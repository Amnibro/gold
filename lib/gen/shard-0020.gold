fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 1;
	while i < g.n {
		g.res[i] = ${f}(g.res[i]);
		count++;
		i += 2;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "filled function every other: ", count);
	out
}
