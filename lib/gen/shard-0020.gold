fn ${ID}(g Gold&, v Val) Val {
	// step: group results each
	var out = v;
	var temp int[256];
	var t_len = 0;
	var even_cnt = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			temp[t_len] = g.res[i];
			t_len += 1;
			even_cnt += 1;
		}
	}
	for i in g.n {
		if g.res[i] % 2 != 0 {
			temp[t_len] = g.res[i];
			t_len += 1;
		}
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	out.i = even_cnt;
	out.s.clear();
	format(out.s, "grouped results each");
	out
}
