fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var p = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[p] { p = j; }
		}
		if p != i {
			let sw = g.res[i];
			g.res[i] = g.res[p];
			g.res[p] = sw;
		}
	}
	var write_pos = 0;
	for read_pos in g.n {
		if write_pos == 0 || g.res[read_pos] != g.res[write_pos - 1] {
			g.res[write_pos] = g.res[read_pos];
			write_pos++;
		}
	}
	g.n = write_pos;
	g.steps += g.n;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "grouped runs in place");
	out
}
@end
