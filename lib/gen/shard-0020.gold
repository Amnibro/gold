@entry e8b7d7f08a9a0bfd
kind: step
verb: fill
noun: spaces
modifier: recursively
context: stats
phrase: fill spaces between elements with midpoints
phrase: interpolate gaps between observations with midpoints
test: list=10,30
expect: => i=3 r=0.0 ok=true s="interpolated dataset to 3 points" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=0,40
expect: => i=3 r=0.0 ok=true s="interpolated dataset to 3 points" errors=0 n=3 res=[0,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "cannot interpolate fewer than 2 points");
		return out;
	}
	var tmp = [0; 512];
	var count = 0;
	for i in 0..(g.n - 1) {
		tmp[count] = g.res[i];
		count++;
		tmp[count] = (g.res[i] + g.res[i + 1]) / 2;
		count++;
	}
	tmp[count] = g.res[g.n - 1];
	count++;
	for k in count {
		g.res[k] = tmp[k];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "interpolated dataset to ", count, " points");
	out
}
@end
