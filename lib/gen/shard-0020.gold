@entry 32625d8377e59670
kind: step
verb: collect
noun: duplicates
modifier: recursively
context: stats
phrase: stats collect duplicates recursively into summary
phrase: gather repeated observations recursively from sample
test: list=5,10,5,20,10,30,5
expect: => i=2 r=0.0 ok=true s="collected duplicate values: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="collected duplicate values: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var out_list int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var already = false;
			for k in count {
				if out_list[k] == x {
					already = true;
					break;
				}
			}
			if !already && count < 512 {
				out_list[count] = x;
				count++;
			}
		}
	}
	for k in count {
		g.res[k] = out_list[k];
	}
	g.n = count;
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "collected duplicate values: ", count);
	out
}
@end
