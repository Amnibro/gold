code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > b {
			g.res[i] = b;
			clamped++;
		} else if g.res[i] < -b {
			g.res[i] = -b;
			clamped++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "window clamped: ", clamped);
	out
}
@end
