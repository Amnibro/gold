code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for window join");
		out.ok = false;
		return out;
	}
	var k = 0;
	var i = 0;
	while i < g.n - 1 {
		g.res[k] = g.res[i] + g.res[i + 1];
		k++;
		i += 2;
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "join_window_with_retry: ", k);
	out
}
@end
