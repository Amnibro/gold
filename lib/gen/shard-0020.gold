fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_gap = 0;
	for i in 0 .. g.n - 1 {
		var gv = g.res[i + 1] - g.res[i];
		if gv < 0 { gv = -gv; }
		if gv > max_gap { max_gap = gv; }
	}
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "scan_gaps_between: ", max_gap);
	out
}
