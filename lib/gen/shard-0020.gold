	}
	g.steps += g.n;
	out.i = budget;
	out.s.clear();
	format(out.s, "budget remaining: ", budget);
	out
}
@end
@entry 60ad9cd7065b9f76
kind: step
verb: check
noun: sequence
modifier: recursively
context: core
slot: step_diff int
phrase: check sequence recursively with step {step_diff}
phrase: verify sequence recursively delta {step_diff}
test: list=2,4,6,8 step_diff=2
expect: => i=1 r=0.0 ok=true s="sequence uniform: 1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,7,9 step_diff=2
expect: => i=0 r=0.0 ok=false s="sequence uniform: 0" errors=1 n=4 res=[1,3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let diff = ${step_diff};
	var ok = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] != diff {
			ok = false;
			break;
		}
		i++;
	}
	if !ok {
		gold_fail(g, "sequence non-uniform");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "sequence uniform: ", out.i);
	out
}
@end
