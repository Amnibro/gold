	var cur_len = 0;
	var words = 0;
	gold_clear(g);
	for b in out.s {
		if b == ' ' || b == '\t' || b == '\n' {
			if cur_len > 0 {
				gold_push(g, cur_len);
				cur_len = 0;
				words++;
			}
