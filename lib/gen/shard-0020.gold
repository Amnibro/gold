code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n == 0 {
		gold_fail(g, "no observations");
		out.ok = false;
		return out;
	}
	let first = g.res[0];
	out.i = first;
	out.s.clear();
	if first >= mv {
		format(out.s, "checkpoint ", first, " above ", mv);
	} else {
		format(out.s, "checkpoint ", first, " below ", mv);
	}
	g.steps += 1;
	out
}
@end
