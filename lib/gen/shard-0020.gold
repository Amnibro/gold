fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_keep = ${limit};
	for i in g.n {
		var min_ix = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_ix] { min_ix = j; }
		}
		if min_ix != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_ix];
			g.res[min_ix] = tmp;
		}
	}
	let start_pos = if g.n > max_keep { g.n - max_keep } else { 0 };
	let count = g.n - start_pos;
	for k in count {
		g.res[k] = g.res[start_pos + k];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " maximum values");
	out
}
