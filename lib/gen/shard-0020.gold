fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	for i in len {
		for j in len - 1 {
			if out.s[j] > out.s[j + 1] {
				let tmp = out.s[j];
				out.s[j] = out.s[j + 1];
				out.s[j + 1] = tmp;
			}
		}
	}
	g.steps += len * len;
	out.i = len;
	out
}
