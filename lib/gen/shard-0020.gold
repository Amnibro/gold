	let att = ${attempts};
	var total_retries = 0;
	for i in g.n {
		for k in att {
			g.res[i] += 1;
			total_retries++;
		}
	}
	g.steps += total_retries + 1;
	out.i = total_retries;
	out.s.clear();
	format(out.s, "retried item each");
	out
}
@end
@entry 580f6b4c43316e16
kind: step
verb: retry
noun: window
modifier: sorted
context: loop
phrase: retry sorted window check with size {win}
phrase: verify sorted windows repeatedly with width {win}
slot: win int
test: list=1,2,3,2,5 win=3
expect: => i=1 r=0.0 ok=true s="retried window sorted" errors=0 n=6 res=[1,2,3,2,5,3] cache=0 hits=0
test: list=10,20,30,40 win=3
expect: => i=2 r=0.0 ok=true s="retried window sorted" errors=0 n=6 res=[10,20,30,40,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 1 || w > g.n { return out; }
	var sorted_windows = 0;
	var i = 0;
	while i + w <= g.n {
		var is_sorted = true;
		for j in (w - 1) {
			if g.res[i + j] > g.res[i + j + 1] {
				is_sorted = false;
				break;
			}
		}
		if is_sorted {
			sorted_windows++;
			gold_push(g, g.res[i + w - 1]);
		}
		i++;
	}
	g.steps += g.n + 1;
	out.i = sorted_windows;
	out.s.clear();
	format(out.s, "retried window sorted");
	out
}
@end
