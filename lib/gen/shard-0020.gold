phrase: search sorted series for {target}
phrase: locate entry in sorted series matching {target}
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="search series found index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25 target=40
expect: => i=-1 r=0.0 ok=true s="search series found index -1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == t {
			found = mid;
			break;
		} else if g.res[mid] < t {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	g.steps += 1;
	out.i = found;
	out.s.clear();
	format(out.s, "search series found index ", found);
	out
}
@end
