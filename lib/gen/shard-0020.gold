phrase: calculate pairwise delta budget bounded by {budget}
slot: budget int
test: list=10,14,18,25 budget=5
expect: => i=2 r=0.0 ok=true s="measured budget pairwise" errors=0 n=6 res=[10,14,18,25,4,4] cache=0 hits=0
test: list=20,30,35,42 budget=8
expect: => i=2 r=0.0 ok=true s="measured budget pairwise" errors=0 n=6 res=[20,30,35,42,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let orig_n = g.n;
	var ok_pairs = 0;
	var i = 1;
	while i < orig_n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff >= 0 { diff } else { -diff };
		if abs_diff <= b {
			gold_push(g, abs_diff);
			ok_pairs++;
		}
		i++;
	}
	g.steps += orig_n + 1;
	out.i = ok_pairs;
	out.s.clear();
	format(out.s, "measured budget pairwise");
	out
}
@end
