noun: function
modifier: first
context: aggregate
phrase: drop function first match satisfying {cond}
phrase: remove initial element matching predicate {cond}
slot: cond pred
test: cond=is_even list=1,4,6,7
expect: => i=1 r=0.0 ok=true s="dropped function first" errors=0 n=3 res=[1,6,7] cache=0 hits=0
test: cond=is_even list=1,3,5
expect: => i=0 r=0.0 ok=true s="dropped function first" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: drop function first
	var out = v;
	var target_idx = -1;
	for i in g.n {
		if target_idx < 0 && ${cond}(g.res[i]) {
			target_idx = i;
		}
	}
	if target_idx >= 0 {
		for i in (g.n - target_idx - 1) {
			g.res[target_idx + i] = g.res[target_idx + 1 + i];
		}
		g.n -= 1;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "dropped function first");
	out
}
@end
