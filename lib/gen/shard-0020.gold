	var run_pairs = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] { run_pairs++; }
			i++;
		}
	}
	if run_pairs == 0 { g.hits++; }
	g.steps += g.n + 1;
	out.i = run_pairs;
	out.s.clear();
	format(out.s, "paired identical runs count: ", run_pairs);
	out
}
@end
