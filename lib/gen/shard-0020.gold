fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var max_streak = 0;
	var cur_streak = 1;
	if g.n > 0 {
		for k in g.n - 1 {
			if g.res[k + 1] == g.res[k] + 1 {
				cur_streak++;
			} else {
				if cur_streak > max_streak { max_streak = cur_streak; }
				cur_streak = 1;
			}
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
	}
	let score = if max_streak >= mr { max_streak } else { 0 };
	g.steps += g.n;
	out.i = score;
	out.s.clear();
	format(out.s, "ranked streak score ", score);
	out
}
@end
