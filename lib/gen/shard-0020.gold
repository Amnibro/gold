@entry 0971d228eed998a5
kind: step
verb: drop
noun: histogram
modifier: nested
context: aggregate
phrase: drop histogram nested removing modal values
phrase: strip most common elements from results
test: list=2,2,3,4,4,4
expect: => i=3 r=0.0 ok=true s="dropped histogram nested" errors=0 n=3 res=[2,2,3] cache=0 hits=0
test: list=5,5,5,6
expect: => i=3 r=0.0 ok=true s="dropped histogram nested" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: drop histogram nested
	var out = v;
	var max_freq = 0;
	var mode_val = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq += 1;
			}
		}
		if freq > max_freq {
			max_freq = freq;
			mode_val = g.res[i];
		}
	}
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] != mode_val {
			g.res[write_idx] = g.res[i];
			write_idx += 1;
		} else {
			dropped += 1;
		}
	}
	g.n = write_idx;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped histogram nested");
	out
}
@end
@entry 26abcaae994bdc31
kind: step
verb: drop
noun: prefix
modifier: while
context: aggregate
phrase: drop prefix while matching {cond}
phrase: discard leading items while satisfying {cond}
slot: cond pred
test: cond=is_even list=2,4,6,7,8
expect: => i=3 r=0.0 ok=true s="dropped prefix while" errors=0 n=2 res=[7,8] cache=0 hits=0
