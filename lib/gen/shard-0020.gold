fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var pairs = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			let diff = if g.res[k + 1] >= g.res[k] { g.res[k + 1] - g.res[k] } else { g.res[k] - g.res[k + 1] };
			if diff <= tol {
				pairs++;
			}
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise close pairs ", pairs);
	out
}
