	format(out.s, "sorted gaps: [");
	for i in gaps.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, gaps[i]);
	}
	format(out.s, "]");
	out.i = gaps.len;
	g.steps += g.n;
	out
}
