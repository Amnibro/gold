code:
fn ${ID}(g Gold&, v Val) Val {
	// step: sum series none
	var out = v;
	var total = 0;
	for i in g.n {
		total += g.res[i];
		g.res[i] = total;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "summed series none");
	out
}
@end
@entry e64dc8c92c884463
kind: step
verb: fill
noun: tail
modifier: nested
context: aggregate
phrase: fill tail nested by duplicating last item {count} times
phrase: extend tail elements {count} times nested
slot: count int
test: count=3 list=1,2,5
expect: => i=3 r=0.0 ok=true s="filled tail nested" errors=0 n=6 res=[1,2,5,5,5,5] cache=0 hits=0
test: count=2 list=10
expect: => i=2 r=0.0 ok=true s="filled tail nested" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: fill tail nested
	var out = v;
	if g.n > 0 {
		let last_item = g.res[g.n - 1];
		let k = ${count};
		for i in k {
			gold_push(g, last_item);
		}
		out.i = k;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "filled tail nested");
	out
}
@end
