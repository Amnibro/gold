fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[>..] = [];
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for u in unique {
			if u == x { seen = true; break; }
		}
		if !seen {
			unique.push(x);
			sum += x;
		}
	}
	out.s.clear();
	format(out.s, "deduped: [");
	for i in unique.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, unique[i]);
	}
	format(out.s, "] sum=", sum);
	out.i = sum;
	g.steps += g.n;
	out
}
@end
