code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 || ${r} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${r};
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * ${r};
		let rad = 1.8 + gold_hash01(q, 3, ${u}) * 1.2;
		o.clear();
		gold_dnews(g, "hill", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("6");
		o.append(" r");
		gold_fnum(o, rad);
		o.append(" m:matte ");
		gold_hex(o, 85, 122, 62);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "seeded ridge hills");
	out
}
@end
@entry 5cd8815c7048794b
kind: step
verb: filter
noun: text
modifier: sorted
context: format
phrase: format filtered text sorted alphabetically
phrase: render filtered sorted characters buffer
phrase: display text filtered in sorted order
test: text="banana"
expect: => i=6 r=0.0 ok=true s="sorted text: aaabnn" errors=0 n=0 res=[] cache=0 hits=0
test: text="Format"
expect: => i=6 r=0.0 ok=true s="sorted text: afmort" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var chars byte[>..] = [];
	for b in v.s {
		if b >= 'a' && b <= 'z' { chars.push(b); }
		else if b >= 'A' && b <= 'Z' { chars.push(b + 32); }
	}
	if chars.len > 1 {
		for i in chars.len {
			for j in chars.len - 1 {
				if chars[j] > chars[j + 1] {
					let tmp = chars[j];
					chars[j] = chars[j + 1];
					chars[j + 1] = tmp;
				}
			}
		}
	}
	out.s.clear();
	format(out.s, "sorted text: ", chars);
	out.i = chars.len;
	g.steps += chars.len;
	out
}
@end
