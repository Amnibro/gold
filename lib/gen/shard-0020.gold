fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var pairs = 0;
	for i in 0 .. g.n - 1 {
		let s = g.res[i] + g.res[i + 1];
		gold_cache_put(g, i, s);
		pairs++;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pair_runs_with_cache: ", pairs);
