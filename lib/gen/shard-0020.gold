test: list=3,9,1,4
expect: => i=9 r=0.0 ok=true s="shifted max 9 to front" errors=0 n=4 res=[9,3,1,4] cache=0 hits=0
test: list=5,2,8,12
expect: => i=12 r=0.0 ok=true s="shifted max 12 to front" errors=0 n=4 res=[12,5,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	let max_val = g.res[max_idx];
	var k = max_idx;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = max_val;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "shifted max ", max_val, " to front");
	out
}
@end
