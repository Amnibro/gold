	var dropped = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] > th {
			dropped++;
		}
		i += 2;
	}
	if dropped > 0 {
		g.cn = 0;
	}
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "pairwise cache drops: ", dropped);
	out
}
@end
@entry 5c79111f530f985f
kind: step
verb: split
noun: primes
modifier: last
context: loop
phrase: split primes last {count} items
phrase: extract prime numbers from last {count} elements
slot: count int
test: list=4,6,7,11,13 count=4
expect: => i=3 r=0.0 ok=true s="split primes from tail: 3" errors=0 n=5 res=[4,6,7,11,13] cache=0 hits=0
test: list=2,3,4,5 count=2
expect: => i=1 r=0.0 ok=true s="split primes from tail: 1" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let cnt = ${count};
	var primes_found = 0;
	let start = if g.n > cnt { g.n - cnt } else { 0 };
	for i in start..g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { primes_found++; }
	}
	g.steps += g.n;
	out.i = primes_found;
	out.s.clear();
	format(out.s, "split primes from tail: ", primes_found);
	out
}
@end
@entry 6f0e09662a920cc8
kind: step
verb: limit
noun: streak
modifier: last
context: loop
phrase: limit streak last elements to {max_streak}
phrase: truncate tail streak at {max_streak}
slot: max_streak int
test: list=1,2,5,5,5,5 max_streak=2
expect: => i=4 r=0.0 ok=true s="limited tail streak length: 4" errors=0 n=4 res=[1,2,5,5] cache=0 hits=0
test: list=10,20,20,20 max_streak=1
expect: => i=2 r=0.0 ok=true s="limited tail streak length: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let ms = ${max_streak};
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var streak = 0;
		var idx = g.n - 1;
		while idx >= 0 && g.res[idx] == last_val {
			streak++;
			idx--;
		}
		if streak > ms {
			g.n -= (streak - ms);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited tail streak length: ", g.n);
	out
}
@end
