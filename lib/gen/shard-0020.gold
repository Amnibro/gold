	var out = v;
	let ceil = ${ceiling};
	var best = -1;
	for k in g.n {
		if g.res[k] <= ceil && g.res[k] > best {
			best = g.res[k];
		}
	}
	g.steps += g.n;
	out.i = best;
	out.s.clear();
	format(out.s, "search up to ceiling result ", best);
	out
}
