fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var pairs = 0;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] <= g.res[i + 1] {
			g.res[i] *= m;
		} else {
			g.res[i + 1] *= m;
		}
		pairs++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "scaled minimum pairwise");
	out
}
@end
