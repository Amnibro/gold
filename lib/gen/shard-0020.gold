code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = 0;
	while len < g.n && ${cond}(g.res[len]) {
		len++;
	}
	for i in len / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[len - 1 - i];
		g.res[len - 1 - i] = tmp;
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "history reversed length: ", len);
	out
}
@end
