test: list=10,20,30,15,25 key=18
expect: => i=3 r=0.0 ok=true s="cached longest streak: 3" errors=0 n=5 res=[10,20,30,15,25] cache=1 hits=0
test: list=5,4,3,2 key=18
expect: => i=1 r=0.0 ok=true s="cached longest streak: 1" errors=0 n=4 res=[5,4,3,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var max_streak = 0;
	var cur_streak = 0;
	if g.n > 0 {
		max_streak = 1;
		cur_streak = 1;
	}
	for i in 1 .. g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	gold_cache_put(g, k, max_streak);
	g.steps += g.n + 1;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "cached longest streak: ", max_streak);
	out
}
@end
