code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var cnt = 0;
	for k in g.cn {
		if g.cv[k] < lim {
			cnt++;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "found ", cnt, " memo entries under limit");
	out
}
@end
