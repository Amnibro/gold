fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var clamped = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > limit {
			g.res[k] = g.res[k - 1] + limit;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " deltas");
	out
}
@end
