@entry e1b8d0ba041e114c
kind: step
verb: drop
noun: evens
modifier: while
context: loop
phrase: drop evens while sum remains under {limit}
phrase: discard leading evens while under {limit}
slot: limit int
test: list=2,4,6,5,8 limit=8
expect: => i=2 r=0.0 ok=true s="dropped leading evens: 2" errors=0 n=3 res=[6,5,8] cache=0 hits=0
test: list=10,20,3 limit=15
expect: => i=1 r=0.0 ok=true s="dropped leading evens: 1" errors=0 n=2 res=[20,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let lim = ${limit};
	var sum = 0;
	var drop_count = 0;
	while drop_count < g.n {
		if g.res[drop_count] % 2 == 0 && sum + g.res[drop_count] <= lim {
			sum += g.res[drop_count];
			drop_count++;
		} else {
			break;
		}
	}
	for i in drop_count..g.n {
		g.res[i - drop_count] = g.res[i];
	}
	g.n -= drop_count;
	g.steps += drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped leading evens: ", drop_count);
	out
}
@end
