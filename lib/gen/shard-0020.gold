@entry 297aca51167963e5
kind: step
verb: limit
noun: gaps
modifier: safely
context: core
phrase: limit gaps safely with step {step}
phrase: restrict gaps safely to step {step}
slot: step int
test: list=0,15,35 step=10
expect: => i=2 r=0.0 ok=true s="clamped 2 excessive steps" errors=0 n=3 res=[0,10,20] cache=0 hits=0
test: list=2,4,6 step=5
expect: => i=0 r=0.0 ok=true s="clamped 0 excessive steps" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var fixed = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > s {
			g.res[k] = g.res[k - 1] + s;
			fixed++;
		}
	}
	g.steps += g.n;
	out.i = fixed;
	out.s.clear();
	format(out.s, "clamped ", fixed, " excessive steps");
	out
}
@end
