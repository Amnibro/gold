@entry 2a405fcd4febf105
kind: step
verb: reverse
noun: primes
modifier: in_reverse
context: aggregate
phrase: reverse prime numbers in backwards order
phrase: filter primes in reverse sequence
test: list=2,4,5,8,7,11
expect: => i=4 r=0.0 ok=true s="reverse_primes_in_reverse: 4" errors=0 n=4 res=[11,7,5,2] cache=0 hits=0
test: list=3,9,13,17,20
expect: => i=3 r=0.0 ok=true s="reverse_primes_in_reverse: 3" errors=0 n=3 res=[17,13,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	for i in 0 .. g.n {
		let num = g.res[i];
		var is_p = true;
		if num < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[k] = num;
			k++;
		}
	}
	g.n = k;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse_primes_in_reverse: ", g.n);
	out
}
@end
