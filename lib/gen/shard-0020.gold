fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${lo};
	let upper = ${hi};
	for i in g.n {
		var p = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[p] { p = j; }
		}
		if p != i {
			let tmp = g.res[i];
			g.res[i] = g.res[p];
			g.res[p] = tmp;
		}
	}
	for k in g.n {
		var x = g.res[k];
		if x < lower { x = lower; }
		if x > upper { x = upper; }
		g.res[k] = x;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted items into range");
	out
}
@end
