test: text="quick brown fox"
expect: => i=3 r=0.0 ok=true s="fox brown quick" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world"
expect: => i=2 r=0.0 ok=true s="world hello" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in out.s.len {
		if out.s[i] == ' ' { count++; }
	}
	g.steps += out.s.len + 1;
	out.i = count + 1;
	var rev byte[>..] = [];
	var idx = out.s.len - 1;
	while idx >= 0 {
		var word_end = idx;
		while idx >= 0 && out.s[idx] != ' ' { idx--; }
		var k = idx + 1;
		while k <= word_end {
			rev.push(out.s[k]);
			k++;
		}
		if idx >= 0 {
			rev.push(' ');
			idx--;
		}
	}
	out.s.clear();
	for b in rev { out.s.push(b); }
	out
}
@end
