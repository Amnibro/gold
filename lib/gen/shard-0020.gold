fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var ok = true;
	for i in 0 .. (g.n - 1) {
		var delta = g.res[i + 1] - g.res[i];
		if delta < 0 { delta = -delta; }
		if delta > d {
