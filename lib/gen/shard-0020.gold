kind: step
verb: carve
noun: rocks
modifier: seeded
context: env
slot: n int
slot: r real
slot: u int
phrase: carve {n} seeded rocks with radius {r} seed {u}
phrase: place {n} seeded rock formations radius {r} seed {u}
test: n=2 r=1.5 u=7
expect: => i=2 r=0.0 ok=true s="carverocks" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock1 sphere 3.599,2.352,.5 r1.695 nz.04:.2 m:matte #8a8580
expect: => doc: rock2 sphere -0.028,0.049,.5 r1.621 nz.04:.2 m:matte #8a8580
test: n=1 r=2.0 u=3 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="carverocks" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: rock3 sphere -0.483,-3.168,.5 r2.364 nz.04:.2 m:matte #8a8580
test: n=0 r=1.5 u=7
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 || ${r} <= 0.0 {
		gold_fail(g, "count or radius out of range");
		out.ok = false;
		return out;
	}
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * 4.0;
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * 4.0;
		let sz = ${r} * (0.8 + gold_hash01(q, 3, ${u}) * 0.4);
		o.clear();
		gold_dnews(g, "rock", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("5");
		o.append(" r");
		gold_fnum(o, sz);
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "carverocks");
	out
}
@end
