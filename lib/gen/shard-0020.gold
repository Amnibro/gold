fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ck = ${cache_key};
	let cached_val, has = gold_cache_get(g, ck);
	var target = if has { cached_val } else { 20 };
	var kept = 0;
	for k in g.n {
		if g.res[k] == target {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	gold_cache_put(g, ck, target);
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected cache loop items: ", kept);
	out
}
