test: arg=12,7 max_steps=3
expect: 10
expect: 34
test: arg=19,5 max_steps=2
expect: 29
expect: 8
code:
fn ${ID}(n int) int {
	let ms = ${max_steps};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0; }
	var k = 0;
	while k < ms && x > 1 {
		if x % 2 == 0 { x /= 2; }
		else { x = x * 3 + 1; }
		k++;
	}
	x
}
@end
