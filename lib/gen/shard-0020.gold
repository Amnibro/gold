code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two elements for pairwise sum");
		out.ok = false;
		return out;
	}
	for i in 0..(g.n - 1) {
		g.res[i] = g.res[i] + g.res[i + 1];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed ", g.n, " pairwise sums");
	out
}
@end
