fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_pos = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_pos] { min_pos = j; }
		}
		if min_pos != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_pos];
			g.res[min_pos] = tmp;
		}
	}
	let num_diffs = if g.n > 1 { g.n - 1 } else { 0 };
	for k in num_diffs {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n = num_diffs;
	g.steps += num_diffs;
	out.i = num_diffs;
	out.s.clear();
	format(out.s, "computed ", num_diffs, " pairwise differences");
