code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sh = ${max_shift};
	if g.n == 0 { return out; }
	if sh > g.n { sh = g.n; }
	if sh < 0 { sh = 0; }
	for s in sh {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += sh;
	out.i = sh;
	out.s.clear();
	format(out.s, "words shifted: ", sh);
	out
}
@end
