noun: gaps
modifier: between
context: core
phrase: limit gaps between adjacent values {max_gap}
phrase: cap separation between items {max_gap}
slot: max_gap int
test: list=5,20,22,50 max_gap=10
expect: => i=2 r=0.0 ok=true s="limited 2 gaps" errors=0 n=4 res=[5,15,22,32] cache=0 hits=0
test: list=1,2,3,4 max_gap=5
expect: => i=0 r=0.0 ok=true s="limited 0 gaps" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var adjusted = 0;
	for k in 1..g.n {
		if g.res[k] - g.res[k - 1] > mg {
			g.res[k] = g.res[k - 1] + mg;
			adjusted++;
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "limited ", adjusted, " gaps");
	out
}
@end
