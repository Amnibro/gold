code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = 0;
	for b in out.s {
		if b == 'a' || b == 'A' { seen |= 1; }
		else if b == 'e' || b == 'E' { seen |= 2; }
		else if b == 'i' || b == 'I' { seen |= 4; }
		else if b == 'o' || b == 'O' { seen |= 8; }
		else if b == 'u' || b == 'U' { seen |= 16; }
	}
	var count = 0;
	while seen > 0 {
		if (seen & 1) != 0 { count++; }
		seen >>= 1;
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "map_vowels_unique: ", count);
	out
}
@end
