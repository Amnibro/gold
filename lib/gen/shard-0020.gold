@entry a5e9f2b6a246f087
kind: fn
verb: swap
noun: letters
modifier: first
context: loop
phrase: swap letters first digits loop {shift}
phrase: transpose initial digit letters by {shift}
slot: shift int
test: arg=42,71 shift=5
expect: 29
expect: 22
test: arg=83,59,64 shift=10
expect: 48
expect: 105
expect: 56
code:
fn ${ID}(n int) int {
	let sh = ${shift};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x + sh; }
	var p = 1;
	while p * 10 <= x {
		p *= 10;
	}
	let d1 = x / p;
	let rem1 = x % p;
	let p2 = p / 10;
	let d2 = rem1 / p2;
	let rest = rem1 % p2;
	let swapped = d2 * p + d1 * p2 + rest;
	swapped + sh
}
@end
