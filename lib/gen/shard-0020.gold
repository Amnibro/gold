	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:glass ");
	gold_hex(o, 32, 96, 144);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "raisepond");
	out
}
