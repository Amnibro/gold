code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let lim = ${max_val};
	for i in g.n {
		var x = g.res[i] * f;
		if x > lim { x = lim; }
		g.res[i] = x;
	}
	g.steps += g.n;
	if g.n > 0 { out.i = g.res[0]; }
	out.s.clear();
	format(out.s, "range scaled at most: ", lim);
	out
}
@end
