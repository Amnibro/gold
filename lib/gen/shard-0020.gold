fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_len = 0;
	var cur_len = 0;
	for i in g.n {
		if g.res[i] > 0 {
			cur_len++;
			if cur_len > max_len {
				max_len = cur_len;
			}
		} else {
			cur_len = 0;
		}
	}
	if max_len > lim {
		max_len = lim;
	}
	g.steps += g.n;
	out.i = max_len;
	out.s.clear();
	format(out.s, "longest positive streak ", max_len);
	out
}
@end
