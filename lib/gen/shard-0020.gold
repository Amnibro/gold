@entry 459cbb6168c8329d
kind: step
verb: split
noun: maximum
modifier: in_reverse
context: stats
phrase: split dataset keeping backwards elements up to maximum
phrase: retain reverse sequence until reaching maximum
test: list=10,30,5
expect: => i=2 r=0.0 ok=true s="retained 2 elements backwards to maximum" errors=0 n=2 res=[5,30] cache=0 hits=0
test: list=1,2
expect: => i=1 r=0.0 ok=true s="retained 1 elements backwards to maximum" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty dataset");
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var tmp = [0; 512];
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		tmp[count] = g.res[k];
		count++;
		if g.res[k] == max_val {
			break;
		}
	}
	for i in count {
		g.res[i] = tmp[i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "retained ", count, " elements backwards to maximum");
	out
}
@end
