fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var tally = 0;
	for i in g.n {
		if g.res[i] > 0 { tally++; }
	}
	if tally != exp {
		gold_fail(g, "tally mismatch");
		out.ok = false;
	}
	out.i = tally;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "tally validated: ", tally);
	out
}
@end
@entry b7ec45bfecced28d
kind: step
verb: keep
noun: loop
modifier: with_cache
context: core
slot: key int
phrase: keep loop with cache key {key}
phrase: preserve loop items using cache key {key}
test: list=1,5,10,15,20 key=8
expect: => i=3 r=0.0 ok=true s="kept in loop: 3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=2,4,6,8 key=5
expect: => i=2 r=0.0 ok=true s="kept in loop: 2" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, ok = gold_cache_get(g, k);
	let thresh = if ok { val } else { k };
	var kept = 0;
	for i in g.n {
		if g.res[i] >= thresh {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept in loop: ", kept);
	out
}
@end
@entry 1c4a3dcaf2eac413
kind: step
verb: group
noun: spaces
modifier: at_most
context: core
slot: max_size int
phrase: group spaces at most size {max_size}
phrase: chunk spaces at most partition {max_size}
test: list=1,2,3,4,5,6 max_size=2
expect: => i=3 r=0.0 ok=true s="spaces grouped: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 max_size=3
expect: => i=2 r=0.0 ok=true s="spaces grouped: 2" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${max_size};
	if sz <= 0 || g.n == 0 { return out; }
	var chunks = 0;
	var i = 0;
	var out_res = [0; 512];
	while i < g.n {
		var sum = 0;
		for j in sz {
			if i + j < g.n {
				sum += g.res[i + j];
			}
		}
		out_res[chunks] = sum;
		chunks++;
		i += sz;
	}
	for c in chunks {
		g.res[c] = out_res[c];
	}
	g.n = chunks;
	g.steps += g.n;
	out.i = chunks;
	out.s.clear();
	format(out.s, "spaces grouped: ", chunks);
	out
}
@end
