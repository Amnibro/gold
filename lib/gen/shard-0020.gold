@entry fa0f1b0a92dca83e
kind: step
verb: clamp
noun: step
modifier: nested
context: core
slot: lo int
slot: hi int
phrase: clamp step nested values across range {lo} to {hi}
phrase: restrict step nested range from {lo} to {hi}
test: list=5,15,25,35 lo=10 hi=30
expect: => i=30 r=0.0 ok=true s="step clamped to range: 30" errors=0 n=4 res=[10,15,25,30] cache=0 hits=0
test: list=1,2,3,4 lo=2 hi=3
expect: => i=3 r=0.0 ok=true s="step clamped to range: 3" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	for i in g.n {
		var x = g.res[i];
		if x < low { x = low; }
		if x > high { x = high; }
		g.res[i] = x;
	}
	g.steps += g.n;
	if g.n > 0 { out.i = g.res[g.n - 1]; }
	out.s.clear();
	format(out.s, "step clamped to range: ", high);
	out
}
@end
@entry afd9484d54d1fdcb
kind: step
verb: shift
noun: minimum
modifier: last
context: core
phrase: shift minimum last position in sequence
phrase: move minimum value to last index
test: list=5,1,4,2,3
expect: => i=1 r=0.0 ok=true s="minimum shifted: 1" errors=0 n=5 res=[5,4,2,3,1] cache=0 hits=0
test: list=10,20,30,5
expect: => i=5 r=0.0 ok=true s="minimum shifted: 5" errors=0 n=4 res=[10,20,30,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var i = min_idx;
	while i < g.n - 1 {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[g.n - 1] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum shifted: ", min_val);
	out
}
@end
