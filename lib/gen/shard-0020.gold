code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least 3 elements");
		out.ok = false;
		return out;
	}
	let c = ${cutoff};
	var shifted = 0;
	for i in 1..(g.n - 1) {
		if g.res[i] < c {
			g.res[i] += 1;
			shifted++;
		}
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted, " central values");
	out
}
@end
