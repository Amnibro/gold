fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var count = 0;
	for b in v.s {
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	if count < mc {
		out.ok = false;
		gold_fail(g, "insufficient letter count");
	}
	out.s.clear();
	format(out.s, "letter count: ", count);
	out
}
@end
@entry db20afaea337507d
kind: step
verb: sort
noun: letters
modifier: first
context: filter
slot: count int
phrase: sort letters first leading characters count {count}
phrase: order initial letters first partition size {count}
test: text="dcaebf" count=4
expect: => i=4 r=0.0 ok=true s="acdebf" errors=0 n=0 res=[] cache=0 hits=0
test: text="zyxwv" count=3
expect: => i=3 r=0.0 ok=true s="xyzwv" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var letters byte[>..] = [];
	for b in v.s {
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			letters.push(b);
		}
	}
	var k = c;
	if k > letters.len { k = letters.len; }
	for i in k {
		var j = i + 1;
		while j < k {
			if letters[j] < letters[i] {
				let tmp = letters[i];
				letters[i] = letters[j];
				letters[j] = tmp;
			}
			j++;
		}
	}
	out.s.clear();
	for b in letters { out.s.push(b); }
	out.i = k;
	g.steps += k;
	out
}
@end
