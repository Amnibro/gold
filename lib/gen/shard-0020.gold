expect: 525
expect: 11
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	if x < 10 { return x; }
	var digits = [0; 16];
	var count = 0;
	while x > 0 && count < 16 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	if digits[0] != digits[count - 1] {
		let tmp = digits[0];
		digits[0] = digits[count - 1];
		digits[count - 1] = tmp;
	}
	var out = 0;
	var k = count - 1;
	while k >= 0 {
		out = out * 10 + digits[k];
		k--;
	}
	out
}
@end
