code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var half = g.n / 2;
	if half < 2 { half = g.n; }
	for i in 0 .. half {
		for j in i + 1 .. half {
			if g.res[j] > g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n;
	out.i = half;
	out.s.clear();
	format(out.s, "rank_prefix_first: ", half);
	out
}
@end
@entry 37f826891327f5a1
kind: step
verb: find
noun: histogram
modifier: in_place
context: sort
phrase: find histogram in place for frequencies
phrase: calculate frequency histogram in place
test: list=4,2,4,3,2
expect: => i=3 r=0.0 ok=true s="computed histogram of 3 distinct values" errors=0 n=3 res=[2,1,2] cache=0 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="computed histogram of 1 distinct values" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var distinct = 0;
	var i = 0;
	while i < g.n {
		var count = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			count++;
			i++;
		}
		g.res[distinct] = count;
		distinct++;
		i++;
	}
	g.steps += g.n * g.n;
	g.n = distinct;
	out.i = distinct;
	out.s.clear();
	format(out.s, "computed histogram of ", distinct, " distinct values");
	out
}
@end
