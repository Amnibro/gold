test: list=1,1,1,2,2,3
expect: => i=3 r=0.0 ok=true s="cached 3 run lengths" errors=0 n=6 res=[1,1,1,2,2,3] cache=3 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="cached 1 run lengths" errors=0 n=4 res=[5,5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty dataset for runs");
		return out;
	}
	var num_runs = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			gold_cache_put(g, num_runs, cur_len);
			num_runs++;
			cur_len = 1;
		}
	}
	gold_cache_put(g, num_runs, cur_len);
	num_runs++;
	g.steps += g.n;
	out.i = num_runs;
	out.s.clear();
	format(out.s, "cached ", num_runs, " run lengths");
	out
}
@end
