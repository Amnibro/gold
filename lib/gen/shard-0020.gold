@entry 3c7e8a68e1f70fc4
kind: step
verb: dedupe
noun: step
modifier: none
context: retry
slot: budget int
phrase: dedupe step none skipped within budget {budget}
phrase: eliminate duplicates across steps with budget {budget}
test: list=1,2,2,3,4,4 budget=10
expect: => i=4 r=0.0 ok=true s="deduped step count 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5 budget=5
expect: => i=1 r=0.0 ok=true s="deduped step count 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var w = 0;
	var steps = 0;
	for r in g.n {
		if steps >= b {
			g.res[w] = g.res[r];
			w++;
			continue;
		}
		var dup = false;
		for i in w {
			steps++;
			if g.res[i] == g.res[r] { dup = true; break; }
		}
		if !dup {
			g.res[w] = g.res[r];
			w++;
		}
	}
	g.n = w;
	g.steps += steps;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped step count ", w);
	out
}
@end
