code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_gap};
	out.s.clear();
	format(out.s, "gaps: [");
	var count = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= lim {
			if count > 0 { format(out.s, ", "); }
			format(out.s, diff);
			count++;
		}
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
