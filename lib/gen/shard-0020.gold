model: noise c=8 u=${u}; contrast a=1.24; quantize n=6
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=45951 hash=634027
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=113934 hash=519870
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 8, g.iw / 8, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.24 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (6 as real)) as! int;
		if t > 6 - 1 { t = 6 - 1; }
		g.img[k] = (t as real) / ((6 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "grime");
	out
}
@end
