phrase: group duplicates recursively within margin {threshold}
phrase: cluster duplicate error codes recursively under {threshold}
test: list=10,11,20,22,30 threshold=2
expect: => i=2 r=0.0 ok=true s="grouped duplicates recursively 2" errors=0 n=5 res=[10,11,20,22,30] cache=0 hits=0
test: list=5,15,25 threshold=1
expect: => i=0 r=0.0 ok=true s="grouped duplicates recursively 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var clustered = 0;
	if g.n > 1 {
		for k in 1 .. g.n {
			let diff = if g.res[k] >= g.res[k - 1] { g.res[k] - g.res[k - 1] } else { g.res[k - 1] - g.res[k] };
			if diff <= th {
				clustered++;
			}
		}
	}
	g.steps += g.n;
	out.i = clustered;
	out.s.clear();
	format(out.s, "grouped duplicates recursively ", clustered);
	out
}
@end
