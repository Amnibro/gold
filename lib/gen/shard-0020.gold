fn ${ID}(g Gold&, v Val) Val {
	// step: normalize average between
	var out = v;
	var sum = 0;
	var count = 0;
	let low = ${lo};
	let high = ${hi};
	for i in g.n {
		if g.res[i] >= low && g.res[i] <= high {
			sum += g.res[i];
			count += 1;
		}
	}
	out.i = if count > 0 { sum / count } else { 0 };
	out.s.clear();
	format(out.s, "normalized average between");
	out
}
@end
