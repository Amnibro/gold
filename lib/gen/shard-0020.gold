@entry 48ccefdcc8b7e44d
kind: step
verb: shift
noun: step
modifier: times
context: loop
phrase: shift step sequence {shifts} times
phrase: rotate steps cycle {shifts} positions
slot: shifts int
test: list=1,2,3,4,5 shifts=2
expect: => i=2 r=0.0 ok=true s="shifted step times: 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 shifts=1
expect: => i=1 r=0.0 ok=true s="shifted step times: 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let s = ${shifts};
	if g.n > 0 {
		let rot = s % g.n;
		for r in rot {
			let first = g.res[0];
			for i in 1..g.n {
				g.res[i - 1] = g.res[i];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += s;
	out.i = s;
	out.s.clear();
	format(out.s, "shifted step times: ", s);
	out
}
@end
