@entry 7eeb79b587523367
kind: step
verb: apply
noun: digits
modifier: with_cache
context: sort
phrase: apply digit sum transformation with cache
phrase: replace sorted numbers by sum of digits with cache
test: list=15,23,8
expect: => i=19 r=0.0 ok=true s="applied digit sums with cache" errors=0 n=3 res=[8,6,5] cache=1 hits=0
test: list=42,11
expect: => i=8 r=0.0 ok=true s="applied digit sums with cache" errors=0 n=2 res=[2,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_loc = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_loc] { min_loc = j; }
		}
		if min_loc != i {
			let ex = g.res[i];
			g.res[i] = g.res[min_loc];
			g.res[min_loc] = ex;
		}
	}
	var total_digits = 0;
	for k in g.n {
		var num = g.res[k];
		var digit_sum = 0;
		while num > 0 {
			digit_sum += num % 10;
			num /= 10;
		}
		g.res[k] = digit_sum;
		total_digits += digit_sum;
	}
	g.cn++;
	g.steps += g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "applied digit sums with cache");
	out
}
@end
@entry 6f33bfab462d8632
kind: step
verb: compare
noun: words
modifier: at_least
context: sort
phrase: compare word count against threshold at least
phrase: check if sorted elements meet at least {min} words
slot: target text
slot: min int
test: list=6,2 target="foo bar baz" min=2
expect: => i=1 r=0.0 ok=true s="word count met threshold" errors=0 n=2 res=[2,6] cache=0 hits=0
test: list=5,1 target="hello" min=3
expect: => i=0 r=0.0 ok=true s="word count below threshold" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let words_str = ${target};
	let min_threshold = ${min};
	for i in g.n {
		var idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[idx] { idx = j; }
		}
		if idx != i {
			let tmp_val = g.res[i];
			g.res[i] = g.res[idx];
			g.res[idx] = tmp_val;
		}
	}
	var count_words = 0;
	var in_word = false;
	for ch in words_str {
		if ch != ' ' && ch != '	' {
			if !in_word {
				count_words++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	let passes = count_words >= min_threshold;
	g.steps += g.n;
	out.i = if passes { 1 } else { 0 };
	out.s.clear();
	if passes {
		format(out.s, "word count met threshold");
	} else {
		format(out.s, "word count below threshold");
	}
	out
}
@end
