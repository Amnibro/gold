noun: squares
modifier: until
context: filter
slot: target_count int
phrase: search squares until reaching count {target_count}
phrase: filter square numbers until target {target_count}
test: list=4,7,9,11,16,20,25 target_count=3
expect: => i=3 r=0.0 ok=true s="squares found: 3" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,3,9,15,25,36 target_count=2
expect: => i=2 r=0.0 ok=true s="squares found: 2" errors=0 n=2 res=[1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${target_count};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if kept < tc && x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "squares found: ", kept);
	out
}
@end
