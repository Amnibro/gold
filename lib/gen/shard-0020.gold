code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 0 {
		var mx = g.res[0];
		for i in g.n {
			if g.res[i] > mx { mx = g.res[i]; }
		}
		gold_clear(g);
		var cnt = t;
		if cnt > 100 { cnt = 100; }
		for k in cnt {
			gold_push(g, mx);
		}
		g.steps += cnt;
		out.i = mx;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "repeated max: ", out.i);
	out
}
@end
