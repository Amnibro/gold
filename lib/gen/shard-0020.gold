phrase: scale primes any matching entries by factor {factor} in list
phrase: multiply any prime numbers by scaling factor {factor} across list
test: list=4,5,6,7,8,9 factor=3
expect: => i=2 r=0.0 ok=true s="scaled primes count: 2" errors=0 n=6 res=[4,15,6,21,8,9] cache=0 hits=0
test: list=2,3,4,11 factor=2
expect: => i=3 r=0.0 ok=true s="scaled primes count: 3" errors=0 n=4 res=[4,6,4,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[k] = x * f;
				scaled++;
			}
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled primes count: ", scaled);
	out
}
@end
