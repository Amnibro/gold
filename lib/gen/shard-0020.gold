expect: => i=4 r=0.0 ok=true s="streak length: 4" errors=0 n=5 res=[3,3,3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_streak = 0;
	var cur_streak = 0;
	var prev = 0;
	for i in g.n {
		let x = g.res[i];
		if i == 0 || x != prev {
			prev = x;
			cur_streak = 1;
		} else {
			cur_streak++;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
	}
	if max_streak > lim { max_streak = lim; }
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "streak length: ", max_streak);
	out
}
@end
