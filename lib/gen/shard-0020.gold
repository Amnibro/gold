	o.push(' ');
	o.append("nz");
	gold_fnum(o, d);
	o.append(":.");
	o.append("4");
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "weatherfloor");
	out
}
@end
