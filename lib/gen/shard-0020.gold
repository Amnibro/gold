code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] > limit {
			gold_fail(g, "cap reached during run");
			break;
		}
		sum += g.res[k];
		count++;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed ", count, " safe numbers");
	out
}
@end
