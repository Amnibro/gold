kind: step
verb: drop
noun: pairs
modifier: in_place
context: stats
phrase: stats drop pairs in place across sample
phrase: remove consecutive equal pairs in place
test: list=10,10,20,30,30,40
expect: => i=2 r=0.0 ok=true s="dropped consecutive duplicates: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,1,2,2,3
expect: => i=2 r=0.0 ok=true s="dropped consecutive duplicates: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	var dropped = 0;
	for i in 1 .. g.n {
		if g.res[i] == g.res[i - 1] {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped consecutive duplicates: ", dropped);
	out
}
@end
