@entry 12cfd4d13a07c603
kind: step
verb: cache
noun: budget
modifier: every_other
context: error
slot: cost int
phrase: cache budget every other error cycle with cost {cost}
phrase: store error budget every other sample using cost {cost}
test: list=10,20,30,40,50 cost=5
expect: => i=3 r=0.0 ok=true s="cached every other budget 3" errors=0 n=5 res=[10,20,30,40,50] cache=3 hits=0
test: list=100,200 cost=25
expect: => i=1 r=0.0 ok=true s="cached every other budget 1" errors=0 n=2 res=[100,200] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cost};
	var saved = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i] - c;
		gold_cache_put(g, i, val);
		saved++;
		i += 2;
	}
	g.steps += saved;
	out.i = saved;
	out.s.clear();
	format(out.s, "cached every other budget ", saved);
	out
}
@end
