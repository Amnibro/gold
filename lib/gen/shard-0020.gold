@entry 5b89fa7993933180
kind: step
verb: validate
noun: primes
modifier: in_place
context: retry
slot: max_retries int
phrase: validate primes in place with budget {max_retries}
phrase: verify prime items in place within {max_retries} attempts
test: list=2,3,5,7 max_retries=5
expect: => i=4 r=0.0 ok=true s="validated primes count 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=2,4,5 max_retries=3
expect: => i=0 r=0.0 ok=false s="validated primes count 0" errors=1 n=3 res=[2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	var all_prime = true;
	for k in g.n {
		let x = g.res[k];
		if x < 2 { all_prime = false; break; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { all_prime = false; break; }
			d++;
		}
		if !all_prime { break; }
	}
	if !all_prime || mr <= 0 {
		gold_fail(g, "non prime found in validation");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = g.n;
	}
	out.s.clear();
	format(out.s, "validated primes count ", out.i);
	out
}
@end
@entry f97da8c0aad6ce47
kind: step
verb: search
noun: odds
modifier: with_cache
context: retry
slot: target int
phrase: search odd values with cache for {target}
phrase: locate odd numbers using cache for {target}
test: list=2,4,5,8,9 target=5
expect: => i=2 r=0.0 ok=true s="cached odd position 2" errors=0 n=5 res=[2,4,5,8,9] cache=1 hits=0
test: list=1,3,7 target=9
expect: => i=-1 r=0.0 ok=true s="cached odd position -1" errors=0 n=3 res=[1,3,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	let cached, hit = gold_cache_get(g, t);
	if hit {
		out.i = cached;
		out.s.clear();
		format(out.s, "cache hit odd position ", cached);
		return out;
	}
	var idx = -1;
	for k in g.n {
		if g.res[k] % 2 != 0 && g.res[k] == t {
			idx = k;
			break;
		}
	}
	gold_cache_put(g, t, idx);
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "cached odd position ", idx);
	out
}
@end
