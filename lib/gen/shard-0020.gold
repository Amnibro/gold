code:
fn ${ID}(g Gold&, v Val) Val {
	// step: limit history unique
	var out = v;
	var write_idx = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq += 1;
			}
		}
		if freq == 1 {
			g.res[write_idx] = g.res[i];
			write_idx += 1;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "limited history unique");
	out
}
@end
