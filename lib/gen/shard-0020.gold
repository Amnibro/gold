fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var revs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] > th {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			revs++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = revs;
	out.s.clear();
	format(out.s, "threshold pair reversals: ", revs);
	out
}
