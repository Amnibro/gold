@entry 9c00470cb73fc805
kind: fn
verb: scan
noun: maximum
modifier: pairwise
context: core
phrase: scan maximum pairwise product
phrase: find largest adjacent digit product
test: arg=1294,8371
expect: 36
expect: 24
test: arg=555,109
expect: 25
expect: 0
code:
fn ${ID}(n int) int {
	var x = n;
	if x < 0 { x = -x; }
	if x < 10 { return x; }
	var prev = x % 10;
	x /= 10;
	var best = 0;
	while x > 0 {
		let cur = x % 10;
		let p = cur * prev;
		if p > best { best = p; }
		prev = cur;
		x /= 10;
	}
	best
}
@end
@entry 1702f57ae6b71178
