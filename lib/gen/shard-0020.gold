code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for fill range");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	if last <= 0 {
		gold_fail(g, "non-positive range endpoint");
		out.ok = false;
		return out;
	}
	gold_clear(g);
	for k in 1..(last + 1) {
		gold_push(g, k);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled range of ", g.n, " values");
	out
}
@end
