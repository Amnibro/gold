code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	if g.n <= 1 { return out; }
	for pass in p {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
	}
	g.steps += p;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted subfunction items ", g.n);
	out
}
@end
