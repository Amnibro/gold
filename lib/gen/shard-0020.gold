fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = false;
	var nearest = 0;
	var min_dist = 1000000;
	for i in g.n {
		if g.res[i] == t {
			found = true;
			nearest = g.res[i];
			break;
		}
		var d = g.res[i] - t;
		if d < 0 { d = -d; }
		if d < min_dist {
			min_dist = d;
			nearest = g.res[i];
		}
	}
	g.steps += g.n;
	out.ok = true;
	out.i = nearest;
	out.s.clear();
	format(out.s, "searched checkpoint with retry: ", nearest);
	out
}
@end
