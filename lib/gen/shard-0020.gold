	if d <= 0.0 {
		gold_fail(g, "depth must be positive");
		out.ok = false;
		return out;
	}
	let k = gold_dfind(g);
	if k < 0 {
		gold_fail(g, "no floor found");
		out.ok = false;
		return out;
	}
