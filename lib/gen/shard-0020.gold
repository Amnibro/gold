fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var kept = 0;
	var prev = -999999;
	for k in g.n {
		if kept >= lim { break; }
		if kept == 0 || g.res[k] > prev {
			prev = g.res[k];
			g.res[kept] = prev;
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected streak length: ", kept);
	out
}
@end
@entry ad212e1c55734ee0
kind: fn
verb: collect
noun: head
modifier: until
context: transform
phrase: collect head until exceeding bound {limit}
phrase: gather head prefix while under limit {limit}
slot: limit int
test: arg=12345,6789 limit=25
expect: 12
expect: 6
test: arg=987,12 limit=5
expect: 0
expect: 1
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	if x <= 0 { return 0; }
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	var cur = 0;
	var last_valid = 0;
	var i = d.len - 1;
	while i >= 0 {
		cur = cur * 10 + d[i];
		if cur <= lim {
			last_valid = cur;
		} else {
			break;
		}
		i--;
	}
	last_valid
}
@end
@entry db0cd48455a6e30f
kind: fn
