code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var rev int[64];
	let orig_n = g.n;
	for i in orig_n {
		rev[i] = g.res[orig_n - 1 - i];
		gold_cache_put(g, i, rev[i]);
	}
	gold_clear(g);
	for i in orig_n {
		gold_push(g, rev[i]);
	}
	g.steps += orig_n * 2 + 1;
	out.i = orig_n;
	out.s.clear();
	format(out.s, "reversed step with cache");
	out
}
@end
