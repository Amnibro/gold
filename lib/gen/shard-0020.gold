@entry dbc5900d986e0b37
kind: step
verb: reverse
noun: digits
modifier: any
context: loop
phrase: reverse digits of any multi digit numbers
phrase: invert digits in each number across results
test: list=12,34,5
expect: => i=3 r=0.0 ok=true s="reversed digits any" errors=0 n=3 res=[21,43,5] cache=0 hits=0
test: list=78,901,4
expect: => i=3 r=0.0 ok=true s="reversed digits any" errors=0 n=3 res=[87,109,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		var sign = 1;
		if x < 0 { sign = -1; x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		g.res[i] = rev * sign;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed digits any");
	out
}
@end
