test: list=-5,-10 max_retries=2
expect: => i=2 r=0.0 ok=false s="retry function attempts: 2" errors=0 n=2 res=[-5,-10] cache=0 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_retries};
	var attempts = 0;
	var ok = false;
	while attempts < lim {
		attempts++;
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum > 0 {
			ok = true;
			break;
		}
		g.hits++;
	}
	g.steps += attempts + 1;
	out.i = attempts;
	out.ok = ok;
	out.s.clear();
	format(out.s, "retry function attempts: ", attempts);
	out
}
@end
