noun: squares
modifier: in_reverse
context: search
phrase: rank square values in reverse order
phrase: sort perfect squares in reverse sequence
test: list=2,4,9,3,16
expect: => i=3 r=0.0 ok=true s="rank_squares_in_reverse: 3" errors=0 n=3 res=[16,9,4] cache=0 hits=0
test: list=1,7,25,10
expect: => i=2 r=0.0 ok=true s="rank_squares_in_reverse: 2" errors=0 n=2 res=[25,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	for i in 0 .. g.n {
		let val = g.res[i];
		var r = 0;
		while r * r < val { r++; }
		if r * r == val {
			g.res[k] = val;
			k++;
		}
	}
	g.n = k;
	for i in 0 .. g.n {
		for j in i + 1 .. g.n {
			if g.res[j] > g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rank_squares_in_reverse: ", g.n);
	out
}
@end
