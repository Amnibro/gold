	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (5.0 as real)) as! int;
		if t > 4 { t = 4; }
		g.img[k] = (t as real) / ((4.0) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
