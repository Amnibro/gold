@entry 113c540014b5ebff
kind: step
verb: retry
noun: primes
modifier: sorted
context: loop
phrase: retry primes sorted extraction from results
phrase: filter sorted prime sequence with retry
test: list=9,2,8,3,5
expect: => i=3 r=0.0 ok=true s="retried primes sorted" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=10,7,4,11,13
expect: => i=3 r=0.0 ok=true s="retried primes sorted" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_buf int[64];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			p_buf[pn] = x;
			pn++;
		}
	}
	for i in pn {
		var j = i + 1;
		while j < pn {
			if p_buf[i] > p_buf[j] {
				let tmp = p_buf[i];
				p_buf[i] = p_buf[j];
				p_buf[j] = tmp;
			}
			j++;
		}
	}
	gold_clear(g);
	for i in pn {
		gold_push(g, p_buf[i]);
	}
	g.steps += g.n + pn + 1;
	out.i = pn;
	out.s.clear();
	format(out.s, "retried primes sorted");
	out
}
@end
