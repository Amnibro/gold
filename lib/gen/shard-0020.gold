noun: tally
modifier: in_reverse
context: search
phrase: validate search tally in reverse order
phrase: check tally matches in reverse scan
test: list=10,20,30
expect: => i=60 r=0.0 ok=true s="validate_tally_in_reverse: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,-2,8
expect: => i=6 r=0.0 ok=false s="validate_tally_in_reverse: 6" errors=1 n=3 res=[5,-2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	var ok = true;
	var i = g.n - 1;
	while i >= 0 {
		running += g.res[i];
		if g.res[i] < 0 { ok = false; break; }
		i--;
	}
	g.steps += g.n;
	if !ok {
		gold_fail(g, "negative item in reverse tally");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = running;
	out.s.clear();
	format(out.s, "validate_tally_in_reverse: ", running);
	out
}
@end
