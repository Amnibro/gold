code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var found = -1;
	for i in g.n {
		if g.res[i] > th {
			found = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found step at index ", found);
	} else {
		format(out.s, "step not found");
	}
	out
}
@end
