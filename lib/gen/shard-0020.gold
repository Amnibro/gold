code:
fn ${ID}(g Gold&, v Val) Val {
	// step: apply average while
	var out = v;
	var sum = 0;
	var count = 0;
	var stopping = false;
	for i in g.n {
		if !stopping {
			if ${cond}(g.res[i]) {
				sum += g.res[i];
				count += 1;
			} else {
				stopping = true;
			}
		}
	}
	out.i = if count > 0 { sum / count } else { 0 };
	out.s.clear();
	format(out.s, "applied average while");
	out
}
@end
