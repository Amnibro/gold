modifier: times
context: aggregate
phrase: reverse elements above average multiple times
phrase: invert above average values repeatedly by times
test: list=10,40,20,50,30
expect: => i=2 r=0.0 ok=true s="reverse_average_times: 2" errors=0 n=2 res=[50,40] cache=0 hits=0
test: list=5,25,15,35
expect: => i=2 r=0.0 ok=true s="reverse_average_times: 2" errors=0 n=2 res=[35,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in 0 .. g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var k = 0;
	for i in 0 .. g.n {
		if g.res[i] > avg {
			g.res[k] = g.res[i];
			k++;
		}
	}
	g.n = k;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse_average_times: ", g.n);
	out
}
@end
