code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in 0 .. g.n {
		if g.res[i] >= 10 { count++; }
	}
	if count >= 1 && g.n >= 2 {
		let first = g.res[0];
		for i in 0 .. g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "rotate_condition_at_least: ", count);
	out
}
@end
