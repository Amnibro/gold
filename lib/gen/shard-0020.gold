expect: => i=1 r=0.0 ok=true s="returned unique head count 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_k = ${k};
	var w = 0;
	for r in g.n {
		var seen = false;
		for i in w {
			if g.res[i] == g.res[r] { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[r];
			w++;
			if w >= target_k { break; }
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "returned unique head count ", w);
	out
}
@end
