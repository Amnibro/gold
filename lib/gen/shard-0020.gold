kind: step
verb: pave
noun: road
modifier: sparse
context: env
slot: n int
slot: gap real
phrase: pave {n} sparse road stones with gap {gap}
phrase: lay {n} sparse road flagstones spacing {gap}
test: n=3 gap=2.5
expect: => i=3 r=0.0 ok=true s="paveroad" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: road1 box 0,0,.05 2,1,.1 m:matte #8c827a
expect: => doc: road2 box 0,2.5,.05 2,1,.1 m:matte #8c827a
expect: => doc: road3 box 0,5,.05 2,1,.1 m:matte #8c827a
test: n=2 gap=3.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=4 r=0.0 ok=true s="paveroad" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: road3 box 0,0,.05 2,1,.1 m:matte #8c827a
expect: => doc: road4 box 0,3,.05 2,1,.1 m:matte #8c827a
test: n=0 gap=2.5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${gap} <= 0.0 {
		gold_fail(g, "count or gap out of range");
		out.ok = false;
		return out;
	}
	for q in ${n} {
		o.clear();
		gold_dnews(g, "road", "", o);
		o.append(" box 0,");
		gold_fnum(o, (q as real) * ${gap});
		o.append(",.05 ");
		o.append("2,1,.");
		o.append("1 m:matte ");
		gold_hex(o, 140, 130, 122);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "paveroad");
	out
}
@end
