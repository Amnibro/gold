@entry 82910c7e0edf130c
kind: step
verb: filter
noun: primes
modifier: with_cache
context: search
phrase: filter prime numbers with cache lookup
phrase: select prime search matches with cache recording
test: list=2,4,5,9,11
expect: => i=3 r=0.0 ok=true s="filter_primes_with_cache: 3" errors=0 n=3 res=[2,5,11] cache=1 hits=0
test: list=6,8,13,15,17
expect: => i=2 r=0.0 ok=true s="filter_primes_with_cache: 2" errors=0 n=2 res=[13,17] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	for i in 0 .. g.n {
		let num = g.res[i];
		var is_p = true;
		if num < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[k] = num;
			k++;
		}
	}
	g.n = k;
	gold_cache_put(g, 1, k);
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "filter_primes_with_cache: ", k);
	out
}
@end
