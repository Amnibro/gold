	while g.n > 0 && g.res[g.n - 1] < tgt && g.n < 64 {
		let next_val = g.res[g.n - 1] + 5;
		gold_push(g, next_val);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled checkpoints up to target: ", g.n);
	out
}
@end
