phrase: verify alternating digit distance within {max_gap}
test: arg=1928,1324 max_gap=3
expect: true
expect: true
test: arg=1910,1810 max_gap=2
expect: false
expect: false
code:
fn ${ID}(n int) bool {
	let mg = ${max_gap};
	var x = if n < 0 { -n } else { n };
	var prev = -1;
	var take = true;
	while x > 0 {
		if take {
			let d = x % 10;
			if prev >= 0 {
				let diff = if d > prev { d - prev } else { prev - d };
				if diff > mg { return false; }
			}
			prev = d;
		}
		take = !take;
		x /= 10;
	}
	true
}
@end
