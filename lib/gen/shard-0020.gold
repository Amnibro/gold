fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_prime(x) && x > c {
			g.res[i] = c;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "primes clamped: ", clamped);
	out
}
@end
