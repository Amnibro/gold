expect: => i=4 r=0.0 ok=true s="merged consecutive streaks length: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=7,7,7,7
expect: => i=1 r=0.0 ok=true s="merged consecutive streaks length: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var write = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] != g.res[write - 1] {
				g.res[write] = g.res[i];
				write++;
			}
			i++;
		}
		g.n = write;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged consecutive streaks length: ", g.n);
	out
}
@end
