expect: => i=2 r=0.0 ok=true s="reversed window cached: 2" errors=0 n=5 res=[3,2,1,4,5] cache=1 hits=0
test: list=10,20,30,40 win_size=4 cache_slot=2
expect: => i=20 r=0.0 ok=true s="reversed window cached: 20" errors=0 n=4 res=[40,30,20,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	let cs = ${cache_slot};
	var sz = if w < g.n { w } else { g.n };
	if sz > 1 {
		var i = 0;
		var j = sz - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		let mid = g.res[sz / 2];
		gold_cache_put(g, cs, mid);
		g.steps += sz;
		out.i = mid;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "reversed window cached: ", out.i);
	out
}
@end
