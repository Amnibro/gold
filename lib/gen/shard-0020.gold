fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var total = 0;
	let take = if g.n < c { g.n } else { c };
	var i = 0;
	while i < take {
		total += g.res[g.n - 1 - i];
		i++;
	}
	g.steps += take;
	out.i = total;
	out.s.clear();
	format(out.s, "summed last ", take, " runs total ", total);
	out
}
@end
