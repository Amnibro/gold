code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	var kept = 0;
	for i in g.n {
		var is_dup = false;
		if i >= st && g.res[i] == g.res[i - st] {
			is_dup = true;
		}
		if !is_dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped pairs: ", kept);
	out
}
@end
