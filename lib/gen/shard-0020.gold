@entry b2e7b0ce232155b9
kind: step
verb: run
noun: window
modifier: none
context: stats
phrase: run sliding window of size {w}
phrase: compute moving sums across window of size {w}
slot: w int
test: list=1,2,3,4,5 w=3
expect: => i=3 r=0.0 ok=true s="computed 3 window sums" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=10,20 w=2
expect: => i=1 r=0.0 ok=true s="computed 1 window sums" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 || g.n < win {
		gold_fail(g, "window too large for dataset");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for i in 0..(g.n - win + 1) {
		var sum = 0;
		for j in 0..win {
			sum += g.res[i + j];
		}
		g.res[kept] = sum;
		kept++;
	}
	g.n = kept;
	g.steps += g.n * win;
	out.i = kept;
	out.s.clear();
	format(out.s, "computed ", kept, " window sums");
	out
}
@end
@entry a38be5e007beb36e
kind: step
verb: cache
noun: runs
modifier: none
context: stats
phrase: cache consecutive run lengths
