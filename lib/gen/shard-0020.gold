fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inversions = 0;
	for i in g.n {
		for j in g.n {
			if i < j && g.res[i] > g.res[j] {
				inversions++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = inversions;
	out.s.clear();
	format(out.s, "nested pair rank: ", inversions);
	out
}
@end
