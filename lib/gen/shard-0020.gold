phrase: collect unique digits from input
phrase: extract unique digits from value
test: input=122334
expect: => i=4 r=0.0 ok=true s="extracted 4 unique digits" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: input=90807
expect: => i=4 r=0.0 ok=true s="extracted 4 unique digits" errors=0 n=4 res=[7,0,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	if x < 0 { x = -x; }
	if x == 0 {
		gold_push(g, 0);
	} else {
		while x > 0 {
			let d = x % 10;
			x /= 10;
			var exists = false;
			for k in g.n {
				if g.res[k] == d { exists = true; break; }
			}
			if !exists { gold_push(g, d); }
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "extracted ", g.n, " unique digits");
	out
}
@end
@entry 19441181d0dc9fad
kind: step
verb: sum
noun: minimum
modifier: at_most
context: core
phrase: sum minimum items at most {count}
phrase: total lowest values up to count {count}
slot: count int
test: list=8,3,5,1,9 count=2
expect: => i=4 r=0.0 ok=true s="minimum sum 4" errors=0 n=5 res=[1,3,5,8,9] cache=0 hits=0
test: list=12,4,7,2,10 count=3
expect: => i=13 r=0.0 ok=true s="minimum sum 13" errors=0 n=5 res=[2,4,7,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	// Sort ascending
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total = 0;
	let limit = if target < g.n { target } else { g.n };
	for k in limit { total += g.res[k]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "minimum sum ", total);
	out
}
@end
