code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let s = ${slot_idx};
	var cnt = 0;
	for k in g.n {
		if g.res[k] == tgt { cnt++; }
	}
	gold_cache_put(g, s, cnt);
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "cached tally: ", cnt);
	out
}
@end
@entry 42bb805f9e22e5ca
kind: step
verb: scan
noun: spaces
modifier: up_to
context: list
slot: max_gap int
phrase: scan spaces up to gap limit {max_gap} in list
phrase: measure adjacent spaces up to threshold {max_gap} across list
test: list=2,5,8,20,23 max_gap=5
expect: => i=3 r=0.0 ok=true s="scanned spaces count: 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=10,12,18,22 max_gap=4
expect: => i=2 r=0.0 ok=true s="scanned spaces count: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_gap};
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= lim {
			g.res[kept] = diff;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "scanned spaces count: ", kept);
