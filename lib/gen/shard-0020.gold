fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var swaps = 0;
	var i = 0;
	while i < g.n - 1 {
		let diff = g.res[i] - g.res[i + 1];
		let abs_diff = if diff >= 0 { diff } else { -diff };
		if abs_diff > d {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped values pairwise");
	out
}
