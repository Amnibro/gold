noun: odds
modifier: while
context: core
slot: limit int
phrase: sum odds while below limit {limit}
phrase: accumulate odd values while sum under {limit}
test: list=1,3,5,7 limit=6
expect: => i=4 r=0.0 ok=true s="sum odds while under: 4" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
test: list=2,5,7,9 limit=15
expect: => i=12 r=0.0 ok=true s="sum odds while under: 12" errors=0 n=4 res=[2,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			if total + x > lim { break; }
			total += x;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum odds while under: ", total);
	out
}
@end
