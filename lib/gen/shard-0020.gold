fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var sm = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[sm] { sm = j; }
		}
		if sm != i {
			let tmp = g.res[i];
			g.res[i] = g.res[sm];
			g.res[sm] = tmp;
		}
	}
	var dups = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			g.res[dups] = g.res[i];
			dups++;
		}
		i += 2;
	}
	g.n = dups;
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found ", dups, " duplicates every other");
	out
}
@end
