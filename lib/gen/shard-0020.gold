fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${count};
	if cnt > g.n { cnt = g.n; }
	if cnt <= 0 { return out; }
	let remaining = g.n - cnt;
	for i in remaining {
		g.res[i] = g.res[i + cnt];
	}
	g.n = remaining;
	g.steps += cnt;
	out.i = remaining;
	out.s.clear();
	format(out.s, "loop dropped remaining: ", remaining);
	out
}
