kind: step
verb: fold
noun: range
modifier: none
context: filter
slot: low int
slot: high int
phrase: fold range none bounds from {low} to {high}
phrase: accumulate elements within range {low} through {high}
test: list=5,12,18,25,30,42 low=10 high=25
expect: => i=55 r=0.0 ok=true s="range fold: 55" errors=0 n=3 res=[12,18,25] cache=0 hits=0
test: list=2,4,6,8,10,12 low=5 high=10
expect: => i=24 r=0.0 ok=true s="range fold: 24" errors=0 n=3 res=[6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var total = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			g.res[kept] = x;
			total += x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = total;
	out.s.clear();
	format(out.s, "range fold: ", total);
	out
}
@end
@entry 21b37800c0f3ab91
kind: step
verb: sort
noun: subfunction
modifier: in_reverse
context: filter
slot: cutoff int
phrase: sort subfunction in_reverse descending cutoff {cutoff}
phrase: reverse order filtered elements above {cutoff}
test: list=5,20,12,35,8,42 cutoff=15
expect: => i=3 r=0.0 ok=true s="sorted subfunction: 3" errors=0 n=3 res=[42,35,20] cache=0 hits=0
test: list=10,50,30,80,25 cutoff=25
expect: => i=3 r=0.0 ok=true s="sorted subfunction: 3" errors=0 n=3 res=[80,50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x > cut {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted subfunction: ", g.n);
	out
}
@end
