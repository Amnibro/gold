@entry 772db09bb023d859
kind: step
verb: drop
noun: streak
modifier: unique
context: core
phrase: drop unique streak items
phrase: remove single element streaks
test: list=1,2,2,3,4,4,5
expect: => i=3 r=0.0 ok=true s="removed 3 isolated items" errors=0 n=4 res=[2,2,4,4] cache=0 hits=0
test: list=7,7,8,9,9
expect: => i=1 r=0.0 ok=true s="removed 1 isolated items" errors=0 n=4 res=[7,7,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len > 1 {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	let dropped = g.n - kept;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "removed ", dropped, " isolated items");
	out
}
@end
