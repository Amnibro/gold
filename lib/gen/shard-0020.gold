kind: step
verb: group
noun: limit
modifier: last
context: stats
slot: limit int
phrase: stats group limit last elements {limit}
phrase: partition sample observations with limit {limit} at last
test: list=10,25,30,15,40 limit=20
expect: => i=2 r=0.0 ok=true s="grouped within limit: 2" errors=0 n=5 res=[10,25,30,15,40] cache=0 hits=0
test: list=5,8,12,3 limit=10
expect: => i=3 r=0.0 ok=true s="grouped within limit: 3" errors=0 n=4 res=[5,8,12,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		if g.res[i] <= lim { count++; }
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped within limit: ", count);
	out
}
@end
