			last_val = g.res[i];
		} else if last_val != 0 {
			g.res[i] = last_val;
			filled += 1;
		}
	}
	out.i = filled;
	out.s.clear();
	format(out.s, "filled runs none");
	out
}
@end
@entry 154cf558ab10ef8b
kind: step
verb: drop
noun: steps
modifier: none
context: aggregate
phrase: drop steps none removing negative values
phrase: eliminate negative steps from results list
test: list=5,-2,7,-1,9
expect: => i=2 r=0.0 ok=true s="dropped steps none" errors=0 n=3 res=[5,7,9] cache=0 hits=0
test: list=-3,-5,4
expect: => i=2 r=0.0 ok=true s="dropped steps none" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step: drop steps none
	var out = v;
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] >= 0 {
			g.res[write_idx] = g.res[i];
			write_idx += 1;
		} else {
			dropped += 1;
		}
	}
	g.n = write_idx;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped steps none");
	out
}
@end
