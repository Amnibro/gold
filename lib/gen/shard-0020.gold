fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i + 1 < g.n {
		var d = g.res[i + 1] - g.res[i];
		if d < 0 { d = -d; }
		g.res[m] = d;
		m++;
		i += 2;
	}
	if i < g.n {
		g.res[m] = g.res[i];
		m++;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "safely paired gaps count: ", m);
	out
}
@end
