fn ${ID}(g Gold&, v Val) Val {
var out = v;
	let pv = ${pad_val};
	var buf = [0; 64];
	buf[0] = pv;
	for i in g.n {
		if i + 1 < 64 {
			buf[i + 1] = g.res[i];
		}
	}
	let new_len = if g.n + 1 < 64 { g.n + 1 } else { 64 };
	gold_clear(g);
	for j in new_len {
		gold_push(g, buf[j]);
	}
	g.steps += new_len;
	out.i = new_len;
	out.s.clear();
	format(out.s, "filled unique prefix length: ", new_len);
	out
}
