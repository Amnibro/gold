phrase: partition sorted items with capacity limit {cap}
slot: cap int
test: list=1,4,2,5,3 cap=2
expect: => i=3 r=0.0 ok=true s="grouped into 3 partitions" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=4,8,2 cap=3
expect: => i=1 r=0.0 ok=true s="grouped into 1 partitions" errors=0 n=1 res=[14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let chunk_size = ${cap};
	if chunk_size <= 0 {
		gold_fail(g, "invalid partition limit");
		out.ok = false;
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var num_chunks = 0;
	var idx = 0;
	while idx < g.n {
		var chunk_sum = 0;
		for _ in chunk_size {
			if idx < g.n {
				chunk_sum += g.res[idx];
				idx++;
			}
		}
		g.res[num_chunks] = chunk_sum;
		num_chunks++;
	}
	g.n = num_chunks;
	g.steps += g.n;
	out.i = num_chunks;
	out.s.clear();
	format(out.s, "grouped into ", num_chunks, " partitions");
	out
}
@end
