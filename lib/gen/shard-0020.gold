code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need multiple elements");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	var cnt = 0;
	for i in g.n - 1 {
		if g.res[i] + g.res[i + 1] == last { cnt++; }
	}
	out.i = cnt;
	out.s.clear();
	format(out.s, "found ", cnt, " pairs summing to last");
	g.steps += g.n;
	out
}
@end
