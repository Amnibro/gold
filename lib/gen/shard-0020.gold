expect: => i=1 r=0.0 ok=true s="dropped small evens: 1" errors=0 n=2 res=[20,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x < cut {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped small evens: ", dropped);
	out
}
@end
