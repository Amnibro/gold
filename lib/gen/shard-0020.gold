phrase: stats collect step sorted deltas
phrase: gather consecutive sample step sorted differences
test: list=10,30,15,40
expect: => i=3 r=0.0 ok=true s="sorted step differences count: 3" errors=0 n=3 res=[-15,20,25] cache=0 hits=0
test: list=5,20,10
expect: => i=2 r=0.0 ok=true s="sorted step differences count: 2" errors=0 n=2 res=[-10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	let delta_n = g.n - 1;
	for i in delta_n {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = delta_n;
	for i in g.n {
		for j in i + 1 .. g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted step differences count: ", g.n);
	out
}
@end
