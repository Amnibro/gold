@entry 25f39351015fdb7e
kind: step
verb: trace
noun: cache
modifier: last
context: filter
slot: slot_id int
phrase: trace cache last value in slot {slot_id}
phrase: lookup last cached entry from slot {slot_id}
test: list=10,20,30 slot_id=42
expect: => i=30 r=0.0 ok=true s="cached last: 30" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25,35 slot_id=10
expect: => i=35 r=0.0 ok=true s="cached last: 35" errors=0 n=4 res=[5,15,25,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${slot_id};
	let old_val, found = gold_cache_get(g, s);
	if found {
		gold_push(g, old_val);
	}
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		gold_cache_put(g, s, last_val);
		out.i = last_val;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached last: ", out.i);
	out
}
@end
@entry 124b14a32b4266ab
kind: step
verb: filter
noun: gaps
modifier: pairwise
context: filter
slot: max_gap int
phrase: filter gaps pairwise bounded by {max_gap}
phrase: keep adjacent elements pairwise gap under {max_gap}
test: list=10,13,17,30,35 max_gap=5
expect: => i=4 r=0.0 ok=true s="pairwise gaps kept: 4" errors=0 n=4 res=[10,13,17,35] cache=0 hits=0
test: list=2,5,10,12,25,27 max_gap=4
expect: => i=4 r=0.0 ok=true s="pairwise gaps kept: 4" errors=0 n=4 res=[2,5,12,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var kept = 0;
	if g.n > 0 {
		g.res[kept] = g.res[0];
		kept++;
		var i = 1;
		while i < g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = -diff; }
			if diff <= mg {
				g.res[kept] = g.res[i];
				kept++;
			}
			i++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "pairwise gaps kept: ", kept);
	out
}
@end
