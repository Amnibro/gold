code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	var b_cnt = 0;
	if b > 0 {
		for k in g.n {
			g.res[k] = (g.res[k] / b) * b;
			b_cnt++;
		}
	} else {
		gold_fail(g, "bucket must be positive");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = b_cnt;
	out.s.clear();
	format(out.s, "grouped function times bucketed ", b_cnt);
	out
}
@end
