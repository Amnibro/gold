expect: => i=2 r=0.0 ok=true s="filled alternate observations: 2" errors=0 n=4 res=[5,99,25,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fv = ${fill_val};
	var count = 0;
	var i = 1;
	while i < g.n {
		g.res[i] = fv;
		count++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "filled alternate observations: ", count);
	out
}
@end
@entry 689f2075029e24ac
kind: step
verb: apply
noun: evens
modifier: any
context: stats
slot: bonus int
phrase: stats apply evens any with bonus {bonus}
phrase: adjust sample evens any matching with {bonus}
test: list=1,2,3,4,5 bonus=10
expect: => i=2 r=0.0 ok=true s="applied bonus to evens: 2" errors=0 n=5 res=[1,12,3,14,5] cache=0 hits=0
test: list=7,9,11 bonus=5
expect: => i=0 r=0.0 ok=true s="applied bonus to evens: 0" errors=0 n=3 res=[7,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bonus};
	var has_even = false;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			has_even = true;
			break;
		}
	}
	var count = 0;
	if has_even {
		for i in g.n {
			if g.res[i] % 2 == 0 {
				g.res[i] += b;
				count++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "applied bonus to evens: ", count);
	out
}
@end
