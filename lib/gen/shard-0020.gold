fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_diff = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			var d = g.res[i] - g.res[i - 1];
			if d < 0 { d = -d; }
