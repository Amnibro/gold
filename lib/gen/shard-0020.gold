code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var arr int[512] = [0; 512];
	for i in g.n {
		var x = g.res[i];
		var d = 2;
		while d <= x && count < 512 {
			if x % d == 0 {
				if ${ID}_is_prime(d) {
					arr[count] = d;
					count++;
				}
				while x % d == 0 { x /= d; }
			}
			d++;
		}
	}
	for i in 0 .. count {
		g.res[i] = arr[i];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "joined nested primes: ", count);
	out
}
@end
