kind: step
verb: keep
noun: values
modifier: with_retry
context: loop
phrase: keep values passing condition {p} with retry allowance {retries}
phrase: filter items satisfying {p} allowing {retries} attempts
slot: p pred
slot: retries int
test: list=2,3,5,6 p=is_even retries=1
expect: => i=3 r=0.0 ok=true s="kept 3 values" errors=0 n=3 res=[2,3,6] cache=0 hits=0
