kind: step
verb: scan
noun: average
modifier: last
context: search
phrase: scan average of trailing {count} search candidates
phrase: accumulate mean value over last {count} search results
slot: count int
test: list=10,20,30,40 count=2
expect: => i=35 r=0.0 ok=true s="trailing average: 35" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 count=3
expect: => i=15 r=0.0 ok=true s="trailing average: 15" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let take = if c > g.n { g.n } else { c };
	if take <= 0 { return out; }
	let start = g.n - take;
	var total = 0;
	for k in start..g.n {
		total += g.res[k];
	}
	let avg = total / take;
	out.i = avg;
	out.s.clear();
	format(out.s, "trailing average: ", avg);
	out
}
@end
