context: search
phrase: validate search budget on sorted costs under {max_budget}
phrase: verify sorted search expenses within {max_budget}
slot: max_budget int
test: list=10,20,30 max_budget=70
expect: => i=60 r=0.0 ok=true s="budget validated" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,50 max_budget=70
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_budget};
	var sum = 0;
	for i in g.n {
		if i > 0 && g.res[i] < g.res[i - 1] {
			gold_fail(g, "not sorted");
			out.ok = false;
			return out;
		}
		sum += g.res[i];
	}
	if sum > mb {
		gold_fail(g, "budget exceeded");
		out.ok = false;
		return out;
	}
	out.i = sum;
	out.s.clear();
	out.s.append("budget validated");
	g.steps += g.n;
	out
}
@end
