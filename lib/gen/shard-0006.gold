@entry 87bdb7eb298b0503
kind: step
verb: count
noun: duplicates
modifier: while
context: error
phrase: count duplicate errors while under limit {limit}
phrase: tally duplicate occurrences while checking ceiling {limit}
slot: limit int
test: list=1,2,3,4 limit=2
expect: => i=0 r=0.0 ok=true s="counted duplicates 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,1,2,2 limit=1
expect: => i=1 r=0.0 ok=true s="counted duplicates 1" errors=1 n=4 res=[1,1,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dups = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dups++;
				if dups >= lim {
					gold_fail(g, "excessive duplicates");
					break;
				}
			}
		}
		if dups >= lim { break; }
	}
	g.steps += g.n * g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "counted duplicates ", dups);
	out
}
@end
