code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = 0;
	var k = g.n - 1;
	while k >= 0 && g.res[k] > 0 {
		len++;
		k--;
	}
	let start = g.n - len;
	for i in len {
		g.res[i] = g.res[start + i];
	}
	g.n = len;
	g.steps += g.n;
	out.i = len;
	out.s.clear();
	format(out.s, "extracted last streak of length ", len);
	out
}
@end
