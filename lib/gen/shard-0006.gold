fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let cached_val, found = gold_cache_get(g, x);
		var val = cached_val;
		if !found {
			val = ${f}(x);
			gold_cache_put(g, x, val);
		}
		if val > 0 {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered with cache");
	g.steps += g.n;
	out
}
@end
