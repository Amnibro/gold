fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let first = g.res[0];
	out.i = first;
	out.ok = first <= lim;
	out.s.clear();
	if out.ok {
		out.s.append("first within limit");
	} else {
		out.s.append("first exceeds limit");
	}
	g.steps++;
	out
}
@end
