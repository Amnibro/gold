expect: => i=100 r=0.0 ok=true s="budget normalized" errors=0 n=3 res=[10,20,20] cache=0 hits=0
test: list=10,30,60 budget=200
expect: => i=100 r=0.0 ok=true s="budget normalized" errors=0 n=3 res=[20,60,120] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	if total > 0 {
		for k in g.n {
			g.res[k] = (g.res[k] * b) / total;
		}
	}
	out.i = total;
	out.s.clear();
	out.s.append("budget normalized");
	g.steps += g.n;
	out
}
@end
@entry 91dd7a95204b426c
kind: step
verb: drop
noun: function
modifier: in_reverse
context: stats
phrase: drop reverse observations transformed by function {f}
phrase: filter reverse sample values with function {f}
slot: f fn
test: list=2,5,8,9 f=double
expect: => i=4 r=0.0 ok=true s="dropped in reverse" errors=0 n=4 res=[9,8,5,2] cache=0 hits=0
test: list=3,4,6,7 f=inc
expect: => i=2 r=0.0 ok=true s="dropped in reverse" errors=0 n=2 res=[7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = g.n - 1;
	var temp int[512] = [0; 512];
	while i >= 0 {
		let val = ${f}(g.res[i]);
		if val % 2 == 0 {
			temp[kept] = g.res[i];
			kept++;
		}
		i--;
	}
	for k in kept {
		g.res[k] = temp[k];
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("dropped in reverse");
	g.steps += g.n;
	out
}
@end
