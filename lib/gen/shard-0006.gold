code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s1 = -1;
	var s2 = -1;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var is_sq = false;
			for r in 100 {
			if r * r == x { is_sq = true; break; }
			}
			if is_sq {
				if s1 == -1 { s1 = x; }
				else if s2 == -1 { s2 = x; break; }
			}
		}
	}
	if s1 != -1 && s2 != -1 {
		gold_cache_put(g, s1, s2);
		out.i = s1 + s2;
	} else {
		gold_fail(g, "insufficient square elements");
		out.ok = false;
	}
	g.steps += g.n * 10;
	out.s.clear();
	format(out.s, "paired first squares sum ", out.i);
	out
}
@end
