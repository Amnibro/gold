fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	for k in g.n {
		if g.res[k] > th {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items at most threshold");
	out
}
@end
