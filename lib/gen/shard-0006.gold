code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var span = if lim < g.n { lim } else { g.n };
	if span < 0 { span = 0; }
	if span > 1 {
		let first = g.res[0];
		for i in 1..span {
			g.res[i - 1] = g.res[i];
		}
		g.res[span - 1] = first;
		gold_cache_put(g, 0, first);
	}
	out.i = span;
	out.s.clear();
	out.s.append("prefix rotated");
	g.steps += span;
	out
}
@end
