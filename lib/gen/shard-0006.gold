code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let max_diff = ${diff};
    var valid_pairs = 0;
    var prev_even = -1;
    for i in g.n {
        let cur = g.res[i];
        if cur % 2 == 0 {
            if prev_even >= 0 && (cur - prev_even) <= max_diff {
                valid_pairs++;
            }
            prev_even = cur;
        }
    }
    out.i = valid_pairs;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "valid pairwise evens count ", valid_pairs);
    out
}
@end
