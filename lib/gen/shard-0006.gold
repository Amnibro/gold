	if g.n <= 1 { return out; }
	let first = g.res[0];
	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.res[g.n - 1] = first;
	gold_cache_put(g, 0, first);
	out.i = g.n;
	out.s.clear();
	out.s.append("first sequence rotated");
	g.steps += g.n;
	out
}
@end
