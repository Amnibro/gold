fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_count = 0;
	var cur_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur_len > 0 {
				if ${p}(cur_len) { break; }
				word_count++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 && !${p}(cur_len) {
		word_count++;
	}
	out.i = word_count;
	g.steps += out.s.len;
	out
}
@end
