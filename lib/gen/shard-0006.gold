slot: floor int
test: list=20,30,40 floor=15
expect: => i=20 r=0.0 ok=true s="minimum replaced count 0" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=10,30,5 floor=15
expect: => i=5 r=0.0 ok=false s="minimum replaced count 2" errors=1 n=3 res=[15,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	if g.n == 0 {
		gold_fail(g, "empty list for minimum");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var replaced = 0;
	if min_val < fl {
		gold_fail(g, "minimum under floor");
		for i in g.n {
			if g.res[i] < fl {
				g.res[i] = fl;
				replaced++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = min_val;
	out.ok = replaced == 0;
	out.s.clear();
	format(out.s, "minimum replaced count ", replaced);
	out
}
@end
