fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let nd = ${needle};
	let limit = if g.n < 3 { g.n } else { 3 };
	var found = -1;
	for k in limit {
		if g.res[k] == nd {
			found = k;
			break;
		}
	}
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "found needle in prefix");
	} else {
		gold_fail(g, "needle not found in prefix");
		out.ok = false;
		format(out.s, "error: needle missing in prefix");
	}
	g.steps += limit;
	out
}
