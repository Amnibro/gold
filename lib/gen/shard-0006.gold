phrase: rotate histogram bins by offset {k}
phrase: shift unique histogram counts by amount {k}
slot: k int
test: list=1,2,2,3,1 k=1
expect: => i=5 r=0.0 ok=true s="rotated histogram by 1" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5 k=2
expect: => i=3 r=0.0 ok=true s="rotated histogram by 2" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n > 1 {
		let s = shift % g.n;
		for step in s {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated histogram by ", shift);
	out
}
@end
