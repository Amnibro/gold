fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${cap};
	var running = 0;
	var kept = 0;
	for k in g.n {
		if running + g.res[k] <= max_sum {
			running += g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " series items under cap");
	out
}
@end
