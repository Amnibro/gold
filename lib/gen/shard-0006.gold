	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for duplicates");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var dups = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] && g.res[i] != 0 {
				g.res[i] = 0;
				dups++;
				break;
			}
			j++;
		}
		i++;
	}
	out.i = dups;
	out.s.clear();
	if dups > 0 {
		out.ok = true;
		format(out.s, "duplicates zeroed in reverse");
	} else {
		gold_fail(g, "no duplicate values found");
		out.ok = false;
		format(out.s, "error: no duplicates found");
	}
	g.steps += g.n;
	out
}
@end
