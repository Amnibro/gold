code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let threshold = ${gap};
    var splits = 0;
    if g.n > 1 {
        for i in 1..g.n {
            let diff = g.res[i] - g.res[i - 1];
            if diff > threshold {
                splits++;
            }
        }
    }
    out.i = splits;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "nested gap splits ", splits);
    out
}
@end
