expect: => i=4 r=0.0 ok=true s="sum of 1 unique numbers is 4" errors=0 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_uniq = 0;
	var count = 0;
	for i in g.n {
		var dup = false;
		for j in i {
			if g.res[i] == g.res[j] {
				dup = true;
				break;
			}
		}
		if !dup {
			sum_uniq += g.res[i];
			count++;
		}
	}
	out.i = sum_uniq;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "sum of ", count, " unique numbers is ", sum_uniq);
	out
}
@end
