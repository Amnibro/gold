test: list=3,1,3,2,3
expect: => i=3 r=0.0 ok=true s="grouped 3 matching items to front" errors=0 n=5 res=[3,3,3,2,1] cache=0 hits=0
test: list=1,2,3
expect: => i=1 r=0.0 ok=true s="grouped 1 matching items to front" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty list to group");
		return out;
	}
	let target = g.res[g.n - 1];
	var front = 0;
	for k in g.n {
		if g.res[k] == target {
			let t = g.res[front];
			g.res[front] = g.res[k];
			g.res[k] = t;
			front++;
		}
	}
	out.i = front;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "grouped ", front, " matching items to front");
	out
}
@end
