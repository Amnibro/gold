fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var idx = 0;
	while idx + 1 < g.n {
		g.res[kept] = g.res[idx] + g.res[idx + 1];
		kept++;
		idx += 2;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged pairs: ", kept);
	out
}
