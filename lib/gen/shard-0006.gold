fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var new_n = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			g.res[new_n] = g.res[i] + g.res[i + 1];
			new_n++;
			pairs++;
			i += 2;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
			i++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "joined runs pairwise");
	out
}
