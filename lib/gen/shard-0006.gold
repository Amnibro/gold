kind: step
verb: merge
noun: primes
modifier: between
context: error
phrase: merge prime numbers between boundaries {low} {high}
phrase: combine prime values between limits {low} {high}
slot: low int
slot: high int
test: list=2,3,4,5,6 low=2 high=4
expect: => i=5 r=0.0 ok=true s="merged primes sum 5" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=2,-3,5 low=1 high=10
expect: => i=7 r=0.0 ok=true s="merged primes sum 7" errors=1 n=3 res=[2,-3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var prime_sum = 0;
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x < 0 {
			gold_fail(g, "negative number");
			continue;
		}
		var is_p = x > 1;
		for d in 2..x {
			if d * d <= x && x % d == 0 { is_p = false; break; }
		}
		if is_p && x >= lo && x <= hi {
			prime_sum += x;
			primes_count++;
		}
	}
	g.steps += g.n * 5;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "merged primes sum ", prime_sum);
	out
}
@end
