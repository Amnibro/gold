fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var modified = 0;
	for k in g.n {
		if ${p}(g.res[k]) { break; }
		if g.res[k] > c {
			g.res[k] = c;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	out.s.append("maximum capped");
	g.steps += g.n;
	out
}
@end
