fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var total = 0;
	var count = 0;
	for k in g.n {
		total += g.res[k];
		count++;
		if total >= limit { break; }
	}
	out.i = total;
	out.s.clear();
	out.s.append("maximum sum reached");
	g.steps += count;
	out
}
@end
