expect: => i=2 r=0.0 ok=true s="primes first: 2" errors=0 n=5 res=[2,5,6,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = [0; 512];
	var non_primes = [0; 512];
	var np = 0;
	var nnp = 0;
	for idx in g.n {
		let val = g.res[idx];
		if core_is_prime(val) {
			primes[np] = val;
			np++;
		} else {
			non_primes[nnp] = val;
			nnp++;
		}
	}
	for i in np { g.res[i] = primes[i]; }
	for j in nnp { g.res[np + j] = non_primes[j]; }
	out.i = np;
	out.s.clear();
	format(out.s, "primes first: ", np);
	out
}
@end
