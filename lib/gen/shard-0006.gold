expect: => i=1 r=0.0 ok=true s="streak violations 1" errors=1 n=4 res=[1,1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${max_streak};
	var cur_streak = 0;
	var violations = 0;
	for i in g.n {
		if i == 0 || g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			cur_streak = 1;
		}
		if cur_streak > max_s {
			gold_fail(g, "streak too long");
			violations++;
		}
	}
	g.steps += g.n + 1;
	out.i = violations;
	out.s.clear();
	format(out.s, "streak violations ", violations);
	out
}
@end
