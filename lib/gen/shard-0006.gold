@entry a15bba692050b4f7
kind: step
verb: limit
noun: history
modifier: pairwise
context: error
phrase: limit error history pairwise differences to {max_diff}
phrase: clamp pairwise error jumps to {max_diff}
slot: max_diff int
test: list=10,25,28 max_diff=10
expect: => i=0 r=0.0 ok=true s="clamped pairwise jumps to 10" errors=0 n=3 res=[10,20,28] cache=0 hits=0
test: list=5,50 max_diff=15
expect: => i=0 r=0.0 ok=true s="clamped pairwise jumps to 15" errors=0 n=2 res=[5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${max_diff};
	if g.n < 2 {
		out.s.clear();
		out.s.append("insufficient history");
		return out;
	}
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > max_d {
			g.res[k] = g.res[k - 1] + max_d;
		} else if diff < -max_d {
			g.res[k] = g.res[k - 1] - max_d;
		}
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "clamped pairwise jumps to ", max_d);
	out
}
