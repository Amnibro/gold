fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_sq = -1;
	var sorted = true;
	var sq_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		for r in 100 {
			if r * r == x { is_sq = true; break; }
		}
		if is_sq {
			sq_count++;
			if last_sq != -1 && x < last_sq {
				sorted = false;
			}
			last_sq = x;
			gold_cache_put(g, i, x);
		}
	}
	g.steps += g.n * 10;
	out.i = sq_count;
	out.ok = sorted;
	out.s.clear();
	format(out.s, "sorted squares count ", sq_count);
	out
}
@end
