test: list=10,20,30,40
expect: => i=3 r=0.0 ok=true s="cached recursive checkpoints 3" errors=0 n=4 res=[10,20,30,40] cache=3 hits=0
test: list=5,15,25,35,45
expect: => i=3 r=0.0 ok=true s="cached recursive checkpoints 3" errors=0 n=5 res=[5,15,25,35,45] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var checkpoints = 0;
    var idx = 1;
    while idx <= g.n {
        gold_cache_put(g, idx, g.res[idx - 1]);
        checkpoints++;
        idx *= 2;
    }
    out.i = checkpoints;
    g.steps += checkpoints + 1;
    out.s.clear();
    format(out.s, "cached recursive checkpoints ", checkpoints);
    out
}
@end
