@entry ea48db6e9ae65e7b
kind: step
verb: drop
noun: squares
modifier: while
context: retry
phrase: drop squares while values remain below {ceiling}
phrase: remove squares while under threshold {ceiling}
phrase: purge squares while strictly below bound {ceiling}
slot: ceiling int
test: list=4,9,15 ceiling=10
expect: => i=2 r=0.0 ok=true s="squares dropped while below ceiling" errors=0 n=1 res=[15] cache=0 hits=0
test: list=3,15 ceiling=10
expect: => i=0 r=0.0 ok=false s="error: no squares dropped" errors=1 n=2 res=[3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var dropped = 0;
	while dropped < g.n {
		let x = g.res[dropped];
		var is_sq = false;
		var k = 1;
		while k * k <= x {
			if k * k == x { is_sq = true; break; }
			k++;
		}
		if is_sq && x < c {
			dropped++;
		} else {
			break;
		}
	}
	if dropped > 0 {
		let new_n = g.n - dropped;
		for k in new_n {
			g.res[k] = g.res[dropped + k];
		}
		g.n = new_n;
		out.i = dropped;
		out.ok = true;
		out.s.clear();
		format(out.s, "squares dropped while below ceiling");
	} else {
		gold_fail(g, "no squares dropped");
		out.i = 0;
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no squares dropped");
	}
	g.steps += g.n;
	out
}
@end
