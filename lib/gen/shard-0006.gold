		if is_v1 {
			for j in (i + 1)..out.s.len {
				let c2 = out.s[j];
				let is_v2 = c2 == 'a' || c2 == 'e' || c2 == 'i' || c2 == 'o' || c2 == 'u';
				if is_v2 {
					out.s[i] = c2;
					out.s[j] = c1;
					swapped++;
					break;
				}
			}
			break;
		}
	}
	g.steps++;
	out.i = swapped;
	out
}
@end
