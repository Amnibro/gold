	let step = ${k};
	if step <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		out.s.append("dropped all checkpoints");
		return out;
	}
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		if (idx + 1) % step != 0 {
			g.res[kept] = g.res[idx];
			kept++;
		}
		idx++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept after drop ", kept);
	out
}
