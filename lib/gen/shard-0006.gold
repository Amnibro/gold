		if d < min_d {
			min_d = d;
		}
		temp /= 10;
	}
	var rev = 0;
	var dropped = false;
	while v > 0 {
		let d = v % 10;
		if d == min_d && !dropped {
			dropped = true;
		} else {
			rev = rev * 10 + d;
		}
		v /= 10;
	}
	var res = 0;
	while rev > 0 {
		res = res * 10 + (rev % 10);
		rev /= 10;
	}
	res
}
@end
