fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if sum > c { break; }
		gold_cache_put(g, i / 2, sum);
		pairs++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "loop pairs formed ", pairs);
	out
}
@end
