test: list=1,4,3,6,5
expect: => i=5 r=0.0 ok=true s="rotated odds at most one" errors=0 n=5 res=[3,4,5,6,1] cache=0 hits=0
test: list=7,2,9,4
expect: => i=4 r=0.0 ok=true s="rotated odds at most one" errors=0 n=4 res=[9,2,7,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_odd = -1;
	var prev_idx = -1;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			if first_odd < 0 {
				first_odd = g.res[i];
			} else {
				g.res[prev_idx] = g.res[i];
			}
			prev_idx = i;
		}
	}
	if first_odd >= 0 && prev_idx >= 0 {
		g.res[prev_idx] = first_odd;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated odds at most one");
	out
}
@end
