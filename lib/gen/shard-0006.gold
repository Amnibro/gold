@entry 908671f6f148d1f0
kind: step
verb: repeat
noun: average
modifier: unique
context: search
phrase: repeat average over unique search results
phrase: compute mean across unique match items
test: list=2,2,4,4,6
expect: => i=4 r=0.0 ok=true s="unique average computed" errors=0 n=5 res=[2,2,4,4,6] cache=0 hits=0
test: list=10,10,20,30
expect: => i=20 r=0.0 ok=true s="unique average computed" errors=0 n=4 res=[10,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var un = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			sum += g.res[i];
			un++;
		}
	}
	let avg = if un > 0 { sum / un } else { 0 };
	out.i = avg;
	out.s.clear();
	out.s.append("unique average computed");
	g.steps += g.n;
	out
}
@end
