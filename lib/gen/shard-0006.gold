fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_range};
	if g.n < 2 {
		gold_fail(g, "list too short for range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	let span = max_val - min_val;
	out.i = span;
	out.s.clear();
	if span <= mr {
		out.ok = true;
		format(out.s, "range within allowable threshold");
	} else {
		gold_fail(g, "range exceeds maximum");
		out.ok = false;
		format(out.s, "error: range exceeds maximum");
	}
	g.steps += g.n;
	out
}
@end
