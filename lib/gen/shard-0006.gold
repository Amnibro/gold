kind: step
verb: shift
noun: threshold
modifier: safely
context: loop
phrase: shift loop results safely by offset steps {offset}
phrase: rotate loop elements safely by distance {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="safely shifted results by 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,15,25 offset=3
expect: => i=0 r=0.0 ok=true s="safely shifted results by 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 || off <= 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("no shift required");
		return out;
	}
	let steps = off % g.n;
	for s in steps {
		let first = g.res[0];
		for k in g.n - 1 {
			g.res[k] = g.res[k + 1];
		}
		g.res[g.n - 1] = first;
	}
	out.i = steps;
	g.steps += steps * g.n;
	out.s.clear();
	format(out.s, "safely shifted results by ", steps);
	out
}
@end
