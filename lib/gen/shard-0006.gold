noun: duplicates
modifier: first
context: filter
phrase: return duplicate elements first in filtered output
phrase: organize filtered results placing duplicates first
test: list=1,2,3,2,1,4
expect: => i=4 r=0.0 ok=true s="duplicates first: 4" errors=0 n=6 res=[1,2,2,1,3,4] cache=0 hits=0
test: list=7,8,9,7
expect: => i=2 r=0.0 ok=true s="duplicates first: 2" errors=0 n=4 res=[7,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = [0; 512];
	var singles = [0; 512];
	var nd = 0;
	var ns = 0;
	for i in g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq > 1 {
			dups[nd] = val;
			nd++;
		} else {
			singles[ns] = val;
			ns++;
		}
	}
	for i in nd { g.res[i] = dups[i]; }
	for j in ns { g.res[nd + j] = singles[j]; }
	out.i = nd;
	out.s.clear();
	format(out.s, "duplicates first: ", nd);
	out
}
@end
