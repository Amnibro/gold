fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c < 0 {
		gold_fail(g, "negative count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative count");
		return out;
	}
	var span = if c < g.n { c } else { g.n };
	let start = g.n - span;
	for k in span {
		g.res[k] = g.res[start + k];
	}
	g.n = span;
	out.i = span;
	out.s.clear();
	format(out.s, "nested suffix filtered");
	g.steps += span;
	out
}
@end
