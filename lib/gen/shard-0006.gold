@entry fba2ba0086b58861
kind: step
verb: pair
noun: prefix
modifier: up_to
context: error
phrase: pair prefix elements up to count {count}
phrase: match prefix items up to limit {count}
phrase: couple prefix entries up to bound {count}
slot: count int
test: list=10,20,30,40,50 count=4
expect: => i=2 r=0.0 ok=true s="paired prefix items" errors=0 n=3 res=[30,70,50] cache=0 hits=0
test: list=10,20 count=5
expect: => i=0 r=0.0 ok=false s="error: invalid prefix count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c < 2 || c > g.n || c % 2 != 0 {
		gold_fail(g, "invalid prefix count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid prefix count");
		return out;
	}
	var new_res = [0; 512];
	var pairs = c / 2;
	for k in pairs {
		new_res[k] = g.res[2 * k] + g.res[2 * k + 1];
	}
	var remaining = g.n - c;
	for k in remaining {
		new_res[pairs + k] = g.res[c + k];
	}
	let new_n = pairs + remaining;
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "paired prefix items");
	g.steps += g.n;
	out
}
@end
