code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] { first = false; }
		}
		if first { distinct++; }
	}
	let dups = g.n - distinct;
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicates total ", dups);
	out
}
@end
