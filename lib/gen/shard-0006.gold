fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rounds = 0;
	while ${cond}(out.i) && rounds < 10 {
		var num = out.i;
		var rev = 0;
		while num > 0 {
			rev = rev * 10 + (num % 10);
			num /= 10;
		}
		out.i = rev + 1;
		rounds++;
	}
	g.steps += rounds;
	out.s.clear();
	format(out.s, "reversed value across ", rounds, " loops");
	out
}
