test: list=2,4,6,-1,8
expect: => i=3 r=0.0 ok=true s="dropped streak of 3 items" errors=0 n=2 res=[-1,8] cache=1 hits=0
test: list=-3,4,5
expect: => i=0 r=0.0 ok=true s="dropped streak of 0 items" errors=0 n=3 res=[-3,4,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 0;
	while streak < g.n && g.res[streak] > 0 {
		streak++;
	}
	gold_cache_put(g, 0, streak);
	let remain = g.n - streak;
	for k in remain {
		g.res[k] = g.res[streak + k];
	}
	g.n = remain;
	out.i = streak;
	g.steps += g.n + streak;
	out.s.clear();
	format(out.s, "dropped streak of ", streak, " items");
	out
}
@end
