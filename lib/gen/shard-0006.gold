phrase: refresh list elements with cache factor {factor}
slot: factor int
test: list=2,3,4 factor=3
expect: => i=3 r=0.0 ok=true s="retried list items 3" errors=0 n=3 res=[6,9,12] cache=3 hits=0
test: list=5,10 factor=2
expect: => i=2 r=0.0 ok=true s="retried list items 2" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		let v_cached, hit = gold_cache_get(g, g.res[i]);
		if hit {
			g.res[i] = v_cached;
		} else {
			let new_v = g.res[i] * f;
			gold_cache_put(g, g.res[i], new_v);
			g.res[i] = new_v;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "retried list items ", g.n);
	out
}
@end
