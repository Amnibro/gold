@entry 597b379460170a67
kind: step
verb: dedupe
noun: list
modifier: last
context: filter
phrase: dedupe filtered list keeping last occurrences
phrase: retain final duplicates across filtered list
test: list=1,2,1,3,2,4
expect: => i=4 r=0.0 ok=true s="deduped last: 4" errors=0 n=4 res=[1,3,2,4] cache=0 hits=0
test: list=5,5,6,7,6
expect: => i=3 r=0.0 ok=true s="deduped last: 3" errors=0 n=3 res=[5,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		var found_later = false;
		for j in i + 1 .. g.n {
			if g.res[j] == g.res[i] {
				found_later = true;
				break;
			}
		}
		if !found_later {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped last: ", w);
	out
}
@end
