expect: => i=3 r=0.0 ok=true s="primes partitioned" errors=0 n=5 res=[3,5,7,4,8] cache=0 hits=0
test: list=2,9,6,11,15
expect: => i=2 r=0.0 ok=true s="primes partitioned" errors=0 n=5 res=[2,11,9,6,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var non_primes int[512] = [0; 512];
	var pn = 0;
	var npn = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_prime(x) {
			primes[pn] = x;
			pn++;
		} else {
			non_primes[npn] = x;
			npn++;
		}
	}
	for k in pn {
		g.res[k] = primes[k];
	}
	for k in npn {
		g.res[pn + k] = non_primes[k];
	}
	out.i = pn;
	out.s.clear();
	out.s.append("primes partitioned");
	g.steps += g.n;
	out
}
@end
