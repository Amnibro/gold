slot: low int
slot: high int
test: list=12,5,18,30,8 low=10 high=25
expect: => i=18 r=0.0 ok=true s="folded maximum in range" errors=0 n=6 res=[12,5,18,30,8,18] cache=0 hits=0
test: list=40,55,32,70 low=20 high=50
expect: => i=40 r=0.0 ok=true s="folded maximum in range" errors=0 n=5 res=[40,55,32,70,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var max_val = lo;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			if !found || x > max_val {
				max_val = x;
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no retry value in range");
		out.ok = false;
		return out;
	}
	gold_push(g, max_val);
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "folded maximum in range");
	out
}
@end
