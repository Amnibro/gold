fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("no middle element");
		return out;
	}
	let mid = g.res[g.n / 2];
	gold_cache_put(g, key, mid);
	g.steps += 1;
	out.i = mid;
	out.s.clear();
	format(out.s, "cached middle ", mid);
	out
}
