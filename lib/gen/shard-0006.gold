kind: step
verb: run
noun: tally
modifier: running
context: error
phrase: run tally running sum across results
phrase: compute running tally of all items
phrase: calculate running tally with error check
test: list=3,4,5
expect: => i=12 r=0.0 ok=true s="running tally complete" errors=0 n=3 res=[3,7,12] cache=0 hits=0
test: list=2,-5,1
expect: => i=-3 r=0.0 ok=false s="error: negative running tally" errors=1 n=3 res=[2,-3,-2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for running tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty tally");
		return out;
	}
	var sum = 0;
	var has_neg = false;
	for k in g.n {
		sum += g.res[k];
		g.res[k] = sum;
		if sum < 0 && !has_neg {
			has_neg = true;
			out.i = sum;
		}
	}
	out.s.clear();
	if has_neg {
		gold_fail(g, "running tally became negative");
		out.ok = false;
		format(out.s, "error: negative running tally");
	} else {
		out.i = sum;
		out.ok = true;
		format(out.s, "running tally complete");
	}
	g.steps += g.n;
	out
}
@end
