	let max_streak = ${cap};
	var w = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == x {
			if run_len < max_streak {
				g.res[w] = x;
				w++;
			}
			run_len++;
			i++;
		}
		gold_cache_put(g, x, run_len);
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "limited streaks to size ", w);
	out
}
