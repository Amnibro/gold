code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var max_run = if g.n > 0 { 1 } else { 0 };
	var cur_run = 1;
	if g.n > 1 {
		for k in 1..g.n {
			if g.res[k] == g.res[k - 1] {
				cur_run++;
				if cur_run > max_run { max_run = cur_run; }
			} else {
				cur_run = 1;
			}
		}
	}
	out.i = max_run;
	out.ok = max_run <= lim;
	out.s.clear();
	if out.ok {
		out.s.append("run lengths within bound");
	} else {
		out.s.append("run length exceeds limit");
	}
	g.steps += g.n;
	out
}
@end
