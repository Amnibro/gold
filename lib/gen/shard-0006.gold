	var new_n = 0;
	for i in start..g.n {
		g.res[new_n] = g.res[i];
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filtered sequence from first match");
	out
}
