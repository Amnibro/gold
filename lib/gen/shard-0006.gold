fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.i = 0; return out; }
	var max_gap = 0;
	for i in g.n - 1 {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap > max_gap { max_gap = gap; }
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap: ", max_gap);
	g.steps += g.n;
	out
}
@end
