kind: step
verb: normalize
noun: loop
modifier: at_least
context: sort
phrase: run sort normalization loop at least {min_iters} times
phrase: execute scaling loop over sorted items at least {min_iters} passes
slot: min_iters int
test: list=10,20,30 min_iters=2
expect: => i=2 r=0.0 ok=true s="ran normalize loop passes 2" errors=0 n=3 res=[10,18,28] cache=0 hits=0
test: list=4,8,12 min_iters=3
expect: => i=3 r=0.0 ok=true s="ran normalize loop passes 3" errors=0 n=3 res=[4,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let iters = ${min_iters};
    for iter in iters {
        if g.n > 0 {
            let base = g.res[0];
            for i in g.n {
                if g.res[i] > base {
                    g.res[i] -= 1;
                }
            }
        }
    }
    out.i = iters;
    g.steps += iters * g.n + 1;
    out.s.clear();
    format(out.s, "ran normalize loop passes ", iters);
    out
}
@end
