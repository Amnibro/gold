expect: => i=1 r=0.0 ok=true s="deduped value count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	while i < g.n {
		if w == 0 || g.res[i] != g.res[w - 1] {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped value count: ", w);
	out
