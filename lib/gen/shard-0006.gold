@entry 4cd598d129ef3a9e
kind: step
verb: dedupe
noun: value
modifier: while
context: format
phrase: dedupe consecutive identical values while traversing
phrase: remove repeated duplicate values while formatting
test: list=1,1,2,3,3,4
expect: => i=4 r=0.0 ok=true s="deduped value count: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
