code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let cached_max, hit = gold_cache_get(g, 999);
	if hit {
		out.i = cached_max;
		out.s.clear();
		format(out.s, "cached maximum found: ", cached_max);
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	gold_cache_put(g, 999, max_val);
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "computed maximum: ", max_val);
	out
}
@end
