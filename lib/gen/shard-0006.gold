@entry b931ab5654826893
kind: step
verb: reverse
noun: items
modifier: unique
context: loop
phrase: reverse distinct items preserving uniqueness
phrase: invert order of unique list elements
test: list=1,2,2,3,4
expect: => i=4 r=0.0 ok=true s="reversed 4 unique items" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=5,10,5,20
expect: => i=3 r=0.0 ok=true s="reversed 3 unique items" errors=0 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		var seen = false;
		for j in un {
			if uniq[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			uniq[un] = g.res[i];
			un++;
		}
	}
	for k in un {
		g.res[k] = uniq[un - 1 - k];
	}
	g.n = un;
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "reversed ", un, " unique items");
	out
}
@end
