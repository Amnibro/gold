@entry 6ea2d947b2bfb25a
kind: step
verb: find
noun: window
modifier: in_place
context: list
phrase: find window in place with size {w}
phrase: locate window in place spanning size {w}
slot: w int
test: list=1,3,2,5,4 w=3
expect: => i=11 r=0.0 ok=true s="max window sum is 11" errors=0 n=5 res=[1,3,2,5,4] cache=0 hits=0
test: list=10,20 w=2
expect: => i=30 r=0.0 ok=true s="max window sum is 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if g.n < win || win <= 0 { return out; }
	var max_sum = 0;
	for i in win { max_sum += g.res[i]; }
	var best_idx = 0;
	var cur_sum = max_sum;
	for i in g.n - win {
		cur_sum = cur_sum - g.res[i] + g.res[i + win];
		if cur_sum > max_sum {
			max_sum = cur_sum;
			best_idx = i + 1;
		}
	}
	out.i = max_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "max window sum is ", max_sum);
	out
}
@end
