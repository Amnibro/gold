fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	while g.n > 0 && g.res[0] < 0 && shifted < g.n {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		shifted++;
	}
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted);
	g.steps += shifted;
	out
}
@end
