test: list=5,15
expect: => i=2 r=0.0 ok=true s="normalized 2 elements across loop" errors=0 n=2 res=[33,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	if max_val > 0 {
		for i in g.n {
			g.res[i] = (g.res[i] * 100) / max_val;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized ", g.n, " elements across loop");
	out
}
@end
