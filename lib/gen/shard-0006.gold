@entry a59695ba8a9fd6fa
kind: step
verb: fill
noun: squares
modifier: between
context: retry
phrase: fill squares between range {low} to {high}
phrase: generate squares between bounds {low} to {high}
phrase: insert square values between limits {low} to {high}
slot: low int
slot: high int
test: low=4 high=20
expect: => i=3 r=0.0 ok=true s="squares filled in range" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: low=20 high=24
expect: => i=0 r=0.0 ok=false s="error: no squares in range" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	gold_clear(g);
	var count = 0;
	var k = 1;
	while k * k <= hi {
		let sq = k * k;
		if sq >= lo {
			gold_push(g, sq);
			count++;
		}
		k++;
	}
	out.i = count;
	out.s.clear();
	if count > 0 {
		out.ok = true;
		format(out.s, "squares filled in range");
	} else {
		gold_fail(g, "no squares in range");
		out.ok = false;
		format(out.s, "error: no squares in range");
	}
	g.steps += count;
	out
}
@end
