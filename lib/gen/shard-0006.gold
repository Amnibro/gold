fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var val = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${p}(g.res[i]) {
			val = g.res[i];
			found = true;
			break;
		}
		i--;
	}
	g.steps += g.n - i;
	out.ok = found;
	out.i = val;
	out.s.clear();
	if found {
		format(out.s, "collected last value ", val);
	} else {
		out.s.append("no matching value found");
	}
	out
}
@end
