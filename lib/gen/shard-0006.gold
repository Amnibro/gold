fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cut};
	var kept = 0;
	for k in g.n {
		if g.res[k] >= limit {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	if kept > 1 {
		var i = 0;
		while i < kept {
			var j = i + 1;
			while j < kept {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted threshold ", kept);
	out
}
