@entry ecb9efb0151510c2
kind: step
verb: sort
noun: head
modifier: unique
context: cache
phrase: sort unique head items for cache
phrase: order leading distinct cache elements
test: list=3,1,3,2,4
expect: => i=3 r=0.0 ok=true s="head sorted unique" errors=0 n=5 res=[1,2,3,2,4] cache=3 hits=0
