code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if g.n == 0 || rep <= 0 {
		gold_fail(g, "cannot normalize middle");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	for r in rep {
		g.res[mid] = (g.res[mid] + 1) / 2;
	}
	out.i = g.res[mid];
	g.steps += rep;
	out.s.clear();
	format(out.s, "normalized middle to ", out.i);
	out
}
@end
