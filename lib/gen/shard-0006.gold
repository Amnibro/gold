fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	gold_push(g, mean);
	out.i = mean;
	out.s.clear();
	format(out.s, "appended mean: ", mean);
	g.steps += g.n + 1;
	out
}
