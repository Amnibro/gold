fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	for i in g.n {
		let x = g.res[i];
		if acc > 1000000 - x {
			gold_fail(g, "overflow detected");
			out.ok = false;
			return out;
		}
		acc += x;
