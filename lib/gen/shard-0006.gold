fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	let last = g.res[g.n - 1];
	var is_max = true;
	for k in g.n - 1 {
		if g.res[k] >= last { is_max = false; }
	}
	g.steps += g.n;
	out.ok = is_max;
	out.i = if is_max { 1 } else { 0 };
