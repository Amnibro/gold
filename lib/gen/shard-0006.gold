expect: => i=2 r=0.0 ok=true s="found 2 gaps within threshold 3" errors=0 n=4 res=[2,5,9,11] cache=0 hits=0
test: list=10,20,30 th=5
expect: => i=0 r=0.0 ok=true s="found 0 gaps within threshold 5" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${th};
	var count = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			let gap = if d < 0 { -d } else { d };
			if gap <= max_gap { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " gaps within threshold ", max_gap);
	out
}
@end
