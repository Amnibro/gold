code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	gold_cache_put(g, 0, 5);
	var filled = 0;
	if g.n >= 2 {
		for k in g.n - 1 {
			let diff = g.res[k + 1] - g.res[k];
			if diff > mg {
				let fill_val, ok = gold_cache_get(g, 0);
				if ok {
					g.res[k + 1] = g.res[k] + fill_val;
					filled++;
				}
			}
		}
	}
	out.i = filled;
	out.ok = true;
	out.s.clear();
	out.s.append("retried gaps with cache");
	g.steps += g.n + 1;
	out
}
@end
