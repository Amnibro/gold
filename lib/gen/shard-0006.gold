noun: step
modifier: times
context: filter
phrase: join filtered results step by step times
phrase: combine adjacent filtered values repeatedly
test: list=1,2,3,4,5,6
expect: => i=2 r=0.0 ok=true s="step join done" errors=0 n=2 res=[10,11] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="step join done" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	while g.n > 2 && passes < 2 {
		var new_n = 0;
		var j = 0;
		while j + 1 < g.n {
			g.res[new_n] = g.res[j] + g.res[j + 1];
			new_n++;
			j += 2;
		}
		if j < g.n {
			g.res[new_n] = g.res[j];
			new_n++;
		}
		g.n = new_n;
		passes++;
	}
	out.i = g.n;
	g.steps += passes;
	out.s.clear();
	format(out.s, "step join done");
	out
}
@end
