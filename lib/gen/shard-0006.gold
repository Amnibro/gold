code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	for k in g.n {
		if g.res[k] >= th {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	out.s.append("sorted filtered numbers");
	g.steps += g.n;
	out
}
@end
@entry 9d826467a724253c
kind: step
verb: dedupe
noun: odds
modifier: in_place
context: search
phrase: dedupe odd search ranks in place
phrase: remove duplicate odd search matches in place
test: list=1,2,1,3,2,3
expect: => i=2 r=0.0 ok=true s="deduped odd ranks" errors=0 n=4 res=[1,2,3,2] cache=0 hits=0
test: list=5,5,5,8
expect: => i=2 r=0.0 ok=true s="deduped odd ranks" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		if x % 2 != 0 {
			for j in kept {
				if g.res[j] == x {
					dup = true;
					break;
				}
			}
		}
		if dup {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	out.s.append("deduped odd ranks");
	g.steps += g.n;
	out
}
@end
@entry 4bb2241cc284caab
kind: step
verb: dedupe
noun: numbers
modifier: first
context: search
phrase: dedupe first {count} search numbers
phrase: remove duplicates in first {count} search values
slot: count int
test: list=2,2,3,4,2,5 count=4
expect: => i=1 r=0.0 ok=true s="deduped prefix" errors=0 n=5 res=[2,3,4,2,5] cache=0 hits=0
test: list=1,1,1,2 count=3
expect: => i=2 r=0.0 ok=true s="deduped prefix" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var prefix_len = if c < g.n { c } else { g.n };
	if prefix_len < 0 { prefix_len = 0; }
	var kept = 0;
	for i in prefix_len {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let shift = prefix_len - kept;
	for i in prefix_len..g.n {
		g.res[i - shift] = g.res[i];
	}
	g.n -= shift;
	out.i = shift;
	out.s.clear();
	out.s.append("deduped prefix");
	g.steps += g.n;
	out
}
@end
