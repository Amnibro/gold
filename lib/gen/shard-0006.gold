fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[w] = (g.res[i] + g.res[i + 1]) * 2;
		w++;
		i += 2;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "subfunction joined: ", w);
	out
}
@end
