fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let limit = if k < g.n { k } else { g.n };
	if limit > 1 {
		let first = g.res[0];
		for i in limit - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[limit - 1] = first;
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "rotated leading series");
	out
}
@end
