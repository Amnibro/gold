fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_sq = 0;
	for k in g.n {
		sum_sq += g.res[k] * g.res[k];
	}
	let target_sq = out.i * out.i;
	if target_sq == sum_sq {
		out.ok = true;
		out.s.clear();
		out.s.append("square matches sum of squares");
	} else {
		out.ok = false;
		out.s.clear();
		format(out.s, "square mismatch diff ", target_sq - sum_sq);
	}
	g.steps += g.n;
	out
}
@end
