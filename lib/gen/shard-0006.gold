fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var ok = true;
	for i in out.s.len {
		let c = out.s[i];
		if c == '(' { depth++; }
		else if c == ')' {
			depth--;
			if depth < 0 { ok = false; break; }
		}
	}
	if depth != 0 { ok = false; }
	out.ok = ok;
	out.i = depth;
	if !ok { gold_fail(g, "unbalanced brackets"); }
	g.steps += out.s.len;
	out
}
@end
