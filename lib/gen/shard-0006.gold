test: list=4,3,2 threshold=5
expect: => i=0 r=0.0 ok=true s="dropped 0 head items" errors=0 n=3 res=[4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var drop_count = 0;
	while drop_count < g.n && g.res[drop_count] >= th {
		drop_count++;
	}
	let remain = g.n - drop_count;
	for k in remain {
		g.res[k] = g.res[drop_count + k];
	}
	g.n = remain;
	g.steps += g.n + drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " head items");
	out
}
@end
