fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var total = 0;
	var count = 0;
	for k in g.n {
		if g.res[k] >= thresh {
			total += g.res[k];
			count++;
		}
