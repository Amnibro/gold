code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var write_idx = 1;
		var i = 1;
		while i + 1 < g.n {
			g.res[write_idx] = g.res[i] + g.res[i + 1];
			write_idx++;
			i += 2;
		}
		if i < g.n {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		g.n = write_idx;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined tail nested");
	out
}
@end
