code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	var sum = 0;
	for i in g.n - 1 {
		sum += g.res[i];
	}
	let matches = (sum == g.res[g.n - 1]);
	out.ok = matches;
	out.i = sum;
	out.s.clear();
	if matches {
		out.s.append("last item matches sum");
	} else {
		out.s.append("sum mismatch");
	}
	g.steps += g.n;
	out
}
@end
