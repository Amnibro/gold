fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var keep int[100] = [0; 100];
	var klen = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= 2 && klen < 100 {
			keep[klen] = x;
			klen++;
		}
	}
	gold_clear(g);
	for i in klen { gold_push(g, keep[i]); }
	out.i = klen;
	out.s.clear();
	format(out.s, "filtered items: ", klen);
	g.steps += g.n;
	out
}
@end
