fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "too few items for pairwise caching");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n - 1 {
		let s = g.res[k] + g.res[k + 1];
		if s % 2 == 0 {
			gold_cache_put(g, count, s);
			count++;
		}
	}
	out.i = count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached ", count, " even pairwise sums");
	out
}
