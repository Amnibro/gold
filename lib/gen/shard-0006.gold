@entry c27ea4cb354eee16
kind: step
verb: split
noun: words
modifier: at_most
context: search
phrase: split search words at most {limit}
phrase: partition match text words at most {limit}
slot: limit int
test: text="alpha beta gamma delta" limit=2
expect: => i=2 r=0.0 ok=true s="alpha beta " errors=0 n=0 res=[] cache=0 hits=0
test: text="one two three" limit=1
expect: => i=1 r=0.0 ok=true s="one " errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var words = 0;
	var in_word = false;
	for i in out.s.len {
		if out.s[i] == 32 {
			in_word = false;
		} else {
			if !in_word {
				words++;
				in_word = true;
				if words > lim {
					out.s.resize(i, 0);
					break;
				}
			}
		}
	}
	out.i = if words > lim { lim } else { words };
	g.steps += out.i;
	out
}
@end
