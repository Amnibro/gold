expect: => i=3 r=0.0 ok=false s="reversed sorted series 3" errors=0 n=3 res=[3,1,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] { sorted = false; break; }
	}
	if sorted {
		for i in (g.n / 2) {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	gold_cache_put(g, 0, if sorted { 1 } else { 0 });
	g.steps += g.n + 1;
	out.i = g.n;
	out.ok = sorted;
	out.s.clear();
	format(out.s, "reversed sorted series ", g.n);
	out
}
@end
