fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_buf: byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		if c == 97 || c == 101 || c == 105 || c == 111 || c == 117 {
			v_buf.push(c);
		}
	}
	if v_buf.len > 1 {
		for i in v_buf.len {
			for j in v_buf.len - 1 {
				if v_buf[j] < v_buf[j + 1] {
					let tmp = v_buf[j];
					v_buf[j] = v_buf[j + 1];
					v_buf[j + 1] = tmp;
				}
			}
		}
	}
	out.s = v_buf;
	out.i = v_buf.len;
	out
}
@end
