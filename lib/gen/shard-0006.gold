expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
test: text="f e d"
expect: => i=3 r=0.0 ok=true s="def" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean: byte[..200] = "";
	for i in out.s.len {
		let ch = out.s[i];
		if ch != 32 {
			clean.push(ch);
		}
	}
	// bubble sort clean
	if clean.len > 1 {
		for i in clean.len {
			for j in clean.len - 1 {
				if clean[j] > clean[j + 1] {
					let tmp = clean[j];
					clean[j] = clean[j + 1];
					clean[j + 1] = tmp;
				}
			}
		}
	}
	out.s = clean;
	out.i = clean.len;
	out
}
@end
