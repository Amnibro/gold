code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	var last_dup_idx = -1;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] { last_dup_idx = j; }
		}
	}
	if last_dup_idx >= 0 {
		let last_val = g.res[g.n - 1];
		let dup_val = g.res[last_dup_idx];
		gold_cache_put(g, dup_val, last_val);
		out.i = dup_val + last_val;
		out.ok = true;
		out.s.clear();
		format(out.s, "paired last duplicate ", dup_val, " with final item ", last_val);
	} else {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("no duplicate found to pair with last item");
	}
	g.steps += g.n * g.n;
	out
}
@end
