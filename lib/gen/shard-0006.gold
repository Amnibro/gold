	let first = g.res[0];
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.s.clear();
	out.s.append("shifted loop in place");
	out
}
