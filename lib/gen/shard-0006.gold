expect: => i=0 r=0.0 ok=false s="mapped 0 items in runs reaching threshold" errors=0 n=4 res=[4,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= req {
			for k in i..j {
				g.res[k] = ${f}(g.res[k]);
				modified++;
			}
		}
		i = j;
	}
	out.i = modified;
	out.ok = modified > 0;
	out.s.clear();
	format(out.s, "mapped ", modified, " items in runs reaching threshold");
	g.steps += g.n;
	out
}
@end
