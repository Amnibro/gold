		out.ok = true;
		out.s.clear();
		format(out.s, "found at: ", found_idx);
	} else {
		out.i = -1;
		out.ok = false;
		out.s.clear();
		out.s.append("not found");
	}
	g.steps += g.n;
	out
}
@end
