		for j in i {
			if g.res[i] == g.res[j] { dup = true; break; }
		}
		if !dup { uniq++; }
	}
	out.i = uniq;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "found ", uniq, " unique results");
	out
}
