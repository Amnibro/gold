fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var steps = 0;
	while steps < g.n && ${cond}(g.res[steps]) {
		if g.res[steps] < min_val {
			min_val = g.res[steps];
		}
		steps++;
	}
	g.steps += steps;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum measured across ", steps, " steps: ", min_val);
	out
}
@end
