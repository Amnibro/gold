fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var s = 0;
	var count = 0;
	for i in g.n {
		if count >= limit { break; }
		s += g.res[i];
		count++;
	}
	out.i = s;
	g.steps += count;
	out.s.clear();
	format(out.s, "summed ", count, " prefix items");
	out
}
