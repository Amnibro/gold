code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let s = ${start};
    let e = ${finish};
    for i in out.s.len {
        if i >= s && i <= e {
            if out.s[i] >= 'a' && out.s[i] <= 'z' {
                out.s[i] = (out.s[i] as int - 32) as byte;
            }
        }
    }
    out.i = out.s.len;
    g.steps += out.s.len + 1;
    out
}
@end
@entry c0a6133f505430d5
kind: step
verb: drop
noun: primes
modifier: unique
context: sort
phrase: drop distinct prime values from sorted list
phrase: remove unique primes from sorted numbers
test: list=2,3,4,5,6,7,8
expect: => i=4 r=0.0 ok=true s="dropped prime count 4" errors=0 n=3 res=[4,6,8] cache=0 hits=0
test: list=3,4,6,9,10,11
expect: => i=2 r=0.0 ok=true s="dropped prime count 2" errors=0 n=4 res=[4,6,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var new_n = 0;
    var dropped = 0;
    for i in g.n {
        let x = g.res[i];
        var is_prime = x >= 2;
        if x > 2 && x % 2 == 0 {
            is_prime = false;
        } else if x > 2 {
            var d = 3;
            while d * d <= x {
                if x % d == 0 {
                    is_prime = false;
                    break;
                }
                d += 2;
            }
        }
        if is_prime {
            dropped++;
        } else {
            g.res[new_n] = x;
            new_n++;
        }
    }
    g.n = new_n;
    out.i = dropped;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "dropped prime count ", dropped);
    out
}
@end
