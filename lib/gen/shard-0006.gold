noun: primes
modifier: safely
context: cache
phrase: rotate prime cache values safely
phrase: cycle prime entries in cache safely
test: list=2,4,3,6,5
expect: => i=3 r=0.0 ok=true s="primes rotated safely" errors=0 n=5 res=[3,4,5,6,2] cache=1 hits=0
test: list=7,8,11,12
expect: => i=2 r=0.0 ok=true s="primes rotated safely" errors=0 n=4 res=[11,8,7,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_indices int[512] = [0; 512];
	var count = 0;
	for k in g.n {
		if core_is_prime(g.res[k]) {
			p_indices[count] = k;
			count++;
		}
	}
	if count > 1 {
		let first_prime = g.res[p_indices[0]];
		for i in 1..count {
			g.res[p_indices[i - 1]] = g.res[p_indices[i]];
		}
		g.res[p_indices[count - 1]] = first_prime;
	}
	gold_cache_put(g, 0, count);
	out.i = count;
	out.s.clear();
	out.s.append("primes rotated safely");
	g.steps += g.n;
	out
}
@end
@entry 901064bf04593ff9
kind: step
verb: return
noun: suffix
modifier: last
context: cache
phrase: return last suffix of {count} cached items
phrase: report trailing {count} cache values
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="suffix returned" errors=0 n=3 res=[3,4,5] cache=3 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="suffix returned" errors=0 n=2 res=[20,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var span = if c < g.n { c } else { g.n };
	if span < 0 { span = 0; }
	let start = g.n - span;
	for k in span {
		g.res[k] = g.res[start + k];
		gold_cache_put(g, k, g.res[k]);
	}
	g.n = span;
	out.i = span;
	out.s.clear();
	out.s.append("suffix returned");
	g.steps += span;
	out
}
@end
