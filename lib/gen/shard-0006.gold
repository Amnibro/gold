slot: budget int
test: list=30,10,20,50 budget=40
expect: => i=2 r=0.0 ok=true s="scanned sorted budget" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=100,200,300 budget=50
expect: => i=0 r=0.0 ok=false s="scanned sorted budget" errors=0 n=3 res=[100,200,300] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] <= b {
			sum += g.res[k];
			count++;
		} else {
			break;
		}
	}
	out.i = count;
	out.ok = count > 0;
	out.s.clear();
	out.s.append("scanned sorted budget");
	g.steps += g.n * g.n;
	out
}
@end
