fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for i in g.n {
		let s = core_digit_sum(g.res[i]);
		if s % 2 == 0 {
			g.res[i] = g.res[i] * 2;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "safe digit repeat: ", modified);
	out
}
@end
