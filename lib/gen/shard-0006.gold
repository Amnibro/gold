code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_halves = 0;
	for k in g.n {
		var x = g.res[k];
		while x > 0 && x % 2 == 0 {
			x /= 2;
			total_halves++;
		}
		g.res[k] = x;
	}
	g.steps += total_halves;
	out.i = total_halves;
	out.s.clear();
	format(out.s, "ran recursive halves ", total_halves);
	out
}
@end
