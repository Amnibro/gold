expect: => i=4 r=0.0 ok=true s="validated recursive streak" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_streak};
	if g.n == 0 {
		gold_fail(g, "empty streak to validate");
		out.ok = false;
		return out;
	}
	var max_s = 1;
	var cur_s = 1;
	for i in 1..g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_s++;
			if cur_s > max_s { max_s = cur_s; }
		} else {
			cur_s = 1;
		}
	}
	g.steps += g.n;
	out.i = max_s;
	if max_s < req {
		gold_fail(g, "streak requirement not met");
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient streak length");
		return out;
	}
	out.s.clear();
	format(out.s, "validated recursive streak");
	out
}
@end
