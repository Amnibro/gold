code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var gaps int[256] = [0; 256];
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			gaps[i] = if d < 0 { -d } else { d };
		}
		for i in g.n - 1 {
			g.res[i] = gaps[i];
		}
		g.n = g.n - 1;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized gaps between ", g.n + 1, " elements");
	out
}
@end
