fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos int[256] = [0; 256];
	var neg int[256] = [0; 256];
	var np = 0;
	var nn = 0;
	for i in g.n {
		if g.res[i] >= 0 {
			pos[np] = g.res[i];
			np++;
		} else {
			neg[nn] = g.res[i];
			nn++;
		}
	}
	for i in np { g.res[i] = pos[i]; }
	for i in nn { g.res[np + i] = neg[i]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "partitioned ", np, " positive numbers");
	out
}
@end
