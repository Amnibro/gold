code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let l = ${low};
    let h = ${high};
    var new_n = 0;
    var dropped = 0;
    for i in g.n {
        let cur = g.res[i];
        if cur >= l && cur <= h {
            dropped++;
        } else {
            g.res[new_n] = cur;
            new_n++;
        }
    }
    g.n = new_n;
    out.i = dropped;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "dropped range items count ", dropped);
    out
}
@end
