noun: minimum
modifier: with_cache
context: loop
phrase: reverse elements up to minimum with cache verification
phrase: invert items preceding minimum using cached position
test: list=5,8,2,9
expect: => i=2 r=0.0 ok=true s="reversed up to min index 2" errors=0 n=4 res=[2,8,5,9] cache=1 hits=0
test: list=10,20,30,5
expect: => i=3 r=0.0 ok=true s="reversed up to min index 3" errors=0 n=4 res=[5,30,20,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	gold_cache_put(g, 101, min_idx);
	var left = 0;
	var right = min_idx;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += min_idx + 1;
	out.i = min_idx;
	out.s.clear();
	format(out.s, "reversed up to min index ", min_idx);
	out
}
@end
