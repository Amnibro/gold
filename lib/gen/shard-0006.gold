code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = [0; 512];
	var un = 0;
	for i in g.n {
		var found = false;
		for j in un {
			if u[j] == g.res[i] { found = true; break; }
		}
		if !found && un < 512 {
			u[un] = g.res[i];
			un++;
		}
	}
	var w = 0;
	for k in un {
		if w + 2 <= 512 {
			g.res[w] = u[k]; w++;
			g.res[w] = u[k]; w++;
		}
	}
	g.n = w;
	out.i = un;
	out.s.clear();
	format(out.s, "duplicated unique count: ", un);
	out
}
@end
