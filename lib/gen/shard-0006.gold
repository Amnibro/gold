code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var span = if lim < g.n { lim } else { g.n };
	if span < 0 { span = 0; }
	for a in span {
		for b in a + 1..span {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
		}
	}
	for k in span { gold_cache_put(g, k, g.res[k]); }
	out.i = span;
	out.s.clear();
	out.s.append("prefix sorted at most");
	g.steps += span;
	out
}
@end
