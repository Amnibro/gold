test: list=-5,2
expect: => i=1 r=0.0 ok=true s="merged errors count 1" errors=0 n=2 res=[-5,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged = 0;
	var i = 0;
	while i + 1 < g.n {
		let e1 = if g.res[i] < 0 { -g.res[i] } else { 0 };
		let e2 = if g.res[i + 1] < 0 { -g.res[i + 1] } else { 0 };
		let sum = e1 + e2;
		gold_cache_put(g, i / 2, sum);
		merged++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged errors count ", merged);
	out
}
@end
