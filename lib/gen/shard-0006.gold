		var i = 0;
		while i + 1 < g.n {
			gold_cache_put(g, g.res[i], g.res[i + 1]);
			count++;
			i += 2;
		}
	}
	out.i = count;
	out.s.clear();
	out.s.append("numbers cached pairwise");
	g.steps += count;
	out
}
@end
