slot: high int
test: list=2,15,8,25 low=5 high=20
expect: => i=8 r=0.0 ok=true s="found minimum in bounds" errors=0 n=4 res=[2,15,8,25] cache=0 hits=0
test: list=2,30 low=5 high=20
expect: => i=0 r=0.0 ok=false s="error: no elements in range" errors=1 n=2 res=[2,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var min_val = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	out.s.clear();
	if found {
		out.i = min_val;
		out.ok = true;
		format(out.s, "found minimum in bounds");
	} else {
		gold_fail(g, "no elements in range");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: no elements in range");
	}
	g.steps += g.n;
	out
}
@end
