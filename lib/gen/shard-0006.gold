fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid_letters = 0;
	for i in g.n {
		let c = g.res[i];
		let is_upper = c >= 65 && c <= 90;
		let is_lower = c >= 97 && c <= 122;
		if is_upper || is_lower {
			valid_letters++;
		} else {
			gold_fail(g, "invalid letter byte");
		}
	}
	g.steps += g.n + 1;
	out.i = valid_letters;
	out.s.clear();
	format(out.s, "valid letters found ", valid_letters);
