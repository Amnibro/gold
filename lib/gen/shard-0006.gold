fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${lo};
	let stop = ${hi};
	if start > stop {
		gold_fail(g, "invalid range bounds");
		out.ok = false;
		return out;
	}
	gold_clear(g);
	var cur = start;
	while cur <= stop {
		gold_push(g, cur);
		cur++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled range with ", g.n, " elements");
