fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_stride = 0;
	var count = 0;
	var i = 0;
	while i + 2 < g.n {
		let stride = g.res[i + 2] - g.res[i];
		total_stride += if stride < 0 { -stride } else { stride };
		count++;
		i += 2;
	}
	g.steps += count;
	out.i = total_stride;
	out.s.clear();
	format(out.s, "measured alternate strides: ", total_stride);
	out
}
