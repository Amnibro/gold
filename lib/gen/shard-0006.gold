	let th = ${threshold};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] >= th || g.res[i + 1] >= th {
			gold_fail(g, "threshold reached");
			break;
		}
		gold_cache_put(g, g.res[i], g.res[i + 1]);
		pairs++;
		i += 2;
