expect: => i=2 r=0.0 ok=true s="sorted total passes: 2" errors=0 n=3 res=[3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var is_sorted = false;
	while !is_sorted && passes < 20 {
		is_sorted = true;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				is_sorted = false;
			}
		}
		passes++;
	}
	out.i = passes;
	g.steps += passes;
	out.s.clear();
	format(out.s, "sorted total passes: ", passes);
	out
}
@end
