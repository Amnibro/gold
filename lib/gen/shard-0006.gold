code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for k in g.n { total += g.res[k]; }
	let avg = if g.n > 0 { total / g.n } else { 0 };
	for k in g.n {
		let diff = g.res[k] - avg;
		gold_cache_put(g, k, diff);
	}
	out.i = avg;
	gold_text(out, "normalized average any");
	g.steps += g.n;
	out
}
@end
