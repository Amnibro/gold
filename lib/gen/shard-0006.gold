fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	let ok = avg >= th;
	gold_cache_put(g, 0, avg);
	g.steps += g.n + 1;
	out.i = avg;
	out.ok = ok;
	out.s.clear();
	format(out.s, "checked average value ", avg);
	out
}
@end
