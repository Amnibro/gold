fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let mul = ${factor};
	var applied = 0;
	for k in g.n {
		if k < cnt {
			g.res[k] *= mul;
			applied++;
		}
	}
	out.i = applied;
	g.steps += applied;
	out.s.clear();
	format(out.s, "scaled ", applied, " prefix elements");
	out
}
