phrase: verify errors remain below limit threshold {ceiling}
slot: ceiling int
test: list=2,5,8,12 ceiling=10
expect: => i=3 r=0.0 ok=false s="error exceeded bound at index 3" errors=0 n=4 res=[2,5,8,12] cache=0 hits=0
test: list=1,3,4 ceiling=10
expect: => i=3 r=0.0 ok=true s="all errors within ceiling bound" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var idx = 0;
	var exceeded = false;
	while idx < g.n {
		if g.res[idx] > ceil {
			exceeded = true;
			break;
		}
		idx++;
	}
	if exceeded {
		out.ok = false;
		out.i = idx;
		out.s.clear();
		format(out.s, "error exceeded bound at index ", idx);
	} else {
		out.ok = true;
		out.i = g.n;
		out.s.clear();
		out.s.append("all errors within ceiling bound");
	}
	g.steps += idx + 1;
	out
}
@end
