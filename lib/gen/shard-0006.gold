code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var in_space = false;
	var spaces_removed = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if !in_space {
				out.s[write_idx] = c;
				write_idx++;
				in_space = true;
			} else {
				spaces_removed++;
			}
		} else {
			out.s[write_idx] = c;
			write_idx++;
			in_space = false;
		}
	}
	while out.s.len > write_idx {
		out.s.pop();
	}
	out.i = spaces_removed;
	g.steps += out.s.len;
	out
}
@end
@entry 499f527cc3fb48ce
kind: step
verb: filter
noun: streak
modifier: all
context: search
phrase: filter all longest streak items in search
phrase: keep maximum streak elements in search results
test: list=1,2,2,2,3,3
expect: => i=3 r=0.0 ok=true s="streak filtered" errors=0 n=3 res=[2,2,2] cache=0 hits=0
test: list=4,4,5,6,6,6
expect: => i=3 r=0.0 ok=true s="streak filtered" errors=0 n=3 res=[6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_streak = 0;
	var best_val = g.res[0];
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			if cur_streak > max_streak {
				max_streak = cur_streak;
				best_val = g.res[i - 1];
			}
			cur_streak = 1;
		}
	}
	if cur_streak > max_streak {
		max_streak = cur_streak;
		best_val = g.res[g.n - 1];
	}
	g.n = 0;
	for i in max_streak {
		gold_push(g, best_val);
	}
	out.i = max_streak;
	out.s.clear();
	out.s.append("streak filtered");
	g.steps += max_streak;
	out
}
@end
