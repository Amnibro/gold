fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = if ${length} > g.n { g.n } else { ${length} };
	for i in (len / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[len - 1 - i];
		g.res[len - 1 - i] = tmp;
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += len + 1;
	out.i = len;
	out.s.clear();
	format(out.s, "swapped prefix length ", len);
	out
}
@end
