fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let item = g.res[k];
		var prev, hit = gold_cache_get(g, item);
		if hit {
			gold_cache_put(g, item, prev + 1);
		} else {
			gold_cache_put(g, item, 1);
		}
	}
	out.i = g.cn;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "grouped into ", g.cn, " unique cache buckets");
	out
}
@end
