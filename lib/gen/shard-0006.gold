@entry e029d095d579e4b9
kind: step
verb: keep
noun: total
modifier: each
context: format
phrase: keep format total for each group of size {chunk_size}
phrase: compute totals for each chunk {chunk_size} in format
phrase: store cumulative sum for each block {chunk_size}
slot: chunk_size int
test: list=1,2,3,4,5,6 chunk_size=2
expect: => i=3 r=0.0 ok=true s="kept 3 chunk totals for each group" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 chunk_size=3
expect: => i=2 r=0.0 ok=true s="kept 2 chunk totals for each group" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 { out.ok = false; return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var chunk_sum = 0;
		let bound = if i + sz < g.n { i + sz } else { g.n };
		for k in i..bound { chunk_sum += g.res[k]; }
		g.res[kept] = chunk_sum;
		kept++;
		i += sz;
	}
	g.n = kept;
	out.i = kept;
	out.ok = kept > 0;
	out.s.clear();
	format(out.s, "kept ", kept, " chunk totals for each group");
	g.steps += g.n + 1;
	out
}
@end
@entry e0d9473c7122258f
kind: step
verb: reverse
noun: maximum
modifier: first
context: format
phrase: reverse elements preceding first maximum in format
phrase: invert prefix up to first peak in format
phrase: reverse items before first maximum value
test: list=1,2,3,100,5
expect: => i=3 r=0.0 ok=true s="reversed 3 items before first maximum" errors=0 n=5 res=[3,2,1,100,5] cache=0 hits=0
test: list=10,20,50,5
expect: => i=2 r=0.0 ok=true s="reversed 2 items before first maximum" errors=0 n=4 res=[20,10,50,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	var max_val = g.res[0];
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			max_idx = k;
		}
	}
	var i = 0;
	var j = max_idx - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = max_idx;
	out.ok = true;
	out.s.clear();
	format(out.s, "reversed ", max_idx, " items before first maximum");
	g.steps += g.n;
	out
}
@end
