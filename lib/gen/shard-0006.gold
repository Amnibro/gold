fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let bound = ${min_len};
    var valid_runs = 0;
    var cur_run = 1;
    if g.n > 1 {
        for i in 1..g.n {
            if g.res[i] >= g.res[i - 1] {
                cur_run++;
            } else {
                if cur_run >= bound {
                    valid_runs++;
                }
                cur_run = 1;
            }
        }
        if cur_run >= bound {
            valid_runs++;
        }
    }
    out.i = valid_runs;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "grouped runs count ", valid_runs);
    out
}
@end
