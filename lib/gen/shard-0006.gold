@entry 2405188f71b25b63
kind: step
verb: split
noun: primes
modifier: every_other
context: list
phrase: split primes every other index
phrase: partition prime values at alternating steps
test: list=2,4,3,6,5
expect: => i=3 r=0.0 ok=true s="found 3 primes at alternating indices" errors=0 n=5 res=[2,4,3,6,5] cache=0 hits=0
test: list=4,7,8,9
expect: => i=0 r=0.0 ok=true s="found 0 primes at alternating indices" errors=0 n=4 res=[4,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p { prime_count++; }
		i += 2;
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "found ", prime_count, " primes at alternating indices");
	out
}
@end
