noun: evens
modifier: in_reverse
context: stats
phrase: collect even sample observations in reverse
phrase: gather even data points in reverse order
test: list=1,2,3,4,6
expect: => i=3 r=0.0 ok=true s="evens collected in reverse" errors=0 n=3 res=[6,4,2] cache=0 hits=0
test: list=5,8,10,12
expect: => i=3 r=0.0 ok=true s="evens collected in reverse" errors=0 n=3 res=[12,10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] % 2 == 0 {
			temp[count] = g.res[i];
			count++;
		}
		i--;
	}
	for k in count {
		g.res[k] = temp[k];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	out.s.append("evens collected in reverse");
	g.steps += g.n;
	out
}
@end
