@entry 13a8754d52e63ced
kind: step
verb: trace
noun: gaps
modifier: with_retry
context: stats
phrase: trace gaps with retry compute average step between items
phrase: calculate mean adjacent gap across observations
test: list=10,20,30,40
expect: => i=30 r=10.0 ok=true s="mean gap computed" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=0,5,15
expect: => i=15 r=7.5 ok=true s="mean gap computed" errors=0 n=3 res=[0,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.r = 0.0; return out; }
	var total_gap = 0;
	let pairs = g.n - 1;
	for i in pairs {
		let d = g.res[i + 1] - g.res[i];
		total_gap += if d < 0 { -d } else { d };
	}
	out.r = total_gap as real / pairs as real;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "mean gap computed");
	g.steps += pairs;
	out
}
@end
