fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			total += x;
			gold_cache_put(g, x, 1);
		}
	}
	out.i = total;
	out.s.clear();
	out.s.append("unique items folded");
	g.steps += g.n;
	out
}
