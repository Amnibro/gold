kind: step
verb: count
noun: pairs
modifier: between
context: search
phrase: count adjacent candidate pairs with difference between bounds {low} through {high}
phrase: tally neighbouring search pairs differing within span {low} to {high}
slot: low int
slot: high int
test: list=10,25,30,60 low=10 high=20
expect: => i=1 r=0.0 ok=true s="counted 1 pairs in span" errors=0 n=4 res=[10,25,30,60] cache=0 hits=0
test: list=1,12,25,40 low=10 high=15
expect: => i=3 r=0.0 ok=true s="counted 3 pairs in span" errors=0 n=4 res=[1,12,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	for k in (g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d >= lo && abs_d <= hi { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " pairs in span");
	out
}
@end
