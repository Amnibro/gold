fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a < 0 || b < 0 {
			gold_fail(g, "invalid negative space");
		}
		let sum = a + b;
		gold_cache_put(g, i / 2, sum);
		merged++;
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = merged;
	out.s.clear();
	format(out.s, "pairwise spaces merged ", merged);
	out
}
@end
