fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			let s_i = core_digit_sum(g.res[i]);
			let s_j = core_digit_sum(g.res[j]);
			if s_i > s_j {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	out.s.append("sorted by digit sum");
	g.steps += g.n;
	out
}
@end
