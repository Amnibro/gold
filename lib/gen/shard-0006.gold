test: list=-5,10,20 min_errs=3
expect: => i=1 r=0.0 ok=false s="insufficient format errors to pair" errors=0 n=3 res=[-5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_errs};
	var err_count = 0;
	for k in g.n {
		if g.res[k] < 0 { err_count++; }
	}
	if err_count >= req && err_count >= 2 {
		var first = -1;
		var pairs = 0;
		for k in g.n {
			if g.res[k] < 0 {
				if first < 0 {
					first = g.res[k];
				} else {
					gold_cache_put(g, first, g.res[k]);
					pairs++;
					first = -1;
				}
			}
		}
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "paired ", pairs, " format error items");
	} else {
		out.i = err_count;
		out.ok = false;
		out.s.clear();
		out.s.append("insufficient format errors to pair");
	}
	g.steps += g.n + 1;
	out
}
@end
