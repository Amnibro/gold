code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${p}(g.res[i]) {
			temp[count] = g.res[i];
			count++;
		}
		i--;
	}
	for k in count {
		g.res[k] = temp[k];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	out.s.append("filtered in reverse");
	g.steps += count;
	out
}
@end
