expect: => i=0 r=0.0 ok=true s="merged qualifying digits total: 0" errors=0 n=2 res=[12,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var total = 0;
	for i in g.n {
		var num = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while num > 0 {
			let d = num % 10;
			if d >= th {
				total += d;
			}
			num /= 10;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "merged qualifying digits total: ", total);
	out
}
@end
