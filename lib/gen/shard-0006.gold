	let max_d = ${max_dup};
	if max_d <= 0 {
		gold_fail(g, "max duplicates must be positive");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for k in g.n {
		var cnt = 0;
		for j in kept {
			if g.res[j] == g.res[k] { cnt++; }
		}
		if cnt < max_d {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " elements");
	out
}
