slot: target int
test: list=5,10,15,20 target=10
expect: => i=1 r=0.0 ok=true s="head searched in reverse" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=1,2,3,4 target=9
expect: => i=-1 r=0.0 ok=false s="head searched in reverse" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let half = g.n / 2;
	var found = false;
	var idx = -1;
	var i = half - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			found = true;
			idx = i;
			break;
		}
		i--;
	}
	out.ok = found;
	out.i = idx;
	out.s.clear();
	out.s.append("head searched in reverse");
	g.steps += half;
	out
}
@end
