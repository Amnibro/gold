test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="placed tail element 4 to front" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20
expect: => i=20 r=0.0 ok=true s="placed tail element 20 to front" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		out.s.append("no rotation possible");
		return out;
	}
	let last = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[0] = last;
	out.i = last;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "placed tail element ", last, " to front");
	out
}
@end
