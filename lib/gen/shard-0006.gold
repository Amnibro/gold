fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("need pair for maximum");
		return out;
	}
	var max_pair = g.res[0] + g.res[1];
	var k = 1;
	while k < g.n - 1 {
