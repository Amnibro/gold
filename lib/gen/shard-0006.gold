				cur_streak++;
				if cur_streak > longest { longest = cur_streak; }
			} else {
				cur_streak = 1;
			}
		}
	} else {
		longest = g.n;
	}
	out.i = longest;
	out.s.clear();
	format(out.s, "longest streak safely: ", longest);
