@entry 7c0d95cac686f884
kind: step
verb: search
noun: results
modifier: in_place
context: list
phrase: search results in place shift minimum to front
phrase: move lowest value to first list position
test: list=5,1,8,3
expect: => i=1 r=0.0 ok=true s="minimum front: 1" errors=0 n=4 res=[1,5,8,3] cache=0 hits=0
test: list=10,2
expect: => i=2 r=0.0 ok=true s="minimum front: 2" errors=0 n=2 res=[2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let min_val = g.res[min_idx];
	var i = min_idx;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = min_val;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum front: ", min_val);
	g.steps += g.n;
	out
}
@end
