@entry 104626d6713043dd
kind: step
verb: clamp
noun: step
modifier: with_cache
context: retry
phrase: clamp retry step results with cache bounded by {max_val}
phrase: restrict retry steps to ceiling {max_val} using cache
slot: max_val int
test: list=10,25,15,30 max_val=20
expect: => i=2 r=0.0 ok=true s="clamped steps with cache" errors=0 n=4 res=[10,20,15,20] cache=4 hits=0
test: list=5,8,12 max_val=10
expect: => i=1 r=0.0 ok=true s="clamped steps with cache" errors=0 n=3 res=[5,8,10] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let nx = if x > mv { mv } else { x };
			if x > mv { clamped++; }
			gold_cache_put(g, x, nx);
			g.res[i] = nx;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped steps with cache");
	out
}
@end
