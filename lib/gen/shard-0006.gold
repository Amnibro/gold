code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached_idx, ok = gold_cache_get(g, tgt);
	if ok {
		out.i = cached_idx;
		out.ok = true;
		out.s.clear();
		format(out.s, "sequence target found");
		return out;
	}
	var found = -1;
	for k in g.n {
		if g.res[k] == tgt {
			found = k;
			break;
		}
	}
	out.s.clear();
	if found >= 0 {
		gold_cache_put(g, tgt, found);
		out.i = found;
		out.ok = true;
		format(out.s, "sequence target found");
	} else {
		gold_fail(g, "target sequence item not found");
		out.i = -1;
		out.ok = false;
		format(out.s, "error: target not found");
	}
	g.steps += g.n;
	out
}
@end
