expect: => i=9 r=0.0 ok=true s="folded unique middle" errors=0 n=7 res=[10,2,3,2,4,20,9] cache=0 hits=0
test: list=5,1,1,6,1,7,8
expect: => i=14 r=0.0 ok=true s="folded unique middle" errors=0 n=8 res=[5,1,1,6,1,7,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		gold_fail(g, "not enough items for middle fold");
		out.ok = false;
		return out;
	}
	var u_sum = 0;
	var count = 0;
	for i in 1..g.n - 1 {
		let x = g.res[i];
		var seen = false;
		for j in 1..i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			u_sum += x;
			count++;
		}
	}
	gold_push(g, u_sum);
	g.steps += g.n;
	out.i = u_sum;
	out.s.clear();
	format(out.s, "folded unique middle");
	out
}
@end
@entry 58f6650db4ae1617
kind: step
verb: sort
noun: average
modifier: times
context: retry
phrase: sort retry results comparing to average times {passes}
phrase: perform average guided sorting passes {passes}
slot: passes int
test: list=8,3,5,1 passes=2
expect: => i=4 r=0.0 ok=true s="sorted with average passes" errors=0 n=4 res=[3,1,5,8] cache=0 hits=0
test: list=20,10,40,30 passes=3
expect: => i=25 r=0.0 ok=true s="sorted with average passes" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	if g.n == 0 {
		gold_fail(g, "no retry items to sort");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for it in p {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
	}
	g.steps += p * g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "sorted with average passes");
	out
}
@end
@entry cbd2477a546de621
kind: step
verb: join
noun: function
modifier: with_cache
context: retry
phrase: join retry results applying function {f} with cache
phrase: combine retry entries mapped by {f} using cache
slot: f fn
test: list=2,3,2,4 f=double
expect: => i=22 r=0.0 ok=true s="joined function with cache" errors=0 n=5 res=[4,6,4,8,22] cache=3 hits=1
test: list=5,1,5,2 f=square
expect: => i=55 r=0.0 ok=true s="joined function with cache" errors=0 n=5 res=[25,1,25,4,55] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		let res = if ok { val } else {
			let fx = ${f}(x);
			gold_cache_put(g, x, fx);
			fx
		};
		g.res[i] = res;
		total += res;
	}
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "joined function with cache");
	out
}
@end
