@entry 9d5e107ebeec7e93
kind: step
verb: find
noun: text
modifier: in_reverse
context: stats
phrase: find target label {target} in reverse
phrase: locate text token {target} in reverse order
slot: target text
test: text="sample alpha beta" target="alpha"
expect: => i=0 r=0.0 ok=true s="reverse text searched" errors=0 n=0 res=[] cache=0 hits=0
test: text="data gamma delta" target="omega"
expect: => i=0 r=0.0 ok=false s="reverse text searched" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = false;
	if out.s.len >= t.len && t.len > 0 {
		var i = out.s.len - t.len;
		while i >= 0 {
			var m = true;
			for j in t.len {
				if out.s[i + j] != t[j] {
					m = false;
					break;
				}
			}
			if m {
				found = true;
				break;
			}
			if i == 0 { break; }
			i--;
		}
	}
	out.ok = found;
	out.s.clear();
	out.s.append("reverse text searched");
	g.steps++;
	out
}
@end
