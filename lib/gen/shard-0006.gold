fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var len = 0;
	for i in g.n {
		if g.res[i] == 32 { break; }
		len++;
	}
	let ok = len <= ml;
	if !ok {
		gold_fail(g, "word too long");
	}
	g.steps += len + 1;
	out.i = len;
	out.ok = ok;
	out.s.clear();
	format(out.s, "first word length ", len);
	out
}
