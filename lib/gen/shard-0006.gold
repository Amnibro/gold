fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${limit};
	var adjusted = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff > max_gap {
				g.res[i + 1] = g.res[i] + max_gap;
				adjusted++;
			}
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted ", adjusted, " wide gaps");
	out
}
@end
