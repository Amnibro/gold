	var out = v;
	var sorted_ok = true;
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			sorted_ok = false;
			break;
		}
	}
	out.ok = sorted_ok;
	if sorted_ok {
		out.s.clear();
		out.s.append("items are in sorted order");
	} else {
		out.s.clear();
		out.s.append("items are not sorted");
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
@entry dd251b3e0bf34518
kind: step
verb: cache
noun: history
modifier: up_to
context: compare
phrase: cache values comparing above threshold up to cap {cap} {threshold}
phrase: record items exceeding threshold into cache {cap} {threshold}
slot: cap int
slot: threshold int
test: list=5,12,18,3 cap=2 threshold=10
expect: => i=2 r=0.0 ok=true s="cached 2 elements over threshold" errors=0 n=4 res=[5,12,18,3] cache=2 hits=0
