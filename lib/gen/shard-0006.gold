@entry b56de485c8836f7d
kind: step
verb: select
noun: middle
modifier: recursively
context: search
phrase: select middle candidate segment recursively with depth {depth}
phrase: filter central search results recursively up to {depth} passes
slot: depth int
test: list=10,20,30,40,50,60,70,80 depth=2
expect: => i=2 r=0.0 ok=true s="selected middle segment of size 2" errors=0 n=2 res=[40,50] cache=0 hits=0
test: list=1,2,3,4 depth=1
expect: => i=2 r=0.0 ok=true s="selected middle segment of size 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	var d = 0;
	while d < max_d && g.n >= 4 {
		let q = g.n / 4;
		let take = g.n / 2;
		for i in take {
			g.res[i] = g.res[q + i];
		}
		g.n = take;
		d++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected middle segment of size ", g.n);
	out
}
@end
