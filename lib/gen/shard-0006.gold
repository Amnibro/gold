@entry c40f8bb723fbdde6
kind: step
verb: dedupe
noun: cache
modifier: in_reverse
context: core
phrase: prune duplicate cache elements backwards
phrase: purge repeated cache keys in reverse direction
test: list=1,2,2,3,1
expect: => i=3 r=0.0 ok=true s="deduped 3 unique cache entries in reverse" errors=0 n=5 res=[1,2,2,3,1] cache=3 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="deduped 1 unique cache entries in reverse" errors=0 n=3 res=[5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in unique_count {
			if g.ck[j] == x { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, x, x);
			unique_count++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "deduped ", unique_count, " unique cache entries in reverse");
	out
}
@end
