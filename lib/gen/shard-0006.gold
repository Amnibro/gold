fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var replaced = 0;
	var i = 1;
	while i < g.n && replaced < rep {
		g.res[i] = max_val;
		replaced++;
		i += 2;
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "repeated maximum every other");
	out
}
@end
