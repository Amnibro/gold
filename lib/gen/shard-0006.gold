fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_pal = true;
	let n = out.s.len;
	if n > 1 {
		for i in n / 2 {
			if out.s[i] != out.s[n - 1 - i] {
				is_pal = false;
				break;
			}
		}
	}
	out.ok = is_pal;
	g.steps += n + 1;
	out.i = if is_pal { 1 } else { 0 };
	out
}
