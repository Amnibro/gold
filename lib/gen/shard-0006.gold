test: list=10,20 max_drop=0
expect: => i=0 r=0.0 ok=false s="error: invalid drop count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_drop};
	if md <= 0 {
		gold_fail(g, "drop count must be positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid drop count");
		return out;
	}
	var to_drop = md;
	if to_drop > g.n {
		to_drop = g.n;
	}
	let new_n = g.n - to_drop;
	for k in new_n {
		g.res[k] = g.res[k + to_drop];
	}
	g.n = new_n;
	out.i = to_drop;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped words with retry adjustment");
	g.steps += to_drop;
	out
}
@end
