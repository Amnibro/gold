fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	if n <= 1 {
		g.steps += 1;
		return out;
	}
	let k = (${times} % n + n) % n;
	var buf byte[..200] = "";
	for i in n {
		buf.push(out.s[(i + k) % n]);
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += n + 1;
	out.i = k;
	out
}
@end
