@entry d1bbcb20a0aaa18a
kind: step
verb: search
noun: counter
modifier: with_retry
context: cache
phrase: search step counter with {retries} retries
phrase: query cache counter allowing {retries} attempts
slot: retries int
test: list=10,20 retries=2
expect: => i=2 r=0.0 ok=true s="counter searched with retry" errors=0 n=2 res=[10,20] cache=1 hits=0
test: list=5 retries=0
expect: => i=1 r=0.0 ok=true s="counter searched with retry" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var found_val = 0;
	var found = false;
	var i = 0;
	while i <= r && !found {
		let val, ok = gold_cache_get(g, g.steps + i);
		if ok {
			found_val = val;
			found = true;
		}
		i++;
	}
	if !found {
		gold_cache_put(g, g.steps, g.n);
		found_val = g.n;
	}
	out.i = found_val;
	out.s.clear();
	out.s.append("counter searched with retry");
	g.steps += 1;
	out
}
@end
