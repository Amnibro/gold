code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var indices int[64];
	var count = 0;
	for i in g.n {
		if g.res[i] > th && count < 64 {
			indices[count] = i;
			count++;
		}
	}
	for k in (count / 2) {
		let idx1 = indices[k];
		let idx2 = indices[count - 1 - k];
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		gold_cache_put(g, idx1, g.res[idx1]);
	}
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed condition items ", count);
	out
}
@end
