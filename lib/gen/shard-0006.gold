fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left int[256] = [0; 256];
	var right int[256] = [0; 256];
	var nl = 0;
	var nr = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) {
			left[nl] = x;
			nl++;
		} else {
			right[nr] = x;
			nr++;
		}
	}
	for i in nl { g.res[i] = left[i]; }
	for i in nr { g.res[nl + i] = right[i]; }
	g.steps += g.n;
	out.i = nl;
	out.s.clear();
	format(out.s, "partitioned ", nl, " matching elements");
	out
}
@end
