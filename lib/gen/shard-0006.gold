@entry c67c46302fa5436b
kind: step
verb: run
noun: loop
modifier: with_retry
context: sort
phrase: run sort passes with retry limit {retries}
phrase: execute sort cycles with retry count {retries}
slot: retries int
test: list=5,3,1 retries=3
expect: => i=3 r=0.0 ok=true s="completed sort loop passes 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=4,2,6 retries=2
expect: => i=2 r=0.0 ok=true s="completed sort loop passes 2" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${retries};
    var passes = 0;
    while passes < limit {
        passes++;
        var swapped = false;
        if g.n > 1 {
            for i in 1..g.n {
                if g.res[i - 1] > g.res[i] {
                    let tmp = g.res[i - 1];
                    g.res[i - 1] = g.res[i];
                    g.res[i] = tmp;
                    swapped = true;
                }
            }
        }
        if !swapped {
            break;
        }
    }
    out.i = passes;
    g.steps += passes * g.n + 1;
    out.s.clear();
    format(out.s, "completed sort loop passes ", passes);
    out
}
@end
