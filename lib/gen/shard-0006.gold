	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] > g.res[i] {
				increasing_pairs++;
			}
		}
	}
	out.i = increasing_pairs;
	out.s.clear();
	format(out.s, "increasing pairs tally: ", increasing_pairs);
	out
}
@end
