fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no input element for subfunction");
		out.ok = false;
		return out;
	}
	var cur = g.res[0];
	var count = 0;
	while !${p}(cur) {
		cur = ${f}(cur);
		count++;
		if count >= 100 {
			gold_fail(g, "subfunction loop limit reached");
			out.ok = false;
			return out;
		}
	}
	g.res[0] = cur;
	out.i = cur;
	g.steps += count;
	out.s.clear();
	format(out.s, "applied subfunction in ", count, " steps");
	out
}
