	}
	g.res[0] *= f;
	out.i = g.res[0];
	out.ok = true;
	out.s.clear();
	format(out.s, "first item scaled by factor");
	g.steps++;
	out
}
@end
@entry 85ad0338249a543f
kind: step
verb: run
noun: maximum
modifier: nested
context: loop
phrase: run maximum nested loop up to limit {limit}
phrase: process maximum nested iterations under {limit}
phrase: execute maximum nested cycles until {limit}
slot: limit int
test: list=5,12,8 limit=20
expect: => i=12 r=0.0 ok=true s="maximum nested within limit" errors=0 n=3 res=[5,12,8] cache=0 hits=0
test: list=5,25,8 limit=20
expect: => i=25 r=0.0 ok=false s="error: maximum exceeds limit" errors=1 n=3 res=[5,25,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty list for maximum");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var cur_max = g.res[0];
	for k in 1..g.n {
		if g.res[k] > cur_max { cur_max = g.res[k]; }
	}
	out.i = cur_max;
	out.s.clear();
	if cur_max <= lim {
		out.ok = true;
		format(out.s, "maximum nested within limit");
	} else {
		gold_fail(g, "maximum exceeds limit");
		out.ok = false;
		format(out.s, "error: maximum exceeds limit");
	}
	g.steps += g.n;
	out
}
@end
@entry c50def08e58294d0
kind: step
verb: collect
noun: minimum
modifier: between
context: loop
phrase: collect minimum in loop between range {low} to {high}
phrase: gather minimum value between bounds {low} to {high}
phrase: find minimum in loop between limits {low} to {high}
