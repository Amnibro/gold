code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 0, out.i);
	if g.n == 0 {
		gold_fail(g, "empty results for head comparison");
		out.ok = false;
		return out;
	}
	let head_val = g.res[0];
	if head_val > out.i {
		out.ok = true;
		out.s.clear();
		out.s.append("head exceeds cached baseline");
	} else {
		out.ok = false;
		out.s.clear();
		out.s.append("head below cached baseline");
	}
	out.i = head_val;
	g.steps++;
	out
}
@end
