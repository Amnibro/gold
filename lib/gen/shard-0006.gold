@entry ff04177b489b4dc5
kind: step
verb: swap
noun: runs
modifier: each
context: cache
phrase: swap each run of equal values
phrase: exchange equal value run endpoints
test: list=1,1,2,2,2
expect: => i=2 r=0.0 ok=true s="swapped runs count 2" errors=0 n=5 res=[1,1,2,2,2] cache=2 hits=0
test: list=3,4,4,5
expect: => i=1 r=0.0 ok=true s="swapped runs count 1" errors=0 n=4 res=[3,4,4,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var runs = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		let len = j - i;
		if len > 1 {
			let tmp = g.res[i];
			g.res[i] = g.res[j - 1];
			g.res[j - 1] = tmp;
			gold_cache_put(g, val, len);
			runs++;
		}
		i = j;
	}
	g.steps += g.n * 2;
	out.i = runs;
	out.s.clear();
	format(out.s, "swapped runs count ", runs);
	out
}
@end
