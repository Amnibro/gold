@entry df93d0e838fed18b
kind: step
verb: drop
noun: odds
modifier: pairwise
context: error
phrase: drop odd numbers in pairwise scan
phrase: remove consecutive odd error pairs
test: list=1,3,4,5,7
expect: => i=2 r=0.0 ok=true s="dropped 2 odd pair entries" errors=0 n=3 res=[1,4,5] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=true s="dropped 0 odd pair entries" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("no pairs to evaluate");
		return out;
	}
	var kept = 1;
	for k in 1..g.n {
		let prev_odd = g.res[k - 1] % 2 != 0;
		let curr_odd = g.res[k] % 2 != 0;
		if !(prev_odd && curr_odd) {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " odd pair entries");
	out
}
@end
@entry 49a75af391a0aae2
kind: step
verb: compare
noun: gaps
modifier: up_to
context: error
phrase: compare error gaps up to {max_gap}
phrase: check error spacing up to maximum gap {max_gap}
slot: max_gap int
test: list=2,5,8 max_gap=4
expect: => i=0 r=0.0 ok=true s="all gaps within limit" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=2,10 max_gap=5
expect: => i=0 r=0.0 ok=false s="gap 8 exceeds limit" errors=1 n=2 res=[2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_g = ${max_gap};
	if g.n < 2 {
		out.s.clear();
		out.s.append("insufficient elements for gap comparison");
		return out;
	}
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > max_g {
			gold_fail(g, "error gap exceeded threshold");
		out.ok = false;
			out.s.clear();
			format(out.s, "gap ", abs_diff, " exceeds limit");
			return out;
		}
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("all gaps within limit");
	out
}
@end
