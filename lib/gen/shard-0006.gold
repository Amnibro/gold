@entry 03618c824bdb27aa
kind: step
verb: dedupe
noun: steps
modifier: unique
context: format
phrase: dedupe steps unique values
phrase: retain unique elements in steps
test: list=1,2,1,3,2
expect: => i=3 r=0.0 ok=true s="unique values retained: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,5
expect: => i=2 r=0.0 ok=true s="unique values retained: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == x {
				seen = true;
			}
			j++;
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
		idx++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique values retained: ", kept);
	out
}
@end
