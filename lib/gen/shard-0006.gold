	while idx + 1 < g.n {
		if g.res[idx] > th && g.res[idx + 1] > th {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			swaps++;
		}
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " error pairs");
