	let mf = ${max_freq};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		let take = if freq < mf { freq } else { mf };
		for t in take {
			g.res[kept] = g.res[i];
			kept++;
		}
		gold_cache_put(g, g.res[i], take);
		i = j;
	}
	out.i = g.n - kept;
	g.n = kept;
	out.s.clear();
	out.s.append("histogram clamped");
	g.steps += g.n;
	out
}
