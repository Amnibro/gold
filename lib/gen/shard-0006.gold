code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let bound = if c < g.n { c } else { g.n };
	var i = 0;
	var j = bound - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = bound;
	out.ok = true;
	out.s.clear();
	format(out.s, "reversed sequence up to ", bound);
	g.steps += bound + 1;
	out
}
@end
