@entry 8779becb40c73f29
kind: step
verb: dedupe
noun: counter
modifier: while
context: loop
phrase: dedupe counter while condition {pred} holds
phrase: purge dedupe counter while {pred} succeeds
slot: pred pred
test: list=2,2,4,4,5 pred=is_even
expect: => i=3 r=0.0 ok=true s="deduped while matching" errors=0 n=3 res=[2,4,5] cache=0 hits=0
test: list=1,1,3,3 pred=is_odd
expect: => i=2 r=0.0 ok=true s="deduped while matching" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		if ${pred}(g.res[k]) {
			if kept == 0 || g.res[kept - 1] != g.res[k] {
				g.res[kept] = g.res[k];
				kept++;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped while matching");
	out
}
@end
@entry 5d5f71c08becae62
kind: step
verb: merge
noun: duplicates
modifier: every_other
context: search
phrase: merge alternate adjacent duplicate search results
phrase: combine every other repeated candidate pair
test: list=10,10,20,20,30,30
expect: => i=4 r=0.0 ok=true s="merged duplicate pairs into 4 items" errors=0 n=4 res=[20,20,20,60] cache=0 hits=0
test: list=5,5,15,15
expect: => i=3 r=0.0 ok=true s="merged duplicate pairs into 3 items" errors=0 n=3 res=[10,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	var merge_flag = true;
	while idx < g.n {
		if idx + 1 < g.n && g.res[idx] == g.res[idx + 1] {
			if merge_flag {
				g.res[write_pos] = g.res[idx] + g.res[idx + 1];
				write_pos++;
				idx += 2;
			} else {
				g.res[write_pos] = g.res[idx];
				write_pos++;
				g.res[write_pos] = g.res[idx + 1];
				write_pos++;
				idx += 2;
			}
			merge_flag = !merge_flag;
		} else {
			g.res[write_pos] = g.res[idx];
			write_pos++;
			idx++;
		}
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged duplicate pairs into ", write_pos, " items");
	out
}
@end
