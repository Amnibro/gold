		gold_fail(g, "empty records");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty records");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		count++;
		i--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "last streak traced");
	g.steps += count;
	out
}
@end
