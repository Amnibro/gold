@entry a4b1e217fbe0ab5b
kind: step
verb: run
noun: primes
modifier: running
context: error
phrase: run prime error filter over running list
phrase: keep running prime error codes
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="retained 4 prime errors" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=8,9,10
expect: => i=0 r=0.0 ok=false s="retained 0 prime errors" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { prime = false; break; }
				d++;
			}
			if prime {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	if kept == 0 {
		gold_fail(g, "no primes found in error list");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " prime errors");
	out
}
@end
@entry 64fe121a0d873ba6
kind: step
verb: run
noun: memo
modifier: with_retry
context: error
phrase: run memoized calculation with retry limit {retries}
phrase: execute memo lookup with retry attempts {retries}
slot: retries int
test: input=4 retries=3
expect: => i=12 r=0.0 ok=true s="computed after 3 retries" errors=0 n=0 res=[] cache=1 hits=0
test: input=7 retries=2
expect: => i=14 r=0.0 ok=true s="computed after 2 retries" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${retries};
	var res, ok = gold_cache_get(g, out.i);
	if ok {
		out.i = res;
		out.s.clear();
		out.s.append("cache hit");
		return out;
	}
	var attempt = 0;
	while attempt < limit {
		attempt++;
	}
	let computed = out.i * attempt;
	gold_cache_put(g, out.i, computed);
	out.i = computed;
	g.steps += attempt;
	out.s.clear();
	format(out.s, "computed after ", attempt, " retries");
	out
}
@end
