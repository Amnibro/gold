	let sz = ${size};
	var windows = 0;
	if sz > 0 && sz <= g.n {
		for i in (g.n - sz + 1) {
			var sum = 0;
			for j in sz { sum += g.res[i + j]; }
			gold_cache_put(g, i, sum);
			windows++;
		}
	}
	g.steps += g.n * sz + 1;
	out.i = windows;
	out.s.clear();
	format(out.s, "sliding windows count ", windows);
	out
}
@end
