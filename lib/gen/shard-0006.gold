expect: => i=15 r=0.0 ok=true s="reverse average 15" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${m};
	if count <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty average");
		return out;
	}
	var sum = 0;
	var k = 0;
	while k < count && k < g.n {
		sum += g.res[g.n - 1 - k];
		k++;
	}
	let avg = sum / k;
	g.steps += k;
	out.i = avg;
	out.s.clear();
	format(out.s, "reverse average ", avg);
	out
}
@end
