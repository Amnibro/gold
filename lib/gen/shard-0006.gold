fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if lim < 0 {
		gold_fail(g, "negative max results limit");
		out.ok = false;
		return out;
	}
	if g.n > lim {
		g.n = lim;
		out.s.clear();
		format(out.s, "truncated to ", lim, " results");
