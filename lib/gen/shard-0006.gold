fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var passed = 0;
	if g.n > 0 {
		let last = g.res[g.n - 1];
		if last >= lim {
			gold_cache_put(g, last, 1);
			passed = 1;
		} else {
			gold_cache_put(g, last, 0);
		}
	}
	g.steps += g.n + 1;
	out.i = passed;
	out.s.clear();
	format(out.s, "retry condition last result ", passed);
	out
}
@end
