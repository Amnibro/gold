code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = g.n;
	while i > 0 {
		i--;
		let c = g.res[i];
		var seen = false;
		for j in (i + 1)..g.n {
			if g.res[j] == c { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, c, count);
			count++;
		}
	}
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed unique letters ", count);
	out
}
@end
