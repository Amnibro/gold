fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		if spent + x <= b {
			spent += x;
			gold_cache_put(g, x, spent);
			cached++;
		}
	}
	g.steps += g.n + 1;
	out.i = spent;
	out.s.clear();
	format(out.s, "nested budget spent ", spent, " cached ", cached);
	out
}
@end
