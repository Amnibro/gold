code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var un = 0;
	for i in g.n {
		var seen = false;
		for j in un {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[un] = g.res[i];
			un++;
		}
	}
	g.n = un;
	out.i = un;
	out.s.clear();
	out.s.append("unique numbers collected");
	g.steps += g.n;
	out
}
@end
