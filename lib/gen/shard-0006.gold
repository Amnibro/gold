code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var attempts = 0;
	var gaps_closed = 0;
	while attempts < limit && attempts + 1 < g.n {
		let diff = g.res[attempts + 1] - g.res[attempts];
		if diff > 10 {
			g.res[attempts + 1] = g.res[attempts] + 10;
			gaps_closed++;
		}
		attempts++;
	}
	g.steps += attempts;
	out.i = gaps_closed;
	out.s.clear();
	format(out.s, "closed ", gaps_closed, " large gaps");
	out
}
@end
