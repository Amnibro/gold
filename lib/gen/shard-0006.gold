fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf = [0; 512];
	var w = 0;
	var pair_sum = 0;
	for i in g.n {
		buf[w] = g.res[i];
		w++;
		pair_sum += g.res[i];
		if i % 2 == 1 && w < 512 {
			buf[w] = pair_sum;
			w++;
			pair_sum = 0;
		}
	}
	for k in w { g.res[k] = buf[k]; }
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "checkpoints inserted: ", w);
	out
}
@end
