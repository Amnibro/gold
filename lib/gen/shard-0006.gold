slot: lo int
slot: hi int
test: list=5,18,12,25 lo=10 hi=20
expect: => i=18 r=0.0 ok=true s="maximum in bounds is 18" errors=0 n=4 res=[5,18,12,25] cache=0 hits=0
test: list=2,3 lo=10 hi=20
expect: => i=0 r=0.0 ok=false s="no items within bounds" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var max_found = -999999;
	var found = false;
	for k in g.n {
		if g.res[k] >= low && g.res[k] <= high {
			if !found || g.res[k] > max_found {
				max_found = g.res[k];
				found = true;
			}
		}
	}
	out.ok = found;
	if found {
		out.i = max_found;
		out.s.clear();
		format(out.s, "maximum in bounds is ", max_found);
	} else {
		out.i = 0;
		out.s.clear();
		out.s.append("no items within bounds");
	}
	g.steps += g.n;
	out
}
@end
