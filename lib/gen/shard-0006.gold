kind: step
verb: sum
noun: budget
modifier: sorted
context: loop
phrase: sum sorted items while staying within budget {budget}
phrase: accumulate smallest elements under budget limit {budget}
slot: budget int
test: list=8,2,4,1 budget=10
expect: => i=7 r=0.0 ok=true s="budget sum is 7 across 3 items" errors=0 n=4 res=[1,2,4,8] cache=0 hits=0
