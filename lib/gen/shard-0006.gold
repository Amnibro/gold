@entry f92555330929a458
kind: step
verb: merge
noun: squares
modifier: sorted
context: search
phrase: merge candidate pairs verifying sorted results
phrase: combine neighbouring search items into sorted sums
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="merged into 3 sorted items" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,1,2,3
expect: => i=2 r=0.0 ok=false s="merged into 2 sorted items" errors=1 n=2 res=[11,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		g.res[write_pos] = g.res[idx] + g.res[idx + 1];
		write_pos++;
		idx += 2;
	}
	if idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
	}
	g.n = write_pos;
	var is_sort = true;
	for k in 1..g.n {
		if g.res[k] < g.res[k - 1] { is_sort = false; break; }
	}
	if !is_sort {
		gold_fail(g, "merged results not in sorted order");
		out.ok = false;
	}
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged into ", write_pos, " sorted items");
	out
}
@end
