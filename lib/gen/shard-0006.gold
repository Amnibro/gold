noun: runs
modifier: up_to
context: aggregate
phrase: check consecutive runs up to length {max_len}
phrase: verify run lengths up to bound {max_len}
phrase: inspect sequence runs up to limit {max_len}
slot: max_len int
test: list=1,1,2,2,2,3 max_len=3
expect: => i=3 r=0.0 ok=true s="run lengths within bound" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
