@entry 7e6924dfe9dd5921
kind: step
verb: select
noun: duplicates
modifier: none
context: format
phrase: select distinct elements removing all format duplicates
phrase: filter duplicates leaving none in format
phrase: eliminate duplicate entries from format sequence
test: list=1,2,2,3,1,4
expect: => i=2 r=0.0 ok=true s="removed 2 duplicates leaving none" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="removed 0 duplicates leaving none" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	out.i = removed;
	out.ok = true;
	out.s.clear();
	format(out.s, "removed ", removed, " duplicates leaving none");
	g.steps += g.n * g.n;
	out
}
@end
