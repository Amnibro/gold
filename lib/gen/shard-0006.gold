noun: errors
modifier: pairwise
context: loop
phrase: limit pairwise step differences between errors {max_diff}
phrase: restrict adjacent error fluctuations to limit {max_diff}
slot: max_diff int
test: list=10,25,12 max_diff=5
expect: => i=1 r=0.0 ok=true s="clamped 1 pairwise differences" errors=0 n=3 res=[10,15,12] cache=0 hits=0
test: list=5,8,10 max_diff=10
expect: => i=0 r=0.0 ok=true s="clamped 0 pairwise differences" errors=0 n=3 res=[5,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var adjusted = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > md {
			g.res[k] = g.res[k - 1] + md;
			adjusted++;
		} else if diff < -md {
			g.res[k] = g.res[k - 1] - md;
			adjusted++;
		}
	}
	out.i = adjusted;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "clamped ", adjusted, " pairwise differences");
	out
}
@end
