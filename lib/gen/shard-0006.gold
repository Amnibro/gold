@entry 5af1a52de3720422
kind: step
verb: swap
noun: window
modifier: each
context: aggregate
phrase: swap window elements across each span {size}
phrase: invert window bounds for each group {size}
phrase: reverse each window group of size {size}
slot: size int
test: list=1,2,3,4,5,6 size=3
expect: => i=2 r=0.0 ok=true s="swapped window endpoints" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=2 r=0.0 ok=true s="swapped window endpoints" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 1 || sz > g.n {
		out.ok = false;
		return out;
	}
	var i = 0;
	var count = 0;
	while i + sz <= g.n {
		let t = g.res[i];
		g.res[i] = g.res[i + sz - 1];
		g.res[i + sz - 1] = t;
		count++;
		i += sz;
	}
	out.i = count;
	out.ok = true;
	out.s.clear();
	out.s.append("swapped window endpoints");
	g.steps += count;
	out
}
@end
