code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var total = 0;
    var prev = 0;
    var has_prev = false;
    for i in g.n {
        let cur = g.res[i];
        if !has_prev || cur != prev {
            total += cur;
            prev = cur;
            has_prev = true;
        }
    }
    gold_cache_put(g, 0, total);
    out.i = total;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "sum unique memo items ", total);
    out
}
@end
