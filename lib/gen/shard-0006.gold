		out.i = 1;
		out.ok = true;
		out.s.clear();
		format(out.s, "dropped adjacent identical pairs");
	} else {
		gold_fail(g, "no pairs dropped");
		out.i = 0;
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no pairs dropped");
	}
	g.steps += g.n;
	out
}
