fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in kept {
			if g.res[j] == x { dup = true; break; }
		}
		if !dup {
			g.res[kept] = x;
			gold_cache_put(g, kept, x);
			kept++;
		}
	}
	out.i = g.n - kept;
	g.n = kept;
	out.s.clear();
	out.s.append("duplicates removed in middle");
	g.steps += g.n;
	out
}
@end
