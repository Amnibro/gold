expect: => i=4 r=0.0 ok=true s="paired 4 duplicate elements" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_cnt};
	var dup_pairs = 0;
	var idx = 0;
	while idx + 1 < g.n {
		if g.res[idx] == g.res[idx + 1] {
			dup_pairs += 2;
		}
		idx += 2;
	}
	if dup_pairs < mc {
		gold_fail(g, "not enough duplicate elements");
		out.ok = false;
	}
	out.i = dup_pairs;
	out.s.clear();
	format(out.s, "paired ", dup_pairs, " duplicate elements");
	out
}
@end
