	let max_r = ${retries};
	var odd_count = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 { odd_count++; }
	}
	if odd_count == 0 {
		gold_fail(g, "no odd elements found during retry");
		out.ok = false;
		out.s.clear();
		out.s.append("retry failed zero odds");
	} else {
		out.s.clear();
		format(out.s, "processed ", odd_count, " odds within limit");
	}
	out.i = odd_count;
	g.steps += max_r;
	out
}
