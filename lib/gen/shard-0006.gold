test: list=10,20,30,40,50 step_size=2
expect: => i=3 r=0.0 ok=true s="grouped loop steps into cache" errors=0 n=5 res=[10,20,30,40,50] cache=1 hits=0
test: list=10,20 step_size=0
expect: => i=0 r=0.0 ok=false s="error: invalid group step parameters" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	if sz <= 0 || g.n == 0 {
		gold_fail(g, "invalid step size or empty list");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid group step parameters");
		return out;
	}
	let groups = (g.n + sz - 1) / sz;
	gold_cache_put(g, sz, groups);
	out.i = groups;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped loop steps into cache");
	g.steps += groups;
	out
}
@end
@entry 48196541eca16579
kind: step
verb: group
noun: digits
modifier: until
context: loop
phrase: group loop digits until reaching stop value {stop_digit}
phrase: collect digits in loop until finding {stop_digit}
phrase: sum digits through loop until stop {stop_digit}
slot: stop_digit int
test: list=3,4,5,9,2 stop_digit=9
expect: => i=12 r=0.0 ok=true s="grouped digits until stop" errors=0 n=5 res=[3,4,5,9,2] cache=0 hits=0
test: list=1,2,3 stop_digit=9
expect: => i=0 r=0.0 ok=false s="error: stop digit not found" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_digit};
	var sum = 0;
	var found = false;
	var count = 0;
	for k in g.n {
		if g.res[k] == stop {
			found = true;
			break;
		}
		sum += g.res[k];
		count++;
	}
	out.s.clear();
	if found {
		out.i = sum;
		out.ok = true;
		format(out.s, "grouped digits until stop");
	} else {
		gold_fail(g, "stop digit never encountered");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: stop digit not found");
	}
	g.steps += count;
	out
}
@end
