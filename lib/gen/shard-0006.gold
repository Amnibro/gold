fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		while x > 0 {
			total += x % 10;
			x /= 10;
		}
	}
	out.i = total;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "total sorted digits sum is ", total);
	out
}
