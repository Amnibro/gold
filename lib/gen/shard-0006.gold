fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let fac = ${factor};
	if fac <= 0 {
		gold_fail(g, "unsafe factor for threshold scaling");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid scale factor");
		return out;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] > th {
			g.res[k] *= fac;
			count++;
		}
	}
	out.ok = true;
	out.i = count;
	out.s.clear();
	out.s.append("scaled threshold items safely");
	g.steps += g.n;
	out
}
@end
