expect: => i=5 r=0.0 ok=true s="olleh" errors=0 n=0 res=[] cache=0 hits=0
test: text="search"
expect: => i=6 r=0.0 ok=true s="hcraes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = out.s.len - 1;
	while left < right {
		let b = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = b;
		left++;
		right--;
	}
	out.i = out.s.len;
	out
}
@end
