code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen_a = false;
	var seen_e = false;
	var seen_i = false;
	var seen_o = false;
	var seen_u = false;
	for c in out.s {
		if c == 'a' || c == 'A' { seen_a = true; }
		else if c == 'e' || c == 'E' { seen_e = true; }
		else if c == 'i' || c == 'I' { seen_i = true; }
		else if c == 'o' || c == 'O' { seen_o = true; }
		else if c == 'u' || c == 'U' { seen_u = true; }
	}
	var count = 0;
	if seen_a { count++; }
	if seen_e { count++; }
	if seen_i { count++; }
	if seen_o { count++; }
	if seen_u { count++; }
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "unique vowels ", count);
	out
}
@end
