code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var swaps = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let a = g.res[idx];
		let b = g.res[idx + 1];
		if a >= lo && a <= hi && b >= lo && b <= hi {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			swaps++;
		}
		idx += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " candidates in range");
	out
}
@end
