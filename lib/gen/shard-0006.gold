code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[100] = [0; 100];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var exists = false;
			for j in count {
				if evens[j] == x { exists = true; break; }
			}
			if !exists && count < 100 {
				evens[count] = x;
				count++;
			}
		}
	}
	for i in count {
		for j in i + 1..count {
			if evens[i] > evens[j] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for i in count {
		gold_push(g, evens[i]);
	}
	out.i = count;
	out.s.clear();
	format(out.s, "unique evens: ", count);
	g.steps += count;
	out
}
@end
