fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var squares = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { squares++; }
		}
	}
	out.i = squares;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "found ", squares, " square values");
	out
}
