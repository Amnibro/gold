fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens byte[..100] = "";
	var i = 0;
	while i < out.s.len {
		evens.push(out.s[i]);
		i += 2;
	}
	var rev_idx = evens.len - 1;
	var j = 0;
	while j < out.s.len {
		out.s[j] = evens[rev_idx];
		rev_idx--;
		j += 2;
	}
	g.steps += out.s.len;
	out.i = evens.len;
	out
}
@end
