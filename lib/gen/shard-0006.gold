@entry 6718d4c2b8add81e
kind: step
verb: count
noun: average
modifier: between
context: error
phrase: count average occurrences between bounds {low} {high}
phrase: tally elements exceeding average between bounds {low} {high}
slot: low int
slot: high int
test: list=10,20,30 low=15 high=35
expect: => i=2 r=0.0 ok=true s="average in bounds count 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=-10,20,30 low=5 high=35
expect: => i=2 r=0.0 ok=true s="average in bounds count 2" errors=1 n=3 res=[-10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	var neg = 0;
	for i in g.n {
		if g.res[i] < 0 { neg++; }
		sum += g.res[i];
	}
	if neg > 0 {
		gold_fail(g, "negative item encountered");
	}
	let avg = sum / g.n;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= avg && x >= lo && x <= hi { count++; }
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "average in bounds count ", count);
	out
}
@end
