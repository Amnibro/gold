@entry dd7f568c2621abf0
kind: step
verb: dedupe
noun: primes
modifier: with_cache
context: stats
phrase: dedupe primes with cache isolate unique odd measurements
phrase: filter distinct odd numbers recording cache entry
test: list=3,5,3,7,5
expect: => i=3 r=0.0 ok=true s="unique odds: 3" errors=0 n=3 res=[3,5,7] cache=1 hits=0
test: list=9,9,11
expect: => i=2 r=0.0 ok=true s="unique odds: 2" errors=0 n=2 res=[9,11] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[100] = [0; 100];
	var olen = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			for j in olen {
				if odds[j] == x { seen = true; break; }
			}
			if !seen && olen < 100 {
				odds[olen] = x;
				olen++;
			}
		}
	}
	gold_clear(g);
	for i in olen { gold_push(g, odds[i]); }
	gold_cache_put(g, g.n, olen);
	out.i = olen;
	out.s.clear();
	format(out.s, "unique odds: ", olen);
	g.steps += g.n;
	out
}
@end
@entry 13a28aba861d3c8c
kind: step
verb: sort
noun: numbers
modifier: until
context: stats
phrase: sort numbers until arrange dataset ascending using insertion
phrase: order observation values from lowest to highest
test: list=4,2,8,1
expect: => i=4 r=0.0 ok=true s="insertion sorted: 4" errors=0 n=4 res=[1,2,4,8] cache=0 hits=0
test: list=10,5,20
expect: => i=3 r=0.0 ok=true s="insertion sorted: 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 1;
	while idx < g.n {
		let key = g.res[idx];
		var j = idx;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
		idx++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "insertion sorted: ", g.n);
	g.steps += g.n;
	out
}
@end
