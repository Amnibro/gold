@entry ac3fa4a02f5b3b93
kind: step
verb: swap
noun: squares
modifier: up_to
context: format
phrase: swap square values up to bound {limit}
phrase: exchange perfect squares up to limit {limit}
phrase: swap squared items under limit {limit}
slot: limit int
test: list=3,9,5,16 limit=20
expect: => i=1 r=0.0 ok=true s="swapped square values" errors=0 n=4 res=[3,16,5,9] cache=0 hits=0
test: list=2,3,5,7 limit=20
expect: => i=0 r=0.0 ok=false s="fewer than two squares to swap" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var first_sq = -1;
	var second_sq = -1;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 && x <= lim {
			var is_sq = false;
			var s = 0;
			while s * s <= x {
				if s * s == x { is_sq = true; break; }
				s++;
		}
		if is_sq {
			if first_sq < 0 { first_sq = k; }
			else if second_sq < 0 { second_sq = k; break; }
		}
	}
	}
	if first_sq >= 0 && second_sq >= 0 {
		let t = g.res[first_sq];
		g.res[first_sq] = g.res[second_sq];
		g.res[second_sq] = t;
		out.ok = true;
		out.i = 1;
		out.s.clear();
		out.s.append("swapped square values");
	} else {
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("fewer than two squares to swap");
	}
	g.steps += g.n;
	out
}
@end
