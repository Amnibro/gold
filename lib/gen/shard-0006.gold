code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var uniq = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] { first = false; }
		}
		if first {
			sum += g.res[i];
			uniq++;
		}
	}
	let avg = if uniq > 0 { sum / uniq } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "unique average ", avg);
	out
}
@end
