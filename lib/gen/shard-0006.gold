code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var found = false;
	var min_val = lim;
	for i in g.n {
		let x = g.res[i];
		if x <= lim {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no minimum found up to limit");
		out.ok = false;
		return out;
	}
	gold_push(g, min_val);
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "found minimum up to limit");
	out
}
@end
