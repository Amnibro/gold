fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 { out.i = 0; return out; }
	var max_run = 1;
	var cur_run = 1;
	for i in 1..out.s.len {
		if out.s[i] == out.s[i - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
	}
	gold_cache_put(g, out.s.len, max_run);
	out.i = max_run;
	g.steps += out.s.len;
	out
}
@end
