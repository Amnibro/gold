@entry 7821c92015e18954
kind: step
verb: compare
noun: primes
modifier: recursively
context: error
phrase: compare primes recursively in sequence
phrase: verify prime numbers recursively across results
phrase: check adjacent primes recursively for validity
test: list=2,3,5,7
expect: => i=4 r=0.0 ok=true s="primes validated recursively" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=2,4,5
expect: => i=1 r=0.0 ok=false s="error: non prime element" errors=1 n=3 res=[2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for prime compare");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if !is_p {
			gold_fail(g, "non prime element found");
			out.ok = false;
			out.i = k;
			out.s.clear();
			format(out.s, "error: non prime element");
			return out;
		}
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "primes validated recursively");
	g.steps += g.n;
	out
}
@end
