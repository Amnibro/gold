test: text="server error" safe_limit=5
expect: => i=2 r=0.0 ok=true s="server error" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${safe_limit};
	if lim <= 0 {
		gold_fail(g, "invalid word limit");
		out.ok = false;
		return out;
	}
	var spaces = 0;
	var cut = out.s.len;
	for c, idx in out.s {
		if c == ' ' {
			spaces++;
			if spaces == lim {
				cut = idx;
				break;
			}
		}
	}
	out.s.resize(cut, 0 as byte);
	out.i = spaces + 1;
	out
}
@end
@entry 2709d8c4cec2c6b4
kind: step
verb: shift
noun: maximum
modifier: until
context: error
phrase: shift maximum error value until at head
phrase: rotate error list until maximum is first
test: list=1,5,3,2
expect: => i=1 r=0.0 ok=true s="shifted maximum in 1 steps" errors=0 n=4 res=[5,3,2,1] cache=0 hits=0
test: list=10,2,3
expect: => i=0 r=0.0 ok=true s="shifted maximum in 0 steps" errors=0 n=3 res=[10,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for maximum shift");
		out.ok = false;
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var shifts = 0;
	while max_idx > 0 {
		let first = g.res[0];
		for k in g.n - 1 { g.res[k] = g.res[k + 1]; }
		g.res[g.n - 1] = first;
		max_idx--;
		shifts++;
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted maximum in ", shifts, " steps");
	out
}
@end
@entry f3ff6313357d3659
kind: step
verb: limit
noun: digits
modifier: first
context: error
phrase: limit error numbers to first {d} digits
phrase: truncate error codes to first {d} digits
slot: d int
test: list=1234,5678 d=2
expect: => i=0 r=0.0 ok=true s="limited leading digits" errors=0 n=2 res=[12,56] cache=0 hits=0
test: list=98765,43210 d=3
expect: => i=0 r=0.0 ok=true s="limited leading digits" errors=0 n=2 res=[987,432] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${d};
	if limit <= 0 {
		gold_fail(g, "invalid digit limit");
		out.ok = false;
		return out;
	}
	for k in g.n {
		var x = g.res[k];
		var neg = false;
		if x < 0 { neg = true; x = -x; }
		var div = 1;
		while x / div >= 10 { div *= 10; }
		var res = 0;
		var cnt = 0;
		while div > 0 && cnt < limit {
			res = res * 10 + (x / div) % 10;
			div /= 10;
			cnt++;
		}
		if neg { res = -res; }
		g.res[k] = res;
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("limited leading digits");
	out
}
@end
