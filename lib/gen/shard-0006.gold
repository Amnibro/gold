code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let diff = g.res[idx + 1] - g.res[idx];
		g.res[write_pos] = if diff < 0 { -diff } else { diff };
		write_pos++;
		idx += 2;
	}
	if idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "computed ", write_pos, " pairwise gap values");
	out
}
@end
