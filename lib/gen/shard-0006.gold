fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	while out.s.len > 0 && out.s[0] == ' ' && shifts < out.s.len {
		let c = out.s[0];
		for i in out.s.len - 1 {
			out.s[i] = out.s[i + 1];
		}
		out.s[out.s.len - 1] = c;
		shifts++;
	}
	out.i = shifts;
	g.steps += shifts + 1;
	out
}
