fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var total = 0;
	for k in g.n { total += g.res[k]; }
	let avg = total / g.n;
	out.i = avg;
	let th = ${threshold};
	out.ok = avg >= th;
	out.s.clear();
	out.s.append("average calculated");
	g.steps += g.n;
	out
}
@end
