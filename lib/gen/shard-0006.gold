fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < out.s.len {
		let key = out.s[i];
		var j = i;
		while j > 0 && out.s[j - 1] > key {
			out.s[j] = out.s[j - 1];
			j--;
		}
		out.s[j] = key;
		i++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
