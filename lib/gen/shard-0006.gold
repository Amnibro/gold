@entry d094ae4be1da97af
kind: step
verb: split
noun: primes
modifier: all
context: core
phrase: split primes all from composite numbers
phrase: divide primes all from other elements
test: list=2,4,5,6,7,9
expect: => i=3 r=0.0 ok=true s="split 3 primes" errors=0 n=6 res=[2,5,7,4,6,9] cache=0 hits=0
test: list=1,8,10
expect: => i=0 r=0.0 ok=true s="split 0 primes" errors=0 n=3 res=[1,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[256] = [0; 256];
	var non_primes int[256] = [0; 256];
	var np = 0;
	var nn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[np] = x;
			np++;
		} else {
			non_primes[nn] = x;
			nn++;
		}
	}
	for i in np { g.res[i] = primes[i]; }
	for i in nn { g.res[np + i] = non_primes[i]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "split ", np, " primes");
	out
}
@end
