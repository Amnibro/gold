@entry c2beadf29dec62f3
kind: step
verb: apply
noun: streak
modifier: at_most
context: text
phrase: apply streak limit of at most {k} repeats
phrase: cap consecutive duplicate streak at most {k}
slot: k int
test: text="aaabbbccc" k=1
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
test: text="hellooo" k=2
expect: => i=6 r=0.0 ok=true s="helloo" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if limit <= 0 {
		gold_fail(g, "invalid streak limit");
		out.ok = false;
		return out;
	}
	var res byte[..200] = "";
	var streak = 0;
	var last_c byte = 0 as byte;
	for i in out.s.len {
		let c = out.s[i];
		if i == 0 || c != last_c {
			last_c = c;
			streak = 1;
			res.push(c);
		} else {
			if streak < limit {
				streak++;
				res.push(c);
			}
