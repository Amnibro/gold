@entry f2646a9c695ba4f1
kind: step
verb: scan
noun: primes
modifier: times
context: core
phrase: scan primes count times limit {lim}
phrase: check prime items count times limit {lim}
slot: lim int
test: list=2,3,4,5,6,7 lim=2
expect: => i=2 r=0.0 ok=true s="found 2 primes up to limit" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=11,13,17 lim=5
expect: => i=3 r=0.0 ok=true s="found 3 primes up to limit" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			prime_count++;
			if prime_count >= limit { break; }
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "found ", prime_count, " primes up to limit");
	out
}
@end
