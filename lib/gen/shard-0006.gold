fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "list too short for pairs");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
