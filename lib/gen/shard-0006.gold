@entry 26ad12603f5f0d50
kind: step
verb: reverse
noun: values
modifier: every_other
context: error
phrase: reverse every other value checking bounds {bound}
phrase: invert alternating error values exceeding bound {bound}
slot: bound int
test: list=1,2,3,4,5 bound=10
expect: => i=3 r=0.0 ok=true s="reversed every other count 3" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=15,2,25,4 bound=10
expect: => i=2 r=0.0 ok=true s="reversed every other count 2" errors=2 n=4 res=[25,2,15,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var idx int[64];
	var count = 0;
	for i in g.n {
		if i % 2 == 0 && count < 64 {
			if g.res[i] > b {
				gold_fail(g, "value exceeds bound");
			}
			idx[count] = i;
			count++;
		}
	}
	for k in (count / 2) {
		let i1 = idx[k];
		let i2 = idx[count - 1 - k];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed every other count ", count);
	out
}
@end
