phrase: multiply alternating runs factor {mult}
slot: mult int
test: list=1,1,2,2,3,3 mult=2
expect: => i=2 r=0.0 ok=true s="scaled every other run 2" errors=0 n=6 res=[2,2,2,2,6,6] cache=2 hits=0
