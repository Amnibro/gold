expect: => i=0 r=0.0 ok=true s="budget sum is 0 across 0 items" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total = 0;
	var count = 0;
	for k in g.n {
		if total + g.res[k] <= b {
			total += g.res[k];
			count++;
		} else {
			break;
		}
	}
	out.i = total;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "budget sum is ", total, " across ", count, " items");
	out
}
@end
