code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_even = -1;
	var last_even_idx = -1;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			if first_even < 0 {
				first_even = g.res[k];
			} else {
				g.res[last_even_idx] = g.res[k];
			}
			last_even_idx = k;
		}
	}
	if first_even >= 0 && last_even_idx >= 0 {
		g.res[last_even_idx] = first_even;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated evens");
	out
}
@end
