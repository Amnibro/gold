expect: => i=3 r=0.0 ok=true s="head sorted unique" errors=0 n=4 res=[1,2,5,1] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var head_len = if g.n < 4 { g.n } else { 4 };
	var kept = 0;
	for i in head_len {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	for a in kept {
		for b in a + 1..kept {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
		}
	}
	for k in kept { gold_cache_put(g, k, g.res[k]); }
	out.i = kept;
	out.s.clear();
	out.s.append("head sorted unique");
	g.steps += head_len;
	out
}
@end
