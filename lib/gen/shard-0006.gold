	if out.s.len <= 1 { return out; }
	var w = 1;
	for i in 1..out.s.len {
		if out.s[i] != out.s[w - 1] {
			out.s[w] = out.s[i];
			w++;
		}
	}
	out.s.resize(w, 0 as! byte);
	out.i = w;
	g.steps += out.s.len;
	out
}
