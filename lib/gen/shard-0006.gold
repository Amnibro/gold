code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 2;
	if count > g.n {
		count = g.n;
	}
	var idx = 0;
	let offset = g.n - count;
	while idx < count {
		g.res[idx] = g.res[offset + idx];
		idx++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "trailing group size: ", count);
	out
}
@end
