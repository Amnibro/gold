fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_pal = true;
	var i = 0;
	var j = out.s.len - 1;
	while i < j {
		if out.s[i] != out.s[j] { is_pal = false; break; }
		i++;
		j--;
	}
	out.ok = is_pal;
	if !is_pal { gold_fail(g, "not a palindrome"); }
	g.steps += out.s.len;
	out
}
@end
