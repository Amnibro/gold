code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty error text");
		out.ok = false;
		return out;
	}
	var uniq = 0;
	for c, idx in out.s {
		var seen = false;
		for j in idx {
			if out.s[j] == c { seen = true; break; }
		}
		if !seen { uniq++; }
	}
	out.i = uniq;
	g.steps++;
	out
}
@end
