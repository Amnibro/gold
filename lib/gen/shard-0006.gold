code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty history");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty history");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "nested history deduped");
	g.steps += g.n;
	out
}
@end
