test: list=10,20
expect: => i=4 r=0.0 ok=true s="extended run total: 4" errors=0 n=4 res=[10,20,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var target = if g.n * 2 <= 512 { g.n * 2 } else { 512 };
	var orig_n = g.n;
	var i = 0;
	while g.n < target && g.n < 512 {
		g.res[g.n] = g.res[i % orig_n];
		g.n++;
		i++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "extended run total: ", g.n);
	out
}
@end
