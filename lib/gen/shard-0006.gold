test: list=5,15,25 bound=10
expect: => i=0 r=0.0 ok=true s="filtered cache recursively" errors=0 n=3 res=[5,15,25] cache=1 hits=0
test: list=2,8,20 bound=15
expect: => i=0 r=0.0 ok=true s="filtered cache recursively" errors=0 n=3 res=[2,8,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	var purged = 0;
	var new_cn = 0;
	for i in g.cn {
		if g.cv[i] >= limit {
			g.ck[new_cn] = g.ck[i];
			g.cv[new_cn] = g.cv[i];
			new_cn++;
		} else {
			purged++;
		}
	}
	g.cn = new_cn;
	for i in g.n {
		if g.res[i] < limit {
			gold_cache_put(g, g.res[i], limit);
		}
	}
	g.steps += g.cn + g.n;
	out.i = purged;
	out.s.clear();
	format(out.s, "filtered cache recursively");
	out
}
@end
@entry 6e5128bd78bc2bd1
kind: step
verb: rotate
noun: letters
modifier: safely
context: retry
phrase: rotate letter codes safely by offset {shift}
phrase: shift retry letter codes within bounds by {shift}
slot: shift int
test: list=65,66,67 shift=2
expect: => i=3 r=0.0 ok=true s="rotated letters safely" errors=0 n=3 res=[67,68,69] cache=0 hits=0
test: list=97,98,99 shift=3
expect: => i=3 r=0.0 ok=true s="rotated letters safely" errors=0 n=3 res=[100,101,102] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in g.n {
		let code = g.res[i];
		if code >= 65 && code <= 90 {
			let shifted = 65 + ((code - 65 + s) % 26);
			g.res[i] = if shifted < 65 { shifted + 26 } else { shifted };
		} else if code >= 97 && code <= 122 {
			let shifted = 97 + ((code - 97 + s) % 26);
			g.res[i] = if shifted < 97 { shifted + 26 } else { shifted };
		} else {
			g.res[i] = code + s;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated letters safely");
	out
}
@end
