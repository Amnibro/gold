test: list=5,12,30,32
expect: => i=3 r=0.0 ok=true s="sorted steps grouped" errors=0 n=3 res=[2,7,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n--;
		for i in g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	out.s.append("sorted steps grouped");
	g.steps += g.n;
	out
}
@end
