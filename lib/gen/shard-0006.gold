fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var processed = 0;
	for k in g.n {
		if rem >= g.res[k] {
			rem -= g.res[k];
			processed++;
		} else {
			break;
		}
	}
	out.i = rem;
	g.steps += processed;
	out.s.clear();
	format(out.s, "remaining budget is ", rem, " after ", processed, " items");
	out
}
@end
