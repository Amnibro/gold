fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var violations = 0;
	for i in 1..g.n {
		let sum = g.res[i - 1] + g.res[i];
		if sum > c {
			gold_fail(g, "pair sum over ceiling");
			violations++;
			g.res[i] = c - g.res[i - 1];
		}
	}
	g.steps += g.n + 1;
	out.i = violations;
	out.s.clear();
	format(out.s, "pair sum violations ", violations);
	out
}
