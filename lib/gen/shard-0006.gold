fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = if ${count} > g.n { g.n } else { ${count} };
	var invalid_spaces = 0;
	for i in (g.n - cnt)..g.n {
		if g.res[i] <= 0 {
			gold_fail(g, "trailing space invalid");
			g.res[i] = 1;
			invalid_spaces++;
		}
	}
	g.steps += cnt + 1;
	out.i = invalid_spaces;
	out.s.clear();
	format(out.s, "merged trailing spaces ", invalid_spaces);
	out
}
@end
