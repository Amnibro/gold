code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_vals int[512] = [0; 512];
	var even_idxs int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			even_vals[count] = g.res[i];
			even_idxs[count] = i;
			count++;
		}
	}
	for k in count {
		let target_idx = even_idxs[k];
		let val_idx = count - 1 - k;
		g.res[target_idx] = even_vals[val_idx];
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " even items");
	out
}
@end
