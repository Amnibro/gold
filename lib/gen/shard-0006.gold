fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var pairs = 0;
	var w = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[w] = if a < b { a } else { b };
		w++;
		pairs++;
		i += 2;
	}
	g.n = w;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " minimum values");
	out
}
