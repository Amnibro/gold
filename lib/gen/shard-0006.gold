fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	let cap = if g.n < k { g.n } else { k };
	var is_uniq = true;
	for i in cap {
		for j in (i + 1)..cap {
			if g.res[i] == g.res[j] {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq { break; }
	}
	g.steps += cap;
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	out.s.clear();
	if is_uniq {
		format(out.s, "head prefix of ", cap, " items is unique");
