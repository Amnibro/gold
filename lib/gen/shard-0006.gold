code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vpos int[100] = [0; 100];
	var vchars byte[100] = [0; 100];
	var vlen = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vpos[vlen] = i;
			vchars[vlen] = c;
			vlen++;
		}
	}
	for i in vlen {
		for j in i + 1..vlen {
			if vchars[i] > vchars[j] {
				let t = vchars[i];
				vchars[i] = vchars[j];
				vchars[j] = t;
			}
		}
	}
	for i in vlen {
		out.s[vpos[i]] = vchars[i];
	}
	gold_cache_put(g, out.s.len, vlen);
	out.i = vlen;
	g.steps += vlen + 1;
	out
}
@end
