			dropped++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	if dropped > 0 {
		out.ok = true;
		format(out.s, "dropped matching loop items");
	} else {
		gold_fail(g, "no matching items to drop");
		out.ok = false;
		format(out.s, "error: no matching items to drop");
	}
	g.steps += g.n;
	out
}
