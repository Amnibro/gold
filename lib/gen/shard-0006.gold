fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	let start = if g.n > 2 { g.n - 2 } else { 0 };
	for i in start .. g.n {
		sum += g.res[i];
		count++;
	}
	let avg = if count > 0 { sum / count } else { 0 };
