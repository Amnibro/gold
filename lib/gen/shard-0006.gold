@entry d0630ffd0da0c581
kind: step
verb: reverse
noun: squares
modifier: at_most
context: loop
phrase: reverse square numbers at most {cap} positions
phrase: invert perfect squares in list bounded by {cap}
slot: cap int
test: list=4,2,9,16 cap=3
expect: => i=3 r=0.0 ok=true s="reversed 3 square elements" errors=0 n=4 res=[16,2,9,4] cache=0 hits=0
test: list=1,4,9 cap=2
expect: => i=2 r=0.0 ok=true s="reversed 2 square elements" errors=0 n=3 res=[4,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_rev = ${cap};
	var sq_indices int[512] = [0; 512];
	var sq_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				sq_indices[sq_count] = i;
				sq_count++;
			}
		}
	}
	let rev_count = if sq_count < max_rev { sq_count } else { max_rev };
	var left = 0;
	var right = rev_count - 1;
	while left < right {
		let idx1 = sq_indices[left];
		let idx2 = sq_indices[right];
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + rev_count;
	out.i = rev_count;
	out.s.clear();
	format(out.s, "reversed ", rev_count, " square elements");
	out
}
@end
