fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var swaps = 0;
	for k in 1..g.n {
		if swaps >= c { break; }
		if g.res[k] == g.res[k - 1] {
			g.res[k] += 100;
			swaps++;
		}
	}
	out.i = swaps;
	gold_text(out, "swapped duplicates at most");
	g.steps += swaps;
	out
}
@end
