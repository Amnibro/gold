code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${count};
	if reps <= 0 || reps > 5 {
		gold_fail(g, "invalid letter repetition count");
		out.ok = false;
		return out;
	}
	var pat byte[..32] = "";
	for c in out.s {
		if pat.len < 32 { pat.push(c); }
	}
	out.s.clear();
	for r in reps {
		for c in pat {
			if out.s.len < 180 { out.s.push(c); }
		}
	}
	out.i = out.s.len;
	g.steps++;
	out
}
@end
