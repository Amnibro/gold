slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="rotated last history items" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30,40 count=1
expect: => i=1 r=0.0 ok=true s="rotated last history items" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n < 2 || k <= 0 {
		out.i = 0;
		return out;
	}
	let shift = k % g.n;
	var temp int[512] = [0; 512];
	for i in g.n {
		let src_idx = (g.n - shift + i) % g.n;
		temp[i] = g.res[src_idx];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated last history items");
	out
}
@end
