@entry 9728612f8ee96378
kind: step
verb: dedupe
noun: primes
modifier: with_cache
context: error
phrase: dedupe prime errors using cache
phrase: eliminate duplicate prime errors with cache memo
test: list=2,3,2,5,3
expect: => i=2 r=0.0 ok=true s="primes deduped with cache" errors=0 n=3 res=[2,3,5] cache=1 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="error: empty primes" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty primes");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		if core_is_prime(x) {
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	gold_cache_put(g, 0, removed);
	out.i = removed;
	out.s.clear();
	format(out.s, "primes deduped with cache");
	g.steps += g.n;
	out
}
@end
