code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf = [0; 512];
	var count = 0;
	var idx = 0;
	while idx < g.n && count + 2 <= 512 {
		let item = g.res[idx];
		buf[count] = item;
		count++;
		buf[count] = item;
		count++;
		idx += 2;
	}
	for k in count { g.res[k] = buf[k]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated alternating items");
	out
}
@end
