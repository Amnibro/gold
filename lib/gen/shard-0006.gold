fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens++;
		} else {
			gold_fail(g, "unexpected odd parity");
			break;
		}
	}
	let ok = evens == g.n;
	g.steps += evens + 1;
	out.i = evens;
	out.ok = ok;
	out.s.clear();
	format(out.s, "verified evens count ", evens);
	out
}
@end
