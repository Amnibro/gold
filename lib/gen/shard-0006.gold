code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let limit = g.n - 1;
	for k in limit {
		let diff = g.res[k + 1] - g.res[k];
		let delta = if diff < 0 { -diff } else { diff };
		gold_push(g, delta);
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "deltas: ", limit);
	g.steps += limit;
	out
}
@end
