fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	var neg = 0;
	for i in g.n {
		if g.res[i] < 0 { neg++; }
		sum += g.res[i];
	}
	if neg > 0 {
		gold_fail(g, "negative value in results");
	}
	let avg = sum / g.n;
	var w = 0;
	for i in g.n {
		if g.res[i] >= avg {
		g.res[w] = g.res[i];
		w++;
		}
	}
	g.n = w;
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "kept above average count ", w);
	out
}
