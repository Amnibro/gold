code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if w <= 0 || g.n < w { return out; }
	var max_sum = 0;
	for i in w { max_sum += g.res[i]; }
	var cur_sum = max_sum;
	for i in 1..(g.n - w + 1) {
		cur_sum = cur_sum - g.res[i - 1] + g.res[i + w - 1];
		if cur_sum > max_sum { max_sum = cur_sum; }
	}
	out.i = max_sum;
	out.s.clear();
	format(out.s, "peak window sum: ", max_sum);
	out
}
@end
