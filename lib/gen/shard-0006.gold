@entry dd3767bd86a658a0
kind: step
verb: sort
noun: prefix
modifier: nested
context: format
phrase: sort prefix nested bounds
phrase: order initial prefix segment
test: list=9,4,2,8,5
expect: => i=3 r=0.0 ok=true s="prefix sorted: 3" errors=0 n=5 res=[2,4,9,8,5] cache=0 hits=0
test: list=7,1,3
expect: => i=3 r=0.0 ok=true s="prefix sorted: 3" errors=0 n=3 res=[1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 3;
	if k > g.n {
		k = g.n;
	}
	var i = 0;
	while i < k {
		var j = i + 1;
		while j < k {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "prefix sorted: ", k);
	out
}
@end
