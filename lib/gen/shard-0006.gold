kind: step
verb: return
noun: streak
modifier: with_cache
context: loop
phrase: return streak with cache longest sequence
phrase: retrieve return streak with cache run
test: list=2,2,2,3,3
expect: => i=3 r=0.0 ok=true s="longest streak cached" errors=0 n=5 res=[2,2,2,3,3] cache=1 hits=0
test: list=1,1,1,1
expect: => i=4 r=0.0 ok=true s="longest streak cached" errors=0 n=4 res=[1,1,1,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_s = 1;
	var cur_s = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_s++;
			if cur_s > max_s { max_s = cur_s; }
		} else {
			cur_s = 1;
		}
	}
	gold_cache_put(g, 0, max_s);
	out.i = max_s;
	out.s.clear();
	format(out.s, "longest streak cached");
	out
}
@end
