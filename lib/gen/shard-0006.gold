code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${total};
	var current_sum = 0;
	for k in g.n {
		current_sum += g.res[k];
	}
	if current_sum > 0 {
		for k in g.n {
			g.res[k] = (g.res[k] * target) / current_sum;
		}
	}
	out.i = current_sum;
	out.s.clear();
	out.s.append("tally normalized");
	g.steps += g.n;
	out
}
