fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_total};
	var sum = 0;
	var kept = 0;
	for k in g.n {
		if sum + g.res[k] <= mt {
			sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = sum;
	out.s.clear();
	out.s.append("budget clamped safely");
	g.steps += kept;
	out
}
