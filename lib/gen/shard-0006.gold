fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	gold_cache_put(g, 99, w);
	out.i = w;
	out.s.clear();
	format(out.s, "deduped cache with retry: ", w);
	out
}
@end
