fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let first = g.res[0];
	g.res[0] = avg;
	gold_cache_put(g, first, avg);
	g.steps += g.n + 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped first with average ", avg);
	out
}
@end
