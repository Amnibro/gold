fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var pairs = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if diff <= md && diff >= -md { pairs++; }
	}
	out.i = pairs;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "matched ", pairs, " pairwise differences under margin");
	out
}
