code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let low = ${min_len};
    let high = ${max_len};
    var matching_streaks = 0;
    var cur_len = 1;
    if g.n > 1 {
        for i in 1..g.n {
            if g.res[i] == g.res[i - 1] {
                cur_len++;
            } else {
                if cur_len >= low && cur_len <= high {
                    matching_streaks++;
                }
                cur_len = 1;
            }
        }
        if cur_len >= low && cur_len <= high {
            matching_streaks++;
        }
    }
    out.i = matching_streaks;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "streaks between bounds count ", matching_streaks);
    out
}
