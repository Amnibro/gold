expect: => i=3 r=0.0 ok=false s="unique compared" errors=0 n=4 res=[1,2,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			unique_count++;
		}
	}
	out.i = unique_count;
	out.ok = unique_count == g.n;
	out.s.clear();
	out.s.append("unique compared");
	g.steps += g.n;
	out
}
@end
