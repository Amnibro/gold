fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_count = 0;
	var mode_val = g.res[0];
	for i in g.n {
		let x = g.res[i];
		var c = 0;
		for j in g.n {
			if g.res[j] == x { c++; }
		}
		if c > max_count {
			max_count = c;
			mode_val = x;
		}
	}
	out.i = mode_val;
	out.s.clear();
	format(out.s, "mode: ", mode_val);
	g.steps += g.n;
	out
}
