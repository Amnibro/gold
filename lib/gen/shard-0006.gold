expect: => i=1 r=0.0 ok=true s="scaled every other run 1" errors=0 n=4 res=[15,15,6,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var run_idx = 0;
	var scaled_runs = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		if run_idx % 2 == 0 {
			for k in i..j {
				g.res[k] *= m;
			}
			gold_cache_put(g, run_idx, g.res[i]);
			scaled_runs++;
		}
		run_idx++;
		i = j;
	}
	g.steps += g.n * 2;
	out.i = scaled_runs;
	out.s.clear();
	format(out.s, "scaled every other run ", scaled_runs);
	out
}
@end
