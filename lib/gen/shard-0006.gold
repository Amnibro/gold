code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	for i in g.n {
		g.res[i] += off;
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped words reverse ", g.n);
	out
}
@end
