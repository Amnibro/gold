fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	for k in g.n - 1 {
		g.res[k] = (g.res[k] + g.res[k + 1]) / 2;
	}
	g.n--;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed ", g.n, " pairwise averages");
	g.steps += g.n;
	out
}
