code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var found_idx = -1;
	for k in g.n - 1 {
		if g.res[k] + g.res[k + 1] > th {
			found_idx = k;
			break;
		}
	}
	if found_idx >= 0 {
		out.ok = true;
		out.i = found_idx;
		out.s.clear();
		format(out.s, "found pair over threshold at index ", found_idx);
	} else {
		out.ok = false;
		out.i = -1;
		out.s.clear();
		out.s.append("no pair exceeds threshold");
	}
	g.steps += g.n;
	out
}
@end
