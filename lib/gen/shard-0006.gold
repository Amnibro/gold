code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${count};
	var start = if g.n > lim { g.n - lim } else { 0 };
	var k = start;
	var idx = 0;
	while k < g.n {
		gold_cache_put(g, idx, g.res[k]);
		idx++;
		k++;
	}
	g.steps += idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "cached suffix ", idx);
	out
}
@end
