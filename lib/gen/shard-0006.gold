@entry af57b9f99e5a388c
kind: step
verb: shift
noun: digits
modifier: any
context: compare
phrase: shift results comparing digit sum against target {target}
phrase: compare digit sum shifting elements matching target {target}
slot: target int
test: list=14,23,55 target=5
expect: => i=2 r=0.0 ok=true s="matched 2 items with digit sum 5" errors=0 n=3 res=[14,23,55] cache=0 hits=0
test: list=10,20 target=8
expect: => i=0 r=0.0 ok=true s="matched 0 items with digit sum 8" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matched = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s == tgt { matched++; }
	}
	out.i = matched;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "matched ", matched, " items with digit sum ", tgt);
	out
}
@end
@entry 4c3457257bbf3bff
kind: step
verb: fill
noun: average
modifier: until
context: compare
phrase: fill elements comparing below average with average value
phrase: replace items comparing under list average with mean
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="filled 2 items with average" errors=0 n=4 res=[25,25,30,40] cache=0 hits=0
test: list=2,8
expect: => i=1 r=0.0 ok=true s="filled 1 items with average" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for average fill");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var modified = 0;
	for k in g.n {
		if g.res[k] < avg {
			g.res[k] = avg;
			modified++;
		}
	}
	out.i = modified;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filled ", modified, " items with average");
	out
}
@end
