fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var balanced = false;
	if g.n >= 3 {
		let ends = g.res[0] + g.res[g.n - 1];
		let mid2 = g.res[g.n / 2] * 2;
		balanced = (ends == mid2);
	}
	out.ok = balanced;
	out.s.clear();
	if balanced {
		out.s.append("midpoint balanced");
	} else {
		out.s.append("not balanced");
	}
	g.steps += g.n;
	out
}
@end
