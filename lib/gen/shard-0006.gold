@entry 851affc3f6c62acb
kind: step
verb: scale
noun: maximum
modifier: unique
context: aggregate
phrase: scale unique maximum by factor {factor}
phrase: multiply solitary peak value by {factor}
phrase: adjust single maximum by factor {factor}
slot: factor int
test: list=3,9,5 factor=2
expect: => i=18 r=0.0 ok=true s="scaled unique maximum" errors=0 n=3 res=[3,18,5] cache=0 hits=0
test: list=8,4,8 factor=3
expect: => i=8 r=0.0 ok=false s="maximum is not unique" errors=0 n=3 res=[8,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	var max_idx = 0;
	var count = 0;
	for k in g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			max_idx = k;
			count = 1;
		} else if g.res[k] == max_val {
			count++;
		}
	}
	if count == 1 {
		g.res[max_idx] = max_val * fac;
		out.i = g.res[max_idx];
		out.ok = true;
		out.s.clear();
		out.s.append("scaled unique maximum");
	} else {
		out.i = max_val;
		out.ok = false;
		out.s.clear();
		out.s.append("maximum is not unique");
	}
	g.steps += g.n;
	out
}
@end
