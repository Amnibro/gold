@entry 908af07b67dc470c
kind: step
verb: dedupe
noun: minimum
modifier: at_least
context: error
phrase: dedupe minimum errors at least {threshold}
phrase: eliminate repeated minimums above threshold {threshold}
slot: threshold int
test: list=5,2,2,8 threshold=2
expect: => i=1 r=0.0 ok=true s="minimum deduped" errors=0 n=3 res=[5,2,8] cache=0 hits=0
test: list=5,2,2,8 threshold=-1
expect: => i=0 r=0.0 ok=false s="error: negative threshold" errors=1 n=4 res=[5,2,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th < 0 {
		gold_fail(g, "negative threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative threshold");
		return out;
	}
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var kept = 0;
	var seen_min = false;
	for k in g.n {
		if g.res[k] == min_val && min_val >= th {
			if !seen_min {
				g.res[kept] = g.res[k];
				kept++;
				seen_min = true;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "minimum deduped");
	g.steps += g.n;
	out
}
@end
