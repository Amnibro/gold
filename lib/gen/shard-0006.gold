expect: => i=1 r=0.0 ok=true s="halved tail to 1 in 4 steps" errors=0 n=2 res=[10,1] cache=0 hits=0
test: list=5,3
expect: => i=1 r=0.0 ok=true s="halved tail to 1 in 1 steps" errors=0 n=2 res=[5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for recursive tail");
		out.ok = false;
		return out;
	}
	var cur = g.res[g.n - 1];
	var steps = 0;
	while cur > 1 && steps < 50 {
		cur /= 2;
		steps++;
	}
	g.res[g.n - 1] = cur;
	out.i = cur;
	g.steps += steps;
	out.s.clear();
	format(out.s, "halved tail to ", cur, " in ", steps, " steps");
	out
}
@end
