expect: => i=5 r=0.0 ok=true s="unique tail items collected: 5" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_tail int[512] = [0; 512];
	var un = 0;
	var i = g.n - 1;
	while i >= 0 && un < 5 {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if uniq_tail[j] == x { seen = true; break; }
		}
		if !seen {
			uniq_tail[un] = x;
			un++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "unique tail items collected: ", un);
	out
}
@end
