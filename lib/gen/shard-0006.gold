phrase: unique digit count budget reversed
test: arg=1234,1122
expect: 6
expect: 8
test: arg=9999,12345
expect: 9
expect: 5
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var mask = 0;
	while x > 0 {
		let d = x % 10;
		mask = mask | (1 << d);
		x = x / 10;
	}
	var uniq = 0;
	for i in 10 {
		if (mask & (1 << i)) != 0 {
			uniq = uniq + 1;
		}
	}
	10 - uniq
}
@end
