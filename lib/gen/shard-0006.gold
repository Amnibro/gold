code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var start = g.n - c;
	if start < 0 { start = 0; }
	for i in start..g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n - start;
	out.s.clear();
	out.s.append("sorted last items");
	g.steps += g.n - start;
	out
}
@end
@entry 513be1c16d357cb3
kind: step
verb: dedupe
noun: odds
modifier: at_least
context: search
phrase: dedupe odd search results at least {threshold}
phrase: remove duplicate odd values above {threshold}
slot: threshold int
test: list=5,3,5,7,7,2 threshold=5
expect: => i=2 r=0.0 ok=true s="deduped odds" errors=0 n=4 res=[5,3,7,2] cache=0 hits=0
test: list=9,9,9,1,4 threshold=5
expect: => i=2 r=0.0 ok=true s="deduped odds" errors=0 n=3 res=[9,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var drop = false;
		if x % 2 != 0 && x >= th {
			for j in kept {
				if g.res[j] == x {
					drop = true;
					break;
				}
			}
		}
		if !drop {
			g.res[kept] = x;
			kept++;
		}
	}
	out.i = g.n - kept;
	g.n = kept;
	out.s.clear();
	out.s.append("deduped odds");
	g.steps += g.n;
	out
}
@end
