slot: hi int
test: list=5,15,25,35 lo=10 hi=30
expect: => i=40 r=0.0 ok=true s="summed 2 values between bounds to 40" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
test: list=1,2,3 lo=5 hi=10
expect: => i=0 r=0.0 ok=true s="summed 0 values between bounds to 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var s = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= low && g.res[i] <= high {
			s += g.res[i];
			count++;
		}
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "summed ", count, " values between bounds to ", s);
	out
}
@end
