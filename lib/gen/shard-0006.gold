	let th = ${threshold};
	var swapped = 0;
	var i = g.n;
	while i > 1 {
		i--;
		if g.res[i] >= th && g.res[i - 1] < th {
			let tmp = g.res[i];
			g.res[i] = g.res[i - 1];
			g.res[i - 1] = tmp;
			gold_cache_put(g, i, g.res[i]);
			swapped++;
		}
	}
	g.steps += g.n * 2;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped condition in reverse ", swapped);
	out
}
