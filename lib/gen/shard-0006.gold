test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="paired 2 even sums" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=10,20,5,30
expect: => i=1 r=0.0 ok=true s="paired 1 even sums" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		if core_is_even(g.res[i]) {
			evens[en] = g.res[i];
			en++;
		}
	}
	var paired = 0;
	var w = 0;
	var i = 0;
	while i + 1 < en {
		evens[w] = evens[i] + evens[i + 1];
		w++;
		paired++;
		i += 2;
	}
	gold_clear(g);
	for k in w { gold_push(g, evens[k]); }
	g.steps += g.n + en;
	out.i = paired;
	out.s.clear();
	format(out.s, "paired ", paired, " even sums");
	out
}
@end
