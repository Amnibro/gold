fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${m};
	if count < g.n && count >= 0 {
		let offset = g.n - count;
		var i = 0;
		while i < count {
			g.res[i] = g.res[offset + i];
			i++;
		}
		g.n = count;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail kept ", g.n);
