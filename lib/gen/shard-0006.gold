test: list=10,14,25,30
expect: => i=20 r=0.0 ok=true s="total gap distance: 20" errors=0 n=4 res=[10,14,25,30] cache=0 hits=0
test: list=50,20
expect: => i=30 r=0.0 ok=true s="total gap distance: 30" errors=0 n=2 res=[50,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = false;
		out.s.clear();
		out.s.append("insufficient elements for gaps");
		return out;
	}
	var total_gap = 0;
	let count = g.n - 1;
	for i in count {
		let diff = g.res[i + 1] - g.res[i];
		let pos_diff = if diff < 0 { -diff } else { diff };
		total_gap += pos_diff;
	}
	out.i = total_gap;
	out.s.clear();
	format(out.s, "total gap distance: ", total_gap);
	g.steps += count;
	out
}
@end
