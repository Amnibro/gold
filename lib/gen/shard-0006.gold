fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = if ${start} < 0 { 0 } else { ${start} };
	let e = if ${end} >= g.n { g.n - 1 } else { ${end} };
	var sum = 0;
	if s <= e && s < g.n {
		for k in s..(e + 1) {
			sum += g.res[k];
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "safely scanned range sum: ", sum);
	out
}
