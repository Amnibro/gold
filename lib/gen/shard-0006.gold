@entry e3ebad3fa3d1043a
kind: step
verb: drop
noun: prefix
modifier: recursively
context: stats
phrase: drop prefix samples recursively matching {p}
phrase: prune leading data recursively while {p}
slot: p pred
test: list=2,4,6,7,9 p=is_even
expect: => i=3 r=0.0 ok=true s="prefix dropped recursively" errors=0 n=2 res=[7,9] cache=0 hits=0
test: list=1,3,5,2,4 p=is_even
expect: => i=0 r=0.0 ok=true s="prefix dropped recursively" errors=0 n=5 res=[1,3,5,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var drop_count = 0;
	while drop_count < g.n && ${p}(g.res[drop_count]) {
		drop_count++;
	}
	if drop_count > 0 {
		for i in drop_count..g.n {
			g.res[i - drop_count] = g.res[i];
		}
		g.n -= drop_count;
	}
	out.i = drop_count;
	out.s.clear();
	out.s.append("prefix dropped recursively");
	g.steps += g.n;
	out
}
@end
