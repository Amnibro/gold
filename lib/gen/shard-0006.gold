code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_uniq = true;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq {
			break;
		}
	}
	g.steps += g.n;
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	out.s.clear();
	if is_uniq {
		out.s.append("all items distinct");
	} else {
		out.s.append("duplicate items found");
	}
	out
}
@end
