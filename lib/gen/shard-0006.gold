expect: => i=0 r=0.0 ok=true s="reversed 0 qualifying odd items" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var odd_idx int[512] = [0; 512];
	var odd_val int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		if core_is_odd(g.res[i]) && g.res[i] >= th {
			odd_idx[on] = i;
			odd_val[on] = g.res[i];
			on++;
		}
	}
	for k in on {
		g.res[odd_idx[k]] = odd_val[on - 1 - k];
	}
	g.steps += g.n + on;
	out.i = on;
	out.s.clear();
	format(out.s, "reversed ", on, " qualifying odd items");
	out
}
@end
