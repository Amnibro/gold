kind: step
verb: compare
noun: middle
modifier: unique
context: loop
phrase: compare middle elements loop for unique values
phrase: check middle values loop for unique occurrences
phrase: verify middle slice loop contains unique items
test: list=10,2,3,4,20
expect: => i=3 r=0.0 ok=true s="middle slice items are unique" errors=0 n=5 res=[10,2,3,4,20] cache=0 hits=0
test: list=10,2,2,4,20
expect: => i=0 r=0.0 ok=false s="error: duplicate in middle loop" errors=1 n=5 res=[10,2,2,4,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "list too short for middle slice");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var has_dup = false;
	var i = 1;
	while i < g.n - 1 {
		var j = i + 1;
		while j < g.n - 1 {
			if g.res[i] == g.res[j] { has_dup = true; break; }
			j++;
		}
		if has_dup { break; }
		i++;
	}
	out.s.clear();
	if !has_dup {
		out.i = g.n - 2;
		out.ok = true;
		format(out.s, "middle slice items are unique");
	} else {
		gold_fail(g, "duplicate in middle loop");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: duplicate in middle loop");
	}
	g.steps += g.n;
	out
}
@end
@entry 7def93a5b902ecda
kind: step
verb: normalize
noun: pairs
modifier: between
context: loop
phrase: normalize pairs in loop between {low} to {high}
phrase: scale pair sums in loop between {low} to {high}
phrase: bound pairs in loop between limits {low} to {high}
slot: low int
slot: high int
test: list=2,3,4,5 low=4 high=10
expect: => i=2 r=0.0 ok=true s="pair sums within bounds" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=1,1,2,2 low=5 high=10
expect: => i=0 r=0.0 ok=false s="error: pair sum out of bounds" errors=1 n=4 res=[1,1,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n < 2 || g.n % 2 != 0 {
		gold_fail(g, "invalid list length for pairs");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid list length for pairs");
		return out;
	}
	var pairs = g.n / 2;
	var valid = true;
	for k in pairs {
		let sum_pair = g.res[2 * k] + g.res[2 * k + 1];
		if sum_pair < lo || sum_pair > hi { valid = false; break; }
	}
	out.s.clear();
	if valid {
		out.i = pairs;
		out.ok = true;
		format(out.s, "pair sums within bounds");
	} else {
		gold_fail(g, "pair sum out of bounds");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: pair sum out of bounds");
	}
	g.steps += pairs;
	out
}
@end
