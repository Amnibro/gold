phrase: ensure retry pair totals reach at least {floor}
slot: floor int
test: list=2,3,5,1 floor=10
expect: => i=2 r=0.0 ok=true s="clamped pairs at least" errors=0 n=4 res=[2,8,5,5] cache=0 hits=0
test: list=4,4,6,2 floor=12
expect: => i=2 r=0.0 ok=true s="clamped pairs at least" errors=0 n=4 res=[4,8,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var adjusted = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if sum < fl {
			g.res[i + 1] = fl - g.res[i];
			adjusted++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped pairs at least");
	out
}
@end
