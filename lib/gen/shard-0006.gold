fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var max_step = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		if diff > max_step && diff <= limit {
			max_step = diff;
		}
	}
	out.i = max_step;
	out.s.clear();
	out.s.append("step found");
	g.steps += g.n;
	out
}
