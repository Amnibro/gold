fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot average empty error list");
		out.ok = false;
		return out;
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	out.i = total;
	out.r = (total as real) / (g.n as real);
	g.steps += g.n;
	out.s.clear();
	format(out.s, "running sum is ", total);
	out
}
@end
