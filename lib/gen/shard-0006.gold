code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "sequence too short for unique grouping");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: sequence too short");
		return out;
	}
	var new_n = 0;
	for k in g.n {
		let x = g.res[k];
		if new_n == 0 || g.res[new_n - 1] != x {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.n = new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped unique sequence");
	g.steps += g.n;
	out
}
@end
