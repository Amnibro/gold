fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	for i in g.n {
		if i % 2 == 1 {
			var is_dup = false;
			for j in i {
				if g.res[j] == g.res[i] { is_dup = true; break; }
			}
			if is_dup && g.res[i] > b {
				g.res[i] = b;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped alternating duplicates");
	out
}
@end
