code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run_len = 1;
	while run_len < g.n && g.res[run_len] == g.res[0] {
		run_len++;
	}
	let first = g.res[0];
	for i in 1..run_len {
		g.res[i - 1] = g.res[i];
	}
	g.res[run_len - 1] = first;
	out.i = run_len;
	out.s.clear();
	out.s.append("rotated run");
	g.steps += run_len;
	out
}
@end
