	var out = v;
	var buf byte[..100] = [0; 100];
	var blen = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			buf[blen] = c;
			blen++;
		}
	}
	for i in blen {
		for j in i + 1..blen {
			if buf[i] > buf[j] {
				let t = buf[i];
				buf[i] = buf[j];
				buf[j] = t;
			}
		}
	}
	out.s.clear();
	for i in blen { out.s.push(buf[i]); }
	out.i = blen;
	g.steps += blen + 1;
	out
}
