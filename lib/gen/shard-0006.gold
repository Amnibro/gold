expect: => i=1 r=0.0 ok=true s="dropped cache recursively" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var kept = 0;
	for k in g.n {
		if g.res[k] <= ceil {
			g.res[kept] = g.res[k];
			gold_cache_put(g, kept, g.res[k]);
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	gold_text(out, "dropped cache recursively");
	g.steps += kept;
	out
}
@end
