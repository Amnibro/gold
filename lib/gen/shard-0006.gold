fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${cap};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && swaps < max_swaps {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i++;
	}
	g.steps += i;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " value swaps");
	out
}
@end
