code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let v_num = ${val};
	if cnt <= 0 || cnt > g.n {
		gold_fail(g, "invalid fill tail parameters");
		out.ok = false;
		return out;
	}
	let start = g.n - cnt;
	for k in cnt {
		g.res[start + k] = v_num;
	}
	out.i = cnt;
	g.steps += cnt;
	out.s.clear();
	format(out.s, "filled ", cnt, " tail positions");
	out
}
@end
