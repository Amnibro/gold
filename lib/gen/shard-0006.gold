noun: sequence
modifier: unique
context: retry
phrase: count unique items in sequence attempts {attempts}
phrase: tally unique sequence elements attempts {attempts}
slot: attempts int
test: list=1,1,2,3 attempts=4
expect: => i=3 r=0.0 ok=true s="unique sequence count 3" errors=0 n=4 res=[1,1,2,3] cache=3 hits=0
test: list=5,5,5 attempts=3
expect: => i=1 r=0.0 ok=true s="unique sequence count 1" errors=0 n=3 res=[5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = if ${attempts} > g.n { g.n } else { ${attempts} };
	var unique_count = 0;
	for i in att {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, unique_count, x);
			unique_count++;
		}
	}
	g.steps += att * att + 1;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique sequence count ", unique_count);
	out
}
@end
