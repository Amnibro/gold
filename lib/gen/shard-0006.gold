	var cur_run = 1;
	if g.n > 0 {
		max_run = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
			} else {
				if cur_run > max_run { max_run = cur_run; }
				cur_run = 1;
			}
		}
		if cur_run > max_run { max_run = cur_run; }
	}
	out.i = max_run;
	out.s.clear();
	out.s.append("longest run collected");
	g.steps += g.n;
	out
}
@end
