code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.s.len;
	var i = 1;
	while i < n {
		var j = i + 2;
		while j < n {
			if (out.s[i] as int) > (out.s[j] as int) {
				let tmp = out.s[i];
				out.s[i] = out.s[j];
				out.s[j] = tmp;
			}
			j += 2;
		}
		i += 2;
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
