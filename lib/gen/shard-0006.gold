expect: => i=16 r=0.0 ok=false s="reverse tally sum 16" errors=4 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var violations = 0;
	var total_tallied = 0;
	var i = g.n;
	while i > 0 {
		i--;
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 3 {
			gold_fail(g, "frequency limit exceeded");
			violations++;
		}
		total_tallied += freq;
	}
	g.steps += g.n * g.n;
	out.i = total_tallied;
	out.ok = violations == 0;
	out.s.clear();
	format(out.s, "reverse tally sum ", total_tallied);
	out
}
@end
