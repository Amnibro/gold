expect: => i=0 r=0.0 ok=false s="error: retries must be positive" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if r <= 0 {
		gold_fail(g, "retries must be positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: retries must be positive");
		return out;
	}
	var total = 0;
	for k in out.s.len {
		let c = out.s[k];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			total++;
		}
	}
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "counted letters in loop");
	g.steps += total;
	out
}
@end
@entry 570855238d5d89b6
kind: step
verb: drop
noun: gaps
modifier: up_to
context: loop
phrase: drop loop gaps up to limit {gap_limit}
phrase: remove elements with gaps up to {gap_limit}
phrase: purge loop items having gap up to {gap_limit}
slot: gap_limit int
test: list=10,12,30,32 gap_limit=5
expect: => i=2 r=0.0 ok=true s="dropped gaps up to limit" errors=0 n=2 res=[10,30] cache=0 hits=0
test: list=10 gap_limit=5
expect: => i=0 r=0.0 ok=false s="error: invalid gap parameters" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${gap_limit};
	if limit <= 0 || g.n < 2 {
		gold_fail(g, "insufficient elements or invalid gap limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid gap parameters");
		return out;
	}
	var kept = 1;
	var dropped = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > limit {
			g.res[kept] = g.res[k];
			kept++;
		} else {
			dropped++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped gaps up to limit");
	g.steps += g.n;
	out
}
@end
