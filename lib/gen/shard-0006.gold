@entry d3fc039ea30bd60f
kind: step
verb: sort
noun: digits
modifier: first
context: aggregate
phrase: sort digits first entry
phrase: order digits first number
test: list=531,2
expect: => i=135 r=0.0 ok=true s="sorted digits first 135" errors=0 n=2 res=[531,2] cache=0 hits=0
test: list=82,9
expect: => i=28 r=0.0 ok=true s="sorted digits first 28" errors=0 n=2 res=[82,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	var num = if g.res[0] < 0 { -g.res[0] } else { g.res[0] };
	var counts = [0; 10];
	while num > 0 {
		counts[num % 10] += 1;
		num /= 10;
	}
	var res = 0;
	var d = 1;
	while d < 10 {
		var c = 0;
		while c < counts[d] {
			res = res * 10 + d;
			c++;
		}
		d++;
	}
	g.steps += 1;
	out.i = res;
	out.s.clear();
	format(out.s, "sorted digits first ", res);
	out
}
@end
