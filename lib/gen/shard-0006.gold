expect: => i=3 r=0.0 ok=true s="mapped gaps recursively" errors=0 n=3 res=[8,12,16] cache=0 hits=0
test: list=5,15,30 scale_val=3
expect: => i=2 r=0.0 ok=true s="mapped gaps recursively" errors=0 n=2 res=[30,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale_val};
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	for k in g.n - 1 {
		g.res[k] = (g.res[k + 1] - g.res[k]) * sc;
	}
	g.n--;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	out.s.append("mapped gaps recursively");
	g.steps += g.n;
	out
}
@end
