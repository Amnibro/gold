		x /= 10;
	}
	var res = 0;
	for d in 1..10 {
		var c = counts[d];
		while c > 0 {
			res = res * 10 + d;
			c--;
		}
	}
	res
}
@end
@entry 4c0b9f283e55593a
kind: fn
verb: sort
noun: middle
modifier: none
context: math
phrase: sort middle none central digits value
phrase: order interior digits between endpoints
test: arg=9418,73215
expect: 9148
expect: 71235
test: arg=42
expect: 42
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 100 { return x; }
	var d int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	let first = d[len - 1];
	let last = d[0];
	var mid_counts int[10] = [0; 10];
	for i in 1..len - 1 {
		mid_counts[d[i]]++;
	}
	var res = first;
	for digit in 10 {
		var c = mid_counts[digit];
		while c > 0 {
			res = res * 10 + digit;
			c--;
		}
	}
	res * 10 + last
}
@end
