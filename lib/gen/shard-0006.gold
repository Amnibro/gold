code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf int[100] = [0; 100];
	var blen = 0;
	var i = g.n;
	while i > 0 {
		i--;
		let x = g.res[i];
		var exists = false;
		for j in blen {
			if buf[j] == x { exists = true; break; }
		}
		if !exists && blen < 100 {
			buf[blen] = x;
			blen++;
		}
	}
	gold_clear(g);
	while blen > 0 {
		blen--;
		gold_push(g, buf[blen]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept rightmost: ", g.n);
	g.steps += g.n;
	out
}
@end
