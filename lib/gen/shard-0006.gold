code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean: byte[..200] = "";
	var prev_space = false;
	for i in out.s.len {
		let c = out.s[i];
		if c == 32 {
			if !prev_space {
				clean.push(c);
				prev_space = true;
			}
		} else {
			clean.push(c);
			prev_space = false;
		}
	}
	gold_cache_put(g, clean.len, out.s.len);
	out.s = clean;
	out.i = clean.len;
	out
}
@end
