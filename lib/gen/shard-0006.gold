fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	var swapped = 0;
	if w >= 2 && w <= g.n {
		let tmp = g.res[0];
		g.res[0] = g.res[w - 1];
		g.res[w - 1] = tmp;
		gold_cache_put(g, 0, g.res[0]);
		swapped = 1;
	}
	g.steps += g.n + 1;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped window nested ", swapped);
	out
}
@end
