code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var violations = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] {
			gold_fail(g, "checkpoint time decreased");
			violations++;
		} else if g.res[i] - g.res[i - 1] > lim {
			violations++;
		}
	}
	let ok = violations == 0;
	g.steps += g.n + 1;
	out.i = violations;
	out.ok = ok;
	out.s.clear();
	format(out.s, "checkpoint violations ", violations);
	out
}
@end
@entry 9bea935109f0c879
kind: step
verb: scale
noun: squares
modifier: between
context: error
phrase: scale square numbers between limits {low} {high}
phrase: multiply square values between boundaries {low} {high}
slot: low int
slot: high int
test: list=4,9,16,5 low=4 high=10
expect: => i=2 r=0.0 ok=true s="scaled squares count 2" errors=0 n=4 res=[8,18,16,5] cache=0 hits=0
test: list=4,-1,9 low=1 high=20
expect: => i=2 r=0.0 ok=true s="scaled squares count 2" errors=1 n=3 res=[8,-1,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		if x < 0 {
			gold_fail(g, "negative square invalid");
			continue;
		}
		var is_sq = false;
		for r in 100 {
			if r * r == x { is_sq = true; break; }
		}
		if is_sq && x >= lo && x <= hi {
			g.res[i] *= 2;
			scaled++;
		}
	}
	g.steps += g.n * 10;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled squares count ", scaled);
	out
}
@end
@entry 64cebe381c18f550
kind: step
verb: merge
noun: prefix
modifier: sorted
context: error
phrase: merge prefix elements checking sorted order {length}
phrase: combine prefix values verifying sorted sequence {length}
slot: length int
test: list=1,2,3,4 length=3
expect: => i=6 r=0.0 ok=true s="merged prefix sum 6" errors=0 n=4 res=[6,2,3,4] cache=0 hits=0
test: list=3,1,2,4 length=3
expect: => i=6 r=0.0 ok=false s="merged prefix sum 6" errors=1 n=4 res=[6,1,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = if ${length} > g.n { g.n } else { ${length} };
	var sorted = true;
	var sum = 0;
	for i in len {
		if i > 0 && g.res[i] < g.res[i - 1] {
			sorted = false;
		}
		sum += g.res[i];
	}
	if !sorted {
		gold_fail(g, "prefix sort error");
	}
	if len > 0 {
		g.res[0] = sum;
	}
	g.steps += len + 1;
	out.i = sum;
	out.ok = sorted;
	out.s.clear();
	format(out.s, "merged prefix sum ", sum);
	out
}
@end
