code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cur = out.i;
	var count = 0;
	while !${stop}(cur) {
		let nxt = ${f}(cur);
		gold_cache_put(g, count, cur);
		cur = nxt;
		count++;
		if count >= 100 {
			gold_fail(g, "cache loop limit exceeded");
			out.ok = false;
			return out;
		}
	}
	gold_cache_put(g, count, cur);
	out.i = cur;
	g.steps += count;
	out.s.clear();
	format(out.s, "cached ", count + 1, " steps");
	out
}
@end
