expect: => i=30 r=0.0 ok=true s="scaled average is 30" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mul};
	if g.n == 0 { return out; }
	var s = 0;
	for i in g.n { s += g.res[i]; }
	let avg = (s / g.n) * m;
	out.i = avg;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "scaled average is ", avg);
	out
}
