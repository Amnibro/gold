@entry 3675de8660c945ac
kind: step
verb: measure
noun: duplicates
modifier: at_least
context: search
phrase: measure duplicate candidates appearing at least {min_rep} times
phrase: count repeated search items occurring at least {min_rep} times
slot: min_rep int
test: list=1,2,2,3,3,3 min_rep=2
expect: => i=2 r=0.0 ok=true s="found 2 repeated candidate values" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,5,10 min_rep=3
expect: => i=1 r=0.0 ok=true s="found 1 repeated candidate values" errors=0 n=4 res=[5,5,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_rep};
	var matched = 0;
	var checked int[512] = [0; 512];
	var n_checked = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in n_checked {
			if checked[j] == x { seen = true; break; }
		}
		if !seen {
			checked[n_checked] = x;
			n_checked++;
			var count = 0;
			for k in g.n {
				if g.res[k] == x { count++; }
			}
			if count >= mr { matched++; }
		}
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "found ", matched, " repeated candidate values");
	out
}
@end
