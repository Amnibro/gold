@entry ad1997ce31d9c518
kind: step
verb: count
noun: streak
modifier: unique
context: transform
phrase: count longest streak of unique consecutive values
phrase: measure continuous run of distinct adjacent items
test: list=1,2,3,3,4,5
expect: => i=3 r=0.0 ok=true s="longest unique streak: 3" errors=0 n=6 res=[1,2,3,3,4,5] cache=0 hits=0
test: list=1,1,1
expect: => i=1 r=0.0 ok=true s="longest unique streak: 1" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest unique streak: ", max_streak);
	out
