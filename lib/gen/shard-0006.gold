fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${lim};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > threshold {
			let val = g.res[i];
			g.res[i] = val + 1;
			count++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated ", count, " threshold items");
	out
}
@end
