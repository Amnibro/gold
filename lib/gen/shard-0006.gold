fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j += 2;
		}
		i += 2;
	}
	let count = (g.n + 1) / 2;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "alternate items sorted: ", count);
	out
}
