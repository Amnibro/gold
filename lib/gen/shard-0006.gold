@entry 36f629120bfbc9ba
kind: step
verb: sum
noun: digits
modifier: unique
context: filter
phrase: sum digits unique elements
phrase: accumulate digits unique set
test: list=12,305
expect: => i=2 r=0.0 ok=true s="summed unique digits 2" errors=0 n=2 res=[3,8] cache=0 hits=0
test: list=99,111
expect: => i=2 r=0.0 ok=true s="summed unique digits 2" errors=0 n=2 res=[9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var v_num = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var seen = [0; 10];
		while v_num > 0 {
			seen[v_num % 10] = 1;
			v_num /= 10;
		}
		var digit_sum = 0;
		for d in 10 {
			if seen[d] == 1 { digit_sum += d; }
		}
		g.res[k] = digit_sum;
	}
	g.steps += g.n;
	out.i = g.n;
