code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var max_len = 0;
	var cur_len = 0;
	for i in g.n {
		if i == 0 || g.res[i] > g.res[i - 1] {
			cur_len++;
		} else {
			cur_len = 1;
		}
		if cur_len > max_len { max_len = cur_len; }
	}
	if max_len >= th {
		gold_cache_put(g, max_len, 1);
	}
	g.steps += g.n + 1;
	out.i = max_len;
	out.s.clear();
	format(out.s, "series length measured ", max_len);
	out
}
@end
