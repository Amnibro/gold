code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cycles};
	for idx in out.s.len {
		let ch = out.s[idx];
		if ch >= 'a' && ch <= 'z' {
			let shifted = 'a' + (((ch - 'a') + c) % 26);
			out.s[idx] = shifted as! byte;
		}
	}
	g.steps += out.s.len;
	out.i = c;
	out
}
@end
