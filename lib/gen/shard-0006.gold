		gold_fail(g, "empty list for sorted function mapping");
		out.ok = false;
		return out;
	}
	for k in g.n {
		g.res[k] = ${f}(g.res[k]);
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("collected and sorted results");
	out
}
