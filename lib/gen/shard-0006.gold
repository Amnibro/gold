fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, hit = gold_cache_get(g, k);
	if hit {
		out.ok = true;
		out.i = val;
		out.s.clear();
		format(out.s, "found cached key ", k, " with value ", val);
	} else {
		gold_cache_put(g, k, g.n);
		out.ok = false;
		out.i = g.n;
		out.s.clear();
		format(out.s, "stored cache entry ", k, " with size ", g.n);
	}
	g.steps++;
	out
}
