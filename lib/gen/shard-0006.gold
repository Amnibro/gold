noun: duplicates
modifier: safely
context: text
phrase: rank duplicates safely count characters appearing multiple times
phrase: tally repeated distinct symbols in string safely
test: text="banana"
expect: => i=2 r=0.0 ok=true s="banana" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcd"
expect: => i=0 r=0.0 ok=true s="abcd" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in out.s.len {
		let c = out.s[i];
		var seen_before = false;
		for j in i {
			if out.s[j] == c { seen_before = true; break; }
		}
		if !seen_before {
			var total = 0;
			for j in out.s.len {
				if out.s[j] == c { total++; }
			}
			if total > 1 { dup_count++; }
		}
	}
	out.i = dup_count;
	g.steps += out.s.len;
	out
}
@end
