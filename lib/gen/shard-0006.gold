@entry 01b0db2497266cb8
kind: step
verb: select
noun: streak
modifier: in_place
context: search
phrase: select longest increasing search streak in place
phrase: retain maximal ascending candidate streak in place
test: list=10,20,30,5,15
expect: => i=3 r=0.0 ok=true s="selected streak of length 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="selected streak of length 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = k;
			cur_len = 1;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	out.i = best_len;
