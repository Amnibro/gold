fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for average assignment");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	g.res[g.n - 1] = avg;
	out.i = avg;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "set tail element to average ", avg);
	out
}
@end
