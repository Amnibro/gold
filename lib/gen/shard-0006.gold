phrase: verify value in cache attempts {target}
slot: target int
test: list=10,20,30 target=20
expect: => i=1 r=0.0 ok=true s="checked value result 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=10,20,30 target=50
expect: => i=0 r=0.0 ok=false s="checked value result 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached_val, hit = gold_cache_get(g, tgt);
	if hit {
		out.i = cached_val;
		out.ok = true;
	} else {
		var found = -1;
		for i in g.n {
			if g.res[i] == tgt { found = i; break; }
		}
		if found != -1 {
			gold_cache_put(g, tgt, found);
			out.i = found;
			out.ok = true;
		} else {
			out.i = 0;
			out.ok = false;
		}
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "checked value result ", out.i);
	out
}
@end
