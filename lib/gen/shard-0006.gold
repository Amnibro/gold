fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var modified = 0;
	for k in g.n {
		if g.res[k] > c {
			g.res[k] = c;
			modified++;
		}
	}
	out.s.clear();
	if modified > 0 {
		out.i = c;
		out.ok = true;
		format(out.s, "running memo clamped at ceiling");
	} else {
		gold_fail(g, "no memo values exceeded ceiling");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: no memo values exceeded ceiling");
	}
	g.steps += g.n;
	out
}
