fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let allowed = ${retries};
	var faults = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				faults++;
			}
		}
	}
	g.steps += g.n;
	out.ok = faults <= allowed;
	out.i = faults;
	out.s.clear();
	if faults <= allowed {
		format(out.s, "passed step check with ", faults, " faults");
	} else {
		format(out.s, "failed step check with ", faults, " faults");
	}
	out
}
