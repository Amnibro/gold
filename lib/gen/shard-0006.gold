slot: f fn
test: list=1,2,2,2,3 min_len=3 f=double
expect: => i=3 r=0.0 ok=true s="mapped 3 items in runs reaching threshold" errors=0 n=5 res=[1,4,4,4,3] cache=0 hits=0
