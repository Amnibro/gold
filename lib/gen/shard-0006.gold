test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="running tail filtered" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,15,25
expect: => i=3 r=0.0 ok=true s="running tail filtered" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
		gold_cache_put(g, k, sum);
	}
	let mid = g.n / 2;
	var kept = 0;
	for k in g.n {
		if k < mid || g.res[k] * g.n >= sum {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("running tail filtered");
	g.steps += g.n;
	out
}
@end
