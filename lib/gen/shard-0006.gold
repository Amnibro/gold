fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for k in g.n {
		if !${cond}(g.res[k]) { break; }
		g.res[k] *= f;
		scaled++;
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " search values");
	out
}
@end
