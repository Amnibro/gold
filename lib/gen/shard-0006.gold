fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_sum = 0;
	var dup_count = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { count++; }
		}
		if count > 1 {
			dup_sum += g.res[i];
			dup_count++;
		}
	}
	g.steps += g.n;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "sum of duplicates is ", dup_sum);
	out
}
@end
