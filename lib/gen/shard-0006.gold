code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	out.s.clear();
	format(out.s, "running rotate: ");
	for i in g.n {
		if i > 0 { format(out.s, ">"); }
		format(out.s, g.res[i]);
	}
	out.i = g.n;
	out
}
@end
