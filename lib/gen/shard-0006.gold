expect: => i=35 r=0.0 ok=true s="cached suffix of at least minimum length" errors=0 n=4 res=[5,10,15,20] cache=1 hits=0
test: list=5 min_len=2
expect: => i=0 r=0.0 ok=false s="error: suffix below minimum" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	if min_l <= 0 || g.n < min_l {
		gold_fail(g, "suffix length below minimum");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: suffix below minimum");
		return out;
	}
	var sum = 0;
	let start = g.n - min_l;
	for k in start..g.n {
		sum += g.res[k];
	}
	gold_cache_put(g, min_l, sum);
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached suffix of at least minimum length");
	g.steps += min_l;
	out
}
@end
