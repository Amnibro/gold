code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var hi int[512] = [0; 512];
	var hi_len = 0;
	var lo int[512] = [0; 512];
	var lo_len = 0;
	for i in g.n {
		if g.res[i] >= fl {
			hi[hi_len] = g.res[i];
			hi_len++;
		} else {
			lo[lo_len] = g.res[i];
			lo_len++;
		}
	}
	for i in hi_len { g.res[i] = hi[i]; }
	for i in lo_len { g.res[hi_len + i] = lo[i]; }
	g.steps += g.n * 2;
	out.i = hi_len;
	out.s.clear();
	format(out.s, "rotated values at least floor");
	out
}
@end
