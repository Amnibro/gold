code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var clamped = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 && g.res[k] > c {
			g.res[k] = c;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	if clamped > 0 {
		out.ok = true;
		format(out.s, "capped exceeding odd values");
	} else {
		gold_fail(g, "no odd values clamped");
		out.ok = false;
		format(out.s, "error: no odd values clamped");
	}
	g.steps += g.n;
	out
}
@end
