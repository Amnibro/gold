@entry 65d3e6e1231fc2c2
kind: step
verb: drop
noun: average
modifier: with_retry
context: retry
phrase: drop elements below average with retry threshold
phrase: filter out below average items with retry logic
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="dropped 2 below average items" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15
expect: => i=1 r=0.0 ok=true s="dropped 1 below average items" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for average drop");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var kept = 0;
	for k in g.n {
		if g.res[k] >= avg {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " below average items");
	out
}
@end
