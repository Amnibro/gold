fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var hits = 0;
	for rep in t {
		for k in g.n {
			let val, ok = gold_cache_get(g, g.res[k]);
			if ok { hits++; }
			else { gold_cache_put(g, g.res[k], 1); }
		}
	}
	out.i = hits;
	out.s.clear();
	format(out.s, "cache scan hits: ", hits);
	out
}
@end
