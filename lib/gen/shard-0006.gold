@entry 764d704627a044ff
kind: step
verb: compare
noun: window
modifier: all
context: sort
phrase: compare all adjacent sorted windows of length {win}
phrase: evaluate all sorted sliding windows of size {win}
slot: win int
test: list=1,3,6,10,15 win=2
expect: => i=25 r=0.0 ok=true s="max sliding window sum 25" errors=0 n=5 res=[1,3,6,10,15] cache=0 hits=0
test: list=2,5,9,14 win=3
expect: => i=28 r=0.0 ok=true s="max sliding window sum 28" errors=0 n=4 res=[2,5,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let k = ${win};
    var max_sum = 0;
    if g.n >= k && k > 0 {
        var cur_sum = 0;
        for i in k {
            cur_sum += g.res[i];
        }
        max_sum = cur_sum;
        for i in k..g.n {
            cur_sum += g.res[i] - g.res[i - k];
            if cur_sum > max_sum {
                max_sum = cur_sum;
            }
        }
    }
    out.i = max_sum;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "max sliding window sum ", max_sum);
    out
}
@end
