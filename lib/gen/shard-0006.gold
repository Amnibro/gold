expect: => i=19 r=0.0 ok=true s="folded unique prefix to 19" errors=0 n=4 res=[2,3,2,4] cache=0 hits=0
test: list=5,5,1 init=0
expect: => i=6 r=0.0 ok=true s="folded unique prefix to 6" errors=0 n=3 res=[5,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = ${init};
	var seen int[256] = [0; 256];
	var sn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_seen = false;
		for j in sn {
			if seen[j] == x { is_seen = true; break; }
		}
		if !is_seen {
			seen[sn] = x;
			sn++;
			acc += x;
		}
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded unique prefix to ", acc);
	out
}
@end
