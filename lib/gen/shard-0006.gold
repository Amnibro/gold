test: list=10,8,6,4
expect: => i=6 r=0.0 ok=true s="reverse window difference total is 6" errors=0 n=4 res=[10,8,6,4] cache=0 hits=0
test: list=2,5,3,9
expect: => i=-7 r=0.0 ok=true s="reverse window difference total is -7" errors=0 n=4 res=[2,5,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("too few items for reverse window");
		return out;
	}
	var diff_sum = 0;
	var k = g.n - 1;
	while k > 0 {
		diff_sum += g.res[k - 1] - g.res[k];
		k--;
	}
	out.i = diff_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reverse window difference total is ", diff_sum);
	out
}
@end
