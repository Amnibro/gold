	let tgt = ${target};
	var count = 0;
	var tgt_idx = -1;
	for k in g.n {
		if g.res[k] == tgt {
			count++;
			tgt_idx = k;
		}
	}
	if count == 1 && g.n > 1 {
		let p_sum = g.res[0] + g.res[tgt_idx];
		gold_cache_put(g, g.res[0], g.res[tgt_idx]);
		out.i = p_sum;
		out.ok = true;
		out.s.clear();
		format(out.s, "paired unique item ", tgt, " with first element");
	} else {
		out.i = count;
		out.ok = false;
		out.s.clear();
		out.s.append("target item is not unique");
	}
	g.steps += g.n;
	out
}
@end
