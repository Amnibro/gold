@entry 4c0f3ea791bf3fc8
kind: step
verb: check
noun: condition
modifier: between
context: format
phrase: check condition {p} holds between bounds {low} to {high}
phrase: verify predicate {p} within range {low} to {high}
phrase: ensure condition {p} satisfied between {low} to {high}
slot: low int
slot: high int
slot: p pred
test: list=2,4,6,15 low=1 high=10 p=is_even
expect: => i=3 r=0.0 ok=true s="all 3 bounded items satisfy condition" errors=0 n=4 res=[2,4,6,15] cache=0 hits=0
test: list=2,3,6,15 low=1 high=10 p=is_even
expect: => i=2 r=0.0 ok=false s="condition failed for bounded items" errors=0 n=4 res=[2,3,6,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var valid = true;
	var checked = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			checked++;
			if !${p}(g.res[k]) {
				valid = false;
				break;
			}
		}
	}
	out.ok = valid && checked > 0;
	out.i = checked;
	out.s.clear();
	if out.ok {
		format(out.s, "all ", checked, " bounded items satisfy condition");
	} else {
		out.s.append("condition failed for bounded items");
	}
	g.steps += g.n;
	out
}
@end
