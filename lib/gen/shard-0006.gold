	var count = 0;
	for k in g.n {
		if g.res[k] == first { count++; }
	}
	out.i = count;
	out.ok = count >= req;
	out.s.clear();
	if out.ok {
		out.s.append("history frequency reached");
	} else {
		out.s.append("history frequency below threshold");
	}
	g.steps += g.n;
	out
}
