@entry f684b390e8322236
kind: step
verb: dedupe
noun: list
modifier: nested
context: error
phrase: dedupe list removing nested duplicate values
phrase: eliminate nested duplicates from results list
phrase: purge nested duplicate entries across list
test: list=1,2,2,3,1
expect: => i=2 r=0.0 ok=true s="nested duplicates removed" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=false s="error: no duplicates found" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for dedupe");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var new_n = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		} else {
			removed++;
		}
	}
	g.n = new_n;
	out.i = removed;
	out.s.clear();
	if removed > 0 {
		out.ok = true;
		format(out.s, "nested duplicates removed");
	} else {
		gold_fail(g, "no duplicate values found");
		out.ok = false;
		format(out.s, "error: no duplicates found");
	}
	g.steps += g.n;
	out
}
@end
