test: arg=112233,4455
expect: 123
expect: 45
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var d int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = 0;
	var last = -1;
	var k = len - 1;
	while k >= 0 {
		let v = d[k];
		if v != last {
			res = res * 10 + v;
			last = v;
		}
		k--;
	}
	res
}
@end
