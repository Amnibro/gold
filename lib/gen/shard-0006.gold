fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, unique_count, x);
			unique_count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "merged unique values ", unique_count);
	out
}
@end
