fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${max_val};
	var retries = 0;
	while out.i > max_c && retries < 10 {
		out.i -= 2;
		retries++;
	}
	if out.i > max_c {
		gold_fail(g, "counter exceeds ceiling after retries");
		out.ok = false;
	}
	g.steps += retries;
	out.s.clear();
	format(out.s, "counter normalized in ", retries, " attempts");
	out
}
@end
