code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var s = 0;
			while s * s <= x {
				if s * s == x { sq_count++; break; }
				s++;
			}
		}
		g.res[k] = sq_count;
	}
	out.i = sq_count;
	out.ok = sq_count > 0;
	out.s.clear();
	format(out.s, "running squares total: ", sq_count);
	g.steps += g.n;
	out
}
@end
