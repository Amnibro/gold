phrase: normalize difference steps up to {step_max}
phrase: bound adjacent metric steps up to {step_max}
slot: step_max int
test: list=5,20,40 step_max=10
expect: => i=2 r=0.0 ok=true s="steps normalized" errors=0 n=3 res=[5,15,25] cache=0 hits=0
test: list=10,50,90 step_max=15
expect: => i=2 r=0.0 ok=true s="steps normalized" errors=0 n=3 res=[10,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sm = ${step_max};
	var adjusted = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff > sm {
				g.res[i + 1] = g.res[i] + sm;
				adjusted++;
			}
		}
	}
	out.i = adjusted;
	out.s.clear();
	out.s.append("steps normalized");
	g.steps += g.n;
	out
}
@end
