fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		let orig = g.res[i];
		let c_val, hit = gold_cache_get(g, orig);
		if hit {
			sum += c_val;
		} else {
			let res = ${f}(orig);
			gold_cache_put(g, orig, res);
			sum += res;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "evaluated function with cache: ", sum);
	out
}
@end
