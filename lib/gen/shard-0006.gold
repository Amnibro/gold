@entry a85bfd8cb4baf040
kind: step
verb: collect
noun: range
modifier: safely
context: retry
phrase: collect range elements safely within limits {lo} {hi}
phrase: gather range safely between bounds {lo} {hi}
slot: lo int
slot: hi int
test: lo=1 hi=4
expect: => i=4 r=0.0 ok=true s="collected safely 4 items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: lo=10 hi=12
expect: => i=3 r=0.0 ok=true s="collected safely 3 items" errors=0 n=3 res=[10,11,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${lo};
	let stop = ${hi};
	if start > stop || stop - start > 100 {
		gold_fail(g, "unsafe range parameters");
		out.ok = false;
		return out;
	}
	gold_clear(g);
	var cur = start;
	while cur <= stop {
		gold_push(g, cur);
		cur++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected safely ", g.n, " items");
	out
}
@end
