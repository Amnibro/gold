@entry 59142094bae09849
kind: step
verb: rotate
noun: step
modifier: at_most
context: search
phrase: rotate search results at most {limit} steps
phrase: cycle search matches at most {limit} positions
slot: limit int
test: list=1,2,3,4,5 limit=2
expect: => i=2 r=0.0 ok=true s="rotated matches" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 limit=1
expect: => i=1 r=0.0 ok=true s="rotated matches" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let lim = ${limit};
	var steps = lim % g.n;
	if steps < 0 { steps += g.n; }
	for s in steps {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	out.i = steps;
	out.s.clear();
	out.s.append("rotated matches");
	g.steps += steps;
	out
}
@end
