fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${max_retries};
	var err_count = 0;
	for k in g.n {
		if g.res[k] < 0 { err_count++; }
	}
	if err_count <= max_r {
		for k in g.n {
			if g.res[k] < 0 { g.res[k] = 0; }
		}
		out.i = err_count;
		out.ok = true;
		out.s.clear();
		format(out.s, "grouped nested errors within budget");
	} else {
		gold_fail(g, "retry budget exceeded");
		out.ok = false;
		out.i = err_count;
		out.s.clear();
		format(out.s, "error: retry budget exceeded");
	}
	g.steps += g.n;
	out
}
