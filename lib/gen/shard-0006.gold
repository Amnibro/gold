fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var buf int[100] = [0; 100];
	var blen = 0;
	var dropped_min = false;
	var dropped_max = false;
	for i in g.n {
		let x = g.res[i];
		if x == min_val && !dropped_min {
			dropped_min = true;
		} else if x == max_val && !dropped_max {
			dropped_max = true;
		} else if blen < 100 {
			buf[blen] = x;
			blen++;
		}
	}
	gold_clear(g);
	for i in blen { gold_push(g, buf[i]); }
	out.i = blen;
	out.s.clear();
	format(out.s, "trimmed size: ", blen);
	g.steps += g.n;
	out
}
@end
