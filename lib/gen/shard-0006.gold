test: list=5,2,10
expect: => i=3 r=0.0 ok=true s="kept 3 head items up to last" errors=0 n=3 res=[5,2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	let cutoff = g.res[g.n - 1];
	var w = 0;
	for i in g.n - 1 {
		if g.res[i] < cutoff {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.res[w] = cutoff;
	w++;
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "kept ", w, " head items up to last");
	out
}
@end
