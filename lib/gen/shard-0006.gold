test: list=3,8,12 bound=20 f=inc
expect: => i=0 r=0.0 ok=true s="clamped each function result" errors=0 n=3 res=[4,9,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	for i in g.n {
		let y = ${f}(g.res[i]);
		if y > b {
			g.res[i] = b;
			clamped++;
		} else {
			g.res[i] = y;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped each function result");
	out
}
@end
@entry 33f8924336d73890
kind: step
verb: return
noun: primes
modifier: with_cache
context: retry
phrase: return prime retry attempts using cache records
phrase: filter prime retry counts preserving cached results
test: list=4,5,6,7,8,9,11
expect: => i=3 r=0.0 ok=true s="returned cached primes" errors=0 n=3 res=[5,7,11] cache=7 hits=0
test: list=12,13,14,15,17,19
expect: => i=3 r=0.0 ok=true s="returned cached primes" errors=0 n=3 res=[13,17,19] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		var is_p = false;
		if ok {
			is_p = cached == 1;
		} else {
			is_p = core_is_prime(x);
			gold_cache_put(g, x, if is_p { 1 } else { 0 });
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned cached primes");
	out
}
@end
@entry e155095e8fc1f3aa
kind: step
verb: rank
noun: squares
modifier: with_retry
context: retry
phrase: rank squares in retry sequence with attempt budget {budget}
phrase: order square values with retry budget {budget}
slot: budget int
test: list=9,4,16,2 budget=5
expect: => i=3 r=0.0 ok=true s="ranked squares with retry" errors=0 n=4 res=[2,4,9,16] cache=0 hits=0
test: list=25,1,36,5 budget=3
expect: => i=3 r=0.0 ok=true s="ranked squares with retry" errors=0 n=4 res=[1,5,25,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sq_count = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			sq_count++;
		}
	}
	var it = 0;
	var done = false;
	while it < b && !done {
		done = true;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				done = false;
			}
		}
		it++;
	}
	g.steps += it * g.n;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "ranked squares with retry");
	out
}
@end
