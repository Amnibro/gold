fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var total = 0;
	for k in g.n { total += g.res[k]; }
	out.i = total;
	out.s.clear();
	format(out.s, "sorted all total: ", total);
	out
}
