context: transform
phrase: reverse history segment between indices {start} to {finish}
phrase: invert list slice bounded by {start} through {finish}
slot: start int
slot: finish int
test: list=1,2,3,4,5 start=1 finish=3
expect: => i=1 r=0.0 ok=true s="reversed 1 element pairs in slice" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30,40 start=0 finish=2
expect: => i=1 r=0.0 ok=true s="reversed 1 element pairs in slice" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = ${start};
	var right = ${finish};
	if left < 0 { left = 0; }
	if right >= g.n { right = g.n - 1; }
	var count = 0;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
		count++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " element pairs in slice");
	out
}
@end
