	var out = v;
	var found = 0;
	for k in g.n {
		let val, ok = gold_cache_get(g, g.res[k]);
		if ok {
			found++;
		} else {
			gold_cache_put(g, g.res[k], k);
		}
	}
	out.i = found;
	gold_text(out, "traced range with cache");
	g.steps += g.n;
	out
}
@end
