fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let t = ${times};
	var fitted = 0;
	for rep in t {
		var total = 0;
		fitted = 0;
		for k in g.n {
			if total + g.res[k] <= b {
				total += g.res[k];
				fitted++;
			} else {
				break;
			}
		}
	}
	out.i = fitted;
	out.s.clear();
	format(out.s, "measured ", fitted, " items in budget");
	out
}
