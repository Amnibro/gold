code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_diff = 0;
	for i in g.n {
		let orig = g.res[i];
		let transformed = ${f}(orig);
		let d = transformed - orig;
		total_diff += if d < 0 { -d } else { d };
	}
	g.steps += g.n;
	out.i = total_diff;
	out.s.clear();
