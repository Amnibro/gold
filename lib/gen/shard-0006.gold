fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let p = ${passes};
	var mult = 1;
	for i in p { mult *= f; }
	var scaled = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			g.res[k] *= mult;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " odd candidates by ", mult);
	out
}
@end
