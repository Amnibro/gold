code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cur_len = 0;
	var words_seen = 0;
	for c in out.s {
		if c == ' ' {
			if cur_len > 0 {
				var count, hit = gold_cache_get(g, cur_len);
				if hit {
					gold_cache_put(g, cur_len, count + 1);
				} else {
					gold_cache_put(g, cur_len, 1);
				}
				words_seen++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		var count, hit = gold_cache_get(g, cur_len);
		if hit {
			gold_cache_put(g, cur_len, count + 1);
		} else {
			gold_cache_put(g, cur_len, 1);
		}
		words_seen++;
	}
	out.i = g.cn;
	g.steps += words_seen;
	out.s.clear();
	format(out.s, "cached ", g.cn, " unique word lengths");
	out
}
@end
