@entry 6949c84a4de4f020
kind: step
verb: dedupe
noun: minimum
modifier: at_most
context: error
phrase: dedupe minimum errors at most {limit} times
phrase: remove repeated minimum errors up to {limit}
slot: limit int
test: list=2,2,2,5 limit=2
expect: => i=2 r=0.0 ok=true s="minimum deduped at most limit" errors=0 n=2 res=[2,5] cache=0 hits=0
test: list=2,2 limit=-1
expect: => i=0 r=0.0 ok=false s="error: negative limit" errors=1 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 {
		gold_fail(g, "negative limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative limit");
		return out;
	}
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var kept = 0;
	var min_seen = 0;
	for k in g.n {
		if g.res[k] == min_val {
			min_seen++;
			if min_seen == 1 || min_seen > lim + 1 {
				g.res[kept] = g.res[k];
				kept++;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
