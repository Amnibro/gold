fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alpha byte[..100] = [0; 100];
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			alpha[count] = c;
			count++;
		}
	}
	out.s.clear();
	for i in count { out.s.push(alpha[i]); }
	out.i = count;
	g.steps += count + 1;
	out
}
@end
