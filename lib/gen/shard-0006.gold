fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_len = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		let len = j - i;
		if len > max_len { max_len = len; }
		i = j;
	}
	gold_cache_put(g, 0, max_len);
	g.steps += g.n * 2;
	out.i = max_len;
	out.s.clear();
	format(out.s, "max run length in place ", max_len);
	out
}
@end
