fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let divisor = ${d};
	var found = false;
	if divisor != 0 {
		for i in g.n {
			if g.res[i] % 2 == 0 {
				g.res[i] /= divisor;
				out.i = g.res[i];
				found = true;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	format(out.s, "normalized first even value");
	out
}
@end
