@entry 3f10c086b7431642
kind: step
verb: limit
noun: pairs
modifier: nested
context: stats
phrase: limit nested observation pairs to {max_val}
phrase: bound nested adjacent pairs to {max_val}
slot: max_val int
test: list=10,50,20,60 max_val=50
expect: => i=2 r=0.0 ok=true s="pairs limited" errors=0 n=4 res=[10,40,20,30] cache=0 hits=0
test: list=5,20,15,40 max_val=30
expect: => i=1 r=0.0 ok=true s="pairs limited" errors=0 n=4 res=[5,20,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var clamped = 0;
	if g.n >= 2 {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] + g.res[i + 1] > mv {
				g.res[i + 1] = mv - g.res[i];
				clamped++;
			}
			i += 2;
		}
	}
	out.i = clamped;
	out.s.clear();
	out.s.append("pairs limited");
	g.steps += g.n;
	out
}
@end
