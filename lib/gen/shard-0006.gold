fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
		}
		if count > 2 {
			valid = false;
			break;
		}
	}
	out.ok = valid;
	if !valid {
		gold_fail(g, "duplicate count exceeded limit");
		out.s.clear();
		format(out.s, "duplicate validation failed");
	} else {
		out.s.clear();
		format(out.s, "duplicate validation passed");
	}
	out.i = g.n;
	out
}
@end
