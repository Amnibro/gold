code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if g.n == 0 {
		gold_fail(g, "empty list for maximum search");
		out.ok = false;
		return out;
	}
	var max_v = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_v { max_v = g.res[k]; }
	}
	if max_v > ceil {
		gold_fail(g, "maximum error exceeds ceiling");
		out.ok = false;
		out.s.clear();
		out.s.append("maximum above ceiling");
	} else {
		gold_cache_put(g, 0, max_v);
		out.i = max_v;
		out.s.clear();
		format(out.s, "cached maximum error ", max_v);
	}
	g.steps += g.n;
	out
}
@end
