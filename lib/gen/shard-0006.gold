@entry 10a85f195b96fa05
kind: step
verb: dedupe
noun: results
modifier: until
context: search
phrase: dedupe search results until condition {p}
phrase: remove duplicate matches until condition {p}
slot: p pred
test: list=1,1,2,2,3 p=over_100
expect: => i=3 r=0.0 ok=true s="results deduped until condition" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=2,2,4,5,5 p=is_odd
expect: => i=4 r=0.0 ok=true s="results deduped until condition" errors=0 n=4 res=[2,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		if ${p}(g.res[i]) {
			while i < g.n {
				g.res[kept] = g.res[i];
				kept++;
				i++;
			}
			break;
		}
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("results deduped until condition");
	g.steps += g.n;
	out
}
@end
