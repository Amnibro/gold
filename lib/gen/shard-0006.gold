code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_runs = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		let len = j - i;
		gold_cache_put(g, unique_runs, len);
		unique_runs++;
		i = j;
	}
	g.steps += g.n * 2;
	out.i = unique_runs;
	out.s.clear();
	format(out.s, "unique runs paired ", unique_runs);
	out
}
@end
