@entry 71483fa368c34c55
kind: step
verb: rank
noun: suffix
modifier: up_to
context: error
phrase: rank error suffix up to {bound}
phrase: order trailing errors bounded by {bound}
slot: bound int
test: list=50,30,40 bound=2
expect: => i=2 r=0.0 ok=true s="suffix ranked up to bound" errors=0 n=3 res=[50,30,40] cache=0 hits=0
test: list=50,30 bound=-1
expect: => i=0 r=0.0 ok=false s="error: invalid bound" errors=1 n=2 res=[50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b <= 0 {
		gold_fail(g, "invalid bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bound");
		return out;
	}
	var span = if b < g.n { b } else { g.n };
	let start = g.n - span;
	for i in start..g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = span;
	out.s.clear();
	format(out.s, "suffix ranked up to bound");
	g.steps += span;
	out
}
@end
