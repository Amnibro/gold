fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${bound};
	var ok = true;
	var i = 0;
	while i < g.n {
		if !${p}(g.res[i]) { break; }
		if g.res[i] < min_val {
			ok = false;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.ok = ok;
	out.i = i;
	out.s.clear();
	format(out.s, "validated minimum across ", i, " items");
	out
}
@end
