			cur_len++;
		} else {
			if cur_len >= min_len {
				runs_found++;
			}
			cur_len = 1;
		}
	}
	if cur_len >= min_len {
		runs_found++;
	}
	out.i = runs_found;
	out.s.clear();
	out.s.append("counted search runs");
	g.steps += g.n;
