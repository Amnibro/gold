expect: => i=1 r=0.0 ok=true s="kept 1 evens" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var w = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			if kept < limit {
				g.res[w] = g.res[i];
				w++;
				kept++;
			}
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " evens");
	out
}
@end
