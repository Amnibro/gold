fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_digits};
	var tot = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d <= limit { tot += g.res[k]; }
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "digits sum under limit ", tot);
	out
}
