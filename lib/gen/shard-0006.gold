code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let bound = ${limit};
    let count = if g.n < bound { g.n } else { bound };
    var sum = 0;
    for i in count {
        g.res[i] = ${f}(g.res[i]);
        sum += g.res[i];
    }
    out.i = sum;
    g.steps += count + 1;
    out.s.clear();
    format(out.s, "applied function up to limit sum ", sum);
    out
}
