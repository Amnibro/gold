code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var maxes int[256] = [0; 256];
	var others int[256] = [0; 256];
	var nm = 0;
	var no = 0;
	for i in g.n {
		if g.res[i] == max_val {
			maxes[nm] = g.res[i];
			nm++;
		} else {
			others[no] = g.res[i];
			no++;
		}
	}
	for i in nm { g.res[i] = maxes[i]; }
	for i in no { g.res[nm + i] = others[i]; }
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "split ", nm, " maximum elements of value ", max_val);
	out
}
@end
