phrase: invert sequence until maximum value found
test: list=1,3,5,2,4
expect: => i=5 r=0.0 ok=true s="reversed until max 5" errors=0 n=5 res=[5,3,1,2,4] cache=0 hits=0
test: list=10,2,8
expect: => i=10 r=0.0 ok=true s="reversed until max 10" errors=0 n=3 res=[10,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence");
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	let len = max_idx + 1;
	for i in (len / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[len - 1 - i];
		g.res[len - 1 - i] = tmp;
	}
	g.steps += g.n + 1;
	out.i = max_val;
	out.s.clear();
	format(out.s, "reversed until max ", max_val);
	out
}
@end
