noun: number
modifier: recursively
context: error
phrase: group error number recursively by digital root
phrase: recursively reduce error codes to single digit
test: list=48,99
expect: => i=0 r=0.0 ok=true s="reduced to single digits" errors=0 n=2 res=[3,9] cache=0 hits=0
test: list=123,456
expect: => i=0 r=0.0 ok=true s="reduced to single digits" errors=0 n=2 res=[6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for recursive digit grouping");
		out.ok = false;
		return out;
	}
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		while x >= 10 {
			var s = 0;
			while x > 0 { s += x % 10; x /= 10; }
			x = s;
		}
		g.res[k] = x;
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("reduced to single digits");
	out
}
@end
