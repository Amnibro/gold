slot: min_sum int
test: list=15,22,48 min_sum=6
expect: => i=2 r=0.0 ok=true s="cached 2 items with sufficient digit sum" errors=0 n=3 res=[15,22,48] cache=2 hits=0
test: list=10,12 min_sum=5
expect: => i=0 r=0.0 ok=true s="cached 0 items with sufficient digit sum" errors=0 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	var matched = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s >= ms {
			gold_cache_put(g, matched, g.res[k]);
			matched++;
		}
	}
	out.i = matched;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached ", matched, " items with sufficient digit sum");
	out
}
@end
