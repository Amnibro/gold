code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var sum = 0;
    for i in g.n {
        sum += g.res[i];
    }
    if g.n > 0 && sum > 0 {
        let last = g.res[g.n - 1];
        out.r = (last as real * 100.0) / (sum as real);
    }
    out.i = sum;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "normalized total with sum ", sum);
    out
}
@end
