code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for counter sum");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: empty list for counter sum");
