@entry 9cc31a0af911d972
kind: step
verb: dedupe
noun: tally
modifier: each
context: error
phrase: dedupe tally for each error item
phrase: remove duplicate tally counts for each entry
test: list=2,2,3,4,4,4
expect: => i=3 r=0.0 ok=true s="duplicate tally removed" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="error: empty tally" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty tally");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "duplicate tally removed");
	g.steps += g.n;
	out
}
@end
