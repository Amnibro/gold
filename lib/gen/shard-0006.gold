code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var start = g.n - c;
	if start < 0 { start = 0; }
	let kept = g.n - start;
	for i in kept {
		g.res[i] = g.res[start + i];
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	out.s.append("suffix collected");
	g.steps += kept;
	out
}
@end
