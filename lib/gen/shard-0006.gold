	var out = v;
	var vcount = 0;
	var buf byte[..100] = [0; 100];
	var blen = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_v = (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u');
		if is_v {
			if vcount < 2 {
				buf[blen] = c;
				blen++;
				vcount++;
			}
		} else {
			buf[blen] = c;
			blen++;
		}
	}
	out.s.clear();
	for i in blen { out.s.push(buf[i]); }
	out.i = vcount;
	g.steps += blen;
	out
}
@end
