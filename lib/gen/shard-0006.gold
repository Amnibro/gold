fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var total = 0;
	for k in g.cn {
		if g.cv[k] >= th { total += g.cv[k]; }
	}
	out.i = total;
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "memo sum at least threshold is ", total);
	out
}
@end
