slot: times int
test: list=10,20,30 times=2
expect: => i=17 r=0.0 ok=true s="normalized average over 2 rounds" errors=0 n=3 res=[17,20,22] cache=0 hits=0
test: list=5,15 times=1
expect: => i=7 r=0.0 ok=true s="normalized average over 1 rounds" errors=0 n=2 res=[7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if g.n == 0 || rep <= 0 {
		gold_fail(g, "invalid normalize parameters");
		out.ok = false;
		return out;
	}
	for r in rep {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		let avg = sum / g.n;
		for k in g.n { g.res[k] = (g.res[k] + avg) / 2; }
	}
	g.steps += rep * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "normalized average over ", rep, " rounds");
	out
}
@end
