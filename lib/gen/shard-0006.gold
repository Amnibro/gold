fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] + g.res[i + 1] > 100 {
				valid = false;
				break;
			}
		}
	}
	out.ok = valid;
	if !valid {
		gold_fail(g, "window sum exceeded ceiling");
		out.s.clear();
		format(out.s, "ceiling violated");
	} else {
		out.s.clear();
		format(out.s, "window verified");
	}
	out.i = g.n;
	out
}
