fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "retained ", w, " unique elements");
	out
}
