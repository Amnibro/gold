slot: min_cnt int
test: list=5,5,10,10,15,15 min_cnt=4
expect: => i=6 r=0.0 ok=true s="paired 6 duplicate elements" errors=0 n=6 res=[5,5,10,10,15,15] cache=0 hits=0
