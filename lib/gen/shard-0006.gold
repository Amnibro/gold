code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var found_gap = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > th {
			found_gap = abs_diff;
			gold_cache_put(g, i, abs_diff);
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = found_gap;
	out.s.clear();
	format(out.s, "scanned first gap ", found_gap);
	out
}
@end
