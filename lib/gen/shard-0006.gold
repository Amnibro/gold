code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] == tgt {
			idx = k;
			break;
		}
		k--;
	}
	if idx >= 0 {
		out.ok = true;
		out.i = idx;
		out.s.clear();
		format(out.s, "found target at reverse index ", idx);
	} else {
		out.ok = false;
		out.i = -1;
		out.s.clear();
		out.s.append("target not found in sequence");
	}
	g.steps += g.n;
	out
}
@end
