fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_idx};
	var paired = 0;
	var i = 0;
	while i + 1 < g.n && i < stop {
		gold_cache_put(g, g.res[i], g.res[i + 1]);
		paired++;
