fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var adjusted = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff < 2 {
				g.res[i + 1] = g.res[i] + 2;
				adjusted++;
			}
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped pair adjustments: ", adjusted);
	out
}
