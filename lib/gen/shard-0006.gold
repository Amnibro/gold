fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var count = 0;
	for k in g.n {
		if ${p}(g.res[k]) { count++; }
	}
	if count <= limit {
		out.ok = true;
		out.s.clear();
		out.s.append("matching items within allowed limit");
	} else {
		out.ok = false;
		out.s.clear();
		format(out.s, "matching items ", count, " exceed limit");
	}
	out.i = count;
	g.steps += g.n;
	out
}
