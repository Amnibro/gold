phrase: scale last square element by multiplier {mult}
phrase: multiply final perfect square by factor {mult}
slot: mult int
test: list=2,9,5,16 mult=3
expect: => i=3 r=0.0 ok=true s="scaled square at index 3" errors=0 n=4 res=[2,9,5,48] cache=0 hits=0
test: list=3,7,11 mult=2
expect: => i=-1 r=0.0 ok=true s="no square found to scale" errors=0 n=3 res=[3,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${mult};
	var last_sq = -1;
	var i = g.n - 1;
	while i >= 0 {
		if core_is_square(g.res[i]) {
			last_sq = i;
			g.res[i] = g.res[i] * factor;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = last_sq;
	out.s.clear();
	if last_sq >= 0 {
		format(out.s, "scaled square at index ", last_sq);
	} else {
		out.s.append("no square found to scale");
	}
	out
}
@end
