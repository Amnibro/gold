		var cur_max = g.res[0];
		for k in 1..g.n {
			if g.res[k] > cur_max { cur_max = g.res[k]; }
			g.res[k] = cur_max;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "running maximum joined");
	out
}
@end
