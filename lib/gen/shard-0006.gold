	let req_gap = ${min_gap};
	var pair_count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d >= req_gap {
			pair_count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "found ", pair_count, " pairs with gap");
	out
}
