@entry 245ed8e25bf1c1d3
kind: step
verb: dedupe
noun: tail
modifier: last
context: loop
phrase: dedupe tail last segment of {count} items
phrase: clean dedupe tail last block of {count} values
slot: count int
test: list=1,2,3,3,4 count=3
expect: => i=4 r=0.0 ok=true s="deduped tail" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,20 count=2
expect: => i=2 r=0.0 ok=true s="deduped tail" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let st = if g.n >= c { g.n - c } else { 0 };
	var kept = st;
	var i = st;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var j = st;
		while j < kept {
			if g.res[j] == val { seen = true; }
			j++;
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped tail");
	out
}
@end
