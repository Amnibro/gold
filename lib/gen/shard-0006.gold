code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough retry results to sort");
		out.ok = false;
		return out;
	}
	for i in g.n {
		if i % 2 == 1 {
			g.res[i] = ${f}(g.res[i]);
		}
	}
	for i in g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j += 2;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted every other item");
	out
}
@end
