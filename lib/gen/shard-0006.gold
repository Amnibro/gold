code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("too few elements");
		return out;
	}
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			gold_fail(g, "list not sorted");
			out.ok = false;
			out.s.clear();
			out.s.append("unsorted error list");
			return out;
		}
	}
	let first = g.res[0];
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.s.clear();
	out.s.append("shifted sorted loop");
	out
}
@end
