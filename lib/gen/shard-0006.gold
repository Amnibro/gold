code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_v = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_v { max_v = g.res[k]; }
	}
	g.res[0] = max_v;
	g.n = 1;
	out.i = max_v;
	out.s.clear();
	format(out.s, "folded maximum in place");
	out
}
@end
