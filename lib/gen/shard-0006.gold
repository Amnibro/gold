expect: => i=4 r=0.0 ok=true s="deduped head last: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var w = 0;
		for i in g.n - 1 {
			if g.res[i] != last_val {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.res[w] = last_val;
		w++;
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped head last: ", g.n);
	out
}
@end
