@entry 32c952a6d594413e
kind: step
verb: dedupe
noun: window
modifier: up_to
context: error
phrase: dedupe within window up to span {span}
phrase: remove duplicates within window span {span}
phrase: purge duplicate entries in window of size {span}
slot: span int
test: list=10,20,10,30 span=3
expect: => i=1 r=0.0 ok=true s="deduped within window span" errors=0 n=4 res=[10,20,-1,30] cache=0 hits=0
test: list=10,20,30,40 span=3
expect: => i=0 r=0.0 ok=false s="error: no window duplicates" errors=1 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp < 2 || g.n < 2 {
		gold_fail(g, "invalid window span");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid window span");
		return out;
	}
	var dups = 0;
	for i in g.n {
		let limit = if (i + sp) < g.n { i + sp } else { g.n };
		for j in (i + 1)..limit {
			if g.res[i] == g.res[j] && g.res[j] != -1 {
				g.res[j] = -1;
				dups++;
			}
		}
	}
	out.i = dups;
	out.s.clear();
	if dups > 0 {
		out.ok = true;
		format(out.s, "deduped within window span");
	} else {
		gold_fail(g, "no window duplicates found");
		out.ok = false;
		format(out.s, "error: no window duplicates");
	}
	g.steps += g.n;
	out
}
@end
@entry dfc5cbb889a162e9
kind: step
verb: sort
noun: subfunction
modifier: until
context: error
phrase: sort subfunction results until threshold {limit}
phrase: sort values until reaching bound {limit}
phrase: order subfunction output until limit {limit}
slot: limit int
test: list=9,3,7 limit=10
expect: => i=9 r=0.0 ok=true s="sorted until limit" errors=0 n=3 res=[3,7,9] cache=0 hits=0
test: list=9,3,15 limit=10
expect: => i=15 r=0.0 ok=false s="error: limit exceeded" errors=1 n=3 res=[3,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty list to sort");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let max_val = g.res[g.n - 1];
	out.i = max_val;
	out.s.clear();
	if max_val <= lim {
		out.ok = true;
		format(out.s, "sorted until limit");
	} else {
		gold_fail(g, "sorted elements exceeded limit");
		out.ok = false;
		format(out.s, "error: limit exceeded");
	}
	g.steps += g.n;
	out
}
@end
