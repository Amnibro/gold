@entry 16d949f445859412
kind: step
verb: group
noun: average
modifier: up_to
context: compare
phrase: group elements comparing against average up to limit {limit}
phrase: partition values below average up to cap {limit}
slot: limit int
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="grouped 2 items below average" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15 limit=5
expect: => i=1 r=0.0 ok=true s="grouped 1 items below average" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty results for average grouping");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var count = 0;
	for k in g.n {
		if g.res[k] < avg && count < lim {
			count++;
		}
	}
	out.i = count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "grouped ", count, " items below average");
	out
}
@end
