fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	var found = false;
	while idx < g.n {
		if ${p}(g.res[idx]) {
			found = true;
			idx++;
			break;
		}
		idx++;
	}
	if !found {
		gold_fail(g, "validation predicate never matched");
		out.ok = false;
		return out;
	}
	g.n = idx;
	g.steps += idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "validated numbers until match");
	out
}
@end
