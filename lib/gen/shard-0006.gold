fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var pairs_checked = 0;
	for i in g.n - 1 {
		let pair_sum = g.res[i] + g.res[i + 1];
		if !${p}(pair_sum) {
			gold_fail(g, "nested pair check failed");
			out.ok = false;
			return out;
		}
		pairs_checked++;
	}
	out.i = pairs_checked;
	out.s.clear();
	out.s.append("nested pairs valid");
	g.steps += pairs_checked;
	out
}
@end
