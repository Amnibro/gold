fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_g = ${max_gap};
	if g.n < 2 {
		out.s.clear();
		out.s.append("too few elements for gap check");
		return out;
	}
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d > max_g {
			gold_fail(g, "adjacent gap exceeds limit");
			out.ok = false;
			out.s.clear();
			out.s.append("excessive gap detected");
			return out;
		}
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("all adjacent gaps valid");
	out
}
@end
