@entry e275cbb25abef3c6
kind: step
verb: dedupe
noun: history
modifier: sorted
context: list
phrase: dedupe history sorted order remove duplicates
phrase: sort list eliminate repeated values
test: list=5,1,5,3,1
expect: => i=3 r=0.0 ok=true s="deduped sorted: 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=9,2
expect: => i=2 r=0.0 ok=true s="deduped sorted: 2" errors=0 n=2 res=[2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var buf int[100] = [0; 100];
	var blen = 0;
	for i in g.n {
		if blen == 0 || buf[blen - 1] != g.res[i] {
			buf[blen] = g.res[i];
			blen++;
		}
	}
	gold_clear(g);
	for i in blen { gold_push(g, buf[i]); }
	out.i = blen;
	out.s.clear();
	format(out.s, "deduped sorted: ", blen);
	g.steps += g.n;
	out
}
@end
