phrase: truncate suffix elements in place to {max_len}
slot: max_len int
test: list=1,2,3,4,5 max_len=3
expect: => i=3 r=0.0 ok=true s="limited suffix to 3 items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20 max_len=4
expect: => i=2 r=0.0 ok=true s="limited suffix to 2 items" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if lim <= 0 {
		gold_fail(g, "non positive suffix limit");
		out.ok = false;
		return out;
	}
	if g.n > lim {
		let offset = g.n - lim;
		for k in lim {
			g.res[k] = g.res[offset + k];
		}
		g.n = lim;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited suffix to ", g.n, " items");
	out
}
@end
