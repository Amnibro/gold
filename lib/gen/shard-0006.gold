expect: => i=0 r=0.0 ok=true s="streak items folded" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var total = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= ml {
			for k in i..j { total += g.res[k]; }
			gold_cache_put(g, g.res[i], len);
		}
		i = j;
	}
	out.i = total;
	out.s.clear();
	out.s.append("streak items folded");
	g.steps += g.n;
	out
}
@end
