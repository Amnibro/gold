@entry e46454cc2e475f21
kind: step
verb: sort
noun: evens
modifier: first
context: search
phrase: sort even search matches first
phrase: partition search results with evens first
test: list=3,4,1,2
expect: => i=4 r=0.0 ok=true s="evens sorted first" errors=0 n=4 res=[2,4,1,3] cache=0 hits=0
test: list=5,8,6,7
expect: => i=4 r=0.0 ok=true s="evens sorted first" errors=0 n=4 res=[6,8,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			let is_even_i = g.res[i] % 2 == 0;
			let is_even_j = g.res[j] % 2 == 0;
			var swap = false;
			if !is_even_i && is_even_j {
				swap = true;
			} else if is_even_i == is_even_j && g.res[i] > g.res[j] {
				swap = true;
			}
			if swap {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	out.s.append("evens sorted first");
	g.steps += g.n;
	out
}
@end
