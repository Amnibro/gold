@entry dd3e56cbcf5cf1b3
kind: step
verb: collect
noun: primes
modifier: at_least
context: sort
phrase: collect sorted prime values at least {bound}
phrase: filter sorted primes greater than or equal to {bound}
slot: bound int
test: list=2,3,5,7,11,13 bound=5
expect: => i=4 r=0.0 ok=true s="collected primes at least bound 4" errors=0 n=4 res=[5,7,11,13] cache=0 hits=0
test: list=2,3,4,5,6,7 bound=7
expect: => i=1 r=0.0 ok=true s="collected primes at least bound 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let lim = ${bound};
    var count = 0;
    var new_n = 0;
    for i in g.n {
        let x = g.res[i];
        var is_prime = x >= 2;
        if x > 2 && x % 2 == 0 {
            is_prime = false;
        } else if x > 2 {
            var d = 3;
            while d * d <= x {
                if x % d == 0 {
                    is_prime = false;
                    break;
                }
                d += 2;
            }
        }
        if is_prime && x >= lim {
            g.res[new_n] = x;
            new_n++;
            count++;
        }
    }
    g.n = new_n;
    out.i = count;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "collected primes at least bound ", count);
    out
}
@end
