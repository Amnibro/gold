test: list=-1,-2,-1,-3
expect: => i=3 r=0.0 ok=true s="kept 3 unique error codes" errors=0 n=3 res=[-1,-2,-3] cache=0 hits=0
test: list=-5,-5
expect: => i=1 r=0.0 ok=true s="kept 1 unique error codes" errors=0 n=1 res=[-5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		if g.res[i] < 0 {
			var seen = false;
			for j in dn {
				if distinct[j] == g.res[i] { seen = true; break; }
			}
			if !seen {
				distinct[dn] = g.res[i];
				dn++;
			}
		}
	}
	gold_clear(g);
	for k in dn { gold_push(g, distinct[k]); }
	g.steps += g.n + dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "kept ", dn, " unique error codes");
	out
}
@end
