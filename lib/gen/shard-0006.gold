code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var total_gap = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		total_gap += diff;
		gold_cache_put(g, i, diff);
	}
	out.i = total_gap;
	out.s.clear();
	out.s.append("gaps folded recursively");
	g.steps += g.n;
	out
}
@end
