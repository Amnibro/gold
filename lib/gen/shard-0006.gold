@entry 97e6121763715680
kind: step
verb: sort
noun: results
modifier: every_other
context: cache
phrase: sort every other result for cache
phrase: order alternate results in cache
test: list=9,2,7,4,5
expect: => i=3 r=0.0 ok=true s="alternate results sorted" errors=0 n=5 res=[5,2,7,4,9] cache=3 hits=0
test: list=8,1,4,3
expect: => i=2 r=0.0 ok=true s="alternate results sorted" errors=0 n=4 res=[4,1,8,3] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		alt[count] = g.res[i];
		count++;
		i += 2;
	}
	for a in count {
		for b in a + 1..count {
			if alt[a] > alt[b] {
				let tmp = alt[a];
				alt[a] = alt[b];
				alt[b] = tmp;
			}
		}
	}
	var idx = 0;
	i = 0;
	while i < g.n {
		g.res[i] = alt[idx];
		gold_cache_put(g, i, alt[idx]);
		idx++;
		i += 2;
	}
	out.i = count;
	out.s.clear();
	out.s.append("alternate results sorted");
	g.steps += g.n;
	out
}
@end
