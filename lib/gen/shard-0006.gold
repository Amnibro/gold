code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("not enough elements for reverse pair compare");
		return out;
	}
	var descending = 0;
	var k = g.n - 1;
	while k > 0 {
		if g.res[k] <= g.res[k - 1] { descending++; }
		k--;
	}
	out.i = descending;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "found ", descending, " descending pairs backward");
	out
}
@end
