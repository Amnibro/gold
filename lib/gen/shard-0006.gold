fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < out.s.len {
		var max_pos = idx;
		for k in idx + 1..out.s.len {
			if out.s[k] > out.s[max_pos] { max_pos = k; }
		}
		if max_pos != idx {
			let tmp = out.s[idx];
			out.s[idx] = out.s[max_pos];
			out.s[max_pos] = tmp;
		}
		idx++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
