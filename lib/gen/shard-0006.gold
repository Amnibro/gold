code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits_before = g.hits;
	for i in g.n {
		let val, hit = gold_cache_get(g, g.res[i]);
		if !hit {
			gold_cache_put(g, g.res[i], i);
		}
	}
	let delta_hits = g.hits - hits_before;
	g.steps += g.n;
	out.i = delta_hits;
	out.s.clear();
	format(out.s, "recorded ", delta_hits, " cache hits");
	out
}
@end
