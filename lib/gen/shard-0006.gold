kind: step
verb: rotate
noun: series
modifier: at_most
context: loop
phrase: rotate series at most {max_shift} slots
phrase: cycle rotate series at most {max_shift} times
slot: max_shift int
test: list=1,2,3,4 max_shift=2
expect: => i=4 r=0.0 ok=true s="rotated series" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=10,20,30 max_shift=1
expect: => i=3 r=0.0 ok=true s="rotated series" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_shift};
	if g.n > 1 && ms > 0 {
		var cnt = ms % g.n;
		while cnt > 0 {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[0] = last;
			cnt--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated series");
	out
}
@end
