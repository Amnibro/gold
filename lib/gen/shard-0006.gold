code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var min_val = 999999;
	for k in g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var count = 0;
	for k in g.n {
		if g.res[k] == min_val { count++; }
	}
	out.ok = count == exp;
	out.i = count;
	gold_text(out, "checked minimum times");
	g.steps += g.n;
	out
}
@end
