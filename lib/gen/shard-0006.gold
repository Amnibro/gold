code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	if g.n > 1 {
		var k = 0;
		while k < g.n - 1 {
			if g.res[k] >= g.res[k + 1] { sorted = false; }
			k++;
		}
	}
	g.steps += g.n;
	out.ok = sorted;
	out.i = if sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "sorted order ", out.i);
	out
}
@end
