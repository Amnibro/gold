fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_rank_score = 0;
	if g.n >= 3 {
		for i in 2 .. g.n {
			var r = 1;
			if g.res[i - 1] < g.res[i] { r++; }
			if g.res[i - 2] < g.res[i] { r++; }
			total_rank_score += r;
		}
	}
	out.i = total_rank_score;
	out.s.clear();
	format(out.s, "running window rank score: ", total_rank_score);
	out
}
@end
