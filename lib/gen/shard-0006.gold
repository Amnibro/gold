@entry bec2d4d7ac30c652
kind: step
verb: limit
noun: odds
modifier: pairwise
context: filter
phrase: limit odds pairwise neighbors
phrase: restrict odds pairwise adjacent
test: list=1,3,2,5,7
expect: => i=3 r=0.0 ok=true s="limited odds 3" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=2,4,6
expect: => i=3 r=0.0 ok=true s="limited odds 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "limited odds ", g.n);
		return out;
	}
	var kept = 1;
	var k = 1;
	while k < g.n {
		let prev_odd = g.res[kept - 1] % 2 != 0;
		let cur_odd = g.res[k] % 2 != 0;
		if !(prev_odd && cur_odd) {
			g.res[kept] = g.res[k];
			kept++;
		}
		k++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited odds ", kept);
	out
}
@end
