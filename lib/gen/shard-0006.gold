@entry 817ee585ec694c4e
kind: step
verb: find
noun: results
modifier: sorted
context: sort
phrase: search for {target} within verified sorted results
phrase: locate value {target} among sorted output items
slot: target int
test: list=11,22,33,44 target=33
expect: => i=2 r=0.0 ok=true s="binary search sorted index 2" errors=0 n=4 res=[11,22,33,44] cache=0 hits=0
test: list=5,10,15,20 target=12
expect: => i=-1 r=0.0 ok=false s="binary search sorted index -1" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let goal = ${target};
    var low = 0;
    var high = g.n - 1;
    var found_idx = -1;
    while low <= high {
        let mid = (low + high) / 2;
        if g.res[mid] == goal {
            found_idx = mid;
            break;
        } else if g.res[mid] < goal {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    out.ok = (found_idx >= 0);
    out.i = found_idx;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "binary search sorted index ", found_idx);
    out
}
@end
@entry c5cf7779016df9a9
kind: step
