code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = 0;
	if g.n >= 2 {
		var i = 0;
		while i + 1 < g.n {
			let sum = g.res[i] + g.res[i + 1];
			g.res[pairs] = if sum > lim { lim } else { sum };
			pairs++;
			i += 2;
		}
		g.n = pairs;
	}
	out.i = g.n;
	out.s.clear();
	out.s.append("pairs merged with limit");
	g.steps += g.n;
	out
}
@end
