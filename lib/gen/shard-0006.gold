fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var w = 0;
		for i in g.n {
			if g.res[i] % 2 == 0 && w > 0 && g.res[w - 1] == g.res[i] {
				continue;
			}
			g.res[w] = g.res[i];
			w++;
		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped evens count: ", g.n);
	out
}
@end
