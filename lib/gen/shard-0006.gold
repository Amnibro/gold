fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clamped = 0;
	if g.n > 0 {
		var start = if g.n > 2 { g.n - 2 } else { 0 };
		for i in start .. g.n {
			if g.res[i] > 50 {
				g.res[i] = 50;
				clamped++;
			}
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped suffix: ", clamped);
	out
}
