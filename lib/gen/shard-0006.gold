@entry 6959c18826d36acd
kind: step
verb: split
noun: subfunction
modifier: nested
context: stats
phrase: split data using subfunction {f} nested
phrase: partition samples with subfunction {f} nested
slot: f fn
test: list=3,8,12,2 f=double
expect: => i=2 r=0.0 ok=true s="subfunction partitioned" errors=0 n=4 res=[8,12,3,2] cache=0 hits=0
test: list=5,10,15,2 f=inc
expect: => i=2 r=0.0 ok=true s="subfunction partitioned" errors=0 n=4 res=[10,15,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left int[512] = [0; 512];
	var right int[512] = [0; 512];
	var ln = 0;
	var rn = 0;
	for k in g.n {
		let score = ${f}(g.res[k]);
		if score > 10 {
			left[ln] = g.res[k];
			ln++;
		} else {
			right[rn] = g.res[k];
			rn++;
		}
	}
	for k in ln {
		g.res[k] = left[k];
	}
	for k in rn {
		g.res[ln + k] = right[k];
	}
	out.i = ln;
	out.s.clear();
	out.s.append("subfunction partitioned");
	g.steps += g.n;
	out
}
@end
@entry dd1b3c6a50ef27f7
kind: step
