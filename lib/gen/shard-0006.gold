fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	var max_val = -999999;
	if g.n == 0 {
		min_val = 0;
		max_val = 0;
	} else {
		for i in g.n {
			if g.res[i] < min_val { min_val = g.res[i]; }
			if g.res[i] > max_val { max_val = g.res[i]; }
		}
	}
	out.s.clear();
	format(out.s, "range: ", min_val, "..", max_val);
	out.i = max_val - min_val;
	out
}
