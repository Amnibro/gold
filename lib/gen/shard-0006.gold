test: list=10,20,25 threshold=10
expect: => i=5 r=0.0 ok=true s="last step delta 5" errors=0 n=3 res=[10,20,25] cache=0 hits=0
test: list=10,20,40 threshold=10
expect: => i=20 r=0.0 ok=false s="last step delta 20" errors=1 n=3 res=[10,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		gold_fail(g, "insufficient elements for step");
		out.ok = false;
		return out;
	}
	let diff = g.res[g.n - 1] - g.res[g.n - 2];
	let abs_diff = if diff < 0 { -diff } else { diff };
	let ok = abs_diff <= th;
	if !ok {
		gold_fail(g, "step delta too large");
	}
	g.steps += g.n + 1;
	out.i = abs_diff;
	out.ok = ok;
	out.s.clear();
	format(out.s, "last step delta ", abs_diff);
	out
}
@end
