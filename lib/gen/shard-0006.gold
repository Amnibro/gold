fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		g.res[w] = pair_sum;
		w++;
		i += 2;
	}
	g.n = w;
	if g.n > 1 {
		for p in g.n {
			for q in g.n - 1 {
				if g.res[q] > g.res[q + 1] {
					let tmp = g.res[q];
					g.res[q] = g.res[q + 1];
					g.res[q + 1] = tmp;
				}
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted pairwise sums: ", g.n);
	out
}
@end
