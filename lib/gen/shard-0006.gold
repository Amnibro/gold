code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i + 1, g.res[i]);
	}
	var rev_sum = 0;
	var i = g.cn;
	while i > 0 {
		i--;
		rev_sum += g.cv[i];
