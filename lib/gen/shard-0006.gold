fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var i = 0;
	var merged = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			g.res[w] = g.res[i] * 2;
			w++;
			merged++;
			i += 2;
		} else {
			g.res[w] = g.res[i];
			w++;
			i++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged ", merged, " pairwise streaks");
	out
}
@end
