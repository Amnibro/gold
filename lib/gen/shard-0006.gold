fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid duplicate limit");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for k in g.n {
		var count = 0;
		for j in kept {
			if g.res[j] == g.res[k] { count++; }
		}
		if count < lim {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " elements under duplicate cap");
	out
}
@end
