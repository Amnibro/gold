code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	for i in g.n {
		var cnt = 0;
		for j in g.n { if g.res[j] == g.res[i] { cnt++; } }
		dups[i] = if cnt >= 2 { 2 } else { 1 };
	}
	var scaled = 0;
	for k in g.n {
		if dups[k] > 1 {
			g.res[k] *= dups[k];
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " duplicate candidates");
	out
}
@end
