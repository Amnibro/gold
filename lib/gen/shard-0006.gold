expect: => i=2 r=0.0 ok=true s="kept 2 values" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let allowed_fails = ${retries};
	var fails = 0;
	var kept = 0;
	var write_idx = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			g.res[write_idx] = g.res[i];
			write_idx++;
			kept++;
		} else if fails < allowed_fails {
			g.res[write_idx] = g.res[i];
			write_idx++;
			fails++;
			kept++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " values");
	out
}
@end
