fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var pairs = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		pairs++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "rotated streak pairwise");
	out
}
