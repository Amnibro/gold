expect: => i=2 r=0.0 ok=true s="half mass idx: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,10,15
expect: => i=1 r=0.0 ok=true s="half mass idx: 1" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let half = total / 2;
	var run = 0;
	var split_idx = -1;
	for i in g.n {
		run += g.res[i];
		if run >= half {
			split_idx = i;
			break;
		}
	}
	out.i = split_idx;
	out.s.clear();
	format(out.s, "half mass idx: ", split_idx);
	g.steps += g.n;
	out
}
@end
