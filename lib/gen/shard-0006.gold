code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_drop};
	if md <= 0 || md > g.n {
		gold_fail(g, "zero drop limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: zero drop limit");
		return out;
	}
	let new_n = g.n - md;
	for k in new_n {
		g.res[k] = g.res[k + md];
	}
	g.n = new_n;
	out.i = md;
	out.ok = true;
	out.s.clear();
	format(out.s, "window items dropped");
	g.steps += md;
	out
}
