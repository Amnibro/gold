fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	let mid = g.res[g.n / 2];
	out.i = mid;
	out.s.clear();
	format(out.s, "median item: ", mid);
	g.steps += g.n;
	out
