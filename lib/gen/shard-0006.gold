@entry 1f3d1c2c6115cda9
kind: step
verb: swap
noun: primes
modifier: running
context: cache
phrase: swap running prime numbers in sequence
phrase: exchange adjacent prime values in list
test: list=2,3,4,5
expect: => i=1 r=0.0 ok=true s="swapped running primes count 1" errors=0 n=4 res=[3,2,4,5] cache=1 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="swapped running primes count 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_p = -1;
	var second_p = -1;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		for d in 2..x {
			if d * d <= x && x % d == 0 { is_p = false; break; }
		}
		if is_p {
			if first_p == -1 { first_p = i; }
			else if second_p == -1 { second_p = i; break; }
		}
	}
	var swapped = 0;
	if first_p != -1 && second_p != -1 {
		let tmp = g.res[first_p];
		g.res[first_p] = g.res[second_p];
		g.res[second_p] = tmp;
		gold_cache_put(g, g.res[first_p], g.res[second_p]);
		swapped = 1;
	}
	g.steps += g.n * 5;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped running primes count ", swapped);
	out
}
@end
