fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements to normalize");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n {
		if k % 2 == 1 && g.res[k] % 2 != 0 {
			g.res[k] += 1;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "normalized ", count, " odd entries");
	out
}
@end
