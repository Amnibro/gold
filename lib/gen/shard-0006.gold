@entry 72d2766f8f4e5ad2
kind: step
verb: return
noun: series
modifier: pairwise
context: stats
phrase: return series pairwise compute absolute adjacent differences
phrase: calculate consecutive observation deltas in dataset
test: list=10,20,25
expect: => i=2 r=0.0 ok=true s="deltas: 2" errors=0 n=5 res=[10,20,25,10,5] cache=0 hits=0
