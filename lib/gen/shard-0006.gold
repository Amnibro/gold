expect: => i=2 r=0.0 ok=true s="bn" errors=0 n=0 res=[] cache=0 hits=0
test: text="cherry"
expect: => i=4 r=0.0 ok=true s="chry" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cons byte[..100] = [0; 100];
	var clen = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_v = (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == ' ');
		if !is_v && c >= 'a' && c <= 'z' {
			var exists = false;
			for j in clen {
				if cons[j] == c { exists = true; break; }
			}
			if !exists && clen < 100 {
				cons[clen] = c;
				clen++;
			}
		}
	}
	for i in clen {
		for j in i + 1..clen {
			if cons[i] > cons[j] {
				let t = cons[i];
				cons[i] = cons[j];
				cons[j] = t;
			}
		}
	}
	out.s.clear();
	for i in clen { out.s.push(cons[i]); }
	out.i = clen;
	g.steps += clen + 1;
	out
}
@end
