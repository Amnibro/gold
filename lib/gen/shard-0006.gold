fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list to normalize");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	if max_val <= 0 {
		gold_fail(g, "cannot normalize non positive list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non positive maximum");
		return out;
	}
	for k in g.n {
		g.res[k] = g.res[k] / max_val;
	}
	out.i = max_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized list safely");
	g.steps += g.n;
	out
}
