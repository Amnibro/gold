test: list=1,2,3 min_dups=2
expect: => i=0 r=0.0 ok=false s="error: insufficient duplicates found" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_dups};
	var dups = 0;
	var i = 0;
	while i < g.n {
		var count = 0;
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] { count++; }
		}
		if count >= md {
			dups = count;
			break;
		}
		i++;
	}
	out.i = dups;
	out.s.clear();
	if dups >= md {
		out.ok = true;
		format(out.s, "collected duplicates meeting threshold");
	} else {
		gold_fail(g, "insufficient duplicates found");
		out.ok = false;
		format(out.s, "error: insufficient duplicates found");
	}
	g.steps += g.n;
	out
}
@end
