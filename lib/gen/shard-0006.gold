@entry 600ce1c707bca2d7
kind: step
verb: reverse
noun: pairs
modifier: first
context: retry
phrase: reverse first pairs of elements count {pairs}
phrase: invert initial element pairs count {pairs}
slot: pairs int
test: list=1,2,3,4,5 pairs=2
expect: => i=2 r=0.0 ok=true s="reversed first pairs 2" errors=0 n=5 res=[2,1,4,3,5] cache=2 hits=0
test: list=10,20 pairs=1
expect: => i=1 r=0.0 ok=true s="reversed first pairs 1" errors=0 n=2 res=[20,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pairs};
	var swapped = 0;
	var k = 0;
	while k < p && 2 * k + 1 < g.n {
		let idx1 = 2 * k;
		let idx2 = 2 * k + 1;
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		gold_cache_put(g, k, g.res[idx1]);
		swapped++;
		k++;
	}
	g.steps += swapped * 2 + 1;
	out.i = swapped;
	out.s.clear();
	format(out.s, "reversed first pairs ", swapped);
	out
}
@end
