fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept byte[>..] = [];
	for c in out.s {
		var found = false;
		for k in kept {
			if k == c { found = true; }
		}
		if !found { kept.push(c); }
	}
	out.s.clear();
	out.s.append(kept);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
