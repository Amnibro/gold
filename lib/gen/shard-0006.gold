fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var merged = 0;
	for i in g.n {
		if ${stop}(g.res[i]) {
			break;
		}
		total += g.res[i];
		merged++;
	}
	g.steps += merged;
	out.i = total;
	out.s.clear();
	format(out.s, "merged items sum: ", total);
	out
}
