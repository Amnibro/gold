code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rep};
	if r <= 0 {
		gold_fail(g, "invalid split repetitions");
		out.ok = false;
		return out;
	}
	for k in g.n {
		for i in r {
			g.res[k] /= 2;
		}
	}
	out.i = g.n;
	g.steps += r * g.n;
	out.s.clear();
	format(out.s, "split ", g.n, " values repeatedly");
	out
}
@end
