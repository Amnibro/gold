@entry 94b2c3b00d929acb
kind: step
verb: sort
noun: pairs
modifier: with_retry
context: loop
phrase: sort pairs with retry adjacent elements
phrase: order pairs with retry neighboring slots
test: list=4,3,2,1
expect: => i=4 r=0.0 ok=true s="pairs sorted" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,10,3
expect: => i=3 r=0.0 ok=true s="pairs sorted" errors=0 n=3 res=[3,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = false;
	while !sorted {
		sorted = true;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				sorted = false;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairs sorted");
	out
}
@end
@entry 9f289c6f385aa560
kind: step
verb: merge
noun: number
modifier: pairwise
context: search
phrase: merge search numbers pairwise across results
phrase: combine neighbouring candidate pairs into sums
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="merged pairwise into 2 items" errors=0 n=2 res=[30,70] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="merged pairwise into 3 items" errors=0 n=3 res=[3,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_pos = 0;
	var idx = 0;
	while idx + 1 < g.n {
		g.res[write_pos] = g.res[idx] + g.res[idx + 1];
		write_pos++;
		idx += 2;
	}
	if idx < g.n {
		g.res[write_pos] = g.res[idx];
		write_pos++;
	}
	g.n = write_pos;
	out.i = write_pos;
	out.s.clear();
	format(out.s, "merged pairwise into ", write_pos, " items");
	out
}
@end
