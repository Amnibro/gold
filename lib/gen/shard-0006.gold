code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${target};
	if g.n == 0 {
		gold_fail(g, "empty list for head check");
		out.ok = false;
		return out;
	}
	let head = g.res[0];
	if head == exp {
		out.ok = true;
		out.s.clear();
		out.s.append("head matches target value");
	} else {
		out.ok = false;
		out.s.clear();
		out.s.append("head differs from target");
	}
	out.i = head;
	g.steps++;
	out
}
@end
