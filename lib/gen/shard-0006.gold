noun: duplicates
modifier: first
context: compare
phrase: limit duplicates comparing each item to initial occurrences {cap}
phrase: cap frequency of duplicate items to limit {cap}
slot: cap int
test: list=2,2,2,3,3,4 cap=2
expect: => i=5 r=0.0 ok=true s="retained 5 items within duplicate cap" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=5,5,5,5 cap=1
expect: => i=1 r=0.0 ok=true s="retained 1 items within duplicate cap" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for k in g.n {
		var seen = 0;
		for j in kept {
			if g.res[j] == g.res[k] { seen++; }
		}
		if seen < limit {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " items within duplicate cap");
	out
}
@end
