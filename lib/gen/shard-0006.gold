fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var checkpoints = 0;
	let limit = if g.n > 8 { 8 } else { g.n };
	for i in limit {
		for j in limit {
			if (i * j) % 5 == 0 {
				checkpoints++;
			}
		}
	}
	g.steps += limit * limit;
	out.i = checkpoints;
	out.s.clear();
	format(out.s, "nested checkpoints measured: ", checkpoints);
	out
}
@end
