phrase: remove every second duplicate from tail
test: list=100,1,2,1,3,1,4
expect: => i=7 r=0.0 ok=true s="tail dedupe done" errors=0 n=7 res=[100,1,2,1,3,1,4] cache=0 hits=0
test: list=50,3,3,4,4,5
expect: => i=4 r=0.0 ok=true s="tail dedupe done" errors=0 n=4 res=[50,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var w = 1;
		for i in 1 .. g.n {
			if i % 2 == 0 && g.res[i] == g.res[i - 1] {
				continue;
			}
			g.res[w] = g.res[i];
			w++;
		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail dedupe done");
	out
}
@end
