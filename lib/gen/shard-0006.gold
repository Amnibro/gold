@entry 0fd2876b2c7cb186
kind: step
verb: scale
noun: streak
modifier: nested
context: error
phrase: scale streak errors nested multiplier {mult}
phrase: multiply nested error streaks factor {mult}
slot: mult int
test: list=1,1,2,3 mult=2
expect: => i=1 r=0.0 ok=true s="scaled streaks count 1" errors=1 n=4 res=[2,2,2,3] cache=0 hits=0
test: list=1,2,3,4 mult=2
expect: => i=0 r=0.0 ok=true s="scaled streaks count 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var streaks = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		if j - i >= 2 {
			gold_fail(g, "nested streak found");
			for k in i..j { g.res[k] *= m; }
			streaks++;
		}
		i = j;
	}
	g.steps += g.n * 2;
	out.i = streaks;
	out.s.clear();
	format(out.s, "scaled streaks count ", streaks);
	out
}
@end
