@entry 54cc4ad64183a630
kind: step
verb: clamp
noun: checkpoint
modifier: running
context: retry
phrase: clamp running checkpoint totals to ceiling {cap}
phrase: bound running checkpoint accumulator at {cap}
slot: cap int
test: list=10,20,30,40 cap=50
expect: => i=2 r=0.0 ok=true s="clamped running checkpoint" errors=0 n=4 res=[10,20,20,0] cache=0 hits=0
test: list=5,15,25,35 cap=40
expect: => i=2 r=0.0 ok=true s="clamped running checkpoint" errors=0 n=4 res=[5,15,20,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var running = 0;
	var clamped = 0;
	for i in g.n {
		running += g.res[i];
		if running > limit {
			g.res[i] = limit - (running - g.res[i]);
			if g.res[i] < 0 { g.res[i] = 0; }
			running = limit;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped running checkpoint");
	out
}
@end
