@entry 60d1123d8e0c8157
kind: step
verb: swap
noun: squares
modifier: nested
context: cache
phrase: swap square values into cache
phrase: exchange perfect square values in list
test: list=4,9,16,5
expect: => i=1 r=0.0 ok=true s="swapped squares count 1" errors=0 n=4 res=[9,4,16,5] cache=1 hits=0
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="swapped squares count 1" errors=0 n=4 res=[4,2,3,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_sq = -1;
	var second_sq = -1;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		for r in 100 {
			if r * r == x { is_sq = true; break; }
		}
		if is_sq {
			if first_sq == -1 { first_sq = i; }
			else if second_sq == -1 { second_sq = i; break; }
		}
	}
	var swapped = 0;
	if first_sq != -1 && second_sq != -1 {
		let tmp = g.res[first_sq];
		g.res[first_sq] = g.res[second_sq];
		g.res[second_sq] = tmp;
		gold_cache_put(g, g.res[first_sq], g.res[second_sq]);
		swapped = 1;
	}
	g.steps += g.n * 10;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped squares count ", swapped);
	out
}
@end
