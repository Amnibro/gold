code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let th = ${threshold};
	var stored = 0;
	for k in g.n {
		if g.res[k] > th && stored < limit {
			gold_cache_put(g, stored, g.res[k]);
			stored++;
		}
	}
	out.i = stored;
	g.steps += stored;
	out.s.clear();
	format(out.s, "cached ", stored, " elements over threshold");
	out
}
@end
