code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var capped = 0;
	for k in g.n {
		if ${p}(g.res[k]) { break; }
		if g.res[k] > b {
			g.res[k] = b;
			capped++;
		}
	}
	out.i = capped;
	out.s.clear();
	out.s.append("values limited until condition");
	g.steps += g.n;
	out
}
@end
