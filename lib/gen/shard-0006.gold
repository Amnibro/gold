	if g.n == 0 {
		gold_fail(g, "cannot shift head from empty list");
		out.ok = false;
		return out;
	}
	let head = g.res[0];
	gold_cache_put(g, 0, head);
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1];
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = head;
	out.s.clear();
	format(out.s, "shifted head ", head, " to cache");
	out
}
@end
