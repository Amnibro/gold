fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < 0 {
			let mag = -g.res[i];
			if mag > lim {
				g.res[i] = -lim;
				clamped++;
			}
			gold_cache_put(g, i, g.res[i]);
		}
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped error values ", clamped);
	out
}
@end
