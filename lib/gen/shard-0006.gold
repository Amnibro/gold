@entry 558cf671bd6c5b32
kind: step
verb: limit
noun: range
modifier: unique
context: sort
phrase: restrict unique sorted range values to {cap}
phrase: limit distinct elements in sorted range to {cap}
slot: cap int
test: list=1,1,2,2,3,3,4 cap=2
expect: => i=4 r=0.0 ok=true s="limited unique range to 4" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,6,7,7 cap=3
expect: => i=3 r=0.0 ok=true s="limited unique range to 3" errors=0 n=5 res=[5,5,6,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${cap};
    var unique_seen = 0;
    var new_n = 0;
    var prev = 0;
    var has_prev = false;
    for i in g.n {
        let cur = g.res[i];
        if !has_prev || cur != prev {
            unique_seen++;
            prev = cur;
            has_prev = true;
        }
        if unique_seen <= limit {
            g.res[new_n] = cur;
            new_n++;
        }
    }
    g.n = new_n;
    out.i = unique_seen;
    g.steps += g.n + 1;
    out.s.clear();
    format(out.s, "limited unique range to ", unique_seen);
    out
}
@end
