fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var modified = 0;
	for k in g.n {
		let nxt = ${f}(g.res[k]);
		if nxt > th { break; }
		g.res[k] = nxt;
		modified++;
	}
	out.i = modified;
	g.steps += modified;
	out.s.clear();
	format(out.s, "modified ", modified, " results under threshold");
	out
}
@end
@entry de1e393dfbfc1e38
kind: step
verb: run
noun: sequence
modifier: running
context: compare
phrase: run through sequence comparing consecutive element differences
phrase: evaluate whether adjacent differences are uniform
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="uniform step size is 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,7
expect: => i=2 r=0.0 ok=false s="non uniform step differences" errors=0 n=3 res=[1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		out.s.append("uniform sequence by default");
		return out;
	}
	let step_size = g.res[1] - g.res[0];
	var uniform = true;
	for k in 1..g.n - 1 {
		if g.res[k + 1] - g.res[k] != step_size {
			uniform = false;
			break;
		}
	}
	out.ok = uniform;
	out.i = step_size;
	if uniform {
		out.s.clear();
		format(out.s, "uniform step size is ", step_size);
	} else {
		out.s.clear();
		out.s.append("non uniform step differences");
	}
	g.steps += g.n;
	out
}
@end
