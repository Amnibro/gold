@entry c758b0f59c2f1783
kind: step
verb: swap
noun: history
modifier: times
context: search
phrase: swap outer search history elements {times} times
phrase: exchange boundary candidate items for {times} passes
slot: times int
test: list=10,20,30,40 times=2
expect: => i=2 r=0.0 ok=true s="swapped 2 boundary pairs" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
test: list=5,15,25 times=1
expect: => i=1 r=0.0 ok=true s="swapped 1 boundary pairs" errors=0 n=3 res=[25,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	let limit = if t > g.n / 2 { g.n / 2 } else { t };
	for i in limit {
		let opp = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[opp];
		g.res[opp] = tmp;
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "swapped ", limit, " boundary pairs");
	out
}
@end
