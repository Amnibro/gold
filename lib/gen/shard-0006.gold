@entry ac449c10e3fb5cf0
kind: step
verb: drop
noun: tally
modifier: unique
context: retry
phrase: drop unique tally after retry failure
phrase: remove unique tally elements upon retry
phrase: purge unique tally values during retry
test: list=1,2,2,3
expect: => i=1 r=0.0 ok=true s="dropped duplicates from tally" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=false s="error: no duplicates to drop" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for tally drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		} else {
			dropped++;
		}
	}
	g.n = new_n;
	out.i = dropped;
	out.s.clear();
	if dropped > 0 {
		out.ok = true;
		format(out.s, "dropped duplicates from tally");
	} else {
		gold_fail(g, "no duplicates to drop");
		out.ok = false;
		format(out.s, "error: no duplicates to drop");
	}
	g.steps += g.n;
	out
}
@end
@entry 695bd5acb70ec06b
kind: step
verb: group
noun: primes
modifier: every_other
context: retry
phrase: group prime numbers across every other retry step
phrase: collect every other prime candidate upon retry
phrase: check every other prime value during retry
test: list=2,4,3,6,5
expect: => i=3 r=0.0 ok=true s="every other prime valid" errors=0 n=5 res=[2,4,3,6,5] cache=0 hits=0
test: list=4,2,6,3
expect: => i=0 r=0.0 ok=false s="error: non prime at even index" errors=1 n=4 res=[4,2,6,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var primes_count = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if !is_p {
			gold_fail(g, "non prime at even index");
			out.ok = false;
			out.i = idx;
			out.s.clear();
			format(out.s, "error: non prime at even index");
			return out;
		}
		primes_count++;
		idx += 2;
	}
	out.i = primes_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "every other prime valid");
	g.steps += g.n;
	out
}
@end
