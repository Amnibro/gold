code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var write_idx = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "in place deduped: ", write_idx);
	g.steps += g.n;
	out
}
@end
