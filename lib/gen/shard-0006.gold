@entry 3ed186ab4571a0a6
kind: step
verb: rotate
noun: average
modifier: in_reverse
context: search
phrase: rotate search results backwards by average
phrase: cycle search matches in reverse by mean value
test: list=2,4,6
expect: => i=1 r=0.0 ok=true s="rotated matches by mean" errors=0 n=3 res=[4,6,2] cache=0 hits=0
test: list=1,2,9
expect: => i=1 r=0.0 ok=true s="rotated matches by mean" errors=0 n=3 res=[2,9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var shift = avg % g.n;
	if shift < 0 { shift += g.n; }
	for s in shift {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
	}
	out.i = shift;
	out.s.clear();
	out.s.append("rotated matches by mean");
	g.steps += g.n;
	out
}
@end
