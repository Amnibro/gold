test: text="hello" ceiling=0
expect: => i=0 r=0.0 ok=false s="error: zero ceiling allowed" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	if c <= 0 {
		gold_fail(g, "zero ceiling allowed");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: zero ceiling allowed");
		return out;
	}
	var count = 0;
	var idx = 0;
	while idx < out.s.len && count < c {
		let b = out.s[idx];
		if b >= 'a' && b <= 'z' {
			out.s[idx] = (b as int - 32) as byte;
			count++;
		}
		idx++;
	}
	out.i = count;
	out.ok = true;
	g.steps += idx;
	out
}
@end
