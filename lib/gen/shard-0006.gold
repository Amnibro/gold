code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let mid = g.n / 2;
	g.steps += g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "sorted partition size: ", mid);
	out
}
@end
