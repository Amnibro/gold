fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			g.res[w] = x;
			gold_cache_put(g, count, x);
			w++;
			count++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " square numbers");
	out
}
@end
