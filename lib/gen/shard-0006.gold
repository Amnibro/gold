test: list=2,2,2,3,3,4
expect: => i=3 r=0.0 ok=true s="joined nested streaks" errors=0 n=3 res=[6,6,4] cache=0 hits=0
test: list=5,5,1,1,1,2
expect: => i=3 r=0.0 ok=true s="joined nested streaks" errors=0 n=3 res=[10,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			run_len++;
			i++;
		}
		g.res[new_n] = val * run_len;
		new_n++;
		i++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "joined nested streaks");
	out
}
@end
