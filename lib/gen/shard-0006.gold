fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${len};
	var words_count = 0;
	var matched = 0;
	var cur_len = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if cur_len >= min_len { matched++; }
			if cur_len > 0 { words_count++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len >= min_len { matched++; }
	if cur_len > 0 { words_count++; }
	out.i = matched;
	g.steps += words_count;
	out.s.clear();
	format(out.s, "matched ", matched, " words of at least length ", min_len);
	out
}
@end
