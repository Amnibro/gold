code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for last condition");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	let passes = ${p}(last);
	out.ok = passes;
	out.i = last;
	if passes {
		out.s.clear();
		out.s.append("last item satisfies condition");
	} else {
		out.s.clear();
		out.s.append("last item fails condition");
	}
	g.steps++;
	out
}
@end
