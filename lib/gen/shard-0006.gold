	}
	var kept = 0;
	var seen_max = false;
	for k in g.n {
		if g.res[k] == max_val {
			if !seen_max {
				g.res[kept] = g.res[k];
				kept++;
				seen_max = true;
			}
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	gold_cache_put(g, 0, max_val);
	out.i = g.n - kept;
	g.n = kept;
	out.s.clear();
	out.s.append("duplicate max removed");
	g.steps += g.n;
	out
}
@end
@entry 0955e33af38bc930
kind: step
verb: fold
noun: gaps
modifier: with_retry
context: cache
phrase: fold cache gaps with max {max_gap} limit
phrase: accumulate gaps bounded by {max_gap}
slot: max_gap int
test: list=10,15,30,35 max_gap=10
expect: => i=10 r=0.0 ok=true s="gaps folded with retry" errors=0 n=4 res=[10,15,30,35] cache=2 hits=0
test: list=1,2,3 max_gap=5
expect: => i=2 r=0.0 ok=true s="gaps folded with retry" errors=0 n=3 res=[1,2,3] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var sum_gaps = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= mg {
			sum_gaps += diff;
			gold_cache_put(g, i, diff);
		}
	}
	out.i = sum_gaps;
	out.s.clear();
	out.s.append("gaps folded with retry");
	g.steps += g.n;
	out
}
@end
@entry f9aa4b64a07a8141
