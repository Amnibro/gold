fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var loop_idx = -1;
	var i = 0;
	while i < g.n && loop_idx < 0 {
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				loop_idx = i;
				break;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = loop_idx;
	out.ok = loop_idx >= 0;
	out.s.clear();
	format(out.s, "loop at ", loop_idx);
	out
}
@end
