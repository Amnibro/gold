fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	if avg < 0 {
		gold_fail(g, "negative average");
	}
	gold_cache_put(g, 0, avg);
	var scaled = 0;
	for i in g.n {
		if g.res[i] > avg {
			g.res[i] *= m;
			scaled++;
		}
	}
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "scaled above average ", scaled);
	out
}
@end
