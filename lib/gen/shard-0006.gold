@entry 84caff8904425373
kind: step
verb: retry
noun: window
modifier: with_cache
context: aggregate
phrase: retry window with cache sum {size}
phrase: compute window with cache aggregate {size}
slot: size int
test: list=1,2,3,4,5 size=2
expect: => i=4 r=0.0 ok=true s="window cache count 4" errors=0 n=5 res=[1,2,3,4,5] cache=4 hits=0
test: list=10,20 size=1
expect: => i=2 r=0.0 ok=true s="window cache count 2" errors=0 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || w > g.n {
		out.i = 0;
		out.s.clear();
		out.s.append("invalid window size");
		return out;
	}
	var count = 0;
	var i = 0;
	while i + w <= g.n {
		var win_sum = 0;
		var j = 0;
		while j < w {
			win_sum += g.res[i + j];
			j++;
		}
		gold_cache_put(g, count, win_sum);
		count++;
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "window cache count ", count);
	out
}
@end
