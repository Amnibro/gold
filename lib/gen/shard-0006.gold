context: retry
phrase: run suffix calculation with cache lookup
phrase: execute cached suffix retry operation
test: list=10,20,30
expect: => i=60 r=0.0 ok=true s="computed suffix retry value 60" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15
expect: => i=30 r=0.0 ok=true s="computed suffix retry value 30" errors=0 n=2 res=[5,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for suffix calculation");
		out.ok = false;
		return out;
	}
	let tail_val = g.res[g.n - 1];
	var cached, hit = gold_cache_get(g, tail_val);
	if hit {
		out.i = cached;
		out.s.clear();
		out.s.append("cache hit for suffix");
	} else {
		let computed = tail_val * 2;
		gold_cache_put(g, tail_val, computed);
		out.i = computed;
		out.s.clear();
		format(out.s, "computed suffix retry value ", computed);
	}
	g.steps++;
	out
}
@end
