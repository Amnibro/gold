test: list=5,15,25
expect: => i=20 r=0.0 ok=true s="normalized span: 20" errors=0 n=3 res=[0,50,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 { return out; }
    var min_val = g.res[0];
    var max_val = g.res[0];
    for i in 1..g.n {
        if g.res[i] < min_val { min_val = g.res[i]; }
        if g.res[i] > max_val { max_val = g.res[i]; }
    }
    let span = max_val - min_val;
    if span > 0 {
        for i in g.n {
            g.res[i] = ((g.res[i] - min_val) * 100) / span;
        }
    }
    g.steps += g.n;
    out.i = span;
    out.s.clear();
    format(out.s, "normalized span: ", span);
    out
}
@end
