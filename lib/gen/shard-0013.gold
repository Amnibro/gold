fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var increases = 0;
	var prev_digits = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if i > 0 && d > prev_digits { increases++; }
		prev_digits = d;
	}
	g.steps += g.n;
	out.i = increases;
	out.s.clear();
	format(out.s, "running digit increases=", increases);
	out
}
@end
