kind: step
verb: fold
noun: total
modifier: sorted
context: math
phrase: fold total sum after sorting sequence
phrase: sort results accumulating running total
test: list=5,2,8
expect: => i=15 r=0.0 ok=true s="folded sorted total: 15" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=10,30,20
expect: => i=60 r=0.0 ok=true s="folded sorted total: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded sorted total: ", total);
	out
}
@end
