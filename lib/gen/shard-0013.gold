expect: => i=2 r=0.0 ok=true s="measured primes at least threshold count 2" errors=0 n=4 res=[7,13,17,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mv && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { count++; }
		}
