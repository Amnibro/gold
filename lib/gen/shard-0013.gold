@entry d2c8b26d44b5ba1e
kind: step
verb: dedupe
noun: results
modifier: with_retry
context: text
phrase: dedupe consecutive whitespace with retry tracking
phrase: collapse repeated spaces tracking modification count
test: text="a  b   c"
expect: => i=5 r=0.0 ok=true s="a b c" errors=3 n=0 res=[] cache=0 hits=0
test: text="hello world"
expect: => i=11 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp byte[..200] = "";
	var i = 0;
	var retries = 0;
	while i < out.s.len {
		let c = out.s[i];
		temp.push(c);
		if c == ' ' {
			var sp_count = 0;
			while i < out.s.len && out.s[i] == ' ' {
				sp_count++;
				i++;
			}
			if sp_count > 1 {
				retries += sp_count - 1;
			}
		} else {
			i++;
		}
	}
	out.s.clear();
	for b in temp {
		out.s.push(b);
	}
	g.errors += retries;
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
