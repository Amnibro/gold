code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_run_len};
	var kept = 0;
	if g.n > 0 {
		var cur_run = 0;
		var last_val = g.res[0] - 1;
		for i in g.n {
			if g.res[i] == last_val {
				cur_run++;
			} else {
				last_val = g.res[i];
				cur_run = 1;
			}
			if cur_run <= m {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered runs to ", kept, " elements");
	out
}
@end
