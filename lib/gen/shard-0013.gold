code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
			}
		}
	}
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed sorted series count=", g.n);
	out
}
@end
