test: list=1,3,1,5,3 cap=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=7,7,7 cap=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	var seen_odds int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && seen_odds.len < limit {
			var exists = false;
			for s in seen_odds {
				if s == x {
					exists = true;
					break;
				}
			}
			if !exists {
				seen_odds.push(x);
				g.res[write] = x;
				write++;
			}
		} else {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = seen_odds.len;
	out
}
@end
