test: list=2,3,5,8,13,21 threshold=5
expect: => i=2 r=0.0 ok=true s="ran primes at least 5 count 2" errors=0 n=8 res=[2,3,5,8,13,21,5,13] cache=0 hits=0
test: list=7,11,14,17,20,23 threshold=12
expect: => i=2 r=0.0 ok=true s="ran primes at least 12 count 2" errors=0 n=8 res=[7,11,14,17,20,23,17,23] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= th && ${ID}_is_prime(x) {
			count++;
			gold_push(g, x);
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "ran primes at least ", th, " count ", count);
	g.steps += g.n + count + 1;
	out
}
@end
