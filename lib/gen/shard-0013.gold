fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let first = g.res[0];
	let cached, ok = gold_cache_get(g, first);
	var clamped = 0;
	if ok {
		clamped = cached;
	} else {
		clamped = if first > b { b } else { first };
		gold_cache_put(g, first, clamped);
	}
	g.steps += 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped checkpoint with cache is ", clamped);
	out
}
@end
