fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${tail_size};
	var start = g.n - sz;
	if start < 0 { start = 0; }
	var count = 0;
	for k in g.n - start {
		g.res[k] = g.res[start + k];
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tail=", count);
	out
}
