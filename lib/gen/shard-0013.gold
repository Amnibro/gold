@entry 4801f34512bc220a
kind: step
verb: rotate
noun: prefix
modifier: sorted
context: cache
phrase: rotate prefix elements using cached order
phrase: shift initial sorted items with cache
test: list=5,1,3
expect: => i=3 r=0.0 ok=true s="prefix rotated" errors=0 n=3 res=[3,5,1] cache=1 hits=0
test: list=9,2,6,4
expect: => i=4 r=0.0 ok=true s="prefix rotated" errors=0 n=4 res=[4,6,9,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		gold_cache_put(g, 0, g.res[0]);
	}
	if g.n > 1 {
		let first = g.res[0];
		for i in (g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "prefix rotated");
	out
}
@end
