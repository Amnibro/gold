noun: values
modifier: all
context: filter
phrase: rotate values all forward by shift {shift}
phrase: cycle all values forward by amount {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=5 r=0.0 ok=true s="rotated values shift=2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=3 r=0.0 ok=true s="rotated values shift=1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 0 {
		let k = s % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated values shift=", s);
	out
}
@end
@entry 489a52e0a3ac60b2
kind: step
verb: merge
noun: duplicates
modifier: in_place
context: aggregate
phrase: merge duplicates in place within aggregate
phrase: in place merge of duplicate values in aggregate
test: list=2,2,3,4,4,4,5
expect: => i=4 r=0.0 ok=true s="merged duplicate items in place" errors=0 n=4 res=[4,3,12,5] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="merged duplicate items in place" errors=0 n=3 res=[20,20,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var write_idx = 0;
	var cur_val = g.res[0];
	var cur_sum = cur_val;
	for i in 1..g.n {
		let x = g.res[i];
		if x == cur_val {
			cur_sum += x;
		} else {
			g.res[write_idx] = cur_sum;
			write_idx++;
			cur_val = x;
			cur_sum = x;
		}
	}
	g.res[write_idx] = cur_sum;
	write_idx++;
	g.n = write_idx;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged duplicate items in place");
	out
}
@end
