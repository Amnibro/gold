@entry 3cb1666abaef35e7
kind: step
verb: trace
noun: budget
modifier: sorted
context: transform
phrase: trace budget allocation across sorted elements
phrase: track budget consumption over sorted items
slot: budget int
test: list=15,5,25,10,20 budget=40
expect: => i=3 r=0.0 ok=true s="spent 30 of budget 40 across 3 sorted items" errors=0 n=5 res=[5,10,15,20,25] cache=0 hits=0
test: list=30,10,5,25,15 budget=50
expect: => i=3 r=0.0 ok=true s="spent 30 of budget 50 across 3 sorted items" errors=0 n=5 res=[5,10,15,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	// Sort elements first
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var spent = 0;
	var count = 0;
	while count < g.n && spent + g.res[count] <= b {
		spent += g.res[count];
		count++;
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "spent ", spent, " of budget ", b, " across ", count, " sorted items");
	out
}
@end
