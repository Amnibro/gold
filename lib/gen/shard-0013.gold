code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var first_half = 0;
	var second_half = 0;
	for i in mid { first_half += g.res[i]; }
	var j = mid;
	while j < g.n { second_half += g.res[j]; j++; }
	let diff = second_half - first_half;
	gold_cache_put(g, 0, diff);
	gold_push(g, diff);
	out.i = diff;
	out.s.clear();
	format(out.s, "nested memo diff ", diff);
	g.steps += g.n + 1;
	out
}
@end
