	for step in d {
		for i in g.n {
			g.res[i] += (step + 1);
			total += g.res[i];
		}
	}
	g.steps += d * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "nested history sum ", total);
	out
}
