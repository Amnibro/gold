fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let t = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = t;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed sequence: ", g.n);
	out
}
@end
