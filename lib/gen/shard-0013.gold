fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	if g.n > 0 {
		g.res[kept] = g.res[0];
		kept++;
		for i in 1..g.n {
			if g.res[i] != g.res[i - 1] {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped adjacent items: ", kept);
	out
}
