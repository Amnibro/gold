expect: => i=0 r=0.0 ok=true s="paired 0 adjacent elements" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_diff = ${diff};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] <= max_diff {
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n * g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " adjacent elements");
	out
}
