code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for i in g.n {
		var x = g.res[i];
		for _ in d {
			x = x * x;
		}
		g.res[i] = x;
	}
	g.steps += g.n * d + 1;
	out.i = d;
	out.s.clear();
	format(out.s, "recursively squared with depth ", d);
	out
}
@end
