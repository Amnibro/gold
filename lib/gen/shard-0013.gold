code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var found_val = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= avg {
			found_val = g.res[i];
			break;
		}
		i--;
	}
	gold_push(g, found_val);
	g.steps += g.n;
	out.i = found_val;
	out.s.clear();
	format(out.s, "selected average in reverse value ", found_val);
	out
}
@end
