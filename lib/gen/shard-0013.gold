test: list=5,12,2
expect: => i=12 r=0.0 ok=true s="reversed sorted" errors=0 n=3 res=[12,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var lo = 0;
	var hi = g.n - 1;
	while lo < hi {
		let tmp = g.res[lo];
		g.res[lo] = g.res[hi];
		g.res[hi] = tmp;
		lo++;
		hi--;
	}
	g.steps += g.n;
	if g.n > 0 { out.i = g.res[0]; }
	gold_text(out, "reversed sorted");
	out
}
@end
