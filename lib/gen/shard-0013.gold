@entry 5e7697b57d689d46
kind: step
verb: reverse
noun: primes
modifier: with_retry
context: compare
phrase: reverse prime numbers with retry check
phrase: invert primes sequence with retry condition
test: list=2,4,3,6,5
expect: => i=3 r=0.0 ok=true s="reversed primes count=3" errors=0 n=3 res=[5,3,2] cache=0 hits=0
test: list=4,6,8 input=7
expect: => i=1 r=0.0 ok=true s="reversed primes count=1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[32] = [0; 32];
	var pcount = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && pcount < 32 { primes[pcount] = x; pcount++; }
		}
	}
	if pcount == 0 && out.i >= 2 {
		primes[0] = out.i;
		pcount = 1;
	}
	g.n = pcount;
	for i in pcount {
		g.res[i] = primes[pcount - 1 - i];
	}
	g.steps += g.n;
	out.i = pcount;
	out.s.clear();
	format(out.s, "reversed primes count=", pcount);
	out
}
@end
