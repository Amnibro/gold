fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let thresh = g.res[g.n - 1];
	var write_idx = 0;
	for i in g.n {
		if g.res[i] >= thresh {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "retained ", write_idx, " items against last threshold");
	out
}
@end
