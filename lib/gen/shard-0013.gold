fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val == 0 {
		return 1;
	}
	var max_run = 1;
	var cur_run = 1;
	var prev = val % 10;
	val = val / 10;
	while val > 0 {
		var cur = val % 10;
		if cur == prev {
			cur_run++;
			if cur_run > max_run {
				max_run = cur_run;
			}
		} else {
			cur_run = 1;
		}
		prev = cur;
		val = val / 10;
	}
	return max_run;
}
@end
