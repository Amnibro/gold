	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 == 0 && g.res[i+1] % 2 == 0 {
			let tmp = g.res[i];
			g.res[i] = g.res[i+1];
			g.res[i+1] = tmp;
			swaps++;
			i += 2;
