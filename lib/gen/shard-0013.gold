fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var matched = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff <= lim { matched++; }
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched ", matched, " differences");
	out
}
