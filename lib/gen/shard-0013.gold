phrase: rotate sample distribution positions by offset {shift}
phrase: cycle dataset observation order by stride {shift}
test: list=1,2,3,4 shift=1
expect: => i=4 r=0.0 ok=true s="rotated: 4" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=3 r=0.0 ok=true s="rotated: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${shift};
	if g.n > 1 {
		s = s % g.n;
		for step in s {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated: ", g.n);
	out
}
@end
