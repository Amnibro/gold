code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_gap = 0;
	var i = g.n - 1;
	while i > 0 {
		let diff = if g.res[i] > g.res[i-1] { g.res[i] - g.res[i-1] } else { g.res[i-1] - g.res[i] };
		if diff > max_gap { max_gap = diff; }
		i--;
	}
	if max_gap < 5 {
		max_gap *= 2;
	}
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max reverse gap=", max_gap);
	out
}
@end
