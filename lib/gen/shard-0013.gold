@entry 5f4881e10b6462b6
kind: step
verb: collect
noun: squares
modifier: sorted
context: core
phrase: collect square numbers in sorted order
phrase: gather perfect squares sorted ascending
test: list=16,7,9,2,25,4
expect: => i=4 r=0.0 ok=true s="collected 4 sorted squares" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=36,10,49,1
expect: => i=3 r=0.0 ok=true s="collected 3 sorted squares" errors=0 n=3 res=[1,36,49] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq int[512] = [0; 512];
	var nsq = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				sq[nsq] = x;
				nsq++;
			}
		}
	}
	for i in nsq {
		var min_idx = i;
		for j in (i + 1)..nsq {
			if sq[j] < sq[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = sq[i];
			sq[i] = sq[min_idx];
			sq[min_idx] = tmp;
		}
	}
	for i in nsq { g.res[i] = sq[i]; }
	g.n = nsq;
	g.steps += g.n * g.n;
	out.i = nsq;
	out.s.clear();
	format(out.s, "collected ", nsq, " sorted squares");
	out
}
@end
