expect: => i=3 r=0.0 ok=true s="clamped prefix items: 3" errors=0 n=3 res=[50,50,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let cnt = ${count};
	var clamped = 0;
	for i in g.n {
		if i < cnt {
			if g.res[i] > b {
				g.res[i] = b;
			} else if g.res[i] < -b {
				g.res[i] = -b;
			}
			clamped++;
		}
	}
	g.steps += clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped prefix items: ", clamped);
	out
}
@end
