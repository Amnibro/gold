@entry 1f37c7c59dffa994
kind: step
verb: split
noun: cache
modifier: with_cache
context: transform
slot: src_slot int
slot: dest_slot int
phrase: transform split cache with cache slots {src_slot} to {dest_slot}
phrase: divide cached value between slots {src_slot} through {dest_slot}
test: list=10 src_slot=1 dest_slot=2
expect: => i=5 r=0.0 ok=true s="split cached value 10" errors=0 n=2 res=[10,5] cache=2 hits=0
test: list=7 src_slot=3 dest_slot=4
expect: => i=4 r=0.0 ok=true s="split cached value 7" errors=0 n=2 res=[7,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let src = ${src_slot};
	let dst = ${dest_slot};
	var initial_val = if g.n > 0 { g.res[0] } else { 10 };
	let val, found = gold_cache_get(g, src);
	let current = if found { val } else { initial_val };
	let half1 = current / 2;
	let half2 = current - half1;
	gold_cache_put(g, src, half1);
	gold_cache_put(g, dst, half2);
	gold_push(g, half2);
	g.steps += 3;
	out.i = half2;
	out.s.clear();
	format(out.s, "split cached value ", current);
	out
}
@end
@entry 3448b509719dd12d
kind: step
verb: split
noun: words
modifier: sorted
context: transform
phrase: transform split words sorted by length
phrase: extract text words ordered by length count
test: text="a bbb cc"
expect: => i=3 r=0.0 ok=true s="sorted 3 word lengths" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: text="zoo apple"
expect: => i=2 r=0.0 ok=true s="sorted 2 word lengths" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var wlen = 0;
	for i in v.s.len {
		if v.s[i] != ' ' {
			wlen++;
		} else {
			if wlen > 0 {
				gold_push(g, wlen);
				wlen = 0;
			}
		}
	}
	if wlen > 0 {
		gold_push(g, wlen);
	}
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += v.s.len + g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " word lengths");
	out
}
@end
