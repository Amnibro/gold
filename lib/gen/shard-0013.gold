	}
	let mid = g.n / 2;
	var kept = 0;
	for i in mid..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " suffix items");
	out
}
@end
