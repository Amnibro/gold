fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var write = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] <= c {
			g.res[write] = g.res[i];
			g.res[write + 1] = g.res[i + 1];
			write += 2;
		}
		i += 2;
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write / 2;
	out.s.clear();
	format(out.s, "filtered running pairs count=", write / 2);
	out
}
