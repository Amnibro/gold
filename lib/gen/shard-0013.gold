fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n <= 1 {
		return out;
	}
	let shift = if s < 0 { 0 } else { s % g.n };
	for k in shift {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
	}
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated by budget: ", shift);
	out
}
@end
