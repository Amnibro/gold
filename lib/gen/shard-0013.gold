test: list=1,4,3 k=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if g.n <= 1 {
		return out;
	}
	let start = if count > g.n { 0 } else { g.n - count };
	for i in start..g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n - start;
	out
}
@end
