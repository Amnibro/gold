fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var new_n = 0;
	for i in g.n {
		var cnt = 0;
		for j in new_n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt < limit {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	out.i = new_n;
	out
}
@end
