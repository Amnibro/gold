fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${times};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] != g.res[i] * factor {
			valid = false;
			break;
		}
		i++;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid { out.s.append("sequence matches scale"); } else { out.s.append("scale mismatch"); }
	gold_push(g, out.i);
	g.steps += g.n + 1;
	out
}
@end
