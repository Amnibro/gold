@entry 398a991b046b0028
kind: step
verb: sum
noun: budget
modifier: unique
context: retry
phrase: sum unique retry budget {budget}
phrase: calculate unique retry budget remainder {budget}
slot: budget int
test: list=1,2,2,3 budget=20
expect: => i=14 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,2,3,14] cache=0 hits=0
