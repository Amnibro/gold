fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	var max_depth = 0;
	for b in out.s {
		if b == '(' || b == '[' || b == '{' {
			depth++;
			if depth > max_depth { max_depth = depth; }
		} else if b == ')' || b == ']' || b == '}' {
			if depth > 0 { depth--; }
		}
	}
	gold_push(g, max_depth);
	out.i = max_depth;
	out.s.clear();
	format(out.s, "max nested text depth ", max_depth);
	g.steps += out.s.len + 1;
	out
}
@end
