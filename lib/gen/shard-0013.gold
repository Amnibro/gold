@entry 7b21e3ac83088337
kind: step
verb: fill
noun: range
modifier: unique
context: transform
phrase: transform fill range unique values
phrase: populate range with distinct consecutive steps
test: list=3,6
expect: => i=4 r=0.0 ok=true s="filled range with 4 unique integers" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=10,11
expect: => i=2 r=0.0 ok=true s="filled range with 2 unique integers" errors=0 n=2 res=[10,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
	}
	var count = 0;
	var cur = mn;
	while cur <= mx && count < 512 {
		g.res[count] = cur;
		count++;
		cur++;
	}
	g.steps += g.n + count + 1;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "filled range with ", count, " unique integers");
	out
}
@end
@entry c4257d631e289160
kind: step
verb: compare
noun: words
modifier: until
context: transform
slot: stop_len int
phrase: transform compare words until limit {stop_len}
phrase: evaluate words until length threshold {stop_len}
test: text="cat elephant dog" stop_len=5
expect: => i=1 r=0.0 ok=true s="compared words until limit with 1 words" errors=0 n=1 res=[3] cache=0 hits=0
test: text="apple banana" stop_len=10
expect: => i=2 r=0.0 ok=true s="compared words until limit with 2 words" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${stop_len};
	var wlen = 0;
	var count = 0;
	var idx = 0;
	while idx < v.s.len {
		let b = v.s[idx];
		if b == ' ' {
			if wlen > 0 {
				if wlen >= slen { break; }
				gold_push(g, wlen);
				count++;
				wlen = 0;
			}
		} else {
			wlen++;
		}
		idx++;
	}
	if wlen > 0 && wlen < slen {
		gold_push(g, wlen);
		count++;
	}
	g.steps += idx + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "compared words until limit with ", count, " words");
	out
}
@end
@entry dc1a010fed287f86
kind: step
verb: compare
noun: total
modifier: any
context: transform
slot: target_sum int
phrase: transform compare total any pair matches {target_sum}
phrase: verify if any pair sums to target {target_sum}
test: list=2,5,8 target_sum=10
expect: => i=1 r=0.0 ok=true s="target sum match found 1" errors=0 n=4 res=[2,5,8,1] cache=0 hits=0
test: list=1,3,4 target_sum=10
expect: => i=0 r=0.0 ok=true s="target sum match found 0" errors=0 n=4 res=[1,3,4,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ts = ${target_sum};
	var found = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in (i + 1)..g.n {
				if g.res[i] + g.res[j] == ts {
					found = 1;
					break;
				}
			}
			if found == 1 { break; }
		}
	}
	gold_push(g, found);
	g.steps += g.n + 1;
	out.i = found;
	out.s.clear();
	format(out.s, "target sum match found ", found);
	out
}
@end
