@entry da4fd865b5079898
kind: step
verb: rank
noun: number
modifier: recursively
context: math
slot: num int
phrase: rank number {num} recursively by digit sums
phrase: compute recursive rank for number {num}
test: num=9875
expect: => i=3 r=0.0 ok=true s="recursive rank steps: 3" errors=0 n=0 res=[] cache=0 hits=0
test: num=49
expect: => i=2 r=0.0 ok=true s="recursive rank steps: 2" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = ${num};
	var cur = if n < 0 { -n } else { n };
	var steps = 0;
	while cur >= 10 {
		var s = 0;
		while cur > 0 {
			s += cur % 10;
			cur /= 10;
		}
		cur = s;
		steps++;
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "recursive rank steps: ", steps);
	out
}
@end
