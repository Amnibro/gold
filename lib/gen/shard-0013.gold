@entry 8bf339e76c9fe57b
kind: step
verb: rotate
noun: steps
modifier: sorted
context: aggregate
phrase: rotate sorted elements by step amount {shift}
phrase: cycle sorted array forward by {shift} steps
slot: shift int
test: list=4,1,3,2 shift=1
expect: => i=4 r=0.0 ok=true s="rotated steps sorted total=4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,30,20 shift=2
expect: => i=3 r=0.0 ok=true s="rotated steps sorted total=3" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if g.n > 0 {
		let k = s % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated steps sorted total=", g.n);
	out
}
@end
