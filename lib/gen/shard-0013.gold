test: list=2,3,4,5,6,7 lo=3 hi=6
expect: => i=8 r=0.0 ok=true s="summed primes between 8" errors=0 n=7 res=[2,3,4,5,6,7,8] cache=1 hits=0
test: list=10,11,12,13,14 lo=11 hi=13
expect: => i=24 r=0.0 ok=true s="summed primes between 24" errors=0 n=6 res=[10,11,12,13,14,24] cache=1 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var i = 2;
	while i * i <= n {
		if n % i == 0 { return false; }
		i++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var prime_sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high && ${ID}_is_prime(x) {
			prime_sum += x;
		}
	}
	gold_cache_put(g, 0, prime_sum);
	gold_push(g, prime_sum);
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "summed primes between ", prime_sum);
	g.steps += g.n + 1;
	out
}
@end
