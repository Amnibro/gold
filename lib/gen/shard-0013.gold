fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_idx = -1;
	var max_val = -1;
	for i in g.n {
		if g.res[i] <= lim && g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	if max_idx >= 0 && g.n > 0 {
		let tmp = g.res[max_idx];
		g.res[max_idx] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "swapped maximum up to=", max_val);
	out
}
@end
