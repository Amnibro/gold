@entry b2cfe8bee3636481
kind: step
verb: return
noun: list
modifier: last
context: transform
phrase: return last {count} items from transformed list
phrase: yield trailing {count} elements from list
slot: count int
test: list=1,2,3,4,5,6 count=3
expect: => i=3 r=0.0 ok=true s="returned last 3 elements from list" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="returned last 2 elements from list" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	if c < g.n {
		let start = g.n - c;
		for i in c {
			g.res[i] = g.res[start + i];
		}
		g.n = c;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned last ", g.n, " elements from list");
	out
}
@end
