code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.cn {
		let v1, h1 = gold_cache_get(g, i);
		let v2, h2 = gold_cache_get(g, i + 1);
		if h1 && h2 {
			g.res[pairs] = v1 + v2;
			pairs++;
		}
		i += 2;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired memo items ", pairs);
	out
}
@end
