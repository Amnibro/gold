code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		let neg = x < 0;
		if neg { x = -x; }
		var r = 0;
		while x > 0 {
			r = r * 10 + x % 10;
			x /= 10;
		}
		if neg { r = -r; }
		g.res[i] = r;
		total += r;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "reversed digits of each number sum ", total);
	out
}
@end
