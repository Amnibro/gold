test: list=5,5,10,10,15
expect: => i=30 r=0.0 ok=true s="unique total is 30" errors=0 n=6 res=[5,5,10,10,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var nu = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in nu {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[nu] = x;
			nu++;
			sum += x;
		}
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "unique total is ", sum);
	out
}
@end
