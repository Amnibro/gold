expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=7,8,9
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < j && g.res[i] % 2 == 0 { i++; }
		while i < j && g.res[j] % 2 == 0 { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	out.i = g.n;
	out
}
@end
