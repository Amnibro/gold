noun: runs
modifier: each
context: aggregate
phrase: join consecutive runs for each element
phrase: aggregate adjacent runs per unique item
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="joined runs count=3" errors=0 n=3 res=[2,6,3] cache=0 hits=0
test: list=5,5,6
expect: => i=2 r=0.0 ok=true s="joined runs count=2" errors=0 n=2 res=[10,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var write = 0;
	var run_sum = g.res[0];
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			run_sum += g.res[i];
		} else {
			g.res[write] = run_sum;
			write++;
			run_sum = g.res[i];
		}
	}
	g.res[write] = run_sum;
	write++;
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "joined runs count=", write);
	out
}
@end
