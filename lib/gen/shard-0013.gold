fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${target_rep};
	if g.n == 0 { out.i = 0; return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == min_val { count++; }
	}
	var write_idx = 0;
	if count >= req {
		for i in g.n {
			if g.res[i] == min_val {
				g.res[write_idx] = min_val;
				write_idx++;
			}
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept minimum value occurrences count ", write_idx);
	out
}
