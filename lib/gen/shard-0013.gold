test: list=8,100,2
expect: => i=2 r=0.0 ok=true s="sorted every other: 2" errors=0 n=3 res=[2,100,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[256] = [0; 256];
	var en = 0;
	var i = 0;
	while i < g.n {
		evens[en] = g.res[i];
		en++;
		i += 2;
	}
	for j in en {
		for k in j + 1..en {
			if evens[j] > evens[k] {
				let t = evens[j];
				evens[j] = evens[k];
				evens[k] = t;
			}
		}
	}
	var idx = 0;
	for j in en {
		g.res[idx] = evens[j];
		idx += 2;
	}
	g.steps += en * en;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted every other: ", en);
	out
}
@end
