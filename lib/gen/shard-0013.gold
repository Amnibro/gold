fn ${ID}_is_square(n int) bool {
	if n < 0 { return false; }
	var i = 0;
	while i * i <= n {
		if i * i == n { return true; }
		i++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let is_alt = (i % 2 == 1);
		if is_alt && ${ID}_is_square(g.res[i]) {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " alternate squares");
	g.steps += kept + dropped + 1;
	out
}
@end
