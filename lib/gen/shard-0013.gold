expect: => i=1 r=0.0 ok=true s="clamped digits pairwise count=1" errors=0 n=3 res=[1,4,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${delta};
	var clamped = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > limit {
			g.res[i + 1] = g.res[i] + limit;
			clamped++;
		}
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped digits pairwise count=", clamped);
	out
}
@end
