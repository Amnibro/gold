@entry 5a6a408d2b984561
kind: step
verb: split
noun: primes
modifier: with_cache
context: core
phrase: split primes with cache lookups
phrase: partition prime numbers using cache
test: list=2,4,7,9,11,15
expect: => i=3 r=0.0 ok=true s="split primes: 3 cached" errors=0 n=6 res=[2,7,11,4,9,15] cache=6 hits=0
test: list=3,5,6,8,13
expect: => i=3 r=0.0 ok=true s="split primes: 3 cached" errors=0 n=5 res=[3,5,13,6,8] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var others int[512] = [0; 512];
	var np = 0;
	var no = 0;
	for i in g.n {
		let x = g.res[i];
		let is_cached, hit = gold_cache_get(g, x);
		var is_p = false;
		if hit {
			is_p = is_cached == 1;
		} else {
			is_p = x >= 2;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			gold_cache_put(g, x, if is_p { 1 } else { 0 });
		}
		if is_p {
			primes[np] = x;
			np++;
		} else {
			others[no] = x;
			no++;
		}
	}
	for i in np { g.res[i] = primes[i]; }
	for i in no { g.res[np + i] = others[i]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "split primes: ", np, " cached");
	out
}
@end
