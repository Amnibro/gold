@entry 0d767f6f27832f68
kind: step
verb: measure
noun: sequence
modifier: times
context: sort
phrase: measure longest sorted contiguous sequence scaled by {factor}
phrase: evaluate consecutive sorted run multiplied by {factor}
slot: factor int
test: list=1,2,3,7,8 factor=2
expect: => i=6 r=0.0 ok=true s="sequence length scaled to 6" errors=0 n=5 res=[1,2,3,7,8] cache=0 hits=0
test: list=10,20,30 factor=3
expect: => i=3 r=0.0 ok=true s="sequence length scaled to 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_len = 0;
	if g.n > 0 {
		var cur_len = 1;
		max_len = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] + 1 {
				cur_len++;
				if cur_len > max_len { max_len = cur_len; }
			} else {
				cur_len = 1;
			}
		}
	}
	let result = max_len * mult;
	g.steps += g.n * g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "sequence length scaled to ", result);
	out
}
@end
