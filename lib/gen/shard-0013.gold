test: list=2,5,9,12,20 gap=4
expect: => i=2 r=0.0 ok=true s="traced gaps until target 4" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,25,40 gap=5
expect: => i=2 r=0.0 ok=true s="traced gaps until target 5" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${gap};
	var write = 0;
	var found = false;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		g.res[write] = diff;
		write++;
		if diff == target {
			found = true;
			break;
		}
		i++;
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.ok = found;
	out.s.clear();
	format(out.s, "traced gaps until target ", target);
	out
}
@end
