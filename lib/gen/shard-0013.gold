fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var s = 0;
	for i in g.n {
		if s + g.res[i] <= lim {
			s += g.res[i];
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = s;
	gold_text(out, "folded until limit");
	out
}
