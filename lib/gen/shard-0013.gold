fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${k};
	var count = want;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	var swaps = 0;
	var i = start;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += count;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped every other suffix element swaps ", swaps);
	out
}
