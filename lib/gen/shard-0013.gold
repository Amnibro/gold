fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let div = ${divisor};
    var all_div = true;
    var bad_count = 0;
    if div != 0 {
        for i in g.n {
            if g.res[i] % div != 0 {
                all_div = false;
                bad_count++;
            }
        }
    }
    g.steps += g.n;
    out.ok = all_div;
    out.i = bad_count;
    out.s.clear();
    if all_div {
        format(out.s, "all elements divisible by ", div);
    } else {
        format(out.s, "failed divisibility by ", div, ": count ", bad_count);
    }
    out
}
@end
