fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let cv, found = gold_cache_get(g, x);
		if found {
			g.res[i] += cv;
			hits++;
		} else {
			gold_cache_put(g, x, x * 2);
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "retried memo alternating entries hits ", hits);
	out
}
@end
