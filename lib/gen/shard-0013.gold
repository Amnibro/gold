code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var min_diff = 1000000;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 {
			diff = -diff;
		}
		if diff < min_diff {
			min_diff = diff;
		}
	}
	g.steps += g.n;
	out.i = min_diff;
	out.s.clear();
	format(out.s, "minimum pairwise retry difference is ", min_diff);
	out
}
@end
