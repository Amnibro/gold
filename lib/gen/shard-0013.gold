		let m0 = g.n / 2 - 1;
		let m1 = g.n / 2;
		if g.res[m0] > g.res[m1] {
			let tmp = g.res[m0];
			g.res[m0] = g.res[m1];
			g.res[m1] = tmp;
			swapped = true;
