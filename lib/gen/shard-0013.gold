expect: => i=13 r=0.0 ok=true s="range span across retries is 13" errors=0 n=4 res=[2,3,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_span = ${span};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	let current_span = max_val - min_val;
	g.steps += g.n;
	out.ok = current_span >= target_span;
	out.i = current_span;
	out.s.clear();
	format(out.s, "range span across retries is ", current_span);
	out
}
@end
