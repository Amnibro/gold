fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { unique++; }
	}
	var rev = 0;
	var t = unique;
	while t > 0 {
		rev = rev * 10 + (t % 10);
		t /= 10;
	}
	g.steps += g.n;
	out.i = rev;
	out.s.clear();
	format(out.s, "unique elements counter reversed=", rev);
	out
}
