code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if total + sq > lim {
			break;
		}
		total += sq;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded squares until limit: ", total);
	out
}
@end
