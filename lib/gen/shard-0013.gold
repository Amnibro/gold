fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var write_idx = 1;
	var removed = 0;
	for i in g.n - 1 {
		if g.res[i + 1] != g.res[i] {
			g.res[write_idx] = g.res[i + 1];
			write_idx++;
		} else {
			removed++;
		}
	}
	g.n = write_idx;
	g.steps += removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " pairwise history entries");
	out
}
@end
