slot: chunk_size int
phrase: transform group function times size {chunk_size}
phrase: partition results into chunks of size {chunk_size}
test: list=1,2,3,4,5 chunk_size=2
expect: => i=3 r=0.0 ok=true s="grouped into 3 chunks" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=10,20 chunk_size=2
expect: => i=1 r=0.0 ok=true s="grouped into 1 chunks" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${chunk_size};
	if k <= 0 { return out; }
	var new_n = 0;
	var cur_sum = 0;
	var in_chunk = 0;
	for i in g.n {
		cur_sum += g.res[i];
		in_chunk++;
		if in_chunk == k {
			g.res[new_n] = cur_sum;
			new_n++;
			cur_sum = 0;
			in_chunk = 0;
		}
	}
	if in_chunk > 0 {
		g.res[new_n] = cur_sum;
		new_n++;
	}
	g.steps += g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped into ", new_n, " chunks");
	out
}
@end
