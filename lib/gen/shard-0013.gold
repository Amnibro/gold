fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var shifted = 0;
	while i < out.s.len {
		if i % 2 == 1 {
			let b = out.s[i];
			if b >= 'a' && b < 'z' {
				out.s[i] = (b as int + 1) as byte;
				shifted++;
			}
		}
		i++;
	}
	out.i = shifted;
	gold_push(g, shifted);
	g.steps += out.s.len + 1;
	out
}
@end
