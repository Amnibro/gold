@entry 8b2f62c5eedcc9f7
kind: step
verb: dedupe
noun: words
modifier: nested
context: text
phrase: dedupe repeated adjacent words in text sequence
phrase: remove consecutive duplicate word tokens from text
test: text="cat cat dog"
expect: => i=7 r=0.0 ok=true s="cat dog" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello hello world"
expect: => i=11 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp byte[..200] = "";
	var i = 0;
	var last_word byte[..50] = "";
	while i < out.s.len {
		var cur byte[..50] = "";
		while i < out.s.len && out.s[i] != ' ' {
			cur.push(out.s[i]);
			i++;
		}
		var same = cur.len == last_word.len && cur.len > 0;
		if same {
			for k in cur.len {
				if cur[k] != last_word[k] {
					same = false;
					break;
				}
			}
		}
		if !same {
			if temp.len > 0 {
				temp.push(' ');
			}
			for b in cur {
				temp.push(b);
			}
			last_word.clear();
			for b in cur {
				last_word.push(b);
			}
		}
		while i < out.s.len && out.s[i] == ' ' {
			i++;
		}
	}
	out.s.clear();
	for b in temp {
		out.s.push(b);
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
