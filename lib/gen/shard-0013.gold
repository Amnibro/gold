code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lev = ${levels};
	var factor = 1;
	for _ in lev {
		factor *= 2;
	}
	var write_idx = 0;
	for i in g.n {
		if g.res[i] % factor == 0 {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n + lev;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered through ", lev, " recursive levels remaining ", g.n);
	out
}
@end
