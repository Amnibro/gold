fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = if ${divisor} == 0 { 1 } else { ${divisor} };
	var modified = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] % 2 == 0 {
			g.res[i] = g.res[i] / div;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized ", modified, " reverse evens");
	g.steps += g.n + 1;
	out
}
@end
