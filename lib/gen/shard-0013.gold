code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			s += g.res[i];
			count++;
		}
	}
	if count == 0 {
		for i in g.n {
			let shifted = g.res[i] + 1;
			if shifted % 2 == 0 {
				s += shifted;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "summed evens count ", count);
	gold_push(g, s);
	out
}
@end
