@entry 3e595c1a76a37a3a
kind: step
verb: run
noun: window
modifier: unique
context: sort
phrase: run unique check across window size {width}
phrase: scan window partitions for unique elements of size {width}
phrase: process unique items in window of size {width}
slot: width int
test: list=1,1,2,3,3,4 width=3
expect: => i=1 r=0.0 ok=true s="unique windows 1" errors=0 n=7 res=[1,1,2,3,3,4,1] cache=0 hits=0
test: list=5,5,5,6,7,8 width=2
expect: => i=3 r=0.0 ok=true s="unique windows 3" errors=0 n=7 res=[5,5,5,6,7,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = if ${width} <= 0 { 1 } else { ${width} };
	var unique_windows = 0;
	var i = 0;
	while i + w <= g.n {
		var all_unique = true;
		var a = 0;
		while a < w {
			var b = a + 1;
			while b < w {
				if g.res[i + a] == g.res[i + b] {
					all_unique = false;
					break;
				}
				b++;
			}
			if !all_unique { break; }
			a++;
		}
		if all_unique { unique_windows++; }
		i++;
	}
	gold_push(g, unique_windows);
	out.i = unique_windows;
	out.s.clear();
	format(out.s, "unique windows ", unique_windows);
	g.steps += g.n + 1;
	out
}
@end
