fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let orig_n = g.n;
	var matched_gaps = 0;
	var i = 0;
	while i + 1 < orig_n {
		let gap = g.res[i + 1] - g.res[i];
		if gap == th {
			gold_push(g, gap * 2);
			matched_gaps++;
		} else {
			gold_push(g, gap);
		}
		i++;
	}
	out.i = matched_gaps;
	out.s.clear();
	format(out.s, "normalized gaps any ", matched_gaps);
	g.steps += orig_n + 1;
	out
}
