kind: step
verb: reverse
noun: tail
modifier: running
context: sort
phrase: reverse running tail of sorted elements
phrase: invert trailing half of sorted values
test: list=10,40,20,30
expect: => i=2 r=0.0 ok=true s="reversed tail of 2 items" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
test: list=5,1,9
expect: => i=2 r=0.0 ok=true s="reversed tail of 2 items" errors=0 n=3 res=[1,9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let mid = g.n / 2;
	var left = mid;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	let tail_len = g.n - mid;
	g.steps += g.n * g.n;
	out.i = tail_len;
	out.s.clear();
	format(out.s, "reversed tail of ", tail_len, " items");
	out
}
@end
