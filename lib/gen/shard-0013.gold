slot: min_err int
slot: max_err int
test: list=1,2,3 min_err=0 max_err=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=5,6 min_err=1 max_err=3
expect: => i=2 r=0.0 ok=false s="" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_err};
	let hi = ${max_err};
	if g.errors >= lo && g.errors <= hi && g.n > 1 {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		out.ok = true;
	} else {
		out.ok = false;
	}
	out.i = g.n;
	out
}
@end
