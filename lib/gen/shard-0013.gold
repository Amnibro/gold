@entry 7ce788446f7863c1
kind: step
verb: repeat
noun: runs
modifier: at_least
context: math
slot: min_len int
phrase: repeat consecutive runs of length at least {min_len}
phrase: duplicate run sequences of size at least {min_len}
test: list=1,2,2,3 min_len=2
expect: => i=6 r=0.0 ok=true s="repeated runs at least: 6" errors=0 n=6 res=[1,2,2,2,2,3] cache=0 hits=0
test: list=4,4,4,5 min_len=3
expect: => i=7 r=0.0 ok=true s="repeated runs at least: 7" errors=0 n=7 res=[4,4,4,4,4,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var temp int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let rlen = j - i;
		for k in rlen {
			temp[tn] = g.res[i];
			tn++;
		}
		if rlen >= ml {
			for k in rlen {
				temp[tn] = g.res[i];
				tn++;
			}
		}
		i = j;
	}
	for k in tn {
		g.res[k] = temp[k];
	}
	g.n = tn;
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "repeated runs at least: ", tn);
	out
}
@end
