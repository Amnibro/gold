@entry 98d4183dea859425
kind: step
verb: validate
noun: primes
modifier: in_place
context: filter
phrase: validate primes in place for elements
phrase: filter check primes in place across list
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="validated primes in place remaining 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
