@entry 76e9f6d15988b6a0
kind: step
verb: repeat
noun: primes
modifier: recursively
context: sort
phrase: repeat prime numbers in sorted list
phrase: duplicate prime values in sorted order
test: list=4,2,7,9
expect: => i=2 r=0.0 ok=true s="counted prime elements" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=6,8,5
expect: => i=1 r=0.0 ok=true s="counted prime elements" errors=0 n=3 res=[5,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	g.steps += g.n;
	out.i = primes;
	gold_text(out, "counted prime elements");
	out
}
@end
