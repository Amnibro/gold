code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var req = ${attempts};
	if req < 1 { req = 1; }
	var hits = 0;
	for i in g.n {
		let x = g.res[i];
		for step in req {
			let cv, found = gold_cache_get(g, x + step);
			if found {
				hits++;
			} else {
				gold_cache_put(g, x + step, x * 2);
			}
		}
		g.res[i] += hits;
	}
	g.steps += req * g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "retried memo at least hits count ", hits);
	out
}
@end
