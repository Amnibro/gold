kind: step
verb: search
noun: primes
modifier: at_most
context: aggregate
phrase: search primes at most ceiling value {limit}
phrase: find prime numbers up to upper bound {limit}
slot: limit int
test: list=2,3,4,10,13,20 limit=15
expect: => i=3 r=0.0 ok=true s="found primes at most limit count=3" errors=0 n=3 res=[2,3,13] cache=0 hits=0
test: list=10,20,30 limit=5
expect: => i=0 r=0.0 ok=true s="found primes at most limit count=0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && x > 1 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				g.res[write] = x;
				write++;
			}
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "found primes at most limit count=", write);
	out
}
@end
