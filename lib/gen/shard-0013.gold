fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = 0;
		for j in write_idx {
			if g.res[j] == val {
				seen++;
			}
		}
		if seen < lim {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n + lim;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped numbers capped at ", lim, " occurrences remaining ", g.n);
	out
}
@end
