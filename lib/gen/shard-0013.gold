fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var counts int[256];
	for i in 256 { counts[i] = 0; }
	var temp byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		let idx = b as int;
		if i % 2 == 0 {
			if idx >= 0 && idx < 256 {
				if counts[idx] < lim {
					counts[idx]++;
					temp.push(b);
				}
			}
		} else {
