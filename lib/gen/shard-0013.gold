		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j += 2;
		}
		i += 2;
	}
	out.i = g.n;
	out
}
