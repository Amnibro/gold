code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var write_idx = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i+1] > g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
		if diff <= mg {
			g.res[write_idx] = g.res[i] + g.res[i + 1];
			write_idx++;
			i += 2;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
			i++;
		}
	}
	if i < g.n {
		g.res[write_idx] = g.res[i];
		write_idx++;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged small gaps at most count ", write_idx);
	out
}
@end
