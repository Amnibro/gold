	var run_lens int[..100] = [];
	if g.n > 0 {
		var cur = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur++;
			} else {
				run_lens.push(cur);
				cur = 1;
			}
		}
		run_lens.push(cur);
	}
	var max_r = 0;
	for i in run_lens.len {
		g.res[i] = run_lens[i];
		if run_lens[i] > max_r {
			max_r = run_lens[i];
		}
	}
	g.steps += g.n + 1;
	g.n = run_lens.len;
	out.i = max_r;
	out.s.clear();
	format(out.s, "maximum run length ", max_r);
	out
}
