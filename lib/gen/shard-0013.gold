@entry ec2f393842b732c6
kind: step
verb: join
noun: gaps
modifier: with_cache
context: transform
phrase: join gaps between elements using cache step {step}
phrase: interpolate gap items with cached step {step}
slot: step int
test: list=2,10,20 step=4
expect: => i=6 r=0.0 ok=true s="joined gaps with cache step 4 new length 6" errors=0 n=6 res=[2,6,10,14,18,20] cache=1 hits=0
test: list=5,15,30 step=5
expect: => i=6 r=0.0 ok=true s="joined gaps with cache step 5 new length 6" errors=0 n=6 res=[5,10,15,20,25,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	gold_cache_put(g, st, g.n);
	if g.n < 2 || st <= 0 {
		out.i = g.n;
		return out;
	}
	var new_arr int[>..] = [];
	for i in g.n - 1 {
		new_arr.push(g.res[i]);
		var curr = g.res[i] + st;
		while curr < g.res[i + 1] {
			new_arr.push(curr);
			curr += st;
		}
	}
	new_arr.push(g.res[g.n - 1]);
	g.n = 0;
	for x in new_arr {
		gold_push(g, x);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined gaps with cache step ", st, " new length ", g.n);
	out
}
@end
