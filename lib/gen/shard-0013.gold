kind: step
verb: clamp
noun: gaps
modifier: safely
context: list
phrase: clamp gaps safely below {max_gap}
phrase: limit consecutive gaps safely to {max_gap}
slot: max_gap int
test: list=10,35,40,90 max_gap=15
expect: => i=2 r=0.0 ok=true s="clamped gaps count: 2" errors=0 n=4 res=[10,25,40,55] cache=0 hits=0
test: list=1,20,25,60 max_gap=10
expect: => i=3 r=0.0 ok=true s="clamped gaps count: 3" errors=0 n=4 res=[1,11,21,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let mg = ${max_gap};
    var clamped = 0;
    if g.n > 1 {
        for i in 1..g.n {
            let diff = g.res[i] - g.res[i - 1];
            if diff > mg {
                g.res[i] = g.res[i - 1] + mg;
                clamped++;
            } else if diff < -mg {
                g.res[i] = g.res[i - 1] - mg;
                clamped++;
            }
        }
    }
    g.steps += g.n;
    out.i = clamped;
    out.s.clear();
    format(out.s, "clamped gaps count: ", clamped);
    out
}
@end
