expect: => i=20 r=0.0 ok=true s="merged any matching results sum 20" errors=0 n=3 res=[20,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matched_sum = 0;
	var write_idx = 0;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x == tgt {
			matched_sum += x;
			found = true;
		} else {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	if found {
		g.res[write_idx] = matched_sum;
		write_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = matched_sum;
	out.s.clear();
	format(out.s, "merged any matching results sum ", matched_sum);
	out
}
@end
