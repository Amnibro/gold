expect: => i=1 r=0.0 ok=true s="sorted last item to position: 1" errors=0 n=4 res=[2,4,5,8] cache=0 hits=0
test: list=10,20,5
expect: => i=0 r=0.0 ok=true s="sorted last item to position: 0" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = g.n - 1;
	if g.n >= 2 {
		let last_val = g.res[g.n - 1];
		var idx = g.n - 2;
		while idx >= 0 && g.res[idx] > last_val {
			g.res[idx + 1] = g.res[idx];
			idx--;
		}
		g.res[idx + 1] = last_val;
		pos = idx + 1;
	}
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "sorted last item to position: ", pos);
	out
}
@end
@entry 8b4cbe4de3dfc647
kind: step
verb: reverse
noun: average
modifier: safely
context: stats
slot: safe_cap int
phrase: reverse average distance safely across sample values
phrase: invert mean difference safely across sample values
test: list=10,20,30 safe_cap=50
expect: => i=20 r=0.0 ok=true s="avg=20" errors=0 n=3 res=[10,0,10] cache=0 hits=0
test: list=5,15,25 safe_cap=40
expect: => i=15 r=0.0 ok=true s="avg=15" errors=0 n=3 res=[10,0,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${safe_cap};
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for k in g.n {
		var diff = avg - g.res[k];
		if diff < 0 { diff = -diff; }
		if diff > cap { diff = cap; }
		g.res[k] = diff;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "avg=", avg);
	out
}
@end
