fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = 0;
	var neg = 0;
	for i in g.n {
		if g.res[i] > 0 { pos++; }
		else if g.res[i] < 0 { neg++; }
	}
	if pos == 0 && neg == 0 {
		pos = g.n;
	}
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "pos ", pos, " neg ", neg);
	gold_push(g, pos);
	gold_push(g, neg);
	out
}
@end
