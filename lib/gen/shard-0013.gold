test: list=4,5,6,7,8,9,11
expect: => i=3 r=0.0 ok=true s="normalized primes: 3" errors=0 n=7 res=[0,1,0,1,0,0,1] cache=0 hits=0
test: list=2,3,10,12,13
expect: => i=3 r=0.0 ok=true s="normalized primes: 3" errors=0 n=5 res=[1,1,0,0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var prime_count = 0;
    for i in g.n {
        let x = g.res[i];
        var is_p = true;
        if x < 2 {
            is_p = false;
        } else {
            var d = 2;
            while d * d <= x {
                if x % d == 0 {
                    is_p = false;
                    break;
                }
                d++;
            }
        }
        if is_p {
            g.res[i] = 1;
            prime_count++;
        } else {
            g.res[i] = 0;
        }
    }
    g.steps += g.n;
    out.i = prime_count;
    out.s.clear();
    format(out.s, "normalized primes: ", prime_count);
    out
}
@end
