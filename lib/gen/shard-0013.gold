fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[>..] = [];
	var in_space = false;
	for c in out.s {
		if c == ' ' {
			if !in_space {
				res.push(c);
				in_space = true;
			}
		} else {
			res.push(c);
			in_space = false;
		}
	}
	out.s.clear();
	for b in res {
		if out.s.len < 200 {
			out.s.push(b);
		}
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
