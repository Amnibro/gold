code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    for i in g.n {
        for j in g.n - 1 - i {
            if g.res[j] > g.res[j + 1] {
                let tmp = g.res[j];
                g.res[j] = g.res[j + 1];
                g.res[j + 1] = tmp;
            }
        }
    }
    let count = g.n;
    g.res[g.n] = count;
    g.n++;
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "sorted with counter joined: ", count);
    out
}
@end
