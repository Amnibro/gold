kind: fn
verb: rotate
noun: limit
modifier: pairwise
context: search
phrase: rotate limit pairwise search bound
phrase: search pairwise adjacent swap bound
test: arg=1234,567
expect: 2143
expect: 657
test: arg=8
expect: 8
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var rev int[..20] = [];
	while x > 0 {
		rev.push(x % 10);
		x /= 10;
	}
	var d int[..20] = [];
	var idx = rev.len - 1;
	while idx >= 0 {
		d.push(rev[idx]);
		if idx == 0 { break; }
		idx--;
	}
	var i = 0;
	while i + 1 < d.len {
		let t = d[i];
		d[i] = d[i + 1];
		d[i + 1] = t;
		i += 2;
	}
	var res = 0;
	for v in d {
		res = res * 10 + v;
	}
	res
}
@end
