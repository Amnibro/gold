code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_bins};
	var bins = 0;
	for i in g.n {
		if bins >= lim { break; }
		var seen = false;
		for j in i {
			if g.res[i] == g.res[j] { seen = true; break; }
		}
		if !seen { bins++; }
	}
	g.steps += g.n;
	out.i = bins;
	out.s.clear();
	format(out.s, "bins=", bins);
	out
}
@end
