@entry e7630ac1eadc80be
kind: step
verb: rank
noun: minimum
modifier: in_reverse
context: compare
phrase: rank minimum comparison elements in reverse
phrase: evaluate minimum comparison ranks in reverse order
test: list=10,20,5,30
expect: => i=4 r=0.0 ok=true s="reverse rank for minimum is 4" errors=0 n=4 res=[10,20,5,30] cache=0 hits=0
test: list=15,8,25,3
expect: => i=4 r=0.0 ok=true s="reverse rank for minimum is 4" errors=0 n=4 res=[15,8,25,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var rank = 1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > min_val {
			rank++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = rank;
	out.s.clear();
	format(out.s, "reverse rank for minimum is ", rank);
	out
}
@end
