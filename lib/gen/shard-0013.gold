@entry 841d3d6ef44567e1
kind: step
verb: sort
noun: digits
modifier: each
context: error
phrase: sort digit entries for each element
phrase: order each digit sequence safely
test: list=9,3,7
expect: => i=3 r=0.0 ok=true s="digits sorted" errors=0 n=3 res=[3,7,9] cache=0 hits=0
test: list=9,-3,7
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[9,-3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] < 0 { gold_fail(g, "negative digit"); out.ok = false; return out; }
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "digits sorted");
	out
}
@end
