code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_diff = 0;
	var i = 1;
	while i < g.n {
		var d = g.res[i] - g.res[i - 1];
		if d < 0 { d = -d; }
		total_diff += d;
		i++;
	}
	g.steps += g.n;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "diff=", total_diff);
	out
}
@end
