fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_sum = 0;
	var odd_sum = 0;
	for i in g.n {
		if i % 2 == 0 {
			even_sum += g.res[i];
		} else {
			odd_sum += g.res[i];
		}
	}
	let diff = even_sum - odd_sum;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "alternating diff is ", diff);
	gold_push(g, diff);
	out
}
@end
