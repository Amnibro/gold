@entry 78ce391c6290960a
kind: step
verb: drop
noun: prefix
modifier: sorted
context: search
phrase: drop prefix of sorted search keys
phrase: discard leading portion after sorting
phrase: prune prefix from sorted sample
slot: k int
test: list=40,10,30,20 k=2
expect: => i=2 r=0.0 ok=true s="dropped prefix sorted 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=50,15,35,25 k=1
expect: => i=1 r=0.0 ok=true s="dropped prefix sorted 1" errors=0 n=3 res=[25,35,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let drop_count = if ${k} < 0 { 0 } else { if ${k} > g.n { g.n } else { ${k} } };
	var kept = 0;
	var idx = drop_count;
	while idx < g.n {
		g.res[kept] = g.res[idx];
		kept++;
		idx++;
	}
	g.n = kept;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped prefix sorted ", drop_count);
	g.steps += g.n + drop_count + 1;
	out
}
@end
@entry f1305ed2a9c41e51
kind: step
verb: drop
noun: value
modifier: last
context: search
phrase: drop last occurrences of value {target}
phrase: remove last matching value {target}
phrase: discard final instance of value {target}
slot: target int
test: list=1,2,3,2,4 target=2
expect: => i=1 r=0.0 ok=true s="dropped last value idx 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
