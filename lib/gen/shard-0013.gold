test: list=72,83
expect: => i=0 r=0.0 ok=true s="found 0 sorted digit numbers" errors=0 n=3 res=[72,83,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted_count = 0;
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		var is_sorted = true;
		var last_d = 10;
		while x > 0 {
			let d = x % 10;
			if d > last_d {
				is_sorted = false;
				break;
			}
			last_d = d;
			x /= 10;
		}
		if is_sorted {
			sorted_count++;
		}
	}
	gold_push(g, sorted_count);
	g.steps += g.n + 1;
	out.i = sorted_count;
	out.s.clear();
	format(out.s, "found ", sorted_count, " sorted digit numbers");
	out
}
@end
