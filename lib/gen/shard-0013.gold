fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	gold_cache_put(g, 0, len);
	var left = 0;
	var right = len - 1;
	while left < right {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		left++;
		right--;
	}
	g.steps += len;
	out.i = len;
	out
}
@end
