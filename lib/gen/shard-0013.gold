phrase: rotate elements located at every other position
phrase: cycle transformed items from every other index
test: list=1,10,2,20,3,30
expect: => i=3 r=0.0 ok=true s="rotated 3 alternating elements" errors=0 n=6 res=[3,10,1,20,2,30] cache=0 hits=0
test: list=4,40,5,50,6,60
expect: => i=3 r=0.0 ok=true s="rotated 3 alternating elements" errors=0 n=6 res=[6,40,4,50,5,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idxs int[>..] = [];
	var vals int[>..] = [];
	var i = 0;
	while i < g.n {
		idxs.push(i);
		vals.push(g.res[i]);
		i += 2;
	}
	if vals.len > 1 {
		let last = vals[vals.len - 1];
		var j = vals.len - 1;
		while j > 0 {
			vals[j] = vals[j - 1];
			j--;
		}
		vals[0] = last;
		for k in idxs.len {
			g.res[idxs[k]] = vals[k];
		}
	}
	g.steps += vals.len + 1;
	out.i = vals.len;
	out.s.clear();
	format(out.s, "rotated ", vals.len, " alternating elements");
	out
}
@end
