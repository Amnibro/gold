noun: primes
modifier: with_retry
context: sort
phrase: merge sorted primes with retry fallback
phrase: filter sorted prime elements with retry step
test: list=9,4,6,8
expect: => i=2 r=0.0 ok=true s="merged primes after retry: 2" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=8,3,10,7,5
expect: => i=3 r=0.0 ok=true s="merged primes: 3" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for k in g.n {
		if core_is_prime(g.res[k]) {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	if kept == 0 {
		for k in g.n {
			let cand = g.res[k] + 1;
			if core_is_prime(cand) {
				g.res[kept] = cand;
				kept++;
			}
		}
		g.n = kept;
		out.i = kept;
		out.s.clear();
		format(out.s, "merged primes after retry: ", kept);
	} else {
		g.n = kept;
		out.i = kept;
		out.s.clear();
		format(out.s, "merged primes: ", kept);
	}
	g.steps += g.n * g.n;
	out
}
@end
