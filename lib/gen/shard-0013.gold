@entry 80c512397d5611a5
kind: step
verb: sort
noun: primes
modifier: in_place
context: retry
phrase: sort retry primes in place
phrase: arrange prime retries in place
test: list=9,7,4,3,2
expect: => i=3 r=0.0 ok=true s="sorted 3 primes in place" errors=0 n=5 res=[9,2,4,3,7] cache=0 hits=0
test: list=15,11,8,5,2
expect: => i=3 r=0.0 ok=true s="sorted 3 primes in place" errors=0 n=5 res=[15,2,8,5,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_indices int[512] = [0; 512];
	var num_p = 0;
	for i in g.n {
		let num = g.res[i];
		if num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				prime_indices[num_p] = i;
				num_p++;
			}
		}
	}
	for i in num_p {
		for j in num_p - 1 {
			let idx1 = prime_indices[j];
			let idx2 = prime_indices[j + 1];
			if g.res[idx1] > g.res[idx2] {
				let tmp = g.res[idx1];
				g.res[idx1] = g.res[idx2];
				g.res[idx2] = tmp;
			}
		}
	}
	g.steps += num_p;
	out.i = num_p;
	out.s.clear();
	format(out.s, "sorted ", num_p, " primes in place");
	out
}
@end
@entry fb6a9247166b72af
kind: step
verb: filter
noun: runs
modifier: in_place
context: retry
phrase: filter runs of retries in place minimum {min_len}
phrase: retain retry runs in place exceeding {min_len}
slot: min_len int
test: list=1,1,2,3,3,3 min_len=2
expect: => i=5 r=0.0 ok=true s="filtered runs in place keeping 5 items" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,6,6,7,8,8 min_len=2
expect: => i=4 r=0.0 ok=true s="filtered runs in place keeping 4 items" errors=0 n=4 res=[6,6,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let run_len = j - i;
		if run_len >= ml {
			for k in run_len {
				g.res[write_idx] = g.res[i];
				write_idx++;
			}
		}
		i = j;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "filtered runs in place keeping ", write_idx, " items");
	out
}
@end
