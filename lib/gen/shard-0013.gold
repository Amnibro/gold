fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_digits = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x > 0 {
			sum_digits += x % 10;
			x /= 10;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = sum_digits;
	out.s.clear();
	format(out.s, "alternating digit sum: ", sum_digits);
	gold_push(g, sum_digits);
	out
}
@end
