@entry 42226b07b6752809
kind: step
verb: clamp
noun: total
modifier: with_cache
context: compare
phrase: clamp comparison total with cache limit {cap}
phrase: restrict comparison total with cache threshold {cap}
slot: cap int
test: list=10,20,30 cap=25
expect: => i=25 r=0.0 ok=true s="clamped comparison total is 25" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,8,12 cap=15
expect: => i=15 r=0.0 ok=true s="clamped comparison total is 15" errors=0 n=3 res=[5,8,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let cached, ok = gold_cache_get(g, total);
	var clamped = 0;
	if ok {
		clamped = cached;
	} else {
		clamped = if total > c { c } else { total };
		gold_cache_put(g, total, clamped);
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped comparison total is ", clamped);
	out
}
@end
