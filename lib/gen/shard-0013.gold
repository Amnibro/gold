@entry b4711a95131cc1a2
kind: step
verb: select
noun: primes
modifier: last
context: sort
phrase: select last {count} largest sorted prime numbers
phrase: isolate trailing {count} prime values from sorted list
slot: count int
test: list=10,3,7,4,5,2 count=2
expect: => i=2 r=0.0 ok=true s="selected 2 trailing primes" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=11,13,4 count=1
expect: => i=1 r=0.0 ok=true s="selected 1 trailing primes" errors=0 n=1 res=[13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var prime_indices int[512] = [0; 512];
	var prime_count = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			prime_indices[prime_count] = i;
			prime_count++;
		}
	}
	var start_idx = if prime_count > req { prime_count - req } else { 0 };
	var kept = 0;
	for i in start_idx..prime_count {
		g.res[kept] = g.res[prime_indices[i]];
		kept++;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " trailing primes");
	out
}
@end
