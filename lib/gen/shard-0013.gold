code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let tgt = ${target};
    var sum = 0;
    for i in g.n {
        sum += g.res[i];
    }
    var avg = 0;
    if g.n > 0 {
        avg = sum / g.n;
    }
    let matched = (avg == tgt);
    g.steps += g.n;
    out.ok = matched;
    out.i = avg;
    out.s.clear();
    if matched {
        format(out.s, "average matched target ", tgt);
    } else {
        format(out.s, "average did not match target ", tgt, ": avg ", avg);
    }
    gold_push(g, avg);
    out
}
@end
