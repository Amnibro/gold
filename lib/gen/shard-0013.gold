code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty dataset");
		g.steps++;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let last_val = g.res[g.n - 1];
	let diff = last_val - min_val;
	out.i = diff;
	out.s.clear();
	format(out.s, "diff from min ", diff);
	gold_push(g, diff);
	g.steps += g.n + 1;
	out
}
@end
