		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var cnt = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && g.res[i] > lim {
			g.res[i] = lim;
			cnt++;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	gold_text(out, "clamped evens");
	out
}
