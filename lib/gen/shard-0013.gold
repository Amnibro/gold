test: list=10,20,30 limit=5
expect: => i=0 r=0.0 ok=true s="rotations: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var rots = 0;
	if g.n > 1 {
		while rots < g.n && g.res[0] < lim {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
			rots++;
		}
	}
	g.steps += g.n;
	out.i = rots;
	out.s.clear();
	format(out.s, "rotations: ", rots);
	out
}
@end
