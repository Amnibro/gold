code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	if lim >= 0 && lim < g.n {
		g.n = lim;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected ", g.n, " history items");
	out
}
