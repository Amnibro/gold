expect: => i=2 r=0.0 ok=true s="reversed 2 square values" errors=0 n=3 res=[25,10,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sq_indices int[512] = [0; 512];
	var sq_count = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			sq_indices[sq_count] = i;
			sq_count++;
		}
	}
	var left = 0;
	var right = sq_count - 1;
	while left < right {
		let idx_l = sq_indices[left];
		let idx_r = sq_indices[right];
		let tmp = g.res[idx_l];
		g.res[idx_l] = g.res[idx_r];
		g.res[idx_r] = tmp;
		left++;
		right--;
	}
	g.steps += g.n * g.n;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "reversed ", sq_count, " square values");
	out
}
@end
