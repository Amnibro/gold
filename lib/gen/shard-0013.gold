code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${cache_slot};
	var span = 0;
	out.s.clear();
	if g.n > 0 {
		var lo = g.res[0];
		var hi = g.res[0];
		for i in 1..g.n {
			let x = g.res[i];
			if x < lo { lo = x; }
			if x > hi { hi = x; }
		}
		span = hi - lo;
		gold_cache_put(g, cs, span);
		format(out.s, "span: ", span, " (min=", lo, " max=", hi, ")");
	} else {
		format(out.s, "span: 0");
	}
	g.steps += g.n + 1;
	out.i = span;
	out
}
@end
