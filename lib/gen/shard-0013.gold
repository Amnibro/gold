@entry cbff3f1dd64f59b8
kind: step
verb: dedupe
noun: loop
modifier: in_reverse
context: math
phrase: dedupe math elements looping in reverse
phrase: remove duplicate values looping in reverse
test: list=4,2,4,7,2
expect: => i=3 r=0.0 ok=true s="deduped in reverse: 3" errors=0 n=3 res=[2,7,4] cache=0 hits=0
test: list=10,20,30,10,30,40
expect: => i=4 r=0.0 ok=true s="deduped in reverse: 4" errors=0 n=4 res=[40,30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let val = g.res[idx];
		var seen = false;
		for k in count {
			if temp[k] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			temp[count] = val;
			count++;
		}
		idx--;
	}
	for k in count {
		g.res[k] = temp[k];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "deduped in reverse: ", count);
	out
}
@end
