		count = g.n;
	}
	let start = g.n - count;
	var max_freq = 0;
	var i = start;
	while i < g.n {
		var freq = 0;
		var j = start;
		while j < g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
			j++;
		}
		if freq > max_freq {
			max_freq = freq;
		}
		i++;
	}
	g.steps += count;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "max frequency in last histogram window is ", max_freq);
	out
}
@end
