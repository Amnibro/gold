fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[>..] = [];
	var evens int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds.push(g.res[i]);
		} else {
			evens.push(g.res[i]);
		}
	}
	g.n = 0;
	for o in odds {
		gold_push(g, o);
	}
	for e in evens {
		gold_push(g, e);
	}
	g.steps += g.n;
	out.i = odds.len;
	out.s.clear();
	format(out.s, "partitioned ", odds.len, " odd values before even values");
	out
}
