fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var count = 0;
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "deltas=", count);
	out
}
