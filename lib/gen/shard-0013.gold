@entry 542c906db907fc92
kind: step
verb: drop
noun: threshold
modifier: with_retry
context: cache
phrase: drop threshold entries with retry
phrase: remove threshold items with retry mechanism
phrase: discard threshold values with retry attempts
slot: threshold int
test: list=10,25,30,45,50 threshold=30
expect: => i=2 r=0.0 ok=true s="dropped threshold retry 2" errors=0 n=4 res=[10,25,30,2] cache=1 hits=0
test: list=5,15,25,35,40 threshold=20
expect: => i=3 r=0.0 ok=true s="dropped threshold retry 3" errors=0 n=3 res=[5,15,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] > th {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	var retries = 0;
	while retries < 2 { retries++; }
	gold_cache_put(g, 0, dropped);
	gold_push(g, dropped);
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped threshold retry ", dropped);
	g.steps += kept + dropped + retries + 1;
	out
}
@end
