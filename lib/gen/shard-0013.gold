	var i = out.s.len;
	while i > 0 && vowels.len < limit {
		i--;
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		   b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U' {
			vowels.push(b);
		}
	}
	let count = vowels.len;
	out.s = vowels;
	out.i = count;
	gold_push(g, count);
	g.steps += count + 1;
	out
}
