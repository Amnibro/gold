expect: => i=0 r=0.0 ok=true s="validated primes in place remaining 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "validated primes in place remaining ", write);
	out
}
@end
