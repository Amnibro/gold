code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var b = ${budget};
	var count = 0;
	for i in g.n {
		if b >= g.res[i] {
			b -= g.res[i];
			count++;
		} else {
			g.res[i] = b;
			b = 0;
		}
	}
	gold_cache_put(g, 0, b);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "budget remaining=", b, " items funded=", count);
	out
}
@end
