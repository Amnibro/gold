	let k = ${run_len};
	if k <= 1 || g.n <= 1 {
		return out;
	}
	var start = 0;
	while start < g.n {
		var end = start + k - 1;
		if end >= g.n {
			end = g.n - 1;
		}
		var l = start;
		var r = end;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		start += k;
	}
	out.i = g.n;
	out
}
@end
