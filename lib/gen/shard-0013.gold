expect: => i=3 r=0.0 ok=true s="unique memo limit 3" errors=0 n=6 res=[5,5,6,6,7,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { seen = true; break; }
			j++;
		}
		if !seen {
			gold_cache_put(g, unique_count, g.res[i]);
			unique_count++;
		}
		i++;
	}
	gold_push(g, unique_count);
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique memo limit ", unique_count);
	g.steps += g.n + 1;
	out
}
@end
