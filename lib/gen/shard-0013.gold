@entry 57d54b0974d588c4
kind: step
verb: reverse
noun: histogram
modifier: in_place
context: core
phrase: reverse histogram in place across core results
phrase: in place reverse of core histogram frequency counts
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="reversed histogram frequencies in place count 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=10,20,20,30
expect: => i=3 r=0.0 ok=true s="reversed histogram frequencies in place count 3" errors=0 n=3 res=[1,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vals int[>..] = [];
	var freqs int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in vals.len {
			if vals[j] == x {
				freqs[j] += 1;
				found = true;
				break;
			}
		}
		if !found {
			vals.push(x);
			freqs.push(1);
		}
	}
	g.n = 0;
	var i = freqs.len - 1;
	while i >= 0 {
		gold_push(g, freqs[i]);
		i--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed histogram frequencies in place count ", g.n);
	out
}
@end
