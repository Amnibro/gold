code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inc = 0;
	if g.n > 2 {
		for i in (g.n - 2) {
			let w1 = g.res[i] + g.res[i + 1];
			let w2 = g.res[i + 1] + g.res[i + 2];
			if w2 > w1 { inc++; }
		}
	}
	g.steps += g.n;
	out.i = inc;
	out.s.clear();
	format(out.s, "increasing windows count ", inc);
	out
}
@end
