code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty histogram");
		g.steps++;
		return out;
	}
	let dropped = g.res[0];
	var i = 0;
	while i + 1 < g.n {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.n = g.n - 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped first bin ", dropped);
	g.steps += g.n + 1;
	out
}
@end
