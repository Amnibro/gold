fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf int[512] = [0; 512];
	var nb = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var seen = false;
			for j in nb {
				if buf[j] == x { seen = true; break; }
			}
			if !seen {
				buf[nb] = x;
				nb++;
			}
		}
	}
	for i in nb { g.res[i] = buf[i]; }
	g.n = nb;
	g.steps += g.n;
	out.i = nb;
	out.s.clear();
	format(out.s, "unique evens count ", nb);
	out
}
@end
