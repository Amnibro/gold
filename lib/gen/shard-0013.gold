kind: step
verb: return
noun: maximum
modifier: unique
context: retry
phrase: return maximum unique retry value
phrase: find highest unique value among retries
test: list=1,3,3,7,7,5
expect: => i=5 r=0.0 ok=true s="maximum unique retry is 5" errors=0 n=6 res=[1,3,3,7,7,5] cache=0 hits=0
test: list=10,20,20,15,30
expect: => i=30 r=0.0 ok=true s="maximum unique retry is 30" errors=0 n=5 res=[10,20,20,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var max_val = 0;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				cnt++;
			}
		}
		if cnt == 1 {
			if !found || g.res[i] > max_val {
				max_val = g.res[i];
				found = true;
			}
		}
	}
	g.steps += g.n;
	if !found {
		gold_fail(g, "no unique value found in retries");
		out.ok = false;
		return out;
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum unique retry is ", max_val);
	out
}
@end
