expect: => i=2 r=0.0 ok=true s="completed 2 bubble passes" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_steps};
	var pass = 0;
	while pass < limit {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
		pass++;
	}
	g.steps += g.n * pass;
	out.i = pass;
	out.s.clear();
	format(out.s, "completed ", pass, " bubble passes");
	out
}
@end
@entry b8f93faa7569b304
