modifier: up_to
context: core
phrase: reverse minimum up to threshold {bound} in core
phrase: invert core items whose values stay up to {bound}
slot: bound int
test: list=2,20,5,30,8 bound=10
expect: => i=1 r=0.0 ok=true s="reversed items up to bound count 1" errors=0 n=5 res=[8,20,5,30,2] cache=0 hits=0
test: list=50,1,100,3 bound=20
expect: => i=1 r=0.0 ok=true s="reversed items up to bound count 1" errors=0 n=4 res=[50,3,100,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var left = 0;
	var right = g.n - 1;
	var reversed = 0;
	while left < right {
		while left < right && g.res[left] > b { left++; }
		while left < right && g.res[right] > b { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			reversed++;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = reversed;
	out.s.clear();
	format(out.s, "reversed items up to bound count ", reversed);
	out
}
@end
