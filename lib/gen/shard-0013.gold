	}
	if min_val == 0 {
		// retry: add 1 to all
		for i in g.n { g.res[i] += 1; }
	} else {
		for i in g.n { g.res[i] -= min_val; }
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized list min=", min_val);
	out
}
@end
