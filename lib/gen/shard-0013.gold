phrase: clamp pairwise differences in loop to {max_diff}
phrase: loop pairwise restricting adjacent differences by {max_diff}
test: list=10,30,35 max_diff=5
expect: => i=3 r=0.0 ok=true s="clamped pairwise diffs: 3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=100,50,20 max_diff=20
expect: => i=3 r=0.0 ok=true s="clamped pairwise diffs: 3" errors=0 n=3 res=[100,80,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n >= 2 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			if d > md {
				g.res[i + 1] = g.res[i] + md;
			} else if d < -md {
				g.res[i + 1] = g.res[i] - md;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped pairwise diffs: ", g.n);
	out
}
@end
