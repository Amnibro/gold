fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sums int[32] = [0; 32];
	var i = g.n - 1;
	while i >= 1 {
		if count < 32 {
			sums[count] = g.res[i] + g.res[i-1];
			count++;
		}
		i -= 2;
	}
	for j in count {
		g.res[j] = sums[j];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reverse paired steps count=", count);
	out
}
@end
