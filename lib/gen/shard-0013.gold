@entry e04da5b877105db8
kind: step
verb: check
noun: evens
modifier: times
context: retry
phrase: check even values {count} times with retry loops
phrase: verify even parity {count} times using retry cycle
slot: count int
test: list=2,4,6 count=2
expect: => i=1 r=0.0 ok=true s="checked evens successfully 1" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=8,10 count=3
expect: => i=1 r=0.0 ok=true s="checked evens successfully 1" errors=0 n=2 res=[8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var all_even = true;
	for step in c {
		for i in g.n {
			if !core_is_even(g.res[i]) {
				all_even = false;
				break;
			}
		}
	}
	g.steps += c * g.n;
	out.ok = all_even;
	out.i = if all_even { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked evens successfully ", out.i);
	out
}
