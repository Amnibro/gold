fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let mid = g.res[g.n / 2];
		var j = g.n;
		while j > 0 {
			if j < 512 {
				g.res[j] = g.res[j - 1];
			}
			j--;
		}
		g.res[0] = mid;
		if g.n < 512 {
			g.n++;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated middle item at first pos total=", g.n);
	out
}
@end
