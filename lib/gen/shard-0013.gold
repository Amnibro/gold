@entry 6b8b76e6a6a1d9c2
kind: step
verb: cache
noun: words
modifier: unique
context: format
slot: cache_slot int
phrase: format cache words unique count to {cache_slot}
phrase: render distinct word count into cache {cache_slot}
test: text="apple banana apple" cache_slot=1
expect: => i=2 r=0.0 ok=true s="distinct words: 2" errors=0 n=0 res=[] cache=1 hits=0
test: text="one two three" cache_slot=2
expect: => i=3 r=0.0 ok=true s="distinct words: 3" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${cache_slot};
	var wstarts int[..30] = [];
	var wlens int[..30] = [];
	var in_w = false;
	var ws = 0;
	var wl = 0;
	for i in v.s.len {
		if v.s[i] != ' ' {
			if !in_w { ws = i; wl = 1; in_w = true; } else { wl++; }
		} else {
			if in_w { wstarts.push(ws); wlens.push(wl); in_w = false; }
		}
	}
	if in_w { wstarts.push(ws); wlens.push(wl); }
	var uniq = 0;
	for i in wstarts.len {
		var seen = false;
		for j in i {
			if wlens[i] == wlens[j] {
				var same = true;
				for k in wlens[i] {
					if v.s[wstarts[i] + k] != v.s[wstarts[j] + k] { same = false; break; }
				}
				if same { seen = true; break; }
			}
		}
		if !seen { uniq++; }
	}
	gold_cache_put(g, cs, uniq);
	out.s.clear();
	format(out.s, "distinct words: ", uniq);
	g.steps += v.s.len + 1;
	out.i = uniq;
	out
}
@end
