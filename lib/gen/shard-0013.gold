code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    for i in g.n {
        for j in g.n - 1 - i {
            if g.res[j] > g.res[j + 1] {
                let tmp = g.res[j];
                g.res[j] = g.res[j + 1];
                g.res[j + 1] = tmp;
            }
        }
    }
    let pairs = g.n / 2;
    for i in pairs {
        g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
    }
    g.n = pairs;
    g.steps += g.n;
    out.i = pairs;
    out.s.clear();
    format(out.s, "paired sorted elements: ", pairs);
    out
}
@end
