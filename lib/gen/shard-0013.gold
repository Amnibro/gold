expect: => i=2 r=0.0 ok=true s="found 2 short runs" errors=0 n=8 res=[5,5,5,6,7,7,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var matched = 0;
	var i = 0;
	while i < g.n {
		var len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			len++;
			i++;
		}
		if len <= limit { matched++; }
		i++;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "found ", matched, " short runs");
	gold_push(g, matched);
	g.steps += g.n + 1;
	out
}
@end
