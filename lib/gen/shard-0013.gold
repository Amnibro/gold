code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_s = 1;
	var cur_s = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_s++;
			if cur_s > max_s {
				max_s = cur_s;
			}
		} else {
			cur_s = 1;
		}
	}
	gold_clear(g);
	gold_push(g, max_s);
	out.i = max_s;
	out.s.clear();
	format(out.s, "streak length: ", max_s);
	out
}
@end
