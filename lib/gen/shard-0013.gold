code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || g.n == 0 {
		gold_fail(g, "invalid suffix length");
		out.ok = false;
		return out;
	}
	var count = k;
	if count > g.n {
		count = g.n;
	}
	var s = 0;
	var i = g.n - count;
	while i < g.n {
		s += g.res[i];
		i++;
	}
	g.steps += count;
	out.i = s;
	out.s.clear();
	format(out.s, "folded ", count, " suffix retry items");
	out
}
@end
