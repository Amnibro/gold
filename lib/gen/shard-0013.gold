code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var max_val = 0;
	if g.n > 0 {
		max_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] > max_val { max_val = g.res[i]; }
		}
	}
	var total = 0;
	for i in g.n {
		if g.res[i] == max_val { total += g.res[i]; }
	}
	if total < thresh {
		for i in g.n { total += g.res[i]; }
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed max with retry: ", total);
	gold_push(g, total);
	out
}
@end
@entry 8f2befd04ae1aa33
kind: step
verb: limit
noun: average
modifier: safely
context: math
phrase: limit average safely below bound {max_avg}
phrase: restrict mean safely to maximum {max_avg}
slot: max_avg int
test: list=10,20,30,40,50 max_avg=25
expect: => i=4 r=25.0 ok=true s="average limited safely to 25.0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=15,25,35 max_avg=20
expect: => i=2 r=20.0 ok=true s="average limited safely to 20.0" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_avg};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	while g.n > 0 && (sum as real / g.n as real) > (ma as real) {
		sum -= g.res[g.n - 1];
		g.n -= 1;
	}
	let avg = if g.n > 0 { sum as real / g.n as real } else { 0.0 };
	g.steps += g.n;
	out.i = g.n;
	out.r = avg;
	out.s.clear();
	format(out.s, "average limited safely to ", avg);
	out
}
@end
