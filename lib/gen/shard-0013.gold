fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mx = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] > mx {
			mx = g.res[i];
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == mx {
			count++;
		}
	}
	gold_clear(g);
	if count == 1 {
		gold_push(g, mx);
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += count;
	out.i = mx;
	out.s.clear();
	format(out.s, "unique maximum: ", mx);
	out
}
@end
