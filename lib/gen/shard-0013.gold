code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${win};
	if req > g.n || req <= 0 {
		gold_fail(g, "invalid reverse window size");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var idx = g.n - 1;
	for w in req {
		sum += g.res[idx];
		idx--;
	}
	g.steps += req;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged reverse window sum ", sum);
	out
}
@end
@entry 4ca8b2a76b1d35d6
kind: step
verb: map
noun: loop
modifier: in_reverse
context: error
phrase: map loop in reverse order checking negative {factor}
phrase: scale loop items backwards guarding sign {factor}
slot: factor int
test: list=1,2,3 factor=2
expect: => i=3 r=0.0 ok=true s="mapped loop in reverse successfully" errors=0 n=3 res=[6,4,2] cache=0 hits=0
test: list=10,20 factor=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${factor} < 0 {
		gold_fail(g, "negative scaling factor is not permitted");
		out.ok = false;
		return out;
	}
	var l = 0;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	for i in g.n {
		g.res[i] = g.res[i] * ${factor};
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped loop in reverse successfully");
	out
}
@end
