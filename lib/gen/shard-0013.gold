code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var temp int[..100] = [];
	if g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			if g.res[i] > mv {
				temp.push(g.res[i]);
			}
			if i == 0 { break; }
			i--;
		}
	}
	for i in temp.len {
		g.res[i] = temp[i];
	}
	g.steps += g.n + 1;
	g.n = temp.len;
	out.i = temp.len;
	out.s.clear();
	format(out.s, "scanned ", temp.len, " elements in reverse");
	out
}
@end
