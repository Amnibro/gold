@entry 46d8408f81817420
kind: step
verb: repeat
noun: loop
modifier: sorted
context: math
slot: times int
phrase: repeat sorted sequence loop {times} cycles
phrase: duplicate sorted results for {times} passes
test: list=3,1 times=2
expect: => i=4 r=0.0 ok=true s="repeated sorted loop: 4" errors=0 n=4 res=[1,3,1,3] cache=0 hits=0
test: list=9,4,2 times=1
expect: => i=3 r=0.0 ok=true s="repeated sorted loop: 3" errors=0 n=3 res=[2,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let orig_n = g.n;
	var cur_pass = 1;
	while cur_pass < t && g.n + orig_n <= 512 {
		for i in orig_n {
			gold_push(g, g.res[i]);
		}
		cur_pass++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated sorted loop: ", g.n);
	out
}
@end
