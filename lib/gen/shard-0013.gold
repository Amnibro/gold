test: list=100,5 bound=50
expect: => i=2 r=0.0 ok=true s="clamped with cache: 2" errors=0 n=2 res=[50,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	for i in g.n {
		if g.res[i] > b {
			g.res[i] = b;
		} else if g.res[i] < -b {
			g.res[i] = -b;
		}
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped with cache: ", g.n);
	out
}
@end
