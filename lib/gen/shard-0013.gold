@entry f92250c018141f35
kind: step
verb: retry
noun: results
modifier: pairwise
context: compare
phrase: retry pairwise comparisons across results
phrase: evaluate adjacent result pairs with retry
test: list=1,3,2,5
expect: => i=2 r=0.0 ok=true s="pairwise increasing comparisons=2" errors=0 n=4 res=[1,3,2,5] cache=0 hits=0
test: list=4,3,2,1
expect: => i=3 r=0.0 ok=true s="pairwise increasing comparisons=3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inc = 0;
	for i in (g.n - 1) {
		if g.res[i] < g.res[i+1] { inc++; }
	}
	if inc == 0 && g.n >= 2 {
		// retry: reverse array and recheck
		for i in (g.n / 2) {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
		for i in (g.n - 1) {
			if g.res[i] < g.res[i+1] { inc++; }
		}
	}
	g.steps += g.n * 2;
	out.i = inc;
	out.s.clear();
	format(out.s, "pairwise increasing comparisons=", inc);
	out
}
@end
