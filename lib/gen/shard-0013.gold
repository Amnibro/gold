kind: step
verb: limit
noun: gaps
modifier: unique
context: math
phrase: limit gaps to unique maximum {max_gap}
phrase: restrict unique differences by bound {max_gap}
slot: max_gap int
test: list=1,5,12,20 max_gap=4
expect: => i=4 r=0.0 ok=true s="limited gaps to max: 4" errors=0 n=4 res=[1,5,9,13] cache=0 hits=0
test: list=10,25,35 max_gap=8
expect: => i=3 r=0.0 ok=true s="limited gaps to max: 8" errors=0 n=3 res=[10,18,26] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > mg {
				g.res[i] = g.res[i - 1] + mg;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited gaps to max: ", mg);
	out
}
@end
