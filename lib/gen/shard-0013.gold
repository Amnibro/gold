noun: pairs
modifier: unique
context: stats
phrase: retry counting unique consecutive value pairs in sample
phrase: find distinct adjacent value pairs across sample
test: list=1,2,1,2,3
expect: => i=3 r=0.0 ok=true s="unique=3" errors=0 n=5 res=[1,2,1,2,3] cache=0 hits=0
test: list=4,5,6,7
expect: => i=3 r=0.0 ok=true s="unique=3" errors=0 n=4 res=[4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var seen = false;
		for j in i {
			if g.res[j] == a && g.res[j + 1] == b { seen = true; break; }
		}
		if !seen { unique_pairs++; }
		i++;
	}
	g.steps += g.n;
	out.i = unique_pairs;
	out.s.clear();
	format(out.s, "unique=", unique_pairs);
	out
}
@end
