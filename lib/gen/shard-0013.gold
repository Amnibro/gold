@entry ce616aa68cac27d0
kind: step
verb: dedupe
noun: maximum
modifier: between
context: transform
phrase: dedupe maximum values between bounds {low} to {high}
phrase: prune duplicate maximum values between limits {low} to {high}
slot: low int
slot: high int
test: list=10,25,25,30,25,50 low=20 high=40
expect: => i=4 r=0.0 ok=true s="deduped items between bounds 20 to 40 remaining length 4" errors=0 n=4 res=[10,25,30,50] cache=0 hits=0
test: list=5,15,15,15,30,40 low=10 high=35
expect: => i=4 r=0.0 ok=true s="deduped items between bounds 10 to 35 remaining length 4" errors=0 n=4 res=[5,15,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		if val >= l && val <= h {
			var exists = false;
			for j in write_idx {
				if g.res[j] == val {
					exists = true;
				}
			}
			if !exists {
				g.res[write_idx] = val;
				write_idx++;
			}
		} else {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped items between bounds ", l, " to ", h, " remaining length ", g.n);
	out
}
@end
