fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped = false;
	if g.n >= 4 {
		let m0 = g.n / 2 - 1;
		let m1 = g.n / 2;
		if g.res[m0] > g.res[m1] {
			let tmp = g.res[m0];
			g.res[m0] = g.res[m1];
			g.res[m1] = tmp;
			swapped = true;
		}
	}
	g.steps += g.n;
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "swapped middle running=", swapped);
	out
}
@end
