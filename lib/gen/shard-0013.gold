context: error
phrase: keep target value {target} with cache tracking
phrase: retain specified item {target} using cache verification
slot: target int
test: list=5,10,15,10 target=10
expect: => i=2 r=0.0 ok=true s="kept target matches 2" errors=0 n=2 res=[10,10] cache=2 hits=0
test: list=1,2,3 target=99
expect: => i=0 r=0.0 ok=false s="kept target matches 0" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	let goal = ${target};
	for i in g.n {
		if g.res[i] == goal {
			g.res[kept] = goal;
			gold_cache_put(g, kept, goal);
			kept++;
		}
	}
	if kept == 0 {
		gold_fail(g, "target value not found in list");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept target matches ", kept);
	out
}
@end
@entry ab7421bcbdc41cef
kind: step
verb: swap
noun: maximum
modifier: recursively
context: error
phrase: swap maximum element to front recursively checking empty
phrase: move maximum item forward recursively validating list
test: list=3,9,5,2
expect: => i=9 r=0.0 ok=true s="swapped maximum to front 9" errors=0 n=4 res=[9,3,5,2] cache=0 hits=0
test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot swap maximum on empty list");
		out.ok = false;
		return out;
	}
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
	}
	if max_idx != 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[max_idx];
		g.res[max_idx] = tmp;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "swapped maximum to front ", out.i);
	out
}
@end
@entry 69de4610a6268087
kind: step
verb: pair
noun: evens
modifier: recursively
context: error
phrase: pair even numbers recursively catching odd count
phrase: combine even values recursively checking count parity
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="paired even numbers 2" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_cnt = 0;
	for i in g.n {
		if core_is_even(g.res[i]) {
			even_cnt++;
		}
	}
	if even_cnt % 2 != 0 {
		gold_fail(g, "odd number of even elements cannot be paired");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if core_is_even(g.res[i]) && core_is_even(g.res[i + 1]) {
			g.res[pairs] = g.res[i] + g.res[i + 1];
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired even numbers ", pairs);
	out
}
@end
