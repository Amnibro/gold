code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let offset = ${inc};
	let old_n = g.n;
	var count = 0;
	for i in old_n {
		if g.n < 512 {
			gold_push(g, g.res[i] + offset);
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "joined ", count, " incremented comparison loop elements");
	out
}
@end
