kind: step
verb: compare
noun: step
modifier: sorted
context: stats
phrase: compare step differences across sorted values
phrase: check step increments after sorting sample
phrase: measure step progression when sorted
test: list=9,2,7,4
expect: => i=3 r=0.0 ok=true s="sorted step max 3" errors=0 n=5 res=[2,4,7,9,3] cache=0 hits=0
test: list=15,10,30,5
expect: => i=15 r=0.0 ok=true s="sorted step max 15" errors=0 n=5 res=[5,10,15,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var max_step = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		if diff > max_step { max_step = diff; }
		k++;
	}
	out.i = max_step;
	out.s.clear();
	format(out.s, "sorted step max ", max_step);
	gold_push(g, max_step);
	g.steps += g.n + 1;
	out
}
@end
