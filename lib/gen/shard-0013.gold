@entry 9eb0f08b5f2d5fc9
kind: step
verb: dedupe
noun: middle
modifier: nested
context: list
phrase: dedupe middle elements in list
phrase: remove duplicate middle values
test: list=1,2,2,3,3,4
expect: => i=4 r=0.0 ok=true s="deduped middle: new length 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,5,5,5,20
expect: => i=3 r=0.0 ok=true s="deduped middle: new length 3" errors=0 n=3 res=[10,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n > 3 {
        var keep int[512] = [0; 512];
        keep[0] = g.res[0];
        var nk = 1;
        for i in 1..g.n - 1 {
            let x = g.res[i];
            var seen = false;
            for j in 1..nk {
                if keep[j] == x {
                    seen = true;
                    break;
                }
            }
            if !seen {
                keep[nk] = x;
                nk++;
            }
        }
        keep[nk] = g.res[g.n - 1];
        nk++;
        for i in nk { g.res[i] = keep[i]; }
        g.n = nk;
    }
    g.steps += g.n;
    out.i = g.n;
    out.s.clear();
    format(out.s, "deduped middle: new length ", g.n);
    out
}
@end
