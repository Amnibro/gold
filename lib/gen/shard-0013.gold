	var out = v;
	let c = ${cap};
	if g.n == 0 || c <= g.n {
		out.i = g.n;
		return out;
	}
	var i = 0;
	let orig_n = g.n;
	while g.n < c && g.n < 512 {
		gold_push(g, g.res[i % orig_n]);
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated numbers up to capacity ", c, " resulting in ", g.n);
	out
}
@end
