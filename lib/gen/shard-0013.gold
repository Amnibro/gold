expect: => i=2 r=0.0 ok=true s="ranked gaps with cache is 2" errors=0 n=4 res=[1,10,14,22] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached, ok = gold_cache_get(g, tgt);
	var count = 0;
	if ok {
		count = cached;
	} else {
		for i in g.n - 1 {
			var gap = g.res[i + 1] - g.res[i];
			if gap < 0 {
				gap = -gap;
			}
			if gap >= tgt {
				count++;
			}
		}
		gold_cache_put(g, tgt, count);
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked gaps with cache is ", count);
	out
}
@end
