code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit_sum};
	out.s.clear();
	format(out.s, "series: [");
	var s = 0;
	var kept = 0;
	for i in g.n {
		if s + g.res[i] > lim { break; }
		if kept > 0 { format(out.s, ", "); }
		format(out.s, g.res[i]);
		s += g.res[i];
		kept++;
	}
	format(out.s, "]");
	g.steps += g.n + 1;
	out.i = kept;
	out
}
@end
