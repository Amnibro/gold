@entry bcc24db122ad237d
kind: step
verb: run
noun: words
modifier: in_reverse
context: format
phrase: format run words in reverse order
phrase: render string reversing word sequence
test: text="alpha beta gamma"
expect: => i=3 r=0.0 ok=true s="reversed: gamma beta alpha" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world"
expect: => i=2 r=0.0 ok=true s="reversed: world hello" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_starts int[..50] = [];
	var word_lens int[..50] = [];
	var in_word = false;
	var wstart = 0;
	var wlen = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c != ' ' {
			if !in_word {
				wstart = i;
				wlen = 1;
				in_word = true;
			} else {
				wlen++;
			}
		} else {
			if in_word {
				word_starts.push(wstart);
				word_lens.push(wlen);
				in_word = false;
			}
		}
	}
	if in_word {
		word_starts.push(wstart);
		word_lens.push(wlen);
	}
	out.s.clear();
	format(out.s, "reversed: ");
	if word_starts.len > 0 {
		var i = word_starts.len - 1;
		while i >= 0 {
			let st = word_starts[i];
			let ln = word_lens[i];
			for k in ln {
				out.s.push(v.s[st + k]);
			}
			if i > 0 { out.s.push(' '); }
			if i == 0 { break; }
			i--;
		}
	}
	g.steps += v.s.len + 1;
	out.i = word_starts.len;
	out
}
@end
