			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += bound * bound + 1;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted range at most bound=", bound);
	out
}
@end
