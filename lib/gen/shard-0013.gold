fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { count++; }
		}
	}
	gold_push(g, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted primes none exceeding limit count ", count);
	out
}
