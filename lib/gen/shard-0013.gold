expect: => i=2 r=0.0 ok=true s="deduped 2 streak retries in place" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var write_idx = 1;
	var removed = 0;
	var read_idx = 1;
	while read_idx < g.n {
		if g.res[read_idx] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[read_idx];
			write_idx++;
		} else {
			removed++;
		}
		read_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " streak retries in place");
	out
}
@end
