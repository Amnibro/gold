fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var match_idx = -1;
	if g.n >= 2 {
		for i in g.n - 1 {
			if ${p}(g.res[i]) && ${p}(g.res[i + 1]) {
				found = true;
				match_idx = i;
				break;
			}
		}
	}
	out.ok = found;
	out.i = match_idx;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "pairwise condition match: ", match_idx);
	out
}
@end
