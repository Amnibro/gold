fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_freq};
	var kept = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
