kind: step
verb: scale
noun: duplicates
modifier: safely
context: compare
phrase: scale duplicate elements safely by {factor}
phrase: multiply duplicate occurrences safely by {factor}
slot: factor int
test: list=2,2,3,4,4 factor=3
expect: => i=2 r=0.0 ok=true s="scaled duplicate elements=2" errors=0 n=5 res=[6,2,3,12,4] cache=0 hits=0
test: list=1,2,3 factor=5
expect: => i=0 r=0.0 ok=true s="scaled duplicate elements=0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for i in g.n {
		var is_dup = false;
		for j in g.n {
			if i != j && g.res[i] == g.res[j] { is_dup = true; break; }
		}
		if is_dup {
			g.res[i] *= f;
			scaled++;
		}
	}
	g.steps += g.n * g.n;
