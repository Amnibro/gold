code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = if ${step_size} > 0 { ${step_size} } else { 1 };
	var kept = 0;
	var i = 0;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i += st;
	}
	let dropped = g.n - kept;
	g.n = kept;
	gold_cache_put(g, 0, dropped);
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept step items=", kept, " dropped=", dropped);
	out
}
@end
@entry d3f430b5a1808a2a
kind: step
verb: pair
noun: budget
modifier: running
context: transform
phrase: pair budget items with running cost
phrase: combine adjacent elements with running budget {budget}
slot: budget int
test: list=10,20,15,25 budget=40
expect: => i=1 r=0.0 ok=true s="paired running budget count=1" errors=0 n=1 res=[30] cache=0 hits=0
test: list=50,60 budget=40
expect: => i=0 r=0.0 ok=true s="paired running budget count=0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let psum = g.res[i] + g.res[i+1];
		if running + psum <= b {
			running += psum;
			g.res[count] = psum;
			count++;
			i += 2;
		} else {
			break;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "paired running budget count=", count);
	out
}
@end
