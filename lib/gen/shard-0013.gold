fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pat = ${target};
	var errs = 0;
	if pat.len > 0 && out.s.len >= pat.len {
		for i in out.s.len - pat.len + 1 {
			var matched = true;
			for k in pat.len {
				if out.s[i + k] != pat[k] {
					matched = false;
					break;
				}
			}
			if matched {
				errs++;
			}
		}
	}
	g.errors += errs;
	g.steps += out.s.len;
	out.i = errs;
	out.ok = errs == 0;
	out
}
@end
