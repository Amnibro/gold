fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, g.res[i], i);
	}
	let target = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	let val, ok = gold_cache_get(g, target);
	out.ok = ok;
	out.i = target;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reverse cache found: ", ok);
	out
}
@end
