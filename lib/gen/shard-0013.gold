test: list=7,7,8,9,9
expect: => i=3 r=0.0 ok=true s="grouped 3 item tallies" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vals int[512] = [0; 512];
	var counts int[512] = [0; 512];
	var nv = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in nv {
			if vals[j] == x { found = j; break; }
		}
		if found >= 0 {
			counts[found] += 1;
		} else {
			vals[nv] = x;
			counts[nv] = 1;
			nv++;
		}
	}
	for i in nv { g.res[i] = counts[i]; }
	g.n = nv;
	g.steps += g.n;
	out.i = nv;
	out.s.clear();
	format(out.s, "grouped ", nv, " item tallies");
	out
}
@end
