noun: budget
modifier: last
context: math
slot: budget int
phrase: repeat last math item within budget {budget}
phrase: duplicate final value using budget {budget}
test: list=10,5 budget=15
expect: => i=0 r=0.0 ok=true s="repeated last item remaining budget: 0" errors=0 n=5 res=[10,5,5,5,5] cache=0 hits=0
test: list=7 budget=20
expect: => i=6 r=0.0 ok=true s="repeated last item remaining budget: 6" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	if g.n > 0 {
		let val = g.res[g.n - 1];
		var cost = if val < 0 { -val } else { val };
		if cost == 0 {
			cost = 1;
		}
		while rem >= cost && g.n < 512 {
			gold_push(g, val);
			rem -= cost;
		}
	}
	g.steps++;
	out.i = rem;
	out.s.clear();
	format(out.s, "repeated last item remaining budget: ", rem);
	out
}
@end
