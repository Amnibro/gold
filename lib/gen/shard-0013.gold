	let lim = ${budget};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] <= lim { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "within_budget=", count);
	out
}
