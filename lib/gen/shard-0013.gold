expect: => i=8 r=0.0 ok=false s="middle element 8 cached with limit 5" errors=1 n=3 res=[2,8,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid = g.res[g.n / 2];
	gold_cache_put(g, mid, 1);
	let valid = mid <= lim;
	if !valid {
		out.ok = false;
		gold_fail(g, "middle element exceeded cache limit");
	}
	g.steps += 1;
	out.i = mid;
	out.s.clear();
	format(out.s, "middle element ", mid, " cached with limit ", lim);
	out
}
@end
