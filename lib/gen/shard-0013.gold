fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_allowed};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < limit {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "normalized to ", kept, " items");
	out
}
@end
