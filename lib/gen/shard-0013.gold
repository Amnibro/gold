expect: => i=15 r=0.0 ok=true s="" errors=0 n=4 res=[5,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum_uniq = 0;
	for i in g.n {
		var dup = false;
		for j in i {
			if g.res[j] == g.res[i] { dup = true; }
		}
		if !dup { sum_uniq += g.res[i]; }
	}
	out.i = b - sum_uniq;
	gold_push(g, out.i);
	out
}
@end
