noun: step
modifier: times
context: transform
slot: shift_amount int
phrase: transform shift step times circularly {shift_amount}
phrase: rotate sequence positions by step count {shift_amount}
test: list=1,2,3,4 shift_amount=1
expect: => i=1 r=0.0 ok=true s="shifted results by 1 steps" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20 shift_amount=1
expect: => i=1 r=0.0 ok=true s="shifted results by 1 steps" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let sa = ${shift_amount} % g.n;
	var tmp: int[512] = [0; 512];
	for i in g.n {
		let new_idx = (i + sa) % g.n;
		tmp[new_idx] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n * 2 + 1;
	out.i = sa;
	out.s.clear();
	format(out.s, "shifted results by ", sa, " steps");
	out
}
@end
