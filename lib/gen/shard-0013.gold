modifier: sorted
context: core
phrase: group steps in sorted sequence
phrase: organize step results in sorted order
test: list=9,3,7,1,5
expect: => i=5 r=0.0 ok=true s="sorted 5 step items" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=20,10,40,30
expect: => i=4 r=0.0 ok=true s="sorted 4 step items" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " step items");
	out
}
@end
