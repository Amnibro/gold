@entry 1a07024202876244
kind: step
verb: scale
noun: primes
modifier: at_most
context: transform
phrase: scale prime elements at most {limit} times by {factor}
phrase: multiply prime numbers at most {limit} occurrences by {factor}
slot: limit int
slot: factor int
test: list=2,3,4,5,6 limit=2 factor=3
expect: => i=2 r=0.0 ok=true s="scaled primes count=2" errors=0 n=5 res=[6,9,4,5,6] cache=0 hits=0
test: list=4,6,8 limit=2 factor=2
expect: => i=0 r=0.0 ok=true s="scaled primes count=0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let f = ${factor};
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && scaled < lim {
				g.res[i] *= f;
				scaled++;
			}
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled primes count=", scaled);
	out
}
@end
