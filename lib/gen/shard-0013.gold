fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_odd = 0;
	var found = false;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] % 2 != 0 {
			last_odd = g.res[idx];
			found = true;
			break;
		}
		idx--;
	}
	gold_clear(g);
	if found {
		gold_push(g, last_odd);
	}
	out.ok = found;
	out.i = last_odd;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "last odd item: ", last_odd);
	out
}
@end
