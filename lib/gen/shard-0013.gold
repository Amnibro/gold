context: cache
phrase: shift average recursively across cache
phrase: displace average recursively in cache
phrase: adjust average by recursive passes
slot: passes int
test: list=10,20,30,40 passes=2
expect: => i=50 r=0.0 ok=true s="shifted average recursive 50" errors=0 n=5 res=[60,70,80,90,50] cache=1 hits=0
test: list=5,15,25,35 passes=3
expect: => i=60 r=0.0 ok=true s="shifted average recursive 60" errors=0 n=5 res=[65,75,85,95,60] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = if g.n > 0 { total / g.n } else { 0 };
	let shift_val = avg * p;
	for i in g.n {
		g.res[i] += shift_val;
	}
	gold_cache_put(g, 0, shift_val);
	gold_push(g, shift_val);
	out.i = shift_val;
	out.s.clear();
	format(out.s, "shifted average recursive ", shift_val);
	g.steps += g.n + 1;
	out
}
@end
