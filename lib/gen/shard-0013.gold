fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted: ", g.n);
