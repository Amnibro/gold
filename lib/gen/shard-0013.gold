@entry ed98f8f147fe7d19
kind: step
verb: scale
noun: runs
modifier: up_to
context: filter
phrase: scale run sequences up to length {max_len} by {factor}
phrase: multiply consecutive runs up to {max_len} by {factor}
slot: max_len int
slot: factor int
test: list=1,1,2,3,3,3 max_len=2 factor=3
expect: => i=3 r=0.0 ok=true s="scaled runs up to count=3" errors=0 n=6 res=[3,3,6,3,3,3] cache=0 hits=0
test: list=4,4,4,4 max_len=2 factor=2
expect: => i=0 r=0.0 ok=true s="scaled runs up to count=0" errors=0 n=4 res=[4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	let f = ${factor};
	var scaled = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len <= ml {
			for k in i..j {
				g.res[k] *= f;
				scaled++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled runs up to count=", scaled);
	out
}
@end
