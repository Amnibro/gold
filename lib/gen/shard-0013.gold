code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var k = 0;
	while k < g.n && g.res[k] < lim {
		k++;
	}
	for i in (k / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[k - 1 - i];
		g.res[k - 1 - i] = tmp;
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed threshold items=", k);
	out
}
@end
