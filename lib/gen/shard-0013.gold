fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for i in old_n {
		orig[i] = g.res[i];
	}
	g.n = 0;
	for i in old_n {
		let x = orig[i];
		gold_push(g, x);
		if x <= limit {
			gold_push(g, x);
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated checkpoint safely total=", g.n);
	out
}
@end
