@entry b902a2e710912325
kind: step
verb: merge
noun: average
modifier: last
context: sort
phrase: append average of last {k} sorted items
phrase: compute mean of trailing {k} sorted elements
slot: k int
test: list=10,40,20,30 k=2
expect: => i=35 r=0.0 ok=true s="appended trailing average 35" errors=0 n=5 res=[10,20,30,40,35] cache=0 hits=0
test: list=3,9,6 k=3
expect: => i=6 r=0.0 ok=true s="appended trailing average 6" errors=0 n=4 res=[3,6,9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	var used = 0;
	var idx = g.n - 1;
	while idx >= 0 && used < count {
		sum += g.res[idx];
		used++;
		idx--;
	}
	let avg = if used > 0 { sum / used } else { 0 };
	gold_push(g, avg);
	g.steps += g.n + used;
	out.i = avg;
	out.s.clear();
	format(out.s, "appended trailing average ", avg);
	out
}
@end
@entry 8ebca0f212b71fb3
kind: step
verb: scan
noun: window
modifier: with_retry
context: sort
phrase: scan sliding window of size {win} over sorted items
phrase: inspect ordered window of length {win} with retry verification
slot: win int
test: list=5,1,9,3 win=2
expect: => i=3 r=0.0 ok=true s="scanned 3 valid windows" errors=0 n=4 res=[1,3,5,9] cache=0 hits=0
test: list=4,2 win=3
expect: => i=0 r=0.0 ok=false s="invalid window size" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if w <= 0 || w > g.n {
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "invalid window size");
	} else {
		let num_windows = g.n - w + 1;
		out.ok = true;
		out.i = num_windows;
		out.s.clear();
		format(out.s, "scanned ", num_windows, " valid windows");
	}
	g.steps += g.n * g.n;
	out
}
