fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if core_is_square(a) && core_is_square(b) && a > b {
			g.res[i] = b;
			g.res[i + 1] = a;
			gold_cache_put(g, a, b);
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " square pairs");
	out
}
@end
@entry 1e1ab7ccc6b62f4a
kind: step
verb: reverse
noun: runs
modifier: between
context: cache
phrase: reverse runs between boundary values {low} to {high}
phrase: invert sequential runs between limits {low} to {high}
slot: low int
slot: high int
test: list=5,12,14,16,25 low=10 high=20
expect: => i=3 r=0.0 ok=true s="reversed run of length 3" errors=0 n=5 res=[5,16,14,12,25] cache=2 hits=0
test: list=2,6,8,12,30 low=5 high=15
expect: => i=3 r=0.0 ok=true s="reversed run of length 3" errors=0 n=5 res=[2,12,8,6,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = -1;
	var end = -1;
	for i in g.n {
		let x = g.res[i];
		if x >= ${low} && x <= ${high} {
			if start == -1 { start = i; }
			end = i;
		}
	}
	if start != -1 && end > start {
		var l = start;
		var r = end;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			gold_cache_put(g, l, g.res[l]);
			gold_cache_put(g, r, g.res[r]);
			l++;
			r--;
		}
	}
	g.steps += g.n;
	out.i = if start != -1 { end - start + 1 } else { 0 };
	out.s.clear();
	format(out.s, "reversed run of length ", out.i);
	out
}
@end
