@entry 2aafec08acad59d7
kind: step
verb: scale
noun: tail
modifier: while
context: cache
phrase: scale tail elements while condition {p} holds by {factor}
phrase: multiply suffix items by {factor} while predicate {p} holds
slot: p pred
slot: factor int
test: list=10,4,6,8 p=is_even factor=2
expect: => i=4 r=0.0 ok=true s="scaled 4 tail items" errors=0 n=4 res=[20,8,12,16] cache=4 hits=0
