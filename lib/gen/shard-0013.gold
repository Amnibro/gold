@entry 08e66b6d6f84c288
kind: step
verb: fold
noun: streak
modifier: last
context: list
phrase: fold streak of last elements
phrase: collapse last streak in list
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="folded last streak: count 3 sum 9" errors=0 n=3 res=[1,2,9] cache=0 hits=0
test: list=5,4,2,2
expect: => i=2 r=0.0 ok=true s="folded last streak: count 2 sum 4" errors=0 n=3 res=[5,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 { return out; }
    let last_val = g.res[g.n - 1];
    var streak = 0;
    var i = g.n - 1;
    while i >= 0 && g.res[i] == last_val {
        streak++;
        if i == 0 { break; }
        i--;
    }
    let total = streak * last_val;
    g.n = g.n - streak;
    g.res[g.n] = total;
    g.n++;
    g.steps += streak;
    out.i = streak;
    out.s.clear();
    format(out.s, "folded last streak: count ", streak, " sum ", total);
    out
}
@end
