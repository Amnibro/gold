fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let is_letter = (x >= 65 && x <= 90) || (x >= 97 && x <= 122);
		if !is_letter {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "non letter items: ", kept);
	out
}
