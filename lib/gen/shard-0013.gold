code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok_all = true;
	for i in g.n {
		if !${sub}(g.res[i]) { ok_all = false; break; }
	}
	g.steps += g.n;
	out.ok = ok_all;
	out.i = if ok_all { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked subfunction safely status ", out.i);
	out
}
@end
@entry 9bb8c1592ed73107
kind: step
verb: keep
noun: middle
modifier: with_retry
context: math
phrase: keep middle with retry extracting central {count} mathematical items
phrase: retain central {count} items with retry in mathematical list
slot: count int
test: list=1,2,3,4,5,6 count=2
expect: => i=2 r=0.0 ok=true s="kept middle items with retry count 2" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="kept middle items with retry count 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var want = k;
	if want > g.n { want = g.n; }
	if want < 0 { want = 0; }
	let start = (g.n - want) / 2;
	for i in want {
		g.res[i] = g.res[start + i];
	}
	g.n = want;
	g.steps += want;
	out.i = want;
	out.s.clear();
	format(out.s, "kept middle items with retry count ", want);
	out
}
@end
@entry 9f52deb973a2238f
kind: step
verb: keep
noun: runs
modifier: with_cache
context: math
phrase: keep runs with cache storing run lengths in mathematical sequence
phrase: preserve cached sorted run lengths across mathematical results
test: list=1,2,3,1,2
expect: => i=2 r=0.0 ok=true s="kept runs with cache count 2" errors=0 n=2 res=[3,2] cache=2 hits=0
test: list=4,5,2,3,4,1
expect: => i=3 r=0.0 ok=true s="kept runs with cache count 3" errors=0 n=3 res=[2,3,1] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var len = 1;
		while i + 1 < g.n && g.res[i] <= g.res[i + 1] {
			len++;
			i++;
		}
		gold_cache_put(g, write_idx, len);
		g.res[write_idx] = len;
		write_idx++;
		i++;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept runs with cache count ", write_idx);
	out
}
@end
