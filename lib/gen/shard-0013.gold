fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 || c <= 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var compared = 0;
	for i in c {
		if i < g.n && last_val > g.res[i] {
			compared++;
		}
	}
	gold_push(g, last_val);
	g.steps += c + 1;
	out.i = compared;
	out.s.clear();
	format(out.s, "tail element exceeds ", compared, " initial items");
	out
}
@end
