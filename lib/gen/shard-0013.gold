fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${threshold};
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	var retries = 0;
	while g.res[min_idx] < goal {
		g.res[min_idx] += 2;
		retries++;
	}
	g.steps += retries;
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "lifted minimum value ", out.i);
	out
}
@end
