@entry 8c99c7a10bf180af
kind: step
verb: repeat
noun: letters
modifier: up_to
context: stats
slot: limit int
phrase: repeat sample observations up to target size {limit}
phrase: expand sample elements up to maximum length {limit}
test: list=10,20 limit=5
expect: => i=5 r=0.0 ok=true s="size: 5" errors=0 n=5 res=[10,20,10,20,10] cache=0 hits=0
test: list=1,2,3 limit=4
expect: => i=4 r=0.0 ok=true s="size: 4" errors=0 n=4 res=[1,2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let max_cap = if lim < 64 { lim } else { 64 };
	let orig_n = g.n;
	if orig_n > 0 {
		while g.n < max_cap {
			let rem = max_cap - g.n;
			let take = if rem < orig_n { rem } else { orig_n };
			for i in take {
				g.res[g.n] = g.res[i];
				g.n++;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "size: ", g.n);
	out
}
@end
