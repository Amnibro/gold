@entry 7c9b5d1b0c4e37cc
kind: step
verb: check
noun: histogram
modifier: every_other
context: math
phrase: check histogram every other frequency exceeds threshold {bound} in math
phrase: verify alternating histogram frequencies reach ceiling {bound} in math
slot: bound int
test: list=1,1,2,3,3 bound=2
expect: => i=1 r=0.0 ok=true s="checked alternating histogram frequencies status 1" errors=0 n=5 res=[1,1,2,3,3] cache=0 hits=0
test: list=1,2,3,4 bound=2
expect: => i=0 r=0.0 ok=false s="checked alternating histogram frequencies status 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var vals int[>..] = [];
	var freqs int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in vals.len {
			if vals[j] == x { freqs[j] += 1; found = true; break; }
		}
		if !found { vals.push(x); freqs.push(1); }
	}
	var ok_check = true;
	var i = 0;
	while i < freqs.len {
		if freqs[i] < b { ok_check = false; break; }
		i += 2;
	}
	g.steps += freqs.len;
	out.ok = ok_check;
	out.i = if ok_check { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked alternating histogram frequencies status ", out.i);
	out
}
@end
