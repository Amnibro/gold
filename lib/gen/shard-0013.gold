kind: step
verb: normalize
noun: minimum
modifier: unique
context: stats
phrase: normalize minimum among unique values
phrase: rescale minimum across distinct sample points
phrase: adjust minimum within unique observations
test: list=4,4,8,8,12,12
expect: => i=6 r=0.0 ok=true s="normalized 6 unique items" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=10,10,25,30
expect: => i=4 r=0.0 ok=true s="normalized 4 unique items" errors=0 n=4 res=[1,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let scale = if min_val == 0 { 1 } else { min_val };
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { found = true; break; }
			j++;
		}
		if !found {
			g.res[i] = g.res[i] / scale;
			unique_count++;
		}
		i++;
	}
	out.i = unique_count;
	out.s.clear();
	format(out.s, "normalized ", unique_count, " unique items");
	g.steps += g.n + unique_count + 1;
	out
}
@end
