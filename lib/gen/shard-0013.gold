fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n > 1 {
        let last_val = g.res[g.n - 1];
        var j = g.n - 1;
        while j > 0 {
            g.res[j] = g.res[j - 1];
            j--;
        }
        g.res[0] = last_val;
    }
    var sum = 0;
    for i in g.n {
        sum += g.res[i];
    }
    g.steps += g.n;
    out.i = sum;
    out.s.clear();
    format(out.s, "checkpoint rotated with total: ", sum);
    gold_push(g, sum);
    out
}
