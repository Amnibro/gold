fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lim};
	var all_within = true;
	for i in g.n {
		if g.res[i] > l {
			all_within = false;
			break;
		}
	}
	gold_cache_put(g, l, if all_within { 1 } else { 0 });
	g.steps += g.n;
	out.ok = all_within;
	out.i = if all_within { 1 } else { 0 };
	out.s.clear();
	if all_within {
		format(out.s, "all items within cached limit ", l);
	} else {
		format(out.s, "items exceeded cached limit ", l);
	}
	out
}
@end
