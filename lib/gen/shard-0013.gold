test: list=1,2,3 threshold=10
expect: => i=1 r=0.0 ok=true s="threshold kept items=1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	var max_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
		if g.res[i] >= th {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		g.res[0] = max_val;
		kept = 1;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "threshold kept items=", kept);
	out
}
@end
