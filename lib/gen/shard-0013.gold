fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_even(x) {
			var already = false;
			for k in kept {
				if g.res[k] == x {
					already = true;
					break;
				}
			}
			if !already {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	if kept == 0 {
		gold_fail(g, "no even numbers found");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected unique evens count ", kept);
	out
}
@end
