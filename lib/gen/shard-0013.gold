fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var max_streak = 0;
	var i = 0;
	while i < g.n {
		var cur_streak = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			cur_streak++;
			i++;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
		i++;
	}
	let in_range = (max_streak >= low && max_streak <= high);
	gold_push(g, max_streak);
	out.i = max_streak;
	out.ok = in_range;
	out.s.clear();
	format(out.s, "max streak ", max_streak);
	g.steps += g.n + 1;
	out
}
@end
