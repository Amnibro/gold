fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 { return out; }
    var sum = 0;
    for i in g.n {
        sum += g.res[i];
    }
    let avg = sum / g.n;
    var filled = 0;
    var i = 1;
    while i < g.n {
        g.res[i] = avg;
        filled++;
        i += 2;
    }
    g.steps += g.n;
    out.i = avg;
    out.s.clear();
    format(out.s, "filled alternate with average ", avg);
    out
}
