@entry fb564a7106694542
kind: step
verb: rotate
noun: step
modifier: safely
context: aggregate
phrase: rotate step safely by step offset {shift}
phrase: cycle items safely by step distance {shift}
slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=4 r=0.0 ok=true s="rotated step safely items count=4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=3 r=0.0 ok=true s="rotated step safely items count=3" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 0 {
		let k = s % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated step safely items count=", g.n);
	out
}
@end
@entry ec00230cffb3785a
kind: step
verb: filter
noun: runs
modifier: every_other
context: aggregate
phrase: filter consecutive runs keeping every other run
phrase: retain every other contiguous run in sequence
test: list=1,1,2,2,3,3
expect: => i=4 r=0.0 ok=true s="filtered every other run remaining=4" errors=0 n=4 res=[1,1,3,3] cache=0 hits=0
test: list=5,5,6,7,7
expect: => i=4 r=0.0 ok=true s="filtered every other run remaining=4" errors=0 n=4 res=[5,5,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var write = 0;
	var run_idx = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		if run_idx % 2 == 0 {
			for k in i..j {
				g.res[write] = g.res[k];
				write++;
			}
		}
		run_idx++;
		i = j;
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "filtered every other run remaining=", write);
	out
}
@end
