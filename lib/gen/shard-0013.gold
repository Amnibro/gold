test: list=10,20
expect: => i=1 r=0.0 ok=true s="series: [10]" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n - 1 {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		g.n--;
	}
	out.s.clear();
	format(out.s, "series: [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		format(out.s, g.res[i]);
	}
	format(out.s, "]");
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out
}
@end
