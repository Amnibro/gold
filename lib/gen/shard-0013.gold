code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_cnt = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dup_cnt++;
			}
		}
	}
	if dup_cnt == 0 {
		gold_fail(g, "no duplicate values found to merge");
		out.ok = false;
	}
	g.steps += g.n * g.n;
	out.i = dup_cnt;
	out.s.clear();
	format(out.s, "merged duplicate pairs ", dup_cnt);
	out
}
@end
