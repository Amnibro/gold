@entry e53fdec2aa4b70f6
kind: step
verb: scale
noun: subfunction
modifier: in_reverse
context: aggregate
phrase: scale subfunction {sub} in reverse by {factor} on aggregate
phrase: apply subfunction {sub} scaled by {factor} in reverse order to aggregate
slot: sub fn
slot: factor int
test: list=1,2,3 sub=double factor=3
expect: => i=36 r=0.0 ok=true s="scaled subfunction in reverse by 3" errors=0 n=3 res=[6,12,18] cache=0 hits=0
test: list=4,5 sub=inc factor=2
expect: => i=22 r=0.0 ok=true s="scaled subfunction in reverse by 2" errors=0 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total = 0;
	var i = g.n - 1;
	while i >= 0 {
		let res = ${sub}(g.res[i]) * f;
		g.res[i] = res;
		total += res;
		i--;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled subfunction in reverse by ", f);
	out
}
@end
