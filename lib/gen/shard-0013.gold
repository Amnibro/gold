expect: => i=-1 r=0.0 ok=false s="running search reached index -1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${target};
	var run = 0;
	var idx = -1;
	for i in g.n {
		run += g.res[i];
		if run >= th {
			idx = i;
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = idx;
	out.ok = (idx >= 0);
	out.s.clear();
	format(out.s, "running search reached index ", idx);
	out
}
@end
