code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var modified = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
			modified++;
		} else {
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped numbers until match count=", modified);
	out
}
@end
