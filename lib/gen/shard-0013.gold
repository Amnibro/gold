context: list
phrase: reverse limit nested first {limit} elements
phrase: invert first nested items up to {limit}
slot: limit int
test: list=10,20,30,40,50 limit=3
expect: => i=3 r=0.0 ok=true s="reversed first 3 items" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3,4,5,6 limit=4
expect: => i=4 r=0.0 ok=true s="reversed first 4 items" errors=0 n=6 res=[4,3,2,1,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var lim = ${limit};
    if lim > g.n {
        lim = g.n;
    }
    let half = lim / 2;
    for i in half {
        let tmp = g.res[i];
        g.res[i] = g.res[lim - 1 - i];
        g.res[lim - 1 - i] = tmp;
    }
    g.steps += lim;
    out.i = lim;
    out.s.clear();
    format(out.s, "reversed first ", lim, " items");
    out
}
@end
