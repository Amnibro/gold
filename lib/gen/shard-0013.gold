test: list=1,2,3,4 k=2
expect: => i=2 r=0.0 ok=true s="selected suffix recursively size 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${k};
	if want <= 0 || g.n == 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var count = want;
	if count > g.n { count = g.n; }
	let start = g.n - count;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected suffix recursively size ", count);
	out
}
@end
