expect: => i=2 r=0.0 ok=true s="shifted 2 sorted pairs" errors=0 n=2 res=[2,2] cache=0 hits=0
test: list=20,5,15,10
expect: => i=2 r=0.0 ok=true s="shifted 2 sorted pairs" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var k = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[k] = g.res[i + 1] - g.res[i];
		k++;
		i += 2;
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "shifted ", k, " sorted pairs");
	out
}
@end
