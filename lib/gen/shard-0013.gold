expect: => i=1 r=0.0 ok=true s="dropped last value idx 2" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var last_idx = -1;
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] == tgt { last_idx = i; break; }
	}
	if last_idx >= 0 {
		var j = last_idx;
		while j + 1 < g.n {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n = g.n - 1;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "dropped last value idx ", last_idx);
	g.steps += g.n + 1;
	out
}
@end
