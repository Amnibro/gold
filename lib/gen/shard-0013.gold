code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let dups = g.n - kept;
	g.n = kept;
	gold_cache_put(g, 0, dups);
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged duplicates kept=", kept, " dups=", dups);
	out
}
@end
