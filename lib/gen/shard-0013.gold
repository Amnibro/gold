code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var kept = 0;
	for i in g.n {
		if g.res[i] != target {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped numbers count: ", dropped);
	out
}
@end
