expect: => i=15 r=0.0 ok=true s="repeated histogram by factor 3 resulting in 15 items" errors=0 n=15 res=[7,7,7,7,7,7,3,3,3,3,3,3,3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f <= 1 {
		out.i = g.n;
		return out;
	}
	var new_arr int[>..] = [];
	for i in g.n {
		for _ in f {
			new_arr.push(g.res[i]);
		}
	}
	g.n = 0;
	for x in new_arr {
		gold_push(g, x);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated histogram by factor ", f, " resulting in ", g.n, " items");
	out
}
@end
@entry 633b6af2033e9187
kind: step
verb: drop
noun: limit
modifier: first
context: cache
phrase: drop limit from first entries
phrase: remove limit from initial cache keys
phrase: discard first elements exceeding limit {threshold}
slot: threshold int
test: list=10,20,30,40 threshold=25
expect: => i=1 r=0.0 ok=true s="dropped limit first 1" errors=0 n=4 res=[10,20,40,1] cache=1 hits=0
test: list=5,15,25,35 threshold=15
expect: => i=1 r=0.0 ok=true s="dropped limit first 1" errors=0 n=4 res=[5,15,35,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var drop_idx = -1;
	for i in g.n {
		if g.res[i] > th { drop_idx = i; break; }
	}
	if drop_idx >= 0 {
		var j = drop_idx;
		while j + 1 < g.n {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n = g.n - 1;
		gold_cache_put(g, 0, 1);
		out.i = 1;
	} else {
		gold_cache_put(g, 0, 0);
		out.i = 0;
	}
	gold_push(g, out.i);
	out.s.clear();
	format(out.s, "dropped limit first ", out.i);
	g.steps += g.n + 1;
	out
}
@end
