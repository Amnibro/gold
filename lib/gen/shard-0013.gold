code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last_val;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated last element to head: ", g.res[0]);
	out
}
@end
