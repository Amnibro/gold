fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			let val = g.res[i];
			gold_cache_put(g, val, 2);
			g.res[kept] = val;
			kept++;
			i += 2;
		} else {
			i++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected pairs count ", kept);
	out
}
