test: list=15,3,9 cutoff=8
expect: => i=24 r=0.0 ok=true s="folded window cutoff" errors=0 n=3 res=[3,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var s = 0;
	for i in g.n {
		if g.res[i] >= cut {
			s += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = s;
	gold_text(out, "folded window cutoff");
	out
}
@end
