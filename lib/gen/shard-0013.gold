@entry eaf18cfcab5ced16
kind: step
verb: clamp
noun: spaces
modifier: first
context: aggregate
phrase: clamp leading spaces count to maximum {cap}
phrase: restrict initial whitespace prefix below {cap}
slot: cap int
test: text="   hello world" cap=1
expect: => i=12 r=0.0 ok=true s=" hello world" errors=0 n=0 res=[] cache=0 hits=0
test: text="     spaced" cap=2
expect: => i=8 r=0.0 ok=true s="  spaced" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var lead = 0;
	while lead < out.s.len && out.s[lead] == ' ' {
		lead++;
	}
	if lead > limit {
		let cut = lead - limit;
		var res byte[>..] = [];
		for i in cut..out.s.len {
			res.push(out.s[i]);
		}
		out.s.clear();
		for b in res {
			if out.s.len < 200 {
				out.s.push(b);
			}
		}
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
