code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_count = 0;
	if g.n >= 2 {
		let original_n = g.n;
		for i in original_n - 1 {
			let s = g.res[i] + g.res[i + 1];
			gold_push(g, s);
			pair_count++;
		}
	}
	g.steps += g.n + 1;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "found ", pair_count, " pairwise totals");
	out
}
@end
