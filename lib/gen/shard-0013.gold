test: list=10,20,20,30,40,40
expect: => i=2 r=0.0 ok=true s="dropped 2 pairwise numbers" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			dropped++;
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " pairwise numbers");
	g.steps += kept + dropped + 1;
	out
}
@end
