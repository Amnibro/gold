slot: limit_sum int
phrase: format group series while sum below {limit_sum}
phrase: render prefix series accumulating under ceiling {limit_sum}
test: list=10,20,30,40 limit_sum=50
expect: => i=2 r=0.0 ok=true s="series: [10, 20]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
