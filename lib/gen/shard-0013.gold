	var out = v;
	var new_s byte[..200] = "";
	var in_space = false;
	var spaces_dropped = 0;
	for b in out.s {
		if b == ' ' {
			if !in_space {
				new_s.push(b);
				in_space = true;
			} else {
				spaces_dropped++;
			}
		} else {
			new_s.push(b);
			in_space = false;
		}
	}
	out.s = new_s;
