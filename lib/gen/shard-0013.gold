code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	if k > g.n { k = g.n; }
	var sum = 0;
	for i in k {
		sum += g.res[i];
	}
	g.res[0] = sum;
	var kept = 1;
	for i in k..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged first range sum ", sum);
	out
}
@end
