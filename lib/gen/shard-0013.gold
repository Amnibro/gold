noun: maximum
modifier: safely
context: retry
phrase: rotate retry attempts to maximum safely
phrase: safely rotate values until maximum is first
slot: max_shifts int
test: list=1,3,7,2 max_shifts=3
expect: => i=2 r=0.0 ok=true s="safely rotated maximum by 2 steps" errors=0 n=4 res=[7,2,1,3] cache=0 hits=0
test: list=10,4,8,5 max_shifts=2
expect: => i=0 r=0.0 ok=true s="safely rotated maximum by 0 steps" errors=0 n=4 res=[10,4,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_shifts};
	if g.n <= 1 || limit <= 0 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for i in g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
	}
	var shifts = 0;
	while max_idx > 0 && shifts < limit {
		let first = g.res[0];
		for j in g.n - 1 {
			g.res[j] = g.res[j + 1];
		}
		g.res[g.n - 1] = first;
		shifts++;
		max_idx--;
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "safely rotated maximum by ", shifts, " steps");
	out
}
@end
