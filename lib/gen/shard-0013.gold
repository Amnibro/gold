expect: => i=10 r=0.0 ok=true s="folded total up to index sum=10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${limit};
	var bound = g.n;
	if k < bound {
		bound = k;
	}
	if bound < 0 {
		bound = 0;
	}
	var total = 0;
	for i in bound {
		total += g.res[i];
	}
	g.steps += bound + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "folded total up to index sum=", total);
	out
}
@end
