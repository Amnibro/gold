		for j in i + 1 {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
		if freq > max_freq {
			max_freq = freq;
		}
	}
	g.steps += g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "maximum running frequency is ", max_freq);
	out
}
