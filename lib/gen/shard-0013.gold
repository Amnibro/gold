kind: step
verb: repeat
noun: histogram
modifier: with_cache
context: retry
phrase: repeat histogram caching {repeats} times
phrase: compute cached histogram across {repeats} repetitions
slot: repeats int
test: list=2,2,3,4 repeats=2
expect: => i=4 r=0.0 ok=true s="repeated cached histogram count is 4" errors=0 n=4 res=[2,2,3,4] cache=1 hits=0
test: list=7,8,7,8,9 repeats=3
expect: => i=6 r=0.0 ok=true s="repeated cached histogram count is 6" errors=0 n=5 res=[7,8,7,8,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${repeats};
	if g.n == 0 || reps <= 0 {
		out.i = 0;
		return out;
	}
	let first = g.res[0];
	let cached, ok = gold_cache_get(g, first);
	var freq = 0;
	if ok {
		freq = cached;
	} else {
		for i in g.n {
			if g.res[i] == first {
				freq++;
			}
		}
		gold_cache_put(g, first, freq);
	}
	g.steps += reps;
	out.i = freq * reps;
	out.s.clear();
	format(out.s, "repeated cached histogram count is ", out.i);
	out
}
@end
