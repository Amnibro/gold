@entry 2a8109f833a0d5a1
kind: step
verb: clamp
noun: pairs
modifier: running
context: error
phrase: clamp running adjacent pairs to bound {limit}
phrase: restrict running pair sums below limit {limit}
slot: limit int
test: list=2,3,4 limit=10
expect: => i=0 r=0.0 ok=true s="pairs clamped" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=8,9,7 limit=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[8,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 { gold_fail(g, "need pairs"); out.ok = false; return out; }
	var clamped = 0;
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum > lim { clamped++; }
		i++;
	}
	if clamped > 1 { gold_fail(g, "pairs exceed bound"); out.ok = false; return out; }
	g.steps += g.n;
	out.i = clamped;
	gold_text(out, "pairs clamped");
	out
}
@end
