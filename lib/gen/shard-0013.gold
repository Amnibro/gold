test: list=3,5,7,9
expect: => i=2 r=0.0 ok=true s="paired valid digits 2" errors=0 n=2 res=[35,79] cache=0 hits=0
test: list=2,15,4
expect: => i=3 r=0.0 ok=false s="paired valid digits 3" errors=1 n=3 res=[2,15,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var invalid = false;
	for i in g.n {
		let x = g.res[i];
		if x < 0 || x > 9 {
			gold_fail(g, "element is not a valid single digit");
			out.ok = false;
			invalid = true;
			break;
		}
	}
	if !invalid {
		var pairs = 0;
		var i = 0;
		while i + 1 < g.n {
			g.res[pairs] = g.res[i] * 10 + g.res[i + 1];
			pairs++;
			i += 2;
		}
		g.n = pairs;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired valid digits ", g.n);
	out
}
@end
