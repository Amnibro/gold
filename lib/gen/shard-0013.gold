@entry 068de15a3c755922
kind: step
verb: dedupe
noun: budget
modifier: at_least
context: stats
slot: min_retained int
phrase: dedupe sample ensuring at least minimum count retained {min_retained}
phrase: prune repeated adjacent items preserving minimum elements {min_retained}
test: list=1,1,2,2,3,3 min_retained=4
expect: => i=4 r=0.0 ok=true s="retained: 4" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=10,10,20 min_retained=1
expect: => i=2 r=0.0 ok=true s="retained: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_keep = ${min_retained};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		g.res[kept] = val;
		kept++;
		i++;
		while i < g.n && g.res[i] == val {
			let remaining_tail = g.n - i;
			if kept + remaining_tail <= min_keep {
				g.res[kept] = g.res[i];
				kept++;
				i++;
			} else {
				i++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained: ", kept);
	out
}
@end
