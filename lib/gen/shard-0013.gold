kind: step
verb: apply
noun: maximum
modifier: between
context: format
slot: min_val int
slot: max_val int
phrase: format apply maximum between range {min_val} to {max_val}
phrase: render bounded maximum value inside interval {min_val} to {max_val}
test: list=10,50,30,80 min_val=20 max_val=70
expect: => i=50 r=0.0 ok=true s="bounded max: 50" errors=0 n=4 res=[10,50,30,80] cache=0 hits=0
test: list=10,80 min_val=20 max_val=70
expect: => i=-1 r=0.0 ok=true s="bounded max: none" errors=0 n=2 res=[10,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var found = false;
	var best = lo;
	for i in g.n {
		let x = g.res[i];
		if x > lo && x < hi {
			if !found || x > best {
				best = x;
				found = true;
			}
		}
	}
	out.s.clear();
	if found {
		format(out.s, "bounded max: ", best);
		out.i = best;
	} else {
		format(out.s, "bounded max: none");
		out.i = -1;
	}
	g.steps += g.n + 1;
	out
}
@end
