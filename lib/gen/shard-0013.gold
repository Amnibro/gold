fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running_sum = 0;
	var step_count = 0;
	for i in g.n {
		let current_avg = (running_sum + g.res[i]) / (i + 1);
		if ${p}(current_avg) { break; }
		running_sum += g.res[i];
		step_count++;
	}
	out.i = running_sum;
	out.s.clear();
	format(out.s, "average sum until stopped at ", running_sum);
	gold_push(g, running_sum);
	g.steps += step_count + 1;
	out
}
