@entry 93bb04047b8c422b
kind: step
verb: sort
noun: history
modifier: times
context: transform
phrase: sort history entries {times} successive iterations
phrase: order history values across {times} transform passes
slot: times int
test: list=9,4,7,2,5 times=2
expect: => i=4 r=0.0 ok=true s="history sorted through 2 passes minimum is 4" errors=0 n=5 res=[4,2,5,7,9] cache=0 hits=0
test: list=8,1,6,3 times=3
expect: => i=1 r=0.0 ok=true s="history sorted through 3 passes minimum is 1" errors=0 n=4 res=[1,3,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${times};
	for p in passes {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
	}
	g.steps += passes * g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "history sorted through ", passes, " passes minimum is ", out.i);
	out
}
@end
