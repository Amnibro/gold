fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if !${p}(x) {
			break;
		}
		sum += x;
		count++;
	}
	if count == 0 {
		gold_fail(g, "no items match histogram predicate");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged histogram sum ", sum);
	out
}
@end
