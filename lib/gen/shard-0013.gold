context: list
phrase: pair values between range {low} to {high}
phrase: combine values falling between {low} to {high}
slot: low int
slot: high int
test: list=5,12,18,25,30 low=10 high=28
expect: => i=1 r=0.0 ok=true s="paired values between 10 to 28: count 1" errors=0 n=1 res=[30] cache=0 hits=0
test: list=2,8,14,20,50 low=5 high=25
expect: => i=1 r=0.0 ok=true s="paired values between 5 to 25: count 1" errors=0 n=1 res=[22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let lo = ${low};
    let hi = ${high};
    var buf int[512] = [0; 512];
    var nb = 0;
    for i in g.n {
        let x = g.res[i];
        if x >= lo && x <= hi {
            buf[nb] = x;
            nb++;
        }
    }
    let pairs = nb / 2;
    for i in pairs {
        g.res[i] = buf[2 * i] + buf[2 * i + 1];
    }
    g.n = pairs;
    g.steps += g.n;
    out.i = pairs;
    out.s.clear();
    format(out.s, "paired values between ", lo, " to ", hi, ": count ", pairs);
    out
}
@end
