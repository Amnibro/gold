test: list=2,4,6,8
expect: => i=0 r=0.0 ok=true s="swapped gaps count=0" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n >= 3 {
		for i in (g.n - 2) {
			for j in (g.n - 2 - i) {
				let g0 = if g.res[j+1] > g.res[j] { g.res[j+1] - g.res[j] } else { g.res[j] - g.res[j+1] };
				let g1 = if g.res[j+2] > g.res[j+1] { g.res[j+2] - g.res[j+1] } else { g.res[j+1] - g.res[j+2] };
				if g0 > g1 {
					let tmp = g.res[j];
					g.res[j] = g.res[j+1];
					g.res[j+1] = tmp;
					swaps++;
				}
			}
		}
	}
	g.steps += swaps + g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped gaps count=", swaps);
	out
}
@end
