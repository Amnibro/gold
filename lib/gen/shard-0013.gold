code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] { dups++; }
		i++;
	}
	if dups > 3 { gold_fail(g, "streak exceeds limit"); out.ok = false; return out; }
	g.steps += g.n;
	out.i = dups;
	gold_text(out, "streak deduped");
	out
}
@end
