code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid_idx = g.n / 2;
		let mid_val = g.res[mid_idx];
		gold_push(g, mid_val);
	}
	g.steps += 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined middle comparison item to size ", g.n);
	out
}
@end
