@entry eb49c0d1d71a49e6
kind: step
verb: group
noun: streak
modifier: unique
context: search
phrase: group unique streak elements
phrase: cluster distinct streak values in search
phrase: aggregate unique streak keys
test: list=1,1,2,2,3,4,4
expect: => i=4 r=0.0 ok=true s="grouped 4 unique streaks" errors=0 n=11 res=[1,1,2,2,3,4,4,1,2,3,4] cache=0 hits=0
test: list=5,5,6,7,7,8,8
expect: => i=4 r=0.0 ok=true s="grouped 4 unique streaks" errors=0 n=11 res=[5,5,6,7,7,8,8,5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_streaks = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == val { seen_before = true; break; }
			j++;
		}
		if !seen_before {
			unique_streaks++;
			gold_push(g, val);
		}
		while i + 1 < g.n && g.res[i + 1] == val { i++; }
		i++;
	}
	out.i = unique_streaks;
	out.s.clear();
	format(out.s, "grouped ", unique_streaks, " unique streaks");
	g.steps += g.n + 1;
	out
}
@end
