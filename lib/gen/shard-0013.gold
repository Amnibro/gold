@entry 77f4729d821befe4
kind: step
verb: dedupe
noun: primes
modifier: at_most
context: aggregate
phrase: dedupe primes keeping at most limit {cap}
phrase: filter prime duplicates leaving at most {cap}
slot: cap int
test: list=2,2,3,3,5,5 cap=2
expect: => i=6 r=0.0 ok=true s="deduped primes at most remaining=6" errors=0 n=6 res=[2,2,3,3,5,5] cache=0 hits=0
test: list=7,7,7,11,11 cap=1
expect: => i=2 r=0.0 ok=true s="deduped primes at most remaining=2" errors=0 n=2 res=[7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			var seen = 0;
			for j in write {
				if g.res[j] == x {
					seen++;
				}
			}
			if seen < limit {
				g.res[write] = x;
				write++;
			}
		} else {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped primes at most remaining=", write);
	out
}
@end
