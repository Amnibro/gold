expect: => i=60 r=0.0 ok=true s="tail sum until match 60" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
test: list=3,6,12,24 p=is_odd
expect: => i=42 r=0.0 ok=true s="tail sum until match 42" errors=0 n=4 res=[3,6,12,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if ${p}(g.res[idx]) {
			break;
		}
		total += g.res[idx];
		idx--;
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "tail sum until match ", total);
	out
}
@end
