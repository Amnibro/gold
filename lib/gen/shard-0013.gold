@entry 9cd92ee856d49e09
kind: step
verb: drop
noun: average
modifier: sorted
context: search
phrase: drop average from sorted observations
phrase: remove mean value after sorting
phrase: discard average entry in sorted keys
test: list=10,30,20,40
expect: => i=0 r=0.0 ok=true s="dropped average match 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,25,15,35
expect: => i=0 r=0.0 ok=true s="dropped average match 0" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_val = 0;
	for i in g.n { sum_val += g.res[i]; }
	let avg = if g.n > 0 { sum_val / g.n } else { 0 };
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		if g.res[k] == avg && dropped == 0 {
			dropped++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped average match ", dropped);
	g.steps += g.n + 1;
	out
}
@end
