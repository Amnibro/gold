phrase: limit sequence of words to at most {max_words}
test: text="apple banana cherry date" max_words=2
expect: => i=2 r=0.0 ok=true s="kept 2 words up to limit" errors=0 n=2 res=[5,6] cache=0 hits=0
test: text="one" max_words=3
expect: => i=1 r=0.0 ok=true s="kept 1 words up to limit" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mw = ${max_words};
	gold_clear(g);
	var wlen = 0;
	var count = 0;
	for i in v.s.len {
		if v.s[i] != ' ' {
			wlen++;
		} else {
			if wlen > 0 {
				if count < mw {
					gold_push(g, wlen);
					count++;
				}
				wlen = 0;
			}
		}
	}
	if wlen > 0 && count < mw {
		gold_push(g, wlen);
		count++;
	}
	g.steps += v.s.len + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " words up to limit");
	out
}
@end
