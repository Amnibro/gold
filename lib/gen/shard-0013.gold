kind: step
verb: select
noun: squares
modifier: first
context: transform
phrase: select square values placing squares first
phrase: reorder elements placing square numbers first
test: list=4,7,9,12
expect: => i=2 r=0.0 ok=true s="squares placed first count=2" errors=0 n=4 res=[4,9,7,12] cache=0 hits=0
test: list=3,5,16,25
expect: => i=2 r=0.0 ok=true s="squares placed first count=2" errors=0 n=4 res=[16,25,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq int[32] = [0; 32];
	var non int[32] = [0; 32];
	var n_sq = 0;
	var n_non = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq && n_sq < 32 { sq[n_sq] = x; n_sq++; }
		else if n_non < 32 { non[n_non] = x; n_non++; }
	}
	for i in n_sq { g.res[i] = sq[i]; }
	for i in n_non { g.res[n_sq + i] = non[i]; }
	g.steps += g.n;
	out.i = n_sq;
	out.s.clear();
	format(out.s, "squares placed first count=", n_sq);
	out
}
@end
