@entry 6cc4b175f753cb46
kind: step
verb: sort
noun: suffix
modifier: until
context: transform
phrase: sort suffix items until reaching bound {target}
phrase: order suffix elements until encountering {target}
slot: target int
test: list=5,9,2,8,12,1 target=8
expect: => i=3 r=0.0 ok=true s="sorted suffix of length 3 starting at value 8" errors=0 n=6 res=[5,9,2,1,8,12] cache=0 hits=0
test: list=20,15,30,10,25 target=15
expect: => i=4 r=0.0 ok=true s="sorted suffix of length 4 starting at value 15" errors=0 n=5 res=[20,10,15,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var split_idx = 0;
	while split_idx < g.n && g.res[split_idx] != tgt {
		split_idx++;
	}
	if split_idx < g.n {
		var i = split_idx;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	let sorted_len = g.n - split_idx;
	g.steps += sorted_len * sorted_len + 1;
	out.i = sorted_len;
	out.s.clear();
	format(out.s, "sorted suffix of length ", sorted_len, " starting at value ", tgt);
	out
}
@end
