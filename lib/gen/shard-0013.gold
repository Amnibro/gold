expect: => i=1 r=0.0 ok=true s="kept 1 trailing steps" errors=0 n=1 res=[25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var kept = 0;
	let start_idx = if g.n > req { g.n - req } else { 0 };
	for i in start_idx..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " trailing steps");
	out
}
