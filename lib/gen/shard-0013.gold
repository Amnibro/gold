noun: average
modifier: every_other
context: transform
phrase: reverse average of every other item
phrase: calculate reverse average alternating every other element
test: list=10,2,30,4,50
expect: => i=3 r=0.0 ok=true s="reversed average every other=3" errors=0 n=5 res=[10,2,30,4,50] cache=0 hits=0
test: list=2,100,6,200
expect: => i=4 r=0.0 ok=true s="reversed average every other=4" errors=0 n=4 res=[2,100,6,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		count++;
		i += 2;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	var rev = 0;
	var t = avg;
	while t > 0 {
		rev = rev * 10 + (t % 10);
		t /= 10;
	}
	g.steps += g.n;
	out.i = rev;
	out.s.clear();
	format(out.s, "reversed average every other=", rev);
	out
}
@end
