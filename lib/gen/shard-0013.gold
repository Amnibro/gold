code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mx = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] > mx {
			mx = g.res[i];
		}
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let t = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = t;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
	format(out.s, "maximum in reverse: ", mx);
	out
}
@end
