@entry 59ed883781b85173
kind: step
verb: reverse
noun: suffix
modifier: recursively
context: core
phrase: reverse suffix recursively taking {k} items in core
phrase: recursively invert order of suffix of {k} items in core
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="reversed suffix elements count 3" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="reversed suffix elements count 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${k};
	if want <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = want;
	if count > g.n { count = g.n; }
	var left = g.n - count;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed suffix elements count ", count);
	out
}
@end
