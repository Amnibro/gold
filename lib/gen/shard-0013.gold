expect: => i=0 r=0.0 ok=false s="checked suffix first value match 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matched = false;
	if g.n > 0 {
		let mid = g.n / 2;
		matched = g.res[mid] == tgt;
	}
	g.steps++;
	out.ok = matched;
	out.i = if matched { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked suffix first value match ", out.i);
	out
}
@end
@entry 16ee8c5ee5de1833
kind: step
verb: swap
noun: limit
modifier: in_reverse
context: aggregate
phrase: swap limit in reverse for elements above {bound} in aggregate
phrase: reverse swap elements exceeding limit {bound} in aggregate
slot: bound int
test: list=10,50,20,60,30 bound=25
expect: => i=1 r=0.0 ok=true s="swapped limit elements in reverse count 1" errors=0 n=5 res=[10,30,20,60,50] cache=0 hits=0
test: list=100,5,200,8 bound=50
expect: => i=1 r=0.0 ok=true s="swapped limit elements in reverse count 1" errors=0 n=4 res=[200,5,100,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var left = 0;
	var right = g.n - 1;
	var swaps = 0;
	while left < right {
		while left < right && g.res[left] <= b { left++; }
		while left < right && g.res[right] <= b { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			swaps++;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped limit elements in reverse count ", swaps);
	out
}
@end
