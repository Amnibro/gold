code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	let lim = if target < 64 { target } else { 64 };
	if g.n > 0 {
		let head = g.res[0];
		while g.n < lim {
			g.res[g.n] = head;
			g.n++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated_head: ", g.n);
	out
}
@end
