			found = true;
			break;
		}
		g.res[kept] = g.res[i];
		kept++;
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	if found {
		format(out.s, "reached checkpoint after ", kept, " items");
