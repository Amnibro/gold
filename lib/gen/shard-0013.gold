fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "list too short to reverse alternating counters");
		out.ok = false;
		return out;
	}
	var l = 0;
	var r = if (g.n - 1) % 2 == 0 { g.n - 1 } else { g.n - 2 };
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l += 2;
		r -= 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed alternating counter elements");
	out
}
@end
