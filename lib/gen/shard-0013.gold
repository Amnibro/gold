phrase: validate that no consecutive runs exceed length {max_run}
phrase: verify maximum consecutive repeated values bound {max_run}
test: list=1,1,2,2,2,3 max_run=2
expect: => i=0 r=0.0 ok=false s="runs_valid: 0" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=1,2,3,4 max_run=2
expect: => i=1 r=0.0 ok=true s="runs_valid: 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	var ok = true;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			i++;
		}
		if run_len > limit {
			ok = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "runs_valid: ", out.i);
	out
}
@end
