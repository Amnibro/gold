@entry 37f5ccc7d0f81c37
kind: step
verb: reverse
noun: series
modifier: up_to
context: retry
phrase: reverse series up to limit {cap} with retry
phrase: invert series sequence up to boundary {cap} retrying
slot: cap int
test: list=10,20,30,40,50 cap=3
expect: => i=3 r=0.0 ok=true s="reversed series prefix 3" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3 cap=2
expect: => i=2 r=0.0 ok=true s="reversed series prefix 2" errors=0 n=3 res=[2,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${cap};
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	var l = 0;
	var r = k - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed series prefix ", k);
	out
}
@end
