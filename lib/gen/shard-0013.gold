fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_retries};
	var valid_pairs = 0;
	var retries = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			let sum = g.res[i] + g.res[j];
			if core_is_even(sum) {
				valid_pairs++;
			} else {
				retries++;
				if retries >= limit {
					break;
				}
			}
		}
		if retries >= limit {
			break;
		}
	}
	g.steps += g.n * g.n;
	out.i = valid_pairs;
	out.s.clear();
	format(out.s, "found valid pairs ", valid_pairs);
	out
}
@end
