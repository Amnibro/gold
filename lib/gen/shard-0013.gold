fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var capped = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > mg {
				g.res[i] = g.res[i - 1] + mg;
				capped++;
			}
		}
	}
	g.steps += g.n;
	out.i = capped;
	out.s.clear();
	format(out.s, "capped nested spaces: ", capped);
	out
}
@end
