@entry b314f5bc9deb51db
kind: step
verb: measure
noun: suffix
modifier: in_reverse
context: aggregate
phrase: measure suffix in reverse taking {k} items in aggregate
phrase: sum suffix elements in reverse order for {k} items in aggregate
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=120 r=0.0 ok=true s="measured suffix in reverse sum 120" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
test: list=1,2,3,4 k=2
expect: => i=7 r=0.0 ok=true s="measured suffix in reverse sum 7" errors=0 n=4 res=[1,2,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var actual_k = count;
	if actual_k > g.n { actual_k = g.n; }
	var total = 0;
	var left = g.n - actual_k;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	for i in actual_k {
		total += g.res[g.n - actual_k + i];
	}
	g.steps += actual_k;
	out.i = total;
	out.s.clear();
	format(out.s, "measured suffix in reverse sum ", total);
	out
}
@end
