code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${min_budget};
	var sum = 0;
	var count = 0;
	while count < g.n && sum < mb {
		sum += g.res[count];
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "budget reached with ", count, " items");
	gold_push(g, sum);
	out
}
@end
