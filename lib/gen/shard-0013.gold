fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 2 { return 0; }
	var s = 0;
	var d = 2;
	while d * d <= x {
		while x % d == 0 {
			s += d;
			x /= d;
		}
		d++;
	}
	if x > 1 { s += x; }
	s
}
@end
@entry 3ff39f6d63ba2b52
kind: fn
verb: normalize
noun: duplicates
modifier: first
context: aggregate
phrase: normalize duplicates first adjacent
phrase: strip repeated adjacent digits
test: arg=11223,445
expect: 123
expect: 45
test: arg=9
expect: 9
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var digits int[..20] = [];
	while x > 0 {
		digits.push(x % 10);
		x /= 10;
	}
	var res = 0;
	var last_d = -1;
	var i = digits.len - 1;
	while i >= 0 {
		let d = digits[i];
		if d != last_d {
			res = res * 10 + d;
			last_d = d;
		}
		if i == 0 { break; }
		i--;
	}
	res
}
@end
