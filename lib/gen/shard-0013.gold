fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${min_avg};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	let reached = avg >= ma;
	out.ok = reached;
	out.i = avg;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "average reached: ", reached);
	out
}
