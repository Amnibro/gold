code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${k};
	if g.n > 1 {
		let last_val = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last_val;
		gold_cache_put(g, key, last_val);
	}
	g.steps += 1;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated counter with cache head is ", out.i);
	out
}
@end
