fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in write {
			if g.res[j] == x {
				seen++;
			}
		}
		if seen < limit {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "clamped histogram safely remaining=", write);
	out
}
@end
