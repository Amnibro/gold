@entry 9a0eda4360e36e20
kind: step
verb: retry
noun: maximum
modifier: at_least
context: aggregate
phrase: retry maximum at least reaching threshold {floor_val} in aggregate
phrase: ensure aggregate maximum reaches at least {floor_val} with retry
slot: floor_val int
test: list=2,4,5 floor_val=15
expect: => i=20 r=0.0 ok=true s="retried maximum reaching threshold value 20" errors=0 n=3 res=[8,16,20] cache=0 hits=0
test: list=10,20 floor_val=50
expect: => i=80 r=0.0 ok=true s="retried maximum reaching threshold value 80" errors=0 n=2 res=[40,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var retries = 0;
	while max_val < fl && retries < 5 {
		for i in g.n {
			g.res[i] *= 2;
		}
		max_val *= 2;
		retries++;
	}
	g.steps += retries * g.n + g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "retried maximum reaching threshold value ", max_val);
	out
}
@end
