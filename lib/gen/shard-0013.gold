fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var in_range = 0;
	var total_checked = 0;
	while x > 0 {
		let d = x % 10;
		total_checked++;
		if d >= 3 && d <= 7 {
			in_range += total_checked;
		}
		x /= 10;
	}
	in_range
}
