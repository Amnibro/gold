fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		count++;
		i--;
