fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var unique_odds = 0;
	var prev = -999999;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x != prev {
			unique_odds++;
			prev = x;
		}
	}
	g.steps += g.n;
	out.i = unique_odds;
	gold_text(out, "unique odds counted");
	out
}
@end
