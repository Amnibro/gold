expect: => i=4 r=0.0 ok=true s="normalized reverse prefix" errors=0 n=4 res=[0,-10,-20,-30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	if g.n > 0 {
		let base = g.res[0];
		for k in g.n {
			g.res[k] -= base;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized reverse prefix");
	out
}
@end
