@entry ebe5156dae3da499
kind: step
verb: map
noun: average
modifier: until
context: core
phrase: map average until running total exceeds {cutoff} in core
phrase: replace elements with average until reaching cutoff {cutoff} in core
slot: cutoff int
test: list=10,20,30,40 cutoff=45
expect: => i=2 r=0.0 ok=true s="mapped average until cutoff count 2" errors=0 n=4 res=[25,25,30,40] cache=0 hits=0
test: list=2,4,6,8 cutoff=10
expect: => i=2 r=0.0 ok=true s="mapped average until cutoff count 2" errors=0 n=4 res=[5,5,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var running = 0;
	var modified = 0;
	for i in g.n {
		if running + g.res[i] > cut { break; }
		running += g.res[i];
		g.res[i] = avg;
		modified++;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped average until cutoff count ", modified);
	out
}
@end
