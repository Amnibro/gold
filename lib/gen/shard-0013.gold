code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let mc = ${max_count};
    var odds int[512] = [0; 512];
    var no = 0;
    for i in g.n {
        let x = g.res[i];
        if x % 2 != 0 {
            if no < mc {
                odds[no] = x;
                no++;
            }
        }
    }
    for i in no { g.res[i] = odds[i]; }
    g.n = no;
    g.steps += g.n;
    out.i = no;
    out.s.clear();
    format(out.s, "filtered first odds up to ", mc, ": kept ", no);
    out
}
@end
