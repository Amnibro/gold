fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var unique_count = 0;
	for i in out.s.len {
		let b = out.s[i];
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			var seen = false;
			for j in i {
				if out.s[j] == b { seen = true; break; }
			}
			if !seen { unique_count++; }
		}
	}
	gold_push(g, unique_count);
	out.i = unique_count;
	out.ok = (unique_count == tgt);
	out.s.clear();
	format(out.s, "unique letters ", unique_count);
	g.steps += out.s.len + 1;
	out
}
@end
