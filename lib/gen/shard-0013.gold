expect: 78956
code:
fn ${ID}(n int) int {
	let s = ${shift};
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return x;
	}
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	let len = d.len;
	let rot = if s < 1 { 1 } else { s % len };
	var res = 0;
	for i in len {
		let idx = (len - 1 - i + len - rot) % len;
		res = res * 10 + d[idx];
	}
	res
}
@end
