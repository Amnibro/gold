noun: pairs
modifier: every_other
context: compare
phrase: trace comparison pairs on every other element
phrase: log every other comparison pair difference
test: list=1,5,3,9,2,8
expect: => i=16 r=0.0 ok=true s="every other pair difference total is 16" errors=0 n=6 res=[1,5,3,9,2,8] cache=0 hits=0
test: list=10,20,15,30
expect: => i=25 r=0.0 ok=true s="every other pair difference total is 25" errors=0 n=4 res=[10,20,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_diff = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		total_diff += diff;
		i += 2;
	}
	g.steps += g.n;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "every other pair difference total is ", total_diff);
	out
}
@end
@entry 020c7fc1f31fd3f7
kind: step
verb: sort
noun: suffix
modifier: until
context: compare
phrase: sort comparison suffix until last {k} items
phrase: order last {k} items in comparison suffix
slot: k int
test: list=10,20,9,5,1 k=3
expect: => i=3 r=0.0 ok=true s="sorted comparison suffix of 3 items" errors=0 n=5 res=[10,20,1,5,9] cache=0 hits=0
test: list=4,8,15,3,2 k=2
expect: => i=2 r=0.0 ok=true s="sorted comparison suffix of 2 items" errors=0 n=5 res=[4,8,15,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 1 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = k;
	if count > g.n { count = g.n; }
	let start = g.n - count;
	for i in count {
		var j = start;
		while j + 1 < g.n {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted comparison suffix of ", count, " items");
	out
}
@end
