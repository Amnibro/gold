	g.n = 0;
	var pair_idx = 0;
	var i = 0;
	while i < old_n {
		if i + 1 < old_n {
			gold_push(g, orig[i]);
			gold_push(g, orig[i + 1]);
			if pair_idx % 2 == 0 {
				gold_push(g, orig[i]);
				gold_push(g, orig[i + 1]);
			}
			pair_idx++;
			i += 2;
		} else {
			gold_push(g, orig[i]);
			i++;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated pairs every other total=", g.n);
	out
}
@end
