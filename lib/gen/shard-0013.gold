expect: => i=1 r=0.0 ok=true s="deduped tail until limit count=1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in write {
			if g.res[j] == x {
				dup = true;
				break;
			}
		}
		if !dup || write < limit {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped tail until limit count=", write);
	out
}
@end
