	var kept = 0;
	for i in g.n {
		if g.res[i] > 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		// retry: take absolute values
		for i in g.n {
			g.res[i] = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		}
		kept = g.n;
	} else {
		g.n = kept;
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "condition filter kept=", kept);
	out
}
@end
@entry 6541b9a430d7142e
kind: step
verb: repeat
noun: sequence
modifier: sorted
context: transform
phrase: repeat sorted sequence elements {count} times
phrase: duplicate sorted sequence items {count} times
slot: count int
test: list=4,2,7,1 count=2
expect: => i=8 r=0.0 ok=true s="repeated sorted sequence 2 times total length 8" errors=0 n=8 res=[1,2,4,7,1,2,4,7] cache=0 hits=0
test: list=15,3,9 count=3
expect: => i=9 r=0.0 ok=true s="repeated sorted sequence 3 times total length 9" errors=0 n=9 res=[3,9,15,3,9,15,3,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 || c <= 0 {
		out.i = 0;
		return out;
	}
	// Sort g.res first
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	let orig_n = g.n;
	for rep in c - 1 {
		for i in orig_n {
			gold_push(g, g.res[i]);
		}
	}
	g.steps += orig_n * c;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated sorted sequence ", c, " times total length ", g.n);
	out
}
@end
