expect: => i=5 r=0.0 ok=true s="applied transform to 5 unique items" errors=0 n=5 res=[9,9,25,25,49] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { found = true; break; }
			j++;
		}
		if !found {
			g.res[i] = ${f}(g.res[i]);
			count++;
		}
		i++;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "applied transform to ", count, " unique items");
	g.steps += g.n + 1;
	out
}
@end
