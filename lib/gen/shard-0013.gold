fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var letters int[..200] = [];
	for i in out.s.len {
		if out.s[i] != ' ' {
			letters.push(i);
		}
	}
	for i in letters.len {
		for j in i + 1..letters.len {
			let idx1 = letters[i];
			let idx2 = letters[j];
			if out.s[idx1] > out.s[idx2] {
				let t = out.s[idx1];
				out.s[idx1] = out.s[idx2];
				out.s[idx2] = t;
			}
		}
	}
	g.steps += letters.len * letters.len;
	out.i = out.s.len;
	out
}
