@entry 867804c5b0aee063
kind: fn
verb: dedupe
noun: function
modifier: while
context: search
phrase: dedupe adjacent identical digits while scanning
phrase: search deduplication of adjacent duplicate values
test: arg=112233,445
expect: 123
expect: 45
test: arg=9
expect: 9
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var rev int[..20] = [];
	while x > 0 {
		rev.push(x % 10);
		x /= 10;
	}
	var res = 0;
	var last_d = -1;
	var i = rev.len - 1;
	while i >= 0 {
		let d = rev[i];
		if d != last_d {
			res = res * 10 + d;
			last_d = d;
		}
		if i == 0 { break; }
		i--;
	}
	res
}
@end
