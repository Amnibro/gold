code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	var count = 0;
	for k in g.n {
		sum += g.res[k];
		count++;
		if sum >= th { break; }
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum=", sum);
	out
}
@end
@entry 1844b7ceeb7e7a23
kind: step
verb: reverse
noun: gaps
modifier: unique
context: stats
phrase: compute unique adjacent gap differences in reverse
phrase: extract distinct consecutive step gaps in reverse
test: list=1,3,5,9
expect: => i=2 r=0.0 ok=true s="gaps=2" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=10,20,30,50
expect: => i=2 r=0.0 ok=true s="gaps=2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var gaps int[512] = [0; 512];
	var count = 0;
	var i = 1;
	while i < g.n {
		var d = g.res[i] - g.res[i - 1];
		if d < 0 { d = -d; }
		var seen = false;
		for j in count {
			if gaps[j] == d { seen = true; break; }
		}
		if !seen { gaps[count] = d; count++; }
		i++;
	}
	for k in count { g.res[k] = gaps[count - 1 - k]; }
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps=", count);
	out
}
@end
