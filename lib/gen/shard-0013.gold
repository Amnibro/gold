code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= b {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " items at least bound");
	out
}
@end
