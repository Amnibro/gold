fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n > 0 {
		var min_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] < min_val { min_val = g.res[i]; }
		}
		for i in g.n {
