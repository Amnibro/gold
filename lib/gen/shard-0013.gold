@entry d6bd098fd4a965ad
kind: step
verb: rotate
noun: average
modifier: unique
context: transform
phrase: rotate unique elements around average pivot
phrase: cycle unique transformed values about average pivot
test: list=10,20,10,30,40
expect: => i=25 r=0.0 ok=true s="rotated unique elements around average pivot 25" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,15,5,25,35
expect: => i=20 r=0.0 ok=true s="rotated unique elements around average pivot 20" errors=0 n=4 res=[35,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// First make unique
	var u_idx = 0;
	for i in g.n {
		var exists = false;
		for j in u_idx {
			if g.res[j] == g.res[i] {
				exists = true;
			}
		}
		if !exists {
			g.res[u_idx] = g.res[i];
			u_idx++;
		}
	}
	g.n = u_idx;
	if g.n > 1 {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		let avg = sum / g.n;
		// rotate forward by 1 if avg > 15 else backward
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
		out.i = avg;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated unique elements around average pivot ", out.i);
	out
}
@end
