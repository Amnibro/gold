expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "prefix swap requires at least two elements");
		out.ok = false;
		return out;
	}
	let a = g.res[0];
	let b = g.res[1];
	g.res[0] = b;
	g.res[1] = a;
	gold_cache_put(g, a, b);
	gold_cache_put(g, b, a);
	g.steps += g.n;
	out.i = 1;
	out.s.clear();
	format(out.s, "swapped prefix elements safely");
	out
}
@end
@entry ae3b96cc99392b6a
kind: step
verb: swap
noun: counter
modifier: until
context: error
phrase: swap counter values until reaching limit {limit}
phrase: exchange counter bounds until limit {limit} met
slot: limit int
test: list=10,20,30 limit=2
expect: => i=1 r=0.0 ok=true s="swapped counters count 1" errors=0 n=3 res=[20,10,30] cache=0 hits=0
test: list=5 limit=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for counter swap");
		out.ok = false;
		return out;
	}
	let max_swaps = ${limit};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && swaps < max_swaps {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped counters count ", swaps);
	out
}
@end
@entry 54038d755deb5157
kind: step
verb: keep
noun: tail
modifier: recursively
context: error
phrase: keep trailing elements recursively verifying length {count}
phrase: retain tail items recursively checking size {count}
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="retained tail elements 3" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20 count=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	if req > g.n {
		gold_fail(g, "requested tail exceeds list size");
		out.ok = false;
		return out;
	}
	var kept = 0;
	let start_idx = g.n - req;
	for i in start_idx..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained tail elements ", kept);
	out
}
@end
