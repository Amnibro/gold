			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	gold_push(g, dropped);
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped budget count ", dropped);
	g.steps += g.n + 1;
	out
}
@end
