@entry 32210c3dd097e3e7
kind: step
verb: keep
noun: runs
modifier: at_least
context: sort
phrase: keep sorted runs of identical values at least length {min_run}
phrase: filter sorted elements appearing at least {min_run} times
slot: min_run int
test: list=2,5,2,2,7,5 min_run=2
expect: => i=5 r=0.0 ok=true s="retained 5 elements in valid runs" errors=0 n=5 res=[2,2,2,5,5] cache=0 hits=0
test: list=1,2,3,4 min_run=2
expect: => i=0 r=0.0 ok=true s="retained 0 elements in valid runs" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_run};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let run_len = j - i;
		if run_len >= req {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " elements in valid runs");
	out
}
@end
