expect: => i=3 r=0.0 ok=true s="retry histogram at least threshold count 3" errors=0 n=5 res=[5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept_count = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= th {
			kept_count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = kept_count;
	out.s.clear();
	format(out.s, "retry histogram at least threshold count ", kept_count);
	out
}
@end
