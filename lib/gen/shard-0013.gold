fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var idx = g.n - 1;
	while idx >= 0 {
		g.res[2 * idx + 1] = g.res[idx];
		g.res[2 * idx] = g.res[idx];
		if idx == 0 { break; }
		idx--;
	}
	g.n = 2 * g.n;
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "all items duplicated");
	out
}
@end
