expect: => i=4 r=0.0 ok=true s="abcd" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var target = ${limit};
	if target < 0 { target = 0; }
	if target > 200 { target = 200; }
	if out.s.len > target {
		out.s.resize(target, 0);
	} else {
		var initial_len = out.s.len;
		if initial_len > 0 {
			while out.s.len < target {
				let rem = target - out.s.len;
				let take = if rem < initial_len { rem } else { initial_len };
				for i in take {
					out.s.push(out.s[i]);
				}
			}
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
