code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	gold_cache_put(g, 1, 999);
	var pushed = 0;
	while pushed < c && pushed < g.cn {
		let val, found = gold_cache_get(g, 1);
		if found { gold_push(g, val); pushed++; }
	}
	g.steps += g.n;
	out.i = pushed;
	out.s.clear();
	format(out.s, "merged=", pushed);
	out
}
@end
