fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		let avg = sum / g.n;
		for i in g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		out.i = avg;
	}
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "sorted items average=", out.i);
	out
}
@end
