code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var sum = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val, ok = gold_cache_get(g, i);
		if ok { sum += val; }
		i--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "memo scan reverse sum=", sum);
	out
}
@end
