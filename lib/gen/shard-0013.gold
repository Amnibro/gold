code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n && g.res[idx] == 0 {
		idx++;
	}
	var kept = 0;
	for i in idx..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = if kept > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "retained non zero head ", out.i);
	out
}
@end
