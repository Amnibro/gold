test: list=1,2,3,4,5 start_idx=2 end_idx=4
expect: => i=5 r=0.0 ok=true s="reversed_range" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40,50 start_idx=1 end_idx=3
expect: => i=5 r=0.0 ok=true s="reversed_range" errors=0 n=5 res=[10,40,30,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start_idx};
	var e = ${end_idx};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	while s < e {
		let tmp = g.res[s];
		g.res[s] = g.res[e];
		g.res[e] = tmp;
		s++;
		e--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed_range");
	out
}
@end
