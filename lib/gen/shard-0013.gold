fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_gap = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			var gap = g.res[i + 1] - g.res[i];
			if gap < 0 { gap = -gap; }
			run_gap += gap;
			g.res[i] = run_gap;
		}
		g.n -= 1;
	}
	g.steps += g.n;
	out.i = run_gap;
	out.s.clear();
	format(out.s, "running gap sum: ", run_gap);
	out
}
@end
