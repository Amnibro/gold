@entry 7303fdcde8c401fc
kind: step
verb: group
noun: primes
modifier: nested
context: core
phrase: group primes with nested categorization
phrase: separate prime numbers into nested groups
test: list=2,4,5,6,7,8,9,11
expect: => i=4 r=0.0 ok=true s="primes 4 non-primes 4" errors=0 n=8 res=[2,5,7,11,4,6,8,9] cache=0 hits=0
test: list=10,12,13,15,17
expect: => i=2 r=0.0 ok=true s="primes 2 non-primes 3" errors=0 n=5 res=[13,17,10,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var non_primes int[512] = [0; 512];
	var np = 0;
	var nnp = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			primes[np] = x;
			np++;
		} else {
			non_primes[nnp] = x;
			nnp++;
		}
	}
	for i in np { g.res[i] = primes[i]; }
	for i in nnp { g.res[np + i] = non_primes[i]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "primes ", np, " non-primes ", nnp);
	out
}
@end
