code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	for pass in g.n {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i++;
		}
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "safely swapped sequence into order swaps ", swaps);
	out
}
@end
