fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${k};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	let ok = primes >= threshold;
	g.steps += g.n;
	out.ok = ok;
	out.i = primes;
	out.s.clear();
	format(out.s, "primes count=", primes, " ok=", ok);
	out
}
@end
