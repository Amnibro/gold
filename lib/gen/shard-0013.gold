expect: => i=3 r=0.0 ok=false s="rotated checkpoint until target count=3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var rotations = 0;
	while rotations < g.n && g.res[0] != target {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rotations++;
	}
	g.steps += rotations + 1;
	out.i = rotations;
	out.ok = (g.n > 0 && g.res[0] == target);
	out.s.clear();
	format(out.s, "rotated checkpoint until target count=", rotations);
	out
}
@end
