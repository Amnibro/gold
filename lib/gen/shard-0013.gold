@entry 4ab8dc887ff43004
kind: step
verb: validate
noun: series
modifier: with_retry
context: transform
phrase: validate monotonic series allowing {retries} retries
phrase: verify ascending series within {retries} retry budget
slot: retries int
test: list=1,3,2,4,5 retries=2
expect: => i=1 r=0.0 ok=true s="validated series with 1 drops allowed 2" errors=0 n=5 res=[1,3,2,4,5] cache=0 hits=0
test: list=1,5,2,3,6 retries=1
expect: => i=1 r=0.0 ok=true s="validated series with 1 drops allowed 1" errors=0 n=5 res=[1,5,2,3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let allowed_retries = ${retries};
	var drops = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] {
			drops++;
		}
		i++;
	}
	let ok_series = drops <= allowed_retries;
	if !ok_series {
		out.ok = false;
		gold_fail(g, "series exceeded allowed drops");
	}
	g.steps += g.n + allowed_retries;
	out.i = drops;
	out.s.clear();
	format(out.s, "validated series with ", drops, " drops allowed ", allowed_retries);
	out
}
@end
