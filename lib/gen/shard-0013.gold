expect: => i=40 r=0.0 ok=true s="dropped history cache 40" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let dropped = g.res[g.n - 1];
		g.n = g.n - 1;
		gold_cache_put(g, 0, dropped);
		gold_push(g, dropped);
		out.i = dropped;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "dropped history cache ", out.i);
	g.steps += g.n + 1;
	out
}
@end
