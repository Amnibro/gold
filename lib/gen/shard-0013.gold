@entry ceba8f25123f64a1
kind: step
verb: clamp
noun: total
modifier: with_cache
context: retry
phrase: clamp total retry sum with cache limit {cap}
phrase: restrict cumulative retry total with cache at {cap}
slot: cap int
test: list=10,20,30 cap=25
expect: => i=25 r=0.0 ok=true s="clamped total with cache is 25" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,8,12 cap=15
expect: => i=15 r=0.0 ok=true s="clamped total with cache is 15" errors=0 n=3 res=[5,8,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let cached, ok = gold_cache_get(g, total);
	if ok {
		out.i = cached;
	} else {
		let clamped = if total > c { c } else { total };
		gold_cache_put(g, total, clamped);
		out.i = clamped;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "clamped total with cache is ", out.i);
	out
}
@end
@entry 072afeef41c6d412
kind: step
verb: filter
noun: limit
modifier: with_retry
context: retry
phrase: filter values exceeding limit {lim} with retry budget {max_retries}
phrase: apply limit {lim} filter with retry allowance {max_retries}
slot: lim int
slot: max_retries int
test: list=10,15,20,25 lim=12 max_retries=2
expect: => i=1 r=0.0 ok=true s="filtered 1 items with retry count 0" errors=0 n=1 res=[10] cache=0 hits=0
test: list=50,60,70 lim=40 max_retries=3
expect: => i=1 r=0.0 ok=true s="filtered 1 items with retry count 1" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${lim};
	let mr = ${max_retries};
	var attempts = 0;
	var keep = 0;
	while attempts <= mr {
		keep = 0;
		for i in g.n {
			if g.res[i] <= l {
				keep++;
			}
		}
		if keep > 0 || attempts == mr {
			break;
		}
		l += 10;
		attempts++;
	}
	var write_idx = 0;
	for j in g.n {
		if g.res[j] <= l {
			g.res[write_idx] = g.res[j];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += attempts + 1;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "filtered ", write_idx, " items with retry count ", attempts);
	out
}
@end
