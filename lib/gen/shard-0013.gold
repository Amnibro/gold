phrase: pair histogram nested frequencies across mathematical results
phrase: combine nested frequency counts into mathematical pairs
test: list=1,1,2,2,3,4
expect: => i=2 r=0.0 ok=true s="paired nested histogram frequencies count 2" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=5,5,5,6,7,7
expect: => i=1 r=0.0 ok=true s="paired nested histogram frequencies count 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vals int[>..] = [];
	var freqs int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in vals.len {
			if vals[j] == x { freqs[j] += 1; found = true; break; }
		}
		if !found { vals.push(x); freqs.push(1); }
	}
	var write_idx = 0;
	var i = 0;
	while i + 1 < freqs.len {
		g.res[write_idx] = freqs[i] + freqs[i + 1];
		write_idx++;
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "paired nested histogram frequencies count ", write_idx);
	out
}
@end
