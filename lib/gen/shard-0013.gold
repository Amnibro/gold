expect: => i=3 r=0.0 ok=true s="rotated_range: 3" errors=0 n=4 res=[2,3,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${low};
	var hi = ${high};
	if lo < 0 { lo = 0; }
	if hi >= g.n { hi = g.n - 1; }
	if lo < hi {
		let first = g.res[lo];
		for i in lo..hi {
			g.res[i] = g.res[i + 1];
		}
		g.res[hi] = first;
	}
	g.steps += g.n;
	out.i = if hi >= lo { hi - lo + 1 } else { 0 };
	out.s.clear();
	format(out.s, "rotated_range: ", out.i);
	out
}
@end
