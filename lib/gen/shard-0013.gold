code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_freq = ${exact_count};
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == target_freq {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n * g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept elements matching exact frequency count ", write_idx);
	out
}
@end
