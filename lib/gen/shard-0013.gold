code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var write_idx = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a >= low && a <= high && b >= low && b <= high {
			g.res[write_idx] = a + b;
			write_idx++;
		}
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "paired range items count ", write_idx);
	out
}
@end
@entry 09fc6c5d7f5dc4d8
kind: step
verb: pair
noun: budget
modifier: recursively
context: core
phrase: pair budget recursively within limit {budget} in core
phrase: combine pairs recursively under total budget {budget} in core
slot: budget int
test: list=1,2,3,4,5,6 budget=12
expect: => i=10 r=0.0 ok=true s="paired budget recursively total 10" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=10,20,30,40 budget=50
expect: => i=30 r=0.0 ok=true s="paired budget recursively total 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var write_idx = 0;
	var total = 0;
	var i = 0;
	while i + 1 < g.n {
		let p = g.res[i] + g.res[i + 1];
		if total + p <= b {
			total += p;
			g.res[write_idx] = p;
			write_idx++;
		}
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = total;
	out.s.clear();
	format(out.s, "paired budget recursively total ", total);
	out
}
@end
