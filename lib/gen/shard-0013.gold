phrase: eliminate duplicates across every other retry window
test: list=2,2,4,5,6,6
expect: => i=2 r=0.0 ok=true s="found 2 duplicates in every other window" errors=0 n=6 res=[2,2,4,5,6,6] cache=0 hits=0
test: list=7,7,8,9,9,10
expect: => i=1 r=0.0 ok=true s="found 1 duplicates in every other window" errors=0 n=6 res=[7,7,8,9,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var deduped = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			deduped++;
		}
		i += 2;
	}
	g.steps += deduped + 1;
	out.i = deduped;
	out.s.clear();
	format(out.s, "found ", deduped, " duplicates in every other window");
	out
}
@end
@entry 8109121661b9bf77
kind: step
verb: validate
noun: step
modifier: running
context: retry
phrase: validate running retry step limit {max_step}
phrase: verify each running step within {max_step}
slot: max_step int
test: list=1,3,6,8 max_step=3
expect: => i=4 r=0.0 ok=true s="all running steps are within limit 3" errors=0 n=4 res=[1,3,6,8] cache=0 hits=0
test: list=1,5,10 max_step=3
expect: => i=3 r=0.0 ok=false s="running step exceeded limit 3" errors=0 n=3 res=[1,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var valid = true;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 {
			diff = -diff;
		}
		if diff > ms {
			valid = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = g.n;
	out.s.clear();
	if valid {
		format(out.s, "all running steps are within limit ", ms);
	} else {
		format(out.s, "running step exceeded limit ", ms);
	}
	out
}
@end
