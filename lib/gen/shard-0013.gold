kind: step
verb: group
noun: threshold
modifier: nested
context: core
phrase: group threshold nested by cutoff {cutoff}
phrase: partition values nested around threshold {cutoff}
slot: cutoff int
test: list=10,50,20,40,30 cutoff=25
expect: => i=2 r=0.0 ok=true s="below cutoff 2 above 3" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
test: list=1,2,3,4 cutoff=2
expect: => i=2 r=0.0 ok=true s="below cutoff 2 above 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${cutoff};
	var below int[512] = [0; 512];
	var above int[512] = [0; 512];
	var nb = 0;
	var na = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= cutoff {
			below[nb] = x;
			nb++;
		} else {
			above[na] = x;
			na++;
		}
	}
	for i in nb { g.res[i] = below[i]; }
	for i in na { g.res[nb + i] = above[i]; }
	g.steps += g.n;
	out.i = nb;
	out.s.clear();
	format(out.s, "below cutoff ", nb, " above ", na);
	out
}
@end
