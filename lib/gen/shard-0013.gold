@entry 63d986581f3f44b6
kind: step
verb: rank
noun: digits
modifier: pairwise
context: math
phrase: rank digits of number by pairwise differences
phrase: evaluate pairwise digit relations in number
test: input=1352
expect: => i=2 r=0.0 ok=true s="increasing digit pairs: 2" errors=0 n=0 res=[] cache=0 hits=0
test: input=987
expect: => i=0 r=0.0 ok=true s="increasing digit pairs: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if v.i < 0 { -v.i } else { v.i };
	var digits int[64] = [0; 64];
	var dn = 0;
	if x == 0 {
		digits[0] = 0;
		dn = 1;
	}
	while x > 0 {
		digits[dn] = x % 10;
		dn++;
		x /= 10;
	}
	var inc_pairs = 0;
	var idx = dn - 1;
	while idx > 0 {
		if digits[idx] < digits[idx - 1] {
			inc_pairs++;
		}
		idx--;
	}
	g.steps += dn;
	out.i = inc_pairs;
	out.s.clear();
	format(out.s, "increasing digit pairs: ", inc_pairs);
	out
}
@end
