fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..100] = "";
	if v.s.len > 0 {
		var i = v.s.len - 1;
		while i >= 0 {
			let c = v.s[i];
			if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
			   c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' {
				vowels.push(c);
			}
			if i == 0 { break; }
			i--;
		}
	}
	g.steps += v.s.len + 1;
	out.s.clear();
	for b in vowels {
		out.s.push(b);
	}
	out.i = vowels.len;
	out
}
@end
