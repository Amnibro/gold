code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let ms = ${max_steps};
	var found = false;
	var steps_taken = 0;
	var idx = 0;
	while idx < g.n && steps_taken < ms {
		steps_taken++;
		if g.res[idx] == tgt {
			found = true;
			break;
		}
		idx++;
	}
	g.steps += steps_taken;
	out.ok = found;
	out.i = steps_taken;
	out.s.clear();
	if found {
		format(out.s, "found retry value in ", steps_taken, " steps");
	} else {
		format(out.s, "retry value not found after ", steps_taken, " steps");
	}
	out
}
@end
