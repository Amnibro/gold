		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x >= 10 {
			x /= 10;
		}
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "extracted first digits of ", g.n, " items");
	out
}
@end
@entry 80624e4a921e039e
