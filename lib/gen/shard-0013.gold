code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in write {
			if g.res[j] == x {
				exists = true;
				break;
			}
		}
		if !exists && write < limit {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out
}
@end
