test: list=1,1,2,3,3,3,4
expect: => i=2 r=0.0 ok=true s="duplicates: 2" errors=0 n=7 res=[1,1,2,3,3,3,4] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="duplicates: 0" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var duplicates = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first {
			var freq = 0;
			for k in g.n {
				if g.res[k] == g.res[i] {
					freq++;
				}
			}
			if freq > 1 {
				duplicates++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = duplicates;
	out.s.clear();
	format(out.s, "duplicates: ", duplicates);
	out
}
@end
