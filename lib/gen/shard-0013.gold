fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = if ${limit} < 0 { 0 } else { if ${limit} > g.n { g.n } else { ${limit} } };
	let start = g.n - lim;
	var count = 0;
	var i = start;
	while i < g.n {
		g.res[count] = g.res[i];
		count++;
		i++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited suffix to ", count);
	g.steps += count + 1;
	out
}
@end
