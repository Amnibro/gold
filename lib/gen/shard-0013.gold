fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > th {
			count++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " reverse entries exceeding threshold");
	out
}
