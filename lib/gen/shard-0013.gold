kind: step
verb: map
noun: gaps
modifier: while
context: retry
phrase: map gaps between items while under limit {max_gap}
phrase: compute adjacent gaps while below threshold {max_gap}
slot: max_gap int
test: list=2,5,8,20 max_gap=5
expect: => i=2 r=0.0 ok=true s="valid gaps mapped 2" errors=0 n=2 res=[3,3] cache=0 hits=0
test: list=10,12,14 max_gap=5
expect: => i=2 r=0.0 ok=true s="valid gaps mapped 2" errors=0 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_gap};
	var count = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > cap {
			break;
		}
		g.res[count] = gap;
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "valid gaps mapped ", count);
	out
}
@end
