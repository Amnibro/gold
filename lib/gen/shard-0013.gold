code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = ${f}(g.res[i]);
		let b = ${f}(g.res[i + 1]);
		g.res[pairs] = a + b;
		pairs++;
		i += 2;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired function items safely ", pairs);
	out
}
@end
