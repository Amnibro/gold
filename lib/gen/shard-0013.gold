code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	for i in g.n { s += g.res[i]; }
	if g.n == 0 {
		gold_push(g, 1);
		s = 1;
	}
	let avg = s as real / g.n as real;
	g.steps += g.n;
	out.i = s;
	out.r = avg;
	out.s.clear();
	format(out.s, "average with retry sum: ", s);
	gold_push(g, s);
	out
}
@end
