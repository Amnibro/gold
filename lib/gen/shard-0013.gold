@entry ba5f4498d6f27602
kind: step
verb: compare
noun: gaps
modifier: first
context: sort
phrase: compare gaps at first position
phrase: inspect initial gap between sorted elements
phrase: check first interval gap
test: list=2,5,10
expect: => i=-1 r=0.0 ok=true s="first gap cmp -1" errors=0 n=4 res=[2,5,10,-1] cache=0 hits=0
test: list=4,5,9
expect: => i=-1 r=0.0 ok=true s="first gap cmp -1" errors=0 n=4 res=[4,5,9,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		out.s.clear();
		out.s.append("insufficient elements");
		g.steps++;
		return out;
	}
	let g1 = g.res[1] - g.res[0];
	let g2 = g.res[2] - g.res[1];
	let cmp = if g1 < g2 { -1 } else if g1 > g2 { 1 } else { 0 };
	gold_push(g, cmp);
	out.i = cmp;
	out.s.clear();
	format(out.s, "first gap cmp ", cmp);
	g.steps += 3;
	out
}
@end
