expect: => i=3 r=0.0 ok=true s="counter deduped safely" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=-1,2,-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[-1,2,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] < 0 { gold_fail(g, "negative counter element"); out.ok = false; return out; }
	}
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	gold_text(out, "counter deduped safely");
	out
}
@end
