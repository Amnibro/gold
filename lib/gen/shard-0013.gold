code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
		}
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	if max_streak < ${min_streak} {
		gold_fail(g, "required streak length not found");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak found ", max_streak);
	out
}
@end
