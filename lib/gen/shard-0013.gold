fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_ordered = true;
	let half = g.n / 2;
	var i = 0;
	while i + 1 < half {
		if g.res[i] > g.res[i + 1] {
			is_ordered = false;
			break;
		}
		i++;
	}
	g.steps += half;
	out.ok = is_ordered;
	out.i = if is_ordered { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked prefix pairwise ordering status ", out.i);
	out
}
@end
