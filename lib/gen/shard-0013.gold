fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var valid = true;
	var max_freq = 0;
	for i in g.n {
		let x = g.res[i];
		var c = 0;
		for j in g.n {
			if g.res[j] == x {
				c++;
			}
		}
		if c > max_freq {
			max_freq = c;
		}
		if c > mc {
			valid = false;
		}
	}
	out.ok = valid;
	out.i = max_freq;
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "histogram valid: ", valid);
	out
}
@end
