fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var min_val = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
		if freq == 1 {
			if !found || g.res[i] < min_val {
				min_val = g.res[i];
				found = true;
			}
		}
	}
	g.steps += g.n * g.n;
	out.ok = found;
	out.i = if found { min_val } else { -1 };
	out.s.clear();
	format(out.s, "min_unique: ", out.i);
	out
}
