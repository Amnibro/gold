@entry d844021ed15de960
kind: step
verb: cache
noun: tail
modifier: until
context: transform
slot: stop_val int
phrase: transform cache tail until cutoff {stop_val}
phrase: store tail elements backwards until {stop_val}
test: list=10,2,20,30 stop_val=5
expect: => i=2 r=0.0 ok=true s="cached 2 tail elements" errors=0 n=4 res=[10,2,20,30] cache=2 hits=0
test: list=4,8 stop_val=10
expect: => i=0 r=0.0 ok=true s="cached 0 tail elements" errors=0 n=2 res=[4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${stop_val};
	var cached_count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if g.res[k] <= sv {
			break;
		}
		gold_cache_put(g, cached_count + 1, g.res[k]);
		cached_count++;
	}
	g.steps += g.n + 1;
	out.i = cached_count;
	out.s.clear();
	format(out.s, "cached ", cached_count, " tail elements");
	out
}
@end
@entry 5b28a4ab0a996e41
kind: step
verb: find
noun: results
modifier: with_cache
context: transform
slot: query_key int
phrase: transform find results with cache lookup {query_key}
phrase: search cache for query key {query_key}
test: list=10,20 query_key=1
expect: => i=30 r=0.0 ok=true s="cache miss for key 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5 query_key=2
expect: => i=5 r=0.0 ok=true s="cache miss for key 2" errors=0 n=2 res=[5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${query_key};
	let val, found = gold_cache_get(g, k);
	if found {
		gold_push(g, val);
		out.i = val;
		out.s.clear();
		format(out.s, "cache hit for key ", k);
	} else {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		gold_cache_put(g, k, sum);
		gold_push(g, sum);
		out.i = sum;
		out.s.clear();
		format(out.s, "cache miss for key ", k);
	}
	g.steps += g.n + 1;
	out
}
@end
