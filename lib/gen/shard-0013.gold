		let x = g.res[i];
		if x >= l && x <= h {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "returned values between bounds count=", write);
	out
}
@end
