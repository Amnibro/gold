verb: pair
noun: range
modifier: each
context: core
phrase: pair range each between {lo} with {hi} in core
phrase: pair each element within range {lo} through {hi} in core
slot: lo int
slot: hi int
test: list=2,4,8,10,12,14 lo=3 hi=11
expect: => i=1 r=0.0 ok=true s="paired range items count 1" errors=0 n=1 res=[18] cache=0 hits=0
test: list=5,15,20,25 lo=10 hi=30
