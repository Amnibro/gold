code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean byte[..200] = "";
	for b in v.s {
		if b >= '0' && b <= '9' {
			if clean.len < 200 {
				clean.push(b);
			}
		}
	}
	out.s.clear();
	for b in clean {
		out.s.push(b);
	}
	out.i = out.s.len;
	g.steps += out.i;
	out
}
@end
