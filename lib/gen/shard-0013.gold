phrase: split threshold recursively around cutoff {cutoff}
phrase: partition values recursively with cutoff {cutoff}
slot: cutoff int
test: list=10,50,20,40,30 cutoff=25
expect: => i=2 r=0.0 ok=true s="split at cutoff 25: below 2" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
test: list=5,15,25 cutoff=10
expect: => i=1 r=0.0 ok=true s="split at cutoff 10: below 1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var below int[512] = [0; 512];
	var above int[512] = [0; 512];
	var nb = 0;
	var na = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= cut {
			below[nb] = x;
			nb++;
		} else {
			above[na] = x;
			na++;
		}
	}
	for i in nb { g.res[i] = below[i]; }
	for i in na { g.res[nb + i] = above[i]; }
	g.steps += g.n;
	out.i = nb;
	out.s.clear();
	format(out.s, "split at cutoff ", cut, ": below ", nb);
	out
}
@end
