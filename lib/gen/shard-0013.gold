kind: step
verb: join
noun: list
modifier: sorted
context: retry
phrase: join retry list values sorted
phrase: merge retry list elements into sorted sequence
slot: factor int
test: list=8,3,5,1 factor=2
expect: => i=4 r=0.0 ok=true s="joined and sorted retry list of 4 elements" errors=0 n=4 res=[2,6,10,16] cache=0 hits=0
test: list=12,4,9 factor=3
expect: => i=3 r=0.0 ok=true s="joined and sorted retry list of 3 elements" errors=0 n=3 res=[12,27,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for k in g.n {
		g.res[k] *= f;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined and sorted retry list of ", g.n, " elements");
	out
}
@end
