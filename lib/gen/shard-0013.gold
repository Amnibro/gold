modifier: pairwise
context: filter
phrase: scale pairwise history differences by {factor}
phrase: multiply adjacent history gaps by factor {factor}
slot: factor int
test: list=2,5,10 factor=2
expect: => i=2 r=0.0 ok=true s="pairwise history scaled count=2" errors=0 n=2 res=[6,10] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=1 r=0.0 ok=true s="pairwise history scaled count=1" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var count = 0;
	for i in (g.n - 1) {
		let diff = if g.res[i+1] > g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
		g.res[count] = diff * f;
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise history scaled count=", count);
	out
}
@end
