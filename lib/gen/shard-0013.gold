@entry e9a2d992375cfb33
kind: step
verb: measure
noun: primes
modifier: at_least
context: aggregate
phrase: measure primes at least {min_val} in aggregate
phrase: count prime values at least {min_val} across aggregate
slot: min_val int
test: list=2,3,4,5,11,12 min_val=3
expect: => i=3 r=0.0 ok=true s="measured primes at least threshold count 3" errors=0 n=6 res=[2,3,4,5,11,12] cache=0 hits=0
