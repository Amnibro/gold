@entry 1652b81129796026
kind: step
verb: compare
noun: suffix
modifier: first
context: format
slot: suffix text
phrase: format compare suffix first against string {suffix}
phrase: render suffix matching check using {suffix}
test: text="report.txt" suffix="txt"
expect: => i=1 r=0.0 ok=true s="suffix match: txt" errors=0 n=0 res=[] cache=0 hits=0
test: text="image.png" suffix="txt"
expect: => i=0 r=0.0 ok=true s="suffix mismatch: txt" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let suf = ${suffix};
	var matches = false;
	if out.s.len >= suf.len {
		matches = true;
		let start = out.s.len - suf.len;
		for i in suf.len {
			if out.s[start + i] != suf[i] {
				matches = false;
				break;
			}
		}
	}
	out.s.clear();
	if matches {
		format(out.s, "suffix match: ", suf);
		out.i = 1;
	} else {
		format(out.s, "suffix mismatch: ", suf);
