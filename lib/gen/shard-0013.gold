code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in write {
			if g.res[j] == x {
				dup = true;
				break;
			}
		}
		if !dup {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped step keeping first remaining=", write);
	out
}
@end
