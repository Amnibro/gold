code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	var total_distinct = 0;
	if w > 0 && out.s.len >= w {
		for i in out.s.len - w + 1 {
			var seen bool[256];
			for k in 256 { seen[k] = false; }
			var distinct = 0;
			for j in i..i + w {
				let b = out.s[j] as int;
				if b >= 0 && b < 256 && !seen[b] {
					seen[b] = true;
					distinct++;
				}
			}
			total_distinct += distinct;
		}
	}
	g.steps += out.s.len;
	out.i = total_distinct;
	out
}
@end
