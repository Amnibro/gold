noun: subfunction
modifier: nested
context: stats
phrase: swap extreme sample values placing min with max
phrase: exchange minimum with maximum values across sample
test: list=10,50,20,5
expect: => i=1 r=0.0 ok=true s="swapped_extremes" errors=0 n=4 res=[10,5,20,50] cache=0 hits=0
test: list=1,100,2,90
expect: => i=1 r=0.0 ok=true s="swapped_extremes" errors=0 n=4 res=[100,1,2,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_idx = 0;
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	let tmp = g.res[min_idx];
	g.res[min_idx] = g.res[max_idx];
	g.res[max_idx] = tmp;
	g.steps += g.n;
	out.i = 1;
	out.s.clear();
	format(out.s, "swapped_extremes");
	out
}
@end
