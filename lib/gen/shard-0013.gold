@entry d7a2f4fdb1097ebe
kind: step
verb: reverse
noun: middle
modifier: none
context: transform
phrase: reverse middle elements when none are zero
phrase: invert center range if none equal zero
test: list=1,2,3,4,5
expect: => i=1 r=0.0 ok=true s="reversed middle none zero=true" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=1,0,3,4,5
expect: => i=0 r=0.0 ok=true s="reversed middle none zero=false" errors=0 n=5 res=[1,0,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_zero = false;
	if g.n >= 3 {
		let start = 1;
		let end = g.n - 1;
		for i in start..end {
			if g.res[i] == 0 { has_zero = true; break; }
		}
		if !has_zero {
			let mid_len = end - start;
			for i in (mid_len / 2) {
				let tmp = g.res[start + i];
				g.res[start + i] = g.res[end - 1 - i];
				g.res[end - 1 - i] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = if has_zero { 0 } else { 1 };
	out.s.clear();
	format(out.s, "reversed middle none zero=", !has_zero);
	out
}
@end
