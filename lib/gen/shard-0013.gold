fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	if bound == 0 {
		out.i = 0;
		return out;
	}
	let first_val = g.res[0];
	var rank = 1;
	for i in bound {
		if g.res[i] < first_val {
			rank++;
		}
	}
	g.steps += bound;
	out.i = rank;
	out.s.clear();
	format(out.s, "initial value ranks ", rank, " among first ", bound, " entries");
	out
}
@end
