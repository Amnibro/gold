code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "window reversed");
	out
}
@end
