fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${ch};
	var r_byte byte = 'a';
	for b in rep { r_byte = b; break; }
	var changes = 0;
	var i = out.s.len;
	while i > 0 {
		i--;
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			out.s[i] = r_byte;
			changes++;
		} else {
			break;
		}
	}
	out.i = changes;
	out
}
@end
