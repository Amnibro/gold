fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= mv {
			sum += g.res[i];
			count++;
		}
	}
	let avg = if count > 0 { sum as real / count as real } else { 0.0 };
	out.i = sum;
	out.r = avg;
	out.s.clear();
	format(out.s, "sum at least min val: ", sum);
	g.steps += g.n;
	gold_push(g, sum);
	out
}
@end
