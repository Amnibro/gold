fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var prefix_sum = 0;
	let lim = if g.n < 2 { g.n } else { 2 };
	for i in lim {
		prefix_sum += g.res[i];
	}
	let ok_flag = prefix_sum >= fl;
	gold_cache_put(g, 0, prefix_sum);
	gold_push(g, prefix_sum);
	out.i = prefix_sum;
	out.ok = ok_flag;
	out.s.clear();
	format(out.s, "prefix sum ", prefix_sum);
	g.steps += g.n + 1;
	out
}
