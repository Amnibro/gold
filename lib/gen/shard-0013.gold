fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_s byte[..200] = "";
	var i = 0;
	var removed = 0;
	while i < out.s.len {
		if i + 1 < out.s.len && out.s[i] == out.s[i + 1] {
			new_s.push(out.s[i]);
			removed++;
			i += 2;
		} else {
			new_s.push(out.s[i]);
			i++;
		}
	}
	out.s = new_s;
	out.i = removed;
	gold_push(g, removed);
	g.steps += out.s.len + 1;
	out
}
@end
@entry 16a170dda51149ba
kind: step
verb: compare
noun: primes
modifier: each
context: stats
phrase: compare primes within each interval
phrase: check primes across each partition
phrase: evaluate primes for each segment
test: list=4,5,6,7,8,9,11
expect: => i=-1 r=0.0 ok=true s="prime balance -1" errors=0 n=8 res=[4,5,6,7,8,9,11,-1] cache=0 hits=0
test: list=12,13,14,15,17,19
expect: => i=0 r=0.0 ok=true s="prime balance 0" errors=0 n=7 res=[12,13,14,15,17,19,0] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	var non_prime = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			prime_count++;
		} else {
			non_prime++;
		}
	}
	let diff = prime_count - non_prime;
	out.i = diff;
	out.s.clear();
	format(out.s, "prime balance ", diff);
	gold_push(g, diff);
	g.steps += g.n + 1;
	out
}
@end
