expect: => i=4 r=0.0 ok=true s="mapped average between range length 4" errors=0 n=4 res=[4,4,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var start = lo;
	var end = hi;
	if start < 0 { start = 0; }
	if end >= g.n { end = g.n - 1; }
	if start <= end && g.n > 0 {
		var sum = 0;
		for i in start..(end + 1) { sum += g.res[i]; }
		let avg = sum / (end - start + 1);
		for i in start..(end + 1) { g.res[i] = avg; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped average between range length ", g.n);
	out
}
@end
