code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds++;
		}
	}
	let all_even = (odds == 0);
	if !all_even {
		out.ok = false;
		gold_fail(g, "found odd elements in even validation");
	}
	g.steps += g.n;
	out.i = g.n - odds;
	out.s.clear();
	format(out.s, "validated ", out.i, " of ", g.n, " elements as even");
	out
}
@end
