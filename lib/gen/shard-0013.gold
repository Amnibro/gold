code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n >= 3 {
		let start = g.n - 3;
		for i in 3 {
			for j in 2 - i {
				let idx = start + j;
				if g.res[idx] > g.res[idx+1] {
					let tmp = g.res[idx];
					g.res[idx] = g.res[idx+1];
					g.res[idx+1] = tmp;
					swaps++;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped tail count=", swaps);
	out
}
@end
