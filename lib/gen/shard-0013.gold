expect: => i=2 r=0.0 ok=true s="normalized 2 values to threshold" errors=0 n=3 res=[5,2,7] cache=0 hits=0
test: list=3,4 threshold=10
expect: => i=0 r=0.0 ok=true s="normalized 0 values to threshold" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var adjusted = 0;
	for i in g.n {
		if g.res[i] > th {
			while g.res[i] > th {
				g.res[i] -= th;
			}
			adjusted++;
		}
	}
	g.steps += g.n + 1;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "normalized ", adjusted, " values to threshold");
	out
}
@end
