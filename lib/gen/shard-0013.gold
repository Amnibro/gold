fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var temp int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			for k in count {
				if temp[k] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				temp[count] = x;
				count++;
			}
		} else {
			temp[count] = x;
			count++;
		}
	}
	for i in count {
		g.res[i] = temp[i];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "deduped in range: ", count);
	out
}
@end
