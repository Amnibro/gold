fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	let errs = g.errors;
	let in_range = errs >= low && errs <= high;
	if !in_range {
		gold_fail(g, "errors outside expected range");
	}
	g.steps += 1;
	out.ok = in_range;
	out.i = errs;
	out.s.clear();
	format(out.s, "errors in range=", in_range);
	out
}
@end
