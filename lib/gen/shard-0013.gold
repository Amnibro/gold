fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var valid_count = 0;
	var all_valid = true;
	for i in g.n {
		if g.res[i] >= i + off {
			valid_count++;
		} else {
			all_valid = false;
		}
	}
	out.ok = all_valid;
	out.i = valid_count;
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "valid offset items ", valid_count);
	out
}
@end
