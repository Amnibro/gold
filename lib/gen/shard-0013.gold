@entry cee93fe4944e4386
kind: step
verb: split
noun: prefix
modifier: sorted
context: cache
phrase: split prefix of sorted cache keys
phrase: partition sorted prefix elements
phrase: divide prefix of sorted cache records
slot: k int
test: list=40,10,30,20 k=2
expect: => i=30 r=0.0 ok=true s="sorted prefix sum 30" errors=0 n=5 res=[10,20,30,40,30] cache=2 hits=0
test: list=50,15,35,25 k=1
expect: => i=15 r=0.0 ok=true s="sorted prefix sum 15" errors=0 n=5 res=[15,25,35,50,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let lim = if ${k} <= 0 { 0 } else { if ${k} > g.n { g.n } else { ${k} } };
	var prefix_sum = 0;
	for m in lim {
		prefix_sum += g.res[m];
		gold_cache_put(g, m, g.res[m]);
	}
	gold_push(g, prefix_sum);
	out.i = prefix_sum;
	out.s.clear();
	format(out.s, "sorted prefix sum ", prefix_sum);
	g.steps += g.n + lim + 1;
	out
}
@end
