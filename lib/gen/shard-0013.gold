code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let mult = ${multiplier};
	var scaled = 0;
	for k in g.n {
		if g.res[k] > th {
			g.res[k] *= mult;
			scaled++;
		}
	}
	g.steps += g.n;
