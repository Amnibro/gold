@entry d5e6c68bfa86fa77
kind: step
verb: return
noun: runs
modifier: at_least
context: aggregate
phrase: return runs reaching length at least {len}
phrase: yield run sequences with length at least {len}
slot: len int
test: list=1,1,1,2,3,3 len=2
expect: => i=2 r=0.0 ok=true s="returned runs at least count=2" errors=0 n=6 res=[1,1,1,2,3,3] cache=0 hits=0
test: list=1,2,3,4 len=2
expect: => i=0 r=0.0 ok=true s="returned runs at least count=0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${len};
	var runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		if j - i >= min_l {
			runs++;
		}
		i = j;
	}
	g.steps += g.n + 1;
	out.i = runs;
	out.s.clear();
	format(out.s, "returned runs at least count=", runs);
	out
}
@end
@entry 9ea31ab974fa99a6
kind: step
verb: filter
noun: vowels
modifier: sorted
context: aggregate
phrase: filter text keeping vowels sorted alphabetically
phrase: extract vowels from text sorted in order
test: text="education"
expect: => i=5 r=0.0 ok=true s="aeiou" errors=0 n=0 res=[] cache=0 hits=0
test: text="world"
expect: => i=1 r=0.0 ok=true s="o" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[>..] = [];
	for c in out.s {
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels.push(c);
		}
	}
	for i in vowels.len {
		for j in i + 1..vowels.len {
			if vowels[i] > vowels[j] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
		}
	}
	out.s.clear();
	for b in vowels {
		if out.s.len < 200 {
			out.s.push(b);
		}
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
