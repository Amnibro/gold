@entry 5dff37cd0272f1cc
kind: step
verb: validate
noun: history
modifier: pairwise
context: filter
phrase: validate pairwise history differences below limit {delta}
phrase: check adjacent differences pairwise within {delta}
slot: delta int
test: list=2,5,7,10 delta=3
expect: => i=1 r=0.0 ok=true s="pairwise history valid=true" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=1,10,20 delta=4
expect: => i=0 r=0.0 ok=false s="pairwise history valid=false" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff > d {
			valid = false;
			break;
		}
		i++;
	}
	g.steps += g.n + 1;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "pairwise history valid=", valid);
	out
}
@end
