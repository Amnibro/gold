code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	for i in g.n {
		if i % 2 == 0 {
			g.res[i] = g.res[i] * f;
			scaled++;
		}
	}
	g.steps += g.n + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " alternate positions");
	out
}
@end
