code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < g.n { lim } else { g.n };
	for i in count {
		var j = i + 1;
		while j < count {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted runs within first ", count, " entries");
	out
}
@end
