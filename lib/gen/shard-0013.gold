kind: step
verb: find
noun: primes
modifier: unique
context: sort
phrase: find unique prime numbers in sort
phrase: detect distinct prime values
phrase: locate unique prime elements across dataset
test: list=2,2,3,4,5,5,7
expect: => i=4 r=0.0 ok=true s="found unique primes 4" errors=0 n=11 res=[2,2,3,4,5,5,7,2,3,5,7] cache=0 hits=0
test: list=11,11,13,15,17,19
expect: => i=4 r=0.0 ok=true s="found unique primes 4" errors=0 n=10 res=[11,11,13,15,17,19,11,13,17,19] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var i = 2;
	while i * i <= n {
		if n % i == 0 { return false; }
		i++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_primes = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == val { seen = true; break; }
			j++;
		}
		if !seen && ${ID}_is_prime(val) {
			unique_primes++;
			gold_push(g, val);
		}
		i++;
	}
	out.i = unique_primes;
	out.s.clear();
	format(out.s, "found unique primes ", unique_primes);
	g.steps += g.n + 1;
	out
}
@end
