code:
fn ${ID}(n int) int {
	var target = n;
	if target <= 1 { return 2; }
	if target > 50 { target = 50; }
	var count = 0;
	var cand = 2;
	while count < target {
		var is_p = true;
		var d = 2;
		while d * d <= cand {
			if cand % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			count++;
			if count == target { return cand; }
		}
		cand++;
	}
	cand
}
@end
