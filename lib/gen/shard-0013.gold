phrase: detect duplicate elements checking ceiling {max_allowed}
slot: max_allowed int
test: list=3,5,3,8,5 max_allowed=2
expect: => i=2 r=0.0 ok=true s="duplicates scanned 2" errors=0 n=5 res=[3,5,3,8,5] cache=0 hits=0
test: list=1,2,3,4 max_allowed=0
expect: => i=0 r=0.0 ok=true s="duplicates scanned 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_allowed};
	var dups = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dups++;
			}
		}
	}
	out.ok = (dups <= limit);
	g.steps += g.n * g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicates scanned ", dups);
	out
}
@end
