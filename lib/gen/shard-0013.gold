fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	let mid = g.n / 2;
	for i in mid..g.n {
		if b > 0 { g.res[i] = g.res[i] % b; }
	}
	out.i = g.n - mid;
	out
}
