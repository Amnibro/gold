@entry d3af0d84266bf42a
kind: fn
verb: dedupe
noun: checkpoint
modifier: last
context: format
phrase: remove duplicate occurrences of final digit
phrase: dedupe trailing digit check across number
test: arg=1232,5555
expect: 132
expect: 5
test: arg=1020
expect: 120
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return x;
	}
	let last = x % 10;
	x /= 10;
	var d int[>..] = [];
	while x > 0 {
		let cur = x % 10;
		if cur != last {
			d.push(cur);
		}
		x /= 10;
	}
	var res = 0;
	var i = d.len - 1;
	while i >= 0 {
		res = res * 10 + d[i];
		i--;
	}
	res * 10 + last
}
@end
@entry 0f2bb7a55de238bc
kind: fn
verb: trace
noun: pairs
modifier: unique
context: format
phrase: count unique adjacent digit pairs
phrase: tally distinct consecutive digit transitions
test: arg=1212,1111
expect: 2
expect: 1
test: arg=1234
expect: 3
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return 0;
	}
	var pairs int[>..] = [];
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let p = cur * 10 + prev;
		var found = false;
		for v in pairs {
			if v == p {
				found = true;
				break;
			}
		}
		if !found {
			pairs.push(p);
		}
		prev = cur;
		x /= 10;
	}
	pairs.len
}
@end
