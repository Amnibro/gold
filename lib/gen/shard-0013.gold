@entry 927b7ea4c0aeb9e9
kind: step
verb: group
noun: spaces
modifier: with_cache
context: transform
slot: cache_slot int
phrase: transform group spaces with cache slot {cache_slot}
phrase: count space delimited tokens caching at {cache_slot}
test: text="one two three" cache_slot=1
expect: => i=3 r=0.0 ok=true s="cached word count 3" errors=0 n=1 res=[3] cache=1 hits=0
test: text="hello" cache_slot=2
expect: => i=1 r=0.0 ok=true s="cached word count 1" errors=0 n=1 res=[1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${cache_slot};
	var words = 0;
	var in_word = false;
	for i in v.s.len {
		if v.s[i] != ' ' {
			if !in_word {
				words++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	gold_cache_put(g, cs, words);
	gold_push(g, words);
	g.steps += v.s.len + 1;
	out.i = words;
	out.s.clear();
	format(out.s, "cached word count ", words);
	out
}
@end
