code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_prime = -1;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				last_prime = x;
			}
		}
	}
	if last_prime >= 0 && g.n < 512 {
		gold_push(g, last_prime);
	}
	g.steps += g.n;
	out.i = last_prime;
	out.s.clear();
	format(out.s, "repeated last prime: ", last_prime);
	out
}
@end
