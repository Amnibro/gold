fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted comparison sequence of ", g.n, " digits");
	out
}
@end
@entry 523d1c5422302ce2
kind: step
verb: search
noun: budget
modifier: while
context: compare
phrase: search budget while cumulative comparison sum stays under {budget}
phrase: evaluate budget while comparison total below {budget}
slot: budget int
test: list=10,20,30,40 budget=50
expect: => i=2 r=0.0 ok=true s="budget accommodated 2 comparison entries" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25,35 budget=30
expect: => i=2 r=0.0 ok=true s="budget accommodated 2 comparison entries" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var count = 0;
	while count < g.n && spent + g.res[count] <= b {
		spent += g.res[count];
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "budget accommodated ", count, " comparison entries");
	out
}
@end
