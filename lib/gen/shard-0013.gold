fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if !${f}(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped in place ", dropped);
	g.steps += g.n + 1;
	out
}
@end
