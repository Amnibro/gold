	if g.n < 4 {
		out.i = 0;
		out.s.clear();
		out.s.append("too short");
		g.steps++;
		return out;
	}
	let s1 = g.res[1] - g.res[0];
	let s2 = g.res[g.n - 1] - g.res[g.n - 2];
	let diff = s2 - s1;
	gold_push(g, diff);
	out.i = diff;
	out.s.clear();
	format(out.s, "nested step diff ", diff);
	g.steps += g.n + 1;
	out
}
@end
