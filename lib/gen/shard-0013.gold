kind: step
verb: reverse
noun: maximum
modifier: recursively
context: core
phrase: reverse maximum recursively around peak element in core
phrase: recursively invert elements around maximum item in core
test: list=1,5,2,4,3
expect: => i=1 r=0.0 ok=true s="reversed elements following peak index 1" errors=0 n=5 res=[1,5,3,4,2] cache=0 hits=0
test: list=10,2,3,4
expect: => i=0 r=0.0 ok=true s="reversed elements following peak index 0" errors=0 n=4 res=[10,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var left = max_idx + 1;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n - max_idx;
	out.i = max_idx;
	out.s.clear();
	format(out.s, "reversed elements following peak index ", max_idx);
	out
}
@end
