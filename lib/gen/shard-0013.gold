fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			if (g.res[i] % 2 + 2) % 2 == (g.res[i + 1] % 2 + 2) % 2 {
				alt = false;
				break;
			}
		}
	}
	out.ok = alt;
	out.i = if alt { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "nested series alternating: ", alt);
	out
}
