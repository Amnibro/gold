fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let st = ${step};
    var merged = 0;
    if st > 0 && g.n > st {
        for i in g.n - st {
            g.res[i] += g.res[i + st];
            merged++;
        }
    }
    g.steps += merged;
    out.i = merged;
    out.s.clear();
    format(out.s, "joined series step ", st, ": ", merged);
    out
}
