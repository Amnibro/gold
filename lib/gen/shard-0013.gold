	let ceil = ${ceiling};
	var modified = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
		}
		if count == 1 && g.res[i] > ceil {
			g.res[i] = ceil;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " unique head items");
