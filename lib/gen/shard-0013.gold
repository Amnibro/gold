fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[>..] = [];
	for c in out.s {
		let key = c as int;
		let val, ok = gold_cache_get(g, key);
		if !ok {
			gold_cache_put(g, key, 1);
			res.push(c);
		}
	}
	out.s.clear();
	out.s.append(res);
	out.i = out.s.len;
	out
}
@end
