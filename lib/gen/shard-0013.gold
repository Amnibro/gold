code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	var swaps = 0;
	var i = 0;
	while i + s < g.n {
		let a = g.res[i];
		let b = g.res[i + s];
		g.res[i] = b;
		g.res[i + s] = a;
		gold_cache_put(g, a, b);
		swaps++;
		i += (s + 1);
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped span pairs ", swaps);
	out
}
@end
