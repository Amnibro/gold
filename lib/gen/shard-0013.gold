code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded unique runs: ", sum);
	out
}
@end
