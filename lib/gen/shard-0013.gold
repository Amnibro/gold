@entry 5ab899e0a61ca986
kind: step
verb: scan
noun: gaps
modifier: pairwise
context: sort
phrase: scan pairwise gaps across sorted items
phrase: calculate pairwise differences across sorted sequence
test: list=9,1,4
expect: => i=5 r=0.0 ok=true s="max pairwise gap 5" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=10,2,5,7
expect: => i=3 r=0.0 ok=true s="max pairwise gap 3" errors=0 n=3 res=[3,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_gap = 0;
	if g.n > 1 {
		var kept = 0;
		for i in 0..(g.n - 1) {
			let gap = g.res[i + 1] - g.res[i];
			if gap > max_gap { max_gap = gap; }
			g.res[kept] = gap;
			kept++;
		}
		g.n = kept;
	}
	g.steps += g.n * g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max pairwise gap ", max_gap);
	out
}
@end
