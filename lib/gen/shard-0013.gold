		if ok {
			g.res[i] = val;
			hits++;
		} else {
			gold_cache_put(g, g.res[i], g.res[i] * 10);
		}
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "selected cache for each hits=", hits);
	out
}
