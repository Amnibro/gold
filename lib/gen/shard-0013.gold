@entry d03d2498573f11ea
kind: step
verb: split
noun: primes
modifier: nested
context: filter
phrase: filter split primes nested extraction
phrase: separate prime numbers into distinct list elements
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="retained 3 prime elements" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=8,9,10
expect: => i=0 r=0.0 ok=true s="retained 0 prime elements" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		if is_p && x > 2 {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " prime elements");
	out
}
@end
@entry 0a83dcf8bedd680a
kind: step
verb: apply
noun: average
modifier: nested
context: filter
phrase: filter apply average nested sequence
phrase: retain elements exceeding integer sequence average
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="kept 2 items above average 25" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="kept 0 items above average 5" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	if g.n > 0 {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		let avg = sum / g.n;
		for i in g.n {
			if g.res[i] > avg {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.steps += g.n + 1;
		g.n = kept;
		out.i = kept;
		out.s.clear();
		format(out.s, "kept ", kept, " items above average ", avg);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "kept 0 items above average 0");
	}
	out
}
@end
