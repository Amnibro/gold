fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_rot};
	var shifts = 0;
	while shifts < mr && g.n > 1 {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	g.steps += shifts;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated comparison elements up to ", shifts, " times");
	out
}
