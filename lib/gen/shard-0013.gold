expect: => i=3 r=0.0 ok=true s="kept 3 checkpoints" errors=0 n=3 res=[1,7,12] cache=0 hits=0
test: list=2,4,6 min_gap=3
expect: => i=2 r=0.0 ok=true s="kept 2 checkpoints" errors=0 n=2 res=[2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	if g.n > 0 {
		g.res[0] = g.res[0];
		var last_val = g.res[0];
		kept = 1;
		for i in 1..g.n {
			if g.res[i] - last_val >= gap {
				g.res[kept] = g.res[i];
				last_val = g.res[i];
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " checkpoints");
	out
}
@end
