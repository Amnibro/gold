fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique elements count ", kept);
	out
}
@end
