fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var total = 0;
	for i in g.n {
		let bonus = (i + 1) * d;
		g.res[i] += bonus;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scanned nested counter at depth ", d);
	out
}
