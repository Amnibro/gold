code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mv {
			var is_p = x >= 2;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				gold_cache_put(g, x, 1);
				cached++;
			}
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached primes at least min: ", cached);
	out
}
@end
