fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var longest = 0;
	var curr = 0;
	for i in g.n {
		if i == 0 || g.res[i] >= g.res[i - 1] {
			curr++;
		} else {
			if curr > longest {
				longest = curr;
			}
			curr = 1;
		}
	}
	if curr > longest {
		longest = curr;
	}
	g.steps += g.n;
	out.ok = longest >= th;
	out.i = longest;
	out.s.clear();
	format(out.s, "longest increasing retry sequence length is ", longest);
