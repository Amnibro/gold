phrase: remove duplicate tail elements until reaching {cap}
slot: cap int
test: list=1,2,2,3,4 cap=2
expect: => i=4 r=0.0 ok=true s="deduped tail until limit count=4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
