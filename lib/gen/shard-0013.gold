fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes.push(x); }
		}
	}
	var write_idx = 0;
	var i = 0;
	while i + 1 < primes.len {
		g.res[write_idx] = primes[i] + primes[i + 1];
		write_idx++;
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "paired prime values recursively count ", write_idx);
	out
}
@end
