test: list=5,2,9,3
expect: => i=9 r=0.0 ok=true s="maximum rotated to front" errors=0 n=4 res=[9,2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var idx = g.n - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	if g.n > 0 { out.i = g.res[0]; }
	gold_text(out, "maximum rotated to front");
	out
}
@end
