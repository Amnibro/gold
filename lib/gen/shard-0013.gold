@entry 21e31f234e73e277
kind: fn
verb: find
noun: gaps
modifier: in_place
context: error
phrase: find error gaps in place
phrase: locate maximum error gap in place
test: arg=192,123
expect: 8
expect: 1
test: arg=505,77
expect: 5
expect: 0
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 10 {
		return 0;
	}
	var prev = val % 10;
	val = val / 10;
	var max_gap = 0;
	while val > 0 {
		var cur = val % 10;
		var gap = cur - prev;
		if gap < 0 {
			gap = -gap;
		}
		if gap > max_gap {
			max_gap = gap;
		}
		prev = cur;
		val = val / 10;
	}
	return max_gap;
}
@end
