fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_limit};
	var neg_count = 0;
	for i in g.n {
		if g.res[i] < 0 {
			neg_count++;
		}
	}
	if neg_count > ml {
		neg_count = ml;
	}
	gold_push(g, neg_count);
	g.steps += g.n + 1;
	out.i = neg_count;
	out.s.clear();
	format(out.s, "grouped ", neg_count, " errors up to limit");
	out
}
@end
@entry a63fa10ed0a9d420
kind: step
verb: split
noun: function
modifier: times
context: transform
slot: f fn
slot: repeat_count int
phrase: transform split function {f} repeatedly {repeat_count} times
phrase: execute function {f} successive times {repeat_count} on results
test: list=3 f=double repeat_count=2
expect: => i=12 r=0.0 ok=true s="applied function 2 times" errors=0 n=1 res=[12] cache=0 hits=0
test: list=4 f=inc repeat_count=3
expect: => i=7 r=0.0 ok=true s="applied function 3 times" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${repeat_count};
	var last_val = 0;
	for i in g.n {
		var x = g.res[i];
		for _ in reps {
			x = ${f}(x);
		}
		g.res[i] = x;
		last_val = x;
	}
	g.steps += g.n * reps + 1;
	out.i = last_val;
	out.s.clear();
	format(out.s, "applied function ", reps, " times");
	out
}
@end
@entry 007a698592f3aaf0
kind: step
verb: fill
noun: results
modifier: unique
context: transform
phrase: transform fill results unique distinct elements
phrase: filter results preserving only unique values
test: list=4,7,4,9,7
expect: => i=3 r=0.0 ok=true s="preserved 3 distinct results" errors=0 n=3 res=[4,7,9] cache=0 hits=0
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="preserved 3 distinct results" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in kept {
			if g.res[j] == x {
				found = true;
				break;
			}
		}
		if !found {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "preserved ", kept, " distinct results");
	out
}
@end
