@entry 0c75db2c490ef9e8
kind: step
verb: sum
noun: primes
modifier: each
context: format
phrase: format sum primes each prime total
phrase: render prime elements accumulation result
test: list=2,3,4,5
expect: => i=10 r=0.0 ok=true s="prime sum: 10" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="prime sum: 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		if is_p && x > 2 {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p { s += x; }
	}
	out.s.clear();
	format(out.s, "prime sum: ", s);
	g.steps += g.n + 1;
	out.i = s;
	out
}
@end
@entry 26b1a701ec580aaa
kind: step
