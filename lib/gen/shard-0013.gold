code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] > 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		for i in g.n {
			g.res[i] = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		}
		kept = g.n;
	} else {
		g.n = kept;
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered positive count=", kept);
	out
}
@end
@entry ba2a105ff513ad70
kind: step
verb: swap
noun: squares
modifier: safely
context: filter
phrase: swap square values safely in results
phrase: reorder square numbers safely in sequence
test: list=4,3,9,2
expect: => i=1 r=0.0 ok=true s="swapped squares safely=true" errors=0 n=4 res=[9,3,4,2] cache=0 hits=0
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="swapped squares safely=true" errors=0 n=4 res=[4,2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_idx0 = -1;
	var sq_idx1 = -1;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			if sq_idx0 < 0 { sq_idx0 = i; }
			else if sq_idx1 < 0 { sq_idx1 = i; break; }
		}
	}
	var swapped = false;
	if sq_idx0 >= 0 && sq_idx1 >= 0 {
		let tmp = g.res[sq_idx0];
		g.res[sq_idx0] = g.res[sq_idx1];
		g.res[sq_idx1] = tmp;
		swapped = true;
	}
	g.steps += g.n;
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "swapped squares safely=", swapped);
	out
}
@end
