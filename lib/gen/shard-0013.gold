phrase: safely log retry range span up to {max_len}
slot: max_len int
test: list=5,12,3,19 max_len=3
expect: => i=9 r=0.0 ok=true s="safely traced range span is 9" errors=0 n=4 res=[5,12,3,19] cache=0 hits=0
test: list=8,2,14,6 max_len=4
expect: => i=12 r=0.0 ok=true s="safely traced range span is 12" errors=0 n=4 res=[8,2,14,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	if g.n == 0 || ml <= 0 {
		out.i = 0;
		return out;
	}
	var count = ml;
	if count > g.n {
		count = g.n;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in count {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	let span = max_val - min_val;
	g.steps += count;
	out.i = span;
	out.s.clear();
	format(out.s, "safely traced range span is ", span);
	out
}
@end
