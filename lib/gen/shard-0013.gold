expect: => i=0 r=0.0 ok=true s="consecutive runs count=0" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var runs_count = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i-1] {
			cur_len++;
		} else {
			if cur_len <= ml { runs_count++; }
			cur_len = 1;
		}
	}
	if g.n > 0 && cur_len <= ml { runs_count++; }
	g.steps += g.n;
	out.i = runs_count;
	out.s.clear();
	format(out.s, "consecutive runs count=", runs_count);
	out
}
@end
