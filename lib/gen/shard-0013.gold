test: list=2,3,5,8,7
expect: => i=3 r=0.0 ok=true s="kept leading primes count=3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="kept leading primes count=0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept leading primes count=", kept);
	out
}
@end
@entry 381a31c15012a5a1
kind: step
verb: reverse
noun: squares
modifier: any
context: filter
phrase: reverse elements meeting any square condition
phrase: invert results if any perfect squares found
test: list=3,9,5
expect: => i=1 r=0.0 ok=true s="reversed any squares=true" errors=0 n=3 res=[5,9,3] cache=0 hits=0
test: list=2,3,5
expect: => i=0 r=0.0 ok=false s="reversed any squares=false" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_square = false;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { has_square = true; break; }
				r++;
			}
		}
		if has_square { break; }
	}
	if has_square {
		for i in (g.n / 2) {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	g.steps += g.n;
	out.ok = has_square;
	out.i = if has_square { 1 } else { 0 };
	out.s.clear();
	format(out.s, "reversed any squares=", has_square);
	out
}
@end
