@entry aa1b5f21a520913b
kind: step
verb: merge
noun: streak
modifier: nested
context: aggregate
phrase: merge streak nested runs of consecutive values in aggregate
phrase: combine nested streaks of identical items in aggregate
test: list=2,2,3,4,4,4
expect: => i=3 r=0.0 ok=true s="merged nested streaks into items count 3" errors=0 n=3 res=[4,3,12] cache=0 hits=0
test: list=1,1,1,2,2
expect: => i=2 r=0.0 ok=true s="merged nested streaks into items count 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var write_idx = 0;
	var cur_val = g.res[0];
	var count = 1;
	for i in 1..g.n {
		let x = g.res[i];
		if x == cur_val {
			count++;
		} else {
			g.res[write_idx] = cur_val * count;
			write_idx++;
			cur_val = x;
			count = 1;
		}
	}
	g.res[write_idx] = cur_val * count;
	write_idx++;
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged nested streaks into items count ", write_idx);
	out
}
@end
