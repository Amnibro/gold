phrase: filter fold odds each multiplying by {factor}
phrase: multiply odd elements in sequence by factor {factor}
test: list=1,2,3,4 factor=3
expect: => i=12 r=0.0 ok=true s="folded odd product 12" errors=0 n=2 res=[3,9] cache=0 hits=0
