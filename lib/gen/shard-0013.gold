code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[32] = [0; 32];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var seen = false;
			for j in count {
				if evens[j] == x { seen = true; break; }
			}
			if !seen && count < 32 {
				evens[count] = x;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured unique evens count=", count);
	out
}
@end
