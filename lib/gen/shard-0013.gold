phrase: pair consecutive elements in series until sum reaches {limit}
slot: limit int
test: list=1,2,3,4,5,6 limit=15
expect: => i=10 r=0.0 ok=true s="paired series until limit reached sum 10" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=10,20,30,40 limit=50
expect: => i=30 r=0.0 ok=true s="paired series until limit reached sum 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var write_idx = 0;
	var running_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let p = g.res[i] + g.res[i + 1];
		if running_sum + p > lim { break; }
		running_sum += p;
		g.res[write_idx] = p;
		write_idx++;
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = running_sum;
	out.s.clear();
	format(out.s, "paired series until limit reached sum ", running_sum);
	out
}
@end
