code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x {
				r++;
			}
			if r * r == x {
				found = true;
				break;
			}
		}
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "has square: ", found);
	out
}
@end
