@entry 311ac54c670d70c4
kind: step
verb: check
noun: digits
modifier: up_to
context: transform
phrase: check digit count up to bound {max_digits}
phrase: verify elements have digits up to bound {max_digits}
slot: max_digits int
test: list=5,25,100 max_digits=3
expect: => i=1 r=0.0 ok=true s="digits up to limit=true" errors=0 n=3 res=[5,25,100] cache=0 hits=0
test: list=50,2500 max_digits=2
expect: => i=0 r=0.0 ok=false s="digits up to limit=false" errors=0 n=2 res=[50,2500] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var all_ok = true;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d > md { all_ok = false; break; }
	}
	g.steps += g.n;
	out.ok = all_ok;
	out.i = if all_ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "digits up to limit=", all_ok);
	out
}
@end
