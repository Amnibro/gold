noun: memo
modifier: while
context: list
slot: p pred
phrase: rotate list elements while predicate {p} holds
phrase: cycle sequence items while condition {p} met
test: list=2,4,5,6 p=is_even
expect: => i=2 r=0.0 ok=true s="rotated steps: 2" errors=0 n=4 res=[5,6,2,4] cache=0 hits=0
test: list=1,2,4 p=is_even
expect: => i=0 r=0.0 ok=true s="rotated steps: 0" errors=0 n=3 res=[1,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var steps = 0;
	if g.n > 0 {
		while steps < g.n && ${p}(g.res[0]) {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
			steps++;
		}
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "rotated steps: ", steps);
	out
}
@end
