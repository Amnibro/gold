noun: primes
modifier: every_other
context: retry
phrase: keep every other prime number with retry
phrase: retain alternate prime values retrying check
test: list=2,3,5,7,11,13
expect: => i=3 r=0.0 ok=true s="kept alternate primes count 3" errors=0 n=3 res=[2,5,11] cache=0 hits=0
test: list=4,6,7,9,11
expect: => i=1 r=0.0 ok=true s="kept alternate primes count 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes_cnt = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_prime(x) {
			if primes_cnt % 2 == 0 {
				g.res[kept] = x;
				kept++;
			}
			primes_cnt++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept alternate primes count ", kept);
	out
}
@end
@entry 4ed175375b7fc866
kind: step
verb: swap
noun: limit
modifier: sorted
context: retry
phrase: swap items towards sorted order retrying {limit} times
phrase: reorder elements towards sorted state with retry {limit}
slot: limit int
test: list=4,2,3,1 limit=2
expect: => i=2 r=0.0 ok=true s="completed swaps 2" errors=0 n=4 res=[1,4,3,2] cache=0 hits=0
test: list=5,1,2 limit=1
expect: => i=1 r=0.0 ok=true s="completed swaps 1" errors=0 n=3 res=[1,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${limit};
	var swaps = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] && swaps < max_swaps {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "completed swaps ", swaps);
	out
}
@end
