code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	var count = 0;
	for i in g.n {
		if g.res[i] <= ceiling { count++; }
	}
	gold_push(g, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted all elements respecting limit count ", count);
	out
}
@end
@entry 2c8b99f43b18e9ac
kind: step
verb: select
noun: maximum
modifier: sorted
context: aggregate
phrase: select maximum sorted taking top {k} elements in aggregate
phrase: extract largest {k} items in sorted aggregate order
slot: k int
test: list=10,50,20,40,30 k=3
expect: => i=3 r=0.0 ok=true s="selected top sorted maximum items count 3" errors=0 n=3 res=[50,40,30] cache=0 hits=0
test: list=5,1,9 k=2
expect: => i=2 r=0.0 ok=true s="selected top sorted maximum items count 2" errors=0 n=2 res=[9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${k};
	for pass in g.n {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] < g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
	}
	var count = want;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected top sorted maximum items count ", count);
	out
}
@end
