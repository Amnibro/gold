fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_dist = 0;
	var tries = ${attempts};
	if tries < 1 { tries = 1; }
	for t in tries {
		total_dist = 0;
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			total_dist += if diff < 0 { -diff } else { diff };
		}
	}
	g.steps += g.n * tries;
	out.i = total_dist;
	out.s.clear();
	format(out.s, "measured pair distance ", total_dist);
	out
}
@end
@entry 75dd7781bea37591
kind: step
verb: scale
noun: subfunction
modifier: with_cache
context: retry
phrase: scale subfunction {sub} with cache retrying misses {factor}
phrase: apply subfunction {sub} scaling with cache {factor}
slot: sub fn
slot: factor int
test: list=2,4,6 sub=double factor=3
expect: => i=3 r=0.0 ok=true s="scaled items with cache retry 3" errors=0 n=3 res=[12,24,36] cache=3 hits=0
test: list=1,3 sub=square factor=2
expect: => i=2 r=0.0 ok=true s="scaled items with cache retry 2" errors=0 n=2 res=[2,18] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		var res_val = val;
		if !hit {
			res_val = ${sub}(x) * mult;
			gold_cache_put(g, x, res_val);
		}
		g.res[i] = res_val;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled items with cache retry ", g.n);
	out
}
@end
@entry 152146445af041a6
kind: step
verb: reverse
noun: results
modifier: at_least
context: retry
phrase: reverse results retrying when meeting at least {min_len}
phrase: invert output sequence requiring minimum length {min_len}
slot: min_len int
test: list=10,20,30,40 min_len=3
expect: => i=1 r=0.0 ok=true s="reversed results condition met 1" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
test: list=5,10 min_len=4
expect: => i=0 r=0.0 ok=true s="reversed results condition met 0" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	var reversed = false;
	if g.n >= req {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		reversed = true;
	}
	g.steps += g.n;
	out.i = if reversed { 1 } else { 0 };
	out.s.clear();
	format(out.s, "reversed results condition met ", out.i);
	out
}
@end
