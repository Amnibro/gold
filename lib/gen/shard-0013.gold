fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var idx = g.n - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated items in loop");
	out
}
@end
