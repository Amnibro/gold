code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${divisor};
	var valid_count = 0;
	var total_odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			total_odds++;
			if div > 0 && g.res[i] % div == 0 {
				valid_count++;
			}
		}
	}
	let all_valid = (valid_count == total_odds);
	if !all_valid {
		out.ok = false;
		gold_fail(g, "odd elements failed divisor check");
	}
	g.steps += total_odds + 1;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "validated ", valid_count, " of ", total_odds, " odd elements with divisor ", div);
	out
}
@end
