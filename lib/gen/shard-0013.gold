code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_space = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		total_space += abs_diff;
		gold_cache_put(g, i, abs_diff);
	}
	g.steps += g.n;
	out.i = total_space;
	out.s.clear();
	format(out.s, "total space measured ", total_space);
	out
}
@end
