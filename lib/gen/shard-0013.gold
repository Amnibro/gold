code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var vals int[>..] = [];
	var freqs int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in vals.len {
			if vals[j] == x { freqs[j] += 1; found = true; break; }
		}
		if !found { vals.push(x); freqs.push(1); }
	}
	for i in freqs.len {
		g.res[i] = freqs[i] * m;
	}
	g.n = freqs.len;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped histogram frequencies count ", g.n);
	out
}
@end
