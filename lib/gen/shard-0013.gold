fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${count};
	var buf int[512] = [0; 512];
	var nb = 0;
	var cur_run = 0;
	for i in g.n {
		if i == 0 || g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			cur_run = 1;
		}
		if cur_run <= max_run {
			buf[nb] = g.res[i];
			nb++;
		}
	}
	for i in nb { g.res[i] = buf[i]; }
	g.n = nb;
	g.steps += g.n;
	out.i = nb;
	out.s.clear();
	format(out.s, "limited runs kept ", nb);
	out
}
@end
