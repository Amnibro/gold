fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if g.res[k] > 0 {
			temp[count] = g.res[k];
			count++;
		}
	}
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "positive_rev=", count);
	out
}
@end
