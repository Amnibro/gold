test: list=1,1,1,2,2
expect: => i=3 r=0.0 ok=true s="deduped total: 3" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		return out;
	}
	var write = 1;
	var sum = g.res[0];
	for i in 1..g.n {
		if g.res[i] != g.res[write - 1] {
			g.res[write] = g.res[i];
			sum += g.res[write];
			write++;
		}
	}
	g.n = write;
	out.i = sum;
	out.s.clear();
	format(out.s, "deduped total: ", sum);
	out
}
@end
