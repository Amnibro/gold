code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var kept = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			let val = x * f;
			g.res[kept] = val;
			kept++;
			sum += val;
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded odd product ", sum);
	out
}
@end
