fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[..50] = [];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in uniq.len {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen { uniq.push(x); }
	}
	out.s.clear();
	format(out.s, "set: {");
	for i in uniq.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, uniq[i]);
	}
	format(out.s, "}");
	g.steps += g.n * g.n + 1;
	out.i = uniq.len;
	out
}
@end
