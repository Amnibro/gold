@entry bb77a200904aca76
kind: step
verb: dedupe
noun: streak
modifier: until
context: compare
phrase: dedupe comparison streak until removing at most {max_rem}
phrase: eliminate streak duplicates until limit {max_rem}
slot: max_rem int
test: list=1,1,2,2,3,3 max_rem=2
expect: => i=2 r=0.0 ok=true s="deduped streak until limit removed 2 duplicates" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=4,4,4,5,5 max_rem=1
expect: => i=1 r=0.0 ok=true s="deduped streak until limit removed 1 duplicates" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_rem};
	if g.n <= 1 || limit <= 0 {
		out.i = 0;
		return out;
	}
	var write_idx = 1;
	var removed = 0;
	var read_idx = 1;
	while read_idx < g.n {
		if g.res[read_idx] == g.res[write_idx - 1] && removed < limit {
			removed++;
		} else {
			g.res[write_idx] = g.res[read_idx];
			write_idx++;
		}
		read_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped streak until limit removed ", removed, " duplicates");
	out
}
@end
