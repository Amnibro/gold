@entry 0d8d61d0dc9b9b4e
kind: step
verb: reverse
noun: loop
modifier: between
context: cache
phrase: reverse loop elements between indices {start} to {finish}
phrase: invert looped sequence between positions {start} to {finish}
slot: start int
slot: finish int
test: list=10,20,30,40,50 start=1 finish=3
expect: => i=3 r=0.0 ok=true s="reversed slice 1 to 3" errors=0 n=5 res=[10,40,30,20,50] cache=2 hits=0
test: list=1,2,3,4,5 start=0 finish=2
expect: => i=3 r=0.0 ok=true s="reversed slice 0 to 2" errors=0 n=5 res=[3,2,1,4,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var f = ${finish};
	if s < 0 { s = 0; }
	if f >= g.n { f = g.n - 1; }
	var l = s;
	var r = f;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		gold_cache_put(g, l, g.res[l]);
		gold_cache_put(g, r, g.res[r]);
		l++;
		r--;
	}
	g.steps += (f - s + 1);
	out.i = f - s + 1;
	out.s.clear();
	format(out.s, "reversed slice ", s, " to ", f);
	out
}
@end
