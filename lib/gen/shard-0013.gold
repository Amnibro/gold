fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let mg = ${max_gap};
    var clamped = 0;
    if g.n > 1 {
        for i in 1..g.n {
            let space = g.res[i] - g.res[i - 1];
            if space > mg {
                g.res[i] = g.res[i - 1] + mg;
                clamped++;
            }
        }
    }
    gold_cache_put(g, mg, clamped);
    g.steps += g.n;
    out.i = clamped;
    out.s.clear();
    format(out.s, "clamped spaces with cache: ", clamped);
