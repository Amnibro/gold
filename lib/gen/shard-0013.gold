code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp byte[..200] = "";
	format(temp, "spaced: ");
	var last_was_space = false;
	var words = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if !last_was_space {
				temp.push(' ');
				last_was_space = true;
			}
		} else {
			if last_was_space || temp.len == 8 { words++; }
			temp.push(c);
			last_was_space = false;
		}
	}
	out.s.clear();
	out.s.append(temp);
	g.steps += v.s.len + 1;
	out.i = words;
	out
}
@end
