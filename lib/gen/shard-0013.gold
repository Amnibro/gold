code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] < 0 { gold_fail(g, "negative sort value"); out.ok = false; return out; }
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "values sorted with cache");
	out
}
@end
@entry 92b970dbe7a5282b
kind: step
verb: dedupe
noun: item
modifier: recursively
context: error
phrase: dedupe items recursively checking errors
phrase: remove duplicate elements recursively safely
test: list=5,3,5,2
expect: => i=3 r=0.0 ok=true s="items deduped recursively" errors=0 n=3 res=[5,3,2] cache=0 hits=0
test: list=5,-3,5,2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[5,-3,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] < 0 { gold_fail(g, "negative item for dedupe"); out.ok = false; return out; }
	}
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	gold_text(out, "items deduped recursively");
	out
}
@end
