code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_prime = false;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { has_prime = true; break; }
		}
	}
	if !has_prime && g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n;
	out.i = if has_prime { 0 } else { 1 };
	out.s.clear();
	format(out.s, "swapped none prime=", !has_prime);
	out
}
@end
