noun: gaps
modifier: until
context: compare
phrase: filter comparison gaps until limit {max_gap}
phrase: discard large comparison gaps until {max_gap}
slot: max_gap int
test: list=2,5,15,18 max_gap=4
expect: => i=3 r=0.0 ok=true s="retained 3 items within gap threshold" errors=0 n=3 res=[2,5,18] cache=0 hits=0
test: list=1,10,12,30 max_gap=5
expect: => i=2 r=0.0 ok=true s="retained 2 items within gap threshold" errors=0 n=2 res=[1,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var write_idx = 1;
	for i in g.n - 1 {
		var gap = g.res[i + 1] - g.res[i];
		if gap < 0 { gap = -gap; }
		if gap <= mg {
			g.res[write_idx] = g.res[i + 1];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "retained ", write_idx, " items within gap threshold");
	out
}
@end
