@entry ac578f184160db7d
kind: step
verb: measure
noun: average
modifier: sorted
context: core
phrase: measure average sorted across core results
phrase: compute average of sorted elements in core state
test: list=4,1,3,2
expect: => i=10 r=2.5 ok=true s="measured average of sorted elements" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,5
expect: => i=35 r=11.666666666666666 ok=true s="measured average of sorted elements" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.r = 0.0;
		return out;
	}
	for pass in g.n {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum as real / g.n as real;
	g.steps += g.n * g.n;
	out.i = sum;
	out.r = avg;
	out.s.clear();
	format(out.s, "measured average of sorted elements");
	out
}
@end
