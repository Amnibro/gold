phrase: reverse budget while sum remains within {budget} in math sequence
phrase: invert elements while accumulated budget stays under {budget} in math
slot: budget int
test: list=1,2,3,10,20 budget=7
expect: => i=3 r=0.0 ok=true s="reversed budget while under limit count 3" errors=0 n=5 res=[3,2,1,10,20] cache=0 hits=0
test: list=5,10,15,20 budget=20
expect: => i=2 r=0.0 ok=true s="reversed budget while under limit count 2" errors=0 n=4 res=[10,5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var run = 0;
	var count = 0;
	while count < g.n && run + g.res[count] <= b {
		run += g.res[count];
		count++;
	}
	var l = 0;
	var r = count - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed budget while under limit count ", count);
	out
}
@end
