fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${cap} < 0 { 0 } else { if ${cap} > g.n { g.n } else { ${cap} } };
	let start = g.n - limit;
	var count = 0;
	var i = start;
	while i < g.n {
		g.res[count] = g.res[i];
		count++;
		i++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "tail limited to ", count);
	g.steps += count + 1;
	out
}
@end
@entry 86a854ab67f4ff4e
kind: step
verb: normalize
noun: total
modifier: unique
context: stats
phrase: normalize total across unique observations
phrase: rescale total of unique data points
phrase: adjust total based on unique values
test: list=2,2,4,4,6,6
expect: => i=4 r=0.0 ok=true s="unique normalized total 4" errors=0 n=7 res=[2,2,4,4,6,6,4] cache=0 hits=0
test: list=10,20,20,30,40
expect: => i=25 r=0.0 ok=true s="unique normalized total 25" errors=0 n=6 res=[10,20,20,30,40,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_sum = 0;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { found = true; break; }
			j++;
		}
		if !found {
			unique_sum += g.res[i];
			unique_count++;
		}
		i++;
	}
	let scale = if unique_count == 0 { 1 } else { unique_count };
	let norm_total = unique_sum / scale;
	gold_push(g, norm_total);
	out.i = norm_total;
	out.s.clear();
	format(out.s, "unique normalized total ", norm_total);
	g.steps += g.n + 1;
	out
}
@end
