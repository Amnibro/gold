code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_gap = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d > max_gap {
				max_gap = d;
			}
		}
	}
	g.steps += g.n;
