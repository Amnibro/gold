fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let cut = ${cutoff};
    var sum = 0;
    var count = 0;
    for i in g.n {
        if g.res[i] >= cut {
            break;
        }
        sum += g.res[i];
        count++;
    }
    var avg = 0;
    if count > 0 {
        avg = sum / count;
    }
    g.steps += count;
    out.i = avg;
    out.s.clear();
    format(out.s, "scan average before cutoff ", cut, " is ", avg);
    gold_push(g, avg);
    out
}
@end
