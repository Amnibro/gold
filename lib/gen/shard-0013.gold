fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[..50] = [];
	if g.n > 1 {
		for i in 1..g.n {
			let gap = g.res[i] - g.res[i - 1];
			var seen = false;
			for j in uniq.len {
				if uniq[j] == gap { seen = true; break; }
			}
			if !seen { uniq.push(gap); }
		}
	}
	out.s.clear();
	format(out.s, "unique gaps: [");
	for i in uniq.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, uniq[i]);
	}
	format(out.s, "]");
	g.steps += g.n * g.n + 1;
	out.i = uniq.len;
	out
}
