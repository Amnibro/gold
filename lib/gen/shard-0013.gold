code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${cache_slot};
	var letters = 0;
	for i in v.s.len {
		let c = v.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			letters++;
		}
	}
	gold_cache_put(g, cs, letters);
	gold_push(g, letters);
	g.steps += v.s.len + 1;
	out.i = letters;
	out.s.clear();
	format(out.s, "cached letter count ", letters);
	out
}
@end
