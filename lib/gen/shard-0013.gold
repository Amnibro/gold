expect: => i=1 r=0.0 ok=true s="errors=1" errors=0 n=4 res=[1,10,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var matches = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff >= lo && diff <= hi { matches++; }
		i++;
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "errors=", matches);
	out
}
@end
