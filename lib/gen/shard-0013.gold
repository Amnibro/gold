expect: => i=2 r=0.0 ok=true s="paired unique sequence elements count 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for u in unique {
			if u == x { exists = true; break; }
		}
		if !exists { unique.push(x); }
	}
	var write_idx = 0;
	var i = 0;
	while i + 1 < unique.len {
		g.res[write_idx] = unique[i] + unique[i + 1];
		write_idx++;
		i += 2;
	}
	g.n = write_idx;
	g.steps += write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "paired unique sequence elements count ", write_idx);
	out
}
@end
