expect: => i=2 r=0.0 ok=true s="scaled 2 tail items" errors=0 n=3 res=[7,6,12] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = g.n;
	var scaled = 0;
	while i > 0 {
		let idx = i - 1;
		let val = g.res[idx];
		if !${p}(val) {
			break;
		}
		let new_val = val * ${factor};
		g.res[idx] = new_val;
		gold_cache_put(g, val, new_val);
		scaled++;
		i--;
	}
	g.steps += scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " tail items");
	out
}
@end
