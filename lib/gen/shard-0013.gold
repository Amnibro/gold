fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let piv = ${pivot};
    var below int[512] = [0; 512];
    var above int[512] = [0; 512];
    var nb = 0;
    var na = 0;
    for i in g.n {
        let x = g.res[i];
        if x <= piv {
            below[nb] = x;
            nb++;
        } else {
            above[na] = x;
            na++;
        }
    }
    gold_cache_put(g, piv, nb);
    for i in nb { g.res[i] = below[i]; }
    for i in na { g.res[nb + i] = above[i]; }
    g.steps += g.n;
    out.i = nb;
    out.s.clear();
    format(out.s, "split around pivot ", piv, ": below count ", nb);
    out
}
@end
