modifier: with_cache
context: math
slot: k int
phrase: search suffix total for {k} items using cache
phrase: compute suffix sum of {k} elements with cache
test: list=10,20,30,40 k=2
expect: => i=70 r=0.0 ok=true s="suffix sum with cache: 70" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
test: list=5,15,25 k=1
expect: => i=25 r=0.0 ok=true s="suffix sum with cache: 25" errors=0 n=3 res=[5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${k};
	let cached_val, ok = gold_cache_get(g, cnt);
	if ok {
		out.i = cached_val;
	} else {
		var sum = 0;
		let bound = if cnt < g.n { cnt } else { g.n };
		var idx = g.n - 1;
		for i in bound {
			sum += g.res[idx];
			idx--;
		}
		gold_cache_put(g, cnt, sum);
		out.i = sum;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "suffix sum with cache: ", out.i);
	out
}
@end
