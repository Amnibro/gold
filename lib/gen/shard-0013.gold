fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	if g.n > 0 {
		var cur = g.res[0];
		while count < lim {
			cur = ${f}(cur);
			count++;
		}
		g.res[0] = cur;
		out.i = cur;
	} else {
		out.i = 0;
	}
	g.steps += count;
	out.s.clear();
	format(out.s, "repeated subfunction: ", count);
	out
}
@end
@entry 07b27b988a7b6411
kind: step
verb: clamp
noun: step
modifier: all
context: list
slot: bound int
phrase: clamp step increments across all list items to {bound}
phrase: restrict consecutive steps for all items by {bound}
test: list=10,30,50 bound=5
expect: => i=3 r=0.0 ok=true s="clamped step increments: 3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,10,100 bound=10
expect: => i=3 r=0.0 ok=true s="clamped step increments: 3" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			if diff > b {
				g.res[i + 1] = g.res[i] + b;
			} else if diff < -b {
				g.res[i + 1] = g.res[i] - b;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped step increments: ", g.n);
	out
}
@end
@entry e071563258db7ca7
kind: step
verb: sort
noun: budget
modifier: in_place
context: list
slot: budget int
phrase: sort prefix list within budget {budget} in place
phrase: order items consuming budget {budget} in place
test: list=30,10,20,50 budget=65
expect: => i=3 r=0.0 ok=true s="sorted within budget: 3" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=8,2,15 budget=12
expect: => i=2 r=0.0 ok=true s="sorted within budget: 2" errors=0 n=3 res=[2,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var count = 0;
	while count < g.n && sum + g.res[count] <= b {
		sum += g.res[count];
		count++;
	}
	for i in count {
		for j in i + 1..count {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted within budget: ", count);
	out
}
@end
