fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_bound};
	var count = 0;
	var x = 2;
	while x <= mb && count < 512 {
		if core_is_prime(x) {
			g.res[count] = x;
			count++;
		}
		x++;
	}
	g.steps += mb + 1;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "generated ", count, " primes");
	out
}
@end
