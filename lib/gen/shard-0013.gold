@entry 45da6389d11991af
kind: step
verb: rank
noun: range
modifier: with_cache
context: core
phrase: rank range elements using cache limit {cap}
phrase: score range elements with cache bound {cap}
slot: cap int
test: list=2,3,2 cap=5
expect: => i=3 r=0.0 ok=true s="ranked range elements: 3" errors=0 n=3 res=[10,15,10] cache=2 hits=1
test: list=10,20 cap=2
expect: => i=2 r=0.0 ok=true s="ranked range elements: 2" errors=0 n=2 res=[20,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var ranked = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let val = x * limit;
			gold_cache_put(g, x, val);
			g.res[i] = val;
		}
		ranked++;
	}
	out.i = ranked;
	out.s.clear();
	format(out.s, "ranked range elements: ", ranked);
	out
}
@end
