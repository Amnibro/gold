code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let ceil = ${ceiling};
    let fac = ${factor};
    var scaled = 0;
    if g.n > 1 {
        for i in 1..g.n {
            if g.res[i] >= ceil {
                break;
            }
            if g.res[i] == g.res[i - 1] {
                g.res[i] = g.res[i] * fac;
                scaled++;
            }
        }
    }
    g.steps += g.n;
    out.i = scaled;
    out.s.clear();
    format(out.s, "scaled duplicates before ", ceil, ": count ", scaled);
    out
}
@end
