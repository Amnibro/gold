		out.s.clear();
		format(out.s, sp[1], " ", sp[0]);
		for i in 2..sp.len {
			format(out.s, " ", sp[i]);
		}
	}
	g.steps += 2;
	out.i = sp.len;
	out
}
@end
@entry 1bcbd9b7474793cb
kind: step
verb: scan
noun: value
modifier: any
context: math
phrase: scan value any matching target {target} in mathematical sequence
phrase: traverse mathematical sequence seeking any occurrence of value {target}
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="scanned any value matching index 2" errors=0 n=5 res=[10,20,30,40,2] cache=0 hits=0
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=true s="scanned any value matching index -1" errors=0 n=4 res=[5,15,25,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == tgt { found_idx = i; break; }
	}
	gold_push(g, found_idx);
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "scanned any value matching index ", found_idx);
	out
}
@end
