fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			let a = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
			let b = if g.res[j] < 0 { -g.res[j] } else { g.res[j] };
			if a > b {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted by absolute magnitude: ", g.n);
	out
}
@end
