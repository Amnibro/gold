fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var temp int[512] = [0; 512];
	var tn = 0;
	if g.n > 0 {
		var streak = 0;
		while streak < g.n && g.res[streak] == g.res[0] {
			streak++;
		}
		for i in streak {
			temp[tn] = g.res[0];
			tn++;
		}
		let extra = if streak < ml { streak } else { ml };
		for k in extra {
			if tn < 512 {
				temp[tn] = g.res[0];
				tn++;
			}
		}
		for i in streak..g.n {
			if tn < 512 {
				temp[tn] = g.res[i];
				tn++;
			}
		}
	}
	for i in tn {
		g.res[i] = temp[i];
	}
	g.n = tn;
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "repeated streak: ", tn);
	out
}
@end
