code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dc = ${drop_count};
	if g.n <= dc {
		g.n = 0;
		gold_fail(g, "dropped all tail elements");
		out.ok = false;
		out.i = 0;
	} else {
		g.n -= dc;
		out.i = g.n;
	}
	g.steps += dc + 1;
	out.s.clear();
	format(out.s, "dropped tail with ", out.i, " remaining");
	out
}
@end
