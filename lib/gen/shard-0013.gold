fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inc_pairs = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			var f1 = 0;
			var f2 = 0;
			for j in g.n {
				if g.res[j] == g.res[i] {
					f1++;
				}
				if g.res[j] == g.res[i + 1] {
					f2++;
				}
			}
			if f1 < f2 {
				inc_pairs++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = inc_pairs;
	out.s.clear();
	format(out.s, "histogram pairwise rank: ", inc_pairs);
	out
}
@end
