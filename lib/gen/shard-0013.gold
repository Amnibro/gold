	var out = v;
	let lim = ${limit};
	let f = ${factor};
	let count = if lim < g.n { lim } else { g.n };
	for i in count {
		g.res[i] *= f;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled list items count=", count);
