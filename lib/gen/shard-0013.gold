	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	let ok = span <= lim;
	g.steps += g.n;
	out.ok = ok;
	out.i = span;
	out.s.clear();
	format(out.s, "range span=", span, " limit=", lim, " ok=", ok);
	out
}
@end
