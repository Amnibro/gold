fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var total = 0;
	var i = 0;
	while i < g.n && g.res[i] <= b {
		total += g.res[i];
		i++;
	}
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "measured prefix head until bound sum ", total);
