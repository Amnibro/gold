phrase: remove duplicate memo entries up to count {cap}
slot: cap int
test: list=1,2,2,3,1,4 cap=3
expect: => i=3 r=0.0 ok=true s="deduped memo items up to limit remaining=3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,6,7 cap=2
expect: => i=2 r=0.0 ok=true s="deduped memo items up to limit remaining=2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write = 0;
	for i in g.n {
		if write >= limit {
			break;
		}
		let x = g.res[i];
		var dup = false;
		for j in write {
			if g.res[j] == x {
				dup = true;
				break;
			}
		}
		if !dup {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped memo items up to limit remaining=", write);
	out
}
@end
