code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let item = g.res[i];
		let val, hit = gold_cache_get(g, item);
		if hit {
			g.res[kept] = item;
			kept++;
		} else {
			gold_cache_put(g, item, item * 2);
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " memoized items");
	out
}
@end
@entry afa9a876273dcf93
kind: step
verb: scale
noun: checkpoint
modifier: every_other
context: cache
phrase: scale alternate cached checkpoint values by {factor}
phrase: multiply every other cache checkpoint by {factor}
slot: factor int
test: list=10,20,30 factor=2
expect: => i=2 r=0.0 ok=true s="scaled 2 checkpoints" errors=0 n=3 res=[20,20,60] cache=3 hits=0
test: list=5,15,25,35 factor=3
expect: => i=2 r=0.0 ok=true s="scaled 2 checkpoints" errors=0 n=4 res=[15,15,75,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var scaled = 0;
	var i = 0;
	while i < g.n {
		let new_val = g.res[i] * mult;
		g.res[i] = new_val;
		gold_cache_put(g, i, new_val);
		scaled++;
		i += 2;
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " checkpoints");
	out
}
@end
@entry bf0049626a436c1d
kind: step
verb: select
noun: history
modifier: up_to
context: cache
phrase: select cached history entries up to limit {limit}
phrase: gather stored cache history up to bound {limit}
slot: limit int
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="selected 2 history items" errors=0 n=2 res=[10,20] cache=4 hits=0
test: list=5,15,25 limit=1
