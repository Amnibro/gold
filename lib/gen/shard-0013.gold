code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rounds = ${max_rounds};
	var total_swaps = 0;
	for r in rounds {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				total_swaps++;
				swapped = true;
			}
			i++;
		}
		if !swapped { break; }
	}
	g.steps += g.n;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "swapped history with retry passes total ", total_swaps);
	out
}
@end
