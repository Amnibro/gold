@entry f9b44b2b2faa258f
kind: step
verb: split
noun: loop
modifier: nested
context: math
phrase: split loop with nested partition
phrase: divide looping elements into nested groups
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="evens 3 odds 3" errors=0 n=6 res=[2,4,6,1,3,5] cache=0 hits=0
test: list=10,15,20,25
expect: => i=2 r=0.0 ok=true s="evens 2 odds 2" errors=0 n=4 res=[10,20,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ne = 0;
	var no = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[ne] = g.res[i];
			ne++;
		} else {
			odds[no] = g.res[i];
			no++;
		}
	}
	for i in ne { g.res[i] = evens[i]; }
	for i in no { g.res[ne + i] = odds[i]; }
	g.steps += g.n;
	out.i = ne;
	out.s.clear();
	format(out.s, "evens ", ne, " odds ", no);
	out
}
@end
@entry 463d45ddb6ad63ad
kind: step
verb: normalize
noun: tail
modifier: unique
context: math
phrase: normalize tail preserving unique values
phrase: deduplicate tail items into unique set
test: list=1,2,3,3,4,4
expect: => i=4 r=0.0 ok=true s="unique normalized count: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,20,30
expect: => i=3 r=0.0 ok=true s="unique normalized count: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf int[512] = [0; 512];
	var nb = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in nb {
			if buf[j] == x { seen = true; break; }
		}
		if !seen {
			buf[nb] = x;
			nb++;
		}
	}
	for i in nb { g.res[i] = buf[i]; }
	g.n = nb;
	g.steps += g.n;
	out.i = nb;
	out.s.clear();
	format(out.s, "unique normalized count: ", nb);
	out
}
@end
