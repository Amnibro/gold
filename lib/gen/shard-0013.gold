code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot average empty list");
		out.ok = false;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let avg = total / g.n;
	let scaled = avg * ${factor};
	g.steps += g.n * g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled average is ", scaled);
	out
}
@end
