code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	var write = 0;
	for i in g.n {
		var ok_sort = true;
		var start = 0;
		if i >= w {
			start = i - w + 1;
		}
		for j in start..i {
			if g.res[j] > g.res[i] {
				ok_sort = false;
				break;
			}
		}
		if ok_sort {
			g.res[write] = g.res[i];
			write++;
		}
	}
	g.n = write;
	g.steps += write + 1;
	out.i = write;
	out.s.clear();
	format(out.s, "filtered window sorted items remaining=", write);
	out
}
@end
