@entry d1ed8b8731511dce
kind: step
verb: return
noun: histogram
modifier: all
context: transform
phrase: return full histogram frequency distribution
phrase: yield complete histogram counts for elements
test: list=5,5,8,8,8,12
expect: => i=3 r=0.0 ok=true s="returned histogram of 3 unique frequencies" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=1,2,2,3,3,3,4
expect: => i=4 r=0.0 ok=true s="returned histogram of 4 unique frequencies" errors=0 n=4 res=[1,2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[>..] = [];
	var vals int[>..] = [];
	for i in g.n {
		let v_curr = g.res[i];
		var idx = -1;
		for j in vals.len {
			if vals[j] == v_curr {
				idx = j;
			}
		}
		if idx >= 0 {
			counts[idx] += 1;
		} else {
			vals.push(v_curr);
			counts.push(1);
		}
	}
	g.n = 0;
	for c in counts {
		gold_push(g, c);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned histogram of ", g.n, " unique frequencies");
	out
}
@end
