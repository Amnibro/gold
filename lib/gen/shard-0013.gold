phrase: accumulate at most {bound} prime numbers in math sequence
slot: bound int
test: list=2,3,4,5,6,7 bound=2
expect: => i=5 r=0.0 ok=true s="scanned primes at most sum 5" errors=0 n=7 res=[2,3,4,5,6,7,5] cache=0 hits=0
test: list=11,13,15,17 bound=3
expect: => i=41 r=0.0 ok=true s="scanned primes at most sum 41" errors=0 n=5 res=[11,13,15,17,41] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var primes_found = 0;
	var prime_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			prime_sum += x;
			primes_found++;
			if primes_found >= b { break; }
		}
	}
	gold_push(g, prime_sum);
	g.steps += g.n;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "scanned primes at most sum ", prime_sum);
	out
}
@end
