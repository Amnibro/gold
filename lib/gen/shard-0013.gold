@entry b94b21afecd705fc
kind: step
verb: drop
noun: words
modifier: nested
context: transform
phrase: transform drop words nested duplicate characters
phrase: prune words containing adjacent repeated characters
test: text="cool cat speed dog"
expect: => i=2 r=0.0 ok=true s="dropped 2 nested character words" errors=0 n=0 res=[] cache=0 hits=0
test: text="simple test"
expect: => i=0 r=0.0 ok=true s="dropped 0 nested character words" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var i = 0;
	while i < v.s.len {
		while i < v.s.len && v.s[i] == ' ' { i++; }
		let start = i;
		var has_dup = false;
		while i < v.s.len && v.s[i] != ' ' {
			if i + 1 < v.s.len && v.s[i] == v.s[i + 1] {
				has_dup = true;
			}
			i++;
		}
		if start < i && has_dup {
			dropped++;
		}
	}
	g.steps += v.s.len + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " nested character words");
	out
}
@end
@entry 883bde9b74e292d8
kind: step
verb: split
noun: results
modifier: safely
context: transform
slot: max_part int
phrase: transform split results safely limit {max_part}
phrase: partition result elements exceeding {max_part}
test: list=10,25 max_part=15
expect: => i=1 r=0.0 ok=true s="safely split 1 elements" errors=0 n=3 res=[10,15,10] cache=0 hits=0
test: list=5,8 max_part=15
expect: => i=0 r=0.0 ok=true s="safely split 0 elements" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_part};
	var new_res: int[512] = [0; 512];
	var m = 0;
	var split_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x > mp && m + 1 < 512 {
			new_res[m] = mp;
			m++;
			new_res[m] = x - mp;
			m++;
			split_count++;
		} else if m < 512 {
			new_res[m] = x;
			m++;
		}
	}
	for i in m {
		g.res[i] = new_res[i];
	}
	g.steps += g.n + m + 1;
	g.n = m;
	out.i = split_count;
	out.s.clear();
	format(out.s, "safely split ", split_count, " elements");
	out
}
@end
@entry e40bbc3625b491a7
kind: step
verb: compare
noun: digits
modifier: between
context: transform
slot: min_d int
slot: max_d int
phrase: transform compare digits between bounds {min_d} to {max_d}
phrase: count digits between range {min_d} through {max_d}
test: list=125,38 min_d=2 max_d=4
expect: => i=2 r=0.0 ok=true s="found 2 digits in range" errors=0 n=3 res=[125,38,2] cache=0 hits=0
test: list=78,99 min_d=1 max_d=3
expect: => i=0 r=0.0 ok=true s="found 0 digits in range" errors=0 n=3 res=[78,99,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dmin = ${min_d};
	let dmax = ${max_d};
	var total_digits = 0;
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		while x > 0 {
			let d = x % 10;
			if d >= dmin && d <= dmax {
				total_digits++;
			}
			x /= 10;
		}
	}
	gold_push(g, total_digits);
	g.steps += g.n + 1;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "found ", total_digits, " digits in range");
	out
}
@end
