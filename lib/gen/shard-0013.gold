@entry 2e7aae068e132bcd
kind: fn
verb: join
noun: runs
modifier: any
context: search
phrase: join consecutive identical digit runs
phrase: search longest identical run length
test: arg=112223,12345
expect: 3
expect: 1
test: arg=8888
expect: 4
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var max_len = 1;
	var cur_len = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev {
			cur_len++;
			if cur_len > max_len { max_len = cur_len; }
		} else {
			cur_len = 1;
			prev = cur;
		}
		x /= 10;
	}
	max_len
}
@end
