@entry 04c881b0fd429b78
kind: step
verb: dedupe
noun: budget
modifier: at_most
context: stats
slot: budget int
phrase: dedupe consecutive duplicates spending at most budget {budget}
phrase: collapse repeated adjacent values within operation budget {budget}
test: list=1,1,2,2,3,3 budget=1
expect: => i=5 r=0.0 ok=true s="budget_kept: 5" errors=0 n=5 res=[1,2,2,3,3] cache=0 hits=0
test: list=5,5,6,6 budget=5
expect: => i=2 r=0.0 ok=true s="budget_kept: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var b = ${budget};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		g.res[kept] = val;
		kept++;
		i++;
		while i < g.n && g.res[i] == val {
			if b > 0 {
				b--;
				i++;
			} else {
				g.res[kept] = g.res[i];
				kept++;
				i++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "budget_kept: ", kept);
	out
}
@end
@entry 7449915cb7b68a0f
kind: step
verb: merge
noun: average
modifier: at_least
context: sort
phrase: merge sorted elements with average at least {cutoff}
phrase: combine sorted adjacent items with mean at least {cutoff}
slot: cutoff int
test: list=10,20,30,40 cutoff=25
expect: => i=3 r=0.0 ok=true s="merged into 3 sorted items" errors=0 n=3 res=[10,25,40] cache=0 hits=0
test: list=5,15,25,35 cutoff=15
expect: => i=3 r=0.0 ok=true s="merged into 3 sorted items" errors=0 n=3 res=[5,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			let avg = (g.res[i] + g.res[i + 1]) / 2;
			if avg >= cut {
				g.res[kept] = avg;
				kept++;
				i += 2;
				continue;
			}
		}
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged into ", kept, " sorted items");
	out
}
@end
