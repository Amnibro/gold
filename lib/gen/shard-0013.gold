kind: step
verb: filter
noun: evens
modifier: recursively
context: compare
phrase: filter even numbers recursively until odd remains
phrase: strip even numbers recursively in comparison list
test: list=2,4,6,8,5
expect: => i=5 r=0.0 ok=true s="recursively filtered even factors for 5 items" errors=0 n=5 res=[1,1,3,1,5] cache=0 hits=0
test: list=10,12,7,14
expect: => i=4 r=0.0 ok=true s="recursively filtered even factors for 4 items" errors=0 n=4 res=[5,3,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 0 && x % 2 == 0 {
			x /= 2;
		}
		g.res[write_idx] = x;
		write_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "recursively filtered even factors for ", write_idx, " items");
	out
}
@end
@entry 6c190d8a788fd3e1
kind: step
verb: validate
noun: limit
modifier: unique
context: compare
phrase: validate unique comparison count against limit {lim}
phrase: check unique comparison entries remain under {lim}
slot: lim int
test: list=1,2,3,4 lim=5
expect: => i=4 r=0.0 ok=true s="unique count 4 within limit 5" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30,40,50 lim=3
expect: => i=5 r=0.0 ok=false s="unique count 5 exceeded limit 3" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lim};
	var unique_count = 0;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt == 1 { unique_count++; }
	}
	let ok_limit = unique_count <= l;
	g.steps += g.n;
	out.ok = ok_limit;
	out.i = unique_count;
	out.s.clear();
	if ok_limit {
		format(out.s, "unique count ", unique_count, " within limit ", l);
	} else {
		format(out.s, "unique count ", unique_count, " exceeded limit ", l);
	}
	out
}
@end
@entry 96cc75d738e3e1da
kind: step
verb: dedupe
noun: maximum
modifier: running
context: compare
phrase: dedupe running maximum comparison values
phrase: remove duplicate running maximum comparison entries
test: list=1,3,3,2,5,5,4
expect: => i=3 r=0.0 ok=true s="kept 3 strictly increasing running maximums" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,2,4,3,6,6
expect: => i=3 r=0.0 ok=true s="kept 3 strictly increasing running maximums" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var cur_max = g.res[0];
	var write_idx = 1;
	for i in g.n - 1 {
		let idx = i + 1;
		if g.res[idx] > cur_max {
			cur_max = g.res[idx];
			g.res[write_idx] = cur_max;
			write_idx++;
		}
	}
	let removed = g.n - write_idx;
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept ", write_idx, " strictly increasing running maximums");
	out
}
@end
@entry 393c46d04c3805c7
kind: step
verb: filter
noun: duplicates
modifier: with_cache
context: compare
phrase: filter comparison duplicates using cache lookup
phrase: purge duplicate comparison values with cache
test: list=1,2,2,3,4,4
expect: => i=2 r=0.0 ok=true s="filtered 2 cached duplicates" errors=0 n=4 res=[1,2,3,4] cache=4 hits=2
test: list=10,10,20,30,30
expect: => i=2 r=0.0 ok=true s="filtered 2 cached duplicates" errors=0 n=3 res=[10,20,30] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	var dup_count = 0;
	for i in g.n {
		let val = g.res[i];
		let cached, ok = gold_cache_get(g, val);
		if ok {
			dup_count++;
		} else {
			gold_cache_put(g, val, 1);
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "filtered ", dup_count, " cached duplicates");
	out
}
@end
