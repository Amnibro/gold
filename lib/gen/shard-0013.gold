test: list=1,3,4,5,7,8 max_count=3
expect: => i=3 r=0.0 ok=true s="filtered first odds up to 3: kept 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,5,7,9,11 max_count=2
