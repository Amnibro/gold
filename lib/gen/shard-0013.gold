fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = if ${limit} <= 0 { 0 } else { if ${limit} > g.n { g.n } else { ${limit} } };
	var kept = 0;
	var i = lim;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.n = kept;
	gold_cache_put(g, 0, lim);
	gold_push(g, lim);
	out.i = lim;
	out.s.clear();
	format(out.s, "dropped subfunction up to ", lim);
	g.steps += g.n + lim + 1;
	out
}
@end
