test: list=1,1 thresh=10
expect: => i=0 r=0.0 ok=true s="kept 0 items after dropping prefix" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var run = 0;
	var drop_idx = 0;
	for i in g.n {
		run += g.res[i];
		drop_idx++;
		if run > th {
			break;
		}
	}
	var kept = 0;
	if run > th {
		for i in drop_idx..g.n {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items after dropping prefix");
	out
}
@end
