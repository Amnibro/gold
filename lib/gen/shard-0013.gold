code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq == 1 && x < min_val {
			min_val = x;
			found = true;
		}
	}
	g.steps += g.n + 1;
	out.ok = found;
	out.i = if found { min_val } else { 0 };
	out.s.clear();
	format(out.s, "returned minimum unique=", out.i);
	out
}
@end
@entry f86d15bc0412bd01
kind: step
verb: rotate
noun: average
modifier: none
context: aggregate
phrase: rotate elements around average value pivot
phrase: cycle items according to average calculation
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="rotated average items count=5" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="rotated average items count=3" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		let avg = sum / g.n;
		let s = if avg >= 0 { avg } else { -avg };
		let k = s % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
		out.i = avg;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "rotated average items count=", g.n);
	out
}
@end
