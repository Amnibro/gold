test: arg=521,904
expect: 125
expect: 49
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var d int[..20] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	for i in d.len {
		var min_idx = i;
		for j in (i + 1)..d.len {
			if d[j] < d[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let t = d[i];
			d[i] = d[min_idx];
			d[min_idx] = t;
		}
	}
	var res = 0;
	for v in d {
		res = res * 10 + v;
	}
	res
}
@end
