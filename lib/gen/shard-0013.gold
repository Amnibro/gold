phrase: transform fill steps at most step {max_increment}
phrase: increment elements by at most step bound {max_increment}
test: list=10,20,30 max_increment=2
expect: => i=5 r=0.0 ok=true s="applied increments totaling 5" errors=0 n=3 res=[11,22,32] cache=0 hits=0
test: list=5 max_increment=10
expect: => i=1 r=0.0 ok=true s="applied increments totaling 1" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mi = ${max_increment};
	var inc_sum = 0;
	for i in g.n {
		let step_val = i + 1;
		let inc = if step_val < mi { step_val } else { mi };
		g.res[i] += inc;
		inc_sum += inc;
	}
	g.steps += g.n + 1;
	out.i = inc_sum;
	out.s.clear();
	format(out.s, "applied increments totaling ", inc_sum);
	out
}
@end
