noun: range
modifier: any
context: format
slot: cache_slot int
phrase: format cache range any span slot {cache_slot}
phrase: render numerical range span saving to {cache_slot}
test: list=5,15,8 cache_slot=1
expect: => i=10 r=0.0 ok=true s="span: 10 (min=5 max=15)" errors=0 n=3 res=[5,15,8] cache=1 hits=0
