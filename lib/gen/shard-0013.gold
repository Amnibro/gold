code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i+1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i+1];
			g.res[i+1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	if swaps == 0 && g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		swaps = 1;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped loop count=", swaps);
	out
}
@end
