fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_s = 0;
	var cur_s = 0;
	if g.n > 0 {
		max_s = 1;
		cur_s = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_s++;
				if cur_s > max_s {
					max_s = cur_s;
				}
			} else {
				cur_s = 1;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = max_s;
	out.s.clear();
	format(out.s, "max streak length is ", max_s);
	out
}
@end
