fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if !${cond}(x) { break; }
		s += x;
		idx--;
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "summed tail while condition: ", s);
	gold_push(g, s);
	out
}
@end
