@entry deab9dc68c215f54
kind: step
verb: scan
noun: primes
modifier: until
context: list
phrase: scan primes until limit {limit}
phrase: inspect prime numbers until {limit}
slot: limit int
test: list=2,3,4,5,6,7,8,9,10 limit=6
expect: => i=3 r=0.0 ok=true s="primes found until limit: 3" errors=0 n=10 res=[2,3,4,5,6,7,8,9,10,3] cache=0 hits=0
test: list=11,12,13,14,15,16,17 limit=15
expect: => i=2 r=0.0 ok=true s="primes found until limit: 2" errors=0 n=8 res=[11,12,13,14,15,16,17,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let lim = ${limit};
    var prime_count = 0;
    for i in g.n {
        let x = g.res[i];
        if x > lim {
            break;
        }
        var is_p = true;
        if x < 2 {
            is_p = false;
        } else {
            var d = 2;
            while d * d <= x {
                if x % d == 0 {
                    is_p = false;
                    break;
                }
                d++;
            }
        }
        if is_p {
            prime_count++;
        }
    }
    g.steps += g.n;
    out.i = prime_count;
    out.s.clear();
    format(out.s, "primes found until limit: ", prime_count);
    gold_push(g, prime_count);
    out
}
@end
