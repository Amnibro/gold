fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var spaces = 0;
	var end_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] == ' ' {
			spaces++;
			if spaces == lim {
				end_idx = i;
				break;
			}
		}
	}
	out.s.resize(end_idx, ' ');
	g.steps += out.s.len + 1;
	out.i = lim;
	out
}
@end
