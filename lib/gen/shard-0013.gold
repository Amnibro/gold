@entry b5f7d8e1a471c6b6
kind: step
verb: rotate
noun: cache
modifier: times
context: list
phrase: rotate cache {count} times
phrase: cycle cache entries {count} times
slot: count int
test: list=1,2,3 count=1
expect: => i=1 r=0.0 ok=true s="rotated cache times: 1" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=5,6,7,8 count=2
expect: => i=2 r=0.0 ok=true s="rotated cache times: 2" errors=0 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let k = ${count};
    if g.cn > 1 {
        for _ in k {
            let last_k = g.ck[g.cn - 1];
            let last_v = g.cv[g.cn - 1];
            var j = g.cn - 1;
            while j > 0 {
                g.ck[j] = g.ck[j - 1];
                g.cv[j] = g.cv[j - 1];
                j--;
            }
            g.ck[0] = last_k;
            g.cv[0] = last_v;
        }
    }
    for i in g.n {
        g.res[i] = g.res[i] + k;
    }
    g.steps += g.n;
    out.i = k;
    out.s.clear();
    format(out.s, "rotated cache times: ", k);
    out
}
@end
