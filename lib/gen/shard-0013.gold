fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			gold_cache_put(g, i, g.res[i]);
			g.hits++;
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps: ", swaps);
	out
}
