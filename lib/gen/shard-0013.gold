code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n == 0 || k <= 0 {
		out.i = 0;
		return out;
	}
	var count = k;
	if count > g.n {
		count = g.n;
	}
	var sum = 0;
	var i = g.n - count;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of last ", count, " comparison tail items is ", sum);
	out
}
@end
