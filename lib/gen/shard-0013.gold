@entry 1629191e280227bd
kind: fn
verb: limit
noun: duplicates
modifier: safely
context: aggregate
phrase: limit duplicates safely distinct count
phrase: count distinct decimal digits
test: arg=11223,12345
expect: 3
expect: 5
test: arg=777
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var seen = 0;
	while x > 0 {
		let d = x % 10;
		var mask = 1;
		for i in d { mask *= 2; }
		seen = seen | mask;
		x /= 10;
	}
	var count = 0;
	for i in 10 {
		if (seen % 2) != 0 { count++; }
		seen /= 2;
	}
	count
}
@end
