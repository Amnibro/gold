code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	var unique_shifted = 0;
	var i = 0;
	while i < orig_n {
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { seen = true; break; }
			j++;
		}
		if !seen {
			let shifted = g.res[i] + 1;
			gold_cache_put(g, unique_shifted, shifted);
			gold_push(g, shifted);
			unique_shifted++;
		}
		i++;
	}
	out.i = unique_shifted;
	out.s.clear();
	format(out.s, "shifted unique sequence ", unique_shifted);
	g.steps += orig_n + 1;
	out
}
@end
