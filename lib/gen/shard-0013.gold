fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = ${sub}(g.res[i]);
		let b = ${sub}(g.res[i + 1]);
		let sum = a + b;
		if sum >= ${low} && sum <= ${high} {
			g.res[pairs] = sum;
			pairs++;
		}
		i += 2;
	}
	if pairs == 0 {
		gold_fail(g, "paired subfunction result out of bounds");
		out.ok = false;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired subfunction items ", pairs);
	out
}
