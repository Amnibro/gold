code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var running = 0;
	var kept = 0;
	for i in g.n {
		let next_sum = running + g.res[i];
		if next_sum <= cap {
			running = next_sum;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "running sum under threshold ", running);
	out
}
@end
