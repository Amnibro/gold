code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = ${sub}(g.res[i]);
		if x >= lim {
			g.res[kept] = x;
			kept++;
		}
	}
	if kept == 0 { gold_fail(g, "no elements matched at least limit"); out.ok = false; return out; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	gold_text(out, "function filtered at least");
	out
}
@end
