code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stride = if ${k} <= 0 { 1 } else { ${k} };
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if i % stride == 0 {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	gold_push(g, dropped);
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped stride items ", dropped);
	g.steps += g.n + 1;
	out
}
@end
