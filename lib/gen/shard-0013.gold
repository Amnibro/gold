fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var count = 0;
	while count < g.n && sum < lim {
		sum += g.res[count];
		count++;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded history: ", sum);
	out
}
