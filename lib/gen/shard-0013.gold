@entry 34ff808724670eb8
kind: step
verb: scale
noun: numbers
modifier: none
context: filter
phrase: scale numbers when none exceed {bound} by {factor}
phrase: multiply values if none pass {bound} by {factor}
slot: bound int
slot: factor int
test: list=2,4,6 bound=10 factor=2
expect: => i=1 r=0.0 ok=true s="scaled none exceed=true" errors=0 n=3 res=[4,8,12] cache=0 hits=0
test: list=2,15,4 bound=10 factor=2
expect: => i=0 r=0.0 ok=false s="scaled none exceed=false" errors=0 n=3 res=[2,15,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let f = ${factor};
	var any_exceed = false;
	for i in g.n {
		if g.res[i] > b { any_exceed = true; break; }
	}
	if !any_exceed {
		for i in g.n { g.res[i] *= f; }
	}
	g.steps += g.n;
	out.ok = !any_exceed;
	out.i = if any_exceed { 0 } else { 1 };
	out.s.clear();
	format(out.s, "scaled none exceed=", !any_exceed);
	out
}
@end
