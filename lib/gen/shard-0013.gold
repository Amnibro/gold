code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var appears_later = false;
		var j = i + 1;
		while j < g.n {
			if g.res[j] == val {
				appears_later = true;
			}
			j++;
		}
		if !appears_later {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped prefix keeping last occurrences left ", g.n);
	out
}
@end
