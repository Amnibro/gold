@entry 5b2a3759980d8500
kind: step
verb: trace
noun: step
modifier: in_reverse
context: compare
phrase: trace adjacent comparison steps in reverse
phrase: log backwards steps across comparison entries
test: list=10,15,22,30
expect: => i=20 r=0.0 ok=true s="reverse adjacent step total is 20" errors=0 n=4 res=[10,15,22,30] cache=0 hits=0
test: list=4,8,16,25
expect: => i=21 r=0.0 ok=true s="reverse adjacent step total is 21" errors=0 n=4 res=[4,8,16,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var sum_steps = 0;
	var i = g.n - 1;
	while i > 0 {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		sum_steps += diff;
		i--;
	}
	g.steps += g.n;
	out.i = sum_steps;
	out.s.clear();
	format(out.s, "reverse adjacent step total is ", sum_steps);
	out
}
@end
@entry c2eec2fcfffcce39
kind: step
verb: filter
noun: squares
modifier: with_cache
context: compare
phrase: filter square numbers using cached comparisons
phrase: retain square values via cached comparison check
test: list=3,4,7,9,16
expect: => i=3 r=0.0 ok=true s="filtered 3 square values with cache" errors=0 n=3 res=[4,9,16] cache=5 hits=0
test: list=2,5,25,30,36
expect: => i=2 r=0.0 ok=true s="filtered 2 square values with cache" errors=0 n=2 res=[25,36] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let num = g.res[i];
		var is_sq = false;
		if num >= 0 {
			let cached, ok = gold_cache_get(g, num);
			if ok {
				is_sq = (cached == 1);
			} else {
				var r = 0;
				while r * r < num { r++; }
				if r * r == num {
					is_sq = true;
					gold_cache_put(g, num, 1);
				} else {
					gold_cache_put(g, num, 0);
				}
			}
		}
		if is_sq {
			g.res[write_idx] = num;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "filtered ", write_idx, " square values with cache");
	out
}
@end
