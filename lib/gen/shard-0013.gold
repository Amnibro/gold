@entry 779b534c3cff9a8c
kind: step
verb: scale
noun: runs
modifier: with_cache
context: list
phrase: scale runs with cache by {factor}
phrase: multiply runs with cache using {factor}
slot: factor int
test: list=3,3,5,7,7,7 factor=2
expect: => i=2 r=0.0 ok=true s="scaled runs by 2: count 2" errors=0 n=6 res=[6,6,5,14,14,14] cache=1 hits=0
test: list=4,4,4,1,2,2 factor=3
expect: => i=2 r=0.0 ok=true s="scaled runs by 3: count 2" errors=0 n=6 res=[12,12,12,1,6,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let fac = ${factor};
    var run_count = 0;
    var i = 0;
    while i < g.n {
        var j = i + 1;
        while j < g.n && g.res[j] == g.res[i] {
            j++;
        }
        if j - i > 1 {
            run_count++;
            var k = i;
            while k < j {
                g.res[k] = g.res[k] * fac;
                k++;
            }
        }
        i = j;
    }
    gold_cache_put(g, fac, run_count);
    g.steps += g.n;
    out.i = run_count;
    out.s.clear();
