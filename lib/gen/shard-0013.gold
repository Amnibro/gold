@entry 29ce2c444229f889
kind: step
verb: map
noun: loop
modifier: safely
context: error
phrase: map loop elements safely guarding overflow {factor}
phrase: multiply loop items safely checking bounds {factor}
slot: factor int
test: list=10,20,30 factor=2
expect: => i=0 r=0.0 ok=true s="safely mapped loop items" errors=0 n=3 res=[20,40,60] cache=0 hits=0
test: list=2000000,5 factor=1000
expect: => i=1 r=0.0 ok=false s="safely mapped loop items" errors=1 n=2 res=[2000000,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var overflow = false;
	for i in g.n {
		let res_val = g.res[i] * mult;
		if res_val > 100000000 {
			gold_fail(g, "overflow detected in loop calculation");
			out.ok = false;
			overflow = true;
			break;
		}
		g.res[i] = res_val;
	}
	g.steps += g.n;
	out.i = if overflow { 1 } else { 0 };
	out.s.clear();
	format(out.s, "safely mapped loop items");
	out
}
@end
