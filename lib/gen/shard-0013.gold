	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		gold_cache_put(g, i / 2, g.res[i]);
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "loop rotated");
	out
}
@end
