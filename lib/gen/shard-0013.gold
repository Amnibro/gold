fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_gap = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			let diff = g.res[j] - g.res[i];
			total_gap += if diff < 0 { -diff } else { diff };
		}
	}
	g.steps += g.n * g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "total nested gaps ", total_gap);
	out
}
@end
