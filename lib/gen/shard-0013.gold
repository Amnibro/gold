fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var match_count = 0;
	for i in g.n - 1 {
		var cur_d = g.res[i + 1] - g.res[i];
		if cur_d < 0 {
			cur_d = -cur_d;
		}
		if cur_d == d {
			match_count++;
		}
	}
	g.steps += g.n;
	out.i = match_count;
	out.s.clear();
	format(out.s, "found ", match_count, " pairwise matches with diff ", d);
	out
}
