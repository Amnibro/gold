test: list=30,10,20,80,5 limit=50
expect: => i=3 r=0.0 ok=true s="sorted prefix under limit: 3" errors=0 n=5 res=[10,20,30,80,5] cache=0 hits=0
test: list=9,4,15 limit=10
expect: => i=2 r=0.0 ok=true s="sorted prefix under limit: 2" errors=0 n=3 res=[4,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	while count < g.n && g.res[count] < lim {
		count++;
	}
	for i in count {
		for j in i + 1..count {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted prefix under limit: ", count);
	out
}
@end
