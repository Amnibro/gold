code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique: ", kept);
	out
}
@end
