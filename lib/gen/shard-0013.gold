fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_unique = true;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				is_unique = false;
				break;
			}
		}
		if !is_unique { break; }
	}
	out.ok = is_unique;
	g.steps += g.n * g.n;
	out.i = if is_unique { 1 } else { 0 };
	out.s.clear();
	format(out.s, "unique scan result ", out.i);
	out
}
@end
