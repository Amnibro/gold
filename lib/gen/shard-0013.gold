			g.res[i + 1] = tmp;
			gold_cache_put(g, i, g.res[i]);
			gold_cache_put(g, i + 1, g.res[i + 1]);
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " histogram items");
	out
}
