fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	var i = 0;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] == g.res[j] {
				ok = false;
				break;
			}
			j += 2;
		}
		if !ok { break; }
		i += 2;
	}
	g.steps += g.n;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "alternating_unique: ", out.i);
	out
}
