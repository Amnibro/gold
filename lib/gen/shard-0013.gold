code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let want = ${k};
	var count = want;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	var sum = 0;
	for i in start..g.n {
		sum += g.res[i];
	}
	g.n = start;
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged suffix items sum ", sum);
	out
}
@end
