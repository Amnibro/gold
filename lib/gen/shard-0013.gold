fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var new_res int[>..] = [];
	for i in g.n - 1 {
		new_res.push(g.res[i]);
		let mid_val = (g.res[i] + g.res[i + 1]) / 2;
		let transformed = ${sub}(mid_val);
		new_res.push(transformed);
	}
	new_res.push(g.res[g.n - 1]);
	g.n = 0;
	for x in new_res {
		gold_push(g, x);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined subfunction between pairs yielding length ", g.n);
	out
}
@end
@entry 3f737c16566e5981
kind: step
verb: rotate
noun: odds
modifier: at_least
context: transform
phrase: rotate odd values forward at least {shifts} times
phrase: cycle odd elements at least {shifts} steps
slot: shifts int
test: list=1,2,3,4,5,6 shifts=1
expect: => i=3 r=0.0 ok=true s="rotated 3 odd values by shift 1" errors=0 n=6 res=[5,2,1,4,3,6] cache=0 hits=0
test: list=7,4,9,2,11,8 shifts=2
expect: => i=3 r=0.0 ok=true s="rotated 3 odd values by shift 2" errors=0 n=6 res=[9,4,11,2,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shifts};
	var odds int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds.push(g.res[i]);
		}
	}
	if odds.len > 1 {
		let k = s % odds.len;
		for _ in k {
			let last = odds[odds.len - 1];
			var j = odds.len - 1;
			while j > 0 {
				odds[j] = odds[j - 1];
				j--;
			}
			odds[0] = last;
		}
		var odd_idx = 0;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				g.res[i] = odds[odd_idx];
				odd_idx++;
			}
		}
	}
	g.steps += odds.len + s;
	out.i = odds.len;
	out.s.clear();
	format(out.s, "rotated ", odds.len, " odd values by shift ", s);
	out
}
@end
