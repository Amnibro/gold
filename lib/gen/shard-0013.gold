		out.s.clear();
		out.s.append("empty search");
		g.steps++;
		return out;
	}
	let last_val = g.res[g.n - 1];
	let is_even_last = (last_val % 2 == 0);
	var matched = 0;
	for i in g.n {
		let is_even_cur = (g.res[i] % 2 == 0);
		if is_even_cur == is_even_last { matched++; }
	}
	gold_push(g, matched);
	out.i = matched;
	out.s.clear();
	format(out.s, "split condition last matched ", matched);
	g.steps += g.n + 1;
	out
}
@end
