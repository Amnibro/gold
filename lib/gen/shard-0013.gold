code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			g.res[i] = -g.res[i];
			dups++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "negated_dups=", dups);
	out
}
@end
@entry 02dc1249ca5f88ec
kind: step
verb: swap
noun: minimum
modifier: with_cache
context: stats
phrase: swap minimum sample value with cached baseline
phrase: replace minimum observation with baseline from cache
test: list=10,2,30
expect: => i=2 r=0.0 ok=true s="min_swapped=2" errors=0 n=3 res=[10,999,30] cache=1 hits=1
test: list=50,15,40
expect: => i=15 r=0.0 ok=true s="min_swapped=15" errors=0 n=3 res=[50,999,40] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	gold_cache_put(g, 0, 999);
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	let old_min = g.res[min_idx];
	let cached_val, _ = gold_cache_get(g, 0);
	g.res[min_idx] = cached_val;
	gold_cache_put(g, 0, old_min);
	g.steps += g.n;
	out.i = old_min;
	out.s.clear();
	format(out.s, "min_swapped=", old_min);
	out
}
@end
@entry 4d32326be5ea9bd7
kind: step
verb: check
noun: loop
modifier: at_most
context: stats
slot: max_len int
phrase: check sample values for non increasing runs of at most {max_len}
phrase: verify sequence has at most {max_len} identical runs
test: list=1,1,1,2,2 max_len=3
expect: => i=1 r=0.0 ok=true s="loop_ok=true" errors=0 n=5 res=[1,1,1,2,2] cache=0 hits=0
test: list=4,4,4,4,5 max_len=2
expect: => i=0 r=0.0 ok=false s="loop_ok=false" errors=0 n=5 res=[4,4,4,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if g.n == 0 { return out; }
	var cur_run = 1;
	var max_run = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
		i++;
	}
	let ok = max_run <= lim;
	g.steps += g.n;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "loop_ok=", ok);
	out
}
@end
@entry c000235e51d81ba9
kind: step
verb: reverse
noun: minimum
modifier: pairwise
context: stats
phrase: reverse order of pairwise minimums across sample
phrase: invert pairwise minimum values from sample
test: list=10,5,20,8
expect: => i=2 r=0.0 ok=true s="rev_pairs=2" errors=0 n=2 res=[8,5] cache=0 hits=0
test: list=30,12,14,2
expect: => i=2 r=0.0 ok=true s="rev_pairs=2" errors=0 n=2 res=[2,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[pairs] = if a < b { a } else { b };
		pairs++;
		i += 2;
	}
	g.n = pairs;
	for p in pairs / 2 {
		let q = pairs - 1 - p;
		let tmp = g.res[p];
		g.res[p] = g.res[q];
		g.res[q] = tmp;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "rev_pairs=", pairs);
	out
}
@end
