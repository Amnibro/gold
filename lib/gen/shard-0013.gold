expect: => i=40 r=0.0 ok=true s="budget spent 40" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= ceil {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	var retries = 0;
	while retries < 1 { retries++; }
	g.n = kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent ", spent);
	g.steps += kept + retries + 1;
	out
}
@end
