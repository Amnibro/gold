fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	var lim = w;
	if lim > g.n { lim = g.n; }
	if lim < 0 { lim = 0; }
	var write_idx = 0;
	for i in lim {
		let x = g.res[i];
		var exists = false;
		for j in write_idx {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	for i in lim..g.n {
		g.res[write_idx] = g.res[i];
		write_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged unique window count ", write_idx);
	out
}
