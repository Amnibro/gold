kind: step
verb: keep
noun: primes
modifier: all
context: sort
phrase: keep primes all present in sorted results
phrase: preserve all prime numbers in ascending list
test: list=9,4,7,2,8,3,5,11,12
expect: => i=5 r=0.0 ok=true s="primes kept: 5" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=15,13,6,17,4
expect: => i=2 r=0.0 ok=true s="primes kept: 2" errors=0 n=2 res=[13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x > 1;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "primes kept: ", kept);
	out
}
@end
