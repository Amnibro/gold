@entry 476ce3148ea5af5c
kind: step
verb: sort
noun: limit
modifier: unique
context: cache
phrase: sort unique items keeping up to limit {lim}
phrase: order unique entries restricting to limit {lim}
slot: lim int
test: list=4,2,2,8,1 lim=3
expect: => i=3 r=0.0 ok=true s="sorted 3 unique" errors=0 n=3 res=[1,2,4] cache=3 hits=0
test: list=9,5,9,1 lim=2
expect: => i=2 r=0.0 ok=true s="sorted 2 unique" errors=0 n=2 res=[1,5] cache=2 hits=0
test: list=3,1,2 lim=10
expect: => i=3 r=0.0 ok=true s="sorted 3 unique" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var u int[512] = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in nu { if u[j] == x { exists = true; break; } }
		if !exists && nu < 512 { u[nu] = x; nu++; }
	}
	for i in nu {
		for j in (nu - 1) {
			if u[j] > u[j + 1] {
				let tmp = u[j]; u[j] = u[j + 1]; u[j + 1] = tmp;
			}
		}
	}
	let keep = if nu < limit { nu } else { limit };
	gold_clear(g);
	for i in keep {
		gold_push(g, u[i]);
		gold_cache_put(g, i, u[i]);
	}
	g.steps += nu * nu;
	out.i = keep;
	out.s.clear();
	format(out.s, "sorted ", keep, " unique");
	out
}
@end
