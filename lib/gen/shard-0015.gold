fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if (${r} <= 0.0 || ${a} <= ${r} || ${b} <= ${a} || ${h} <= 0.0) {
		out.ok = false;
	} else {
		var o byte[>..] = [];
		gold_dnews(g, "flange", "", o);
		o.append(" lathe ");
		o.append("0");
		o.append(",");
		o.append("0");
		o.append(",");
		o.append("0");
		o.append(" ");
		gold_fnum(o, ${r});
		o.append(",");
		o.append("0");
		o.append(" ");
		gold_fnum(o, ${b});
		o.append(",");
		o.append("0");
		o.append(" ");
		gold_fnum(o, ${b});
		o.append(",");
		gold_fnum(o, ${h} * 0.4);
		o.append(" ");
		gold_fnum(o, ${a});
		o.append(",");
		gold_fnum(o, ${h} * 0.4);
		o.append(" ");
		gold_fnum(o, ${a});
		o.append(",");
		gold_fnum(o, ${h});
		o.append(" ");
		gold_fnum(o, ${r});
		o.append(",");
		gold_fnum(o, ${h});
		o.append(" m:brushed");
		gold_doc(g, o);
		out.i = g.dn;
		out.s.clear();
		format(out.s, "flange");
	}
	out
}
@end
@entry b69f541e4de3bf97
kind: step
verb: validate
noun: minimum
modifier: while
context: compare
phrase: validate minimum {min} while limit {limit} step {step}
phrase: check minimum bound {min} while below {limit} with step {step}
slot: min int
slot: limit int
slot: step int
test: min=10 limit=50 step=10
expect: => i=5 r=0.0 ok=true s="while" errors=0 n=0 res=[] cache=0 hits=0
test: min=0 limit=15 step=5
expect: => i=4 r=0.0 ok=true s="while" errors=0 n=0 res=[] cache=0 hits=0
test: min=60 limit=50 step=10
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${step} <= 0 || ${min} > ${limit} {
		out.ok = false;
		return out;
	}
	var count = 0;
	var cur = ${min};
	while cur <= ${limit} {
		count++;
		cur += ${step};
	}
	out.i = count;
	out.s.clear();
	format(out.s, "while");
	out
}
@end
