@entry 4452cfee8ad52485
kind: step
verb: fill
noun: loop
modifier: with_retry
context: stats
phrase: fill invalid entries in loop with {replacement} using retry bound {retries}
phrase: impute outliers in loop replacing with {replacement} under retry limit {retries}
slot: p pred
slot: replacement int
slot: retries int
test: list=2,5,4,7 p=is_even replacement=0 retries=3
expect: => i=2 r=0.0 ok=true s="filled 2 invalid values in loop" errors=0 n=4 res=[2,0,4,0] cache=0 hits=0
test: list=1,3,5 p=is_even replacement=0 retries=1
expect: => i=1 r=0.0 ok=false s="" errors=1 n=3 res=[0,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${replacement};
	var budget = ${retries};
	var filled = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			if budget > 0 {
				g.res[i] = rep;
				budget--;
				filled++;
			} else {
				gold_fail(g, "fill retry budget exceeded in loop");
				out.ok = false;
				out.i = filled;
				return out;
			}
		}
	}
	g.steps += g.n;
	out.i = filled;
	out.ok = true;
	out.s.clear();
