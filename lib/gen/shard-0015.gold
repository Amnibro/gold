@entry fccf5253e49364b5
kind: step
verb: scale
noun: minimum
modifier: last
context: loop
phrase: scale minimum of last {k} loop values by {factor}
phrase: scale lowest of last {k} loop items by {factor}
slot: k int
slot: factor int
test: list=10,5,20,3,15 k=3 factor=2
expect: => i=6 r=0.0 ok=true s="scaled last minimum to 6" errors=0 n=5 res=[10,5,20,6,15] cache=0 hits=0
test: list=8,12,4,9 k=2 factor=3
expect: => i=12 r=0.0 ok=true s="scaled last minimum to 12" errors=0 n=4 res=[8,12,12,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let fac = ${factor};
	if g.n == 0 || count <= 0 { return out; }
	var start = g.n - count;
	if start < 0 { start = 0; }
	var min_idx = start;
	for i in (start + 1)..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	g.res[min_idx] = g.res[min_idx] * fac;
	g.steps += (g.n - start);
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "scaled last minimum to ", out.i);
	out
}
@end
