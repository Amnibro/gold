fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let cnt = g.n - 1;
	var gaps int[512] = [0; 512];
	for i in cnt {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		gaps[i] = diff;
		gold_cache_put(g, i, diff);
	}
	gold_clear(g);
	for i in cnt { gold_push(g, gaps[i]); }
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "computed ", cnt, " gaps");
	out
}
@end
@entry c3bfb4996dffa9c4
kind: step
verb: clamp
noun: sequence
modifier: until
context: cache
phrase: clamp sequence elements until total reaches {max_sum}
phrase: bound sequence items until accumulated sum hits {max_sum}
slot: max_sum int
test: list=10,20,30 max_sum=25
expect: => i=25 r=0.0 ok=true s="clamped sum 25" errors=0 n=3 res=[10,15,30] cache=2 hits=0
test: list=5,15,25 max_sum=40
expect: => i=40 r=0.0 ok=true s="clamped sum 40" errors=0 n=3 res=[5,15,20] cache=3 hits=0
test: list=50 max_sum=20
expect: => i=20 r=0.0 ok=true s="clamped sum 20" errors=0 n=1 res=[20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_sum};
	var running = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if running + x <= cap {
			running += x;
			gold_cache_put(g, i, x);
			count++;
		} else {
			let rem = cap - running;
			if rem > 0 {
				g.res[i] = rem;
				gold_cache_put(g, i, rem);
				running += rem;
				count++;
			}
			break;
		}
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "clamped sum ", running);
	out
}
@end
