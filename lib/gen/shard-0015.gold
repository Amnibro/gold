fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_span = 0;
	var cur_span = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			cur_span++;
			if cur_span > max_span { max_span = cur_span; }
		} else {
			cur_span = 0;
		}
	}
	g.steps += g.n;
	out.i = max_span;
	out.s.clear();
	format(out.s, "max span without match: ", max_span);
	out
}
@end
@entry d746ee50934573f9
kind: step
verb: pair
noun: series
modifier: with_retry
context: loop
phrase: combine series pairs with retry threshold {limit} in loop
phrase: pair series adjacent values with retry bound {limit} in loop
slot: limit int
test: list=10,20,5,60,30,10 limit=50
expect: => i=1 r=0.0 ok=true s="paired series with 1 retries" errors=0 n=3 res=[30,50,40] cache=0 hits=0
test: list=4,8,12,16 limit=25
expect: => i=1 r=0.0 ok=true s="paired series with 1 retries" errors=0 n=2 res=[12,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 { return out; }
	var kept = 0;
	var retries = 0;
	var i = 0;
	while i + 1 < g.n {
		var sum = g.res[i] + g.res[i + 1];
		if sum > lim {
			sum = lim;
			retries++;
		}
		g.res[kept] = sum;
		kept++;
		i += 2;
	}
	g.steps += i;
	g.n = kept;
	out.i = retries;
	out.s.clear();
	format(out.s, "paired series with ", retries, " retries");
	out
}
@end
