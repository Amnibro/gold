code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var count = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= mg { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps meeting minimum: ", count);
	out
}
@end
@entry 805023b540d4a3d5
kind: step
verb: find
noun: primes
modifier: none
context: stats
phrase: find primes none check in observations
