@entry 3bfb2f4319d10161
kind: fn
verb: reverse
noun: middle
modifier: pairwise
context: list
phrase: reverse middle pairwise digit swap with {shift}
phrase: middle pairwise digit reversal plus {shift}
slot: shift int
test: arg=1425,30 shift=10
expect: 1255
expect: 40
test: arg=2571 shift=5
expect: 2756
code:
fn ${ID}(n int) int {
	let s = ${shift};
	var x = if n < 0 { -n } else { n };
	if x < 1000 || x > 9999 {
		return n + s;
	}
	let d0 = x % 10;
	let d1 = (x / 10) % 10;
	let d2 = (x / 100) % 10;
	let d3 = (x / 1000) % 10;
	let swapped = d3 * 1000 + d1 * 100 + d2 * 10 + d0;
	swapped + s
}
@end
