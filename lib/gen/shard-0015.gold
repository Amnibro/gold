code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if low > high {
		gold_fail(g, "invalid range bounds");
		out.ok = false;
		return out;
	}
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		if x >= low && x <= high {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "kept ", w, " items in range");
	out
}
@end
@entry 35fd5c6f656b6f27
kind: step
verb: swap
noun: primes
modifier: every_other
context: transform
slot: p pred
phrase: swap every other prime element matching {p}
phrase: alternate swapping prime items with predicate {p}
test: list=2,3,4,5,6,7 p=is_prime
expect: => i=1 r=0.0 ok=true s="swapped 1 prime pairs" errors=0 n=6 res=[3,2,4,5,6,7] cache=0 hits=0
test: list=11,13,17,19,23 p=is_prime
expect: => i=1 r=0.0 ok=true s="swapped 1 prime pairs" errors=0 n=5 res=[13,11,17,19,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idxs int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			idxs[count] = i;
			count++;
		}
	}
	var swaps = 0;
	var k = 0;
	while k + 1 < count {
		let i1 = idxs[k];
		let i2 = idxs[k + 1];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
		swaps++;
		k += 4;
	}
	g.steps += count;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " prime pairs");
	out
}
@end
