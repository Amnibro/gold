code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	if mul == 0 {
		gold_fail(g, "zero factor");
		out.ok = false;
		return out;
	}
	for i in g.n {
		g.res[i] *= mul;
	}
	out.i = mul;
	out.s.clear();
	format(out.s, "scaled by ", mul);
	out
}
@end
@entry ee49b4a6c2fe24f2
kind: step
verb: drop
noun: history
modifier: while
context: list
phrase: drop leading elements while matching predicate {p}
phrase: trim initial items while satisfying {p}
slot: p pred
test: list=2,4,5,6 p=is_even
expect: => i=2 r=0.0 ok=true s="dropped 2 items" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=1,2,3 p=is_even
expect: => i=0 r=0.0 ok=true s="dropped 0 items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: p=is_even
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var start = 0;
	while start < g.n && ${p}(g.res[start]) {
		start++;
	}
	for i in g.n - start {
		g.res[i] = g.res[i + start];
	}
	g.n -= start;
	out.i = start;
	out.s.clear();
	format(out.s, "dropped ", start, " items");
	out
}
@end
@entry e3521bf291a881f7
kind: step
verb: collect
noun: streak
modifier: nested
context: list
phrase: find longest streak satisfying predicate {p}
phrase: count maximum consecutive run matching {p}
slot: p pred
test: list=1,2,4,6,1,2,2 p=is_even
expect: => i=3 r=0.0 ok=true s="longest streak 3" errors=0 n=7 res=[1,2,4,6,1,2,2] cache=0 hits=0
test: list=1,3,5 p=is_even
expect: => i=0 r=0.0 ok=true s="longest streak 0" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: p=is_even
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var best = 0;
	var cur = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			cur++;
			if cur > best {
				best = cur;
			}
		} else {
			cur = 0;
		}
	}
	out.i = best;
	out.s.clear();
	format(out.s, "longest streak ", best);
	out
}
@end
