fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count < 0 || count > g.n {
		gold_fail(g, "invalid drop count");
		out.ok = false;
		return out;
	}
	for i in g.n - count {
		g.res[i] = g.res[i + count];
	}
	g.n -= count;
	out.i = count;
	out.s.clear();
	format(out.s, "dropped prefix ", count);
	out
}
@end
