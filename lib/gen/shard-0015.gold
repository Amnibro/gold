fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_sum};
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var kept = 0;
	for i in (g.n - 1) {
		let wsum = g.res[i] + g.res[i + 1];
		if wsum <= ceiling {
			g.res[kept] = wsum;
			kept++;
		}
	}
	g.steps += g.n - 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " window sums at most ceiling");
	out
}
@end
