fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_val};
	for i in g.n {
		if g.res[i] < limit {
			gold_fail(g, "value below minimum");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "value below minimum");
			return out;
		}
	}
	for i in g.n {
