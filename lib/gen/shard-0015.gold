test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="recursive deduped 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in nu { if u[j] == x { exists = true; break; } }
		if !exists && nu < 512 { u[nu] = x; nu++; }
	}
	gold_clear(g);
	for i in nu {
		gold_push(g, u[i]);
		gold_cache_put(g, i, u[i]);
	}
	g.steps += g.n * nu;
	out.i = nu;
	out.s.clear();
	format(out.s, "recursive deduped ", nu);
	out
}
@end
