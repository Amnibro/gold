@entry 4f07fc1c7f2519cc
kind: step
verb: swap
noun: suffix
modifier: all
context: stats
phrase: swap suffix all elements from index {idx}
phrase: invert trailing elements all past {idx}
slot: idx int
test: list=1,2,3,4,5 idx=2
expect: => i=3 r=0.0 ok=true s="swapped 3 suffix elements" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 idx=1
expect: => i=3 r=0.0 ok=true s="swapped 3 suffix elements" errors=0 n=4 res=[10,40,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${idx};
	if start >= g.n || start < 0 {
		out.ok = false;
		return out;
	}
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	let count = g.n - start;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " suffix elements");
	out
}
@end
