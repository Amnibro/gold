test: list=2,4,4,6
expect: => i=4 r=0.0 ok=true s="deduped with average appended" errors=0 n=4 res=[2,4,6,5] cache=0 hits=0
test: list=10,10,20
expect: => i=3 r=0.0 ok=true s="deduped with average appended" errors=0 n=3 res=[10,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	if g.n >= 2 {
		let avg = (g.res[g.n - 1] + g.res[g.n - 2]) / 2;
		gold_push(g, avg);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped with average appended");
	out
}
