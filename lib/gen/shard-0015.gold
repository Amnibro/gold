fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	if g.n > 1 {
		var k = g.n - 1;
		while k > 0 {
			diff_sum += g.res[k] - g.res[k - 1];
			k--;
		}
	}
	g.steps += g.n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "reverse difference sum: ", diff_sum);
	out
}
