@entry df0f7f3a6e1374e7
kind: step
verb: find
noun: number
modifier: nested
context: loop
slot: target int
phrase: find number nested in matrix loop {target}
phrase: search nested grid for value {target}
test: input=3 target=7
expect: => i=8 r=0.0 ok=true s="nested search done" errors=0 n=0 res=[] cache=0 hits=0
test: input=4 target=12
expect: => i=13 r=0.0 ok=true s="nested search done" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = false;
	var steps = 0;
	for i in out.i {
		for j in out.i {
			steps++;
			if i * out.i + j == t {
				found = true;
				break;
			}
		}
		if found { break; }
	}
	g.steps += steps;
	out.ok = found;
	out.i = steps;
	out.s.clear();
	format(out.s, "nested search done");
	out
}
@end
