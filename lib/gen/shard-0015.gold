fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var k = 0;
	while k + 1 < g.n {
		g.res[m] = ${f}(g.res[k] + g.res[k + 1]);
		m++;
		k += 2;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "pairwise function applied: ", m);
	out
}
@end
@entry 1251850e35c1f66a
