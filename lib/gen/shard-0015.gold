expect: => i=1 r=0.0 ok=true s="collected memo count: 1" errors=0 n=1 res=[30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= fl {
			g.res[kept] = x;
			gold_cache_put(g, x, kept + 1);
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected memo count: ", kept);
	out
}
@end
