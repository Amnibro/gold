	var out = v;
	var ok_order = true;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] < g.res[i - 1] {
				ok_order = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = ok_order;
	out.i = if ok_order { 1 } else { 0 };
	out.s.clear();
	format(out.s, "reverse tally ordered: ", ok_order);
	out
}
@end
