@entry 7fe9fa367c56b351
kind: step
verb: repeat
noun: suffix
modifier: at_least
context: search
phrase: repeat search suffix to length at least {target}
phrase: pad search suffix to reach at least {target}
slot: target int
test: list=1,2,5 target=6
expect: => i=6 r=0.0 ok=true s="padded suffix to length 6" errors=0 n=6 res=[1,2,5,5,5,5] cache=0 hits=0
test: list=10,20 target=4
expect: => i=4 r=0.0 ok=true s="padded suffix to length 4" errors=0 n=4 res=[10,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	if g.n > 0 && g.n < t {
		let last_val = g.res[g.n - 1];
		while g.n < t && g.n < 512 {
			g.res[g.n] = last_val;
			g.n++;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "padded suffix to length ", g.n);
	out
}
@end
