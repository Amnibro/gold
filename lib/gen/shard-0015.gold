@entry cdebb76e5d500e9c
kind: step
verb: select
noun: tail
modifier: first
context: transform
slot: count int
phrase: select tail of {count} items to front
phrase: rotate trailing {count} items to first position
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="rotated 2 items to front" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30,40,50,60 count=3
expect: => i=3 r=0.0 ok=true s="rotated 3 items to front" errors=0 n=6 res=[40,50,60,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = min(${count}, g.n);
	if c > 0 && c < g.n {
		var tail_items int[512] = [0; 512];
		let start = g.n - c;
		for i in c { tail_items[i] = g.res[start + i]; }
		var j = g.n - 1;
		while j >= c {
			g.res[j] = g.res[j - c];
			j--;
		}
		for i in c { g.res[i] = tail_items[i]; }
	}
	g.steps += g.n;
	out.i = c;
	out.s.clear();
	format(out.s, "rotated ", c, " items to front");
	out
}
@end
@entry baf1b65148dd4858
kind: step
verb: reverse
noun: suffix
modifier: every_other
context: transform
slot: k int
phrase: reverse every other element in suffix {k}
phrase: invert alternate items in suffix of {k}
test: list=1,2,3,4,5,6,7,8 k=6
expect: => i=6 r=0.0 ok=true s="reversed alternate in suffix 6" errors=0 n=8 res=[1,2,8,4,6,5,7,3] cache=0 hits=0
test: list=10,20,30,40,50 k=4
expect: => i=4 r=0.0 ok=true s="reversed alternate in suffix 4" errors=0 n=5 res=[10,50,30,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = min(${k}, g.n);
	let start = g.n - count;
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left += 2;
		right -= 2;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed alternate in suffix ", count);
	out
}
@end
