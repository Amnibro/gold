fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${times};
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { total += x * mult; }
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum primes times: ", total);
	out
}
@end
