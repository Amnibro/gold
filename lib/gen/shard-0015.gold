code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if g.n == 0 || limit <= 0 { return out; }
	var sum = 0;
	var m = if limit < g.n { limit } else { g.n };
	for i in m { sum += g.res[i]; }
	g.res[0] = sum;
	var kept = 1;
	for i in m..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged range sum: ", sum);
	out
}
@end
