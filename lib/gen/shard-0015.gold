phrase: run reverse search for minimum error code under threshold {bound}
phrase: scan backward for minimum fault entry below limit {bound}
test: list=10,5,20,4,30 bound=10
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[10,5,20,4,30] cache=0 hits=0
test: list=15,25 bound=10
expect: => i=15 r=0.0 ok=true s="" errors=1 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 {
		gold_fail(g, "empty list for reverse minimum search");
		out.ok = false;
		return out;
	}
	var min_val = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] < min_val { min_val = g.res[i]; }
		i--;
	}
	if min_val >= b {
		gold_fail(g, "minimum value exceeds bound");
	}
	g.steps += g.n;
	out.i = min_val;
	out
}
@end
