kind: step
verb: split
noun: runs
modifier: in_reverse
context: list
phrase: split runs in reverse order
phrase: reverse item sequence completely
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="reversed 4 items" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed 3 items" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " items");
	out
}
@end
