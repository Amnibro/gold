expect: => i=3 r=0.0 ok=true s="applied operation to all items" errors=0 n=3 res=[4,8,12] cache=0 hits=0
test: list=10,20 op=halve
expect: => i=2 r=0.0 ok=true s="applied operation to all items" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${op}(g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied operation to all items");
	out
}
@end
