expect: => i=1 r=0.0 ok=true s="island" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: island1 cyl 0,0,0 0,0,2 r4 m:matte
test: r=6.0 h=3.0 doc="ground box 0,0,-.5 20,20,1"
expect: => i=2 r=0.0 ok=true s="island" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: island2 cyl 0,0,0 0,0,3 r6 m:matte
test: r=0.0 h=1.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${r} <= 0.0 || ${h} <= 0.0 {
		gold_fail(g, "bad island size");
		out.ok = false;
		return out;
	}
	gold_dnews(g, "island", "", o);
	o.append(" cyl ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(" ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:matte");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "island");
	out
}
@end
