expect: => i=15 r=0.0 ok=true s="scaled average: 15" errors=0 n=4 res=[2,4,6,10] cache=0 hits=0
test: list=20,5,15 times=2
expect: => i=26 r=0.0 ok=true s="scaled average: 26" errors=0 n=3 res=[5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	let res = avg * t;
	g.steps += g.n;
	out.i = res;
	out.s.clear();
	format(out.s, "scaled average: ", res);
	out
}
@end
