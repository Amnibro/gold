phrase: count running numbers that are square
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="found 3 square numbers" errors=0 n=5 res=[4,7,9,12,16] cache=0 hits=0
test: list=2,3,5
expect: => i=0 r=0.0 ok=false s="found 0 square numbers" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.ok = count > 0;
	out.s.clear();
	format(out.s, "found ", count, " square numbers");
	out
}
@end
