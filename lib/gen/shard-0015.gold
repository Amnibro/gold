code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${div};
	if d == 0 { gold_fail(g, "zero divisor"); out.ok = false; return out; }
	for i in g.n {
		g.res[i] = g.res[i] / d;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "series normalized");
	out
}
@end
