code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${bucket};
	if bsize <= 0 {
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var bsum = 0;
		for j in bsize {
			if i + j < g.n {
				bsum += g.res[i + j];
			}
		}
		g.res[new_n] = bsum;
		new_n++;
		i += bsize;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged histogram into ", new_n, " buckets");
	out
}
@end
