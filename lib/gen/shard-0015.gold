expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		if x % 2 == 0 {
			var seen = false;
			for j in w {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "retained ", w, " unique evens");
	out
}
@end
