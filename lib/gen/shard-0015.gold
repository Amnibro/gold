phrase: take alternating items up to budget sum {b}
slot: b int
test: list=10,20,30,40,50 b=60
expect: => i=2 r=0.0 ok=true s="joined 2 items" errors=0 n=2 res=[10,30] cache=2 hits=0
test: list=5,10,15,20 b=25
expect: => i=2 r=0.0 ok=true s="joined 2 items" errors=0 n=2 res=[5,15] cache=2 hits=0
test: list=100,50,200 b=50
expect: => i=0 r=0.0 ok=true s="joined 0 items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${b};
	var spent = 0;
	var kept = 0;
	var temp int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if spent + x <= budget && kept < 512 {
			temp[kept] = x;
			spent += x;
			gold_cache_put(g, kept, x);
			kept++;
		}
		i += 2;
	}
	gold_clear(g);
	for k in kept { gold_push(g, temp[k]); }
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined ", kept, " items");
	out
}
@end
