code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	for k in g.n {
		s += g.res[k];
		g.res[k] = s;
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "prefix scan final: ", s);
	out
