fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var tries = 0;
	var converged = false;
	var i = 0;
	while i + 1 < g.n && tries < limit {
		tries++;
		if g.res[i] == g.res[i + 1] {
			converged = true;
			break;
		}
		i++;
	}
	g.steps += tries;
	out.i = tries;
	out.ok = converged;
	out.s.clear();
	if converged {
		format(out.s, "converged after ", tries, " tries");
	} else {
		format(out.s, "no convergence in ", tries, " retries");
	}
	out
}
@end
