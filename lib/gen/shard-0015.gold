code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if seen {
			if ${p}(x) {
				gold_cache_put(g, x, 1);
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " items");
	out
}
@end
@entry 5206b81ae81d895b
kind: step
verb: filter
noun: value
modifier: recursively
context: math
slot: factor int
phrase: filter values by repeatedly dividing by {factor}
phrase: reduce elements recursively by factor {factor}
test: list=12,18,20 factor=2
expect: => i=3 r=0.0 ok=true s="recursively reduced 3 values" errors=0 n=3 res=[3,9,5] cache=0 hits=0
test: list=27,9,15 factor=3
expect: => i=3 r=0.0 ok=true s="recursively reduced 3 values" errors=0 n=3 res=[1,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f <= 1 { return out; }
	for i in g.n {
		var x = g.res[i];
		while x > 0 && x % f == 0 {
			x /= f;
		}
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively reduced ", g.n, " values");
	out
}
@end
