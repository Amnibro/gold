code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	for k in g.n {
		if g.res[k] > c {
			g.res[k] = c;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped items count: ", clamped);
	out
}
@end
