fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gap_sum = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			var d = g.res[k + 1] - g.res[k];
			if d < 0 { d = -d; }
			gap_sum += d;
			k++;
		}
	}
	g.steps += g.n;
	out.i = gap_sum;
	out.s.clear();
	format(out.s, "total spacing sum: ", gap_sum);
	out
}
