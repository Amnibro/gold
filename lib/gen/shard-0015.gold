fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
		g.res[i] = sum;
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
