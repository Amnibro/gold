test: text="find best route"
expect: => i=5 r=0.0 ok=true s="last word: route" errors=0 n=0 res=[] cache=0 hits=0
test: text="query"
expect: => i=5 r=0.0 ok=true s="last word: query" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty text");
		return out;
	}
	var last_start = 0;
	var in_space = true;
	for b, idx in out.s {
		if b == ' ' || b == '\t' || b == '\n' {
			in_space = true;
		} else if in_space {
			in_space = false;
			last_start = idx;
		}
	}
	var word byte[>..] = [];
	for i in last_start..out.s.len {
		let b = out.s[i];
		if b == ' ' || b == '\t' || b == '\n' { break; }
		word.push(b);
	}
	g.steps += out.s.len;
	out.i = word.len;
	out.s.clear();
	format(out.s, "last word: ", word);
	out
}
@end
