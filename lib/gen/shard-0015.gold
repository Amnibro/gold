fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_pair = ${ceiling};
	var pairs = 0;
	var new_n = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s <= max_pair {
