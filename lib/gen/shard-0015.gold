phrase: normalize results sorted ascending
phrase: sort normalize results digits
test: arg=5281,302
expect: 1258
expect: 23
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 {
		return 0;
	}
	var counts = [0; 10];
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var out = 0;
	var d = 1;
	while d < 10 {
		var c = counts[d];
		while c > 0 {
			out = out * 10 + d;
			c--;
		}
		d++;
	}
	out
}
@end
@entry a6b2909315b712a4
kind: fn
verb: cache
noun: pairs
modifier: at_most
context: core
phrase: cache pairs at most limit {cap}
phrase: pair counter cached at most {cap}
slot: cap int
test: arg=11223,456 cap=5
expect: 2
expect: 0
test: arg=9999 cap=2
expect: 2
code:
fn ${ID}(n int) int {
	let lim = ${cap};
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return 0;
	}
	var count = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		if curr == prev {
			count++;
			if count >= lim {
				return lim;
			}
		}
		prev = curr;
		x /= 10;
	}
	count
}
@end
