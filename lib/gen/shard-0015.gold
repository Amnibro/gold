phrase: swap series pairs with block size {k} in loop
phrase: swap series blocks of length {k} across loop
slot: k int
test: list=1,2,3,4,5,6 k=2
expect: => i=4 r=0.0 ok=true s="swapped series across 4 items" errors=0 n=6 res=[3,4,1,2,5,6] cache=0 hits=0
test: list=10,20,30,40 k=1
expect: => i=4 r=0.0 ok=true s="swapped series across 4 items" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${k};
	if sz <= 0 || g.n < 2 * sz { return out; }
	var i = 0;
	while i + 2 * sz <= g.n {
		for j in sz {
			let tmp = g.res[i + j];
			g.res[i + j] = g.res[i + sz + j];
			g.res[i + sz + j] = tmp;
		}
		i += 2 * sz;
	}
	g.steps += i;
	out.i = i;
	out.s.clear();
	format(out.s, "swapped series across ", i, " items");
	out
}
@end
