fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need pair");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[i] = if a < b { a } else { b };
	}
	g.n--;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed ", g.n, " pairwise mins");
	out
}
@end
