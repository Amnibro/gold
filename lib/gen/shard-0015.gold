@entry 60899f86457cc2e0
kind: step
verb: split
noun: step
modifier: first
context: stats
phrase: partition sample around first step
phrase: split sample values relative to first element
test: list=20,10,30,5,25
expect: => i=3 r=0.0 ok=true s="split around pivot 20 with 3 below or equal" errors=0 n=5 res=[20,10,5,30,25] cache=0 hits=0
test: list=15,40,12,18
expect: => i=2 r=0.0 ok=true s="split around pivot 15 with 2 below or equal" errors=0 n=4 res=[15,12,40,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let pivot = g.res[0];
	var lo int[512] = [0; 512];
	var hi int[512] = [0; 512];
	var n_lo = 0;
	var n_hi = 0;
	for i in g.n {
		if g.res[i] <= pivot {
			lo[n_lo] = g.res[i];
			n_lo++;
		} else {
			hi[n_hi] = g.res[i];
			n_hi++;
		}
	}
	for i in n_lo { g.res[i] = lo[i]; }
	for j in n_hi { g.res[n_lo + j] = hi[j]; }
	g.steps += g.n;
	out.i = n_lo;
	out.ok = true;
	out.s.clear();
	format(out.s, "split around pivot ", pivot, " with ", n_lo, " below or equal");
	out
}
@end
