@entry 3aca4c888730bceb
kind: step
verb: search
noun: average
modifier: sorted
context: search
phrase: search average sorted position for target {val}
phrase: binary search for target {val} in sorted list
slot: val int
test: list=2,5,8,12,19 val=8
expect: => i=2 r=0.0 ok=true s="search position in sorted list: 2" errors=0 n=5 res=[2,5,8,12,19] cache=0 hits=0
test: list=10,20,30,40 val=25
expect: => i=2 r=0.0 ok=false s="search position in sorted list: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var lo = 0;
	var hi = g.n - 1;
	var found_idx = -1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == target {
			found_idx = mid;
			break;
		} else if g.res[mid] < target {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	out.ok = found_idx >= 0;
	out.i = if found_idx >= 0 { found_idx } else { lo };
	out.s.clear();
	format(out.s, "search position in sorted list: ", out.i);
	out
}
@end
