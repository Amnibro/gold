	gold_fnum(o, 2.0);
	o.append(":");
	gold_fnum(o, ${dist});
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "camrow");
	out
}
@end
