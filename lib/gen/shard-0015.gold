code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var found = false;
	var idx = -1;
	for i in g.n {
		if g.res[i] > limit {
			found = true;
			idx = i;
			out.i = g.res[i];
			break;
		}
	}
	g.steps += if idx >= 0 { idx + 1 } else { g.n };
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "found first value: ", out.i, " at index ", idx);
	} else {
		format(out.s, "no value found exceeding cutoff");
	}
	out
}
@end
