expect: => i=3 r=0.0 ok=true s="reversed up to: 2" errors=0 n=4 res=[6,4,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let end_idx = if lim < g.n { lim } else { g.n - 1 };
	var left = 0;
	var right = end_idx;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = end_idx + 1;
	out.s.clear();
	format(out.s, "reversed up to: ", end_idx);
	out
}
@end
