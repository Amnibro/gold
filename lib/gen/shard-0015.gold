code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let lo = ${lo};
	let hi = ${hi};
	if lo < 0 || hi >= g.n || lo >= hi { return out; }
	let tmp = g.res[lo];
	for i in lo..hi {
		g.res[i] = g.res[i + 1];
	}
	g.res[hi] = tmp;
	out.i = hi - lo;
	out.s.clear();
	format(out.s, "rotated head between bounds");
	out
}
@end
