kind: step
verb: retry
noun: odds
modifier: at_least
context: loop
phrase: retry odd values until at least {min_odds} collected in loop
phrase: ensure at least {min_odds} odd numbers in loop
slot: min_odds int
test: list=2,4,6,8 min_odds=2
expect: => i=2 r=0.0 ok=true s="odd count adjusted to 2" errors=0 n=4 res=[3,5,6,8] cache=0 hits=0
test: list=1,2,4,6 min_odds=3
expect: => i=3 r=0.0 ok=true s="odd count adjusted to 3" errors=0 n=4 res=[1,3,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_odds};
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 { odds++; }
	}
	for i in g.n {
		if odds >= req { break; }
		if g.res[i] % 2 == 0 {
			g.res[i] = g.res[i] + 1;
			odds++;
		}
	}
	g.steps += g.n;
	out.i = odds;
	out.s.clear();
	format(out.s, "odd count adjusted to ", odds);
	out
}
@end
