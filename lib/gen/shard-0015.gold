test: list=9,2,7,4,6,1
expect: => i=6 r=0.0 ok=true s="nested evens reversed: 6" errors=0 n=6 res=[1,6,4,2,7,9] cache=0 hits=0
test: list=10,3,8,5,2
expect: => i=5 r=0.0 ok=true s="nested evens reversed: 5" errors=0 n=5 res=[10,3,5,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		while left < right && g.res[left] % 2 != 0 { left++; }
		while left < right && g.res[right] % 2 != 0 { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested evens reversed: ", g.n);
	out
}
@end
