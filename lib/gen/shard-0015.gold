fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s_b = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.2 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
