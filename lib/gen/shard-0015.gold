code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_filter_words_each = 0;
	out.s.clear();
	format(out.s, "words: [");
	var cur byte[..32] = "";
	var word_cnt = 0;
	for i in v.s.len {
		let b = v.s[i];
		if b == ' ' {
			if cur.len > 0 {
				if word_cnt > 0 { format(out.s, ", "); }
				format(out.s, cur, "(", cur.len, ")");
				word_cnt++;
				cur.clear();
			}
		} else {
			if cur.len < 32 { cur.push(b); }
		}
	}
	if cur.len > 0 {
		if word_cnt > 0 { format(out.s, ", "); }
		format(out.s, cur, "(", cur.len, ")");
		word_cnt++;
	}
	format(out.s, "]");
	out.i = word_cnt;
	g.steps += word_cnt;
	out
}
@end
