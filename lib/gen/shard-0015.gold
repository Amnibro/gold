fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no item yet"); out.ok = false; return out; }
	o.push(' ');
