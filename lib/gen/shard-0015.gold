code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${w};
	if count > g.n { count = g.n; }
	var sum = 0;
	var i = g.n - count;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	gold_push(g, avg);
	out.i = avg;
	g.steps += count;
	out.s.clear();
	format(out.s, "shifted average computed");
	out
}
@end
