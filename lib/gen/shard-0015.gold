expect: => i=3 r=0.0 ok=true s="reversed suffix from: 2" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
test: list=7,1,9,3 k=1
expect: => i=3 r=0.0 ok=true s="reversed suffix from: 1" errors=0 n=4 res=[1,9,7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if idx >= 0 && idx < g.n {
		var left = idx;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = g.n - idx;
	out.s.clear();
	format(out.s, "reversed suffix from: ", idx);
	out
}
@end
