expect: => i=9 r=0.0 ok=false s="head value: 9" errors=0 n=3 res=[9,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let head_val = if g.n > 0 { g.res[0] } else { 0 };
	let ok = head_val >= l && head_val <= h;
	g.steps += g.n;
	out.ok = ok;
	out.i = head_val;
	out.s.clear();
	format(out.s, "head value: ", head_val);
	out
}
@end
@entry b65d81eab0f54862
kind: step
verb: map
noun: budget
modifier: until
context: sort
slot: budget int
phrase: map sorted items accumulating values until budget {budget}
phrase: collect sorted sequence until total reaches budget {budget}
test: list=10,2,5,1,8 budget=12
expect: => i=8 r=0.0 ok=true s="accumulated budget: 8" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=7,3,4,20 budget=10
expect: => i=7 r=0.0 ok=true s="accumulated budget: 7" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	var kept = 0;
	for k in g.n {
		if sum + g.res[k] <= b {
			sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "accumulated budget: ", sum);
	out
}
@end
