fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_len = 0;
	for b in v.s {
		if b == ' ' { break; }
		word_len++;
	}
	var scaled = 0;
	for i in g.n {
		if g.res[i] == word_len {
			g.res[i] = g.res[i] * 2;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " matching words");
	out
}
@end
