expect: => doc: torso bone 0,0,0.8 0,0,1.3
expect: => doc: head2 bone 0,0,1.5 0,0,1.8 ^torso
test: h=1.7 doc="torso bone 0,0,0.8 0,0,1.3|neck bone 0,0,1.3 0,0,1.5 ^torso"
expect: => i=3 r=0.0 ok=true s="headnone" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: torso bone 0,0,0.8 0,0,1.3
expect: => doc: neck bone 0,0,1.3 0,0,1.5 ^torso
expect: => doc: head3 bone 0,0,1.5 0,0,1.7 ^neck
test: h=1.4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnews(g, "head", "", o);
	o.append(" bone 0,0,");
	o.append("1.5 ");
	o.append("0,0,");
	gold_fnum(o, ${h});
	o.append(" ^");
	o.append(last);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "headnone");
	out
}
@end
