noun: window
modifier: unique
context: search
slot: win_size int
phrase: filter window unique items across size {win_size}
phrase: prune search window unique items span {win_size}
test: list=1,2,2,3,4,4,5 win_size=3
expect: => i=3 r=0.0 ok=true s="filtered window unique count: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,10,20,30 win_size=2
expect: => i=2 r=0.0 ok=true s="filtered window unique count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var kept = 0;
	for i in g.n {
		if kept >= ws { break; }
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered window unique count: ", kept);
	out
}
@end
