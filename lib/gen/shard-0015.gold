@entry 458aed147f6b7c98
kind: step
verb: apply
noun: letters
modifier: with_cache
context: list
phrase: transform sequence elements through cached function {f}
phrase: apply cached evaluation function {f} across items
slot: f fn
test: list=2,2,3 f=double
expect: => i=1 r=0.0 ok=true s="hits 1" errors=0 n=3 res=[4,4,6] cache=2 hits=1
test: list=5,5,5,5 f=inc
expect: => i=3 r=0.0 ok=true s="hits 3" errors=0 n=4 res=[6,6,6,6] cache=1 hits=3
test: f=double
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let computed = ${f}(x);
			gold_cache_put(g, x, computed);
			g.res[i] = computed;
		}
	}
	out.i = g.hits;
	out.s.clear();
	format(out.s, "hits ", g.hits);
	out
}
@end
