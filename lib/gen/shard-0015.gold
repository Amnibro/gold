@entry 149fb6a463a4ab54
kind: step
verb: rank
noun: evens
modifier: first
context: search
phrase: rank evens first placing even search items ahead
phrase: partition search items placing evens first
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="evens partitioned count: 3" errors=0 n=6 res=[2,4,6,1,3,5] cache=0 hits=0
test: list=7,9,2,4
expect: => i=2 r=0.0 ok=true s="evens partitioned count: 2" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var en = 0;
	var on = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[en] = g.res[k];
			en++;
		} else {
			odds[on] = g.res[k];
			on++;
		}
	}
	for i in en { g.res[i] = evens[i]; }
	for j in on { g.res[en + j] = odds[j]; }
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "evens partitioned count: ", en);
	out
}
@end
@entry a2a1d8d7346cb915
kind: step
verb: return
noun: duplicates
modifier: with_retry
context: search
slot: fallback int
phrase: return duplicates with retry fallback value {fallback}
phrase: collect duplicates with retry using fallback {fallback}
test: list=1,2,2,3 fallback=99
expect: => i=1 r=0.0 ok=true s="duplicates with fallback count: 1" errors=0 n=1 res=[2] cache=0 hits=0
test: list=1,2,3 fallback=99
expect: => i=1 r=0.0 ok=true s="duplicates with fallback count: 1" errors=0 n=1 res=[99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var seen = false;
			for k in kept {
				if g.res[k] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	if kept == 0 {
		g.res[0] = fb;
		kept = 1;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "duplicates with fallback count: ", kept);
	out
}
@end
@entry 9e69b64d10e41b8c
