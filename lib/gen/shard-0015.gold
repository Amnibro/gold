expect: => i=3 r=0.0 ok=true s="runs mapped: 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var rcnt = 0;
	var i = 0;
	while i < g.n {
		var rlen = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			rlen++;
			i++;
		}
		g.res[rcnt] = rlen;
		rcnt++;
		i++;
	}
	g.n = rcnt;
	g.steps += g.n;
	out.i = rcnt;
	out.s.clear();
	format(out.s, "runs mapped: ", rcnt);
	out
}
@end
