expect: => i=1 r=0.0 ok=true s="head matched remaining: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	while g.n > 0 && !${cond}(g.res[0]) {
		var k = 0;
		while k + 1 < g.n {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.n--;
		shifts++;
	}
	if g.n == 0 {
		gold_fail(g, "retry head: none matched");
		out.ok = false;
	}
	g.steps += shifts;
	out.i = g.n;
	out.s.clear();
	format(out.s, "head matched remaining: ", g.n);
	out
}
@end
