code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if r > 0 && r < g.n {
		var i = g.n - 1;
		while i >= r {
			g.res[i] = g.res[i] - g.res[i - r];
			i--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "window differences computed in place");
	out
}
@end
