@entry f3fc4f330c866da7
kind: step
verb: run
noun: primes
modifier: unique
context: stats
phrase: run primes unique deduplication filter
phrase: extract distinct prime values in sample
test: list=2,3,2,5,4,3
expect: => i=3 r=0.0 ok=true s="unique primes kept: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,7,11,9
expect: => i=2 r=0.0 ok=true s="unique primes kept: 2" errors=0 n=2 res=[7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				var exists = false;
				for j in kept {
					if g.res[j] == x { exists = true; break; }
				}
				if !exists {
					g.res[kept] = x;
					kept++;
				}
			}
		}
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique primes kept: ", kept);
	out
}
@end
