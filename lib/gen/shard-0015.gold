fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ctr = 1;
	var i = 0;
	while i < g.n {
		g.res[i] += ctr;
		ctr++;
		i += 2;
	}
	g.steps += g.n;
	out.i = ctr - 1;
	out.s.clear();
	format(out.s, "merged counter across ", out.i, " elements");
	out
}
