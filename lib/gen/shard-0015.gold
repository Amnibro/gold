fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[64] = [0; 64];
	var count = 0;
	for b in out.s {
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			if count < 64 {
				vowels[count] = b;
			count++;
			}
		}
	}
	out.s.clear();
	var i = count - 1;
	while i >= 0 {
		out.s.push(vowels[i]);
		i--;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
