test: list=5,5,10,15,15,20
expect: => i=2 r=0.0 ok=true s="paired unique sums: 2" errors=0 n=2 res=[15,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var uniq: int[256];
	var un = 0;
	uniq[un] = g.res[0];
	un++;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			uniq[un] = g.res[i];
			un++;
		}
	}
	var pairs: int[256];
	var pn = 0;
	var i = 0;
	while i < un {
		if i + 1 < un {
			pairs[pn] = uniq[i] + uniq[i + 1];
			pn++;
			i += 2;
		} else {
			pairs[pn] = uniq[i];
			pn++;
			i++;
		}
	}
	g.n = 0;
	for k in pn {
		gold_push(g, pairs[k]);
	}
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "paired unique sums: ", pn);
	out
}
@end
