	if !gold_dlast(g, last) { out.ok = false; return out; }
	o.append(last);
	o.append(".loc anim ");
	gold_fnum(o, 0.0);
	o.append(":");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
