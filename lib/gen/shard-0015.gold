fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	for i in v.s.len {
		if i > 0 { o.append(${sep}); }
		o.push(v.s[i]);
	}
	out.s.clear();
	for b in o { out.s.push(b); }
	g.steps += v.s.len;
	out.i = out.s.len;
	out
}
@end
