expect: 0
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	let lim = ${limit};
	var out = 0;
	var place = 1;
	var keep = true;
	while val > 0 && keep {
		let d = val % 10;
		if d > lim {
			out += d * place;
			place *= 10;
			val /= 10;
		} else {
			keep = false;
		}
	}
	out
}
@end
