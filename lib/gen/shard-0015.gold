fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var bound = d;
	if bound > g.n { bound = g.n; }
	var running = 0;
	for i in bound {
		running += g.res[i];
		gold_cache_put(g, i, running);
	}
	g.steps += bound;
	out.i = running;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled cache recursively to depth ", bound);
	out
}
@end
