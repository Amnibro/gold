test: list=5,25,125
expect: => i=6 r=0.0 ok=true s="counted 6 digits in loop" errors=0 n=3 res=[5,25,125] cache=0 hits=0
test: list=7,89,1001,42
expect: => i=9 r=0.0 ok=true s="counted 9 digits in loop" errors=0 n=4 res=[7,89,1001,42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 {
			d++;
			x /= 10;
		}
		total += d;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "counted ", total, " digits in loop");
	out
}
@end
