fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var in_bounds = true;
	var violations = 0;
	for i in g.n {
		let x = g.res[i];
		if x < lo || x > hi {
			in_bounds = false;
			violations++;
		}
	}
	g.steps += g.n;
	out.i = violations;
	out.ok = in_bounds;
	out.s.clear();
	if in_bounds {
		format(out.s, "all ", g.n, " values within range");
	} else {
		format(out.s, "found ", violations, " values outside range");
	}
	out
}
