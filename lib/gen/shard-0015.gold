expect: => i=0 r=0.0 ok=true s="swapped across limit: true" errors=0 n=4 res=[8,3,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var first_over = -1;
	var last_under = -1;
	for i in g.n {
		if g.res[i] > lim && first_over == -1 { first_over = i; }
		if g.res[i] <= lim { last_under = i; }
	}
	var swapped = false;
	if first_over != -1 && last_under != -1 && first_over != last_under {
		let tmp = g.res[first_over];
		g.res[first_over] = g.res[last_under];
		g.res[last_under] = tmp;
		swapped = true;
	}
	g.steps += g.n;
	out.ok = swapped;
	out.s.clear();
	format(out.s, "swapped across limit: ", swapped);
	out
}
@end
@entry d8d3851f08892089
kind: step
verb: select
noun: budget
modifier: last
context: transform
slot: budget int
phrase: select last items fitting within budget {budget}
phrase: take trailing elements within budget {budget}
test: list=10,20,5,3,2 budget=12
expect: => i=10 r=0.0 ok=true s="selected 3 items sum 10" errors=0 n=3 res=[5,3,2] cache=0 hits=0
test: list=50,15,10,5 budget=25
expect: => i=15 r=0.0 ok=true s="selected 2 items sum 15" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	var i = g.n - 1;
	let b = ${budget};
	while i >= 0 && sum + g.res[i] <= b {
		sum += g.res[i];
		count++;
		i--;
	}
	let start = g.n - count;
	for j in count {
		g.res[j] = g.res[start + j];
	}
	g.n = count;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "selected ", count, " items sum ", sum);
	out
}
@end
@entry f8e47de31e24f03c
kind: step
verb: retry
noun: gaps
modifier: times
context: transform
slot: times int
slot: max_gap int
phrase: retry adjusting gaps {times} times under {max_gap}
phrase: smooth spacing gaps {times} times within {max_gap}
test: list=2,10,12,25 times=2 max_gap=5
expect: => i=2 r=0.0 ok=true s="adjusted 2 gap points" errors=0 n=4 res=[2,7,12,17] cache=0 hits=0
test: list=1,20,22,50 times=3 max_gap=10
expect: => i=3 r=0.0 ok=true s="adjusted 3 gap points" errors=0 n=4 res=[1,11,21,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	let mg = ${max_gap};
	var adjusted = 0;
	for r in reps {
		if g.n > 1 {
			for i in 0..(g.n - 1) {
				let gap = g.res[i + 1] - g.res[i];
				if gap > mg {
					g.res[i + 1] = g.res[i] + mg;
					adjusted++;
				}
			}
		}
	}
	g.steps += reps * g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted ", adjusted, " gap points");
	out
}
@end
@entry a1166d0750407e87
kind: step
verb: map
noun: window
modifier: with_retry
context: transform
slot: size int
slot: f fn
phrase: map rolling window of size {size} using {f}
phrase: transform window of size {size} with {f}
test: list=1,2,3,4,5 size=2 f=double
expect: => i=4 r=0.0 ok=true s="mapped 4 window outputs" errors=0 n=4 res=[6,10,14,18] cache=0 hits=0
test: list=10,20,30,40 size=3 f=inc
expect: => i=2 r=0.0 ok=true s="mapped 2 window outputs" errors=0 n=2 res=[61,91] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = max(1, ${size});
	var new_n = 0;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		g.res[new_n] = ${f}(sum);
		new_n++;
		i++;
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "mapped ", new_n, " window outputs");
	out
}
@end
