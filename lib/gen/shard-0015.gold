fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_join_streak_pairwise = 0;
	out.s.clear();
	format(out.s, "streaks: [");
	var i = 0;
	var streak_cnt = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			run_len++;
			i++;
		}
		if streak_cnt > 0 { format(out.s, ", "); }
		format(out.s, val, "x", run_len);
		streak_cnt++;
		i++;
	}
	format(out.s, "]");
	out.i = streak_cnt;
	g.steps += g.n;
	out
}
