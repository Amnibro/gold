test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="collected 3 consecutive run lengths" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var runs int[512] = [0; 512];
	var n_runs = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			runs[n_runs] = cur_len;
			n_runs++;
			cur_len = 1;
		}
	}
	runs[n_runs] = cur_len;
	n_runs++;
	for i in n_runs { g.res[i] = runs[i]; }
	g.steps += g.n;
	g.n = n_runs;
	out.i = n_runs;
	out.ok = true;
	out.s.clear();
	format(out.s, "collected ", n_runs, " consecutive run lengths");
	out
}
@end
@entry 6f31c5282120bc34
kind: step
verb: shift
noun: range
modifier: nested
context: stats
phrase: shift sample values by nested window range radius {radius}
phrase: adjust elements using nested local range with radius {radius}
slot: radius int
test: list=10,25,15 radius=1
expect: => i=3 r=0.0 ok=true s="shifted 3 elements by nested window range" errors=0 n=3 res=[-5,10,5] cache=0 hits=0
test: list=20,20 radius=1
expect: => i=2 r=0.0 ok=true s="shifted 2 elements by nested window range" errors=0 n=2 res=[20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if g.n == 0 { return out; }
	var shifted int[512] = [0; 512];
	for i in g.n {
		var start = i - r;
		if start < 0 { start = 0; }
		var finish = i + r;
		if finish >= g.n { finish = g.n - 1; }
		var mn = g.res[start];
		var mx = g.res[start];
		for k in (start + 1)..(finish + 1) {
			if g.res[k] < mn { mn = g.res[k]; }
			if g.res[k] > mx { mx = g.res[k]; }
		}
		let rng = mx - mn;
		shifted[i] = g.res[i] - rng;
	}
	for i in g.n { g.res[i] = shifted[i]; }
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted ", g.n, " elements by nested window range");
	out
}
@end
