fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j - 1];
			g.res[j - 1] = g.res[j];
			g.res[j] = tmp;
			j--;
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[i] = g.res[i] * mult;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " sorted evens");
	out
}
