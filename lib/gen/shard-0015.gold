@entry 90021ab0b9c65107
kind: step
verb: merge
noun: middle
modifier: safely
context: stats
phrase: merge middle safely trimming ends by {trim}
phrase: combine central values safely excluding {trim} extremes
slot: trim int
test: list=1,10,20,30,100 trim=1
expect: => i=60 r=0.0 ok=true s="merged middle 3 items sum: 60" errors=0 n=5 res=[1,10,20,30,100] cache=0 hits=0
test: list=5,10,20,30,40,95 trim=2
expect: => i=50 r=0.0 ok=true s="merged middle 2 items sum: 50" errors=0 n=6 res=[5,10,20,30,40,95] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${trim};
	if g.n <= 2 * t {
		out.ok = false;
		out.s.clear();
		format(out.s, "not enough elements to trim");
		return out;
	}
	var sum = 0;
	var count = 0;
	let stop = g.n - t;
	for i in g.n {
		if i >= t && i < stop {
			sum += g.res[i];
			count++;
		}
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged middle ", count, " items sum: ", sum);
	out
}
@end
@entry 89df81487c9922d3
kind: step
verb: scale
noun: list
modifier: recursively
context: stats
phrase: scale list recursively dividing by {divisor}
phrase: reduce dataset elements recursively using divisor {divisor}
slot: divisor int
test: list=16,32,64 divisor=2
expect: => i=3 r=0.0 ok=true s="recursively reduced elements total: 3" errors=0 n=3 res=[1,1,1] cache=0 hits=0
test: list=27,81 divisor=3
expect: => i=2 r=0.0 ok=true s="recursively reduced elements total: 2" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${divisor};
	if div <= 1 {
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 0 && x % div == 0 {
			x /= div;
		}
		g.res[i] = x;
		total += x;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "recursively reduced elements total: ", total);
	out
}
@end
