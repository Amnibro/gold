expect: => i=1 r=0.0 ok=true s="max run 1" errors=0 n=4 res=[1,2,3,4] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_run = 1;
	var cur_run = 1;
	for i in (g.n - 1) {
		if g.res[i + 1] == g.res[i] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			gold_cache_put(g, g.res[i], cur_run);
			cur_run = 1;
		}
	}
	gold_cache_put(g, g.res[g.n - 1], cur_run);
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "max run ", max_run);
	out
}
@end
