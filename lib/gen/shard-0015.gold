	gold_fnum(o, 0.5);
	o.append(",");
	gold_fnum(o, 4.0);
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" m:matte");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "scattall");
	out
}
@end
