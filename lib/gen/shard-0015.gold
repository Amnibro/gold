@entry c57d510dfbc29c31
kind: step
verb: rank
noun: limit
modifier: each
context: cache
phrase: rank each item up to limit {lim} by frequency
phrase: score each entry within limit {lim} into cache
slot: lim int
test: list=1,2,2,3,3,3 lim=3
expect: => i=3 r=0.0 ok=true s="ranked 3 items" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=0
test: list=5,5,8,8,8 lim=2
expect: => i=2 r=0.0 ok=true s="ranked 2 items" errors=0 n=5 res=[5,5,8,8,8] cache=2 hits=0
test: list=10,20,30 lim=0
expect: => i=0 r=0.0 ok=true s="ranked 0 items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var ranked = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen && ranked < limit {
			var freq = 0;
			for k in g.n { if g.res[k] == x { freq++; } }
			gold_cache_put(g, x, freq);
			ranked++;
		}
	}
	g.steps += g.n * g.n;
	out.i = ranked;
	out.s.clear();
	format(out.s, "ranked ", ranked, " items");
	out
}
@end
