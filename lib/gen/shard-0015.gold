@entry 7dbbfcbc6ac93815
kind: step
verb: sort
noun: pairs
modifier: until
context: format
phrase: format pair list sorted until index {stop}
phrase: render pairs sorted up to limit index {stop}
slot: stop int
test: list=8,2,6,4,1,9 stop=3
expect: => i=1 r=0.0 ok=true s="sorted_pairs: [2-6]" errors=0 n=6 res=[8,2,6,4,1,9] cache=0 hits=0
test: list=10,5,20,15 stop=2
expect: => i=1 r=0.0 ok=true s="sorted_pairs: [5-10]" errors=0 n=4 res=[10,5,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_sort_pairs_until = 0;
	out.s.clear();
	let limit = if ${stop} < g.n { ${stop} } else { g.n };
	var buf int[64] = [0; 64];
	for i in limit { buf[i] = g.res[i]; }
	// sort up to limit
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if buf[j] < buf[i] {
				let t = buf[i];
				buf[i] = buf[j];
				buf[j] = t;
			}
			j++;
		}
		i++;
	}
	format(out.s, "sorted_pairs: [");
	var k = 0;
	var pc = 0;
	while k + 1 < limit {
		if pc > 0 { format(out.s, ", "); }
		format(out.s, buf[k], "-", buf[k + 1]);
		pc++;
		k += 2;
	}
	format(out.s, "]");
	out.i = pc;
	g.steps += limit;
	out
}
@end
