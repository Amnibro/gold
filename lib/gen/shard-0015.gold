fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found_idx = -1;
	for k in g.n {
		if g.res[k] == t {
			found_idx = k;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "target found at index: ", found_idx);
	out
}
@end
