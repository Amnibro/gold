@entry b49d8f537960267a
kind: step
verb: find
noun: loop
modifier: while
context: error
slot: max_steps int
phrase: find error cycle loop while tracing step limit {max_steps}
phrase: detect fault recurrence loop while under limit {max_steps}
test: list=2,4,2,4,2 max_steps=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,2,4,2] cache=0 hits=0
test: list=1,2,3,4,5 max_steps=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_steps};
	var found = false;
	var i = 0;
	while i < g.n && i < limit {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				found = true;
				break;
			}
			j++;
		}
		if found { break; }
		i++;
	}
	if !found {
		gold_fail(g, "no repeating loop found in errors");
	}
	g.steps += i;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out
}
@end
