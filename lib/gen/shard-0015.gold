		gold_fail(g, "cannot average empty error list");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	gold_cache_put(g, slot, avg);
	g.steps += g.n;
	out.i = avg;
	out
}
