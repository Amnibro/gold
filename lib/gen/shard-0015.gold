phrase: filter minimum values until count reaches {limit}
phrase: drop smallest elements until count reaches {limit}
test: list=8,2,6,1,9 limit=3
expect: => i=3 r=0.0 ok=true s="reduced to 3 items" errors=0 n=3 res=[8,6,9] cache=0 hits=0
test: list=5,4,3 limit=2
expect: => i=2 r=0.0 ok=true s="reduced to 2 items" errors=0 n=2 res=[5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	while g.n > lim && g.n > 0 {
		var min_idx = 0;
		for i in 1..g.n {
			if g.res[i] < g.res[min_idx] { min_idx = i; }
		}
		var j = min_idx;
		while j + 1 < g.n {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n--;
		g.steps += g.n;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reduced to ", g.n, " items");
	out
}
@end
