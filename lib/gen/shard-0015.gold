code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var diffs int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			var d = g.res[j] - g.res[i];
			if d < 0 { d = -d; }
			if count < 512 {
				diffs[count] = d;
				count++;
			}
		}
	}
	for k in count { g.res[k] = diffs[k]; }
	g.steps += count;
	g.n = count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "collected ", count, " nested pairwise differences");
	out
}
@end
