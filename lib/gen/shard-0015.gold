phrase: pair adjacent items up to limit {limit}
phrase: group items into pairs up to {limit}
test: list=1,2,3,4,5,6 limit=2
expect: => i=2 r=0.0 ok=true s="paired 2 items" errors=0 n=4 res=[3,7,5,6] cache=0 hits=0
