test: list=20,5 lo=10 hi=15
expect: => i=2 r=0.0 ok=true s="clamped 2 sorted items" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let l = ${lo};
	let h = ${hi};
	for i in g.n {
		if g.res[i] < l { g.res[i] = l; }
		else if g.res[i] > h { g.res[i] = h; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped ", g.n, " sorted items");
	out
}
@end
