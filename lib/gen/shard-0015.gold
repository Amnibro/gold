code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if low > high {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] < low {
			g.res[i] = low;
			count++;
		} else if g.res[i] > high {
			g.res[i] = high;
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "clamped ", count, " items");
	out
}
@end
@entry 022430898312c534
kind: step
verb: group
noun: subfunction
modifier: any
context: list
phrase: partition sequence by predicate {p}
phrase: group elements matching condition {p} to front
slot: p pred
test: list=1,2,3,4,5 p=is_even
expect: => i=2 r=0.0 ok=true s="partitioned 2 matches" errors=0 n=5 res=[2,4,1,3,5] cache=0 hits=0
test: list=1,3,5 p=is_even
expect: => i=0 r=0.0 ok=true s="partitioned 0 matches" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: p=is_even
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var pass_arr int[512] = [0; 512];
	var mn = 0;
	var rest int[512] = [0; 512];
	var rn = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			pass_arr[mn] = g.res[i];
			mn++;
		} else {
			rest[rn] = g.res[i];
			rn++;
		}
	}
	for i in mn {
		g.res[i] = pass_arr[i];
	}
	for i in rn {
		g.res[mn + i] = rest[i];
	}
	out.i = mn;
	out.s.clear();
	format(out.s, "partitioned ", mn, " matches");
	out
}
@end
