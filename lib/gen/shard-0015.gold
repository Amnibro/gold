	if g.n == 0 { return out; }
	let tgt = ${target};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	out.i = avg;
	out.ok = avg == tgt;
	out.s.clear();
	if avg == tgt {
		format(out.s, "average matches target ", tgt);
	} else {
		format(out.s, "average ", avg, " differs from target");
	}
	g.steps += g.n;
	out
}
