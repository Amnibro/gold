verb: revolve
noun: pulley
modifier: hollow
context: cad
slot: r real
slot: a real
slot: h real
phrase: revolve hollow pulley cylinder bore {r} outer {a} width {h}
phrase: turned hollow pulley wheel inner {r} outside {a} thick {h}
test: r=0.015 a=0.05 h=0.02
expect: => i=1 r=0.0 ok=true s="pulley" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: pulley1 tube 0,0,0 0,0,0.02 r0.015 r0.05 m:metal
test: r=0.02 a=0.07 h=0.025 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="pulley" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: pulley3 tube 0,0,0 0,0,0.025 r0.02 r0.07 m:metal
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "pulley", "", o);
	o.append(" tube ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(" ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" r");
	gold_fnum(o, ${a});
	o.append(" m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "pulley");
	out
}
@end
