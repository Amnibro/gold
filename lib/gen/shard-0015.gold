@entry dc6cbd3c05f97060
kind: step
verb: retry
noun: item
modifier: each
context: sort
slot: factor int
phrase: retry processing each item in sorted sequence with factor {factor}
phrase: evaluate retry on each sorted item scaled by {factor}
test: list=6,2,8,4 factor=2
expect: => i=4 r=0.0 ok=true s="each item retried: 4" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
test: list=15,5,10 factor=3
expect: => i=16 r=0.0 ok=true s="each item retried: 16" errors=0 n=3 res=[16,30,46] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for k in g.n {
		var x = g.res[k] * mul;
		if x % 2 != 0 { x++; }
		g.res[k] = x;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "each item retried: ", out.i);
	out
}
@end
