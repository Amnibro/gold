code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var span = c;
	if span > g.n { span = g.n; }
	let offset = g.n - span;
	for k in span {
		g.res[k] = g.res[offset + k];
	}
	g.n = span;
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "tail slice retained: ", span);
	out
}
@end
