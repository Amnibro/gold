fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	${ID}_clean(out.s, 0, g);
	g.steps += out.s.len;
	out.i = g.errors;
	out
}
recursive fn ${ID}_clean(s byte[..200]&, idx int, g Gold&) {
	if idx >= s.len { return; }
	if s[idx] == '#' {
		s[idx] = ' ';
		gold_fail(g, "replaced illegal character in error text");
	}
	${ID}_clean(s, idx + 1, g);
}
@end
