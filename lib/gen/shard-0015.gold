	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
		i++;
	}
	g.steps += g.n;
	out.i = best;
	out.s.clear();
	format(out.s, "streak measured");
	out
}
