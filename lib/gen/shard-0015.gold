expect: => i=6 r=0.0 ok=true s="every other repeated length: 6" errors=0 n=6 res=[1,1,2,3,3,4] cache=0 hits=0
test: list=10,20,30
expect: => i=5 r=0.0 ok=true s="every other repeated length: 5" errors=0 n=5 res=[10,10,20,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var expanded int[512] = [0; 512];
	var en = 0;
	var k = 0;
	while k < g.n {
		expanded[en] = g.res[k];
		en++;
		expanded[en] = g.res[k];
		en++;
		if k + 1 < g.n {
			expanded[en] = g.res[k + 1];
			en++;
		}
		k += 2;
	}
	for i in en { g.res[i] = expanded[i]; }
	g.n = en;
	g.steps += en;
	out.i = en;
	out.s.clear();
	format(out.s, "every other repeated length: ", en);
	out
}
@end
