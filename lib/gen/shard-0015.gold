expect: => i=7 r=0.0 ok=true s="checkpoint value: 7" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=15,3,8 k=1
expect: => i=8 r=0.0 ok=true s="checkpoint value: 8" errors=0 n=3 res=[3,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let chk = if idx >= 0 && idx < g.n { g.res[idx] } else { 0 };
	g.steps += g.n;
	out.i = chk;
	out.s.clear();
	format(out.s, "checkpoint value: ", chk);
	out
}
@end
