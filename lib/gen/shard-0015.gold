expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${steps} <= 0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "terrace", "", o);
	o.append(" box 0,0,");
	gold_fnum(o, ${steps} as real * 0.25);
	o.append(" 10,");
	o.append("10,");
	o.append("0.5 m:matte #");
	o.append("5a7d");
	o.append("40");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "terrace");
	out
}
@end
