phrase: group checkpoint while processing blocks of {chunk}
phrase: batch loop elements by checkpoint size {chunk}
test: list=1,2,3,4,5,6 chunk=3
expect: => i=2 r=0.0 ok=true s="checkpoints grouped" errors=0 n=8 res=[1,2,3,4,5,6,6,15] cache=0 hits=0
test: list=10,20,30,40 chunk=2
expect: => i=3 r=0.0 ok=true s="checkpoints grouped" errors=0 n=7 res=[10,20,30,40,30,70,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch <= 0 { gold_fail(g, "bad chunk"); out.ok = false; return out; }
	var i = 0;
	var groups = 0;
	while i + ch <= g.n {
		var sum = 0;
		for j in ch { sum += g.res[i + j]; }
		gold_push(g, sum);
		groups++;
		i += ch;
	}
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "checkpoints grouped");
	out
}
@end
