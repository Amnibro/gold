expect: => i=1 r=0.0 ok=true s="paired 1 odd pairs" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[on] = g.res[i];
			on++;
		}
	}
	let max_pairs = min(${limit}, on / 2);
	for i in max_pairs {
		g.res[i] = odds[2 * i] + odds[2 * i + 1];
	}
	g.n = max_pairs;
	g.steps += on;
	out.i = max_pairs;
	out.s.clear();
	format(out.s, "paired ", max_pairs, " odd pairs");
	out
}
@end
