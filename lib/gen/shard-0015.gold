fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		i += 2;
	}
	g.steps += i;
	out.i = i;
	out.s.clear();
	format(out.s, "swapped ", i, " values");
	out
}
@end
