@entry f0468b496ef58117
kind: step
verb: sum
noun: window
modifier: nested
context: stats
phrase: sum window nested size {win_len}
phrase: calculate moving window sums of size {win_len}
slot: win_len int
test: list=1,2,3,4 win_len=2
expect: => i=3 r=0.0 ok=true s="window sums count: 3" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=2,4,6,8,10 win_len=3
expect: => i=3 r=0.0 ok=true s="window sums count: 3" errors=0 n=3 res=[12,18,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_len};
	if w <= 0 || g.n < w {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient sample window");
		return out;
	}
	let count = g.n - w + 1;
	for i in count {
		var sum_w = 0;
		for j in w {
			sum_w += g.res[i + j];
		}
		g.res[i] = sum_w;
	}
	g.n = count;
	g.steps += count * w;
	out.i = count;
	out.s.clear();
	format(out.s, "window sums count: ", count);
	out
}
@end
