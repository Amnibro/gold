fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var uniq: int[256];
	var un = 0;
	uniq[un] = g.res[0] * g.res[0];
	un++;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			uniq[un] = g.res[i] * g.res[i];
			un++;
		}
	}
	g.n = 0;
	var idx = un - 1;
	while idx >= 0 {
		gold_push(g, uniq[idx]);
		idx--;
	}
	g.steps += un;
	out.i = un;
	out.s.clear();
	format(out.s, "reversed unique squares: ", un);
	out
}
@end
