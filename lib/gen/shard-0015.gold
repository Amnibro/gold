fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var violations = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] % 2 != 0 && g.res[i - 1] % 2 != 0 {
			let s = g.res[i] + g.res[i - 1];
			if s > limit {
				violations++;
				gold_fail(g, "odd pair sum exceeds ceiling");
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = violations;
	out
}
