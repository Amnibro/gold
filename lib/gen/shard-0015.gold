@entry 08d067128cebead6
kind: step
verb: swap
noun: gaps
modifier: unique
context: list
phrase: swap gaps unique minimum with maximum spacing in list
phrase: list swap gaps unique extreme difference positions
test: list=2,10,12,3
expect: => i=9 r=0.0 ok=true s="swapped largest gap: 9" errors=0 n=4 res=[2,10,3,12] cache=0 hits=0
test: list=5,6,20,21
expect: => i=14 r=0.0 ok=true s="swapped largest gap: 14" errors=0 n=4 res=[5,20,6,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best_gap = 0;
	var best_idx = -1;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			var d = g.res[k + 1] - g.res[k];
			if d < 0 { d = -d; }
			if d > best_gap {
				best_gap = d;
				best_idx = k;
			}
			k++;
		}
		if best_idx >= 0 {
			let tmp = g.res[best_idx];
			g.res[best_idx] = g.res[best_idx + 1];
			g.res[best_idx + 1] = tmp;
		}
	}
	g.steps += g.n;
	out.i = best_gap;
	out.s.clear();
	format(out.s, "swapped largest gap: ", best_gap);
	out
}
@end
