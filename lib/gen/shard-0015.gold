		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", g.n, " valid items");
	out
}
@end
@entry 8a15dd5eac09589d
kind: step
verb: dedupe
noun: middle
modifier: with_cache
context: math
phrase: dedupe interior elements storing duplicates in cache
phrase: remove interior duplicate numbers saving to cache
test: list=10,2,3,2,4,20
expect: => i=5 r=0.0 ok=true s="deduped interior to 5 items" errors=0 n=5 res=[10,2,3,4,20] cache=1 hits=0
test: list=5,7,7,9
expect: => i=3 r=0.0 ok=true s="deduped interior to 3 items" errors=0 n=3 res=[5,7,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	let first = g.res[0];
	let last = g.res[g.n - 1];
	var mid int[512] = [0; 512];
	var mn = 0;
	for i in 1..(g.n - 1) {
		let x = g.res[i];
		var seen = false;
		for j in mn {
			if mid[j] == x { seen = true; break; }
		}
		if seen {
			gold_cache_put(g, x, 1);
		} else {
			mid[mn] = x;
			mn++;
		}
	}
	g.res[0] = first;
	for i in mn {
		g.res[1 + i] = mid[i];
	}
	g.res[1 + mn] = last;
	g.n = mn + 2;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped interior to ", g.n, " items");
	out
}
@end
