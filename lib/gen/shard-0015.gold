code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	gold_cache_put(g, 0, avg);
	var count = 0;
	for i in g.n {
		if g.res[i] > avg { count++; }
	}
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "average ", avg, " exceeded by ", count, " items");
	out
}
@end
