fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence");
		out.ok = false;
		return out;
	}
	let limit = ${cap};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values");
	out
}
@end
