@entry 114cae8001dc2988
kind: pred
verb: find
noun: function
modifier: none
context: core
phrase: find function none prime number check
phrase: check if number is prime
test: arg=7,9
expect: true
expect: false
test: arg=2
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x <= 1 {
		return false;
	}
	if x <= 3 {
		return true;
	}
	if x % 2 == 0 || x % 3 == 0 {
		return false;
	}
	var i = 5;
	while i * i <= x {
		if x % i == 0 || x % (i + 2) == 0 {
			return false;
		}
		i += 6;
	}
	true
}
@end
