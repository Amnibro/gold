phrase: partition minimum fault level up to maximum {ceil}
test: list=15,8,22 ceil=5
expect: => i=8 r=0.0 ok=true s="" errors=1 n=2 res=[4,4] cache=0 hits=0
test: list=20,30 ceil=25
expect: => i=20 r=0.0 ok=true s="" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceil};
	if g.n == 0 {
		gold_fail(g, "no items to find minimum");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	if min_val > c {
		gold_fail(g, "minimum exceeds ceiling");
	}
	let part1 = min_val / 2;
	let part2 = min_val - part1;
	gold_clear(g);
	gold_push(g, part1);
	gold_push(g, part2);
	g.steps += 2;
	out.i = min_val;
	out
}
@end
