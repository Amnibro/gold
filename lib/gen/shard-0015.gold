expect: => i=3 r=0.0 ok=true s="sorted prefix bound: 3" errors=0 n=5 res=[1,4,5,2,8] cache=0 hits=0
test: list=30,10,20 limit=2
expect: => i=2 r=0.0 ok=true s="sorted prefix bound: 2" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = lim;
	if bound > g.n { bound = g.n; }
	for i in bound {
		for j in (i + 1)..bound {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted prefix bound: ", bound);
	out
}
@end
