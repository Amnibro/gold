fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var words = split(out.s, ' ');
	var res byte[>..] = [];
	var i = words.len - 1;
	while i >= 0 {
		if words[i].len > 0 {
			if res.len > 0 { res.push(' '); }
			res.append(words[i]);
		}
		i--;
	}
	out.s.clear();
	out.s.append(res);
	out.i = words.len;
	g.steps += words.len;
	out
}
@end
