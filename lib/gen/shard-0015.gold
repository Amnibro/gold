@entry fb295a0524631197
kind: step
verb: split
noun: condition
modifier: last
context: stats
phrase: split sample with condition {p} ending on last
phrase: partition values by condition {p} tracking last entry
slot: p pred
test: list=1,4,3,6 p=is_even
expect: => i=6 r=0.0 ok=true s="split 2 matching items with last 6" errors=0 n=4 res=[4,6,1,3] cache=0 hits=0
