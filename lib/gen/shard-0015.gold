noun: cache
modifier: pairwise
context: stats
phrase: scale cache pairwise products by {factor}
phrase: multiply pairwise sample products into cache by {factor}
slot: factor int
test: list=2,4,6,8 factor=3
expect: => i=2 r=0.0 ok=true s="cached 2 scaled pairwise products" errors=0 n=4 res=[2,4,6,8] cache=2 hits=0
