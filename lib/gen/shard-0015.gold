fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = out.s.len - 1;
	var found = 0;
	while idx >= 0 {
		if out.s[idx] == ' ' {
			gold_push(g, idx);
			found++;
		}
		idx--;
	}
	g.steps += out.s.len;
	out.i = found;
	out.s.clear();
	format(out.s, "collected spaces");
	out
}
