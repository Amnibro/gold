fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = ${num};
	let d = ${den};
	if d == 0 {
		out.ok = false;
		out.s.clear();
		format(out.s, "division by zero");
		return out;
	}
	for i in g.n {
		g.res[i] = (g.res[i] * n) / d;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " items safely");
	out
}
@end
