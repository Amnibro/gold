fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		if sum + g.res[i] <= b {
			sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
