@entry 1e8978e3bb464ec5
kind: step
verb: clamp
noun: digits
modifier: pairwise
context: search
phrase: clamp digits pairwise across query candidates using {diff}
phrase: apply clamp digits pairwise rule to indexed samples with {diff}
slot: diff int
test: list=10,25,28,45 diff=5
expect: => i=3 r=0.0 ok=true s="clamped pairwise steps: 3" errors=0 n=4 res=[10,15,20,25] cache=0 hits=0
test: list=2,10,12 diff=3
expect: => i=2 r=0.0 ok=true s="clamped pairwise steps: 2" errors=0 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var clamped = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] - g.res[i - 1] > d {
				g.res[i] = g.res[i - 1] + d;
				clamped++;
			}
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped pairwise steps: ", clamped);
	out
}
@end
@entry 6127c6e1f7bb795e
kind: step
verb: normalize
noun: memo
modifier: recursively
context: error
slot: max_depth int
phrase: normalize memo error records recursively to depth {max_depth}
phrase: recursively normalize cached error memo states up to {max_depth}
test: list=10,20,-5 max_depth=3
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[10,20,0] cache=3 hits=3
test: list=5,15,25 max_depth=3
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[5,15,25] cache=3 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let depth = ${max_depth};
	var i = 0;
	while i < g.n {
		gold_cache_put(g, i, g.res[i]);
		i++;
	}
	${ID}_rec(g, 0, depth);
	g.steps += depth;
	out.i = g.errors;
	out
}
recursive fn ${ID}_rec(g Gold&, cur int, max_d int) {
	if cur >= max_d || cur >= g.n { return; }
	let val, ok = gold_cache_get(g, cur);
	if ok && val < 0 {
		gold_fail(g, "negative memo state");
		gold_cache_put(g, cur, 0);
		g.res[cur] = 0;
	}
	${ID}_rec(g, cur + 1, max_d);
}
@end
@entry b8f059941eaafc65
kind: step
verb: shift
noun: tail
modifier: sorted
context: error
slot: offset int
phrase: shift sorted tail errors backward by offset {offset}
phrase: adjust sorted tail fault codes by step {offset}
test: list=1,2,5,10,20 offset=2
expect: => i=22 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,5,10,22] cache=0 hits=0
test: list=10,5,20 offset=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		i++;
	}
	if !is_sorted {
		gold_fail(g, "tail sequence is not sorted");
		out.ok = false;
		return out;
	}
	if g.n > 0 {
		g.res[g.n - 1] += off;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out
}
@end
@entry ff4e11148d02966c
kind: step
verb: split
noun: items
modifier: in_reverse
context: error
slot: div int
phrase: split error items in reverse order with divisor {div}
phrase: partition fault entries in reverse using chunk size {div}
test: list=10,20,30 div=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,15,25 div=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${div};
	if d <= 0 {
		gold_fail(g, "invalid split divisor");
		out.ok = false;
		return out;
	}
	var i = g.n - 1;
	while i >= 0 {
		g.res[i] = g.res[i] / d;
		i--;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
