test: list=8,2,6 pivot=4
expect: => i=1 r=0.0 ok=true s="inserted at index: 1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	gold_push(g, p);
	var k = g.n - 1;
	while k > 0 && g.res[k] < g.res[k - 1] {
		let tmp = g.res[k];
		g.res[k] = g.res[k - 1];
		g.res[k - 1] = tmp;
		k--;
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "inserted at index: ", k);
	out
}
@end
