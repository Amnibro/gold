fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${max_rep};
	var max_seen = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		var count = 0;
		var j = 0;
		while j < out.s.len {
			if out.s[j] == c { count++; }
			j++;
		}
		if count > max_seen { max_seen = count; }
		i++;
	}
	if max_seen > rep {
		gold_fail(g, "character frequency exceeds threshold");
	}
	g.steps += out.s.len;
	out.i = max_seen;
	out
}
