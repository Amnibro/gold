expect: => i=105 r=0.0 ok=true s="top sum computed" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${top_k};
	var count = if k > g.n { g.n } else { k };
	var sum = 0;
	var i = g.n - count;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "top sum computed");
	out
}
@end
