code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var half = g.n / 2;
	for i in half {
		let a = ${f}(g.res[2 * i]);
		let b = ${f}(g.res[2 * i + 1]);
		g.res[i] = if a < b { a + b } else { a - b };
	}
	g.n = half;
	g.steps += half;
	out.i = half;
	out.s.clear();
	format(out.s, "paired sorted ", half, " items");
	out
}
@end
