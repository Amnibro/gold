@entry 5102f48fc1ab823e
kind: step
verb: corrode
noun: rust
modifier: pitted
context: texture
phrase: corrode the texture into pitted rust with seed {u}
phrase: pitted rust surface from seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; contrast a=1.8; quantize n=3
test: img=16 u=5
expect: => i=256 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.5 sum8=7936 hash=809480
test: img=32 u=11
expect: => i=1024 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=184408 hash=262803
test: u=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.8 + 0.5); }
	for k in g.iw * g.ih {
		var q = (g.img[k] * 3.0) as! int;
		if q > 2 { q = 2; }
		g.img[k] = (q as real) / 2.0;
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "rust");
	out
}
@end
