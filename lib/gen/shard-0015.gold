@entry b293548d17316642
kind: step
verb: dedupe
noun: words
modifier: any
context: format
phrase: format unique words from any given text
phrase: render deduplicated words across any text input
test: text="cat dog cat bird"
expect: => i=3 r=0.0 ok=true s="words: [cat, dog, bird]" errors=0 n=0 res=[] cache=0 hits=0
test: text="sun sea sun"
expect: => i=2 r=0.0 ok=true s="words: [sun, sea]" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_dedupe_words_any = 0;
	var words byte[..32][64] = [""; 64];
	var wn = 0;
	var cur byte[..32] = "";
	for i in v.s.len {
		let b = v.s[i];
		if b == ' ' {
			if cur.len > 0 && wn < 64 {
				words[wn] = copy(cur);
				wn++;
				cur.clear();
			}
		} else {
			if cur.len < 32 { cur.push(b); }
		}
	}
	if cur.len > 0 && wn < 64 {
		words[wn] = copy(cur);
		wn++;
	}
	out.s.clear();
	format(out.s, "words: [");
	var seen byte[..32][64] = [""; 64];
	var sn = 0;
	for i in wn {
		let w = words[i];
		var found = false;
		for j in sn { if seen[j] == w { found = true; break; } }
		if !found && sn < 64 {
			seen[sn] = copy(w);
			if sn > 0 { format(out.s, ", "); }
			format(out.s, w);
			sn++;
		}
	}
	format(out.s, "]");
	out.i = sn;
	g.steps += wn;
	out
}
@end
