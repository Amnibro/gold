slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="shifted by 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 k=1
expect: => i=1 r=0.0 ok=true s="shifted by 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=1 k=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 || ${k} < 0 {
		gold_fail(g, "invalid shift");
		out.ok = false;
		return out;
	}
	let shift = ${k} % g.n;
	for s in shift {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	out.i = shift;
	out.s.clear();
	format(out.s, "shifted by ", shift);
	out
}
@end
