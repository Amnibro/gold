@entry 710552c0bc19e40f
kind: step
verb: rotate
noun: numbers
modifier: between
context: format
phrase: format numbers rotated between {start} and {finish}
phrase: render rotated values between {start} and {finish}
slot: start int
slot: finish int
test: list=1,2,3,4,5 start=1 finish=3
expect: => i=2 r=0.0 ok=true s="rot_range: [1, 3, 4, 2, 5]" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 start=0 finish=2
expect: => i=2 r=0.0 ok=true s="rot_range: [20, 30, 10, 40]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_rotate_numbers_between = 0;
	out.s.clear();
	let s = ${start};
	let f = ${finish};
	var buf int[64] = [0; 64];
	for i in g.n { buf[i] = g.res[i]; }
	if s < f && f < g.n {
		let first = buf[s];
		for i in s..f { buf[i] = buf[i + 1]; }
		buf[f] = first;
	}
	format(out.s, "rot_range: [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		format(out.s, buf[i]);
	}
	format(out.s, "]");
	out.i = f - s;
	g.steps += g.n;
	out
}
@end
