@entry 4d4cdd377f9cf848
kind: step
verb: fold
noun: streak
modifier: recursively
context: search
phrase: fold search streak sum recursively
phrase: accumulate streak elements into recursive sum
test: list=1,2,3,1,2
expect: => i=6 r=0.0 ok=true s="folded streak sum: 6" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=5,10,15,4
expect: => i=30 r=0.0 ok=true s="folded streak sum: 30" errors=0 n=4 res=[5,10,15,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best_sum = 0;
	var cur_sum = 0;
	if g.n > 0 {
		cur_sum = g.res[0];
		best_sum = cur_sum;
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				cur_sum += g.res[i];
			} else {
				cur_sum = g.res[i];
			}
			if cur_sum > best_sum { best_sum = cur_sum; }
		}
	}
	out.i = best_sum;
	out.s.clear();
	format(out.s, "folded streak sum: ", best_sum);
	out
}
@end
