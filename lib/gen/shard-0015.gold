code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_prime = false;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { found_prime = true; break; }
		}
	}
	g.steps += g.n;
	let none_found = !found_prime;
	out.ok = none_found;
	out.i = if none_found { 1 } else { 0 };
	out.s.clear();
	if none_found {
		format(out.s, "no primes found");
	} else {
		format(out.s, "primes detected in sample");
	}
	out
}
@end
