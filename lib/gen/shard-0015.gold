kind: step
verb: compare
noun: minimum
modifier: until
context: stats
phrase: compare running minimum until value drops below {bound}
phrase: track sample minimum until reaching bound {bound}
slot: bound int
test: list=50,30,15,40,5 bound=20
expect: => i=15 r=0.0 ok=true s="minimum until limit is 15" errors=0 n=5 res=[50,30,15,40,5] cache=0 hits=0
test: list=45,35,25 bound=10
expect: => i=25 r=0.0 ok=false s="minimum until limit is 25" errors=0 n=3 res=[45,35,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let limit = ${bound};
	var min_val = g.res[0];
	var count = 0;
	for i in g.n {
		count++;
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] < limit { break; }
	}
	g.steps += count;
	out.i = min_val;
	out.ok = min_val < limit;
	out.s.clear();
	format(out.s, "minimum until limit is ", min_val);
	out
}
@end
