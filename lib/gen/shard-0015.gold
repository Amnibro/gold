expect: => i=0 r=0.0 ok=true s="items within range count: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var cnt = 0;
	for k in g.n {
		if g.res[k] >= l && g.res[k] <= h { cnt++; }
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "items within range count: ", cnt);
	out
}
@end
@entry 59dcdd115b2bc340
kind: step
verb: rank
noun: words
modifier: in_place
context: search
phrase: rank words in place observation magnitudes in search
phrase: compute in place rank of search entries
test: list=30,10,20
expect: => i=3 r=0.0 ok=true s="ranked observations in place: 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=5,1,9,3
expect: => i=4 r=0.0 ok=true s="ranked observations in place: 4" errors=0 n=4 res=[3,1,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ranks int[512] = [0; 512];
	for i in g.n {
		var r = 1;
		for j in g.n {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks[i] = r;
	}
	for k in g.n {
		g.res[k] = ranks[k];
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked observations in place: ", g.n);
	out
}
@end
@entry 76303983e374bfd1
kind: step
verb: dedupe
noun: tally
modifier: at_most
context: search
slot: max_copies int
phrase: dedupe tally at most count {max_copies} duplicate items
phrase: prune search duplicates at most limit {max_copies}
test: list=1,1,1,2,2,3 max_copies=2
expect: => i=5 r=0.0 ok=true s="deduped tally retained: 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,4,4,4 max_copies=1
expect: => i=1 r=0.0 ok=true s="deduped tally retained: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_copies};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped tally retained: ", kept);
	out
}
@end
@entry 05fc5fbb2aa9e744
kind: step
verb: trace
noun: subfunction
modifier: in_place
context: search
slot: f fn
