phrase: count subfunction {x} with_cache across sorted results
phrase: tally subfunction {x} evaluations using cached values
test: list=5,2,5,2,8 x=double
expect: => i=3 r=0.0 ok=true s="subfunction evals: 3" errors=0 n=5 res=[4,4,10,10,16] cache=3 hits=2
test: list=10,3,10,4 x=square
expect: => i=3 r=0.0 ok=true s="subfunction evals: 3" errors=0 n=4 res=[9,16,100,100] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var evals = 0;
	for k in g.n {
		let key = g.res[k];
		let val, ok = gold_cache_get(g, key);
		if ok {
			g.res[k] = val;
		} else {
			let computed = ${x}(key);
			gold_cache_put(g, key, computed);
			g.res[k] = computed;
			evals++;
		}
	}
	g.steps += g.n;
	out.i = evals;
	out.s.clear();
	format(out.s, "subfunction evals: ", evals);
	out
}
@end
