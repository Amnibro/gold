test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=37154 hash=178210
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=114983 hash=400562
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
