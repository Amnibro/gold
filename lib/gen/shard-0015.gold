@entry 12918082f03e2899
kind: step
verb: limit
noun: streak
modifier: running
context: stats
phrase: limit running streak length to {max_streak}
phrase: truncate running streak of values to {max_streak}
slot: max_streak int
test: list=5,5,5,5,8,8 max_streak=2
expect: => i=4 r=0.0 ok=true s="limited running streak to length 2" errors=0 n=4 res=[5,5,8,8] cache=0 hits=0
test: list=1,1,2,2 max_streak=1
expect: => i=2 r=0.0 ok=true s="limited running streak to length 1" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${max_streak};
	if g.n == 0 || max_run <= 0 { return out; }
	var kept = 0;
	var cur_val = g.res[0];
	var cur_run = 0;
	for i in g.n {
		if g.res[i] == cur_val {
			if cur_run < max_run {
				g.res[kept] = g.res[i];
				kept++;
				cur_run++;
			}
		} else {
			cur_val = g.res[i];
			cur_run = 1;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "limited running streak to length ", max_run);
	out
}
@end
