expect: => i=4 r=0.0 ok=true s="swapped last square: 4" errors=0 n=3 res=[4,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_sq = -1;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { last_sq = k; }
		}
	}
	var val = 0;
	if last_sq >= 0 && g.n > 0 {
		val = g.res[last_sq];
		let tmp = g.res[0];
		g.res[0] = g.res[last_sq];
		g.res[last_sq] = tmp;
	}
	g.steps += g.n;
	out.i = val;
	out.s.clear();
	format(out.s, "swapped last square: ", val);
	out
}
@end
