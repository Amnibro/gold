code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var first = -1;
	var last = -1;
	var cnt = 0;
	for k in g.n {
		if g.res[k] >= th {
			if first < 0 { first = k; }
			last = k;
			cnt++;
		}
	}
	if first >= 0 && last >= 0 && first != last {
		let tmp = g.res[first];
		g.res[first] = g.res[last];
		g.res[last] = tmp;
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "swapped at least count: ", cnt);
	out
}
@end
@entry 44431b6cb988e2b7
kind: step
verb: scale
noun: limit
modifier: sorted
context: list
slot: lim int
phrase: scale limit sorted items exceeding ceiling {lim}
phrase: list scale limit sorted elements above {lim}
test: list=12,5,8,20 lim=10
expect: => i=2 r=0.0 ok=true s="clamped sorted count: 2" errors=0 n=4 res=[5,8,10,10] cache=0 hits=0
test: list=30,40,15 lim=25
expect: => i=2 r=0.0 ok=true s="clamped sorted count: 2" errors=0 n=3 res=[15,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	for i in g.n {
		for j in i..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var clamped = 0;
	for k in g.n {
		if g.res[k] > ceiling {
			g.res[k] = ceiling;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped sorted count: ", clamped);
	out
}
@end
