code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key_id};
	if g.n == 0 {
		gold_fail(g, "history empty");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	gold_cache_put(g, k, last_val);
	out.i = last_val;
	g.steps += 1;
	out
}
@end
@entry f4ed24bbf10c8672
kind: step
verb: find
noun: digits
modifier: while
context: error
slot: p pred
phrase: find error digits while matching condition {p}
phrase: scan fault digits while predicate {p} holds
test: text="123abc" p=is_even
expect: => i=0 r=0.0 ok=true s="123abc" errors=1 n=0 res=[] cache=0 hits=0
test: text="2468" p=is_even
expect: => i=4 r=0.0 ok=true s="2468" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			let digit = (c - '0') as int;
			if !${p}(digit) { break; }
			count++;
		}
		i++;
	}
	if count == 0 {
		gold_fail(g, "no matching digits found");
	}
	g.steps += count;
	out.i = count;
	out
}
@end
