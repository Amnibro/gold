@entry 66cda5fefa4968a9
kind: step
verb: swap
noun: steps
modifier: at_least
context: stats
phrase: swap steps at least distance {gap}
phrase: exchange adjacent values differing by at least {gap}
slot: gap int
test: list=20,5,30,10 gap=10
expect: => i=2 r=0.0 ok=true s="performed 2 step swaps" errors=0 n=4 res=[5,20,10,30] cache=0 hits=0
test: list=4,8,12,16 gap=5
expect: => i=0 r=0.0 ok=true s="performed 0 step swaps" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i] - g.res[i + 1];
		let d = if diff < 0 { -diff } else { diff };
		if d >= min_gap {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " step swaps");
	out
}
@end
