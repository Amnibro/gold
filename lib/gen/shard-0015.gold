@entry b1478f7cf24dcfc1
kind: step
verb: validate
noun: list
modifier: last
context: search
slot: min_val int
phrase: validate list last element above threshold {min_val}
phrase: check search list last item exceeding {min_val}
test: list=1,2,10 min_val=5
expect: => i=10 r=0.0 ok=true s="validated last element: 10" errors=0 n=3 res=[1,2,10] cache=0 hits=0
test: list=1,2,3 min_val=5
expect: => i=3 r=0.0 ok=false s="validated last element: 3" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		if last_val >= mv {
			out.ok = true;
		} else {
			gold_fail(g, "last item below threshold");
			out.ok = false;
		}
		out.i = last_val;
	} else {
		out.ok = false;
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "validated last element: ", out.i);
	out
}
@end
@entry 639937a27516fa6c
kind: step
verb: sort
noun: history
modifier: running
context: search
phrase: sort history running search sequence in order
phrase: sort running history observations ascending
test: list=25,10,15,5
expect: => i=20 r=0.0 ok=true s="sorted history spread: 20" errors=0 n=4 res=[5,10,15,25] cache=0 hits=0
test: list=4,2,8
expect: => i=6 r=0.0 ok=true s="sorted history spread: 6" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var diff = 0;
	if g.n > 1 {
		diff = g.res[g.n - 1] - g.res[0];
	}
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "sorted history spread: ", diff);
	out
}
@end
