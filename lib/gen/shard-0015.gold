fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var gap_count = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		let adiff = if diff < 0 { -diff } else { diff };
		if adiff > gap {
			gap_count++;
		}
		i++;
	}
	if gap_count == 0 {
		gold_fail(g, "no pairwise gaps exceeded threshold");
	}
	g.steps += g.n;
	out.i = gap_count;
	out
}
