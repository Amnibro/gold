fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${steps};
	if st < 0 {
		gold_fail(g, "negative recursion count");
		out.ok = false;
		return out;
	}
	for i in g.n {
		var x = g.res[i];
		for s in st {
			x = ${f}(x);
		}
		g.res[i] = x;
	}
	out.i = st;
	out.s.clear();
	format(out.s, "applied ", st, " iterations");
	out
}
@end
