fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	var next_val = if g.n > 0 { g.res[g.n - 1] + 1 } else { 1 };
	while g.n < target && g.n < 512 {
		gold_push(g, next_val);
		next_val++;
	}
	if g.n < target {
		gold_fail(g, "unable to complete unique series");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
