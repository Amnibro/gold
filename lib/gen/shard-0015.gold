@entry 2912094b6e452e48
kind: step
verb: rotate
noun: average
modifier: none
context: cache
phrase: rotate list around average with none excluded
phrase: cycle sequence using average pivot without dropping items
test: list=10,20,30,40
expect: => i=25 r=0.0 ok=true s="rotated at avg 25" errors=0 n=4 res=[30,40,10,20] cache=1 hits=0
test: list=2,4,6,8
expect: => i=5 r=0.0 ok=true s="rotated at avg 5" errors=0 n=4 res=[6,8,2,4] cache=1 hits=0
test: list=100,200
expect: => i=150 r=0.0 ok=true s="rotated at avg 150" errors=0 n=2 res=[200,100] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	gold_cache_put(g, 0, avg);
	var hi int[512] = [0; 512];
	var lo int[512] = [0; 512];
	var nh = 0;
	var nl = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= avg { hi[nh] = x; nh++; }
		else { lo[nl] = x; nl++; }
	}
	gold_clear(g);
	for i in nh { gold_push(g, hi[i]); }
	for i in nl { gold_push(g, lo[i]); }
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "rotated at avg ", avg);
	out
}
@end
@entry ed0eb825815bd5e5
kind: step
verb: clamp
noun: gaps
modifier: until
context: cache
phrase: clamp gaps between items until threshold {max_gap} is met
phrase: bound adjacent differences until reaching {max_gap}
slot: max_gap int
test: list=10,30,70 max_gap=15
expect: => i=2 r=0.0 ok=true s="clamped 2 gaps" errors=0 n=3 res=[10,25,40] cache=2 hits=0
test: list=5,25,60 max_gap=10
expect: => i=2 r=0.0 ok=true s="clamped 2 gaps" errors=0 n=3 res=[5,15,25] cache=2 hits=0
test: list=1,2,3 max_gap=5
expect: => i=0 r=0.0 ok=true s="clamped 0 gaps" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let max_g = ${max_gap};
	var adjusted = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff > max_g {
			g.res[i + 1] = g.res[i] + max_g;
			gold_cache_put(g, i + 1, g.res[i + 1]);
			adjusted++;
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped ", adjusted, " gaps");
	out
}
@end
@entry 361b3391c8dfa86c
kind: step
verb: filter
noun: suffix
modifier: in_place
context: cache
phrase: filter suffix entries in place retaining {n} trailing items
phrase: keep only last {n} suffix items in place
slot: n int
test: list=1,2,3,4,5 n=3
expect: => i=3 r=0.0 ok=true s="kept 3 suffix items" errors=0 n=3 res=[3,4,5] cache=3 hits=0
test: list=10,20,30 n=1
expect: => i=1 r=0.0 ok=true s="kept 1 suffix items" errors=0 n=1 res=[30] cache=1 hits=0
test: list=5,6,7 n=0
expect: => i=0 r=0.0 ok=true s="cleared all items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let keep = ${n};
	if keep <= 0 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "cleared all items");
		return out;
	}
	let start = if g.n > keep { g.n - keep } else { 0 };
	var temp int[512] = [0; 512];
	var count = 0;
	for i in (g.n - start) {
		temp[count] = g.res[start + i];
		gold_cache_put(g, count, temp[count]);
		count++;
	}
	gold_clear(g);
	for i in count { gold_push(g, temp[i]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " suffix items");
	out
}
@end
