kind: step
verb: group
noun: part
modifier: compound
context: cad
phrase: group compound parts
phrase: assemble compound group of shapes
test: doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=2 r=0.0 ok=true s="compound" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: compound3 group ground,crate
test: doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=2 r=0.0 ok=true s="compound" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: compound3 group rock,post
test: doc="crate box 1,2,.5 1,1,1"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: crate box 1,2,.5 1,1,1
test: doc="key light point 2,-2,3 w300"
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => doc: key light point 2,-2,3 w300
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var names byte[>..] = [];
	var c = 0;
	for k in g.dn {
		if gold_dshape(g, k) {
			if c > 0 { names.push(','); }
			gold_dword(g, k, names);
			c++;
		}
	}
	if c < 2 {
		gold_fail(g, "need at least two shapes for compound group");
		out.ok = false;
		return out;
	}
	gold_dnew(g, "compound", o);
	o.append(" group ");
	o.append(names);
	gold_doc(g, o);
	out.i = c;
	out.s.clear();
	format(out.s, "compound");
	out
}
@end
