fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${dur} <= 0.0 { out.ok = false; return out; }
	o.append(last);
	o.append(".rot anim ");
	o.append("0");
	o.append(":0,0,");
	o.append("0 ");
	gold_fnum(o, ${dur});
	o.append(":0,0,");
	o.append("36");
	o.append("0 loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "orbitprop");
	out
}
@end
