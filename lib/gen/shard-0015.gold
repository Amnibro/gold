kind: step
verb: rotate
noun: item
modifier: up_to
context: search
phrase: rotate search items up to limit {lim}
phrase: cycle search buffer elements up to {lim}
slot: lim int
test: list=1,2,3,4,5 lim=3
expect: => i=3 r=0.0 ok=true s="rotated items up to limit" errors=0 n=5 res=[2,3,4,1,5] cache=0 hits=0
