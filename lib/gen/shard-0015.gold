code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_delta = ${limit};
	var excess = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d > max_delta { excess++; }
		}
	}
	g.steps += g.n;
	out.i = excess;
	out.ok = excess == 0;
	out.s.clear();
	if excess == 0 {
		format(out.s, "no step exceeded limit");
	} else {
		format(out.s, "found ", excess, " steps over limit");
	}
	out
}
@end
@entry 4a45e968a8af400c
kind: step
verb: select
noun: tally
modifier: sorted
context: stats
phrase: select tally sorted top counts {k}
phrase: extract sorted frequency tallies up to {k}
slot: k int
test: list=5,5,5,2,2,8 k=2
expect: => i=2 r=0.0 ok=true s="selected top 2 frequency counts" errors=0 n=2 res=[3,2] cache=0 hits=0
test: list=1,1,1,1,2,3,3 k=2
expect: => i=2 r=0.0 ok=true s="selected top 2 frequency counts" errors=0 n=2 res=[4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	var vals int[256] = [0; 256];
	var counts int[256] = [0; 256];
	var vn = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in vn {
			if vals[j] == x { counts[j]++; found = true; break; }
		}
		if !found && vn < 256 {
			vals[vn] = x;
			counts[vn] = 1;
			vn++;
		}
	}
	for i in vn {
		var j = i;
		while j > 0 && counts[j - 1] < counts[j] {
			let tc = counts[j - 1]; counts[j - 1] = counts[j]; counts[j] = tc;
			let tv = vals[j - 1]; vals[j - 1] = vals[j]; vals[j] = tv;
			j--;
		}
	}
	let res_n = if limit < vn { limit } else { vn };
	for i in res_n { g.res[i] = counts[i]; }
	g.n = res_n;
	g.steps += g.n + vn;
	out.i = res_n;
	out.s.clear();
	format(out.s, "selected top ", res_n, " frequency counts");
	out
}
@end
