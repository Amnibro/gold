code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_steps};
	var comparisons = 0;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			comparisons++;
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let ok = comparisons <= lim;
	g.steps += comparisons;
	out.ok = ok;
	out.i = comparisons;
	out.s.clear();
	format(out.s, "nested steps: ", comparisons);
	out
}
@end
