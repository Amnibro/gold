@entry e3037c81312a6d1f
kind: step
verb: find
noun: numbers
modifier: nested
context: stats
phrase: find numbers nested matching value {target}
phrase: search nested numbers for frequency of {target}
slot: target int
test: list=4,7,4,9,4 target=4
expect: => i=3 r=0.0 ok=true s="found target frequency: 3" errors=0 n=5 res=[4,7,4,9,4] cache=0 hits=0
test: list=1,2,3 target=5
expect: => i=0 r=0.0 ok=true s="found target frequency: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = 0;
	for i in g.n {
		if g.res[i] == tgt { found++; }
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "found target frequency: ", found);
	out
}
@end
@entry da4feee7f88ee215
kind: step
verb: collect
noun: letters
modifier: between
context: stats
phrase: collect letters between bounds {low} to {high}
phrase: gather character codes between {low} through {high}
slot: low int
slot: high int
test: text="abcde" low=98 high=100
expect: => i=3 r=0.0 ok=true s="collected letters: 3" errors=0 n=3 res=[98,99,100] cache=0 hits=0
test: text="hello" low=105 high=115
expect: => i=3 r=0.0 ok=true s="collected letters: 3" errors=0 n=3 res=[108,108,111] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var collected = 0;
	for b in out.s {
		let code = b as int;
		if code >= lo && code <= hi {
			gold_push(g, code);
			collected++;
		}
	}
	g.steps += out.s.len;
	out.i = collected;
	out.s.clear();
	format(out.s, "collected letters: ", collected);
	out
}
@end
@entry 763bf50bfdb3ff6f
kind: step
verb: limit
noun: history
modifier: while
context: stats
phrase: limit history while condition {cond} holds
phrase: truncate results history while {cond} satisfies
slot: cond pred
test: list=2,4,6,7,8 cond=is_even
expect: => i=3 r=0.0 ok=true s="history limited to: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=3,5,8 cond=is_odd
expect: => i=2 r=0.0 ok=true s="history limited to: 2" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < g.n {
		if !${cond}(g.res[count]) { break; }
		count++;
	}
	g.n = count;
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "history limited to: ", count);
	out
}
@end
@entry a27dec70177572e1
kind: step
verb: limit
noun: head
modifier: first
context: stats
phrase: limit head first {count} observations
phrase: restrict head to first {count} items
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="head limited to: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=1,2 count=5
expect: => i=2 r=0.0 ok=true s="head limited to: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative count");
		out.ok = false;
		return out;
	}
	if g.n > k {
		g.n = k;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "head limited to: ", g.n);
	out
}
@end
