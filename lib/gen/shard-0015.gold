kind: step
verb: compare
noun: average
modifier: until
context: stats
phrase: compare cumulative average until reaching threshold {target}
phrase: track running average until exceeding value {target}
slot: target int
test: list=10,20,60,80 target=25
expect: => i=3 r=0.0 ok=true s="average reached target at step 3" errors=0 n=4 res=[10,20,60,80] cache=0 hits=0
test: list=5,10,12 target=20
expect: => i=3 r=0.0 ok=false s="average did not reach target" errors=0 n=3 res=[5,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var count = 0;
	var reached = false;
	for i in g.n {
		sum += g.res[i];
		count++;
		let avg = sum / count;
		if avg >= tgt {
			reached = true;
			break;
		}
	}
	g.steps += count;
	out.i = count;
	out.ok = reached;
	out.s.clear();
	if reached {
		format(out.s, "average reached target at step ", count);
	} else {
		format(out.s, "average did not reach target");
	}
	out
}
@end
@entry a44ae680e5141250
kind: step
verb: fill
noun: threshold
modifier: sorted
context: stats
phrase: fill values below threshold {threshold} maintaining sorted order
phrase: clamp below threshold {threshold} on sorted results
slot: threshold int
test: list=15,5,30,8 threshold=10
expect: => i=2 r=0.0 ok=true s="filled 2 sorted values up to threshold" errors=0 n=4 res=[10,10,15,30] cache=0 hits=0
test: list=25,40 threshold=10
expect: => i=0 r=0.0 ok=true s="filled 0 sorted values up to threshold" errors=0 n=2 res=[25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var filled = 0;
	for i in g.n {
		if g.res[i] < limit {
			g.res[i] = limit;
			filled++;
		}
	}
	g.steps += g.n;
	out.i = filled;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled ", filled, " sorted values up to threshold");
	out
}
@end
