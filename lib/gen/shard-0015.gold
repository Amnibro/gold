fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stride = ${step};
	if stride <= 1 {
		gold_fail(g, "invalid stride");
		out.ok = false;
		return out;
	}
	var w = 0;
	for r in g.n {
		if (r + 1) % stride != 0 {
			g.res[w] = g.res[r];
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items");
	out
}
@end
