fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${drop_count};
	if k > g.n {
		gold_fail(g, "drop count exceeds available items");
		out.ok = false;
		return out;
	}
	for i in k {
		gold_cache_put(g, i, g.res[i]);
	}
	var i = 0;
	while i + k < g.n {
		g.res[i] = g.res[i + k];
		i++;
	}
	g.n -= k;
	g.steps += k;
	out.i = g.n;
	out
}
@end
