code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_search_squares_in_place = 0;
	out.s.clear();
	format(out.s, "squares: [");
	var found_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x {
					if found_cnt > 0 { format(out.s, ", "); }
					format(out.s, x);
					found_cnt++;
					break;
				}
				r++;
			}
		}
	}
	format(out.s, "]");
	out.i = found_cnt;
	g.steps += g.n;
	out
}
@end
