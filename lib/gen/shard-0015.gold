fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var attempts = 0;
	while sum < ${target} && attempts < 10 {
		sum += g.n;
		attempts++;
	}
	g.steps += attempts;
	out.i = sum;
	out.ok = sum >= ${target};
	out.s.clear();
	format(out.s, "tally ", sum, " after ", attempts, " retries");
	out
}
