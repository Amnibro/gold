fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var ucount = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in ucount {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen {
			uniq[ucount] = x;
			ucount++;
		}
	}
	out.s.clear();
	for i in ucount {
		if i > 0 { out.s.append(${sep}); }
		format(out.s, uniq[i]);
	}
	out.i = ucount;
	out
}
@end
