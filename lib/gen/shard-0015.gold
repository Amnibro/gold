expect: => i=5 r=0.0 ok=true s="reversed 5 unique observations" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="reversed 3 unique observations" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if uniq[j] == x { exists = true; break; }
		}
		if !exists {
			uniq[un] = x;
			un++;
		}
	}
	for i in un {
		g.res[i] = uniq[un - 1 - i];
	}
	g.steps += g.n + un;
	g.n = un;
	out.i = un;
	out.s.clear();
	format(out.s, "reversed ", un, " unique observations");
	out
}
@end
