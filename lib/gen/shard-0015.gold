test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="counted 3 distinct runs" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="counted 1 distinct runs" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var lengths int[512] = [0; 512];
	var ln = 0;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			lengths[ln] = cur_run;
			ln++;
			cur_run = 1;
		}
	}
	lengths[ln] = cur_run;
	ln++;
	for i in ln {
		g.res[i] = lengths[i];
	}
	g.n = ln;
	g.steps += g.n;
	out.i = ln;
	out.s.clear();
	format(out.s, "counted ", ln, " distinct runs");
	out
}
@end
