test: list=5,2,8,1,9
expect: => i=3 r=0.0 ok=true s="pairwise merged heads: 3" errors=0 n=3 res=[3,13,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res: int[256];
	var nn = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			new_res[nn] = g.res[i] + g.res[i + 1];
			nn++;
			i += 2;
		} else {
			new_res[nn] = g.res[i];
			nn++;
			i++;
		}
	}
	g.n = 0;
	for k in nn {
		gold_push(g, new_res[k]);
	}
	g.steps += nn;
	out.i = nn;
	out.s.clear();
	format(out.s, "pairwise merged heads: ", nn);
	out
}
@end
