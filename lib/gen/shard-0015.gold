@entry 7f3942969a7ea200
kind: step
verb: find
noun: steps
modifier: with_retry
context: error
slot: max_retries int
phrase: find required recovery steps with retry limit {max_retries}
phrase: compute error correction steps with retry ceiling {max_retries}
test: input=5 max_retries=10
expect: => i=5 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
test: input=15 max_retries=10
expect: => i=10 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var steps_needed = out.i;
	var attempts = 0;
	while steps_needed > 0 && attempts < retries {
		steps_needed -= 1;
		attempts++;
	}
	if steps_needed > 0 {
		gold_fail(g, "recovery failed within retry limit");
		out.ok = false;
	}
	g.steps += attempts;
	out.i = attempts;
	out
}
@end
