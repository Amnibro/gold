@entry 1e47bf1c9a0c8066
kind: step
verb: dedupe
noun: function
modifier: in_reverse
context: search
phrase: dedupe search results in_reverse order
phrase: unique search items backwards in_reverse
test: list=1,2,1,3,2
expect: => i=3 r=0.0 ok=true s="reverse deduped 3 items" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=5,5,6,7
expect: => i=3 r=0.0 ok=true s="reverse deduped 3 items" errors=0 n=3 res=[7,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var nk = 0;
	var i = g.n - 1;
	while i >= 0 {
		var seen = false;
		for k in nk {
			if kept[k] == g.res[i] { seen = true; break; }
		}
		if !seen && nk < 512 {
			kept[nk] = g.res[i];
			nk++;
		}
		i--;
	}
	gold_clear(g);
	for k in nk { gold_push(g, kept[k]); }
	g.steps += nk;
	out.i = nk;
	out.s.clear();
	format(out.s, "reverse deduped ", nk, " items");
	out
}
@end
