code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var dropped = 0;
	var write = 0;
	var i = 0;
	while i < g.n {
		let in_range = g.res[i] >= l && g.res[i] <= h;
		if in_range && (i % 2 == 0) {
			dropped++;
		} else {
			g.res[write] = g.res[i];
			write++;
		}
		i++;
	}
	g.n = write;
	if dropped == 0 {
		gold_fail(g, "no elements dropped in range");
	}
	g.steps += g.n;
	out.i = dropped;
	out
}
@end
