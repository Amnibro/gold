@entry c684d59cf2576b7f
kind: step
verb: select
noun: squares
modifier: while
context: sort
slot: limit int
phrase: select sorted squares while values are below {limit}
phrase: collect square elements from sorted list while under {limit}
test: list=9,2,4,1,5,16 limit=10
expect: => i=3 r=0.0 ok=true s="squares while under limit: 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: list=25,3,1,8,4 limit=20
expect: => i=2 r=0.0 ok=true s="squares while under limit: 2" errors=0 n=2 res=[1,4] cache=0 hits=0
code:
fn ${ID}_is_sq(x int) bool {
	if x < 0 { return false; }
	var i = 0;
	while i * i <= x {
		if i * i == x { return true; }
		i++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for k in g.n {
		if ${ID}_is_sq(g.res[k]) {
			if g.res[k] <= lim {
				g.res[kept] = g.res[k];
				kept++;
			} else {
				break;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "squares while under limit: ", kept);
	out
}
@end
