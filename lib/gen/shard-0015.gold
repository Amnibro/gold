code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var min_idx = 0;
		var max_idx = 0;
		for k in g.n {
			if g.res[k] < g.res[min_idx] { min_idx = k; }
			if g.res[k] > g.res[max_idx] { max_idx = k; }
		}
		let tmp = g.res[min_idx];
		g.res[min_idx] = g.res[max_idx];
		g.res[max_idx] = tmp;
		out.i = g.res[min_idx] - g.res[max_idx];
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped extremes spread: ", out.i);
	out
}
@end
