fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, found = gold_cache_get(g, x);
		if found {
			g.res[i] = cached;
		} else {
			let res = ${f}(x);
			gold_cache_put(g, x, res);
			g.res[i] = res;
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.ok = true;
	out.s.clear();
	format(out.s, "ran results transform with ", g.hits, " cache hits");
	out
}
@end
