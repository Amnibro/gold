@entry ddf73ceb216e4dce
kind: step
verb: rotate
noun: text
modifier: in_reverse
context: search
phrase: rotate search buffer in reverse by {steps} steps
phrase: cycle search list in reverse by {steps} positions
slot: steps int
test: list=10,20,30,40,50 steps=1
expect: => i=1 r=0.0 ok=true s="rotated in reverse by 1" errors=0 n=5 res=[50,10,20,30,40] cache=0 hits=0
test: list=1,2,3,4 steps=2
expect: => i=2 r=0.0 ok=true s="rotated in reverse by 2" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var k = ${steps} % g.n;
	if k < 0 { k += g.n; }
	for _ in k {
		let last_val = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last_val;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "rotated in reverse by ", k);
	out
}
@end
@entry e0995ad498075d8d
kind: step
verb: filter
noun: histogram
modifier: until
context: search
phrase: filter histogram items until cumulative sum reaches {cap}
phrase: retain search histogram entries until total hits {cap}
slot: cap int
test: list=5,10,15,20,25 cap=25
expect: => i=2 r=0.0 ok=true s="filtered histogram until cap: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=12,8,20,30 cap=20
expect: => i=2 r=0.0 ok=true s="filtered histogram until cap: 2" errors=0 n=2 res=[12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var running = 0;
	var kept = 0;
	for i in g.n {
		running += g.res[i];
		if running <= limit {
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered histogram until cap: ", kept);
	out
}
@end
@entry baf035ec1b773ee6
kind: step
verb: rotate
noun: limit
modifier: nested
context: search
phrase: rotate search slice within nested limit {lim}
phrase: cycle search items inside nested boundary {lim}
slot: lim int
test: list=10,20,30,40,50 lim=3
expect: => i=3 r=0.0 ok=true s="rotated nested limit boundary" errors=0 n=5 res=[20,30,10,40,50] cache=0 hits=0
test: list=5,15,25,35 lim=2
expect: => i=2 r=0.0 ok=true s="rotated nested limit boundary" errors=0 n=4 res=[15,5,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bound = ${lim};
	if bound > g.n { bound = g.n; }
	if bound <= 1 { return out; }
	let first = g.res[0];
	for i in 0..(bound - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.res[bound - 1] = first;
	out.i = bound;
	out.s.clear();
	format(out.s, "rotated nested limit boundary");
	out
}
@end
