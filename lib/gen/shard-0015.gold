test: list=1,10,20,30,4 radius=1
expect: => i=60 r=0.0 ok=true s="" errors=0 n=5 res=[1,10,20,30,4] cache=0 hits=0
test: list=1,2,3 radius=5
expect: => i=6 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if g.n < 3 {
		gold_fail(g, "too few items for middle extraction");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let lo = if mid - r >= 0 { mid - r } else { 0 };
	let hi = if mid + r < g.n { mid + r } else { g.n - 1 };
	var sum = 0;
	var i = lo;
	while i <= hi {
		sum += g.res[i];
		i++;
	}
	if sum > 100 {
		gold_fail(g, "middle nested sum exceeds safe margin");
	}
	g.steps += (hi - lo + 1);
	out.i = sum;
	out
}
@end
