fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique = true;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] { unique = false; break; }
		}
		if !unique { break; }
	}
	gold_cache_put(g, 0, if unique { 1 } else { 0 });
	g.steps += g.n * g.n;
	out.ok = unique;
	out.i = if unique { 1 } else { 0 };
	out.s.clear();
	format(out.s, if unique { "all unique" } else { "has duplicates" });
	out
}
