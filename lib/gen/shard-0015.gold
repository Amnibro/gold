expect: 0
test: arg=111 b=5
expect: 1
code:
fn ${ID}(n int) int {
	let base = ${b};
	var x = if n < 0 { -n } else { n };
	if x == 0 {
		return if 0 < base { 1 } else { 0 };
	}
	var seen = [0; 10];
	while x > 0 {
		let d = x % 10;
		if d < base {
			seen[d] = 1;
		}
		x /= 10;
	}
	var count = 0;
	var d = 0;
	while d < 10 {
		count += seen[d];
		d++;
	}
	count
}
@end
@entry a1cb3c9a7efa7daf
