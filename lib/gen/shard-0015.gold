@entry fbc0886a1c664ffd
kind: step
verb: scale
noun: histogram
modifier: every_other
context: sort
slot: factor int
phrase: scale histogram every_other frequency bin by {factor}
phrase: adjust alternate sorted frequency buckets with {factor}
test: list=2,2,5,5,8 factor=2
expect: => i=3 r=0.0 ok=true s="histogram bins scaled: 3" errors=0 n=3 res=[4,2,2] cache=0 hits=0
test: list=1,1,3,3,7,7 factor=3
expect: => i=3 r=0.0 ok=true s="histogram bins scaled: 3" errors=0 n=3 res=[6,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var counts: int[256];
	var cn = 0;
	var cur_count = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_count++;
		} else {
			counts[cn] = cur_count;
			cn++;
			cur_count = 1;
		}
	}
	counts[cn] = cur_count;
	cn++;
	var i = 0;
	while i < cn {
		counts[i] = counts[i] * mul;
		i += 2;
	}
	g.n = 0;
	for k in cn {
		gold_push(g, counts[k]);
	}
	g.steps += cn;
	out.i = cn;
	out.s.clear();
	format(out.s, "histogram bins scaled: ", cn);
	out
}
@end
