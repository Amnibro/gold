fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var i = 0;
	while i + 1 < out.s.len {
		let diff = (out.s[i + 1] as int) - (out.s[i] as int);
		gold_push(g, diff);
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "grouped text pairs: ", g.n);
	out
}
@end
