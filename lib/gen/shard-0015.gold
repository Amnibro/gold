expect: => i=12 r=0.0 ok=true s="minimum scaled: 12" errors=0 n=4 res=[12,12,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		let mn = g.res[0];
		for k in g.n {
			if g.res[k] == mn {
				g.res[k] = g.res[k] * mul;
			}
		}
		out.i = mn * mul;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "minimum scaled: ", out.i);
	out
}
@end
