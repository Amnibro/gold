expect: => i=2 r=0.0 ok=true s="kept 2 items above average" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="kept 0 items above average" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] > avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items above average");
	out
}
@end
