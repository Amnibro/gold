kind: step
verb: pair
noun: odds
modifier: up_to
context: transform
slot: limit int
phrase: pair odd numbers up to count {limit}
phrase: group odd values up to {limit} pairs
test: list=1,3,5,7,9,11 limit=2
expect: => i=2 r=0.0 ok=true s="paired 2 odd pairs" errors=0 n=2 res=[4,12] cache=0 hits=0
