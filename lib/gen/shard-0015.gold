	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		let dummy, found = gold_mget(g, val);
		if found {
			g.res[kept] = val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " observations matching cache");
	out
}
@end
