kind: step
verb: dedupe
noun: limit
modifier: times
context: cache
phrase: dedupe cache entries up to limit {lim} times
phrase: remove duplicate keys repeating up to {lim} times
slot: lim int
test: list=1,1,1,2,2,3 lim=2
expect: => i=5 r=0.0 ok=true s="deduped to 5 items" errors=0 n=5 res=[1,1,2,2,3] cache=3 hits=0
test: list=5,5,5,5,5 lim=1
expect: => i=1 r=0.0 ok=true s="deduped to 1 items" errors=0 n=1 res=[5] cache=1 hits=0
test: list=4,4,6 lim=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[4,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	if limit <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if temp[j] == x { seen++; }
		}
		if seen < limit && kept < 512 {
			temp[kept] = x;
			kept++;
			gold_cache_put(g, x, seen + 1);
		}
	}
	gold_clear(g);
	for i in kept { gold_push(g, temp[i]); }
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " items");
	out
}
@end
