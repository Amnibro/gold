code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tot = ${limit};
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] > max_tot { break; }
		running += g.res[i];
		g.res[kept] = g.res[i];
		kept++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "total up to: ", running);
	out
}
@end
@entry d831578e3b2921c9
kind: step
verb: swap
noun: middle
modifier: with_retry
context: loop
phrase: swap middle loop elements with retry limit {limit}
phrase: swap center values in loop with retry bound {limit}
slot: limit int
test: list=10,20,50,15 limit=25
expect: => i=0 r=0.0 ok=true s="middle swapped: 0" errors=0 n=4 res=[10,20,50,15] cache=0 hits=0
test: list=1,5,3,9 limit=10
expect: => i=1 r=0.0 ok=true s="middle swapped: 1" errors=0 n=4 res=[1,3,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 { return out; }
	let m1 = (g.n / 2) - 1;
	let m2 = g.n / 2;
	let diff = if g.res[m1] > g.res[m2] { g.res[m1] - g.res[m2] } else { g.res[m2] - g.res[m1] };
	var swaps = 0;
	if diff <= lim {
		let tmp = g.res[m1];
		g.res[m1] = g.res[m2];
		g.res[m2] = tmp;
		swaps = 1;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "middle swapped: ", swaps);
	out
}
@end
@entry 8bfa5b9a73afdab1
kind: step
verb: check
noun: value
modifier: recursively
context: loop
phrase: check value {target} through recursive loop halving
phrase: test value {target} via recursive loop division
slot: target int
test: input=64 target=8
expect: => i=4 r=0.0 ok=true s="recursive halving reached: true" errors=0 n=0 res=[] cache=0 hits=0
test: input=50 target=7
expect: => i=6 r=0.0 ok=false s="recursive halving reached: false" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var curr = v.i;
	var found = false;
	var steps = 0;
	while curr > 0 {
		steps++;
		if curr == tgt {
			found = true;
			break;
		}
		curr /= 2;
	}
	g.steps += steps;
	out.ok = found;
	out.i = steps;
	out.s.clear();
	format(out.s, "recursive halving reached: ", found);
	out
}
@end
