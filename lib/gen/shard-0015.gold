expect: => i=2 r=0.0 ok=true s="counted 2 items exceeding threshold in last 2" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let thresh = ${threshold};
	var start = g.n - count;
	if start < 0 { start = 0; }
	var matching = 0;
	var i = start;
	while i < g.n {
		if g.res[i] > thresh { matching++; }
		i++;
	}
	g.steps += g.n;
	out.i = matching;
	out.s.clear();
	format(out.s, "counted ", matching, " items exceeding threshold in last ", count);
	out
}
@end
@entry c17f3bbb16511e34
kind: step
verb: scan
noun: budget
modifier: unique
context: stats
phrase: scan budget unique items within limit {budget}
phrase: collect unique observations within budget {budget}
slot: budget int
test: list=5,5,10,10,15 budget=25
expect: => i=15 r=0.0 ok=true s="collected 2 unique items with sum 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=3,3,6,12 budget=10
expect: => i=9 r=0.0 ok=true s="collected 2 unique items with sum 9" errors=0 n=2 res=[3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var sum = 0;
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists {
			if sum + x > limit { break; }
			sum += x;
			g.res[un] = x;
			un++;
		}
	}
	g.steps += g.n;
	g.n = un;
	out.i = sum;
	out.s.clear();
	format(out.s, "collected ", un, " unique items with sum ", sum);
	out
}
@end
@entry ae7df335f0bd1a3d
kind: step
verb: reverse
noun: prefix
modifier: up_to
context: stats
phrase: reverse prefix up to index {k}
phrase: invert leading observations up to count {k}
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=3 r=0.0 ok=true s="reversed prefix of 3 items" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3,4,5 k=4
expect: => i=4 r=0.0 ok=true s="reversed prefix of 4 items" errors=0 n=5 res=[4,3,2,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	var left = 0;
	var right = count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed prefix of ", count, " items");
	out
}
@end
