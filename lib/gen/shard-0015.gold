@entry 4ca8ee5f47b6e71b
kind: fn
verb: clamp
noun: prefix
modifier: at_least
context: filter
phrase: clamp prefix at_least {floor}
phrase: bound prefix at_least {floor}
slot: floor int
test: arg=234,789 floor=5
expect: 534
expect: 789
test: arg=400 floor=5
expect: 500
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	let min_lead = ${floor};
	if val < 10 {
		if val < min_lead {
			return min_lead;
		}
		return val;
	}
	var mult = 1;
	var temp = val;
	while temp >= 10 {
		mult *= 10;
		temp /= 10;
	}
	let lead = temp;
	let rest = val % mult;
	var new_lead = lead;
	if lead < min_lead {
		new_lead = min_lead;
	}
	new_lead * mult + rest
}
@end
@entry 625b0f8f1badcc49
kind: fn
verb: join
noun: spaces
modifier: with_cache
context: filter
phrase: join spaces with_cache factor {multiplier}
phrase: scale spaces with_cache factor {multiplier}
slot: multiplier int
test: arg=135,111 multiplier=2
expect: 8
expect: 0
test: arg=15 multiplier=2
expect: 8
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	let k = ${multiplier};
	if val < 10 {
		return 0;
	}
	var total = 0;
	var prev = val % 10;
	val /= 10;
	while val > 0 {
		let curr = val % 10;
		var diff = curr - prev;
		if diff < 0 {
			diff = -diff;
		}
		total += diff;
		prev = curr;
		val /= 10;
	}
	total * k
}
@end
