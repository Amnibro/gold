expect: => i=2 r=0.0 ok=true s="orbitwin" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: window box 0,4,2 1.5,0.2,2
expect: => doc: window.rot anim 0:0,0,0 2:0,0,360 loop
test: dur=4.0 doc="wall box 0,5,2 8,0.4,4|window box 0,5,2 1.2,0.2,1.8"
expect: => i=3 r=0.0 ok=true s="orbitwin" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: wall box 0,5,2 8,0.4,4
expect: => doc: window box 0,5,2 1.2,0.2,1.8
expect: => doc: window.rot anim 0:0,0,0 4:0,0,360 loop
test: dur=0.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${dur} <= 0.0 { out.ok = false; return out; }
	o.append(last);
	o.append(".rot anim ");
	o.append("0");
	o.append(":0,0,");
	o.append("0 ");
	gold_fnum(o, ${dur});
	o.append(":0,0,");
	o.append("36");
	o.append("0 loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "orbitwin");
	out
}
@end
