		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for i in (g.n / 2)..g.n {
		if g.res[i] > thresh {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tail items above threshold: ", count);
	out
}
@end
