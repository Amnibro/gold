fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var attempts = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x > 0 {
			total += x;
			gold_cache_put(g, i, total);
		} else if attempts < r {
			attempts++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "budget ", total, " retries ", attempts);
	out
}
@end
