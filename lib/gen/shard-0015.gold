phrase: scale runs unique items using factor {factor}
phrase: multiply unique streak frequencies by {factor}
test: list=2,2,5,5,5,8 factor=2
expect: => i=3 r=0.0 ok=true s="scaled runs count: 3" errors=0 n=3 res=[4,6,2] cache=0 hits=0
test: list=7,7,3,3,9 factor=3
expect: => i=3 r=0.0 ok=true s="scaled runs count: 3" errors=0 n=3 res=[6,6,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var runs: int[256];
	var rn = 0;
	var cur_run = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_run++;
		} else {
			runs[rn] = cur_run * mul;
			rn++;
			cur_run = 1;
		}
	}
	runs[rn] = cur_run * mul;
	rn++;
	g.n = 0;
	for i in rn {
		gold_push(g, runs[i]);
	}
	g.steps += rn;
	out.i = rn;
	out.s.clear();
	format(out.s, "scaled runs count: ", rn);
	out
}
@end
