code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let last = g.res[g.n - 1];
	let reps = ${count};
	for k in reps {
		gold_push(g, last);
	}
	g.steps += reps;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated suffix ", reps, " times");
	out
}
@end
