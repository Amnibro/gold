fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var clamped = 0;
	for k in g.n {
		if g.res[k] < l {
			g.res[k] = l;
			clamped++;
		} else if g.res[k] > h {
			g.res[k] = h;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped threshold count: ", clamped);
	out
}
