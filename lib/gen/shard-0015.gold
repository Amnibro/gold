code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	let lim = ${cutoff};
	var total = 0;
	while val > 0 {
		let d = val % 10;
		if total + d >= lim {
			return total;
		}
		total += d;
		val /= 10;
	}
	total
}
@end
