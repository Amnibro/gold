test: list=5,10,20,40
expect: => i=3 r=0.0 ok=true s="computed 3 running pairwise differences" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var diffs int[512] = [0; 512];
	let m = g.n - 1;
	for i in m {
		diffs[i] = g.res[i + 1] - g.res[i];
	}
	for i in m {
		g.res[i] = diffs[i];
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "computed ", m, " running pairwise differences");
	out
}
@end
