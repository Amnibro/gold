fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var start = g.n - count;
	if start < 0 { start = 0; }
	for i in start..g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	let mapped = g.n - start;
	g.steps += mapped;
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped suffix items: ", mapped);
	out
}
@end
@entry d9045741c5d85448
kind: step
verb: pair
noun: function
modifier: with_cache
context: loop
phrase: pair values with function {f} using cache in loop
phrase: pair adjacent items with cached function {f} in loop
slot: f fn
test: list=1,2,1,2,3,4 f=double
expect: => i=3 r=0.0 ok=true s="cached paired values: 3" errors=0 n=3 res=[6,6,14] cache=2 hits=1
test: list=2,3,2,3,5,5 f=square
expect: => i=3 r=0.0 ok=true s="cached paired values: 3" errors=0 n=3 res=[25,25,100] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let key = g.res[i] + g.res[i + 1];
		let cached, ok = gold_cache_get(g, key);
		var res_val = 0;
		if ok {
			res_val = cached;
		} else {
			res_val = ${f}(key);
			gold_cache_put(g, key, res_val);
		}
		g.res[kept] = res_val;
		kept++;
		i += 2;
	}
	g.steps += i;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached paired values: ", kept);
	out
}
@end
