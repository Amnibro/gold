phrase: swap adjacent odd numbers up to limit {limit} in sorted sequence
phrase: exchange sorted odd pairs up to boundary {limit}
test: list=9,1,5,3,4,8 limit=6
expect: => i=1 r=0.0 ok=true s="odds swapped: 1" errors=0 n=6 res=[3,1,4,5,8,9] cache=0 hits=0
test: list=7,3,11,1,2 limit=8
expect: => i=1 r=0.0 ok=true s="odds swapped: 1" errors=0 n=5 res=[1,2,7,3,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 != 0 && g.res[i + 1] % 2 != 0 {
			if g.res[i] <= lim && g.res[i + 1] <= lim {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
				i += 2;
				continue;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "odds swapped: ", swaps);
	out
}
@end
