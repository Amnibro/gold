expect: => i=5 r=0.0 ok=false s="split 0 matching items with last 5" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let last = g.res[g.n - 1];
	var pos_arr int[512] = [0; 512];
	var neg_arr int[512] = [0; 512];
	var nm = 0;
	var nnm = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			pos_arr[nm] = g.res[i];
			nm++;
		} else {
			neg_arr[nnm] = g.res[i];
			nnm++;
		}
	}
	for i in nm { g.res[i] = pos_arr[i]; }
	for j in nnm { g.res[nm + j] = neg_arr[j]; }
	g.steps += g.n;
	out.i = last;
	out.ok = nm > 0;
	out.s.clear();
	format(out.s, "split ", nm, " matching items with last ", last);
	out
}
@end
