@entry 8967ea29e626aad6
kind: step
verb: drop
noun: window
modifier: at_least
context: stats
phrase: drop window spikes with variation at least {threshold}
phrase: prune sliding window jumps having difference at least {threshold}
slot: threshold int
test: list=10,12,30,32 threshold=10
expect: => i=1 r=0.0 ok=true s="dropped 1 volatile window spikes" errors=0 n=3 res=[10,12,32] cache=0 hits=0
test: list=5,6,7 threshold=5
expect: => i=0 r=0.0 ok=false s="dropped 0 volatile window spikes" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	if g.n < 2 { return out; }
	var kept = 1;
	var dropped = 0;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff < limit {
			g.res[kept] = g.res[i];
			kept++;
		} else {
			dropped++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.ok = dropped > 0;
	out.s.clear();
	format(out.s, "dropped ", dropped, " volatile window spikes");
	out
}
@end
@entry 3908d51c31199bb6
kind: step
verb: drop
noun: cache
modifier: with_cache
context: stats
phrase: drop duplicate observations using statistics cache
phrase: prune repeated sample values with cache tracking
test: list=10,20,10,30,20
expect: => i=2 r=0.0 ok=true s="dropped 2 duplicate values with cache" errors=0 n=3 res=[10,20,30] cache=3 hits=2
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="dropped 0 duplicate values with cache" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let k = g.res[i];
		let val, found = gold_cache_get(g, k);
		if found {
			dropped++;
		} else {
			gold_cache_put(g, k, 1);
			g.res[kept] = k;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped ", dropped, " duplicate values with cache");
	out
}
@end
