code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var delta_sum = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			delta_sum += abs(g.res[i + 1] - g.res[i]);
		}
	}
	g.steps += g.n;
	out.i = delta_sum;
	out.s.clear();
	format(out.s, "checkpoint span ", delta_sum);
	out
}
@end
