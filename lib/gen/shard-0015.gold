test: list=10,30,15 max_delta=10
expect: => i=1 r=0.0 ok=true s="limited 1 step transitions" errors=0 n=3 res=[10,20,15] cache=0 hits=0
test: list=5,7,9 max_delta=5
expect: => i=0 r=0.0 ok=true s="limited 0 step transitions" errors=0 n=3 res=[5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let delta = ${max_delta};
	var limited = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > delta {
				g.res[i] = g.res[i - 1] + delta;
				limited++;
			} else if diff < -delta {
				g.res[i] = g.res[i - 1] - delta;
				limited++;
			}
		}
	}
	g.steps += g.n;
	out.i = limited;
	out.ok = true;
	out.s.clear();
	format(out.s, "limited ", limited, " step transitions");
	out
}
@end
