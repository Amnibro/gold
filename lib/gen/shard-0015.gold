kind: step
verb: repeat
noun: series
modifier: sorted
context: math
phrase: repeat series elements maintaining sorted order
phrase: duplicate every item in series sorted
test: list=3,1
expect: => i=4 r=0.0 ok=true s="repeated 4 sorted elements" errors=0 n=4 res=[1,1,3,3] cache=0 hits=0
test: list=5,2,4
expect: => i=6 r=0.0 ok=true s="repeated 6 sorted elements" errors=0 n=6 res=[2,2,4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var buf int[512] = [0; 512];
	for i in g.n {
		buf[i * 2] = g.res[i];
		buf[i * 2 + 1] = g.res[i];
	}
	let total = g.n * 2;
	for i in total {
		g.res[i] = buf[i];
	}
	g.n = total;
	g.steps += total;
	out.i = total;
	out.s.clear();
	format(out.s, "repeated ", total, " sorted elements");
	out
}
@end
