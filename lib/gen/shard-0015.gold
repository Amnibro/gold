fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var running = 0;
	var kept = 0;
	while kept < g.n {
		running += g.res[kept];
		if running > lim { break; }
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept running items: ", kept);
	out
}
