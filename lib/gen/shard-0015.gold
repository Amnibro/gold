fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max ascending streak: ", max_streak);
	out
}
@end
