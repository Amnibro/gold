	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	let limit = ${min_val};
	var w = 0;
	for r in g.n {
		if g.res[r] < limit {
			g.res[w] = g.res[r];
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items");
	out
}
