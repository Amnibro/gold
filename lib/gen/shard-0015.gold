	let exp = ${expected};
	${ID}_fix(g, 0, exp);
	g.steps += g.n;
	out.i = g.errors;
	out
}
recursive fn ${ID}_fix(g Gold&, idx int, target int) {
	if idx >= g.n { return; }
	if g.res[idx] != target {
		gold_fail(g, "condition mismatch");
		g.res[idx] = target;
	}
	${ID}_fix(g, idx + 1, target);
}
@end
@entry ec515ee5f7167a2d
kind: step
verb: swap
noun: subfunction
modifier: last
context: sort
slot: x fn
phrase: swap subfunction {x} into last position
phrase: apply subfunction {x} prior to swapping tail
test: list=9,2,5 x=double
expect: => i=18 r=0.0 ok=true s="applied subfunction to last" errors=0 n=3 res=[2,5,18] cache=0 hits=0
test: list=12,3,8 x=inc
expect: => i=13 r=0.0 ok=true s="applied subfunction to last" errors=0 n=3 res=[3,8,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let last_idx = g.n - 1;
	g.res[last_idx] = ${x}(g.res[last_idx]);
	var k = last_idx;
	while k > 0 && g.res[k] < g.res[k - 1] {
		let tmp = g.res[k];
		g.res[k] = g.res[k - 1];
		g.res[k - 1] = tmp;
		k--;
	}
	g.steps += g.n;
	out.i = g.res[last_idx];
	out.s.clear();
	format(out.s, "applied subfunction to last");
	out
}
@end
