slot: bound int
test: list=10,12,15 bound=5
expect: => i=2 r=0.0 ok=true s="pairwise counter clamped to 2" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=1,20,50 bound=2
expect: => i=2 r=0.0 ok=true s="pairwise counter clamped to 2" errors=0 n=3 res=[1,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	var diff_count = 0;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] { diff_count++; }
	}
	let clamped = if diff_count > bnd { bnd } else { diff_count };
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "pairwise counter clamped to ", clamped);
	out
}
@end
