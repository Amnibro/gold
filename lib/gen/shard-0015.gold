	let limit = ${cap};
	if limit < 0 {
		gold_fail(g, "negative budget");
		out.ok = false;
		return out;
	}
	var tot = 0;
	for k in g.n {
		if tot + g.res[k] <= limit {
			tot += g.res[k];
