phrase: trace moving window sums of size {size} safely
phrase: compute running window total of width {size}
test: list=1,2,3,4,5 size=3
expect: => i=3 r=0.0 ok=true s="calculated 3 window sums" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=2,4,6 size=2
expect: => i=2 r=0.0 ok=true s="calculated 2 window sums" errors=0 n=2 res=[6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n < w { return out; }
	var m = g.n - w + 1;
	var sums int[512] = [0; 512];
	for i in m {
		var s = 0;
		for j in w {
			s += g.res[i + j];
		}
		sums[i] = s;
	}
	for i in m {
		g.res[i] = sums[i];
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "calculated ", m, " window sums");
	out
}
@end
@entry 789a8fc57518ff94
kind: step
