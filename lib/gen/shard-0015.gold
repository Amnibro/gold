fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${limit};
	var streak = 0;
	var resets = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			streak++;
			if streak > max_s {
				g.res[i] = 0;
				resets++;
				streak = 0;
			}
		} else {
			streak = 0;
		}
	}
	g.steps += g.n;
	out.i = resets;
	out.s.clear();
	format(out.s, "retried streak with ", resets, " resets");
	out
}
@end
