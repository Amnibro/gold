noun: items
modifier: with_cache
context: search
phrase: sort items caching comparisons in memo
phrase: order search elements with comparison cache
test: list=15,3,9,1,12
expect: => i=5 r=0.0 ok=true s="sorted with cache comparisons" errors=0 n=5 res=[1,3,9,12,15] cache=9 hits=0
test: list=8,4,6,2
expect: => i=4 r=0.0 ok=true s="sorted with cache comparisons" errors=0 n=4 res=[2,4,6,8] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			let a = g.res[j];
			let b = g.res[j + 1];
			let key = a * 1000 + b;
			gold_cache_put(g, key, if a > b { 1 } else { 0 });
			if a > b {
				g.res[j] = b;
				g.res[j + 1] = a;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted with cache comparisons");
	out
}
@end
