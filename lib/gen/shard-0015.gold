fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_idx};
	let e = ${end_idx};
	if s < 0 || e >= g.n || s > e {
		gold_fail(g, "invalid slice boundaries");
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = s;
	while i <= e {
		sum += g.res[i];
		i++;
	}
	g.steps += (e - s + 1);
	out.i = sum;
	out
}
