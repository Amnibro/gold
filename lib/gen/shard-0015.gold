fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var bound = ${lim};
	if bound > g.n { bound = g.n; }
	var idx = -1;
	for i in bound {
		if g.res[i] == t {
			idx = i;
			break;
		}
	}
	out.ok = idx >= 0;
	out.i = idx;
	out.s.clear();
	if idx >= 0 {
		format(out.s, "found number up to limit at ", idx);
	} else {
		format(out.s, "number not found up to limit");
	}
	out
}
@end
@entry 87dd818dbc8d208e
kind: step
verb: dedupe
noun: function
modifier: any
context: search
phrase: dedupe search results under function {f}
phrase: remove duplicate keys mapped by {f}
slot: f fn
test: list=2,3,4,5,6 f=halve
expect: => i=3 r=0.0 ok=true s="deduped results under function" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=10,11,20,21 f=double
expect: => i=4 r=0.0 ok=true s="deduped results under function" errors=0 n=4 res=[10,11,20,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var keys int[512] = [0; 512];
	var kept = 0;
	for i in g.n {
		let k = ${f}(g.res[i]);
		var seen = false;
		for j in kept {
			if keys[j] == k || g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			keys[kept] = k;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped results under function");
	out
}
@end
