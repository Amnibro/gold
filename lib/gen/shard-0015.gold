test: list=9,2,4,7 factor=2
expect: => i=2 r=0.0 ok=true s="squares sorted and scaled: 2" errors=0 n=4 res=[2,8,7,18] cache=0 hits=0
test: list=16,5,1 factor=3
expect: => i=2 r=0.0 ok=true s="squares sorted and scaled: 2" errors=0 n=3 res=[3,5,48] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sq_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[k] *= f;
				sq_cnt++;
			}
		}
	}
	g.steps += g.n;
	out.i = sq_cnt;
	out.s.clear();
	format(out.s, "squares sorted and scaled: ", sq_cnt);
	out
}
@end
