kind: step
verb: measure
noun: pairs
modifier: with_retry
context: transform
slot: threshold int
phrase: measure adjacent pairs with retry threshold {threshold}
phrase: check pair differences with retry limit {threshold}
test: list=10,12,18,22 threshold=5
expect: => i=1 r=0.0 ok=false s="measured pairs exceeding: 1" errors=0 n=4 res=[10,12,18,22] cache=0 hits=0
test: list=2,4,8,12 threshold=3
expect: => i=2 r=0.0 ok=false s="measured pairs exceeding: 2" errors=0 n=4 res=[2,4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var exceed = 0;
	let th = ${threshold};
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let d = abs(g.res[i + 1] - g.res[i]);
			if d > th { exceed++; }
		}
	}
	g.steps += g.n;
	out.i = exceed;
	out.ok = exceed == 0;
	out.s.clear();
	format(out.s, "measured pairs exceeding: ", exceed);
	out
}
@end
