fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_freq};
	var low_freq_count = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq <= cap { low_freq_count++; }
	}
	g.steps += g.n * g.n;
	out.i = low_freq_count;
	out.ok = low_freq_count > 0;
	out.s.clear();
	format(out.s, "found ", low_freq_count, " items with frequency at most cap");
	out
}
@end
@entry da65d3004e8de88b
kind: step
verb: sum
noun: step
modifier: with_retry
context: stats
phrase: sum sequential step variations with retry allowance {retries}
phrase: accumulate step differences across sample with retry bound {retries}
slot: retries int
test: list=10,15,12,20 retries=2
expect: => i=13 r=0.0 ok=true s="summed steps to total 13" errors=0 n=4 res=[10,15,12,20] cache=0 hits=0
test: list=10,8,6 retries=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var allowed = ${retries};
	var total_step = 0;
	var valid_steps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff >= 0 {
				total_step += diff;
				valid_steps++;
			} else {
				if allowed > 0 {
					allowed--;
				} else {
					gold_fail(g, "retry budget exhausted on negative step");
					out.ok = false;
					out.i = total_step;
					return out;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = total_step;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed steps to total ", total_step);
	out
}
@end
@entry 949e5363fafca180
kind: step
verb: group
noun: sequence
modifier: times
context: stats
phrase: group sample sequence {chunk_size} times into chunks
phrase: partition sequence into blocks grouped {chunk_size} times
slot: chunk_size int
test: list=2,3,4,5,6,7 chunk_size=2
expect: => i=3 r=0.0 ok=true s="grouped sequence into 3 chunks" errors=0 n=3 res=[5,9,13] cache=0 hits=0
test: list=10,20,30,40 chunk_size=3
expect: => i=2 r=0.0 ok=true s="grouped sequence into 2 chunks" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 || g.n == 0 { return out; }
	var groups = 0;
	var kept = 0;
	var cur_sum = 0;
	var cur_cnt = 0;
	for i in g.n {
		cur_sum += g.res[i];
		cur_cnt++;
		if cur_cnt == sz {
			g.res[kept] = cur_sum;
			kept++;
			groups++;
			cur_sum = 0;
			cur_cnt = 0;
		}
	}
	if cur_cnt > 0 {
		g.res[kept] = cur_sum;
		kept++;
		groups++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = groups;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped sequence into ", groups, " chunks");
	out
}
@end
