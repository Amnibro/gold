@entry 0b3b602a9cae5cf2
kind: step
verb: cache
noun: tally
modifier: sorted
context: error
slot: cap int
phrase: cache tally of sorted error frequencies under limit {cap}
phrase: record sorted error count tally into cache up to {cap}
test: list=1,2,2,3,3,3 cap=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=0
test: list=5,1 cap=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		i++;
	}
	if !is_sorted {
		gold_fail(g, "list must be sorted to cache tally");
		out.ok = false;
		return out;
	}
	var distinct = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var count = 0;
		while idx < g.n && g.res[idx] == x {
			count++;
			idx++;
		}
		gold_cache_put(g, x, count);
		distinct++;
	}
	g.steps += g.n;
	out.i = distinct;
	out
}
