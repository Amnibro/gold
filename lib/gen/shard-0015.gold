expect: => i=30 r=0.0 ok=false s="budget deficient" errors=0 n=3 res=[5,15,10] cache=1 hits=0
test: list=100 min_b=100
expect: => i=100 r=0.0 ok=true s="budget sufficient" errors=0 n=1 res=[100] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_b};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let ok = total >= req;
	gold_cache_put(g, total, if ok { 1 } else { 0 });
	g.steps += g.n;
	out.ok = ok;
	out.i = total;
	out.s.clear();
	format(out.s, if ok { "budget sufficient" } else { "budget deficient" });
	out
}
@end
@entry 87800f808f900b9f
kind: step
verb: dedupe
noun: maximum
modifier: in_place
context: cache
phrase: dedupe retaining maximum occurrence of each element in place
phrase: condense values in place retaining unique maximum keys
test: list=10,20,10,30,20
expect: => i=30 r=0.0 ok=true s="max value 30" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,5,5,5
expect: => i=5 r=0.0 ok=true s="max value 5" errors=0 n=1 res=[5] cache=1 hits=0
test: list=8,2,4,8
expect: => i=8 r=0.0 ok=true s="max value 8" errors=0 n=3 res=[8,2,4] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var nu = 0;
	var max_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		let x = g.res[i];
		if x > max_val { max_val = x; }
		var seen = false;
		for j in nu { if u[j] == x { seen = true; break; } }
		if !seen && nu < 512 { u[nu] = x; nu++; }
	}
	gold_clear(g);
	for i in nu {
		gold_push(g, u[i]);
		gold_cache_put(g, u[i], max_val);
	}
	g.steps += g.n * nu;
	out.i = max_val;
	out.s.clear();
	format(out.s, "max value ", max_val);
	out
}
@end
