phrase: record pair differences across sorted results
test: list=9,2,5,1
expect: => i=3 r=0.0 ok=true s="recorded 3 sorted pair gaps" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=10,20,15
expect: => i=2 r=0.0 ok=true s="recorded 2 sorted pair gaps" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var m = g.n - 1;
	for i in m {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = m;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recorded ", g.n, " sorted pair gaps");
	out
}
@end
