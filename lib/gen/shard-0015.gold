code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in kept {
			if g.res[j] == x { dup = true; break; }
		}
		if !dup {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped items pairwise");
	out
}
@end
