fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	let reps = max(1, ${count});
	for r in 1..reps {
		for i in orig_n {
			gold_push(g, g.res[i]);
		}
	}
	g.steps += orig_n * reps;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected items ", reps, " times");
	out
}
