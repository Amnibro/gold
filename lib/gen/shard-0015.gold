expect: => i=2 r=0.0 ok=true s="primes shifted front" errors=0 n=4 res=[7,11,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var others int[512] = [0; 512];
	var pn = 0;
	var on = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			primes[pn] = g.res[i];
			pn++;
		} else {
			others[on] = g.res[i];
			on++;
		}
	}
	for j in pn { g.res[j] = primes[j]; }
	for j in on { g.res[pn + j] = others[j]; }
	g.steps += g.n;
	out.i = pn;
	out.s.clear();
	format(out.s, "primes shifted front");
	out
}
@end
@entry 723624bc97507d47
kind: step
verb: collect
noun: value
modifier: at_least
context: loop
slot: min_val int
phrase: collect value at least threshold {min_val}
phrase: gather all entries meeting at least {min_val}
test: list=1,10,2,20,3,30 min_val=15
expect: => i=2 r=0.0 ok=true s="values collected" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=5,8,12 min_val=10
expect: => i=1 r=0.0 ok=true s="values collected" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept int[512] = [0; 512];
	var kn = 0;
	for i in g.n {
		if g.res[i] >= mv {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	for j in kn { g.res[j] = kept[j]; }
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "values collected");
	out
}
@end
