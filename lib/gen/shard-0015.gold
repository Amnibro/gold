code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	while count < 100 && !${p}(out.i) {
		out.i = core_collatz(out.i);
		gold_push(g, out.i);
		count++;
	}
	g.steps += count;
	out.s.clear();
	format(out.s, "steps until stop");
	out
}
@end
