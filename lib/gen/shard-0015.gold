fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var collapsed byte[>..] = [];
	var in_space = false;
	var removed = 0;
	for b in v.s {
		if b == ' ' {
			if !in_space {
				collapsed.push(b);
				in_space = true;
			} else {
				removed++;
			}
		} else {
			collapsed.push(b);
			in_space = false;
		}
	}
	out.s.clear();
	for b in collapsed {
		if out.s.len < 200 { out.s.push(b); }
	}
	g.steps += v.s.len;
	out.i = removed;
	out
}
@end
