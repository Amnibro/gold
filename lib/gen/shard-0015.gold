@entry 68aeb277132079be
kind: step
verb: count
noun: streak
modifier: up_to
context: transform
slot: max_len int
phrase: count identical streak length up to {max_len}
phrase: measure repeating streak up to {max_len}
test: list=3,3,3,3,5,5 max_len=3
expect: => i=3 r=0.0 ok=true s="streak length 3" errors=0 n=6 res=[3,3,3,3,5,5] cache=0 hits=0
test: list=7,7,7,7,7 max_len=4
expect: => i=4 r=0.0 ok=true s="streak length 4" errors=0 n=5 res=[7,7,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var streak = 1;
	var max_seen = 1;
	let cap = ${max_len};
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			streak++;
			if streak > max_seen { max_seen = streak; }
		} else {
			streak = 1;
		}
	}
	let result = min(max_seen, cap);
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "streak length ", result);
	out
}
@end
