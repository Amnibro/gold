		return out;
	}
	let last = g.res[g.n - 1];
	for i in 1..g.n {
		g.res[g.n - i] = g.res[g.n - 1 - i];
	}
	g.res[0] = last;
	out.i = 1;
	out.s.clear();
	format(out.s, "shifted right 1");
	out
}
@end
