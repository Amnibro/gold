fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var no = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && no < 512 { odds[no] = x; no++; }
	}
	gold_clear(g);
	let pairs = if no > 1 { no - 1 } else { 0 };
	for i in pairs {
		let diff = odds[i + 1] - odds[i];
		gold_push(g, diff);
		gold_cache_put(g, i, diff);
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise odds ", pairs);
	out
}
@end
