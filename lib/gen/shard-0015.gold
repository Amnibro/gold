noun: values
modifier: unique
context: list
phrase: keep values unique removing duplicate list items
phrase: list keep values unique deduplicating elements
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="unique values kept: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,10
expect: => i=2 r=0.0 ok=true s="unique values kept: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for i in g.n {
		var seen = false;
		for j in m {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[m] = g.res[i];
			m++;
		}
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "unique values kept: ", m);
	out
}
@end
@entry 0f45aa4f1faca52b
kind: step
verb: retry
noun: head
modifier: until
context: list
slot: cond pred
phrase: retry head until condition {cond} matches on list
phrase: step retry head until predicate {cond} is satisfied
test: list=1,3,4,5 cond=is_even
expect: => i=2 r=0.0 ok=true s="head matched remaining: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
