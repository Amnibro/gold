fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnews(g, "upper", "L", o);
	o.append(" bone ");
	gold_fnum(o, ${a} * 0.2);
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" ");
	gold_fnum(o, ${a} * 0.5);
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.8);
	o.append(" ^");
	o.append(last);
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "lower", "L", o);
	o.append(" bone ");
	gold_fnum(o, ${a} * 0.5);
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.8);
	o.append(" ");
	gold_fnum(o, ${a} * 0.7);
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.4);
	o.append(" ^");
	o.append("upper"); format(o, g.dn);
	o.push('L');
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "addarmrelax");
	out
}
@end
