kind: step
verb: measure
noun: number
modifier: with_cache
context: list
slot: key int
phrase: measure number with cache lookup {key} in list
phrase: list measure number with cache key {key}
test: list=2,4,6 key=1
expect: => i=12 r=0.0 ok=true s="measured cache value: 12" errors=0 n=3 res=[2,4,6] cache=1 hits=0
test: list=10,20 key=2
expect: => i=30 r=0.0 ok=true s="measured cache value: 30" errors=0 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached, hit = gold_cache_get(g, k);
	if hit {
		out.i = cached;
	} else {
		var tot = 0;
		for i in g.n { tot += g.res[i]; }
		gold_cache_put(g, k, tot);
		out.i = tot;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "measured cache value: ", out.i);
	out
}
@end
