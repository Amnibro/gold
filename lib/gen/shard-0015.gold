		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let pairs = g.n / 2;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "sorted pairs count: ", pairs);
	out
}
@end
@entry d52ce212f91a6ecf
kind: step
verb: swap
noun: squares
modifier: until
context: sort
slot: limit int
phrase: swap adjacent perfect squares in sorted sequence until limit {limit}
phrase: exchange sorted square elements until reaching bound {limit}
test: list=9,1,4,16,5 limit=10
expect: => i=1 r=0.0 ok=true s="squares swapped: 1" errors=0 n=5 res=[4,1,5,9,16] cache=0 hits=0
test: list=25,4,1,36 limit=20
expect: => i=1 r=0.0 ok=true s="squares swapped: 1" errors=0 n=4 res=[4,1,25,36] cache=0 hits=0
code:
fn ${ID}_is_sq(x int) bool {
	if x < 0 { return false; }
	var i = 0;
	while i * i <= x {
		if i * i == x { return true; }
		i++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${ID}_is_sq(g.res[i]) && ${ID}_is_sq(g.res[i + 1]) {
			if g.res[i] <= lim && g.res[i + 1] <= lim {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
				i += 2;
				continue;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "squares swapped: ", swaps);
	out
}
@end
