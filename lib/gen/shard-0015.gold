code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let prod = g.res[i] * g.res[i + 1] * mult;
		gold_cache_put(g, i, prod);
		pairs++;
		i += 2;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached ", pairs, " scaled pairwise products");
	out
}
@end
