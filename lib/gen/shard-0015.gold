code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tot = 0;
	for k in g.n {
		g.res[k] = ${f}(g.res[k]);
		tot += g.res[k];
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "subfunction trace sum: ", tot);
	out
}
@end
