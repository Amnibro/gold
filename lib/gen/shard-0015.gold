code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var kept = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
			count++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = count;
	out.ok = count > 0;
	out.s.clear();
	format(out.s, "found ", count, " matches");
	out
}
@end
@entry 20133c284e861e25
kind: step
verb: trace
noun: steps
modifier: unique
context: math
phrase: trace count of unique values in results
phrase: count unique steps appearing in sequence
test: list=10,20,10,30,20
expect: => i=3 r=0.0 ok=true s="found 3 unique values" errors=0 n=5 res=[10,20,10,30,20] cache=0 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="found 1 unique values" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { unique_count++; }
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "found ", unique_count, " unique values");
	out
}
@end
@entry e569bfec0728d98e
kind: step
verb: filter
noun: numbers
modifier: sorted
context: math
slot: min_val int
phrase: filter numbers keeping values above {min_val} sorted
phrase: retain numbers exceeding {min_val} in sorted order
test: list=40,10,30,50,20 min_val=25
expect: => i=3 r=0.0 ok=true s="retained 3 sorted numbers" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=15,5,8 min_val=10
expect: => i=1 r=0.0 ok=true s="retained 1 sorted numbers" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_val};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " sorted numbers");
	out
}
@end
@entry ed32efe8986e4de3
kind: step
verb: trace
noun: suffix
modifier: times
context: math
slot: count int
phrase: trace suffix repeating final element {count} times
phrase: duplicate trailing suffix element {count} times
test: list=4,9 count=3
expect: => i=5 r=0.0 ok=true s="repeated suffix 3 times" errors=0 n=5 res=[4,9,9,9,9] cache=0 hits=0
test: list=7 count=2
