@entry e28987f478cc5361
kind: step
verb: retry
noun: average
modifier: every_other
context: loop
phrase: retry average of every other loop item with {delta}
phrase: retry every other loop value average adding {delta}
slot: delta int
test: list=-10,5,-20,8 delta=15
expect: => i=0 r=0.0 ok=true s="every other average: 0" errors=0 n=4 res=[5,5,-5,8] cache=0 hits=0
test: list=-5,2,-1,4 delta=5
expect: => i=2 r=0.0 ok=true s="every other average: 2" errors=0 n=4 res=[0,2,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var sum = 0;
	var cnt = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		cnt++;
		i += 2;
	}
	var avg = if cnt > 0 { sum / cnt } else { 0 };
	var retried = 0;
	if avg < 0 {
		var j = 0;
		while j < g.n {
			g.res[j] = g.res[j] + d;
			j += 2;
		}
		retried = 1;
		sum = 0;
		j = 0;
		while j < g.n {
			sum += g.res[j];
			j += 2;
		}
		avg = if cnt > 0 { sum / cnt } else { 0 };
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "every other average: ", avg);
	out
}
@end
