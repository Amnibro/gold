expect: => i=2 r=0.0 ok=true s="reversed prefix 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
test: list=1,2 k=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count < 0 || count > g.n {
		gold_fail(g, "invalid prefix length");
		out.ok = false;
		return out;
	}
	var i = 0;
	var j = count - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed prefix ", count);
	out
}
@end
