@entry 4f1d0779ea70733f
kind: step
verb: reverse
noun: numbers
modifier: times
context: stats
phrase: reverse numbers times scale factor {factor}
phrase: invert observation order multiplied by {factor}
slot: factor int
test: list=1,2,3,4 factor=5
expect: => i=4 r=0.0 ok=true s="reversed 4 numbers scaled by 5" errors=0 n=4 res=[20,15,10,5] cache=0 hits=0
test: list=10,20,30 factor=2
expect: => i=3 r=0.0 ok=true s="reversed 3 numbers scaled by 2" errors=0 n=3 res=[60,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left] * mult;
		g.res[left] = g.res[right] * mult;
		g.res[right] = tmp;
		left++;
		right--;
	}
	if left == right {
		g.res[left] = g.res[left] * mult;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " numbers scaled by ", mult);
	out
}
@end
