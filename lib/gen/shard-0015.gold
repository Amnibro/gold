fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	var i = 0;
	while (i + 2) < g.n {
		if g.res[i + 2] <= g.res[i] { ok = false; break; }
		i += 2;
	}
	gold_cache_put(g, 0, if ok { 1 } else { 0 });
	g.steps += g.n;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, if ok { "alternating increasing" } else { "not increasing" });
	out
}
@end
