fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_diff = 0;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			total_diff += diff;
		}
	}
	out.i = total_diff;
	out.s.clear();
	format(out.s, "folded pair differences sum: ", total_diff);
	out
}
