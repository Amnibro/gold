phrase: locate pair combinations matching {target_sum}
slot: target_sum int
test: list=1,2,3,4,5 target_sum=6
expect: => i=2 r=0.0 ok=true s="matching sorted pairs: 2" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=2,4,6,8 target_sum=10
expect: => i=2 r=0.0 ok=true s="matching sorted pairs: 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_sum};
	var pairs_count = 0;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let s = g.res[left] + g.res[right];
		if s == tgt {
			pairs_count++;
			left++;
			right--;
		} else if s < tgt {
			left++;
		} else {
			right--;
		}
	}
	g.steps += g.n;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "matching sorted pairs: ", pairs_count);
	out
}
@end
