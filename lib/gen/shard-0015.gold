@entry a058473ee64a9608
kind: step
verb: sort
noun: step
modifier: at_least
context: format
phrase: format sorted step records aligned to at least {width} width
phrase: render sorted step string padded to at least {width} size
slot: width int
test: list=7,1,4 width=18
expect: => i=3 r=0.0 ok=true s="sorted: [1, 4, 7] " errors=0 n=3 res=[7,1,4] cache=0 hits=0
test: list=9,3 width=12
expect: => i=2 r=0.0 ok=true s="sorted: [3, 9]" errors=0 n=2 res=[9,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_sort_step_at_least = 0;
	out.s.clear();
	var buf int[64] = [0; 64];
	let n = if g.n < 64 { g.n } else { 64 };
	for i in n { buf[i] = g.res[i]; }
	var i = 0;
	while i < n {
		var j = i + 1;
		while j < n {
			if buf[j] < buf[i] {
				let t = buf[i];
				buf[i] = buf[j];
				buf[j] = t;
			}
			j++;
		}
		i++;
	}
	format(out.s, "sorted: [");
	for k in n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, buf[k]);
	}
	format(out.s, "]");
	let w = ${width};
	while out.s.len < w { out.s.push(' '); }
	out.i = n;
	g.steps += n;
	out
}
@end
@entry 780bed836b0967b3
kind: step
verb: dedupe
noun: checkpoint
modifier: between
context: format
phrase: format unique checkpoints between {low} and {high}
phrase: render deduplicated checkpoints between {low} and {high}
slot: low int
slot: high int
test: list=5,12,12,18,25 low=10 high=20
expect: => i=2 r=0.0 ok=true s="checkpoints: [12, 18]" errors=0 n=5 res=[5,12,12,18,25] cache=0 hits=0
test: list=2,8,8,14 low=5 high=15
expect: => i=2 r=0.0 ok=true s="checkpoints: [8, 14]" errors=0 n=4 res=[2,8,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_dedupe_checkpoint_between = 0;
	out.s.clear();
	let lo = ${low};
	let hi = ${high};
	format(out.s, "checkpoints: [");
	var seen int[64] = [0; 64];
	var sn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var found = false;
			for j in sn { if seen[j] == x { found = true; break; } }
			if !found && sn < 64 {
				seen[sn] = x;
				if sn > 0 { format(out.s, ", "); }
				format(out.s, x);
				sn++;
			}
		}
	}
	format(out.s, "]");
	out.i = sn;
	g.steps += g.n;
	out
}
@end
