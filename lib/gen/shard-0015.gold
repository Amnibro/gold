@entry 6cd0579ff5faa80c
kind: step
verb: return
noun: duplicates
modifier: recursively
context: search
phrase: return duplicates recursively found throughout search results
phrase: collect duplicate items recursively in search list
test: list=1,2,2,3,4,4,5
expect: => i=2 r=0.0 ok=true s="duplicate items collected: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20,30,40
expect: => i=0 r=0.0 ok=true s="duplicate items collected: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var already = false;
			for k in kept {
				if g.res[k] == x { already = true; break; }
			}
			if !already {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "duplicate items collected: ", kept);
	out
}
@end
@entry 8fab6506d324354c
kind: step
verb: rank
noun: item
modifier: between
context: search
slot: lo int
slot: hi int
