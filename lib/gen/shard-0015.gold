@entry 39631c9c4601aa98
kind: step
verb: sort
noun: counter
modifier: sorted
context: cache
phrase: sort counter frequencies into ascending order
phrase: arrange counted frequencies into sorted list
test: list=10,20,20,30,30,30
expect: => i=3 r=0.0 ok=true s="sorted 3 counters" errors=0 n=3 res=[1,2,3] cache=3 hits=0
test: list=5,5,5,8,8
expect: => i=2 r=0.0 ok=true s="sorted 2 counters" errors=0 n=2 res=[2,3] cache=2 hits=0
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="sorted 3 counters" errors=0 n=3 res=[1,1,1] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var freq int[512] = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var pos = -1;
		for j in nu { if u[j] == x { pos = j; break; } }
		if pos >= 0 {
			freq[pos]++;
		} else if nu < 512 {
			u[nu] = x; freq[nu] = 1; nu++;
		}
	}
	for i in nu {
		for j in (nu - 1) {
			if freq[j] > freq[j + 1] {
				let tf = freq[j]; freq[j] = freq[j + 1]; freq[j + 1] = tf;
				let tu = u[j]; u[j] = u[j + 1]; u[j + 1] = tu;
			}
		}
	}
	gold_clear(g);
	for i in nu {
		gold_push(g, freq[i]);
		gold_cache_put(g, u[i], freq[i]);
	}
	g.steps += nu * nu;
	out.i = nu;
	out.s.clear();
	format(out.s, "sorted ", nu, " counters");
	out
}
@end
