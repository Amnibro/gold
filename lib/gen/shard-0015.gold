code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var count = 0;
	for i in g.n {
		if g.res[i] < l {
			g.res[i] = l;
			count++;
		} else if g.res[i] > h {
			g.res[i] = h;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "numbers clamped");
	out
}
@end
