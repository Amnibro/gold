@entry dd3d04096ef23acc
kind: step
verb: fold
noun: budget
modifier: safely
context: search
slot: budget int
phrase: fold budget safely accumulating up to {budget}
phrase: accumulate search items safely under budget {budget}
test: list=5,10,15,20 budget=25
expect: => i=15 r=0.0 ok=true s="budget safely folded: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,3,4 budget=15
expect: => i=9 r=0.0 ok=true s="budget safely folded: 9" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var tot = 0;
	var kept = 0;
	while kept < g.n {
		if tot + g.res[kept] > b { break; }
		tot += g.res[kept];
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = tot;
	out.s.clear();
	format(out.s, "budget safely folded: ", tot);
	out
}
@end
