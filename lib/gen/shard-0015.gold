code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " runs");
	out
}
@end
