fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_val = ${cap};
	let lo = ${low};
	let hi = ${high};
	var modified = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			if g.res[i] > max_val {
				g.res[i] = max_val;
				modified++;
			}
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied maximum cap to ", modified, " items");
	out
}
@end
