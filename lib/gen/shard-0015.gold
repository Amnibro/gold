code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var uniq = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			uniq++;
		}
	}
	out.i = uniq;
	out.s.clear();
	format(out.s, "found ", uniq, " distinct values");
	out
}
@end
