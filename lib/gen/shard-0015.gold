@entry f67f706000a33cad
kind: step
verb: normalize
noun: cache
modifier: with_cache
context: stats
phrase: normalize cache with cache table updates
phrase: shift sample with cache baseline normalization
test: list=10,14,18
expect: => i=10 r=0.0 ok=true s="normalized with minimum: 10" errors=0 n=3 res=[0,4,8] cache=3 hits=0
test: list=5,8,12
expect: => i=5 r=0.0 ok=true s="normalized with minimum: 5" errors=0 n=3 res=[0,3,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty sample");
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	for i in g.n {
		let norm = g.res[i] - min_val;
		g.res[i] = norm;
		gold_cache_put(g, i, norm);
	}
	g.steps += g.n * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized with minimum: ", min_val);
	out
}
@end
