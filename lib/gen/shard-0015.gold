modifier: between
context: core
phrase: run streak between {low} and {high} length
phrase: test streak length between {low} and {high}
slot: low int
slot: high int
test: arg=11222,456 low=2 high=4
expect: true
expect: false
test: arg=9999 low=2 high=4
expect: true
code:
fn ${ID}(n int) bool {
	let lo = ${low};
	let hi = ${high};
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		let len = 1;
		return len >= lo && len <= hi;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		if curr == prev {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
		prev = curr;
		x /= 10;
	}
	max_streak >= lo && max_streak <= hi
}
@end
