@entry 0d13c5ed8b66d3dd
kind: step
verb: count
noun: primes
modifier: until
context: sort
slot: limit int
phrase: count primes until reaching cutoff {limit}
phrase: tally prime numbers up to boundary {limit}
test: list=9,4,7,2,8,3,5,11,12 limit=8
expect: => i=4 r=0.0 ok=true s="primes until cutoff: 4" errors=0 n=9 res=[2,3,4,5,7,8,9,11,12] cache=0 hits=0
test: list=15,13,6,17,4,2,3 limit=10
expect: => i=2 r=0.0 ok=true s="primes until cutoff: 2" errors=0 n=7 res=[2,3,4,6,13,15,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	var k = 0;
	while k < g.n && g.res[k] <= cutoff {
		let x = g.res[k];
		var is_p = x > 1;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p { count++; }
		k++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "primes until cutoff: ", count);
	out
}
@end
@entry bc620f4acea3598b
kind: step
verb: check
noun: spaces
modifier: safely
context: sort
slot: max_gap int
phrase: check spaces safely between adjacent items within {max_gap}
phrase: verify spacing across sorted list under {max_gap}
test: list=2,5,9,12 max_gap=5
expect: => i=1 r=0.0 ok=true s="spacing safe: true" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
test: list=1,10,12 max_gap=4
expect: => i=0 r=0.0 ok=false s="spacing safe: false" errors=0 n=3 res=[1,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = true;
		return out;
	}
	let limit = ${max_gap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var safe = true;
	for k in 0..(g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		if diff > limit {
			safe = false;
		}
	}
	out.ok = safe;
	out.i = if safe { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "spacing safe: ", safe);
	out
}
@end
@entry 581906394394c719
kind: step
verb: reverse
noun: checkpoint
modifier: recursively
context: sort
slot: pivot int
phrase: reverse checkpoint recursively around value {pivot}
phrase: invert partitions relative to pivot {pivot}
test: list=10,50,20,40,30 pivot=25
expect: => i=2 r=0.0 ok=true s="partitioned at index: 2" errors=0 n=5 res=[20,10,50,40,30] cache=0 hits=0
test: list=7,1,9,3,8,2 pivot=5
expect: => i=3 r=0.0 ok=true s="partitioned at index: 3" errors=0 n=6 res=[3,2,1,9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var split = 0;
	while split < g.n && g.res[split] < p {
		split++;
	}
	var l = 0;
	var r = split - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	l = split;
	r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n;
	out.i = split;
	out.s.clear();
	format(out.s, "partitioned at index: ", split);
	out
}
@end
