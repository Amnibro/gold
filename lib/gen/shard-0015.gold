code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_join_pairs_sorted = 0;
	out.s.clear();
	format(out.s, "pairs: [");
	var k = 0;
	var pairs_count = 0;
	while k + 1 < g.n {
		let a = g.res[k];
		let b = g.res[k + 1];
		let lo = if a < b { a } else { b };
		let hi = if a > b { a } else { b };
		if pairs_count > 0 { format(out.s, ", "); }
		format(out.s, "(", lo, "-", hi, ")");
		pairs_count++;
		k += 2;
	}
	format(out.s, "]");
	out.i = pairs_count;
	g.steps += g.n;
	out
}
@end
