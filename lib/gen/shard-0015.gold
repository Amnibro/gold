fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative drop count");
		out.ok = false;
		return out;
	}
	let dropped = if k > g.n { g.n } else { k };
	g.n -= dropped;
	g.steps += dropped;
	out.i = g.n;
	out.s.clear();
	format(out.s, "remaining sample size: ", g.n);
	out
}
@end
@entry c39f7bd943598f37
kind: step
verb: sum
noun: runs
modifier: at_least
context: stats
phrase: sum runs at least length {min_run}
phrase: add elements from runs reaching {min_run}
slot: min_run int
test: list=2,2,2,3,4,4 min_run=3
expect: => i=6 r=0.0 ok=true s="summed qualifying runs: 6" errors=0 n=6 res=[2,2,2,3,4,4] cache=0 hits=0
test: list=5,5,7,7 min_run=2
expect: => i=24 r=0.0 ok=true s="summed qualifying runs: 24" errors=0 n=4 res=[5,5,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var total = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == val { j++; }
		let len = j - i;
		if len >= mr { total += val * len; }
		i = j;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed qualifying runs: ", total);
	out
}
@end
