fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	var attempts = 0;
	while sum < 0 && attempts < max_r {
		sum += 10;
		attempts++;
	}
	out.i = sum;
	out.ok = sum >= 0;
	g.steps += g.n + attempts;
	out.s.clear();
	format(out.s, "final sum: ", sum);
	out
}
@end
