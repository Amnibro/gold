@entry 34e82a50aa9496a1
kind: step
verb: collect
noun: gaps
modifier: until
context: loop
slot: target int
phrase: collect gaps until reaching threshold {target}
phrase: gather pairwise step gaps until {target}
test: list=1,4,10,25 target=5
expect: => i=6 r=0.0 ok=true s="collected gaps" errors=0 n=6 res=[1,4,10,25,3,6] cache=0 hits=0
test: list=2,3,5,12 target=4
expect: => i=7 r=0.0 ok=true s="collected gaps" errors=0 n=7 res=[2,3,5,12,1,2,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap >= ${target} {
			gold_push(g, gap);
			break;
		}
		gold_push(g, gap);
		i++;
	}
	g.steps += i;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected gaps");
	out
}
@end
@entry 2821ac9bfb16ea76
kind: step
verb: drop
noun: tally
modifier: with_cache
context: loop
slot: threshold int
phrase: drop tally with cache above {threshold}
phrase: remove cached loop tallies exceeding {threshold}
test: input=5 threshold=15
expect: => i=4 r=0.0 ok=true s="tallies filtered in cache" errors=0 n=0 res=[] cache=4 hits=0
test: input=3 threshold=8
expect: => i=3 r=0.0 ok=true s="tallies filtered in cache" errors=0 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in out.i {
		let val = k * 4;
		if val <= ${threshold} {
			gold_cache_put(g, k, val);
			kept++;
		}
	}
	g.steps += out.i;
	out.i = kept;
	out.s.clear();
	format(out.s, "tallies filtered in cache");
	out
}
@end
@entry d98353dfb92bd237
kind: step
verb: cache
noun: histogram
modifier: in_reverse
context: loop
phrase: cache histogram in reverse loop order
phrase: store frequency histogram in reverse cache
test: list=2,2,3,1,3,3
expect: => i=3 r=0.0 ok=true s="histogram cached reverse" errors=0 n=6 res=[2,2,3,1,3,3] cache=3 hits=3
test: list=5,5,5,1
expect: => i=2 r=0.0 ok=true s="histogram cached reverse" errors=0 n=4 res=[5,5,5,1] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = g.n - 1;
	while i >= 0 {
		let k = g.res[i];
		let cur, ok = gold_cache_get(g, k);
		gold_cache_put(g, k, cur + 1);
		i--;
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "histogram cached reverse");
	out
}
@end
