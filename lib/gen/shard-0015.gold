context: sort
slot: k int
phrase: keep average first items across count {k}
phrase: filter elements exceeding mean of initial {k}
test: list=10,50,20,40,30 k=3
expect: => i=20 r=0.0 ok=true s="kept elements above average: 4" errors=0 n=4 res=[20,30,40,50] cache=0 hits=0
test: list=9,1,4,7,2 k=2
expect: => i=1 r=0.0 ok=true s="kept elements above average: 5" errors=0 n=5 res=[1,2,4,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let limit = if count < g.n { count } else { g.n };
	var sum = 0;
	for i in limit { sum += g.res[i]; }
	let avg = sum / limit;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "kept elements above average: ", kept);
	out
}
@end
