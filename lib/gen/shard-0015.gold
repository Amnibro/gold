fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var doubled int[512] = [0; 512];
	var dn = 0;
	for k in g.n {
		if dn + 2 <= 512 {
			doubled[dn] = g.res[k];
			doubled[dn + 1] = g.res[k];
			dn += 2;
		}
	}
	for i in dn { g.res[i] = doubled[i]; }
	g.n = dn;
	g.steps += dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "pairwise doubled length: ", dn);
	out
}
@end
