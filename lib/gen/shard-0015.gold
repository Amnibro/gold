fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let center = ${mid};
	let rad = ${radius};
	let lo = center - rad;
	let hi = center + rad;
	var clamped = 0;
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			clamped++;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped ", clamped, " items around middle");
	out
}
@end
