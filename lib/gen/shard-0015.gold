noun: item
modifier: unique
context: loop
phrase: scale each unique item by {factor} in loop
phrase: scale distinct items by {factor} across loop
slot: factor int
test: list=1,2,2,3,4,4 factor=5
expect: => i=2 r=0.0 ok=true s="scaled 2 unique items" errors=0 n=6 res=[5,2,2,15,4,4] cache=0 hits=0
test: list=10,20,30,10 factor=2
expect: => i=2 r=0.0 ok=true s="scaled 2 unique items" errors=0 n=4 res=[10,40,60,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var scaled = 0;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt == 1 {
			g.res[i] = g.res[i] * fac;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " unique items");
	out
}
@end
