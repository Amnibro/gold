code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_val = -1;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dup_val = g.res[i];
				break;
			}
		}
		if dup_val >= 0 { break; }
	}
	g.steps += g.n;
	out.i = dup_val;
	out.s.clear();
	format(out.s, "first duplicate found: ", dup_val);
	out
}
@end
