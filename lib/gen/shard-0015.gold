	if g.n == 0 { return out; }
	let start = g.res[0];
	let steps = ${count};
	for k in 1..(steps + 1) {
		gold_push(g, start + k);
	}
	g.steps += steps;
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced sequence to ", g.n, " items");
	out
}
@end
