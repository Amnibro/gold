kind: step
verb: dedupe
noun: range
modifier: any
context: search
slot: lo int
slot: hi int
phrase: dedupe range any items falling between {lo} to {hi}
phrase: prune duplicate search values between {lo} across {hi}
test: list=2,5,5,8,12,12,20 lo=4 hi=15
expect: => i=5 r=0.0 ok=true s="range deduped length: 5" errors=0 n=5 res=[2,5,8,12,20] cache=0 hits=0
test: list=1,1,2,2 lo=5 hi=10
expect: => i=4 r=0.0 ok=true s="range deduped length: 4" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "range deduped length: ", kept);
	out
}
@end
