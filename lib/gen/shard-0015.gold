expect: => i=2 r=0.0 ok=true s="paired square count: 2" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=5,2,1
expect: => i=1 r=0.0 ok=true s="paired square count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[pairs] = (a * a) + (b * b);
		pairs++;
		i += 2;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired square count: ", pairs);
	out
}
@end
