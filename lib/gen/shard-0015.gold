	if g.n == 0 { return out; }
	let target = g.res[0];
	var count = 0;
	for i in g.n {
		if g.res[i] == target { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "first item repeated ", count, " times");
	out
}
@end
@entry 9add36f3264b5f40
kind: step
verb: fold
noun: head
modifier: unique
context: math
slot: count int
phrase: fold unique elements from head within {count}
phrase: sum unique values from head up to {count}
test: list=2,3,2,5,7 count=3
expect: => i=5 r=0.0 ok=true s="folded head unique to 5" errors=0 n=5 res=[2,3,2,5,7] cache=0 hits=0
test: list=4,4,4 count=3
expect: => i=4 r=0.0 ok=true s="folded head unique to 4" errors=0 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	let m = if limit < g.n { limit } else { g.n };
	var total = 0;
	for i in m {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { total += g.res[i]; }
	}
	g.steps += m;
	out.i = total;
	out.s.clear();
	format(out.s, "folded head unique to ", total);
	out
}
@end
