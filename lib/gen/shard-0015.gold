fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var i = 0;
	while i + 1 < g.n {
		g.res[i] = g.res[i] * mul;
		g.res[i + 1] = g.res[i + 1] * mul;
		i += 2;
	}
	g.steps += g.n;
	out.i = i / 2;
	out.s.clear();
	format(out.s, "scaled pairs: ", out.i);
	out
}
@end
