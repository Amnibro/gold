fn ${ID}(n int) int {
	// error: scan value at_least item 1
	var x = if n < 0 { -n } else { n };
	var count = 0;
	if x == 0 { return 0; }
	while x > 0 {
		let d = x % 10;
		if d >= 5 { count++; }
		x /= 10;
	}
	count
}
@end
