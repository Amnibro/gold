fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq_cnt++; }
		}
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = sq_cnt;
	out.s.clear();
	format(out.s, "reversed list squares count: ", sq_cnt);
	out
}
@end
