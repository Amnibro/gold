fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_idx = 0;
	var i = 0;
	while i + 1 < g.n {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		gold_cache_put(g, pair_idx, avg);
		pair_idx++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pair_idx;
	out.s.clear();
	format(out.s, "normalized pairs cached: ", pair_idx);
	out
}
