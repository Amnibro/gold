fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var count = 0;
	while count < g.n {
		if total + g.res[count] > lim { break; }
		total += g.res[count];
		count++;
	}
	g.steps += count + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "summed counter until limit: ", total);
	out
}
@end
