code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${bucket_size};
	if bsz <= 0 {
		gold_fail(g, "invalid bucket size");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = 0;
	while i < g.n {
		var cur_min = g.res[i];
		var j = 1;
		while j < bsz && i + j < g.n {
			if g.res[i + j] < cur_min { cur_min = g.res[i + j]; }
			j++;
		}
		if cur_min < 0 {
			gold_fail(g, "negative minimum error code");
		}
		total += cur_min;
		i += bsz;
	}
	g.steps += g.n;
	out.i = total;
	out
}
@end
