fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var sum_delta = 0;
	let m = g.n - 1;
	for i in m {
		let d = g.res[i + 1] - g.res[i];
		sum_delta += d;
		g.res[i] = sum_delta;
	}
	g.n = m;
	g.steps += m;
	out.i = sum_delta;
	out.s.clear();
	format(out.s, "running step total: ", sum_delta);
	out
}
