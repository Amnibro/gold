expect: => i=3 r=0.0 ok=true s="retained 3 unique items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "retained ", new_n, " unique items");
	out
}
@end
