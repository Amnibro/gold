fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var mask = 0;
	while x > 0 {
		let d = x % 10;
		var bit = 1;
		for i in d { bit *= 2; }
		mask = mask | bit;
		x /= 10;
	}
	var count = 0;
	while mask > 0 {
