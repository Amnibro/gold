fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need pair");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = g.res[i] + g.res[i + 1];
	}
	g.n--;
	out.i = g.n;
	out.s.clear();
	format(out.s, "combined ", g.n, " pairs");
	out
}
@end
