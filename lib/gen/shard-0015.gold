code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let cnt = g.n - 1;
	var prod int[512] = [0; 512];
	for i in cnt {
		let p = g.res[i] * g.res[i + 1];
		prod[i] = p;
		gold_cache_put(g, i, p);
	}
	gold_clear(g);
	for i in cnt { gold_push(g, prod[i]); }
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "traced ", cnt, " pairs");
	out
}
@end
