test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var dupes = 0;
	for i in g.n {
		let x = g.res[i];
		let c, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, c + 1);
			dupes++;
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "dupes ", dupes);
	out
}
@end
