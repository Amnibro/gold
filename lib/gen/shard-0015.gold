fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			kept[kn] = g.res[i];
			kn++;
		}
		i++;
	}
	for j in kn { g.res[j] = kept[j]; }
	g.n = kn;
	g.steps += i;
	out.i = kn;
	out.s.clear();
	format(out.s, "duplicates dropped");
	out
}
@end
