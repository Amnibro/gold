@entry 6db7ac708fdb1197
kind: fn
verb: split
noun: streak
modifier: safely
context: core
phrase: split streak safely maximum run length
phrase: longest consecutive equal digits run
test: arg=1223334,1234
expect: 3
expect: 1
test: arg=5555
expect: 4
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return 1;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		if curr == prev {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
		prev = curr;
		x /= 10;
	}
	max_streak
}
@end
