expect: => i=1 r=0.0 ok=true s="paired 1 items" errors=0 n=3 res=[30,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_pairs = min(${limit}, g.n / 2);
	var new_n = 0;
	for i in max_pairs {
		g.res[new_n] = g.res[2 * i] + g.res[2 * i + 1];
		new_n++;
	}
	for i in (max_pairs * 2)..g.n {
		g.res[new_n] = g.res[i];
		new_n++;
	}
	g.steps += max_pairs;
	g.n = new_n;
	out.i = max_pairs;
	out.s.clear();
	format(out.s, "paired ", max_pairs, " items");
	out
}
@end
