@entry a487ed7799ffcc76
kind: step
verb: compare
noun: gaps
modifier: nested
context: stats
phrase: compare gaps nested spread across sample
phrase: evaluate difference between minimum maximum gaps
test: list=1,3,8,10
expect: => i=3 r=0.0 ok=true s="gap variation span: 3" errors=0 n=4 res=[1,3,8,10] cache=0 hits=0
test: list=5,6,12
expect: => i=5 r=0.0 ok=true s="gap variation span: 5" errors=0 n=3 res=[5,6,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient sample points");
		return out;
	}
	let first_diff = g.res[1] - g.res[0];
	var min_g = if first_diff < 0 { -first_diff } else { first_diff };
	var max_g = min_g;
	for i in 1..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d < min_g { min_g = abs_d; }
		if abs_d > max_g { max_g = abs_d; }
	}
	let span = max_g - min_g;
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "gap variation span: ", span);
	out
}
@end
