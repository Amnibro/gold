@entry 640bde93e9876013
kind: step
verb: run
noun: window
modifier: each
context: stats
phrase: run rolling window of width {width} on each observation
phrase: compute moving window width {width} for each result
slot: width int
test: list=2,4,6,8 width=2
expect: => i=4 r=0.0 ok=true s="computed rolling window sum of width 2" errors=0 n=4 res=[2,6,10,14] cache=0 hits=0
test: list=5,10,15 width=3
expect: => i=3 r=0.0 ok=true s="computed rolling window sum of width 3" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 || g.n == 0 { return out; }
	var rolled int[512] = [0; 512];
	for i in g.n {
		var sum = 0;
		var start = i - w + 1;
		if start < 0 { start = 0; }
		for j in start..(i + 1) {
			sum += g.res[j];
		}
		rolled[i] = sum;
	}
	for i in g.n { g.res[i] = rolled[i]; }
	g.steps += g.n * w;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed rolling window sum of width ", w);
	out
}
@end
@entry 0277bfbb92a4a233
kind: step
verb: fill
noun: step
modifier: with_retry
context: stats
phrase: fill excessive step differences with retry bound {retries} cap {max_step}
phrase: smooth step variation within limit {max_step} using retry budget {retries}
slot: max_step int
slot: retries int
test: list=10,35,40 max_step=10 retries=2
expect: => i=2 r=0.0 ok=true s="filled 2 excess step jumps" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,50,90 max_step=10 retries=1
expect: => i=1 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_cap = ${max_step};
	var budget = ${retries};
	var adjusted = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > step_cap {
			if budget > 0 {
				g.res[i] = g.res[i - 1] + step_cap;
				budget--;
				adjusted++;
			} else {
				gold_fail(g, "step fill retry budget exhausted");
				out.ok = false;
				out.i = adjusted;
				return out;
			}
			}
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled ", adjusted, " excess step jumps");
	out
}
@end
