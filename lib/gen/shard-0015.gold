expect: => i=2 r=0.0 ok=true s="applied range scaling 2 times" errors=0 n=2 res=[5,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	let it = ${iterations};
	if g.n == 0 { return out; }
	var mn = g.res[0];
	for i in g.n { if g.res[i] < mn { mn = g.res[i]; } }
	for k in it {
		for i in g.n {
			g.res[i] = mn + (g.res[i] - mn) * s;
		}
	}
	g.steps += g.n * it;
	out.i = it;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied range scaling ", it, " times");
	out
}
@end
@entry a4de9f7a7f2e17a3
kind: step
verb: apply
noun: average
modifier: times
context: stats
phrase: apply neighbor average smoothing {times} times
phrase: smooth sample data using average {times} times
slot: times int
test: list=10,20,30 times=1
expect: => i=1 r=0.0 ok=true s="smoothed sequence with average 1 times" errors=0 n=3 res=[10,15,25] cache=0 hits=0
test: list=4,12,20 times=2
expect: => i=2 r=0.0 ok=true s="smoothed sequence with average 2 times" errors=0 n=3 res=[4,6,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let it = ${times};
	if g.n < 2 { return out; }
	for t in it {
		var prev = g.res[0];
		for i in 1..g.n {
			let cur = g.res[i];
			let avg = (prev + cur) / 2;
			g.res[i] = avg;
			prev = cur;
		}
	}
	g.steps += g.n * it;
	out.i = it;
	out.ok = true;
	out.s.clear();
	format(out.s, "smoothed sequence with average ", it, " times");
	out
}
@end
