code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for i in half {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += half;
	out.i = half;
	out.s.clear();
	format(out.s, "swapped ", half, " step pairs");
	out
}
@end
