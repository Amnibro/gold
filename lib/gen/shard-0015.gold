@entry 4ab47f01f12c1466
kind: step
verb: pair
noun: window
modifier: sorted
context: stats
phrase: pair window sorted elements with size {w}
phrase: compute sorted window pairwise spans using width {w}
slot: w int
test: list=10,20,30,40,50 w=3
expect: => i=60 r=0.0 ok=true s="sorted window pairs: 3 total span: 60" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=2,5,9,14,20 w=2
expect: => i=18 r=0.0 ok=true s="sorted window pairs: 4 total span: 18" errors=0 n=5 res=[2,5,9,14,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if g.n < win || win < 2 {
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient elements for window");
		return out;
	}
	var count = 0;
	var diff_sum = 0;
	for i in (g.n - win + 1) {
		let span = g.res[i + win - 1] - g.res[i];
		diff_sum += span;
		count++;
	}
	g.steps += count;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "sorted window pairs: ", count, " total span: ", diff_sum);
	out
}
@end
@entry 0934bb1848010c74
kind: step
verb: scale
noun: pairs
modifier: until
context: stats
phrase: scale pairs until pair sum exceeds {limit}
phrase: multiply adjacent observations until reaching {limit}
slot: limit int
test: list=2,3,5,10,20 limit=15
expect: => i=4 r=0.0 ok=true s="scaled 4 elements before limit" errors=0 n=5 res=[4,6,10,20,20] cache=0 hits=0
test: list=1,2,4,8 limit=10
expect: => i=2 r=0.0 ok=true s="scaled 2 elements before limit" errors=0 n=4 res=[2,4,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var scaled = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if sum > cap { break; }
		g.res[i] = g.res[i] * 2;
		g.res[i + 1] = g.res[i + 1] * 2;
		scaled += 2;
		i += 2;
	}
	g.steps += scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " elements before limit");
	out
}
@end
