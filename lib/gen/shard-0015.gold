	let a = ${i};
	let b = ${j};
	if a >= 0 && a < g.n && b >= 0 && b < g.n {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "swapped safely: ", out.ok);
	out
}
