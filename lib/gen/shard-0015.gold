code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var m = g.n / 2;
	for i in m {
		g.res[i] = g.res[i * 2] + g.res[i * 2 + 1];
	}
	g.steps += g.n;
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "folded into ", m, " sorted pairs");
	out
}
@end
