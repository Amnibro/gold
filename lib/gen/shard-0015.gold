phrase: check increasing streak at least {threshold} in search
slot: threshold int
test: list=1,2,3,1,2,3,4,5 threshold=4
expect: => i=5 r=0.0 ok=true s="streak length 5" errors=0 n=8 res=[1,2,3,1,2,3,4,5] cache=0 hits=0
test: list=5,4,3,2 threshold=3
expect: => i=1 r=0.0 ok=false s="streak length 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var max_streak = 0;
	var cur = 1;
	if g.n > 0 {
		max_streak = 1;
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				cur++;
				if cur > max_streak { max_streak = cur; }
			} else {
				cur = 1;
			}
		}
	}
	out.i = max_streak;
	out.ok = max_streak >= th;
	out.s.clear();
	format(out.s, "streak length ", max_streak);
	out
}
@end
