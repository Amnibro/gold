			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "unique reverse average: ", avg);
	out
}
@end
