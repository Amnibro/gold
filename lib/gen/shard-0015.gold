expect: => i=2 r=0.0 ok=true s="budget ranked items: 2" errors=0 n=3 res=[2,4,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let b = ${budget};
	let cached, hit = gold_cache_get(g, k);
	if hit {
		out.i = cached;
	} else {
		var cnt = 0;
		var running = 0;
		while cnt < g.n {
			if running + g.res[cnt] > b { break; }
			running += g.res[cnt];
			cnt++;
		}
		gold_cache_put(g, k, cnt);
		out.i = cnt;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "budget ranked items: ", out.i);
	out
}
@end
