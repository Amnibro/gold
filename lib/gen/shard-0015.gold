expect: => i=6 r=0.0 ok=true s="odds: [1, 1, 3, 3, 5, 5]" errors=0 n=5 res=[6,3,1,8,5] cache=0 hits=0
test: list=7,9
expect: => i=4 r=0.0 ok=true s="odds: [7, 7, 9, 9]" errors=0 n=2 res=[7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var check_repeat_odds_sorted = 0;
	out.s.clear();
	var odds int[64] = [0; 64];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 && on < 64 {
			odds[on] = g.res[i];
			on++;
		}
	}
	var i = 0;
	while i < on {
		var j = i + 1;
		while j < on {
			if odds[j] < odds[i] {
				let t = odds[i];
				odds[i] = odds[j];
				odds[j] = t;
			}
			j++;
		}
		i++;
	}
	format(out.s, "odds: [");
	var written = 0;
	for k in on {
		if written > 0 { format(out.s, ", "); }
		format(out.s, odds[k], ", ", odds[k]);
		written += 2;
	}
	format(out.s, "]");
	out.i = written;
	g.steps += g.n;
	out
}
@end
