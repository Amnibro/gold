code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		g.res[i] = avg;
		g.res[i + 1] = avg;
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise window normalized");
	out
}
