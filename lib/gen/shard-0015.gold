expect: => i=2 r=0.0 ok=true s="suffix swapped count: 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var span = c;
	if span > g.n { span = g.n; }
	if span > 1 {
		var i = g.n - span;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "suffix swapped count: ", span);
	out
}
@end
