noun: hinge
modifier: radial
context: cad
slot: r real
slot: d real
phrase: drill radial mounting holes in hinge radius {r} depth {d}
phrase: bore radial hinge holes {r} radius {d} deep
test: r=0.003 d=0.012
expect: => i=1 r=0.0 ok=true s="hinge_holes" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: hinge_holes1 cyl 0.03,0,0 0.03,0,-0.012 r0.003 - ra3
test: r=0.005 d=0.018 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="hinge_holes" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: hinge_holes3 cyl 0.03,0,0 0.03,0,-0.018 r0.005 - ra3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "hinge_holes", "", o);
	let h_dep = ${d};
	o.append(" cyl 0.0");
	o.append("3,0,");
	o.append("0 0.");
	o.append("03,");
	o.append("0,-");
	gold_fnum(o, h_dep);
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" - ra3");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "hinge_holes");
	out
}
@end
