slot: d int
test: arg=16,27 d=3
expect: 2
expect: 4
test: arg=4 d=2
expect: 1
code:
fn ${ID}(n int) int {
	let depth = ${d};
	var x = if n < 0 { -n } else { n };
	var k = 0;
	while x > 1 && k < depth {
		if x % 2 == 0 {
			x /= 2;
		} else {
			x = (x + 1) / 2;
		}
		k++;
	}
	x
}
@end
