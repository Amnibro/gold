code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var in_range = true;
	if g.n > 0 {
		if g.res[0] < l || g.res[g.n - 1] > h {
			in_range = false;
		}
	}
	g.steps += g.n;
	out.ok = in_range;
	out.i = if in_range { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all within range: ", out.i);
	out
}
@end
