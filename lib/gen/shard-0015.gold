fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${a} > ${b} { gold_fail(g, "lower bound exceeds upper bound"); out.ok = false; return out; }
	var total = 0;
	var cur = ${a};
	while cur <= ${b} {
