fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = min(${count}, g.n);
	if c == 0 {
		out.i = 0;
		return out;
	}
	let start = g.n - c;
	var m = g.res[start];
	for i in (start + 1)..g.n {
		if g.res[i] < m { m = g.res[i]; }
	}
	g.steps += c;
	out.i = m;
	out.s.clear();
	format(out.s, "minimum in last ", c, " is ", m);
	out
}
@end
