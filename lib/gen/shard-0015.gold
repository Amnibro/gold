test: list=10,3,7,3,9
expect: => i=3 r=0.0 ok=false s="minimum 3 occurs 2 times" errors=0 n=5 res=[10,3,7,3,9] cache=0 hits=0
test: list=5,8,2,9,4
expect: => i=2 r=0.0 ok=true s="minimum 2 is unique" errors=0 n=5 res=[5,8,2,9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == min_val { count++; }
	}
	out.ok = count == 1;
	out.i = min_val;
	out.s.clear();
	if count == 1 {
		format(out.s, "minimum ", min_val, " is unique");
	} else {
		format(out.s, "minimum ", min_val, " occurs ", count, " times");
	}
	out
}
@end
@entry 7e76b896028d7d18
kind: step
verb: dedupe
noun: limit
modifier: pairwise
context: search
phrase: dedupe adjacent equal values pairwise
phrase: remove duplicate neighbors pairwise in search
test: list=3,3,5,5,5,8,3
