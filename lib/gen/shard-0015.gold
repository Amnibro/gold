code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var r = ${retries};
	while g.n > 0 && r > 0 && g.res[g.n - 1] < 0 {
		g.n--;
		r--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered tail with retries remaining ", r);
	out
}
@end
