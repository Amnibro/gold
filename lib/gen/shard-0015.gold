fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var chk = 0;
	if idx >= 0 && idx < g.n {
		chk = g.res[idx];
		out.ok = true;
	} else {
