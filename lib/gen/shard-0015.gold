code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if s <= 0 || g.n == 0 { return out; }
	var running = 0;
	var checkpoints = 0;
	for i in g.n {
		running += g.res[i];
		if (i + 1) % s == 0 {
			checkpoints++;
		}
	}
	out.i = checkpoints;
	out.s.clear();
	format(out.s, "traced running checkpoints: ", checkpoints);
	out
}
@end
