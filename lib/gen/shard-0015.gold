kind: step
verb: return
noun: limit
modifier: up_to
context: search
slot: ceiling int
phrase: return limit up to bound {ceiling} search values
phrase: filter search items up to limit {ceiling}
test: list=5,15,25,35 ceiling=20
expect: => i=2 r=0.0 ok=true s="items under limit count: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
test: list=10,20,30 ceiling=5
expect: => i=0 r=0.0 ok=true s="items under limit count: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var kept = 0;
	for k in g.n {
		if g.res[k] <= lim {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "items under limit count: ", kept);
	out
}
@end
@entry b9b1bfc7933f6ad7
kind: step
verb: trace
noun: series
modifier: none
context: search
phrase: trace series none cumulative difference aggregate
phrase: measure sum of adjacent differences in search series
test: list=1,4,10,15
expect: => i=14 r=0.0 ok=true s="series difference aggregate: 14" errors=0 n=4 res=[1,4,10,15] cache=0 hits=0
test: list=20,10,5
expect: => i=15 r=0.0 ok=true s="series difference aggregate: 15" errors=0 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diff_sum = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			var d = g.res[k + 1] - g.res[k];
			if d < 0 { d = -d; }
			diff_sum += d;
			k++;
		}
	}
	g.steps += g.n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "series difference aggregate: ", diff_sum);
	out
}
@end
@entry 9acb8c5bfd13a7ca
kind: step
verb: rotate
noun: prefix
modifier: none
context: search
slot: count int
phrase: rotate prefix none leading items count {count}
phrase: shift prefix none search elements count {count}
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="rotated prefix elements: 3" errors=0 n=5 res=[2,3,1,4,5] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="rotated prefix elements: 2" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var span = c;
	if span > g.n { span = g.n; }
	if span > 1 {
		let head = g.res[0];
		var k = 0;
		while k + 1 < span {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.res[span - 1] = head;
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "rotated prefix elements: ", span);
	out
}
@end
@entry 148b9964ca568c3d
kind: step
verb: rotate
noun: budget
modifier: each
context: search
slot: budget int
phrase: rotate budget each interval limit {budget}
phrase: cyclic rotate search items within budget {budget}
test: list=1,2,3,4 budget=10
expect: => i=4 r=0.0 ok=true s="rotated within budget items: 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=5,10 budget=2
expect: => i=2 r=0.0 ok=true s="rotated within budget items: 2" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n > 1 && b > 0 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated within budget items: ", g.n);
	out
}
@end
