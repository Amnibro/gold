fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_sz = ${stride};
	if step_sz <= 0 {
		gold_fail(g, "invalid step");
		out.ok = false;
		return out;
	}
	var tot = 0;
	var idx = 0;
	while idx < g.n {
		tot += g.res[idx];
		idx += step_sz;
	}
	out.i = tot;
	out.s.clear();
	format(out.s, "stepped sum ", tot);
	out
}
@end
