fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	var valid = true;
	for i in g.n {
		if g.res[i] > limit { valid = false; break; }
	}
	gold_cache_put(g, limit, if valid { 1 } else { 0 });
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, if valid { "all within max" } else { "exceeds maximum" });
	out
}
@end
