	o.append(" cyl ");
	o.append("0,0,");
	o.append("0 0,");
	o.append("0,0.");
	o.append("06 r");
	gold_fnum(o, ${r});
	o.append(" m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "revspacer");
	out
}
