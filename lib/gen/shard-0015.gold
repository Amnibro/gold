expect: => i=1 r=0.0 ok=true s="maximum streak length: 1" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	if g.n > 0 {
		max_streak = 1;
		var cur = 1;
		var k = 1;
		while k < g.n {
			if g.res[k] == g.res[k - 1] {
				cur++;
				if cur > max_streak { max_streak = cur; }
			} else {
				cur = 1;
			}
			k++;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "maximum streak length: ", max_streak);
	out
}
@end
