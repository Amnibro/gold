fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_len = 0;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i >= 0 && g.res[i] == last_val {
			run_len++;
			i--;
		}
		gold_cache_put(g, last_val, run_len);
	}
	g.steps += run_len + 1;
	out.i = run_len;
	out.s.clear();
	format(out.s, "last run length: ", run_len);
	out
}
