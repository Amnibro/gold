@entry 223ea4d17f1a0275
kind: step
verb: retry
noun: histogram
modifier: pairwise
context: loop
phrase: retry pairwise histogram bins in loop using {threshold}
phrase: retry histogram binning pairwise in loop with {threshold}
slot: threshold int
test: list=10,40,15,60 threshold=20
expect: => i=2 r=0.0 ok=true s="pairwise histogram clamped: 2" errors=0 n=4 res=[10,30,15,35] cache=0 hits=0
test: list=5,8,12,14 threshold=10
expect: => i=0 r=0.0 ok=true s="pairwise histogram clamped: 0" errors=0 n=4 res=[5,8,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n < 2 { return out; }
	var clamped = 0;
	for i in (g.n - 1) {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff > thresh {
			g.res[i + 1] = g.res[i] + thresh;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "pairwise histogram clamped: ", clamped);
	out
}
@end
@entry 3869d290228cc1a9
kind: step
verb: check
noun: item
modifier: in_reverse
context: loop
phrase: check item condition {p} in reverse loop order
phrase: inspect each item in reverse order with {p} in loop
slot: p pred
test: list=2,4,6,8 p=is_even
expect: => i=4 r=0.0 ok=true s="reverse check items: 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=2,4,5,8 p=is_even
expect: => i=2 r=0.0 ok=false s="reverse check items: 2" errors=0 n=4 res=[2,4,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_match = true;
	var cnt = 0;
	var i = g.n - 1;
	while i >= 0 {
		cnt++;
		if !${p}(g.res[i]) {
			all_match = false;
			break;
		}
		i--;
	}
	g.steps += cnt;
	out.ok = all_match;
	out.i = cnt;
	out.s.clear();
	format(out.s, "reverse check items: ", cnt);
	out
}
