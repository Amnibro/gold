@entry 32660f7f29f98a65
kind: step
verb: scale
noun: text
modifier: between
context: stats
phrase: scale text between range bounds {lo} to {hi}
phrase: adjust text characters between limits {lo} to {hi}
slot: lo int
slot: hi int
test: text="abcxyz" lo=97 hi=100
expect: => i=3 r=0.0 ok=true s="bcdxyz" errors=0 n=0 res=[] cache=0 hits=0
test: text="HELLO" lo=65 hi=70
expect: => i=1 r=0.0 ok=true s="HFLLO" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var count = 0;
	var res byte[>..] = [];
	for b in out.s {
		let code = b as int;
		if code >= low && code <= high {
			res.push((code + 1) as byte);
			count++;
		} else {
			res.push(b);
		}
	}
	out.s.clear();
	out.s.append(res);
	out.i = count;
	g.steps += out.s.len;
	out
}
@end
