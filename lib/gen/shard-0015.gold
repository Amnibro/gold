noun: threshold
modifier: in_reverse
context: math
slot: thresh int
phrase: clamp elements above threshold {thresh} in reverse
phrase: reverse list clamping values exceeding {thresh}
test: list=5,12,3,20 thresh=10
expect: => i=4 r=0.0 ok=true s="reversed clamped 4 items" errors=0 n=4 res=[10,3,10,5] cache=0 hits=0
test: list=15,2 thresh=8
expect: => i=2 r=0.0 ok=true s="reversed clamped 2 items" errors=0 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	let half = g.n / 2;
	for i in half {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	for i in g.n {
		if g.res[i] > limit { g.res[i] = limit; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed clamped ", g.n, " items");
	out
}
@end
