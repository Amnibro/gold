kind: step
verb: retry
noun: counter
modifier: unique
context: loop
phrase: retry counter until {target} unique values exist in loop
phrase: retry loop counter until {target} distinct items reached
slot: target int
test: list=1,1,2 target=4
expect: => i=2 r=0.0 ok=true s="added 2 items for unique counter" errors=0 n=5 res=[1,1,2,3,4] cache=0 hits=0
test: list=5,5,5 target=3
expect: => i=2 r=0.0 ok=true s="added 2 items for unique counter" errors=0 n=5 res=[5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${target};
	var added = 0;
	while g.n < 512 {
		var ucnt = 0;
		for i in g.n {
			var seen = false;
			for j in i { if g.res[j] == g.res[i] { seen = true; } }
			if !seen { ucnt++; }
		}
		if ucnt >= req { break; }
		let last_val = if g.n > 0 { g.res[g.n - 1] } else { 0 };
		gold_push(g, last_val + 1);
		added++;
	}
	g.steps += g.n;
	out.i = added;
	out.s.clear();
	format(out.s, "added ", added, " items for unique counter");
	out
}
@end
