code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var bound = ${lim};
	if bound >= g.n { bound = g.n - 1; }
	if bound <= 0 { return out; }
	let first = g.res[0];
	for i in bound {
		g.res[i] = g.res[i + 1];
	}
	g.res[bound] = first;
	out.i = bound;
	out.s.clear();
	format(out.s, "rotated items up to limit");
	out
}
@end
