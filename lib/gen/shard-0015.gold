@entry caf15b914cab7f79
kind: step
verb: select
noun: histogram
modifier: up_to
context: list
slot: max_freq int
phrase: select histogram up to occurrences {max_freq} in list
phrase: list select histogram frequency up to limit {max_freq}
test: list=2,3,2,4,3,2 max_freq=1
expect: => i=1 r=0.0 ok=true s="histogram up to kept: 1" errors=0 n=1 res=[4] cache=0 hits=0
test: list=1,1,2,2,3,3,4 max_freq=2
expect: => i=7 r=0.0 ok=true s="histogram up to kept: 7" errors=0 n=7 res=[1,1,2,2,3,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_freq};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq <= lim {
			g.res[kept] = val;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "histogram up to kept: ", kept);
	out
}
@end
@entry b5c3d56a8706f59f
kind: step
verb: measure
noun: step
modifier: between
context: list
slot: lo int
slot: hi int
phrase: measure step between bounds {lo} through {hi} in list
phrase: list measure step between interval {lo} across {hi}
test: list=1,4,10,12 lo=2 hi=5
expect: => i=2 r=0.0 ok=true s="measured steps in range: 2" errors=0 n=4 res=[1,4,10,12] cache=0 hits=0
test: list=2,10,15,20 lo=6 hi=9
expect: => i=1 r=0.0 ok=true s="measured steps in range: 1" errors=0 n=4 res=[2,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var cnt = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			var diff = g.res[k + 1] - g.res[k];
			if diff < 0 { diff = -diff; }
			if diff >= l && diff <= h { cnt++; }
			k++;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "measured steps in range: ", cnt);
	out
}
@end
@entry a78eb0d5fef1d779
kind: step
