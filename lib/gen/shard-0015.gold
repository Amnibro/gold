kind: step
verb: rotate
noun: squares
modifier: in_place
context: cache
phrase: rotate square cache values in place by {k} positions
phrase: cycle squares of cache in place by {k} steps
slot: k int
test: list=1,2,3,4 k=1
expect: => i=4 r=0.0 ok=true s="rotated 4 squares" errors=0 n=4 res=[4,9,16,1] cache=4 hits=0
test: list=2,3,4,5 k=2
expect: => i=4 r=0.0 ok=true s="rotated 4 squares" errors=0 n=4 res=[16,25,4,9] cache=4 hits=0
test: list=1,2 k=0
expect: => i=2 r=0.0 ok=true s="rotated 2 squares" errors=0 n=2 res=[1,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n == 0 { return out; }
	var sq int[512] = [0; 512];
	let cnt = g.n;
	for i in cnt {
		let val = g.res[i];
		let s = val * val;
		sq[i] = s;
		gold_cache_put(g, i, s);
	}
	gold_clear(g);
	for i in cnt {
		let src_idx = (i + (shift % cnt) + cnt) % cnt;
		gold_push(g, sq[src_idx]);
	}
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "rotated ", cnt, " squares");
	out
}
@end
@entry 388b8bf41f7bbbb5
kind: step
verb: trace
noun: primes
modifier: sorted
context: cache
phrase: trace prime numbers into sorted cache
phrase: record sorted prime factors in cache
test: list=9,4,7,2,11
expect: => i=3 r=0.0 ok=true s="found 3 primes" errors=0 n=3 res=[2,7,11] cache=3 hits=0
test: list=15,13,8,5
expect: => i=2 r=0.0 ok=true s="found 2 primes" errors=0 n=2 res=[5,13] cache=2 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="found 0 primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var np = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { prime = false; break; }
				d++;
			}
			if prime && np < 512 { primes[np] = x; np++; }
		}
	}
	for i in np {
		for j in (np - 1) {
			if primes[j] > primes[j + 1] {
				let tmp = primes[j]; primes[j] = primes[j + 1]; primes[j + 1] = tmp;
			}
		}
	}
	gold_clear(g);
	for i in np {
		gold_push(g, primes[i]);
		gold_cache_put(g, i, primes[i]);
	}
	g.steps += g.n + np * np;
	out.i = np;
	out.s.clear();
	format(out.s, "found ", np, " primes");
	out
}
@end
