			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var sat = false;
	if g.n > 0 {
		sat = ${p}(g.res[0]);
	}
	out.ok = sat;
	out.i = if sat { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "descending prefix sat: ", sat);
	out
}
