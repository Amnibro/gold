@entry 1f985aa720f5eb71
kind: step
verb: map
noun: gaps
modifier: up_to
context: search
phrase: map differences between items up to limit {limit}
phrase: calculate gaps up to boundary {limit}
slot: limit int
test: list=1,5,10,20 limit=2
expect: => i=1 r=0.0 ok=true s="mapped 1 gaps up to limit" errors=0 n=4 res=[4,5,10,20] cache=0 hits=0
test: list=2,10,12,30 limit=3
expect: => i=2 r=0.0 ok=true s="mapped 2 gaps up to limit" errors=0 n=4 res=[8,2,12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	var i = 0;
	while i + 1 < bound {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff < 0 { -diff } else { diff };
		i++;
	}
	g.steps += bound;
	out.i = i;
	out.s.clear();
	format(out.s, "mapped ", i, " gaps up to limit");
	out
}
@end
