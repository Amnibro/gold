fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[>..] = [];
	var stopped = false;
	for i in g.n {
		let x = g.res[i];
		if x <= 0 { stopped = true; }
		if !stopped {
			var exists = false;
			for k in kept.len {
				if kept[k] == x { exists = true; break; }
			}
			if !exists { kept.push(x); }
		} else {
			kept.push(x);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "deduped history size ", kept.len);
	out
}
@end
@entry aa3fd57073880fc8
kind: step
verb: rotate
noun: head
modifier: at_least
context: search
phrase: rotate head search results meeting threshold {cutoff}
phrase: cycle leading search matches with score at least {cutoff}
slot: cutoff int
test: list=50,60,70,10,20 cutoff=40
expect: => i=3 r=0.0 ok=true s="rotated head prefix of 3" errors=0 n=5 res=[60,70,50,10,20] cache=0 hits=0
test: list=100,200,5 cutoff=50
expect: => i=2 r=0.0 ok=true s="rotated head prefix of 2" errors=0 n=3 res=[200,100,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var head_len = 0;
	while head_len < g.n && g.res[head_len] >= cut {
		head_len++;
	}
	if head_len > 1 {
		let first = g.res[0];
		for i in 1..head_len {
			g.res[i - 1] = g.res[i];
		}
		g.res[head_len - 1] = first;
	}
	g.steps += head_len;
	out.i = head_len;
	out.s.clear();
	format(out.s, "rotated head prefix of ", head_len);
	out
}
@end
@entry cebfb2b5d2e6cc28
kind: step
verb: search
noun: step
modifier: pairwise
context: search
phrase: search pairwise step differences for target gap {gap}
phrase: find adjacent item difference matching {gap}
slot: gap int
test: list=10,15,18,25 gap=5
expect: => i=0 r=0.0 ok=true s="pairwise gap index 0" errors=0 n=4 res=[10,15,18,25] cache=0 hits=0
test: list=1,4,9,16 gap=7
expect: => i=2 r=0.0 ok=true s="pairwise gap index 2" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_gap = ${gap};
	var found_idx = -1;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff == target_gap {
			found_idx = i;
			break;
		}
	}
	out.i = found_idx;
	g.steps += if found_idx >= 0 { found_idx + 1 } else { g.n };
	out.s.clear();
	format(out.s, "pairwise gap index ", found_idx);
	out
