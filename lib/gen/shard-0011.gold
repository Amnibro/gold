fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${limit};
	var kept = 0;
	for i in g.n {
		if g.res[i] <= cutoff {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "scanned and kept ", kept, " numbers up to cutoff");
	out
}
@end
