phrase: partition list elements relative to pivot {pivot}
slot: pivot int
test: list=10,2,8,1,9 pivot=5
expect: => i=2 r=0.0 ok=true s="partitioned list with 2 items below pivot" errors=0 n=5 res=[2,1,10,8,9] cache=0 hits=0
test: list=1,3 pivot=0
expect: => i=0 r=0.0 ok=true s="partitioned list with 0 items below pivot" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var lo int[>..] = [];
	var hi int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x < p { lo.push(x); } else { hi.push(x); }
	}
	for i in lo.len { g.res[i] = lo[i]; }
	for i in hi.len { g.res[lo.len + i] = hi[i]; }
	g.steps += g.n;
	out.i = lo.len;
	out.s.clear();
	format(out.s, "partitioned list with ", lo.len, " items below pivot");
	out
}
@end
