@entry e2044c022e7f5475
kind: step
verb: reverse
noun: streak
modifier: in_place
context: list
phrase: reverse longest contiguous streak in place within list
phrase: invert longest identical streak in place for list
test: list=1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="reversed streak of length 3" errors=0 n=5 res=[1,2,2,2,3] cache=0 hits=0
test: list=4,4,5,6,6,6,6,7
expect: => i=4 r=0.0 ok=true s="reversed streak of length 4" errors=0 n=8 res=[4,4,5,6,6,6,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len {
		best_len = cur_len;
		best_start = cur_start;
	}
	var a = best_start;
	var b = best_start + best_len - 1;
	while a < b {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		a++;
		b--;
	}
	g.steps += best_len;
	out.i = best_len;
	out.s.clear();
	format(out.s, "reversed streak of length ", best_len);
	out
}
@end
