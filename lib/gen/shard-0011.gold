fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var kept = 0;
	for i in g.n {
		let transformed = ${x}(g.res[i]);
		if transformed >= lo && transformed <= hi {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "subfunction filtered count=", g.n);
	out
}
