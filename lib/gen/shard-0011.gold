noun: spaces
modifier: all
context: retry
phrase: fold retry spaces across all elements by factor {factor}
phrase: compress all retry spacing values using divisor {factor}
slot: factor int
test: list=10,20,30 factor=2
expect: => i=30 r=0.0 ok=true s="folded spaces to sum 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=9,15,21 factor=3
expect: => i=15 r=0.0 ok=true s="folded spaces to sum 15" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let div = ${factor};
	if div <= 0 {
		gold_fail(g, "invalid factor");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n {
		g.res[k] = g.res[k] / div;
		sum += g.res[k];
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded spaces to sum ", sum);
	out
}
@end
