test: text=""
expect: => i=0 r=0.0 ok=false s="error: empty text" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "cannot reverse empty text");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text");
		return out;
	}
	var left = 0;
	var right = out.s.len - 1;
	while left < right {
		let tmp = out.s[left];
		out.s[left] = out.s[right];
		out.s[right] = tmp;
		left++;
		right--;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
