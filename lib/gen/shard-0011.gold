fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] > limit {
			sum += g.res[i];
			count++;
		}
	}
	var mean = 0;
	if count > 0 { mean = sum / count; }
	g.steps += g.n;
	out.i = mean;
	out.s.clear();
	format(out.s, "safe threshold mean: ", mean);
	out
}
