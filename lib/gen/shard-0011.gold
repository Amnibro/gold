code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var f = ${finish};
	if s < 0 { s = 0; }
	if f > g.n { f = g.n; }
	if s >= f { return out; }
	let count = f - s;
	for i in count {
		gold_push(g, g.res[s + i]);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated ", count, " items between positions");
	out
}
@end
@entry 0f10ef766e305835
kind: step
verb: clamp
noun: middle
modifier: with_cache
context: math
phrase: clamp middle elements using cached bounds
phrase: restrict interior elements with cached boundaries
test: list=10,500,2,30
expect: => i=2 r=0.0 ok=true s="clamped 2 middle values with cached bounds" errors=0 n=4 res=[10,30,10,30] cache=2 hits=0
test: list=5,-80,999,12
expect: => i=2 r=0.0 ok=true s="clamped 2 middle values with cached bounds" errors=0 n=4 res=[5,5,12,12] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	let first = g.res[0];
	let last = g.res[g.n - 1];
	var lo = first;
	var hi = last;
	if lo > hi { let t = lo; lo = hi; hi = t; }
	gold_cache_put(g, 0, lo);
	gold_cache_put(g, 1, hi);
	var clamped = 0;
	for i in 1..(g.n - 1) {
		if g.res[i] < lo { g.res[i] = lo; clamped++; }
		if g.res[i] > hi { g.res[i] = hi; clamped++; }
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " middle values with cached bounds");
	out
}
@end
