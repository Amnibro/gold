test: list=1,-2,3,4,-5,6 w=2
expect: => i=3 r=0.0 ok=true s="found 3 positive windows" errors=0 n=6 res=[1,-2,3,4,-5,6] cache=0 hits=0
test: list=10,-20,30,40 w=3
expect: => i=2 r=0.0 ok=true s="found 2 positive windows" errors=0 n=4 res=[10,-20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 || win > g.n {
		out.i = 0;
		return out;
	}
	var positive_windows = 0;
	var i = 0;
	while i + win <= g.n {
		var sum = 0;
		for j in win {
			sum += g.res[i + j];
		}
		if sum > 0 {
			positive_windows++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = positive_windows;
	out.s.clear();
	format(out.s, "found ", positive_windows, " positive windows");
	out
}
@end
