fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passed = 0;
	for i in g.n {
		let x = g.res[i];
		let cached_res, ok = gold_cache_get(g, x);
		var valid = false;
		if ok {
			valid = cached_res == 1;
		} else {
			valid = ${cond}(x);
			gold_cache_put(g, x, if valid { 1 } else { 0 });
		}
		if valid { passed++; }
	}
	out.i = passed;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "validated ", passed, " items matching condition");
	out
}
@end
