expect: => i=2 r=0.0 ok=true s="cached primes up to limit count 2" errors=0 n=5 res=[11,12,13,14,15] cache=2 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && ${ID}_is_prime(x) {
			gold_cache_put(g, x, 1);
			cached++;
		}
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached primes up to limit count ", cached);
	out
}
@end
