slot: count int
test: list=10,5,12,15 count=3
expect: => i=1 r=0.0 ok=true s="validated tail sorted status 1" errors=0 n=4 res=[10,5,12,15] cache=0 hits=0
test: list=10,5,15,12 count=3
expect: => i=0 r=0.0 ok=false s="validated tail sorted status 0" errors=0 n=4 res=[10,5,15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 1 || g.n <= 1 {
		out.ok = true;
		out.i = 1;
		return out;
	}
	var start = if g.n > k { g.n - k } else { 0 };
	var is_sorted = true;
	var i = start;
	while i < g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	g.steps += g.n - start;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validated tail sorted status ", out.i);
	out
}
@end
@entry 1a36e0d5b7ae4e01
kind: step
verb: search
noun: prefix
modifier: in_reverse
context: filter
phrase: search prefix window backwards in reverse {limit} {target}
phrase: scan leading prefix in reverse for match {limit} {target}
slot: limit int
slot: target int
test: list=5,8,5,12 limit=4 target=5
expect: => i=2 r=0.0 ok=true s="reverse prefix found index 2" errors=0 n=4 res=[5,8,5,12] cache=0 hits=0
