fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var kept = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${cond}(g.res[i]) {
			temp[kept] = g.res[i];
			kept++;
		}
		i--;
	}
	for k in kept {
		g.res[k] = temp[k];
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " matching items in reverse");
	out
}
