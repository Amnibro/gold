	let cnt = ${tail_count};
	let take = if cnt > g.n { g.n } else if cnt < 0 { 0 } else { cnt };
	var sum = 0;
	var i = g.n - take;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.n -= take;
	gold_push(g, sum);
	g.steps += take;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged last ", take, " history items");
	out
}
@end
