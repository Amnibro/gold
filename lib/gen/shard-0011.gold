expect: => i=2 r=0.0 ok=true s="found 2 values with count at most 2" errors=0 n=6 res=[1,1,2,3,3,3] cache=0 hits=0
test: list=4,4,4 max_count=1
expect: => i=0 r=0.0 ok=true s="found 0 values with count at most 1" errors=0 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var match_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if !seen_before {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x { freq++; }
			}
			if freq <= mc { match_count++; }
		}
	}
	g.steps += g.n * g.n;
	out.i = match_count;
	out.s.clear();
	format(out.s, "found ", match_count, " values with count at most ", mc);
	out
}
@end
