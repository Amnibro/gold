@entry d8cb92436de32a27
kind: step
verb: join
noun: duplicates
modifier: all
context: loop
phrase: join all duplicate loop values into single occurrences
phrase: aggregate every repeated loop entry together
test: list=1,2,2,3,4,4,4
expect: => i=2 r=0.0 ok=true s="aggregated duplicates unique count 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=5,6,5,7,8,7
expect: => i=2 r=0.0 ok=true s="aggregated duplicates unique count 2" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		var is_dup = false;
		for j in i {
			if g.res[j] == g.res[i] { is_dup = true; break; }
		}
		if is_dup {
			var already = false;
			for d in dup_count {
				if g.res[d] == g.res[i] { already = true; break; }
			}
			if !already {
				g.res[dup_count] = g.res[i];
				dup_count++;
			}
		}
	}
	g.n = dup_count;
