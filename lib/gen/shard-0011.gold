@entry 85f85e09022b078d
kind: step
verb: dedupe
noun: middle
modifier: first
context: filter
phrase: dedupe middle elements preserving first occurrences {radius}
phrase: filter middle window keeping first duplicate items {radius}
slot: radius int
test: list=1,2,2,2,3,4 radius=2
expect: => i=4 r=0.0 ok=true s="deduped middle kept count 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,20,30,40 radius=1
expect: => i=4 r=0.0 ok=true s="deduped middle kept count 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if g.n == 0 || r <= 0 {
		out.i = 0;
		return out;
	}
	let mid = g.n / 2;
	var start = mid - r;
	if start < 0 { start = 0; }
	var end = mid + r;
	if end >= g.n { end = g.n - 1; }
	var w = 0;
	for i in g.n {
		if i >= start && i <= end {
			var seen = false;
			var j = start;
			while j < i {
				if g.res[j] == g.res[i] {
					seen = true;
					break;
				}
				j++;
			}
			if !seen {
				g.res[w] = g.res[i];
				w++;
			}
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped middle kept count ", w);
	out
}
@end
