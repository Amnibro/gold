code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[512] = [0; 512];
	var ucount = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in ucount {
			if unique[j] == x { seen = true; }
		}
		if !seen {
			unique[ucount] = x;
			ucount++;
			sum += x * x;
		}
	}
	out.i = sum;
	g.steps += g.n;
	gold_push(g, sum);
	out.s.clear();
	format(out.s, "folded squares of ", ucount, " unique items to ", sum);
	out
}
@end
