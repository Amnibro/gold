expect: => i=4 r=0.0 ok=true s="items within deviation limit count 4" errors=0 n=5 res=[20,22,25,28,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var matched = 0;
	if g.n > 0 {
		let baseline = g.res[0];
		for i in g.n {
			let diff = g.res[i] - baseline;
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff <= lim {
				matched++;
			}
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "items within deviation limit count ", matched);
	out
}
@end
