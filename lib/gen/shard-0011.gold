phrase: filter character digits above threshold {cutoff}
slot: cutoff int
test: text="a8b3c9d2" cutoff=5
expect: => i=2 r=0.0 ok=true s="digits above cutoff 2" errors=0 n=2 res=[8,9] cache=0 hits=0
test: text="123" cutoff=5
