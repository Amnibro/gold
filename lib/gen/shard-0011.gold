@entry 1f542e75b27553fc
kind: step
verb: trace
noun: pairs
modifier: at_least
context: text
phrase: trace adjacent character pairs with sum at least {bound}
phrase: record consecutive letter pairs summing to at least {bound}
slot: bound int
test: text="hello" bound=210
expect: => i=2 r=0.0 ok=true s="traced 2 pairs meeting bound" errors=0 n=2 res=[216,219] cache=0 hits=0
test: text="world" bound=225
expect: => i=2 r=0.0 ok=true s="traced 2 pairs meeting bound" errors=0 n=2 res=[230,225] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var pairs = 0;
	if out.s.len > 1 {
		for i in (out.s.len - 1) {
			let sum = out.s[i] as int + out.s[i + 1] as int;
			if sum >= b {
				gold_push(g, sum);
				pairs++;
			}
		}
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "traced ", pairs, " pairs meeting bound");
	out
}
@end
