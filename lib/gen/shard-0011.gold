@entry 60b0440d719d8c32
kind: step
verb: swap
noun: middle
modifier: running
context: format
phrase: format running swaps across middle elements
phrase: render progressive middle elements inversion
test: list=1,5,3,7,9
expect: => i=1 r=0.0 ok=true s="running middle swaps: 1" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=10,20,30,40
expect: => i=0 r=0.0 ok=true s="running middle swaps: 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 2 {
		var i = 1;
		while i + 1 < g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i++;
		}
	}
	out.s.clear();
	format(out.s, "running middle swaps: ", swaps);
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
