phrase: order initial search numbers while below threshold {ceiling}
slot: ceiling int
test: list=15,12,8,50,2 ceiling=30
expect: => i=3 r=0.0 ok=true s="sorted numbers count 3" errors=0 n=5 res=[8,12,15,50,2] cache=0 hits=0
test: list=9,4,1,80,3 ceiling=20
expect: => i=3 r=0.0 ok=true s="sorted numbers count 3" errors=0 n=5 res=[1,4,9,80,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var k = 0;
	while k < g.n && g.res[k] < ceil {
		k++;
	}
	for i in k {
		for j in (i + 1)..k {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += k * k;
	out.i = k;
	out.s.clear();
	format(out.s, "sorted numbers count ", k);
	out
}
@end
@entry 8bc82aeacff1d2ab
kind: step
