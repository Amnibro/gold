fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "primes:");
	var count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			format(out.s, " ", g.res[i]);
			count++;
		}
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
