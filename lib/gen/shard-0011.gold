code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${limit};
	var failed_at = -1;
	for i in g.n {
		if failed_at == -1 && g.res[i] >= thresh {
			failed_at = i;
			gold_fail(g, "error sequence limit exceeded");
			out.ok = false;
		}
	}
	g.steps += g.n;
	out.i = failed_at;
	out.s.clear();
	if failed_at >= 0 {
		format(out.s, "sequence failed at index ", failed_at);
	} else {
		format(out.s, "sequence within limit");
	}
	out
}
@end
@entry 695f5d8ae89dbe61
kind: step
verb: scale
noun: steps
modifier: in_reverse
context: error
phrase: scale error steps in reverse order by {factor}
phrase: multiply reversed error steps by {factor}
slot: factor int
test: list=1,2,3,4 factor=2
expect: => i=4 r=0.0 ok=true s="scaled and reversed 4 error steps" errors=0 n=4 res=[8,6,4,2] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=2 r=0.0 ok=true s="scaled and reversed 2 error steps" errors=0 n=2 res=[60,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let t = g.res[i];
		g.res[i] = g.res[j] * mult;
		g.res[j] = t * mult;
	}
	if g.n % 2 != 0 {
		let mid = g.n / 2;
		g.res[mid] = g.res[mid] * mult;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled and reversed ", g.n, " error steps");
	out
}
@end
@entry 5b1b2789ebe77cbe
kind: step
verb: measure
noun: histogram
modifier: up_to
context: error
phrase: measure error histogram up to bucket {bucket}
phrase: build error histogram frequencies up to {bucket}
slot: bucket int
test: list=5,12,18,25 bucket=10
expect: => i=3 r=0.0 ok=true s="measured 3 histogram error intervals" errors=0 n=3 res=[1,2,1] cache=0 hits=0
test: list=2,3,4 bucket=2
expect: => i=3 r=0.0 ok=true s="measured 3 histogram error intervals" errors=0 n=3 res=[0,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${bucket};
	if bsize <= 0 {
		gold_fail(g, "invalid error histogram bucket");
		out.ok = false;
		return out;
	}
	var max_v = 0;
	for i in g.n {
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	let num_b = (max_v / bsize) + 1;
	let lim = if num_b > 8 { 8 } else { num_b };
	var counts = [0; 8];
	for i in g.n {
		let b_idx = g.res[i] / bsize;
		if b_idx < 8 { counts[b_idx]++; }
	}
	gold_clear(g);
	for b in lim { gold_push(g, counts[b]); }
	g.steps += g.n;
	out.i = lim;
	out.s.clear();
	format(out.s, "measured ", lim, " histogram error intervals");
	out
}
@end
@entry 182e4022a58c4e0b
kind: step
verb: keep
noun: primes
modifier: in_place
context: error
phrase: keep prime error codes in place
phrase: filter prime status error items
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="kept 4 prime error codes" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="kept 0 prime error codes" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		gold_fail(g, "no prime error codes found");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " prime error codes");
	out
}
@end
@entry d43c224df25d4834
kind: step
verb: pair
noun: duplicates
modifier: recursively
context: error
phrase: pair duplicate error codes across list
phrase: combine adjacent identical error pairs
test: list=10,10,20,30,30
expect: => i=2 r=0.0 ok=true s="paired 2 duplicate error codes" errors=0 n=3 res=[20,20,60] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="paired 0 duplicate error codes" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no duplicate pairs possible");
		return out;
	}
	var pairs_found = 0;
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			g.res[write_idx] = g.res[i] * 2;
			pairs_found++;
			i += 2;
		} else {
			g.res[write_idx] = g.res[i];
			i++;
		}
		write_idx++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = pairs_found;
	out.s.clear();
	format(out.s, "paired ", pairs_found, " duplicate error codes");
	out
}
@end
