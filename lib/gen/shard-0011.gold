			if g.res[j] < g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = g.cn;
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "ranked ", g.cn, " cache entries");
	out
}
