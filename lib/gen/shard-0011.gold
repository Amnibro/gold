kind: step
verb: compare
noun: average
modifier: sorted
context: stats
phrase: compare lower upper averages of sorted data
phrase: evaluate group mean differences across sorted sample
test: list=10,20,30,40,50,60
expect: => i=30 r=0.0 ok=true s="difference of upper and lower averages 30" errors=0 n=6 res=[10,20,30,40,50,60] cache=0 hits=0
test: list=5,15,25,35
expect: => i=20 r=0.0 ok=true s="difference of upper and lower averages 20" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.n / 2;
	var sum_lo = 0;
	var sum_hi = 0;
	for i in mid { sum_lo += g.res[i]; }
	var i = mid;
	while i < g.n { sum_hi += g.res[i]; i++; }
	let avg_lo = if mid > 0 { sum_lo / mid } else { 0 };
	let avg_hi = if (g.n - mid) > 0 { sum_hi / (g.n - mid) } else { 0 };
	g.steps += g.n * g.n;
	out.i = avg_hi - avg_lo;
	out.s.clear();
	format(out.s, "difference of upper and lower averages ", out.i);
	out
}
@end
