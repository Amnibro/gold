@entry bc44a6777228bef5
kind: step
verb: drop
noun: condition
modifier: at_most
context: sort
phrase: drop inverted items violating condition at most {limit} times
phrase: remove out of order elements up to limit {limit}
slot: limit int
test: list=1,5,2,7,3,9 limit=2
expect: => i=2 r=0.0 ok=true s="dropped inverted items count 2" errors=0 n=4 res=[1,5,7,9] cache=0 hits=0
test: list=10,20,5,30 limit=1
expect: => i=1 r=0.0 ok=true s="dropped inverted items count 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drops = ${limit};
	var kept int[512] = [0; 512];
	var kn = 0;
	var dropped = 0;
	for i in g.n {
		if kn > 0 && g.res[i] < kept[kn - 1] && dropped < max_drops {
			dropped++;
		} else {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	for i in kn { g.res[i] = kept[i]; }
	g.n = kn;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped inverted items count ", dropped);
	out
}
@end
@entry 77ec7042969c5455
kind: step
verb: fill
noun: middle
modifier: while
context: sort
phrase: fill middle partition while sorting condition {cond} holds
phrase: impute central elements while {cond} is satisfied
slot: cond pred
test: list=10,20,4,8,50 cond=is_even
expect: => i=10 r=0.0 ok=true s="filled middle with median value 10" errors=0 n=5 res=[4,10,10,10,50] cache=0 hits=0
test: list=5,15,3,7,25 cond=is_odd
expect: => i=7 r=0.0 ok=true s="filled middle with median value 7" errors=0 n=5 res=[3,7,7,7,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.n / 2;
	if mid < g.n && ${cond}(g.res[mid]) {
		let val = g.res[mid];
		if mid > 0 { g.res[mid - 1] = val; }
		if mid + 1 < g.n { g.res[mid + 1] = val; }
		out.i = val;
	}
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "filled middle with median value ", out.i);
	out
}
@end
@entry 9e2a4726422ebac1
kind: step
verb: apply
noun: numbers
modifier: running
context: sort
phrase: sort running numbers using insertion sort algorithm
phrase: order stream numbers with running insertion passes
test: list=12,11,13,5,6
expect: => i=5 r=0.0 ok=true s="running insertion sort completed on 5" errors=0 n=5 res=[5,6,11,12,13] cache=0 hits=0
test: list=9,4,6,2,8
expect: => i=5 r=0.0 ok=true s="running insertion sort completed on 5" errors=0 n=5 res=[2,4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "running insertion sort completed on ", g.n);
	out
}
@end
