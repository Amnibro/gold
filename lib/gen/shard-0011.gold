code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	if d.len < 2 { return 0; }
	var res = 0;
	var i = d.len - 1;
	while i >= 1 {
		let a = d[i];
		let b = d[i - 1];
		let diff = if a > b { a - b } else { b - a };
		res = res * 10 + diff;
		i--;
	}
	res
}
@end
