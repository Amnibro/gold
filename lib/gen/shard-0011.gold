test: list=200,300
expect: => i=5 r=0.0 ok=true s="normalized cached items recursively 5" errors=0 n=2 res=[200,300] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ops = 0;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	for i in g.cn {
		var x = g.cv[i];
		while x > 50 {
			x /= 2;
			ops++;
		}
		g.cv[i] = x;
	}
	g.steps += g.cn + ops;
	out.i = ops;
	out.s.clear();
	format(out.s, "normalized cached items recursively ", ops);
	out
}
@end
