fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] % 2 == 0 {
			g.res[idx] += 1;
			modified++;
		}
		idx += 2;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "merged ", modified, " even positions");
	out
}
@end
