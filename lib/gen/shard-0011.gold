code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted_count = 0;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			let cj = g.res[j] % 256;
			let cm = g.res[min_idx] % 256;
			if cj < cm { min_idx = j; }
		}
		if min_idx != i {
			let t = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = t;
			sorted_count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = sorted_count;
	out.s.clear();
	format(out.s, "sorted ", sorted_count, " letter positions");
	out
}
@end
