expect: => i=2 r=0.0 ok=true s="filtered 2 window maximums" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${window_size};
	var maxes int[512] = [0; 512];
	var mcount = 0;
	if ws > 0 {
		var i = 0;
		while i < g.n {
			var limit = i + ws;
			if limit > g.n { limit = g.n; }
			var cur_max = g.res[i];
			var j = i;
			while j < limit {
				if g.res[j] > cur_max { cur_max = g.res[j]; }
				j++;
			}
			maxes[mcount] = cur_max;
			mcount++;
			i += ws;
		}
	}
	gold_clear(g);
	for k in mcount { gold_push(g, maxes[k]); }
	out.i = mcount;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filtered ", mcount, " window maximums");
	out
}
@end
