@entry b35eb24a1479c06d
kind: step
verb: select
noun: middle
modifier: sorted
context: text
phrase: select middle text characters in sorted order
phrase: extract middle characters of text sorted alphabetically
test: text="gfedcba"
expect: => i=5 r=0.0 ok=true s="bcdef" errors=0 n=0 res=[] cache=0 hits=0
test: text="zyxwvuts"
expect: => i=4 r=0.0 ok=true s="uvwx" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 3 { return out; }
	let start = out.s.len / 4;
	let end_pos = out.s.len - start;
	var mid byte[>..] = [];
	var i = start;
	while i < end_pos {
		mid.push(out.s[i]);
		i++;
	}
	// sort mid
	var a = 0;
	while a < mid.len {
		var b = a + 1;
		while b < mid.len {
			if mid[b] < mid[a] {
				let t = mid[a];
				mid[a] = mid[b];
				mid[b] = t;
			}
			b++;
		}
		a++;
	}
	out.s.clear();
	out.s.append(mid);
	g.steps += mid.len;
	out.i = mid.len;
	out
}
@end
