fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] > ceiling {
			g.cv[i] = ceiling;
			clamped++;
		}
	}
	g.steps += g.cn;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped cached runs at most count ", clamped);
	out
}
