phrase: keep items with adjacent step bounded by {max_step}
slot: max_step int
test: list=1,3,10,12,30 max_step=5
expect: => i=2 r=0.0 ok=true s="filtered steps 2" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=10,12,14,25 max_step=3
expect: => i=3 r=0.0 ok=true s="filtered steps 3" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let ms = ${max_step};
	var kept int[>..] = [];
	kept.push(g.res[0]);
	for i in 1..g.n {
		let diff = g.res[i] - kept[kept.len - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= ms {
			kept.push(g.res[i]);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "filtered steps ", kept.len);
	out
}
@end
@entry d443554ee498b0ac
kind: step
verb: validate
noun: tail
modifier: up_to
context: search
phrase: validate search results tail bounded up to ceiling {ceiling} {count}
phrase: verify trailing elements stay below threshold {ceiling} {count}
slot: ceiling int
slot: count int
test: list=100,20,30,40 ceiling=50 count=3
expect: => i=1 r=0.0 ok=true s="tail validation true" errors=0 n=4 res=[100,20,30,40] cache=0 hits=0
test: list=10,20,80 ceiling=50 count=2
expect: => i=0 r=0.0 ok=false s="tail validation false" errors=0 n=3 res=[10,20,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	let cnt = ${count};
	var valid = true;
	var checked = 0;
	var i = g.n - 1;
	while i >= 0 && checked < cnt {
		if g.res[i] > ceil {
			valid = false;
			break;
		}
		checked++;
		i--;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += checked + 1;
	out.s.clear();
	format(out.s, "tail validation ", valid);
	out
}
@end
@entry 01cd065ffe7112fb
kind: step
verb: fold
noun: histogram
modifier: with_retry
context: search
phrase: fold search frequency histogram using retry passes {retries}
phrase: accumulate search bucket totals with retry count {retries}
slot: retries int
test: list=1,2,2,3,3,3 retries=1
expect: => i=14 r=0.0 ok=true s="histogram fold 14" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,10,10 retries=2
expect: => i=16 r=0.0 ok=true s="histogram fold 16" errors=0 n=4 res=[5,5,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var hist int[100] = [0; 100];
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x < 100 {
			hist[x]++;
		}
	}
	var sum_sq = 0;
	for k in 100 {
		sum_sq += hist[k] * hist[k];
	}
	out.i = sum_sq * r;
	g.steps += g.n + 100;
	out.s.clear();
	format(out.s, "histogram fold ", out.i);
	out
}
@end
