fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cid = ${cache_id};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			var seen = false;
			for j in kept { if temp[j] == x { seen = true; break; } }
			if !seen {
				temp[kept] = x;
				kept++;
			}
		}
	}
	gold_cache_put(g, cid, kept);
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached unique condition count: ", kept);
	out
}
@end
