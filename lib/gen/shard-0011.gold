code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = g.n - 1;
	var swaps = 0;
	while i > 0 {
		let tmp = g.res[i];
		g.res[i] = g.res[i - 1];
		g.res[i - 1] = tmp;
		swaps++;
		i -= 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped pairs in reverse count ", swaps);
	out
}
@end
