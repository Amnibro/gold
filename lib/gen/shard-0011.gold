fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	let cap = ${max_val};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] > cap {
			g.res[i] = cap;
		}
		sum += g.res[i];
		count++;
		if sum >= goal {
			break;
		}
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "clamped loop sum ", sum);
	out
}
@end
