fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_idx = 0;
	var cur_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur_len > 0 {
				gold_cache_put(g, word_idx, cur_len);
				word_idx++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		gold_cache_put(g, word_idx, cur_len);
		word_idx++;
	}
	g.steps += out.s.len;
	out.i = word_idx;
	out.s.clear();
	format(out.s, "cached word lengths across all spaces ", word_idx);
	out
}
