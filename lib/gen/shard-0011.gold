fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var valid = true;
	var checked = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= 0 { break; }
		checked++;
		if x > b { valid = false; break; }
	}
	g.steps += checked;
	out.ok = valid;
	out.i = checked;
	out.s.clear();
	if valid {
		format(out.s, "validated ", checked, " positive elements under limit");
	} else {
		format(out.s, "validation failed after ", checked, " elements");
	}
	out
}
@end
