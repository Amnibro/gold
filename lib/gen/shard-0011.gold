slot: limit int
test: list=2,3,4,5,6,7,8,9,10 limit=7
expect: => i=4 r=0.0 ok=true s="cached primes up to limit count 4" errors=0 n=9 res=[2,3,4,5,6,7,8,9,10] cache=4 hits=0
