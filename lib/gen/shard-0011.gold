@entry 469183791c01c095
kind: step
verb: scale
noun: maximum
modifier: at_least
context: aggregate
phrase: scale maximum value at least {reps} times with multiplier {factor}
phrase: repeatedly multiply peak element at least {reps} iterations by {factor}
slot: reps int
slot: factor int
test: list=1,5,3 reps=2 factor=2
expect: => i=20 r=0.0 ok=true s="scaled peak element to 20" errors=0 n=3 res=[1,20,3] cache=0 hits=0
test: list=10,2,8 reps=3 factor=2
expect: => i=80 r=0.0 ok=true s="scaled peak element to 80" errors=0 n=3 res=[80,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${reps};
	let mult = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var r = 0;
	while r < times {
		g.res[max_idx] = g.res[max_idx] * mult;
		r++;
	}
	g.steps += g.n + times;
	out.i = g.res[max_idx];
	out.s.clear();
	format(out.s, "scaled peak element to ", g.res[max_idx]);
	out
}
