code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = g.n / 2;
	var found_neg = false;
	var idx = start;
	while idx < g.n {
		if g.res[idx] < 0 {
			found_neg = true;
			gold_fail(g, "negative item in suffix");
			out.ok = false;
		}
		idx += 2;
	}
	g.steps += g.n;
	out.i = if found_neg { 1 } else { 0 };
	out.s.clear();
	if found_neg {
		format(out.s, "error suffix scan failed");
	} else {
		format(out.s, "error suffix scan clean");
	}
	out
}
@end
