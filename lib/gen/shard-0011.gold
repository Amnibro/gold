@entry b3838f73e8e06854
kind: step
verb: repeat
noun: average
modifier: every_other
context: core
phrase: repeat average every other item {reps} times
phrase: duplicate alternate average value {reps} times
phrase: format repeated average of alternate elements {reps}
slot: reps int
test: list=10,5,30,8 reps=2
expect: => i=40 r=0.0 ok=true s="[20][20]" errors=0 n=4 res=[10,5,30,8] cache=0 hits=0
test: list=2,10,4,20 reps=3
expect: => i=9 r=0.0 ok=true s="[3][3][3]" errors=0 n=4 res=[2,10,4,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${reps};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if i % 2 == 0 {
			sum += g.res[i];
			count++;
		}
	}
	let avg = if count > 0 { sum / count } else { 0 };
	out.s.clear();
	for r in reps {
		format(out.s, "[", avg, "]");
	}
	out.i = avg * reps;
	g.steps += reps;
	out
}
@end
@entry b66eb7bd1129456c
kind: step
verb: sum
noun: window
modifier: every_other
context: filter
phrase: sum sliding window filtering every other step
phrase: filter alternating window sums every other index
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="every other window sums count: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="every other window sums count: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var temp int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		temp[count] = g.res[i] + g.res[i + 1];
		count++;
		i += 2;
	}
	for j in count { g.res[j] = temp[j]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "every other window sums count: ", count);
	out
}
@end
@entry 64488e5b4582b65e
kind: step
verb: rank
noun: squares
modifier: unique
context: core
phrase: rank squares unique count in list
phrase: count distinct perfect squares in results
phrase: format count of unique square numbers
test: list=4,9,4,16,2
expect: => i=3 r=0.0 ok=true s="unique squares count=3" errors=0 n=5 res=[4,9,4,16,2] cache=0 hits=0
test: list=1,1,2,3
expect: => i=1 r=0.0 ok=true s="unique squares count=1" errors=0 n=4 res=[1,1,2,3] cache=0 hits=0
code:
fn ${ID}_is_square(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r < n { r++; }
	return r * r == n;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_count = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_square(x) {
			var seen = false;
			for j in i {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen { uniq_count++; }
		}
	}
	g.steps += g.n;
	out.i = uniq_count;
	out.s.clear();
	format(out.s, "unique squares count=", uniq_count);
	out
}
@end
