fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inversions = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let is_inv = if g.res[i] > g.res[i + 1] { 1 } else { 0 };
			gold_cache_put(g, i, is_inv);
			if is_inv == 1 { inversions++; }
		}
	}
	g.steps += g.n;
