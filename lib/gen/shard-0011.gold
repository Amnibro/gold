fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var below = 0;
	for i in g.n {
		if g.res[i] <= cut {
			below++;
		}
	}
	g.steps += g.n * g.n;
	out.i = below;
	out.s.clear();
	format(out.s, "sorted items up to threshold ", below);
	out
}
@end
