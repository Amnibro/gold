fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	while k < g.n && !${stop_pred}(g.res[k] * g.res[k]) {
		g.res[k] = g.res[k] * g.res[k];
		k++;
	}
	var a = 0;
	var b = k - 1;
	while a < b {
		let t = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = t;
		a++;
		b--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed squares count ", k);
	out
}
@end
