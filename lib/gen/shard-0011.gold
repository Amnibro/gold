kind: step
verb: sort
noun: subfunction
modifier: at_most
context: loop
phrase: apply subfunction {sub} to loop items sorting at most {max_sort} elements
phrase: transform loop values with {sub} ordering prefix of {max_sort} items
slot: sub fn
slot: max_sort int
test: list=5,1,4,2 max_sort=3 sub=double
expect: => i=3 r=0.0 ok=true s="sorted subfunction prefix length 3" errors=0 n=4 res=[2,8,10,4] cache=0 hits=0
test: list=8,3,6,1 max_sort=2 sub=inc
expect: => i=2 r=0.0 ok=true s="sorted subfunction prefix length 2" errors=0 n=4 res=[4,9,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${sub}(g.res[k]);
	}
	let limit = if ${max_sort} < g.n { ${max_sort} } else { g.n };
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n + limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted subfunction prefix length ", limit);
	out
}
@end
@entry 58d8efd97e7c9c54
kind: step
verb: sort
noun: duplicates
modifier: up_to
context: loop
phrase: sort duplicate loop values up to count {max_items}
phrase: order repeated loop occurrences up to limit {max_items}
slot: max_items int
test: list=4,2,4,3,2,5 max_items=2
expect: => i=2 r=0.0 ok=true s="sorted duplicate items count 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=8,1,8,1,8 max_items=3
expect: => i=3 r=0.0 ok=true s="sorted duplicate items count 3" errors=0 n=3 res=[1,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_items};
	var dup_count = 0;
	var i = 0;
	while i < g.n && dup_count < cap {
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] {
				g.res[dup_count] = g.res[i];
				dup_count++;
				break;
			}
			j++;
		}
		i++;
	}
	var a = 0;
	while a < dup_count {
		var b = a + 1;
		while b < dup_count {
			if g.res[b] < g.res[a] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	g.n = dup_count;
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "sorted duplicate items count ", dup_count);
	out
}
@end
