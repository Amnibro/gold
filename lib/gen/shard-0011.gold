code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	out.s.clear();
	format(out.s, "selected memo: [");
	var count = 0;
	for i in g.cn {
		let val = g.cv[i];
		if !${cond}(val) { break; }
		if count > 0 { format(out.s, ", "); }
		format(out.s, val);
		count++;
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.cn;
	out
}
@end
@entry c7c100257da8ad6c
kind: step
verb: select
noun: checkpoint
modifier: between
context: format
phrase: format checkpoint items between lower {low} upper {high}
phrase: render checkpoint selection within range {low} limit {high}
slot: low int
slot: high int
test: list=5,12,18,25 low=10 high=20
expect: => i=2 r=0.0 ok=true s="checkpoints between: [12, 18]" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=1,3,5 low=0 high=10
expect: => i=3 r=0.0 ok=true s="checkpoints between: [1, 3, 5]" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	out.s.clear();
	format(out.s, "checkpoints between: [");
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			g.res[kept] = x;
			if kept > 0 { format(out.s, ", "); }
			format(out.s, x);
			kept++;
		}
	}
	format(out.s, "]");
	g.n = kept;
	out.i = kept;
	g.steps += g.n;
	out
}
@end
