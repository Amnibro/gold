fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let start = g.n / 4;
	let end = (g.n * 3) / 4;
	for i in start..end {
		for j in (i + 1)..end {
			if g.res[j] < g.res[i] && g.res[j] <= b {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = end - start;
	out.s.clear();
	format(out.s, "sorted middle section items ", out.i);
	out
}
