code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = if ${cycles} > 0 { ${cycles} } else { 1 };
	var total_avg = 0;
	for k in g.n {
		var sub_sum = 0;
		var count = 0;
		var j = 0;
		while j < w && k + j < g.n {
			sub_sum += g.res[k + j];
			count++;
			j++;
		}
		let avg = if count > 0 { sub_sum / count } else { 0 };
		g.res[k] = avg;
		total_avg += avg;
	}
	g.steps += g.n;
	out.i = total_avg;
	out.s.clear();
	format(out.s, "moving average sum ", total_avg);
	out
}
@end
