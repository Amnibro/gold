	let ms = ${max_size};
	if ms <= 0 {
		gold_fail(g, "non-positive window size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive size");
		return out;
	}
	var bound = ms;
	if bound > g.n { bound = g.n; }
	var sum = 0;
	for i in bound { sum += g.res[i]; }
	g.steps += bound;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded window sum ", sum);
	out
}
