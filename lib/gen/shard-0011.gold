slot: min_len int
test: list=1,1,2,3,3,3,4 min_len=2
expect: => i=5 r=0.0 ok=true s="kept run elements 5" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,6,6,7,8,8,8 min_len=3
expect: => i=3 r=0.0 ok=true s="kept run elements 3" errors=0 n=3 res=[8,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_len};
	var w = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let run_len = j - i;
		if run_len >= m {
			var k = i;
			while k < j {
				g.res[w] = g.res[k];
				w++;
				k++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "kept run elements ", w);
	out
}
@end
