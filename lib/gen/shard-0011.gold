expect: => i=3 r=0.0 ok=true s="reversed sorted middle segment size 3" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let start = g.n / 4;
	let end = (g.n * 3) / 4;
	var l = start;
	var r = end;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n * g.n;
	out.i = end - start + 1;
	out.s.clear();
	format(out.s, "reversed sorted middle segment size ", out.i);
	out
}
@end
