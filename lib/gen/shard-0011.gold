fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		out.i = 0;
		return out;
	}
	let bound = ${limit};
	var modified = 0;
	for i in 1..(g.n - 1) {
		if g.res[i] > bound {
			g.res[i] = bound;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " interior elements");
	out
}
@end
