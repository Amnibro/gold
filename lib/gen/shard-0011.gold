kind: step
verb: split
noun: squares
modifier: unique
context: retry
phrase: split retry count into unique squares
phrase: partition retry attempts into distinct squares
test: input=14
expect: => i=2 r=0.0 ok=true s="split into squares count 2" errors=0 n=2 res=[9,5] cache=0 hits=0
test: input=25
expect: => i=1 r=0.0 ok=true s="split into squares count 1" errors=0 n=1 res=[25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = out.i;
	if rem <= 0 {
		gold_fail(g, "zero or negative input for unique square split");
		out.ok = false;
		return out;
	}
	var root = 1;
	while (root + 1) * (root + 1) <= rem {
		root++;
	}
	let sq = root * root;
	gold_push(g, sq);
	rem -= sq;
	if rem > 0 {
		gold_push(g, rem);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split into squares count ", g.n);
	out
}
@end
