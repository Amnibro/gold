fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var in_range = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			in_range++;
			let count, hit = gold_cache_get(g, x);
			if hit {
				gold_cache_put(g, x, count + 1);
			} else {
				gold_cache_put(g, x, 1);
			}
		}
	}
	g.steps += g.n;
	out.i = in_range;
	out.s.clear();
	format(out.s, "cached histogram entries between bounds ", in_range);
	out
}
@end
