code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty array for run counting");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty array");
		return out;
	}
	var max_streak = 0;
	var cur_streak = 0;
	var prev = g.res[0] - 1;
	for i in g.n {
		if g.res[i] == prev {
			cur_streak++;
		} else {
			cur_streak = 1;
			prev = g.res[i];
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "maximum run length ", max_streak);
	out
}
@end
@entry 144a382e280ef7a8
kind: step
verb: rank
noun: primes
modifier: safely
context: error
phrase: rank prime numbers safely in results
phrase: order prime elements safely ascending
test: list=9,7,4,3,2
expect: => i=3 r=0.0 ok=true s="safely ranked 3 primes" errors=0 n=3 res=[2,3,7] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="error: no primes found" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n { if n % d == 0 { return false; } d++; }
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[>..] = [];
	for i in g.n {
		if ${ID}_p(g.res[i]) { primes.push(g.res[i]); }
	}
	if primes.len == 0 {
		gold_fail(g, "no primes available to rank");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no primes found");
		return out;
	}
	for i in primes.len {
		for j in (i + 1)..primes.len {
			if primes[j] < primes[i] {
				let tmp = primes[i];
				primes[i] = primes[j];
				primes[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for p in primes { gold_push(g, p); }
	g.steps += g.n + primes.len * primes.len;
	out.i = primes.len;
	out.s.clear();
	format(out.s, "safely ranked ", primes.len, " primes");
	out
}
@end
