fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " items within budget");
	out
}
