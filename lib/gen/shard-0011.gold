fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${thresh};
	let retries = ${max_retries};
	var allowed_drops = retries;
	var kept = 0;
	for k in g.n {
		if g.res[k] >= cutoff {
			g.res[kept] = g.res[k];
			kept++;
		} else if allowed_drops > 0 {
			allowed_drops--;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "items filtered with retries kept ", kept);
	out
}
@end
