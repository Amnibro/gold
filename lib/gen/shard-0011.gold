fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_b = ${budget};
	var running_b = 0;
	var exceeded = false;
	for i in g.n {
		running_b += g.res[i];
		if running_b > max_b {
			exceeded = true;
			gold_fail(g, "error budget exceeded");
			out.ok = false;
			break;
		}
	}
	g.steps += g.n;
	out.i = running_b;
	out.s.clear();
	if exceeded {
		format(out.s, "sorted budget check exceeded at ", running_b);
	} else {
		format(out.s, "sorted budget satisfied with total ", running_b);
	}
	out
}
@end
