slot: cid int
test: list=2,3,4,5 cid=1
expect: => i=3 r=0.0 ok=true s="primes cached count=3" errors=0 n=4 res=[3,4,5,2] cache=1 hits=0
test: list=7,11,10 cid=2
expect: => i=2 r=0.0 ok=true s="primes cached count=2" errors=0 n=3 res=[11,10,7] cache=1 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cid};
	var count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) { count++; }
	}
	if g.n > 1 {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
	}
	gold_cache_put(g, c, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "primes cached count=", count);
	out
}
@end
