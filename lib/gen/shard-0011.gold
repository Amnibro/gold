@entry 4a25c89cbfd2aac8
kind: step
verb: validate
noun: tail
modifier: at_most
context: loop
phrase: validate loop tail values stay at most {ceiling}
phrase: verify trailing loop elements remain below {ceiling}
slot: ceiling int
test: list=10,20,15 ceiling=25
expect: => i=1 r=0.0 ok=true s="tail ceiling check true" errors=0 n=3 res=[10,20,15] cache=0 hits=0
test: list=10,30,50 ceiling=40
expect: => i=0 r=0.0 ok=false s="tail ceiling check false" errors=1 n=3 res=[10,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	var ok_tail = true;
	let tail_start = if g.n > 2 { g.n - 2 } else { 0 };
	var k = tail_start;
	while k < g.n {
		if g.res[k] > ceil_val {
			ok_tail = false;
			gold_fail(g, "tail item exceeded ceiling");
			break;
		}
		k++;
	}
	g.steps += g.n;
	out.ok = ok_tail;
	out.i = if ok_tail { 1 } else { 0 };
	out.s.clear();
	format(out.s, "tail ceiling check ", ok_tail);
	out
}
@end
