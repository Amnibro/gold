test: list=5,10,5,10
expect: => i=2 r=0.0 ok=true s="tallied 2 distinct values" errors=0 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var tallies int[>..] = [];
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		while i < g.n && g.res[i] == x { freq++; i++; }
		tallies.push(freq);
	}
	gold_clear(g);
	for t in tallies { gold_push(g, t); }
	g.steps += g.n * g.n;
	out.i = tallies.len;
	out.s.clear();
	format(out.s, "tallied ", tallies.len, " distinct values");
	out
}
@end
