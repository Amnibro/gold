@entry d23621b69cad3746
kind: step
verb: sort
noun: streak
modifier: between
context: stats
phrase: sort longest streak of values between range {low} {high}
phrase: order longest contiguous streak between bounds {low} {high}
slot: low int
slot: high int
test: list=1,15,12,18,2,20 low=10 high=20
expect: => i=3 r=0.0 ok=true s="sorted streak of length 3" errors=0 n=3 res=[12,15,18] cache=0 hits=0
test: list=5,25,22,28,30 low=20 high=30
expect: => i=4 r=0.0 ok=true s="sorted streak of length 4" errors=0 n=4 res=[22,25,28,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var best_start = 0;
	var best_len = 0;
	var cur_start = 0;
	var cur_len = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if cur_len == 0 { cur_start = i; }
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 0;
		}
	}
	var streak int[512] = [0; 512];
	for j in best_len {
		streak[j] = g.res[best_start + j];
	}
	for i in best_len {
		for j in best_len - 1 {
			if streak[j] > streak[j + 1] {
				let tmp = streak[j];
				streak[j] = streak[j + 1];
				streak[j + 1] = tmp;
			}
		}
	}
	gold_clear(g);
	for j in best_len { gold_push(g, streak[j]); }
	out.i = best_len;
	g.steps += g.n;
