code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${left};
	let r = ${right};
	if l < 0 || r >= out.s.len || l >= r {
		gold_fail(g, "invalid bounds for text rotate");
		out.ok = false;
		return out;
	}
	let first = out.s[l];
	var i = l;
	while i < r {
		out.s[i] = out.s[i + 1];
		i++;
	}
	out.s[r] = first;
	g.steps += r - l;
	out.i = r - l;
	out
}
@end
