code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	var kept_count = 0;
	while kept_count < g.n {
		if sum + g.res[kept_count] > limit { break; }
		sum += g.res[kept_count];
		kept_count++;
	}
	g.n = kept_count;
	g.steps += g.n * g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "running total kept ", kept_count);
	out
}
@end
