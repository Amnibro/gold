@entry bb488df2d7a0cf2c
kind: step
verb: sort
noun: average
modifier: every_other
context: stats
phrase: sort elements around average of every other value
phrase: partition elements relative to alternate average
test: list=12,5,30,2,8
expect: => i=16 r=0.0 ok=true s="partitioned around average 16" errors=0 n=5 res=[12,5,2,8,30] cache=0 hits=0
test: list=50,1,20,3,10
expect: => i=26 r=0.0 ok=true s="partitioned around average 26" errors=0 n=5 res=[1,20,3,10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		count++;
		i += 2;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	var lower int[512] = [0; 512];
	var upper int[512] = [0; 512];
	var n_lo = 0;
	var n_hi = 0;
	for j in g.n {
		let x = g.res[j];
		if x < avg { lower[n_lo] = x; n_lo++; }
		else { upper[n_hi] = x; n_hi++; }
	}
	gold_clear(g);
	for j in n_lo { gold_push(g, lower[j]); }
	for j in n_hi { gold_push(g, upper[j]); }
	out.i = avg;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "partitioned around average ", avg);
	out
}
@end
