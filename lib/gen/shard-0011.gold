fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var space_count = 0;
	let len = out.s.len;
	if len > 0 {
		var i = len - 1;
		while i >= 0 {
			if out.s[i] == ' ' {
				space_count++;
			}
			if i == 0 { break; }
			i--;
		}
	}
	if space_count == 0 {
		gold_fail(g, "no whitespace found in text");
		out.ok = false;
	}
	g.steps += len;
	out.i = space_count;
	out.s.clear();
	format(out.s, "detected ", space_count, " reverse spaces");
	out
}
