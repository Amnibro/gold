code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sz = ${tail_size};
	if sz > g.n { sz = g.n; }
	if sz == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "safe tail mean: ", 0);
		return out;
	}
	let start = g.n - sz;
	var sum = 0;
	for i in sz { sum += g.res[start + i]; }
	let mean = sum / sz;
	g.steps += sz;
	out.i = mean;
	out.s.clear();
	format(out.s, "safe tail mean: ", mean);
	out
}
@end
