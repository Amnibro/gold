expect: => i=6 r=0.0 ok=true s="sorted prefix sum 6" errors=0 n=4 res=[2,4,1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = g.res[0];
	var i = 1;
	while i < g.n && g.res[i] >= g.res[i - 1] {
		sum += g.res[i];
		i++;
	}
	g.steps += i;
	out.i = sum;
	out.s.clear();
	format(out.s, "sorted prefix sum ", sum);
	out
}
@end
