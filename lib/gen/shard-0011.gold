@entry a4280bf656819395
kind: step
verb: normalize
noun: head
modifier: sorted
context: retry
phrase: normalize head of retry results ensuring sorted order
phrase: sort leading retry values into ascending order
slot: count int
test: list=30,10,20,5 count=3
expect: => i=3 r=0.0 ok=true s="normalized sorted head elements 3" errors=0 n=4 res=[10,20,30,5] cache=0 hits=0
test: list=5,1 count=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 || k > g.n {
		gold_fail(g, "invalid head count for sorting");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < k {
		var j = i + 1;
		while j < k {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += k * k;
	out.i = k;
	out.s.clear();
	format(out.s, "normalized sorted head elements ", k);
	out
}
@end
