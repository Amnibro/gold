fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_req = ${minimum};
	var satisfies = true;
	for i in g.n {
		if g.res[i] < min_req {
			satisfies = false;
		}
	}
	g.steps += g.n;
	out.ok = satisfies;
	out.i = if satisfies { 1 } else { 0 };
	out.s.clear();
	if satisfies {
		format(out.s, "all items at least minimum");
	} else {
		format(out.s, "some items below minimum");
	}
	out
}
@end
@entry 8f899f8ab830f152
kind: step
verb: count
noun: prefix
modifier: with_cache
context: sort
phrase: count sorted prefix with cache {target}
phrase: measure sorted prefix with cache {target}
slot: target int
test: list=2,5,7,12,15 target=6
expect: => i=2 r=0.0 ok=true s="counted prefix 2 items" errors=0 n=5 res=[2,5,7,12,15] cache=1 hits=0
test: list=1,3,9 target=0
expect: => i=0 r=0.0 ok=true s="counted prefix 0 items" errors=0 n=3 res=[1,3,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var hit_val, has_hit = gold_cache_get(g, tgt);
	if has_hit {
		out.i = hit_val;
		out.s.clear();
		format(out.s, "cached prefix count ", hit_val);
		return out;
	}
	var count = 0;
	while count < g.n && g.res[count] <= tgt {
		count++;
	}
	g.steps += count + 1;
	gold_cache_put(g, tgt, count);
	out.i = count;
	out.s.clear();
	format(out.s, "counted prefix ", count, " items");
	out
}
@end
@entry ed474942a4e4674c
kind: step
verb: retry
noun: spaces
modifier: all
context: sort
phrase: retry gap sort with gap {gap}
phrase: sort across spaces with gap {gap}
slot: gap int
test: list=9,4,6,1,8,3 gap=3
expect: => i=2 r=0.0 ok=true s="gap sort moved 2 elements" errors=0 n=6 res=[1,4,3,9,8,6] cache=0 hits=0
test: list=7,2,5 gap=1
expect: => i=2 r=0.0 ok=true s="gap sort moved 2 elements" errors=0 n=3 res=[2,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_stride = ${gap};
	var moved = 0;
	if g_stride > 0 && g.n > g_stride {
		for i in g_stride..g.n {
			var j = i;
			while j >= g_stride && g.res[j - g_stride] > g.res[j] {
				let tmp = g.res[j];
				g.res[j] = g.res[j - g_stride];
				g.res[j - g_stride] = tmp;
				j -= g_stride;
				moved++;
			}
		}
	}
	g.steps += g.n;
	out.i = moved;
	out.s.clear();
	format(out.s, "gap sort moved ", moved, " elements");
	out
}
@end
