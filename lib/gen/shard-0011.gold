fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient digits for pairwise caching");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		gold_cache_put(g, g.res[i], g.res[i + 1]);
		pairs++;
		i += 2;
	}
	if g.n % 2 != 0 {
		gold_fail(g, "odd number of elements for pairwise caching");
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached digit pairs count ", pairs);
	out
}
@end
@entry f9a7c94beead2422
kind: step
verb: find
noun: digits
modifier: with_retry
context: error
phrase: find error digits attempting with retry {retries}
phrase: locate digit errors with retry count {retries}
slot: retries int
test: input=120 retries=3
expect: => i=2 r=0.0 ok=true s="found digit with retries 2" errors=0 n=0 res=[] cache=0 hits=0
test: input=0 retries=2
expect: => i=0 r=0.0 ok=false s="found digit with retries 0" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if r <= 0 {
		gold_fail(g, "invalid retry count for digit search");
		out.ok = false;
		return out;
	}
	var cur = out.i;
	var attempts = 0;
	var found_digit = 0;
	while cur > 0 && attempts < r {
		let d = cur % 10;
		if d != 0 {
			found_digit = d;
			break;
		}
		cur /= 10;
		attempts++;
	}
	if found_digit == 0 {
		gold_fail(g, "failed to find error digit within retries");
		out.ok = false;
	}
	g.steps += attempts + 1;
	out.i = found_digit;
	out.s.clear();
	format(out.s, "found digit with retries ", found_digit);
	out
}
@end
