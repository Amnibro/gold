@entry 734e9d6560c7a138
kind: step
verb: scale
noun: tally
modifier: unique
context: format
phrase: format tally of unique elements scaled by factor {factor}
phrase: render scaled unique elements count with multiplier {factor}
slot: factor int
test: list=1,2,2,3,3,3 factor=2
expect: => i=6 r=0.0 ok=true s="scaled unique tally: 6" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,5 factor=3
expect: => i=3 r=0.0 ok=true s="scaled unique tally: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var uniq = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { uniq++; }
	}
	let scaled = uniq * mult;
	out.s.clear();
	format(out.s, "scaled unique tally: ", scaled);
	out.i = scaled;
	g.steps += g.n * g.n;
	out
}
@end
