fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var valid = true;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let ad = if diff < 0 { -diff } else { diff };
			if ad > ms {
				valid = false;
				break;
			}
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "pairwise steps valid: true");
	} else {
		format(out.s, "pairwise steps valid: false");
	}
	g.steps += g.n;
	out
}
