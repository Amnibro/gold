test: text="strength"
expect: => i=3 r=0.0 ok=true s="engthstr" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_vowel(ch byte) bool {
	ch == 97 as byte || ch == 101 as byte || ch == 105 as byte || ch == 111 as byte || ch == 117 as byte
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 { return out; }
	var rot = 0;
	while rot < out.s.len && !${ID}_is_vowel(out.s[0]) {
		let first = out.s[0];
		for i in out.s.len - 1 {
			out.s[i] = out.s[i + 1];
		}
		out.s[out.s.len - 1] = first;
		rot++;
	}
	g.steps += rot;
	out.i = rot;
	out
}
@end
