fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= limit { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " gaps up to limit");
	out
}
@end
