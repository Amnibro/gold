@entry 4897ddb01b8cb77c
kind: step
verb: rotate
noun: loop
modifier: any
context: format
phrase: rotate loop elements by any shift amount {shift}
phrase: cycle loop items by arbitrary shift {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=4 r=0.0 ok=true s="rotated loop by 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=1,2,3 shift=2
expect: => i=3 r=0.0 ok=true s="rotated loop by 2" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 0 {
		var eff = s % g.n;
		while eff < 0 { eff += g.n; }
		for step in eff {
			let first = g.res[0];
			for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
			g.res[g.n - 1] = first;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated loop by ", s);
	g.steps += g.n;
	out
}
@end
