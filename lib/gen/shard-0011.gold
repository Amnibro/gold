@entry f2d31afc5cb7ca40
kind: step
verb: reverse
noun: item
modifier: with_retry
context: core
phrase: reverse item order with retry limit {retries}
phrase: invert element sequence permitting {retries} retry attempts
slot: retries int
test: list=1,2,3,4 retries=1
expect: => i=4 r=0.0 ok=true s="reversed items: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30 retries=2
expect: => i=3 r=0.0 ok=true s="reversed items: 3" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed items: ", g.n);
	g.steps += g.n + r;
	out
}
