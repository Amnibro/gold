test: list=10,20,30,20,10
expect: => i=2 r=0.0 ok=true s="directions: +2 -2 =0" errors=0 n=5 res=[10,20,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var inc = 0;
	var dec = 0;
	var eq = 0;
	for i in (g.n - 1) {
		let a = g.res[i];
		let b = g.res[i + 1];
		if b > a { inc++; }
		else if b < a { dec++; }
		else { eq++; }
	}
	out.s.clear();
	format(out.s, "directions: +", inc, " -", dec, " =", eq);
	g.steps += g.n;
	out.i = inc;
	out
}
@end
