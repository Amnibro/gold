@entry 3b6c1e446559dc1d
kind: step
verb: drop
noun: average
modifier: until
context: math
phrase: drop tail elements until average reaches at least {target}
phrase: trim results until average reaches {target}
slot: target int
test: list=10,20,30,40 target=25
expect: => i=25 r=0.0 ok=true s="dropped to average 25 with 4 items" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,10,30 target=20
expect: => i=20 r=0.0 ok=true s="dropped to average 20 with 2 items" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var start = 0;
	while start < g.n {
		var sum = 0;
		for i in start..g.n { sum += g.res[i]; }
		let count = g.n - start;
		if sum / count >= tgt || count <= 1 { break; }
		start++;
	}
	var kept = 0;
	for i in start..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	var final_sum = 0;
	for i in g.n { final_sum += g.res[i]; }
	let avg = if g.n > 0 { final_sum / g.n } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "dropped to average ", avg, " with ", g.n, " items");
	out
}
@end
