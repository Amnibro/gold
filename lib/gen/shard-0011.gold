fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var excess = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] > b {
			excess += g.res[i] - b;
			count++;
		}
	}
	g.steps += g.n;
	out.i = excess;
	out.s.clear();
	format(out.s, "measured ", count, " items exceeding bound by ", excess);
	out
}
@end
