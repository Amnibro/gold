@entry 758d439a070b6301
kind: step
verb: filter
noun: gaps
modifier: pairwise
context: retry
phrase: filter retry gaps pairwise where gap exceeds {max_gap}
phrase: remove retry items whose pairwise gap exceeds {max_gap}
slot: max_gap int
test: list=2,5,10,12,30 max_gap=4
expect: => i=2 r=0.0 ok=true s="filtered pairwise gap size 2" errors=0 n=2 res=[2,5] cache=0 hits=0
test: list=1,2,8,9,15 max_gap=3
expect: => i=2 r=0.0 ok=true s="filtered pairwise gap size 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[kept - 1];
		let ad = if diff < 0 { -diff } else { diff };
		if ad <= limit {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
