fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	let start = if low >= 0 { low } else { 0 };
	let end = if high < g.n { high + 1 } else { g.n };
	var min_val = 1000000;
	if start < end {
		for i in start..end {
			if g.res[i] < min_val { min_val = g.res[i]; }
		}
		gold_cache_put(g, 0, min_val);
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "cached minimum between range ", min_val);
	out
}
@end
