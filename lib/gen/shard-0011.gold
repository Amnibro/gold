@entry 3d0dd45484a7da7c
kind: step
verb: swap
noun: item
modifier: sorted
context: stats
phrase: swap out of order items into sorted positions
phrase: sort sample values by swapping elements directly
test: list=3,1,2
expect: => i=2 r=0.0 ok=true s="sorted with 2 swaps" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,4,3,2,1
expect: => i=10 r=0.0 ok=true s="sorted with 10 swaps" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted with ", swaps, " swaps");
	out
}
@end
