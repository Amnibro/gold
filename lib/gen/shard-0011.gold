fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback_val};
	gold_fail(g, "initial error");
	let old_err = g.errors;
	g.errors = 0;
	g.err.clear();
	gold_push(g, fb);
	out.ok = true;
	g.steps += 1;
	out.i = fb;
	out.s.clear();
	format(out.s, "cleared ", old_err, " errors with fallback ", fb);
	out
}
@end
