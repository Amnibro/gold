@entry 21cc2cbfe70f4625
kind: step
verb: reverse
noun: function
modifier: between
context: sort
phrase: reverse elements between indices {start} to {stop}
phrase: invert sorted slice from index {start} to {stop}
slot: start int
slot: stop int
test: list=1,2,3,4,5,6 start=1 stop=4
expect: => i=4 r=0.0 ok=true s="reversed slice of 4 items" errors=0 n=6 res=[1,5,4,3,2,6] cache=0 hits=0
test: list=10,20,30,40 start=0 stop=2
expect: => i=3 r=0.0 ok=true s="reversed slice of 3 items" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s0 = ${start};
	let s1 = ${stop};
	let lo = if s0 < 0 { 0 } else { s0 };
	let hi = if s1 >= g.n { g.n - 1 } else { s1 };
	if lo < hi {
		var i = lo;
		var j = hi;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	let span = if hi >= lo { hi - lo + 1 } else { 0 };
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed slice of ", span, " items");
	out
}
@end
@entry 14ebc3de0169f287
kind: step
verb: map
noun: primes
modifier: running
context: sort
phrase: map prime indicators across sorted values
phrase: flag prime numbers in sorted sequence
test: list=1,2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="mapped 4 primes" errors=0 n=7 res=[0,1,1,0,1,0,1] cache=0 hits=0
test: list=9,10,11,12
expect: => i=1 r=0.0 ok=true s="mapped 1 primes" errors=0 n=4 res=[0,0,1,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[i] = 1;
			prime_count++;
		} else {
			g.res[i] = 0;
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "mapped ", prime_count, " primes");
	out
}
@end
