kind: step
verb: drop
noun: suffix
modifier: between
context: error
phrase: drop error suffix values bounded by {low} through {high}
phrase: prune suffix errors bounded within {low} through {high}
slot: low int
slot: high int
test: list=10,20,5,8 low=4 high=9
expect: => i=2 r=0.0 ok=true s="dropped suffix elements count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=10,20,30 low=1 high=5
expect: => i=0 r=0.0 ok=false s="dropped suffix elements count 0" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var dropped = 0;
	while g.n > 0 {
		let last = g.res[g.n - 1];
		if last >= lo && last <= hi {
			g.n--;
			dropped++;
		} else {
			break;
		}
	}
	if dropped == 0 {
		gold_fail(g, "no suffix elements dropped between bounds");
		out.ok = false;
	}
	g.steps += dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped suffix elements count ", dropped);
	out
}
@end
