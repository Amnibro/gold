fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top = ${cap};
	var total = 0;
	for i in g.n {
		total += g.res[i] * g.res[i];
	}
	out.s.clear();
	if total <= top {
		out.i = total;
		format(out.s, "squared sum=", total);
	} else {
		var retry_tot = 0;
		for i in g.n {
			let h = g.res[i] / 2;
			retry_tot += h * h;
		}
		out.i = retry_tot;
		format(out.s, "squared sum with retry=", retry_tot);
	}
	g.steps += g.n;
	out
}
@end
