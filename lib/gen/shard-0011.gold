code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_uniq = true;
	var i = 0;
	while i < g.n && all_uniq {
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] {
				all_uniq = false;
				gold_fail(g, "duplicate value found in comparison");
				break;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = all_uniq;
	out.i = if all_uniq { 1 } else { 0 };
	out.s.clear();
	format(out.s, "comparison values unique ", all_uniq);
	out
}
@end
@entry 807f1abd5b1faafb
