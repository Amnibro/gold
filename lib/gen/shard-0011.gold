test: list=9,8,7 times=1
expect: => i=2 r=0.0 ok=true s="retried 1 sort passes" errors=0 n=3 res=[8,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${times};
	var total_swaps = 0;
	for p in passes {
		if g.n > 1 {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let temp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = temp;
					total_swaps++;
				}
			}
		}
	}
	g.steps += passes * g.n;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "retried ", passes, " sort passes");
	out
}
@end
