fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[on] = g.res[i];
			on++;
		}
	}
	for i in on {
		for j in (i + 1)..on {
			if odds[j] < odds[i] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
		}
	}
	var o_idx = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = odds[o_idx];
			o_idx++;
		}
	}
	g.steps += g.n + on * on;
	out.i = on;
	out.s.clear();
	format(out.s, "sorted odd elements count ", on);
	out
}
@end
