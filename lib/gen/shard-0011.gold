expect: => i=3 r=0.0 ok=true s="sorted middle 3 items" errors=0 n=5 res=[100,10,20,50,80] cache=0 hits=0
test: list=9,7,3,1
expect: => i=2 r=0.0 ok=true s="sorted middle 2 items" errors=0 n=4 res=[9,1,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least three items to sort middle");
		out.ok = false;
		return out;
	}
	var i = 1;
	while i < g.n - 1 {
		var j = 1;
		while j < g.n - 1 - (i - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n - 2;
	out.s.clear();
	format(out.s, "sorted middle ", g.n - 2, " items");
	out
}
@end
