@entry 77d9f24a6e3e549c
kind: step
verb: find
noun: duplicates
modifier: recursively
context: list
phrase: find duplicate elements appearing recursively across list
phrase: count recursive duplicate occurrences in list
test: list=1,2,2,3,3,3
expect: => i=2 r=0.0 ok=true s="found 2 distinct duplicated values" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="found 0 distinct duplicated values" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x { freq++; }
			}
			if freq > 1 { dup_count++; }
		}
	}
	g.steps += g.n * g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "found ", dup_count, " distinct duplicated values");
	out
}
@end
