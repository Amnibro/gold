noun: digits
modifier: at_least
context: sort
phrase: retry radix distribution for digit position {pos}
phrase: sort by digit at position {pos} with retry
slot: pos int
test: list=42,15,31,24 pos=1
expect: => i=1 r=0.0 ok=true s="sorted by digit divisor 1" errors=0 n=4 res=[31,42,24,15] cache=0 hits=0
test: list=102,51,32 pos=10
expect: => i=10 r=0.0 ok=true s="sorted by digit divisor 10" errors=0 n=3 res=[102,32,51] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pos};
	let div = if p <= 0 { 1 } else { p };
	if g.n > 1 {
		for i in g.n {
			for j in 0..(g.n - 1 - i) {
				let d1 = (g.res[j] / div) % 10;
				let d2 = (g.res[j + 1] / div) % 10;
				if d1 > d2 {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = div;
	out.s.clear();
	format(out.s, "sorted by digit divisor ", div);
	out
}
@end
@entry edfe37c415198c42
kind: step
verb: pair
noun: memo
modifier: in_reverse
context: sort
phrase: pair memoized bounds in reverse order
phrase: combine cached extrema in reverse sorted order
test: list=3,1,9,4,7
expect: => i=8 r=0.0 ok=true s="memoized bounds range 8" errors=0 n=5 res=[3,1,9,4,7] cache=2 hits=0
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="memoized bounds range 20" errors=0 n=3 res=[10,20,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty array");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	gold_cache_put(g, 0, max_val);
	gold_cache_put(g, 1, min_val);
	g.steps += g.n;
	out.i = max_val - min_val;
	out.s.clear();
	format(out.s, "memoized bounds range ", out.i);
	out
}
@end
