@entry ff756d197202a167
kind: step
verb: dedupe
noun: primes
modifier: each
context: aggregate
phrase: dedupe prime factors across each result element
phrase: remove duplicate primes for each aggregate value
test: list=2,3,2,5,3,7
expect: => i=4 r=0.0 ok=true s="deduped primes count 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8,2,2
expect: => i=4 r=0.0 ok=true s="deduped primes count 4" errors=0 n=4 res=[4,6,8,2] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen { g.res[w] = x; w++; }
		} else {
			g.res[w] = x; w++;
		}
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped primes count ", w);
	out
}
@end
