fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var count = 0;
	while count < g.n && g.res[count] < cut {
		count++;
	}
	if count == 0 {
		gold_fail(g, "zero elements under checkpoint cutoff");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: immediate cutoff");
		return out;
	}
	gold_push(g, count);
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "checkpoint prefix count ", count);
	out
}
@end
