noun: average
modifier: with_cache
context: compare
phrase: reverse list comparing against cached average
phrase: invert elements storing average in cache
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="reversed list with cached average 20" errors=0 n=3 res=[30,20,10] cache=1 hits=0
test: list=1,5,9
expect: => i=5 r=0.0 ok=true s="reversed list with cached average 5" errors=0 n=3 res=[9,5,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	gold_cache_put(g, 0, avg);
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n * 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "reversed list with cached average ", avg);
	out
}
@end
