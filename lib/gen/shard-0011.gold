test: list=2,3,4,5,6
expect: => i=2 r=0.0 ok=true s="reversed alternating evens count 2" errors=0 n=5 res=[6,3,4,5,2] cache=0 hits=0
test: list=8,10,12,14
expect: => i=2 r=0.0 ok=true s="reversed alternating evens count 2" errors=0 n=4 res=[12,10,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[>..] = [];
	var idxs int[>..] = [];
	var seen = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			if seen % 2 == 0 {
				evens.push(g.res[k]);
				idxs.push(k);
			}
			seen++;
		}
	}
	let m = idxs.len;
	for j in m {
		g.res[idxs[j]] = evens[m - 1 - j];
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "reversed alternating evens count ", m);
	out
}
@end
