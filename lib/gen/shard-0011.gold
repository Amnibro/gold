context: stats
phrase: reverse elements when count is at least {min_items}
phrase: invert dataset order when size reaches at least {min_items}
slot: min_items int
test: list=1,2,3 min_items=3
expect: => i=3 r=0.0 ok=true s="sample reversed: true" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=4,5 min_items=3
expect: => i=2 r=0.0 ok=false s="sample reversed: false" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_items};
	var reversed = false;
	if g.n >= req {
		var a = 0;
		var b = g.n - 1;
		while a < b {
			let tmp = g.res[a];
			g.res[a] = g.res[b];
			g.res[b] = tmp;
			a++;
			b--;
		}
		reversed = true;
	}
	g.steps += g.n;
	out.ok = reversed;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sample reversed: ", reversed);
	out
}
@end
