@entry b421b4147197c296
kind: step
verb: limit
noun: evens
modifier: unique
context: format
phrase: limit unique evens formatting at most {cap_count} items
phrase: format distinct even numbers up to {cap_count}
slot: cap_count int
test: list=2,2,4,4,6,8 cap_count=2
expect: => i=2 r=0.0 ok=true s="evens: {2, 4}" errors=0 n=6 res=[2,2,4,4,6,8] cache=0 hits=0
test: list=10,12,12,14,16 cap_count=3
expect: => i=3 r=0.0 ok=true s="evens: {10, 12, 14}" errors=0 n=5 res=[10,12,12,14,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap_count};
	var seen int[512] = [0; 512];
	var count = 0;
	out.s.clear();
	out.s.append("evens: {");
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var was_seen = false;
			for j in count { if seen[j] == x { was_seen = true; break; } }
			if !was_seen && count < limit {
				if count > 0 { out.s.append(", "); }
				seen[count] = x;
				format(out.s, x);
				count++;
			}
		}
	}
	out.s.append("}");
	g.steps += g.n;
	out.i = count;
	out
}
@end
