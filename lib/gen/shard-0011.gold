	for i in out.s.len {
		let c = out.s[i];
		if c < 48 as byte || c > 57 as byte {
			all_digits = false;
			break;
		}
	}
	out.ok = all_digits;
	out.i = if all_digits { 1 } else { 0 };
	out.s.clear();
	if all_digits {
		format(out.s, "digits valid");
	} else {
		format(out.s, "digits invalid");
	}
	g.steps += out.s.len;
	out
}
@end
