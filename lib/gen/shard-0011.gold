fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var take = lim;
	if take > g.n { take = g.n; }
	if take < 0 { take = 0; }
	var sum_val = 0;
	let start = g.n - take;
	for i in start..g.n {
		sum_val += g.res[i];
	}
	g.steps += take;
	out.i = sum_val;
	out.s.clear();
	format(out.s, "paired last ", take, " elements to sum ", sum_val);
	out
}
@end
