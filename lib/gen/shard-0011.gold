expect: => i=3 r=0.0 ok=true s="scaled unique items 3" errors=0 n=4 res=[20,20,20,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var scaled = 0;
	for k in g.n {
		var is_first = true;
		for j in k {
			if g.res[j] == g.res[k] { is_first = false; break; }
		}
		if is_first {
			g.res[k] = g.res[k] * m;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled unique items ", scaled);
	out
}
@end
