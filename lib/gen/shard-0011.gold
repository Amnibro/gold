@entry edf4680cabe4fbcc
kind: step
verb: sort
noun: steps
modifier: until
context: filter
phrase: sort results performing steps until boundary {bound}
phrase: bubble sort steps until element reaches {bound}
slot: bound int
test: list=9,3,7,1,5 bound=8
expect: => i=4 r=0.0 ok=true s="sorted steps count 4" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=5,4,3,2,1 bound=20
expect: => i=5 r=0.0 ok=true s="sorted steps count 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var passes = 0;
	var swapped = true;
	while swapped && passes < g.n {
		swapped = false;
		var i = 0;
		while i < g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			if g.res[i] >= b {
				break;
			}
			i++;
		}
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "sorted steps count ", passes);
	out
}
@end
