code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low} as byte;
	let hi = ${high} as byte;
	for i in out.s.len {
		if out.s[i] < lo { out.s[i] = lo; }
		if out.s[i] > hi { out.s[i] = hi; }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
