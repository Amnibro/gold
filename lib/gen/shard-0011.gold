code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${factor};
	var err_total = 0;
	var mult = 1;
	for k in g.n {
		if g.res[k] < 0 {
			err_total += (-g.res[k]) * mult;
			mult *= w;
		}
	}
	g.steps += g.n;
	out.i = err_total;
	out.s.clear();
	format(out.s, "recursive error penalty ", err_total);
	out
}
@end
