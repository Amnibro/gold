expect: => i=2 r=0.0 ok=false s="prefix up to index 2 is not strictly increasing" errors=0 n=4 res=[5,3,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${idx} < g.n { ${idx} } else { g.n };
	var increasing = true;
	if limit > 1 {
		for i in limit - 1 {
			if g.res[i] >= g.res[i + 1] {
				increasing = false;
				break;
			}
		}
	}
	g.steps += limit;
	out.ok = increasing;
	out.i = limit;
	out.s.clear();
	if increasing {
		format(out.s, "prefix up to index ", limit, " is strictly increasing");
	} else {
		format(out.s, "prefix up to index ", limit, " is not strictly increasing");
	}
	out
}
@end
