test: list=4,2,2,3,3,3,1 min_count=2
expect: => i=5 r=0.0 ok=true s="safely kept count 5" errors=0 n=5 res=[2,2,3,3,3] cache=0 hits=0
test: list=5,5,8,9 min_count=3
expect: => i=0 r=0.0 ok=true s="safely kept count 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_count};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq >= min_c { kept.push(x); }
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "safely kept count ", kept.len);
	out
}
@end
