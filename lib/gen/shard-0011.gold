code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top_val = ${ceiling};
	var clamped = 0;
	for k in g.n {
		if g.res[k] > top_val {
			g.res[k] = top_val;
			clamped++;
		}
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped history sorted modifications ", clamped);
	out
}
@end
