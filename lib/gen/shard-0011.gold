code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_val};
	var count = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] && g.res[i] >= limit {
				g.res[i + 1] = -g.res[i + 1];
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "adjusted ", count, " duplicate pairs meeting threshold");
	out
}
@end
