@entry 016d3f87baf3fe6e
kind: step
verb: merge
noun: budget
modifier: any
context: retry
phrase: merge retry budget with any remaining capacity {cap}
phrase: combine items under retry budget capacity {cap}
slot: cap int
test: list=10,20,15 cap=50
expect: => i=45 r=0.0 ok=true s="merged budget total: 45" errors=0 n=1 res=[45] cache=0 hits=0
test: list=30,40 cap=50
expect: => i=30 r=0.0 ok=false s="merged budget total: 30" errors=1 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var total = 0;
	var kept = 0;
	for i in g.n {
		if total + g.res[i] <= c {
			total += g.res[i];
			kept++;
		} else {
			gold_fail(g, "retry budget capacity exceeded");
			out.ok = false;
			break;
		}
	}
	g.res[0] = total;
	g.n = if total > 0 { 1 } else { 0 };
	g.steps += kept + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "merged budget total: ", total);
	out
}
@end
