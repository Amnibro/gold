fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var max_val = 1;
	for i in mid {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	gold_cache_put(g, 0, max_val);
	var updated = 0;
	for i in mid..g.n {
		if max_val > 0 {
			g.res[i] = g.res[i] % max_val;
			updated++;
		}
	}
	g.steps += g.n;
	out.i = updated;
	out.s.clear();
	format(out.s, "normalized tail elements safely ", updated);
	out
}
@end
