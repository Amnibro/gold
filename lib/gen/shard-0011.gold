expect: => i=5 r=0.0 ok=true s="dropped minimum cache value 5" errors=0 n=4 res=[5,15,25,35] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var min_idx = 0;
	if g.cn > 0 {
		var min_val = g.cv[0];
		for i in g.cn {
			if g.cv[i] < min_val {
				min_val = g.cv[i];
				min_idx = i;
			}
		}
		for i in min_idx..(g.cn - 1) {
			g.ck[i] = g.ck[i + 1];
			g.cv[i] = g.cv[i + 1];
		}
		g.cn--;
		out.i = min_val;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "dropped minimum cache value ", out.i);
	out
}
@end
