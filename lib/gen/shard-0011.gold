kind: step
verb: find
noun: results
modifier: with_retry
context: retry
phrase: find target retry result with retries {retries}
phrase: search results for target using retries {retries}
slot: target int
slot: retries int
test: list=10,20,30 target=20 retries=3
expect: => i=1 r=0.0 ok=true s="found target result at index 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=1,2,3 target=99 retries=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	var found_idx = -1;
	var attempts = 0;
	for i in g.n {
		if attempts < r {
			attempts++;
			if g.res[i] == tgt {
				found_idx = i;
				break;
			}
		}
	}
	if found_idx < 0 {
		gold_fail(g, "target result not found within retry limit");
		out.ok = false;
		return out;
	}
	g.steps += attempts;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "found target result at index ", found_idx);
	out
}
@end
