	let tgt = ${target};
	var max_run = 0;
	var cur_run = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] == tgt {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 0;
		}
		idx++;
	}
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
