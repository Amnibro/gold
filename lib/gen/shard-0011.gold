fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = out.s.len - 1;
	while i >= 0 {
		let code = out.s[i] as int;
		if ${cond}(code) {
			gold_push(g, code);
			kept++;
		}
		i--;
	}
	g.steps += out.s.len;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " matching characters in reverse");
	out
}
