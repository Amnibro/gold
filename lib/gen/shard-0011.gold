fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[256] = [0; 256];
	for i in out.s.len {
		let c = out.s[i] as int;
		counts[c]++;
	}
	var distinct = 0;
	for c in 256 {
		if counts[c] > 0 {
			gold_push(g, counts[c]);
			distinct++;
		}
	}
	g.steps += out.s.len;
	out.i = distinct;
	out.s.clear();
	format(out.s, "traced histogram of ", distinct, " distinct characters");
	out
}
@end
