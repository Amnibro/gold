fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	for i in g.n {
		if g.res[i] != 0 {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	let removed = g.n - kn;
	for i in kn { g.res[i] = kept[i]; }
	g.n = kn;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "recursively shifted zero gaps count ", removed);
	out
}
@end
