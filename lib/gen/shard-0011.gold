@entry 538ef5893d715071
kind: step
verb: reverse
noun: cache
modifier: at_least
context: sort
phrase: reverse sorted elements having at least {min_val}
phrase: invert sorted values of at least {min_val}
slot: min_val int
test: list=1,3,5,7,9 min_val=5
expect: => i=3 r=0.0 ok=true s="reversed 3 elements at least threshold" errors=0 n=5 res=[1,3,9,7,5] cache=0 hits=0
test: list=2,4,6,8 min_val=4
expect: => i=3 r=0.0 ok=true s="reversed 3 elements at least threshold" errors=0 n=4 res=[2,8,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var start = 0;
	while start < g.n && g.res[start] < mv {
		start++;
	}
	let count = g.n - start;
	for i in count / 2 {
		let j = count - 1 - i;
		let t = g.res[start + i];
		g.res[start + i] = g.res[start + j];
		g.res[start + j] = t;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " elements at least threshold");
	out
}
@end
