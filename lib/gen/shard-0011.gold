@entry ee40b8971c86659f
kind: step
verb: repeat
noun: average
modifier: with_retry
context: compare
phrase: repeat comparison average calculation with retry ceiling {retries}
phrase: recompute running average across comparison set with retry bound {retries}
slot: retries int
test: list=10,20,30 retries=2
expect: => i=20 r=0.0 ok=true s="recomputed average 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 retries=3
expect: => i=10 r=0.0 ok=true s="recomputed average 10" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_limit = ${retries};
	var r = 0;
	var final_avg = 0;
	while r < r_limit && g.n > 0 {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		final_avg = sum / g.n;
		r++;
	}
	g.steps += r * g.n;
	out.i = final_avg;
	out.s.clear();
	format(out.s, "recomputed average ", final_avg);
	out
}
@end
