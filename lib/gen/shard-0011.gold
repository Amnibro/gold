code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n > 1 {
		var shift = k % g.n;
		for s in shift {
			let first = g.res[0];
			for i in 1..g.n {
				g.res[i - 1] = g.res[i];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated safely by ", k);
	out
}
@end
