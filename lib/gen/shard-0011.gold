expect: => i=-1 r=0.0 ok=false s="reverse prefix found index -1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let t = ${target};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	var found_idx = -1;
	var i = bound - 1;
	while i >= 0 {
		if g.res[i] == t {
			found_idx = i;
			break;
		}
		i--;
	}
	g.steps += bound;
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "reverse prefix found index ", found_idx);
	out
}
@end
@entry c4291c97f4f89cba
kind: step
verb: validate
noun: average
modifier: last
context: filter
phrase: validate average of last items meets threshold {count} {min_avg}
phrase: check trailing average against minimum score {count} {min_avg}
slot: count int
slot: min_avg int
test: list=10,20,30,40 count=3 min_avg=25
expect: => i=30 r=0.0 ok=true s="validated last average 30" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,10 count=2 min_avg=10
expect: => i=7 r=0.0 ok=false s="validated last average 7" errors=0 n=3 res=[5,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let req = ${min_avg};
	if k <= 0 || g.n == 0 {
		gold_fail(g, "empty results for average validation");
		out.ok = false;
		return out;
	}
	var start = if g.n > k { g.n - k } else { 0 };
	var sum = 0;
	let actual = g.n - start;
	for i in actual {
		sum += g.res[start + i];
	}
	let avg = sum / actual;
	let valid = avg >= req;
	g.steps += actual;
	out.ok = valid;
	out.i = avg;
	out.s.clear();
	format(out.s, "validated last average ", avg);
	out
}
@end
