fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen bool[256] = [false; 256];
	var buf byte[>..] = [];
	for i in out.s.len {
		let c = out.s[i];
		let idx = c as int;
		if !seen[idx] {
			seen[idx] = true;
			buf.push(c);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = buf.len;
	g.steps += out.s.len;
	out
}
