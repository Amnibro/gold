fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for i in g.n {
		if kept >= limit { break; }
		var first_time = true;
		for j in kept {
			if g.res[j] == g.res[i] { first_time = false; break; }
		}
		if first_time {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept unique count ", kept);
	out
}
@end
