code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] > 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "positive elements count: ", kept);
	out
}
@end
@entry 051f123b358b2e1d
kind: step
verb: clamp
noun: values
modifier: none
context: core
phrase: clamp values none outside range {low} to {high}
phrase: bound values between {low} through {high}
phrase: restrict elements within range {low} up to {high}
slot: low int
slot: high int
test: list=5,15,25 low=10 high=20
expect: => i=3 r=0.0 ok=true s="clamped values count=3" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,5 low=2 high=4
expect: => i=2 r=0.0 ok=true s="clamped values count=2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
		} else if g.res[i] > hi {
			g.res[i] = hi;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped values count=", g.n);
	out
}
@end
