fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${limit};
	var count = 0;
	for k in g.n {
		if ${cond}(g.res[k]) { break; }
		if g.res[k] > ceil_val {
			g.res[k] = ceil_val;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped items until stop condition ", count);
