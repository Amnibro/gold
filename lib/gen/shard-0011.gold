fn ${ID}_trim(g Gold&, ceiling int) int {
	var changes = 0;
	for i in g.n {
		if g.res[i] > ceiling {
			g.res[i] = ceiling;
			changes++;
		}
	}
	changes
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_ch = 0;
	var cap = 100;
	while cap > 40 {
		let ch = ${ID}_trim(g, cap);
		total_ch += ch;
		g.steps += g.n;
		cap -= 20;
	}
	out.i = total_ch;
	out.s.clear();
	format(out.s, "recursively limited series changes ", total_ch);
	out
}
@end
