code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_count = 0;
	var cur_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur_len > 0 {
				word_count++;
				let prev, hit = gold_cache_get(g, cur_len);
				if hit {
					gold_cache_put(g, cur_len, prev + 1);
				} else {
					gold_cache_put(g, cur_len, 1);
				}
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 {
		word_count++;
		let prev, hit = gold_cache_get(g, cur_len);
		if hit {
			gold_cache_put(g, cur_len, prev + 1);
		} else {
			gold_cache_put(g, cur_len, 1);
		}
	}
	g.steps += out.s.len * 2;
	out.i = word_count;
	out.s.clear();
	format(out.s, "grouped word lengths count ", word_count);
	out
}
@end
