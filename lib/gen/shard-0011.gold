noun: limit
modifier: unique
context: search
phrase: return distinct search results up to unique limit {limit}
phrase: collect unique search matches bounded by count {limit}
slot: limit int
test: list=1,2,2,3,4,4,5 limit=3
expect: => i=3 r=0.0 ok=true s="gathered unique count 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="gathered unique count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var distinct int[>..] = [];
	for i in g.n {
		if distinct.len >= lim { break; }
		let x = g.res[i];
		var exists = false;
		for j in distinct.len {
			if distinct[j] == x { exists = true; break; }
		}
		if !exists { distinct.push(x); }
	}
	gold_clear(g);
	for x in distinct { gold_push(g, x); }
	g.steps += g.n + distinct.len;
	out.i = distinct.len;
	out.s.clear();
	format(out.s, "gathered unique count ", distinct.len);
	out
}
@end
