code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			uniq++;
		}
	}
	for i in g.n {
		g.res[i] += uniq;
	}
	g.steps += g.n * g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "shifted tallies by unique categories count ", uniq);
	out
}
@end
