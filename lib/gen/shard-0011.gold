test: list=1,3,5
expect: => i=0 r=0.0 ok=false s="reversed 0 even values" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 32];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && count < 32 {
			evens[count] = g.res[i];
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no even values to reverse");
		out.ok = false;
	} else {
		var rev_idx = count - 1;
		for i in g.n {
			if g.res[i] % 2 == 0 && rev_idx >= 0 {
				g.res[i] = evens[rev_idx];
				rev_idx--;
			}
		}
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " even values");
	out
}
@end
