	let max_s = ${limit};
	var w = 0;
	var streak = 0;
	var last_v = 0;
	for k in g.n {
		if k == 0 || g.res[k] != last_v {
			last_v = g.res[k];
			streak = 1;
		} else {
			streak++;
		}
		if streak <= max_s {
			g.res[w] = g.res[k];
			w++;
		}
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "clamped repeated streak items to ", w);
