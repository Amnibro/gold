@entry 6ecb0f3ed472d819
kind: step
verb: pair
noun: squares
modifier: recursively
context: format
phrase: format pairwise square products recursively for {depth} rounds
phrase: render recursive square pairings over depth {depth}
slot: depth int
test: list=2,3,4,5 depth=1
expect: => i=2 r=0.0 ok=true s="paired squares: [13, 41]" errors=0 n=2 res=[13,41] cache=0 hits=0
test: list=1,2,3,4,5,6 depth=2
expect: => i=2 r=0.0 ok=true s="paired squares: [650, 61]" errors=0 n=2 res=[650,61] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var r = 0;
	while r < d && g.n > 1 {
		var new_n = 0;
		var i = 0;
		while i + 1 < g.n {
			let sq = g.res[i] * g.res[i] + g.res[i + 1] * g.res[i + 1];
			g.res[new_n] = sq;
			new_n++;
			i += 2;
		}
		if i < g.n {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		g.n = new_n;
		r++;
	}
	out.s.clear();
	format(out.s, "paired squares: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += d * g.n;
	out
}
@end
