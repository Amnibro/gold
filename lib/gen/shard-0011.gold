	var p = 1;
	var temp = x;
	while temp >= 10 { p *= 10; temp /= 10; }
	let first_d = temp;
	let middle = (x % p) / 10;
	(last_d * p + middle * 10 + first_d) * sign
}
@end
@entry c6589dab58ee5cc4
kind: pred
verb: check
noun: squares
modifier: pairwise
context: transform
phrase: check pairwise digit squares condition
phrase: verify adjacent digits are squares
test: arg=1492
expect: true
test: arg=2357
expect: false
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let prod = cur * prev;
		var is_sq = false;
		for s in 10 {
			if s * s == prod { is_sq = true; break; }
		}
		if is_sq { return true; }
		prev = cur;
		x /= 10;
	}
	false
}
@end
