slot: factor int
test: list=1,3,6 factor=2
expect: => i=2 r=0.0 ok=true s="merged 2 sequence differences" errors=0 n=2 res=[4,6] cache=0 hits=0
test: list=10,20,35 factor=3
expect: => i=2 r=0.0 ok=true s="merged 2 sequence differences" errors=0 n=2 res=[30,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let mult = ${factor};
	let pairs = g.n - 1;
	for i in pairs {
		g.res[i] = (g.res[i + 1] - g.res[i]) * mult;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "merged ", pairs, " sequence differences");
	out
}
@end
