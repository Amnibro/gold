expect: => i=3 r=0.0 ok=true s="computed 3 pairwise relations" errors=0 n=3 res=[1,-1,1] cache=0 hits=0
test: list=10,10,5
expect: => i=2 r=0.0 ok=true s="computed 2 pairwise relations" errors=0 n=2 res=[0,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let num_pairs = g.n - 1;
	for i in num_pairs {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff > 0 { 1 } else if diff < 0 { -1 } else { 0 };
	}
	g.n = num_pairs;
	g.steps += num_pairs;
	out.i = num_pairs;
	out.s.clear();
	format(out.s, "computed ", num_pairs, " pairwise relations");
	out
}
@end
@entry 441bd88735eba161
kind: step
verb: reverse
noun: tally
modifier: at_least
context: compare
phrase: reverse tally of elements reaching at least {min_val}
phrase: compare items reversing tally reaching {min_val}
slot: min_val int
test: list=2,10,4,15,6 min_val=8
expect: => i=2 r=0.0 ok=true s="reversed 2 elements meeting threshold" errors=0 n=2 res=[15,10] cache=0 hits=0
test: list=1,2,3,4 min_val=10
expect: => i=0 r=0.0 ok=true s="reversed 0 elements meeting threshold" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_val};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= limit {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	var left = 0;
	var right = kept - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.n = kept;
	g.steps += g.n + kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reversed ", kept, " elements meeting threshold");
	out
}
@end
