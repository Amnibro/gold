test: list=5,5,5
expect: => i=0 r=0.0 ok=true s="minimum gap is 0" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "fewer than two items");
		return out;
	}
	var min_gap = g.res[1] - g.res[0];
	for i in 1..(g.n - 1) {
		let gap = g.res[i + 1] - g.res[i];
		if gap < min_gap { min_gap = gap; }
	}
	g.steps += g.n;
	out.i = min_gap;
	out.s.clear();
	format(out.s, "minimum gap is ", min_gap);
	out
}
@end
