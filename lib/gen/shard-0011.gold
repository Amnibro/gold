code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	if n == 2 { return true; }
	if n % 2 == 0 { return false; }
	var d = 3;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 2;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept ", new_n, " running primes");
	out
}
@end
