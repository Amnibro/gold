fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_spaces byte[..200] = [];
	for i in out.s.len {
		if out.s[i] != ' ' {
			non_spaces.push(out.s[i]);
		}
	}
	out.s.clear();
	if non_spaces.len > 0 {
		for i in non_spaces.len { out.s.push(non_spaces[i]); }
		out.i = out.s.len;
	} else {
		gold_fail(g, "text empty after filter");
		out.s.append("empty");
		out.i = 0;
	}
	g.steps += out.s.len;
	out
}
@end
