fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	for k in g.n {
		if g.res[k] < mn { mn = g.res[k]; }
		if g.res[k] > mx { mx = g.res[k]; }
	}
	let span = mx - mn;
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "measured range span ", span);
	out
}
