fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${limit};
	var matched int[>..] = [];
	for i in g.n {
		if g.res[i] > thresh { matched.push(g.res[i]); }
	}
	if matched.len == 0 {
		gold_fail(g, "zero elements meet threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no matches");
		return out;
	}
	for i in matched.len {
		for j in (i + 1)..matched.len {
			if matched[j] < matched[i] {
				let tmp = matched[i];
				matched[i] = matched[j];
				matched[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in matched { gold_push(g, x); }
	g.steps += g.n + matched.len * matched.len;
	out.i = matched.len;
	out.s.clear();
	format(out.s, "ranked above threshold ", matched.len);
	out
}
@end
@entry eb48c5a5ccc6b41f
kind: step
verb: dedupe
noun: item
modifier: nested
context: error
phrase: dedupe target item from results {target}
phrase: remove duplicate instances of item {target}
slot: target int
test: list=1,2,2,3,2 target=2
expect: => i=2 r=0.0 ok=true s="deduped target occurrences 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,3,5 target=2
expect: => i=0 r=0.0 ok=false s="error: target missing" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var seen_target = false;
	var kept int[>..] = [];
	var removed = 0;
	for i in g.n {
		if g.res[i] == tgt {
			if !seen_target {
				seen_target = true;
				kept.push(g.res[i]);
			} else {
				removed++;
			}
		} else {
			kept.push(g.res[i]);
		}
	}
	if !seen_target {
		gold_fail(g, "target item not found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target missing");
		return out;
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped target occurrences ", removed);
	out
}
@end
