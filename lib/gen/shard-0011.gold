fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 { return out; }
	var sh = ${shift};
	if sh < 0 { sh = 0; }
	sh = sh % out.s.len;
	var temp byte[>..] = [];
	for i in out.s.len {
		temp.push(out.s[(i + sh) % out.s.len]);
	}
	out.s.clear();
	for b in temp { out.s.push(b); }
	g.steps += out.s.len;
	out.i = sh;
	out
}
