@entry 676e0ffacb5fd411
kind: step
verb: dedupe
noun: threshold
modifier: all
context: math
phrase: dedupe elements exceeding threshold {cutoff}
phrase: remove duplicate values above threshold {cutoff}
slot: cutoff int
test: list=5,20,5,20,30,20 cutoff=10
expect: => i=4 r=0.0 ok=true s="deduped elements above threshold to 4 items" errors=0 n=4 res=[5,20,5,30] cache=0 hits=0
test: list=2,8,8,12,12,8 cutoff=5
expect: => i=3 r=0.0 ok=true s="deduped elements above threshold to 3 items" errors=0 n=3 res=[2,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if x <= cut {
			temp[kept] = x;
			kept++;
		} else {
			var seen = false;
			for j in kept {
				if temp[j] == x { seen = true; break; }
			}
			if !seen {
				temp[kept] = x;
				kept++;
			}
		}
	}
	for i in kept {
		g.res[i] = temp[i];
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped elements above threshold to ", kept, " items");
	out
}
@end
@entry 35a3424767054422
