noun: squares
modifier: with_retry
context: retry
phrase: retry squares calculation with retry cap {retries}
phrase: recalculate squares using {retries} retry attempts
slot: retries int
test: list=1,2,3 retries=2
expect: => i=0 r=0.0 ok=true s="retried squares for 0 items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=-4,5 retries=1
