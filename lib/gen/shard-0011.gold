slot: delim int
test: text="hello-world" delim=45
expect: => i=5 r=0.0 ok=true s="hello" errors=0 n=0 res=[] cache=0 hits=0
test: text="apple" delim=45
expect: => i=5 r=0.0 ok=true s="apple" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delim} as byte;
	var count = 0;
	while count < out.s.len && out.s[count] != d {
		count++;
	}
	var prefix byte[>..] = [];
	for i in count {
		prefix.push(out.s[i]);
	}
	g.steps += count + 1;
	out.s.clear();
	out.s.append(prefix);
	out.i = count;
	out
}
@end
