	if g.n < 3 { return out; }
	var total = 0;
	for i in 1..(g.n - 1) {
		total += g.res[i];
	}
	let avg = total / (g.n - 2);
	for i in 1..(g.n - 1) {
		g.res[i] = g.res[i] - avg;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "middle aggregate total: ", total);
	out
}
