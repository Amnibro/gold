code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	for i in g.n {
		var cur_streak = 0;
		for j in i..g.n {
			var dup = false;
			for k in i..j {
				if g.res[k] == g.res[j] { dup = true; break; }
			}
			if dup { break; }
			cur_streak++;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
	}
	gold_cache_put(g, 0, max_streak);
	g.steps += g.n * g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "cached unique streak length ", max_streak);
	out
}
@end
