@entry 553142779c3fb003
kind: step
verb: filter
noun: primes
modifier: recursively
context: search
phrase: filter prime numbers from search results recursively
phrase: retain only prime search results in list
test: list=2,3,4,5,6,7,8,9
expect: => i=4 r=0.0 ok=true s="filtered 4 primes" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="filtered 2 primes" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p { kept.push(x); }
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n + kept.len;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "filtered ", kept.len, " primes");
	out
}
@end
