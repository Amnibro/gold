fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var limit = if k < g.n { k } else { g.n };
	if limit < 0 { limit = 0; }
	var sum = 0;
	var i = limit - 1;
	while i >= 0 {
		sum += g.res[i];
		i--;
	}
	g.steps += limit;
	out.i = sum;
	out.s.clear();
	format(out.s, "traced head in reverse sum ", sum);
	out
}
@end
