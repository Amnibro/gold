fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${digits};
	var matching = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		else {
			while x > 0 { d++; x /= 10; }
		}
		if d >= min_d {
			matching++;
		}
	}
	g.steps += g.n;
	out.i = matching;
	out.s.clear();
	format(out.s, "found ", matching, " items with required digits");
	out
}
@end
