code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var take = ${n_last};
	let cap = ${max_val};
	if take > g.n { take = g.n; }
	let start = g.n - take;
	var total = 0;
	for i in take {
		total += g.res[start + i];
	}
	if total > cap { total = cap; }
	g.steps += take;
	out.i = total;
	out.s.clear();
	format(out.s, "bounded last sum: ", total);
	out
}
@end
