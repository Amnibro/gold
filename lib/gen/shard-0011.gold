@entry 46decb0faa29899a
kind: step
verb: reverse
noun: gaps
modifier: all
context: aggregate
phrase: reverse all gaps between adjacent numbers in results
phrase: invert every step difference across entire sequence
test: list=1,4,10,13
expect: => i=3 r=0.0 ok=true s="reversed 3 all gaps" errors=0 n=4 res=[1,4,10,13] cache=0 hits=0
test: list=2,7,9,20
expect: => i=3 r=0.0 ok=true s="reversed 3 all gaps" errors=0 n=4 res=[2,13,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	var gaps int[>..] = [];
	var i = 0;
	while i + 1 < g.n {
		gaps.push(g.res[i + 1] - g.res[i]);
		i++;
	}
	var left = 0;
	var right = gaps.len - 1;
	while left < right {
		let tmp = gaps[left];
		gaps[left] = gaps[right];
		gaps[right] = tmp;
		left++;
		right--;
	}
	for k in gaps.len {
		g.res[k + 1] = g.res[k] + gaps[k];
	}
	g.steps += g.n * 2;
	out.i = gaps.len;
	out.s.clear();
	format(out.s, "reversed ", gaps.len, " all gaps");
	out
}
@end
