kind: step
verb: dedupe
noun: maximum
modifier: safely
context: loop
phrase: dedupe loop entries safely retaining maximum value
phrase: remove duplicate loop peaks safely preserving highest element
test: list=10,20,10,30,20
expect: => i=30 r=0.0 ok=true s="deduped safe peak 30" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,8,8,12,4
expect: => i=12 r=0.0 ok=true s="deduped safe peak 12" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var peak = -999999;
	for i in g.n {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[i];
			if g.res[w] > peak { peak = g.res[w]; }
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = peak;
	out.s.clear();
	format(out.s, "deduped safe peak ", peak);
	out
}
@end
