code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var swaps = 0;
	if g.cn >= 2 {
		for i in g.cn {
			for j in (i + 1)..g.cn {
				if g.cv[j] < g.cv[i] {
					let tmp_v = g.cv[i];
					g.cv[i] = g.cv[j];
					g.cv[j] = tmp_v;
					let tmp_k = g.ck[i];
					g.ck[i] = g.ck[j];
					g.ck[j] = tmp_k;
					swaps++;
				}
			}
		}
	}
	g.steps += g.cn * g.cn;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted cache entries with swaps ", swaps);
	out
}
@end
@entry 6560afbe26ed9854
kind: step
verb: find
noun: digits
modifier: all
context: sort
phrase: sort all digits present in text representation
phrase: order each digit character in text string
test: text="item 5432"
expect: => i=4 r=0.0 ok=true s="extracted and sorted digits count 4" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: text="val 9182"
expect: => i=4 r=0.0 ok=true s="extracted and sorted digits count 4" errors=0 n=4 res=[1,2,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits int[512] = [0; 512];
	var dn = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			digits[dn] = (c - '0') as int;
			dn++;
		}
	}
	for i in dn {
		for j in (i + 1)..dn {
			if digits[j] < digits[i] {
				let tmp = digits[i];
				digits[i] = digits[j];
				digits[j] = tmp;
			}
		}
	}
	for i in dn { gold_push(g, digits[i]); }
	g.steps += out.s.len + dn * dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "extracted and sorted digits count ", dn);
	out
}
@end
@entry 1582b40b92f6c45a
kind: step
verb: shift
noun: checkpoint
modifier: at_least
context: sort
phrase: shift sorted elements exceeding checkpoint of at least {threshold}
phrase: rotate ordered numbers having checkpoint at least {threshold}
slot: threshold int
test: list=10,20,30,40,50 threshold=30
expect: => i=2 r=0.0 ok=true s="shifted checkpoint from index 2" errors=0 n=5 res=[10,20,40,50,30] cache=0 hits=0
test: list=5,15,25,35 threshold=20
expect: => i=2 r=0.0 ok=true s="shifted checkpoint from index 2" errors=0 n=4 res=[5,15,35,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var idx = -1;
	for i in g.n {
		if g.res[i] >= limit {
			idx = i;
			break;
		}
	}
	if idx >= 0 && g.n > 0 {
		let first = g.res[idx];
		for i in idx..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "shifted checkpoint from index ", idx);
	out
}
@end
