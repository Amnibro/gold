expect: => i=2 r=0.0 ok=true s="selection sort total swaps 2" errors=0 n=5 res=[1,2,4,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_swaps = 0;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
			total_swaps++;
		}
	}
	g.steps += g.n * g.n;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "selection sort total swaps ", total_swaps);
	out
}
@end
