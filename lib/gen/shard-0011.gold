noun: checkpoint
modifier: nested
context: loop
phrase: validate nested loop checkpoints with interval {base_step}
phrase: verify hierarchical checkpoint progress using step {base_step}
slot: base_step int
test: list=10,12,20,22,30 base_step=2
expect: => i=1 r=0.0 ok=true s="checkpoint progression valid true" errors=0 n=5 res=[10,12,20,22,30] cache=0 hits=0
test: list=30,20,10,40 base_step=1
expect: => i=0 r=0.0 ok=false s="checkpoint progression valid false" errors=1 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_size = if ${base_step} > 0 { ${base_step} } else { 1 };
	var ok_prog = true;
	var last_val = -999999;
	var k = 0;
	while k < g.n {
		if g.res[k] < last_val {
			ok_prog = false;
			gold_fail(g, "nested checkpoint regression");
			break;
		}
		last_val = g.res[k];
		k += step_size;
	}
	g.steps += g.n;
	out.ok = ok_prog;
	out.i = if ok_prog { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checkpoint progression valid ", ok_prog);
	out
}
@end
