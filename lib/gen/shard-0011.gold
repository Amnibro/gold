expect: => i=6 r=0.0 ok=true s="rotated results by average magnitude 6" errors=0 n=5 res=[4,6,8,10,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = sum / g.n;
	if avg < 0 { avg = -avg; }
	let shift = avg % g.n;
	var temp int[512] = [0; 512];
	for i in g.n {
		temp[i] = g.res[(i + shift) % g.n];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "rotated results by average magnitude ", avg);
	out
}
@end
