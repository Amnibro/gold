test: list=10,20,30 min_sum=40
expect: => i=50 r=0.0 ok=true s="paired tail sum is 50" errors=0 n=2 res=[10,50] cache=0 hits=0
test: list=1,2,3 min_sum=10
expect: => i=5 r=0.0 ok=false s="paired tail sum is 5" errors=1 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	if g.n < 2 {
		gold_fail(g, "not enough items for tail pair");
		out.ok = false;
		return out;
	}
	let sum = g.res[g.n - 1] + g.res[g.n - 2];
	if sum < ms {
		gold_fail(g, "tail sum below required threshold");
		out.ok = false;
	}
	g.res[g.n - 2] = sum;
	g.n--;
	g.steps += 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "paired tail sum is ", sum);
	out
}
@end
