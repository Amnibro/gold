code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty series for unique tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	var distinct = 0;
	for i in g.n {
		var is_first = true;
		for j in i {
			if g.res[j] == g.res[i] { is_first = false; break; }
		}
		if is_first { distinct++; }
	}
	gold_push(g, distinct);
	g.steps += g.n * g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "unique series count ", distinct);
	out
}
@end
