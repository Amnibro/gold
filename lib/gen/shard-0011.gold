code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var min_idx = i;
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
			j++;
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted in place count ", g.n);
	out
}
@end
@entry d191949b2d847b76
kind: step
verb: clamp
noun: sequence
modifier: sorted
context: retry
phrase: clamp retry sequence in sorted order below ceiling {ceiling}
phrase: enforce sorted order while clamping retry sequence to {ceiling}
slot: ceiling int
test: list=5,12,8,25 ceiling=15
expect: => i=2 r=0.0 ok=true s="clamped sequence sorted count 2" errors=0 n=4 res=[5,12,12,15] cache=0 hits=0
test: list=20,10,30,5 ceiling=18
expect: => i=4 r=0.0 ok=true s="clamped sequence sorted count 4" errors=0 n=4 res=[18,18,18,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	var prev = 0;
	var clamped = 0;
	for k in g.n {
		var x = g.res[k];
		if x > ceil_val { x = ceil_val; clamped++; }
		if x < prev { x = prev; clamped++; }
		g.res[k] = x;
		prev = x;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped sequence sorted count ", clamped);
	out
}
@end
@entry 14cca029d9ffab60
kind: step
verb: sort
noun: prefix
modifier: unique
context: retry
phrase: sort unique retry prefix of size {size}
phrase: uniquely order retry prefix within {size} elements
slot: size int
test: list=4,2,2,8,1 size=4
expect: => i=3 r=0.0 ok=true s="unique sorted prefix count 3" errors=0 n=3 res=[2,4,8] cache=0 hits=0
test: list=9,3,9,3,5 size=5
expect: => i=3 r=0.0 ok=true s="unique sorted prefix count 3" errors=0 n=3 res=[3,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${size} < g.n { ${size} } else { g.n };
	var u_count = 0;
	var i = 0;
	while i < limit {
		var seen = false;
		var j = 0;
		while j < u_count {
			if g.res[j] == g.res[i] { seen = true; break; }
			j++;
		}
		if !seen {
			g.res[u_count] = g.res[i];
			u_count++;
		}
		i++;
	}
	var a = 0;
	while a < u_count {
		var b = 0;
		while b + 1 < u_count - a {
			if g.res[b] > g.res[b + 1] {
				let t = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = t;
			}
			b++;
		}
		a++;
	}
	g.n = u_count;
	g.steps += limit;
	out.i = u_count;
	out.s.clear();
	format(out.s, "unique sorted prefix count ", u_count);
	out
}
@end
@entry 079db06c8ebe80c8
kind: step
verb: join
noun: total
modifier: with_cache
context: retry
phrase: join retry total with cached metric {key}
phrase: accumulate total retry sum with cache key {key}
slot: key int
test: list=10,20,30 key=100
expect: => i=60 r=0.0 ok=true s="joined total with cache 60" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25 key=200
expect: => i=45 r=0.0 ok=true s="joined total with cache 45" errors=0 n=3 res=[5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cache_key = ${key};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let cv, found = gold_cache_get(g, cache_key);
	let combined = if found { sum + cv } else { sum };
	gold_cache_put(g, cache_key, combined);
	g.steps += g.n;
	out.i = combined;
	out.s.clear();
	format(out.s, "joined total with cache ", combined);
	out
}
@end
