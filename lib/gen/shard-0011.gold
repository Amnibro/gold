code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let forbidden = ${spacing};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let ad = if diff < 0 { -diff } else { diff };
		if ad == forbidden {
			valid = false;
			gold_fail(g, "forbidden spacing matched");
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "spacing validation status ", valid);
	out
}
@end
