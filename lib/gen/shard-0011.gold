expect: => i=4 r=0.0 ok=true s="sorted histogram until bound 4" errors=0 n=4 res=[2,5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted histogram until bound ", bound);
	out
}
@end
