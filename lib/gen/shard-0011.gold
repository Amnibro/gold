noun: suffix
modifier: at_most
context: filter
phrase: shift suffix elements filtering at most {max_items}
phrase: filter suffix items shifting at most {max_items}
slot: max_items int
test: list=10,20,30,40 max_items=2
expect: => i=2 r=0.0 ok=true s="shifted suffix count: 2" errors=0 n=2 res=[29,39] cache=0 hits=0
test: list=1,2,3,4,5 max_items=3
expect: => i=3 r=0.0 ok=true s="shifted suffix count: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_items};
	var take = limit;
	if take > g.n { take = g.n; }
	let start = g.n - take;
	var temp int[512] = [0; 512];
	for i in take {
		temp[i] = g.res[start + i] - 1;
	}
	for i in take { g.res[i] = temp[i]; }
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "shifted suffix count: ", take);
	out
}
@end
