@entry 2067afe1fba81289
kind: step
verb: rotate
noun: window
modifier: while
context: sort
phrase: rotate window of elements while adjacent inversions exist
phrase: cycle subsegment while sorting condition holds
test: list=5,1,4,2,3
expect: => i=3 r=0.0 ok=true s="window rotations 3" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,2,8
expect: => i=1 r=0.0 ok=true s="window rotations 1" errors=0 n=3 res=[2,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rotations = 0;
	while rotations < 3 {
		var has_inv = false;
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] { has_inv = true; break; }
		}
		if !has_inv { break; }
		if g.n > 1 {
			let first = g.res[0];
			for i in 1..g.n { g.res[i - 1] = g.res[i]; }
			g.res[g.n - 1] = first;
		}
		rotations++;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += rotations * g.n + g.n * g.n;
	out.i = rotations;
	out.s.clear();
	format(out.s, "window rotations ", rotations);
	out
}
@end
@entry ff3b6c15c0826262
kind: step
verb: sort
noun: checkpoint
modifier: until
context: sort
phrase: sort checkpoint prefix until sentinel limit {stop}
phrase: order items until checkpoint sentinel {stop}
slot: stop int
test: list=4,2,8,99,5,1 stop=99
expect: => i=3 r=0.0 ok=true s="sorted until sentinel prefix 3" errors=0 n=6 res=[2,4,8,99,5,1] cache=0 hits=0
test: list=10,5,50,2 stop=50
expect: => i=2 r=0.0 ok=true s="sorted until sentinel prefix 2" errors=0 n=4 res=[5,10,50,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sentinel = ${stop};
	var cut = g.n;
	for i in g.n {
		if g.res[i] == sentinel { cut = i; break; }
	}
	for i in cut {
		for j in (i + 1)..cut {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += cut * cut;
	out.i = cut;
	out.s.clear();
	format(out.s, "sorted until sentinel prefix ", cut);
	out
}
@end
