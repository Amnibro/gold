modifier: each
context: sort
phrase: sort vowel characters in text sequence
phrase: order vowels alphabetically within text
test: text="education"
expect: => i=5 r=0.0 ok=true s="adecitoun" errors=0 n=0 res=[] cache=0 hits=0
test: text="sorting"
expect: => i=2 r=0.0 ok=true s="sirtong" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_v(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[>..] = [];
	var pos int[>..] = [];
	for i in out.s.len {
		let c = out.s[i];
		if ${ID}_is_v(c) {
			vowels.push(c);
			pos.push(i);
		}
	}
	for i in vowels.len {
		for j in (i + 1)..vowels.len {
			if vowels[j] < vowels[i] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
		}
	}
	for k in vowels.len {
		out.s[pos[k]] = vowels[k];
	}
	g.steps += out.s.len + vowels.len * vowels.len;
	out.i = vowels.len;
	out
}
@end
