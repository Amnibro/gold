slot: p pred
test: list=2,4,1,3 p=is_even
expect: => i=2 r=0.0 ok=true s="rotated run count=2" errors=0 n=4 res=[1,3,2,4] cache=0 hits=0
test: list=1,3,5,2 p=is_odd
expect: => i=3 r=0.0 ok=true s="rotated run count=3" errors=0 n=4 res=[2,1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_len = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			run_len++;
		} else {
			break;
		}
	}
	if g.n > 1 && run_len > 0 {
		var shift = run_len % g.n;
		for s in shift {
			let first = g.res[0];
			for i in 1..g.n {
				g.res[i - 1] = g.res[i];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = run_len;
	out.s.clear();
	format(out.s, "rotated run count=", run_len);
	out
}
@end
