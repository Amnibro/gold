@entry 17804db4dece5801
kind: step
verb: sum
noun: suffix
modifier: running
context: filter
phrase: sum suffix elements keeping running totals above {threshold}
phrase: filter suffix elements having running sum over {threshold}
slot: threshold int
test: list=10,20,30,40 threshold=50
expect: => i=3 r=0.0 ok=true s="suffix sum filtered count: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25,35 threshold=40
expect: => i=3 r=0.0 ok=true s="suffix sum filtered count: 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var kept = 0;
	var temp int[512] = [0; 512];
	var run_sum = 0;
	var i = g.n - 1;
	while i >= 0 {
		run_sum += g.res[i];
		if run_sum >= limit {
			temp[kept] = g.res[i];
			kept++;
		}
		if i == 0 { break; }
		i--;
	}
	for j in (kept / 2) {
		let k = kept - 1 - j;
		let tmp = temp[j];
		temp[j] = temp[k];
		temp[k] = tmp;
	}
	for j in kept { g.res[j] = temp[j]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "suffix sum filtered count: ", kept);
	out
}
@end
