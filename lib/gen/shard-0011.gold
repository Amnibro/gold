code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "safe spread span: ", span);
	out
}
@end
