expect: => i=1 r=0.0 ok=true s="ranked prefix of 1" errors=0 n=3 res=[50,30,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_score};
	var k = 0;
	while k < g.n && g.res[k] >= min_s {
		k++;
	}
	for i in k {
		for j in (i + 1)..k {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += k * k;
	out.i = k;
	out.s.clear();
	format(out.s, "ranked prefix of ", k);
	out
}
@end
