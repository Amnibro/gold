code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var highest = 0;
	for k in g.n {
		let transformed = ${step_fn}(g.res[k]);
		if transformed > highest {
			highest = transformed;
		}
		g.res[k] = highest;
	}
	g.steps += g.n;
	out.i = highest;
	out.s.clear();
	format(out.s, "clamped function sorted peak ", highest);
	out
}
@end
@entry 82c843faa30d78d7
kind: step
verb: clamp
noun: history
modifier: running
context: retry
phrase: clamp running retry history within spread {spread}
phrase: bound running history variance across retries by {spread}
slot: spread int
test: list=10,25,5,40 spread=8
expect: => i=3 r=0.0 ok=true s="clamped running history count 3" errors=0 n=4 res=[10,18,6,19] cache=0 hits=0
test: list=15,10,35,2 spread=6
expect: => i=2 r=0.0 ok=true s="clamped running history count 2" errors=0 n=4 res=[15,10,18,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_dev = ${spread};
	var running_sum = 0;
	var clamped_count = 0;
	for k in g.n {
		if k > 0 {
			let avg = running_sum / k;
			if g.res[k] > avg + max_dev {
				g.res[k] = avg + max_dev;
				clamped_count++;
			} else if g.res[k] < avg - max_dev {
				g.res[k] = avg - max_dev;
				clamped_count++;
			}
		}
		running_sum += g.res[k];
	}
	g.steps += g.n;
	out.i = clamped_count;
	out.s.clear();
	format(out.s, "clamped running history count ", clamped_count);
	out
}
@end
