@entry 12a9378df75ca40a
kind: step
verb: sort
noun: evens
modifier: sorted
context: filter
phrase: sort even numbers in place preserving odd positions
phrase: order even values into sorted sequence
test: list=9,8,3,4,1,2
expect: => i=3 r=0.0 ok=true s="sorted even count 3" errors=0 n=6 res=[9,2,3,4,1,8] cache=0 hits=0
test: list=10,3,6,1,2
expect: => i=3 r=0.0 ok=true s="sorted even count 3" errors=0 n=5 res=[2,3,6,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		}
	}
	var i = 0;
	while i < en {
		var j = i + 1;
		while j < en {
			if evens[i] > evens[j] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var p = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[k] = evens[p];
			p++;
		}
	}
	g.steps += en;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted even count ", en);
	out
}
@end
@entry a9e5a0c63e2ce85c
kind: step
verb: rotate
noun: item
modifier: recursively
context: filter
phrase: recursively rotate items by offset {steps}
phrase: shift items cycle recursively across results {steps}
slot: steps int
test: list=1,2,3,4,5 steps=2
expect: => i=2 r=0.0 ok=true s="rotated item recursively by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 steps=1
expect: => i=1 r=0.0 ok=true s="rotated item recursively by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty results for item rotation");
		return out;
	}
	var rot = s % g.n;
	if rot < 0 { rot += g.n; }
	for r in rot {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += rot;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated item recursively by ", rot);
	out
}
@end
