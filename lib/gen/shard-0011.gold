kind: step
verb: map
noun: budget
modifier: until
context: retry
phrase: map budget consumption until ceiling {limit}
phrase: scale budget usage until reaching {limit}
slot: limit int
test: list=10,20,50 limit=35
expect: => i=20 r=0.0 ok=true s="mapped 1 items with total budget 20" errors=0 n=3 res=[20,20,50] cache=0 hits=0
