fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let ce = ${ceiling};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			if g.res[i] < fl { g.res[i] = fl; clamped++; }
			else if g.res[i] > ce { g.res[i] = ce; clamped++; }
		}
	}
	g.steps += g.n * g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " evens");
	out
}
@end
