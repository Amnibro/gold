@entry 31127de85b54de06
kind: step
verb: drop
noun: item
modifier: at_most
context: aggregate
phrase: drop at most {drop_count} peak items computing aggregate sum
phrase: aggregate total dropping at most {drop_count} maximum elements
slot: drop_count int
test: list=10,50,20,40,30 drop_count=1
expect: => i=100 r=0.0 ok=true s="sum after dropping peaks: 100" errors=0 n=5 res=[10,50,20,40,30] cache=0 hits=0
test: list=5,15,25,35 drop_count=2
expect: => i=20 r=0.0 ok=true s="sum after dropping peaks: 20" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let drops = ${drop_count};
	var dropped = 0;
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[i]; }
	var len = g.n;
	while dropped < drops && len > 0 {
		var max_idx = 0;
		for i in 1..len {
			if temp[i] > temp[max_idx] { max_idx = i; }
		}
		temp[max_idx] = temp[len - 1];
		len--;
		dropped++;
	}
	var total = 0;
	for i in len { total += temp[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum after dropping peaks: ", total);
	out
}
@end
