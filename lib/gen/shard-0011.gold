expect: => i=3 r=0.0 ok=true s="merged unique checkpoints to 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,5,6
expect: => i=2 r=0.0 ok=true s="merged unique checkpoints to 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == val { seen = true; break; }
		}
		if !seen {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged unique checkpoints to ", write_idx);
	out
}
@end
