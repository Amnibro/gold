code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			total += x;
			unique_count++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "joined ", unique_count, " unique numbers to sum ", total);
	out
}
@end
