code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_val};
	var dropped = 0;
	while g.n > 0 && g.res[g.n - 1] == tgt {
		g.n--;
		dropped++;
	}
	g.steps += dropped + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " trailing items");
	out
}
