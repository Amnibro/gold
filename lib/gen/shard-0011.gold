code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for reverse error split");
		out.ok = false;
		return out;
	}
	let orig_n = g.n;
	var i = orig_n;
	while i > 0 {
		i--;
		gold_push(g, g.res[i] / 2);
	}
	g.steps += orig_n;
	out.i = g.n - orig_n;
	out.s.clear();
	format(out.s, "split errors in reverse count ", out.i);
	out
}
@end
