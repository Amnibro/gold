fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let h = if ${head_size} < g.n { ${head_size} } else { g.n };
	var w = 0;
	var running_tally = 0;
	for i in h {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[i];
			running_tally += g.res[w];
			w++;
		}
	}
	for i in h..g.n {
		g.res[w] = g.res[i];
		w++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = running_tally;
	out.s.clear();
	format(out.s, "head deduped running tally ", running_tally);
	out
}
