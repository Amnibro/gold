fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient results for pair sum");
		out.ok = false;
		return out;
	}
	var total = 0;
	var i = 0;
	while i + 1 < g.n && g.res[i] > 0 && g.res[i + 1] > 0 {
		total += g.res[i] + g.res[i + 1];
		i += 2;
	}
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "summed positive pairs total ", total);
	out
}
@end
