verb: run
noun: numbers
modifier: at_least
context: sort
phrase: sort numbers having magnitude at least {min_val}
phrase: order sequence elements with value at least {min_val}
slot: min_val int
test: list=3,15,4,25,12 min_val=10
expect: => i=3 r=0.0 ok=true s="sorted items with value at least threshold 3" errors=0 n=5 res=[3,12,4,15,25] cache=0 hits=0
test: list=8,30,5,20 min_val=15
expect: => i=2 r=0.0 ok=true s="sorted items with value at least threshold 2" errors=0 n=4 res=[8,20,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_val};
	var count = 0;
	for i in g.n {
		if g.res[i] >= threshold {
			for j in (i + 1)..g.n {
				if g.res[j] >= threshold && g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
			count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted items with value at least threshold ", count);
	out
}
@end
