fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var f = ${finish};
	if s < 0 { s = 0; }
	if f > out.s.len { f = out.s.len; }
	if s >= f { return out; }
	let count = f - s;
	for i in count {
		gold_push(g, out.s[s + i] as int);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced ", count, " character items");
	out
}
@end
