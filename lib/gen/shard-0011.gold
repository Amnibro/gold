expect: => i=2 r=0.0 ok=true s="window deduped to 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var kept int[>..] = [];
	for i in g.n {
		if kept.len >= ml { break; }
		if kept.len == 0 || g.res[i] != kept[kept.len - 1] {
			kept.push(g.res[i]);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "window deduped to ", kept.len);
	out
}
@end
