code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	var left = 0;
	var right = half - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += half;
	out.i = half;
	out.s.clear();
	format(out.s, "reversed head ", half, " elements");
	out
}
@end
