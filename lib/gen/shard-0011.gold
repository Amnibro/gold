@entry 14e4f91ec6ab2596
kind: step
verb: rank
noun: steps
modifier: at_most
context: sort
phrase: rank elements using at most step limit {max_steps}
phrase: order items with bubble sort bounded by step count {max_steps}
slot: max_steps int
test: list=5,3,1,4,2 max_steps=2
expect: => i=2 r=0.0 ok=true s="performed 2 sorting steps" errors=0 n=5 res=[1,5,3,4,2] cache=0 hits=0
test: list=9,7,5 max_steps=1
expect: => i=1 r=0.0 ok=true s="performed 1 sorting steps" errors=0 n=3 res=[7,9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_steps};
	var swaps = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if swaps >= limit { break; }
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
		}
		if swaps >= limit { break; }
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " sorting steps");
	out
}
@end
