fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let bnd = ${bound};
	var found = -1;
	var limit = bnd;
	if limit > g.n { limit = g.n; }
	for i in limit {
		if g.res[i] == tgt {
			found = i;
			break;
		}
	}
	out.i = found;
	g.steps += if found >= 0 { found + 1 } else { limit };
	out.s.clear();
	format(out.s, "traced number position ", found);
	out
}
