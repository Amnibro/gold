		if g.res[i] == tgt {
			found_idx = i;
			i = g.n;
		} else {
			i += 2;
		}
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	g.steps += g.n / 2 + 1;
	out.s.clear();
	format(out.s, "searched window found index ", found_idx);
	out
}
@end
