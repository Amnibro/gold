expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for sorted word counts");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted word counts count ", g.n);
	out
}
@end
