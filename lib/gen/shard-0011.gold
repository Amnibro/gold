kind: step
verb: filter
noun: window
modifier: at_most
context: sort
phrase: filter sorted array keeping window with at most spread {max_spread}
phrase: trim sorted values within maximum spread {max_spread}
slot: max_spread int
test: list=1,3,7,8,12 max_spread=5
expect: => i=3 r=0.0 ok=true s="window length 3" errors=0 n=3 res=[3,7,8] cache=0 hits=0
test: list=10,20,25,40 max_spread=6
expect: => i=2 r=0.0 ok=true s="window length 2" errors=0 n=2 res=[20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_spread};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var best_start = 0;
	var best_len = 0;
	for i in g.n {
		var j = i;
		while j < g.n && g.res[j] - g.res[i] <= ms {
			j++;
		}
		let len = j - i;
		if len > best_len {
			best_len = len;
			best_start = i;
		}
	}
	var kept int[>..] = [];
	for k in best_len { kept.push(g.res[best_start + k]); }
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "window length ", best_len);
	out
}
@end
