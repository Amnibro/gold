@entry 807d1c9b8e667d51
kind: step
verb: collect
noun: budget
modifier: while
context: list
phrase: collect elements while total cost stays within budget {budget}
phrase: take prefix items under cumulative budget {budget}
slot: budget int
test: list=5,10,15,20 budget=25
expect: => i=2 r=0.0 ok=true s="collected 2 items under budget" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=10,20 budget=5
expect: => i=0 r=0.0 ok=true s="collected 0 items under budget" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let cost = g.res[i];
		if spent + cost <= b {
			g.res[kept] = cost;
			spent += cost;
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " items under budget");
	out
}
@end
