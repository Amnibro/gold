test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="repeated 2 odd elements" errors=0 n=6 res=[1,2,3,4,1,3] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=false s="error: no odds found" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty elements for odd duplication");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty elements");
		return out;
	}
	var count = 0;
	let orig_n = g.n;
	for i in orig_n {
		if g.res[i] % 2 != 0 {
			gold_push(g, g.res[i]);
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no odd elements found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no odds found");
		return out;
	}
	g.steps += orig_n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated ", count, " odd elements");
	out
}
@end
