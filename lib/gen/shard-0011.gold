phrase: format swap of elements exceeding threshold {thresh}
phrase: render threshold swaps for each value above {thresh}
slot: thresh int
test: list=10,5,20,3 thresh=8
expect: => i=2 r=0.0 ok=true s="threshold swaps: 2" errors=0 n=4 res=[5,10,3,20] cache=0 hits=0
test: list=1,2,3 thresh=10
expect: => i=0 r=0.0 ok=true s="threshold swaps: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > limit && g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "threshold swaps: ", swaps);
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
