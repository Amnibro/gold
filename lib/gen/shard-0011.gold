	let cap = ${limit};
	var max_r = 1;
	var cur_r = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev {
			cur_r++;
			if cur_r > max_r { max_r = cur_r; }
		} else {
			cur_r = 1;
		}
		prev = cur;
		x /= 10;
	}
	if max_r > cap { cap } else { max_r }
}
@end
