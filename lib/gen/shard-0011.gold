expect: => i=6 r=0.0 ok=true s="joined prefix sum 6" errors=0 n=4 res=[1,5,9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cap};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	var bound = k;
	if bound > g.n { bound = g.n; }
	for i in bound { sum += g.res[i]; }
	gold_push(g, sum);
	g.steps += g.n * g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined prefix sum ", sum);
	out
}
@end
