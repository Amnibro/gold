test: list=1,4,2,3
expect: => i=1 r=0.0 ok=true s="maximum in reverse index 1" errors=0 n=4 res=[1,4,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for maximum reverse");
		out.ok = false;
		return out;
	}
	var max_val = g.res[g.n - 1];
	var max_idx = g.n - 1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
		i--;
	}
	g.steps += g.n;
	out.i = max_idx;
	out.s.clear();
	format(out.s, "maximum in reverse index ", max_idx);
	out
}
@end
