	let lim = ${limit};
	var count = 0;
	for i in g.n {
		if count >= lim { break; }
		gold_cache_put(g, i, g.res[i]);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected and cached ", count, " items");
	out
}
