@entry e6e5d605fbba3eda
kind: step
verb: sum
noun: minimum
modifier: at_most
context: stats
phrase: sum smallest sample values at most {cap} items
phrase: accumulate minimum observation entries up to count {cap}
slot: cap int
test: list=10,4,8,2,6 cap=3
expect: => i=12 r=0.0 ok=true s="summed 3 smallest observations total 12" errors=0 n=5 res=[10,4,8,2,6] cache=0 hits=0
test: list=15,3,9,12 cap=2
expect: => i=12 r=0.0 ok=true s="summed 2 smallest observations total 12" errors=0 n=4 res=[15,3,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cap};
	var sorted int[512] = [0; 512];
	for i in g.n { sorted[i] = g.res[i]; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if sorted[j] < sorted[i] {
				let tmp = sorted[i];
				sorted[i] = sorted[j];
				sorted[j] = tmp;
			}
		}
	}
	var total = 0;
	let limit = if k < g.n { k } else { g.n };
	for i in limit {
		total += sorted[i];
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed ", limit, " smallest observations total ", total);
	out
}
@end
