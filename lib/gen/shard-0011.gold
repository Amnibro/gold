noun: minimum
modifier: in_place
context: format
phrase: run minimum offset in place formatting base differences
phrase: format list subtracting minimum element in place
test: list=10,25,15,30
expect: => i=10 r=0.0 ok=true s="base_offsets: +0, +15, +5, +20" errors=0 n=4 res=[0,15,5,20] cache=0 hits=0
test: list=5,12,8,20
expect: => i=5 r=0.0 ok=true s="base_offsets: +0, +7, +3, +15" errors=0 n=4 res=[0,7,3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	out.s.clear();
	out.s.append("base_offsets: ");
	for i in g.n {
		g.res[i] = g.res[i] - min_val;
		if i > 0 { out.s.append(", "); }
		format(out.s, "+", g.res[i]);
	}
	g.steps += g.n;
	out.i = min_val;
	out
}
@end
