fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var r = 0;
	while r < d && g.n > 1 {
		var new_n = 0;
		var i = 0;
		while i + 1 < g.n {
			g.res[new_n] = g.res[i] + g.res[i + 1];
			new_n++;
			i += 2;
		}
		if i < g.n {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		g.n = new_n;
		r++;
	}
	g.steps += d * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired history recursively length ", g.n);
	out
}
