@entry e0832a6972891cfe
kind: step
verb: retry
noun: histogram
modifier: sorted
context: loop
phrase: retry building histogram of sorted frequencies
phrase: tally frequency counts in sorted order
test: list=3,1,3,2,1,1
expect: => i=3 r=0.0 ok=true s="sorted histogram has 3 distinct buckets" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,10,20
expect: => i=2 r=0.0 ok=true s="sorted histogram has 2 distinct buckets" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var u_vals int[512] = [0; 512];
	var u_counts int[512] = [0; 512];
	var u_n = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in u_n {
			if u_vals[j] == x { found = j; break; }
		}
		if found >= 0 {
			u_counts[found]++;
		} else {
			u_vals[u_n] = x;
			u_counts[u_n] = 1;
			u_n++;
		}
	}
	for i in u_n {
		for j in (i + 1)..u_n {
			if u_counts[j] < u_counts[i] {
				let tmp_c = u_counts[i];
				u_counts[i] = u_counts[j];
				u_counts[j] = tmp_c;
			}
		}
	}
	for i in u_n {
		g.res[i] = u_counts[i];
	}
	g.n = u_n;
	g.steps += g.n + u_n;
	out.i = u_n;
	out.s.clear();
	format(out.s, "sorted histogram has ", u_n, " distinct buckets");
	out
}
@end
