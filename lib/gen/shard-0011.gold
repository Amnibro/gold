noun: gaps
modifier: in_place
context: math
phrase: compare adjacent gaps directly in place
phrase: replace items with adjacent gap differences
test: list=1,4,10,12
expect: => i=3 r=0.0 ok=true s="computed 3 adjacent gaps" errors=0 n=3 res=[3,6,2] cache=0 hits=0
test: list=20,5
expect: => i=1 r=0.0 ok=true s="computed 1 adjacent gaps" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	for i in (g.n - 1) {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[i] = if b > a { b - a } else { a - b };
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed ", g.n, " adjacent gaps");
	out
}
@end
