code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cycles = ${reps};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	var r = 0;
	while r < cycles {
		for k in g.n {
			g.res[k] += sum;
		}
		r++;
	}
	g.steps += cycles * g.n;
	out.i = cycles;
	out.s.clear();
	format(out.s, "repeated total additions cycles ", cycles);
	out
}
@end
