	var out = v;
	var total_vowels = 0;
	for i in v.s.len {
		if ${ID}_is_v(v.s[i]) {
			total_vowels++;
		}
	}
	let ratio = if v.s.len > 0 { (total_vowels as real) / (v.s.len as real) } else { 0.0 };
	g.steps += v.s.len;
	out.i = total_vowels;
	out.r = ratio;
	out.s.clear();
	format(out.s, "measured ", total_vowels, " total vowels");
	out
}
@end
