code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_diff};
	var found = false;
	var gap_val = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap >= req {
			found = true;
			gap_val = gap;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = found;
	out.i = gap_val;
	out.s.clear();
	format(out.s, "gap found: ", found);
	out
}
@end
