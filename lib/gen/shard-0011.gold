code:
fn ${ID}_is_square(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r < n { r++; }
	r * r == n
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	for i in g.n {
		if ${ID}_is_square(g.res[i]) {
			sum += g.res[i];
			count++;
		}
	}
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded squares sum ", sum);
	out
}
@end
