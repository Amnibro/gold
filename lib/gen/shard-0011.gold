code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${limit};
	var swapped = false;
	if g.n >= 2 && g.res[0] <= bound && g.res[1] <= bound {
		let tmp = g.res[0];
		g.res[0] = g.res[1];
		g.res[1] = tmp;
		swapped = true;
	}
	out.ok = swapped;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "swap limit first: ", out.i);
	g.steps += 1;
	out
}
@end
