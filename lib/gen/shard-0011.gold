fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run_len = 1;
	while run_len < g.n && g.res[run_len] >= g.res[run_len - 1] {
		run_len++;
	}
	var sum = 0;
	for i in run_len { sum += g.res[i]; }
	gold_push(g, sum);
	g.steps += run_len;
	out.i = run_len;
	out.s.clear();
	format(out.s, "joined run sum ", sum);
	out
}
@end
