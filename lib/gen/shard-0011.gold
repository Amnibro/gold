slot: limit int
test: list=1,3,5,7,8 p=is_even limit=3
expect: => i=1 r=0.0 ok=true s="filtered 1 items after 1 retry attempts" errors=0 n=5 res=[1,3,5,7,8] cache=0 hits=0
test: list=2,4,6,8,10 p=is_odd limit=2
expect: => i=5 r=0.0 ok=true s="filtered 5 items after 2 retry attempts" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_retries = if ${limit} > 0 { ${limit} } else { 1 };
	var attempts = 0;
	var count = 0;
	while attempts < max_retries {
		count = 0;
		for i in g.n {
			if ${p}(g.res[i] + attempts) {
				count++;
			}
		}
		attempts++;
		if count > 0 { break; }
	}
	g.steps += attempts * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered ", count, " items after ", attempts, " retry attempts");
	out
}
@end
