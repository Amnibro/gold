@entry 30b3aad7a4680847
kind: step
verb: map
noun: histogram
modifier: with_retry
context: sort
phrase: map histogram counts with retry bucket {bucket}
phrase: build histogram frequency with bucket {bucket}
slot: bucket int
test: list=2,3,7,8,12 bucket=5
expect: => i=3 r=0.0 ok=true s="mapped 3 histogram buckets" errors=0 n=3 res=[2,2,1] cache=0 hits=0
test: list=1,2,3 bucket=2
expect: => i=2 r=0.0 ok=true s="mapped 2 histogram buckets" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${bucket};
	if bsize <= 0 {
		out.ok = false;
		gold_fail(g, "invalid bucket size");
		return out;
	}
	var max_val = 0;
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let num_buckets = (max_val / bsize) + 1;
	let lim = if num_buckets > 10 { 10 } else { num_buckets };
	var counts = [0; 16];
	for i in g.n {
		let b_idx = g.res[i] / bsize;
		if b_idx < 16 {
			counts[b_idx]++;
		}
	}
	gold_clear(g);
	for b in lim {
		gold_push(g, counts[b]);
	}
	g.steps += g.n;
	out.i = lim;
	out.s.clear();
	format(out.s, "mapped ", lim, " histogram buckets");
	out
}
@end
