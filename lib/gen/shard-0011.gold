fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits_cnt = 0;
	var k = 0;
	while k < g.n {
		let val = g.res[k];
		let cv, found = gold_cache_get(g, val);
		if found {
			g.res[k] = val + cv;
			hits_cnt++;
		} else {
			gold_cache_put(g, val, k + 1);
		}
		k += 2;
	}
	g.steps += g.n;
	out.i = hits_cnt;
	out.s.clear();
	format(out.s, "traced alternating cache hits ", hits_cnt);
	out
}
@end
@entry 0c991b515166977e
kind: step
verb: filter
noun: list
modifier: pairwise
context: retry
phrase: filter retry list pairwise retaining items with difference at least {diff}
phrase: filter adjacent retry pairs by minimum divergence {diff}
slot: diff int
test: list=10,12,20,21,30 diff=5
expect: => i=3 r=0.0 ok=true s="filtered pairwise retry list to 3" errors=0 n=3 res=[12,21,30] cache=0 hits=0
test: list=1,2,3,10,11 diff=4
expect: => i=1 r=0.0 ok=true s="filtered pairwise retry list to 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${diff};
	var kept = 0;
	var k = 0;
	while k < g.n {
		var ok_pair = false;
		if k + 1 < g.n {
			let d = g.res[k] - g.res[k + 1];
			let ad = if d < 0 { -d } else { d };
			if ad >= min_d { ok_pair = true; }
		} else if k > 0 {
			let d = g.res[k] - g.res[k - 1];
			let ad = if d < 0 { -d } else { d };
			if ad >= min_d { ok_pair = true; }
		}
		if ok_pair {
			g.res[kept] = g.res[k];
			kept++;
		}
		k++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered pairwise retry list to ", kept);
	out
}
@end
