@entry 20421e40c6ef1a94
kind: step
verb: map
noun: duplicates
modifier: sorted
context: search
phrase: map duplicate elements into sorted order
phrase: collect all duplicate search values sorted ascending
test: list=3,1,2,3,1
expect: => i=2 r=0.0 ok=true s="sorted duplicates count 2" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=5,4,5,4
expect: => i=2 r=0.0 ok=true s="sorted duplicates count 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes int[>..] = [];
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] {
				dupes.push(g.res[i]);
				break;
			}
		}
	}
	// sort dupes
	var a = 0;
	while a < dupes.len {
		var b = a + 1;
		while b < dupes.len {
			if dupes[b] < dupes[a] {
				let t = dupes[a];
				dupes[a] = dupes[b];
				dupes[b] = t;
			}
			b++;
		}
		a++;
	}
	gold_clear(g);
	for d in dupes { gold_push(g, d); }
	g.steps += g.n * g.n;
	out.i = dupes.len;
	out.s.clear();
	format(out.s, "sorted duplicates count ", dupes.len);
	out
}
@end
