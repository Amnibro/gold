expect: => i=2 r=0.0 ok=true s="grouped frequency counters with retry 2" errors=0 n=2 res=[10,20] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var attempts = 0;
	while attempts <= max_r {
		attempts++;
		for i in g.n {
			let x = g.res[i];
			let prev, hit = gold_cache_get(g, x);
			if hit {
				gold_cache_put(g, x, prev + 1);
			} else {
				gold_cache_put(g, x, 1);
			}
		}
	}
	g.steps += g.n * attempts;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "grouped frequency counters with retry ", g.cn);
	out
}
@end
