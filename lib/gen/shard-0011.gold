	for a in g.n {
		for b in (a + 1)..g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " alternating codes");
