@entry 1e15f3eb3ceb90bf
kind: step
verb: cache
noun: histogram
modifier: all
context: compare
phrase: cache histogram frequencies for all items
phrase: store all element frequencies in comparison cache
test: list=3,3,5,7,7,7
expect: => i=3 r=0.0 ok=true s="cached histogram distinct items 3" errors=0 n=6 res=[3,3,5,7,7,7] cache=3 hits=0
test: list=2,4,4,8,8
expect: => i=3 r=0.0 ok=true s="cached histogram distinct items 3" errors=0 n=5 res=[2,4,4,8,8] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for cache histogram all");
		out.ok = false;
		return out;
	}
	var cached_count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var k = 0;
		while k < i {
			if g.res[k] == val {
				seen = true;
				break;
			}
			k++;
		}
		if !seen {
			var freq = 0;
			var j = 0;
			while j < g.n {
				if g.res[j] == val {
					freq++;
				}
				j++;
			}
			gold_cache_put(g, val, freq);
			cached_count++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = cached_count;
	out.s.clear();
	format(out.s, "cached histogram distinct items ", cached_count);
	out
}
@end
