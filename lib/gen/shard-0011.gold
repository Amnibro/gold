@entry 2cba941809c17eb2
kind: step
verb: rotate
noun: odds
modifier: unique
context: error
phrase: rotate odd numbers cyclically in results
phrase: cycle odd elements forward in place
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="rotated unique odds count 3" errors=0 n=5 res=[5,2,1,4,3] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=false s="error: insufficient odds" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[>..] = [];
	var odd_pos int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds.push(g.res[i]);
			odd_pos.push(i);
		}
	}
	if odds.len < 2 {
		gold_fail(g, "insufficient odds for rotation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient odds");
		return out;
	}
	let last_odd = odds[odds.len - 1];
	var i = odds.len - 1;
	while i > 0 {
		odds[i] = odds[i - 1];
		i--;
	}
	odds[0] = last_odd;
	for k in odds.len {
		g.res[odd_pos[k]] = odds[k];
	}
	g.steps += g.n + odds.len;
