code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${size};
	var avgs int[512] = [0; 512];
	var count = 0;
	if k > 0 && g.n >= k {
		for i in (g.n - k + 1) {
			var s = 0;
			for j in k {
				s += g.res[i + j];
			}
			avgs[count] = s / k;
			count++;
		}
		for i in count { g.res[i] = avgs[i]; }
		g.n = count;
	}
	g.steps += g.n * k;
	out.i = count;
	out.s.clear();
	format(out.s, "collected moving averages count ", count);
	out
}
@end
