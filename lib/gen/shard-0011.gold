@entry 7f6454bd1db57e6e
kind: step
verb: dedupe
noun: checkpoint
modifier: between
context: text
phrase: dedupe characters between indices {start} to {finish}
phrase: remove duplicate letters in range {start} to {finish}
slot: start int
slot: finish int
test: text="aabbccddeeff" start=2 finish=8
expect: => i=9 r=0.0 ok=true s="aabcdeeff" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" start=1 finish=7
expect: => i=7 r=0.0 ok=true s="misippi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var f = ${finish};
	if s < 0 { s = 0; }
	if f > out.s.len { f = out.s.len; }
	if s >= f { return out; }
	var temp byte[>..] = [];
	for i in s { temp.push(out.s[i]); }
	for i in s..f {
		let b = out.s[i];
		var seen = false;
		for j in s..i {
			if out.s[j] == b { seen = true; break; }
		}
		if !seen { temp.push(b); }
	}
	for i in f..out.s.len { temp.push(out.s[i]); }
	out.s.clear();
	for b in temp { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
