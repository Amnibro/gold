@entry d6f69f3249eae8c3
kind: step
verb: validate
noun: average
modifier: until
context: loop
phrase: validate running loop average stays above {min_avg} until {cond}
phrase: check cumulative loop average reaches at least {min_avg} before {cond}
slot: min_avg int
slot: cond pred
test: list=10,20,30,4 min_avg=12 cond=is_even
expect: => i=1 r=0.0 ok=true s="average check prior to condition true" errors=0 n=4 res=[10,20,30,4] cache=0 hits=0
test: list=15,18,5,2 min_avg=10 cond=is_odd
expect: => i=1 r=0.0 ok=true s="average check prior to condition true" errors=0 n=4 res=[15,18,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_avg};
	var sum = 0;
	var valid = true;
	var k = 0;
	while k < g.n {
		if ${cond}(g.res[k]) { break; }
		sum += g.res[k];
		let avg = sum / (k + 1);
		if avg < threshold {
			valid = false;
			gold_fail(g, "running average dropped below minimum");
			break;
		}
		k++;
	}
	g.steps += k;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "average check prior to condition ", valid);
	out
}
@end
