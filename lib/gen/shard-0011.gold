			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total_diff = 0;
	if g.n > 0 {
		let min_val = g.res[0];
		for i in g.n {
			total_diff += g.res[i] - min_val;
		}
	}
	g.steps += g.n * g.n;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "folded distance from min ", total_diff);
	out
}
@end
@entry ee325e4ee0a94808
kind: step
verb: search
noun: primes
modifier: last
context: sort
phrase: search for position of last prime in sorted list
phrase: locate final prime element after sorting
test: list=10,4,7,3,9
expect: => i=2 r=0.0 ok=true s="last prime index 2" errors=0 n=5 res=[3,4,7,9,10] cache=0 hits=0
test: list=8,12,15,6
expect: => i=-1 r=0.0 ok=false s="last prime index -1" errors=0 n=4 res=[6,8,12,15] cache=0 hits=0
code:
fn ${ID}_isp(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n { if n % d == 0 { return false; } d++; }
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var last_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if ${ID}_isp(g.res[i]) {
			last_idx = i;
			break;
		}
		i--;
	}
	out.i = last_idx;
	out.ok = last_idx >= 0;
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "last prime index ", last_idx);
	out
}
@end
