code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_v = ${thresh};
	var found_below = false;
	for i in g.n {
		if g.res[i] < floor_v {
			found_below = true;
			gold_fail(g, "error code below floor threshold");
			out.ok = false;
			break;
		}
	}
	out.i = if found_below { 1 } else { 0 };
	out.s.clear();
	if found_below {
		format(out.s, "floor check failed below threshold ", floor_v);
	} else {
		format(out.s, "all error codes meet minimum threshold ", floor_v);
	}
	g.steps += g.n;
	out
}
@end
@entry 4ba73320a849ec37
kind: step
verb: retry
noun: maximum
modifier: while
context: error
phrase: retry reducing maximum error while above {max_limit}
phrase: clamp maximum error code while exceeding {max_limit}
slot: max_limit int
test: list=100,50,20 max_limit=30
expect: => i=3 r=0.0 ok=true s="reduced maximum error in 3 passes" errors=0 n=3 res=[25,25,20] cache=0 hits=0
test: list=10,20 max_limit=50
expect: => i=0 r=0.0 ok=true s="reduced maximum error in 0 passes" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_l = ${max_limit};
	var passes = 0;
	if g.n > 0 {
		while passes < 5 {
			var max_idx = 0;
			for i in 1..g.n {
				if g.res[i] > g.res[max_idx] { max_idx = i; }
			}
			if g.res[max_idx] <= max_l { break; }
			g.res[max_idx] = g.res[max_idx] / 2;
			passes++;
		}
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "reduced maximum error in ", passes, " passes");
	out
}
@end
