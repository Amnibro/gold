code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_unique};
	var temp int[512] = [0; 512];
	var count = 0;
	out.s.clear();
	out.s.append("unique: {");
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count { if temp[j] == x { seen = true; break; } }
		if !seen && count < limit {
			if count > 0 { out.s.append(", "); }
			temp[count] = x;
			format(out.s, x);
			count++;
		}
	}
	out.s.append("}");
	g.steps += g.n;
	out.i = count;
	out
}
@end
