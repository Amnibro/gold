test: list=10,5,20,15 cycles=2
expect: => i=4 r=0.0 ok=true s="nested pair adjustments total 4" errors=0 n=4 res=[8,5,18,15] cache=0 hits=0
test: list=4,2,8,6 cycles=1
expect: => i=2 r=0.0 ok=true s="nested pair adjustments total 2" errors=0 n=4 res=[3,2,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${cycles};
	var c = 0;
	var total_adjustments = 0;
	while c < rep {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				g.res[i] -= 1;
				total_adjustments++;
			}
			i += 2;
		}
		c++;
	}
	g.steps += rep * g.n;
	out.i = total_adjustments;
	out.s.clear();
	format(out.s, "nested pair adjustments total ", total_adjustments);
	out
}
@end
