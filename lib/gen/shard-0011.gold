@entry 7cb83ec0a9bcc0c0
kind: step
verb: split
noun: middle
modifier: until
context: stats
phrase: trim outer observations toward middle until size {target}
phrase: prune tails toward distribution middle until count {target}
slot: target int
test: list=1,2,3,4,5,6,7,8 target=4
expect: => i=4 r=0.0 ok=true s="pruned distribution to middle count 4" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
test: list=10,20,30,40,50,60 target=2
expect: => i=2 r=0.0 ok=true s="pruned distribution to middle count 2" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	var left = 0;
	var right = g.n - 1;
	while (right - left + 1) > goal && left < right {
		left++;
		right--;
	}
	var kept int[512] = [0; 512];
	var count = 0;
	var i = left;
	while i <= right && i < g.n {
		kept[count] = g.res[i];
		count++;
		i++;
	}
	for j in count { g.res[j] = kept[j]; }
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "pruned distribution to middle count ", count);
	out
}
@end
