code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var matched int[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		if b >= '0' && b <= '9' {
			let val = (b - '0') as int;
			if val >= cut { matched.push(val); }
		}
	}
	if matched.len == 0 {
		gold_fail(g, "no digits meeting cutoff");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no digits meet cutoff");
		return out;
	}
	gold_clear(g);
	for x in matched { gold_push(g, x); }
	g.steps += out.s.len;
	out.i = matched.len;
	out.s.clear();
	format(out.s, "digits above cutoff ", matched.len);
	out
}
@end
