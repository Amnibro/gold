	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise average");
		out.ok = false;
		return out;
	}
	let pairs = g.n / 2;
	for i in pairs {
		g.res[i] = (g.res[2 * i] + g.res[2 * i + 1]) / 2;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
