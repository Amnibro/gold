code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let h = ${calc_fn}(g.res[0]);
	var tail_sum = 0;
	for i in 1..g.n { tail_sum += g.res[i]; }
	let diff = h - tail_sum;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "first mapped difference: ", diff);
	out
}
@end
