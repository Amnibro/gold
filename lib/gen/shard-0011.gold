	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x <= lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " evens up to limit");
	out
}
