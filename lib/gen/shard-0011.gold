@entry aa2f055deac4abca
kind: step
verb: swap
noun: gaps
modifier: at_least
context: stats
phrase: swap adjacent values with gap at least {min_gap}
phrase: exchange consecutive items having difference at least {min_gap}
slot: min_gap int
test: list=1,10,2 min_gap=5
expect: => i=1 r=0.0 ok=true s="swapped gaps count 1" errors=0 n=3 res=[10,1,2] cache=0 hits=0
test: list=2,4,6 min_gap=5
expect: => i=0 r=0.0 ok=true s="swapped gaps count 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		if gap >= mg {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped gaps count ", swaps);
	out
}
@end
