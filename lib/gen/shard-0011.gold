code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let diff_limit = ${thresh};
	var violations = 0;
	var i = 0;
	while i + 1 < out.s.len {
		let c1 = out.s[i] as! int;
		let c2 = out.s[i + 1] as! int;
		let d = if c1 > c2 { c1 - c2 } else { c2 - c1 };
		if d > diff_limit { violations++; }
		i++;
	}
	g.steps += out.s.len;
	out.i = violations;
	out
}
@end
@entry 41db51fa85384578
kind: step
verb: retry
noun: suffix
modifier: unique
context: text
phrase: retry verifying unique characters in text suffix of size {count}
phrase: check whether trailing text suffix of length {count} is unique
slot: count int
test: text="banana" count=3
expect: => i=0 r=0.0 ok=false s="banana" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcdef" count=4
expect: => i=1 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k > out.s.len { return out; }
	let start = out.s.len - k;
	var is_uniq = true;
	var i = start;
	while i < out.s.len && is_uniq {
		var j = i + 1;
		while j < out.s.len {
			if out.s[i] == out.s[j] { is_uniq = false; break; }
			j++;
		}
		i++;
	}
	g.steps += k;
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	out
}
@end
