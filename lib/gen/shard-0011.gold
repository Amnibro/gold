expect: => i=3 r=0.0 ok=true s="dropped square outliers in reverse 3" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=25,7,36,8
expect: => i=2 r=0.0 ok=true s="dropped square outliers in reverse 2" errors=0 n=2 res=[7,8] cache=0 hits=0
code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r < n { r++; }
	r * r == n
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_sq(x) {
			dropped++;
		} else {
			kept[kn] = x;
			kn++;
		}
	}
	for i in kn {
		g.res[i] = kept[i];
	}
	g.n = kn;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped square outliers in reverse ", dropped);
	out
}
@end
@entry 00b0a490bf184337
kind: step
verb: repeat
noun: odds
modifier: all
context: error
phrase: repeat all odd numbers in results
