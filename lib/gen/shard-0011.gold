fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var steps = 0;
	while !found && steps < 10 {
		steps++;
		for i in g.n {
			if ${crit}(g.res[i]) {
				found = true;
				break;
			}
			g.res[i] = g.res[i] / 2;
		}
	}
	g.steps += g.n * steps;
	out.ok = found;
	out.i = steps;
	out.s.clear();
	format(out.s, "split until condition satisfied in steps ", steps);
	out
}
@end
