test: list=10,20
expect: => i=2 r=0.0 ok=true s="mapped 2 distinct frequencies" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_vals int[512] = [0; 512];
	var u_cnt int[512] = [0; 512];
	var u_n = 0;
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in u_n {
			if u_vals[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			u_cnt[idx]++;
		} else {
			u_vals[u_n] = x;
			u_cnt[u_n] = 1;
			u_n++;
		}
	}
	for i in u_n {
		g.res[i] = u_cnt[i];
	}
	g.n = u_n;
	g.steps += g.n + u_n;
	out.i = u_n;
	out.s.clear();
	format(out.s, "mapped ", u_n, " distinct frequencies");
	out
}
@end
