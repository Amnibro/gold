@entry a024fc1fb37dd5a8
kind: step
verb: filter
noun: item
modifier: first
context: core
phrase: filter item first match for {p}
phrase: keep only first item satisfying {p}
phrase: retain single first match for condition {p}
slot: p pred
test: list=1,3,4,6,8 p=is_even
expect: => i=4 r=0.0 ok=true s="kept first matching item 4" errors=0 n=1 res=[4] cache=0 hits=0
test: list=2,4,7,9 p=is_odd
expect: => i=7 r=0.0 ok=true s="kept first matching item 7" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_idx = -1;
	for i in g.n {
		if ${p}(g.res[i]) {
			found_idx = i;
			break;
		}
	}
	out.s.clear();
	if found_idx >= 0 {
		let match_val = g.res[found_idx];
		g.res[0] = match_val;
		g.n = 1;
		out.i = match_val;
		format(out.s, "kept first matching item ", match_val);
	} else {
		g.n = 0;
		out.i = -1;
		format(out.s, "no item matched");
	}
	g.steps += g.n;
	out
}
@end
