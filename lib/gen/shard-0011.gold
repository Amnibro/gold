@entry 80b5d2d59e0c0f57
kind: step
verb: swap
noun: primes
modifier: in_place
context: loop
phrase: swap prime values in place
phrase: reverse prime entries within sequence
test: list=2,4,6,3,8,5
expect: => i=3 r=0.0 ok=true s="swapped 3 prime elements" errors=0 n=6 res=[5,4,6,3,8,2] cache=0 hits=0
test: list=7,11,4,13
expect: => i=3 r=0.0 ok=true s="swapped 3 prime elements" errors=0 n=4 res=[13,11,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_idx int[512] = [0; 512];
	var p_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p_idx[p_count] = i;
				p_count++;
			}
		}
	}
	var left = 0;
	var right = p_count - 1;
	while left < right {
		let i1 = p_idx[left];
		let i2 = p_idx[right];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + p_count;
	out.i = p_count;
	out.s.clear();
	format(out.s, "swapped ", p_count, " prime elements");
	out
}
@end
