@entry 55d658c11280ddbc
kind: step
verb: normalize
noun: runs
modifier: at_least
context: error
phrase: normalize consecutive error runs of at least length {min_len}
phrase: smooth error runs having at least length {min_len}
slot: min_len int
test: list=7,7,7,2,3 min_len=3
expect: => i=3 r=0.0 ok=true s="normalized longest error run 3" errors=0 n=5 res=[7,7,7,2,3] cache=0 hits=0
test: list=1,2,3,4 min_len=4
expect: => i=1 r=0.0 ok=false s="normalized longest error run 1" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	if g.n == 0 {
		gold_fail(g, "empty results for run normalization");
		out.ok = false;
		return out;
	}
	var longest = 0;
	var cur = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
		} else {
			if cur > longest { longest = cur; }
			cur = 1;
		}
		i++;
	}
	if cur > longest { longest = cur; }
	if longest < min_l {
		gold_fail(g, "error run shorter than required length");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "normalized longest error run ", longest);
	out
}
@end
@entry d64866341e58ab9c
kind: step
verb: run
noun: item
modifier: recursively
context: error
phrase: recursively process error item until resolved
phrase: step through error item recursively
slot: limit int
test: input=16 limit=10
expect: => i=1 r=0.0 ok=true s="recursively reduced error item in 4 steps" errors=0 n=0 res=[] cache=0 hits=0
test: input=100 limit=2
expect: => i=25 r=0.0 ok=false s="recursively reduced error item in 2 steps" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_steps = ${limit};
	var item = out.i;
	var count = 0;
	while item > 1 && count < max_steps {
		if item % 2 == 0 {
			item /= 2;
		} else {
			item = item - 1;
		}
		count++;
	}
	if item > 1 {
		gold_fail(g, "item recursion exceeded step limit");
		out.ok = false;
	}
	g.steps += count;
	out.i = item;
	out.s.clear();
	format(out.s, "recursively reduced error item in ", count, " steps");
	out
}
@end
