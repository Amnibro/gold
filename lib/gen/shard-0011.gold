test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="filled primes into cache 2" errors=0 n=4 res=[10,11,12,13] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, x, 1);
			prime_count++;
		}
	}
	g.steps += g.n * 10;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "filled primes into cache ", prime_count);
	out
}
@end
