kind: step
verb: join
noun: duplicates
modifier: recursively
context: compare
phrase: join duplicate comparisons recursively into frequency counts
phrase: recursively aggregate matching duplicate elements into counts
test: list=3,5,3,2,5,3
expect: => i=5 r=0.0 ok=true s="recursively aggregated duplicates count 5" errors=0 n=6 res=[3,5,3,2,5,3] cache=0 hits=0
test: list=8,8,9,10,9
expect: => i=4 r=0.0 ok=true s="recursively aggregated duplicates count 4" errors=0 n=5 res=[8,8,9,10,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_vals int[>..] = [];
	var unique_counts int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var found_idx = -1;
		for j in unique_vals.len {
			if unique_vals[j] == x { found_idx = j; break; }
		}
		if found_idx >= 0 {
			unique_counts[found_idx] += 1;
		} else {
			unique_vals.push(x);
			unique_counts.push(1);
		}
	}
	var dup_sum = 0;
	for j in unique_counts.len {
		if unique_counts[j] > 1 { dup_sum += unique_counts[j]; }
	}
	g.steps += g.n;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "recursively aggregated duplicates count ", dup_sum);
	out
}
@end
