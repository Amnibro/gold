	let r = ${rounds};
	var total = 0;
	for i in g.n {
		if i % 2 == 0 {
			gold_cache_put(g, i, g.res[i]);
			total += g.res[i];
		}
	}
	g.steps += g.n * r;
	out.i = total * r;
	out.s.clear();
	format(out.s, "summed checkpoint cache values ", out.i);
	out
}
