code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var merged = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= cut {
			gold_cache_put(g, i, x);
			merged++;
		}
	}
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged ", merged, " items into cache");
	out
}
@end
