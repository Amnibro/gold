expect: 15
expect: 24
code:
fn ${ID}(n int) int {
	let max_d = ${max_depth};
	var x = if n < 0 { -n } else { n };
	var depth = 0;
	while x >= 10 && depth < max_d {
		var sum = 0;
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
		x = sum;
		depth++;
	}
	x
}
@end
