code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[k] = x + cached;
			matched++;
		} else {
			gold_cache_put(g, x, k + 1);
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "paired memo matches ", matched);
	out
}
@end
@entry 48d00e5d52baeddc
kind: step
verb: retry
noun: gaps
modifier: in_place
context: aggregate
phrase: retry closing gaps in place up to {attempts} times
phrase: attempt closing gaps in place with {attempts} retries
slot: attempts int
test: list=10,2,8,1 attempts=2
expect: => i=2 r=0.0 ok=true s="closed gaps in place 2 rounds" errors=0 n=4 res=[8,5,5,3] cache=0 hits=0
test: list=20,5,15 attempts=1
expect: => i=1 r=0.0 ok=true s="closed gaps in place 1 rounds" errors=0 n=3 res=[19,7,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${attempts};
	var r = 0;
	while r < limit {
		var i = 0;
		while i + 1 < g.n {
			let diff = g.res[i] - g.res[i + 1];
			if diff > 2 {
				g.res[i] -= 1;
				g.res[i + 1] += 1;
			} else if diff < -2 {
				g.res[i] += 1;
				g.res[i + 1] -= 1;
			}
			i++;
		}
		r++;
	}
	g.steps += limit * g.n;
	out.i = limit;
	out.s.clear();
	format(out.s, "closed gaps in place ", limit, " rounds");
	out
}
@end
