code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = if ${buckets} > 0 { ${buckets} } else { 1 };
	var b_sums int[>..] = [];
	for i in b { b_sums.push(0); }
	for k in g.n {
		let slot_idx = (g.res[k] % b + b) % b;
		b_sums[slot_idx] += 1;
	}
	g.n = b;
	var total_bins = 0;
	for i in b {
		g.res[i] = b_sums[i];
		total_bins += b_sums[i];
	}
	g.steps += g.n;
	out.i = total_bins;
	out.s.clear();
	format(out.s, "histogram total binned entries ", total_bins);
	out
}
@end
