fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x % 10 == 0 {
			kept.push(x);
			gold_cache_put(g, kept.len - 1, i);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n + kept.len;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "filtered ", kept.len, " checkpoints");
	out
}
@end
@entry 158bf0f52649d834
kind: step
verb: trace
noun: list
modifier: with_retry
context: search
phrase: trace list items searching with retry attempts {target} {retries}
phrase: scan list for item using retry count {target} {retries}
slot: target int
slot: retries int
test: list=4,8,15,16,23 target=16 retries=3
expect: => i=3 r=0.0 ok=true s="traced list attempts 1" errors=0 n=5 res=[4,8,15,16,23] cache=0 hits=0
test: list=1,2,3 target=99 retries=2
expect: => i=-1 r=0.0 ok=false s="traced list attempts 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var found_pos = -1;
	var attempt = 0;
	while attempt < max_r && found_pos < 0 {
		for i in g.n {
			if g.res[i] == tgt {
				found_pos = i;
				break;
			}
		}
		attempt++;
	}
	g.steps += attempt * g.n;
	out.i = found_pos;
	out.ok = found_pos >= 0;
	out.s.clear();
	format(out.s, "traced list attempts ", attempt);
	out
}
@end
