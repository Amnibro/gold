code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "sequence too short for middle selection");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let mid_val = g.res[mid];
	g.res[0] = mid_val;
	g.n = 1;
	g.steps += 1;
	out.i = mid_val;
	out.s.clear();
	format(out.s, "selected middle element: ", mid_val);
	out
}
@end
