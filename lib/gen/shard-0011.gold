code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = g.n / 2;
	var swapped = 0;
	for i in pairs {
		let a = 2 * i;
		let b = 2 * i + 1;
		if g.res[a] > g.res[b] {
			let tmp = g.res[a];
			g.res[a] = g.res[b];
			g.res[b] = tmp;
			swapped++;
		}
	}
	g.steps += pairs;
	out.i = swapped;
	out.s.clear();
	format(out.s, "sorted ", pairs, " nested pairs with ", swapped, " swaps");
	out
}
@end
