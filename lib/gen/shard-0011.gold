@entry e5cfc846739f0b02
kind: step
verb: sort
noun: memo
modifier: between
context: compare
phrase: sort cached memo comparisons bounded between {low} through {high}
phrase: reorder memo keys falling within interval {low} to {high}
slot: low int
slot: high int
test: list=15,5,25,8 low=6 high=20
expect: => i=2 r=0.0 ok=true s="sorted memo in range count 2" errors=0 n=4 res=[8,5,25,15] cache=0 hits=0
test: list=30,10,20,50 low=15 high=40
expect: => i=2 r=0.0 ok=true s="sorted memo in range count 2" errors=0 n=4 res=[20,10,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var indices int[>..] = [];
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			indices.push(k);
		}
	}
	var a = 0;
	while a < indices.len {
		var b = a + 1;
		while b < indices.len {
			let ia = indices[a];
			let ib = indices[b];
			if g.res[ib] < g.res[ia] {
				let t = g.res[ia];
				g.res[ia] = g.res[ib];
				g.res[ib] = t;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n + indices.len;
	out.i = indices.len;
	out.s.clear();
	format(out.s, "sorted memo in range count ", indices.len);
	out
}
@end
