code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${cap};
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] <= max_sum {
			running += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "kept ", kept, " head elements with running sum ", running);
	out
}
@end
