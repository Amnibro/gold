expect: => i=3 r=0.0 ok=true s="merged prefix count 3" errors=0 n=3 res=[9,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sum = 0;
	while count < g.n && ${cond}(g.res[count]) {
		sum += g.res[count];
		count++;
	}
	if count > 1 {
		g.res[0] = sum;
		var w = 1;
		var i = count;
		while i < g.n {
			g.res[w] = g.res[i];
			w++;
			i++;
		}
		g.n = w;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged prefix count ", count);
	out
}
@end
