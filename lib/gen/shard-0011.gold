kind: step
verb: count
noun: step
modifier: last
context: sort
phrase: count comparisons in last insertion sort pass
phrase: measure steps in last sort pass
test: list=4,3,2,10,12
expect: => i=3 r=0.0 ok=true s="counted 3 shift steps" errors=0 n=5 res=[2,3,4,10,12] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="counted 0 shift steps" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let key = g.res[i];
			var j = i - 1;
			while j >= 0 && g.res[j] > key {
				g.res[j + 1] = g.res[j];
				j--;
				shifts++;
			}
			g.res[j + 1] = key;
		}
	}
	g.steps += shifts + g.n;
	out.i = shifts;
	out.s.clear();
	format(out.s, "counted ", shifts, " shift steps");
	out
}
@end
