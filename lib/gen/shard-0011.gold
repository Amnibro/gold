context: error
phrase: validate adjacent pairs exist in cache
phrase: verify consecutive elements cached pairs
test: list=1,2,3
expect: => i=1 r=0.0 ok=true s="cache pairwise validation true" errors=0 n=3 res=[1,2,3] cache=3 hits=4
test: list=1,5,9
expect: => i=0 r=0.0 ok=false s="error: missing cache pairs" errors=1 n=3 res=[1,5,9] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 1, 1);
	gold_cache_put(g, 2, 1);
	gold_cache_put(g, 3, 1);
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise validation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var all_cached = true;
	for i in (g.n - 1) {
		let _, f1 = gold_cache_get(g, g.res[i]);
		let _, f2 = gold_cache_get(g, g.res[i + 1]);
		if !f1 || !f2 { all_cached = false; break; }
	}
	if !all_cached {
		gold_fail(g, "some pairs missing from cache");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: missing cache pairs");
		return out;
	}
	g.steps += g.n;
	out.ok = true;
	out.i = 1;
	out.s.clear();
	format(out.s, "cache pairwise validation true");
	out
}
@end
