				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.n / 2;
	let median = if g.n > 0 { g.res[mid] } else { 0 };
	gold_cache_put(g, 0, median);
	g.steps += g.n * g.n;
	out.i = median;
	out.s.clear();
	format(out.s, "cached sorted median value ", median);
	out
}
@end
