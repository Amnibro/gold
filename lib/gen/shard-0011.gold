fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen byte[256] = [0; 256];
	var w = 0;
	for idx in out.s.len {
		let ch = out.s[idx] as int;
		if seen[ch] == 0 {
			seen[ch] = 1;
			out.s[w] = out.s[idx];
			w++;
		}
	}
	while out.s.len > w {
		out.s.pop();
	}
	g.steps += w;
	out.i = w;
	out
}
@end
