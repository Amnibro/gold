code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget_ceiling = ${max_budget};
	var spent = 0;
	var count = 0;
	for k in g.n {
		if spent + g.res[k] > budget_ceiling { break; }
		spent += g.res[k];
		count++;
	}
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent within ceiling ", spent);
	out
}
@end
@entry 09dbb9113874ccd0
kind: step
verb: rotate
noun: words
modifier: nested
context: compare
phrase: rotate comparison word entries by nested shift {shift}
phrase: cyclically shift word comparison records using depth {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated comparison words shift 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated comparison words shift 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let s = (${shift} % g.n + g.n) % g.n;
	var rot_count = 0;
	while rot_count < s {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		rot_count++;
	}
	g.steps += rot_count * g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated comparison words shift ", s);
	out
}
@end
