code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let mult = ${factor};
	let sum_head = (g.res[0] + g.res[1]) * mult;
	g.res[0] = sum_head;
	for i in 1..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = sum_head;
	out.s.clear();
	format(out.s, "merged head to ", sum_head);
	out
}
@end
