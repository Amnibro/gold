@entry b14e54fdc32fd2e9
kind: step
verb: rotate
noun: budget
modifier: any
context: sort
phrase: rotate sorted items within step budget limit {budget}
phrase: cycle sorted array while budget permits {budget}
slot: budget int
test: list=10,20,30,40 budget=2
expect: => i=2 r=0.0 ok=true s="budget rotated by 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=5,15,25 budget=1
expect: => i=1 r=0.0 ok=true s="budget rotated by 1" errors=0 n=3 res=[15,25,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if g.n > 1 {
		var k = b % g.n;
		while k > 0 {
			let first = g.res[0];
			for i in 1..g.n { g.res[i - 1] = g.res[i]; }
			g.res[g.n - 1] = first;
			k--;
		}
	}
	g.steps += b + g.n * g.n;
	out.i = b;
	out.s.clear();
	format(out.s, "budget rotated by ", b);
	out
}
@end
