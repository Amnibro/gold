		for j in (i + 1)..matched.len {
			if matched[j] < matched[i] {
				let tmp = matched[i];
				matched[i] = matched[j];
				matched[j] = tmp;
			}
		}
	}
	for k in matched.len {
		gold_cache_put(g, k, matched[k]);
	}
	g.steps += g.n + matched.len * matched.len;
	out.i = matched.len;
	out.s.clear();
	format(out.s, "cached ", matched.len, " range items");
	out
}
