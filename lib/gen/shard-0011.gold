fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var found = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b >= '0' && b <= '9' {
			sum += (b - '0') as int;
			found++;
		}
	}
	if found == 0 {
		gold_fail(g, "no digits found in text");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no digits in text");
		return out;
	}
	g.steps += out.s.len;
	out.i = sum;
	out.s.clear();
	format(out.s, "running digit sum ", sum);
	out
}
@end
