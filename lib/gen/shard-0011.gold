phrase: partially sort retry window until reaching {cond}
slot: cond pred
test: list=9,3,7,2,11 cond=is_even
expect: => i=4 r=0.0 ok=true s="sorted retry window up to index 4" errors=0 n=5 res=[2,3,7,9,11] cache=0 hits=0
test: list=8,5,2,4,9 cond=is_odd
expect: => i=2 r=0.0 ok=true s="sorted retry window up to index 2" errors=0 n=5 res=[5,8,2,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stop_idx = g.n;
	for k in g.n {
		if ${cond}(g.res[k]) {
			stop_idx = k + 1;
			break;
		}
	}
	var i = 0;
	while i < stop_idx {
		var j = 0;
		while j + 1 < stop_idx - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += stop_idx;
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "sorted retry window up to index ", stop_idx);
	out
}
@end
@entry dfe45f91a18aef4f
kind: step
verb: search
noun: squares
modifier: sorted
context: retry
phrase: search sorted squares of retry delays for target {target}
phrase: find squared retry value {target} among sorted attempts
slot: target int
test: list=1,4,9,16,25 target=9
expect: => i=2 r=0.0 ok=true s="searched sorted squares found at 2" errors=0 n=5 res=[1,4,9,16,25] cache=0 hits=0
test: list=4,9,16,25,36 target=12
expect: => i=-1 r=0.0 ok=false s="searched sorted squares found at -1" errors=0 n=5 res=[4,9,16,25,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var low = 0;
	var high = g.n - 1;
	var found_idx = -1;
	while low <= high {
		let mid = low + (high - low) / 2;
		if g.res[mid] == tgt {
			found_idx = mid;
			break;
		} else if g.res[mid] < tgt {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "searched sorted squares found at ", found_idx);
	out
}
@end
