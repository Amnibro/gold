fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	var windows = 0;
	if w > 0 && g.n >= w {
		var i = 0;
		while i + w <= g.n {
			var sum = 0;
			for j in w { sum += g.res[i + j]; }
			gold_cache_put(g, windows, sum);
			windows++;
			i++;
		}
	}
	out.i = windows;
	out.s.clear();
	format(out.s, "window count: ", windows);
	g.steps += g.n;
	out
}
@end
