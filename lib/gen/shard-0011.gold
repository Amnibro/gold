context: math
phrase: run average calculation until reaching limit {max_avg}
phrase: compute running average bounded by {max_avg}
slot: max_avg int
test: list=10,20,30,100 max_avg=25
expect: => i=20 r=0.0 ok=true s="running average reached 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 max_avg=50
expect: => i=10 r=0.0 ok=true s="running average reached 10" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${max_avg};
	var count = 0;
	var sum = 0;
	var last_avg = 0;
	for i in g.n {
		let next_sum = sum + g.res[i];
		let next_avg = next_sum / (count + 1);
		if next_avg > bound && count > 0 { break; }
		sum = next_sum;
		count++;
		last_avg = next_avg;
	}
	g.n = count;
	g.steps += count;
	out.i = last_avg;
	out.s.clear();
	format(out.s, "running average reached ", last_avg);
	out
}
@end
