@entry d667b649c92f0b16
kind: step
verb: cache
noun: streak
modifier: all
context: format
phrase: cache all increasing streak statistics into slot zero
phrase: format longest streak length caching all metrics
test: list=1,2,3,1,2,3,4
expect: => i=4 r=0.0 ok=true s="max_streak: 4 cached" errors=0 n=7 res=[1,2,3,1,2,3,4] cache=1 hits=0
test: list=10,20,5,15,25,35,40
expect: => i=5 r=0.0 ok=true s="max_streak: 5 cached" errors=0 n=7 res=[10,20,5,15,25,35,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	for i in g.n {
		if i == 0 || g.res[i] > g.res[i - 1] {
			cur_streak++;
		} else {
			cur_streak = 1;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
	}
	gold_cache_put(g, 0, max_streak);
	out.s.clear();
	format(out.s, "max_streak: ", max_streak, " cached");
	g.steps += g.n;
	out.i = max_streak;
	out
}
@end
