expect: 9
code:
fn ${ID}(n int) int {
	let orig = if n < 0 { -n } else { n };
	var x = orig;
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	if d.len <= 1 { return orig; }
	let last_val = d[0];
	var run_len = 0;
	while run_len < d.len && d[run_len] == last_val {
		run_len++;
	}
