test: text="Z" code_fn=inc
expect: => i=1 r=0.0 ok=true s="[" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in out.s.len {
		let next_b = ${code_fn}(out.s[i] as int);
		out.s[i] = next_b as byte;
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
