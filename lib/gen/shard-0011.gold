expect: => i=101 r=0.0 ok=false s="leading error code is not even: 101" errors=1 n=2 res=[101,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty error list for even check");
		out.ok = false;
		return out;
	}
	let first_code = g.res[0];
	if first_code % 2 != 0 {
		gold_fail(g, "leading error code must be even");
		out.ok = false;
	}
	out.i = first_code;
	out.s.clear();
	if out.ok {
		format(out.s, "leading error code is even: ", first_code);
	} else {
		format(out.s, "leading error code is not even: ", first_code);
	}
	g.steps += 1;
	out
}
@end
