code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var kept = 0;
	if out.s.len > 1 {
		for i in (out.s.len - 1) {
			var diff = out.s[i + 1] as int - out.s[i] as int;
			if diff < 0 { diff = -diff; }
			if diff > t {
				gold_push(g, diff);
				kept++;
			}
		}
	}
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " gaps exceeding threshold");
	out
}
@end
