code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var kept int[>..] = [];
	for i in g.n {
		if kept.len == 0 || g.res[i] != kept[kept.len - 1] {
			kept.push(g.res[i]);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "safely deduped to ", kept.len);
	out
}
@end
