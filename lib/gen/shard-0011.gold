fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var leader = true;
		for j in (i + 1)..g.n {
			if g.res[j] >= g.res[i] { leader = false; break; }
		}
		if leader {
