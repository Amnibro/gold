code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = if ${bucket} <= 0 { 1 } else { ${bucket} };
	var counts int[>..] = [];
	for k in g.n {
		let bin_idx = g.res[k] / b;
		while counts.len <= bin_idx { counts.push(0); }
		counts[bin_idx] += 1;
	}
	gold_clear(g);
	for i in counts.len {
		if counts[i] > 0 { gold_push(g, counts[i]); }
	}
	g.steps += g.n + counts.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged histogram bins count ", g.n);
	out
}
@end
