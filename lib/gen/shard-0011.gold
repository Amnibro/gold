fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var val = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] % 2 == 0 {
			found = true;
			val = g.res[i];
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.ok = found;
	out.i = val;
	out.s.clear();
	format(out.s, "last even: ", val);
	out
}
