code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			if g.res[i] >= lim { break; }
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " range swaps");
	out
}
@end
