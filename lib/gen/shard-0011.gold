		rev.push(x % 10);
		x /= 10;
	}
	var uniq int[>..] = [];
	var i = rev.len - 1;
	while i >= 0 {
		let d = rev[i];
		if uniq.len == 0 || uniq[uniq.len - 1] != d {
			uniq.push(d);
