	for i in g.n {
		if g.res[i] % 2 == 0 { even_sum += g.res[i]; }
	}
	for i in g.n {
		if g.res[i] % 2 != 0 { g.res[i] = even_sum * mult; }
	}
	g.steps += g.n;
	out.i = even_sum;
	out.s.clear();
	format(out.s, "even numbers aggregate: ", even_sum);
	out
}
