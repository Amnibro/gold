code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for step collection");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
		i++;
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected ", g.n, " steps in place");
	out
}
@end
