expect: => i=4 r=0.0 ok=true s="items: - <8> <14> -" errors=0 n=4 res=[2,8,14,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	out.s.clear();
	out.s.append("items: ");
	for i in g.n {
		let x = g.res[i];
		if i > 0 { out.s.append(" "); }
		if x >= low && x <= high {
			format(out.s, "<", x, ">");
		} else {
			out.s.append("-");
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
@entry 9f0e18721ec8d1ab
kind: step
