test: list=10,20
expect: => i=2 r=0.0 ok=true s="mapped 2 cached entries" errors=0 n=2 res=[20,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mapped = 0;
	for i in g.n {
		let k = g.res[i];
		let cv, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = cv;
		} else {
			let double_v = k * 2;
			gold_cache_put(g, k, double_v);
			g.res[i] = double_v;
		}
		mapped++;
	}
	g.steps += g.n;
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped ", mapped, " cached entries");
	out
}
@end
@entry 839fce2904659a72
kind: step
verb: reverse
noun: step
modifier: running
context: sort
phrase: reverse running sorted blocks of size {block}
phrase: invert running segments of size {block}
slot: block int
test: list=1,2,3,4,5,6 block=3
expect: => i=3 r=0.0 ok=true s="reversed blocks of size 3" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 block=2
expect: => i=2 r=0.0 ok=true s="reversed blocks of size 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let blk = ${block};
	if blk > 1 {
		var start = 0;
		while start + blk <= g.n {
			let half = blk / 2;
			for i in half {
				let j = blk - 1 - i;
				let tmp = g.res[start + i];
				g.res[start + i] = g.res[start + j];
				g.res[start + j] = tmp;
			}
			start += blk;
		}
	}
	g.steps += g.n;
	out.i = blk;
	out.s.clear();
	format(out.s, "reversed blocks of size ", blk);
	out
}
@end
