fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 1;
	while i < out.s.len {
		let code = out.s[i] as! int;
		if core_is_prime(code) {
			let t = out.s[i - 1];
			out.s[i - 1] = out.s[i];
			out.s[i] = t;
			swaps++;
		}
		i += 2;
	}
	g.steps += out.s.len;
	out.i = swaps;
	out
}
@end
