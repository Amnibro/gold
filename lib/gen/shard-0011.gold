code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		var dup = false;
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] {
				dup = true;
				break;
			}
			j++;
		}
		if !dup {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped keeping last ", w);
	out
}
@end
@entry 581fb58b04eb033d
kind: step
verb: rotate
noun: history
modifier: with_retry
context: filter
phrase: rotate filter history elements with retry attempt {shift}
phrase: cycle history sequence with retry fallback {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated history retry 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated history retry 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n == 0 {
		gold_fail(g, "empty history for rotate retry");
		out.ok = false;
		return out;
	}
	var rot = s % g.n;
	if rot < 0 { rot += g.n; }
	for step in rot {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += rot;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated history retry ", rot);
	out
}
@end
