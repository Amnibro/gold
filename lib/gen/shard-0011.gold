slot: max_len int
test: list=2,2,2,2,3,3,4 max_len=2
expect: => i=5 r=0.0 ok=true s="clamped streaks resulting length 5" errors=0 n=5 res=[2,2,3,3,4] cache=0 hits=0
test: list=1,1,1,1,1 max_len=3
expect: => i=3 r=0.0 ok=true s="clamped streaks resulting length 3" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_len};
	var w = 0;
	var streak = 0;
	var last_val = -999999;
	for k in g.n {
		let x = g.res[k];
		if x == last_val {
			streak++;
		} else {
			streak = 1;
			last_val = x;
		}
		if streak <= cap {
			g.res[w] = x;
			w++;
		}
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "clamped streaks resulting length ", w);
	out
}
@end
