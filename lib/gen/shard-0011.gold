expect: => i=3 r=0.0 ok=true s="mapped 3 prime elements" errors=0 n=4 res=[20,30,4,50] cache=0 hits=0
test: list=6,7,8,9 factor=3
expect: => i=1 r=0.0 ok=true s="mapped 1 prime elements" errors=0 n=4 res=[6,21,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var modified = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[i] = x * mult;
				modified++;
			}
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped ", modified, " prime elements");
	out
}
@end
