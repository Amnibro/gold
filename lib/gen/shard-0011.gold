code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	let lo = ${low};
	let hi = ${high};
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	for i in k {
		if g.res[i] < lo { g.res[i] = lo; }
		if g.res[i] > hi { g.res[i] = hi; }
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "clamped first ", k, " numbers");
	out
}
@end
@entry 8f1a33ab506dd7f7
kind: step
verb: search
noun: limit
modifier: with_cache
context: math
phrase: search first element above limit {bound} with cache
phrase: find boundary limit {bound} using cached lookup
slot: bound int
test: list=5,12,19,25 bound=15
expect: => i=19 r=0.0 ok=true s="searched limit value 19" errors=0 n=4 res=[5,12,19,25] cache=1 hits=0
test: list=3,7,9 bound=20
expect: => i=-1 r=0.0 ok=true s="searched limit value -1" errors=0 n=3 res=[3,7,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let cached_val, found = gold_cache_get(g, b);
	if found {
		out.i = cached_val;
		out.s.clear();
		format(out.s, "found cached limit value ", cached_val);
		return out;
	}
	var res_val = -1;
	for i in g.n {
		if g.res[i] > b {
			res_val = g.res[i];
			break;
		}
	}
	gold_cache_put(g, b, res_val);
	g.steps += g.n;
	out.i = res_val;
	out.s.clear();
	format(out.s, "searched limit value ", res_val);
	out
}
@end
@entry e221168b74ed7ccd
kind: step
verb: search
noun: number
modifier: with_retry
context: math
phrase: search target number {target} with neighboring retries
phrase: locate number {target} with fallback attempts
slot: target int
test: list=10,20,30 target=20
expect: => i=1 r=0.0 ok=true s="found number at index 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,30 target=50
expect: => i=-1 r=0.0 ok=true s="number not found after retries" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == t { found_idx = i; break; }
	}
	if found_idx == -1 {
		for i in g.n {
			if g.res[i] == t - 1 || g.res[i] == t + 1 {
				found_idx = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found number at index ", found_idx);
	} else {
		format(out.s, "number not found after retries");
	}
	out
}
@end
