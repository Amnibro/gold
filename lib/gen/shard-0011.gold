@entry a932decb7229b48e
kind: step
verb: run
noun: threshold
modifier: sorted
context: error
phrase: verify sorted results against error threshold {threshold}
phrase: check sorted elements meeting error threshold {threshold}
slot: threshold int
test: list=5,10,15,20 threshold=12
expect: => i=2 r=0.0 ok=true s="sorted items meeting threshold count 2" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=20,10,5 threshold=12
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	if !is_sorted {
		gold_fail(g, "results array not sorted");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] >= th {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted items meeting threshold count ", count);
	out
}
@end
