@entry 0ce4be823e2a5c2e
kind: step
verb: reverse
noun: item
modifier: unique
context: compare
phrase: reverse unique elements after comparison deduplication
phrase: deduplicate comparing items reversing unique results
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="reversed 4 unique items" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="reversed 3 unique items" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == val { seen = true; break; }
		}
		if !seen {
			g.res[write_idx] = val;
			write_idx++;
		}
	}
	g.n = write_idx;
	var left = 0;
	var right = write_idx - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n * 2;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "reversed ", write_idx, " unique items");
	out
}
@end
