test: list=5,2,8,1 sub=double
expect: => i=4 r=0.0 ok=true s="applied subfunction sorted results 4" errors=0 n=4 res=[2,4,10,16] cache=0 hits=0
test: list=10,3,7,4 sub=inc
expect: => i=4 r=0.0 ok=true s="applied subfunction sorted results 4" errors=0 n=4 res=[4,5,8,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${sub}(g.res[k]);
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied subfunction sorted results ", g.n);
	out
}
@end
