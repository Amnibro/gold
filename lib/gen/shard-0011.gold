noun: cache
modifier: last
context: text
phrase: rotate cached values by last character code
phrase: shift cache entries using last letter
test: text="cat" list=10,20,30,40
expect: => i=0 r=0.0 ok=true s="rotated cache by last code shift 0" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: text="dog" list=1,2,3,4
expect: => i=3 r=0.0 ok=true s="rotated cache by last code shift 3" errors=0 n=4 res=[4,1,2,3] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 || out.s.len == 0 { return out; }
	let last_code = out.s[out.s.len - 1] as int;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	let shift = last_code % g.n;
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[(i + shift) % g.n]; }
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated cache by last code shift ", shift);
	out
}
@end
