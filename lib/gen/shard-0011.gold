expect: => i=0 r=0.0 ok=true s="found 0 adjacent transitions" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for adjacent transitions");
		out.ok = false;
		return out;
	}
	var transitions = 0;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] != g.res[i + 1] {
			transitions++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = transitions;
	out.s.clear();
	format(out.s, "found ", transitions, " adjacent transitions");
	out
}
@end
