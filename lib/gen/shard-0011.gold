code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${limit};
	var running = 0;
	var count = 0;
	for i in g.n {
		if running + g.res[i] > ceil {
			break;
		}
		g.res[i] = g.res[i] * 2;
		running += g.res[i];
		count++;
	}
	g.steps += count + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "mapped ", count, " items with total budget ", running);
	out
}
@end
