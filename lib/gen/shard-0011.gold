test: list=-5,1,20
expect: => i=1 r=0.0 ok=false s="prefix scan detected negative code" errors=1 n=3 res=[-5,1,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let prefix_len = (g.n + 1) / 2;
	var found_neg = false;
	var i = 0;
	while i < prefix_len {
		if g.res[i] < 0 {
			found_neg = true;
			gold_fail(g, "negative item in prefix alternate scan");
			out.ok = false;
			break;
		}
		i += 2;
	}
	g.steps += prefix_len;
	out.i = if found_neg { 1 } else { 0 };
	out.s.clear();
	if found_neg {
		format(out.s, "prefix scan detected negative code");
	} else {
		format(out.s, "prefix scan clean");
	}
	out
}
@end
