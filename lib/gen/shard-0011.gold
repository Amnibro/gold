phrase: retain sorted suffix exceeding {pivot}
slot: pivot int
test: list=1,3,5,8,10 pivot=4
expect: => i=3 r=0.0 ok=true s="kept suffix of 3 elements" errors=0 n=3 res=[5,8,10] cache=0 hits=0
test: list=2,4,6 pivot=1
expect: => i=3 r=0.0 ok=true s="kept suffix of 3 elements" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var start_idx = 0;
	while start_idx < g.n && g.res[start_idx] <= p {
		start_idx++;
	}
	let kept = g.n - start_idx;
	for i in kept {
		g.res[i] = g.res[start_idx + i];
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept suffix of ", kept, " elements");
	out
}
@end
@entry 2637df132d0a739a
kind: step
verb: count
noun: gaps
modifier: nested
context: sort
phrase: count nested gaps exceeding {min_gap}
phrase: tally nested gap pairs above {min_gap}
slot: min_gap int
test: list=1,3,6,10 min_gap=4
expect: => i=4 r=0.0 ok=true s="counted 4 nested gaps" errors=0 n=4 res=[1,3,6,10] cache=0 hits=0
test: list=2,4,7 min_gap=2
expect: => i=3 r=0.0 ok=true s="counted 3 nested gaps" errors=0 n=3 res=[2,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var tally = 0;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[j] - g.res[i] >= mg {
					tally++;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = tally;
	out.s.clear();
	format(out.s, "counted ", tally, " nested gaps");
	out
}
@end
