phrase: limit values to ceiling {bound} within retries {attempts}
slot: bound int
slot: attempts int
test: list=12,25,8,40 bound=20 attempts=3
expect: => i=2 r=0.0 ok=true s="clamped 2 items to bound 20" errors=0 n=4 res=[12,20,8,20] cache=0 hits=0
test: list=5,15,35,50 bound=30 attempts=2
expect: => i=2 r=0.0 ok=true s="clamped 2 items to bound 30" errors=0 n=4 res=[5,15,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let b = ${bound};
	let att = ${attempts};
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for bound limit");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	var i = 0;
	while i < g.n && i < att * 10 {
		if g.res[i] > b {
			g.res[i] = b;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " items to bound ", b);
	out
}
@end
