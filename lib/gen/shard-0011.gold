@entry 534d5b0ed675f6b3
kind: step
verb: check
noun: maximum
modifier: at_least
context: loop
phrase: check maximum value is at least {threshold}
phrase: verify peak element reaches {threshold}
slot: threshold int
test: list=5,12,8 threshold=10
expect: => i=12 r=0.0 ok=true s="maximum 12 reaches threshold 10" errors=0 n=3 res=[5,12,8] cache=0 hits=0
test: list=1,2,3 threshold=10
expect: => i=3 r=0.0 ok=false s="maximum 3 below threshold 10" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let th = ${threshold};
	let reached = max_val >= th;
	g.steps += g.n;
	out.ok = reached;
	out.i = max_val;
	out.s.clear();
	if reached {
		format(out.s, "maximum ", max_val, " reaches threshold ", th);
	} else {
		format(out.s, "maximum ", max_val, " below threshold ", th);
	}
	out
}
@end
