fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo_idx};
	let hi_bound = ${hi_idx};
	let hi = if hi_bound < g.n { hi_bound } else { g.n };
	if lo < hi {
		let span = hi - lo;
		for i in span {
			for j in 0..(span - 1 - i) {
				let idx = lo + j;
				if g.res[idx] > g.res[idx + 1] {
					let tmp = g.res[idx];
					g.res[idx] = g.res[idx + 1];
					g.res[idx + 1] = tmp;
				}
			}
		}
		out.i = span;
	} else {
		out.i = 0;
	}
	g.steps += out.i;
	out.s.clear();
	format(out.s, "sorted range span=", out.i);
	out
}
@end
