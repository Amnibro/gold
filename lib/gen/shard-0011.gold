fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let f = ${factor};
	var streaks int[>..] = [];
	var cur_val = g.res[0];
	var count = 1;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			count++;
		} else {
			streaks.push(count * f);
			cur_val = g.res[i];
			count = 1;
		}
	}
	streaks.push(count * f);
	for i in streaks.len {
		g.res[i] = streaks[i];
	}
	g.n = streaks.len;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " streaks by factor");
	out
}
