test: list=10,20 retries=1
expect: => i=0 r=0.0 ok=true s="sorted error codes with 0 swaps" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.n == 0 {
		gold_fail(g, "empty error list");
		out.ok = false;
		return out;
	}
	var swaps = 0;
	for pass in r {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted error codes with ", swaps, " swaps");
	out
}
@end
@entry 534d512933eeb966
kind: step
verb: map
noun: runs
modifier: with_retry
context: error
phrase: map error runs with retry count {retries}
phrase: compress consecutive errors with {retries} retries
slot: retries int
test: list=10,10,10,20,30 retries=2
expect: => i=3 r=0.0 ok=false s="mapped to 3 distinct runs" errors=1 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,6,7 retries=3
expect: => i=3 r=0.0 ok=true s="mapped to 3 distinct runs" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	if g.n < 2 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "insufficient elements for runs");
		return out;
	}
	var kept = 1;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
			if cur_run > max_r {
				gold_fail(g, "run length exceeded retry limit");
				out.ok = false;
			}
		} else {
			cur_run = 1;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "mapped to ", kept, " distinct runs");
	out
}
@end
