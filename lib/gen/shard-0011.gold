fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var bumped = 0;
	for k in g.n {
		var tries = 0;
		while g.res[k] < cap && tries < 3 {
			g.res[k] += 2;
			tries++;
			bumped++;
		}
	}
	g.steps += g.n * 3;
	out.i = bumped;
	out.s.clear();
	format(out.s, "retried elevating items count ", bumped);
	out
}
