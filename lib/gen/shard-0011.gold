code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_rev = ${limit};
	var indices int[>..] = [];
	for k in g.n {
		if ${cond}(g.res[k]) && indices.len < max_rev {
			indices.push(k);
		}
	}
	var left = 0;
	var right = indices.len - 1;
	while left < right {
		let l_idx = indices[left];
		let r_idx = indices[right];
		let tmp = g.res[l_idx];
		g.res[l_idx] = g.res[r_idx];
		g.res[r_idx] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + indices.len;
	out.i = indices.len;
	out.s.clear();
	format(out.s, "reversed ", indices.len, " matching items");
	out
}
@end
@entry 55aa03591bba09b7
kind: step
verb: check
noun: checkpoint
modifier: in_reverse
context: aggregate
phrase: check checkpoint values in reverse against threshold {thresh}
phrase: validate checkpoints in reverse order with target {thresh}
slot: thresh int
test: list=10,20,30 thresh=5
expect: => i=1 r=0.0 ok=true s="checked checkpoints in reverse true" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,2,-5 thresh=0
expect: => i=0 r=0.0 ok=false s="checked checkpoints in reverse false" errors=1 n=3 res=[10,2,-5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var all_ok = true;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] < limit {
			all_ok = false;
			gold_fail(g, "checkpoint below threshold");
			break;
		}
		k--;
	}
	g.steps += g.n;
	out.ok = all_ok;
	out.i = if all_ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked checkpoints in reverse ", all_ok);
	out
}
@end
