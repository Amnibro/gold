code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let cap_val = ${max_val};
	let last_idx = g.n - 1;
	var clamped = false;
	if g.res[last_idx] > cap_val {
		g.res[last_idx] = cap_val;
		clamped = true;
	}
	g.steps += 1;
	out.ok = clamped;
	out.i = g.res[last_idx];
	out.s.clear();
	format(out.s, "last value clamped: ", clamped);
	out
}
@end
@entry c7b5ee7e63fbb52c
kind: step
verb: scale
noun: spaces
modifier: unique
context: stats
phrase: scale unique sample values by factor {factor}
phrase: multiply distinct elements in sample by {factor}
slot: factor int
test: list=2,2,3,3 factor=3
expect: => i=4 r=0.0 ok=true s="scaled 4 unique values" errors=0 n=4 res=[6,6,9,9] cache=0 hits=0
test: list=5,5,5 factor=2
expect: => i=3 r=0.0 ok=true s="scaled 3 unique values" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var is_first = true;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { is_first = false; break; }
			j++;
		}
		if is_first {
			g.res[unique_count] = g.res[i] * mult;
			unique_count++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	g.n = unique_count;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "scaled ", unique_count, " unique values");
	out
}
@end
