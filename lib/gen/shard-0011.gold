@entry bc423fe9e18ef6e9
kind: step
verb: swap
noun: threshold
modifier: recursively
context: list
phrase: swap list values around threshold {thresh} recursively
phrase: recursively partition list items above threshold {thresh}
slot: thresh int
test: list=8,3,9,1,7,2 thresh=5
expect: => i=2 r=0.0 ok=true s="threshold swaps count 2" errors=0 n=6 res=[2,3,1,9,7,8] cache=0 hits=0
test: list=20,5,15,30,10 thresh=12
expect: => i=1 r=0.0 ok=true s="threshold swaps count 1" errors=0 n=5 res=[10,5,15,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pivot = ${thresh};
	var lo = 0;
	var hi = g.n - 1;
	var swaps = 0;
	while lo < hi {
		while lo < hi && g.res[lo] <= pivot { lo++; }
		while lo < hi && g.res[hi] > pivot { hi--; }
		if lo < hi {
			let t = g.res[lo];
			g.res[lo] = g.res[hi];
			g.res[hi] = t;
			swaps++;
			lo++;
			hi--;
		}
	}
	g.steps += g.n;
