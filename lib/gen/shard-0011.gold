code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${bound};
	for i in g.n {
		var res = ${f}(g.res[i]);
		if res > lim { res = lim; }
		if res < -lim { res = -lim; }
		g.res[i] = res;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped function safely total ", g.n);
	out
}
@end
