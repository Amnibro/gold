fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = g.n / 2;
	let len = g.n - start;
	for i in len / 2 {
		let j = len - 1 - i;
		let t = g.res[start + i];
		g.res[start + i] = g.res[start + j];
		g.res[start + j] = t;
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "reversed suffix of ", len, " error values");
	out
}
