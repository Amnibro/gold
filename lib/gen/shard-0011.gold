fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	if len == 0 {
		gold_fail(g, "empty text string");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "scanned 0 words");
		return out;
	}
	var word_count = 0;
	var in_word = false;
	for i in len {
		let c = out.s[i];
		if c != ' ' && c != '\t' && c != '\n' {
			if !in_word {
				word_count++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	g.steps += len;
	out.i = word_count;
	out.s.clear();
	format(out.s, "scanned ", word_count, " words");
	out
}
