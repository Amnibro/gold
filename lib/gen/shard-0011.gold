fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${minimum};
	var kept int[>..] = [];
	for i in g.n {
		if g.res[i] >= min_v {
			kept.push(g.res[i]);
		}
	}
	for i in kept.len {
		for j in (i + 1)..kept.len {
			if kept[j] < kept[i] {
				let tmp = kept[i];
				kept[i] = kept[j];
				kept[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n + kept.len;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "sorted checkpoints ", kept.len);
	out
}
@end
