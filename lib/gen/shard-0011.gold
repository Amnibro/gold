fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	if min_idx > 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[min_idx];
		g.res[min_idx] = tmp;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "minimum in place ", g.res[0]);
	out
}
@end
