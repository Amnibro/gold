expect: => i=5 r=0.0 ok=true s="mapped 5 numbers with cache" errors=0 n=5 res=[7,9,7,9,11] cache=3 hits=2
test: list=1,1,2,2
expect: => i=4 r=0.0 ok=true s="mapped 4 numbers with cache" errors=0 n=4 res=[3,3,5,5] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let res_val = x * 2 + 1;
			gold_cache_put(g, x, res_val);
			g.res[i] = res_val;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped ", g.n, " numbers with cache");
	out
}
@end
