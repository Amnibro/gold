expect: => i=1 r=0.0 ok=true s="function clamped count 1" errors=0 n=3 res=[5,6,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_c = ${max_clamps};
	let ceiling_val = ${cap};
	var clamps = 0;
	for k in g.n {
		let transformed = ${f}(g.res[k]);
		if transformed > ceiling_val && clamps < max_c {
			g.res[k] = ceiling_val;
			clamps++;
		} else {
			g.res[k] = transformed;
		}
	}
	g.steps += g.n;
	out.i = clamps;
	out.s.clear();
	format(out.s, "function clamped count ", clamps);
	out
}
@end
