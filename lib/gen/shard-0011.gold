code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let a = g.res[i];
			let b = g.res[i + 1];
			if a * a > b * b {
				g.res[i] = b;
				g.res[i + 1] = a;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " squares");
	out
}
@end
