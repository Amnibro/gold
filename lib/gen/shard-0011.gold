fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var scaled = 0;
	var i = 0;
	while i < g.n && scaled < limit {
		g.res[i] = g.res[i] / 2;
		scaled++;
		i += 2;
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "normalized even indexed samples count ", scaled);
	out
}
@end
