fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let s_len = out.s.len;
	var start = s_len - k;
	if start < 0 { start = 0; }
	var buf byte[>..] = [];
	for i in start..s_len {
		buf.push(out.s[i]);
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = buf.len;
	g.steps += buf.len;
	out
}
@end
