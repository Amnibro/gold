		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	var min_val = g.res[min_idx];
	while min_val * 2 <= limit {
		min_val = min_val * 2;
	}
	g.res[min_idx] = min_val;
	out.i = min_val;
	out.s.clear();
	format(out.s, "scaled min: ", min_val);
	g.steps += g.n;
	out
}
@end
