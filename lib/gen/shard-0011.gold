fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			total += g.res[i];
			if i == 0 { break; }
			i--;
		}
	}
	gold_clear(g);
	gold_push(g, total);
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "merged cache in reverse: ", total);
	out
}
