code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var idxs int[>..] = [];
	for i in out.s.len {
		if (out.s[i] as! int) % 2 == 0 && idxs.len < lim {
			idxs.push(i);
		}
	}
	var a = 0;
	var b = idxs.len - 1;
	while a < b {
		let ia = idxs[a];
		let ib = idxs[b];
		let t = out.s[ia];
		out.s[ia] = out.s[ib];
		out.s[ib] = t;
		a++;
		b--;
	}
	g.steps += idxs.len;
	out.i = idxs.len;
	out
}
@end
