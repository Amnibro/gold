code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var first_time = true;
		for j in i {
			if g.res[j] == g.res[i] { first_time = false; break; }
		}
		if first_time { unique_count++; }
	}
	g.steps += g.n * g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique values count ", unique_count);
	out
}
@end
@entry 3032f37d71bae451
kind: step
verb: reverse
noun: threshold
modifier: until
context: search
phrase: reverse search items until hitting threshold {thresh}
phrase: invert element order until encountering value {thresh}
slot: thresh int
test: list=1,2,3,10,5 thresh=10
expect: => i=3 r=0.0 ok=true s="reversed prefix length 3" errors=0 n=5 res=[3,2,1,10,5] cache=0 hits=0
test: list=2,4,6,8 thresh=6
expect: => i=2 r=0.0 ok=true s="reversed prefix length 2" errors=0 n=4 res=[4,2,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${thresh};
	var stop_idx = g.n;
	for k in g.n {
		if g.res[k] >= lim { stop_idx = k; break; }
	}
	var a = 0;
	var b = stop_idx - 1;
	while a < b {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		a++;
		b--;
	}
	g.steps += g.n;
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "reversed prefix length ", stop_idx);
	out
}
@end
