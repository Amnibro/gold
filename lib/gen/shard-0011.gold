phrase: compute recursive digital root sum
test: list=45,99
expect: => i=9 r=0.0 ok=true s="reduced recursive digit sum to 9" errors=0 n=2 res=[45,99] cache=0 hits=0
test: list=12,34
expect: => i=1 r=0.0 ok=true s="reduced recursive digit sum to 1" errors=0 n=2 res=[12,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n { total += g.res[i]; }
	if total < 0 { total = -total; }
	while total >= 10 {
		var s = 0;
		while total > 0 {
			s += total % 10;
			total /= 10;
		}
		total = s;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "reduced recursive digit sum to ", total);
	out
}
@end
