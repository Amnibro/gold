fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted int[>..] = [];
	for i in g.n { sorted.push(g.res[i]); }
	for i in sorted.len {
		for j in (i + 1)..sorted.len {
			if sorted[j] < sorted[i] {
				let tmp = sorted[i];
				sorted[i] = sorted[j];
				sorted[j] = tmp;
			}
		}
	}
	for i in g.n {
		let x = g.res[i];
		var rk = 0;
		for j in sorted.len {
			if sorted[j] == x { rk = j; break; }
		}
		g.res[i] = rk;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items");
	out
}
