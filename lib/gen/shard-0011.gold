@entry 605e4a53a98b804d
kind: step
verb: find
noun: cache
modifier: at_least
context: format
phrase: find frequent values appearing at least {min_freq} times formatting cache
phrase: format cached entries occurring at least {min_freq} times
slot: min_freq int
test: list=1,2,2,3,3,3 min_freq=2
expect: => i=2 r=0.0 ok=true s="cached_frequent: [2, 3]" errors=0 n=6 res=[1,2,2,3,3,3] cache=2 hits=0
test: list=5,5,5,10,10,20 min_freq=3
expect: => i=1 r=0.0 ok=true s="cached_frequent: [5]" errors=0 n=6 res=[5,5,5,10,10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_freq};
	out.s.clear();
	out.s.append("cached_frequent: [");
	var seen int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq >= limit {
			var is_seen = false;
			for k in count { if seen[k] == x { is_seen = true; break; } }
			if !is_seen {
				seen[count] = x;
				gold_cache_put(g, count, x);
				if count > 0 { out.s.append(", "); }
				format(out.s, x);
				count++;
			}
		}
	}
	out.s.append("]");
	g.steps += g.n;
	out.i = count;
	out
}
@end
