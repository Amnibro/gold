test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="counted 0 head inversions" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	var inversions = 0;
	if half > 1 {
		for i in half {
			for j in (i + 1)..half {
				if g.res[i] > g.res[j] {
					inversions++;
				}
			}
		}
	}
	if inversions > 0 {
		gold_fail(g, "out of order error head detected");
	}
	g.steps += half * half;
	out.i = inversions;
	out.s.clear();
	format(out.s, "counted ", inversions, " head inversions");
	out
}
@end
