	let cap_val = ${limit};
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let take = if cap_val > g.cn { g.cn } else if cap_val < 0 { 0 } else { cap_val };
	for i in take {
		gold_push(g, g.cv[i]);
	}
	out.i = take;
	out.s.clear();
	format(out.s, "merged cache: ", take);
	g.steps += g.cn + take;
	out
}
@end
