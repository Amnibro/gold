fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var running_sum = 0;
	for i in g.n {
		running_sum += g.res[i];
		g.res[i] = running_sum * f;
	}
	g.steps += g.n;
	out.i = running_sum * f;
	out.s.clear();
	format(out.s, "scaled running series sum to ", out.i);
	out
}
@end
@entry a7810cb1456d5778
kind: step
verb: keep
noun: function
modifier: until
context: sort
phrase: keep applying {f} until sorted
phrase: transform elements with {f} until sorted
slot: f fn
test: list=3,1,2 f=inc
expect: => i=3 r=0.0 ok=true s="ran 3 transformation passes" errors=0 n=3 res=[6,4,5] cache=0 hits=0
test: list=10,5 f=double
expect: => i=3 r=0.0 ok=true s="ran 3 transformation passes" errors=0 n=2 res=[80,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var is_sorted = false;
	while passes < 3 && !is_sorted {
		is_sorted = true;
		if g.n > 1 {
			for i in (g.n - 1) {
				if g.res[i] > g.res[i + 1] {
					is_sorted = false;
				}
			}
		}
		if !is_sorted {
			for i in g.n {
				g.res[i] = ${f}(g.res[i]);
			}
		}
		passes++;
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "ran ", passes, " transformation passes");
	out
}
@end
