				g.res[k] = cap;
				clamped_total++;
			}
		}
		p++;
	}
	g.steps += p_total * g.n;
	out.i = clamped_total;
	out.s.clear();
	format(out.s, "numbers clamped over passes ", clamped_total);
	out
}
@end
