slot: low int
slot: high int
test: list=1,2,25 low=20 high=30
expect: => i=25 r=0.0 ok=true s="tail value 25 within bounds" errors=0 n=3 res=[1,2,25] cache=0 hits=0
test: list=1,2,5 low=20 high=30
expect: => i=5 r=0.0 ok=false s="tail value 5 outside bounds" errors=1 n=3 res=[1,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n == 0 {
		gold_fail(g, "empty list for tail scan");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	let in_range = (last >= lo && last <= hi);
	if !in_range {
		gold_fail(g, "tail element outside bounds");
		out.ok = false;
	}
	g.steps += 1;
	out.i = last;
	out.s.clear();
	if in_range {
		format(out.s, "tail value ", last, " within bounds");
	} else {
		format(out.s, "tail value ", last, " outside bounds");
	}
	out
}
@end
