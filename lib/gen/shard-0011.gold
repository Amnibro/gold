	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${p}(g.res[i]) && !${p}(g.res[i + 1]) {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
