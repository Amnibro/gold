@entry 25eafaf4e77b709c
kind: step
verb: sort
noun: suffix
modifier: at_least
context: loop
phrase: sort loop suffix having length at least {min_len}
phrase: order trailing loop elements of size at least {min_len}
slot: min_len int
test: list=10,9,8,7,6 min_len=3
expect: => i=3 r=0.0 ok=true s="sorted suffix elements 3" errors=0 n=5 res=[10,9,6,7,8] cache=0 hits=0
test: list=5,4,3,2,1 min_len=4
expect: => i=4 r=0.0 ok=true s="sorted suffix elements 4" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	if g.n >= req && req > 0 {
		let start = g.n - req;
		var i = start;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[j] < g.res[i] {
					let t = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = t;
				}
				j++;
			}
			i++;
		}
		g.steps += req;
		out.i = req;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "sorted suffix elements ", out.i);
	out
}
@end
