@entry 376f7238ac87ff11
kind: step
verb: rank
noun: squares
modifier: recursively
context: retry
phrase: rank retry squares recursively with decay {decay}
phrase: recursively compute squared retry ranks with factor {decay}
slot: decay int
test: list=2,3,4 decay=2
expect: => i=12 r=0.0 ok=true s="recursive square rank 12" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=1,2,3 decay=3
expect: => i=3 r=0.0 ok=true s="recursive square rank 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dec_val = ${decay};
	if dec_val <= 0 {
		gold_fail(g, "decay non positive");
		out.ok = false;
		return out;
	}
	var rank_score = 0;
	var weight = 1;
	for k in g.n {
		let sq = g.res[k] * g.res[k];
		rank_score += sq / weight;
		weight *= dec_val;
	}
	g.steps += g.n;
	out.i = rank_score;
	out.s.clear();
	format(out.s, "recursive square rank ", rank_score);
	out
}
@end
@entry d4bd2523dd85520c
