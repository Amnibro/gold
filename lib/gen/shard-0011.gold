fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	let diff = g.res[g.n - 1] - g.res[g.n - 2];
	gold_push(g, diff);
	out.i = diff;
	g.steps += 1;
	out.s.clear();
	format(out.s, "last step diff ", diff);
	out
}
@end
@entry 226dbe5d89b17e68
kind: step
verb: dedupe
noun: streak
modifier: last
context: search
phrase: dedupe trailing streak of identical search hits
phrase: collapse repeated values at end of search list
test: list=1,2,3,3,3
expect: => i=2 r=0.0 ok=true s="removed 2 streak items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,5,5,5,5
expect: => i=3 r=0.0 ok=true s="removed 3 streak items" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let last_val = g.res[g.n - 1];
	var count = 0;
	while g.n > 1 && g.res[g.n - 2] == last_val {
		g.n--;
		count++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "removed ", count, " streak items");
	out
}
@end
