fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			hits++;
		} else {
			gold_cache_put(g, k, 1);
		}
	}
	g.steps += g.n;
	out.ok = hits > 0;
	out.i = hits;
	out.s.clear();
	format(out.s, "checked series finding ", hits, " cache hits");
	out
}
@end
