code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cutoff = g.n;
	for k in g.n {
		if ${cond}(g.res[k]) { cutoff = k; break; }
	}
	var i = 0;
	while i < cutoff {
		var j = i + 1;
		while j < cutoff {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += cutoff;
	out.i = cutoff;
	out.s.clear();
	format(out.s, "sorted prefix length ", cutoff);
	out
}
@end
