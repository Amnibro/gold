expect: => i=0 r=0.0 ok=false s="suffix order validity false" errors=1 n=4 res=[5,10,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let actual = if sp < g.n { sp } else { g.n };
	let start = g.n - actual;
	var ok_order = true;
	var i = start;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			ok_order = false;
			gold_fail(g, "suffix inversion detected");
			break;
		}
		i++;
	}
	g.steps += actual;
	out.ok = ok_order;
	out.i = if ok_order { 1 } else { 0 };
	out.s.clear();
	format(out.s, "suffix order validity ", ok_order);
	out
}
@end
