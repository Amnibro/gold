@entry 197c89c97c12894f
kind: step
verb: validate
noun: threshold
modifier: up_to
context: search
phrase: validate search results stay under ceiling up to index {ceiling} {limit}
phrase: verify items meet threshold up to bound {ceiling} {limit}
slot: ceiling int
slot: limit int
test: list=5,12,18,90 ceiling=20 limit=3
expect: => i=1 r=0.0 ok=true s="threshold validity true" errors=0 n=4 res=[5,12,18,90] cache=0 hits=0
test: list=25,30,35 ceiling=20 limit=2
expect: => i=0 r=0.0 ok=false s="threshold validity false" errors=0 n=3 res=[25,30,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	let lim = ${limit};
	var valid = true;
	var bound = lim;
	if bound > g.n { bound = g.n; }
	for i in bound {
		if g.res[i] > ceil {
			valid = false;
			break;
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += bound;
	out.s.clear();
	format(out.s, "threshold validity ", valid);
	out
}
@end
@entry 2c0662b7bc04aa04
kind: step
verb: rotate
noun: text
modifier: recursively
context: search
phrase: rotate query text characters by offset recursively {shift}
phrase: shift search pattern letters cyclically {shift}
slot: shift int
test: text="search" shift=2
expect: => i=2 r=0.0 ok=true s="archse" errors=0 n=0 res=[] cache=0 hits=0
test: text="query" shift=1
expect: => i=1 r=0.0 ok=true s="ueryq" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_len = out.s.len;
	if s_len <= 1 { return out; }
	var k = ${shift} % s_len;
	if k < 0 { k += s_len; }
	var buf byte[>..] = [];
	for i in k..s_len { buf.push(out.s[i]); }
	for i in k { buf.push(out.s[i]); }
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += s_len;
	out.i = k;
	out
}
@end
