noun: gaps
modifier: sorted
context: math
phrase: sort consecutive gaps in ascending order
phrase: order absolute differences into sorted gaps
test: list=10,2,15,3
expect: => i=3 r=0.0 ok=true s="sorted 3 gaps" errors=0 n=3 res=[8,12,13] cache=0 hits=0
test: list=1,8,2,9,5
expect: => i=4 r=0.0 ok=true s="sorted 4 gaps" errors=0 n=4 res=[4,6,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two elements for gaps");
		out.ok = false;
		return out;
	}
	let gap_count = g.n - 1;
	var gaps int[512] = [0; 512];
	for i in gap_count {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		gaps[i] = diff;
	}
	for i in gap_count {
		for j in (i + 1)..gap_count {
			if gaps[j] < gaps[i] {
				let tmp = gaps[i];
				gaps[i] = gaps[j];
				gaps[j] = tmp;
			}
		}
	}
	for i in gap_count {
		g.res[i] = gaps[i];
	}
	g.n = gap_count;
	g.steps += gap_count;
	out.i = gap_count;
	out.s.clear();
	format(out.s, "sorted ", gap_count, " gaps");
	out
}
@end
