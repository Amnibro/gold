@entry 4211dcf63f3d15ec
kind: step
verb: swap
noun: items
modifier: all
context: filter
phrase: swap all items across pivot {piv}
phrase: exchange elements matching filter pivot {piv}
slot: piv int
test: list=10,3,8,2,7 piv=5
expect: => i=1 r=0.0 ok=true s="swapped 1 items across pivot" errors=0 n=5 res=[2,3,8,10,7] cache=0 hits=0
test: list=1,9,2,8,3 piv=4
expect: => i=1 r=0.0 ok=true s="swapped 1 items across pivot" errors=0 n=5 res=[1,3,2,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${piv};
	var left = 0;
	var right = g.n - 1;
	var swaps = 0;
	while left < right {
		while left < right && g.res[left] <= p {
			left++;
		}
		while left < right && g.res[right] > p {
			right--;
		}
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			swaps++;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " items across pivot");
	out
}
@end
@entry 5dd50fb48392884f
kind: step
verb: check
noun: head
modifier: unique
context: filter
phrase: check unique elements in list head of size {n}
phrase: verify distinct items within leading prefix {n}
slot: n int
test: list=1,2,3,4,2,5 n=4
expect: => i=4 r=0.0 ok=true s="head prefix of 4 items is unique" errors=0 n=6 res=[1,2,3,4,2,5] cache=0 hits=0
test: list=7,7,8,9,10 n=3
expect: => i=3 r=0.0 ok=false s="head prefix of 3 items contains duplicates" errors=0 n=5 res=[7,7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${n} < g.n { ${n} } else { g.n };
	var is_uniq = true;
	if limit > 1 {
		for i in limit {
			for j in i {
				if g.res[i] == g.res[j] {
					is_uniq = false;
					break;
				}
			}
			if !is_uniq { break; }
		}
	}
	g.steps += limit;
	out.ok = is_uniq;
	out.i = limit;
	out.s.clear();
	if is_uniq {
		format(out.s, "head prefix of ", limit, " items is unique");
	} else {
		format(out.s, "head prefix of ", limit, " items contains duplicates");
	}
	out
}
@end
@entry b4b903fcea3a05d6
kind: step
verb: merge
noun: checkpoint
modifier: between
context: filter
phrase: merge checkpoint elements between bounds {low} through {high}
phrase: combine checkpoint items bounded by range {low} to {high}
slot: low int
slot: high int
test: list=5,15,25,35,45 low=10 high=40
expect: => i=3 r=0.0 ok=true s="merged 3 checkpoint values into sum 75" errors=0 n=3 res=[5,45,75] cache=0 hits=0
test: list=2,4,6,8,10 low=3 high=9
expect: => i=3 r=0.0 ok=true s="merged 3 checkpoint values into sum 18" errors=0 n=3 res=[2,10,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sum = 0;
	var count = 0;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			sum += x;
			count++;
		} else {
			kept.push(x);
		}
	}
	kept.push(sum);
	g.n = 0;
	for i in kept.len {
		g.res[g.n] = kept[i];
		g.n++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "merged ", count, " checkpoint values into sum ", sum);
	out
}
@end
@entry 679949fd4fb2ab06
kind: step
verb: reverse
noun: series
modifier: times
context: filter
phrase: reverse filtered series repeat {count} times
phrase: invert series sequence iteratively {count} cycles
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="reversed series 3 times" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
test: list=1,3,5,7 count=2
expect: => i=2 r=0.0 ok=true s="reversed series 2 times" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cycles = if ${count} > 0 { ${count} } else { 1 };
	for c in cycles {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n * cycles;
	out.i = cycles;
	out.s.clear();
	format(out.s, "reversed series ", cycles, " times");
	out
}
@end
