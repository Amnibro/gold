@entry be0c0f30eafd1da7
kind: step
verb: drop
noun: runs
modifier: with_cache
context: cache
phrase: drop duplicate runs using cache lookup table
phrase: prune repeated value runs with cache verification
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="dropped runs with cache count 3" errors=0 n=3 res=[1,2,3] cache=3 hits=3
test: list=5,5,10,15,15
expect: => i=2 r=0.0 ok=true s="dropped runs with cache count 2" errors=0 n=3 res=[5,10,15] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var kn = 0;
	var kept int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		if hit {
			dropped++;
		} else {
			gold_cache_put(g, x, 1);
			kept[kn] = x;
			kn++;
		}
	}
	for i in kn { g.res[i] = kept[i]; }
	g.n = kn;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped runs with cache count ", dropped);
	out
}
@end
