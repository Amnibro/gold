@entry 0f5f03e8b631fb7f
kind: step
verb: limit
noun: history
modifier: recursively
context: aggregate
phrase: limit history recursion depth to {depth_limit} steps
phrase: aggregate historical differences recursively within {depth_limit}
slot: depth_limit int
test: list=10,20,40,80 depth_limit=2
expect: => i=30 r=0.0 ok=true s="recursive history total: 30" errors=0 n=4 res=[10,20,40,80] cache=0 hits=0
test: list=5,15,30,50 depth_limit=1
expect: => i=45 r=0.0 ok=true s="recursive history total: 45" errors=0 n=4 res=[5,15,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth_limit};
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[i]; }
	var len = g.n;
	var d = 0;
	while d < max_d && len > 1 {
		for i in (len - 1) {
			temp[i] = temp[i + 1] - temp[i];
		}
		len--;
		d++;
	}
	var total = 0;
	for i in len { total += temp[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "recursive history total: ", total);
	out
}
@end
@entry 005c7b6635ed05e8
kind: step
verb: normalize
noun: loop
modifier: recursively
context: aggregate
phrase: normalize loop recursively reducing elements through iterations
phrase: aggregate sequence through recursive normalization loop
test: list=12,24,36,48
expect: => i=12 r=0.0 ok=true s="recursive common divisor: 12" errors=0 n=4 res=[12,24,36,48] cache=0 hits=0
test: list=15,25,35,45
expect: => i=5 r=0.0 ok=true s="recursive common divisor: 5" errors=0 n=4 res=[15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var res = g.res[0];
	for i in 1..g.n {
		var a = res;
		var b = g.res[i];
		while b != 0 {
			let rem = a % b;
			a = b;
			b = rem;
		}
		res = a;
	}
	g.steps += g.n;
	out.i = res;
	out.s.clear();
	format(out.s, "recursive common divisor: ", res);
	out
}
@end
