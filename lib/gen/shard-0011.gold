phrase: check middle observation exceeds threshold {floor}
slot: floor int
test: list=10,20,30,40,50 floor=25
expect: => i=30 r=0.0 ok=true s="middle value 30 valid: true" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
