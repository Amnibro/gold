fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var passes = 0;
	while passes < r {
		let lim = if g.n < 2 { g.n } else { 2 };
		for i in lim {
			g.res[i] = g.res[i] / 2;
		}
		passes++;
	}
	g.steps += g.n * r;
	out.i = passes;
	out.s.clear();
	format(out.s, "applied prefix reduction rounds ", passes);
	out
}
@end
