code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] <= 0 { break; }
		if g.res[i] < min_val { min_val = g.res[i]; }
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = min_val;
	out.s.clear();
	format(out.s, "found positive minimum ", min_val, " across ", count, " items");
	out
}
@end
@entry 7b069e1adfdc707c
kind: step
verb: validate
noun: primes
modifier: with_cache
context: math
phrase: validate sequence primes using cached checks
phrase: verify all elements are prime with cache
test: list=2,3,5,7,11
expect: => i=5 r=0.0 ok=true s="all 5 elements validated as primes" errors=0 n=5 res=[2,3,5,7,11] cache=5 hits=0
test: list=3,5,9,11
expect: => i=4 r=0.0 ok=false s="non-prime element detected in sequence" errors=0 n=4 res=[3,5,9,11] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_primes = true;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; } else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		gold_cache_put(g, x, if is_p { 1 } else { 0 });
		if !is_p { all_primes = false; }
	}
	g.steps += g.n;
	out.ok = all_primes;
	out.i = g.n;
	out.s.clear();
	if all_primes {
		format(out.s, "all ", g.n, " elements validated as primes");
	} else {
		format(out.s, "non-prime element detected in sequence");
	}
	out
}
@end
