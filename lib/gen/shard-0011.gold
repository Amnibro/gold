code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var indices int[>..] = [];
	for i in g.n {
		if g.res[i] > lim {
			indices.push(i);
		}
	}
	var l = 0;
	var r = indices.len - 1;
	while l < r {
		let idx_l = indices[l];
		let idx_r = indices[r];
		let tmp = g.res[idx_l];
		g.res[idx_l] = g.res[idx_r];
		g.res[idx_r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n;
	out.i = indices.len;
	out.s.clear();
	format(out.s, "reversed ", indices.len, " running items exceeding threshold");
	out
}
@end
