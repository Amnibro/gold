code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${index};
	if idx <= 0 || idx > g.n {
		gold_fail(g, "index bound out of range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid sort index");
		return out;
	}
	for i in idx {
		for j in (i + 1)..idx {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += idx * idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "sorted prefix length ", idx);
	out
}
@end
