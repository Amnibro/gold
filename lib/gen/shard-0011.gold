expect: => i=20 r=0.0 ok=true s="budget: 5 + 15 = 20" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget_cap};
	var total = 0;
	var count = 0;
	out.s.clear();
	out.s.append("budget: ");
	while count < g.n && total + g.res[count] <= cap {
		if count > 0 { out.s.append(" + "); }
		total += g.res[count];
		format(out.s, g.res[count]);
		count++;
	}
	format(out.s, " = ", total);
	g.steps += count;
	out.i = total;
	out
}
@end
