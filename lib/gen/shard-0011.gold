code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var streak_lens int[>..] = [];
	var cur_val = g.res[0];
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			streak_lens.push(cur_len);
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	streak_lens.push(cur_len);
	for i in streak_lens.len {
		g.res[i] = streak_lens[i];
	}
	g.n = streak_lens.len;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "compressed into ", g.n, " running streaks");
	out
}
@end
