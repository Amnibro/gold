fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k_items};
	let span = if k < g.n { k } else { g.n };
	let start = g.n - span;
	var w = 0;
	var i = start;
	while i < g.n {
		if ${check}(g.res[i]) {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	g.steps += span;
	out.i = w;
	out.s.clear();
	format(out.s, "filtered trailing window count ", w);
	out
}
@end
