fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 10, 1);
	gold_cache_put(g, 20, 1);
	gold_cache_put(g, 30, 1);
	var matched int[>..] = [];
	for i in g.n {
		let _, f = gold_cache_get(g, g.res[i]);
		if f { matched.push(g.res[i]); }
	}
	if matched.len == 0 {
		gold_fail(g, "no cached matches found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero cached matches");
		return out;
	}
	for i in matched.len {
		for j in (i + 1)..matched.len {
			if matched[j] < matched[i] {
				let tmp = matched[i];
				matched[i] = matched[j];
				matched[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in matched { gold_push(g, x); }
	g.steps += g.n + matched.len * matched.len;
	out.i = matched.len;
	out.s.clear();
	format(out.s, "sorted cached matches ", matched.len);
	out
}
@end
