@entry 95a62ea9c418da71
kind: step
verb: pair
noun: primes
modifier: unique
context: filter
phrase: pair unique prime numbers in sequence
phrase: combine distinct prime items into products
test: list=2,3,2,5,7
expect: => i=2 r=0.0 ok=true s="paired unique primes into 2 products" errors=0 n=2 res=[6,35] cache=0 hits=0
test: list=3,5,7,11,13
expect: => i=3 r=0.0 ok=true s="paired unique primes into 3 products" errors=0 n=3 res=[15,77,13] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	if n == 2 { return true; }
	if n % 2 == 0 { return false; }
	var d = 3;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 2;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			var seen = false;
			for j in primes.len {
				if primes[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				primes.push(x);
			}
		}
	}
	var new_n = 0;
	var i = 0;
	while i + 1 < primes.len {
		g.res[new_n] = primes[i] * primes[i + 1];
		new_n++;
		i += 2;
	}
	if i < primes.len {
		g.res[new_n] = primes[i];
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "paired unique primes into ", new_n, " products");
	out
}
@end
