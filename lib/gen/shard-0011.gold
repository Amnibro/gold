code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var positives = 0;
	for k in g.n {
		if g.res[k] > 0 { positives++; }
	}
	g.steps += g.n;
	out.i = positives;
	out.s.clear();
	format(out.s, "positive sequence items: ", positives);
	out
}
@end
@entry 019d1e6ba45ae245
kind: step
verb: merge
noun: runs
modifier: times
context: search
phrase: merge consecutive run lengths repeatedly {repeats} times
phrase: sum run lengths across repetition count {repeats}
slot: repeats int
test: list=1,1,2,2,2 repeats=2
expect: => i=4 r=0.0 ok=true s="runs multiplied: 4" errors=0 n=5 res=[1,1,2,2,2] cache=0 hits=0
test: list=5,5,6,6,6 repeats=3
expect: => i=6 r=0.0 ok=true s="runs multiplied: 6" errors=0 n=5 res=[5,5,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	var runs_count = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[i - 1] { runs_count++; }
		i++;
	}
	let total = runs_count * r;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "runs multiplied: ", total);
	out
}
@end
