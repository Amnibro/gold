@entry 86c67f11086ea39f
kind: step
verb: scale
noun: streak
modifier: at_least
context: retry
phrase: scale streak of identical items at least {streak_min}
phrase: multiply consecutive duplicate runs at least {streak_min}
slot: streak_min int
test: list=5,5,5,10 streak_min=3
expect: => i=3 r=0.0 ok=true s="scaled 3 streak items" errors=0 n=4 res=[10,10,10,10] cache=0 hits=0
test: list=1,2,3 streak_min=2
expect: => i=0 r=0.0 ok=true s="scaled 0 streak items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${streak_min};
	var scaled_count = 0;
	if g.n >= min_s {
		var cur_run = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
			} else {
				if cur_run >= min_s {
					for k in (i - cur_run)..i {
						g.res[k] *= 2;
						scaled_count++;
					}
				}
				cur_run = 1;
			}
		}
		if cur_run >= min_s {
			for k in (g.n - cur_run)..g.n {
				g.res[k] *= 2;
				scaled_count++;
			}
		}
	}
	g.steps += g.n;
	out.i = scaled_count;
	out.s.clear();
	format(out.s, "scaled ", scaled_count, " streak items");
	out
}
@end
