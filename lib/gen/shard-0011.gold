expect: => i=3 r=0.0 ok=true s="recursive value limit passes 3" errors=0 n=4 res=[20,45,53,57] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var done = false;
	while !done && passes < 3 {
		done = true;
		passes++;
		g.steps += g.n;
		for i in g.n {
			if g.res[i] > 50 {
				g.res[i] = (g.res[i] + 50) / 2;
				done = false;
			}
		}
	}
	out.i = passes;
	out.s.clear();
	format(out.s, "recursive value limit passes ", passes);
	out
}
@end
