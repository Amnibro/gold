modifier: first
context: error
phrase: rotate tail element to first position
phrase: move trailing value to head of results
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="moved tail to front 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10
expect: => i=0 r=0.0 ok=false s="error: list too small" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need multiple elements to rotate tail");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too small");
		return out;
	}
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = last;
	out.s.clear();
	format(out.s, "moved tail to front ", last);
	out
}
@end
