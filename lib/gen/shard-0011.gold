code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var shifted = 0;
	for i in g.n {
		let x = g.res[i];
		if x == 2 || x == 3 || x == 5 || x == 7 || x == 11 {
			if x < lim {
				g.res[i] = x + 1;
				shifted++;
			}
		}
	}
	if shifted == 0 {
		gold_fail(g, "no primes shifted under limit");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted prime error codes count ", shifted);
	out
}
@end
