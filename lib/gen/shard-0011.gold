fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	var counts int[512] = [0; 512];
	var vals int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in distinct {
			if vals[j] == x {
				counts[j]++;
				found = true;
			}
		}
		if !found {
			vals[distinct] = x;
			counts[distinct] = 1;
			distinct++;
		}
	}
	var total = 0;
	for j in distinct {
		total += counts[j];
	}
	out.i = total;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "folded ", distinct, " unique items into total ", total);
	out
}
@end
