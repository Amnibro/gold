code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = 0;
	for k in g.n {
		if g.res[k] > 0 { pos++; }
	}
	out.s.clear();
	format(out.s, "safe positive tally: ", pos);
	out.i = pos;
	g.steps += g.n;
	out
}
@end
