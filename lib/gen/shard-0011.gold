code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let min_v = ${floor_val};
	let span = if cnt < g.n { cnt } else { g.n };
	var valid = true;
	var i = 0;
	while i < span {
		if g.res[i] < min_v {
			valid = false;
			gold_fail(g, "initial history below floor");
			break;
		}
		i++;
	}
	g.steps += span;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "first history validation ", valid);
	out
}
@end
