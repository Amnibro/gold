@entry ccd68bc4629d878f
kind: step
verb: map
noun: middle
modifier: with_cache
context: sort
phrase: map middle sorted elements with cache {factor}
phrase: scale middle sorted elements with cache {factor}
slot: factor int
test: list=1,3,5,7 factor=3
expect: => i=15 r=0.0 ok=true s="mapped middle to 15" errors=0 n=4 res=[1,3,15,7] cache=1 hits=0
test: list=10,20,30 factor=2
expect: => i=40 r=0.0 ok=true s="mapped middle to 40" errors=0 n=3 res=[10,40,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty array");
		return out;
	}
	let mid = g.n / 2;
	let old_v = g.res[mid];
	let new_v = old_v * f;
	g.res[mid] = new_v;
	gold_cache_put(g, mid, new_v);
	g.steps += 1;
	out.i = new_v;
	out.s.clear();
	format(out.s, "mapped middle to ", new_v);
	out
}
@end
