@entry 3779e7a51ee7951f
kind: step
verb: dedupe
noun: step
modifier: times
context: retry
phrase: dedupe retry steps repeating reduction {times} rounds
phrase: apply deduplication step {times} passes across retries
slot: times int
test: list=1,1,2,2,3,3 times=1
expect: => i=3 r=0.0 ok=true s="deduped adjacent items final count 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,4,5,5 times=2
expect: => i=2 r=0.0 ok=true s="deduped adjacent items final count 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${times};
	var p = 0;
	while p < passes && g.n > 1 {
		var w = 1;
		for i in 1..g.n {
			if g.res[i] != g.res[w - 1] {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
		p++;
	}
	g.steps += passes * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped adjacent items final count ", g.n);
	out
}
@end
