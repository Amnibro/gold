}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in out.s.len {
		if ${ID}_is_vowel(out.s[i]) {
			out.s[w] = out.s[i];
			w++;
		}
	}
	while out.s.len > w {
		out.s.pop();
	}
	var i = 0;
	while i < out.s.len {
		var j = i + 1;
		while j < out.s.len {
			if out.s[i] > out.s[j] {
				let tmp = out.s[i];
				out.s[i] = out.s[j];
				out.s[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
