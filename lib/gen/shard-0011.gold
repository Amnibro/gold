@entry 8b5372fc20055141
kind: step
verb: check
noun: runs
modifier: all
context: filter
phrase: check all runs meet minimum length {len}
phrase: verify every contiguous run meets length {len}
slot: len int
test: list=1,1,2,2,2,3,3 len=2
expect: => i=3 r=0.0 ok=true s="checked 3 runs against minimum length 2" errors=0 n=7 res=[1,1,2,2,2,3,3] cache=0 hits=0
test: list=1,2,3,4 len=2
expect: => i=4 r=0.0 ok=false s="checked 4 runs against minimum length 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${len};
	var all_ok = true;
	var run_count = 0;
	if g.n > 0 {
		var cur_len = 1;
		for i in g.n - 1 {
			if g.res[i] == g.res[i + 1] {
				cur_len++;
			} else {
				if cur_len < req {
					all_ok = false;
				}
				run_count++;
				cur_len = 1;
			}
		}
		if cur_len < req {
			all_ok = false;
		}
		run_count++;
	}
	g.steps += g.n;
	out.ok = all_ok;
	out.i = run_count;
	out.s.clear();
	format(out.s, "checked ", run_count, " runs against minimum length ", req);
	out
}
@end
