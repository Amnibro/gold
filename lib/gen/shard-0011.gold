@entry c0f4ffa0ad491230
kind: step
verb: drop
noun: function
modifier: running
context: sort
phrase: drop items that disrupt running sort order under {f}
phrase: remove inversions in running stream using transform {f}
slot: f fn
test: list=10,12,5,15,8 f=collatz
expect: => i=1 r=0.0 ok=true s="dropped running inverted items count 1" errors=0 n=4 res=[10,12,5,15] cache=0 hits=0
test: list=11,25,12,35 f=digit_sum
expect: => i=1 r=0.0 ok=true s="dropped running inverted items count 1" errors=0 n=3 res=[11,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var dropped = 0;
	for i in g.n {
		let val = ${f}(g.res[i]);
		if kn > 0 && val < ${f}(kept[kn - 1]) {
			dropped++;
		} else {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	for i in kn { g.res[i] = kept[i]; }
	g.n = kn;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped running inverted items count ", dropped);
	out
}
@end
@entry 97afd5f75a821553
kind: step
verb: find
noun: memo
modifier: with_cache
context: sort
phrase: find median of sorted sequence using memoized cache
phrase: locate central ordered element with cache lookup
test: list=50,10,30,20,40
expect: => i=30 r=0.0 ok=true s="median element found 30" errors=0 n=5 res=[10,20,30,40,50] cache=1 hits=0
test: list=9,1,5,7,3
expect: => i=5 r=0.0 ok=true s="median element found 5" errors=0 n=5 res=[1,3,5,7,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let prev, hit = gold_cache_get(g, g.n);
	if hit {
		out.i = prev;
	} else {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		let mid = g.n / 2;
		let median = if g.n > 0 { g.res[mid] } else { 0 };
		gold_cache_put(g, g.n, median);
		out.i = median;
	}
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "median element found ", out.i);
	out
}
@end
@entry e9ccae6c188f10d0
kind: step
verb: split
noun: total
modifier: sorted
context: sort
phrase: split sorted list into halves with balanced total sum
phrase: partition ordered sequence by cumulative total sum
test: list=10,50,20,40,30
expect: => i=3 r=0.0 ok=true s="balanced split index at 3" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,5,2,4,3
expect: => i=3 r=0.0 ok=true s="balanced split index at 3" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let half = total / 2;
	var run_sum = 0;
	var split_idx = 0;
	for i in g.n {
		run_sum += g.res[i];
		if run_sum >= half {
			split_idx = i;
			break;
		}
	}
	g.steps += g.n * g.n;
	out.i = split_idx;
	out.s.clear();
	format(out.s, "balanced split index at ", split_idx);
	out
}
@end
