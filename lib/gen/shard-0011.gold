@entry 6e0c1bb15e07595a
kind: step
verb: group
noun: gaps
modifier: running
context: error
phrase: group running gaps between error entries
phrase: aggregate running interval gaps across errors
slot: max_gap int
test: list=1,4,10,12 max_gap=5
expect: => i=11 r=0.0 ok=false s="grouped running gaps sum 11" errors=1 n=4 res=[1,4,10,12] cache=0 hits=0
test: list=2,20 max_gap=5
expect: => i=18 r=0.0 ok=false s="grouped running gaps sum 18" errors=1 n=2 res=[2,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "insufficient results for running gaps");
		out.ok = false;
		return out;
	}
	var total_gaps = 0;
	var violations = 0;
	var i = 1;
	while i < g.n {
		let gap = g.res[i] - g.res[i - 1];
		if gap > mg {
			violations++;
		}
		total_gaps += gap;
		i++;
	}
	if violations > 0 {
		gold_fail(g, "gap exceeded maximum threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = total_gaps;
	out.s.clear();
	format(out.s, "grouped running gaps sum ", total_gaps);
	out
}
@end
