		g.res[w] = g.res[i] + g.res[i + 1];
		w++;
		i += 2;
	}
	if i < g.n {
		g.res[w] = g.res[i];
		w++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "pairwise reduction length ", w);
	out
}
@end
