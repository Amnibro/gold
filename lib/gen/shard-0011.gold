fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		var dup = false;
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] {
				dup = true;
				break;
			}
			j++;
		}
		if !dup {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped histogram last count ", w);
	out
}
@end
