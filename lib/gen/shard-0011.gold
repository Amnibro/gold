code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_space = -1;
	for i in out.s.len {
		if out.s[i] == ' ' { last_space = i; }
	}
	if last_space >= 0 && last_space + 1 < out.s.len {
		var left = last_space + 1;
		var right = out.s.len - 1;
		while left < right {
			let tmp = out.s[left];
			out.s[left] = out.s[right];
			out.s[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
