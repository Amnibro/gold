expect: => i=1 r=0.0 ok=true s="prime pairs: [(11, 13)]" errors=0 n=4 res=[11,13,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[>..] = [];
	for k in g.n {
		if core_is_prime(g.res[k]) { primes.push(g.res[k]); }
	}
	out.s.clear();
	format(out.s, "prime pairs: [");
	var p = 0;
	var i = 0;
	while i + 1 < primes.len {
		if p > 0 { format(out.s, ", "); }
		format(out.s, "(", primes[i], ", ", primes[i + 1], ")");
		p++;
		i += 2;
	}
	format(out.s, "]");
	out.i = p;
	g.steps += g.n + primes.len;
	out
}
@end
