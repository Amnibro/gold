@entry 9894120df94a376a
kind: step
verb: dedupe
noun: values
modifier: at_least
context: search
phrase: dedupe search values appearing at least frequency times {min_freq}
phrase: strip recurring items with occurrence count at least {min_freq}
slot: min_freq int
test: list=2,2,2,3,3,4 min_freq=3
expect: => i=4 r=0.0 ok=true s="deduped values count 4" errors=0 n=4 res=[2,3,3,4] cache=0 hits=0
test: list=5,5,6,7,7 min_freq=2
expect: => i=3 r=0.0 ok=true s="deduped values count 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_f = ${min_freq};
	var kept int[>..] = [];
	var seen int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= min_f {
			var already = false;
			for k in seen.len {
				if seen[k] == x { already = true; break; }
			}
			if !already {
				seen.push(x);
				kept.push(x);
			}
		} else {
			kept.push(x);
		}
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = kept.len;
	out.s.clear();
	format(out.s, "deduped values count ", kept.len);
	out
}
@end
@entry 4fe4bb4e4344a324
kind: step
verb: validate
noun: subfunction
modifier: unique
context: search
phrase: validate that subfunction maps results to unique outputs {f}
phrase: verify all subfunction outputs across search results are distinct {f}
slot: f fn
test: list=1,2,3,4 f=double
expect: => i=1 r=0.0 ok=true s="subfunction distinctness true" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,-1,2 f=square
expect: => i=0 r=0.0 ok=false s="subfunction distinctness false" errors=0 n=3 res=[1,-1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mapped int[>..] = [];
	var is_uniq = true;
	for i in g.n {
		let y = ${f}(g.res[i]);
		for j in mapped.len {
			if mapped[j] == y {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq { break; }
		mapped.push(y);
	}
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	g.steps += g.n * mapped.len;
	out.s.clear();
	format(out.s, "subfunction distinctness ", is_uniq);
	out
}
@end
