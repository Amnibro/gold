	let max_e = ${max_err};
	var kept = 0;
	for i in g.n {
		if g.res[i] <= max_e {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 && g.n > 0 {
		gold_fail(g, "all values exceeded max error");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " valid loop results");
	out
}
