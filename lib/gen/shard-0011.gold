	var out = v;
	let r = ${rounds};
	let span = if r + 2 < g.n { r + 2 } else { g.n };
	for i in span {
		for j in (i + 1)..span {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += span * span;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted prefix span of size ", span);
	out
}
@end
