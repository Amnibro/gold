test: list=12,4,8,15,3 cond=is_even
expect: => i=3 r=0.0 ok=true s="sorted errors while condition met length 3" errors=0 n=5 res=[4,8,12,15,3] cache=0 hits=0
test: list=11,5,7,2,9 cond=is_odd
expect: => i=3 r=0.0 ok=true s="sorted errors while condition met length 3" errors=0 n=5 res=[5,7,11,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prefix_len = 0;
	while prefix_len < g.n && ${cond}(g.res[prefix_len]) {
		prefix_len++;
	}
	var i = 0;
	while i < prefix_len {
		var j = 0;
		while j + 1 < prefix_len - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += prefix_len;
	out.i = prefix_len;
	out.s.clear();
	format(out.s, "sorted errors while condition met length ", prefix_len);
	out
}
@end
@entry 9e0797fd9f1fcf7e
kind: step
verb: rotate
noun: results
modifier: between
context: retry
phrase: rotate retry results between index {start} to {finish}
phrase: cyclically shift retry attempts between bounds {start} through {finish}
slot: start int
slot: finish int
test: list=10,20,30,40,50 start=1 finish=3
expect: => i=3 r=0.0 ok=true s="rotated segment length 3" errors=0 n=5 res=[10,40,20,30,50] cache=0 hits=0
test: list=1,2,3,4,5,6 start=2 finish=5
expect: => i=4 r=0.0 ok=true s="rotated segment length 4" errors=0 n=6 res=[1,2,6,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let f = ${finish};
	if s >= 0 && f < g.n && s < f {
		let last = g.res[f];
		var idx = f;
		while idx > s {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[s] = last;
		g.steps += f - s + 1;
		out.i = f - s + 1;
	} else {
		gold_fail(g, "bounds invalid in rotate results");
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "rotated segment length ", out.i);
	out
}
@end
