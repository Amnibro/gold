code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let def_val = ${fallback};
	if g.n == 0 {
		out.i = def_val;
		out.s.clear();
		format(out.s, "safe maximum fallback used ", def_val);
		return out;
	}
	var peak = g.res[0];
	for i in 1..g.n {
		if g.res[i] > peak { peak = g.res[i]; }
	}
	g.steps += g.n;
	out.i = peak;
	out.s.clear();
	format(out.s, "safe maximum found ", peak);
	out
}
@end
