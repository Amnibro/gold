@entry 582b5a273fd62cba
kind: step
verb: pair
noun: budget
modifier: last
context: error
phrase: pair last items within error budget {budget}
phrase: combine tail elements under budget {budget}
slot: budget int
test: list=5,10,15 budget=30
expect: => i=25 r=0.0 ok=true s="combined tail within budget to 25" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=10,25 budget=20
expect: => i=35 r=0.0 ok=false s="tail sum 35 exceeds budget" errors=1 n=2 res=[10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n < 2 {
		gold_fail(g, "insufficient items for pair");
		out.ok = false;
		return out;
	}
	let sum = g.res[g.n - 1] + g.res[g.n - 2];
	if sum <= b {
		g.res[g.n - 2] = sum;
		g.n--;
		out.i = sum;
		out.s.clear();
		format(out.s, "combined tail within budget to ", sum);
	} else {
		gold_fail(g, "budget exceeded for tail pair");
		out.ok = false;
		out.i = sum;
		out.s.clear();
		format(out.s, "tail sum ", sum, " exceeds budget");
	}
	g.steps += 1;
	out
}
@end
