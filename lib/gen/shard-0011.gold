fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak_idx = 0;
	var i = 0;
	var odd_count = 0;
	while i < g.n {
		let is_pos = g.res[i] >= 0;
		while i < g.n && (g.res[i] >= 0) == is_pos {
			if streak_idx % 2 == 1 {
				odd_count++;
			}
			i++;
		}
		streak_idx++;
	}
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "split alternating streaks odd count ", odd_count);
	out
}
