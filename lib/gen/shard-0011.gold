fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var end = 0;
	while end < out.s.len && out.s[end] != ' ' {
		end++;
	}
	if end > 1 {
		for i in end {
			for j in (i + 1)..end {
				if out.s[j] < out.s[i] {
					let tmp = out.s[i];
					out.s[i] = out.s[j];
					out.s[j] = tmp;
				}
			}
		}
	}
	g.steps += out.s.len * end;
	out.i = end;
	out
}
@end
