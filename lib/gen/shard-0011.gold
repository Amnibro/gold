@entry a81d82d4af7e4430
kind: step
verb: join
noun: step
modifier: recursively
context: retry
phrase: join retry steps recursively with branch factor {branch}
phrase: recursively fold retry steps into tree of degree {branch}
slot: branch int
test: list=1,2,3,4,5,6,7,8 branch=2
expect: => i=36 r=0.0 ok=true s="recursively folded root value 36" errors=0 n=1 res=[36] cache=0 hits=0
test: list=2,4,6,8,10,12 branch=3
expect: => i=42 r=0.0 ok=true s="recursively folded root value 42" errors=0 n=1 res=[42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = if ${branch} > 1 { ${branch} } else { 2 };
	while g.n > 1 {
		var w = 0;
		var i = 0;
		while i < g.n {
			var chunk = 0;
			var j = 0;
			while j < b && i + j < g.n {
				chunk += g.res[i + j];
				j++;
			}
			g.res[w] = chunk;
			w++;
			i += b;
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "recursively folded root value ", out.i);
	out
}
@end
@entry f61d805e33015226
