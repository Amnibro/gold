code:
fn ${ID}_is_vowel(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 ||
	c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${ID}_is_vowel(g.res[i]) && ${ID}_is_vowel(g.res[i + 1]) {
			g.res[i] = g.res[i] * mult;
			g.res[i + 1] = g.res[i + 1] * mult;
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "scaled vowel pairs count ", pairs);
	out
}
@end
