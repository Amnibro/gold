@entry 6f3db872fa046311
kind: step
verb: check
noun: range
modifier: recursively
context: filter
phrase: check range recursively within boundary {bound}
phrase: verify nested range values recursively under {bound}
slot: bound int
test: list=16,32,64 bound=10
expect: => i=4 r=0.0 ok=true s="checked range recursively in 4 passes" errors=0 n=3 res=[8,8,8] cache=0 hits=0
test: list=5,8,9 bound=10
expect: => i=1 r=0.0 ok=true s="checked range recursively in 1 passes" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var passes = 0;
	var all_within = false;
	while passes < 5 && !all_within {
		all_within = true;
		for i in g.n {
			if g.res[i] > b {
				all_within = false;
				g.res[i] /= 2;
			}
		}
		passes++;
	}
	g.steps += passes * g.n;
	out.ok = all_within;
	out.i = passes;
	out.s.clear();
	format(out.s, "checked range recursively in ", passes, " passes");
	out
}
@end
