kind: step
verb: keep
noun: numbers
modifier: last
context: error
phrase: keep last {count} error numbers
phrase: retain trailing {count} error values
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="retained last 2 error numbers" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,10,15 count=0
expect: => i=0 r=0.0 ok=false s="retained 0 error numbers" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 {
		gold_fail(g, "zero error elements retained");
		out.ok = false;
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "retained 0 error numbers");
		return out;
	}
	let start = if g.n > cnt { g.n - cnt } else { 0 };
	let kept = g.n - start;
	for i in kept {
		g.res[i] = g.res[start + i];
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained last ", kept, " error numbers");
	out
}
@end
