@entry eac2374b4db1612c
kind: step
verb: search
noun: loop
modifier: with_retry
context: search
phrase: search loop index with retry count {target} {retries}
phrase: locate cycle target using retry attempts {target} {retries}
slot: target int
slot: retries int
test: list=10,20,30,40 target=30 retries=2
expect: => i=2 r=0.0 ok=true s="loop search attempts 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 target=99 retries=3
expect: => i=-1 r=0.0 ok=false s="loop search attempts 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var found_idx = -1;
	var tries = 0;
	while tries < max_r && found_idx < 0 {
		for i in g.n {
			if g.res[i] == tgt {
				found_idx = i;
				break;
			}
		}
		tries++;
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	g.steps += tries * (g.n + 1);
	out.s.clear();
	format(out.s, "loop search attempts ", tries);
	out
}
@end
@entry fe01c29f4b047899
kind: step
verb: rotate
noun: step
modifier: times
context: search
phrase: rotate search step offsets number of times {shift}
phrase: advance search sequence elements by count {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated steps 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated steps 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var k = ${shift} % g.n;
	if k < 0 { k += g.n; }
	for _ in k {
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last_val;
	}
	g.steps += k * g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated steps ", k);
	out
}
@end
