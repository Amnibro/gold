@entry 9415d24deebe4cf8
kind: step
verb: find
noun: duplicates
modifier: with_retry
context: cache
phrase: find cached duplicates with retry limit {retries}
phrase: scan cache for duplicate entries retrying {retries} times
slot: retries int
test: list=1,2,2,3,3 retries=1
expect: => i=2 r=0.0 ok=true s="found duplicates with retry count 2" errors=0 n=5 res=[1,2,2,3,3] cache=2 hits=0
test: list=4,5,6 retries=2
expect: => i=0 r=0.0 ok=true s="found duplicates with retry count 0" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var dupes = 0;
	var attempts = 0;
	while attempts <= max_r {
		attempts++;
		dupes = 0;
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[j] == g.res[i] {
					dupes++;
					gold_cache_put(g, g.res[i], dupes);
				}
			}
		}
	}
	g.steps += g.n * attempts;
	out.i = dupes;
	out.s.clear();
	format(out.s, "found duplicates with retry count ", dupes);
	out
}
@end
