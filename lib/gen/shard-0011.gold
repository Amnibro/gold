fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] > b {
			gold_fail(g, "scan exceeded error budget");
			out.ok = false;
			break;
		}
		total += g.res[i];
		count++;
