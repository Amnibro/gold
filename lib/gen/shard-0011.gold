phrase: aggregate elements in reverse from last checkpoint {mark}
slot: mark int
test: list=10,5,20,15 mark=5
expect: => i=40 r=0.0 ok=true s="reverse checkpoint sum: 40" errors=0 n=4 res=[10,5,20,15] cache=0 hits=0
test: list=3,8,12,6 mark=8
expect: => i=26 r=0.0 ok=true s="reverse checkpoint sum: 26" errors=0 n=4 res=[3,8,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${mark};
	var total = 0;
	var hit = false;
	var i = g.n - 1;
	while i >= 0 {
		total += g.res[i];
		if g.res[i] == target {
			hit = true;
			break;
		}
		if i == 0 { break; }
		i--;
	}
	g.steps += g.n;
	out.i = total;
	out.ok = hit;
	out.s.clear();
	format(out.s, "reverse checkpoint sum: ", total);
	out
}
@end
