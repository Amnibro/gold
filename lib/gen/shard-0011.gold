fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap} as byte;
	var clamped = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b >= 48 && b <= 57 && b > c {
			out.s[i] = c;
			clamped++;
