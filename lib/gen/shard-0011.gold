@entry aaf73cb610878452
kind: step
verb: map
noun: window
modifier: sorted
context: aggregate
phrase: map window averages sorted with span {span}
phrase: compute sorted sliding window sums of width {span}
slot: span int
test: list=5,1,8,2,6 span=2
expect: => i=4 r=0.0 ok=true s="mapped sorted window sums count 4" errors=0 n=4 res=[6,8,9,10] cache=0 hits=0
test: list=10,20,5,15 span=3
expect: => i=2 r=0.0 ok=true s="mapped sorted window sums count 2" errors=0 n=2 res=[35,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = if ${span} < 1 { 1 } else { ${span} };
	var sums int[>..] = [];
	var i = 0;
	while i + w <= g.n {
		var s = 0;
		for j in w { s += g.res[i + j]; }
		sums.push(s);
		i++;
	}
	for a in sums.len {
		for b in a + 1..sums.len {
			if sums[a] > sums[b] {
				let tmp = sums[a];
				sums[a] = sums[b];
				sums[b] = tmp;
			}
		}
	}
	gold_clear(g);
	for s in sums { gold_push(g, s); }
	g.steps += g.n * w;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped sorted window sums count ", g.n);
	out
}
@end
