expect: => i=1 r=0.0 ok=true s="inversions eliminated in first pass 1" errors=0 n=4 res=[7,5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var before = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] { before++; }
		}
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
	}
	var after = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] { after++; }
		}
	}
	g.steps += g.n * 2;
	out.i = before - after;
	out.s.clear();
	format(out.s, "inversions eliminated in first pass ", out.i);
	out
}
@end
