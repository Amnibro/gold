expect: => i=2 r=0.0 ok=true s="clamped streak kept count 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_streak};
	if lim <= 0 {
		gold_fail(g, "invalid streak limit");
		out.ok = false;
		return out;
	}
	var w = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let count = j - i;
		let keep = if count < lim { count } else { lim };
		for k in keep {
			g.res[w] = g.res[i];
			w++;
		}
		i = j;
	}
	g.steps += g.n;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "clamped streak kept count ", w);
	out
}
@end
