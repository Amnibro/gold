expect: => i=4 r=0.0 ok=true s="distinct steps count 4" errors=0 n=6 res=[4,2,4,5,2,7] cache=0 hits=0
test: list=10,10,10,20,30
expect: => i=3 r=0.0 ok=true s="distinct steps count 3" errors=0 n=5 res=[10,10,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for unique grouping");
		out.ok = false;
		return out;
	}
	var distinct = 0;
	var i = 0;
	while i < g.n {
		var duplicate = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				duplicate = true;
				break;
			}
			j++;
		}
		if !duplicate {
			distinct++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "distinct steps count ", distinct);
	out
}
@end
