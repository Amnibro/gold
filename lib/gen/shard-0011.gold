fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	out.s.clear();
	format(out.s, "running loop: [");
	for k in g.n {
		total += g.res[k] * 2;
		g.res[k] = total;
		if k > 0 { format(out.s, ", "); }
		format(out.s, total);
	}
	format(out.s, "]");
	out.i = total;
	g.steps += g.n;
	out
}
