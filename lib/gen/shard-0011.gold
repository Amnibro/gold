@entry cab9a220e6658f3a
kind: step
verb: merge
noun: minimum
modifier: safely
context: format
phrase: format safe merge with minimum sequence element
phrase: render minimum value merged safely into report
test: list=5,2,8,1,4
expect: => i=1 r=0.0 ok=true s="merged safe min: 1" errors=0 n=6 res=[5,2,8,1,4,1] cache=0 hits=0
test: list=10,20,30
expect: => i=10 r=0.0 ok=true s="merged safe min: 10" errors=0 n=4 res=[10,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.s.clear();
		format(out.s, "min: none");
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	gold_push(g, min_val);
	out.s.clear();
	format(out.s, "merged safe min: ", min_val);
	out.i = min_val;
	g.steps += g.n;
	out
}
@end
