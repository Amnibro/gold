fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let take = if cnt > g.n { g.n } else if cnt < 0 { 0 } else { cnt };
	var mag = 0;
	var i = g.n - take;
	while i < g.n {
		let x = g.res[i];
		mag += if x < 0 { -x } else { x };
		i++;
	}
	g.steps += take;
	out.i = mag;
	out.s.clear();
	format(out.s, "measured trailing magnitude ", mag);
	out
}
@end
