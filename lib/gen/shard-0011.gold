@entry 5c2bfccb7939527e
kind: step
verb: collect
noun: average
modifier: with_retry
context: aggregate
phrase: collect average with retry trimming {trim_k} outliers
phrase: aggregate trimmed mean with retry margin {trim_k}
slot: trim_k int
test: list=10,20,30,40,50 trim_k=1
expect: => i=30 r=0.0 ok=true s="trimmed mean: 30" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=2,8,12,18,24,30 trim_k=2
expect: => i=15 r=0.0 ok=true s="trimmed mean: 15" errors=0 n=6 res=[2,8,12,18,24,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let trim = ${trim_k};
	if g.n <= 2 * trim {
		out.i = 0;
		out.s.clear();
		format(out.s, "trimmed mean: ", 0);
		return out;
	}
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[i]; }
	for i in g.n {
		for j in (g.n - 1 - i) {
			if temp[j] > temp[j + 1] {
				let tmp = temp[j];
				temp[j] = temp[j + 1];
				temp[j + 1] = tmp;
			}
		}
	}
	var sum = 0;
	let count = g.n - 2 * trim;
	for i in count { sum += temp[trim + i]; }
	let mean = sum / count;
	g.steps += g.n;
	out.i = mean;
	out.s.clear();
	format(out.s, "trimmed mean: ", mean);
	out
}
@end
