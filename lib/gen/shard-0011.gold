code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	var mx = if g.n > 0 { g.res[0] } else { 0 };
	for k in 1..g.n {
		if g.res[k] > mx { mx = g.res[k]; }
	}
	let total = mx * r;
	out.s.clear();
	format(out.s, "measured max total: ", total, " (reps=", r, ")");
	out.i = total;
	g.steps += r * g.n;
	out
}
@end
