code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap_total = ${max_total};
	var running = 0;
	var kept = 0;
	for k in g.n {
		if running + g.res[k] > cap_total { break; }
		running += g.res[k];
		g.res[kept] = g.res[k];
		kept++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "selected total ", running);
	out
}
@end
@entry e3ab1a433b059767
kind: step
verb: swap
noun: total
modifier: up_to
context: stats
phrase: swap outer boundary elements when total under {ceiling}
phrase: exchange endpoints if total sum remains below {ceiling}
slot: ceiling int
test: list=1,2,3 ceiling=10
expect: => i=6 r=0.0 ok=true s="endpoint swap executed: true" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,6,7 ceiling=10
expect: => i=18 r=0.0 ok=false s="endpoint swap executed: false" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	var total = 0;
	for k in g.n { total += g.res[k]; }
	var swapped = false;
	if total < limit && g.n > 1 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		swapped = true;
	}
	g.steps += g.n;
	out.ok = swapped;
	out.i = total;
	out.s.clear();
	format(out.s, "endpoint swap executed: ", swapped);
	out
}
@end
@entry a0e8d00d181f61aa
kind: step
verb: count
noun: gaps
modifier: sorted
context: stats
phrase: count gap sizes between sorted consecutive numbers
phrase: tally differences across sorted sample values
test: list=3,1,7
expect: => i=6 r=0.0 ok=true s="total sorted gaps 6" errors=0 n=3 res=[1,3,7] cache=0 hits=0
test: list=10,2,5
expect: => i=8 r=0.0 ok=true s="total sorted gaps 8" errors=0 n=3 res=[2,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// sort
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	var total_gap = 0;
	var k = 0;
	while k + 1 < g.n {
		total_gap += g.res[k + 1] - g.res[k];
		k++;
	}
	g.steps += g.n * g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "total sorted gaps ", total_gap);
	out
}
@end
