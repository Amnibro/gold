fn ${ID}(n int) int {
	let max_s = ${max_steps};
	var x = if n < 1 { 1 } else { n };
	var steps = 0;
	while x > 1 && steps < max_s {
		if x % 2 == 0 {
			x /= 2;
		} else {
			x = 3 * x + 1;
		}
		steps++;
	}
	steps
}
