	var out = v;
	let k = ${count};
	let count = if k < g.n { k } else { g.n };
	var sum = 0;
	if count > 0 {
		let start = g.n - count;
		for i in count {
			sum += g.res[start + i];
		}
	}
	g.steps += count;
	out.i = sum;
	out.r = if count > 0 { (sum as real) / (count as real) } else { 0.0 };
	out.s.clear();
	format(out.s, "measured last ", count, " loop items sum ", sum);
	out
}
@end
@entry 907cec47a4a2cadb
kind: step
verb: reverse
noun: numbers
modifier: nested
context: filter
phrase: reverse filtered nested numbers in groups of {size}
phrase: invert nested number groups of length {size}
slot: size int
test: list=1,2,3,4,5,6 size=3
expect: => i=2 r=0.0 ok=true s="reversed 2 nested number pairs" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=2 r=0.0 ok=true s="reversed 2 nested number pairs" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 1 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var start = 0;
	while start < g.n {
		var end = start + sz - 1;
		if end >= g.n {
			end = g.n - 1;
		}
		var l = start;
		var r = end;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
			count++;
		}
		start += sz;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " nested number pairs");
	out
}
@end
