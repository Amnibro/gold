expect: => i=4 r=0.0 ok=true s="merged into 4 distinct values" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,6,7,7
expect: => i=3 r=0.0 ok=true s="merged into 3 distinct values" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "merged unique items");
		return out;
	}
	var write_idx = 1;
	for read_idx in 1..g.n {
		if g.res[read_idx] != g.res[read_idx - 1] {
			g.res[write_idx] = g.res[read_idx];
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "merged into ", write_idx, " distinct values");
	out
}
@end
