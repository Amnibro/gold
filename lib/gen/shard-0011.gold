code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let a = g.res[g.n - 2];
	let b = g.res[g.n - 1];
	let gap = if b > a { b - a } else { a - b };
	g.res[0] = gap;
	g.n = 1;
	g.steps += 2;
	out.i = gap;
	out.s.clear();
	format(out.s, "measured last gap: ", gap);
	out
}
@end
