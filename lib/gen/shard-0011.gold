@entry ddeb3dde13248abe
kind: step
verb: retry
noun: minimum
modifier: up_to
context: retry
phrase: retry increasing minimum up to {target}
phrase: boost smallest retry value up to ceiling {target}
slot: target int
test: list=5,20,30 target=15
expect: => i=15 r=0.0 ok=true s="boosted minimum to 15" errors=0 n=3 res=[15,20,30] cache=0 hits=0
test: list=25,30 target=20
expect: => i=25 r=0.0 ok=true s="minimum already at or above target: 25" errors=0 n=2 res=[25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty list for minimum retry");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	var adjusted = false;
	if g.res[min_idx] < tgt {
		g.res[min_idx] = tgt;
		adjusted = true;
	}
	g.steps += g.n;
	out.i = g.res[min_idx];
	out.s.clear();
	if adjusted {
		format(out.s, "boosted minimum to ", tgt);
	} else {
		format(out.s, "minimum already at or above target: ", out.i);
	}
	out
}
@end
