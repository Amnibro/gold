@entry d9392e9eabb9cd0d
kind: step
verb: retry
noun: middle
modifier: pairwise
context: aggregate
phrase: retry middle pairwise adjustments up to {max_tries}
phrase: attempt pairwise adjustments on interior items with {max_tries} retries
slot: max_tries int
test: list=10,5,3,20 max_tries=2
expect: => i=2 r=0.0 ok=true s="retried middle pairwise 2 times" errors=0 n=4 res=[10,3,5,20] cache=0 hits=0
test: list=1,8,4,2,9 max_tries=3
expect: => i=3 r=0.0 ok=true s="retried middle pairwise 3 times" errors=0 n=5 res=[1,2,4,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	if g.n < 3 {
		out.i = 0;
		return out;
	}
	var tries = 0;
	while tries < limit {
		var changed = false;
		var i = 1;
		while i + 1 < g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				changed = true;
			}
			i++;
		}
		tries++;
		if !changed { break; }
	}
	g.steps += tries * g.n;
	out.i = tries;
	out.s.clear();
	format(out.s, "retried middle pairwise ", tries, " times");
	out
}
@end
