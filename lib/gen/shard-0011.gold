code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for pairwise sum");
		out.ok = false;
		return out;
	}
	var total_diff = 0;
	var i = 0;
	while i < g.n - 1 {
		let d = g.res[i + 1] - g.res[i];
		let abs_d = if d < 0 { -d } else { d };
		total_diff += abs_d;
		i++;
	}
	g.steps += g.n;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "pairwise difference tally ", total_diff);
	out
}
@end
