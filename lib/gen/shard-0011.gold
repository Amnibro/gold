test: list=2,5,1,10
expect: => i=3 r=0.0 ok=true s="computed 3 pairwise gaps" errors=0 n=3 res=[3,4,9] cache=0 hits=0
test: list=10,20
expect: => i=1 r=0.0 ok=true s="computed 1 pairwise gaps" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let count = g.n - 1;
	for i in count {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[i] = if b > a { b - a } else { a - b };
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "computed ", count, " pairwise gaps");
	out
}
@end
