test: list=1,2,3,4,5 count=3
expect: => i=12 r=0.0 ok=true s="joined 3 tail elements to sum 12" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=30 r=0.0 ok=true s="joined 1 tail elements to sum 30" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	if k < 0 { k = 0; }
	if k > g.n { k = g.n; }
	var sum = 0;
	let start = g.n - k;
	for i in k {
		sum += g.res[start + i];
	}
	g.steps += k;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined ", k, " tail elements to sum ", sum);
	out
}
@end
