code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var freqs int[512] = [0; 512];
	var fcount = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var cnt = 0;
			for j in g.n {
				if g.res[j] == x { cnt++; }
			}
			var f_seen = false;
			for k in fcount {
				if freqs[k] == cnt { f_seen = true; break; }
			}
			if !f_seen {
				freqs[fcount] = cnt;
				fcount++;
			}
		}
	}
	for i in fcount {
		g.res[i] = freqs[i];
	}
	g.n = fcount;
	g.steps += g.n;
	out.i = fcount;
	out.s.clear();
	format(out.s, "extracted ", fcount, " unique histogram frequencies");
	out
}
@end
