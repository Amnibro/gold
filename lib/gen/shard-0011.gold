expect: => i=3 r=0.0 ok=true s="ranked head elements 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=10 count=3
expect: => i=0 r=0.0 ok=false s="error: insufficient items" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var items int[>..] = [];
	var i = 0;
	while i < g.n && items.len < k {
		items.push(g.res[i]);
		i += 2;
	}
	if items.len < k {
		gold_fail(g, "insufficient alternating head items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	for a in items.len {
		for b in (a + 1)..items.len {
			if items[b] < items[a] {
				let tmp = items[a];
				items[a] = items[b];
				items[b] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in items { gold_push(g, x); }
	g.steps += k * k;
	out.i = items.len;
	out.s.clear();
	format(out.s, "ranked head elements ", items.len);
	out
}
@end
