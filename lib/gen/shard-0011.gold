expect: => i=1 r=0.0 ok=true s="reversed steps recursively passes 1" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var pass = 0;
	while pass < r {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
		pass++;
	}
	g.steps += r * g.n;
	out.i = r;
	out.s.clear();
	format(out.s, "reversed steps recursively passes ", r);
	out
}
@end
