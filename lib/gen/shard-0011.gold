fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		count++;
		i += 2;
	}
	for a in count {
		var j = 0;
		while j + 2 < g.n {
			if g.res[j] > g.res[j + 2] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 2];
				g.res[j + 2] = tmp;
			}
			j += 2;
		}
	}
	out.i = count;
	g.steps += count * count;
	out.s.clear();
	format(out.s, "sorted ", count, " alternate observations");
