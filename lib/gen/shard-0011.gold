fn ${ID}_is_vowel(ch byte) bool {
	ch == 97 as byte || ch == 101 as byte || ch == 105 as byte || ch == 111 as byte || ch == 117 as byte
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in out.s.len {
		let c = out.s[i];
		if !${ID}_is_vowel(c) {
			out.s[w] = c;
			w++;
		}
	}
	out.s.resize(w, 0 as byte);
	out.i = w;
	g.steps += out.s.len;
	out
}
@end
