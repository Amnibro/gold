fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_len};
	let hi = ${max_len};
	var dot_pos = -1;
	for i in out.s.len {
		if out.s[i] == '.' { dot_pos = i; }
	}
	var suf_len = 0;
	if dot_pos >= 0 {
		suf_len = out.s.len - 1 - dot_pos;
	}
	let ok = suf_len >= lo && suf_len <= hi;
	g.steps += out.s.len;
	out.ok = ok;
	out.i = suf_len;
	out
}
@end
