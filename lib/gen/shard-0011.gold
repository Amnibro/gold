phrase: order loop elements using comparison budget {budget}
slot: budget int
test: list=5,1,4,2,8 budget=3
expect: => i=3 r=0.0 ok=true s="completed budget swaps 3" errors=0 n=5 res=[1,4,2,5,8] cache=0 hits=0
test: list=9,7,5,3 budget=2
expect: => i=2 r=0.0 ok=true s="completed budget swaps 2" errors=0 n=4 res=[7,5,9,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${budget};
	var swaps = 0;
	var i = 0;
	while i < g.n && swaps < max_swaps {
		var j = 0;
		while j + 1 < g.n - i && swaps < max_swaps {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
				swaps++;
			}
			j++;
		}
		i++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "completed budget swaps ", swaps);
	out
}
@end
@entry cb502029a631f8c0
kind: step
verb: fold
noun: budget
modifier: last
context: loop
phrase: fold last loop elements within allocation budget {cap}
phrase: reduce trailing loop entries under budget limit {cap}
slot: cap int
test: list=10,20,30,40 cap=60
expect: => i=40 r=0.0 ok=true s="folded last budget sum 40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25,35 cap=50
expect: => i=35 r=0.0 ok=true s="folded last budget sum 35" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if sum + g.res[idx] > limit { break; }
		sum += g.res[idx];
		count++;
		idx--;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded last budget sum ", sum);
	out
}
@end
