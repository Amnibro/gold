@entry e424a045c7e36377
kind: step
verb: validate
noun: gaps
modifier: any
context: loop
phrase: validate whether any loop gap exceeds threshold {max_gap}
phrase: check if any adjacent loop difference surpasses {max_gap}
slot: max_gap int
test: list=10,15,22,25 max_gap=6
expect: => i=1 r=0.0 ok=true s="excess gap detected true" errors=0 n=4 res=[10,15,22,25] cache=0 hits=0
test: list=2,4,6,8 max_gap=5
expect: => i=0 r=0.0 ok=false s="excess gap detected false" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	var found_excess = false;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let ad = if diff < 0 { -diff } else { diff };
		if ad > limit {
			found_excess = true;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = found_excess;
	out.i = if found_excess { 1 } else { 0 };
	out.s.clear();
	format(out.s, "excess gap detected ", found_excess);
	out
}
@end
