fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ne = 0;
	var no = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 { evens[ne] = x; ne++; }
		else { odds[no] = x; no++; }
	}
	gold_clear(g);
	for j in ne { gold_push(g, evens[j]); }
	for j in no { gold_push(g, odds[j]); }
	out.i = ne;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated ", ne, " even numbers to front");
	out
}
@end
