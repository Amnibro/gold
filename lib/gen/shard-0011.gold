fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var weight = 1;
	var i = g.n - 1;
	while i >= 0 {
		total += g.res[i] * weight;
		weight++;
		if i == 0 { break; }
		i--;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "reverse weighted text sum: ", total);
	out
}
