@entry 3547669fc2c58051
kind: step
verb: keep
noun: minimum
modifier: recursively
context: filter
phrase: keep minimum values recursively across chunk size {size}
phrase: retain recursive minimums per partition of length {size}
slot: size int
test: list=10,5,8,20,3,15 size=3
expect: => i=2 r=0.0 ok=true s="kept 2 chunk minimums" errors=0 n=2 res=[5,3] cache=0 hits=0
test: list=4,7,12,2,9,6 size=2
expect: => i=3 r=0.0 ok=true s="kept 3 chunk minimums" errors=0 n=3 res=[4,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = if ${size} > 0 { ${size} } else { 1 };
	var new_n = 0;
	var start = 0;
	while start < g.n {
		var min_val = g.res[start];
		let end = if start + sz < g.n { start + sz } else { g.n };
		var j = start + 1;
		while j < end {
			if g.res[j] < min_val {
				min_val = g.res[j];
			}
			j++;
		}
		g.res[new_n] = min_val;
		new_n++;
		start += sz;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept ", new_n, " chunk minimums");
	out
}
@end
