		gold_fail(g, "need at least two items for sorted step sum");
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = 0;
		while j < g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
