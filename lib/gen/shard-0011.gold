kind: step
verb: fold
noun: digits
modifier: at_least
context: math
phrase: fold numbers with digit sum at least {min_sum}
phrase: sum items having digit total at least {min_sum}
slot: min_sum int
test: list=12,39,45,8 min_sum=9
expect: => i=84 r=0.0 ok=true s="folded 2 numbers with digit sum at least threshold" errors=0 n=4 res=[12,39,45,8] cache=0 hits=0
test: list=10,25,33 min_sum=7
expect: => i=25 r=0.0 ok=true s="folded 1 numbers with digit sum at least threshold" errors=0 n=3 res=[10,25,33] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_sum};
	var total = 0;
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		var d = x;
		if d < 0 { d = -d; }
		var sum_d = 0;
		while d > 0 {
			sum_d += d % 10;
			d = d / 10;
		}
		if sum_d >= threshold {
			total += x;
			matched++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded ", matched, " numbers with digit sum at least threshold");
	out
}
@end
