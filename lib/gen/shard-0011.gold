code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = 999999;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen && g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "lowest unique entry ", min_val);
	out
}
@end
