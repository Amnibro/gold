test: list=5,15,25,35 passes=2
expect: => i=1 r=0.0 ok=true s="filtered elements remaining 1" errors=0 n=1 res=[35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p_total = ${passes};
	var p = 0;
	while p < p_total && g.n > 1 {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		let avg = sum / g.n;
		var kept = 0;
		for k in g.n {
			if g.res[k] >= avg {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		g.n = kept;
		p++;
	}
	g.steps += p * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered elements remaining ", g.n);
	out
}
@end
