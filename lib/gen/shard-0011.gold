@entry 4515c99462e923ba
kind: step
verb: limit
noun: total
modifier: recursively
context: sort
phrase: limit total sorting passes recursively until ordered
phrase: recursively bound sort iterations to achieve order
test: list=4,3,2,1
expect: => i=4 r=0.0 ok=true s="sorting passes needed 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,1,3,2
expect: => i=3 r=0.0 ok=true s="sorting passes needed 3" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var is_sorted = false;
	while !is_sorted && passes < 10 {
		is_sorted = true;
		passes++;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				is_sorted = false;
			}
		}
	}
	g.steps += g.n * passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "sorting passes needed ", passes);
	out
}
@end
