fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${th};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] > th {
			found_idx = i;
			break;
		}
	}
	out.s.clear();
	if found_idx >= 0 {
		let match_val = g.res[found_idx];
		g.res[0] = match_val;
		g.n = 1;
		out.i = match_val;
		format(out.s, "first over threshold=", match_val);
	} else {
		g.n = 0;
		out.i = -1;
		format(out.s, "none over threshold");
	}
	g.steps += g.n;
	out
}
