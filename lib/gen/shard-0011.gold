code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid = true;
	if g.n > 1 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			let abs_d = if d < 0 { -d } else { d };
			if abs_d > mg { valid = false; }
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "gaps valid: ", valid);
	out
}
@end
