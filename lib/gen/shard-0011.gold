@entry 2dd3909426ec1cb4
kind: step
verb: clamp
noun: average
modifier: recursively
context: math
phrase: clamp elements toward average magnitude recursively
phrase: restrict values to multiple of mean recursively
test: list=10,20,100,30
expect: => i=1 r=0.0 ok=true s="clamped 1 values to double average" errors=0 n=4 res=[10,20,80,30] cache=0 hits=0
test: list=5,15,80
expect: => i=1 r=0.0 ok=true s="clamped 1 values to double average" errors=0 n=3 res=[5,15,66] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let cap = avg * 2;
	var clamped = 0;
	for i in g.n {
		if g.res[i] > cap {
			g.res[i] = cap;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values to double average");
	out
}
@end
