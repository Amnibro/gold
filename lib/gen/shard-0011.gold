@entry 56ca4bf366812e56
kind: step
verb: retry
noun: letters
modifier: recursively
context: filter
phrase: retry filtering letters recursively with attempts {limit}
phrase: repeat recursive letter filter passes up to {limit}
slot: limit int
test: text="a1 b2 c3 d4!" limit=3
expect: => i=4 r=0.0 ok=true s="abcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="x_99 y_88 z_77" limit=2
expect: => i=3 r=0.0 ok=true s="xyz" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_alpha(b byte) bool {
	(b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_passes = if ${limit} > 0 { ${limit} } else { 1 };
	var kept byte[>..] = [];
	var passes = 0;
	while passes < max_passes {
		kept.clear();
		for i in out.s.len {
			let ch = out.s[i];
			if ${ID}_is_alpha(ch) {
				kept.push(ch);
			}
		}
		out.s.clear();
		for i in kept.len {
			out.s.push(kept[i]);
		}
		passes++;
		g.steps += kept.len;
	}
	out.i = out.s.len;
	out
}
@end
