kind: step
verb: search
noun: histogram
modifier: while
context: sort
phrase: search sorted histogram bins while frequencies remain below {max_freq}
phrase: find sorted histogram cutoff threshold while bounded by {max_freq}
slot: max_freq int
test: list=1,1,2,2,2,3 max_freq=2
expect: => i=2 r=0.0 ok=true s="histogram elements count 2" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=4,4,4,5 max_freq=1
expect: => i=0 r=0.0 ok=true s="histogram elements count 0" errors=0 n=4 res=[4,4,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		while i < g.n && g.res[i] == x { freq++; i++; }
		if freq > mf { break; }
		count += freq;
	}
	out.i = count;
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "histogram elements count ", count);
	out
}
@end
