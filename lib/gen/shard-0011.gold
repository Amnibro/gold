kind: step
verb: find
noun: values
modifier: times
context: math
phrase: find values appearing exactly {exact_times} times
phrase: count numbers occurring {exact_times} times
slot: exact_times int
test: list=1,2,2,3,3,3 exact_times=2
expect: => i=1 r=0.0 ok=true s="found 1 values occurring 2 times" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,6,6 exact_times=2
expect: => i=2 r=0.0 ok=true s="found 2 values occurring 2 times" errors=0 n=4 res=[5,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_freq = ${exact_times};
	var match_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if !seen_before {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x { freq++; }
			}
			if freq == target_freq { match_count++; }
		}
	}
	g.steps += g.n * g.n;
	out.i = match_count;
	out.s.clear();
	format(out.s, "found ", match_count, " values occurring ", target_freq, " times");
	out
}
@end
