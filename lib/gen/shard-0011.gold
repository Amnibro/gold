@entry 11f70c1fa12b4e0a
kind: step
verb: sort
noun: sequence
modifier: at_most
context: aggregate
phrase: sort sequence elements at most up to count {limit}
phrase: order sequence prefix at most bounded by {limit}
slot: limit int
test: list=9,1,8,2,7 limit=3
expect: => i=3 r=0.0 ok=true s="sorted sequence at most count 3" errors=0 n=5 res=[1,8,9,2,7] cache=0 hits=0
test: list=10,20,5,15 limit=2
expect: => i=2 r=0.0 ok=true s="sorted sequence at most count 2" errors=0 n=4 res=[10,20,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted sequence at most count ", bound);
	out
}
@end
