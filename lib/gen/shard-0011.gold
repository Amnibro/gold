@entry 30057f3a59edfc5d
kind: step
verb: retry
noun: loop
modifier: with_cache
context: filter
phrase: retry filter loop using cached values
phrase: execute cached filtering loop with retry capability
test: list=5,10,15,20
expect: => i=0 r=0.0 ok=true s="processed loop with cache hits 0" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=3,6,9,12
expect: => i=0 r=0.0 ok=true s="processed loop with cache hits 0" errors=0 n=4 res=[6,12,18,24] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for i in g.n {
		let k = g.res[i];
		let cached, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = cached;
			hits++;
		} else {
			let computed = k * 2;
			gold_cache_put(g, k, computed);
			g.res[i] = computed;
		}
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "processed loop with cache hits ", hits);
	out
}
@end
