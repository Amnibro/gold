code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let r = if g.res[i] < 0 { (-g.res[i]) % 2 } else { g.res[i] % 2 };
		if r != 0 {
			g.res[count] = g.res[i];
			count++;
		}
	}
	for i in count / 2 {
		let j = count - 1 - i;
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
	}
	g.steps += g.n + count;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " reverse odd numbers");
	out
}
@end
