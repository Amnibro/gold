code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 3 {
		var left = 1;
		var right = g.n - 2;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.s.clear();
	format(out.s, "reversed middle: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = if g.n > 2 { g.n - 2 } else { 0 };
	g.steps += g.n;
	out
}
@end
