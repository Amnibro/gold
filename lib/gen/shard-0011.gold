		gold_cache_put(g, i, g.res[i]);
	}
	var uniq int[256] = [0; 256];
	var ucount = 0;
	for i in g.cn {
		let val = g.cv[i];
		var seen = false;
		for j in ucount {
			if uniq[j] == val { seen = true; break; }
		}
		if !seen {
			uniq[ucount] = val;
			ucount++;
		}
	}
	for i in ucount {
		g.res[i] = uniq[i];
	}
	g.n = ucount;
	g.steps += g.cn;
	out.i = ucount;
	out.s.clear();
	format(out.s, "returned ", ucount, " unique cached values");
	out
}
@end
