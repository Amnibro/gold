slot: cond pred
test: list=2,4,6,3,5 cond=is_even
expect: => i=3 r=0.0 ok=true s="series rotated rotations count 3" errors=0 n=5 res=[3,5,2,4,6] cache=0 hits=0
test: list=1,3,2,4,6 cond=is_odd
expect: => i=2 r=0.0 ok=true s="series rotated rotations count 2" errors=0 n=5 res=[2,4,6,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rotations = 0;
	while g.n > 0 && ${cond}(g.res[0]) && rotations < g.n {
		let head = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = head;
		rotations++;
	}
	g.steps += rotations * g.n;
	out.i = rotations;
	out.s.clear();
	format(out.s, "series rotated rotations count ", rotations);
	out
}
@end
