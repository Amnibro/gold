phrase: validate first {count} comparison history elements exceed threshold {floor_val}
phrase: verify initial {count} history values meet minimum {floor_val}
slot: count int
slot: floor_val int
test: list=20,30,15,5 count=2 floor_val=18
expect: => i=1 r=0.0 ok=true s="first history validation true" errors=0 n=4 res=[20,30,15,5] cache=0 hits=0
