expect: => i=1 r=0.0 ok=true s="rotated by cache total 1" errors=0 n=5 res=[2,3,4,5,1] cache=1 hits=0
test: list=10,20,30
expect: => i=1 r=0.0 ok=true s="rotated by cache total 1" errors=0 n=3 res=[20,30,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 100, 1);
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if g.n > 1 {
		var k = g.cn % g.n;
		while k > 0 {
			let first = g.res[0];
			for i in 1..g.n { g.res[i - 1] = g.res[i]; }
			g.res[g.n - 1] = first;
			k--;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "rotated by cache total ", g.cn);
	out
}
@end
