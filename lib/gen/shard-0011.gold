fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req_gap = ${min_gap};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d < req_gap {
			valid = false;
			gold_fail(g, "spacing smaller than required min");
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "spacing lower bound valid ", valid);
	out
}
@end
