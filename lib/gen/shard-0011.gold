fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	if bound >= 4 {
		let tmp = g.res[0];
		var i = 0;
		while i + 2 < bound {
			g.res[i] = g.res[i + 2];
			i += 2;
		}
		g.res[i] = tmp;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "rotated alternating limit ", bound);
	out
}
