fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_val};
	var kept = 0;
	for k in g.n {
		if g.res[k] >= thresh {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " results");
	out
}
@end
