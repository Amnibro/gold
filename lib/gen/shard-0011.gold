@entry 5aba0fbf23f41c34
kind: step
verb: run
noun: counter
modifier: up_to
context: sort
phrase: run sorting passes up to inversion limit {max_inv}
phrase: reduce inversions up to threshold count {max_inv}
slot: max_inv int
test: list=5,4,3,2,1 max_inv=2
expect: => i=3 r=0.0 ok=true s="passes run up to inversion limit 3" errors=0 n=5 res=[2,1,3,4,5] cache=0 hits=0
test: list=10,9,8,7 max_inv=1
expect: => i=3 r=0.0 ok=true s="passes run up to inversion limit 3" errors=0 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_inv};
	var passes = 0;
	while passes < 10 {
		var inv = 0;
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				inv++;
			}
		}
		passes++;
		if inv <= limit { break; }
	}
	g.steps += g.n * passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "passes run up to inversion limit ", passes);
	out
}
@end
