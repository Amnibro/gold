fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	if w <= 0 {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	if g.n > w {
		let start = g.n - w;
		for i in w {
			g.res[i] = g.res[start + i];
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited window size to ", g.n);
	out
}
