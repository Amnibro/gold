@entry e3afbc0e84e93cb8
kind: step
verb: dedupe
noun: gaps
modifier: at_least
context: aggregate
phrase: dedupe gaps between elements reaching at least span {min_gap}
phrase: record unique gaps reaching at least span {min_gap}
slot: min_gap int
test: list=10,20,30,50 min_gap=10
expect: => i=2 r=0.0 ok=true s="deduped unique gaps count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=1,2,5,8 min_gap=3
expect: => i=1 r=0.0 ok=true s="deduped unique gaps count 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var w = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d >= gap {
			var seen = false;
			for j in w {
				if g.res[j] == d { seen = true; break; }
			}
			if !seen { g.res[w] = d; w++; }
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped unique gaps count ", w);
	out
}
@end
@entry 9c2e79559ae69865
kind: step
verb: sort
noun: cache
modifier: at_most
context: aggregate
phrase: sort cached values up to at most limit {limit}
phrase: order cache items at most up to count {limit}
slot: limit int
test: list=50,20,40,10 limit=3
expect: => i=3 r=0.0 ok=true s="sorted cache at most bound 3" errors=0 n=4 res=[20,40,50,10] cache=0 hits=0
test: list=4,3,2,1 limit=2
expect: => i=2 r=0.0 ok=true s="sorted cache at most bound 2" errors=0 n=4 res=[3,4,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = if lim < g.n { lim } else { g.n };
	if bound < 0 { bound = 0; }
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted cache at most bound ", bound);
	out
}
@end
