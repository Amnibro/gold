@entry 8f5741738b5b62eb
kind: step
verb: dedupe
noun: range
modifier: none
context: core
phrase: dedupe range none between {min_val} to {max_val}
phrase: remove duplicates within range {min_val} through {max_val}
phrase: filter duplicate values inside span {min_val} to {max_val}
slot: min_val int
slot: max_val int
test: list=2,2,5,5,8 min_val=1 max_val=4
expect: => i=4 r=0.0 ok=true s="deduped range items=4" errors=0 n=4 res=[2,5,5,8] cache=0 hits=0
test: list=3,3,3 min_val=2 max_val=5
expect: => i=1 r=0.0 ok=true s="deduped range items=1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped range items=", g.n);
	out
}
@end
@entry d8a73104339c797d
kind: step
verb: apply
noun: gaps
modifier: all
context: filter
phrase: apply gaps filter keeping elements with spacing at least {min_gap}
phrase: filter list elements maintaining minimum gap {min_gap}
slot: min_gap int
test: list=2,4,10,12,20 min_gap=5
expect: => i=3 r=0.0 ok=true s="elements with gap count: 3" errors=0 n=3 res=[2,10,20] cache=0 hits=0
test: list=1,3,8,9,15 min_gap=4
expect: => i=3 r=0.0 ok=true s="elements with gap count: 3" errors=0 n=3 res=[1,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let gap = ${min_gap};
	var kept = 1;
	var last = g.res[0];
	for i in 1..g.n {
		if g.res[i] - last >= gap {
			last = g.res[i];
			g.res[kept] = last;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "elements with gap count: ", kept);
	out
}
@end
