code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_freq};
	var counts byte[256] = [0; 256];
	for i in out.s.len {
		let ch = out.s[i] as int;
		counts[ch]++;
		gold_cache_put(g, ch, counts[ch] as int);
	}
	var w = 0;
	for i in out.s.len {
		let ch = out.s[i] as int;
		if (counts[ch] as int) >= req {
			out.s[w] = out.s[i];
			w++;
		}
	}
	while out.s.len > w {
		out.s.pop();
	}
	g.steps += out.s.len;
	out.i = w;
	out
}
@end
