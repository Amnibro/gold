@entry 60bf38037c639aa8
kind: step
verb: pair
noun: maximum
modifier: while
context: filter
phrase: pair maximum items while condition {p} holds
phrase: combine maximum pairs while predicate {p} matches
slot: p pred
test: list=2,4,6,8 p=is_even
expect: => i=2 r=0.0 ok=true s="paired 2 maximum items" errors=0 n=2 res=[4,8] cache=0 hits=0
test: list=1,3,5,7 p=is_odd
expect: => i=2 r=0.0 ok=true s="paired 2 maximum items" errors=0 n=2 res=[3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	var i = 0;
	var pairs = 0;
	while i < g.n {
		if i + 1 < g.n && ${p}(g.res[i]) && ${p}(g.res[i + 1]) {
			let mx = if g.res[i] > g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
			g.res[new_n] = mx;
			new_n++;
			pairs++;
			i += 2;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
			i++;
		}
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " maximum items");
	out
}
@end
