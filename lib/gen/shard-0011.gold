fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "cannot scale empty array");
		return out;
	}
	let last_idx = g.n - 1;
	let orig = g.res[last_idx];
	let scaled = ${f}(orig);
	g.res[last_idx] = scaled;
	g.steps += 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled last item to ", scaled);
	out
}
@end
