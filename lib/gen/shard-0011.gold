@entry 8562f2b99a978893
kind: step
verb: reverse
noun: series
modifier: until
context: compare
phrase: reverse prefix series until predicate {p}
phrase: invert leading items until {p} matches
slot: p pred
test: list=2,4,6,5,8 p=is_odd
expect: => i=3 r=0.0 ok=true s="reversed 3 prefix items" errors=0 n=5 res=[6,4,2,5,8] cache=0 hits=0
test: list=10,20,105,30 p=over_100
expect: => i=2 r=0.0 ok=true s="reversed 2 prefix items" errors=0 n=4 res=[20,10,105,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stop_idx = g.n;
	for i in g.n {
		if ${p}(g.res[i]) { stop_idx = i; break; }
	}
	var left = 0;
	var right = stop_idx - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "reversed ", stop_idx, " prefix items");
