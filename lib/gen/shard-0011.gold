kind: step
verb: swap
noun: suffix
modifier: nested
context: error
phrase: swap error suffix with nested passes
phrase: reorder trailing errors with nested swaps
test: list=1,2,9,5,3
expect: => i=3 r=0.0 ok=true s="swapped suffix 3 times" errors=0 n=5 res=[1,2,3,5,9] cache=0 hits=0
test: list=10,20,30,40
expect: => i=0 r=0.0 ok=true s="swapped suffix 0 times" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = g.n / 2;
	var swaps = 0;
	if g.n > start + 1 {
		for i in start..g.n {
			for j in start..(g.n - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
					swaps++;
				}
			}
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped suffix ", swaps, " times");
	out
}
@end
