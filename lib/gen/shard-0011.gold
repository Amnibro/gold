code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var passes = 0;
	while passes < r && g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] - g.res[i] > 10 {
				g.res[i + 1] = g.res[i] + 10;
			}
		}
		passes++;
	}
	g.steps += g.n * g.n + passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "filled spaces across rounds ", passes);
	out
}
