		if clamped >= max_clamped { break; }
		let x = g.res[k];
		let is_vowel = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 || x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if is_vowel && x > ceiling_val {
			g.res[k] = ceiling_val;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "vowels clamped count ", clamped);
	out
}
@end
@entry 2d4eed790f3b3a0e
