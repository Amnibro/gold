expect: => i=3 r=0.0 ok=true s="deduped history to 3 sorted items" errors=0 n=3 res=[10,20,40] cache=0 hits=0
test: list=5,3,5,1,3
expect: => i=3 r=0.0 ok=true s="deduped history to 3 sorted items" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var kept = 0;
	for i in g.n {
		if kept == 0 || g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped history to ", kept, " sorted items");
	out
}
@end
