code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if !${cond}(gap) { break; }
		count++;
		i++;
	}
	var left = 0;
	var right = count;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " gaps while condition held");
	out
}
@end
