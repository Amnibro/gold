code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var total = 0;
	var i = g.n - 1;
	while i >= 0 && ${cond}(g.res[i]) {
		total += g.res[i];
		count++;
		i--;
	}
	g.steps += g.n;
	out.i = count;
	out.r = if count > 0 { (total as real) / (count as real) } else { 0.0 };
	out.s.clear();
	format(out.s, "evaluated suffix while condition matched ", count);
	out
}
@end
