code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var valid = false;
	var mid = 0;
	if g.n > 0 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
		mid = g.res[g.n / 2];
		valid = mid >= fl;
	}
	out.ok = valid;
	out.i = mid;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "middle value ", mid, " valid: ", valid);
	out
}
@end
