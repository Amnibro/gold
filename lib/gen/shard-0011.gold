fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var mask = 0;
	while x > 0 {
		let d = x % 10;
		mask = mask | (1 << d);
		x /= 10;
	}
	var unique_digits = 0;
	for b in 10 {
		if (mask & (1 << b)) != 0 { unique_digits++; }
	}
	unique_digits
}
