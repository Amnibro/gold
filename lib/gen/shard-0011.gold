@entry 8a59edd49e203c23
kind: step
verb: swap
noun: minimum
modifier: at_least
context: retry
phrase: swap minimum element if at least {floor_val}
phrase: exchange smallest value meeting at least {floor_val}
slot: floor_val int
test: list=20,10,30 floor_val=5
expect: => i=10 r=0.0 ok=true s="minimum value 10 processed" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,2,30 floor_val=5
expect: => i=2 r=0.0 ok=false s="minimum value 2 processed" errors=1 n=3 res=[10,2,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	if g.n == 0 {
		gold_fail(g, "empty list for minimum swap");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_v = g.res[min_idx];
	if min_v < fl {
		gold_fail(g, "minimum value below floor threshold");
		out.ok = false;
	} else {
		let tmp = g.res[0];
		g.res[0] = min_v;
		g.res[min_idx] = tmp;
	}
	g.steps += g.n;
	out.i = min_v;
	out.s.clear();
	format(out.s, "minimum value ", min_v, " processed");
	out
}
@end
