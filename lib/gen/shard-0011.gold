expect: => i=1 r=0.0 ok=true s="dropped items exceeding threshold 1" errors=0 n=3 res=[15,45,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	let max_drops = ${limit};
	var dropped = 0;
	var kn = 0;
	var kept int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if x > thresh && dropped < max_drops {
			gold_cache_put(g, dropped, x);
			dropped++;
		} else {
			kept[kn] = x;
			kn++;
		}
	}
	for i in kn { g.res[i] = kept[i]; }
	g.n = kn;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped items exceeding threshold ", dropped);
	out
}
@end
