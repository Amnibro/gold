fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < out.s.len {
		var j = i + 1;
		while j < out.s.len {
			if out.s[j] < out.s[i] {
				let t = out.s[i];
				out.s[i] = out.s[j];
				out.s[j] = t;
				swaps++;
			}
			j++;
		}
		i++;
	}
	g.steps += swaps;
	out.i = swaps;
	out
}
