code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var count = 0;
	for k in g.n {
		if core_is_prime(g.res[k]) {
			g.res[k] *= mult;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " prime items");
	out
}
@end
@entry a92c9e808b5330b4
kind: step
verb: scale
noun: loop
modifier: last
context: search
phrase: scale last {count} elements across loop
phrase: multiply trailing search items of size {count}
slot: count int
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="scaled 2 trailing elements" errors=0 n=4 res=[1,2,6,8] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="scaled 1 trailing elements" errors=0 n=3 res=[10,20,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var i = start;
	while i < g.n {
		g.res[i] *= 2;
		i++;
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "scaled ", out.i, " trailing elements");
	out
}
@end
@entry 1fef36f6fbced7eb
kind: step
verb: retry
noun: middle
modifier: until
context: search
phrase: retry search in middle window until finding {target}
phrase: inspect central elements until encountering {target}
slot: target int
test: list=1,5,10,20 target=5
expect: => i=1 r=0.0 ok=true s="middle target found: true" errors=0 n=4 res=[1,5,10,20] cache=0 hits=0
test: list=10,20,30,40 target=99
expect: => i=0 r=0.0 ok=false s="middle target found: false" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	let start = g.n / 4;
	let end_pos = g.n - start;
	var found = false;
	var i = start;
	while i < end_pos {
		if g.res[i] == goal { found = true; break; }
		i++;
	}
	g.steps += end_pos - start;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "middle target found: ", found);
	out
}
@end
@entry 6ad47fb1ea043e60
kind: step
verb: count
noun: cache
modifier: first
context: search
phrase: count cache hits on initial search item
phrase: inspect cache state for first element
test: list=10,20,30
expect: => i=0 r=0.0 ok=false s="first cache check: false" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15
expect: => i=0 r=0.0 ok=false s="first cache check: false" errors=0 n=2 res=[5,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let first_key = g.res[0];
	let cached_val, has_cache = gold_cache_get(g, first_key);
	if !has_cache {
		gold_cache_put(g, first_key, 1);
	}
	g.steps += 1;
	out.ok = has_cache;
	out.i = cached_val;
	out.s.clear();
	format(out.s, "first cache check: ", has_cache);
	out
}
@end
