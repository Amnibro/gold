code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var passed = true;
	var count = 0;
	for k in g.n {
		if ${cond}(g.res[k]) {
			break;
		}
		if g.res[k] > limit {
			passed = false;
			gold_fail(g, "retry exceeds threshold");
			break;
		}
		count++;
	}
	g.steps += count;
	out.ok = passed;
	out.i = count;
	out.s.clear();
	format(out.s, "validated retries up to stop count ", count);
	out
}
@end
