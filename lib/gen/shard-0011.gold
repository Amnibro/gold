expect: 9
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return (${add_val} % 10); }
	var p = 1;
	while p <= x / 10 {
		p *= 10;
	}
	let first_d = x / p;
	let rem = x % p;
	let new_first = (first_d + ${add_val}) % 10;
	new_first * p + rem
}
@end
