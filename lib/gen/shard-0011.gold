noun: runs
modifier: at_least
context: loop
phrase: check consecutive run length reaches at least {min_len}
phrase: verify longest equal run satisfies minimum {min_len}
slot: min_len int
test: list=1,1,1,2,2 min_len=3
expect: => i=3 r=0.0 ok=true s="run of 3 meets minimum 3" errors=0 n=5 res=[1,1,1,2,2] cache=0 hits=0
test: list=1,2,3,4 min_len=2
expect: => i=1 r=0.0 ok=false s="run of 1 below minimum 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var max_run = 1;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
	}
	let required = ${min_len};
	let meets = max_run >= required;
	g.steps += g.n;
	out.ok = meets;
	out.i = max_run;
	out.s.clear();
	if meets {
		format(out.s, "run of ", max_run, " meets minimum ", required);
	} else {
		format(out.s, "run of ", max_run, " below minimum ", required);
	}
	out
}
@end
