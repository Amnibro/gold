code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var sum_diff = 0;
		for i in g.n - 1 {
			sum_diff += g.res[i + 1] - g.res[i];
		}
		let avg_diff = sum_diff / (g.n - 1);
		for i in g.n {
			g.res[i] = if avg_diff > 0 { g.res[i] / avg_diff } else { g.res[i] };
		}
		out.i = avg_diff;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "normalized steps in place by average step ", out.i);
	out
}
@end
