@entry 6c9bdee828635c1c
kind: step
verb: normalize
noun: items
modifier: nested
context: compare
phrase: normalize items nested scale by {factor}
phrase: scale items nested comparison with factor {factor}
slot: factor int
test: list=2,4,6 factor=3
expect: => i=2 r=0.0 ok=true s="normalized nested with min 2 and factor 3" errors=0 n=3 res=[0,6,12] cache=0 hits=0
test: list=1,5,10 factor=2
expect: => i=1 r=0.0 ok=true s="normalized nested with min 1 and factor 2" errors=0 n=3 res=[0,8,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let f = ${factor};
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for nested normalize");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var j = 1;
	while j < g.n {
		if g.res[j] < min_val {
			min_val = g.res[j];
		}
		j++;
	}
	var p = 0;
	while p < g.n {
		g.res[p] = (g.res[p] - min_val) * f;
		p++;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized nested with min ", min_val, " and factor ", f);
	out
}
@end
