code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[>..] = [];
	var suffix_len = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var exists = false;
		for k in seen.len {
			if seen[k] == x { exists = true; break; }
		}
		if exists { break; }
		seen.push(x);
		suffix_len++;
		i--;
	}
	out.i = suffix_len;
	g.steps += suffix_len;
	out.s.clear();
	format(out.s, "unique suffix length ", suffix_len);
	out
}
@end
