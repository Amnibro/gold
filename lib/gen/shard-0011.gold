fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for shift minimum all");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i++;
	}
	var j = 0;
	while j < g.n {
		g.res[j] -= min_val;
		j++;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "shifted all elements by min ", min_val);
	out
}
