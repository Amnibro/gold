expect: => i=1 r=0.0 ok=true s="selected 1 numbers" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "selected 0 items");
		return out;
	}
	let start = if g.n > cnt { g.n - cnt } else { 0 };
	let kept = g.n - start;
	for i in kept {
		g.res[i] = g.res[start + i];
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " numbers");
	out
}
@end
