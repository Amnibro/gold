noun: budget
modifier: unique
context: filter
phrase: select unique items under cost budget {limit}
phrase: filter distinct entries within total budget {limit}
slot: limit int
test: list=10,20,10,30,40 limit=50
expect: => i=30 r=0.0 ok=true s="selected 2 unique items spending 30 of budget 50" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,15,20,25 limit=30
expect: => i=20 r=0.0 ok=true s="selected 2 unique items spending 20 of budget 30" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${limit};
	var spent = 0;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept.len {
			if kept[j] == x {
				seen = true;
				break;
			}
		}
		if !seen && spent + x <= b {
			kept.push(x);
			spent += x;
		}
	}
	g.n = 0;
	for i in kept.len {
		g.res[g.n] = kept[i];
		g.n++;
	}
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "selected ", g.n, " unique items spending ", spent, " of budget ", b);
	out
}
@end
