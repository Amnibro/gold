@entry c361f94c2626f97c
kind: step
verb: filter
noun: tail
modifier: nested
context: search
phrase: filter nested tail pairs meeting cutoff condition {cutoff}
phrase: prune nested tail coordinates falling below {cutoff}
slot: cutoff int
test: list=1,10,2,5,3,20 cutoff=8
expect: => i=2 r=0.0 ok=true s="kept 2 tail pairs" errors=0 n=4 res=[1,10,3,20] cache=0 hits=0
test: list=4,2,5,15 cutoff=10
expect: => i=1 r=0.0 ok=true s="kept 1 tail pairs" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept int[>..] = [];
	var i = 0;
	while i + 1 < g.n {
		let id = g.res[i];
		let score = g.res[i + 1];
		if score >= cut {
			kept.push(id);
			kept.push(score);
		}
		i += 2;
	}
	gold_clear(g);
	for x in kept { gold_push(g, x); }
	g.steps += g.n + kept.len;
	out.i = kept.len / 2;
	out.s.clear();
	format(out.s, "kept ", out.i, " tail pairs");
	out
}
@end
