code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var gaps int[>..] = [];
	for i in (g.n - 1) {
		gaps.push(g.res[i + 1] - g.res[i]);
	}
	for i in gaps.len {
		for j in (i + 1)..gaps.len {
			if gaps[j] > gaps[i] {
				let tmp = gaps[i];
				gaps[i] = gaps[j];
				gaps[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in gaps { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = gaps.len;
	out.s.clear();
	format(out.s, "ranked ", gaps.len, " gaps");
	out
}
@end
