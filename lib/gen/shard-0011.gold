@entry b3499824086c854f
kind: step
verb: sort
noun: window
modifier: recursively
context: loop
phrase: sort loop sliding window recursively with size {win_size}
phrase: recursively order adjacent loop windows of width {win_size}
slot: win_size int
test: list=10,4,8,2,6 win_size=3
expect: => i=3 r=0.0 ok=true s="window sorting advanced to 3" errors=0 n=5 res=[4,8,10,2,6] cache=0 hits=0
test: list=15,9,12,3 win_size=2
expect: => i=4 r=0.0 ok=true s="window sorting advanced to 4" errors=0 n=4 res=[9,15,3,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = if ${win_size} > 1 { ${win_size} } else { 2 };
	var offset = 0;
	while offset + w <= g.n {
		var i = offset;
		while i < offset + w {
			var j = i + 1;
			while j < offset + w {
				if g.res[j] < g.res[i] {
					let t = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = t;
				}
				j++;
			}
			i++;
		}
		offset += w;
	}
	g.steps += g.n;
	out.i = offset;
	out.s.clear();
	format(out.s, "window sorting advanced to ", offset);
	out
}
@end
