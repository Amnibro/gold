fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var tally = 0;
	for i in g.n {
		if g.res[i] > p {
			tally++;
		}
	}
	g.steps += g.n;
	out.i = tally;
	out.s.clear();
	format(out.s, "tail count exceeding pivot is ", tally);
	out
}
