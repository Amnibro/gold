test: list=10,20,30,40 cap=50
expect: => i=60 r=0.0 ok=false s="accumulated error total 60" errors=1 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 cap=100
expect: => i=30 r=0.0 ok=true s="accumulated error total 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_cap = ${cap};
	var running_total = 0;
	var stopped_at = g.n;
	for i in g.n {
		running_total += g.res[i];
		if running_total > max_cap {
			stopped_at = i;
			gold_fail(g, "total error cap reached");
			out.ok = false;
			break;
		}
	}
	g.n = stopped_at;
	g.steps += stopped_at + 1;
	out.i = running_total;
	out.s.clear();
	format(out.s, "accumulated error total ", running_total);
	out
}
@end
