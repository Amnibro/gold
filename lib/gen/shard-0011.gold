expect: => i=5 r=0.0 ok=true s="sorted vowel count 5" errors=0 n=5 res=[65,69,73,79,85] cache=0 hits=0
code:
fn ${ID}_is_vowel(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 ||
	c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels int[>..] = [];
	var idxs int[>..] = [];
	for k in g.n {
		if ${ID}_is_vowel(g.res[k]) {
			vowels.push(g.res[k]);
			idxs.push(k);
		}
	}
	var i = 0;
	while i < vowels.len {
		var j = i + 1;
		while j < vowels.len {
			if vowels[j] < vowels[i] {
				let t = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = t;
			}
			j++;
		}
		i++;
	}
	for k in idxs.len {
		g.res[idxs[k]] = vowels[k];
	}
	g.steps += vowels.len;
	out.i = vowels.len;
	out.s.clear();
	format(out.s, "sorted vowel count ", vowels.len);
	out
}
@end
