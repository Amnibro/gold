fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let flg = ${even_flag};
	var kept = 0;
	for i in g.n {
		let rem = if g.res[i] < 0 { (-g.res[i]) % 2 } else { g.res[i] % 2 };
		if rem == flg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items by parity");
	out
}
