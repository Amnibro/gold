@entry 256eb627b9fe32d6
kind: step
verb: map
noun: range
modifier: in_reverse
context: retry
phrase: map values in reverse range order by {factor}
phrase: transform reverse sequence using multiplier {factor}
slot: factor int
test: list=1,2,3 factor=2
expect: => i=3 r=0.0 ok=true s="reversed and scaled 3 items" errors=0 n=3 res=[6,4,2] cache=0 hits=0
test: list=4,5,6 factor=3
expect: => i=3 r=0.0 ok=true s="reversed and scaled 3 items" errors=0 n=3 res=[18,15,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let t = g.res[i];
		g.res[i] = g.res[j] * mult;
		g.res[j] = t * mult;
	}
	if g.n % 2 != 0 {
		let mid = g.n / 2;
		g.res[mid] = g.res[mid] * mult;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed and scaled ", g.n, " items");
	out
}
@end
