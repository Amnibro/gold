expect: => i=20 r=0.16 ok=true s="total up to cutoff 20 of 125" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var subtotal = 0;
	var full_total = 0;
	for i in g.n {
		full_total += g.res[i];
		if i < lim {
			subtotal += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = subtotal;
	out.r = if full_total > 0 { (subtotal as real) / (full_total as real) } else { 0.0 };
	out.s.clear();
	format(out.s, "total up to cutoff ", subtotal, " of ", full_total);
	out
}
@end
