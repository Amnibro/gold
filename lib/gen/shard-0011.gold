fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept / 2;
	out.s.clear();
	format(out.s, "kept ", out.i, " equal pairs");
