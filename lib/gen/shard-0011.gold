fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k1 = ${start_key};
	gold_cache_put(g, 1, 2);
	gold_cache_put(g, 2, 42);
	let v1, ok1 = gold_cache_get(g, k1);
	if ok1 {
		let v2, ok2 = gold_cache_get(g, v1);
		if ok2 {
			out.i = v2;
			out.ok = true;
		} else {
			out.i = v1;
			out.ok = false;
		}
	} else {
		out.i = -1;
		out.ok = false;
	}
	g.steps += 2;
	out.s.clear();
	format(out.s, "nested cache lookup ", out.i);
	out
}
