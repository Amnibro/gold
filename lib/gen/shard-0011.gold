noun: digits
modifier: nested
context: math
phrase: fold digits across elements into nested sum
phrase: accumulate nested digit sums of all elements
test: list=12,34,56
expect: => i=21 r=0.0 ok=true s="accumulated nested digit sum 21" errors=0 n=3 res=[12,34,56] cache=0 hits=0
test: list=9,19,99
expect: => i=37 r=0.0 ok=true s="accumulated nested digit sum 37" errors=0 n=3 res=[9,19,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		var dsum = 0;
		while n > 0 {
			dsum += n % 10;
			n = n / 10;
		}
		total_digits += dsum;
	}
	g.steps += g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "accumulated nested digit sum ", total_digits);
	out
}
@end
