code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var fixed = 0;
	for i in g.n {
		if g.res[i] < 0 {
			var att = 0;
			while att < r && g.res[i] < 0 {
				g.res[i] = g.res[i] * g.res[i];
				att++;
			}
			fixed++;
		}
	}
	g.steps += g.n + fixed;
	out.i = fixed;
	out.s.clear();
	format(out.s, "retried squares for ", fixed, " items");
	out
}
@end
@entry 1b3b697e6756516f
kind: step
verb: pair
noun: minimum
modifier: last
context: retry
phrase: pair minimum value with last element
phrase: combine smallest item with sequence tail
test: list=5,20,3,10
expect: => i=13 r=0.0 ok=true s="paired minimum with last item to get 13" errors=0 n=4 res=[5,20,3,13] cache=0 hits=0
test: list=8,2
expect: => i=4 r=0.0 ok=true s="paired minimum with last item to get 4" errors=0 n=2 res=[8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for minimum pair");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_v = g.res[min_idx];
	let last_idx = g.n - 1;
	let pair_sum = g.res[last_idx] + min_v;
	g.res[last_idx] = pair_sum;
	g.steps += g.n;
	out.i = pair_sum;
	out.s.clear();
	format(out.s, "paired minimum with last item to get ", pair_sum);
	out
}
@end
