fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var last_idx = -1;
	for i in g.n {
		if g.res[i] > th {
			last_idx = i;
		}
	}
	let dist = if last_idx >= 0 { g.n - 1 - last_idx } else { -1 };
	g.steps += g.n;
	out.i = dist;
	out.s.clear();
	format(out.s, "space after last outlier ", dist);
	out
}
