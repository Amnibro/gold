@entry a16dad93fea5c16f
kind: step
verb: compare
noun: runs
modifier: every_other
context: stats
phrase: compare alternating run durations in observation sequence
phrase: evaluate every other monotonic run length in data
test: list=1,1,2,2,2,3
expect: => i=0 r=0.0 ok=true s="run length difference even minus odd 0" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=5,5,5,9,9,1,1,1,1
expect: => i=5 r=0.0 ok=true s="run length difference even minus odd 5" errors=0 n=9 res=[5,5,5,9,9,1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_idx = 0;
	var even_len = 0;
	var odd_len = 0;
	var i = 0;
	while i < g.n {
		let start = i;
		let val = g.res[i];
		while i < g.n && g.res[i] == val {
			i++;
		}
		let len = i - start;
		if run_idx % 2 == 0 {
			even_len += len;
		} else {
			odd_len += len;
		}
		run_idx++;
	}
	g.steps += g.n;
	out.i = even_len - odd_len;
	out.s.clear();
	format(out.s, "run length difference even minus odd ", out.i);
