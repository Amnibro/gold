kind: step
verb: sum
noun: primes
modifier: in_place
context: compare
phrase: sum prime numbers in place comparison
phrase: accumulate prime values in place
slot: 
test: list=2,3,4,5,6,7
expect: => i=17 r=0.0 ok=true s="summed primes in place total 17" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=10,11,12,13
expect: => i=24 r=0.0 ok=true s="summed primes in place total 24" errors=0 n=4 res=[10,11,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for prime sum");
		out.ok = false;
		return out;
	}
	var prime_total = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_pr = if x >= 2 { true } else { false };
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_pr = false;
				break;
			}
			d++;
		}
		if is_pr {
			prime_total += x;
		}
		i++;
	}
	g.steps += g.n;
	out.i = prime_total;
	out.s.clear();
	format(out.s, "summed primes in place total ", prime_total);
	out
}
@end
@entry 37283e0d3cbaa24b
kind: step
verb: split
noun: suffix
modifier: unique
context: compare
phrase: split suffix elements keeping unique count {length}
phrase: extract unique suffix values of length {length}
slot: length int
test: list=1,2,3,2,3 length=4
expect: => i=2 r=0.0 ok=true s="unique suffix count 2" errors=0 n=5 res=[1,2,3,2,3] cache=0 hits=0
test: list=5,5,5,5 length=3
expect: => i=1 r=0.0 ok=true s="unique suffix count 1" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let len = ${length};
	var out = v;
	if g.n == 0 || len <= 0 {
		gold_fail(g, "invalid length or empty list for unique suffix");
		out.ok = false;
		return out;
	}
	let start = if g.n > len { g.n - len } else { 0 };
	var unique_count = 0;
	var i = start;
	while i < g.n {
		var seen = false;
		var j = start;
		while j < i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			unique_count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique suffix count ", unique_count);
	out
}
@end
