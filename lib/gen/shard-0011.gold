@entry 79614e55103db737
kind: step
verb: fold
noun: gaps
modifier: times
context: retry
phrase: fold retry delay gaps {times} successive iterations
phrase: close retry gaps across {times} reduction rounds
slot: times int
test: list=1,10,20 times=2
expect: => i=2 r=0.0 ok=true s="folded gaps across rounds 2" errors=0 n=3 res=[3,10,18] cache=0 hits=0
test: list=5,15,25 times=3
expect: => i=3 r=0.0 ok=true s="folded gaps across rounds 3" errors=0 n=3 res=[8,15,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rounds = ${times};
	var r = 0;
	while r < rounds {
		var i = 0;
		while i + 1 < g.n {
			let diff = g.res[i + 1] - g.res[i];
			if diff > 2 {
				g.res[i] += 1;
				g.res[i + 1] -= 1;
			}
			i++;
		}
		r++;
	}
	g.steps += rounds * g.n;
	out.i = rounds;
	out.s.clear();
	format(out.s, "folded gaps across rounds ", rounds);
	out
}
@end
