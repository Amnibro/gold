code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	let lim = if bound > g.n { g.n } else if bound < 0 { 0 } else { bound };
	for i in lim / 2 {
		let j = lim - 1 - i;
		let temp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = temp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed series up to ", lim);
	out
}
@end
