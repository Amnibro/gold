slot: offset int
test: text="abc" offset=1
expect: => i=3 r=0.0 ok=true s="bcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" offset=2
expect: => i=3 r=0.0 ok=true s="zab" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if out.s.len == 0 {
		gold_fail(g, "empty retry text for recursive shift");
		out.ok = false;
		return out;
	}
	for i in out.s.len {
		let b = out.s[i] as int;
		if b >= 'a' && b <= 'z' {
			let shifted = (b - 'a' + off) % 26 + 'a';
			out.s[i] = shifted as byte;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
