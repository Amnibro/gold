@entry 2a740e2fb58446cc
kind: step
verb: select
noun: middle
modifier: recursively
context: sort
phrase: select recursive median pivot element
phrase: pick middle pivot value recursively
test: list=9,2,7,4,1
expect: => i=7 r=0.0 ok=true s="selected median pivot 7" errors=0 n=5 res=[7,2,7,4,1] cache=0 hits=0
test: list=15,3,8
expect: => i=8 r=0.0 ok=true s="selected median pivot 8" errors=0 n=3 res=[8,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = if g.n > 0 { g.res[0] } else { 0 };
		out.s.clear();
		format(out.s, "too few elements for median of three");
		return out;
	}
	let a = g.res[0];
	let b = g.res[g.n / 2];
	let c = g.res[g.n - 1];
	var med = b;
	if (a <= b && b <= c) || (c <= b && b <= a) { med = b; }
	else if (b <= a && a <= c) || (c <= a && a <= b) { med = a; }
	else { med = c; }
	g.res[0] = med;
	g.steps += 3;
	out.i = med;
	out.s.clear();
	format(out.s, "selected median pivot ", med);
	out
}
@end
