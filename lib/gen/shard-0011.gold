test: text="a bb ccc"
expect: => i=1 r=0.0 ok=true s="paired 1 gaps between spaces" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var space_pos int[256] = [0; 256];
	var s_count = 0;
	for i in out.s.len {
		if out.s[i] == ' ' && s_count < 256 {
			space_pos[s_count] = i;
			s_count++;
		}
	}
	if s_count >= 2 {
		let num_gaps = s_count - 1;
		for i in num_gaps {
			g.res[i] = space_pos[i + 1] - space_pos[i] - 1;
		}
		g.n = num_gaps;
		out.i = num_gaps;
	} else {
		g.n = 0;
		out.i = 0;
	}
	g.steps += out.s.len;
	out.s.clear();
	format(out.s, "paired ", out.i, " gaps between spaces");
	out
}
@end
