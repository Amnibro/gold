fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n {
		g.res[i] -= avg;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "applied average ", avg, " across items");
	out
}
@end
