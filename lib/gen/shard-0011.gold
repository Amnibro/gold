@entry bc3ee4832c5f9dd7
kind: step
verb: drop
noun: maximum
modifier: unique
context: format
phrase: drop unique maximum value formatting distinct remainder
phrase: format unique set dropping single maximum element
test: list=10,20,30,20,10
expect: => i=2 r=0.0 ok=true s="remainder: {10, 20}" errors=0 n=5 res=[10,20,30,20,10] cache=0 hits=0
test: list=5,15,25,25
expect: => i=2 r=0.0 ok=true s="remainder: {5, 15}" errors=0 n=4 res=[5,15,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var seen int[512] = [0; 512];
	var sc = 0;
	out.s.clear();
	out.s.append("remainder: {");
	for i in g.n {
		let x = g.res[i];
		if x != max_val {
			var was_seen = false;
			for j in sc { if seen[j] == x { was_seen = true; break; } }
			if !was_seen {
				if sc > 0 { out.s.append(", "); }
				seen[sc] = x;
				format(out.s, x);
				sc++;
			}
		}
	}
	out.s.append("}");
	g.steps += g.n;
	out.i = sc;
	out
}
@end
