	var first_odd = 0;
	while first_odd < g.n && g.res[first_odd] % 2 == 0 {
		first_odd++;
	}
	let dropped = first_odd;
	var i = 0;
	while first_odd + i < g.n {
		g.res[i] = g.res[first_odd + i];
		i++;
	}
	g.n = i;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " leading evens");
