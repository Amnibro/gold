@entry 39e36541cffaf0ca
kind: step
verb: cache
noun: counter
modifier: at_least
context: cache
phrase: cache occurrence counter for values appearing at least {min_count} times
phrase: record frequency counter in cache for items at least {min_count}
slot: min_count int
test: list=10,20,10,30,20,10 min_count=2
expect: => i=2 r=0.0 ok=true s="cached frequency counters count 2" errors=0 n=6 res=[10,20,10,30,20,10] cache=2 hits=0
test: list=5,5,5,8,9 min_count=3
expect: => i=1 r=0.0 ok=true s="cached frequency counters count 1" errors=0 n=5 res=[5,5,5,8,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_count};
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for k in g.n {
				if g.res[k] == x { freq++; }
			}
			if freq >= thresh {
				gold_cache_put(g, x, freq);
				matched++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "cached frequency counters count ", matched);
	out
}
@end
