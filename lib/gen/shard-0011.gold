noun: numbers
modifier: recursively
context: sort
phrase: swap numbers into ascending order
phrase: quicksort partition swap around first element
test: list=5,2,8,1,9
expect: => i=2 r=0.0 ok=true s="partitioned at index 2" errors=0 n=5 res=[1,2,5,8,9] cache=0 hits=0
test: list=3,1,4,2
expect: => i=2 r=0.0 ok=true s="partitioned at index 2" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let p = g.res[0];
		var left = 0;
		for i in 1..g.n {
			if g.res[i] <= p {
				left++;
				let tmp = g.res[left];
				g.res[left] = g.res[i];
				g.res[i] = tmp;
			}
		}
		let tmp = g.res[0];
		g.res[0] = g.res[left];
		g.res[left] = tmp;
		out.i = left;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "partitioned at index ", out.i);
	out
}
@end
