@entry 04e60423d48fbb9e
kind: step
verb: rotate
noun: condition
modifier: nested
context: compare
phrase: rotate comparison elements while condition {cond} holds with shift {shift}
phrase: shift matching comparison sequence under condition {cond} by {shift}
slot: cond pred
slot: shift int
test: list=2,4,6,7,8 cond=is_even shift=1
expect: => i=1 r=0.0 ok=true s="rotated matching prefix shift 1" errors=0 n=5 res=[4,6,2,7,8] cache=0 hits=0
test: list=1,3,5,4 cond=is_odd shift=2
expect: => i=2 r=0.0 ok=true s="rotated matching prefix shift 2" errors=0 n=4 res=[5,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var span = 0;
	while span < g.n && ${cond}(g.res[span]) { span++; }
	if span > 1 {
		let s = (${shift} % span + span) % span;
		var rot = 0;
		while rot < s {
			let first = g.res[0];
			for i in 1..span {
				g.res[i - 1] = g.res[i];
			}
			g.res[span - 1] = first;
			rot++;
		}
		g.steps += rot * span;
		out.i = s;
	} else {
		out.i = 0;
	}
	g.steps += span;
	out.s.clear();
