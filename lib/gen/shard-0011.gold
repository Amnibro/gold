fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mismatches = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				mismatches++;
			}
		}
	}
	if mismatches > 0 {
		gold_fail(g, "pairwise order mismatch");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps += g.n;
	out.i = mismatches;
	out.s.clear();
	format(out.s, "detected ", mismatches, " comparison order mismatches");
	out
}
@end
