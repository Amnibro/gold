expect: => i=2 r=0.0 ok=true s="sorted last iterations count 2" errors=0 n=4 res=[20,10,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let k = if cnt < g.n { cnt } else { g.n };
	let start = g.n - k;
	var i = start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "sorted last iterations count ", k);
	out
}
