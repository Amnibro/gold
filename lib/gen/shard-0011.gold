phrase: filter sort elements with gap at least {min_gap}
slot: min_gap int
test: list=10,12,25,27,50 min_gap=5
expect: => i=2 r=0.0 ok=true s="sorted gaps count 2" errors=0 n=2 res=[13,23] cache=0 hits=0
test: list=1,2,3,10,20 min_gap=4
expect: => i=2 r=0.0 ok=true s="sorted gaps count 2" errors=0 n=2 res=[7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var w = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d >= gap {
			g.res[w] = d;
			w++;
		}
	}
	var i = 0;
	while i < w {
		var j = i + 1;
		while j < w {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "sorted gaps count ", w);
	out
}
@end
@entry fc6ec09f954431cd
kind: step
verb: dedupe
noun: letters
modifier: between
context: filter
phrase: dedupe letters located between boundary indices {left} {right}
phrase: remove duplicate characters between slice bounds {left} {right}
slot: left int
slot: right int
test: text="abracadabra" left=2 right=8
expect: => i=9 r=0.0 ok=true s="abracdbra" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana" left=1 right=4
expect: => i=4 r=0.0 ok=true s="bana" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${left};
	let r = ${right};
	if l < 0 || r >= out.s.len || l >= r {
		gold_fail(g, "invalid slice for letter dedupe");
		out.ok = false;
		return out;
	}
	var seen byte[256] = [0; 256];
	var w = l;
	var i = l;
	while i <= r {
		let ch = out.s[i] as int;
		if seen[ch] == 0 {
			seen[ch] = 1;
			out.s[w] = out.s[i];
			w++;
		}
		i++;
	}
	var tail = r + 1;
	while tail < out.s.len {
		out.s[w] = out.s[tail];
		w++;
		tail++;
	}
	while out.s.len > w {
		out.s.pop();
	}
	g.steps += out.s.len;
	out.i = w;
	out
}
@end
