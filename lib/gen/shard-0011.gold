@entry e55f70074eae4ba4
kind: step
verb: retry
noun: evens
modifier: unique
context: format
phrase: format retry pass gathering unique even values
phrase: render distinct even elements collected across retries
test: list=2,2,4,4,6
expect: => i=3 r=0.0 ok=true s="unique evens: [2, 4, 6]" errors=0 n=5 res=[2,2,4,4,6] cache=0 hits=0
test: list=1,2,3,4,4
expect: => i=2 r=0.0 ok=true s="unique evens: [2, 4]" errors=0 n=5 res=[1,2,3,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = false;
			for u in uniq { if u == x { seen = true; break; } }
			if !seen { uniq.push(x); }
		}
	}
	out.s.clear();
	format(out.s, "unique evens: [");
	for i in uniq.len {
		if i > 0 { format(out.s, ", "); }
		format(out.s, uniq[i]);
	}
	format(out.s, "]");
	out.i = uniq.len;
	g.steps += g.n * uniq.len;
	out
}
@end
