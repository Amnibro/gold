@entry fb9b8ac3b28e63b5
kind: step
verb: return
noun: evens
modifier: first
context: sort
phrase: return sorted array partition placing even numbers first
phrase: order results with evens sorted ahead of odds
test: list=5,2,8,1,4
expect: => i=3 r=0.0 ok=true s="placed 3 evens first" errors=0 n=5 res=[2,4,8,1,5] cache=0 hits=0
test: list=3,7,6,2,9
expect: => i=2 r=0.0 ok=true s="placed 2 evens first" errors=0 n=5 res=[2,6,3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[>..] = [];
	var odds int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 == 0 { evens.push(g.res[i]); }
		else { odds.push(g.res[i]); }
	}
	for i in evens.len {
		for j in (i + 1)..evens.len {
			if evens[j] < evens[i] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
		}
	}
	for i in odds.len {
		for j in (i + 1)..odds.len {
			if odds[j] < odds[i] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for x in evens { gold_push(g, x); }
	for x in odds { gold_push(g, x); }
	g.steps += g.n * g.n;
	out.i = evens.len;
	out.s.clear();
	format(out.s, "placed ", evens.len, " evens first");
	out
}
@end
