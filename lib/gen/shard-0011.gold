test: list=2,2,2,3,3,4,4,4,4
expect: => i=0 r=0.0 ok=true s="alternate runs capped 0" errors=0 n=9 res=[2,2,2,3,3,4,4,4,4] cache=0 hits=0
test: list=1,1,1,1,5,5,9,9,9
expect: => i=0 r=0.0 ok=true s="alternate runs capped 0" errors=0 n=9 res=[1,1,1,1,5,5,9,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_idx = 0;
	var i = 0;
	var capped = 0;
	while i < g.n {
		let start = i;
		let val = g.res[i];
		while i < g.n && g.res[i] == val {
			i++;
		}
		let len = i - start;
		if run_idx % 2 == 1 && len > 2 {
			capped++;
		}
		run_idx++;
	}
	g.steps += g.n;
	out.i = capped;
	out.s.clear();
	format(out.s, "alternate runs capped ", capped);
	out
}
@end
