expect: 30
expect: 50
test: arg=10,20 count=2
expect: 0
expect: 0
code:
fn ${ID}(n int) int {
	let k = ${count};
	var x = if n < 0 { -n } else { n };
	let base = x % 10;
	var sum = 0;
	var i = 1;
	while i <= k {
		sum += i * base;
		i++;
	}
	sum
}
@end
