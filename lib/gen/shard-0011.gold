expect: => i=200 r=0.0 ok=true s="moved minimum error 200 to head" errors=0 n=4 res=[200,404,500,300] cache=0 hits=0
test: list=10,20,30
expect: => i=10 r=0.0 ok=true s="moved minimum error 10 to head" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty error list for minimum swap");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_v = g.res[min_idx];
	g.res[min_idx] = g.res[0];
	g.res[0] = min_v;
	g.steps += g.n;
	out.i = min_v;
	out.s.clear();
