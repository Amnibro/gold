expect: => i=20 r=0.0 ok=true s="scaled max: 20 (rounds=0)" errors=0 n=3 res=[10,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var scaled = 0;
	while ${cond}(g.res[max_idx]) && scaled < 5 {
		g.res[max_idx] = g.res[max_idx] * 2;
		scaled++;
	}
	out.s.clear();
	format(out.s, "scaled max: ", g.res[max_idx], " (rounds=", scaled, ")");
	out.i = g.res[max_idx];
	g.steps += g.n + scaled;
	out
}
@end
