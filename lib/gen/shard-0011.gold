noun: threshold
modifier: at_most
context: cache
phrase: drop cached elements exceeding threshold at most {limit} times
phrase: remove items past threshold up to limit {limit}
slot: threshold int
slot: limit int
test: list=10,50,20,60,30 threshold=40 limit=2
expect: => i=2 r=0.0 ok=true s="dropped items exceeding threshold 2" errors=0 n=3 res=[10,20,30] cache=2 hits=0
