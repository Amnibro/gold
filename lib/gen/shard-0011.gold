test: list=3,4,5,6
expect: => i=86 r=0.0 ok=true s="normalized squares all total 86" errors=0 n=4 res=[9,16,25,36] cache=0 hits=0
test: list=10,12,15
expect: => i=69 r=0.0 ok=true s="normalized squares all total 69" errors=0 n=3 res=[0,44,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for squares normalization");
		out.ok = false;
		return out;
	}
	var sum_sq = 0;
	var i = 0;
	while i < g.n {
		g.res[i] = (g.res[i] * g.res[i]) % 100;
		sum_sq += g.res[i];
		i++;
	}
	g.steps += g.n;
	out.i = sum_sq;
	out.s.clear();
	format(out.s, "normalized squares all total ", sum_sq);
