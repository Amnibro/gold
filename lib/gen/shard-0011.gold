	for i in g.n { total += g.res[i]; }
	var count_above = 0;
	if g.n > 0 {
		let avg = total / g.n;
		for i in g.n {
			if g.res[i] > avg { count_above++; }
		}
	}
	g.steps += g.n;
	out.i = count_above;
	out.ok = total >= target;
	out.s.clear();
	format(out.s, "elements above average: ", count_above);
	out
}
