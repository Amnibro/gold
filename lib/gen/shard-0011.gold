fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var steps_count = 0;
	for i in g.n {
		var x = g.res[i];
		if x % 2 != 0 {
			var r = 0;
			while x % 2 != 0 && r < 10 {
				x = x * 3 + 1;
				while x % 2 == 0 { x = x / 2; }
				r++;
			}
			steps_count += r;
		}
	}
	g.steps += g.n;
	out.i = steps_count;
	out.s.clear();
	format(out.s, "recursive odd cycles: ", steps_count);
	out
}
@end
