@entry 4eb90daad3e33d56
kind: step
verb: measure
noun: words
modifier: in_reverse
context: aggregate
phrase: measure word lengths in reverse from flowing text
phrase: compute reverse lengths of words found in string
test: text="hello world from helium"
expect: => i=4 r=0.0 ok=true s="measured 4 word lengths in reverse" errors=0 n=4 res=[6,4,5,5] cache=0 hits=0
test: text="alpha beta gamma"
expect: => i=3 r=0.0 ok=true s="measured 3 word lengths in reverse" errors=0 n=3 res=[5,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var cur_len = 0;
	var lens int[>..] = [];
	for b in v.s {
		if b == ' ' {
			if cur_len > 0 { lens.push(cur_len); cur_len = 0; }
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 { lens.push(cur_len); }
	var k = lens.len - 1;
	while k >= 0 {
		gold_push(g, lens[k]);
		k--;
	}
	g.steps += v.s.len + lens.len;
	out.i = g.n;
	out.s.clear();
	format(out.s, "measured ", g.n, " word lengths in reverse");
	out
}
@end
