	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid limit for caching retry items");
		out.ok = false;
		return out;
	}
	var count = 0;
	while count < lim && count < g.n {
		gold_cache_put(g, count + 1, g.res[count]);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached retry items count ", count);
	out
}
@end
