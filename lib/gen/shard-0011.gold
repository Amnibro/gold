fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid = g.res[g.n / 2];
	g.steps += g.n * g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "selected middle element ", mid);
	out
}
@end
