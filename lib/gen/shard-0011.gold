kind: step
verb: merge
noun: values
modifier: nested
context: sort
phrase: merge nested sorted halves
phrase: combine nested sorted segments
test: list=1,4,7,2,5,8
expect: => i=6 r=0.0 ok=true s="merged 6 values into order" errors=0 n=6 res=[1,2,4,5,7,8] cache=0 hits=0
test: list=3,6,1,9
expect: => i=4 r=0.0 ok=true s="merged 4 values into order" errors=0 n=4 res=[1,3,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged ", g.n, " values into order");
	out
}
@end
@entry 0510f58231dee09a
kind: step
verb: swap
noun: step
modifier: nested
context: sort
phrase: swap adjacent inversions with nested passes
phrase: bubble sort elements with nested steps
test: list=4,2,7,1,3
expect: => i=6 r=0.0 ok=true s="bubble swapped 6 times" errors=0 n=5 res=[1,2,3,4,7] cache=0 hits=0
test: list=9,5,2
expect: => i=3 r=0.0 ok=true s="bubble swapped 3 times" errors=0 n=3 res=[2,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_swaps = 0;
	if g.n > 1 {
		var changed = true;
		while changed {
			changed = false;
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let temp_val = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = temp_val;
					total_swaps++;
					changed = true;
				}
			}
		}
	}
	g.steps += total_swaps + 1;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "bubble swapped ", total_swaps, " times");
	out
}
@end
