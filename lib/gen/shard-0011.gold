@entry ed4e3492ff7dfb55
kind: step
verb: dedupe
noun: total
modifier: each
context: aggregate
phrase: dedupe running total for each sequence element
phrase: filter duplicate totals across each aggregate step
test: list=1,2,0,3
expect: => i=3 r=0.0 ok=true s="deduped totals count 3" errors=0 n=3 res=[1,3,6] cache=0 hits=0
test: list=5,0,0,5
expect: => i=2 r=0.0 ok=true s="deduped totals count 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var w = 0;
	for i in g.n {
		sum += g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == sum { seen = true; break; }
		}
		if !seen {
			g.res[w] = sum;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped totals count ", w);
	out
}
@end
