phrase: keep values with occurrence counts bounded up to {threshold}
slot: threshold int
test: list=1,2,2,3,3,3 threshold=2
expect: => i=3 r=0.0 ok=true s="selected items by frequency count 3" errors=0 n=3 res=[1,2,2] cache=0 hits=0
test: list=5,5,5,6,7,7 threshold=1
expect: => i=1 r=0.0 ok=true s="selected items by frequency count 1" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_freq = ${threshold};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq <= max_freq {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected items by frequency count ", kept);
	out
}
@end
