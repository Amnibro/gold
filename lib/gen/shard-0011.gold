@entry a1aa082dc3fc6069
kind: step
verb: rotate
noun: threshold
modifier: up_to
context: search
phrase: rotate search results exceeding threshold up to limit {cutoff} {limit}
phrase: cycle items exceeding threshold within bound {cutoff} {limit}
slot: cutoff int
slot: limit int
test: list=50,10,60,70,80 cutoff=40 limit=4
expect: => i=3 r=0.0 ok=true s="rotated threshold count 3" errors=0 n=5 res=[60,10,70,50,80] cache=0 hits=0
test: list=30,40,50 cutoff=25 limit=2
expect: => i=2 r=0.0 ok=true s="rotated threshold count 2" errors=0 n=3 res=[40,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	let lim = ${limit};
	var bound = lim;
	if bound > g.n { bound = g.n; }
	var indices int[>..] = [];
	for i in bound {
		if g.res[i] >= cut { indices.push(i); }
	}
	if indices.len > 1 {
		let first_val = g.res[indices[0]];
		for k in 1..indices.len {
			g.res[indices[k - 1]] = g.res[indices[k]];
		}
		g.res[indices[indices.len - 1]] = first_val;
	}
	g.steps += bound + indices.len;
	out.i = indices.len;
	out.s.clear();
	format(out.s, "rotated threshold count ", indices.len);
	out
}
@end
@entry 5019cda0d05a4116
kind: step
verb: return
noun: squares
modifier: up_to
context: search
phrase: return perfect squares found in search up to limit {limit}
phrase: count square numbers up to bound {limit}
slot: limit int
test: list=4,7,9,16,20 limit=4
expect: => i=3 r=0.0 ok=true s="squares count 3" errors=0 n=5 res=[4,7,9,16,20] cache=0 hits=0
test: list=1,2,3,4 limit=2
expect: => i=1 r=0.0 ok=true s="squares count 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var bound = lim;
	if bound > g.n { bound = g.n; }
	var sq_count = 0;
	for i in bound {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq_count++; }
		}
	}
	out.i = sq_count;
	g.steps += bound;
	out.s.clear();
	format(out.s, "squares count ", sq_count);
	out
}
@end
