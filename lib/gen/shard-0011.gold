fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bal = ${budget};
	let c = ${cost};
	var iterations = 0;
	gold_clear(g);
	while bal >= c && c > 0 {
		bal -= c;
		gold_push(g, bal);
		iterations++;
	}
	out.i = bal;
	g.steps += iterations;
	out.s.clear();
	format(out.s, "completed ", iterations, " steps remaining ", bal);
	out
}
@end
