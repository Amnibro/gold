@entry 3e2656d5e1f78a2d
kind: step
verb: join
noun: streak
modifier: recursively
context: math
phrase: join longest contiguous increasing streak
phrase: consolidate longest ascending streak recursively
test: list=1,3,2,4,5,6,1
expect: => i=17 r=0.0 ok=true s="joined longest streak of length 4" errors=0 n=4 res=[2,4,5,6] cache=0 hits=0
test: list=5,4,1,2,3
expect: => i=6 r=0.0 ok=true s="joined longest streak of length 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
	}
	var streak_sum = 0;
	for i in best_len {
		g.res[i] = g.res[best_start + i];
		streak_sum += g.res[i];
	}
	g.n = best_len;
	g.steps += g.n;
	out.i = streak_sum;
	out.s.clear();
	format(out.s, "joined longest streak of length ", best_len);
	out
}
@end
