	var counts int[10] = [0; 10];
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var dups = 0;
	for c in counts {
		if c > 1 {
			dups += (c - 1);
		}
	}
	dups * ${times}
}
