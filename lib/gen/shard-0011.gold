code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${copies};
	if k <= 0 || g.n * k > 512 {
		gold_fail(g, "invalid repeat count or capacity exceeded");
		out.ok = false;
		return out;
	}
	var temp int[512] = [0; 512];
	var total = 0;
	for i in g.n {
		for c in k {
			temp[total] = g.res[i];
			total++;
		}
	}
	for i in total {
		g.res[i] = temp[i];
	}
	g.steps += total;
	g.n = total;
	out.i = total;
	out.s.clear();
	format(out.s, "repeated values into ", total, " items");
	out
}
@end
