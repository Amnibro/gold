@entry ee2ccbe04cb8c0fb
kind: step
verb: merge
noun: primes
modifier: first
context: compare
phrase: merge prime elements into leading positions
phrase: partition prime elements to front
test: list=4,3,6,5,8,7
expect: => i=3 r=0.0 ok=true s="partitioned 3 primes to front" errors=0 n=6 res=[3,5,7,4,6,8] cache=0 hits=0
test: list=9,2,10,11
expect: => i=2 r=0.0 ok=true s="partitioned 2 primes to front" errors=0 n=4 res=[2,11,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var non_primes int[512] = [0; 512];
	var pn = 0;
	var npn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = false;
		if x >= 2 {
			is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[pn] = x;
			pn++;
		} else {
			non_primes[npn] = x;
			npn++;
		}
	}
	for i in pn { g.res[i] = primes[i]; }
	for i in npn { g.res[pn + i] = non_primes[i]; }
	g.steps += g.n * 2;
	out.i = pn;
	out.s.clear();
	format(out.s, "partitioned ", pn, " primes to front");
	out
}
@end
