fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${k};
	if mult <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let orig_n = g.n;
	var orig int[512] = [0; 512];
	for i in orig_n { orig[i] = g.res[i]; }
	var idx = 0;
	for m in mult {
		for i in orig_n {
			if idx < 512 {
				g.res[idx] = orig[i];
				idx++;
			}
		}
	}
	g.steps += idx;
	g.n = idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "repeated series to ", idx, " items");
	out
}
@end
