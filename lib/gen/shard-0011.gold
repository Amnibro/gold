noun: middle
modifier: times
context: error
phrase: rotate middle elements repeated count times {times}
phrase: cycle interior values times {times}
slot: times int
test: list=1,2,3,4,5 times=1
expect: => i=3 r=0.0 ok=true s="rotated middle length 3" errors=0 n=5 res=[1,3,4,2,5] cache=0 hits=0
test: list=1,2 times=1
expect: => i=0 r=0.0 ok=false s="error: insufficient elements" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n < 3 {
		gold_fail(g, "too few elements for middle rotation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient elements");
		return out;
	}
	let mid_len = g.n - 2;
	for _ in t {
		let first_mid = g.res[1];
		for i in 2..(g.n - 1) {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 2] = first_mid;
	}
	g.steps += t * mid_len;
	out.i = mid_len;
	out.s.clear();
	format(out.s, "rotated middle length ", mid_len);
	out
}
@end
