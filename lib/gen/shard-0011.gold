fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[>..] = [];
	var last_space = false;
	for i in out.s.len {
		let ch = out.s[i];
		if ch == ' ' {
			if !last_space {
				res.push(ch);
				last_space = true;
			}
		} else {
			res.push(ch);
			last_space = false;
		}
	}
	g.steps += out.s.len + 1;
	out.s.clear();
	out.s.append(res);
	out.i = out.s.len;
	out
}
@end
