		p++;
	}
	out.s.clear();
	format(out.s, "scanned digit sums: [");
	for k in g.n {
		if k > 0 { format(out.s, ", "); }
		format(out.s, g.res[k]);
	}
	format(out.s, "]");
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	g.steps += r * g.n;
	out
}
