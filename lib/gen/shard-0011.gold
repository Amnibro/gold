test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="limited reverse items count 2" errors=0 n=2 res=[40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let k = ${count};
	var out = v;
	if g.n == 0 || k <= 0 {
		gold_fail(g, "invalid count or empty list for limit reverse");
		out.ok = false;
		return out;
	}
	var temp int[512] = [0; 512];
	var kept = 0;
	var i = g.n - 1;
	while i >= 0 && kept < k {
		temp[kept] = g.res[i];
		kept++;
		i--;
	}
	var j = 0;
	while j < kept {
		g.res[j] = temp[j];
		j++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited reverse items count ", kept);
	out
}
@end
