test: list=1,3,5
expect: => i=9 r=0.0 ok=true s="merged sorted sequence into 9" errors=0 n=1 res=[9] cache=0 hits=0
test: list=2,4,6,8
expect: => i=20 r=0.0 ok=true s="merged sorted sequence into 20" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	if g.n > 1 {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				is_sorted = false;
				break;
			}
		}
	}
	if !is_sorted {
		gold_fail(g, "sequence is not sorted for merge");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	gold_clear(g);
	gold_push(g, total);
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "merged sorted sequence into ", total);
	out
}
@end
