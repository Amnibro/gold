fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept.len {
			if kept[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			kept.push(x);
		}
	}
	g.n = 0;
	for i in kept.len {
		g.res[g.n] = kept[i];
		g.n++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scanned ", g.n, " unique numbers");
	out
}
