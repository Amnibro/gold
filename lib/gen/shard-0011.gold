	let k = ${count};
	if k <= 0 || g.n == 0 {
		out.ok = false;
		gold_fail(g, "invalid range for last sort");
		return out;
	}
	var start = if g.n > k { g.n - k } else { 0 };
	var i = start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "sorted last range count ", out.i);
	out
}
