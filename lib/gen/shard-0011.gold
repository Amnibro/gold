fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	gold_clear(g);
	var count = 0;
	var i = 0;
	while i < g.cn && count < limit {
		gold_push(g, g.cv[i]);
		count++;
		i++;
	}
	g.steps += g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "selected memo entries ", count);
	out
}
