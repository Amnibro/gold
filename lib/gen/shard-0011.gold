@entry e4a449a9bf4d0029
kind: step
verb: cache
noun: counter
modifier: sorted
context: text
phrase: cache sorted frequencies of character occurrences
phrase: store character count tally sorted into cache
test: text="banana"
expect: => i=3 r=0.0 ok=true s="banana" errors=0 n=0 res=[] cache=3 hits=0
test: text="abc"
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var freqs int[>..] = [];
	for i in out.s.len {
		let ch = out.s[i];
		var seen = false;
		for j in i {
			if out.s[j] == ch { seen = true; break; }
		}
		if !seen {
			var count = 0;
			for j in out.s.len {
				if out.s[j] == ch { count++; }
			}
			freqs.push(count);
		}
	}
	for i in freqs.len {
		for j in (i + 1)..freqs.len {
			if freqs[j] < freqs[i] {
				let tmp = freqs[i];
				freqs[i] = freqs[j];
				freqs[j] = tmp;
			}
		}
	}
	for i in freqs.len {
		gold_cache_put(g, i, freqs[i]);
	}
	g.steps += out.s.len * out.s.len + 1;
	out.i = freqs.len;
	out
}
@end
