fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	var matched = 0;
	var i = 0;
	while i < g.n && ${cond}(g.res[i]) {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		matched++;
		i++;
	}
	g.steps += g.n;
	out.i = if matched > 0 { min_val } else { 0 };
	out.s.clear();
	format(out.s, "collected minimum while matched ", matched, " min ", out.i);
	out
}
