phrase: limit repeating streak length to threshold {max_streak}
slot: max_streak int
test: list=1,1,1,2,2,3 max_streak=2
expect: => i=5 r=0.0 ok=true s="streak limited: 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 max_streak=1
expect: => i=1 r=0.0 ok=true s="streak limited: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_streak};
	var w = 0;
	var run = 0;
	for i in g.n {
		if i > 0 && g.res[i] == g.res[i - 1] {
			run++;
		} else {
			run = 1;
		}
		if run <= limit {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "streak limited: ", w);
	g.steps += g.n;
	out
}
@end
