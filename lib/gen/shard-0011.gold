	if g.n >= 2 {
		var k = 0;
		while k < r {
			let tmp = g.res[g.n - 1];
			g.res[g.n - 1] = g.res[g.n - 2];
			g.res[g.n - 2] = tmp;
			k++;
		}
		out.i = g.res[g.n - 1];
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "tail swapped: ", out.i);
	g.steps += r;
	out
}
