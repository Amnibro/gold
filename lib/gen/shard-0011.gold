test: list=5,1,5,2,8,3,5
expect: => i=2 r=0.0 ok=true s="alternating unique count 2" errors=0 n=7 res=[5,1,5,2,8,3,5] cache=0 hits=0
test: list=10,9,20,8,10,7,30
expect: => i=3 r=0.0 ok=true s="alternating unique count 3" errors=0 n=7 res=[10,9,20,8,10,7,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[>..] = [];
	var i = 0;
	while i < g.n {
		alt.push(g.res[i]);
		i += 2;
	}
	var uniq = 0;
	for x, idx in alt {
		var first = true;
		for j in idx {
			if alt[j] == x { first = false; break; }
		}
		if first { uniq++; }
	}
	g.steps += g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "alternating unique count ", uniq);
	out
}
@end
