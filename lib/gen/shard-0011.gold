test: list=5,7,8,10 gap=3
expect: => i=14 r=0.0 ok=true s="expanded sorted spacing peak 14" errors=0 n=4 res=[5,8,11,14] cache=0 hits=0
test: list=1,2,3,4 gap=4
expect: => i=13 r=0.0 ok=true s="expanded sorted spacing peak 13" errors=0 n=4 res=[1,5,9,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	for i in 1..g.n {
		let expected = g.res[i - 1] + min_gap;
		if g.res[i] < expected {
			g.res[i] = expected;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "expanded sorted spacing peak ", out.i);
	out
}
@end
