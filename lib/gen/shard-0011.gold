fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	let start = if low >= 0 { low } else { 0 };
	let end = if high < g.n { high + 1 } else { g.n };
	var swaps = 0;
	if start < end {
		for i in start..end {
			for j in (i + 1)..end {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
					swaps++;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps applied between range ", swaps);
	out
}
@end
@entry 711b446de52a1abe
kind: step
verb: drop
noun: digits
modifier: while
context: sort
phrase: drop inverted digits from text while condition {cond} holds
phrase: prune out of order digit characters while {cond} succeeds
slot: cond pred
test: text="987654" cond=is_even
expect: => i=3 r=0.0 ok=true s="975" errors=0 n=0 res=[] cache=0 hits=0
test: text="97531" cond=is_odd
expect: => i=4 r=0.0 ok=true s="9" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept byte[..200] = "";
	var dropped = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			if kept.len > 0 && c < kept[kept.len - 1] && ${cond}(d) {
				dropped++;
			} else {
				kept.push(c);
			}
		} else {
			kept.push(c);
		}
	}
	out.s = copy(kept);
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
