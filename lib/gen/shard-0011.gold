		gold_fail(g, "no elements within range bounds");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements within bounds");
	out
}
@end
