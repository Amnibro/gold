code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "unique error list unchanged");
		return out;
	}
	var write_idx = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "deduplicated to ", write_idx, " unique errors");
	out
}
@end
