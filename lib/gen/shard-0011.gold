code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var scaled = 0;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				if g.res[i] * 2 > lim {
					break;
				}
				g.res[i] *= 2;
				scaled++;
			}
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " duplicate items");
	out
}
@end
