expect: => i=2 r=0.0 ok=true s="reversed head of 2 items" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${num} > g.n { g.n } else { ${num} };
	for i in k / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[k - 1 - i];
		g.res[k - 1 - i] = tmp;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed head of ", k, " items");
	out
}
@end
