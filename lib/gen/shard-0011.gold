@entry 77ba4dad0308d4dd
kind: step
verb: rotate
noun: primes
modifier: at_least
context: aggregate
phrase: rotate results if prime count reaches at least {min_primes}
phrase: cycle aggregate elements given at least primes {min_primes}
slot: min_primes int
test: list=2,3,5,4 min_primes=3
expect: => i=3 r=0.0 ok=true s="primes count for rotate 3" errors=0 n=4 res=[3,5,4,2] cache=0 hits=0
test: list=4,6,8,9 min_primes=2
expect: => i=0 r=0.0 ok=true s="primes count for rotate 0" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_primes};
	var prime_count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) { prime_count++; }
	}
	if prime_count >= req && g.n > 0 {
		let first = g.res[0];
		for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "primes count for rotate ", prime_count);
	out
}
@end
