code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped safely count=", g.n);
	out
}
@end
@entry 48dc14a4ce934174
kind: step
verb: sort
noun: pairs
modifier: up_to
context: core
phrase: sort pairs up to bound {limit}
phrase: order pairwise sums up to limit {limit}
phrase: sort adjacent pair sums under {limit}
slot: limit int
test: list=1,4,2,5 limit=8
expect: => i=3 r=0.0 ok=true s="sorted pair sums count=3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
test: list=10,2,30 limit=20
expect: => i=1 r=0.0 ok=true s="sorted pair sums count=1" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let s = g.res[i] + g.res[i + 1];
			if s <= lim {
				g.res[count] = s;
				count++;
			}
		}
		g.n = count;
		for i in g.n {
			for j in 0..(g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted pair sums count=", g.n);
	out
}
@end
