expect: => i=3 r=0.0 ok=true s="split paired data into coordinates count 3" errors=0 n=6 res=[1,2,3,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[256] = [0; 256];
	var odds int[256] = [0; 256];
	var en = 0;
	var on = 0;
	for i in g.n {
		if i % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		} else {
			odds[on] = g.res[i];
			on++;
		}
	}
	for i in en { g.res[i] = evens[i]; }
	for i in on { g.res[en + i] = odds[i]; }
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "split paired data into coordinates count ", en);
	out
}
@end
