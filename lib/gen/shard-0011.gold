@entry 6063ca39f8df0f60
kind: step
verb: merge
noun: squares
modifier: sorted
context: text
phrase: merge squared text digits in sorted order
phrase: collect sorted squares of text digits
test: text="a3b2c1"
expect: => i=3 r=0.0 ok=true s="a3b2c1" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: text="9x4y2"
expect: => i=3 r=0.0 ok=true s="9x4y2" errors=0 n=3 res=[4,16,81] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var sq int[>..] = [];
	for c in out.s {
		if c >= '0' && c <= '9' {
			let d = (c - '0') as! int;
			sq.push(d * d);
		}
	}
	var i = 0;
	while i < sq.len {
		var j = i + 1;
		while j < sq.len {
			if sq[j] < sq[i] {
				let t = sq[i];
				sq[i] = sq[j];
				sq[j] = t;
			}
			j++;
		}
		gold_push(g, sq[i]);
		i++;
	}
	g.steps += sq.len;
	out.i = sq.len;
	out
}
@end
