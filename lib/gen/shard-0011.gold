fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_letter_sum};
	var total = 0;
	var count = 0;
	while count < g.n && total + g.res[count] <= cap {
		let c = g.res[count];
		var is_alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
		if is_alpha {
			total += c;
		}
		count++;
	}
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "accumulated letter sum: ", total);
	out
}
@end
