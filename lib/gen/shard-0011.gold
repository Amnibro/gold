@entry 749ce7641fb15bc0
kind: step
verb: fill
noun: cache
modifier: times
context: filter
phrase: fill cache recording elements appearing {count} times
phrase: filter items matching occurrence count {count} into cache
slot: count int
test: list=1,2,2,3,3,4 count=2
expect: => i=4 r=0.0 ok=true s="recorded target occurrences: 4" errors=0 n=6 res=[1,2,2,3,3,4] cache=2 hits=0
test: list=5,5,5,6,7 count=3
expect: => i=3 r=0.0 ok=true s="recorded target occurrences: 3" errors=0 n=5 res=[5,5,5,6,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	var recorded = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq == target {
			gold_cache_put(g, x, freq);
			recorded++;
		}
	}
	g.steps += g.n;
	out.i = recorded;
	out.s.clear();
	format(out.s, "recorded target occurrences: ", recorded);
	out
}
@end
