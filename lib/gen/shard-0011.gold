expect: => i=3 r=0.0 ok=true s="recursively filled 3 digits" errors=0 n=4 res=[124,4,2,1] cache=0 hits=0
test: limit=5
expect: => i=0 r=0.0 ok=false s="error: empty results" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty results for recursive digit fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var x = g.res[g.n - 1];
	var count = 0;
	while x > 0 && count < lim {
		let d = x % 10;
		gold_push(g, d);
		x /= 10;
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "recursively filled ", count, " digits");
	out
}
@end
