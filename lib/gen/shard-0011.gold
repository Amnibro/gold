fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var kept = 0;
	for i in g.n {
		if g.res[i] != t {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	let removed = g.n - kept;
	g.n = kept;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered out ", removed, " matching values");
	out
}
@end
@entry 70d812cca794bf7c
