@entry e8ebdf442e1c9f59
kind: step
verb: drop
noun: tail
modifier: sorted
context: retry
phrase: drop sorted trailing retry attempts taking count {count}
phrase: prune tail of sorted retry entries count {count}
slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="dropped sorted tail elements 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,4,3,2 count=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	if !is_sorted || k <= 0 || k > g.n {
		gold_fail(g, "results not sorted or invalid tail count");
		out.ok = false;
		return out;
	}
	g.n -= k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "dropped sorted tail elements ", k);
	out
}
@end
