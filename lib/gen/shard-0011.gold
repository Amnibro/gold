fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 == 0 { evens.push(g.res[i]); }
	}
	for i in evens.len {
		for j in (i + 1)..evens.len {
			if evens[j] < evens[i] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
		}
	}
	for i in evens.len {
		gold_cache_put(g, i, evens[i]);
	}
	g.steps += g.n + evens.len;
	out.i = evens.len;
	out.s.clear();
	format(out.s, "cached ", evens.len, " sorted evens");
	out
}
@end
