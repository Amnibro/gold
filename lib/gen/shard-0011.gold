code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let peak = g.res[max_idx];
	g.res[max_idx] = g.res[0];
	g.res[0] = peak;
	g.steps += g.n;
	out.i = peak;
	out.s.clear();
	format(out.s, "front peak value ", peak);
	out
}
@end
