expect: => i=2 r=0.0 ok=true s="dropped values count 2" errors=0 n=2 res=[10,15] cache=0 hits=0
test: list=1,2,3 ceiling=10
expect: => i=3 r=0.0 ok=false s="dropped values count 3" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	var w = 0;
	for i in g.n {
		if g.res[i] > limit {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	if g.n == 0 {
		gold_fail(g, "all values dropped below error ceiling");
		out.ok = false;
	}
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped values count ", dropped);
	out
}
@end
