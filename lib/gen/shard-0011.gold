code:
fn ${ID}(g Gold&, v Val) Val {
	let th = ${threshold};
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for minimum until");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		if g.res[i] <= th {
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum until threshold ", min_val);
	out
}
@end
