@entry 7f101f142a733f49
kind: step
verb: trace
noun: gaps
modifier: up_to
context: compare
phrase: trace comparison gaps up to maximum difference {max_gap}
phrase: inspect intervals between adjacent elements bounded by {max_gap}
slot: max_gap int
test: list=5,10,18,22 max_gap=6
expect: => i=2 r=0.0 ok=true s="gaps within bound count 2" errors=0 n=4 res=[5,10,18,22] cache=0 hits=0
test: list=1,4,12,15 max_gap=5
expect: => i=2 r=0.0 ok=true s="gaps within bound count 2" errors=0 n=4 res=[1,4,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap_gap = ${max_gap};
	var small_gaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		if gap <= cap_gap { small_gaps++; }
		i++;
	}
	g.steps += g.n;
	out.i = small_gaps;
	out.s.clear();
	format(out.s, "gaps within bound count ", small_gaps);
	out
}
@end
