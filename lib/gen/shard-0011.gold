@entry 0cf75251be3c65ce
kind: step
verb: validate
noun: primes
modifier: first
context: sort
phrase: validate leading elements in sorted array are prime {count}
phrase: verify first elements after sort are primes {count}
slot: count int
test: list=10,3,2,5,8 count=2
expect: => i=1 r=0.0 ok=true s="primes status true" errors=0 n=5 res=[2,3,5,8,10] cache=0 hits=0
test: list=9,4,6,12 count=1
expect: => i=0 r=0.0 ok=false s="primes status false" errors=0 n=4 res=[4,6,9,12] cache=0 hits=0
code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var all_p = true;
	var bound = k;
	if bound > g.n { bound = g.n; }
	for i in bound {
		if !${ID}_is_p(g.res[i]) {
			all_p = false;
			break;
		}
	}
	out.ok = all_p;
	out.i = if all_p { 1 } else { 0 };
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "primes status ", all_p);
	out
}
@end
