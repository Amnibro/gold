code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 { return out; }
	let p1 = g.res[g.n - 4] * g.res[g.n - 3];
	let p2 = g.res[g.n - 2] * g.res[g.n - 1];
	g.res[g.n - 4] = p1;
	g.res[g.n - 3] = p2;
	g.n -= 2;
	g.steps += 4;
	out.i = p1 + p2;
	out.s.clear();
	format(out.s, "paired suffix nested sum ", out.i);
	out
}
@end
