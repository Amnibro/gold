phrase: drop first highest digit value
test: arg=987,192
expect: 87
expect: 12
test: arg=55,100
expect: 5
expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[>..] = [];
	while x > 0 {
		d.push(x % 10);
		x /= 10;
	}
	if d.len == 0 { return 0; }
	var max_v = -1;
	var i = d.len - 1;
	while i >= 0 {
		if d[i] > max_v { max_v = d[i]; }
		i--;
	}
	var dropped = false;
	var res = 0;
	i = d.len - 1;
	while i >= 0 {
		if !dropped && d[i] == max_v {
			dropped = true;
		} else {
			res = res * 10 + d[i];
		}
		i--;
	}
	res
}
@end
