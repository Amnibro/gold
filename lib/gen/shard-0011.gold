code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fallback = ${def_val};
	if g.n == 0 {
		out.i = fallback;
		out.s.clear();
		format(out.s, "safely folded maximum ", fallback);
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "safely folded maximum ", max_val);
	out
}
@end
