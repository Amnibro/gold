code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var bound = k;
	if bound > g.n { bound = g.n; }
	for i in bound {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += bound * g.n;
	out.i = bound;
	out.s.clear();
	format(out.s, "ranked minimum until ", bound);
	out
}
@end
