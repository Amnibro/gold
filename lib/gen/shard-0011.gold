				is_sorted = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	if is_sorted {
		out.s.append("list is sorted");
	} else {
		out.s.append("list is unsorted");
	}
	out
}
