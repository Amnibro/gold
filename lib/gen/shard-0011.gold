fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var w = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			g.res[w] = cur_len;
			w++;
			cur_len = 1;
		}
		i++;
	}
	g.res[w] = cur_len;
	w++;
	g.n = w;
	g.steps += i;
	out.i = w;
	out.s.clear();
	format(out.s, "measured runs count ", w);
	out
}
@end
