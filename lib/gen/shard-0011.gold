fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[>..] = [];
	var odd_pos int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds.push(g.res[i]);
			odd_pos.push(i);
		}
	}
	for i in odds.len {
		for j in (i + 1)..odds.len {
			if odds[j] < odds[i] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
		}
	}
	for k in odds.len {
		g.res[odd_pos[k]] = odds[k];
	}
	g.steps += g.n + odds.len * odds.len;
	out.i = odds.len;
	out.s.clear();
	format(out.s, "sorted ", odds.len, " odd numbers");
	out
}
