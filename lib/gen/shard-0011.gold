expect: => i=8 r=0.0 ok=true s="query123" errors=0 n=0 res=[] cache=0 hits=0
test: text="find (item #4)"
expect: => i=9 r=0.0 ok=true s="finditem4" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in out.s.len {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
			out.s[kept] = c;
			kept++;
		}
	}
	while out.s.len > kept { out.s.pop(); }
	g.steps += out.s.len;
	out.i = kept;
	out
}
@end
