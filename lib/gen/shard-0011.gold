expect: => i=8 r=0.0 ok=true s="running duplicate sum 8" errors=0 n=5 res=[4,4,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for duplicate sum");
		out.ok = false;
		return out;
	}
	var dup_sum = 0;
	var i = 0;
	while i < g.n {
		var is_dup = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
			j++;
		}
		if is_dup {
			dup_sum += g.res[i];
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "running duplicate sum ", dup_sum);
	out
}
@end
