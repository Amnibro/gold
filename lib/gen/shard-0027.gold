noun: range
modifier: unique
context: stats
phrase: rotate range unique distinct values displacement {shift}
phrase: cycle range unique sample elements offset {shift}
slot: shift int
test: list=1,2,2,3,4,4,5 shift=2
expect: => i=5 r=0.0 ok=true s="unique rotated count: 5" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,20,30,40 shift=1
expect: => i=4 r=0.0 ok=true s="unique rotated count: 4" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var uniq int[64] = [0; 64];
	var un = 0;
	for k in g.n {
		let x = g.res[k];
		var found = false;
		for u in un { if uniq[u] == x { found = true; break; } }
		if !found && un < 64 { uniq[un] = x; un++; }
	}
	if un > 0 {
		let rot = sh % un;
		for k in un {
			let src = (k + un - rot) % un;
			g.res[k] = uniq[src];
		}
		g.n = un;
	}
	g.steps += un * un;
	out.i = un;
	out.s.clear();
	format(out.s, "unique rotated count: ", un);
	out
}
@end
