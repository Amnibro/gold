@entry 41892961f03e96e1
kind: step
verb: search
noun: series
modifier: recursively
context: stats
phrase: search series recursively distribution quantile target {target}
phrase: locate series recursively percentile target {target}
slot: target int
test: list=10,25,40,65 target=25
expect: => i=1 r=0.0 ok=true s="target located at index: 1" errors=0 n=4 res=[10,25,40,65] cache=0 hits=0
test: list=2,8,18,32 target=15
expect: => i=-1 r=0.0 ok=true s="target not found in series" errors=0 n=4 res=[2,8,18,32] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var low = 0;
	var high = g.n - 1;
	var found = -1;
	while low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "target located at index: ", found);
	} else {
		format(out.s, "target not found in series");
	}
	out
}
@end
@entry a7e4ef5b20ec3a7b
kind: step
verb: group
noun: minimum
modifier: first
context: stats
phrase: group minimum first cluster observations size {bucket}
phrase: partition minimum first distribution samples size {bucket}
slot: bucket int
test: list=9,4,15,2,8,1 bucket=3
expect: => i=1 r=0.0 ok=true s="group minimum found: 1" errors=0 n=7 res=[9,4,15,2,8,1,1] cache=0 hits=0
test: list=20,5,12,3 bucket=2
expect: => i=3 r=0.0 ok=true s="group minimum found: 3" errors=0 n=5 res=[20,5,12,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b < 1 || g.n == 0 { return out; }
	var mins int[64] = [0; 64];
	var mc = 0;
	var i = 0;
	while i < g.n && mc < 64 {
		var m = g.res[i];
		var j = 1;
		while j < b && i + j < g.n {
			if g.res[i+j] < m { m = g.res[i+j]; }
			j++;
		}
		mins[mc] = m;
		mc++;
		i += b;
	}
	var global_min = mins[0];
	for k in mc { if mins[k] < global_min { global_min = mins[k]; } }
	gold_push(g, global_min);
	g.steps += g.n;
	out.i = global_min;
	out.s.clear();
	format(out.s, "group minimum found: ", global_min);
	out
}
@end
