code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	var max_val = base;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > max_val {
			max_val = x;
			count++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum every other observation: ", max_val);
	out
}
@end
