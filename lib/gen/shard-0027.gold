@entry 8428c6e4e47a7424
kind: step
verb: shift
noun: text
modifier: sorted
context: stats
phrase: shift text sorted category labels displacement {offset}
phrase: translate text sorted categorical tags displacement {offset}
slot: offset int
test: text="gamma alpha beta" offset=1
expect: => i=16 r=0.0 ok=true s=" aaaaabeghlmmpt " errors=0 n=0 res=[] cache=0 hits=0
test: text="zebra apple mango" offset=2
expect: => i=17 r=0.0 ok=true s="aaabeeglmnopprz  " errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if out.s.len > 0 {
		var sorted byte[..200] = [];
		for i in out.s.len { sorted.push(out.s[i]); }
		var i = 0;
		while i < sorted.len {
			var j = 0;
			while j + 1 < sorted.len {
				if sorted[j] > sorted[j+1] {
					let tmp = sorted[j];
					sorted[j] = sorted[j+1];
					sorted[j+1] = tmp;
				}
				j++;
			}
			i++;
		}
		let rot = off % sorted.len;
		var rotated byte[..200] = [];
		for k in sorted.len {
			let src = (k + rot) % sorted.len;
			rotated.push(sorted[src]);
		}
		out.s = rotated;
	}
	g.steps += out.s.len * out.s.len;
	out.i = out.s.len;
	out
}
@end
