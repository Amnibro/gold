fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	while g.n > 0 && shifts < g.n && !${p}(g.res[0]) {
		let first = g.res[0];
		var k = 0;
		while k + 1 < g.n {
			g.res[k] = g.res[k+1];
			k++;
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	g.steps += shifts * g.n;
	out.i = shifts;
	out.s.clear();
	format(out.s, "prefix rotations completed: ", shifts);
	out
}
@end
