fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${minval};
	var cnt = 0;
	for k in g.n {
		if g.res[k] >= b {
			g.res[k] = ${f}(g.res[k]);
			cnt++;
		}
	}
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "transformed and sorted: ", cnt);
	out
}
@end
