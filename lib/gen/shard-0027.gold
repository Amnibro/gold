expect: => i=3 r=0.0 ok=true s="sorted pairs within tolerance: 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,25,15,35 tolerance=8
expect: => i=0 r=0.0 ok=true s="sorted pairs within tolerance: 0" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
			}
			j++;
		}
		i++;
	}
	var close_pairs = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k+1] - g.res[k] <= tol {
			close_pairs++;
		}
		k++;
	}
	g.steps += g.n * g.n;
	out.i = close_pairs;
	out.s.clear();
	format(out.s, "sorted pairs within tolerance: ", close_pairs);
	out
}
@end
