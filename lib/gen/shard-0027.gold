@entry 7e1ea3f1ba5ed017
kind: step
verb: map
noun: squares
modifier: any
context: stats
phrase: map squares any statistical sample scale {scale}
phrase: transform squares any sample distribution factor {scale}
slot: scale int
test: list=2,3,4 scale=2
expect: => i=58 r=0.0 ok=true s="sum of scaled squares: 58" errors=0 n=3 res=[8,18,32] cache=0 hits=0
test: list=5,6 scale=3
expect: => i=183 r=0.0 ok=true s="sum of scaled squares: 183" errors=0 n=2 res=[75,108] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	var sum = 0;
	for k in g.n {
		let sq = g.res[k] * g.res[k] * s;
		g.res[k] = sq;
		sum += sq;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of scaled squares: ", sum);
	out
}
@end
@entry 61a2aec053b8d4b9
kind: step
verb: pair
noun: suffix
modifier: unique
context: stats
phrase: pair suffix unique tail observations width {width}
phrase: couple suffix unique sample tail width {width}
slot: width int
test: list=1,2,3,4,5,6 width=2
expect: => i=2 r=0.0 ok=true s="unique suffix pairs: 2" errors=0 n=8 res=[1,2,3,4,5,6,8,10] cache=0 hits=0
test: list=10,20,30,40 width=3
expect: => i=0 r=0.0 ok=true s="unique suffix pairs: 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if g.n >= w * 2 {
		var paired = 0;
		var start = g.n - w * 2;
		var i = 0;
		while i < w {
			let a = g.res[start + i];
			let b = g.res[start + w + i];
			if a != b {
				gold_push(g, a + b);
				paired++;
			}
			i++;
		}
		out.i = paired;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "unique suffix pairs: ", out.i);
	out
}
@end
@entry a0c7cfec6e4f25dd
kind: step
verb: drop
noun: number
modifier: sorted
context: stats
phrase: drop number sorted distribution percentile rank {rank}
phrase: remove number sorted sample rank {rank}
slot: rank int
test: list=40,10,30,20 rank=2
expect: => i=30 r=0.0 ok=true s="dropped sorted element: 30" errors=0 n=3 res=[10,20,40] cache=0 hits=0
test: list=5,25,15,35 rank=1
expect: => i=15 r=0.0 ok=true s="dropped sorted element: 15" errors=0 n=3 res=[5,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rk = ${rank};
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
			}
			j++;
		}
		i++;
	}
	if rk >= 0 && rk < g.n {
		let dropped = g.res[rk];
		var k = rk;
		while k + 1 < g.n {
			g.res[k] = g.res[k+1];
			k++;
		}
		g.n--;
		out.i = dropped;
	} else {
		out.i = 0;
	}
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "dropped sorted element: ", out.i);
	out
}
@end
