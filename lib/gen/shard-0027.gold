code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var matching = 0;
	for k in g.n {
		let x = g.res[k];
		if x > lo && x < hi {
			matching++;
		}
	}
	g.steps += g.n;
	out.i = matching;
	out.s.clear();
	format(out.s, "count between thresholds: ", matching);
	out
}
@end
