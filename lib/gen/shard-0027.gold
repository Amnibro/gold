fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if g.n == 0 || w <= 0 { return out; }
	var start = g.n - w;
	if start < 0 { start = 0; }
	var max_val = g.res[start];
	var i = start + 1;
	while i < g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
		i++;
	}
	gold_push(g, max_val);
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "folded maximum of tail: ", max_val);
	out
}
@end
