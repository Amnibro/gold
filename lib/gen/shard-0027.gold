		let a = g.res[i];
		let b = g.res[i+1];
		if (a + b) / 2 > cut {
			g.res[i] = b;
			g.res[i+1] = a;
			rotated++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = rotated;
	out.s.clear();
	format(out.s, "rotated pairs count: ", rotated);
