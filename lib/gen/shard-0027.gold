@entry 99a58057e1b53ef9
kind: step
verb: dedupe
noun: primes
modifier: each
context: stats
phrase: dedupe primes each observation record ceiling {cap}
phrase: filter duplicate primes each distribution tier {cap}
slot: cap int
test: list=2,3,2,5,3,7 cap=10
expect: => i=4 r=0.0 ok=true s="distinct primes retained: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,13,11,17,13 cap=20
expect: => i=3 r=0.0 ok=true s="distinct primes retained: 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var seen = [false; 128];
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if core_is_prime(x) && x < c && x >= 0 && x < 128 {
			if !seen[x] {
				seen[x] = true;
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += i;
	out.i = kept;
	out.s.clear();
	format(out.s, "distinct primes retained: ", kept);
	out
}
@end
