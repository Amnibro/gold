@entry 7ff97f7a1d73aaa3
kind: step
verb: scatter
noun: chair
modifier: matte
context: scene
phrase: scatter chair with matte surface at elevation {z}
phrase: place matte finish chair at height {z}
slot: z real
test: z=0.5
expect: => i=1 r=0.0 ok=true s="scatchair" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: chair1 box 0,0,0.5 0.6,0.6,0.9 m:matte
test: z=1.2 doc="floor box 0,0,-.5 10,10,1"
expect: => i=2 r=0.0 ok=true s="scatchair" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: floor box 0,0,-.5 10,10,1
expect: => doc: chair2 box 0,0,1.2 0.6,0.6,0.9 m:matte
test: z=-0.5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${z} < 0.0 { gold_fail(g, "invalid elevation"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "chair", "", o);
	o.append(" box 0,0,");
	gold_fnum(o, ${z});
	o.append(" 0.6,");
	o.append("0.6,");
	o.append("0.9 m:matte");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "scatchair");
	out
}
@end
