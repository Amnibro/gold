expect: => i=24 r=0.0 ok=true s="sum of scaled gaps: 24" errors=0 n=2 res=[9,15] cache=0 hits=0
test: list=10,14,20 factor=2
expect: => i=20 r=0.0 ok=true s="sum of scaled gaps: 20" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n <= 1 { return out; }
	var sum = 0;
	var i = 0;
	let count = g.n - 1;
	while i < count {
		let diff = (g.res[i+1] - g.res[i]) * f;
		g.res[i] = diff;
		sum += diff;
		i++;
	}
	g.n = count;
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of scaled gaps: ", sum);
	out
}
@end
