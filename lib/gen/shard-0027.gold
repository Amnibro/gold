noun: loop
modifier: first
context: stats
phrase: dedupe loop first initial unique observations count {keep}
phrase: filter duplicate loop first sample head count {keep}
slot: keep int
test: list=4,4,2,2,8,8 keep=2
expect: => i=2 r=0.0 ok=true s="initial unique elements kept: 2" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=1,1,3,3,5,5 keep=3
expect: => i=3 r=0.0 ok=true s="initial unique elements kept: 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let kp = ${keep};
	var seen int[64] = [0; 64];
	var sc = 0;
	for k in g.n {
		if sc >= kp { break; }
		let x = g.res[k];
		var dup = false;
		for s in sc { if seen[s] == x { dup = true; break; } }
		if !dup && sc < 64 { seen[sc] = x; sc++; }
	}
	for k in sc { g.res[k] = seen[k]; }
	g.n = sc;
	g.steps += sc * sc;
	out.i = sc;
	out.s.clear();
	format(out.s, "initial unique elements kept: ", sc);
	out
}
@end
