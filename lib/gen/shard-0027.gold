code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n < sz { return out; }
	var w_count = 0;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		let avg = sum / sz;
		gold_cache_put(g, i, avg);
		w_count++;
		i++;
	}
	g.steps += g.n * sz;
	out.i = w_count;
	out.s.clear();
	format(out.s, "windows traced and cached: ", w_count);
	out
}
@end
