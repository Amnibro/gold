test: list=1,2,3,4,5,6 span=3
expect: => i=6 r=0.0 ok=true s="reversed windows total: 2" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40,50 span=2
expect: => i=4 r=0.0 ok=true s="reversed windows total: 2" errors=0 n=5 res=[20,10,40,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 1 || g.n < sp { return out; }
	var offset = 0;
	while offset + sp <= g.n {
		var left = offset;
		var right = offset + sp - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
		offset += sp;
	}
	g.steps += g.n;
	out.i = offset;
	out.s.clear();
	format(out.s, "reversed windows total: ", offset / sp);
	out
}
@end
