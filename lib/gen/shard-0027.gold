test: list=100,20,30,80 cutoff=40
expect: => i=2 r=0.0 ok=true s="outliers dropped: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		if g.res[k] <= cut {
			g.res[kept] = g.res[k];
			kept++;
		} else {
			dropped++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "outliers dropped: ", dropped);
	out
}
@end
@entry d7eb4bbccd3fb725
kind: step
