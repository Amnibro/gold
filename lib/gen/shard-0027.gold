expect: => i=3 r=0.0 ok=true s="ban" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	var seen = [false; 256];
	var filtered byte[..200] = [];
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		if (i % st) == 0 {
			let idx = b as! int;
			if idx >= 0 && idx < 256 && !seen[idx] {
				seen[idx] = true;
				filtered.push(b);
			}
		} else {
			filtered.push(b);
		}
		i++;
	}
	g.steps += out.s.len;
	out.s = filtered;
	out.i = out.s.len;
	out
}
@end
