modifier: at_most
context: transform
phrase: dedupe step adjacent digits at most {limit}
phrase: remove duplicate step digits ceiling {limit}
slot: limit int
test: arg=112233,4455 limit=500
expect: 123
expect: 45
test: arg=998877 limit=800
expect: 800
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = n;
	var digits = [0; 32];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = 0;
	var last = -1;
	var i = len - 1;
	while i >= 0 {
		let d = digits[i];
		if d != last {
			res = res * 10 + d;
			last = d;
		}
		i--;
	}
	if res > lim { lim } else { res }
}
@end
