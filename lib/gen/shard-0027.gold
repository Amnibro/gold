expect: => i=80 r=0.0 ok=true s="scaled tally sum: 80" errors=0 n=4 res=[10,20,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total = 0;
	for k in g.n {
		let scaled = g.res[k] * f;
		g.res[k] = scaled;
		total += scaled;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled tally sum: ", total);
	out
}
@end
