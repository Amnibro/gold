fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${div};
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	var avg = total;
	if d > 0 { avg = total / d; }
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "reverse safe average: ", avg);
	out
}
@end
