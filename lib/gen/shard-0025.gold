fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_letters};
	var letters = 0;
	for k in out.s.len {
		let c = out.s[k];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			letters++;
		}
	}
	g.steps += out.s.len;
	if letters < req {
		gold_fail(g, "text lacks required letters");
		out.ok = false;
		out.i = letters;
		out.s.clear();
		format(out.s, "error: letters ", letters, " below requirement ", req);
		return out;
	}
	out.i = letters;
	out.s.clear();
	format(out.s, "counted letters: ", letters);
	out
}
