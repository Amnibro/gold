fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var valid_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			gold_cache_put(g, x, 1);
			valid_cnt++;
		} else {
			gold_cache_put(g, x, 0);
		}
	}
	g.steps += g.n;
	out.i = valid_cnt;
	out.s.clear();
	format(out.s, "valid counter count: ", valid_cnt);
	out
}
@end
