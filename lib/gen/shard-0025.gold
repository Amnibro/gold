phrase: remove duplicate differences margin {threshold}
slot: threshold int
test: list=5,10,15,25,35 threshold=8
expect: => i=1 r=0.0 ok=true s="unique gaps count: 1" errors=0 n=1 res=[10] cache=0 hits=0
test: list=2,6,10,14,22 threshold=5
expect: => i=1 r=0.0 ok=true s="unique gaps count: 1" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 { return out; }
	var gaps int[64] = [0; 64];
	var gn = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= th && gn < 64 {
			var seen = false;
			for j in gn {
				if gaps[j] == diff { seen = true; break; }
			}
			if !seen {
				gaps[gn] = diff;
				gn++;
			}
		}
	}
	for k in gn { g.res[k] = gaps[k]; }
	g.n = gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "unique gaps count: ", gn);
	g.steps += g.n * gn;
	out
}
@end
