expect: => i=1 r=0.0 ok=true s="progression step shifted: 1" errors=0 n=4 res=[8,2,4,6] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n > 1 {
		for s in shift {
			let last = g.res[g.n - 1];
			for i in g.n - 1 {
				let idx = g.n - 1 - i;
				g.res[idx] = g.res[idx - 1];
			}
			g.res[0] = last;
		}
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "progression step shifted: ", shift);
	out
}
@end
