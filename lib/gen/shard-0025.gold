@entry d1e84ee3f03996c5
kind: step
verb: find
noun: histogram
modifier: recursively
context: sort
phrase: find histogram recursively peak frequency count
phrase: determine highest frequency count in sorted list
phrase: calculate maximum repetition count across sorted values
test: list=4,2,2,4,4,1,2,4
expect: => i=4 r=0.0 ok=true s="peak frequency: 4" errors=0 n=8 res=[1,2,2,2,4,4,4,4] cache=0 hits=0
test: list=7,8,9,10
expect: => i=1 r=0.0 ok=true s="peak frequency: 1" errors=0 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_freq = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		if freq > max_freq { max_freq = freq; }
		i = j;
	}
	g.steps += g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "peak frequency: ", max_freq);
	out
}
@end
