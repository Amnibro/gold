fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	var modified = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[k] += s;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped ", modified, " evens");
	out
}
@end
