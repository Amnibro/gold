test: list=1,2,3 require_even=1
expect: => i=3 r=0.0 ok=false s="error: odd length 3" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${require_even};
	if req > 0 && (g.n % 2) != 0 {
		gold_fail(g, "odd series length rejected");
		out.ok = false;
		out.i = g.n;
		out.s.clear();
		format(out.s, "error: odd length ", g.n);
		return out;
	}
	let limit = (g.n / 2) * 2;
	var k = 0;
	while k < limit {
		let tmp = g.res[k];
		g.res[k] = g.res[k + 1];
		g.res[k + 1] = tmp;
		k += 2;
	}
	g.steps += limit;
	out.i = limit / 2;
	out.s.clear();
	format(out.s, "swapped pairs: ", out.i);
	out
}
@end
