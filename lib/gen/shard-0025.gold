@entry 429dd31b44a9dc65
kind: step
verb: trace
noun: list
modifier: in_place
context: filter
slot: threshold int
phrase: trace list in place meeting threshold {threshold}
phrase: preserve list elements in place above threshold {threshold}
test: list=15,3,28,4,42,9 threshold=10
expect: => i=3 r=0.0 ok=true s="traced in place: 3" errors=0 n=3 res=[15,28,42] cache=0 hits=0
test: list=50,12,75,8 threshold=20
expect: => i=2 r=0.0 ok=true s="traced in place: 2" errors=0 n=2 res=[50,75] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lim {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.steps += g.n + m;
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "traced in place: ", m);
	out
}
@end
@entry 91352f9d4dcf0f3d
kind: step
verb: clamp
noun: maximum
modifier: until
context: filter
slot: limit int
phrase: clamp maximum until threshold condition {limit}
phrase: constrain maximum values until barrier {limit}
test: list=15,25,60,35,80 limit=20
expect: => i=1 r=0.0 ok=true s="clamped maximum until stop: 1" errors=0 n=5 res=[15,20,60,35,80] cache=0 hits=0
test: list=10,30,45,20 limit=25
expect: => i=0 r=0.0 ok=true s="clamped maximum until stop: 0" errors=0 n=4 res=[10,25,25,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var stopped = false;
	for i in g.n {
		if g.res[i] > cap * 2 {
			stopped = true;
			break;
		}
		if g.res[i] > cap { g.res[i] = cap; }
	}
	out.i = if stopped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "clamped maximum until stop: ", out.i);
	out
}
@end
@entry 6adf370bab414017
kind: step
verb: sort
noun: gaps
modifier: none
context: filter
phrase: sort gaps none filtering differences across items
phrase: order pairwise gaps across sequence elements
test: list=10,25,12,30,15
expect: => i=4 r=0.0 ok=true s="sorted gap differences: 4" errors=0 n=4 res=[13,15,15,18] cache=0 hits=0
test: list=5,18,9,40
expect: => i=3 r=0.0 ok=true s="sorted gap differences: 3" errors=0 n=3 res=[9,13,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var m = g.n - 1;
	for i in m {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff < 0 { -diff } else { diff };
	}
	g.n = m;
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted gap differences: ", g.n);
	out
}
@end
