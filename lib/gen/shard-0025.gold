@entry 962af752d76cfe86
kind: step
verb: compare
noun: list
modifier: between
context: error
phrase: compare list between range {lo} through {hi}
phrase: inspect list between bounds {lo} through {hi}
slot: lo int
slot: hi int
test: list=5,15,25,35 lo=10 hi=30
expect: => i=2 r=0.0 ok=false s="in range count: 2" errors=2 n=4 res=[5,15,25,35] cache=0 hits=0
test: list=2,4,6,8 lo=1 hi=5
expect: => i=2 r=0.0 ok=false s="in range count: 2" errors=2 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var valid_count = 0;
	var invalid_count = 0;
	for idx in g.n {
		let x = g.res[idx];
		if x >= l && x <= h {
			valid_count++;
		} else {
			invalid_count++;
			gold_fail(g, "element outside valid bounds");
		}
	}
	g.steps += g.n;
	out.i = valid_count;
	if invalid_count > 0 {
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "in range count: ", valid_count);
	out
}
@end
@entry b607c8d6bdff7df7
kind: step
