		gold_fail(g, "initial error flag present");
	}
	if g.errors > 0 {
		gold_fail(g, "strict zero error violation");
		out.i = 0 - (p * g.errors);
		out.ok = false;
	} else {
		out.i = 100;
		out.ok = true;
	}
	out.s.clear();
	format(out.s, "strict error status score: ", out.i);
	out
}
