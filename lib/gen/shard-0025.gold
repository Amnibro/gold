slot: dz real
test: dz=1.5 doc="ground box 0,0,-.5 20,20,1|stairs box 0,0,.5 2,4,1"
expect: => i=3 r=0.0 ok=true s="alidoor" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: stairs box 0,0,.5 2,4,1
expect: => doc: stairs.loc anim 0:0,0,0 1:0,0,1.5
test: dz=2.8 doc="platform box 0,0,0 10,10,.5|bridge box 0,0,1 6,2,.4"
expect: => i=3 r=0.0 ok=true s="alidoor" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: platform box 0,0,0 10,10,.5
expect: => doc: bridge box 0,0,1 6,2,.4
expect: => doc: bridge.loc anim 0:0,0,0 1:0,0,2.8
test: dz=-0.5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_align_door_spaced_alpha = 0;
	let z = ${dz};
	if z <= 0.0 { gold_fail(g, "invalid distance"); out.ok = false; return out; }
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	var o byte[>..] = [];
	o.append(last);
	o.append(".loc anim ");
	o.append("0");
	o.append(":0,0,");
	o.append("0 ");
	o.append("1");
	o.append(":0,0,");
	gold_fnum(o, z);
	gold_doc(g, o);
	out.i = g.dn + mark_align_door_spaced_alpha;
	out.s.clear();
	format(out.s, "alidoor");
	out
}
@end
