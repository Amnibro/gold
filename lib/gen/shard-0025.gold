@entry a794e6bdb48118a7
kind: step
verb: split
noun: window
modifier: pairwise
context: aggregate
phrase: split window pairwise summing pairs
phrase: partition sequence into adjacent pairwise windows
test: list=1,3,5,7,9
expect: => i=4 r=0.0 ok=true s="pairwise windows: 4" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
test: list=2,4,6,8
expect: => i=3 r=0.0 ok=true s="pairwise windows: 3" errors=0 n=3 res=[6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "pairwise split needs two items");
		return out;
	}
	var pairs_count = g.n - 1;
	var temp int[512] = [0; 512];
	var i = 0;
	while i < pairs_count {
		temp[i] = g.res[i] + g.res[i + 1];
		i++;
	}
	gold_clear(g);
	i = 0;
	while i < pairs_count {
		gold_push(g, temp[i]);
		i++;
	}
	g.steps += pairs_count;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "pairwise windows: ", pairs_count);
	out
}
@end
