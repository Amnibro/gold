code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bud = ${budget};
	var steps_used = 0;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			steps_used++;
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if steps_used > bud {
		gold_fail(g, "budget exceeded");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = steps_used;
	out.s.clear();
	format(out.s, "budget steps: ", steps_used);
	g.steps += steps_used;
	out
}
@end
