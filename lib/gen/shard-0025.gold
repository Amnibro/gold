@entry edd1142091d398c9
kind: step
verb: run
noun: primes
modifier: until
context: sort
phrase: run primes until non_prime is encountered
phrase: collect initial prefix of prime numbers in sorted list
phrase: retain contiguous leading primes from sorted sequence
test: list=2,3,5,4,7
expect: => i=2 r=0.0 ok=true s="collected prefix of 2 primes" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="collected prefix of 0 primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	while count < g.n && core_is_prime(g.res[count]) {
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
