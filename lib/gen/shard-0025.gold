	let att = ${attempts};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var target = 6;
	var found = -1;
	for i in g.n {
		if g.res[i] == target {
			found = i;
			break;
		}
	}
	if found < 0 {
		for i in g.n {
