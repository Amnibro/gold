test: list=10,30,20,50,40 stride=3
expect: => i=2 r=0.0 ok=true s="scanned cached steps: 2" errors=0 n=5 res=[10,20,30,40,50] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var st = ${stride};
	if st < 1 { st = 1; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var visited = 0;
	var idx = 0;
	while idx < g.n {
		gold_cache_put(g, idx, g.res[idx]);
		visited++;
		idx += st;
	}
	g.steps += visited;
	out.i = visited;
	out.s.clear();
	format(out.s, "scanned cached steps: ", visited);
	out
}
@end
