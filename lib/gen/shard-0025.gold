@entry 9074134b622e2911
kind: step
verb: validate
noun: primes
modifier: running
context: cache
phrase: validate primes numbers checking running primality
phrase: verify primes elements verifying running factors
test: list=2,3,5,7,11,4
expect: => i=5 r=0.0 ok=true s="running primes verified: 5" errors=0 n=6 res=[2,3,5,7,11,4] cache=6 hits=0
test: list=13,17,19,9,23
expect: => i=4 r=0.0 ok=true s="running primes verified: 4" errors=0 n=5 res=[13,17,19,9,23] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = if x >= 2 { true } else { false };
		if x > 3 {
			var d = 2;
			while d * d <= x {
				if (x % d) == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, i, 1);
			prime_count++;
		} else {
			gold_cache_put(g, i, 0);
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "running primes verified: ", prime_count);
	out
}
@end
