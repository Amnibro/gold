@entry af776c5485ad9632
kind: step
verb: fold
noun: condition
modifier: unique
context: math
slot: mod_val int
phrase: fold condition unique residues modulo {mod_val}
phrase: accumulate condition unique remainders under {mod_val}
test: list=10,13,16,19 mod_val=3
expect: => i=1 r=0.0 ok=true s="distinct residue classes: 1" errors=0 n=4 res=[10,13,16,19] cache=0 hits=0
test: list=12,17,22,27 mod_val=5
expect: => i=1 r=0.0 ok=true s="distinct residue classes: 1" errors=0 n=4 res=[12,17,22,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mod_val};
	var unique_mask = 0;
	for i in g.n {
		let rem = (g.res[i] % m + m) % m;
		if rem < 30 {
			unique_mask = unique_mask | (1 << rem);
		}
	}
	var count = 0;
	for b in 30 {
		if (unique_mask & (1 << b)) != 0 { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "distinct residue classes: ", count);
	out
}
@end
