code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = ${count};
	if c > g.n { c = g.n; }
	var sum = 0;
	for i in c {
		sum += g.res[i];
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "traced prefix sum: ", sum);
	out
}
@end
