test: list=9,5,6,2 multiplier=3
expect: => i=2 r=0.0 ok=true s="primes scaled: 2" errors=0 n=4 res=[6,6,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${multiplier};
	var pcount = 0;
	for k in g.n {
		let num = g.res[k];
		var is_p = true;
		if num < 2 { is_p = false; }
		var d = 2;
		while d * d <= num {
			if num % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[k] *= mul;
			pcount++;
		}
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = pcount;
	out.s.clear();
	format(out.s, "primes scaled: ", pcount);
	g.steps += g.n * 2;
	out
}
@end
