@entry 87f7b6adac85326f
kind: step
verb: drop
noun: step
modifier: each
context: error
phrase: drop step intervals across each element by stride {step_stride}
phrase: remove items at regular step stride {step_stride}
slot: step_stride int
test: list=1,2,3,4,5 step_stride=2
expect: => i=3 r=0.0 ok=true s="kept after step drop: 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=1,2 step_stride=0
expect: => i=0 r=0.0 ok=false s="error: invalid step stride" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stride = ${step_stride};
	if stride <= 0 || stride > g.n {
		gold_fail(g, "step stride out of valid range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid step stride");
		return out;
	}
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if (i + 1) % stride != 0 {
			kept[kn] = g.res[i];
			kn++;
		}
		i++;
	}
	g.n = 0;
	for j in kn {
		gold_push(g, kept[j]);
	}
	out.i = kn;
	out.s.clear();
	format(out.s, "kept after step drop: ", kn);
	out
}
@end
@entry 60f470fa91db67e7
kind: step
verb: run
noun: squares
modifier: unique
context: error
phrase: run squares of unique elements below ceiling {max_square}
phrase: compute unique squares bounded by maximum {max_square}
slot: max_square int
test: list=2,3,2 max_square=20
expect: => i=13 r=0.0 ok=true s="unique squares sum: 13" errors=0 n=3 res=[2,3,2] cache=0 hits=0
test: list=2,5 max_square=20
expect: => i=0 r=0.0 ok=false s="error: square exceeds ceiling" errors=1 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_square};
	var unique = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if unique[j] == x { seen = true; break; }
		}
		if !seen {
			unique[un] = x;
			un++;
		}
	}
	var total = 0;
	for i in un {
		let sq = unique[i] * unique[i];
		if sq > limit {
			gold_fail(g, "square of unique value exceeds limit");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: square exceeds ceiling");
			return out;
		}
		total += sq;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "unique squares sum: ", total);
	out
}
@end
@entry dd237a76ab8945ea
kind: step
verb: find
noun: list
modifier: sorted
context: error
phrase: find list values validating sorted order above {min_val}
phrase: verify list elements are sorted starting above {min_val}
slot: min_val int
test: list=5,8,12 min_val=2
expect: => i=3 r=0.0 ok=true s="sorted list confirmed length: 3" errors=0 n=3 res=[5,8,12] cache=0 hits=0
test: list=5,12,8 min_val=2
expect: => i=0 r=0.0 ok=false s="error: unsorted sequence" errors=1 n=3 res=[5,12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n == 0 {
		gold_fail(g, "empty results for sorted list check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	if g.res[0] < mv {
		gold_fail(g, "list initial value falls below minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: start below minimum");
		return out;
	}
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			gold_fail(g, "list is not sorted in ascending order");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: unsorted sequence");
			return out;
		}
		i++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted list confirmed length: ", g.n);
	out
}
@end
