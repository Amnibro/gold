@entry 06e16eb15af0126d
kind: step
verb: split
noun: primes
modifier: none
context: error
phrase: split primes ensuring none exceed upper limit {prime_cap}
phrase: filter prime numbers ensuring none surpass {prime_cap}
slot: prime_cap int
test: list=2,3,5,7 prime_cap=10
expect: => i=4 r=0.0 ok=true s="primes verified under limit: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=2,3,13 prime_cap=10
expect: => i=0 r=0.0 ok=false s="error: prime ceiling exceeded" errors=1 n=3 res=[2,3,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${prime_cap};
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_prime = true;
		if x < 2 {
			is_prime = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_prime = false;
					break;
				}
				d++;
			}
		}
		if is_prime {
			if x > cap {
				gold_fail(g, "prime element exceeds ceiling limit");
				out.ok = false;
				out.s.clear();
				format(out.s, "error: prime ceiling exceeded");
				return out;
			}
			primes_count++;
		}
	}
	out.i = primes_count;
	out.s.clear();
	format(out.s, "primes verified under limit: ", primes_count);
	out
}
