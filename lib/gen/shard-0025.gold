fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty range list");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = (max_val - min_val) * ${factor};
	gold_push(g, span);
	out.i = span;
	out.s.clear();
	format(out.s, "scaled range span: ", span);
	out
}
