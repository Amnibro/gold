test: list=9,2,8,3,7,1 count=4
expect: => i=1 r=0.0 ok=false s="last tail element: 1" errors=1 n=6 res=[9,2,8,3,7,1] cache=0 hits=0
test: list=15,10,5 count=2
expect: => i=5 r=0.0 ok=false s="last tail element: 5" errors=1 n=3 res=[15,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c > g.n {
		gold_fail(g, "count exceeds list size");
		out.ok = false;
		return out;
	}
	let start = g.n - c;
	var is_sorted = true;
	var i = start;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	if !is_sorted {
		gold_fail(g, "tail sequence is not sorted");
		out.ok = false;
	}
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "last tail element: ", out.i);
	out
}
@end
