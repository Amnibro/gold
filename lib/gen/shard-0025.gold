@entry 10f8f3934669fe71
kind: step
verb: fold
noun: middle
modifier: recursively
context: filter
slot: factor int
phrase: fold middle recursively collapsing inward by divisor {factor}
phrase: reduce middle values recursively scaled by {factor}
test: list=10,20,30,40,50 factor=2
expect: => i=45 r=0.0 ok=true s="folded middle recursively: 45" errors=0 n=3 res=[10,45,50] cache=0 hits=0
test: list=5,15,25,35 factor=3
expect: => i=13 r=0.0 ok=true s="folded middle recursively: 13" errors=0 n=3 res=[5,13,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let divisor = ${factor};
	if g.n < 3 || divisor <= 0 { return out; }
	var mid_sum = 0;
	var i = 1;
	while i < g.n - 1 {
		mid_sum += g.res[i];
		i++;
	}
	let folded = mid_sum / divisor;
	g.res[1] = folded;
	g.res[2] = g.res[g.n - 1];
	g.n = 3;
	out.i = folded;
	out.s.clear();
	format(out.s, "folded middle recursively: ", folded);
	out
}
@end
