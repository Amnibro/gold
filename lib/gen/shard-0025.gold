code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${min_val};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var modified = 0;
	for i in g.n {
		if g.res[i] < lower {
			g.res[i] = lower;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "limited ", modified, " values to lower bound");
