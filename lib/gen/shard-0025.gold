@entry d9c0a30aff9c187b
kind: step
verb: shift
noun: steps
modifier: recursively
context: error
phrase: shift steps recursively error propagation depth {depth}
phrase: cycle steps recursively depth budget {depth}
slot: depth int
test: list=1,2,3,4 depth=2
expect: => i=3 r=0.0 ok=true s="first element after recursive shift: 3" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=10,20,30 depth=1
expect: => i=30 r=0.0 ok=true s="first element after recursive shift: 30" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 {
		gold_fail(g, "empty sequence for recursive shift");
		out.ok = false;
		return out;
	}
	if d > g.n {
		gold_fail(g, "shift depth exceeds sequence length");
	}
	var round = 0;
	while round < d {
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last_val;
		round++;
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "first element after recursive shift: ", g.res[0]);
	out
}
@end
