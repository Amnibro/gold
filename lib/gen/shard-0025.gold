noun: odds
modifier: unique
context: stats
phrase: normalize odds unique
phrase: count unique odd digits
test: arg=135,111
expect: 3
expect: 1
test: arg=246,1379
expect: 0
expect: 4
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	var unique_odds = 0;
	var d = 1;
	while d <= 9 {
		var curr = val;
		var found = false;
		while curr > 0 {
			if (curr % 10) == d {
				found = true;
			}
			curr = curr / 10;
		}
		if found {
			unique_odds++;
		}
		d += 2;
	}
	return unique_odds;
}
@end
