test: list=3,1,2 f=double max_swaps=3
expect: => i=2 r=0.0 ok=true s="swapped inversions: 2" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=5,4,3,2,1 f=double max_swaps=1
expect: => i=10 r=0.0 ok=false s="error: swaps 10 exceed 1" errors=1 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_swaps};
	for k in g.n { g.res[k] = ${f}(g.res[k]); }
	var swaps = 0;
	let m = g.n - 1;
	for i in m {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
		}
	}
	g.steps += g.n * g.n;
	if swaps > cap {
		gold_fail(g, "swaps exceed maximum allowance");
		out.ok = false;
		out.i = swaps;
		out.s.clear();
		format(out.s, "error: swaps ", swaps, " exceed ", cap);
		return out;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped inversions: ", swaps);
	out
}
@end
