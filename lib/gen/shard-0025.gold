test: list=11,6,5,9,2
expect: => i=3 r=0.0 ok=true s="identified 3 alternating prime elements" errors=0 n=5 res=[11,6,5,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var is_p = val > 1;
		var d = 2;
		while d * d <= val {
			if val % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { prime_count++; }
		i += 2;
	}
	out.i = prime_count;
	out.s.clear();
	format(out.s, "identified ", prime_count, " alternating prime elements");
	out
}
@end
