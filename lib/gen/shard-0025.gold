fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${tag};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var median = 0;
	if g.n > 0 {
		median = g.res[g.n / 2];
	}
	gold_cache_put(g, tg, median);
	let cached, ok = gold_cache_get(g, tg);
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached median value: ", cached);
	out
}
@end
