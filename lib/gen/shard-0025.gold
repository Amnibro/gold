expect: => i=-1 r=0.0 ok=false s="target not found" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	if idx >= 0 {
		out.ok = true;
		format(out.s, "found target at index ", idx);
	} else {
		out.ok = false;
		format(out.s, "target not found");
	}
	out
}
@end
