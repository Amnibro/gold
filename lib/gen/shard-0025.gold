@entry 470ad6a165ed583d
kind: step
verb: find
noun: history
modifier: with_cache
context: sort
phrase: find history with_cache querying index {idx}
phrase: lookup sorted element at index {idx} using cache
phrase: retrieve cached item at sorted rank {idx}
slot: idx int
test: list=50,10,30,40,20 idx=2
expect: => i=30 r=0.0 ok=true s="found value at index: 30" errors=0 n=5 res=[10,20,30,40,50] cache=1 hits=0
test: list=10,20 idx=5
expect: => i=-1 r=0.0 ok=false s="index out of range" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_idx = ${idx};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if target_idx >= 0 && target_idx < g.n {
		let val = g.res[target_idx];
		gold_cache_put(g, target_idx, val);
		out.i = val;
		out.ok = true;
		out.s.clear();
		format(out.s, "found value at index: ", val);
	} else {
		out.i = -1;
		out.ok = false;
		out.s.clear();
		format(out.s, "index out of range");
	}
	g.steps += g.n;
	out
}
@end
