code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var start = g.n - sp;
	if start < 0 { start = 0; }
	var total = 0;
	var i = start;
	while i < g.n {
		total += g.res[i];
		i++;
	}
	g.steps += g.n - start;
	out.i = total;
	out.s.clear();
	format(out.s, "trailing window sum: ", total);
	out
}
@end
@entry f6b076c8cf06924c
kind: step
verb: normalize
noun: number
modifier: in_reverse
context: transform
phrase: normalize number in reverse reversing digit sequences
phrase: invert digits of each element throughout sequence
test: list=12,345,67,890
expect: => i=4 r=0.0 ok=true s="reversed numbers: 4" errors=0 n=4 res=[21,543,76,98] cache=0 hits=0
test: list=104,250,71,9
expect: => i=4 r=0.0 ok=true s="reversed numbers: 4" errors=0 n=4 res=[401,52,17,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		g.res[i] = rev;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed numbers: ", g.n);
	out
}
@end
