code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty result list");
		out.ok = false;
		return out;
	}
	var max_idx = 0;
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			max_idx = k;
		}
	}
	g.steps += g.n;
	if max_val < th {
		gold_fail(g, "maximum value below threshold");
		out.ok = false;
		out.i = max_val;
		out.s.clear();
		format(out.s, "error: max ", max_val, " below ", th);
		return out;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[max_idx];
	g.res[max_idx] = tmp;
	out.i = max_val;
	out.s.clear();
	format(out.s, "swapped maximum to head: ", max_val);
	out
}
@end
