noun: limit
modifier: with_cache
context: cache
phrase: join limit entries using cache offset {bias}
phrase: merge limit records with cache shift {bias}
slot: bias int
test: list=5,12,8,20 bias=4
expect: => i=61 r=0.0 ok=true s="cache limit joined: 61" errors=0 n=4 res=[5,12,8,20] cache=4 hits=0
test: list=10,15,30 bias=6
expect: => i=73 r=0.0 ok=true s="cache limit joined: 73" errors=0 n=3 res=[10,15,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${bias};
	var sum_shifted = 0;
	for i in g.n {
		let adjusted = g.res[i] + shift;
		gold_cache_put(g, i, adjusted);
		sum_shifted += adjusted;
	}
	g.steps += g.n;
	out.i = sum_shifted;
	out.s.clear();
	format(out.s, "cache limit joined: ", sum_shifted);
	out
}
@end
