expect: 123
expect: 45
test: arg=11122 limit=2
expect: 1122
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var counts int[10] = [0; 10];
	var res = 0;
	var i = rlen - 1;
	while i >= 0 {
		let d = rev[i];
		if counts[d] < lim {
			res = res * 10 + d;
			counts[d]++;
		}
		i--;
	}
	res
}
@end
