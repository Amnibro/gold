code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sq};
	var k = 1;
	gold_clear(g);
	while k * k <= ms {
		gold_push(g, k * k);
		k++;
	}
	if g.n < 3 {
		gold_fail(g, "insufficient squares generated");
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "squares filled: ", g.n);
	out
}
@end
@entry fc20436c5f8a3559
kind: step
verb: collect
noun: range
modifier: at_least
context: error
phrase: collect range at least span threshold {min_span}
phrase: gather range at least span requirement {min_span}
slot: min_span int
test: list=10,50,20,90 min_span=40
expect: => i=80 r=0.0 ok=true s="calculated range span: 80" errors=0 n=4 res=[10,50,20,90] cache=0 hits=0
test: list=15,18,16 min_span=10
expect: => i=3 r=0.0 ok=false s="calculated range span: 3" errors=1 n=3 res=[15,18,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_span};
	if g.n == 0 {
		gold_fail(g, "empty results for range check");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for idx in g.n {
		if g.res[idx] < min_val { min_val = g.res[idx]; }
		if g.res[idx] > max_val { max_val = g.res[idx]; }
	}
	let span = max_val - min_val;
	if span < ms {
		gold_fail(g, "range span below minimum requirement");
		out.ok = false;
	}
	out.i = span;
	out.s.clear();
	format(out.s, "calculated range span: ", span);
	out
}
@end
@entry 397b7478f12790cf
kind: step
verb: find
noun: text
modifier: until
context: error
phrase: find text until error boundary marker {target}
phrase: scan text until error boundary token {target}
slot: target text
test: text="alpha beta gamma delta" target="gamma"
expect: => i=11 r=0.0 ok=true s="marker index: 11" errors=0 n=0 res=[] cache=0 hits=0
test: text="error failure retry abort" target="abort"
expect: => i=20 r=0.0 ok=true s="marker index: 20" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	let tlen = tgt.len;
	if tlen > 0 && out.s.len >= tlen {
		var i = 0;
		while i <= out.s.len - tlen {
			var is_matched = true;
			for j in tlen {
				if out.s[i + j] != tgt[j] {
					is_matched = false;
					break;
				}
			}
			if is_matched {
				found_idx = i;
				break;
			}
			i++;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "target text marker missing");
		out.ok = false;
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "marker index: ", found_idx);
	out
}
@end
