@entry 751015d1c423cae9
kind: step
verb: cache
noun: threshold
modifier: first
context: sort
phrase: cache threshold first index exceeding {bound}
phrase: memoize first sorted element surpassing {bound}
phrase: record initial value above {bound} into cache
slot: bound int
test: list=10,25,30,5,15 bound=20
expect: => i=25 r=0.0 ok=true s="cached threshold value 25" errors=0 n=5 res=[5,10,15,25,30] cache=1 hits=0
test: list=5,10,15 bound=50
expect: => i=-1 r=0.0 ok=true s="no value exceeded threshold" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var found = -1;
	for i in g.n {
		if g.res[i] > b {
			found = g.res[i];
			gold_cache_put(g, b, found);
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "cached threshold value ", found);
	} else {
		format(out.s, "no value exceeded threshold");
	}
	out
}
@end
@entry fb553393be2c1f60
kind: step
verb: drop
noun: tally
modifier: at_least
context: sort
phrase: drop tally at_least frequency threshold {min_freq}
phrase: remove elements repeating at least {min_freq} times
phrase: prune items with occurrence count at least {min_freq}
slot: min_freq int
test: list=1,2,2,2,3,4,4 min_freq=3
expect: => i=3 r=0.0 ok=true s="dropped 3 frequent items" errors=0 n=4 res=[1,3,4,4] cache=0 hits=0
test: list=1,1,2,2,3,3 min_freq=2
expect: => i=6 r=0.0 ok=true s="dropped 6 frequent items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_freq};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let count = j - i;
		if count < thresh {
			for k in count {
				g.res[kept] = g.res[i + k];
				kept++;
			}
		}
		i = j;
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " frequent items");
	out
}
@end
