@entry 5d1e0292d9be8415
kind: step
verb: run
noun: squares
modifier: all
context: error
phrase: run squares all error check under limit {limit}
phrase: verify all squares error bounds limit {limit}
slot: limit int
test: list=1,4,9,16 limit=20
expect: => i=4 r=0.0 ok=true s="valid squares: 4" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
test: list=4,9,25 limit=10
expect: => i=2 r=0.0 ok=false s="valid squares: 2" errors=1 n=3 res=[4,9,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var valid_count = 0;
	for idx in g.n {
		let x = g.res[idx];
		if x > lim {
			gold_fail(g, "square exceeds error limit");
			out.ok = false;
		} else {
			valid_count++;
		}
	}
	g.steps += g.n;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "valid squares: ", valid_count);
	out
}
@end
