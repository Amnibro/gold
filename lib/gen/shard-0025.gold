expect: => i=4 r=0.0 ok=true s="digits unique kept: 4" errors=0 n=4 res=[5,6,7,8] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept { if g.res[j] == x { seen = true; break; } }
		if !seen {
			gold_cache_put(g, kept, x);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "digits unique kept: ", kept);
	out
}
@end
