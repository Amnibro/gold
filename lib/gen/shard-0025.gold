kind: step
verb: pair
noun: number
modifier: with_cache
context: sort
phrase: pair number with cache key {base} in array
phrase: match number with cache lookup {base} across list
slot: base int
test: list=15,3,9,12 base=10
expect: => i=4 r=0.0 ok=true s="paired count: 4" errors=0 n=4 res=[3,9,12,15] cache=4 hits=0
test: list=8,20,4 base=5
expect: => i=3 r=0.0 ok=true s="paired count: 3" errors=0 n=3 res=[4,8,20] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for k in g.n {
		gold_cache_put(g, g.res[k], g.res[k] + b);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired count: ", g.n);
	g.steps += g.n;
	out
}
@end
@entry 2e4115b93994631c
kind: step
verb: count
noun: checkpoint
modifier: in_reverse
context: sort
phrase: count checkpoint in reverse bound {threshold} across list
phrase: tally checkpoint in reverse floor {threshold} in array
slot: threshold int
test: list=5,12,3,18,9 threshold=8
expect: => i=3 r=0.0 ok=true s="reverse check: 3" errors=0 n=5 res=[3,5,9,12,18] cache=0 hits=0
test: list=20,4,15,2 threshold=10
expect: => i=2 r=0.0 ok=true s="reverse check: 2" errors=0 n=4 res=[2,4,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] >= thresh { count++; }
		idx--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reverse check: ", count);
	g.steps += g.n;
	out
}
@end
@entry 41d00258db1f0046
kind: step
verb: select
noun: digits
modifier: nested
context: sort
phrase: select digits nested sum floor {min_sum} in list
phrase: filter digits nested total bound {min_sum} across array
slot: min_sum int
test: list=12,34,5,28,19 min_sum=7
expect: => i=3 r=0.0 ok=true s="selected: 3" errors=0 n=3 res=[19,28,34] cache=0 hits=0
test: list=45,11,8,22 min_sum=6
expect: => i=2 r=0.0 ok=true s="selected: 2" errors=0 n=2 res=[8,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var dsum = 0;
		while x > 0 { dsum += x % 10; x /= 10; }
		if dsum >= ms {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = kept;
	out.s.clear();
	format(out.s, "selected: ", kept);
	g.steps += g.n * 2;
	out
}
@end
