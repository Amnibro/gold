fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i + 1] - g.res[i] <= d { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "running adjacent pairs: ", count);
	out
}
