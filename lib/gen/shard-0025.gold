expect: => i=0 r=0.0 ok=true s="peak histogram bin: 0" errors=0 n=6 res=[2,3,5,8,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bin_size};
	if g.n == 0 || bs <= 0 { return out; }
	var max_freq = 0;
	var best_bin = 0;
	for i in g.n {
		let b = g.res[i] / bs;
		var freq = 0;
		for j in g.n {
			if g.res[j] / bs == b { freq++; }
		}
		if freq > max_freq {
			max_freq = freq;
			best_bin = b;
		}
	}
	out.i = best_bin;
	out.s.clear();
	format(out.s, "peak histogram bin: ", best_bin);
	g.steps += g.n * g.n;
	out
}
@end
