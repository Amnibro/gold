fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim >= 0 && lim < out.s.len {
		var temp byte[..200] = "";
		var i = 0;
		while i < lim {
			temp.push(out.s[i]);
			i++;
		}
		out.s = temp;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
