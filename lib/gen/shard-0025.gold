	if cnt > g.n { cnt = g.n; }
	if cnt < 0 { cnt = 0; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for idx in cnt {
		g.res[idx] += sval;
	}
	out.i = cnt;
	out.s.clear();
	format(out.s, "first mapped: ", cnt);
	g.steps += g.n + cnt;
	out
}
@end
