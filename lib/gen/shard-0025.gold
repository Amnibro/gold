	if val < 1 {
		return 0;
	}
	var steps = 0;
	while val > 1 {
		if (val % 2) == 0 {
			val = val / 2;
		} else {
			val = (3 * val) + 1;
		}
		steps++;
		if steps >= 100 {
			return 100;
		}
	}
	return steps;
}
