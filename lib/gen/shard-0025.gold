expect: => i=5 r=0.0 ok=true s="window filled elements: 5" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var step_val = 2;
	if g.n > 1 {
		step_val = g.res[g.n - 1] - g.res[g.n - 2];
	}
	var last = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	var reached = false;
	var iterations = 0;
	while iterations < 10 && g.n < 512 {
		last += step_val;
		gold_push(g, last);
		iterations++;
		if last >= tgt {
			reached = true;
			break;
		}
	}
	if !reached {
		gold_fail(g, "window sentinel target not reached");
		out.ok = false;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "window filled elements: ", g.n);
	out
}
@end
@entry aee0b0eaf1c27c11
kind: step
verb: retry
noun: items
modifier: while
context: sort
phrase: retry sorting items while out of order bound {limit}
phrase: repeat sorting items while unordered count exceeds {limit}
slot: limit int
test: list=9,2,7,4,1 limit=0
expect: => i=5 r=0.0 ok=true s="retry sort passes: 5" errors=0 n=5 res=[1,2,4,7,9] cache=0 hits=0
test: list=3,8,1,5 limit=2
expect: => i=3 r=0.0 ok=true s="retry sort passes: 3" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var passes = 0;
	var sorted = false;
	while !sorted && passes < 20 {
		sorted = true;
		if g.n > 1 {
			for i in (g.n - 1) {
				if g.res[i] > g.res[i + 1] {
					let tmp = g.res[i];
					g.res[i] = g.res[i + 1];
					g.res[i + 1] = tmp;
					sorted = false;
				}
			}
		}
		passes++;
		if passes > lim && sorted {
			break;
		}
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "retry sort passes: ", passes);
	out
}
@end
