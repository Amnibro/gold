@entry a2ae5a7cbf6e0a1a
kind: step
verb: drop
noun: sequence
modifier: times
context: error
phrase: drop sequence prefix repeatedly {rep} times
phrase: remove sequence items repeating operation {rep} times
slot: rep int
test: list=10,20,30,40,50 rep=2
expect: => i=3 r=0.0 ok=true s="remaining sequence items: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=10,20 rep=5
expect: => i=0 r=0.0 ok=false s="error: invalid drop count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${rep};
	if times <= 0 || times > g.n {
		gold_fail(g, "invalid repetition count for sequence drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid drop count");
		return out;
	}
	let new_n = g.n - times;
	for i in new_n {
		g.res[i] = g.res[i + times];
	}
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "remaining sequence items: ", new_n);
	out
}
@end
