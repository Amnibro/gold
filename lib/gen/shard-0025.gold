@entry f0a7c104c069c8f0
kind: step
verb: join
noun: evens
modifier: with_retry
context: search
phrase: join evens with retry attempts {retry}
phrase: combine even matches with retry bound {retry}
slot: retry int
test: list=1,2,3,4,5,6 retry=2
expect: => i=12 r=0.0 ok=true s="evens joined: 3" errors=0 n=9 res=[1,2,3,4,5,6,2,4,6] cache=0 hits=0
test: list=1,3,5,8 retry=3
expect: => i=8 r=0.0 ok=true s="evens joined: 1" errors=0 n=5 res=[1,3,5,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${retry};
	var evens = [0; 512];
	var en = 0;
	var att = 0;
	while att < max_att && en < 2 {
		en = 0;
		for i in g.n {
			let x = g.res[i];
			if x % 2 == 0 {
				evens[en] = x;
				en++;
			}
		}
		att++;
	}
	var sum = 0;
	for i in en {
		sum += evens[i];
		gold_push(g, evens[i]);
	}
	g.steps += en + att;
	out.i = sum;
	out.s.clear();
	format(out.s, "evens joined: ", en);
	out
}
@end
