fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var errs = 0;
	var idx = 0;
	while idx + 1 < g.n {
		if g.res[idx] > g.res[idx + 1] + tol { errs++; }
		idx += 2;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = errs;
	out.s.clear();
	format(out.s, "stride errors: ", errs);
	g.steps += g.n * 2;
	out
}
@end
