@entry 8744e3075032aba8
kind: step
verb: fill
noun: suffix
modifier: sorted
context: transform
phrase: fill suffix sorted with count {added}
phrase: append sorted suffix items count {added}
slot: added int
test: list=15,5,10 added=2
expect: => i=2 r=0.0 ok=true s="filled suffix sorted: 2" errors=0 n=5 res=[5,10,15,16,17] cache=0 hits=0
test: list=20,8,12 added=3
expect: => i=3 r=0.0 ok=true s="filled suffix sorted: 3" errors=0 n=6 res=[8,12,20,21,22,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let add_count = ${added};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let max_val = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	var k = 0;
	while k < add_count && g.n < 512 {
		gold_push(g, max_val + k + 1);
		k++;
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "filled suffix sorted: ", k);
	out
}
@end
