code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket_size};
	if b <= 0 { return out; }
	var temp int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = 0;
		while j < b && i + j < g.n {
			sum += g.res[i + j];
			j++;
		}
		temp[count] = sum;
		count++;
		i += b;
	}
	var k = 0;
	while k < count {
		g.res[k] = temp[k];
		k++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped buckets: ", count);
	out
}
@end
@entry 61e4bf839b7dbb6a
kind: step
verb: apply
noun: history
modifier: at_most
context: transform
slot: max_steps int
phrase: apply history at most capping backward delta steps {max_steps}
phrase: compute backward differences bounded by maximum step {max_steps}
test: list=10,25,35,40 max_steps=10
expect: => i=5 r=0.0 ok=true s="last history delta: 5" errors=0 n=4 res=[10,10,10,5] cache=0 hits=0
test: list=5,20,50,60 max_steps=12
expect: => i=10 r=0.0 ok=true s="last history delta: 10" errors=0 n=4 res=[5,12,12,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${max_steps};
	if g.n <= 1 { return out; }
	var i = g.n - 1;
	while i >= 1 {
		var diff = g.res[i] - g.res[i - 1];
		if diff > mx { diff = mx; }
		g.res[i] = diff;
		i--;
	}
	g.steps += g.n;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "last history delta: ", g.res[g.n - 1]);
	out
}
@end
