code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${lim};
	let pairs = g.n / 2;
	for i in pairs {
		var s = g.res[2 * i] + g.res[2 * i + 1];
		if s > cap { s = cap; }
		g.res[i] = s;
	}
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "merged ", pairs, " bounded alternating pairs");
	out
}
@end
