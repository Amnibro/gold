fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sval = ${step_val};
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_val = g.res[0] + sval;
	var k = 0;
	while k < g.n {
		let val = g.res[k] + sval;
		if val > max_val { max_val = val; }
		k += 2;
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "every other max: ", max_val);
	g.steps += g.n;
	out
}
@end
