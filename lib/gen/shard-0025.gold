@entry 5949b2d41501aa5a
kind: step
verb: apply
noun: average
modifier: between
context: transform
slot: low int
slot: high int
phrase: apply average between bounds replacing items within {low} to {high}
phrase: smooth values falling inside window between {low} through {high}
test: list=5,15,25,35,45 low=10 high=30
expect: => i=2 r=0.0 ok=true s="averaged count: 2" errors=0 n=5 res=[5,20,20,35,45] cache=0 hits=0
test: list=2,12,18,28,40 low=10 high=20
expect: => i=2 r=0.0 ok=true s="averaged count: 2" errors=0 n=5 res=[2,15,15,28,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= l && g.res[i] <= h {
			sum += g.res[i];
			count++;
		}
		i++;
	}
	if count > 0 {
		let avg = sum / count;
		var j = 0;
		while j < g.n {
			if g.res[j] >= l && g.res[j] <= h {
				g.res[j] = avg;
			}
			j++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "averaged count: ", count);
	out
}
@end
@entry f74e0f29a714023e
kind: step
verb: compare
noun: step
modifier: with_retry
context: transform
slot: threshold int
phrase: compare step with retry checking consecutive step delta {threshold}
phrase: verify step differences against tolerance threshold {threshold}
test: list=10,20,35,50 threshold=12
expect: => i=2 r=0.0 ok=false s="step violations: 2" errors=0 n=4 res=[10,20,35,50] cache=0 hits=0
test: list=5,10,15,20 threshold=6
expect: => i=0 r=0.0 ok=true s="step violations: 0" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var violations = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > th {
			violations++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = violations;
	out.ok = violations == 0;
	out.s.clear();
	format(out.s, "step violations: ", violations);
	out
}
@end
