code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if first { uniq++; }
	}
	g.steps += g.n * g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "distinct values count ", uniq);
	out
}
@end
@entry fd1e7c9f7a6863c7
kind: step
