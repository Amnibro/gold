context: error
phrase: apply loop in reverse error scaling {factor}
phrase: transform loop in reverse multiplier {factor}
slot: factor int
test: list=3,5,7 factor=2
expect: => i=6 r=0.0 ok=true s="first element post scale: 6" errors=0 n=3 res=[6,10,14] cache=0 hits=0
test: list=10,20 factor=-1
expect: => i=-10 r=0.0 ok=false s="first element post scale: -10" errors=1 n=2 res=[-10,-20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f < 0 {
		gold_fail(g, "negative factor error in reverse loop");
		out.ok = false;
	}
	var i = g.n - 1;
	while i >= 0 {
		g.res[i] *= f;
		i--;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "first element post scale: ", out.i);
	out
}
@end
@entry 8d82163d28ce4fb3
kind: step
verb: collect
noun: loop
modifier: pairwise
context: error
phrase: collect loop pairwise error delta tolerance {max_diff}
phrase: evaluate loop pairwise difference limit {max_diff}
slot: max_diff int
test: list=10,18,25,40 max_diff=10
expect: => i=15 r=0.0 ok=false s="max pairwise difference: 15" errors=1 n=4 res=[10,18,25,40] cache=0 hits=0
test: list=2,15,30 max_diff=8
expect: => i=15 r=0.0 ok=false s="max pairwise difference: 15" errors=2 n=3 res=[2,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var max_seen = 0;
	var idx = 1;
	while idx < g.n {
		let diff = g.res[idx] - g.res[idx - 1];
		let adiff = if diff < 0 { 0 - diff } else { diff };
		if adiff > max_seen { max_seen = adiff; }
		if adiff > md {
			gold_fail(g, "pairwise difference exceeded error threshold");
			out.ok = false;
		}
		idx++;
	}
	out.i = max_seen;
	out.s.clear();
	format(out.s, "max pairwise difference: ", max_seen);
	out
}
@end
