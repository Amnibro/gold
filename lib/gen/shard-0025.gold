code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold_val};
	var count = 0;
	for i in g.n {
		if g.res[i] > t { count++; }
	}
	gold_cache_put(g, t, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "split counter with cache: ", count);
	out
}
@end
