code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var cur_len = 0;
	var max_found = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			if cur_len > max_found { max_found = cur_len; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len > max_found { max_found = cur_len; }
	g.steps += out.s.len;
	if max_found > lim {
		gold_fail(g, "word length exceeds limit");
		out.ok = false;
		out.i = max_found;
		out.s.clear();
		format(out.s, "error: word length ", max_found, " exceeds ", lim);
		return out;
	}
	out.i = max_found;
	out.s.clear();
	format(out.s, "max word length: ", max_found);
	out
}
