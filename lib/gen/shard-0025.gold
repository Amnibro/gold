code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var count = 0;
	var found = false;
	for k in g.n {
		count++;
		if g.res[k] == t {
			found = true;
			break;
		}
	}
	g.steps += count;
	g.n = count;
	out.ok = found;
	out.i = count;
	out.s.clear();
	format(out.s, if found { "target found" } else { "target absent" });
	out
}
@end
