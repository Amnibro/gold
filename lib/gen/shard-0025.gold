	let d = ${delta};
	let half = g.n / 2;
	var updated_sum = 0;
	var i = half;
	while i < g.n {
		g.res[i] += d;
		if g.res[i] < 0 {
			gold_fail(g, "negative element produced in tail fill");
			out.ok = false;
		}
		updated_sum += g.res[i];
		i++;
	}
	out.i = updated_sum;
	out.s.clear();
	format(out.s, "updated tail sum: ", updated_sum);
	out
}
@end
