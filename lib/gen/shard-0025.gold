code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${turns};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i -= t;
	g.steps += g.n + t;
	out.s.clear();
	format(out.s, "counter rotated: ", out.i);
	out
}
@end
