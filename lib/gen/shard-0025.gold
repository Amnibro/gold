@entry 0df7e7d49c5a279c
kind: step
verb: apply
noun: odds
modifier: in_reverse
context: transform
slot: mult int
phrase: apply odds in reverse scaling odd numbers by multiplier {mult}
phrase: process sequence backwards scaling odd elements by factor {mult}
test: list=1,2,3,4,5 mult=3
expect: => i=3 r=0.0 ok=true s="scaled odds in reverse: 3" errors=0 n=5 res=[15,4,9,2,3] cache=0 hits=0
test: list=7,8,9,10 mult=5
expect: => i=2 r=0.0 ok=true s="scaled odds in reverse: 2" errors=0 n=4 res=[10,45,8,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var temp int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		var x = g.res[i];
		if x % 2 != 0 {
			x *= m;
			count++;
		}
		temp[g.n - 1 - i] = x;
		i--;
	}
	var j = 0;
	while j < g.n {
		g.res[j] = temp[j];
		j++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled odds in reverse: ", count);
	out
}
@end
