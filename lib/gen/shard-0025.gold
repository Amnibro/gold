phrase: scan odds first bonus {boost} across array
phrase: order odds first increment {boost} in list
slot: boost int
test: list=4,7,2,9,5 boost=1
expect: => i=3 r=0.0 ok=true s="odds first: 3" errors=0 n=5 res=[6,8,10,2,4] cache=0 hits=0
test: list=8,3,6,1 boost=2
expect: => i=2 r=0.0 ok=true s="odds first: 2" errors=0 n=4 res=[3,5,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bst = ${boost};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var odds int[512];
	var evens int[512];
	var oc = 0;
	var ec = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[oc] = g.res[k] + bst;
			oc++;
		} else {
			evens[ec] = g.res[k];
			ec++;
		}
	}
	for i in oc { g.res[i] = odds[i]; }
	for j in ec { g.res[oc + j] = evens[j]; }
	out.i = oc;
	out.s.clear();
	format(out.s, "odds first: ", oc);
	g.steps += g.n * 2;
	out
}
@end
