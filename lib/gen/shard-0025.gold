fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${min_count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
