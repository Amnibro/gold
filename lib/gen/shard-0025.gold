@entry 0f2609f466156a5c
kind: step
verb: search
noun: total
modifier: nested
context: math
slot: target int
phrase: search total nested pairs matching target sum {target}
phrase: find nested element pairs matching total sum {target}
test: list=2,4,6,8 target=10
expect: => i=2 r=0.0 ok=true s="found 2 nested sum pairs" errors=0 n=8 res=[2,4,6,8,2,8,4,6] cache=0 hits=0
test: list=1,3,5,7 target=8
expect: => i=2 r=0.0 ok=true s="found 2 nested sum pairs" errors=0 n=8 res=[1,3,5,7,1,7,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	let orig = g.n;
	var i = 0;
	while i < orig {
		var j = i + 1;
		while j < orig {
			if g.res[i] + g.res[j] == tgt {
				gold_push(g, g.res[i]);
				gold_push(g, g.res[j]);
				count++;
			}
			j++;
		}
		i++;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " nested sum pairs");
	out
}
@end
@entry 5f4832cf40008970
kind: step
verb: sort
noun: memo
modifier: times
context: math
slot: stride int
phrase: sort memo times segmented by interval {stride}
phrase: order memo times partitioned by stride {stride}
test: list=9,2,8,1,7,3 stride=2
expect: => i=6 r=0.0 ok=true s="sorted memo partitioned by stride 2" errors=0 n=6 res=[2,9,1,8,3,7] cache=0 hits=0
test: list=5,1,4,2,3,0 stride=3
expect: => i=6 r=0.0 ok=true s="sorted memo partitioned by stride 3" errors=0 n=6 res=[1,4,5,0,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	if s > 1 {
		var b = 0;
		while b + s <= g.n {
			var i = 0;
			while i < s {
				var j = i + 1;
				while j < s {
					if g.res[b + i] > g.res[b + j] {
						let tmp = g.res[b + i];
						g.res[b + i] = g.res[b + j];
						g.res[b + j] = tmp;
					}
					j++;
				}
				i++;
			}
			b += s;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted memo partitioned by stride ", s);
	out
}
@end
@entry 66db687e213ceb39
kind: step
verb: validate
noun: minimum
modifier: last
context: math
slot: floor_val int
phrase: validate minimum last suffix values against {floor_val}
phrase: check minimum last tail elements exceeding {floor_val}
test: list=10,15,20,25 floor_val=12
expect: => i=25 r=0.0 ok=true s="last element satisfies minimum: 25" errors=0 n=4 res=[10,15,20,25] cache=0 hits=0
test: list=30,40,10,5 floor_val=8
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[30,40,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for minimum validation");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	if last_val < ${floor_val} {
		gold_fail(g, "last element below minimum floor");
		out.ok = false;
		return out;
	}
	out.i = last_val;
	out.s.clear();
