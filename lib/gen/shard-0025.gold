@entry fcbaa5c26de68e9c
kind: pred
verb: keep
noun: head
modifier: unique
context: aggregate
slot: span int
phrase: keep head unique leading digits within span {span}
phrase: verify prefix elements are distinct for span {span}
test: arg=12345,11234 span=3
expect: true
expect: false
test: arg=45421 span=2
expect: true
code:
fn ${ID}(n int) bool {
	let s = ${span};
	var x = if n < 0 { -n } else { n };
	var digits int[16] = [0; 16];
	var count = 0;
	while x > 0 && count < 15 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	if count < s { return true; }
	var seen = 0;
	var is_uniq = true;
	var i = 0;
	while i < s {
		let d = digits[count - 1 - i];
		let mask = 1 << d;
		if (seen & mask) != 0 {
			is_uniq = false;
			break;
		}
		seen = seen | mask;
		i++;
	}
	is_uniq
}
@end
