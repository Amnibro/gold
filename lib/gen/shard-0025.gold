phrase: purge loop with retry fault limit {max_retries}
slot: max_retries int
test: list=1,0,2,0,3 max_retries=2
expect: => i=3 r=0.0 ok=true s="retained elements: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=0,0,0,4 max_retries=1
expect: => i=1 r=0.0 ok=false s="retained elements: 1" errors=1 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	var kept = [0; 512];
	var kn = 0;
	var dropped = 0;
	for idx in g.n {
		if g.res[idx] == 0 {
			dropped++;
		} else {
			kept[kn] = g.res[idx];
			kn++;
		}
	}
	if dropped > mr {
		gold_fail(g, "retries exceeded while dropping loop elements");
		out.ok = false;
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "retained elements: ", kn);
	out
}
@end
