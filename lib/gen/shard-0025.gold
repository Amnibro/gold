			g.res[i] = l;
			modified++;
		} else if g.res[i] > h {
			g.res[i] = h;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped items total: ", modified);
	out
}
@end
@entry 937ecd4e5efd0528
kind: step
verb: sort
noun: tally
modifier: each
context: filter
phrase: sort tally each item by frequency descending
phrase: order unique elements by occurrence tally descending
test: list=10,20,20,30,30,30,10
expect: => i=3 r=0.0 ok=true s="sorted items by tally descending: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
test: list=5,15,5,25,15,15
expect: => i=3 r=0.0 ok=true s="sorted items by tally descending: 3" errors=0 n=3 res=[15,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	var items int[256] = [0; 256];
	var freqs int[256] = [0; 256];
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in u {
			if items[j] == x { found = j; break; }
		}
		if found >= 0 {
			freqs[found]++;
		} else {
			items[u] = x;
			freqs[u] = 1;
			u++;
		}
	}
	for i in u {
		for j in (u - 1 - i) {
			if freqs[j] < freqs[j + 1] {
				let tf = freqs[j]; freqs[j] = freqs[j + 1]; freqs[j + 1] = tf;
				let ti = items[j]; items[j] = items[j + 1]; items[j + 1] = ti;
			}
		}
	}
	for i in u { g.res[i] = items[i]; }
	g.n = u;
	out.i = u;
	out.s.clear();
	format(out.s, "sorted items by tally descending: ", u);
	out
}
@end
