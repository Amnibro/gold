expect: => i=5 r=0.0 ok=true s="middle element value: 5" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	if g.n < 3 {
		gold_fail(g, "insufficient elements for middle normalization");
		out.ok = false;
		return out;
	}
	var passes = 0;
	while passes < mr {
		var i = 1;
		while i < g.n - 1 {
			g.res[i] = (g.res[i - 1] + g.res[i + 1]) / 2;
			i++;
		}
		passes++;
	}
	out.i = g.res[1];
	out.s.clear();
	format(out.s, "middle element value: ", g.res[1]);
	out
}
@end
