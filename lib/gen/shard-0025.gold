modifier: in_reverse
context: core
phrase: retry errors clearance in reverse quota {quota}
phrase: resolve errors backward with quota {quota}
slot: quota int
test: input=3 quota=5
expect: => i=3 r=0.0 ok=true s="errors cleared" errors=0 n=0 res=[] cache=0 hits=0
test: input=0 quota=2
expect: => i=0 r=0.0 ok=true s="errors cleared" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let q = ${quota};
	if out.i <= q {
		g.errors = 0;
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps++;
	out.s.clear();
	format(out.s, if out.ok { "errors cleared" } else { "quota exceeded" });
	out
}
@end
