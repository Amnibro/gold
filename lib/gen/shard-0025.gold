expect: => i=0 r=0.0 ok=true s="duplicates found: 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let al = ${allowed};
	var dups = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				dups++;
			}
			j++;
		}
		i++;
	}
	if dups > al {
		gold_fail(g, "duplicate count exceeds error ceiling");
		out.ok = false;
	}
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicates found: ", dups);
	out
}
@end
