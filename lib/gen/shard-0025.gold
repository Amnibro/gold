expect: => i=3 r=0.0 ok=true s="longest increasing streak: 3" errors=0 n=6 res=[5,4,3,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	var max_streak = 0;
	var cur = 1;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				cur++;
			} else {
				if cur > max_streak { max_streak = cur; }
				cur = 1;
			}
		}
		if cur > max_streak { max_streak = cur; }
	} else {
		max_streak = g.n;
	}
	var count = 0;
	if max_streak >= req { count = max_streak; }
	out.i = count;
	out.s.clear();
	format(out.s, "longest increasing streak: ", max_streak);
	out
}
@end
