noun: items
modifier: between
context: sort
phrase: retry items between start {start_idx} finish {end_idx} in list
phrase: sort items between head {start_idx} tail {end_idx} across array
slot: start_idx int
slot: end_idx int
test: list=9,4,7,1,5 start_idx=1 end_idx=3
expect: => i=3 r=0.0 ok=true s="sub sorted: 3" errors=0 n=5 res=[9,1,4,7,5] cache=0 hits=0
test: list=8,3,6,2 start_idx=0 end_idx=2
expect: => i=3 r=0.0 ok=true s="sub sorted: 3" errors=0 n=4 res=[3,6,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start_idx};
	var e = ${end_idx};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	if s < e {
		for i in s..e {
			var min_idx = i;
			for j in (i + 1)..(e + 1) {
				if g.res[j] < g.res[min_idx] { min_idx = j; }
			}
			if min_idx != i {
				let tmp = g.res[i];
				g.res[i] = g.res[min_idx];
				g.res[min_idx] = tmp;
			}
		}
	}
	let sorted_count = if e >= s { e - s + 1 } else { 0 };
	out.i = sorted_count;
	out.s.clear();
	format(out.s, "sub sorted: ", sorted_count);
	g.steps += sorted_count * sorted_count;
	out
}
@end
@entry fcb7b3425962184a
kind: step
verb: retry
noun: text
modifier: while
context: sort
phrase: retry text while passes {limit} in array
phrase: bubble text while rounds {limit} across list
slot: limit int
test: list=5,1,4,2 limit=3
expect: => i=4 r=0.0 ok=true s="passes: 3" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
test: list=8,3,7,2 limit=2
expect: => i=4 r=0.0 ok=true s="passes: 2" errors=0 n=4 res=[3,2,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var passes = 0;
	var total_swaps = 0;
	while passes < lim {
		var swapped = false;
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
				total_swaps++;
			}
		}
		passes++;
		if !swapped { break; }
	}
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "passes: ", passes);
	g.steps += passes * g.n;
	out
}
@end
@entry a1caf74dacd28ef0
kind: step
