@entry 071966394beae24e
kind: step
verb: normalize
noun: errors
modifier: nested
context: transform
phrase: normalize errors nested threshold limit {bound_val}
phrase: verify nested error bounds below {bound_val}
slot: bound_val int
test: list=5,10,15 bound_val=20
expect: => i=0 r=0.0 ok=true s="normalized errors nested: 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=12,25 bound_val=15
expect: => i=1 r=0.0 ok=false s="normalized errors nested: 1" errors=1 n=2 res=[12,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound_val};
	var all_within = true;
	for i in g.n {
		if g.res[i] > b { all_within = false; break; }
	}
	if all_within {
		g.errors = 0;
	} else {
		gold_fail(g, "bounds exceeded");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.errors;
	out.s.clear();
	format(out.s, "normalized errors nested: ", g.errors);
	out
}
@end
