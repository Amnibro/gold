phrase: filter elements with_retry seeking target {target}
slot: target int
test: list=10,20,20,30 target=20
expect: => i=2 r=0.0 ok=true s="selected count: 2" errors=0 n=4 res=[10,20,20,30] cache=0 hits=0
test: list=10,19,30 target=20
expect: => i=1 r=0.0 ok=true s="selected count: 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for i in g.n {
		if g.res[i] == tgt { count++; }
	}
	if count == 0 {
		for i in g.n {
			if g.res[i] == tgt + 1 || g.res[i] == tgt - 1 {
				g.res[i] = tgt;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "selected count: ", count);
	out
}
@end
