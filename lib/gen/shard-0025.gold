phrase: clamp squares pairwise differences bounding at {max_square}
phrase: cap squares pairwise distance bounds by {max_square}
test: list=1,5,10 max_square=20
expect: => i=2 r=0.0 ok=true s="clamped pairwise squares into 2 differences" errors=0 n=2 res=[16,20] cache=0 hits=0
test: list=2,8,15 max_square=30
expect: => i=2 r=0.0 ok=true s="clamped pairwise squares into 2 differences" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_square};
	if g.n > 1 {
		let pairs = g.n - 1;
		for i in pairs {
			let diff = g.res[i + 1] - g.res[i];
			var sq = diff * diff;
			if sq > cap { sq = cap; }
			g.res[i] = sq;
		}
		g.n = pairs;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped pairwise squares into ", g.n, " differences");
	out
}
@end
