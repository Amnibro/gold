fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let def_v = ${default_val};
	var misses = 0;
	for idx in g.n {
		let k = g.res[idx];
		let val, ok = gold_cache_get(g, k);
		if !ok {
			misses++;
			gold_fail(g, "memo cache entry missing");
			gold_cache_put(g, k, def_v);
		}
	}
	out.i = misses;
	out.s.clear();
	format(out.s, "memo misses handled: ", misses);
	out
