phrase: rotate sorted tail elements right by {offset}
phrase: permute tail of sorted array by {offset}
slot: offset int
test: list=5,1,4,2,3 offset=1
expect: => i=5 r=0.0 ok=true s="tail shifted running length 5" errors=0 n=5 res=[1,5,2,3,4] cache=0 hits=0
test: list=10,20 offset=2
expect: => i=2 r=0.0 ok=true s="tail shifted running length 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 2 && off > 0 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 1 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[1] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail shifted running length ", g.n);
	out
}
@end
