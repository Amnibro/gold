expect: 13
test: arg=6,7
expect: 13
expect: 17
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	var sum_odds = 0;
	var i = 1;
	while i <= val {
		if (i % 2) != 0 {
			sum_odds += i;
		}
		i++;
	}
	var cached_bonus = sum_odds % 5;
	return sum_odds + cached_bonus;
}
@end
