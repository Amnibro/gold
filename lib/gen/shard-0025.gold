code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_pairs};
	var pairs = 0;
	let m = g.n - 1;
	for k in m {
		if ${stop}(g.res[k]) { break; }
		if g.res[k] == g.res[k + 1] { pairs++; }
	}
	g.steps += g.n;
	if pairs < req {
		gold_fail(g, "insufficient pairs before stop");
		out.ok = false;
		out.i = pairs;
		out.s.clear();
		format(out.s, "error: found ", pairs, " pairs, required ", req);
		return out;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "counted pairs before stop: ", pairs);
	out
}
@end
