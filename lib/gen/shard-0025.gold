fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n < 2 { return out; }
	var w = 0;
	for i in (g.n - 1) {
		let a = g.res[i];
		let b = g.res[i + 1];
		let gap = if b > a { b - a } else { a - b };
		if gap >= m {
			g.res[w] = a;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "retained prime pairs: ", w);
	g.steps += g.n;
	out
}
@end
