fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ref = ${ref_val};
	if g.n == 0 {
		gold_fail(g, "empty results for middle value check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let mid = g.n / 2;
	if g.res[mid] != ref {
		gold_fail(g, "middle element does not match reference");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: middle mismatch");
		return out;
	}
	out.i = g.res[mid];
	out.s.clear();
	format(out.s, "middle reference confirmed: ", ref);
	out
}
@end
@entry c41a7cb9f9c9f183
kind: step
verb: collect
noun: function
modifier: in_reverse
context: error
phrase: collect function results in reverse up to bound {rev_limit}
phrase: accumulate function outputs backwards capped at {rev_limit}
slot: rev_limit int
test: list=1,2,3,4 rev_limit=2
expect: => i=7 r=0.0 ok=true s="collected reverse sum: 7" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2 rev_limit=0
expect: => i=0 r=0.0 ok=false s="error: invalid reverse limit" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${rev_limit};
	if lim <= 0 || lim > g.n {
		gold_fail(g, "reverse collection limit out of range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid reverse limit");
		return out;
	}
	var sum = 0;
	var i = g.n - 1;
	var count = 0;
	while count < lim {
		sum += g.res[i];
		count++;
		i--;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "collected reverse sum: ", sum);
	out
}
@end
