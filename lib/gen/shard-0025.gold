@entry 50390587da8da119
kind: step
verb: normalize
noun: values
modifier: with_retry
context: transform
slot: target int
phrase: normalize values with retry shifting toward baseline {target}
phrase: adjust elements toward target value {target}
test: list=10,20,30 target=15
expect: => i=3 r=0.0 ok=true s="adjusted values: 3" errors=0 n=3 res=[11,19,29] cache=0 hits=0
test: list=5,15,25 target=20
expect: => i=3 r=0.0 ok=true s="adjusted values: 3" errors=0 n=3 res=[6,16,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var adjusted = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > tgt {
			g.res[i] -= 1;
			adjusted++;
		} else if g.res[i] < tgt {
			g.res[i] += 1;
			adjusted++;
		}
		i++;
	}
	g.steps += adjusted;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted values: ", adjusted);
	out
}
@end
@entry 33849043708af8ac
kind: step
verb: run
noun: digits
modifier: recursively
context: transform
phrase: run digits recursively computing nested digit sums
phrase: reduce each number recursively to single digit digital root
test: list=15,99,123,456
expect: => i=4 r=0.0 ok=true s="reduced digits count: 4" errors=0 n=4 res=[6,9,6,6] cache=0 hits=0
test: list=38,77,24,9
expect: => i=4 r=0.0 ok=true s="reduced digits count: 4" errors=0 n=4 res=[2,5,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x >= 10 {
			var dsum = 0;
			var temp = x;
			while temp > 0 {
				dsum += temp % 10;
				temp /= 10;
			}
			x = dsum;
		}
		g.res[i] = x;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reduced digits count: ", g.n);
	out
}
@end
