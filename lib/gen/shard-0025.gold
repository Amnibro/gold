test: list=10,12,15,19
expect: => i=3 r=0.0 ok=true s="sorted 3 adjacent step differences" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=5,8,10,16
expect: => i=3 r=0.0 ok=true s="sorted 3 adjacent step differences" errors=0 n=3 res=[2,3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let steps = g.n - 1;
		for i in steps {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = steps;
		var i = 0;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " adjacent step differences");
	out
}
@end
