@entry 861f50b9b4a1a337
kind: step
verb: select
noun: cache
modifier: up_to
context: core
phrase: select cache values up to {cap}
phrase: gather cache entries up to limit {cap}
slot: cap int
test: input=7 cap=20
expect: => i=7 r=0.0 ok=true s="cache entry selected" errors=0 n=1 res=[7] cache=1 hits=1
test: input=15 cap=10
expect: => i=0 r=0.0 ok=false s="cache entry exceeds limit" errors=0 n=0 res=[] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	gold_cache_put(g, 1, out.i);
	let val, ok = gold_cache_get(g, 1);
	if ok && val <= c {
		gold_push(g, val);
		out.ok = true;
		out.i = val;
	} else {
		out.ok = false;
		out.i = 0;
	}
	out.s.clear();
	format(out.s, if out.ok { "cache entry selected" } else { "cache entry exceeds limit" });
	out
}
@end
