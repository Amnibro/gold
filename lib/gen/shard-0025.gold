expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${n} < 2 {
		gold_fail(g, "count must be at least 2");
		out.ok = false;
		return out;
	}
	let k = gold_dfind(g);
	if k < 0 {
		gold_fail(g, "no item yet");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	o.append(" ra");
	format(o, ${n});
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "array");
	out
}
@end
