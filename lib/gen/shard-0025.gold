code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		gold_cache_put(g, x, i);
		let val, ok = gold_cache_get(g, x);
		if ok { matches++; }
		i--;
	}
	g.steps += matches;
	out.i = matches;
	out.s.clear();
	format(out.s, "reverse memo matches: ", matches);
	out
}
@end
@entry 3d7f52cb7b2f31b4
kind: step
verb: split
noun: window
modifier: with_cache
context: transform
slot: win int
phrase: split window with cache storing subsegment sums for window {win}
phrase: partition windows caching block totals using size {win}
test: list=1,2,3,4,5,6 win=2
expect: => i=3 r=0.0 ok=true s="window blocks: 3" errors=0 n=3 res=[3,7,11] cache=3 hits=0
test: list=10,20,30,40 win=2
expect: => i=2 r=0.0 ok=true s="window blocks: 2" errors=0 n=2 res=[30,70] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 0 { return out; }
	var temp int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		var block_sum = 0;
		var j = 0;
		while j < w && i + j < g.n {
			block_sum += g.res[i + j];
			j++;
		}
		temp[count] = block_sum;
		gold_cache_put(g, count, block_sum);
		count++;
		i += w;
	}
	var k = 0;
	while k < count {
		g.res[k] = temp[k];
		k++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "window blocks: ", count);
	out
}
@end
