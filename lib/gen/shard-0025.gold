fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${bucket};
	if bsize <= 0 { return out; }
	var bins int[10] = [0; 10];
	for i in g.n {
		let x = g.res[i];
		let b = if x < 0 { 0 } else { x / bsize };
		if b >= 0 && b < 10 {
			bins[b]++;
		}
	}
	g.n = 5;
	for k in 5 {
		g.res[k] = bins[k];
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "histogram traced bins");
	out
}
@end
