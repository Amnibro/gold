code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let expected_gap = ${gap};
	if out.s.len < 2 { return out; }
	var valid = true;
	for i in (out.s.len - 1) {
		let d = (out.s[i + 1] as int) - (out.s[i] as int);
		let abs_d = if d < 0 { -d } else { d };
		if abs_d != expected_gap {
			valid = false;
			break;
		}
	}
	out.i = if valid { 1 } else { 0 };
	out.ok = valid;
	out
}
@end
