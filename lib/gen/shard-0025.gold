phrase: combine unique minimum values across results
test: list=5,2,5,3,2,8
expect: => i=4 r=0.0 ok=true s="unique elements: 4" errors=0 n=4 res=[5,2,3,8] cache=0 hits=0
test: list=10,10,20,30,20
expect: => i=3 r=0.0 ok=true s="unique elements: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = [0; 512];
	var u = 0;
	for i in g.n {
		var exists = false;
		for j in u {
			if seen[j] == g.res[i] { exists = true; break; }
		}
		if !exists {
			seen[u] = g.res[i];
			u++;
		}
	}
	for i in u { g.res[i] = seen[i]; }
	g.n = u;
	g.steps += u;
	out.i = u;
	out.s.clear();
	format(out.s, "unique elements: ", u);
	out
}
@end
