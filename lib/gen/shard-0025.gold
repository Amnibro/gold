fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${w} <= 0.0 || ${h} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "pile_forest_around_center", "", o);
	o.append(" cone 0,0,");
	o.append("1 0,");
	o.append("0,");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${w});
	o.append(" m:matte ");
	gold_hex(o, 40, 95, 45);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "pileforestaroundcenter");
	out
}
@end
@entry ac3dacd848167468
kind: step
verb: scan
noun: maximum
modifier: nested
context: sort
phrase: scan maximum nested window {window} across array
phrase: find maximum nested span {window} in array
slot: window int
test: list=10,40,20,50,30 window=3
expect: => i=30 r=0.0 ok=true s="nested max: 30" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,1,8,2 window=2
expect: => i=2 r=0.0 ok=true s="nested max: 2" errors=0 n=4 res=[1,2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if g.n == 0 || win <= 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_val = g.res[0];
	let limit = if win < g.n { win } else { g.n };
	for k in limit {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "nested max: ", max_val);
	g.steps += g.n * win;
	out
}
@end
