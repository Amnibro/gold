test: list=4,2,4,1,2,5 offset=3
expect: => i=4 r=0.0 ok=true s="unique count: 4" errors=0 n=4 res=[4,5,7,8] cache=0 hits=0
test: list=10,5,10,20,5 offset=1
expect: => i=3 r=0.0 ok=true s="unique count: 3" errors=0 n=3 res=[6,11,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var write_idx = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
	}
	g.n = write_idx;
	for k in g.n {
		g.res[k] += off;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique count: ", g.n);
	g.steps += g.n * 2;
	out
}
@end
@entry ef60e8593e12617b
kind: step
verb: reverse
noun: condition
modifier: each
context: sort
phrase: reverse condition each divider {pivot} in array
phrase: invert condition each partition {pivot} across list
slot: pivot int
test: list=3,8,1,9,4,7 pivot=5
expect: => i=3 r=0.0 ok=true s="partition split: 3" errors=0 n=6 res=[4,3,1,7,8,9] cache=0 hits=0
test: list=12,2,15,4 pivot=10
expect: => i=2 r=0.0 ok=true s="partition split: 2" errors=0 n=4 res=[4,2,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var split_idx = g.n;
	for k in g.n {
		if g.res[k] >= p {
			split_idx = k;
			break;
		}
	}
	var l = 0;
	var r = split_idx - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = split_idx;
	out.s.clear();
	format(out.s, "partition split: ", split_idx);
	g.steps += g.n + split_idx;
	out
}
@end
@entry 02f36b95f0c7c858
kind: step
verb: scan
noun: value
modifier: all
context: sort
phrase: scan value all occurrence {target} in list
phrase: locate value all position {target} across array
slot: target int
test: list=20,10,40,30 target=30
expect: => i=2 r=0.0 ok=true s="target pos: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 target=15
expect: => i=1 r=0.0 ok=true s="target pos: 1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var found_idx = -1;
	var low = 0;
	var high = g.n - 1;
	while low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == tgt {
			found_idx = mid;
			break;
		} else if g.res[mid] < tgt {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "target pos: ", found_idx);
	g.steps += g.n;
	out
}
@end
@entry 446d2640dcc9f4f0
kind: step
verb: measure
noun: item
modifier: pairwise
context: sort
phrase: measure item pairwise difference offset {offset} across list
phrase: calculate item pairwise distance shift {offset} in list
slot: offset int
test: list=10,20,35,50 offset=2
expect: => i=46 r=0.0 ok=true s="diff sum: 46" errors=0 n=3 res=[12,17,17] cache=0 hits=0
test: list=5,15,30 offset=1
expect: => i=27 r=0.0 ok=true s="diff sum: 27" errors=0 n=2 res=[11,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n < 2 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total_diff = 0;
	for k in (g.n - 1) {
		let diff = g.res[k + 1] - g.res[k] + off;
		total_diff += diff;
		g.res[k] = diff;
	}
	g.n = g.n - 1;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "diff sum: ", total_diff);
	g.steps += g.n;
	out
}
@end
