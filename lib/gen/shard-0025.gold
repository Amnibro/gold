@entry 86bc55f16be0a311
kind: step
verb: scale
noun: duplicates
modifier: between
context: core
phrase: scale duplicate values by multiplier {mult}
phrase: multiply repeated items by factor {mult}
slot: mult int
test: list=2,3,2,5 mult=3
expect: => i=1 r=0.0 ok=true s="scaled 1 duplicate occurrences" errors=0 n=4 res=[2,3,6,5] cache=0 hits=0
test: list=1,4,7 mult=2
expect: => i=0 r=0.0 ok=true s="scaled 0 duplicate occurrences" errors=0 n=3 res=[1,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var scaled = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				g.res[j] *= m;
				scaled++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " duplicate occurrences");
	out
}
@end
