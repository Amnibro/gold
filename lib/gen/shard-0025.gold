phrase: order items comparing at least {floor}
slot: floor int
test: list=20,5,40,15,30 floor=15
expect: => i=4 r=0.0 ok=true s="sorted items above floor: 4" errors=0 n=5 res=[15,5,20,30,40] cache=0 hits=0
test: list=8,25,12,30,4 floor=10
expect: => i=3 r=0.0 ok=true s="sorted items above floor: 3" errors=0 n=5 res=[8,12,25,30,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var qualify_count = 0;
	for i in g.n {
		if g.res[i] >= fl { qualify_count++; }
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] >= fl && g.res[j] >= fl && g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = qualify_count;
	out.s.clear();
	format(out.s, "sorted items above floor: ", qualify_count);
	g.steps += g.n * g.n;
	out
}
@end
