code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var squares = [0; 512];
	var k = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			squares[k] = g.res[i];
			k++;
		}
	}
	for i in k {
		g.res[i] = squares[k - 1 - i];
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "squares kept: ", k);
	out
}
@end
