@entry c3b1fa375836eab3
kind: step
verb: pair
noun: limit
modifier: safely
context: list
phrase: pair limit safely adjacent elements under {limit}
phrase: sum adjacent pairs safely under limit {limit}
slot: limit int
test: list=2,5,3,8,4,1 limit=9
expect: => i=3 r=0.0 ok=true s="paired items: 3" errors=0 n=3 res=[7,9,5] cache=0 hits=0
test: list=10,20,5,12 limit=15
expect: => i=2 r=0.0 ok=true s="paired items: 2" errors=0 n=2 res=[15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let pairs = g.n / 2;
	var kept = 0;
	for k in pairs {
		let s = g.res[2 * k] + g.res[2 * k + 1];
		let val = if s <= lim { s } else { lim };
		g.res[kept] = val;
		kept++;
	}
	g.n = kept;
	g.steps += pairs;
	out.i = kept;
	out.s.clear();
	format(out.s, "paired items: ", kept);
	out
}
@end
@entry 5d895fdd8a538447
kind: step
verb: swap
noun: threshold
modifier: while
context: list
phrase: swap threshold while values exceed {thresh}
phrase: exchange adjacent elements while above {thresh}
slot: thresh int
test: list=15,25,35,45,5 thresh=10
expect: => i=2 r=0.0 ok=true s="swapped count: 2" errors=0 n=5 res=[25,15,45,35,5] cache=0 hits=0
test: list=8,20,30 thresh=10
expect: => i=0 r=0.0 ok=true s="swapped count: 0" errors=0 n=3 res=[8,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && g.res[i] > t && g.res[i + 1] > t {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += i;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped count: ", swaps);
	out
}
@end
