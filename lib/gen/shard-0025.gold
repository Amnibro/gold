expect: => i=2 r=0.0 ok=true s="results rotated up to: 2" errors=0 n=4 res=[15,5,25,35] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = if ${pos} < g.n { ${pos} } else { g.n };
	if bound > 1 {
		let first = g.res[0];
		for i in bound - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[bound - 1] = first;
	}
	for i in bound { gold_cache_put(g, i, g.res[i]); }
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "results rotated up to: ", bound);
	out
}
@end
