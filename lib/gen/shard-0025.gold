fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${checkpoint};
	let fac = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var scaled = 0;
	for k in g.n {
		if g.res[k] >= cp {
			g.res[k] *= fac;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled items: ", scaled);
	g.steps += g.n;
	out
}
@end
