fn ${ID}(g Gold&, v Val) Val {
	var out_06 = v;
	if !gold_img_ok(g) { out_06.ok = false; return out_06; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 2) % 2) as real;
		}
	}
	for k_06 in g.iw * g.ih { g.img[k_06] = gold_clamp01((g.img[k_06] - 0.5) * 1.6 + 0.5); }
	if ${n} < 2 || ${n} > 16 { gold_fail(g, "levels out of range"); out_06.ok = false; return out_06; }
	for k_06 in g.iw * g.ih {
		var q_06 = (g.img[k_06] * (${n} as real)) as! int;
		if q_06 > ${n} - 1 { q_06 = ${n} - 1; }
		g.img[k_06] = (q_06 as real) / ((${n} - 1) as real);
	}
	out_06.i = g.iw * g.ih;
	out_06.s.clear();
	format(out_06.s, "metal");
	out_06
}
@end
