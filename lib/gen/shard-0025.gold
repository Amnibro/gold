phrase: scale duplicates every other with factor {factor}
slot: factor int
test: list=2,2,4,4,6,6 factor=3
expect: => i=3 r=0.0 ok=true s="matched pairs scaled: 3" errors=0 n=6 res=[6,2,12,4,18,6] cache=0 hits=0
test: list=5,7,5,8,9 factor=2
expect: => i=0 r=0.0 ok=false s="matched pairs scaled: 0" errors=2 n=5 res=[5,7,5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var idx = 0;
	var matched = 0;
	while idx + 1 < g.n {
		if g.res[idx] != g.res[idx + 1] {
			gold_fail(g, "duplicate pair mismatch detected");
			out.ok = false;
		} else {
			matched++;
			g.res[idx] *= f;
		}
		idx += 2;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "matched pairs scaled: ", matched);
	out
}
@end
