@entry cb1b01743404a694
kind: pred
verb: filter
noun: runs
modifier: in_reverse
context: retry
phrase: filter runs in reverse retry cutoff {cutoff}
phrase: screen reverse retry runs against cutoff {cutoff}
slot: cutoff int
test: arg=1234,4321 cutoff=3
expect: false
expect: true
test: arg=92 cutoff=2
expect: true
code:
fn ${ID}(n int) bool {
	let c = ${cutoff};
	var x = if n < 0 { -n } else { n };
	var prev = -1;
	var run_len = 0;
	var max_run = 0;
	while x > 0 {
		var cur = x % 10;
		if prev >= 0 && cur >= prev {
			run_len++;
		} else {
			run_len = 1;
		}
		if run_len > max_run {
			max_run = run_len;
		}
		prev = cur;
		x /= 10;
	}
	max_run >= c
}
@end
