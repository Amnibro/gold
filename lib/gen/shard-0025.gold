fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${gap};
	if g.n < 2 { return out; }
	var valid = true;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > max_gap {
			valid = false;
			break;
		}
	}
	if !valid {
		gold_fail(g, "running gap violation");
		out.ok = false;
	}
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validated running spaces: ", out.i);
	out
}
