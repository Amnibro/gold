@entry 076ffb644d3127e3
kind: step
verb: sum
noun: errors
modifier: with_retry
context: aggregate
slot: err_limit int
phrase: sum errors with retry threshold {err_limit}
phrase: aggregate failed checks with retry ceiling {err_limit}
test: list=10,-2,30,-5 err_limit=3
expect: => i=7 r=0.0 ok=true s="aggregated error sum: 7" errors=0 n=4 res=[10,-2,30,-5] cache=0 hits=0
test: list=5,-1,-2,-3 err_limit=2
expect: => i=0 r=0.0 ok=false s="errors exceeded limit" errors=1 n=4 res=[5,-1,-2,-3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_errs = ${err_limit};
	var err_sum = 0;
	var err_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 {
			err_sum += -g.res[i];
			err_count++;
		}
		i++;
	}
	if err_count > max_errs {
		gold_fail(g, "too many errors");
		out.ok = false;
		out.s.clear();
		format(out.s, "errors exceeded limit");
		return out;
	}
	g.steps += g.n;
	out.i = err_sum;
	out.s.clear();
	format(out.s, "aggregated error sum: ", err_sum);
	out
}
@end
