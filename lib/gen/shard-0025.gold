@entry 64a9d8e315ba0ba6
kind: step
verb: group
noun: limit
modifier: at_most
context: transform
phrase: group limit at most size {bucket_size}
phrase: partition items into buckets of {bucket_size}
slot: bucket_size int
test: list=1,2,3,4,5,6 bucket_size=2
expect: => i=3 r=0.0 ok=true s="grouped limit at most buckets: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 bucket_size=3
expect: => i=2 r=0.0 ok=true s="grouped limit at most buckets: 2" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket_size};
	if b <= 0 { return out; }
	var keep = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var k = 0;
		while k < b && i + k < g.n {
			sum += g.res[i + k];
			k++;
		}
		g.res[keep] = sum;
		keep++;
		i += b;
	}
	g.steps += g.n;
	out.i = keep;
	g.n = keep;
	out.s.clear();
	format(out.s, "grouped limit at most buckets: ", keep);
	out
}
@end
@entry 5debceebb644c671
kind: step
verb: drop
noun: histogram
modifier: first
context: transform
phrase: drop histogram first peak frequency item
phrase: remove initial peak histogram element
test: list=2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="dropped peak histogram value: 3" errors=0 n=4 res=[2,3,3,4] cache=0 hits=0
test: list=5,5,6,7,7,7
expect: => i=7 r=0.0 ok=true s="dropped peak histogram value: 7" errors=0 n=5 res=[5,5,6,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_freq = 0;
	var peak_val = g.res[0];
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq > max_freq {
			max_freq = freq;
			peak_val = g.res[i];
		}
	}
	var keep = 0;
	var dropped = false;
	for i in g.n {
		if !dropped && g.res[i] == peak_val {
			dropped = true;
		} else {
			g.res[keep] = g.res[i];
			keep++;
		}
	}
	g.n = keep;
	g.steps += g.n;
	out.i = peak_val;
	out.s.clear();
	format(out.s, "dropped peak histogram value: ", peak_val);
	out
}
@end
@entry 61ecff6c0bf6ccfa
kind: step
verb: group
noun: list
modifier: while
context: transform
phrase: group list while sum under {ceiling_sum}
phrase: aggregate items while sum below {ceiling_sum}
slot: ceiling_sum int
test: list=10,20,30,40 ceiling_sum=45
expect: => i=30 r=0.0 ok=true s="grouped list while sum: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 ceiling_sum=22
expect: => i=20 r=0.0 ok=true s="grouped list while sum: 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling_sum};
	var running = 0;
	var keep = 0;
	for i in g.n {
		if running + g.res[i] <= ceil {
			running += g.res[i];
			keep++;
		} else {
			break;
		}
	}
	g.n = keep;
	g.steps += keep;
	out.i = running;
	out.s.clear();
	format(out.s, "grouped list while sum: ", running);
	out
}
@end
