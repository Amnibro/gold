expect: => i=2 r=0.0 ok=true s="sorted sequence at least: 2" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var m = 0;
	for i in g.n {
		if g.res[i] >= fl {
			g.res[m] = g.res[i];
			m++;
		}
	}
	g.n = m;
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = m;
	out.s.clear();
	format(out.s, "sorted sequence at least: ", m);
	out
}
@end
