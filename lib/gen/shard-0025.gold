@entry a449a65a2c806654
kind: step
verb: map
noun: window
modifier: none
context: core
phrase: map moving window sums using span {span}
phrase: compute rolling window totals with span {span}
slot: span int
test: list=1,2,3,4 span=2
expect: => i=3 r=0.0 ok=true s="computed 3 window sums" errors=0 n=7 res=[1,2,3,4,3,5,7] cache=0 hits=0
test: list=5,10,15 span=3
expect: => i=1 r=0.0 ok=true s="computed 1 window sums" errors=0 n=4 res=[5,10,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if s <= 0 || g.n < s {
		out.i = 0;
		return out;
	}
	var count = 0;
	for k in 0..(g.n - s + 1) {
		var win_sum = 0;
		for j in s { win_sum += g.res[k + j]; }
		gold_push(g, win_sum);
		count++;
	}
	g.steps += count * s;
	out.i = count;
	out.s.clear();
	format(out.s, "computed ", count, " window sums");
	out
}
@end
