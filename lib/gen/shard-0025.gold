code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		var r = 0;
		while r * r <= x {
			if r * r == x { is_sq = true; break; }
			r++;
		}
		if is_sq {
			var dup = false;
			for j in kept {
				if g.res[j] == x { dup = true; break; }
			}
			if !dup {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped perfect squares count: ", kept);
	out
}
@end
@entry 88d71995815fc35e
kind: step
verb: sort
noun: subfunction
modifier: nested
context: math
slot: block_size int
phrase: sort subfunction nested blocks of size {block_size}
phrase: order subfunction nested sublists of length {block_size}
test: list=4,2,3,1,8,6 block_size=2
expect: => i=6 r=0.0 ok=true s="sorted nested blocks of size 2" errors=0 n=6 res=[2,4,1,3,6,8] cache=0 hits=0
test: list=9,5,1,7,3,2 block_size=3
expect: => i=6 r=0.0 ok=true s="sorted nested blocks of size 3" errors=0 n=6 res=[1,5,9,2,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${block_size};
	if bsz > 1 {
		var start = 0;
		while start + bsz <= g.n {
			var i = 0;
			while i < bsz {
				var j = i + 1;
				while j < bsz {
					if g.res[start + i] > g.res[start + j] {
						let tmp = g.res[start + i];
						g.res[start + i] = g.res[start + j];
						g.res[start + j] = tmp;
					}
					j++;
				}
				i++;
			}
			start += bsz;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted nested blocks of size ", bsz);
	out
}
@end
