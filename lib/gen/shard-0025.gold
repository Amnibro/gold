test: list=3,1,4,1,5,1
expect: => i=3 r=0.0 ok=true s="dropped 3 minimum items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=7,7,7
expect: => i=3 r=0.0 ok=true s="dropped 3 minimum items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "dropped 0 minimum items");
		return out;
	}
	let min_val = g.res[0];
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] == min_val {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " minimum items");
	out
}
@end
