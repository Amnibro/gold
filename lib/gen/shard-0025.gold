fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${thresh};
	var new_len = g.n;
	var i = 0;
	while i < g.n {
		if g.res[i] >= cutoff {
			new_len = i + 1;
			break;
		}
		i++;
	}
	g.n = new_len;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "first threshold count: ", g.n);
	out
}
@end
