@entry 7f6dbcaad5517ab8
kind: step
verb: swap
noun: tail
modifier: while
context: core
phrase: swap tail elements while above {lim}
phrase: invert tail positions while exceeding {lim}
slot: lim int
test: list=1,8,9 lim=5
expect: => i=1 r=0.0 ok=true s="swapped 1 tail pairs" errors=0 n=3 res=[1,9,8] cache=0 hits=0
test: list=10,2,3 lim=7
expect: => i=0 r=0.0 ok=true s="swapped 0 tail pairs" errors=0 n=3 res=[10,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lim};
	var k = g.n - 1;
	var count = 0;
	while k >= 1 {
		if g.res[k] > l && g.res[k - 1] > l {
			let tmp = g.res[k];
			g.res[k] = g.res[k - 1];
			g.res[k - 1] = tmp;
			count++;
			k -= 2;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " tail pairs");
	out
}
@end
