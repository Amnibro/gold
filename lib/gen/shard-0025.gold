@entry 85716bdb2a509d2c
kind: step
verb: swap
noun: average
modifier: times
context: core
phrase: swap average scaled by factor {mult}
phrase: replace average multiplied by {mult}
slot: mult int
test: list=10,20,30 mult=2
expect: => i=40 r=0.0 ok=true s="scaled average 40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=4,8 mult=3
expect: => i=18 r=0.0 ok=true s="scaled average 18" errors=0 n=3 res=[4,8,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	let scaled = avg * m;
	gold_push(g, scaled);
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled average ", scaled);
	out
}
@end
