// env pile grass deep
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${s} <= 0.0 || ${t} <= 0.0 { gold_fail(g, "invalid grass pile"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "pile_grass_deep", "", o);
	o.append(" box ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, ${t} * 0.5);
	o.append(" ");
	gold_fnum(o, ${s});
	o.append(",");
	gold_fnum(o, ${s});
	o.append(",");
	gold_fnum(o, ${t});
	o.append(" m:matte ");
	gold_hex(o, 60, 130, 50);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "pile_grass_deep");
	out
}
@end
