@entry 30847e669376f8ff
kind: step
verb: check
noun: pairs
modifier: safely
context: sort
phrase: check pairs safely margin {tolerance} across array
phrase: verify pairs safely gap {tolerance} in list
slot: tolerance int
test: list=5,10,12,25 tolerance=3
expect: => i=1 r=0.0 ok=true s="close pairs: 1" errors=0 n=4 res=[5,10,12,25] cache=0 hits=0
test: list=2,8,9,14 tolerance=2
expect: => i=1 r=0.0 ok=true s="close pairs: 1" errors=0 n=4 res=[2,8,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n < 2 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var close_pairs = 0;
	for k in (g.n - 1) {
		if g.res[k + 1] - g.res[k] <= tol { close_pairs++; }
	}
	out.i = close_pairs;
	out.s.clear();
	format(out.s, "close pairs: ", close_pairs);
	g.steps += g.n;
	out
}
@end
