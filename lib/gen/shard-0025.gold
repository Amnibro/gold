modifier: with_cache
context: text
phrase: sort digit values across sequence loop
phrase: order digits from lowest to highest
test: arg=312,987
expect: 123
expect: 789
test: arg=420
expect: 24
code:
// text sort loop with_cache
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var counts = [0; 10];
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var out = 0;
	for d in 10 {
		for c in counts[d] {
			out = out * 10 + d;
		}
	}
	out
}
@end
@entry cd0b55a637f5424d
kind: pred
verb: validate
noun: step
modifier: until
context: text
phrase: validate monotonic step progression until finish
phrase: verify digits increase steadily until termination
test: arg=1234,4321
expect: true
expect: false
test: arg=135
expect: true
code:
// text validate step until
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var prev = 10;
	while x > 0 {
		let cur = x % 10;
		if cur > prev { return false; }
		prev = cur;
		x /= 10;
	}
	true
}
@end
@entry 9969e8813fb1a55a
kind: fn
verb: rotate
noun: steps
modifier: any
context: text
phrase: rotate digits across text step sequence
phrase: shift digit positions within step cycle
test: arg=1234,567
expect: 4123
expect: 756
test: arg=89
expect: 98
code:
// text rotate steps any
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	let d = x % 10;
	let rest = x / 10;
	var temp = rest;
	var mul = 1;
	while temp > 0 { mul *= 10; temp /= 10; }
	d * mul + rest
}
@end
