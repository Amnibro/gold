@entry ce5fb5307a801dca
kind: step
verb: retry
noun: threshold
modifier: every_other
context: list
phrase: retry threshold every_other alternating item limit {thresh}
phrase: adjust alternate elements until exceeding threshold {thresh}
slot: thresh int
test: list=1,10,3,20 thresh=8
expect: => i=3 r=0.0 ok=true s="retried count: 3" errors=0 n=4 res=[11,10,8,20] cache=0 hits=0
test: list=2,4,6,8 thresh=12
expect: => i=4 r=0.0 ok=true s="retried count: 4" errors=0 n=4 res=[12,4,16,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var retries = 0;
	var i = 0;
	while i < g.n {
		var k = 0;
		while g.res[i] < t && k < 10 {
			g.res[i] += 5;
			k++;
			retries++;
		}
		i += 2;
	}
	g.steps += retries;
	out.i = retries;
	out.s.clear();
	format(out.s, "retried count: ", retries);
	out
}
@end
@entry c34ababe03b488f0
kind: step
verb: scale
noun: range
modifier: nested
context: list
phrase: scale range nested span elements factor {factor}
phrase: multiply nested elements by span factor {factor}
slot: factor int
test: list=2,5,9 factor=3
expect: => i=21 r=0.0 ok=true s="scaled span: 21" errors=0 n=3 res=[6,15,27] cache=0 hits=0
test: list=10,20 factor=2
expect: => i=20 r=0.0 ok=true s="scaled span: 20" errors=0 n=2 res=[20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let f = ${factor};
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	for i in g.n {
		g.res[i] *= f;
	}
	g.steps += g.n;
	out.i = span * f;
	out.s.clear();
	format(out.s, "scaled span: ", span * f);
	out
}
@end
