noun: sequence
modifier: running
context: aggregate
slot: off int
phrase: shift sequence running by offset {off}
phrase: adjust sequence running values by delta {off}
test: list=10,20,30 off=5
expect: => i=3 r=0.0 ok=true s="shifted running sequence: 3" errors=0 n=3 res=[15,35,65] cache=0 hits=0
test: list=1,2,3 off=10
expect: => i=3 r=0.0 ok=true s="shifted running sequence: 3" errors=0 n=3 res=[11,13,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let delta = ${off};
	var run_sum = 0;
	var i = 0;
	while i < g.n {
		run_sum += g.res[i];
		g.res[i] = run_sum + delta;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted running sequence: ", g.n);
	out
}
@end
@entry c29731de9cf285b9
kind: step
verb: group
noun: values
modifier: in_place
context: aggregate
phrase: group values in place by parity
phrase: partition results in place into groups
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="grouped even count: 3" errors=0 n=6 res=[2,4,6,1,3,5] cache=0 hits=0
test: list=10,15,20,25
expect: => i=2 r=0.0 ok=true s="grouped even count: 2" errors=0 n=4 res=[10,20,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var ec = 0;
	var oc = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			evens[ec] = g.res[i];
			ec++;
		} else {
			odds[oc] = g.res[i];
			oc++;
		}
		i++;
	}
	i = 0;
	while i < ec {
		g.res[i] = evens[i];
		i++;
	}
	var j = 0;
	while j < oc {
		g.res[ec + j] = odds[j];
		j++;
	}
	g.steps += g.n;
	out.i = ec;
	out.s.clear();
	format(out.s, "grouped even count: ", ec);
	out
}
@end
@entry ab72fe65b48f5795
