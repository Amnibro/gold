@entry 1cb37b3022449cb4
kind: step
verb: apply
noun: checkpoint
modifier: each
context: sort
phrase: apply checkpoint each step rounding to nearest {step}
phrase: quantize sorted items to multiples of {step}
phrase: round sorted elements down to base {step}
slot: step int
test: list=12,28,34,5 step=10
expect: => i=4 r=0.0 ok=true s="quantized 4 items to step 10" errors=0 n=4 res=[0,10,20,30] cache=0 hits=0
test: list=7,14,21 step=5
expect: => i=3 r=0.0 ok=true s="quantized 3 items to step 5" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if s > 0 {
		for i in g.n {
			g.res[i] = (g.res[i] / s) * s;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "quantized ", g.n, " items to step ", s);
	out
}
@end
