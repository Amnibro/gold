expect: => i=7 r=0.0 ok=false s="error: run 7 exceeds 3" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_allowed};
	var run = 0;
	var max_run = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			run++;
			if run > max_run { max_run = run; }
		} else {
			run = 0;
		}
	}
	g.steps += out.s.len;
	if max_run > limit {
		gold_fail(g, "consecutive space limit exceeded");
		out.ok = false;
		out.i = max_run;
		out.s.clear();
		format(out.s, "error: run ", max_run, " exceeds ", limit);
		return out;
	}
	out.i = max_run;
	out.s.clear();
	format(out.s, "max space run: ", max_run);
	out
}
@end
