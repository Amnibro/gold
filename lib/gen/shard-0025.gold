slot: lo int
slot: hi int
test: list=10,12,15,18,21 p=is_odd lo=0 hi=3
expect: => i=2 r=0.0 ok=true s="matched condition index: 2" errors=0 n=5 res=[10,12,15,18,21] cache=0 hits=0
test: list=2,4,6,8,10 p=is_odd lo=1 hi=4
expect: => i=-1 r=0.0 ok=false s="matched condition index: -1" errors=1 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var matched_idx = -1;
	var i = l;
	while i <= h && i < g.n {
		if ${p}(g.res[i]) {
			matched_idx = i;
			break;
		}
		i++;
	}
	if matched_idx < 0 {
		gold_fail(g, "condition not met within interval");
		out.ok = false;
	}
	out.i = matched_idx;
	out.s.clear();
	format(out.s, "matched condition index: ", matched_idx);
	out
}
@end
@entry 4b90802c1e0afe0e
kind: step
verb: fill
noun: list
modifier: until
context: error
phrase: fill list until error ceiling limit {cap}
phrase: extend list until error capacity limit {cap}
slot: cap int
test: list=5,10,15 cap=35
expect: => i=46 r=0.0 ok=true s="sum reached: 46" errors=0 n=4 res=[5,10,15,16] cache=0 hits=0
test: list=2,4,8 cap=12
expect: => i=14 r=0.0 ok=true s="sum reached: 14" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var sum_val = 0;
	for idx in g.n { sum_val += g.res[idx]; }
	var added = 0;
	while sum_val < c && g.n < 512 && added < 10 {
		let val = if g.n > 0 { g.res[g.n - 1] + 1 } else { 1 };
		gold_push(g, val);
		sum_val += val;
		added++;
	}
	if sum_val < c {
		gold_fail(g, "ceiling capacity not achieved");
		out.ok = false;
	}
	out.i = sum_val;
	out.s.clear();
	format(out.s, "sum reached: ", sum_val);
	out
}
@end
