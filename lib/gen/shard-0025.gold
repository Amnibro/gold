fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pivot = -1;
	for i in g.n {
		if ${p}(g.res[i]) {
			pivot = i;
			break;
		}
	}
	if pivot > 0 {
		var buf = [0; 512];
		var bn = 0;
		for i in g.n - pivot {
			buf[bn] = g.res[pivot + i];
			bn++;
		}
		for i in pivot {
			buf[bn] = g.res[i];
			bn++;
		}
		for i in bn {
			g.res[i] = buf[i];
		}
	}
	g.steps += g.n;
	out.ok = pivot >= 0;
	out.i = pivot;
	out.s.clear();
	format(out.s, "pivot index: ", pivot);
	out
}
@end
