test: list=1,1,1,2,3,3,3,3,4 min_len=3
expect: => i=1 r=0.0 ok=true s="streak isolated: 1" errors=0 n=3 res=[1,1,1] cache=0 hits=0
test: list=5,5,6,7,7,7,8 min_len=3
expect: => i=7 r=0.0 ok=true s="streak isolated: 7" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n == 0 { return out; }
	var streak_val = g.res[0];
	var streak_len = 1;
	var found = false;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			streak_len++;
			if streak_len >= ml {
				streak_val = g.res[i];
				found = true;
				break;
			}
		} else {
			streak_len = 1;
		}
		i++;
	}
	if found {
		for k in streak_len { g.res[k] = streak_val; }
		g.n = streak_len;
		out.i = streak_val;
	} else {
		g.n = 0;
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "streak isolated: ", out.i);
	g.steps += g.n;
	out
}
@end
