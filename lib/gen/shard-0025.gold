fn ${ID}(g Gold&, v Val) Val {
	var out_10 = v;
	if !gold_img_ok(g) { out_10.ok = false; return out_10; }
	if !gold_img_square(g, 2) { out_10.ok = false; return out_10; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	for k_10 in g.iw * g.ih { if g.img[k_10] >= 0.65 { g.img[k_10] = 1.0; } else { g.img[k_10] = 0.0; } }
	for k_10 in g.iw * g.ih { g.img[k_10] = 1.0 - g.img[k_10]; }
	out_10.i = g.iw * g.ih;
	out_10.s.clear();
	format(out_10.s, "rust");
	out_10
}
@end
@entry 8d77098a09d09da2
kind: step
verb: dedupe
noun: prefix
modifier: none
context: compare
phrase: dedupe prefix none matching bound {bound}
phrase: remove duplicate prefix items matching bound {bound}
slot: bound int
test: list=4,4,4,7,7,9,2 bound=5
expect: => i=3 r=0.0 ok=true s="removed prefix dupes: 3" errors=0 n=4 res=[4,7,9,2] cache=0 hits=0
test: list=1,1,2,2,3,3 bound=4
expect: => i=2 r=0.0 ok=true s="removed prefix dupes: 2" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let limit = if b < g.n { b } else { g.n };
	if limit <= 1 { return out; }
	var w = 1;
	for i in 1..limit {
		if g.res[i] != g.res[i - 1] {
			g.res[w] = g.res[i];
			w++;
		}
	}
	for i in limit..g.n {
		g.res[w] = g.res[i];
		w++;
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed prefix dupes: ", removed);
	g.steps += limit;
	out
}
@end
@entry 6188c983ae109621
kind: step
verb: join
noun: words
modifier: unique
context: compare
phrase: join words unique threshold {min_len}
phrase: combine unique words comparing length {min_len}
slot: min_len int
test: text="apple pear apple plum kiwi pear" min_len=4
expect: => i=4 r=0.0 ok=true s="apple pear plum kiwi" errors=0 n=0 res=[] cache=0 hits=0
test: text="cat dog horse dog bird cat" min_len=4
expect: => i=2 r=0.0 ok=true s="horse bird" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let w = words(out.s);
	var distinct = 0;
	out.s.clear();
	for i in w.len {
		let word = w[i];
		if word.len >= ml {
			var seen = false;
			for j in i {
				if w[j] == word { seen = true; break; }
			}
			if !seen {
				if distinct > 0 { out.s.push(' '); }
				out.s.append(word);
				distinct++;
			}
		}
	}
	out.i = distinct;
	g.steps += w.len * distinct;
	out
}
@end
