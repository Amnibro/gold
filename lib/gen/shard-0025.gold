fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var adjusted = 0;
	for i in g.n {
		var k = 0;
		while !${p}(g.res[i]) && k < att {
			g.res[i]++;
			k++;
			adjusted++;
		}
	}
	g.steps += adjusted;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "retried count: ", adjusted);
	out
}
@end
