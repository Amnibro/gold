expect: => i=2 r=0.0 ok=true s="pruned duplicate primes: 2" errors=0 n=4 res=[3,5,7,11] cache=0 hits=0
test: list=2,2,3,3,5 bound=5
expect: => i=2 r=0.0 ok=true s="pruned duplicate primes: 2" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var is_prime = x >= 2;
		var d = 2;
		while d * d <= x { if x % d == 0 { is_prime = false; break; } d++; }
		var keep = true;
		if is_prime && x < b {
			for j in w {
				if g.res[j] == x { keep = false; break; }
			}
		}
		if keep {
			g.res[w] = x;
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.s.clear();
	format(out.s, "pruned duplicate primes: ", removed);
	g.steps += g.n;
	out
}
@end
@entry ffd5b629c3cf4609
kind: step
verb: join
noun: loop
modifier: sorted
context: compare
phrase: join loop sorted threshold {factor}
phrase: combine loop sorted items scaled {factor}
slot: factor int
test: list=8,2,6,4 factor=3
expect: => i=18 r=0.0 ok=true s="joined loop total: 18" errors=0 n=3 res=[6,6,6] cache=0 hits=0
test: list=15,5,10 factor=2
expect: => i=20 r=0.0 ok=true s="joined loop total: 20" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if g.n <= 1 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	for k in (g.n - 1) {
		let diff = (g.res[k + 1] - g.res[k]) * fac;
		total += diff;
		g.res[k] = diff;
	}
	g.n = g.n - 1;
	out.i = total;
	out.s.clear();
	format(out.s, "joined loop total: ", total);
	g.steps += g.n * 2;
	out
}
@end
