fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_digits};
	var kept = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d <= m {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept digits: ", kept);
	out
}
@end
