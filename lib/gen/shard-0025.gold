fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var evens_count = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[evens_count] = g.res[k];
			evens_count++;
		}
	}
	g.n = evens_count;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		var u = 1;
		for k in 1..g.n {
			if g.res[k] != g.res[u - 1] {
				g.res[u] = g.res[k];
				u++;
			}
		}
		g.n = u;
		for k in g.n { g.res[k] += off; }
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique evens: ", g.n);
	g.steps += g.n * 2;
	out
}
@end
