@entry 3bf024650feb20a9
kind: step
verb: validate
noun: gaps
modifier: nested
context: math
slot: max_gap int
phrase: validate gaps nested differences exceeding {max_gap}
phrase: verify gaps nested between successive values under {max_gap}
test: list=2,5,9,12 max_gap=5
expect: => i=4 r=0.0 ok=true s="validated maximum nested gap: 4" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
test: list=3,10,12 max_gap=4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[3,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_gap};
	var max_seen = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = -diff; }
			if diff > max_seen { max_seen = diff; }
			if diff > lim {
				gold_fail(g, "nested gap exceeds limit");
				out.ok = false;
				return out;
			}
		}
	}
	out.i = max_seen;
	out.s.clear();
	format(out.s, "validated maximum nested gap: ", max_seen);
	out
}
@end
@entry e4aab25ef5785990
kind: step
verb: clamp
noun: memo
modifier: up_to
context: math
slot: bound int
phrase: clamp memo up to maximum limit {bound}
phrase: restrict memo up to ceiling threshold {bound}
test: list=12,45,28,60 bound=30
expect: => i=2 r=0.0 ok=true s="clamped 2 values into memo cache" errors=0 n=4 res=[12,30,28,30] cache=4 hits=0
test: list=5,15,25,35 bound=20
expect: => i=2 r=0.0 ok=true s="clamped 2 values into memo cache" errors=0 n=4 res=[5,15,20,20] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > b {
			g.res[i] = b;
			clamped++;
		}
		gold_cache_put(g, i, g.res[i]);
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values into memo cache");
	out
}
@end
