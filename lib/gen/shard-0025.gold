code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let l = ${lo};
	let h = ${hi};
	var scaled = 0;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h {
			g.res[i] *= f;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled count: ", scaled);
	out
}
@end
@entry 2aebd8d23efbdd01
kind: step
