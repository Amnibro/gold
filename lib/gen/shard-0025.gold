code:
fn ${ID}(g Gold&, v Val) Val {
	var out_05 = v;
	if !gold_img_ok(g) { out_05.ok = false; return out_05; }
	var sp_05 = 4;
	for oct_05 in 2 { if !gold_img_square(g, sp_05) { out_05.ok = false; return out_05; } sp_05 = sp_05 / 2; }
	for y in g.ih {
		for x in g.iw {
			var acc_05 = 0.0;
			var wt_05 = 1.0;
			var tot_05 = 0.0;
			var cc_05 = 4;
			for oct_05 in 2 { acc_05 += wt_05 * gold_vnoise(x, y, cc_05, g.iw / cc_05, ${u} + oct_05); tot_05 += wt_05; wt_05 *= 0.5; cc_05 = cc_05 / 2; }
			g.img[y * g.iw + x] = acc_05 / tot_05;
		}
	}
	var bl_05 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t_05 = 0.0;
			for dy in 3 { for dx in 3 { t_05 += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			bl_05[y * g.iw + x] = t_05 / 9.0;
		}
	}
	g.img = bl_05;
	for k_05 in g.iw * g.ih { g.img[k_05] = gold_clamp01((g.img[k_05] - 0.5) * 1.3 + 0.5); }
	out_05.i = g.iw * g.ih;
	out_05.s.clear();
	format(out_05.s, "bark");
	out_05
}
@end
