code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_diff = ${delta};
	if g.n == 0 { return out; }
	var count = 1;
	while count < g.n {
		let diff = g.res[count] - g.res[count - 1];
		if diff != step_diff { break; }
		count++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "series search length: ", count);
	out
}
@end
