fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale_val};
	var res byte[>..] = [];
	for b in v.s {
		for k in s {
			if res.len < 190 {
				res.push(b);
			}
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	g.steps += v.s.len * s;
	out
}
@end
