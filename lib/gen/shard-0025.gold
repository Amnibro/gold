				g.res[i]++;
				resolved++;
				j = 0;
			} else {
				j++;
			}
		}
	}
	g.steps += resolved;
	out.i = resolved;
	out.s.clear();
	format(out.s, "resolved duplicates: ", resolved);
	out
}
@end
