@entry 88f52182fd56d20e
kind: step
verb: dedupe
noun: budget
modifier: in_place
context: search
phrase: dedupe budget in place limit {max_cost}
phrase: compact budget in place ceiling {max_cost}
slot: max_cost int
test: list=10,10,20,20,30 max_cost=50
expect: => i=30 r=0.0 ok=true s="budget dedupe spent: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,15,15,25 max_cost=40
expect: => i=20 r=0.0 ok=true s="budget dedupe spent: 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_cost};
	var buf = [0; 512];
	var bn = 0;
	var spent = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in bn {
			if buf[j] == x { seen = true; break; }
		}
		if !seen && spent + x <= mc {
			buf[bn] = x;
			bn++;
			spent += x;
		}
	}
	g.n = 0;
	for i in bn {
		gold_push(g, buf[i]);
	}
	g.steps += bn;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget dedupe spent: ", spent);
	out
}
@end
