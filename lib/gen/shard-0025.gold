code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var val = ${f}(g.res[i]);
		if val < 0 { val = 0; }
		g.res[i] = val;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "subfunction safely mapped ", g.n, " items");
	out
}
@end
@entry 0f10f83faaef4632
kind: step
verb: apply
noun: numbers
modifier: unique
context: sort
phrase: apply numbers unique filter removing duplicates
phrase: filter sorted list to unique distinct numbers
phrase: eliminate duplicate values across sorted array
test: list=4,2,2,1,4,3,1
expect: => i=4 r=0.0 ok=true s="unique numbers: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="unique numbers: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "unique numbers: 0");
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique numbers: ", kept);
	out
}
@end
