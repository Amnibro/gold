code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${k};
	if cnt > g.n { cnt = g.n; }
	if cnt < 0 { cnt = 0; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for idx in cnt {
		g.res[idx] = ${x}(g.res[idx]);
	}
	var l = 0;
	var r = cnt - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "reversed head: ", out.i);
	g.steps += g.n + cnt;
	out
}
@end
