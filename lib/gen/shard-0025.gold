	var o byte[>..] = [];
	if ${r} <= 0.0 || ${h} <= 0.0 {
		gold_fail(g, "invalid bushing extrusion");
		out.ok = false;
		return out;
	}
	gold_dnews(g, "ex_bu_th", "", o);
	o.append(" cyl ");
	o.append("0"); o.append(","); o.append("0"); o.append(","); o.append("0");
	o.append(" ");
	o.append("0"); o.append(","); o.append("0"); o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:copper");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ex_bu_th");
	out
}
@end
