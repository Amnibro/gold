expect: => i=3 r=0.0 ok=true s="numbers until target: 3" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	var cnt = 0;
	for i in g.n {
		sum += g.res[i];
		cnt++;
		if sum >= tgt { break; }
	}
	g.steps += cnt;
	out.i = cnt;
