fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_val};
	var processed = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] > cap {
			gold_fail(g, "series element exceeds threshold");
			out.ok = false;
			break;
		}
		processed++;
		idx++;
	}
	g.steps += idx + 1;
	out.i = processed;
	out.s.clear();
	format(out.s, "processed series: ", processed);
	out
}
@end
