test: list=10,20,5,5 ceiling=15
expect: => i=3 r=0.0 ok=true s="merged items: 3" errors=0 n=3 res=[10,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var w = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] + g.res[i + 1] <= ceil {
			g.res[w] = g.res[i] + g.res[i + 1];
			w++;
			i += 2;
		} else {
			g.res[w] = g.res[i];
			w++;
			i++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "merged items: ", w);
	out
}
@end
