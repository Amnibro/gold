@entry 57c71fd73539e9db
kind: step
verb: compare
noun: series
modifier: each
context: error
phrase: compare series each step tolerance {delta}
phrase: check series each adjacent gap {delta}
slot: delta int
test: list=10,15,22,28 delta=6
expect: => i=1 r=0.0 ok=false s="gap violations: 1" errors=1 n=4 res=[10,15,22,28] cache=0 hits=0
test: list=2,8,20,30 delta=5
expect: => i=3 r=0.0 ok=false s="gap violations: 3" errors=3 n=4 res=[2,8,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var violations = 0;
	var idx = 1;
	while idx < g.n {
		let diff = g.res[idx] - g.res[idx - 1];
		let adiff = if diff < 0 { 0 - diff } else { diff };
		if adiff > d {
			violations++;
			gold_fail(g, "series gap exceeds tolerance");
		}
		idx++;
	}
	out.i = violations;
	if violations > 0 {
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "gap violations: ", violations);
	out
}
@end
@entry 63112241a7d7fa9a
kind: step
