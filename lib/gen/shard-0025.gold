code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in m {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
	}
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped all elements: ", m);
	out
}
@end
