expect: => i=3 r=0.0 ok=true s="cached safely: 3" errors=0 n=4 res=[10,20,30,40] cache=3 hits=0
test: list=5,15,25 cap=2
expect: => i=2 r=0.0 ok=true s="cached safely: 2" errors=0 n=3 res=[5,15,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let capacity = ${cap};
	var stored = 0;
	var i = 0;
	while i < g.n && stored < capacity {
		gold_cache_put(g, i, g.res[i]);
		stored++;
		i++;
	}
	g.steps += stored;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached safely: ", stored);
	out
}
@end
