noun: step
modifier: recursively
context: filter
slot: factor int
phrase: trace step recursively dividing by factor {factor}
phrase: filter step recursively scaling down by {factor}
test: list=8,16,24,32 factor=2
expect: => i=15 r=0.0 ok=true s="recursive step reductions: 15" errors=0 n=4 res=[1,1,3,1] cache=0 hits=0
test: list=27,81,9,3 factor=3
expect: => i=10 r=0.0 ok=true s="recursive step reductions: 10" errors=0 n=4 res=[1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f <= 1 { return out; }
	var total_reductions = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 0 && x % f == 0 {
			x /= f;
			total_reductions++;
		}
		g.res[i] = x;
	}
	g.steps += total_reductions;
	out.i = total_reductions;
	out.s.clear();
	format(out.s, "recursive step reductions: ", total_reductions);
	out
}
@end
