kind: step
verb: rotate
noun: suffix
modifier: any
context: compare
phrase: rotate suffix any distance {count}
phrase: shift suffix elements by {count}
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=50 r=0.0 ok=true s="rotated suffix head: 50" errors=0 n=5 res=[10,20,50,30,40] cache=0 hits=0
test: list=1,2,3,4,5,6 count=2
expect: => i=6 r=0.0 ok=true s="rotated suffix head: 6" errors=0 n=6 res=[1,2,3,4,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n <= 1 || c <= 0 || c >= g.n { return out; }
	let start = g.n - c;
	let last = g.res[g.n - 1];
	var idx = g.n - 1;
	while idx > start {
		g.res[idx] = g.res[idx - 1];
		idx--;
	}
	g.res[start] = last;
	out.i = last;
	out.s.clear();
	format(out.s, "rotated suffix head: ", last);
	g.steps += c;
	out
}
@end
