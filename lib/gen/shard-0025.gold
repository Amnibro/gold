fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let th = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	g.steps += g.n;
	if min_val < th {
		gold_fail(g, "minimum value below required threshold");
		out.ok = false;
		out.i = min_val;
		out.s.clear();
		format(out.s, "error: min ", min_val, " below ", th);
		return out;
	}
	g.res[min_idx] *= f;
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "scaled minimum to: ", out.i);
	out
}
@end
