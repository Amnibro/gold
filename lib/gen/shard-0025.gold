modifier: up_to
context: transform
slot: limit int
phrase: sum memo up to caching partial sums below ceiling {limit}
phrase: memoize progressive sums while total remains below {limit}
test: list=10,20,30,40 limit=50
expect: => i=30 r=0.0 ok=true s="memoized sum: 30" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=5,15,25,35 limit=40
expect: => i=20 r=0.0 ok=true s="memoized sum: 20" errors=0 n=4 res=[5,15,25,35] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var cached = 0;
	var i = 0;
	while i < g.n {
		if total + g.res[i] <= lim {
			total += g.res[i];
			gold_cache_put(g, cached, total);
			cached++;
		} else {
			break;
		}
		i++;
	}
	g.steps += cached;
	out.i = total;
	out.s.clear();
	format(out.s, "memoized sum: ", total);
	out
}
@end
@entry 9b96d9e6cf43a42d
kind: step
verb: collect
noun: checkpoint
modifier: last
context: transform
slot: interval int
phrase: collect checkpoint last capturing intermediate values at step {interval}
phrase: sample periodic checkpoints across results with interval {interval}
test: list=10,20,30,40,50,60 interval=2
expect: => i=3 r=0.0 ok=true s="checkpoints captured: 3" errors=0 n=3 res=[20,40,60] cache=0 hits=0
test: list=1,2,3,4,5,6,7,8,9 interval=3
expect: => i=3 r=0.0 ok=true s="checkpoints captured: 3" errors=0 n=3 res=[3,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let iv = ${interval};
	if iv <= 0 { return out; }
	var m = 0;
	var i = iv - 1;
	while i < g.n {
		g.res[m] = g.res[i];
		m++;
		i += iv;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "checkpoints captured: ", m);
	out
}
@end
