fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_val};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found_idx = i;
			break;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "value not found in results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: value not found");
		return out;
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "value located at index: ", found_idx);
	out
}
@end
@entry 23f1b9ca8669aa43
kind: step
verb: group
noun: evens
modifier: pairwise
context: error
phrase: group evens pairwise checking pair difference limit {max_pair_diff}
phrase: cluster even elements in pairs constrained by {max_pair_diff}
slot: max_pair_diff int
test: list=2,4,6,8 max_pair_diff=3
expect: => i=2 r=0.0 ok=true s="grouped even pairs: 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=2,10 max_pair_diff=3
expect: => i=0 r=0.0 ok=false s="error: even pair gap exceeded" errors=1 n=2 res=[2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_pair_diff};
	var evens = [0; 512];
	var en = 0;
	for i in g.n {
		let x = g.res[i];
		let is_even = if x < 0 { (-x) % 2 == 0 } else { x % 2 == 0 };
		if is_even {
			evens[en] = x;
			en++;
		}
	}
	if en < 2 {
		gold_fail(g, "insufficient even items for pairwise grouping");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient even items");
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < en {
		let diff = evens[i + 1] - evens[i];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d > md {
			gold_fail(g, "pairwise difference between evens exceeds limit");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: even pair gap exceeded");
			return out;
		}
		pairs++;
		i += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "grouped even pairs: ", pairs);
	out
}
@end
