@entry c3fdf9d8f31a2d25
kind: step
verb: group
noun: history
modifier: in_place
context: aggregate
phrase: group history in place by sign
phrase: cluster historic records in place by polarity
test: list=-1,2,-3,4,-5
expect: => i=3 r=0.0 ok=true s="negative history: 3" errors=0 n=5 res=[-1,-3,-5,2,4] cache=0 hits=0
test: list=10,-20,30,-40
expect: => i=2 r=0.0 ok=true s="negative history: 2" errors=0 n=4 res=[-20,-40,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var negs int[512] = [0; 512];
	var pos int[512] = [0; 512];
	var nc = 0;
	var pc = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < 0 {
			negs[nc] = g.res[i];
			nc++;
		} else {
			pos[pc] = g.res[i];
			pc++;
		}
		i++;
	}
	i = 0;
	while i < nc {
		g.res[i] = negs[i];
		i++;
	}
	var j = 0;
	while j < pc {
		g.res[nc + j] = pos[j];
		j++;
	}
	g.steps += g.n;
	out.i = nc;
	out.s.clear();
	format(out.s, "negative history: ", nc);
	out
}
@end
