			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for i in g.n {
		if ${p}(g.res[i]) { count++; }
	}
	if count >= k && g.n > 1 {
		let first = g.res[0];
		for i in (g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " matches");
	out
}
@end
@entry 39650825dde799d1
kind: step
verb: collect
noun: gaps
modifier: in_place
context: sort
phrase: collect gaps in_place consecutive differences
phrase: replace sorted array with adjacent gaps in_place
phrase: compute successive differences along sorted list in_place
test: list=10,1,4,7
expect: => i=3 r=0.0 ok=true s="collected gaps max gap 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=2,15,5
expect: => i=10 r=0.0 ok=true s="collected gaps max gap 10" errors=0 n=2 res=[3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "no gaps to collect");
		return out;
	}
	var max_gap = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff > max_gap { max_gap = diff; }
		g.res[i] = diff;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "collected gaps max gap ", max_gap);
	out
}
@end
