expect: 2
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	var dupes = 0;
	var prev = -1;
	while val > 0 {
		var curr = val % 10;
		if curr == prev {
			dupes++;
		}
		prev = curr;
		val = val / 10;
	}
	return dupes;
}
@end
