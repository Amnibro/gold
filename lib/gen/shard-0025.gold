test: list=29,84,15 max_digit=10
expect: => i=3 r=0.0 ok=true s="clamped digital sums for 3 elements" errors=0 n=3 res=[10,10,6] cache=0 hits=0
test: list=48,93,37 max_digit=12
expect: => i=3 r=0.0 ok=true s="clamped digital sums for 3 elements" errors=0 n=3 res=[12,12,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_digit};
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		var sum = 0;
		while n > 0 {
			sum += n % 10;
			n = n / 10;
		}
		if sum > cap { sum = cap; }
		g.res[i] = sum;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped digital sums for ", g.n, " elements");
	out
}
@end
