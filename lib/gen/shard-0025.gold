fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${memo_bound};
	if b <= 0 {
		gold_fail(g, "memo bound must be strictly positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid memo bound");
		return out;
	}
	var stored = 0;
	for i in g.n {
		if g.res[i] <= b {
			gold_cache_put(g, i, g.res[i]);
			stored++;
		}
	}
	out.i = stored;
	out.s.clear();
	format(out.s, "memo bounded entries: ", stored);
	out
}
@end
