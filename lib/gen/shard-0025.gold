	if ${r} <= 0.0 || ${d} <= 0.0 { gold_fail(g, "invalid bounds"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "r_lake_ring", "", o);
	o.append(" cyl ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0 - ${d});
	o.append(" ");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(",");
	gold_fnum(o, 0.1);
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:glass ");
	gold_hex(o, 35, 90, 140);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ridge_lake_ringed");
	out
}
@end
