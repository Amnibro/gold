@entry 4dde735a1f5bcc3f
kind: fn
verb: sort
noun: step
modifier: pairwise
context: text
phrase: sort adjacent digit pairs within step
phrase: order pairwise digits across integer step
test: arg=142,381
expect: 124
expect: 318
test: arg=95
expect: 59
code:
// text sort step pairwise
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	let d0 = x % 10;
	let d1 = (x / 10) % 10;
	let rest = x / 100;
	let lo = if d0 < d1 { d0 } else { d1 };
	let hi = if d0 > d1 { d0 } else { d1 };
	rest * 100 + lo * 10 + hi
}
@end
