fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_w};
	let hi = ${max_w};
	var words = 0;
	var in_word = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' || c == '	' || c == '\n' {
			in_word = false;
		} else if !in_word {
			in_word = true;
			words++;
		}
	}
	g.steps += out.s.len;
	if words < lo || words > hi {
		gold_fail(g, "word count outside valid bounds");
		out.ok = false;
		out.i = words;
		out.s.clear();
		format(out.s, "error: words ", words, " outside bounds [", lo, ",", hi, "]");
		return out;
	}
	out.i = words;
	out.s.clear();
	format(out.s, "measured word count: ", words);
	out
}
@end
