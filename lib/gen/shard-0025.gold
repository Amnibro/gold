fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let split_k = ${k};
	var start = g.n - split_k;
	if start < 0 { start = 0; }
	var sum = 0;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += g.n - start;
	out.i = sum;
	out.s.clear();
	format(out.s, "suffix recursive sum: ", sum);
	out
}
@end
@entry ad0910afd6c5e67c
kind: step
verb: sum
noun: maximum
modifier: unique
context: aggregate
phrase: sum maximum unique distinct peak values
phrase: aggregate sum of distinct maximum items
test: list=5,10,10,8,7
expect: => i=30 r=0.0 ok=true s="unique sum: 30" errors=0 n=5 res=[5,10,10,8,7] cache=0 hits=0
test: list=3,3,9,9,12,12
expect: => i=24 r=0.0 ok=true s="unique sum: 24" errors=0 n=6 res=[3,3,9,9,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				seen_before = true;
				break;
			}
			j++;
		}
		if !seen_before {
			sum += g.res[i];
		}
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "unique sum: ", sum);
	out
}
@end
@entry d6ee75092c6ea50b
kind: step
verb: cache
noun: gaps
modifier: up_to
context: aggregate
slot: span int
phrase: cache gaps up to maximum span {span}
phrase: memoize consecutive intervals up to span {span}
test: list=2,5,9,12 span=4
expect: => i=3 r=0.0 ok=true s="cached gaps: 3" errors=0 n=4 res=[2,5,9,12] cache=3 hits=0
test: list=1,10,15 span=6
expect: => i=1 r=0.0 ok=true s="cached gaps: 1" errors=0 n=3 res=[1,10,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_span = ${span};
	var cached_gaps = 0;
	var i = 0;
	while i + 1 < g.n {
		var gap = g.res[i + 1] - g.res[i];
		if gap < 0 { gap = -gap; }
		if gap <= max_span {
			gold_cache_put(g, i, gap);
			cached_gaps++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = cached_gaps;
	out.s.clear();
	format(out.s, "cached gaps: ", cached_gaps);
	out
}
@end
