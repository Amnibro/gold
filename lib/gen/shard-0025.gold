@entry 38c06a0fe800150c
kind: step
verb: shift
noun: histogram
modifier: first
context: transform
phrase: shift histogram first ordering values by initial occurrence frequency
phrase: group results placing highest initial frequency values first
test: list=2,3,2,5,2,3
expect: => i=3 r=0.0 ok=true s="max frequency: 3" errors=0 n=6 res=[2,2,2,3,3,5] cache=0 hits=0
test: list=7,8,7,9,7,8,8
expect: => i=3 r=0.0 ok=true s="max frequency: 3" errors=0 n=7 res=[7,8,7,7,8,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var freq int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		var cnt = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == g.res[i] { cnt++; }
			j++;
		}
		freq[i] = cnt;
		i++;
	}
	var a = 0;
	while a < g.n {
		var b = 0;
		while b + 1 < g.n - a {
			if freq[b] < freq[b + 1] {
				let tf = freq[b]; freq[b] = freq[b + 1]; freq[b + 1] = tf;
				let tv = g.res[b]; g.res[b] = g.res[b + 1]; g.res[b + 1] = tv;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n;
	out.i = freq[0];
	out.s.clear();
	format(out.s, "max frequency: ", freq[0]);
	out
}
@end
