noun: digits
modifier: between
context: list
phrase: keep digits between count {lo} unto {hi}
phrase: filter items having digit count between {lo} unto {hi}
slot: lo int
slot: hi int
test: list=5,25,125,5000 lo=2 hi=3
expect: => i=2 r=0.0 ok=true s="kept digits: 2" errors=0 n=2 res=[25,125] cache=0 hits=0
