kind: step
verb: return
noun: subfunction
modifier: with_cache
context: filter
slot: f fn
phrase: return subfunction with cache applying transform {f}
phrase: evaluate subfunction with cache invoking transform {f}
test: list=10,20,10,30 f=double
expect: => i=60 r=0.0 ok=true s="subfunction cached final: 60" errors=0 n=4 res=[20,40,20,60] cache=3 hits=1
test: list=5,7,5,9 f=triple
expect: => i=27 r=0.0 ok=true s="subfunction cached final: 27" errors=0 n=4 res=[15,21,15,27] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_val = 0;
	for i in g.n {
		let k = g.res[i];
		let cached, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = cached;
			last_val = cached;
		} else {
			let res = ${f}(k);
			gold_cache_put(g, k, res);
			g.res[i] = res;
			last_val = res;
		}
	}
	out.i = last_val;
	out.s.clear();
	format(out.s, "subfunction cached final: ", last_val);
	out
}
@end
