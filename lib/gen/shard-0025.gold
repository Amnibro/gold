fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var found = false;
	var min_val = 0;
	for i in g.n {
		if g.res[i] <= c {
			if !found || g.res[i] < min_val {
				min_val = g.res[i];
				found = true;
			}
		}
	}
	if found {
		out.i = min_val;
		gold_push(g, min_val);
	}
	out.s.clear();
	format(out.s, "traced minimum below cutoff: ", out.i);
	out
}
