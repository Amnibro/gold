fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cycles};
	if g.n < 2 { return out; }
	var m = g.n - 1;
	var gaps int[256] = [0; 256];
	for i in m {
		let d = g.res[i + 1] - g.res[i];
		gaps[i] = if d < 0 { -d } else { d };
	}
	let shift = (k % m + m) % m;
	for i in m {
		g.res[i] = gaps[(i + shift) % m];
	}
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "rotated gaps times cycles: ", m);
	out
}
@end
