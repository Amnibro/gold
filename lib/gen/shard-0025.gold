@entry 44014881e8d842b1
kind: step
verb: scale
noun: gaps
modifier: at_most
context: core
phrase: scale gaps at most reaching {cap}
phrase: expand gap intervals at most {cap}
slot: cap int
test: list=1,3,7 cap=5
expect: => i=2 r=0.0 ok=true s="scaled 2 gaps" errors=0 n=5 res=[1,3,7,2,4] cache=0 hits=0
test: list=10,20 cap=6
expect: => i=1 r=0.0 ok=true s="scaled 1 gaps" errors=0 n=3 res=[10,20,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps_scaled = 0;
	for k in 1..g.n {
		let gap = g.res[k] - g.res[k - 1];
		let scaled = if gap > c { c } else { gap };
		gold_push(g, scaled);
		gaps_scaled++;
	}
	g.steps += g.n;
	out.i = gaps_scaled;
	out.s.clear();
	format(out.s, "scaled ", gaps_scaled, " gaps");
	out
}
@end
