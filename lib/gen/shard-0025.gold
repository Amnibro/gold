phrase: yield minimum while above {threshold}
slot: threshold int
test: list=50,30,40,10,60 threshold=25
expect: => i=30 r=0.0 ok=true s="prefix minimum: 30" errors=0 n=5 res=[50,30,40,10,60] cache=0 hits=0
test: list=20,15,18,5,25 threshold=12
expect: => i=15 r=0.0 ok=true s="prefix minimum: 15" errors=0 n=5 res=[20,15,18,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n == 0 { return out; }
	var min_val = 999999;
	var found = false;
	var count = 0;
	for i in g.n {
		if g.res[i] > th {
			if g.res[i] < min_val { min_val = g.res[i]; }
			found = true;
			count++;
		} else {
			break;
		}
	}
	out.i = if found { min_val } else { 0 };
	out.s.clear();
	format(out.s, "prefix minimum: ", out.i);
	g.steps += count;
	out
}
@end
@entry 1b012b2860064fdc
kind: step
verb: fold
noun: streak
modifier: times
context: compare
phrase: fold streak times multiplier {scale}
phrase: aggregate streaks multiplied {scale}
slot: scale int
test: list=1,3,5,2,4,6,8 scale=3
expect: => i=12 r=0.0 ok=true s="max streak scaled: 12" errors=0 n=7 res=[1,3,5,2,4,6,8] cache=0 hits=0
test: list=10,20,5,15,25 scale=2
expect: => i=6 r=0.0 ok=true s="max streak scaled: 6" errors=0 n=5 res=[10,20,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n < 2 { return out; }
	var max_streak = 1;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	let folded = max_streak * sc;
	out.i = folded;
	out.s.clear();
	format(out.s, "max streak scaled: ", folded);
