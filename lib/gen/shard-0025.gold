noun: values
modifier: in_reverse
context: error
slot: retries int
phrase: retry values in_reverse attempts {retries}
phrase: examine values backwards with retry allowance {retries}
test: list=10,-2,30 retries=2
expect: => i=1 r=0.0 ok=true s="corrected negatives in reverse: 1" errors=0 n=3 res=[10,2,30] cache=0 hits=0
test: list=-5,-10,-15 retries=1
expect: => i=3 r=0.0 ok=false s="error: negative count 3 exceeds 1" errors=1 n=3 res=[-5,-10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${retries};
	var neg_count = 0;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] < 0 {
			neg_count++;
			if neg_count <= lim {
				g.res[k] = -g.res[k];
			}
		}
		k--;
	}
	g.steps += g.n;
	if neg_count > lim {
		gold_fail(g, "negative value persists in reverse");
		out.ok = false;
		out.i = neg_count;
		out.s.clear();
		format(out.s, "error: negative count ", neg_count, " exceeds ", lim);
		return out;
	}
	out.i = neg_count;
	out.s.clear();
	format(out.s, "corrected negatives in reverse: ", neg_count);
	out
}
@end
@entry 76213b7727d0453f
kind: step
verb: reverse
noun: tally
modifier: recursively
context: error
slot: max_distinct int
phrase: reverse tally recursively max categories {max_distinct}
phrase: compute recursive tally reverse under {max_distinct}
test: list=1,2,2,3 max_distinct=5
expect: => i=3 r=0.0 ok=true s="reversed tally distinct: 3" errors=0 n=4 res=[3,2,2,1] cache=0 hits=0
test: list=1,2,3,4,5,6 max_distinct=3
expect: => i=6 r=0.0 ok=false s="error: distinct categories 6 exceed 3" errors=1 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_distinct};
	var distinct = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[i] == g.res[j] { seen = true; break; }
		}
		if !seen { distinct++; }
	}
	g.steps += g.n;
	if distinct > cap {
		gold_fail(g, "tally distinct categories exceed limit");
		out.ok = false;
		out.i = distinct;
		out.s.clear();
		format(out.s, "error: distinct categories ", distinct, " exceed ", cap);
		return out;
	}
	let mid = g.n / 2;
	for k in mid {
		let opp = g.n - 1 - k;
		let tmp = g.res[k];
		g.res[k] = g.res[opp];
		g.res[opp] = tmp;
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "reversed tally distinct: ", distinct);
	out
}
@end
@entry e737517cc4c41709
kind: step
verb: keep
noun: budget
modifier: unique
context: error
slot: budget int
phrase: keep budget unique maximum sum {budget}
phrase: retain unique items within financial budget {budget}
test: list=10,20,10,30,40 budget=50
expect: => i=2 r=0.0 ok=true s="kept unique items: 2 cost: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=100,200 budget=50
expect: => i=0 r=0.0 ok=false s="error: zero items fit budget 50" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		var dup = false;
		for j in kept {
			if g.res[i] == g.res[j] { dup = true; break; }
		}
		if !dup {
			if sum + g.res[i] <= b {
				g.res[kept] = g.res[i];
				sum += g.res[i];
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	if kept == 0 {
		gold_fail(g, "budget insufficient for unique items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero items fit budget ", b);
		return out;
	}
	out.i = kept;
	out.s.clear();
	format(out.s, "kept unique items: ", kept, " cost: ", sum);
	out
}
@end
