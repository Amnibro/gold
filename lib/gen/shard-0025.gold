code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sub = ${substitute};
	let cap = ${max_retries};
	var replaced = 0;
	for k in g.n {
		if g.res[k] < 0 {
			replaced++;
			if replaced <= cap {
				g.res[k] = sub;
			}
		}
	}
	g.steps += g.n;
	if replaced > cap {
		gold_fail(g, "unrecoverable failed items exceed limit");
		out.ok = false;
		out.i = replaced;
		out.s.clear();
		format(out.s, "error: failures ", replaced, " exceed limit ", cap);
		return out;
	}
	out.i = replaced;
	out.s.clear();
	format(out.s, "retried items: ", replaced);
	out
}
@end
