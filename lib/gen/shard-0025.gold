@entry 8490b4ffad19914e
kind: step
verb: merge
noun: gaps
modifier: last
context: core
phrase: merge gaps in last {span} results
phrase: fill gaps across trailing {span} entries
slot: span int
test: list=1,5,10 span=2
expect: => i=2 r=0.0 ok=true s="merged 2 gaps" errors=0 n=5 res=[1,5,10,3,7] cache=0 hits=0
test: list=3,12 span=1
expect: => i=1 r=0.0 ok=true s="merged 1 gaps" errors=0 n=3 res=[3,12,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if g.n < 2 || s <= 0 {
		gold_fail(g, "insufficient items for gap merge");
		out.ok = false;
		return out;
	}
	var count = 0;
	let start = if g.n > s { g.n - s } else { 1 };
	for k in start..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > 1 {
			gold_push(g, g.res[k - 1] + (diff / 2));
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "merged ", count, " gaps");
	out
}
@end
