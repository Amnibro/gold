fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	var sum = 0;
	let start = g.n / 2;
	for i in start..g.n {
		if g.res[i] > bnd { sum += g.res[i]; }
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed suffix sum: ", sum);
	out
}
@end
@entry 81c528221835a911
kind: step
verb: retry
noun: prefix
modifier: recursively
context: sort
phrase: retry prefix partitioning recursively depth {depth}
phrase: refine prefix sort recursively with depth {depth}
slot: depth int
test: list=8,3,1,7,4 depth=2
expect: => i=2 r=0.0 ok=true s="recursive prefix depth: 2" errors=0 n=7 res=[1,3,4,7,8,4,3] cache=0 hits=0
test: list=14,6,2,10 depth=3
expect: => i=2 r=0.0 ok=true s="recursive prefix depth: 2" errors=0 n=6 res=[2,6,10,14,10,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dp = ${depth};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var passes = 0;
	var bound = g.n;
	while bound > 1 && passes < dp {
		bound = bound / 2;
		passes++;
		gold_push(g, g.res[bound]);
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "recursive prefix depth: ", passes);
	out
}
@end
@entry 31feb7f086bcc196
kind: step
verb: merge
noun: results
modifier: recursively
context: sort
phrase: merge sorted results recursively with stride {stride}
phrase: combine split results recursively using stride {stride}
slot: stride int
test: list=9,2,6,1,8,4 stride=2
expect: => i=2 r=0.0 ok=true s="merged block stride: 2" errors=0 n=9 res=[1,2,4,6,8,9,3,10,17] cache=0 hits=0
test: list=15,3,7,11,1 stride=3
expect: => i=3 r=0.0 ok=true s="merged block stride: 3" errors=0 n=7 res=[1,3,7,11,15,11,26] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var st = ${stride};
	if st < 1 { st = 1; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var orig_n = g.n;
	var idx = 0;
	while idx < orig_n {
		var end_idx = idx + st;
		if end_idx > orig_n { end_idx = orig_n; }
		var block_sum = 0;
		for k in idx..end_idx { block_sum += g.res[k]; }
		gold_push(g, block_sum);
		idx += st;
	}
	g.steps += g.n;
	out.i = st;
	out.s.clear();
	format(out.s, "merged block stride: ", st);
	out
}
@end
