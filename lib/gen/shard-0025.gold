@entry 9a3d9377d49837d6
kind: step
verb: run
noun: list
modifier: between
context: aggregate
slot: lo int
slot: hi int
phrase: run list between range bounds {lo} {hi}
phrase: filter list keeping elements between {lo} {hi}
test: list=5,12,18,25,30 lo=10 hi=20
expect: => i=2 r=0.0 ok=true s="kept between bounds: 2" errors=0 n=2 res=[12,18] cache=0 hits=0
test: list=1,8,15,22,29 lo=5 hi=25
expect: => i=3 r=0.0 ok=true s="kept between bounds: 3" errors=0 n=3 res=[8,15,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${lo};
	let upper = ${hi};
	var kept int[512] = [0; 512];
	var kc = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= lower && g.res[i] <= upper {
			kept[kc] = g.res[i];
			kc++;
		}
		i++;
	}
	gold_clear(g);
	i = 0;
	while i < kc {
		gold_push(g, kept[i]);
		i++;
	}
	g.steps += g.n;
	out.i = kc;
	out.s.clear();
	format(out.s, "kept between bounds: ", kc);
	out
}
@end
