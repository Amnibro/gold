fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dim_bevel_rib_none = ${r};
	if dim_bevel_rib_none <= 0.0 {
		gold_fail(g, "invalid bevel rib none dimension");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	gold_dnews(g, "rib", "", o);
	o.append(" box 0,0,");
	o.append("0 0.");
	o.append("1,0.");
	o.append("05,");
	gold_fnum(o, dim_bevel_rib_none);
	o.append(" m:metal");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "rib");
	out
}
@end
