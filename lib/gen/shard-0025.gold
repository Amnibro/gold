@entry 858708cbad01d180
kind: step
verb: fill
noun: tail
modifier: sorted
context: error
phrase: fill tail sorted error elements count {count}
phrase: order tail sorted error segment length {count}
slot: count int
test: list=10,50,40,20,30 count=3
expect: => i=3 r=0.0 ok=true s="sorted tail elements: 3" errors=0 n=5 res=[10,50,20,30,40] cache=0 hits=0
test: list=5,1,9 count=2
expect: => i=2 r=0.0 ok=true s="sorted tail elements: 2" errors=0 n=3 res=[5,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c > g.n {
		gold_fail(g, "tail length exceeds list size");
		out.ok = false;
		return out;
	}
	let start = g.n - c;
	var passes = 0;
	var sorted = false;
	while passes < c && !sorted {
		sorted = true;
		var i = start;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
			i++;
		}
		passes++;
	}
	out.i = c;
	out.s.clear();
	format(out.s, "sorted tail elements: ", c);
	out
}
@end
