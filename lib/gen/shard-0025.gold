noun: total
modifier: recursively
context: math
slot: target int
phrase: search total recursively matching target sum {target}
phrase: seek total recursively partition reaching {target}
test: list=1,2,3,4 target=6
expect: => i=1 r=0.0 ok=true s="found 1 recursive subarray totals" errors=0 n=5 res=[1,2,3,4,3] cache=0 hits=0
test: list=5,10,15 target=15
expect: => i=2 r=0.0 ok=true s="found 2 recursive subarray totals" errors=0 n=5 res=[5,10,15,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = 0;
	let orig = g.n;
	var i = 0;
	while i < orig {
		var sum = 0;
		var j = i;
		while j < orig {
			sum += g.res[j];
			if sum == tgt {
				found++;
				gold_push(g, j - i + 1);
			}
			j++;
		}
		i++;
	}
	out.i = found;
	out.s.clear();
	format(out.s, "found ", found, " recursive subarray totals");
	out
}
@end
@entry 635864e4b28f042e
kind: step
verb: search
noun: numbers
modifier: recursively
context: math
slot: needle int
phrase: search numbers recursively matching needle value {needle}
phrase: locate numbers recursively matching target element {needle}
test: list=2,4,6,8,10 needle=6
expect: => i=2 r=0.0 ok=true s="search index: 2" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,3,5,7,9 needle=7
expect: => i=3 r=0.0 ok=true s="search index: 3" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${needle};
	var idx = -1;
	var low = 0;
	var high = g.n - 1;
	while low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == target {
			idx = mid;
			break;
		} else if g.res[mid] < target {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	out.i = idx;
	out.s.clear();
	format(out.s, "search index: ", idx);
	out
}
@end
