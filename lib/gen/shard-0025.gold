@entry b485b2bdabd6ba4d
kind: step
verb: retry
noun: window
modifier: with_retry
context: core
phrase: retry sliding window calculation limit {limit}
phrase: recompute window average with retry limit {limit}
slot: limit int
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="processed 2 windows" errors=0 n=6 res=[10,20,30,40,15,25] cache=0 hits=0
test: list=5,15 limit=1
expect: => i=1 r=0.0 ok=true s="processed 1 windows" errors=0 n=3 res=[5,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var pairs = 0;
	var tries = 0;
	while tries < lim && pairs + 1 < g.n {
		let avg = (g.res[pairs] + g.res[pairs + 1]) / 2;
		gold_push(g, avg);
		pairs++;
		tries++;
	}
	g.steps += tries;
	out.i = pairs;
	out.s.clear();
	format(out.s, "processed ", pairs, " windows");
	out
}
@end
