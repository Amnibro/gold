fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${allowance};
	for idx in g.n {
		let cost = g.res[idx];
		if cost > rem {
			gold_fail(g, "budget allowance exhausted");
			out.ok = false;
			rem = 0 - (cost - rem);
			break;
		}
		rem -= cost;
	}
	out.i = rem;
	out.s.clear();
	format(out.s, "remaining budget: ", rem);
	out
}
@end
