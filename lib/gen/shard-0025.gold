code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if sum + g.res[i] <= b {
			sum += g.res[i];
			g.res[count] = g.res[i];
			count++;
		}
	}
	g.n = count;
	out.i = sum;
	out.s.clear();
	format(out.s, "budget spent: ", sum);
	g.steps += g.n;
	out
}
@end
