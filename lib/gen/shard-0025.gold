expect: => i=3 r=0.0 ok=true s="lava" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: lava3 box 0,0,-0.4 10,10,0.2 m:glow #dc3c14
test: a=5.0 h=-0.1 doc="ground box 0,0,-.5 20,20,1"
expect: => i=2 r=0.0 ok=true s="lava" errors=0 n=0 res=[] cache=0 hits=0
