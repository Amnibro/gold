	let keep_count = ${k};
	var start = g.n - keep_count;
	if start < 0 { start = 0; }
	var temp int[512] = [0; 512];
	var tc = 0;
	var i = g.n - 1;
	while i >= start {
		temp[tc] = g.res[i];
		tc++;
		i--;
	}
	gold_clear(g);
	i = 0;
	while i < tc {
		gold_push(g, temp[i]);
		i++;
	}
	g.steps += g.n;
	out.i = tc;
	out.s.clear();
	format(out.s, "limited in reverse: ", tc);
	out
}
