fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var cnt = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			if g.res[i] * f > g.res[i + 1] {
				cnt++;
			}
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "pairwise matches: ", cnt);
