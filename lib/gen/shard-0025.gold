@entry 53c18b73fb91df30
kind: step
verb: dedupe
noun: head
modifier: any
context: filter
slot: limit int
phrase: dedupe head any items up to prefix {limit}
phrase: prune duplicate head elements within initial {limit}
test: list=5,5,10,10,20,20 limit=4
expect: => i=2 r=0.0 ok=true s="deduped head items: 2" errors=0 n=4 res=[5,10,20,20] cache=0 hits=0
test: list=7,7,7,14,14,21 limit=3
expect: => i=1 r=0.0 ok=true s="deduped head items: 1" errors=0 n=4 res=[7,14,14,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	var m = 0;
	for i in bound {
		let x = g.res[i];
		var seen = false;
		for j in m {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
	}
	let head_deduped = m;
	var i = bound;
	while i < g.n {
		g.res[m] = g.res[i];
		m++;
		i++;
	}
	g.n = m;
	out.i = head_deduped;
	out.s.clear();
	format(out.s, "deduped head items: ", head_deduped);
	out
}
@end
