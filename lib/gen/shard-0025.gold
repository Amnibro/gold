fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val == 0 {
		return 1;
	}
	var unique_digits = 0;
	var d = 0;
	while d <= 9 {
		var temp = val;
		var found = false;
		while temp > 0 {
			if (temp % 10) == d {
				found = true;
			}
			temp = temp / 10;
		}
		if found {
			unique_digits++;
		}
		d++;
	}
	return unique_digits;
}
@end
