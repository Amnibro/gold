@entry 175c4f61b39fe019
kind: step
verb: merge
noun: cache
modifier: with_retry
context: core
phrase: merge cache entries with retry limit {attempts}
phrase: sync cache results using retry budget {attempts}
slot: attempts int
test: input=10 attempts=3
expect: => i=1 r=0.0 ok=true s="cache merged in 1 attempts" errors=0 n=1 res=[10] cache=1 hits=1
test: input=5 attempts=1
expect: => i=1 r=0.0 ok=true s="cache merged in 1 attempts" errors=0 n=1 res=[5] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var success = false;
	var tries = 0;
	while tries < att {
		tries++;
		gold_cache_put(g, tries, out.i * tries);
		let val, ok = gold_cache_get(g, tries);
		if ok && val > 0 {
			gold_push(g, val);
			success = true;
			break;
		}
	}
	g.steps += tries;
	out.ok = success;
	out.i = tries;
	out.s.clear();
	format(out.s, "cache merged in ", tries, " attempts");
	out
}
@end
