@entry bb3c27aad72a2cb0
kind: step
verb: limit
noun: duplicates
modifier: in_reverse
context: transform
phrase: limit duplicates in reverse order {max_reps}
phrase: bound duplicate items in reverse {max_reps}
slot: max_reps int
test: list=1,2,2,2,3 max_reps=1
expect: => i=2 r=0.0 ok=true s="limited duplicates in reverse: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,4,5,5,5 max_reps=2
expect: => i=2 r=0.0 ok=true s="limited duplicates in reverse: 2" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_val = ${max_reps};
	var keep = 0;
	var buf int[512] = [0; 512];
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = 0;
		for k in keep {
			if buf[k] == x { seen++; }
		}
		if seen < limit_val {
			buf[keep] = x;
			keep++;
		}
		i--;
	}
	for k in keep {
		g.res[k] = buf[keep - 1 - k];
	}
	g.steps += g.n;
	out.i = g.n - keep;
	g.n = keep;
	out.s.clear();
	format(out.s, "limited duplicates in reverse: ", out.i);
	out
}
@end
