kind: step
verb: search
noun: primes
modifier: nested
context: filter
phrase: search primes nested extracting all prime numbers
phrase: filter primes nested retaining prime integers
test: list=4,5,6,7,8,9,11,12
expect: => i=3 r=0.0 ok=true s="searched primes nested total: 3" errors=0 n=3 res=[5,7,11] cache=0 hits=0
test: list=13,14,15,17,19,20
expect: => i=3 r=0.0 ok=true s="searched primes nested total: 3" errors=0 n=3 res=[13,17,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_prime = false; break; }
				d++;
			}
			if is_prime {
				g.res[m] = x;
				m++;
			}
		}
	}
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "searched primes nested total: ", m);
	out
}
@end
