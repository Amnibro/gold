phrase: advance until consecutive prime gap meets {gap}
test: arg=10,20 gap=4
expect: 17
expect: 29
test: arg=30 gap=6
expect: 37
code:
fn ${ID}(n int) int {
	let g = ${gap};
	var p = if n < 2 { 2 } else { n };
	var prev = 0;
	var candidate = p;
	var found = 0;
	while found == 0 && candidate < 2000 {
		var is_p = true;
		if candidate < 2 { is_p = false; }
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if prev > 0 && (candidate - prev) >= g {
				found = candidate;
				break;
			}
			prev = candidate;
		}
		candidate++;
	}
	found
}
@end
