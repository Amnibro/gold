	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var d int[16] = [0; 16];
	for i in rlen {
		d[i] = rev[rlen - 1 - i];
	}
	let first = d[0];
	var start = 1;
	while start < rlen && d[start] == first {
		start++;
	}
	var res = first;
	var k = start;
	while k < rlen {
		res = res * 10 + d[k];
		k++;
	}
	res
}
@end
@entry 6dc50508d36f3932
kind: fn
verb: rotate
noun: duplicates
modifier: up_to
context: filter
phrase: rotate duplicate digits up to bound {bound}
phrase: cycle duplicate values up to limit {bound}
slot: bound int
test: arg=11223,4445 bound=3
expect: 11225
expect: 4447
test: arg=123 bound=2
expect: 123
code:
fn ${ID}(n int) int {
	let lim = ${bound};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var dups = 0;
	if rlen > 1 {
		var i = 0;
		while i + 1 < rlen {
			if rev[i] == rev[i + 1] { dups++; }
			i++;
		}
	}
	let shift = if lim > 0 { dups % lim } else { 0 };
	(if n < 0 { -n } else { n }) + shift
}
@end
@entry ffadfcd4866142dc
kind: fn
verb: repeat
noun: runs
modifier: until
context: filter
phrase: repeat digit runs until ceiling {limit}
phrase: extend digit run sequence until bound {limit}
slot: limit int
test: arg=11222,1234 limit=50
expect: 6
expect: 1
test: arg=7777 limit=20
expect: 4
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var prod = 1;
	var i = 0;
	while i < rlen {
		var run_len = 1;
		while i + 1 < rlen && rev[i] == rev[i + 1] {
			run_len++;
			i++;
		}
		prod *= run_len;
		if prod >= lim { break; }
		i++;
	}
	prod
}
@end
@entry 561594a351e8d312
kind: fn
verb: join
noun: prefix
modifier: between
context: filter
phrase: join prefix digits between bounds {lo}
phrase: combine prefix elements between threshold {lo}
slot: lo int
test: arg=9821,8734 lo=5
expect: 98
expect: 87
test: arg=321 lo=4
expect: 0
code:
fn ${ID}(n int) int {
	let threshold = ${lo};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var res = 0;
	var i = rlen - 1;
	while i >= 0 {
		let d = rev[i];
		if d > threshold {
			res = res * 10 + d;
		} else {
			break;
		}
		i--;
	}
	res
}
@end
@entry 98c3b3e8c47d6107
