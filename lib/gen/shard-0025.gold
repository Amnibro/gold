	let m = ${multiplier};
	let half = g.n / 2;
	var i = half;
	while i < g.n {
		g.res[i] += (i - half + 1) * m;
		i++;
	}
	g.steps += g.n - half;
	out.i = g.n - half;
	out.s.clear();
	format(out.s, "applied tail running count: ", out.i);
	out
}
