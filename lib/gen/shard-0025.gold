fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_square(g, ${c}) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, ${c}, g.iw / ${c}, ${u});
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { if g.img[k] >= 0.45 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
