@entry 58516d9c6c8eded6
kind: step
verb: normalize
noun: spaces
modifier: nested
context: transform
phrase: normalize spaces nested in text buffer
phrase: collapse nested whitespace sequences in text
test: text="hello    world   braid"
expect: => i=17 r=0.0 ok=true s="hello world braid" errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha   beta"
expect: => i=10 r=0.0 ok=true s="alpha beta" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[>..] = [];
	var in_sp = false;
	for b in v.s {
		if b == ' ' {
			if !in_sp {
				res.push(b);
				in_sp = true;
			}
		} else {
			res.push(b);
			in_sp = false;
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	g.steps += v.s.len;
	out
}
@end
@entry 90914602968a1b60
kind: step
verb: collect
noun: odds
modifier: sorted
context: transform
phrase: collect odds sorted exceeding floor {min_odd}
phrase: extract sorted odd transform items above {min_odd}
slot: min_odd int
test: list=11,4,7,9,2,5 min_odd=6
expect: => i=3 r=0.0 ok=true s="collected odds sorted: 3" errors=0 n=3 res=[7,9,11] cache=0 hits=0
test: list=3,15,8,1,9 min_odd=5
expect: => i=2 r=0.0 ok=true s="collected odds sorted: 2" errors=0 n=2 res=[9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mo = ${min_odd};
	var keep = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x >= mo {
			g.res[keep] = x;
			keep++;
		}
	}
	g.n = keep;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected odds sorted: ", g.n);
	out
}
@end
