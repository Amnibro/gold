@entry 42a3c2ba4e1c599b
kind: step
verb: reverse
noun: sequence
modifier: unique
context: error
slot: min_unique int
phrase: reverse sequence unique threshold {min_unique}
phrase: deduplicate reverse sequence requiring {min_unique}
test: list=1,2,3,4,4 min_unique=3
expect: => i=4 r=0.0 ok=true s="reversed unique sequence: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=1,1,1 min_unique=2
expect: => i=1 r=0.0 ok=false s="error: unique count 1 below required 2" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_unique};
	var u = 0;
	for i in g.n {
		var seen = false;
		for j in u {
			if g.res[i] == g.res[j] { seen = true; break; }
		}
		if !seen {
			g.res[u] = g.res[i];
			u++;
		}
	}
	g.n = u;
	g.steps += g.n;
	if u < req {
		gold_fail(g, "insufficient unique sequence elements");
		out.ok = false;
		out.i = u;
		out.s.clear();
		format(out.s, "error: unique count ", u, " below required ", req);
		return out;
	}
	let mid = u / 2;
	for k in mid {
		let opp = u - 1 - k;
		let tmp = g.res[k];
		g.res[k] = g.res[opp];
		g.res[opp] = tmp;
	}
	out.i = u;
	out.s.clear();
	format(out.s, "reversed unique sequence: ", u);
	out
}
@end
