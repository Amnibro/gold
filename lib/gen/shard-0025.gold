@entry 763cc345fab85121
kind: step
verb: check
noun: streak
modifier: in_reverse
context: core
phrase: check streak in reverse matching {target}
phrase: inspect trailing streak in reverse for {target}
slot: target int
test: list=1,3,5,5,5 target=5
expect: => i=3 r=0.0 ok=true s="reverse streak length 3" errors=0 n=5 res=[1,3,5,5,5] cache=0 hits=0
test: list=5,5,2 target=5
expect: => i=0 r=0.0 ok=false s="reverse streak length 0" errors=0 n=3 res=[5,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var streak = 0;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] == t {
			streak++;
		} else {
			break;
		}
		k--;
	}
	g.steps += g.n;
	out.i = streak;
	out.ok = streak > 0;
	out.s.clear();
	format(out.s, "reverse streak length ", streak);
	out
}
@end
