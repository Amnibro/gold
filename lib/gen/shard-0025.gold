fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	if r <= 1 || g.n == 0 { return out; }
	let orig_n = g.n;
	var temp int[512] = [0; 512];
	for i in orig_n { temp[i] = g.res[i]; }
	var m = 0;
	for i in orig_n {
		for k in r {
			if m < 512 {
				temp[m] = g.res[i];
				m++;
			}
		}
	}
	for i in m { g.res[i] = temp[i]; }
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "repeated values total: ", m);
	out
}
@end
