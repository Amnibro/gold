code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = 0;
	for i in g.n {
		if core_is_odd(g.res[i]) {
			var prev = false;
			for j in i {
				if g.res[j] == g.res[i] { prev = true; break; }
			}
			if !prev {
				g.res[i] = ${f}(g.res[i]);
				changed++;
			}
		}
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "mapped odds: ", changed);
	out
}
@end
