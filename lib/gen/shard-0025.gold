fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	for k in 1..g.n {
		let d = g.res[k] - g.res[k - 1];
