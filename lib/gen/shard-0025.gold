code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var kept = 0;
	while kept < g.n {
		sum += g.res[kept];
		let mean = sum / (kept + 1);
		if mean > limit { break; }
		kept++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements within mean ceiling ", limit);
	out
}
