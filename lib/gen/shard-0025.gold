fn ${ID}(n int) int {
	let w = ${window};
	var x = if n < 0 { -n } else { n };
	var digits int[16] = [0; 16];
	var count = 0;
	while x > 0 && count < 15 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	if count < w || w <= 0 { return 0; }
	var max_sum = 0;
	var i = 0;
	while i + w <= count {
		var cur = 0;
		var k = 0;
		while k < w {
			cur += digits[i + k];
			k++;
		}
		if cur > max_sum { max_sum = cur; }
		i++;
	}
	max_sum
}
@end
