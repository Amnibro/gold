fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum_bounded = 0;
	for i in g.n {
		let x = g.res[i];
		let bounded = if x > limit { limit } else { x };
		gold_cache_put(g, i, bounded);
		g.res[i] = bounded;
		sum_bounded += bounded;
	}
	g.steps += g.n;
	out.i = sum_bounded;
	out.s.clear();
	format(out.s, "sequence up to sum: ", sum_bounded);
	out
}
