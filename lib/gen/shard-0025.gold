test: text="apple banana cherry" shift_val=1
expect: => i=3 r=0.0 ok=true s="bpple canana dherry" errors=0 n=0 res=[] cache=0 hits=0
test: text="dog elephant frog" shift_val=2
expect: => i=3 r=0.0 ok=true s="fog glephant hrog" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift_val};
	var in_word = false;
	var shifted = 0;
	for i in v.s.len {
		let b = v.s[i];
		if b >= 'a' && b <= 'z' {
			if !in_word {
				var nb = ((b as int - 97 + s) % 26) + 97;
				out.s[i] = nb as byte;
				shifted++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	g.steps += v.s.len;
	out.i = shifted;
	out
}
@end
