code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var loop_val = -1;
	var i = 0;
	while i < g.n && loop_val == -1 {
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				loop_val = g.res[i];
				break;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = loop_val;
	out.s.clear();
	format(out.s, "loop marker: ", loop_val);
	out
}
@end
