test: arg=237,273
expect: true
expect: false
test: arg=57
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var rlen = 0;
	while x > 0 {
		rev[rlen] = x % 10;
		rlen++;
		x /= 10;
	}
	var last_p = -1;
	var i = rlen - 1;
	while i >= 0 {
		let d = rev[i];
		if d == 2 || d == 3 || d == 5 || d == 7 {
			if last_p != -1 && d < last_p { return false; }
			last_p = d;
		}
		i--;
	}
	true
}
@end
@entry eee051e539d03082
kind: fn
verb: fold
noun: tally
modifier: unique
context: filter
phrase: fold tally of unique digits
phrase: count unique distinct digits tally
test: arg=1123,555
expect: 3
expect: 1
test: arg=1234
expect: 4
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val < 10 { return 1; }
	var bitmask = 0;
	var distinct_tally = 0;
	while val > 0 {
		let digit_rem = val % 10;
		var flag = 1;
		for i in digit_rem { flag *= 2; }
		if (bitmask / flag) % 2 == 0 {
			bitmask += flag;
			distinct_tally++;
		}
		val /= 10;
	}
	distinct_tally
}
@end
