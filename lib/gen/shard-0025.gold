phrase: return average pairwise scaled factor {scale}
phrase: compute average pairwise multiplier {scale}
slot: scale int
test: list=10,20,30,40 scale=2
expect: => i=150 r=0.0 ok=true s="pairwise average sum: 150" errors=0 n=7 res=[10,20,30,40,30,50,70] cache=0 hits=0
test: list=4,8,12 scale=1
expect: => i=16 r=0.0 ok=true s="pairwise average sum: 16" errors=0 n=5 res=[4,8,12,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var sum_avg = 0;
	var pairs = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let pair_avg = (g.res[i] + g.res[i + 1]) / 2;
			let scaled = pair_avg * sc;
			gold_push(g, scaled);
			sum_avg += scaled;
			pairs++;
		}
	}
	g.steps += pairs;
	out.i = sum_avg;
	out.s.clear();
	format(out.s, "pairwise average sum: ", sum_avg);
	out
}
@end
