phrase: record gaps in reverse delta {threshold}
slot: threshold int
test: list=5,10,25,30 threshold=10
expect: => i=1 r=0.0 ok=true s="large gaps found: 1" errors=0 n=4 res=[5,10,25,30] cache=1 hits=0
