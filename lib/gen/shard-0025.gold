code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var valid = true;
	var checked = 0;
	var i = 0;
	while i < g.n && i < c {
		if !${p}(g.res[i]) {
			valid = false;
			break;
		}
		checked++;
		i++;
	}
	g.steps += i;
	out.ok = valid;
	out.i = checked;
	out.s.clear();
	if valid {
		format(out.s, "head prefix valid: ", checked);
	} else {
		format(out.s, "head prefix invalid");
	}
	out
}
@end
