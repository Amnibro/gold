fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	for i in g.n {
		if i % 2 == 0 && g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "elements clamped: ", clamped);
	out
}
