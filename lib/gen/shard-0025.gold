	let w = ${window_size};
	if w <= 0 || g.n == 0 { return out; }
	var i = 0;
	while i < g.n {
		var s = 0;
		var k = 0;
		while k < w && i + k < g.n {
			s += g.res[i + k];
			k++;
		}
		g.res[i] = s;
		i += w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "summed items recursively: ", g.n);
	out
}
