@entry ac550fdb48a4c222
kind: step
verb: pair
noun: step
modifier: with_cache
context: error
slot: require_even int
phrase: pair step with_cache strict parity {require_even}
phrase: compute cached pair steps enforcing parity {require_even}
test: list=2,4,6,8 require_even=1
expect: => i=2 r=0.0 ok=true s="paired steps cached: 2" errors=0 n=4 res=[2,4,6,8] cache=2 hits=0
test: list=2,4,6 require_even=1
expect: => i=3 r=0.0 ok=false s="error: odd element count 3" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${require_even};
	if req > 0 && (g.n % 2) != 0 {
		gold_fail(g, "paired step requires even item count");
		out.ok = false;
		out.i = g.n;
		out.s.clear();
		format(out.s, "error: odd element count ", g.n);
		return out;
	}
	var pairs = 0;
	var k = 0;
	while k + 1 < g.n {
		gold_cache_put(g, g.res[k], g.res[k + 1]);
		pairs++;
		k += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired steps cached: ", pairs);
	out
}
@end
