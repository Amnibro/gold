fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var m = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[m - 1] {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped streak items: ", m);
