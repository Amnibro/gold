@entry 60a9b207da421388
kind: step
verb: check
noun: pairs
modifier: last
context: error
slot: threshold int
phrase: check pairs last difference threshold {threshold}
phrase: verify trailing pair difference under {threshold}
test: list=10,12,15 threshold=5
expect: => i=3 r=0.0 ok=true s="checked last pair diff: 3" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=10,25 threshold=5
expect: => i=15 r=0.0 ok=false s="error: pair gap 15 exceeds 5" errors=1 n=2 res=[10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	if g.n < 2 {
		gold_fail(g, "insufficient items for pair check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	let diff = abs(g.res[g.n - 1] - g.res[g.n - 2]);
	g.steps += 2;
	if diff > lim {
		gold_fail(g, "last pair difference exceeds threshold");
		out.ok = false;
		out.i = diff;
		out.s.clear();
		format(out.s, "error: pair gap ", diff, " exceeds ", lim);
		return out;
	}
	out.i = diff;
	out.s.clear();
	format(out.s, "checked last pair diff: ", diff);
	out
}
@end
@entry 597aa619fc5519d9
kind: step
verb: reverse
noun: middle
modifier: last
context: error
slot: margin int
phrase: reverse middle last items margin {margin}
phrase: invert middle items preserving border margin {margin}
test: list=1,2,3,4,5,6 margin=1
expect: => i=4 r=0.0 ok=true s="reversed middle portion: 4" errors=0 n=6 res=[1,5,4,3,2,6] cache=0 hits=0
test: list=1,2 margin=2
expect: => i=2 r=0.0 ok=false s="error: count 2 below margin threshold" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n < m * 2 {
		gold_fail(g, "insufficient items for middle reverse");
		out.ok = false;
		out.i = g.n;
		out.s.clear();
		format(out.s, "error: count ", g.n, " below margin threshold");
		return out;
	}
	var l = m;
	var r = g.n - 1 - m;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n;
	out.i = g.n - m * 2;
	out.s.clear();
	format(out.s, "reversed middle portion: ", out.i);
	out
}
@end
@entry 7b331e70f6f19ba4
kind: step
verb: count
noun: window
modifier: times
context: error
slot: win int
slot: threshold int
slot: min_times int
phrase: count window times size {win} threshold {threshold} min {min_times}
phrase: tally sliding window occurrences {win} {threshold} min {min_times}
test: list=10,20,30,40 win=2 threshold=25 min_times=2
expect: => i=3 r=0.0 ok=true s="qualifying windows: 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,2,3,4 win=2 threshold=25 min_times=2
expect: => i=0 r=0.0 ok=false s="error: matches 0 below 2" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	let th = ${threshold};
	let req = ${min_times};
	if w <= 0 || g.n < w {
		gold_fail(g, "window larger than result size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: window size error");
		return out;
	}
	var matches = 0;
	let limit = g.n - w + 1;
	for k in limit {
		var sum = 0;
		for j in w { sum += g.res[k + j]; }
		if sum >= th { matches++; }
	}
	g.steps += limit * w;
	if matches < req {
		gold_fail(g, "window count below minimum times");
		out.ok = false;
		out.i = matches;
		out.s.clear();
		format(out.s, "error: matches ", matches, " below ", req);
		return out;
	}
	out.i = matches;
	out.s.clear();
	format(out.s, "qualifying windows: ", matches);
	out
}
@end
