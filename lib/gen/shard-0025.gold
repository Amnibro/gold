fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var take = count;
	if take > g.n { take = g.n; }
	if take < 0 { take = 0; }
	let start = g.n - take;
	for i in take {
		g.res[i] = g.res[start + i];
	}
	g.n = take;
	g.steps += g.n;
	out.i = take;
	out.s.clear();
	format(out.s, "collected last ", take, " sorted items");
	out
}
