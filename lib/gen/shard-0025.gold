@entry 31da12af0c7f52ba
kind: step
verb: reverse
noun: prefix
modifier: with_cache
context: sort
phrase: reverse prefix with cache size {k} in list
phrase: invert prefix with cache count {k} across array
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="prefix reversed: 3" errors=0 n=5 res=[3,2,1,4,5] cache=1 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="prefix reversed: 2" errors=0 n=4 res=[20,10,30,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = ${k};
	if cnt > g.n { cnt = g.n; }
	if cnt < 0 { cnt = 0; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var l = 0;
	var r = cnt - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	if cnt > 0 { gold_cache_put(g, cnt, g.res[0]); }
	out.i = cnt;
	out.s.clear();
	format(out.s, "prefix reversed: ", cnt);
	g.steps += cnt;
	out
}
@end
