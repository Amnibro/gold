fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] <= limit {
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected safely: ", count);
	out
}
@end
@entry 7596abcf85041f18
kind: step
