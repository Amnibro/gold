fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let cur, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cur + 1);
		} else {
