test: list=2,4,6,8,10 retries=2
expect: => i=18 r=0.0 ok=true s="middle sum: 18" errors=0 n=6 res=[2,4,6,8,10,18] cache=0 hits=0
test: list=1,3,5,7 retries=1
expect: => i=8 r=0.0 ok=true s="middle sum: 8" errors=0 n=5 res=[1,3,5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ret = ${retries};
	var sum = 0;
	var k = 0;
	while k < ret {
		sum = 0;
		if g.n > 2 {
			for i in g.n - 2 {
				sum += g.res[i + 1];
			}
		}
		if sum % 2 == 0 { break; }
		k++;
	}
	g.steps += g.n + k;
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "middle sum: ", sum);
	out
}
@end
@entry e2b552027e0b2cbe
kind: step
verb: search
noun: window
modifier: sorted
context: search
phrase: search window sorted span {span} target {target}
phrase: probe sorted window width {span} value {target}
slot: span int
slot: target int
test: list=1,3,5,2,4 span=3 target=5
expect: => i=0 r=0.0 ok=true s="sorted window at: 0" errors=0 n=5 res=[1,3,5,2,4] cache=0 hits=0
test: list=8,6,4,2 span=2 target=4
expect: => i=-1 r=0.0 ok=false s="sorted window at: -1" errors=0 n=4 res=[8,6,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	let tgt = ${target};
	var found_idx = -1;
	if w > 0 && g.n >= w {
		for i in g.n - w + 1 {
			var is_sorted = true;
			var has_tgt = false;
			for j in w {
				let cur = g.res[i + j];
				if cur == tgt { has_tgt = true; }
				if j > 0 && cur < g.res[i + j - 1] {
					is_sorted = false;
				}
			}
			if is_sorted && has_tgt {
				found_idx = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "sorted window at: ", found_idx);
	out
}
@end
