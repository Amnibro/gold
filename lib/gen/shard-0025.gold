test: list=5,8,12,3,20 cutoff=10
expect: => i=3 r=0.0 ok=true s="rotated count while below: 3" errors=0 n=5 res=[8,12,5,3,20] cache=3 hits=0
test: list=4,6,15,8 cutoff=8
expect: => i=2 r=0.0 ok=true s="rotated count while below: 2" errors=0 n=4 res=[6,4,15,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${cutoff};
	var count = 0;
	for i in g.n {
		if g.res[i] < threshold { count++; }
	}
	if count > 1 {
		let tmp = g.res[0];
		for i in count - 1 { g.res[i] = g.res[i + 1]; }
		g.res[count - 1] = tmp;
	}
	for i in count { gold_cache_put(g, i, g.res[i]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated count while below: ", count);
	out
}
@end
