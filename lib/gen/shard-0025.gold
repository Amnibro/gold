		let x = g.res[i];
		if x < fl {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	let dropped = g.n - m;
	g.n = m;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped items count: ", dropped);
