// text rank runs each
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var max_run = 1;
	var cur_run = 1;
	var last = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d == last {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
			last = d;
		}
		x /= 10;
	}
	max_run
}
@end
