@entry aa6f8a06f0297399
kind: step
verb: filter
noun: minimum
modifier: with_cache
context: cache
phrase: filter minimum values using cache bound {lo}
phrase: screen minimum numbers with cache limit {lo}
slot: lo int
test: list=10,4,18,2,25 lo=8
expect: => i=3 r=0.0 ok=true s="filtered min cache kept: 3" errors=0 n=3 res=[10,18,25] cache=5 hits=0
test: list=5,12,3,15,9 lo=10
expect: => i=2 r=0.0 ok=true s="filtered min cache kept: 2" errors=0 n=2 res=[12,15] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lo};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, hit = gold_cache_get(g, x);
		if hit {
			if cached >= bound { g.res[kept] = cached; kept++; }
		} else {
			gold_cache_put(g, x, x);
			if x >= bound { g.res[kept] = x; kept++; }
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered min cache kept: ", kept);
	out
}
@end
@entry 9d80f2fcda80cf21
kind: step
verb: rotate
noun: pairs
modifier: times
context: cache
phrase: rotate pairs elements {k} positions forward
phrase: shift pairs items ahead by {k} steps
slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="rotated pairs steps: 2" errors=0 n=5 res=[4,5,1,2,3] cache=5 hits=0
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="rotated pairs steps: 1" errors=0 n=4 res=[40,10,20,30] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n > 1 {
		for s in shift {
			let last = g.res[g.n - 1];
			for i in g.n - 1 {
				let idx = g.n - 1 - i;
				g.res[idx] = g.res[idx - 1];
			}
			g.res[0] = last;
		}
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated pairs steps: ", shift);
	out
}
@end
@entry 6b09b09877b724b4
kind: step
verb: dedupe
noun: minimum
modifier: any
context: cache
phrase: dedupe minimum items dropping below {cutoff}
phrase: prune minimum values failing threshold {cutoff}
slot: cutoff int
test: list=12,5,18,5,24,12 cutoff=10
expect: => i=3 r=0.0 ok=true s="deduped minimum count: 3" errors=0 n=3 res=[12,18,24] cache=3 hits=0
test: list=3,8,15,3,20,8 cutoff=6
expect: => i=3 r=0.0 ok=true s="deduped minimum count: 3" errors=0 n=3 res=[8,15,20] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark = ${cutoff};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mark {
			var seen = false;
			for j in kept { if g.res[j] == x { seen = true; break; } }
			if !seen {
				gold_cache_put(g, kept, x);
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped minimum count: ", kept);
	out
}
@end
@entry a54648bcf8fbc9ba
kind: step
verb: repeat
noun: text
modifier: at_least
context: cache
phrase: repeat text segments at least {count} times
phrase: replicate text parts at least {count} cycles
slot: count int
test: list=2,4 count=3
expect: => i=6 r=0.0 ok=true s="repeated text length: 6" errors=0 n=6 res=[2,4,2,4,2,4] cache=6 hits=0
test: list=5,10 count=2
expect: => i=4 r=0.0 ok=true s="repeated text length: 4" errors=0 n=4 res=[5,10,5,10] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${count};
	let orig_n = g.n;
	var appended = 0;
	if reps > 1 && orig_n > 0 {
		for r in reps - 1 {
			for i in orig_n {
				gold_push(g, g.res[i]);
				appended++;
			}
		}
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += appended;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated text length: ", g.n);
	out
}
@end
@entry 7703e9aeb8d7cf06
kind: step
