		}
	}
	let start = g.n / 2;
	for i in start..g.n {
		g.res[i] = g.res[i] * f;
	}
	g.steps += g.n;
	out.i = f;
	out.s.clear();
	format(out.s, "tail elements scaled: ", f);
	out
}
@end
@entry 5ec6e089820f81ae
kind: step
verb: keep
noun: steps
modifier: with_cache
context: sort
phrase: keep sort steps cached under key {key}
phrase: store sorting steps count in cache key {key}
slot: key int
test: list=7,3,1,9,4 key=10
expect: => i=5 r=0.0 ok=true s="sorting steps cached: 5" errors=0 n=5 res=[1,3,4,7,9] cache=1 hits=0
test: list=5,2,8,6 key=20
expect: => i=2 r=0.0 ok=true s="sorting steps cached: 2" errors=0 n=4 res=[2,5,6,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var swap_steps = 0;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
					swap_steps++;
				}
			}
		}
	}
	gold_cache_put(g, k, swap_steps);
	g.steps += swap_steps;
	out.i = swap_steps;
	out.s.clear();
	format(out.s, "sorting steps cached: ", swap_steps);
	out
}
@end
@entry beb8c4321c15b48b
kind: step
verb: pair
noun: histogram
modifier: pairwise
context: sort
phrase: pair histogram buckets pairwise bound {bound}
phrase: group sorted histogram bins pairwise ceiling {bound}
slot: bound int
test: list=3,1,3,2,1,2 bound=3
expect: => i=3 r=0.0 ok=true s="histogram bins paired: 3" errors=0 n=9 res=[1,1,2,2,3,3,2,4,6] cache=0 hits=0
test: list=4,2,4,2,6 bound=2
expect: => i=1 r=0.0 ok=true s="histogram bins paired: 1" errors=0 n=6 res=[2,2,4,4,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var pairs = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] {
				if g.res[i] <= bnd {
					gold_push(g, g.res[i] * 2);
					pairs++;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "histogram bins paired: ", pairs);
	out
}
@end
@entry 89777205d069b3fd
kind: step
verb: count
noun: prefix
modifier: pairwise
context: sort
phrase: count pairwise differences in prefix length {len}
phrase: evaluate pairwise prefix differences within limit {len}
slot: len int
test: list=9,1,4,7,2 len=3
expect: => i=3 r=0.0 ok=true s="prefix pairwise diff: 3" errors=0 n=5 res=[1,2,4,7,9] cache=0 hits=0
test: list=12,3,6,18 len=4
expect: => i=15 r=0.0 ok=true s="prefix pairwise diff: 15" errors=0 n=4 res=[3,6,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var diff_sum = 0;
	var lim = l;
	if lim > g.n { lim = g.n; }
	if lim > 1 {
		for i in (lim - 1) {
			diff_sum += g.res[i + 1] - g.res[i];
		}
	}
	g.steps += lim;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "prefix pairwise diff: ", diff_sum);
	out
}
@end
@entry d4775feb3f402363
kind: step
verb: map
noun: history
modifier: until
context: sort
phrase: map cumulative history until cutoff {cutoff}
phrase: accumulate sorted history until limit {cutoff}
slot: cutoff int
test: list=5,2,8,1,3 cutoff=10
expect: => i=11 r=0.0 ok=true s="mapped history sum: 11" errors=0 n=9 res=[1,2,3,5,8,1,3,6,11] cache=0 hits=0
test: list=10,4,6,2 cutoff=15
expect: => i=22 r=0.0 ok=true s="mapped history sum: 22" errors=0 n=8 res=[2,4,6,10,2,6,12,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var cur_sum = 0;
	var orig_n = g.n;
	for i in orig_n {
		cur_sum += g.res[i];
		gold_push(g, cur_sum);
		if cur_sum >= cut {
			break;
		}
	}
	g.steps += g.n;
	out.i = cur_sum;
	out.s.clear();
	format(out.s, "mapped history sum: ", cur_sum);
	out
}
@end
