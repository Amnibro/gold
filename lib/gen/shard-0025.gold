	if g.n > 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "total sum: ", sum);
	out
}
@end
