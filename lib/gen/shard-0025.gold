fn ${ID}(n int) int {
	let thresh = ${threshold};
	var x = if n < 0 { -n } else { n };
	var d int[16] = [0; 16];
	var count = 0;
	while x > 0 {
		let rem = x % 10;
		if rem > thresh {
			d[count] = rem;
			count++;
		}
		x /= 10;
	}
	for i in count {
		var min_idx = i;
		for j in (i + 1)..count {
			if d[j] < d[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = d[i];
			d[i] = d[min_idx];
			d[min_idx] = tmp;
		}
	}
	var res = 0;
	for i in count {
		res = res * 10 + d[i];
	}
	res
}
@end
