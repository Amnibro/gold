expect: => i=2 r=0.0 ok=true s="large gaps found: 2" errors=0 n=4 res=[2,15,18,35] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var gap_count = 0;
	if g.n > 1 {
		var idx = g.n - 1;
		while idx > 0 {
			let diff = g.res[idx] - g.res[idx - 1];
			var ad = diff;
			if ad < 0 { ad = -ad; }
			if ad >= th {
				gold_cache_put(g, idx, diff);
				gap_count++;
			}
			idx--;
		}
	}
	g.steps += g.n;
	out.i = gap_count;
	out.s.clear();
	format(out.s, "large gaps found: ", gap_count);
	out
}
@end
