fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch <= 1 || g.n <= 1 { return out; }
	var b = 0;
	while b < g.n {
		let end_idx = if b + ch < g.n { b + ch } else { g.n };
		for i in b..end_idx {
			var min_idx = i;
			for j in (i + 1)..end_idx {
				if g.res[j] < g.res[min_idx] { min_idx = j; }
			}
			if min_idx != i {
				let tmp = g.res[i];
				g.res[i] = g.res[min_idx];
				g.res[min_idx] = tmp;
			}
		}
		b += ch;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted items across blocks");
	g.steps += g.n * ch;
	out
}
@end
