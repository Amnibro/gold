@entry e2a7ec8a53981dd6
kind: step
verb: keep
noun: tail
modifier: recursively
context: core
phrase: keep tail recursively preserving last {k}
phrase: retain tail elements recursively for {k}
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="kept 3 tail items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20 k=1
expect: => i=1 r=0.0 ok=true s="kept 1 tail items" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count < g.n && count >= 0 {
		let offset = g.n - count;
		for i in count {
			g.res[i] = g.res[offset + i];
		}
		g.n = count;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " tail items");
	out
}
@end
@entry 826856feee431449
kind: step
verb: pair
noun: values
modifier: up_to
context: core
phrase: pair adjacent values up to {bound}
phrase: combine value pairs up to limit {bound}
slot: bound int
test: list=2,4,6,8 bound=12
expect: => i=1 r=0.0 ok=true s="paired 1 values" errors=0 n=5 res=[2,4,6,8,6] cache=0 hits=0
test: list=10,20 bound=15
expect: => i=0 r=0.0 ok=true s="paired 0 values" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s <= b {
			gold_push(g, s);
			pairs++;
		}
		i += 2;
	}
	g.steps += i;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " values");
	out
}
@end
