fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = kept;
	out.s.clear();
	format(out.s, "kept between: ", kept);
	g.steps += g.n * 2;
	out
}
@end
