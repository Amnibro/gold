code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var count = 0;
	while count < g.n {
		if running + g.res[count] > b { break; }
		running += g.res[count];
		count++;
	}
	g.n = count;
	out.i = running;
	out.s.clear();
	format(out.s, "folded under budget: ", running);
	out
}
@end
