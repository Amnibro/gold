@entry cd17befe897898c1
kind: step
verb: limit
noun: steps
modifier: times
context: sort
phrase: limit steps times bubble sort passes {max_passes}
phrase: run bubble sort bounded by {max_passes} passes
phrase: execute at most {max_passes} passes of bubble sort
slot: max_passes int
test: list=5,1,4,2,8 max_passes=2
expect: => i=4 r=0.0 ok=true s="bubble sort completed 4 swaps" errors=0 n=5 res=[1,2,4,5,8] cache=0 hits=0
test: list=9,7,5,3,1 max_passes=1
expect: => i=4 r=0.0 ok=true s="bubble sort completed 4 swaps" errors=0 n=5 res=[7,5,3,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${max_passes};
	var swaps = 0;
	var p = 0;
	while p < passes && p < g.n {
		for j in (g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				swaps++;
			}
		}
		p++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "bubble sort completed ", swaps, " swaps");
	out
}
@end
@entry 7a1a20903a8051d1
kind: step
verb: run
noun: head
modifier: unique
context: sort
phrase: run head unique first {count} distinct values
phrase: extract first {count} distinct elements from sorted list
phrase: isolate up to {count} unique head elements
slot: count int
test: list=2,2,4,4,6,8,8 count=3
expect: => i=3 r=0.0 ok=true s="extracted 3 unique head items" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,1,1,2 count=5
expect: => i=2 r=0.0 ok=true s="extracted 2 unique head items" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for i in g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			if kept < lim {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "extracted ", kept, " unique head items");
	out
}
@end
