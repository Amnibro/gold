code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let cached_val, found = gold_cache_get(g, out.i);
	if !found {
		gold_fail(g, "cache lookup missed");
		let computed = out.i * f;
		gold_cache_put(g, out.i, computed);
		out.i = computed;
	} else {
		out.i = cached_val;
	}
	out.s.clear();
	format(out.s, "cached or computed value: ", out.i);
	out
}
@end
