fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var kept = 0;
	for k in g.n {
		if g.res[k] <= limit {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " tail items");
	out
}
@end
