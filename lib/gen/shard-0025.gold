test: list=2,5,7,12,14 width=3
expect: => i=3 r=0.0 ok=true s="spaced items kept: 3" errors=0 n=3 res=[2,5,12] cache=0 hits=0
test: list=10,12,18,20 width=5
expect: => i=2 r=0.0 ok=true s="spaced items kept: 2" errors=0 n=2 res=[10,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	var buf = [0; 512];
	var bn = 0;
	if g.n > 0 {
		buf[0] = g.res[0];
		bn = 1;
		var last = g.res[0];
		for i in g.n - 1 {
			let cur = g.res[i + 1];
			var diff = cur - last;
			if diff < 0 { diff = -diff; }
			if diff >= w {
				buf[bn] = cur;
				bn++;
				last = cur;
			}
		}
	}
	g.n = 0;
	for i in bn {
		gold_push(g, buf[i]);
	}
	g.steps += bn;
	out.i = bn;
	out.s.clear();
	format(out.s, "spaced items kept: ", bn);
	out
}
@end
