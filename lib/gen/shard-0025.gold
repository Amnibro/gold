@entry 47194d1d935bf83a
kind: step
verb: shift
noun: limit
modifier: until
context: sort
phrase: shift limit until first element exceeds {lim}
phrase: pop smallest sorted elements until reaching {lim}
phrase: discard leading items below threshold {lim}
slot: lim int
test: list=2,4,6,8,10 lim=6
expect: => i=2 r=0.0 ok=true s="discarded 2 items under limit" errors=0 n=3 res=[6,8,10] cache=0 hits=0
test: list=1,3,5 lim=10
expect: => i=3 r=0.0 ok=true s="discarded 3 items under limit" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${lim};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var start = 0;
	while start < g.n && g.res[start] < threshold {
		start++;
	}
	let remaining = g.n - start;
	for i in remaining {
		g.res[i] = g.res[start + i];
	}
	g.n = remaining;
	g.steps += start;
	out.i = start;
	out.s.clear();
	format(out.s, "discarded ", start, " items under limit");
	out
}
@end
