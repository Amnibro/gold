fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_vowels};
	var vc = 0;
	var buf byte[..200] = [];
	for b in out.s {
		let is_vowel = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' || b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U';
		if is_vowel {
			if vc < mv {
				buf.push(b);
				vc++;
			}
		} else {
			buf.push(b);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len;
	out.i = vc;
	out
}
