expect: => i=2 r=0.0 ok=true s="pairs formed: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
test: list=10,5,10,2 offset=2
expect: => i=2 r=0.0 ok=true s="pairs formed: 2" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var u = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[u - 1] {
			g.res[u] = g.res[k];
			u++;
		}
	}
	g.n = u;
	if g.n >= 2 {
		for k in (g.n - 1) {
			g.res[k] = g.res[k + 1] - g.res[k] + off;
		}
		g.n = g.n - 1;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairs formed: ", g.n);
	g.steps += g.n * 2;
	out
}
@end
