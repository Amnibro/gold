code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] == g.res[k + 1] {
			if k + 2 < g.n {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 2];
				g.res[k + 2] = tmp;
				swaps++;
			}
			k += 2;
		} else {
			k++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " run points");
	out
}
@end
