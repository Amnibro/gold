@entry 220c7182d936c174
kind: step
verb: find
noun: gaps
modifier: in_place
context: list
phrase: find gaps in place exceeding {gap}
phrase: count gaps in place greater than {gap}
slot: gap int
test: list=1,2,5,6,10 gap=2
expect: => i=2 r=0.0 ok=true s="gaps found: 2" errors=0 n=5 res=[1,2,5,6,10] cache=0 hits=0
test: list=10,20,30 gap=15
expect: => i=0 r=0.0 ok=true s="gaps found: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${gap};
	var count = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 {
				diff = -diff;
			}
			if diff > threshold {
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps found: ", count);
	out
}
@end
