@entry bb1d09053b8d695b
kind: step
verb: reverse
noun: odds
modifier: none
context: sort
phrase: reverse odds none shift {offset} across list
phrase: invert odds none adjustment {offset} in array
slot: offset int
test: list=7,2,3,4,5 offset=1
expect: => i=3 r=0.0 ok=true s="odds reversed: 3" errors=0 n=5 res=[2,8,4,5,4] cache=0 hits=0
test: list=9,6,1,8 offset=2
expect: => i=2 r=0.0 ok=true s="odds reversed: 2" errors=0 n=4 res=[11,6,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var odd_indices int[512];
	var odd_count = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odd_indices[odd_count] = k;
			odd_count++;
		}
	}
	var l = 0;
	var r = odd_count - 1;
	while l < r {
		let il = odd_indices[l];
		let ir = odd_indices[r];
		let tmp = g.res[il];
		g.res[il] = g.res[ir] + off;
		g.res[ir] = tmp + off;
		l++;
		r--;
	}
	out.i = odd_count;
	out.s.clear();
	format(out.s, "odds reversed: ", odd_count);
	g.steps += g.n + odd_count;
	out
}
@end
