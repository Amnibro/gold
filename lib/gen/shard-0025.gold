@entry c769e530aa7953d1
kind: step
verb: map
noun: digits
modifier: each
context: sort
phrase: map digits each divisor {base} in array
phrase: convert digits each modulo {base} across list
slot: base int
test: list=15,28,34 base=10
expect: => i=53 r=0.0 ok=true s="digit sum total: 53" errors=0 n=3 res=[16,17,20] cache=0 hits=0
test: list=42,19,53 base=5
expect: => i=39 r=0.0 ok=true s="digit sum total: 39" errors=0 n=3 res=[11,13,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var dsum = 0;
		while x > 0 { dsum += x % 10; x /= 10; }
		g.res[i] = dsum + b;
		total += g.res[i];
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "digit sum total: ", total);
	g.steps += g.n * 2;
	out
}
@end
