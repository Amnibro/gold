code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best_len = 0;
	var best_val = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let rlen = j - i;
		if rlen > best_len {
			best_len = rlen;
			best_val = g.res[i];
		}
		i = j;
	}
	for k in best_len { g.res[k] = best_val; }
	g.n = best_len;
	g.steps += best_len;
	out.i = best_len;
	out.s.clear();
	format(out.s, "streak length: ", best_len);
	out
}
@end
