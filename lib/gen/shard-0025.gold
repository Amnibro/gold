@entry 7e7b5e3659804d1b
kind: pred
verb: retry
noun: list
modifier: sorted
context: aggregate
phrase: retry list sorted prime factor descending order
phrase: verify prime factorization multiplicity is ordered
test: arg=72,120
expect: true
expect: true
test: arg=360
expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x <= 1 { return true; }
	var prev_exp = 100;
	var is_sorted = true;
	var d = 2;
	while d * d <= x {
		if x % d == 0 {
			var exp = 0;
			while x % d == 0 {
				exp++;
				x /= d;
			}
			if exp > prev_exp {
				is_sorted = false;
				break;
			}
			prev_exp = exp;
		}
		d++;
	}
	if x > 1 {
		if 1 > prev_exp { is_sorted = false; }
	}
	is_sorted
}
@end
