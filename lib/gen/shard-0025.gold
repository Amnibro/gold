noun: average
modifier: between
context: error
phrase: apply average between range {lo} through {hi}
phrase: smooth average between bounds {lo} through {hi}
slot: lo int
slot: hi int
test: list=10,20,30,40,50 lo=1 hi=3
expect: => i=30 r=0.0 ok=true s="computed average: 30" errors=0 n=5 res=[10,30,30,30,50] cache=0 hits=0
test: list=5,15,25 lo=0 hi=2
expect: => i=15 r=0.0 ok=true s="computed average: 15" errors=0 n=3 res=[15,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l >= h || l < 0 || h >= g.n {
		gold_fail(g, "invalid bounds for average");
		out.ok = false;
		return out;
	}
	var sum_val = 0;
	var count = 0;
	var i = l;
	while i <= h {
		sum_val += g.res[i];
		count++;
		i++;
	}
	let avg = sum_val / count;
	i = l;
	while i <= h {
		g.res[i] = avg;
		i++;
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "computed average: ", avg);
	out
}
@end
