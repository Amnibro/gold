@entry 8bfbbefbe97afca9
kind: fn
verb: sort
noun: results
modifier: in_place
context: filter
phrase: sort digit results in place descending
phrase: order filter results in place highest first
test: arg=142,395
expect: 421
expect: 953
test: arg=802
expect: 820
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	for i in len {
		var max_idx = i;
		for j in (i + 1)..len {
			if d[j] > d[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = d[i];
			d[i] = d[max_idx];
			d[max_idx] = tmp;
		}
	}
	var res = 0;
	for i in len {
		res = res * 10 + d[i];
	}
	res
}
@end
