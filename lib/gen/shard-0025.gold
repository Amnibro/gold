expect: => i=40 r=0.0 ok=true s="running average clamped: 40" errors=0 n=3 res=[20,40,60] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_avg = ${cap};
	var run_sum = 0;
	for i in g.n {
		run_sum += g.res[i];
		let cur_avg = run_sum / (i + 1);
		let bounded = if cur_avg > max_avg { max_avg } else { cur_avg };
		gold_cache_put(g, i, bounded);
	}
	g.steps += g.n;
	out.i = run_sum / (if g.n > 0 { g.n } else { 1 });
	out.s.clear();
	format(out.s, "running average clamped: ", out.i);
	out
}
@end
