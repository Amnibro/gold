fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	var last_char = 0;
	var in_word = false;
	for k in out.s.len {
		let c = out.s[k];
		if c == ' ' {
			in_word = false;
		} else if !in_word {
			in_word = true;
			if last_char > 0 && c < last_char {
				sorted = false;
				break;
			}
			last_char = c;
		}
	}
	g.steps += out.s.len;
	if !sorted {
		gold_fail(g, "words not alphabetically sorted");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: words out of order");
		return out;
	}
	out.i = 1;
	out.s.clear();
	format(out.s, "words sorted correctly");
	out
}
@end
