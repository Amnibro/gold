fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var found = false;
	var idx = -1;
	var i = 0;
	while i < g.n && i < lim {
		if ${p}(g.res[i]) {
			found = true;
			idx = i;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.ok = found;
	out.i = idx;
	out.s.clear();
	if found {
		format(out.s, "first match at index: ", idx);
	} else {
		format(out.s, "no match in prefix");
	}
	out
}
@end
