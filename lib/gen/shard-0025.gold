code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor_val = ${scale};
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		g.res[i] = (i + 1) * factor_val;
	}
	out.i = g.n * factor_val;
	out.s.clear();
	format(out.s, "ranked numbers times scale: ", out.i);
	out
}
@end
