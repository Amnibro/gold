phrase: rotate text last characters by offset {shift}
phrase: shift text suffix characters by offset {shift}
test: text="filterflow" shift=4
expect: => i=4 r=0.0 ok=true s="flowfilter" errors=0 n=0 res=[] cache=0 hits=0
test: text="pipeline" shift=3
expect: => i=3 r=0.0 ok=true s="inepipel" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	let len = out.s.len;
	if len <= 1 || s <= 0 { return out; }
	let k = s % len;
	var temp byte[>..] = [];
	for i in len {
		let src = (i + len - k) % len;
		temp.push(out.s[src]);
	}
	out.s.clear();
	for i in len {
		out.s.push(temp[i]);
	}
	out.i = k;
	out
}
@end
