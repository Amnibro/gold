	if g.n <= 1 { return out; }
	var i = 0;
	while i + 1 < g.n {
		g.res[i] = g.res[i] + g.res[i + 1];
		i++;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
