noun: budget
modifier: with_cache
context: aggregate
slot: budget int
phrase: normalize budget with cache cap {budget}
phrase: scale values to budget using cached total {budget}
test: list=10,20,30,40 budget=50
expect: => i=4 r=0.0 ok=true s="budget normalized: 4" errors=0 n=4 res=[5,10,15,20] cache=1 hits=0
test: list=5,15,20 budget=20
expect: => i=3 r=0.0 ok=true s="budget normalized: 3" errors=0 n=3 res=[2,7,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget};
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	gold_cache_put(g, 0, sum);
	var count = 0;
	i = 0;
	while i < g.n {
		if sum > 0 {
			g.res[i] = (g.res[i] * cap) / sum;
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "budget normalized: ", count);
	out
}
@end
