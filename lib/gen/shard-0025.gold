expect: => i=1 r=0.0 ok=true s="collected gaps: 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tol = ${tol};
	var temp int[512] = [0; 512];
	var tc = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff <= max_tol {
			temp[tc] = diff;
			tc++;
		}
		i++;
	}
	gold_clear(g);
	i = 0;
	while i < tc {
		gold_push(g, temp[i]);
		i++;
	}
	g.steps += tc;
	out.i = tc;
	out.s.clear();
	format(out.s, "collected gaps: ", tc);
	out
}
@end
