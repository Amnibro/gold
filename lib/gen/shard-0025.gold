@entry 2a056a3168e22a86
kind: step
verb: apply
noun: checkpoint
modifier: each
context: error
phrase: apply checkpoint on each element verifying modulus {mod_divisor}
phrase: test checkpoint condition across each item using divisor {mod_divisor}
slot: mod_divisor int
test: list=10,20,30 mod_divisor=5
expect: => i=3 r=0.0 ok=true s="checkpoints passed: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,17,30 mod_divisor=5
expect: => i=0 r=0.0 ok=false s="error: checkpoint failed" errors=1 n=3 res=[10,17,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mod_divisor};
	if m <= 0 {
		gold_fail(g, "checkpoint divisor must be strictly positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid divisor");
		return out;
	}
	for i in g.n {
		let x = g.res[i];
		let r = if x < 0 { (-x) % m } else { x % m };
		if r != 0 {
			gold_fail(g, "element failed checkpoint validation");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: checkpoint failed");
			return out;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "checkpoints passed: ", g.n);
	out
}
@end
