@entry 78d45bcb6a848dcb
kind: step
verb: measure
noun: values
modifier: none
context: core
phrase: measure values span from minimum to maximum
phrase: calculate dynamic range across recorded values
test: list=3,15,8
expect: => i=12 r=0.0 ok=true s="values range span 12" errors=0 n=3 res=[3,15,8] cache=0 hits=0
test: list=10,10,10
expect: => i=0 r=0.0 ok=true s="values range span 0" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	let span = max_val - min_val;
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "values range span ", span);
	out
}
@end
