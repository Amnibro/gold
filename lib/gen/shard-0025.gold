code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = g.res[2 * k] + g.res[2 * k + 1];
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "sorted pairs: ", pairs);
	out
}
@end
@entry 326e500906d0dd69
kind: step
verb: map
noun: history
modifier: with_cache
context: list
phrase: map history with_cache tracking seen values
phrase: transform elements caching previous history
test: list=5,10,5,10,5
expect: => i=3 r=0.0 ok=true s="cached hits: 3" errors=0 n=5 res=[5,10,2,2,3] cache=2 hits=3
test: list=1,2,3,1,2
expect: => i=2 r=0.0 ok=true s="cached hits: 2" errors=0 n=5 res=[1,2,3,2,2] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for i in g.n {
		let val = g.res[i];
		let prev, ok = gold_cache_get(g, val);
		if ok {
			hits++;
			g.res[i] = prev + 1;
			gold_cache_put(g, val, prev + 1);
		} else {
			gold_cache_put(g, val, 1);
		}
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "cached hits: ", hits);
	out
}
@end
@entry d5034eccf785bb85
kind: step
verb: reverse
noun: condition
modifier: safely
context: list
phrase: reverse condition safely when satisfying rule {p}
phrase: invert elements safely when matching check {p}
slot: p pred
test: list=1,2,3,4,5 p=is_even
expect: => i=2 r=0.0 ok=true s="matches reversed: 2" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=7,11,13 p=is_prime
expect: => i=3 r=0.0 ok=true s="matches reversed: 3" errors=0 n=3 res=[13,11,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches = 0;
	for i in g.n {
		if ${p}(g.res[i]) { matches++; }
	}
	if matches > 0 {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "matches reversed: ", matches);
	out
}
@end
