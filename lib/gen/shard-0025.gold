@entry 0921acc6a9fdb0d6
kind: fn
verb: select
noun: numbers
modifier: in_place
context: error
phrase: select valid numbers in place within bound {lim}
phrase: filter numbers in place under threshold {lim}
slot: lim int
test: arg=1245,6789 lim=5
expect: 1245
expect: 0
test: arg=304 lim=3
expect: 30
code:
fn ${ID}(n int) int {
	// error domain: select numbers in_place
	let lim = ${lim};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		rev[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = 0;
	var i = len - 1;
	while i >= 0 {
		let d = rev[i];
		if d <= lim {
			res = res * 10 + d;
		}
		i--;
	}
	res
}
@end
@entry b295c09554552c90
kind: fn
verb: swap
noun: memo
modifier: every_other
context: error
phrase: swap alternate digit pairs in memo
phrase: transpose every other position in error memo
test: arg=1234,5678
expect: 2143
expect: 6587
test: arg=987
expect: 897
code:
fn ${ID}(n int) int {
	// error domain: swap memo every_other
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		rev[len] = x % 10;
		len++;
		x /= 10;
	}
	var d int[16] = [0; 16];
	for i in len {
		d[i] = rev[len - 1 - i];
	}
	var i = 0;
	while i + 1 < len {
		let tmp = d[i];
		d[i] = d[i + 1];
		d[i + 1] = tmp;
		i += 2;
	}
	var res = 0;
	for j in len {
		res = res * 10 + d[j];
	}
	res
}
@end
