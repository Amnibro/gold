noun: tally
modifier: times
context: filter
slot: scale int
phrase: trace tally times scaling counts by factor {scale}
phrase: record tally frequency scaled times factor {scale}
test: list=10,20,10,30,10 scale=2
expect: => i=3 r=0.0 ok=true s="traced tally times scale: 3" errors=0 n=3 res=[6,2,2] cache=0 hits=0
test: list=5,8,5,8,5 scale=3
expect: => i=2 r=0.0 ok=true s="traced tally times scale: 2" errors=0 n=2 res=[9,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor_val = ${scale};
	var unique int[256] = [0; 256];
	var count int[256] = [0; 256];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in u {
			if unique[j] == x { found = j; break; }
		}
		if found >= 0 {
			count[found]++;
		} else {
			unique[u] = x;
			count[u] = 1;
			u++;
		}
	}
	for j in u {
		g.res[j] = count[j] * factor_val;
	}
	g.n = u;
	out.i = u;
	out.s.clear();
	format(out.s, "traced tally times scale: ", u);
	out
}
@end
