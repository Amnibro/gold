code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	if g.n < 2 { return out; }
	var runs_count = 0;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_run++;
		} else {
			if cur_run >= mr { runs_count++; }
			cur_run = 1;
		}
	}
	if cur_run >= mr { runs_count++; }
	out.i = runs_count;
	out.s.clear();
	format(out.s, "qualifying runs: ", runs_count);
	g.steps += g.n;
	out
}
@end
