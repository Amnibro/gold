fn ${ID}(g Gold&, v Val) Val {
	var out_32 = v;
	if !gold_img_ok(g) { out_32.ok = false; return out_32; }
	var sp_32 = 8;
	for oct_32 in 2 { if !gold_img_square(g, sp_32) { out_32.ok = false; return out_32; } sp_32 = sp_32 / 2; }
	for y in g.ih {
		for x in g.iw {
			var acc_32 = 0.0;
			var wt_32 = 1.0;
			var tot_32 = 0.0;
			var cc_32 = 8;
			for oct_32 in 2 { acc_32 += wt_32 * gold_vnoise(x, y, cc_32, g.iw / cc_32, ${u} + oct_32); tot_32 += wt_32; wt_32 *= 0.5; cc_32 = cc_32 / 2; }
			g.img[y * g.iw + x] = acc_32 / tot_32;
		}
	}
	if 4 < 2 || 4 > 16 { gold_fail(g, "levels out of range"); out_32.ok = false; return out_32; }
	for k_32 in g.iw * g.ih {
		var q_32 = (g.img[k_32] * (4 as real)) as! int;
		if q_32 > 4 - 1 { q_32 = 4 - 1; }
		g.img[k_32] = (q_32 as real) / ((4 - 1) as real);
	}
	for k_32 in g.iw * g.ih { g.img[k_32] = gold_clamp01(g.img[k_32] - 0.1); }
	out_32.i = g.iw * g.ih;
	out_32.s.clear();
	format(out_32.s, "rust");
	out_32
}
@end
