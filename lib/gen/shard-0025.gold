@entry cca5c7225f7faa9f
kind: step
verb: rank
noun: minimum
modifier: in_reverse
context: search
phrase: rank minimum in reverse count {top_k}
phrase: order minimum in reverse capacity {top_k}
slot: top_k int
test: list=40,10,30,20,50 top_k=3
expect: => i=3 r=0.0 ok=true s="minimum ranked items: 3" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
test: list=15,8,22,5 top_k=2
expect: => i=2 r=0.0 ok=true s="minimum ranked items: 2" errors=0 n=4 res=[22,15,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${top_k};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	var taken = 0;
	var i = 0;
	while i < g.n && taken < k {
		taken++;
		i++;
	}
	g.steps += g.n * g.n;
	out.i = taken;
	out.s.clear();
	format(out.s, "minimum ranked items: ", taken);
	out
}
@end
