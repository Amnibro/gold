fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${repeat};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var dups = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] {
				dups++;
				gold_push(g, g.res[i] * rep);
			}
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicate pairs found: ", dups);
	out
}
@end
