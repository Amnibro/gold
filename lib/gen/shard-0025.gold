fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${lim};
	var sum = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if sum + g.res[i] <= ceiling {
			sum += g.res[i];
			count++;
		} else {
			break;
		}
		i--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected in reverse: ", count);
	out
}
@end
@entry d7ddf4f2c026f493
kind: step
verb: compare
noun: window
modifier: at_most
context: aggregate
slot: w int
phrase: compare window at most span {w}
phrase: check sliding window at most length {w}
test: list=5,10,15,20 w=2
expect: => i=5 r=0.0 ok=true s="max window diff: 5" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=1,2,4,8 w=3
expect: => i=6 r=0.0 ok=true s="max window diff: 6" errors=0 n=4 res=[1,2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${w};
	var max_diff = 0;
	var i = 0;
	while i + span <= g.n {
		var diff = g.res[i + span - 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > max_diff {
			max_diff = diff;
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "max window diff: ", max_diff);
	out
}
@end
