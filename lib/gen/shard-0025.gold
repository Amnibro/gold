expect: => i=7 r=0.0 ok=true s="bnary lokp indx" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let kf = ${keep_first};
	var vc = 0;
	var buf byte[..200] = [];
	for b in out.s {
		let is_vowel = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' || b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U';
		if is_vowel {
			if (vc % 2 == 0 && kf > 0) || (vc % 2 != 0 && kf <= 0) {
				buf.push(b);
			}
			vc++;
		} else {
			buf.push(b);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len;
	out.i = vc;
	out
}
@end
