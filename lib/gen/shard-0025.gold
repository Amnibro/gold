code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen bool[256] = [false; 256];
	var temp byte[>..] = [];
	for i in out.s.len {
		let b = out.s[i];
		let idx = b as int;
		if !seen[idx] {
			seen[idx] = true;
			temp.push(b);
		}
	}
	out.s.clear();
	for i in temp.len {
		out.s.push(temp[i]);
	}
	out.i = out.s.len;
	out
}
@end
