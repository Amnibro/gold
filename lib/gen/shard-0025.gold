			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var ucount = 0;
	for k in g.n {
		if g.res[k] >= mn {
			if k == 0 || g.res[k] != g.res[k - 1] { ucount++; }
		}
	}
	out.i = ucount;
	out.s.clear();
	format(out.s, "unique above: ", ucount);
	g.steps += g.n;
	out
}
