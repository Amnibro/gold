@entry 34fa94a2b48e942a
kind: step
verb: drop
noun: squares
modifier: at_least
context: transform
phrase: drop squares at least threshold {min_val}
phrase: remove square elements exceeding bound {min_val}
slot: min_val int
test: list=4,9,16,25,30 min_val=10
expect: => i=2 r=0.0 ok=true s="dropped squares count: 2" errors=0 n=3 res=[4,9,30] cache=0 hits=0
test: list=1,4,7,9 min_val=3
expect: => i=2 r=0.0 ok=true s="dropped squares count: 2" errors=0 n=2 res=[1,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var keep = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= mv {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if !is_sq {
			g.res[keep] = x;
			keep++;
		}
	}
	g.steps += g.n;
	out.i = g.n - keep;
	g.n = keep;
	out.s.clear();
	format(out.s, "dropped squares count: ", out.i);
	out
}
@end
