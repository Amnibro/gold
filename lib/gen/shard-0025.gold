@entry 9270f151136b26b7
kind: step
verb: limit
noun: range
modifier: at_most
context: transform
slot: max_span int
phrase: limit range at most constraining delta span {max_span}
phrase: truncate sequence span within maximum window {max_span}
test: list=10,12,18,25,40 max_span=10
expect: => i=3 r=0.0 ok=true s="range limited: 3" errors=0 n=3 res=[10,12,18] cache=0 hits=0
test: list=5,8,12,22,35 max_span=12
expect: => i=3 r=0.0 ok=true s="range limited: 3" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${max_span};
	if g.n == 0 { return out; }
	let base = g.res[0];
	var count = 0;
	var i = 0;
	while i < g.n {
		let diff = g.res[i] - base;
		if diff <= span && diff >= -span {
			count++;
		} else {
			break;
		}
		i++;
	}
	g.steps += count;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "range limited: ", count);
	out
}
@end
