fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_animate_chair_tall_alpha = 0;
	let z = ${dz};
	if z <= 0.0 { gold_fail(g, "invalid distance"); out.ok = false; return out; }
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	var o byte[>..] = [];
	o.append(last);
	o.append(".loc anim ");
	o.append("0");
	o.append(":0,0,");
	o.append("0 ");
	o.append("1");
	o.append(":0,0,");
	gold_fnum(o, z);
	gold_doc(g, o);
	out.i = g.dn + mark_animate_chair_tall_alpha;
	out.s.clear();
	format(out.s, "anichai");
	out
}
@end
