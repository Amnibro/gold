@entry e9168f7a23f2f43d
kind: step
verb: split
noun: items
modifier: in_reverse
context: aggregate
phrase: split items in reverse order
phrase: reverse sequence elements in place
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="reversed items: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed items: 3" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let t = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = t;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed items: ", g.n);
	out
}
@end
