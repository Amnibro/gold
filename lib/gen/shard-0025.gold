expect: 24
expect: 18
test: arg=50,351
expect: 5
expect: 100
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	var rev = 0;
	while val > 0 {
		rev = (rev * 10) + (val % 10);
		val = val / 10;
	}
	if rev > 100 {
		rev = 100;
	}
	return rev;
}
@end
