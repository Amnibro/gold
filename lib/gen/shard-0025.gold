	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted interior middle slice across ", g.n, " elements");
	out
}
@end
@entry 3b38cac5a3d8406e
kind: step
verb: filter
noun: range
modifier: last
context: math
slot: window int
phrase: filter range last suffix elements bounded by {window}
phrase: select range last trailing elements within {window}
test: list=10,20,30,40,50 window=3
expect: => i=3 r=0.0 ok=true s="filtered last 3 range elements" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=5,15,25,35,45,55 window=4
expect: => i=4 r=0.0 ok=true s="filtered last 4 range elements" errors=0 n=4 res=[25,35,45,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w < g.n {
		let start = g.n - w;
		for i in w {
			g.res[i] = g.res[start + i];
		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered last ", g.n, " range elements");
	out
}
@end
