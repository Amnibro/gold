expect: => i=-1 r=0.0 ok=false s="tail search result: -1" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let d = ${depth};
	var found = -1;
	var steps = 0;
	var idx = g.n - 1;
	while idx >= 0 && steps < d {
		if g.res[idx] == tgt {
			found = idx;
			break;
		}
		steps++;
		idx--;
	}
	g.steps += steps;
	out.i = found;
	out.ok = found >= 0;
	out.s.clear();
	format(out.s, "tail search result: ", found);
	out
}
@end
