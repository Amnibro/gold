expect: => i=2 r=0.0 ok=true s="subfunction sorted items: 2" errors=0 n=4 res=[5,18,10,22] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var cnt = 0;
	for i in g.n { if g.res[i] < ceiling { cnt++; } }
	if cnt > 1 {
		for p in cnt {
			for q in cnt - 1 - p {
				if g.res[q] > g.res[q + 1] {
					let tmp = g.res[q];
					g.res[q] = g.res[q + 1];
					g.res[q + 1] = tmp;
				}
			}
		}
	}
	for i in cnt { gold_cache_put(g, i, g.res[i]); }
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "subfunction sorted items: ", cnt);
	out
}
@end
