expect: 20
code:
fn ${ID}(n int) int {
	var val = n;
	if val < 2 {
		return 0;
	}
	var total = 0;
	var i = 1;
	while i < val {
		var first = i;
		var second = i + 1;
		var m = first;
		if second > m {
			m = second;
		}
		total += m;
		i++;
	}
	return total;
}
@end
