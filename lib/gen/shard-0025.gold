code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	for i in g.n { g.res[i] *= m; }
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled sorted items ", g.n);
	out
}
@end
