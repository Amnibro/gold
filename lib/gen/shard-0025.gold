phrase: fold alternate digits across loop sequence
phrase: accumulate alternating digits across loop
test: arg=1234,5678
expect: 6
expect: 14
test: arg=901
expect: 10
code:
// text fold loop every_other
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	var idx = 0;
	while x > 0 {
		if idx % 2 == 0 { sum += x % 10; }
		idx++;
		x /= 10;
	}
	sum
}
@end
@entry 74db3e9bf0e7538e
kind: step
verb: sum
noun: total
modifier: last
context: list
phrase: sum total last {count} items
phrase: tally total of last {count} elements
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=120 r=0.0 ok=true s="sum of last items: 120" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=3,7,12 count=2
expect: => i=19 r=0.0 ok=true s="sum of last items: 19" errors=0 n=3 res=[3,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var total = 0;
	var taken = 0;
	if k > 0 && g.n > 0 {
		var start = g.n - k;
		if start < 0 {
			start = 0;
		}
		for i in g.n - start {
			total += g.res[start + i];
			taken++;
		}
	}
	g.steps += taken;
	out.i = total;
	out.s.clear();
	format(out.s, "sum of last items: ", total);
	out
}
@end
