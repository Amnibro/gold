	var len = 0;
	while x > 0 {
		rev[len] = x % 10;
		len++;
		x /= 10;
	}
	var d int[16] = [0; 16];
	for i in len {
		d[i] = rev[len - 1 - i];
	}
	let k = if lim < len { lim } else { len };
	for i in (k / 2) {
		let tmp = d[i];
		d[i] = d[k - 1 - i];
		d[k - 1 - i] = tmp;
	}
	var res = 0;
	for i in len {
		res = res * 10 + d[i];
	}
	res
}
@end
@entry 7d053d4e3bac9489
kind: fn
verb: retry
noun: checkpoint
modifier: in_place
context: error
phrase: retry checkpoint calculation in place attempts {retries}
phrase: recompute checkpoint in place up to {retries}
slot: retries int
test: arg=6,1 retries=5
expect: 8
expect: 1
test: arg=3 retries=10
expect: 1
code:
fn ${ID}(n int) int {
	// error domain: retry checkpoint in_place
	let ret = ${retries};
	var x = if n <= 0 { 1 } else { n };
	var steps = 0;
	while x != 1 && steps < ret {
		if x % 2 == 0 {
			x /= 2;
		} else {
			x = 3 * x + 1;
		}
		steps++;
	}
	x
}
@end
