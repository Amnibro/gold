fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_sum};
	var m = 0;
	for i in g.n {
		var x = g.res[i];
		var dsum = 0;
		var temp = if x < 0 { -x } else { x };
		while temp > 0 {
			dsum += temp % 10;
			temp /= 10;
		}
		if dsum >= min_s {
			g.res[m] = x;
			m++;
		}
	}
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "validated digits each item: ", m);
	out
}
@end
