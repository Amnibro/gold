@entry d9605bdaca78edab
kind: step
verb: fold
noun: evens
modifier: pairwise
context: compare
phrase: fold evens pairwise shift {bias}
phrase: combine even pairs comparing shift {bias}
slot: bias int
test: list=4,8,12,16 bias=3
expect: => i=21 r=0.0 ok=true s="even pairwise fold: 21" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
test: list=10,20,30 bias=5
expect: => i=30 r=0.0 ok=true s="even pairwise fold: 30" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var evens int[64] = [0; 64];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && en < 64 {
			evens[en] = g.res[i];
			en++;
		}
	}
	if en < 2 { return out; }
	var total = 0;
	for k in (en - 1) {
		let diff = evens[k + 1] - evens[k] + b;
		total += diff;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "even pairwise fold: ", total);
	g.steps += g.n + en;
	out
}
@end
