fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x < l || x > h {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	let dropped = g.n - m;
	g.steps += g.n + m;
	g.n = m;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped range: ", dropped);
	out
}
@end
