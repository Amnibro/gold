fn ${ID}(n int) int {
	var val = n;
	if val < 0 {
		val = -val;
	}
	if val == 0 {
		return 0;
	}
	var sum = 0;
	var count = 0;
	var curr = val;
	while curr > 0 {
		sum += curr % 10;
		count++;
		curr = curr / 10;
	}
	var avg = sum / count;
	return avg;
}
