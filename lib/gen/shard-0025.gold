modifier: with_retry
context: transform
phrase: apply function {f} with retry count {retries}
phrase: transform each element with function {f} retries {retries}
slot: f fn
slot: retries int
test: list=2,5 f=double retries=2
expect: => i=2 r=0.0 ok=true s="applied function with retry: 2" errors=0 n=2 res=[8,20] cache=0 hits=0
test: list=3,7 f=square retries=1
expect: => i=2 r=0.0 ok=true s="applied function with retry: 2" errors=0 n=2 res=[9,49] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	for i in g.n {
		var x = g.res[i];
		var k = 0;
		while k < r && x < 500 {
			x = ${f}(x);
			k++;
		}
		g.res[i] = x;
	}
	g.steps += g.n * r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied function with retry: ", g.n);
	out
}
@end
