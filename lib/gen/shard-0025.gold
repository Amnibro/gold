test: list=10,20,30,40,50,60 group_size=3
expect: => i=2 r=0.0 ok=true s="averaged groups count: 2" errors=0 n=2 res=[20,50] cache=0 hits=0
test: list=5,15,25,35 group_size=2
expect: => i=2 r=0.0 ok=true s="averaged groups count: 2" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gs = ${group_size};
	if gs <= 0 || g.n % gs != 0 {
		gold_fail(g, "unaligned group size error");
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		var sum_grp = 0;
		for k in gs { sum_grp += g.res[idx + k]; }
		g.res[new_n] = sum_grp / gs;
		new_n++;
		idx += gs;
	}
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "averaged groups count: ", new_n);
	out
}
@end
