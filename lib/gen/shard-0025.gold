@entry 508d2c02aff5506a
kind: step
verb: search
noun: number
modifier: with_retry
context: search
phrase: search number with retry target {target} attempts {attempts}
phrase: locate number with retry query {target} count {attempts}
slot: target int
slot: attempts int
test: list=10,20,30,40 target=30 attempts=2
expect: => i=2 r=0.0 ok=true s="found at index: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20,30,40 target=25 attempts=2
expect: => i=-1 r=0.0 ok=false s="target not found" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_att = ${attempts};
	var found = false;
	var pos = -1;
	var delta = 0;
	while delta < max_att && !found {
		for i in g.n {
			let diff = g.res[i] - tgt;
			var abs_d = diff;
			if abs_d < 0 { abs_d = -abs_d; }
			if abs_d <= delta {
				pos = i;
				found = true;
				break;
			}
		}
		delta++;
	}
	g.steps += delta;
	out.ok = found;
	out.i = pos;
	out.s.clear();
	if found {
		format(out.s, "found at index: ", pos);
	} else {
		format(out.s, "target not found");
	}
	out
}
@end
@entry 4be53dd7bf1b4d4b
kind: step
verb: rotate
noun: numbers
modifier: all
context: search
phrase: rotate numbers all entries forward {steps}
phrase: cycle numbers all positions shift {steps}
slot: steps int
test: list=10,20,30,40 steps=1
expect: => i=40 r=0.0 ok=true s="rotated first element: 40" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 steps=3
expect: => i=3 r=0.0 ok=true s="rotated first element: 3" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n > 1 {
		var k = s % g.n;
		while k < 0 { k += g.n; }
		for rep in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated first element: ", out.i);
	out
}
@end
@entry 192a2349b76a744a
kind: step
verb: join
noun: runs
modifier: up_to
context: search
phrase: join runs up to span limit {max_len}
phrase: compress runs up to length ceiling {max_len}
slot: max_len int
test: list=2,2,2,3,3,4 max_len=2
expect: => i=4 r=0.0 ok=true s="joined runs count: 4" errors=0 n=4 res=[4,2,6,4] cache=0 hits=0
test: list=5,5,5,5,1 max_len=3
expect: => i=3 r=0.0 ok=true s="joined runs count: 3" errors=0 n=3 res=[15,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var buf = [0; 512];
	var bn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var run_sum = x;
		var rlen = 1;
		while i + 1 < g.n && g.res[i + 1] == x && rlen < ml {
			i++;
			run_sum += g.res[i];
			rlen++;
		}
		buf[bn] = run_sum;
		bn++;
		i++;
	}
	g.n = 0;
	for j in bn {
		gold_push(g, buf[j]);
	}
	g.steps += bn;
	out.i = bn;
