test: list=1,2,5,3,4
expect: => i=3 r=0.0 ok=true s="longest sorted streak 3" errors=0 n=5 res=[1,2,5,3,4] cache=0 hits=0
test: list=9,8,7
expect: => i=1 r=0.0 ok=true s="longest sorted streak 1" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for k in 1..g.n {
		if g.res[k] >= g.res[k - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest sorted streak ", max_streak);
	out
}
@end
