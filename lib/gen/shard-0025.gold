code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${a} <= 0.0 {
		gold_fail(g, "invalid size");
		out.ok = false;
		return out;
	}
	var o byte[>..] = [];
	gold_dnews(g, "lava", "", o);
	o.append(" box ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" ");
	gold_fnum(o, ${a});
	o.append(",");
	gold_fnum(o, ${a});
	o.append(",");
	gold_fnum(o, ${a} * 0.02);
	o.append(" m:glow ");
	gold_hex(o, 220, 60, 20);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "lava");
	out
}
@end
