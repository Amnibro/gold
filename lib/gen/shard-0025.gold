			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " results divisible by ", f);
	out
}
@end
@entry 910a3a357119fd28
kind: step
verb: search
noun: histogram
modifier: sorted
context: math
slot: min_freq int
phrase: search histogram sorted frequencies exceeding {min_freq}
phrase: find histogram sorted occurrences meeting {min_freq}
test: list=2,2,3,3,3,4 min_freq=2
expect: => i=2 r=0.0 ok=true s="found 2 frequent histogram values" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,5,6,7,7 min_freq=3
expect: => i=1 r=0.0 ok=true s="found 1 frequent histogram values" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_freq};
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in kept {
			if g.res[j] == x { seen_before = true; break; }
		}
		if !seen_before {
			var freq = 0;
			for k in g.n {
				if g.res[k] == x { freq++; }
			}
			if freq >= req {
				g.res[kept] = x;
				kept++;
			}
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " frequent histogram values");
	out
}
@end
