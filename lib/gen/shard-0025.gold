expect: 25
code:
fn ${ID}(n int) int {
	let r = ${ratio};
	var x = if n < 0 { -n } else { n };
	var total = 0;
	var current_gap = 0;
	var saw_bit = false;
	while x > 0 {
		if (x & 1) != 0 {
			if saw_bit && current_gap > 0 {
				total += current_gap * r;
			}
			saw_bit = true;
			current_gap = 0;
		} else {
			if saw_bit {
				current_gap++;
			}
		}
		x = x >> 1;
	}
	total
}
@end
