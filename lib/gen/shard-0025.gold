kind: step
verb: pair
noun: primes
modifier: recursively
context: error
slot: min_pairs int
phrase: pair primes recursively demand {min_pairs}
phrase: link prime elements recursively requiring {min_pairs}
test: list=2,3,5,7 min_pairs=2
expect: => i=2 r=0.0 ok=true s="paired primes count: 2" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8,9 min_pairs=1
expect: => i=0 r=0.0 ok=false s="error: prime pairs 0 below 1" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if (n % 2) == 0 || (n % 3) == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if (n % i) == 0 || (n % (i + 2)) == 0 { return false; }
		i += 6;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_pairs};
	var prime_indices int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			prime_indices[pn] = k;
			pn++;
		}
	}
	g.steps += g.n;
	let pairs = pn / 2;
	if pairs < req {
		gold_fail(g, "insufficient prime pairs");
		out.ok = false;
		out.i = pairs;
		out.s.clear();
		format(out.s, "error: prime pairs ", pairs, " below ", req);
		return out;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired primes count: ", pairs);
	out
}
@end
