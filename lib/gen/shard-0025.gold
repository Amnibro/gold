noun: histogram
modifier: recursively
context: aggregate
slot: cut int
phrase: compare histogram recursively against threshold {cut}
phrase: evaluate recursive frequency counts with cutoff {cut}
test: list=1,1,2,2,2,3 cut=2
expect: => i=5 r=0.0 ok=true s="histogram matches: 5" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=5,5,5,6,7 cut=1
expect: => i=5 r=0.0 ok=true s="histogram matches: 5" errors=0 n=5 res=[5,5,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${cut};
	var heavy_bins = 0;
	var i = 0;
	while i < g.n {
		var count = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
			j++;
		}
		if count >= cutoff {
			heavy_bins++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = heavy_bins;
	out.s.clear();
	format(out.s, "histogram matches: ", heavy_bins);
	out
}
@end
