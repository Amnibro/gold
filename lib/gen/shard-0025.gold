fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	let s = ${shift};
	if w > 1 && g.n >= w {
		for rep in s {
			let first = g.res[0];
			for i in w - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[w - 1] = first;
		}
	}
	g.steps += w * s;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "window rotated head: ", out.i);
	out
}
@end
