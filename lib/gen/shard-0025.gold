expect: => i=256 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.172 max=0.957 sum8=35520 hash=178439
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.074 max=0.905 sum8=134007 hash=965685
