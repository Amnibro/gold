fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	let w = words(out.s);
	var count = 0;
	for i in w.len {
		if w[i].len <= ml { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "short words matched: ", count);
	g.steps += w.len;
	out
}
@end
@entry 359b7e57b97f7071
kind: step
verb: repeat
noun: minimum
modifier: with_cache
context: compare
phrase: repeat minimum with cache count {copies}
phrase: replicate minimum value with cache {copies}
slot: copies int
test: list=25,12,40,8,30 copies=3
expect: => i=8 r=0.0 ok=true s="replicated minimum: 8" errors=0 n=8 res=[25,12,40,8,30,8,8,8] cache=1 hits=0
test: list=7,15,3,9 copies=2
expect: => i=3 r=0.0 ok=true s="replicated minimum: 3" errors=0 n=6 res=[7,15,3,9,3,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${copies};
	if g.n == 0 || c <= 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	gold_cache_put(g, min_val, c);
	for k in c {
		if g.n < 512 { gold_push(g, min_val); }
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "replicated minimum: ", min_val);
	g.steps += g.n + c;
	out
}
@end
