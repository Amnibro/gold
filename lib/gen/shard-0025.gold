@entry bf6e682851d2ec76
kind: step
verb: scale
noun: streak
modifier: sorted
context: sort
phrase: scale longest identical streak multiplier {mult}
phrase: multiply longest sorted streak by factor {mult}
slot: mult int
test: list=3,1,3,3,2 mult=4
expect: => i=3 r=0.0 ok=true s="longest sorted streak: 3" errors=0 n=5 res=[4,8,12,12,12] cache=0 hits=0
test: list=5,5,2,5 mult=2
expect: => i=3 r=0.0 ok=true s="longest sorted streak: 3" errors=0 n=4 res=[4,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var cur_streak = 1;
	var max_streak = 1;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] {
				cur_streak++;
				if cur_streak > max_streak { max_streak = cur_streak; }
			} else {
				cur_streak = 1;
			}
		}
	}
	for i in g.n {
		g.res[i] = g.res[i] * m;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest sorted streak: ", max_streak);
	out
}
@end
