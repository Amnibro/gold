phrase: order checkpoint items nested stride {step}
slot: step int
test: list=50,10,40,20,30 step=2
expect: => i=10 r=0.0 ok=true s="sorted checkpoint head: 10" errors=0 n=5 res=[10,50,40,20,30] cache=0 hits=0
test: list=9,1,7,3,5 step=3
expect: => i=1 r=0.0 ok=true s="sorted checkpoint head: 1" errors=0 n=5 res=[1,7,9,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n <= 1 || s <= 0 { return out; }
	let limit = if s < g.n { s } else { g.n };
	for i in limit {
		var min_idx = i;
		for j in (i + 1)..limit {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted checkpoint head: ", out.i);
	g.steps += limit * limit;
	out
}
@end
@entry b9b3251f23e294bf
kind: step
verb: sort
noun: primes
modifier: until
context: compare
phrase: sort primes until limit {cap}
phrase: order prime elements under {cap}
slot: cap int
test: list=13,4,7,9,5,2 cap=20
expect: => i=6 r=0.0 ok=true s="sorted primes under cap" errors=0 n=6 res=[2,4,5,9,7,13] cache=0 hits=0
test: list=11,6,3,8,2 cap=15
expect: => i=5 r=0.0 ok=true s="sorted primes under cap" errors=0 n=5 res=[2,6,3,8,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	for i in g.n {
		for j in (i + 1)..g.n {
			let a = g.res[i];
			let b = g.res[j];
			var a_prime = a >= 2;
			var d = 2;
			while d * d <= a { if a % d == 0 { a_prime = false; break; } d++; }
			var b_prime = b >= 2;
			d = 2;
			while d * d <= b { if b % d == 0 { b_prime = false; break; } d++; }
			if a_prime && b_prime && a < c && b < c && b < a {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted primes under cap");
	g.steps += g.n * g.n;
	out
}
@end
