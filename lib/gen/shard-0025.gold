expect: => i=3 r=0.0 ok=true s="spaces clamped: 3" errors=0 n=4 res=[2,14,26,38] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var clamped = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let idx = i + 1;
			let gap = g.res[idx] - g.res[idx - 1];
			if gap > mg {
				g.res[idx] = g.res[idx - 1] + mg;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "spaces clamped: ", clamped);
	out
}
@end
