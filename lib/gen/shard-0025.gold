@entry 53b6d64d18ae5aae
kind: step
verb: shift
noun: minimum
modifier: running
context: aggregate
slot: delta int
phrase: shift minimum running prefix values by {delta}
phrase: offset running cumulative minimums by amount {delta}
test: list=10,8,6,9,4 delta=3
expect: => i=5 r=0.0 ok=true s="shifted running minimums: 5" errors=0 n=5 res=[13,11,9,9,7] cache=0 hits=0
test: list=20,15,18,12 delta=5
expect: => i=4 r=0.0 ok=true s="shifted running minimums: 4" errors=0 n=4 res=[25,20,20,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let offset = ${delta};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		g.res[i] = min_val + offset;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted running minimums: ", g.n);
	out
}
@end
