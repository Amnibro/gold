fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 && g.n < 512 {
		let pad_val = if g.n > 0 { g.res[g.n - 1] } else { 0 };
		gold_push(g, pad_val);
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "filled pairs none pad: ", out.i);
	out
}
@end
