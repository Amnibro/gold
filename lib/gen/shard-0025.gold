		let first = g.res[0];
		for i in g.n - 1 { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted condition rotated: ", g.n);
	out
}
