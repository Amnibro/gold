@entry 27b0e1f281d6898c
kind: step
verb: dedupe
noun: words
modifier: recursively
context: compare
phrase: dedupe words recursively limit {cap}
phrase: filter duplicate words recursively {cap}
slot: cap int
test: text="red blue red green blue yellow red" cap=5
expect: => i=4 r=0.0 ok=true s="red blue green yellow" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two one three two four" cap=4
expect: => i=4 r=0.0 ok=true s="one two three four" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	let w = words(out.s);
	var count = 0;
	out.s.clear();
	for i in w.len {
		if count >= cp { break; }
		let word = w[i];
		var seen = false;
		for j in i {
			if w[j] == word { seen = true; break; }
		}
		if !seen {
			if count > 0 { out.s.push(' '); }
			out.s.append(word);
			count++;
		}
	}
	out.i = count;
	g.steps += w.len * count;
	out
}
@end
@entry 6dad6c879d059bd7
kind: step
verb: fold
noun: item
modifier: recursively
context: compare
phrase: fold item recursively comparing base {base}
phrase: reduce items recursively comparing base {base}
slot: base int
test: list=12,5,18,3 base=10
expect: => i=8 r=0.0 ok=true s="folded recursive base: 8" errors=0 n=4 res=[12,5,18,3] cache=0 hits=0
test: list=20,15,40 base=25
expect: => i=29 r=0.0 ok=true s="folded recursive base: 29" errors=0 n=3 res=[20,15,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	if g.n == 0 { return out; }
	var acc = b;
	for i in g.n {
		let x = g.res[i];
		acc = if x > acc { acc + (x - acc) / 2 } else { acc - (acc - x) / 2 };
	}
	out.i = acc;
	out.s.clear();
	format(out.s, "folded recursive base: ", acc);
	g.steps += g.n * 2;
	out
}
@end
@entry 8f5a346017eb87b7
kind: step
verb: join
noun: value
modifier: with_retry
context: compare
phrase: join value with retry passes {attempts}
phrase: merge values with retry cycles {attempts}
slot: attempts int
test: list=10,20,5,15,30 attempts=2
expect: => i=3 r=0.0 ok=true s="merged pairs: 3" errors=0 n=2 res=[30,50] cache=0 hits=0
test: list=4,8,2,6 attempts=1
expect: => i=2 r=0.0 ok=true s="merged pairs: 2" errors=0 n=2 res=[12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	if g.n < 2 { return out; }
	var merged = 0;
	for p in att {
		var w = 0;
		var i = 0;
		while i < g.n {
			if i + 1 < g.n && g.res[i + 1] > g.res[i] {
				g.res[w] = g.res[i] + g.res[i + 1];
				w++;
				merged++;
				i += 2;
			} else {
				g.res[w] = g.res[i];
				w++;
				i++;
			}
		}
		g.n = w;
	}
	out.i = merged;
	out.s.clear();
	format(out.s, "merged pairs: ", merged);
	g.steps += att * g.n;
	out
}
@end
