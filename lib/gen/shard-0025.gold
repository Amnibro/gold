test: list=5,3,5,2,3,8 passes=2
expect: => i=4 r=0.0 ok=true s="deduped count: 4" errors=0 n=4 res=[5,3,2,8] cache=0 hits=0
test: list=1,1,1,2,2 passes=1
expect: => i=2 r=0.0 ok=true s="deduped count: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var unq = [0; 512];
	var un = 0;
	for pass_idx in p {
		un = 0;
		for i in g.n {
			let x = g.res[i];
			var seen = false;
			for j in un {
				if unq[j] == x { seen = true; break; }
			}
			if !seen {
				unq[un] = x;
				un++;
			}
		}
	}
	g.n = 0;
	for i in un {
		gold_push(g, unq[i]);
	}
	g.steps += un * p;
	out.i = un;
	out.s.clear();
	format(out.s, "deduped count: ", un);
	out
}
@end
