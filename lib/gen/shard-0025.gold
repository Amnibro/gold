kind: step
verb: reverse
noun: threshold
modifier: unique
context: sort
phrase: reverse threshold unique boundary {threshold} across list
phrase: invert threshold unique cutoff {threshold} in array
slot: threshold int
test: list=8,2,5,8,3,5 threshold=4
expect: => i=2 r=0.0 ok=true s="unique reversed: 2" errors=0 n=4 res=[2,3,8,5] cache=0 hits=0
test: list=10,3,7,3,1 threshold=5
expect: => i=2 r=0.0 ok=true s="unique reversed: 2" errors=0 n=4 res=[1,3,10,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var u = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[u - 1] {
			g.res[u] = g.res[k];
			u++;
		}
	}
	g.n = u;
	var split_idx = g.n;
	for k in g.n {
		if g.res[k] >= thresh {
			split_idx = k;
			break;
		}
	}
	var l = split_idx;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = g.n - split_idx;
	out.s.clear();
	format(out.s, "unique reversed: ", out.i);
	g.steps += g.n * 2;
	out
}
@end
