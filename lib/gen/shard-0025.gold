kind: step
verb: dedupe
noun: sequence
modifier: between
context: search
phrase: dedupe sequence between range min {low} max {high}
phrase: unique sequence between bounds bottom {low} top {high}
slot: low int
slot: high int
test: list=2,5,5,8,8,12 low=4 high=10
expect: => i=4 r=0.0 ok=true s="sequence kept: 4" errors=0 n=4 res=[2,5,8,12] cache=0 hits=0
test: list=3,3,7,9,9,15 low=10 high=20
expect: => i=6 r=0.0 ok=true s="sequence kept: 6" errors=0 n=6 res=[3,3,7,9,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		let x = g.res[i];
		var keep = true;
		if x >= lo && x <= hi && bn > 0 {
			if buf[bn - 1] == x {
				keep = false;
			}
		}
		if keep {
			buf[bn] = x;
			bn++;
		}
	}
	g.n = 0;
	for i in bn {
		gold_push(g, buf[i]);
	}
	g.steps += bn;
	out.i = bn;
	out.s.clear();
	format(out.s, "sequence kept: ", bn);
	out
}
@end
@entry 9f7733e8701a21cd
kind: step
verb: clamp
noun: step
modifier: running
context: search
phrase: clamp step running difference ceiling {max_step}
phrase: bound step running delta limit {max_step}
slot: max_step int
test: list=10,25,45,50 max_step=10
expect: => i=3 r=0.0 ok=true s="running steps clamped: 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,20,22,40 max_step=8
expect: => i=3 r=0.0 ok=true s="running steps clamped: 3" errors=0 n=4 res=[5,13,21,29] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var adjusted = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let idx = i + 1;
			let prev = g.res[idx - 1];
			let cur = g.res[idx];
			let diff = cur - prev;
			if diff > ms {
				g.res[idx] = prev + ms;
				adjusted++;
			} else if diff < -ms {
				g.res[idx] = prev - ms;
				adjusted++;
			}
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "running steps clamped: ", adjusted);
	out
}
@end
