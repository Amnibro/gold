@entry 8e3d47ad5fc72274
kind: step
verb: dedupe
noun: odds
modifier: last
context: math
phrase: dedupe odds last occurrences across collection
phrase: prune odds last keeping final duplicate instances
test: list=3,5,3,7,5
expect: => i=3 r=0.0 ok=true s="preserved 3 elements with final odds" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=1,3,1,1,5,3
expect: => i=3 r=0.0 ok=true s="preserved 3 elements with final odds" errors=0 n=3 res=[1,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let is_odd = (x % 2 != 0);
		var keep = true;
		if is_odd {
			var j = i + 1;
			while j < g.n {
				if g.res[j] == x { keep = false; break; }
				j++;
			}
		}
		if keep {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "preserved ", kept, " elements with final odds");
	out
}
@end
@entry 13d34714d08e055c
