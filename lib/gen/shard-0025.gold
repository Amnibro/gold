test: list=1,2,3,4,5,6,7,8 offset=2
expect: => i=4 r=0.0 ok=true s="rotated head every other: 4" errors=0 n=8 res=[5,2,7,4,1,6,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_val = ${offset};
	if g.n < 4 { return out; }
	var evens int[256] = [0; 256];
	var count = 0;
	var i = 0;
	while i < g.n {
		evens[count] = g.res[i];
		count++;
		i += 2;
	}
	let shift = (step_val % count + count) % count;
	var rotated int[256] = [0; 256];
	for k in count {
		rotated[(k + shift) % count] = evens[k];
	}
	i = 0;
	var k = 0;
	while i < g.n {
		g.res[i] = rotated[k];
		k++;
		i += 2;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "rotated head every other: ", count);
	out
}
@end
