expect: => i=2 r=0.0 ok=true s="counter between range: 2" errors=0 n=6 res=[3,5,12,18,20,2] cache=0 hits=0
test: list=8,2,14,6,10 min_val=5 max_val=9
expect: => i=2 r=0.0 ok=true s="counter between range: 2" errors=0 n=6 res=[2,6,8,10,14,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi { count++; }
	}
	gold_push(g, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counter between range: ", count);
	out
}
@end
