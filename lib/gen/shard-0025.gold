@entry 961247bb943c8a7e
kind: step
verb: merge
noun: suffix
modifier: up_to
context: core
phrase: merge suffix items up to length {len}
phrase: consolidate trailing elements up to size {len}
slot: len int
test: list=1,2,3,4,5 len=3
expect: => i=12 r=0.0 ok=true s="merged suffix sum 12" errors=0 n=3 res=[1,2,12] cache=0 hits=0
test: list=10,20 len=2
expect: => i=30 r=0.0 ok=true s="merged suffix sum 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	if l <= 1 || g.n < l {
		out.i = 0;
		return out;
	}
	let start = g.n - l;
	var sum = 0;
	for k in start..g.n { sum += g.res[k]; }
	g.res[start] = sum;
	g.n = start + 1;
	g.steps += l;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged suffix sum ", sum);
	out
}
@end
@entry 3b03ae4d873c4260
kind: step
verb: reverse
noun: suffix
modifier: between
context: core
phrase: reverse suffix between last {count} items
phrase: invert trailing sequence across {count} elements
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed 3 suffix items" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="reversed 2 suffix items" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 1 || g.n < c {
		out.i = 0;
		return out;
	}
	var left = g.n - c;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "reversed ", c, " suffix items");
	out
}
@end
