test: list=20,40,60 max_avg=30
expect: => i=1 r=0.0 ok=true s="scaling passes: 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,100,150 max_avg=50
expect: => i=1 r=0.0 ok=true s="scaling passes: 1" errors=0 n=3 res=[25,50,75] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${max_avg};
	if g.n == 0 { return out; }
	var passes = 0;
	while passes < 5 {
		var sum = 0;
		var i = 0;
		while i < g.n {
			sum += g.res[i];
			i++;
		}
		let avg = sum / g.n;
		if avg <= mx { break; }
		var j = 0;
		while j < g.n {
			g.res[j] = g.res[j] / 2;
			j++;
		}
		passes++;
	}
	g.steps += passes + g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "scaling passes: ", passes);
	out
}
@end
