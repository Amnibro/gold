expect: => i=15 r=0.0 ok=true s="pair product sum: 15" errors=0 n=4 res=[6,2,3,1] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var total = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			let prod = g.res[i] * g.res[i + 1];
			gold_cache_put(g, b + i, prod);
			total += prod;
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "pair product sum: ", total);
	out
}
@end
@entry 463ff73a3301d374
kind: step
verb: sort
noun: maximum
modifier: at_least
context: search
phrase: sort maximum at least threshold {floor}
phrase: order maximum at least baseline {floor}
slot: floor int
test: list=5,25,12,30,8 floor=15
expect: => i=2 r=0.0 ok=true s="sorted above floor: 2" errors=0 n=5 res=[30,25,12,8,5] cache=0 hits=0
test: list=3,7,2,9 floor=5
expect: => i=2 r=0.0 ok=true s="sorted above floor: 2" errors=0 n=4 res=[9,7,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var count = 0;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] < g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		if g.res[i] >= fl { count++; }
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted above floor: ", count);
	out
}
@end
