kind: step
verb: crack
noun: bark
modifier: none
context: texture
phrase: render cracked bark fissures with seed {u}
phrase: carve rough timber bark fissures from seed {u}
slot: u int
model: fbm n=2 c=8 u=${u}; contrast a=1.4; quantize n=4
test: img=16 u=4
expect: => i=256 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.667 sum8=21335 hash=419016
test: img=32 u=9
expect: => i=1024 r=0.0 ok=true s="bark" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=132090 hash=457946
test: u=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out_01 = v;
	if !gold_img_ok(g) { out_01.ok = false; return out_01; }
	var sp_01 = 8;
	for oct_01 in 2 { if !gold_img_square(g, sp_01) { out_01.ok = false; return out_01; } sp_01 = sp_01 / 2; }
	for y in g.ih {
		for x in g.iw {
			var acc_01 = 0.0;
			var wt_01 = 1.0;
			var tot_01 = 0.0;
			var cc_01 = 8;
			for oct_01 in 2 { acc_01 += wt_01 * gold_vnoise(x, y, cc_01, g.iw / cc_01, ${u} + oct_01); tot_01 += wt_01; wt_01 *= 0.5; cc_01 = cc_01 / 2; }
			g.img[y * g.iw + x] = acc_01 / tot_01;
		}
	}
	for k_01 in g.iw * g.ih { g.img[k_01] = gold_clamp01((g.img[k_01] - 0.5) * 1.4 + 0.5); }
	if 4 < 2 || 4 > 16 { gold_fail(g, "levels out of range"); out_01.ok = false; return out_01; }
	for k_01 in g.iw * g.ih {
		var q_01 = (g.img[k_01] * (4 as real)) as! int;
		if q_01 > 4 - 1 { q_01 = 4 - 1; }
		g.img[k_01] = (q_01 as real) / ((4 - 1) as real);
	}
	out_01.i = g.iw * g.ih;
	out_01.s.clear();
	format(out_01.s, "bark");
	out_01
}
@end
