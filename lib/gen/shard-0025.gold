test: list=2,5,8 thresh=4 factor=2
expect: => i=2 r=0.0 ok=true s="scaled 2 items above threshold" errors=0 n=3 res=[2,10,16] cache=0 hits=0
test: list=10,20 thresh=50 factor=3
expect: => i=0 r=0.0 ok=true s="scaled 0 items above threshold" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	let fac = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] > th {
			g.res[i] = g.res[i] * fac;
			count++;
		}
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " items above threshold");
	out
}
@end
@entry 781c371c3a6bced0
kind: step
verb: shift
noun: memo
modifier: times
context: sort
phrase: shift memo times cyclically shifting cache by {steps}
phrase: rotate cached keys right by {steps}
phrase: cyclically permute cache entries by {steps}
slot: steps int
test: list=10,20,30 steps=1
expect: => i=3 r=0.0 ok=true s="memo cache shifted 3 entries" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15 steps=2
expect: => i=2 r=0.0 ok=true s="memo cache shifted 2 entries" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	if g.cn > 1 && s > 0 {
		var rot = s % g.cn;
		while rot > 0 {
			let last_k = g.ck[g.cn - 1];
			let last_v = g.cv[g.cn - 1];
			var j = g.cn - 1;
			while j > 0 {
				g.ck[j] = g.ck[j - 1];
				g.cv[j] = g.cv[j - 1];
				j--;
			}
			g.ck[0] = last_k;
			g.cv[0] = last_v;
			rot--;
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "memo cache shifted ", g.cn, " entries");
	out
}
@end
