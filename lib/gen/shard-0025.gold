phrase: tally sorted elements until sum hits target {target}
slot: target int
test: list=7,2,5,1,9 target=12
expect: => i=4 r=0.0 ok=true s="numbers until target: 4" errors=0 n=5 res=[1,2,5,7,9] cache=0 hits=0
