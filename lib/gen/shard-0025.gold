fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var gap = 0;
	if g.n >= 2 {
		gap = (g.res[1] - g.res[0]) * fac;
		g.res[0] += gap;
	}
	out.i = gap;
	out.s.clear();
	format(out.s, "scaled space: ", gap);
	g.steps += g.n;
	out
}
@end
