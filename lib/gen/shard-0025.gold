expect: => i=3 r=0.0 ok=true s="found target at attempt: 3" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=5,10,15,20 target=99 max_tries=4
expect: => i=4 r=0.0 ok=false s="error: target 99 not found in 4 tries" errors=1 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cap = ${max_tries};
	var found = false;
	var tries = 0;
	for k in g.n {
		tries++;
		if g.res[k] == tgt {
			found = true;
			break;
		}
		if tries >= cap { break; }
	}
	g.steps += tries;
	if !found {
		gold_fail(g, "target item not found between bounds");
		out.ok = false;
		out.i = tries;
		out.s.clear();
		format(out.s, "error: target ", tgt, " not found in ", tries, " tries");
		return out;
	}
	out.i = tries;
	out.s.clear();
	format(out.s, "found target at attempt: ", tries);
	out
}
@end
