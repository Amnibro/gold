@entry fa7bc89d72f42f1a
kind: step
verb: dedupe
noun: squares
modifier: in_reverse
context: search
phrase: dedupe squares in reverse limit {bound}
phrase: prune squares in reverse ceiling {bound}
slot: bound int
test: list=4,9,4,16,9,25 bound=30
expect: => i=4 r=0.0 ok=true s="unique squares preserved: 4" errors=0 n=4 res=[4,16,9,25] cache=0 hits=0
test: list=1,4,1,4,9 bound=10
expect: => i=3 r=0.0 ok=true s="unique squares preserved: 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	var seen_sq = [0; 512];
	var sn = 0;
	var keep = [true; 512];
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if x <= bnd && core_is_square(x) {
			var dup = false;
			for j in sn {
				if seen_sq[j] == x { dup = true; break; }
			}
			if dup {
				keep[idx] = false;
			} else {
				seen_sq[sn] = x;
				sn++;
			}
		}
		idx--;
	}
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		if keep[i] {
			buf[bn] = g.res[i];
			bn++;
		}
	}
	g.n = 0;
	for i in bn {
		gold_push(g, buf[i]);
	}
	g.steps += g.n + bn;
	out.i = sn;
	out.s.clear();
	format(out.s, "unique squares preserved: ", sn);
	out
}
@end
