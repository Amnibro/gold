kind: step
verb: return
noun: limit
modifier: safely
context: compare
phrase: return limit safely ceiling {cutoff}
phrase: produce maximum safely bounded {cutoff}
slot: cutoff int
test: list=10,45,25,80,30 cutoff=50
expect: => i=45 r=0.0 ok=true s="safely bounded maximum: 45" errors=0 n=5 res=[10,45,25,80,30] cache=0 hits=0
test: list=90,70,60 cutoff=50
expect: => i=0 r=0.0 ok=false s="error: no item within limit" errors=1 n=3 res=[90,70,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var max_val = -999999;
	var found = false;
	for i in g.n {
		if g.res[i] <= cut {
			if !found || g.res[i] > max_val {
				max_val = g.res[i];
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no item within limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: no item within limit");
		return out;
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "safely bounded maximum: ", max_val);
	g.steps += g.n;
	out
}
@end
