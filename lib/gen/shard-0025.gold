@entry cee54ffd1b8b4359
kind: step
verb: drop
noun: minimum
modifier: while
context: sort
phrase: drop minimum while values are below {limit}
phrase: remove smallest sorted elements while under {limit}
phrase: prune leading items while less than {limit}
slot: limit int
test: list=3,15,8,1,20 limit=10
expect: => i=3 r=0.0 ok=true s="dropped 3 items below limit" errors=0 n=2 res=[15,20] cache=0 hits=0
test: list=12,24,36 limit=5
expect: => i=0 r=0.0 ok=true s="dropped 0 items below limit" errors=0 n=3 res=[12,24,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var start = 0;
	while start < g.n && g.res[start] < lim {
		start++;
	}
	let dropped = start;
	let remaining = g.n - start;
	for i in remaining {
		g.res[i] = g.res[start + i];
	}
	g.n = remaining;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items below limit");
	out
}
@end
@entry 5a1864cfdf07faae
kind: step
verb: limit
noun: checkpoint
modifier: any
context: sort
phrase: limit checkpoint any elements exceeding ceiling {ceiling}
phrase: clamp sorted items to ceiling {ceiling}
phrase: cap values in sorted sequence at {ceiling}
slot: ceiling int
test: list=10,25,50,5,15 ceiling=20
expect: => i=2 r=0.0 ok=true s="clamped 2 items to ceiling" errors=0 n=5 res=[5,10,15,20,20] cache=0 hits=0
test: list=5,10,15 ceiling=30
expect: => i=0 r=0.0 ok=true s="clamped 0 items to ceiling" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ceil_val {
			g.res[i] = ceil_val;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " items to ceiling");
	out
}
@end
@entry cd221dcfb112383c
kind: step
verb: sum
noun: digits
modifier: all
context: sort
phrase: sum digits all across sorted items
phrase: total sum of all digits in sorted list
phrase: accumulate digit values from all sorted elements
test: list=15,24,7
expect: => i=19 r=0.0 ok=true s="total digit sum: 19" errors=0 n=3 res=[7,15,24] cache=0 hits=0
test: list=102,45
expect: => i=12 r=0.0 ok=true s="total digit sum: 12" errors=0 n=2 res=[45,102] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total_digits = 0;
	for i in g.n {
		var val = g.res[i];
		if val < 0 { val = -val; }
		while val > 0 {
			total_digits += val % 10;
			val /= 10;
		}
	}
	g.steps += g.n;
	out.i = total_digits;
	out.s.clear();
	format(out.s, "total digit sum: ", total_digits);
	out
}
@end
@entry 25ffddaf0657e87c
kind: step
verb: group
noun: pairs
modifier: every_other
context: sort
phrase: group pairs every_other alternate adjacent elements
phrase: sum pairwise adjacent alternate items in sorted list
phrase: combine adjacent pairs in sorted order
test: list=5,1,4,2,3
expect: => i=3 r=0.0 ok=true s="grouped into 3 pairwise sums" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="grouped into 2 pairwise sums" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[kept] = g.res[i] + g.res[i + 1];
		kept++;
		i += 2;
	}
	if i < g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped into ", kept, " pairwise sums");
	out
}
@end
@entry 4eda4b0238a1ea2b
kind: step
verb: group
noun: counter
modifier: until
context: sort
phrase: group counter until target sum {target} is reached
phrase: accumulate sorted counter until sum reaches {target}
phrase: collect sorted prefix until threshold total {target}
slot: target int
test: list=10,2,5,8,12 target=15
expect: => i=3 r=0.0 ok=true s="accumulated 3 items reaching sum 15" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=3,4,5 target=25
expect: => i=3 r=0.0 ok=true s="accumulated 3 items reaching sum 12" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	var count = 0;
	while count < g.n && sum < tgt {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "accumulated ", count, " items reaching sum ", sum);
	out
}
@end
