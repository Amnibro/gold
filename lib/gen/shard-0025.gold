expect: => i=0 r=0.0 ok=true s="scanned index: 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for i in g.n {
		if g.res[i] == tgt { found = i; break; }
	}
	if found < 0 {
		for i in g.n {
			if g.res[i] == tgt + 1 || g.res[i] == tgt - 1 {
				found = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "scanned index: ", found);
	out
}
@end
@entry abae8df0f1b8c061
kind: step
verb: swap
noun: runs
modifier: with_cache
context: list
phrase: swap runs with_cache tracking length {target}
phrase: exchange equal runs using cache target {target}
slot: target int
test: list=5,5,9,9,3 target=2
expect: => i=2 r=0.0 ok=true s="runs cached: 2" errors=0 n=5 res=[9,9,5,5,3] cache=2 hits=2
test: list=1,1,1,2,2,2 target=3
expect: => i=2 r=0.0 ok=true s="runs cached: 2" errors=0 n=6 res=[2,2,2,1,1,1] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let rlen = j - i;
		if rlen == tgt {
			gold_cache_put(g, runs, g.res[i]);
			runs++;
		}
		i = j;
	}
	if runs >= 2 {
		var first_val, ok1 = gold_cache_get(g, 0);
		var second_val, ok2 = gold_cache_get(g, 1);
		for k in g.n {
			if g.res[k] == first_val { g.res[k] = second_val; }
			else if g.res[k] == second_val { g.res[k] = first_val; }
		}
	}
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "runs cached: ", runs);
	out
}
@end
