fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for p in g.n {
			for q in g.n - 1 - p {
				if g.res[q] > g.res[q + 1] {
					let tmp = g.res[q];
					g.res[q] = g.res[q + 1];
					g.res[q + 1] = tmp;
				}
			}
