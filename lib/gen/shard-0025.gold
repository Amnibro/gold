	for i in g.n {
		if g.res[i] >= fl {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept results: ", kept);
	out
}
@end
