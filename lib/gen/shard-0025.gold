fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let cap = ${max_val};
	if g.n == 0 {
		gold_fail(g, "empty series cannot scale last");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	let scaled = g.res[g.n - 1] * f;
	g.steps += 1;
	g.res[g.n - 1] = scaled;
	if scaled > cap {
		gold_fail(g, "scaled last element exceeds ceiling");
		out.ok = false;
		out.i = scaled;
		out.s.clear();
		format(out.s, "error: scaled value ", scaled, " exceeds max ", cap);
		return out;
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled last element: ", scaled);
	out
}
@end
