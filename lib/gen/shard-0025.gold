@entry 9afa6960d7de5806
kind: step
verb: rotate
noun: sequence
modifier: any
context: filter
slot: shift int
phrase: rotate sequence any positions by shift {shift}
phrase: cyclic rotate sequence elements by shift {shift}
test: list=10,20,30,40,50 shift=2
expect: => i=2 r=0.0 ok=true s="rotated sequence by shift: 2" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5,6 shift=3
expect: => i=3 r=0.0 ok=true s="rotated sequence by shift: 3" errors=0 n=6 res=[4,5,6,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 { return out; }
	let k = (s % g.n + g.n) % g.n;
	var temp int[512] = [0; 512];
	for i in g.n {
		temp[(i + k) % g.n] = g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	out.i = k;
	out.s.clear();
	format(out.s, "rotated sequence by shift: ", k);
	out
}
@end
