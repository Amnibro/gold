expect: 3
code:
fn ${ID}(n int) int {
	// error domain: merge total up_to
	let ceiling = ${cap};
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	while x > 0 {
		sum += x % 10;
		x /= 10;
	}
	if sum > ceiling { ceiling } else { sum }
}
@end
@entry 5b9922710d2795b8
kind: fn
verb: scan
noun: middle
modifier: at_most
context: error
phrase: scan middle digits at most bound {bound}
phrase: inspect interior digits up to limit {bound}
slot: bound int
test: arg=1892,3456 bound=15
expect: 15
expect: 9
test: arg=789 bound=10
expect: 8
code:
fn ${ID}(n int) int {
	// error domain: scan middle at_most
	let lim = ${bound};
	var x = if n < 0 { -n } else { n };
	var rev int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		rev[len] = x % 10;
		len++;
		x /= 10;
	}
	if len <= 2 { return 0; }
	var mid_sum = 0;
	for i in 1..(len - 1) {
		mid_sum += rev[i];
	}
	if mid_sum > lim { lim } else { mid_sum }
}
@end
@entry eb47a652da07bd31
kind: fn
verb: swap
noun: item
modifier: last
context: error
phrase: swap final digit with leading item
phrase: exchange last position with head value
test: arg=1234,5678
expect: 4231
expect: 8675
test: arg=91
expect: 19
code:
fn ${ID}(n int) int {
	// error domain: swap item last
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var rev int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		rev[len] = x % 10;
		len++;
		x /= 10;
	}
	var d int[16] = [0; 16];
	for i in len {
		d[i] = rev[len - 1 - i];
	}
	let first = d[0];
	d[0] = d[len - 1];
	d[len - 1] = first;
	var res = 0;
	for i in len {
		res = res * 10 + d[i];
	}
	res
}
@end
