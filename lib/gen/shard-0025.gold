phrase: filter checkpoint values in nested depth {depth}
phrase: screen checkpoint records across nested level {depth}
slot: depth int
test: list=9,14,18,21,25 depth=3
expect: => i=3 r=0.0 ok=true s="checkpoint nested kept: 3" errors=0 n=3 res=[9,18,21] cache=3 hits=0
test: list=8,15,20,28,35 depth=4
expect: => i=3 r=0.0 ok=true s="checkpoint nested kept: 3" errors=0 n=3 res=[8,20,28] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if (x % d) == 0 {
			gold_cache_put(g, kept, x);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "checkpoint nested kept: ", kept);
	out
}
@end
@entry 13b973cb421d092f
kind: step
verb: clamp
noun: runs
modifier: at_least
context: cache
phrase: clamp runs values ensuring at least {floor}
phrase: bound runs counts to at least {floor}
slot: floor int
test: list=5,12,3,18 floor=8
expect: => i=46 r=0.0 ok=true s="runs clamped total: 46" errors=0 n=4 res=[8,12,8,18] cache=4 hits=0
test: list=2,15,6,22 floor=10
expect: => i=57 r=0.0 ok=true s="runs clamped total: 57" errors=0 n=4 res=[10,15,10,22] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		let clamped = if x < fl { fl } else { x };
		gold_cache_put(g, i, clamped);
		g.res[i] = clamped;
		total += clamped;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "runs clamped total: ", total);
	out
}
@end
