	var k = ${count};
	if k <= 0 && g.n > 0 { k = 1; }
	if k > g.n { k = g.n; }
	let start = g.n - k;
	var i = 0;
	while i < k {
		g.res[i] = g.res[start + i];
		i++;
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "kept suffix count: ", k);
