fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${limit} < g.n { ${limit} } else { g.n };
	if k > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < k {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[k - 1] = first;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated series up to: ", k);
	out
}
