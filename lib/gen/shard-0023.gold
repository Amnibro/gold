code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs int[256] = [0; 256];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var p1 = true;
		if a < 2 { p1 = false; }
		else {
			var d = 2;
			while d * d <= a {
				if a % d == 0 { p1 = false; break; }
				d++;
			}
		}
		var p2 = true;
		if b < 2 { p2 = false; }
		else {
			var d = 2;
			while d * d <= b {
				if b % d == 0 { p2 = false; break; }
				d++;
			}
		}
		if p1 && p2 {
			pairs[pn] = a + b;
			pn++;
		}
		i++;
	}
	var j = 0;
	while j < pn {
		g.res[j] = pairs[j];
		j++;
	}
	g.n = pn;
	g.steps += g.n + pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "mapped pairwise primes: ", pn);
	out
}
@end
