	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:metal");
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "bore", "", o);
	o.append(" cyl 0,0,-");
	o.append("0.0");
	o.append("01 ");
	o.append("0,0,");
	gold_fnum(o, ${h} + 0.002);
	o.append(" r");
	gold_fnum(o, ${r} - ${w});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "hingehollow");
	out
}
