test: w=1.0 h=1.5 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=3 r=0.0 ok=true s="plantpathsteep" errors=0 n=0 res=[] cache=0 hits=0
