fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${scale};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	var total = 0;
	for k in g.n {
