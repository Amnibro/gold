	let th = ${threshold};
	var count = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff >= th { count++; }
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise ranks: ", count);
	out
}
