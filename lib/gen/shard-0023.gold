			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
		}
	}
	g.n = kept;
	g.steps += kept * kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted elements within limit ", kept);
	out
}
