noun: cache
modifier: none
context: aggregate
phrase: swap cache none replacing missing entries with {default_val}
phrase: fill uncached results from default replacement {default_val}
slot: default_val int
test: list=10,20,30 default_val=99
expect: => i=3 r=0.0 ok=true s="swapped uncached count: 3" errors=0 n=3 res=[99,99,99] cache=3 hits=0
test: list=5,15 default_val=42
expect: => i=2 r=0.0 ok=true s="swapped uncached count: 2" errors=0 n=2 res=[42,42] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let def = ${default_val};
	var replaced = 0;
	var i = 0;
	while i < g.n {
		let k = g.res[i];
		let val, found = gold_cache_get(g, k);
		if found {
			g.res[i] = val;
		} else {
			gold_cache_put(g, k, def);
			g.res[i] = def;
			replaced++;
		}
		i++;
	}
	out.i = replaced;
	out.s.clear();
	format(out.s, "swapped uncached count: ", replaced);
	out
}
@end
