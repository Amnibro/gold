kind: step
verb: compare
noun: middle
modifier: unique
context: aggregate
phrase: compare middle item against unique count
phrase: evaluate middle value against unique count
test: list=1,2,2,3,4
expect: => i=0 r=0.0 ok=true s="cmp mid uniq: 0" errors=0 n=5 res=[1,2,2,3,4] cache=0 hits=0
test: list=10,10,10,10
expect: => i=1 r=0.0 ok=true s="cmp mid uniq: 1" errors=0 n=4 res=[10,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_items = [0; 512];
	var u_count = 0;
	for i in g.n {
		let item_x = g.res[i];
		var exists = false;
		for j in u_count { if uniq_items[j] == item_x { exists = true; break; } }
		if !exists { uniq_items[u_count] = item_x; u_count++; }
	}
	var middle_val = if g.n > 0 { g.res[g.n / 2] } else { 0 };
	let cmp_res = if middle_val >= u_count { 1 } else { 0 };
	out.i = cmp_res;
	out.s.clear();
	format(out.s, "cmp mid uniq: ", cmp_res);
	out
}
@end
