@entry b613dead4b09f48b
kind: step
verb: drop
noun: subfunction
modifier: last
context: core
phrase: drop subfunction last trailing items {k}
phrase: prune subfunction last segment count {k}
slot: k int
test: list=12,24,36,48,60 k=2
expect: => i=3 r=0.0 ok=true s="left: 3" errors=0 n=3 res=[12,24,36] cache=0 hits=0
test: list=7,14,21 k=1
expect: => i=2 r=0.0 ok=true s="left: 2" errors=0 n=2 res=[7,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let drop_cnt = if k > g.n { g.n } else if k < 0 { 0 } else { k };
	g.n -= drop_cnt;
	g.steps += drop_cnt;
	out.i = g.n;
	out.s.clear();
	format(out.s, "left: ", g.n);
