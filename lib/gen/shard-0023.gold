expect: => i=2 r=0.0 ok=true s="sorted vowels: 2" errors=0 n=2 res=[97,101] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_buf = [0; 64];
	var count = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			v_buf[count] = b as int;
			count++;
		}
	}
	for i in count {
		for j in (i + 1)..count {
			if v_buf[j] < v_buf[i] {
				let tmp = v_buf[i];
				v_buf[i] = v_buf[j];
				v_buf[j] = tmp;
			}
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, v_buf[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "sorted vowels: ", count);
	out
}
@end
