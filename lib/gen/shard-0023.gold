fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap_val};
	if g.n > 0 {
		let mid = g.n / 2;
		if g.res[mid] > c {
			g.res[mid] = c;
		}
		out.i = g.res[mid];
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "clamped middle value: ", out.i);
	out
}
@end
@entry fa097b0994f8d720
kind: step
verb: normalize
noun: suffix
modifier: sorted
context: loop
slot: suffix_len int
phrase: normalize suffix sorted length {suffix_len}
phrase: sort trailing elements span {suffix_len}
test: list=50,30,10,40,20 suffix_len=3
expect: => i=3 r=0.0 ok=true s="sorted suffix size: 3" errors=0 n=5 res=[50,30,10,20,40] cache=0 hits=0
test: list=15,9,3 suffix_len=2
expect: => i=2 r=0.0 ok=true s="sorted suffix size: 2" errors=0 n=3 res=[15,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${suffix_len};
	var m = s;
	if m > g.n { m = g.n; }
	let start = g.n - m;
	var i = start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "sorted suffix size: ", m);
	out
}
@end
