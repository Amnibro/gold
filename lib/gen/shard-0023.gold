@entry 42cf92291b24a55f
kind: step
verb: keep
noun: streak
modifier: up_to
context: aggregate
phrase: keep streak up to max length {max_len}
phrase: retain increasing streak up to {max_len}
slot: max_len int
test: list=1,2,5,3,4,6,7 max_len=4
expect: => i=4 r=0.0 ok=true s="kept streak of 4" errors=0 n=4 res=[3,4,6,7] cache=0 hits=0
test: list=10,20,5,6,7,8 max_len=3
expect: => i=3 r=0.0 ok=true s="kept streak of 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = max(1, ${max_len});
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no streak found");
		return out;
	}
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
	}
	let keep_len = min(best_len, ml);
	for i in keep_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = keep_len;
	g.steps += g.n;
	out.i = keep_len;
	out.s.clear();
	format(out.s, "kept streak of ", keep_len);
	out
}
@end
