phrase: compute cache average for each sorted partition
test: list=10,20,30,40
expect: => i=50 r=0.0 ok=true s="cached partition averages" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=4,8,12,16,20,24
expect: => i=28 r=0.0 ok=true s="cached partition averages" errors=0 n=6 res=[4,8,12,16,20,24] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let mid = g.n / 2;
if mid > 0 {
	var s1 = 0;
	for i in mid { s1 += g.res[i]; }
	let avg1 = s1 / mid;
	gold_cache_put(g, 1, avg1);
	var s2 = 0;
	for i in mid..g.n { s2 += g.res[i]; }
	let avg2 = s2 / (g.n - mid);
	gold_cache_put(g, 2, avg2);
	out.i = avg1 + avg2;
}
out.s.clear();
format(out.s, "cached partition averages");
out
}
@end
