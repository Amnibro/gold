@entry 3eb1b2008c7135e7
kind: step
verb: swap
noun: loop
modifier: in_place
context: aggregate
phrase: swap loop in place rotate right
phrase: cyclically rotate elements in place
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="rotated in place: 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="rotated in place: 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated in place: ", g.n);
	out
}
@end
@entry 041d48c20732cc9a
kind: step
verb: reverse
noun: gaps
modifier: at_least
context: aggregate
slot: min_gap int
phrase: reverse gaps at least threshold {min_gap}
phrase: extract differences exceeding {min_gap}
test: list=10,12,20,25 min_gap=5
expect: => i=2 r=0.0 ok=true s="gaps at least count: 2" errors=0 n=2 res=[8,5] cache=0 hits=0
test: list=2,10,12,30 min_gap=7
expect: => i=2 r=0.0 ok=true s="gaps at least count: 2" errors=0 n=2 res=[8,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap >= mg {
			g.res[count] = gap;
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps at least count: ", count);
	out
}
@end
