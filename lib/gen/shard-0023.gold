phrase: apply running cumulative prime sum adding {bonus}
slot: bonus int
test: list=2,3,4,5 bonus=1
expect: => i=13 r=0.0 ok=true s="mapped primes running sum to 13" errors=0 n=4 res=[3,7,4,13] cache=0 hits=0
test: list=7,8,9,11 bonus=0
expect: => i=18 r=0.0 ok=true s="mapped primes running sum to 18" errors=0 n=4 res=[7,8,9,18] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bonus};
	var run_sum = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			run_sum += g.res[i] + b;
			g.res[i] = run_sum;
		}
	}
	g.steps += g.n;
	out.i = run_sum;
	out.s.clear();
	format(out.s, "mapped primes running sum to ", run_sum);
	out
}
@end
@entry cdb086af80899b4d
kind: step
verb: merge
noun: history
modifier: in_reverse
context: aggregate
phrase: merge history in reverse with step size {step}
phrase: combine history backwards using step {step}
slot: step int
test: list=1,2,3,4,5 step=2
expect: => i=3 r=0.0 ok=true s="merged history into 3 groups" errors=0 n=3 res=[9,5,9] cache=0 hits=0
test: list=10,20,30 step=3
expect: => i=1 r=0.0 ok=true s="merged history into 1 groups" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = max(1, ${step});
	var wr = 0;
	var i = g.n - 1;
	while i >= 0 {
		var total = 0;
		for k in s {
			if i - k >= 0 { total += g.res[i - k]; }
		}
		g.res[wr] = total;
		wr++;
		i -= s;
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "merged history into ", wr, " groups");
	out
}
@end
