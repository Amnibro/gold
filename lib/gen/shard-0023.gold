@entry e8709e235ea026bd
kind: step
verb: drop
noun: average
modifier: last
context: core
phrase: drop average last trailing calculation
phrase: remove average last segment value
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="kept: 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15,25
expect: => i=2 r=0.0 ok=true s="kept: 2" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / g.n;
	var kept = 0;
	var j = 0;
	while j < g.n {
		if g.res[j] >= avg {
			g.res[kept] = g.res[j];
			kept++;
		}
		j++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept: ", kept);
	out
}
@end
