@entry 38078843ba384956
kind: step
verb: limit
noun: counter
modifier: with_retry
context: stats
phrase: limit counter observations with retry passes {retries} ceiling {cap}
phrase: clamp sample counters with retry passes {retries} to {cap}
slot: cap int
slot: retries int
test: list=8,15,4,22,12 cap=10 retries=2
expect: => i=3 r=0.0 ok=true s="limited counter with retry: 3" errors=0 n=5 res=[8,10,4,10,10] cache=0 hits=0
test: list=5,30,40 cap=20 retries=3
expect: => i=2 r=0.0 ok=true s="limited counter with retry: 2" errors=0 n=3 res=[5,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let max_r = ${retries};
	var modified = 0;
	var r = 0;
	while r < max_r {
		var pass_mod = 0;
		for i in g.n {
			if g.res[i] > limit {
				g.res[i] = limit;
				pass_mod++;
			}
		}
		modified += pass_mod;
		if pass_mod == 0 {
			break;
		}
		r++;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "limited counter with retry: ", modified);
	out
}
@end
