code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var min_diff = 10;
	while x >= 10 {
		let d1 = x % 10;
		let d2 = (x / 10) % 10;
		let diff = if d1 > d2 { d1 - d2 } else { d2 - d1 };
		if diff < min_diff { min_diff = diff; }
		x /= 10;
	}
	min_diff
}
@end
