fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${floor};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let p = g.res[i] + g.res[i + 1];
		if p >= min_val {
			g.res[count] = p;
			count++;
		}
		i += 2;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered pairs count: ", count);
	out
}
@end
