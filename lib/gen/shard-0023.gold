expect: => i=4 r=0.0 ok=true s="joined prefix: 4" errors=0 n=4 res=[5,15,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var kept = [0; 512];
	var kn = 0;
	var acc = 0;
	for i in g.n {
		if i < d {
			acc += g.res[i];
			kept[kn] = acc;
			kn++;
		} else if g.res[i] > 0 {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "joined prefix: ", kn);
	out
}
@end
@entry 4a4a7f147956d54b
kind: step
verb: join
noun: window
modifier: in_place
context: filter
phrase: join window segments in place with width {size}
phrase: merge adjacent window values in place by span {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=3 r=0.0 ok=true s="window joined: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=2,3,4,5,6,7 size=3
expect: => i=2 r=0.0 ok=true s="window joined: 2" errors=0 n=2 res=[9,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 { return out; }
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		if sum > 0 { kept[kn] = sum; kn++; }
		i += sz;
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "window joined: ", kn);
	out
}
@end
@entry 5192b67bbf5545b7
kind: step
verb: join
noun: suffix
modifier: until
context: filter
phrase: join suffix values until reaching target sum {target}
phrase: accumulate trailing suffix elements until hitting {target}
slot: target int
test: list=5,10,15,20,25 target=40
expect: => i=45 r=0.0 ok=true s="suffix joined: 45" errors=0 n=2 res=[25,20] cache=0 hits=0
test: list=2,4,6,8,10 target=15
expect: => i=18 r=0.0 ok=true s="suffix joined: 18" errors=0 n=2 res=[10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var kept = [0; 512];
	var kn = 0;
	var sum = 0;
	var i = g.n - 1;
	while i >= 0 && sum < tgt {
		sum += g.res[i];
		kept[kn] = g.res[i];
		kn++;
		i--;
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = sum;
	out.s.clear();
	format(out.s, "suffix joined: ", sum);
	out
}
@end
