@entry 4c2c86df97f9546b
kind: step
verb: pair
noun: threshold
modifier: recursively
context: aggregate
slot: cut int
phrase: pair threshold recursively up to {cut}
phrase: combine items recursively until above {cut}
test: list=2,3,8 cut=5
expect: => i=2 r=0.0 ok=true s="paired threshold count: 2" errors=0 n=2 res=[5,8] cache=0 hits=0
test: list=1,2,3,10 cut=5
expect: => i=2 r=0.0 ok=true s="paired threshold count: 2" errors=0 n=2 res=[6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${cut};
	var changed = true;
	var passes = 0;
	while changed && passes < 10 {
		changed = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] < thresh {
				g.res[i] += g.res[i + 1];
				var k = i + 1;
				while k + 1 < g.n {
					g.res[k] = g.res[k + 1];
					k++;
				}
				g.n--;
				changed = true;
				break;
			}
			i++;
		}
		passes++;
	}
	g.steps += passes;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired threshold count: ", g.n);
	out
}
@end
