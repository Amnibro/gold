noun: runs
modifier: with_retry
context: error
phrase: select runs with retry count {minrun}
phrase: find run with minimum length {minrun}
slot: minrun int
test: list=3,3,3,5 minrun=3
expect: => i=3 r=0.0 ok=true s="valid run length found" errors=0 n=4 res=[3,3,3,5] cache=0 hits=0
test: list=3,3,5 minrun=3
expect: => i=0 r=0.0 ok=false s="error: run too short" errors=1 n=3 res=[3,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${minrun};
	var max_run = 0;
	if g.n > 0 {
		var cur = 1;
		max_run = 1;
		for k in 1..g.n {
			if g.res[k] == g.res[k - 1] {
				cur++;
				if cur > max_run { max_run = cur; }
			} else {
				cur = 1;
			}
		}
	}
	out.s.clear();
	if max_run < mr {
		gold_fail(g, "longest run is shorter than minimum required");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: run too short");
		return out;
	}
	out.i = max_run;
	out.ok = true;
	format(out.s, "valid run length found");
	out
}
@end
