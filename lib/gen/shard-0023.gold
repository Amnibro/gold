expect: => i=50 r=0.0 ok=true s="min: 50" errors=0 n=4 res=[50,60,80,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	if g.n > 0 {
		out.i = g.res[0];
		out.s.clear();
		format(out.s, "min: ", g.res[0]);
	} else {
		out.i = 0;
	}
	out
}
@end
