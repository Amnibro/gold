fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${max_len};
	while out.s.len > max_len && out.s.len > 2 {
		let mid = out.s.len / 2;
		var i = mid;
		while i + 1 < out.s.len {
			out.s[i] = out.s[i + 1];
			i++;
		}
		out.s.pop();
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
