code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let loops = ${iters};
	gold_clear(g);
	var base_delay = out.i;
	for i in loops {
		gold_push(g, base_delay);
		base_delay *= 2;
	}
	g.steps += loops;
	out.i = base_delay;
	out.s.clear();
	format(out.s, "simulated backoff loops ", loops);
	out
}
@end
@entry 5982975426d7c37c
kind: step
verb: return
noun: middle
modifier: up_to
context: retry
phrase: return middle retry attempts up to span {span}
phrase: extract interior retry records up to span {span}
slot: span int
test: list=10,20,30,40,50 span=3
expect: => i=3 r=0.0 ok=true s="extracted middle span 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=1,2,3,4,5,6 span=2
expect: => i=2 r=0.0 ok=true s="extracted middle span 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_span = ${span};
	if g.n == 0 || max_span <= 0 { gold_clear(g); out.i = 0; return out; }
	let take = min(g.n, max_span);
	let start_pos = (g.n - take) / 2;
	for i in take {
		g.res[i] = g.res[start_pos + i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "extracted middle span ", take);
	out
}
@end
