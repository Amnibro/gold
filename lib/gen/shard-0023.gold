fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var u = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
