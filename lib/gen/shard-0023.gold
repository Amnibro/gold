test: list=10,2,3
expect: => i=10 r=0.0 ok=true s="reversed up to maximum: 10" errors=0 n=3 res=[10,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "reversed up to maximum: 0");
		return out;
	}
	var max_val = g.res[0];
	var max_idx = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
		i++;
	}
	var left = 0;
	var right = max_idx;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + max_idx;
	out.i = max_val;
	out.s.clear();
	format(out.s, "reversed up to maximum: ", max_val);
	out
}
@end
