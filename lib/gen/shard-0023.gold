code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 { g.n = 0; out.i = 0; return out; }
	if c >= g.n { out.i = g.n; return out; }
	var kept = [0; 512];
	var kn = 0;
	let start = g.n - c;
	for i in start..g.n { kept[kn] = g.res[i]; kn++; }
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "last history: ", kn);
	out
}
