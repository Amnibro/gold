	if g.n > 0 {
		gold_cache_put(g, 1, g.res[0]);
		gold_cache_put(g, 2, g.res[g.n - 1]);
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted with cache entries ", g.n);
	out
}
