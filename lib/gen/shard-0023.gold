test: input=3825
expect: => i=4 r=0.0 ok=true s="ranked digits recursively 4" errors=0 n=4 res=[8,5,3,2] cache=0 hits=0
test: input=1904
expect: => i=4 r=0.0 ok=true s="ranked digits recursively 4" errors=0 n=4 res=[9,4,1,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var val = out.i;
	gold_clear(g);
	if val == 0 {
		gold_push(g, 0);
	} else {
		while val > 0 {
			gold_push(g, val % 10);
			val /= 10;
		}
	}
	for i in g.n {
		for j in 0..g.n - 1 - i {
			if g.res[j] < g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked digits recursively ", g.n);
	out
}
@end
@entry a8ee22d0a6a9c8ff
kind: step
