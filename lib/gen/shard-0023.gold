	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let count = ${k};
var sum = 0;
var lim = count;
if lim > g.n { lim = g.n; }
for i in lim { sum += g.res[i]; }
out.i = sum;
out.s.clear();
format(out.s, "grouped prefix sum ", sum);
out
}
@end
