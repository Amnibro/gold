fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	var adjusted = 0;
	for i in g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			adjusted++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped items: ", adjusted);
	out
}
@end
@entry 0444b92122ca3299
kind: step
verb: sum
noun: results
modifier: unique
context: core
phrase: sum results unique elements without duplicates
phrase: total distinct results unique values
test: list=2,3,2,5,3,7
expect: => i=17 r=0.0 ok=true s="unique total: 17" errors=0 n=6 res=[2,3,2,5,3,7] cache=0 hits=0
test: list=10,10,20,30,20
expect: => i=60 r=0.0 ok=true s="unique total: 60" errors=0 n=5 res=[10,10,20,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = [0; 512];
	var un = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen {
			uniq[un] = x;
			un++;
			total += x;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "unique total: ", total);
	out
}
@end
