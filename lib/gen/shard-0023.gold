code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < 65 {
			g.res[i] = 65;
			clamped++;
		}
		if g.res[i] > 90 {
			g.res[i] = 90;
			clamped++;
		}
	}
	var r = 0;
	while clamped == 0 && r < max_r {
		r++;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped letters: ", clamped);
	out
}
@end
