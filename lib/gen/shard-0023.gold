expect: => i=1 r=0.0 ok=true s="scaled 1 unique memo items" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var wr = 0;
	for i in g.n {
		var seen = false;
		for j in wr {
			if g.res[j] == g.res[i] * m { seen = true; break; }
		}
		if !seen {
			g.res[wr] = g.res[i] * m;
			wr++;
		}
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "scaled ", wr, " unique memo items");
	out
}
@end
