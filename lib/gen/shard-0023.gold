expect: => i=4 r=0.0 ok=true s="mississippi" errors=0 n=4 res=[1,2,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var freq int[256] = [0; 256];
	var i = 0;
	while i < out.s.len {
		let idx = out.s[i] as int;
		if idx >= 0 && idx < 256 { freq[idx]++; }
		i++;
	}
	var counts int[..256] = [];
	var c = 0;
	while c < 256 {
		if freq[c] > 0 { counts.push(freq[c]); }
		c++;
	}
	var p = 0;
	while p < counts.len {
		var q = p + 1;
		while q < counts.len {
			if counts[q] < counts[p] {
				let tmp = counts[p];
				counts[p] = counts[q];
				counts[q] = tmp;
			}
			q++;
		}
		p++;
	}
	for cnt in counts { gold_push(g, cnt); }
	g.steps += counts.len;
	out.i = counts.len;
	out
}
@end
