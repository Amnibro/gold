@entry 53d443700b50402b
kind: step
verb: rotate
noun: streak
modifier: with_retry
context: retry
phrase: rotate failure streak with retry {k}
phrase: cycle attempt streaks with retry count {k}
slot: k int
test: list=1,2,3,4 k=1
expect: => i=1 r=0.0 ok=true s="rotated streak by 1" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="rotated streak by 2" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n <= 1 || shift <= 0 { return out; }
	let eff = shift % g.n;
	for s in eff {
		let last_val = g.res[g.n - 1];
		var p = g.n - 1;
		while p > 0 {
			g.res[p] = g.res[p - 1];
			p--;
		}
		g.res[0] = last_val;
	}
	g.steps += eff * g.n;
	out.i = eff;
	out.s.clear();
	format(out.s, "rotated streak by ", eff);
	out
}
@end
@entry 474d60d555af8052
kind: step
verb: rotate
noun: prefix
modifier: all
context: retry
