phrase: reverse swap bounded by budget {budget}
slot: budget int
test: list=4,9 budget=20
expect: => i=9 r=0.0 ok=true s="reversed within budget" errors=0 n=2 res=[9,4] cache=0 hits=0
test: list=12,15 budget=20
expect: => i=0 r=0.0 ok=false s="error: budget exceeded" errors=1 n=2 res=[12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	out.s.clear();
	if g.n < 2 {
		gold_fail(g, "need multiple items to reverse");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: need multiple items");
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	if sum > b {
		gold_fail(g, "total elements exceed budget limit");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: budget exceeded");
		return out;
	}
	var l = 0;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	out.i = g.res[0];
	out.ok = true;
	format(out.s, "reversed within budget");
	out
}
@end
