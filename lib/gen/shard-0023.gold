fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let iters = ${rounds};
	var r = 0;
	while r < iters && g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			g.res[i] = g.res[i + 1] - g.res[i];
			i++;
		}
		g.n--;
		r++;
	}
	out.i = r;
	gold_text(out, "ran pairs recursively");
	out
}
