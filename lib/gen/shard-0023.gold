test: arg=1122,1234
expect: 2
expect: 0
test: arg=555
expect: 2
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var total_len = 0;
	var mask = 0;
	while x > 0 {
		let d = x % 10;
		total_len++;
		mask |= (1 << d);
		x /= 10;
	}
	var uniq = 0;
	for k in 10 {
		if (mask & (1 << k)) != 0 { uniq++; }
	}
	if total_len > uniq { total_len - uniq } else { 0 }
}
@end
