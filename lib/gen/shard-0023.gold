test: list=5,15 key=2
expect: => i=10 r=0.0 ok=true s="cached_avg: 10" errors=0 n=2 res=[5,15] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	let k = ${key};
	var out = v;
	out.s.clear();
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	gold_cache_put(g, k, avg);
	let val, ok = gold_cache_get(g, k);
	format(out.s, "cached_avg: ", val);
	out.i = val;
	g.steps += g.n;
	out
}
@end
