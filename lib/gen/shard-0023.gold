fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			for j in i {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				total += x;
			}
		}
	}
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum unique odds: ", total);
	out
}
@end
