code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	let bound = if lim > out.s.len { out.s.len } else { lim };
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if out.s[j] < out.s[i] {
				let tmp = out.s[i];
				out.s[i] = out.s[j];
				out.s[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += bound;
	out.i = bound;
	out
}
@end
