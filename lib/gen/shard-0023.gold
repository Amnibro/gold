phrase: rotate counter last elements by count {steps}
phrase: shift trailing comparison counter positions by {steps}
test: list=10,20,30,40,50 steps=2
expect: => i=5 r=0.0 ok=true s="rotated last counter: 5" errors=0 n=5 res=[10,20,30,50,40] cache=0 hits=0
test: list=5,15,25,35,45,55 steps=3
expect: => i=6 r=0.0 ok=true s="rotated last counter: 6" errors=0 n=6 res=[5,15,25,55,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${steps};
	if g.n > k && k > 0 {
		var start = g.n - k;
		let last_val = g.res[g.n - 1];
		var i = g.n - 1;
		while i > start {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[start] = last_val;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated last counter: ", g.n);
	out
}
@end
