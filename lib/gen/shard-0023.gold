test: list=100,200,300,400 count=2
expect: => i=2 r=0.0 ok=true s="series cached: 2" errors=0 n=4 res=[100,200,300,400] cache=2 hits=0
test: list=7,14,21 count=3
expect: => i=3 r=0.0 ok=true s="series cached: 3" errors=0 n=3 res=[7,14,21] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	var cached = 0;
	var idx = 0;
	while idx < g.n && idx < limit {
		gold_cache_put(g, idx, g.res[idx]);
		cached++;
		idx++;
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "series cached: ", cached);
	out
}
@end
