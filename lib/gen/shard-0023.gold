fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for k in kept {
			if g.res[k] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique series elements: ", kept);
	out
}
@end
