kind: step
verb: find
noun: loop
modifier: all
context: sort
phrase: find all cycle loops in sorted index permutations
phrase: detect all permutation loops across sorted items
test: list=30,10,20
expect: => i=1 r=0.0 ok=true s="found 1 permutation loops" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,1,3,2
expect: => i=2 r=0.0 ok=true s="found 2 permutation loops" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
var orig int[512] = [0; 512];
for i in g.n { orig[i] = g.res[i]; }
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
var perm int[512] = [0; 512];
for i in g.n {
	for j in g.n {
		if orig[i] == g.res[j] { perm[i] = j; break; }
	}
}
var vis bool[512] = [false; 512];
var loops = 0;
for i in g.n {
	if !vis[i] {
		loops++;
		var cur = i;
		while !vis[cur] {
			vis[cur] = true;
			cur = perm[cur];
		}
	}
}
out.i = loops;
out.s.clear();
format(out.s, "found ", loops, " permutation loops");
out
}
@end
