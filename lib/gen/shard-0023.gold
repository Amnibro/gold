phrase: multiply prime values with retry limit {attempts}
slot: attempts int
test: list=2,3,4,7 attempts=2
expect: => i=3 r=0.0 ok=true s="scaled 3 primes" errors=0 n=4 res=[8,12,4,28] cache=0 hits=0
test: list=5,10,11 attempts=1
expect: => i=2 r=0.0 ok=true s="scaled 2 primes" errors=0 n=3 res=[10,10,22] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = max(0, ${attempts});
	var count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			var tries = 0;
			while tries < att && g.res[i] < 100 {
				g.res[i] *= 2;
				tries++;
			}
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " primes");
	out
}
@end
