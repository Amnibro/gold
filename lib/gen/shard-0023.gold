@entry ff3a47566aed7b02
kind: step
verb: shift
noun: sequence
modifier: with_retry
context: loop
slot: shift_amt int
phrase: shift sequence with retry offset {shift_amt}
phrase: rotate sequence right by {shift_amt}
test: list=1,2,3,4 shift_amt=1
expect: => i=4 r=0.0 ok=true s="sequence shifted: 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30 shift_amt=2
expect: => i=3 r=0.0 ok=true s="sequence shifted: 3" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${shift_amt};
	if g.n > 1 {
		var step = 0;
		while step < k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
			step++;
		}
	}
	g.steps += g.n * k;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sequence shifted: ", g.n);
	out
}
@end
