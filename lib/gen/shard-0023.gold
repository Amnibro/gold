@entry 6648964b6b52bca5
kind: step
verb: check
noun: number
modifier: unique
context: stats
phrase: check number unique values in sample
phrase: verify unique numbers across statistical sample
test: list=5,12,7,12,9
expect: => i=4 r=0.0 ok=true s="unique numbers count: 4" errors=0 n=5 res=[5,12,7,12,9] cache=0 hits=0
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="unique numbers count: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = 0;
		var j = 0;
		while j < i {
			if g.res[j] == x { seen++; }
			j++;
		}
		if seen == 0 { unique_count++; }
		i++;
	}
	g.steps += g.n * g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique numbers count: ", unique_count);
	out
}
@end
@entry a358d72756c139fd
kind: step
verb: measure
noun: values
modifier: none
context: stats
phrase: measure values none summary across sample
phrase: compute baseline sum of values in sample
test: list=10,25,15,30
expect: => i=80 r=20.0 ok=true s="sample sum: 80" errors=0 n=4 res=[10,25,15,30] cache=0 hits=0
test: list=4,8,12
expect: => i=24 r=8.0 ok=true s="sample sum: 24" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let mean = if g.n > 0 { (sum as real) / (g.n as real) } else { 0.0 };
	g.steps += g.n;
	out.i = sum;
	out.r = mean;
	out.s.clear();
	format(out.s, "sample sum: ", sum);
	out
}
@end
@entry bb12442a8f650f6d
kind: step
verb: scale
noun: total
modifier: in_place
context: stats
slot: factor int
phrase: scale total in place by factor {factor}
phrase: multiply sample entries in place by {factor}
test: list=2,5,3,10 factor=3
expect: => i=60 r=0.0 ok=true s="scaled total in place: 60" errors=0 n=4 res=[6,15,9,30] cache=0 hits=0
test: list=1,4,7 factor=2
expect: => i=24 r=0.0 ok=true s="scaled total in place: 24" errors=0 n=3 res=[2,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total = 0;
	var i = 0;
	while i < g.n {
		g.res[i] = g.res[i] * f;
		total += g.res[i];
		i++;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled total in place: ", total);
	out
}
@end
@entry a4e19b1c7846297f
kind: step
verb: measure
noun: odds
modifier: up_to
context: stats
slot: limit int
phrase: measure odds up to {limit} in sample
phrase: count odd entries up to threshold {limit}
test: list=3,8,11,14,7 limit=10
expect: => i=2 r=0.0 ok=true s="odds up to limit: 2" errors=0 n=5 res=[3,8,11,14,7] cache=0 hits=0
test: list=1,5,9,13 limit=6
expect: => i=2 r=0.0 ok=true s="odds up to limit: 2" errors=0 n=4 res=[1,5,9,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x <= lim && x % 2 != 0 {
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "odds up to limit: ", count);
	out
}
@end
