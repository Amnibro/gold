slot: min_step int
test: list=1,2,3,4 min_step=3
expect: => i=3 r=0.0 ok=true s="spaces adjusted: 3" errors=0 n=4 res=[1,4,7,10] cache=0 hits=0
test: list=5,6,10 min_step=5
expect: => i=2 r=0.0 ok=true s="spaces adjusted: 2" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_req = ${min_step};
	if g.n <= 1 { return out; }
	var adjusted_cnt = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff < step_req {
			g.res[i] = g.res[i - 1] + step_req;
			adjusted_cnt++;
		}
	}
	out.i = adjusted_cnt;
	out.s.clear();
	format(out.s, "spaces adjusted: ", adjusted_cnt);
	out
}
@end
