@entry 31349f0dbed8b34c
kind: step
verb: sort
noun: item
modifier: every_other
context: format
phrase: format sorted alternate items stride offset {stride}
phrase: render sorted elements every other step {stride}
slot: stride int
test: list=9,2,8,1,7,3 stride=2
expect: => i=3 r=0.0 ok=true s="alt_sort: [7, 8, 9]" errors=0 n=6 res=[9,2,8,1,7,3] cache=0 hits=0
test: list=15,4,12,1,6 stride=2
expect: => i=3 r=0.0 ok=true s="alt_sort: [6, 12, 15]" errors=0 n=5 res=[15,4,12,1,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let st = if ${stride} <= 0 { 1 } else { ${stride} };
	var out = v;
	out.s.clear();
	var arr: int[64] = [0; 64];
	var count = 0;
	var idx = 0;
	while idx < g.n {
		if count < 64 {
			arr[count] = g.res[idx];
			count++;
		}
		idx += st;
	}
	for i in count {
		for j in (i + 1)..count {
			if arr[j] < arr[i] {
				let tmp = arr[i];
				arr[i] = arr[j];
				arr[j] = tmp;
			}
		}
	}
	format(out.s, "alt_sort: [");
	for i in count {
		if i > 0 { format(out.s, ", "); }
		format(out.s, arr[i]);
	}
	format(out.s, "]");
	out.i = count;
	g.steps += count * count;
	out
}
@end
