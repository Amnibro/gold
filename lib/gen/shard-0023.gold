fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_dup = 0;
	var has_found = false;
	for i in g.n {
		for j in 0..i {
			if g.res[j] == g.res[i] {
				found_dup = g.res[i];
				has_found = true;
				break;
			}
		}
		if has_found { break; }
	}
	out.i = found_dup;
	out.s.clear();
	format(out.s, "first loop: ", found_dup);
	out
}
@end
