fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var kept = [0; 512];
	var kn = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= fl {
			kept[kn] = g.res[i];
			kn++;
		}
		i--;
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
