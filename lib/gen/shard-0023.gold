@entry 021ec189d673dc02
kind: step
verb: sort
noun: squares
modifier: nested
context: format
phrase: format sorted square values in nested groups size {chunk}
phrase: display sorted squared numbers clustered by chunk {chunk}
slot: chunk int
test: list=4,2,5,3 chunk=2
expect: => i=4 r=0.0 ok=true s="chunks: [[4, 9], [16, 25]]" errors=0 n=4 res=[4,2,5,3] cache=0 hits=0
test: list=6,1,7,2 chunk=2
expect: => i=4 r=0.0 ok=true s="chunks: [[1, 4], [36, 49]]" errors=0 n=4 res=[6,1,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let ch = if ${chunk} <= 0 { 1 } else { ${chunk} };
	var out = v;
	out.s.clear();
	var arr: int[64] = [0; 64];
	let n = if g.n < 64 { g.n } else { 64 };
	for i in n {
		arr[i] = g.res[i] * g.res[i];
	}
	for i in n {
		for j in (i + 1)..n {
			if arr[j] < arr[i] {
				let tmp = arr[i];
				arr[i] = arr[j];
				arr[j] = tmp;
			}
		}
	}
	format(out.s, "chunks: [");
	var cnt = 0;
	var i = 0;
	while i < n {
		if i > 0 { format(out.s, ", "); }
		format(out.s, "[");
		let end = if (i + ch) < n { i + ch } else { n };
		for k in i..end {
			if k > i { format(out.s, ", "); }
			format(out.s, arr[k]);
			cnt++;
		}
		format(out.s, "]");
		i += ch;
	}
	format(out.s, "]");
	out.i = cnt;
	g.steps += n * n;
	out
}
@end
