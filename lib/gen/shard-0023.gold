@entry cc884e91d6bb88e1
kind: step
verb: fill
noun: pairs
modifier: until
context: stats
phrase: fill sample pairs until target length {target_len}
phrase: extend observation pairs until count {target_len}
slot: target_len int
test: list=2,5 target_len=4
expect: => i=2 r=0.0 ok=true s="filled pairs count: 2" errors=0 n=4 res=[2,5,8,11] cache=0 hits=0
test: list=10,20,30 target_len=5
expect: => i=2 r=0.0 ok=true s="filled pairs count: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	var filled = 0;
	while g.n < target {
		var next_val = 0;
		if g.n >= 2 {
			next_val = g.res[g.n - 1] + (g.res[g.n - 1] - g.res[g.n - 2]);
		} else if g.n == 1 {
			next_val = g.res[0];
		}
		gold_push(g, next_val);
		filled++;
	}
	g.steps += filled;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled pairs count: ", filled);
	out
}
@end
