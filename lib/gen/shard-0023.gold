noun: limit
modifier: any
context: core
phrase: fill limit any values exceeding {bound} with {filler}
phrase: replace limit any items above {bound} using {filler}
slot: bound int
slot: filler int
test: list=10,45,20,60 bound=30 filler=0
expect: => i=2 r=0.0 ok=true s="filled: 2" errors=0 n=4 res=[10,0,20,0] cache=0 hits=0
test: list=15,25,8,35 bound=20 filler=99
expect: => i=2 r=0.0 ok=true s="filled: 2" errors=0 n=4 res=[15,99,8,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let fill = ${filler};
	var replaced = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > b {
			g.res[i] = fill;
			replaced++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "filled: ", replaced);
	out
}
@end
