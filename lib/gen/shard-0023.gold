test: arg=1234,5678
expect: 2143
expect: 6587
test: arg=91,5
expect: 19
expect: 50
code:
fn ${ID}(n int) int {
	var num = if n < 0 { -n } else { n };
	var out_val = 0;
	var multiplier = 1;
	while num > 0 {
		let chunk = num % 100;
		let d0 = chunk % 10;
		let d1 = chunk / 10;
		let swapped = d0 * 10 + d1;
		out_val += swapped * multiplier;
		num /= 100;
		multiplier *= 100;
	}
	out_val
}
@end
