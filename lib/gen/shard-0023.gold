phrase: screen series elements appearing across {times} frequency threshold
slot: times int
test: list=2,3,2,5,3,2 times=2
expect: => i=5 r=0.0 ok=true s="filtered series: 5" errors=0 n=5 res=[2,3,2,3,2] cache=0 hits=0
