test: list=1,2,3,4,5 times=2
expect: => i=2 r=0.0 ok=true s="swapped history times: 2" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30,40 times=1
expect: => i=1 r=0.0 ok=true s="swapped history times: 1" errors=0 n=4 res=[40,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var t = ${times};
	let max_swaps = g.n / 2;
	if t < 0 { t = 0; }
	if t > max_swaps { t = max_swaps; }
	var k = 0;
	while k < t {
		let tmp = g.res[k];
		g.res[k] = g.res[g.n - 1 - k];
		g.res[g.n - 1 - k] = tmp;
		k++;
	}
	g.steps += t;
	out.i = t;
	out.s.clear();
	format(out.s, "swapped history times: ", t);
	out
}
@end
