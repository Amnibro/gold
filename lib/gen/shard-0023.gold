code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	let len = out.s.len;
	if len > 1 && sh > 0 {
		let eff = sh % len;
		for step in eff {
			let last_char = out.s[out.s.len - 1];
			var p = out.s.len - 1;
			while p > 0 {
				out.s[p] = out.s[p - 1];
				p--;
			}
			out.s[0] = last_char;
		}
		gold_cache_put(g, sh, len);
	}
	out.i = len;
	out
}
@end
