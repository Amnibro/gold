code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var budget = 0;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if budget + g.res[i] <= limit {
			budget += g.res[i];
			count++;
		} else {
			break;
		}
		i--;
	}
	out.i = count;
	gold_text(out, "found budget in reverse");
	out
}
@end
