fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_space};
	var w = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			let space = g.res[i] - g.res[i - 1];
			if space >= limit {
				g.res[w] = space;
				w++;
			}
			i++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "shift spaces at least count: ", w);
	out
}
@end
