slot: max_gap int
phrase: cache gaps between bounds {min_gap} to {max_gap}
phrase: isolate loop differences within {min_gap} through {max_gap}
test: list=10,14,25,29 min_gap=3 max_gap=6
expect: => i=2 r=0.0 ok=true s="cached gaps count: 2" errors=0 n=2 res=[4,4] cache=0 hits=0
test: list=2,10,15,30 min_gap=4 max_gap=6
expect: => i=1 r=0.0 ok=true s="cached gaps count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_gap};
	let hi = ${max_gap};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap >= lo && gap <= hi {
			g.res[count] = gap;
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "cached gaps count: ", count);
	out
}
@end
