fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + ${step} * 2 <= g.n {
		for k in ${step} {
			let a = i + k;
			let b = i + ${step} + k;
			let tmp = g.res[a];
			g.res[a] = g.res[b];
			g.res[b] = tmp;
			count++;
		}
		i += ${step} * 2;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "swapped nested elements: ", count);
	out
}
@end
