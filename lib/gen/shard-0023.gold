fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${lag};
	if k > 0 && g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			if i >= k {
				g.res[i] = g.res[i - k];
			} else {
				g.res[i] = 0;
			}
			i--;
		}
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "shifted history nested: ", k);
	out
}
@end
