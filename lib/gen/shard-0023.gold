expect: => i=4 r=0.0 ok=true s="repeated first counter: 4" errors=0 n=4 res=[8,8,8,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	if g.n > 0 && reps > 0 {
		let first = g.res[0];
		var orig int[512] = [0; 512];
		let on = g.n;
		var i = 0;
		while i < on {
			orig[i] = g.res[i];
			i++;
		}
		var total = 0;
		var r = 0;
		while r < reps && total < 512 {
			g.res[total] = first;
			total++;
			r++;
		}
		var j = 0;
		while j < on && total < 512 {
			g.res[total] = orig[j];
			total++;
			j++;
		}
		g.n = total;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated first counter: ", g.n);
	out
}
@end
