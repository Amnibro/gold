	if ${n} < 1 {
		gold_fail(g, "count must be positive");
		out.ok = false;
		return out;
	}
	out.s.clear();
	for i in ${n} {
		if i > 0 {
			out.s.push(',');
		}
		format(out.s, i + 1);
	}
	out.i = ${n};
	out
}
@end
@entry 1d04acbe4c9d499a
kind: step
verb: find
noun: squares
modifier: up_to
context: transform
phrase: find perfect squares up to ceiling {cap}
phrase: discover squared values up to boundary {cap}
slot: cap int
test: list=4,5,9,16,20 cap=10
expect: => i=2 r=0.0 ok=true s="found squares up to ceiling" errors=0 n=2 res=[4,9] cache=0 hits=0
test: list=1,3,16,25,30 cap=20
expect: => i=2 r=0.0 ok=true s="found squares up to ceiling" errors=0 n=2 res=[1,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var write_idx = 0;
	var found = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x <= limit && core_is_square(x) {
			g.res[write_idx] = x;
			write_idx++;
			found++;
		}
	}
	g.n = write_idx;
	out.i = found;
	gold_text(out, "found squares up to ceiling");
	out
}
@end
