@entry 582a66f71200996c
kind: step
verb: collect
noun: streak
modifier: sorted
context: transform
phrase: collect longest nondecreasing sorted streak from list
phrase: extract longest monotonic sorted streak of elements
test: list=5,1,2,3,0,4
expect: => i=3 r=0.0 ok=true s="collected sorted streak" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,5,15,25,35
expect: => i=4 r=0.0 ok=true s="collected sorted streak" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		gold_text(out, "collected sorted streak");
		return out;
	}
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_start = cur_start;
				best_len = cur_len;
			}
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len {
		best_start = cur_start;
		best_len = cur_len;
	}
	for j in best_len {
		g.res[j] = g.res[best_start + j];
	}
	g.n = best_len;
	out.i = best_len;
	gold_text(out, "collected sorted streak");
	out
}
@end
