@entry 05fe0a0a6c25dccb
kind: step
verb: merge
noun: values
modifier: in_place
context: aggregate
phrase: merge values in place with step {step}
phrase: combine values in place stepping by {step}
slot: step int
test: list=10,20,30,40 step=2
expect: => i=2 r=0.0 ok=true s="merged 2 pairs" errors=0 n=2 res=[30,70] cache=0 hits=0
test: list=5,15,25 step=1
expect: => i=1 r=0.0 ok=true s="merged 1 pairs" errors=0 n=2 res=[20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n < 2 || s <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no merge possible");
		return out;
	}
	var pairs = 0;
	var i = 0;
	var wr = 0;
	while i + 1 < g.n {
		g.res[wr] = g.res[i] + g.res[i + 1];
		wr++;
		pairs++;
		i += 2;
	}
	if i < g.n {
		g.res[wr] = g.res[i];
		wr++;
	}
	g.n = wr;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "merged ", pairs, " pairs");
	out
}
@end
@entry 0f1019e4a8cb003f
kind: step
verb: keep
noun: spaces
modifier: at_most
context: aggregate
phrase: keep spaces at most distance {max_gap}
phrase: retain elements having gap at most {max_gap}
slot: max_gap int
test: list=1,3,10,12,15 max_gap=3
expect: => i=2 r=0.0 ok=true s="retained 2 items within gap" errors=0 n=2 res=[1,3] cache=0 hits=0
test: list=2,4,9,20 max_gap=2
expect: => i=2 r=0.0 ok=true s="retained 2 items within gap" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "retained all spaces");
		return out;
	}
	var wr = 1;
	for i in 1..g.n {
		if abs(g.res[i] - g.res[wr - 1]) <= mg {
			g.res[wr] = g.res[i];
			wr++;
		}
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "retained ", wr, " items within gap");
	out
}
@end
