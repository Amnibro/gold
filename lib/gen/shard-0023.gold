code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let item = ${val};
let mid = g.n / 2;
if g.n < 512 {
	for k in mid..g.n {
		let rev = g.n - (k - mid);
		g.res[rev] = g.res[rev - 1];
	}
	g.res[mid] = item;
	g.n++;
}
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
out.i = item;
out.s.clear();
format(out.s, "filled middle item ", item);
out
}
@end
