@entry 13f0035c6619c354
kind: step
verb: filter
noun: histogram
modifier: times
context: compare
slot: min_count int
phrase: filter histogram times with occurrence threshold {min_count}
phrase: retain values appearing comparison frequency at least {min_count}
test: list=1,2,2,3,3,3,4 min_count=2
expect: => i=2 r=0.0 ok=true s="filtered histogram frequency: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,6,7,7,7,8 min_count=3
expect: => i=1 r=0.0 ok=true s="filtered histogram frequency: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_count};
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == x { freq++; }
			j++;
		}
		if freq >= thresh {
			var already = false;
			var k = 0;
			while k < kn {
				if kept[k] == x { already = true; break; }
				k++;
			}
			if !already {
				kept[kn] = x;
				kn++;
			}
		}
		i++;
	}
	var m = 0;
	while m < kn {
		g.res[m] = kept[m];
		m++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "filtered histogram frequency: ", kn);
	out
}
@end
