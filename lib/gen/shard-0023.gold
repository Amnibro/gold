expect: 46235
expect: 187
test: arg=3572,468,192
expect: 3572
expect: 468
expect: 192
code:
fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val == 0 { return 0; }
	var non_primes int[10] = [0; 10];
	var np_count = 0;
	var primes int[10] = [0; 10];
	var p_count = 0;
	while val > 0 {
		let d = val % 10;
		if d == 2 || d == 3 || d == 5 || d == 7 {
			primes[p_count] = d;
			p_count++;
		} else {
			non_primes[np_count] = d;
			np_count++;
		}
		val /= 10;
	}
	var res = 0;
	for i in 0..np_count {
		let idx = np_count - 1 - i;
		res = res * 10 + non_primes[idx];
	}
	for i in 0..p_count {
		let idx = p_count - 1 - i;
		res = res * 10 + primes[idx];
	}
	res
}
@end
