fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var adjusted = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			adjusted++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted: ", adjusted);
	out
}
@end
