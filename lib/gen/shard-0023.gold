noun: middle
modifier: safely
context: stats
phrase: limit sample middle safely to count {count}
phrase: extract central observations safely {count}
slot: count int
test: list=1,4,7,10,13 count=3
expect: => i=3 r=0.0 ok=true s="limited middle safely: 3" errors=0 n=3 res=[4,7,10] cache=0 hits=0
