@entry 02965522b5b7fe1c
kind: step
verb: map
noun: runs
modifier: with_cache
context: loop
phrase: map runs with cache across list
phrase: record run lengths with cache in sequence
test: list=4,4,4,5,5,6
expect: => i=3 r=0.0 ok=true s="mapped runs count: 3" errors=0 n=3 res=[3,2,1] cache=3 hits=0
test: list=7,7,8,7,7
expect: => i=3 r=0.0 ok=true s="mapped runs count: 3" errors=0 n=3 res=[2,1,2] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	var rn = 0;
	var runs int[256] = [0; 256];
	while i < g.n {
		let val = g.res[i];
		var len = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			len++;
			i++;
		}
		let _, has = gold_cache_get(g, val);
		if !has {
			gold_cache_put(g, val, len);
		}
		runs[rn] = len;
		rn++;
		count++;
		i++;
	}
	var j = 0;
	while j < rn {
		g.res[j] = runs[j];
		j++;
	}
	g.n = rn;
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped runs count: ", count);
	out
}
@end
