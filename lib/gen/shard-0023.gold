@entry d5f6da3dd5945a13
kind: step
verb: sum
noun: sequence
modifier: nested
context: core
phrase: sum sequence nested within block size {block_size}
phrase: aggregate nested sequence chunks of size {block_size}
slot: block_size int
test: list=1,2,3,4,5,6 block_size=2
expect: => i=3 r=0.0 ok=true s="nested sums count: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40,50 block_size=3
expect: => i=2 r=0.0 ok=true s="nested sums count: 2" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${block_size};
	if bsize <= 0 { gold_fail(g, "block size must be positive"); out.ok = false; return out; }
	var sums = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		var cur_sum = 0;
		var j = 0;
		while j < bsize && (i + j) < g.n {
			cur_sum += g.res[i + j];
			j++;
		}
		sums[count] = cur_sum;
		count++;
		i += bsize;
	}
	gold_clear(g);
	for k in count { gold_push(g, sums[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "nested sums count: ", count);
	out
}
@end
