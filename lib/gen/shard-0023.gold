@entry e4ab211af7986909
kind: step
verb: sum
noun: numbers
modifier: unique
context: transform
phrase: sum unique numbers discarding duplicates
phrase: accumulate distinct numbers without repetition
test: list=2,2,3,4,4
expect: => i=9 r=0.0 ok=true s="summed unique numbers" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=5,10,5,15
expect: => i=30 r=0.0 ok=true s="summed unique numbers" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var write_idx = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write_idx {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[write_idx] = x;
			write_idx++;
			total += x;
		}
	}
	g.n = write_idx;
	out.i = total;
	gold_text(out, "summed unique numbers");
	out
}
@end
