code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] < limit {
			break;
		}
		count++;
		i--;
	}
	let start = g.n - count;
	for j in count {
		g.res[j] = g.res[start + j];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected tail until: ", count);
	out
}
@end
