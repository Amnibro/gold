code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${limit};
	if lim > g.n { lim = g.n; }
	if lim <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "minimum up to limit: 0");
		return out;
	}
	var min_val = g.res[0];
	var i = 1;
	while i < lim {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i++;
	}
	g.steps += lim;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum up to limit: ", min_val);
	out
}
@end
