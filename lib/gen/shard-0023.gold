code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${min_size};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		gold_text(out, "results grouped");
		return out;
	}
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		var chunk_sum = 0;
		var k = 0;
		while k < sz && i < g.n {
			chunk_sum += g.res[i];
			i++;
			k++;
		}
		g.res[write_idx] = chunk_sum;
		write_idx++;
	}
	g.n = write_idx;
	out.i = write_idx;
	gold_text(out, "results grouped into chunks");
	out
}
@end
