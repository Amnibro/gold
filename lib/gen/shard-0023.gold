test: list=7,10,9,11
expect: => i=3 r=0.0 ok=true s="reversed 3 odd numbers" errors=0 n=4 res=[11,10,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[>..] = [];
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds.push(g.res[i]);
		}
	}
	var odd_idx = odds.len - 1;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = odds[odd_idx];
			odd_idx--;
		}
	}
	g.steps += g.n;
	out.i = odds.len;
	out.s.clear();
	format(out.s, "reversed ", odds.len, " odd numbers");
	out
}
@end
