phrase: longest pairwise increasing streak of adjacent digits
phrase: maximum run of ascending pairwise adjacent digits
test: arg=12354,95432
expect: 4
expect: 1
test: arg=1357
expect: 4
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var digits int[16] = [0; 16];
	var count = 0;
	while x > 0 {
		digits[count] = x % 10;
		count++;
		x /= 10;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var i = count - 1;
	while i > 0 {
		if digits[i] < digits[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i--;
	}
	max_streak
}
@end
