		gold_text(out, "no steps filled");
		return out;
	}
	let start = g.res[0];
	let target = g.res[1];
	var count = 0;
	var cur = start + step;
	g.n = 1;
	while cur < target && g.n < 500 {
		gold_push(g, cur);
		cur += step;
		count++;
	}
	gold_push(g, target);
	out.i = count;
	gold_text(out, "steps filled between boundaries");
	out
}
