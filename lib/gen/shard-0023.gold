slot: streak_len int
test: list=2,2,3,4,4,4 streak_len=2
expect: => i=5 r=0.0 ok=true s="streak modified: 5" errors=0 n=6 res=[3,3,3,5,5,5] cache=0 hits=0
test: list=5,5,5,5,1 streak_len=3
expect: => i=4 r=0.0 ok=true s="streak modified: 4" errors=0 n=5 res=[6,6,6,6,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_run = ${streak_len};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= min_run {
			var k = i;
			while k < j {
				g.res[k] += 1;
				modified++;
				k++;
			}
		}
		i = j;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "streak modified: ", modified);
	out
}
@end
