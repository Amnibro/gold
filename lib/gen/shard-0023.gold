test: list=1,2,3,4 rounds=1
expect: => i=3 r=0.0 ok=true s="loop reduced to: 3" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=1,1,1,1 rounds=2
expect: => i=2 r=0.0 ok=true s="loop reduced to: 2" errors=0 n=2 res=[4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${rounds};
	var r = 0;
	while r < r_max && g.n > 1 {
		var next_res = [0; 512];
		var n_cnt = 0;
		for i in (g.n - 1) {
			next_res[n_cnt] = g.res[i] + g.res[i + 1];
			n_cnt++;
		}
		gold_clear(g);
		for k in n_cnt { gold_push(g, next_res[k]); }
		r++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "loop reduced to: ", g.n);
	out
}
@end
