@entry 92eb59924484587b
kind: step
verb: group
noun: series
modifier: every_other
context: core
phrase: group series every other index items
phrase: partition series every other alternate elements
test: list=10,20,30,40,50,60
expect: => i=3 r=0.0 ok=true s="evens: 3" errors=0 n=6 res=[10,30,50,20,40,60] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="evens: 3" errors=0 n=5 res=[1,3,5,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 512];
	var odds = [0; 512];
	var ne = 0;
	var no = 0;
	var i = 0;
	while i < g.n {
		if i % 2 == 0 {
			evens[ne] = g.res[i];
			ne++;
		} else {
			odds[no] = g.res[i];
			no++;
		}
		i++;
	}
	g.n = 0;
	var j = 0;
	while j < ne { gold_push(g, evens[j]); j++; }
	var k = 0;
	while k < no { gold_push(g, odds[k]); k++; }
	g.steps += g.n;
	out.i = ne;
	out.s.clear();
	format(out.s, "evens: ", ne);
	out
}
@end
