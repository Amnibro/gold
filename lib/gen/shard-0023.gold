phrase: compute integer square root of input
test: arg=25,30
expect: 5
expect: 5
test: arg=100,2
expect: 10
expect: 1
code:
fn ${ID}(n int) int {
	let val = if n < 0 { 0 } else { n };
	if val <= 1 { return val; }
	var root = val / 2;
	while root * root > val {
		root = (root + val / root) / 2;
	}
	while (root + 1) * (root + 1) <= val { root++; }
	root
}
@end
@entry 15ddecfea3b2c236
