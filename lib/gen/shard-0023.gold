test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="rotated reverse: 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated reverse: 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n == 0 { return out; }
	let sh = (s % g.n + g.n) % g.n;
	var buf = [0; 512];
	for i in g.n {
		let new_pos = (i - sh + g.n) % g.n;
		buf[new_pos] = g.res[i];
	}
	for i in g.n {
		g.res[i] = buf[i];
	}
	out.i = sh;
	out.s.clear();
	format(out.s, "rotated reverse: ", sh);
	out
}
@end
