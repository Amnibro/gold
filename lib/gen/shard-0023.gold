slot: hi int
test: list=50,30,10,20,40 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted sequence span 3" errors=0 n=5 res=[50,10,20,30,40] cache=0 hits=0
test: list=9,8,7,6,5 lo=0 hi=2
expect: => i=3 r=0.0 ok=true s="sorted sequence span 3" errors=0 n=5 res=[7,8,9,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start_pos = max(0, ${lo});
	let end_pos = min(g.n - 1, ${hi});
	if start_pos >= end_pos || g.n == 0 { return out; }
	let span_len = end_pos - start_pos + 1;
	for i in span_len {
		for j in start_pos..end_pos - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
		}
	}
	g.steps += span_len * span_len;
	out.i = span_len;
	out.s.clear();
	format(out.s, "sorted sequence span ", span_len);
	out
}
@end
