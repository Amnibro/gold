code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= ${low} && diff <= ${high} {
			g.res[count] = diff;
			count++;
		}
		i++;
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "step transitions in bounds: ", count);
	out
}
@end
