code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${times};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt = 0;
		for j in g.n {
			if g.res[j] == x { cnt++; }
		}
		if cnt >= req {
			kept[kn] = x;
			kn++;
		}
	}
	g.n = 0;
	for i in kn {
		gold_push(g, kept[i]);
	}
	out.i = kn;
	out.s.clear();
	format(out.s, "filtered series: ", kn);
	out
}
@end
