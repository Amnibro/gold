kind: step
verb: rank
noun: evens
modifier: unique
context: retry
phrase: rank unique even retry counts
phrase: order unique even retry attempts
test: list=4,2,4,6,3,8,2
expect: => i=4 r=0.0 ok=true s="ranked unique evens 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,5,10,12,14,12
expect: => i=3 r=0.0 ok=true s="ranked unique evens 3" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens_arr int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var exists = false;
			for j in count {
				if evens_arr[j] == x { exists = true; break; }
			}
			if !exists {
				evens_arr[count] = x;
				count++;
			}
		}
	}
	for i in count {
		for j in 0..count - 1 - i {
			if evens_arr[j] > evens_arr[j + 1] {
				let temp = evens_arr[j];
				evens_arr[j] = evens_arr[j + 1];
				evens_arr[j + 1] = temp;
			}
		}
	}
	for i in count { g.res[i] = evens_arr[i]; }
	g.n = count;
	g.steps += count * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked unique evens ", count);
	out
}
@end
