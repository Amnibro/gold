fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == x {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			total += x;
		}
		i++;
	}
	g.res[0] = total;
	g.n = 1;
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "unique set sum: ", total);
	out
}
