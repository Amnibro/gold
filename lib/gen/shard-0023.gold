code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_val};
	let e = ${end_val};
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= s && x <= e {
			matched++;
		}
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "steps between count: ", matched);
	out
}
@end
