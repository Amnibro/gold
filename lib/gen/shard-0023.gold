@entry 8cf0fcec40888e5d
kind: step
verb: scale
noun: range
modifier: sorted
context: error
phrase: scale range sorted with factor {mult}
phrase: multiply sorted range by {mult}
slot: mult int
test: list=3,6,9 mult=2
expect: => i=18 r=0.0 ok=true s="range scaled" errors=0 n=3 res=[6,12,18] cache=0 hits=0
test: list=9,3 mult=2
expect: => i=0 r=0.0 ok=false s="error: unsorted range" errors=1 n=2 res=[9,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	out.s.clear();
	var sorted = true;
	if g.n > 1 {
		for k in 1..g.n {
			if g.res[k] < g.res[k - 1] {
				sorted = false;
				break;
			}
		}
	}
	if !sorted || m <= 0 {
		gold_fail(g, "range is unsorted or invalid multiplier");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: unsorted range");
		return out;
	}
	for k in g.n {
		g.res[k] *= m;
	}
	out.i = g.res[g.n - 1];
	out.ok = true;
	format(out.s, "range scaled");
	out
}
@end
