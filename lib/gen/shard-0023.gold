fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	var steps = 0;
	var changed = true;
	while changed && steps < 20 {
		changed = false;
		for i in g.n {
			if g.res[i] > limit {
				g.res[i] = g.res[i] / 2;
				changed = true;
			}
		}
		if changed { steps++; }
	}
	out.i = steps;
	gold_text(out, "limited items recursively");
	out
}
@end
