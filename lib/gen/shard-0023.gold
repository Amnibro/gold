	var sum_prod = 0;
	var step_idx = 0;
	while num >= 10 {
		let d0 = num % 10;
		let d1 = (num / 10) % 10;
		if step_idx % 2 == 0 { sum_prod += d0 * d1; }
		num /= 10;
		step_idx++;
	}
	sum_prod
}
