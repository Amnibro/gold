@entry 0f6688eb4ca98df6
kind: step
verb: sort
noun: primes
modifier: with_cache
context: search
phrase: sort prime candidates storing count of primes in cache under {cache_key}
phrase: filter sorted prime search values recording prime tally at {cache_key}
slot: cache_key int
test: list=9,7,4,13,2 cache_key=33
expect: => i=3 r=0.0 ok=true s="sorted primes: 3" errors=0 n=3 res=[2,7,13] cache=1 hits=0
test: list=15,11,6 cache_key=44
expect: => i=1 r=0.0 ok=true s="sorted primes: 1" errors=0 n=1 res=[11] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ck = ${cache_key};
	var p = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p[pn] = x;
				pn++;
			}
		}
	}
	for i in pn {
		for j in pn - 1 {
			if p[j] > p[j + 1] {
				let tmp = p[j];
				p[j] = p[j + 1];
				p[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for i in pn { gold_push(g, p[i]); }
	gold_cache_put(g, ck, pn);
	out.i = pn;
	out.s.clear();
	format(out.s, "sorted primes: ", pn);
	out
}
@end
@entry 7bd9b97c96e5c4c5
kind: step
verb: sort
noun: window
modifier: unique
context: search
phrase: sort unique elements within candidate search window size {win}
phrase: isolate unique search items inside window span {win} sorted
slot: win int
test: list=5,2,5,1,2 win=4
expect: => i=3 r=0.0 ok=true s="unique sorted: 3" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=9,8,7,8 win=3
expect: => i=3 r=0.0 ok=true s="unique sorted: 3" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	let limit = if w < g.n { w } else { g.n };
	var u = [0; 512];
	var un = 0;
	for i in limit {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[un] = x;
			un++;
		}
	}
	// Bubble sort unique
	for i in un {
		for j in un - 1 {
			if u[j] > u[j + 1] {
				let tmp = u[j];
				u[j] = u[j + 1];
				u[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for i in un {
		gold_push(g, u[i]);
	}
	out.i = un;
	out.s.clear();
	format(out.s, "unique sorted: ", un);
	out
}
@end
