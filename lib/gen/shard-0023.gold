fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	out.s.clear();
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		format(out.s, "head empty");
		return out;
	}
	if g.res[0] <= b {
		out.ok = true;
		out.i = g.res[0];
		format(out.s, "head valid: ", g.res[0]);
	} else {
		gold_fail(g, "head exceeds bound");
		out.ok = false;
		out.i = g.res[0];
		format(out.s, "head invalid");
	}
	out
}
@end
@entry 0cbfc990137724d0
kind: step
verb: rank
noun: values
modifier: sorted
context: search
phrase: rank sorted search candidate values matching target {target}
phrase: determine rank of target {target} within sorted candidates
slot: target int
test: list=30,10,20 target=20
expect: => i=1 r=0.0 ok=true s="rank index: 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25,35 target=30
expect: => i=3 r=0.0 ok=true s="rank index: 3" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	// Sort g.res in place
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var rank = 0;
	while rank < g.n && g.res[rank] < tgt {
		rank++;
	}
	out.i = rank;
	out.s.clear();
	format(out.s, "rank index: ", rank);
	out
}
@end
