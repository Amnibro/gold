fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	var u = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[un] = x;
			un++;
		}
	}
	out.s.clear();
	if un >= req {
		out.ok = true;
		out.i = un;
		format(out.s, "unique valid: ", un);
	} else {
		gold_fail(g, "not enough unique items");
