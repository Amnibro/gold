kind: step
verb: swap
noun: duplicates
modifier: first
context: core
phrase: swap first duplicate pair in sequence
phrase: exchange initial duplicate elements position
test: list=10,20,10,30
expect: => i=1 r=0.0 ok=true s="first duplicate pair swapped" errors=0 n=4 res=[10,20,10,30] cache=0 hits=0
test: list=5,8,9,8
expect: => i=1 r=0.0 ok=true s="first duplicate pair swapped" errors=0 n=4 res=[5,8,9,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped = false;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swapped = true;
				break;
			}
		}
		if swapped { break; }
	}
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	if swapped {
		format(out.s, "first duplicate pair swapped");
	} else {
		gold_fail(g, "no duplicates to swap");
		format(out.s, "no duplicates");
	}
	out
}
@end
