test: list=10,30,20
expect: => i=20 r=0.0 ok=true s="ranked by reverse average 20" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test: list=5,15,40,20
expect: => i=20 r=0.0 ok=true s="ranked by reverse average 20" errors=0 n=4 res=[40,20,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n {
		for j in 0..g.n - 1 - i {
			if g.res[j] < g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = avg;
	out.s.clear();
	format(out.s, "ranked by reverse average ", avg);
	out
}
@end
@entry 4872d7b6ec9b24fe
kind: step
verb: dedupe
noun: duplicates
modifier: nested
context: retry
phrase: dedupe nested retry attempt duplicates
phrase: purge duplicate nested retry outcomes
test: list=3,1,3,2,1,4
expect: => i=4 r=0.0 ok=true s="deduped nested duplicates 4" errors=0 n=4 res=[3,1,2,4] cache=0 hits=0
test: list=7,7,8,9,8,10
expect: => i=4 r=0.0 ok=true s="deduped nested duplicates 4" errors=0 n=4 res=[7,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_n = 0;
	for i in g.n {
		let elem = g.res[i];
		var seen = false;
		for j in distinct_n {
			if g.res[j] == elem { seen = true; break; }
		}
		if !seen {
			g.res[distinct_n] = elem;
			distinct_n++;
		}
	}
	g.steps += g.n * distinct_n;
	g.n = distinct_n;
	out.i = distinct_n;
	out.s.clear();
	format(out.s, "deduped nested duplicates ", distinct_n);
	out
}
@end
