@entry ae4a3834a49edf82
kind: step
verb: filter
noun: step
modifier: in_place
context: retry
phrase: filter retry step entries in place by stride {s}
phrase: subsample attempt steps in place by stride {s}
slot: s int
test: list=10,20,30,40,50,60 s=2
expect: => i=3 r=0.0 ok=true s="filtered steps with stride 3" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=1,2,3,4,5,6,7,8,9 s=3
expect: => i=3 r=0.0 ok=true s="filtered steps with stride 3" errors=0 n=3 res=[1,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_stride = ${s};
	if step_stride <= 0 { return out; }
	var write_ptr = 0;
	var read_ptr = 0;
	while read_ptr < g.n {
		g.res[write_ptr] = g.res[read_ptr];
		write_ptr++;
		read_ptr += step_stride;
	}
	g.n = write_ptr;
	g.steps += g.n;
	out.i = write_ptr;
	out.s.clear();
	format(out.s, "filtered steps with stride ", write_ptr);
	out
}
