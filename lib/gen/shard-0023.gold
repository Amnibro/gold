noun: duplicates
modifier: safely
context: aggregate
phrase: scan duplicates safely with cap {cap}
phrase: inspect duplicate items safely below {cap}
slot: cap int
test: list=2,3,2,5,3,10 cap=8
expect: => i=2 r=0.0 ok=true s="found 2 safe duplicates" errors=0 n=6 res=[2,3,2,5,3,10] cache=0 hits=0
test: list=1,1,1,20 cap=15
expect: => i=2 r=0.0 ok=true s="found 2 safe duplicates" errors=0 n=4 res=[1,1,1,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	var dups = 0;
	for i in g.n {
		if g.res[i] < cp {
			for j in (i + 1)..g.n {
				if g.res[i] == g.res[j] { dups++; break; }
			}
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found ", dups, " safe duplicates");
	out
}
