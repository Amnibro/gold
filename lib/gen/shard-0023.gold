	if g.n <= 1 { return out; }
	var write_idx = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "filtered running duplicates ", write_idx);
	out
}
@end
@entry 7496ec8f565d2960
kind: step
verb: join
noun: tail
modifier: between
context: retry
phrase: join tail elements from {lo} to {hi}
phrase: merge trailing attempts from {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,20,30,40,50 lo=1 hi=3
expect: => i=90 r=0.0 ok=true s="joined tail elements span 90" errors=0 n=3 res=[10,90,50] cache=0 hits=0
test: list=1,2,3,4,5,6 lo=2 hi=4
expect: => i=12 r=0.0 ok=true s="joined tail elements span 12" errors=0 n=4 res=[1,2,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start_idx = max(0, ${lo});
	let end_idx = min(g.n - 1, ${hi});
	if start_idx >= end_idx || g.n == 0 { return out; }
	var sum_span = 0;
	for i in start_idx..end_idx + 1 {
		sum_span += g.res[i];
	}
	g.res[start_idx] = sum_span;
	let diff = end_idx - start_idx;
	for i in end_idx + 1..g.n {
		g.res[i - diff] = g.res[i];
	}
	g.n -= diff;
	g.steps += g.n;
	out.i = sum_span;
	out.s.clear();
	format(out.s, "joined tail elements span ", sum_span);
	out
}
@end
