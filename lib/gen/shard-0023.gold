code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if !${p}(x) {
			kept[count] = x;
			count++;
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, kept[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "kept after drop: ", count);
	out
}
@end
@entry 23b243204bcc01b3
kind: step
verb: cache
noun: series
modifier: first
context: core
phrase: cache series first count {count} values
phrase: store leading series items {count} in cache
