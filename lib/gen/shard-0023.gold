code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let safe = min_val >= ${bound};
	out.ok = safe;
	out.i = min_val;
	out.s.clear();
	if safe {
		format(out.s, "safe min: ", min_val);
	} else {
		gold_fail(g, "minimum below safe bound");
		format(out.s, "unsafe min: ", min_val);
	}
	out
}
@end
