	var is_mono = 1;
	if g.n <= 1 {
		out.i = 1;
		return out;
	}
	for i in 0..(g.n - 1) {
		if g.res[i + 1] < g.res[i] {
			is_mono = 0;
			break;
		}
	}
	out.i = is_mono;
	out.s.clear();
	format(out.s, "step monotonic: ", is_mono);
	out
}
