code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	var kept = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		let avg = sum / (i + 1);
		if avg > lim {
			break;
		}
		kept++;
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept items until average: ", kept);
	out
}
@end
