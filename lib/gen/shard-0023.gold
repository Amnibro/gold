expect: => i=4 r=0.0 ok=true s="max run length: 4" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = max(1, ${max_run});
	var ok = true;
	var max_seen = 1;
	if g.n > 0 {
		var cur_run = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
				if cur_run > max_seen { max_seen = cur_run; }
			} else {
				cur_run = 1;
			}
		}
		if max_seen > mr { ok = false; }
	}
	g.steps += g.n;
	out.ok = ok;
	out.i = max_seen;
	out.s.clear();
	format(out.s, "max run length: ", max_seen);
	out
}
@end
