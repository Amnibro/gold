fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "normalize maximum every other: 0");
		return out;
	}
	var max_val = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
		i += 2;
	}
	var j = 0;
	while j < g.n {
		g.res[j] = max_val - g.res[j];
		j += 2;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "normalized maximum every other: ", max_val);
	out
}
@end
