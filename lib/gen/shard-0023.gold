fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	var i = 0;
	while i < g.n {
		for a in ${attempts} {
			g.res[i] += 1;
		}
		modified++;
		i += 2;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "range retries alternate: ", modified);
	out
}
