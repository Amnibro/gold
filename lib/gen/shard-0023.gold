code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var clamped_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > cap {
			g.res[i] = cap;
			clamped_cnt++;
			gold_cache_put(g, x, cap);
		}
	}
	out.i = clamped_cnt;
	out.s.clear();
	format(out.s, "clamped odds: ", clamped_cnt);
	out
}
@end
@entry f87d6a63d3e6b342
kind: step
verb: rotate
noun: number
modifier: any
context: search
phrase: rotate search results by position offset of {offset}
phrase: shift candidate result numbers cyclically by {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="rotated number: 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=2,4,6 offset=2
expect: => i=2 r=0.0 ok=true s="rotated number: 2" errors=0 n=3 res=[4,6,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 { return out; }
	let sh = (off % g.n + g.n) % g.n;
	var buf = [0; 512];
	for i in g.n {
		let new_pos = (i + sh) % g.n;
		buf[new_pos] = g.res[i];
	}
	for i in g.n { g.res[i] = buf[i]; }
	out.i = sh;
	out.s.clear();
	format(out.s, "rotated number: ", sh);
	out
}
@end
