	var out = v;
	let ms = ${min_sum};
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	if sum < ms && g.n < 512 {
		let diff = ms - sum;
		gold_push(g, diff);
		sum += diff;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "final sum: ", sum);
	out
}
@end
