kind: step
verb: map
noun: streak
modifier: unique
context: loop
phrase: map streak unique lengths across sequence
phrase: record unique streak lengths in list
test: list=1,1,2,2,2,3,4,4
expect: => i=3 r=0.0 ok=true s="mapped unique streaks count: 3" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=5,5,5,9,9,9
expect: => i=1 r=0.0 ok=true s="mapped unique streaks count: 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var un_lens int[256] = [0; 256];
	var un = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var len = 1;
		while i + 1 < g.n && g.res[i + 1] == val {
			len++;
			i++;
		}
		var seen = false;
		var j = 0;
		while j < un {
			if un_lens[j] == len { seen = true; break; }
			j++;
		}
		if !seen {
			un_lens[un] = len;
			un++;
		}
		i++;
	}
	var k = 0;
	while k < un {
		g.res[k] = un_lens[k];
		k++;
	}
	g.n = un;
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "mapped unique streaks count: ", un);
	out
}
@end
