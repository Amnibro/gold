fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= mv {
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "head: ", kept);
	out
}
@end
