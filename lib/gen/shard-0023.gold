@entry 4210fbe45bdc080e
kind: step
verb: find
noun: list
modifier: with_cache
context: core
phrase: find list item with cache lookup {target}
phrase: locate value in list using cache {target}
slot: target int
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="found at index: 2" errors=0 n=5 res=[10,20,30,40,50] cache=1 hits=0
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=false s="not found" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key_val = ${target};
	let cached_idx, ok = gold_cache_get(g, key_val);
	if ok {
		out.i = cached_idx;
		out.s.clear();
		format(out.s, "cache hit at index: ", cached_idx);
		return out;
	}
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == key_val {
			found_idx = i;
			break;
		}
	}
	if found_idx >= 0 {
		gold_cache_put(g, key_val, found_idx);
		out.i = found_idx;
		out.s.clear();
		format(out.s, "found at index: ", found_idx);
	} else {
		out.i = -1;
		out.ok = false;
		out.s.clear();
		format(out.s, "not found");
	}
	out
}
@end
