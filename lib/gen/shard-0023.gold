code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${maxdigits};
	var limit = 1;
	for _ in md {
		limit *= 10;
	}
	var valid = true;
	for k in g.n {
		if g.res[k] >= limit {
			valid = false;
			break;
		}
	}
	out.s.clear();
	if !valid {
		gold_fail(g, "number exceeds maximum digits");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: digit overflow");
		return out;
	}
	out.i = g.n;
	out.ok = true;
	format(out.s, "all digits nested properly");
	out
}
@end
