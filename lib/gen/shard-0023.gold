code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let mid = g.n / 2;
var left = mid;
var right = g.n - 1;
while left < right {
	let t = g.res[left];
	g.res[left] = g.res[right];
	g.res[right] = t;
	left++;
	right--;
}
for i in mid..g.n { g.res[i] = ${f}(g.res[i]); }
out.i = g.n - mid;
out.s.clear();
format(out.s, "transformed tail of ", out.i, " elements");
out
}
@end
