@entry 033e943102bf7a4b
kind: step
verb: reverse
noun: tail
modifier: sorted
context: loop
slot: k int
phrase: reverse tail sorted last {k} elements
phrase: sort reverse last {k} tail elements
test: list=5,1,9,3,7 k=3
expect: => i=3 r=0.0 ok=true s="reversed tail sorted count: 3" errors=0 n=5 res=[5,1,9,7,3] cache=0 hits=0
test: list=10,2,8,4 k=2
expect: => i=2 r=0.0 ok=true s="reversed tail sorted count: 2" errors=0 n=4 res=[10,2,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${k};
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	let start = g.n - k;
	var i = start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] < g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += k * k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed tail sorted count: ", k);
	out
}
@end
