kind: step
verb: rotate
noun: checkpoint
modifier: each
context: text
phrase: rotate each lowercase letter forward by shift {shift}
phrase: advance every alphabetic character by offset {shift}
slot: shift int
test: text="abcde" shift=2
expect: => i=5 r=0.0 ok=true s="cdefg" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" shift=1
expect: => i=5 r=0.0 ok=true s="ifmmp" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${shift};
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let base = c - 'a';
			let next = (base + shift) % 26;
			out.s[i] = (next + 'a') as byte;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
