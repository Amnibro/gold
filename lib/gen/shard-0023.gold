slot: limit int
test: list=4,9,10,16,20 limit=4
expect: => i=3 r=0.0 ok=true s="counted 3 square numbers" errors=0 n=5 res=[4,9,10,16,20] cache=0 hits=0
test: list=1,2,3,4,5 limit=5
expect: => i=2 r=0.0 ok=true s="counted 2 square numbers" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = min(g.n, max(0, ${limit}));
	var count = 0;
	for i in lim {
		if ${ID}_is_sq(g.res[i]) { count++; }
	}
	g.steps += lim;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " square numbers");
	out
}
@end
@entry 293158fb39260018
kind: step
verb: map
noun: middle
modifier: with_cache
context: aggregate
phrase: map middle with cache using scale {scale}
phrase: transform middle elements with cache factor {scale}
slot: scale int
test: list=10,2,3,20 scale=3
expect: => i=2 r=0.0 ok=true s="mapped 2 middle items" errors=0 n=4 res=[10,6,9,20] cache=2 hits=0
test: list=5,4,50 scale=2
expect: => i=1 r=0.0 ok=true s="mapped 1 middle items" errors=0 n=3 res=[5,8,50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	if g.n <= 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "middle too short");
		return out;
	}
	var mapped = 0;
	for i in 1..(g.n - 1) {
		let val, hit = gold_cache_get(g, g.res[i]);
		if hit {
			g.res[i] = val;
		} else {
			let res_val = g.res[i] * s;
			gold_cache_put(g, g.res[i], res_val);
			g.res[i] = res_val;
		}
		mapped++;
	}
	g.steps += mapped;
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped ", mapped, " middle items");
	out
}
@end
@entry b081db8b43686456
kind: step
verb: swap
noun: number
modifier: sorted
context: aggregate
phrase: swap number sorted adjacent out of order with bound {bound}
phrase: exchange adjacent sorted numbers within bound {bound}
slot: bound int
test: list=5,2,4,1 bound=4
expect: => i=3 r=0.0 ok=true s="performed 3 swaps" errors=0 n=4 res=[2,4,1,5] cache=0 hits=0
test: list=10,3,8 bound=10
expect: => i=2 r=0.0 ok=true s="performed 2 swaps" errors=0 n=3 res=[3,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var swaps = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] && (g.res[i] - g.res[i + 1]) <= b {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " swaps");
	out
}
@end
@entry 317324df36ca2c37
kind: step
verb: swap
noun: budget
modifier: unique
context: aggregate
phrase: swap budget unique pairs within limit {limit}
phrase: exchange unique budget elements under limit {limit}
slot: limit int
test: list=10,50,20,50,30 limit=40
expect: => i=1 r=0.0 ok=true s="budget swap result: 1" errors=0 n=5 res=[30,50,20,50,10] cache=0 hits=0
test: list=5,10,15,20 limit=25
expect: => i=1 r=0.0 ok=true s="budget swap result: 1" errors=0 n=4 res=[20,10,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var first_idx = -1;
	var last_idx = -1;
	for i in g.n {
		if g.res[i] < lim {
			var count = 0;
			for j in g.n { if g.res[j] == g.res[i] { count++; } }
			if count == 1 {
				if first_idx < 0 { first_idx = i; }
				last_idx = i;
			}
		}
	}
	if first_idx >= 0 && last_idx >= 0 && first_idx != last_idx {
		let tmp = g.res[first_idx];
		g.res[first_idx] = g.res[last_idx];
		g.res[last_idx] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "budget swap result: ", out.i);
	out
}
@end
@entry 6fc1748e302caf5f
kind: step
verb: keep
noun: minimum
modifier: nested
context: aggregate
phrase: keep minimum nested block size {block_size}
phrase: filter minimum of each nested chunk {block_size}
slot: block_size int
test: list=5,2,8,1,9,4 block_size=2
expect: => i=3 r=0.0 ok=true s="kept 3 chunk minimums" errors=0 n=3 res=[2,1,4] cache=0 hits=0
test: list=10,20,5,30 block_size=3
expect: => i=2 r=0.0 ok=true s="kept 2 chunk minimums" errors=0 n=2 res=[5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = max(1, ${block_size});
	var wr = 0;
	var i = 0;
	while i < g.n {
		let end_idx = min(g.n, i + bs);
		var mn = g.res[i];
		for j in (i + 1)..end_idx {
			if g.res[j] < mn { mn = g.res[j]; }
		}
		g.res[wr] = mn;
		wr++;
		i += bs;
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "kept ", wr, " chunk minimums");
	out
}
@end
