kind: step
verb: merge
noun: histogram
modifier: none
context: core
phrase: merge histogram summary counts
phrase: construct histogram frequencies without grouping
test: list=3,1,3,2,1,3
expect: => i=3 r=0.0 ok=true s="distinct: 3" errors=0 n=6 res=[3,3,1,2,2,1] cache=0 hits=0
test: list=7,7,8
expect: => i=2 r=0.0 ok=true s="distinct: 2" errors=0 n=4 res=[7,2,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals = [0; 256];
	var counts = [0; 256];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in u {
			if vals[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			counts[idx]++;
		} else if u < 256 {
			vals[u] = x;
			counts[u] = 1;
			u++;
		}
	}
	g.n = 0;
	for j in u {
		gold_push(g, vals[j]);
		gold_push(g, counts[j]);
	}
	out.i = u;
	out.s.clear();
	format(out.s, "distinct: ", u);
	out
}
@end
