code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n < 2 {
		gold_fail(g, "insufficient items to move minimum");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: insufficient items");
		return out;
	}
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] {
			min_idx = k;
		}
	}
	let min_val = g.res[min_idx];
	let last_val = g.res[g.n - 1];
	g.res[min_idx] = last_val;
	g.res[g.n - 1] = min_val;
	out.i = min_val;
	out.ok = true;
	format(out.s, "minimum moved to last");
	out
}
@end
