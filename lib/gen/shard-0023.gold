test: list=4,15,9,20,11,18
expect: => i=2 r=0.0 ok=true s="filtered maximum reverse count: 2" errors=0 n=2 res=[20,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	var max_val = -1000000;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if x >= max_val {
			kept[kn] = x;
			kn++;
			max_val = x;
		}
		i--;
	}
	var j = 0;
	while j < kn {
		g.res[j] = kept[kn - 1 - j];
		j++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "filtered maximum reverse count: ", kn);
	out
}
@end
