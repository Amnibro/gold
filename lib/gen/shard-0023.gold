fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var kept = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x <= lim {
			var r = 0;
			while r * r <= x {
				if r * r == x {
					kept[count] = x;
					count++;
					break;
				}
				r++;
			}
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, kept[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "squares found: ", count);
