fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[..200] = "";
	var dups = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if res.len > 0 && res[res.len - 1] == c {
			dups++;
		} else {
			if res.len < 200 { res.push(c); }
		}
		i++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	gold_push(g, dups);
	out.i = dups;
	out
}
