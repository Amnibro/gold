kind: step
verb: emboss
noun: wood
modifier: coarse
context: texture
phrase: emboss coarse wood grain with seed {u}
phrase: coarse wood grain relief from seed {u}
slot: u int
model: stripes c=4; noise c=4 u=${u}; contrast a=1.5; blur
test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="wood" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.067 max=1 sum8=36191 hash=692165
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="wood" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=137165 hash=745065
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 4) % 2) as real;
		}
	}
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "wood");
	out
}
@end
