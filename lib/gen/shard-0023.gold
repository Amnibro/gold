test: list=2,3,5,8
expect: => i=3 r=0.0 ok=true s="reverse primes: 3" errors=0 n=3 res=[5,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes: int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[count] = x;
			count++;
		}
	}
	g.n = count;
	for k in count {
		g.res[k] = primes[count - 1 - k];
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reverse primes: ", count);
	out
}
@end
