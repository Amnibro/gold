test: list=1,2,99,4,5 cp=99
expect: => i=3 r=0.0 ok=true s="checkpoint retained: 3" errors=0 n=3 res=[99,4,5] cache=0 hits=0
test: list=10,20,30 cp=50
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = -1;
	for i in g.n {
		if g.res[i] == ${cp} {
			pos = i;
			break;
		}
	}
	if pos < 0 {
		gold_fail(g, "checkpoint not found");
		out.ok = false;
		return out;
	}
	let count = g.n - pos;
	for i in count {
		g.res[i] = g.res[pos + i];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "checkpoint retained: ", count);
	out
}
@end
