fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts = [0; 512];
	var ucount = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var p = 0;
		while p < i {
			if g.res[p] == x { seen = true; break; }
			p++;
		}
		if !seen {
			var cnt = 0;
			var q = 0;
			while q < g.n {
				if g.res[q] == x { cnt++; }
				q++;
			}
			counts[ucount] = cnt;
