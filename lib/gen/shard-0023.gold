kind: step
verb: measure
noun: middle
modifier: each
context: core
phrase: measure middle each distance offset
phrase: gauge distance from middle each element
test: list=2,8,4,10,6
expect: => i=14 r=0.0 ok=true s="mid diff sum: 14" errors=0 n=5 res=[2,4,0,6,2] cache=0 hits=0
test: list=15,25,35
expect: => i=20 r=0.0 ok=true s="mid diff sum: 20" errors=0 n=3 res=[10,0,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	let mid_idx = g.n / 2;
	let mid_val = g.res[mid_idx];
	var sum_dist = 0;
	for i in g.n {
		let diff = g.res[i] - mid_val;
		let d = if diff < 0 { -diff } else { diff };
		g.res[i] = d;
		sum_dist += d;
	}
	out.i = sum_dist;
	out.s.clear();
	format(out.s, "mid diff sum: ", sum_dist);
	out
}
@end
