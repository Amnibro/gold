@entry 2c0c095089f7c12d
kind: step
verb: clamp
noun: odds
modifier: until
context: text
phrase: clamp odd indexed characters until limit {lim}
phrase: restrict odd positions in text until {lim}
slot: lim int
test: text="abcdefgh" lim=3
expect: => i=3 r=0.0 ok=true s="ace" errors=0 n=0 res=[] cache=0 hits=0
test: text="testing" lim=2
expect: => i=2 r=0.0 ok=true s="ts" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if lim < 0 {
		gold_fail(g, "negative clamp limit");
		out.ok = false;
		return out;
	}
	var kept byte[..200] = "";
	var i = 0;
	while i < out.s.len && kept.len < lim {
		if i % 2 == 0 {
			kept.push(out.s[i]);
		}
		i++;
	}
	g.steps += i;
	out.s.clear();
	for b in kept { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
