noun: loop
modifier: each
context: sort
phrase: collect each loop length from sorted permutation cycles
phrase: gather cycle lengths from each sorted mapping
test: list=30,10,20
expect: => i=1 r=0.0 ok=true s="collected 1 loop lengths" errors=0 n=1 res=[3] cache=0 hits=0
test: list=4,1,3,2
expect: => i=2 r=0.0 ok=true s="collected 2 loop lengths" errors=0 n=2 res=[3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
var orig int[512] = [0; 512];
for i in g.n { orig[i] = g.res[i]; }
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
var perm int[512] = [0; 512];
for i in g.n {
	for j in g.n {
		if orig[i] == g.res[j] { perm[i] = j; break; }
	}
}
var vis bool[512] = [false; 512];
var loop_lens int[512] = [0; 512];
var total_loops = 0;
for i in g.n {
	if !vis[i] {
		var cur = i;
		var len = 0;
		while !vis[cur] {
			vis[cur] = true;
			cur = perm[cur];
			len++;
		}
		loop_lens[total_loops] = len;
		total_loops++;
	}
}
for i in total_loops { g.res[i] = loop_lens[i]; }
g.n = total_loops;
out.i = total_loops;
out.s.clear();
format(out.s, "collected ", total_loops, " loop lengths");
out
}
@end
