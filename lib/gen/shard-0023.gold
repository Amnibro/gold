fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${target_min};
	let hi = ${target_max};
	var sum_val = 0;
	for i in g.n { sum_val += g.res[i]; }
	if sum_val < lo { sum_val = lo; }
	if sum_val > hi { sum_val = hi; }
	out.i = sum_val;
	out.s.clear();
	format(out.s, "normalized total: ", sum_val);
	out
}
@end
