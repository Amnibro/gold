expect: => i=2 r=0.0 ok=true s="chunks: 2" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k_sz = ${cluster_k};
	if k_sz <= 0 || g.n == 0 { return out; }
	var chunk_sums = [0; 512];
	var chunk_n = 0;
	var idx_c = 0;
	while idx_c < g.n {
		var sub_s = 0;
		var j = 0;
		while j < k_sz && idx_c < g.n {
			sub_s += g.res[idx_c];
			idx_c++;
			j++;
		}
		chunk_sums[chunk_n] = sub_s;
		chunk_n++;
	}
	gold_clear(g);
	for i in chunk_n { gold_push(g, chunk_sums[i]); }
	out.i = chunk_n;
	out.s.clear();
	format(out.s, "chunks: ", chunk_n);
	out
}
@end
