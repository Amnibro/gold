fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = min(g.n, max(1, ${count}));
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no results to merge");
		return out;
	}
	var total = 0;
	for i in k { total += g.res[i]; }
	g.res[0] = total;
	var wr = 1;
	for i in k..g.n {
		g.res[wr] = g.res[i];
		wr++;
	}
	g.n = wr;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "merged first ", k, " to ", total);
	out
}
@end
