code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var lower_count = 0;
	for k in g.n {
		if g.res[k] <= limit {
			let tmp = g.res[lower_count];
			g.res[lower_count] = g.res[k];
			g.res[k] = tmp;
			lower_count++;
		}
	}
	g.steps += g.n;
	out.i = lower_count;
	out.s.clear();
	format(out.s, "split number count: ", lower_count);
	out
}
@end
