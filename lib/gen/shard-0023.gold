phrase: restrict candidate checkpoint values between range {floor} towards {ceiling}
slot: floor int
slot: ceiling int
test: list=5,15,35,50 floor=10 ceiling=30
expect: => i=3 r=0.0 ok=true s="checkpoints adjusted: 3" errors=0 n=4 res=[10,15,30,30] cache=0 hits=0
test: list=2,8 floor=5 ceiling=10
expect: => i=1 r=0.0 ok=true s="checkpoints adjusted: 1" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let ce = ${ceiling};
	var adjusted = 0;
	for i in g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			adjusted++;
		} else if g.res[i] > ce {
			g.res[i] = ce;
			adjusted++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "checkpoints adjusted: ", adjusted);
	out
}
@end
