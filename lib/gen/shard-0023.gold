phrase: swap histogram values recursively with depth {depth}
phrase: recursively swap histogram entries for depth {depth}
test: list=1,2,3,4,5 depth=2
expect: => i=2 r=0.0 ok=true s="recursively swapped: 2" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30 depth=0
expect: => i=0 r=0.0 ok=true s="recursively swapped: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	let limit = if ${depth} < g.n / 2 { ${depth} } else { g.n / 2 };
	for d in limit {
		let i = d;
		let j = g.n - 1 - d;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		swaps++;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "recursively swapped: ", swaps);
	out
}
@end
