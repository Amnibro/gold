@entry 585f124ac620c9c7
kind: step
verb: scale
noun: primes
modifier: in_reverse
context: error
phrase: scale reverse primes factor {scale}
phrase: reverse multiply elements by {scale}
slot: scale int
test: list=2,3,5 scale=2
expect: => i=10 r=0.0 ok=true s="reversed and scaled" errors=0 n=3 res=[10,6,4] cache=0 hits=0
test: list=2,3 scale=0
expect: => i=0 r=0.0 ok=false s="error: invalid scale" errors=1 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${scale};
	out.s.clear();
	if s <= 0 {
		gold_fail(g, "non positive scale factor");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: invalid scale");
		return out;
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	for k in g.n {
		g.res[k] *= s;
	}
	out.i = g.res[0];
	out.ok = true;
	format(out.s, "reversed and scaled");
	out
}
@end
