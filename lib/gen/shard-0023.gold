fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
if g.n == 0 { return out; }
var packed int[512] = [0; 512];
var pn = 0;
var cur_val = g.res[0];
var cur_cnt = 1;
for i in 1..g.n {
	if g.res[i] == cur_val {
		cur_cnt++;
	} else {
		packed[pn] = cur_val;
		packed[pn + 1] = cur_cnt;
		pn += 2;
		cur_val = g.res[i];
		cur_cnt = 1;
	}
}
packed[pn] = cur_val;
packed[pn + 1] = cur_cnt;
pn += 2;
for i in pn { g.res[i] = packed[i]; }
g.n = pn;
out.i = pn / 2;
out.s.clear();
format(out.s, "collapsed into ", out.i, " streaks");
out
}
@end
