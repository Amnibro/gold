	var out = v;
	out.s.clear();
	format(out.s, "rep_fn: [");
	var cnt = 0;
	for i in g.n {
		var cur = g.res[i];
		while cur <= b {
			if cnt > 0 { format(out.s, ", "); }
			format(out.s, cur);
			cnt++;
			cur *= 2;
			if cur == 0 { break; }
		}
	}
	format(out.s, "]");
	out.i = cnt;
	g.steps += g.n;
	out
}
