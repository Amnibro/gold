code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${count} < g.n { ${count} } else { g.n };
	let start = g.n - k;
	for i in k / 2 {
		let a = start + i;
		let b = g.n - 1 - i;
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
	}
	out.i = k;
	out.s.clear();
	format(out.s, "reversed last range: ", k);
	out
}
@end
