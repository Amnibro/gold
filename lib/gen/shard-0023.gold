phrase: reverse gaps between bounds {low} to {high}
phrase: collect differences within {low} through {high}
test: list=10,15,30,34 low=3 high=10
expect: => i=2 r=0.0 ok=true s="gaps between count: 2" errors=0 n=2 res=[5,4] cache=0 hits=0
test: list=1,8,12,25 low=2 high=6
expect: => i=1 r=0.0 ok=true s="gaps between count: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let gap = if d < 0 { -d } else { d };
		if gap >= lo && gap <= hi {
			g.res[count] = gap;
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps between count: ", count);
	out
}
@end
@entry 3fd10de3f46dd2b0
kind: step
verb: swap
noun: primes
modifier: safely
context: aggregate
phrase: swap primes safely invert signs
phrase: negate prime numbers in results
test: list=4,5,6,7
expect: => i=2 r=0.0 ok=true s="negated primes count: 2" errors=0 n=4 res=[4,-5,6,-7] cache=0 hits=0
test: list=2,3,8
expect: => i=2 r=0.0 ok=true s="negated primes count: 2" errors=0 n=3 res=[-2,-3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				g.res[i] = -x;
				count++;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "negated primes count: ", count);
	out
}
@end
