code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var run = 0;
	var found_idx = -1;
	for k in g.n {
		run += g.res[k];
		if run >= th {
			found_idx = k;
			break;
		}
	}
	out.s.clear();
	if found_idx < 0 {
		gold_fail(g, "running counter failed to reach threshold");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: threshold not reached");
		return out;
	}
	out.i = found_idx;
	out.ok = true;
	format(out.s, "threshold reached at step ", found_idx);
	out
}
@end
