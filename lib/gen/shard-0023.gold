@entry f1e060d67a9b1e4c
kind: step
verb: group
noun: loop
modifier: at_least
context: sort
phrase: group permutation loops with length at least {min_size}
phrase: filter sorted cycle loops having size at least {min_size}
slot: min_size int
test: list=30,10,20 min_size=2
expect: => i=1 r=0.0 ok=true s="matched 1 loops of size" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,1,3,2 min_size=3
expect: => i=1 r=0.0 ok=true s="matched 1 loops of size" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
var orig int[512] = [0; 512];
for i in g.n { orig[i] = g.res[i]; }
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
var perm int[512] = [0; 512];
for i in g.n {
	for j in g.n {
		if orig[i] == g.res[j] { perm[i] = j; break; }
	}
}
var vis bool[512] = [false; 512];
let req = ${min_size};
var big_loops = 0;
for i in g.n {
	if !vis[i] {
		var cur = i;
		var len = 0;
		while !vis[cur] {
			vis[cur] = true;
			cur = perm[cur];
			len++;
		}
		if len >= req { big_loops++; }
	}
}
out.i = big_loops;
out.s.clear();
format(out.s, "matched ", big_loops, " loops of size");
out
}
@end
