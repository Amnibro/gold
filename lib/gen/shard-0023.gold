expect: => i=6 r=0.0 ok=true s="nested repeated items: 6" errors=0 n=6 res=[3,3,3,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	var rep int[512] = [0; 512];
	var rn = 0;
	var i = 0;
	while i < g.n {
		var c = 0;
		while c < reps && rn < 512 {
			rep[rn] = g.res[i];
			rn++;
			c++;
		}
		i++;
	}
	var j = 0;
	while j < rn {
		g.res[j] = rep[j];
		j++;
	}
	g.n = rn;
	g.steps += g.n;
	out.i = rn;
	out.s.clear();
	format(out.s, "nested repeated items: ", rn);
	out
}
@end
