@entry 32654575a4350034
kind: step
verb: shift
noun: words
modifier: all
context: core
phrase: shift words all positions by {dist}
phrase: rotate words all elements offset {dist}
slot: dist int
test: list=1,2,3,4,5 dist=2
expect: => i=2 r=0.0 ok=true s="rotated: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 dist=1
expect: => i=1 r=0.0 ok=true s="rotated: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let d = (${dist} % g.n + g.n) % g.n;
	var tmp = [0; 512];
	var i = 0;
	while i < g.n {
		tmp[(i + d) % g.n] = g.res[i];
		i++;
	}
	var j = 0;
	while j < g.n {
		g.res[j] = tmp[j];
		j++;
	}
	g.steps += g.n;
	out.i = d;
	out.s.clear();
	format(out.s, "rotated: ", d);
	out
}
@end
@entry 9034c10289dd2b48
kind: step
verb: cache
noun: tally
modifier: at_least
context: core
phrase: cache tally at least frequency {threshold}
phrase: store tally at least count {threshold}
slot: threshold int
test: list=4,7,4,8,4,7 threshold=2
expect: => i=2 r=0.0 ok=true s="tallies: 2" errors=0 n=6 res=[4,7,4,8,4,7] cache=2 hits=0
test: list=9,9,9,2,3 threshold=3
expect: => i=1 r=0.0 ok=true s="tallies: 1" errors=0 n=5 res=[9,9,9,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var saved = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var p = 0;
		while p < i {
			if g.res[p] == x { seen = true; break; }
			p++;
		}
		if !seen {
			var cnt = 0;
			var q = 0;
			while q < g.n {
				if g.res[q] == x { cnt++; }
				q++;
			}
			if cnt >= th {
				gold_cache_put(g, x, cnt);
				saved++;
			}
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = saved;
	out.s.clear();
	format(out.s, "tallies: ", saved);
	out
}
@end
