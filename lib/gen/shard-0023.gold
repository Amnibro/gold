	var i = 0;
	while i < g.n {
		if g.res[i] > lim {
			g.res[i] = 1;
		} else {
			g.res[i] = 0;
		}
		modified++;
		i += 2;
	}
	out.i = modified;
	gold_text(out, "split alternate threshold");
	out
}
@end
