fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n && ${p}(g.res[idx]) {
		idx++;
	}
	g.n = idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "prefix length: ", idx);
	out
}
@end
