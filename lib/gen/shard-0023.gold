slot: k int
test: list=1,2,3,4,5,6 k=1
expect: => i=1 r=0.0 ok=true s="rotated prefix elements 1" errors=0 n=6 res=[3,1,2,4,5,6] cache=0 hits=0
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="rotated prefix elements 1" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${k};
	let half = g.n / 2;
	if half <= 1 || sh <= 0 { return out; }
	let rot = sh % half;
	for step in rot {
		let last_prefix = g.res[half - 1];
		var idx = half - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last_prefix;
	}
	g.steps += rot * half;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated prefix elements ", rot);
	out
}
@end
