@entry bd0c043f3113bcd9
kind: step
verb: rank
noun: runs
modifier: in_reverse
context: filter
phrase: rank consecutive runs in reverse above length {minlen}
phrase: filter run sequences backwards satisfying length {minlen}
slot: minlen int
test: list=1,1,2,3,3,3,4 minlen=2
expect: => i=5 r=0.0 ok=true s="reverse runs: 5" errors=0 n=5 res=[3,3,3,1,1] cache=0 hits=0
test: list=5,5,5,6,7,7 minlen=3
expect: => i=3 r=0.0 ok=true s="reverse runs: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${minlen};
	var kept = [0; 512];
	var kn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var run = 0;
		var j = i;
		while j >= 0 && g.res[j] == val { run++; j--; }
		if run >= ml {
			for k in run { kept[kn] = val; kn++; }
		}
		i = j;
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "reverse runs: ", kn);
	out
}
@end
