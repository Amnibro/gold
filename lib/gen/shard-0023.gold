phrase: reverse subfunction execution order with retry budget {max_retries}
phrase: invert subfunction steps with retry allowance {max_retries}
test: list=1,2,3,4,5 max_retries=3
expect: => i=5 r=0.0 ok=true s="subfunction reverse completed: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
