@entry 19e597b2d8677dc8
kind: step
verb: find
noun: total
modifier: nested
context: core
phrase: find total nested accumulation scaling depth {depth}
phrase: compute total nested summation across depth {depth}
slot: depth int
test: list=2,4,6 depth=2
expect: => i=36 r=0.0 ok=true s="nested sum: 36" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=5,10 depth=3
expect: => i=90 r=0.0 ok=true s="nested sum: 90" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var tot = 0;
	var step = 1;
	while step <= d {
		var i = 0;
		while i < g.n {
			tot += g.res[i] * step;
			i++;
		}
		step++;
	}
	g.steps += g.n * d;
	out.i = tot;
	out.s.clear();
	format(out.s, "nested sum: ", tot);
	out
}
@end
