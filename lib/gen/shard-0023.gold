phrase: coalesce search candidate numbers summing pairs up to {cap}
slot: cap int
test: list=10,15,30,5 cap=25
expect: => i=3 r=0.0 ok=true s="joined numbers: 3" errors=0 n=3 res=[25,30,5] cache=0 hits=0
test: list=2,3,4,5 cap=6
expect: => i=3 r=0.0 ok=true s="joined numbers: 3" errors=0 n=3 res=[5,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var buf = [0; 512];
	var bn = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && (g.res[i] + g.res[i + 1] <= c) {
			buf[bn] = g.res[i] + g.res[i + 1];
			bn++;
			i += 2;
		} else {
			buf[bn] = g.res[i];
			bn++;
			i++;
		}
	}
	g.n = 0;
	for j in bn {
		gold_push(g, buf[j]);
	}
	out.i = bn;
	out.s.clear();
	format(out.s, "joined numbers: ", bn);
	out
}
@end
