fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in 0..g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let swp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = swp;
