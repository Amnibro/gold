fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let quota = ${max_primes};
	var kept = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && count < quota {
				kept[count] = x;
				count++;
			}
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, kept[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "primes limited: ", count);
	out
}
@end
