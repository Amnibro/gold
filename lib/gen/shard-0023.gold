fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${block_size};
	if bsz <= 0 { return out; }
	var chunks = 0;
	var idx = 0;
	while idx < g.n {
		var s = 0;
		var j = 0;
		while j < bsz && idx + j < g.n {
			s += g.res[idx + j];
			j++;
		}
		gold_cache_put(g, chunks, s);
		chunks++;
		idx += bsz;
	}
	g.steps += g.n;
	out.i = chunks;
	out.s.clear();
	format(out.s, "chunks: ", chunks);
	out
}
@end
