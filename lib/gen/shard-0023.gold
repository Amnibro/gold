fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	let first = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	g.res[0] = first;
	g.res[1] = max_val;
	g.n = 2;
	out.i = first + max_val;
	out.s.clear();
	format(out.s, "paired first with max: ", max_val);
	out
}
