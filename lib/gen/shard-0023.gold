@entry 83bef92e9830dba9
kind: step
verb: search
noun: total
modifier: pairwise
context: format
phrase: format pairwise search for matching sum {target}
phrase: display pair of adjacent items matching target sum {target}
slot: target int
test: list=3,7,2,8 target=10
expect: => i=0 r=0.0 ok=true s="pair: 3 + 7 = 10" errors=0 n=4 res=[3,7,2,8] cache=0 hits=0
test: list=1,4,6,9 target=15
expect: => i=2 r=0.0 ok=true s="pair: 6 + 9 = 15" errors=0 n=4 res=[1,4,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let t = ${target};
	var out = v;
	out.s.clear();
	var found = false;
	var idx = 0;
	while idx + 1 < g.n {
		if g.res[idx] + g.res[idx + 1] == t {
			found = true;
			break;
		}
		idx++;
	}
	if found {
		format(out.s, "pair: ", g.res[idx], " + ", g.res[idx + 1], " = ", t);
		out.i = idx;
	} else {
		format(out.s, "none");
		out.i = -1;
	}
	g.steps += g.n;
	out
}
@end
