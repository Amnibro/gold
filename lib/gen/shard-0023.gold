test: list=5,10,15,20 max_budget=25
expect: => i=15 r=0.0 ok=true s="budget spent: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,3,4,5,6 max_budget=10
expect: => i=9 r=0.0 ok=true s="budget spent: 9" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b_max = ${max_budget};
	var spent = 0;
	var kept_cnt = 0;
	while kept_cnt < g.n {
		if spent + g.res[kept_cnt] > b_max { break; }
		spent += g.res[kept_cnt];
		kept_cnt++;
	}
	g.n = kept_cnt;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent: ", spent);
	out
}
@end
