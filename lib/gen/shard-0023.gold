phrase: display pairwise validated elements with difference limit {max_diff}
slot: max_diff int
test: list=2,5,8,15 max_diff=4
expect: => i=1 r=0.0 ok=true s="valid_pairs: [(2,5)]" errors=0 n=4 res=[2,5,8,15] cache=0 hits=0
test: list=10,12,18,20 max_diff=3
expect: => i=2 r=0.0 ok=true s="valid_pairs: [(10,12), (18,20)]" errors=0 n=4 res=[10,12,18,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let md = ${max_diff};
	var out = v;
	out.s.clear();
	format(out.s, "valid_pairs: [");
	var cnt = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff <= md {
			if cnt > 0 { format(out.s, ", "); }
			format(out.s, "(", g.res[i], ",", g.res[i + 1], ")");
			cnt++;
		}
		i += 2;
	}
	format(out.s, "]");
	out.i = cnt;
	g.steps += g.n;
	out
}
@end
