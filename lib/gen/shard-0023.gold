fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	gold_clear(g);
	if num == 0 {
		gold_push(g, 0);
	} else {
		while num > 0 {
			gold_push(g, num % 10);
			num /= 10;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed digits count ", g.n);
	out
}
