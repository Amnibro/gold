@entry e8aec2d35f75ad0c
kind: step
verb: keep
noun: tally
modifier: in_reverse
context: aggregate
phrase: keep tally in reverse with threshold {min_count}
phrase: retain items meeting tally in reverse above {min_count}
slot: min_count int
test: list=1,2,2,3,3,3 min_count=2
expect: => i=5 r=0.0 ok=true s="kept 5 items meeting tally" errors=0 n=5 res=[3,3,3,2,2] cache=0 hits=0
test: list=4,5,5,6 min_count=1
expect: => i=4 r=0.0 ok=true s="kept 4 items meeting tally" errors=0 n=4 res=[6,5,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = max(1, ${min_count});
	var lo = 0;
	var hi = g.n - 1;
	while lo < hi {
		let tmp = g.res[lo];
		g.res[lo] = g.res[hi];
		g.res[hi] = tmp;
		lo++;
		hi--;
	}
	var wr = 0;
	for i in g.n {
		var cnt = 0;
		for j in g.n { if g.res[j] == g.res[i] { cnt++; } }
		if cnt >= mc {
			g.res[wr] = g.res[i];
			wr++;
		}
	}
	g.n = wr;
	g.steps += g.n;
	out.i = wr;
	out.s.clear();
	format(out.s, "kept ", wr, " items meeting tally");
	out
}
@end
