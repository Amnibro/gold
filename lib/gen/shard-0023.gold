code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n == 0 { return out; }
	let win = if c < g.n { c } else { g.n };
	if win > 1 {
		let first = g.res[0];
		for i in win - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[win - 1] = first;
	}
	out.i = win;
	out.s.clear();
	format(out.s, "rotated window: ", win);
	out
}
@end
