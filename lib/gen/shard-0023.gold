phrase: collect individual digits sorting in place
phrase: break sorted numbers into individual digits sorting in place
test: list=42,18
expect: => i=4 r=0.0 ok=true s="sorted 4 digits in place" errors=0 n=4 res=[1,2,4,8] cache=0 hits=0
test: list=95,30
expect: => i=4 r=0.0 ok=true s="sorted 4 digits in place" errors=0 n=4 res=[0,3,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
var digits int[512] = [0; 512];
var dn = 0;
for i in g.n {
	var x = core_abs_val(g.res[i]);
	if x == 0 {
		digits[dn] = 0;
		dn++;
	} else {
		var sub int[32] = [0; 32];
		var sn = 0;
		while x > 0 {
			sub[sn] = x % 10;
			sn++;
			x /= 10;
		}
		for k in sn {
			digits[dn] = sub[sn - 1 - k];
			dn++;
		}
	}
}
for i in dn { g.res[i] = digits[i]; }
g.n = dn;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
out.i = dn;
out.s.clear();
format(out.s, "sorted ", dn, " digits in place");
out
}
@end
