test: list=5,10,15,20 cap=25
expect: => i=15 r=0.0 ok=true s="running total under threshold 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,4,8,16,32 cap=20
expect: => i=14 r=0.0 ok=true s="running total under threshold 14" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_sum = ${cap};
	var running_acc = 0;
	var valid_len = 0;
	while valid_len < g.n {
		let next_sum = running_acc + g.res[valid_len];
		if next_sum > limit_sum { break; }
		running_acc = next_sum;
		valid_len++;
	}
	g.n = valid_len;
	g.steps += valid_len;
	out.i = running_acc;
	out.s.clear();
	format(out.s, "running total under threshold ", running_acc);
	out
}
@end
