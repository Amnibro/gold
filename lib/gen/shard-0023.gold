fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = 0;
	var other = 0;
	for i in g.n {
		if g.res[i] > 0 {
			pos++;
		} else {
			other++;
		}
	}
	g.res[0] = pos;
	g.res[1] = other;
	g.n = 2;
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "grouped histogram positive: ", pos);
