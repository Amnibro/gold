fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_idx = ${idx_a};
	let e_idx = ${idx_b};
	var temp_buf = [0; 512];
	var count_w = 0;
	var k = s_idx;
	while k <= e_idx && k < g.n {
		if k >= 0 {
			temp_buf[count_w] = g.res[k];
			count_w++;
		}
		k++;
	}
	gold_clear(g);
	for i in count_w { gold_push(g, temp_buf[i]); }
	out.i = count_w;
	out.s.clear();
	format(out.s, "window gathered: ", count_w);
	out
}
@end
