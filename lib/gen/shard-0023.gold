code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "evens_uniq: [");
	var cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var seen = false;
			for j in i {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				if cnt > 0 { format(out.s, ", "); }
				format(out.s, x);
				cnt++;
			}
		}
	}
	format(out.s, "]");
	out.i = cnt;
	g.steps += g.n * g.n;
	out
}
@end
