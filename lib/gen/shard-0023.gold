code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var wstart = 0;
	var i = 0;
	while i <= out.s.len {
		if i == out.s.len || out.s[i] == ' ' {
			var p = wstart;
			while p < i {
				var q = p + 1;
				while q < i {
					if out.s[q] < out.s[p] {
						let tmp = out.s[p];
						out.s[p] = out.s[q];
						out.s[q] = tmp;
					}
					q++;
				}
				p++;
			}
			wstart = i + 1;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
