fn ${ID}(n int) int {
	var num = if n < 0 { -n } else { n };
	if num < 10 { return num; }
	var digits int[..32] = [];
	while num > 0 {
		digits.push(num % 10);
		num /= 10;
	}
	var res = 0;
	var prev = -1;
	var idx = digits.len - 1;
	while idx >= 0 {
		let cur = digits[idx];
		if cur != prev {
			res = res * 10 + cur;
			prev = cur;
		}
		idx--;
	}
	res
}
