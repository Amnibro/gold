fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	out.s.clear();
	var unique = true;
	for k in g.n {
		for j in 0..k {
			if g.res[k] == g.res[j] {
				unique = false;
				break;
			}
		}
	}
	if !unique {
		gold_fail(g, "duplicate elements in unique range");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: duplicate elements");
		return out;
	}
	for k in g.n {
		g.res[k] *= f;
	}
	out.i = g.res[g.n - 1];
	out.ok = true;
	format(out.s, "unique range scaled");
	out
}
@end
