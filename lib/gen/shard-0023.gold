	o.append(",");
	gold_fnum(o, ${s});
	o.append(" m:matte ");
	gold_hex(o, 139, 90, 43);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "fcliff");
	out
}
