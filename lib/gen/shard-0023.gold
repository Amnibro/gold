code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var sum_val = 0;
	for i in g.n { sum_val += g.res[i]; }
	let avg = sum_val / g.n;
	gold_cache_put(g, 0, avg);
	var above = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] >= avg {
			above[count] = g.res[i];
			count++;
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, above[i]); }
	out.i = avg;
	out.s.clear();
	format(out.s, "average split: ", avg);
	out
}
@end
