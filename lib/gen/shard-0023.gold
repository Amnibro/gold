@entry 60eaaa4d5eca29a8
kind: step
verb: pair
noun: middle
modifier: up_to
context: aggregate
phrase: pair middle elements up to span {span}
phrase: group middle items up to distance {span}
slot: span int
test: list=1,2,3,4,5,6 span=2
expect: => i=2 r=0.0 ok=true s="paired 2 middle elements" errors=0 n=2 res=[5,9] cache=0 hits=0
test: list=10,20,30,40 span=1
expect: => i=1 r=0.0 ok=true s="paired 1 middle elements" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = max(1, min(g.n / 2, ${span}));
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "too few elements to pair");
		return out;
	}
	let mid = g.n / 2;
	let start = max(0, mid - s);
	let count = min(g.n - start, s * 2);
	var wr = 0;
	var i = start;
	while i + 1 < start + count {
		g.res[wr] = g.res[i] + g.res[i + 1];
		wr++;
		i += 2;
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "paired ", wr, " middle elements");
	out
}
@end
