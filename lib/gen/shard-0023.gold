fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo_b = ${low};
	let hi_b = ${high};
	var moved = 0;
	for i in g.n {
		if g.res[i] >= lo_b && g.res[i] <= hi_b {
			g.res[i] += 1;
			moved++;
		}
	}
	out.i = moved;
	out.s.clear();
	format(out.s, "shifted: ", moved);
	out
}
