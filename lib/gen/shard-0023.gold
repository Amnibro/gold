code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${deg} <= 0.0 || ${deg} > 180.0 { gold_fail(g, "guard failure"); out.ok = false; return out; }
	o.append(last);
	o.append(".rot anim 0:0,");
	o.append("0,0 ");
	o.append("0.");
	o.append("5:0,");
	gold_fnum(o, ${deg});
	o.append(",0 1:");
	o.append("0,");
	o.append("0,0 loop");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "jawwav");
	out
}
@end
