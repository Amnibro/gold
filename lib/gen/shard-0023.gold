code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p_val = ${pivot_val};
	var low_buf = [0; 512];
	var high_buf = [0; 512];
	var l_cnt = 0;
	var h_cnt = 0;
	for i in g.n {
		if g.res[i] < p_val { low_buf[l_cnt] = g.res[i]; l_cnt++; }
		else { high_buf[h_cnt] = g.res[i]; h_cnt++; }
	}
	for i in l_cnt { g.res[i] = low_buf[i]; }
	for j in h_cnt { g.res[l_cnt + j] = high_buf[j]; }
	out.i = l_cnt;
	out.s.clear();
	format(out.s, "grouped low: ", l_cnt);
	out
}
@end
