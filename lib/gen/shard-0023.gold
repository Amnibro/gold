@entry 248dd7c96f4176a4
kind: step
verb: drop
noun: gaps
modifier: pairwise
context: aggregate
phrase: drop items with pairwise gap under {min_gap}
phrase: filter entries with pairwise gap under {min_gap}
slot: min_gap int
test: list=1,2,5,6,10 min_gap=3
expect: => i=3 r=0.0 ok=true s="kept gap: 3" errors=0 n=3 res=[1,5,10] cache=0 hits=0
test: list=10,12,20,22,35 min_gap=5
expect: => i=3 r=0.0 ok=true s="kept gap: 3" errors=0 n=3 res=[10,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_req = ${min_gap};
	if g.n == 0 { return out; }
	var kept_arr = [0; 512];
	kept_arr[0] = g.res[0];
	var k_total = 1;
	for i in 1..g.n {
		if g.res[i] - kept_arr[k_total - 1] >= g_req {
			kept_arr[k_total] = g.res[i];
			k_total++;
		}
	}
	gold_clear(g);
	for i in k_total { gold_push(g, kept_arr[i]); }
	out.i = k_total;
	out.s.clear();
	format(out.s, "kept gap: ", k_total);
	out
}
@end
