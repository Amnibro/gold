phrase: shift search spaces running sequentially by delta {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="rotated running: 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 offset=2
expect: => i=2 r=0.0 ok=true s="rotated running: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 { return out; }
	let sh = (off % g.n + g.n) % g.n;
	var buf = [0; 512];
	for i in g.n {
		let new_idx = (i + sh) % g.n;
		buf[new_idx] = g.res[i];
	}
	for i in g.n {
		g.res[i] = buf[i];
	}
	out.i = sh;
	out.s.clear();
	format(out.s, "rotated running: ", sh);
	out
}
@end
