kind: step
verb: swap
noun: average
modifier: between
context: loop
slot: low int
slot: high int
phrase: swap average between index {low} to {high}
phrase: replace values with average between {low} to {high}
test: list=10,20,30,40 low=0 high=2
expect: => i=20 r=0.0 ok=true s="swapped average between indices: 20" errors=0 n=4 res=[20,20,20,40] cache=0 hits=0
test: list=4,8,12,16 low=1 high=3
expect: => i=12 r=0.0 ok=true s="swapped average between indices: 12" errors=0 n=4 res=[4,12,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${low};
	var hi = ${high};
	if lo < 0 { lo = 0; }
	if hi >= g.n { hi = g.n - 1; }
	if lo > hi || g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "swapped average between indices: 0");
		return out;
	}
	var sum = 0;
	var count = 0;
	var i = lo;
	while i <= hi {
		sum += g.res[i];
		count++;
		i++;
	}
	let avg = sum / count;
	g.res[lo] = avg;
	g.res[hi] = avg;
	g.steps += count;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped average between indices: ", avg);
	out
}
@end
