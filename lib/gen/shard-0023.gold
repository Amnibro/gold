	if val < 10 { return 1; }
	var max_streak = 1;
	var cur_streak = 1;
	var prev = val % 10;
	val /= 10;
	while val > 0 {
		let d = val % 10;
		if d == prev {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			prev = d;
			cur_streak = 1;
		}
		val /= 10;
	}
	max_streak
}
