@entry 42a5729a922957cd
kind: step
verb: return
noun: duplicates
modifier: running
context: format
phrase: format duplicate items found in running sequence
phrase: display running stream of repeated elements
test: list=3,5,3,8,5,2
expect: => i=2 r=0.0 ok=true s="dups: [3, 5]" errors=0 n=6 res=[3,5,3,8,5,2] cache=0 hits=0
test: list=1,2,1,4,2,6
expect: => i=2 r=0.0 ok=true s="dups: [1, 2]" errors=0 n=6 res=[1,2,1,4,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "dups: [");
	var cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if seen {
			var already_printed = false;
			for j in i {
				if g.res[j] == x {
					for k in j {
						if g.res[k] == x { already_printed = true; break; }
					}
					break;
				}
			}
			if !already_printed {
				if cnt > 0 { format(out.s, ", "); }
				format(out.s, x);
				cnt++;
			}
		}
	}
	format(out.s, "]");
	out.i = cnt;
	g.steps += g.n * g.n;
	out
}
@end
