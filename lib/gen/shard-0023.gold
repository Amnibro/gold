code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		g.res[i] = g.res[i] * f;
		i += 2;
	}
	out.i = g.n;
	gold_text(out, "normalized alternate runs");
	out
}
@end
