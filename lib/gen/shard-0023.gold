@entry 8508830d2b175e2a
kind: step
verb: run
noun: threshold
modifier: with_retry
context: core
phrase: run threshold with retry attempts {retries} cutoff {limit}
phrase: evaluate threshold with retry budget {retries} bound {limit}
slot: limit int
slot: retries int
test: list=10,20,35,40 limit=30 retries=2
expect: => i=35 r=0.0 ok=true s="result: 35" errors=0 n=4 res=[10,20,35,40] cache=0 hits=0
test: list=5,12,18,22 limit=50 retries=3
expect: => i=0 r=0.0 ok=false s="result: 0" errors=0 n=4 res=[5,12,18,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let r = ${retries};
	var found = false;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] > lim {
			found = true;
			break;
		}
		idx++;
	}
	g.steps += idx + r;
	out.ok = found;
	out.i = if found { g.res[idx] } else { 0 };
	out.s.clear();
	format(out.s, "result: ", out.i);
	out
}
@end
@entry 81a6904e07a33869
kind: step
verb: cache
noun: histogram
modifier: until
context: core
phrase: cache histogram until value {stop_val}
phrase: record histogram until target {stop_val}
slot: stop_val int
test: list=3,3,7,7,9,2 stop_val=9
expect: => i=4 r=0.0 ok=true s="tallied: 4" errors=0 n=6 res=[3,3,7,7,9,2] cache=2 hits=2
test: list=4,4,4,5,6 stop_val=5
expect: => i=3 r=0.0 ok=true s="tallied: 3" errors=0 n=5 res=[4,4,4,5,6] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${stop_val};
	var processed = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x == target { break; }
		let cur, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cur + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
		processed++;
		i++;
	}
	g.steps += processed;
	out.i = processed;
	out.s.clear();
	format(out.s, "tallied: ", processed);
	out
}
@end
