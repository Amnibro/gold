test: list=4,10,9,15,16,20
expect: => i=3 r=0.0 ok=true s="reversed squares: 3" errors=0 n=3 res=[16,9,4] cache=0 hits=0
test: list=25,30,36,40,49
expect: => i=3 r=0.0 ok=true s="reversed squares: 3" errors=0 n=3 res=[49,36,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var squares = [0; 512];
	var sq_n = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var is_sq = false;
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
			if is_sq { squares[sq_n] = x; sq_n++; }
		}
	}
	var kept = [0; 512];
	var kn = 0;
	var k = sq_n - 1;
	while k >= 0 { kept[kn] = squares[k]; kn++; k--; }
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "reversed squares: ", kn);
	out
}
@end
