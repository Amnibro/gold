code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "rot_mid: [");
	if g.n <= 2 {
		for i in g.n {
			if i > 0 { format(out.s, ", "); }
			format(out.s, g.res[i]);
		}
	} else {
		format(out.s, g.res[0]);
		let mid_len = g.n - 2;
		for i in mid_len {
			format(out.s, ", ");
			let idx = 1 + ((i + 1) % mid_len);
			format(out.s, g.res[idx]);
		}
		format(out.s, ", ", g.res[g.n - 1]);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
