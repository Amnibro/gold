	let k = ${prefix_len};
	if k <= 0 {
		out.i = 0;
		gold_text(out, "sequence retained");
		return out;
	}
	var drop_count = k;
	if drop_count > g.n { drop_count = g.n; }
	var i = 0;
	while i + drop_count < g.n {
		g.res[i] = g.res[i + drop_count];
		i++;
	}
	g.n -= drop_count;
	out.i = drop_count;
	gold_text(out, "dropped sequence items");
	out
}
@end
