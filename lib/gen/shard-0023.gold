noun: runs
modifier: every_other
context: transform
phrase: normalize run lengths taking every other element scaled by {factor}
phrase: scale alternate run entries across every other index by {factor}
slot: factor int
test: list=2,3,4,5 factor=3
expect: => i=4 r=0.0 ok=true s="normalized alternate runs" errors=0 n=4 res=[6,3,12,5] cache=0 hits=0
test: list=10,20,30 factor=2
