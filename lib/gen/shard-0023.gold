fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > c {
			g.res[i] = c;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped odds: ", clamped);
	out
}
@end
