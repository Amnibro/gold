code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_prime = false; break; }
				d++;
			}
			if is_prime { kept[kn] = x; kn++; }
		}
	}
	for i in kn {
		for j in 0..(kn - 1 - i) {
			if kept[j] > kept[j + 1] {
				let tmp = kept[j];
				kept[j] = kept[j + 1];
				kept[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "primes sorted: ", kn);
	out
}
@end
