@entry 32ce78ad9a8d623f
kind: step
verb: normalize
noun: primes
modifier: in_reverse
context: stats
phrase: normalize sample primes in reverse order
phrase: transform prime indicators in reverse sequence
test: list=2,4,7,9
expect: => i=2 r=0.0 ok=true s="normalized primes in reverse: 2" errors=0 n=4 res=[0,1,0,1] cache=0 hits=0
test: list=5,8,11,13,15
expect: => i=3 r=0.0 ok=true s="normalized primes in reverse: 3" errors=0 n=5 res=[0,1,1,0,1] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	if n == 2 || n == 3 { return true; }
	if n % 2 == 0 { return false; }
	var d = 3;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 2;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	var prime_count = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			g.res[k] = 1;
			prime_count++;
		} else {
			g.res[k] = 0;
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "normalized primes in reverse: ", prime_count);
	out
}
@end
