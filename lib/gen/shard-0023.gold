code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = min(g.n, max(0, ${window_size}));
	var ok = true;
	if ws >= 2 {
		for i in ws - 1 {
			if g.res[i] >= g.res[i + 1] { ok = false; break; }
		}
	}
	g.steps += ws;
	out.ok = ok;
	out.i = ws;
	out.s.clear();
	format(out.s, "window check ok: ", ok);
	out
}
@end
