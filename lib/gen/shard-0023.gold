code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l_idx = 0;
	var r_idx = g.n - 1;
	while l_idx < r_idx {
		let t_swap = g.res[l_idx];
		g.res[l_idx] = g.res[r_idx];
		g.res[r_idx] = t_swap;
		l_idx++;
		r_idx--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed: ", g.n);
	out
}
@end
