code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if ${c} < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c} + y / ${c}) % 2) as real;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.2); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "roughness");
	out
}
@end
