@entry c21b0be3b77d830b
kind: step
verb: sum
noun: spaces
modifier: up_to
context: stats
phrase: sum observation spaces up to threshold {cap}
phrase: accumulate sample intervals up to limit {cap}
slot: cap int
test: list=2,5,9,18 cap=5
expect: => i=7 r=0.0 ok=true s="sum spaces up to: 7" errors=0 n=5 res=[2,5,9,18,7] cache=0 hits=0
test: list=10,12,15,22 cap=3
expect: => i=5 r=0.0 ok=true s="sum spaces up to: 5" errors=0 n=5 res=[10,12,15,22,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var total = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			let space = g.res[i] - g.res[i - 1];
			if space > 0 && space <= limit {
				total += space;
			}
			i++;
		}
	}
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum spaces up to: ", total);
	out
}
@end
