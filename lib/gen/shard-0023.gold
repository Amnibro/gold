context: stats
phrase: find duplicate observations while below ceiling {cap}
phrase: identify duplicates while under threshold {cap}
slot: cap int
test: list=2,5,2,8,5,20 cap=15
expect: => i=2 r=0.0 ok=true s="found duplicates count: 2" errors=0 n=6 res=[2,5,2,8,5,20] cache=0 hits=0
test: list=3,7,3,9 cap=15
expect: => i=1 r=0.0 ok=true s="found duplicates count: 1" errors=0 n=4 res=[3,7,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var dupes = 0;
	for i in g.n {
		let x = g.res[i];
		if x < limit {
			var seen = false;
			for j in i {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if seen {
				dupes++;
			}
		}
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "found duplicates count: ", dupes);
	g.steps += g.n;
	out
}
@end
