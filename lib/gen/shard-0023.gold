test: list=10,20,30,40,50
expect: => i=30 r=0.0 ok=true s="mid uniq: 30" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un { if uniq[j] == x { seen = true; break; } }
		if !seen { uniq[un] = x; un++; }
	}
	var mid_val = 0;
	if un > 0 { mid_val = uniq[un / 2]; }
	gold_clear(g);
	gold_push(g, mid_val);
	out.i = mid_val;
	out.s.clear();
	format(out.s, "mid uniq: ", mid_val);
	out
}
@end
@entry 990828a69abd4617
kind: step
verb: run
noun: window
modifier: at_least
context: aggregate
phrase: run window of length at least {win_size}
phrase: find maximum window sum of size at least {win_size}
slot: win_size int
test: list=1,4,2,8,3,5 win_size=3
expect: => i=16 r=0.0 ok=true s="max win: 16" errors=0 n=6 res=[1,4,2,8,3,5] cache=0 hits=0
test: list=10,2,30,4 win_size=2
expect: => i=34 r=0.0 ok=true s="max win: 34" errors=0 n=4 res=[10,2,30,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w_sz = ${win_size};
	if g.n < w_sz || w_sz <= 0 {
		out.i = 0;
		return out;
	}
	var max_w_sum = 0;
	for i in 0..(g.n - w_sz + 1) {
		var cur_sum = 0;
		for j in 0..w_sz { cur_sum += g.res[i + j]; }
		if i == 0 || cur_sum > max_w_sum { max_w_sum = cur_sum; }
	}
	out.i = max_w_sum;
	out.s.clear();
	format(out.s, "max win: ", max_w_sum);
	out
}
@end
@entry caf30e5b1a5b9d14
kind: step
verb: limit
noun: prefix
modifier: in_reverse
context: aggregate
phrase: limit prefix of length {pref_k} in reverse
phrase: reverse initial prefix bounded by {pref_k}
slot: pref_k int
test: list=1,2,3,4,5 pref_k=3
expect: => i=3 r=0.0 ok=true s="rev pref: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40,50,60 pref_k=4
expect: => i=4 r=0.0 ok=true s="rev pref: 4" errors=0 n=6 res=[40,30,20,10,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k_lim = ${pref_k};
	var bound = k_lim;
	if bound > g.n { bound = g.n; }
	if bound < 0 { bound = 0; }
	var left_idx = 0;
	var right_idx = bound - 1;
	while left_idx < right_idx {
		let swap_t = g.res[left_idx];
		g.res[left_idx] = g.res[right_idx];
		g.res[right_idx] = swap_t;
		left_idx++;
		right_idx--;
	}
	out.i = bound;
	out.s.clear();
	format(out.s, "rev pref: ", bound);
	out
}
@end
