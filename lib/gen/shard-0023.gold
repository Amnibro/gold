code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = max(1, ${diff});
	var swaps = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if abs(g.res[i] - g.res[i + 1]) >= d {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "threshold swaps: ", swaps);
	out
}
@end
