expect: => i=3 r=0.0 ok=true s="sorted squares: 3" errors=0 n=3 res=[36,49,64] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi && x >= 0 {
			var sq = false;
			var r = 0;
			while r * r <= x {
				if r * r == x { sq = true; break; }
				r++;
			}
			if sq { kept[kn] = x; kn++; }
		}
	}
	for i in kn {
		for j in 0..(kn - 1 - i) {
			if kept[j] > kept[j + 1] {
				let tmp = kept[j];
				kept[j] = kept[j + 1];
				kept[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "sorted squares: ", kn);
	out
}
@end
