	let th = ${threshold};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if g.res[i] >= th { kept[kn] = g.res[i]; kn++; }
	}
	for i in kn {
		for j in 0..(kn - 1 - i) {
			if kept[j] > kept[j + 1] {
				let tmp = kept[j];
				kept[j] = kept[j + 1];
				kept[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "sorted at least: ", kn);
	out
}
