expect: => i=4 r=0.0 ok=true s="primes: 4" errors=0 n=9 res=[2,3,4,5,6,7,8,9,10] cache=0 hits=0
test: list=11,13,17,19,20
expect: => i=4 r=0.0 ok=true s="primes: 4" errors=0 n=5 res=[11,13,17,19,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_cnt = 0;
	for i in g.n {
		let x_val = g.res[i];
		if x_val >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x_val {
				if x_val % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prime_cnt++; }
		}
	}
	out.i = prime_cnt;
	out.s.clear();
	format(out.s, "primes: ", prime_cnt);
	out
}
@end
