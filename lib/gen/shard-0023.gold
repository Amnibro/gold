expect: => i=30 r=0.0 ok=true s="minimum in range found 30" errors=0 n=5 res=[50,15,70,30,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_bound = ${lo};
	let ceil_bound = ${hi};
	var lowest = 999999;
	var found = false;
	for i in g.n {
		let v_elem = g.res[i];
		if v_elem >= floor_bound && v_elem <= ceil_bound {
			if v_elem < lowest {
				lowest = v_elem;
				found = true;
			}
		}
	}
	g.steps += g.n;
	out.i = if found { lowest } else { -1 };
	out.s.clear();
	format(out.s, "minimum in range found ", out.i);
	out
}
@end
