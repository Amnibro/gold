fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cid = ${cache_id};
	var gap_sum = 0;
	if g.n >= 2 {
		var i = g.n - 1;
		while i > 0 {
			let diff = g.res[i] - g.res[i - 1];
			if diff > 0 { gap_sum += diff; }
			else { gap_sum -= diff; }
			i--;
		}
	}
	gold_cache_put(g, cid, gap_sum);
	out.i = gap_sum;
	gold_text(out, "cached gaps in reverse");
	out
}
@end
