fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let fill_v = ${val};
	if count > 0 {
		var i = g.n - 1;
		while i >= 0 {
			g.res[i + count] = g.res[i];
			i--;
		}
		for j in count {
			g.res[j] = fill_v;
		}
		g.n += count;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "filled head nested: ", count);
	out
}
