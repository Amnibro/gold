@entry 8191938e5a44789f
kind: step
verb: check
noun: threshold
modifier: up_to
context: aggregate
slot: limit int
phrase: check threshold up to ceiling {limit}
phrase: verify elements remain under {limit}
test: list=10,20,30 limit=40
expect: => i=3 r=0.0 ok=true s="checked up to: 40" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,50,30 limit=40
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[10,50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var i = 0;
	while i < g.n {
		if g.res[i] > lim {
			gold_fail(g, "check threshold: element exceeds limit");
			out.ok = false;
			return out;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "checked up to: ", lim);
	out
}
@end
@entry 805574570a93ecb3
kind: step
verb: select
noun: primes
modifier: between
context: aggregate
slot: low int
slot: high int
phrase: select primes between bounds {low} to {high}
phrase: filter prime values within {low} through {high}
test: list=4,5,6,7,8,9 low=2 high=10
expect: => i=2 r=0.0 ok=true s="selected primes: 2" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=10,11,12,13,14 low=10 high=20
expect: => i=2 r=0.0 ok=true s="selected primes: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				g.res[count] = x;
				count++;
			}
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "selected primes: ", count);
	out
}
@end
@entry 3bc4926564cd4653
kind: step
verb: reverse
noun: numbers
modifier: last
context: aggregate
slot: count int
phrase: reverse numbers last count {count}
phrase: invert tail numbers of size {count}
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed last numbers: 3" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed last numbers: 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var m = k;
	if m > g.n { m = g.n; }
	if m < 0 { m = 0; }
	let start = g.n - m;
	var i = 0;
	while i < m / 2 {
		let tmp = g.res[start + i];
		g.res[start + i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
		i++;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "reversed last numbers: ", m);
	out
}
@end
@entry 4aabfe1a1798f84c
kind: step
verb: select
noun: history
modifier: sorted
context: aggregate
phrase: select history sorted ascending order
phrase: arrange complete history in order
test: list=8,3,5,1
expect: => i=4 r=0.0 ok=true s="sorted history: 4" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
test: list=20,10,40,30
expect: => i=4 r=0.0 ok=true s="sorted history: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted history: ", g.n);
	out
}
@end
@entry a16da556efad2537
kind: step
verb: swap
noun: limit
modifier: any
context: aggregate
slot: boundary int
phrase: swap limit any ends over {boundary}
phrase: exchange endpoints when over {boundary}
test: list=50,20,10 boundary=30
expect: => i=1 r=0.0 ok=true s="swapped ends: 1" errors=0 n=3 res=[10,20,50] cache=0 hits=0
test: list=15,20,40 boundary=30
expect: => i=0 r=0.0 ok=true s="swapped ends: 0" errors=0 n=3 res=[15,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${boundary};
	if g.n >= 2 && g.res[0] > b {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "swapped ends: ", out.i);
	out
}
@end
