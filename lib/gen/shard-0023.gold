modifier: times
context: core
phrase: longest alternating parity streak length
phrase: max alternating digit streak in integer
test: arg=1212,1224
expect: 4
expect: 2
test: arg=135,2
expect: 1
expect: 1
code:
fn ${ID}(n int) int {
	var num = if n < 0 { -n } else { n };
	if num < 10 { return 1; }
	var longest_alt = 1;
	var cur_alt = 1;
	var last_parity = num % 2;
	num /= 10;
	while num > 0 {
		let cur_parity = num % 2;
		if cur_parity != last_parity {
			cur_alt++;
			if cur_alt > longest_alt { longest_alt = cur_alt; }
		} else {
			cur_alt = 1;
		}
		last_parity = cur_parity;
		num /= 10;
	}
	longest_alt
}
@end
