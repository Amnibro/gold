fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tries = ${max_tries};
	var found_at = -1;
	var k = 0;
	while k < g.n && k < tries {
		if g.res[k] == 0 { found_at = k; break; }
		k++;
	}
	out.i = found_at;
	out.s.clear();
	format(out.s, "space at: ", found_at);
	out
}
@end
@entry 953bdbdd13f17987
kind: step
verb: collect
noun: squares
modifier: sorted
context: aggregate
phrase: collect perfect squares in sorted order
phrase: sort collected square numbers from list
test: list=16,7,4,25,2
expect: => i=3 r=0.0 ok=true s="squares n: 3" errors=0 n=3 res=[4,16,25] cache=0 hits=0
test: list=9,1,100,5
expect: => i=3 r=0.0 ok=true s="squares n: 3" errors=0 n=3 res=[1,9,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_buf = [0; 512];
	var sq_n = 0;
	for i in g.n {
		let x_cand = g.res[i];
		if x_cand >= 0 {
			var r = 0;
			while r * r <= x_cand {
				if r * r == x_cand { sq_buf[sq_n] = x_cand; sq_n++; break; }
				r++;
			}
		}
	}
	for i in sq_n {
		for j in (i + 1)..sq_n {
			if sq_buf[j] < sq_buf[i] {
				let tmp_sq = sq_buf[i];
				sq_buf[i] = sq_buf[j];
				sq_buf[j] = tmp_sq;
			}
		}
	}
	gold_clear(g);
	for i in sq_n { gold_push(g, sq_buf[i]); }
	out.i = sq_n;
	out.s.clear();
	format(out.s, "squares n: ", sq_n);
	out
}
@end
