@entry 65f9ddac9bf5694c
kind: step
verb: find
noun: maximum
modifier: between
context: core
phrase: find maximum between bounds {low} to {high}
phrase: locate maximum value between interval {low} {high}
slot: low int
slot: high int
test: list=10,45,23,67,12,89 low=20 high=70
expect: => i=67 r=0.0 ok=true s="peak: 67" errors=0 n=6 res=[10,45,23,67,12,89] cache=0 hits=0
test: list=5,15,30,8,42 low=10 high=35
expect: => i=30 r=0.0 ok=true s="peak: 30" errors=0 n=5 res=[5,15,30,8,42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var max_val = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if !found || x > max_val {
				max_val = x;
				found = true;
			}
		}
		i++;
	}
	g.steps += g.n;
	if found {
		out.i = max_val;
		out.s.clear();
		format(out.s, "peak: ", max_val);
	} else {
		out.i = 0;
		out.ok = false;
	}
	out
}
@end
