phrase: fold search word lengths safely under maximum limit {limit}
phrase: aggregate search text terms safely capping length at {limit}
slot: limit int
test: text="alpha beta gamma" limit=12
expect: => i=12 r=0.0 ok=true s="folded words: 12" errors=0 n=0 res=[] cache=0 hits=0
test: text="search test" limit=5
expect: => i=5 r=0.0 ok=true s="folded words: 5" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var len_sum = 0;
	var in_w = false;
	var cur_len = 0;
	for b in v.s {
		if b == ' ' {
			if in_w {
				len_sum += cur_len;
				cur_len = 0;
				in_w = false;
			}
		} else {
			in_w = true;
			cur_len++;
		}
	}
	if in_w { len_sum += cur_len; }
	if len_sum > lim { len_sum = lim; }
	out.i = len_sum;
	out.s.clear();
	format(out.s, "folded words: ", len_sum);
	out
}
@end
