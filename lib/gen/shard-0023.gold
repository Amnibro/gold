@entry ade97896927deb9c
kind: step
verb: run
noun: digits
modifier: while
context: transform
phrase: run digits reduction while above threshold {cap}
phrase: process digits repeatedly while exceeding bound {cap}
slot: cap int
test: list=99,15,4 cap=9
expect: => i=2 r=0.0 ok=true s="ran digits while above limit" errors=0 n=3 res=[9,6,4] cache=0 hits=0
test: list=25,12 cap=10
expect: => i=1 r=0.0 ok=true s="ran digits while above limit" errors=0 n=2 res=[7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var rounds = 0;
	var changed = true;
	while changed && rounds < 10 {
		changed = false;
		for i in g.n {
			if g.res[i] > limit {
				g.res[i] = core_digit_sum(g.res[i]);
				changed = true;
			}
		}
		if changed { rounds++; }
	}
	out.i = rounds;
	gold_text(out, "ran digits while above limit");
	out
}
@end
