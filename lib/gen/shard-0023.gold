fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_evens = [0; 512];
	var ev_count = 0;
	for i in g.n {
		let val_x = g.res[i];
		if val_x % 2 == 0 {
			var present = false;
			for j in ev_count { if uniq_evens[j] == val_x { present = true; break; } }
			if !present { uniq_evens[ev_count] = val_x; ev_count++; }
		}
	}
	gold_clear(g);
	for i in ev_count { gold_push(g, uniq_evens[i]); }
	out.i = ev_count;
	out.s.clear();
	format(out.s, "uniq evens: ", ev_count);
	out
}
@end
