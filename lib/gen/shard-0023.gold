fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let limit = ${thresh};
var idx = -1;
for i in g.n {
	if g.res[i] >= limit { idx = i; break; }
}
if idx > 0 {
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[i]; }
	for i in g.n { g.res[i] = temp[(idx + i) % g.n]; }
	out.i = idx;
} else {
	out.i = 0;
}
out.s.clear();
format(out.s, "shifted by index ", out.i);
out
}
@end
@entry f034478a8f6b4f07
kind: step
verb: cache
noun: number
modifier: with_retry
context: sort
phrase: cache sorted median number with retry count {retries}
phrase: store sorted median value in cache with retry limit {retries}
slot: retries int
test: list=7,2,9,4,1 input=10 retries=3
expect: => i=10 r=0.0 ok=true s="cached median 4" errors=0 n=5 res=[1,2,4,7,9] cache=1 hits=0
test: list=15,30,5 input=20 retries=2
expect: => i=20 r=0.0 ok=true s="cached median 15" errors=0 n=3 res=[5,15,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
if g.n == 0 { return out; }
let median = g.res[g.n / 2];
let attempts = ${retries};
var key = out.i;
var stored = false;
for r in attempts {
	let val, hit = gold_cache_get(g, key + r);
	if !hit {
		gold_cache_put(g, key + r, median);
		stored = true;
		out.i = key + r;
		break;
	}
}
if !stored { gold_fail(g, "cache retry exceeded"); out.ok = false; }
out.s.clear();
format(out.s, "cached median ", median);
out
}
@end
