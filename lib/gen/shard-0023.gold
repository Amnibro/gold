@entry 65834335f029bc68
kind: step
verb: collect
noun: digits
modifier: last
context: transform
phrase: collect digits of last element into results
phrase: extract digit components of last value into list
test: list=12,345
expect: => i=3 r=0.0 ok=true s="collected digits of last item" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=7,89
expect: => i=2 r=0.0 ok=true s="collected digits of last item" errors=0 n=2 res=[8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		gold_text(out, "no digits to collect");
		return out;
	}
	var num = g.res[g.n - 1];
	if num < 0 { num = -num; }
	g.n = 0;
	if num == 0 {
		gold_push(g, 0);
	} else {
		while num > 0 {
			gold_push(g, num % 10);
			num /= 10;
		}
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.n;
	gold_text(out, "collected digits of last item");
	out
}
@end
