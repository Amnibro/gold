@entry 6dab049c743140a5
kind: step
verb: dedupe
noun: memo
modifier: with_cache
context: filter
phrase: dedupe values updating memo cache table
phrase: filter duplicates caching unique memo entries
test: list=5,10,5,20,10,30
expect: => i=4 r=0.0 ok=true s="memo deduped: 4" errors=0 n=4 res=[5,10,20,30] cache=4 hits=2
test: list=7,7,7,8,8
expect: => i=2 r=0.0 ok=true s="memo deduped: 2" errors=0 n=2 res=[7,8] cache=2 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, 1);
			kept[kn] = x;
			kn++;
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "memo deduped: ", kn);
	out
}
@end
@entry 0041c095571508ee
kind: step
verb: validate
noun: spaces
modifier: with_cache
context: filter
phrase: validate spaces between entries updating cache for span {span}
phrase: verify spacing across results recording cached distance {span}
slot: span int
test: list=10,20,30,40 span=5
expect: => i=1 r=0.0 ok=true s="spaces valid: 1" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
test: list=10,12,30 span=5
expect: => i=0 r=0.0 ok=true s="spaces valid: 0" errors=0 n=3 res=[10,12,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var valid = true;
	for i in 0..(g.n - 1) {
		let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff < sp { valid = false; break; }
	}
	gold_cache_put(g, sp, if valid { 1 } else { 0 });
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "spaces valid: ", out.i);
	out
}
@end
