@entry 1bfb4d2f87dcbc3c
kind: step
verb: check
noun: pairs
modifier: every_other
context: core
phrase: check every other pair for equal values
phrase: verify alternate pairs are equal
test: list=5,5,10,20,8,8
expect: => i=2 r=0.0 ok=true s="alternate pairs match: 2" errors=0 n=6 res=[5,5,10,20,8,8] cache=0 hits=0
test: list=3,4,1,1
expect: => i=0 r=0.0 ok=false s="pairs mismatch" errors=1 n=4 res=[3,4,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	var total_checked = 0;
	var i = 0;
	var pair_idx = 0;
	while i + 1 < g.n {
		if pair_idx % 2 == 0 {
			total_checked++;
			if g.res[i] == g.res[i + 1] {
				matched++;
			}
		}
		pair_idx++;
		i += 2;
	}
	let all_matched = total_checked > 0 && matched == total_checked;
	out.ok = all_matched;
	out.i = matched;
	out.s.clear();
	if all_matched {
		format(out.s, "alternate pairs match: ", matched);
	} else {
		gold_fail(g, "alternate pairs mismatch");
		format(out.s, "pairs mismatch");
	}
	out
}
@end
