fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var running = 0;
	for i in g.n {
		running += g.res[i];
		if running > b { running = b; }
		g.res[i] = running;
	}
	out.i = running;
	out.s.clear();
	format(out.s, "clamped total: ", running);
	out
}
