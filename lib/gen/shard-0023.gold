phrase: clamp limits with cache ceiling {cap}
slot: cap int
test: list=12,45,67,23,89 cap=50
expect: => i=2 r=0.0 ok=true s="clamped: 2" errors=0 n=5 res=[12,45,50,23,50] cache=1 hits=0
test: list=5,15,30,8,42 cap=20
expect: => i=2 r=0.0 ok=true s="clamped: 2" errors=0 n=5 res=[5,15,20,8,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var limited = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > c {
			g.res[i] = c;
			limited++;
		}
		i++;
	}
	gold_cache_put(g, c, limited);
	g.steps += g.n;
	out.i = limited;
	out.s.clear();
	format(out.s, "clamped: ", limited);
	out
}
@end
