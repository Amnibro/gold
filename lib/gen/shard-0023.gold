@entry 6565de1facfb38b3
kind: step
verb: select
noun: steps
modifier: running
context: aggregate
phrase: select steps running upward increases
phrase: keep ascending step progression elements
test: list=10,15,12,20,18,25
expect: => i=4 r=0.0 ok=true s="running steps: 4" errors=0 n=4 res=[10,15,20,25] cache=0 hits=0
test: list=5,3,8,2,9
expect: => i=3 r=0.0 ok=true s="running steps: 3" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "running steps: ", g.n);
		return out;
	}
	var count = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[i - 1] {
			g.res[count] = g.res[i];
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "running steps: ", count);
	out
}
@end
