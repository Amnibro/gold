phrase: accumulate sorted square values until ceiling {max_sum}
slot: max_sum int
test: list=4,2,6,1 max_sum=30
expect: => i=21 r=0.0 ok=true s="sum of squares reached 21" errors=0 n=3 res=[1,2,4] cache=0 hits=0
test: list=5,3,2 max_sum=15
expect: => i=13 r=0.0 ok=true s="sum of squares reached 13" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
let ceiling = ${max_sum};
var sum = 0;
var kept = 0;
for i in g.n {
	let sq = g.res[i] * g.res[i];
	if sum + sq <= ceiling {
		sum += sq;
		g.res[kept] = g.res[i];
		kept++;
	} else {
		break;
	}
}
g.n = kept;
out.i = sum;
out.s.clear();
format(out.s, "sum of squares reached ", sum);
out
}
@end
