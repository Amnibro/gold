expect: => i=14 r=0.0 ok=true s="range up to ceiling: 14" errors=0 n=4 res=[5,30,19,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var found = false;
	var min_val = 0;
	var max_val = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= limit {
			if !found {
				min_val = x;
				max_val = x;
				found = true;
			} else {
				if x < min_val { min_val = x; }
				if x > max_val { max_val = x; }
			}
		}
	}
	let span = if found { max_val - min_val } else { 0 };
	out.i = span;
	out.s.clear();
	format(out.s, "range up to ceiling: ", span);
	g.steps += g.n;
	out
}
@end
