@entry bdf1e331e3ea1fb5
kind: step
verb: scale
noun: middle
modifier: sorted
context: aggregate
slot: mult int
phrase: scale middle sorted median by {mult}
phrase: multiply sorted middle element by {mult}
test: list=9,1,5 mult=3
expect: => i=15 r=0.0 ok=true s="scaled sorted median: 15" errors=0 n=3 res=[1,15,9] cache=0 hits=0
test: list=20,10,30 mult=2
expect: => i=40 r=0.0 ok=true s="scaled sorted median: 40" errors=0 n=3 res=[10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n > 0 {
		let mid = g.n / 2;
		g.res[mid] *= m;
		out.i = g.res[mid];
	} else {
		out.i = 0;
	}
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "scaled sorted median: ", out.i);
	out
}
@end
