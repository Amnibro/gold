expect: => i=5 r=0.0 ok=true s="joined gaps count 5" errors=0 n=5 res=[1,2,3,2,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap_val = ${gap};
	if g.n < 2 { return out; }
	var temp int[512] = [0; 512];
	let old_len = g.n;
	for i in old_len { temp[i] = g.res[i]; }
	gold_clear(g);
	for i in old_len {
		gold_push(g, temp[i]);
		if i + 1 < old_len {
			gold_push(g, gap_val);
		}
	}
	gold_cache_put(g, gap_val, g.n);
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined gaps count ", g.n);
	out
}
@end
