noun: series
modifier: unique
context: aggregate
phrase: merge series unique distinct elements
phrase: filter series unique aggregate items
test: list=1,2,2,3,1
expect: => i=3 r=0.0 ok=true s="unique series elements: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,5,8
expect: => i=2 r=0.0 ok=true s="unique series elements: 2" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var j = 0;
		while j < count {
			if g.res[j] == val {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			g.res[count] = val;
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "unique series elements: ", count);
	out
}
@end
