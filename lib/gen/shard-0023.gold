@entry e26a15375e10259d
kind: step
verb: shift
noun: list
modifier: safely
context: transform
phrase: shift list elements right safely by offset {offset}
phrase: rotate list positions forward safely by distance {offset}
slot: offset int
test: list=10,20,30 offset=1
expect: => i=1 r=0.0 ok=true s="list shifted safely" errors=0 n=3 res=[30,10,20] cache=0 hits=0
test: list=1,2,3,4 offset=2
expect: => i=2 r=0.0 ok=true s="list shifted safely" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_text(out, "list shifted safely");
		return out;
	}
	var k = ${offset} % g.n;
	if k < 0 { k += g.n; }
	for _ in k {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	out.i = k;
	gold_text(out, "list shifted safely");
	out
}
@end
@entry b3667edb561ec8ae
kind: step
verb: shift
noun: limit
modifier: sorted
context: transform
phrase: shift values exceeding limit in sorted order with boundary {cap}
phrase: adjust elements exceeding sorted threshold limit {cap}
slot: cap int
test: list=15,3,9 cap=10
expect: => i=3 r=0.0 ok=true s="shifted limit in sorted order" errors=0 n=3 res=[3,9,10] cache=0 hits=0
test: list=20,5,30 cap=15
expect: => i=3 r=0.0 ok=true s="shifted limit in sorted order" errors=0 n=3 res=[5,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
		}
	}
	var i = 1;
	while i < g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
		i++;
	}
	out.i = g.n;
	gold_text(out, "shifted limit in sorted order");
	out
}
@end
