fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${binsize};
	out.s.clear();
	if bs <= 0 {
		gold_fail(g, "non positive histogram bin size");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: invalid bin size");
		return out;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] >= 0 && g.res[k] < bs {
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no elements fell within histogram bin");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: empty bin");
		return out;
	}
	out.i = count;
	out.ok = true;
	format(out.s, "histogram bin populated");
	out
}
@end
