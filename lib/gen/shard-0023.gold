@entry 16f9989dba08dcf3
kind: step
verb: split
noun: number
modifier: unique
context: loop
phrase: split number unique decimal digits
phrase: extract unique digits from input number
test: input=1223
expect: => i=3 r=0.0 ok=true s="unique digits found: 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: input=558
expect: => i=2 r=0.0 ok=true s="unique digits found: 2" errors=0 n=2 res=[8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = if out.i < 0 { -out.i } else { out.i };
	var count = 0;
	while num > 0 {
		let d = num % 10;
		var seen = false;
		var j = 0;
		while j < count {
			if g.res[j] == d {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			g.res[count] = d;
			count++;
		}
		num /= 10;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "unique digits found: ", count);
	out
}
@end
