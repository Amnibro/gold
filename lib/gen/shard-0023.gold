kind: step
verb: split
noun: middle
modifier: up_to
context: transform
phrase: split middle elements up to span {span}
phrase: partition middle items up to width {span}
slot: span int
test: list=10,20,40,80 span=2
expect: => i=2 r=0.0 ok=true s="split middle elements" errors=0 n=4 res=[10,10,20,80] cache=0 hits=0
test: list=12,24,36 span=1
expect: => i=1 r=0.0 ok=true s="split middle elements" errors=0 n=3 res=[12,12,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let width = ${span};
	if g.n == 0 || width <= 0 {
		out.i = 0;
		gold_text(out, "middle unchanged");
		return out;
	}
	var start = (g.n - width) / 2;
	if start < 0 { start = 0; }
	var end = start + width;
	if end > g.n { end = g.n; }
	var count = 0;
	var i = start;
	while i < end {
		g.res[i] = g.res[i] / 2;
		count++;
		i++;
	}
	out.i = count;
	gold_text(out, "split middle elements");
	out
}
@end
