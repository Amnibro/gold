phrase: verify loop sequence values checking at least {minimum}
slot: minimum int
test: list=10,20,30,40 minimum=5
expect: => i=1 r=0.0 ok=true s="validated: 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=15,8,25 minimum=10
expect: => i=0 r=0.0 ok=false s="validated: 0" errors=1 n=3 res=[15,8,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${minimum};
	var valid = true;
	for i in g.n {
		if g.res[i] < m { valid = false; break; }
	}
	if !valid {
		gold_fail(g, "loop validation failed");
		out.ok = false;
	}
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "validated: ", out.i);
	out
}
@end
@entry 2865bafeda73b506
kind: step
verb: sort
noun: sequence
modifier: running
context: filter
phrase: sort running sequence chunks bounded by window {window}
phrase: sort successive sequence segments sized by {window}
slot: window int
test: list=9,3,7,2,8,1 window=3
expect: => i=6 r=0.0 ok=true s="running sorted: 6" errors=0 n=6 res=[3,7,9,1,2,8] cache=0 hits=0
test: list=10,5,8,2,9,4 window=2
expect: => i=6 r=0.0 ok=true s="running sorted: 6" errors=0 n=6 res=[5,10,2,8,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if win <= 1 || g.n == 0 { return out; }
	var start = 0;
	while start < g.n {
		var end = start + win;
		if end > g.n { end = g.n; }
		let len = end - start;
		for i in len {
			for j in 0..(len - 1 - i) {
				if g.res[start + j] > g.res[start + j + 1] {
					let tmp = g.res[start + j];
					g.res[start + j] = g.res[start + j + 1];
					g.res[start + j + 1] = tmp;
				}
			}
		}
		start += win;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "running sorted: ", g.n);
	out
}
@end
