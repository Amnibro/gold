phrase: display minimum item ranked cached under key {key}
slot: key int
test: list=15,3,9,22 key=1
expect: => i=3 r=0.0 ok=true s="min_cached: 3" errors=0 n=4 res=[15,3,9,22] cache=1 hits=1
test: list=8,12,4,16 key=2
expect: => i=4 r=0.0 ok=true s="min_cached: 4" errors=0 n=4 res=[8,12,4,16] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	let k = ${key};
	var out = v;
	out.s.clear();
	var min_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	gold_cache_put(g, k, min_val);
	let val, ok = gold_cache_get(g, k);
	format(out.s, "min_cached: ", val);
	out.i = val;
	g.steps += g.n;
	out
}
@end
