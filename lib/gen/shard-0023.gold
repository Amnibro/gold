code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${lim};
	if g.n < 3 { return out; }
	let mid_start = 1;
	let mid_end = g.n - 1;
	for i in mid_start..mid_end {
		if g.res[i] > threshold { g.res[i] = threshold; }
	}
	let mid_len = mid_end - mid_start;
	for i in mid_len {
		for j in mid_start..mid_end - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
		}
	}
	g.steps += mid_len * mid_len;
	out.i = mid_len;
	out.s.clear();
	format(out.s, "sorted middle elements ", mid_len);
	out
}
@end
