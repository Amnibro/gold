@entry a0c3d34d66e8362a
kind: step
verb: pair
noun: digits
modifier: first
context: core
phrase: pair digits first from number
phrase: group adjacent digits first in sequence
test: input=4826
expect: => i=2 r=0.0 ok=true s="pairs: 2" errors=0 n=2 res=[48,26] cache=0 hits=0
test: input=719
expect: => i=1 r=0.0 ok=true s="pairs: 1" errors=0 n=1 res=[71] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.i;
	if n < 0 { n = -n; }
	var digits = [0; 32];
	var count = 0;
	if n == 0 { digits[0] = 0; count = 1; }
	else {
		while n > 0 {
			digits[count] = n % 10;
			count++;
			n /= 10;
		}
	}
	for i in count / 2 {
		let tmp = digits[i];
		digits[i] = digits[count - 1 - i];
		digits[count - 1 - i] = tmp;
	}
	g.n = 0;
	var pairs = 0;
	var i = 0;
	while i + 1 < count {
		let p = digits[i] * 10 + digits[i + 1];
		gold_push(g, p);
		pairs++;
		i += 2;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairs: ", pairs);
	out
}
@end
