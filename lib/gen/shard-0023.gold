code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${max_len};
	if max_len < 0 {
		gold_fail(g, "negative tail length");
		out.ok = false;
		return out;
	}
	if out.s.len > max_len {
		let start = out.s.len - max_len;
		var res byte[..200] = "";
		var i = start;
		while i < out.s.len {
			res.push(out.s[i]);
			i++;
		}
		out.s.clear();
		for b in res { out.s.push(b); }
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry d3367fa3f8e854c9
kind: step
verb: clamp
noun: series
modifier: any
context: text
phrase: clamp identical character series length to {cap}
phrase: limit consecutive repeating character series to {cap}
slot: cap int
test: text="aaaaabbb" cap=2
expect: => i=4 r=0.0 ok=true s="aabb" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxxyyyzzz" cap=1
expect: => i=3 r=0.0 ok=true s="xyz" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		return out;
	}
	var res byte[..200] = "";
	var last byte = 0 as byte;
	var run_len = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c == last {
			run_len++;
		} else {
			last = c;
			run_len = 1;
		}
		if run_len <= cap && res.len < 200 {
			res.push(c);
		}
		i++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
