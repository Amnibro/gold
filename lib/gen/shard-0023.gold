fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap_e = ${max_evens};
	var even_count = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			if even_count < cap_e {
				g.res[count] = x;
				count++;
				even_count++;
			}
		} else {
			g.res[count] = x;
			count++;
		}
		i++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "evens limited count: ", even_count);
	out
}
