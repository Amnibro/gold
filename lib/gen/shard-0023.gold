test: list=5,2,8 limit=5
expect: => i=5 r=0.0 ok=true s="repeated sorted: 5" errors=0 n=5 res=[2,2,5,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		let x = g.res[i];
		buf[bn] = x;
		bn++;
		if x <= lim {
			buf[bn] = x;
			bn++;
		}
	}
	g.n = 0;
	for i in bn { gold_push(g, buf[i]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "repeated sorted: ", bn);
	out
}
@end
@entry ec9f4b8d3597206a
kind: step
verb: rotate
noun: condition
modifier: pairwise
context: search
phrase: rotate adjacent search pairs when matching condition delta {gap}
phrase: swap adjacent candidates pairwise when difference exceeds {gap}
slot: gap int
test: list=10,30,15,40 gap=15
expect: => i=2 r=0.0 ok=true s="pairwise swapped: 2" errors=0 n=4 res=[30,10,40,15] cache=0 hits=0
test: list=5,8,12 gap=10
expect: => i=0 r=0.0 ok=true s="pairwise swapped: 0" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gp = ${gap};
	var swapped = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff >= gp {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = swapped;
	out.s.clear();
	format(out.s, "pairwise swapped: ", swapped);
	out
}
@end
@entry a0b53fabc1f8d994
kind: step
