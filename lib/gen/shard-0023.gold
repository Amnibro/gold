fn ${ID}(g Gold&, v Val) Val {
	let th = ${threshold};
	var out = v;
	out.s.clear();
	var found = -1;
	for i in g.n {
		if g.res[i] >= th {
			found = g.res[i];
			break;
		}
	}
	if found >= 0 {
		format(out.s, "first_fn: ", found);
		out.i = found;
	} else {
		format(out.s, "none");
		out.i = -1;
	}
	g.steps += g.n;
	out
}
