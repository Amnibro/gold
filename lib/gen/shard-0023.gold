test: list=10,20,30,40,50 bound=25
expect: => i=30 r=0.0 ok=true s="alternate avg: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 bound=10
expect: => i=15 r=0.0 ok=true s="alternate avg: 15" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var sum = 0;
	var cnt = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		cnt++;
		i += 2;
	}
	let avg = if cnt > 0 { sum / cnt } else { 0 };
	var kept = [0; 512];
	var kn = 0;
	for j in g.n {
		if g.res[j] <= b {
			kept[kn] = g.res[j];
			kn++;
		}
	}
	g.n = 0;
	for j in kn {
		gold_push(g, kept[j]);
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "alternate avg: ", avg);
	out
}
@end
@entry 586909ac79e7d16b
kind: step
verb: sort
noun: primes
modifier: nested
context: search
phrase: sort prime candidate numbers using nested trial factors up to {limit}
phrase: order prime search values through nested divisor screening under {limit}
slot: limit int
test: list=15,7,11,4,2 limit=20
expect: => i=3 r=0.0 ok=true s="primes sorted: 3" errors=0 n=3 res=[2,7,11] cache=0 hits=0
test: list=9,8,6,3 limit=10
expect: => i=1 r=0.0 ok=true s="primes sorted: 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var p = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= lim {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p[pn] = x;
				pn++;
			}
		}
	}
	// Sort primes
	for i in pn {
		for j in pn - 1 {
			if p[j] > p[j + 1] {
				let tmp = p[j];
				p[j] = p[j + 1];
				p[j + 1] = tmp;
			}
		}
	}
	g.n = 0;
	for i in pn { gold_push(g, p[i]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "primes sorted: ", pn);
	out
}
@end
