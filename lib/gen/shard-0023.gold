@entry b71043fdde6897fa
kind: step
verb: rotate
noun: condition
modifier: times
context: compare
slot: turns int
phrase: rotate condition times across comparison sequence {turns}
phrase: cycle comparison values satisfying condition by {turns}
test: list=1,2,3,4,5 turns=2
expect: => i=5 r=0.0 ok=true s="rotated condition times: 5" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30,40 turns=1
expect: => i=4 r=0.0 ok=true s="rotated condition times: 4" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${turns};
	if g.n > 1 && t > 0 {
		var round = 0;
		while round < t {
			let first = g.res[0];
			var i = 0;
			while i + 1 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
			round++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated condition times: ", g.n);
	out
}
@end
@entry 566fe2026947f965
kind: step
verb: search
noun: counter
modifier: any
context: compare
slot: target int
phrase: search counter any matching comparison target {target}
phrase: find comparison counter instances equal to {target}
test: list=3,7,3,9,3,12 target=3
expect: => i=3 r=0.0 ok=true s="search counter match count: 3" errors=0 n=6 res=[3,7,3,9,3,12] cache=0 hits=0
