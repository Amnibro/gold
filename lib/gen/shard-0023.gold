	if k < 0 {
		gold_fail(g, "no item yet");
		out.ok = false;
		return out;
	}
	gold_dnews(g, "hole", "", o);
	o.append(" cyl 0,0,-");
	o.append("1 0,");
	o.append("0,1 r");
	gold_fnum(o, ${r});
	o.append(" b0.0");
	o.append("02 -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "rhole");
	out
}
@end
