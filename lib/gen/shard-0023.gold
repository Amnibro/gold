fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	let cap_val = ${ceiling};
	var i = 0;
	while i < g.n {
		var x = g.res[i] * m;
		if x > cap_val { x = cap_val; }
		g.res[i] = x;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled elements: ", g.n);
	out
}
@end
