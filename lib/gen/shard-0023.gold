test: list=5,5,6,7,7,7,8
expect: => i=3 r=0.0 ok=true s="max streak: 3" errors=0 n=7 res=[5,5,6,7,7,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max streak: ", max_streak);
	out
}
@end
@entry 1c13d79b9e0c034e
kind: step
verb: apply
noun: duplicates
modifier: with_retry
context: core
phrase: apply duplicates with retry attempts {max_tries}
phrase: replicate duplicates with retry count {max_tries}
slot: max_tries int
test: list=3,7,12 max_tries=2
expect: => i=6 r=0.0 ok=true s="duplicated: 6" errors=0 n=9 res=[3,7,12,3,7,12,3,7,12] cache=0 hits=0
test: list=5,9 max_tries=3
expect: => i=6 r=0.0 ok=true s="duplicated: 6" errors=0 n=8 res=[5,9,5,9,5,9,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tries = ${max_tries};
	var original = [0; 512];
	let old_n = g.n;
	var i = 0;
	while i < old_n {
		original[i] = g.res[i];
		i++;
	}
	var copied = 0;
	var t = 0;
	while t < tries && g.n + old_n <= 512 {
		var j = 0;
		while j < old_n {
			gold_push(g, original[j]);
			copied++;
			j++;
		}
		t++;
	}
	g.steps += old_n * tries;
	out.i = copied;
	out.s.clear();
	format(out.s, "duplicated: ", copied);
	out
}
@end
