@entry b33b7d51b21b358b
kind: step
verb: sort
noun: evens
modifier: with_retry
context: filter
phrase: sort even elements retrying swaps up to {maxswap}
phrase: order even numbers with retry swap limit {maxswap}
slot: maxswap int
test: list=8,3,4,1,6,5,2 maxswap=5
expect: => i=5 r=0.0 ok=true s="sorted evens: 5" errors=0 n=7 res=[2,3,4,1,6,5,8] cache=0 hits=0
test: list=10,7,6,3,2 maxswap=1
expect: => i=1 r=0.0 ok=true s="sorted evens: 1" errors=0 n=5 res=[6,7,10,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${maxswap};
	var evens = [0; 512];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens[en] = g.res[i]; en++; }
	}
	var swaps = 0;
	for i in en {
		for j in 0..(en - 1 - i) {
			if evens[j] > evens[j + 1] && swaps < ms {
				let tmp = evens[j];
				evens[j] = evens[j + 1];
				evens[j + 1] = tmp;
				swaps++;
			}
		}
	}
	var ei = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[i] = evens[ei];
			ei++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted evens: ", swaps);
	out
}
@end
