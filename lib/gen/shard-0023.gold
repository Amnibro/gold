@entry ac675a9ef1eeb41f
kind: step
verb: split
noun: number
modifier: last
context: sort
phrase: split sorted list around last number threshold
phrase: partition sorted items using last element as pivot
test: list=10,40,25,5
expect: => i=3 r=0.0 ok=true s="split pivot with 3 elements below" errors=0 n=4 res=[5,10,25,40] cache=0 hits=0
test: list=2,8,6,4
expect: => i=3 r=0.0 ok=true s="split pivot with 3 elements below" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
if g.n == 0 { return out; }
let pivot = g.res[g.n - 1];
var temp int[512] = [0; 512];
var below = 0;
var above = 0;
for i in (g.n - 1) {
	if g.res[i] < pivot {
		g.res[below] = g.res[i];
		below++;
	} else {
		temp[above] = g.res[i];
		above++;
	}
}
g.res[below] = pivot;
for i in above { g.res[below + 1 + i] = temp[i]; }
out.i = below;
