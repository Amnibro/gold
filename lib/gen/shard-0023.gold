code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var present bool[256] = [false; 256];
	var i = 0;
	while i < out.s.len {
		let idx = out.s[i] as int;
		if idx >= 0 && idx < 256 {
			present[idx] = true;
		}
		i++;
	}
	out.s.clear();
	var code = 0;
	while code < 256 {
		if present[code] {
			out.s.push(code as byte);
		}
		code++;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
