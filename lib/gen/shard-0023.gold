test: list=5,8,12
expect: => i=6 r=0.0 ok=true s="paired with indices: 6" errors=0 n=6 res=[5,0,8,1,12,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	var i = orig_n - 1;
	while i >= 0 {
		g.res[2 * i] = g.res[i];
		g.res[2 * i + 1] = i;
		i--;
	}
	g.n = orig_n * 2;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired with indices: ", g.n);
	out
}
@end
