fn ${ID}(n int) int {
	var val = if n < 0 { -n } else { n };
	if val == 0 { return 0; }
	var evens int[10] = [0; 10];
	var odds int[10] = [0; 10];
	var ec = 0;
	var oc = 0;
	while val > 0 {
		let d = val % 10;
		if d % 2 == 0 { evens[ec] = d; ec++; }
		else { odds[oc] = d; oc++; }
		val /= 10;
	}
	var res = 0;
	for i in 0..ec {
		res = res * 10 + evens[ec - 1 - i];
	}
	for i in 0..oc {
		res = res * 10 + odds[oc - 1 - i];
	}
	res
}
@end
