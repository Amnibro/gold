code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	var j = 0;
	while j < kept {
		var k = j + 1;
		while k < kept {
			if g.res[k] < g.res[j] {
				let t = g.res[j];
				g.res[j] = g.res[k];
				g.res[k] = t;
			}
			k++;
		}
		j++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted odds: ", kept);
	out
}
@end
