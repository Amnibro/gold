code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	var m = s;
	if m > g.n { m = g.n; }
	var i = 0;
	while i < m / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[m - 1 - i];
		g.res[m - 1 - i] = tmp;
		i++;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "normalized prefix count: ", m);
	out
}
@end
