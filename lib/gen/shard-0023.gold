code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${w} <= 0.0 || ${h} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "plant_path_steep", "", o);
	o.append(" box 2,0,");
	o.append("0 ");
	gold_fnum(o, ${w});
	o.append(",10,");
	gold_fnum(o, ${h});
	o.append(" m:matte ");
	gold_hex(o, 50, 95, 45);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "plantpathsteep");
	out
}
@end
