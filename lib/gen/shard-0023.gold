code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d_num = ${drop_cnt};
	var actual_drop = d_num;
	if actual_drop > g.n { actual_drop = g.n; }
	if actual_drop < 0 { actual_drop = 0; }
	var remain = g.n - actual_drop;
	for i in remain {
		g.res[i] = g.res[i + actual_drop];
	}
	g.n = remain;
	out.i = actual_drop;
	out.s.clear();
	format(out.s, "dropped: ", actual_drop);
	out
}
@end
