@entry ded1da8643314d86
kind: step
verb: scan
noun: streak
modifier: times
context: error
phrase: scan streak occurring exactly {times} times
phrase: find streak frequency matching {times}
slot: times int
test: list=1,7,7,7,2 times=3
expect: => i=7 r=0.0 ok=true s="target streak found" errors=0 n=5 res=[1,7,7,7,2] cache=0 hits=0
test: list=1,7,7,2 times=3
expect: => i=0 r=0.0 ok=false s="error: streak not matched" errors=1 n=4 res=[1,7,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var matched_val = 0;
	var found = false;
	if g.n > 0 {
		var cur = 1;
		var last_val = g.res[0];
		for k in 1..g.n {
			if g.res[k] == last_val {
				cur++;
			} else {
				if cur == t {
					matched_val = last_val;
					found = true;
					break;
				}
				cur = 1;
				last_val = g.res[k];
			}
		}
		if !found && cur == t {
			matched_val = last_val;
			found = true;
		}
	}
	out.s.clear();
	if !found {
		gold_fail(g, "no streak matched requested count");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: streak not matched");
		return out;
	}
	out.i = matched_val;
	out.ok = true;
	format(out.s, "target streak found");
	out
}
@end
