	let s = ${sep};
	if g.n <= 1 { return out; }
	var buf = [0; 512];
	var bn = 0;
	for i in g.n {
		buf[bn] = g.res[i];
		bn++;
		if i + 1 < g.n {
			buf[bn] = s;
			bn++;
		}
	}
	g.n = 0;
	for i in bn {
		gold_push(g, buf[i]);
