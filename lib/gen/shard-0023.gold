fn ${ID}(n int) int {
	var cand = n;
	if cand < 2 { return 2; }
	while cand >= 2 {
		var is_p = true;
		var d = 2;
		while d * d <= cand {
			if cand % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			return cand;
		}
		cand--;
	}
	2
}
