phrase: enforce minimum floor {bottom} traversing candidate results in reverse
slot: bottom int
test: list=10,4,2,8 bottom=5
expect: => i=2 r=0.0 ok=true s="reverse clamped: 2" errors=0 n=4 res=[10,5,5,8] cache=0 hits=0
test: list=1,3,2 bottom=2
expect: => i=1 r=0.0 ok=true s="reverse clamped: 1" errors=0 n=3 res=[2,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bot = ${bottom};
	var clamped_cnt = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] < bot {
			g.res[i] = bot;
			clamped_cnt++;
		}
		i--;
	}
	out.i = clamped_cnt;
	out.s.clear();
	format(out.s, "reverse clamped: ", clamped_cnt);
	out
}
@end
