fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "too few items");
		return out;
	}
	var diffs = [0; 512];
	var count = 0;
	for i in (g.n - 1) {
		diffs[count] = g.res[i + 1] - g.res[i];
		count++;
	}
	gold_clear(g);
	for i in count { gold_push(g, diffs[i]); }
	out.i = count;
	out.s.clear();
	format(out.s, "running diffs: ", count);
	out
}
@end
