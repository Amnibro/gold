code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_key = ${key};
	let cached_val, found = gold_cache_get(g, target_key);
	if found {
		out.i = cached_val;
		out.ok = true;
	} else {
		let fallback_val = target_key * 2;
		gold_cache_put(g, target_key, fallback_val);
		out.i = fallback_val;
		out.ok = true;
	}
	g.steps++;
	out.s.clear();
	format(out.s, "searched cache result ", out.i);
	out
}
@end
