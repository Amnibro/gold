expect: => i=3 r=0.0 ok=true s="dropped 3 prime numbers" errors=0 n=3 res=[4,6,9] cache=0 hits=0
test: list=13,15,17,20
expect: => i=2 r=0.0 ok=true s="dropped 2 prime numbers" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
var kept = 0;
var dropped = 0;
for i in g.n {
	if core_is_prime(g.res[i]) {
		dropped++;
	} else {
		g.res[kept] = g.res[i];
		kept++;
	}
}
g.n = kept;
out.i = dropped;
out.s.clear();
format(out.s, "dropped ", dropped, " prime numbers");
out
}
@end
@entry 92c63cc6366eaa65
kind: step
verb: limit
noun: errors
modifier: pairwise
context: sort
phrase: limit pairwise inversion errors in sorted list to {max_inv}
phrase: reduce pairwise sorting errors below {max_inv}
slot: max_inv int
test: list=5,4,3,2,1 max_inv=2
expect: => i=8 r=0.0 ok=true s="performed 8 reduction passes" errors=0 n=5 res=[2,3,1,4,5] cache=0 hits=0
test: list=10,8,6 max_inv=1
expect: => i=2 r=0.0 ok=true s="performed 2 reduction passes" errors=0 n=3 res=[8,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
let ceiling = ${max_inv};
var passes = 0;
while passes < 1000 {
	var inv = 0;
	for i in g.n {
		for j in (i + 1)..g.n { if g.res[i] > g.res[j] { inv++; } }
	}
	if inv <= ceiling { break; }
	for i in (g.n - 1) {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			break;
		}
	}
	passes++;
}
out.i = passes;
out.s.clear();
format(out.s, "performed ", passes, " reduction passes");
out
}
@end
