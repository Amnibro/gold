code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var found = 0;
	var cand = 2;
	while found < k && found < 50 {
		var is_p = true;
		var d = 2;
		while d * d <= cand {
			if cand % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			g.res[found] = cand;
			found++;
		}
		cand++;
	}
	g.n = found;
	g.steps += found;
	out.i = found;
	out.s.clear();
	format(out.s, "generated primes: ", found);
	out
}
@end
