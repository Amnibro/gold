expect: => i=2 r=0.0 ok=true s="returned tail length: 2" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var start = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == c {
			start = i + 1;
			break;
		}
		i++;
	}
	if start >= 0 {
		var kn = 0;
		var j = start;
		while j < g.n {
			g.res[kn] = g.res[j];
			kn++;
			j++;
		}
		g.n = kn;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned tail length: ", g.n);
	out
}
@end
@entry c30f625bd2c86514
kind: step
verb: dedupe
noun: average
modifier: with_cache
context: compare
slot: scale int
phrase: dedupe average with_cache scaled by factor {scale}
phrase: compute distinct average with cache using scale {scale}
test: list=2,2,4,4,6,6 scale=10
expect: => i=40 r=0.0 ok=true s="scaled dedupe average: 40" errors=0 n=3 res=[2,4,6] cache=1 hits=0
test: list=1,1,3,3,5,5 scale=10
expect: => i=30 r=0.0 ok=true s="scaled dedupe average: 30" errors=0 n=3 res=[1,3,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	let cached, ok = gold_cache_get(g, sc);
	if ok {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached dedupe average: ", cached);
		return out;
	}
	var uniq int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < un {
			if uniq[j] == x { exists = true; break; }
			j++;
		}
		if !exists {
			uniq[un] = x;
			un++;
		}
		i++;
	}
	var sum = 0;
	var k = 0;
	while k < un {
		g.res[k] = uniq[k];
		sum += uniq[k];
		k++;
	}
	g.n = un;
	let avg = if un > 0 { (sum * sc) / un } else { 0 };
	gold_cache_put(g, sc, avg);
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "scaled dedupe average: ", avg);
	out
}
@end
