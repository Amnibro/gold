fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "collected series count: 0");
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected series count: ", g.n);
	out
}
