@entry 21f19c59dc03193a
kind: step
verb: pair
noun: steps
modifier: unique
context: core
phrase: pair unique steps from consecutive values
phrase: form unique step pairs across list
test: list=1,2,2,3,4,4
expect: => i=2 r=0.0 ok=true s="unique step pairs: 2" errors=0 n=2 res=[1,0] cache=0 hits=0
test: list=5,5,6,7
expect: => i=2 r=0.0 ok=true s="unique step pairs: 2" errors=0 n=2 res=[0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diffs: int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		var seen = false;
		for k in count {
			if diffs[k] == d {
				seen = true;
				break;
			}
		}
		if !seen {
			diffs[count] = d;
			count++;
		}
		i++;
	}
	g.n = count;
	for k in count {
		g.res[k] = diffs[k];
	}
	out.i = count;
	out.s.clear();
	format(out.s, "unique step pairs: ", count);
	out
}
@end
