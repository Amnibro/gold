@entry 113d5c3020fc236a
kind: step
verb: search
noun: minimum
modifier: first
context: search
phrase: search minimum first element satisfying threshold {floor}
phrase: locate first minimum candidate value above {floor}
slot: floor int
test: list=12,5,8,3,10 floor=4
expect: => i=5 r=0.0 ok=true s="min found: 5" errors=0 n=5 res=[12,5,8,3,10] cache=0 hits=0
test: list=1,2,3 floor=5
expect: => i=-1 r=0.0 ok=false s="search missed" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var found = false;
	var min_val = 1000000;
	for i in g.n {
		let x = g.res[i];
		if x >= fl && (!found || x < min_val) {
			min_val = x;
			found = true;
		}
	}
	out.s.clear();
	if found {
		out.i = min_val;
		out.ok = true;
		format(out.s, "min found: ", min_val);
	} else {
		gold_fail(g, "no candidate above floor");
		out.ok = false;
		out.i = -1;
		format(out.s, "search missed");
	}
	out
}
@end
