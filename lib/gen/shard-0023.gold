code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 {
		gold_fail(g, "streak cap must be positive");
		out.ok = false;
		return out;
	}
	var res byte[..200] = "";
	var last byte = 0 as byte;
	var count = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c == last {
			count++;
		} else {
			last = c;
			count = 1;
		}
		if count <= cap && res.len < 200 {
			res.push(c);
		}
		i++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
