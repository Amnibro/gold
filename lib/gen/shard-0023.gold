test: list=2,6,14,18
expect: => i=2 r=0.0 ok=true s="merged middle pairs: 2" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let h = g.n / 2;
	var i = 0;
	while i < h {
		let left = g.res[i];
		let right = g.res[g.n - 1 - i];
		g.res[i] = (left + right) / 2;
		i++;
	}
	g.n = h;
	g.steps += h;
	out.i = h;
	out.s.clear();
	format(out.s, "merged middle pairs: ", h);
	out
}
@end
