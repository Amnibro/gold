fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var modified = 0;
	var i = 0;
	while i < out.s.len {
		let code = out.s[i] as int;
		if code < lo {
			out.s[i] = lo as byte;
			modified++;
		} else if code > hi {
			out.s[i] = hi as byte;
			modified++;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = modified;
	out
}
