		}
		i++;
	}
	g.n = 0;
	var j = 0;
	while j < ucount {
		gold_push(g, counts[j]);
		j++;
	}
	g.steps += g.n;
	out.i = ucount;
	out.s.clear();
	format(out.s, "unique: ", ucount);
	out
}
