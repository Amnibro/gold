code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lim { break; }
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			kept[kn] = x;
			kn++;
		}
		i++;
	}
	var j = 0;
	while j < kn {
		g.res[j] = kept[j];
		j++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "traced primes while below limit: ", kn);
	out
}
@end
