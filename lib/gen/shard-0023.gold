fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${step};
	if s <= 0 { s = 1; }
	var count = 0;
	var i = g.n - 1 - s;
	while i >= 0 {
		let tmp = g.res[i];
		g.res[i] = g.res[i + s];
		g.res[i + s] = tmp;
		count++;
		i -= s;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped reverse step items: ", count);
	out
}
@end
