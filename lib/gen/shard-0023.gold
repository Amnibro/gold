@entry 0d1086daf6db9adc
kind: step
verb: rotate
noun: tail
modifier: running
context: retry
phrase: rotate tail segment of running retry entries by {k}
phrase: shift trailing window of running retry counts by {k}
slot: k int
test: list=1,2,3,4,5,6 k=1
expect: => i=1 r=0.0 ok=true s="rotated tail elements 1" errors=0 n=6 res=[1,2,3,6,4,5] cache=0 hits=0
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="rotated tail elements 1" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${k};
	let half = g.n / 2;
	let tail_len = g.n - half;
	if tail_len <= 1 || sh <= 0 { return out; }
	let rot = sh % tail_len;
	for step in rot {
		let last_val = g.res[g.n - 1];
		var p = g.n - 1;
		while p > half {
			g.res[p] = g.res[p - 1];
			p--;
		}
		g.res[half] = last_val;
	}
	g.steps += rot * tail_len;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated tail elements ", rot);
	out
}
@end
