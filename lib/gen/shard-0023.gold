@entry a931df43435d719b
kind: step
verb: sum
noun: duplicates
modifier: unique
context: loop
phrase: sum duplicates unique recurring values
phrase: aggregate unique duplicate values in loop
test: list=2,5,2,8,5,9
expect: => i=7 r=0.0 ok=true s="unique duplicate sum: 7" errors=0 n=1 res=[7] cache=0 hits=0
test: list=4,4,4,10
expect: => i=4 r=0.0 ok=true s="unique duplicate sum: 4" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_dups = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == x {
				seen_before = true;
				break;
			}
			j++;
		}
		if !seen_before {
			var appears_again = false;
			var k = i + 1;
			while k < g.n {
				if g.res[k] == x {
					appears_again = true;
					break;
				}
				k++;
			}
			if appears_again {
				sum_dups += x;
			}
		}
		i++;
	}
	g.res[0] = sum_dups;
	g.n = 1;
	g.steps += g.n * g.n;
	out.i = sum_dups;
	out.s.clear();
	format(out.s, "unique duplicate sum: ", sum_dups);
	out
}
@end
