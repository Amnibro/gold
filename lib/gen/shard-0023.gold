test: list=12,5,8,22,3,15 max_bound=10
expect: => i=3 r=0.0 ok=true s="sorted range at most: 3" errors=0 n=3 res=[3,5,8] cache=0 hits=0
test: list=25,14,30,8,19,4 max_bound=15
expect: => i=3 r=0.0 ok=true s="sorted range at most: 3" errors=0 n=3 res=[4,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${max_bound};
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] <= b {
			kept[kn] = g.res[i];
			kn++;
		}
		i++;
	}
	var j = 0;
	while j < kn {
		var k = j + 1;
		while k < kn {
			if kept[j] > kept[k] {
				let tmp = kept[j];
				kept[j] = kept[k];
				kept[k] = tmp;
			}
			k++;
		}
		j++;
	}
	var m = 0;
	while m < kn {
		g.res[m] = kept[m];
		m++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "sorted range at most: ", kn);
	out
}
@end
