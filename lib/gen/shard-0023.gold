@entry 5d0057ac0bc2b69d
kind: step
verb: rank
noun: step
modifier: with_cache
context: compare
slot: target int
phrase: rank step with_cache against comparison target {target}
phrase: lookup rank step position in comparison cache {target}
test: list=10,40,20,50,30 target=20
expect: => i=2 r=0.0 ok=true s="computed rank step: 2" errors=0 n=5 res=[10,40,20,50,30] cache=1 hits=0
test: list=15,45,25,55,35 target=45
expect: => i=4 r=0.0 ok=true s="computed rank step: 4" errors=0 n=5 res=[15,45,25,55,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	let cached, ok = gold_cache_get(g, t);
	if ok {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached rank step: ", cached);
		return out;
	}
	var r = 1;
	var i = 0;
	while i < g.n {
		if g.res[i] < t {
			r++;
		}
		i++;
	}
	gold_cache_put(g, t, r);
	g.steps += g.n;
	out.i = r;
	out.s.clear();
	format(out.s, "computed rank step: ", r);
	out
}
@end
