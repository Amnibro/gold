				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	gold_cache_put(g, t, g.n);
	out.i = g.n;
	out.s.clear();
	format(out.s, "counter sorted: ", g.n);
	out
}
@end
