@entry 3a64ae35bad0d8db
kind: step
verb: sort
noun: evens
modifier: last
context: retry
phrase: sort retry attempts placing even values last
phrase: partition attempt records with even counts at end
test: list=4,7,2,9,6,3
expect: => i=3 r=0.0 ok=true s="sorted with evens last count 3" errors=0 n=6 res=[3,7,9,2,4,6] cache=0 hits=0
test: list=8,1,6,5,4
expect: => i=3 r=0.0 ok=true s="sorted with evens last count 3" errors=0 n=5 res=[1,5,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var evens int[512] = [0; 512];
	var on = 0;
	var en = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			evens[en] = x;
			en++;
		} else {
			odds[on] = x;
			on++;
		}
	}
	for i in on {
		for j in 0..on - 1 - i {
			if odds[j] > odds[j + 1] {
				let t = odds[j]; odds[j] = odds[j + 1]; odds[j + 1] = t;
			}
		}
	}
	for i in en {
		for j in 0..en - 1 - i {
			if evens[j] > evens[j + 1] {
				let t = evens[j]; evens[j] = evens[j + 1]; evens[j + 1] = t;
			}
		}
	}
	for i in on { g.res[i] = odds[i]; }
	for i in en { g.res[on + i] = evens[i]; }
	g.steps += g.n * 2;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted with evens last count ", en);
	out
}
@end
