		if g.res[i] > ceiling {
			g.res[i] = ceiling;
		}
		gold_cache_put(g, i, g.res[i]);
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped cache at most: ", ceiling);
	out
}
@end
