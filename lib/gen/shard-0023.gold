@entry 99137859e9670157
kind: step
verb: sum
noun: primes
modifier: at_most
context: core
phrase: sum primes at most ceiling {cap}
phrase: accumulate primes at most upper bound {cap}
slot: cap int
test: list=2,3,4,5,6,7,8 cap=5
expect: => i=10 r=0.0 ok=true s="prime sum: 10" errors=0 n=7 res=[2,3,4,5,6,7,8] cache=0 hits=0
test: list=11,12,13,14,15 cap=12
expect: => i=11 r=0.0 ok=true s="prime sum: 11" errors=0 n=5 res=[11,12,13,14,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	fn is_p(n int) bool {
		if n < 2 { return false; }
		var d = 2;
		while d * d <= n {
			if n % d == 0 { return false; }
			d++;
		}
		true
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x <= c && is_p(x) {
			sum += x;
		}
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "prime sum: ", sum);
	out
}
@end
