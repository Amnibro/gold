test: list=3,8,8,15,15,22 bound=12
expect: => i=5 r=0.0 ok=true s="clamped unique numbers: 5" errors=0 n=5 res=[3,8,12,12,12] cache=0 hits=0
test: list=5,14,14,20,20,30 bound=18
expect: => i=5 r=0.0 ok=true s="clamped unique numbers: 5" errors=0 n=5 res=[5,14,18,18,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var uniq int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < un {
			if uniq[j] == x { exists = true; break; }
			j++;
		}
		if !exists {
			uniq[un] = if x > b { b } else { x };
			un++;
		}
		i++;
	}
	var k = 0;
	while k < un {
		g.res[k] = uniq[k];
		k++;
	}
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "clamped unique numbers: ", un);
	out
}
@end
