code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${cap_n};
	var lim = m;
	if lim > g.n { lim = g.n; }
	var sum = 0;
	var i = 0;
	while i < lim {
		sum += g.res[i];
		i++;
	}
	g.res[0] = sum;
	g.n = 1;
	g.steps += lim;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged up to sum: ", sum);
	out
}
@end
