code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var modified = 0;
	var i = 0;
	while i < out.s.len {
		let code = out.s[i] as int;
		if code % 2 != 0 && code > cap {
			out.s[i] = cap as byte;
			modified++;
		}
		i++;
	}
	g.steps += out.s.len;
	out.i = modified;
	out
}
@end
