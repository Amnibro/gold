expect: => i=2 r=0.0 ok=true s="subfunction reverse completed: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for r in ${max_retries} {
		for i in g.n / 2 {
			let j = g.n - 1 - i;
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "subfunction reverse completed: ", g.n);
	out
}
@end
