fn ${ID}(g Gold&, v Val) Val {
	var out = v;
for i in g.n {
	var m = i;
	for j in (i + 1)..g.n { if g.res[j] < g.res[m] { m = j; } }
	if m != i { let t = g.res[i]; g.res[i] = g.res[m]; g.res[m] = t; }
}
if g.n == 0 { return out; }
var k = 1;
while k < g.n && g.res[k] == g.res[0] { k++; }
var rem = 0;
for i in k..g.n { g.res[rem] = g.res[i]; rem++; }
g.n = rem;
out.i = k;
out.s.clear();
format(out.s, "dropped first series of ", k, " items");
out
}
@end
