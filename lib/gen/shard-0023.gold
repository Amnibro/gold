fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] <= ${max_sum} {
			running += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "selected total: ", running);
	out
}
