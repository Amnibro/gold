@entry a091007d727f54cb
kind: step
verb: sort
noun: squares
modifier: unique
context: retry
phrase: sort unique square retry backoffs
phrase: order unique square attempt intervals
test: list=16,4,9,4,25,7
expect: => i=4 r=0.0 ok=true s="sorted unique squares count 4" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=36,10,1,36,9
expect: => i=3 r=0.0 ok=true s="sorted unique squares count 3" errors=0 n=3 res=[1,9,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_arr int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				var already = false;
				for j in count {
					if sq_arr[j] == x { already = true; break; }
				}
				if !already {
					sq_arr[count] = x;
					count++;
				}
			}
		}
	}
	for i in count {
		for j in 0..count - 1 - i {
			if sq_arr[j] > sq_arr[j + 1] {
				let t = sq_arr[j];
				sq_arr[j] = sq_arr[j + 1];
				sq_arr[j + 1] = t;
			}
		}
	}
	for i in count { g.res[i] = sq_arr[i]; }
	g.n = count;
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted unique squares count ", count);
	out
}
@end
