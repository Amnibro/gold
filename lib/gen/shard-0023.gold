@entry 5622aa7b1743d2cd
kind: step
verb: shift
noun: maximum
modifier: between
context: stats
phrase: shift maximum value between index positions {lo} with {hi}
phrase: move peak observation between range bounds {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,3,18,7,25 lo=1 hi=3
expect: => i=18 r=0.0 ok=true s="shifted maximum between: 18" errors=0 n=5 res=[10,18,3,7,25] cache=0 hits=0
test: list=5,8,12,30,15 lo=0 hi=2
expect: => i=12 r=0.0 ok=true s="shifted maximum between: 12" errors=0 n=5 res=[12,5,8,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if g.n == 0 || l >= g.n || l >= h {
		out.i = 0;
		out.s.clear();
		format(out.s, "shift maximum between: none");
		return out;
	}
	var max_idx = l;
	var i = l + 1;
	while i <= h && i < g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
		i++;
	}
	let max_val = g.res[max_idx];
	var j = max_idx;
	while j > l {
		g.res[j] = g.res[j - 1];
		j--;
	}
	g.res[l] = max_val;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "shifted maximum between: ", max_val);
	out
}
@end
