@entry 4e74d419e1bd049f
kind: step
verb: apply
noun: duplicates
modifier: any
context: aggregate
phrase: apply scaling factor if any duplicates exist {scale_fac}
phrase: multiply elements if any duplicates exist {scale_fac}
slot: scale_fac int
test: list=1,2,2,3 scale_fac=5
expect: => i=1 r=0.0 ok=true s="dups applied: 1" errors=0 n=4 res=[5,10,10,15] cache=0 hits=0
test: list=1,2,3,4 scale_fac=10
expect: => i=0 r=0.0 ok=true s="dups applied: 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${scale_fac};
	var has_dups = false;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] { has_dups = true; break; }
		}
		if has_dups { break; }
	}
	if has_dups {
		for i in g.n { g.res[i] *= factor; }
		out.i = 1;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "dups applied: ", out.i);
	out
}
@end
