kind: step
verb: cache
noun: minimum
modifier: with_retry
context: core
phrase: cache minimum with retry cycles {max_tries}
phrase: store minimum with retry sweeps {max_tries}
slot: max_tries int
test: list=19,4,12,7 max_tries=2
expect: => i=4 r=0.0 ok=true s="cached min: 4" errors=0 n=4 res=[19,4,12,7] cache=1 hits=0
test: list=25,18,33,14 max_tries=1
expect: => i=14 r=0.0 ok=true s="cached min: 14" errors=0 n=4 res=[25,18,33,14] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tries = ${max_tries};
	if g.n == 0 { out.i = 0; return out; }
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		i++;
	}
	gold_cache_put(g, 0, min_val);
	g.steps += g.n + tries;
	out.i = min_val;
	out.s.clear();
	format(out.s, "cached min: ", min_val);
	out
}
@end
