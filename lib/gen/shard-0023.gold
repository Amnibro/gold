test: list=10,15,19 maxgap=6
expect: => i=2 r=0.0 ok=true s="gaps valid within threshold" errors=0 n=3 res=[10,15,19] cache=0 hits=0
test: list=10,20 maxgap=6
expect: => i=0 r=0.0 ok=false s="error: gap exceeded" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${maxgap};
	out.s.clear();
	var valid = true;
	if g.n > 1 {
		for k in 1..g.n {
			var diff = g.res[k] - g.res[k - 1];
			if diff < 0 { diff = -diff; }
			if diff > mg {
				valid = false;
				break;
			}
		}
	}
	if !valid {
		gold_fail(g, "consecutive gap exceeds threshold");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: gap exceeded");
		return out;
	}
	out.i = g.n - 1;
	out.ok = true;
	format(out.s, "gaps valid within threshold");
	out
}
@end
