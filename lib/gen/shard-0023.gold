fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var rounds = 0;
	while rounds < 10 {
		var sum_val = 0;
		var i = 0;
		while i < g.n { sum_val += g.res[i]; i++; }
		if sum_val >= tgt { break; }
		var j = 0;
		while j < g.n {
			g.res[j] = ${f}(g.res[j]);
			j++;
		}
		rounds++;
	}
	out.i = rounds;
	out.s.clear();
	format(out.s, "subfunction retries: ", rounds);
	out
}
@end
