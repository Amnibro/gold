noun: counter
modifier: first
context: compare
slot: times int
phrase: repeat counter first value for count {times}
phrase: prepend repeated leading comparison counter instances {times}
test: list=5,10,15 times=3
expect: => i=6 r=0.0 ok=true s="repeated first counter: 6" errors=0 n=6 res=[5,5,5,5,10,15] cache=0 hits=0
