fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_pal = true;
	let len = out.s.len;
	for i in (len / 2) {
		if out.s[i] != out.s[len - 1 - i] {
			is_pal = false;
			break;
		}
	}
	out.ok = is_pal;
	out.i = len;
	out.s.clear();
	if is_pal {
		format(out.s, "palindrome verified");
	} else {
		format(out.s, "not palindrome");
	}
	out
}
@end
@entry 4601d0561a351792
kind: step
verb: group
noun: list
modifier: up_to
context: core
phrase: group list up to partition capacity {chunk_cap}
phrase: bundle list elements up to size {chunk_cap}
slot: chunk_cap int
test: list=1,2,3,4,5,6,7 chunk_cap=3
expect: => i=3 r=0.0 ok=true s="groups count: 3" errors=0 n=3 res=[6,15,7] cache=0 hits=0
test: list=10,20,30 chunk_cap=2
expect: => i=2 r=0.0 ok=true s="groups count: 2" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${chunk_cap};
	if cap <= 0 { gold_fail(g, "capacity must be positive"); out.ok = false; return out; }
	var groups = [0; 512];
	var g_count = 0;
	var i = 0;
	while i < g.n {
		var cur_sum = 0;
		var j = 0;
		while j < cap && (i + j) < g.n {
			cur_sum += g.res[i + j];
			j++;
		}
		groups[g_count] = cur_sum;
		g_count++;
		i += cap;
	}
	gold_clear(g);
	for k in g_count { gold_push(g, groups[k]); }
	out.i = g_count;
	out.s.clear();
	format(out.s, "groups count: ", g_count);
	out
}
@end
