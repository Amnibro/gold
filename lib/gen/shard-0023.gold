fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var total = 0;
	for i in g.n {
		g.res[i] = g.res[i] * mult;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "normalized histogram sum: ", total);
	out
}
