@entry 36f2e8b09e587ab8
kind: step
verb: scale
noun: duplicates
modifier: with_retry
context: core
slot: factor int
slot: retries int
phrase: scale duplicates by factor {factor} with retry count {retries}
phrase: multiply duplicates by factor {factor} under retry limit {retries}
test: list=3,3,7,8,8,2 factor=3 retries=2
expect: => i=2 r=0.0 ok=true s="duplicates scaled: 2" errors=0 n=6 res=[9,3,7,24,8,2] cache=0 hits=0
test: list=5,5,5 factor=2 retries=1
expect: => i=2 r=0.0 ok=true s="duplicates scaled: 2" errors=0 n=3 res=[10,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var scaled = 0;
	for r in ${retries} {
		scaled = 0;
		for i in g.n {
			var is_dup = false;
			for j in g.n {
				if i != j && g.res[i] == g.res[j] {
					is_dup = true;
					break;
				}
			}
			if is_dup {
				g.res[i] = g.res[i] * ${factor};
				scaled++;
			}
		}
		if scaled > 0 { break; }
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "duplicates scaled: ", scaled);
	out
}
@end
