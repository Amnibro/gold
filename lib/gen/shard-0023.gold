test: list=1,1,2,2,3,3 times=2
expect: => i=6 r=0.0 ok=true s="deduped cache times: 6" errors=0 n=6 res=[1,1,2,2,3,3] cache=3 hits=0
test: list=4,4,4,5,5,5 times=3
expect: => i=6 r=0.0 ok=true s="deduped cache times: 6" errors=0 n=6 res=[4,4,4,5,5,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${times};
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = 0;
		var j = 0;
		while j < kn {
			if kept[j] == x { seen++; }
			j++;
		}
		if seen < limit {
			kept[kn] = x;
			kn++;
		}
		i++;
	}
	var k = 0;
	while k < kn {
		g.res[k] = kept[k];
		gold_cache_put(g, kept[k], k);
		k++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "deduped cache times: ", kn);
	out
}
@end
