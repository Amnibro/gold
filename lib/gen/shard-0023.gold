test: list=8,9,11,13
expect: => i=2 r=0.0 ok=true s="collected primes each: 2" errors=0 n=4 res=[0,0,1,1] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	if n == 2 || n == 3 { return true; }
	if n % 2 == 0 { return false; }
	var d = 3;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 2;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes_count = 0;
	for i in g.n {
		let is_p = ${ID}_is_prime(g.res[i]);
		if is_p {
			g.res[i] = 1;
			primes_count++;
		} else {
			g.res[i] = 0;
		}
	}
	g.steps += g.n;
	out.i = primes_count;
	out.s.clear();
	format(out.s, "collected primes each: ", primes_count);
	out
}
@end
