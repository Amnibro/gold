@entry 17c458f177136109
kind: step
verb: limit
noun: streak
modifier: each
context: transform
phrase: limit consecutive streak of identical elements to count {cap}
phrase: restrict repeating streak for each run to maximum {cap}
slot: cap int
test: list=3,3,3,4,4,4,5 cap=2
expect: => i=2 r=0.0 ok=true s="streak limited" errors=0 n=5 res=[3,3,4,4,5] cache=0 hits=0
test: list=1,1,1,1,2 cap=1
expect: => i=3 r=0.0 ok=true s="streak limited" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${cap};
	if g.n == 0 || max_run <= 0 {
		g.n = 0;
		out.i = 0;
		gold_text(out, "streak limited");
		return out;
	}
	var write_idx = 1;
	var current_run = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			current_run++;
		} else {
			current_run = 1;
		}
		if current_run <= max_run {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	out.i = g.n - write_idx;
	g.n = write_idx;
	gold_text(out, "streak limited");
	out
}
@end
