@entry 6bb6eae386ee1b38
kind: step
verb: drop
noun: squares
modifier: safely
context: stats
phrase: drop square values safely from sample
phrase: filter out perfect squares safely across observations
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="dropped squares count: 3" errors=0 n=2 res=[7,12] cache=0 hits=0
test: list=1,3,5,25
expect: => i=2 r=0.0 ok=true s="dropped squares count: 2" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}_is_square(n int) bool {
	if n < 0 { return false; }
	if n == 0 || n == 1 { return true; }
	var r = 1;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_square(x) {
			dropped++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped squares count: ", dropped);
	out
}
@end
@entry 6d6194b57b441eeb
kind: step
verb: find
noun: primes
modifier: safely
