expect: => i=12 r=0.0 ok=true s="limit retry total: 12" errors=0 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var tries = 0;
	var total = 0;
	for i in g.n { total += g.res[i]; }
	while total < tgt && tries < 5 {
		for i in g.n { g.res[i] += 1; }
		total += g.n;
		tries++;
	}
	g.steps += tries;
	out.i = total;
	out.s.clear();
	format(out.s, "limit retry total: ", total);
	out
}
@end
