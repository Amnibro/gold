code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_square};
	var stored = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq <= lim {
			gold_cache_put(g, i, sq);
			stored++;
		}
	}
	out.i = stored;
	out.s.clear();
	format(out.s, "squares cached: ", stored);
	out
}
@end
