noun: runs
modifier: at_most
context: core
slot: max_len int
phrase: scan runs of identical values at most {max_len} times
phrase: limit runs by scanning at most {max_len} elements
test: list=3,3,3,3,5,5,2 max_len=2
expect: => i=5 r=0.0 ok=true s="scanned runs kept: 5" errors=0 n=5 res=[3,3,5,5,2] cache=0 hits=0
test: list=7,7,7,7 max_len=1
expect: => i=1 r=0.0 ok=true s="scanned runs kept: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var kept = 0;
	var run_len = 0;
	var last_val = g.res[0] - 1;
	for i in g.n {
		let val = g.res[i];
		if val == last_val {
			run_len++;
		} else {
			last_val = val;
			run_len = 1;
		}
		if run_len <= ${max_len} {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "scanned runs kept: ", kept);
	out
}
@end
