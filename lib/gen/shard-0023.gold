code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = is_sorted;
	if !is_sorted {
		gold_fail(g, "unsorted steps detected");
	}
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "steps sorted status: ", is_sorted);
	out
}
@end
@entry 469809fb79d37ad4
kind: step
verb: sort
noun: threshold
modifier: running
context: compare
slot: threshold int
phrase: sort threshold running values exceeding cutoff {threshold}
phrase: order comparison elements exceeding running threshold {threshold}
test: list=12,4,18,7,25,3 threshold=10
expect: => i=3 r=0.0 ok=true s="sorted above threshold: 3" errors=0 n=6 res=[12,18,25,4,7,3] cache=0 hits=0
test: list=30,5,15,2,40,9 threshold=20
expect: => i=2 r=0.0 ok=true s="sorted above threshold: 2" errors=0 n=6 res=[30,40,5,15,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var above int[512] = [0; 512];
	var below int[512] = [0; 512];
	var an = 0;
	var bn = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > thresh {
			above[an] = g.res[i];
			an++;
		} else {
			below[bn] = g.res[i];
			bn++;
		}
		i++;
	}
	var j = 0;
	while j < an {
		var k = j + 1;
		while k < an {
			if above[j] > above[k] {
				let tmp = above[j];
				above[j] = above[k];
				above[k] = tmp;
			}
			k++;
		}
		j++;
	}
	var m = 0;
	while m < an {
		g.res[m] = above[m];
		m++;
	}
	var n = 0;
	while n < bn {
		g.res[an + n] = below[n];
		n++;
	}
	g.steps += g.n;
	out.i = an;
	out.s.clear();
	format(out.s, "sorted above threshold: ", an);
	out
}
@end
