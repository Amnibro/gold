code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var i = g.n - 1;
	while i >= 0 {
		total += g.res[i];
		gold_cache_put(g, i, total);
		i--;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "suffix sum: ", total);
	out
}
@end
@entry 14c37d867e0e8120
kind: step
verb: collect
noun: digits
modifier: with_retry
context: core
phrase: collect digits with retry limit {retries}
phrase: extract number digits with retry budget {retries}
slot: retries int
test: input=456 retries=2
expect: => i=3 r=0.0 ok=true s="collected digits: 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: input=89 retries=1
expect: => i=2 r=0.0 ok=true s="collected digits: 2" errors=0 n=2 res=[8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 { num = -num; }
	var digits = [0; 64];
	var count = 0;
	if num == 0 {
		digits[0] = 0;
		count = 1;
	} else {
		while num > 0 {
			digits[count] = num % 10;
			count++;
			num /= 10;
		}
	}
	gold_clear(g);
	var idx = count - 1;
	while idx >= 0 {
		gold_push(g, digits[idx]);
		idx--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "collected digits: ", count);
	out
}
@end
