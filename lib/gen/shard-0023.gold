code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let p_len = if sp < g.n { sp } else { g.n };
	var u = [0; 512];
	var un = 0;
	for i in p_len {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[un] = x;
			un++;
		}
	}
	var buf = [0; 512];
	var bn = 0;
	for i in un {
		buf[bn] = u[i];
		bn++;
	}
	var k = p_len;
	while k < g.n {
		buf[bn] = g.res[k];
		bn++;
		k++;
	}
	g.n = 0;
	for i in bn { gold_push(g, buf[i]); }
	out.i = bn;
	out.s.clear();
	format(out.s, "prefix deduped: ", bn);
	out
}
@end
