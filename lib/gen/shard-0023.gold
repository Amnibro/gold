@entry 1cd83cbac3b3955b
kind: step
verb: dedupe
noun: history
modifier: at_most
context: retry
phrase: dedupe retry history keeping at most {cap} items
phrase: prune repeated attempt history to at most {cap} entries
slot: cap int
test: list=5,2,5,8,2,9,1 cap=3
expect: => i=3 r=0.0 ok=true s="deduped history capped at 3" errors=0 n=3 res=[5,2,8] cache=0 hits=0
test: list=10,20,10,30,40,20 cap=2
expect: => i=2 r=0.0 ok=true s="deduped history capped at 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_items = ${cap};
	var unique_len = 0;
	for i in g.n {
		if unique_len >= limit_items { break; }
		let item = g.res[i];
		var exists = false;
		for j in unique_len {
			if g.res[j] == item { exists = true; break; }
		}
		if !exists {
			g.res[unique_len] = item;
			unique_len++;
		}
	}
	g.steps += g.n * unique_len;
	g.n = unique_len;
	out.i = unique_len;
	out.s.clear();
	format(out.s, "deduped history capped at ", unique_len);
	out
}
@end
