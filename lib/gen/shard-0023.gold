@entry a8a58ff05279d8b5
kind: step
verb: select
noun: value
modifier: pairwise
context: error
phrase: select value pairwise difference above {threshold}
phrase: find pair difference exceeding {threshold}
slot: threshold int
test: list=10,35,40 threshold=20
expect: => i=25 r=0.0 ok=true s="pairwise threshold found" errors=0 n=3 res=[10,35,40] cache=0 hits=0
test: list=10,15,18 threshold=20
expect: => i=0 r=0.0 ok=false s="error: no pair exceeded threshold" errors=1 n=3 res=[10,15,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var found_diff = 0;
	var found = false;
	if g.n > 1 {
		for k in 1..g.n {
			let d = g.res[k] - g.res[k - 1];
			if d > th {
				found_diff = d;
				found = true;
				break;
			}
		}
	}
	out.s.clear();
	if !found {
		gold_fail(g, "no adjacent pairwise difference exceeded threshold");
		out.ok = false;
		out.i = 0;
		format(out.s, "error: no pair exceeded threshold");
		return out;
	}
	out.i = found_diff;
	out.ok = true;
	format(out.s, "pairwise threshold found");
	out
}
@end
