expect: => i=17 r=0.0 ok=true s="normalized words sum: 17" errors=0 n=4 res=[2,6,0,9] cache=0 hits=0
test: list=20,35,25
expect: => i=20 r=0.0 ok=true s="normalized words sum: 20" errors=0 n=3 res=[0,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "normalized words: 0");
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var total = 0;
	for i in g.n {
		g.res[i] = g.res[i] - min_val;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "normalized words sum: ", total);
	out
}
@end
