expect: => i=2 r=0.0 ok=true s="limited middle safely: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	var take = req;
	if take > g.n { take = g.n; }
	if take < 0 { take = 0; }
	let start = (g.n - take) / 2;
	for i in take {
		g.res[i] = g.res[start + i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "limited middle safely: ", take);
	out
}
@end
