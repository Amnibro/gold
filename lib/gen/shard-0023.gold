noun: histogram
modifier: recursively
context: compare
phrase: join histogram recursively across comparison frequency buckets
phrase: merge recurring comparison frequencies into unified tally
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="histogram bucket count: 3" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=4,4,4,4,5,5
expect: => i=2 r=0.0 ok=true s="histogram bucket count: 2" errors=0 n=2 res=[4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var counts int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var found = -1;
		var j = 0;
		while j < un {
			if uniq[j] == x { found = j; break; }
			j++;
		}
		if found >= 0 {
			counts[found] = counts[found] + 1;
		} else {
			uniq[un] = x;
			counts[un] = 1;
			un++;
		}
		i++;
	}
	var k = 0;
	while k < un {
		g.res[k] = counts[k];
		k++;
	}
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "histogram bucket count: ", un);
	out
}
@end
