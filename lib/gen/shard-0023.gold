kind: step
verb: retry
noun: budget
modifier: at_most
context: aggregate
phrase: retry budget at most cap of {retries}
phrase: spend budget with at most {retries} retries
slot: retries int
test: list=40,50,30 retries=2
expect: => i=97 r=0.0 ok=true s="spent budget: 97" errors=0 n=3 res=[40,50,7] cache=0 hits=0
test: list=80,60,10 retries=3
expect: => i=100 r=0.0 ok=true s="spent budget: 100" errors=0 n=3 res=[80,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = max(0, ${retries});
	var total = 0;
	var kept = 0;
	for i in g.n {
		var item = g.res[i];
		var tries = 0;
		while total + item > 100 && tries < max_r {
			item /= 2;
			tries++;
		}
		if total + item <= 100 {
			total += item;
			g.res[kept] = item;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "spent budget: ", total);
	out
}
@end
