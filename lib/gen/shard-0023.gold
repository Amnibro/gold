@entry 4371fd523d3073a1
kind: step
verb: find
noun: minimum
modifier: unique
context: core
phrase: find minimum unique value in results list
phrase: locate smallest distinct item among results
test: list=4,2,3,2,5,3,7
expect: => i=4 r=0.0 ok=true s="min unique: 4" errors=0 n=7 res=[4,2,3,2,5,3,7] cache=0 hits=0
test: list=8,8,6,9
expect: => i=6 r=0.0 ok=true s="min unique: 6" errors=0 n=4 res=[8,8,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var min_val = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == 1 {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	if found {
		out.i = min_val;
		out.ok = true;
		out.s.clear();
		format(out.s, "min unique: ", min_val);
	} else {
		out.ok = false;
		out.s.clear();
		format(out.s, "no unique element");
	}
	out
}
@end
