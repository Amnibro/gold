	let p_min = ${min_peak};
	if g.n == 0 { out.i = 0; return out; }
	var peak_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > peak_val { peak_val = g.res[i]; }
	}
	gold_clear(g);
	if peak_val >= p_min {
		gold_push(g, peak_val);
		out.i = peak_val;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "collected peak: ", out.i);
	out
}
