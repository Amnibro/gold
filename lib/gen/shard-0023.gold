test: list=6,8,13,19
expect: => i=2 r=0.0 ok=true s="primes found safely: 2" errors=0 n=2 res=[13,19] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	if n == 2 || n == 3 { return true; }
	if n % 2 == 0 { return false; }
	var d = 3;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 2;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			g.res[w] = x;
			w++;
			count++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "primes found safely: ", count);
	out
}
@end
@entry f6beb3555c6c1739
kind: step
verb: drop
noun: step
modifier: sorted
context: stats
phrase: drop step extremes from sorted sample
phrase: trim outer step values from sorted observations
test: list=18,4,30,12,7
expect: => i=3 r=0.0 ok=true s="drop step sorted remaining: 3" errors=0 n=3 res=[7,12,18] cache=0 hits=0
test: list=50,10,40,20
expect: => i=2 r=0.0 ok=true s="drop step sorted remaining: 2" errors=0 n=2 res=[20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "drop step sorted: cleared");
		return out;
	}
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	for i in g.n - 2 {
		g.res[i] = g.res[i + 1];
	}
	g.n = g.n - 2;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "drop step sorted remaining: ", g.n);
	out
}
@end
