fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = min(g.n, max(2, ${k}));
	sort(g.res[..count]) { a, b => a < b };
	var wr = 0;
	var i = 0;
	while i + 1 < count {
		g.res[wr] = g.res[i] + g.res[i + 1];
		wr++;
		i += 2;
	}
	for j in count..g.n {
		g.res[wr] = g.res[j];
		wr++;
	}
	g.n = wr;
	g.steps += wr;
	out.i = wr;
	out.s.clear();
	format(out.s, "paired sorted prefix to ", wr, " elements");
	out
}
@end
