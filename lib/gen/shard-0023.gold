	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			matched[mn] = x;
			mn++;
		}
		i++;
	}
	if mn == 0 {
		gold_fail(g, "no checkpoint found between bounds");
		out.ok = false;
		return out;
	}
	var j = 0;
	while j < mn {
		g.res[j] = matched[j];
		j++;
	}
	g.n = mn;
	g.steps += g.n + mn;
	out.i = mn;
	out.s.clear();
	format(out.s, "checkpoint items restored: ", mn);
	out
}
@end
