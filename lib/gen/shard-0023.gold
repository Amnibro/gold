code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "maximum sorted: 0");
		return out;
	}
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	let max_val = g.res[g.n - 1];
	g.steps += g.n * g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum sorted: ", max_val);
	out
}
@end
