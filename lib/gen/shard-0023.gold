fn ${ID}(g Gold&, v Val) Val {
	var out = v;
var passes = 0;
var changed = true;
while changed && passes < 1000 {
	changed = false;
	for i in (g.n - 1) {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			changed = true;
		}
	}
	passes++;
}
g.steps += passes;
out.i = passes;
out.s.clear();
format(out.s, "sorted results in ", passes, " passes");
out
}
@end
