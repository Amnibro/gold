expect: => i=4 r=0.0 ok=true s="survived: 4" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
test: list=10,20,30,40,50,60 k=2
expect: => i=4 r=0.0 ok=true s="survived: 4" errors=0 n=4 res=[10,20,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || k >= g.n { return out; }
	let start = (g.n - k) / 2;
	var i = start;
	while i + k < g.n {
		g.res[i] = g.res[i + k];
		i++;
	}
	g.n -= k;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "survived: ", g.n);
	out
}
@end
