code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${mincount};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kn { if kept[j] == x { seen = true; break; } }
		if !seen {
			var cnt = 0;
			for k in g.n { if g.res[k] == x { cnt++; } }
			if cnt >= mc { kept[kn] = x; kn++; }
		}
	}
	g.n = 0;
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "unique tally: ", kn);
	out
}
@end
