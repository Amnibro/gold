code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[256] = [0; 256];
	var on = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			var j = 0;
			while j < on {
				if odds[j] == x { seen = true; break; }
				j++;
			}
			if !seen {
				odds[on] = x;
				on++;
			}
		}
		i++;
	}
	g.steps += g.n + on;
	out.i = on;
	out.s.clear();
	format(out.s, "unique odd count: ", on);
	out
}
@end
