phrase: reverse head portion of size {count}
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="merged head in reverse: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="merged head in reverse: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	if k > g.n { k = g.n; }
	if k < 0 { k = 0; }
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "merged head in reverse: ", k);
	out
}
@end
