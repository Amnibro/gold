code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${tag};
	if g.n >= 2 {
		let old_head = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = old_head;
		gold_cache_put(g, tg, old_head);
		out.i = old_head;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "swapped checkpoint tagged ", tg);
	out
}
@end
