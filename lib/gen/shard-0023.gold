fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${max_items};
	var matched = 0;
	var i = g.n - 1;
	var examined = 0;
	while i >= 0 && examined < count {
		if g.res[i] > out.i {
			matched++;
		}
		i--;
		examined++;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "tail matched: ", matched);
	out
}
@end
