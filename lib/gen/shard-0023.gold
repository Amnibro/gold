	let off = ${k};
	if g.n <= 1 || off <= 0 { return out; }
	let rot = off % g.n;
	for r in rot {
		let first_val = g.res[0];
		for i in 0..g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first_val;
