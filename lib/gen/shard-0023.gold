@entry ca1eef85c47ade45
kind: step
verb: measure
noun: window
modifier: in_reverse
context: loop
slot: size int
phrase: measure window in_reverse sizes of {size}
phrase: compute reverse window sums of width {size}
test: list=1,2,3,4,5 size=2
expect: => i=4 r=0.0 ok=true s="measured reverse windows: 4" errors=0 n=4 res=[9,7,5,3] cache=0 hits=0
test: list=10,20,30 size=3
expect: => i=1 r=0.0 ok=true s="measured reverse windows: 1" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n < w {
		gold_fail(g, "window size exceeds list bounds");
		out.ok = false;
		return out;
	}
	let wn = g.n - w + 1;
	var sums int[256] = [0; 256];
	var k = 0;
	while k < wn {
		let start = g.n - w - k;
		var s = 0;
		var j = 0;
		while j < w {
			s += g.res[start + j];
			j++;
		}
		sums[k] = s;
		k++;
	}
	var m = 0;
	while m < wn {
		g.res[m] = sums[m];
		m++;
	}
	g.n = wn;
	g.steps += wn * w;
	out.i = wn;
	out.s.clear();
	format(out.s, "measured reverse windows: ", wn);
	out
}
@end
