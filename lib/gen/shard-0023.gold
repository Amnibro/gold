code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${keep_n};
	var m = k;
	if m > g.n { m = g.n; }
	if m < 0 { m = 0; }
	let start = g.n - m;
	var i = 0;
	while i < m {
		g.res[i] = g.res[start + i];
		i++;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "cached last numbers: ", m);
	out
}
@end
