@entry 0071e0e7cc4304c4
kind: step
verb: repeat
noun: primes
modifier: with_cache
context: retry
phrase: repeat prime retry intervals with cache lookup {count}
phrase: generate prime attempt delays with cache storage {count}
slot: count int
test: count=3
expect: => i=3 r=0.0 ok=true s="generated primes count 3" errors=0 n=3 res=[2,3,5] cache=3 hits=0
test: count=5
expect: => i=5 r=0.0 ok=true s="generated primes count 5" errors=0 n=5 res=[2,3,5,7,11] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${count};
	gold_clear(g);
	var candidate = 2;
	while g.n < target {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, candidate);
			gold_cache_put(g, g.n, candidate);
		}
		candidate++;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "generated primes count ", g.n);
	out
}
@end
