@entry ebfef72bd016c95b
kind: step
verb: sort
noun: series
modifier: every_other
context: filter
phrase: sort series elements at every other alternating index
phrase: order alternating entries throughout series positions
test: list=9,1,7,2,5,3,1,4
expect: => i=4 r=0.0 ok=true s="sorted every other: 4" errors=0 n=8 res=[1,1,5,2,7,3,9,4] cache=0 hits=0
test: list=40,10,30,20,20,30
expect: => i=3 r=0.0 ok=true s="sorted every other: 3" errors=0 n=6 res=[20,10,30,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var alt = [0; 512];
	var an = 0;
	var i = 0;
	while i < g.n { alt[an] = g.res[i]; an++; i += 2; }
	for a in an {
		for b in 0..(an - 1 - a) {
			if alt[b] > alt[b + 1] {
				let tmp = alt[b];
				alt[b] = alt[b + 1];
				alt[b + 1] = tmp;
			}
		}
	}
	var j = 0;
	for k in an { g.res[j] = alt[k]; j += 2; }
	out.i = an;
	out.s.clear();
	format(out.s, "sorted every other: ", an);
	out
}
@end
