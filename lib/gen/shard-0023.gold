		out.ok = false;
		return out;
	}
	let start = if k >= out.s.len { 0 } else { out.s.len - k };
	var seen bool[256] = [false; 256];
	var unique_cnt = 0;
	var i = start;
	while i < out.s.len {
		let idx = out.s[i] as int;
		if idx >= 0 && idx < 256 {
			if !seen[idx] {
				seen[idx] = true;
				unique_cnt++;
			}
		}
		i++;
	}
	g.steps += out.s.len - start;
	out.i = unique_cnt;
	out
}
@end
@entry 624e27f0ffd8ca79
kind: step
verb: rank
noun: suffix
modifier: times
context: text
phrase: rank matching suffix letters multiplied by {factor}
phrase: score trailing letter streak times factor {factor}
slot: factor int
test: text="testing" factor=10
expect: => i=70 r=0.0 ok=true s="testing" errors=0 n=1 res=[70] cache=0 hits=0
test: text="runner" factor=5
expect: => i=30 r=0.0 ok=true s="runner" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${factor};
	var alphabetic_tail = 0;
	var i = out.s.len;
	while i > 0 {
		i--;
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			alphabetic_tail++;
		} else {
			break;
		}
	}
	let score = alphabetic_tail * factor;
	g.steps += alphabetic_tail;
	gold_push(g, score);
	out.i = score;
	out
}
@end
@entry b69ad754f6fee29b
kind: step
verb: dedupe
noun: limit
modifier: any
context: text
phrase: dedupe repeated characters capped at limit {lim}
phrase: limit consecutive character repetitions to {lim}
slot: lim int
test: text="aaabbbccc" lim=2
expect: => i=6 r=0.0 ok=true s="aabbcc" errors=0 n=0 res=[] cache=0 hits=0
test: text="zzzz" lim=1
expect: => i=1 r=0.0 ok=true s="z" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if lim <= 0 {
		gold_fail(g, "repetition limit must be positive");
		out.ok = false;
		return out;
	}
	var res byte[..200] = "";
	var last byte = 0 as byte;
	var run_len = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c == last {
			run_len++;
		} else {
			last = c;
			run_len = 1;
		}
		if run_len <= lim && res.len < 200 {
			res.push(c);
		}
		i++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
