@entry 51f885948baf86f4
kind: step
verb: scale
noun: average
modifier: at_least
context: aggregate
slot: min_avg int
phrase: scale average at least target {min_avg}
phrase: boost list when average under {min_avg}
test: list=5,15 min_avg=20
expect: => i=2 r=0.0 ok=true s="average scale factor: 2" errors=0 n=2 res=[10,30] cache=0 hits=0
test: list=30,50 min_avg=20
expect: => i=1 r=0.0 ok=true s="average scale factor: 1" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_avg};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "average scaled: 0");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / g.n;
	if avg < req {
		var j = 0;
		while j < g.n {
			g.res[j] *= 2;
			j++;
		}
		out.i = 2;
	} else {
		out.i = 1;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "average scale factor: ", out.i);
	out
}
@end
