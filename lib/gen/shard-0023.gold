fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "hinge", "", o);
	o.append(" cyl ");
	o.append("0"); o.append(","); o.append("0"); o.append(","); o.append("0");
	o.append(" ");
	o.append("0"); o.append(","); o.append("0"); o.append(",");
