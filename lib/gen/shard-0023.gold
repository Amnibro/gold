	var num = if n < 0 { -n } else { n };
	var digits int[..32] = [];
	while num > 0 {
		digits.push(num % 10);
		num /= 10;
	}
	if digits.len <= w {
		var res = 0;
		var i = digits.len - 1;
		while i >= 0 {
			res = res * 10 + digits[i];
			i--;
		}
		return res;
	}
	var res = 0;
	var i = digits.len - 1;
	var taken = 0;
	while taken < w && i >= 0 {
		res = res * 10 + digits[i];
		taken++;
		i--;
	}
	res
}
