expect: 1
code:
fn ${ID}(n int) int {
	let limit = ${cap};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var runs = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d != prev {
			runs++;
			prev = d;
		}
		x /= 10;
	}
	if runs > limit { limit } else { runs }
}
@end
