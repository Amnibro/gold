expect: => i=3 r=0.0 ok=true s="search counter match count: 3" errors=0 n=6 res=[5,8,5,10,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == t {
			found++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = found;
	out.ok = found > 0;
	out.s.clear();
	format(out.s, "search counter match count: ", found);
	out
}
@end
@entry bf744e72f3cc4884
kind: step
verb: fold
noun: limit
modifier: running
context: compare
slot: limit int
phrase: fold limit running sums across comparison items {limit}
phrase: accumulate running values clamped to limit {limit}
test: list=5,12,8,20,4 limit=10
expect: => i=10 r=0.0 ok=true s="running fold limit: 10" errors=0 n=5 res=[5,10,10,10,10] cache=0 hits=0
test: list=7,15,3,25,6 limit=12
expect: => i=12 r=0.0 ok=true s="running fold limit: 12" errors=0 n=5 res=[7,12,12,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var acc = 0;
	var i = 0;
	while i < g.n {
		acc += g.res[i];
		if acc > lim {
			acc = lim;
		}
		g.res[i] = acc;
		i++;
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "running fold limit: ", acc);
	out
}
@end
@entry 35d110fdec753c63
kind: step
verb: rotate
noun: pairs
modifier: unique
context: compare
phrase: rotate pairs unique across comparison sequence
phrase: cycle adjacent unique pairs in comparison list
test: list=1,2,3,4,5,6
expect: => i=6 r=0.0 ok=true s="rotated pairs count: 6" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="rotated pairs count: 4" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] != g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated pairs count: ", g.n);
	out
}
@end
@entry 39207c6ae83fdd42
kind: step
verb: trace
noun: results
modifier: between
context: compare
slot: low int
slot: high int
phrase: trace results between comparison limits from {low} up to {high}
phrase: record comparison results bounded from {low} to {high}
test: list=5,12,18,25,30,42 low=10 high=28
expect: => i=3 r=0.0 ok=true s="traced results between bounds: 3" errors=0 n=3 res=[12,18,25] cache=0 hits=0
test: list=3,8,14,22,35,48 low=12 high=36
expect: => i=3 r=0.0 ok=true s="traced results between bounds: 3" errors=0 n=3 res=[14,22,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			kept[kn] = x;
			kn++;
		}
		i++;
	}
	var j = 0;
	while j < kn {
		g.res[j] = kept[j];
		j++;
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "traced results between bounds: ", kn);
	out
}
@end
@entry f2b8f1523738e25d
kind: step
verb: clamp
noun: history
modifier: unique
context: compare
slot: limit int
phrase: clamp history unique elements to ceiling {limit}
phrase: deduplicate comparison history clamping values at {limit}
test: list=4,8,8,12,12,16 limit=10
expect: => i=5 r=0.0 ok=true s="clamped unique history count: 5" errors=0 n=5 res=[4,8,10,10,10] cache=0 hits=0
test: list=5,10,10,15,15,20 limit=12
expect: => i=5 r=0.0 ok=true s="clamped unique history count: 5" errors=0 n=5 res=[5,10,12,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var uniq int[512] = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		var j = 0;
		while j < un {
			if uniq[j] == x { exists = true; break; }
			j++;
		}
		if !exists {
			uniq[un] = if x > lim { lim } else { x };
			un++;
		}
		i++;
	}
	var k = 0;
	while k < un {
		g.res[k] = uniq[k];
		k++;
	}
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "clamped unique history count: ", un);
	out
}
@end
