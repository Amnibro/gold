@entry 7394544f00f1b9f4
kind: step
verb: rotate
noun: primes
modifier: recursively
context: compare
slot: shifts int
phrase: rotate primes recursively across comparison elements {shifts}
phrase: shift prime positions recursively in comparison list {shifts}
test: list=2,3,4,5,6,7 shifts=1
expect: => i=4 r=0.0 ok=true s="rotated primes count: 4" errors=0 n=6 res=[7,2,4,3,6,5] cache=0 hits=0
test: list=11,12,13,14,17 shifts=2
expect: => i=3 r=0.0 ok=true s="rotated primes count: 3" errors=0 n=5 res=[13,12,17,14,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shifts};
	var p_idx int[512] = [0; 512];
	var p_val int[512] = [0; 512];
	var pn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			p_idx[pn] = i;
			p_val[pn] = x;
			pn++;
		}
		i++;
	}
	if pn > 1 {
		var k = 0;
		while k < pn {
			let new_k = (k + s) % pn;
			g.res[p_idx[new_k]] = p_val[k];
			k++;
		}
	}
	g.steps += g.n + pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "rotated primes count: ", pn);
	out
}
@end
