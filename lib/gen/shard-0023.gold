expect: => i=5 r=0.0 ok=true s="lohel" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${shift};
	if out.s.len == 0 { return out; }
	let s = ((shift % out.s.len) + out.s.len) % out.s.len;
	var res byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let idx = (i + s) % out.s.len;
		res.push(out.s[idx]);
		i++;
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = out.s.len;
	out
}
@end
