@entry 62d524eb2819f43d
kind: step
verb: shift
noun: series
modifier: up_to
context: core
phrase: shift series up to index {cap}
phrase: rotate series up to boundary {cap}
slot: cap int
test: list=10,20,30,40,50 cap=3
expect: => i=3 r=0.0 ok=true s="shifted up to: 3" errors=0 n=5 res=[20,30,10,40,50] cache=0 hits=0
test: list=1,2,3,4 cap=2
expect: => i=2 r=0.0 ok=true s="shifted up to: 2" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = if ${cap} < g.n { ${cap} } else { g.n };
	if bound <= 1 { return out; }
	let first = g.res[0];
	var i = 0;
	while i + 1 < bound {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[bound - 1] = first;
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "shifted up to: ", bound);
	out
}
@end
@entry 8a5d7bde249db0dd
kind: step
verb: sum
noun: pairs
modifier: up_to
context: core
phrase: sum pairs up to ceiling {limit}
phrase: accumulate pairs up to bound {limit}
slot: limit int
test: list=2,3,4,5,6 limit=8
expect: => i=5 r=0.0 ok=true s="sum: 5" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=1,2,3,4 limit=5
expect: => i=3 r=0.0 ok=true s="sum: 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pair_sum = 0;
	var pairs_counted = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s <= lim {
			pair_sum += s;
			pairs_counted++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = pair_sum;
	out.s.clear();
	format(out.s, "sum: ", pair_sum);
	out
}
@end
