test: list=10,10,20,30
expect: => i=60 r=0.0 ok=true s="sum unique: 60" errors=0 n=4 res=[10,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen_vals = [0; 512];
	var s_count = 0;
	var sum_uniq = 0;
	for i in g.n {
		let v_item = g.res[i];
		var already = false;
		for j in s_count { if seen_vals[j] == v_item { already = true; break; } }
		if !already {
			seen_vals[s_count] = v_item;
			s_count++;
			sum_uniq += v_item;
		}
	}
	out.i = sum_uniq;
	out.s.clear();
	format(out.s, "sum unique: ", sum_uniq);
	out
}
@end
