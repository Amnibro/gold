fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var rev = [0; 512];
	var rn = 0;
	var i = g.n - 1;
	while i >= 0 && rn < lim {
		rev[rn] = g.res[i];
		rn++;
		i--;
	}
	g.n = 0;
	var j = 0;
	while j < rn {
		gold_push(g, rev[j]);
		j++;
	}
	out.i = rn;
	out.s.clear();
	format(out.s, "reverse history count: ", rn);
	out
}
@end
@entry f049dbfcf5ad3484
kind: step
verb: merge
noun: histogram
modifier: recursively
context: aggregate
phrase: merge histogram recursively using bucket span {bucket}
phrase: combine histogram frequencies recursively with width {bucket}
slot: bucket int
test: list=2,3,7,12,14 bucket=5
expect: => i=3 r=0.0 ok=true s="histogram bins: 3" errors=0 n=3 res=[2,1,2] cache=0 hits=0
test: list=10,12,25,30 bucket=10
expect: => i=4 r=0.0 ok=true s="histogram bins: 4" errors=0 n=4 res=[0,2,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b <= 0 { gold_fail(g, "bucket positive required"); out.ok = false; return out; }
	var hist = [0; 512];
	var hn = 0;
	var i = 0;
	while i < g.n {
		let bin_idx = g.res[i] / b;
		if bin_idx >= 0 && bin_idx < 512 {
			if bin_idx >= hn { hn = bin_idx + 1; }
			hist[bin_idx]++;
		}
		i++;
	}
	g.n = 0;
	var j = 0;
	while j < hn {
		gold_push(g, hist[j]);
		j++;
	}
	out.i = hn;
	out.s.clear();
	format(out.s, "histogram bins: ", hn);
	out
}
@end
