fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var w = 0;
	for k in g.n {
		var num = g.res[k];
		if num < 0 { num = -num; }
		var s = 0;
		while num > 0 {
			s += num % 10;
			num /= 10;
		}
		if s == tgt {
			g.res[w] = g.res[k];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "items matching digit target ", w);
	out
}
