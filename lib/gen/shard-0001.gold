fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var max_streak = 0;
	var cur_streak = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == tgt {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 0;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest every_other streak is ", max_streak);
	out
}
