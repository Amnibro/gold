expect: => i=4 r=0.0 ok=true s="merged duplicates between bounds: 4" errors=0 n=4 res=[1,1,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var kept = 0;
	for i in g.n {
		if kept > 0 && g.res[i] == g.res[kept - 1] && g.res[i] >= low && g.res[i] <= high {
			continue;
		}
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged duplicates between bounds: ", kept);
	out
}
@end
