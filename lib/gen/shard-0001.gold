code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var en = 0;
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		} else {
			odds[on] = g.res[i];
			on++;
		}
	}
	for i in en { g.res[i] = evens[i]; }
	for i in on { g.res[en + i] = odds[i]; }
	out.i = en;
	g.steps += g.n;
	out
}
@end
