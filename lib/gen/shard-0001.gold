			first_err = g.res[k];
			gold_cache_put(g, 0, first_err);
			break;
		}
	}
	if first_err != -1 {
		gold_fail(g, "failure cached");
	}
	g.steps += g.n;
	out.i = first_err;
	out.s.clear();
	format(out.s, "first failing value ", first_err);
	out
}
