code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var copy int[512] = [0; 512];
	for i in g.n { copy[i] = g.res[i]; }
	for i in g.n {
		for j in i + 1..g.n {
			if copy[i] > copy[j] {
				let t = copy[i];
				copy[i] = copy[j];
				copy[j] = t;
			}
		}
	}
	format(out.s, "sorted: [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		format(out.s, copy[i]);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
