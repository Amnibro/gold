@entry 30d7a0ec794087a2
kind: step
verb: reverse
noun: tail
modifier: until
context: loop
phrase: reverse tail until reaching index {idx}
phrase: invert tail items backward until offset {idx}
slot: idx int
test: list=1,2,3,4,5 idx=2
expect: => i=3 r=0.0 ok=true s="reversed tail from index 2" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30 idx=1
expect: => i=2 r=0.0 ok=true s="reversed tail from index 1" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${idx};
	if start < g.n && start >= 0 {
		let len = g.n - start;
		for i in len / 2 {
			let j = len - 1 - i;
			let tmp = g.res[start + i];
			g.res[start + i] = g.res[start + j];
			g.res[start + j] = tmp;
		}
		g.steps += len;
		out.i = len;
	}
	out.s.clear();
	format(out.s, "reversed tail from index ", start);
	out
}
@end
