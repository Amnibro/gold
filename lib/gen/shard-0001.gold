fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var max_streak = 1;
	var cur_streak = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d == prev {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
			prev = d;
		}
		x /= 10;
	}
	max_streak
}
