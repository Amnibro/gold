kind: step
verb: sort
noun: loop
modifier: with_retry
context: retry
phrase: sort loop with retry limit {max_retries}
phrase: attempt sorting loop with retry limit {max_retries}
phrase: run sort loop with retry budget {max_retries}
slot: max_retries int
test: list=5,3,1,4 max_retries=5
expect: => i=3 r=0.0 ok=true s="sorted in 3 retry passes" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
test: list=5,4,3,2,1 max_retries=1
expect: => i=1 r=0.0 ok=false s="error: exceeded retries" errors=1 n=5 res=[4,3,2,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	if mr <= 0 {
		gold_fail(g, "invalid retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive retries");
		return out;
	}
	var attempts = 0;
	var sorted = false;
	while attempts < mr && !sorted {
		sorted = true;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				sorted = false;
			}
		}
		attempts++;
	}
	g.steps += attempts;
	out.i = attempts;
	if !sorted {
		gold_fail(g, "sort incomplete after retries");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: exceeded retries");
		return out;
	}
	out.s.clear();
	format(out.s, "sorted in ", attempts, " retry passes");
	out
}
@end
@entry e93b8afb5010772c
kind: step
verb: scan
noun: primes
modifier: up_to
context: retry
phrase: scan primes up to limit {limit}
phrase: collect prime numbers up to {limit}
phrase: search prime values up to {limit}
slot: limit int
test: limit=10
expect: => i=4 r=0.0 ok=true s="scanned 4 primes up to limit" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: limit=1
expect: => i=0 r=0.0 ok=false s="error: limit under two" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 2 {
		gold_fail(g, "limit under two for primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: limit under two");
		return out;
	}
	var count = 0;
	var num = 2;
	while num <= lim {
		var is_p = true;
		var d = 2;
		while d * d <= num {
			if num % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, num);
			count++;
		}
		num++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned ", count, " primes up to limit");
	out
}
@end
