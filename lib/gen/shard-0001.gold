@entry 840fe39f93990b7f
kind: step
verb: rotate
noun: numbers
modifier: recursively
context: list
phrase: rotate numbers recursively {times} shifts
phrase: cycle numbers recursively {times} iterations
phrase: shift numbers recursively by {times}
slot: times int
test: list=1,2,3,4 times=2
expect: => i=2 r=0.0 ok=true s="rotated numbers recursively 2 times" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=10,20,30 times=1
expect: => i=1 r=0.0 ok=true s="rotated numbers recursively 1 times" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n <= 1 || t <= 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("no recursive rotation needed");
		return out;
	}
	for step in t {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += t * g.n;
	out.i = t;
	out.s.clear();
	format(out.s, "rotated numbers recursively ", t, " times");
	out
}
@end
