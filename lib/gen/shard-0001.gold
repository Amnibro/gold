@entry 4c87ea9d34760c66
kind: step
verb: filter
noun: loop
modifier: any
context: text
phrase: filter loop any repetition length {rep_len}
phrase: detect any loop of length {rep_len}
phrase: check repeating sequence of size {rep_len}
slot: rep_len int
test: text="abcabcabc" rep_len=3
expect: => i=1 r=0.0 ok=true s="detected repeating loop length=3" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcdef" rep_len=2
expect: => i=0 r=0.0 ok=false s="no repeating loop found" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rep_len};
	var is_loop = false;
	if r > 0 && out.s.len >= 2 * r && out.s.len % r == 0 {
		is_loop = true;
		for i in out.s.len {
			if out.s[i] != out.s[i % r] {
				is_loop = false;
				break;
			}
		}
	}
	g.steps += out.s.len + 1;
	out.ok = is_loop;
	out.i = if is_loop { 1 } else { 0 };
	out.s.clear();
	if is_loop {
		format(out.s, "detected repeating loop length=", r);
	} else {
		out.s.append("no repeating loop found");
	}
	out
}
@end
