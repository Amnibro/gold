expect: => i=4 r=0.0 ok=false s="duplicates detected in list" errors=1 n=4 res=[1,2,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_uniq = true;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq { break; }
	}
	g.steps += g.n;
	out.ok = is_uniq;
	if !is_uniq {
		gold_fail(g, "duplicate elements found");
	}
	out.i = g.n;
	out.s.clear();
	if is_uniq {
		format(out.s, "all ", g.n, " elements are unique");
	} else {
		format(out.s, "duplicates detected in list");
	}
	out
}
@end
