kind: step
verb: measure
noun: words
modifier: any
context: filter
phrase: measure words any filter length exceeding {min_len}
phrase: count words any text length over {min_len}
slot: min_len int
test: text="apple pie banana" min_len=4
expect: => i=2 r=0.0 ok=true s="measured words any count 2" errors=0 n=0 res=[] cache=0 hits=0
test: text="to be or not" min_len=4
expect: => i=0 r=0.0 ok=true s="measured words any count 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var words_matched = 0;
	var in_word = false;
	var cur_len = 0;
	for k in out.s.len {
		let b = out.s[k];
		if b != 32 {
			cur_len++;
			in_word = true;
		} else {
			if in_word && cur_len > ml { words_matched++; }
			in_word = false;
			cur_len = 0;
		}
	}
	if in_word && cur_len > ml { words_matched++; }
	g.steps += out.s.len;
	out.i = words_matched;
	out.s.clear();
	format(out.s, "measured words any count ", words_matched);
	out
}
@end
@entry 536a17e210af948c
kind: step
verb: scale
noun: evens
modifier: between
context: filter
phrase: scale evens between range {low} to {high} by {factor}
phrase: multiply even values between limits {low} through {high} with {factor}
slot: low int
slot: high int
slot: factor int
test: list=2,5,8,12 low=4 high=10 factor=2
expect: => i=1 r=0.0 ok=true s="scaled evens between 1" errors=0 n=4 res=[2,5,16,12] cache=0 hits=0
test: list=1,3,5 low=4 high=10 factor=2
expect: => i=0 r=0.0 ok=true s="scaled evens between 0" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let f = ${factor};
	var scaled = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 && g.res[k] >= lo && g.res[k] <= hi {
			g.res[k] *= f;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled evens between ", scaled);
	out
}
@end
@entry 2ec271089e1b8b4f
kind: step
verb: reverse
noun: text
modifier: with_cache
context: filter
phrase: reverse text filter with cache key {cache_key}
phrase: invert text characters storing with cache key {cache_key}
slot: cache_key int
test: text="filter" cache_key=10
expect: => i=6 r=0.0 ok=true s="retlif" errors=0 n=0 res=[] cache=1 hits=0
test: text="data" cache_key=20
expect: => i=4 r=0.0 ok=true s="atad" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cache_key};
	gold_cache_put(g, k, out.s.len);
	var i = 0;
	var j = out.s.len - 1;
	while i < j {
		let tmp = out.s[i];
		out.s[i] = out.s[j];
		out.s[j] = tmp;
		i++;
		j--;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry a04702860235e348
kind: step
verb: check
noun: steps
modifier: unique
context: filter
phrase: check steps unique occurrences exceeding {threshold}
phrase: verify unique steps count above threshold {threshold}
slot: threshold int
test: list=1,2,2,3,3,4 threshold=3
expect: => i=4 r=0.0 ok=true s="checked unique steps count 4" errors=0 n=6 res=[1,2,2,3,3,4] cache=0 hits=0
test: list=1,1,1 threshold=2
expect: => i=1 r=0.0 ok=false s="checked unique steps count 1" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var uniq = 0;
	for i in g.n {
		var is_first = true;
		for j in i {
			if g.res[j] == g.res[i] { is_first = false; break; }
		}
		if is_first { uniq++; }
	}
	g.steps += g.n;
	out.i = uniq;
	out.ok = uniq >= th;
	out.s.clear();
	format(out.s, "checked unique steps count ", uniq);
	out
}
@end
