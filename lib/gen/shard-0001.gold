kind: step
verb: validate
noun: numbers
modifier: every_other
context: core
phrase: validate numbers every other item with {chk}
phrase: check numbers at every other index using {chk}
phrase: verify every other number satisfies {chk}
slot: chk pred
test: list=2,1,4,3,6 chk=is_even
expect: => i=3 r=0.0 ok=true s="validated 3 alternate numbers" errors=0 n=5 res=[2,1,4,3,6] cache=0 hits=0
test: list=2,1,5,3 chk=is_even
expect: => i=2 r=0.0 ok=false s="failed validation at alternate index" errors=1 n=4 res=[2,1,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no numbers to validate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var valid = true;
	var checked = 0;
	var k = 0;
	while k < g.n {
		checked++;
		if !${chk}(g.res[k]) {
			valid = false;
			break;
		}
		k += 2;
	}
	g.steps += checked;
	out.ok = valid;
	out.i = checked;
	out.s.clear();
	if valid {
		format(out.s, "validated ", checked, " alternate numbers");
	} else {
		gold_fail(g, "validation failed");
		format(out.s, "failed validation at alternate index");
	}
	out
}
@end
