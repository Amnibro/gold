fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	let avg = total / g.n;
	let scaled = avg * mult;
	gold_push(g, scaled);
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled nested average to ", scaled);
	out
}
