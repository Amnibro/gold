code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${streak_len};
	var cur_streak = 1;
	var max_streak = if g.n > 0 { 1 } else { 0 };
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	let ok_streak = max_streak >= target;
	out.ok = ok_streak;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "streak check found max streak ", max_streak);
	out
}
@end
