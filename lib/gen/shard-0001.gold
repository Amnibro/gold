expect: => i=18 r=0.0 ok=true s="scaled 2 pairwise minimums sum to 18" errors=0 n=2 res=[12,6] cache=0 hits=0
test: list=7,14,3,9 factor=2
expect: => i=20 r=0.0 ok=true s="scaled 2 pairwise minimums sum to 20" errors=0 n=2 res=[14,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise minimum");
		out.ok = false;
		return out;
	}
	var pairs = g.n / 2;
	var total = 0;
	let mul = ${factor};
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let m = if a < b { a } else { b };
		let scaled = m * mul;
		g.res[k] = scaled;
		total += scaled;
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled ", pairs, " pairwise minimums sum to ", total);
	out
}
@end
