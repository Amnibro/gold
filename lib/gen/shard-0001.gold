expect: => i=0 r=0.0 ok=false s="no odds found with retry" errors=1 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	var odd_count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odd_count++;
		}
	}
	if odd_count == 0 {
		if retries > 0 {
			gold_fail(g, "retried finding odds without success");
		}
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("no odds found with retry");
	} else {
		g.steps += g.n + odd_count;
		out.i = odd_count;
		out.s.clear();
		format(out.s, "ran ", odd_count, " odds with retry");
	}
	out
}
@end
