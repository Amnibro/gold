kind: step
verb: find
noun: number
modifier: while
context: sort
phrase: find number in sorted list while {cond} holds
phrase: search sorted numbers while condition {cond} remains true
phrase: locate number in sorted order while {cond} passes
slot: cond pred
test: list=2,4,6,7,8 cond=is_even
expect: => i=7 r=0.0 ok=true s="stopped at sorted number 7" errors=0 n=5 res=[2,4,6,7,8] cache=0 hits=0
test: list=1,3,5 cond=is_even
expect: => i=1 r=0.0 ok=true s="stopped at sorted number 1" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for number find");
		out.ok = false;
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var stop_val = 0;
	var found = false;
	for k in g.n {
		let x = g.res[k];
		if !${cond}(x) {
			stop_val = x;
			found = true;
			break;
		}
	}
	g.steps += g.n;
	if !found {
		out.i = g.n;
		out.s.clear();
		format(out.s, "condition held for all sorted numbers");
		return out;
	}
	out.i = stop_val;
	out.s.clear();
	format(out.s, "stopped at sorted number ", stop_val);
	out
}
@end
