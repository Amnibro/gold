slot: group_size int
test: list=1,2,3,4,5 group_size=2
expect: => i=15 r=0.0 ok=true s="grouped history sum=15" errors=0 n=3 res=[3,7,5] cache=0 hits=0
test: list=10,20,30 group_size=3
expect: => i=60 r=0.0 ok=true s="grouped history sum=60" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${group_size};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var w = 0;
	var idx = 0;
	var total_sum = 0;
	while idx < g.n {
		var grp_sum = 0;
		var count = 0;
		while idx < g.n && count < sz {
			grp_sum += g.res[idx];
			count++;
			idx++;
		}
		g.res[w] = grp_sum;
		total_sum += grp_sum;
		w++;
	}
	g.n = w;
	out.i = total_sum;
	out.s.clear();
	format(out.s, "grouped history sum=", total_sum);
	out
}
@end
