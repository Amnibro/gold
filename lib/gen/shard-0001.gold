expect: => i=2 r=0.0 ok=true s="merged 2 primes in reverse" errors=0 n=6 res=[10,11,12,13,13,11] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[256] = [0; 256];
	var pn = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) && pn < 256 {
			primes[pn] = g.res[k];
			pn++;
		}
	}
	var rev_idx = pn - 1;
	while rev_idx >= 0 {
		gold_push(g, primes[rev_idx]);
		rev_idx--;
	}
	g.steps += g.n + pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "merged ", pn, " primes in reverse");
	out
}
@end
