code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${max_len};
	let original = g.n;
	gold_cache_put(g, 1, original);
	if k < g.n && k >= 0 {
		let shift = g.n - k;
		for i in k {
			g.res[i] = g.res[shift + i];
		}
		g.n = k;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited suffix to ", g.n);
	out
}
@end
@entry 669721a0ff8c4b44
kind: step
verb: keep
noun: primes
modifier: last
context: transform
phrase: keep last {count} prime numbers
phrase: preserve trailing prime elements up to {count}
phrase: filter primes retaining final {count} items
slot: count int
test: list=2,3,4,5,6,7 count=2
expect: => i=2 r=0.0 ok=true s="kept 2 trailing primes" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=10,11,12,13,14,17,19 count=3
expect: => i=3 r=0.0 ok=true s="kept 3 trailing primes" errors=0 n=3 res=[13,17,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var temp int[512] = [0; 512];
	var num_primes = 0;
	for k in g.n {
		let val = g.res[k];
		var is_p = true;
		if val < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= val {
				if val % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			temp[num_primes] = val;
			num_primes++;
		}
	}
	var keep_count = c;
	if keep_count > num_primes { keep_count = num_primes; }
	if keep_count < 0 { keep_count = 0; }
	let offset = num_primes - keep_count;
	for k in keep_count {
		g.res[k] = temp[offset + k];
	}
	g.n = keep_count;
	g.steps += g.n;
	out.i = keep_count;
	out.s.clear();
	format(out.s, "kept ", keep_count, " trailing primes");
	out
}
@end
