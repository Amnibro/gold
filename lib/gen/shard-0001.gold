kind: step
verb: cache
noun: duplicates
modifier: while
context: aggregate
phrase: cache duplicate numbers while {cond} holds
phrase: record duplicates in cache while satisfying {cond}
phrase: store duplicate values while {cond}
slot: cond pred
test: list=2,2,4,4,5 cond=is_even
expect: => i=2 r=0.0 ok=true s="cached 2 duplicates while condition held" errors=0 n=5 res=[2,2,4,4,5] cache=2 hits=0
test: list=3,3,1,1,2 cond=is_odd
expect: => i=2 r=0.0 ok=true s="cached 2 duplicates while condition held" errors=0 n=5 res=[3,3,1,1,2] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to check duplicates");
		out.ok = false;
		return out;
	}
	var dup_count = 0;
	for i in g.n {
		let x = g.res[i];
		if !${cond}(x) { break; }
		for j in i + 1..g.n {
			if g.res[j] == x {
				gold_cache_put(g, x, 1);
				dup_count++;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "cached ", dup_count, " duplicates while condition held");
	out
}
@end
