fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_group};
	var buckets int[512] = [0; 512];
	var bn = 0;
	var cur_sum = 0;
	for i in g.n {
		if cur_sum + g.res[i] > cap && cur_sum > 0 {
			buckets[bn] = cur_sum;
			bn++;
			cur_sum = g.res[i];
		} else {
			cur_sum += g.res[i];
		}
	}
	if cur_sum > 0 {
		buckets[bn] = cur_sum;
		bn++;
	}
	gold_clear(g);
	for k in bn { gold_push(g, buckets[k]); }
	out.i = bn;
	g.steps += g.n + 1;
	out
}
@end
