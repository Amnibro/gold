code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_fail(g, "list too short for alternate average");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: list too short for alternate average");
		return out;
	}
	var sum = 0;
	var count = 0;
	for k in g.n {
		if k % 2 == 0 {
			sum += g.res[k];
			count++;
		}
	}
	let avg = sum / count;
	g.steps += g.n;
	out.i = avg;
	out.ok = true;
	out.s.clear();
	format(out.s, "returned every other average ", avg);
	out
}
@end
