fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var u int[512] = [0; 512];
	var un = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in un { if u[j] == x { seen = true; break; } }
		if !seen {
			u[un] = x;
			un++;
		}
	}
	var new_n = 0;
	for rep in c {
		for k in un {
			if new_n < 512 {
				g.res[new_n] = u[k];
				new_n++;
			}
		}
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "repeated ", un, " unique checkpoints");
	out
}
@end
