fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	let tgt = ${target};
	var start = g.n - slen;
	if start < 0 { start = 0; }
	var w = start;
	var matched = 0;
	var idx = start;
	while idx < g.n {
		if g.res[idx] == tgt {
			matched++;
		} else {
			g.res[w] = g.res[idx];
			w++;
		}
		idx++;
	}
	if matched > 0 {
		g.res[w] = tgt * matched;
		w++;
	}
	g.n = w;
	out.i = matched;
	out.s.clear();
	format(out.s, "merged suffix target matches=", matched);
	out
}
@end
