code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for k in g.n { g.res[k] *= f; }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted streaks scaled times factor count=", g.n);
	out
}
@end
