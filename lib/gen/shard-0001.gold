fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = -1;
	if g.n > 2 {
		for i in 1..(g.n - 1) {
			if g.res[i] == t {
				found = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "search middle result index: ", found);
	out
}
@end
