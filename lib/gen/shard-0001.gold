@entry ea6087d225fa875e
kind: step
verb: split
noun: primes
modifier: with_cache
context: search
phrase: split primes with cache partition
phrase: partition primes with cache logging
test: list=4,5,6,7,8
expect: => i=2 r=0.0 ok=true s="primes partitioned: 2" errors=0 n=5 res=[5,7,4,6,8] cache=1 hits=0
test: list=2,3,5,7
expect: => i=4 r=0.0 ok=true s="primes partitioned: 4" errors=0 n=4 res=[2,3,5,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var kept = 0;
	var non_primes = [0; 64];
	var np_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[kept] = x;
			kept++;
			primes++;
		} else if np_count < 64 {
			non_primes[np_count] = x;
			np_count++;
		}
	}
	var j = 0;
	while j < np_count && kept < 512 {
		g.res[kept] = non_primes[j];
		kept++;
		j++;
	}
	gold_cache_put(g, 777, primes);
	g.steps += g.n;
	g.n = kept;
	out.i = primes;
	out.s.clear();
	format(out.s, "primes partitioned: ", primes);
	out
}
@end
