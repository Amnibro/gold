expect: => i=2 r=0.0 ok=true s="limited sequence between bounds: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=1,5 low=10 high=2
expect: => i=0 r=0.0 ok=false s="error: invalid bounds ordering" errors=1 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo > hi {
		gold_fail(g, "invalid bounds ordering");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bounds ordering");
		return out;
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited sequence between bounds: ", kept);
	out
}
@end
