code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var max_freq = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq > max_freq { max_freq = freq; }
	}
	g.steps += g.n;
	out.i = max_freq;
	out.ok = (max_freq >= fl);
	out.s.clear();
	if out.ok {
		format(out.s, "max frequency ", max_freq, " meets floor");
	} else {
		gold_fail(g, "frequency below floor");
		format(out.s, "max frequency ", max_freq, " below floor");
	}
	out
}
@end
