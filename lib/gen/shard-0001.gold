test: list=5,5,9,9,7
expect: => i=2 r=0.0 ok=true s="filtered 2 pairwise duplicates" errors=0 n=3 res=[5,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to deduplicate");
		out.ok = false;
		return out;
	}
	var kept = 1;
	for k in 1..g.n {
		if g.res[k] != g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	let dupes = g.n - kept;
	g.steps += g.n;
	g.n = kept;
	out.i = dupes;
	out.s.clear();
	format(out.s, "filtered ", dupes, " pairwise duplicates");
	out
}
@end
@entry 63dd17837e00fba6
kind: step
verb: validate
noun: sequence
modifier: with_cache
context: filter
phrase: validate sequence with cache records
phrase: check sequence elements with cache
phrase: verify sequence with cache entries
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="validated sequence with cache: 0 hits" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=15,25
expect: => i=0 r=0.0 ok=true s="validated sequence with cache: 0 hits" errors=0 n=2 res=[15,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence to validate");
		out.ok = false;
		return out;
	}
	var matched = 0;
	for k in g.n {
		let cached, ok = gold_cache_get(g, k);
		if ok && cached == g.res[k] {
			matched++;
		} else {
			gold_cache_put(g, k, g.res[k]);
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "validated sequence with cache: ", matched, " hits");
	out
}
@end
