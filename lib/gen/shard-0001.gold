test: list=10,20,30 times=1
expect: => i=1 r=0.0 ok=true s="merged average across 1 passes" errors=0 n=2 res=[15,25] cache=0 hits=0
test: list=8,12,16 times=2
expect: => i=2 r=0.0 ok=true s="merged average across 2 passes" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var passes = 0;
	while passes < t && g.n > 1 {
		let new_n = g.n - 1;
		for k in new_n {
			g.res[k] = (g.res[k] + g.res[k + 1]) / 2;
		}
		g.n = new_n;
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "merged average across ", passes, " passes");
	out
}
@end
