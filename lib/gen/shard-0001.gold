slot: stride int
test: list=1,2,3,4,5,6 stride=2
expect: => i=9 r=0.0 ok=true s="stride sum: 9" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,20,30 stride=3
expect: => i=10 r=0.0 ok=true s="stride sum: 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if st <= 0 { return out; }
	var stride_sum = 0;
	var i = 0;
	while i < g.n {
		stride_sum += g.res[i];
		i += st;
	}
	g.steps += g.n;
	out.i = stride_sum;
	out.s.clear();
	format(out.s, "stride sum: ", stride_sum);
	out
}
@end
