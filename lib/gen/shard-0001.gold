code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid streak limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid streak limit");
		return out;
	}
	if g.n < lim {
		gold_fail(g, "streak exceeds result count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: streak exceeds result count");
		return out;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[lim - 1];
	g.res[lim - 1] = tmp;
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "swapped streak of length ", lim);
	out
}
@end
