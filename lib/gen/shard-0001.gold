@entry d0635182b3cf37a0
kind: step
verb: drop
noun: value
modifier: while
context: loop
phrase: drop loop values while condition {cond} holds
phrase: remove leading elements while matching {cond}
slot: cond pred
test: list=2,4,5,6 cond=is_even
expect: => i=2 r=0.0 ok=true s="dropped 2 values while condition holds" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=1,2,4 cond=is_even
expect: => i=0 r=0.0 ok=true s="dropped 0 values while condition holds" errors=0 n=3 res=[1,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var drop_count = 0;
	while drop_count < g.n && ${cond}(g.res[drop_count]) {
		drop_count++;
	}
	let remaining = g.n - drop_count;
	for i in remaining {
		g.res[i] = g.res[i + drop_count];
	}
	g.n = remaining;
	g.steps += g.n + drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " values while condition holds");
	out
}
@end
