code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	if x > 9 {
		var p = 1;
		while p * 10 <= x { p *= 10; }
		let lead = x / p;
		let rem = x % p;
		out.i = rem * 10 + lead;
	}
	g.steps += 1;
	out
}
@end
