@entry 60a55f1b79aa34ca
kind: step
verb: drop
noun: total
modifier: running
context: sort
phrase: drop total running sum budget
phrase: trim elements until sum at most {cap}
slot: cap int
test: list=2,4,6,8 cap=12
expect: => i=1 r=0.0 ok=true s="elements dropped to meet cap: 1" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,2,3 cap=20
expect: => i=0 r=0.0 ok=true s="elements dropped to meet cap: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	var dropped = 0;
	while g.n > 0 && total > c {
		total -= g.res[g.n - 1];
		g.n--;
		dropped++;
	}
	g.steps += (dropped + 1);
	out.i = dropped;
	out.s.clear();
	format(out.s, "elements dropped to meet cap: ", dropped);
	out
}
@end
@entry 8e32b15bf36a0c4e
kind: step
verb: group
noun: series
modifier: times
context: sort
phrase: group series times stride sum
