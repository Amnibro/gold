code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var unique_errs = 0;
	if g.errors > 0 && g.errors <= ceil {
		unique_errs = g.errors;
		gold_push(g, g.errors);
	} else if g.errors > ceil {
		gold_push(g, ceil);
		unique_errs = ceil;
	} else {
		gold_push(g, 0);
	}
	g.steps += 1;
	out.i = unique_errs;
	out.s.clear();
	format(out.s, "merged ", unique_errs, " unique error items");
	out
}
@end
@entry ae4918493baa41c5
kind: step
verb: swap
noun: streak
modifier: between
context: transform
phrase: swap streak elements between bounds {cutoff}
phrase: invert streak order between limits {cutoff}
slot: cutoff int
test: list=1,10,20,30,2 cutoff=5
expect: => i=1 r=0.0 ok=true s="swapped streak across 1 steps" errors=0 n=5 res=[1,30,20,10,2] cache=0 hits=0
test: list=1,2,3 cutoff=10
expect: => i=0 r=0.0 ok=true s="swapped streak across 0 steps" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var start = -1;
	var end = -1;
	for k in g.n {
		if g.res[k] > cut {
			if start == -1 { start = k; }
			end = k;
		}
	}
	var swaps = 0;
	if start != -1 && end > start {
		var i = start;
		var j = end;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
			swaps++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped streak across ", swaps, " steps");
	out
}
@end
