fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.errors;
	out.s.clear();
	format(out.s, "sorted results with errors: ", g.errors);
	out
}
@end
@entry 0095cec505fd40a6
kind: step
verb: repeat
noun: digits
modifier: none
context: compare
phrase: repeat digits duplication across number
phrase: duplicate each decimal digit of input
test: input=12
expect: => i=1122 r=0.0 ok=true s="repeated digits: 1122" errors=0 n=0 res=[] cache=0 hits=0
test: input=45
expect: => i=4455 r=0.0 ok=true s="repeated digits: 4455" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	var rev = 0;
	while x > 0 {
		let d = x % 10;
		rev = rev * 10 + d;
		x /= 10;
	}
	var res = 0;
	while rev > 0 {
		let d = rev % 10;
		res = res * 100 + d * 10 + d;
		rev /= 10;
	}
	g.steps += 1;
	out.i = res;
	out.s.clear();
	format(out.s, "repeated digits: ", res);
	out
}
@end
