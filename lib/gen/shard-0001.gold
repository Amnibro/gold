noun: memo
modifier: pairwise
context: aggregate
phrase: select memo pairwise differences into aggregate
phrase: aggregate pairwise memo elements into results
phrase: filter pairwise memo values into aggregate sum
test: list=10,4,20,5
expect: => i=21 r=0.0 ok=true s="selected 2 pairwise memo differences with sum 21" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=8,2,6,1
expect: => i=11 r=0.0 ok=true s="selected 2 pairwise memo differences with sum 11" errors=0 n=2 res=[6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for pairwise memo");
		out.ok = false;
		return out;
	}
	var pairs = g.n / 2;
	var total = 0;
	for k in pairs {
		let diff = g.res[k * 2] - g.res[k * 2 + 1];
		g.res[k] = diff;
		total += diff;
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = total;
	out.s.clear();
	format(out.s, "selected ", pairs, " pairwise memo differences with sum ", total);
	out
}
@end
