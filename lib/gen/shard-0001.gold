code:
fn ${ID}_scan(g Gold&, idx int, acc int) int {
	if idx >= g.n { return acc; }
	let next_acc = acc + g.res[idx];
	g.res[idx] = next_acc;
	${ID}_scan(g, idx + 1, next_acc)
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let total = ${ID}_scan(g, 0, 0);
	out.i = total;
	g.steps += g.n + 1;
	out
}
@end
