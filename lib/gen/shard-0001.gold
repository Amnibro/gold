expect: => i=3 r=0.0 ok=true s="dropped 3 items in loop while condition held" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements to drop");
		out.ok = false;
		return out;
	}
	var dropped = 0;
	while dropped < g.n && ${cond}(g.res[dropped]) {
		dropped++;
	}
	let remaining = g.n - dropped;
	for k in remaining {
		g.res[k] = g.res[dropped + k];
	}
	g.steps += dropped;
	g.n = remaining;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items in loop while condition held");
	out
}
@end
