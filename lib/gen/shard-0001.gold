kind: step
verb: swap
noun: values
modifier: times
context: list
phrase: swap adjacent values {times} times
phrase: exchange list values {times} times
phrase: perform value swaps {times} times
slot: times int
test: list=1,2,3,4 times=2
expect: => i=2 r=0.0 ok=true s="swapped values 2 times" errors=0 n=4 res=[2,3,1,4] cache=0 hits=0
test: list=10,20,30 times=1
expect: => i=1 r=0.0 ok=true s="swapped values 1 times" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n < 2 || t <= 0 {
		gold_fail(g, "insufficient items or non-positive times");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid swap request");
		return out;
	}
	let span = g.n - 1;
	for k in t {
		let idx = k % span;
		let tmp = g.res[idx];
		g.res[idx] = g.res[idx + 1];
		g.res[idx + 1] = tmp;
	}
	g.steps += t;
	out.i = t;
	out.s.clear();
	format(out.s, "swapped values ", t, " times");
	out
}
@end
