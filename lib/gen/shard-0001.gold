kind: step
verb: search
noun: total
modifier: sorted
context: error
phrase: search total {target} in sorted results
phrase: find total {target} assuming sorted order
phrase: locate total {target} while sorted
slot: target int
test: list=1,3,6,10 target=10
expect: => i=3 r=0.0 ok=true s="found total at 3 items" errors=0 n=4 res=[1,3,6,10] cache=0 hits=0
test: list=10,5,2 target=15
expect: => i=0 r=0.0 ok=false s="error: sequence not sorted" errors=1 n=3 res=[10,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results for search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			gold_fail(g, "results not sorted");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: sequence not sorted");
			return out;
		}
	}
	var sum = 0;
	var count = 0;
	var found = false;
	for k in g.n {
		sum += g.res[k];
		count++;
		if sum == tgt {
			found = true;
			break;
		}
	}
	g.steps += count;
	out.i = count;
	if !found {
		gold_fail(g, "target total not reached");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target total not reached");
		return out;
	}
	out.s.clear();
	format(out.s, "found total at ", count, " items");
	out
}
@end
