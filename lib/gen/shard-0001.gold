code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	if g.n == 0 {
		gold_fail(g, "no elements to map limit");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for k in g.n {
		let x = g.res[k];
		if ${cond}(x) && x > cap {
			g.res[k] = cap;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "mapped limit clamping ", clamped, " items");
	out
}
@end
@entry 3c39687ac1819523
kind: step
verb: find
noun: minimum
modifier: nested
context: aggregate
phrase: find nested minimum for blocks of {block_size}
phrase: aggregate nested minimum across chunks of {block_size}
phrase: locate nested block minimums with size {block_size}
slot: block_size int
test: list=5,2,9,4,1,8 block_size=3
expect: => i=2 r=0.0 ok=true s="found nested minimums across 2 blocks" errors=0 n=2 res=[2,1] cache=0 hits=0
test: list=8,3,7,6 block_size=2
expect: => i=2 r=0.0 ok=true s="found nested minimums across 2 blocks" errors=0 n=2 res=[3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${block_size};
	if g.n == 0 || bsize <= 0 {
		gold_fail(g, "invalid block size for nested minimum");
		out.ok = false;
		return out;
	}
	var blocks = 0;
	var i = 0;
	var tmp int[512] = [0; 512];
	while i < g.n {
		var cur_min = g.res[i];
		var j = 1;
		while j < bsize && i + j < g.n {
			let val = g.res[i + j];
			if val < cur_min { cur_min = val; }
			j++;
		}
		tmp[blocks] = cur_min;
		blocks++;
		i += bsize;
	}
	for k in blocks {
		g.res[k] = tmp[k];
	}
	g.steps += g.n;
	g.n = blocks;
	out.i = blocks;
	out.s.clear();
	format(out.s, "found nested minimums across ", blocks, " blocks");
	out
}
@end
