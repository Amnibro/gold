fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var sum_gaps = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		let abs_d = if diff < 0 { -diff } else { diff };
		sum_gaps += abs_d;
	}
	g.steps += g.n;
	out.i = sum_gaps;
	out.s.clear();
	format(out.s, "total retry gaps: ", sum_gaps);
	out
}
