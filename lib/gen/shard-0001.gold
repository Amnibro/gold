@entry 601fae1a6a43228f
kind: step
verb: sum
noun: head
modifier: with_retry
context: cache
phrase: sum head elements with retry attempts {count}
phrase: accumulate leading entries up to {count} with retry
slot: count int
test: list=10,20,30 count=2
expect: => i=30 r=0.0 ok=true s="head sum with retry: 30" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=-5,-10,20 count=2
expect: => i=15 r=0.0 ok=true s="head sum with retry: 15" errors=0 n=3 res=[-5,-10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var limit = k;
	if limit > g.n { limit = g.n; }
	var total = 0;
	var i = 0;
	while i < limit {
		total += g.res[i];
		i++;
	}
	var retried = false;
	if total <= 0 {
		retried = true;
		total = 0;
		var j = 0;
		while j < limit {
			let val = g.res[j];
			total += if val < 0 { -val } else { val };
			j++;
		}
	}
	gold_cache_put(g, 0, total);
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "head sum with retry: ", total);
	out
}
@end
