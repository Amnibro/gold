phrase: tally nested sublists of width {win}
slot: win int
test: list=1,2,3,4,5 win=2
expect: => i=0 r=0.0 ok=true s="found 0 even windows" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30 win=3
expect: => i=1 r=0.0 ok=true s="found 1 even windows" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var count = 0;
	var i = 0;
	while i + w <= g.n {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		if sum % 2 == 0 { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " even windows");
	out
}
@end
