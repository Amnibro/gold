			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	var idx = 1;
	while idx < g.n {
		g.res[idx] = fv;
		count++;
		idx += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "filled ", count, " alternate slots");
	out
}
@end
