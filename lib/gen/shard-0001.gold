code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for middle search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var lo = 0;
	var hi = g.n - 1;
	var attempts = 0;
	var found = false;
	var res_val = 0;
	while lo <= hi {
		attempts++;
		let mid = (lo + hi) / 2;
		let val = g.res[mid];
		if ${stop}(val) {
			found = true;
			res_val = val;
			break;
		}
		lo++;
		hi--;
	}
	g.steps += attempts;
	out.i = attempts;
	if !found {
		gold_fail(g, "middle retry condition not met");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: condition not met after ", attempts, " retries");
		return out;
	}
	out.s.clear();
	format(out.s, "found value ", res_val, " in ", attempts, " retries");
	out
}
@end
