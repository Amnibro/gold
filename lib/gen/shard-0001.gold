@entry afde1f3788ebd2c4
kind: step
verb: validate
noun: suffix
modifier: at_least
context: list
phrase: validate suffix of {count} has at least {min_val}
phrase: check suffix {count} values are at least {min_val}
phrase: verify last {count} items are at least {min_val}
slot: count int
slot: min_val int
test: list=5,15,20,25 count=3 min_val=10
expect: => i=3 r=0.0 ok=true s="suffix passed minimum check" errors=0 n=4 res=[5,15,20,25] cache=0 hits=0
test: list=5,15,8,25 count=3 min_val=10
expect: => i=3 r=0.0 ok=false s="suffix check failed" errors=1 n=4 res=[5,15,8,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let mv = ${min_val};
	if cnt <= 0 || cnt > g.n {
		gold_fail(g, "invalid suffix count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid suffix count");
		return out;
	}
	let start = g.n - cnt;
	var ok_all = true;
	for i in cnt {
		if g.res[start + i] < mv {
			ok_all = false;
			break;
		}
	}
	g.steps += cnt;
	out.ok = ok_all;
	out.i = cnt;
	out.s.clear();
	if ok_all {
		format(out.s, "suffix passed minimum check");
	} else {
		gold_fail(g, "suffix minimum check failed");
		format(out.s, "suffix check failed");
	}
	out
}
@end
