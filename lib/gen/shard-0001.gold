@entry 8eba04eabce85dbc
kind: step
verb: join
noun: streak
modifier: in_reverse
context: retry
phrase: join streak in reverse with min length {length}
phrase: combine reverse streak exceeding length {length}
phrase: merge streak in reverse threshold {length}
slot: length int
test: list=1,2,2,2,5 length=2
expect: => i=1 r=0.0 ok=true s="joined 1 streaks in reverse" errors=0 n=3 res=[1,6,5] cache=0 hits=0
test: list=1,2,3 length=2
expect: => i=0 r=0.0 ok=false s="error: no qualifying streaks" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${length};
	if min_l <= 1 {
		gold_fail(g, "invalid streak length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive length");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "list too short for streak join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var joined = 0;
	var i = g.n - 1;
	while i > 0 {
		var j = i;
		while j > 0 && g.res[j - 1] == g.res[i] {
			j--;
		}
		let len = i - j + 1;
		if len >= min_l {
			var sum = 0;
			var k = j;
			while k <= i {
				sum += g.res[k];
				k++;
			}
			g.res[j] = sum;
			var shift = len - 1;
			var m = j + 1;
			while m + shift < g.n {
				g.res[m] = g.res[m + shift];
				m++;
			}
			g.n -= shift;
			joined++;
			i = j - 1;
		} else {
			i = j - 1;
		}
	}
	g.steps += g.n + joined;
	out.i = joined;
	if joined == 0 {
		gold_fail(g, "no streak met length requirement");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no qualifying streaks");
		return out;
	}
	out.s.clear();
	format(out.s, "joined ", joined, " streaks in reverse");
	out
}
@end
