@entry f4f4a2ec2ac95f78
kind: step
verb: fill
noun: numbers
modifier: sorted
context: sort
phrase: fill numbers sorted binary insertion
phrase: insert value into sorted list
test: input=3 list=1,2,4,5
expect: => i=3 r=0.0 ok=true s="inserted at index: 2" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: input=10 list=1,5,8
expect: => i=10 r=0.0 ok=true s="inserted at index: 3" errors=0 n=4 res=[1,5,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 512 { return out; }
	let val = out.i;
	var idx = g.n;
	while idx > 0 && g.res[idx - 1] > val {
		g.res[idx] = g.res[idx - 1];
		idx--;
	}
	g.res[idx] = val;
	g.n++;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "inserted at index: ", idx);
	out
}
@end
