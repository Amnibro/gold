test: list=2,4,3,6,5,8
expect: => i=3 r=0.0 ok=true s="ranked 3 primes to end" errors=0 n=6 res=[4,6,8,2,3,5] cache=0 hits=0
test: list=7,10,11,12,13,14
expect: => i=3 r=0.0 ok=true s="ranked 3 primes to end" errors=0 n=6 res=[10,12,14,7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_p int[512] = [0; 512];
	var pr int[512] = [0; 512];
	var n_np = 0;
	var n_p = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			pr[n_p] = x;
			n_p++;
		} else {
			non_p[n_np] = x;
			n_np++;
		}
	}
	for k in n_np { g.res[k] = non_p[k]; }
	for k in n_p { g.res[n_np + k] = pr[k]; }
	g.steps += g.n;
	out.i = n_p;
	out.s.clear();
	format(out.s, "ranked ", n_p, " primes to end");
	out
}
@end
