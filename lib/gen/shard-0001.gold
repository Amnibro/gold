phrase: divide pairwise totals compared to {balance}
phrase: balance adjacent pairwise totals above {balance}
slot: balance int
test: list=20,40,10,50 balance=50
expect: => i=2 r=0.0 ok=true s="split total pairwise count=2" errors=0 n=4 res=[30,30,30,30] cache=0 hits=0
test: list=5,10,15,20 balance=30
expect: => i=1 r=0.0 ok=true s="split total pairwise count=1" errors=0 n=4 res=[5,10,17,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bal = ${balance};
	var splits = 0;
	var i = 0;
	while i < g.n - 1 {
		let pair_tot = g.res[i] + g.res[i + 1];
		if pair_tot > bal {
			g.res[i] = pair_tot / 2;
			g.res[i + 1] = pair_tot - g.res[i];
			splits++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = splits;
	out.s.clear();
	format(out.s, "split total pairwise count=", splits);
	out
}
@end
