code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results to drop from");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		let x = g.res[k];
		if x == tgt {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	gold_cache_put(g, tgt, dropped);
	out.i = dropped;
	if dropped == 0 {
		gold_fail(g, "number not found to drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: number not found");
		return out;
	}
	out.s.clear();
	format(out.s, "dropped ", dropped, " occurrences");
	out
}
@end
