		if b >= 'a' && b <= 'z' {
			let base = 'a' as int;
			let offset = (b as int - base + sh) % 26;
			out.s[i] = (base + offset) as byte;
			rotated++;
		} else if b >= 'A' && b <= 'Z' {
			let base = 'A' as int;
			let offset = (b as int - base + sh) % 26;
			out.s[i] = (base + offset) as byte;
			rotated++;
		}
		i += 2;
	}
	out.i = rotated;
	out
}
@end
