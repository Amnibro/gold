@entry ec587ba7f525f80b
kind: step
verb: return
noun: range
modifier: times
context: stats
phrase: return sample range multiplied {scale} times
phrase: scale statistical range {scale} times
slot: scale int
test: list=10,4,22,8 scale=2
expect: => i=36 r=0.0 ok=true s="" errors=0 n=5 res=[10,4,22,8,36] cache=0 hits=0
test: list=5,15,3,9 scale=3
expect: => i=36 r=0.0 ok=true s="" errors=0 n=5 res=[5,15,3,9,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 {
		gold_fail(g, "empty range");
		out.ok = false;
		return out;
	}
	var lo = g.res[0];
	var hi = g.res[0];
	for i in 1..g.n {
		if g.res[i] < lo { lo = g.res[i]; }
		if g.res[i] > hi { hi = g.res[i]; }
	}
	let spread = (hi - lo) * sc;
	gold_push(g, spread);
	out.i = spread;
	g.steps += g.n + 1;
	out
}
@end
