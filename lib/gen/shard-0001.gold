slot: k int
test: list=1,9,4,2,7 k=3
expect: => i=3 r=0.0 ok=true s="sorted last 3 values" errors=0 n=5 res=[1,9,2,4,7] cache=0 hits=0
test: list=10,25,18,5,2 k=4
expect: => i=4 r=0.0 ok=true s="sorted last 4 values" errors=0 n=5 res=[10,2,5,18,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${k};
	var span = c;
	if span > g.n { span = g.n; }
	if span < 0 { span = 0; }
	let start = g.n - span;
	for i in span {
		for j in i + 1..span {
			if g.res[start + i] > g.res[start + j] {
				let t = g.res[start + i];
				g.res[start + i] = g.res[start + j];
				g.res[start + j] = t;
			}
		}
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted last ", span, " values");
	out
}
@end
