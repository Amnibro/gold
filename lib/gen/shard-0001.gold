code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in i {
			if g.res[j] == x { dup = true; break; }
		}
		if !dup { unique_count++; }
	}
	format(out.s, "items: ", g.n, " unique: ", unique_count);
	out.i = unique_count;
	g.steps += g.n;
	out
}
@end
