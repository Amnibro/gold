fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var start = if g.n > 3 { g.n - 3 } else { 0 };
	format(out.s, "tail(", g.n - start, "): [");
	for i in start..g.n {
		if i > start { format(out.s, ", "); }
		format(out.s, g.res[i]);
	}
	format(out.s, "]");
	out.i = g.n - start;
	g.steps += g.n;
	out
}
@end
