fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${stop};
	out.s.clear();
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x == limit { break; }
		if count > 0 { out.s.push(','); }
		format(out.s, x);
		count++;
	}
	out.i = count;
	g.steps += count;
	out
}
@end
