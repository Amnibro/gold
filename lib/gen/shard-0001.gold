@entry ae6539d44bc2ec8e
kind: step
verb: rotate
noun: step
modifier: any
context: error
phrase: rotate step any amount {shift}
phrase: shift elements by any step {shift}
phrase: apply any step rotation of {shift}
slot: shift int
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated elements by step 1" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=10 shift=0
expect: => i=0 r=0.0 ok=false s="error: invalid rotation shift" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s <= 0 || s >= g.n {
		gold_fail(g, "invalid rotation shift");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid rotation shift");
		return out;
	}
	for step in s {
		let first = g.res[0];
		for k in 1..g.n { g.res[k - 1] = g.res[k]; }
		g.res[g.n - 1] = first;
	}
	g.steps += g.n * s;
	out.i = s;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated elements by step ", s);
	out
}
@end
