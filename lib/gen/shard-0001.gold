code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < out.s.len { lim } else { out.s.len };
	var i = 0;
	while i < count {
		var j = i + 1;
		while j < count {
			if out.s[i] > out.s[j] {
				let tmp = out.s[i];
				out.s[i] = out.s[j];
				out.s[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += count * 2;
	out.i = count;
	out
}
@end
