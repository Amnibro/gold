@entry 11afa8ef15f403d3
kind: step
verb: measure
noun: histogram
modifier: pairwise
context: sort
phrase: measure pairwise differences up to {max_diff}
phrase: tally pairwise steps within {max_diff}
phrase: count pairwise intervals up to {max_diff}
slot: max_diff int
test: list=10,2,15,5 max_diff=4
expect: => i=1 r=0.0 ok=true s="measured 1 pairwise bins" errors=0 n=4 res=[2,5,10,15] cache=0 hits=0
test: list=1,4,7 max_diff=3
expect: => i=2 r=0.0 ok=true s="measured 2 pairwise bins" errors=0 n=3 res=[1,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for histogram");
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if diff <= md { count++; }
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured ", count, " pairwise bins");
	out
}
@end
