@entry ee545c387543dd7a
kind: step
verb: collect
noun: maximum
modifier: all
context: math
phrase: collect all maximum values
phrase: gather every maximum element
phrase: preserve all peak values
test: list=3,8,2,8,5
expect: => i=8 r=0.0 ok=true s="collected 2 maximum values" errors=0 n=2 res=[8,8] cache=0 hits=0
test: list=14,9,14,14,7
expect: => i=14 r=0.0 ok=true s="collected 3 maximum values" errors=0 n=3 res=[14,14,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to collect");
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] == max_val {
			g.res[kept] = max_val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = max_val;
	out.s.clear();
	format(out.s, "collected ", kept, " maximum values");
	out
}
@end
