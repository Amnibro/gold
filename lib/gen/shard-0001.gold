kind: step
verb: reverse
noun: items
modifier: first
context: math
phrase: reverse first {count} items
phrase: invert order of first {count} items
phrase: flip position of first {count} items
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="reversed 3 items" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=1,2,3,4 count=4
expect: => i=4 r=0.0 ok=true s="reversed 4 items" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative count");
		out.ok = false;
		return out;
	}
	let lim = if k > g.n { g.n } else { k };
	for i in lim / 2 {
		let j = lim - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed ", lim, " items");
	out
}
@end
