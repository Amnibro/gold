@entry 939de28d3cca79b6
kind: step
verb: join
noun: runs
modifier: times
context: sort
phrase: join sorted runs occurring {count} times
phrase: combine sorted runs repeating {count} times
phrase: merge identical sorted runs appearing {count} times
slot: count int
test: list=4,2,2,2,5,5,8 count=3
expect: => i=1 r=0.0 ok=true s="joined 1 runs of target length" errors=0 n=5 res=[2,4,5,5,8] cache=0 hits=0
test: list=1,1,2,2,3 count=2
expect: => i=2 r=0.0 ok=true s="joined 2 runs of target length" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var joined = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len == target_len {
			new_res[new_n] = g.res[i];
			new_n++;
			joined++;
		} else {
			for k in i..j {
				new_res[new_n] = g.res[k];
				new_n++;
			}
		}
		i = j;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = joined;
	out.s.clear();
	format(out.s, "joined ", joined, " runs of target length");
	out
}
@end
