expect: => i=4 r=0.0 ok=true s="reversed first 4 steps" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var rev_len = if c < g.n { c } else { g.n };
	if rev_len < 0 { rev_len = 0; }
	var i = 0;
	var j = rev_len - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += rev_len;
	out.i = rev_len;
	out.s.clear();
	format(out.s, "reversed first ", rev_len, " steps");
	out
}
@end
