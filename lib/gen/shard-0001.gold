code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative drop count");
		out.ok = false;
		return out;
	}
	if k >= g.n {
		g.n = 0;
	} else {
		g.n -= k;
	}
	out.i = g.n;
	g.steps += k + 1;
	out
}
@end
