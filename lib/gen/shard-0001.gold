test: list=2,4,6,8 target=10
expect: => i=12 r=0.0 ok=true s="running sum reached 12" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,2,3 target=50
expect: => i=6 r=0.0 ok=false s="running sum reached 6" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var running = 0;
	var steps = 0;
	for k in g.n {
		running += g.res[k];
		steps++;
		if running >= tgt {
			break;
		}
	}
	g.steps += steps;
	out.i = running;
	out.ok = running >= tgt;
	out.s.clear();
	format(out.s, "running sum reached ", running);
	out
}
@end
