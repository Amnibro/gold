@entry bb2055e9d9c28e95
kind: step
verb: split
noun: primes
modifier: in_place
context: aggregate
phrase: split primes in_place aggregate sums
phrase: partition results summing primes in place
phrase: separate primes in place aggregating totals
test: list=2,3,4,5,6
expect: => i=10 r=0.0 ok=true s="primes sum=10 others=10" errors=0 n=2 res=[10,10] cache=0 hits=0
test: list=7,8,9,10
expect: => i=7 r=0.0 ok=true s="primes sum=7 others=27" errors=0 n=2 res=[7,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_sum = 0;
	var non_prime_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; }
			d++;
		}
		if is_p { prime_sum += x; }
		else { non_prime_sum += x; }
	}
	gold_clear(g);
	gold_push(g, prime_sum);
	gold_push(g, non_prime_sum);
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "primes sum=", prime_sum, " others=", non_prime_sum);
	out
}
@end
