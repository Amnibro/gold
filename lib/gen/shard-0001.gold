code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = false;
		if x >= 2 {
