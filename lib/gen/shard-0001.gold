@entry 7bc8d64702ac960d
kind: step
verb: collect
noun: digits
modifier: in_reverse
context: list
phrase: collect digits in reverse from each item
phrase: extract digits in reverse order from items
phrase: gather decimal digits in reverse for elements
test: list=482,75
expect: => i=5 r=0.0 ok=true s="collected 5 digits in reverse" errors=0 n=5 res=[2,8,4,5,7] cache=0 hits=0
test: list=30,9
expect: => i=3 r=0.0 ok=true s="collected 3 digits in reverse" errors=0 n=3 res=[0,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no items to collect digits");
		return out;
	}
	var buf int[512] = [0; 512];
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		if x == 0 {
			if total < 512 { buf[total] = 0; total++; }
		} else {
			while x > 0 {
				if total < 512 { buf[total] = x % 10; total++; }
				x /= 10;
			}
		}
	}
	gold_clear(g);
	for k in total { gold_push(g, buf[k]); }
	g.steps += total;
	out.i = total;
	out.s.clear();
	format(out.s, "collected ", total, " digits in reverse");
	out
}
@end
@entry 9a67f52eab96d808
kind: step
verb: count
noun: tail
modifier: until
context: list
phrase: count tail elements until condition {p}
phrase: inspect tail items backwards until {p}
phrase: scan tail elements in reverse until {p}
slot: p pred
test: list=2,4,7,6,8 p=is_odd
expect: => i=2 r=0.0 ok=true s="counted 2 tail items before match" errors=0 n=5 res=[2,4,7,6,8] cache=0 hits=0
test: list=1,3,5 p=is_even
expect: => i=3 r=0.0 ok=false s="no match in tail of 3 items" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var examined = 0;
	var found = false;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if ${p}(x) {
			found = true;
			break;
		}
		examined++;
		idx--;
	}
	g.steps += examined;
	if found { g.steps++; }
	out.i = examined;
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "counted ", examined, " tail items before match");
	} else {
		format(out.s, "no match in tail of ", examined, " items");
	}
	out
}
@end
