@entry 0cee6ad25eddd0bf
kind: step
verb: dedupe
noun: middle
modifier: in_place
context: math
phrase: dedupe middle in_place elements
phrase: remove middle duplicates in_place
phrase: filter middle items in_place
test: list=1,2,2,3,4
expect: => i=1 r=0.0 ok=true s="deduped middle dropped 1 items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6,6,7
expect: => i=2 r=0.0 ok=true s="deduped middle dropped 2 items" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("too few items for middle dedupe");
		return out;
	}
	var new_res int[512] = [0; 512];
	new_res[0] = g.res[0];
	var new_n = 1;
	for k in 1..g.n - 1 {
		let x = g.res[k];
		var seen = false;
		for j in 1..new_n {
			if new_res[j] == x { seen = true; break; }
		}
		if !seen {
			new_res[new_n] = x;
			new_n++;
		}
	}
	new_res[new_n] = g.res[g.n - 1];
	new_n++;
	for k in new_n { g.res[k] = new_res[k]; }
	let dropped = g.n - new_n;
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped middle dropped ", dropped, " items");
	out
}
@end
@entry 81140182b0820550
kind: step
verb: sort
noun: window
modifier: any
context: math
phrase: sort window any size {size}
phrase: sort elements in any window {size}
phrase: order any window chunks of {size}
slot: size int
test: list=3,1,2,6,4,5 size=3
expect: => i=2 r=0.0 ok=true s="sorted 2 windows" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,5,20,15 size=2
expect: => i=2 r=0.0 ok=true s="sorted 2 windows" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 1 || g.n < sz {
		out.i = 0;
		out.s.clear();
		out.s.append("window too small to sort");
		return out;
	}
	var i = 0;
	while i + sz <= g.n {
		for a in i..i + sz {
			for b in a + 1..i + sz {
				if g.res[a] > g.res[b] {
					let tmp = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = tmp;
				}
			}
		}
		i += sz;
	}
	g.steps += g.n * sz;
	out.i = g.n / sz;
	out.s.clear();
	format(out.s, "sorted ", g.n / sz, " windows");
	out
}
@end
