fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var count = 0;
			for k in g.n {
				if g.res[k] == x { count++; }
			}
			gold_cache_put(g, x, count);
			distinct++;
		}
	}
	g.steps += g.n * g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "cached ", distinct, " unique runs");
	out
}
@end
