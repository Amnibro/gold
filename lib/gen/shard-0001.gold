code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough observations for gaps");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: not enough observations");
		return out;
	}
	var diffs int[512] = [0; 512];
	let count = g.n - 1;
	for k in count {
		diffs[k] = g.res[k + 1] - g.res[k];
	}
	for k in count {
		g.res[k] = diffs[count - 1 - k];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " gaps safely");
	out
}
@end
