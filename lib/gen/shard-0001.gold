fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var yes int[512] = [0; 512];
	var no int[512] = [0; 512];
	var yn = 0;
	var nn = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			yes[yn] = g.res[i];
			yn++;
		} else {
			no[nn] = g.res[i];
			nn++;
		}
	}
	for i in yn { g.res[i] = yes[i]; }
	for i in nn { g.res[yn + i] = no[i]; }
	out.i = yn;
	g.steps += g.n + 1;
	out
}
