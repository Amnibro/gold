fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	var count = 0;
	for k in g.n {
