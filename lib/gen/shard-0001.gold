slot: times int
test: list=2,3,4,5 times=2
expect: => i=3 r=0.0 ok=true s="primes found across passes: 3" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=4,6,8 times=1
expect: => i=0 r=0.0 ok=true s="primes found across passes: 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${times};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	g.steps += g.n * passes;
	out.i = primes;
	out.s.clear();
	format(out.s, "primes found across passes: ", primes);
	out
}
@end
