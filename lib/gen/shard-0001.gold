noun: minimum
modifier: pairwise
context: error
phrase: find minimum pairwise difference
phrase: locate smallest adjacent step
test: list=5,12,14,20
expect: => i=2 r=0.0 ok=true s="minimum pairwise diff: 2" errors=0 n=4 res=[5,12,14,20] cache=0 hits=0
test: list=10
expect: => i=0 r=0.0 ok=false s="error: insufficient items for pairwise check" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items for pairwise check");
		return out;
	}
	var min_diff = g.res[1] - g.res[0];
	if min_diff < 0 { min_diff = -min_diff; }
	for i in 1..(g.n - 1) {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff < min_diff { min_diff = diff; }
	}
	g.steps += g.n - 1;
	out.i = min_diff;
	out.s.clear();
	format(out.s, "minimum pairwise diff: ", min_diff);
	out
}
@end
