@entry c1a91c5ef1301665
kind: step
verb: retry
noun: pairs
modifier: between
context: stats
phrase: adjust paired samples spanning {lo} to {hi}
phrase: balance paired observations bounded by {lo} to {hi}
slot: lo int
slot: hi int
test: list=2,20,5,30 lo=10 hi=25
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[11,11,12,13] cache=0 hits=0
test: list=1,15,4,40 lo=5 hi=20
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[8,8,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var modified = 0;
	var i = 0;
	while i + 1 < g.n {
		var s = g.res[i] + g.res[i + 1];
		if s < lo { s = lo; modified++; }
		if s > hi { s = hi; modified++; }
		g.res[i] = s / 2;
		g.res[i + 1] = s - g.res[i];
		i += 2;
	}
	out.i = modified;
	g.steps += g.n + 1;
	out
}
@end
