@entry 6496b414a6073a45
kind: step
verb: collect
noun: tally
modifier: nested
context: sort
phrase: collect nested frequency tally of sorted observations
phrase: compile nested tally of sorted identical values
phrase: record nested counts for sorted groups
test: list=5,2,5,2,5
expect: => i=2 r=0.0 ok=true s="collected nested tally for 2 sorted groups" errors=0 n=4 res=[2,2,5,3] cache=0 hits=0
test: list=7
expect: => i=1 r=0.0 ok=true s="collected nested tally for 1 sorted groups" errors=0 n=2 res=[7,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for nested tally");
		out.ok = false;
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var tmp int[512] = [0; 512];
	var w = 0;
	var i = 0;
	var unique = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		tmp[w] = g.res[i];
		tmp[w + 1] = j - i;
		w += 2;
		unique++;
		i = j;
	}
	for k in w { g.res[k] = tmp[k]; }
	g.n = w;
	g.steps += g.n;
	out.i = unique;
	out.s.clear();
	format(out.s, "collected nested tally for ", unique, " sorted groups");
	out
}
@end
