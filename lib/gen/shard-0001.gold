code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var write_idx = 0;
	var read_idx = 0;
	while read_idx < out.s.len {
		let c = out.s[read_idx];
		if c == ' ' {
			dropped++;
		} else {
			out.s[write_idx] = c;
			write_idx++;
		}
		read_idx++;
	}
	out.s.resize(write_idx, 0);
	gold_cache_put(g, 0, dropped);
	g.steps += read_idx;
	out.i = dropped;
	out
}
@end
