code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${goal};
	var sum = 0;
	var count = 0;
	var k = g.n - 1;
	while k >= 0 && sum < target {
		sum += g.res[k];
		count++;
		k--;
	}
	g.steps += count;
	out.ok = sum >= target;
	out.i = count;
	out.s.clear();
	format(out.s, "retry tail reached sum ", sum, " with ", count, " items");
	out
}
@end
