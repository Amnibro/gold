fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${count};
	var words = 0;
	var in_w = false;
	var cut_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] != ' ' {
			if !in_w {
				in_w = true;
				words++;
			}
		} else {
			if in_w {
				in_w = false;
				if words == req {
					cut_idx = i;
					break;
				}
			}
		}
	}
	var kept byte[..200] = "";
	for i in cut_idx {
		if kept.len < 200 { kept.push(out.s[i]); }
	}
	out.s = kept;
	g.steps += out.s.len;
	out.i = words;
	out
}
@end
