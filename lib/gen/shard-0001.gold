noun: squares
modifier: pairwise
context: filter
phrase: select squares pairwise matching {check}
phrase: pairwise select items where difference satisfies {check}
phrase: filter pairwise consecutive elements with {check}
slot: check pred
test: list=1,5,14,16 check=is_square
expect: => i=2 r=0.0 ok=true s="selected 2 pairwise squares" errors=0 n=2 res=[1,5] cache=0 hits=0
test: list=2,6,10,11 check=is_even
expect: => i=2 r=0.0 ok=true s="selected 2 pairwise squares" errors=0 n=2 res=[2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise square selection");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var kept = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if ${check}(diff) {
			tmp[kept] = g.res[k];
			kept++;
		}
	}
	for i in kept {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " pairwise squares");
	out
}
@end
