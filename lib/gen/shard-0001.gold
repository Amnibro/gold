		gold_fail(g, "invalid clamp range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: lower bound exceeds upper bound");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty sample for clamp");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for k in g.n {
		if g.res[k] < low {
			g.res[k] = low;
			clamped++;
		} else if g.res[k] > high {
			g.res[k] = high;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "safely clamped ", clamped, " items");
	out
}
@end
