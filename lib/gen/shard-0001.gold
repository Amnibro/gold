test: list=10,20,30,40,50 count=4
expect: => i=2 r=0.0 ok=true s="repeated suffix every other with 2 items" errors=0 n=7 res=[10,20,30,40,50,20,40] cache=0 hits=0
test: list=10,20 count=0
expect: => i=0 r=0.0 ok=false s="error: non-positive count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 {
		gold_fail(g, "invalid retry count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive count");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list for suffix repeat");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let orig_n = g.n;
	let start = if orig_n > cnt { orig_n - cnt } else { 0 };
	var added = 0;
	var i = start;
	while i < orig_n {
		if (i - start) % 2 == 0 {
			gold_push(g, g.res[i]);
			added++;
		}
		i++;
	}
	g.steps += cnt;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated suffix every other with ", added, " items");
	out
}
@end
