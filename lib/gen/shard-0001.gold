code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j += 2;
		}
		i += 2;
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
