test: list=3,8,12,5,14 cond=is_even
expect: => i=3 r=0.0 ok=true s="filtered series in reverse keeping 3 items" errors=0 n=3 res=[14,12,8] cache=0 hits=0
test: list=1,3,5 cond=is_even
expect: => i=0 r=0.0 ok=false s="error: no elements passed filter" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty series for reverse filter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	var kept int[512] = [0; 512];
	var kept_n = 0;
	var rejected = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if ${cond}(x) {
			kept[kept_n] = x;
			kept_n++;
		} else {
			rejected++;
		}
		if idx == 0 { break; }
		idx--;
	}
	for k in kept_n {
		g.res[k] = kept[k];
	}
	g.n = kept_n;
	g.steps += g.n + rejected;
	out.i = kept_n;
	if kept_n == 0 {
		gold_fail(g, "all series elements rejected");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no elements passed filter");
		return out;
	}
	out.s.clear();
	format(out.s, "filtered series in reverse keeping ", kept_n, " items");
	out
}
@end
@entry 5d10c0cff8ea6faa
kind: step
verb: retry
noun: average
modifier: recursively
context: error
phrase: retry average recursively with max depth {depth}
phrase: compute recursive average with retry limit {depth}
phrase: recursively retry average calculation depth {depth}
slot: depth int
test: list=10,20,30 depth=3
expect: => i=20 r=0.0 ok=true s="computed recursive average 20 after 0 retries" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20 depth=0
expect: => i=0 r=0.0 ok=false s="error: non-positive depth" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	if max_d <= 0 {
		gold_fail(g, "invalid recursive depth limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive depth");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list for recursive average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var d = 0;
	var avg = 0;
	while d < max_d && g.n > 0 {
		var sum = 0;
		for k in g.n {
			sum += g.res[k];
		}
		avg = sum / g.n;
		var max_idx = 0;
		var has_err = false;
		for k in g.n {
			if g.res[k] > g.res[max_idx] {
				max_idx = k;
			}
			if g.res[k] < 0 {
				has_err = true;
			}
		}
		if !has_err {
			break;
		}
		var j = max_idx;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n--;
		d++;
	}
	g.steps += d + 1;
	out.i = avg;
	if g.n == 0 {
		gold_fail(g, "recursive average exhausted all items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: exhausted list");
		return out;
	}
	out.s.clear();
	format(out.s, "computed recursive average ", avg, " after ", d, " retries");
	out
}
@end
@entry 37b2d017a6355d1a
kind: step
verb: run
noun: value
modifier: times
context: error
phrase: run value on errors count {times}
phrase: execute error value adjustment times {times}
phrase: apply error value run count {times}
slot: times int
test: list=2,1,3 times=3
expect: => i=0 r=0.0 ok=true s="successfully cleared errors in 3 passes" errors=0 n=3 res=[0,0,0] cache=0 hits=0
test: list=5,4 times=0
expect: => i=0 r=0.0 ok=false s="error: non-positive run count" errors=1 n=2 res=[5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${times};
	if count <= 0 {
		gold_fail(g, "invalid run count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive run count");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list for value run");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	for t in count {
		for k in g.n {
			if g.res[k] > 0 {
				g.res[k]--;
			}
		}
	}
	var remaining_errs = 0;
	for k in g.n {
		if g.res[k] > 0 {
			remaining_errs += g.res[k];
		}
	}
	g.steps += count * g.n;
	out.i = remaining_errs;
	if remaining_errs > 0 {
		gold_fail(g, "errors remain after value runs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: ", remaining_errs, " unresolved errors");
		return out;
	}
	out.s.clear();
	format(out.s, "successfully cleared errors in ", count, " passes");
	out
}
@end
