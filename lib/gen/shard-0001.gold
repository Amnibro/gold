@entry 3cca08e361031d28
kind: step
verb: return
noun: memo
modifier: unique
context: error
phrase: return unique memo values from list
phrase: collect unique memo results without error
phrase: return memo items preserving uniqueness
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="returned 3 unique memo values" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=false s="error: insufficient unique memo values" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		let val = g.res[k];
		var seen = false;
		for j in new_n {
			if new_res[j] == val { seen = true; break; }
		}
		if !seen {
			new_res[new_n] = val;
			new_n++;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	if new_n >= 2 {
		out.ok = true;
		format(out.s, "returned ", new_n, " unique memo values");
	} else {
		gold_fail(g, "insufficient unique memo values");
		out.ok = false;
		format(out.s, "error: insufficient unique memo values");
	}
	out
}
@end
