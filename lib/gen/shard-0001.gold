fn ${ID}(n int) bool {
	let limit = ${cap};
	var x = if n < 0 { -n } else { n };
	if x <= 1 { return false; }
	var p = 2;
	while p <= limit && p < x {
		var is_p = true;
		var d = 2;
		while d * d <= p {
			if p % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && x % p == 0 {
			return false;
		}
		p++;
	}
	true
}
@end
