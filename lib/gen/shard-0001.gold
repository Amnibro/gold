		gold_fail(g, "zero divisor");
		out.ok = false;
		return out;
	}
	for k in g.n {
		g.res[k] /= d;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped number safely count ", g.n);
	out
}
