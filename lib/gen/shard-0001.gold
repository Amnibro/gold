fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		let mid = g.n / 2;
		for k in mid {
			let j = g.n - 1 - k;
			let a = ${transform_fn}(g.res[k]);
			let b = ${transform_fn}(g.res[j]);
			g.res[k] = b;
			g.res[j] = a;
			swaps++;
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped subfunction between ", swaps, " pairs");
	out
}
@end
