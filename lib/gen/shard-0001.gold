code:
fn ${ID}(n int) int {
	let target_count = ${count};
	var x = if n < 0 { -n } else { n };
	var sum = 0;
	var found = 0;
	while x > 0 && found < target_count {
		let d = x % 10;
		if d % 2 == 0 {
			sum += d;
			found++;
		}
		x /= 10;
	}
	sum
}
@end
