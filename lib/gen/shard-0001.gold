code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo > hi || lo <= 0 {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in lo..(hi + 1) {
		var cur = k;
		var steps = 0;
		while cur > 1 && steps < 100 {
			if cur % 2 == 0 {
				cur = cur / 2;
			} else {
				cur = 3 * cur + 1;
			}
			steps++;
		}
		gold_cache_put(g, k, steps);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " step counts");
	out
}
