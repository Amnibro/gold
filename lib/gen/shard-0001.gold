test: list=1,2,3,4 fn_step=double
expect: => i=4 r=0.0 ok=true s="swapped subfunction all items 4" errors=0 n=4 res=[8,6,4,2] cache=0 hits=0
test: list=10,20 fn_step=inc
expect: => i=2 r=0.0 ok=true s="swapped subfunction all items 2" errors=0 n=2 res=[21,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${fn_step}(g.res[k]);
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped subfunction all items ", g.n);
	out
}
@end
@entry a96443ed9257ead3
kind: step
verb: check
noun: items
modifier: recursively
context: filter
phrase: check items recursively under limit {top}
phrase: verify items recursively below bound {top}
slot: top int
test: list=5,10,25,30 top=20
expect: => i=2 r=0.0 ok=true s="recursively checked items popped 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=1,2,3 top=10
expect: => i=0 r=0.0 ok=true s="recursively checked items popped 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tp = ${top};
	var popped = 0;
	while g.n > 0 && g.res[g.n - 1] > tp {
		g.n--;
		popped++;
	}
	g.steps += popped + 1;
	out.i = popped;
	out.s.clear();
	format(out.s, "recursively checked items popped ", popped);
	out
}
@end
@entry b1283d9e6adb36fd
kind: step
verb: pair
noun: middle
modifier: while
context: filter
phrase: pair middle elements while sum below {bound}
phrase: combine middle pairs while under limit {bound}
slot: bound int
test: list=1,2,3,4,10 bound=10
expect: => i=2 r=0.0 ok=true s="paired middle while under bound 2" errors=0 n=3 res=[1,9,10] cache=0 hits=0
test: list=5,20,30,5 bound=10
expect: => i=0 r=0.0 ok=true s="paired middle while under bound 0" errors=0 n=4 res=[5,20,30,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var pairs_combined = 0;
	if g.n > 2 {
		var i = 1;
		while i + 1 < g.n - 1 {
			if g.res[i] + g.res[i + 1] < b {
				g.res[i] = g.res[i] + g.res[i + 1];
				for j in (i + 1)..(g.n - 1) {
					g.res[j] = g.res[j + 1];
				}
				g.n--;
				pairs_combined++;
			} else {
				i++;
			}
		}
	}
	g.steps += g.n;
	out.i = pairs_combined;
	out.s.clear();
	format(out.s, "paired middle while under bound ", pairs_combined);
	out
}
@end
