fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 || cnt > g.n {
		gold_fail(g, "invalid suffix count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid suffix count");
		return out;
	}
	let start = g.n - cnt;
	for i in cnt {
		let idx = g.n - 1 - i;
		g.res[idx] = ${op}(g.res[idx]);
	}
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "ran suffix ", cnt, " items in reverse");
	out
}
@end
