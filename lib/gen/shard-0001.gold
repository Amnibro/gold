test: text="apple" thresh=110
expect: => i=97 r=0.0 ok=true s="code 97 meets threshold" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text");
		out.ok = false;
		return out;
	}
	var th = ${thresh};
	let code = out.s[0] as int;
	var ok = code >= th;
	if !ok {
		th /= 2;
		ok = code >= th;
	}
	g.steps += 1;
	out.i = code;
	out.ok = ok;
	out.s.clear();
	if ok {
		format(out.s, "code ", code, " meets threshold");
	} else {
		format(out.s, "code ", code, " failed threshold");
	}
	out
}
@end
