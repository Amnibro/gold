expect: => i=2 r=0.0 ok=true s="scaled last run of 2 items" errors=0 n=4 res=[5,5,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var k = g.n - 1;
	var count = 0;
	while k >= 0 && g.res[k] == last_val {
		g.res[k] *= f;
		count++;
		k--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled last run of ", count, " items");
	out
}
@end
