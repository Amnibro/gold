code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_sq};
	if g.n > 0 {
		let last_item = g.res[g.n - 1];
		var sq = last_item * last_item;
		if sq > ceiling { sq = ceiling; }
		g.res[g.n - 1] = sq;
		g.steps += 1;
		out.i = sq;
	}
	out.s.clear();
	format(out.s, "clamped last square to ", out.i);
	out
}
@end
