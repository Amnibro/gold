fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty letter string");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty letter string");
		return out;
	}
	var count = 0;
	for i in out.s.len {
		let ch = out.s[i];
		if ch == 'e' || ch == 'r' { count++; }
	}
	let len = out.s.len;
	for i in len / 2 {
		let j = len - 1 - i;
