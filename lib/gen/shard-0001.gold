test: list=10,20,30,50
expect: => i=2 r=0.0 ok=true s="computed 2 pairwise averages" errors=0 n=2 res=[15,40] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=false s="error: odd item count" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	if g.n % 2 != 0 {
		gold_fail(g, "odd count for pairwise average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: odd item count");
		return out;
	}
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = (g.res[k * 2] + g.res[k * 2 + 1]) / 2;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "computed ", pairs, " pairwise averages");
	out
}
@end
