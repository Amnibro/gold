fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var total_gaps = 0;
	for _ in p {
		if g.n > 1 {
			let new_n = g.n - 1;
			for k in new_n {
				g.res[k] = g.res[k + 1] - g.res[k];
				total_gaps++;
			}
			g.n = new_n;
		}
	}
	g.steps += total_gaps;
	out.i = total_gaps;
	out.s.clear();
	format(out.s, "computed ", total_gaps, " paired gaps");
	out
}
@end
