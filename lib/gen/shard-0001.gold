@entry e0ef6508756dec1e
kind: step
verb: rotate
noun: function
modifier: between
context: list
phrase: rotate subsegment from {low} to {high} applying function {f}
phrase: transform range between {low} through {high} with {f} in cycle
slot: f fn
slot: low int
slot: high int
test: list=1,2,3,4,5 f=double low=1 high=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,6,8,4,5] cache=0 hits=0
