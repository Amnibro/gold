expect: => i=1 r=0.0 ok=false s="validation failed at index 1" errors=1 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var valid = 0;
	var idx = 0;
	while idx < g.n && idx < lim {
		if !${check_fn}(g.res[idx]) {
			gold_fail(g, "history validation failed");
			out.ok = false;
			out.i = idx;
			out.s.clear();
			format(out.s, "validation failed at index ", idx);
			return out;
		}
		valid++;
		idx++;
	}
	out.i = valid;
	out.s.clear();
	format(out.s, "history validated up to ", valid);
	out
}
@end
@entry eb46e80ee3778966
kind: step
verb: join
noun: tail
modifier: safely
context: transform
phrase: join tail safely last {count} items
phrase: safely join tail elements up to count {count}
phrase: format tail values safely for {count} entries
slot: count int
test: list=10,20,30,40 count=3
expect: => i=90 r=0.0 ok=true s="20-30-40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15 count=1
expect: => i=15 r=0.0 ok=true s="15" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 || g.n == 0 {
		out.s.clear();
		format(out.s, "empty tail");
		return out;
	}
	var start = g.n - k;
	if start < 0 { start = 0; }
	out.s.clear();
	var total = 0;
	var idx = start;
	while idx < g.n {
		if idx > start { out.s.push('-'); }
		format(out.s, g.res[idx]);
		total += g.res[idx];
		idx++;
	}
	out.i = total;
	out
}
@end
