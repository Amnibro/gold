@entry 8123c89be37679e7
kind: step
verb: merge
noun: duplicates
modifier: none
context: stats
phrase: merge duplicate observations into unique set
phrase: eliminate repeated distribution samples entirely
test: list=1,2,2,3,3,3,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		var dup = false;
		for j in kept {
			if g.res[j] == g.res[i] { dup = true; break; }
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
