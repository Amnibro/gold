code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${head_count};
	if k > g.n { k = g.n; }
	if k > 1 {
		var left = 0;
		var right = k - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = k;
	out.s.clear();
	format(out.s, "rotated head in reverse count=", k);
	out
}
@end
