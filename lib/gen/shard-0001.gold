@entry 16d635823741e8bf
kind: step
verb: reverse
noun: steps
modifier: each
context: transform
phrase: reverse each step chunk of size {chunk}
phrase: invert steps across each block of {chunk}
slot: chunk int
test: list=1,2,3,4,5,6 chunk=3
expect: => i=2 r=0.0 ok=true s="reversed 2 step blocks" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=1,2,3,4 chunk=1
expect: => i=0 r=0.0 ok=true s="reversed 0 step blocks" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	var reversed = 0;
	if sz > 1 {
		var start = 0;
		while start + sz <= g.n {
			var i = start;
			var j = start + sz - 1;
			while i < j {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				i++;
				j--;
			}
			reversed++;
			start += sz;
		}
	}
	g.steps += g.n;
	out.i = reversed;
	out.s.clear();
	format(out.s, "reversed ", reversed, " step blocks");
	out
}
@end
@entry ff46b1eeeda6839a
kind: step
verb: swap
noun: histogram
modifier: recursively
context: transform
phrase: swap histogram peaks recursively over threshold {limit}
phrase: invert histogram bins recursively above {limit}
slot: limit int
test: list=20,5,30,8,40 limit=10
expect: => i=1 r=0.0 ok=true s="swapped 1 histogram elements" errors=0 n=5 res=[40,5,30,8,20] cache=0 hits=0
test: list=1,2,3 limit=50
expect: => i=0 r=0.0 ok=true s="swapped 0 histogram elements" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swapped = 0;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < j && g.res[i] <= lim { i++; }
		while i < j && g.res[j] <= lim { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			swapped++;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " histogram elements");
	out
}
@end
