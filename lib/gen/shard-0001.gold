@entry bcf70fd1997dee9e
kind: step
verb: clamp
noun: streak
modifier: none
context: text
phrase: clamp streak none limit {max_rep}
phrase: cap consecutive identical characters to {max_rep}
phrase: restrict character streak length to {max_rep}
slot: max_rep int
test: text="aaabbbbcc" max_rep=2
expect: => i=6 r=0.0 ok=true s="aabbcc" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxxxxy" max_rep=3
expect: => i=4 r=0.0 ok=true s="xxxy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_rep};
	var new_s byte[256] = [0; 256];
	var sn = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		let start = i;
		while i < out.s.len && out.s[i] == b {
			i++;
		}
		let run_len = i - start;
		let take = if run_len < limit { run_len } else { limit };
		for k in take {
			new_s[sn] = b;
			sn++;
		}
	}
	out.s.clear();
	for k in sn { out.s.push(new_s[k]); }
	g.steps += out.s.len + sn;
	out.i = sn;
	out
}
@end
