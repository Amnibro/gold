			j++;
		}
		new_res[new_n] = s;
		new_n++;
		i += sz;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped head into ", new_n, " sums");
