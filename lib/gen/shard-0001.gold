code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	let original_len = g.n;
	gold_cache_put(g, 0, original_len);
	if original_len > 0 && rep > 1 {
		var cur = 1;
		while cur < rep && g.n + original_len <= 512 {
			for k in original_len {
				g.res[g.n + k] = g.res[k];
			}
			g.n += original_len;
			cur++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated list to length ", g.n);
	out
}
@end
