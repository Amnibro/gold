@entry d4801116ba5612b5
kind: step
verb: fold
noun: squares
modifier: recursively
context: text
phrase: fold squares recursively limit {cap}
phrase: accumulate square digit values recursively under {cap}
phrase: fold squares of digits recursively bound {cap}
slot: cap int
test: text="abc123xyz" cap=50
expect: => i=14 r=0.0 ok=true s="folded 3 squares total=14" errors=0 n=0 res=[] cache=0 hits=0
test: text="item45total" cap=30
expect: => i=16 r=0.0 ok=true s="folded 1 squares total=16" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var count = 0;
	for b in out.s {
		if b >= '0' && b <= '9' {
			let d = (b - '0') as! int;
			let sq = d * d;
			if sum + sq <= limit {
				sum += sq;
				count++;
			} else {
				break;
			}
		}
	}
	g.steps += out.s.len + count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded ", count, " squares total=", sum);
	out
}
@end
