test: list=4,7,2,9,11
expect: => i=3 r=0.0 ok=true s="counted 3 primes in reverse order" errors=0 n=5 res=[11,9,7,4,2] cache=0 hits=0
test: list=4,6,8,10
expect: => i=0 r=0.0 ok=true s="counted 0 primes in reverse order" errors=0 n=4 res=[10,8,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] < key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " primes in reverse order");
	out
}
@end
