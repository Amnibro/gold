code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for k in g.n { total += g.res[k]; }
	var check = 0;
	var i = g.n - 1;
	while i >= 0 {
		check += g.res[i];
		i--;
	}
	g.steps += g.n * 2;
	out.i = total;
	out.s.clear();
	if total == check {
		format(out.s, "measured results total ", total, " verified");
	} else {
		gold_fail(g, "measurement mismatch");
		out.ok = false;
	}
	out
}
@end
