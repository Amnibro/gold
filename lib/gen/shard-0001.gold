expect: => i=4 r=0.0 ok=true s="every other deduped length: 4" errors=0 n=4 res=[5,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	var i = 0;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[j] == g.res[i] {
				g.res[j] = -1;
			}
			j += 2;
		}
		i += 2;
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] != -1 {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "every other deduped length: ", kept);
	out
}
@end
