@entry e51c095e6d319ab2
kind: step
verb: count
noun: duplicates
modifier: at_least
context: list
phrase: count duplicates appearing at least {min_count} times
phrase: tally elements repeated at least {min_count} times
phrase: find duplicate values occurring at least {min_count} times
slot: min_count int
test: list=1,2,2,3,3,3,4 min_count=2
expect: => i=2 r=0.0 ok=true s="found 2 duplicate values" errors=0 n=7 res=[1,2,2,3,3,3,4] cache=0 hits=0
test: list=5,5,5,8,8,8 min_count=3
expect: => i=2 r=0.0 ok=true s="found 2 duplicate values" errors=0 n=6 res=[5,5,5,8,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_count};
	if req <= 1 {
		gold_fail(g, "threshold must be greater than one");
		out.ok = false;
		return out;
	}
	var dupes = 0;
	for i in g.n {
		let x = g.res[i];
		var first = true;
		for j in i {
			if g.res[j] == x { first = false; }
		}
		if first {
			var total = 0;
			for k in g.n {
				if g.res[k] == x { total++; }
			}
			if total >= req { dupes++; }
		}
	}
	g.steps += g.n;
	out.i = dupes;
	out.s.clear();
	format(out.s, "found ", dupes, " duplicate values");
	out
}
@end
