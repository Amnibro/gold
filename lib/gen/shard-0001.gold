expect: => i=2 r=0.0 ok=true s="traced last counter: 2 occurrences" errors=0 n=4 res=[7,8,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if g.n == 0 {
		gold_fail(g, "empty results for last counter");
		out.ok = false;
		return out;
	}
	let target = g.res[g.n - 1];
	let span = if win <= 0 || win > g.n { g.n } else { win };
	let start = g.n - span;
	var count = 0;
	for k in span {
		if g.res[start + k] == target {
			count++;
		}
	}
	g.steps += span;
	out.i = count;
	out.s.clear();
	format(out.s, "traced last counter: ", count, " occurrences");
	out
}
@end
