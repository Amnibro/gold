code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no step records to sort");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	gold_push(g, g.steps);
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.steps;
	out.s.clear();
	format(out.s, "sorted ", g.n, " step entries");
	out
}
@end
@entry ef945898adead75d
kind: step
verb: group
noun: minimum
modifier: in_reverse
context: retry
phrase: group minimum in reverse window {size}
phrase: group minimum values in reverse window {size}
phrase: compute window minimums in reverse {size}
slot: size int
test: list=9,4,7,2,8,5 size=3
expect: => i=2 r=0.0 ok=true s="computed 2 reverse window minimums" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=4,2 size=5
expect: => i=0 r=0.0 ok=false s="error: invalid window size" errors=1 n=2 res=[4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz > g.n {
		gold_fail(g, "invalid group window size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid window size");
		return out;
	}
	let groups = g.n / sz;
	var mins int[256] = [0; 256];
	for k in groups {
		var m = g.res[k * sz];
		for j in sz {
			let x = g.res[k * sz + j];
			if x < m { m = x; }
		}
		mins[k] = m;
	}
	for k in groups {
		g.res[k] = mins[groups - 1 - k];
	}
	g.n = groups;
	g.steps += groups;
	out.i = groups;
	out.s.clear();
	format(out.s, "computed ", groups, " reverse window minimums");
	out
}
@end
