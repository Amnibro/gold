code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo >= 0 && hi < g.n && lo < hi {
		let first = ${f}(g.res[lo]);
		var i = lo;
		while i < hi {
			g.res[i] = ${f}(g.res[i + 1]);
			i++;
		}
		g.res[hi] = first;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
