@entry 794ab65f7bfc4377
kind: step
verb: scale
noun: values
modifier: at_most
context: transform
phrase: scale values by {factor} at most {ceiling}
phrase: multiply values with {factor} capping at most {ceiling}
phrase: scale sequence by {factor} bounded at most {ceiling}
slot: factor int
slot: ceiling int
test: list=2,5,10 factor=3 ceiling=20
expect: => i=1 r=0.0 ok=true s="scaled values with 1 at most ceiling" errors=0 n=3 res=[6,15,20] cache=0 hits=0
test: list=4,8 factor=2 ceiling=10
expect: => i=1 r=0.0 ok=true s="scaled values with 1 at most ceiling" errors=0 n=2 res=[8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let cap = ${ceiling};
	if g.n == 0 {
		gold_fail(g, "empty list for scaling");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for k in g.n {
		let prod = g.res[k] * f;
		if prod > cap {
			g.res[k] = cap;
			clamped++;
		} else {
			g.res[k] = prod;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "scaled values with ", clamped, " at most ceiling");
	out
}
@end
@entry 9b9c0123073e77fb
kind: step
verb: fill
noun: sequence
modifier: last
context: transform
phrase: fill sequence to {target} using last element
phrase: extend sequence up to {target} with last value
phrase: pad sequence to {target} repeating last
slot: target int
test: list=10,20 target=5
expect: => i=5 r=0.0 ok=true s="filled sequence with 3 copies of last" errors=0 n=5 res=[10,20,20,20,20] cache=0 hits=0
test: list=7 target=3
expect: => i=3 r=0.0 ok=true s="filled sequence with 2 copies of last" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "sequence is empty");
		out.ok = false;
		return out;
	}
	if tgt <= g.n {
		out.i = g.n;
		out.s.clear();
		format(out.s, "sequence already at target length");
		return out;
	}
	let last = g.res[g.n - 1];
	let lim = if tgt > 512 { 512 } else { tgt };
	var added = 0;
	while g.n < lim {
		g.res[g.n] = last;
		g.n++;
		added++;
	}
	g.steps += added;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled sequence with ", added, " copies of last");
	out
}
@end
