@entry 339d0569602a6df3
kind: step
verb: keep
noun: primes
modifier: nested
context: transform
phrase: keep nested prime transform values up to {limit}
phrase: filter nested primes under limit {limit}
slot: limit int
test: list=4,5,6,7,8,9,10,11 limit=10
expect: => i=2 r=0.0 ok=true s="kept 2 nested primes" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=1,4,6,8 limit=20
expect: => i=0 r=0.0 ok=true s="kept 0 nested primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x > 1 && x <= lim {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_prime = false;
					break;
				}
				d++;
			}
			if is_prime {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " nested primes");
	out
}
@end
