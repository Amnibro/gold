		if c < lim {
			new_res[new_n] = x;
			new_n++;
		} else {
			dropped++;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped histogram dropped ", dropped, " items");
	out
}
