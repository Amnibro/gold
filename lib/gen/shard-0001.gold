fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	var s_even = 0;
	var s_odd = 0;
	var idx = 0;
	while x > 0 {
		let d = x % 10;
		if idx % 2 == 0 { s_even += d; } else { s_odd += d; }
		x /= 10;
		idx++;
	}
	out.i = s_even - s_odd;
	g.steps += idx + 1;
	out
}
@end
