slot: times int
test: text="hello" times=1
expect: => i=5 r=0.0 ok=true s="olleh" errors=0 n=0 res=[] cache=0 hits=0
test: text="world" times=2
expect: => i=5 r=0.0 ok=true s="world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${times};
	for step in k {
		var i = 0;
		var j = out.s.len - 1;
		while i < j {
			let tmp = out.s[i];
			out.s[i] = out.s[j];
			out.s[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += k * out.s.len;
	out.i = out.s.len;
	out
}
@end
