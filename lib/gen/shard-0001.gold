code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop_val = ${mark};
	var merged = 0;
	for k in g.n {
		if g.res[k] == stop_val {
			break;
		}
		if out.s.len < 190 {
			out.s.push((g.res[k] % 26 + 97) as byte);
			merged++;
		}
	}
	g.steps += g.n;
	out.i = merged;
	out
}
@end
