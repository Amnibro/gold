kind: step
verb: apply
noun: minimum
modifier: recursively
context: cache
phrase: apply minimum reduction recursively for {steps} steps
phrase: propagate minimum value recursively {steps} times in cache
slot: steps int
test: list=5,2,9 steps=2
expect: => i=2 r=0.0 ok=true s="minimum applied recursively: 2" errors=0 n=3 res=[3,2,7] cache=2 hits=0
test: list=12,4 steps=1
expect: => i=4 r=0.0 ok=true s="minimum applied recursively: 4" errors=0 n=2 res=[11,4] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${steps};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i++;
	}
	var round = 0;
	while round < st {
		var j = 0;
		while j < g.n {
			if g.res[j] > min_val {
				g.res[j]--;
			}
			j++;
		}
		gold_cache_put(g, round, min_val);
		round++;
	}
	g.steps += i + round * g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum applied recursively: ", min_val);
	out
}
@end
