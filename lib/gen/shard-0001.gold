fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0; }
	var count = 0;
	var d = 1;
	while d <= lim && d <= x {
		if x % d == 0 {
			count++;
		}
		d++;
	}
	count
}
