expect: => i=2 r=0.0 ok=true s="dropped tally between: 2" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var w = 0;
	for i in g.n {
		let target = g.res[i];
		var tally = 0;
		for j in g.n {
			if g.res[j] == target { tally++; }
		}
		if !(tally >= lo && tally <= hi) {
			g.res[w] = target;
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped tally between: ", dropped);
	out
}
@end
