	let l = ${low};
	let h = ${high};
	var shifts = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s >= l && s <= h {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			shifts++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted ", shifts, " pairs between bounds");
