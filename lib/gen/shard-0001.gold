fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap_lim = ${max_gap};
	var clamped = 0;
	if g.n > 1 {
		var i = g.n - 1;
		while i > 0 {
			let diff = g.res[i] - g.res[i - 1];
			if diff > gap_lim {
				g.res[i - 1] = g.res[i] - gap_lim;
				clamped++;
			}
			i--;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped gaps in reverse count=", clamped);
	out
}
@end
