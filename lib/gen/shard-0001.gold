fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		out.s.append("no middle elements");
		return out;
	}
	var all_pos = true;
	for k in 1..g.n - 1 {
		if g.res[k] <= 0 { all_pos = false; break; }
	}
	g.steps += g.n;
	out.ok = all_pos;
	out.i = if all_pos { 1 } else { 0 };
	out.s.clear();
	if all_pos {
		out.s.append("middle elements all positive");
	} else {
		out.s.append("middle elements contain non positive");
	}
	out
}
@end
