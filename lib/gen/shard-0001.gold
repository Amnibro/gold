kind: step
verb: join
noun: primes
modifier: until
context: loop
phrase: join prime numbers until count reaches {max_primes}
phrase: accumulate primes in loop up to {max_primes} items
slot: max_primes int
test: list=2,3,4,5,6,7 max_primes=3
expect: => i=10 r=0.0 ok=true s="joined 3 primes with sum 10" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=4,6,8 max_primes=2
expect: => i=0 r=0.0 ok=true s="joined 0 primes with sum 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_primes};
	var primes_sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				primes_sum += x;
				count++;
				if count == lim { break; }
			}
		}
	}
	g.steps += g.n;
	out.i = primes_sum;
	out.s.clear();
	format(out.s, "joined ", count, " primes with sum ", primes_sum);
	out
}
@end
