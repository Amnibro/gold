	let th = ${threshold};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= th {
			g.res[kept] = x;
			gold_cache_put(g, kept, x);
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	if kept == 0 {
		gold_fail(g, "no items met threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no items met threshold");
		return out;
	}
	out.s.clear();
	format(out.s, "filtered ", kept, " numbers from tail");
	out
}
