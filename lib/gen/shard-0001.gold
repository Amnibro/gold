fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var found = false;
	for i in g.n {
		if ${target}(g.res[i]) {
			found = true;
			break;
		}
		count++;
	}
	if !found {
		gold_fail(g, "target condition never reached");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target condition never reached");
		return out;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped counter until target: ", count);
	out
}
@end
