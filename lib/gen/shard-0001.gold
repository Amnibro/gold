code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid digit limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	var count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var digits = 0;
		if x == 0 { digits = 1; }
		while x > 0 { digits++; x /= 10; }
		if digits <= lim {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "traced ", count, " items with digits under limit");
	out
}
@end
