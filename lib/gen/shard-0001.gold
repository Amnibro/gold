test: list=1,2,3,4 size=3 limit=8
expect: => i=2 r=0.0 ok=true s="normalized 2 windows" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	let lim = ${limit};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	let windows = g.n - w + 1;
	for i in windows {
		var total = 0;
		for j in w {
			total += g.res[i + j];
		}
		if total > lim {
			total = lim;
		}
		g.res[i] = total;
	}
	g.steps += windows * w;
	g.n = windows;
	out.i = windows;
	out.s.clear();
	format(out.s, "normalized ", windows, " windows");
	out
}
@end
