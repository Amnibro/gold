code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${step_size};
	if g.n == 0 || d <= 0 { return out; }
	var added = 0;
	var cur = g.res[0];
	while cur + d <= g.res[g.n - 1] && g.n < 512 {
		cur += d;
		gold_push(g, cur);
		added++;
	}
	g.steps += added + 1;
	out.i = added;
	out.s.clear();
	format(out.s, "gaps filled with retry: ", added);
	out
}
@end
