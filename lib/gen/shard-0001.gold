code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	if g.n == 0 || limit <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var w = 1;
	var run_len = 1;
	var idx = 1;
	while idx < g.n {
		if g.res[idx] == g.res[idx - 1] {
			run_len++;
		} else {
			run_len = 1;
		}
		if run_len <= limit {
			g.res[w] = g.res[idx];
			w++;
		}
		idx++;
	}
	let truncated = g.n - w;
	g.n = w;
	out.i = truncated;
	out.s.clear();
	format(out.s, "capped runs truncated=", truncated);
	out
}
@end
