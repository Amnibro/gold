code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_val};
	var has_dupe = false;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] && g.res[i] < cap {
				has_dupe = true;
				break;
			}
			j++;
		}
		if has_dupe { break; }
		i++;
	}
	var swaps = 0;
	if has_dupe && g.n > 1 {
		var a = 0;
		while a < g.n {
			var b = 0;
			while b < g.n - 1 - a {
			if g.res[b] > g.res[b + 1] {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
				swaps++;
			}
			b++;
			}
			a++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted duplicates safely swaps=", swaps);
	out
}
@end
@entry 9573ee9e7207b082
kind: step
verb: apply
noun: digits
modifier: up_to
context: compare
phrase: apply digits up to bound {cap} using {transform}
phrase: transform digits compared up to {cap} with {transform}
phrase: modify digits up to maximum {cap} through {transform}
slot: cap int
slot: transform fn
test: input=3824 cap=3 transform=double
expect: => i=6844 r=0.0 ok=true s="applied transform up to cap modified=2" errors=0 n=0 res=[] cache=0 hits=0
test: input=195 cap=5 transform=triple
expect: => i=395 r=0.0 ok=true s="applied transform up to cap modified=2" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var x = if out.i < 0 { -out.i } else { out.i };
	var d = [0; 20];
	var len = 0;
	if x == 0 { d[0] = 0; len = 1; }
	else {
		while x > 0 && len < 20 {
			d[len] = x % 10;
			len++;
			x /= 10;
		}
	}
	var modified = 0;
	var i = 0;
	while i < len {
		if d[i] <= limit {
			d[i] = ${transform}(d[i]) % 10;
			modified++;
		}
		i++;
	}
	var res = 0;
	var p = len - 1;
	while p >= 0 {
		res = res * 10 + d[p];
		p--;
	}
	out.i = if v.i < 0 { -res } else { res };
	out.s.clear();
	format(out.s, "applied transform up to cap modified=", modified);
	out
}
@end
