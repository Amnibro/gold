phrase: tally any gaps exceeding {min_gap}
phrase: record any gaps larger than {min_gap}
slot: min_gap int
test: list=1,10,12,30 min_gap=5
expect: => i=2 r=0.0 ok=true s="counted 2 gaps" errors=0 n=4 res=[1,10,12,30] cache=0 hits=0
test: list=5,8,11,14 min_gap=4
expect: => i=0 r=0.0 ok=true s="counted 0 gaps" errors=0 n=4 res=[5,8,11,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for gaps");
		return out;
	}
	var count = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > mg { count++; }
	}
	g.steps += g.n - 1;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " gaps");
	out
}
@end
@entry f9ba225c629113e2
kind: step
verb: select
noun: maximum
modifier: up_to
context: stats
phrase: select maximum values up to {limit}
phrase: keep largest observations up to {limit}
phrase: take peak values up to {limit}
slot: limit int
test: list=12,5,40,25,8 limit=3
expect: => i=3 r=0.0 ok=true s="selected 3 maximum items" errors=0 n=3 res=[40,25,12] cache=0 hits=0
test: list=7,15,3 limit=1
expect: => i=1 r=0.0 ok=true s="selected 1 maximum items" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 || g.n == 0 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "selected 0 items");
		return out;
	}
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	let kept = if lim < g.n { lim } else { g.n };
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " maximum items");
	out
}
@end
