	var out = v;
	var is_unique = true;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] { is_unique = false; break; }
		}
		if !is_unique { break; }
	}
	out.ok = is_unique;
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
