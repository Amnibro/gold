@entry bc353243f03b1488
kind: step
verb: select
noun: duplicates
modifier: recursively
context: aggregate
phrase: select duplicates recursively across aggregate results
phrase: recursively find duplicate items into aggregate list
phrase: gather duplicate values recursively for aggregate
test: list=1,2,2,3,4,4,4
expect: => i=6 r=0.0 ok=true s="selected 2 duplicate values with sum 6" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=5,6,5,7,8,7
expect: => i=12 r=0.0 ok=true s="selected 2 duplicate values with sum 12" errors=0 n=2 res=[5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var seen = false;
			for k in kept {
				if g.res[k] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
				total += x;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "selected ", kept, " duplicate values with sum ", total);
	out
}
@end
