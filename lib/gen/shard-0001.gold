fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_val = ${min_val};
	var clamped = 0;
	for k in g.n {
		if g.res[k] < floor_val {
			g.res[k] = floor_val;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " values");
	out
}
@end
