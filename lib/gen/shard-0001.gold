@entry 3284d642c07fc4ae
kind: step
verb: scale
noun: series
modifier: unique
context: aggregate
phrase: scale unique series elements by factor {factor}
phrase: multiply unique series values by {factor} for aggregate
phrase: aggregate unique series scaled by factor {factor}
slot: factor int
test: list=2,2,3,4,3 factor=5
expect: => i=45 r=0.0 ok=true s="scaled 3 unique series elements sum to 45" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,1,2,2 factor=10
expect: => i=30 r=0.0 ok=true s="scaled 2 unique series elements sum to 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var total = 0;
	let mul = ${factor};
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x * mul { seen = true; break; }
		}
		if !seen {
			let val = x * mul;
			g.res[kept] = val;
			kept++;
			total += val;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled ", kept, " unique series elements sum to ", total);
	out
}
@end
