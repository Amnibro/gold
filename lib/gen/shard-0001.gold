code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var unique_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			sum += x;
			unique_cnt++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "unique aggregate sum=", sum);
	out
}
@end
