slot: chunk_size int
test: list=1,2,3,4,5,6 chunk_size=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 chunk_size=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 { return out; }
	var chunks int[512] = [0; 512];
	var cn = 0;
	var i = 0;
	while i < g.n {
		var s = 0;
		var k = 0;
		while k < sz && i + k < g.n {
			s += g.res[i + k];
			k++;
		}
		chunks[cn] = s;
		cn++;
		i += sz;
	}
	gold_clear(g);
	for k in cn { gold_push(g, chunks[k]); }
	out.i = cn;
	g.steps += g.n + 1;
	out
}
@end
