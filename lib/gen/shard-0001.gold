test: text="banana fig cherry apple"
expect: => i=4 r=0.0 ok=true s="sorted 4 words by length" errors=0 n=4 res=[3,5,6,6] cache=0 hits=0
test: text="dog elephant cat ant"
expect: => i=4 r=0.0 ok=true s="sorted 4 words by length" errors=0 n=4 res=[3,3,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_lens int[64] = [0; 64];
	var num_words = 0;
	var cur_len = 0;
	for b in out.s {
		if b == ' ' {
			if cur_len > 0 && num_words < 50 {
				word_lens[num_words] = cur_len;
				num_words++;
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 && num_words < 50 {
		word_lens[num_words] = cur_len;
		num_words++;
	}
	var i = 0;
	while i < num_words {
		var j = i + 1;
		while j < num_words {
			if word_lens[i] > word_lens[j] {
				let tmp = word_lens[i];
				word_lens[i] = word_lens[j];
				word_lens[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in num_words { g.res[k] = word_lens[k]; }
	g.n = num_words;
	g.steps += num_words * 2 + 1;
	out.i = num_words;
	out.s.clear();
	format(out.s, "sorted ", num_words, " words by length");
	out
}
@end
