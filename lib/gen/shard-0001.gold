		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		i = j;
	}
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	if runs >= lo && runs <= hi {
		out.ok = true;
		format(out.s, "validated runs between specified bounds");
	} else {
		gold_fail(g, "run count outside bounds");
		out.ok = false;
		format(out.s, "error: run count outside bounds");
	}
	out
}
