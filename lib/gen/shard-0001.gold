modifier: running
context: transform
phrase: merge odd numbers into cumulative running sums
phrase: replace odd items with running cumulative sum
phrase: transform sequence with running sum of odd values
test: list=1,2,3,4,5
expect: => i=9 r=0.0 ok=true s="final running odd sum 9" errors=0 n=5 res=[1,2,4,4,9] cache=0 hits=0
test: list=7,8,9,10,11
expect: => i=27 r=0.0 ok=true s="final running odd sum 27" errors=0 n=5 res=[7,8,16,10,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			running += g.res[k];
			g.res[k] = running;
		}
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "final running odd sum ", running);
	out
}
@end
