@entry d883424ed9d9a7bf
kind: step
verb: sort
noun: primes
modifier: with_retry
context: cache
phrase: sort cached primes with retry limit {retries}
phrase: order prime numbers using cache with retry {retries}
phrase: sort primes recorded in cache with retry count {retries}
slot: retries int
test: list=7,2,5 retries=5
expect: => i=3 r=0.0 ok=true s="sorted 3 primes with retry limit" errors=0 n=3 res=[2,5,7] cache=3 hits=0
test: list=4,6,8 retries=2
expect: => i=0 r=0.0 ok=true s="sorted 0 primes with retry limit" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var primes int[512] = [0; 512];
	var p_count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, x, 1);
			primes[p_count] = x;
			p_count++;
		}
	}
	for i in p_count {
		var min_idx = i;
		for j in (i + 1)..p_count {
			if primes[j] < primes[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = primes[i];
			primes[i] = primes[min_idx];
			primes[min_idx] = tmp;
		}
	}
	for k in p_count { g.res[k] = primes[k]; }
	g.n = p_count;
	g.steps += p_count + max_r;
	out.i = p_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", p_count, " primes with retry limit");
	out
}
@end
