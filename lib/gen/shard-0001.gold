@entry 26091d65032ff36d
kind: step
verb: limit
noun: series
modifier: recursively
context: compare
phrase: limit series recursively to ceiling {ceiling}
phrase: recursively constrain series under {ceiling}
phrase: enforce series limit recursively against {ceiling}
slot: ceiling int
test: list=10,80,20 ceiling=40
expect: => i=6 r=0.0 ok=true s="limited series recursively reductions=6" errors=0 n=3 res=[10,40,20] cache=0 hits=0
test: list=50,15 ceiling=20
expect: => i=5 r=0.0 ok=true s="limited series recursively reductions=5" errors=0 n=2 res=[20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var reductions = 0;
	var changed = true;
	while changed && reductions < 50 {
		changed = false;
		var max_val = ceil;
		var max_idx = -1;
		var i = 0;
		while i < g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
				max_idx = i;
			}
			i++;
		}
		if max_idx >= 0 {
			g.res[max_idx] = (g.res[max_idx] + ceil) / 2;
			if g.res[max_idx] >= max_val { g.res[max_idx] = max_val - 1; }
			reductions++;
			changed = true;
		}
	}
	out.i = reductions;
	out.s.clear();
	format(out.s, "limited series recursively reductions=", reductions);
	out
}
@end
