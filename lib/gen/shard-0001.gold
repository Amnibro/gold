expect: => i=0 r=0.0 ok=true s="swapped results each 0 pairs" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > lim && g.res[i + 1] <= lim {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped results each ", swaps, " pairs");
	out
}
@end
