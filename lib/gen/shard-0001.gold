fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fv = ${fill_val};
	var dups = 0;
	for i in g.n {
		for j in i {
			if g.res[i] == g.res[j] {
				g.res[i] = fv;
				dups++;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "filled ", dups, " duplicates in place");
	out
}
