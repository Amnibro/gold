	let lim = ${bound};
	var paired = 0;
	var new_n = 0;
	var new_res int[512] = [0; 512];
	var i = 0;
	while i + 1 < g.n && paired < lim {
		new_res[new_n] = g.res[i] + g.res[i + 1];
		new_n++;
		paired++;
		i += 2;
	}
	while i < g.n {
		new_res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = paired;
	out.s.clear();
	format(out.s, "formed ", paired, " pairs up to limit");
	out
}
