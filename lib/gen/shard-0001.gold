@entry ded27d0450307580
kind: step
verb: cache
noun: budget
modifier: at_most
context: sort
phrase: cache budget at most cumulative cost
phrase: store elements within sum budget {budget}
slot: budget int
test: list=2,4,6,8 budget=7
expect: => i=2 r=0.0 ok=true s="elements cached within budget: 2" errors=0 n=4 res=[2,4,6,8] cache=2 hits=0
test: list=1,2,3 budget=10
expect: => i=3 r=0.0 ok=true s="elements cached within budget: 3" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var cached = 0;
	var i = 0;
	while i < g.n && running + g.res[i] <= b {
		running += g.res[i];
		gold_cache_put(g, i, g.res[i]);
		cached++;
		i++;
	}
	g.steps += i;
	out.i = cached;
	out.s.clear();
	format(out.s, "elements cached within budget: ", cached);
	out
}
@end
