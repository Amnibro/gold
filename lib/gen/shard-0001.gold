code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${val};
	var c = 0;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] == g.res[i] {
				g.res[j] = rep;
				c++;
			}
		}
	}
	out.i = c;
	g.steps += g.n * g.n;
	out
}
@end
