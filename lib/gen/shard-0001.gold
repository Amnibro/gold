@entry 5407bd9b284db2a9
kind: step
verb: collect
noun: vowels
modifier: in_reverse
context: compare
phrase: collect vowels in reverse order from text
phrase: extract vowel characters backward
test: text="hello world"
expect: => i=3 r=0.0 ok=true s="ooe" errors=0 n=0 res=[] cache=0 hits=0
test: text="apple"
expect: => i=2 r=0.0 ok=true s="ea" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200] = "";
	var i = out.s.len;
	while i > 0 {
		i--;
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		   c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' {
			if vowels.len < 200 { vowels.push(c); }
		}
	}
	out.s.clear();
	for b in vowels { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
