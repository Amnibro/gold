expect: => i=3 r=0.0 ok=true s="normalized squares with retry count=3" errors=0 n=3 res=[4,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_val};
	for k in g.n {
		var sq = g.res[k] * g.res[k];
		var retries = 0;
		while sq > cap && retries < 10 {
			sq /= 2;
			retries++;
		}
		g.res[k] = sq;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized squares with retry count=", g.n);
	out
}
@end
@entry b62d5d2da3f89294
kind: step
verb: retry
noun: sequence
modifier: up_to
context: core
phrase: retry sequence up_to {max_tries} times until {goal}
phrase: repeat sequence up_to {max_tries} checking {goal}
phrase: retry sequence loop up_to {max_tries} reaching {goal}
slot: max_tries int
slot: goal pred
test: input=6 max_tries=5 goal=is_one
expect: => i=8 r=0.0 ok=false s="retry sequence reached limit 5" errors=0 n=5 res=[3,10,5,16,8] cache=0 hits=0
test: input=3 max_tries=10 goal=over_100
expect: => i=1 r=0.0 ok=false s="retry sequence reached limit 10" errors=0 n=10 res=[10,5,16,8,4,2,1,4,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var tries = 0;
	while tries < limit && !${goal}(out.i) {
		out.i = if out.i % 2 == 0 { out.i / 2 } else { 3 * out.i + 1 };
		gold_push(g, out.i);
		tries++;
	}
	g.steps += tries;
	out.ok = ${goal}(out.i);
	out.s.clear();
	if out.ok {
		format(out.s, "retry sequence succeeded in ", tries, " tries");
	} else {
		format(out.s, "retry sequence reached limit ", limit);
	}
	out
}
@end
