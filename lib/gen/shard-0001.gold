@entry f89468e3c969af1c
kind: step
verb: apply
noun: runs
modifier: in_place
context: cache
phrase: apply runs compression in place for cache
phrase: compact consecutive runs in place within cache
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="applied consecutive runs in place: 3" errors=0 n=6 res=[1,1,2,2,2,3] cache=3 hits=0
test: list=5,6,7
expect: => i=3 r=0.0 ok=true s="applied consecutive runs in place: 3" errors=0 n=3 res=[5,6,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var runs = 0;
	var cur_run = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_run++;
		} else {
			gold_cache_put(g, runs, cur_run);
			runs++;
			cur_run = 1;
		}
		i++;
	}
	gold_cache_put(g, runs, cur_run);
	runs++;
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "applied consecutive runs in place: ", runs);
	out
}
@end
