@entry 57a9619266bc340d
kind: step
verb: keep
noun: digits
modifier: with_cache
context: filter
phrase: keep digits with_cache even values
phrase: filter even digits with cache lookup
phrase: retain even digits caching transformed numbers
test: list=243,243,18
expect: => i=1 r=0.0 ok=true s="kept digits with cache hits=1" errors=0 n=3 res=[24,24,8] cache=2 hits=1
test: list=72,72,72
expect: => i=2 r=0.0 ok=true s="kept digits with cache hits=2" errors=0 n=3 res=[2,2,2] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			var n = if x < 0 { -x } else { x };
			var d_res = 0;
			var mul = 1;
			while n > 0 {
				let d = n % 10;
				if d % 2 == 0 {
					d_res += d * mul;
					mul *= 10;
				}
				n /= 10;
			}
			gold_cache_put(g, x, d_res);
			g.res[i] = d_res;
		}
	}
	out.i = g.hits;
	out.s.clear();
	format(out.s, "kept digits with cache hits=", g.hits);
	out
}
@end
