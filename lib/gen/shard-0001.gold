kind: step
verb: sort
noun: errors
modifier: times
context: retry
phrase: sort errors times limit {rounds}
phrase: order error codes over {rounds} passes
slot: rounds int
test: list=5,3,1,4 rounds=1
expect: => i=3 r=0.0 ok=true s="error sort passes: 1" errors=0 n=4 res=[3,1,4,5] cache=0 hits=0
test: list=5,3,1,4 rounds=3
expect: => i=1 r=0.0 ok=true s="error sort passes: 3" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var pass = 0;
	while pass < r && pass < g.n {
		for i in 0..(g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
		pass++;
	}
	g.steps += pass * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "error sort passes: ", pass);
	out
}
@end
