fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var diffs int[512] = [0; 512];
	var dn = 0;
	var total = 0;
	for i in g.n - 1 {
		let d = g.res[i + 1] - g.res[i];
		diffs[dn] = d;
		dn++;
		total += d;
	}
	gold_clear(g);
	for i in dn { gold_push(g, diffs[i]); }
	out.i = total;
	g.steps += g.n + 1;
	out
}
@end
