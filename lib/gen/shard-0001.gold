slot: limit int
test: list=1,2,1,2,1 limit=5
expect: => i=1 r=0.0 ok=true s="measured loop cycle length=2" errors=0 n=5 res=[1,2,1,2,1] cache=0 hits=0
test: list=1,2,3,4 limit=5
expect: => i=0 r=0.0 ok=false s="no loop detected" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var found = false;
	var cycle_len = 0;
	if g.n >= 4 {
		for len in 1..(g.n / 2 + 1) {
			var matches = true;
			for k in len {
				if g.res[k] != g.res[k + len] {
					matches = false;
					break;
				}
			}
			if matches {
				found = true;
				cycle_len = len;
				break;
			}
		}
	}
	g.steps += lim;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found {
		format(out.s, "measured loop cycle length=", cycle_len);
	} else {
		out.s.append("no loop detected");
	}
	out
}
@end
