@entry b786dc554286fec5
kind: step
verb: join
noun: threshold
modifier: while
context: list
phrase: join elements while sum under threshold {threshold}
phrase: accumulate items while below threshold {threshold}
phrase: sum sequence while within threshold {threshold}
slot: threshold int
test: list=10,20,30,40 threshold=50
expect: => i=30 r=0.0 ok=true s="joined 2 items under threshold" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,5,5 threshold=12
expect: => i=10 r=0.0 ok=true s="joined 2 items under threshold" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 {
		gold_fail(g, "no items to join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var sum = 0;
	var kept = 0;
	for k in g.n {
		if sum + g.res[k] <= thresh {
			sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined ", kept, " items under threshold");
	out
}
@end
