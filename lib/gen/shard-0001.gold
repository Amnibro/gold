	var out = v;
	let tgt = ${target};
	var count = 0;
	while count < tgt {
		count++;
		gold_cache_put(g, 0, count);
	}
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "repeated cache counter until target");
	out
}
@end
@entry cc70f266cee57a47
kind: step
verb: trace
noun: maximum
modifier: between
context: cache
phrase: trace maximum cached value between index {start} through {end_pos}
phrase: find maximum in cache between positions {start} through {end_pos}
phrase: record maximum value between {start} through {end_pos} in cache
slot: start int
slot: end_pos int
test: list=10,50,30,20 start=0 end_pos=2
expect: => i=50 r=0.0 ok=true s="traced maximum value in range into cache" errors=0 n=4 res=[10,50,30,20] cache=1 hits=0
test: list=5,15,8 start=1 end_pos=2
expect: => i=15 r=0.0 ok=true s="traced maximum value in range into cache" errors=0 n=3 res=[5,15,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end_pos};
	if g.n == 0 || s < 0 || s >= g.n || e < s {
		gold_fail(g, "invalid bounds for maximum trace");
		out.ok = false;
		out.i = 0;
		return out;
	}
	let limit = if e < g.n { e + 1 } else { g.n };
	var max_val = g.res[s];
	for k in s..limit {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	gold_cache_put(g, 0, max_val);
	g.steps += limit - s;
	out.i = max_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "traced maximum value in range into cache");
	out
}
@end
@entry b940c8d57c89dc8e
kind: step
verb: sort
noun: streak
modifier: up_to
context: cache
phrase: sort cached streaks up to length {max_len}
phrase: order streaks in cache up to size {max_len}
phrase: sort values in cached streaks up to {max_len}
slot: max_len int
test: list=30,10,20 max_len=2
expect: => i=2 r=0.0 ok=true s="sorted streak up to limit into cache" errors=0 n=3 res=[10,30,20] cache=2 hits=0
test: list=9,4,1 max_len=3
expect: => i=3 r=0.0 ok=true s="sorted streak up to limit into cache" errors=0 n=3 res=[1,4,9] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	let count = if g.n < lim { g.n } else { lim };
	for i in count {
		var min_idx = i;
		for j in (i + 1)..count {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for k in count {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += count * count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted streak up to limit into cache");
	out
}
@end
