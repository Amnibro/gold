kind: step
verb: scale
noun: letters
modifier: sorted
context: text
phrase: scale letters sorted by factor {factor}
phrase: multiply sorted letter counts by {factor}
phrase: scale sorted letter values with {factor}
slot: factor int
test: text="cab" factor=2
