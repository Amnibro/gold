phrase: remove consecutive streak in_place of {target}
phrase: eliminate streak in_place for {target}
slot: target int
test: list=1,2,2,2,3,4 target=2
expect: => i=3 r=0.0 ok=true s="dropped streak in place items=3" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=5,5,6,7,5 target=5
expect: => i=2 r=0.0 ok=true s="dropped streak in place items=2" errors=0 n=3 res=[6,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var dropped = 0;
	var i = 0;
	while i < g.n {
		let start = i;
		let val = g.res[i];
		while i < g.n && g.res[i] == val {
			i++;
		}
		let run_len = i - start;
		if val == tgt && run_len > 1 {
			dropped += run_len;
		} else {
			for j in start..i {
				new_res[new_n] = g.res[j];
				new_n++;
			}
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped streak in place items=", dropped);
	out
}
@end
