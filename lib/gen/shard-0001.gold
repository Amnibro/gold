	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	let pass = ${p}(last_val);
	g.steps += 1;
	out.ok = pass;
	out.i = if pass { 1 } else { 0 };
	out.s.clear();
	if pass {
		format(out.s, "last element satisfied condition");
	} else {
		format(out.s, "last element failed condition");
	}
	out
}
@end
