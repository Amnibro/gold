fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tail_count = 0;
	var idx = g.n - 1;
	while idx >= 0 && ${pred_op}(g.res[idx]) {
		tail_count++;
		idx--;
	}
	let start = g.n - tail_count;
	for k in tail_count {
		g.res[k] = g.res[start + k];
	}
	g.steps += g.n;
	g.n = tail_count;
	out.i = tail_count;
	out.s.clear();
	format(out.s, "selected tail while predicate held count ", tail_count);
	out
}
@end
