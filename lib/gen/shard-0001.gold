fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_chars};
	var u byte[256] = [0; 256];
	var un = 0;
	for b in out.s {
		var seen = false;
		for j in un { if u[j] == b { seen = true; break; } }
		if !seen && un < limit {
			u[un] = b;
			un++;
		}
	}
	out.s.clear();
	for k in un { out.s.push(u[k]); }
	g.steps += out.s.len + un;
	out.i = un;
	out
}
