expect: => i=1 r=0.0 ok=true s="kept 1 unique values in sequence" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " unique values in sequence");
	out
}
@end
@entry ba02736db91c2001
kind: step
verb: rotate
noun: history
modifier: sorted
context: stats
phrase: rotate history by {shift} after sorted order
phrase: rotate sorted history sample by offset {shift}
phrase: order distribution sorted with cyclic rotation {shift}
slot: shift int
test: list=50,10,40,20,30 shift=2
expect: => i=2 r=0.0 ok=true s="sorted and rotated history by 2" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=10,20 shift=-1
expect: => i=0 r=0.0 ok=false s="error: negative shift" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n < 2 {
		gold_fail(g, "sample too small to rotate");
		out.ok = false;
		return out;
	}
	if sh < 0 {
		gold_fail(g, "shift must be non-negative");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative shift");
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	let k = sh % g.n;
	var tmp int[512] = [0; 512];
	for i in g.n {
		let target_idx = (i + k) % g.n;
		tmp[target_idx] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n * 2;
	out.i = k;
	out.s.clear();
	format(out.s, "sorted and rotated history by ", k);
	out
}
@end
