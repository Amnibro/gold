fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		let mean = sum / g.n;
		for i in g.n { g.res[i] = g.res[i] - mean; }
		out.i = mean;
	}
	g.steps += g.n;
	out
}
