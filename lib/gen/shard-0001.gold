fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	var fail_pos = 0;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] < g.res[i - 1] {
				valid = false;
				fail_pos = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = g.n;
	out.s.clear();
	if valid {
		format(out.s, "validated increasing series size=", g.n);
	} else {
		format(out.s, "invalid series at position ", fail_pos);
	}
	out
}
@end
