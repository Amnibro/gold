noun: list
modifier: unique
context: aggregate
phrase: scale unique list values by multiplier {mul}
phrase: multiply unique list elements by {mul} for aggregate
phrase: aggregate unique list values scaled by {mul}
slot: mul int
test: list=2,2,3,4,3 mul=3
expect: => i=27 r=0.0 ok=true s="scaled 3 unique values with total 27" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=5,5,10 mul=2
expect: => i=30 r=0.0 ok=true s="scaled 2 unique values with total 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mul};
	var kept = 0;
	var total = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x * m { seen = true; break; }
		}
		if !seen {
			let val = x * m;
			g.res[kept] = val;
			kept++;
			total += val;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled ", kept, " unique values with total ", total);
	out
}
@end
