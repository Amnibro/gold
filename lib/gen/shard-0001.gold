	var u int[256] = [0; 256];
	var un = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in un { if u[j] == x { seen = true; break; } }
		if !seen && un < 256 {
			u[un] = x;
			un++;
		}
	}
	var new_n = 0;
	var new_res int[512] = [0; 512];
	for r in rep {
		for j in un {
			if new_n < 512 {
				new_res[new_n] = u[j];
				new_n++;
			}
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "repeated unique sequence ", rep, " times to ", new_n, " items");
	out
}
@end
