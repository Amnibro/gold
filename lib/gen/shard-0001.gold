phrase: scale values with_cache by factor {factor}
phrase: multiply values caching results with factor {factor}
phrase: scale all items by {factor} with cache
slot: factor int
test: list=3,4,3,5 factor=2
expect: => i=1 r=0.0 ok=true s="scaled with cache hits=1" errors=0 n=4 res=[6,8,6,10] cache=3 hits=1
test: list=6,6,6 factor=3
expect: => i=2 r=0.0 ok=true s="scaled with cache hits=2" errors=0 n=3 res=[18,18,18] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let val = x * mult;
			gold_cache_put(g, x, val);
			g.res[i] = val;
		}
	}
	out.i = g.hits;
	out.s.clear();
	format(out.s, "scaled with cache hits=", g.hits);
	out
}
@end
