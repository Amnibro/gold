@entry 41b0eb1c8187195b
kind: step
verb: drop
noun: memo
modifier: between
context: text
phrase: drop memo items between bounds {low} to {high}
phrase: remove memo entries between range {low} through {high}
phrase: delete memo values falling between {low} with {high}
slot: low int
slot: high int
test: list=5,15,25,35 low=10 high=30
expect: => i=2 r=0.0 ok=true s="dropped 2 memo entries between bounds" errors=0 n=4 res=[5,15,25,35] cache=2 hits=0
test: list=1,2,3 low=10 high=20
expect: => i=0 r=0.0 ok=true s="dropped 0 memo entries between bounds" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	for k in g.n {
		gold_cache_put(g, g.res[k], g.res[k]);
	}
	var kept = 0;
	var dropped = 0;
	for i in g.cn {
		let k = g.ck[i];
		if k >= lo && k <= hi {
			dropped++;
		} else {
			g.ck[kept] = g.ck[i];
			g.cv[kept] = g.cv[i];
			kept++;
		}
	}
	g.cn = kept;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " memo entries between bounds");
	out
}
@end
