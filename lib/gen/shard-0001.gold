kind: step
verb: dedupe
noun: maximum
modifier: each
context: math
phrase: dedupe each value up to maximum {limit}
phrase: retain at most {limit} copies of each value
phrase: prune occurrences of each value beyond maximum {limit}
slot: limit int
test: list=4,4,4,2,2,7 limit=2
expect: => i=5 r=0.0 ok=true s="deduped to 5 items" errors=0 n=5 res=[4,4,2,2,7] cache=0 hits=0
test: list=9,9,9,9,1,1 limit=1
expect: => i=2 r=0.0 ok=true s="deduped to 2 items" errors=0 n=2 res=[9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_copies = ${limit};
	if max_copies <= 0 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "cleared all values");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < max_copies {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " items");
	out
}
@end
