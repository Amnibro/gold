expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = ${low};
	var j = ${high};
	if i < 0 { i = 0; }
	if j >= g.n { j = g.n - 1; }
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
