code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var checked = 0;
	var digit_sum = 0;
	for k in g.n {
		let x = g.res[k];
		if !${cond}(x) { break; }
		var tmp = if x < 0 { -x } else { x };
		while tmp > 0 {
			digit_sum += tmp % 10;
			tmp /= 10;
		}
		checked++;
	}
	g.steps += g.n;
	out.i = digit_sum;
	out.s.clear();
	format(out.s, "checked ", checked, " items with digit sum ", digit_sum);
	out
}
@end
