code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inversions = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] { inversions++; }
		i++;
	}
	g.steps += g.n;
	out.i = inversions;
	out.ok = (inversions == 0);
	out.s.clear();
	format(out.s, "inversions in pairs: ", inversions);
	out
}
@end
