fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var sum = 0;
	var kept = 0;
	for i in out.s.len {
		let c = out.s[i] as! int;
		if sum + c <= limit {
			sum += c;
			kept++;
		} else {
			break;
		}
	}
	out.s.resize(kept, 0);
	g.steps += out.s.len + kept;
	out.i = sum;
	out
}
