expect: => i=2 r=0.0 ok=false s="error: invalid negative number" errors=1 n=4 res=[4,6,-3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no numbers to validate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var count = 0;
	var found = false;
	for k in g.n {
		let x = g.res[k];
		if x < 0 {
			gold_fail(g, "invalid negative number");
			out.ok = false;
			out.i = count;
			out.s.clear();
			format(out.s, "error: invalid negative number");
			return out;
		}
		count++;
		if ${stop}(x) {
			found = true;
			break;
		}
	}
	g.steps += count;
	out.i = count;
	if !found {
		gold_fail(g, "stop condition not reached");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: stop condition not reached");
		return out;
	}
	out.s.clear();
	format(out.s, "validated ", count, " numbers until stop");
	out
}
@end
