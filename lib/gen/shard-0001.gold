@entry 2a882187adb09513
kind: step
verb: retry
noun: streak
modifier: at_least
context: compare
phrase: retry streak matching at least run length {target_len}
phrase: find contiguous matching streak of at least {target_len}
slot: target_len int
test: list=1,1,1,2,3 target_len=3
expect: => i=1 r=0.0 ok=true s="streak requirement met: true" errors=0 n=5 res=[1,1,1,2,3] cache=0 hits=0
test: list=1,2,2,3 target_len=3
expect: => i=0 r=0.0 ok=false s="streak requirement met: false" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needed = ${target_len};
	var found = false;
	if g.n > 0 {
		var cur_run = 1;
		if cur_run >= needed { found = true; }
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
			} else {
				cur_run = 1;
			}
			if cur_run >= needed { found = true; }
			i++;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "streak requirement met: ", found);
	out
}
@end
