@entry 623123d879dae186
kind: step
verb: shift
noun: values
modifier: unique
context: search
phrase: shift unique search candidates by {offset}
phrase: translate distinct matched items by offset {offset}
slot: offset int
test: list=10,10,20,30,30 offset=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=2,2,4,6,6 offset=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		var dup = false;
		for j in kept {
			if g.res[j] == g.res[i] { dup = true; break; }
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	for i in g.n { g.res[i] += off; }
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
