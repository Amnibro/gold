expect: => i=1 r=0.0 ok=true s="items meeting count: 1" errors=0 n=4 res=[4,4,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${times};
	var matching = 0;
	for i in g.n {
		var is_first = true;
		for j in i {
			if g.res[j] == g.res[i] { is_first = false; break; }
		}
		if is_first {
			var count = 0;
			for j in g.n {
				if g.res[j] == g.res[i] { count++; }
			}
			if count >= req { matching++; }
		}
	}
	g.steps += g.n;
	out.i = matching;
	out.s.clear();
	format(out.s, "items meeting count: ", matching);
	out
}
@end
