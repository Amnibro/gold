slot: limit int
test: list=1,3,3,5,7,7 limit=3
expect: => i=3 r=0.0 ok=true s="limited unique odds to 3 items" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,5,5,9 limit=2
expect: => i=2 r=0.0 ok=true s="limited unique odds to 2 items" errors=0 n=2 res=[5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "no elements to limit odds");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			for j in count {
				if tmp[j] == x { seen = true; break; }
			}
			if !seen && count < lim {
				tmp[count] = x;
				count++;
			}
		}
	}
	for i in count {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited unique odds to ", count, " items");
	out
}
@end
