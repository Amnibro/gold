	for k in out.s.len {
		if count >= max_count { break; }
		if out.s[k] != ' ' { count++; }
	}
	g.steps += count;
	out.i = count;
	out
}
@end
@entry 9b34fca41b877d0c
kind: step
verb: cache
noun: step
modifier: at_least
context: text
phrase: cache step text if length at least {min_len}
phrase: store step in cache with at least {min_len} characters
phrase: record step into cache at least {min_len} bytes
slot: min_len int
test: input=7 text="hello" min_len=3
expect: => i=5 r=0.0 ok=true s="hello" errors=0 n=0 res=[] cache=1 hits=0
test: input=3 text="hi" min_len=5
expect: => i=2 r=0.0 ok=false s="hi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	if req < 0 {
		gold_fail(g, "negative length threshold");
		out.ok = false;
		return out;
	}
	if out.s.len >= req {
		gold_cache_put(g, out.i, out.s.len);
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps++;
	out.i = out.s.len;
	out
}
@end
@entry 5d6c77671734f8d9
