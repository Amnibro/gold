@entry dbcad663f9e796ba
kind: step
verb: rotate
noun: pairs
modifier: times
context: format
phrase: format list after swapping pairs {times} times
phrase: render rotated pair sequence repeated {times} times
phrase: display pair rotation output for {times} iterations
slot: times int
test: list=1,2,3,4 times=1
expect: => i=4 r=0.0 ok=true s="pairs: [2, 1, 4, 3]" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30,40 times=2
expect: => i=4 r=0.0 ok=true s="pairs: [10, 20, 30, 40]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let reps = ${times};
	var out = v;
	out.s.clear();
	var copy int[512] = [0; 512];
	for i in g.n { copy[i] = g.res[i]; }
	for r in reps {
		var k = 0;
		while k + 1 < g.n {
			let t = copy[k];
			copy[k] = copy[k + 1];
			copy[k + 1] = t;
			k += 2;
		}
	}
	format(out.s, "pairs: [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		format(out.s, copy[i]);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += reps * g.n;
	out
}
@end
