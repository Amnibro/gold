phrase: offset quadratic candidate penalties bounded by {cap}
slot: cap int
test: list=2,4,6 cap=25
expect: => i=57 r=0.0 ok=true s="" errors=0 n=3 res=[6,20,31] cache=0 hits=0
test: list=3,5 cap=30
expect: => i=42 r=0.0 ok=true s="" errors=0 n=2 res=[12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	for i in g.n {
		var sq = g.res[i] * g.res[i];
		if sq > limit { sq = limit; }
		g.res[i] += sq;
		sum += g.res[i];
	}
	out.i = sum;
	g.steps += g.n + 1;
	out
}
@end
