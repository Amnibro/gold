@entry 31ed83b4255d9d38
kind: step
verb: split
noun: head
modifier: all
context: math
phrase: split head element into all {parts} pieces
phrase: divide head value across all {parts} slots
phrase: distribute head item into all {parts} portions
slot: parts int
test: list=14,99 parts=3
expect: => i=3 r=0.0 ok=true s="split head into all 3 pieces" errors=0 n=3 res=[5,5,4] cache=0 hits=0
test: list=20 parts=4
expect: => i=4 r=0.0 ok=true s="split head into all 4 pieces" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if g.n == 0 || p <= 0 {
		gold_fail(g, "empty list or invalid parts");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid split parts");
		return out;
	}
	let head_val = g.res[0];
	let base = head_val / p;
	let rem = head_val % p;
	for k in p {
		g.res[k] = if k < rem { base + 1 } else { base };
	}
	g.n = p;
	g.steps += p;
	out.i = p;
	out.s.clear();
	format(out.s, "split head into all ", p, " pieces");
	out
}
@end
