fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dup_pairs = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dup_pairs++;
			}
		}
	}
	g.steps += g.n;
	out.i = dup_pairs;
	out.ok = dup_pairs <= lim;
	out.s.clear();
	format(out.s, "checked ", dup_pairs, " nested duplicates");
	out
}
@end
@entry cab0e938dd82ec67
kind: step
verb: reverse
noun: gaps
modifier: unique
context: transform
phrase: reverse unique gap values using floor {cutoff}
phrase: invert unique gaps exceeding floor {cutoff}
slot: cutoff int
test: list=1,5,12,16 cutoff=2
expect: => i=2 r=0.0 ok=true s="reversed 2 unique gaps" errors=0 n=2 res=[7,4] cache=0 hits=0
test: list=1,2,3 cutoff=5
expect: => i=0 r=0.0 ok=true s="reversed 0 unique gaps" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "reversed 0 unique gaps");
		return out;
	}
	var gaps int[512] = [0; 512];
	var gn = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if diff > cut {
			var exists = false;
			for j in gn {
				if gaps[j] == diff {
					exists = true;
					break;
				}
			}
			if !exists && gn < 512 {
				gaps[gn] = diff;
				gn++;
			}
		}
	}
	for k in gn {
		g.res[k] = gaps[gn - 1 - k];
	}
	g.n = gn;
	g.steps += gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "reversed ", gn, " unique gaps");
	out
}
@end
