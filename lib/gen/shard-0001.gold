noun: results
modifier: between
context: core
phrase: reverse results between indices {low} through {high}
phrase: invert result order from {low} to {high}
slot: low int
slot: high int
test: list=1,2,3,4,5 low=1 high=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
