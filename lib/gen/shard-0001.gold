expect: => i=9 r=0.0 ok=true s="summed streak of 3 items" errors=0 n=3 res=[9,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to sum");
		out.ok = false;
		return out;
	}
	var total = 0;
	var count = 0;
	while count < g.n && ${cond}(g.res[count]) {
		total += g.res[count];
		count++;
	}
	var new_n = 0;
	g.res[new_n] = total;
	new_n++;
	for i in count..g.n {
		g.res[new_n] = g.res[i];
		new_n++;
	}
	g.steps += count;
	g.n = new_n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed streak of ", count, " items");
	out
}
