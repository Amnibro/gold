	var out = v;
	let p = ${pivot};
	var below = 0;
	var above = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < p {
			below++;
		} else {
			above++;
		}
		i++;
	}
	gold_cache_put(g, 0, below);
	gold_cache_put(g, 1, above);
	g.steps += i;
	out.i = below;
	out.s.clear();
	format(out.s, "split items below pivot: ", below);
	out
}
@end
@entry 548c977168e4a209
kind: step
verb: shift
noun: runs
modifier: all
context: cache
phrase: shift all consecutive runs within cache
phrase: rotate run blocks throughout cache
test: list=1,1,2,2,3
expect: => i=3 r=0.0 ok=true s="shifted by total runs: 3" errors=0 n=5 res=[2,3,1,1,2] cache=1 hits=0
test: list=4,5,6
expect: => i=3 r=0.0 ok=true s="shifted by total runs: 3" errors=0 n=3 res=[4,5,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var runs = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[i - 1] {
			runs++;
		}
		i++;
	}
	let shift = runs % g.n;
	var s = 0;
	while s < shift {
		let first = g.res[0];
		var j = 0;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[g.n - 1] = first;
		s++;
	}
	gold_cache_put(g, 0, runs);
	g.steps += i + s * g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "shifted by total runs: ", runs);
	out
}
@end
