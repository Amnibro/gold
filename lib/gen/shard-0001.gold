expect: => i=1 r=0.0 ok=true s="performed 1 swaps until condition" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var swaps = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if ${stop}(a) || ${stop}(b) { break; }
		g.res[i] = b;
		g.res[i + 1] = a;
		swaps++;
		i += 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " swaps until condition");
	out
}
@end
