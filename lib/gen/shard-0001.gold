verb: run
noun: limit
modifier: with_retry
context: list
phrase: run operation {op} with retry up to limit {cap}
phrase: execute {op} with retry under limit {cap}
phrase: apply {op} with retry bounded by limit {cap}
slot: cap int
slot: op fn
test: input=2 cap=20 op=double
expect: => i=32 r=0.0 ok=true s="ran with retry 4 times" errors=0 n=4 res=[4,8,16,32] cache=0 hits=0
test: input=1 cap=5 op=triple
expect: => i=9 r=0.0 ok=true s="ran with retry 2 times" errors=0 n=2 res=[3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var k = 0;
	while out.i < limit {
		out.i = ${op}(out.i);
		gold_push(g, out.i);
		k++;
		if k >= 50 {
			gold_fail(g, "retry limit reached");
			out.ok = false;
			return out;
		}
	}
	g.steps += k;
	out.s.clear();
	format(out.s, "ran with retry ", k, " times");
	out
}
@end
@entry a5fd43a1eb3507cb
kind: step
verb: find
noun: value
modifier: with_retry
context: list
phrase: find value {target} with retry attempts {retries}
phrase: locate value {target} retrying up to {retries} times
phrase: search for value {target} with retry limit {retries}
slot: target int
slot: retries int
test: list=10,20,30 target=20 retries=3
expect: => i=1 r=0.0 ok=true s="found value at index 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,30 target=50 retries=2
expect: => i=-1 r=0.0 ok=false s="search failed after retries" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	if max_r <= 0 || g.n == 0 {
		gold_fail(g, "invalid retries or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid search");
		return out;
	}
	var attempts = 0;
	var found = false;
	var found_idx = -1;
	var cur_target = tgt;
	while attempts < max_r {
		attempts++;
		for k in g.n {
			if g.res[k] == cur_target {
				found = true;
				found_idx = k;
				break;
			}
		}
		if found { break; }
		cur_target++;
	}
	g.steps += attempts;
	out.s.clear();
	if found {
		out.ok = true;
		out.i = found_idx;
		format(out.s, "found value at index ", found_idx);
	} else {
		out.ok = false;
		out.i = -1;
		gold_fail(g, "value not found after retries");
		format(out.s, "search failed after retries");
	}
	out
}
@end
@entry b56d414f3f8fb79b
kind: step
verb: limit
noun: value
modifier: in_reverse
context: list
phrase: limit values in reverse under {cap}
phrase: clamp list items in reverse order to {cap}
phrase: restrict values in reverse below {cap}
slot: cap int
test: list=50,10,60,20 cap=40
expect: => i=2 r=0.0 ok=true s="limited 2 values in reverse" errors=0 n=4 res=[40,10,40,20] cache=0 hits=0
test: list=5,10,15 cap=100
expect: => i=0 r=0.0 ok=true s="limited 0 values in reverse" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 {
		gold_fail(g, "empty list to limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var clamped = 0;
	for i in g.n {
		let idx = g.n - 1 - i;
		if g.res[idx] > limit {
			g.res[idx] = limit;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited ", clamped, " values in reverse");
	out
}
@end
