test: list=5,10 factor=3
expect: => i=0 r=0.0 ok=false s="error: list too small" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 3 {
		gold_fail(g, "sample too small for window");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too small");
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	let count = g.n - 2;
	for k in 1..(g.n - 1) {
		g.res[k] *= f;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " middle items by factor ", f);
	out
}
@end
@entry f557cfa2ea949a86
kind: step
verb: dedupe
noun: minimum
modifier: times
context: sort
phrase: dedupe sorted items repeating minimum {min_reps} times
phrase: collapse sorted duplicates with minimum frequency {min_reps} times
phrase: remove repeated sorted values occurring minimum {min_reps} times
slot: min_reps int
test: list=3,1,3,2,3,2 min_reps=3
expect: => i=1 r=0.0 ok=true s="collapsed 1 duplicate runs" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
test: list=1,2,3 min_reps=0
expect: => i=0 r=0.0 ok=false s="error: invalid minimum repetitions" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_reps};
	if m < 2 {
		gold_fail(g, "min_reps must be at least 2");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid minimum repetitions");
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var tmp int[512] = [0; 512];
	var w = 0;
	var i = 0;
	var collapsed = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= m {
			tmp[w] = g.res[i];
			w++;
			collapsed++;
		} else {
			for k in i..j {
				tmp[w] = g.res[k];
				w++;
			}
		}
		i = j;
	}
	for k in w { g.res[k] = tmp[k]; }
	g.n = w;
	g.steps += g.n;
	out.i = collapsed;
	out.s.clear();
	format(out.s, "collapsed ", collapsed, " duplicate runs");
	out
}
@end
@entry ecb0d295a70879c0
kind: step
verb: count
noun: primes
