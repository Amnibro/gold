		format(out.s, "error: invalid tail length");
		return out;
	}
	let start = g.n - tlen;
	for k in start..g.n {
		g.res[k] *= mult;
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += tlen;
	out.i = tlen;
	out.s.clear();
	format(out.s, "scaled tail of ", tlen, " items");
	out
}
@end
@entry 308d64e2d8e1a90e
kind: step
verb: join
noun: loop
modifier: safely
context: error
phrase: join loop safely with limit {limit}
phrase: safely join loop items under limit {limit}
phrase: process safe loop join bound {limit}
slot: limit int
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="safely joined loop across 2 iterations" errors=0 n=2 res=[60,40] cache=0 hits=0
test: list=10,20 limit=0
expect: => i=0 r=0.0 ok=false s="error: non-positive limit" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid loop limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "insufficient items to join safely");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need multiple items");
		return out;
	}
	var count = 0;
	var i = 0;
	while i < g.n - 1 && count < lim {
		g.res[i] = g.res[i] + g.res[i + 1];
		var j = i + 1;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.n--;
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "safely joined loop across ", count, " iterations");
	out
}
@end
