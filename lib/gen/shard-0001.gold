code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${code};
	var found = -1;
	for k in g.n {
		if g.res[k] == c {
			found = k;
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		gold_push(g, c);
		for i in 0..(g.n - 1) {
			let idx = g.n - 1 - i;
			g.res[idx] = g.res[idx - 1];
		}
		g.res[0] = c;
		format(out.s, "checkpoint first match: ", found);
	} else {
		format(out.s, "no checkpoint found");
	}
	out
}
@end
