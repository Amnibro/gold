@entry d27a639544eaa9d6
kind: step
verb: count
noun: squares
modifier: recursively
context: compare
phrase: count square numbers recursively in results
phrase: tally perfect square values in list
test: list=1,4,9,10,16
expect: => i=4 r=0.0 ok=true s="perfect squares counted: 4" errors=0 n=5 res=[1,4,9,10,16] cache=0 hits=0
test: list=2,3,5
expect: => i=0 r=0.0 ok=true s="perfect squares counted: 0" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq_count++; }
		}
	}
	g.steps += g.n;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "perfect squares counted: ", sq_count);
	out
}
@end
