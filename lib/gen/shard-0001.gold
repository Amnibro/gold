fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	var shifted = 0;
	var i = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		let start = i;
		while i < out.s.len && out.s[i] != ' ' { i++; }
		let wlen = i - start;
		if wlen >= min_l && wlen > 1 {
			var left = start;
			var right = i - 1;
			while left < right {
				let tmp = out.s[left];
				out.s[left] = out.s[right];
				out.s[right] = tmp;
				left++;
				right--;
			}
			shifted++;
		}
	}
	out.i = shifted;
	out
}
@end
@entry aea7932a9225c5aa
kind: step
verb: compare
noun: cache
modifier: with_retry
context: compare
phrase: compare cache with retry for key {key} attempts {retries}
phrase: lookup compare cache key {key} retry limit {retries}
phrase: check cached key {key} with retry count {retries}
slot: key int
slot: retries int
test: list=100,200,300 key=2 retries=2
expect: => i=200 r=0.0 ok=true s="cache hit after 0 retries val=200" errors=0 n=3 res=[100,200,300] cache=3 hits=1
test: list=10,20 key=5 retries=2
expect: => i=0 r=0.0 ok=false s="cache miss for key=5" errors=1 n=2 res=[10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_k = ${key};
	let max_r = ${retries};
	for idx in g.n {
		gold_cache_put(g, idx + 1, g.res[idx]);
	}
	var attempt = 0;
	var found = false;
	var found_val = 0;
	while attempt <= max_r {
		let val, ok = gold_cache_get(g, target_k + attempt);
		if ok {
			found = true;
			found_val = val;
			break;
		}
		attempt++;
	}
	if found {
		out.i = found_val;
		out.ok = true;
		out.s.clear();
		format(out.s, "cache hit after ", attempt, " retries val=", found_val);
	} else {
		gold_fail(g, "cache lookup failed after retries");
		out.ok = false;
		out.s.clear();
		format(out.s, "cache miss for key=", target_k);
	}
	out
}
@end
