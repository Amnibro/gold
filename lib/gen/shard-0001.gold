	var out = v;
	let cut = ${threshold};
	var w = 0;
	for k in g.n {
		let res = ${f}(g.res[k]);
		if res >= cut {
			g.res[w] = res;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "kept outputs at least threshold ", w);
	out
}
@end
