expect: => i=2 r=0.0 ok=true s="dropped 2 history occurrences" errors=0 n=2 res=[200,500] cache=0 hits=0
test: list=200,301 code=404
expect: => i=0 r=0.0 ok=false s="error: code not found" errors=1 n=2 res=[200,301] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${code};
	if target <= 0 {
		gold_fail(g, "invalid error code");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive error code");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty history list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty history");
		return out;
	}
	var dropped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == target {
			var j = i;
			while j < g.n - 1 {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.n--;
			dropped++;
		} else {
			i++;
		}
	}
	g.steps += g.n + dropped;
	out.i = dropped;
	if dropped == 0 {
		gold_fail(g, "target error not found in history");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: code not found");
		return out;
	}
	out.s.clear();
	format(out.s, "dropped ", dropped, " history occurrences");
	out
}
@end
