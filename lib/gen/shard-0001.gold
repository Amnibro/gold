@entry 46eeceb94c5049a5
kind: step
verb: search
noun: cache
modifier: first
context: cache
phrase: search cache first for key {key}
phrase: query cache first looking up key {key}
phrase: lookup key {key} in search cache first
slot: key int
test: list=10,20,30 key=20
expect: => i=1 r=0.0 ok=true s="cached key after search miss" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5 key=99
expect: => i=-1 r=0.0 ok=false s="search cache first failed" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached_val, hit = gold_cache_get(g, k);
	if hit {
		out.i = cached_val;
		out.ok = true;
		out.s.clear();
		format(out.s, "found key in cache with value ", cached_val);
		return out;
	}
	var found = false;
	for i in g.n {
		if g.res[i] == k {
			found = true;
			break;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if found {
		gold_cache_put(g, k, 1);
		out.i = 1;
		out.ok = true;
		format(out.s, "cached key after search miss");
	} else {
		gold_fail(g, "key not found in cache or list");
		out.i = -1;
		out.ok = false;
		format(out.s, "search cache first failed");
	}
	out
}
@end
@entry 981f8903dc3d8ccc
kind: step
verb: validate
noun: pairs
modifier: at_most
context: cache
phrase: validate cached pairs difference at most {max_diff}
phrase: verify cache pairs differing by at most {max_diff}
phrase: check cached pairs bounded by at most {max_diff}
slot: max_diff int
test: list=10,12,15 max_diff=5
expect: => i=2 r=0.0 ok=true s="validated 2 pairs within maximum difference" errors=0 n=3 res=[10,12,15] cache=2 hits=0
test: list=10,20 max_diff=3
expect: => i=1 r=0.0 ok=false s="pair difference exceeded maximum" errors=1 n=2 res=[10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_diff};
	var valid = true;
	var pairs_checked = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let a = g.res[i];
			let b = g.res[i + 1];
			let diff = if b >= a { b - a } else { a - b };
			gold_cache_put(g, i, diff);
			pairs_checked++;
			if diff > limit {
				valid = false;
			}
		}
	}
	g.steps += pairs_checked;
	out.i = pairs_checked;
	out.s.clear();
	if valid {
		out.ok = true;
		format(out.s, "validated ", pairs_checked, " pairs within maximum difference");
	} else {
		gold_fail(g, "pair difference exceeded limit");
		out.ok = false;
		format(out.s, "pair difference exceeded maximum");
	}
	out
}
@end
@entry baa83fe945631de8
kind: step
verb: clamp
noun: average
modifier: in_place
context: cache
phrase: clamp items around cached average in place within {span}
phrase: bound elements to cached average in place by {span}
phrase: clamp values near cached average in place using span {span}
slot: span int
test: list=10,20,30 span=5
expect: => i=20 r=0.0 ok=true s="clamped items around cached average 20" errors=0 n=3 res=[15,20,25] cache=1 hits=0
test: list=5,15 span=2
expect: => i=10 r=0.0 ok=true s="clamped items around cached average 10" errors=0 n=2 res=[8,12] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list for average clamp");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	gold_cache_put(g, 0, avg);
	let lo = avg - s;
	let hi = avg + s;
	for k in g.n {
		if g.res[k] < lo { g.res[k] = lo; }
		else if g.res[k] > hi { g.res[k] = hi; }
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "clamped items around cached average ", avg);
	out
}
@end
