fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	while kept < g.n && g.res[kept] < lim {
		kept++;
	}
	g.steps += kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "items before limit: ", kept);
	out
}
