@entry e8dc1630ba85c8c7
kind: step
verb: dedupe
noun: evens
modifier: every_other
context: retry
phrase: dedupe evens every other retry slot
phrase: remove duplicate even elements at every other index
test: list=2,3,2,5,4,7
expect: => i=5 r=0.0 ok=true s="even deduped count: 5" errors=0 n=5 res=[2,3,5,4,7] cache=0 hits=0
test: list=6,8,6,10
expect: => i=3 r=0.0 ok=true s="even deduped count: 3" errors=0 n=3 res=[6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen_evens int[512] = [0; 512];
	var se_count = 0;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = false;
			for j in se_count {
				if seen_evens[j] == x { seen = true; break; }
			}
			if !seen {
				seen_evens[se_count] = x;
				se_count++;
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "even deduped count: ", kept);
	out
}
@end
