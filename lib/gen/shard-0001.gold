code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty list for normalize average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	let delta = tgt - avg;
	for k in g.n {
		g.res[k] += delta;
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "normalized average from ", avg, " to ", tgt);
	out
}
