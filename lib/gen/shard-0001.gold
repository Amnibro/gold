fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var evens = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			g.res[kept] = x;
			kept++;
		} else {
			evens++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = evens;
	out.s.clear();
	format(out.s, "limited evens removed ", evens);
	out
}
@end
