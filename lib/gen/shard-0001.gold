slot: factor int
test: list=1,2,3,4,6 factor=2
expect: => i=20 r=0.0 ok=true s="scaled last 2 evens with sum 20" errors=0 n=5 res=[1,2,3,8,12] cache=0 hits=0
test: list=8,10,12 factor=5
expect: => i=110 r=0.0 ok=true s="scaled last 2 evens with sum 110" errors=0 n=3 res=[8,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	var scaled_count = 0;
	var total = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] % 2 == 0 {
			g.res[idx] = g.res[idx] * mul;
			scaled_count++;
			total += g.res[idx];
			if scaled_count >= 2 { break; }
		}
		idx--;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled last ", scaled_count, " evens with sum ", total);
	out
}
@end
@entry 6ae41eb6823d286b
kind: step
