code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for pairs");
		return out;
	}
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise differences count ", g.n);
	out
}
@end
