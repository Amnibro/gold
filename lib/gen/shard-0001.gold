test: list=1,2,3,4,5 max_tail=3
expect: => i=3 r=0.0 ok=true s="tail limited to: 3" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20 max_tail=4
expect: => i=2 r=0.0 ok=true s="tail limited to: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tail};
	if g.n > mt {
		let shift = g.n - mt;
		for i in mt {
			g.res[i] = g.res[i + shift];
		}
		g.n = mt;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail limited to: ", g.n);
	out
}
@end
@entry 4f74748e1094464a
kind: step
