slot: limit int
test: list=3,7,2,9 limit=4
expect: => i=4 r=0.0 ok=true s="checked 4 valid digits" errors=0 n=4 res=[3,7,2,9] cache=4 hits=0
test: list=3,15,2 limit=3
expect: => i=15 r=0.0 ok=false s="error: invalid digit" errors=1 n=3 res=[3,15,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid digit check limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results for digit check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let check_cnt = if g.n < lim { g.n } else { lim };
	for k in check_cnt {
		let x = g.res[k];
		if x < 0 || x > 9 {
			gold_fail(g, "non-digit value encountered");
			out.ok = false;
			out.i = x;
			out.s.clear();
			format(out.s, "error: invalid digit");
			return out;
		}
		gold_cache_put(g, x, 1);
	}
	g.steps += check_cnt;
	out.i = check_cnt;
	out.s.clear();
	format(out.s, "checked ", check_cnt, " valid digits");
	out
}
@end
