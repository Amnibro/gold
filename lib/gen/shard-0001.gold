slot: retries int
test: list=3,1,2 retries=5
expect: => i=2 r=0.0 ok=true s="prefix validated sorted after 2 retries" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=9,8,7 retries=1
expect: => i=1 r=0.0 ok=false s="prefix validation failed retries exhausted" errors=1 n=3 res=[8,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var swaps = 0;
	var changed = true;
	while changed && swaps < max_r {
		changed = false;
		if g.n > 1 {
			for i in (g.n - 1) {
				if g.res[i] > g.res[i + 1] {
					let tmp = g.res[i];
					g.res[i] = g.res[i + 1];
					g.res[i + 1] = tmp;
					swaps++;
					changed = true;
					if swaps >= max_r { break; }
				}
			}
		}
	}
	var is_sorted = true;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				is_sorted = false;
				break;
			}
		}
	}
	g.steps += g.n + swaps;
	out.i = swaps;
	out.s.clear();
	if is_sorted {
		out.ok = true;
		format(out.s, "prefix validated sorted after ", swaps, " retries");
	} else {
		gold_fail(g, "prefix invalid after retries");
		out.ok = false;
		format(out.s, "prefix validation failed retries exhausted");
	}
	out
}
@end
@entry 33dab8de51c62317
kind: step
verb: rank
noun: threshold
modifier: unique
context: sort
phrase: compute rank for threshold {threshold} among unique sorted items
phrase: determine position of threshold {threshold} in unique sorted sequence
phrase: find unique sorted rank for threshold {threshold}
slot: threshold int
test: list=10,50,20,50,10,30 threshold=30
expect: => i=2 r=0.0 ok=true s="unique sorted rank for threshold is 2" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=5,15,25 threshold=5
expect: => i=0 r=0.0 ok=true s="unique sorted rank for threshold is 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		if new_n == 0 || new_res[new_n - 1] != g.res[k] {
			new_res[new_n] = g.res[k];
			new_n++;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	var rank = 0;
	for k in g.n {
		if g.res[k] < thresh {
			rank++;
		}
	}
	g.steps += g.n;
	out.i = rank;
	out.s.clear();
	format(out.s, "unique sorted rank for threshold is ", rank);
	out
}
@end
