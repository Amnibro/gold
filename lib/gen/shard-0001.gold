test: list=10,20,15,30,25,40
expect: => i=4 r=0.0 ok=true s="filtered pairwise checkpoints count=4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=50,40,30,20
expect: => i=1 r=0.0 ok=true s="filtered pairwise checkpoints count=1" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "no pairwise filter needed");
		return out;
	}
	var w = 1;
	var idx = 1;
	while idx < g.n {
		if g.res[idx] > g.res[idx - 1] {
			g.res[w] = g.res[idx];
			w++;
		}
		idx++;
	}
	g.n = w;
	out.i = w;
