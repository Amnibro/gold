code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			clamped++;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			clamped++;
		}
	}
	out.i = clamped;
	g.steps += g.n + 1;
	out
}
@end
