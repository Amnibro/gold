code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 && g.n > 0 {
		gold_cache_put(g, g.res[0], 1);
	}
	var kept = 0;
	for i in g.n {
		let _, found = gold_cache_get(g, g.res[i]);
		if found {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "items retained from cache: ", kept);
	out
}
@end
