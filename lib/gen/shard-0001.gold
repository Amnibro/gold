@entry 6a7bff47019124e7
kind: step
verb: map
noun: average
modifier: times
context: core
phrase: map average value {count} times across results
phrase: replace results with average repeated {count} times
phrase: populate results with average repeated {count} times
slot: count int
test: list=10,20,30 count=3
expect: => i=20 r=0.0 ok=true s="mapped average 20 repeated 3 times" errors=0 n=3 res=[20,20,20] cache=0 hits=0
test: list=4,8,12,16 count=2
expect: => i=10 r=0.0 ok=true s="mapped average 10 repeated 2 times" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for average map");
		out.ok = false;
		return out;
	}
	let k = ${count};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	gold_clear(g);
	for step in k {
		gold_push(g, avg);
	}
	g.steps += k;
	out.i = avg;
	out.s.clear();
	format(out.s, "mapped average ", avg, " repeated ", k, " times");
	out
}
@end
