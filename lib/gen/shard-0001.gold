test: list=5,5,1,2,2
expect: => i=3 r=0.0 ok=true s="folded duplicate groups to 3" errors=0 n=3 res=[10,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var temp int[512] = [0; 512];
	var tn = 0;
	var cur_val = g.res[0];
	var cur_sum = cur_val;
	for k in 1..g.n {
		if g.res[k] == cur_val {
			cur_sum += g.res[k];
		} else {
			temp[tn] = cur_sum;
			tn++;
			cur_val = g.res[k];
			cur_sum = cur_val;
		}
	}
	temp[tn] = cur_sum;
	tn++;
	for k in tn { g.res[k] = temp[k]; }
	g.n = tn;
	g.steps += g.n;
	out.i = tn;
	out.s.clear();
	format(out.s, "folded duplicate groups to ", tn);
	out
}
@end
