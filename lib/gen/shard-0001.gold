kind: step
verb: shift
noun: series
modifier: last
context: filter
phrase: shift series keeping last {count} items
phrase: shift last {count} elements in series
phrase: move series keeping last {count} values
slot: count int
test: list=10,20,30,40 count=3
expect: => i=3 r=0.0 ok=true s="shifted last series of 3 items" errors=0 n=3 res=[40,20,30] cache=0 hits=0
test: list=1,2,3,4,5 count=4
expect: => i=4 r=0.0 ok=true s="shifted last series of 4 items" errors=0 n=4 res=[5,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 {
		gold_fail(g, "empty series cannot be shifted");
		out.ok = false;
		return out;
	}
	let lim = if c <= 0 { 0 } else if c > g.n { g.n } else { c };
	if lim == 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "zero elements in shifted series");
		return out;
	}
	let start = g.n - lim;
	var tmp int[512] = [0; 512];
	tmp[0] = g.res[g.n - 1];
	for k in lim - 1 {
		tmp[k + 1] = g.res[start + k];
	}
	for k in lim {
		g.res[k] = tmp[k];
	}
	g.steps += lim;
	g.n = lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "shifted last series of ", lim, " items");
	out
}
@end
