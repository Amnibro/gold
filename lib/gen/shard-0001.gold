	while shifts < g.n && g.res[0] < target {
		let first = g.res[0];
		var j = 0;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	gold_cache_put(g, 0, shifts);
	g.steps += shifts + 1;
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted items count: ", shifts);
