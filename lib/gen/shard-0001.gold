	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let last_item = g.res[g.n - 1];
	var dropped = false;
	if last_item < avg {
		g.n--;
		dropped = true;
	}
	out.ok = dropped;
	out.i = avg;
	out.s.clear();
	format(out.s, "average was ", avg);
	out
}
