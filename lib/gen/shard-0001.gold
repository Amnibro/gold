test: list=10,2,8,4 thresh=5
expect: => i=2 r=0.0 ok=true s="selected 2 sorted items above threshold" errors=0 n=2 res=[8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let t = ${thresh};
	var kept = 0;
	for k in g.n {
		if g.res[k] >= t {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " sorted items above threshold");
	out
}
@end
