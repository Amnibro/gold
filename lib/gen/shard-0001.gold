phrase: join results from subfunction {sub} with_cache
slot: sub fn
test: list=2,3,2 sub=double
expect: => i=14 r=0.0 ok=true s="joined with cache sum=14" errors=0 n=3 res=[4,6,4] cache=2 hits=1
test: list=4,4,5 sub=inc
expect: => i=16 r=0.0 ok=true s="joined with cache sum=16" errors=0 n=3 res=[5,5,6] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		let y = if ok { cached } else {
			let res = ${sub}(x);
			gold_cache_put(g, x, res);
			res
		};
		g.res[k] = y;
		sum += y;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined with cache sum=", sum);
	out
}
@end
