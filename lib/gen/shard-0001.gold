code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "kept ", g.n, " sorted pairs");
		return out;
	}
	var kept = 1;
	for k in 1..g.n {
		if g.res[k] + m >= g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " sorted pairs");
	out
}
@end
