kind: step
verb: split
noun: total
modifier: up_to
context: core
phrase: split total into parts up to {chunk}
phrase: partition total value up to size {chunk}
phrase: divide total into chunks up to {chunk}
slot: chunk int
test: input=14 chunk=5
expect: => i=3 r=0.0 ok=true s="split total into 3 parts" errors=0 n=3 res=[5,5,4] cache=0 hits=0
test: input=10 chunk=10
expect: => i=1 r=0.0 ok=true s="split total into 1 parts" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || out.i <= 0 {
		gold_fail(g, "invalid split chunk or total");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive chunk");
		return out;
	}
	var rem = out.i;
	var parts = 0;
	while rem > 0 {
		let piece = if rem > c { c } else { rem };
		gold_push(g, piece);
		rem -= piece;
		parts++;
	}
	g.steps += parts;
	out.i = parts;
	out.s.clear();
	format(out.s, "split total into ", parts, " parts");
	out
}
@end
@entry 0a171471ad768efc
kind: step
verb: drop
noun: maximum
modifier: last
context: core
phrase: drop last maximum element
phrase: remove last occurrence of maximum value
phrase: delete last maximum from list
test: list=3,9,5,9,2
expect: => i=9 r=0.0 ok=true s="dropped last maximum 9" errors=0 n=4 res=[3,9,5,2] cache=0 hits=0
test: list=7,4,1
expect: => i=7 r=0.0 ok=true s="dropped last maximum 7" errors=0 n=2 res=[4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot drop from empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var last_idx = -1;
	for k in g.n {
		if g.res[k] == max_val { last_idx = k; }
	}
	for k in last_idx..(g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "dropped last maximum ", max_val);
	out
}
@end
