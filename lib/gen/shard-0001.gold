@entry 1b5256ea87fa515c
kind: step
verb: fill
noun: primes
modifier: between
context: transform
phrase: fill results with primes from {lo} through {hi}
phrase: generate primes within bounds {lo} to {hi}
phrase: populate list with all primes from {lo} to {hi}
slot: lo int
slot: hi int
test: lo=2 hi=10
expect: => i=4 r=0.0 ok=true s="generated primes count 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: lo=10 hi=20
expect: => i=4 r=0.0 ok=true s="generated primes count 4" errors=0 n=4 res=[11,13,17,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	gold_clear(g);
	var cur = low;
	while cur <= high {
		var is_p = true;
		if cur < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= cur {
				if cur % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			gold_push(g, cur);
		}
		cur++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "generated primes count ", g.n);
	out
}
@end
