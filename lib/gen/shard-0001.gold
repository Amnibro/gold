fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen && kept < limit {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " unique search streak items");
	out
}
@end
