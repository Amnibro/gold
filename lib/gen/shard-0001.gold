@entry a521e0d960b32f85
kind: step
verb: rank
noun: spaces
modifier: all
context: stats
phrase: rank all spaces between observations
phrase: rank all interval spaces in sample
phrase: calculate ranks of all spaces in data
test: list=10,12,20,23
expect: => i=3 r=0.0 ok=true s="ranked 3 spaces" errors=0 n=3 res=[1,3,2] cache=0 hits=0
test: list=1,10,12
expect: => i=2 r=0.0 ok=true s="ranked 2 spaces" errors=0 n=2 res=[2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for spacing");
		return out;
	}
	var spaces int[512] = [0; 512];
	let m = g.n - 1;
	for k in m {
		spaces[k] = g.res[k + 1] - g.res[k];
	}
	for k in m {
		var rank = 1;
		for j in m {
			if spaces[j] < spaces[k] { rank++; }
		}
		g.res[k] = rank;
	}
	g.n = m;
	g.steps += m * m;
	out.i = m;
	out.s.clear();
	format(out.s, "ranked ", m, " spaces");
	out
}
@end
@entry 6b3e3476315f07dd
kind: step
verb: reverse
noun: threshold
modifier: running
context: stats
phrase: reverse items exceeding running threshold {threshold}
phrase: invert elements beyond running threshold {threshold}
phrase: reverse prefix where running sum meets threshold {threshold}
slot: threshold int
test: list=1,2,3,4,5 threshold=6
expect: => i=3 r=0.0 ok=true s="reversed 3 items reaching threshold" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30 threshold=25
expect: => i=2 r=0.0 ok=true s="reversed 2 items reaching threshold" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var rsum = 0;
	var end_idx = -1;
	for k in g.n {
		rsum += g.res[k];
		if rsum >= thresh {
			end_idx = k;
			break;
		}
	}
	if end_idx >= 0 {
		let lim = end_idx + 1;
		for i in lim / 2 {
			let j = lim - 1 - i;
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
		}
		g.steps += lim;
		out.i = lim;
		out.s.clear();
		format(out.s, "reversed ", lim, " items reaching threshold");
	} else {
		g.steps += g.n;
		out.i = 0;
		out.s.clear();
		format(out.s, "threshold not reached");
	}
	out
}
@end
@entry ec4a1fccb7881608
kind: step
verb: swap
noun: head
modifier: unique
context: stats
phrase: swap head with first unique value
phrase: place first unique observation at head
phrase: exchange head item with unique value
test: list=4,4,7,8
expect: => i=2 r=0.0 ok=true s="swapped head with unique item at index 2" errors=0 n=4 res=[7,4,4,8] cache=0 hits=0
test: list=9,9,5,5
expect: => i=-1 r=0.0 ok=true s="no unique item found" errors=0 n=4 res=[9,9,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = -1;
		out.s.clear();
		format(out.s, "empty sample");
		return out;
	}
	var u_idx = -1;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == 1 {
			u_idx = i;
			break;
		}
	}
	if u_idx >= 0 {
		let tmp = g.res[0];
		g.res[0] = g.res[u_idx];
		g.res[u_idx] = tmp;
		g.steps += g.n * g.n;
		out.i = u_idx;
		out.s.clear();
		format(out.s, "swapped head with unique item at index ", u_idx);
	} else {
		g.steps += g.n * g.n;
		out.i = -1;
		out.s.clear();
		format(out.s, "no unique item found");
	}
	out
}
@end
