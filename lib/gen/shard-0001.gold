	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.res[g.n - 1] = head;
	g.steps += g.n;
	out.i = head;
	out.s.clear();
	format(out.s, "cycled head element: ", head);
	out
}
