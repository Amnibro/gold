code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i > 0 {
		gold_cache_put(g, 1, out.i);
	}
	var dropped = 0;
	if g.cn > 0 {
		for i in 1..g.cn {
			g.ck[i - 1] = g.ck[i];
			g.cv[i - 1] = g.cv[i];
		}
		g.cn--;
		dropped = 1;
	}
	g.steps += 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "first cache entry dropped: ", dropped);
	out
}
@end
