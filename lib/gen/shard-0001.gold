test: list=1,2,3,1,2
expect: => i=3 r=0.0 ok=true s="longest streak has length 3" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=5,4,3,2
expect: => i=1 r=0.0 ok=true s="longest streak has length 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for k in 1..g.n {
		if g.res[k] >= g.res[k - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak has length ", max_streak);
	out
}
@end
