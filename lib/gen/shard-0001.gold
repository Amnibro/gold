fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stop_char};
	let stop = if s.len > 0 { s[0] } else { ' ' };
	var pos = 0;
	while pos < out.s.len && out.s[pos] != stop { pos++; }
	var i = 0;
	var j = pos - 1;
	while i < j {
		let t = out.s[i]; out.s[i] = out.s[j]; out.s[j] = t;
		i++;
		j--;
	}
	out.i = pos;
	g.steps += out.s.len + 1;
	out
}
@end
