expect: => i=3 r=0.0 ok=true s="repeated sorted numbers recursively to 3 items" errors=0 n=3 res=[1,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if r <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "repeated sorted numbers recursively to 0 items");
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		for pass in r {
			if new_n < 512 {
				new_res[new_n] = g.res[k];
				new_n++;
			}
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "repeated sorted numbers recursively to ", new_n, " items");
	out
}
@end
@entry fd02b9c5b9551c98
kind: step
verb: rotate
noun: streak
modifier: every_other
context: sort
phrase: rotate sorted streak elements every other block of size {streak_len}
phrase: cycle every other sorted streak block of size {streak_len}
phrase: rotate items in every other sorted streak of length {streak_len}
slot: streak_len int
test: list=6,5,4,3,2,1 streak_len=3
expect: => i=1 r=0.0 ok=true s="rotated 1 streaks of length 3" errors=0 n=6 res=[1,2,3,5,6,4] cache=0 hits=0
test: list=10,20,30,40 streak_len=2
expect: => i=1 r=0.0 ok=true s="rotated 1 streaks of length 2" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${streak_len};
	if slen <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "streak length too small to rotate");
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var rotated_blocks = 0;
	var block_idx = 0;
	var i = 0;
	while i + slen <= g.n {
		if block_idx % 2 == 1 {
			let first = g.res[i];
			for k in (i + 1)..(i + slen) {
				g.res[k - 1] = g.res[k];
			}
			g.res[i + slen - 1] = first;
			rotated_blocks++;
		}
		block_idx++;
		i += slen;
	}
	g.steps += g.n;
	out.i = rotated_blocks;
	out.s.clear();
	format(out.s, "rotated ", rotated_blocks, " streaks of length ", slen);
	out
}
@end
