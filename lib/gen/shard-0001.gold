fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var pairs = 0;
	var k = 0;
	while k + 1 < g.n {
		let sum = g.res[k] + g.res[k + 1];
		if total + sum > ${limit} { break; }
		total += sum;
		pairs++;
		k += 2;
	}
	out.i = total;
	g.steps += g.n + 1;
	out
}
