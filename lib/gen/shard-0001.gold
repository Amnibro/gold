fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	if w > 1 {
		let first = g.res[0];
		var idx = 0;
		while idx < w - 1 {
			g.res[idx] = g.res[idx + 1];
			idx++;
		}
		g.res[w - 1] = first;
	}
	out.i = w;
	out.s.clear();
	format(out.s, "memo filtered and rotated=", w);
	out
}
@end
