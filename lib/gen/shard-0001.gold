@entry 5e00cc6a3a5418d3
kind: step
verb: reverse
noun: memo
modifier: recursively
context: aggregate
phrase: reverse memo table recursively into aggregate results
phrase: recursively reverse memoized entries in aggregate
phrase: populate aggregate with reverse memoized sequence
test: list=10,20,30,40
expect: => i=100 r=0.0 ok=true s="reversed 4 memo entries with sum 100" errors=0 n=4 res=[40,30,20,10] cache=4 hits=0
test: list=1,3,5
expect: => i=9 r=0.0 ok=true s="reversed 3 memo entries with sum 9" errors=0 n=3 res=[5,3,1] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var total = 0;
	var idx = g.cn - 1;
	gold_clear(g);
	while idx >= 0 {
		let val = g.cv[idx];
		gold_push(g, val);
		total += val;
		idx--;
	}
	g.steps += g.cn;
	out.i = total;
	out.s.clear();
	format(out.s, "reversed ", g.cn, " memo entries with sum ", total);
	out
}
@end
@entry 6997dd17eb976f44
kind: step
