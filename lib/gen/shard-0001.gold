		gold_fail(g, "limit must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	let end = if lim < g.n { lim } else { g.n };
	var count = 0;
	for k in end {
		if g.res[k] % 2 == 0 {
			g.res[k] /= 2;
			count++;
		}
	}
	g.steps += end;
	out.i = count;
	out.s.clear();
	format(out.s, "normalized ", count, " even values");
