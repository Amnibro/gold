expect: => i=1 r=0.0 ok=true s="found primes safely in cache: 1" errors=0 n=4 res=[8,9,10,11] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var i = 0;
	while i < g.n {
		let n = g.res[i];
		var is_p = true;
		if n < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= n {
				if n % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, primes, n);
			primes++;
		}
		i++;
	}
	g.steps += i;
	out.i = primes;
	out.s.clear();
	format(out.s, "found primes safely in cache: ", primes);
	out
}
@end
@entry 881652928b4516a6
kind: step
verb: normalize
noun: average
modifier: times
context: cache
phrase: normalize values toward average {cycles} times in cache
phrase: center entries around average over {cycles} cycles
slot: cycles int
test: list=10,20,30 cycles=1
expect: => i=20 r=0.0 ok=true s="normalized towards average: 20" errors=0 n=3 res=[15,20,25] cache=3 hits=0
test: list=2,8 cycles=2
expect: => i=5 r=0.0 ok=true s="normalized towards average: 5" errors=0 n=2 res=[4,6] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cyc = ${cycles};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / g.n;
	var c = 0;
	while c < cyc {
		var j = 0;
		while j < g.n {
			let diff = avg - g.res[j];
			g.res[j] += diff / 2;
			gold_cache_put(g, j, g.res[j]);
			j++;
		}
		c++;
	}
	g.steps += i + c * g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "normalized towards average: ", avg);
	out
}
@end
