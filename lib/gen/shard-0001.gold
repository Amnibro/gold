@entry 6110c72cf095ea15
kind: step
verb: rotate
noun: digits
modifier: safely
context: loop
phrase: rotate digits safely across input number
phrase: cycle decimal digits of input safely
test: input=1234
expect: => i=4123 r=0.0 ok=true s="rotated digits to 4123" errors=0 n=0 res=[] cache=0 hits=0
test: input=50
expect: => i=5 r=0.0 ok=true s="rotated digits to 5" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	if x < 10 { return out; }
	var rem = x % 10;
	x /= 10;
	var mult = 1;
	var tmp = x;
	while tmp > 0 {
		mult *= 10;
		tmp /= 10;
	}
	let rot = rem * mult + x;
	g.steps += 1;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated digits to ", rot);
	out
}
@end
