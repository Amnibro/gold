code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	if g.n < 2 || limit <= 0 {
		gold_fail(g, "not enough items for pair loop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	let a = g.res[g.n - 2];
	let b = g.res[g.n - 1];
	let p = a * limit + b;
	gold_push(g, p);
	g.steps += 2;
	out.i = p;
	out.s.clear();
	format(out.s, "paired last items with result ", p);
	out
}
@end
