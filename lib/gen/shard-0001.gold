@entry cb65da17eddfd133
kind: step
verb: normalize
noun: value
modifier: recursively
context: format
phrase: format recursive digital reduction steps
phrase: render successive digital sum stages
phrase: display recursive digital root progression
test: list=99
expect: => i=9 r=0.0 ok=true s="root: 99 -> 18 -> 9" errors=0 n=1 res=[99] cache=0 hits=0
test: list=38
expect: => i=2 r=0.0 ok=true s="root: 38 -> 11 -> 2" errors=0 n=1 res=[38] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "root: empty");
		return out;
	}
	var cur = if g.res[0] < 0 { -g.res[0] } else { g.res[0] };
	format(out.s, "root: ", cur);
	while cur >= 10 {
		var sum = 0;
		var t = cur;
		while t > 0 {
			sum += t % 10;
			t /= 10;
		}
		cur = sum;
		format(out.s, " -> ", cur);
	}
	out.i = cur;
	g.steps += 10;
	out
}
@end
