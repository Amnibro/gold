code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two results to swap last");
		out.ok = false;
		return out;
	}
	let last = g.n - 1;
	let prev = g.n - 2;
	let tmp = g.res[last];
	g.res[last] = g.res[prev];
	g.res[prev] = tmp;
	g.steps += 1;
	out.i = g.res[last];
	out.s.clear();
	format(out.s, "swapped last two results");
	out
}
@end
