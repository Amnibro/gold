fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cur, hit = gold_cache_get(g, x);
		if hit {
			gold_cache_put(g, x, cur + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "measured frequencies of ", g.cn, " unique keys in cache");
	out
}
@end
