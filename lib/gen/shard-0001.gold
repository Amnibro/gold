test: list=2,3,4,5,6,7
expect: => i=17 r=0.0 ok=true s="prime aggregate sum=17" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=10,11,12,13
expect: => i=24 r=0.0 ok=true s="prime aggregate sum=24" errors=0 n=4 res=[10,11,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_sum = 0;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; }
			d++;
		}
		if is_p {
			prime_sum += x;
			prime_count++;
		}
	}
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "prime aggregate sum=", prime_sum);
	out
}
@end
