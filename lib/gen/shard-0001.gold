code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${trace_limit};
	var sum = 0;
	var kept = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if sum + g.res[idx] > lim { break; }
		sum += g.res[idx];
		kept++;
		idx--;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "traced in reverse count=", kept, " sum=", sum);
	out
}
@end
