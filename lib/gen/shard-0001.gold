kind: step
verb: count
noun: window
modifier: in_place
context: math
phrase: count window in place of size {size} matching {p}
phrase: evaluate sliding window in place with size {size} for {p}
phrase: compute window counts in place with size {size} across {p}
slot: size int
slot: p pred
test: list=1,2,3,4,5 size=3 p=is_odd
expect: => i=3 r=0.0 ok=true s="counted 3 sliding windows" errors=0 n=3 res=[2,1,2] cache=0 hits=0
test: list=4,7,9,16 size=2 p=is_square
expect: => i=3 r=0.0 ok=true s="counted 3 sliding windows" errors=0 n=3 res=[1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	let windows = g.n - w + 1;
	for i in windows {
		var matches = 0;
		for j in w {
			if ${p}(g.res[i + j]) { matches++; }
		}
		g.res[i] = matches;
	}
	g.steps += windows * w;
	g.n = windows;
	out.i = windows;
	out.s.clear();
	format(out.s, "counted ", windows, " sliding windows");
	out
}
@end
