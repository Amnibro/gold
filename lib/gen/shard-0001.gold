fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var max_val = 0;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= thresh {
			if count == 0 || x > max_val { max_val = x; }
			count++;
		}
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "measured maximum ", max_val, " across ", count, " qualifying items");
