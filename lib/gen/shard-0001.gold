	for k in g.n {
		if run + g.res[k] <= c {
			run += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected tally while under cap ", kept);
	out
}
