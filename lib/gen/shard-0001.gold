kind: step
verb: pair
noun: odds
modifier: while
context: compare
phrase: pair odd numbers while comparing limit {limit}
phrase: combine adjacent odd items under limit {limit}
phrase: pair odd values while below limit {limit}
slot: limit int
test: list=3,5,7,2 limit=10
expect: => i=1 r=0.0 ok=true s="paired 1 odd elements" errors=0 n=3 res=[8,7,2] cache=0 hits=0
test: list=1,3 limit=-1
expect: => i=0 r=0.0 ok=false s="error: non-positive limit" errors=1 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid pair limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	var pairs = 0;
	var i = 0;
	var kept = 0;
	while i < g.n {
		if i + 1 < g.n && (g.res[i] % 2 != 0) && (g.res[i + 1] % 2 != 0) {
			let s = g.res[i] + g.res[i + 1];
			if s <= lim {
				g.res[kept] = s;
				kept++;
				pairs++;
				i += 2;
				continue;
			}
		}
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " odd elements");
	out
}
@end
