code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var on = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[on] = g.res[k];
			on++;
		}
	}
	var idx = on;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			idx--;
			g.res[k] = odds[idx];
		}
	}
	g.steps += on;
	out.i = on;
	out.s.clear();
	format(out.s, "reversed odd values count ", on);
	out
}
@end
