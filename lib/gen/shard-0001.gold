fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_g = ${min_gap};
	var gaps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = -diff; }
			if diff >= min_g {
				gaps++;
			}
		}
	}
	g.steps += g.n + gaps;
	out.i = gaps;
	out.s.clear();
	format(out.s, "split on ", gaps, " gaps exceeding threshold");
	out
}
