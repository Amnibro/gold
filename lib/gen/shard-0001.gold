fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] != 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	let dropped = g.n - kept;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped zero gaps: ", dropped);
