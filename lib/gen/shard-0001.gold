code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var un = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in un { if u[j] == x { seen = true; break; } }
		if !seen {
			u[un] = x;
			un++;
		}
	}
	for k in un { g.res[k] = u[k]; }
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "normalized ", un, " unique items");
	out
}
@end
