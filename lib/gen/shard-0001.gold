code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var count = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq == 1 {
			g.res[i] *= f;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " unique loop items");
	out
}
@end
@entry d926c18864a89bc8
kind: step
verb: scan
noun: budget
modifier: pairwise
context: list
phrase: scan pairwise differences within budget {budget}
phrase: check adjacent pairs against cost budget {budget}
slot: budget int
test: list=10,15,22 budget=6
expect: => i=1 r=0.0 ok=true s="pairs within budget: 1" errors=0 n=3 res=[10,15,22] cache=0 hits=0
test: list=1,20,50 budget=10
expect: => i=0 r=0.0 ok=true s="pairs within budget: 0" errors=0 n=3 res=[1,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var within = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= b { within++; }
	}
	g.steps += g.n;
	out.i = within;
	out.s.clear();
