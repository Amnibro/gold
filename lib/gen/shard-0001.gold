fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var added = 0;
	for k in g.n {
		let x = g.res[k];
		let val, found = gold_cache_get(g, x);
		if !found {
			gold_cache_put(g, x, 1);
			added++;
		}
	}
	g.steps += g.n;
	out.i = added;
	out.s.clear();
	format(out.s, "recorded ", added, " unique items in memo");
	out
}
