@entry 81ba16001db70cba
kind: step
verb: rotate
noun: squares
modifier: times
context: text
phrase: rotate squares {times} times
phrase: cycle digit squares {times} iterations
phrase: shift square values {times} steps
slot: times int
test: text="abc149xyz" times=1
expect: => i=3 r=0.0 ok=true s="rotated 3 square digits" errors=0 n=3 res=[4,9,1] cache=0 hits=0
test: text="val1499" times=2
expect: => i=4 r=0.0 ok=true s="rotated 4 square digits" errors=0 n=4 res=[9,9,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	g.n = 0;
	for b in out.s {
		if b == '0' || b == '1' || b == '4' || b == '9' {
			gold_push(g, (b - '0') as! int);
		}
	}
	if g.n > 1 && t > 0 {
		for step in t {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += out.s.len + g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated ", g.n, " square digits");
	out
}
