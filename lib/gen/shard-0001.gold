fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let max_val = g.res[max_idx];
	for i in max_idx..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = max_val;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "pushed max to tail: ", max_val);
	out
}
@end
