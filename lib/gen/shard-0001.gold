fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${shift};
	if g.n < 2 || k == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "rotated history 0 positions");
		return out;
	}
	let steps = ((k % g.n) + g.n) % g.n;
	var tmp = [0; 512];
	for i in g.n {
		tmp[(i + steps) % g.n] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	out.i = steps;
	out.s.clear();
	format(out.s, "rotated each history item by ", steps);
	out
}
@end
