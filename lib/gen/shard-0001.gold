@entry 0875f6261e2c5e78
kind: step
verb: split
noun: checkpoint
modifier: any
context: sort
phrase: split checkpoint any pivot partition
phrase: partition elements around head pivot
test: list=4,2,7,1,5
expect: => i=2 r=0.0 ok=true s="pivot index after partition: 2" errors=0 n=5 res=[2,1,4,7,5] cache=0 hits=0
test: list=10,5,20
expect: => i=1 r=0.0 ok=true s="pivot index after partition: 1" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let pivot = g.res[0];
	var less = [0; 64];
	var greater = [0; 64];
	var nl = 0;
	var ng = 0;
	for i in 1..g.n {
		if g.res[i] <= pivot && nl < 64 {
			less[nl] = g.res[i];
			nl++;
		} else if ng < 64 {
			greater[ng] = g.res[i];
			ng++;
		}
	}
	var idx = 0;
	for i in nl { g.res[idx] = less[i]; idx++; }
	g.res[idx] = pivot; idx++;
	for i in ng { g.res[idx] = greater[i]; idx++; }
	g.steps += g.n;
	out.i = nl;
	out.s.clear();
	format(out.s, "pivot index after partition: ", nl);
	out
}
@end
