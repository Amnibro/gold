		out.s.clear();
		format(out.s, "error: empty history");
		return out;
	}
	var kept = 0;
	var k = 0;
	while k < g.n {
		g.res[kept] = g.res[k];
		kept++;
		k += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " alternate history items");
	out
}
@end
