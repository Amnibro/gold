code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[en] = g.res[k];
			en++;
		}
	}
	for i in en {
		for j in i + 1..en {
			if evens[i] > evens[j] {
				let tmp = evens[i];
				evens[i] = evens[j];
				evens[j] = tmp;
			}
		}
	}
	for k in en { g.res[k] = evens[k]; }
	g.n = en;
	g.steps += en * en;
	out.i = en;
	out.s.clear();
	format(out.s, "selected ", en, " sorted evens");
	out
}
@end
@entry 6a4ec498b40a0e2a
kind: step
verb: apply
noun: gaps
modifier: running
context: math
phrase: apply gaps running across elements
phrase: compute running gaps in results
phrase: calculate running gaps between items
test: list=2,5,10,12
expect: => i=3 r=0.0 ok=true s="applied 3 running gaps" errors=0 n=3 res=[3,5,2] cache=0 hits=0
test: list=10,20,5
expect: => i=2 r=0.0 ok=true s="applied 2 running gaps" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("too few items for running gaps");
		return out;
	}
	var gaps int[512] = [0; 512];
	var gn = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		gaps[gn] = if diff < 0 { -diff } else { diff };
		gn++;
	}
	for k in gn { g.res[k] = gaps[k]; }
	g.n = gn;
	g.steps += gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "applied ", gn, " running gaps");
	out
}
@end
