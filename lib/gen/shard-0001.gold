fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_sum};
	var running = 0;
	var kept = 0;
	for k in g.n {
		if running + g.res[k] <= limit {
			running += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	if kept > 0 {
		out.ok = true;
		format(out.s, "filtered loop keeping ", kept, " items");
	} else {
		gold_fail(g, "first item exceeds running sum");
		out.ok = false;
		format(out.s, "error: first item exceeds running sum");
	}
	out
}
