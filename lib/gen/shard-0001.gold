fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] == min_val {
			g.res[kept] = min_val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = min_val;
	out.s.clear();
	format(out.s, "kept ", kept, " minimum values of ", min_val);
	out
}
