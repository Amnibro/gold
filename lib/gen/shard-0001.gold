code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ckey = ${cache_key};
	var is_sorted = true;
	if g.n > 1 {
		for k in (g.n - 1) {
			if g.res[k] > g.res[k + 1] {
				is_sorted = false;
				break;
			}
		}
	}
	let ans = if is_sorted { 1 } else { 0 };
	gold_cache_put(g, ckey, ans);
	g.steps += g.n;
	out.i = ans;
	out.s.clear();
	if is_sorted {
		out.ok = true;
		format(out.s, "sequence is sorted");
	} else {
		gold_fail(g, "sequence out of order");
		out.ok = false;
		format(out.s, "sequence is not sorted");
	}
	out
}
@end
@entry 582737fbf83816a1
kind: step
verb: dedupe
noun: threshold
modifier: up_to
context: sort
phrase: dedupe sorted values above threshold {threshold} up to {max_count} copies
phrase: prune duplicates in sorted list exceeding threshold {threshold} up to {max_count}
phrase: limit repeated sorted values past threshold {threshold} up to {max_count} items
slot: threshold int
slot: max_count int
test: list=1,1,1,1,5,5,5,5,8,8,8 threshold=5 max_count=2
expect: => i=8 r=0.0 ok=true s="deduped sorted values above threshold up to max copies" errors=0 n=8 res=[1,1,1,1,5,5,8,8] cache=0 hits=0
test: list=2,2,2 threshold=1 max_count=1
expect: => i=1 r=0.0 ok=true s="deduped sorted values above threshold up to max copies" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	let max_c = ${max_count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let val = g.res[i];
		let keep_len = if val >= thresh {
			if run_len < max_c { run_len } else { max_c }
		} else {
			run_len
		};
		for k in keep_len {
			new_res[new_n] = val;
			new_n++;
		}
		i = j;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped sorted values above threshold up to max copies");
	out
}
@end
