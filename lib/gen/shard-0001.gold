code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var streaks = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			gold_cache_put(g, streaks, cur_len);
			streaks++;
			cur_len = 1;
		}
	}
	gold_cache_put(g, streaks, cur_len);
	streaks++;
	g.steps += g.n;
	out.i = streaks;
	out.s.clear();
	format(out.s, "cached ", streaks, " nested streaks");
	out
}
@end
@entry c497dda4836b61cb
kind: step
verb: swap
noun: number
modifier: nested
context: loop
phrase: swap number nested positions {i} with {j}
phrase: exchange nested elements at {i} with {j}
slot: i int
slot: j int
test: list=10,20,30,40 i=1 j=3
expect: => i=1 r=0.0 ok=true s="swapped nested positions: 1" errors=0 n=4 res=[10,40,30,20] cache=0 hits=0
test: list=5,6,7 i=0 j=2
expect: => i=1 r=0.0 ok=true s="swapped nested positions: 1" errors=0 n=3 res=[7,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx1 = ${i};
	let idx2 = ${j};
	if idx1 >= 0 && idx1 < g.n && idx2 >= 0 && idx2 < g.n {
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		g.steps += 1;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "swapped nested positions: ", out.i);
	out
}
@end
