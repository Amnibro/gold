fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	if kept > 0 {
		out.ok = true;
		format(out.s, "filtered ", kept, " items within tally bounds");
	} else {
		gold_fail(g, "no items in tally range");
		out.ok = false;
		format(out.s, "error: no items in tally range");
	}
	out
}
