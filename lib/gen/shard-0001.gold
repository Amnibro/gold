test: list=10,5,5,5,20 target=5 max_times=2
expect: => i=2 r=0.0 ok=true s="searched middle times found=2" errors=0 n=4 res=[10,5,5,20] cache=0 hits=0
test: list=1,2,2,3 target=2 max_times=1
expect: => i=1 r=0.0 ok=true s="searched middle times found=1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_occ = ${max_times};
	if g.n <= 2 {
		out.i = g.n;
		return out;
	}
	var w = 1;
	var occ = 0;
	var idx = 1;
	while idx < g.n - 1 {
		let x = g.res[idx];
		if x == tgt {
			if occ < max_occ {
				g.res[w] = x;
				w++;
				occ++;
			}
		} else {
			g.res[w] = x;
			w++;
		}
		idx++;
	}
	g.res[w] = g.res[g.n - 1];
	w++;
	g.n = w;
	out.i = occ;
	out.s.clear();
	format(out.s, "searched middle times found=", occ);
	out
}
@end
