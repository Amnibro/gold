code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_gap};
	if g.n < 2 {
		gold_fail(g, "not enough items for gaps");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var norm = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if diff > tgt {
			g.res[k + 1] = g.res[k] + tgt;
			norm++;
		}
	}
	g.steps += g.n;
	out.i = norm;
	out.s.clear();
	format(out.s, "normalized ", norm, " gaps until target");
	out
}
@end
