fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var filtered byte[..128] = [];
	for k in out.s.len {
		let c = out.s[k];
		if (c >= 'a' as! byte && c <= 'z' as! byte) || (c >= 'A' as! byte && c <= 'Z' as! byte) {
			filtered.push(c);
		}
	}
	out.s.clear();
	for b in filtered { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
