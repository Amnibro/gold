fn ${ID}(n int) int {
	let b = ${bucket};
	var x = if n < 0 { -n } else { n };
	if x == 0 {
		return 1;
	}
	var counts int[10] = [0; 10];
	while x > 0 {
		let d = x % 10;
		let grp = if b > 1 { d / b } else { d };
		let idx = if grp < 10 { grp } else { 9 };
		counts[idx]++;
		x /= 10;
	}
	var max_grp = 0;
	for c in counts {
		if c > max_grp {
			max_grp = c;
		}
	}
	max_grp
}
@end
