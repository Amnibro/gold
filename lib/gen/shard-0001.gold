	let k = ${count};
	if k <= 0 || v.s.len == 0 {
		gold_fail(g, "invalid suffix length or empty text");
		out.ok = false;
		return out;
	}
	let take = if k > v.s.len { v.s.len } else { k };
	let start = v.s.len - take;
	for i in take {
		gold_push(g, v.s[start + i] as! int);
	}
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " suffix characters");
	out
}
@end
