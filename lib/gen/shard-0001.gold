code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var split_idx = -1;
	for i in g.n {
		if ${pred_check}(g.res[i]) {
			split_idx = i;
			break;
		}
	}
	out.i = split_idx;
	out.ok = split_idx >= 0;
	g.steps += g.n + 1;
	out
}
@end
