fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var ranked = 0;
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[k] = cached;
		} else {
			let r = if x > lim { 2 } else { 1 };
			gold_cache_put(g, x, r);
			g.res[k] = r;
			ranked++;
		}
	}
	g.steps += g.n;
	out.i = ranked;
	out.s.clear();
	format(out.s, "ranked series with cache: ", ranked, " new");
	out
}
