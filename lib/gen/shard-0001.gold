@entry 632eb7f37477cc8a
kind: fn
verb: rotate
noun: average
modifier: with_cache
context: loop
phrase: rotate digits compute average
phrase: average of rotated digit values
phrase: compute average of rotated digits
test: arg=13,24
expect: 22
expect: 33
test: arg=7
expect: 7
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var temp = x;
	var len = 0;
	var pow = 1;
	while temp > 0 {
		len++;
		temp /= 10;
		if temp > 0 { pow *= 10; }
	}
	var sum = 0;
	var cur = x;
	var k = 0;
	while k < len {
		sum += cur;
		let last = cur % 10;
		cur = (cur / 10) + last * pow;
		k++;
	}
	sum / len
}
@end
@entry 6628ab6e9dd504f7
kind: step
verb: sort
noun: middle
modifier: with_cache
context: compare
phrase: sort middle elements with cache count {count}
phrase: order middle values with cache count {count}
phrase: sort center items with cache size {count}
slot: count int
test: list=10,50,20,40,30 count=3
expect: => i=3 r=0.0 ok=true s="sorted 3 middle elements" errors=0 n=5 res=[10,20,40,50,30] cache=1 hits=0
test: list=10,20 count=0
expect: => i=0 r=0.0 ok=false s="error: invalid middle count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 || cnt > g.n {
		gold_fail(g, "invalid middle sort count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid middle count");
		return out;
	}
	let start = (g.n - cnt) / 2;
	for i in cnt {
		for j in cnt - 1 - i {
			let idx = start + j;
			if g.res[idx] > g.res[idx + 1] {
				let tmp = g.res[idx];
				g.res[idx] = g.res[idx + 1];
				g.res[idx + 1] = tmp;
			}
		}
	}
	gold_cache_put(g, start, cnt);
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "sorted ", cnt, " middle elements");
	out
}
@end
