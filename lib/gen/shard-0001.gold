fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var uniq = 0;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h {
			var first = true;
			for j in i {
				if g.res[j] == g.res[i] { first = false; break; }
			}
			if first { uniq++; }
		}
	}
	g.steps += g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "check range unique items count ", uniq);
	out
}
