fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_pairs = ${limit};
	var digits = [0; 200];
	var count = 0;
	for c in v.s {
		if c >= '0' && c <= '9' {
			digits[count] = (c - '0') as! int;
			count++;
		}
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < count && pairs < max_pairs {
		let val = digits[i] * 10 + digits[i + 1];
		gold_push(g, val);
		pairs++;
		i += 2;
	}
	g.steps += count;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " digit pairs");
	out
}
@end
