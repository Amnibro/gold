	let first = g.res[0];
	var i = 0;
	while i < g.n - 1 {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.n--;
	gold_cache_put(g, 0, first);
	g.steps += g.n;
	out.i = first;
	out.s.clear();
	format(out.s, "shifted first item: ", first);
