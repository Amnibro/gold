@entry f2ac9345a8629944
kind: step
verb: keep
noun: primes
modifier: until
context: transform
phrase: keep prime numbers until element satisfies {p}
phrase: retain prime values until condition {p} occurs
phrase: filter primes stopping when predicate {p} matches
slot: p pred
test: list=2,3,5,8,7 p=is_even
expect: => i=3 r=0.0 ok=true s="kept 3 primes until stop" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=2,3,5,11,12 p=over_100
expect: => i=4 r=0.0 ok=true s="kept 4 primes until stop" errors=0 n=4 res=[2,3,5,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for k in g.n {
		let x = g.res[k];
		if ${p}(x) && k > 0 { break; }
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "kept ", w, " primes until stop");
	out
}
@end
