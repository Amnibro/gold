code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${target_len};
	if g.n == 0 { return out; }
	let last = g.res[g.n - 1];
	var added = 0;
	while g.n < tl && g.n < 512 {
