fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("not enough elements for pair minimum");
		return out;
	}
	var new_res int[512] = [0; 512];
	var pairs = g.n - 1;
	for i in pairs {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a < b { new_res[i] = a; } else { new_res[i] = b; }
	}
	for i in pairs { g.res[i] = new_res[i]; }
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired minimum safely pairs=", pairs);
	out
}
@end
