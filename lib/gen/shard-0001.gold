code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for normalize");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	for k in g.n {
		g.res[k] -= min_val;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized with min: ", min_val);
	out
}
@end
