code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lk = ${lookup_key};
	gold_cache_put(g, lk, g.n);
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = g.res[2 * k] + g.res[2 * k + 1];
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired values with cache stored ", pairs);
	out
}
@end
