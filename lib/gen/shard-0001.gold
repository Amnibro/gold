code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	if rep <= 0 || g.n * rep > 512 {
		gold_fail(g, "invalid repeat count");
		out.ok = false;
		return out;
	}
	var orig = [0; 512];
	let old_n = g.n;
	for i in old_n { orig[i] = g.res[i]; }
	var w = 0;
	for i in old_n {
		for k in rep {
			g.res[w] = orig[i];
			w++;
		}
	}
	g.steps += w;
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "merged into ", w, " words");
	out
}
@end
