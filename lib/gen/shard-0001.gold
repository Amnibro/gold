code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l > h {
		gold_fail(g, "invalid clamp range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: inverted range");
		return out;
	}
	var clamped = 0;
	for k in g.n {
		let x = g.res[k];
		if x < l {
			g.res[k] = l;
			clamped++;
		} else if x > h {
			g.res[k] = h;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " out of bounds items");
	out
}
@end
