kind: step
verb: merge
noun: values
modifier: at_least
context: retry
phrase: merge values at least threshold {threshold}
phrase: combine values meeting at least {threshold}
phrase: retry merge values at least limit {threshold}
slot: threshold int
test: list=15,20,5,25 threshold=30
expect: => i=3 r=0.0 ok=true s="merged 3 adjacent pairs meeting threshold" errors=0 n=1 res=[65] cache=0 hits=0
test: list=1,2,3 threshold=50
expect: => i=0 r=0.0 ok=false s="error: no qualifying merges" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if thresh <= 0 {
		gold_fail(g, "invalid merge threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive threshold");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "list too short for merge");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var merges = 0;
	var i = 0;
	while i < g.n - 1 {
		let combined = g.res[i] + g.res[i + 1];
		if combined >= thresh {
			g.res[i] = combined;
			var j = i + 1;
			while j < g.n - 1 {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.n--;
			merges++;
		} else {
			i++;
		}
	}
	g.steps += g.n + merges;
	out.i = merges;
	if merges == 0 {
		gold_fail(g, "no adjacent values met merge threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no qualifying merges");
		return out;
	}
	out.s.clear();
	format(out.s, "merged ", merges, " adjacent pairs meeting threshold");
	out
}
@end
@entry 38fb984178234fdd
kind: step
verb: sort
noun: step
modifier: recursively
context: retry
phrase: sort step recursively with max passes {passes}
phrase: recursive sort step passes {passes}
phrase: retry step sort recursively passes {passes}
slot: passes int
test: list=4,1,3,2 passes=5
expect: => i=3 r=0.0 ok=true s="sorted recursively in 3 passes" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=4,3,2,1 passes=1
expect: => i=1 r=0.0 ok=false s="error: pass budget exhausted" errors=1 n=4 res=[3,2,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_p = ${passes};
	if max_p <= 0 {
		gold_fail(g, "invalid pass limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive passes");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "list too short for sort");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var p = 0;
	var sorted = false;
	while p < max_p && !sorted {
		sorted = true;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				sorted = false;
			}
		}
		p++;
	}
	g.steps += p * g.n;
	out.i = p;
	if !sorted {
		gold_fail(g, "sort incomplete after pass budget");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: pass budget exhausted");
		return out;
	}
	out.s.clear();
	format(out.s, "sorted recursively in ", p, " passes");
	out
}
@end
