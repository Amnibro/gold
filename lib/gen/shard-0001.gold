fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var w = 0;
	var idx = 0;
	while idx < g.n && g.res[idx] >= avg {
		g.res[w] = g.res[idx];
		w++;
		idx++;
	}
	g.n = w;
	out.i = avg;
	out.s.clear();
	format(out.s, "filtered while above average count=", w);
	out
}
@end
