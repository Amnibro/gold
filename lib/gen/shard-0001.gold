@entry d8c20d70e0f0cdc8
kind: step
verb: reverse
noun: condition
modifier: nested
context: list
phrase: reverse nested condition segments matching {p}
phrase: invert nested items with condition {p}
phrase: flip nested segments satisfying condition {p}
slot: p pred
test: list=1,8,6,4,3 p=is_even
expect: => i=1 r=0.0 ok=true s="reversed 1 nested condition segments" errors=0 n=5 res=[1,4,6,8,3] cache=0 hits=0
test: list=10,20,5,30,40 p=is_even
expect: => i=2 r=0.0 ok=true s="reversed 2 nested condition segments" errors=0 n=5 res=[20,10,5,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var reversed = 0;
	var i = 0;
	while i < g.n {
		if ${p}(g.res[i]) {
			var j = i;
			while j < g.n && ${p}(g.res[j]) {
				j++;
			}
			let len = j - i;
			if len > 1 {
				for k in len / 2 {
					let a = i + k;
					let b = j - 1 - k;
					let tmp = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = tmp;
				}
				reversed++;
			}
			i = j;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = reversed;
	out.s.clear();
	format(out.s, "reversed ", reversed, " nested condition segments");
	out
}
@end
