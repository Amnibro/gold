		gold_fail(g, "empty list to fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	gold_cache_put(g, 0, max_val);
	for k in g.n {
		g.res[k] = max_val;
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "filled list with maximum ", max_val);
	out
}
