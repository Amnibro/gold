@entry 46df110b4a891036
kind: step
verb: swap
noun: suffix
modifier: safely
context: filter
phrase: swap suffix safely for last count {sz}
phrase: reverse suffix safely across length {sz}
slot: sz int
test: list=1,2,3,4,5 sz=3
expect: => i=3 r=0.0 ok=true s="swapped suffix safely span 3" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30 sz=1
expect: => i=1 r=0.0 ok=true s="swapped suffix safely span 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${sz};
	var span = s;
	if span > g.n { span = g.n; }
	if span < 0 { span = 0; }
	if span > 1 {
		var i = g.n - span;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "swapped suffix safely span ", span);
	out
}
@end
