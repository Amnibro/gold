@entry da0f479956470e18
kind: step
verb: run
noun: pairs
modifier: until
context: search
phrase: run pairs until target match
phrase: scan adjacent pairs until sum {target}
slot: target int
test: list=2,3,5,8 target=8
expect: => i=1 r=0.0 ok=true s="pair target match index: 1" errors=0 n=4 res=[2,3,5,8] cache=0 hits=0
test: list=1,2,3,4 target=99
expect: => i=-1 r=0.0 ok=false s="pair target match index: -1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matched = false;
	var match_idx = -1;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] == tgt {
			matched = true;
			match_idx = i;
			break;
		}
		i++;
	}
	g.steps += (i + 1);
	out.i = match_idx;
	out.ok = matched;
	out.s.clear();
	format(out.s, "pair target match index: ", match_idx);
	out
}
@end
