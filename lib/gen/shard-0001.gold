fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_len};
	let w = words(v.s);
	var matching = 0;
	for word in w {
		if word.len >= thresh {
			gold_push(g, word.len);
			gold_cache_put(g, matching, word.len);
			matching++;
		}
	}
	g.steps += w.len;
	out.i = matching;
	out.s.clear();
	format(out.s, "checked words with cache matching ", matching);
	out
}
