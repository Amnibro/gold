fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		g.res[k] = s;
		total += s;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "selected digit sums with aggregate total ", total);
	out
}
@end
