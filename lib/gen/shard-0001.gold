expect: => i=2 r=0.0 ok=true s="filled 2 step increments" errors=0 n=3 res=[50,55,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	let c = ${count};
	if c <= 0 {
		gold_fail(g, "step count must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive count");
		return out;
	}
	if g.n + c > 512 {
		gold_fail(g, "fill exceeds results capacity");
		out.ok = false;
		return out;
	}
	let base = if g.n > 0 { g.res[g.n - 1] } else { out.i };
	for k in c {
		let nxt = base + (k + 1) * s;
		gold_push(g, nxt);
	}
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "filled ", c, " step increments");
	out
}
@end
