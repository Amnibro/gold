@entry 66afedcefc845fbf
kind: step
verb: select
noun: minimum
modifier: recursively
context: format
phrase: format reduction stages of minimum values
phrase: render pairwise minimum reduction stages
phrase: display recursive minimum ladder string
test: list=8,3,5,1
expect: => i=1 r=0.0 ok=true s="ladder: [1]" errors=0 n=4 res=[8,3,5,1] cache=0 hits=0
test: list=9,4
expect: => i=4 r=0.0 ok=true s="ladder: [4]" errors=0 n=2 res=[9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var arr int[512] = [0; 512];
	for i in g.n { arr[i] = g.res[i]; }
	var len = g.n;
	format(out.s, "ladder: [");
	while len > 1 {
		var new_len = 0;
		var k = 0;
		while k < len {
			if k + 1 < len {
				let m = if arr[k] < arr[k + 1] { arr[k] } else { arr[k + 1] };
				arr[new_len] = m;
			} else {
				arr[new_len] = arr[k];
			}
			new_len++;
			k += 2;
		}
		len = new_len;
	}
	if len == 1 { format(out.s, arr[0]); }
	format(out.s, "]");
	out.i = if len > 0 { arr[0] } else { 0 };
	g.steps += g.n;
	out
}
@end
