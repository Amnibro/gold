	fn gcd(a int, b int) int {
		var u = a;
		var v = b;
		while v != 0 {
			let t = v;
			v = u % v;
			u = t;
		}
		u
	}
	var count = 0;
	for i in x - 1 {
		let v = i + 1;
		if gcd(v, x) == 1 { count++; }
	}
	count
}
@end
