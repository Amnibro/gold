kind: step
verb: return
noun: tail
modifier: unique
context: math
phrase: return tail unique elements
phrase: extract unique values from tail
phrase: isolate tail unique items
test: list=1,2,3,2,1
expect: => i=3 r=0.0 ok=true s="returned tail unique count=3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,5,6
expect: => i=2 r=0.0 ok=true s="returned tail unique count=2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var un = 0;
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		var seen = false;
		for j in un { if u[j] == x { seen = true; break; } }
		if !seen {
			u[un] = x;
			un++;
		}
		k--;
	}
	for i in un { g.res[i] = u[un - 1 - i]; }
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "returned tail unique count=", un);
	out
}
@end
@entry a5f7a94a778dbef9
kind: step
verb: limit
noun: total
modifier: last
context: math
phrase: limit total last {count} items to {max_sum}
phrase: restrict total of last {count} numbers to {max_sum}
phrase: cap total last {count} values under {max_sum}
slot: count int
slot: max_sum int
test: list=10,20,30 count=2 max_sum=35
expect: => i=35 r=0.0 ok=true s="limited total last sum=35" errors=0 n=3 res=[10,20,15] cache=0 hits=0
test: list=5,15,25 count=3 max_sum=40
expect: => i=40 r=0.0 ok=true s="limited total last sum=40" errors=0 n=3 res=[5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let lim = ${max_sum};
	if c <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty tail limit");
		return out;
	}
	let start = if g.n > c { g.n - c } else { 0 };
	var sum = 0;
	for k in start..g.n { sum += g.res[k]; }
	if sum > lim {
		let excess = sum - lim;
		if g.res[g.n - 1] >= excess {
			g.res[g.n - 1] -= excess;
		} else {
			g.res[g.n - 1] = 0;
		}
		sum = lim;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "limited total last sum=", sum);
	out
}
@end
