slot: threshold int
test: list=10,20,30,40 threshold=45
expect: => i=1 r=0.0 ok=true s="summed pairs with retries: 1" errors=0 n=2 res=[30,45] cache=0 hits=0
test: list=5,10,15,20 threshold=20
expect: => i=1 r=0.0 ok=true s="summed pairs with retries: 1" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var w = 0;
	var retries = 0;
	var idx = 0;
	while idx + 1 < g.n {
		var s = g.res[idx] + g.res[idx + 1];
		if s > limit {
			s = limit;
			retries++;
		}
		g.res[w] = s;
		w++;
		idx += 2;
	}
	if idx < g.n {
		g.res[w] = g.res[idx];
		w++;
	}
	g.n = w;
	out.i = retries;
	out.s.clear();
	format(out.s, "summed pairs with retries: ", retries);
	out
}
@end
