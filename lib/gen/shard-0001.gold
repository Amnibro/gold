noun: average
modifier: running
context: transform
phrase: limit average running threshold {max_avg}
phrase: clamp running average bounded by {max_avg}
phrase: maintain running average within limit {max_avg}
slot: max_avg int
test: list=10,30,50,40 max_avg=25
expect: => i=2 r=0.0 ok=true s="limited running average clamped=2" errors=0 n=4 res=[10,30,35,25] cache=0 hits=0
test: list=5,20,35 max_avg=15
expect: => i=1 r=0.0 ok=true s="limited running average clamped=1" errors=0 n=3 res=[5,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_avg};
	var sum = 0;
	var clamped = 0;
	for i in g.n {
		let count = i + 1;
		let max_allowed = cap * count - sum;
		if g.res[i] > max_allowed {
			g.res[i] = max_allowed;
			clamped++;
		}
		sum += g.res[i];
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited running average clamped=", clamped);
	out
}
@end
