code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 || g.n < 2 {
		gold_fail(g, "insufficient items or invalid limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid pairs request");
		return out;
	}
	var total_pairs = g.n / 2;
	let count = if total_pairs < lim { total_pairs } else { lim };
	for k in count {
		let a = g.res[2 * k];
		let b = g.res[2 * k + 1];
		g.res[k] = a + b;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "returned ", count, " pairs");
	out
}
@end
