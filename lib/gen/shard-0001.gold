	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid = g.res[g.n / 2];
	g.steps += 1;
	out.i = mid;
	out.s.clear();
	format(out.s, "middle sorted observation: ", mid);
	out
}
@end
