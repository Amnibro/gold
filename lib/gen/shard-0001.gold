kind: step
verb: pair
noun: total
modifier: times
context: retry
phrase: pair total times with repeat {times}
phrase: sum adjacent pairs repeat times {times}
phrase: reduce pairs total repeat times {times}
slot: times int
test: list=1,2,3,4 times=1
expect: => i=1 r=0.0 ok=true s="reduced pairs for 1 rounds" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=5 times=1
expect: => i=0 r=0.0 ok=false s="error: insufficient items" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 {
		gold_fail(g, "invalid repeat times");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive times");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "not enough items to pair");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var rounds = 0;
	while rounds < t && g.n >= 2 {
		let pairs = g.n / 2;
		for k in pairs {
			g.res[k] = g.res[k * 2] + g.res[k * 2 + 1];
		}
		g.n = pairs;
		rounds++;
	}
	g.steps += rounds;
	out.i = rounds;
	out.s.clear();
	format(out.s, "reduced pairs for ", rounds, " rounds");
	out
}
@end
