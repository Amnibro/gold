kind: step
verb: select
noun: average
modifier: nested
context: core
phrase: select average of nested block size {block}
phrase: compute nested average across chunks of {block}
phrase: aggregate nested averages with block {block}
slot: block int
test: list=10,20,30,40 block=2
expect: => i=50 r=0.0 ok=true s="selected 2 nested averages" errors=0 n=2 res=[15,35] cache=0 hits=0
test: list=1,2,3,4,5,6 block=3
expect: => i=7 r=0.0 ok=true s="selected 2 nested averages" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block};
	if b <= 0 || g.n < b {
		gold_fail(g, "invalid block size for nested average");
		out.ok = false;
		return out;
	}
	var num_blocks = g.n / b;
	var total_avg = 0;
	for k in num_blocks {
		var sum = 0;
		for j in b {
			sum += g.res[k * b + j];
		}
		let avg = sum / b;
		g.res[k] = avg;
		total_avg += avg;
	}
	g.steps += g.n;
	g.n = num_blocks;
	out.i = total_avg;
	out.s.clear();
	format(out.s, "selected ", num_blocks, " nested averages");
	out
}
@end
