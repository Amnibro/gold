@entry 0da94ca043d3db2d
kind: step
verb: map
noun: items
modifier: with_cache
context: core
phrase: map items with cache lookups using {fn}
phrase: transform items using {fn} caching results
phrase: apply function {fn} with cache lookups
slot: fn fn
test: list=2,3,2,4 fn=double
expect: => i=1 r=0.0 ok=true s="mapped items with cache hits 1" errors=0 n=4 res=[4,6,4,8] cache=3 hits=1
test: list=1,2,1,3 fn=square
expect: => i=1 r=0.0 ok=true s="mapped items with cache hits 1" errors=0 n=4 res=[1,4,1,9] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cached_val, hit = gold_cache_get(g, x);
		if hit {
			g.res[k] = cached_val;
		} else {
			let mapped = ${fn}(x);
			gold_cache_put(g, x, mapped);
			g.res[k] = mapped;
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "mapped items with cache hits ", g.hits);
	out
}
@end
