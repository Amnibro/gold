slot: k int
test: text="streamlined" k=4
expect: => i=4 r=0.0 ok=true s="ined" errors=0 n=0 res=[] cache=0 hits=0
test: text="transform" k=3
expect: => i=3 r=0.0 ok=true s="orm" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let suf_len = ${k};
	if out.s.len <= suf_len {
		out.i = out.s.len;
		return out;
	}
	var new_s byte[>..] = [];
	let start = out.s.len - suf_len;
	var idx = start;
	while idx < out.s.len {
		new_s.push(out.s[idx]);
		idx++;
	}
	out.s.clear();
	for b in new_s { out.s.push(b); }
	out.i = suf_len;
	out
}
@end
