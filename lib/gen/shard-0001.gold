test: list=10,14,20,25
expect: => i=15 r=0.0 ok=true s="mapped 3 pairwise gaps with total 15" errors=0 n=3 res=[4,6,5] cache=0 hits=0
test: list=1,5,12,20
expect: => i=19 r=0.0 ok=true s="mapped 3 pairwise gaps with total 19" errors=0 n=3 res=[4,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for pairwise gaps");
		out.ok = false;
		return out;
	}
	var count = g.n - 1;
	var total_gap = 0;
	for k in count {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		g.res[k] = diff;
		total_gap += diff;
	}
	g.steps += count;
	g.n = count;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "mapped ", count, " pairwise gaps with total ", total_gap);
	out
}
@end
