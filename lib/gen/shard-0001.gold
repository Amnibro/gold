expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,1,3,5] cache=0 hits=0
test: list=10,15,20,25
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var en = 0;
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		} else {
			odds[on] = g.res[i];
			on++;
		}
	}
	gold_clear(g);
	for i in en { gold_push(g, evens[i]); }
	for i in on { gold_push(g, odds[i]); }
	out.i = en;
	g.steps += g.n + 1;
	out
}
@end
@entry 86ffa4f5a0c6b3d4
