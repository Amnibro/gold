@entry de1671501899835f
kind: step
verb: trace
noun: window
modifier: every_other
context: transform
phrase: trace sliding window of size {sz} on every other step
phrase: sample sliding window of width {sz} every other position
phrase: capture window sums of size {sz} every second index
slot: sz int
test: list=1,2,3,4,5,6 sz=2
expect: => i=3 r=0.0 ok=true s="sampled windows count 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=2,4,6,8,10,12 sz=3
expect: => i=2 r=0.0 ok=true s="sampled windows count 2" errors=0 n=2 res=[12,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w_size = ${sz};
	var temp int[512] = [0; 512];
	var tn = 0;
	if w_size > 0 && w_size <= g.n {
		var idx = 0;
		while idx + w_size <= g.n {
			var sum = 0;
			for j in w_size {
				sum += g.res[idx + j];
			}
			temp[tn] = sum;
			tn++;
			idx += 2;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	g.n = tn;
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "sampled windows count ", tn);
	out
}
@end
@entry 9e4dcbe1fcdf98c7
kind: step
verb: rotate
noun: evens
modifier: sorted
context: transform
phrase: rotate sorted even numbers across sequence
phrase: cycle sorted even elements into shifted positions
phrase: rearrange even items in sorted cyclical order
test: list=8,1,4,3,6,5
expect: => i=3 r=0.0 ok=true s="sorted and rotated 3 evens" errors=0 n=6 res=[8,1,4,3,6,5] cache=0 hits=0
test: list=12,7,2,9,4
expect: => i=3 r=0.0 ok=true s="sorted and rotated 3 evens" errors=0 n=5 res=[12,7,2,9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[en] = g.res[k];
			en++;
		}
	}
	if en > 1 {
		for i in en {
			for j in i + 1..en {
				if evens[i] > evens[j] {
					let t = evens[i];
					evens[i] = evens[j];
					evens[j] = t;
				}
			}
		}
		let last = evens[en - 1];
		var i = en - 1;
		while i > 0 {
			evens[i] = evens[i - 1];
			i--;
		}
		evens[0] = last;
		var idx = 0;
		for k in g.n {
			if g.res[k] % 2 == 0 {
				g.res[k] = evens[idx];
				idx++;
			}
		}
	}
	g.steps += en;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted and rotated ", en, " evens");
	out
}
@end
