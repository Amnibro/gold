expect: => i=0 r=0.0 ok=false s="error: pairwise validation failed at index 0" errors=1 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise validation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var valid = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		if !${check}(diff) {
			gold_fail(g, "pairwise check failed");
			out.ok = false;
			out.i = k;
			out.s.clear();
			format(out.s, "error: pairwise validation failed at index ", k);
			return out;
		}
		valid++;
	}
	g.steps += valid;
	out.i = valid;
	out.s.clear();
	format(out.s, "validated ", valid, " pairs successfully");
	out
}
@end
