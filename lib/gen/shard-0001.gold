code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = if out.s.len % 2 == 0 { out.s.len - 2 } else { out.s.len - 1 };
	while i < j {
		let tmp = out.s[i];
		out.s[i] = out.s[j];
		out.s[j] = tmp;
		i += 2;
		j -= 2;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
