test: list=10,20,15 floor=12
expect: => i=15 r=0.0 ok=true s="minimum at least floor is 15" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var found = false;
	var mn = 0;
	for i in g.n {
		if g.res[i] >= fl {
			if !found || g.res[i] < mn {
				mn = g.res[i];
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no elements meet floor");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	g.n = 1;
	g.res[0] = mn;
	out.i = mn;
	out.s.clear();
	format(out.s, "minimum at least floor is ", mn);
	out
}
@end
