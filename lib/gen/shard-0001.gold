expect: => i=0 r=0.0 ok=true s="safely retried 0 non primes" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	var modified = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if !is_p {
			g.res[k] = fb;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "safely retried ", modified, " non primes");
	out
}
@end
