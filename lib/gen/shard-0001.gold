expect: => i=15 r=0.0 ok=true s="pairwise average count: 2" errors=0 n=2 res=[15,40] cache=0 hits=0
test: list=4,8,12,16
expect: => i=6 r=0.0 ok=true s="pairwise average count: 2" errors=0 n=2 res=[6,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough elements for pairwise");
		out.ok = false;
		return out;
	}
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = (g.res[2 * k] + g.res[2 * k + 1]) / 2;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "pairwise average count: ", pairs);
	out
}
@end
