test: list=100,50,20,40,30 count=3
expect: => i=3 r=0.0 ok=true s="sorted tail first 3 items" errors=0 n=5 res=[100,20,40,50,30] cache=0 hits=0
test: list=10,20 count=0
expect: => i=0 r=0.0 ok=false s="error: invalid count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 || cnt >= g.n {
		gold_fail(g, "invalid tail count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid count");
		return out;
	}
	for i in cnt {
		for j in cnt - 1 - i {
			let idx = 1 + j;
			if g.res[idx] > g.res[idx + 1] {
				let tmp = g.res[idx];
				g.res[idx] = g.res[idx + 1];
				g.res[idx + 1] = tmp;
			}
		}
	}
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "sorted tail first ", cnt, " items");
	out
}
@end
