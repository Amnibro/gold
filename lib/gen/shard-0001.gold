slot: check pred
test: list=1,2,50,60 check=over_100
expect: => i=110 r=0.0 ok=true s="retry head pairwise matched at step 3" errors=0 n=4 res=[1,2,50,60] cache=0 hits=0
test: list=3,5,7,9 check=is_even
expect: => i=8 r=0.0 ok=true s="retry head pairwise matched at step 1" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var steps = 0;
	var i = 0;
	while i + 1 < g.n {
		steps++;
		let s = g.res[i] + g.res[i + 1];
		if ${check}(s) {
			found = true;
			out.i = s;
			break;
		}
		i++;
	}
	g.steps += steps;
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "retry head pairwise matched at step ", steps);
	} else {
		gold_fail(g, "retry head pairwise: condition not met");
		format(out.s, "retry head pairwise failed");
	}
	out
}
@end
