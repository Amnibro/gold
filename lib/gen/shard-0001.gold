noun: gaps
modifier: every_other
context: loop
phrase: join alternate gaps across sequence
phrase: accumulate every other gap between items
test: list=1,3,4,8,9,14
expect: => i=11 r=0.0 ok=true s="joined alternate gaps sum: 11" errors=0 n=6 res=[1,3,4,8,9,14] cache=0 hits=0
test: list=10,20
expect: => i=10 r=0.0 ok=true s="joined alternate gaps sum: 10" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gap_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		gap_sum += g.res[i + 1] - g.res[i];
		i += 2;
	}
	g.steps += i;
