noun: steps
modifier: last
context: filter
phrase: return last {count} steps
phrase: keep only last {count} steps from sequence
phrase: extract last {count} steps
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="returned last 3 steps" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="returned last 2 steps" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n == 0 {
		gold_fail(g, "no steps to filter");
		out.ok = false;
		return out;
	}
	let keep = if k <= 0 { 0 } else if k > g.n { g.n } else { k };
	let offset = g.n - keep;
	for i in keep {
		g.res[i] = g.res[offset + i];
	}
	g.steps += keep;
	g.n = keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "returned last ", keep, " steps");
	out
}
@end
@entry 41a4c92f7ef5ee1e
kind: step
verb: sort
noun: head
modifier: sorted
context: filter
phrase: filter head of {head_size} keeping sorted
phrase: sort head {head_size} elements sorted
phrase: extract head of {head_size} items sorted
slot: head_size int
test: list=9,3,7,2,8 head_size=4
expect: => i=4 r=0.0 ok=true s="filtered and sorted head of 4 items" errors=0 n=4 res=[2,3,7,9] cache=0 hits=0
test: list=5,1,4 head_size=2
expect: => i=2 r=0.0 ok=true s="filtered and sorted head of 2 items" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let h = ${head_size};
	if g.n == 0 {
		gold_fail(g, "empty list for head sort");
		out.ok = false;
		return out;
	}
	let lim = if h <= 0 { 0 } else if h > g.n { g.n } else { h };
	for i in 1..lim {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	g.steps += lim;
	g.n = lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "filtered and sorted head of ", lim, " items");
	out
}
@end
