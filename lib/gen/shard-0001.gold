@entry e7ebdb948783014a
kind: step
verb: clamp
noun: histogram
modifier: at_least
context: error
phrase: clamp histogram counts at least floor {floor}
phrase: restrict histogram frequencies at least {floor}
phrase: bound histogram values at least floor {floor}
slot: floor int
test: list=10,20,10,20,20 floor=2
expect: => i=2 r=0.0 ok=true s="clamped histogram counts at least floor" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,2,3 floor=5
expect: => i=0 r=0.0 ok=false s="error: no histogram count meets floor" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${floor};
	var counts int[512] = [0; 512];
	var cn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i { if g.res[j] == x { seen = true; break; } }
		if !seen {
			var c = 0;
			for k in g.n { if g.res[k] == x { c++; } }
			if c >= f {
				counts[cn] = c;
				cn++;
			}
		}
	}
	for k in cn { g.res[k] = counts[k]; }
	g.n = cn;
	g.steps += g.n * g.n;
	out.i = cn;
	out.s.clear();
	if cn > 0 {
		out.ok = true;
		format(out.s, "clamped histogram counts at least floor");
	} else {
		gold_fail(g, "no histogram count meets floor");
		out.ok = false;
		format(out.s, "error: no histogram count meets floor");
	}
	out
}
@end
