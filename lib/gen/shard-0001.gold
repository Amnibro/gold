@entry 1c3ec229948079c8
kind: step
verb: rotate
noun: value
modifier: with_cache
context: filter
phrase: rotate values by {k} caching displaced item
phrase: cycle sequence by {k} steps with cache
phrase: shift elements by {k} storing head in cache
slot: k int
test: list=1,2,3,4,5 k=1
expect: => i=5 r=0.0 ok=true s="rotated values count 5" errors=0 n=5 res=[5,1,2,3,4] cache=1 hits=0
test: list=10,20,30,40 k=2
expect: => i=4 r=0.0 ok=true s="rotated values count 4" errors=0 n=4 res=[30,40,10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let steps = ${k};
	if g.n > 0 {
		gold_cache_put(g, 0, g.res[0]);
	}
	if g.n > 1 {
		var eff = steps % g.n;
		if eff < 0 { eff += g.n; }
		var temp int[512] = [0; 512];
		for i in g.n {
			let dest = (i + eff) % g.n;
			temp[dest] = g.res[i];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated values count ", g.n);
	out
}
@end
