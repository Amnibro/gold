fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_len};
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	var added = 0;
	while g.n < tgt && g.n < 512 {
		gold_push(g, last_val);
		added++;
	}
	g.steps += added + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "target checkpoint length: ", g.n);
	out
}
@end
