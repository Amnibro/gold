fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	var suffix_sum = 0;
	var count = l;
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	for k in count {
		let idx = g.n - 1 - k;
		suffix_sum += g.res[idx];
	}
	g.steps += count;
	out.i = suffix_sum;
	out.s.clear();
	format(out.s, "measured suffix sum ", suffix_sum);
	out
}
@end
