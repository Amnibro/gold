phrase: traverse items in loop until {p}
slot: p pred
test: list=10,20,35,40 p=is_odd
expect: => i=2 r=0.0 ok=true s="matched at index 2" errors=0 n=4 res=[10,20,35,40] cache=0 hits=0
test: list=2,4,6 p=is_one
expect: => i=-1 r=0.0 ok=false s="no element satisfied condition" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_idx = -1;
	for k in g.n {
		if ${p}(g.res[k]) {
			found_idx = k;
			break;
		}
	}
	if found_idx >= 0 {
		g.steps += found_idx + 1;
		out.i = found_idx;
		out.ok = true;
		out.s.clear();
		format(out.s, "matched at index ", found_idx);
	} else {
		g.steps += g.n;
		out.i = -1;
		out.ok = false;
		out.s.clear();
		format(out.s, "no element satisfied condition");
	}
	out
}
@end
@entry 3fbd48016ec370d7
kind: step
verb: swap
noun: limit
modifier: in_reverse
context: list
phrase: swap items in reverse up to limit {limit}
phrase: exchange elements in reverse up to limit {limit}
phrase: invert pairs in reverse up to limit {limit}
slot: limit int
test: list=1,2,3,4,5,6 limit=1
expect: => i=1 r=0.0 ok=true s="performed 1 reverse swaps" errors=0 n=6 res=[6,2,3,4,5,1] cache=0 hits=0
test: list=10,20,30,40 limit=2
expect: => i=2 r=0.0 ok=true s="performed 2 reverse swaps" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 {
		gold_fail(g, "negative swap limit");
		out.ok = false;
		return out;
	}
	let total_pairs = g.n / 2;
	let do_swaps = if lim > total_pairs { total_pairs } else { lim };
	for i in do_swaps {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += do_swaps;
	out.i = do_swaps;
	out.s.clear();
	format(out.s, "performed ", do_swaps, " reverse swaps");
	out
}
@end
