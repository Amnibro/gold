	g.n = w;
	out.s.clear();
	var start = w - k;
	if start < 0 { start = 0; }
	var idx = start;
	while idx < w {
		if idx > start { out.s.push(','); }
		format(out.s, g.res[idx]);
		idx++;
	}
	out.i = w;
	out
}
@end
