code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${min_val};
	let high = ${max_val};
	if low > high {
		gold_fail(g, "invalid range bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: lower bound exceeds upper bound");
		return out;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			var seen = false;
			for j in i {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				gold_cache_put(g, x, x);
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " unique items in range");
	out
}
@end
