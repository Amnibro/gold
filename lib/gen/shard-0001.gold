@entry 3845580904f8115e
kind: step
verb: keep
noun: minimum
modifier: all
context: compare
phrase: keep all occurrences of minimum value
phrase: filter list retaining only smallest elements
test: list=2,5,2,8,2
expect: => i=3 r=0.0 ok=true s="retained minimum elements count: 3" errors=0 n=3 res=[2,2,2] cache=0 hits=0
test: list=7,3,3,9
expect: => i=2 r=0.0 ok=true s="retained minimum elements count: 2" errors=0 n=2 res=[3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == min_val {
			g.res[count] = min_val;
			count++;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "retained minimum elements count: ", count);
	out
}
@end
