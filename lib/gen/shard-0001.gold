test: list=10,20,15
expect: => i=2 r=0.0 ok=true s="computed 2 pairwise minimums" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two elements for pairwise minimum");
		out.ok = false;
		return out;
	}
	var pairs = g.n - 1;
	for k in pairs {
		let a = g.res[k];
		let b = g.res[k + 1];
		g.res[k] = if a < b { a } else { b };
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "computed ", pairs, " pairwise minimums");
	out
}
@end
