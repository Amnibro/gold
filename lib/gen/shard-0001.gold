expect: => i=2 r=0.0 ok=true s="kept tail of 2 items" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${skip};
	if s < 0 || s >= g.n {
		gold_fail(g, "invalid skip offset");
		out.ok = false;
		return out;
	}
	let rem = g.n - s;
	for i in rem {
		g.res[i] = g.res[i + s];
	}
	g.steps += g.n;
	g.n = rem;
	out.i = rem;
	out.s.clear();
	format(out.s, "kept tail of ", rem, " items");
	out
}
@end
