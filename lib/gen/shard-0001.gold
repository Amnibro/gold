fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	var min_val = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			if kept == 0 || x < min_val { min_val = x; }
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = min_val;
	out.s.clear();
	format(out.s, "selected ", kept, " items with minimum ", min_val);
	out
}
@end
