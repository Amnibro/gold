context: loop
phrase: swap primes difference up to {limit}
phrase: prime gap above below up to {limit}
phrase: difference of nearest primes up to {limit}
slot: limit int
test: arg=8,7 limit=10
expect: 4
expect: 0
test: arg=14 limit=10
expect: 4
code:
fn ${ID}(n int) int {
	let lim = ${limit};
	var x = if n < 2 { 2 } else { n };
	var lower = x;
	while lower >= 2 {
		var is_p = true;
		var d = 2;
		while d * d <= lower {
			if lower % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { break; }
		lower--;
	}
	var upper = x;
	while upper <= x + lim {
		var is_p = true;
		var d = 2;
		while d * d <= upper {
			if upper % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { break; }
		upper++;
	}
	upper - lower
}
@end
