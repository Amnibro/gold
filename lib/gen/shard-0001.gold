code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${step_size};
	if g.n < 2 || step <= 0 {
		out.ok = false;
		return out;
	}
	let start = g.res[0];
	let end = g.res[1];
	gold_clear(g);
	var cur = start;
	while cur <= end {
		gold_push(g, cur);
		cur += step;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
