test: list=2,4,2,6,3,4 cond=is_even
expect: => i=3 r=0.0 ok=true s="filtered 3 unique items" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,3,5 cond=is_even
expect: => i=0 r=0.0 ok=true s="filtered 0 unique items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results to filter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " unique items");
	out
}
@end
