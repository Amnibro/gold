expect: => i=3 r=0.0 ok=true s="collected streak of 3 items" errors=0 n=3 res=[9,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var best_start = 0;
	var best_len = 0;
	var cur_start = 0;
	var cur_len = 0;
	for k in g.n {
		if ${p}(g.res[k]) {
			if cur_len == 0 {
				cur_start = k;
			}
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 0;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.steps += g.n;
	g.n = best_len;
	out.i = best_len;
	out.s.clear();
	format(out.s, "collected streak of ", best_len, " items");
	out
}
@end
