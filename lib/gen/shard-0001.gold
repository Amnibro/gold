fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_drop};
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var dropped = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 && dropped < lim {
			dropped++;
		} else {
			new_res[new_n] = x;
			new_n++;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " odds with retry");
