expect: => i=2 r=0.0 ok=true s="zeros kept within limit: 2" errors=0 n=2 res=[0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gaps};
	var zeros = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] == 0 {
			if zeros < mg {
				g.res[kept] = 0;
				kept++;
				zeros++;
			}
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = zeros;
	out.s.clear();
	format(out.s, "zeros kept within limit: ", zeros);
	out
}
@end
