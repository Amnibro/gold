		let c = out.s[i];
		if c == '(' { in_nest = true; }
		else if c == ')' { in_nest = false; }
		else if in_nest && ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
			count++;
		}
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "nested letter count ", count);
	out
}
