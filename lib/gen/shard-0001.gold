@entry e91fff24d9b3952d
kind: step
verb: find
noun: primes
modifier: pairwise
context: search
phrase: find primes pairwise adjacent sum
phrase: locate adjacent pair with prime sum
test: list=4,3,6,8
expect: => i=0 r=0.0 ok=true s="first prime pair at index: 0" errors=0 n=4 res=[4,3,6,8] cache=0 hits=0
test: list=4,6,8,10
expect: => i=-1 r=0.0 ok=false s="first prime pair at index: -1" errors=0 n=4 res=[4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_idx = -1;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		var is_p = true;
		if s < 2 { is_p = false; }
		var d = 2;
		while d * d <= s {
			if s % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			pair_idx = i;
			break;
		}
		i++;
	}
	g.steps += (i + 1);
	out.i = pair_idx;
	out.ok = (pair_idx >= 0);
	out.s.clear();
	format(out.s, "first prime pair at index: ", pair_idx);
	out
}
@end
