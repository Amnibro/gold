expect: => i=2 r=0.0 ok=true s="split prefix into 2 nested chunks" errors=0 n=2 res=[100,260] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("invalid chunk size for nested split");
		return out;
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var cur_sum = 0;
	var in_chunk = 0;
	for i in g.n {
		cur_sum += g.res[i];
		in_chunk++;
		if in_chunk == c {
			new_res[new_n] = cur_sum;
			new_n++;
			cur_sum = 0;
			in_chunk = 0;
		}
	}
	if in_chunk > 0 {
		new_res[new_n] = cur_sum;
		new_n++;
	}
	for i in new_n { g.res[i] = new_res[i]; }
	g.n = new_n;
	g.steps += g.n + new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "split prefix into ", new_n, " nested chunks");
	out
}
@end
