phrase: confine each value between limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=5,15,25,35 lo=10 hi=30
expect: => i=2 r=0.0 ok=true s="clamped 2 values" errors=0 n=4 res=[10,15,25,30] cache=0 hits=0
test: list=0,50,100 lo=20 hi=80
expect: => i=2 r=0.0 ok=true s="clamped 2 values" errors=0 n=3 res=[20,50,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if lo > hi {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		return out;
	}
	var changed = 0;
	for k in g.n {
		let x = g.res[k];
		if x < lo {
			g.res[k] = lo;
			changed++;
		} else if x > hi {
			g.res[k] = hi;
			changed++;
		}
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "clamped ", changed, " values");
	out
}
@end
