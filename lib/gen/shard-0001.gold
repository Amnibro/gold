fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end_pos};
	if s < 0 || s >= g.n || e < s || e >= g.n {
		gold_fail(g, "range out of list bounds");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: range out of list bounds");
		return out;
	}
	var sum = 0;
	for k in s..(e + 1) { sum += g.res[k]; }
	g.steps += e - s + 1;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "folded list range sum ", sum);
	out
}
@end
