	var modified = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 && g.res[k] >= thresh {
			g.res[k] *= f;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped ", modified, " odd items");
	out
}
