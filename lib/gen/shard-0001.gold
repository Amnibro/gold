fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var err_idx = -1;
	for k in out.s.len {
		let b = out.s[k];
		if b < 'a' || b > 'z' {
			err_idx = k;
			break;
		}
	}
	if err_idx >= 0 {
		gold_fail(g, "non-lowercase character in text");
		g.steps += err_idx + 1;
		out.i = err_idx;
		out.ok = false;
	} else {
		g.steps += out.s.len;
		out.i = -1;
		out.ok = true;
	}
	out
}
@end
