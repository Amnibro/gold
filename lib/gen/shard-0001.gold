noun: budget
modifier: up_to
context: sort
phrase: run budget up to swap limit
phrase: bounded bubble sort steps {max_ops}
slot: max_ops int
test: list=5,4,3,2,1 max_ops=2
expect: => i=2 r=0.0 ok=true s="bounded swaps performed: 2" errors=0 n=5 res=[4,3,5,2,1] cache=0 hits=0
test: list=1,2,3,4 max_ops=5
expect: => i=0 r=0.0 ok=true s="bounded swaps performed: 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_ops};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n && swaps < limit {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i++;
	}
	g.steps += i;
	out.i = swaps;
	out.s.clear();
	format(out.s, "bounded swaps performed: ", swaps);
	out
}
@end
