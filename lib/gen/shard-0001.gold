code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		i++;
	}
	var j = 0;
	while j < g.n {
		g.res[j] -= min_val;
		gold_cache_put(g, j, g.res[j]);
		j++;
	}
	g.steps += i + j;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized values offset by: ", min_val);
	out
}
@end
