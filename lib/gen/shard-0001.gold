@entry 5f2315aee3700668
kind: step
verb: rotate
noun: streak
modifier: until
context: loop
phrase: rotate streak until first element exceeds {val}
phrase: shift loop circularly until head exceeds {val}
slot: val int
test: list=2,3,8,4 val=5
expect: => i=2 r=0.0 ok=true s="rotated streak by 2 steps" errors=0 n=4 res=[8,4,2,3] cache=0 hits=0
test: list=1,2 val=10
expect: => i=2 r=0.0 ok=true s="rotated streak by 2 steps" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var shifts = 0;
	while shifts < g.n && g.res[0] <= target {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	g.steps += shifts * g.n;
	out.i = shifts;
	out.s.clear();
	format(out.s, "rotated streak by ", shifts, " steps");
	out
}
@end
