	var out = v;
	var s = 0;
	for i in g.n { s += g.res[i]; }
	if s < 0 {
		s = 0;
		for i in g.n {
			let val = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
			s += val;
		}
	}
	out.i = s;
	g.steps += g.n;
	out
}
@end
