code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rc = ${reject_code};
	var added = 0;
	for k in g.n {
		if g.res[k] != rc && out.s.len < 190 {
			out.s.push((g.res[k] % 128) as byte);
			added++;
		}
	}
	g.steps += g.n;
	out.i = added;
	out
}
@end
