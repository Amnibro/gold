code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 {
		gold_fail(g, "no items to filter");
		out.ok = false;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		g.res[kept] = if x > thresh { thresh } else { x };
		kept++;
		i += 2;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "mapped every other item under threshold ", thresh);
	out
}
@end
