code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		let val, found = gold_cache_get(g, x);
		if !found {
			g.res[kept] = x;
			kept++;
		} else {
			dropped++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped cached items count: ", dropped);
	out
}
