phrase: flip initial prefix of {count} steps
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed first 3 steps" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
