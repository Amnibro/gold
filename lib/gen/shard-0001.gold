expect: => i=0 r=0.0 ok=true s="scaled 0 items against last" errors=0 n=4 res=[5,6,7,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.s.clear();
		format(out.s, "scaled 0 items against last");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var scaled = 0;
	for k in g.n - 1 {
		if g.res[k] < last_val {
			g.res[k] *= f;
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " items against last");
	out
}
@end
@entry 9c117c27793f94e5
kind: step
verb: check
noun: threshold
modifier: with_retry
context: compare
phrase: check compare threshold {limit} with retry count {attempts}
phrase: verify threshold {limit} with retry attempts {attempts}
slot: limit int
slot: attempts int
test: list=4,5 limit=5 attempts=2
expect: => i=2 r=0.0 ok=true s="threshold checked with 2 retries" errors=0 n=2 res=[5,5] cache=0 hits=0
test: list=1 limit=5 attempts=1
expect: => i=1 r=0.0 ok=false s="threshold checked with 1 retries" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let max_retry = ${attempts};
	var retries = 0;
	var done = false;
	while retries < max_retry && !done {
		done = true;
		for k in g.n {
			if g.res[k] < lim {
				g.res[k] += 1;
				done = false;
			}
		}
		retries++;
	}
	g.steps += retries;
	out.i = retries;
	out.ok = done;
	out.s.clear();
	format(out.s, "threshold checked with ", retries, " retries");
	out
}
@end
