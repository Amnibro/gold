expect: => i=3 r=0.0 ok=true s="found 3 unique values matching condition" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements to check condition");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if ${check}(x) {
			var seen = false;
			for j in count {
				if tmp[j] == x { seen = true; break; }
			}
			if !seen {
				tmp[count] = x;
				count++;
			}
		}
	}
	for i in count {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " unique values matching condition");
	out
}
@end
