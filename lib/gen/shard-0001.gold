code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_odds};
	if m < 0 {
		gold_fail(g, "negative odd limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative odd limit");
		return out;
	}
	var kept = 0;
	var odds_seen = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			if odds_seen < m {
				g.res[kept] = g.res[i];
				kept++;
				odds_seen++;
			}
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = odds_seen;
	out.s.clear();
	format(out.s, "limited odds to ", odds_seen, " times");
	out
}
@end
