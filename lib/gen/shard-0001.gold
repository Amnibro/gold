expect: => i=3 r=0.0 ok=false s="suffix not sorted" errors=1 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${length};
	if len < 2 {
		gold_fail(g, "length must be at least 2");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid suffix length");
		return out;
	}
	if len > g.n {
		gold_fail(g, "suffix length exceeds array size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: suffix exceeds size");
		return out;
	}
	var sorted = true;
	let start = g.n - len;
	for k in start..(g.n - 1) {
		if g.res[k] > g.res[k + 1] {
			sorted = false;
			break;
		}
	}
	g.steps += len;
	out.ok = sorted;
	out.i = len;
	out.s.clear();
	if sorted {
		format(out.s, "suffix of length ", len, " is sorted");
	} else {
		gold_fail(g, "suffix is not sorted");
		format(out.s, "suffix not sorted");
	}
	out
}
@end
