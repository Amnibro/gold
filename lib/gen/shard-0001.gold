fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq == 1 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += (g.n * g.n);
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique elements retained: ", kept);
	out
}
@end
