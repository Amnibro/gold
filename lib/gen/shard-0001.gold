test: list=1,2,4 min_steps=2
expect: => i=1 r=0.0 ok=true s="kept 1 items with required steps" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_steps};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var cur = x;
		var steps = 0;
		while cur > 1 && steps < 100 {
			if cur % 2 == 0 {
				cur = cur / 2;
			} else {
				cur = 3 * cur + 1;
			}
			steps++;
		}
		if steps >= req {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items with required steps");
	out
}
@end
