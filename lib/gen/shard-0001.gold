			if g.res[k] > lim { g.res[k] = lim; }
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	if prime_count > 0 {
		out.ok = true;
		format(out.s, "clamped primes until limit");
	} else {
		gold_fail(g, "no primes found to clamp");
		out.ok = false;
		format(out.s, "error: no primes found to clamp");
	}
	out
}
