expect: => i=0 r=0.0 ok=true s="cached 0 window sums" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	let req = ${min_sum};
	if w <= 0 || w > g.n {
		out.i = 0;
		out.s.clear();
		format(out.s, "invalid window size");
		return out;
	}
	let windows = g.n - w + 1;
	var count = 0;
	for i in windows {
		var s = 0;
		for j in w { s += g.res[i + j]; }
		if s >= req {
			gold_cache_put(g, i, s);
			count++;
		}
	}
	g.steps += windows * w;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " window sums");
	out
}
@end
