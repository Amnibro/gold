	var current_sum = 0;
	var kept = 0;
	for i in g.n {
		if current_sum + g.res[i] <= c {
			current_sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = current_sum;
	out.s.clear();
	format(out.s, "capped sum: ", current_sum);
	out
}
@end
