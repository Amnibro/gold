code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_ok = true;
	for i in g.n {
		if !${pred_fn}(g.res[i]) {
			all_ok = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = all_ok;
	out.i = if all_ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all elements satisfied predicate: ", all_ok);
	out
}
@end
@entry be7dc6830ba17d0a
kind: step
verb: dedupe
noun: number
modifier: any
context: compare
phrase: dedupe number occurrences across all results
phrase: eliminate repeated values anywhere in list
test: list=3,1,3,2,1
expect: => i=3 r=0.0 ok=true s="deduped to distinct items: 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="deduped to distinct items: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var dup = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				dup = true;
				break;
			}
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to distinct items: ", kept);
	out
}
@end
