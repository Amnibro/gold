code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 1..g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = tmp;
			j--;
		}
	}
	g.steps += (g.n * g.n);
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted elements count: ", g.n);
	out
}
@end
