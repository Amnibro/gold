phrase: generate primes up to {limit}
slot: limit int
test: list=1 limit=10
expect: => i=4 r=0.0 ok=true s="primes added count: 4" errors=0 n=5 res=[1,2,3,5,7] cache=0 hits=0
test: list=0 limit=5
expect: => i=3 r=0.0 ok=true s="primes added count: 3" errors=0 n=4 res=[0,2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var added = 0;
	var p = 2;
	while p <= lim && g.n < 512 {
		var is_p = true;
		var d = 2;
		while d * d <= p {
			if p % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, p);
			added++;
		}
		p++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "primes added count: ", added);
	out
}
@end
@entry bffefdf2fc585f68
