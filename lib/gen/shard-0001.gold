@entry 066314bb2352fb16
kind: step
verb: map
noun: checkpoint
modifier: pairwise
context: filter
phrase: filter pairs applying function {f} to adjacent items
phrase: map pairwise differences using function {f}
phrase: transform adjacent pairs with function {f}
slot: f fn
test: list=2,5,9,14 f=inc
expect: => i=3 r=0.0 ok=true s="mapped pairs count 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20,35 f=double
expect: => i=2 r=0.0 ok=true s="mapped pairs count 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		g.res[k] = ${f}(diff);
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped pairs count ", g.n);
	out
}
