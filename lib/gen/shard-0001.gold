fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var best = 1;
	var cur = 1;
	for i in g.n - 1 {
		if g.res[i + 1] == g.res[i] {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
	}
	let scaled = best * m;
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled streak is ", scaled);
	out
}
@end
