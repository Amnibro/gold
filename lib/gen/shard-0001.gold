fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted counter safely items=", g.n);
	out
}
@end
