test: text="dcba" max_chars=4
expect: => i=4 r=0.0 ok=true s="abcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" max_chars=0
expect: => i=0 r=0.0 ok=false s="error: invalid text length limit" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_chars};
	if limit <= 0 {
		gold_fail(g, "invalid text length limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid text length limit");
		return out;
	}
	let count = if out.s.len < limit { out.s.len } else { limit };
	for i in count {
		var min_idx = i;
		for j in (i + 1)..count {
			if out.s[j] < out.s[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = out.s[i];
			out.s[i] = out.s[min_idx];
			out.s[min_idx] = tmp;
		}
	}
	g.steps += count * count;
	out.i = count;
	out.ok = true;
	out
}
@end
