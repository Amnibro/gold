phrase: format order rank of each result item
phrase: render relative ranking positions of values
phrase: display ranking numbers across all results
test: list=20,10,30
expect: => i=0 r=0.0 ok=true s="results ranks: [#2, #1, #3] ties=0" errors=0 n=3 res=[20,10,30] cache=0 hits=0
test: list=5,5,10
expect: => i=2 r=0.0 ok=true s="results ranks: [#1, #1, #3] ties=2" errors=0 n=3 res=[5,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var total_ties = 0;
	format(out.s, "results ranks: [");
	var k = 0;
	while k < g.n {
		var below = 0;
		var equal = 0;
		for j in g.n {
			let diff = g.res[j] - g.res[k];
			if diff < 0 { below++; }
			else if diff == 0 { equal++; }
		}
		if k > 0 { format(out.s, ", "); }
		format(out.s, "#", below + 1);
		if equal > 1 { total_ties++; }
		k++;
	}
	format(out.s, "] ties=", total_ties);
	out.i = total_ties;
	g.steps += g.n * g.n;
	out
}
@end
