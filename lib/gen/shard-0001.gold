slot: limit int
test: list=1,2,5 limit=3
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[5,2,1] cache=0 hits=0
test: list=1,2,3 limit=10
expect: => i=1 r=0.0 ok=false s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var trigger = false;
	let lim = ${limit};
	for i in g.n {
		if g.res[i] > lim { trigger = true; break; }
	}
	if trigger {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let t = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = t;
			i++;
			j--;
		}
	} else {
		out.i = 1;
	}
	out.ok = trigger;
	g.steps += g.n;
	out
}
@end
