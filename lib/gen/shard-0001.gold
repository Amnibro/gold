	let sz = ${size};
	let lim = if sz < g.n { sz } else { g.n };
	let before = g.hits;
	for k in lim {
		let c, hit = gold_cache_get(g, g.res[k]);
		if hit { g.res[k] = c; }
	}
	let got_hits = g.hits - before;
	g.steps += lim;
	out.i = got_hits;
	out.s.clear();
	format(out.s, "processed window with ", got_hits, " hits");
	out
}
@end
