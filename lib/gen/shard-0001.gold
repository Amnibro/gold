fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vpos int[200] = [0; 200];
	var vn = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_v = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		           c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
		if is_v && vn < 200 {
			vpos[vn] = i;
			vn++;
		}
	}
	var l = 0;
	var r = vn - 1;
	while l < r {
		let il = vpos[l];
		let ir = vpos[r];
		let tmp = out.s[il];
		out.s[il] = out.s[ir];
		out.s[ir] = tmp;
		l++;
		r--;
	}
	g.steps += out.s.len;
	out.i = vn;
	out
}
