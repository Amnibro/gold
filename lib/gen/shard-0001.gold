@entry 4839bd9d29d4d829
kind: step
verb: retry
noun: words
modifier: up_to
context: loop
phrase: retry words up to limit of {max_words}
phrase: truncate text words up to {max_words}
slot: max_words int
test: text="one two three four" max_words=2
expect: => i=2 r=0.0 ok=true s="one two" errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha beta" max_words=5
expect: => i=5 r=0.0 ok=true s="alpha beta" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_words};
	var words_seen = 0;
	var cut_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] == ' ' {
			words_seen++;
			if words_seen == m {
				cut_idx = i;
				break;
			}
		}
	}
	if cut_idx < out.s.len {
		out.s.resize(cut_idx, 0);
	}
	g.steps += out.s.len;
	out.i = m;
	out
}
@end
