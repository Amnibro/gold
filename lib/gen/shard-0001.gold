kind: step
verb: shift
noun: histogram
modifier: unique
context: error
phrase: shift histogram unique keys with delta {delta}
phrase: apply unique histogram shift with delta {delta}
phrase: update unique histogram counts by delta {delta}
slot: delta int
test: list=10,20,10,30 delta=5
expect: => i=2 r=0.0 ok=true s="shifted 2 unique histogram entries" errors=0 n=4 res=[10,25,10,35] cache=0 hits=0
test: list=10,20 delta=0
expect: => i=0 r=0.0 ok=false s="error: zero delta" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if d == 0 {
		gold_fail(g, "invalid zero delta");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero delta");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty histogram");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var is_uniq bool[512] = [false; 512];
	var unique_count = 0;
	for k in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[k] {
				freq++;
			}
		}
		if freq == 1 {
			is_uniq[k] = true;
			unique_count++;
		}
	}
	var neg_errors = 0;
	for k in g.n {
		if is_uniq[k] {
			g.res[k] += d;
			if g.res[k] < 0 {
				neg_errors++;
			}
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	if neg_errors > 0 {
		gold_fail(g, "unique histogram shift produced negative value");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: ", neg_errors, " negative unique items");
		return out;
	}
	out.s.clear();
	format(out.s, "shifted ", unique_count, " unique histogram entries");
	out
}
@end
