code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var i = 0;
	while i < mid / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[mid - 1 - i];
		g.res[mid - 1 - i] = tmp;
		i++;
	}
	var k = 0;
	while k < mid {
		gold_cache_put(g, k, g.res[k]);
		k++;
	}
	g.steps += mid;
	out.i = mid;
	out.s.clear();
	format(out.s, "prefix reversed items: ", mid);
	out
}
@end
