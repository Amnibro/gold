expect: => i=1 r=0.0 ok=true s="trailing element frequency: 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	for i in g.n {
		if g.res[i] == last_val {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "trailing element frequency: ", count);
	out
}
@end
