code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${item};
	let cached_val, hit = gold_cache_get(g, target);
	var count = 0;
	if hit {
		count = cached_val;
	} else {
		for k in g.n {
			if g.res[k] == target { count++; }
		}
		gold_cache_put(g, target, count);
	}
	g.steps += g.n;
	out.i = count;
	if count == 0 {
		gold_fail(g, "item not found in results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: item not found");
		return out;
	}
	out.s.clear();
	format(out.s, "measured item count ", count, " with cache");
	out
}
@end
