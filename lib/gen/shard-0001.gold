code:
fn ${ID}_mono(g Gold&, idx int) bool {
	if idx + 1 >= g.n { return true; }
	if g.res[idx] > g.res[idx + 1] { return false; }
	${ID}_mono(g, idx + 1)
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ok = ${ID}_mono(g, 0);
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	g.steps += g.n + 1;
	out
}
@end
