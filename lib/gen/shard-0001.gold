fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_val = ${limit};
	var idxs int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] <= max_val {
			idxs[count] = i;
			count++;
		}
	}
	var k = 0;
	while k < count / 2 {
		let a = idxs[k];
		let b = idxs[count - 1 - k];
		let t = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = t;
		k++;
	}
	out.i = count;
	g.steps += g.n + count + 1;
	out
}
@end
