test: list=2,1,4,3,6,5
expect: => i=3 r=0.0 ok=true s="rotated 3 even elements" errors=0 n=6 res=[6,1,2,3,4,5] cache=0 hits=0
test: list=10,11,20,21,30,40
expect: => i=4 r=0.0 ok=true s="rotated 4 even elements" errors=0 n=6 res=[40,11,10,21,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[en] = g.res[k];
			en++;
		}
	}
	if en > 1 {
		let last = evens[en - 1];
		var i = en - 1;
		while i > 0 {
			evens[i] = evens[i - 1];
			i--;
		}
		evens[0] = last;
		var idx = 0;
		for k in g.n {
			if g.res[k] % 2 == 0 {
				g.res[k] = evens[idx];
				idx++;
			}
		}
	}
	g.steps += en;
	out.i = en;
	out.s.clear();
	format(out.s, "rotated ", en, " even elements");
	out
}
@end
