	let c = ${count};
	if c < 2 || c > g.n {
		gold_fail(g, "invalid suffix count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid suffix count");
		return out;
	}
	let start = g.n - c;
	let last_val = g.res[g.n - 1];
	var i = g.n - 1;
	while i > start {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[start] = last_val;
	for k in start..g.n {
		gold_cache_put(g, g.res[k], 1);
	}
	g.steps += c;
	out.i = c;
	out.s.clear();
	format(out.s, "shifted suffix of ", c, " items");
	out
}
@end
