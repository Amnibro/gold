noun: streak
modifier: each
context: error
phrase: swap streak each occurrence exceeding limit {limit}
phrase: swap each streak over threshold {limit}
phrase: exchange each streak matching limit {limit}
slot: limit int
test: list=7,7,7,2,4,4,9 limit=2
expect: => i=2 r=0.0 ok=true s="swapped each streak across 2 occurrences" errors=0 n=7 res=[2,7,7,7,9,4,4] cache=0 hits=0
test: list=1,2,3,4 limit=2
expect: => i=0 r=0.0 ok=false s="error: no qualifying streaks" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 1 {
		gold_fail(g, "invalid streak limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: limit must exceed one");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "list too short for streaks");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: short list");
		return out;
	}
	var streak_swaps = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len >= lim && j < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			streak_swaps++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = streak_swaps;
	if streak_swaps == 0 {
		gold_fail(g, "no streak exceeded limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no qualifying streaks");
		return out;
	}
	out.s.clear();
	format(out.s, "swapped each streak across ", streak_swaps, " occurrences");
	out
}
@end
