fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${floor};
	var max_sum = 0;
	var cur_sum = 0;
	for k in g.n {
		if g.res[k] >= min_v {
			cur_sum += g.res[k];
			if cur_sum > max_sum {
				max_sum = cur_sum;
			}
		} else {
			cur_sum = 0;
		}
	}
	g.steps += g.n;
	gold_push(g, max_sum);
	out.i = max_sum;
	out.s.clear();
	format(out.s, "summed maximum streak nested above floor ", max_sum);
	out
}
@end
