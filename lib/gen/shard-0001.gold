@entry 599222100cc793de
kind: step
verb: retry
noun: series
modifier: nested
context: filter
phrase: retry nested series comparisons up to {max_tries}
phrase: perform nested series retry passes count {max_tries}
slot: max_tries int
test: list=5,4,3,2,1 max_tries=2
expect: => i=2 r=0.0 ok=true s="retried series nested passes 2" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=1,2,3 max_tries=2
expect: => i=1 r=0.0 ok=true s="retried series nested passes 1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tries};
	var passes = 0;
	while passes < mt {
		var any_swap = false;
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				any_swap = true;
			}
		}
		passes++;
		if !any_swap { break; }
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "retried series nested passes ", passes);
	out
}
@end
