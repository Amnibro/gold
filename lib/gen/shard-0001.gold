		gold_fail(g, "suffix exceeds list length");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: suffix exceeds list length");
		return out;
	}
	let start_idx = g.n - slen;
	let val = g.res[start_idx];
	g.steps += g.n;
	out.i = val;
	out.ok = true;
	out.s.clear();
	format(out.s, "returned suffix first value ", val);
	out
}
