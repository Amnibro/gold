@entry e387826ec0ac205f
kind: step
verb: rotate
noun: tail
modifier: times
context: retry
phrase: rotate tail times count {shifts}
phrase: cycle trailing retry elements {shifts} times
slot: shifts int
test: list=1,2,3,4,5 shifts=2
expect: => i=4 r=0.0 ok=true s="tail rotated times: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shifts=1
expect: => i=30 r=0.0 ok=true s="tail rotated times: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let s = ${shifts} % g.n;
	var count = 0;
	while count < s {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
		count++;
	}
	g.steps += count * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "tail rotated times: ", count);
	out
}
@end
