@entry bb26119d4a900998
kind: step
verb: drop
noun: odds
modifier: nested
context: search
phrase: drop odds nested search limit {limit}
phrase: search drop nested odd results cap {limit}
phrase: remove nested odds from search limit {limit}
slot: limit int
test: list=1,2,3,4,5 limit=2
expect: => i=2 r=0.0 ok=true s="dropped 2 nested odd search items" errors=0 n=3 res=[2,4,5] cache=0 hits=0
test: list=7,9 limit=1
expect: => i=1 r=0.0 ok=true s="dropped 1 nested odd search items" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drop = ${limit};
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		let is_odd = g.res[k] % 2 != 0;
		if is_odd && dropped < max_drop {
			dropped++;
		} else {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " nested odd search items");
	out
}
@end
