code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var found = false;
	var idx = g.n - 1;
	while idx >= 0 {
		sum += g.res[idx];
		if g.res[idx] == tgt {
			found = true;
			break;
		}
		idx--;
	}
	out.i = sum;
	out.ok = found;
	out.s.clear();
	format(out.s, "reverse aggregate sum=", sum);
	out
}
@end
