test: text="helium" times=2
expect: => i=0 r=0.0 ok=true s="helium" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cycles = ${times};
	if cycles % 2 != 0 {
		var v_idx int[256] = [0; 256];
		var vn = 0;
		for i in out.s.len {
			let c = out.s[i];
			if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
				v_idx[vn] = i; vn++;
			}
		}
		var i = 0;
		var j = vn - 1;
		while i < j {
			let t = out.s[v_idx[i]];
			out.s[v_idx[i]] = out.s[v_idx[j]];
			out.s[v_idx[j]] = t;
			i++; j--;
		}
		out.i = vn;
	} else {
		out.i = 0;
	}
	g.steps += out.s.len + 1;
	out
}
@end
