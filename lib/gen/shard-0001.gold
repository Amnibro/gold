expect: => i=3 r=0.0 ok=true s="compared against maximum with 3 matches" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for maximum comparison");
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var matched = 0;
	for k in g.n {
		let diff = max_val - g.res[k];
		if ${match}(diff) {
			g.res[k] = 1;
			matched++;
		} else {
			g.res[k] = 0;
		}
	}
	g.steps += g.n * 2;
	out.i = matched;
	out.s.clear();
	format(out.s, "compared against maximum with ", matched, " matches");
	out
}
@end
@entry 104146b2f17e2d85
kind: step
verb: map
noun: window
modifier: while
context: transform
phrase: map window of size {size} while {valid} holds
phrase: transform sliding window {size} while condition {valid} passes
phrase: map window spans of {size} while {valid}
slot: size int
slot: valid pred
test: list=2,4,6,1,3 size=2 valid=is_even
expect: => i=3 r=0.0 ok=true s="mapped 3 windows while valid" errors=0 n=3 res=[6,10,7] cache=0 hits=0
test: list=1,3,2,4 size=2 valid=is_odd
expect: => i=2 r=0.0 ok=true s="mapped 2 windows while valid" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if g.n == 0 || w <= 0 || w > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var out_count = 0;
	var k = 0;
	while k + w <= g.n && ${valid}(g.res[k]) {
		var win_sum = 0;
		for j in w {
			win_sum += g.res[k + j];
		}
		tmp[out_count] = win_sum;
		out_count++;
		k++;
	}
	for i in out_count {
		g.res[i] = tmp[i];
	}
	g.steps += k * w;
	g.n = out_count;
	out.i = out_count;
	out.s.clear();
	format(out.s, "mapped ", out_count, " windows while valid");
	out
}
@end
@entry 321eadb2f8f690d6
kind: step
verb: rotate
noun: range
modifier: in_place
context: transform
phrase: rotate range in place by {offset}
phrase: shift range in place by {offset} steps
phrase: cyclically rotate range in place by {offset}
slot: offset int
test: list=10,20,30,40,50 offset=2
expect: => i=2 r=0.0 ok=true s="rotated range in place by 2" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3 offset=-1
expect: => i=2 r=0.0 ok=true s="rotated range in place by 2" errors=0 n=3 res=[2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "range rotation trivial");
		return out;
	}
	let shift = ((off % g.n) + g.n) % g.n;
	var tmp int[512] = [0; 512];
	for k in g.n {
		let dest = (k + shift) % g.n;
		tmp[dest] = g.res[k];
	}
	for k in g.n {
		g.res[k] = tmp[k];
	}
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated range in place by ", shift);
	out
}
@end
