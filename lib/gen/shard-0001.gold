kind: step
verb: select
noun: runs
modifier: until
context: error
phrase: select runs until {cutoff}
phrase: collect consecutive runs until {cutoff}
phrase: keep runs until reaching {cutoff}
slot: cutoff pred
test: list=2,2,4,1,5 cutoff=is_one
expect: => i=3 r=0.0 ok=true s="selected 3 items until cutoff" errors=0 n=3 res=[2,2,4] cache=0 hits=0
test: list=1,2,3 cutoff=is_one
expect: => i=0 r=0.0 ok=false s="error: cutoff at start" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for run selection");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	if ${cutoff}(g.res[0]) {
		gold_fail(g, "cutoff reached at first element");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cutoff at start");
		return out;
	}
	var kept = 0;
	while kept < g.n {
		if ${cutoff}(g.res[kept]) {
			break;
		}
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " items until cutoff");
	out
}
@end
