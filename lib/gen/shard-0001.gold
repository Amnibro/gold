fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		out.s.append("selected empty suffix");
		return out;
	}
	if g.n > c {
		let start = g.n - c;
		var new_n = 0;
		for k in start..g.n {
			g.res[new_n] = g.res[k];
			new_n++;
		}
		g.n = new_n;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected suffix of ", g.n, " items");
	out
}
@end
