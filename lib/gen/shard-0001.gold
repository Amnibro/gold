code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[64] = [0; 64];
	var count = 0;
	var splits = 0;
	for i in g.n {
		let x = g.res[i];
		if ${pred_split}(x) && count + 1 < 50 {
			let h1 = x / 2;
			let h2 = x - h1;
			temp[count] = h1;
			count++;
			temp[count] = h2;
			count++;
			splits++;
		} else if count < 50 {
			temp[count] = x;
			count++;
		}
	}
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	out.i = splits;
	out.s.clear();
	format(out.s, "split steps count=", splits);
	out
}
@end
