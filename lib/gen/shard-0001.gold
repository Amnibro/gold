code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var left_sum = 0;
	var right_sum = 0;
	for i in mid { left_sum += g.res[i]; }
	for i in mid..g.n { right_sum += g.res[i]; }
	let diff = right_sum - left_sum;
	gold_push(g, diff);
	out.i = diff;
	g.steps += g.n + 1;
	out
}
@end
@entry e0f782251d9c7e04
