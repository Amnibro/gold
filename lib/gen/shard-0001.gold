test: list=30,10,20 shift=1
expect: => i=1 r=0.0 ok=true s="rotated sorted list by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
test: list=5 shift=2
expect: => i=0 r=0.0 ok=false s="error: list too small" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n < 2 {
		gold_fail(g, "list too small to rotate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too small");
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	let k = ((s % g.n) + g.n) % g.n;
	var tmp int[512] = [0; 512];
	for i in g.n {
		let target_idx = (i + k) % g.n;
		tmp[target_idx] = g.res[i];
	}
	for i in g.n { g.res[i] = tmp[i]; }
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated sorted list by ", k);
	out
}
@end
