phrase: evaluate gaps between last {count} elements
slot: count int
test: list=10,20,25,40 count=3
expect: => i=2 r=0.0 ok=true s="computed 2 gaps from last items" errors=0 n=2 res=[5,15] cache=0 hits=0
test: list=1,4,9 count=2
expect: => i=1 r=0.0 ok=true s="computed 1 gaps from last items" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt < 2 || cnt > g.n {
		gold_fail(g, "insufficient items for gaps");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid gaps count");
		return out;
	}
	let start = g.n - cnt;
	let gap_count = cnt - 1;
	for k in gap_count {
		g.res[k] = g.res[start + k + 1] - g.res[start + k];
	}
	g.n = gap_count;
	g.steps += cnt;
	out.i = gap_count;
	out.s.clear();
	format(out.s, "computed ", gap_count, " gaps from last items");
	out
}
@end
