	if out.s.len == 0 {
		gold_fail(g, "empty string for letter scan");
		out.ok = false;
		return out;
	}
	var tmp byte[200] = [0; 200];
	let len = out.s.len;
	for i in len { tmp[i] = out.s[i]; }
	for i in 1..len {
		let key = tmp[i];
		var j = i;
		while j > 0 && tmp[j - 1] > key {
			tmp[j] = tmp[j - 1];
			j--;
		}
		tmp[j] = key;
	}
	out.s.clear();
	for i in len {
		if out.s.len == 0 || out.s[out.s.len - 1] != tmp[i] {
			out.s.push(tmp[i]);
		}
	}
	g.steps += len;
	out.i = out.s.len;
	out
}
