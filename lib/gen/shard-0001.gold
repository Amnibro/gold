context: math
phrase: split range up to {limit}
phrase: generate sequence up to {limit}
phrase: create arithmetic range up to {limit}
slot: limit int
test: input=0 limit=4
expect: => i=4 r=0.0 ok=true s="split 4 numbers" errors=0 n=4 res=[0,1,2,3] cache=0 hits=0
test: input=5 limit=8
expect: => i=3 r=0.0 ok=true s="split 3 numbers" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let start = out.i;
	gold_clear(g);
	if start >= lim {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty range");
		return out;
	}
	var cur = start;
	while cur < lim {
		gold_push(g, cur);
		cur++;
	}
	let count = lim - start;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split ", count, " numbers");
	out
}
@end
