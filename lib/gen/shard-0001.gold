fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.i = 0; return out; }
	var gaps int[256] = [0; 256];
	var gn = 0;
	for i in 0..(g.n - 1) {
		let d = g.res[i + 1] - g.res[i];
		var seen = false;
		for j in gn {
			if gaps[j] == d { seen = true; break; }
		}
		if !seen && gn < 256 {
			gaps[gn] = d;
			gn++;
		}
	}
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "unique adjacent gaps: ", gn);
	out
}
