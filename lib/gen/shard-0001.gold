code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var modified = 0;
	for k in g.n {
		var x = g.res[k];
		if x > c {
			while x > c { x = c; }
			g.res[k] = x;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " items recursively below cap");
	out
}
@end
