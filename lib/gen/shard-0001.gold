fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var streak_count = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == g.res[i] {
			run_len++;
		}
		if run_len >= mr {
			streak_count++;
		}
		i += run_len;
	}
	g.steps += g.n;
	out.i = streak_count;
	out.s.clear();
	format(out.s, "selected runs count ", streak_count);
	out
}
@end
