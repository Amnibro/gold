@entry 67540c36d06edaf4
kind: step
verb: rotate
noun: histogram
modifier: in_place
context: stats
phrase: rotate histogram bin distribution by {shift} in place
phrase: cyclically shift frequency bins by {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n == 0 { return out; }
	let k = if s < 0 { 0 } else { s % g.n };
	for r in k {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	out.i = k;
	g.steps += g.n + 1;
