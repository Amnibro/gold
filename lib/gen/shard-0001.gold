phrase: execute subfunction {sub} with retry checking {stop}
phrase: apply subfunction {sub} retrying until {stop}
slot: sub fn
slot: stop pred
test: input=3 sub=double stop=over_100
expect: => i=192 r=0.0 ok=true s="subfunction completed after 6 retries" errors=0 n=7 res=[3,6,12,24,48,96,192] cache=0 hits=0
test: input=12 sub=halve stop=under_10
expect: => i=6 r=0.0 ok=true s="subfunction completed after 1 retries" errors=0 n=2 res=[12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	gold_push(g, out.i);
	while !${stop}(out.i) {
		out.i = ${sub}(out.i);
		gold_push(g, out.i);
		k++;
		if k >= 50 {
			gold_fail(g, "retry limit reached");
			out.ok = false;
			return out;
		}
	}
	g.steps += k;
	out.s.clear();
	format(out.s, "subfunction completed after ", k, " retries");
	out
}
@end
