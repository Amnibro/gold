code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient elements for pairs");
		return out;
	}
	var count = 0;
	for k in 1..g.n {
		var diff = g.res[k] - g.res[k - 1];
		if diff < 0 {
			diff = -diff;
		}
		if diff > limit {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured ", count, " pairs above threshold");
	out
}
@end
