@entry ec746d6c1dfd6ec0
kind: step
verb: repeat
noun: threshold
modifier: until
context: retry
phrase: repeat threshold until ceiling {max_val}
phrase: multiply retry values until exceeding {max_val}
slot: max_val int
test: list=2,5 max_val=20
expect: => i=6 r=0.0 ok=true s="doubling steps until ceiling: 6" errors=0 n=2 res=[32,20] cache=0 hits=0
test: list=3,10 max_val=15
expect: => i=4 r=0.0 ok=true s="doubling steps until ceiling: 4" errors=0 n=2 res=[24,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_val};
	var steps_done = 0;
	for k in g.n {
		while g.res[k] < ceiling && g.res[k] > 0 {
			g.res[k] *= 2;
			steps_done++;
		}
	}
	g.steps += steps_done + g.n;
	out.i = steps_done;
	out.s.clear();
	format(out.s, "doubling steps until ceiling: ", steps_done);
	out
}
@end
