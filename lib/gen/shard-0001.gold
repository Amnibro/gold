		return out;
	}
	let mid_idx = (g.n - 1) / 2;
	let val = g.res[mid_idx];
	g.steps += g.n;
	out.i = val;
	out.ok = true;
	out.s.clear();
	format(out.s, "returned last middle item ", val);
	out
}
@end
@entry 2daea97f41c3bfc1
kind: step
verb: validate
noun: duplicates
modifier: times
context: error
phrase: validate duplicates appearing {times} times
phrase: check duplicates occurring exactly {times} times
phrase: verify duplicate frequency matches {times} times
slot: times int
test: list=4,4,5,6 times=2
expect: => i=1 r=0.0 ok=true s="validated duplicates matching target times" errors=0 n=4 res=[4,4,5,6] cache=0 hits=0
test: list=1,2,3 times=2
expect: => i=0 r=0.0 ok=false s="error: no duplicates matched target times" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${times};
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i { if g.res[j] == x { seen_before = true; break; } }
		if !seen_before {
			var count = 0;
			for k in g.n { if g.res[k] == x { count++; } }
			if count == req { matched++; }
		}
	}
	g.steps += g.n * g.n;
	out.i = matched;
	out.s.clear();
	if matched > 0 {
		out.ok = true;
		format(out.s, "validated duplicates matching target times");
	} else {
		gold_fail(g, "no duplicates matched target times");
		out.ok = false;
		format(out.s, "error: no duplicates matched target times");
	}
	out
}
@end
@entry f76894a3ae981056
kind: step
verb: rotate
noun: series
modifier: at_most
context: error
phrase: rotate series at most {shift} positions
phrase: shift series bounded by at most {shift}
phrase: perform series rotation at most {shift} steps
slot: shift int
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated series by 1 steps" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=10 shift=3
expect: => i=0 r=0.0 ok=false s="error: invalid rotation bounds" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s <= 0 || s >= g.n {
		gold_fail(g, "invalid rotation bounds");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid rotation bounds");
		return out;
	}
	for step in s {
		let first = g.res[0];
		for k in 1..g.n { g.res[k - 1] = g.res[k]; }
		g.res[g.n - 1] = first;
	}
	g.steps += g.n * s;
	out.i = s;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated series by ", s, " steps");
	out
}
@end
