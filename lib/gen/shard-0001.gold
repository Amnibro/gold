@entry 360347af0216f513
kind: step
verb: select
noun: digits
modifier: unique
context: transform
phrase: select digits unique from input
phrase: extract distinct digits from value
phrase: collect unique digits into results
test: input=4221
expect: => i=3 r=0.0 ok=true s="unique digits found=3" errors=0 n=3 res=[4,2,1] cache=0 hits=0
test: input=98877
expect: => i=3 r=0.0 ok=true s="unique digits found=3" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.i;
	if n < 0 { n = -n; }
	gold_clear(g);
	if n == 0 {
		gold_push(g, 0);
		out.i = 1;
		return out;
	}
	var digits int[10] = [0; 10];
	var count = 0;
	while n > 0 {
		let d = n % 10;
		n /= 10;
		var seen = false;
		for i in count {
			if digits[i] == d { seen = true; }
		}
		if !seen {
			digits[count] = d;
			count++;
		}
	}
	for i in count {
		gold_push(g, digits[count - 1 - i]);
	}
	out.i = count;
	out.s.clear();
	format(out.s, "unique digits found=", count);
	out
}
@end
