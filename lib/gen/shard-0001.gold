expect: => i=2 r=0.0 ok=true s="grouped 2 items up to limit" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "no items to group");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			count++;
			if count >= lim { break; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped ", count, " items up to limit");
	out
}
@end
