	let n = out.s.len;
	for i in n / 2 {
		let j = n - 1 - i;
		let tmp = out.s[i];
		out.s[i] = out.s[j];
		out.s[j] = tmp;
	}
	for i in n {
		out.s[i] = (out.s[i] as int + off) as byte;
	}
	g.steps += n;
	out.i = n;
	out
}
@end
