code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two numbers to swap");
		out.ok = false;
		return out;
	}
	let first = 0;
	let last = g.n - 1;
	let tmp = g.res[first];
	g.res[first] = g.res[last];
	g.res[last] = tmp;
	g.steps += 1;
	out.i = g.res[first];
	out.s.clear();
	format(out.s, "swapped outer numbers");
	out
}
@end
