test: list=20,30 cost=5
expect: => i=0 r=0.0 ok=true s="budget retried with cache 0 times" errors=0 n=2 res=[20,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cost};
	var retries = 0;
	for k in g.n {
		let val, ok = gold_cache_get(g, g.res[k]);
		if ok {
			if val < c {
				gold_cache_put(g, g.res[k], val + 1);
				retries++;
			}
		} else {
			gold_cache_put(g, g.res[k], 1);
		}
	}
	g.steps += g.n;
	out.i = retries;
	out.s.clear();
	format(out.s, "budget retried with cache ", retries, " times");
	out
}
@end
