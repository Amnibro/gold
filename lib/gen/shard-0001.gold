code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 || k > g.n {
		gold_fail(g, "sequence drop count out of range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: sequence drop count out of range");
		return out;
	}
	for i in k {
		gold_cache_put(g, i, g.res[i]);
	}
	let remaining = g.n - k;
	for i in remaining {
		g.res[i] = g.res[i + k];
	}
	g.n = remaining;
	g.steps += g.n + k;
	out.i = k;
	out.s.clear();
	format(out.s, "dropped ", k, " items to cache");
	out
}
@end
