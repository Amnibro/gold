test: list=40,50,30 budget=80
expect: => i=40 r=0.0 ok=false s="error: budget exhausted at index 1" errors=1 n=3 res=[40,50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 {
		gold_fail(g, "invalid running budget");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive budget");
		return out;
	}
	var rem = b;
	var used = 0;
	for k in g.n {
		let cost = g.res[k];
		if cost > rem {
			gold_fail(g, "running retry budget exhausted");
			out.ok = false;
			out.i = rem;
			out.s.clear();
			format(out.s, "error: budget exhausted at index ", k);
			return out;
		}
		rem -= cost;
		used++;
	}
	g.steps += used;
	out.i = rem;
	out.s.clear();
	format(out.s, "remaining running budget ", rem);
	out
}
@end
