code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var fails = 0;
	var w = 0;
	for k in g.n {
		if ${p}(g.res[k]) {
			g.res[w] = g.res[k];
			w++;
		} else {
			fails++;
		}
	}
	if fails > 0 {
		gold_fail(g, "condition failed");
	}
	g.n = w;
	g.steps += g.n;
	out.i = fails;
	out.s.clear();
	format(out.s, "error items detected ", fails);
	out
}
@end
