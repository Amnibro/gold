@entry 5761601e38b94c95
kind: step
verb: rotate
noun: histogram
modifier: safely
context: cache
phrase: rotate cached histogram safely by {shift}
phrase: shift cached histogram positions safely by {shift}
phrase: permute cached histogram entries safely by {shift}
slot: shift int
test: list=10,20,30 shift=1
expect: => i=3 r=0.0 ok=true s="rotated 3 histogram cache entries" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15 shift=0
expect: => i=2 r=0.0 ok=true s="rotated 2 histogram cache entries" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	if g.cn > 1 {
		let off = (s % g.cn + g.cn) % g.cn;
		var tmp int[256] = [0; 256];
		for i in g.cn { tmp[i] = g.cv[i]; }
		for i in g.cn {
			let ni = (i + off) % g.cn;
			g.cv[ni] = tmp[i];
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "rotated ", g.cn, " histogram cache entries");
	out
}
@end
