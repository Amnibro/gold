@entry ba3401fec957f5dd
kind: step
verb: find
noun: cache
modifier: between
context: stats
phrase: find cached percentiles bounded by {min_val} to {max_val}
phrase: filter cached metrics from {min_val} through {max_val}
slot: min_val int
slot: max_val int
test: list=10,25,40,70 min_val=20 max_val=50
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[25,40] cache=4 hits=4
test: list=5,15,35,80 min_val=10 max_val=40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[15,35] cache=4 hits=4
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var found = 0;
	var kept int[512] = [0; 512];
	for i in g.n {
		let val, ok = gold_cache_get(g, i);
		if ok && val >= lo && val <= hi {
			kept[found] = val;
			found++;
		}
	}
	gold_clear(g);
	for i in found { gold_push(g, kept[i]); }
	out.i = found;
	g.steps += g.n + 1;
	out
}
@end
