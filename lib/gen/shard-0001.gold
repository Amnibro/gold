code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${min_val};
	let h = ${max_val};
	if g.n <= 2 {
		out.i = 0;
		out.s.clear();
		out.s.append("no middle items");
		return out;
	}
	var sum = 0;
	var count = 0;
	for k in 1..g.n - 1 {
		let x = g.res[k];
		if x >= l && x <= h {
			sum += x;
			count++;
		}
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded ", count, " middle items sum=", sum);
	out
}
@end
