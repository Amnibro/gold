expect: => i=0 r=0.0 ok=false s="history check found no match" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var matched_val = 0;
	for k in g.n {
		let x = g.res[k];
		if ${cond}(x) {
			found = true;
			matched_val = x;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = if found { matched_val } else { 0 };
	out.s.clear();
	if found {
		format(out.s, "history check passed with value ", matched_val);
	} else {
		format(out.s, "history check found no match");
	}
	out
}
@end
