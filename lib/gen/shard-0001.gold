code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results to filter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if ${cond}(x) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	if kept == 0 {
		gold_fail(g, "no items matched filter condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no items matched");
		return out;
	}
	out.s.clear();
	format(out.s, "filtered and kept ", kept, " items");
	out
}
@end
