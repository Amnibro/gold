fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_run = 1;
	var cur_run = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
	}
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest error run: ", max_run);
	out
}
@end
