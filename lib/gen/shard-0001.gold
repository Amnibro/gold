@entry 65efac4da26445d5
kind: step
verb: scan
noun: minimum
modifier: times
context: filter
phrase: filter items below minimum scaled by {factor}
phrase: scan results dropping values smaller than minimum times {factor}
phrase: retain items at least minimum multiplied by {factor}
slot: factor int
test: list=3,8,2,9,5 factor=2
expect: => i=3 r=0.0 ok=true s="items at least scaled minimum 3" errors=0 n=3 res=[8,9,5] cache=0 hits=0
test: list=10,25,15,40 factor=2
expect: => i=2 r=0.0 ok=true s="items at least scaled minimum 2" errors=0 n=2 res=[25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	let cut = min_val * ${factor};
	var w = 0;
	for k in g.n {
		if g.res[k] >= cut {
			g.res[w] = g.res[k];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "items at least scaled minimum ", w);
	out
}
@end
