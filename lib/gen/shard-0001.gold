@entry 6d3ec0323c5287a4
kind: step
verb: merge
noun: history
modifier: between
context: list
phrase: merge history elements between {start} through {finish}
phrase: sum history slice from index {start} to {finish}
slot: start int
slot: finish int
test: list=10,20,30,40 start=1 finish=3
expect: => i=50 r=0.0 ok=true s="merged slice sum 50" errors=0 n=1 res=[50] cache=0 hits=0
test: list=5,10,15 start=0 finish=2
expect: => i=15 r=0.0 ok=true s="merged slice sum 15" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${finish};
	if s < 0 || e > g.n || s >= e {
		gold_fail(g, "invalid slice bounds");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n {
		if i >= s && i < e {
			sum += g.res[i];
		}
	}
	g.steps += e - s;
	g.n = 1;
	g.res[0] = sum;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged slice sum ", sum);
	out
}
