@entry a2ec5d2e60f2d1d0
kind: step
verb: validate
noun: head
modifier: last
context: retry
phrase: validate head last retry attempt
phrase: check first retry against last value
test: list=1,3,5
expect: => i=4 r=0.0 ok=true s="retry progression valid: 4" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=5,3,1
expect: => i=-4 r=0.0 ok=false s="retry regression: -4" errors=1 n=3 res=[5,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two retries");
		out.ok = false;
		return out;
	}
	let first = g.res[0];
	let last = g.res[g.n - 1];
	g.steps += 1;
	out.i = last - first;
	out.s.clear();
	if first <= last {
		out.ok = true;
		format(out.s, "retry progression valid: ", out.i);
	} else {
		gold_fail(g, "retry regression detected");
		out.ok = false;
		format(out.s, "retry regression: ", out.i);
	}
	out
}
@end
