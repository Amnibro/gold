@entry ab961752dcee8f7f
kind: step
verb: fold
noun: maximum
modifier: last
context: filter
phrase: filter last {k} items finding maximum
phrase: fold trailing {k} elements to maximum value
phrase: compute maximum among final {k} items
slot: k int
test: list=2,8,3,15,7 k=3
expect: => i=15 r=0.0 ok=true s="trailing maximum 15" errors=0 n=3 res=[3,15,7] cache=0 hits=0
test: list=12,4,19,5,1 k=4
expect: => i=19 r=0.0 ok=true s="trailing maximum 19" errors=0 n=4 res=[4,19,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var span = count;
	if span > g.n { span = g.n; }
	if span <= 0 {
		out.i = 0;
		return out;
	}
	let start = g.n - span;
	var max_val = g.res[start];
	for idx in 1..span {
		if g.res[start + idx] > max_val { max_val = g.res[start + idx]; }
	}
	for idx in span {
		g.res[idx] = g.res[start + idx];
	}
	g.n = span;
	g.steps += span;
	out.i = max_val;
	out.s.clear();
	format(out.s, "trailing maximum ", max_val);
	out
}
@end
@entry 60871a8f4880af06
kind: step
verb: keep
noun: gaps
modifier: at_least
context: filter
phrase: keep adjacent items with gap at least {min_step}
phrase: filter elements separated by difference at least {min_step}
phrase: retain values with pairwise spacing at least {min_step}
slot: min_step int
test: list=1,4,5,9,10 min_step=3
expect: => i=3 r=0.0 ok=true s="kept elements meeting min gap 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: list=2,3,6,7,12 min_step=4
expect: => i=2 r=0.0 ok=true s="kept elements meeting min gap 2" errors=0 n=2 res=[2,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${min_step};
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var temp int[512] = [0; 512];
	temp[0] = g.res[0];
	var tn = 1;
	for k in 1..g.n {
		var diff = g.res[k] - g.res[k - 1];
		if diff < 0 { diff = -diff; }
		if diff >= step {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	g.n = tn;
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "kept elements meeting min gap ", tn);
	out
}
@end
