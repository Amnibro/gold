fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_reps};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in w {
			if g.res[j] == x { count++; }
		}
		if count < lim {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped with max reps kept ", w);
