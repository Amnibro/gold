test: list=5,8 ceiling=20
expect: => i=0 r=0.0 ok=true s="clamped cache entries: 0" errors=0 n=2 res=[5,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var count = 0;
	for i in g.cn {
		if g.cv[i] > ceil {
			g.cv[i] = ceil;
			count++;
		}
	}
	if g.n > 0 {
		for i in g.n {
			gold_cache_put(g, i, g.res[i]);
			if g.res[i] > ceil {
				count++;
			}
		}
	}
	g.steps += g.cn + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped cache entries: ", count);
	out
}
@end
