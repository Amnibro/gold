kind: step
verb: count
noun: primes
modifier: until
context: filter
phrase: count prime numbers until reaching limit {max_primes}
phrase: tally primes up to target count {max_primes}
slot: max_primes int
test: list=2,3,5,7,11,13 max_primes=3
expect: => i=3 r=0.0 ok=true s="counted primes until reached 3" errors=0 n=6 res=[2,3,5,7,11,13] cache=0 hits=0
test: list=4,6,8,9 max_primes=2
expect: => i=0 r=0.0 ok=true s="counted primes until reached 0" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_primes};
	var p_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x > 1 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p_count++;
				if p_count >= mp { break; }
			}
		}
	}
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "counted primes until reached ", p_count);
	out
}
@end
