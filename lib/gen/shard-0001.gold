verb: map
noun: histogram
modifier: pairwise
context: loop
phrase: map histogram pairwise bins
phrase: combine adjacent histogram bins pairwise
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="mapped 2 histogram pairs" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=1,3,5
expect: => i=1 r=0.0 ok=true s="mapped 1 histogram pairs" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "mapped ", pairs, " histogram pairs");
	out
}
@end
@entry 7818d8f24d9cd53e
kind: step
verb: sum
noun: average
modifier: sorted
context: loop
phrase: sum sorted values exceeding average
phrase: accumulate elements strictly above mean in sorted results
test: list=2,4,6,8,10
expect: => i=18 r=0.0 ok=true s="sum of values above average: 18" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="sum of values above average: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	var sum_above = 0;
	for i in g.n {
		if g.res[i] > avg { sum_above += g.res[i]; }
	}
	g.steps += g.n;
	out.i = sum_above;
	out.s.clear();
	format(out.s, "sum of values above average: ", sum_above);
	out
}
@end
@entry 05899e39f21251e8
kind: step
verb: merge
noun: step
modifier: between
context: loop
phrase: merge step values between indexes {start} to {end}
phrase: combine step elements bounded by {start} through {end}
slot: start int
slot: end int
test: list=10,20,30,40,50 start=1 end=3
expect: => i=90 r=0.0 ok=true s="merged step range sum: 90" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,2,3 start=0 end=1
expect: => i=3 r=0.0 ok=true s="merged step range sum: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end};
	var merged = 0;
	for i in g.n {
		if i >= s && i <= e {
			merged += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged step range sum: ", merged);
	out
}
@end
@entry 4b30dba68d687770
kind: step
verb: sort
noun: step
modifier: last
context: loop
phrase: sort last {count} items in step loop
phrase: order trailing {count} elements in loop
slot: count int
test: list=1,9,4,3 count=3
expect: => i=3 r=0.0 ok=true s="sorted last 3 elements" errors=0 n=4 res=[1,3,4,9] cache=0 hits=0
test: list=10,8,6 count=2
expect: => i=2 r=0.0 ok=true s="sorted last 2 elements" errors=0 n=3 res=[10,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	let len = g.n - start;
	for i in len {
		for j in 0..(len - 1 - i) {
			if g.res[start + j] > g.res[start + j + 1] {
				let tmp = g.res[start + j];
				g.res[start + j] = g.res[start + j + 1];
				g.res[start + j + 1] = tmp;
			}
		}
	}
	g.steps += len * len;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted last ", len, " elements");
	out
}
@end
