@entry da56cfac7ba68d93
kind: step
verb: sort
noun: digits
modifier: in_place
context: compare
phrase: sort digits of input number in place
phrase: arrange decimal digits in ascending order
test: input=4213
expect: => i=1234 r=0.0 ok=true s="sorted digits: 1234" errors=0 n=0 res=[] cache=0 hits=0
test: input=951
expect: => i=159 r=0.0 ok=true s="sorted digits: 159" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits int[16] = [0; 16];
	var dn = 0;
	var x = out.i;
	while x > 0 && dn < 16 {
		digits[dn] = x % 10;
		dn++;
		x /= 10;
	}
	for i in dn {
		for j in 0..(dn - 1 - i) {
			if digits[j] > digits[j + 1] {
				let tmp = digits[j];
				digits[j] = digits[j + 1];
				digits[j + 1] = tmp;
			}
		}
	}
	var res = 0;
	for i in dn {
		res = res * 10 + digits[i];
	}
	g.steps += dn * dn;
	out.i = res;
	out.s.clear();
	format(out.s, "sorted digits: ", res);
	out
}
@end
