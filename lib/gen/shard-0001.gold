kind: step
verb: limit
noun: streak
modifier: each
context: cache
phrase: limit consecutive streak of each value to {max_streak}
phrase: cap repeated streaks at {max_streak} items for cache
slot: max_streak int
test: list=1,1,1,2,2,3 max_streak=2
expect: => i=5 r=0.0 ok=true s="streak limited size: 5" errors=0 n=5 res=[1,1,2,2,3] cache=1 hits=0
test: list=5,5,5,5 max_streak=1
expect: => i=1 r=0.0 ok=true s="streak limited size: 1" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_streak};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var cur_val = g.res[0];
	var cur_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] == cur_val {
			cur_count++;
		} else {
			cur_val = g.res[i];
			cur_count = 1;
		}
		if cur_count <= limit {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		i++;
	}
	g.n = new_n;
	gold_cache_put(g, 0, new_n);
	g.steps += i;
	out.i = new_n;
	out.s.clear();
	format(out.s, "streak limited size: ", new_n);
	out
}
@end
