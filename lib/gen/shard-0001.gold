@entry 7ca6cea9b38b4099
kind: step
verb: return
noun: vowels
modifier: running
context: compare
phrase: return vowels running comparison minimum {min_len}
phrase: compare running vowels against minimum {min_len}
phrase: track vowel count compared with {min_len}
slot: min_len int
test: text="audio apple" min_len=4
expect: => i=6 r=0.0 ok=true s="running vowels lead=6 total=6" errors=0 n=0 res=[] cache=0 hits=0
test: text="sky rhythm" min_len=2
expect: => i=0 r=0.0 ok=false s="insufficient vowels: 0 below 2" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_vowel(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
	b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U'
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min_len};
	var vowel_count = 0;
	var running_lead = 0;
	var consonants = 0;
	var i = 0;
	while i < out.s.len {
		if ${ID}_is_vowel(out.s[i]) {
			vowel_count++;
			if vowel_count > consonants { running_lead++; }
		} else if (out.s[i] >= 'a' && out.s[i] <= 'z') || (out.s[i] >= 'A' && out.s[i] <= 'Z') {
			consonants++;
		}
		i++;
	}
	out.i = running_lead;
	if vowel_count >= min_v {
		out.ok = true;
		out.s.clear();
		format(out.s, "running vowels lead=", running_lead, " total=", vowel_count);
	} else {
		gold_fail(g, "running vowels below minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "insufficient vowels: ", vowel_count, " below ", min_v);
	}
	out
}
@end
