kind: step
verb: dedupe
noun: item
modifier: up_to
context: error
phrase: dedupe item occurrences up to limit {limit}
phrase: prune item duplicates up to threshold {limit}
phrase: retain item copies up to count {limit}
slot: limit int
test: list=1,1,1,2,2 limit=2
expect: => i=4 r=0.0 ok=true s="deduped items up to limit 2" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=1,1,2 limit=0
expect: => i=0 r=0.0 ok=false s="error: invalid dedupe item limit" errors=1 n=3 res=[1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid dedupe item limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid dedupe item limit");
		return out;
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = 0;
		for j in new_n { if new_res[j] == x { seen++; } }
		if seen < lim {
			new_res[new_n] = x;
			new_n++;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n * g.n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "deduped items up to limit ", lim);
	out
}
@end
