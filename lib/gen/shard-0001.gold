expect: => i=10 r=0.0 ok=true s="minimum transformed to 10" errors=0 n=2 res=[10,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "mapped 0 minimum items");
		return out;
	}
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] {
			min_idx = k;
		}
	}
	for _ in t {
		g.res[min_idx] *= 2;
	}
	g.steps += t;
	out.i = g.res[min_idx];
	out.s.clear();
	format(out.s, "minimum transformed to ", g.res[min_idx]);
	out
}
@end
