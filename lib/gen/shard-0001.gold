@entry 70f5b54652747131
kind: step
verb: compare
noun: digits
modifier: any
context: list
phrase: compare digits any matching {target}
phrase: find elements with any digits matching {target}
phrase: filter items having any digit equal to {target}
slot: target int
test: list=12,34,51,78 target=1
expect: => i=2 r=0.0 ok=true s="matched 2 numbers with digit 1" errors=0 n=4 res=[12,34,51,78] cache=0 hits=0
test: list=23,45,67,89 target=2
expect: => i=1 r=0.0 ok=true s="matched 1 numbers with digit 2" errors=0 n=4 res=[23,45,67,89] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	var count = 0;
	for i in g.n {
		var val = g.res[i];
		if val < 0 { val = -val; }
		var has_digit = false;
		if val == 0 && target == 0 { has_digit = true; }
		while val > 0 {
			if val % 10 == target {
				has_digit = true;
				break;
			}
			val /= 10;
		}
		if has_digit { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "matched ", count, " numbers with digit ", target);
	out
}
@end
