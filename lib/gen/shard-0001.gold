expect: => i=2 r=0.0 ok=true s="kept at most 2 spaces" errors=0 n=4 res=[0,1,0,2] cache=0 hits=0
test: list=0,0,0,0 max_spaces=1
expect: => i=1 r=0.0 ok=true s="kept at most 1 spaces" errors=0 n=1 res=[0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_spaces};
	var kept = 0;
	var spaces_seen = 0;
	for k in g.n {
		let x = g.res[k];
		if x == 0 {
			if spaces_seen < lim {
				g.res[kept] = x;
				kept++;
				spaces_seen++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = spaces_seen;
	out.s.clear();
	format(out.s, "kept at most ", spaces_seen, " spaces");
	out
}
@end
