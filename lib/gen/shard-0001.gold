code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i++;
	}
	var clamped = min_val;
	if clamped < lo { clamped = lo; }
	if clamped > hi { clamped = hi; }
	gold_cache_put(g, 0, clamped);
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "bounded minimum in cache: ", clamped);
	out
}
@end
