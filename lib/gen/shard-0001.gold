phrase: invert order in window of {window} in place
phrase: flip elements within window {window} in place
slot: window int
test: list=1,2,3,4,5 window=3
expect: => i=3 r=0.0 ok=true s="reversed window of 3 in place" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 window=2
expect: => i=2 r=0.0 ok=true s="reversed window of 2 in place" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if g.n == 0 {
		gold_fail(g, "empty list for window reverse");
		out.ok = false;
		return out;
	}
	let lim = if win <= 0 || win > g.n { g.n } else { win };
	for i in lim / 2 {
		let j = lim - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "reversed window of ", lim, " in place");
	out
}
@end
