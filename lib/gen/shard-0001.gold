slot: size int
test: list=2,3,4,5 size=2
expect: => i=0 r=0.0 ok=true s="all windows positive" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=1,-5,2,3 size=2
expect: => i=0 r=0.0 ok=false s="non-positive window found" errors=1 n=4 res=[1,-5,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz > g.n {
		gold_fail(g, "invalid span size");
		out.ok = false;
		return out;
	}
	var all_pos = true;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		if sum <= 0 { all_pos = false; break; }
		i++;
	}
	g.steps += g.n;
	out.ok = all_pos;
	out.s.clear();
	if all_pos {
		format(out.s, "all windows positive");
	} else {
		gold_fail(g, "non-positive window found");
		format(out.s, "non-positive window found");
	}
	out
}
@end
