	if g.n == 0 {
		gold_fail(g, "no items for maximum");
		out.ok = false;
		return out;
	}
	var cur_max = g.res[0];
	for k in 1..g.n {
		if g.res[k] > cur_max {
			cur_max = g.res[k];
		} else {
			g.res[k] = cur_max;
		}
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "running maximum reached ", cur_max);
	out
}
