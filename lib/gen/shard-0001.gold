fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var i = 0;
	while i < g.cn {
		let val, ok = gold_cache_get(g, g.ck[i]);
		if ok { total += val; }
		i += 2;
	}
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "searched alternate cache total: ", total);
	out
}
@end
@entry 5673c725b5ffb7ff
kind: step
verb: sort
noun: steps
modifier: while
context: loop
phrase: sort step elements while values stay positive
phrase: order positive prefix in place
test: list=4,2,3,-1,5
expect: => i=3 r=0.0 ok=true s="sorted positive prefix of length 3" errors=0 n=5 res=[2,3,4,-1,5] cache=0 hits=0
test: list=8,1,3
expect: => i=3 r=0.0 ok=true s="sorted positive prefix of length 3" errors=0 n=3 res=[1,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos_len = 0;
	while pos_len < g.n && g.res[pos_len] > 0 {
		pos_len++;
	}
	for i in pos_len {
		for j in 0..(pos_len - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += pos_len * pos_len;
	out.i = pos_len;
	out.s.clear();
	format(out.s, "sorted positive prefix of length ", pos_len);
	out
}
@end
