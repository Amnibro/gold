@entry 3da358c3448fce9f
kind: step
verb: drop
noun: budget
modifier: first
context: stats
phrase: drop budget {budget} from first sample points
phrase: discard first items within budget limit {budget}
phrase: remove initial observations up to budget {budget}
slot: budget int
test: list=5,10,15,20 budget=20
expect: => i=2 r=0.0 ok=true s="dropped 2 initial items within budget" errors=0 n=2 res=[15,20] cache=0 hits=0
test: list=8,12 budget=5
expect: => i=0 r=0.0 ok=true s="dropped 0 initial items within budget" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 {
		gold_fail(g, "budget must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid budget");
		return out;
	}
	var sum = 0;
	var drop_cnt = 0;
	while drop_cnt < g.n {
		let x = g.res[drop_cnt];
		let cost = if x < 0 { -x } else { x };
		if sum + cost > b { break; }
		sum += cost;
		drop_cnt++;
	}
	for i in drop_cnt..g.n {
		g.res[i - drop_cnt] = g.res[i];
	}
	g.n -= drop_cnt;
	g.steps += g.n + drop_cnt;
	out.i = drop_cnt;
	out.s.clear();
	format(out.s, "dropped ", drop_cnt, " initial items within budget");
	out
}
@end
