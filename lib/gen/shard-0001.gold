test: list=10,20 bound=15
expect: => i=0 r=0.0 ok=true s="paired 0 pairs safely" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let num_pairs = g.n / 2;
	var safe_count = 0;
	var kept = 0;
	for k in num_pairs {
		let x = g.res[2 * k];
		let y = g.res[2 * k + 1];
		if x + y <= b {
			let larger = if x > y { x } else { y };
			g.res[kept] = larger;
			kept++;
			safe_count++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = safe_count;
	out.s.clear();
	format(out.s, "paired ", safe_count, " pairs safely");
	out
}
@end
