	var total = 0;
	for i in g.n {
		let idx = g.n - 1 - i;
		total += g.res[idx] * (i + 1);
	}
	g.steps += g.n;
	g.n = 1;
	g.res[0] = total;
	out.i = total;
	out.s.clear();
	format(out.s, "history total ", total);
	out
}
