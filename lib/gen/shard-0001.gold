code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("invalid count or empty results");
		return out;
	}
	let start = if g.n > c { g.n - c } else { 0 };
	let num = g.n - start;
	var sum = 0;
	for k in start..g.n { sum += g.res[k]; }
	let avg = sum / num;
	gold_push(g, avg);
	out.i = avg;
	out.s.clear();
	format(out.s, "paired average ", avg, " from last ", num, " items");
	out
}
@end
