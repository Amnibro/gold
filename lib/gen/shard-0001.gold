fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		gold_fail(g, "count must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive count");
		return out;
	}
	if c > g.n {
		gold_fail(g, "count exceeds list size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: count exceeds size");
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var sum = 0;
	let start = g.n - c;
	for k in start..g.n {
		sum += g.res[k];
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed ", c, " largest sorted items");
	out
}
@end
