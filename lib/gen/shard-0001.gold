slot: rounds int
test: list=2,4,6,8 rounds=1
expect: => i=2 r=0.0 ok=true s="paired evens 2 times" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=1,3,5 rounds=2
expect: => i=0 r=0.0 ok=true s="paired evens 0 times" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var paired = 0;
	for _ in r {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
				g.res[i] = g.res[i] + g.res[i + 1];
				for j in (i + 1)..(g.n - 1) {
					g.res[j] = g.res[j + 1];
				}
				g.n--;
				paired++;
			}
			i++;
		}
	}
	g.steps += paired;
	out.i = paired;
	out.s.clear();
	format(out.s, "paired evens ", paired, " times");
	out
}
@end
