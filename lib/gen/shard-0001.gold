kind: step
verb: keep
noun: middle
modifier: sorted
context: error
phrase: keep middle sorted range count {count}
phrase: preserve middle elements sorted count {count}
phrase: retain middle items while sorted count {count}
slot: count int
test: list=1,3,5,7,9 count=3
expect: => i=3 r=0.0 ok=true s="kept 3 middle sorted items" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=10,5,20 count=2
expect: => i=0 r=0.0 ok=false s="error: sequence not sorted" errors=1 n=3 res=[10,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if g.n == 0 {
		gold_fail(g, "empty results to keep middle");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	for k in g.n - 1 {
		if g.res[k] > g.res[k + 1] {
			gold_fail(g, "results are not sorted");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: sequence not sorted");
			return out;
		}
	}
	if cnt <= 0 || cnt > g.n {
		gold_fail(g, "invalid middle count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid middle count");
		return out;
	}
	let start = (g.n - cnt) / 2;
	for k in cnt {
		g.res[k] = g.res[start + k];
	}
	g.n = cnt;
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "kept ", cnt, " middle sorted items");
	out
}
@end
@entry c1370bd8658c7e3b
kind: step
verb: return
noun: runs
modifier: with_cache
context: error
phrase: return runs with cache threshold {min_len}
phrase: find consecutive runs with cache threshold {min_len}
phrase: locate runs with cache size {min_len}
slot: min_len int
test: list=5,5,5,2,3,3 min_len=2
expect: => i=2 r=0.0 ok=true s="recorded 2 runs in cache" errors=0 n=6 res=[5,5,5,2,3,3] cache=2 hits=0
test: list=1,1,2 min_len=1
expect: => i=0 r=0.0 ok=false s="error: minimum run length under two" errors=1 n=3 res=[1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if ml < 2 {
		gold_fail(g, "minimum run length under two");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: minimum run length under two");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results for runs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var runs = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len >= ml {
			gold_cache_put(g, i, len);
			runs++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "recorded ", runs, " runs in cache");
	out
}
@end
