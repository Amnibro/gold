kind: step
verb: repeat
noun: history
modifier: pairwise
context: transform
phrase: repeat pairwise history differences for {rounds} cycles
phrase: repeat pairwise transform on history for {rounds} steps
phrase: apply pairwise reductions to history repeated {rounds} times
slot: rounds int
test: list=1,4,9,16 rounds=1
expect: => i=3 r=0.0 ok=true s="repeated pairwise history across 1 rounds" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=1,4,9,16 rounds=2
expect: => i=2 r=0.0 ok=true s="repeated pairwise history across 2 rounds" errors=0 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if g.n < 2 {
		gold_fail(g, "history too short for pairwise transform");
		out.ok = false;
		return out;
	}
	var cur_len = g.n;
	var step_count = 0;
	for iter in r {
		if cur_len < 2 { break; }
		for k in cur_len - 1 {
			g.res[k] = g.res[k + 1] - g.res[k];
			step_count++;
		}
		cur_len--;
	}
	g.steps += step_count;
	g.n = cur_len;
	out.i = cur_len;
	out.s.clear();
	format(out.s, "repeated pairwise history across ", r, " rounds");
	out
}
@end
