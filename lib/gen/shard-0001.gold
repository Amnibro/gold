fn ${ID}(n int) int {
	let b = ${bound};
	var x = if n < 0 { -n } else { n };
	var res = 0;
	var mult = 1;
	var last_d = -1;
	var digits = 0;
	while x > 0 && digits < b {
		let d = x % 10;
		if d != last_d {
			res += d * mult;
			mult *= 10;
			last_d = d;
			digits++;
		}
		x /= 10;
	}
	res
}
@end
@entry fe2780b657659a84
kind: fn
verb: swap
noun: numbers
modifier: recursively
context: loop
phrase: swap numbers recursively passes {passes}
phrase: recursive swap numbers count {passes}
phrase: loop recursive number swaps {passes}
slot: passes int
test: arg=1234,5678 passes=1
expect: 2143
expect: 6587
test: arg=1234 passes=2
expect: 1234
code:
fn ${ID}(n int) int {
	let p = ${passes};
	var x = if n < 0 { -n } else { n };
	for step in p {
		var temp = x;
		var res = 0;
		var mult = 1;
		while temp >= 10 {
			let d1 = temp % 10;
			let d2 = (temp / 10) % 10;
			res += (d2 + d1 * 10) * mult;
			mult *= 100;
			temp /= 100;
		}
		if temp > 0 {
			res += temp * mult;
		}
		x = res;
	}
	x
}
@end
