expect: => i=2 r=0.0 ok=true s="repeated runs at least min_run=3 count=2" errors=0 n=9 res=[2,2,2,5,7,7,7,2,7] cache=0 hits=0
test: list=4,4,9,9 min_run=2
expect: => i=2 r=0.0 ok=true s="repeated runs at least min_run=2 count=2" errors=0 n=6 res=[4,4,9,9,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_r = ${min_run};
	var matched_runs = 0;
	let orig_n = g.n;
	var i = 0;
	while i < orig_n {
		var run_len = 1;
		while i + 1 < orig_n && g.res[i + 1] == g.res[i] {
			run_len++;
			i++;
		}
		if run_len >= min_r {
			gold_push(g, g.res[i]);
			matched_runs++;
		}
		i++;
	}
	out.i = matched_runs;
	out.s.clear();
	format(out.s, "repeated runs at least min_run=", min_r, " count=", matched_runs);
	out
}
@end
