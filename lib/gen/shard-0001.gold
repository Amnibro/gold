@entry d22a07568cd6181e
kind: step
verb: normalize
noun: primes
modifier: nested
context: filter
phrase: normalize prime numbers replacing them with one
phrase: replace every prime element with value one
phrase: convert prime items to one others to zero
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="normalized primes count 3" errors=0 n=5 res=[1,1,0,1,0] cache=0 hits=0
test: list=7,8,9,10,11
expect: => i=2 r=0.0 ok=true s="normalized primes count 2" errors=0 n=5 res=[1,0,0,0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
		}
		if is_p {
			g.res[k] = 1;
			count++;
		} else {
			g.res[k] = 0;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "normalized primes count ", count);
	out
}
@end
@entry e95485f8a5537c8d
kind: step
verb: rotate
noun: sequence
modifier: with_cache
context: filter
phrase: rotate sequence by offset {offset} with cache
phrase: cyclically shift list by {offset} storing original in cache
phrase: rotate sequence by amount {offset} leveraging cache
slot: offset int
test: list=1,2,3,4,5 offset=2
expect: => i=5 r=0.0 ok=true s="rotated sequence length 5" errors=0 n=5 res=[4,5,1,2,3] cache=1 hits=0
test: list=10,20,30,40 offset=1
expect: => i=4 r=0.0 ok=true s="rotated sequence length 4" errors=0 n=4 res=[40,10,20,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${offset};
	gold_cache_put(g, 0, g.n);
	if g.n > 1 {
		var eff = sh % g.n;
		if eff < 0 { eff += g.n; }
		var temp int[512] = [0; 512];
		for k in g.n {
			let dest = (k + eff) % g.n;
			temp[dest] = g.res[k];
		}
		for k in g.n { g.res[k] = temp[k]; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated sequence length ", g.n);
	out
}
@end
@entry 1bc8a78a31e3c4b3
kind: step
verb: filter
noun: gaps
modifier: between
context: filter
phrase: filter adjacent items with gaps from {min_gap} to {max_gap}
phrase: keep elements having pairwise gap within {min_gap} through {max_gap}
phrase: filter values where adjacent difference falls between {min_gap} to {max_gap}
slot: min_gap int
slot: max_gap int
test: list=1,4,5,10,12 min_gap=2 max_gap=4
expect: => i=3 r=0.0 ok=true s="filtered items with matching gaps 3" errors=0 n=3 res=[1,4,12] cache=0 hits=0
test: list=2,7,8,15,20 min_gap=3 max_gap=6
expect: => i=3 r=0.0 ok=true s="filtered items with matching gaps 3" errors=0 n=3 res=[2,7,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_gap};
	let hi = ${max_gap};
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var temp int[512] = [0; 512];
	temp[0] = g.res[0];
	var tn = 1;
	for k in 1..g.n {
		var diff = g.res[k] - g.res[k - 1];
		if diff < 0 { diff = -diff; }
		if diff >= lo && diff <= hi {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	g.n = tn;
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "filtered items with matching gaps ", tn);
	out
}
@end
