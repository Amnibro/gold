code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "merged streak of ", g.n, " items into sorted order");
	out
}
@end
