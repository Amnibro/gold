code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var start = if g.n > sz { g.n - sz } else { 0 };
	if start < g.n {
		var mn = g.res[start];
		var mx = g.res[start];
		var k = start + 1;
		while k < g.n {
			if g.res[k] < mn { mn = g.res[k]; }
			if g.res[k] > mx { mx = g.res[k]; }
			k++;
		}
		out.i = mx - mn;
	}
	g.steps += g.n;
	out
}
@end
