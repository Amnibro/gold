expect: => i=0 r=0.0 ok=true s="shifted condition smoothly across 1 cycles" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=10,20 times=0
expect: => i=0 r=0.0 ok=false s="error: non-positive shift count" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${times};
	if count <= 0 {
		gold_fail(g, "invalid shift count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive shift count");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list for condition shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var err_flags = 0;
	for t in count {
		let first = g.res[0];
		if first < 0 {
			err_flags++;
		}
		var j = 0;
		while j < g.n - 1 {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[g.n - 1] = first;
	}
	g.steps += count * g.n;
	out.i = err_flags;
	if err_flags > 0 {
		gold_fail(g, "condition shift detected negative error flag");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: ", err_flags, " error flags encountered");
		return out;
	}
	out.s.clear();
	format(out.s, "shifted condition smoothly across ", count, " cycles");
	out
}
@end
