fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
