code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${span};
	var span_len = sz;
	if span_len > g.n { span_len = g.n; }
	if span_len < 0 { span_len = 0; }
	if span_len > 1 {
		var i = 0;
		var j = span_len - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += span_len;
	out.i = span_len;
	out.s.clear();
	format(out.s, "reversed first ", span_len, " items");
	out
}
@end
@entry 249171d1ba21053f
kind: step
verb: split
noun: duplicates
modifier: at_most
context: search
phrase: split duplicates at most limit
phrase: partition duplicate entries up to {limit}
slot: limit int
test: list=1,2,2,3,2 limit=1
expect: => i=1 r=0.0 ok=true s="split duplicates count: 1" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 limit=0
expect: => i=0 r=0.0 ok=true s="split duplicates count: 0" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	let lim = ${limit};
	var count = 0;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen || count < lim {
			g.res[kept] = x;
			kept++;
			if seen { count++; }
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = count;
	out.s.clear();
	format(out.s, "split duplicates count: ", count);
	out
}
@end
