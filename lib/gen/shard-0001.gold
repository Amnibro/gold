fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty sample for minimum sorted");
		out.ok = false;
		return out;
	}
	for i in 1..g.n {
		let key = g.res[i];
		var j = i;
		while j > 0 && g.res[j - 1] > key {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[j] = key;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] < lim {
			g.res[k] = lim;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "applied minimum to ", count, " sorted values");
	out
}
