kind: step
verb: run
noun: threshold
modifier: first
context: cache
phrase: run search for first item exceeding threshold {thresh}
phrase: locate first entry surpassing threshold {thresh} in cache
slot: thresh int
test: list=2,5,8 thresh=4
expect: => i=5 r=0.0 ok=true s="threshold search result: 1" errors=0 n=3 res=[2,5,8] cache=1 hits=0
test: list=10,20,30 thresh=15
expect: => i=20 r=0.0 ok=true s="threshold search result: 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var found = false;
	var idx = -1;
	var val = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > t {
			found = true;
			idx = i;
			val = g.res[i];
			break;
		}
		i++;
	}
	if found {
		gold_cache_put(g, 0, val);
		out.i = val;
	} else {
		out.ok = false;
	}
	g.steps += i + 1;
	out.s.clear();
	format(out.s, "threshold search result: ", idx);
	out
}
@end
