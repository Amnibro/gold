fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 { return out; }
	let num_chunks = (g.n + c - 1) / c;
	g.steps += g.n;
	out.i = num_chunks;
	out.s.clear();
	format(out.s, "split memo into ", num_chunks, " chunks");
	out
}
@end
@entry e1043bf5413cb2a8
kind: step
verb: fill
noun: duplicates
modifier: all
context: loop
phrase: fill all duplicates with replacement {rep}
phrase: replace all consecutive duplicate entries with {rep}
slot: rep int
test: list=1,2,2,3,3,3 rep=0
expect: => i=2 r=0.0 ok=true s="filled 2 duplicate values" errors=0 n=6 res=[1,2,0,3,0,3] cache=0 hits=0
test: list=4,4,5 rep=9
expect: => i=1 r=0.0 ok=true s="filled 1 duplicate values" errors=0 n=3 res=[4,9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rep};
	var replaced = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			g.res[i] = r;
			replaced++;
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "filled ", replaced, " duplicate values");
	out
}
@end
@entry 94ddc340442b7428
kind: step
verb: dedupe
noun: limit
modifier: at_least
context: loop
phrase: dedupe results retaining values at least {floor}
phrase: remove duplicates while keeping items at least {floor}
slot: floor int
test: list=2,2,5,5,8,8 floor=4
expect: => i=2 r=0.0 ok=true s="deduped to 2 items above floor" errors=0 n=2 res=[5,8] cache=0 hits=0
test: list=1,1,3,3 floor=2
expect: => i=1 r=0.0 ok=true s="deduped to 1 items above floor" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= fl {
			var dup = false;
			for j in kept {
				if g.res[j] == g.res[i] {
					dup = true;
					break;
				}
			}
			if !dup {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " items above floor");
	out
}
@end
