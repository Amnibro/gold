expect: => i=2 r=0.0 ok=true s="performed 2 swap rounds" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let num_passes = ${passes};
	var p = 0;
	while p < num_passes {
		var k = 0;
		while k + 1 < g.n {
			let tmp = g.res[k];
			g.res[k] = g.res[k + 1];
			g.res[k + 1] = tmp;
			k += 2;
		}
		p++;
	}
	g.steps += num_passes;
	out.i = num_passes;
	out.s.clear();
	format(out.s, "performed ", num_passes, " swap rounds");
	out
}
@end
