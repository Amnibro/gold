code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 2 {
		gold_fail(g, "repeat count must be at least 2");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid repeat count");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty sample to repeat");
		out.ok = false;
		return out;
	}
	if g.n * k > 512 {
		gold_fail(g, "repeated size exceeds capacity");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var idx = 0;
	for i in g.n {
		for r in k {
			tmp[idx] = g.res[i];
			idx++;
		}
	}
	for i in idx {
		g.res[i] = tmp[i];
	}
	g.n = idx;
	g.steps += idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "repeated items to sample size ", idx);
	out
}
@end
@entry 6118983c749db1ff
kind: step
verb: fill
noun: step
modifier: times
context: stats
phrase: fill step size {stride} exactly {count} times
phrase: populate progression using step {stride} across {count} times
phrase: generate regular intervals of step {stride} over {count} times
