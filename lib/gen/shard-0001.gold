code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var ordered = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			if g.res[i] < g.res[i + 1] {
				ordered++;
			}
		}
	}
	g.steps += g.n * p;
	out.i = ordered;
	out.s.clear();
	format(out.s, "ascending pairs count: ", ordered);
	out
}
@end
