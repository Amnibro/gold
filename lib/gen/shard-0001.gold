fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let is_vowel = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 ||
		               x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if is_vowel && x <= c {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "safely kept ", kept, " vowel codes");
	out
}
