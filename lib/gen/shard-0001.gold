phrase: rotate tail elements {count} times across aggregate
slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="swapped tail 2 times" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 count=3
expect: => i=3 r=0.0 ok=true s="swapped tail 3 times" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items to swap tail");
		out.ok = false;
		return out;
	}
	let k = ${count};
	var performed = 0;
	for step in k {
		let last = g.n - 1;
		let prev = g.n - 2;
		let tmp = g.res[last];
		g.res[last] = g.res[prev];
		g.res[prev] = tmp;
		performed++;
	}
	g.steps += performed;
	out.i = performed;
	out.s.clear();
	format(out.s, "swapped tail ", performed, " times");
	out
}
@end
