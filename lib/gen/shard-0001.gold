phrase: tally results with cache matching {target}
phrase: count frequency with cache for {target}
slot: target int
test: list=7,3,7,7 target=7
expect: => i=3 r=0.0 ok=true s="counted 3 occurrences in cache" errors=0 n=4 res=[7,3,7,7] cache=1 hits=0
test: list=1,2,3 target=8
expect: => i=0 r=0.0 ok=false s="error: target not found" errors=1 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "no results to count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let cv, hit = gold_cache_get(g, tgt);
	var cnt = 0;
	if hit {
		cnt = cv;
	} else {
		for k in g.n {
			if g.res[k] == tgt {
				cnt++;
			}
		}
		gold_cache_put(g, tgt, cnt);
	}
	g.steps += g.n;
	out.i = cnt;
	if cnt == 0 {
		gold_fail(g, "target not found in results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target not found");
		return out;
	}
	out.s.clear();
	format(out.s, "counted ", cnt, " occurrences in cache");
	out
}
@end
