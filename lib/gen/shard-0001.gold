fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let val = ${target};
	let max_drops = ${times};
	var drops = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] == val && drops < max_drops {
			drops++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = drops;
	g.steps += g.n + 1;
	out
}
@end
