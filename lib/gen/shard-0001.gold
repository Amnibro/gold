expect: => i=350 r=0.0 ok=true s="prefix aggregate total=350" errors=0 n=3 res=[5,10,15] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let plen = ${prefix_len};
	var agg = 0;
	var idx = 0;
	while idx < g.n && idx < plen {
		let val = ${f}(g.res[idx]);
		let cached, ok = gold_cache_get(g, val);
		if ok {
			agg += cached;
		} else {
			gold_cache_put(g, val, val);
			agg += val;
		}
		idx++;
	}
	out.i = agg;
	out.s.clear();
	format(out.s, "prefix aggregate total=", agg);
	out
}
@end
