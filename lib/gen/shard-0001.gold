slot: min_val int
slot: k int
test: list=5,12,8,25,30 min_val=10 k=1
expect: => i=3 r=0.0 ok=true s="rotated filtered items count=3" errors=0 n=3 res=[25,30,12] cache=0 hits=0
test: list=3,40,50,2 min_val=20 k=2
expect: => i=2 r=0.0 ok=true s="rotated filtered items count=2" errors=0 n=2 res=[40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_val};
	var shift = ${k};
	var w = 0;
	for i in g.n {
		if g.res[i] >= thresh {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	if w > 1 && shift > 0 {
		if shift >= w { shift = shift % w; }
		for s in shift {
			let first = g.res[0];
			var idx = 0;
			while idx < w - 1 {
				g.res[idx] = g.res[idx + 1];
				idx++;
			}
			g.res[w - 1] = first;
		}
	}
	out.i = w;
	out.s.clear();
	format(out.s, "rotated filtered items count=", w);
	out
}
@end
