@entry cdedbc0cedc5f542
kind: step
verb: drop
noun: gaps
modifier: sorted
context: error
phrase: drop gaps sorted error sequence
phrase: eliminate duplicate sorted error gaps
test: list=5,1,1,3,2
expect: => i=4 r=0.0 ok=true s="unique sorted error count: 4" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
test: list=2,2,2
expect: => i=1 r=0.0 ok=true s="unique sorted error count: 1" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var kept = 0;
	for k in g.n {
		if kept == 0 || g.res[k] != g.res[kept - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique sorted error count: ", kept);
	out
}
@end
