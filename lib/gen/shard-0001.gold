expect: => i=10 r=0.0 ok=true s="scanned 1 duplicate groups with sum 10" errors=0 n=4 res=[10,20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_items = 0;
	var dup_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if !seen_before {
			var cnt = 0;
			for j in g.n {
				if g.res[j] == x { cnt++; }
			}
			if cnt > 1 {
				dup_items++;
				dup_sum += x;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "scanned ", dup_items, " duplicate groups with sum ", dup_sum);
	out
}
@end
