test: list=3,5 input=2
expect: => i=5 r=0.0 ok=true s="normalized errors with last value" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=4
expect: => i=4 r=0.0 ok=true s="normalized errors with last value" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		while g.errors > last_val {
			g.errors--;
		}
		g.steps += 1;
		out.i = last_val;
	}
	out.s.clear();
	format(out.s, "normalized errors with last value");
	out
}
@end
