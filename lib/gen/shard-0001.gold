fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var scaled = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			g.res[k] = ${fn}(x);
			scaled++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " items between bounds");
	out
}
