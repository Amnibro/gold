noun: maximum
modifier: sorted
context: search
phrase: apply sorting to extract maximum search score
phrase: order candidate metrics to select peak value
test: list=20,50,10,40
expect: => i=50 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=5,95,15,80
expect: => i=95 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,80,95] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	if g.n > 0 { out.i = g.res[g.n - 1]; }
	g.steps += g.n * g.n + 1;
	out
}
@end
