test: input=12345
expect: => i=5 r=0.0 ok=true s="kept 5 digits in reverse" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: input=9870
expect: => i=4 r=0.0 ok=true s="kept 4 digits in reverse" errors=0 n=4 res=[0,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var x = if out.i < 0 { -out.i } else { out.i };
	if x == 0 {
		gold_push(g, 0);
	} else {
		while x > 0 {
			gold_push(g, x % 10);
			x /= 10;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " digits in reverse");
	out
}
@end
