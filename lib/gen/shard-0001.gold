code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	if out.s.len == 0 {
		gold_fail(g, "empty text for retry");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text");
		return out;
	}
	let count = if out.s.len < lim { out.s.len } else { lim };
	var modified = 0;
	for k in count {
		if k % 2 == 0 {
			let b = out.s[k];
			if b >= 'a' && b <= 'z' {
				out.s[k] = (b - 32) as! byte;
				modified++;
			}
		}
	}
	g.steps += count;
	out.i = modified;
	out
}
@end
