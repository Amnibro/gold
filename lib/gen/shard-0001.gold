fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		let x = g.res[i];
		for j in i {
			if g.res[j] == x {
				dup_count++;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "found ", dup_count, " running duplicates");
	out
}
@end
