slot: max_len int
test: text="search" max_len=4
expect: => i=4 r=0.0 ok=true s="search" errors=0 n=4 res=[97,99,101,104] cache=0 hits=0
test: text="binary" max_len=3
expect: => i=3 r=0.0 ok=true s="binary" errors=0 n=3 res=[97,98,105] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	gold_clear(g);
	var i = 0;
	while i < out.s.len {
		gold_push(g, out.s[i] as int);
		i++;
	}
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[a] > g.res[b] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	if limit >= 0 && limit < g.n { g.n = limit; }
	out.i = g.n;
	g.steps += g.n * g.n + 1;
	out
}
@end
