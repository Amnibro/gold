fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var span = limit;
	if span > g.n { span = g.n; }
	if span < 0 { span = 0; }
	var count = 0;
	let start = g.n - span;
	for k in span {
		if g.res[start + k] > 0 { count++; }
	}
	g.steps += span;
	out.i = count;
	out.s.clear();
	format(out.s, "positive items in tail ", count);
	out
}
