kind: step
verb: shift
noun: primes
modifier: recursively
context: list
phrase: shift primes recursively to next prime
phrase: advance prime values recursively in list
phrase: transform prime numbers recursively upward
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="shifted 3 prime values recursively" errors=0 n=5 res=[3,5,4,7,6] cache=0 hits=0
test: list=7,10,13
expect: => i=2 r=0.0 ok=true s="shifted 2 prime values recursively" errors=0 n=3 res=[11,10,17] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			var next_p = g.res[k] + 1;
			while !${ID}_is_prime(next_p) {
				next_p++;
			}
			g.res[k] = next_p;
			shifted++;
		}
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted, " prime values recursively");
	out
}
@end
