fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("invalid size or empty results");
		return out;
	}
	var new_n = 0;
	var new_res int[512] = [0; 512];
