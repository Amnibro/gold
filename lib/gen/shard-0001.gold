test: list=5,10,15 threshold=10
expect: => i=2 r=0.0 ok=true s="rotated item first count=2" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty list for rotate item first");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let first = g.res[0];
	var count = 0;
	for k in g.n {
		if g.res[k] > first { count++; }
	}
	if first > thresh && g.n > 1 {
		let tmp = g.res[0];
		var idx = 0;
		while idx < g.n - 1 {
			g.res[idx] = g.res[idx + 1];
			idx++;
		}
		g.res[g.n - 1] = tmp;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "rotated item first count=", count);
	out
}
@end
