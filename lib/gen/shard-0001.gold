	var x = if n < 0 { -n } else { n };
	var res = 0;
	var mult = 1;
	while x > 0 {
		let d = x % 10;
		let out_d = if d == 2 || d == 3 || d == 5 || d == 7 { rep } else { d };
		res += out_d * mult;
		mult *= 10;
		x /= 10;
	}
	res
}
