code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[..128] = [];
	var odds int[..128] = [];
	for k in g.n {
		if g.res[k] % 2 == 0 { evens.push(g.res[k]); }
		else { odds.push(g.res[k]); }
	}
	for i in evens.len { g.res[i] = evens[i]; }
	for i in odds.len { g.res[evens.len + i] = odds[i]; }
	g.steps += g.n;
	out.i = evens.len;
	out.s.clear();
	format(out.s, "even errors ranked: ", evens.len);
	out
}
@end
