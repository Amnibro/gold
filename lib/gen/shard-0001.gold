slot: threshold int
test: arg=135,192 threshold=1
expect: 4
expect: 15
test: arg=151,123 threshold=3
expect: 8
expect: 0
code:
fn ${ID}(n int) int {
	let min_step = ${threshold};
	var x = if n < 0 { -n } else { n };
	var total = 0;
	var prev = -1;
	while x > 0 {
		let d = x % 10;
		if prev >= 0 {
			let diff = if d > prev { d - prev } else { prev - d };
			if diff >= min_step {
				total += diff;
			}
		}
		prev = d;
		x /= 10;
	}
	total
}
@end
