code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var steps_count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] < lim { break; }
		steps_count++;
		idx--;
	}
	g.steps += steps_count;
	out.i = steps_count;
	out.s.clear();
	format(out.s, "measured reverse steps ", steps_count);
	out
}
@end
