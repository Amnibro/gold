fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	if out.s.len >= req {
		let n = out.s.len;
		for i in n / 2 {
			let j = n - 1 - i;
			let tmp = out.s[i];
			out.s[i] = out.s[j];
			out.s[j] = tmp;
		}
		out.i = n;
	} else {
		out.i = 0;
	}
	g.steps += out.s.len;
	out
}
