phrase: condense middle nested pair in list
test: list=1,2,3,4
expect: => i=5 r=0.0 ok=true s="merged middle nested value 5" errors=0 n=3 res=[1,5,4] cache=0 hits=0
test: list=10,20,30,40,50
expect: => i=50 r=0.0 ok=true s="merged middle nested value 50" errors=0 n=4 res=[10,50,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "too few elements to merge middle");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let merged = g.res[mid - 1] + g.res[mid];
	g.res[mid - 1] = merged;
	for k in mid..(g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged middle nested value ", merged);
	out
}
@end
