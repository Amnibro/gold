slot: high int
test: arg=345,543 low=1 high=9
expect: 3
expect: 0
test: arg=423,19 low=2 high=5
expect: 1
expect: 0
code:
fn ${ID}(n int) int {
	let lo = ${low};
	let hi = ${high};
	var x = if n < 0 { -n } else { n };
	var d int[20] = [0; 20];
	var count = 0;
	while x > 0 {
		let rem = x % 10;
		if rem >= lo && rem <= hi {
			d[count] = rem;
			count++;
		}
		x /= 10;
	}
	var steps = 0;
	for i in count {
		for j in count - 1 - i {
			if d[j] > d[j + 1] {
				let tmp = d[j];
				d[j] = d[j + 1];
				d[j + 1] = tmp;
				steps++;
			}
		}
	}
	steps
}
@end
