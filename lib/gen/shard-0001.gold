fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cur, hit = gold_cache_get(g, x);
		if hit {
			gold_cache_put(g, x, cur + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	var max_freq = 0;
	for k in g.cn {
		if g.cv[k] > max_freq { max_freq = g.cv[k]; }
	}
	g.steps += g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "histogram peak frequency is ", max_freq);
	out
}
@end
