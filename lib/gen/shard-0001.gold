fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var pairs_within = 0;
	for i in 0..(g.n - 1) {
		if g.res[i] + g.res[i + 1] <= b {
			pairs_within++;
		}
	}
	g.steps += g.n;
	out.i = pairs_within;
	out.s.clear();
	format(out.s, "pairs within budget: ", pairs_within);
	out
}
