code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_run};
	var matched_runs = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		let start = i;
		while i < out.s.len && out.s[i] == b {
			i++;
		}
		let run_len = i - start;
		if run_len <= limit {
			matched_runs++;
		}
	}
	g.steps += out.s.len + matched_runs;
	out.i = matched_runs;
	out.s.clear();
	format(out.s, "found ", matched_runs, " runs at most length");
	out
}
@end
