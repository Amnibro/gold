expect: => i=3 r=0.0 ok=true s="running numbers kept: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			g.res[kept] = max_val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "running numbers kept: ", kept);
	out
}
@end
