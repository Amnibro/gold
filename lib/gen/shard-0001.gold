@entry 2b961453b5b9faaf
kind: step
verb: sort
noun: threshold
modifier: every_other
context: core
phrase: sort threshold every_other above {threshold}
phrase: sort every_other position past threshold {threshold}
phrase: reorder every_other item exceeding threshold {threshold}
slot: threshold int
test: list=50,1,30,2,10,3 threshold=5
expect: => i=3 r=0.0 ok=true s="sorted 3 every_other threshold items" errors=0 n=6 res=[10,1,30,2,50,3] cache=0 hits=0
test: list=100,4,80,5,20,6 threshold=15
expect: => i=3 r=0.0 ok=true s="sorted 3 every_other threshold items" errors=0 n=6 res=[20,4,80,5,100,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var evens int[256] = [0; 256];
	var en = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > thresh {
			evens[en] = g.res[i];
			en++;
		}
		i += 2;
	}
	for a in en {
		for b in a + 1..en {
			if evens[a] > evens[b] {
				let tmp = evens[a];
				evens[a] = evens[b];
				evens[b] = tmp;
			}
		}
	}
	var idx = 0;
	i = 0;
	while i < g.n {
		if g.res[i] > thresh {
			g.res[i] = evens[idx];
			idx++;
		}
		i += 2;
	}
	g.steps += en * en;
	out.i = en;
	out.s.clear();
	format(out.s, "sorted ", en, " every_other threshold items");
	out
}
@end
