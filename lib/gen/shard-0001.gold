code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var in_range = 0;
	for i in g.cn {
		if g.cv[i] >= lo && g.cv[i] <= hi {
			in_range++;
		}
	}
	g.steps += g.cn + 1;
	out.i = in_range;
	out.s.clear();
	format(out.s, "cached values in range: ", in_range);
	out
}
@end
