code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${cutoff};
	if lim > g.n { lim = g.n; }
	for i in lim {
		for j in (i + 1)..lim {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += lim * lim;
	out.i = if lim > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "sorted prefix up to: ", lim);
	out
}
@end
