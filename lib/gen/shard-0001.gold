@entry da397ba44c672d44
kind: step
verb: join
noun: streak
modifier: safely
context: filter
phrase: join increasing streak safely into text
phrase: concatenate ascending run safely into string
test: list=1,3,5,2,4
expect: => i=3 r=0.0 ok=true s="1-3-5" errors=0 n=5 res=[1,3,5,2,4] cache=0 hits=0
test: list=7,2,3,4,5,1
expect: => i=4 r=0.0 ok=true s="2-3-4-5" errors=0 n=6 res=[7,2,3,4,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = k;
			cur_len = 1;
		}
	}
	for i in 0..best_len {
		if i > 0 { out.s.push('-'); }
		format(out.s, g.res[best_start + i]);
	}
	out.i = best_len;
	g.steps += g.n;
	out
}
@end
