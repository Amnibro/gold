expect: => i=10 r=0.0 ok=true s="all checkpoints pass=true" errors=0 n=3 res=[12,14,16] cache=0 hits=0
test: list=2,3,6 cond=is_even bonus=5
expect: => i=0 r=0.0 ok=false s="all checkpoints pass=false" errors=0 n=3 res=[2,3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let extra = ${bonus};
	var all_pass = true;
	for i in g.n {
		if !${cond}(g.res[i]) {
			all_pass = false;
		}
	}
	if all_pass && g.n > 0 {
		for i in g.n {
			g.res[i] += extra;
		}
		out.i = extra;
	} else {
		out.i = 0;
	}
	out.ok = all_pass;
	out.s.clear();
	format(out.s, "all checkpoints pass=", all_pass);
	out
}
@end
