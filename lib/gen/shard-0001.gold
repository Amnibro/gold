code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var matched = 0;
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.cn {
		if g.ck[i] < lim {
			new_res[new_n] = g.cv[i];
			new_n++;
			matched++;
		}
		i++;
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.cn;
	out.i = matched;
	out.ok = true;
	out.s.clear();
	format(out.s, "traced ", matched, " cache entries while under limit");
	out
}
@end
