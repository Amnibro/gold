	var num_unique = 0;
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in num_unique {
			if seen_items[j] == x { idx = j; }
		}
		if idx >= 0 {
			seen_count[idx]++;
		} else if num_unique < 50 {
			seen_items[num_unique] = x;
			seen_count[num_unique] = 1;
			num_unique++;
		}
	}
	for i in num_unique {
		let c = seen_count[i];
		total += if c > cap { cap } else { c };
	}
	out.i = total;
	out.s.clear();
	format(out.s, "aggregated duplicates limit=", total);
	out
}
@end
