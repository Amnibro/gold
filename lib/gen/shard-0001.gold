fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var modified = 0;
	var k = g.n - 1;
	while k >= 0 && !${stop}(g.res[k]) {
		if g.res[k] > c {
			g.res[k] = c;
			modified++;
		}
		k--;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized tail until stop: ", modified, " changed");
	out
}
@end
