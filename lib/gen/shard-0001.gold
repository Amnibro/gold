code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list");
		out.ok = false;
		return out;
	}
	var acc = g.res[0];
	for k in 1..g.n {
		acc = ${f}(acc + g.res[k]);
	}
	gold_clear(g);
	gold_push(g, acc);
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded value ", acc);
	out
}
@end
