		running += g.res[k];
		if running >= fl {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "kept ", kept, " items with total ", running);
	out
}
@end
@entry f3d2a1cf47f707aa
kind: step
verb: reverse
noun: head
modifier: last
context: compare
phrase: reverse head compared with last count {size}
phrase: invert head elements smaller than last up to {size}
slot: size int
test: list=9,8,1,5 size=3
expect: => i=2 r=0.0 ok=true s="reversed head with 2 compared items" errors=0 n=4 res=[1,8,9,5] cache=0 hits=0
test: list=1,2,3,10 size=3
expect: => i=0 r=0.0 ok=true s="reversed head with 0 compared items" errors=0 n=4 res=[1,2,3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if g.n == 0 || sz <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "reversed head with 0 compared items");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = sz;
	if count > g.n { count = g.n; }
	var greater = 0;
	for k in count {
		if g.res[k] > last_val {
			greater++;
		}
	}
	if greater > 0 {
		var i = 0;
		var j = count - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += count;
	out.i = greater;
	out.s.clear();
	format(out.s, "reversed head with ", greater, " compared items");
	out
}
@end
