fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var clamped = 0;
	for i in g.n {
		var val = g.res[i];
		while val > lim {
			val = lim;
			clamped++;
		}
		g.res[i] = val;
	}
	g.steps += g.n + clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped counter recursively count=", clamped);
	out
}
@end
