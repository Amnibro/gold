slot: lo int
slot: hi int
test: list=1,2,2,3,4,4,5 lo=2 hi=4
expect: => i=5 r=0.0 ok=true s="merged duplicates between bounds: 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
