@entry b0377dfb3da83d5a
kind: step
verb: repeat
noun: list
modifier: recursively
context: aggregate
phrase: repeat list recursively for {depth} iterations
phrase: recursively duplicate list across {depth} rounds
phrase: expand list recursively {depth} times
slot: depth int
test: list=1,2 depth=3
expect: => i=6 r=0.0 ok=true s="recursively repeated list to size 6" errors=0 n=6 res=[1,2,1,2,1,2] cache=0 hits=0
test: list=4,5,6 depth=2
expect: => i=6 r=0.0 ok=true s="recursively repeated list to size 6" errors=0 n=6 res=[4,5,6,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 || d <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "repetition count trivial");
		return out;
	}
	let orig = g.n;
	var cur_times = 1;
	while cur_times < d && g.n + orig <= 512 {
		for i in orig {
			g.res[g.n] = g.res[i];
			g.n++;
		}
		cur_times++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively repeated list to size ", g.n);
	out
}
@end
