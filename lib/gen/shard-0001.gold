fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_byte = ${sep} as! byte;
	var is_err = false;
	if out.s.len >= 3 && out.s[0] == 'E' && out.s[1] == 'R' && out.s[2] == 'R' {
		is_err = true;
		gold_fail(g, "error token detected in split");
	}
	var parts = 1;
	for b in out.s {
		if b == s_byte {
			parts++;
		}
	}
	g.steps += out.s.len + parts;
	out.ok = !is_err;
	out.i = parts;
	out.s.clear();
	format(out.s, "split into ", parts, " tokens safely");
	out
}
@end
