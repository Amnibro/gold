noun: middle
modifier: running
context: math
phrase: filter middle elements using running average
phrase: keep middle values within running average range
test: list=1,5,10,15,20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var s = 0;
		for i in g.n { s += g.res[i]; }
		let avg = s / g.n;
		var kept = 0;
		for i in g.n {
			if g.res[i] >= avg {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
		out.i = kept;
	}
	g.steps += g.n + 1;
	out
}
@end
