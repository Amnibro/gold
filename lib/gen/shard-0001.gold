test: list=1,4,10,20
expect: => i=1 r=0.0 ok=true s="final recursive difference 1" errors=0 n=1 res=[1] cache=0 hits=0
test: list=5,15,30
expect: => i=5 r=0.0 ok=true s="final recursive difference 5" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rounds = 0;
	while g.n > 1 {
		for k in g.n - 1 {
			g.res[k] = g.res[k + 1] - g.res[k];
		}
		g.n--;
		rounds++;
	}
	g.steps += rounds;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "final recursive difference ", out.i);
	out
}
@end
