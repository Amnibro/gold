@entry d6d486152db7417d
kind: step
verb: keep
noun: limit
modifier: last
context: transform
phrase: keep last {lim} items from results
phrase: retain trailing elements up to limit {lim}
phrase: slice results keeping last {lim} values
slot: lim int
test: list=1,2,3,4,5 lim=3
expect: => i=3 r=0.0 ok=true s="kept last 3 items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20,30,40,50,60 lim=2
expect: => i=2 r=0.0 ok=true s="kept last 2 items" errors=0 n=2 res=[50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	if limit <= 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "kept zero items");
		return out;
	}
	if g.n > limit {
		let offset = g.n - limit;
		for k in limit {
			g.res[k] = g.res[offset + k];
		}
		g.n = limit;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept last ", g.n, " items");
	out
}
@end
@entry 91fcfe23a8b501ef
kind: step
verb: join
noun: average
modifier: recursively
context: transform
phrase: join adjacent values by average recursively {depth} times
phrase: smooth results recursively with average for {depth} steps
phrase: compute recursive pairwise averages across {depth} passes
slot: depth int
test: list=2,4,6,8 depth=1
expect: => i=3 r=0.0 ok=true s="averaged down to 3 items" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=10,20,30,40 depth=2
expect: => i=2 r=0.0 ok=true s="averaged down to 2 items" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${depth};
	var p = 0;
	while p < passes && g.n > 1 {
		for k in g.n - 1 {
			g.res[k] = (g.res[k] + g.res[k + 1]) / 2;
		}
		g.n--;
		p++;
	}
	g.steps += p;
	out.i = g.n;
	out.s.clear();
	format(out.s, "averaged down to ", g.n, " items");
	out
}
@end
