fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "runs: [");
	var cur_run = 0;
	var first = true;
	for i in g.n {
		if ${p}(g.res[i]) {
			cur_run++;
		} else {
			if cur_run > 0 {
				if !first { format(out.s, ", "); }
				format(out.s, cur_run);
				first = false;
				cur_run = 0;
			}
		}
	}
	if cur_run > 0 {
		if !first { format(out.s, ", "); }
		format(out.s, cur_run);
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
