code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	for i in start..g.n {
		g.res[i] *= 2;
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "scaled ", g.n - start, " tail items");
	out
}
@end
