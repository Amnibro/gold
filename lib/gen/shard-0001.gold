fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var found = false;
	var peak = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			if !found || g.res[i] > peak {
				peak = g.res[i];
				found = true;
			}
		}
	}
	if found {
		format(out.s, "max matching: ", peak);
	} else {
		format(out.s, "max matching: none");
	}
	out.i = peak;
	g.steps += g.n;
	out
}
@end
