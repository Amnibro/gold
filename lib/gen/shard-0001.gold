fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = 0;
	while idx < g.n {
		var x = g.res[idx];
		var sign = 1;
		if x < 0 { sign = -1; x = -x; }
		var r = 0;
		while x > 0 { r = r * 10 + x % 10; x /= 10; }
		let rev = r * sign;
		g.res[idx] = rev;
		gold_cache_put(g, idx, rev);
		count++;
		idx += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " alternate numbers");
	out
}
@end
