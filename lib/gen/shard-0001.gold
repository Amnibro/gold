code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delim};
	if d.len == 0 {
		out.i = 0;
		return out;
	}
	var match_pos = -1;
	var i = 0;
	while i + d.len <= out.s.len {
		var matched = true;
		for j in d.len {
			if out.s[i + j] != d[j] { matched = false; break; }
		}
		if matched { match_pos = i; break; }
		i++;
	}
	if match_pos >= 0 {
		var cut = match_pos;
		while cut > 0 && out.s[cut - 1] == ' ' { cut--; }
		out.s.resize(cut, 0 as byte);
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
