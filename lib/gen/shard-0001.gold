expect: => i=3 r=0.0 ok=false s="deduped with 3 duplicate errors" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_dups};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		if new_n == 0 || new_res[new_n - 1] != g.res[k] {
			new_res[new_n] = g.res[k];
			new_n++;
		}
	}
	let dup_errors = g.n - new_n;
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = dup_errors;
	out.s.clear();
	format(out.s, "deduped with ", dup_errors, " duplicate errors");
	if dup_errors > limit {
		gold_fail(g, "duplicate errors exceeded limit");
		out.ok = false;
	} else {
		out.ok = true;
	}
	out
}
@end
