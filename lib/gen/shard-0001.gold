code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sorted list");
		out.ok = false;
		return out;
	}
	let min_val = g.res[0];
	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.n--;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "dropped smallest: ", min_val);
	out
}
@end
