kind: step
verb: keep
noun: head
modifier: unique
context: transform
phrase: keep unique head transform elements count {size}
phrase: retain unique items within head size {size}
slot: size int
test: list=2,2,3,4,4,5 size=5
expect: => i=3 r=0.0 ok=true s="kept 3 unique head items" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10,20,30 size=2
expect: => i=2 r=0.0 ok=true s="kept 2 unique head items" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var limit = sz;
	if limit > g.n { limit = g.n; }
	if limit < 0 { limit = 0; }
	var kept = 0;
	for i in limit {
		var is_dup = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				is_dup = true;
				break;
			}
		}
		if !is_dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " unique head items");
	out
}
@end
@entry 1e8d2f68d08ef249
kind: step
verb: search
noun: loop
modifier: recursively
context: cache
phrase: search loop recursively in cache for target {target}
phrase: find target {target} searching loop recursively through cache
phrase: traverse cache loop recursively seeking target {target}
slot: target int
slot: depth int
test: list=10,20,30 target=20 depth=2
expect: => i=1 r=0.0 ok=true s="found target in cache loop search" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=1,2,3 target=99 depth=1
expect: => i=-1 r=0.0 ok=false s="target missing after cache loop search" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_d = ${depth};
	var found = -1;
	for step in max_d {
		let val, ok = gold_cache_get(g, tgt);
		if ok {
			found = val;
			break;
		}
		for k in g.n {
			if g.res[k] == tgt {
				gold_cache_put(g, tgt, k);
				found = k;
				break;
			}
		}
		if found >= 0 { break; }
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "found target in cache loop search");
	} else {
		gold_fail(g, "target not found in cache loop");
		out.ok = false;
		format(out.s, "target missing after cache loop search");
	}
	out
}
@end
