code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 {
		out.i = 0;
		return out;
	}
	var pairs = out.s.len - 1;
	for k in pairs {
		let diff = (out.s[k + 1] as int) - (out.s[k] as int);
		gold_push(g, diff);
	}
	g.steps += pairs;
	out.i = pairs;
	out
}
@end
@entry ad59e02384cac01b
kind: step
verb: scan
noun: memo
modifier: in_reverse
context: text
phrase: scan text memo backwards in reverse for {target}
phrase: search memo string in reverse matching {target}
phrase: inspect text memo backwards in reverse for {target}
slot: target text
test: text="banana" target="a"
expect: => i=5 r=0.0 ok=true s="banana" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" target="z"
expect: => i=-1 r=0.0 ok=false s="hello" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needle = ${target};
	if needle.len == 0 {
		out.i = -1;
		out.ok = false;
		return out;
	}
	let ch = needle[0];
	var found_idx = -1;
	var idx = out.s.len - 1;
	while idx >= 0 {
		if out.s[idx] == ch {
			found_idx = idx;
			break;
		}
		idx--;
	}
	g.steps += out.s.len - idx;
	out.i = found_idx;
	out.ok = (found_idx >= 0);
	out
}
@end
