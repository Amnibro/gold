fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let l = ${len};
	var count = 0;
	for i in g.n {
		if i < l {
			var freq = 0;
			for j in g.n {
				if j < l && g.res[j] == g.res[i] { freq++; }
			}
			if freq == 1 {
				g.res[i] *= f;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " unique prefix items");
	out
}
