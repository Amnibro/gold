fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "rev check: ");
	var count = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if ${p}(g.res[k]) {
			format(out.s, "+");
			count++;
		} else {
			format(out.s, "-");
		}
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
