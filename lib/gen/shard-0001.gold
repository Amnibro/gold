fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gaps int[512] = [0; 512];
	var gn = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		gaps[gn] = diff;
		gn++;
		gaps[gn] = diff;
		gn++;
		k++;
	}
	gold_clear(g);
	for i in gn { gold_push(g, gaps[i]); }
	out.i = gn;
	g.steps += g.n + 1;
	out
}
