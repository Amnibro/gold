	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		if diff > md { return false; }
		prev = cur;
		x /= 10;
	}
	true
}
@end
