@entry 18446a443f32dca5
kind: step
verb: repeat
noun: limit
modifier: any
context: filter
phrase: repeat results elements up to limit {max_len}
phrase: cycle list items until reaching limit {max_len}
phrase: duplicate values up to maximum length {max_len}
slot: max_len int
test: list=1,2 max_len=5
expect: => i=5 r=0.0 ok=true s="repeated up to length 5" errors=0 n=5 res=[1,2,1,2,1] cache=0 hits=0
test: list=10,20,30 max_len=7
expect: => i=7 r=0.0 ok=true s="repeated up to length 7" errors=0 n=7 res=[10,20,30,10,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${max_len};
	let orig = g.n;
	if orig > 0 && target_len > orig {
		var cur = orig;
		while cur < target_len && cur < 512 {
			g.res[cur] = g.res[cur % orig];
			cur++;
		}
		g.n = cur;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated up to length ", g.n);
	out
}
@end
