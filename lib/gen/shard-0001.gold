phrase: assemble decimal digits up to {count} places
slot: count int
test: list=3,7,2,9 count=3
expect: => i=372 r=0.0 ok=true s="joined 3 digits" errors=0 n=4 res=[3,7,2,9] cache=0 hits=0
test: list=9,5 count=2
expect: => i=95 r=0.0 ok=true s="joined 2 digits" errors=0 n=2 res=[9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${count};
	if lim <= 0 {
		gold_fail(g, "count must be positive");
		out.ok = false;
		return out;
	}
	let take = if lim > g.n { g.n } else { lim };
	var total = 0;
	for k in take {
		let d = g.res[k];
		if d < 0 || d > 9 {
			gold_fail(g, "item is not decimal digit");
			out.ok = false;
			return out;
		}
		total = total * 10 + d;
	}
	g.steps += take;
	out.i = total;
	out.s.clear();
	format(out.s, "joined ", take, " digits");
	out
}
@end
