@entry 87da205d8d7b4b63
kind: step
verb: drop
noun: head
modifier: unique
context: transform
phrase: drop unique items from head of results
phrase: strip non repeating values from beginning of list
phrase: remove leading elements that appear only once
test: list=1,2,3,4,4,5
expect: => i=3 r=0.0 ok=true s="dropped 3 unique head items" errors=0 n=3 res=[4,4,5] cache=0 hits=0
test: list=7,8,9,9,10
expect: => i=2 r=0.0 ok=true s="dropped 2 unique head items" errors=0 n=3 res=[9,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var drop_count = 0;
	while drop_count < g.n {
		let val = g.res[drop_count];
		var freq = 0;
		for k in g.n {
			if g.res[k] == val { freq++; }
		}
		if freq == 1 { drop_count++; }
		else { break; }
	}
	let remaining = g.n - drop_count;
	for k in remaining {
		g.res[k] = g.res[drop_count + k];
	}
	g.n = remaining;
	g.steps += drop_count;
	out.i = drop_count;
	out.s.clear();
	format(out.s, "dropped ", drop_count, " unique head items");
	out
}
@end
