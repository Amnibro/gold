		while j < i {
			if g.res[j] == g.res[i] {
				is_dupe = true;
				break;
			}
			j++;
		}
		if is_dupe {
			gold_cache_put(g, g.res[i], dupes + 1);
			dupes++;
		}
		i++;
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "collected duplicates up to limit count=", dupes);
