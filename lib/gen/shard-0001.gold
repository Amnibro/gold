fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; }
		}
		if !seen_before && ${cond}(x) {
			g.res[i] = x * mul;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled unique conditional items: ", scaled);
	out
}
@end
