code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	var count = 0;
	for i in g.n {
		if i < lim {
			var val, ok = gold_cache_get(g, g.res[i]);
			if !ok {
				val = g.res[i] * 2;
				gold_cache_put(g, g.res[i], val);
			}
			g.res[i] = val;
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "memoized ", count, " items");
	out
}
@end
