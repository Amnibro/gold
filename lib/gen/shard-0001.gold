slot: threshold int
test: list=10,25,25,30 threshold=20
expect: => i=55 r=0.0 ok=true s="unique error sum=55 count=2" errors=3 n=4 res=[10,25,25,30] cache=0 hits=0
test: list=5,15,5 threshold=10
expect: => i=15 r=0.0 ok=true s="unique error sum=15 count=1" errors=1 n=3 res=[5,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var err_sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > thresh {
			gold_fail(g, "value exceeded threshold");
			var seen = false;
			var j = 0;
			while j < i {
				if g.res[j] == g.res[i] { seen = true; break; }
				j++;
			}
			if !seen {
				err_sum += g.res[i];
				count++;
			}
		}
		i++;
	}
	out.i = err_sum;
	out.s.clear();
	format(out.s, "unique error sum=", err_sum, " count=", count);
	out
}
@end
