	if tgt <= 0 {
		gold_fail(g, "invalid target value");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive target");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list for running total");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var total = 0;
	var reached = false;
	var steps_taken = 0;
	for k in g.n {
		total += g.res[k];
		steps_taken++;
		if total >= tgt {
			reached = true;
			break;
		}
	}
	g.steps += steps_taken;
	out.i = total;
	if !reached {
		gold_fail(g, "running total never reached target");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target not reached");
		return out;
	}
	out.s.clear();
	format(out.s, "running total reached target at ", total);
	out
}
@end
@entry 46e8341437f53318
kind: step
verb: swap
noun: memo
modifier: until
context: retry
phrase: swap memo until condition {stop}
phrase: exchange memo values until {stop}
phrase: retry memo swap until match {stop}
slot: stop pred
test: list=1,2,3,4 stop=is_even
expect: => i=1 r=0.0 ok=true s="swapped memo across 1 iterations" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
test: list=1,3,5,7 stop=is_even
expect: => i=2 r=0.0 ok=false s="error: stop condition not met" errors=1 n=4 res=[3,1,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "list too short for memo swap");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var swaps = 0;
	var found = false;
	var i = 0;
	while i < g.n - 1 {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		if ${stop}(g.res[i]) {
			found = true;
			break;
		}
		i += 2;
	}
	g.steps += swaps;
	out.i = swaps;
	if !found {
		gold_fail(g, "swap memo stop condition never met");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: stop condition not met");
		return out;
	}
	out.s.clear();
	format(out.s, "swapped memo across ", swaps, " iterations");
	out
}
@end
