fn ${ID}(g Gold&, v Val) Val {
	let threshold = ${min_sum};
	var out = v;
	out.s.clear();
	format(out.s, "pairs: [");
	var count = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] + g.res[k + 1] >= threshold {
			if count > 0 { format(out.s, ", "); }
			format(out.s, "(", g.res[k], "+", g.res[k + 1], ")");
			count++;
		}
		k++;
	}
	format(out.s, "]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
