fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dup = false;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] { has_dup = true; break; }
		}
		if has_dup { break; }
	}
	g.steps += g.n * g.n;
	out.s.clear();
	if !has_dup {
		out.i = g.n;
		out.ok = true;
		format(out.s, "traced list with none duplicates");
	} else {
		gold_fail(g, "duplicate elements detected");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: duplicate elements detected");
	}
	out
}
@end
