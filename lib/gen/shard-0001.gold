	let ma = ${max_err};
	var modified = 0;
	for k in g.n {
		if g.res[k] < mi {
			g.res[k] = mi;
			modified++;
		} else if g.res[k] > ma {
			g.res[k] = ma;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped error in place: ", modified);
	out
}
@end
@entry e31e726a1aee0e1c
kind: step
verb: limit
noun: tail
modifier: up_to
context: error
phrase: limit tail up to count {max_tail}
phrase: keep only final {max_tail} errors
