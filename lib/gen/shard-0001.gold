kind: step
verb: merge
noun: vowels
modifier: with_retry
context: list
phrase: merge vowels with_retry limit {retries}
phrase: combine vowels with_retry attempts {retries}
phrase: consolidate vowels with_retry count {retries}
slot: retries int
test: text="ice cream float" retries=2
expect: => i=6 r=0.0 ok=true s="ieeaoa" errors=0 n=0 res=[] cache=0 hits=0
test: text="sky gym rhythm" retries=1
expect: => i=0 r=0.0 ok=false s="no vowels merged with retry" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	var vowels byte[64] = [0; 64];
	var vn = 0;
	for b in out.s {
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		   b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U' {
			if vn < 60 {
				vowels[vn] = b;
				vn++;
			}
		}
	}
	if vn == 0 {
		if retries > 0 {
			gold_fail(g, "no vowels found with retry");
		}
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("no vowels merged with retry");
	} else {
		out.s.clear();
		for k in vn { out.s.push(vowels[k]); }
		g.steps += vn + 1;
		out.i = vn;
	}
	out
}
@end
