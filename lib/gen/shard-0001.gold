test: text="z" factor=1
expect: => i=1 r=0.0 ok=true s="scaled 1 sorted letters" errors=0 n=1 res=[122] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for c in v.s {
		if c >= 'a' && c <= 'z' {
			gold_push(g, (c as! int) * f);
		}
	}
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " sorted letters");
	out
}
@end
