@entry 65e2e5cdd58b2579
kind: step
verb: select
noun: gaps
modifier: with_cache
context: math
phrase: select gaps between items storing into cache
phrase: compute pairwise gaps caching intermediate results
phrase: record sequence gaps with cache storage
test: list=10,15,22,30
expect: => i=20 r=0.0 ok=true s="selected 3 gaps into cache with total 20" errors=0 n=3 res=[5,7,8] cache=3 hits=0
test: list=1,4,9,16
expect: => i=15 r=0.0 ok=true s="selected 3 gaps into cache with total 15" errors=0 n=3 res=[3,5,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for gaps");
		out.ok = false;
		return out;
	}
	var count = g.n - 1;
	var total_gap = 0;
	for k in count {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		gold_cache_put(g, k, diff);
		g.res[k] = diff;
		total_gap += diff;
	}
	g.steps += count;
	g.n = count;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "selected ", count, " gaps into cache with total ", total_gap);
	out
}
@end
