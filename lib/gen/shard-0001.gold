@entry 2f9a5c0608fabbd0
kind: step
verb: clamp
noun: average
modifier: unique
context: loop
phrase: clamp average of unique elements
phrase: clamp mean across distinct values
test: list=2,2,4,4,6
expect: => i=4 r=0.0 ok=true s="clamped unique average: 4" errors=0 n=5 res=[2,2,4,4,6] cache=0 hits=0
test: list=10,10,10
expect: => i=10 r=0.0 ok=true s="clamped unique average: 10" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var unique_sum = 0;
	var unique_count = 0;
	for i in g.n {
		var dup = false;
		for j in i {
			if g.res[j] == g.res[i] {
				dup = true;
				break;
			}
		}
		if !dup {
			unique_sum += g.res[i];
			unique_count++;
		}
	}
	let avg = if unique_count > 0 { unique_sum / unique_count } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "clamped unique average: ", avg);
	out
}
@end
