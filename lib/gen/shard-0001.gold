fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var mn = g.res[0];
		var mx = g.res[0];
		for i in g.n {
			if g.res[i] < mn { mn = g.res[i]; }
			if g.res[i] > mx { mx = g.res[i]; }
		}
		let span = mx - mn;
		out.ok = span <= ${limit};
		out.i = span;
	}
	g.steps += g.n + 1;
	out
}
@end
