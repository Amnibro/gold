code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	var count = 0;
	var i = 0;
	while i < out.s.len && i < lim {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			count++;
		}
		i++;
	}
	gold_cache_put(g, 0, count);
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "prefix letters counted: ", count);
	out
}
@end
