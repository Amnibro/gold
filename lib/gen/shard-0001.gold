code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 {
		gold_fail(g, "invalid step budget");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive budget");
		return out;
	}
	out.i = g.steps;
	if g.steps > b {
		gold_fail(g, "step budget exceeded");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: step budget exceeded");
		return out;
	}
	g.steps++;
	out.s.clear();
	format(out.s, "steps within budget ", g.steps, " of ", b);
	out
}
@end
