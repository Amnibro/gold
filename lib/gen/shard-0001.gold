@entry 5e0f301fdd509a11
kind: step
verb: keep
noun: list
modifier: until
context: text
phrase: keep text words until delimiter {delim}
phrase: truncate text words prior to {delim}
slot: delim text
test: text="one two stop three" delim="stop"
expect: => i=7 r=0.0 ok=true s="one two" errors=0 n=0 res=[] cache=0 hits=0
test: text="red green blue" delim="yellow"
