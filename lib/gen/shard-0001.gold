fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_v = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == max_v {
			g.res[i] = max_v / 2;
			count++;
		}
	}
	out.i = count;
	g.steps += g.n + 1;
	out
}
@end
