@entry be97d1a769c763c6
kind: step
verb: check
noun: squares
modifier: every_other
context: math
phrase: check if every other number is perfect square
phrase: verify alternating elements are perfect squares
phrase: inspect every other position checking perfect squares
test: list=4,10,9,20,16
expect: => i=3 r=0.0 ok=true s="checked 3 squares alternating successfully" errors=0 n=5 res=[4,10,9,20,16] cache=0 hits=0
test: list=4,5,7,8
expect: => i=1 r=0.0 ok=false s="non square encountered among alternating items" errors=0 n=4 res=[4,5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_sq = true;
	var checked = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { is_sq = true; }
		}
		if !is_sq {
			all_sq = false;
			break;
		}
		checked++;
		i += 2;
	}
	g.steps += checked;
	out.ok = all_sq;
	out.i = checked;
	out.s.clear();
	if all_sq {
		format(out.s, "checked ", checked, " squares alternating successfully");
	} else {
		format(out.s, "non square encountered among alternating items");
	}
	out
}
@end
