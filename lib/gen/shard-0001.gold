				w++;
			}
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	if w > 1 {
		let first = g.res[0];
		var idx = 0;
		while idx < w - 1 {
			g.res[idx] = g.res[idx + 1];
			idx++;
