code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || w > g.n {
		gold_fail(g, "invalid window comparison size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid window");
		return out;
	}
	let blocks = g.n / w;
	for k in blocks {
		var max_val = g.res[k * w];
		for j in w {
			let x = g.res[k * w + j];
			if x > max_val { max_val = x; }
		}
		g.res[k] = max_val;
	}
	g.n = blocks;
	g.steps += blocks * w;
	out.i = blocks;
	out.s.clear();
	format(out.s, "collected ", blocks, " block maximums");
	out
}
@end
