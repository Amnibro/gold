kind: step
verb: clamp
noun: gaps
modifier: recursively
context: error
phrase: clamp gaps recursively to limit {max_gap}
phrase: bound adjacent gaps recursively by {max_gap}
phrase: restrict gaps recursively within threshold {max_gap}
slot: max_gap int
test: list=10,30,40 max_gap=15
expect: => i=1 r=0.0 ok=true s="clamped 1 gaps recursively" errors=0 n=3 res=[10,25,40] cache=0 hits=0
test: list=10 max_gap=-1
expect: => i=0 r=0.0 ok=false s="error: invalid gap limit" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	if limit <= 0 {
		gold_fail(g, "invalid gap limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid gap limit");
		return out;
	}
	var clamped = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let gap = g.res[i + 1] - g.res[i];
			if gap > limit {
				g.res[i + 1] = g.res[i] + limit;
				clamped++;
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped ", clamped, " gaps recursively");
	out
}
@end
