kind: step
verb: compare
noun: runs
modifier: at_least
context: search
phrase: compare runs at least streak length
phrase: longest consecutive run at least {min_len}
slot: min_len int
test: list=1,2,2,2,3 min_len=3
expect: => i=3 r=0.0 ok=true s="max run length: 3" errors=0 n=5 res=[1,2,2,2,3] cache=0 hits=0
test: list=5,6,7 min_len=2
expect: => i=1 r=0.0 ok=false s="max run length: 1" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.ok = (max_streak >= ml);
	out.s.clear();
	format(out.s, "max run length: ", max_streak);
	out
}
@end
@entry 864b3c47409e3d9e
kind: step
verb: sum
noun: runs
modifier: last
context: search
phrase: sum runs last trailing streak
phrase: accumulate trailing identical streak
test: list=1,2,3,3,3
expect: => i=9 r=0.0 ok=true s="trailing run sum: 9" errors=0 n=5 res=[1,2,3,3,3] cache=0 hits=0
test: list=4,5,6
expect: => i=6 r=0.0 ok=true s="trailing run sum: 6" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		count++;
		i--;
	}
	let streak_sum = count * last_val;
	g.steps += count;
	out.i = streak_sum;
	out.s.clear();
	format(out.s, "trailing run sum: ", streak_sum);
	out
}
@end
