	let high = ${hi};
	var w = 0;
	for k in g.n {
		let val = g.res[k];
		if val >= low && val <= high {
			var is_p = true;
			if val < 2 { is_p = false; }
			else {
				var d = 2;
				while d * d <= val {
					if val % d == 0 { is_p = false; }
					d++;
				}
			}
			if is_p {
				g.res[w] = val;
				w++;
			}
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "selected ", w, " primes");
	out
}
@end
