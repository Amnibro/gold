noun: primes
modifier: safely
context: cache
phrase: find primes safely storing matches in cache
phrase: identify prime numbers safely within cache
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="found primes safely in cache: 3" errors=0 n=5 res=[2,3,4,5,6] cache=3 hits=0
