test: list=5,5,5,6,7,7 min_len=3
expect: => i=3 r=0.0 ok=true s="selected runs in place items=3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let start = i;
		let val = g.res[i];
		while i < g.n && g.res[i] == val { i++; }
		let run_len = i - start;
		if run_len >= ml {
			for j in start..i {
				new_res[new_n] = g.res[j];
				new_n++;
			}
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "selected runs in place items=", new_n);
	out
}
@end
