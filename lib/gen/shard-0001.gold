@entry 83e97abaee909519
kind: step
verb: sort
noun: average
modifier: running
context: math
phrase: sort average running window {window}
phrase: order running average window {window}
phrase: sort running averages for window {window}
slot: window int
test: list=10,20,30,40,50 window=2
expect: => i=4 r=0.0 ok=true s="sorted 4 running averages" errors=0 n=4 res=[15,25,35,45] cache=0 hits=0
test: list=5,15,25,35 window=2
expect: => i=3 r=0.0 ok=true s="sorted 3 running averages" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || g.n < w {
		out.i = 0;
		out.s.clear();
		out.s.append("too few items for running average");
		return out;
	}
	var avgs int[512] = [0; 512];
	var an = 0;
	var sum = 0;
	for i in w { sum += g.res[i]; }
	avgs[an] = sum / w;
	an++;
	for i in w..g.n {
		sum += g.res[i] - g.res[i - w];
		avgs[an] = sum / w;
		an++;
	}
	for i in an {
		for j in i + 1..an {
			if avgs[i] > avgs[j] {
				let tmp = avgs[i];
				avgs[i] = avgs[j];
				avgs[j] = tmp;
			}
		}
	}
	for k in an { g.res[k] = avgs[k]; }
	g.n = an;
	g.steps += an * an;
	out.i = an;
	out.s.clear();
	format(out.s, "sorted ", an, " running averages");
	out
}
@end
