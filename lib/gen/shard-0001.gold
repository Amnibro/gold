code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 {
		out.i = 0;
		return out;
	}
	let last = out.s.len - 1;
	let tmp = out.s[0];
	out.s[0] = out.s[last];
	out.s[last] = tmp;
	g.steps += 2;
	out.i = 1;
	out
}
@end
