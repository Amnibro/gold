@entry 7bf2b0937f8592be
kind: step
verb: shift
noun: loop
modifier: while
context: error
phrase: shift loop while errors below {threshold}
phrase: advance error loop while under {threshold}
slot: threshold int
test: list=1,2,10,20 threshold=5
expect: => i=2 r=0.0 ok=true s="error loop shifted: 2" errors=0 n=4 res=[10,20,1,2] cache=0 hits=0
test: list=8,9,10 threshold=5
expect: => i=0 r=0.0 ok=true s="error loop shifted: 0" errors=0 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var shifted = 0;
	while g.n > 0 && g.res[0] < t {
		let first = g.res[0];
		for i in 0..(g.n - 1) { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
		shifted++;
		if shifted >= g.n { break; }
	}
	g.steps += shifted + 1;
	out.i = shifted;
	out.s.clear();
	format(out.s, "error loop shifted: ", shifted);
	out
}
@end
