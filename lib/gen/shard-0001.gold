fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_sum};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum > 0 {
		for i in g.n {
			g.res[i] = (g.res[i] * target) / sum;
		}
	}
	var new_sum = 0;
	for i in g.n { new_sum += g.res[i]; }
	out.i = new_sum;
	g.steps += g.n + 1;
	out
}
@end
