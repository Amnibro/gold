slot: outer_lim int
slot: inner_lim int
test: list=10,5,8,12 outer_lim=15 inner_lim=10
expect: => i=0 r=0.0 ok=true s="nested limits valid" errors=0 n=4 res=[10,5,8,12] cache=0 hits=0
test: list=20,30,10 outer_lim=25 inner_lim=15
expect: => i=1 r=0.0 ok=false s="violations count=1" errors=1 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let o_lim = ${outer_lim};
	let i_lim = ${inner_lim};
	var violations = 0;
	for k in g.n {
		let lim = if k == 0 || k == g.n - 1 { o_lim } else { i_lim };
		if g.res[k] > lim { violations++; }
	}
	g.steps += g.n;
	out.ok = violations == 0;
	out.i = violations;
	out.s.clear();
	if violations == 0 {
		out.s.append("nested limits valid");
	} else {
		gold_fail(g, "nested limit violation");
		format(out.s, "violations count=", violations);
	}
	out
}
@end
