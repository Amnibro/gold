code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var reductions = 0;
	var i = 0;
	while i < g.n {
		var val = g.res[i];
		while val > b {
			val = val / 2;
			reductions++;
		}
		g.res[i] = val;
		gold_cache_put(g, i, val);
		i++;
	}
	g.steps += i + reductions;
	out.i = reductions;
	out.s.clear();
	format(out.s, "recursive bound reductions: ", reductions);
	out
}
@end
