@entry 0394fa3bd1dec384
kind: step
verb: fill
noun: odds
modifier: pairwise
context: error
phrase: fill odds pairwise error differences
phrase: insert odd differences between adjacent errors
test: list=10,13,20
expect: => i=3 r=0.0 ok=true s="odd differences inserted: 3" errors=0 n=6 res=[10,13,20,3,7,-17] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="odd differences inserted: 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var added = 0;
	var i = 0;
	while i < g.n - 1 && g.n < 512 {
		let diff = g.res[i + 1] - g.res[i];
		if diff % 2 != 0 {
			gold_push(g, diff);
			added++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = added;
	out.s.clear();
	format(out.s, "odd differences inserted: ", added);
	out
}
@end
@entry b7e1636c38de5ec9
kind: step
verb: search
noun: tail
modifier: recursively
context: error
phrase: search tail recursively for error target {target}
phrase: scan tail recursively matching {target}
slot: target int
test: list=10,20,30,40,30 target=30
expect: => i=4 r=0.0 ok=true s="found in tail at: 4" errors=0 n=5 res=[10,20,30,40,30] cache=0 hits=0
test: list=10,20 target=99
expect: => i=-1 r=0.0 ok=true s="not found in error tail" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	if idx >= 0 {
		format(out.s, "found in tail at: ", idx);
	} else {
		format(out.s, "not found in error tail");
	}
	out
}
@end
