@entry 7e996a8c69617404
kind: step
verb: check
noun: gaps
modifier: between
context: stats
phrase: check gaps between consecutive items under {max_gap}
phrase: verify interval gaps between points within {max_gap}
phrase: inspect distance between adjacent observations within {max_gap}
slot: max_gap int
test: list=10,14,19,25 max_gap=6
expect: => i=6 r=0.0 ok=true s="all gaps within limit 6" errors=0 n=4 res=[10,14,19,25] cache=0 hits=0
test: list=10,20,22 max_gap=5
expect: => i=10 r=0.0 ok=false s="gap 10 exceeds limit 5" errors=1 n=3 res=[10,20,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "insufficient sample points");
		out.ok = false;
		return out;
	}
	var max_diff = 0;
	var ok = true;
	for k in g.n - 1 {
		let d = g.res[k + 1] - g.res[k];
		let gap = if d < 0 { -d } else { d };
		if gap > max_diff { max_diff = gap; }
		if gap > limit { ok = false; }
	}
	g.steps += g.n - 1;
	out.i = max_diff;
	if !ok {
		gold_fail(g, "gap exceeds limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "gap ", max_diff, " exceeds limit ", limit);
		return out;
	}
	out.ok = true;
	out.s.clear();
	format(out.s, "all gaps within limit ", limit);
	out
}
@end
