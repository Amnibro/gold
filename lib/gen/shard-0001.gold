fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for k in g.n {
		if g.res[k] % 2 == 0 {
			gold_cache_put(g, k, g.res[k]);
		}
	}
	for pass in t {
		for i in g.n {
			var min_idx = i;
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[min_idx] { min_idx = j; }
			}
			if min_idx != i {
				let tmp = g.res[i];
				g.res[i] = g.res[min_idx];
				g.res[min_idx] = tmp;
			}
		}
	}
	g.steps += g.n + t;
	out.i = g.cn;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted even numbers with cache passes");
	out
}
@end
