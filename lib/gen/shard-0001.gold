@entry 00bef91af45ba805
kind: step
verb: repeat
noun: odds
modifier: in_reverse
context: cache
phrase: repeat cached odd values in reverse {times} times
phrase: duplicate odd numbers in reverse storing in cache {times} times
phrase: store repeat odd elements in reverse order {times} times
slot: times int
test: list=2,3,4,5 times=2
expect: => i=2 r=0.0 ok=true s="repeated 2 odd values in reverse with cache" errors=0 n=4 res=[5,5,3,3] cache=2 hits=0
test: list=1,7 times=1
expect: => i=2 r=0.0 ok=true s="repeated 2 odd values in reverse with cache" errors=0 n=2 res=[7,1] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var odd_count = 0;
	if g.n > 0 {
		var idx = g.n - 1;
		while idx >= 0 {
			let val = g.res[idx];
			if val % 2 != 0 {
				gold_cache_put(g, val, odd_count + 1);
				odd_count++;
				for rep in t {
					if new_n < 512 {
						new_res[new_n] = val;
						new_n++;
					}
				}
			}
			idx--;
		}
	}
	for k in new_n { g.res[k] = new_res[k]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "repeated ", odd_count, " odd values in reverse with cache");
	out
}
@end
