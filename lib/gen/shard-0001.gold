code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	if mr <= 0 {
		gold_fail(g, "invalid retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive retries");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "sequence too short");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list too short");
		return out;
	}
	var attempts = 0;
	var start = 0;
	var found = false;
	while attempts < mr && start < g.n - 1 {
		if g.res[start] < g.res[start + 1] {
			found = true;
			break;
		}
		start++;
		attempts++;
	}
	g.steps += attempts + 1;
	out.i = start;
	if !found {
		gold_fail(g, "no valid sequence within retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: sequence retries exhausted");
		return out;
	}
	out.s.clear();
	format(out.s, "selected sequence starting at index ", start);
	out
}
