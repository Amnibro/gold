@entry aa4177ab954a37fa
kind: step
verb: swap
noun: odds
modifier: times
context: core
phrase: swap odd numbers {count} times across results
phrase: exchange odd items {count} times in place
phrase: perform odd element swaps {count} times
slot: count int
test: list=1,3,5,7 count=1
expect: => i=2 r=0.0 ok=true s="performed 2 odd swaps" errors=0 n=4 res=[3,1,7,5] cache=0 hits=0
test: list=9,2,7,4,5 count=2
expect: => i=2 r=0.0 ok=true s="performed 2 odd swaps" errors=0 n=5 res=[9,2,7,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var swaps = 0;
	var step = 0;
	while step < k {
		var first_odd = -1;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				if first_odd < 0 {
					first_odd = i;
				} else {
					let tmp = g.res[first_odd];
					g.res[first_odd] = g.res[i];
					g.res[i] = tmp;
					swaps++;
					first_odd = -1;
				}
			}
		}
		step++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " odd swaps");
	out
}
@end
