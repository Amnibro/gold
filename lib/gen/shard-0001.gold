code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "avg: 0");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	let rem = (sum % g.n) * 10 / g.n;
	format(out.s, "avg: ", mean, ".", rem);
	out.i = mean;
	g.steps += g.n;
	out
}
@end
