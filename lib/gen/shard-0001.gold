fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = g.n / 2;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		g.res[k] = if a < b { a } else { b };
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "computed ", pairs, " pairwise minimums");
	out
}
@end
