fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${low};
	var hi = ${high};
	var matches = 0;
	var retries = 0;
	while retries <= 2 {
		matches = 0;
		for k in g.n {
			if g.res[k] >= lo && g.res[k] <= hi {
				matches++;
			}
		}
		if matches > 0 { break; }
		lo--;
		hi++;
		retries++;
	}
	out.i = matches;
	out.s.clear();
	format(out.s, "range matches=", matches, " retries=", retries);
	out
}
@end
@entry 262754c68f93813f
kind: step
verb: collect
noun: middle
modifier: each
context: compare
phrase: collect middle each within margin {margin}
phrase: gather middle values each using margin {margin}
phrase: isolate middle elements each by margin {margin}
slot: margin int
test: list=2,10,15,30 margin=5
expect: => i=2 r=0.0 ok=true s="collected middle each count=2" errors=0 n=4 res=[2,10,15,30] cache=2 hits=0
test: list=1,20,50,100 margin=30
expect: => i=1 r=0.0 ok=true s="collected middle each count=1" errors=0 n=4 res=[1,20,50,100] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n < 3 {
		gold_fail(g, "list too short for middle collect");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: short list");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var collected = 0;
	let orig_n = g.n;
	for k in orig_n {
		if g.res[k] >= min_val + m && g.res[k] <= max_val - m {
			gold_cache_put(g, g.res[k], collected + 1);
			collected++;
		}
	}
	out.i = collected;
	out.s.clear();
	format(out.s, "collected middle each count=", collected);
	out
}
@end
@entry fd57745be177f01f
kind: step
verb: drop
noun: middle
modifier: in_place
context: compare
phrase: drop middle in place within threshold {threshold}
phrase: remove central values in place near {threshold}
phrase: delete middle entries in place margin {threshold}
slot: threshold int
test: list=10,20,30,40 threshold=5
expect: => i=2 r=0.0 ok=true s="dropped middle in place count=2" errors=0 n=2 res=[10,40] cache=0 hits=0
test: list=5,100,50 threshold=10
expect: => i=1 r=0.0 ok=true s="dropped middle in place count=1" errors=0 n=2 res=[5,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 {
		gold_fail(g, "empty list for drop middle");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var dropped = 0;
	var i = 0;
	while i < g.n {
		let diff = g.res[i] - avg;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= thresh {
			var k = i;
			while k < g.n - 1 {
				g.res[k] = g.res[k + 1];
				k++;
			}
			g.n--;
			dropped++;
		} else {
			i++;
		}
	}
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped middle in place count=", dropped);
	out
}
@end
