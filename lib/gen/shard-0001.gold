		out.s.clear();
		out.i = 0;
		return out;
	}
	if out.s.len > limit {
		var temp byte[..200] = "";
		let start = out.s.len - limit;
		for idx in limit {
			temp.push(out.s[start + idx]);
		}
		out.s = temp;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
