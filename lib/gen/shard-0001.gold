@entry a7c220638fd1832a
kind: step
verb: scan
noun: range
modifier: nested
context: math
phrase: scan range in nested chunks of size {block}
phrase: compute nested range block sums using {block}
phrase: aggregate nested range blocks of {block}
slot: block int
test: list=1,2,3,4,5,6 block=2
expect: => i=21 r=0.0 ok=true s="scanned 3 nested blocks with total 21" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 block=2
expect: => i=100 r=0.0 ok=true s="scanned 2 nested blocks with total 100" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block};
	if b <= 0 || g.n < b {
		gold_fail(g, "invalid block size for nested range");
		out.ok = false;
		return out;
	}
	var num_blocks = g.n / b;
	var total = 0;
	for k in num_blocks {
		var sum = 0;
		for j in b {
			sum += g.res[k * b + j];
		}
		g.res[k] = sum;
		total += sum;
	}
	g.steps += g.n;
	g.n = num_blocks;
	out.i = total;
	out.s.clear();
	format(out.s, "scanned ", num_blocks, " nested blocks with total ", total);
	out
}
@end
