fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_val = ${cap};
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] > max_val {
			g.res[i] = max_val;
		}
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "clamped backward histogram with cap ", max_val);
	out
}
