code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_step = ${floor};
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let step = g.res[i] - g.res[i - 1];
		if step < min_step {
			g.res[i] = g.res[i - 1] + min_step;
			clamped++;
		}
		i++;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped steps at least count=", clamped);
	out
}
@end
@entry ff414dc6b7a2e237
kind: step
verb: drop
noun: primes
modifier: recursively
context: compare
phrase: drop primes recursively exceeding limit {limit}
phrase: recursively remove prime values over {limit}
phrase: purge prime entries compared against {limit}
slot: limit int
test: list=7,12,13,4,17 limit=10
expect: => i=2 r=0.0 ok=true s="recursively dropped 2 primes" errors=0 n=3 res=[7,12,4] cache=0 hits=0
test: list=3,23,4 limit=10
expect: => i=1 r=0.0 ok=true s="recursively dropped 1 primes" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dropped = 0;
	var changed = true;
	while changed {
		changed = false;
		var i = 0;
		while i < g.n {
			if ${ID}_is_prime(g.res[i]) && g.res[i] > lim {
				var k = i;
				while k < g.n - 1 {
					g.res[k] = g.res[k + 1];
					k++;
				}
				g.n--;
				dropped++;
				changed = true;
				break;
			}
			i++;
		}
	}
	out.i = dropped;
	out.s.clear();
	format(out.s, "recursively dropped ", dropped, " primes");
	out
}
@end
