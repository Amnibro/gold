@entry dd0fb1bafb0feaa0
kind: step
verb: filter
noun: number
modifier: recursively
context: transform
phrase: filter each number recursively with {rule} to depth {depth}
phrase: transform number sequence recursively using {rule} for {depth} rounds
phrase: apply {rule} recursively on each number across {depth} steps
slot: rule fn
slot: depth int
test: list=2,5 rule=double depth=3
expect: => i=6 r=0.0 ok=true s="recursively transformed numbers to depth 3" errors=0 n=2 res=[16,40] cache=0 hits=0
test: list=10,20 rule=halve depth=2
expect: => i=4 r=0.0 ok=true s="recursively transformed numbers to depth 2" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 {
		gold_fail(g, "empty list for recursive filter");
		out.ok = false;
		return out;
	}
	if d <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "zero depth applied");
		return out;
	}
	var total_ops = 0;
	for k in g.n {
		var x = g.res[k];
		for step in d {
			x = ${rule}(x);
			total_ops++;
		}
		g.res[k] = x;
	}
	g.steps += total_ops;
	out.i = total_ops;
	out.s.clear();
	format(out.s, "recursively transformed numbers to depth ", d);
	out
}
@end
