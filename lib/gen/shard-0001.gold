code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var copy int[512] = [0; 512];
	for i in g.n { copy[i] = g.res[i]; }
	for i in g.n {
		for j in i + 1..g.n {
			if copy[i] > copy[j] {
				let t = copy[i];
				copy[i] = copy[j];
				copy[j] = t;
			}
		}
	}
	let peak = if g.n > 0 { copy[g.n - 1] } else { 0 };
	format(out.s, "budget sorted peak: ", peak, " of ", g.n);
	out.i = peak;
	g.steps += g.n * g.n;
	out
}
@end
