expect: => i=2 r=0.0 ok=true s="sorted history until stop index=2" errors=0 n=5 res=[3,5,8,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_val};
	var idx = g.n;
	for i in g.n {
		if g.res[i] == stop {
			idx = i;
			break;
		}
	}
	var i = 0;
	while i < idx {
		var j = i + 1;
		while j < idx {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += idx * 2 + 1;
	out.i = idx;
	out.s.clear();
	format(out.s, "sorted history until stop index=", idx);
	out
}
@end
