@entry 2ead6e84e4184c9e
kind: step
verb: normalize
noun: gaps
modifier: up_to
context: math
phrase: normalize gaps up to {limit}
phrase: restrict consecutive gaps up to {limit}
phrase: bound adjacent differences up to {limit}
slot: limit int
test: list=10,25,30,60 limit=10
expect: => i=2 r=0.0 ok=true s="normalized 2 gaps" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,10,12 limit=5
expect: => i=2 r=0.0 ok=true s="normalized 2 gaps" errors=0 n=3 res=[1,6,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${limit};
	if max_gap <= 0 || g.n < 2 {
		gold_fail(g, "invalid gap limit or too few elements");
		out.ok = false;
		return out;
	}
	var changed = 0;
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		if diff > max_gap {
			g.res[k] = g.res[k - 1] + max_gap;
			changed++;
		} else if diff < -max_gap {
			g.res[k] = g.res[k - 1] - max_gap;
			changed++;
		}
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "normalized ", changed, " gaps");
	out
}
@end
