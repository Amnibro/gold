fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = cached;
		} else {
			let res = ${op}(x);
			gold_cache_put(g, x, res);
			g.res[i] = res;
		}
	}
	out.i = g.hits;
	g.steps += g.n + 1;
	out
}
@end
@entry 34fdeb2c648c27cf
kind: step
verb: swap
noun: tail
modifier: in_reverse
context: stats
phrase: swap trailing segment {k} in reversed order
phrase: invert tail partition of size {k}
slot: k int
test: list=1,2,3,4,5,6 k=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,2,3,6,5,4] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let lim = if count > g.n { g.n } else { if count < 0 { 0 } else { count } };
	let start = g.n - lim;
	var i = 0;
	while i < lim / 2 {
		let a = start + i;
		let b = g.n - 1 - i;
		let t = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = t;
		i++;
	}
	out.i = lim;
	g.steps += g.n + 1;
	out
}
@end
