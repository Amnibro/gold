expect: => i=0 r=0.0 ok=true s="merged 0 gaps with total 0" errors=0 n=4 res=[1,5,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for gaps");
		out.ok = false;
		return out;
	}
	var count = 0;
	var total_gap = 0;
	for k in g.n - 1 {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		if ${stop}(diff) { break; }
		total_gap += diff;
		count++;
	}
	g.steps += count;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "merged ", count, " gaps with total ", total_gap);
	out
}
@end
