fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var count = 0;
	var i = 0;
	while i + 1 < out.s.len {
		let a = out.s[i];
		let b = out.s[i + 1];
		let va = a == 'a' || a == 'e' || a == 'i' || a == 'o' || a == 'u';
		let vb = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u';
		if va && vb {
			gold_push(g, i);
			count++;
		}
		i++;
	}
	out.i = count;
	g.steps += count + 1;
	out
}
