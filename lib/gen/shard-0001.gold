fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sum = 0;
	for k in g.n {
		let x = g.res[k];
		if !${cond}(x) { break; }
		if x % 2 != 0 {
			count++;
			sum += x;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " odds with sum ", sum);
	out
}
