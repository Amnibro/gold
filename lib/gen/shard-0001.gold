fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.cn + max_r;
	out.s.clear();
	if g.cn == 0 {
		gold_fail(g, "cache empty for average fold");
		out.ok = false;
		out.i = 0;
		format(out.s, "fold cache average failed");
	} else {
		var sum = 0;
		for i in g.cn { sum += g.cv[i]; }
		let avg = sum / g.cn;
		out.i = avg;
		out.ok = true;
		format(out.s, "folded cache average successfully");
	}
	out
}
@end
