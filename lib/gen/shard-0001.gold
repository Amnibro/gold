fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for unique total");
		out.ok = false;
		return out;
	}
	var tmp int[512] = [0; 512];
	var count = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count {
			if tmp[j] == x { seen = true; break; }
		}
		if !seen {
			tmp[count] = x;
			count++;
			sum += x;
		}
	}
	g.steps += g.n;
	g.res[0] = sum;
	g.n = 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "run total of unique values is ", sum);
	out
}
@end
