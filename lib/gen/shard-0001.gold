expect: => i=-1 r=0.0 ok=false s="target not found in sorted suffix" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var found = -1;
	if g.n > 0 {
		var idx = g.n - 1;
		while idx >= 0 {
			if g.res[idx] == tgt {
				found = idx;
				break;
			}
			idx--;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "found target at reverse suffix index ", found);
	} else {
		gold_fail(g, "target not found in sorted suffix");
		out.ok = false;
		format(out.s, "target not found in sorted suffix");
	}
	out
}
@end
