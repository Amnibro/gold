fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in kept { if g.res[j] == x { seen = true; break; } }
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique error codes: ", kept);
	out
}
