@entry 7e5ca4287b47e9e5
kind: step
verb: sum
noun: window
modifier: in_place
context: error
phrase: sum window in place size {win_size}
phrase: compute rolling window error sums of size {win_size}
slot: win_size int
test: list=1,2,3,4,5 win_size=2
expect: => i=3 r=0.0 ok=true s="rolling window sums computed: 4" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30 win_size=3
expect: => i=60 r=0.0 ok=true s="rolling window sums computed: 1" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if g.n < w || w <= 0 { return out; }
	var num_wins = g.n - w + 1;
	for i in num_wins {
		var s = 0;
		for j in w { s += g.res[i + j]; }
		g.res[i] = s;
	}
	g.n = num_wins;
	g.steps += g.n * w;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rolling window sums computed: ", num_wins);
	out
}
@end
