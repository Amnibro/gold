kind: step
verb: sort
noun: items
modifier: while
context: transform
phrase: sort items while {cond} is satisfied
phrase: order items while {cond} remains true
phrase: sort contiguous items while {cond}
slot: cond pred
test: list=8,4,6,1,5 cond=is_even
expect: => i=3 r=0.0 ok=true s="sorted 3 items while condition held" errors=0 n=5 res=[4,6,8,1,5] cache=0 hits=0
test: list=9,5,7,2 cond=is_odd
expect: => i=3 r=0.0 ok=true s="sorted 3 items while condition held" errors=0 n=4 res=[5,7,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items to sort");
		out.ok = false;
		return out;
	}
	var count = 0;
	while count < g.n && ${cond}(g.res[count]) {
		count++;
	}
	for i in 1..count {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted ", count, " items while condition held");
	out
}
@end
