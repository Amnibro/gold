code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	if g.n < 2 {
		gold_fail(g, "not enough items to compute gaps");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	let gap_n = g.n - 1;
	for k in gap_n {
		let scaled = (g.res[k + 1] - g.res[k]) * m;
		gold_cache_put(g, k, scaled);
		g.res[k] = scaled;
	}
	g.n = gap_n;
	g.steps += gap_n;
	out.i = gap_n;
	out.s.clear();
	format(out.s, "scaled ", gap_n, " gaps with cache");
	out
}
@end
