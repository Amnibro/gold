expect: => i=25 r=0.0 ok=true s="folded running budget total=25" errors=0 n=3 res=[5,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var running = 0;
	var kept = 0;
	for i in g.n {
		if running + g.res[i] <= limit {
			running += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "folded running budget total=", running);
	out
}
@end
