test: text="system error fatal" nwords=5
expect: => i=5 r=0.0 ok=true s="fatal" errors=0 n=0 res=[] cache=0 hits=0
test: text="error" nwords=8
expect: => i=5 r=0.0 ok=true s="error" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let nw = ${nwords};
	if out.s.len > nw {
		let shift = out.s.len - nw;
		for i in nw {
			out.s[i] = out.s[i + shift];
		}
		out.s.resize(nw, 0 as! byte);
	}
	g.steps += 1;
	out.i = out.s.len;
	out
}
@end
@entry b8dcffec335c1e16
kind: step
verb: shift
noun: total
modifier: unique
context: error
phrase: shift total unique error values
phrase: add unique count to first error element
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="unique error count shifted: 3" errors=0 n=4 res=[13,20,10,30] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="unique error count shifted: 1" errors=0 n=3 res=[6,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		var seen = false;
		for j in i { if g.res[j] == g.res[i] { seen = true; break; } }
		if !seen { count++; }
	}
	if g.n > 0 { g.res[0] += count; }
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "unique error count shifted: ", count);
	out
}
@end
