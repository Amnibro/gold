	while i < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		gold_cache_put(g, i, g.res[i]);
		gold_cache_put(g, i + 1, g.res[i + 1]);
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n / 2;
	out.s.clear();
	format(out.s, "shifted ", g.n / 2, " pairs with cache");
	out
}
