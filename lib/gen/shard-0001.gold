fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n % 2 != 0 {
		gold_fail(g, "odd number of elements for pairs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: odd number of elements for pairs");
		return out;
	}
