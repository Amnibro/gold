fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let flr = ${floor_val};
	if g.n == 0 {
		gold_push(g, flr);
		out.i = flr;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	if min_val < flr { min_val = flr; }
	gold_push(g, min_val);
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "merged minimum ", min_val, " safely");
	out
}
@end
