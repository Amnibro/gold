test: list=5,10,15
expect: => i=30 r=0.0 ok=true s="running sum is 30" errors=0 n=3 res=[15,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty loop");
		out.ok = false;
		return out;
	}
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "running sum is ", sum);
	out
}
@end
@entry 13d43871ff18cd8f
kind: step
verb: pair
noun: sequence
modifier: at_most
context: list
phrase: pair sequence items at most {cap} times
phrase: combine sequence pairs at most count {cap}
slot: cap int
test: list=1,2,3,4,5,6 cap=2
expect: => i=2 r=0.0 ok=true s="paired 2 sequence items" errors=0 n=4 res=[3,7,5,6] cache=0 hits=0
test: list=10,20,30,40 cap=1
expect: => i=1 r=0.0 ok=true s="paired 1 sequence items" errors=0 n=3 res=[30,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if limit <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	var i = 0;
	var w = 0;
	while i + 1 < g.n && pairs < limit {
		g.res[w] = g.res[i] + g.res[i + 1];
		w++;
		i += 2;
		pairs++;
	}
	while i < g.n {
		g.res[w] = g.res[i];
		w++;
		i++;
	}
	g.steps += g.n;
	g.n = w;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " sequence items");
	out
}
@end
