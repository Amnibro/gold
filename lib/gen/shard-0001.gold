code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var pass = true;
	for i in g.n {
		if g.res[i] > lim {
			pass = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = pass;
	out.i = if pass { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all items within ceiling: ", pass);
	out
}
@end
