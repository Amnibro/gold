test: list=1,2,3,4 block_size=2
expect: => i=2 r=0.0 ok=true s="rotated nested list blocks of size 2" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=1,2,3 block_size=5
expect: => i=0 r=0.0 ok=false s="error: block size exceeds list length" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsize = ${block_size};
	if bsize <= 1 || bsize > g.n {
		gold_fail(g, "block size exceeds list length");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: block size exceeds list length");
		return out;
	}
	var i = 0;
	while i + bsize <= g.n {
		let first = g.res[i];
		for k in 1..bsize {
			g.res[i + k - 1] = g.res[i + k];
		}
		g.res[i + bsize - 1] = first;
		i += bsize;
	}
	g.steps += g.n;
	out.i = bsize;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated nested list blocks of size ", bsize);
	out
}
@end
