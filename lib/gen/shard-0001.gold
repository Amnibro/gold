slot: hi int
test: list=5,10,50,20,100 lo=10 hi=40
expect: => i=3 r=0.0 ok=true s="clamped 3 alternating values" errors=0 n=5 res=[10,10,40,20,40] cache=3 hits=0
test: list=10,20 lo=50 hi=20
expect: => i=0 r=0.0 ok=false s="error: lower bound exceeds upper bound" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if low > high {
		gold_fail(g, "invalid clamp range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: lower bound exceeds upper bound");
		return out;
	}
	var clamped = 0;
	var i = 0;
	while i < g.n {
		let old_val = g.res[i];
		if g.res[i] < low {
			g.res[i] = low;
			clamped++;
		} else if g.res[i] > high {
			g.res[i] = high;
			clamped++;
		}
		gold_cache_put(g, i, old_val);
		i += 2;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " alternating values");
	out
}
@end
