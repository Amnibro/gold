	let f = ${factor};
	if f <= 0 {
		gold_fail(g, "invalid scale factor");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive factor");
		return out;
	}
	var scaled = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] == g.res[k + 1] {
			g.res[k] *= f;
			g.res[k + 1] *= f;
			scaled += 2;
			k += 2;
		} else {
			k++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " elements in pairs");
	out
}
