@entry d69d16db161edf1f
kind: step
verb: rotate
noun: suffix
modifier: times
context: compare
phrase: rotate suffix slice {rotations} times
phrase: cycle trailing elements {rotations} steps
slot: rotations int
test: list=1,2,3,4 rotations=1
expect: => i=1 r=0.0 ok=true s="rotated elements by 1 steps" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30,40 rotations=2
expect: => i=2 r=0.0 ok=true s="rotated elements by 2 steps" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rotations};
	if g.n > 1 {
		for _ in r {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n * r;
	out.i = r;
	out.s.clear();
	format(out.s, "rotated elements by ", r, " steps");
	out
}
@end
