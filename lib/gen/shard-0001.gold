@entry 96785bc1031f2e1f
kind: step
verb: clamp
noun: runs
modifier: in_place
context: sort
phrase: clamp sorted duplicate runs in place to {limit}
phrase: limit contiguous sorted runs in place to {limit}
phrase: clamp identical sorted runs in place to at most {limit}
slot: limit int
test: list=7,2,2,2,2,5,5,1 limit=2
expect: => i=6 r=0.0 ok=true s="clamped sorted runs in place to limit 2" errors=0 n=6 res=[1,2,2,5,5,7] cache=0 hits=0
test: list=9,9,9,9 limit=1
expect: => i=1 r=0.0 ok=true s="clamped sorted runs in place to limit 1" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let take = if run_len < max_len { run_len } else { max_len };
		for k in take {
			g.res[kept] = g.res[i];
			kept++;
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped sorted runs in place to limit ", max_len);
	out
}
@end
