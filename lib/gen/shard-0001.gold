noun: duplicates
modifier: any
context: format
phrase: format distinct items without duplicates
phrase: render deduplicated values as string
phrase: display list dropping duplicate items
test: list=1,2,2,3,1
expect: => i=5 r=0.0 ok=true s="unique: [1, 2, 3]" errors=0 n=5 res=[1,2,2,3,1] cache=0 hits=0
test: list=5,5,5
expect: => i=3 r=0.0 ok=true s="unique: [5]" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "unique: [");
	var first = true;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		for j in i {
			if g.res[j] == x { dup = true; break; }
		}
		if !dup {
			if !first { format(out.s, ", "); }
			format(out.s, x);
			first = false;
		}
	}
	format(out.s, "]");
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
