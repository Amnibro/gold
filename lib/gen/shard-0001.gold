kind: step
verb: run
noun: values
modifier: nested
context: filter
phrase: run values nested matching {cond} length {min_len}
phrase: filter nested runs with {cond} threshold {min_len}
phrase: keep runs satisfying {cond} of size {min_len}
slot: cond pred
slot: min_len int
test: list=2,4,1,6,8,10 cond=is_even min_len=3
expect: => i=3 r=0.0 ok=true s="filtered nested runs count=3" errors=0 n=3 res=[6,8,10] cache=0 hits=0
test: list=1,3,2,5,7 cond=is_odd min_len=2
expect: => i=4 r=0.0 ok=true s="filtered nested runs count=4" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_run = ${min_len};
	var w = 0;
	var idx = 0;
	while idx < g.n {
		var run_end = idx;
		while run_end < g.n && ${cond}(g.res[run_end]) {
			run_end++;
		}
		let len = run_end - idx;
		if len >= min_run {
			var k = idx;
			while k < run_end {
				g.res[w] = g.res[k];
				w++;
				k++;
			}
		}
		idx = if run_end > idx { run_end } else { idx + 1 };
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "filtered nested runs count=", w);
	out
}
@end
@entry 71b0d9256fc448c8
kind: step
verb: join
noun: number
modifier: nested
context: filter
phrase: join number nested odd digits
phrase: filter odd digits joining into number
phrase: nested join of odd digits from value
test: input=47291
expect: => i=791 r=0.0 ok=true s="joined nested number=791" errors=0 n=0 res=[] cache=0 hits=0
test: input=86345
expect: => i=35 r=0.0 ok=true s="joined nested number=35" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.i;
	if n < 0 { n = -n; }
	var digits int[16] = [0; 16];
	var count = 0;
	while n > 0 {
		let d = n % 10;
		if d % 2 != 0 {
			digits[count] = d;
			count++;
		}
		n /= 10;
	}
	var res = 0;
	var idx = count - 1;
	while idx >= 0 {
		res = res * 10 + digits[idx];
		idx--;
	}
	out.i = res;
	out.s.clear();
	format(out.s, "joined nested number=", res);
	out
}
@end
