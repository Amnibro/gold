code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	if g.n >= req && g.n >= 2 {
		let idx1 = g.n - 1;
		let idx2 = g.n - 2;
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		out.i = 1;
		out.s.clear();
		format(out.s, "swapped tail elements");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "tail unchanged");
	}
	g.steps += 2;
	out
}
@end
