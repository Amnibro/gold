test: text="abac"
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq byte[..200] = [];
	for k in out.s.len {
		let c = out.s[k];
		var seen = false;
		for j in uniq.len {
			if uniq[j] == c { seen = true; break; }
		}
		if !seen && uniq.len < 200 {
			uniq.push(c);
		}
	}
	for i in uniq.len {
		for j in (i + 1)..uniq.len {
			if uniq[j] < uniq[i] {
				let tmp = uniq[i];
				uniq[i] = uniq[j];
				uniq[j] = tmp;
			}
		}
	}
	out.s.clear();
	for b in uniq { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
