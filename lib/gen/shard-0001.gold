code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	if g.n == 0 {
		format(out.s, "scaled: []");
		return out;
	}
	let base = g.res[g.n - 1];
	format(out.s, "scaled by ", base, ": [");
	for i in g.n {
		if i > 0 { format(out.s, ", "); }
		let val = if base != 0 { g.res[i] / base } else { 0 };
		format(out.s, val);
	}
	format(out.s, "]");
	out.i = base;
	g.steps += g.n;
	out
}
@end
