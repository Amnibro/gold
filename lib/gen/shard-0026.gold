fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.i = 0; return out; }
	let count = g.n - 1;
	for i in count {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "computed ", count, " steps");
	out
}
@end
