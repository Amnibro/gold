code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var passes = 0;
	while passes < t {
		for i in g.n {
			gold_cache_put(g, i, g.res[i] + passes);
		}
		passes++;
	}
	g.steps += g.n * passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "memo passes: ", passes);
	out
}
@end
