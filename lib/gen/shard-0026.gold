@entry f9a85f8b60484d86
kind: step
verb: search
noun: cache
modifier: safely
context: search
phrase: search cache safely for key {key} fallback {fallback}
phrase: lookup cached search key {key} default {fallback}
slot: key int
slot: fallback int
test: list=10,20 key=5 fallback=99
expect: => i=99 r=0.0 ok=false s="fallback used: 99" errors=0 n=3 res=[10,20,99] cache=2 hits=0
test: list=5,15 key=0 fallback=42
expect: => i=5 r=0.0 ok=true s="cache hit: 5" errors=0 n=3 res=[5,15,5] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let fb = ${fallback};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	let val, ok = gold_cache_get(g, k);
	var res_val = fb;
	if ok {
		res_val = val;
	}
	gold_push(g, res_val);
	g.steps += g.n + 1;
	out.ok = ok;
	out.i = res_val;
	out.s.clear();
	if ok {
		format(out.s, "cache hit: ", res_val);
	} else {
		format(out.s, "fallback used: ", fb);
	}
	out
}
@end
@entry c3de2710cf42501d
kind: step
verb: dedupe
noun: words
modifier: unique
context: search
phrase: dedupe words unique query match {target}
phrase: filter unique word occurrences around {target}
slot: target int
test: list=1,2,2,3,1,4 target=2
expect: => i=4 r=0.0 ok=true s="unique words: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6 target=5
expect: => i=2 r=0.0 ok=true s="unique words: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var uniq = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in un {
			if uniq[j] == x {
				exists = true;
				break;
			}
		}
		if !exists {
			uniq[un] = x;
			un++;
		}
	}
	var matched = 0;
	gold_clear(g);
	for k in un {
		gold_push(g, uniq[k]);
		if uniq[k] == tgt {
			matched++;
		}
	}
	g.steps += un;
	out.i = un;
	out.ok = matched > 0;
	out.s.clear();
	format(out.s, "unique words: ", un);
	out
}
@end
