expect: => i=1 r=0.0 ok=true s="rot: 2,3,1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 || s <= 0 { return out; }
	let k = s % g.n;
	out.s.clear();
	format(out.s, "rot: ");
	var i = 0;
	while i < g.n {
		let idx = (i + k) % g.n;
		if i > 0 { out.s.push(','); }
		format(out.s, g.res[idx]);
		i++;
	}
	out.i = k;
	out
}
@end
