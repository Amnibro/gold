phrase: preserve in_place middle baseline {cutoff}
slot: cutoff int
test: list=5,15,25,35 cutoff=20
expect: => i=2 r=0.0 ok=true s="kepmidd: 2" errors=0 n=2 res=[25,35] cache=0 hits=0
test: list=8,12,16 cutoff=10
expect: => i=2 r=0.0 ok=true s="kepmidd: 2" errors=0 n=2 res=[12,16] cache=0 hits=0
test: list=2 cutoff=-5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_keep_middle_in_place_alpha = 0;
	let c = ${cutoff};
	if c < 0 { gold_fail(g, "negative cutoff"); out.ok = false; return out; }
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] >= c {
			g.res[kept] = g.res[idx];
			kept++;
		}
		idx++;
	}
	g.n = kept;
	out.i = kept + mark_keep_middle_in_place_alpha;
	out.s.clear();
	format(out.s, "kepmidd: ", kept);
	out
}
@end
