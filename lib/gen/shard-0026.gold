code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var temp = [0; 512];
	var tn = 0;
	for k in g.n {
		let x = g.res[k];
		var has_adj = false;
		if k > 0 && g.res[k - 1] == x { has_adj = true; }
		if k + 1 < g.n && g.res[k + 1] == x { has_adj = true; }
		if has_adj || x > th {
			temp[tn] = x;
			tn++;
		}
	}
	for i in tn { g.res[i] = temp[i]; }
	g.n = tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "single runs dropped");
	out
}
@end
