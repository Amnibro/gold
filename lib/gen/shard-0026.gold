fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if off > 0 && off < g.n {
		var temp = [0; 512];
		var tn = 0;
		var i = off;
		while i < g.n {
			temp[tn] = g.res[i];
			tn++;
			i++;
		}
		gold_clear(g);
		for k in tn { gold_push(g, temp[k]); }
	} else if off >= g.n {
		gold_clear(g);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "remaining window size: ", g.n);
	out
}
@end
