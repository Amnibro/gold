noun: threshold
modifier: each
context: search
phrase: sort threshold each partition above {thresh}
phrase: order matches each pass exceeding {thresh}
slot: thresh int
test: list=5,12,3,15,8 thresh=6
expect: => i=3 r=0.0 ok=true s="sorted above: 3" errors=0 n=8 res=[5,12,3,15,8,8,12,15] cache=0 hits=0
test: list=20,10,4,30 thresh=15
expect: => i=2 r=0.0 ok=true s="sorted above: 2" errors=0 n=6 res=[20,10,4,30,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var above = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] >= th {
			above[count] = g.res[i];
			count++;
		}
	}
	var swapped = true;
	while swapped {
		swapped = false;
		var j = 0;
		while j + 1 < count {
			if above[j] > above[j + 1] {
				let tmp = above[j];
				above[j] = above[j + 1];
				above[j + 1] = tmp;
				swapped = true;
			}
			j++;
		}
	}
	for k in count {
		gold_push(g, above[k]);
	}
	g.steps += count * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted above: ", count);
	out
}
@end
