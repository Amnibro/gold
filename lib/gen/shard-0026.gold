kind: step
verb: sort
noun: sequence
modifier: with_cache
context: compare
phrase: sort sequence with cache partitioned by pivot {pivot}
phrase: order sequence with cache around pivot {pivot}
phrase: sort items with cache threshold pivot {pivot}
slot: pivot int
test: list=40,10,30,20 pivot=25
expect: => i=2 r=0.0 ok=true s="sorted cached: 2" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
test: list=5,15,25 pivot=25
expect: => i=3 r=0.0 ok=true s="sorted cached: 3" errors=0 n=3 res=[5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
		}
	}
	var part = 0;
	for k in g.n { if g.res[k] <= p { part++; } }
	gold_cache_put(g, p, part);
	out.i = part;
	out.s.clear();
	format(out.s, "sorted cached: ", part);
	out
}
@end
