code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, g.res[i], i + 1);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached ", g.n, " elements");
	out
}
@end
