phrase: invert words recursively passes count {limit}
slot: limit int
test: text="gamma beta alpha delta" limit=2
expect: => i=22 r=0.0 ok=true s="atled ahpla ateb ammag" errors=0 n=0 res=[] cache=0 hits=0
test: text="zebra lion bear" limit=1
expect: => i=15 r=0.0 ok=true s="raeb noil arbez" errors=0 n=0 res=[] cache=0 hits=0
code:
// sort step reverse words recursively
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var buf: byte[..200] = "";
	var k = out.s.len - 1;
	while k >= 0 {
		buf.push(out.s[k]);
		k--;
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += lim;
	out.i = out.s.len;
	out
}
@end
