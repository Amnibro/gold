fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for window product");
		return out;
	}
	let m = g.n - 1;
	for k in m {
		g.res[k] = g.res[k] * g.res[k + 1];
	}
	g.steps += m;
	g.n = m;
	out.i = m;
	out.s.clear();
	format(out.s, "computed ", m, " window products");
	out
}
@end
