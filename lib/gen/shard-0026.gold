@entry b6bcb35eeed1fed1
kind: step
verb: swap
noun: histogram
modifier: safely
context: loop
phrase: swap histogram bins safely using count {bins}
phrase: safely swap extreme histogram counts across {bins}
slot: bins int
test: list=1,2,2,3,3,3,4 bins=4
expect: => i=4 r=0.0 ok=true s="histogram swapped safely: 4" errors=0 n=4 res=[3,1,2,1] cache=0 hits=0
test: list=0,1,1,2,2,2,2 bins=3
expect: => i=3 r=0.0 ok=true s="histogram swapped safely: 3" errors=0 n=3 res=[4,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	if b <= 1 || b > 16 || g.n == 0 { out.ok = false; return out; }
	var counts = [0; 16];
	for i in g.n {
		let idx = ((g.res[i] % b) + b) % b;
		counts[idx]++;
	}
	var min_i = 0;
	var max_i = 0;
	for i in b {
		if counts[i] < counts[min_i] { min_i = i; }
		if counts[i] > counts[max_i] { max_i = i; }
	}
	let tmp = counts[min_i];
	counts[min_i] = counts[max_i];
	counts[max_i] = tmp;
	gold_clear(g);
	for i in b { gold_push(g, counts[i]); }
	out.i = b;
	out.s.clear();
	format(out.s, "histogram swapped safely: ", b);
	out
}
@end
