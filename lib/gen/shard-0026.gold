code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var sum = 0;
	for i in (g.n - 1) {
		sum += g.res[i];
	}
	g.res[g.n - 1] += sum;
	let final_val = g.res[g.n - 1];
	g.steps += g.n;
	out.i = final_val;
	out.s.clear();
	format(out.s, "merged into last: ", final_val);
	out
}
@end
