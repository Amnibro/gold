expect: => i=1 r=0.0 ok=true s="step in place check: 1" errors=0 n=4 res=[3,6,9,12] cache=0 hits=0
test: list=2,4,7,9 expected=2
expect: => i=0 r=0.0 ok=false s="step in place check: 0" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var ok = true;
	if g.n < 2 { ok = false; }
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] != exp {
			ok = false;
			break;
		}
		i++;
	}
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "step in place check: ", out.i);
	out
}
@end
