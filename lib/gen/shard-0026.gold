fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_span = ${span};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = 0 - diff; }
		if diff > max_span { valid = false; break; }
		i++;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked range pairwise: ", out.i);
	out
}
@end
