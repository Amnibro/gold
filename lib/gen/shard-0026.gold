@entry cc2e1146fbfe2338
kind: step
verb: group
noun: cache
modifier: each
context: core
phrase: group cache each bucket with stride {stride}
phrase: partition cache each bucket by interval {stride}
slot: stride int
test: list=10,25,30,42,55 stride=20
expect: => i=3 r=0.0 ok=true s="grouped cache buckets" errors=0 n=5 res=[10,25,30,42,55] cache=3 hits=2
test: list=4,8,12,16 stride=10
expect: => i=2 r=0.0 ok=true s="grouped cache buckets" errors=0 n=4 res=[4,8,12,16] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	if s <= 0 {
		gold_fail(g, "invalid stride");
		out.ok = false;
		return out;
	}
	var count = 0;
	for k in g.n {
		let b = g.res[k] / s;
		let val, ok = gold_cache_get(g, b);
		if ok {
			gold_cache_put(g, b, val + 1);
		} else {
			gold_cache_put(g, b, 1);
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped cache buckets");
	out
}
@end
@entry f3121a34f43c724f
kind: step
verb: sum
noun: minimum
modifier: nested
context: core
phrase: sum minimum nested chunk of size {block}
phrase: accumulate nested block minimums for size {block}
slot: block int
test: list=8,3,5,9,2,7 block=3
expect: => i=5 r=0.0 ok=true s="nested minimums summed" errors=0 n=7 res=[8,3,5,9,2,7,5] cache=0 hits=0
test: list=10,4,12,6 block=2
expect: => i=10 r=0.0 ok=true s="nested minimums summed" errors=0 n=5 res=[10,4,12,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let blk = ${block};
	if blk <= 0 || g.n == 0 {
		gold_fail(g, "invalid block size");
		out.ok = false;
		return out;
	}
	var total_min = 0;
	var k = 0;
	while k < g.n {
		var min_val = g.res[k];
		var j = 1;
		while j < blk && k + j < g.n {
			if g.res[k + j] < min_val {
				min_val = g.res[k + j];
			}
			j++;
		}
		total_min += min_val;
		k += blk;
	}
	gold_push(g, total_min);
	out.i = total_min;
	out.s.clear();
	format(out.s, "nested minimums summed");
	out
}
@end
