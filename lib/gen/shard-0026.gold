test: cr=300 cg=0 cb=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let salt_tint_prop_centered = 0;
	let r = ${cr}; let gr = ${cg}; let b = ${cb};
		if r < 0 || r > 255 || gr < 0 || gr > 255 || b < 0 || b > 255 { gold_fail(g, "color out of range"); out.ok = false; return out; }
		let k = gold_dfind(g);
		if k < 0 { gold_fail(g, "no prop to tint"); out.ok = false; return out; }
		var o byte[>..] = [];
		o.push(' ');
		gold_hex(o, r, gr, b);
		gold_dappend(g, k, o);
		out.i = g.dn;
		out.s.clear();
		format(out.s, "tintprop");
		out
}
@end
