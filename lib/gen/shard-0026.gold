phrase: verify maximum observation at most limit {cap}
slot: cap int
test: list=5,15,25 cap=30
expect: => i=1 r=0.0 ok=true s="check at most limit: true" errors=0 n=3 res=[5,15,25] cache=0 hits=0
test: list=10,50,20 cap=40
expect: => i=0 r=0.0 ok=true s="check at most limit: false" errors=0 n=3 res=[10,50,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	if g.n == 0 {
		out.i = 1;
		out.s.clear();
		format(out.s, "empty sample check true");
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	g.steps += g.n;
	let ok = max_val <= lim;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "check at most limit: ", ok);
	out
}
@end
