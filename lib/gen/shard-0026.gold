fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			found_idx = i;
			break;
		}
		i--;
	}
	g.steps += if found_idx >= 0 { g.n - found_idx } else { g.n };
	out.i = found_idx;
	out.s.clear();
	format(out.s, "last index ", found_idx);
	out
}
@end
