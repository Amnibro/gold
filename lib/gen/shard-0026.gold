@entry 44ee6769fc9e9714
kind: step
verb: rotate
noun: loop
modifier: at_least
context: search
phrase: rotate loop at least offset {shift}
phrase: cycle search ring buffer at least {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated steps: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated steps: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var rot = sh % g.n;
	if rot < 0 { rot += g.n; }
	var tmp = [0; 512];
	for i in g.n {
		let dest = (i + rot) % g.n;
		tmp[dest] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated steps: ", rot);
	out
}
@end
