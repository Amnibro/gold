// sort step map checkpoint times
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
