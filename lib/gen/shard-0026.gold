@entry 89c773ff2b4c47f9
kind: step
verb: swap
noun: minimum
modifier: sorted
context: stats
phrase: swap minimum value to front position
phrase: move minimum observation to front
test: list=20,10,30
expect: => i=10 r=0.0 ok=true s="swapped minimum 10 to front" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,15,40
expect: => i=15 r=0.0 ok=true s="swapped minimum 15 to front" errors=0 n=3 res=[15,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	let min_val = g.res[min_idx];
	let tmp = g.res[0];
	g.res[0] = min_val;
	g.res[min_idx] = tmp;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "swapped minimum ", min_val, " to front");
	out
}
@end
