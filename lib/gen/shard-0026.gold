@entry 0388185725cd20a2
kind: step
verb: pair
noun: vowels
modifier: sorted
context: sort
phrase: pair vowels sorted order {order}
phrase: arrange vowels sorted direction {order}
slot: order int
test: text="sorting algorithm" order=1
expect: => i=2 r=0.0 ok=true s="paired vowels: 2" errors=0 n=2 res=[202,216] cache=0 hits=0
test: text="quick bubble selection" order=-1
expect: => i=4 r=0.0 ok=true s="paired vowels: 4" errors=0 n=4 res=[234,216,206,202] cache=0 hits=0
code:
// sort step pair vowels sorted
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ord = ${order};
	var chars = [0; 256];
	var cn = 0;
	for b in out.s {
		let c = b as int;
		if c == 97 || c == 101 || c == 105 || c == 111 || c == 117 {
			chars[cn] = c;
			cn++;
		}
	}
	if cn >= 2 {
		for i in cn - 1 {
			for j in cn - 1 - i {
				let swap_cond = if ord > 0 { chars[j] > chars[j + 1] } else { chars[j] < chars[j + 1] };
				if swap_cond {
					let tmp = chars[j];
					chars[j] = chars[j + 1];
					chars[j + 1] = tmp;
				}
			}
		}
	}
	gold_clear(g);
	var pairs = 0;
	var i = 0;
	while i + 1 < cn {
		gold_push(g, chars[i] + chars[i + 1]);
		pairs++;
		i += 2;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired vowels: ", pairs);
	out
}
@end
