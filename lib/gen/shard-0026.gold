expect: => i=2 r=0.0 ok=true s="head tail kept: 2" errors=0 n=2 res=[10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let hc = ${h_count};
	let tc = ${t_count};
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < hc && i < g.n {
		kept[kn] = g.res[i];
		kn++;
		i++;
	}
	var t_start = g.n - tc;
	if t_start < hc { t_start = hc; }
	i = t_start;
	while i < g.n {
		kept[kn] = g.res[i];
		kn++;
		i++;
	}
	gold_clear(g);
	for j in kn { gold_push(g, kept[j]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "head tail kept: ", kn);
	out
}
@end
