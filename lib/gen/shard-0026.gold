	let sl = ${slice_len};
	if sl > 0 && g.n > sl {
		let drop = g.n - sl;
		var i = 0;
		while i < sl {
			g.res[i] = g.res[drop + i];
			i++;
		}
		g.n = sl;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "truncated list size: ", g.n);
