@entry b0fa0dc72fd4cd22
kind: step
verb: map
noun: average
modifier: at_most
context: loop
phrase: map values to average distance capping results at most {cap}
phrase: transform entries by average deviation constrained at most {cap}
slot: cap int
test: list=10,20,30,40,50 cap=15
expect: => i=50 r=0.0 ok=true s="mapped average: 50" errors=0 n=5 res=[15,10,0,10,15] cache=0 hits=0
test: list=2,6,10,14 cap=5
expect: => i=14 r=0.0 ok=true s="mapped average: 14" errors=0 n=4 res=[5,2,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var tot = 0;
	for k in g.n {
		var diff = g.res[k] - avg;
		if diff < 0 { diff = 0 - diff; }
		if diff > limit { diff = limit; }
		g.res[k] = diff;
		tot += diff;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "mapped average: ", tot);
	out
}
@end
