code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var arr int[256] = [0; 256];
	var n = g.n;
	var i = 0;
	while i < n {
		var x = g.res[i];
		var c = 0;
		while x > 1 && c < 50 {
			if x % 2 == 0 { x /= 2; } else { x = 3 * x + 1; }
			c++;
		}
		arr[i] = c;
		i++;
	}
	var a = 0;
	while a < n {
		var min_idx = a;
		var b = a + 1;
		while b < n {
			if arr[b] < arr[min_idx] { min_idx = b; }
			b++;
		}
		if min_idx != a {
			let tmp = arr[a]; arr[a] = arr[min_idx]; arr[min_idx] = tmp;
		}
		a++;
	}
	out.s.clear();
	var k = 0;
	while k < n {
		if k > 0 { out.s.push(','); }
		format(out.s, arr[k]);
		k++;
	}
	out.i = n;
	out
}
@end
