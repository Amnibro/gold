fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let scale = ${scale_val};
	if g.n < 2 || scale == 0 {
		return out;
	}
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = diff / scale;
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized pairwise count: ", g.n);
	out
}
