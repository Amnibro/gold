kind: step
verb: count
noun: threshold
modifier: with_retry
context: loop
phrase: count elements above threshold {threshold} with retry count {retries}
phrase: tally threshold {threshold} violations with retry attempts {retries}
slot: threshold int
slot: retries int
test: list=5,10,15 threshold=12 retries=2
expect: => i=1 r=0.0 ok=true s="threshold count with retry: 1" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=2,4,6 threshold=10 retries=3
expect: => i=1 r=0.0 ok=true s="threshold count with retry: 1" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var thresh = ${threshold};
	let retries = ${retries};
	var count = 0;
	var r = 0;
	while r <= retries {
		count = 0;
		for i in g.n {
			if g.res[i] >= thresh { count++; }
		}
		if count > 0 || r == retries { break; }
		thresh = thresh - 2;
		r++;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "threshold count with retry: ", count);
	out
}
@end
@entry d1ab61c179c10ab7
kind: step
verb: measure
noun: spaces
modifier: all
context: loop
phrase: measure all spaces between adjacent entries under {limit}
phrase: evaluate all spacing differences against limit {limit}
slot: limit int
test: list=2,5,10,18 limit=10
expect: => i=3 r=0.0 ok=true s="measured spaces count: 3" errors=0 n=3 res=[3,5,8] cache=0 hits=0
test: list=1,4,9,16 limit=15
expect: => i=3 r=0.0 ok=true s="measured spaces count: 3" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	if g.n < 2 { out.ok = false; return out; }
	let old_n = g.n;
	var diffs = [0; 64];
	var valid = true;
	for i in old_n - 1 {
		let d = g.res[i + 1] - g.res[i];
		let abs_d = if d < 0 { -d } else { d };
		if abs_d > limit { valid = false; }
		if i < 64 { diffs[i] = abs_d; }
	}
	gold_clear(g);
	for i in old_n - 1 {
		if i < 64 { gold_push(g, diffs[i]); }
	}
	out.ok = valid;
	out.i = g.n;
	out.s.clear();
	format(out.s, "measured spaces count: ", g.n);
	out
}
@end
@entry fbdc49b38d08b2ab
kind: step
verb: swap
noun: odds
modifier: up_to
context: loop
phrase: swap odd pairs up to boundary {bound}
phrase: permute odd numbers up to index {bound}
slot: bound int
test: list=1,4,3,8,5 bound=4
expect: => i=1 r=0.0 ok=true s="swapped odds up to bound: 1" errors=0 n=5 res=[3,4,1,8,5] cache=0 hits=0
test: list=7,2,9,6,11 bound=3
expect: => i=1 r=0.0 ok=true s="swapped odds up to bound: 1" errors=0 n=5 res=[9,2,7,6,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	var first_odd = -1;
	var second_odd = -1;
	var i = 0;
	while i < g.n && i <= bound {
		if g.res[i] % 2 != 0 {
			if first_odd < 0 { first_odd = i; }
			else if second_odd < 0 { second_odd = i; break; }
		}
		i++;
	}
	var swapped = false;
	if first_odd >= 0 && second_odd >= 0 {
		let tmp = g.res[first_odd];
		g.res[first_odd] = g.res[second_odd];
		g.res[second_odd] = tmp;
		swapped = true;
	}
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "swapped odds up to bound: ", out.i);
	out
}
@end
@entry d7f68c18a05398c0
kind: step
verb: reverse
noun: primes
modifier: unique
context: loop
phrase: reverse unique primes within limit {limit}
phrase: invert unique prime elements under {limit}
slot: limit int
test: list=2,3,2,5,7,4,9 limit=10
expect: => i=4 r=0.0 ok=true s="reversed unique primes count: 4" errors=0 n=4 res=[7,5,3,2] cache=0 hits=0
test: list=11,13,11,17,4 limit=15
expect: => i=2 r=0.0 ok=true s="reversed unique primes count: 2" errors=0 n=2 res=[13,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var primes = [0; 64];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= lim {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				var dup = false;
				for k in pn {
					if primes[k] == x { dup = true; break; }
				}
				if !dup && pn < 64 {
					primes[pn] = x;
					pn++;
				}
			}
		}
	}
	gold_clear(g);
	var j = pn - 1;
	while j >= 0 {
		gold_push(g, primes[j]);
		j--;
	}
	out.i = pn;
	out.s.clear();
	format(out.s, "reversed unique primes count: ", pn);
	out
}
@end
