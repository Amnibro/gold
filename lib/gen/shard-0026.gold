noun: counter
modifier: last
context: loop
phrase: select trailing elements using counter size {take}
phrase: retain last counter items from loop sequence with count {take}
slot: take int
test: list=10,20,30,40,50 take=3
expect: => i=3 r=0.0 ok=true s="selected counter last: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3,4,5,6 take=2
expect: => i=2 r=0.0 ok=true s="selected counter last: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${take};
	if k <= 0 { g.n = 0; out.i = 0; return out; }
	if k >= g.n { out.i = g.n; return out; }
	let start = g.n - k;
	for i in k {
		g.res[i] = g.res[start + i];
	}
	g.n = k;
	out.i = k;
	out.s.clear();
	format(out.s, "selected counter last: ", k);
	out
}
@end
