// sort step map suffix sorted
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var start = g.n - tl;
	if start < 0 { start = 0; }
	var k = start;
	while k < g.n {
		g.res[k] *= 2;
		k++;
	}
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "suffix items mapped: ", out.i);
	out
}
@end
