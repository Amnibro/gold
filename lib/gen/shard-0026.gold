code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	let cx_0 = ((g.iw - 1) as real) / 2.0;
	let cy_0 = ((g.ih - 1) as real) / 2.0;
	var rr_0 = (g.iw as real) / 2.0;
	if g.ih < g.iw { rr_0 = (g.ih as real) / 2.0; }
	for y in g.ih {
		for x in g.iw {
			let a_0 = (x as real) - cx_0;
			let b_0 = (y as real) - cy_0;
			g.img[y * g.iw + x] = gold_clamp01(1.0 - sqrt(a_0 * a_0 + b_0 * b_0) / rr_0);
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t_1 = 0.0;
			for dy in 3 { for dx in 3 { t_1 += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_1[y * g.iw + x] = t_1 / 9.0;
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - ${a}); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
