fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen1 int[128] = [0; 128];
	var seen2 int[128] = [0; 128];
	var sn = 0;
	out.s.clear();
	var i = g.n - 2;
	while i >= 0 {
		let a = g.res[i];
		let b = g.res[i + 1];
		var found = false;
		var k = 0;
		while k < sn {
			if seen1[k] == a && seen2[k] == b { found = true; }
			k++;
		}
		if !found {
			seen1[sn] = a; seen2[sn] = b; sn++;
			if out.s.len > 0 { out.s.push(';'); }
			format(out.s, "(", a, ",", b, ")");
		}
		i -= 2;
	}
	out.i = sn;
	out
}
@end
