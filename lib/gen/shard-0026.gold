expect: => i=4 r=0.0 ok=true s="sorted 4 items ascending" errors=0 n=4 res=[5,10,25,40] cache=0 hits=0
test: list=3,1,2
expect: => i=3 r=0.0 ok=true s="sorted 3 items ascending" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items ascending");
	out
}
@end
