code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulo};
	if m <= 0 {
		gold_fail(g, "invalid modulo");
		out.ok = false;
		return out;
	}
	var w = 0;
	var k = 0;
	while k < g.n {
		g.res[w] = g.res[k] % m;
		w++;
		k += 2;
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "alternating runs collected");
	out
}
@end
@entry ef03cba2fadaffd9
kind: step
