test: list=2,2,4,4,6
expect: => i=3 r=0.0 ok=true s="unique count multiplier: 3" errors=0 n=5 res=[6,6,12,12,18] cache=0 hits=0
test: list=10,10,10
expect: => i=1 r=0.0 ok=true s="unique count multiplier: 1" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] { first = false; }
		}
		if first { u++; }
	}
	if u > 0 {
		for i in g.n { g.res[i] *= u; }
	}
	out.i = u;
	out.s.clear();
	format(out.s, "unique count multiplier: ", u);
	out
}
@end
