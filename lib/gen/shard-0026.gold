fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low_key};
	let hi = ${high_key};
	gold_cache_put(g, lo, lo * 10);
	gold_cache_put(g, hi, hi * 10);
	var total = 0;
	var found = 0;
	for k in g.cn {
		if g.ck[k] >= lo && g.ck[k] <= hi {
			total += g.cv[k];
			found++;
		}
	}
	g.steps += g.cn;
	out.i = total;
	out.s.clear();
	format(out.s, "cache range sum: ", total, " items: ", found);
	out
}
@end
