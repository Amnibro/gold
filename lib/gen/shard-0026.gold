slot: chunk int
test: list=15,25 chunk=10
expect: => i=5 r=0.0 ok=true s="numbers split up to chunk" errors=0 n=5 res=[10,5,10,10,5] cache=0 hits=0
test: list=30 chunk=12
expect: => i=3 r=0.0 ok=true s="numbers split up to chunk" errors=0 n=3 res=[12,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 {
		gold_fail(g, "invalid chunk size");
		out.ok = false;
		return out;
	}
	var temp = [0; 512];
	var tn = 0;
	for k in g.n {
		var rem = g.res[k];
		while rem > 0 {
			let piece = if rem > c { c } else { rem };
			temp[tn] = piece;
			tn++;
			rem -= piece;
		}
	}
	for i in tn { g.res[i] = temp[i]; }
	g.n = tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "numbers split up to chunk");
	out
}
@end
