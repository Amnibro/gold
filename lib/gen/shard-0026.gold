code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delim};
	var pos = 0;
	while pos < out.s.len && out.s[pos] as int != d {
		pos++;
	}
	out.s.resize(pos, 0);
	g.steps += pos;
	out.i = pos;
	out
}
@end
@entry 3c8a73f39a315041
kind: step
verb: keep
noun: gaps
modifier: last
context: transform
phrase: keep differences between adjacent elements placed last
phrase: compute consecutive element gaps appended last
test: list=10,15,22,30
expect: => i=7 r=0.0 ok=true s="appended 3 gaps" errors=0 n=7 res=[10,15,22,30,5,7,8] cache=0 hits=0
test: list=2,7,11,20
expect: => i=7 r=0.0 ok=true s="appended 3 gaps" errors=0 n=7 res=[2,7,11,20,5,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	let orig_n = g.n;
	for i in (orig_n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		g.res[orig_n + i] = diff;
	}
	g.n = orig_n + orig_n - 1;
	g.steps += orig_n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "appended ", orig_n - 1, " gaps");
	out
}
@end
