@entry ea102b828de87628
kind: step
verb: retry
noun: numbers
modifier: with_retry
context: stats
phrase: retry numbers with retry limit {max_retries}
phrase: adjust numbers with retry attempts {max_retries}
slot: max_retries int
test: list=15,25,35 max_retries=3
expect: => i=2 r=0.0 ok=true s="retried 2 numbers" errors=0 n=3 res=[15,20,20] cache=0 hits=0
test: list=4,8,12 max_retries=1
expect: => i=0 r=0.0 ok=true s="retried 0 numbers" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_retries};
	var retries = 0;
	for k in g.n {
		if g.res[k] > 20 && retries < lim {
			g.res[k] = 20;
			retries++;
		}
	}
	g.steps += g.n;
	out.i = retries;
	out.s.clear();
	format(out.s, "retried ", retries, " numbers");
	out
}
@end
@entry 889bbfe20c77ab54
kind: step
verb: swap
noun: minimum
modifier: between
context: stats
phrase: swap minimum element between range {lo} to {hi}
phrase: shift minimum item between range {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,50,20,30 lo=1 hi=3
expect: => i=20 r=0.0 ok=true s="minimum 20 swapped to position 1" errors=0 n=4 res=[10,20,50,30] cache=0 hits=0
test: list=40,30,10,20 lo=0 hi=2
expect: => i=10 r=0.0 ok=true s="minimum 10 swapped to position 0" errors=0 n=4 res=[10,30,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${lo};
	var hi = ${hi};
	if lo < 0 { lo = 0; }
	if hi >= g.n { hi = g.n - 1; }
	if lo >= hi { return out; }
	var min_idx = lo;
	for k in (lo + 1)..(hi + 1) {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	let min_val = g.res[min_idx];
	let tmp = g.res[lo];
	g.res[lo] = min_val;
	g.res[min_idx] = tmp;
	g.steps += hi - lo + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum ", min_val, " swapped to position ", lo);
	out
}
@end
@entry 6065c85d2d06331f
kind: step
verb: pair
noun: memo
modifier: at_least
context: stats
phrase: pair memo differences at least {threshold}
phrase: count memo steps at least {threshold}
slot: threshold int
test: list=5,15,18,30 threshold=10
expect: => i=2 r=0.0 ok=true s="paired 2 memo intervals" errors=0 n=4 res=[5,15,18,30] cache=0 hits=0
test: list=2,4,6,8 threshold=5
expect: => i=0 r=0.0 ok=true s="paired 0 memo intervals" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for memo pairing");
		return out;
	}
	var count = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let d = if diff < 0 { -diff } else { diff };
		if d >= thresh { count++; }
	}
	g.steps += g.n - 1;
	out.i = count;
	out.s.clear();
	format(out.s, "paired ", count, " memo intervals");
	out
}
@end
