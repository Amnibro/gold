code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sp = ${span};
	if sp > g.n { sp = g.n; }
	if sp <= 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in sp {
		sum += g.res[i];
	}
	let avg = sum / sp;
	gold_push(g, avg);
	g.steps += sp;
	out.i = avg;
	out.s.clear();
	format(out.s, "prefix average: ", avg);
	out
}
@end
