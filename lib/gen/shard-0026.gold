expect: => i=15 r=0.0 ok=true s="pairwise gcd head: 15" errors=0 n=2 res=[15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			var a = g.res[i];
			var b = g.res[i + 1];
			if a < 0 { a = -a; }
			if b < 0 { b = -b; }
			while b != 0 {
				let t = b;
				b = a % b;
				a = t;
			}
			g.res[i] = a;
			i++;
		}
		g.n = i;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "pairwise gcd head: ", out.i);
	out
}
@end
