fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var ok_flag = true;
	for k in g.n - 1 {
		if g.res[k + 1] - g.res[k] < d { ok_flag = false; break; }
	}
	out.ok = ok_flag;
	out.i = if ok_flag { 1 } else { 0 };
	out.s.clear();
	format(out.s, "pairs valid: ", out.i);
	out
}
