fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let me = ${max_errs};
	gold_fail(g, "simulated error");
	if g.errors > me {
		g.errors = me;
		out.ok = false;
	}
	g.steps += 1;
	out.i = g.errors;
	out.s.clear();
	format(out.s, "split errors up to: ", g.errors);
	out
}
@end
