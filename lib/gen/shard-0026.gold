phrase: noisy concrete tone variation from seed {u}
slot: u int
model: noise c=4 u=${u}; slope; normalize
test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="concrete" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=23012 hash=20252
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="concrete" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=89454 hash=457179
test: u=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	// texture step tone concrete noisy
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s2_1[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s2_1;
	var mn_2 = g.img[0];
	var mx_2 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn_2 { mn_2 = g.img[k]; } if g.img[k] > mx_2 { mx_2 = g.img[k]; } }
	if mx_2 - mn_2 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn_2) / (mx_2 - mn_2); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "concrete");
	out
}
@end
