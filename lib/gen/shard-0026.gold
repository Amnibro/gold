slot: budget int
test: list=5,12,3,8,20 budget=20
expect: => i=16 r=0.0 ok=true s="budget sum: 16" errors=0 n=3 res=[3,5,8] cache=0 hits=0
test: list=15,4,9,2,30 budget=25
expect: => i=15 r=0.0 ok=true s="budget sum: 15" errors=0 n=3 res=[2,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	for i in 1..g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	var count = 0;
	var sum = 0;
	while count < g.n && sum + g.res[count] <= b {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "budget sum: ", sum);
	out
}
@end
