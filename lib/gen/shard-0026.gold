code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = ${count};
	if c > g.n { c = g.n; }
	let offset = (g.n - c) / 2;
	for k in c {
		g.res[k] = g.res[offset + k];
	}
	g.steps += c;
	g.n = c;
	out.i = c;
	out.s.clear();
	format(out.s, "retained middle ", c, " items");
	out
}
