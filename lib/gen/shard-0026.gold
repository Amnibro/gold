slot: limit int
test: list=10,20,30,40,50 limit=3
expect: => i=3 r=0.0 ok=true s="middle returned: 3" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=1,2 limit=3
expect: => i=2 r=0.0 ok=true s="middle returned: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 { out.ok = false; return out; }
	let take = if g.n < lim { g.n } else { lim };
	let start = (g.n - take) / 2;
	for k in take { g.res[k] = g.res[start + k]; }
	g.n = take;
	out.i = take;
	out.s.clear();
	format(out.s, "middle returned: ", take);
	out
}
@end
