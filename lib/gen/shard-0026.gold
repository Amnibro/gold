phrase: filter memo while limit under {ceiling}
slot: ceiling int
test: list=8,2,6,4,10 ceiling=7
expect: => i=3 r=0.0 ok=true s="memo entries selected: 3" errors=0 n=5 res=[2,4,6,8,10] cache=3 hits=0
test: list=15,3,9,12 ceiling=10
expect: => i=2 r=0.0 ok=true s="memo entries selected: 2" errors=0 n=4 res=[3,9,12,15] cache=2 hits=0
code:
// sort step select memo while
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var count = 0;
	var i = 0;
	while i < g.n && g.res[i] < ceil {
		gold_cache_put(g, i, g.res[i]);
		count++;
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "memo entries selected: ", count);
	out
}
@end
@entry 9b0ea8b4787678ed
kind: step
verb: check
noun: step
modifier: each
context: sort
phrase: check step each sorted increment {stride}
phrase: verify step each sorted distance {stride}
slot: stride int
test: list=2,4,6,8 stride=2
expect: => i=1 r=0.0 ok=true s="stride matched" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,6,9 stride=2
expect: => i=0 r=0.0 ok=false s="stride mismatch" errors=0 n=4 res=[1,3,6,9] cache=0 hits=0
code:
// sort step check step each
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var diffs_match = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] - g.res[i] != st {
				diffs_match = false;
				break;
			}
		}
	}
	out.ok = diffs_match;
	out.i = if diffs_match { 1 } else { 0 };
	out.s.clear();
	if diffs_match {
		format(out.s, "stride matched");
	} else {
		format(out.s, "stride mismatch");
	}
	out
}
@end
