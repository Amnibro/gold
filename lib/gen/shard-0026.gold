@entry e239a5d727e844c1
kind: step
verb: keep
noun: number
modifier: running
context: loop
phrase: keep number running total bounded by {cap}
phrase: maintain running number sum under {cap}
slot: cap int
test: list=5,10,15,20 cap=20
expect: => i=15 r=0.0 ok=true s="running sum: 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,4,6,8 cap=15
expect: => i=12 r=0.0 ok=true s="running sum: 12" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if sum + g.res[i] <= limit {
			sum += g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	out.i = sum;
	out.s.clear();
	format(out.s, "running sum: ", sum);
	out
}
@end
@entry 2cd23cc2ccfab779
kind: step
verb: swap
noun: history
modifier: until
context: loop
phrase: swap history pairs until condition {p}
phrase: permute history elements until predicate {p}
slot: p pred
test: list=4,7,2,9,6,8 p=is_odd
expect: => i=3 r=0.0 ok=true s="swapped history count: 3" errors=0 n=6 res=[7,4,9,2,8,6] cache=0 hits=0
test: list=6,8,10,3,5 p=is_odd
expect: => i=2 r=0.0 ok=true s="swapped history count: 2" errors=0 n=5 res=[8,6,3,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${p}(g.res[i]) { break; }
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped history count: ", swaps);
	out
}
@end
@entry a70a9a64351fd385
kind: step
verb: check
noun: steps
modifier: each
context: loop
phrase: check steps delta for each entry against {target}
phrase: verify each step increment matches target {target}
slot: target int
test: list=2,5,8,11 target=3
expect: => i=1 r=0.0 ok=true s="steps check: 1" errors=0 n=4 res=[2,5,8,11] cache=0 hits=0
test: list=2,5,9,12 target=3
expect: => i=0 r=0.0 ok=false s="steps check: 0" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var valid = true;
	if g.n < 2 { valid = false; }
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] != tgt {
			valid = false;
			break;
		}
		i++;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "steps check: ", out.i);
	out
}
@end
