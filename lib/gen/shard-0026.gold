phrase: expand results with average until reaching {target_len}
slot: target_len int
test: list=10,20 target_len=4
expect: => i=2 r=0.0 ok=true s="filled average until target: 2" errors=0 n=4 res=[10,20,15,15] cache=0 hits=0
test: list=6,12,18 target_len=5
expect: => i=2 r=0.0 ok=true s="filled average until target: 2" errors=0 n=5 res=[6,12,18,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var added = 0;
	while g.n < target && g.n < 512 {
		gold_push(g, avg);
		added++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "filled average until target: ", added);
	out
}
@end
@entry b367d1869a6733e3
kind: step
verb: run
noun: suffix
modifier: nested
context: transform
phrase: run suffix nested over transform items bounded {depth}
phrase: evaluate nested suffix transformations with depth {depth}
slot: depth int
test: list=1,2,3,4,5 depth=2
expect: => i=2 r=0.0 ok=true s="run suffix nested count: 2" errors=0 n=5 res=[1,2,3,7,8] cache=0 hits=0
test: list=10,20,30 depth=1
expect: => i=1 r=0.0 ok=true s="run suffix nested count: 1" errors=0 n=3 res=[10,20,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var start = g.n - d;
	if start < 0 { start = 0; }
	var i = start;
	while i < g.n {
		for pass in d {
			g.res[i] = g.res[i] + pass + 1;
		}
		i++;
	}
	g.steps += (g.n - start) * d;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "run suffix nested count: ", out.i);
	out
}
@end
