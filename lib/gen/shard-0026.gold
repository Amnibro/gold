expect: => i=1 r=0.0 ok=true s="reversed range with 1 swaps" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30,40 start_pos=0 end_pos=2
expect: => i=1 r=0.0 ok=true s="reversed range with 1 swaps" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = ${start_pos};
	var j = ${end_pos};
	if i < 0 { i = 0; }
	if j >= g.n { j = g.n - 1; }
	var swaps = 0;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
		swaps++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "reversed range with ", swaps, " swaps");
	out
}
@end
