@entry f3a703397a3ef662
kind: step
verb: dedupe
noun: evens
modifier: each
context: retry
phrase: dedupe evens each pass with retry bound {retries}
phrase: remove duplicate even values with retry allowance {retries}
slot: retries int
test: list=2,4,2,6,4,8 retries=3
expect: => i=2 r=0.0 ok=true s="evens deduplicated" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,5,7 retries=2
expect: => i=1 r=0.0 ok=true s="evens deduplicated" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var pass = 0;
	var changed = true;
	while pass < max_r && changed {
		changed = false;
		var seen = [0; 256];
		var sn = 0;
		var w = 0;
		for r in g.n {
			let x = g.res[r];
			if x % 2 == 0 {
				var found = false;
				for s in sn {
					if seen[s] == x { found = true; break; }
				}
				if found {
					changed = true;
				} else {
					seen[sn] = x;
					sn++;
					g.res[w] = x;
					w++;
				}
			} else {
				g.res[w] = x;
				w++;
			}
		}
		g.n = w;
		pass++;
	}
	g.steps += pass;
	out.i = pass;
	out.s.clear();
	format(out.s, "evens deduplicated");
	out
}
@end
