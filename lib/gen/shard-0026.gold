@entry e467f34683878343
kind: step
verb: cache
noun: duplicates
modifier: recursively
context: transform
phrase: cache duplicates recursively with depth {depth}
phrase: store duplicate counts recursively depth {depth}
slot: depth int
test: list=1,2,2,3,3,3 depth=2
expect: => i=6 r=0.0 ok=true s="cached duplicates count: 6" errors=0 n=6 res=[1,2,2,3,3,3] cache=2 hits=0
test: list=5,5,6,7 depth=1
expect: => i=1 r=0.0 ok=true s="cached duplicates count: 1" errors=0 n=4 res=[5,5,6,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var total_dups = 0;
	for pass in d {
		var dups = 0;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] == g.res[i+1] { dups++; }
			i++;
		}
		gold_cache_put(g, pass, dups);
		total_dups += dups;
	}
	g.steps += d * g.n;
	out.i = total_dups;
	out.s.clear();
	format(out.s, "cached duplicates count: ", total_dups);
	out
}
@end
@entry c63410afa7855338
