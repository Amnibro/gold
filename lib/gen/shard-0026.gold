fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_keep_loop_first_alpha = 0;
	let c = ${cutoff};
	if c < 0 { gold_fail(g, "negative cutoff"); out.ok = false; return out; }
	var kept = 0;
	var idx = 0;
	while idx < g.n {
		if g.res[idx] >= c {
			g.res[kept] = g.res[idx];
			kept++;
		}
		idx++;
	}
	g.n = kept;
	out.i = kept + mark_keep_loop_first_alpha;
	out.s.clear();
	format(out.s, "keploop: ", kept);
	out
}
@end
