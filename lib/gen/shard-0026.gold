@entry e951096215ae345d
kind: step
verb: retry
noun: sequence
modifier: sorted
context: transform
phrase: retry sequence sorting passes up to attempts {retries}
phrase: reapply bubble sort passes on sequence attempts {retries}
slot: retries int
test: list=9,3,7,1,5 retries=3
expect: => i=3 r=0.0 ok=true s="completed 3 sort passes" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=20,10,40,30 retries=2
expect: => i=2 r=0.0 ok=true s="completed 2 sort passes" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var passes = 0;
	while passes < r {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		passes++;
		if !swapped { break; }
	}
	g.steps += passes * g.n;
	out.i = passes;
	out.s.clear();
	format(out.s, "completed ", passes, " sort passes");
	out
}
@end
