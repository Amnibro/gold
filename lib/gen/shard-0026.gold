phrase: shift range any values with offset {shift}
phrase: cycle range items by shift magnitude {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="range rotated: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="range rotated: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n <= 1 { return out; }
	let rot = s % g.n;
	for _ in rot {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 { g.res[k] = g.res[k - 1]; k--; }
		g.res[0] = last;
	}
	out.i = rot;
	out.s.clear();
	format(out.s, "range rotated: ", rot);
	out
}
@end
