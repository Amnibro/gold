fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	let transformed = ${f}(last_val);
	var exceeding = 0;
	for i in g.n {
		if g.res[i] > transformed {
			exceeding++;
		}
	}
	g.steps += g.n;
	out.i = exceeding;
	out.s.clear();
	format(out.s, "compared function to last: ", exceeding);
	out
}
@end
