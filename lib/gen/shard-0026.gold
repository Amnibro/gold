expect: => img: 32x32 min=0 max=1 sum8=130816 hash=398080
test: n=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.ih < 2 { gold_fail(g, "texture too short"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (y as real) / ((g.ih - 1) as real);
		}
	}
	if ${n} < 2 || ${n} > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t_1 = (g.img[k] * (${n} as real)) as! int;
		if t_1 > ${n} - 1 { t_1 = ${n} - 1; }
		g.img[k] = (t_1 as real) / ((${n} - 1) as real);
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.2 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
