@entry 3c0be5edfbc23d69
kind: fn
verb: shift
noun: pairs
modifier: with_retry
context: error
phrase: shift error pairs with retry window
phrase: rotate error code pairs with retry
test: arg=1234,5678
expect: 2143
expect: 6587
test: arg=42
expect: 24
code:
fn ${ID}(n int) int {
	var code = if n < 0 { -n } else { n };
	var result = 0;
	var factor = 1;
	while code >= 10 {
		let d1 = code % 10;
		let d2 = (code / 10) % 10;
		result += (d2 + d1 * 10) * factor;
		factor *= 100;
		code /= 100;
	}
	result += code * factor;
	result
}
@end
