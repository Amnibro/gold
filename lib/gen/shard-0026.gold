fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { unique_count++; }
	}
	g.steps += g.n * g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "grouped ", unique_count, " unique items");
	out
}
