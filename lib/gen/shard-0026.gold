expect: => i=1 r=0.0 ok=true s="range filtered: 1" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for j in kn {
		gold_push(g, kept[j]);
	}
	g.steps += g.n + kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "range filtered: ", kn);
	out
}
@end
