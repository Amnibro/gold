@entry 33ce0b69244b1dbf
kind: step
verb: reverse
noun: total
modifier: with_retry
context: transform
phrase: reverse sequence when sum exceeds {bound} retries {retries}
phrase: invert sequence when sum reaches threshold {bound} attempts {retries}
slot: bound int
slot: retries int
test: list=10,20,30 bound=50 retries=2
expect: => i=60 r=0.0 ok=true s="reversed with sum: 60" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test: list=5,10,15 bound=40 retries=1
expect: => i=30 r=0.0 ok=true s="preserved with sum: 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let r = ${retries};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var reversed = false;
	if sum >= b {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		reversed = true;
	}
	g.steps += g.n * (r + 1);
	out.i = sum;
	out.s.clear();
	if reversed {
		format(out.s, "reversed with sum: ", sum);
	} else {
		format(out.s, "preserved with sum: ", sum);
	}
	out
}
@end
