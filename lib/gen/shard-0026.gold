@entry f443e8af50be9111
kind: step
verb: find
noun: series
modifier: with_retry
context: core
phrase: find series with retry target {target} attempts {retries}
phrase: search series with retry value {target} budget {retries}
slot: target int
slot: retries int
test: list=10,20,30,40 target=30 retries=3
expect: => i=2 r=0.0 ok=true s="found at index: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 target=99 retries=2
expect: => i=-1 r=0.0 ok=true s="not found" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	var found_idx = -1;
	var tries = 0;
	while tries < r && found_idx < 0 {
		for i in g.n {
			if g.res[i] == tgt {
				found_idx = i;
				break;
			}
		}
		tries++;
	}
	g.steps += tries;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found at index: ", found_idx);
	} else {
		format(out.s, "not found");
	}
	out
}
@end
