fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var found = false;
		if x == 0 && tgt == 0 { found = true; }
		while x > 0 {
			if x % 10 == tgt { found = true; break; }
			x /= 10;
		}
		if found { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "found digits: ", count);
	out
}
@end
