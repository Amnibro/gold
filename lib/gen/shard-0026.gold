	var max_val = 0;
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var peak_occ = 0;
	for i in g.n {
		var occ = 0;
		for j in (i + 1) {
			if g.res[j] == g.res[i] { occ++; }
		}
		if occ > peak_occ { peak_occ = occ; }
	}
	g.steps += g.n + mark_transform_compare_histogram_running;
	out.i = peak_occ;
	out.s.clear();
	format(out.s, "peak frequency ", peak_occ);
