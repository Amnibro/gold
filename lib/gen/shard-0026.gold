code:
// sort step keep memo running
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${capacity};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var stored = 0;
	var i = 0;
	while i < g.n && stored < cap {
		gold_cache_put(g, g.res[i], stored + 1);
		stored++;
		i++;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cached items: ", g.cn);
	out
}
@end
