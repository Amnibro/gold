modifier: in_reverse
context: core
phrase: apply cache in reverse with multiplier {multiplier}
phrase: cache reverse sequence entries with multiplier {multiplier}
slot: multiplier int
test: list=3,6,9 multiplier=2
expect: => i=3 r=0.0 ok=true s="cache filled in reverse" errors=0 n=3 res=[3,6,9] cache=3 hits=0
test: list=4,8 multiplier=3
expect: => i=2 r=0.0 ok=true s="cache filled in reverse" errors=0 n=2 res=[4,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${multiplier};
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		gold_cache_put(g, x, x * mul);
		k--;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cache filled in reverse");
	out
}
@end
@entry 8d0fb0401080167a
kind: step
verb: sum
noun: duplicates
modifier: while
context: core
phrase: sum duplicates while count remains below {limit}
phrase: merge duplicate entries while count below {limit}
slot: limit int
test: list=4,4,5,5,5 limit=4
expect: => i=2 r=0.0 ok=true s="duplicates merged" errors=0 n=3 res=[8,10,5] cache=0 hits=0
test: list=2,2,3,3 limit=2
expect: => i=2 r=0.0 ok=true s="duplicates merged" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var temp = [0; 512];
	var tn = 0;
	var k = 0;
	var merged = 0;
	while k < g.n {
		let x = g.res[k];
		if k + 1 < g.n && g.res[k + 1] == x && merged < lim {
			temp[tn] = x + x;
			tn++;
			k += 2;
			merged++;
		} else {
			temp[tn] = x;
			tn++;
			k++;
		}
	}
	for i in tn { g.res[i] = temp[i]; }
	g.n = tn;
	out.i = merged;
	out.s.clear();
	format(out.s, "duplicates merged");
	out
}
@end
@entry 90409361d872a386
kind: step
verb: split
noun: histogram
modifier: pairwise
context: core
phrase: split histogram pairwise with bucket size {bucket}
phrase: group pairwise differences by bucket size {bucket}
slot: bucket int
test: list=10,12,25,30 bucket=5
expect: => i=3 r=0.0 ok=true s="pairwise differences grouped" errors=0 n=3 res=[0,2,1] cache=0 hits=0
test: list=2,5,9 bucket=2
expect: => i=2 r=0.0 ok=true s="pairwise differences grouped" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket};
	if b <= 0 || g.n < 2 {
		gold_fail(g, "invalid bucket or short list");
		out.ok = false;
		return out;
	}
	var temp = [0; 512];
	var tn = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		temp[tn] = diff / b;
		tn++;
	}
	for i in tn { g.res[i] = temp[i]; }
	g.n = tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "pairwise differences grouped");
	out
}
@end
