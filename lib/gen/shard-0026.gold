test: r=0.022 d=0.04 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="drill_bracket" errors=0 n=0 res=[] cache=0 hits=0
