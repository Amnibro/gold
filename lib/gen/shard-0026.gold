test: list=10,25,45,70
expect: => i=1 r=0.0 ok=true s="deltas accelerating" errors=0 n=4 res=[10,25,45,70] cache=0 hits=0
test: list=5,15,30
expect: => i=1 r=0.0 ok=true s="deltas accelerating" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { out.i = 1; return out; }
	var strictly_inc = true;
	for i in (g.n - 2) {
		let d1 = g.res[i + 1] - g.res[i];
		let d2 = g.res[i + 2] - g.res[i + 1];
		if d2 <= d1 { strictly_inc = false; break; }
	}
	g.steps += g.n;
	out.i = if strictly_inc { 1 } else { 0 };
	out.s.clear();
	if strictly_inc {
		format(out.s, "deltas accelerating");
	} else {
		format(out.s, "deltas steady");
	}
	out
}
@end
