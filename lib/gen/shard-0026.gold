@entry df4a0214ff2e0ad8
kind: step
verb: validate
noun: suffix
modifier: recursively
context: format
phrase: validate suffix recursively matching {suf}
phrase: check suffix recursively ends with {suf}
slot: suf text
test: text="archive.tar.gz" suf="gz"
expect: => i=0 r=0.0 ok=true s="suffix valid" errors=0 n=0 res=[] cache=0 hits=0
test: text="doc.txt" suf="pdf"
expect: => i=0 r=0.0 ok=false s="suffix invalid" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${suf};
	let slen = target.len;
	out.ok = false;
	if out.s.len >= slen {
		var matched = true;
		var i = 0;
		while i < slen {
			if out.s[out.s.len - slen + i] != target[i] { matched = false; }
			i++;
		}
		out.ok = matched;
	}
	out.s.clear();
	format(out.s, if out.ok { "suffix valid" } else { "suffix invalid" });
	out
}
@end
@entry 17854c87a308ca12
kind: step
verb: repeat
noun: streak
modifier: in_place
context: format
phrase: repeat maximal streak in place {mult}
phrase: expand longest run streak by factor {mult}
slot: mult int
test: text="aaabbc" mult=2
expect: => i=6 r=0.0 ok=true s="aaaaaa" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxyyyz" mult=3
expect: => i=9 r=0.0 ok=true s="yyyyyyyyy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	if out.s.len == 0 { return out; }
	var best_ch = out.s[0];
	var best_len = 1;
	var cur_ch = out.s[0];
	var cur_len = 1;
	var i = 1;
	while i < out.s.len {
		if out.s[i] == cur_ch {
			cur_len++;
		} else {
			if cur_len > best_len { best_len = cur_len; best_ch = cur_ch; }
			cur_ch = out.s[i]; cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len { best_len = cur_len; best_ch = cur_ch; }
	out.s.clear();
	var k = 0;
	while k < best_len * m {
		out.s.push(best_ch);
		k++;
	}
	out.i = best_len * m;
	out
}
@end
