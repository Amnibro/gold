	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if uniq[j] == x { seen = true; }
		}
		if !seen {
			uniq[un] = x;
			un++;
		}
	}
	for i in un { g.res[i] = uniq[i]; }
	g.n = un;
	g.steps += un + mark_transform_run_number_unique;
	out.i = un;
	out.s.clear();
	format(out.s, "retained ", un, " unique items");
	out
}
