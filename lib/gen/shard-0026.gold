code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span_len};
	if w <= 1 || g.n < w {
		return out;
	}
	var i = 0;
	while i + w <= g.n {
		var sum = 0;
		for k in w {
			sum += g.res[i + k];
		}
		g.res[i] = sum;
		i++;
	}
	g.n = i;
	g.steps += g.n * w;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied window all: ", g.n);
	out
}
@end
