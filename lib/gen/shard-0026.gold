fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dup_count++;
				break;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "found duplicates: ", dup_count);
	out
}
