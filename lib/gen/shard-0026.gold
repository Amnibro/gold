@entry 6830f52615a4ad78
kind: step
verb: drop
noun: streak
modifier: between
context: aggregate
phrase: drop streak between sizes {min_streak} through {max_streak}
phrase: discard streak between lengths {min_streak} to {max_streak}
slot: min_streak int
slot: max_streak int
test: list=1,1,2,3,3,3,4 min_streak=2 max_streak=3
expect: => i=2 r=0.0 ok=true s="surviving after streak drop: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=5,5,5,6 min_streak=1 max_streak=2
expect: => i=3 r=0.0 ok=true s="surviving after streak drop: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${min_streak};
	let max_s = ${max_streak};
	if g.n == 0 {
		return out;
	}
	var temp int[512] = [0; 512];
	var tc = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len < min_s || len > max_s {
			var k = i;
			while k < j {
				temp[tc] = g.res[k];
				tc++;
				k++;
			}
		}
		i = j;
	}
	for m in tc {
		g.res[m] = temp[m];
	}
	g.n = tc;
	g.steps += g.n;
	out.i = tc;
	out.s.clear();
	format(out.s, "surviving after streak drop: ", tc);
	out
}
@end
@entry 24d87f3edbc42148
kind: step
verb: drop
noun: maximum
modifier: while
context: aggregate
phrase: drop maximum while above threshold {cutoff_val}
phrase: prune maximum while exceeding floor {cutoff_val}
slot: cutoff_val int
test: list=10,50,20,40 cutoff_val=30
expect: => i=2 r=0.0 ok=true s="maximums dropped: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,8 cutoff_val=10
expect: => i=1 r=0.0 ok=true s="maximums dropped: 1" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_val = ${cutoff_val};
	var dropped = 0;
	while g.n > 0 {
		var max_idx = 0;
		var i = 1;
		while i < g.n {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
			i++;
		}
		if g.res[max_idx] > floor_val {
			var k = max_idx;
			while k + 1 < g.n {
				g.res[k] = g.res[k + 1];
				k++;
			}
			g.n--;
			dropped++;
		} else {
			break;
		}
	}
	g.steps += g.n + dropped;
	out.i = dropped;
