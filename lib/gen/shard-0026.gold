expect: => i=-1 r=0.0 ok=true s="reverse pos: -1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var pos = -1;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] == tgt { pos = k; break; }
		k--;
	}
	out.i = pos;
	out.s.clear();
	format(out.s, "reverse pos: ", pos);
	out
}
@end
