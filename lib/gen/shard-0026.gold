code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if fac == 0 {
		out.ok = false;
		return out;
	}
	var kept = 0;
	for k in g.n {
		if g.res[k] % fac == 0 {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " factor items");
	out
}
@end
@entry 9d7d7b3ced3b8013
kind: step
