	let key = ${loc_id};
	if g.n > 0 {
		gold_cache_put(g, key, g.res[0]);
		out.i = g.res[0];
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "cached value in place: ", out.i);
	out
}
@end
