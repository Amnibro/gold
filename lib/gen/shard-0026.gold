@entry 36d47992ba1a9967
kind: step
verb: limit
noun: streak
modifier: in_place
context: loop
phrase: limit streak {max_len} in place duplicate run
phrase: truncate streak {max_len} in place repeated run
slot: max_len int
test: list=1,1,1,1,2,2 max_len=2
expect: => i=4 r=0.0 ok=true s="compressed to 4 items" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,5,5,5 max_len=3
expect: => i=3 r=0.0 ok=true s="compressed to 3 items" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${max_len};
	if g.n <= max_run { return out; }
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			if run_len < max_run {
				g.res[write_idx] = val;
				write_idx++;
				run_len++;
			}
			i++;
		}
	}
	g.steps += g.n;
	g.n = write_idx;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "compressed to ", write_idx, " items");
	out
}
@end
