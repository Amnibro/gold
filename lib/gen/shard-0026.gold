	var swapped = true;
	while swapped {
		swapped = false;
		var j = 0;
		while j + 1 < on {
			if odds[j] > odds[j + 1] {
				let tmp = odds[j];
				odds[j] = odds[j + 1];
				odds[j + 1] = tmp;
				swapped = true;
			}
			j++;
		}
	}
	gold_clear(g);
	for rep in r {
		for k in on {
			gold_push(g, odds[k]);
		}
	}
	g.steps += on * r;
	out.i = on * r;
	out.s.clear();
	format(out.s, "odds repeated: ", out.i);
	out
}
@end
