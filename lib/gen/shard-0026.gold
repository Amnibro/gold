fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bnd = ${boundary};
	if bnd > g.n { bnd = g.n; }
	var i = 0;
	while i + 1 < bnd {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
		}
		i += 2;
	}
	gold_push(g, bnd);
	g.steps += bnd;
	out.i = bnd;
	out.s.clear();
	format(out.s, "pairs sorted up to: ", bnd);
	out
}
@end
