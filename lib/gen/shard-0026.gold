kind: step
verb: clamp
noun: histogram
modifier: unique
context: compare
phrase: clamp histogram unique frequencies to cap {cap}
phrase: bound unique histogram counts with cap {cap}
phrase: limit frequency of unique values under cap {cap}
slot: cap int
test: list=3,3,3,7,7,9 cap=2
expect: => i=5 r=0.0 ok=true s="unique histogram: 5" errors=0 n=5 res=[3,3,7,7,9] cache=0 hits=0
test: list=1,2,3,4 cap=2
expect: => i=4 r=0.0 ok=true s="unique histogram: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var seen = [0; 64];
	var counts = [0; 64];
	var u = 0;
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		var idx = -1;
		for s in u { if seen[s] == x { idx = s; break; } }
		if idx < 0 {
			if u < 64 { seen[u] = x; counts[u] = 1; u++; g.res[w] = x; w++; }
		} else {
			if counts[idx] < c { counts[idx]++; g.res[w] = x; w++; }
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "unique histogram: ", w);
	out
}
@end
