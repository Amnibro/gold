code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.i = 0; return out; }
	var sum = 0;
	for i in (g.n - 1) { sum += g.res[i]; }
	let avg = sum / (g.n - 1);
	let diff = g.res[g.n - 1] - avg;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "delta against mean ", diff);
	out
}
@end
