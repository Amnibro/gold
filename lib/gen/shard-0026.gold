test: list=4,18,6,12,8,2
expect: => i=3 r=0.0 ok=true s="sorted 3 odd elements" errors=0 n=6 res=[4,2,6,12,8,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var count = 0;
	var odd_vals int[256] = [0; 256];
	var i = 1;
	while i < g.n {
		odd_vals[count] = g.res[i];
		count++;
		i += 2;
	}
	for p in 1..count {
		let key = odd_vals[p];
		var q = p - 1;
		while q >= 0 && odd_vals[q] > key {
			odd_vals[q + 1] = odd_vals[q];
			q--;
		}
		odd_vals[q + 1] = key;
	}
	i = 1;
	for p in count {
		g.res[i] = odd_vals[p];
		i += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted ", count, " odd elements");
	out
}
@end
