expect: => i=0 r=0.0 ok=true s="suffix pruned: 0" errors=0 n=4 res=[10,8,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	var pruned = 0;
	while g.n > 1 && g.res[g.n - 1] > bnd && g.res[g.n - 1] == g.res[g.n - 2] {
		g.n--;
		pruned++;
	}
	g.steps += pruned + 1;
	out.i = pruned;
	out.s.clear();
	format(out.s, "suffix pruned: ", pruned);
	out
}
@end
