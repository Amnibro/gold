test: list=2,4,6 expected=10
expect: => i=4 r=0.0 ok=false s="computed average: 4" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
// sort step check average safely
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	out.ok = (avg == exp);
	out.i = avg;
	out.s.clear();
	format(out.s, "computed average: ", avg);
	out
}
@end
