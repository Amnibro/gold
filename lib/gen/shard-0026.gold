@entry c9098e81329a4c83
kind: step
verb: dedupe
noun: tail
modifier: while
context: format
phrase: dedupe tail items while above limit {lim}
phrase: unique trailing elements while greater than {lim}
slot: lim int
test: list=10,20,30,30,40 lim=25
expect: => i=2 r=0.0 ok=true s="40,30" errors=0 n=5 res=[10,20,30,30,40] cache=0 hits=0
test: list=5,15,15,25 lim=10
expect: => i=2 r=0.0 ok=true s="25,15" errors=0 n=4 res=[5,15,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_limit = ${lim};
	var seen int[256] = [0; 256];
	var sn = 0;
	out.s.clear();
	var i = g.n - 1;
	while i >= 0 && g.res[i] > floor_limit {
		let val = g.res[i];
		var found = false;
		var k = 0;
		while k < sn {
			if seen[k] == val { found = true; }
			k++;
		}
		if !found {
			seen[sn] = val; sn++;
			if out.s.len > 0 { out.s.push(','); }
			format(out.s, val);
		}
		i--;
	}
	out.i = sn;
	out
}
@end
