noun: average
modifier: running
context: list
phrase: shift average running deviation in list
phrase: adjust elements by running average offset
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="shifted running average: 4" errors=0 n=4 res=[0,5,10,15] cache=0 hits=0
test: list=4,8,12,16
expect: => i=4 r=0.0 ok=true s="shifted running average: 4" errors=0 n=4 res=[0,2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_sum = 0;
	for i in g.n {
		run_sum += g.res[i];
		let avg = run_sum / (i + 1);
		g.res[i] -= avg;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted running average: ", g.n);
	out
}
@end
