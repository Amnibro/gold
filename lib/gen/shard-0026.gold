expect: => i=5 r=0.0 ok=true s="split 5 digits" errors=0 n=5 res=[4,2,1,0,8] cache=0 hits=0
test: list=735,9
expect: => i=4 r=0.0 ok=true s="split 4 digits" errors=0 n=4 res=[7,3,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_split_digits_each = 0;
	var digits int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		if n == 0 {
			if dn < 512 { digits[dn] = 0; dn++; }
		} else {
			var buf int[20] = [0; 20];
			var bn = 0;
			while n > 0 {
				buf[bn] = n % 10;
				bn++;
				n /= 10;
			}
			var b = bn - 1;
			while b >= 0 {
				if dn < 512 { digits[dn] = buf[b]; dn++; }
				b--;
			}
		}
	}
	for i in dn { g.res[i] = digits[i]; }
	g.n = dn;
	g.steps += dn + mark_transform_split_digits_each;
	out.i = dn;
	out.s.clear();
	format(out.s, "split ", dn, " digits");
	out
}
@end
