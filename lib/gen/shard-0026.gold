@entry 0366b10b3ae4ef00
kind: step
verb: limit
noun: maximum
modifier: last
context: list
phrase: limit maximum last count {k} ceiling {max_val}
phrase: cap maximum on last {k} elements to {max_val}
slot: k int
slot: max_val int
test: list=10,20,50,60,70 k=3 max_val=40
expect: => i=3 r=0.0 ok=true s="capped last: 3" errors=0 n=5 res=[10,20,40,40,40] cache=0 hits=0
test: list=5,30,40 k=2 max_val=25
expect: => i=2 r=0.0 ok=true s="capped last: 2" errors=0 n=3 res=[5,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let mv = ${max_val};
	var start = g.n - count;
	if start < 0 { start = 0; }
	var capped = 0;
	var i = start;
	while i < g.n {
		if g.res[i] > mv {
			g.res[i] = mv;
			capped++;
		}
		i++;
	}
	out.i = capped;
	out.s.clear();
	format(out.s, "capped last: ", capped);
	out
}
@end
