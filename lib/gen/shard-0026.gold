code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var kept = 0;
	var merged = 0;
	var tmp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			sum += x;
			merged++;
		} else {
			tmp[kept] = x;
			kept++;
		}
	}
	tmp[kept] = sum;
	kept++;
	for i in kept {
		g.res[i] = tmp[i];
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged ", merged, " items into sum: ", sum);
	out
}
@end
