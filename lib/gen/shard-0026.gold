noun: memo
modifier: sorted
context: aggregate
phrase: split memo sorted items at {split_pt}
phrase: divide memo sorted sequence around {split_pt}
slot: split_pt int
test: list=30,10,20 split_pt=15
expect: => i=1 r=0.0 ok=true s="sorted below pivot count: 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,40,10,20 split_pt=25
expect: => i=2 r=0.0 ok=true s="sorted below pivot count: 2" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pivot = ${split_pt};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var below = 0;
	for k in g.n {
		if g.res[k] <= pivot {
			below++;
		}
	}
	g.steps += g.n * g.n;
	out.i = below;
	out.s.clear();
	format(out.s, "sorted below pivot count: ", below);
	out
}
@end
