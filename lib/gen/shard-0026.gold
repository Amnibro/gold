	gold_clear(g);
	var i = 0;
	while i + 1 < old_n && i + 1 < 64 {
		let diff = pref[i + 1] - pref[i];
		gold_push(g, ${f}(diff));
		i += 2;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped prefix pairwise: ", g.n);
