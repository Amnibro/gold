fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var sum = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if sum + x <= b {
			sum += x;
			count++;
			gold_cache_put(g, count, sum);
		} else {
