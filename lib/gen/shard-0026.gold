kind: step
verb: limit
noun: head
modifier: last
context: list
phrase: limit head last spans {h_count} plus {t_count}
phrase: extract head {h_count} with tail {t_count} segments
slot: h_count int
slot: t_count int
test: list=1,2,3,4,5,6,7 h_count=2 t_count=2
expect: => i=4 r=0.0 ok=true s="head tail kept: 4" errors=0 n=4 res=[1,2,6,7] cache=0 hits=0
