code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements to measure");
		out.ok = false;
		return out;
	}
	var max_val = -999999;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			if !found || x > max_val {
				max_val = x;
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no matching element found");
		out.ok = false;
		return out;
	}
	g.res[0] = max_val;
	g.n = 1;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "measured maximum: ", max_val);
	out
}
@end
