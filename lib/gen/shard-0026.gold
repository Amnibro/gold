fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var loop_len = 0;
	if g.n >= 4 {
		let half = g.n / 2;
		var matches = true;
		for k in half {
			if g.res[k] != g.res[k + half] {
				matches = false;
				break;
			}
		}
		if matches {
			loop_len = half;
		}
	}
	var pass = 0;
	while pass < max_r && loop_len == 0 {
		loop_len = 1;
		pass++;
	}
	gold_push(g, loop_len);
	g.steps += pass + 1;
	out.i = loop_len;
	out.s.clear();
	format(out.s, "loop cycle searched");
	out
}
@end
