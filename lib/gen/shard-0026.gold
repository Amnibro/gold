slot: win_size int
test: list=1,2,1,3,4,3 win_size=3
expect: => i=2 r=0.0 ok=true s="window deduped: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,7,8 win_size=3
expect: => i=0 r=0.0 ok=true s="window deduped: 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	if ws <= 0 { return out; }
	var w = 0;
	for r in g.n {
		let x = g.res[r];
		var dup = false;
		let start = if w > ws { w - ws } else { 0 };
		for k in start..w {
			if g.res[k] == x { dup = true; break; }
		}
		if !dup { g.res[w] = x; w++; }
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.s.clear();
	format(out.s, "window deduped: ", removed);
	out
}
@end
