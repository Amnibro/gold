noun: average
modifier: sorted
context: loop
phrase: measure average value after sorting sequence numbers
phrase: compute sorted sequence mean across loop elements
test: list=40,10,30,20
expect: => i=25 r=0.0 ok=true s="sorted average: 25" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25,35,45
expect: => i=25 r=0.0 ok=true s="sorted average: 25" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		var j = i;
		while j > 0 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = tmp;
			j--;
		}
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "sorted average: ", avg);
	out
}
@end
@entry e25473d7292352b4
kind: step
verb: swap
noun: streak
modifier: at_least
context: loop
phrase: swap bounds when duplicate streak reaches at least {min_streak}
phrase: exchange endpoints if consecutive run meets at least {min_streak}
slot: min_streak int
test: list=5,5,5,10,20 min_streak=3
expect: => i=1 r=0.0 ok=true s="streaks swapped: 1" errors=0 n=5 res=[5,5,5,10,20] cache=0 hits=0
test: list=2,2,4,4,4 min_streak=2
expect: => i=2 r=0.0 ok=true s="streaks swapped: 2" errors=0 n=5 res=[2,2,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_streak};
	var streaks = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= min_len {
			streaks++;
			if i > 0 && j < g.n {
				let tmp = g.res[i - 1];
				g.res[i - 1] = g.res[j];
				g.res[j] = tmp;
			}
		}
		i = j;
	}
	out.i = streaks;
	out.s.clear();
	format(out.s, "streaks swapped: ", streaks);
	out
}
@end
@entry 86d115a8a5e74549
kind: step
verb: measure
noun: range
modifier: until
context: loop
phrase: measure range span of elements until sum exceeds {target}
phrase: calculate interval spread until accumulated value reaches {target}
slot: target int
test: list=10,30,5,40,20 target=40
expect: => i=20 r=0.0 ok=true s="measured range spread: 20" errors=0 n=5 res=[10,30,5,40,20] cache=0 hits=0
test: list=8,12,25,35 target=20
expect: => i=4 r=0.0 ok=true s="measured range spread: 4" errors=0 n=4 res=[8,12,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 { out.i = 0; return out; }
	var sum = 0;
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		sum += g.res[i];
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
		if sum >= tgt { break; }
	}
	let spread = max_val - min_val;
	out.i = spread;
	out.s.clear();
	format(out.s, "measured range spread: ", spread);
	out
}
@end
