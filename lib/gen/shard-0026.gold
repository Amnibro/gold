@entry b26dc327bc688c9a
kind: step
verb: select
noun: condition
modifier: sorted
context: transform
phrase: select elements meeting condition sorted ascending {cond}
phrase: filter items satisfying condition sorted in order {cond}
slot: cond pred
test: list=12,5,8,3,10 cond=is_even
expect: => i=3 r=0.0 ok=true s="selected 3 items sorted" errors=0 n=3 res=[8,10,12] cache=0 hits=0
test: list=9,2,7,4,1 cond=is_odd
expect: => i=3 r=0.0 ok=true s="selected 3 items sorted" errors=0 n=3 res=[1,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no elements to select");
		out.ok = false;
		return out;
	}
	var count = 0;
	var tmp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			tmp[count] = x;
			count++;
		}
	}
	for i in 1..count {
		let key = tmp[i];
		var j = i - 1;
		while j >= 0 && tmp[j] > key {
			tmp[j + 1] = tmp[j];
			j--;
		}
		tmp[j + 1] = key;
	}
	for i in count {
		g.res[i] = tmp[i];
	}
	g.steps += g.n + count;
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " items sorted");
	out
}
@end
