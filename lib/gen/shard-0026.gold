@entry 0bea638d1541fa3e
kind: step
verb: keep
noun: runs
modifier: times
context: sort
phrase: keep runs times minimum repetition {times}
phrase: preserve runs times streak length {times}
slot: times int
test: list=1,1,2,3,3,3,4 times=2
expect: => i=5 r=0.0 ok=true s="kept run elements: 5" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=5,5,5,6,7,7 times=3
expect: => i=3 r=0.0 ok=true s="kept run elements: 3" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
// sort step keep runs times
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${times};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= req {
			var k = i;
			while k < j {
				kept[kn] = g.res[k];
				kn++;
				k++;
			}
		}
		i = j;
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "kept run elements: ", kn);
	out
}
@end
@entry 46986d3c94350b91
kind: step
verb: measure
noun: tail
modifier: pairwise
context: sort
phrase: measure tail pairwise sorted span {span}
phrase: calculate tail pairwise sorted window {span}
slot: span int
test: list=1,8,2,7,3,6 span=3
expect: => i=2 r=0.0 ok=true s="tail pairwise sum: 2" errors=0 n=6 res=[1,2,3,6,7,8] cache=0 hits=0
test: list=5,2,9,4 span=2
expect: => i=4 r=0.0 ok=true s="tail pairwise sum: 4" errors=0 n=4 res=[2,4,5,9] cache=0 hits=0
code:
// sort step measure tail pairwise
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var diff_sum = 0;
	var start = g.n - sp;
	if start < 0 { start = 0; }
	var k = start;
	while k + 1 < g.n {
		diff_sum += g.res[k + 1] - g.res[k];
		k++;
	}
	g.steps += g.n - start;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "tail pairwise sum: ", diff_sum);
	out
}
@end
@entry d964c1bf3daa4d53
kind: step
verb: scan
noun: runs
modifier: until
context: sort
phrase: scan runs until length exceeds {target}
phrase: traverse runs until threshold size {target}
slot: target int
test: list=1,1,2,2,2,3 target=3
expect: => i=2 r=0.0 ok=true s="target run found: 2" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=4,5,5,6,6,6,6 target=4
expect: => i=6 r=0.0 ok=true s="target run found: 6" errors=0 n=7 res=[4,5,5,6,6,6,6] cache=0 hits=0
code:
// sort step scan runs until
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var matched_val = -1;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= tg {
			matched_val = g.res[i];
			break;
		}
		i = j;
	}
	g.steps += i + 1;
	out.i = matched_val;
	out.s.clear();
	if matched_val >= 0 {
		format(out.s, "target run found: ", matched_val);
	} else {
		format(out.s, "no target run found");
	}
	out
}
@end
