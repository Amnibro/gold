phrase: accumulate primes in reverse sequence
test: list=4,5,6,7,8,9,11
expect: => i=23 r=0.0 ok=true s="primes sum: 23 count: 3" errors=0 n=7 res=[4,5,6,7,8,9,11] cache=0 hits=0
test: list=2,3,4,13,15,17
expect: => i=35 r=0.0 ok=true s="primes sum: 35 count: 4" errors=0 n=6 res=[2,3,4,13,15,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var psum = 0;
	var pcount = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var is_p = x >= 2;
		if is_p {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			psum += x;
			pcount++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = psum;
	out.s.clear();
	format(out.s, "primes sum: ", psum, " count: ", pcount);
	out
}
@end
