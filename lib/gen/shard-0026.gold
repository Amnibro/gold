		var w = 0;
		for k in g.n {
			if k != min_idx {
				g.res[w] = g.res[k];
				w++;
			}
		}
		g.n = w;
		pass++;
	}
	g.steps += pass;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested minima filtered");
	out
}
