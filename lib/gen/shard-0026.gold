code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var score = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_prime = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_prime = false;
				break;
			}
			d++;
		}
		if is_prime {
			score += x + b;
		}
		i += 2;
	}
	gold_push(g, score);
	g.steps += g.n;
	out.i = score;
	out.s.clear();
	format(out.s, "prime score: ", score);
	out
}
@end
