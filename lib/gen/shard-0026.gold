@entry d4bc7ed77327ccef
kind: step
verb: validate
noun: odds
modifier: unique
context: compare
phrase: validate odds unique across sequence with limit {target}
phrase: verify unique odd elements under ceiling {target}
phrase: check odd values unique against boundary {target}
slot: target int
test: list=1,3,5,7,2 target=4
expect: => i=4 r=0.0 ok=true s="odds unique: 4" errors=0 n=5 res=[1,3,5,7,2] cache=0 hits=0
test: list=1,3,1,5 target=4
expect: => i=4 r=0.0 ok=false s="odds unique: 4" errors=0 n=4 res=[1,3,1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var odd_cnt = 0;
	var seen = [0; 64];
	var dup = false;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			for s in odd_cnt {
				if seen[s] == x { dup = true; break; }
			}
			if odd_cnt < 64 { seen[odd_cnt] = x; odd_cnt++; }
		}
	}
	if dup || odd_cnt > tgt { out.ok = false; }
	out.i = odd_cnt;
	out.s.clear();
	format(out.s, "odds unique: ", odd_cnt);
	out
}
@end
