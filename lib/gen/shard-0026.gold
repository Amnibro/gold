@entry c5afddd34afbef8a
kind: step
verb: reverse
noun: letters
modifier: unique
context: sort
phrase: reverse letters unique deduplicated order {limit}
phrase: invert letters unique distinct bound {limit}
slot: limit int
test: text="banana" limit=4
expect: => i=3 r=0.0 ok=true s="nba" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" limit=3
expect: => i=3 r=0.0 ok=true s="spm" errors=0 n=0 res=[] cache=0 hits=0
code:
// sort step reverse letters unique
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var chars = [0; 256];
	var cn = 0;
	for b in out.s {
		let c = b as int;
		var seen = false;
		for i in cn { if chars[i] == c { seen = true; break; } }
		if !seen {
			chars[cn] = c;
			cn++;
		}
	}
	if cn >= 2 {
		for i in cn - 1 {
			for j in cn - 1 - i {
				if chars[j] < chars[j + 1] {
					let tmp = chars[j];
					chars[j] = chars[j + 1];
					chars[j + 1] = tmp;
				}
			}
		}
	}
	out.s.clear();
	var k = 0;
	while k < cn && k < lim {
		out.s.push(chars[k] as byte);
		k++;
	}
	out.i = out.s.len;
	out
}
@end
