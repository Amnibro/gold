test: list=4,8,16 iterations=1
expect: => i=2 r=0.0 ok=true s="recursive max normalized: 2" errors=0 n=3 res=[2,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let iters = ${iterations};
	if g.n == 0 {
		return out;
	}
	var step = 0;
	while step < iters {
		var max_val = g.res[0];
		for i in g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
			}
		}
		if max_val > 1 {
			for i in g.n {
				g.res[i] = (g.res[i] * 10) / max_val;
			}
		}
		step++;
	}
	g.steps += g.n * iters;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "recursive max normalized: ", g.res[0]);
	out
}
@end
