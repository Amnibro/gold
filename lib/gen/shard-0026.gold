expect: => i=2 r=0.0 ok=true s="unique digits kept: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,2,3,4,5,5,6
expect: => i=6 r=0.0 ok=true s="unique digits kept: 6" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x < 10 {
			var exists = false;
			for j in kn {
				if kept[j] == x { exists = true; }
			}
			if !exists {
				kept[kn] = x;
				kn++;
			}
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "unique digits kept: ", kn);
	out
}
@end
