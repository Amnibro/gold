noun: pairs
modifier: at_most
context: search
phrase: repeat pairs at most count limit {limit}
phrase: duplicate adjacent search matches at most {limit}
slot: limit int
test: list=2,2,5,7 limit=1
expect: => i=1 r=0.0 ok=true s="pairs repeated: 1" errors=0 n=5 res=[2,2,2,5,7] cache=0 hits=0
test: list=3,3,4,4 limit=2
expect: => i=2 r=0.0 ok=true s="pairs repeated: 2" errors=0 n=6 res=[3,3,3,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dupes_added = 0;
	var out_arr = [0; 512];
	var on = 0;
	var i = 0;
	while i < g.n {
		out_arr[on] = g.res[i];
		on++;
		if i + 1 < g.n && g.res[i] == g.res[i + 1] && dupes_added < lim {
			out_arr[on] = g.res[i];
			on++;
			dupes_added++;
		}
		i++;
	}
	gold_clear(g);
	for k in on {
		gold_push(g, out_arr[k]);
	}
	g.steps += on;
	out.i = dupes_added;
	out.s.clear();
	format(out.s, "pairs repeated: ", dupes_added);
	out
}
@end
