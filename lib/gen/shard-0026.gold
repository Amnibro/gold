		if is_letter {
			var dup = false;
			for j in un {
				if g.res[j] == code { dup = true; break; }
			}
			if !dup {
				g.res[un] = code;
				un++;
			}
		}
	}
	g.n = un;
	out.i = un;
	out.s.clear();
	format(out.s, "unique letters kept: ", un);
	out
}
@end
