expect: => doc: bracket3 cyl 0,0,-0.04 0,0,0.04 r0.022 -
test: r=-0.005 d=0.03
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${r} <= 0.0 || ${d} <= 0.0 { gold_fail(g, "dimensions must be positive"); out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "bracket", "", o);
	o.append(" cyl ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",-");
	gold_fnum(o, ${d});
	o.append(" ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${d});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "drill_bracket");
	out
}
@end
