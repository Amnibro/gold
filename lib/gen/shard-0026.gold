fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	let start = g.n - count;
	var tail = [0; 64];
	for i in count {
		tail[i] = g.res[start + i];
	}
	gold_clear(g);
	for i in count {
		gold_push(g, tail[i]);
	}
	out.i = count;
	out.s.clear();
	format(out.s, "selected tail count: ", count);
	out
}
@end
