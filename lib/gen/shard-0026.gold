expect: => i=4 r=0.0 ok=true s="reversed streak len: 4" errors=0 n=5 res=[40,30,20,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${len};
	if slen <= 1 || slen > g.n { out.ok = false; return out; }
	var i = 0;
	var j = slen - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = slen;
	out.s.clear();
	format(out.s, "reversed streak len: ", slen);
	out
}
@end
