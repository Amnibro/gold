	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq >= min_k {
			if dn < 64 { dup_pos[dn] = i; dn++; }
		}
	}
	var l = 0;
	var r = dn - 1;
	while l < r {
		let p1 = dup_pos[l];
		let p2 = dup_pos[r];
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		l++;
		r--;
	}
	out.i = dn;
	out.s.clear();
	format(out.s, "reversed dups: ", dn);
	out
}
@end
