		if t_1 > ${n} - 1 { t_1 = ${n} - 1; }
		g.img[k] = (t_1 as real) / ((${n} - 1) as real);
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "fabric");
	out
}
@end
