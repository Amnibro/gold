// sort step measure pairs pairwise
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var total = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			total += (g.res[i + 1] - g.res[i]) * sc;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "scaled pairs sum: ", total);
	out
}
