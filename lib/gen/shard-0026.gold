@entry 45d07b7a69161faa
kind: step
verb: group
noun: checkpoint
modifier: times
context: core
phrase: group checkpoint times bucket size {size}
phrase: partition checkpoint times chunk width {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=3 r=0.0 ok=true s="grouped checkpoint chunks: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=2 r=0.0 ok=true s="grouped checkpoint chunks: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz > 0 && g.n > 0 {
		var chunks = [0; 512];
		var cn = 0;
		var cur_sum = 0;
		var count = 0;
		for i in g.n {
			cur_sum += g.res[i];
			count++;
			if count == sz {
				chunks[cn] = cur_sum;
				cn++;
				cur_sum = 0;
				count = 0;
			}
		}
		if count > 0 {
			chunks[cn] = cur_sum;
			cn++;
		}
		gold_clear(g);
		for k in cn { gold_push(g, chunks[k]); }
		out.i = cn;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "grouped checkpoint chunks: ", out.i);
	out
}
@end
