fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = [0; 64];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if ${p}(sum) {
			if count < 64 { kept[count] = g.res[i]; count++; }
			if count < 64 { kept[count] = g.res[i + 1]; count++; }
		}
		i += 2;
	}
	gold_clear(g);
	for k in count { gold_push(g, kept[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "selected pairwise count: ", count);
	out
}
@end
