code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let _ = ${stride};
	if g.n <= 1 { return out; }
	var w = 1;
	for r in 1..g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.s.clear();
	format(out.s, "streak deduped: ", removed);
	out
}
@end
@entry 70e0f26c1cb0ff6c
kind: step
verb: fold
noun: histogram
modifier: at_most
context: compare
phrase: fold histogram at most allowed frequency {ceiling}
phrase: compress histogram bins at most frequency {ceiling}
phrase: fold frequency counts at most ceiling {ceiling}
slot: ceiling int
test: list=4,4,8,8,8,12 ceiling=2
expect: => i=1 r=0.0 ok=true s="folded bins: 1" errors=0 n=6 res=[4,4,8,8,8,12] cache=0 hits=0
test: list=1,2,3,4 ceiling=2
expect: => i=0 r=0.0 ok=true s="folded bins: 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var folded = 0;
	var k = 0;
	while k < g.n {
		var run = 1;
		while k + run < g.n && g.res[k + run] == g.res[k] { run++; }
		if run > c { folded += run - c; }
		k += run;
	}
	out.i = folded;
	out.s.clear();
	format(out.s, "folded bins: ", folded);
	out
}
@end
