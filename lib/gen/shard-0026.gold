expect: => i=0 r=0.0 ok=true s="paired 0 gaps at most limit" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for gaps");
		return out;
	}
	var count = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let gap = if diff < 0 { -diff } else { diff };
		if gap <= mg { count++; }
	}
	g.steps += g.n - 1;
	out.i = count;
	out.s.clear();
	format(out.s, "paired ", count, " gaps at most limit");
	out
}
@end
