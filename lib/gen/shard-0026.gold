phrase: update evens with cache retrieval values
test: list=1,2,3,4,5
expect: => i=2 r=0.0 ok=true s="evens cached: 2" errors=0 n=5 res=[1,4,3,8,5] cache=2 hits=0
test: list=6,7,8,9,10
expect: => i=3 r=0.0 ok=true s="evens cached: 3" errors=0 n=5 res=[12,7,16,9,20] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var transformed = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			let cached, found = gold_cache_get(g, x);
			if found {
				g.res[i] = cached;
			} else {
				let doubled = x * 2;
				gold_cache_put(g, x, doubled);
				g.res[i] = doubled;
			}
			transformed++;
		}
	}
	out.i = transformed;
	out.s.clear();
	format(out.s, "evens cached: ", transformed);
	out
}
@end
