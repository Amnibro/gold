@entry ae67266cb8b92448
kind: step
verb: reverse
noun: subfunction
modifier: with_retry
context: stats
phrase: reverse subfunction sequence with retry total
phrase: invert subfunction sequence with retry sum
test: list=1,2,3,4,5
expect: => i=15 r=0.0 ok=true s="reversed with sum 15" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30
expect: => i=60 r=0.0 ok=true s="reversed with sum 60" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	var sum = 0;
	while i <= j {
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			sum += g.res[i] + g.res[j];
		} else {
			sum += g.res[i];
		}
		i++;
		j--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed with sum ", sum);
	out
}
@end
