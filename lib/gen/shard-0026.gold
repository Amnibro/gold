test: list=1,8,4,9
expect: => i=9 r=0.0 ok=true s="reverse max: 9" errors=0 n=4 res=[9,9,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { out.i = 0; return out; }
	var max_val = g.res[g.n - 1];
	var rev_max = [0; 512];
	var rn = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > max_val { max_val = g.res[i]; }
		rev_max[rn] = max_val;
		rn++;
		i--;
	}
	gold_clear(g);
	for j in rn { gold_push(g, rev_max[j]); }
	out.i = max_val;
	out.s.clear();
	format(out.s, "reverse max: ", max_val);
	out
}
@end
