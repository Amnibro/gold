code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var arr int[256] = [0; 256];
	var i = 0;
	while i < g.n { arr[i] = g.res[i]; i++; }
	var alt int[128] = [0; 128];
	var an = 0;
	var j = 0;
	while j < g.n { alt[an] = g.res[j]; an++; j += 2; }
	if an > 1 {
		var k = 0;
		while k < an {
			let nxt = (k + 1) % an;
			arr[k * 2] = alt[nxt];
			k++;
		}
	}
	out.s.clear();
	var m = 0;
	while m < g.n {
		if m > 0 { out.s.push(','); }
		format(out.s, arr[m]);
		m++;
	}
	out.i = an;
	out
}
@end
