fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let r = ${retries};
	var count = 0;
	var attempts = 0;
	while attempts <= r {
		count = 0;
		for i in g.n {
			if g.res[i] >= lim { count++; }
		}
		attempts++;
	}
	g.steps += g.n * attempts;
	out.i = count;
	out.s.clear();
	format(out.s, "measured limit: ", count);
	out
}
@end
