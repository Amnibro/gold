code:
// sort step check digits times
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fr = ${freq};
	var counts = [0; 10];
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		if x == 0 { counts[0]++; }
		while x > 0 {
			counts[x % 10]++;
			x /= 10;
		}
	}
	var matched = 0;
	for d in 10 {
		if counts[d] >= fr { matched++; }
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "frequent digits: ", matched);
	out
}
@end
