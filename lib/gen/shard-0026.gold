code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_run};
	var max_streak = 0;
	var cur = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
		} else {
			if cur > max_streak {
				max_streak = cur;
			}
			cur = 1;
		}
		i++;
	}
	if cur > max_streak {
		max_streak = cur;
	}
	g.steps += g.n;
	out.ok = max_streak >= target;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak found: ", max_streak);
	out
}
@end
