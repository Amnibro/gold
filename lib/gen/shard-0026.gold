fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = v.i;
	if n < 0 { n = -n; }
	var digits int[32] = [0; 32];
	var count = 0;
	if n == 0 {
		digits[0] = 0;
		count = 1;
	} else {
		while n > 0 && count < 32 {
			digits[count] = n % 10;
			n = n / 10;
			count++;
		}
	}
	var valid = true;
	var i = 0;
	while i < count {
		if digits[i] % 2 != 0 {
			valid = false;
			break;
		}
		i += 2;
	}
	g.steps += count;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "alternating parity: ", out.ok);
	out
}
@end
