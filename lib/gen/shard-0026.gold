fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, g.res[k], g.res[k] * 2);
	}
	var i = 0;
	while i < g.cn {
		var j = i + 1;
		while j < g.cn {
			if g.ck[i] > g.ck[j] {
				let tk = g.ck[i];
				g.ck[i] = g.ck[j];
				g.ck[j] = tk;
				let tv = g.cv[i];
				g.cv[i] = g.cv[j];
				g.cv[j] = tv;
			}
			j++;
		}
		i++;
	}
	g.steps += g.cn * 2;
	out.i = if g.cn > 0 { g.ck[0] } else { 0 };
	out.s.clear();
	format(out.s, "smallest memo key: ", out.i);
	out
}
@end
