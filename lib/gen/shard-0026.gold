@entry 3791ead8ae4e7798
kind: step
verb: normalize
noun: digits
modifier: with_cache
context: core
phrase: normalize digits with cache lookup digits
phrase: sum digits with cache lookup acceleration
test: list=12,34,56
expect: => i=3 r=0.0 ok=true s="normalized digits: 3" errors=0 n=3 res=[3,7,11] cache=3 hits=0
test: list=123,456
expect: => i=2 r=0.0 ok=true s="normalized digits: 2" errors=0 n=2 res=[6,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cached, found = gold_cache_get(g, x);
		if found {
			g.res[i] = cached;
		} else {
			var num = x;
			if num < 0 { num = -num; }
			var sum = 0;
			while num > 0 {
				sum += num % 10;
				num /= 10;
			}
			gold_cache_put(g, x, sum);
			g.res[i] = sum;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized digits: ", g.n);
	out
}
@end
