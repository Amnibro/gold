slot: r real
test: x=1.0 y=2.0 r=1.5
expect: => i=1 r=0.0 ok=true s="cavern" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: carch1 sphere 1,2,1.5 r1.5 m:matte #55504b
test: x=-2.0 y=3.0 r=2.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="cavern" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: carch3 sphere -2,3,2 r2 m:matte #55504b
test: x=1.0 y=2.0 r=-1.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let salt_env_pile_cave_rolling = 0;
	var out = v;
	var o byte[>..] = [];
	if ${r} <= 0.0 { gold_fail(g, "radius must be positive"); out.ok = false; return out; }
	gold_dnews(g, "carch", "", o);
	o.append(" sphere ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	gold_fnum(o, ${r});
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" m:matte ");
	gold_hex(o, 85, 80, 75);
	gold_doc(g, o);
	out.i = g.dn + salt_env_pile_cave_rolling;
	out.s.clear();
	format(out.s, "cavern");
	out
}
@end
