code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${minlen};
	var max_streak = 0;
	var cur = 0;
	for i in g.n {
		if g.res[i] > 0 {
			cur++;
			if cur > max_streak { max_streak = cur; }
		} else {
			cur = 0;
		}
	}
	let valid = max_streak >= ml;
	gold_push(g, max_streak);
	g.steps += g.n;
	out.ok = valid;
	out.i = max_streak;
	out.s.clear();
	if valid {
		format(out.s, "streak confirmed: ", max_streak);
	} else {
		format(out.s, "streak insufficient");
	}
	out
}
@end
