@entry 60b32f0a9318b9e6
kind: step
verb: normalize
noun: sequence
modifier: unique
context: transform
phrase: normalize sequence unique consecutive items
phrase: deduplicate consecutive values across sequence
test: list=1,1,2,2,3,3,3
expect: => i=4 r=0.0 ok=true s="normalized sequence unique removed: 4" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,6,7
expect: => i=2 r=0.0 ok=true s="normalized sequence unique removed: 2" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var keep = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] != g.res[keep - 1] {
			g.res[keep] = g.res[i];
			keep++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n - keep;
	g.n = keep;
	out.s.clear();
	format(out.s, "normalized sequence unique removed: ", out.i);
	out
}
@end
