@entry 99b46dcebe7a04c5
kind: step
verb: clamp
noun: digits
modifier: all
context: math
phrase: clamp digits all within maximum {upper_digit}
phrase: bound digits all below ceiling {upper_digit}
slot: upper_digit int
test: input=38472 upper_digit=5
expect: => i=35452 r=0.0 ok=true s="clamped digits result: 35452" errors=0 n=0 res=[] cache=0 hits=0
test: input=91827 upper_digit=6
expect: => i=61626 r=0.0 ok=true s="clamped digits result: 61626" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${upper_digit};
	var n = v.i;
	var is_neg = n < 0;
	if is_neg { n = -n; }
	var digits int[32] = [0; 32];
	var count = 0;
	if n == 0 {
		digits[0] = 0;
		count = 1;
	} else {
		while n > 0 && count < 32 {
			var d = n % 10;
			if d > lim { d = lim; }
			digits[count] = d;
			n = n / 10;
			count++;
		}
	}
	var res = 0;
	var i = count - 1;
	while i >= 0 {
		res = res * 10 + digits[i];
		i--;
	}
	if is_neg { res = -res; }
	g.steps += count;
	out.i = res;
	out.s.clear();
	format(out.s, "clamped digits result: ", res);
	out
}
@end
