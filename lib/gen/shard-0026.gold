@entry b31e31c7191ef88e
kind: step
verb: collect
noun: head
modifier: in_reverse
context: core
phrase: collect head in reverse for count {count}
phrase: extract initial elements reversed for count {count}
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="head reversed" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="head reversed" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let actual = if cnt < g.n { cnt } else { g.n };
	for i in actual / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[actual - 1 - i];
		g.res[actual - 1 - i] = tmp;
	}
	out.i = actual;
	out.s.clear();
	format(out.s, "head reversed");
	out
}
@end
@entry 73bc584176449955
kind: step
verb: sum
noun: words
modifier: last
context: core
phrase: sum words last items for count {count}
phrase: accumulate tail word lengths for count {count}
slot: count int
test: text="quick brown fox jumps" count=2
expect: => i=8 r=0.0 ok=true s="last words summed" errors=0 n=1 res=[8] cache=0 hits=0
test: text="blue green red" count=1
expect: => i=3 r=0.0 ok=true s="last words summed" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	var lens = [0; 64];
	var wn = 0;
	var cur = 0;
	for ch in out.s {
		if ch == 32 {
			if cur > 0 { lens[wn] = cur; wn++; cur = 0; }
		} else {
			cur++;
		}
	}
	if cur > 0 { lens[wn] = cur; wn++; }
	var total = 0;
	let take = if cnt < wn { cnt } else { wn };
	var idx = wn - take;
	while idx < wn {
		total += lens[idx];
		idx++;
	}
	gold_push(g, total);
	out.i = total;
	out.s.clear();
	format(out.s, "last words summed");
	out
}
@end
