code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = 0; }
		if x > 100 { x = 100; }
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited bounds none: ", g.n);
	out
}
@end
@entry 975aefee86fff67c
kind: step
verb: fill
noun: prefix
modifier: at_least
context: transform
phrase: fill prefix at least count {min_count}
phrase: pad prefix items up to {min_count}
slot: min_count int
test: list=10,20 min_count=4
expect: => i=2 r=0.0 ok=true s="filled prefix at least count: 2" errors=0 n=4 res=[10,10,10,20] cache=0 hits=0
test: list=5 min_count=3
expect: => i=2 r=0.0 ok=true s="filled prefix at least count: 2" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	if g.n < mc && mc <= 512 {
		let pad_count = mc - g.n;
		var buf int[512] = [0; 512];
		let first_val = if g.n > 0 { g.res[0] } else { 0 };
		for k in pad_count { buf[k] = first_val; }
		for i in g.n { buf[pad_count + i] = g.res[i]; }
		g.n = mc;
		for i in g.n { g.res[i] = buf[i]; }
		out.i = pad_count;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "filled prefix at least count: ", out.i);
	out
}
@end
