test: list=50,10,30,20
expect: => i=4 r=0.0 ok=true s="series: 10,20,30,50" errors=0 n=4 res=[50,10,30,20] cache=0 hits=0
test: list=9,1,4
expect: => i=3 r=0.0 ok=true s="series: 1,4,9" errors=0 n=3 res=[9,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var arr int[512] = [0; 512];
	var n = g.n;
	var i = 0;
	while i < n { arr[i] = g.res[i]; i++; }
	var a = 0;
	while a < n {
		var min_idx = a;
		var b = a + 1;
		while b < n {
			if arr[b] < arr[min_idx] { min_idx = b; }
			b++;
		}
		if min_idx != a {
			let tmp = arr[a]; arr[a] = arr[min_idx]; arr[min_idx] = tmp;
		}
		a++;
	}
	out.s.clear();
	format(out.s, "series: ");
	var c = 0;
	while c < n {
		if c > 0 { out.s.push(','); }
		format(out.s, arr[c]);
		c++;
	}
	out.i = n;
	out
}
@end
