fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	var found = [0; 64];
	var fn_cnt = 0;
	for i in g.n {
		let c = g.res[i];
		if c == 65 || c == 69 || c == 73 || c == 79 || c == 85 ||
		   c == 97 || c == 101 || c == 105 || c == 111 || c == 117 {
			if fn_cnt < 64 { found[fn_cnt] = c; fn_cnt++; }
		}
	}
	g.n = 0;
	for rep in r {
		for j in fn_cnt {
			gold_push(g, found[j]);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "vowels selected: ", g.n);
	out
}
