			odds_removed++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	var pass = 0;
	while pass < max_r && odds_removed > 2 {
		odds_removed--;
		pass++;
	}
	g.steps += pass + 1;
	out.i = odds_removed;
	out.s.clear();
	format(out.s, "odds filtered cache");
	out
}
