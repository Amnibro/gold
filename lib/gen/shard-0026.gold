@entry 485e3fa45b67a77f
kind: step
verb: reverse
noun: odds
modifier: until
context: loop
phrase: reverse odd values in sequence until reaching index limit {limit}
phrase: invert odd numbers encountered before index cutoff {limit}
slot: limit int
test: list=1,2,3,4,5,6 limit=5
expect: => i=3 r=0.0 ok=true s="reversed odds until: 3" errors=0 n=6 res=[5,2,3,4,1,6] cache=0 hits=0
test: list=7,9,11,12,13 limit=3
expect: => i=3 r=0.0 ok=true s="reversed odds until: 3" errors=0 n=5 res=[11,9,7,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cap = lim;
	if cap > g.n { cap = g.n; }
	var odd_pos = [0; 64];
	var on = 0;
	for i in cap {
		if g.res[i] % 2 != 0 {
			if on < 64 { odd_pos[on] = i; on++; }
		}
	}
	var l = 0;
	var r = on - 1;
	while l < r {
		let p1 = odd_pos[l];
		let p2 = odd_pos[r];
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		l++;
		r--;
	}
	out.i = on;
	out.s.clear();
	format(out.s, "reversed odds until: ", on);
	out
}
@end
