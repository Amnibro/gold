slot: min_len int
test: list=1,2,3,1,2 min_len=2
expect: => i=3 r=0.0 ok=true s="sorted streak scanned: 3" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=5,4,3,2 min_len=2
expect: => i=1 r=0.0 ok=false s="sorted streak scanned: 1" errors=0 n=4 res=[5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_len};
	var max_streak = 0;
	var cur_streak = 1;
	if g.n == 0 { cur_streak = 0; }
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
		}
		i++;
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	out.ok = max_streak >= min_len;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "sorted streak scanned: ", max_streak);
	out
}
@end
