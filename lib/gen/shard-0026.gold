code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if g.n == 0 { out.ok = false; return out; }
	let last = g.res[g.n - 1];
	for _ in cnt { gold_push(g, last); }
	out.i = g.n;
	out.s.clear();
	format(out.s, "total letters: ", g.n);
	out
}
@end
