@entry e0d338ca988f7827
kind: step
verb: rotate
noun: duplicates
modifier: in_reverse
context: search
phrase: rotate duplicates in reverse displacement {rot}
phrase: cycle duplicate search keys backwards {rot}
slot: rot int
test: list=2,2,4,5,5 rot=1
expect: => i=4 r=0.0 ok=true s="dupes rotated: 4" errors=0 n=4 res=[2,5,5,2] cache=0 hits=0
test: list=7,7,7,1 rot=2
expect: => i=3 r=0.0 ok=true s="dupes rotated: 3" errors=0 n=3 res=[7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rot};
	var dupes = [0; 512];
	var dn = 0;
	for i in g.n {
		let x = g.res[i];
		var c = 0;
		for j in g.n {
			if g.res[j] == x { c++; }
		}
		if c > 1 {
			dupes[dn] = x;
			dn++;
		}
	}
	if dn > 0 {
		var sh = r % dn;
		if sh < 0 { sh += dn; }
		var tmp = [0; 512];
		for k in dn {
			let dest = (k - sh + dn) % dn;
			tmp[dest] = dupes[k];
		}
		gold_clear(g);
		for k in dn {
			gold_push(g, tmp[k]);
		}
	}
	g.steps += g.n + dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "dupes rotated: ", dn);
	out
}
@end
