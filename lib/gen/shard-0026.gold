noun: loop
modifier: with_cache
context: core
phrase: drop loop iterations stored in cache
phrase: purge loop results matching cached keys
test: list=10,20,30,40,50
expect: => i=3 r=0.0 ok=true s="dropped cached: 3" errors=0 n=3 res=[10,30,50] cache=2 hits=2
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="dropped cached: 5" errors=0 n=5 res=[1,2,3,4,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 20, 1);
	gold_cache_put(g, 40, 1);
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		let x = g.res[i];
		let _, found = gold_cache_get(g, x);
		if !found {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "dropped cached: ", kn);
	out
}
@end
