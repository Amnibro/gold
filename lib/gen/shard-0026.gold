phrase: reverse unique items when error count meets threshold {cutoff}
phrase: invert distinct sequence elements upon reaching error limit {cutoff}
slot: cutoff int
test: list=10,20,20,30,40 cutoff=0
expect: => i=4 r=0.0 ok=true s="reversed errors unique: 4" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
test: list=5,7,7,9 cutoff=2
expect: => i=4 r=0.0 ok=true s="reversed errors unique: 4" errors=0 n=4 res=[5,7,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if g.errors >= cut {
		var un = 0;
		for i in g.n {
			var dup = false;
			for j in un {
				if g.res[j] == g.res[i] { dup = true; break; }
			}
			if !dup {
				g.res[un] = g.res[i];
				un++;
			}
		}
		g.n = un;
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed errors unique: ", g.n);
	out
}
@end
