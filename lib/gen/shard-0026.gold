@entry 3f8f0e02710c4c49
kind: step
verb: swap
noun: average
modifier: at_least
context: transform
phrase: swap elements exceeding average at least threshold {threshold}
phrase: reorder items above mean at least margin {threshold}
slot: threshold int
test: list=10,40,20,50,30 threshold=5
expect: => i=1 r=0.0 ok=true s="swapped 1 items above average" errors=0 n=5 res=[10,50,20,40,30] cache=0 hits=0
test: list=4,24,12,32,16 threshold=4
expect: => i=1 r=0.0 ok=true s="swapped 1 items above average" errors=0 n=5 res=[4,32,12,24,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var swapped = 0;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < j && (g.res[i] - avg) < th { i++; }
		while i < j && (g.res[j] - avg) < th { j--; }
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			swapped++;
			i++;
			j--;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped ", swapped, " items above average");
	out
}
@end
