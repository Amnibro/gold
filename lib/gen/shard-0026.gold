noun: odds
modifier: last
context: search
phrase: validate odds last candidates depth {depth}
phrase: check trailing search candidate parity {depth}
slot: depth int
test: list=2,4,7,9 depth=2
expect: => i=2 r=0.0 ok=true s="trailing candidates odd" errors=0 n=5 res=[2,4,7,9,2] cache=0 hits=0
test: list=3,5,6,8 depth=2
expect: => i=0 r=0.0 ok=false s="even found in tail" errors=0 n=5 res=[3,5,6,8,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var all_odd = true;
	var checked = 0;
	var i = g.n - 1;
	while i >= 0 && checked < d {
		if g.res[i] % 2 == 0 {
			all_odd = false;
			break;
		}
		checked++;
		i--;
	}
	if checked < d { all_odd = false; }
	gold_push(g, checked);
	g.steps += checked + 1;
	out.ok = all_odd;
	out.i = checked;
	out.s.clear();
	if all_odd {
		format(out.s, "trailing candidates odd");
	} else {
		format(out.s, "even found in tail");
	}
	out
}
@end
