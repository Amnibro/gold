fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var max_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] > g.res[max_idx] { max_idx = j; }
		}
		if max_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[max_idx];
			g.res[max_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ordered ", g.n, " results descending");
	out
}
