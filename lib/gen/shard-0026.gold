code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cut};
	if c > 0 && c < out.s.len {
		var buf: byte[..200] = "";
		var i = c;
		while i < out.s.len {
			buf.push(out.s[i]);
			i++;
		}
		out.s.clear();
		for b in buf { out.s.push(b); }
	} else if c >= out.s.len {
		out.s.clear();
	}
	out.i = out.s.len;
	out
}
@end
