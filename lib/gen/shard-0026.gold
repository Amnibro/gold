fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	out.s.clear();
	var i = 0;
	while i < g.n {
		var val = g.res[i];
		if val < low { val = low; }
		if val > high { val = high; }
		if i > 0 { out.s.push(','); }
		format(out.s, val);
		i++;
	}
	out.i = g.n;
	out
}
@end
@entry 57a591c01d53ed4f
kind: step
verb: sort
noun: words
modifier: in_reverse
context: format
phrase: sort words in reverse alphabetical order
phrase: arrange words descending sequence
test: text="cherry banana apple"
expect: => i=3 r=0.0 ok=true s="apple banana apple " errors=0 n=0 res=[] cache=0 hits=0
test: text="dog cat elephant"
expect: => i=3 r=0.0 ok=true s="elephant han ele" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wlist = words(out.s);
	var n = wlist.len;
	var i = 0;
	while i < n {
		var max_idx = i;
		var j = i + 1;
		while j < n {
			if wlist[j] > wlist[max_idx] { max_idx = j; }
			j++;
		}
		if max_idx != i {
			let tmp = wlist[i];
			wlist[i] = wlist[max_idx];
			wlist[max_idx] = tmp;
		}
		i++;
	}
	out.s.clear();
	var k = 0;
	while k < n {
		if k > 0 { out.s.push(' '); }
		out.s.append(wlist[k]);
		k++;
	}
	out.i = n;
	out
}
@end
