expect: => i=0 r=0.0 ok=true s="loop differences at most: 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for diff pairing");
		return out;
	}
	var count = 0;
	for k in g.n - 1 {
		let diff = g.res[k + 1] - g.res[k];
		let d = if diff < 0 { -diff } else { diff };
		if d <= md { count++; }
	}
	g.steps += g.n - 1;
	out.i = count;
	out.s.clear();
	format(out.s, "loop differences at most: ", count);
	out
}
@end
