phrase: reverse spaces with cache index {mark}
phrase: flip spaces with cache identifier {mark}
slot: mark int
test: text="first second third" mark=42
expect: => i=3 r=0.0 ok=true s="driht dnoces tsrif" errors=0 n=0 res=[] cache=1 hits=0
test: text="alpha beta" mark=99
expect: => i=2 r=0.0 ok=true s="ateb ahpla" errors=0 n=0 res=[] cache=1 hits=0
code:
// sort step reverse spaces with_cache
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mk = ${mark};
	var words = 0;
	for b in out.s {
		if b == ' ' { words++; }
	}
	if out.s.len > 0 { words++; }
	gold_cache_put(g, mk, words);
	var buf: byte[..200] = "";
	var k = out.s.len - 1;
	while k >= 0 {
		buf.push(out.s[k]);
		k--;
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	out.i = words;
	out
}
@end
@entry 87d1e1ec8024ad3f
kind: step
verb: pair
noun: sequence
modifier: any
context: sort
phrase: pair sequence any difference limit {delta}
phrase: couple sequence any tolerance window {delta}
slot: delta int
test: list=1,4,5,9,11 delta=2
expect: => i=2 r=0.0 ok=true s="sequence pairs: 2" errors=0 n=2 res=[9,20] cache=0 hits=0
test: list=2,10,14,15,22 delta=3
expect: => i=1 r=0.0 ok=true s="sequence pairs: 1" errors=0 n=1 res=[29] cache=0 hits=0
code:
// sort step pair sequence any
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var pairs = 0;
	var paired = [0; 512];
	var pn = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff <= d {
			paired[pn] = g.res[i] + g.res[i + 1];
			pn++;
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	gold_clear(g);
	for k in pn { gold_push(g, paired[k]); }
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "sequence pairs: ", pairs);
	out
}
@end
