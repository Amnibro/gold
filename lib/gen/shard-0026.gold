code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	var streaks = 0;
	var k = 0;
	while k < g.n {
		var run = 1;
		while k + run < g.n && g.res[k + run] == g.res[k] { run++; }
		if run >= win {
			streaks++;
			gold_cache_put(g, g.res[k], run);
		}
		k += run;
	}
	out.i = streaks;
	out.s.clear();
	format(out.s, "streaks cached: ", streaks);
	out
}
@end
