fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 { return out; }
	let first = g.res[0];
	var count = 0;
	for k in g.n {
		if g.res[k] < first { count++; }
	}
	let result = count * sc;
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "rank times scale: ", result);
	out
}
@end
