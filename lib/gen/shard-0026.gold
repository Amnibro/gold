fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let keep = if k < g.n { k } else { g.n };
	let start = g.n - keep;
	for i in keep {
		g.res[i] = g.res[start + i];
	}
	g.n = keep;
	g.steps += keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "retained ", keep, " tail elements");
	out
}
