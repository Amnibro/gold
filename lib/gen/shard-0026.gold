noun: list
modifier: between
context: core
phrase: fill list between bounds using step {step}
phrase: interpolate between list entries by step {step}
slot: step int
test: list=2,10 step=2
expect: => i=5 r=0.0 ok=true s="list filled between bounds" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=5,20 step=5
expect: => i=4 r=0.0 ok=true s="list filled between bounds" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	if g.n < 2 || st <= 0 {
		gold_fail(g, "insufficient bounds or invalid step");
		out.ok = false;
		return out;
	}
	let start = g.res[0];
	let end_val = g.res[g.n - 1];
	gold_clear(g);
	var cur = start;
	while cur <= end_val {
		gold_push(g, cur);
		cur += st;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "list filled between bounds");
	out
}
@end
