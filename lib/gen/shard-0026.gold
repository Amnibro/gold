code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = [0; 512];
	var dn = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var exists = false;
			for j in dn {
				if dups[j] == x { exists = true; }
			}
			if !exists {
				dups[dn] = x;
				dn++;
			}
		}
	}
	gold_clear(g);
	for i in dn { gold_push(g, dups[i]); }
	out.i = dn;
	out.s.clear();
	format(out.s, "duplicates collected: ", dn);
	out
}
@end
