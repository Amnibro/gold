expect: => i=2 r=0.0 ok=true s="computed 2 window sums" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	if g.n < w { out.i = 0; return out; }
	let num_windows = g.n - w + 1;
	for i in num_windows {
		var win_sum = 0;
		for j in w { win_sum += g.res[i + j]; }
		g.res[i] = win_sum;
	}
	g.n = num_windows;
	g.steps += num_windows * w;
	out.i = num_windows;
	out.s.clear();
	format(out.s, "computed ", num_windows, " window sums");
	out
}
@end
