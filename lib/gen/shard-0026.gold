fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp byte[..200] = [];
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			tmp.push(c);
		}
		i++;
	}
	out.s.clear();
	out.s.append(tmp);
	out.i = out.s.len;
	out
}
