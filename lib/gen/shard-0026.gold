@entry 1c565e0c02f54d0e
kind: step
verb: compare
noun: odds
modifier: while
context: loop
phrase: compare odds while sequence elements match
phrase: examine odd numbers while values align
test: list=1,3,5,7,8,9
expect: => i=4 r=0.0 ok=true s="matched 4 leading odds" errors=0 n=6 res=[1,3,5,7,8,9] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=true s="matched 0 leading odds" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			count++;
			i++;
		} else {
			break;
		}
	}
	g.steps += i;
	out.i = count;
	out.s.clear();
	format(out.s, "matched ", count, " leading odds");
	out
}
@end
@entry 25c4f90d8cdf815e
kind: step
verb: drop
noun: minimum
modifier: in_place
context: loop
phrase: drop minimum in place smallest element
phrase: remove minimum in place lowest item
test: list=8,3,9,5
expect: => i=3 r=0.0 ok=true s="dropped minimum 3" errors=0 n=3 res=[8,9,5] cache=0 hits=0
test: list=12,20,7
expect: => i=7 r=0.0 ok=true s="dropped minimum 7" errors=0 n=2 res=[12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let min_val = g.res[min_idx];
	for i in min_idx..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "dropped minimum ", min_val);
	out
}
@end
