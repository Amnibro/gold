code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if count <= 1 || count > g.n { out.ok = false; return out; }
	var sum = 0;
	var i = g.n - count;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.n = g.n - count;
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "merged last steps: ", sum);
	out
}
@end
