@entry fc60c9eaa2c34ed7
kind: pred
verb: limit
noun: average
modifier: sorted
context: list
phrase: check if decimal digits are sorted ascending
phrase: verify digits appear in sorted ascending order
phrase: digits are ordered in sorted ascending progression
test: arg=1235,4589
expect: true
expect: true
test: arg=1324,9876
expect: false
expect: false
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = 10;
	var ok = true;
	while x > 0 {
		let d = x % 10;
		if d > prev { ok = false; }
		prev = d;
		x /= 10;
	}
	ok
}
@end
