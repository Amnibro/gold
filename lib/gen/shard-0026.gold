fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = 0;
		while j < g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted count: ", g.n);
	out
}
