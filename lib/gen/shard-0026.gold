fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_streak = ${limit};
	out.s.clear();
	var count = 0;
	var cur_run = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			cur_run = 1;
		} else {
			cur_run++;
		}
		if cur_run <= max_streak {
			if count > 0 { out.s.push(','); }
			format(out.s, g.res[i]);
			count++;
		}
		i++;
	}
	out.i = count;
	out
}
@end
