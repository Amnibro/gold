fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_cache_range_with_cache = 0;
	let low = ${lo};
	let high = ${hi};
	var added = 0;
	for x in low..(high + 1) {
		let cached, ok = gold_cache_get(g, x);
		if ok {
			gold_push(g, cached);
		} else {
			let val = x * x;
			gold_cache_put(g, x, val);
			gold_push(g, val);
			added++;
		}
	}
	g.steps += added + mark_transform_cache_range_with_cache;
	out.i = added;
	out.s.clear();
	format(out.s, "cached ", added, " entries");
	out
}
@end
@entry 8a7e57993adf9dd2
kind: step
verb: drop
noun: words
modifier: safely
context: transform
phrase: drop words safely up to count {k}
phrase: remove initial words safely up to {k}
phrase: drop leading words safely with count {k}
slot: k int
test: text="one two three four" k=2
expect: => i=2 r=0.0 ok=true s="three four" errors=0 n=0 res=[] cache=0 hits=0
test: text="single word" k=5
expect: => i=1 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_drop_words_safely = 0;
	let drop_n = ${k};
	var words_seen = 0;
	var start_idx = v.s.len;
	var i = 0;
	while i < v.s.len && words_seen < drop_n {
		if v.s[i] == ' ' {
			words_seen++;
			if words_seen == drop_n {
				start_idx = i + 1;
			}
		}
		i++;
	}
	var new_s byte[..200] = "";
	if words_seen >= drop_n && start_idx < v.s.len {
		for j in start_idx..v.s.len {
			new_s.push(v.s[j]);
		}
	}
	out.s = new_s;
	g.steps += words_seen + mark_transform_drop_words_safely;
	out.i = words_seen;
	out
}
@end
