@entry 4de7daf341c80bbf
kind: step
verb: clamp
noun: streak
modifier: at_least
context: format
phrase: clamp streak lengths at least floor {min_run}
phrase: pad streak minimum length to {min_run}
slot: min_run int
test: text="aabccc" min_run=2
expect: => i=7 r=0.0 ok=true s="aabbccc" errors=0 n=0 res=[] cache=0 hits=0
test: text="xy" min_run=2
expect: => i=4 r=0.0 ok=true s="xxyy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_len = ${min_run};
	if out.s.len == 0 { return out; }
	var res byte[..200] = [];
	var cur_ch = out.s[0];
	var cur_len = 1;
	var i = 1;
	while i < out.s.len {
		if out.s[i] == cur_ch {
			cur_len++;
		} else {
			let target_len = if cur_len < floor_len { floor_len } else { cur_len };
			var k = 0;
			while k < target_len { res.push(cur_ch); k++; }
			cur_ch = out.s[i];
			cur_len = 1;
		}
		i++;
	}
	let target_len = if cur_len < floor_len { floor_len } else { cur_len };
	var k = 0;
	while k < target_len { res.push(cur_ch); k++; }
	out.s.clear();
	out.s.append(res);
	out.i = out.s.len;
	out
}
@end
@entry 8fd146e04e24ec44
kind: step
verb: dedupe
noun: subfunction
modifier: at_least
context: format
phrase: dedupe subfunction values with frequency at least {min_freq}
phrase: filter subfunction outputs meeting minimum count {min_freq}
slot: min_freq int
test: list=1,2,2,3,3,3 min_freq=2
expect: => i=2 r=0.0 ok=true s="2,3" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,5,6 min_freq=3
expect: => i=1 r=0.0 ok=true s="5" errors=0 n=4 res=[5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_freq};
	var seen int[256] = [0; 256];
	var counts int[256] = [0; 256];
	var sn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var idx = -1;
		var j = 0;
		while j < sn {
			if seen[j] == x { idx = j; break; }
			j++;
		}
		if idx >= 0 {
			counts[idx]++;
		} else {
			seen[sn] = x;
			counts[sn] = 1;
			sn++;
		}
		i++;
	}
	out.s.clear();
	var count = 0;
	var k = 0;
	while k < sn {
		if counts[k] >= threshold {
			if count > 0 { out.s.push(','); }
			format(out.s, seen[k]);
			count++;
		}
		k++;
	}
	out.i = count;
	out
}
@end
