code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n == 0 || k <= 0 { out.ok = false; return out; }
	let first = g.res[0];
	var u = [0; 64];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for s in un {
			if u[s] == x { exists = true; break; }
		}
		if !exists && un < k && un < 64 {
			u[un] = x;
			un++;
		}
	}
	gold_clear(g);
	for i in un {
		gold_push(g, first + u[i]);
	}
	out.i = un;
	out.s.clear();
	format(out.s, "paired head unique count: ", un);
	out
}
@end
