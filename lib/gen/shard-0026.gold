code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var pass = 0;
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[i] == g.res[j] { seen = true; break; }
		}
		if !seen { unique_count++; }
	}
	while pass < max_r && unique_count > 2 {
		unique_count--;
		pass++;
	}
	gold_push(g, unique_count);
	g.steps += pass + 1;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique tally bounded");
	out
}
