test: arg=27,42
expect: 4
expect: 3
test: arg=0
expect: 0
code:
fn ${ID}(n int) int {
	let salt_search_odds_recursively = 0;
	var x = if n < 0 { -n } else { n };
	var count = 0;
	while x > 0 {
		if (x & 1) == 1 { count++; }
		x >>= 1;
	}
	count + salt_search_odds_recursively
}
@end
