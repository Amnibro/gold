fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	var adjusted = 0;
	for i in g.n {
		var tries = 0;
		while g.res[i] <= 0 && tries < count {
			g.res[i] += 2;
			tries++;
			adjusted++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "retried numbers: ", adjusted);
	out
}
