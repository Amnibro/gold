code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for k in g.n {
		if g.res[k] < lim { count++; } else { break; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "ranked while: ", count);
	out
}
@end
@entry 54f673a9af10c3ee
kind: step
verb: fold
noun: items
modifier: each
context: compare
phrase: fold items each subtracting step delta {delta}
phrase: reduce each item by given step delta {delta}
phrase: fold each element with decrement delta {delta}
slot: delta int
test: list=10,20,30 delta=5
expect: => i=45 r=0.0 ok=true s="folded sum: 45" errors=0 n=3 res=[5,15,25] cache=0 hits=0
test: list=4,8,12 delta=2
expect: => i=18 r=0.0 ok=true s="folded sum: 18" errors=0 n=3 res=[2,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var sum = 0;
	for k in g.n {
		g.res[k] = g.res[k] - d;
		sum += g.res[k];
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded sum: ", sum);
	out
}
@end
@entry 6ed289f9cef9271d
kind: step
verb: fold
noun: condition
modifier: recursively
context: compare
phrase: fold condition recursively above cutoff {cutoff}
phrase: reduce items recursively satisfying cutoff {cutoff}
phrase: fold conditional pairs recursively under bound {cutoff}
slot: cutoff int
test: list=50,30,20,10 cutoff=25
expect: => i=2 r=0.0 ok=true s="conditional folds: 2" errors=0 n=4 res=[25,15,20,10] cache=0 hits=0
test: list=5,10,15 cutoff=25
expect: => i=0 r=0.0 ok=true s="conditional folds: 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var folded = 0;
	for k in g.n {
		if g.res[k] > cut {
			g.res[k] = g.res[k] / 2;
			folded++;
		}
	}
	out.i = folded;
	out.s.clear();
	format(out.s, "conditional folds: ", folded);
	out
}
@end
