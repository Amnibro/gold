@entry 56ca49b60fb24f06
kind: step
verb: reverse
noun: middle
modifier: sorted
context: loop
phrase: reverse middle sequence elements after sorting internal range
phrase: sort middle loop values before reversing their order
test: list=100,50,20,80,10
expect: => i=3 r=0.0 ok=true s="reversed sorted middle: 3" errors=0 n=5 res=[100,80,50,20,10] cache=0 hits=0
test: list=5,9,2,7,4,1
expect: => i=4 r=0.0 ok=true s="reversed sorted middle: 4" errors=0 n=6 res=[5,9,7,4,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var i = 1;
	while i < g.n - 1 {
		var j = i;
		while j > 1 && g.res[j - 1] > g.res[j] {
			let tmp = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = tmp;
			j--;
		}
		i++;
	}
	var left = 1;
	var right = g.n - 2;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = g.n - 2;
	out.s.clear();
	format(out.s, "reversed sorted middle: ", out.i);
	out
}
@end
