test: input=9876
expect: => i=8769 r=0.0 ok=true s="rotated digits value: 8769" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = v.i;
	if n < 0 { n = -n; }
	if n < 10 {
		out.i = n;
		return out;
	}
	var mult = 1;
	var temp = n;
	while temp >= 10 {
		mult *= 10;
		temp = temp / 10;
	}
	let high = temp;
	let rem = n % mult;
	out.i = rem * 10 + high;
	g.steps += 10;
	out.s.clear();
	format(out.s, "rotated digits value: ", out.i);
	out
}
@end
