	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.ih < 2 { gold_fail(g, "texture too short"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (y as real) / ((g.ih - 1) as real);
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t_1 = 0.0;
			for dy in 3 { for dx in 3 { t_1 += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_1[y * g.iw + x] = t_1 / 9.0;
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] * ${a}); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
