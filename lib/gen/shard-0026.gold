expect: => doc: crat4 sphere 0,1.5,.5 r.4 m:matte #8a8580
expect: => doc: crat5 sphere 2,3,.5 r.4 m:matte #8a8580
expect: => doc: crat6 sphere 4,4.5,.5 r.4 m:matte #8a8580
test: count=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_scatter_crater_steep_alpha = 0;
	let cnt = ${count};
	if cnt <= 0 || cnt > 12 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var o byte[>..] = [];
	for q in cnt {
		let px = (q as real) * 2.0 - 2.0;
		let py = (q as real) * 1.5;
		o.clear();
		gold_dnews(g, "crat", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.5 r.4 m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = g.dn + mark_scatter_crater_steep_alpha;
	out.s.clear();
	format(out.s, "sctcrat");
	out
}
@end
