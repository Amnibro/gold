test: list=1,3,1,3,2
expect: => i=2 r=0.0 ok=true s="collected unique pairs: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
test: list=2,2,4,4
expect: => i=3 r=0.0 ok=true s="collected unique pairs: 3" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sums int[512] = [0; 512];
	var sn = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i+1];
		var exists = false;
		for k in sn {
			if sums[k] == s { exists = true; break; }
		}
		if !exists {
			sums[sn] = s;
			sn++;
		}
		i++;
	}
	for k in sn {
		g.res[k] = sums[k];
	}
	g.n = sn;
	g.steps += g.n;
	out.i = sn;
	out.s.clear();
	format(out.s, "collected unique pairs: ", sn);
	out
}
@end
