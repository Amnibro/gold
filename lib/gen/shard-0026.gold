@entry 562ff4432615a355
kind: step
verb: swap
noun: minimum
modifier: until
context: sort
phrase: swap minimum until sorted bound {bound}
phrase: bubble minimum until sorted limit {bound}
slot: bound int
test: list=7,2,8,1,5 bound=2
expect: => i=2 r=0.0 ok=true s="minimum passes: 2" errors=0 n=5 res=[1,2,8,7,5] cache=0 hits=0
test: list=9,4,3,1 bound=1
expect: => i=1 r=0.0 ok=true s="minimum passes: 1" errors=0 n=4 res=[1,4,3,9] cache=0 hits=0
code:
// sort step swap minimum until
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bd = ${bound};
	var passes = 0;
	while passes < bd && passes < g.n {
		var min_idx = passes;
		var j = passes + 1;
		while j < g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
			j++;
		}
		if min_idx != passes {
			let tmp = g.res[passes];
			g.res[passes] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "minimum passes: ", passes);
	out
}
@end
