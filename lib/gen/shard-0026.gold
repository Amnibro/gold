fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var combined = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > th && g.res[i + 1] > th {
			g.res[i] = g.res[i] + g.res[i + 1];
			for k in (i + 1)..(g.n - 1) {
				g.res[k] = g.res[k + 1];
			}
			g.n--;
			combined++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = combined;
	out.s.clear();
	format(out.s, "combined ", combined, " error pairs");
	out
}
@end
