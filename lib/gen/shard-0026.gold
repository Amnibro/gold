fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var groups = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var count = 0;
		while i < g.n && g.res[i] == val && count < limit {
			count++;
			i++;
