// sort step count words safely
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var count = 0;
	var cur_len = 0;
	for b in out.s {
		if b == ' ' {
			if cur_len >= ml { count++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len >= ml { count++; }
	out.i = count;
	out.s.clear();
	format(out.s, "counted words: ", count);
	out
}
