@entry 38a58ec026a2049a
kind: step
verb: limit
noun: budget
modifier: nested
context: list
phrase: limit budget nested accumulation cap {budget}
phrase: truncate list elements within cumulative budget {budget}
slot: budget int
test: list=10,20,30,40,50 budget=65
expect: => i=60 r=0.0 ok=true s="budget spent: 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 budget=30
expect: => i=20 r=0.0 ok=true s="budget spent: 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bg = ${budget};
	var running = 0;
	var kept = 0;
	var i = 0;
	while i < g.n {
		if running + g.res[i] <= bg {
			running += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = running;
	out.s.clear();
	format(out.s, "budget spent: ", running);
	out
}
@end
