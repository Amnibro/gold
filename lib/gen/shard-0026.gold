@entry 2d4b66fcfa54ecc2
kind: step
verb: merge
noun: runs
modifier: last
context: loop
phrase: merge runs keeping last value threshold {threshold}
phrase: collapse loop runs to last item with {threshold}
slot: threshold int
test: list=1,2,5,6,10 threshold=1
expect: => i=3 r=0.0 ok=true s="merged runs count: 3" errors=0 n=3 res=[2,6,10] cache=0 hits=0
test: list=3,4,5,9,10 threshold=2
expect: => i=2 r=0.0 ok=true s="merged runs count: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n == 0 { out.i = 0; return out; }
	var kept = [0; 64];
	var count = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n {
			let diff = g.res[j + 1] - g.res[j];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff <= thresh { j++; } else { break; }
		}
		if count < 64 { kept[count] = g.res[j]; count++; }
		i = j + 1;
	}
	gold_clear(g);
	for k in count { gold_push(g, kept[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "merged runs count: ", count);
	out
}
@end
