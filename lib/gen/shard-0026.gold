fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${keep};
	let n_keep = if k < g.n { k } else { g.n };
	let start = g.n - n_keep;
	for i in n_keep {
		g.res[i] = g.res[start + i];
	}
	g.n = n_keep;
	g.steps += n_keep;
	out.i = n_keep;
	out.s.clear();
	format(out.s, "kept ", n_keep, " trailing items");
	out
}
@end
