@entry 5e85ae837bb2e7bf
kind: step
verb: validate
noun: text
modifier: pairwise
context: search
phrase: validate text pairwise word disparity {maxgap}
phrase: check consecutive token span difference {maxgap}
slot: maxgap int
test: text="search engine query" maxgap=4
expect: => i=3 r=0.0 ok=true s="search engine query" errors=0 n=1 res=[3] cache=0 hits=0
test: text="a verylongquery word" maxgap=2
expect: => i=3 r=0.0 ok=false s="a verylongquery word" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${maxgap};
	var lens = [0; 64];
	var lc = 0;
	var cur = 0;
	for b in out.s {
		if b == ' ' {
			if cur > 0 {
				lens[lc] = cur;
				lc++;
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 {
		lens[lc] = cur;
		lc++;
	}
	var ok_gap = true;
	var i = 0;
	while i + 1 < lc {
		var diff = lens[i + 1] - lens[i];
		if diff < 0 { diff = -diff; }
		if diff > mg {
			ok_gap = false;
			break;
		}
		i++;
	}
	gold_push(g, lc);
	g.steps += out.s.len;
	out.ok = ok_gap;
	out.i = lc;
	out
}
@end
