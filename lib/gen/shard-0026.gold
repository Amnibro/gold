code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_rot};
	if g.n <= 1 { return out; }
	let steps = if mr < 1 { 1 } else { mr % g.n };
	for _ in steps {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 { g.res[k] = g.res[k - 1]; k--; }
		g.res[0] = last;
	}
	out.i = steps;
	out.s.clear();
	format(out.s, "items rotated: ", steps);
	out
}
@end
