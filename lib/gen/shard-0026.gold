fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var lo = [0; 512];
	var lon = 0;
	var hi = [0; 512];
	var hin = 0;
	for i in g.n {
		if g.res[i] <= p {
			lo[lon] = g.res[i];
			lon++;
		} else {
			hi[hin] = g.res[i];
			hin++;
		}
	}
	gold_clear(g);
	for i in lon { gold_push(g, lo[i]); }
	for i in hin { gold_push(g, hi[i]); }
	out.i = lon;
	out.s.clear();
	format(out.s, "split pivot count: ", lon);
	out
}
@end
