	if g.n >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	out.i = g.n + mark_swap_number_while_alpha;
	out.s.clear();
	format(out.s, "swpnumb: ", g.n);
	out
}
@end
