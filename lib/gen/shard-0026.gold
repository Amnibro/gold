fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_count_list_all_alpha = 0;
	let lim = ${limit};
	if lim < 0 { gold_fail(g, "negative limit"); out.ok = false; return out; }
	var total = 0;
	for k in g.n {
		if g.res[k] >= lim {
			total++;
		}
	}
	out.i = total + mark_count_list_all_alpha;
	out.s.clear();
	format(out.s, "cntlist: ", total);
	out
}
@end
