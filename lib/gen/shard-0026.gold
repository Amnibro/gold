@entry 83c98aa202864b85
kind: step
verb: scatter
noun: island
modifier: seeded
context: env
phrase: scatter island seeded cluster amount {count}
phrase: strew seeded island field total {count}
phrase: distribute seeded island elements count {count}
slot: count int
test: count=3 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=5 r=0.0 ok=true s="sctisla" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: isla3 sphere -2,0,.5 r.4 m:matte #8a8580
expect: => doc: isla4 sphere 0,1.5,.5 r.4 m:matte #8a8580
expect: => doc: isla5 sphere 2,3,.5 r.4 m:matte #8a8580
test: count=4 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=6 r=0.0 ok=true s="sctisla" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: isla3 sphere -2,0,.5 r.4 m:matte #8a8580
expect: => doc: isla4 sphere 0,1.5,.5 r.4 m:matte #8a8580
expect: => doc: isla5 sphere 2,3,.5 r.4 m:matte #8a8580
expect: => doc: isla6 sphere 4,4.5,.5 r.4 m:matte #8a8580
test: count=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mark_scatter_island_seeded_alpha = 0;
	let cnt = ${count};
	if cnt <= 0 || cnt > 12 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var o byte[>..] = [];
	for q in cnt {
		let px = (q as real) * 2.0 - 2.0;
		let py = (q as real) * 1.5;
		o.clear();
		gold_dnews(g, "isla", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.5 r.4 m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = g.dn + mark_scatter_island_seeded_alpha;
	out.s.clear();
	format(out.s, "sctisla");
	out
}
@end
