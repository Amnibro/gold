expect: => i=11 r=0.0 ok=true s="tail max element: 11" errors=0 n=5 res=[15,4,22,8,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n > 0 && d > 0 {
		var start = g.n - d;
		if start < 0 { start = 0; }
		var i = start;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "tail max element: ", out.i);
	out
}
@end
