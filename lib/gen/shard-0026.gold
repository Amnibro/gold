fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${digit};
	var count = 0;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		if n == 0 && d == 0 {
			count++;
		}
		while n > 0 {
			if n % 10 == d {
				count++;
			}
			n /= 10;
		}
	}
	gold_push(g, count);
	g.steps += g.n * 4;
	out.i = count;
	out.s.clear();
	format(out.s, "digit matches: ", count);
	out
}
@end
