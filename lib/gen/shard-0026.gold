@entry b1543e8da585bb2e
kind: step
verb: swap
noun: primes
modifier: pairwise
context: loop
phrase: swap pairwise adjacent elements if both values are prime
phrase: exchange neighbor entries when both numbers are prime
test: list=2,3,4,5,7
expect: => i=2 r=0.0 ok=true s="prime swaps: 2" errors=0 n=5 res=[3,2,4,7,5] cache=0 hits=0
test: list=11,13,8,17,19
expect: => i=2 r=0.0 ok=true s="prime swaps: 2" errors=0 n=5 res=[13,11,8,19,17] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	return true;
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${ID}_is_prime(g.res[i]) && ${ID}_is_prime(g.res[i + 1]) {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "prime swaps: ", swaps);
	out
}
@end
