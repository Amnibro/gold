@entry 9c3cd7d838af871a
kind: step
verb: check
noun: value
modifier: safely
context: sort
phrase: check value safely target query {target}
phrase: search value safely item query {target}
slot: target int
test: list=9,3,7,1,5 target=5
expect: => i=2 r=0.0 ok=true s="found at sorted index: 2" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=10,20,30 target=25
expect: => i=-1 r=0.0 ok=false s="target absent" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
// sort step check value safely
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var low = 0;
	var high = g.n - 1;
	var found = -1;
	while low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == tg {
			found = mid;
			break;
		} else if g.res[mid] < tg {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	out.ok = (found >= 0);
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found at sorted index: ", found);
	} else {
		format(out.s, "target absent");
	}
	out
}
@end
