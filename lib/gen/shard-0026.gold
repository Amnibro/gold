code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mapped = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) { break; }
		var n = if x < 0 { -x } else { x };
		var dsum = 0;
		while n > 0 {
			dsum += n % 10;
			n = n / 10;
		}
		g.res[i] = dsum;
		mapped++;
	}
	out.i = mapped;
	out.s.clear();
	format(out.s, "mapped digits count: ", mapped);
	out
}
@end
