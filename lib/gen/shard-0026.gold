code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	if g.n == 0 { out.ok = false; return out; }
	var max_i = 0;
	for i in g.n {
		if g.res[i] > g.res[max_i] { max_i = i; }
	}
	let max_val = g.res[max_i];
	if max_val <= bound {
		let tmp = g.res[max_i];
		g.res[max_i] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum swapped up to bound: ", max_val);
	out
}
@end
