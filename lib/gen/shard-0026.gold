phrase: recursive pair joining cache hash
test: arg=1234,45
expect: 1066
expect: 45
test: arg=0
expect: 0
code:
fn ${ID}(n int) int {
	let salt_join_pairs_recursively = 0;
	var x = if n < 0 { -n } else { n };
	var acc = 0;
	while x > 0 {
		let p = x % 100;
		acc = (acc * 31 + p) % 10007;
		x /= 100;
	}
	acc + salt_join_pairs_recursively
}
@end
