@entry 51e11f67175e1645
kind: step
verb: limit
noun: histogram
modifier: in_reverse
context: core
phrase: limit histogram in reverse order to cap {cap}
phrase: clamp reverse histogram frequencies to cap {cap}
slot: cap int
test: list=3,3,3,3,2,2,1 cap=2
expect: => i=5 r=0.0 ok=true s="reverse histogram limited" errors=0 n=5 res=[3,3,2,2,1] cache=0 hits=0
test: list=5,5,5,4 cap=1
expect: => i=2 r=0.0 ok=true s="reverse histogram limited" errors=0 n=2 res=[5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c <= 0 {
		gold_fail(g, "invalid cap");
		out.ok = false;
		return out;
	}
	var keys = [0; 128];
	var counts = [0; 128];
	var kn = 0;
	var w = 0;
	var k = g.n - 1;
	var temp = [0; 512];
	while k >= 0 {
		let x = g.res[k];
		var idx = -1;
		for i in kn {
			if keys[i] == x { idx = i; break; }
		}
		if idx >= 0 {
			if counts[idx] < c {
				counts[idx]++;
				temp[w] = x;
				w++;
			}
		} else {
			keys[kn] = x;
			counts[kn] = 1;
			kn++;
			temp[w] = x;
			w++;
		}
		k--;
	}
	for i in w {
		g.res[i] = temp[w - 1 - i];
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "reverse histogram limited");
	out
}
@end
