@entry ec610c384d8a412e
kind: step
verb: sort
noun: gaps
modifier: nested
context: format
phrase: sort nested gap differences ascending
phrase: order nested interval gaps smallest first
test: list=10,12,18,21
expect: => i=3 r=0.0 ok=true s="2,3,6" errors=0 n=4 res=[10,12,18,21] cache=0 hits=0
test: list=5,15,18
expect: => i=2 r=0.0 ok=true s="3,10" errors=0 n=3 res=[5,15,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gaps int[256] = [0; 256];
	var gn = 0;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		gaps[gn] = diff;
		gn++;
		i++;
	}
	var a = 0;
	while a < gn {
		var min_idx = a;
		var b = a + 1;
		while b < gn {
			if gaps[b] < gaps[min_idx] { min_idx = b; }
			b++;
		}
		if min_idx != a {
			let tmp = gaps[a]; gaps[a] = gaps[min_idx]; gaps[min_idx] = tmp;
		}
		a++;
	}
	out.s.clear();
	var k = 0;
	while k < gn {
		if k > 0 { out.s.push(','); }
		format(out.s, gaps[k]);
		k++;
	}
	out.i = gn;
	out
}
@end
