fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var converted = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b >= 97 && b <= 122 {
			out.s[i] = (b - 32) as byte;
			converted++;
		}
	}
	g.steps += out.s.len;
	out.i = converted;
	out
}
@end
