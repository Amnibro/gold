fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = [0; 512];
	var pn = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
				pairs[pn] = g.res[i] + g.res[i + 1];
				pn++;
			}
			i++;
		}
	}
	gold_clear(g);
	for i in pn { gold_push(g, pairs[i]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "even pairs: ", pn);
	out
}
@end
