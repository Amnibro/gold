code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var folds = 0;
	var changed = true;
	while changed && folds < 50 {
		changed = false;
		for k in g.n {
			if g.res[k] > lim {
				g.res[k] = lim;
				folds++;
				changed = true;
			}
		}
	}
	out.i = folds;
	out.s.clear();
	format(out.s, "maximum folds: ", folds);
	out
}
@end
