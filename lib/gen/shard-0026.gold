expect: => i=2 r=0.0 ok=true s="duplicate pairs: 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
// sort step pair duplicates none
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var dupes = [0; 512];
	var dn = 0;
	var i = 0;
	while i + 1 < g.n && dn < lim {
		if g.res[i] == g.res[i + 1] {
			dupes[dn] = g.res[i];
			dn++;
			i += 2;
		} else {
			i++;
		}
	}
	gold_clear(g);
	for k in dn { gold_push(g, dupes[k]); }
	g.steps += dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "duplicate pairs: ", dn);
	out
}
@end
