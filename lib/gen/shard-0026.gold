code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_gap = 0;
	var i = g.n - 1;
	while i > 0 {
		let gap = g.res[i - 1] - g.res[i];
		if gap > max_gap { max_gap = gap; }
		i--;
	}
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "maximum descending gap ", max_gap);
	out
}
@end
