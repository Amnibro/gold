test: list=10,20,30,40,50 radius=1
expect: => i=5 r=0.0 ok=true s="middle reversed: 5" errors=0 n=5 res=[10,40,30,20,50] cache=0 hits=0
code:
// sort step reverse middle sorted
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rad = ${radius};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	let mid = g.n / 2;
	var left = mid - rad;
	var right = mid + rad;
	if left < 0 { left = 0; }
	if right >= g.n { right = g.n - 1; }
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "middle reversed: ", g.n);
	out
}
@end
