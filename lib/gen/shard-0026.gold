slot: threshold int
test: list=1,1,2,3,3,3 threshold=5
expect: => i=5 r=0.0 ok=true s="single runs dropped" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
test: list=7,8,8,9 threshold=10
