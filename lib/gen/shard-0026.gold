@entry cbac2601f60a68ea
kind: step
verb: dedupe
noun: average
modifier: up_to
context: math
phrase: dedupe average up to ceiling value {cap}
phrase: filter average up to boundary limit {cap}
slot: cap int
test: list=2,2,4,4,6,6,8 cap=5
expect: => i=3 r=0.0 ok=true s="deduped average: 3" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,10,20,20,30 cap=15
expect: => i=10 r=0.0 ok=true s="deduped average: 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	if g.n == 0 { return out; }
	var w = 1;
	var r = 1;
	while r < g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
		r++;
	}
	g.n = w;
	var sum = 0;
	var count = 0;
	for k in g.n {
		if g.res[k] <= ceiling {
			sum += g.res[k];
			count++;
		}
	}
	let avg = if count > 0 { sum / count } else { 0 };
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "deduped average: ", avg);
	out
}
@end
