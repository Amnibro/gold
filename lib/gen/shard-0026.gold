@entry a7740c6c3ad0a887
kind: step
verb: fold
noun: maximum
modifier: last
context: search
phrase: fold maximum last bounded by {limit}
phrase: accumulate tail maximum under {limit}
slot: limit int
test: list=12,45,23,67,34 limit=50
expect: => i=45 r=0.0 ok=true s="tail max: 45" errors=0 n=6 res=[12,45,23,67,34,45] cache=0 hits=0
test: list=80,90,10 limit=50
expect: => i=10 r=0.0 ok=true s="tail max: 10" errors=0 n=4 res=[80,90,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_val = -1;
	var found = false;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if x <= lim && x > max_val {
			max_val = x;
			found = true;
		}
		i--;
	}
	if found {
		out.i += max_val;
		gold_push(g, out.i);
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "tail max: ", max_val);
	} else {
		format(out.s, "none below limit");
	}
	out
}
@end
