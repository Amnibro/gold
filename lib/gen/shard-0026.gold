kind: step
verb: search
noun: counter
modifier: recursively
context: retry
phrase: search counter recursively with retry depth {depth}
phrase: probe counter progression recursively under retry limit {depth}
slot: depth int
test: list=10,20,30,40,50 depth=3
expect: => i=2 r=0.0 ok=true s="counter searched recursive" errors=0 n=6 res=[10,20,30,40,50,2] cache=0 hits=0
test: list=2,4 depth=1
expect: => i=-1 r=0.0 ok=true s="counter searched recursive" errors=0 n=3 res=[2,4,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var target = 30;
	var low = 0;
	var high = g.n - 1;
	var found = -1;
	var hops = 0;
	while hops < d && low <= high {
		let mid = (low + high) / 2;
		if g.res[mid] == target {
			found = mid;
			break;
		} else if g.res[mid] < target {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
		hops++;
	}
	gold_push(g, found);
	g.steps += hops + 1;
	out.i = found;
	out.s.clear();
	format(out.s, "counter searched recursive");
	out
}
@end
