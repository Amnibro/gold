@entry d26d1d12f5edeba0
kind: step
verb: run
noun: suffix
modifier: while
context: core
phrase: run suffix while values exceed threshold {threshold}
phrase: collect suffix elements while exceeding threshold {threshold}
slot: threshold int
test: list=5,20,30,40 threshold=15
expect: => i=3 r=0.0 ok=true s="suffix preserved" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=2,4,12,16 threshold=10
expect: => i=2 r=0.0 ok=true s="suffix preserved" errors=0 n=2 res=[12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var start_idx = g.n;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] > th {
			start_idx = k;
		} else {
			break;
		}
		k--;
	}
	var w = 0;
	var idx = start_idx;
	while idx < g.n {
		g.res[w] = g.res[idx];
		w++;
		idx++;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "suffix preserved");
	out
}
@end
@entry 3ad2b4b0c87c5aeb
kind: step
verb: fill
noun: steps
modifier: with_retry
context: core
phrase: fill steps with retry limit {attempts}
phrase: interpolate sequence steps within retry bound {attempts}
slot: attempts int
test: list=10,25 attempts=3
expect: => i=5 r=0.0 ok=true s="steps interpolated with retry" errors=0 n=5 res=[10,13,17,21,25] cache=0 hits=0
test: list=4,16 attempts=2
expect: => i=4 r=0.0 ok=true s="steps interpolated with retry" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	if g.n < 2 {
		gold_fail(g, "too few elements");
		out.ok = false;
		return out;
	}
	let first_v = g.res[0];
	let last_v = g.res[1];
	gold_clear(g);
	gold_push(g, first_v);
	var step = 1;
	while step <= att {
		let interp = first_v + ((last_v - first_v) * step) / (att + 1);
		gold_push(g, interp);
		step++;
	}
	gold_push(g, last_v);
	out.i = g.n;
	out.s.clear();
	format(out.s, "steps interpolated with retry");
	out
}
@end
@entry 0024b19117ee503a
kind: step
verb: cache
noun: average
modifier: recursively
context: core
phrase: cache average recursively to depth {depth}
phrase: record average recursively with cache depth {depth}
slot: depth int
test: list=10,20,30,40 depth=3
expect: => i=5 r=0.0 ok=true s="average cached recursively" errors=0 n=5 res=[10,20,30,40,5] cache=3 hits=0
test: list=50,100 depth=2
expect: => i=19 r=0.0 ok=true s="average cached recursively" errors=0 n=3 res=[50,100,19] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 || d <= 0 {
		gold_fail(g, "empty list or invalid depth");
		out.ok = false;
		return out;
	}
	var cur_avg = 0;
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	cur_avg = sum / g.n;
	var step = 0;
	while step < d {
		gold_cache_put(g, step, cur_avg);
		cur_avg = (cur_avg + step * 2) / 2;
		step++;
	}
	gold_push(g, cur_avg);
	g.steps += step;
	out.i = cur_avg;
	out.s.clear();
	format(out.s, "average cached recursively");
	out
}
@end
