@entry 37265e6122ee8550
kind: step
verb: dedupe
noun: items
modifier: between
context: math
phrase: dedupe items between window {left_pos} to {right_pos}
phrase: filter items between range {left_pos} through {right_pos}
slot: left_pos int
slot: right_pos int
test: list=1,2,2,3,3,4 left_pos=1 right_pos=4
expect: => i=4 r=0.0 ok=true s="deduped range size: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,6,6,7,7 left_pos=0 right_pos=3
expect: => i=4 r=0.0 ok=true s="deduped range size: 4" errors=0 n=4 res=[5,6,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${left_pos};
	let r = ${right_pos};
	if l >= 0 && r < g.n && l < r {
		var w = l + 1;
		var i = l + 1;
		while i <= r {
			if g.res[i] != g.res[w - 1] {
				g.res[w] = g.res[i];
				w++;
			}
			i++;
		}
		let diff = (r + 1) - w;
		if diff > 0 {
			var k = r + 1;
			while k < g.n {
				g.res[k - diff] = g.res[k];
				k++;
			}
			g.n = g.n - diff;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped range size: ", g.n);
	out
}
@end
