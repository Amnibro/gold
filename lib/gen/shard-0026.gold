			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.28); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bark");
	out
}
