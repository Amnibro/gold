	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += bound * bound;
	out.i = if bound > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "sorted prefix head: ", out.i);
	out
}
