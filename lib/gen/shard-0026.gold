fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	let s = ${sub};
	var replaced = 0;
	for i in g.n {
		if g.res[i] == t {
			g.res[i] = s;
			replaced++;
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "replaced ", replaced, " numbers");
	out
}
@end
