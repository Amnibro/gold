@entry 865e43fb793d42f2
kind: step
verb: scale
noun: errors
modifier: until
context: sort
phrase: scale errors until tolerance budget {budget}
phrase: adjust errors until threshold budget {budget}
slot: budget int
test: list=5,1,4,2,8 budget=1
expect: => i=1 r=0.0 ok=true s="remaining errors: 1" errors=0 n=5 res=[1,4,2,5,8] cache=0 hits=0
test: list=9,7,5,3 budget=2
expect: => i=1 r=0.0 ok=true s="remaining errors: 1" errors=0 n=4 res=[5,3,7,9] cache=0 hits=0
code:
// sort step scale errors until
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bg = ${budget};
	var errs = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] { errs++; }
				j++;
			}
		}
	}
	var passes = 0;
	while errs > bg && passes < g.n {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
		}
		errs = 0;
		for i in g.n - 1 {
			var j = i + 1;
			while j < g.n {
				if g.res[i] > g.res[j] { errs++; }
				j++;
			}
		}
		passes++;
	}
	g.steps += passes;
	out.i = errs;
	out.s.clear();
	format(out.s, "remaining errors: ", errs);
	out
}
@end
