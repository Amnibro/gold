code:
// sort step select history unique
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var uniq = [0; 512];
	var un = 0;
	var i = 0;
	while i < g.n && un < lim {
		if un == 0 || g.res[i] != uniq[un - 1] {
			uniq[un] = g.res[i];
			un++;
		}
		i++;
	}
	gold_clear(g);
	for k in un { gold_push(g, uniq[k]); }
	out.i = un;
	out.s.clear();
	format(out.s, "unique history: ", un);
	out
}
@end
