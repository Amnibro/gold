kind: step
verb: dedupe
noun: values
modifier: in_reverse
context: compare
phrase: dedupe values in reverse keeping boundary {limit}
phrase: remove duplicate values backward under limit {limit}
phrase: purge repeat items in reverse with ceiling {limit}
slot: limit int
test: list=3,5,3,7,5,9 limit=10
expect: => i=4 r=0.0 ok=true s="reverse deduped: 4" errors=0 n=4 res=[9,5,7,3] cache=0 hits=0
test: list=1,2,3,4 limit=10
expect: => i=4 r=0.0 ok=true s="reverse deduped: 4" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var seen = [0; 64];
	var sn = 0;
	var w = 0;
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		var found = false;
		for s in sn { if seen[s] == x { found = true; break; } }
		if !found && sn < 64 && x <= lim {
			seen[sn] = x;
			sn++;
		}
		k--;
	}
	for i in sn { g.res[i] = seen[i]; }
	g.n = sn;
	out.i = sn;
	out.s.clear();
	format(out.s, "reverse deduped: ", sn);
	out
}
@end
