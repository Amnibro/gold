fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = v.s.len;
	var distinct = 0;
	var i = 0;
	while i < len {
		var seen = false;
		var j = 0;
		while j < i {
			if v.s[i] == v.s[j] {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			distinct++;
		}
		i++;
	}
	g.steps += len;
	out.i = distinct;
	out.s.clear();
	format(out.s, "distinct letters: ", distinct);
	out
}
@end
