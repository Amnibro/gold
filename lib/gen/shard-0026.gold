@entry 1ec60f763cbaa88c
kind: step
verb: rotate
noun: runs
modifier: each
context: search
phrase: rotate runs each segment offset {shift}
phrase: cycle match run segments each {shift}
slot: shift int
test: list=1,2,2,3,4,4,4 shift=1
expect: => i=2 r=0.0 ok=true s="runs modified: 2" errors=0 n=7 res=[1,2,2,3,4,4,4] cache=0 hits=0
test: list=5,5,6,7,7 shift=1
expect: => i=2 r=0.0 ok=true s="runs modified: 2" errors=0 n=5 res=[5,5,6,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var runs_count = 0;
	var i = 0;
	while i < g.n {
		let start = i;
		while i + 1 < g.n && g.res[i + 1] == g.res[start] {
			i++;
		}
		let len = i - start + 1;
		if len > 1 {
			runs_count++;
			let first = g.res[start];
			for k in (len - 1) {
				g.res[start + k] = g.res[start + k + 1];
			}
			g.res[start + len - 1] = first;
		}
		i++;
	}
	g.steps += g.n;
	out.i = runs_count;
	out.s.clear();
	format(out.s, "runs modified: ", runs_count);
	out
}
@end
