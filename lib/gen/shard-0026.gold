// sort step swap item recursively
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var passes = 0;
	var swaps = 0;
	while passes < d && passes < g.n {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i++;
		}
		passes++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps completed: ", swaps);
	out
}
@end
