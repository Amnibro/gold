test: img=16 c=4
expect: => i=256 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=32640 hash=987058
test: img=32 c=8
expect: => i=1024 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=130560 hash=774075
test: c=4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	// texture step mottle tiles layered
	if ${c} < 1 { gold_fail(g, "cell must be positive"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c} + y / ${c}) % 2) as real;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	if 4 < 2 || 4 > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
