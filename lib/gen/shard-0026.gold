@entry a365efd4f6441262
kind: step
verb: swap
noun: value
modifier: while
context: loop
phrase: swap adjacent values while exceeding cutoff threshold {cutoff}
phrase: exchange neighbor items while larger than cutoff bound {cutoff}
slot: cutoff int
test: list=50,60,20,80,90 cutoff=40
expect: => i=2 r=0.0 ok=true s="swapped while: 2" errors=0 n=5 res=[60,50,20,90,80] cache=0 hits=0
test: list=10,70,80,30,95 cutoff=60
expect: => i=1 r=0.0 ok=true s="swapped while: 1" errors=0 n=5 res=[10,80,70,30,95] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > cut && g.res[i + 1] > cut {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped while: ", swaps);
	out
}
@end
