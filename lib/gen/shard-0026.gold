fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_shift};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	var shift_val = total;
	if shift_val > ms { shift_val = ms; }
	for i in g.n { g.res[i] += shift_val; }
	out.i = shift_val;
	out.s.clear();
	format(out.s, "shifted total: ", shift_val);
	out
}
