fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var best = -1;
	for i in g.n {
		let x = g.res[i];
		if x <= b && (best < 0 || x > best) {
			best = x;
		}
	}
	out.i = best;
	out.s.clear();
	format(out.s, "found limit: ", best);
	out
}
@end
