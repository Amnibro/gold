		o.append(",");
		gold_fnum(o, py);
		o.append(",.5 r.4 m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = g.dn + mark_scatter_bushes_sparse_alpha;
	out.s.clear();
	format(out.s, "sctbush");
	out
}
@end
