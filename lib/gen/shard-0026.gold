test: list=2,3,4 steps=1
expect: => i=1 r=0.0 ok=true s="squared rotated: 1" errors=0 n=3 res=[16,4,9] cache=0 hits=0
test: list=1,5,2 steps=2
expect: => i=2 r=0.0 ok=true s="squared rotated: 2" errors=0 n=3 res=[25,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${steps};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	for i in g.n {
		g.res[i] = g.res[i] * g.res[i];
	}
	var rot = st % g.n;
	if rot < 0 { rot += g.n; }
	var tmp = [0; 512];
	for i in g.n {
		let dest = (i + rot) % g.n;
		tmp[dest] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n * 2;
	out.i = rot;
	out.s.clear();
	format(out.s, "squared rotated: ", rot);
	out
}
@end
