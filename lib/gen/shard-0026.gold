noun: gaps
modifier: at_most
context: stats
phrase: pair adjacent gaps at most {max_gap}
phrase: tally gap spans at most {max_gap}
slot: max_gap int
test: list=10,14,20,22 max_gap=5
expect: => i=2 r=0.0 ok=true s="paired 2 gaps at most limit" errors=0 n=4 res=[10,14,20,22] cache=0 hits=0
