fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	gold_words_of(g, v.s);
	out.s.clear();
	var kept = 0;
	for i in g.wn {
		if g.wl[i].len <= lim {
			if kept > 0 { out.s.push(' '); }
			for b in g.wl[i] { out.s.push(b); }
			kept++;
		}
	}
	g.steps += g.wn;
	out.i = kept;
	out
}
@end
