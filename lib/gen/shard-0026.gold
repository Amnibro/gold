	let tl = ${tail_len};
	let span = if tl < g.n { tl } else { g.n };
	var sum = 0;
	for k in span { sum += g.res[g.n - 1 - k]; }
	out.i = sum;
	out.s.clear();
	format(out.s, "tail sum: ", sum);
