@entry 325547123b257847
kind: step
verb: cache
noun: average
modifier: sorted
context: aggregate
phrase: cache average sorted sequence under {key_id}
phrase: store average sorted elements using {key_id}
slot: key_id int
test: list=9,3,7,1 key_id=42
expect: => i=5 r=0.0 ok=true s="cached sorted average: 5" errors=0 n=4 res=[1,3,7,9] cache=1 hits=0
test: list=20,10,30 key_id=99
expect: => i=20 r=0.0 ok=true s="cached sorted average: 20" errors=0 n=3 res=[10,20,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let kid = ${key_id};
	if g.n == 0 {
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	gold_cache_put(g, kid, avg);
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "cached sorted average: ", avg);
	out
}
@end
