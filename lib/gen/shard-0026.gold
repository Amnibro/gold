code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var written = 0;
	var last_avg = -999999;
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		let cur_avg = sum / (i + 1);
		if cur_avg != last_avg {
			if written > 0 { out.s.push(','); }
			format(out.s, cur_avg);
			written++;
			last_avg = cur_avg;
		}
		i++;
	}
	out.i = written;
	out
}
@end
