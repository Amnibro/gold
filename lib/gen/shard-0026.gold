code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${step_size};
	var sum = 0;
	if step > 0 && g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			sum += g.res[i];
			i -= step;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reverse stride sum: ", sum);
	out
}
@end
