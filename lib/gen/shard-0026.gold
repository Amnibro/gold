phrase: record consecutive window sums with span {span}
slot: span int
test: list=1,2,3,4,5 span=2
expect: => i=4 r=0.0 ok=true s="measured 4 windows" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30,40 span=3
expect: => i=2 r=0.0 ok=true s="measured 2 windows" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 0 || g.n < w {
		gold_fail(g, "invalid window span");
		out.ok = false;
		return out;
	}
	let num_windows = g.n - w + 1;
	var tmp int[512] = [0; 512];
	for i in num_windows {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		tmp[i] = sum;
	}
	for i in num_windows {
		g.res[i] = tmp[i];
	}
	g.steps += num_windows * w;
	g.n = num_windows;
	out.i = num_windows;
	out.s.clear();
	format(out.s, "measured ", num_windows, " windows");
	out
}
@end
