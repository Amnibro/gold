expect: => i=2 r=0.0 ok=true s="series rotated head: 2" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shifts};
	if g.n > 1 && s > 0 {
		var step_cnt = s % g.n;
		var r = 0;
		while r < step_cnt {
			let first = g.res[0];
			var i = 0;
			while i + 1 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
			r++;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "series rotated head: ", out.i);
	out
}
@end
