@entry 06ba37ecd00dced9
kind: step
verb: rotate
noun: text
modifier: times
context: format
phrase: rotate text string times offset {count}
phrase: cycle text characters by step {count}
slot: count int
test: text="abcdef" count=2
expect: => i=2 r=0.0 ok=true s="cdefab" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" count=1
expect: => i=1 r=0.0 ok=true s="elloh" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${count};
	let len = out.s.len;
	if len <= 1 || off <= 0 { return out; }
	let shift = off % len;
	var tmp byte[..200] = [];
	var i = 0;
	while i < len {
		let idx = (i + shift) % len;
		tmp.push(out.s[idx]);
		i++;
	}
	out.s.clear();
	out.s.append(tmp);
	out.i = shift;
	out
}
@end
