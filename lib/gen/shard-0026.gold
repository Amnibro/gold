@entry 7d567d348c1ca9e4
kind: step
verb: pair
noun: tally
modifier: at_most
context: transform
phrase: pair tally sums capped at most {limit}
phrase: couple adjacent tally sums up to bound {limit}
slot: limit int
test: list=4,6,8,10 limit=12
expect: => i=22 r=0.0 ok=true s="paired tally sum: 22" errors=0 n=2 res=[10,12] cache=0 hits=0
test: list=1,2,3,4 limit=5
expect: => i=8 r=0.0 ok=true s="paired tally sum: 8" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 {
		gold_fail(g, "too few elements to pair");
		out.ok = false;
		return out;
	}
	let pairs = g.n / 2;
	var total = 0;
	for i in pairs {
		var s = g.res[i * 2] + g.res[i * 2 + 1];
		if s > lim { s = lim; }
		g.res[i] = s;
		total += s;
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = total;
	out.s.clear();
	format(out.s, "paired tally sum: ", total);
	out
}
@end
