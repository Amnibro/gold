code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			g.res[k] = cached;
		} else {
			let shifted = x + off;
			gold_cache_put(g, x, shifted);
			g.res[k] = shifted;
		}
	}
	g.steps += g.n;
	out.i = off;
	out.s.clear();
	format(out.s, "function shifted with cache");
	out
}
@end
