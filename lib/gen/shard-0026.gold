kind: step
verb: limit
noun: tally
modifier: nested
context: transform
phrase: limit tally nested duplicate counts to {max_occ}
phrase: restrict duplicate occurrences to at most {max_occ}
phrase: cap frequency of nested elements by {max_occ}
slot: max_occ int
test: list=2,2,2,3,3,4,4,4,4 max_occ=2
expect: => i=6 r=0.0 ok=true s="retained 6 items under tally limit" errors=0 n=6 res=[2,2,3,3,4,4] cache=0 hits=0
test: list=5,5,5,5,6,6 max_occ=1
expect: => i=2 r=0.0 ok=true s="retained 2 items under tally limit" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_limit_tally_nested = 0;
	let mo = ${max_occ};
	var filtered int[512] = [0; 512];
	var fn_len = 0;
	for i in g.n {
		let x = g.res[i];
		var occ = 0;
		for j in fn_len {
			if filtered[j] == x { occ++; }
		}
		if occ < mo {
			filtered[fn_len] = x;
			fn_len++;
		}
	}
	for i in fn_len { g.res[i] = filtered[i]; }
	g.n = fn_len;
	g.steps += fn_len + mark_transform_limit_tally_nested;
	out.i = fn_len;
	out.s.clear();
	format(out.s, "retained ", fn_len, " items under tally limit");
	out
}
@end
