code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift_by};
	if g.n > 1 {
		let shift = (s % g.n + g.n) % g.n;
		var temp = [0; 512];
		for i in g.n {
			let src = (i + shift) % g.n;
			temp[i] = g.res[src];
		}
		for i in g.n { g.res[i] = temp[i]; }
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted list length: ", g.n);
	out
}
@end
