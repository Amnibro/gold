modifier: at_most
context: core
phrase: fill prefix at most count {count}
phrase: prepend prefix elements at most count {count}
slot: count int
test: list=8,9 count=3
expect: => i=5 r=0.0 ok=true s="prefix filled" errors=0 n=5 res=[1,2,3,8,9] cache=0 hits=0
test: list=15,20 count=2
expect: => i=4 r=0.0 ok=true s="prefix filled" errors=0 n=4 res=[1,2,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 {
		gold_fail(g, "invalid prefix count");
		out.ok = false;
		return out;
	}
	let orig_n = g.n;
	var k = orig_n - 1;
	while k >= 0 {
		g.res[k + cnt] = g.res[k];
		k--;
	}
	for i in cnt {
		g.res[i] = i + 1;
	}
	g.n = orig_n + cnt;
	g.steps += cnt;
	out.i = g.n;
	out.s.clear();
	format(out.s, "prefix filled");
	out
}
@end
