code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	gold_mclear(g);
	var stop_val = -1;
	for i in g.n {
		let x = g.res[i];
		gold_madd(g, x, 1);
		let cnt, _ = gold_mget(g, x);
		if cnt >= mf {
			stop_val = x;
			break;
		}
	}
	out.i = stop_val;
	out.s.clear();
	format(out.s, "stopped at item: ", stop_val);
	out
