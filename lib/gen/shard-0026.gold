slot: offset int
test: list=2,4,6,8 offset=3
expect: => i=20 r=0.0 ok=true s="total shifted: 20" errors=0 n=4 res=[8,2,4,6] cache=0 hits=0
test: list=10,20 offset=1
expect: => i=30 r=0.0 ok=true s="total shifted: 30" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 { return out; }
	let shift = off % g.n;
	var tot = 0;
	for k in g.n { tot += g.res[k]; }
	for _ in shift {
		let first = g.res[0];
		for k in g.n - 1 { g.res[k] = g.res[k + 1]; }
		g.res[g.n - 1] = first;
	}
	out.i = tot;
	out.s.clear();
	format(out.s, "total shifted: ", tot);
	out
}
@end
