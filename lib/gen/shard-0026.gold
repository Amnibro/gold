expect: => i=5 r=0.0 ok=true s="shifted by 1" errors=0 n=4 res=[35,5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_shift_sequence_with_cache = 0;
	let k = ${shift_by};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let head = g.res[0];
	gold_cache_put(g, mark_transform_shift_sequence_with_cache, head);
	var tmp int[512] = [0; 512];
	for i in g.n {
		let new_pos = (i + k) % g.n;
		tmp[new_pos] = g.res[i];
	}
	for i in g.n { g.res[i] = tmp[i]; }
	g.steps += g.n;
	out.i = head;
	out.s.clear();
	format(out.s, "shifted by ", k);
	out
}
@end
