code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${multiplier};
	var seen = [0; 256];
	var u = 0;
	for k in g.n {
		let x = g.res[k];
		var found = false;
		for j in u {
			if seen[j] == x { found = true; break; }
		}
		if !found {
			seen[u] = x;
			u++;
		}
	}
	for j in u {
		seen[j] = seen[j] * mul;
		g.res[j] = seen[j];
	}
	g.n = u;
	g.steps += u;
	out.i = u;
	out.s.clear();
	format(out.s, "unique values transformed");
	out
}
@end
