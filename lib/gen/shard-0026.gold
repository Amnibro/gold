code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let left = ${left_char} as byte;
	let right = ${right_char} as byte;
	var start = -1;
	var stop = -1;
	var i = 0;
	while i < v.s.len {
		if start == -1 && v.s[i] == left {
			start = i + 1;
		} else if start != -1 && v.s[i] == right {
			stop = i;
			break;
		}
		i++;
	}
	var count = 0;
	if start != -1 && stop != -1 && stop >= start {
		count = stop - start;
	}
	g.steps += v.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "text between chars len: ", count);
	out
}
@end
