@entry 3f32bf91de2cfee4
kind: step
verb: keep
noun: sequence
modifier: between
context: stats
phrase: keep sequence slice between indices {first_idx} to {last_idx}
phrase: extract sequence slice between indices {first_idx} to {last_idx}
slot: first_idx int
slot: last_idx int
test: list=10,20,30,40,50 first_idx=1 last_idx=3
expect: => i=3 r=0.0 ok=true s="retained sequence slice of 3 items" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=5,15,25,35 first_idx=0 last_idx=2
expect: => i=3 r=0.0 ok=true s="retained sequence slice of 3 items" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var a = ${first_idx};
	var b = ${last_idx};
	if a < 0 { a = 0; }
	if b >= g.n { b = g.n - 1; }
	if a > b {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty slice");
		return out;
	}
	let len = b - a + 1;
	for k in len {
		g.res[k] = g.res[a + k];
	}
	g.steps += len;
	g.n = len;
	out.i = len;
	out.s.clear();
	format(out.s, "retained sequence slice of ", len, " items");
	out
}
@end
