fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 {
		gold_fail(g, "invalid bucket width");
		out.ok = false;
		return out;
	}
	var bins = [0; 32];
	for k in g.n {
