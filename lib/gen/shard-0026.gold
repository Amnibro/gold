@entry 4d5807d0504dfd02
kind: step
verb: split
noun: primes
modifier: pairwise
context: core
phrase: split primes pairwise separate composite pairs
phrase: divide primes pairwise partition composite values
test: list=2,4,5,6,7,8,9
expect: => i=3 r=0.0 ok=true s="primes separated: 3" errors=0 n=7 res=[2,5,7,4,6,8,9] cache=0 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="primes separated: 2" errors=0 n=4 res=[11,13,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = [0; 512];
	var comp = [0; 512];
	var pn = 0;
	var cn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			primes[pn] = x;
			pn++;
		} else {
			comp[cn] = x;
			cn++;
		}
	}
	gold_clear(g);
	for i in pn { gold_push(g, primes[i]); }
	for i in cn { gold_push(g, comp[i]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "primes separated: ", pn);
	out
}
@end
@entry 949c61b0e8976417
kind: step
verb: compare
noun: words
modifier: any
context: core
phrase: compare words any matching keyword {target}
