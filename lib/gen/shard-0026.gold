fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needle = ${target};
	var idx = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == needle { idx = i; break; }
		i++;
	}
	out.ok = idx >= 0;
	out.i = idx;
	out.s.clear();
	if out.ok {
		gold_cache_put(g, needle, idx);
		format(out.s, "found at index ", idx);
	} else {
		format(out.s, "target not found");
	}
	out
}
@end
