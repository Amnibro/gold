expect: => i=2 r=0.0 ok=true s="unique under cutoff: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var unique = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		if x < cut {
			var exists = false;
			for k in un {
				if unique[k] == x { exists = true; break; }
			}
			if !exists {
				unique[un] = x;
				un++;
			}
		}
	}
	gold_clear(g);
	for i in un { gold_push(g, unique[i]); }
	out.i = un;
	out.s.clear();
	format(out.s, "unique under cutoff: ", un);
	out
}
@end
