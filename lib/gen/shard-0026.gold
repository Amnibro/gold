// sort step select number at_least
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var kept = [0; 512];
	var kn = 0;
	for i in g.n {
		if g.res[i] >= th {
			kept[kn] = g.res[i];
			kn++;
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "selected items: ", kn);
	out
}
@end
