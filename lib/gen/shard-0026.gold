// sort step scan histogram last
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var last_val = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] <= cut {
			last_val = g.res[i];
			break;
		}
		i--;
	}
	out.i = last_val;
	out.s.clear();
	format(out.s, "last histogram value: ", last_val);
	out
}
@end
