test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.095 max=0.984 sum8=31309 hash=598461
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.027 max=1 sum8=137299 hash=57394
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 2) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t_1 = 0.0;
			for dy in 3 { for dx in 3 { t_1 += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_1[y * g.iw + x] = t_1 / 9.0;
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
