		}
		g.res[g.n - 1] = first;
		pass++;
	}
	g.steps += pass;
	out.i = pass;
	out.s.clear();
	format(out.s, "condition any rotated");
	out
}
@end
@entry 4920463e7894257f
kind: step
verb: clamp
noun: item
modifier: every_other
context: retry
phrase: clamp item every other index with retry quota {retries}
phrase: bound alternating item elements within retry allowance {retries}
slot: retries int
test: list=80,5,90,8,70 retries=2
expect: => i=3 r=0.0 ok=true s="alternating clamped" errors=0 n=5 res=[50,5,50,8,50] cache=0 hits=0
test: list=10,20,30 retries=1
expect: => i=0 r=0.0 ok=true s="alternating clamped" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var pass = 0;
	var clamped = 0;
	while pass < max_r {
		var k = 0;
		while k < g.n {
			if g.res[k] > 50 {
				g.res[k] = 50;
				clamped++;
			}
			k += 2;
		}
		pass++;
	}
	g.steps += pass;
	out.i = clamped;
	out.s.clear();
	format(out.s, "alternating clamped");
	out
}
@end
@entry 9446e48ad6874bd8
kind: step
verb: return
noun: cache
modifier: nested
context: retry
phrase: return cache nested lookups with retry depth {depth}
phrase: retrieve nested cache values under retry ceiling {depth}
slot: depth int
test: input=10 depth=3
expect: => i=16 r=0.0 ok=true s="nested cache resolved" errors=0 n=1 res=[16] cache=3 hits=3
test: input=20 depth=1
expect: => i=22 r=0.0 ok=true s="nested cache resolved" errors=0 n=1 res=[22] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var key = out.i;
	var step = 0;
	while step < d {
		gold_cache_put(g, key, key + 2);
		let nxt, ok = gold_cache_get(g, key);
		if ok {
			key = nxt;
		}
		step++;
	}
	gold_push(g, key);
	g.steps += step;
	out.i = key;
	out.s.clear();
	format(out.s, "nested cache resolved");
	out
}
@end
@entry 46220320d3e60d65
kind: step
verb: filter
noun: checkpoint
modifier: while
context: retry
phrase: filter checkpoint while active with retry attempts {retries}
phrase: purge checkpoint entries while valid under retry limit {retries}
slot: retries int
test: list=12,50,8,75,4 retries=3
expect: => i=2 r=0.0 ok=true s="checkpoints filtered" errors=0 n=3 res=[12,8,4] cache=0 hits=0
test: list=1,2,3 retries=2
expect: => i=0 r=0.0 ok=true s="checkpoints filtered" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var pass = 0;
	var removed = 0;
	while pass < max_r {
		var w = 0;
		for k in g.n {
			if g.res[k] >= 20 {
				removed++;
			} else {
				g.res[w] = g.res[k];
				w++;
			}
		}
		g.n = w;
		pass++;
	}
	g.steps += pass;
	out.i = removed;
	out.s.clear();
	format(out.s, "checkpoints filtered");
	out
}
@end
@entry 7bbd62688a266c1b
kind: step
verb: return
noun: spaces
modifier: at_least
context: retry
phrase: return spaces at least threshold length with retry budget {retries}
phrase: yield space count at least required level under retry limit {retries}
slot: retries int
test: text="hello brave new world" retries=3
expect: => i=5 r=0.0 ok=true s="spaces tally complete" errors=0 n=1 res=[5] cache=0 hits=0
test: text="simple test" retries=1
expect: => i=2 r=0.0 ok=true s="spaces tally complete" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var spaces = 0;
	for b in out.s {
		if b == ' ' {
			spaces++;
		}
	}
	var pass = 0;
	while pass < max_r && spaces < 5 {
		spaces++;
		pass++;
	}
	gold_push(g, spaces);
	g.steps += pass + 1;
	out.i = spaces;
	out.s.clear();
	format(out.s, "spaces tally complete");
	out
}
@end
@entry 6dc2f98d374664ea
kind: step
verb: filter
noun: suffix
modifier: pairwise
context: retry
phrase: filter suffix pairwise adjacent entries with retry count {retries}
phrase: cull suffix pairwise differences under retry allowance {retries}
slot: retries int
test: list=10,20,25,30,5 retries=2
expect: => i=4 r=0.0 ok=true s="suffix pairwise adjusted" errors=0 n=4 res=[10,20,25,30] cache=0 hits=0
test: list=50,40,30 retries=1
expect: => i=2 r=0.0 ok=true s="suffix pairwise adjusted" errors=0 n=2 res=[50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var pass = 0;
	while pass < max_r && g.n > 1 {
		let last = g.res[g.n - 1];
		let prev = g.res[g.n - 2];
		if last < prev {
			g.n--;
		}
		pass++;
	}
	g.steps += pass;
	out.i = g.n;
	out.s.clear();
	format(out.s, "suffix pairwise adjusted");
	out
}
@end
