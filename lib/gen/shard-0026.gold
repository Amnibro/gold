code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var attempts = 0;
	var w = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			let cached, ok = gold_cache_get(g, x);
			if ok {
				attempts++;
			} else {
				gold_cache_put(g, x, 1);
				g.res[w] = x;
				w++;
			}
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += attempts;
	out.i = attempts;
	out.s.clear();
	format(out.s, "odds deduplicated cache");
	out
}
@end
