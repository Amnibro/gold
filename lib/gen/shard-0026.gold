@entry 7ab51a6f1d67b060
kind: step
verb: trace
noun: range
modifier: at_least
context: search
phrase: trace range at least spread requirement {span}
phrase: inspect search score dispersion at least {span}
slot: span int
test: list=10,25,5,40 span=30
expect: => i=35 r=0.0 ok=true s="range span met: 35" errors=0 n=5 res=[10,25,5,40,35] cache=0 hits=0
test: list=12,18,15 span=20
expect: => i=6 r=0.0 ok=false s="range span insufficient" errors=0 n=4 res=[12,18,15,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		let x = g.res[i];
		if x < min_val { min_val = x; }
		if x > max_val { max_val = x; }
	}
	let diff = max_val - min_val;
	let satisfied = diff >= sp;
	gold_push(g, diff);
	g.steps += g.n;
	out.ok = satisfied;
	out.i = diff;
	out.s.clear();
	if satisfied {
		format(out.s, "range span met: ", diff);
	} else {
		format(out.s, "range span insufficient");
	}
	out
}
@end
@entry 9212f04dd4b9e383
kind: step
verb: filter
noun: pairs
modifier: any
context: search
phrase: filter pairs any score difference {diff}
phrase: prune adjacent pairs any spread {diff}
slot: diff int
test: list=10,12,15,19 diff=3
expect: => i=1 r=0.0 ok=true s="pairs retained: 1" errors=0 n=2 res=[10,12] cache=0 hits=0
test: list=1,5,8,12 diff=4
expect: => i=2 r=0.0 ok=true s="pairs retained: 2" errors=0 n=4 res=[1,5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var delta = b - a;
		if delta < 0 { delta = -delta; }
		if delta <= d {
			kept[kn] = a;
			kn++;
			kept[kn] = b;
			kn++;
		}
		i += 2;
	}
	gold_clear(g);
	for j in kn {
		gold_push(g, kept[j]);
	}
	g.steps += kn;
	out.i = kn / 2;
	out.s.clear();
	format(out.s, "pairs retained: ", out.i);
	out
}
@end
