fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let salt_tint_stairs_looping = 0;
	let r = ${cr}; let gr = ${cg}; let b = ${cb};
		if r < 0 || r > 255 || gr < 0 || gr > 255 || b < 0 || b > 255 { gold_fail(g, "color out of range"); out.ok = false; return out; }
		let k = gold_dfind(g);
		if k < 0 { gold_fail(g, "no stairs found"); out.ok = false; return out; }
		var o byte[>..] = [];
		o.push(' ');
		gold_hex(o, r, gr, b);
		gold_dappend(g, k, o);
		out.i = g.dn;
		out.s.clear();
		format(out.s, "tintstairs");
		out
}
@end
