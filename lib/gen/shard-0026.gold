	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / ${c}) % 2) as real;
		}
	}
	var s2_1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s2_1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s2_1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.15); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
