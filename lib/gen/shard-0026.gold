// sort step swap spaces nested
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var words = 0;
	for b in out.s {
		if b == ' ' { words++; }
	}
	if out.s.len > 0 { words++; }
	g.steps += words * d;
	out.i = words;
	out
}
@end
