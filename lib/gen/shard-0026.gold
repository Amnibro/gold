code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_sum_steps_with_retry = 0;
	let cap = ${limit};
	let max_r = ${retries};
	var total = 0;
	var attempts = 0;
	for i in g.n {
		if total + g.res[i] <= cap {
			total += g.res[i];
		} else if attempts < max_r {
			attempts++;
		}
	}
	g.steps += total + mark_transform_sum_steps_with_retry;
	out.i = total;
	out.s.clear();
	format(out.s, "sum ", total, " after ", attempts, " retries");
	out
}
@end
@entry 2121a0354462d657
kind: step
verb: split
noun: range
modifier: each
context: transform
phrase: split range each value by step {step_size}
phrase: divide each element into parts of size {step_size}
phrase: partition each list range by step size {step_size}
slot: step_size int
test: list=10,6 step_size=4
expect: => i=5 r=0.0 ok=true s="split into 5 fragments" errors=0 n=5 res=[4,4,2,4,2] cache=0 hits=0
test: list=15,9 step_size=5
expect: => i=5 r=0.0 ok=true s="split into 5 fragments" errors=0 n=5 res=[5,5,5,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_split_range_each = 0;
	let sz = ${step_size};
	if sz <= 0 {
		gold_fail(g, "step size must be positive");
		out.ok = false;
		return out;
	}
	var new_res int[512] = [0; 512];
	var nn = 0;
	for i in g.n {
		var rem = g.res[i];
		while rem > 0 && nn < 512 {
			if rem >= sz {
				new_res[nn] = sz;
				rem -= sz;
			} else {
				new_res[nn] = rem;
				rem = 0;
			}
			nn++;
		}
	}
	for i in nn { g.res[i] = new_res[i]; }
	g.n = nn;
	g.steps += nn + mark_transform_split_range_each;
	out.i = nn;
	out.s.clear();
	format(out.s, "split into ", nn, " fragments");
	out
}
@end
