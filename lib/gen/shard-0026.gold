slot: target text
test: text="hello world" target="world"
expect: => i=0 r=0.0 ok=true s="substring matched" errors=0 n=0 res=[] cache=0 hits=0
test: text="gold engine" target="cad"
expect: => i=0 r=0.0 ok=false s="substring missing" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	if tgt.len == 0 {
		found = true;
	} else if out.s.len >= tgt.len {
		let limit = out.s.len - tgt.len + 1;
		for i in limit {
			var is_m = true;
			for j in tgt.len {
				if out.s[i + j] != tgt[j] { is_m = false; break; }
			}
			if is_m { found = true; break; }
		}
	}
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "substring matched");
	} else {
		format(out.s, "substring missing");
	}
	out
}
@end
