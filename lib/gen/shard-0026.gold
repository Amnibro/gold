fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let half = g.n / 2;
	var s1 = 0;
	for i in half { s1 += g.res[i]; }
	var s2 = 0;
	for i in half..g.n { s2 += g.res[i]; }
	g.res[0] = s1;
	g.res[1] = s2;
	g.n = 2;
	g.steps += g.n;
	out.i = s1 + s2;
	out.s.clear();
	format(out.s, "bisected sums ", s1, " and ", s2);
	out
}
@end
