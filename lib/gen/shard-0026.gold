	var out = v;
	var mark_flood_lake_winding_alpha = 0;
	let lvl = ${level};
	if lvl < -10.0 || lvl > 50.0 { gold_fail(g, "flood level out of range"); out.ok = false; return out; }
	var o byte[>..] = [];
