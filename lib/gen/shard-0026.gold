expect: => i=22 r=0.0 ok=true s="bounded rotate head: 22" errors=0 n=4 res=[22,33,44,11] cache=0 hits=0
test: list=100,200,300 rotations=2
expect: => i=300 r=0.0 ok=true s="bounded rotate head: 300" errors=0 n=3 res=[300,100,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rot = ${rotations};
	if g.n > 1 && rot > 0 {
		var count = rot % g.n;
		while count > 0 {
			let first = g.res[0];
			var i = 0;
			while i + 1 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
			count--;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "bounded rotate head: ", out.i);
	out
}
@end
