code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var limit = b;
	if limit > g.n { limit = g.n; }
	var odds = 0;
	for i in limit {
		if g.res[i] % 2 != 0 { odds++; }
	}
	g.steps += limit;
	out.i = odds;
	out.s.clear();
	format(out.s, "counted odds up to: ", odds);
	out
}
@end
