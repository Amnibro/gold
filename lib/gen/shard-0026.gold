@entry 05c219d85b8cbeb0
kind: step
verb: select
noun: runs
modifier: while
context: sort
phrase: select runs while count below {cap}
phrase: gather runs while length under {cap}
slot: cap int
test: list=1,1,2,3,3,3,4 cap=2
expect: => i=4 r=0.0 ok=true s="small run elements: 4" errors=0 n=4 res=[1,1,2,4] cache=0 hits=0
test: list=5,5,5,6,6,7 cap=2
expect: => i=3 r=0.0 ok=true s="small run elements: 3" errors=0 n=3 res=[6,6,7] cache=0 hits=0
code:
// sort step select runs while
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	if g.n >= 2 {
		for i in g.n - 1 {
			for j in g.n - 1 - i {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var kept = [0; 512];
	var kn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i <= cp {
			var k = i;
			while k < j {
				kept[kn] = g.res[k];
				kn++;
				k++;
			}
		}
		i = j;
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	out.s.clear();
	format(out.s, "small run elements: ", kn);
	out
}
@end
