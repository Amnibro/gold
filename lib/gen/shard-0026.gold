fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark_transform_normalize_memo_any = 0;
	let b = ${base};
	if b <= 0 {
		gold_fail(g, "divisor must be positive");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		g.res[i] = g.res[i] % b;
		count++;
	}
	g.steps += count + mark_transform_normalize_memo_any;
	out.i = count;
	out.s.clear();
	format(out.s, "normalized ", count, " items");
	out
}
