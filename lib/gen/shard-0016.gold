fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var steps = 0;
	var cur = out.i;
	while cur > lim && steps < 100 {
		if cur % 2 == 0 { cur /= 2; }
		else { cur = cur * 3 + 1; }
		steps++;
	}
	gold_push(g, cur);
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "searched retry budget recursively");
	out
}
@end
