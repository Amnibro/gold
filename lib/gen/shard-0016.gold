test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="roughness" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.173 sum8=7148 hash=581209
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="roughness" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.001 max=0.173 sum8=28296 hash=56513
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// procedural texture synthesis for stain roughness coarse
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	var s_sl2 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_sl2[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_sl2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "roughness");
	out
}
