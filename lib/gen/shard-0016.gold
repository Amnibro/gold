code:
fn ${ID}(g Gold&, v Val) Val {
	// procedural texture synthesis for stain height smooth
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
