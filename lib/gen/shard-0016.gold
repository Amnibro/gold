slot: idx int
test: list=1,2,3,3,4 idx=2
expect: => i=7 r=0.0 ok=true s="suffix unique sum: 7" errors=0 n=5 res=[1,2,3,3,4] cache=0 hits=0
test: list=5,6,6,7,8 idx=1
expect: => i=21 r=0.0 ok=true s="suffix unique sum: 21" errors=0 n=5 res=[5,6,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${idx};
	var total = 0;
	var count = 0;
	var start = idx;
	if start >= g.n { start = g.n; }
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in start..i {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			total = total + x;
			count++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "suffix unique sum: ", total);
	out
}
@end
