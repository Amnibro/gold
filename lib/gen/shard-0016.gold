fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_streak = false;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] { has_streak = true; break; }
	}
	if !has_streak {
		let fill = ${val};
		for i in g.n { g.res[i] = fill; }
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled elements for no streak");
	out
}
@end
