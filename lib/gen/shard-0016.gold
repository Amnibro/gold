code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var count = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= ml { count++; }
		i = j;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "consecutive runs count: ", count);
	out
}
@end
