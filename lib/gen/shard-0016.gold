@entry f8bdf186272b00cb
kind: step
verb: scan
noun: histogram
modifier: in_reverse
context: loop
phrase: scan histogram in_reverse during loop iteration pass
phrase: execute scan histogram in_reverse over loop results
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="scanned histogram in reverse" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,6,7,7
expect: => i=3 r=0.0 ok=true s="scanned histogram in reverse" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var distinct = 0;
	var items int[64];
	var freqs int[64];
	for i in g.n {
		let val = g.res[i];
		var idx = -1;
		for k in distinct {
			if items[k] == val { idx = k; break; }
		}
		if idx >= 0 {
			freqs[idx]++;
		} else if distinct < 64 {
			items[distinct] = val;
			freqs[distinct] = 1;
			distinct++;
		}
	}
	gold_clear(g);
	var k = distinct - 1;
	while k >= 0 {
		gold_push(g, freqs[k]);
		k--;
	}
	g.steps += distinct;
	out.i = distinct;
	out.s.clear();
	format(out.s, "scanned histogram in reverse");
	out
}
@end
