fn ${ID}(g Gold&, v Val) Val {
	// procedural texture synthesis for tone height none
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 8, g.iw / 8, ${u});
		}
	}
	var mn1 = g.img[0];
	var mx1 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn1 { mn1 = g.img[k]; } if g.img[k] > mx1 { mx1 = g.img[k]; } }
	if mx1 - mn1 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn1) / (mx1 - mn1); }
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
