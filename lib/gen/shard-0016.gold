test: list=9,2,2,7,7
expect: => i=3 r=0.0 ok=true s="shifted unique pairs" errors=0 n=3 res=[7,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	for k in g.n {
		if k == 0 || g.res[k] != g.res[k - 1] {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted unique pairs");
	out
}
@end
