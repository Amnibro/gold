expect: => i=9 r=0.0 ok=true s="merged values while pred holds: 3" errors=0 n=2 res=[9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sum = 0;
	while count < g.n && ${p}(g.res[count]) {
		sum += g.res[count];
		count++;
	}
	if count > 1 {
		g.res[0] = sum;
		for i in count..g.n {
			g.res[i - count + 1] = g.res[i];
		}
		g.n = g.n - count + 1;
	}
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged values while pred holds: ", count);
	out
}
@end
