fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	var run_sum = 0;
	var i = g.n - 1;
	while i >= 0 {
		run_sum = run_sum + g.res[i];
		if run_sum > lim {
			g.res[i] = lim;
		} else {
			g.res[i] = run_sum;
		}
		i--;
	}
	g.steps += g.n;
	out.i = run_sum;
	out.s.clear();
	format(out.s, "scanned reverse");
	out
}
