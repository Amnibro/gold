code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely ran list");
	out
}
@end
