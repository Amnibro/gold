fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var matches = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > t { matches++; }
		i += 2;
	}
	g.steps += g.n / 2;
	out.i = matches;
	out.s.clear();
	format(out.s, "scanned threshold every other: ", matches);
	out
}
@end
