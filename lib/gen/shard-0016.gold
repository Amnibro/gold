noun: total
modifier: any
context: compare
phrase: sort elements below total cutoff {cutoff}
phrase: order values below cumulative cutoff {cutoff}
slot: cutoff int
test: list=40,10,30,20 cutoff=50
expect: => i=4 r=0.0 ok=true s="sorted count 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=15,5,25 cutoff=20
expect: => i=2 r=0.0 ok=true s="sorted count 2" errors=0 n=3 res=[5,15,25] cache=0 hits=0
test: list=10 cutoff=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	if c < 0 { gold_fail(g, "invalid cutoff"); out.ok = false; return out; }
	var cnt = 0;
	for i in g.n {
		if g.res[i] <= c { cnt++; }
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] <= c && g.res[j] <= c && g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = cnt;
	out.s.clear();
	format(out.s, "sorted count ", cnt);
	out
}
@end
@entry 9beb702cbcc302c4
kind: step
verb: clamp
noun: average
modifier: running
context: compare
phrase: clamp running average above bound {bound}
phrase: restrict running comparison mean to {bound}
slot: bound int
test: list=10,30,50 bound=25
expect: => i=1 r=0.0 ok=true s="running clamped 1" errors=0 n=3 res=[10,30,25] cache=0 hits=0
test: list=5,15,40 bound=20
expect: => i=0 r=0.0 ok=true s="running clamped 0" errors=0 n=3 res=[5,15,40] cache=0 hits=0
test: list=10 bound=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b < 0 || g.n == 0 { gold_fail(g, "invalid bound"); out.ok = false; return out; }
	var sum = 0;
	var clamped = 0;
	for i in g.n {
		sum += g.res[i];
		let cur_avg = sum / (i + 1);
		if cur_avg > b { g.res[i] = b; clamped++; }
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "running clamped ", clamped);
	out
}
@end
