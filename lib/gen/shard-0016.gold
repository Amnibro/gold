fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	for i in g.n {
		if g.res[i] >= b {
			g.res[count] = g.res[i];
			count++;
		}
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " items at least bound");
	out
}
@end
@entry 89131ecc4a226924
kind: step
verb: pair
noun: evens
modifier: until
context: loop
phrase: pair evens until in loop cycles using {p}
phrase: apply pair evens until across loop items with {p}
slot: p pred
test: list=2,4,6,8,10 p=over_100
expect: => i=2 r=0.0 ok=true s="paired evens until stop: 2" errors=0 n=3 res=[6,14,10] cache=0 hits=0
test: list=2,4,8,16 p=is_one
expect: => i=2 r=0.0 ok=true s="paired evens until stop: 2" errors=0 n=2 res=[6,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${p}(g.res[i]) { break; }
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			g.res[i] = g.res[i] + g.res[i + 1];
			for k in (i + 1)..(g.n - 1) {
				g.res[k] = g.res[k + 1];
			}
			g.n--;
			pairs++;
		}
		i++;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired evens until stop: ", pairs);
	out
}
@end
