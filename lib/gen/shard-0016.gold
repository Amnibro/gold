expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if ceil < 0 || g.n == 0 { gold_fail(g, "invalid ceiling"); out.ok = false; return out; }
	var min_v = 99999;
	for i in g.n {
		if g.res[i] < ceil && g.res[i] < min_v { min_v = g.res[i]; }
	}
	out.i = if min_v == 99999 { -1 } else { min_v };
	out.s.clear();
	format(out.s, "min below ceiling ", out.i);
	out
}
@end
