code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d > 8 {
		gold_fail(g, "recursive fill depth exceeded safe limit");
		out.i = 0;
		return out;
	}
	var k = 0;
	while k < d {
		gold_push(g, k + 10);
		k++;
	}
	g.steps += d;
	out.i = d;
	out
}
@end
