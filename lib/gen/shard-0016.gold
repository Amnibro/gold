expect: => i=3 r=0.0 ok=true s="reversed 3 evens" errors=0 n=5 res=[10,16,14,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var evens int[512] = [0; 512];
	var pos int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 && x >= lo && x <= hi {
			evens[en] = x;
			pos[en] = i;
			en++;
		}
	}
	for i in en {
		g.res[pos[i]] = evens[en - 1 - i];
	}
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "reversed ", en, " evens");
	out
}
@end
@entry b2eec999f8e688c3
kind: step
verb: scan
noun: digits
modifier: at_most
context: core
slot: max_digits int
phrase: scan digits at most length {max_digits}
phrase: filter numbers having at most {max_digits} digits
test: list=5,25,125,5000 max_digits=2
expect: => i=2 r=0.0 ok=true s="kept 2 small digit numbers" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=9,99,999,9999 max_digits=3
expect: => i=3 r=0.0 ok=true s="kept 3 small digit numbers" errors=0 n=3 res=[9,99,999] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var kept = 0;
	var new_res int[512] = [0; 512];
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var d = 0;
		if x == 0 { d = 1; }
		else { while x > 0 { d++; x /= 10; } }
		if d <= md {
			new_res[kept] = g.res[i];
			kept++;
		}
	}
	for j in kept { g.res[j] = new_res[j]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " small digit numbers");
	out
}
@end
