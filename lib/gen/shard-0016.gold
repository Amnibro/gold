fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var found_val = -1;
	var found = false;
	for k in g.n {
		if ${cond}(g.res[k]) {
			found_val = g.res[k];
			found = true;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = found_val;
	out.s.clear();
	format(out.s, "running condition search");
	out
}
@end
