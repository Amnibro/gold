fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for i in g.n {
		if g.res[i] == tgt { count++; }
	}
	gold_cache_put(g, tgt, count);
	gold_clear(g);
	for i in count { gold_push(g, tgt); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept item with cache count: ", count);
