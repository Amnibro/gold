@entry 3b488066a8c8d463
kind: step
verb: scale
noun: histogram
modifier: in_reverse
context: loop
phrase: scale histogram in_reverse in loop cycles using {factor}
phrase: apply scale histogram in_reverse across loop items with {factor}
slot: factor int
test: list=1,2,2,3,3,3 factor=2
expect: => i=3 r=0.0 ok=true s="scaled histogram in reverse" errors=0 n=3 res=[6,4,2] cache=0 hits=0
test: list=4,4,5,5 factor=3
expect: => i=2 r=0.0 ok=true s="scaled histogram in reverse" errors=0 n=2 res=[6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let factor = ${factor};
	var counts int[64];
	var vals int[64];
	var num = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for k in num {
			if vals[k] == x { found = k; break; }
		}
		if found >= 0 {
			counts[found]++;
		} else if num < 64 {
			vals[num] = x;
			counts[num] = 1;
			num++;
		}
	}
	gold_clear(g);
	var k = num - 1;
	while k >= 0 {
		gold_push(g, counts[k] * factor);
		k--;
	}
	g.steps += num;
	out.i = num;
	out.s.clear();
	format(out.s, "scaled histogram in reverse");
	out
}
@end
