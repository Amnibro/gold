@entry 94d12e060c6a7cea
kind: step
verb: normalize
noun: function
modifier: with_retry
context: transform
phrase: normalize function {f} with retry attempts {retries}
phrase: apply function {f} with retry limit {retries}
slot: f fn
slot: retries int
test: input=4 retries=5 f=double
expect: => i=64 r=0.0 ok=true s="retried 4" errors=0 n=0 res=[] cache=0 hits=0
test: input=2 retries=3 f=triple
expect: => i=54 r=0.0 ok=true s="retried 3" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retries};
	var attempts = 0;
	while attempts < retries {
		out.i = ${f}(out.i);
		attempts++;
		if out.i > 50 { break; }
	}
	g.steps += attempts;
	out.s.clear();
	format(out.s, "retried ", attempts);
	out
}
@end
