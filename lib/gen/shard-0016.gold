fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var streak = 1;
	g.res[0] = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[i - 1] {
			streak++;
		} else {
			streak = 1;
		}
		g.res[i] = streak;
		i++;
	}
	g.steps += g.n;
	out.i = streak;
	out.s.clear();
	format(out.s, "normalized streak recursively: ", streak);
	out
}
