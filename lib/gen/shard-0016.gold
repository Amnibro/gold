fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	var i = 2;
	while i < g.n {
		if g.res[i] < g.res[i - 2] {
			ok = false;
			break;
		}
		i += 2;
	}
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "checked runs every other");
