@entry 31eec8343348cdc6
kind: step
verb: sum
noun: middle
modifier: times
context: transform
phrase: sum middle elements scaled {factor} times
phrase: accumulate middle items multiplied {factor} times
slot: factor int
test: list=10,20,30,40 factor=2
expect: => i=100 r=0.0 ok=true s="summed middle" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=1,5,7,10 factor=3
expect: => i=36 r=0.0 ok=true s="summed middle" errors=0 n=4 res=[1,5,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${factor};
	var total = 0;
	if g.n > 2 {
		for i in 1..(g.n - 1) {
			total += g.res[i] * factor;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed middle");
	out
}
@end
