phrase: trap errors between minimum {low} maximum {high}
slot: low int
slot: high int
test: list=10,25,50 low=20 high=30
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[10,25,50] cache=0 hits=0
test: list=5,15,45 low=10 high=20
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[5,15,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	var flagged = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			gold_fail(g, "value in forbidden range");
			flagged++;
		}
	}
	g.steps += g.n;
	out.i = flagged;
	out
}
@end
