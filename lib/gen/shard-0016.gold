@entry ed3e4ff122be70ec
kind: fn
verb: collect
noun: subfunction
modifier: unique
context: loop
phrase: count unique prime factors of number
phrase: collect distinct prime divisors in loop
test: arg=12,30
expect: 2
expect: 3
test: arg=7,1
expect: 1
expect: 0
code:
fn ${ID}(n int) int {
	var num_val = if n < 0 { -n } else { n };
	if num_val <= 1 { return 0; }
	var prime_factors = 0;
	var divisor_candidate = 2;
	while divisor_candidate * divisor_candidate <= num_val {
		if num_val % divisor_candidate == 0 {
			prime_factors += 1;
			while num_val % divisor_candidate == 0 {
				num_val /= divisor_candidate;
			}
		}
		divisor_candidate += 1;
	}
	if num_val > 1 { prime_factors += 1; }
	prime_factors
}
@end
