noun: primes
modifier: while
context: aggregate
phrase: scan primes while prefix remains prime in aggregate
phrase: aggregate scan prime numbers while valid
test: list=3,5,7,4,11
expect: => i=3 r=0.0 ok=true s="scanned prime prefix length: 3" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=2,13,17,19,23
expect: => i=5 r=0.0 ok=true s="scanned prime prefix length: 5" errors=0 n=5 res=[2,13,17,19,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[prime_count] = x;
			prime_count++;
		} else {
			break;
		}
	}
	g.n = prime_count;
	out.i = prime_count;
	out.ok = prime_count > 0;
	out.s.clear();
	format(out.s, "scanned prime prefix length: ", prime_count);
	out
}
@end
