test: list=10,20 bound=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b < 0 || g.n < 2 { gold_fail(g, "invalid bound"); out.ok = false; return out; }
	var clamped = 0;
	for i in (g.n - 2)..g.n {
		if g.res[i] > b { g.res[i] = b; clamped++; }
	}
	g.steps += clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " suffix entries");
	out
}
@end
