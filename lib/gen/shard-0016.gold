fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var nodds = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] % 2 != 0 {
			odds[nodds] = g.res[i];
			nodds++;
		}
		i--;
	}
	g.n = 0;
	for k in nodds {
		gold_push(g, odds[k]);
		gold_push(g, odds[k]);
	}
	g.steps += g.n;
	out.i = nodds;
	out.s.clear();
	format(out.s, "odd items repeated in reverse: ", nodds);
	out
}
