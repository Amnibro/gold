fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	if g.n >= 2 {
		sum = g.res[g.n - 1] + g.res[g.n - 2];
	} else if g.n == 1 {
		sum = g.res[0];
	}
	let ok = sum <= lim;
	out.ok = ok;
	out.i = sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "checked budget last");
	out
}
@end
