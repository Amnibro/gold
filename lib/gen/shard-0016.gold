fn ${ID}(n int) int {
	var source_num = if n < 0 { -n } else { n };
	var running_hash = 0;
	while source_num > 0 {
		let tail_digit = source_num % 10;
		running_hash = (running_hash * 31 + tail_digit) % 10007;
		source_num /= 10;
	}
	running_hash
}
@end
