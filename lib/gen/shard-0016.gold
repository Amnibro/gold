phrase: examine candidate head pairwise relations along {count}
test: list=10,15,12,20,30 count=3
expect: => i=8 r=0.0 ok=true s="head pairwise maximum gap: 8" errors=0 n=5 res=[10,15,12,20,30] cache=0 hits=0
test: list=4,7,9 count=2
expect: => i=3 r=0.0 ok=true s="head pairwise maximum gap: 3" errors=0 n=3 res=[4,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var bound = k;
	if bound >= g.n { bound = g.n - 1; }
	var max_diff = 0;
	if bound > 0 {
		max_diff = g.res[1] - g.res[0];
		if max_diff < 0 { max_diff = -max_diff; }
		for i in 1..bound {
			var d = g.res[i + 1] - g.res[i];
			if d < 0 { d = -d; }
			if d > max_diff { max_diff = d; }
		}
	}
	g.steps += bound;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "head pairwise maximum gap: ", max_diff);
	out
}
@end
