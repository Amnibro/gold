code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || w > g.n { return out; }
	var max_sum = 0;
	for i in w { max_sum += g.res[i]; }
	var cur_sum = max_sum;
	for i in w..g.n {
		cur_sum = cur_sum + g.res[i] - g.res[i - w];
		if cur_sum > max_sum { max_sum = cur_sum; }
	}
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "scanned maximum window sum: ", max_sum);
	out
}
@end
