code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stride = ${step_size};
	if stride == 0 {
		gold_fail(g, "zero step size in normalization");
		out.i = 0;
		return out;
	}
	var cached = 0;
	for i in g.n {
		let norm = g.res[i] / stride;
		gold_cache_put(g, i, norm);
		cached++;
	}
	g.steps += g.n;
	out.i = cached;
	out
}
@end
