code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i < g.n {
		if i % 2 == 1 {
			gold_fail(g, "periodic error recorded");
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected errors every other item: ", count);
	out
}
@end
