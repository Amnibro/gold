@entry c94e44b6b4563590
kind: step
verb: validate
noun: loop
modifier: times
context: search
slot: times int
phrase: validate loop times {times} across search candidates
phrase: check search candidate list in loop times {times}
test: list=2,4,6,8 times=3
expect: => i=4 r=0.0 ok=true s="loop validation passed iterations: 3" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=-1,2,3 times=2
expect: => i=0 r=0.0 ok=false s="loop validation failed at iteration: 0" errors=0 n=3 res=[-1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let iters = ${times};
	var ok_count = 0;
	var failed_iter = -1;
	for round in iters {
		for i in g.n {
			if g.res[i] < 0 {
				failed_iter = round;
				break;
			}
		}
		if failed_iter >= 0 { break; }
		ok_count++;
	}
	g.steps += ok_count + 1;
	out.s.clear();
	if failed_iter >= 0 {
		out.ok = false;
		out.i = 0;
		format(out.s, "loop validation failed at iteration: ", failed_iter);
	} else {
		out.ok = true;
		out.i = g.n;
		format(out.s, "loop validation passed iterations: ", ok_count);
	}
	out
}
@end
@entry 1d22db4e1d6ce4d3
kind: step
verb: search
noun: value
modifier: recursively
context: search
slot: target int
phrase: search value recursively for target candidate {target}
phrase: locate target value recursively across candidates {target}
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="target value located recursively at: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,3,5,7 target=6
expect: => i=-1 r=0.0 ok=false s="target value not found recursively" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	var iters = 0;
	while lo <= hi && iters < 64 {
		let mid = (lo + hi) / 2;
		if g.res[mid] == t {
			found = mid;
			break;
		} else if g.res[mid] < t {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
		iters++;
	}
	g.steps += iters + 1;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "target value located recursively at: ", found);
	} else {
		out.ok = false;
		format(out.s, "target value not found recursively");
	}
	out
}
@end
