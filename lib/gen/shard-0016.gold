expect: => i=0 r=0.0 ok=true s="valid (balanced) text" errors=0 n=0 res=[] cache=0 hits=0
test: text="broken (unmatched text"
expect: => i=1 r=0.0 ok=true s="broken (unmatched text" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var depth = 0;
	for c in v.s {
		if c == '(' || c == '[' { depth++; }
		else if c == ')' || c == ']' {
			if depth > 0 { depth--; } else { gold_fail(g, "unmatched close"); }
		}
	}
	if depth != 0 { gold_fail(g, "unclosed bracket"); }
	g.steps++;
	out.i = g.errors;
	out
}
@end
