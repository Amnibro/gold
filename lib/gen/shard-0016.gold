@entry 49dda182d2ed24cc
kind: step
verb: reverse
noun: histogram
modifier: last
context: core
slot: k int
phrase: reverse histogram of last {k} elements
phrase: invert frequency counts for last {k} items
test: list=1,2,2,3,3,3 k=4
expect: => i=4 r=0.0 ok=true s="reversed last 4 items" errors=0 n=6 res=[1,2,3,3,3,2] cache=0 hits=0
test: list=4,4,5,5,5,6 k=5
expect: => i=5 r=0.0 ok=true s="reversed last 5 items" errors=0 n=6 res=[4,6,5,5,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 1 || count > g.n {
		gold_fail(g, "invalid k");
		out.ok = false;
		return out;
	}
	let start = g.n - count;
	for i in count / 2 {
		let tmp = g.res[start + i];
		g.res[start + i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed last ", count, " items");
	out
}
@end
