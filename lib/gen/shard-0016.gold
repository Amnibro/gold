@entry 2d03abc4a40ef5a3
kind: step
verb: search
noun: budget
modifier: until
context: search
slot: budget int
slot: target int
phrase: search budget until target {target} spending {budget}
phrase: scan search items using budget {budget} until target {target}
test: list=10,20,30,40,50 budget=3 target=30
expect: => i=2 r=0.0 ok=true s="target found within budget: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=10,20,30,40,50 budget=2 target=50
expect: => i=-1 r=0.0 ok=false s="search budget exhausted without finding target" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let t = ${target};
	var spent = 0;
	var found = -1;
	for i in g.n {
		if spent >= b { break; }
		spent++;
		if g.res[i] == t {
			found = i;
			break;
		}
	}
	g.steps += spent;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "target found within budget: ", found);
	} else {
		out.ok = false;
		format(out.s, "search budget exhausted without finding target");
	}
	out
}
@end
