@entry da05441d2b80d00b
kind: step
verb: clamp
noun: primes
modifier: all
context: retry
phrase: clamp all prime retry attempts to ceiling {cap}
phrase: bound every prime retry value by maximum {cap}
slot: cap int
test: list=2,3,4,13,20 cap=10
expect: => i=1 r=0.0 ok=true s="clamped all prime retry attempts" errors=0 n=5 res=[2,3,4,10,20] cache=0 hits=0
test: list=7,8,11 cap=5
expect: => i=2 r=0.0 ok=true s="clamped all prime retry attempts" errors=0 n=3 res=[5,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var modified = 0;
	for i in g.n {
		let num = g.res[i];
		var is_p = true;
		if num < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p && num > c {
			g.res[i] = c;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped all prime retry attempts");
	out
}
@end
@entry 0f365b9c98d1f83c
