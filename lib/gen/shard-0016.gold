kind: step
verb: fill
noun: checkpoint
modifier: recursively
context: aggregate
slot: interval int
phrase: fill checkpoint recursively in aggregate with {interval}
phrase: apply fill checkpoint recursively across aggregates with {interval}
test: list=1,2,3,4 interval=2
expect: => i=6 r=0.0 ok=true s="fill checkpoint recursively items: 6" errors=0 n=6 res=[1,2,3,3,4,10] cache=0 hits=0
test: list=5,5,5,5,5,5 interval=3
expect: => i=8 r=0.0 ok=true s="fill checkpoint recursively items: 8" errors=0 n=8 res=[5,5,5,15,5,5,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${interval};
	if step <= 0 || g.n == 0 {
		gold_fail(g, "fill checkpoint recursively requires positive interval");
		out.ok = false;
		return out;
	}
	var res_out int[512] = [0; 512];
	var count = 0;
	var run_sum = 0;
	for i in g.n {
		res_out[count] = g.res[i];
		count++;
		run_sum += g.res[i];
		if (i + 1) % step == 0 {
			res_out[count] = run_sum;
			count++;
		}
	}
	gold_clear(g);
	for i in count { gold_push(g, res_out[i]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "fill checkpoint recursively items: ", count);
	out
}
@end
