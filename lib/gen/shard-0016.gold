test: h=3.5 doc="field box 0,0,-.5 40,40,1|rock sphere 0,0,0.5 r0.5"
expect: => i=3 r=0.0 ok=true s="trees" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: field box 0,0,-.5 40,40,1
expect: => doc: rock sphere 0,0,0.5 r0.5
expect: => doc: trees3 cyl 1,2,0 1,2,3.5 r0.5 m:matte #2d5a2d
test: h=0.0
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// env: flood trees deep
	var out = v;
	if ${h} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "trees", "", o);
	o.append(" cyl ");
	gold_fnum(o, 1.0);
	o.append(",");
	gold_fnum(o, 2.0);
	o.append(",");
	gold_fnum(o, 0.0);
	o.append(" ");
	gold_fnum(o, 1.0);
	o.append(",");
	gold_fnum(o, 2.0);
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, 0.5);
	o.append(" m:matte ");
	gold_hex(o, 45, 90, 45);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "trees");
	out
}
@end
