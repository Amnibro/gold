		if !seen { uniq++; }
	}
	out.i = uniq + b;
	out.ok = true;
	out.s.clear();
	format(out.s, "unique numbers: ", out.i);
	out
}
@end
@entry 2da21cf54315c8cc
kind: step
verb: dedupe
noun: series
modifier: each
context: retry
slot: threshold int
phrase: dedupe series each element above threshold {threshold}
phrase: remove duplicates across each series exceeding {threshold}
test: list=5,5,12,12,8,8 threshold=6
expect: => i=2 r=0.0 ok=true s="series duplicates pruned: 2" errors=0 n=4 res=[5,5,12,8] cache=0 hits=0
test: list=20,20,10,10,30 threshold=15
expect: => i=1 r=0.0 ok=true s="series duplicates pruned: 1" errors=0 n=4 res=[20,10,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	if g.n <= 1 { return out; }
	var w = 1;
	for i in 1..g.n {
		let cur = g.res[i];
		if cur > thresh && cur == g.res[i - 1] {
			// skip duplicate
		} else {
			g.res[w] = cur;
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.ok = true;
	out.s.clear();
	format(out.s, "series duplicates pruned: ", removed);
	g.steps += removed;
	out
}
@end
