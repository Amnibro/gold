phrase: aggregate select every {step_size} item from sorted sequence
test: list=8,3,1,9,4,2 step_size=2
expect: => i=3 r=0.0 ok=true s="selected sorted stride count: 3" errors=0 n=3 res=[1,3,8] cache=0 hits=0
test: list=15,5,20,10 step_size=3
expect: => i=2 r=0.0 ok=true s="selected sorted stride count: 2" errors=0 n=2 res=[5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stride = ${step_size};
	if stride <= 0 || g.n == 0 {
		out.ok = false;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		g.res[new_n] = g.res[idx];
		new_n++;
		idx += stride;
	}
	g.n = new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "selected sorted stride count: ", new_n);
	out
}
@end
@entry 67d709dcc32450c1
