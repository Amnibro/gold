expect: => i=3 r=0.0 ok=true s="reversed gap count: 3" errors=0 n=3 res=[12,3,5] cache=0 hits=0
test: list=2,8,20,50
expect: => i=3 r=0.0 ok=true s="reversed gap count: 3" errors=0 n=3 res=[30,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for gaps");
		return out;
	}
	let gap_count = g.n - 1;
	var i = 0;
	while i < gap_count {
		g.res[i] = g.res[i + 1] - g.res[i];
		i++;
	}
	g.n = gap_count;
	for j in gap_count / 2 {
		let tmp = g.res[j];
		g.res[j] = g.res[gap_count - 1 - j];
		g.res[gap_count - 1 - j] = tmp;
	}
	out.i = gap_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "reversed gap count: ", gap_count);
	out
}
@end
