@entry a7feccaa8cd6da6a
kind: step
verb: scale
noun: sequence
modifier: all
context: error
phrase: scale all error sequence values by factor {factor}
phrase: multiply entire fault sequence using factor {factor}
slot: factor int
test: list=10,20,30 factor=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[20,40,60] cache=0 hits=0
test: list=5,15,25 factor=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[15,45,75] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_scale_seq_all
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		g.res[i] *= f;
		if g.res[i] > 1000 {
			gold_fail(g, "value exceeded maximum scale threshold");
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
@entry f6a61989025e2bee
kind: step
verb: scale
noun: tail
modifier: at_most
context: error
phrase: scale tail error severity at most {cap} units
phrase: amplify trailing fault magnitude up to {cap} limit
slot: cap int
test: list=1,2,5 cap=20
expect: => i=10 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,10] cache=0 hits=0
test: list=3,6,15 cap=20
expect: => i=20 r=0.0 ok=true s="" errors=1 n=3 res=[3,6,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_scale_tail_at_most
	var out = v;
	let limit = ${cap};
	if g.n > 0 {
		let tail_idx = g.n - 1;
		let scaled = g.res[tail_idx] * 2;
		if scaled > limit {
			gold_fail(g, "tail exceeds allowed scaling ceiling");
			g.res[tail_idx] = limit;
		} else {
			g.res[tail_idx] = scaled;
		}
		out.i = g.res[tail_idx];
	}
	g.steps += 1;
	out
}
@end
@entry f125809d839e0e61
kind: step
verb: retry
noun: budget
modifier: until
context: error
phrase: retry budget allocation until remaining reaches {reserve}
phrase: consume error retry budget down to threshold {reserve}
slot: reserve int
test: input=50 list=10,15,5 reserve=10
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[10,15,5] cache=0 hits=0
test: input=20 list=8,12,4 reserve=12
expect: => i=-4 r=0.0 ok=true s="" errors=1 n=3 res=[8,12,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_retry_budget_until
	var out = v;
	let min_res = ${reserve};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let remain = out.i - total;
	if remain < min_res {
		gold_fail(g, "remaining budget below minimum reserve");
	}
	g.steps += g.n;
	out.i = remain;
	out
}
@end
@entry e8e4bf0898f32372
kind: step
verb: retry
noun: cache
modifier: last
context: error
phrase: retry cache lookup using last fallback code {fallback}
phrase: recover cached error state defaulting to {fallback}
slot: fallback int
test: list=10,20 fallback=99
expect: => i=99 r=0.0 ok=true s="" errors=0 n=2 res=[10,20] cache=1 hits=0
test: list=5 fallback=42
expect: => i=42 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_retry_cache_last
	var out = v;
	let fb = ${fallback};
	if g.n > 0 {
		let key = g.n - 1;
		let val, ok = gold_cache_get(g, key);
		if !ok {
			gold_cache_put(g, key, fb);
			out.i = fb;
		} else {
			out.i = val;
		}
	}
	g.steps += 1;
	out
}
@end
