code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	if m <= 0 { return out; }
	for i in g.n {
		let rem = g.res[i] % m;
		let old_c, ok = gold_cache_get(g, rem);
		if ok {
			gold_cache_put(g, rem, old_c + 1);
		} else {
			gold_cache_put(g, rem, 1);
		}
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "grouped cache with retry: ", g.cn);
	out
}
@end
