fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let lim = ${thresh};
	var gaps = 0;
	for i in 1..g.n {
		let diff = core_abs_val(g.res[i] - g.res[i - 1]);
		if diff > lim {
			gaps++;
		}
	}
	g.steps += g.n;
	out.i = gaps;
	out.s.clear();
	format(out.s, "counted ", gaps, " gaps recursively");
	out
}
@end
