	let target_k = ${k};
	var count = 0;
	for i in g.n {
		if g.res[i] >= lim { count++; }
	}
	let passes = count >= target_k;
	out.ok = passes;
	out.i = count;
	out.s.clear();
	if passes {
		format(out.s, "check limit reached at least: ", count);
	} else {
		format(out.s, "check limit deficient: ", count);
	}
	out
}
@end
