code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			break;
		}
		g.res[i] -= 1;
		count++;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
