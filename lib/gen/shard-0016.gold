phrase: dedupe pairs repeating {passes} times
phrase: eliminate duplicate adjacent pairs over {passes} passes
test: list=1,1,2,2,3 passes=1
expect: => i=2 r=0.0 ok=true s="adjacent pairs deduplicated: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,5,6,6 passes=2
expect: => i=3 r=0.0 ok=true s="adjacent pairs deduplicated: 3" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	var removed = 0;
	for pass in p {
		if g.n <= 1 { break; }
		var w = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[w - 1] {
				removed++;
			} else {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	out.i = removed;
	out.ok = true;
	out.s.clear();
	format(out.s, "adjacent pairs deduplicated: ", removed);
	g.steps += removed;
	out
}
@end
@entry 1badeeae9310b4b8
kind: step
verb: dedupe
noun: window
modifier: with_retry
context: retry
slot: win int
phrase: dedupe window with retry using span {win}
phrase: retry window deduplication over span {win}
test: list=2,2,3,4,4,5 win=2
expect: => i=2 r=0.0 ok=true s="window duplicates removed: 2" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=1,1,1,2,3 win=3
expect: => i=2 r=0.0 ok=true s="window duplicates removed: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${win};
	var write_idx = 0;
	var removed = 0;
	for i in g.n {
		var dup = false;
		let cur = g.res[i];
		var j = 0;
		if write_idx > span { j = write_idx - span; }
		while j < write_idx {
			if g.res[j] == cur { dup = true; break; }
			j++;
		}
		if !dup {
			g.res[write_idx] = cur;
			write_idx++;
		} else {
			removed++;
		}
	}
	g.n = write_idx;
	out.i = removed;
	out.ok = true;
	out.s.clear();
	format(out.s, "window duplicates removed: ", removed);
	g.steps += removed;
	out
}
@end
