	o.append(" box ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",1.5 ");
	o.append("1,1,");
	o.append("3");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tallcrate");
	out
}
@end
