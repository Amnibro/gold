test: list=25,12,30,8 max_val=20
expect: => i=2 r=0.0 ok=true s="items ordered 2" errors=0 n=4 res=[25,8,30,12] cache=0 hits=0
test: list=18,6,22,4 max_val=15
expect: => i=2 r=0.0 ok=true s="items ordered 2" errors=0 n=4 res=[18,4,22,6] cache=0 hits=0
test: list=10 max_val=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	if mv < 0 { gold_fail(g, "invalid max_val"); out.ok = false; return out; }
	var count = 0;
	for i in g.n { if g.res[i] < mv { count++; } }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] < mv && g.res[j] < mv && g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "items ordered ", count);
	out
}
@end
