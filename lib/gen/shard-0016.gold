fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var count = 0;
	for i in g.n {
		if count >= limit { break; }
		g.res[i] += count;
		count++;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
