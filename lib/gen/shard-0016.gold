kind: step
verb: reverse
noun: step
modifier: with_retry
context: aggregate
phrase: reverse step order with retry using step size {step_sz}
phrase: invert sequence steps with retry under stride {step_sz}
slot: step_sz int
test: list=1,2,3,4,5,6 step_sz=2
expect: => i=23 r=0.0 ok=true s="reversed steps" errors=0 n=6 res=[6,5,4,3,2,1] cache=0 hits=0
test: list=10,20,30,40 step_sz=1
expect: => i=101 r=0.0 ok=true s="reversed steps" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_sz = ${step_sz};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	var total = 0;
	for i in g.n { total = total + g.res[i]; }
	g.steps += g.n;
	out.i = total + step_sz;
	out.s.clear();
	format(out.s, "reversed steps");
	out
}
@end
