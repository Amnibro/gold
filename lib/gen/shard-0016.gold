@entry a674d4adcb0bbb2a
kind: step
verb: search
noun: tail
modifier: with_cache
context: search
slot: offset int
phrase: search tail with cache from offset {offset}
phrase: probe tail elements with cache past {offset}
test: list=10,20,30,40,50 offset=2
expect: => i=3 r=0.0 ok=true s="tail elements cached: 3" errors=0 n=5 res=[10,20,30,40,50] cache=3 hits=0
test: list=7,14,21 offset=1
expect: => i=2 r=0.0 ok=true s="tail elements cached: 2" errors=0 n=3 res=[7,14,21] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var count = 0;
	if off >= 0 && off < g.n {
		for i in off..g.n {
			let x = g.res[i];
			gold_cache_put(g, x, x * 2);
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "tail elements cached: ", count);
	out
}
@end
@entry cf71987b4849066f
kind: step
verb: join
noun: streak
modifier: every_other
context: search
phrase: join streak every other matched search element
phrase: coalesce streak every other item from search results
test: list=1,2,3,1,2,3,4
expect: => i=4 r=0.0 ok=true s="streak items kept: 4" errors=0 n=4 res=[1,3,1,3] cache=0 hits=0
test: list=5,6,7,2,3
expect: => i=3 r=0.0 ok=true s="streak items kept: 3" errors=0 n=3 res=[5,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] >= g.res[j - 1] { j++; }
		var k = i;
		while k < j {
			g.res[kept] = g.res[k];
			kept++;
			k += 2;
		}
		i = j;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "streak items kept: ", kept);
	out
}
@end
@entry 060c4bd4aa991aed
kind: step
verb: rotate
noun: head
modifier: safely
context: search
slot: count int
phrase: rotate head safely by amount {count} in search results
phrase: cycle head elements safely across {count} positions
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="head rotated safely length: 3" errors=0 n=5 res=[3,1,2,4,5] cache=0 hits=0
test: list=10,20 count=5
expect: => i=2 r=0.0 ok=true s="head rotated safely length: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var len = k;
	if len > g.n { len = g.n; }
	if len > 1 {
		let last = g.res[len - 1];
		var i = len - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "head rotated safely length: ", len);
	out
}
@end
