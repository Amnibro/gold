noun: runs
modifier: any
context: aggregate
phrase: merge runs any identical neighbors in aggregate
phrase: aggregate merge any duplicate adjacent streaks
test: list=3,3,3,5,5,8
expect: => i=3 r=0.0 ok=true s="merged runs count: 3" errors=0 n=3 res=[9,10,8] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="merged runs count: 3" errors=0 n=3 res=[20,20,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_sum = val;
		var j = i + 1;
		while j < g.n && g.res[j] == val {
			run_sum += g.res[j];
			j++;
		}
		g.res[new_n] = run_sum;
		new_n++;
		i = j;
	}
	g.n = new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "merged runs count: ", new_n);
	out
}
@end
