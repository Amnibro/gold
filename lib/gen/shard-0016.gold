code:
fn ${ID}(g Gold&, v Val) Val {
	// step_measure_seq_recursively
	var out = v;
	let d = ${depth};
	let sum = ${ID}_sum(g, 0, d);
	g.steps += d;
	out.i = sum;
	out
}
recursive fn ${ID}_sum(g Gold&, idx int, max_d int) int {
	if idx >= max_d || idx >= g.n { return 0; }
	return g.res[idx] + ${ID}_sum(g, idx + 1, max_d);
}
@end
