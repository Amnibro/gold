expect: => i=2 r=0.0 ok=true s="shifted prefix sorted: 2" errors=0 n=4 res=[7,9,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let len = if k < g.n { k } else { g.n };
	var i = 0;
	while i < len {
		var j = 0;
		while j + 1 < len - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		j++;
		}
		i++;
	}
	g.steps += len * len;
	out.i = len;
	out.s.clear();
	format(out.s, "shifted prefix sorted: ", len);
	out
}
@end
