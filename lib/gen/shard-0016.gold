	var x = if n < 0 { -n } else { n };
	var changed = true;
	var iter = 0;
	while changed && iter < 10 {
		changed = false;
		var d int[20] = [0; 20];
		var len = 0;
		if x == 0 { len = 1; }
		while x > 0 {
			d[len] = x % 10;
			len++;
			x /= 10;
		}
		var new_d int[20] = [0; 20];
		var new_len = 0;
		var i = len - 1;
		while i >= 0 {
			if i > 0 && d[i] == d[i - 1] {
				changed = true;
				i -= 2;
			} else {
				new_d[new_len] = d[i];
				new_len++;
				i--;
			}
		}
		var next_x = 0;
		for j in new_len {
			next_x = next_x * 10 + new_d[j];
		}
		x = next_x;
		iter++;
	}
	x + b
}
