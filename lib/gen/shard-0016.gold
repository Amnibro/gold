fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if mv < 0 { gold_fail(g, "invalid min_val"); out.ok = false; return out; }
	var valid = true;
	for i in g.n {
		if g.res[i] < mv { valid = false; break; }
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid { format(out.s, "all numbers valid"); }
	else { format(out.s, "number validation failed"); }
	out
}
@end
