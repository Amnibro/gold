@entry 47decfa3f920bd82
kind: step
verb: cache
noun: pairs
modifier: unique
context: sort
phrase: cache unique adjacent pairs in sorted list
phrase: record distinct sorted pair sums in cache
test: list=5,2,8,2,5
expect: => i=4 r=0.0 ok=true s="cached 4 pairs" errors=0 n=5 res=[2,2,5,5,8] cache=4 hits=0
test: list=1,3,1,3,1
expect: => i=3 r=0.0 ok=true s="cached 3 pairs" errors=0 n=5 res=[1,1,1,3,3] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var pairs = 0;
	for k in g.n - 1 {
		let s = g.res[k] + g.res[k + 1];
		let _, exists = gold_cache_get(g, s);
		if !exists {
			gold_cache_put(g, s, k);
			pairs++;
		}
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "cached ", pairs, " pairs");
	out
}
@end
@entry 0af66a62ea856713
kind: step
verb: run
noun: memo
modifier: until
context: sort
phrase: run memoized sorting checks until target {target}
phrase: execute memo sort passes until reaching target {target}
slot: target int
test: list=6,2,8,4 target=10
expect: => i=3 r=0.0 ok=true s="memo until target" errors=0 n=4 res=[2,4,6,8] cache=3 hits=0
test: list=9,1,5 target=5
expect: => i=2 r=0.0 ok=true s="memo until target" errors=0 n=3 res=[1,5,9] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	var count = 0;
	for k in g.n {
		total += g.res[k];
		count++;
		gold_cache_put(g, count, total);
		if total >= ${target} { break; }
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "memo until target");
	out
}
@end
@entry d6f2d4e6365286a9
kind: step
verb: run
noun: step
modifier: at_most
context: sort
phrase: run sorting steps at most {limit} passes
phrase: perform bubble sort steps at most {limit} times
slot: limit int
test: list=8,2,6,1 limit=1
expect: => i=1 r=0.0 ok=true s="ran steps at most" errors=0 n=4 res=[2,6,1,8] cache=0 hits=0
test: list=15,10,5,20 limit=2
expect: => i=2 r=0.0 ok=true s="ran steps at most" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_steps = if ${limit} < 0 { 0 } else { ${limit} };
	var steps = 0;
	while steps < max_steps && steps < g.n {
		for j in (g.n - 1 - steps) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
		steps++;
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "ran steps at most");
	out
}
@end
