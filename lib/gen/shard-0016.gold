fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mi = ${min_items};
	if g.n >= mi && g.n > 1 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated checkpoints at least min items");
	out
}
@end
