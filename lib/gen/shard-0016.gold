test: list=2,3,4,5 fn=halve
expect: => i=2 r=0.0 ok=true s="unique mapped items: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,12,15,18 fn=digit_sum
expect: => i=4 r=0.0 ok=true s="unique mapped items: 4" errors=0 n=4 res=[10,12,15,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[512] = [0; 512];
	var sn = 0;
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for i in g.n {
		let mapped = ${fn}(g.res[i]);
		var found = false;
		for k in sn {
			if seen[k] == mapped { found = true; break; }
		}
		if !found {
			seen[sn] = mapped;
			sn++;
			new_res[new_n] = g.res[i];
			new_n++;
		}
	}
	for j in new_n { g.res[j] = new_res[j]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "unique mapped items: ", new_n);
	out
}
@end
