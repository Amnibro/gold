@entry 4b72e97514dd368e
kind: step
verb: sort
noun: suffix
modifier: last
context: retry
phrase: sort last retry suffix of length {size}
phrase: order trailing retry elements of size {size}
slot: size int
test: list=10,20,5,2 size=2
expect: => i=4 r=0.0 ok=true s="sorted last retry suffix" errors=0 n=4 res=[10,20,2,5] cache=0 hits=0
test: list=30,40,9,3 size=2
expect: => i=4 r=0.0 ok=true s="sorted last retry suffix" errors=0 n=4 res=[30,40,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${size};
	if s > 0 && g.n > 0 {
		let start = if g.n > s { g.n - s } else { 0 };
		for i in start..g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted last retry suffix");
	out
}
@end
