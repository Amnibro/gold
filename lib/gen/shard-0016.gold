noun: pairs
modifier: between
context: aggregate
slot: low int
slot: high int
slot: factor int
phrase: scale pairs between range {low} to {high} by {factor} in aggregate
phrase: aggregate scale adjacent pairs between {low} to {high} using factor {factor}
test: list=2,3,4,8,1,5 low=4 high=7 factor=3
expect: => i=2 r=0.0 ok=true s="scaled pairs count: 2" errors=0 n=6 res=[6,9,4,8,3,15] cache=0 hits=0
test: list=10,20,3,4 low=5 high=10 factor=2
expect: => i=1 r=0.0 ok=true s="scaled pairs count: 1" errors=0 n=4 res=[10,20,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let fac = ${factor};
	var scaled = 0;
	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum >= lo && pair_sum <= hi {
			g.res[i] = g.res[i] * fac;
			g.res[i + 1] = g.res[i + 1] * fac;
			scaled++;
		}
		i += 2;
	}
	g.steps += scaled;
	out.i = scaled;
	out.ok = true;
	out.s.clear();
	format(out.s, "scaled pairs count: ", scaled);
	out
}
@end
