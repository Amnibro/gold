code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for w in words(v.s) {
		total += w.len;
		gold_push(g, total);
	}
	g.steps += total + 1;
	out.i = total;
	out
}
@end
@entry 941a45eb5ee28e1b
kind: step
verb: rotate
noun: odds
modifier: safely
context: text
phrase: rotate odds safely in text
phrase: safely shift odd indexed characters
test: text="abcdef"
expect: => i=3 r=0.0 ok=true s="abcdef" errors=0 n=3 res=[99,101,103] cache=0 hits=0
test: text="racecar"
expect: => i=3 r=0.0 ok=true s="racecar" errors=0 n=3 res=[98,102,98] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var idx = 0;
	for c in v.s {
		if idx % 2 != 0 {
			count++;
