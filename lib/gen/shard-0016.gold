phrase: line steep ridge with trees pitch {pitch}
slot: pitch real
test: pitch=2.0 doc="ground box 0,0,-.5 20,20,1"
expect: => i=2 r=0.0 ok=true s="tree" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: tree2 cone 0,0,0 0,0,4 r1 m:matte #285032
test: pitch=4.5 doc="field box 0,0,-.5 30,30,1|tree cyl 0,0,0 0,0,2 r0.2"
expect: => i=3 r=0.0 ok=true s="tree" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: field box 0,0,-.5 30,30,1
expect: => doc: tree cyl 0,0,0 0,0,2 r0.2
expect: => doc: tree3 cone 0,0,0 0,0,9 r2.25 m:matte #285032
test: pitch=-1.0
expect: => i=0 r=0.0 ok=false s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${pitch} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "tree", "", o);
	o.append(" cone 0,0,");
	o.append("0 0,");
	o.append("0,");
	gold_fnum(o, ${pitch} * 2.0);
	o.append(" r");
	gold_fnum(o, ${pitch} * 0.5);
	o.append(" m:matte ");
	gold_hex(o, 40, 80, 50);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tree");
	out
}
@end
