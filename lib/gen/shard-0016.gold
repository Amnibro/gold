code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_streak};
	var max_seen = 1;
	var cur = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
			if cur > max_seen { max_seen = cur; }
		} else {
			cur = 1;
		}
		i++;
	}
	if max_seen > lim {
		gold_fail(g, "error streak exceeded safe length");
	}
	g.steps += g.n;
	out.i = max_seen;
	out
}
@end
