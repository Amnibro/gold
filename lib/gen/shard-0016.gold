@entry 655e62fc0751ea89
kind: step
verb: return
noun: steps
modifier: recursively
context: retry
phrase: return retry steps recursively until {limit}
phrase: compute retry steps count recursively with limit {limit}
slot: limit int
test: input=6 limit=5
expect: => i=5 r=0.0 ok=true s="computed recursive retry steps" errors=0 n=5 res=[3,10,5,16,8] cache=0 hits=0
test: input=10 limit=2
expect: => i=2 r=0.0 ok=true s="computed recursive retry steps" errors=0 n=2 res=[5,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var steps = 0;
	var cur = out.i;
	while cur > 1 && steps < lim {
		if cur % 2 == 0 { cur /= 2; } else { cur = cur * 3 + 1; }
		gold_push(g, cur);
		steps++;
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "computed recursive retry steps");
	out
}
@end
@entry bee2bb65378f02d2
kind: step
verb: search
noun: list
modifier: unique
context: retry
phrase: search retry list for unique value matching {p}
phrase: find first unique retry element satisfying {p}
slot: p pred
test: list=1,2,2,3,4,4 p=is_odd
expect: => i=1 r=0.0 ok=true s="searched unique retry element" errors=0 n=6 res=[1,2,2,3,4,4] cache=0 hits=0
test: list=4,6,8,9 p=is_odd
expect: => i=9 r=0.0 ok=true s="searched unique retry element" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var target = 0;
	for i in g.n {
		let val = g.res[i];
		if ${p}(val) {
			var freq = 0;
			for j in g.n {
				if g.res[j] == val { freq++; }
			}
			if freq == 1 {
				target = val;
				found = true;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = if found { target } else { 0 };
	out.s.clear();
	format(out.s, "searched unique retry element");
	out
}
@end
@entry aa4553cc23c9cc25
kind: step
verb: repeat
noun: values
modifier: nested
context: retry
phrase: repeat nested retry values count {times}
phrase: duplicate nested retry elements by factor {times}
slot: times int
test: list=1,2 times=2
expect: => i=4 r=0.0 ok=true s="repeated nested retry values" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=3 times=3
expect: => i=3 r=0.0 ok=true s="repeated nested retry values" errors=0 n=3 res=[3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var buf = [0; 512];
	var pos = 0;
	for i in g.n {
		let val = g.res[i];
		var k = 0;
		while k < t && pos < 512 {
			buf[pos] = val;
			pos++;
			k++;
		}
	}
	for i in pos {
		g.res[i] = buf[i];
	}
	g.n = pos;
	g.steps += pos;
	out.i = pos;
	out.s.clear();
	format(out.s, "repeated nested retry values");
	out
}
@end
