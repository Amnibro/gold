fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${min_avg};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if i % 2 == 0 {
			sum += g.res[i];
			count++;
		}
	}
	let avg = if count > 0 { sum / count } else { 0 };
	let ok = count > 0 && avg >= ma;
	out.ok = ok;
	if !ok {
		gold_fail(g, "every other average below threshold");
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "validated every other retry average");
	out
}
@end
