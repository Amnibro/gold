test: list=10,20,25,40
expect: => i=3 r=0.0 ok=true s="kept gaps running" errors=0 n=3 res=[10,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var last = g.res[0];
	for i in 1..g.n {
		let gap = g.res[i] - last;
		last = g.res[i];
		g.res[i - 1] = gap;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept gaps running");
	out
}
@end
