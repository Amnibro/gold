test: list=7,2,9,4 times=1
expect: => i=1 r=0.0 ok=true s="shifted list" errors=0 n=4 res=[9,2,4,7] cache=0 hits=0
test: list=10,5,15,20 times=2
expect: => i=2 r=0.0 ok=true s="shifted list" errors=0 n=4 res=[15,20,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let t = if g.n > 0 { (${times} % g.n + g.n) % g.n } else { 0 };
	if t > 0 && g.n > 0 {
		var tmp int[512] = [0; 512];
		for i in g.n { tmp[(i + t) % g.n] = g.res[i]; }
		for i in g.n { g.res[i] = tmp[i]; }
	}
	g.steps += g.n;
	out.i = t;
	out.s.clear();
	format(out.s, "shifted list");
	out
}
@end
