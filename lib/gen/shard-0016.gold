expect: => i=7 r=0.0 ok=true s="sum middle in_reverse total: 7" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if m < 0 || m * 2 >= g.n {
		gold_fail(g, "sum middle in_reverse invalid margin");
		out.ok = false;
		return out;
	}
	var total = 0;
	let end_idx = g.n - m;
	for i in (end_idx - m) {
		let idx = end_idx - 1 - i;
		total += g.res[idx];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum middle in_reverse total: ", total);
	out
}
