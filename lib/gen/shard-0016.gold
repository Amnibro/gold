modifier: unique
context: compare
phrase: validate unique element count equals {expected}
phrase: verify count of distinct items {expected}
slot: expected int
test: list=5,10,5,20 expected=3
expect: => i=3 r=0.0 ok=true s="unique total matches 3" errors=0 n=4 res=[5,10,5,20] cache=0 hits=0
test: list=1,2,3,4 expected=4
expect: => i=4 r=0.0 ok=true s="unique total matches 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10 expected=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	if exp < 0 { gold_fail(g, "invalid expected"); out.ok = false; return out; }
	var u = 0;
	for i in g.n {
		var is_first = true;
		for j in i { if g.res[j] == g.res[i] { is_first = false; break; } }
		if is_first { u++; }
	}
	let is_match = u == exp;
	out.ok = is_match;
	out.i = u;
	out.s.clear();
	if is_match { format(out.s, "unique total matches ", u); }
	else { format(out.s, "unique count mismatch ", u); }
	out
}
@end
