@entry d59b2c9749bec544
kind: step
verb: split
noun: total
modifier: nested
context: aggregate
slot: parts int
phrase: split total nested in aggregate with {parts}
phrase: apply split total nested across aggregates with {parts}
test: list=10,20,30,40 parts=2
expect: => i=50 r=0.0 ok=true s="split total nested share: 50" errors=0 n=2 res=[50,50] cache=0 hits=0
test: list=5,15,25 parts=3
expect: => i=15 r=0.0 ok=true s="split total nested share: 15" errors=0 n=3 res=[15,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${parts};
	if p <= 0 || g.n == 0 {
		gold_fail(g, "split total nested requires positive parts");
		out.ok = false;
		return out;
	}
	var tot = 0;
	for i in g.n { tot += g.res[i]; }
	let share = tot / p;
	let rem = tot % p;
	gold_clear(g);
	for i in p {
		let chunk = if i == p - 1 { share + rem } else { share };
		gold_push(g, chunk);
	}
	g.steps += g.n;
	out.i = share;
	out.s.clear();
	format(out.s, "split total nested share: ", share);
	out
}
@end
@entry e82ad48f4ee2f182
kind: step
verb: fill
noun: vowels
modifier: unique
context: aggregate
slot: target int
phrase: fill vowels unique in aggregate with {target}
phrase: apply fill vowels unique across aggregates with {target}
test: text="apple" target=3
expect: => i=3 r=0.0 ok=true s="applei" errors=0 n=0 res=[] cache=0 hits=0
test: text="sky" target=2
expect: => i=2 r=0.0 ok=true s="skyae" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if tgt <= 0 {
		gold_fail(g, "fill vowels unique requires positive target");
		out.ok = false;
		return out;
	}
	var seen_a = false;
	var seen_e = false;
	var seen_i = false;
	var seen_o = false;
	var seen_u = false;
	for k in v.s.len {
		let c = v.s[k];
		if c == 'a' || c == 'A' { seen_a = true; }
		else if c == 'e' || c == 'E' { seen_e = true; }
		else if c == 'i' || c == 'I' { seen_i = true; }
		else if c == 'o' || c == 'O' { seen_o = true; }
		else if c == 'u' || c == 'U' { seen_u = true; }
	}
	var distinct = 0;
	if seen_a { distinct++; }
	if seen_e { distinct++; }
	if seen_i { distinct++; }
	if seen_o { distinct++; }
	if seen_u { distinct++; }
	while distinct < tgt {
		if !seen_a { v.s.push('a'); seen_a = true; distinct++; }
		else if !seen_e { v.s.push('e'); seen_e = true; distinct++; }
		else if !seen_i { v.s.push('i'); seen_i = true; distinct++; }
		else if !seen_o { v.s.push('o'); seen_o = true; distinct++; }
		else if !seen_u { v.s.push('u'); seen_u = true; distinct++; }
		else { break; }
	}
	g.steps += distinct;
	out.i = distinct;
	out.s = copy(v.s);
	out
}
@end
