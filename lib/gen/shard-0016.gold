@entry 2643a01a31895c07
kind: step
verb: find
noun: item
modifier: with_retry
context: sort
phrase: find item {target} in sorted list allowing {retries} retries
phrase: search for item {target} within sorted items using {retries} retries
slot: target int
slot: retries int
test: list=9,3,7,1,5 target=7 retries=5
expect: => i=2 r=0.0 ok=true s="searched with retry" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=10,2,6 target=4 retries=3
expect: => i=2 r=0.0 ok=false s="searched with retry" errors=0 n=3 res=[2,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var low = 0;
	var high = g.n - 1;
	var tries = 0;
	var found = false;
	while low <= high && tries < ${retries} {
		tries++;
		let mid = (low + high) / 2;
		if g.res[mid] == ${target} {
			found = true;
			break;
		} else if g.res[mid] < ${target} {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
	}
	g.steps += tries;
	out.ok = found;
	out.i = tries;
	out.s.clear();
	format(out.s, "searched with retry");
	out
}
@end
