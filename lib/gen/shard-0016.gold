@entry 7a64a1ef5fb9b44c
kind: step
verb: fill
noun: errors
modifier: until
context: transform
phrase: fill errors until condition {p} met
phrase: flag errors until predicate {p} holds
slot: p pred
test: list=2,4,1,8 p=is_one
expect: => i=2 r=0.0 ok=true s="" errors=2 n=4 res=[2,4,1,8] cache=0 hits=0
test: list=5,3,0,7 p=is_zero
expect: => i=2 r=0.0 ok=true s="" errors=2 n=4 res=[5,3,0,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			break;
		}
		gold_fail(g, "error triggered until condition");
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out
}
@end
