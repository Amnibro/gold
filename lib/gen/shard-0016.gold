code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let pairs = g.n / 2;
	var total = 0;
	for i in pairs {
		let sum = g.res[i * 2] + g.res[i * 2 + 1];
		let merged = ${fn_merge}(sum);
		g.res[i] = merged;
		total += merged;
	}
	g.n = pairs;
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "safely merged function sum: ", total);
	out
}
@end
@entry 61325136933d8979
kind: step
verb: swap
noun: runs
modifier: at_least
context: aggregate
slot: min_len int
phrase: swap runs at least length {min_len} in aggregate
phrase: aggregate invert signs of runs at least {min_len} long
test: list=5,5,5,2,3,3 min_len=3
expect: => i=3 r=0.0 ok=true s="inverted elements in runs: 3" errors=0 n=6 res=[-5,-5,-5,2,3,3] cache=0 hits=0
test: list=8,8,9,9,9,9 min_len=2
expect: => i=6 r=0.0 ok=true s="inverted elements in runs: 6" errors=0 n=6 res=[-8,-8,-9,-9,-9,-9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_len};
	var inverted = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == val {
			run_len++;
		}
		if run_len >= limit {
			for j in run_len {
				g.res[i + j] = -g.res[i + j];
			}
			inverted += run_len;
		}
		i += run_len;
	}
	out.i = inverted;
	out.ok = true;
	out.s.clear();
	format(out.s, "inverted elements in runs: ", inverted);
	out
}
@end
@entry b852479525ab0c39
kind: step
verb: merge
noun: series
modifier: sorted
context: aggregate
phrase: merge series sorted unique sums in aggregate
phrase: aggregate sort sequential duplicate runs into totals
test: list=4,2,4,2,5
expect: => i=3 r=0.0 ok=true s="sorted merged series size: 3" errors=0 n=3 res=[4,8,5] cache=0 hits=0
test: list=7,1,7,1,1
expect: => i=2 r=0.0 ok=true s="sorted merged series size: 2" errors=0 n=2 res=[3,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var sum = val;
		var j = i + 1;
		while j < g.n && g.res[j] == val {
			sum += g.res[j];
			j++;
		}
		g.res[new_n] = sum;
		new_n++;
		i = j;
	}
	g.n = new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted merged series size: ", new_n);
	out
}
@end
