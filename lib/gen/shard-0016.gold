slot: pivot int
test: list=1,3,5,7,9 pivot=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=9,2,5 pivot=4
expect: => i=-1 r=0.0 ok=true s="" errors=1 n=3 res=[9,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let piv = ${pivot};
	var sorted = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
		i++;
	}
	if !sorted {
		gold_fail(g, "error list is not sorted");
		out.i = -1;
		return out;
	}
	var low = 0;
	for k in g.n {
		if g.res[k] <= piv {
			low++;
		}
	}
	g.steps += g.n;
	out.i = low;
	out
}
@end
