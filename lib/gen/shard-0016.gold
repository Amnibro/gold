fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let fac = ${factor};
	if k <= 0 || g.n == 0 {
		gold_fail(g, "invalid tail selection");
		out.ok = false;
		return out;
	}
	var count = k;
	if count > g.n { count = g.n; }
	let start = g.n - count;
	var sum = 0;
	for i in count {
		let val = g.res[start + i];
		g.res[i] = val;
		sum += val;
	}
	g.n = count;
	out.i = sum * fac;
	out.ok = true;
	out.s.clear();
	format(out.s, "selected tail scaled total: ", out.i);
	out
}
@end
