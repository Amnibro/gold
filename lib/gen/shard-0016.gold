fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_key = ${max_key};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var hits = 0;
	var k = 0;
	while k <= max_key {
		let val, ok = gold_cache_get(g, k);
		if ok { hits++; }
		k++;
	}
	g.steps += k;
	out.i = hits;
	out.s.clear();
	format(out.s, "cache hits while: ", hits);
	out
}
@end
