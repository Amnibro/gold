			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var in_range = 0;
	for k in g.n {
		if g.res[k] > ${lo} && g.res[k] < ${hi} { in_range++; }
	}
	g.steps += g.n;
	out.i = in_range;
	out.s.clear();
	format(out.s, "split between bounds");
	out
}
@end
