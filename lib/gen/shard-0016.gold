fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streaks = 0;
	if g.n > 0 {
		var cur_val = g.res[0];
		var cur_len = 1;
		streaks = 1;
		for i in 1..g.n {
			if g.res[i] == cur_val {
				cur_len++;
			} else {
				gold_cache_put(g, cur_val, cur_len);
				cur_val = g.res[i];
				cur_len = 1;
				streaks++;
			}
		}
		gold_cache_put(g, cur_val, cur_len);
	}
	g.steps += g.n;
	out.i = streaks;
	out
}
