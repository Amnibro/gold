@entry 24fa3f655c82e9f6
kind: step
verb: drop
noun: middle
modifier: up_to
context: transform
phrase: drop middle elements up to count {count}
phrase: remove middle values up to limit {count}
slot: count int
test: list=1,2,3,4,5 count=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
test: list=10,20,30,40,50,60 count=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${count};
	if g.n > 2 && count > 0 {
		var to_drop = count;
		if to_drop > g.n - 2 { to_drop = g.n - 2; }
		var mid = g.n / 2;
		var start = mid - to_drop / 2;
		if start < 1 { start = 1; }
		var end = start + to_drop;
		if end > g.n - 1 { end = g.n - 1; }
		var actual_drop = end - start;
		for i in end..g.n {
			g.res[i - actual_drop] = g.res[i];
		}
		g.n -= actual_drop;
		out.i = actual_drop;
	}
	g.steps += g.n;
	out
}
@end
