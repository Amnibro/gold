fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let allowed = ${max_allowed};
	var last_dup = -1;
	var total_dups = 0;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] {
				last_dup = j;
				total_dups++;
			}
		}
	}
	if last_dup >= 0 {
		gold_cache_put(g, 99, last_dup);
	}
	if total_dups > allowed {
		gold_fail(g, "duplicate count exceeds allowed limit");
	}
	g.steps += g.n;
	out.i = last_dup;
	out
}
@end
