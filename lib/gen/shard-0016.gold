code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let take = if k < g.n { k } else { g.n };
	let start = g.n - take;
	var i = 0;
	while i < take {
		g.res[i] = g.res[start + i];
		i++;
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "collected suffix up to limit: ", take);
	out
}
@end
