fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var prefix_sum = 0;
	var matches = 0;
	for i in g.n {
		prefix_sum += g.res[i];
		if prefix_sum <= th { matches++; }
	}
	g.steps += g.n;
	out.i = matches;
