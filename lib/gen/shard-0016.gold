fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 || win > g.n {
		gold_fail(g, "window width exceeds size");
		out.ok = false;
		return out;
	}
	let num_windows = g.n - win + 1;
	var max_sum = 0;
	var first = true;
	for i in num_windows {
		var cur_sum = 0;
		for j in win {
			cur_sum += g.res[i + j];
		}
		if first || cur_sum > max_sum {
			max_sum = cur_sum;
			first = false;
		}
		g.res[i] = cur_sum;
	}
	g.n = num_windows;
	out.i = max_sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "scan window maximum sum: ", max_sum);
	out
}
@end
@entry 8a2373aac1c0c0b6
kind: step
verb: pair
noun: maximum
modifier: none
context: aggregate
phrase: pair maximum values across neighbors in aggregate
phrase: aggregate pair maximum reduction on adjacent items
test: list=4,9,12,3,7,8
expect: => i=12 r=0.0 ok=true s="pair maximum peak: 12" errors=0 n=3 res=[9,12,8] cache=0 hits=0
test: list=15,2,8,20
expect: => i=20 r=0.0 ok=true s="pair maximum peak: 20" errors=0 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let pairs = g.n / 2;
	for i in pairs {
		let a = g.res[i * 2];
		let b = g.res[i * 2 + 1];
		g.res[i] = if a > b { a } else { b };
	}
	g.n = pairs;
	var grand_max = g.res[0];
	for i in 1..pairs {
		if g.res[i] > grand_max { grand_max = g.res[i]; }
	}
	out.i = grand_max;
	out.ok = true;
	out.s.clear();
	format(out.s, "pair maximum peak: ", grand_max);
	out
}
@end
