@entry 248d25ad09f003e4
kind: step
verb: collect
noun: maximum
modifier: safely
context: error
phrase: collect maximum error value safely under ceiling {ceiling}
phrase: extract peak fault number safely below ceiling {ceiling}
slot: ceiling int
test: list=10,55,20 ceiling=50
expect: => i=55 r=0.0 ok=true s="" errors=1 n=3 res=[10,55,20] cache=0 hits=0
test: list=10,25,30 ceiling=40
expect: => i=30 r=0.0 ok=true s="" errors=0 n=3 res=[10,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] > mx {
			mx = g.res[i];
		}
	}
	if mx >= ceil_val {
		gold_fail(g, "maximum value breached safe ceiling");
	}
	g.steps += g.n;
	out.i = mx;
	out
}
@end
@entry e8f9c95c94f34aa3
kind: step
