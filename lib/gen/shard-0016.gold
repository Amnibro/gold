fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = words(v.s);
	var res byte[>..] = [];
	var q = ws.len - 1;
	while q >= 0 {
		if res.len > 0 { res.push(' '); }
		res.append(ws[q]);
		q--;
	}
	gold_text(out, res);
	g.steps += ws.len + 1;
	out.i = ws.len;
	out
}
