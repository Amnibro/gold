@entry cb144e461e8d6bab
kind: step
verb: filter
noun: squares
modifier: safely
context: retry
slot: bound int
phrase: filter squares safely under bound {bound}
phrase: safely preserve square numbers below {bound}
test: list=4,7,9,12,16 bound=10
expect: => i=2 r=0.0 ok=true s="safely filtered squares count: 2" errors=0 n=2 res=[4,9] cache=0 hits=0
test: list=1,3,4,8,25 bound=20
expect: => i=2 r=0.0 ok=true s="safely filtered squares count: 2" errors=0 n=2 res=[1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 && x <= b {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
