fn ${ID}(g Gold&, v Val) Val {
	// step_reverse_gaps_pairwise
	var out = v;
	let d = ${delta};
	var i = 0;
	var matches = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] == d {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			matches++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = matches;
	out
}
