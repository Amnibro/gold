@entry c91b81a3361b1e8a
kind: step
verb: scale
noun: digits
modifier: first
context: core
slot: factor int
phrase: scale digits first element by {factor}
phrase: multiply first value digits by factor {factor}
test: list=123,456 factor=2
expect: => i=246 r=0.0 ok=true s="scaled first digits: 246" errors=0 n=2 res=[246,456] cache=0 hits=0
test: list=34,50 factor=3
expect: => i=92 r=0.0 ok=true s="scaled first digits: 92" errors=0 n=2 res=[92,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		gold_fail(g, "empty results");
		out.ok = false;
		return out;
	}
	var x = g.res[0];
	var is_neg = x < 0;
	if is_neg { x = -x; }
	var digits int[32] = [0; 32];
	var dn = 0;
	if x == 0 { digits[0] = 0; dn = 1; }
	else {
		while x > 0 {
			digits[dn] = x % 10;
			dn++;
			x /= 10;
		}
	}
	var new_val = 0;
	for k in dn {
		let d = digits[dn - 1 - k] * f;
		new_val = new_val * 10 + (d % 10);
	}
	if is_neg { new_val = -new_val; }
	g.res[0] = new_val;
	g.steps += dn;
	out.i = new_val;
	out.s.clear();
	format(out.s, "scaled first digits: ", new_val);
	out
}
@end
