fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	let max_cap = ${cap};
	if win <= 0 || win > g.n {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let num_windows = g.n - win + 1;
	var valid = true;
	var max_found = 0;
	for i in num_windows {
		var sum = 0;
		for j in win { sum += g.res[i + j]; }
		if sum > max_cap { valid = false; }
		if sum > max_found { max_found = sum; }
	}
	out.ok = valid;
	out.i = max_found;
	out.s.clear();
	if valid {
		format(out.s, "all windows within cap: ", max_found);
	} else {
		format(out.s, "window exceeded cap: ", max_found);
	}
	out
}
@end
