@entry 01cff811ffb8dacc
kind: step
verb: fill
noun: range
modifier: at_least
context: aggregate
slot: min_span int
phrase: fill range at_least in aggregate with {min_span}
phrase: apply fill range at_least across aggregates with {min_span}
test: list=10,12,14 min_span=8
expect: => i=8 r=0.0 ok=true s="fill range at_least ensured span: 8" errors=0 n=4 res=[10,12,14,18] cache=0 hits=0
test: list=5,6 min_span=6
expect: => i=6 r=0.0 ok=true s="fill range at_least ensured span: 6" errors=0 n=3 res=[5,6,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_span};
	if req <= 0 || g.n == 0 {
		gold_fail(g, "fill range at_least requires positive span");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let current_span = max_val - min_val;
	if current_span < req {
		let missing = req - current_span;
		gold_push(g, max_val + missing);
	}
	g.steps += g.n;
	out.i = req;
	out.s.clear();
	format(out.s, "fill range at_least ensured span: ", req);
	out
}
@end
