code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var selected int[64];
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a % 2 == 0 && count < 64 { selected[count] = a; count++; }
		else if b % 2 == 0 && count < 64 { selected[count] = b; count++; }
		i += 2;
	}
	gold_clear(g);
	for k in count { gold_push(g, selected[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "selected evens pairwise: ", count);
	out
}
@end
