fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let head = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = head;
		out.i = head;
	}
	g.steps += g.n;
	out
}
@end
