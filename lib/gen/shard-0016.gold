fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${keep};
	if k <= 0 {
		gold_fail(g, "limit suffix in_place requires positive count");
		out.ok = false;
		return out;
	}
	if k < g.n {
		let start = g.n - k;
		for i in k {
			g.res[i] = g.res[start + i];
		}
		g.n = k;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limit suffix in_place kept: ", g.n);
	out
}
@end
