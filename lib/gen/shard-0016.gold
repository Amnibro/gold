expect: => i=4 r=0.0 ok=true s="window sorted" errors=0 n=4 res=[4,10,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = if ${w_size} < 1 { 1 } else { ${w_size} };
	var i = 0;
	while i + sz <= g.n {
		for a in i..(i + sz) {
			var m = a;
			for b in (a + 1)..(i + sz) {
				if g.res[b] < g.res[m] { m = b; }
			}
			if m != a {
				let tmp = g.res[a];
				g.res[a] = g.res[m];
				g.res[m] = tmp;
			}
		}
		i += sz;
	}
	g.steps += g.n;
	out.i = i;
	out.s.clear();
	format(out.s, "window sorted");
	out
}
@end
