code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = v.s.len;
	if n > 1 {
		let last = out.s[n - 1];
		var q = n - 1;
		while q > 0 {
			out.s[q] = out.s[q - 1];
			q--;
		}
		out.s[0] = last;
	}
	g.steps += n + 1;
	out.i = n;
	out
}
@end
