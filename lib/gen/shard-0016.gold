expect: => i=9 r=0.0 ok=true s="merged checkpoints while pred: 3" errors=0 n=3 res=[9,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var merged = 0;
	while merged < g.n && ${p}(g.res[merged]) {
		sum += g.res[merged];
		merged++;
	}
	if merged > 1 {
		g.res[0] = sum;
		for i in merged..g.n {
			g.res[i - merged + 1] = g.res[i];
		}
		g.n = g.n - merged + 1;
	}
	g.steps += merged;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged checkpoints while pred: ", merged);
	out
}
@end
