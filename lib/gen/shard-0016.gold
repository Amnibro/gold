code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${mark};
	if idx < 0 || idx >= g.n {
		gold_fail(g, "checkpoint index out of range");
		out.i = -1;
		return out;
	}
	gold_cache_put(g, idx, g.res[idx]);
	g.steps += 1;
	out.i = g.res[idx];
	out
}
