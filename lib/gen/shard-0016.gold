phrase: compare range all in aggregate with {bound}
phrase: apply compare range all across aggregates with {bound}
test: list=5,8,12 bound=10
expect: => i=7 r=0.0 ok=true s="compare range all span: 7 bound: 10" errors=0 n=3 res=[5,8,12] cache=0 hits=0
test: list=1,20 bound=15
expect: => i=19 r=0.0 ok=false s="compare range all span: 19 bound: 15" errors=0 n=2 res=[1,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b <= 0 || g.n == 0 {
		gold_fail(g, "compare range all requires positive bound");
		out.ok = false;
		return out;
	}
	var lo = g.res[0];
	var hi = g.res[0];
	for i in g.n {
		if g.res[i] < lo { lo = g.res[i]; }
		if g.res[i] > hi { hi = g.res[i]; }
	}
	let span = hi - lo;
	let ok_range = span <= b;
	out.ok = ok_range;
	out.i = span;
	out.s.clear();
	format(out.s, "compare range all span: ", span, " bound: ", b);
	g.steps += g.n;
	out
}
@end
@entry 28863953a064e15b
kind: step
verb: shift
noun: list
modifier: in_place
context: aggregate
slot: offset int
phrase: shift list in_place in aggregate with {offset}
phrase: apply shift list in_place across aggregates with {offset}
test: list=1,2,3,4,5 offset=2
expect: => i=2 r=0.0 ok=true s="shift list in_place offset: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 offset=1
expect: => i=1 r=0.0 ok=true s="shift list in_place offset: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if off <= 0 || g.n == 0 {
		gold_fail(g, "shift list in_place requires positive offset");
		out.ok = false;
		return out;
	}
	let shift_k = off % g.n;
	var temp int[512] = [0; 512];
	for i in g.n { temp[i] = g.res[i]; }
	for i in g.n {
		let src_idx = (i + g.n - shift_k) % g.n;
		g.res[i] = temp[src_idx];
	}
	g.steps += g.n;
	out.i = shift_k;
	out.s.clear();
	format(out.s, "shift list in_place offset: ", shift_k);
	out
}
@end
@entry 39012194181c5608
kind: step
verb: cache
