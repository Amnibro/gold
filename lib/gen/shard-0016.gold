@entry 25bea5ac2e7fcce4
kind: step
verb: filter
noun: suffix
modifier: nested
context: text
phrase: filter suffix nested words
phrase: extract words with nested suffix ending
test: text="running jumping singing fast"
expect: => i=3 r=0.0 ok=true s="running jumping singing fast" errors=0 n=3 res=[7,7,7] cache=0 hits=0
test: text="the quick red fox"
expect: => i=0 r=0.0 ok=true s="the quick red fox" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for w in words(v.s) {
		if w.len > 2 && w[w.len - 1] == 'g' && w[w.len - 2] == 'n' {
			count++;
			gold_push(g, w.len);
		}
	}
	g.steps += count + 1;
	out.i = count;
	out
}
@end
