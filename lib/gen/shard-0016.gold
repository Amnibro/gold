	if ${dx} <= 0.0 { out.ok = false; return out; }
	var o byte[>..] = [];
	gold_dnews(g, "door_dup", "", o);
	o.append(" box ");
	gold_fnum(o, ${dx});
	o.append(",0,1.");
	o.append("2 1,");
	o.append("0.1,");
	o.append("2.4 m:matte #");
	o.append("5c4");
	o.append("03");
	o.append("3");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "dupdoor");
	out
}
@end
