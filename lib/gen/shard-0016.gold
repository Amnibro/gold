fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var cur_d = 0;
	while cur_d < d && g.n > 1 {
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n--;
		cur_d++;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "recursively folded gap sum: ", sum);
	out
}
