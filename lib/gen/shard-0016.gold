code:
fn ${ID}(g Gold&, v Val) Val {
	// step_scan_budget_last
	var out = v;
	let req = ${min_left};
	var spent = 0;
	for i in g.n { spent += g.res[i]; }
	let remain = 100 - spent;
	if remain < req {
		gold_fail(g, "final budget headroom insufficient");
	}
	g.steps += g.n;
	out.i = remain;
	out
}
@end
@entry 896d389fdb22e777
kind: step
verb: swap
noun: tail
modifier: with_retry
context: error
phrase: swap tail error record with retry limit {max_attempts}
phrase: exchange trailing fault entry attempting up to {max_attempts}
slot: max_attempts int
test: list=10,20,30 max_attempts=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,30,20] cache=0 hits=0
test: list=5,15 max_attempts=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_swap_tail_with_retry
	var out = v;
	let att = ${max_attempts};
	if g.n >= 2 {
		let a = g.n - 2;
		let b = g.n - 1;
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		out.i = att;
	} else {
		gold_fail(g, "insufficient elements for tail swap");
	}
	g.steps += att;
	out
}
@end
@entry 5aa02ccec5b92c75
kind: step
verb: retry
noun: head
modifier: each
context: error
phrase: retry head error evaluation for each item {retries} times
phrase: evaluate leading fault items repeating each {retries} passes
slot: retries int
test: list=10,20,30 retries=2
expect: => i=120 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 retries=3
expect: => i=60 r=0.0 ok=true s="" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_retry_head_each
	var out = v;
	let r = ${retries};
	var sum = 0;
	for i in g.n {
		var passes = 0;
		while passes < r {
			sum += g.res[i];
			passes++;
		}
	}
	g.steps += g.n * r;
	out.i = sum;
	out
}
@end
@entry 61ddcef57e0e9dc5
kind: step
verb: count
noun: runs
modifier: safely
context: error
phrase: count error consecutive runs safely under {max_len}
phrase: tally consecutive fault sequences bounding length by {max_len}
slot: max_len int
test: list=1,1,1,2,2 max_len=4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,1,1,2,2] cache=0 hits=0
test: list=5,5,5,5,5 max_len=3
expect: => i=5 r=0.0 ok=true s="" errors=1 n=5 res=[5,5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_count_runs_safely
	var out = v;
	let limit = ${max_len};
	var current_run = 1;
	var max_observed = if g.n > 0 { 1 } else { 0 };
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			current_run++;
			if current_run > max_observed { max_observed = current_run; }
		} else {
			current_run = 1;
		}
		i++;
	}
	if max_observed > limit {
		gold_fail(g, "consecutive run exceeds maximum allowed length");
	}
	g.steps += g.n;
	out.i = max_observed;
	out
}
@end
