@entry efb1e7a69a13eac7
kind: step
verb: shift
noun: gaps
modifier: at_most
context: transform
phrase: shift gaps at most bounded by {maxgap}
phrase: adjust gaps at most reaching {maxgap}
slot: maxgap int
test: list=10,12,18,20 maxgap=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,13,18,21] cache=0 hits=0
test: list=5,10,15,20 maxgap=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[5,11,16,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let maxgap = ${maxgap};
	var shifted = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let gap = g.res[i] - g.res[i - 1];
			if gap <= maxgap {
				g.res[i] += 1;
				shifted++;
			}
		}
	}
	g.steps += g.n;
	out.i = shifted;
	out
}
@end
