test: list=2,5,7,8,11,14 min_val=4
expect: => i=3 r=0.0 ok=true s="sorted filtered odds count: 3" errors=0 n=3 res=[5,7,11] cache=0 hits=0
test: list=1,3,6,9,12 min_val=2
expect: => i=2 r=0.0 ok=true s="sorted filtered odds count: 2" errors=0 n=2 res=[3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min_val};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > min_v {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = w;
	out.ok = w > 0;
	out.s.clear();
	format(out.s, "sorted filtered odds count: ", w);
	g.steps += w;
	out
}
@end
