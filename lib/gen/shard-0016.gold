@entry aada43ffe633a49f
kind: step
verb: merge
noun: window
modifier: with_retry
context: aggregate
phrase: merge sliding window with retry using width {span}
phrase: aggregate rolling window with retry of size {span}
slot: span int
test: list=1,2,3,4,5 span=3
expect: => i=27 r=0.0 ok=true s="merged windows: 3" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=10,20,30,40 span=2
expect: => i=150 r=0.0 ok=true s="merged windows: 3" errors=0 n=3 res=[30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${span};
	if g.n < span || span <= 0 { return out; }
	let num_wins = g.n - span + 1;
	for i in num_wins {
		var wsum = 0;
		for j in span {
			wsum = wsum + g.res[i + j];
		}
		g.res[i] = wsum;
	}
	g.n = num_wins;
	var total = 0;
	for i in g.n { total = total + g.res[i]; }
	g.steps += num_wins;
	out.i = total;
	out.s.clear();
	format(out.s, "merged windows: ", num_wins);
	out
}
@end
