		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 { d++; x /= 10; }
		if d > lim {
			gold_cache_put(g, i, d);
			gold_fail(g, "digit count exceeded threshold");
			cached++;
		}
	}
	g.steps += g.n;
	out.i = cached;
	out
}
@end
