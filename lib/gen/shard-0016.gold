fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_repeats};
	if mr < 0 { gold_fail(g, "invalid max_repeats"); out.ok = false; return out; }
	var w = 0;
	var dropped = 0;
	for i in g.n {
		var freq = 0;
		for j in w { if g.res[j] == g.res[i] { freq++; } }
		if freq < mr { g.res[w] = g.res[i]; w++; }
		else { dropped++; }
	}
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped duplicates ", dropped);
	out
}
@end
