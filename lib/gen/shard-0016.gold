test: list=1,7,9,11,13,99
expect: => i=4 r=0.0 ok=true s="unique middle elements: 4" errors=0 n=4 res=[7,9,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_clear(g);
		out.i = 0;
		out.ok = true;
		out.s.clear();
		format(out.s, "middle slice empty");
		return out;
	}
	let mid_len = g.n - 2;
	var new_n = 0;
	for i in mid_len {
		let val = g.res[1 + i];
		var seen = false;
		for j in new_n {
			if g.res[j] == val { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = val;
			new_n++;
		}
	}
	g.n = new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "unique middle elements: ", new_n);
	out
}
@end
