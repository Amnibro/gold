@entry 70e52b72b4ce7d73
kind: step
verb: mask
noun: leather
modifier: smooth
context: texture
phrase: mask smooth leather diffuse map with seed {u}
phrase: render smooth leather surface texture using seed {u}
slot: u int
model: noise c=4 u=${u}; slope; contrast a=1.12
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.319 sum8=7236 hash=597163
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.321 sum8=21072 hash=82241
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s_s1 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_s1[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_s1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.12 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
@end
@entry 06e3cf8cb539931a
