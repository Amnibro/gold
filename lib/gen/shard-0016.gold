fn ${ID}(n int) bool {
	let tgt = ${target};
	var x = if n < 0 { -n } else { n };
	var count = 0;
	var temp = x;
	while temp > 0 { count++; temp /= 10; }
	if count == 0 { return tgt == 0; }
	var mid = count / 2;
	while mid > 0 { x /= 10; mid--; }
	x % 10 == tgt
}
