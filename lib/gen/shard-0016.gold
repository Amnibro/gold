	let mx = ${max_sq};
	var squares_found = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { is_sq = true; }
		}
		if !is_sq || x > mx {
			gold_fail(g, "value exceeded maximum allowed square");
		} else {
			squares_found++;
		}
	}
	g.steps += g.n;
	out.i = squares_found;
	out
}
