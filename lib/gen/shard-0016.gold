@entry 9ac895d60658ca0c
kind: step
verb: pair
noun: average
modifier: at_least
context: error
phrase: pair error average maintaining at least {min_avg}
phrase: verify adjacent average fault level reaching at least {min_avg}
slot: min_avg int
test: list=10,20,30,40 min_avg=15
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=4,8,12,16 min_avg=10
expect: => i=2 r=0.0 ok=true s="" errors=1 n=4 res=[4,8,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_pair_average_at_least
	var out = v;
	let required = ${min_avg};
	var i = 0;
	var valid_pairs = 0;
	while i + 1 < g.n {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		if avg < required {
			gold_fail(g, "pairwise average below required minimum");
		} else {
			valid_pairs++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = valid_pairs;
	out
}
@end
