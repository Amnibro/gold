fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${k};
	if cnt <= 0 || cnt > g.n { gold_fail(g, "invalid k"); out.ok = false; return out; }
	for i in cnt {
		for j in (i + 1)..cnt {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = cnt;
	out.s.clear();
	format(out.s, "prefix sorted ", cnt);
	out
}
@end
