code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	if r < 0 || g.n == 0 || g.n + r > 500 { gold_fail(g, "invalid reps"); out.ok = false; return out; }
	var min_v = g.res[0];
	for i in 1..g.n { if g.res[i] < min_v { min_v = g.res[i]; } }
	for rep in r { gold_push(g, min_v); }
	out.i = min_v;
	out.s.clear();
	format(out.s, "repeated minimum ", min_v);
	out
}
@end
@entry c5bd55f209a72796
kind: step
verb: filter
noun: total
modifier: in_reverse
context: compare
phrase: filter reverse elements exceeding {threshold}
phrase: keep backward values above threshold {threshold}
slot: threshold int
test: list=10,25,5,30 threshold=15
expect: => i=2 r=0.0 ok=true s="reverse kept 2" errors=0 n=2 res=[30,25] cache=0 hits=0
test: list=8,18,4,28 threshold=10
expect: => i=2 r=0.0 ok=true s="reverse kept 2" errors=0 n=2 res=[28,18] cache=0 hits=0
test: list=10 threshold=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th < 0 { gold_fail(g, "invalid threshold"); out.ok = false; return out; }
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > th { kept[kn] = g.res[i]; kn++; }
		i--;
	}
	for j in kn { g.res[j] = kept[j]; }
	g.n = kn;
	out.i = kn;
	out.s.clear();
	format(out.s, "reverse kept ", kn);
	out
}
@end
