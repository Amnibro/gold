code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var n = lo;
	while n <= hi {
		if n >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= n {
				if n % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				gold_push(g, n);
				count++;
			}
		}
		n++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "found primes between: ", count);
	out
}
@end
