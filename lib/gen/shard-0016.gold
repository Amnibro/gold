fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${sep};
	var res byte[>..] = [];
	for i in v.s.len {
		if v.s[i] == ' ' {
			for b in sp { res.push(b); }
		} else {
			res.push(v.s[i]);
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += v.s.len;
	out.i = v.s.len;
	out
}
@end
