	var x = if n < 0 { -n } else { n };
	var d int[20] = [0; 20];
	var len = 0;
	if x == 0 { return 0; }
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	for i in len {
		for j in i + 1..len {
			if d[i] > d[j] {
				let tmp = d[i];
				d[i] = d[j];
				d[j] = tmp;
			}
		}
	}
	var count = 0;
	var i = 0;
	while i + 1 < len {
		if d[i + 1] - d[i] >= min_step {
			count++;
		}
		i++;
	}
	count
}
