fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = ${num};
	let cached, ok = gold_cache_get(g, n);
	if ok {
		gold_push(g, n + cached);
	} else {
		gold_cache_put(g, n, n * 2);
		gold_push(g, n);
	}
	g.steps++;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged number with cache");
	out
}
@end
