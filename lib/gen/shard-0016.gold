code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_steps};
	var x = out.i;
	var steps = 0;
	while x > 1 && steps < lim {
		if x % 2 == 0 { x /= 2; }
		else { x = 3 * x + 1; }
		steps++;
	}
	if steps >= lim {
		gold_fail(g, "step count reached maximum allowed");
	}
	g.steps += steps;
	out.i = steps;
	out
}
@end
