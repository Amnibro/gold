@entry f2c64bb62e7944a1
kind: step
verb: scan
noun: vowels
modifier: pairwise
context: core
phrase: scan vowels pairwise in text
phrase: inspect adjacent vowel pairs in string
test: text="audio"
expect: => i=2 r=0.0 ok=true s="vowel pairs: 2" errors=0 n=2 res=[214,216] cache=0 hits=0
test: text="sequoia"
expect: => i=3 r=0.0 ok=true s="vowel pairs: 3" errors=0 n=3 res=[228,216,202] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	fn is_vowel(c byte) bool {
		c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U'
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < v.s.len {
		if is_vowel(v.s[i]) && is_vowel(v.s[i + 1]) {
			pairs++;
			gold_push(g, (v.s[i] as int) + (v.s[i + 1] as int));
		}
		i++;
	}
	g.steps += v.s.len;
	out.i = pairs;
	out.s.clear();
	format(out.s, "vowel pairs: ", pairs);
	out
}
@end
@entry aa393a4dfef70ef6
kind: step
verb: keep
noun: head
modifier: last
context: core
slot: count int
phrase: keep head last elements total {count}
phrase: retain prefix head combined with last {count} items
test: list=1,2,3,4,5,6 count=2
expect: => i=3 r=0.0 ok=true s="kept head and last: 3" errors=0 n=3 res=[1,2,6] cache=0 hits=0
test: list=10,20,30,40 count=1
expect: => i=2 r=0.0 ok=true s="kept head and last: 2" errors=0 n=2 res=[10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || c >= g.n {
		gold_fail(g, "invalid count");
		out.ok = false;
		return out;
	}
	var new_res int[512] = [0; 512];
	var new_n = 0;
	for i in c {
		new_res[new_n] = g.res[i];
		new_n++;
	}
	new_res[new_n] = g.res[g.n - 1];
	new_n++;
	for j in new_n { g.res[j] = new_res[j]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept head and last: ", new_n);
	out
}
@end
@entry da9b08bf699cb4a0
kind: step
verb: select
noun: items
modifier: pairwise
context: core
slot: cond pred
phrase: select items pairwise satisfying predicate {cond}
phrase: filter pairwise elements where sum matches {cond}
test: list=1,3,2,4,5,7 cond=is_even
expect: => i=3 r=0.0 ok=true s="selected 3 pairs" errors=0 n=6 res=[1,3,2,4,5,7] cache=0 hits=0
test: list=2,3,4,5,6,7 cond=is_odd
expect: => i=3 r=0.0 ok=true s="selected 3 pairs" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_res int[512] = [0; 512];
	var new_n = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if ${cond}(sum) {
			new_res[new_n] = g.res[i];
			new_res[new_n + 1] = g.res[i + 1];
			new_n += 2;
		}
		i += 2;
	}
	for j in new_n { g.res[j] = new_res[j]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n / 2;
	out.s.clear();
	format(out.s, "selected ", new_n / 2, " pairs");
	out
}
@end
@entry b908ab4a5768d741
kind: step
verb: keep
noun: suffix
modifier: until
context: core
slot: cond pred
phrase: keep suffix until element satisfies {cond}
phrase: retain trailing suffix stopping at {cond}
test: list=2,4,5,8,10 cond=is_odd
expect: => i=3 r=0.0 ok=true s="kept suffix: 3" errors=0 n=3 res=[5,8,10] cache=0 hits=0
test: list=1,3,6,7,9 cond=is_even
expect: => i=3 r=0.0 ok=true s="kept suffix: 3" errors=0 n=3 res=[6,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${cond}(g.res[i]) {
			start = i;
			break;
		}
		i--;
	}
	var new_n = 0;
	var new_res int[512] = [0; 512];
	var k = start;
	while k < g.n {
		new_res[new_n] = g.res[k];
		new_n++;
		k++;
	}
	for j in new_n { g.res[j] = new_res[j]; }
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept suffix: ", new_n);
	out
}
@end
@entry bf56f2d0c7523d7d
kind: step
verb: scan
noun: total
modifier: between
context: core
slot: low int
slot: high int
phrase: scan total between lower {low} upper {high}
phrase: running sum bounded between {low} to {high}
test: list=2,3,5,8,12 low=4 high=15
expect: => i=30 r=0.0 ok=true s="running bounded: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=1,2,3,4,5 low=2 high=9
expect: => i=15 r=0.0 ok=true s="running bounded: 2" errors=0 n=2 res=[3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var running = 0;
	var kept = 0;
	var new_res int[512] = [0; 512];
	for i in g.n {
		running += g.res[i];
		if running >= lo && running <= hi {
			new_res[kept] = running;
			kept++;
		}
	}
	for j in kept { g.res[j] = new_res[j]; }
	g.n = kept;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "running bounded: ", kept);
	out
}
@end
