@entry e822e1d93bf71386
kind: step
verb: scale
noun: runs
modifier: recursively
context: aggregate
slot: factor int
phrase: scale runs recursively by {factor} in aggregate
phrase: aggregate recursively scale contiguous run lengths with {factor}
test: list=4,4,4,7,7 factor=2
expect: => i=10 r=0.0 ok=true s="scaled run total length: 10" errors=0 n=4 res=[4,6,7,4] cache=0 hits=0
test: list=1,1,2,3,3,3 factor=3
expect: => i=18 r=0.0 ok=true s="scaled run total length: 18" errors=0 n=6 res=[1,6,2,3,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	var total_scaled = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == val {
			run_len++;
		}
		let scaled_len = run_len * fac;
		total_scaled += scaled_len;
		g.res[new_n] = val;
		new_n++;
		g.res[new_n] = scaled_len;
		new_n++;
		i += run_len;
	}
	g.n = new_n;
	out.i = total_scaled;
	out.ok = true;
	out.s.clear();
	format(out.s, "scaled run total length: ", total_scaled);
	out
}
@end
