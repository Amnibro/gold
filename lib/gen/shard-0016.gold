@entry 85507850640277a1
kind: step
verb: swap
noun: tally
modifier: recursively
context: aggregate
phrase: swap tally recursively based on parity balance in aggregate
phrase: aggregate swap tally parity inversion
test: list=1,3,5,2
expect: => i=2 r=0.0 ok=true s="parity balance tally difference: 2" errors=0 n=4 res=[2,5,3,1] cache=0 hits=0
test: list=2,4,6,7
expect: => i=-2 r=0.0 ok=true s="parity balance tally difference: -2" errors=0 n=4 res=[2,4,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens++; } else { odds++; }
	}
	let diff = odds - evens;
	if odds > evens {
		for i in g.n / 2 {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	out.i = diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "parity balance tally difference: ", diff);
	out
}
@end
