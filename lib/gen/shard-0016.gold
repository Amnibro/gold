kind: step
verb: run
noun: loop
modifier: between
context: sort
phrase: run sorting loop between bounds {lo} to {hi}
phrase: execute sort loop between limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=10,8,6,4,2 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted subrange" errors=0 n=5 res=[10,4,6,8,2] cache=0 hits=0
test: list=9,7,5,3,1 lo=0 hi=2
expect: => i=3 r=0.0 ok=true s="sorted subrange" errors=0 n=5 res=[5,7,9,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = if ${lo} < 0 { 0 } else { ${lo} };
	let end_idx = if ${hi} >= g.n { g.n - 1 } else { ${hi} };
	if start < end_idx {
		for i in start..end_idx {
			var min_idx = i;
			for j in (i + 1)..(end_idx + 1) {
				if g.res[j] < g.res[min_idx] { min_idx = j; }
			}
			if min_idx != i {
				let tmp = g.res[i];
				g.res[i] = g.res[min_idx];
				g.res[min_idx] = tmp;
			}
		}
	}
	g.steps += (end_idx - start + 1);
	out.i = end_idx - start + 1;
	out.s.clear();
	format(out.s, "sorted subrange");
	out
}
@end
