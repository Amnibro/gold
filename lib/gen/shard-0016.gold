fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens++;
		} else {
			g.res[i] = 0;
		}
	}
	g.steps += g.n;
	out.i = evens;
	out.s.clear();
	format(out.s, "kept ", evens, " evens in place");
	out
}
@end
@entry a3e775cefdedffc2
kind: step
verb: reverse
noun: number
modifier: all
context: core
phrase: reverse number all decimal digits
phrase: invert digits of all values in results
test: list=123,456,78
expect: => i=3 r=0.0 ok=true s="reversed 3 numbers" errors=0 n=3 res=[321,654,87] cache=0 hits=0
test: list=12,987,50
expect: => i=3 r=0.0 ok=true s="reversed 3 numbers" errors=0 n=3 res=[21,789,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		var is_neg = x < 0;
		if is_neg { x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + x % 10;
			x /= 10;
		}
		if is_neg { rev = -rev; }
		g.res[i] = rev;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " numbers");
	out
}
@end
