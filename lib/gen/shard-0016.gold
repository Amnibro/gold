fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fallback = ${fallback};
	if g.n == 0 {
		out.i = fallback;
		return out;
	}
	var mx = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > mx {
			mx = g.res[i];
		}
		i--;
	}
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
	format(out.s, "maximum peak: ", mx);
	out
}
@end
