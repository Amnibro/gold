	let min_freq = ${min_occurrences};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= min_freq {
			var already = false;
			for k in kept {
				if g.res[k] == x { already = true; break; }
			}
			if !already {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "counter in place filtered: ", kept);
	out
}
@end
