noun: prop
modifier: tall
context: scene
phrase: aim tall prop by {deg} degrees
phrase: orient tall prop angle by {deg}
slot: deg real
test: deg=15.0 doc="prop box 0,0,0.5 1,1,1"
expect: => i=2 r=0.0 ok=true s="aimprop" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: prop box 0,0,0.5 1,1,1
expect: => doc: prop.rot anim 0:0,0,0 1:0,0,15
test: deg=35.0 doc="ground box 0,0,-.5 10,10,1|prop box 1,1,0.5 0.8,0.8,0.8"
expect: => i=3 r=0.0 ok=true s="aimprop" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 10,10,1
expect: => doc: prop box 1,1,0.5 0.8,0.8,0.8
expect: => doc: prop.rot anim 0:0,0,0 1:0,0,35
test: deg=0.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	if ${deg} <= 0.0 { gold_fail(g, "invalid degrees"); out.ok = false; return out; }
	o.append(last);
	o.append(".rot anim ");
	o.append("0");
	o.append(":0,0,");
	o.append("0 ");
	o.append("1");
	o.append(":0,0,");
	gold_fnum(o, ${deg});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "aimprop");
	out
}
@end
