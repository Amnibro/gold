fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[64];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && count < 64 {
			evens[count] = g.res[i];
			count++;
		}
	}
	gold_clear(g);
	var i = 0;
	while i + 1 < count {
		gold_push(g, evens[i] + evens[i + 1]);
		i += 2;
	}
	if i < count {
		gold_push(g, evens[i]);
	}
	g.steps += count;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired all evens: ", g.n);
	out
}
@end
