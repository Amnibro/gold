expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	if s <= 0 { gold_fail(g, "invalid stride"); out.ok = false; return out; }
	var w = 0;
	var pruned = 0;
	for i in g.n {
		if i > 0 && g.res[i] == g.res[i - 1] { pruned++; }
		else { g.res[w] = g.res[i]; w++; }
	}
	g.n = w;
	out.i = pruned;
	out.s.clear();
	format(out.s, "pruned count ", pruned);
	out
}
@end
