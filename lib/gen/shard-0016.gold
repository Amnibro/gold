slot: target int
phrase: retry total all elements reaching target {target} in aggregate
phrase: aggregate retry total sum until achieving target {target}
test: list=3,4,5 target=20
expect: => i=21 r=0.0 ok=true s="retry target achieved: 21" errors=0 n=3 res=[6,7,8] cache=0 hits=0
test: list=10,20 target=35
expect: => i=36 r=0.0 ok=true s="retry target achieved: 36" errors=0 n=2 res=[13,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var attempts = 0;
	while attempts < 20 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		if sum >= tgt {
			out.ok = true;
			out.i = sum;
			out.s.clear();
			format(out.s, "retry target achieved: ", sum);
			g.steps += attempts;
			return out;
		}
		for i in g.n { g.res[i] += 1; }
		attempts++;
	}
	out.ok = false;
	out.i = 0;
	out.s.clear();
	format(out.s, "retry target not reached");
	g.steps += attempts;
	out
}
@end
