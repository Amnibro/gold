@entry a9d42cc500e06d70
kind: fn
verb: swap
noun: duplicates
modifier: times
context: transform
phrase: swap duplicates times transform
phrase: exchange duplicate items cadence
test: arg=1234,42
expect: 2143
expect: 24
test: arg=567,8
expect: 576
expect: 8
code:
fn ${ID}(n int) int {
	// transform: swap duplicates times
	if n <= 0 { return 0; }
	var x = n;
	var res = 0;
	var mul = 1;
	while x > 0 {
		let d1 = x % 10;
		x /= 10;
		if x > 0 {
			let d2 = x % 10;
			x /= 10;
			res += (d1 * 10 + d2) * mul;
		} else {
			res += d1 * mul;
		}
		mul *= 100;
	}
	res
}
@end
