fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let minval = ${minval};
	var modified = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] + g.res[i + 1] >= minval {
				g.res[i] *= 2;
				g.res[i + 1] *= 2;
				modified++;
			}
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out
}
@end
