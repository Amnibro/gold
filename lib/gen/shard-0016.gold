code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	var matched = 0;
	var kept = 0;
	for i in g.n {
		if matched < limit && ${p}(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
			matched++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "searched retry series at most count");
