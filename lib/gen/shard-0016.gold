fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${l} <= 0.0 || ${w} <= 0.0 {
		gold_fail(g, "dimensions must be positive");
		out.ok = false;
		return out;
	}
	gold_dnews(g, "path", "", o);
	o.append(" box ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, 0.05);
	o.append(" ");
	gold_fnum(o, ${w});
	o.append(",");
	gold_fnum(o, ${l});
	o.append(",");
	gold_fnum(o, 0.1);
	o.append(" m:matte ");
	gold_hex(o, 155, 138, 112);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "path");
	out
}
@end
