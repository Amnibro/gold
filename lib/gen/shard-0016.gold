modifier: each
context: sort
phrase: group each element in sorted suffix length {k}
phrase: organize each item in sorted suffix of size {k}
slot: k int
test: list=9,5,1,8,2,6 k=3
expect: => i=3 r=0.0 ok=true s="grouped suffix items" errors=0 n=6 res=[1,2,5,9,8,6] cache=0 hits=0
test: list=12,4,7,1 k=2
expect: => i=2 r=0.0 ok=true s="grouped suffix items" errors=0 n=4 res=[1,4,12,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let sz = if ${k} > g.n { g.n } else if ${k} < 0 { 0 } else { ${k} };
	let start = g.n - sz;
	var l = start;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += sz;
	out.i = sz;
	out.s.clear();
	format(out.s, "grouped suffix items");
	out
}
@end
