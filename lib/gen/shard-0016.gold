			valid = false;
		}
	}
	if !valid {
		gold_fail(g, "item below minimum threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "checked items: ", g.n);
