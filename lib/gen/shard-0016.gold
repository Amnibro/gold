code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let adj = ${adj};
	let pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] + g.res[2 * i + 1] + adj;
	}
	g.n = pairs;
	var total = 0;
	for i in g.n {
		total = total + g.res[i];
	}
	g.steps += pairs;
	out.i = total;
	out.s.clear();
	format(out.s, "merged pairs: ", pairs);
	out
}
@end
@entry 1bdd20e93c11a002
kind: step
verb: map
noun: digits
modifier: with_retry
context: aggregate
phrase: map digits with retry adding base value {base}
phrase: transform digit sums with retry using base {base}
slot: base int
test: list=12,34,56 base=10
expect: => i=51 r=0.0 ok=true s="mapped digits" errors=0 n=3 res=[13,17,21] cache=0 hits=0
test: list=7,89,101 base=5
expect: => i=41 r=0.0 ok=true s="mapped digits" errors=0 n=3 res=[12,22,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${base};
	var total = 0;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		var dsum = 0;
		while n > 0 {
			dsum = dsum + (n % 10);
			n = n / 10;
		}
		g.res[i] = dsum + base;
		total = total + g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped digits");
	out
}
@end
@entry eb0a272fa940ecdf
kind: step
verb: pair
noun: step
modifier: in_place
context: aggregate
phrase: pair adjacent steps in place scaling differences by {scale}
phrase: combine consecutive entries in place multiplying by {scale}
slot: scale int
test: list=2,5,9,14 scale=2
expect: => i=24 r=0.0 ok=true s="paired steps" errors=0 n=3 res=[6,8,10] cache=0 hits=0
test: list=10,13,17 scale=3
expect: => i=21 r=0.0 ok=true s="paired steps" errors=0 n=2 res=[9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let scale = ${scale};
	if g.n < 2 {
		return out;
	}
	let new_n = g.n - 1;
	for i in new_n {
		g.res[i] = (g.res[i + 1] - g.res[i]) * scale;
	}
	g.n = new_n;
	var total = 0;
	for i in g.n {
		total = total + g.res[i];
	}
	g.steps += new_n;
	out.i = total;
	out.s.clear();
	format(out.s, "paired steps");
	out
}
@end
