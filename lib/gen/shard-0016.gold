@entry 5ab304736c2b776d
kind: step
verb: keep
noun: step
modifier: recursively
context: aggregate
slot: step_min int
phrase: keep step recursively spaced by {step_min} in aggregate
phrase: aggregate keep elements spaced recursively at least {step_min}
test: list=1,2,5,6,10 step_min=3
expect: => i=3 r=0.0 ok=true s="recursively kept spaced items: 3" errors=0 n=3 res=[1,5,10] cache=0 hits=0
test: list=10,12,15,22 step_min=5
expect: => i=3 r=0.0 ok=true s="recursively kept spaced items: 3" errors=0 n=3 res=[10,15,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_step = ${step_min};
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var kept = 1;
	var last_val = g.res[0];
	for i in 1..g.n {
		let x = g.res[i];
		var diff = x - last_val;
		if diff < 0 { diff = -diff; }
		if diff >= min_step {
			g.res[kept] = x;
			last_val = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "recursively kept spaced items: ", kept);
	out
}
@end
