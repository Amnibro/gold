code:
fn ${ID}(g Gold&, v Val) Val {
	// step_count_range_safely
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var in_range = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			in_range++;
		}
	}
	if in_range == 0 {
		gold_fail(g, "no elements found in required safety range");
	}
	g.steps += g.n;
	out.i = in_range;
	out
}
@end
@entry 578e9d4402a28709
kind: step
verb: pair
noun: checkpoint
modifier: at_most
context: error
phrase: pair checkpoint error delta at most {max_diff}
phrase: constrain adjacent checkpoint fault drift under {max_diff}
slot: max_diff int
test: list=100,105,112 max_diff=10
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[100,105,112] cache=0 hits=0
test: list=50,70,90 max_diff=15
expect: => i=2 r=0.0 ok=true s="" errors=1 n=3 res=[50,70,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_pair_checkpoint_at_most
	var out = v;
	let max_d = ${max_diff};
	var i = 0;
	var breaches = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d > max_d {
			breaches++;
		}
		i++;
	}
	if breaches > 0 {
		gold_fail(g, "checkpoint drift exceeded allowed limit");
	}
	g.steps += g.n;
	out.i = breaches;
	out
}
@end
