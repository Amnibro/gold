code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let sc = ${scale};
	let last_val = g.res[g.n - 1];
	for i in g.n {
		if sc != 0 {
			g.res[i] = (g.res[i] * last_val) / sc;
		}
	}
	g.steps += g.n;
	out.i = last_val;
	out.s.clear();
	format(out.s, "normalized loop last: ", last_val);
	out
}
@end
