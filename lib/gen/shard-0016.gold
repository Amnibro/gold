test: list=8,3,5,3,9 limit=2
expect: => i=3 r=0.0 ok=true s="minimum value repeated: 3" errors=0 n=7 res=[8,3,5,3,9,3,3] cache=0 hits=0
test: list=10,20 limit=3
expect: => i=10 r=0.0 ok=true s="minimum value repeated: 10" errors=0 n=5 res=[10,20,10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var min_val = 0;
	if g.n > 0 {
		min_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] < min_val { min_val = g.res[i]; }
		}
		var added = 0;
		while added < lim && g.n < 512 {
			gold_push(g, min_val);
			added++;
		}
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum value repeated: ", min_val);
	out
}
@end
