phrase: execute check primes unique over loop results
test: list=2,3,5,7,11
expect: => i=5 r=0.0 ok=true s="checked unique primes: 5" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=2,3,2,5
expect: => i=4 r=0.0 ok=false s="checked unique primes: 4" errors=0 n=4 res=[2,3,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[64];
	var count = 0;
	var unique = true;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			for k in count {
				if primes[k] == g.res[i] { unique = false; }
			}
			if count < 64 {
				primes[count] = g.res[i];
				count++;
			}
		}
	}
	out.ok = unique;
	out.i = count;
	out.s.clear();
	format(out.s, "checked unique primes: ", count);
	out
}
@end
@entry a4fd645d74210ffa
kind: step
verb: measure
noun: maximum
modifier: pairwise
context: loop
phrase: measure maximum pairwise during loop iteration pass
phrase: execute measure maximum pairwise over loop results
test: list=10,25,5,40
expect: => i=35 r=0.0 ok=true s="measured maximum pairwise diff: 35" errors=0 n=4 res=[10,25,5,40] cache=0 hits=0
test: list=3,7,2,9,1
expect: => i=8 r=0.0 ok=true s="measured maximum pairwise diff: 8" errors=0 n=5 res=[3,7,2,9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_diff = 0;
	for i in 1..g.n {
		let diff = core_abs_val(g.res[i] - g.res[i - 1]);
		if diff > max_diff { max_diff = diff; }
	}
	g.steps += g.n;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "measured maximum pairwise diff: ", max_diff);
	out
}
@end
