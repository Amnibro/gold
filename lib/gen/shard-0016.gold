fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var keep = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] >= th {
			dropped++;
		} else {
			g.res[keep] = g.res[i];
			keep++;
		}
	}
	g.n = keep;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped threshold safely: ", dropped);
	out
}
@end
