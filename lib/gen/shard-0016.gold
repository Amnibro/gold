@entry a60e40a648811bca
kind: step
verb: tone
noun: fabric
modifier: fine
context: texture
phrase: tone fine fabric texture using seed {u}
phrase: apply fine fabric tone with seed {u}
slot: u int
model: noise c=2 u=${u}; brighten a=0.3; contrast a=1.4
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="fabric" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.221 max=1 sum8=55101 hash=447783
test: img=32 u=8
expect: => i=1024 r=0.0 ok=true s="fabric" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.228 max=1 sum8=216839 hash=220645
test: u=32
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_square(g, 2) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.3); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "fabric");
	out
}
@end
@entry f94ec8e0a1aa8571
kind: step
verb: stain
noun: moss
modifier: soft
context: texture
phrase: stain soft moss surface with seed {u}
phrase: apply soft moss stain using seed {u}
slot: u int
model: fbm n=2 c=4 u=${u}; blur; contrast a=1.4
test: img=16 u=4
expect: => i=256 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.138 max=0.844 sum8=30875 hash=530964
test: img=32 u=10
expect: => i=1024 r=0.0 ok=true s="moss" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.906 sum8=116193 hash=412394
test: u=33
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 4;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s_b = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.4 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
