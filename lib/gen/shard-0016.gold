code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for i in g.n {
		var is_dup = false;
		for j in i {
			if g.res[j] == g.res[i] { is_dup = true; break; }
		}
		if is_dup {
			modified++;
			if modified % 2 == 1 {
				g.res[i] = -g.res[i];
			}
		}
	}
	g.steps += modified;
	out.i = modified;
	out.s.clear();
	format(out.s, "reversed alternate duplicates: ", modified);
	out
}
@end
@entry 330b94e3787ad011
kind: step
verb: merge
noun: gaps
modifier: with_retry
context: loop
phrase: merge gaps with_retry in loop cycles using {max_gap}
phrase: apply merge gaps with_retry across loop items with {max_gap}
slot: max_gap int
test: list=1,3,7,9 max_gap=2
expect: => i=2 r=0.0 ok=true s="merged gaps with retry count: 2" errors=0 n=2 res=[4,16] cache=0 hits=0
test: list=10,15,18,25 max_gap=4
expect: => i=1 r=0.0 ok=true s="merged gaps with retry count: 1" errors=0 n=3 res=[10,33,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let tol = ${max_gap};
	var merged = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = core_abs_val(g.res[i + 1] - g.res[i]);
		if diff <= tol {
			g.res[i] = g.res[i] + g.res[i + 1];
			for k in (i + 1)..(g.n - 1) {
				g.res[k] = g.res[k + 1];
			}
			g.n--;
			merged++;
		} else {
			i++;
		}
	}
	g.steps += merged;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged gaps with retry count: ", merged);
	out
}
@end
