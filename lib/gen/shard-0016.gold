noun: memo
modifier: in_reverse
context: retry
phrase: filter cached retry memo values in reverse matching {p}
phrase: retain backwards retry memo results satisfying {p}
slot: p pred
test: list=1,2,3,4,5 p=is_even
expect: => i=2 r=0.0 ok=true s="filtered retry memo in reverse" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=10,11,12 p=is_even
expect: => i=2 r=0.0 ok=true s="filtered retry memo in reverse" errors=0 n=2 res=[12,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var buf = [0; 512];
	var k = g.n - 1;
	while k >= 0 {
		if ${p}(g.res[k]) {
			buf[kept] = g.res[k];
			kept++;
		}
		k--;
	}
	for i in kept {
		g.res[i] = buf[i];
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered retry memo in reverse");
	out
}
@end
@entry 1ec4bcbae01ff6e2
kind: step
verb: dedupe
noun: condition
modifier: safely
context: retry
phrase: dedupe retry items safely with condition {p}
phrase: remove duplicate retry items safely satisfying {p}
slot: p pred
test: list=2,2,3,4,4,5 p=is_even
expect: => i=4 r=0.0 ok=true s="deduped retry items safely" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=6,6,6 p=is_even
expect: => i=1 r=0.0 ok=true s="deduped retry items safely" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var dup = false;
		if ${p}(val) {
			for j in kept {
				if g.res[j] == val {
					dup = true;
					break;
				}
			}
		}
		if !dup {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped retry items safely");
	out
}
@end
@entry 81e4624c211057bf
kind: step
verb: rotate
noun: runs
modifier: running
context: retry
phrase: rotate running retry runs by offset {shift}
phrase: shift running retry attempts forward by {shift}
slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=4 r=0.0 ok=true s="rotated running retry runs" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=2
expect: => i=3 r=0.0 ok=true s="rotated running retry runs" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 0 && s > 0 {
		let k = s % g.n;
		var buf = [0; 512];
		for i in g.n {
			let target = (i + k) % g.n;
			buf[target] = g.res[i];
		}
		for i in g.n {
			g.res[i] = buf[i];
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated running retry runs");
	out
}
@end
