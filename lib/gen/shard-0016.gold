code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	var ok = true;
	if count >= 2 {
		var i = g.n - count + 1;
		while i < g.n {
			if g.res[i] < g.res[i - 1] {
				ok = false;
				break;
			}
			i++;
		}
	}
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	g.steps += count;
	out.s.clear();
	format(out.s, "scanned tail sorted");
	out
}
@end
