test: list=10,20,1 shift_amount=5
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[10,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift_amount};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var mn = g.res[g.n - 1];
	var i = g.n - 2;
	while i >= 0 {
		if g.res[i] < mn { mn = g.res[i]; }
		i--;
	}
	if mn < sh {
		gold_fail(g, "minimum value smaller than reverse shift");
		out.i = mn;
		return out;
	}
	g.steps += g.n;
	out.i = mn - sh;
	out
}
@end
