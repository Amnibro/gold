slot: k int
test: list=30,10,20 k=2
expect: => i=2 r=0.0 ok=true s="sorted cached 2" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=40,25,15 k=1
expect: => i=1 r=0.0 ok=true s="sorted cached 1" errors=0 n=3 res=[15,25,40] cache=1 hits=0
test: list=10 k=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top_k = ${k};
	if top_k < 0 || top_k > g.n { gold_fail(g, "invalid k"); out.ok = false; return out; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if top_k > 0 { gold_cache_put(g, top_k, g.res[top_k - 1]); }
	out.i = top_k;
	out.s.clear();
	format(out.s, "sorted cached ", top_k);
	out
}
@end
