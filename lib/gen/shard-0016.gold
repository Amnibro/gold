				g.res[i] = g.res[i] + offset;
				changed++;
			}
		}
	}
	var total = 0;
	for i in g.n { total = total + g.res[i]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "duplicates adjusted: ", changed);
