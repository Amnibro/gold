@entry 1598a78fc4bd055d
kind: step
verb: count
noun: primes
modifier: at_least
context: error
phrase: count prime error codes requiring at least {min_primes}
phrase: tally prime fault numbers expecting at least {min_primes}
slot: min_primes int
test: list=2,3,5,7,8 min_primes=3
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,5,7,8] cache=0 hits=0
test: list=4,6,8,9 min_primes=2
expect: => i=0 r=0.0 ok=true s="" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_count_primes_at_least
	var out = v;
	let required = ${min_primes};
	var primes = 0;
	for i in g.n {
		let val = g.res[i];
		if val > 1 {
			var p = true;
			var d = 2;
			while d * d <= val {
				if val % d == 0 { p = false; break; }
				d++;
			}
			if p { primes++; }
		}
	}
	if primes < required {
		gold_fail(g, "prime count below required floor threshold");
	}
	g.steps += g.n;
	out.i = primes;
	out
}
@end
