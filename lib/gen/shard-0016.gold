			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var last_val = -1;
	var found = false;
	for k in g.n {
		if g.res[k] <= ${thresh} {
			last_val = g.res[k];
			found = true;
