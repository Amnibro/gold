fn ${ID}(n int) int {
	let md = ${max_diff};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var count = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		let diff = if cur > prev { cur - prev } else { prev - cur };
		if diff <= md { count++; }
		prev = cur;
		x /= 10;
	}
	count
}
@end
