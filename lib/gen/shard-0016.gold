fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var k = c;
	if k > g.n { k = g.n; }
	let start = g.n - k;
	var sum_sq = 0;
	for i in k {
		let idx = start + i;
		let sq = g.res[idx] * g.res[idx];
		g.res[idx] = sq;
		sum_sq += sq;
	}
	out.i = sum_sq;
	out.ok = true;
	out.s.clear();
	format(out.s, "last squares sum: ", sum_sq);
	g.steps += k;
