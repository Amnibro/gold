@entry 83dd553f4c3ade05
kind: step
verb: pair
noun: step
modifier: recursively
context: loop
phrase: pair step recursively summing adjacent values
phrase: recursively pair adjacent step values in loop
test: list=1,2,3,4,5,6,7,8
expect: => i=36 r=0.0 ok=true s="paired step recursively" errors=0 n=1 res=[36] cache=0 hits=0
test: list=2,4,6,8
expect: => i=20 r=0.0 ok=true s="paired step recursively" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = g.n;
	var steps_taken = 0;
	while len > 1 {
		var new_len = 0;
		var i = 0;
		while i + 1 < len {
			g.res[new_len] = g.res[i] + g.res[i + 1];
			new_len++;
			i += 2;
		}
		if i < len {
			g.res[new_len] = g.res[i];
			new_len++;
		}
		len = new_len;
		steps_taken++;
	}
	g.n = len;
	g.steps += steps_taken;
	out.i = if len > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "paired step recursively");
	out
}
@end
