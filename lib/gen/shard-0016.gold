code:
recursive fn ${ID}_max(g Gold&, n int) {
	if n <= 1 { return; }
	var max_idx = 0;
	for i in 1..n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	if max_idx != n - 1 {
		let tmp = g.res[n - 1];
		g.res[n - 1] = g.res[max_idx];
		g.res[max_idx] = tmp;
	}
	${ID}_max(g, n - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	${ID}_max(g, g.n);
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively sorted maximums");
	out
}
@end
