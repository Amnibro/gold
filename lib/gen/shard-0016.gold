code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b < 0 { gold_fail(g, "invalid budget"); out.ok = false; return out; }
	var w = 0;
	var cost = 0;
	for i in g.n {
		var dup = false;
		if i > 0 && g.res[i] == g.res[i - 1] { dup = true; }
		if !dup || cost >= b {
			g.res[w] = g.res[i];
			w++;
		} else {
			cost += 10;
		}
	}
	g.n = w;
	out.i = cost;
	out.s.clear();
	format(out.s, "dedupe cost ", cost);
	out
}
@end
