@entry 9d498582ef057411
kind: step
verb: run
noun: window
modifier: each
context: sort
phrase: run window sort across each sublist of size {w_size}
phrase: sort each sliding window of length {w_size}
slot: w_size int
test: list=9,2,7,1,5,3 w_size=3
expect: => i=6 r=0.0 ok=true s="window sorted" errors=0 n=6 res=[2,7,9,1,3,5] cache=0 hits=0
