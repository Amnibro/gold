@entry 1f069e69839a3a66
kind: step
verb: retry
noun: threshold
modifier: at_least
context: aggregate
slot: limit int
slot: k int
phrase: retry threshold at least count {k} above {limit} in aggregate
phrase: aggregate retry threshold until reaching at least {k} values above {limit}
test: list=4,7,2,9 limit=8 k=2
expect: => i=2 r=0.0 ok=true s="threshold met count: 2" errors=0 n=4 res=[5,8,3,10] cache=0 hits=0
test: list=1,2,3 limit=10 k=3
expect: => i=3 r=0.0 ok=true s="threshold met count: 3" errors=0 n=3 res=[10,11,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let target_k = ${k};
	var attempts = 0;
	while attempts < 10 {
		var count = 0;
		for i in g.n {
			if g.res[i] >= lim { count++; }
		}
		if count >= target_k {
			out.i = count;
			out.ok = true;
			out.s.clear();
			format(out.s, "threshold met count: ", count);
			g.steps += attempts;
			return out;
		}
		for i in g.n {
			g.res[i] = g.res[i] + 1;
		}
		attempts++;
	}
	out.ok = false;
	out.i = 0;
	out.s.clear();
	format(out.s, "threshold retry limit reached");
	g.steps += attempts;
	out
}
@end
@entry 9a6d81de4dccb624
kind: step
verb: swap
noun: prefix
modifier: last
context: aggregate
slot: k int
phrase: swap prefix last count {k} in aggregate
phrase: aggregate swap prefix with last {k} items
test: list=1,2,3,4,5,6 k=2
expect: => i=2 r=0.0 ok=true s="swapped boundary items: 2" errors=0 n=6 res=[5,6,3,4,1,2] cache=0 hits=0
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="swapped boundary items: 1" errors=0 n=4 res=[40,20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || k * 2 > g.n {
		gold_fail(g, "swap span out of bounds");
		out.ok = false;
		return out;
	}
	for i in k {
		let left = i;
		let right = g.n - k + i;
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
	}
	out.i = k;
	out.ok = true;
	out.s.clear();
	format(out.s, "swapped boundary items: ", k);
	out
}
@end
@entry 1e90f2e9fde78dd2
kind: step
verb: scale
noun: subfunction
modifier: pairwise
context: aggregate
slot: f fn
phrase: scale subfunction pairwise mapping {f} in aggregate
phrase: aggregate pairwise scale using subfunction {f}
test: list=2,3,4,5 f=double
expect: => i=28 r=0.0 ok=true s="pairwise scaled sum: 28" errors=0 n=2 res=[10,18] cache=0 hits=0
test: list=10,20,30,40 f=halve
expect: => i=50 r=0.0 ok=true s="pairwise scaled sum: 50" errors=0 n=2 res=[15,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	let pairs = g.n / 2;
	var total = 0;
	for i in pairs {
		let a = g.res[i * 2];
		let b = g.res[i * 2 + 1];
		let scaled = ${f}(a + b);
		g.res[i] = scaled;
		total += scaled;
	}
	g.n = pairs;
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "pairwise scaled sum: ", total);
	out
}
@end
