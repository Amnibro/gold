code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var len = k;
	if len > g.n { len = g.n; }
	if len > 1 {
		let first = g.res[0];
		for i in 1..len {
			g.res[i - 1] = g.res[i];
		}
		g.res[len - 1] = first;
		for i in len {
			gold_cache_put(g, i, g.res[i]);
		}
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "prefix rotated with cache: ", len);
	out
}
@end
