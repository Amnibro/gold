@entry 1eddcdc45d25cb32
kind: step
verb: collect
noun: pairs
modifier: at_most
context: transform
phrase: collect pairs summing to at most {limit}
phrase: gather pair sums reaching at most {limit}
slot: limit int
test: list=1,3,2,4,1 limit=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,5,5] cache=0 hits=0
test: list=10,20,5,15 limit=25
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[25,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var count = 0;
	if g.n > 1 {
		var sums int[256] = [0; 256];
		var sn = 0;
		for i in 0..(g.n - 1) {
			let s = g.res[i] + g.res[i + 1];
			if s <= limit && sn < 256 {
				sums[sn] = s;
				sn++;
			}
		}
		gold_clear(g);
		for i in sn { gold_push(g, sums[i]); }
		count = sn;
	}
	g.steps += count;
	out.i = count;
	out
}
@end
@entry aa2691950ae629d1
kind: step
verb: limit
noun: errors
modifier: between
context: transform
