phrase: apply measure series at_least across loop items with {min_len}
slot: min_len int
test: list=1,2,3,1,2,3,4 min_len=3
expect: => i=4 r=0.0 ok=true s="longest series length: 4" errors=0 n=7 res=[1,2,3,1,2,3,4] cache=0 hits=0
test: list=10,20,30,5,6 min_len=4
expect: => i=3 r=0.0 ok=false s="longest series length: 3" errors=0 n=5 res=[10,20,30,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let lim = ${min_len};
	var max_run = 1;
	var cur_run = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
	}
	g.steps += max_run;
	out.i = max_run;
	out.ok = max_run >= lim;
	out.s.clear();
	format(out.s, "longest series length: ", max_run);
	out
}
@end
