	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let shifted = 'a' + ((c - 'a' + sh) % 26);
			out.s[i] = shifted as byte;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
