kind: step
verb: check
noun: gaps
modifier: recursively
context: aggregate
phrase: check gaps recursively between consecutive items against {max_gap}
phrase: verify adjacent item gaps recursively under ceiling {max_gap}
slot: max_gap int
test: list=2,5,9,12 max_gap=5
expect: => i=4 r=0.0 ok=true s="gaps checked: 4" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
test: list=1,10,12 max_gap=6
expect: => i=3 r=0.0 ok=false s="gaps checked: 3" errors=1 n=3 res=[1,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${max_gap};
	var ok_gaps = true;
	if g.n >= 2 {
		for i in (g.n - 1) {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff > max_gap {
				ok_gaps = false;
			}
		}
	}
	if !ok_gaps {
		gold_fail(g, "gap exceeds allowed maximum");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "gaps checked: ", g.n);
	out
}
@end
