modifier: recursively
context: aggregate
phrase: pair step reductions recursively down to depth {depth}
phrase: fold adjacent elements recursively up to depth {depth}
slot: depth int
test: list=1,2,3,4,5,6,7,8 depth=2
expect: => i=36 r=0.0 ok=true s="recursively paired" errors=0 n=2 res=[10,26] cache=0 hits=0
test: list=10,20,30,40 depth=1
expect: => i=100 r=0.0 ok=true s="recursively paired" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let depth = ${depth};
	var d = 0;
	while d < depth && g.n > 1 {
		let pairs = g.n / 2;
		for i in pairs {
			g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
		}
		g.n = pairs;
		d++;
	}
	var total = 0;
	for i in g.n { total = total + g.res[i]; }
	g.steps += d;
	out.i = total;
	out.s.clear();
	format(out.s, "recursively paired");
	out
}
@end
@entry 3d2cd3e904710ae3
kind: step
verb: measure
noun: average
modifier: last
context: aggregate
phrase: measure average of last {k} items in results
phrase: compute mean across trailing {k} elements
slot: k int
test: list=4,6,8,10,12 k=3
expect: => i=10 r=10.0 ok=true s="last average: 10" errors=0 n=5 res=[4,6,8,10,12] cache=0 hits=0
test: list=10,20,30 k=2
expect: => i=25 r=25.0 ok=true s="last average: 25" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n == 0 || k <= 0 { return out; }
	var actual_k = k;
	if actual_k > g.n { actual_k = g.n; }
	var total = 0;
	var idx = g.n - actual_k;
	while idx < g.n {
		total = total + g.res[idx];
		idx++;
	}
	let avg = total / actual_k;
	g.steps += actual_k;
	out.i = avg;
	out.r = (total as real) / (actual_k as real);
	out.s.clear();
	format(out.s, "last average: ", avg);
	out
}
@end
