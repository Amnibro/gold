fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win_w = ${win_w};
	if win_w > 1 {
		var i = 0;
		while i + win_w <= g.n {
			var left = i;
			var right = i + win_w - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			i = i + win_w;
		}
	}
	var total = 0;
	for k in g.n { total = total + g.res[k]; }
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "reversed windows");
	out
}
@end
