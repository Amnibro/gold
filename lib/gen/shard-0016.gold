@entry 77f42a66d55cb117
kind: step
verb: fold
noun: threshold
modifier: unique
context: retry
phrase: fold unique retry values exceeding threshold {limit}
phrase: sum distinct retry attempts above threshold {limit}
slot: limit int
test: list=10,10,20,30,5 limit=8
expect: => i=60 r=0.0 ok=true s="folded unique retry values above threshold" errors=0 n=5 res=[10,10,20,30,5] cache=0 hits=0
test: list=1,2,2,15 limit=5
expect: => i=15 r=0.0 ok=true s="folded unique retry values above threshold" errors=0 n=4 res=[1,2,2,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var unique = [0; 512];
	var u_count = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in u_count {
			if unique[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			unique[u_count] = val;
			u_count++;
		}
	}
	var total = 0;
	for i in u_count {
		if unique[i] > lim {
			total += unique[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded unique retry values above threshold");
	out
}
@end
