@entry 2c8557a94fc50d74
kind: step
verb: rotate
noun: suffix
modifier: pairwise
context: compare
phrase: rotate pairwise suffix values count {count}
phrase: swap adjacent suffix elements count {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="pairwise swapped 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
test: list=5,15,25,35 count=1
expect: => i=1 r=0.0 ok=true s="pairwise swapped 1" errors=0 n=4 res=[5,15,35,25] cache=0 hits=0
test: list=10 count=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c < 0 || g.n < 2 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	let limit = if c * 2 > g.n { g.n / 2 } else { c };
	for p in limit {
		let idx1 = g.n - 1 - p * 2;
		let idx2 = idx1 - 1;
		if idx2 >= 0 {
			let tmp = g.res[idx1];
			g.res[idx1] = g.res[idx2];
			g.res[idx2] = tmp;
		}
	}
	out.i = limit;
	out.s.clear();
	format(out.s, "pairwise swapped ", limit);
	out
}
@end
