	var ge int[64];
	var lt int[64];
	var n_ge = 0;
	var n_lt = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] >= p {
			if n_ge < 64 { ge[n_ge] = g.res[i]; n_ge++; }
		} else {
			if n_lt < 64 { lt[n_lt] = g.res[i]; n_lt++; }
		}
		i--;
	}
	gold_clear(g);
	for k in n_ge { gold_push(g, ge[k]); }
	for k in n_lt { gold_push(g, lt[k]); }
	g.steps += g.n;
	out.i = n_ge;
	out.s.clear();
	format(out.s, "grouped condition in reverse: ", n_ge);
	out
}
@end
@entry 1c06a1dbdff7bfa3
kind: step
