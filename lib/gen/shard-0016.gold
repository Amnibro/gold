@entry 27eb593c27745c95
kind: step
verb: swap
noun: cache
modifier: unique
context: error
phrase: swap unique error entries with cache slot {idx}
phrase: exchange distinct fault records at cache location {idx}
slot: idx int
test: list=10,20,30 idx=0
expect: => i=10 r=0.0 ok=true s="" errors=0 n=3 res=[11,20,30] cache=3 hits=1
test: list=5,15,25 idx=1
expect: => i=15 r=0.0 ok=true s="" errors=0 n=3 res=[5,16,25] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_swap_cache_unique
	var out = v;
	let target_slot = ${idx};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	if target_slot < g.n {
		let cached_val, ok = gold_cache_get(g, target_slot);
		if ok {
			let orig = g.res[target_slot];
			g.res[target_slot] = cached_val + 1;
			out.i = orig;
		}
	} else {
		gold_fail(g, "target slot out of bounds");
	}
	g.steps += g.n;
	out
}
@end
@entry a0ad653309b12c21
kind: step
verb: count
noun: results
modifier: unique
context: error
phrase: count unique error results above threshold {threshold}
phrase: tally distinct fault occurrences exceeding limit {threshold}
slot: threshold int
test: list=10,20,10,30,20 threshold=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[10,20,10,30,20] cache=0 hits=0
test: list=1,2,1,3,4 threshold=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_count_results_unique
	var out = v;
	let min_val = ${threshold};
	var uniq = 0;
	for i in g.n {
		if g.res[i] > min_val {
			var seen = false;
			for j in i {
				if g.res[j] == g.res[i] { seen = true; break; }
			}
			if !seen { uniq++; }
		}
	}
	g.steps += g.n;
	out.i = uniq;
	out
}
@end
@entry 9b640d7c9ade6d84
