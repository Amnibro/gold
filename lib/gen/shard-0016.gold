fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${max_tol};
	var inversions = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] {
			inversions += (g.res[i - 1] - g.res[i]);
		}
	}
	out.i = inversions;
	out.ok = inversions <= tol;
	out.s.clear();
	format(out.s, "sorted digit inversions: ", inversions);
	g.steps += inversions;
	out
}
