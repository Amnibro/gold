	var added = 0;
	while cur <= target_end && g.n < 512 {
		gold_push(g, cur);
		cur++;
		added++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "fill range last added: ", added);
	out
}
