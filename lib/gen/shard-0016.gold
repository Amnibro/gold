kind: step
verb: tone
noun: tiles
modifier: none
context: texture
phrase: tone tiles none standard quarry tiles from seed {u}
phrase: plain tiles tone regular paving layout with seed {u}
slot: u int
model: worley c=8 u=${u}; normalize; quantize n=4
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=31450 hash=636733
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="tiles" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=108035 hash=380711
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// procedural texture synthesis for tone tiles none
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	var mn1 = g.img[0];
	var mx1 = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn1 { mn1 = g.img[k]; } if g.img[k] > mx1 { mx1 = g.img[k]; } }
	if mx1 - mn1 < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn1) / (mx1 - mn1); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (4 as real)) as! int;
		if t > 4 - 1 { t = 4 - 1; }
		g.img[k] = (t as real) / ((4 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
