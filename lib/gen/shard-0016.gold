fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	let th = ${threshold};
	for w in words(v.s) {
		if w.len > th {
			sum += w.len;
			gold_push(g, w.len);
		}
	}
	g.steps += sum + 1;
	out.i = sum;
	out
}
@end
