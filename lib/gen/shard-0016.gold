phrase: trace streak pairwise longest identical run
phrase: find longest streak of identical characters
test: text="aaabbccccd"
expect: => i=4 r=0.0 ok=true s="aaabbccccd" errors=0 n=1 res=[4] cache=0 hits=0
test: text="mississippi"
expect: => i=2 r=0.0 ok=true s="mississippi" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 1;
	if v.s.len > 0 {
		max_streak = 1;
		for q in 1..v.s.len {
			if v.s[q] == v.s[q - 1] {
				cur_streak++;
				if cur_streak > max_streak { max_streak = cur_streak; }
			} else {
				cur_streak = 1;
			}
		}
	}
	gold_push(g, max_streak);
	g.steps += max_streak + 1;
	out.i = max_streak;
	out
}
@end
