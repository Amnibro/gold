fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let lim = ${limit};
	var err_count = 0;
	for i in 1..g.n {
		let diff = core_abs_val(g.res[i] - g.res[i - 1]);
		if diff > lim {
			gold_fail(g, "pairwise threshold exceeded");
			err_count++;
		}
	}
	out.i = err_count;
	out.s.clear();
	format(out.s, "mapped pairwise errors: ", err_count);
	out
}
@end
@entry 52959eb1188a14a7
kind: step
verb: select
noun: average
modifier: with_retry
context: loop
phrase: select average with_retry in loop cycles using {retries}
phrase: apply select average with_retry across loop items with {retries}
slot: retries int
test: list=10,20,30,40,50 retries=1
expect: => i=3 r=0.0 ok=true s="selected average with retry: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=2,4,6,8,100 retries=2
expect: => i=1 r=0.0 ok=true s="selected average with retry: 1" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var count = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[count] = g.res[i];
			count++;
		}
	}
	g.n = count;
	g.steps += ${retries};
	out.i = count;
	out.s.clear();
	format(out.s, "selected average with retry: ", count);
	out
}
@end
