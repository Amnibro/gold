fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${step_val};
	if sv <= 0 { gold_fail(g, "invalid step_val"); out.ok = false; return out; }
	var w = 0;
	var removed = 0;
	for i in g.n {
		if i % sv == 0 && i > 0 && g.res[i] == g.res[i - 1] {
			removed++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = removed;
	out.s.clear();
	format(out.s, "alternate removed ", removed);
	out
}
@end
