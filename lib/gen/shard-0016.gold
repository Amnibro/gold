fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sp = 0;
	while sp < v.s.len && v.s[sp] != ' ' { sp++; }
	if sp > 1 {
		let first = out.s[0];
		for q in sp - 1 {
			out.s[q] = out.s[q + 1];
		}
		out.s[sp - 1] = first;
	}
	g.steps += sp + 1;
	out.i = sp;
	out
}
