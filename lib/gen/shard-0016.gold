fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var st = ${start};
	var sp = ${stop};
	if st < 0 { st = 0; }
	if sp > g.n { sp = g.n; }
	var sum = 0;
	for i in st..sp {
		sum += g.res[i];
	}
	g.steps += (sp - st);
	out.i = sum;
	out.s.clear();
	format(out.s, "scanned steps sum: ", sum);
	out
}
