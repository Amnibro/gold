@entry 2c691d552c65e405
kind: step
verb: drop
noun: memo
modifier: between
context: transform
phrase: drop memo between minimum {low} ceiling {high}
phrase: clear memo between floor {low} limit {high}
slot: low int
slot: high int
test: list=10,25,40 low=20 high=30
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[10,25,40] cache=2 hits=0
test: list=5,15,35,45 low=10 high=40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,35,45] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var new_ck int[256] = [0; 256];
	var new_cv int[256] = [0; 256];
	var keep = 0;
	for i in g.cn {
		let val = g.cv[i];
		if val < low || val > high {
			new_ck[keep] = g.ck[i];
			new_cv[keep] = g.cv[i];
			keep++;
		}
	}
	for i in keep {
		g.ck[i] = new_ck[i];
		g.cv[i] = new_cv[i];
	}
	g.cn = keep;
	g.steps += g.n;
	out.i = keep;
	out
}
@end
