code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	var rotated = 0;
	if s >= 0 && s < g.n - 1 {
		let first_v = g.res[s];
		for i in s..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first_v;
		rotated = g.n - s;
	}
	out.i = rotated;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated nested suffix count: ", rotated);
	g.steps += rotated;
	out
}
@end
