modifier: every_other
context: aggregate
slot: step int
phrase: cache words every_other in aggregate with {step}
phrase: apply cache words every_other across aggregates with {step}
test: text="alpha beta gamma delta" step=2
expect: => i=2 r=0.0 ok=true s="cache words every_other cached: 2" errors=0 n=0 res=[] cache=2 hits=0
test: text="one two three four five" step=1
expect: => i=3 r=0.0 ok=true s="cache words every_other cached: 3" errors=0 n=0 res=[] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	if st <= 0 {
		gold_fail(g, "cache words every_other requires positive step");
		out.ok = false;
		return out;
	}
	var count = 0;
	var word_len = 0;
	var word_idx = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if word_len > 0 {
				if word_idx % 2 == 0 {
					gold_cache_put(g, word_idx, word_len);
					count++;
				}
				word_idx++;
				word_len = 0;
			}
		} else {
			word_len++;
		}
	}
	if word_len > 0 && word_idx % 2 == 0 {
		gold_cache_put(g, word_idx, word_len);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "cache words every_other cached: ", count);
	out
}
@end
