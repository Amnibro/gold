code:
fn ${ID}(g Gold&, v Val) Val {
	// step_retry_text_times
	var out = v;
	let attempts = ${max_tries};
	var k = 0;
	while k < attempts {
		out.s.clear();
		format(out.s, "attempt");
		k++;
	}
	if out.i > 10 {
		gold_fail(g, "value exceeded tolerance after retry");
	}
	g.steps += attempts;
	out.i = k;
	out
}
@end
@entry 66ec9fc722ea35eb
kind: step
verb: swap
noun: primes
modifier: between
context: error
phrase: swap prime error codes between range {low} {high}
phrase: exchange prime fault identifiers within bounds {low} {high}
slot: low int
slot: high int
test: list=2,3,4,5,6 low=2 high=5
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[5,3,4,2,6] cache=0 hits=0
test: list=10,11,12,13 low=10 high=15
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[10,13,12,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_swap_primes_between
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var first_p = -1;
	var last_p = -1;
	for i in g.n {
		let val = g.res[i];
		if val >= lo && val <= hi {
			var is_p = if val > 1 { true } else { false };
			var d = 2;
			while d * d <= val {
				if val % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				if first_p < 0 { first_p = i; }
				last_p = i;
			}
		}
	}
	if first_p >= 0 && last_p > first_p {
		let tmp = g.res[first_p];
		g.res[first_p] = g.res[last_p];
		g.res[last_p] = tmp;
	}
	g.steps += g.n;
	out.i = if first_p >= 0 { 1 } else { 0 };
	out
}
@end
@entry a87dc2e257738062
kind: step
verb: measure
noun: head
modifier: sorted
context: error
phrase: measure sorted error head window of span {span}
phrase: evaluate leading sorted fault segment up to {span}
slot: span int
test: list=1,2,5,10,3 span=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,5,10,3] cache=0 hits=0
test: list=4,2,12,16 span=3
expect: => i=0 r=0.0 ok=true s="" errors=1 n=4 res=[4,2,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_measure_head_sorted
	var out = v;
	let w = ${span};
	let limit = if w < g.n { w } else { g.n };
	var is_sorted = true;
	var i = 0;
	while i + 1 < limit {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	if !is_sorted {
		gold_fail(g, "leading head segment is unsorted");
	}
	g.steps += limit;
	out.i = if is_sorted { 1 } else { 0 };
	out
}
@end
@entry 12dcef9e395a0a68
kind: step
verb: count
noun: squares
modifier: unique
context: error
phrase: count unique squared error deviations up to {cap}
phrase: tally distinct square fault magnitudes under {cap}
slot: cap int
test: list=2,-2,3,4 cap=20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[2,-2,3,4] cache=0 hits=0
test: list=1,2,3 cap=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_count_squares_unique
	var out = v;
	let limit = ${cap};
	var uniq = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq <= limit {
			var seen = false;
			for j in i {
				if g.res[j] * g.res[j] == sq { seen = true; break; }
			}
			if !seen { uniq++; }
		}
	}
	g.steps += g.n;
	out.i = uniq;
	out
}
@end
