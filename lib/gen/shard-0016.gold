expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if sh < 0 || g.n == 0 { gold_fail(g, "invalid shift"); out.ok = false; return out; }
	let s = sh % g.n;
	for step in s {
		let first = g.res[0];
		for i in (g.n - 1) { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
	}
	out.i = s;
	out.s.clear();
	format(out.s, "memo rotated ", s);
	out
}
@end
