@entry 066a86889495be85
kind: step
verb: keep
noun: maximum
modifier: with_retry
context: loop
phrase: keep maximum with_retry in loop cycles using {threshold}
phrase: apply keep maximum with_retry across loop items with {threshold}
slot: threshold int
test: list=10,45,20,60,30 threshold=40
expect: => i=2 r=0.0 ok=true s="kept maximum with retry: 2" errors=0 n=2 res=[45,60] cache=0 hits=0
test: list=5,15,8,25 threshold=20
expect: => i=1 r=0.0 ok=true s="kept maximum with retry: 1" errors=0 n=1 res=[25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let lim = ${threshold};
	var count = 0;
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
		if g.res[i] >= lim {
			g.res[count] = g.res[i];
			count++;
		}
	}
	if count == 0 {
		gold_clear(g);
		gold_push(g, max_val);
		count = 1;
	} else {
		g.n = count;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept maximum with retry: ", count);
	out
}
@end
