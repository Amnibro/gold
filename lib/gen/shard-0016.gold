test: text="one two three four" min_spaces=2
expect: => i=3 r=0.0 ok=true s="one two three four" errors=0 n=1 res=[3] cache=0 hits=0
test: text="alpha beta gamma delta epsilon" min_spaces=4
expect: => i=4 r=0.0 ok=true s="alpha beta gamma delta epsilon" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	let ms = ${min_spaces};
	for c in v.s {
		if c == ' ' { count++; }
	}
	if count >= ms {
		gold_push(g, count);
	}
	g.steps += count + 1;
	out.i = count;
	out
}
@end
