@entry 2a6155a4d24a06ce
kind: step
verb: trace
noun: histogram
modifier: with_retry
context: retry
phrase: trace retry histogram counts for bins up to {max_bin}
phrase: compute retry histogram distribution up to {max_bin}
slot: max_bin int
test: list=1,2,1,0,2 max_bin=2
expect: => i=3 r=0.0 ok=true s="traced retry histogram distribution" errors=0 n=3 res=[1,2,2] cache=0 hits=0
test: list=0,3,0 max_bin=3
expect: => i=4 r=0.0 ok=true s="traced retry histogram distribution" errors=0 n=4 res=[2,0,0,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_bin};
	if mb < 0 || mb >= 200 {
		gold_fail(g, "invalid max bin for histogram");
		out.ok = false;
		return out;
	}
	var counts = [0; 256];
	for i in g.n {
		let v_val = g.res[i];
		if v_val >= 0 && v_val <= mb {
			counts[v_val]++;
		}
	}
	g.n = 0;
	var b = 0;
	while b <= mb {
		gold_push(g, counts[b]);
		b++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced retry histogram distribution");
	out
}
@end
