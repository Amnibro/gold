noun: runs
modifier: pairwise
context: compare
phrase: repeat pairwise comparison runs count {times}
phrase: duplicate pairwise differences count {times}
slot: times int
test: list=10,15,25 times=1
expect: => i=2 r=0.0 ok=true s="pairwise runs 2" errors=0 n=5 res=[10,15,25,5,10] cache=0 hits=0
test: list=4,8,16 times=2
expect: => i=2 r=0.0 ok=true s="pairwise runs 2" errors=0 n=7 res=[4,8,16,4,8,4,8] cache=0 hits=0
test: list=10 times=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t < 0 || g.n < 2 { gold_fail(g, "invalid times"); out.ok = false; return out; }
	var diffs int[512] = [0; 512];
	var dn = 0;
	for i in (g.n - 1) {
		diffs[dn] = g.res[i + 1] - g.res[i];
		dn++;
	}
	for rep in t {
		for i in dn { gold_push(g, diffs[i]); }
	}
	out.i = dn;
	out.s.clear();
	format(out.s, "pairwise runs ", dn);
	out
}
@end
@entry 1206928f6dd78d47
kind: step
verb: rotate
noun: memo
modifier: in_reverse
context: compare
phrase: rotate comparison memo in reverse {shift}
phrase: cycle memoized elements backward by {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="reverse memo rotated 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,15,25,35 shift=2
expect: => i=2 r=0.0 ok=true s="reverse memo rotated 2" errors=0 n=4 res=[25,35,5,15] cache=0 hits=0
test: list=10 shift=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if sh < 0 || g.n == 0 { gold_fail(g, "invalid shift"); out.ok = false; return out; }
	let s = sh % g.n;
	for step in s {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 { g.res[j] = g.res[j - 1]; j--; }
		g.res[0] = last;
	}
	out.i = s;
	out.s.clear();
	format(out.s, "reverse memo rotated ", s);
	out
}
@end
