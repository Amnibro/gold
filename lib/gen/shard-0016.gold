test: text="alpha beta gamma"
expect: => i=1 r=0.0 ok=true s="beta alpha gamma" errors=0 n=0 res=[] cache=0 hits=0
test: text="first second"
expect: => i=1 r=0.0 ok=true s="second first" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sp1 = -1;
	var sp2 = -1;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if sp1 < 0 {
				sp1 = i;
			} else if sp2 < 0 {
				sp2 = i;
				break;
			}
		}
	}
	if sp1 > 0 {
		var w1 byte[..100] = "";
		for i in sp1 { w1.push(out.s[i]); }
		var w2 byte[..100] = "";
		let e2 = if sp2 > 0 { sp2 } else { out.s.len };
		var j = sp1 + 1;
		while j < e2 {
			w2.push(out.s[j]);
			j++;
		}
		var rest byte[..100] = "";
		if sp2 > 0 {
			var k = sp2;
			while k < out.s.len {
				rest.push(out.s[k]);
				k++;
			}
		}
		out.s.clear();
		for b in w2 { out.s.push(b); }
		out.s.push(' ');
		for b in w1 { out.s.push(b); }
		for b in rest { out.s.push(b); }
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += out.s.len;
	out
}
@end
@entry 025e3f995ec3f116
kind: step
verb: pair
noun: digits
modifier: pairwise
context: loop
phrase: pair digits pairwise in loop input
phrase: combine input digits into pairwise numbers
test: input=1234
expect: => i=2 r=0.0 ok=true s="paired digits pairwise" errors=0 n=2 res=[12,34] cache=0 hits=0
test: input=56789
expect: => i=2 r=0.0 ok=true s="paired digits pairwise" errors=0 n=2 res=[56,78] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var val = if out.i < 0 { -out.i } else { out.i };
	var d int[32] = [0; 32];
	var count = 0;
	if val == 0 {
		d[0] = 0;
		count = 1;
	} else {
		while val > 0 {
			d[count] = val % 10;
			count++;
			val /= 10;
		}
		var l = 0;
		var r = count - 1;
		while l < r {
			let tmp = d[l];
			d[l] = d[r];
			d[r] = tmp;
			l++;
			r--;
		}
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < count {
		let num = d[i] * 10 + d[i + 1];
		gold_push(g, num);
		pairs++;
		i += 2;
	}
	g.steps += count;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired digits pairwise");
	out
}
@end
