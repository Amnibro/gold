code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	var running = 0;
	for i in g.n {
		running += g.res[i];
		if running >= low && running <= high {
			g.res[i] += 1;
		}
	}
	g.steps += g.n;
	out.i = running;
	out
}
@end
