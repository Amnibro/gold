fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_count = 0;
	var in_word = false;
	gold_clear(g);
	var cur_len = 0;
	for idx in out.s.len {
		let c = out.s[idx];
		if c != ' ' && c != '\t' && c != '\n' {
			if !in_word {
				in_word = true;
				word_count++;
				cur_len = 0;
			}
			cur_len++;
		} else {
			if in_word {
				gold_push(g, cur_len);
				in_word = false;
			}
		}
	}
	if in_word {
		gold_push(g, cur_len);
	}
	out.i = word_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "measured word count: ", word_count);
	out
}
@end
