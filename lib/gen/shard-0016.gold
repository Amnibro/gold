code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 || win > g.n {
		out.i = 0;
		return out;
	}
	var count = g.n - win + 1;
	var sums int[512] = [0; 512];
	for i in count {
		var s = 0;
		for j in win {
			s += g.res[i + j];
		}
		sums[i] = s;
	}
	for i in count {
		g.res[i] = sums[i];
	}
	g.n = count;
	g.steps += count * win;
	out.i = count;
	out.s.clear();
	format(out.s, "kept window nested sums");
	out
}
@end
