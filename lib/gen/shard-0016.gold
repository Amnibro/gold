code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 1 {
		for k in g.n - 1 {
			g.res[k] = g.res[k + 1] - g.res[k];
		}
		g.n--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise differences");
	out
}
@end
