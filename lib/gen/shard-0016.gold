code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	var last_val = -1;
	var found = false;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > lim {
			last_val = g.res[i];
			found = true;
			break;
		}
		i--;
	}
	if !found {
		gold_fail(g, "no trailing error above threshold");
	}
	g.steps += g.n;
	out.i = last_val;
	out
}
@end
