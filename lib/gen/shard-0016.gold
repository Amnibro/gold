phrase: remove duplicate checkpoints until {limit}
slot: limit int
test: list=5,5,10,10,15 limit=3
expect: => i=2 r=0.0 ok=true s="deduped count 2" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=2,2,3,3,4 limit=2
expect: => i=2 r=0.0 ok=true s="deduped count 2" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=1,2 limit=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 { gold_fail(g, "invalid limit"); out.ok = false; return out; }
	var w = 0;
	var deduped = 0;
	for i in g.n {
		var is_dup = false;
		for j in w {
			if g.res[j] == g.res[i] { is_dup = true; break; }
		}
		if !is_dup || deduped >= lim {
			g.res[w] = g.res[i];
			w++;
		} else {
			deduped++;
		}
	}
	g.n = w;
	out.i = deduped;
	out.s.clear();
	format(out.s, "deduped count ", deduped);
	out
}
@end
