test: list=10,6,8,2
expect: => i=14 r=0.0 ok=true s="summed middle" errors=0 n=4 res=[2,6,8,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var mid_sum = 0;
	if g.n > 0 {
		let mid = g.n / 2;
		if g.n % 2 == 1 {
			mid_sum = g.res[mid];
		} else {
			mid_sum = g.res[mid - 1] + g.res[mid];
		}
		gold_cache_put(g, mid, mid_sum);
	}
	g.steps += g.n;
	out.i = mid_sum;
	out.s.clear();
	format(out.s, "summed middle");
	out
}
@end
