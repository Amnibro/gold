fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	if win <= 0 || win > g.n {
		gold_fail(g, "apply average running requires valid window");
		out.ok = false;
		return out;
	}
	var avgs int[512] = [0; 512];
	let num_avgs = g.n - win + 1;
	for i in num_avgs {
		var s = 0;
		for j in win { s += g.res[i + j]; }
		avgs[i] = s / win;
	}
	gold_clear(g);
	for i in num_avgs { gold_push(g, avgs[i]); }
	g.steps += num_avgs;
	out.i = num_avgs;
	out.s.clear();
	format(out.s, "apply average running produced: ", num_avgs);
	out
}
@end
