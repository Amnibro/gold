@entry 5efb9c5e00fffd85
kind: step
verb: measure
noun: primes
modifier: between
context: aggregate
phrase: measure count of primes between lower {low} with upper {high}
phrase: tally prime occurrences situated between bounds {low} with {high}
slot: low int
slot: high int
test: list=2,4,5,7,9,11,13 low=3 high=10
expect: => i=2 r=0.0 ok=true s="primes between: 2" errors=0 n=7 res=[2,4,5,7,9,11,13] cache=0 hits=0
test: list=3,5,8,12,17 low=5 high=18
expect: => i=2 r=0.0 ok=true s="primes between: 2" errors=0 n=5 res=[3,5,8,12,17] cache=0 hits=0
code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high && ${ID}_is_p(x) {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "primes between: ", count);
	out
}
@end
