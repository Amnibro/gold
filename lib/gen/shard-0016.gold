test: list=10 threshold=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th < 0 || g.n == 0 { gold_fail(g, "invalid threshold"); out.ok = false; return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var count = 0;
	for i in g.n {
		if g.res[i] > avg && g.res[i] <= th { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "elements between ", count);
	out
}
@end
