test: list=15,5,10,3 budget=12
expect: => i=8 r=0.0 ok=true s="grouped under budget" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var cur = 0;
	var kept = 0;
	for k in g.n {
		if cur + g.res[k] <= ${budget} {
			cur += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = cur;
	out.s.clear();
	format(out.s, "grouped under budget");
	out
}
@end
