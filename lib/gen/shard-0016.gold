code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var evens int[512] = [0; 512];
	var count = 0;
	var k = g.n - 1;
	while k >= 0 {
		if g.res[k] % 2 == 0 {
			evens[count] = g.res[k];
			count++;
		}
		k--;
	}
	for i in count { g.res[i] = evens[i]; }
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "collected evens in reverse");
	out
}
@end
