noun: step
modifier: first
context: retry
phrase: dedupe retry step keeping first occurrences
phrase: remove duplicate retry steps preserving initial values
test: list=1,3,1,2,3
expect: => i=3 r=0.0 ok=true s="deduped retry steps preserving first" errors=0 n=3 res=[1,3,2] cache=0 hits=0
test: list=9,9,8,7
expect: => i=3 r=0.0 ok=true s="deduped retry steps preserving first" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped retry steps preserving first");
	out
}
@end
@entry 4ba677e9251835f6
kind: step
verb: select
noun: primes
modifier: up_to
context: aggregate
phrase: select prime results up to ceiling limit {limit}
phrase: filter prime numbers up to boundary {limit}
slot: limit int
test: list=2,4,5,7,9,11 limit=10
expect: => i=14 r=0.0 ok=true s="primes selected: 3" errors=0 n=3 res=[2,5,7] cache=0 hits=0
test: list=3,6,8,13,15 limit=15
expect: => i=16 r=0.0 ok=true s="primes selected: 2" errors=0 n=2 res=[3,13] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var count = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= limit && ${ID}_is_prime(x) {
			g.res[count] = x;
			count++;
			total = total + x;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "primes selected: ", count);
	out
}
@end
