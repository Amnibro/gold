fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var unique_count = 0;
	var i = 0;
	while i < g.n {
		var found = false;
		var j = 0;
		while j < unique_count {
			if g.res[j] == g.res[i] {
				found = true;
				break;
			}
		j++;
		}
		if !found {
			g.res[unique_count] = g.res[i];
			unique_count++;
		}
		i++;
	}
	g.n = unique_count;
	g.steps += unique_count;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "collected number unique: ", unique_count);
	out
}
@end
