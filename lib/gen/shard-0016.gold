code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let f = ${factor};
	let tgt = ${target};
	var scales = 0;
	while g.res[max_idx] < tgt && scales < 20 {
		g.res[max_idx] = g.res[max_idx] * f;
		scales++;
	}
	g.steps += scales;
	out.i = g.res[max_idx];
	out.s.clear();
	format(out.s, "scaled maximum element to ", out.i);
	out
}
@end
