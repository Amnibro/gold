@entry 5b18cf851241ca9e
kind: step
verb: keep
noun: minimum
modifier: every_other
context: loop
phrase: keep minimum every other element in results
phrase: retain minimum every other item across loop
test: list=10,2,30,4,50,6
expect: => i=10 r=0.0 ok=true s="kept minimum every other" errors=0 n=7 res=[10,2,30,4,50,6,10] cache=0 hits=0
test: list=7,1,9,3,5
expect: => i=5 r=0.0 ok=true s="kept minimum every other" errors=0 n=6 res=[7,1,9,3,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		i += 2;
	}
	out.i = min_val;
	gold_push(g, min_val);
	g.steps += g.n;
	out.s.clear();
	format(out.s, "kept minimum every other");
	out
}
@end
@entry 670e87b4e118af4d
kind: step
verb: pair
noun: items
modifier: up_to
context: loop
slot: limit int
phrase: pair items up to count {limit}
phrase: combine adjacent items up to {limit}
test: list=1,2,3,4,5 limit=4
expect: => i=2 r=0.0 ok=true s="paired items up to limit" errors=0 n=7 res=[1,2,3,4,5,3,7] cache=0 hits=0
test: list=10,20,30 limit=2
expect: => i=1 r=0.0 ok=true s="paired items up to limit" errors=0 n=4 res=[10,20,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${limit};
	if lim > g.n { lim = g.n; }
	var i = 0;
	var pairs = 0;
	while i + 1 < lim {
		let sum = g.res[i] + g.res[i + 1];
		gold_push(g, sum);
		pairs++;
		i += 2;
	}
	out.i = pairs;
	g.steps += lim;
	out.s.clear();
	format(out.s, "paired items up to limit");
	out
}
@end
