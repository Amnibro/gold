code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var modified = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = g.res[i] + d;
			modified++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "shift odds every_other modified: ", modified);
	out
}
@end
@entry c53bb1da7943dc4f
kind: step
verb: fill
noun: window
modifier: nested
context: aggregate
slot: w int
phrase: fill window nested in aggregate with {w}
phrase: apply fill window nested across aggregates with {w}
test: list=1,2,3,4,5 w=3
expect: => i=12 r=0.0 ok=true s="fill window nested max sum: 12" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=10,20,30,40 w=2
expect: => i=70 r=0.0 ok=true s="fill window nested max sum: 70" errors=0 n=3 res=[30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${w};
	if win <= 0 || win > g.n {
		gold_fail(g, "fill window nested requires valid window size");
		out.ok = false;
		return out;
	}
	var max_w = 0;
	let num_w = g.n - win + 1;
	var sums int[512] = [0; 512];
	for i in num_w {
		var s = 0;
		for j in win { s += g.res[i + j]; }
		sums[i] = s;
		if i == 0 || s > max_w { max_w = s; }
	}
	gold_clear(g);
	for i in num_w { gold_push(g, sums[i]); }
	g.steps += num_w;
	out.i = max_w;
	out.s.clear();
	format(out.s, "fill window nested max sum: ", max_w);
	out
}
@end
@entry c2f5ab8ff1435cf0
kind: step
verb: normalize
noun: numbers
modifier: each
context: aggregate
slot: scale int
phrase: normalize numbers each in aggregate with {scale}
phrase: apply normalize numbers each across aggregates with {scale}
test: list=2,4,6,8 scale=10
expect: => i=10 r=0.0 ok=true s="normalize numbers each scaled to: 10" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=5,10,15,20 scale=100
expect: => i=100 r=0.0 ok=true s="normalize numbers each scaled to: 100" errors=0 n=4 res=[25,50,75,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if sc <= 0 || g.n == 0 {
		gold_fail(g, "normalize numbers each requires positive scale");
		out.ok = false;
		return out;
	}
	var max_v = g.res[0];
	for i in g.n { if g.res[i] > max_v { max_v = g.res[i]; } }
	if max_v > 0 {
		for i in g.n {
			g.res[i] = (g.res[i] * sc) / max_v;
		}
	}
	g.steps += g.n;
	out.i = sc;
	out.s.clear();
	format(out.s, "normalize numbers each scaled to: ", sc);
	out
}
@end
