phrase: search spaces first looking for target {target}
phrase: scan spaced candidates first matching {target}
test: list=10,15,20,25,30 target=20
expect: => i=2 r=0.0 ok=true s="spaces first located target at: 2" errors=0 n=5 res=[10,15,20,25,30] cache=0 hits=0
test: list=10,15,20,25,30 target=25
expect: => i=3 r=0.0 ok=true s="spaces first located target at: 3" errors=0 n=5 res=[10,15,20,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found = -1;
	var i = 0;
	while i < g.n {
		if g.res[i] == t {
			found = i;
			break;
		}
		i += 2;
	}
	if found < 0 {
		i = 1;
		while i < g.n {
			if g.res[i] == t {
				found = i;
				break;
			}
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		out.ok = true;
		format(out.s, "spaces first located target at: ", found);
	} else {
		out.ok = false;
		format(out.s, "spaces first target not found");
	}
	out
}
@end
