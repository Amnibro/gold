test: list=10,20,30,40 pivot=25
expect: => i=70 r=0.0 ok=true s="middle swapped" errors=0 n=4 res=[10,30,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pivot = ${pivot};
	if g.n >= 2 {
		let mid = g.n / 2;
		let tmp = g.res[mid - 1];
		g.res[mid - 1] = g.res[mid];
		g.res[mid] = tmp;
	}
	var total = 0;
	for i in g.n {
		if g.res[i] > pivot {
			total = total + g.res[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "middle swapped");
	out
}
@end
@entry 3de9c5f11a43bd0d
kind: step
