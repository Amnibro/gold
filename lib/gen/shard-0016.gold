fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var running = 0;
	var idx = 0;
	while idx < g.n {
		running += g.res[idx];
		if running >= lim {
			break;
		}
		idx++;
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "calculated running retry threshold");
	out
}
