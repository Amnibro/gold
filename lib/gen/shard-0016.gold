test: list=10 count=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c < 0 || g.n < 2 { gold_fail(g, "invalid count"); out.ok = false; return out; }
	var swaps = 0;
	for i in (g.n - 1) {
		if swaps >= c { break; }
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "min pairwise swapped ", swaps);
	out
}
@end
