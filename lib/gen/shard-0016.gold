slot: gap int
phrase: retry sequence at least gap {gap} in aggregate
phrase: aggregate retry sequence spacing to at least {gap}
test: list=1,2,3,4 gap=5
expect: => i=3 r=0.0 ok=true s="sequence adjustments made: 3" errors=0 n=4 res=[1,6,11,16] cache=0 hits=0
test: list=10,12,18 gap=3
expect: => i=1 r=0.0 ok=true s="sequence adjustments made: 1" errors=0 n=3 res=[10,13,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	if g.n < 2 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "sequence length under minimum");
		return out;
	}
	var adjusted = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff < min_gap {
			g.res[i] = g.res[i - 1] + min_gap;
			adjusted++;
		}
	}
	g.steps += adjusted;
	out.i = adjusted;
	out.ok = true;
	out.s.clear();
	format(out.s, "sequence adjustments made: ", adjusted);
	out
}
@end
@entry 1daf9fd2c9377d78
kind: step
