kind: step
verb: scale
noun: streak
modifier: times
context: loop
phrase: scale streak times in loop cycles using {scale}
phrase: apply scale streak times across loop items with {scale}
slot: scale int
test: list=2,2,2,5,5 scale=2
expect: => i=2 r=0.0 ok=true s="scaled streaks count: 2" errors=0 n=5 res=[4,4,4,10,10] cache=0 hits=0
test: list=3,3,4,4,4 scale=3
expect: => i=2 r=0.0 ok=true s="scaled streaks count: 2" errors=0 n=5 res=[9,9,12,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let sc = ${scale};
	var i = 0;
	var streak_count = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= 2 {
			for k in i..j { g.res[k] = g.res[k] * sc; }
			streak_count++;
		}
		i = j;
	}
	g.steps += streak_count;
	out.i = streak_count;
	out.s.clear();
	format(out.s, "scaled streaks count: ", streak_count);
	out
}
@end
