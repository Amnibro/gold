@entry 70d2f29c1627d1ee
kind: step
verb: map
noun: pairs
modifier: sorted
context: aggregate
phrase: map pairs after sorting list by adding difference {diff}
phrase: transform sorted adjacent pairs adding gap {diff}
slot: diff int
test: list=9,2,6,4 diff=1
expect: => i=10 r=0.0 ok=true s="mapped sorted pairs" errors=0 n=3 res=[3,3,4] cache=0 hits=0
test: list=15,5,25 diff=2
expect: => i=24 r=0.0 ok=true s="mapped sorted pairs" errors=0 n=2 res=[12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let diff = ${diff};
	if g.n < 2 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let pairs = g.n - 1;
	for i in pairs {
		g.res[i] = (g.res[i + 1] - g.res[i]) + diff;
	}
	g.n = pairs;
	var total = 0;
	for i in g.n { total = total + g.res[i]; }
	g.steps += pairs;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped sorted pairs");
	out
}
@end
