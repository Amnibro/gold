fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let limit = ${lim};
	var count = 0;
	for i in 1..g.n {
		let gap = core_abs_val(g.res[i] - g.res[i - 1]);
		if gap <= limit { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured gaps up to limit: ", count);
	out
}
