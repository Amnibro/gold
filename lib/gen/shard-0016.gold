fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	var last_odd = 0;
	var found = false;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			last_odd = g.res[k];
			found = true;
		}
	}
	if found && cnt > 0 {
		var i = 0;
		while i < cnt {
			gold_push(g, last_odd);
			i++;
		}
	}
	g.steps += g.n;
	out.i = if found { last_odd } else { 0 };
	out.s.clear();
	format(out.s, "repeated last odd retry value");
	out
}
