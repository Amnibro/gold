fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "series sorted pairwise: ", g.n);
	out
}
@end
