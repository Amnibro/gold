verb: split
noun: gaps
modifier: until
context: aggregate
slot: threshold int
phrase: split gaps until in aggregate with {threshold}
phrase: apply split gaps until across aggregates with {threshold}
test: list=2,5,9,18,25 threshold=5
expect: => i=3 r=0.0 ok=true s="split gaps until count: 3" errors=0 n=3 res=[3,4,9] cache=0 hits=0
test: list=10,12,15,22 threshold=4
expect: => i=3 r=0.0 ok=true s="split gaps until count: 3" errors=0 n=3 res=[2,3,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th <= 0 || g.n < 2 {
		gold_fail(g, "split gaps until requires at least 2 items");
		out.ok = false;
		return out;
	}
	var gaps int[512] = [0; 512];
	var count = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		gaps[count] = diff;
		count++;
		if diff >= th { break; }
	}
	gold_clear(g);
	for i in count { gold_push(g, gaps[i]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split gaps until count: ", count);
	out
}
@end
