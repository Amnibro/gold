expect: => i=2 r=0.0 ok=true s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let marker = ${stop_val};
	var odds = 0;
	var found = false;
	var i = 0;
	while i < g.n {
		if g.res[i] == marker {
			found = true;
			break;
		}
		if g.res[i] % 2 != 0 {
			odds++;
		}
		i++;
	}
	if !found {
		gold_fail(g, "sentinel marker not found in list");
	}
	g.steps += g.n;
	out.i = odds;
	out
}
@end
