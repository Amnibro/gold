expect: => i=0 r=0.0 ok=true s="filtered duplicates at least min count" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var kept = 0;
	for i in g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq >= mc {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered duplicates at least min count");
	out
}
@end
@entry 6932a0e0ef90b50d
kind: step
verb: measure
noun: value
modifier: sorted
context: aggregate
phrase: measure median value after sorting with rank {rank}
phrase: compute ranked value in sorted results at {rank}
slot: rank int
test: list=9,3,7,1 rank=2
expect: => i=7 r=0.0 ok=true s="sorted value: 7" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
test: list=20,10,30 rank=1
expect: => i=20 r=0.0 ok=true s="sorted value: 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rank = ${rank};
	if g.n == 0 { return out; }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var idx = rank;
	if idx >= g.n { idx = g.n - 1; }
	g.steps += g.n;
	out.i = g.res[idx];
	out.s.clear();
	format(out.s, "sorted value: ", out.i);
	out
}
@end
