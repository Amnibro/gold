test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.718 sum8=21236 hash=61076
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="leather" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.658 sum8=61938 hash=537424
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	var s_b1 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b1[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b1;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.23); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "leather");
	out
}
@end
@entry 97b0dbee0f3c600a
kind: step
verb: mask
noun: concrete
modifier: none
context: texture
phrase: mask none concrete diffuse map with seed {u}
phrase: render none concrete surface texture using seed {u}
slot: u int
model: noise c=4 u=${u}; contrast a=1.12; quantize n=6
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="concrete" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=37128 hash=841591
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="concrete" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=116025 hash=629266
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.12 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (6 as real)) as! int;
		if t > 6 - 1 { t = 6 - 1; }
		g.img[k] = (t as real) / ((6 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "concrete");
	out
}
@end
