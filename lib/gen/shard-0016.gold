code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${k};
	if len <= 1 || len > g.n {
		gold_fail(g, "invalid k");
		out.ok = false;
		return out;
	}
	for i in len / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[len - 1 - i];
		g.res[len - 1 - i] = tmp;
	}
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "reversed head ", len);
	out
}
@end
