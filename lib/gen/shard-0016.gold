@entry 8d8b8f1830acef77
kind: step
verb: dedupe
noun: gaps
modifier: while
context: retry
slot: min_gap int
phrase: dedupe gaps while difference below {min_gap}
phrase: remove close elements while gap under {min_gap}
test: list=2,4,5,10,12 min_gap=3
expect: => i=2 r=0.0 ok=true s="gap duplicates pruned: 2" errors=0 n=3 res=[2,5,10] cache=0 hits=0
test: list=1,2,6,7,8 min_gap=2
expect: => i=2 r=0.0 ok=true s="gap duplicates pruned: 2" errors=0 n=3 res=[1,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	if g.n <= 1 { return out; }
	var w = 1;
	for i in 1..g.n {
		if g.res[i] - g.res[w - 1] >= gap {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	out.ok = true;
	out.s.clear();
	format(out.s, "gap duplicates pruned: ", removed);
	g.steps += removed;
	out
}
@end
