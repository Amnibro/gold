fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let separator = ${val};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for i in old_n {
		orig[i] = g.res[i];
	}
	var new_n = 0;
	for i in old_n {
		g.res[new_n] = orig[i];
		new_n++;
		g.res[new_n] = separator;
		new_n++;
	}
	g.n = new_n;
	g.steps += old_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged sequence each item");
	out
}
@end
