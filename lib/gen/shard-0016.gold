test: list=2,5,2,2,8 limit=3
expect: => i=2 r=0.0 ok=true s="minimum count until limit: 2" errors=0 n=5 res=[2,5,2,2,8] cache=0 hits=0
test: list=1,4,1,6,1 limit=4
expect: => i=2 r=0.0 ok=true s="minimum count until limit: 2" errors=0 n=5 res=[1,4,1,6,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "minimum count: 0");
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var cnt = 0;
	var bound = if lim < g.n { lim } else { g.n };
	for i in bound {
		if g.res[i] == min_val { cnt++; }
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "minimum count until limit: ", cnt);
	out
}
@end
