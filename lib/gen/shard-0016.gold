@entry 17cdd91dee12f00b
kind: fn
verb: cache
noun: gaps
modifier: unique
context: loop
phrase: count unique gaps between adjacent digits
phrase: find distinct absolute differences between digits
test: arg=1357,1212
expect: 1
expect: 1
test: arg=909,5
expect: 1
expect: 0
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 0; }
	var mask = 0;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		var diff = cur - prev;
		if diff < 0 { diff = -diff; }
		mask = mask | (1 << diff);
		prev = cur;
		x /= 10;
	}
	var count = 0;
	for i in 10 { if (mask & (1 << i)) != 0 { count++; } }
	count
}
@end
@entry 47f9fa427c9aa70c
kind: pred
verb: find
noun: sequence
modifier: at_most
context: loop
phrase: longest increasing digit sequence at most {max_len}
phrase: verify increasing run length is at most {max_len}
slot: max_len int
test: arg=12345,1254 max_len=3
expect: false
expect: true
test: arg=9876,12 max_len=2
expect: true
expect: true
code:
fn ${ID}(n int) bool {
	let ml = ${max_len};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1 <= ml; }
	var best = 1;
	var cur_run = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur < prev { cur_run++; } else { cur_run = 1; }
		if cur_run > best { best = cur_run; }
		prev = cur;
		x /= 10;
	}
	best <= ml
}
@end
