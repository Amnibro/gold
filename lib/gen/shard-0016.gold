@entry f50a47e0259776c2
kind: step
verb: cache
noun: steps
modifier: up_to
context: sort
phrase: cache sorting steps up to limit {limit}
phrase: store sort pass counts up to limit {limit}
slot: limit int
test: list=9,4,7,2,1 limit=3
expect: => i=3 r=0.0 ok=true s="ran 3 sort passes" errors=0 n=5 res=[2,1,4,7,9] cache=3 hits=0
test: list=3,1,2 limit=2
expect: => i=2 r=0.0 ok=true s="ran 2 sort passes" errors=0 n=3 res=[1,2,3] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_passes = ${limit};
	var passes = 0;
	while passes < max_passes && passes < g.n {
		var swapped = 0;
		for j in (g.n - 1 - passes) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				swapped++;
			}
		}
		gold_cache_put(g, passes, swapped);
		passes++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "ran ", passes, " sort passes");
	out
}
@end
