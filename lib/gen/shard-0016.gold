	var x = if n < 0 { -n } else { n };
	var seen int[10] = [0; 10];
	if x == 0 { return 1; }
	while x > 0 {
		seen[x % 10] = 1;
		x /= 10;
	}
	var d int[10] = [0; 10];
	var len = 0;
	for i in 10 {
		if seen[i] == 1 {
			d[len] = i;
			len++;
		}
	}
	var max_run = 1;
	var cur_run = 1;
	var i = 0;
	while i + 1 < len {
		if d[i + 1] == d[i] + 1 {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
		i++;
	}
	if max_run > limit { limit } else { max_run }
}
@end
