expect: => i=4 r=0.0 ok=true s="reversed count: 4" errors=0 n=4 res=[9,7,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 || !${p}(g.res[0]) {
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "initial predicate not matched");
		return out;
	}
	for i in g.n / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	out.ok = true;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed count: ", g.n);
	out
}
@end
