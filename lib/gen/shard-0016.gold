fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var halves int[512] = [0; 512];
	var hn = 0;
	for i in g.n {
		let x = g.res[i];
		if hn + 2 <= 512 {
			halves[hn] = x / 2;
			halves[hn + 1] = x - (x / 2);
			hn += 2;
		}
	}
	gold_clear(g);
	for i in hn { gold_push(g, halves[i]); }
	g.steps += hn;
	out.i = hn;
	out
}
@end
