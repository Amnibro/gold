expect: => i=50 r=0.0 ok=true s="joined first retry value with suffix" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15
expect: => i=20 r=0.0 ok=true s="joined first retry value with suffix" errors=0 n=3 res=[5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty list for suffix join");
		return out;
	}
	let first = g.res[0];
	let last = g.res[g.n - 1];
	let combined = first + last;
	gold_push(g, combined);
	g.steps += g.n;
	out.i = combined;
	out.s.clear();
	format(out.s, "joined first retry value with suffix");
	out
}
@end
@entry 8d7c75c09b35da3c
kind: step
verb: sort
noun: series
modifier: with_cache
context: retry
phrase: sort retry series with cache tracking
phrase: order retry series ascending caching smallest attempt
test: list=8,2,6,4
expect: => i=4 r=0.0 ok=true s="sorted retry series with cache" errors=0 n=4 res=[2,4,6,8] cache=1 hits=0
test: list=15,3,9
expect: => i=3 r=0.0 ok=true s="sorted retry series with cache" errors=0 n=3 res=[3,9,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if g.n > 0 {
		gold_cache_put(g, 0, g.res[0]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted retry series with cache");
	out
}
@end
