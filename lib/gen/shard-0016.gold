fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${a} <= 0.0 || ${h} <= 0.0 || ${r} <= 0.0 { gold_fail(g, "dimensions must be positive"); out.ok = false; return out; }
	gold_dnews(g, "rib", "", o);
	o.append(" box 0,0,");
	gold_fnum(o, ${h} * 0.5);
	o.append(" ");
	gold_fnum(o, ${a});
	o.append(",0.");
	o.append("01,");
	gold_fnum(o, ${h});
	o.append(" m:metal");
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "bore", "", o);
	o.append(" cyl 0,0,-");
	o.append("0.");
	o.append("05 ");
	o.append("0,");
	o.append("0,0.");
	o.append("05 r");
	gold_fnum(o, ${r});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "addribcnt");
	out
}
@end
