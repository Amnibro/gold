@entry 4720b505fae922ed
kind: step
verb: normalize
noun: counter
modifier: sorted
context: transform
phrase: normalize counter sorted during transform processing pass
phrase: execute normalize counter sorted over transform results
test: list=30,10,20
expect: => i=3 r=0.0 ok=true s="normalized counter sorted: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,15,40,25
expect: => i=4 r=0.0 ok=true s="normalized counter sorted: 4" errors=0 n=4 res=[15,25,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized counter sorted: ", g.n);
	out
}
@end
@entry c05d9a53b03f1e84
kind: step
verb: run
noun: window
modifier: last
context: transform
phrase: run window last in transform cycles using {size}
phrase: apply run window last across transform items with {size}
slot: size int
test: list=1,2,3,4,5 size=2
expect: => i=9 r=0.0 ok=true s="ran window last: 9" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 size=3
expect: => i=90 r=0.0 ok=true s="ran window last: 90" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	let k = if sz < g.n { sz } else { g.n };
	var sum = 0;
	var i = 0;
	while i < k {
		sum += g.res[g.n - 1 - i];
		i++;
	}
	g.steps += k;
	out.i = sum;
	out.s.clear();
	format(out.s, "ran window last: ", sum);
	out
}
@end
@entry fa0ec01f74c58916
kind: step
verb: compare
noun: odds
modifier: every_other
context: transform
phrase: compare odds every_other during transform processing pass
phrase: execute compare odds every_other over transform results
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="compared odds every other item: 3" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=2,3,4,5,6,7
expect: => i=0 r=0.0 ok=true s="compared odds every other item: 0" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 != 0 {
			odd_count++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	format(out.s, "compared odds every other item: ", odd_count);
	out
}
@end
@entry 54b6db912194cfd0
kind: step
verb: split
noun: values
modifier: until
context: transform
phrase: split values until in transform cycles using {threshold}
phrase: apply split values until across transform items with {threshold}
slot: threshold int
test: list=10,20,50,60 threshold=40
expect: => i=2 r=0.0 ok=true s="split values until threshold: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35 threshold=20
expect: => i=2 r=0.0 ok=true s="split values until threshold: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	for i in g.n {
		if g.res[i] >= th {
			break;
		}
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split values until threshold: ", count);
	out
}
@end
@entry 2b62f9e31de27137
kind: step
verb: cache
noun: head
modifier: with_retry
context: transform
phrase: cache head with_retry in transform cycles using {retries}
phrase: apply cache head with_retry across transform items with {retries}
slot: retries int
test: list=100,200,300 retries=3
expect: => i=3 r=0.0 ok=true s="cached head with retry: 3" errors=0 n=3 res=[100,200,300] cache=3 hits=0
test: list=50,150 retries=2
expect: => i=2 r=0.0 ok=true s="cached head with retry: 2" errors=0 n=2 res=[50,150] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let retries = ${retries};
	let head_val = g.res[0];
	for r in retries {
		gold_cache_put(g, head_val + r, r + 1);
	}
	g.steps += retries;
	out.i = retries;
	out.s.clear();
	format(out.s, "cached head with retry: ", retries);
	out
}
@end
@entry 633013880d9662a2
kind: step
verb: drop
noun: text
modifier: unique
context: transform
phrase: drop text unique during transform processing pass
phrase: execute drop text unique over transform results
test: text="banana apple"
expect: => i=7 r=0.0 ok=true s="dropped non unique text characters: 7" errors=0 n=0 res=[] cache=0 hits=0
test: text="abc"
expect: => i=3 r=0.0 ok=true s="dropped non unique text characters: 3" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen bool[256];
	for i in 256 { seen[i] = false; }
	var unique_count = 0;
	for b in v.s {
		let idx = b as int;
		if idx >= 0 && idx < 256 {
			if !seen[idx] {
				seen[idx] = true;
				unique_count++;
			}
		}
	}
	g.steps += unique_count;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "dropped non unique text characters: ", unique_count);
	out
}
@end
@entry 49168d642cdd9f3a
kind: step
verb: split
noun: total
modifier: up_to
context: transform
phrase: split total up_to in transform cycles using {cap}
phrase: apply split total up_to across transform items with {cap}
slot: cap int
test: list=5,10,15,20 cap=20
expect: => i=30 r=0.0 ok=true s="split total up to limit: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=10,20,30 cap=25
expect: => i=30 r=0.0 ok=true s="split total up to limit: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var running = 0;
	var count = 0;
	for i in g.n {
		running += g.res[i];
		if running > cap { break; }
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = running;
	out.s.clear();
	format(out.s, "split total up to limit: ", count);
	out
}
@end
@entry 5056cd3f2566ce74
kind: step
verb: apply
noun: average
modifier: while
context: transform
phrase: apply average while in transform cycles using {min_val}
phrase: apply apply average while across transform items with {min_val}
slot: min_val int
test: list=20,30,10 min_val=15
expect: => i=25 r=0.0 ok=true s="applied average while condition holds: 25" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=50,60,10 min_val=40
expect: => i=55 r=0.0 ok=true s="applied average while condition holds: 55" errors=0 n=3 res=[50,60,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min_val};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] < min_v { break; }
		sum += g.res[i];
		count++;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	g.steps += count;
	out.i = avg;
	out.s.clear();
	format(out.s, "applied average while condition holds: ", avg);
	out
}
@end
