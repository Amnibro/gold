fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var running = 0;
	var stored = 0;
	for i in g.n {
		running += g.res[i];
		gold_cache_put(g, i, running);
		stored++;
		if running >= cap {
			break;
		}
	}
	g.steps += stored;
	out.i = running;
	out
}
