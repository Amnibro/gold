@entry 6317f7c419119757
kind: step
verb: reverse
noun: runs
modifier: while
context: loop
slot: p pred
phrase: reverse runs while {p} holds
phrase: invert matching runs while {p}
test: list=2,4,6,3,8,10 p=is_even
expect: => i=2 r=0.0 ok=true s="runs reversed" errors=0 n=6 res=[6,4,2,3,10,8] cache=0 hits=0
test: list=1,3,5,2,4 p=is_odd
expect: => i=1 r=0.0 ok=true s="runs reversed" errors=0 n=5 res=[5,3,1,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var count = 0;
	while i < g.n {
		if ${p}(g.res[i]) {
			var j = i;
			while j < g.n && ${p}(g.res[j]) { j++; }
			var left = i;
			var right = j - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			count++;
			i = j;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "runs reversed");
	out
}
@end
