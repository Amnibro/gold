code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	if fl < 0 || g.n == 0 { gold_fail(g, "invalid floor"); out.ok = false; return out; }
	var peak = -1;
	for i in g.n {
		if g.res[i] >= fl && g.res[i] > peak { peak = g.res[i]; }
	}
	out.i = peak;
	out.s.clear();
	format(out.s, "max peak ", peak);
	out
}
@end
