test: list=10 ceiling=-1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if ceil < 0 || g.n == 0 { gold_fail(g, "invalid ceiling"); out.ok = false; return out; }
	var clamped = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] > ceil {
		g.res[i] = ceil;
		clamped++;
		i--;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "suffix while clamped ", clamped);
	out
}
@end
