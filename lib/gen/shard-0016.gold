noun: window
modifier: with_cache
context: transform
phrase: find window with_cache in transform cycles using {size}
phrase: apply find window with_cache across transform items with {size}
slot: size int
test: list=1,3,2,5,4 size=3
expect: => i=11 r=0.0 ok=true s="found max window with cache: 11" errors=0 n=5 res=[1,3,2,5,4] cache=1 hits=0
test: list=10,20,15,30 size=2
expect: => i=45 r=0.0 ok=true s="found max window with cache: 45" errors=0 n=4 res=[10,20,15,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if g.n < sz || sz <= 0 { return out; }
	var max_sum = 0;
	for i in sz { max_sum += g.res[i]; }
	var cur_sum = max_sum;
	var idx = sz;
	while idx < g.n {
		cur_sum = cur_sum - g.res[idx - sz] + g.res[idx];
		if cur_sum > max_sum { max_sum = cur_sum; }
		idx++;
	}
	gold_cache_put(g, sz, max_sum);
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "found max window with cache: ", max_sum);
	out
}
@end
