fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text");
		out.ok = false;
		return out;
	}
	for i in out.s.len {
		var min_idx = i;
		for j in (i + 1)..out.s.len {
			if out.s[j] < out.s[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = out.s[i];
			out.s[i] = out.s[min_idx];
			out.s[min_idx] = tmp;
		}
	}
	let last_char = out.s[out.s.len - 1] as int;
	out.i = last_char;
	g.steps += out.s.len;
	out
}
@end
