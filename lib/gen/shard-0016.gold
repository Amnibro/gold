@entry 89851a6da23e9744
kind: step
verb: reverse
noun: loop
modifier: last
context: loop
slot: count int
phrase: reverse loop last {count} items
phrase: invert direction of last {count} elements
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed loop last" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed loop last" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	if k > g.n { k = g.n; }
	var left = g.n - k;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed loop last");
	out
}
@end
