code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	for i in g.n {
		if g.res[i] == b {
			gold_fail(g, "base value encountered in sequence");
			out.i = b;
			return out;
		}
	}
	for i in g.n {
		g.res[i] -= b;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
