@entry 61dea620e087a0c4
kind: step
verb: reverse
noun: history
modifier: while
context: error
phrase: reverse error history sequence while items exceed {limit}
phrase: invert fault record order while values stay above {limit}
slot: limit int
test: list=15,20,25 limit=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[25,20,15] cache=0 hits=0
test: list=5,10,15 limit=8
expect: => i=3 r=0.0 ok=true s="" errors=1 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_reverse_history_while
	var out = v;
	let lim = ${limit};
	var all_above = true;
	for i in g.n {
		if g.res[i] <= lim { all_above = false; break; }
	}
	if all_above {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	} else {
		gold_fail(g, "one or more elements fell below required threshold");
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
@entry 2f1f0eb487baaf9e
kind: step
verb: pair
noun: gaps
modifier: with_cache
context: error
phrase: pair error gaps with cache using limit {gap_limit}
phrase: record adjacent fault gaps into cache below {gap_limit}
slot: gap_limit int
test: list=2,5,15,18 gap_limit=8
expect: => i=3 r=0.0 ok=true s="" errors=1 n=4 res=[2,5,15,18] cache=3 hits=0
test: list=1,4,7,10 gap_limit=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[1,4,7,10] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_pair_gaps_with_cache
	var out = v;
	let lim = ${gap_limit};
	var cached = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let diff = g.res[idx + 1] - g.res[idx];
		let gap = if diff < 0 { -diff } else { diff };
		gold_cache_put(g, idx, gap);
		cached++;
		if gap > lim {
			gold_fail(g, "gap exceeds threshold limit");
		}
		idx++;
	}
	g.steps += g.n;
	out.i = cached;
	out
}
@end
