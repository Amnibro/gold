@entry 0df55322da0a5000
kind: pred
verb: rank
noun: streak
modifier: between
context: math
phrase: rank streak between {low} and {high}
phrase: streak rank between limits {low} {high}
slot: low int
slot: high int
test: arg=1112,1234 low=2 high=4
expect: true
expect: false
test: arg=111,222 low=3 high=3
expect: true
expect: true
code:
fn ${ID}(n int) bool {
	let lo = ${low};
	let hi = ${high};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return lo <= 1 && hi >= 1; }
	var max_streak = 1;
	var cur_streak = 1;
	var last_d = x % 10;
	x /= 10;
	while x > 0 {
		let d = x % 10;
		if d == last_d {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
			last_d = d;
		}
		x /= 10;
	}
	max_streak >= lo && max_streak <= hi
}
@end
