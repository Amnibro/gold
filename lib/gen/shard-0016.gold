expect: => i=14 r=0.0 ok=true s="summed unique evens: 14" errors=0 n=5 res=[1,3,4,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var seen int[64];
	var seen_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var found = false;
			for k in seen_count {
				if seen[k] == x { found = true; break; }
			}
			if !found && seen_count < 64 {
				seen[seen_count] = x;
				seen_count++;
				sum += x;
			}
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed unique evens: ", sum);
	out
}
@end
