@entry 0d7078e98d7af04b
kind: step
verb: rotate
noun: primes
modifier: up_to
context: retry
slot: limit int
phrase: rotate prime numbers up to position {limit}
phrase: cycle prime values up to index {limit}
test: list=2,3,4,5,6,7 limit=4
expect: => i=3 r=0.0 ok=true s="rotated primes count: 3" errors=0 n=6 res=[3,4,5,2,6,7] cache=0 hits=0
test: list=11,13,15,17 limit=3
expect: => i=2 r=0.0 ok=true s="rotated primes count: 2" errors=0 n=4 res=[13,15,11,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var prime_count = 0;
	var max_i = lim;
	if max_i > g.n { max_i = g.n; }
	for i in max_i {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { prime_count++; }
	}
	if max_i > 1 {
		let first_val = g.res[0];
		for i in max_i - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[max_i - 1] = first_val;
	}
	out.i = prime_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated primes count: ", prime_count);
	g.steps += max_i;
	out
}
@end
