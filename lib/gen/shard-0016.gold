test: list=5,25,12,30
expect: => i=51 r=0.0 ok=true s="pairwise total difference: 51" errors=0 n=3 res=[20,13,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	let pairs = g.n - 1;
	var sum_diff = 0;
	for i in pairs {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		g.res[i] = diff;
		sum_diff += diff;
	}
	g.n = pairs;
	out.i = sum_diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "pairwise total difference: ", sum_diff);
	out
}
@end
@entry aaca92cb2e7f6f6c
kind: step
verb: retry
noun: squares
modifier: recursively
context: aggregate
phrase: retry squares recursively in aggregate
phrase: aggregate retry nearest square adjustment
test: list=5,9,14,25
expect: => i=2 r=0.0 ok=true s="squares adjusted count: 2" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=2,10,18,36
expect: => i=3 r=0.0 ok=true s="squares adjusted count: 3" errors=0 n=4 res=[1,9,16,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var adjustments = 0;
	for i in g.n {
		let x = g.res[i];
		if x > 0 {
			var r = 0;
			while (r + 1) * (r + 1) <= x { r++; }
			let sq1 = r * r;
			let sq2 = (r + 1) * (r + 1);
			let near_sq = if x - sq1 <= sq2 - x { sq1 } else { sq2 };
			if near_sq != x {
				g.res[i] = near_sq;
				adjustments++;
			}
		}
	}
	out.i = adjustments;
	out.ok = true;
	out.s.clear();
	format(out.s, "squares adjusted count: ", adjustments);
	out
}
@end
@entry c68571a1940e6dda
kind: step
