code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for k in g.n { g.res[k] *= ${factor}; }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied history factor");
	out
}
@end
