@entry 1013a45c282c5ec4
kind: step
verb: return
noun: duplicates
modifier: safely
context: search
phrase: return duplicate search occurrences safely
phrase: retrieve duplicated candidate items safely
test: list=1,2,2,3,4,4,5
expect: => i=2 r=0.0 ok=true s="safe duplicate items returned: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="safe duplicate items returned: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var already = false;
			for k in kept {
				if g.res[k] == x { already = true; break; }
			}
			if !already {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "safe duplicate items returned: ", kept);
	out
}
@end
@entry d065be98397b0ee4
kind: step
verb: return
noun: spaces
modifier: at_least
context: search
slot: min_gap int
phrase: return search items spaced at least distance {min_gap}
phrase: collect candidates with spacing at least {min_gap}
test: list=1,3,4,8,10 min_gap=3
expect: => i=3 r=0.0 ok=true s="spaced items retained: 3" errors=0 n=3 res=[1,4,8] cache=0 hits=0
test: list=2,4,6,8 min_gap=5
expect: => i=2 r=0.0 ok=true s="spaced items retained: 2" errors=0 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var kept = 0;
	if g.n > 0 {
		g.res[0] = g.res[0];
		kept = 1;
		var last = g.res[0];
		for i in 1..g.n {
			let diff = g.res[i] - last;
			let pos_diff = if diff < 0 { -diff } else { diff };
			if pos_diff >= gap {
				g.res[kept] = g.res[i];
				last = g.res[i];
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "spaced items retained: ", kept);
	out
}
@end
