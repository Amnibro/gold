fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_end = ${end_val};
	if g.n == 0 || g.res[g.n - 1] >= target_end {
		gold_fail(g, "fill range last requires end greater than last");
		out.ok = false;
		return out;
