@entry 4ff26c7f3ad5ee5d
kind: step
verb: limit
noun: streak
modifier: pairwise
context: sort
phrase: limit pairwise duplicate streaks to {max_streak} items
phrase: cap repeating identical sorted streaks at {max_streak}
slot: max_streak int
test: list=2,2,2,2,5,5,7 max_streak=2
expect: => i=5 r=0.0 ok=true s="limited streaks" errors=0 n=5 res=[2,2,5,5,7] cache=0 hits=0
test: list=1,1,1,3,3,3 max_streak=1
expect: => i=2 r=0.0 ok=true s="limited streaks" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let cap = if ${max_streak} < 1 { 1 } else { ${max_streak} };
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		let take = if run_len > cap { cap } else { run_len };
		for m in take {
			g.res[kept] = g.res[i];
			kept++;
		}
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "limited streaks");
	out
}
@end
