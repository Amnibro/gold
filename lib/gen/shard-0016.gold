kind: step
verb: apply
noun: total
modifier: last
context: error
phrase: apply total to last error results with minimum {min_total}
phrase: sum trailing fault entries requiring at least {min_total}
slot: min_total int
test: list=5,10,15 min_total=20
expect: => i=25 r=0.0 ok=true s="" errors=0 n=3 res=[5,10,15] cache=0 hits=0
test: list=1,2,3 min_total=10
expect: => i=5 r=0.0 ok=true s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let required = ${min_total};
	if g.n < 2 {
		gold_fail(g, "not enough items for trailing total");
		out.i = 0;
		return out;
	}
	let sum_last = g.res[g.n - 1] + g.res[g.n - 2];
	if sum_last < required {
		gold_fail(g, "trailing total below minimum threshold");
	}
	g.steps += 2;
	out.i = sum_last;
	out
}
@end
