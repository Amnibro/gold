@entry 7a2cddea1f2ea704
kind: step
verb: apply
noun: digits
modifier: between
context: error
phrase: apply digit sum check between bounds {low} to {high}
phrase: filter digit counts between limits {low} to {high}
slot: low int
slot: high int
test: list=12,34,56 low=2 high=10
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[12,34,56] cache=0 hits=0
test: list=11,99 low=1 high=5
expect: => i=1 r=0.0 ok=true s="" errors=1 n=2 res=[11,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_s = ${low};
	let max_s = ${high};
	var invalid = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s < min_s || s > max_s {
			invalid++;
		}
	}
	if invalid > 0 {
		gold_fail(g, "digit sum out of permitted bounds");
	}
	g.steps += g.n;
	out.i = invalid;
	out
}
@end
