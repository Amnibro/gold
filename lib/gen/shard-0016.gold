fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let v_in = ${val};
	var i = g.n - 1;
	while i >= 0 {
		if i + cnt < 512 {
			g.res[i + cnt] = g.res[i];
		}
		i--;
	}
	for k in cnt {
		if k < 512 {
			g.res[k] = v_in;
		}
	}
	g.n = if g.n + cnt <= 512 { g.n + cnt } else { 512 };
	g.steps += cnt;
	out.i = cnt;
	out.s.clear();
	format(out.s, "filled numbers first: ", cnt);
	out
}
