code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len = 0;
	while len < g.n && ${p}(g.res[len]) {
		len++;
	}
	out.i = len;
	g.steps += len;
	out.s.clear();
	format(out.s, "measured prefix while");
	out
}
@end
