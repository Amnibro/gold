fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let r = ${rounds};
	var swaps = 0;
	for step in r {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i++;
		}
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped numbers recursively: ", swaps);
	out
}
@end
