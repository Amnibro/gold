code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	if d < 0 || g.n < 2 { gold_fail(g, "invalid diff"); out.ok = false; return out; }
	var pairs = 0;
	for i in (g.n - 1) {
		let gap = g.res[i + 1] - g.res[i];
		if gap == d || gap == -d { pairs++; }
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairs with delta ", pairs);
	out
}
@end
