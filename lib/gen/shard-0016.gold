	out
}
@end
@entry 6eb2a701f2c3dd0a
kind: step
verb: swap
noun: step
modifier: unique
context: error
phrase: swap unique error entries separated by step {step_gap}
phrase: exchange distinct fault items with interval {step_gap}
slot: step_gap int
test: list=10,20,30,40 step_gap=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
test: list=1,3,5,7 step_gap=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[3,1,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_swap_step_unique
	var out = v;
	let gap = ${step_gap};
	if gap > 0 && gap < g.n {
		let tmp = g.res[0];
		g.res[0] = g.res[gap];
		g.res[gap] = tmp;
		out.i = gap;
	} else {
		gold_fail(g, "step gap out of bounds for swapping");
	}
	g.steps += g.n;
	out
}
@end
@entry e1cbced0155e4276
kind: step
verb: retry
noun: tally
modifier: pairwise
context: error
phrase: retry tally of pairwise error mismatches under {max_mismatch}
phrase: evaluate pairwise fault discrepancies allowing up to {max_mismatch}
slot: max_mismatch int
test: list=10,12,15,30 max_mismatch=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[10,12,15,30] cache=0 hits=0
test: list=1,5,10,20 max_mismatch=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_retry_tally_pairwise
	var out = v;
	let ceiling = ${max_mismatch};
	var mismatches = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > 5 {
			mismatches++;
		}
		i++;
	}
	if mismatches > ceiling {
		gold_fail(g, "pairwise mismatches exceeded maximum threshold");
	}
	g.steps += g.n;
	out.i = mismatches;
	out
}
@end
