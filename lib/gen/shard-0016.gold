fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diffs int[512] = [0; 512];
	var ndiffs = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			var seen = false;
			for j in ndiffs {
				if diffs[j] == d { seen = true; break; }
			}
			if !seen {
				diffs[ndiffs] = d;
				ndiffs++;
			}
		}
	}
	g.steps += g.n;
	out.i = ndiffs;
	out.s.clear();
	format(out.s, "unique adjacent differences: ", ndiffs);
	out
}
@end
