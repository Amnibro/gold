code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	let mid_start = 1;
	let mid_end = g.n - 1;
	var k = mid_end - 1;
	while k >= mid_start {
		g.res[k] = ${f}(g.res[k]);
		k--;
	}
	g.steps += mid_end - mid_start;
	out.i = mid_end - mid_start;
	out.s.clear();
	format(out.s, "retried middle in reverse");
	out
}
@end
