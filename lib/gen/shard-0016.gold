	let limit = ${max_sum};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s <= limit {
			g.res[pairs] = s;
			pairs++;
			i += 2;
		} else {
