noun: primes
modifier: sorted
context: transform
phrase: collect primes sorted during transform processing pass
phrase: execute collect primes sorted over transform results
test: list=9,7,5,4,3,2
expect: => i=4 r=0.0 ok=true s="collected primes sorted: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=15,13,11,10
expect: => i=2 r=0.0 ok=true s="collected primes sorted: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[64];
	var num_p = 0;
	for i in g.n {
		let n = g.res[i];
		if n >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= n {
				if n % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && num_p < 64 {
				primes[num_p] = n;
				num_p++;
			}
		}
	}
	var i = 0;
	while i < num_p {
		var j = 0;
		while j + 1 < num_p - i {
			if primes[j] > primes[j + 1] {
				let tmp = primes[j];
				primes[j] = primes[j + 1];
				primes[j + 1] = tmp;
			}
		j++;
		}
		i++;
	}
	gold_clear(g);
	for k in num_p { gold_push(g, primes[k]); }
	g.steps += num_p * num_p;
	out.i = num_p;
	out.s.clear();
	format(out.s, "collected primes sorted: ", num_p);
	out
}
@end
