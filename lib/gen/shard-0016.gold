test: list=15,20,25 fallback=1
expect: => i=15 r=0.0 ok=true s="head safe: 15" errors=0 n=3 res=[15,20,25] cache=0 hits=0
test: list=-5,30 fallback=10
expect: => i=30 r=0.0 ok=true s="head safe: 30" errors=0 n=2 res=[-5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fallback = ${fallback};
	if g.n == 0 {
		out.i = fallback;
		return out;
	}
	var val = g.res[0];
	if val <= 0 {
		if g.n > 1 && g.res[1] > 0 {
			val = g.res[1];
		} else {
			val = fallback;
		}
	}
	g.steps++;
	out.i = val;
	out.s.clear();
	format(out.s, "head safe: ", val);
	out
}
@end
