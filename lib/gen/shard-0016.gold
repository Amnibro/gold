fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var span = k;
	if span > g.n { span = g.n; }
	var sum = 0;
	for i in (g.n - span)..g.n {
		sum += g.res[i];
	}
	g.steps += span;
	out.i = sum;
	out.s.clear();
	format(out.s, "tail elements sum: ", sum);
	out
}
@end
