@entry a01317d19dab3a72
kind: step
verb: rotate
noun: number
modifier: nested
context: retry
slot: group int
phrase: rotate number entries in nested groups of {group}
phrase: nested rotation of numbers sized {group}
test: list=1,2,3,4,5,6 group=3
expect: => i=2 r=0.0 ok=true s="nested groups rotated: 2" errors=0 n=6 res=[2,3,1,5,6,4] cache=0 hits=0
test: list=10,20,30,40 group=2
expect: => i=2 r=0.0 ok=true s="nested groups rotated: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let grp = ${group};
	var rotated = 0;
	if grp > 1 {
		var offset = 0;
		while offset + grp <= g.n {
			let first_v = g.res[offset];
			for i in grp - 1 {
				g.res[offset + i] = g.res[offset + i + 1];
			}
			g.res[offset + grp - 1] = first_v;
			offset += grp;
			rotated++;
		}
	}
	out.i = rotated;
	out.ok = true;
	out.s.clear();
	format(out.s, "nested groups rotated: ", rotated);
	g.steps += rotated;
	out
}
@end
