@entry 9563b1c868a91037
kind: step
verb: apply
noun: primes
modifier: each
context: error
phrase: apply prime check to each error entry below {max_prime}
phrase: verify prime status for each fault element under {max_prime}
slot: max_prime int
test: list=2,3,5,7 max_prime=10
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=2,4,7 max_prime=10
expect: => i=2 r=0.0 ok=true s="" errors=1 n=3 res=[2,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_prime};
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if !is_p || x >= limit {
			gold_fail(g, "non-prime or excessive prime encountered");
		} else {
			primes_count++;
		}
	}
	g.steps += g.n;
	out.i = primes_count;
	out
}
@end
@entry 63e1de2e3655ea09
kind: step
