fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var dropped = 0;
	var new_n = 0;
	for i in g.n {
		if g.res[i] < 0 && dropped < limit {
			dropped++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped error codes up to limit");
	out
}
@end
