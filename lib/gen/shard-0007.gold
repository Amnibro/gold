	for i in g.n {
		if g.res[i] >= mv {
			out.ok = true;
			out.i = i;
			break;
		}
	}
	gold_push(g, out.i);
	out.s.clear();
	format(out.s, "first exceeding: ", out.i);
	out
}
@end
