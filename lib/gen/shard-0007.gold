fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${window};
	var score = 0;
	for k in out.s.len {
		score += out.s[k] as int;
		if k >= win {
			score -= out.s[k - win] as int;
		}
		gold_cache_put(g, k, score);
	}
	g.steps++;
	out.i = score;
	out
}
@end
