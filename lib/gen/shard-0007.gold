noun: duplicates
modifier: in_place
context: list
phrase: return duplicates in_place
phrase: extract duplicates in_place
test: list=1,2,2,3,4,4,4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig = g.n;
	var w = 0;
	for i in orig {
		let x = g.res[i];
		var freq = 0;
		for j in orig {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	out.i = w;
	out
}
@end
@entry 57f981f071d4db4b
kind: step
verb: rotate
noun: list
modifier: up_to
context: list
phrase: rotate list up_to {count}
phrase: cycle list up_to {count}
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,1,4,5] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c > 1 && g.n >= c {
		let first = g.res[0];
		for k in (c - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[c - 1] = first;
		out.i = g.res[0];
	}
	out
}
@end
@entry 5c2d67ab9bc88f06
kind: step
verb: join
noun: tally
modifier: pairwise
context: list
phrase: join tally pairwise
phrase: combine tally pairwise
test: list=2,3,4,5
expect: => i=6 r=0.0 ok=true s="len 2" errors=0 n=2 res=[6,20] cache=0 hits=0
test: list=10,20,30,40
expect: => i=200 r=0.0 ok=true s="len 2" errors=0 n=2 res=[200,1200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let pairs = g.n / 2;
		for k in pairs {
			g.res[k] = g.res[2 * k] * g.res[2 * k + 1];
		}
		g.n = pairs;
		out.i = g.res[0];
	}
	out.s.clear();
	format(out.s, "len ", g.n);
	out
}
@end
@entry df1a2e3bbbb77d1c
kind: step
verb: sort
noun: item
modifier: until
context: list
phrase: sort item until {p}
phrase: order item until {p}
slot: p pred
test: list=9,3,7,2,1 p=is_even
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[3,7,9,2,1] cache=0 hits=0
test: list=8,4,6,5,10 p=is_odd
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[4,6,8,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prefix_len = 0;
	while prefix_len < g.n && !${p}(g.res[prefix_len]) {
		prefix_len++;
	}
	if prefix_len > 1 {
		for i in prefix_len {
			for j in (prefix_len - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = prefix_len;
	out
}
@end
@entry 93953c2fd3f8df19
kind: step
verb: join
noun: threshold
modifier: running
context: list
phrase: join threshold running {bound}
phrase: merge threshold running {bound}
slot: bound int
test: list=2,3,4,8,10 bound=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[9,8,10] cache=0 hits=0
test: list=1,1,1,1,5 bound=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var w = 0;
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
		if sum >= b {
			g.res[w] = sum;
			w++;
			sum = 0;
		}
	}
	if sum > 0 {
		g.res[w] = sum;
		w++;
	}
	g.n = w;
	out.i = w;
	out
}
@end
