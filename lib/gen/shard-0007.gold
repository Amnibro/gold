fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	if g.n > 0 {
		var min_v = g.res[0];
		for k in g.n {
			if g.res[k] < min_v {
				min_v = g.res[k];
			}
		}
		for k in g.n {
			var adjusted = g.res[k] - min_v;
			if adjusted > limit {
				adjusted = limit;
			}
			g.res[k] = adjusted;
		}
		out.i = min_v;
	}
	out.s.clear();
	format(out.s, "base ", out.i);
	out
}
@end
