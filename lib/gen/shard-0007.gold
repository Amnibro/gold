test: list=2,4,5,6,8,9 p=is_odd
expect: => i=2 r=0.0 ok=true s="grouped steps 2" errors=0 n=2 res=[11,23] cache=0 hits=0
test: list=10,20,30 p=over_100
expect: => i=1 r=0.0 ok=true s="grouped steps 1" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	var cur_sum = 0;
	var groups = 0;
	for i in g.n {
		let x = g.res[i];
		cur_sum += x;
		if ${p}(x) {
			g.res[k] = cur_sum;
			k++;
			cur_sum = 0;
			groups++;
		}
	}
	if cur_sum > 0 {
		g.res[k] = cur_sum;
		k++;
		groups++;
	}
	g.n = k;
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped steps ", groups);
	out
}
@end
