code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var d = 0;
		if x == 0 { d = 1; }
		else {
			while x > 0 { d++; x /= 10; }
		}
		if d <= lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept digits at most ", lim);
	g.steps += g.n;
	out
}
@end
