fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${val};
	var matches = 0;
	var others = 0;
	var tmp = [0; 512];
	for i in g.n {
		if g.res[i] == tgt { matches++; }
		else { others++; }
	}
	for i in matches { tmp[i] = tgt; }
	var k = matches;
	for i in g.n {
		if g.res[i] != tgt {
			tmp[k] = g.res[i];
			k++;
		}
	}
	for i in g.n { g.res[i] = tmp[i]; }
	out.i = matches;
	g.steps += g.n;
	out
}
@end
