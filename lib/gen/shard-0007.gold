fn ${ID}_rec(g Gold&, d int) int {
	if d <= 0 || g.n == 0 { return 0; }
	g.res[g.n - 1] += 1;
	g.steps++;
	return 1 + ${ID}_rec(g, d - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	if max_d <= 0 || max_d > g.n {
		gold_fail(g, "invalid recursion depth for error suffix");
		out.ok = false;
		return out;
	}
	let calls = ${ID}_rec(g, max_d);
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "ran recursive suffix calls ", calls);
	out
}
@end
@entry 05409fc7354533c3
kind: step
verb: rank
noun: letters
modifier: none
context: text
phrase: rank letters none
phrase: evaluate letters none
test: text="banana"
expect: => i=3 r=0.0 ok=true s="anb" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: text="zyxwv"
expect: => i=5 r=0.0 ok=true s="vwxyz" errors=0 n=5 res=[1,1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unq byte[..200] = "";
	var freqs int[..200] = [];
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in unq.len {
			if unq[j] == b { seen = true; break; }
		}
		if !seen {
			unq.push(b);
			var cnt = 0;
			for j in out.s.len {
				if out.s[j] == b { cnt++; }
			}
			freqs.push(cnt);
		}
	}
	if unq.len > 1 {
		for i in 1..unq.len {
			var j = i;
			while j > 0 && (freqs[j - 1] < freqs[j] || (freqs[j - 1] == freqs[j] && unq[j - 1] > unq[j])) {
				let tf = freqs[j]; freqs[j] = freqs[j - 1]; freqs[j - 1] = tf;
				let tc = unq[j]; unq[j] = unq[j - 1]; unq[j - 1] = tc;
				j--;
			}
		}
	}
	out.s.clear();
	out.s.append(unq);
	for cnt in freqs { gold_push(g, cnt); }
	out.i = unq.len;
	out
}
@end
