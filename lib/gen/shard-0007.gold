test: list=7,7,7
expect: => i=1 r=0.0 ok=true s="histogram has 1 distinct bins" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_count = 0;
	var vals int[512] = [0; 512];
	var counts int[512] = [0; 512];
	for k in g.n {
		let x = g.res[k];
		var found = false;
		for i in distinct_count {
			if vals[i] == x {
				counts[i]++;
				found = true;
				break;
			}
		}
		if !found {
			vals[distinct_count] = x;
			counts[distinct_count] = 1;
			distinct_count++;
		}
	}
	for k in distinct_count {
		g.res[k] = counts[k];
	}
	g.n = distinct_count;
	out.i = distinct_count;
	out.s.clear();
	format(out.s, "histogram has ", distinct_count, " distinct bins");
	g.steps += g.n;
	out
}
@end
