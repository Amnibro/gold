@entry 1ae5b415730af184
kind: step
verb: scale
noun: squares
modifier: with_cache
context: sort
phrase: scale squares with cache memoizing intermediate values
phrase: compute squares with cache on sorted elements
test: list=2,3,4,2,3
expect: => i=5 r=0.0 ok=true s="cached squared elements: 5" errors=0 n=5 res=[4,9,16,4,9] cache=3 hits=2
test: list=5,6,7
expect: => i=3 r=0.0 ok=true s="cached squared elements: 3" errors=0 n=3 res=[25,36,49] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let memo_base = 800000;
	for k in g.n {
		let x = g.res[k];
		let cv, hit = gold_cache_get(g, memo_base + x);
		if hit {
			g.res[k] = cv;
		} else {
			let sq = x * x;
			gold_cache_put(g, memo_base + x, sq);
			g.res[k] = sq;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached squared elements: ", g.n);
	out
}
@end
