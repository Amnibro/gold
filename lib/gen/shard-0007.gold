@entry 59970f2c8912f111
kind: step
verb: shift
noun: step
modifier: sorted
context: core
phrase: shift sorted step differences forward
phrase: calculate sorted adjacent step differences
test: list=10,2,7
expect: => i=2 r=0.0 ok=true s="computed 2 sorted step differences" errors=0 n=2 res=[5,8] cache=0 hits=0
test: list=1,5,2
expect: => i=2 r=0.0 ok=true s="computed 2 sorted step differences" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("computed 0 sorted step differences");
		return out;
	}
	var diffs int[512] = [0; 512];
	let nd = g.n - 1;
	for k in nd {
		let d = g.res[k + 1] - g.res[k];
		diffs[k] = if d < 0 { -d } else { d };
	}
	for i in nd {
		for j in i + 1..nd {
			if diffs[j] < diffs[i] {
				let tmp = diffs[i];
				diffs[i] = diffs[j];
				diffs[j] = tmp;
			}
		}
	}
	for k in nd { g.res[k] = diffs[k]; }
	g.n = nd;
	out.i = nd;
	out.s.clear();
	format(out.s, "computed ", nd, " sorted step differences");
	g.steps += nd;
	out
}
@end
