fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for k in g.n {
		let x = g.res[k];
		let val, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, 1);
			unique_count++;
		}
	}
	out.i = unique_count;
	out.s.clear();
	format(out.s, "cached ", unique_count, " unique numbers");
	g.steps += g.n;
	out
}
@end
