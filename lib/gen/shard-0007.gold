code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var mn = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			if !found || x < mn {
				mn = x;
				found = true;
			}
		}
	}
	if found {
		out.i = mn;
		out.ok = true;
	} else {
		gold_fail(g, "no value in range");
		out.i = 0;
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
