phrase: increment alternating numbers in loop by {shift_amount}
slot: shift_amount int
test: list=10,20,30,40,50 shift_amount=5
expect: => i=3 r=0.0 ok=true s="shifted every other number in loop" errors=0 n=5 res=[15,20,35,40,55] cache=0 hits=0
test: list=10,20 shift_amount=0
expect: => i=0 r=0.0 ok=false s="error: invalid shift parameters" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let amt = ${shift_amount};
	if g.n == 0 || amt == 0 {
		gold_fail(g, "empty list or zero shift amount");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid shift parameters");
		return out;
	}
	var shifted = 0;
	var k = 0;
	while k < g.n {
		g.res[k] += amt;
		shifted++;
		k += 2;
	}
	out.i = shifted;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted every other number in loop");
	g.steps += shifted;
	out
}
@end
@entry dddf8c47a3551250
kind: step
verb: find
noun: primes
modifier: until
context: loop
phrase: find primes in loop until reaching limit {limit}
phrase: search prime numbers until ceiling of {limit}
phrase: locate primes through loop up until {limit}
slot: limit int
test: list=1,2 limit=10
expect: => i=4 r=0.0 ok=true s="found primes until reaching limit" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=1,2 limit=1
expect: => i=0 r=0.0 ok=false s="error: prime limit below two" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 2 {
		gold_fail(g, "prime limit must be at least two");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: prime limit below two");
		return out;
	}
	g.n = 0;
	var count = 0;
	for num in 2..(lim + 1) {
		var is_p = true;
		var d = 2;
		while d * d <= num {
			if num % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			gold_push(g, num);
			count++;
		}
	}
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "found primes until reaching limit");
	g.steps += count;
	out
}
@end
