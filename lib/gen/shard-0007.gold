fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sl = ${suffix_len};
	var len = sl;
	if len > g.n { len = g.n; }
	if len <= 0 { return out; }
	let start = g.n - len;
	var total = 0;
	for i in len { total += g.res[start + i]; }
	g.steps += len;
	out.i = total;
	out.s.clear();
	format(out.s, "suffix sum ", total);
	out
}
@end
