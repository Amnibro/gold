test: list=3,8,2,5
expect: => i=8 r=0.0 ok=true s="peak retry swapped: 8" errors=0 n=4 res=[8,3,2,5] cache=0 hits=0
test: list=10
expect: => i=10 r=0.0 ok=true s="" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = if g.n > 0 { g.res[0] } else { 0 };
		g.steps += 1;
		return out;
	}
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
	}
	let tmp = g.res[0];
	g.res[0] = g.res[max_idx];
	g.res[max_idx] = tmp;
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "peak retry swapped: ", g.res[0]);
	out
}
@end
