code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let pairs = g.n / 2;
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		g.res[i] = if a > b { a } else { b };
	}
	g.n = pairs;
	out.i = g.res[0];
	g.steps += pairs;
	out
}
@end
