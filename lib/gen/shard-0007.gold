code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var min_diff = if g.res[1] > g.res[0] { g.res[1] - g.res[0] } else { g.res[0] - g.res[1] };
	for i in 1..(g.n - 1) {
		let diff = if g.res[i+1] > g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
		if diff < min_diff { min_diff = diff; }
	}
	g.steps += g.n;
	out.i = min_diff;
	out.s.clear();
	format(out.s, "minimum pairwise diff ", min_diff);
	out
}
@end
