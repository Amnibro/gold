test: list=10,15,16,25 gap=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,15,16,25] cache=2 hits=0
test: list=1,2,8,9 gap=5
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,8,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gp = ${gap};
	var count = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff > gp {
				gold_cache_put(g, k, diff);
				count++;
			}
		}
	}
	g.steps++;
	out.i = count;
	out
}
@end
