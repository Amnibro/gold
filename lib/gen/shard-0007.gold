code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var ok = true;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > tol {
			ok = false;
			break;
		}
		i++;
	}
	out.ok = ok;
	if !ok {
		gold_fail(g, "pairwise step exceeded tolerance");
	}
	out.i = if ok { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
