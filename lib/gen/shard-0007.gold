fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var scaled_count = 0;
	for i in g.n {
		var is_unique = true;
		for j in 0..i {
			if g.res[j] == g.res[i] {
				is_unique = false;
				break;
			}
		}
		if is_unique {
			g.res[i] *= 2;
			scaled_count++;
		}
	}
	g.steps += g.n;
	out.i = scaled_count;
	out.s.clear();
	format(out.s, "scaled unique retries: ", scaled_count);
	out
}
@end
