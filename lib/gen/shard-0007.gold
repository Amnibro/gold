expect: => i=2 r=0.0 ok=true s="dropped 2 unsorted step items" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		out.s.append("dropped 0 unsorted step items");
		return out;
	}
	var kept int[512] = [0; 512];
	kept[0] = g.res[0];
	var nk = 1;
	var dropped = 0;
	for k in 1..g.n {
		if g.res[k] >= kept[nk - 1] {
			kept[nk] = g.res[k];
			nk++;
		} else {
			dropped++;
		}
	}
	for k in nk { g.res[k] = kept[k]; }
	g.n = nk;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " unsorted step items");
	g.steps += g.n;
	out
}
@end
