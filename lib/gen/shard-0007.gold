			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var total = 0;
	var kept = 0;
	while kept < g.n && total + g.res[kept] <= b {
		total += g.res[kept];
		kept++;
	}
	g.n = kept;
	out.i = total;
	out.ok = kept > 0;
	out.s.clear();
	format(out.s, "budget items kept: ", kept);
	g.steps += g.n * g.n;
	out
}
