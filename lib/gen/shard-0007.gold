test: list=10,20,30 total=35
expect: => i=60 r=0.0 ok=true s="" errors=0 n=3 res=[5,11,17] cache=0 hits=0
test: list=5,10 total=35
expect: => i=15 r=0.0 ok=true s="" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tot = ${total};
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	if sum > tot && sum > 0 {
		for k in g.n {
			g.res[k] = (g.res[k] * tot) / sum;
		}
	}
	g.steps++;
	out.i = sum;
	out
}
@end
