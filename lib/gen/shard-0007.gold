fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " steps");
	g.steps += g.n;
	out
}
