@entry d4d15aea48abfe3d
kind: step
verb: validate
noun: step
modifier: in_reverse
context: format
phrase: validate step difference in reverse matching expected {step_val}
phrase: check reverse step difference matches target {step_val}
slot: step_val int
test: list=2,4,6,8 step_val=2
expect: => i=1 r=0.0 ok=true s="reverse step check: pass" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,7,10 step_val=2
expect: => i=0 r=0.0 ok=false s="reverse step check: fail" errors=1 n=4 res=[1,3,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${step_val};
	var valid = true;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i] - g.res[i - 1] != sv {
			valid = false;
			break;
		}
		i--;
	}
	out.ok = valid;
	if !valid {
		gold_fail(g, "reverse step mismatch");
	}
	out.s.clear();
	format(out.s, "reverse step check: ", if valid { "pass" } else { "fail" });
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out
