@entry 36865292d04ad64b
kind: step
verb: join
noun: range
modifier: in_place
context: math
phrase: join range in_place from {start} to {finish}
phrase: unite range in_place bounds {start} limit {finish}
slot: start int
slot: finish int
test: list=1,2,3,4,5 start=1 finish=3
expect: => i=9 r=0.0 ok=true s="" errors=0 n=3 res=[1,9,5] cache=0 hits=0
test: list=10,20,30 start=0 finish=2
expect: => i=60 r=0.0 ok=true s="" errors=0 n=1 res=[60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let f = ${finish};
	if s >= 0 && f < g.n && s < f {
		var sum = 0;
		for k in (f - s + 1) {
			sum += g.res[s + k];
		}
		g.res[s] = sum;
		let shift = f - s;
		for k in (g.n - 1 - f) {
			g.res[s + 1 + k] = g.res[f + 1 + k];
		}
		g.n -= shift;
		out.i = sum;
	}
	out
}
@end
