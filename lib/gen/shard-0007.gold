fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted_dups = 0;
	for i in g.n {
		let x = g.res[i];
		for j in i {
			if g.res[j] == x {
				g.res[i] += 1;
				shifted_dups++;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = shifted_dups;
	out.s.clear();
	format(out.s, "shifted dups ", shifted_dups);
	out
}
@end
