code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var new_n = g.n - 1;
	for i in new_n {
		g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filled pairwise text averages");
	out
}
@end
