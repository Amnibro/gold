@entry e6667f8e4fe27c62
kind: step
verb: clamp
noun: average
modifier: with_retry
context: stats
phrase: clamp average with_retry {max_avg}
phrase: bound average with_retry {max_avg}
slot: max_avg int
test: list=20,40,60 max_avg=30
expect: => i=26 r=0.0 ok=true s="average: 26" errors=0 n=3 res=[20,30,30] cache=0 hits=0
test: list=10,20,30 max_avg=25
expect: => i=20 r=0.0 ok=true s="average: 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_avg};
	if g.n > 0 {
		var sum = 0;
		for i in g.n { sum += g.res[i]; }
		var avg = sum / g.n;
		var tries = 0;
		while avg > ma && tries < 10 {
			for i in g.n {
				if g.res[i] > ma { g.res[i] = ma; }
			}
		sum = 0;
		for i in g.n { sum += g.res[i]; }
		avg = sum / g.n;
		tries++;
		}
		if avg > ma {
			gold_fail(g, "clamp average with_retry: average still exceeds limit");
		}
		out.i = avg;
		out.s.clear();
		format(out.s, "average: ", avg);
	}
	out
}
@end
@entry 3edcdbb4d2890ce5
kind: step
