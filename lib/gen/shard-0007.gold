@entry 881872db82a8142b
kind: step
verb: rotate
noun: results
modifier: nested
context: retry
phrase: rotate results nested inside inner slice bounds {cut}
phrase: cycle interior retry results preserving {cut} margins
slot: cut int
test: list=1,10,20,30,2 cut=1
expect: => i=3 r=0.0 ok=true s="rotated nested interior results length: 3" errors=0 n=5 res=[1,20,30,10,2] cache=0 hits=0
test: list=9,2,3,4,8 cut=1
expect: => i=3 r=0.0 ok=true s="rotated nested interior results length: 3" errors=0 n=5 res=[9,3,4,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cut};
	if c < 0 || c * 2 >= g.n { return out; }
	let end = g.n - c;
	let len = end - c;
	if len <= 1 { return out; }
	let first = g.res[c];
	for i in (len - 1) {
		g.res[c + i] = g.res[c + i + 1];
	}
	g.res[end - 1] = first;
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "rotated nested interior results length: ", len);
	out
}
@end
