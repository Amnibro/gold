@entry 5211aa58332e5775
kind: step
verb: search
noun: suffix
modifier: in_place
context: format
phrase: search suffix in place matching pattern {suffix}
phrase: inspect text ending for exact suffix {suffix}
slot: suffix text
test: text="format data" suffix="data"
expect: => i=1 r=0.0 ok=true s="suffix in place: found" errors=0 n=0 res=[] cache=0 hits=0
test: text="format code" suffix="data"
expect: => i=0 r=0.0 ok=false s="suffix in place: missing" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sfx = ${suffix};
	var matches = false;
	if out.s.len >= sfx.len {
		matches = true;
		let offset = out.s.len - sfx.len;
		for k in sfx.len {
			if out.s[offset + k] != sfx[k] {
				matches = false;
				break;
			}
		}
	}
	out.ok = matches;
	out.s.clear();
	format(out.s, "suffix in place: ", if matches { "found" } else { "missing" });
	out.i = if matches { 1 } else { 0 };
	g.steps += out.s.len;
	out
}
@end
@entry 1c9f3df6a53d1032
kind: step
verb: repeat
noun: gaps
modifier: times
context: format
phrase: repeat difference gaps scaled by factor {factor} times
phrase: format consecutive gaps scaled by multiplier {factor}
slot: factor int
test: list=1,3,7,12 factor=2
expect: => i=22 r=0.0 ok=true s="scaled gap total: 22" errors=0 n=4 res=[1,3,7,12] cache=0 hits=0
test: list=10,15,25 factor=3
expect: => i=45 r=0.0 ok=true s="scaled gap total: 45" errors=0 n=3 res=[10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var gap_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		var d = g.res[i + 1] - g.res[i];
		if d < 0 { d = -d; }
		gap_sum += d;
		i++;
	}
	let total = gap_sum * f;
	out.s.clear();
	format(out.s, "scaled gap total: ", total);
	out.i = total;
	g.steps += g.n;
	out
}
@end
