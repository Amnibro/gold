phrase: inspect prime failure signatures between limits
test: list=4,7,9,11,15,17
expect: => i=3 r=0.0 ok=true s="scanned prime errors: 3" errors=0 n=6 res=[4,7,9,11,15,17] cache=0 hits=0
test: list=4,6,8,10
expect: => i=0 r=0.0 ok=false s="scanned prime errors: 0" errors=1 n=4 res=[4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				prime_count++;
			}
		}
	}
	if prime_count == 0 {
		gold_fail(g, "zero prime errors found");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "scanned prime errors: ", prime_count);
	out
}
@end
