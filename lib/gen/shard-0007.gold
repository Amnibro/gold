test: text="hello world" suffix="world"
expect: => i=1 r=0.0 ok=true s="suffix match: 1" errors=0 n=0 res=[] cache=0 hits=0
test: text="helium code" suffix="data"
expect: => i=0 r=0.0 ok=false s="suffix match: 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sfx = ${suffix};
	var found = false;
	if out.s.len >= sfx.len {
		found = true;
		let offset = out.s.len - sfx.len;
		for k in sfx.len {
			if out.s[offset + k] != sfx[k] {
				found = false;
				break;
			}
		}
	}
	out.ok = found;
	let matched = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "suffix match: ", matched);
	out.i = matched;
	g.steps += out.s.len;
	out
}
@end
