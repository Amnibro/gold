code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 1 || g.n < w { out.i = 0; return out; }
	var sorted_windows = 0;
	var i = 0;
	while i + w <= g.n {
		var ok_win = true;
		for j in 1..w {
			if g.res[i + j] < g.res[i + j - 1] { ok_win = false; }
		}
		if ok_win { sorted_windows++; }
		i++;
	}
	out.i = sorted_windows;
	g.steps += g.n * w;
	out.s.clear();
	format(out.s, "sorted windows: ", sorted_windows);
	out
}
@end
