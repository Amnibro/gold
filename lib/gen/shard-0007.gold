fn ${ID}_fill(g Gold&, d int, min_val int) int {
	if d <= 0 { return 0; }
	gold_push(g, min_val);
	g.steps++;
	return 1 + ${ID}_fill(g, d - 1, min_val);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 || d <= 0 {
		gold_fail(g, "cannot fill minimum on empty errors");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	let filled = ${ID}_fill(g, d, min_val);
	out.i = min_val;
	out.s.clear();
	format(out.s, "recursively filled minimum ", min_val);
	out
}
@end
