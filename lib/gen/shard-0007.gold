kind: step
verb: rotate
noun: digits
modifier: nested
context: math
phrase: rotate digits nested {shifts}
phrase: cycle digits nested {shifts}
slot: shifts int
test: input=1234 shifts=1
expect: => i=2341 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
test: input=789 shifts=2
expect: => i=978 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shifts};
	var num = out.i;
	if num > 0 {
		var temp = [0; 32];
		var len = 0;
		while num > 0 {
			temp[len] = num % 10;
			num = num / 10;
			len++;
		}
		var digits = [0; 32];
		for k in len {
			digits[k] = temp[len - 1 - k];
		}
		var res_num = 0;
		for k in len {
			let src = (k + s) % len;
			res_num = res_num * 10 + digits[src];
		}
		out.i = res_num;
	}
	out
}
@end
