@entry f73789db14deeda3
kind: step
verb: filter
noun: pairs
modifier: any
context: loop
phrase: filter pairs where either item matches predicate {p}
phrase: keep adjacent pairs with any match to {p}
slot: p pred
test: list=1,2,3,5,4,6 p=is_even
expect: => i=2 r=0.0 ok=true s="filtered pairs with any match" errors=0 n=4 res=[1,2,4,6] cache=0 hits=0
test: list=2,4,3,6,8,10 p=is_odd
expect: => i=1 r=0.0 ok=true s="filtered pairs with any match" errors=0 n=2 res=[3,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var len = 0;
	var i = 0;
	while i + 1 < g.n {
		if ${p}(g.res[i]) || ${p}(g.res[i + 1]) {
			temp[len] = g.res[i];
			temp[len + 1] = g.res[i + 1];
			len += 2;
		}
		i += 2;
	}
	for k in len { g.res[k] = temp[k]; }
	g.n = len;
	g.steps += g.n;
	out.i = len / 2;
	out.s.clear();
	format(out.s, "filtered pairs with any match");
	out
}
@end
