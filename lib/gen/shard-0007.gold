expect: => i=3 r=0.0 ok=true s="returned at most primes count: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_primes = ${k};
	var kept = 0;
	var i = 0;
	while i < g.n {
		if core_is_prime(g.res[i]) && kept < max_primes {
			kept++;
			i++;
		} else {
			for j in (g.n - 1 - i) {
				g.res[i + j] = g.res[i + 1 + j];
			}
			g.n--;
		}
	}
	g.steps += g.n + kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned at most primes count: ", kept);
	out
}
@end
