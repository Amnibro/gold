@entry edf15fa0d9642497
kind: step
verb: rotate
noun: text
modifier: running
context: retry
phrase: rotate text running shift count {shift}
phrase: cycle retry status text characters by offset {shift}
slot: shift int
test: text="abcdef" shift=2
expect: => i=2 r=0.0 ok=true s="cdefab" errors=0 n=0 res=[] cache=0 hits=0
test: text="retry" shift=1
expect: => i=1 r=0.0 ok=true s="etryr" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_len = v.s.len;
	let offset = ${shift};
	if s_len <= 1 || offset <= 0 { return out; }
	let rot = offset % s_len;
	if rot == 0 { return out; }
	var tmp byte[..200] = [];
	for i in s_len {
		tmp.push(v.s[(i + rot) % s_len]);
	}
	out.s.clear();
	for i in tmp.len {
		out.s.push(tmp[i]);
	}
	g.steps += s_len;
	out.i = rot;
	out
}
@end
