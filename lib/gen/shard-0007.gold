	if hit {
		total += prev;
	} else {
		gold_cache_put(g, 101, total);
	}
	if total > 500 {
		gold_fail(g, "fault counter threshold reached");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed counter with cache ", total);
	out
}
