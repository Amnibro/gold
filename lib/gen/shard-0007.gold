@entry 5ad631f9425049cf
kind: step
verb: sort
noun: histogram
modifier: between
context: aggregate
phrase: sort histogram counts between range {low} through {high}
phrase: order histogram values between bounds {low} to {high}
slot: low int
slot: high int
test: list=1,1,2,2,2,3,5 low=1 high=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,30,30,40 low=10 high=30
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var counts int[>..] = [];
	var val = lo;
	while val <= hi {
		var c = 0;
		for k in g.n {
			if g.res[k] == val {
				c++;
			}
		}
		if c > 0 {
			counts.push(c);
		}
		val++;
	}
	var i = 0;
	while i < counts.len {
		var j = 0;
		while j + 1 < counts.len - i {
			if counts[j] > counts[j + 1] {
				let t = counts[j];
				counts[j] = counts[j + 1];
				counts[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for c in counts {
		gold_push(g, c);
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
