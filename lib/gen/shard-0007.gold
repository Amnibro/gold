fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch <= 0 {
		g.steps++;
		return out;
	}
	let parts = (g.n + ch - 1) / ch;
	out.i = parts;
	g.steps += parts + 1;
	out
}
@end
