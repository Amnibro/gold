context: format
phrase: trace duplicate elements scanning backwards in reverse
phrase: format log of duplicate occurrences in reverse order
test: list=1,2,3,2,1
expect: => i=2 r=0.0 ok=true s="reverse duplicates count: 2" errors=0 n=5 res=[1,2,3,2,1] cache=0 hits=0
test: list=5,6,7,8
expect: => i=0 r=0.0 ok=true s="reverse duplicates count: 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if seen { dup_count++; }
		i--;
	}
	out.s.clear();
	format(out.s, "reverse duplicates count: ", dup_count);
	out.i = dup_count;
	g.steps += g.n * g.n;
	out
}
@end
