code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	for i in g.n {
		if g.res[i] < 0 {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 0;
		}
	}
	if max_streak < 2 {
		gold_fail(g, "error streak below lower bound");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "error streak length: ", max_streak);
	out
}
@end
