@entry 6cf09bdb1cfc058d
kind: step
verb: dedupe
noun: budget
modifier: running
context: math
phrase: dedupe budget running {cap}
phrase: filter budget running {cap}
slot: cap int
test: list=2,2,5,3,10 cap=10
expect: => i=10 r=0.0 ok=true s="" errors=0 n=3 res=[2,5,3] cache=0 hits=0
test: list=1,3,1,4,8 cap=5
expect: => i=4 r=0.0 ok=true s="" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var w = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen && sum + x <= limit {
			g.res[w] = x;
			sum += x;
			w++;
		}
	}
	g.n = w;
	out.i = sum;
	out
}
@end
