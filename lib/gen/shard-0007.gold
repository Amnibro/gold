@entry dda3bd2e291bc9ca
kind: step
verb: drop
noun: pairs
modifier: every_other
context: error
phrase: drop error pairs every other occurrence
phrase: prune alternating error pairs from results
test: list=1,2,3,4,5,6,7,8
expect: => i=4 r=0.0 ok=true s="dropped error pairs count 4" errors=0 n=4 res=[1,2,5,6] cache=0 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="dropped error pairs count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 {
		gold_fail(g, "insufficient error pairs to drop");
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	var keep_pair = true;
	while i + 1 < g.n {
		if keep_pair {
			g.res[new_n] = g.res[i];
			g.res[new_n + 1] = g.res[i + 1];
			new_n += 2;
			keep_pair = false;
		} else {
			keep_pair = true;
		}
		i += 2;
	}
	while i < g.n {
		g.res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	let dropped = g.n - new_n;
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped error pairs count ", dropped);
	out
}
@end
