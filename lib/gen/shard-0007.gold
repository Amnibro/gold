expect: => i=2 r=0.0 ok=true s="window deduped: 2" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	if ws > 1 && g.n > 1 {
		var w = 0;
		var i = 0;
		while i < g.n {
			let win_end = if i + ws < g.n { i + ws } else { g.n };
			for j in i..win_end {
				if j == i || g.res[j] != g.res[j - 1] {
					g.res[w] = g.res[j];
					w++;
				}
			}
			i = win_end;
		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "window deduped: ", g.n);
	out
}
@end
