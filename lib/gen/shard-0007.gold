phrase: filter errors between {low} limits {high}
slot: low int
slot: high int
test: list=2,5,5,8,12,12 low=4 high=10
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[2,5,8,12,12] cache=0 hits=0
test: list=1,1,1 low=2 high=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out
}
@end
