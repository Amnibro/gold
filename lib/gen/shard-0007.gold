fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var err_count = 0;
	var matched = 0;
	for i in g.n {
		if g.res[i] != 0 {
			err_count++;
			if err_count <= lim {
				matched++;
			} else {
				gold_fail(g, "error count exceeded limit");
				out.ok = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "applied counter up to ", lim);
	out
}
@end
