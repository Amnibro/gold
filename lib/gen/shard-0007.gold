@entry f5cc7552b70e0a38
kind: step
verb: rank
noun: counter
modifier: up_to
context: loop
phrase: rank counter frequencies up to ceiling {limit}
phrase: order items by frequency up to threshold {limit}
slot: limit int
test: list=3,1,3,2,1,1 limit=2
expect: => i=6 r=0.0 ok=true s="ranked counter up to limit" errors=0 n=6 res=[2,1,3,3,1,1] cache=0 hits=0
test: list=5,8,8,5,8,9 limit=3
expect: => i=6 r=0.0 ok=true s="ranked counter up to limit" errors=0 n=6 res=[9,5,5,8,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		for j in i + 1..g.n {
			var ci = 0;
			var cj = 0;
			for k in g.n {
				if g.res[k] == g.res[i] { ci++; }
				if g.res[k] == g.res[j] { cj++; }
			}
			if ci > lim { ci = lim; }
			if cj > lim { cj = lim; }
			if ci > cj {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked counter up to limit");
	out
}
@end
@entry cefef2fdbdd981cb
kind: step
verb: fold
noun: range
modifier: times
context: loop
phrase: fold range spanning difference times {times}
phrase: accumulate spread of sequence times multiplier {times}
slot: times int
test: list=2,8,5,12 times=2
expect: => i=20 r=0.0 ok=true s="folded range times factor" errors=0 n=5 res=[2,8,5,12,20] cache=0 hits=0
test: list=10,30,15 times=3
expect: => i=60 r=0.0 ok=true s="folded range times factor" errors=0 n=4 res=[10,30,15,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let spread = (max_val - min_val) * t;
	gold_push(g, spread);
	g.steps += g.n;
	out.i = spread;
	out.s.clear();
	format(out.s, "folded range times factor");
	out
}
@end
