code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 1 {
		var max_freq = 0;
		for i in out.s.len {
			var freq = 0;
			for j in out.s.len {
				if out.s[j] == out.s[i] { freq++; }
			}
			if freq > max_freq { max_freq = freq; }
		}
		gold_cache_put(g, 0, max_freq);
		let shift = max_freq % out.s.len;
		for step in shift {
			let last = out.s[out.s.len - 1];
			for k in (out.s.len - 1) {
				let idx = out.s.len - 1 - k;
				out.s[idx] = out.s[idx - 1];
			}
			out.s[0] = last;
		}
		out.i = max_freq;
	}
	out
}
@end
