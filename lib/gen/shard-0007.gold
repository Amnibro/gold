code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		var seen = false;
		for j in w {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	var total = 0;
	for i in g.n { total += g.res[i]; }
	out.i = total;
	out
}
@end
