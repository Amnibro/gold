code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if out.s.len < 2 || s <= 1 { return out; }
	var end_pos = if s > out.s.len { out.s.len - 1 } else { s - 1 };
	var l = 0;
	var r = end_pos;
	while l < r {
		let t = out.s[l];
		out.s[l] = out.s[r];
		out.s[r] = t;
		l++;
		r--;
	}
	out.i = end_pos + 1;
	g.steps += end_pos + 1;
	out
}
@end
