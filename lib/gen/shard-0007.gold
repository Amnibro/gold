test: list=1,3,25,36,7
expect: => i=3 r=0.0 ok=true s="rotated squares running" errors=0 n=5 res=[36,3,1,25,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			idx[count] = i;
			count++;
		}
	}
	if count > 1 {
		let last_val = g.res[idx[count - 1]];
		var k = count - 1;
		while k > 0 {
			g.res[idx[k]] = g.res[idx[k - 1]];
			k--;
		}
		g.res[idx[0]] = last_val;
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated squares running");
	out
}
@end
