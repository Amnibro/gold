fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${size};
	let limit = ${cap};
	var clamped = 0;
	var take = s;
	if take > g.n { take = g.n; }
	for i in take {
		if g.res[i] > limit {
			g.res[i] = limit;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped);
	out
}
@end
