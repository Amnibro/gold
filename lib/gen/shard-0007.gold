expect: => i=2 r=0.0 ok=true s="repeated unique condition items: 2" errors=0 n=7 res=[3,4,4,5,6,4,6] cache=0 hits=0
test: list=7,2,2,8 p=is_even
expect: => i=2 r=0.0 ok=true s="repeated unique condition items: 2" errors=0 n=6 res=[7,2,2,8,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var appended = 0;
	let orig_n = g.n;
	for i in orig_n {
		if ${p}(g.res[i]) {
			var first = true;
			for j in i {
				if g.res[j] == g.res[i] {
					first = false;
					break;
				}
			}
			if first && g.n < 512 {
				gold_push(g, g.res[i]);
				appended++;
			}
		}
	}
	g.steps += orig_n + appended;
	out.i = appended;
	out.s.clear();
	format(out.s, "repeated unique condition items: ", appended);
	out
}
@end
