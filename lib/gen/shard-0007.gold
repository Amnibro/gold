code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${goal};
	var running = 0;
	var reached = false;
	var steps_taken = 0;
	for i in g.n {
		running += g.res[i];
		steps_taken++;
		if running >= target {
			reached = true;
			break;
		}
	}
	g.steps += steps_taken;
	out.ok = reached;
	out.i = running;
	out.s.clear();
	format(out.s, "target reached ", reached);
	out
}
@end
