code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			let _, hit = gold_cache_get(g, x);
			if !hit {
				gold_cache_put(g, x, 1);
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique evens cached: ", kept);
	out
}
@end
