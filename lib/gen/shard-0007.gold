fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let val = g.res[i];
		var exists = false;
		for j in uc {
			if unique[j] == val {
				exists = true;
				break;
			}
		}
		if !exists && uc < 64 {
			unique[uc] = val;
			uc++;
		}
	}
	gold_clear(g);
	for k in uc {
		gold_push(g, unique[k]);
	}
	out.i = uc;
	out.s.clear();
	format(out.s, "unique count ", uc);
	out
}
@end
