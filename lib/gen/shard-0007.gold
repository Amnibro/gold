fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty error log");
		out.ok = false;
		return out;
	}
	var u_codes int[64] = [0; 64];
	var u_counts int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let code = g.res[i];
		var found = false;
		for j in uc {
			if u_codes[j] == code {
				u_counts[j]++;
				found = true;
				break;
			}
		}
		if !found && uc < 64 {
			u_codes[uc] = code;
			u_counts[uc] = 1;
			uc++;
		}
	}
	for j in uc {
		gold_cache_put(g, u_codes[j], u_counts[j]);
	}
	g.steps += g.n;
	out.i = uc;
	out.s.clear();
	format(out.s, "cached unique error codes ", uc);
	out
}
