@entry ed3fd896aa6d7ff9
kind: step
verb: dedupe
noun: numbers
modifier: first
context: text
phrase: dedupe numbers first
phrase: filter numbers first occurrences
test: text="3 apples 3 pears 2 peaches 2 plums"
expect: => i=2 r=0.0 ok=true s="3 apples  pears 2 peaches  plums" errors=0 n=2 res=[3,2] cache=0 hits=0
test: text="10 cats 20 dogs 10 birds"
expect: => i=2 r=0.0 ok=true s="10 cats 20 dogs  birds" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[..200] = "";
	var seen_nums int[..200] = [];
	var i = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { res.push(' '); i++; }
		if i >= out.s.len { break; }
		let start = i;
		var all_digits = true;
		var val = 0;
		while i < out.s.len && out.s[i] != ' ' {
			let c = out.s[i];
			if c >= '0' && c <= '9' {
				val = val * 10 + ((c - '0') as int);
			} else {
				all_digits = false;
			}
			i++;
		}
		let wlen = i - start;
		if all_digits {
			var seen = false;
			for k in seen_nums.len {
				if seen_nums[k] == val { seen = true; break; }
			}
			if !seen {
				seen_nums.push(val);
				gold_push(g, val);
				for k in wlen { res.push(out.s[start + k]); }
			}
		} else {
			for k in wlen { res.push(out.s[start + k]); }
		}
	}
	out.s.clear();
	out.s.append(res);
	out.i = seen_nums.len;
	out
}
@end
