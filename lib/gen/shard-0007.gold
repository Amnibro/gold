test: list=1,2,5,3 k=3
expect: => i=3 r=0.0 ok=true s="prefix normalized 3" errors=0 n=4 res=[1,2,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} < g.n { ${k} } else { g.n };
	var sorted = true;
	if limit >= 2 {
		for i in limit - 1 {
			if g.res[i] > g.res[i + 1] { sorted = false; break; }
		}
	}
	if !sorted {
		for i in limit {
			for j in limit - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.ok = sorted;
	out.i = limit;
	out.s.clear();
	format(out.s, "prefix normalized ", limit);
	out
}
@end
