code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1 .. g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var norm_sum = 0;
	for i in g.n {
		norm_sum += (g.res[i] - min_val);
	}
	gold_push(g, norm_sum);
	g.steps += g.n * 2;
	out.i = norm_sum;
	out.s.clear();
	format(out.s, "normalized running history sum ", norm_sum);
	out
}
@end
