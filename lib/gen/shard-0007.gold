@entry a421261ed96f9a39
kind: step
verb: clamp
noun: pairs
modifier: none
context: math
phrase: clamp pairs none {cap}
phrase: bound pairs none {cap}
slot: cap int
test: list=10,25,15,30 cap=30
expect: => i=2 r=0.0 ok=true s="clamped 2" errors=0 n=4 res=[10,20,15,15] cache=0 hits=0
test: list=5,10,12 cap=50
expect: => i=0 r=0.0 ok=true s="clamped 0" errors=0 n=3 res=[5,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${cap};
	var adjusted = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] + g.res[k + 1] > max_sum {
			g.res[k + 1] = max_sum - g.res[k];
			adjusted++;
		}
		k += 2;
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped ", adjusted);
	out
}
@end
