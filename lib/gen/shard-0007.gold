code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt_sum = 0;
	var sign = 1;
	var i = g.n;
	while i > 0 {
		i--;
		alt_sum += g.res[i] * sign;
		sign = -sign;
	}
	gold_push(g, alt_sum);
	g.steps += g.n;
	out.i = alt_sum;
	out.s.clear();
	format(out.s, "reversed series all alternating sum ", alt_sum);
	out
}
@end
