fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 || lim <= 0 { return out; }
	var new_res int[64] = [0; 64];
	var nc = 0;
	var cur_streak = 0;
	var last_val = g.res[0];
	for i in g.n {
		if g.res[i] == last_val {
			cur_streak++;
		} else {
			last_val = g.res[i];
			cur_streak = 1;
		}
		if cur_streak <= lim {
			if nc < 64 { new_res[nc] = g.res[i]; nc++; }
		}
	}
	gold_clear(g);
	for k in nc { gold_push(g, new_res[k]); }
	g.steps += g.n;
	out.i = nc;
	out.s.clear();
	format(out.s, "split streak until limit count ", nc);
	out
}
@end
