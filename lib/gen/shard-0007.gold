@entry 963dee5ec26fb5f6
kind: step
verb: group
noun: odds
modifier: any
context: sort
phrase: group odds any
phrase: partition odds any
test: list=4,7,2,9,5
expect: => i=3 r=0.0 ok=true s="grouped odds count 3" errors=0 n=5 res=[5,7,9,2,4] cache=0 hits=0
test: list=8,3,10,1
expect: => i=2 r=0.0 ok=true s="grouped odds count 2" errors=0 n=4 res=[1,3,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[64] = [0; 64];
	var evens int[64] = [0; 64];
	var oc = 0;
	var ec = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			if oc < 64 { odds[oc] = g.res[i]; oc++; }
		} else {
			if ec < 64 { evens[ec] = g.res[i]; ec++; }
		}
	}
	for i in oc {
		for j in oc - 1 {
			if odds[j] > odds[j + 1] { let t = odds[j]; odds[j] = odds[j + 1]; odds[j + 1] = t; }
		}
	}
	for i in ec {
		for j in ec - 1 {
			if evens[j] > evens[j + 1] { let t = evens[j]; evens[j] = evens[j + 1]; evens[j + 1] = t; }
		}
	}
	gold_clear(g);
	for i in oc { gold_push(g, odds[i]); }
	for i in ec { gold_push(g, evens[i]); }
	out.i = oc;
	out.s.clear();
	format(out.s, "grouped odds count ", oc);
	out
}
@end
