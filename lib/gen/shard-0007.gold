@entry 9b8a13bcb08c28bf
kind: step
verb: dedupe
noun: maximum
modifier: any
context: format
phrase: dedupe maximum elements across any occurrences
phrase: format unique maximum element keeping single copy
test: list=5,10,10,2,10
expect: => i=3 r=0.0 ok=true s="deduped max: 10 count: 3" errors=0 n=5 res=[5,10,10,2,10] cache=0 hits=0
