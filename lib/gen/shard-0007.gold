fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${end};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	var total = 0;
	if s <= e && g.n > 0 {
		for k in s..e + 1 {
			total += g.res[k];
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "safe range sum is ", total);
	g.steps += g.n;
	out
}
@end
