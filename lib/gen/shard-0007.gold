fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { even_count++; }
	}
	if even_count > 1 {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			while left < right && g.res[left] % 2 != 0 { left++; }
			while left < right && g.res[right] % 2 != 0 { right--; }
			if left < right {
				let t = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = t;
				left++;
				right--;
			}
		}
	}
	g.steps += g.n;
	out.i = even_count;
	out.s.clear();
	format(out.s, "reversed even count ", even_count);
	out
}
@end
