fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	let mc = ${max_code};
	for step in r {
		var clamped = 0;
		for i in out.s.len {
			var code = out.s[i] as int;
			if code > mc {
				code = mc;
				out.s[i] = code as byte;
				clamped++;
			}
		}
		gold_push(g, clamped);
	}
	out.i = g.n;
	out
}
@end
