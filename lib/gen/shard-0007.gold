expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${min_freq};
	let mx = ${max_freq};
	var valid_items int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq >= mn && freq <= mx {
			valid_items.push(x);
		}
	}
	gold_clear(g);
	for x in valid_items {
		gold_push(g, x);
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
@entry 3d9c3d6e746b6139
kind: step
