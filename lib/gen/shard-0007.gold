phrase: insert suffix any trailing elements into sorted prefix
test: list=1,3,6,8,2
expect: => i=8 r=0.0 ok=true s="merged suffix into order: 5" errors=0 n=5 res=[1,2,3,6,8] cache=0 hits=0
test: list=10,20,30,15,5
expect: => i=30 r=0.0 ok=true s="merged suffix into order: 5" errors=0 n=5 res=[5,10,15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	// simple insertion sort step on whole array
	for i in 1..g.n {
		var j = i;
		while j > 0 && g.res[j] < g.res[j - 1] {
			let t = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = t;
			j--;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "merged suffix into order: ", g.n);
	out
}
@end
@entry 083b17317dec4689
kind: step
verb: swap
noun: letters
modifier: every_other
context: sort
phrase: swap letters every other alternate character
phrase: bubble sort letters every other stride
test: text="dbcaef"
expect: => i=1 r=0.0 ok=true s="cbdaef" errors=0 n=0 res=[] cache=0 hits=0
test: text="cba"
expect: => i=1 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 { return out; }
	var swapped = false;
	var i = 0;
	while i + 2 < out.s.len {
		if out.s[i] > out.s[i + 2] {
			let t = out.s[i];
			out.s[i] = out.s[i + 2];
			out.s[i + 2] = t;
			swapped = true;
		}
		i += 2;
	}
	out.ok = swapped;
	g.steps += out.s.len;
	out.i = if swapped { 1 } else { 0 };
	out
}
@end
