	var clamped = 0;
	for i in g.n {
		if g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
	}
	gold_cache_put(g, 7, clamped);
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped count ", clamped);
	out
}
@end
