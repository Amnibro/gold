@entry c95384231011ea61
kind: step
verb: rotate
noun: number
modifier: last
context: filter
phrase: rotate target number to last position {target}
phrase: move specific number to last slot {target}
slot: target int
test: list=1,5,3,4 target=5
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,4,5] cache=0 hits=0
test: list=10,20,30 target=10
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for k in g.n {
		if g.res[k] == tgt {
			idx = k;
			break;
		}
	}
	if idx >= 0 {
		let val = g.res[idx];
		var i = idx;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = val;
		out.ok = true;
		out.i = idx;
	} else {
		gold_fail(g, "number not found");
		out.ok = false;
		out.i = -1;
	}
	g.steps += g.n;
	out
}
@end
