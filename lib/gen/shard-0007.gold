code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fill_v = ${filler};
	var err_idx = -1;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] < g.res[i] {
				err_idx = i + 1;
				break;
			}
		}
	}
	if err_idx >= 0 {
		g.res[err_idx] = fill_v;
		out.i = err_idx;
	} else {
		out.i = -1;
	}
	out.s.clear();
	format(out.s, "error replaced at ", out.i);
	out
}
@end
@entry 8dc327a093c8b9b2
