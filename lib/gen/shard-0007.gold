expect: => i=3 r=0.0 ok=true s="found pairwise words count 3" errors=0 n=1 res=[3] cache=0 hits=0
test: text="one two three four five"
expect: => i=2 r=0.0 ok=true s="found pairwise words count 2" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var wlens int[32] = [0; 32];
	var wn = 0;
	var cur = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if cur > 0 && wn < 32 {
				wlens[wn] = cur;
				wn++;
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 && wn < 32 {
		wlens[wn] = cur;
		wn++;
	}
	var pairs = 0;
	if wn >= 2 {
		for i in wn - 1 {
			if wlens[i] == wlens[i + 1] {
				pairs++;
			}
		}
	}
	g.steps += v.s.len;
	out.i = pairs;
	gold_push(g, pairs);
	out.s.clear();
	format(out.s, "found pairwise words count ", pairs);
	out
}
@end
