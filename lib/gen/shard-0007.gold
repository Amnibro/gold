fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_letters};
	var count = 0;
	for c in out.s {
		let is_letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
		if is_letter && count < ml {
			count++;
		}
	}
	out.i = count;
	gold_push(g, count);
	g.steps += count;
	out
}
