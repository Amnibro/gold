code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_letters};
	var count = 0;
	var buf byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			count++;
			buf.push(c);
			if count >= ml { break; }
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len;
	out.i = count;
	out
}
@end
