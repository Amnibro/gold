@entry d73ecb29991c0758
kind: step
verb: count
noun: sequence
modifier: with_retry
context: list
phrase: count sequence with_retry for target {target}
phrase: tally matching sequence with_retry for value {target}
slot: target int
test: list=7,7,7,2,7 target=7
expect: => i=3 r=0.0 ok=true s="sequence length 3" errors=0 n=5 res=[7,7,7,2,7] cache=0 hits=0
test: list=4,5,4,8 target=5
expect: => i=1 r=0.0 ok=true s="sequence length 1" errors=0 n=4 res=[4,5,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var max_run = 0;
	var cur_run = 0;
	for i in g.n {
		if g.res[i] == tgt {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 0;
		}
	}
	if max_run == 0 {
		for i in g.n {
			let diff = if g.res[i] > tgt { g.res[i] - tgt } else { tgt - g.res[i] };
			if diff <= 1 {
				cur_run++;
				if cur_run > max_run { max_run = cur_run; }
			} else {
				cur_run = 0;
			}
		}
	}
	out.i = max_run;
	out.s.clear();
	format(out.s, "sequence length ", max_run);
	g.steps += g.n;
	out
}
@end
