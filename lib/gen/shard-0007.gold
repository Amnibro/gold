expect: => i=4 r=0.0 ok=true s="deduplicated unique items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="deduplicated unique items" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in new_n {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		}
	}
	g.steps += g.n * new_n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduplicated unique items");
	out
}
@end
