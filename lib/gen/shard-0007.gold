code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, hit = gold_cache_get(g, k);
	if !hit {
		var sum = 0;
		for i in g.n {
			sum += g.res[i];
		}
		gold_cache_put(g, k, sum);
		out.i = sum;
	} else {
		out.i = val;
	}
	out.s.clear();
	format(out.s, "step cache val ", out.i);
	out
}
@end
