fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid = g.n / 2;
		if g.res[mid] > g.res[mid - 1] {
			let t = g.res[mid];
			g.res[mid] = g.res[mid - 1];
			g.res[mid - 1] = t;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted middle for size ", g.n);
	out
}
@end
