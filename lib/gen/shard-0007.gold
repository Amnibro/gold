code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_gap};
	var gap_count = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			var diff = g.res[k + 1] - g.res[k];
			if diff < 0 { diff = -diff; }
			if diff >= threshold {
				gap_count++;
			}
		}
	}
	out.i = gap_count;
	out.s.clear();
	format(out.s, "gaps ", gap_count);
	out
}
@end
