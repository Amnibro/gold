fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var low int[128] = [0; 128];
	var high int[128] = [0; 128];
	var n_low = 0;
	var n_high = 0;
	for i in g.n {
		if g.res[i] < 90 {
			low[n_low] = g.res[i];
			n_low++;
		} else {
			high[n_high] = g.res[i];
			n_high++;
		}
	}
	for i in n_low {
		g.res[i] = low[i];
	}
	for i in n_high {
		g.res[n_low + i] = high[i];
	}
	g.steps += g.n * 2;
	out.i = n_low;
	out.s.clear();
	format(out.s, "grouped letter codes");
	out
}
@end
