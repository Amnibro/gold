	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("shifted into 0 pairwise differences");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		g.res[i] = g.res[i + 1] - g.res[i];
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted into ", np, " pairwise differences");
	g.steps += np;
	out
}
@end
