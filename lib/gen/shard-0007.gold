fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifts = 0;
	while g.n > 0 && !${p}(g.res[0]) && shifts < g.n {
		let first_v = g.res[0];
		for k in (g.n - 1) {
			g.res[k] = g.res[k + 1];
		}
		g.res[g.n - 1] = first_v;
		shifts++;
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifts ", shifts);
	out
}
@end
