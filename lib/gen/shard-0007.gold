fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let from_idx = if s < 0 { 0 } else if s > g.n { g.n } else { s };
	let count = g.n - from_idx;
	for i in count {
		g.res[i] = g.res[from_idx + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected suffix past start index");
	out
}
