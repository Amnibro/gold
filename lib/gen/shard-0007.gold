	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("found 0 streaks");
		return out;
	}
	var count = 0;
	var cur_len = 1;
	var cur_val = g.res[0];
	var streaks int[512] = [0; 512];
	for k in 1..g.n {
		if g.res[k] == cur_val {
			cur_len++;
