code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var kept int[64] = [0; 64];
	var kc = 0;
	if g.n > 0 {
		kept[0] = g.res[0]; kc = 1;
		var last = g.res[0];
		for i in 1..g.n {
			if g.res[i] == last + s && kc < 64 {
				kept[kc] = g.res[i];
				last = g.res[i];
				kc++;
			}
		}
	}
	gold_clear(g);
	for i in kc { gold_push(g, kept[i]); }
	out.i = kc;
	out.s.clear();
	format(out.s, "series collected ", kc);
	out
}
@end
