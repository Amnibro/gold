fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${steps};
	if g.n == 0 || st <= 0 { return out; }
	let shift = st % g.n;
	if shift == 0 { return out; }
	var tmp int[512] = [0; 512];
	for i in g.n {
		tmp[(i + shift) % g.n] = g.res[i];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated budget right steps: ", shift);
	out
}
@end
