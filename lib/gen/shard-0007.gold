code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for run mapping");
		out.ok = false;
		return out;
	}
	var run_idx = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			gold_cache_put(g, run_idx, cur_len);
			run_idx++;
			cur_len = 1;
		}
	}
	gold_cache_put(g, run_idx, cur_len);
	run_idx++;
	g.steps += g.n;
	out.i = run_idx;
	out.s.clear();
	format(out.s, "cached error runs: ", run_idx);
	out
}
@end
