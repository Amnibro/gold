code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "too few error records to gap normalize");
		out.ok = false;
		return out;
	}
	let first_gap = g.res[1] - g.res[0];
	if first_gap <= 0 {
		gold_fail(g, "invalid non positive gap");
		out.ok = false;
		return out;
	}
	for i in (g.n - 1) {
		g.res[i + 1] = g.res[i] + first_gap;
	}
	g.steps += g.n;
	out.i = first_gap;
	out.s.clear();
	format(out.s, "normalized gaps with first delta ", first_gap);
	out
}
@end
