code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lv = ${levels};
	if lv <= 0 || g.n == 0 {
		gold_fail(g, "nested levels must be positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid nested levels");
		return out;
	}
	var acc = 0;
	for i in 1..(lv + 1) {
		for j in g.n {
			acc += g.res[j] * i;
		}
	}
	gold_cache_put(g, lv, acc);
	out.i = acc;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached nested values across levels");
	g.steps += lv * g.n;
	out
}
@end
