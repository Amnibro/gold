@entry 879439c5abd0d699
kind: step
verb: run
noun: gaps
modifier: until
context: math
phrase: run gaps until {limit}
phrase: trace gaps until {limit}
slot: limit int
test: list=2,4,7,15,30 limit=5
expect: => i=2 r=0.0 ok=true s="gap at 2" errors=0 n=5 res=[2,4,7,15,30] cache=0 hits=0
test: list=1,2,3 limit=5
expect: => i=2 r=0.0 ok=true s="count 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var count = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			var diff = g.res[k + 1] - g.res[k];
			if diff < 0 { diff = -diff; }
			if diff >= cap {
				out.i = k;
				out.s.clear();
				format(out.s, "gap at ", k);
				return out;
			}
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "count ", count);
	out
}
@end
