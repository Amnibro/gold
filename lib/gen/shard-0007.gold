fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n > 0 && s > 0 {
		var temp = [0; 512];
		for i in g.n {
			temp[(i + s) % g.n] = g.res[i];
		}
		for i in g.n {
			g.res[i] = temp[i];
		}
		out.i = g.res[0];
	}
	out
}
@end
