code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let valid = total <= ceil;
	if !valid { gold_fail(g, "retry total exceeded ceiling"); }
	g.steps += g.n;
	out.ok = valid;
	out.i = total;
	out.s.clear();
	format(out.s, "retry total valid: ", valid);
	out
}
@end
@entry 514eda1613453157
kind: step
verb: repeat
noun: digits
modifier: between
context: retry
phrase: repeat digits between low {lo} high {hi} bounds
phrase: duplicate retry delay digits between range {lo} to {hi}
slot: lo int
slot: hi int
test: list=2,5,8,12 lo=3 hi=10
expect: => i=2 r=0.0 ok=true s="repeated digits between bounds: 2" errors=0 n=6 res=[2,5,8,12,5,8] cache=0 hits=0
test: list=1,4,7 lo=2 hi=5
expect: => i=1 r=0.0 ok=true s="repeated digits between bounds: 1" errors=0 n=4 res=[1,4,7,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	let orig = g.n;
	var repeated = 0;
	for i in orig {
		if g.res[i] >= lo && g.res[i] <= hi {
			if g.n < 512 {
				gold_push(g, g.res[i]);
				repeated++;
			}
		}
	}
	g.steps += orig + repeated;
	out.i = repeated;
	out.s.clear();
	format(out.s, "repeated digits between bounds: ", repeated);
	out
}
@end
