code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 {
		for i in g.n { gold_cache_put(g, i, g.res[i]); }
	}
	let limit = ${cap};
	let count = if limit < g.cn { limit } else { g.cn };
	var sum = 0;
	for i in count {
		sum += g.cv[i];
	}
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "traced cache at most count sum ", sum);
	out
}
@end
