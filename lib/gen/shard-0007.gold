code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var above int[512] = [0; 512];
	var below int[512] = [0; 512];
	var na = 0;
	var nb = 0;
	for k in g.n {
		let x = g.res[k];
		if x > limit {
			above[na] = x;
			na++;
		} else {
			below[nb] = x;
			nb++;
		}
	}
	for k in na { g.res[k] = above[k]; }
	for k in nb { g.res[na + k] = below[k]; }
	out.i = na;
	out.s.clear();
	format(out.s, "shifted ", na, " elements above limit");
	g.steps += g.n;
	out
}
@end
