phrase: verify trailing retry suffix unique values for last {k}
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=1 r=0.0 ok=true s="suffix unique valid: true" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=1,2,3,4,3 k=3
expect: => i=0 r=0.0 ok=false s="suffix unique valid: false" errors=0 n=5 res=[1,2,3,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || k > g.n {
		gold_fail(g, "invalid suffix count");
		out.ok = false;
		return out;
	}
	let start = g.n - k;
	var is_uniq = true;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				is_uniq = false;
				break;
			}
		}
		if !is_uniq { break; }
	}
	g.steps += k;
	out.ok = is_uniq;
	out.i = if is_uniq { 1 } else { 0 };
	out.s.clear();
	format(out.s, "suffix unique valid: ", is_uniq);
	out
}
@end
