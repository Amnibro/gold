phrase: clamp gaps until retry index {stop} with limit {lim}
phrase: restrict retry gaps until position {stop} at {lim}
slot: stop int
slot: lim int
test: list=1,10,25,30 stop=2 lim=5
expect: => i=2 r=0.0 ok=true s="clamped retry gaps count: 2" errors=0 n=4 res=[1,6,11,30] cache=0 hits=0
test: list=2,20,40 stop=3 lim=4
expect: => i=2 r=0.0 ok=true s="clamped retry gaps count: 2" errors=0 n=3 res=[2,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stop};
	let limit = ${lim};
	var clamped = 0;
	var i = 0;
	while i + 1 < g.n && i < st {
		let gap = g.res[i + 1] - g.res[i];
		if gap > limit {
			g.res[i + 1] = g.res[i] + limit;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped retry gaps count: ", clamped);
	out
}
@end
