fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_val = -999999;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			if g.res[i] > max_val { max_val = g.res[i]; }
		}
	}
	var count = 0;
	if max_val != -999999 {
		for i in g.n {
			if g.res[i] == max_val { count++; }
		}
	}
	out.i = count;
	out.ok = count > 0;
	out.s.clear();
	format(out.s, "maximum count in range: ", count);
	g.steps += g.n * 2;
	out
}
