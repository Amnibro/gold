fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	for k in g.n {
		let idx = g.n - 1 - k;
		if g.res[idx] > c {
			g.res[idx] = c;
		}
	}
	g.steps++;
	out.i = g.n;
	out
}
