@entry 85427caddf21941e
kind: step
verb: sort
noun: function
modifier: at_most
context: format
phrase: sort function values at most up to count {max_count} using {fn_arg}
phrase: format sorted function results at most bounded by {max_count} via {fn_arg}
slot: max_count int
slot: fn_arg fn
test: list=4,2,3 max_count=2 fn_arg=double
expect: => i=2 r=0.0 ok=true s="sorted function prefix: [4, 8]" errors=0 n=3 res=[4,8,3] cache=0 hits=0
test: list=5,1,9 max_count=3 fn_arg=square
expect: => i=3 r=0.0 ok=true s="sorted function prefix: [1, 25, 81]" errors=0 n=3 res=[1,25,81] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	let lim = if mc < g.n { mc } else { g.n };
	for k in lim {
		g.res[k] = ${fn_arg}(g.res[k]);
	}
	var i = 0;
	while i < lim {
		var j = 0;
		while j + 1 < lim - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "sorted function prefix: [");
	var first = true;
	for k in lim {
		if !first { format(out.s, ", "); }
		format(out.s, g.res[k]);
		first = false;
	}
	format(out.s, "]");
	out.i = lim;
	g.steps += lim * lim;
	out
}
@end
