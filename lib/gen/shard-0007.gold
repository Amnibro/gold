kind: step
verb: collect
noun: budget
modifier: times
context: aggregate
phrase: collect budget total {reps} times {unit_budget}
phrase: aggregate items collecting budget {unit_budget} across {reps} cycles
slot: unit_budget int
slot: reps int
test: list=10,20,30,40,50 unit_budget=35 reps=2
expect: => i=60 r=0.0 ok=true s="budget collected 60" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,10,15 unit_budget=20 reps=1
expect: => i=15 r=0.0 ok=true s="budget collected 15" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ub = ${unit_budget};
	let r = ${reps};
	var cycles = 0;
	var cur_sum = 0;
	var total_collected = 0;
	for i in g.n {
		if cur_sum + g.res[i] <= ub {
			cur_sum += g.res[i];
		} else {
			total_collected += cur_sum;
			cycles++;
			cur_sum = g.res[i];
			if cycles >= r { break; }
		}
	}
	if cycles < r { total_collected += cur_sum; }
	g.steps += g.n;
	out.i = total_collected;
	out.s.clear();
	format(out.s, "budget collected ", total_collected);
	out
}
@end
