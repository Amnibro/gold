		gold_fail(g, "cache capacity exceeded by error pairs");
		out.ok = false;
	}
	g.steps += cached_pairs;
	out.i = cached_pairs;
	out.s.clear();
	format(out.s, "cached pairwise error entries ", cached_pairs);
	out
}
