kind: step
verb: scale
noun: average
modifier: while
context: sort
phrase: scale average while sum under limit {threshold}
phrase: boost average while total below target {threshold}
slot: threshold int
test: list=1,2,3,4 threshold=25
expect: => i=20 r=0.0 ok=true s="average scaled rounds: 1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,20 threshold=40
expect: => i=30 r=0.0 ok=true s="average scaled rounds: 0" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${threshold};
	var total = 0;
	for k in g.n { total += g.res[k]; }
	var rounds = 0;
	while total * 2 <= lim && rounds < 10 {
		for k in g.n { g.res[k] *= 2; }
		total *= 2;
		rounds++;
	}
	out.i = total;
	g.steps += rounds * g.n + 1;
	out.s.clear();
	format(out.s, "average scaled rounds: ", rounds);
	out
}
@end
