@entry 1fae697adfa71f1b
kind: step
verb: keep
noun: sequence
modifier: sorted
context: cache
phrase: keep sequence sorted inserting into cache
phrase: preserve sequence sorted order across cache
test: list=4,2,7,1,5
expect: => i=5 r=0.0 ok=true s="sorted sequence cached: 5" errors=0 n=5 res=[1,2,4,5,7] cache=5 hits=0
test: list=10,5,8,3
expect: => i=4 r=0.0 ok=true s="sorted sequence cached: 4" errors=0 n=4 res=[3,5,8,10] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in 1..g.n {
		var j = i;
		while j > 0 && g.res[j] < g.res[j - 1] {
			let t = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = t;
			j--;
		}
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "sorted sequence cached: ", g.n);
	out
}
@end
