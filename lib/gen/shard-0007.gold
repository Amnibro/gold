code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 1 || g.n <= 1 { return out; }
	let lim = if cnt < g.n { cnt } else { g.n };
	var i = 0;
	var j = lim - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = lim;
	g.steps += lim;
	out
}
@end
