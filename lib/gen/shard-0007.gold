@entry 447051314bb58d3b
kind: step
verb: limit
noun: steps
modifier: with_cache
context: math
phrase: limit steps with_cache {limit}
phrase: bounded steps with_cache {limit}
slot: limit int
slot: f fn
test: input=2 limit=3 f=double
expect: => i=16 r=0.0 ok=true s="" errors=0 n=3 res=[4,8,16] cache=3 hits=0
test: input=5 limit=2 f=inc
expect: => i=7 r=0.0 ok=true s="" errors=0 n=2 res=[6,7] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_steps = ${limit};
	var cur = out.i;
	var k = 0;
	while k < max_steps {
		let cached, ok = gold_cache_get(g, cur);
		if ok {
			cur = cached;
		} else {
			let next = ${f}(cur);
			gold_cache_put(g, cur, next);
			cur = next;
		}
		gold_push(g, cur);
		k++;
	}
	g.steps += k;
	out.i = cur;
	out
}
@end
