code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	let orig_n = g.n;
	var added = 0;
	for i in orig_n {
		let val = g.res[i];
		var cnt = 0;
		for j in orig_n {
			if g.res[j] == val { cnt++; }
		}
		if cnt >= mf {
			gold_push(g, val);
			added++;
		}
	}
	out.i = added;
	out.s.clear();
	format(out.s, "added ", added);
	out
}
@end
