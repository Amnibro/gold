@entry d53f5a9c9a067fdf
kind: step
verb: collect
noun: range
modifier: with_retry
context: stats
phrase: collect sample range with_retry from {low} to {high}
phrase: gather distribution range with_retry spanning {low} to {high}
slot: low int
slot: high int
test: list=10,20,30,40 low=15 high=35
expect: => i=2 r=0.0 ok=true s="range collected 2" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=10,20,35 low=36 high=50
expect: => i=1 r=0.0 ok=true s="range collected 1" errors=0 n=1 res=[35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var kept int[64] = [0; 64];
	var kc = 0;
	for i in g.n {
		if g.res[i] >= l && g.res[i] <= h && kc < 64 {
			kept[kc] = g.res[i];
			kc++;
		}
	}
	if kc == 0 {
		let l2 = l - 5;
		let h2 = h + 5;
		for i in g.n {
			if g.res[i] >= l2 && g.res[i] <= h2 && kc < 64 {
				kept[kc] = g.res[i];
				kc++;
			}
		}
	}
	gold_clear(g);
	for k in kc {
		gold_push(g, kept[k]);
	}
	out.i = kc;
	out.s.clear();
	format(out.s, "range collected ", kc);
	out
}
@end
