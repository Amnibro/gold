fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${threshold};
	var sum = 0;
	var count = 0;
	while count < g.n && sum < target {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded prefix at least threshold");
	out
}
@end
