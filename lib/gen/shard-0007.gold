fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let f = ${factor};
	gold_cache_put(g, 1, 10);
	gold_cache_put(g, 2, 20);
	let val, ok = gold_cache_get(g, k);
	if ok {
		let res = val * f;
		out.i = res;
		out.ok = true;
		out.s.clear();
		format(out.s, "scaled cache value: ", res);
	} else {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("cache lookup failed");
	}
	g.steps += 2;
	out
}
