code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${block_size};
	if sz <= 0 { out.ok = false; return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var b_sum = 0;
		let bound = if i + sz < g.n { i + sz } else { g.n };
		for j in i..bound { b_sum += g.res[j]; }
		g.res[kept] = b_sum;
		kept++;
		i += sz;
	}
	g.n = kept;
	out.i = kept;
	out.ok = kept > 0;
	out.s.clear();
	format(out.s, "merged block count: ", kept);
	g.steps += g.n;
	out
}
@end
