fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_pair};
	if g.n >= 2 {
		let pairs = g.n / 2;
		for k in pairs {
			var sum = g.res[2 * k] + g.res[2 * k + 1];
			if sum > limit { sum = limit; }
			g.res[k] = sum;
		}
		g.n = pairs;
		out.i = g.res[0];
	}
	out.s.clear();
	format(out.s, "capped pairs: ", g.n);
	out
}
@end
