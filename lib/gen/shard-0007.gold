fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			run_len++;
			i++;
		}
		g.res[new_n] = run_len;
		new_n++;
		i++;
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "returned runs in place");
	out
}
@end
