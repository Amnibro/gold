expect: => i=2 r=0.0 ok=true s="dropped elements past running cap" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10,15 ceiling=20
expect: => i=2 r=0.0 ok=true s="dropped elements past running cap" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var run = 0;
	var keep_n = 0;
	for i in g.n {
		if run + g.res[i] > cap {
			break;
		}
		run += g.res[i];
		keep_n++;
	}
	g.n = keep_n;
	g.steps += keep_n + 1;
	out.i = keep_n;
	out.s.clear();
	format(out.s, "dropped elements past running cap");
	out
}
@end
