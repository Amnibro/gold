test: list=10,5,20,15,30
expect: => i=2 r=0.0 ok=true s="pairwise comparison drops 2" errors=0 n=5 res=[10,5,20,15,30] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="pairwise comparison drops 0" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "pairwise compare requires at least 2 items");
		out.ok = false;
		return out;
	}
	var drops = 0;
	for i in (g.n - 1) {
		if g.res[i] > g.res[i + 1] {
			drops++;
		}
	}
	g.steps += g.n - 1;
	out.i = drops;
	out.s.clear();
	format(out.s, "pairwise comparison drops ", drops);
	out
}
@end
