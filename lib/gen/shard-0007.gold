fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	for i in g.n {
		for j in (g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted list of ", g.n);
	g.steps += g.n * g.n;
	out
}
@end
