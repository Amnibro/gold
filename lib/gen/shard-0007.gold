test: list=5,5,5,5
expect: => i=20 r=0.0 ok=true s="" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var changed = true;
	while changed && g.n > 1 {
		changed = false;
		var w = 0;
		var i = 0;
		while i < g.n {
			var sum = g.res[i];
			var j = i + 1;
			while j < g.n && g.res[j] == g.res[i] {
				sum += g.res[j];
				j++;
				changed = true;
			}
			g.res[w] = sum;
			w++;
			i = j;
		}
		g.n = w;
	}
	if g.n > 0 { out.i = g.res[0]; }
	out
}
@end
