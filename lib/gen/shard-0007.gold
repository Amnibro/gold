phrase: pad distribution prefix at_least {target} with {val}
slot: target int
slot: val int
test: list=1,2 target=4 val=0
expect: => i=4 r=0.0 ok=true s="filled prefix to 4" errors=0 n=4 res=[0,0,1,2] cache=0 hits=0
test: list=10,20 target=3 val=5
expect: => i=3 r=0.0 ok=true s="filled prefix to 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let fill_v = ${val};
	if g.n < tgt && tgt <= 64 {
		let diff = tgt - g.n;
		var temp int[64] = [0; 64];
		for i in diff {
			temp[i] = fill_v;
		}
		for i in g.n {
			temp[diff + i] = g.res[i];
		}
		gold_clear(g);
		for i in tgt {
			gold_push(g, temp[i]);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled prefix to ", g.n);
	out
}
@end
