fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] < 0 || g.res[i + 1] < 0 {
			g.errors++;
			break;
		}
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps until fault: ", swaps);
	out
}
@end
