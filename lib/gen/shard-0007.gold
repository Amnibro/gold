fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let split_point = ${k};
	var left_sum = 0;
	var right_sum = 0;
	for i in g.n {
		if i < split_point { left_sum += g.res[i]; }
		else { right_sum += g.res[i]; }
	}
	g.steps += g.n;
	out.i = left_sum - right_sum;
	out.s.clear();
	format(out.s, "partition difference ", out.i);
	out
}
