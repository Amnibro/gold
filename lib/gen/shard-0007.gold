fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp = [0; 512];
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			tmp[evens] = g.res[i];
			evens++;
		}
	}
	var odds = evens;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			tmp[odds] = g.res[i];
			odds++;
		}
	}
	for i in g.n { g.res[i] = tmp[i]; }
	out.i = evens;
	g.steps += g.n;
	out
}
@end
