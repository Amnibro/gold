@entry 7613779ef201f636
kind: step
verb: merge
noun: spaces
modifier: running
context: aggregate
phrase: merge running spaces into single space occurrences
phrase: aggregate running space characters across input text
test: text="a   b  c"
expect: => i=5 r=0.0 ok=true s="a b c" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello   world"
expect: => i=3 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var collapsed byte[>..] = [];
	var in_space = false;
	var space_count = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			if !in_space {
				collapsed.push(' ');
				in_space = true;
			}
			space_count++;
		} else {
			collapsed.push(c);
			in_space = false;
		}
	}
	out.s.clear();
	out.s.append(collapsed);
	g.steps += v.s.len;
	out.i = space_count;
	out
}
@end
