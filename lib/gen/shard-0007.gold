expect: => i=5 r=0.0 ok=true s="reversed total list 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="reversed total list 4" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed total list ", g.n);
	g.steps += g.n;
	out
}
@end
