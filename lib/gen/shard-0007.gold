fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var min_idx = 0;
		for i in g.n {
			if g.res[i] < g.res[min_idx] {
				min_idx = i;
			}
		}
		let min_v = g.res[min_idx];
		var k = min_idx;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = min_v;
		out.i = min_v;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "minimum to front ", out.i);
	out
}
@end
