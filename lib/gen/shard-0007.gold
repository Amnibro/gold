code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if out.s.len > limit && limit >= 0 {
		let dropped = out.s.len - limit;
		gold_cache_put(g, 0, dropped);
		var new_s byte[..200] = "";
		for k in limit {
			new_s.push(out.s[k]);
		}
		out.s = new_s;
		out.i = dropped;
	}
	out
}
@end
