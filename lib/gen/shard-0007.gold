fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	let bgt = ${budget};
	let orig = out.s;
	var res byte[..200] = "";
	for step in t {
		for i in orig.len {
			if res.len >= bgt { break; }
			res.push(orig[i]);
		}
		if res.len >= bgt { break; }
	}
	out.s.clear();
	out.s.append(res);
	gold_push(g, out.s.len);
	out.i = out.s.len;
	out
}
@end
