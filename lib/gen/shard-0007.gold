@entry 655f97cc5d2d7689
kind: step
verb: scale
noun: prefix
modifier: sorted
context: math
phrase: sort sequence scaling sorted prefix {count} by factor {factor}
phrase: sort results multiplying prefix {count} by {factor}
phrase: scale initial sorted prefix {count} with factor {factor}
slot: count int
slot: factor int
test: list=40,10,30,20 count=2 factor=3
expect: => i=2 r=0.0 ok=true s="scaled sorted prefix: 2" errors=0 n=4 res=[30,60,30,40] cache=0 hits=0
test: list=5,2,8,1 count=2 factor=5
expect: => i=2 r=0.0 ok=true s="scaled sorted prefix: 2" errors=0 n=4 res=[5,10,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let f = ${factor};
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	let bound = if c < g.n { c } else { g.n };
	for i in bound {
		g.res[i] *= f;
	}
	out.i = bound;
	out.ok = bound > 0;
	out.s.clear();
	format(out.s, "scaled sorted prefix: ", bound);
	g.steps += g.n * g.n;
	out
}
@end
