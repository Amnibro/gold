test: list=10,20,30,41
expect: => i=1 r=0.0 ok=true s="grouped odd error codes count 1" errors=0 n=4 res=[41,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[64] = [0; 64];
	var evens int[64] = [0; 64];
	var oc = 0;
	var ec = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			if oc < 64 { odds[oc] = g.res[i]; oc++; }
		} else {
			if ec < 64 { evens[ec] = g.res[i]; ec++; }
		}
	}
	if oc == 0 {
		gold_fail(g, "no odd error codes encountered");
		out.ok = false;
	}
	for i in oc { g.res[i] = odds[i]; }
	for i in ec { g.res[oc + i] = evens[i]; }
	g.steps += g.n;
	out.i = oc;
	out.s.clear();
	format(out.s, "grouped odd error codes count ", oc);
	out
}
@end
