test: list=9,3,7,12 cap=8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[3,7,8,8] cache=1 hits=0
test: list=20,15,5 cap=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,10,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	for k in g.n {
		if g.res[k] > cp {
			g.res[k] = cp;
		}
	}
	for i in g.n {
		for j in i + 1 .. g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	if g.n > 0 {
		gold_cache_put(g, cp, g.res[g.n - 1]);
	}
	g.steps++;
	out.i = g.n;
	out
}
@end
