	var is_sorted = true;
	if out.s.len > 1 {
		for k in 1..out.s.len {
			if out.s[k] < out.s[k - 1] {
				is_sorted = false;
				break;
			}
		}
	}
	out.s.clear();
	if is_sorted {
		out.i = 1;
		out.ok = true;
		out.s.append("text characters are sorted");
	} else {
		out.i = 0;
		out.ok = false;
		out.s.append("text characters are unsorted");
	}
	g.steps += out.s.len;
	out
}
