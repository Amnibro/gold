kind: step
verb: swap
noun: sequence
modifier: times
context: error
phrase: swap sequence times to correct fault order
phrase: permute failure sequence items iteratively
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="swapped fault sequence: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
test: list=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "sequence too short to swap");
		out.ok = false;
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n + swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped fault sequence: ", swaps);
	out
}
@end
