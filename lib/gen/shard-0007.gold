@entry ece6bf7d03f58584
kind: step
verb: scale
noun: primes
modifier: with_cache
context: stats
phrase: scale primes with_cache multiplying by factor {factor}
phrase: multiply prime observations by {factor} caching prime count
slot: factor int
test: list=2,3,4,5,6 factor=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[20,30,4,50,6] cache=1 hits=0
test: list=7,8,9 factor=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[14,8,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[i] *= f;
				primes++;
			}
		}
	}
	gold_cache_put(g, 0, primes);
	out.i = primes;
	g.steps += g.n;
	out
}
@end
