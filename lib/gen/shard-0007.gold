@entry d326e28473ddc987
kind: step
verb: normalize
noun: minimum
modifier: times
context: error
phrase: normalize error minimum {times} times
phrase: scale fault minimum {times} iterations
slot: times int
test: list=5,10,15 times=2
expect: => i=1 r=0.0 ok=true s="normalized minimum 2 times" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=2,8,20 times=3
expect: => i=1 r=0.0 ok=true s="normalized minimum 3 times" errors=0 n=3 res=[1,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 || g.n == 0 {
		gold_fail(g, "invalid inputs for minimum normalization");
		out.ok = false;
		return out;
	}
	for step in t {
		var min_val = g.res[0];
		for i in g.n {
			if g.res[i] < min_val {
				min_val = g.res[i];
			}
		}
		if min_val <= 0 {
			gold_fail(g, "non positive error minimum");
			out.ok = false;
			return out;
		}
		for i in g.n {
			g.res[i] = g.res[i] / min_val;
		}
	}
	g.steps += t * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "normalized minimum ", t, " times");
	out
}
@end
