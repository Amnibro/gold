@entry 303b9aa344c25d37
kind: step
verb: clamp
noun: tail
modifier: running
context: list
phrase: clamp tail running {cap}
phrase: bound tail running {cap}
slot: cap int
test: list=5,10,20,30 cap=25
expect: => i=25 r=0.0 ok=true s="" errors=0 n=4 res=[5,10,20,5] cache=0 hits=0
test: list=1,2,3,4 cap=50
expect: => i=7 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n >= 2 {
		let half = g.n / 2;
		var run_sum = 0;
		for i in (g.n - half) {
			let idx = half + i;
			run_sum += g.res[idx];
			if run_sum > limit {
				g.res[idx] = limit - (run_sum - g.res[idx]);
				run_sum = limit;
			}
		}
		out.i = run_sum;
	}
	out
}
@end
