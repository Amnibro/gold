fn ${ID}_cmp(g Gold&, idx int, d int) int {
	if d <= 0 || idx >= g.n { return 0; }
	let val, hit = gold_cache_get(g, idx);
	g.steps++;
	return 1 + ${ID}_cmp(g, idx + 1, d - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d > g.n {
		gold_fail(g, "invalid memo comparison depth");
		out.ok = false;
		return out;
	}
	let inspected = ${ID}_cmp(g, 0, d);
	out.i = inspected;
	out.s.clear();
	format(out.s, "compared memo recursively steps ", inspected);
	out
}
@end
