fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in uc {
			if u[j] == val { seen = true; break; }
		}
		if !seen && uc < 64 {
			u[uc] = val;
			uc++;
		}
	}
	if uc == g.n {
		gold_fail(g, "history already fully unique");
		out.ok = false;
	}
	g.n = uc;
	for i in uc {
		g.res[i] = u[i];
	}
	g.steps += uc;
	out.i = uc;
	out.s.clear();
	format(out.s, "applied unique history count ", uc);
	out
}
@end
