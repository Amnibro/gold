@entry 08304824ccaf69bc
kind: step
verb: find
noun: errors
modifier: all
context: stats
phrase: find sample errors all {margin}
phrase: count distribution errors all {margin}
slot: margin int
test: list=10,10,10,100 margin=20
expect: => i=4 r=0.0 ok=true s="error deviations count 4" errors=0 n=4 res=[10,10,10,100] cache=0 hits=0
test: list=10,12,14 margin=5
expect: => i=0 r=0.0 ok=true s="error deviations count 0" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let mean = sum / g.n;
	var err_count = 0;
	for i in g.n {
		var diff = g.res[i] - mean;
		if diff < 0 {
			diff = -diff;
		}
		if diff > m {
			err_count++;
		}
	}
	out.i = err_count;
	out.s.clear();
	format(out.s, "error deviations count ", err_count);
	out
}
@end
