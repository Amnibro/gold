fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var word_count = 0;
	var in_word = false;
	var cur_len = 0;
	for k in out.s.len {
		let b = out.s[k];
		if b == ' ' {
			if in_word {
				let prev, hit = gold_cache_get(g, cur_len);
				gold_cache_put(g, cur_len, prev + 1);
				word_count++;
				cur_len = 0;
				in_word = false;
			}
		} else {
			cur_len++;
			in_word = true;
		}
	}
	if in_word {
		let prev, hit = gold_cache_get(g, cur_len);
		gold_cache_put(g, cur_len, prev + 1);
		word_count++;
	}
	out.i = word_count;
	out.s.clear();
	format(out.s, "grouped ", word_count, " words into cache");
	g.steps += word_count;
	out
}
@end
