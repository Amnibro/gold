noun: tail
modifier: last
context: transform
phrase: limit tail keeping last {count} items
phrase: transform results retaining last {count} tail elements
slot: count int
test: list=1,2,3,4,5,6 count=3
expect: => i=3 r=0.0 ok=true s="limited tail 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20 count=5
expect: => i=2 r=0.0 ok=true s="limited tail 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	if c < g.n {
		let start = g.n - c;
		for i in c {
			g.res[i] = g.res[start + i];
		}
		g.n = c;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited tail ", g.n);
	out
}
@end
