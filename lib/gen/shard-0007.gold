@entry 714a36b6508185af
kind: step
verb: group
noun: text
modifier: in_reverse
context: format
phrase: group text in reverse with chunk size {chunk}
phrase: format text in reverse grouping by {chunk} characters
slot: chunk int
test: text="abcdef" chunk=2
expect: => i=8 r=0.0 ok=true s="fe.dc.ba" errors=0 n=0 res=[] cache=0 hits=0
test: text="12345" chunk=3
expect: => i=6 r=0.0 ok=true s="543.21" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	if sz <= 0 || out.s.len == 0 { return out; }
	var res byte[>..] = [];
	var i = out.s.len;
	var count = 0;
	while i > 0 {
		i--;
		if count > 0 && count % sz == 0 {
			res.push('.');
		}
		res.push(out.s[i]);
		count++;
	}
	out.s.clear();
	out.s.append(res);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
