fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_capacity};
	if g.n > mc {
		gold_fail(g, "list exceeds maximum capacity");
		out.ok = false;
	} else {
		for i in g.n {
			for j in i + 1 .. g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		out.i = g.n;
	}
	g.steps++;
	out
}
