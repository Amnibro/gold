fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w > 0 && g.n >= w {
		var new_n = 0;
		for i in (g.n - w + 1) {
			var sum = 0;
			for j in w {
				sum += g.res[i + j];
			}
			g.res[new_n] = sum;
			new_n++;
		}
		g.n = new_n;
		out.i = new_n;
	}
	out.s.clear();
	format(out.s, "windows ", out.i);
	out
}
@end
