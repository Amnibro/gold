fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowel_pairs = 0;
	if v.s.len >= 2 {
		for i in (v.s.len - 1) {
			let c1 = v.s[i];
			let c2 = v.s[i + 1];
			let is_v1 = (c1 == 'a' || c1 == 'e' || c1 == 'i' || c1 == 'o' || c1 == 'u');
			let is_v2 = (c2 == 'a' || c2 == 'e' || c2 == 'i' || c2 == 'o' || c2 == 'u');
			if is_v1 && is_v2 {
				vowel_pairs++;
			}
		}
	}
	if vowel_pairs == 0 {
		gold_fail(g, "no consecutive vowel error codes");
		out.ok = false;
	}
	g.steps += v.s.len;
	out.i = vowel_pairs;
	out.s.clear();
	format(out.s, "found pairwise vowels ", vowel_pairs);
	out
}
@end
