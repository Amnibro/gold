code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_run};
	if g.n == 0 { return out; }
	var valid_runs = 0;
	var cur_run = 1;
	for i in 1 .. g.n {
		if g.res[i] == g.res[i-1] {
			cur_run++;
		} else {
			if cur_run >= m { valid_runs++; }
			cur_run = 1;
		}
	}
	if cur_run >= m { valid_runs++; }
	gold_push(g, valid_runs);
	g.steps += g.n;
	out.i = valid_runs;
	out.s.clear();
	format(out.s, "applied runs at least threshold count ", valid_runs);
	out
}
@end
