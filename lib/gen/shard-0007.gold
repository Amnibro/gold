fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let prev, ok = gold_cache_get(g, 0);
	gold_cache_put(g, 0, avg);
	g.res[0] = prev;
	out.i = avg;
	g.steps += g.n;
	out
}
@end
