expect: => i=6 r=0.0 ok=true s="ran number recursively total steps 1" errors=0 n=2 res=[6,15] cache=0 hits=0
code:
fn ${ID}_cnt(g Gold&, d int) int {
	if d <= 0 || g.n == 0 { return 0; }
	g.res[0] += 1;
	g.steps++;
	return 1 + ${ID}_cnt(g, d - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d > 10 {
		gold_fail(g, "invalid depth for recursive number computation");
		out.ok = false;
		return out;
	}
	let total = ${ID}_cnt(g, d);
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "ran number recursively total steps ", total);
	out
}
@end
@entry 29c80bf4899e3332
kind: step
verb: repeat
noun: subfunction
modifier: sorted
context: text
phrase: repeat subfunction sorted {f}
phrase: reapply subfunction sorted {f}
slot: f fn
test: text="314" f=inc
expect: => i=6 r=0.0 ok=true s="sorted items 6" errors=0 n=6 res=[50,50,52,52,53,53] cache=0 hits=0
test: text="528" f=double
expect: => i=6 r=0.0 ok=true s="sorted items 6" errors=0 n=6 res=[100,100,106,106,112,112] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for b in out.s {
		let val = ${f}(b as int);
		gold_push(g, val);
		gold_push(g, val);
	}
	if g.n > 1 {
		for i in 1..g.n {
			var j = i;
			while j > 0 && g.res[j - 1] > g.res[j] {
				let tmp = g.res[j];
				g.res[j] = g.res[j - 1];
				g.res[j - 1] = tmp;
				j--;
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted items ", g.n);
	out
}
@end
