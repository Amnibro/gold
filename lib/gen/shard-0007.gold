expect: => i=3 r=0.0 ok=true s="matched pairwise letters in loop" errors=0 n=2 res=[1,2] cache=0 hits=0
test: text="cat" min_matches=1 list=1,2
expect: => i=0 r=0.0 ok=false s="error: pairwise letter matches below target" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_matches};
	if out.s.len < 2 || target <= 0 {
		gold_fail(g, "insufficient text length or invalid target");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid pairwise letter parameters");
		return out;
	}
	var matches = 0;
	let limit = out.s.len - 1;
	for k in limit {
		if out.s[k] == out.s[k + 1] {
			matches++;
		}
	}
	out.s.clear();
	if matches >= target {
		out.i = matches;
		out.ok = true;
		format(out.s, "matched pairwise letters in loop");
	} else {
		gold_fail(g, "pairwise letter matches below target");
		out.i = matches;
		out.ok = false;
		format(out.s, "error: pairwise letter matches below target");
	}
	g.steps += matches;
	out
}
@end
