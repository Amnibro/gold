fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached_odds = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			gold_cache_put(g, x, x * 2);
			cached_odds++;
			if g.cn >= 100 { break; }
		}
	}
	out.i = cached_odds;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached odds: ", cached_odds);
	out
}
@end
@entry 17999baf81e4beeb
kind: step
verb: measure
noun: step
modifier: while
context: cache
phrase: measure step while cache miss count under {max_misses}
phrase: evaluate step while cache misses below {max_misses}
slot: max_misses int
test: list=1,2,3,1,2 max_misses=3
expect: => i=3 r=0.0 ok=true s="steps while misses under limit: 3" errors=0 n=5 res=[1,2,3,1,2] cache=3 hits=0
test: list=10,20,30,40 max_misses=2
expect: => i=2 r=0.0 ok=true s="steps while misses under limit: 2" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mm = ${max_misses};
	var processed = 0;
	for k in g.n {
		let x = g.res[k];
		let _, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, x * 2);
		}
		processed++;
		if g.misses >= mm { break; }
	}
	out.i = processed;
	g.steps += processed;
	out.s.clear();
	format(out.s, "steps while misses under limit: ", processed);
	out
}
@end
