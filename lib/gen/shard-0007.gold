@entry 4dc97b23829d7af1
kind: step
verb: reverse
noun: checkpoint
modifier: recursively
context: error
phrase: reverse checkpoint recursively upon fatal error
phrase: rollback fault history to prior checkpoint marker
test: list=10,20,0,30,40
expect: => i=2 r=0.0 ok=true s="reversed to checkpoint: 2" errors=0 n=5 res=[20,10,0,30,40] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cp_idx = -1;
	for i in g.n {
		if g.res[i] == 0 {
			cp_idx = i;
			break;
		}
	}
	if cp_idx < 0 {
		gold_fail(g, "checkpoint marker missing");
		out.ok = false;
		return out;
	}
	var left = 0;
	var right = cp_idx - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += cp_idx + 1;
	out.i = cp_idx;
	out.s.clear();
	format(out.s, "reversed to checkpoint: ", cp_idx);
	out
}
@end
