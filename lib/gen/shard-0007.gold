@entry d02956dd4a5c56ac
kind: step
verb: rank
noun: maximum
modifier: nested
context: filter
phrase: rank maximum values across nested blocks of {window}
phrase: find nested maximum ranks with window span {window}
slot: window int
test: list=1,5,3,9,2,8 window=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,9,8] cache=0 hits=0
test: list=4,2,7,1,8,3 window=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i + w <= g.n {
		var mx = g.res[i];
		for j in 1..w {
			if g.res[i + j] > mx {
				mx = g.res[i + j];
			}
		}
		g.res[new_n] = mx;
		new_n++;
		i += w;
	}
	g.n = new_n;
	out.i = new_n;
	g.steps += g.n;
	out
}
@end
