test: list=10,3,10,7,4,1 limit=8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if x <= lim {
			var seen = false;
			for y in kept {
				if y == x {
				seen = true;
				break;
				}
			}
			if !seen {
				kept.push(x);
			}
		}
	}
	var i = 0;
	while i < kept.len {
		var j = 0;
		while j + 1 < kept.len - i {
			if kept[j] > kept[j + 1] {
				let t = kept[j];
				kept[j] = kept[j + 1];
				kept[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for y in kept {
		gold_push(g, y);
	}
	out.i = kept.len;
	g.steps += g.n * g.n;
	out
}
@end
