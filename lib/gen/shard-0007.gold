fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot sort empty range");
		out.ok = false;
	} else {
		for i in g.n {
			for j in i + 1 .. g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		out.i = g.res[0];
	}
	g.steps++;
	out
}
