@entry 5f656bbf33957ba7
kind: step
verb: sort
noun: gaps
modifier: unique
context: filter
phrase: sort unique gaps between consecutive numbers
phrase: collect sorted unique difference gaps
test: list=1,4,7,12
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=10,20,25,35
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps int[>..] = [];
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		var seen = false;
		for x in gaps {
			if x == d {
				seen = true;
				break;
			}
		}
		if !seen {
			gaps.push(d);
		}
		i++;
	}
	var k = 0;
	while k < gaps.len {
		var j = 0;
		while j + 1 < gaps.len - k {
			if gaps[j] > gaps[j + 1] {
				let t = gaps[j];
				gaps[j] = gaps[j + 1];
				gaps[j + 1] = t;
			}
			j++;
		}
		k++;
	}
	gold_clear(g);
	for x in gaps {
		gold_push(g, x);
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
