fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${ch};
	out.ok = false;
	out.i = -1;
	if out.s.len > 0 && target.len > 0 {
		let c = target[0];
		var k = 0;
		while k < out.s.len {
			let idx = out.s.len - 1 - k;
			if out.s[idx] == c {
				out.ok = true;
				out.i = idx;
				break;
			}
			k += 2;
		}
	}
	out.s.clear();
	format(out.s, "found ", out.ok);
	out
}
@end
