fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var delta = 0;
	if g.n >= 2 {
		delta = g.res[1] - g.res[0];
	}
	gold_push(g, delta);
	out.i = delta;
	out.ok = true;
	out.s.clear();
	format(out.s, "pushed delta ", delta, " to results");
	g.steps += 1;
	out
}
@end
