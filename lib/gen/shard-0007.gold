fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			matched++;
		} else {
			g.errors++;
		}
		i += 2;
	}
	if matched == 0 {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "paired retry conditions: ", matched);
