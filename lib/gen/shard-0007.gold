@entry 2b824916aa70a069
kind: step
verb: collect
noun: prefix
modifier: unique
context: error
phrase: collect unique error prefix elements
phrase: gather distinct fault prefix values
test: list=404,404,500,404,502
expect: => i=1 r=0.0 ok=true s="collected unique prefix of length 1" errors=0 n=1 res=[404] cache=0 hits=0
test: list=101,101,101,102
expect: => i=1 r=0.0 ok=true s="collected unique prefix of length 1" errors=0 n=1 res=[101] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty error sequence");
		out.ok = false;
		return out;
	}
	var u int[64] = [0; 64];
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in count {
			if u[j] == val {
				seen = true;
				break;
			}
		}
		if !seen && count < 64 {
			u[count] = val;
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	for i in count {
		g.res[i] = u[i];
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected unique prefix of length ", count);
	out
}
@end
