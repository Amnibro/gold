@entry b4287e2c254ea27e
kind: step
verb: find
noun: middle
modifier: unique
context: core
phrase: find middle element among unique values
phrase: locate median value among distinct elements
test: list=5,1,5,3,1
expect: => i=3 r=0.0 ok=true s="found middle unique value 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=9,2,9,7
expect: => i=7 r=0.0 ok=true s="found middle unique value 7" errors=0 n=3 res=[2,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	var uniq int[512] = [0; 512];
	var nu = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for i in nu {
			if uniq[i] == x { seen = true; break; }
		}
		if !seen {
			uniq[nu] = x;
			nu++;
		}
	}
	for i in nu {
		for j in i + 1..nu {
			if uniq[j] < uniq[i] {
				let tmp = uniq[i];
				uniq[i] = uniq[j];
				uniq[j] = tmp;
			}
		}
	}
	for k in nu { g.res[k] = uniq[k]; }
	g.n = nu;
	let mid = uniq[nu / 2];
	out.i = mid;
	out.s.clear();
	format(out.s, "found middle unique value ", mid);
	g.steps += g.n;
	out
}
@end
