	let exp = ${expected};
	var count = 0;
	var i = out.s.len - 1;
	while i >= 0 {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			count++;
		}
		i--;
	}
	out.i = count;
	if count == exp {
		out.ok = true;
	} else {
		gold_fail(g, "vowel count mismatch in reverse");
		out.ok = false;
	}
	g.steps += out.s.len;
	out
}
@end
