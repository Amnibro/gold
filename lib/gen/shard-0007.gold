@entry 53a347fd2de1d190
kind: step
verb: group
noun: threshold
modifier: in_reverse
context: filter
phrase: group threshold elements inspecting in reverse
phrase: partition values above threshold backwards from end
slot: limit int
test: list=5,15,8,20,12 limit=10
expect: => i=3 r=0.0 ok=true s="grouped threshold in reverse" errors=0 n=5 res=[12,20,15,8,5] cache=0 hits=0
test: list=1,2,3 limit=5
expect: => i=0 r=0.0 ok=true s="grouped threshold in reverse" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${limit};
	var above int[128] = [0; 128];
	var below int[128] = [0; 128];
	var n_above = 0;
	var n_below = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if x >= th {
			above[n_above] = x;
			n_above++;
		} else {
			below[n_below] = x;
			n_below++;
		}
		idx--;
	}
	for i in n_above {
		g.res[i] = above[i];
	}
	for i in n_below {
		g.res[n_above + i] = below[i];
	}
	g.steps += g.n * 2;
	out.i = n_above;
	out.s.clear();
	format(out.s, "grouped threshold in reverse");
	out
}
@end
