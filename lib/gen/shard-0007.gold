slot: limit int
test: text="banana split" limit=2
expect: => i=2 r=0.0 ok=true s="banan splt" errors=0 n=0 res=[] cache=0 hits=0
test: text="aeiou world" limit=3
expect: => i=3 r=0.0 ok=true s="aei wrld" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var vowels = 0;
	var res byte[>..] = [];
	for c in out.s {
		let is_v = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
		if is_v {
			if vowels < lim {
				res.push(c);
				vowels++;
			}
		} else {
			res.push(c);
		}
	}
	out.s.clear();
	for c in res {
		if out.s.len < 200 {
			out.s.push(c);
		}
	}
	out.i = vowels;
	g.steps += out.s.len;
	out
}
@end
