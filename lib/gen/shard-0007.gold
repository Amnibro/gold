	var write_idx = 0;
	for k in g.n {
		if g.res[k] < th {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps++;
	out.i = write_idx;
	out
}
@end
