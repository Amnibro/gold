	let delim = ${ch};
	var ok = true;
	var count = 0;
	for i in v.s.len {
		let b = v.s[i] as int;
		if b == delim { break; }
		if b < 32 || b > 126 { ok = false; break; }
		count++;
	}
	g.steps += count;
	out.ok = ok;
	out.i = count;
	out.s.clear();
	format(out.s, "validated text until delimiter: ", count);
	out
}
