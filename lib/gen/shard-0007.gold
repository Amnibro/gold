@entry 835e5648ac63a869
kind: step
verb: reverse
noun: average
modifier: until
context: text
phrase: reverse average until running code exceeds {threshold}
phrase: invert characters prefix until average exceeds {threshold}
slot: threshold int
test: text="abcdef" threshold=100
expect: => i=6 r=0.0 ok=true s="fedcba" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyzabc" threshold=110
expect: => i=1 r=0.0 ok=true s="xyzabc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var sum = 0;
	var k = 0;
	while k < out.s.len {
		sum += out.s[k] as! int;
		k++;
		if sum / k >= thresh { break; }
	}
	if k > 1 {
		var i = 0;
		var j = k - 1;
		while i < j {
			let tmp = out.s[i];
			out.s[i] = out.s[j];
			out.s[j] = tmp;
			i++;
			j--;
		}
	}
	out.i = k;
	g.steps += k;
	out
}
@end
