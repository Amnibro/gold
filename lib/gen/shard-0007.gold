@entry cd4462d4f06943d9
kind: step
verb: fold
noun: item
modifier: sorted
context: cache
phrase: fold item sorted using starting value {init}
phrase: fold item sorted accumulating from base {init}
slot: init int
test: list=3,1,2 init=10
expect: => i=16 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=3 hits=0
test: list=5,2,4 init=20
expect: => i=31 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${init};
	for i in g.n {
		for j in i + 1 .. g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var acc = base;
	for k in g.n {
		acc += g.res[k];
		gold_cache_put(g, k, acc);
	}
	g.steps++;
	out.i = acc;
	out
}
@end
@entry a68a75c46b40db5f
kind: step
verb: fold
noun: minimum
modifier: every_other
context: cache
phrase: fold minimum every other skipping by stride {stride}
phrase: fold minimum every other alternating step {stride}
slot: stride int
test: list=10,2,30,1,50 stride=2
expect: => i=10 r=0.0 ok=true s="" errors=0 n=5 res=[10,2,30,1,50] cache=3 hits=0
test: list=7,15,3,9 stride=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[7,15,3,9] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if g.n == 0 || st <= 0 {
		g.steps++;
		return out;
	}
	var min_val = g.res[0];
	var idx = 0;
	while idx < g.n {
		if g.res[idx] < min_val {
			min_val = g.res[idx];
		}
		gold_cache_put(g, idx, min_val);
		idx += st;
	}
	g.steps++;
	out.i = min_val;
	out
}
@end
@entry 742738d0cefb847c
kind: step
