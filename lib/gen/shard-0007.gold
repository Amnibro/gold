code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	if x < 0 { x = -x; }
	if x == 0 {
		gold_push(g, 0);
	} else {
		var rev = 0;
		var cnt = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x = x / 10;
			cnt++;
		}
		for k in cnt {
			gold_push(g, rev % 10);
			rev = rev / 10;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
