@entry 18adf1e4d628a43e
kind: step
verb: dedupe
noun: subfunction
modifier: sorted
context: text
phrase: dedupe subfunction sorted {f}
phrase: prune subfunction sorted {f}
slot: f fn
test: text="cba" f=inc
expect: => i=3 r=0.0 ok=true s="unique 3" errors=0 n=3 res=[98,99,100] cache=0 hits=0
test: text="feed" f=double
expect: => i=3 r=0.0 ok=true s="unique 3" errors=0 n=3 res=[200,202,204] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for b in out.s {
		let val = ${f}(b as int);
		gold_push(g, val);
	}
	if g.n > 1 {
		for i in 1..g.n {
			var j = i;
			while j > 0 && g.res[j - 1] > g.res[j] {
				let tmp = g.res[j];
				g.res[j] = g.res[j - 1];
				g.res[j - 1] = tmp;
				j--;
			}
		}
		var w = 1;
		for i in 1..g.n {
			if g.res[i] != g.res[w - 1] {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique ", g.n);
	out
}
@end
