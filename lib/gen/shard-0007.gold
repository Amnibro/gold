code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz > 0 && sz < g.n {
		let rem = g.n - sz;
		for k in rem {
			g.res[k] = g.res[sz + k];
		}
		g.n = rem;
	} else if sz >= g.n {
		g.n = 0;
	}
	g.steps++;
	out.i = g.n;
	out
}
@end
