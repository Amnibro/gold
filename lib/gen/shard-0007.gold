code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let first_val = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first_val;
		gold_cache_put(g, first_val, g.n);
	}
	out.s.clear();
	format(out.s, "rotated results of length: ", g.n);
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
@entry e1520f70c033c57e
kind: step
verb: search
noun: step
modifier: at_most
context: format
phrase: search steps with difference at most {max_diff}
phrase: count adjacent step transitions bounded at most by {max_diff}
slot: max_diff int
test: list=2,5,9,11 max_diff=3
expect: => i=2 r=0.0 ok=true s="steps within difference: 2" errors=0 n=4 res=[2,5,9,11] cache=0 hits=0
test: list=1,10,20 max_diff=5
expect: => i=0 r=0.0 ok=true s="steps within difference: 0" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		var d = g.res[i + 1] - g.res[i];
		if d < 0 { d = -d; }
		if d <= md {
			count++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "steps within difference: ", count);
	out.i = count;
	g.steps += g.n;
	out
}
@end
