fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_rot};
	if g.n == 0 || m <= 0 { return out; }
	let r = m % g.n;
	if r == 0 { return out; }
	var tmp int[512] = [0; 512];
	for i in g.n { tmp[i] = g.res[(i + r) % g.n]; }
	for i in g.n { g.res[i] = tmp[i]; }
	g.steps += g.n;
	out.i = r;
	out.s.clear();
	format(out.s, "rotated retry steps count: ", r);
	out
}
@end
