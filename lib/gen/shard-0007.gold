phrase: drop step elements until sequence is sorted
phrase: prune steps to ensure sorted order
test: list=1,5,3,7,2,8
expect: => i=2 r=0.0 ok=true s="dropped 2 unsorted step items" errors=0 n=4 res=[1,5,7,8] cache=0 hits=0
