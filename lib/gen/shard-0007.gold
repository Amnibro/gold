fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	let tgt = ${target};
	var qualifying = 0;
	if g.n >= w && w > 0 {
		let count = g.n - w + 1;
		for i in count {
			var sum = 0;
			for j in w {
				sum += g.res[i + j];
			}
			if sum >= tgt { qualifying++; }
		}
	}
	out.i = qualifying;
	out.s.clear();
	format(out.s, "count ", qualifying);
	out
}
@end
