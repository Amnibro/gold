@entry c79cc2d133a0bd2f
kind: step
verb: keep
noun: average
modifier: safely
context: sort
phrase: keep average safely retaining values within delta {delta}
phrase: filter average safely pruning items beyond {delta}
slot: delta int
test: list=10,12,14,16,18,30 delta=5
expect: => i=4 r=0.0 ok=true s="kept around average: 4" errors=0 n=4 res=[12,14,16,18] cache=0 hits=0
test: list=1,2,3,4,5 delta=1
expect: => i=3 r=0.0 ok=true s="kept around average: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n == 0 { return out; }
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var kept = 0;
	for k in g.n {
		let diff = g.res[k] - avg;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= d {
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept around average: ", kept);
	out
}
@end
