fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bins int[10] = [0; 10];
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		if val >= 0 {
			let b = val / 10;
			if b < 10 {
				bins[b]++;
			}
		}
		i += 2;
	}
	var max_freq = 0;
	for b in 10 {
		if bins[b] > max_freq {
			max_freq = bins[b];
		}
	}
	out.i = max_freq;
	out.s.clear();
	format(out.s, "histogram peak every_other ", max_freq);
	out
}
@end
@entry 5282fc0473c8c23f
kind: step
verb: compare
noun: minimum
modifier: every_other
context: stats
phrase: compare sample minimum every_other
phrase: match distribution minimum every_other
test: list=1,10,3,15
expect: => i=-9 r=0.0 ok=true s="even min smaller true" errors=0 n=4 res=[1,10,3,15] cache=0 hits=0
test: list=20,5,30,8
expect: => i=15 r=0.0 ok=false s="even min smaller false" errors=0 n=4 res=[20,5,30,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var min_even = g.res[0];
	var min_odd = g.res[1];
	var i = 0;
	while i < g.n {
		if g.res[i] < min_even {
			min_even = g.res[i];
		}
		if i + 1 < g.n && g.res[i + 1] < min_odd {
			min_odd = g.res[i + 1];
		}
		i += 2;
	}
	out.ok = (min_even < min_odd);
	out.i = min_even - min_odd;
	out.s.clear();
	format(out.s, "even min smaller ", out.ok);
	out
}
@end
@entry 48355bddd8990f06
kind: step
