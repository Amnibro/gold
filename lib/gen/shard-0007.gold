fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let lim = if cnt < g.n { cnt } else { g.n };
	var primes = 0;
	for i in lim {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	out.i = primes;
	g.steps += lim;
	out
}
@end
