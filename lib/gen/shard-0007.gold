@entry e6addd7ea7d26a55
kind: step
verb: keep
noun: gaps
modifier: pairwise
context: math
phrase: replace sequence with adjacent pairwise differences
phrase: calculate pairwise differences between math elements
phrase: compute adjacent pairwise gaps sequence
test: list=10,25,30,50
expect: => i=3 r=0.0 ok=true s="computed pairwise gaps: 3" errors=0 n=3 res=[15,5,20] cache=0 hits=0
test: list=2,5,9,14
expect: => i=3 r=0.0 ok=true s="computed pairwise gaps: 3" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff >= 0 { diff } else { -diff };
	}
	g.n--;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed pairwise gaps: ", g.n);
	g.steps += g.n;
	out
}
@end
