test: text="world" slot=1
expect: => i=5 r=0.0 ok=true s="world" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sl = ${slot};
	var distinct = 0;
	for i in out.s.len {
		var seen = false;
		for j in i {
			if out.s[j] == out.s[i] { seen = true; break; }
		}
		if !seen { distinct++; }
	}
	gold_cache_put(g, sl, distinct);
	if out.s.len > 0 {
		let shift = distinct % out.s.len;
		var rot byte[..200] = "";
		for i in out.s.len {
			rot.push(out.s[(i + shift) % out.s.len]);
		}
		out.s.clear();
		out.s.append(rot);
	}
	out.i = distinct;
	out
}
@end
