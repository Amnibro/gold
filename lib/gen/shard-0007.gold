@entry d6d0c622768fefb9
kind: step
verb: rotate
noun: number
modifier: in_place
context: filter
phrase: rotate number sequence in place by shift {shift}
phrase: cycle numbers in place using offset {shift}
slot: shift int
test: list=1,2,3,4,5 shift=1
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
test: list=10,20,30,40 shift=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 {
		let eff = (s % g.n + g.n) % g.n;
		for step in eff {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
