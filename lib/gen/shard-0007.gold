code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for gap swap");
		out.ok = false;
		return out;
	}
	var swaps = 0;
	for i in 0..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= 15 {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			break;
		}
	}
	if swaps == 0 {
		gold_fail(g, "no gap met minimum threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped wide gap: ", swaps);
	out
}
@end
