code:
fn ${ID}(n int) bool {
	if n <= 1 {
		return false;
	}
	if n <= 3 {
		return true;
	}
	if n % 2 == 0 || n % 3 == 0 {
		return false;
	}
	var d = 5;
	while d * d <= n {
		if n % d == 0 || n % (d + 2) == 0 {
			return false;
		}
		d = d + 6;
	}
	return true;
}
@end
