test: list=500,200,404,100 pivot=300
expect: => i=2 r=0.0 ok=true s="split values in place at 300" errors=0 n=4 res=[200,100,500,404] cache=0 hits=0
test: list=10,20,30 pivot=50
expect: => i=3 r=0.0 ok=true s="split values in place at 50" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var lo int[128] = [0; 128];
	var hi int[128] = [0; 128];
	var lc = 0;
	var hc = 0;
	for i in g.n {
		if g.res[i] < p {
			if lc < 128 { lo[lc] = g.res[i]; lc++; }
		} else {
			if hc < 128 { hi[hc] = g.res[i]; hc++; }
		}
	}
	if hc > lc {
		gold_fail(g, "high severity faults dominate");
		out.ok = false;
	}
	for i in lc { g.res[i] = lo[i]; }
	for i in hc { g.res[lc + i] = hi[i]; }
	g.steps += g.n;
	out.i = lc;
	out.s.clear();
	format(out.s, "split values in place at ", p);
	out
}
@end
