code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let group_len = ${k};
	if group_len <= 0 || group_len >= out.s.len { return out; }
	var formatted byte[>..] = [];
	for i in group_len {
		formatted.push(out.s[i]);
	}
	formatted.push('-');
	for i in group_len .. out.s.len {
		formatted.push(out.s[i]);
	}
	out.s.clear();
	out.s.append(formatted);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
