code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	for i in g.n {
		for j in (g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "grouped retry steps sorted min ", g.res[0]);
	out
}
