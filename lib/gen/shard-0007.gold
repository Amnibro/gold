verb: reverse
noun: window
modifier: each
context: aggregate
phrase: reverse each window of length {k} summing results
phrase: aggregate reversed window segments of span {k}
slot: k int
test: list=1,2,3,4 k=2
expect: => i=14 r=0.0 ok=true s="reversed window each sum 14" errors=0 n=5 res=[1,2,3,4,14] cache=0 hits=0
test: list=10,20,30,40,50 k=3
expect: => i=230 r=0.0 ok=true s="reversed window each sum 230" errors=0 n=6 res=[10,20,30,40,50,230] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${k};
	if w <= 0 || g.n == 0 { return out; }
	var sum = 0;
	var i = 0;
	while i < g.n {
		let lim = if i + w < g.n { i + w } else { g.n };
		var j = lim;
		var factor = 1;
		while j > i {
			j--;
			sum += g.res[j] * factor;
			factor++;
		}
		i += w;
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed window each sum ", sum);
	out
}
@end
