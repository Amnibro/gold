@entry eab8a2243b323b84
kind: step
verb: return
noun: duplicates
modifier: at_most
context: format
phrase: return duplicate items at most up to ceiling {max_dups}
phrase: format duplicate entries at most bounded by count {max_dups}
slot: max_dups int
test: list=1,2,2,3,3,3 max_dups=2
expect: => i=2 r=0.0 ok=true s="duplicates bounded: [2, 3]" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=5,5,5 max_dups=1
expect: => i=1 r=0.0 ok=true s="duplicates bounded: [5]" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dups};
	var dups int[>..] = [];
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if seen_before && dups.len < md {
			dups.push(x);
		}
	}
	out.s.clear();
	format(out.s, "duplicates bounded: [");
	var first = true;
	for d in dups {
		if !first { format(out.s, ", "); }
		format(out.s, d);
		first = false;
	}
	format(out.s, "]");
	out.i = dups.len;
	g.steps += g.n * g.n;
	out
}
@end
