fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		out.s.append("computed 0 pairwise sums");
		return out;
	}
	let np = g.n - 1;
	var i = 0;
	while i < np {
		g.res[i] = g.res[i] + g.res[i + 1];
		i += 1;
	}
	g.n = np;
	out.i = np;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed ", np, " pairwise sums");
	g.steps += np;
	out
}
@end
