code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_dup = -1;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				first_dup = g.res[i];
				g.errors++;
				break;
			}
		}
		if first_dup >= 0 {
			break;
		}
	}
	if first_dup < 0 {
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = first_dup;
	out.s.clear();
	format(out.s, "first duplicate fault: ", first_dup);
	out
}
@end
