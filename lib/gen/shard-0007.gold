fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var total_gap = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = core_abs_val(g.res[i+1] - g.res[i]);
		total_gap += gap;
		i += 2;
	}
	gold_push(g, total_gap);
	g.steps += g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "grouped every other gap sum ", total_gap);
	out
}
@end
