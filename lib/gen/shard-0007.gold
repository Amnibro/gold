		let idx = g.n - 1 - k;
		if g.res[idx] % 2 != 0 {
			let val = g.res[idx] * sc;
			gold_cache_put(g, odds, val);
			odds++;
		}
	}
	g.steps++;
	out.i = odds;
	out
}
