code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sz = ${max_size};
	if sz <= 0 { sz = 1; }
	var chunk_count = 0;
	var chunks int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		var sum = 0;
		for k in 0..sz {
			if i + k < g.n {
				sum += g.res[i + k];
			}
		}
		chunks[chunk_count] = sum;
		chunk_count++;
		i += sz;
	}
	for k in chunk_count {
		g.res[k] = chunks[k];
	}
	g.n = chunk_count;
	out.i = chunk_count;
	out.s.clear();
	format(out.s, "grouped into ", chunk_count, " chunks");
	g.steps += g.n;
	out
}
@end
