code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let sq_limit = c * c;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] > sq_limit {
			g.res[i] = sq_limit;
			clamped++;
		}
	}
	g.steps += g.n * g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited sorted items to square cap");
	out
}
@end
