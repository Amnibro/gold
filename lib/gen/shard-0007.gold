@entry 0bdfe0023b12e32a
kind: step
verb: pair
noun: threshold
modifier: pairwise
context: cache
phrase: pair threshold pairwise caching products exceeding {lim}
phrase: match threshold pairwise items memoizing over {lim}
slot: lim int
test: list=2,5,3,8 lim=10
expect: => i=2 r=0.0 ok=true s="cached threshold pairs: 2" errors=0 n=4 res=[2,5,3,8] cache=2 hits=0
test: list=1,2,3,4 lim=20
expect: => i=0 r=0.0 ok=true s="cached threshold pairs: 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	if g.n < 2 { return out; }
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let prod = g.res[i] * g.res[i + 1];
		if prod >= limit {
			gold_cache_put(g, i, prod);
			pairs++;
		}
		i += 2;
	}
	out.i = pairs;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached threshold pairs: ", pairs);
	out
}
@end
