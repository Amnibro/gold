test: list=1,1,3,3,3,3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals = [0; 512];
	var lens = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == x { j++; }
		vals[count] = x;
		lens[count] = j - i;
		count++;
		i = j;
	}
	g.n = 0;
	for k in count {
		gold_push(g, vals[k]);
		gold_push(g, lens[k]);
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
