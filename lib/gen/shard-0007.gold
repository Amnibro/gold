fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_code};
	var changed = 0;
	for i in out.s.len {
		let code = out.s[i] as! int;
		if out.s[i] >= 'a' && out.s[i] <= 'z' && code >= min_c {
			out.s[i] = (code - 32) as! byte;
			changed++;
		}
	}
	out.i = changed;
	g.steps += out.s.len;
	out
}
@end
