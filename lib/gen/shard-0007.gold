kind: step
verb: dedupe
noun: number
modifier: up_to
context: format
phrase: dedupe numbers up to upper bound {bound} into formatted list
phrase: format unique numbers up to ceiling {bound} into string
slot: bound int
test: list=5,10,5,20,15 bound=12
expect: => i=2 r=0.0 ok=true s="bounded unique list: [5, 10]" errors=0 n=5 res=[5,10,5,20,15] cache=0 hits=0
test: list=1,2,2,3,4 bound=2
expect: => i=2 r=0.0 ok=true s="bounded unique list: [1, 2]" errors=0 n=5 res=[1,2,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var kept int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if x <= b {
			var seen = false;
			for u in kept {
				if u == x { seen = true; break; }
			}
			if !seen { kept.push(x); }
		}
	}
	out.s.clear();
	format(out.s, "bounded unique list: [");
	var first = true;
	for u in kept {
		if !first { format(out.s, ", "); }
		format(out.s, u);
		first = false;
	}
	format(out.s, "]");
	out.i = kept.len;
	g.steps += g.n;
	out
}
@end
