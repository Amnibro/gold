code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] % 2 == 0 {
			g.res[idx] = g.res[idx] * 2;
			shifted++;
		}
		idx--;
	}
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted even elements backwards");
	out
}
@end
