@entry 80bc5aa22edea4a9
kind: step
verb: validate
noun: loop
modifier: with_retry
context: filter
phrase: validate loop condition with retry count {retries}
phrase: verify loop state allowing retries up to {retries}
slot: retries int
test: list=2,4,6 retries=2
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=-1,2 retries=1
expect: => i=-1 r=0.0 ok=false s="" errors=1 n=2 res=[-1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var valid = false;
	var tries = 0;
	while tries <= r {
		var all_pos = true;
		for k in g.n {
			if g.res[k] <= 0 {
				all_pos = false;
				break;
			}
		}
		if all_pos {
			valid = true;
			break;
		}
		tries++;
	}
	out.ok = valid;
	if valid {
		out.i = tries;
	} else {
		gold_fail(g, "loop validation failed after retries");
		out.i = -1;
	}
	g.steps += tries + 1;
	out
}
@end
