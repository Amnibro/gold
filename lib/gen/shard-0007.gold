code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n && !${p}(g.res[idx]) {
		idx++;
	}
	let dropped = idx;
	for i in (g.n - idx) {
		g.res[i] = g.res[i + idx];
	}
	g.n -= idx;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped retry errors until predicate");
	out
}
@end
