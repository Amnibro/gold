		gold_fail(g, "sequence too short to invert");
		out.ok = false;
		return out;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[1];
	g.res[1] = tmp;
	g.steps += 2;
	out.i = g.res[0];
