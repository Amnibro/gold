fn ${ID}_nested(g Gold&, d int) int {
	if d <= 0 || g.n == 0 { return 0; }
	g.res[0] += 5;
	g.steps++;
	return 1 + ${ID}_nested(g, d - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d > 10 {
		gold_fail(g, "invalid depth for nested retry steps");
		out.ok = false;
		return out;
	}
	let ran = ${ID}_nested(g, d);
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "ran nested retry steps ", ran);
	out
}
@end
