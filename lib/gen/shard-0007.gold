test: list=2,4,3,6,5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[5,4,2,6,3] cache=0 hits=0
test: list=7,8,9,11
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[11,8,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_indices int[>..] = [];
	for k in g.n {
		if core_is_prime(g.res[k]) {
			prime_indices.push(k);
		}
	}
	if prime_indices.len > 1 {
		let last_idx = prime_indices[prime_indices.len - 1];
		let last_val = g.res[last_idx];
		var i = prime_indices.len - 1;
		while i > 0 {
			let curr = prime_indices[i];
			let prev = prime_indices[i - 1];
			g.res[curr] = g.res[prev];
			i--;
		}
		g.res[prime_indices[0]] = last_val;
	}
	out.i = prime_indices.len;
	g.steps += g.n;
	out
}
@end
