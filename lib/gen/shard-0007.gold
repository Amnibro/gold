@entry d923011beab7f4bc
kind: step
verb: run
noun: primes
modifier: in_reverse
context: transform
phrase: run prime filter reordering in reverse
phrase: transform sequence retaining primes in reverse order
test: list=4,5,6,7,8,9,11
expect: => i=3 r=0.0 ok=true s="primes reversed 3" errors=0 n=3 res=[11,7,5] cache=0 hits=0
test: list=12,14,15,16
expect: => i=0 r=0.0 ok=true s="primes reversed 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var is_p = false;
		if x >= 2 {
			is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			buf[count] = x;
			count++;
		}
		i--;
	}
	for k in count { g.res[k] = buf[k]; }
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "primes reversed ", count);
	out
}
@end
