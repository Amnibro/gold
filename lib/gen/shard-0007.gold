phrase: flip trailing observations in_place count {k}
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 k=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${k};
	if cnt <= 1 || g.n <= 1 { return out; }
	let lim = if cnt < g.n { cnt } else { g.n };
	let start = g.n - lim;
	var i = start;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = lim;
	g.steps += lim;
	out
}
@end
