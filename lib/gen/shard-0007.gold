fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var new_n = 0;
	for i in g.n {
		if g.res[i] <= ceil && core_is_prime(g.res[i]) {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "kept primes up to ceiling count ", new_n);
	out
}
@end
