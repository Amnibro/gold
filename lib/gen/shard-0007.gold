kind: step
verb: clamp
noun: tally
modifier: pairwise
context: retry
phrase: clamp tally pairwise differences to ceiling {ceil}
phrase: restrict pairwise retry tally gaps under {ceil}
slot: ceil int
test: list=10,35,20,60 ceil=15
expect: => i=2 r=0.0 ok=true s="clamped pairwise differences count: 2" errors=0 n=4 res=[10,25,20,35] cache=0 hits=0
test: list=5,30,12,18 ceil=10
expect: => i=1 r=0.0 ok=true s="clamped pairwise differences count: 1" errors=0 n=4 res=[5,15,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceil};
	var clamped = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > limit {
			g.res[i + 1] = g.res[i] + limit;
			clamped++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped pairwise differences count: ", clamped);
	out
}
@end
