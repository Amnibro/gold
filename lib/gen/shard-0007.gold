kind: step
verb: group
noun: primes
modifier: with_cache
context: sort
phrase: group primes with_cache {key}
phrase: partition primes with_cache {key}
slot: key int
test: list=4,7,2,9,5 key=10
expect: => i=3 r=0.0 ok=true s="grouped primes count 3" errors=0 n=5 res=[2,5,7,4,9] cache=1 hits=0
test: list=6,8,11 key=20
expect: => i=1 r=0.0 ok=true s="grouped primes count 1" errors=0 n=3 res=[11,6,8] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var primes int[64] = [0; 64];
	var non_primes int[64] = [0; 64];
	var pc = 0;
	var npc = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			if pc < 64 { primes[pc] = g.res[i]; pc++; }
		} else {
			if npc < 64 { non_primes[npc] = g.res[i]; npc++; }
		}
	}
	for i in pc {
		for j in pc - 1 {
			if primes[j] > primes[j + 1] {
				let t = primes[j]; primes[j] = primes[j + 1]; primes[j + 1] = t;
			}
		}
	}
	gold_clear(g);
	for i in pc { gold_push(g, primes[i]); }
	for i in npc { gold_push(g, non_primes[i]); }
	gold_cache_put(g, k, pc);
	out.i = pc;
	out.s.clear();
	format(out.s, "grouped primes count ", pc);
	out
}
@end
