context: filter
phrase: collect prime numbers pairwise across adjacent elements
phrase: filter adjacent elements keeping pairs summing to primes
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="collected prime pair sums" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="collected prime pair sums" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	for i in g.n - 1 {
		let sum = g.res[i] + g.res[i + 1];
		if core_is_prime(sum) {
			g.res[new_n] = sum;
			new_n++;
		}
	}
	g.n = new_n;
	g.steps += g.n * 2 + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "collected prime pair sums");
	out
}
@end
@entry 98f482c81e5aae9a
kind: step
