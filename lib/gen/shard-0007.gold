expect: => i=3 r=0.0 ok=true s="symmetric pairs: 3" errors=0 n=6 res=[1,3,7,7,3,1] cache=0 hits=0
test: list=1,2,5,9,8
expect: => i=2 r=0.0 ok=false s="symmetric pairs: 2" errors=0 n=5 res=[1,2,5,9,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sym = true;
	var l = 0;
	var r = g.n - 1;
	var count = 0;
	while l < r {
		if g.res[l] != g.res[r] { sym = false; }
		l++;
		r--;
		count++;
	}
	out.ok = sym;
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "symmetric pairs: ", count);
	out
}
@end
