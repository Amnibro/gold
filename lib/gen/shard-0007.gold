		gold_cache_put(g, i, g.res[i] + g.res[i + 1]);
		pairs++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired cached faults: ", pairs);
	out
}
