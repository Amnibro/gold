code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_err};
	var dupes = 0;
	var res byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in res.len {
			if res[j] == b { seen = true; break; }
		}
		if seen {
			dupes++;
		} else {
			res.push(b);
		}
	}
	if dupes > limit {
		gold_fail(g, "dedupe errors: limit exceeded");
	}
	out.s.clear();
	out.s.append(res);
	out.i = dupes;
	out
}
@end
