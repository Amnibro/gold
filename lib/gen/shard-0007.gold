expect: => i=4 r=0.0 ok=true s="deduped max: 4 count: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mx = 0;
	for k in g.n {
		if g.res[k] > mx { mx = g.res[k]; }
	}
	var kept int[>..] = [];
	var max_seen = false;
	for k in g.n {
		let x = g.res[k];
		if x == mx {
			if !max_seen {
				kept.push(x);
				max_seen = true;
			}
		} else {
			kept.push(x);
		}
	}
	out.s.clear();
	format(out.s, "deduped max: ", mx, " count: ", kept.len);
	out.i = kept.len;
	g.steps += g.n;
	out
}
@end
