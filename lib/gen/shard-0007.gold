		let i2 = p_pos[r];
		let tmp = d[i1];
		d[i1] = d[i2];
		d[i2] = tmp;
		l++;
		r--;
	}
	var res = 0;
	var j = len - 1;
	while j >= 0 {
		res = res * 10 + d[j];
		j--;
	}
	res
}
