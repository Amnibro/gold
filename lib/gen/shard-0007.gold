fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let last_val = g.res[g.n - 1];
	var matched = 0;
	for i in g.n - 1 {
		if g.res[i] == last_val {
			matched++;
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "compared suffix elements matched count ", matched);
	out
}
