test: list=9,2,3,4,1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,4,9] cache=0 hits=0
test: list=7,6,5,4,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[3,6,5,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[>..] = [];
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds.push(g.res[k]);
		}
	}
	var i = 0;
	while i < odds.len {
		var j = 0;
		while j + 1 < odds.len - i {
			if odds[j] > odds[j + 1] {
				let t = odds[j];
				odds[j] = odds[j + 1];
				odds[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	var o_idx = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			g.res[k] = odds[o_idx];
			o_idx++;
		}
	}
	out.i = odds.len;
	g.steps += g.n * g.n;
	out
}
@end
