@entry b5f7d53b5eb28e1b
kind: step
verb: split
noun: duplicates
modifier: none
context: filter
phrase: split duplicates none removing duplicate entries plus {bias}
phrase: split duplicates none deduplicating elements with {bias}
slot: bias int
test: list=3,3,5,5,7 bias=1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,6,8] cache=0 hits=0
test: list=1,2,3 bias=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n == 0 {
		g.steps++;
		return out;
	}
	var write_idx = 1;
	var k = 1;
	while k < g.n {
		if g.res[k] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
		k++;
	}
	g.n = write_idx;
	for i in g.n {
		g.res[i] += b;
	}
	g.steps++;
	out.i = g.n;
	out
}
@end
