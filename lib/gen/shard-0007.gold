fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var upper byte[..200] = "";
	var lower byte[..200] = "";
	var count = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c >= 'A' && c <= 'Z' {
			upper.push(c);
			count++;
		} else {
			lower.push(c);
		}
	}
	out.s.clear();
	out.s.append(upper);
	out.s.append(lower);
	out.i = count;
	g.steps += out.s.len;
	out
}
