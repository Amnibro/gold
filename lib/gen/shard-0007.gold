fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	format(out.s, "unique: ");
	var unique_count = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			if unique_count > 0 { format(out.s, ","); }
			format(out.s, g.res[i]);
			unique_count++;
		}
	}
	gold_push(g, unique_count);
	g.steps += g.n * g.n;
	out.i = unique_count;
	out
}
