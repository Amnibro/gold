@entry 35e7f451b3b55d68
kind: step
verb: retry
noun: runs
modifier: up_to
context: list
phrase: retry runs up_to max count {limit} using {f}
phrase: transform consecutive runs up_to size {limit} with {f}
slot: f fn
slot: limit int
test: list=2,2,4,4,4,6 limit=2 f=inc
expect: => i=3 r=0.0 ok=true s="updated short runs" errors=0 n=6 res=[3,3,4,4,4,7] cache=0 hits=0
test: list=5,5,5,7,7 limit=3 f=double
expect: => i=10 r=0.0 ok=true s="updated short runs" errors=0 n=5 res=[10,10,10,14,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 || lim <= 0 { return out; }
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len <= lim {
			for k in i..j { g.res[k] = ${f}(g.res[k]); }
		}
		i = j;
	}
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "updated short runs");
	g.steps += g.n;
	out
}
@end
