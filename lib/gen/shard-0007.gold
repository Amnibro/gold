@entry b9278d8a984f4a04
kind: step
verb: fill
noun: maximum
modifier: between
context: format
phrase: fill maximum element between range {start_idx} to {end_idx}
phrase: format range filling maximum value across {start_idx} through {end_idx}
slot: start_idx int
slot: end_idx int
test: list=1,5,2,4,3 start_idx=1 end_idx=3
expect: => i=5 r=0.0 ok=true s="filled maximum between range: 5" errors=0 n=5 res=[1,5,5,5,3] cache=0 hits=0
test: list=10,2,8,20 start_idx=0 end_idx=2
expect: => i=10 r=0.0 ok=true s="filled maximum between range: 10" errors=0 n=4 res=[10,10,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_idx};
	let e = ${end_idx};
	let lo = if s >= 0 && s < g.n { s } else { 0 };
	let hi = if e < g.n { e } else { g.n - 1 };
	if lo > hi { return out; }
	var max_val = g.res[lo];
	for i in lo .. hi + 1 {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	for i in lo .. hi + 1 {
		g.res[i] = max_val;
	}
	g.steps += hi - lo + 1;
	out.i = max_val;
	out.s.clear();
	format(out.s, "filled maximum between range: ", max_val);
	out
}
@end
