@entry 24c89e0e9f014c62
kind: step
verb: drop
noun: errors
modifier: until
context: retry
phrase: drop retry errors until condition {p} holds
phrase: discard failing retry attempts until {p}
slot: p pred
test: list=1,3,5,4,2 p=is_even
expect: => i=3 r=0.0 ok=true s="dropped retry errors until predicate" errors=0 n=2 res=[4,2] cache=0 hits=0
test: list=2,4,6,7 p=is_odd
