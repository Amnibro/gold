expect: => i=4 r=0.0 ok=true s="dupes 4" errors=0 n=10 res=[1,2,2,3,4,4,2,2,4,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="dupes 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig = g.n;
	var dupes = 0;
	for i in orig {
		let x = g.res[i];
		var cnt = 0;
		for j in orig {
			if g.res[j] == x { cnt++; }
		}
		if cnt > 1 {
			gold_push(g, x);
			dupes++;
		}
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "dupes ", dupes);
	out
}
@end
