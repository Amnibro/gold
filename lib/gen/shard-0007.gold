test: list=10,6,3,1
expect: => i=3 r=0.0 ok=true s="reversed gaps: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=20,15,11,8
expect: => i=3 r=0.0 ok=true s="reversed gaps: 3" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	for i in g.n - 1 {
		g.res[i] = g.res[i] - g.res[i + 1];
	}
	g.n--;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "reversed gaps: ", g.n);
	g.steps += g.n;
	out
}
@end
