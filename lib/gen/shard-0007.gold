fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let start = 1;
		let end = g.n - 1;
		for i in (end - start) {
			for j in (end - start - 1) {
				let idx = start + j;
				if g.res[idx] > g.res[idx + 1] {
					let tmp = g.res[idx];
					g.res[idx] = g.res[idx + 1];
					g.res[idx + 1] = tmp;
				}
			}
		}
		let mid = g.res[g.n / 2];
		gold_cache_put(g, 0, mid);
		out.i = mid;
	}
	out
}
@end
