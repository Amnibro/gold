fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	if limit < g.n && limit >= 0 {
		let start = g.n - limit;
		for i in limit {
			g.res[i] = g.res[start + i];
		}
		g.n = limit;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "suffix last count ", g.n);
	out
}
