code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var k = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len == 1 {
			g.res[k] = g.res[i];
			k++;
		}
		i = j;
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "non streak items ", k);
	out
}
@end
