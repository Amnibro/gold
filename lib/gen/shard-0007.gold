code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_req = ${minimum};
	var odd_cnt = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odd_cnt++;
		}
	}
	if odd_cnt >= min_req {
		var new_n = 0;
		for i in g.n {
			if g.res[i] % 2 != 0 {
				g.res[new_n] = g.res[i];
				new_n++;
			}
		}
		g.n = new_n;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split odds meeting minimum threshold");
	out
}
@end
