noun: window
modifier: in_place
context: aggregate
phrase: normalize window sums in place size {wsize}
phrase: aggregate sliding window averages in place size {wsize}
slot: wsize int
test: list=10,20,30,40 wsize=2
expect: => i=3 r=0.0 ok=true s="window normalized 3" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=5,15,25 wsize=1
expect: => i=3 r=0.0 ok=true s="window normalized 3" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${wsize};
	var window = ws;
	if window < 1 { window = 1; }
	if window > g.n { window = g.n; }
	var total_windows = 0;
	for i in 0..(g.n - window + 1) {
		var s = 0;
		for j in window { s += g.res[i + j]; }
		g.res[i] = s / window;
		total_windows++;
	}
	g.n = total_windows;
	g.steps += g.n;
	out.i = total_windows;
	out.s.clear();
	format(out.s, "window normalized ", total_windows);
	out
}
@end
