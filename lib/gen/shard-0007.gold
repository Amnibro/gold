fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var kept byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in kept.len {
			if kept[j] == b { seen = true; break; }
		}
		if !seen {
			var cnt = 0;
			for j in out.s.len {
				if out.s[j] == b { cnt++; }
			}
			if cnt >= mf {
				kept.push(b);
				gold_push(g, cnt);
			}
		}
	}
	out.s.clear();
	out.s.append(kept);
	out.i = kept.len;
	out
}
@end
