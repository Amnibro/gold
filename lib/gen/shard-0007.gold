slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=1 r=0.0 ok=true s="rotated items by shift" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=10,20,30,40,50 shift=2
expect: => i=2 r=0.0 ok=true s="rotated items by shift" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let off = (s % g.n + g.n) % g.n;
	var temp int[512] = [0; 512];
	for i in g.n {
		let dest = (i + off) % g.n;
		temp[dest] = g.res[i];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = off;
	out.s.clear();
	format(out.s, "rotated items by shift");
	out
}
@end
