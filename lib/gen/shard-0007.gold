expect: => i=25 r=0.0 ok=true s="filled each series element" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: input=10 list=0,0,0 step_val=0
expect: => i=0 r=0.0 ok=false s="error: invalid fill series parameters" errors=1 n=3 res=[0,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_val};
	if g.n == 0 || s == 0 {
		gold_fail(g, "cannot fill empty series or zero step");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid fill series parameters");
		return out;
	}
	var cur = out.i;
	for k in g.n {
		g.res[k] = cur;
		cur += s;
	}
	out.i = cur;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled each series element");
	g.steps += g.n;
	out
}
@end
@entry ef26ac60a817cbee
kind: step
verb: normalize
noun: window
modifier: last
context: loop
phrase: normalize last window slice with size {window_size}
phrase: scale last window items in loop using {window_size}
phrase: adjust last window elements of length {window_size}
slot: window_size int
test: list=10,25,35,45 window_size=3
expect: => i=25 r=0.0 ok=true s="normalized last window elements" errors=0 n=4 res=[10,0,10,20] cache=0 hits=0
test: list=10 window_size=3
expect: => i=0 r=0.0 ok=false s="error: invalid window size" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window_size};
	if w <= 0 || g.n < w {
		gold_fail(g, "window size exceeds list length or invalid");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid window size");
		return out;
	}
	let start = g.n - w;
	var min_val = g.res[start];
	for k in start..g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	for k in start..g.n {
		g.res[k] -= min_val;
	}
	out.i = min_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized last window elements");
	g.steps += w;
	out
}
@end
@entry 2b175166ca17bce7
kind: step
verb: drop
noun: budget
modifier: pairwise
context: loop
phrase: drop pairwise loop elements exceeding budget {budget}
phrase: prune pairwise items when exceeding budget {budget}
phrase: remove pairwise items in loop over budget {budget}
slot: budget int
test: list=10,15,30,5 budget=25
expect: => i=1 r=0.0 ok=true s="dropped pairwise elements exceeding budget" errors=0 n=3 res=[10,15,5] cache=0 hits=0
test: list=10 budget=25
expect: => i=0 r=0.0 ok=false s="error: invalid budget parameters" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 || g.n < 2 {
		gold_fail(g, "insufficient elements or invalid budget");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid budget parameters");
		return out;
	}
	var kept = 1;
	var dropped = 0;
	for k in 1..g.n {
		let pair_sum = g.res[kept - 1] + g.res[k];
		if pair_sum <= b {
			g.res[kept] = g.res[k];
			kept++;
		} else {
			dropped++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped pairwise elements exceeding budget");
	g.steps += g.n;
	out
}
@end
