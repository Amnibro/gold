test: list=10,5,20
expect: => i=1 r=0.0 ok=true s="performed 1 pairwise swaps" errors=0 n=3 res=[5,10,20] cache=0 hits=0
test: list=2,7,12
expect: => i=0 r=0.0 ok=true s="performed 0 pairwise swaps" errors=0 n=3 res=[2,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		var i = 0;
		while i < g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps += 1;
			}
			i += 2;
		}
	}
	out.i = swaps;
	out.ok = true;
	out.s.clear();
	format(out.s, "performed ", swaps, " pairwise swaps");
	g.steps += g.n;
	out
}
@end
