code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	out.ok = true;
	var i = 0;
	var w_idx = 0;
	while i < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		if i >= out.s.len { break; }
		var len = 0;
		while i < out.s.len && out.s[i] != ' ' { len++; i++; }
		if w_idx % 2 == 0 {
			gold_push(g, len);
			if len < ml { out.ok = false; }
		}
		w_idx++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "every_other ", out.ok);
	out
}
@end
