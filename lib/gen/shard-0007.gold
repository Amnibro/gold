	let lo = ${low};
	let hi = ${high};
	var max_streak = 0;
	var cur_streak = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 0;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max streak ", max_streak);
	out
}
