code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	if idx <= 0 {
		out.i = if idx == 0 { 0 } else { -1 };
		return out;
	}
	var tmp int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[(i + idx) % g.n];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "rotated digits until target at offset: ", idx);
	out
}
@end
