expect: => i=1 r=0.0 ok=true s="[10,20,30]" errors=0 n=4 res=[10,20,30,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	if sz <= 0 || g.n == 0 { return out; }
	out.s.clear();
	var groups = 0;
	for i in g.n {
		if i % sz == 0 {
			if i > 0 { format(out.s, " "); }
			format(out.s, "[");
			groups++;
		} else {
			format(out.s, ",");
		}
		format(out.s, g.res[i]);
		if (i + 1) % sz == 0 || i + 1 == g.n {
			format(out.s, "]");
		}
	}
	gold_push(g, groups);
	g.steps += g.n;
	out.i = groups;
	out
}
@end
