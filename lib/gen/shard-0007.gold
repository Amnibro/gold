@entry 1507a8b49d89c474
kind: step
verb: measure
noun: primes
modifier: in_reverse
context: math
phrase: count prime numbers in reverse order
phrase: tally primes inspecting sequence from back
phrase: count prime values searching backward
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="primes count in reverse: 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="primes count in reverse: 0" errors=0 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var k = g.n - 1;
	while k >= 0 {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
		k--;
	}
	out.i = primes;
	out.ok = primes > 0;
	out.s.clear();
	format(out.s, "primes count in reverse: ", primes);
	g.steps += g.n * 2;
	out
}
@end
@entry 8bc03d891718eb2c
kind: step
verb: check
noun: gaps
modifier: while
context: math
phrase: check adjacent gaps remain under threshold {max_gap}
phrase: verify consecutive differences stay below {max_gap}
phrase: ensure adjacent element gaps bounded by {max_gap}
slot: max_gap int
test: list=2,4,7,9 max_gap=4
expect: => i=1 r=0.0 ok=true s="all gaps within threshold" errors=0 n=4 res=[2,4,7,9] cache=0 hits=0
test: list=1,10,12 max_gap=4
expect: => i=0 r=0.0 ok=false s="gap exceeded threshold" errors=0 n=3 res=[1,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = if g.res[i + 1] >= g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
			if diff > mg { valid = false; break; }
		}
	}
	out.ok = valid;
	out.s.clear();
	if valid {
		out.i = 1;
		out.s.append("all gaps within threshold");
	} else {
		out.i = 0;
		out.s.append("gap exceeded threshold");
	}
	g.steps += g.n;
	out
}
@end
