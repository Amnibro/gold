expect: => i=10 r=0.0 ok=true s="reversed primes while sum 10" errors=0 n=5 res=[4,2,3,5,10] cache=0 hits=0
test: list=10,7,11,13
expect: => i=31 r=0.0 ok=true s="reversed primes while sum 31" errors=0 n=5 res=[10,7,11,13,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var count = 0;
	var i = g.n;
	while i > 0 {
		i--;
		let val = g.res[i];
		if !core_is_prime(val) { break; }
		sum += val;
		count++;
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "reversed primes while sum ", sum);
	out
}
@end
