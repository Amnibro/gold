@entry d7486ea8f32a88bd
kind: step
verb: scan
noun: window
modifier: between
context: math
phrase: scan sliding window sum between elements size {size}
phrase: compute sliding window sums of size {size}
phrase: calculate rolling window totals with width {size}
slot: size int
test: list=1,2,3,4,5 size=2
expect: => i=4 r=0.0 ok=true s="window count: 4" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=10,20,30 size=2
expect: => i=2 r=0.0 ok=true s="window count: 2" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${size};
	if k <= 0 || k > g.n { out.ok = false; return out; }
	var kept = 0;
	var i = 0;
	while i + k <= g.n {
		var s = 0;
		for j in i..i + k { s += g.res[j]; }
		g.res[kept] = s;
		kept++;
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "window count: ", kept);
	g.steps += g.n * k;
	out
}
@end
