fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var sum = 0;
	var write_idx = 0;
	for k in g.n {
		if sum + g.res[k] <= limit {
			sum += g.res[k];
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = sum;
	out.s.clear();
	format(out.s, "spent ", sum);
	out
}
