fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_streak};
	var longest = 0;
	var current = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			current++;
		} else {
			if current > longest { longest = current; }
			current = 1;
		}
	}
	if current > longest { longest = current; }
	if longest > cap { longest = cap; }
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "bounded streak length ", longest);
	out
}
@end
