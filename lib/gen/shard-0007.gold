@entry b544f03e69defe86
kind: step
verb: check
noun: primes
modifier: at_least
context: list
phrase: check primes at_least minimum {min_count}
phrase: verify prime count is at_least {min_count}
slot: min_count int
test: list=2,3,4,5,6 min_count=3
expect: => i=3 r=0.0 ok=true s="found primes 3" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=8,9,10 min_count=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_count};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	out.i = primes;
	if primes < target {
		gold_fail(g, "fewer primes than required");
		out.ok = false;
		return out;
	}
	out.ok = true;
	out.s.clear();
	format(out.s, "found primes ", primes);
	g.steps += g.n;
	out
}
@end
@entry d4622a6f7dd5d987
kind: step
verb: check
noun: window
modifier: any
context: list
phrase: check window any with size {size} matching sum {target}
phrase: verify any sliding window of size {size} equals {target}
slot: size int
slot: target int
test: list=1,2,3,4 size=2 target=5
expect: => i=1 r=0.0 ok=true s="window matched at 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30 size=2 target=60
expect: => i=-1 r=0.0 ok=false s="no window match" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	let tgt = ${target};
	if sz <= 0 || g.n < sz {
		out.ok = false;
		out.i = -1;
		return out;
	}
	var found = false;
	var found_idx = -1;
	let limit = g.n - sz + 1;
	for i in limit {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		if sum == tgt {
			found = true;
			found_idx = i;
			break;
		}
	}
	out.ok = found;
	out.i = found_idx;
	out.s.clear();
	if found { format(out.s, "window matched at ", found_idx); }
	else { format(out.s, "no window match"); }
	g.steps += g.n;
	out
}
@end
