test: list=1,2 retries=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=10,20,30 retries=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if g.cn > 1 {
		let last_k = g.ck[g.cn - 1];
		let last_v = g.cv[g.cn - 1];
		var i = g.cn - 1;
		while i > 0 {
			g.ck[i] = g.ck[i - 1];
			g.cv[i] = g.cv[i - 1];
			i--;
		}
		g.ck[0] = last_k;
		g.cv[0] = last_v;
	}
	out.i = g.cn + r;
	g.steps += r + 1;
	out
}
@end
