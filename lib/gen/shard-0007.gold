code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 0 {
		var sum = 0;
		for b in out.s { sum += b as int; }
		let avg = sum / out.s.len;
		var high byte[..200] = "";
		for b in out.s {
			if (b as int) >= avg { high.push(b); }
		}
		if high.len > 1 {
			for i in 1..high.len {
				var j = i;
				while j > 0 && high[j - 1] > high[j] {
					let tmp = high[j];
					high[j] = high[j - 1];
					high[j - 1] = tmp;
					j--;
				}
			}
		}
		out.s.clear();
		out.s.append(high);
		for b in out.s { gold_push(g, b as int); }
		out.i = avg;
	}
	out
}
@end
