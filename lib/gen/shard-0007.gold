@entry 6e74cbc1748a7a39
kind: step
verb: apply
noun: window
modifier: nested
context: filter
phrase: apply nested filter window of size {size}
phrase: process nested filtering window spanning {size}
slot: size int
test: list=2,4,6,8,10 size=2
expect: => i=2 r=0.0 ok=true s="applied nested filter window" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=5,15,25 size=3
expect: => i=1 r=0.0 ok=true s="applied nested filter window" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i + w <= g.n {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[new_n] = sum / w;
		new_n++;
		i += w;
	}
	g.n = new_n;
	g.steps += g.n * w;
	out.i = new_n;
	out.s.clear();
	format(out.s, "applied nested filter window");
	out
}
@end
