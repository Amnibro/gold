code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var w = 1;
		var k = 1;
		var active = true;
		while k < g.n {
			if active && !${p}(g.res[k]) {
				active = false;
			}
			if active && g.res[k] == g.res[k - 1] {
				k++;
			} else {
				g.res[w] = g.res[k];
				w++;
				k++;
			}
		}
		g.n = w;
	}
	out.i = g.n;
	out
}
@end
