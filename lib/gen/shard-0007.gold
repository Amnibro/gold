code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let val = ${f}(g.res[i]);
		gold_cache_put(g, i, val);
		g.res[i] = val;
	}
	if g.n > 0 {
		var rank = 0;
		for i in g.n {
			if g.res[i] < g.res[0] { rank++; }
		}
		out.i = rank;
	}
	out.s.clear();
	format(out.s, "rank ", out.i);
	out
}
@end
@entry c5ea1193e38d5ee7
kind: step
verb: rotate
noun: tail
modifier: any
context: list
phrase: rotate tail any {shift}
phrase: cycle tail any {shift}
slot: shift int
test: list=1,2,3,4,5,6 shift=1
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[1,2,3,6,4,5] cache=0 hits=0
test: list=10,20,30,40 shift=1
expect: => i=40 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n >= 4 && s > 0 {
		let half = g.n / 2;
		let tail_len = g.n - half;
		var temp = [0; 512];
		for i in tail_len {
			temp[(i + s) % tail_len] = g.res[half + i];
		}
		for i in tail_len {
			g.res[half + i] = temp[i];
		}
		out.i = g.res[half];
	}
	out
}
@end
@entry 13be807d8aecae78
kind: step
verb: rotate
noun: threshold
modifier: sorted
context: list
phrase: rotate threshold sorted {threshold}
phrase: cycle threshold sorted {threshold}
slot: threshold int
test: list=10,50,20,40 threshold=30
expect: => i=40 r=0.0 ok=true s="" errors=0 n=4 res=[40,50,10,20] cache=0 hits=0
test: list=5,15,2,8 threshold=10
expect: => i=15 r=0.0 ok=true s="" errors=0 n=4 res=[15,2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	for i in g.n {
		for j in (g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if g.n > 1 {
		var split = 0;
		while split < g.n && g.res[split] < th {
			split++;
		}
		if split > 0 && split < g.n {
			var temp = [0; 512];
			var idx = 0;
			for i in (g.n - split) {
				temp[idx] = g.res[split + i];
				idx++;
			}
			for i in split {
				temp[idx] = g.res[i];
				idx++;
			}
			for i in g.n { g.res[i] = temp[i]; }
		}
		out.i = g.res[0];
	}
	out
}
@end
