@entry a4cf7166b46ac276
kind: step
verb: collect
noun: item
modifier: sorted
context: aggregate
phrase: collect items in sorted order aggregating sums
phrase: aggregate elements collecting running sums sorted
test: list=5,1,4,2,3
expect: => i=15 r=0.0 ok=true s="sorted cumulative 15" errors=0 n=5 res=[1,3,6,10,15] cache=0 hits=0
test: list=10,2,8
expect: => i=20 r=0.0 ok=true s="sorted cumulative 20" errors=0 n=3 res=[2,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	// insertion sort
	for i in 1..g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	var running = 0;
	for i in g.n {
		running += g.res[i];
		g.res[i] = running;
	}
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "sorted cumulative ", running);
	out
}
@end
