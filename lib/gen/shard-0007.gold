@entry 9ef886394286366b
kind: step
verb: apply
noun: letters
modifier: any
context: transform
phrase: apply rot thirteen shift to any alphabetic letters
phrase: shift any letters by thirteen positions in text
test: text="hello world"
expect: => i=10 r=0.0 ok=true s="uryyb jbeyq" errors=0 n=0 res=[] cache=0 hits=0
test: text="Antigravity 2026"
expect: => i=11 r=0.0 ok=true s="Nagvtenivgl 2026" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var shifted = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let offset = (c - 'a' + 13) % 26;
			out.s[i] = ('a' + offset) as byte;
			shifted++;
		} else if c >= 'A' && c <= 'Z' {
			let offset = (c - 'A' + 13) % 26;
			out.s[i] = ('A' + offset) as byte;
			shifted++;
		}
	}
	g.steps += out.s.len;
	out.i = shifted;
	out
}
@end
@entry 938f090eac66ad48
kind: step
verb: group
noun: checkpoint
modifier: nested
context: transform
phrase: group nested elements around checkpoint stride {stride}
phrase: partition nested entries into checkpoint windows of {stride}
slot: stride int
test: list=1,2,3,4,5,6 stride=3
expect: => i=2 r=0.0 ok=true s="grouped checkpoint windows" errors=0 n=2 res=[6,15] cache=0 hits=0
test: list=10,20,30,40 stride=2
expect: => i=2 r=0.0 ok=true s="grouped checkpoint windows" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${stride};
	if s <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = 0;
		while j < s && i + j < g.n {
			sum += g.res[i + j];
			j++;
		}
		g.res[new_n] = sum;
		new_n++;
		i += s;
	}
	g.n = new_n;
	g.steps += g.n * s;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped checkpoint windows");
	out
}
@end
@entry d00f85ab51c3672f
kind: step
verb: limit
noun: list
modifier: in_reverse
context: transform
phrase: limit list in reverse keeping last {count} elements
phrase: retain trailing {count} elements reversing their order
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="limited list in reverse count 3" errors=0 n=3 res=[50,40,30] cache=0 hits=0
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="limited list in reverse count 2" errors=0 n=2 res=[4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n == 0 || k <= 0 { return out; }
	let take = min(g.n, k); 
	var rev int[64] = [0; 64];
	for i in take {
		rev[i] = g.res[g.n - 1 - i];
	}
	gold_clear(g);
	for i in take {
		gold_push(g, rev[i]);
	}
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "limited list in reverse count ", take);
	out
