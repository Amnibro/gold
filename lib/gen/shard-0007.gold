verb: cache
noun: threshold
modifier: pairwise
context: aggregate
phrase: cache pairwise sums exceeding threshold {th}
phrase: aggregate adjacent pairs caching totals above {th}
slot: th int
test: list=10,20,5,30 th=25
expect: => i=2 r=0.0 ok=true s="pairs above threshold 2" errors=0 n=4 res=[10,20,5,30] cache=2 hits=0
