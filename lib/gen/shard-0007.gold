fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	gold_clear(g);
	var k = 0;
	while k < limit {
		out.i = ${f}(out.i);
		gold_push(g, out.i);
		k++;
	}
	out.s.clear();
	format(out.s, "ran ", k, " steps");
	g.steps += k;
	out
}
