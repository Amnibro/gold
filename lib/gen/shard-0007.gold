@entry 962cc741fe34184c
kind: step
verb: normalize
noun: tally
modifier: up_to
context: stats
phrase: normalize sample tally up_to {scale}
phrase: scale observation tally up_to {scale}
slot: scale int
test: list=2,4,8 scale=100
expect: => i=100 r=0.0 ok=true s="tally normalized to 100" errors=0 n=3 res=[25,50,100] cache=0 hits=0
test: list=10,20,50 scale=10
expect: => i=10 r=0.0 ok=true s="tally normalized to 10" errors=0 n=3 res=[2,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 || sc <= 0 {
		return out;
	}
	var max_v = g.res[0];
	for i in g.n {
		if g.res[i] > max_v {
			max_v = g.res[i];
		}
	}
	if max_v > 0 {
		for i in g.n {
			g.res[i] = (g.res[i] * sc) / max_v;
		}
	}
	out.i = sc;
	out.s.clear();
	format(out.s, "tally normalized to ", sc);
	out
}
@end
