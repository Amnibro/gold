expect: => i=5 r=0.0 ok=true s="cache capacity measured: 5" errors=0 n=3 res=[1,2,3] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 { return out; }
	let mid = g.n / 2;
	var added = 0;
	while g.cn < lim && added < 5 {
		gold_cache_put(g, g.cn, g.res[mid]);
		added++;
	}
	out.i = g.cn;
	g.steps += added;
	out.s.clear();
	format(out.s, "cache capacity measured: ", g.cn);
	out
}
@end
