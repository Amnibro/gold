			total += g.res[i];
			items++;
		} else {
			gold_fail(g, "cumulative error total reached boundary");
			out.ok = false;
			break;
		}
	}
	g.steps += items;
	out.i = total;
	out.s.clear();
	format(out.s, "filled total under limit ", total);
	out
}
@end
