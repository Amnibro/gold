fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		var cnt = 0;
		for j in out.s.len {
			if out.s[j] == c { cnt++; }
		}
		if cnt > 1 {
			var seen = false;
			for j in dupes.len {
				if dupes[j] == c { seen = true; break; }
			}
			if !seen { dupes.push(c); }
		}
	}
	out.s.clear();
	out.s.append(dupes);
	out.i = dupes.len;
	out
}
@end
