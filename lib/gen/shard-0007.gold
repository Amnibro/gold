	var right = g.n - 1;
	while left < right {
		let t = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = t;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed histogram buckets ", g.n);
	out
}
@end
