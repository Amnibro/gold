code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var write_idx = 0;
	var dropped = 0;
	for k in g.n {
		if g.res[k] == target {
			dropped++;
		} else {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = dropped;
	out
}
@end
