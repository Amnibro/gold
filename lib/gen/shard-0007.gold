fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = 0;
	while start < g.n && !${p}(g.res[start]) {
		start++;
	}
	if start < g.n {
		for i in start..g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	let sorted_cnt = g.n - start;
	g.steps += g.n + sorted_cnt;
	out.i = sorted_cnt;
	out.s.clear();
	format(out.s, "sorted retry tail count: ", sorted_cnt);
	out
}
@end
