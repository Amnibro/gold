slot: count int
test: text="one two three four five" count=2
expect: => i=3 r=0.0 ok=true s="three four five" errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha beta gamma" count=1
expect: => i=2 r=0.0 ok=true s="beta gamma" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var words_seen = 0;
	var start_idx = 0;
	var in_word = false;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			in_word = false;
		} else if !in_word {
			in_word = true;
			words_seen++;
			if words_seen > k {
				start_idx = i;
				break;
			}
		}
	}
	var new_s byte[..200] = "";
	if words_seen > k {
		for j in start_idx..v.s.len {
			new_s.push(v.s[j]);
		}
	}
	out.s = new_s;
	g.steps += v.s.len;
	out.i = words_seen;
	out
}
@end
