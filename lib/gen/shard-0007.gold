code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty retry delay list");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_val = g.res[min_idx];
	g.res[min_idx] = -min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "inverted minimum retry: ", min_val);
	out
}
@end
@entry dc7b1321a2d9b3cd
kind: step
verb: scale
noun: primes
modifier: between
context: retry
phrase: scale primes between lower upper retry bounds
phrase: multiply prime retry counts within target range
test: list=3,5,6,7
expect: => i=3 r=0.0 ok=true s="scaled prime retries: 3" errors=0 n=4 res=[6,10,6,14] cache=0 hits=0
test: list=4,8,10
expect: => i=0 r=0.0 ok=false s="scaled prime retries: 0" errors=1 n=3 res=[4,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				g.res[i] *= 2;
				scaled++;
			}
		}
	}
	if scaled == 0 {
		gold_fail(g, "no primes found to scale");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled prime retries: ", scaled);
	out
}
@end
