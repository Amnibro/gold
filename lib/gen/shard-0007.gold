kind: step
verb: rotate
noun: tail
modifier: until
context: format
phrase: rotate tail elements until reaching cutoff target {target}
phrase: format trailing tail values until encountering target {target}
slot: target int
test: list=10,20,30,40 target=20
expect: => i=2 r=0.0 ok=true s="tail elements before target: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
