code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var count = 0;
	var dups = 0;
	for k in g.n {
		let x = g.res[k];
		temp[count] = x;
		count++;
		if k % 2 == 0 {
			temp[count] = x;
			count++;
			dups++;
		}
	}
	for k in count { g.res[k] = temp[k]; }
	g.n = count;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicated ", dups, " alternate elements");
	g.steps += count;
	out
}
@end
