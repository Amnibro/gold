phrase: adjust fault gaps {times} repetitions
slot: times int
test: list=10,25,30,60 times=2
expect: => i=40 r=0.0 ok=true s="normalized spacing 2 times" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,8,12 times=1
expect: => i=12 r=0.0 ok=true s="normalized spacing 1 times" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 || g.n < 2 {
		gold_fail(g, "insufficient error points for spacing");
		out.ok = false;
		return out;
	}
	for step in t {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			if diff > 10 {
				g.res[i + 1] = g.res[i] + 10;
			}
		}
	}
	g.steps += t * g.n;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "normalized spacing ", t, " times");
	out
}
@end
