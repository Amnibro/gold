code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let t = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = t;
			swaps++;
		}
		i += 2;
	}
	out.i = swaps;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "histogram bins swapped: ", swaps);
	out
}
@end
