fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_words};
	var w_count = 0;
	var in_w = false;
	for i in v.s.len {
		let c = v.s[i];
		if c == ' ' {
			in_w = false;
		} else if !in_w {
			w_count++;
			in_w = true;
			if w_count > limit {
				gold_fail(g, "word count exceeded limit while comparing");
				out.ok = false;
				break;
			}
		}
	}
	g.steps += v.s.len;
	out.i = w_count;
	out.s.clear();
	format(out.s, "compared words count ", w_count);
	out
}
@end
