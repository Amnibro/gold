fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let td = ${target_digit};
	var num = out.i;
	if num < 0 { num = -num; }
	var matches = 0;
	while num > 0 {
		if num % 10 == td {
			matches++;
		}
		num /= 10;
	}
	out.i = matches;
	gold_push(g, matches);
	g.steps += matches + 1;
	out
}
