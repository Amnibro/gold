fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		while x >= 10 {
			var sum = 0;
			while x > 0 {
				sum += x % 10;
				x /= 10;
			}
			x = sum;
		}
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ran number recursively root count ", g.n);
	out
}
@end
