@entry 9ec3e217bfdd0a74
kind: step
verb: filter
noun: gaps
modifier: all
context: retry
phrase: filter gaps all retry intervals exceeding bound {bound}
phrase: remove all retry gaps longer than {bound}
slot: bound int
test: list=10,25,30,60 bound=10
expect: => i=3 r=0.0 ok=true s="filtered retry gaps count: 3" errors=0 n=1 res=[10] cache=0 hits=0
test: list=5,8,12 bound=2
expect: => i=2 r=0.0 ok=true s="filtered retry gaps count: 2" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var i = 0;
	var removed = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if gap > b {
			for j in (g.n - 1 - i) {
				g.res[i + 1 + j] = g.res[i + 2 + j];
			}
			g.n--;
			removed++;
		} else {
			i++;
		}
	}
	g.steps += g.n + removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered retry gaps count: ", removed);
	out
}
@end
