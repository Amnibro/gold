fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	var min_idx = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
		i += 2;
	}
	if min_idx != 0 {
		let t = g.res[0];
		g.res[0] = g.res[min_idx];
		g.res[min_idx] = t;
	}
	out.i = g.res[0];
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped stride minimum: ", out.i);
	out
}
@end
