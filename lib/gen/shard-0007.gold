noun: numbers
modifier: nested
context: retry
phrase: drop nested retry numbers by depth {depth}
phrase: prune nested retry attempt numbers to depth {depth}
slot: depth int
test: list=10,20,30,40,50 depth=2
expect: => i=3 r=0.0 ok=true s="dropped nested numbers remaining 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3,4 depth=1
expect: => i=3 r=0.0 ok=true s="dropped nested numbers remaining 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d >= g.n {
		gold_fail(g, "invalid depth for nested retry numbers");
		out.ok = false;
		return out;
	}
	for i in (g.n - d) {
		g.res[i] = g.res[i + d];
	}
	g.n -= d;
	g.steps += d;
	out.i = g.n;
	out.s.clear();
	format(out.s, "dropped nested numbers remaining ", g.n);
	out
}
@end
