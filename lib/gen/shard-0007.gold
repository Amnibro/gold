fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var clamped = 0;
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			clamped++;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			clamped++;
		}
	}
	out.i = clamped;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped elements: ", clamped);
	g.steps += g.n;
	out
}
