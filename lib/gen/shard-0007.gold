code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo >= 0 && hi < g.n && lo < hi {
		let first = g.res[lo];
		for i in lo..hi {
			g.res[i] = g.res[i+1];
		}
		g.res[hi] = first;
	}
	g.steps += g.n;
	out.i = hi - lo;
	out.s.clear();
	format(out.s, "rotated range span ", out.i);
	out
}
@end
@entry e0969a58674272e6
kind: step
verb: dedupe
noun: primes
modifier: first
context: compare
phrase: dedupe prime numbers comparing first occurrences
phrase: retain first occurrence of prime values
test: list=2,3,2,5,3,7
expect: => i=4 r=0.0 ok=true s="unique prime occurrences 4" errors=0 n=6 res=[2,3,2,5,3,7] cache=0 hits=0
test: list=4,6,8,10
expect: => i=0 r=0.0 ok=true s="unique prime occurrences 0" errors=0 n=4 res=[4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_primes = 0;
	var seen_mask = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x < 30 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				if (seen_mask & (1 << x)) == 0 {
					unique_primes++;
					seen_mask = seen_mask | (1 << x);
				}
			}
		}
	}
	g.steps += g.n;
	out.i = unique_primes;
	out.s.clear();
	format(out.s, "unique prime occurrences ", unique_primes);
	out
}
@end
