test: list=2,5,2,2 threshold=3
expect: => i=3 r=0.0 ok=true s="freq 3" errors=0 n=4 res=[2,5,2,2] cache=0 hits=0
test: list=1,2,3,4 threshold=2
expect: => i=1 r=0.0 ok=false s="freq 1" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	out.ok = false;
	if g.n > 0 {
		let target = g.res[g.n - 1];
		var freq = 0;
		for i in g.n {
			if g.res[i] == target { freq++; }
		}
		out.i = freq;
		if freq >= th { out.ok = true; }
	}
	out.s.clear();
	format(out.s, "freq ", out.i);
	out
}
@end
