@entry 1f9c923644a2e4f0
kind: step
verb: sort
noun: series
modifier: unique
context: loop
phrase: sort series elements removing duplicates into unique sequence
phrase: order unique loop items strictly ascending
test: list=5,2,5,1,2,3
expect: => i=4 r=0.0 ok=true s="sorted unique series" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
test: list=20,10,20,30,10
expect: => i=3 r=0.0 ok=true s="sorted unique series" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[u] = x;
			u++;
		}
	}
	for i in u {
		for j in i + 1..u {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = u;
	g.steps += g.n * u;
	out.i = u;
	out.s.clear();
	format(out.s, "sorted unique series");
	out
}
@end
@entry 4fdab5ac9f2c5400
kind: step
verb: rank
noun: average
modifier: all
context: loop
phrase: rank all elements relative to sequence average
phrase: order all loop items by deviation from average
test: list=10,2,8,20
expect: => i=10 r=0.0 ok=true s="ranked relative to average" errors=0 n=4 res=[10,8,2,20] cache=0 hits=0
test: list=5,15,25,35
expect: => i=20 r=0.0 ok=true s="ranked relative to average" errors=0 n=4 res=[15,25,5,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n {
		for j in i + 1..g.n {
			let di = core_abs_val(g.res[i] - avg);
			let dj = core_abs_val(g.res[j] - avg);
			if di > dj {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "ranked relative to average");
	out
}
@end
@entry c2b9476450a9c8e5
kind: step
verb: validate
noun: middle
modifier: unique
context: loop
phrase: validate middle elements are strictly unique
phrase: check interior sequence entries have no duplicates
test: list=1,2,3,4,5
expect: => i=3 r=0.0 ok=true s="validated middle unique" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,20,30
expect: => i=0 r=0.0 ok=false s="middle validation failed" errors=1 n=4 res=[10,20,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		out.i = 0;
		return out;
	}
	var has_dup = false;
	for i in 1..g.n - 1 {
		for j in i + 1..g.n - 1 {
			if g.res[i] == g.res[j] {
				has_dup = true;
				break;
			}
		}
		if has_dup { break; }
	}
	g.steps += g.n * g.n;
	if has_dup {
		gold_fail(g, "duplicate found in middle");
		out.ok = false;
		out.s.clear();
		format(out.s, "middle validation failed");
		return out;
	}
	out.i = g.n - 2;
	out.s.clear();
	format(out.s, "validated middle unique");
	out
}
@end
