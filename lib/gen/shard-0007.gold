kind: step
verb: measure
noun: memo
modifier: in_reverse
context: compare
phrase: measure memo distances in reverse comparison
phrase: reverse order memo measurement comparison
test: list=10,25,30,50
expect: => i=85 r=0.0 ok=true s="reverse memo distance 85" errors=0 n=4 res=[10,25,30,50] cache=0 hits=0
test: list=5,15,40
expect: => i=60 r=0.0 ok=true s="reverse memo distance 60" errors=0 n=3 res=[5,15,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let last = g.res[g.n - 1];
	var total_dist = 0;
	var i = g.n - 2;
	while i >= 0 {
		let diff = last - g.res[i];
		total_dist += if diff < 0 { -diff } else { diff };
		i--;
	}
	g.steps += g.n;
	out.i = total_dist;
	out.s.clear();
	format(out.s, "reverse memo distance ", total_dist);
	out
}
@end
