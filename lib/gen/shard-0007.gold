	var i = g.n - 1;
	while i >= 0 {
		g.res[i] = g.res[i] - last_val;
		i--;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "normalized step in reverse first ", g.res[0]);
