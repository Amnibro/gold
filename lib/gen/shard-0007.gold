		let x = g.res[i];
		var seen = false;
		for j in k {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[k] = x;
			k++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
