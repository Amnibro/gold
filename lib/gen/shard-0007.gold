fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var pair_idx = 0;
	while pair_idx + 1 < g.n {
		let a = g.res[pair_idx];
		let b = g.res[pair_idx + 1];
		g.res[pair_idx] = b;
		g.res[pair_idx + 1] = a;
		swaps++;
