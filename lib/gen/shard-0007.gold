code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz > 1 {
		var i = 0;
		while i + sz <= g.n {
			let first = g.res[i];
			var j = 0;
			while j + 1 < sz {
				g.res[i + j] = g.res[i + j + 1];
				j++;
			}
			g.res[i + sz - 1] = first;
			i += sz;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
