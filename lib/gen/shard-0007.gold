fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for i in g.n {
		if g.res[i] == tgt { found = i; break; }
	}
	if found < 0 {
		for i in g.n {
			if g.res[i] + 1 == tgt { found = i; break; }
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "step index ", found);
	out
}
