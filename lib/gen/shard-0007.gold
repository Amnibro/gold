code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var dropped = 0;
	var k = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			g.res[k] = g.res[i];
			k++;
		} else {
			dropped++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped budget excess ", dropped);
	out
}
