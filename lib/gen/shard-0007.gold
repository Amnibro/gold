expect: => i=2 r=0.0 ok=true s="deduped all histogram duplicates count: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var removed = 0;
	while i < g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] {
				first = false;
				break;
			}
		}
		if !first {
			for j in (g.n - 1 - i) {
				g.res[i + j] = g.res[i + 1 + j];
			}
			g.n--;
			removed++;
		} else {
			i++;
		}
	}
	g.steps += g.n + removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped all histogram duplicates count: ", removed);
	out
}
@end
