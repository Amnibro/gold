fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var first = true;
		for j in i {
			if g.res[j] == g.res[i] { first = false; break; }
		}
		if first {
			var freq = 0;
			for j in g.n {
				if g.res[j] == g.res[i] { freq++; }
			}
			gold_cache_put(g, g.res[i], freq);
			unique_count++;
		}
	}
	out.i = unique_count;
	out.ok = unique_count > 0;
	out.s.clear();
	format(out.s, "cached histogram distinct items: ", unique_count);
	g.steps += g.n * g.n;
	out
}
