@entry d276a02f013f2b44
kind: step
verb: map
noun: average
modifier: safely
context: list
phrase: map average safely across items
phrase: transform list by neighbor average safely
test: list=10,20,30,40
expect: => i=25 r=0.0 ok=true s="mapped 4 items" errors=0 n=4 res=[15,20,30,35] cache=0 hits=0
test: list=5,15
expect: => i=10 r=0.0 ok=true s="mapped 2 items" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var tmp = [0; 512];
	for k in g.n {
		let prev_val = if k > 0 { g.res[k - 1] } else { g.res[k] };
		let next_val = if k + 1 < g.n { g.res[k + 1] } else { g.res[k] };
		tmp[k] = (prev_val + next_val) / 2;
	}
	var total = 0;
	for k in g.n {
		g.res[k] = tmp[k];
		total += tmp[k];
	}
	out.i = total / g.n;
	out.s.clear();
	format(out.s, "mapped ", g.n, " items");
	g.steps += g.n;
	out
}
@end
@entry 12e93d387af5d7d4
kind: step
verb: reverse
noun: streak
modifier: between
context: list
phrase: reverse streak between indices {low} to {high}
phrase: invert item streak between bounds {low} to {high}
slot: low int
slot: high int
test: list=1,2,3,4,5 low=1 high=3
expect: => i=3 r=0.0 ok=true s="reversed streak of 3" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30,40,50 low=0 high=4
expect: => i=5 r=0.0 ok=true s="reversed streak of 5" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo < 0 || hi >= g.n || lo >= hi {
		gold_fail(g, "invalid streak bounds");
		out.ok = false;
		return out;
	}
	var i = lo;
	var j = hi;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = hi - lo + 1;
	out.s.clear();
	format(out.s, "reversed streak of ", out.i);
	g.steps += out.i;
	out
}
@end
