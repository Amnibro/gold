@entry 5d58b205b3c6d590
kind: step
verb: dedupe
noun: evens
modifier: at_most
context: aggregate
phrase: dedupe even numbers at most keeping {max_count}
phrase: retain at most unique evens up to {max_count}
slot: max_count int
test: list=2,2,4,4,6,6 max_count=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,10,20,30,30 max_count=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var evens int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = false;
			for e in evens {
				if e == x {
				seen = true;
				break;
				}
			}
			if !seen && evens.len < mc {
				evens.push(x);
			}
		}
	}
	gold_clear(g);
	for e in evens {
		gold_push(g, e);
	}
	out.i = evens.len;
	g.steps += g.n;
	out
}
@end
