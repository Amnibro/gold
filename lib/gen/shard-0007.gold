	let count = ${times};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1 .. g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	for i in count {
		gold_push(g, min_val);
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "filled minimum times: ", count);
