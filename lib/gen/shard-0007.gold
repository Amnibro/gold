fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let orig = g.n;
		var gap_sum = 0;
		for i in (orig - 1) {
			let diff = g.res[i + 1] - g.res[i];
			gold_push(g, diff);
			gap_sum += diff;
		}
		out.i = gap_sum;
		out.s.clear();
		format(out.s, "gap sum: ", gap_sum);
	}
	out
}
@end
