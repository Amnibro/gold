code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if limit > 0 && g.n >= limit {
		for i in (limit / 2) {
			let tmp = g.res[i];
			g.res[i] = g.res[limit - 1 - i];
			g.res[limit - 1 - i] = tmp;
		}
		g.n = limit;
	}
	if g.n > 0 { out.i = g.res[0]; }
	out.s.clear();
	format(out.s, "reversed head: ", g.n);
	out
}
@end
