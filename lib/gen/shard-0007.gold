expect: => i=1 r=0.0 ok=true s="shifted items by offset 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3 amt=2
expect: => i=2 r=0.0 ok=true s="shifted items by offset 2" errors=0 n=3 res=[2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		out.s.append("shifted items by offset 0");
		return out;
	}
	var shift_amt = ${amt} % g.n;
	if shift_amt < 0 { shift_amt += g.n; }
	var temp int[512] = [0; 512];
	for k in g.n {
		let new_idx = (k + shift_amt) % g.n;
		temp[new_idx] = g.res[k];
	}
	for k in g.n {
		g.res[k] = temp[k];
	}
	out.i = shift_amt;
	out.s.clear();
	format(out.s, "shifted items by offset ", shift_amt);
	g.steps += g.n;
	out
}
@end
