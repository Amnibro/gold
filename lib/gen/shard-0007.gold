@entry b6d99972f5f6cad2
kind: step
verb: trace
noun: step
modifier: pairwise
context: error
phrase: trace step pairwise inspecting consecutive gaps {allowed_gap}
phrase: trace step pairwise checking adjacent delta {allowed_gap}
slot: allowed_gap int
test: list=10,12,15 allowed_gap=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=10,25,30 allowed_gap=5
expect: => i=3 r=0.0 ok=false s="" errors=1 n=3 res=[10,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ag = ${allowed_gap};
	var gap_ok = true;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff > ag {
				gap_ok = false;
				break;
			}
		}
	}
	if !gap_ok {
		gold_fail(g, "adjacent gap too large");
		out.ok = false;
	}
	g.steps++;
	out.i = g.n;
	out
}
@end
