fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			for j in g.n {
				if j > i && g.res[j] == x {
					found++;
					break;
				}
			}
		}
	}
	out.i = found;
	out.s.clear();
	format(out.s, "dupes ", found);
	out
}
