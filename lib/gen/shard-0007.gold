@entry afaca86a9f78fc90
kind: step
verb: check
noun: number
modifier: with_cache
context: sort
phrase: check number with cache for rank position {target}
phrase: lookup rank of number with cache {target}
slot: target int
test: list=2,4,6,8,10 target=6
expect: => i=2 r=0.0 ok=true s="computed rank: 2" errors=0 n=5 res=[2,4,6,8,10] cache=1 hits=0
test: list=1,3,5,7 target=4
expect: => i=2 r=0.0 ok=true s="computed rank: 2" errors=0 n=4 res=[1,3,5,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let memo = 500000;
	let cv, hit = gold_cache_get(g, memo + tgt);
	if hit {
		out.i = cv;
		out.s.clear();
		format(out.s, "cache hit rank: ", cv);
		return out;
	}
	var rank = 0;
	for k in g.n {
		if g.res[k] < tgt { rank++; }
	}
	gold_cache_put(g, memo + tgt, rank);
	out.i = rank;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "computed rank: ", rank);
	out
}
@end
