expect: => i=3 r=0.0 ok=true s="split at checkpoint backwards" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${checkpoint};
	var split_idx = -1;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] == cp {
			split_idx = idx;
			break;
		}
		idx--;
	}
	if split_idx >= 0 {
		g.n = split_idx;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split at checkpoint backwards");
	out
}
@end
