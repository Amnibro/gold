expect: => i=0 r=0.0 ok=false s="steps 6" errors=1 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let bgt = ${budget};
	out.ok = false;
	var steps = 0;
	if tgt.len > 0 && out.s.len >= tgt.len {
		let max_i = out.s.len - tgt.len + 1;
		for i in max_i {
			steps++;
			if steps > bgt { break; }
			var eq = true;
			for j in tgt.len {
				if out.s[i + j] != tgt[j] { eq = false; break; }
			}
			if eq {
				out.ok = true;
				out.i = i;
				break;
			}
		}
	}
	gold_push(g, steps);
	if !out.ok {
		gold_fail(g, "search budget with_retry: not found in budget");
	}
	out.s.clear();
	format(out.s, "steps ", steps);
	out
}
@end
