	var out = v;
	let m = ${margin};
	if m <= 0 || m * 2 >= g.n {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let new_len = g.n - 2 * m;
	for i in new_len {
		g.res[i] = g.res[i + m];
	}
	g.n = new_len;
	g.steps += new_len;
	out.i = new_len;
	out.s.clear();
	format(out.s, "filtered middle retry elements: ", new_len);
	out
}
@end
