phrase: verify observation step all {step}
slot: step int
test: list=2,5,7,9 step=3
expect: => i=3 r=0.0 ok=true s="step all compliant true" errors=0 n=4 res=[2,5,7,9] cache=0 hits=0
test: list=2,10,12 step=3
expect: => i=3 r=0.0 ok=false s="step all compliant false" errors=0 n=3 res=[2,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_s = ${step};
	var all_ok = true;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			var abs_d = diff;
			if abs_d < 0 {
				abs_d = -abs_d;
			}
			if abs_d > max_s {
				all_ok = false;
				break;
			}
		}
	}
	out.ok = all_ok;
	out.i = max_s;
	out.s.clear();
	format(out.s, "step all compliant ", all_ok);
	out
}
@end
