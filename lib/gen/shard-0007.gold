fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let nd = ${needle};
	if nd.len > 0 && out.s.len >= nd.len {
		let limit = out.s.len - nd.len + 1;
		for i in limit {
			var found_match = true;
			for j in nd.len {
				if out.s[i + j] != nd[j] { found_match = false; break; }
			}
			if found_match { gold_push(g, i); }
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "matches ", g.n);
	out
}
@end
