fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_non_neg = true;
	for i in g.n {
		if g.res[i] < 0 {
			all_non_neg = false;
			break;
		}
	}
	out.ok = all_non_neg;
	out.i = if all_non_neg { 1 } else { 0 };
	if !all_non_neg {
		gold_fail(g, "negative observation encountered");
		return out;
	}
	g.steps += g.n;
	out
}
@end
