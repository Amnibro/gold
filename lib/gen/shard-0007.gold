noun: text
modifier: until
context: transform
phrase: run text scan until length reaches {limit}
phrase: transform characters until target size {limit}
slot: limit int
test: text="hello" limit=8
expect: => i=8 r=0.0 ok=true s="hello***" errors=0 n=0 res=[] cache=0 hits=0
test: text="world wide" limit=4
expect: => i=4 r=0.0 ok=true s="worl" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var buf byte[..200] = "";
	var target = lim;
	if target < 0 { target = 0; }
	if target > 199 { target = 199; }
	var i = 0;
	while i < target && i < out.s.len {
		buf.push(out.s[i]);
		i++;
	}
	while buf.len < target {
		buf.push('*');
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += 1;
	out.i = out.s.len;
	out
}
@end
