	let first_end = i;
	if first_end < out.s.len {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		let rest_start = i;
		var rotated byte[..200] = "";
		for k in rest_start..out.s.len {
			rotated.push(out.s[k]);
		}
		rotated.push(' ');
		for k in first_start..first_end {
			rotated.push(out.s[k]);
		}
		out.s.clear();
		out.s.append(rotated);
	}
	gold_push(g, out.s.len);
	out.i = out.s.len;
	out
}
@end
