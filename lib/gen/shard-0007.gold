code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var write_idx = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "deduplicated unique count ", write_idx);
	out
}
@end
