fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var count = (g.n + 1) / 2;
		for i in 1..count {
			var j = i;
			while j > 0 && g.res[2 * (j - 1)] > g.res[2 * j] {
				let tmp = g.res[2 * j];
				g.res[2 * j] = g.res[2 * (j - 1)];
				g.res[2 * (j - 1)] = tmp;
				j--;
			}
		}
	}
	if g.n > 0 { out.i = g.res[0]; }
