@entry 7124af2df1112c35
kind: step
verb: limit
noun: steps
modifier: none
context: sort
phrase: limit steps none {max_diff}
phrase: clamp steps none {max_diff}
slot: max_diff int
test: list=10,50,20 max_diff=15
expect: => i=1 r=0.0 ok=true s="steps clamped 1" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=1,10,20 max_diff=5
expect: => i=2 r=0.0 ok=true s="steps clamped 2" errors=0 n=3 res=[1,6,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var clamped = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] - g.res[i - 1] > md {
				g.res[i] = g.res[i - 1] + md;
				clamped++;
			}
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "steps clamped ", clamped);
	out
}
@end
