test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="evens 3" errors=0 n=6 res=[6,2,4,3,5,1] cache=0 hits=0
test: list=1,3,5
expect: => i=0 r=0.0 ok=true s="evens 0" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		while i < g.n && g.res[i] % 2 == 0 {
			i++;
			evens++;
		}
		while j >= 0 && g.res[j] % 2 != 0 {
			j--;
		}
		if i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
			evens++;
		}
	}
	out.i = evens;
	out.s.clear();
	format(out.s, "evens ", evens);
	out
}
@end
