noun: pairs
modifier: with_retry
context: aggregate
phrase: drop duplicate pairs aggregating with retry
phrase: aggregate sequence dropping repeated pairs with retry
test: list=1,1,2,3,3,4
expect: => i=2 r=0.0 ok=true s="dropped pairs 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=5,6,7,8
expect: => i=0 r=0.0 ok=true s="dropped pairs 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var k = 0;
	var dropped = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			dropped++;
			i += 2;
		} else {
			g.res[k] = g.res[i];
			k++;
			i++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped pairs ", dropped);
	out
}
@end
