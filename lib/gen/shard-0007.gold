@entry a68f355d5e869f5d
kind: step
verb: dedupe
noun: digits
modifier: none
context: stats
phrase: dedupe digits none
phrase: filter digits none duplicates
test: input=11223344
expect: => i=1234 r=0.0 ok=true s="unique digits: 1234" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: input=998877
expect: => i=987 r=0.0 ok=true s="unique digits: 987" errors=0 n=3 res=[9,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = out.i;
	if x < 0 { x = -x; }
	var digits int[..20] = [];
	while x > 0 {
		digits.push(x % 10);
		x = x / 10;
	}
	var unq int[..20] = [];
	for k in digits.len {
		let d = digits[digits.len - 1 - k];
		var seen = false;
		for j in unq.len {
			if unq[j] == d { seen = true; break; }
		}
		if !seen {
			unq.push(d);
			gold_push(g, d);
		}
	}
	var res = 0;
	for d in unq {
		res = res * 10 + d;
	}
	out.i = res;
	out.s.clear();
	format(out.s, "unique digits: ", res);
	out
}
@end
