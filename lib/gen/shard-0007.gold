fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i+1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i+1];
			g.res[i+1] = tmp;
			swapped++;
		}
		i += 2;
	}
	gold_push(g, swapped);
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "normalized adjacent pairs swapped: ", swapped);
	out
}
@end
