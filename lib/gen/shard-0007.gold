@entry 45372cbdee520c8c
kind: step
verb: keep
noun: window
modifier: none
context: list
phrase: keep window none removing center chunk {size}
phrase: strip window of width {size} leaving margins
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=4 r=0.0 ok=true s="margin items kept 4" errors=0 n=4 res=[1,2,5,6] cache=0 hits=0
test: list=10,20,30,40,50 size=1
expect: => i=4 r=0.0 ok=true s="margin items kept 4" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz >= g.n { return out; }
	let start = (g.n - sz) / 2;
	let end = start + sz;
	var kept = 0;
	var tmp = [0; 512];
	for i in g.n {
		if i < start || i >= end {
			tmp[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept { g.res[i] = tmp[i]; }
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "margin items kept ", kept);
	g.steps += g.n;
	out
}
@end
