test: list=20,10,5
expect: => i=-5 r=0.0 ok=true s="max pairwise delta -5" errors=0 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("no pairs available");
		return out;
	}
	var max_diff = g.res[1] - g.res[0];
	var i = 1;
	while i < g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		if diff > max_diff {
			max_diff = diff;
		}
		i += 1;
	}
	out.i = max_diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "max pairwise delta ", max_diff);
	g.steps += g.n;
	out
}
@end
