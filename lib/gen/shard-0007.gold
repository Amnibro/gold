expect: => i=0 r=0.0 ok=true s="dropped 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		} else {
			dropped++;
		}
	}
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped);
	out
}
@end
