code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_gap};
	if g.n < 2 {
		gold_fail(g, "not enough error entries to compare spacing");
		out.ok = false;
		return out;
	}
	var matched = 0;
	var mismatched = 0;
	for i in (g.n - 1) {
		let gap = g.res[i + 1] - g.res[i];
		if gap == tgt {
			matched++;
		} else {
			mismatched++;
		}
	}
	if mismatched > 0 {
		gold_fail(g, "irregular spacing detected in errors");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "spacing matched ", matched, " times");
	out
}
@end
