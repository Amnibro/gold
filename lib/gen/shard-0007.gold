fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	if g.n < 2 { return out; }
	var small_idx = 0;
	for k in g.n {
		if g.res[k] < p {
			let t = g.res[k];
			g.res[k] = g.res[small_idx];
			g.res[small_idx] = t;
			small_idx++;
		}
	}
	out.i = small_idx;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "elements below pivot: ", small_idx);
	out
}
@end
