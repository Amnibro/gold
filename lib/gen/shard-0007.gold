	let f = ${factor};
	let start = g.n / 2;
	for i in start..g.n {
		g.res[i] *= f;
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "applied factor to any suffix elements ", f);
