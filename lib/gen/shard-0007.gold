phrase: invert descending runs times {k}
slot: k int
test: list=5,4,3,1,2 k=1
expect: => i=1 r=0.0 ok=true s="reversed 1 runs" errors=0 n=5 res=[1,3,4,5,2] cache=0 hits=0
test: list=9,8,7,6,5,4 k=2
expect: => i=1 r=0.0 ok=true s="reversed 1 runs" errors=0 n=6 res=[4,5,6,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${k};
	var inverted = 0;
	var i = 0;
	while i < g.n && inverted < lim {
		var j = i;
		while j + 1 < g.n && g.res[j] > g.res[j + 1] { j++; }
		if j > i {
			var l = i;
			var r = j;
			while l < r {
				let t = g.res[l];
				g.res[l] = g.res[r];
				g.res[r] = t;
				l++;
				r--;
			}
			inverted++;
			i = j + 1;
		} else {
			i++;
		}
	}
	out.i = inverted;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "reversed ", inverted, " runs");
	out
}
@end
