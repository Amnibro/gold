@entry e4acfff5b95f5dd7
kind: step
verb: check
noun: window
modifier: until
context: sort
phrase: check window until disorder occurs span {span}
phrase: scan window until unsorted block width {span}
slot: span int
test: list=1,2,3,5,4,6 span=3
expect: => i=2 r=0.0 ok=true s="window check stopped at: 2" errors=0 n=6 res=[1,2,3,5,4,6] cache=0 hits=0
test: list=1,2,3,4,5,6 span=3
expect: => i=-1 r=0.0 ok=true s="window check stopped at: -1" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 1 || g.n < w { return out; }
	var stop_idx = -1;
	var i = 0;
	while i + w <= g.n {
		var ok_win = true;
		for j in 1..w {
			if g.res[i + j] < g.res[i + j - 1] { ok_win = false; }
		}
		if !ok_win {
			stop_idx = i;
			break;
		}
		i++;
	}
	out.i = stop_idx;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "window check stopped at: ", stop_idx);
	out
}
@end
