fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n > 1 {
		for k in 1..g.n {
			let diff = g.res[k] - g.res[k - 1];
			total += if diff < 0 { -diff } else { diff };
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "accumulated ", total, " step differences");
	g.steps += g.n;
	out
}
@end
