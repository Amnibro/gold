@entry 7a3332caeb7c0139
kind: step
verb: filter
noun: number
modifier: nested
context: text
phrase: filter number nested {min_digits}
phrase: keep number nested {min_digits}
slot: min_digits int
test: text="a12b345c6" min_digits=2
expect: => i=2 r=0.0 ok=true s="12345" errors=0 n=2 res=[12,345] cache=0 hits=0
test: text="x1y22z333" min_digits=3
expect: => i=1 r=0.0 ok=true s="333" errors=0 n=1 res=[333] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_digits};
	var filtered byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		if out.s[i] >= '0' && out.s[i] <= '9' {
			let start = i;
			var val = 0;
			while i < out.s.len && out.s[i] >= '0' && out.s[i] <= '9' {
				val = val * 10 + ((out.s[i] - '0') as int);
				i++;
			}
			let run_len = i - start;
			if run_len >= md {
				gold_push(g, val);
				for k in run_len {
					filtered.push(out.s[start + k]);
				}
			}
		} else {
			i++;
		}
	}
	out.s.clear();
	out.s.append(filtered);
	out.i = g.n;
	out
}
@end
