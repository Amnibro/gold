fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 { num = -num; }
	out.s.clear();
	format(out.s, "digits reverse: [");
	var first = true;
	var d_count = 0;
	if num == 0 {
		format(out.s, 0);
		d_count = 1;
	} else {
		while num > 0 {
			let d = num % 10;
			if !first { format(out.s, ", "); }
			format(out.s, d);
			first = false;
			d_count++;
			num /= 10;
		}
	}
	format(out.s, "]");
	out.i = d_count;
	g.steps += d_count + 1;
	out
}
