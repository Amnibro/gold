@entry 933a4b0f1aeaf364
kind: step
verb: reverse
noun: steps
modifier: up_to
context: cache
phrase: reverse steps up to cache count {cap}
phrase: invert cached step results up to {cap}
slot: cap int
test: list=10,20,30,40,50 cap=3
expect: => i=3 r=0.0 ok=true s="reversed cached steps: 3" errors=0 n=5 res=[30,20,10,40,50] cache=5 hits=0
test: list=1,2,3,4 cap=2
expect: => i=2 r=0.0 ok=true s="reversed cached steps: 2" errors=0 n=4 res=[2,1,3,4] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var span = if limit < g.n && limit > 0 { limit } else { g.n };
	var l = 0;
	var r = span - 1;
	while l < r {
		let t = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = t;
		l++;
		r--;
	}
	out.i = span;
	g.steps += span;
	out.s.clear();
	format(out.s, "reversed cached steps: ", span);
	out
}
@end
