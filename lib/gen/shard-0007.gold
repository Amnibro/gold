expect: => i=0 r=0.0 ok=true s="running gaps adjusted 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var adjusted = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] < g.res[i - 1] + s {
				g.res[i] = g.res[i - 1] + s;
				adjusted++;
			}
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "running gaps adjusted ", adjusted);
	out
}
@end
