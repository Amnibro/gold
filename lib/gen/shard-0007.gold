@entry db4fc04be987b39c
kind: step
verb: fill
noun: gaps
modifier: in_reverse
context: retry
phrase: fill retry gaps in reverse order with step {delta}
phrase: interpolate retry intervals in reverse by {delta}
slot: delta int
test: list=10,30,50 delta=5
expect: => i=2 r=0.0 ok=true s="filled gaps in reverse count 2" errors=0 n=3 res=[10,15,35] cache=0 hits=0
test: list=100,120 delta=10
expect: => i=1 r=0.0 ok=true s="filled gaps in reverse count 1" errors=0 n=2 res=[100,110] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n < 2 {
		gold_fail(g, "not enough points to fill retry gaps");
		out.ok = false;
		return out;
	}
	var adjusted = 0;
	var i = g.n - 1;
	while i > 0 {
		let gap = g.res[i] - g.res[i - 1];
		if gap > d {
			g.res[i] = g.res[i - 1] + d;
			adjusted++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "filled gaps in reverse count ", adjusted);
	out
}
@end
