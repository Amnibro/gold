@entry d5bf69d2045c9d04
kind: step
verb: retry
noun: primes
modifier: safely
context: error
phrase: retry primes safely replacing composite faults
phrase: safely advance non-prime error codes to next prime
test: list=4,8,9
expect: => i=6 r=0.0 ok=true s="retried prime faults: 6" errors=6 n=3 res=[5,11,11] cache=0 hits=0
test: list=7,11,13
expect: => i=0 r=0.0 ok=true s="retried prime faults: 0" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var fixed = 0;
	for i in g.n {
		var x = g.res[i];
		var is_p = false;
		while !is_p {
			if x >= 2 {
				var ok = true;
				var d = 2;
				while d * d <= x {
					if x % d == 0 {
						ok = false;
						break;
					}
					d++;
				}
				if ok {
					is_p = true;
					break;
				}
			}
			x++;
			fixed++;
			g.errors++;
		}
		g.res[i] = x;
	}
	g.steps += g.n + fixed;
	out.i = fixed;
	out.s.clear();
	format(out.s, "retried prime faults: ", fixed);
	out
}
@end
