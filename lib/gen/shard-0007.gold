fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let orig = g.n;
	var dupes = 0;
	for i in orig {
		let val = g.res[i];
		if val >= lo && val <= hi {
			gold_push(g, val);
			dupes++;
		}
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "dupes ", dupes);
	out
}
@end
