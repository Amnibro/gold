fn ${ID}_is_vowel(c byte) bool {
	c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	if out.s.len > 1 {
		for k in 0..out.s.len - 1 {
			if ${ID}_is_vowel(out.s[k]) && ${ID}_is_vowel(out.s[k + 1]) {
				pairs++;
			}
		}
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " pairwise vowel occurrences");
	g.steps += out.s.len;
	out
}
@end
