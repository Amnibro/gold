test: list=10,25,50,75,100 lo=20 hi=80
expect: => i=3 r=0.0 ok=true s="applied error scale between range 3" errors=0 n=5 res=[10,50,100,150,100] cache=0 hits=0
test: list=5,15,35 lo=10 hi=30
expect: => i=1 r=0.0 ok=true s="applied error scale between range 1" errors=0 n=3 res=[5,30,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var modified = 0;
	for i in g.n {
		if g.res[i] >= low && g.res[i] <= high {
			g.res[i] = g.res[i] * 2;
			modified++;
		}
	}
	if modified == 0 {
		gold_fail(g, "no error records between range");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "applied error scale between range ", modified);
	out
}
@end
