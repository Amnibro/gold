kind: step
verb: rotate
noun: series
modifier: times
context: stats
phrase: rotate series times {rounds} shift {shift}
phrase: cycle series times {rounds} by {shift}
slot: rounds int
slot: shift int
test: list=1,2,3,4,5 rounds=2 shift=1
expect: => i=3 r=0.0 ok=true s="first element: 3" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 rounds=1 shift=2
expect: => i=30 r=0.0 ok=true s="first element: 30" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	let s = ${shift};
	if g.n > 1 && s > 0 {
		for step in r {
			let total_shift = s % g.n;
			for k in total_shift {
				let first = g.res[0];
				for i in (g.n - 1) {
					g.res[i] = g.res[i + 1];
				}
				g.res[g.n - 1] = first;
			}
		}
	}
	if g.n > 0 { out.i = g.res[0]; }
	out.s.clear();
	format(out.s, "first element: ", out.i);
	out
}
@end
