test: list=30,10,20
expect: => i=3 r=0.0 ok=true s="sorted cache: 10,20,30" errors=0 n=3 res=[30,10,20] cache=3 hits=0
test: list=5,1,9
expect: => i=3 r=0.0 ok=true s="sorted cache: 1,5,9" errors=0 n=3 res=[5,1,9] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 {
		for i in g.n { gold_cache_put(g, i, g.res[i]); }
	}
	var vals int[256] = [0; 256];
	for i in g.cn { vals[i] = g.cv[i]; }
	for i in g.cn {
		for j in i + 1 .. g.cn {
			if vals[i] > vals[j] {
				let tmp = vals[i];
				vals[i] = vals[j];
				vals[j] = tmp;
			}
		}
	}
	out.s.clear();
	format(out.s, "sorted cache: ");
	for i in g.cn {
		if i > 0 { format(out.s, ","); }
		format(out.s, vals[i]);
	}
	g.steps += g.cn * g.cn;
	out.i = g.cn;
	out
}
@end
