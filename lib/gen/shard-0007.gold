fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	let mv = ${max_val};
	for step in r {
		var clamped = 0;
		for i in g.n {
			if g.res[i] > mv {
				g.res[i] = mv;
				clamped++;
			}
		}
		gold_push(g, clamped);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped items: ", g.n);
	out
}
@end
