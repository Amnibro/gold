code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	for k in g.n {
		if k == 0 || g.res[k] >= g.res[k - 1] {
			cur_streak += g.res[k];
		} else {
			cur_streak = g.res[k];
		}
		if cur_streak > max_streak {
			max_streak = cur_streak;
		}
	}
	gold_cache_put(g, 0, max_streak);
	out.i = max_streak;
	out.s.clear();
	format(out.s, "streak ", max_streak);
	out
}
@end
