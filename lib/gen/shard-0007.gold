code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_sum = 0;
	var w = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == val { seen = true; break; }
		}
		if seen {
			dup_sum += val;
		} else {
			g.res[w] = val;
			w++;
		}
	}
	g.n = w;
	out.i = dup_sum;
	out
}
@end
