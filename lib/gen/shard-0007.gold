			streaks[count] = cur_len;
			count++;
			cur_val = g.res[k];
			cur_len = 1;
		}
	}
	streaks[count] = cur_len;
	count++;
	for k in count {
		g.res[k] = streaks[k];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " streaks");
	out
}
