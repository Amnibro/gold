code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	let lim = if pl < g.n { pl } else { g.n };
	var kept int[>..] = [];
	for k in lim {
		let x = g.res[k];
		var seen = false;
		for u in kept {
			if u == x { seen = true; break; }
		}
		if !seen { kept.push(x); }
	}
	out.s.clear();
	format(out.s, "prefix unique count: ", kept.len);
	out.i = kept.len;
	g.steps += lim * lim;
	out
}
@end
