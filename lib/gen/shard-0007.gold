fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_run = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_run++;
			g.res[k - 1] = cur_run - 1;
		} else {
			g.res[k - 1] = cur_run;
			cur_run = 1;
		}
	}
	g.res[g.n - 1] = cur_run;
	out.i = cur_run;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "mapped running duplicates: ", g.n);
	out
}
@end
