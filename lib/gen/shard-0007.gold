@entry b2b59b79e711e8d6
kind: step
verb: dedupe
noun: prefix
modifier: times
context: cache
phrase: dedupe prefix times {k}
phrase: compact prefix times {k}
slot: k int
test: list=2,2,3,4,4,5 k=4
expect: => i=3 r=0.0 ok=true s="prefix unique count 3" errors=0 n=5 res=[2,3,4,4,5] cache=1 hits=0
test: list=1,1,1 k=3
expect: => i=1 r=0.0 ok=true s="prefix unique count 1" errors=0 n=1 res=[1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if ${k} < g.n { ${k} } else { g.n };
	var unique int[64] = [0; 64];
	var uc = 0;
	for i in limit {
		let val = g.res[i];
		var found = false;
		for j in uc { if unique[j] == val { found = true; break; } }
		if !found && uc < 64 { unique[uc] = val; uc++; }
	}
	var new_res int[64] = [0; 64];
	var nc = 0;
	for i in uc { new_res[nc] = unique[i]; nc++; }
	for i in limit..g.n { if nc < 64 { new_res[nc] = g.res[i]; nc++; } }
	gold_clear(g);
	for i in nc { gold_push(g, new_res[i]); }
	gold_cache_put(g, 37, uc);
	out.i = uc;
	out.s.clear();
	format(out.s, "prefix unique count ", uc);
	out
}
@end
