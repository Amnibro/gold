fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	var low int[64] = [0; 64];
	var high int[64] = [0; 64];
	var lc = 0;
	var hc = 0;
	for i in g.n {
		if g.res[i] <= c {
			if lc < 64 {
				low[lc] = g.res[i];
				lc++;
			}
		} else {
			if hc < 64 {
				high[hc] = g.res[i];
				hc++;
			}
		}
	}
	gold_clear(g);
	for k in lc {
		gold_push(g, low[k]);
	}
	for k in hc {
		gold_push(g, high[k]);
	}
	out.i = lc;
	out.s.clear();
	format(out.s, "split up_to count ", lc);
	out
}
@end
@entry 1854ddd5165b46d9
kind: step
verb: split
noun: sequence
modifier: in_place
context: stats
phrase: split sample sequence in_place {pivot}
phrase: partition observation sequence in_place {pivot}
slot: pivot int
test: list=40,10,30,20 pivot=25
expect: => i=2 r=0.0 ok=true s="partitioned at 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
test: list=50,60,10 pivot=30
expect: => i=1 r=0.0 ok=true s="partitioned at 1" errors=0 n=3 res=[10,60,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var left = 0;
	var right = g.n - 1;
	while left <= right {
		while left <= right && g.res[left] <= p {
			left++;
		}
		while left <= right && g.res[right] > p {
			right--;
		}
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = left;
	out.s.clear();
	format(out.s, "partitioned at ", left);
	out
}
@end
@entry 583472fbde06a706
kind: step
verb: compare
noun: average
modifier: unique
context: stats
phrase: compare sample average unique
phrase: match distribution average unique
test: list=10,10,20,20
expect: => i=0 r=0.0 ok=true s="averages match true" errors=0 n=4 res=[10,10,20,20] cache=0 hits=0
test: list=10,10,10,40
expect: => i=-8 r=0.0 ok=false s="averages match false" errors=0 n=4 res=[10,10,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = true;
		out.i = 0;
		return out;
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let all_avg = total / g.n;
	var unique int[64] = [0; 64];
	var uc = 0;
	var u_total = 0;
	for i in g.n {
		let val = g.res[i];
		var exists = false;
		for j in uc {
			if unique[j] == val {
				exists = true;
				break;
			}
		}
		if !exists && uc < 64 {
			unique[uc] = val;
			uc++;
			u_total += val;
		}
	}
	var u_avg = 0;
	if uc > 0 {
		u_avg = u_total / uc;
	}
	out.ok = (all_avg == u_avg);
	out.i = all_avg - u_avg;
	out.s.clear();
	format(out.s, "averages match ", out.ok);
	out
}
@end
