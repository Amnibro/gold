				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var matched int[64] = [0; 64];
	var unmatched int[64] = [0; 64];
	var mc = 0;
	var uc = 0;
	for i in g.n {
		if ${predicate}(g.res[i]) {
			if mc < 64 { matched[mc] = g.res[i]; mc++; }
		} else {
			if uc < 64 { unmatched[uc] = g.res[i]; uc++; }
		}
	}
	gold_clear(g);
	for i in mc { gold_push(g, matched[i]); }
	for i in uc { gold_push(g, unmatched[i]); }
	out.i = mc;
	out.s.clear();
	format(out.s, "split matched ", mc);
	out
}
@end
