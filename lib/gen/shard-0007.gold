fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 {
		return out;
	}
	var sums int[64] = [0; 64];
	var sc = 0;
	var cur = 0;
	var count = 0;
	for i in g.n {
		cur += g.res[i];
		count++;
		if count == sz {
			if sc < 64 {
				sums[sc] = cur;
				sc++;
			}
			cur = 0;
			count = 0;
		}
	}
	if count > 0 && sc < 64 {
		sums[sc] = cur;
		sc++;
	}
	gold_clear(g);
	for k in sc {
		gold_push(g, sums[k]);
	}
	out.i = sc;
	out.s.clear();
	format(out.s, "grouped groups ", sc);
	out
}
@end
