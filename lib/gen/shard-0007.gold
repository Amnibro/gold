@entry 48e736917ed05409
kind: step
verb: drop
noun: total
modifier: until
context: stats
phrase: drop sample total until {target}
phrase: reduce observation total until {target}
slot: target int
test: list=10,20,30,40 target=50
expect: => i=2 r=0.0 ok=true s="dropped total count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 target=30
expect: => i=1 r=0.0 ok=true s="dropped total count 1" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	var dropped = 0;
	while sum > tgt && g.n > 0 {
		sum -= g.res[g.n - 1];
		g.n--;
		dropped++;
	}
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped total count ", dropped);
	out
}
@end
