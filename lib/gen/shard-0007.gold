fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	let bound = if lim < g.n { lim } else { g.n };
	var i = 0;
	var j = bound - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = bound;
