fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n <= lim || lim <= 0 { return out; }
	let start = (g.n - lim) / 2;
	for k in lim {
		g.res[k] = g.res[start + k];
	}
	g.n = lim;
	out.i = lim;
	g.steps += lim;
	out.s.clear();
	format(out.s, "selected middle: ", lim);
	out
}
