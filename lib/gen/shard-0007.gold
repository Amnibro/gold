@entry 3e4233066b4226e5
kind: step
verb: fold
noun: history
modifier: recursively
context: math
phrase: fold history recursively {factor}
phrase: compress history recursively {factor}
slot: factor int
test: list=1,2,3,4 factor=2
expect: => i=27 r=0.0 ok=true s="" errors=0 n=1 res=[27] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=70 r=0.0 ok=true s="" errors=0 n=1 res=[70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	while g.n > 1 {
		var new_len = 0;
		var k = 0;
		while k < g.n {
			if k + 1 < g.n {
				g.res[new_len] = g.res[k] + f * g.res[k + 1];
				k += 2;
			} else {
				g.res[new_len] = g.res[k];
				k += 1;
			}
			new_len++;
		}
		g.n = new_len;
	}
	if g.n > 0 { out.i = g.res[0]; }
	out
}
@end
