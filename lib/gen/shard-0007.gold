fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${sep};
	var unq byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in unq.len {
			if unq[j] == b { seen = true; break; }
		}
		if !seen {
			unq.push(b);
			gold_push(g, b as int);
		}
	}
	var joined byte[..200] = "";
	for i in unq.len {
		if i > 0 && sp.len > 0 { joined.append(sp); }
		joined.push(unq[i]);
	}
	out.s.clear();
	out.s.append(joined);
	out.i = unq.len;
	out
}
