test: list=4,1,3,2 f=double
expect: => i=6 r=0.0 ok=true s="sorted median 6" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,5 f=inc
expect: => i=11 r=0.0 ok=true s="sorted median 11" errors=0 n=2 res=[6,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { g.res[i] = ${f}(g.res[i]); }
	for i in 1..g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	let mid = g.n / 2;
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[mid] } else { 0 };
	out.s.clear();
	format(out.s, "sorted median ", out.i);
	out
}
@end
