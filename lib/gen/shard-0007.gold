test: list=2,2,2,2,3,3 limit=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=5,5,5,5,5 limit=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 || g.n == 0 { g.n = 0; out.i = 0; return out; }
	var kept = 0;
	var tmp = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if tmp[j] == x { seen++; }
		}
		if seen < lim {
			tmp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = tmp[i]; }
	g.n = kept;
	out.i = kept;
	g.steps += g.n;
	out
}
@end
