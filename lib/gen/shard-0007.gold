modifier: until
context: compare
phrase: sort elements until reaching limit {cap}
phrase: order values until comparison limit {cap}
slot: cap int
test: list=4,3,2,1 cap=3
expect: => i=3 r=0.0 ok=true s="sorted prefix length 3" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=5,2,8,1 cap=2
expect: => i=2 r=0.0 ok=true s="sorted prefix length 2" errors=0 n=4 res=[2,5,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cap};
	let limit = if k < g.n { k } else { g.n };
	for i in 1..limit {
		var j = i;
		while j > 0 && g.res[j] < g.res[j - 1] {
			let t = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = t;
			j--;
		}
	}
	g.steps += g.n;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted prefix length ", limit);
	out
}
@end
