expect: => i=2 r=0.0 ok=false s="mismatch at alternate index 2" errors=0 n=4 res=[2,1,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var checked = 0;
	var all_ok = true;
	var mismatch_idx = -1;
	var i = 0;
	while i < g.n {
		if !${p}(g.res[i]) {
			all_ok = false;
			mismatch_idx = i;
			break;
		}
		checked++;
		i += 2;
	}
	out.s.clear();
	if all_ok {
		out.i = checked;
		out.ok = true;
		format(out.s, "all ", checked, " alternate elements matched");
	} else {
		out.i = mismatch_idx;
		out.ok = false;
		format(out.s, "mismatch at alternate index ", mismatch_idx);
	}
	g.steps += g.n;
	out
}
@end
