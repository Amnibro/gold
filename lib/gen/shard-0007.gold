fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no runs to measure");
		out.ok = false;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var run_len = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] == last_val {
		run_len++;
		i--;
	}
	if run_len > 2 {
		g.errors++;
	}
	g.steps += g.n;
	out.i = run_len;
	out.s.clear();
	format(out.s, "last error run length: ", run_len);
	out
}
@end
