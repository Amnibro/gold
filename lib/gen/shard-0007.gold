code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_len = 0;
	if g.n > 0 {
		let first_val = g.res[0];
		while run_len < g.n && g.res[run_len] == first_val {
			run_len++;
		}
	}
	out.s.clear();
	format(out.s, "initial run length: ", run_len);
	out.i = run_len;
	g.steps += g.n;
	out
}
@end
@entry a64bba0ca2c36cd8
kind: step
verb: validate
noun: budget
modifier: in_reverse
context: format
phrase: validate budget accumulating in reverse under bound {limit}
phrase: check reverse budget total against ceiling {limit}
slot: limit int
test: list=10,20,30 limit=70
expect: => i=60 r=0.0 ok=true s="reverse total: 60 within budget 70" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=50,60 limit=40
expect: => i=110 r=0.0 ok=false s="reverse total: 110 within budget 40" errors=1 n=2 res=[50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var tot = 0;
	var i = g.n - 1;
	while i >= 0 {
		tot += g.res[i];
		i--;
	}
	let ok = tot <= lim;
	out.ok = ok;
	if !ok {
		gold_fail(g, "reverse budget exceeded");
	}
	out.s.clear();
	format(out.s, "reverse total: ", tot, " within budget ", lim);
	out.i = tot;
	g.steps += g.n;
	out
}
@end
