@entry 541bae5a8553fd30
kind: step
verb: check
noun: histogram
modifier: running
context: math
phrase: compute running frequencies across math sequence
phrase: track running histogram of elements
phrase: record running count of unique values
test: list=1,2,2,3,1
expect: => i=3 r=0.0 ok=true s="running distinct values: 3" errors=0 n=5 res=[1,2,2,3,3] cache=0 hits=0
test: list=5,5,5,6
expect: => i=4 r=0.0 ok=true s="running distinct values: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen { distinct++; }
		g.res[i] = distinct;
	}
	out.i = distinct;
	out.ok = true;
	out.s.clear();
	format(out.s, "running distinct values: ", distinct);
	g.steps += g.n * g.n;
	out
}
@end
