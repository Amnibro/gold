code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = if g.res[i+1] > g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
		if diff <= 3 {
			merged++;
			i += 2;
		} else {
			i += 1;
		}
	}
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged series pairs ", merged);
	out
}
@end
