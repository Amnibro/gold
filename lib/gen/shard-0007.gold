@entry 266235b2b8505217
kind: step
verb: shift
noun: average
modifier: unique
context: error
phrase: shift error list by unique average
phrase: offset fault entries by distinct average
test: list=10,20,10,30
expect: => i=20 r=0.0 ok=true s="shifted by unique average 20" errors=0 n=4 res=[-10,0,-10,10] cache=0 hits=0
test: list=5,5,15,15
expect: => i=10 r=0.0 ok=true s="shifted by unique average 10" errors=0 n=4 res=[-5,-5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty error record list");
		out.ok = false;
		return out;
	}
	var u int[64] = [0; 64];
	var uc = 0;
	var sum = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in uc {
			if u[j] == val { seen = true; break; }
		}
		if !seen && uc < 64 {
			u[uc] = val;
			uc++;
			sum += val;
		}
	}
	if uc == 0 {
		gold_fail(g, "zero unique error records");
		out.ok = false;
		return out;
	}
	let avg = sum / uc;
	for i in g.n {
		g.res[i] -= avg;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "shifted by unique average ", avg);
	out
}
@end
