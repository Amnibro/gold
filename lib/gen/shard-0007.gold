fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var runs = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] && g.res[i] > c {
				g.res[i] = c;
				runs++;
			}
		}
	}
	gold_cache_put(g, 23, runs);
	out.i = runs;
	out.s.clear();
	format(out.s, "runs normalized ", runs);
	out
}
@end
