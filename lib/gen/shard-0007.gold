expect: => i=40 r=0.0 ok=true s="scaled average: 40" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 factor=3
expect: => i=45 r=0.0 ok=true s="scaled average: 45" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if g.n > 0 {
		let avg = sum / g.n;
		let res = avg * f;
		out.i = res;
		out.ok = true;
		out.s.clear();
		format(out.s, "scaled average: ", res);
	} else {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		out.s.append("empty sequence retry fallback");
	}
	g.steps += g.n + 1;
	out
}
@end
