code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] < 0 || g.res[i + 1] < 0 {
			g.errors++;
			break;
		}
		g.res[pairs] = g.res[i] + g.res[i + 1];
		pairs++;
		i += 2;
	}
	if pairs == 0 {
		out.ok = false;
	}
	g.n = pairs;
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired range until fault: ", pairs);
	out
}
@end
