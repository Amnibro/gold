test: list=1,2,3,4,5,6 size=3
expect: => i=2 r=0.0 ok=true s="cached nested windows: 2" errors=0 n=6 res=[1,2,3,4,5,6] cache=2 hits=0
test: list=10,20,30,40 size=2
expect: => i=2 r=0.0 ok=true s="cached nested windows: 2" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	if w <= 0 || g.n < w { return out; }
	var i = 0;
	var win_id = 0;
	while i + w <= g.n {
		var total = 0;
		for j in w { total += g.res[i + j]; }
		gold_cache_put(g, win_id, total);
		win_id++;
		i += w;
	}
	out.i = win_id;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached nested windows: ", win_id);
	out
}
@end
