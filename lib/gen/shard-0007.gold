modifier: at_least
context: filter
phrase: normalize sequence filtering items at least {floor}
phrase: filter sequence normalizing values at least {floor}
slot: floor int
test: list=5,12,8,20,15 floor=10
expect: => i=3 r=0.0 ok=true s="normalized at least 3" errors=0 n=3 res=[2,10,5] cache=0 hits=0
test: list=1,2,3 floor=5
expect: => i=0 r=0.0 ok=true s="normalized at least 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var k = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= fl {
			g.res[k] = x - fl;
			k++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "normalized at least ", k);
	out
}
@end
