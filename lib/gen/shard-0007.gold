	for k in g.n {
		if k == 0 || g.res[k] == cur_val {
			cur_run++;
			cur_val = g.res[k];
		} else {
			cur_run = 1;
			cur_val = g.res[k];
		}
		if cur_run >= target {
			found = true;
			gold_cache_put(g, 0, cur_val);
			out.i = cur_val;
			break;
		}
	}
	out.ok = found;
	out.s.clear();
	format(out.s, "streak ", out.ok);
	out
}
@end
