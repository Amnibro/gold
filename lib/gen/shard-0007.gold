expect: => i=3 r=0.0 ok=true s="dropped elements times new size 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=100,200,300 times=1
expect: => i=2 r=0.0 ok=true s="dropped elements times new size 2" errors=0 n=2 res=[200,300] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 || t >= g.n {
		gold_fail(g, "invalid drop count for error list");
		out.ok = false;
		return out;
	}
	for i in (g.n - t) {
		g.res[i] = g.res[i + t];
	}
	g.n -= t;
	g.steps += t;
	out.i = g.n;
	out.s.clear();
	format(out.s, "dropped elements times new size ", g.n);
	out
}
@end
