fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var changed = 0;
	let start = g.n / 2;
	for i in start..g.n {
		if g.res[i] > limit {
			g.res[i] = limit;
			changed++;
		}
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "limited last numbers count ", changed);
	out
}
