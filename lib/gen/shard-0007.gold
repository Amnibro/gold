@entry 52d79129cd898b3c
kind: step
verb: limit
noun: average
modifier: with_retry
context: stats
phrase: limit distribution average with_retry {cap}
phrase: clamp sample average with_retry {cap}
slot: cap int
test: list=10,20,100 cap=20
expect: => i=15 r=0.0 ok=true s="avg capped 15" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,40 cap=15
expect: => i=10 r=0.0 ok=true s="avg capped 10" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_avg = ${cap};
	var tries = 0;
	while tries < 10 && g.n > 1 {
		var sum = 0;
		var max_idx = 0;
		for i in g.n {
			sum += g.res[i];
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		let avg = sum / g.n;
		if avg <= max_avg {
			out.i = avg;
			out.s.clear();
			format(out.s, "avg capped ", avg);
			return out;
		}
		var k = max_idx;
		while k < g.n - 1 {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.n--;
		tries++;
	}
	var final_sum = 0;
	for i in g.n { final_sum += g.res[i]; }
	if g.n > 0 { out.i = final_sum / g.n; }
	out.s.clear();
	format(out.s, "avg retried ", out.i);
	out
}
@end
