code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var new_s byte[..200] = "";
	for i in v.s.len {
		let c = v.s[i];
		let is_v = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
		if is_v {
			dropped++;
		} else {
			new_s.push(c);
		}
	}
	out.s = new_s;
	g.steps += v.s.len;
	out.i = dropped;
	out
}
@end
