fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var vowels = 0;
	var new_s byte[..200] = "";
	for k in out.s.len {
		let c = out.s[k] as int;
		let is_vowel = (c == 97 || c == 101 || c == 105 || c == 111 || c == 117);
		if is_vowel {
			if vowels < limit {
				new_s.push(out.s[k]);
				vowels++;
			}
		} else {
			new_s.push(out.s[k]);
		}
	}
	out.s = new_s;
	out.i = vowels;
	out
}
@end
