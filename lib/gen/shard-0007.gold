fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels = 0;
	var stopped = false;
	let stop_b = ${stop_char}[0];
	for i in v.s.len {
		let c = v.s[i];
		if c == stop_b {
			stopped = true;
			break;
		}
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels++;
		}
	}
	if !stopped {
		gold_fail(g, "stop character not encountered in error text");
		out.ok = false;
	}
	g.steps += v.s.len;
	out.i = vowels;
	out.s.clear();
	format(out.s, "found vowels until delimiter ", vowels);
	out
}
@end
