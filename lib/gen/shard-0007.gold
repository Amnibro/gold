	let max_r = ${retries};
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x <= 9 && cached < max_r {
			gold_cache_put(g, i, x);
			cached++;
		}
	}
	g.steps += g.n + cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached digits with retry limit");
	out
}
@end
