code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var tmp = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if tmp[j] == x { seen = true; break; }
		}
		if !seen {
			tmp[kept] = x;
			kept++;
		}
	}
	if kept > 1 {
		var i = 0;
		var j = kept - 1;
		while i < j {
			let swap_val = tmp[i];
			tmp[i] = tmp[j];
			tmp[j] = swap_val;
			i++;
			j--;
		}
	}
	for i in kept { g.res[i] = tmp[i]; }
	g.n = kept;
	out.i = kept;
	g.steps += g.n;
	out
}
@end
@entry 6219bb17af33e4d1
kind: step
verb: keep
noun: tally
modifier: sorted
context: stats
phrase: keep tally sorted by distinct value frequency
phrase: compute sorted frequency tally across observation values
test: list=4,2,4,4,2,7
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[4,3,2,2,7,1] cache=0 hits=0
test: list=9,9,1,1,1,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,3,9,2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals = [0; 512];
	var counts = [0; 512];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in u {
			if vals[j] == x { found = j; break; }
		}
		if found >= 0 {
			counts[found] += 1;
		} else {
			vals[u] = x;
			counts[u] = 1;
			u++;
		}
	}
	if u > 1 {
		for i in u {
			for j in (u - 1) {
				if counts[j] < counts[j + 1] {
					let tmp_c = counts[j]; counts[j] = counts[j + 1]; counts[j + 1] = tmp_c;
					let tmp_v = vals[j]; vals[j] = vals[j + 1]; vals[j + 1] = tmp_v;
				}
			}
		}
	}
	g.n = 0;
	for j in u {
		gold_push(g, vals[j]);
		gold_push(g, counts[j]);
	}
	out.i = u;
	g.steps += g.n;
	out
}
@end
