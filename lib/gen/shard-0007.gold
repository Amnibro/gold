@entry 22190955e17cc29c
kind: step
verb: reverse
noun: average
modifier: nested
context: sort
phrase: reverse average nested segment width {blk}
phrase: invert average nested block size {blk}
slot: blk int
test: list=1,2,3,4,5,6 blk=3
expect: => i=6 r=0.0 ok=true s="nested segments reversed: 2" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 blk=2
expect: => i=4 r=0.0 ok=true s="nested segments reversed: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${blk};
	if b <= 1 || g.n < b { return out; }
	var i = 0;
	while i + b <= g.n {
		var l = i;
		var r = i + b - 1;
		while l < r {
			let t = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = t;
			l++;
			r--;
		}
		i += b;
	}
	g.steps += g.n;
	out.i = i;
	out.s.clear();
	format(out.s, "nested segments reversed: ", i / b);
	out
}
@end
