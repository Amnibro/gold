fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	var overflow = false;
	for i in g.n {
		let x = g.res[i];
		if x > 1000 || s + x > 10000 {
			overflow = true;
			gold_fail(g, "checkpoint error sum exceeds safety boundary");
			out.ok = false;
			break;
		}
		s += x;
	}
	if !overflow {
		gold_push(g, s);
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "safe checkpoint sum ", s);
	out
}
@end
