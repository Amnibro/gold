@entry 1cb5df564f66f35b
kind: step
verb: retry
noun: total
modifier: in_reverse
context: error
phrase: retry total in reverse upon failure
phrase: recompute backward sum after error encounter
test: list=10,-1,20
expect: => i=31 r=0.0 ok=true s="retry total: 31" errors=1 n=3 res=[10,-1,20] cache=0 hits=0
test: list=5,15,25
expect: => i=45 r=0.0 ok=true s="retry total: 45" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var retries = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let val = g.res[idx];
		if val < 0 {
			retries++;
			g.errors++;
			total += (-val);
		} else {
			total += val;
		}
		idx--;
	}
	g.steps += g.n + retries;
	out.i = total;
	out.s.clear();
	format(out.s, "retry total: ", total);
	out
}
@end
