fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step};
	if st <= 0 || g.n <= st {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var pairs_count = 0;
	var tmp = [0; 512];
	let limit = g.n - st;
	for i in limit {
		tmp[pairs_count] = g.res[i] + g.res[i + st];
		pairs_count++;
	}
	for i in pairs_count { g.res[i] = tmp[i]; }
	g.n = pairs_count;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "paired count ", pairs_count);
	g.steps += pairs_count;
	out
}
@end
