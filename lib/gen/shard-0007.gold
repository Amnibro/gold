code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var failures = 0;
	for i in g.n {
		if g.res[i] < 0 {
			failures++;
			g.errors++;
		}
	}
	if failures > 0 {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = failures;
	out.s.clear();
	format(out.s, "failure count: ", failures);
	out
}
@end
