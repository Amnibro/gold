phrase: split unique elements below minimum threshold {bound}
phrase: isolate unique values under minimum bound {bound}
slot: bound int
test: list=5,2,8,2,1,9 bound=6
expect: => i=3 r=0.0 ok=true s="split unique below minimum count 3" errors=0 n=3 res=[5,2,1] cache=0 hits=0
test: list=10,12,10,15 bound=14
expect: => i=2 r=0.0 ok=true s="split unique below minimum count 2" errors=0 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var uniq int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let x = g.res[i];
		if x < b {
			var exists = false;
			for j in uc { if uniq[j] == x { exists = true; } }
			if !exists && uc < 64 { uniq[uc] = x; uc++; }
		}
	}
	gold_clear(g);
	for k in uc { gold_push(g, uniq[k]); }
	g.steps += g.n;
	out.i = uc;
	out.s.clear();
	format(out.s, "split unique below minimum count ", uc);
	out
}
@end
