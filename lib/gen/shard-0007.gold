fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct int[>..] = [];
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] != g.res[i - 1] {
			distinct.push(g.res[i]);
		}
		i++;
	}
	out.s.clear();
	format(out.s, "pairwise deduped: [");
	var first = true;
	for d in distinct {
		if !first { format(out.s, ", "); }
		format(out.s, d);
		first = false;
	}
	format(out.s, "]");
	out.i = distinct.len;
	g.steps += g.n;
	out
}
