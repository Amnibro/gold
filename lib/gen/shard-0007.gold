expect: => i=2 r=0.0 ok=true s="tallied 2 items" errors=0 n=4 res=[3,3,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var vals = [0; 512];
	var counts = [0; 512];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var found = -1;
		for j in u {
			if vals[j] == x { found = j; break; }
		}
		if found >= 0 {
			counts[found] += 1;
		} else {
			vals[u] = x;
			counts[u] = 1;
			u++;
		}
	}
	g.n = 0;
	for j in u {
		gold_push(g, vals[j]);
		gold_push(g, counts[j]);
	}
	out.i = u;
	out.s.clear();
	format(out.s, "tallied ", u, " items");
	g.steps += g.n;
	out
}
@end
