@entry 6f2a2d56211ba4aa
kind: step
verb: apply
noun: streak
modifier: sorted
context: transform
phrase: apply streak counting to sorted elements
phrase: measure consecutive identical streaks in sorted list
test: list=3,1,3,2,1,1
expect: => i=3 r=0.0 ok=true s="applied streak sorted count 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
test: list=5,5,9,2
expect: => i=3 r=0.0 ok=true s="applied streak sorted count 3" errors=0 n=3 res=[1,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var streaks int[64] = [0; 64];
	var sc = 0;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			if sc < 64 { streaks[sc] = cur_streak; sc++; }
			cur_streak = 1;
		}
	}
	if sc < 64 { streaks[sc] = cur_streak; sc++; }
	gold_clear(g);
	for k in sc { gold_push(g, streaks[k]); }
	g.steps += g.n * g.n;
	out.i = sc;
	out.s.clear();
	format(out.s, "applied streak sorted count ", sc);
	out
}
@end
