expect: => i=1 r=0.0 ok=true s="pairwise anomaly spikes: 1" errors=1 n=4 res=[10,25,30,80] cache=0 hits=0
test: list=5,10,15
expect: => i=0 r=0.0 ok=true s="pairwise anomaly spikes: 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient window entries");
		out.ok = false;
		return out;
	}
	var spikes = 0;
	for i in 0..(g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > 20 {
			spikes++;
			g.errors++;
		}
	}
	g.steps += g.n;
	out.i = spikes;
	out.s.clear();
	format(out.s, "pairwise anomaly spikes: ", spikes);
	out
}
@end
