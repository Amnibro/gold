@entry c20183ee1e491ed2
kind: step
verb: dedupe
noun: digits
modifier: sorted
context: format
phrase: dedupe digits into sorted formatted sequence
phrase: format unique digits arranged in ascending order
test: input=93239
expect: => i=3 r=0.0 ok=true s="sorted unique digits: [2, 3, 9]" errors=0 n=0 res=[] cache=0 hits=0
test: input=41514
expect: => i=3 r=0.0 ok=true s="sorted unique digits: [1, 4, 5]" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 { num = -num; }
	var digits int[>..] = [];
	if num == 0 {
		digits.push(0);
	} else {
		while num > 0 {
			let d = num % 10;
			var seen = false;
			for u in digits {
				if u == d { seen = true; break; }
			}
			if !seen { digits.push(d); }
			num /= 10;
		}
	}
	var i = 0;
	while i < digits.len {
		var j = 0;
		while j + 1 < digits.len - i {
			if digits[j] > digits[j + 1] {
				let t = digits[j];
				digits[j] = digits[j + 1];
				digits[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "sorted unique digits: [");
	var first = true;
	for d in digits {
		if !first { format(out.s, ", "); }
		format(out.s, d);
		first = false;
	}
	format(out.s, "]");
	out.i = digits.len;
	g.steps += digits.len * digits.len;
	out
}
@end
