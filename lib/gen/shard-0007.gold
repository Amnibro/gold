code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var val = out.i;
	if val < 0 { val = -val; }
	if val == 0 {
		gold_push(g, 0);
	} else {
		var rev = 0;
		var count = 0;
		while val > 0 {
			rev = rev * 10 + (val % 10);
			val = val / 10;
			count++;
		}
		for k in count {
			gold_push(g, rev % 10);
			rev = rev / 10;
		}
	}
	out.i = g.n;
	out
}
@end
