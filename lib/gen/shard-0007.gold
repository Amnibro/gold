fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_target};
	var found = false;
	var i = 0;
	while i + 1 < g.n {
		var d = g.res[i + 1] - g.res[i];
		if d < 0 { d = -d; }
		if d == st {
			found = true;
			break;
		}
		i++;
	}
	out.ok = found;
	if !found {
		gold_fail(g, "target step difference not found");
	}
	out.i = if found { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
@entry b8c8d6ce94a58fb6
kind: step
verb: sort
noun: odds
modifier: any
context: aggregate
phrase: sort odd elements found in any position
