fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_chars};
	var chars = mc;
	if chars < 0 { chars = 0; }
	if chars > out.s.len { chars = out.s.len; }
	let start = out.s.len - chars;
	var sum = 0;
	var i = start;
	while i < out.s.len {
		sum += out.s[i] as! int;
		i++;
	}
	g.steps += chars;
	out.i = sum;
	out.s.clear();
	format(out.s, "suffix byte sum ", sum);
	out
}
@end
