fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cached_cnt = 0;
	for i in g.n {
		let c = g.res[i];
		let is_v = c == 65 || c == 69 || c == 73 || c == 79 || c == 85 ||
		           c == 97 || c == 101 || c == 105 || c == 111 || c == 117;
		if is_v {
			let _, found = gold_cache_get(g, c);
			if !found {
				gold_cache_put(g, c, c);
				cached_cnt++;
			}
		}
	}
	g.steps += g.n;
	out.i = cached_cnt;
	out.s.clear();
	format(out.s, "cached unique vowel codes");
	out
}
@end
