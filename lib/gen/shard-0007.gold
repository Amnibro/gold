noun: pairs
modifier: every_other
context: filter
phrase: normalize alternating pair values by mean
phrase: scale every other pair of elements to average
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="normalized alternating pairs" errors=0 n=4 res=[15,15,30,40] cache=0 hits=0
test: list=2,4,6,8
expect: => i=2 r=0.0 ok=true s="normalized alternating pairs" errors=0 n=4 res=[3,3,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pair_count = g.n / 2;
	for i in pair_count {
		if i % 2 == 0 {
			let avg = (g.res[2 * i] + g.res[2 * i + 1]) / 2;
			g.res[2 * i] = avg;
			g.res[2 * i + 1] = avg;
		}
	}
	g.steps += pair_count * 2;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "normalized alternating pairs");
	out
}
@end
