code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let start = if g.n > count { g.n - count } else { 0 };
	if start >= g.n { return out; }
	var min_val = g.res[start];
	for i in start .. g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
