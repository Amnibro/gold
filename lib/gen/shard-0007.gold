fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	out.ok = false;
	out.i = -1;
	for i in g.n {
		let val = ${f}(g.res[i]);
		if val == tgt {
			out.ok = true;
			out.i = i;
			break;
		}
	}
	out.s.clear();
	format(out.s, "pos ", out.i);
	out
}
@end
