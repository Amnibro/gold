code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	var matching byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in matching.len {
			if matching[j] == b { seen = true; break; }
		}
		if !seen {
			var cnt = 0;
			for j in out.s.len {
				if out.s[j] == b { cnt++; }
			}
			if cnt <= mf {
				matching.push(b);
				gold_push(g, cnt);
			}
		}
	}
	out.s.clear();
	out.s.append(matching);
	out.i = matching.len;
	out
}
@end
@entry c2cce8888d8709d7
kind: step
verb: drop
noun: threshold
modifier: at_most
context: error
phrase: drop error elements above threshold at most {max_drop} times
phrase: eliminate high faults at most {max_drop} entries
slot: max_drop int
slot: limit int
test: list=10,80,90,20,100 max_drop=2 limit=50
expect: => i=2 r=0.0 ok=true s="dropped threshold at most 2" errors=0 n=3 res=[10,20,100] cache=0 hits=0
test: list=15,25,35 max_drop=1 limit=20
expect: => i=1 r=0.0 ok=true s="dropped threshold at most 1" errors=0 n=2 res=[15,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${max_drop};
	let lim = ${limit};
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] > lim && dropped < max_d {
			dropped++;
		} else {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	if dropped == 0 {
		gold_fail(g, "no error elements dropped at threshold");
		out.ok = false;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped threshold at most ", dropped);
	out
}
@end
@entry 6e54bd51601af7ae
kind: step
verb: rotate
noun: value
modifier: with_cache
context: text
phrase: rotate value with_cache {slot}
phrase: spin value with_cache {slot}
slot: slot int
test: text="abcdef" slot=0
expect: => i=1 r=0.0 ok=true s="bcdefa" errors=0 n=0 res=[] cache=1 hits=0
test: text="hello" slot=2
expect: => i=1 r=0.0 ok=true s="elloh" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sl = ${slot};
	let c_val, ok = gold_cache_get(g, sl);
	var shift = 1;
	if ok && c_val > 0 { shift = c_val; }
	if out.s.len > 0 {
		shift = shift % out.s.len;
		var rot byte[..200] = "";
		for i in out.s.len {
			rot.push(out.s[(i + shift) % out.s.len]);
		}
		out.s.clear();
		out.s.append(rot);
		gold_cache_put(g, sl, out.s[0] as int);
	}
	out.i = shift;
	out
}
@end
