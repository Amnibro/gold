@entry 20ce7a2fc3d6ce55
kind: step
verb: run
noun: memo
modifier: first
context: loop
phrase: run memo lookup first with cache key {key}
phrase: check memo first in loop using key {key}
phrase: evaluate memo first with cache index {key}
slot: key int
test: list=10,20,30 key=1
expect: => i=60 r=0.0 ok=true s="computed memo and stored first" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=10,20 key=0
expect: => i=0 r=0.0 ok=false s="error: invalid memo key" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	if k <= 0 {
		gold_fail(g, "invalid memo key");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid memo key");
		return out;
	}
	let cached_val, hit = gold_cache_get(g, k);
	out.s.clear();
	if hit {
		out.i = cached_val;
		out.ok = true;
		format(out.s, "retrieved memo from cache first");
		return out;
	}
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	gold_cache_put(g, k, total);
	out.i = total;
	out.ok = true;
	format(out.s, "computed memo and stored first");
	g.steps += g.n;
	out
}
@end
