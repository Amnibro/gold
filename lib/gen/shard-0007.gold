@entry 978f44d27c11b1eb
kind: step
verb: rotate
noun: threshold
modifier: times
context: loop
phrase: rotate items exceeding threshold {threshold} by {times} positions
phrase: shift elements above {threshold} times {times} steps
slot: threshold int
slot: times int
test: list=5,20,10,30,15 threshold=15 times=1
expect: => i=3 r=0.0 ok=true s="rotated threshold items times" errors=0 n=5 res=[5,15,10,20,30] cache=0 hits=0
test: list=50,10,60,70 threshold=40 times=2
expect: => i=3 r=0.0 ok=true s="rotated threshold items times" errors=0 n=4 res=[60,10,70,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let t = ${times};
	var idx int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] >= th {
			idx[count] = i;
			count++;
		}
	}
	if count > 1 && t > 0 {
		var vals int[512] = [0; 512];
		for k in count { vals[k] = g.res[idx[k]]; }
		let off = t % count;
		for k in count {
			let dest_idx = (k + off) % count;
			g.res[idx[dest_idx]] = vals[k];
		}
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated threshold items times");
	out
}
@end
