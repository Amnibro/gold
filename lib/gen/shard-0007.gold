code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.s.clear();
		format(out.s, "empty range: 0");
		out.i = 0;
		return out;
	}
	var mn = g.res[0];
	var mx = g.res[0];
	for k in g.n {
		if g.res[k] < mn { mn = g.res[k]; }
		if g.res[k] > mx { mx = g.res[k]; }
	}
	let diff = mx - mn;
	out.s.clear();
	format(out.s, "range span: ", diff);
	out.i = diff;
	g.steps += g.n;
	out
}
@end
