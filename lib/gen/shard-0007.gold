phrase: fill aggregate sum safely reaching threshold {threshold}
phrase: aggregate values filling deficit up to threshold {threshold}
slot: threshold int
test: list=10,20,30 threshold=100
expect: => i=100 r=0.0 ok=true s="safe reached total 100" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15 threshold=30
expect: => i=30 r=0.0 ok=true s="safe reached total 30" errors=0 n=3 res=[5,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${threshold};
	var cur_sum = 0;
	for i in g.n { cur_sum += g.res[i]; }
	if cur_sum < target {
		let deficit = target - cur_sum;
		gold_push(g, deficit);
		cur_sum += deficit;
	}
	g.steps += g.n;
	out.i = cur_sum;
	out.s.clear();
	format(out.s, "safe reached total ", cur_sum);
	out
}
@end
