code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 || out.s.len == 0 { return out; }
	let orig_len = out.s.len;
	var tmp byte[..200] = "";
	for b in out.s { tmp.push(b); }
	var idx = 0;
	while out.s.len < lim && out.s.len < 200 {
		out.s.push(tmp[idx % orig_len]);
		idx++;
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
