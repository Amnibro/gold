@entry 844f6b6bfbb19d46
kind: step
verb: reverse
noun: step
modifier: recursively
context: list
phrase: reverse step recursively with block stride {stride}
phrase: invert chunks recursively by step stride {stride}
slot: stride int
test: list=1,2,3,4,5,6 stride=2
expect: => i=6 r=0.0 ok=true s="reversed stride chunks 6" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
test: list=10,20,30,40 stride=3
expect: => i=3 r=0.0 ok=true s="reversed stride chunks 3" errors=0 n=4 res=[30,20,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if st <= 1 || g.n <= 1 { return out; }
	var base = 0;
	while base + st <= g.n {
		var i = base;
		var j = base + st - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		base += st;
	}
	out.i = base;
	out.s.clear();
	format(out.s, "reversed stride chunks ", base);
	g.steps += g.n;
	out
}
@end
