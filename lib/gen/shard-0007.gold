code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "cache gaps retry: insufficient elements");
		out.ok = false;
		return out;
	}
	var cached = 0;
	for i in g.n - 1 {
		let gap = core_abs_val(g.res[i+1] - g.res[i]);
		gold_cache_put(g, cached, gap);
		cached++;
	}
	gold_push(g, cached);
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached gaps count with retry: ", cached);
	out
}
@end
