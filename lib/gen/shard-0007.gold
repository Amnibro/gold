fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[>..] = [];
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		for a in alt {
			if a == x { seen = true; break; }
		}
		if !seen { alt.push(x); }
		i += 2;
	}
	out.s.clear();
	format(out.s, "alternating unique checkpoint: [");
	var first = true;
	for a in alt {
		if !first { format(out.s, ", "); }
		format(out.s, a);
		first = false;
	}
	format(out.s, "]");
	out.i = alt.len;
	g.steps += g.n;
	out
}
@end
