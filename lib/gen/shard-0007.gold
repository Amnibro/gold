expect: => i=3 r=0.0 ok=true s="kept before gap 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,4,6 threshold=10
expect: => i=3 r=0.0 ok=true s="kept before gap 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var cut = g.n;
	if g.n >= 2 {
		for i in g.n - 1 {
			if g.res[i + 1] - g.res[i] > th {
				cut = i + 1;
				break;
			}
		}
	}
	g.n = cut;
	out.i = cut;
	out.s.clear();
	format(out.s, "kept before gap ", cut);
	out
}
@end
