fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	if ws > 0 && out.s.len > ws {
		let start = out.s.len - ws;
		var win byte[..200] = "";
		for k in ws {
			win.push(out.s[start + k]);
		}
		out.s.clear();
		out.s.append(win);
	}
	for b in out.s { gold_push(g, b as int); }
	out.i = out.s.len;
	out
}
