code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	let transformed = ${f}(min_val);
	g.res[min_idx] = transformed;
	out.i = transformed;
	out
}
@end
