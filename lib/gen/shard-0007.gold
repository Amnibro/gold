fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_chars};
	var count = 0;
	for k in out.s.len {
		if count >= mc { break; }
		let c = out.s[k] as int;
		gold_cache_put(g, c, count);
		count++;
	}
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "cached text characters: ", count);
	out
}
@end
@entry d85908994a51b00b
kind: step
verb: swap
noun: odds
modifier: safely
context: cache
phrase: swap odds safely caching previous indices
phrase: exchange odd elements safely with cache backup
test: list=1,2,3,4,5
expect: => i=1 r=0.0 ok=true s="swapped odds with cache backup: true" errors=0 n=5 res=[5,2,3,4,1] cache=2 hits=0
test: list=10,11,12,13
expect: => i=1 r=0.0 ok=true s="swapped odds with cache backup: true" errors=0 n=4 res=[10,13,12,11] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_odd = -1;
	var last_odd = -1;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			if first_odd < 0 { first_odd = k; }
			last_odd = k;
		}
	}
	if first_odd >= 0 && last_odd > first_odd {
		gold_cache_put(g, first_odd, g.res[first_odd]);
		gold_cache_put(g, last_odd, g.res[last_odd]);
		let t = g.res[first_odd];
		g.res[first_odd] = g.res[last_odd];
		g.res[last_odd] = t;
		out.ok = true;
		out.i = 1;
	} else {
		out.ok = false;
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "swapped odds with cache backup: ", out.ok);
	out
}
@end
@entry 8a52e6ca3add958b
kind: step
verb: check
noun: average
modifier: until
context: cache
phrase: check average until cached threshold {target}
phrase: probe running average until memoized limit {target}
slot: target int
test: list=2,4,6,8,10 target=5
expect: => i=4 r=0.0 ok=true s="items before target average: 4" errors=0 n=5 res=[2,4,6,8,10] cache=4 hits=0
test: list=10,20,30 target=25
expect: => i=3 r=0.0 ok=true s="items before target average: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var count = 0;
	while count < g.n {
		sum += g.res[count];
		count++;
		let avg = sum / count;
		gold_cache_put(g, count, avg);
		if avg >= tgt { break; }
	}
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "items before target average: ", count);
	out
}
@end
@entry 531b5013ec5ac5a0
kind: step
verb: scale
noun: runs
modifier: in_reverse
context: cache
phrase: scale runs in reverse caching cluster lengths
phrase: multiply run counts in reverse with cache
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="cached reverse runs: 3" errors=0 n=6 res=[1,1,2,3,3,3] cache=3 hits=0
test: list=4,4,4,4
expect: => i=1 r=0.0 ok=true s="cached reverse runs: 1" errors=0 n=4 res=[4,4,4,4] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run = 1;
	var idx = g.n - 1;
	var run_id = 0;
	while idx > 0 {
		if g.res[idx] == g.res[idx - 1] {
			run++;
		} else {
			gold_cache_put(g, run_id, run * 2);
			run_id++;
			run = 1;
		}
		idx--;
	}
	gold_cache_put(g, run_id, run * 2);
	run_id++;
	out.i = run_id;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "cached reverse runs: ", run_id);
	out
}
@end
