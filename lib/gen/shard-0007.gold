@entry 09bc375ccceb4b4f
kind: step
verb: split
noun: tally
modifier: sorted
context: transform
phrase: split sorted sequence into frequency tally counts
phrase: partition sorted items counting identical runs
test: list=2,2,3,1,1,1
expect: => i=3 r=0.0 ok=true s="split tally sorted groups count 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=4,4,4,5,6,6
expect: => i=3 r=0.0 ok=true s="split tally sorted groups count 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	var tallies int[64] = [0; 64];
	var tc = 0;
	var cur_count = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_count++;
		} else {
			if tc < 64 { tallies[tc] = cur_count; tc++; }
			cur_count = 1;
		}
	}
	if tc < 64 { tallies[tc] = cur_count; tc++; }
	gold_clear(g);
	for k in tc { gold_push(g, tallies[k]); }
	g.steps += g.n * g.n;
	out.i = tc;
	out.s.clear();
	format(out.s, "split tally sorted groups count ", tc);
	out
}
@end
