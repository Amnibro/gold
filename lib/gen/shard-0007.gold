fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${maxerr};
	var errs = 0;
	var write_idx = 0;
	for k in g.n {
		if g.res[k] < 0 {
			errs++;
			if errs <= mx {
				gold_fail(g, "negative element filtered");
			}
		} else {
