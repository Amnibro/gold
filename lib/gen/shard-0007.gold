@entry b0460e4b7827fa0f
kind: step
verb: dedupe
noun: values
modifier: with_retry
context: cache
phrase: dedupe values with retry attempting passes {retries}
phrase: dedupe values with retry filtering repeats {retries}
slot: retries int
test: list=1,1,2,2,3 retries=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=3 hits=0
test: list=4,5,5,6 retries=1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,5,6] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var unique = 0;
	for k in g.n {
		var seen = false;
		for j in unique {
			if g.res[j] == g.res[k] { seen = true; break; }
		}
		if !seen {
			g.res[unique] = g.res[k];
			gold_cache_put(g, unique, g.res[k]);
			unique++;
		}
	}
	g.n = unique;
	g.steps += r;
	out.i = unique;
	out
}
@end
