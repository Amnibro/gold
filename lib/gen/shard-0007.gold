test: list=2,4,6
expect: => i=4 r=0.0 ok=true s="checked retry average: 4" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,10,20
expect: => i=10 r=0.0 ok=true s="checked retry average: 10" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot average empty retry set");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var outliers = 0;
	for i in g.n {
		if g.res[i] > avg * 2 {
			outliers++;
			g.errors++;
		}
	}
	if outliers > 0 {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "checked retry average: ", avg);
	out
}
@end
@entry 2b49be683b05230d
kind: step
verb: scale
noun: primes
modifier: any
context: retry
phrase: scale primes any encountered prime retry factor
phrase: double any prime retry intervals in series
test: list=4,5,8,9
expect: => i=1 r=0.0 ok=true s="primes scaled: 1" errors=0 n=4 res=[4,10,8,9] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=false s="primes scaled: 0" errors=1 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes_scaled = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				g.res[i] *= 2;
				primes_scaled++;
			}
		}
	}
	if primes_scaled == 0 {
		gold_fail(g, "no primes found to scale");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = primes_scaled;
	out.s.clear();
	format(out.s, "primes scaled: ", primes_scaled);
	out
}
@end
