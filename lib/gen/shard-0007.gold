	if period <= 0 || period * 2 > g.n {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var matches = 0;
	for i in (g.n - period) {
		if g.res[i] == g.res[i + period] {
			matches++;
		}
	}
	let has_loop = matches > 0;
	g.steps += g.n;
	out.ok = has_loop;
	out.i = matches;
	out.s.clear();
	format(out.s, "detected retry loop matches: ", matches);
