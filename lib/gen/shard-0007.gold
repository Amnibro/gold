fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running_sum = 0;
	var limit = 15;
	var exceeded = false;
	for i in g.n {
		running_sum += g.res[i];
		if running_sum > limit {
			exceeded = true;
			g.errors++;
			break;
		}
	}
	if exceeded {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = running_sum;
	out.s.clear();
	format(out.s, "prefix running sum: ", running_sum);
	out
}
@end
