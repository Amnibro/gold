phrase: sort primes running gathering prime entries {limit}
slot: limit int
test: list=4,7,2,9,5 limit=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[4,7,2,9,5] cache=3 hits=0
test: list=11,13,8,3 limit=12
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[11,13,8,3] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var p_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 && x < lim {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				gold_cache_put(g, x, 1);
				p_count++;
			}
		}
	}
	g.steps++;
	out.i = p_count;
	out
}
@end
