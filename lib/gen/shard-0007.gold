fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	out.i = g.n;
	out.ok = g.n > 0;
	out.s.clear();
	format(out.s, "reversed unique: ", g.n);
	g.steps += g.n * g.n;
	out
}
@end
