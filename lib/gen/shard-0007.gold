fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n >= 2 {
		let pairs = g.n / 2;
		for k in pairs {
			g.res[k] = g.res[2 * k] * f + g.res[2 * k + 1];
		}
		g.n = pairs;
		out.i = g.res[0];
	}
	out.s.clear();
	format(out.s, "pairs joined: ", g.n);
	out
}
