@entry bf17f2293071d2d5
kind: step
verb: validate
noun: step
modifier: safely
context: filter
phrase: validate step differences safely under {max_step}
phrase: check consecutive steps safely within limit {max_step}
slot: max_step int
test: list=2,5,8 max_step=4
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=1,10,12 max_step=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var ok = true;
	var i = 0;
	while i + 1 < g.n {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > ms {
			ok = false;
			break;
		}
		i++;
	}
	out.ok = ok;
	if !ok {
		gold_fail(g, "step difference exceeded limit");
	}
	out.i = if ok { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
