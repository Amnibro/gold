@entry e7938e97511ff76f
kind: step
verb: group
noun: gaps
modifier: all
context: error
phrase: group all error gaps by threshold {threshold}
phrase: categorize all fault intervals across {threshold}
slot: threshold int
test: list=10,25,30,60 threshold=10
expect: => i=1 r=0.0 ok=false s="grouped error gaps small 1" errors=1 n=4 res=[10,25,30,60] cache=0 hits=0
test: list=100,105,120,150 threshold=12
expect: => i=1 r=0.0 ok=false s="grouped error gaps small 1" errors=1 n=4 res=[100,105,120,150] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		gold_fail(g, "cannot group gaps with fewer than two errors");
		out.ok = false;
		return out;
	}
	var small_gaps = 0;
	var large_gaps = 0;
	for i in (g.n - 1) {
		let gap = g.res[i + 1] - g.res[i];
		if gap <= th {
			small_gaps++;
		} else {
			large_gaps++;
		}
	}
	if large_gaps > small_gaps {
		gold_fail(g, "large error gaps predominant");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = small_gaps;
	out.s.clear();
	format(out.s, "grouped error gaps small ", small_gaps);
	out
}
@end
