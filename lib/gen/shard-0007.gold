test: list=10,20,30,90,40,80,50 k=4
expect: => i=50 r=0.0 ok=true s="sorted suffix: 4" errors=0 n=7 res=[10,20,30,80,40,90,50] cache=0 hits=0
test: list=1,2,9,3,8,4 k=4
expect: => i=4 r=0.0 ok=true s="sorted suffix: 4" errors=0 n=6 res=[1,2,8,3,9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k > 2 && g.n >= k {
		let start = g.n - k;
		let stride_count = (k + 1) / 2;
		for i in 1..stride_count {
			var j = i;
			while j > 0 && g.res[start + 2 * (j - 1)] > g.res[start + 2 * j] {
				let tmp = g.res[start + 2 * j];
				g.res[start + 2 * j] = g.res[start + 2 * (j - 1)];
				g.res[start + 2 * (j - 1)] = tmp;
				j--;
			}
		}
	}
	if g.n > 0 { out.i = g.res[g.n - 1]; }
	out.s.clear();
	format(out.s, "sorted suffix: ", k);
	out
}
@end
