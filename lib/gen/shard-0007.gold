fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let marker = ${stop_char}[0];
	var count = 0;
	var found = false;
	for i in v.s.len {
		let c = v.s[i];
		if c == marker {
			found = true;
			break;
		}
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			count++;
		}
	}
	if !found {
		gold_fail(g, "stop marker not found while comparing vowels");
		out.ok = false;
	}
	g.steps += v.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "compared vowels until marker ", count);
	out
}
@end
