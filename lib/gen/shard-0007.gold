code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cur_len = 0;
	g.n = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur_len > 0 {
				gold_push(g, cur_len);
				cur_len = 0;
			}
		} else {
			cur_len++;
		}
	}
	if cur_len > 0 { gold_push(g, cur_len); }
	for i in 1..g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "word counts sorted ", g.n);
	out
}
@end
