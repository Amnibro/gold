@entry ec993745f6bd3535
kind: step
verb: rank
noun: spaces
modifier: at_least
context: loop
phrase: rank adjacent gaps reaching at least {min_gap}
phrase: sort intervals of size at least {min_gap}
slot: min_gap int
test: list=1,10,12,25,30 min_gap=5
expect: => i=3 r=0.0 ok=true s="ranked spaces at least gap" errors=0 n=3 res=[5,9,13] cache=0 hits=0
test: list=5,15,18,40 min_gap=8
expect: => i=2 r=0.0 ok=true s="ranked spaces at least gap" errors=0 n=2 res=[10,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var gaps int[512] = [0; 512];
	var g_len = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= mg {
			gaps[g_len] = abs_diff;
			g_len++;
		}
		i++;
	}
	for a in g_len {
		for b in a + 1..g_len {
			if gaps[a] > gaps[b] {
				let tmp = gaps[a];
				gaps[a] = gaps[b];
				gaps[b] = tmp;
			}
		}
	}
	for a in g_len { g.res[a] = gaps[a]; }
	g.n = g_len;
	g.steps += g.n * g_len;
	out.i = g_len;
	out.s.clear();
	format(out.s, "ranked spaces at least gap");
	out
}
@end
@entry 97b1522f57ab0548
kind: step
verb: rotate
noun: runs
modifier: until
context: loop
phrase: rotate loop runs until condition {p} on head
phrase: cycle sequence until first item matches {p}
slot: p pred
test: list=1,3,4,6 p=is_even
expect: => i=2 r=0.0 ok=true s="rotated runs until predicate" errors=0 n=4 res=[4,6,1,3] cache=0 hits=0
test: list=2,4,7,9 p=is_odd
expect: => i=2 r=0.0 ok=true s="rotated runs until predicate" errors=0 n=4 res=[7,9,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var rot = 0;
	while rot < g.n && !${p}(g.res[0]) {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rot++;
	}
	g.steps += rot * g.n;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated runs until predicate");
	out
}
@end
