fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var modified = 0;
	for i in g.n {
		let applied = ${f}(g.res[i]);
		if applied > c {
			g.res[i] = c;
			modified++;
		} else {
			g.res[i] = applied;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "capped count ", modified);
	out
}
@end
