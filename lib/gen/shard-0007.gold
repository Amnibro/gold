fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var pair_res int[64] = [0; 64];
	var pc = 0;
	for i in g.n - 1 {
		if pc < 64 {
			let sum = g.res[i] + g.res[i + 1];
			pair_res[pc] = ${f}(sum);
			pc++;
		}
	}
	gold_clear(g);
	for k in pc {
		gold_push(g, pair_res[k]);
	}
	out.i = pc;
	out.s.clear();
	format(out.s, "pairs count ", pc);
	out
}
@end
