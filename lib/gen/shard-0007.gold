test: list=1,2,3,4,5
expect: => i=2 r=0.0 ok=true s="reverse grouped 2" errors=0 n=2 res=[9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let pairs = g.n / 2;
	for k in pairs {
		let tail_idx = g.n - 1 - (2 * k);
		let a = g.res[tail_idx];
		let b = g.res[tail_idx - 1];
		g.res[k] = a + b;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "reverse grouped ", pairs);
	out
}
@end
