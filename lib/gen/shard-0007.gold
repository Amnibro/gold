fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift} % 26;
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			let shifted = (((b - 'a') + (s as byte)) % 26) + 'a';
			out.s[i] = shifted;
		} else if b >= 'A' && b <= 'Z' {
			let shifted = (((b - 'A') + (s as byte)) % 26) + 'A';
			out.s[i] = shifted;
		}
		gold_push(g, out.s[i] as int);
	}
	out.i = g.n;
	out
}
@end
