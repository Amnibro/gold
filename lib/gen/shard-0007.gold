@entry f42169a818358c26
kind: step
verb: apply
noun: streak
modifier: between
context: core
phrase: apply function {f} to streaks between lengths {min_len} to {max_len}
phrase: transform streak segments between lengths {min_len} to {max_len} with {f}
slot: f fn
slot: min_len int
slot: max_len int
test: list=3,3,5,6,6,6 f=double min_len=2 max_len=2
expect: => i=1 r=0.0 ok=true s="modified 1 streaks" errors=0 n=6 res=[6,6,5,6,6,6] cache=0 hits=0
test: list=1,1,1,2,2 f=inc min_len=3 max_len=3
expect: => i=1 r=0.0 ok=true s="modified 1 streaks" errors=0 n=5 res=[2,2,2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	let max_l = ${max_len};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len >= min_l && len <= max_l {
			let val = ${f}(g.res[i]);
			for k in i..j {
				g.res[k] = val;
			}
			modified++;
		}
		i = j;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "modified ", modified, " streaks");
	g.steps += g.n;
	out
}
@end
