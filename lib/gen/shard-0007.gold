kind: step
verb: collect
noun: streak
modifier: times
context: aggregate
phrase: collect streak occurrences {reps} times above {min_streak}
phrase: aggregate streaks meeting {min_streak} repeated {reps} times
slot: min_streak int
slot: reps int
test: list=1,2,3,0,4,5,6,0,7,8 min_streak=3 reps=2
expect: => i=2 r=0.0 ok=true s="streaks collected 2" errors=0 n=10 res=[1,2,3,0,4,5,6,0,7,8] cache=0 hits=0
test: list=1,2,0,3,4 min_streak=2 reps=1
expect: => i=1 r=0.0 ok=true s="streaks collected 1" errors=0 n=5 res=[1,2,0,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	let r = ${reps};
	var streak = 0;
	var matched_streaks = 0;
	for i in g.n {
		if g.res[i] > 0 {
			streak++;
		} else {
			if streak >= ms {
				matched_streaks++;
				if matched_streaks >= r { break; }
			}
			streak = 0;
		}
	}
	if streak >= ms && matched_streaks < r { matched_streaks++; }
	g.steps += g.n;
	out.i = matched_streaks;
	out.s.clear();
	format(out.s, "streaks collected ", matched_streaks);
	out
}
@end
