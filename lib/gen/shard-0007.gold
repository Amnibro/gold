fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ins = ${val};
	if g.n == 0 { return out; }
	var tmp = [0; 512];
	var count = 0;
	for i in g.n {
		tmp[count] = g.res[i];
		count++;
		if i % 2 == 0 {
			tmp[count] = ins;
			count++;
		}
	}
	for i in count { g.res[i] = tmp[i]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "interleaved count ", count);
	g.steps += count;
	out
}
@end
