fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let f = ${finish};
	if s >= 0 && f < g.n && s < f {
		var i = s;
		var j = f;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		out.i = g.res[s];
	}
	out
}
