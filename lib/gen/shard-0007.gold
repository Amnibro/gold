		out.ok = false;
		return out;
	}
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		g.res[i] *= min_val;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "scaled by minimum: ", min_val);
	out
}
@end
