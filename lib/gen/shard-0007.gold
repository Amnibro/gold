test: list=1,2,3,4,5,6
expect: => i=7 r=0.0 ok=true s="cached middle pair sum: 7" errors=0 n=6 res=[1,2,3,4,5,6] cache=2 hits=0
test: list=10,20,30,40
expect: => i=50 r=0.0 ok=true s="cached middle pair sum: 50" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	let v1 = g.res[mid - 1];
	let v2 = g.res[mid];
	gold_cache_put(g, 0, v1);
	gold_cache_put(g, 1, v2);
	out.i = v1 + v2;
