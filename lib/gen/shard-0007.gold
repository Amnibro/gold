expect: => i=2 r=0.0 ok=true s="runs 2" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var i = 0;
	var runs_count = 0;
	while i < out.s.len {
		let b = out.s[i];
		var run_len = 0;
		while i < out.s.len && out.s[i] == b { run_len++; i++; }
		if run_len >= mr {
			gold_push(g, run_len);
			runs_count++;
		}
	}
	out.i = runs_count;
	out.s.clear();
	format(out.s, "runs ", runs_count);
	out
}
@end
