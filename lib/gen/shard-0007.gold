test: list=5,20,30 p=is_zero
expect: => i=10 r=0.0 ok=true s="budget normalized steps 10" errors=0 n=3 res=[1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var steps = 0;
	while g.n > 0 && !${p}(g.res[g.n - 1]) && steps < 10 {
		g.res[g.n - 1] /= 2;
		var k = g.n - 1;
		while k > 0 && g.res[k] < g.res[k - 1] {
			let t = g.res[k];
			g.res[k] = g.res[k - 1];
			g.res[k - 1] = t;
			k--;
		}
		steps++;
	}
	out.i = steps;
	out.s.clear();
	format(out.s, "budget normalized steps ", steps);
	out
}
@end
