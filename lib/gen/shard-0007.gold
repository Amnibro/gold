fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_prime(x) {
			g.res[m] = x;
			m++;
		}
	}
	g.n = m;
	var i = 0;
	while i < g.n {
		var j = 0;
		while j + 1 < g.n - i {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
			j++;
		}
		i++;
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
