code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] % 2 != 0 && g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited alternating odds count ", clamped);
	out
}
@end
