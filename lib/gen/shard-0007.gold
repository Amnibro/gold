fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var k = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] == min_val {
			dropped++;
		} else {
			g.res[k] = g.res[i];
			k++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "dropped min ", min_val);
	out
}
@end
