@entry 8ed543108ef56128
kind: step
verb: cache
noun: number
modifier: first
context: loop
phrase: cache first number matching target {target}
phrase: store first occurrence of number {target} in cache
phrase: record first number position for target {target}
slot: target int
test: list=11,22,33,22 target=22
expect: => i=1 r=0.0 ok=true s="cached index of first number" errors=0 n=4 res=[11,22,33,22] cache=1 hits=0
test: list=11,22 target=99
expect: => i=0 r=0.0 ok=false s="error: number not found" errors=1 n=2 res=[11,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var found_idx = -1;
	for k in g.n {
		if g.res[k] == t {
			found_idx = k;
			break;
		}
	}
	out.s.clear();
	if found_idx >= 0 {
		gold_cache_put(g, t, found_idx);
		out.i = found_idx;
		out.ok = true;
		format(out.s, "cached index of first number");
	} else {
		gold_fail(g, "target number not found in loop");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: number not found");
	}
	g.steps += g.n;
	out
}
@end
@entry b5e4a37536e15890
kind: step
verb: collect
noun: words
modifier: each
context: loop
phrase: collect each word expecting at least {expected_count} words
phrase: gather each word in loop targeting count {expected_count}
phrase: scan each word in text with minimum {expected_count}
slot: expected_count int
test: text="alpha beta gamma" expected_count=2 list=1,2
expect: => i=3 r=0.0 ok=true s="collected each word in text" errors=0 n=2 res=[1,2] cache=0 hits=0
test: text="alpha" expected_count=3 list=1,2
expect: => i=1 r=0.0 ok=false s="error: word count threshold unmet" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let expected = ${expected_count};
	var count = 0;
	var in_word = false;
	for k in out.s.len {
		let c = out.s[k];
		if c != ' ' && c != '	' {
			if !in_word {
				count++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	out.s.clear();
	if count >= expected && expected > 0 {
		out.i = count;
		out.ok = true;
		format(out.s, "collected each word in text");
	} else {
		gold_fail(g, "word count below expected threshold");
		out.i = count;
		out.ok = false;
		format(out.s, "error: word count threshold unmet");
	}
	g.steps += count;
	out
}
@end
@entry 9433b76d787455f5
kind: step
verb: shift
noun: steps
modifier: until
context: loop
phrase: shift loop steps until finding stop value {stop_val}
phrase: rotate steps in loop until value {stop_val}
phrase: cycle steps through loop until reaching {stop_val}
slot: stop_val int
test: list=10,20,30 stop_val=20
expect: => i=1 r=0.0 ok=true s="shifted steps until match" errors=0 n=3 res=[20,30,10] cache=0 hits=0
test: list=10,20 stop_val=99
expect: => i=2 r=0.0 ok=false s="error: stop value not found" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_val};
	if g.n == 0 {
		gold_fail(g, "cannot shift empty list");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var shifts = 0;
	var found = false;
	for _ in g.n {
		if g.res[0] == stop {
			found = true;
			break;
		}
		let first = g.res[0];
		for j in (g.n - 1) {
			g.res[j] = g.res[j + 1];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	out.s.clear();
	if found {
		out.i = shifts;
		out.ok = true;
		format(out.s, "shifted steps until match");
	} else {
		gold_fail(g, "stop value not found during shift");
		out.i = shifts;
		out.ok = false;
		format(out.s, "error: stop value not found");
	}
	g.steps += shifts;
	out
}
@end
@entry 6216037432507456
kind: step
verb: shift
noun: threshold
modifier: each
context: loop
phrase: shift each value above threshold by delta {delta}
phrase: adjust each threshold exceeding item by {delta}
phrase: increment each threshold item with shift {delta}
slot: delta int
test: input=15 list=10,20,30 delta=5
expect: => i=2 r=0.0 ok=true s="shifted each element above threshold" errors=0 n=3 res=[10,25,35] cache=0 hits=0
test: input=50 list=10,20,30 delta=5
expect: => i=0 r=0.0 ok=false s="error: no elements exceeded threshold" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	let thresh = out.i;
	var shifted = 0;
	for k in g.n {
		if g.res[k] > thresh {
			g.res[k] += d;
			shifted++;
		}
	}
	out.s.clear();
	if shifted > 0 {
		out.i = shifted;
		out.ok = true;
		format(out.s, "shifted each element above threshold");
	} else {
		gold_fail(g, "no elements exceeded threshold");
		out.i = 0;
		out.ok = false;
		format(out.s, "error: no elements exceeded threshold");
	}
	g.steps += g.n;
	out
}
@end
