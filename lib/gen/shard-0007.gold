@entry ae3f033b2cfdace3
kind: step
verb: join
noun: step
modifier: while
context: stats
phrase: join step while {max_diff}
phrase: merge step while {max_diff}
slot: max_diff int
test: list=10,12,25,27,50 max_diff=3
expect: => i=11 r=0.0 ok=true s="condensed: 3" errors=0 n=3 res=[11,26,50] cache=0 hits=0
test: list=1,2,3,10,11 max_diff=2
expect: => i=1 r=0.0 ok=true s="condensed: 3" errors=0 n=3 res=[1,3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n > 1 {
		var w = 0;
		var i = 0;
		while i < g.n {
			if i + 1 < g.n {
				var diff = g.res[i + 1] - g.res[i];
				if diff < 0 { diff = -diff; }
				if diff <= md {
					g.res[w] = (g.res[i] + g.res[i + 1]) / 2;
					w++;
					i += 2;
					continue;
				}
			}
			g.res[w] = g.res[i];
			w++;
			i++;
		}
		g.n = w;
	}
	if g.n > 0 { out.i = g.res[0]; }
	out.s.clear();
	format(out.s, "condensed: ", g.n);
	out
}
@end
