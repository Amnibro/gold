code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_sum = 0;
	var uniq_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if seen_before { dup_sum += x; }
		else { uniq_sum += x; }
	}
	g.steps += g.n;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "dup sum ", dup_sum);
	out
}
@end
