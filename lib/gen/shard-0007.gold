slot: k int
test: list=10,20,50,30,40 k=3
expect: => i=50 r=0.0 ok=true s="sorted tail size: 3" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,9,8,7,6 k=4
expect: => i=9 r=0.0 ok=true s="sorted tail size: 4" errors=0 n=5 res=[1,6,7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k > 1 && g.n >= k {
		let start = g.n - k;
		for i in 1..k {
			var j = start + i;
			while j > start && g.res[j - 1] > g.res[j] {
				let tmp = g.res[j];
				g.res[j] = g.res[j - 1];
				g.res[j - 1] = tmp;
				j--;
			}
		}
	}
	if g.n > 0 { out.i = g.res[g.n - 1]; }
	out.s.clear();
	format(out.s, "sorted tail size: ", k);
	out
}
@end
