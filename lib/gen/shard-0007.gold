fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_len = 0;
	while run_len < g.n && ${p}(g.res[run_len]) {
		run_len++;
	}
	if run_len > 1 {
		for i in run_len {
			for j in (run_len - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	out.i = run_len;
	out
}
@end
