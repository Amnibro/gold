code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	gold_cache_put(g, 1, primes);
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "cached prime count ", primes);
	out
}
@end
