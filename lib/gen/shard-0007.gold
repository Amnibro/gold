	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot average empty error set");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	for i in g.n {
		g.res[i] = (g.res[i] + avg) / 2;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
