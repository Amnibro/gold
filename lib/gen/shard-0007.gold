fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var first_val = g.res[0];
	var first_count = 0;
	var other_count = 0;
	for i in g.n {
		if g.res[i] == first_val { first_count++; }
		else { other_count++; }
	}
	g.steps += g.n;
	out.i = first_count - other_count;
	out.s.clear();
	format(out.s, "histogram balance ", out.i);
	out
}
@end
