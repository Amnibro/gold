phrase: shift retry histogram recursively depth {depth}
phrase: adjust retry error histogram recursively to depth {depth}
slot: depth int
test: list=10,20,30 depth=2
expect: => i=34 r=0.0 ok=true s="shifted histogram recursively calls 2" errors=0 n=3 res=[10,20,34] cache=0 hits=0
test: list=5,15 depth=1
expect: => i=17 r=0.0 ok=true s="shifted histogram recursively calls 1" errors=0 n=2 res=[5,17] cache=0 hits=0
code:
fn ${ID}_hist(g Gold&, d int) int {
	if d <= 0 || g.n == 0 { return 0; }
	g.res[g.n - 1] += 2;
	g.steps++;
	return 1 + ${ID}_hist(g, d - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d > g.n {
		gold_fail(g, "invalid depth for recursive histogram shift");
		out.ok = false;
		return out;
	}
	let calls = ${ID}_hist(g, d);
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "shifted histogram recursively calls ", calls);
	out
}
@end
@entry 0f4882cbc115d584
kind: step
