	let reps = ${repetitions};
	if reps <= 0 || g.n == 0 {
		gold_fail(g, "repetitions must be positive and list non-empty");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid sequence repetitions");
		return out;
	}
	for _ in reps {
		for k in g.n {
			g.res[k] += 1;
		}
	}
	out.i = reps * g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied sequence across specified repetitions");
	g.steps += reps * g.n;
	out
}
