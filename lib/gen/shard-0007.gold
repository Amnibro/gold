code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var matched = false;
	if v.s.len >= tgt.len && tgt.len > 0 {
		for i in (v.s.len - tgt.len + 1) {
			var ok = true;
			for j in tgt.len {
				if v.s[i + j] != tgt[j] {
					ok = false;
					break;
				}
			}
			if ok {
				matched = true;
				break;
			}
		}
	}
	if !matched {
		gold_fail(g, "retry text target not matched");
		out.ok = false;
	}
	g.steps += v.s.len;
	out.i = if matched { 1 } else { 0 };
	out.s.clear();
	format(out.s, "find text with retry matched ", matched);
	out
}
@end
