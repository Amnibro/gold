code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient records to find error sequence");
		out.ok = false;
		return out;
	}
	var is_increasing = true;
	for i in (g.n - 1) {
		if g.res[i + 1] <= g.res[i] {
			is_increasing = false;
			break;
		}
	}
	if !is_increasing {
		gold_fail(g, "error sequence is not monotonic");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "found sequence valid ", is_increasing);
	out
}
@end
