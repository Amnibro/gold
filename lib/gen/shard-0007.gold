code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] {
				dups++;
			}
		}
	}
	if dups > 0 {
		g.errors += dups;
		out.ok = false;
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "duplicate errors: ", dups);
	out
}
@end
@entry fd3f0fee0c21d533
