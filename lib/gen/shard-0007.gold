@entry ab5af7a9b42cdf3d
kind: step
verb: validate
noun: threshold
modifier: pairwise
context: list
phrase: validate threshold pairwise {max_diff}
phrase: check threshold pairwise {max_diff}
slot: max_diff int
test: list=2,5,7,10 max_diff=3
expect: => i=0 r=0.0 ok=true s="valid true" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=2,8,12 max_diff=3
expect: => i=0 r=0.0 ok=false s="valid false" errors=0 n=3 res=[2,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	out.ok = true;
	if g.n > 1 {
		for k in (g.n - 1) {
			var diff = g.res[k + 1] - g.res[k];
			if diff < 0 { diff = -diff; }
			if diff > md {
				out.ok = false;
				break;
			}
		}
	}
	out.s.clear();
	format(out.s, "valid ", out.ok);
	out
}
@end
