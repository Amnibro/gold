fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		g.res[i] = g.res[i+1] - g.res[i];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "in place gaps calculated count: ", g.n);
	out
}
