fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = core_abs_val(g.res[i]);
		var prod = 1;
		while x > 0 {
			let d = x % 10;
			if d != 0 { prod *= d; }
			x /= 10;
		}
		g.res[i] = prod;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ran nested digit product on items count ", g.n);
	out
}
