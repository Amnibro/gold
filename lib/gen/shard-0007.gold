code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${limit};
	var rotations = 0;
	while g.n > 1 && g.res[0] < threshold && rotations < g.n {
		let first = g.res[0];
		for i in (g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rotations++;
	}
	g.steps += g.n;
	out.i = rotations;
	out.s.clear();
	format(out.s, "performed rotations ", rotations);
	out
}
@end
