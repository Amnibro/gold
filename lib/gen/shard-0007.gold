fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sort_len = limit;
	if sort_len > g.n { sort_len = g.n; }
	if sort_len > 1 {
		for i in sort_len {
			for j in (sort_len - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	if g.n > 0 { out.i = g.res[0]; }
	out
}
