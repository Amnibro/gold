code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	if mid < 2 { return out; }
	let first = g.res[0];
	for i in mid - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.res[mid - 1] = first;
	g.steps += mid;
	out.i = mid;
	out.s.clear();
	format(out.s, "rotated prefix elements count ", mid);
	out
}
@end
