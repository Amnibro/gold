fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	gold_cache_put(g, 100, avg);
	var total_dev = 0;
	for i in g.n {
