fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dups = false;
	if out.s.len >= 2 {
		for i in (out.s.len - 1) {
			if out.s[i] == out.s[i + 1] {
				has_dups = true;
				break;
			}
		}
	}
	out.i = if has_dups { 1 } else { 0 };
	if has_dups {
		gold_fail(g, "adjacent duplicate run detected");
		out.ok = false;
		return out;
	}
	out.ok = true;
	g.steps += out.s.len;
	out
}
@end
