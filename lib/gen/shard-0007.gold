@entry 7b1684376fde1100
kind: step
verb: select
noun: window
modifier: up_to
context: stats
phrase: select window up_to size {size} capped by sum {limit}
phrase: find sliding window of width {size} up_to sum {limit}
slot: size int
slot: limit int
test: list=1,2,3,4,5 size=2 limit=6
expect: => i=0 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30 size=2 limit=15
expect: => i=-1 r=0.0 ok=false s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	let lim = ${limit};
	if sz <= 0 || g.n < sz { out.ok = false; out.i = -1; return out; }
	var found = -1;
	let trips = g.n - sz + 1;
	for i in trips {
		var sum = 0;
		for j in sz { sum += g.res[i + j]; }
		if sum <= lim {
			found = i;
			break;
		}
	}
	out.ok = (found >= 0);
	out.i = found;
	g.steps += g.n;
	out
}
@end
