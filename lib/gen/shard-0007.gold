expect: => i=50 r=0.0 ok=true s="dropped max 50" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,1,8
expect: => i=8 r=0.0 ok=true s="dropped max 8" errors=0 n=2 res=[5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var max_idx = 0;
		for i in g.n {
			if g.res[i] > g.res[max_idx] {
				max_idx = i;
			}
		}
		let max_v = g.res[max_idx];
		var k = max_idx;
		while k < g.n - 1 {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.n--;
		out.i = max_v;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "dropped max ", out.i);
	out
}
@end
@entry f16389060a327516
kind: step
verb: collect
noun: function
modifier: unique
context: sort
phrase: collect function unique {f}
phrase: gather function unique {f}
slot: f fn
test: list=3,1,3,2 f=double
expect: => i=3 r=0.0 ok=true s="unique sorted count 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=4,2,4,6 f=halve
expect: => i=3 r=0.0 ok=true s="unique sorted count 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	var unique int[64] = [0; 64];
	var uc = 0;
	for i in g.n {
		let val = g.res[i];
		var exists = false;
		for j in uc {
			if unique[j] == val { exists = true; break; }
		}
		if !exists && uc < 64 {
			unique[uc] = val; uc++;
		}
	}
	gold_clear(g);
	for i in uc { gold_push(g, unique[i]); }
	out.i = uc;
	out.s.clear();
	format(out.s, "unique sorted count ", uc);
	out
}
@end
