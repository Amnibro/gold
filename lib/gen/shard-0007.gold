code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f == 0 {
		g.steps++;
		return out;
	}
	var pairs = g.n / 2;
	for k in pairs {
		g.res[k] = (g.res[2 * k] * g.res[2 * k + 1]) / f;
	}
	g.n = pairs;
	g.steps++;
	out.i = pairs;
	out
}
@end
