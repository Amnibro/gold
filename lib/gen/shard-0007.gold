code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var gap_sum = 0;
	for k in 0..(g.n - 2) {
		let gap = g.res[k + 1] - g.res[k];
		gold_cache_put(g, k, gap);
		gap_sum += gap;
	}
	out.i = gap_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "total gap sum cached: ", gap_sum);
	out
}
@end
