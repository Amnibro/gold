expect: => i=3 r=0.0 ok=true s="limited minimum between range 3" errors=0 n=3 res=[10,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if g.n == 0 || low > high {
		gold_fail(g, "invalid bounds or empty error list");
		out.ok = false;
		return out;
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] < low {
			g.res[i] = low;
			clamped++;
		}
	}
	if clamped == 0 {
		gold_fail(g, "no minimum errors required bounding");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "limited minimum between range ", clamped);
	out
}
@end
