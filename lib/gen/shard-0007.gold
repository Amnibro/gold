slot: high int
test: list=10,25,50 low=20 high=30
expect: => i=1 r=0.0 ok=true s="found item in range" errors=0 n=3 res=[10,25,50] cache=0 hits=0
test: list=5,15,45 low=20 high=30
expect: => i=0 r=0.0 ok=false s="no item in range" errors=0 n=3 res=[5,15,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			found = true;
			break;
		}
	}
	out.ok = found;
	out.s.clear();
	if found {
		out.i = 1;
		out.s.append("found item in range");
	} else {
		out.i = 0;
		out.s.append("no item in range");
	}
	g.steps += g.n;
	out
}
@end
@entry 48e943f8b1dda134
kind: step
verb: check
noun: runs
modifier: recursively
context: math
phrase: check consecutive equal runs in math sequence
phrase: verify repeating runs structure in results
phrase: inspect equal consecutive runs in math list
test: list=1,1,2,3,3,3
expect: => i=2 r=0.0 ok=true s="consecutive runs: 2" errors=0 n=6 res=[1,1,2,3,3,3] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=false s="consecutive runs: 0" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_count = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i > 1 { run_count++; }
		i = j;
	}
	out.i = run_count;
	out.ok = run_count > 0;
	out.s.clear();
	format(out.s, "consecutive runs: ", run_count);
	g.steps += g.n;
	out
}
@end
