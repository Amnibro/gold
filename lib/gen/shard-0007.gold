@entry 5ecd047955e25281
kind: step
verb: keep
noun: streak
modifier: recursively
context: stats
phrase: keep streak recursively preserving longest ascending run
phrase: extract longest monotonic increasing streak recursively
test: list=3,1,2,3,4,1,2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,4,3,2,1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	out.i = best_len;
	g.steps += g.n;
	out
}
