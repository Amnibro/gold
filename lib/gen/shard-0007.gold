code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = g.n - 1;
	while i >= 0 && ${p}(g.res[i]) {
		i--;
	}
	let start = i + 1;
	let len = g.n - start;
	for k in len {
		g.res[k] = g.res[start + k];
	}
	g.n = len;
	g.steps += g.n + 1;
	out.i = len;
	out.s.clear();
	format(out.s, "returned suffix while matching");
	out
}
@end
