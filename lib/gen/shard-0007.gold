@entry cf25cd19c1f26e1f
kind: step
verb: sort
noun: budget
modifier: all
context: stats
phrase: sort budget all {budget}
phrase: order budget all within {budget}
slot: budget int
test: list=50,10,40,20,30 budget=3
expect: => i=3 r=0.0 ok=true s="swaps used: 3" errors=0 n=5 res=[10,40,20,50,30] cache=0 hits=0
test: list=9,1,8,2 budget=2
expect: => i=2 r=0.0 ok=true s="swaps used: 2" errors=0 n=4 res=[1,8,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${budget};
	var swaps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var j = i;
			while j > 0 && g.res[j - 1] > g.res[j] && swaps < max_swaps {
				let tmp = g.res[j];
				g.res[j] = g.res[j - 1];
				g.res[j - 1] = tmp;
				swaps++;
				j--;
			}
			if swaps >= max_swaps { break; }
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swaps used: ", swaps);
	out
}
@end
