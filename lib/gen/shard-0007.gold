noun: series
modifier: recursively
context: aggregate
phrase: normalize series aggregating pairs recursively
phrase: aggregate sequence normalizing recursively to single total
test: list=1,2,3,4,5,6,7,8
expect: => i=36 r=0.0 ok=true s="normalized recursive 36" errors=0 n=8 res=[1,2,3,4,5,6,7,8] cache=0 hits=0
test: list=10,20,30,40
expect: => i=1 r=0.0 ok=true s="normalized recursive 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var total = 0;
	for i in g.n { total += g.res[i]; }
	while total >= 100 {
		var next_total = 0;
		var tmp = total;
		while tmp > 0 {
			next_total += tmp % 10;
			tmp /= 10;
		}
		total = next_total;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "normalized recursive ", total);
	out
}
@end
