@entry f3ce3c4c55e7563c
kind: step
verb: repeat
noun: vowels
modifier: until
context: aggregate
phrase: repeat vowels until target count {target} reached
phrase: aggregate repeating vowels until limit {target}
slot: target int
test: text="cat" target=4
expect: => i=4 r=0.0 ok=true s="aaaa" errors=0 n=0 res=[] cache=0 hits=0
test: text="boat" target=6
expect: => i=6 r=0.0 ok=true s="oaoaoa" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${target};
	var vowels byte[>..] = [];
	for i in v.s.len {
		let c = v.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels.push(c);
		}
	}
	var res byte[>..] = [];
	if vowels.len > 0 {
		while res.len < limit {
			for k in vowels.len {
				if res.len < limit {
					res.push(vowels[k]);
				}
			}
		}
	}
	out.s.clear();
	out.s.append(res);
	g.steps += limit;
	out.i = res.len;
	out
}
@end
