code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 {
		gold_fail(g, "empty results for head validation");
		out.ok = false;
		return out;
	}
	let valid = g.res[0] <= limit;
	if !valid { gold_fail(g, "head element exceeds limit"); }
	g.steps += 1;
	out.ok = valid;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "head element validation status: ", valid);
	out
}
@end
