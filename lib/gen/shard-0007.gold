			tmp[kept] = g.res[i];
			kept++;
			tmp[kept] = g.res[i + 1];
			kept++;
		}
	}
	for i in kept { g.res[i] = tmp[i]; }
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "running pairs kept ", kept);
	g.steps += g.n;
	out
}
