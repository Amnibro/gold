test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="primes in place count: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var primes_count = 0;
	while i < g.n {
		if core_is_prime(g.res[i]) {
			primes_count++;
			i++;
		} else {
			for j in (g.n - 1 - i) {
				g.res[i + j] = g.res[i + 1 + j];
			}
			g.n--;
		}
	}
	g.steps += g.n + primes_count;
	out.i = primes_count;
	out.s.clear();
	format(out.s, "primes in place count: ", primes_count);
	out
}
@end
