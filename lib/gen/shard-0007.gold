expect: => i=4 r=0.0 ok=true s="tail elements before target: 4" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && g.res[i] != tgt {
		count++;
		i--;
	}
	out.s.clear();
	format(out.s, "tail elements before target: ", count);
	out.i = count;
	g.steps += count + 1;
	out
}
@end
