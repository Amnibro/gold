fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var run_count = 1;
	for i in (g.n - 1) {
		if g.res[i] == g.res[i + 1] {
			run_count++;
		}
	}
	let to_add = if run_count < limit { limit - run_count } else { 0 };
	for i in to_add {
		gold_push(g, run_count);
	}
	g.steps += g.n + to_add;
	out.i = run_count;
	out.s.clear();
	format(out.s, "filled retry runs up to cap ", limit);
	out
}
@end
