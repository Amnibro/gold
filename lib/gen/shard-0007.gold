fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var k = 0;
	for i in g.n {
		let x = g.res[i];
		var sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq = true; }
		}
		if sq {
			g.res[k] = x;
			k++;
			count++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found squares ", count);
	out
}
@end
