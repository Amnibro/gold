fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	if num < 0 { num = -num; }
	var digits int[>..] = [];
	while num > 0 {
		digits.push(num % 10);
		num /= 10;
	}
	gold_clear(g);
	var i = digits.len - 1;
	while i >= 0 {
		let d = digits[i];
		if !${pred}(d) {
			break;
		}
		gold_push(g, d);
		i--;
	}
	out.i = g.n;
	g.steps += digits.len;
	out
}
