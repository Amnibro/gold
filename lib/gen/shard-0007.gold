fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sorted_count = 1;
	if g.n == 0 { sorted_count = 0; }
	else if g.n >= 2 {
		for i in g.n - 1 {
			if i >= lim { break; }
			if g.res[i] <= g.res[i + 1] {
				sorted_count++;
			} else {
				break;
			}
		}
	}
	out.i = sorted_count;
	out.s.clear();
	format(out.s, "sorted prefix length ", sorted_count);
	out
}
@end
