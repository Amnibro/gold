fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cp = ${cap};
	var p_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 && x <= cp {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { p_count++; }
		}
	}
	if p_count == 0 {
		gold_fail(g, "no primes found under cap");
		out.ok = false;
	}
	g.steps++;
	out.i = p_count;
	out
}
@end
