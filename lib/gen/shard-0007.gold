fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var budget = 10;
	var kept = 0;
	var sum = 0;
	for i in g.n {
		if sum + g.res[i] <= budget {
			sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	if kept == 0 {
		gold_fail(g, "initial retry exceeds quota");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "head retries within quota: ", kept);
	out
}
