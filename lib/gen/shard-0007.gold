expect: => i=83 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello WORLD"
expect: => i=86 r=0.0 ok=true s="WOR" errors=0 n=3 res=[87,79,82] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 0 {
		var sum = 0;
		for b in out.s { sum += b as int; }
		let avg = sum / out.s.len;
		var kept byte[..200] = "";
		for b in out.s {
			let code = b as int;
			let diff = if code >= avg { code - avg } else { avg - code };
			if diff <= 8 {
				kept.push(b);
				gold_push(g, code);
			}
		}
		out.s.clear();
		out.s.append(kept);
	out.i = avg;
	}
	out
}
@end
