@entry 44527d4187832ee1
kind: step
verb: rotate
noun: histogram
modifier: in_reverse
context: math
phrase: rotate histogram in_reverse {shift}
phrase: cycle histogram in_reverse {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=10 r=0.0 ok=true s="" errors=0 n=4 res=[10,40,30,20] cache=0 hits=0
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,1,5,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	if g.n > 0 && s > 0 {
		var temp = [0; 512];
		for i in g.n {
			temp[(i + s) % g.n] = g.res[i];
		}
		for i in g.n {
			g.res[i] = temp[i];
		}
	}
	if g.n > 0 { out.i = g.res[0]; }
	out
}
@end
