code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = tmp;
			}
		}
	}
	if st >= 0 && st < g.n {
		var unique int[64] = [0; 64];
		var uc = 0;
		for i in st..g.n {
			let val = g.res[i];
			var found = false;
			for j in uc {
				if unique[j] == val { found = true; break; }
			}
			if !found && uc < 64 {
				unique[uc] = val; uc++;
			}
		}
		g.n = st;
		for i in uc {
			gold_push(g, unique[i]);
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "suffix unique len ", g.n);
	out
}
@end
