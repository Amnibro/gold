code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${th};
	if g.n < 2 { return out; }
	let pairs = g.n / 2;
	var cached_count = 0;
	for i in pairs {
		let s = g.res[2 * i] + g.res[2 * i + 1];
		if s >= cutoff {
			gold_cache_put(g, cached_count, s);
			cached_count++;
		}
	}
	g.steps += pairs;
	out.i = cached_count;
	out.s.clear();
	format(out.s, "pairs above threshold ", cached_count);
	out
}
@end
