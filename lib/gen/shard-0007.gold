fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let start = 1;
		let end = g.n - 2;
		var i = start;
		var j = end;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		out.i = g.res[1];
	}
	out
}
@end
