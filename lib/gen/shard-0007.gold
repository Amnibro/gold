phrase: transform sequence finding squares at most {limit}
slot: limit int
test: list=4,9,16,25,36 limit=20
expect: => i=3 r=0.0 ok=true s="found squares at most 3" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,8,10 limit=5
expect: => i=1 r=0.0 ok=true s="found squares at most 1" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var k = 0;
	for i in g.n {
		let x = g.res[i];
		var sq = false;
		if x >= 0 && x <= lim {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq = true; }
		}
		if sq {
			g.res[k] = x;
			k++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "found squares at most ", k);
	out
}
@end
