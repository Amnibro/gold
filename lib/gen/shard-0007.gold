fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	var dup_total = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > 1 {
			g.res[k] = x;
			k++;
			dup_total += x;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = dup_total;
	out.s.clear();
	format(out.s, "duplicate aggregate ", dup_total);
	out
}
@end
