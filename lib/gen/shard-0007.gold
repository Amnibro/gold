@entry 3b5a61a00dbe1557
kind: step
verb: check
noun: primes
modifier: in_place
context: cache
phrase: check primes in place caching primality status
phrase: test primes in place memoizing prime flags
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="primes checked and cached: 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=6 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="primes checked and cached: 2" errors=0 n=4 res=[10,11,12,13] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		let flag = if is_p { 1 } else { 0 };
		gold_cache_put(g, x, flag);
		if is_p { prime_count++; }
	}
	out.i = prime_count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "primes checked and cached: ", prime_count);
	out
}
@end
