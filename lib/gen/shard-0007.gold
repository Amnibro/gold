code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bsz = ${bucket_size};
	if bsz <= 0 || g.n == 0 {
		gold_fail(g, "bucket size must be positive and list non-empty");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "error: invalid sorted grouping parameters");
		return out;
	}
	for i in g.n {
		for j in (g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	let buckets = (g.n + bsz - 1) / bsz;
	out.i = buckets;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped sorted list into buckets");
	g.steps += g.n;
	out
}
@end
