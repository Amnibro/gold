		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let code = (c - 'a' + (off as byte)) % 26;
			out.s[i] = 'a' + code;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
