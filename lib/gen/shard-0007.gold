fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_spaces byte[>..] = [];
	var space_count = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			space_count++;
		} else {
			non_spaces.push(out.s[i]);
		}
	}
	for i in space_count {
		non_spaces.push(' ');
	}
	out.s.clear();
	out.s.append(non_spaces);
	g.steps += out.s.len;
	out.i = space_count;
	out
}
@end
