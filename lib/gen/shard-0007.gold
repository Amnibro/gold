phrase: validate sample prime count with_retry against {expected}
slot: expected int
test: list=2,3,4,5,6 expected=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=8,9,10 expected=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	out.i = primes;
	if primes != exp {
		gold_fail(g, "prime count mismatch");
		out.ok = false;
		return out;
	}
	out.ok = true;
	g.steps += g.n;
	out
}
@end
