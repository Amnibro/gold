kind: step
verb: split
noun: duplicates
modifier: with_retry
context: core
phrase: split duplicates into separate halves with retry limit {retries}
phrase: separate duplicate values with retry count {retries}
slot: retries int
test: list=2,3,2,4,3 retries=2
expect: => i=2 r=0.0 ok=true s="separated 2 duplicate values" errors=0 n=5 res=[2,3,4,2,3] cache=0 hits=0
test: list=5,5,5 retries=1
expect: => i=2 r=0.0 ok=true s="separated 2 duplicate values" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[512] = [0; 512];
	var uniq int[512] = [0; 512];
	var dups int[512] = [0; 512];
	var nu = 0;
	var nd = 0;
	for k in g.n {
		let x = g.res[k];
		var is_dup = false;
		for i in nu {
			if uniq[i] == x {
				is_dup = true;
				break;
			}
		}
		if is_dup {
			dups[nd] = x;
			nd++;
		} else {
			uniq[nu] = x;
			nu++;
		}
	}
	for k in nu { g.res[k] = uniq[k]; }
	for k in nd { g.res[nu + k] = dups[k]; }
	out.i = nd;
	out.s.clear();
	format(out.s, "separated ", nd, " duplicate values");
	g.steps += g.n;
	out
}
@end
@entry 4a62b8f926666c71
kind: step
verb: fill
noun: average
modifier: sorted
context: core
phrase: fill average into sorted positions
phrase: replace elements with sorted average baseline
test: list=10,2,6
expect: => i=6 r=0.0 ok=true s="filled average baseline 6" errors=0 n=3 res=[6,6,10] cache=0 hits=0
test: list=1,1,10
expect: => i=4 r=0.0 ok=true s="filled average baseline 4" errors=0 n=3 res=[4,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	for k in g.n {
		if g.res[k] < avg { g.res[k] = avg; }
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = avg;
	out.s.clear();
	format(out.s, "filled average baseline ", avg);
	g.steps += g.n;
	out
}
@end
