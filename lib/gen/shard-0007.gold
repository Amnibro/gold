@entry 7a9dfe9f9c0149ca
kind: step
verb: group
noun: numbers
modifier: at_most
context: format
phrase: group numbers in chunks of at most {chunk_size} items
phrase: format numbers into groups containing at most {chunk_size} elements
slot: chunk_size int
test: list=1,2,3,4,5 chunk_size=2
expect: => i=3 r=0.0 ok=true s="[1,2] [3,4] [5]" errors=0 n=6 res=[1,2,3,4,5,3] cache=0 hits=0
