@entry 3de846858ebb965e
kind: step
verb: group
noun: spaces
modifier: with_retry
context: aggregate
phrase: group whitespace intervals aggregating with retry
phrase: aggregate space runs grouping intervals with retry
test: text="one  two   three"
expect: => i=5 r=0.0 ok=true s="aggregated spaces 5" errors=0 n=0 res=[] cache=0 hits=0
test: text="nospaces"
expect: => i=0 r=0.0 ok=true s="aggregated spaces 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_spaces = 0;
	var in_space = false;
	var runs = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			total_spaces++;
			if !in_space { runs++; in_space = true; }
		} else {
			in_space = false;
		}
	}
	if runs == 0 {
		// retry scan on underscores
		for i in out.s.len {
			if out.s[i] == '_' { total_spaces++; runs++; }
		}
	}
	g.steps += out.s.len;
	out.i = total_spaces;
	out.s.clear();
	format(out.s, "aggregated spaces ", total_spaces);
	out
}
@end
