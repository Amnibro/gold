@entry 7f22efa5c7ce3f61
kind: step
verb: drop
noun: average
modifier: in_place
context: filter
phrase: drop average in place elements below mean plus {offset}
phrase: drop average in place values under mean {offset}
slot: offset int
test: list=10,20,30,40 offset=0
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15 offset=5
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 {
		g.steps++;
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n + off;
	var write_idx = 0;
	for k in g.n {
		if g.res[k] >= avg {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps++;
	out.i = write_idx;
	out
}
@end
