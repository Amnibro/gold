fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniques int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for u in uniques {
			if u == x { seen = true; break; }
		}
		if !seen { uniques.push(x); }
	}
	out.s.clear();
	format(out.s, "results unique count: ", uniques.len);
	out.i = uniques.len;
	g.steps += g.n;
	out
}
@end
