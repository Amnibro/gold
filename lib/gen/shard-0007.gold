fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	if sz <= 0 || g.n == 0 { return out; }
	var sums int[64] = [0; 64];
	var sc = 0;
	var cur_sum = 0;
	var in_chunk = 0;
	for i in g.n {
		cur_sum += g.res[i];
		in_chunk++;
		if in_chunk == sz {
			if sc < 64 { sums[sc] = cur_sum; sc++; }
			cur_sum = 0;
			in_chunk = 0;
		}
	}
	if in_chunk > 0 && sc < 64 {
		sums[sc] = cur_sum;
		sc++;
	}
	gold_clear(g);
	for k in sc { gold_push(g, sums[k]); }
	g.steps += g.n;
	out.i = sc;
	out.s.clear();
	format(out.s, "split items at most chunk size ", sz);
	out
}
@end
