@entry 497e20df4e528425
kind: step
verb: swap
noun: evens
modifier: sorted
context: stats
phrase: swap evens sorted in ascending observation order
phrase: sort even numbers in series keeping odds fixed
test: list=8,3,4,1,2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,4,1,8] cache=0 hits=0
test: list=6,5,2,7,4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,5,4,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_indices = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			even_indices[count] = i;
			count++;
		}
	}
	if count > 1 {
		for i in count {
			for j in (count - 1) {
				let idx1 = even_indices[j];
				let idx2 = even_indices[j + 1];
				if g.res[idx1] > g.res[idx2] {
					let tmp = g.res[idx1];
					g.res[idx1] = g.res[idx2];
					g.res[idx2] = tmp;
				}
			}
		}
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
