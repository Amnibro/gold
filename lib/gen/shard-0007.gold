@entry 016b5c800bd2f882
kind: step
verb: walk
noun: delta
modifier: pairwise
context: math
phrase: walk sequence verifying non negative pairwise deltas
phrase: traverse items checking pairwise monotonic climb
test: list=1,4,4,9
expect: => i=3 r=0.0 ok=true s="monotonic climb verified across 3 pairs" errors=0 n=4 res=[1,4,4,9] cache=0 hits=0
test: list=3,8,5
expect: => i=1 r=0.0 ok=false s="climb failed at step 1" errors=1 n=3 res=[3,8,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.ok = true;
		out.s.clear();
		out.s.append("empty or single item verified");
		return out;
	}
	var i = 0;
	while i < g.n - 1 {
		if g.res[i + 1] < g.res[i] {
			g.errors += 1;
			out.i = i;
			out.ok = false;
			out.s.clear();
			format(out.s, "climb failed at step ", i);
			return out;
		}
		i += 1;
	}
	out.i = i;
	out.ok = true;
	out.s.clear();
	format(out.s, "monotonic climb verified across ", i, " pairs");
	g.steps += i;
	out
}
@end
