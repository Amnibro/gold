fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.cn {
		for j in i + 1..g.cn {
			if g.cv[i] > g.cv[j] {
				let tmp_v = g.cv[i];
				let tmp_k = g.ck[i];
				g.cv[i] = g.cv[j];
				g.ck[i] = g.ck[j];
				g.cv[j] = tmp_v;
				g.ck[j] = tmp_k;
			}
		}
	}
	for i in g.n {
		let val, ok = gold_cache_get(g, g.res[i]);
		if !ok { gold_cache_put(g, g.res[i], g.res[i]); }
	}
	g.steps += g.cn * g.cn + g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "ranked memo cache sorted");
	out
}
