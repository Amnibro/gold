@entry 07c65d02709a8a19
kind: step
verb: scan
noun: minimum
modifier: nested
context: list
phrase: scan minimum nested across adjacent triples
phrase: find nested minimum over local windows
test: list=9,4,7,2,8
expect: => i=2 r=0.0 ok=true s="nested min count 3" errors=0 n=3 res=[4,2,2] cache=0 hits=0
test: list=15,12,18,6,3
expect: => i=3 r=0.0 ok=true s="nested min count 3" errors=0 n=3 res=[12,6,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need triple for nested min");
		out.ok = false;
		return out;
	}
	let trips = g.n - 2;
	var tmp = [0; 512];
	var min_overall = g.res[0];
	for i in trips {
		var m = g.res[i];
		if g.res[i + 1] < m { m = g.res[i + 1]; }
		if g.res[i + 2] < m { m = g.res[i + 2]; }
		tmp[i] = m;
		if m < min_overall { min_overall = m; }
	}
	for i in trips { g.res[i] = tmp[i]; }
	g.n = trips;
	out.i = min_overall;
	out.s.clear();
	format(out.s, "nested min count ", trips);
	g.steps += trips;
	out
}
@end
