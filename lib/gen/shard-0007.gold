expect: => i=2 r=0.0 ok=false s="step regressions: 2" errors=2 n=3 res=[50,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient steps to compare");
		out.ok = false;
		return out;
	}
	var regressions = 0;
	for i in 0..(g.n - 1) {
		if g.res[i + 1] < g.res[i] {
			regressions++;
			g.errors++;
		}
	}
	if regressions > 0 {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = regressions;
	out.s.clear();
	format(out.s, "step regressions: ", regressions);
	out
}
@end
