code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached_idx, ok = gold_cache_get(g, tgt);
	if ok {
		out.i = cached_idx;
		gold_push(g, cached_idx);
	} else {
		var found = -1;
		for i in g.n {
			if g.res[i] == tgt {
				found = i;
				break;
			}
		}
		gold_cache_put(g, tgt, found);
		out.i = found;
		gold_push(g, found);
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "searched item with cache");
	out
}
@end
