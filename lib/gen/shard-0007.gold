code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var spent = 0;
	var steps_done = 0;
	for i in g.n {
		let cost = g.res[i];
		if spent + cost <= ceil {
			spent += cost;
			steps_done++;
		} else {
			gold_fail(g, "error budget exhausted");
			out.ok = false;
			break;
		}
	}
	g.steps += steps_done;
	out.i = spent;
	out.s.clear();
	format(out.s, "error budget consumed ", spent);
	out
}
@end
