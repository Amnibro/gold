code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var count = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			count++;
		} else {
			break;
		}
	}
	gold_push(g, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked first budget count ", count);
	out
}
@end
