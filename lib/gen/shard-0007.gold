code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp = ${expected};
	var unique_count = 0;
	for k in g.n {
		var first_seen = true;
		for j in k {
			if g.res[j] == g.res[k] {
				first_seen = false;
				break;
			}
		}
		if first_seen {
			unique_count++;
		}
	}
	out.ok = (unique_count == exp);
	g.steps++;
	out.i = unique_count;
	out
}
@end
