test: list=9,1,2,3 retries=2
expect: => i=2 r=0.0 ok=true s="shifted maximum 2 positions" errors=0 n=4 res=[1,2,9,3] cache=0 hits=0
test: list=5,10,1 retries=1
expect: => i=1 r=0.0 ok=true s="shifted maximum 1 positions" errors=0 n=3 res=[5,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_attempts = ${retries};
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		out.s.append("shifted maximum 0 positions");
		return out;
	}
	var max_idx = 0;
	for k in 1..g.n {
		if g.res[k] > g.res[max_idx] { max_idx = k; }
	}
	var shifts = 0;
	while shifts < max_attempts && max_idx + 1 < g.n {
		let tmp = g.res[max_idx];
		g.res[max_idx] = g.res[max_idx + 1];
		g.res[max_idx + 1] = tmp;
		max_idx++;
		shifts++;
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "shifted maximum ", shifts, " positions");
	g.steps += shifts;
	out
}
@end
