kind: step
verb: filter
noun: duplicates
modifier: safely
context: aggregate
phrase: filter duplicate elements safely calculating unique sum
phrase: aggregate unique values filtering duplicates safely
test: list=1,2,2,3,3,4
expect: => i=10 r=0.0 ok=true s="filtered duplicates safely unique sum 10" errors=0 n=7 res=[1,2,2,3,3,4,10] cache=0 hits=0
test: list=5,5,5,10
expect: => i=15 r=0.0 ok=true s="filtered duplicates safely unique sum 15" errors=0 n=5 res=[5,5,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			sum += g.res[i];
		}
	}
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "filtered duplicates safely unique sum ", sum);
	out
}
@end
