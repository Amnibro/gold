code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var steps_taken = 0;
	var found = false;
	for k in g.n {
		steps_taken++;
		if g.res[k] == tgt {
			found = true;
			break;
		}
	}
	out.i = steps_taken;
	gold_cache_put(g, tgt, steps_taken);
	out.ok = found;
	if !found {
		gold_fail(g, "target not found during memo rotation");
	}
	g.steps += steps_taken;
	out
}
@end
