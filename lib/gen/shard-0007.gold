fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var retried = 0;
	let limit = if g.n < 2 { g.n } else { 2 };
	for i in limit {
		if g.res[i] < 0 {
			g.res[i] = -g.res[i];
			retried++;
			g.errors++;
		}
	}
	if retried < 1 && g.n >= 2 {
		out.ok = true;
	}
	g.steps += g.n + retried;
	out.i = retried;
	out.s.clear();
	format(out.s, "retried prefix errors: ", retried);
	out
}
@end
