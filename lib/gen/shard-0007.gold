test: list=5,12,20 max_gap=5
expect: => i=1 r=0.0 ok=true s="clamped 1" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var clamped = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		if diff > mg {
			g.res[k + 1] = g.res[k] + mg;
			clamped++;
		}
		k += 2;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped);
	out
}
@end
