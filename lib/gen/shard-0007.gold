fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for k in (g.n - 1) {
			var diff = g.res[k] - g.res[k + 1];
			if diff < 0 { diff = -diff; }
			g.res[k] = diff;
		}
		g.n--;
		out.i = g.res[0];
	}
	out.s.clear();
	format(out.s, "norm ", out.i);
	out
}
