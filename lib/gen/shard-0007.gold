fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var err_count = 0;
	for i in g.n {
		if g.res[i] < 0 { err_count++; }
	}
	let pairs = err_count / 2;
	var k = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] < 0 && g.res[i + 1] < 0 {
			g.res[k] = g.res[i] + g.res[i + 1];
			k++;
			i += 2;
		} else {
			i++;
		}
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "grouped error pairs ", k);
	out
}
