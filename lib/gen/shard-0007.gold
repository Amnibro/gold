code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	let tgt = ${target};
	var max_sum = 0;
	out.ok = false;
	if g.n >= w && w > 0 {
		for i in (g.n - w + 1) {
			var cur_sum = 0;
			for j in w {
				cur_sum += g.res[i + j];
			}
			if cur_sum >= tgt && (!out.ok || cur_sum > max_sum) {
				max_sum = cur_sum;
				out.ok = true;
			}
		}
	}
	out.i = max_sum;
	out.s.clear();
	format(out.s, "window ", max_sum);
	out
}
@end
