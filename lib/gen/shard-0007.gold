fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_streak = ${min_len};
	var cur = 1;
	var max_s = if g.n > 0 { 1 } else { 0 };
	if g.n > 1 {
		for k in 1..g.n {
			if g.res[k] > g.res[k - 1] {
				cur++;
				if cur > max_s { max_s = cur; }
			} else {
				cur = 1;
			}
		}
	}
	if max_s >= min_streak {
		gold_cache_put(g, min_streak, max_s);
	}
	g.steps++;
	out.i = max_s;
	out
}
@end
