slot: tolerance int
test: list=5,6,7 tolerance=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,6,7] cache=0 hits=0
test: list=5,15,30 tolerance=2
expect: => i=3 r=0.0 ok=false s="" errors=1 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var ok_variance = true;
	if g.n > 1 {
		for k in g.n - 1 {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff > tol {
				ok_variance = false;
				break;
			}
		}
	}
	if !ok_variance {
		gold_fail(g, "variance exceeded tolerance");
		out.ok = false;
	}
	g.steps++;
	out.i = g.n;
	out
}
@end
