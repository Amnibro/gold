fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 1 || g.n <= 1 { return out; }
	let k = if cnt < g.n { cnt } else { g.n };
	var sum = 0;
	for i in k { sum += g.res[i]; }
	g.res[0] = sum;
	let rem = g.n - k;
	for i in rem { g.res[1 + i] = g.res[k + i]; }
	g.n = 1 + rem;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged prefix of ", k);
	g.steps += g.n;
	out
}
@end
