code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	var new_n = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[new_n - 1] {
			g.res[new_n] = g.res[i];
			new_n++;
		}
	}
	g.steps += g.n;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped adjacent pairs");
	out
}
@end
