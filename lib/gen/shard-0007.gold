	var out = v;
	if g.n < 2 {
		out.i = g.n;
		return out;
	}
	var new_n = 0;
	var i = 1;
	while i < g.n {
		g.res[new_n] = g.res[i];
		new_n++;
		i += 2;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "collected alternating tail count ", new_n);
	out
}
@end
