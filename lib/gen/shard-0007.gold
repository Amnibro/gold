phrase: limit runs at_most {max_run}
slot: max_run int
test: list=1,1,1,2,2,3 max_run=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5 max_run=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_run};
	if g.n > 0 && mr > 0 {
		var w = 1;
		var cur_run = 1;
		for k in (g.n - 1) {
			let idx = k + 1;
			if g.res[idx] == g.res[idx - 1] {
				cur_run++;
			} else {
				cur_run = 1;
			}
			if cur_run <= mr {
				g.res[w] = g.res[idx];
				w++;
			}
		}
		g.n = w;
	}
	out.i = g.n;
	out
}
@end
@entry 741f32df832b229c
kind: step
verb: rotate
noun: tail
modifier: unique
context: math
phrase: rotate tail unique
phrase: cycle tail unique
test: list=1,2,3,4,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,4,3] cache=0 hits=0
test: list=10,20,30,40
expect: => i=40 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let half = g.n / 2;
		var w = half;
		for i in (g.n - half) {
			let x = g.res[half + i];
			var seen = false;
			for j in (w - half) {
				if g.res[half + j] == x { seen = true; break; }
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		}
		g.n = w;
		if g.n > half + 1 {
			let last = g.res[g.n - 1];
			for k in (g.n - 1 - half) {
				let idx = g.n - 1 - k;
				g.res[idx] = g.res[idx - 1];
			}
			g.res[half] = last;
		}
		out.i = g.res[half];
	}
	out
}
@end
