@entry 10d8fbfb0779a45f
kind: step
verb: split
noun: sequence
modifier: with_retry
context: retry
phrase: split retry sequence at value {pivot}
phrase: partition retry sequence around {pivot}
slot: pivot int
test: list=50,10,60,20,70 pivot=30
expect: => i=2 r=0.0 ok=true s="split retry sequence at pivot 30" errors=0 n=5 res=[10,20,50,60,70] cache=0 hits=0
test: list=5,15,25 pivot=10
expect: => i=1 r=0.0 ok=true s="split retry sequence at pivot 10" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pivot};
	var left int[64] = [0; 64];
	var right int[64] = [0; 64];
	var lc = 0;
	var rc = 0;
	for i in g.n {
		if g.res[i] < p {
			if lc < 64 { left[lc] = g.res[i]; lc++; }
		} else {
			if rc < 64 { right[rc] = g.res[i]; rc++; }
		}
	}
	for i in lc { g.res[i] = left[i]; }
	for i in rc { g.res[lc + i] = right[i]; }
	g.steps += g.n;
	out.i = lc;
	out.s.clear();
	format(out.s, "split retry sequence at pivot ", p);
	out
}
@end
