fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 0 || g.n < w { return out; }
	var min_val = g.res[0];
	for i in w {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	for i in w {
		g.res[i] -= min_val;
	}
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "normalized window elements: ", w);
	out
}
