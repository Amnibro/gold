code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var kept int[>..] = [];
	for k in g.n {
		let x = g.res[k];
		if x >= mv {
			var seen = false;
			for u in kept {
				if u == x { seen = true; break; }
			}
			if !seen { kept.push(x); }
		}
	}
	out.s.clear();
	format(out.s, "unique minimum at least: [");
	var first = true;
	for u in kept {
		if !first { format(out.s, ", "); }
		format(out.s, u);
		first = false;
	}
	format(out.s, "]");
	out.i = kept.len;
	g.steps += g.n;
	out
}
@end
@entry 30787b2b26eef5de
kind: step
verb: validate
noun: tail
modifier: recursively
context: format
phrase: validate tail sequence recursively up to depth {depth}
phrase: verify trailing elements recursively through level {depth}
slot: depth int
test: list=1,2,3,4 depth=2
expect: => i=2 r=0.0 ok=true s="tail recursive check: valid" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,-1 depth=2
expect: => i=0 r=0.0 ok=false s="tail recursive check: invalid" errors=1 n=3 res=[5,6,-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var valid = true;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 && count < d {
		if g.res[i] < 0 {
			valid = false;
			break;
		}
		count++;
		i--;
	}
	out.ok = valid;
	if !valid {
		gold_fail(g, "negative element in tail");
	}
	out.s.clear();
	format(out.s, "tail recursive check: ", if valid { "valid" } else { "invalid" });
	out.i = count;
	g.steps += d + 1;
	out
}
@end
