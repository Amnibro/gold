expect: => i=-1 r=0.0 ok=false s="idx -1" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	let tgt = ${target};
	out.ok = false;
	out.i = -1;
	if g.n >= w && w > 0 {
		let count = g.n - w + 1;
		for k in count {
			let idx = count - 1 - k;
			var sum = 0;
			for j in w {
				sum += g.res[idx + j];
			}
			if sum == tgt {
				out.ok = true;
				out.i = idx;
				break;
			}
		}
	}
	out.s.clear();
	format(out.s, "idx ", out.i);
	out
}
@end
