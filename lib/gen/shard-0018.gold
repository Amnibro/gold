fn ${ID}(g Gold&, v Val) Val {
	// step_tex_emboss_moss_soft
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.76 + 0.5); }
	var s_b2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "moss");
	out
}
@end
