expect: => i=2 r=0.0 ok=true s="tail sorted count: 2" errors=0 n=5 res=[100,90,80,60,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || count > g.n { gold_fail(g, "invalid k"); out.ok = false; return out; }
	let start = g.n - count;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "tail sorted count: ", count);
	out
}
@end
