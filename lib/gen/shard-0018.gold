fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let t = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = t;
		i++;
		j--;
	}
	var tot = 0;
	for k in g.n {
		tot += g.res[k];
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "sum tally in_reverse");
	out
}
@end
