@entry 70ec26d7e6414fed
kind: step
verb: sort
noun: streak
modifier: times
context: compare
slot: times int
phrase: sort comparison streaks exceeding times {times}
phrase: order streak counts above times {times}
test: list=1,1,1,2,2,3 times=2
expect: => i=1 r=0.0 ok=true s="sorted streaks count: 1" errors=0 n=6 res=[1,1,1,2,2,3] cache=0 hits=0
test: list=4,5,6,7,8 times=1
expect: => i=0 r=0.0 ok=true s="sorted streaks count: 0" errors=0 n=5 res=[4,5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t < 0 || g.n < 2 { gold_fail(g, "invalid times"); out.ok = false; return out; }
	var streaks = 0;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] { cur++; }
		else {
			if cur > t { streaks++; }
			cur = 1;
		}
	}
	if cur > t { streaks++; }
	// simple bubble sort of g.res
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += streaks;
	out.i = streaks;
	out.s.clear();
	format(out.s, "sorted streaks count: ", streaks);
	out
}
@end
@entry 987042e7dbb466ef
