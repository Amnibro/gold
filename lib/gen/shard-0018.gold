@entry aab1872af7b79bdb
kind: step
verb: shift
noun: runs
modifier: running
context: aggregate
phrase: shift runs in running sequence
phrase: adjust identical runs by running length
test: list=2,2,3,4,4,4
expect: => i=6 r=0.0 ok=true s="shift_runs_running: 6" errors=0 n=6 res=[4,4,4,7,7,7] cache=0 hits=0
test: list=5,5,6,7,7
expect: => i=5 r=0.0 ok=true s="shift_runs_running: 5" errors=0 n=5 res=[7,7,7,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		for k in i .. j {
			g.res[k] += run_len;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shift_runs_running: ", g.n);
	out
}
@end
