expect: 6
test: arg=6
expect: 3
code:
fn ${ID}(n int) int {
	var target_steps = if n < 1 { 1 } else { n };
	var running_sum = 0;
	var step_counter = 0;
	while running_sum < target_steps {
		step_counter++;
		running_sum += step_counter;
	}
	step_counter
}
@end
@entry 859be1d5e60fbfc3
kind: fn
verb: apply
noun: suffix
modifier: sorted
context: transform
phrase: apply suffix sorted digit order
phrase: order suffix digits in sorted form
test: arg=492,831
expect: 29
expect: 13
test: arg=70
expect: 7
code:
fn ${ID}(n int) int {
	var sfx_val = if n < 0 { -n } else { n };
	let d_a = sfx_val % 10;
	let d_b = (sfx_val / 10) % 10;
	let min_d = if d_a < d_b { d_a } else { d_b };
	let max_d = if d_a > d_b { d_a } else { d_b };
	min_d * 10 + max_d
}
@end
