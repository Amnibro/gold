fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var pass = 0;
	while pass < att {
		pass++;
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += pass * g.n;
	out.i = pass;
	out.s.clear();
	format(out.s, "reverse passes: ", pass);
	out
}
@end
@entry f5fe94db1249f1a5
kind: step
verb: merge
noun: range
modifier: in_place
context: list
phrase: merge range in place from {start} to {stop}
phrase: list merge range in place slice {start} through {stop}
slot: start int
slot: stop int
test: list=1,2,3,4,5 start=1 stop=3
expect: => i=9 r=0.0 ok=true s="merged range sum: 9" errors=0 n=3 res=[1,9,5] cache=0 hits=0
test: list=10,20,30,40 start=0 stop=2
expect: => i=60 r=0.0 ok=true s="merged range sum: 60" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${stop};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	if s <= e && g.n > 0 {
		var sum = 0;
		var k = s;
		while k <= e {
			sum += g.res[k];
			k++;
		}
		g.res[s] = sum;
		let span = e - s;
		var i = s + 1;
		while i + span < g.n {
			g.res[i] = g.res[i + span];
			i++;
		}
		g.n -= span;
		out.i = sum;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "merged range sum: ", out.i);
	out
}
@end
@entry ee799b1898b12849
kind: step
