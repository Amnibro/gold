expect: => i=3 r=0.0 ok=true s="normalized suffix of at most 3 samples" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	let c = ${count};
	if sc == 0 {
		gold_fail(g, "scale cannot be zero");
		out.ok = false;
		return out;
	}
	let k = if g.n < c { g.n } else { c };
	for i in (g.n - k)..g.n {
		g.res[i] /= sc;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "normalized suffix of at most ", k, " samples");
	out
}
@end
