fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${slot_key};
	var chk = 0;
	for i in out.s.len {
		chk = (chk + (out.s[i] as int) * (i + 1)) % 10007;
	}
	gold_cache_put(g, key, chk);
	g.steps += out.s.len;
	out.i = chk;
	out.s.clear();
	format(out.s, "chk fold: ", chk);
	out
}
@end
