@entry 9ceb93bbdc26d855
kind: step
verb: emboss
noun: height
modifier: coarse
context: texture
phrase: emboss coarse height field with seed {u}
phrase: coarse embossed terrain relief using seed {u}
slot: u int
model: worley c=8 u=${u}; slope; scale a=0.9
test: img=16 u=4
expect: => i=256 r=0.0 ok=true s="height" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.01 max=0.157 sum8=7764 hash=961550
test: img=32 u=6
expect: => i=1024 r=0.0 ok=true s="height" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.005 max=0.158 sum8=30885 hash=679337
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s_buf_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_buf_2[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_buf_2;
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] * 0.9); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
