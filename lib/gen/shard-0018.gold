@entry 8411929f6d565697
kind: step
verb: validate
noun: primes
modifier: nested
context: compare
slot: bound int
phrase: validate nested prime differences under bound {bound}
phrase: verify nested prime comparisons below bound {bound}
test: list=2,3,5,7 bound=6
expect: => i=1 r=0.0 ok=true s="primes nested valid: true" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,13,17 bound=8
expect: => i=1 r=0.0 ok=true s="primes nested valid: true" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b < 0 || g.n < 2 { gold_fail(g, "invalid bound"); out.ok = false; return out; }
	var valid = true;
	for i in g.n {
		let pi = g.res[i];
		if ${ID}_is_prime(pi) {
			for j in (i + 1)..g.n {
				let pj = g.res[j];
				if ${ID}_is_prime(pj) {
					let diff = pj - pi;
					let abs_diff = if diff < 0 { -diff } else { diff };
					if abs_diff > b { valid = false; break; }
				}
			}
		}
		if !valid { break; }
	}
	g.steps += g.n;
	out.i = if valid { 1 } else { 0 };
	out.ok = valid;
	out.s.clear();
	format(out.s, "primes nested valid: ", valid);
	out
}
@end
