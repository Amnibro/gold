expect: => i=2 r=0.0 ok=true s="gaps matched: 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_dist = ${gap};
	var count = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff == g_dist { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps matched: ", count);
	out
}
@end
@entry ff3916c35500d445
kind: step
verb: swap
noun: odds
modifier: with_cache
context: list
phrase: swap odds with cache recorded in list
phrase: list swap odds with cache lookup
test: list=2,1,4,3,6
expect: => i=1 r=0.0 ok=true s="swapped odds and cached" errors=0 n=5 res=[2,3,4,1,6] cache=2 hits=0
test: list=5,8,7,9
expect: => i=1 r=0.0 ok=true s="swapped odds and cached" errors=0 n=4 res=[9,8,7,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first = -1;
	var last = -1;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			if first < 0 { first = k; }
			last = k;
		}
	}
	if first >= 0 && last >= 0 && first != last {
		let v1 = g.res[first];
		let v2 = g.res[last];
		g.res[first] = v2;
		g.res[last] = v1;
		gold_cache_put(g, first, v2);
		gold_cache_put(g, last, v1);
		out.i = 1;
		out.s.clear();
		format(out.s, "swapped odds and cached");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "no odd pair to swap");
	}
	g.steps += g.n;
	out
}
@end
