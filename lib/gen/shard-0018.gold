test: list=5,3,8,1
expect: => i=6 r=0.0 ok=true s="total sorting comparisons: 6" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var comps = 0;
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			comps++;
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = comps;
	out.s.clear();
	format(out.s, "total sorting comparisons: ", comps);
	out
}
@end
