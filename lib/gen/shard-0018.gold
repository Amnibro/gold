			j++;
		}
		i++;
	}
	let cnt = ${count};
	let lim = if cnt < g.n { if cnt > 0 { cnt } else { 0 } } else { g.n };
	g.n = lim;
	g.steps += g.n;
	out.i = lim;
	out.s.clear();
	format(out.s, "joined maximum any: ", lim);
