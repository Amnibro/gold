fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var dup = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { dup = true; break; }
			j++;
		}
		if !dup {
			g.res[m] = x;
			m++;
		}
		i--;
	}
	let kt = ${keep_total};
	let lim = if m < kt { m } else { kt };
	g.n = if lim > 0 { lim } else { 0 };
	g.steps += m;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped limit in reverse: ", g.n);
	out
}
@end
