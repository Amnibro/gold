noun: memo
modifier: up_to
context: compare
slot: limit int
phrase: dedupe memoized comparison values up to {limit}
phrase: remove duplicate memo entries up to {limit}
test: list=10,10,20,20,30 limit=25
expect: => i=2 r=0.0 ok=true s="deduped memo count: 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,15,15,25 limit=20
expect: => i=2 r=0.0 ok=true s="deduped memo count: 2" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 || g.n == 0 { gold_fail(g, "invalid limit"); out.ok = false; return out; }
	var w = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen { g.res[w] = x; w++; }
			else { removed++; }
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped memo count: ", removed);
	out
}
@end
