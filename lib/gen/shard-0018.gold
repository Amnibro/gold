noun: odds
modifier: sorted
context: loop
phrase: sort loop sequence counting odd elements
phrase: order loop items counting odd numbers sorted
test: list=7,2,9,4,1
expect: => i=3 r=0.0 ok=true s="compare odds sorted" errors=0 n=5 res=[1,2,4,7,9] cache=0 hits=0
test: list=10,3,6,1
expect: => i=2 r=0.0 ok=true s="compare odds sorted" errors=0 n=4 res=[1,3,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	var odds = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds++;
		}
	}
	g.steps += g.n * g.n;
	out.i = odds;
	out.s.clear();
	format(out.s, "compare odds sorted");
	out
}
@end
