kind: step
verb: rotate
noun: vowels
modifier: in_place
context: compare
slot: shift int
phrase: rotate vowel character elements in place by {shift}
phrase: shift vowel positions in place across comparison by {shift}
test: list=97,98,101,99,105 shift=1
expect: => i=3 r=0.0 ok=true s="rotated 3 vowels" errors=0 n=5 res=[101,98,105,99,97] cache=0 hits=0
test: list=65,66,69 shift=1
expect: => i=2 r=0.0 ok=true s="rotated 2 vowels" errors=0 n=3 res=[69,66,65] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if s < 0 || g.n == 0 { gold_fail(g, "invalid shift"); out.ok = false; return out; }
	var pos int[64] = [0; 64];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		let is_v = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 ||
		           x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if is_v && count < 64 { pos[count] = i; count++; }
	}
	if count > 1 {
		var vals int[64] = [0; 64];
		for k in count { vals[k] = g.res[pos[k]]; }
		for k in count {
			let src = (k + s) % count;
			g.res[pos[k]] = vals[src];
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated ", count, " vowels");
	out
}
@end
