fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n == 0 || g.res[g.n - 1] < mv {
		gold_fail(g, "validate series last failed");
		out.ok = false;
		return out;
	}
	var m = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] >= mv {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "validated series last: ", m);
	out
}
@end
