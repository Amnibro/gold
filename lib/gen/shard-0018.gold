code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = idx;
	out.ok = (idx >= 0);
	out.s.clear();
	format(out.s, "loop search result: ", idx);
	out
}
@end
@entry 9432a0ffefa1d9c6
kind: step
verb: sort
noun: primes
modifier: with_retry
context: math
phrase: sort primes with retry partitioning prime elements
phrase: group prime numbers first with retry sorting in math
test: list=4,3,2,8,5
expect: => i=3 r=0.0 ok=true s="primes sorted with retry count: 3" errors=0 n=5 res=[2,3,5,4,8] cache=0 hits=0
test: list=9,7,6,11,4
expect: => i=2 r=0.0 ok=true s="primes sorted with retry count: 2" errors=0 n=5 res=[7,11,9,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var primes int[256];
	var nonprimes int[256];
	var np_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[p_count] = x;
			p_count++;
		} else {
			nonprimes[np_count] = x;
			np_count++;
		}
	}
	for i in p_count {
		for j in p_count - 1 {
			if primes[j] > primes[j + 1] {
				let tmp = primes[j];
				primes[j] = primes[j + 1];
				primes[j + 1] = tmp;
			}
		}
	}
	for i in p_count { g.res[i] = primes[i]; }
	for i in np_count { g.res[p_count + i] = nonprimes[i]; }
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "primes sorted with retry count: ", p_count);
	out
}
@end
@entry fc5ef9cd3a22fb41
kind: step
verb: fold
noun: subfunction
modifier: unique
context: math
phrase: fold subfunction unique values using {step_fn}
phrase: accumulate unique results with step function {step_fn} in math
slot: step_fn fn
test: list=2,2,3,4 step_fn=inc
expect: => i=11 r=0.0 ok=true s="fold unique acc: 11" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=5,5,10,10 step_fn=double
expect: => i=30 r=0.0 ok=true s="fold unique acc: 30" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for i in g.n {
		var dup = false;
		for j in m {
			if g.res[j] == g.res[i] { dup = true; break; }
		}
		if !dup {
			g.res[m] = g.res[i];
			m++;
		}
	}
	g.n = m;
	var acc = 0;
	if m > 0 {
		acc = g.res[0];
		var i = 1;
		while i < m {
			acc = ${step_fn}(acc + g.res[i]);
			i++;
		}
	}
	g.steps += m;
	out.i = acc;
	out.s.clear();
	format(out.s, "fold unique acc: ", acc);
	out
}
@end
@entry 3ee5706b176db582
kind: step
verb: return
noun: gaps
modifier: nested
context: math
phrase: return gaps nested differences between elements
phrase: calculate nested gap differences across math results
test: list=1,4,9,16
expect: => i=15 r=0.0 ok=true s="nested gaps total: 15" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=2,5,11,20
expect: => i=18 r=0.0 ok=true s="nested gaps total: 18" errors=0 n=3 res=[3,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var tot = 0;
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			g.res[i] = diff;
			tot += diff;
		}
		g.n = g.n - 1;
		out.i = tot;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "nested gaps total: ", out.i);
	out
}
@end
