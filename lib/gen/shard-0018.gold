	let lo = ${low};
	let hi = ${high};
	var modified = 0;
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			modified++;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			modified++;
