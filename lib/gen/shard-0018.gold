expect: => i=49 r=0.0 ok=true s="" errors=0 n=5 res=[5,13,17,19,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_val};
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= m && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { sum += x; }
		}
		i++;
	}
	g.steps += g.n;
	out.i = sum;
	out
}
@end
