code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 {
		out.i = g.res[0];
		if g.res[0] >= fl {
			out.ok = true;
			out.s.clear();
			format(out.s, "safely above floor: ", fl);
		} else {
			out.ok = false;
			out.s.clear();
			format(out.s, "failed floor requirement: ", fl);
		}
	} else {
		out.ok = true;
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
