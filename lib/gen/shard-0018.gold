kind: step
verb: join
noun: suffix
modifier: unique
context: math
phrase: join suffix unique items from last {k} entries
phrase: extract unique suffix elements from trailing {k} items
slot: k int
test: list=1,2,3,3,4,4 k=4
expect: => i=2 r=0.0 ok=true s="unique suffix count: 2" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=10,20,20,30 k=3
expect: => i=2 r=0.0 ok=true s="unique suffix count: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let start = if g.n > k { g.n - k } else { 0 };
	var m = 0;
	var i = start;
	while i < g.n {
		let x = g.res[i];
		var dup = false;
		for j in m {
			if g.res[j] == x { dup = true; break; }
		}
		if !dup {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "unique suffix count: ", m);
	out
}
@end
