fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items to compare loop in place");
		return out;
	}
	let steps = g.n - 1;
	for k in steps {
		let diff = g.res[k + 1] - g.res[k];
		g.res[k] = if diff > 0 { 1 } else if diff < 0 { -1 } else { 0 };
	}
	g.n = steps;
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "compared ", steps, " adjacent trend steps in place");
	out
}
