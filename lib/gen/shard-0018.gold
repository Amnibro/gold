phrase: accumulate prime search results up to count {k}
slot: k int
test: list=4,5,6,7,8,9,11 k=2
expect: => i=12 r=0.0 ok=true s="folded first primes sum: 12" errors=0 n=7 res=[4,5,6,7,8,9,11] cache=0 hits=0
test: list=2,3,4,5,6 k=3
expect: => i=10 r=0.0 ok=true s="folded first primes sum: 10" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}_isp(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	var sum = 0;
	var matched = 0;
	var i = 0;
	while i < g.n && matched < limit {
		let x = g.res[i];
		if ${ID}_isp(x) {
			sum += x;
			matched++;
		}
		i++;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded first primes sum: ", sum);
	g.steps += g.n;
	out
}
@end
