fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var s = 0;
	var e = out.s.len;
	for attempt in r {
		while s < e && out.s[s] == ' ' { s++; }
		while e > s && out.s[e - 1] == ' ' { e--; }
	}
	var trimmed byte[>..] = [];
	var idx = s;
	while idx < e {
		trimmed.push(out.s[idx]);
		idx++;
	}
	out.s.clear();
	for b in trimmed { out.s.push(b); }
	g.steps += r;
	out.i = out.s.len;
	out.ok = (out.s.len > 0);
	out
}
@end
