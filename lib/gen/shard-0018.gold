kind: step
verb: scale
noun: numbers
modifier: while
context: sort
slot: factor int
slot: ceiling int
phrase: scale sorted numbers by {factor} while value below {ceiling}
phrase: multiply sorted values by factor {factor} while under {ceiling}
test: list=8,2,5,1 factor=2 ceiling=6
expect: => i=3 r=0.0 ok=true s="scaled numbers while under ceiling: 3" errors=0 n=4 res=[2,4,10,8] cache=0 hits=0
test: list=10,3,7,1 factor=3 ceiling=5
expect: => i=2 r=0.0 ok=true s="scaled numbers while under ceiling: 2" errors=0 n=4 res=[3,9,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let ceil = ${ceiling};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for k in g.n {
		if g.res[k] < ceil {
			g.res[k] = g.res[k] * f;
			count++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled numbers while under ceiling: ", count);
	out
}
@end
