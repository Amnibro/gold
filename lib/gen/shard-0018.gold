test: input=5 min_sum=8 max_sum=12
expect: => i=8 r=0.0 ok=true s="digits retried: 8" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rdb_lo = ${min_sum};
	let rdb_hi = ${max_sum};
	var rdb_tries = 0;
	while rdb_tries < 100 {
		let rdb_s = core_digit_sum(out.i);
		if rdb_s >= rdb_lo && rdb_s <= rdb_hi {
			break;
		}
		out.i++;
		rdb_tries++;
	}
	g.steps += rdb_tries;
	out.s.clear();
	format(out.s, "digits retried: ", out.i);
	out
}
@end
