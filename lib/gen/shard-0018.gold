			valid = false;
			break;
		}
		i += 2;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "every other valid: ", valid);
	g.steps += g.n;
	out
}
@end
