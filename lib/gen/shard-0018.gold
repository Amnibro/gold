@entry 39e8f9577a99e32e
kind: step
verb: rank
noun: errors
modifier: up_to
context: math
slot: target int
slot: max_err int
phrase: rank errors exceeding target {target} up to limit {max_err}
phrase: check error threshold against target {target} up to {max_err}
test: list=10,15,25 target=12 max_err=5
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[10,15,25] cache=0 hits=0
test: list=100,102,110 target=100 max_err=3
expect: => i=1 r=0.0 ok=true s="" errors=1 n=3 res=[100,102,110] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let m_err = ${max_err};
	var err_cnt = 0;
	var i = 0;
	while i < g.n {
		let diff = g.res[i] - tgt;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > m_err {
			err_cnt++;
			gold_fail(g, "error bound exceeded");
		}
		i++;
	}
	g.steps += g.n;
	out.i = err_cnt;
	out
}
@end
@entry 2b825608586f4678
kind: step
verb: clamp
noun: results
modifier: unique
context: math
slot: lo int
slot: hi int
phrase: clamp results unique values floor {lo} ceil {hi}
phrase: bound result numbers unique range low {lo} high {hi}
test: list=1,5,5,12,15 lo=3 hi=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,5,10] cache=0 hits=0
test: list=-5,0,2,20,25 lo=0 hi=20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[0,2,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var i = 0;
	while i < g.n {
		if g.res[i] < low { g.res[i] = low; }
		else if g.res[i] > high { g.res[i] = high; }
		i++;
	}
	var w = 0;
	i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen = false;
		var k = 0;
		while k < w {
			if g.res[k] == val { seen = true; break; }
			k++;
		}
		if !seen {
			g.res[w] = val;
			w++;
		}
		i++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out
}
@end
@entry 2f7d45652f87339d
kind: step
verb: rank
noun: items
modifier: nested
context: math
phrase: rank items nested count of smaller elements
phrase: compute nested element ranks over list
test: list=50,10,30
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[50,10,30] cache=0 hits=0
test: list=7,2,9,4
expect: => i=6 r=0.0 ok=true s="" errors=0 n=4 res=[7,2,9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_rank = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var rank = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] < x { rank++; }
			j++;
		}
		total_rank += rank;
		i++;
	}
	g.steps += g.n * g.n;
	out.i = total_rank;
	out
}
@end
@entry e574ea9711df7520
kind: step
verb: join
noun: squares
modifier: safely
context: math
slot: limit int
phrase: join squares safely checking non negative root {limit}
phrase: sum square items safely bounded below {limit}
test: list=4,9,15,16 limit=20
expect: => i=9 r=0.0 ok=true s="" errors=0 n=4 res=[4,9,15,16] cache=0 hits=0
test: list=1,25,36,50 limit=40
expect: => i=12 r=0.0 ok=true s="" errors=0 n=4 res=[1,25,36,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var root_sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 0 && x <= lim {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				root_sum += r;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = root_sum;
	out
}
@end
