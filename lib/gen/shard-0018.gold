	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	for k in g.n {
		g.res[k] -= min_val;
	}
	g.steps += g.n * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized all samples by min ", min_val);
	out
}
@end
