fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if tgt < 0 { gold_fail(g, "invalid target"); out.ok = false; return out; }
	var w = 0;
	for i in g.n {
		if g.res[i] != tgt {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += removed;
	out.i = removed;
	out.s.clear();
	format(out.s, "checkpoint values removed: ", removed);
	out
}
