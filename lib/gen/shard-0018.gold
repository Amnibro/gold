slot: low int
slot: high int
test: list=1,2,2,3,3,4 low=2 high=3
expect: => i=2 r=0.0 ok=true s="duplicates zeroed: 2" errors=0 n=6 res=[1,2,0,3,0,4] cache=0 hits=0
