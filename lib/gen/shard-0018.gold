code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var m = 0;
	var i = 0;
	var found = 0;
	while i < g.n {
		let match_win = (i > 0 && g.res[i - 1] == tgt) || g.res[i] == tgt || (i + 1 < g.n && g.res[i + 1] == tgt);
		if match_win {
			g.res[m] = g.res[i];
			m++;
			found++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = found;
	out.s.clear();
	format(out.s, "searched window safely: ", found);
	out
}
@end
@entry 81c5d550e148de5c
kind: step
verb: search
noun: results
modifier: pairwise
context: filter
slot: diff int
phrase: search results pairwise having gap {diff}
phrase: filter sequence searching pairwise results with {diff}
test: list=2,5,7,10,12 diff=3
expect: => i=4 r=0.0 ok=true s="searched results pairwise: 4" errors=0 n=4 res=[2,5,7,10] cache=0 hits=0
test: list=1,3,6,10 diff=2
expect: => i=2 r=0.0 ok=true s="searched results pairwise: 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let df = ${diff};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let left = i > 0 && (x - g.res[i - 1] == df || g.res[i - 1] - x == df);
		let right = i + 1 < g.n && (x - g.res[i + 1] == df || g.res[i + 1] - x == df);
		if left || right {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "searched results pairwise: ", m);
	out
}
@end
@entry 78a68c3e57cd0d54
kind: step
verb: filter
noun: tally
modifier: unique
context: filter
slot: min_count int
phrase: filter tally unique items appearing at least {min_count}
phrase: select entries filtering unique tally above {min_count}
test: list=2,3,2,4,3,2 min_count=2
expect: => i=2 r=0.0 ok=true s="filtered tally unique: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,5,1,2,2 min_count=3
expect: => i=1 r=0.0 ok=true s="filtered tally unique: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var kept = false;
		var k = 0;
		while k < m {
			if g.res[k] == x { kept = true; break; }
			k++;
		}
		if !kept {
			var cnt = 0;
			var j = 0;
			while j < g.n {
				if g.res[j] == x { cnt++; }
				j++;
			}
			if cnt >= mc {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered tally unique: ", m);
	out
}
@end
