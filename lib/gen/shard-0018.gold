code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "find average safely: no results");
		out.ok = false;
		return out;
	}
	var s = 0;
	for k in g.n { s += g.res[k]; }
	out.i = s / g.n;
	out.r = (s as real) / (g.n as real);
	out.s.clear();
	format(out.s, "average safe");
	out
}
@end
