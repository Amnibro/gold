code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches = 0;
	let target = 10;
	let tolerance = 2;
	for i in 0 .. g.n {
		let diff = g.res[i] - target;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= tolerance { matches++; }
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "compare_value_with_retry: ", matches);
	out
}
@end
