test: img=16 u=4
expect: => i=256 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=23307 hash=838158
test: img=32 u=8
expect: => i=1024 r=0.0 ok=true s="rust" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=104101 hash=406041
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.7 + 0.5); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 5 < 2 || 5 > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (5 as real)) as! int;
		if t > 5 - 1 { t = 5 - 1; }
		g.img[k] = (t as real) / ((5 - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "rust");
	out
}
@end
