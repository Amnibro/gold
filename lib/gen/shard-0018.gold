expect: => i=1 r=0.0 ok=true s="reverse search index: 1" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${k};
	var found_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == target {
			found_idx = i;
			break;
		}
		i--;
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "reverse search index: ", found_idx);
	g.steps += g.n;
	out
}
@end
