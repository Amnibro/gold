	for i in g.n {
		if total + g.res[i] <= cap {
			total += g.res[i];
			count++;
		} else { break; }
	}
	gold_push(g, total);
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "joined loop sum: ", total);
	out
}
@end
