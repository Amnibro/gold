test: list=2,5,8,13 max_val=6
expect: => i=1 r=0.0 ok=true s="clamped primes in place: 1" errors=0 n=4 res=[2,5,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var clamped = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && x > mv {
			g.res[i] = mv;
			clamped++;
		}
		i++;
	}
	g.steps += i;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped primes in place: ", clamped);
	out
}
@end
