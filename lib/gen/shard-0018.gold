@entry 1c7e2f9462c8b1b9
kind: step
verb: dedupe
noun: middle
modifier: while
context: text
phrase: dedupe middle text while {limit}
phrase: prune duplicate middle characters while {limit}
slot: limit int
test: text="abbbba" limit=2
expect: => i=4 r=0.0 ok=true s="abba" errors=0 n=0 res=[] cache=0 hits=0
test: text="xzzzzy" limit=1
expect: => i=3 r=0.0 ok=true s="xzy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let n = out.s.len;
	if n <= 2 || lim <= 0 { return out; }
	var res byte[>..] = [];
	res.push(out.s[0]);
	var i = 1;
	while i < n - 1 {
		let c = out.s[i];
		var run = 1;
		while i + 1 < n - 1 && out.s[i + 1] == c {
			run++;
			i++;
		}
		let keep = if run > lim { lim } else { run };
		for k in keep { res.push(c); }
		i++;
	}
	res.push(out.s[n - 1]);
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += n;
	out.i = out.s.len;
	out
}
@end
@entry 0adefc628f3abec5
kind: step
verb: fold
noun: function
modifier: between
context: text
phrase: fold function {f} between text bounds
phrase: apply fold function {f} between characters
slot: f fn
test: text="abc" f=double
expect: => i=588 r=0.0 ok=true s="fn fold: 588" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" f=inc
expect: => i=366 r=0.0 ok=true s="fn fold: 366" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	for b in out.s {
		acc += ${f}(b as int);
	}
	g.steps += out.s.len;
	out.i = acc;
	out.s.clear();
	format(out.s, "fn fold: ", acc);
	out
}
@end
@entry c39d9584eb461e8c
kind: step
verb: dedupe
noun: threshold
modifier: each
context: text
phrase: dedupe text threshold each count {limit}
phrase: remove characters exceeding threshold each count {limit}
slot: limit int
test: text="banana split" limit=2
expect: => i=11 r=0.0 ok=true s="banan split" errors=0 n=0 res=[] cache=0 hits=0
test: text="committee" limit=1
expect: => i=6 r=0.0 ok=true s="comite" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let n = out.s.len;
	var res byte[>..] = [];
	for i in n {
		let c = out.s[i];
		var seen = 0;
		for j in res.len {
			if res[j] == c { seen++; }
		}
		if seen < lim {
			res.push(c);
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += n;
	out.i = out.s.len;
	out
}
@end
