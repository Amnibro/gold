@entry 778ce03896eb7248
kind: step
verb: split
noun: memo
modifier: sorted
context: stats
phrase: split sorted memoized observations above median
phrase: partition sorted memo samples at median point
test: list=40,10,30,20
expect: => i=2 r=0.0 ok=true s="split memo sorted kept upper 2 samples" errors=0 n=2 res=[30,40] cache=4 hits=0
test: list=5,1,9
expect: => i=2 r=0.0 ok=true s="split memo sorted kept upper 2 samples" errors=0 n=2 res=[5,9] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let mid = g.n / 2;
	let kept = g.n - mid;
	for k in kept {
		g.res[k] = g.res[mid + k];
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "split memo sorted kept upper ", kept, " samples");
	out
}
@end
