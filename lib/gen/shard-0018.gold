fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	let n = out.s.len;
	var total = 0;
	for i in n {
		let c = out.s[i];
		var dup = 0;
		for j in i {
			if out.s[j] == c { dup++; }
		}
		if dup > 0 && dup <= cap {
			gold_push(g, dup);
			total += dup;
		}
	}
	g.steps += n;
	out.i = total;
	out.s.clear();
	format(out.s, "dups rank: ", total);
	out
}
@end
