kind: step
verb: fill
noun: histogram
modifier: sorted
context: core
phrase: fill sorted histogram bins
phrase: tally sorted histogram of results
test: list=3,1,3,2,1,3
expect: => i=3 r=0.0 ok=true s="histogram filled" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=5,5,5,9
expect: => i=2 r=0.0 ok=true s="histogram filled" errors=0 n=2 res=[3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in (g.n - 1 - i) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var freqs int[512] = [0; 512];
	var fcount = 0;
	var i = 0;
	while i < g.n {
		var cnt = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			cnt++;
			i++;
		}
		freqs[fcount] = cnt;
		fcount++;
		i++;
	}
	gold_clear(g);
	for k in fcount { gold_push(g, freqs[k]); }
	out.i = fcount;
	out.s.clear();
	format(out.s, "histogram filled");
	out
}
@end
