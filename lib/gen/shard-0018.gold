@entry 85d367a4a5ff4795
kind: step
verb: rotate
noun: streak
modifier: recursively
context: search
phrase: rotate streak recursively by shift {k}
phrase: apply recursive streak rotation by amount {k}
slot: k int
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="recursively rotated streak by: 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="recursively rotated streak by: 3" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
recursive fn ${ID}_step(g Gold&, steps_left int) {
	if steps_left <= 0 || g.n <= 1 { return; }
	let last_item = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last_item;
	${ID}_step(g, steps_left - 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let amount = ${k};
	if g.n > 1 && amount > 0 {
		let eff = amount % g.n;
		${ID}_step(g, eff);
	}
	out.i = amount;
	out.s.clear();
	format(out.s, "recursively rotated streak by: ", amount);
	g.steps += g.n;
	out
}
@end
