test: list=5,5,6,7,7,7 min_len=3
expect: => i=7 r=0.0 ok=true s="first run value: 7" errors=0 n=6 res=[5,5,6,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if ml <= 1 || g.n < ml { gold_fail(g, "invalid min_len"); out.ok = false; return out; }
	var start_idx = -1;
	var run_val = 0;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur++;
			if cur >= ml {
				start_idx = i - cur + 1;
				run_val = g.res[i];
				break;
			}
		} else {
			cur = 1;
		}
	}
	g.steps += cur;
	out.i = run_val;
	out.ok = start_idx >= 0;
	out.s.clear();
	format(out.s, "first run value: ", run_val);
	out
}
@end
