	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] + 0.2); }
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "fabric");
	out
}
@end
