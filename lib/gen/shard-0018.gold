code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n - 1 {
			let pair_sum = g.res[i] + g.res[i + 1];
			g.res[i] = if ${ID}_is_prime(pair_sum) { 1 } else { 0 };
		}
		g.n -= 1;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled pairwise primes");
	out
}
@end
