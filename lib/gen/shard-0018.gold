fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_l = ${max_len};
	let n = out.s.len;
	var longest = 0;
	var cur = 1;
	for i in n - 1 {
		if out.s[i + 1] > out.s[i] {
			cur++;
		} else {
			if cur > longest { longest = cur; }
			cur = 1;
		}
	}
	if cur > longest { longest = cur; }
	if longest > max_l { longest = max_l; }
	g.steps += n;
	out.i = longest;
	out
}
@end
