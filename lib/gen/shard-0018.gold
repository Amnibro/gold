noun: primes
modifier: unique
context: filter
slot: limit int
phrase: join primes unique values up to {limit}
phrase: filter list joining unique primes below {limit}
test: list=2,3,4,5,3,7,8 limit=6
expect: => i=3 r=0.0 ok=true s="joined primes unique: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
