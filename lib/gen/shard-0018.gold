code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let k = if limit < g.n { if limit > 0 { limit } else { 0 } } else { g.n };
	var modified = 0;
	var i = 0;
	while i < k {
		g.res[i] = ${x}(g.res[i]);
		modified++;
		i += 2;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped alternate prefix items: ", modified);
	out
}
@end
