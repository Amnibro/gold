code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[1];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	for k in 1..g.n {
		g.res[k] -= min_val;
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "tail normalized");
	out
}
@end
