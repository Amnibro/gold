fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 1 || g.n < t { gold_fail(g, "invalid times"); out.ok = false; return out; }
	var long_runs = 0;
	var cur = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] { cur++; }
		else {
			if cur >= t { long_runs++; }
			cur = 1;
		}
	}
	if cur >= t { long_runs++; }
	g.steps += long_runs;
	out.i = long_runs;
	out.s.clear();
	format(out.s, "long runs traced: ", long_runs);
