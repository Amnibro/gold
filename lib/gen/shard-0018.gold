expect: => i=256 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.452 max=1 sum8=52096 hash=248969
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="grime" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=147218 hash=66400
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_tex_mask_grime_soft
	var out = v;
	if !gold_img_square(g, 8) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s_b = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_b[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_b;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.2 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "grime");
	out
}
@end
