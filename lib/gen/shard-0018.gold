fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if r <= 0 { gold_fail(g, "invalid retries"); out.ok = false; return out; }
	var misses = 0;
	for i in g.n {
		let k = g.res[i];
		var found = false;
		for c in g.cn {
