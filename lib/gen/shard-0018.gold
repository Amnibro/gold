fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var runs int[512] = [0; 512];
	var rn = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			runs[rn] = cur_len;
			rn++;
			cur_len = 1;
		}
		i++;
	}
	runs[rn] = cur_len;
	rn++;
	for k in rn { g.res[k] = runs[k]; }
	g.n = rn;
	i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
