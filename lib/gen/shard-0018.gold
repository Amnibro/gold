kind: step
verb: dedupe
noun: head
modifier: safely
context: cache
phrase: dedupe head safely up to count {count}
phrase: prune duplicate prefix entries safely to {count}
slot: count int
test: list=2,2,3,4,5 count=3
expect: => i=2 r=0.0 ok=true s="head uniques 2" errors=0 n=5 res=[2,2,3,4,5] cache=2 hits=0
test: list=7,8,7,9 count=4
expect: => i=3 r=0.0 ok=true s="head uniques 3" errors=0 n=4 res=[7,8,7,9] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	let bound = if limit < g.n { limit } else { g.n };
	var uniq = 0;
	for i in bound {
		let x = g.res[i];
		var dup = false;
		for j in i { if g.res[j] == x { dup = true; break; } }
		if !dup {
			gold_cache_put(g, uniq, x);
			uniq++;
		}
	}
	out.i = uniq;
	out.s.clear();
	format(out.s, "head uniques ", uniq);
	out
}
@end
