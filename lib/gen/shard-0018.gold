phrase: rotate search values in reverse by shift {k}
phrase: reverse rotate found values with offset {k}
slot: k int
test: list=10,20,30,40 k=1
expect: => i=1 r=0.0 ok=true s="rotated in reverse by: 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="rotated in reverse by: 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${k};
	if g.n > 1 && shift > 0 {
		var s = shift % g.n;
		while s > 0 {
			let first = g.res[0];
			var i = 0;
			while i < g.n - 1 {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
			s--;
		}
	}
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated in reverse by: ", shift);
	g.steps += g.n;
	out
}
@end
