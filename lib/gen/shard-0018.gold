fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	for k in g.n {
		total += g.res[k];
		g.res[k] = total;
	}
	g.steps += g.n * 2;
	out.i = total;
	out.s.clear();
	format(out.s, "sorted cumulative tally sum ", total);
	out
}
