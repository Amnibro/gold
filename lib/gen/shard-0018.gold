code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > b { count++; }
		i += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "measured every other over limit: ", count);
	out
}
@end
