fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "split head: empty list");
		out.ok = false;
		return out;
	}
	out.i = g.res[0];
	for k in (g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.n--;
	out.s.clear();
	format(out.s, "split head");
	out
}
