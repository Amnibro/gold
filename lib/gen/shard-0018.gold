code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 {
		out.i = 0;
		out.s.clear();
		format(out.s, "sequence too short for middle pairwise");
		return out;
	}
	let start = g.n / 4;
	let end = (g.n * 3) / 4;
	var i = start;
	var normalized = 0;
	while i + 1 < end {
		let avg = (g.res[i] + g.res[i + 1]) / 2;
		g.res[i] = avg;
		g.res[i + 1] = avg;
		i += 2;
		normalized++;
	}
	g.steps += g.n;
	out.i = normalized;
	out.s.clear();
	format(out.s, "normalized ", normalized, " middle pairs");
	out
}
@end
