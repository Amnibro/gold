fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bnd = ${bound};
	var clamped = 0;
	if g.n > 2 {
		var i = 1;
		while i < g.n - 1 {
			if g.res[i] > bnd {
				g.res[i] = bnd;
				clamped++;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "interior clamped: ", clamped);
	out
}
@end
