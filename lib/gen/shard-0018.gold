fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	if mc <= 1 || g.n < mc { gold_fail(g, "invalid min_count"); out.ok = false; return out; }
	var qualified = 0;
	for i in g.n {
		let x = g.res[i];
		var is_first = true;
		for j in i {
			if g.res[j] == x { is_first = false; break; }
		}
		if is_first {
			var occ = 0;
			for j in g.n {
				if g.res[j] == x { occ++; }
			}
			if occ >= mc { qualified++; }
		}
	}
	g.steps += qualified;
	out.i = qualified;
	out.s.clear();
	format(out.s, "qualified duplicates: ", qualified);
	out
}
@end
