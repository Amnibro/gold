modifier: until
context: filter
slot: target int
phrase: search tail until encountering item {target}
phrase: filter list searching tail until {target}
test: list=4,8,15,16,23 target=15
expect: => i=3 r=0.0 ok=true s="searched tail until: 3" errors=0 n=3 res=[15,16,23] cache=0 hits=0
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="searched tail until: 2" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			found = true;
			break;
		}
		i--;
	}
	if found {
		var k = 0;
		while i < g.n {
			g.res[k] = g.res[i];
			k++;
			i++;
		}
		g.n = k;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "searched tail until: ", g.n);
	out
}
@end
