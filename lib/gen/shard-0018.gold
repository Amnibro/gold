code:
recursive fn ${ID}_max(g Gold&, idx int, cur_max int) int {
	if idx >= g.n { return cur_max; }
	let next_max = if g.res[idx] > cur_max { g.res[idx] } else { cur_max };
	${ID}_max(g, idx + 1, next_max)
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let peak = if g.n > 0 { ${ID}_max(g, 1, g.res[0]) } else { 0 };
	out.i = peak;
	out.s.clear();
	format(out.s, "recursive maximum found: ", peak);
	g.steps += g.n;
	out
}
@end
