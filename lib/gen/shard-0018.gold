fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let k = if g.n < c { g.n } else { c };
	if k < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "tail too small for pairwise differences");
		return out;
	}
	let start = g.n - k;
	let pairs = k - 1;
	for i in pairs {
		g.res[i] = g.res[start + i + 1] - g.res[start + i];
	}
	g.n = pairs;
	g.steps += k;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " tail pairwise differences");
	out
}
@end
