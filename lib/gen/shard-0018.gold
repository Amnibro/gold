fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${step_size};
	if st <= 0 || g.n == 0 { gold_fail(g, "invalid step"); out.ok = false; return out; }
	var transitions = 0;
	var idx = 0;
	while idx + st < g.n {
		let diff = g.res[idx + st] - g.res[idx];
		if diff >= 0 { transitions++; }
		idx += st;
	}
	g.steps += transitions;
	out.i = transitions;
	out.s.clear();
	format(out.s, "loop transitions: ", transitions);
	out
}
@end
