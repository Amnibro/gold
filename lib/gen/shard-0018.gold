fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let tr = ${tries};
	var attempt = 0;
	while attempt < tr {
		attempt++;
		for k in g.n {
			g.res[k] = g.res[k] * f;
		}
	}
	g.steps += attempt * g.n;
	out.i = attempt;
	out.s.clear();
	format(out.s, "scaled series passes: ", attempt);
	out
}
