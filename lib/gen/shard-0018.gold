expect: => i=2 r=0.0 ok=true s="joined primes unique: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && x <= lim {
			var dup = false;
			var j = 0;
			while j < m {
				if g.res[j] == x { dup = true; break; }
				j++;
			}
			if !dup {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "joined primes unique: ", m);
	out
}
@end
