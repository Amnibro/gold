@entry 87cf062a7b5bad47
kind: step
verb: dedupe
noun: tail
modifier: in_reverse
context: math
phrase: dedupe tail sequence in reverse traversal order
phrase: backward deduplication preserving last occurrences
test: list=1,2,3,2,1
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,6,7,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,7,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var temp int[512] = [0; 512];
	var tn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var seen = false;
		var k = 0;
		while k < tn {
			if temp[k] == val { seen = true; break; }
			k++;
		}
		if !seen {
			temp[tn] = val;
			tn++;
		}
		i--;
	}
	for idx in tn {
		g.res[idx] = temp[tn - 1 - idx];
	}
	g.n = tn;
	g.steps += g.n;
	out.i = tn;
	out
}
@end
@entry b7c77e85123674b9
kind: step
