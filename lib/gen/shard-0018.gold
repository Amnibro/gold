code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	for k in g.n {
		let val = g.res[k];
		let cv, hit = gold_cache_get(g, val);
		if hit {
			g.res[k] += cv;
			matched++;
		} else {
			gold_cache_put(g, val, k + 1);
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "compared history with cache matches ", matched);
	out
}
@end
