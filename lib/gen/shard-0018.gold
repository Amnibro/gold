code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_sum};
	var sum = 0;
	var taken = 0;
	for i in g.n {
		sum += g.res[i];
		taken++;
		gold_cache_put(g, taken, sum);
		if sum >= req { break; }
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded head ", taken, " sum ", sum);
	out
