@entry 3b488df60895e896
kind: step
verb: group
noun: letters
modifier: all
context: core
phrase: group all letters by frequency
phrase: tally letter counts in text
test: text="hello world"
expect: => i=7 r=0.0 ok=true s="grouped letters" errors=0 n=7 res=[1,1,1,3,2,1,1] cache=0 hits=0
test: text="banana"
expect: => i=3 r=0.0 ok=true s="grouped letters" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[26] = [0; 26];
	var distinct = 0;
	for b in out.s {
		if b >= 'a' && b <= 'z' {
			let idx = (b - 'a') as int;
			if counts[idx] == 0 { distinct++; }
			counts[idx]++;
		} else if b >= 'A' && b <= 'Z' {
			let idx = (b - 'A') as int;
			if counts[idx] == 0 { distinct++; }
			counts[idx]++;
		}
	}
	gold_clear(g);
	for k in 26 {
		if counts[k] > 0 { gold_push(g, counts[k]); }
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "grouped letters");
	out
}
@end
