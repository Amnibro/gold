code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let limit = if cnt < g.n { if cnt > 0 { cnt } else { 0 } } else { g.n };
	var m = 0;
	var i = 0;
	while i < limit {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen = true; }
			j++;
		}
		if !seen {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "returned unique head: ", m);
	out
}
@end
@entry 8469c5a237c4cfaa
kind: step
verb: filter
noun: evens
modifier: with_retry
context: filter
slot: min_count int
phrase: filter evens with retry requiring at least {min_count}
phrase: keep even numbers retrying if below {min_count}
test: list=1,2,4,7,9 min_count=2
expect: => i=2 r=0.0 ok=true s="filtered evens with retry: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=1,3,5,7,9 min_count=3
expect: => i=2 r=0.0 ok=true s="filtered evens with retry: 2" errors=0 n=2 res=[3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	if m < mc {
		var m3 = 0;
		var j = 0;
		while j < g.n {
			let x = g.res[j];
			if x % 3 == 0 {
				g.res[m3] = x;
				m3++;
			}
			j++;
		}
		m = m3;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered evens with retry: ", m);
	out
}
@end
@entry d208014f8a74ba2a
kind: step
verb: filter
noun: duplicates
modifier: until
context: filter
slot: max_dupes int
phrase: filter duplicates until removing {max_dupes} items
phrase: remove duplicate elements until quota of {max_dupes}
test: list=3,5,3,7,3,9,5 max_dupes=2
expect: => i=2 r=0.0 ok=true s="filtered duplicates until quota: 2" errors=0 n=5 res=[3,5,7,9,5] cache=0 hits=0
test: list=2,4,2,6,4,8,2 max_dupes=1
expect: => i=1 r=0.0 ok=true s="filtered duplicates until quota: 1" errors=0 n=6 res=[2,4,6,4,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let quota = ${max_dupes};
	var removed = 0;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { seen = true; }
			j++;
		}
		if seen && removed < quota {
			removed++;
		} else {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered duplicates until quota: ", removed);
	out
}
@end
@entry 251efc08a7317111
kind: step
verb: rank
noun: runs
modifier: safely
context: filter
slot: min_len int
phrase: rank runs safely keeping streaks of at least {min_len}
phrase: safely filter runs ranking streaks of length {min_len}
test: list=1,2,3,2,1,4,5,6,7 min_len=3
expect: => i=8 r=0.0 ok=true s="ranked safe runs count: 8" errors=0 n=8 res=[1,2,3,1,4,5,6,7] cache=0 hits=0
test: list=5,4,3,1,2,3,4 min_len=4
expect: => i=4 r=0.0 ok=true s="ranked safe runs count: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var keep int[512] = [0; 512];
	var kp = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j + 1] > g.res[j] {
			j++;
		}
		let run_len = j - i + 1;
		if run_len >= ml {
			var k = i;
			while k <= j {
				keep[kp] = g.res[k];
				kp++;
				k++;
			}
		}
		i = j + 1;
	}
	for k in kp {
		g.res[k] = keep[k];
	}
	g.n = kp;
	g.steps += kp + g.n;
	out.i = kp;
	out.s.clear();
	format(out.s, "ranked safe runs count: ", kp);
	out
}
@end
