code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_gap = ${gap};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var hit = g.n - 1;
	for i in 0..(g.n - 1) {
		if g.res[i + 1] - g.res[i] > max_gap {
			hit = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = hit;
	out.s.clear();
	format(out.s, "stopped pair scan at index: ", hit);
	out
}
@end
