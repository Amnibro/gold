code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cache max: no results");
		out.ok = false;
		return out;
	}
	var m = g.res[0];
	for k in 1..g.n {
		if g.res[k] > m { m = g.res[k]; }
	}
	gold_cache_put(g, 0, m);
	out.i = m;
	out.s.clear();
	format(out.s, "cached max");
	out
}
@end
