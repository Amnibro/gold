expect: => i=4 r=0.0 ok=true s="rotated function every other: 4" errors=0 n=4 res=[5,3,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if i % 2 == 0 { x = ${f}(x); }
		if x >= 0 {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "rotated function every other: ", m);
	out
}
@end
