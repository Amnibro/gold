noun: values
modifier: times
context: search
phrase: dedupe search values repeating {t} times
phrase: limit duplicate values to occurrences {t}
slot: t int
test: list=1,1,2,2,3 t=1
expect: => i=1 r=0.0 ok=true s="deduped values occurrences: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,5,10,10 t=2
expect: => i=2 r=0.0 ok=true s="deduped values occurrences: 3" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${t};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	out.i = limit;
	out.s.clear();
	format(out.s, "deduped values occurrences: ", dropped);
	g.steps += g.n;
	out
}
@end
