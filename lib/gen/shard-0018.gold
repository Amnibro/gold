test: text="dog cow bird dog"
expect: => i=3 r=0.0 ok=true s="dog cow bird" errors=0 n=0 res=[] cache=0 hits=0
expect: => words=[dog,cow,bird,dog]
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_words_of(g, out.s);
	var uniq byte[..32][128] = [""; 128];
	var un = 0;
	for i in g.wn {
		let w = g.wl[i];
		var seen = false;
		for j in un {
			if uniq[j] == w { seen = true; break; }
		}
		if !seen && un < 128 {
			uniq[un] = w;
			un++;
		}
	}
	for i in un {
		for j in un - 1 - i {
			if uniq[j] > uniq[j + 1] {
				let tmp = uniq[j];
				uniq[j] = uniq[j + 1];
				uniq[j + 1] = tmp;
			}
		}
	}
	out.s.clear();
	for i in un {
		if i > 0 { out.s.push(' '); }
		format(out.s, uniq[i]);
	}
	g.steps += un;
	out.i = un;
	out
}
@end
