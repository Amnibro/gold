@entry 0dce4e73c8905547
kind: step
verb: check
noun: history
modifier: at_least
context: sort
slot: target int
phrase: check sorted history values reaching at least {target}
phrase: verify sorted history sequence contains at least {target}
test: list=5,2,8 target=7
expect: => i=8 r=0.0 ok=true s="sorted history meets target: 7" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=4,1,6 target=10
expect: => i=6 r=0.0 ok=false s="sorted history below target: 10" errors=0 n=3 res=[1,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let top = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.i = top;
	out.ok = g.n > 0 && top >= tgt;
	g.steps += g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "sorted history meets target: ", tgt);
	} else {
		format(out.s, "sorted history below target: ", tgt);
	}
	out
}
@end
@entry 5eb1b6d4830ffb41
kind: step
verb: check
noun: budget
modifier: pairwise
context: sort
slot: limit int
phrase: check pairwise sorted differences within budget limit {limit}
phrase: verify adjacent sorted differences remain within budget {limit}
test: list=7,2,5 limit=4
expect: => i=3 r=0.0 ok=true s="pairwise differences within budget: 4" errors=0 n=3 res=[2,5,7] cache=0 hits=0
test: list=9,1,4 limit=3
expect: => i=5 r=0.0 ok=false s="pairwise difference exceeded budget: 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var max_diff = 0;
	var ok = true;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let d = g.res[i + 1] - g.res[i];
			if d > max_diff { max_diff = d; }
			if d > lim { ok = false; }
		}
	}
	out.i = max_diff;
	out.ok = ok;
	g.steps += g.n;
	out.s.clear();
	if ok {
		format(out.s, "pairwise differences within budget: ", lim);
	} else {
		format(out.s, "pairwise difference exceeded budget: ", lim);
	}
	out
}
@end
