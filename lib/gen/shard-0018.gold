@entry 12093631daf658d5
kind: step
verb: check
noun: digits
modifier: recursively
context: sort
slot: min_sum int
phrase: check sorted element digit sums recursively exceeding {min_sum}
phrase: verify sorted item recursive digit totals above {min_sum}
test: list=19,5,12,3 min_sum=4
expect: => i=2 r=0.0 ok=true s="elements meeting digit threshold: 2" errors=0 n=4 res=[3,5,12,19] cache=0 hits=0
test: list=25,11,8 min_sum=8
expect: => i=1 r=0.0 ok=true s="elements meeting digit threshold: 1" errors=0 n=3 res=[8,11,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_sum};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var c = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s >= lim { c++; }
	}
	g.steps += g.n;
	out.i = c;
	out.s.clear();
	format(out.s, "elements meeting digit threshold: ", c);
	out
}
@end
