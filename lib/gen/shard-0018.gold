code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	let n = out.s.len;
	if sp <= 0 || n < sp || n % sp != 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var is_loop = true;
	for i in n {
		if out.s[i] != out.s[i % sp] {
			is_loop = false;
			break;
		}
	}
	let reps = n / sp;
	g.steps += n;
	out.i = if is_loop { reps } else { 0 };
	out.ok = is_loop;
	out
}
@end
