@entry 55c1c41dd5f65265
kind: step
verb: swap
noun: counter
modifier: with_retry
context: sort
slot: retries int
phrase: swap inversions counter with retry allowance {retries}
phrase: execute out of order swaps with retry limit {retries}
test: list=3,1,2 retries=5
expect: => i=2 r=0.0 ok=true s="sorting swaps performed: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,3,2,1 retries=2
expect: => i=2 r=0.0 ok=false s="sorting swaps exceeded retry budget: 2" errors=0 n=4 res=[3,2,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${retries};
	var swaps = 0;
	var exceeded = false;
	for i in g.n {
		for j in 0..(g.n - 1) {
			if g.res[j] > g.res[j + 1] {
				if swaps < budget {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
					swaps++;
				} else {
					exceeded = true;
					break;
				}
			}
		}
		if exceeded { break; }
	}
	out.i = swaps;
	out.ok = !exceeded;
	g.steps += g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "sorting swaps performed: ", swaps);
	} else {
		format(out.s, "sorting swaps exceeded retry budget: ", budget);
	}
	out
}
@end
