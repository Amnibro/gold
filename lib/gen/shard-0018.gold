test: list=10,25,45,60 cap_val=30
expect: => i=2 r=0.0 ok=true s="clamped memo count: 2" errors=0 n=4 res=[10,25,30,30] cache=4 hits=0
test: list=5,15,25,35 cap_val=20
expect: => i=2 r=0.0 ok=true s="clamped memo count: 2" errors=0 n=4 res=[5,15,20,20] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap_val};
	if cap < 0 { gold_fail(g, "invalid cap"); out.ok = false; return out; }
	var clamped = 0;
	for i in g.n {
		if g.res[i] > cap {
			g.res[i] = cap;
			clamped++;
		}
		gold_cache_put(g, i + 1, g.res[i]);
	}
	g.steps += clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped memo count: ", clamped);
	out
}
@end
