code:
fn ${ID}_isp(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_p = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${ID}_isp(g.res[i]) {
			last_p = g.res[i];
			break;
		}
		i--;
	}
	out.i = last_p;
	out.s.clear();
	format(out.s, "last prime found: ", last_p);
	g.steps += g.n;
	out
}
@end
