code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b < 0 || g.n < 2 { gold_fail(g, "invalid bound"); out.ok = false; return out; }
	var acc = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			let diff = g.res[j] - g.res[i];
			if diff <= b { acc += diff; }
		}
	}
	gold_push(g, acc);
	g.steps += acc;
	out.i = acc;
	out.s.clear();
	format(out.s, "nested range folded: ", acc);
	out
}
@end
