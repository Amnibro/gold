test: list=1,2,3,4,5,6 step_size=2
expect: => i=3 r=0.0 ok=true s="folded streak each: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 step_size=3
expect: => i=2 r=0.0 ok=true s="folded streak each: 2" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	if sz <= 0 { return out; }
	var m = 0;
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		var j = i + 1;
		while j < g.n && j - i < sz {
			sum += g.res[j];
			j++;
		}
		g.res[m] = sum;
		m++;
		i = j;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "folded streak each: ", m);
	out
}
@end
