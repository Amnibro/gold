test: list=3,9,5,9,2
expect: => i=2 r=0.0 ok=true s="drop_maximum_in_place: 2" errors=0 n=3 res=[3,5,2] cache=0 hits=0
test: list=8,1,4,8,3
expect: => i=2 r=0.0 ok=true s="drop_maximum_in_place: 2" errors=0 n=3 res=[1,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mx = g.res[0];
	for i in 1 .. g.n {
		if g.res[i] > mx { mx = g.res[i]; }
	}
	var write = 0;
	for i in 0 .. g.n {
		if g.res[i] != mx {
			g.res[write] = g.res[i];
			write++;
		}
	}
	let dropped = g.n - write;
	g.n = write;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop_maximum_in_place: ", dropped);
	out
}
@end
@entry 67b2ea339127e7e7
