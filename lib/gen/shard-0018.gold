expect: => doc: part cyl 0,0,0 0,0,0.1 r0.05
expect: => doc: rib3 box 0,0,0.02 0.03,0.03,0.02 -
test: w=0.03 doc="base box 0,0,0 1,1,0.1|pin cyl 0,0,0 0,0,0.2 r0.04"
expect: => i=3 r=0.0 ok=true s="ntchribrad" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: base box 0,0,0 1,1,0.1
expect: => doc: pin cyl 0,0,0 0,0,0.2 r0.04
expect: => doc: rib3 box 0,0,0.02 0.03,0.03,0.03 -
test: w=0.04
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_ntchribrad_box_sub
	var out = v;
	var o byte[>..] = [];
	var last byte[>..] = [];
	if !gold_dlast(g, last) { out.ok = false; return out; }
	gold_dnew(g, "rib", o);
	o.append(" box ");
	o.append("0,");
	o.append("0,");
	o.append("0.");
	o.append("02 ");
	o.append("0.");
	o.append("03,");
	o.append("0.");
	o.append("03,");
	gold_fnum(o, ${w});
	o.append(" -");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ntchribrad");
	out
}
@end
