noun: odds
modifier: sorted
context: aggregate
phrase: split odds into sorted sequence
phrase: isolate odd values sorted ascending
test: list=4,7,2,9,5,6
expect: => i=3 r=0.0 ok=true s="split_odds_sorted: 3" errors=0 n=3 res=[5,7,9] cache=0 hits=0
test: list=8,11,3,14,7
expect: => i=3 r=0.0 ok=true s="split_odds_sorted: 3" errors=0 n=3 res=[3,7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = [0; 64];
	var on = 0;
	for i in 0 .. g.n {
		if g.res[i] % 2 != 0 {
			if on < 64 { odds[on] = g.res[i]; on++; }
		}
	}
	for i in 0 .. on {
		for j in i + 1 .. on {
			if odds[j] < odds[i] {
				let t = odds[i];
			odds[i] = odds[j];
			odds[j] = t;
			}
		}
	}
	for i in 0 .. on { g.res[i] = odds[i]; }
	g.n = on;
	g.steps += g.n;
	out.i = on;
	out.s.clear();
	format(out.s, "split_odds_sorted: ", on);
	out
}
@end
