test: list=2,3,5,7,11 k=2
expect: => i=2 r=0.0 ok=true s="shifted primes last" errors=0 n=5 res=[7,11,2,3,5] cache=0 hits=0
test: list=10,20,30 k=1
expect: => i=1 r=0.0 ok=true s="shifted primes last" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let shift_cnt = if k < g.n { if k > 0 { k } else { 0 } } else { g.n };
	if g.n > 0 && shift_cnt > 0 {
		var tmp int[512] = [0; 512];
		for i in g.n {
			tmp[i] = g.res[i];
		}
		for i in shift_cnt {
			g.res[i] = tmp[g.n - shift_cnt + i];
		}
		for i in (g.n - shift_cnt) {
			g.res[shift_cnt + i] = tmp[i];
		}
	}
	g.steps += g.n;
	out.i = shift_cnt;
	out.s.clear();
	format(out.s, "shifted primes last");
	out
}
@end
