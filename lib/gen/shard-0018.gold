code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${lo};
	let upper = ${hi};
	var adjusted = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x < lower {
			g.res[i] = lower;
			adjusted++;
		} else if x > upper {
			g.res[i] = upper;
			adjusted++;
		}
		i++;
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped values adjusted: ", adjusted);
	g.steps += g.n;
	out
}
@end
