code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if mv < 0 { gold_fail(g, "invalid min_val"); out.ok = false; return out; }
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mv && ${ID}_is_prime(x) { count++; }
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "primes at least bound: ", count);
	out
}
@end
