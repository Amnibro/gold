code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		if x >= lim { break; }
		total += x;
		gold_cache_put(g, idx, total);
		idx++;
	}
	g.steps += idx;
	out.i = total;
	out.s.clear();
	format(out.s, "joined ", idx, " steps until limit");
	out
}
@end
