test: list=10,20,30,40 count=1
expect: => i=1 r=0.0 ok=true s="rotated text times: 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,15,25 count=2
expect: => i=2 r=0.0 ok=true s="rotated text times: 2" errors=0 n=3 res=[25,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if g.n > 1 && cnt > 0 {
		var s = cnt % g.n;
		while s > 0 {
			let first = g.res[0];
			var j = 0;
			while j < g.n - 1 {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.res[g.n - 1] = first;
			s--;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "rotated text times: ", cnt);
	out
}
@end
