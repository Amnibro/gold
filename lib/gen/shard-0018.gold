code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[kept] = x;
				kept++;
			}
		}
		i += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected squares: ", kept);
	out
}
@end
@entry 6cccf747696049fc
kind: step
verb: reverse
noun: subfunction
modifier: up_to
context: list
phrase: reverse subfunction up to index {lim} using {f}
phrase: list reverse subfunction up to limit {lim} with {f}
slot: f fn
slot: lim int
test: list=1,2,3,4 f=double lim=2
expect: => i=2 r=0.0 ok=true s="reversed up to: 2" errors=0 n=4 res=[4,2,6,8] cache=0 hits=0
test: list=5,6,7,8 f=inc lim=3
expect: => i=3 r=0.0 ok=true s="reversed up to: 3" errors=0 n=4 res=[8,7,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = ${f}(g.res[k]);
	}
	let m = ${lim};
	var end = m;
	if end > g.n { end = g.n; }
	var l = 0;
	var r = end - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n + end;
	out.i = end;
	out.s.clear();
	format(out.s, "reversed up to: ", end);
	out
}
@end
