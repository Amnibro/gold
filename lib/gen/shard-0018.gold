code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var l = 0;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	for k in g.n {
		g.res[k] = g.res[k] * m;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled reversed count: ", g.n);
	out
}
@end
