fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in 0 .. g.n {
		var freq = 0;
		for j in 0 .. g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq == 1 {
			g.res[write] = g.res[i];
			write++;
		}
	}
	let dropped = g.n - write;
	g.n = write;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop_histogram_all: ", dropped);
	out
}
@end
