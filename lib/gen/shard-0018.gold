@entry ee9d30d49897894e
kind: step
verb: sort
noun: primes
modifier: recursively
context: math
phrase: sort primes recursively placing prime numbers first
phrase: separate primes recursively in ascending order in math
test: list=6,5,4,3,2,1
expect: => i=3 r=0.0 ok=true s="primes separated: 3" errors=0 n=6 res=[5,3,2,6,4,1] cache=0 hits=0
test: list=10,13,8,7,12,11
expect: => i=3 r=0.0 ok=true s="primes separated: 3" errors=0 n=6 res=[13,7,11,10,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var primes int[256];
	var nonprimes int[256];
	var np_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[p_count] = x;
			p_count++;
		} else {
			nonprimes[np_count] = x;
			np_count++;
		}
	}
	for i in p_count { g.res[i] = primes[i]; }
	for i in np_count { g.res[p_count + i] = nonprimes[i]; }
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "primes separated: ", p_count);
	out
}
@end
