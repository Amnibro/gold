code:
fn ${ID}(g Gold&, v Val) Val {
	// step_tex_speckle_sand_fine
	var out = v;
	if !gold_img_square(g, 2) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] - 0.1); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
