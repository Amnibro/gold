fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var matched = 0;
	var pass = 0;
	while pass < t {
		for k in g.n {
			let val, found = gold_cache_get(g, g.res[k]);
			if found { matched++; }
		}
		pass++;
	}
	g.steps += t * g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "memo hits count: ", matched);
	out
}
@end
