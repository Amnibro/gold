kind: step
verb: weather
noun: height
modifier: sharp
context: texture
phrase: weather sharp height map with seed {u}
phrase: sharp weathered elevation profile using seed {u}
slot: u int
model: fbm n=2 c=4 u=${u}; slope; contrast a=1.6
test: img=16 u=2
expect: => i=256 r=0.0 ok=true s="height" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.261 sum8=1056 hash=500131
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="height" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=0.206 sum8=1670 hash=37473
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if 2 < 1 || 2 > 5 { gold_fail(g, "octaves must be in range"); out.ok = false; return out; }
	var c0 = 4;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s_buf_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_buf_2[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_buf_2;
	if !gold_img_ok(g) { out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.6 + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "height");
	out
}
@end
