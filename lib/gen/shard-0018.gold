fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let fl = ${floor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var c = 0;
	for k in g.n {
		if g.res[k] > fl { c++; }
	}
	out.i = c;
	out.ok = c <= lim;
	g.steps += g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "threshold count within limit: ", c);
	} else {
		format(out.s, "threshold count exceeded limit: ", lim);
	}
	out
}
