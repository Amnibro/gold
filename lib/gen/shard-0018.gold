code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_steps};
	var n = out.i;
	var steps = 0;
	while n > 1 {
		n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 };
		steps++;
		if steps > ms {
			out.ok = false;
			gold_fail(g, "collatz exceeded step limit");
			break;
		}
	}
	g.steps += steps;
	out.i = steps;
	out
}
@end
