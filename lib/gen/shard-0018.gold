phrase: aggregate digit gaps from first element
phrase: accumulate gaps against leading digit
test: arg=8241,7531
expect: 17
expect: 12
test: arg=999
expect: 0
code:
fn ${ID}(n int) int {
	var gap_v = if n < 0 { -n } else { n };
	var gap_rev = 0;
	while gap_v > 0 {
		gap_rev = gap_rev * 10 + (gap_v % 10);
		gap_v /= 10;
	}
	let gap_lead = gap_rev % 10;
	gap_rev /= 10;
	var gap_total = 0;
	while gap_rev > 0 {
		let gd = gap_rev % 10;
		let gdiff = if gd >= gap_lead { gd - gap_lead } else { gap_lead - gd };
		gap_total += gdiff;
		gap_rev /= 10;
	}
	gap_total
}
@end
