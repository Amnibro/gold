code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stp = ${stop_val};
	var w = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > stp { break; }
		if g.res[i] % 2 == 0 {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
