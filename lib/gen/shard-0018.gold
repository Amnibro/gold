fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var filtered = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq >= mf {
			var already = false;
			for k in i { if g.res[k] == x { already = true; break; } }
			if !already {
				gold_cache_put(g, x, freq);
				filtered++;
			}
		}
	}
	out.i = filtered;
	out.s.clear();
	format(out.s, "items meeting freq ", filtered);
	out
}
@end
