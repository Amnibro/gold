slot: max_cap int
test: arg=15,80 max_cap=100
expect: 30
expect: 100
test: arg=200 max_cap=150
expect: 150
code:
fn ${ID}(n int) int {
	let ceiling = ${max_cap};
	var shift_input = if n < 0 { -n } else { n };
	var shifted = shift_input * 2;
	if shifted > ceiling {
		shifted = ceiling;
	}
	shifted
}
@end
