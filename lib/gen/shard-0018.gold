test: list=2,3,4 gap_limit=5
expect: => i=0 r=0.0 ok=true s="gaps exceeding limit: 0" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gl = ${gap_limit};
	var count = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > gl { count++; }
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps exceeding limit: ", count);
	out
}
@end
