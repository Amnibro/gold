fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let srr_f = ${factor};
	var srr_cur = 0;
	for srr_i in g.n {
		srr_cur += g.res[srr_i];
		g.res[srr_i] = srr_cur * srr_f;
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "running scaled: ", out.i);
	out
}
