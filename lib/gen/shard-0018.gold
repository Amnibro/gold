code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${dist};
	for i in g.n {
		let target_pos = (i + d) % g.n;
		gold_cache_put(g, target_pos, g.res[i]);
	}
	out.i = d;
	out.s.clear();
	format(out.s, "rotated sequence distance ", d);
	out
}
@end
