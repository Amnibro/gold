code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var last_idx = -1;
	for k in g.n {
		if g.res[k] > thresh { last_idx = k; }
	}
	if last_idx >= 0 {
		g.res[last_idx] = thresh;
		out.i = last_idx;
		out.s.clear();
		format(out.s, "clamped last outlier at index ", last_idx);
	} else {
		out.i = -1;
		out.s.clear();
		format(out.s, "no outlier condition found");
	}
	g.steps += g.n;
	out
}
@end
