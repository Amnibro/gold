test: img=16 u=3
expect: => i=256 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.5 max=1 sum8=49469 hash=219080
test: img=32 u=7
expect: => i=1024 r=0.0 ok=true s="bricks" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=149437 hash=606988
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	// step_tex_blend_bricks_none
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 8;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 8;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	for k in g.iw * g.ih {
		var q = (g.img[k] * (5.0)) as! int;
		if q > 4 { q = 4; }
		g.img[k] = (q as real) / (4.0);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "bricks");
	out
}
@end
