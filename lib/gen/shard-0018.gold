test: text="abcdef" shift=2
expect: => i=6 r=0.0 ok=true s="cdefab" errors=0 n=0 res=[] cache=1 hits=0
test: text="hellobigworld" shift=5
expect: => i=10 r=0.0 ok=true s="bigworldhello" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	let n = out.s.len;
	if n <= 1 || sh <= 0 { return out; }
	let k = sh % n;
	var rot byte[>..] = [];
	for i in n {
		rot.push(out.s[(i + k) % n]);
	}
	var uniq = 0;
	for i in n {
		let c = rot[i];
		var seen = false;
		for j in i {
			if rot[j] == c { seen = true; break; }
		}
		if !seen { uniq++; }
	}
	gold_cache_put(g, sh, uniq);
	out.s.clear();
	for b in rot { out.s.push(b); }
	g.steps += n;
	out.i = uniq;
	out
}
@end
