expect: => i=3210 r=0.0 ok=true s="reverse folded 3210" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rev_sum = 0;
	var i = g.n;
	while i > 0 {
		i--;
		rev_sum = rev_sum * 10 + g.res[i];
		gold_cache_put(g, i, rev_sum);
	}
	out.i = rev_sum;
	out.s.clear();
	format(out.s, "reverse folded ", rev_sum);
	out
}
@end
@entry ae0a3a3cfd172264
kind: step
verb: dedupe
noun: cache
modifier: times
context: cache
phrase: dedupe cache times recurring over threshold {thresh}
phrase: remove duplicate cache timestamps above {thresh}
slot: thresh int
test: list=10,20,20,30,40 thresh=15
expect: => i=3 r=0.0 ok=true s="distinct items above thresh 3" errors=0 n=5 res=[10,20,20,30,40] cache=3 hits=0
test: list=5,5,10,12 thresh=8
expect: => i=2 r=0.0 ok=true s="distinct items above thresh 2" errors=0 n=4 res=[5,5,10,12] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		if x > t {
			var seen = false;
			for j in i { if g.res[j] == x { seen = true; break; } }
			if !seen {
				gold_cache_put(g, distinct, x);
				distinct++;
			}
		}
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "distinct items above thresh ", distinct);
	out
}
@end
