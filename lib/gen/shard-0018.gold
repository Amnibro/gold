@entry ac0c99135143191b
kind: step
verb: shift
noun: digits
modifier: with_retry
context: core
phrase: rotate digits of integer left
phrase: cycle number digits to left
test: input=1234
expect: => i=2341 r=0.0 ok=true s="digits rotated" errors=0 n=1 res=[2341] cache=0 hits=0
test: input=567
expect: => i=675 r=0.0 ok=true s="digits rotated" errors=0 n=1 res=[675] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i <= 9 && out.i >= -9 {
		gold_push(g, out.i);
		return out;
	}
	var x = if out.i < 0 { -out.i } else { out.i };
	var p = 1;
	while p * 10 <= x { p *= 10; }
	let first = x / p;
	let rem = x % p;
	let rotated = rem * 10 + first;
	out.i = if out.i < 0 { -rotated } else { rotated };
	gold_push(g, out.i);
	out.s.clear();
	format(out.s, "digits rotated");
	out
}
@end
