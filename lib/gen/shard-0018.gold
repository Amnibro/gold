fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var m = 1;
		for i in 1..g.n {
			if g.res[i] != g.res[m - 1] {
				g.res[m] = g.res[i];
				m++;
			}
		}
		g.n = m;
		out.i = m;
	} else {
		out.i = g.n;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "grouped memo safely");
	out
}
@end
