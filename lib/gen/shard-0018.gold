fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tries};
	var m = 0;
	var tries = 0;
	var i = 0;
	while i < g.n && tries < mt {
		let x = g.res[i];
		tries++;
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "returned primes with retry: ", m);
	out
}
@end
