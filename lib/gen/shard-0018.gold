expect: 3
code:
fn ${ID}(n int) int {
	var memo_terms = if n < 1 { 1 } else if n > 30 { 30 } else { n };
	var memo_a = 0;
	var memo_b = 1;
	var memo_step = 1;
	while memo_step < memo_terms {
		let memo_next = memo_a + memo_b;
		memo_a = memo_b;
		memo_b = memo_next;
		memo_step++;
	}
	memo_b
}
@end
@entry 0750279e09596113
kind: fn
verb: measure
noun: value
modifier: unique
context: aggregate
phrase: measure unique digit count in value
phrase: aggregate unique elements in value
phrase: count distinct digits in value
test: arg=122334,987654
expect: 4
expect: 6
test: arg=1111
expect: 1
code:
fn ${ID}(n int) int {
	var uniq_val = if n < 0 { -n } else { n };
	if uniq_val == 0 { return 1; }
	var uniq_mask = 0;
	var uniq_count = 0;
	while uniq_val > 0 {
		let uniq_d = uniq_val % 10;
		let uniq_bit = 1 << uniq_d;
		if (uniq_mask & uniq_bit) == 0 {
			uniq_mask = uniq_mask | uniq_bit;
			uniq_count++;
		}
		uniq_val /= 10;
	}
	uniq_count
}
@end
