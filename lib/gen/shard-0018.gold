code:
fn ${ID}(g Gold&, v Val) Val {
	// step_tex_speckle_tiles_worn
	var out = v;
	if !gold_img_square(g, 2) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.52 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	for k in g.iw * g.ih { g.img[k] = 1.0 - g.img[k]; }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
