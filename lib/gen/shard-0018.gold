fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var err_count = 0;
	var i = 0;
	while i < g.n && err_count < limit {
		if !${p}(g.res[i]) {
			gold_fail(g, "element failed condition");
			err_count++;
			g.res[i] = ${f}(g.res[i]);
		}
		i++;
	}
	g.steps += i;
	out.i = err_count;
	out.s.clear();
	format(out.s, "mapped errors: ", err_count);
	out
}
