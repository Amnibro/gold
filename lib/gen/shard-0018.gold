@entry 3ada1c93205d1ae9
kind: step
verb: rotate
noun: primes
modifier: first
context: math
phrase: rotate primes first moving primes to head
phrase: shift prime numbers to beginning of list in math
test: list=4,7,8,11,9
expect: => i=2 r=0.0 ok=true s="primes rotated count: 2" errors=0 n=5 res=[7,11,4,8,9] cache=0 hits=0
test: list=6,2,10,3,14
expect: => i=2 r=0.0 ok=true s="primes rotated count: 2" errors=0 n=5 res=[2,3,6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var primes int[256];
	var others int[256];
	var o_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[p_count] = x;
			p_count++;
		} else {
			others[o_count] = x;
			o_count++;
		}
	}
	for i in p_count { g.res[i] = primes[i]; }
	for i in o_count { g.res[p_count + i] = others[i]; }
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "primes rotated count: ", p_count);
	out
}
@end
