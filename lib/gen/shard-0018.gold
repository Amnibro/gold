			if g.res[i] == g.res[i - 1] {
				cur_len++;
			} else {
				if cur_len >= mn && cur_len <= mx {
					match_count++;
				}
				cur_len = 1;
			}
		}
		if cur_len >= mn && cur_len <= mx {
			match_count++;
		}
	}
	g.steps += g.n;
	out.i = match_count;
	out.s.clear();
	format(out.s, "matching runs count: ", match_count);
	out
}
@end
@entry 70cec08506f8e1b2
kind: step
verb: shift
noun: text
modifier: times
context: sort
phrase: shift text characters times {k}
phrase: rotate string cyclically {k} times
