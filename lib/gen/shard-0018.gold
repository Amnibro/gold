code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 0 { gold_fail(g, "invalid limit"); out.ok = false; return out; }
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x < lim && ${ID}_is_prime(x) {
			g.res[w] = x;
			w++;
		}
