code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k > 0 && k <= g.n {
		let start = g.n - k;
		for i in k {
			gold_push(g, g.res[start + i]);
		}
	}
	g.steps += k;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated runs last: ", k);
	out
}
@end
