expect: => i=8 r=0.0 ok=true s="merged total at most limit: 8" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=6,3,1,9 limit=5
expect: => i=4 r=0.0 ok=true s="merged total at most limit: 4" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var kept = 0;
	var sum = 0;
	for k in g.n {
		if sum + g.res[k] <= lim {
			sum += g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged total at most limit: ", sum);
	out
}
@end
