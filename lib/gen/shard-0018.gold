fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${depth};
	var cur_d = 0;
	var peak = 0;
	for b in out.s {
		if b == '(' || b == '[' || b == '{' {
			cur_d++;
			if cur_d > peak { peak = cur_d; }
			if cur_d <= max_d { gold_push(g, cur_d); }
		} else if b == ')' || b == ']' || b == '}' {
			if cur_d > 0 { cur_d--; }
		}
	}
	g.steps += out.s.len;
	out.i = peak;
	out.ok = (cur_d == 0);
	out
}
@end
