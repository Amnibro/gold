code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min_val};
	var m = 0;
	for i in g.n {
		if g.res[i] >= min_v {
			g.res[m] = g.res[i];
			m++;
		}
	}
	g.n = m;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted items count: ", g.n);
	out
}
@end
