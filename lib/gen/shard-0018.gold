code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${wsize};
	let n = out.s.len;
	if w <= 0 || n < w { return out; }
	var max_uniq = 0;
	for i in (n - w + 1) {
		var uniq = 0;
		for j in w {
			let c = out.s[i + j];
			var seen = false;
			for k in j {
				if out.s[i + k] == c { seen = true; break; }
			}
			if !seen { uniq++; }
		}
		if uniq > max_uniq { max_uniq = uniq; }
	}
	g.steps += n;
	out.i = max_uniq;
	out
}
@end
