code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shu_tgt = ${target};
	var shu_sum = 0;
	for shu_k in g.n { shu_sum += g.res[shu_k]; }
	var shu_rounds = 0;
	while shu_sum < shu_tgt && shu_rounds < 20 {
		for shu_i in g.n {
			g.res[shu_i] *= 2;
		}
		shu_sum *= 2;
		shu_rounds++;
	}
	g.steps += shu_rounds * g.n;
	out.i = shu_sum;
	out.s.clear();
	format(out.s, "history scaled: ", shu_sum);
	out
}
@end
