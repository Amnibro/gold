fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_sum = 0;
	for i in 0 .. g.n {
		var seen_before = false;
		for j in 0 .. i {
			if g.res[j] == g.res[i] { seen_before = true; break; }
		}
		if seen_before { dup_sum += g.res[i]; }
	}
	g.steps += g.n;
	out.i = dup_sum;
	out.s.clear();
	format(out.s, "sum_duplicates_running: ", dup_sum);
	out
}
@end
