code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	let max_step = 5;
	if g.n >= 2 {
		for i in 0 .. g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			let abs_d = if d < 0 { -d } else { d };
		if abs_d > max_step { valid = false; break; }
		}
	}
	g.steps += g.n;
	out.i = if valid { 1 } else { 0 };
	out.ok = valid;
	out.s.clear();
	format(out.s, "compare_steps_at_most: ", out.i);
	out
}
@end
