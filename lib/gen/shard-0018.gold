code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var gaps int[512] = [0; 512];
		var m = 0;
		var i = g.n - 1;
		while i > 0 {
			gaps[m] = g.res[i] - g.res[i - 1];
			m++;
			i--;
		}
		for k in m {
			g.res[k] = gaps[k];
		}
		g.n = m;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reverse gaps computed");
	out
}
@end
