test: list=10,20,30 budget=100
expect: => i=40 r=0.0 ok=true s="remaining budget: 40" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 budget=25
expect: => i=5 r=0.0 ok=true s="remaining budget: 5" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var spent = 0;
	for k in g.n {
		if rem >= g.res[k] {
			rem -= g.res[k];
			spent += g.res[k];
		} else {
			gold_fail(g, "budget exceeded");
			break;
		}
	}
	g.steps += g.n;
	out.i = rem;
	out.s.clear();
	format(out.s, "remaining budget: ", rem);
	out
}
@end
