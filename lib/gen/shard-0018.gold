@entry 8afd4e49aff820f6
kind: step
verb: measure
noun: loop
modifier: any
context: list
phrase: measure loop any cycles in list
phrase: list measure loop any occurrences
test: list=1,2,3,1,2
expect: => i=1 r=0.0 ok=true s="loop detected" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=4,5,6
expect: => i=0 r=0.0 ok=true s="no loop" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				found = 1;
				break;
			}
			j++;
		}
		if found == 1 { break; }
		i++;
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	if found == 1 {
		format(out.s, "loop detected");
	} else {
		format(out.s, "no loop");
	}
	out
}
@end
@entry 063afbfa0291d635
kind: step
verb: scale
noun: odds
modifier: times
context: list
phrase: scale odds times repeat {times} factor {factor}
phrase: list scale odds times count {times} multiplier {factor}
slot: factor int
slot: times int
test: list=1,2,3,4 factor=3 times=2
expect: => i=2 r=0.0 ok=true s="scaled odds: 2" errors=0 n=4 res=[9,2,27,4] cache=0 hits=0
test: list=5,7,8 factor=2 times=1
expect: => i=2 r=0.0 ok=true s="scaled odds: 2" errors=0 n=3 res=[10,14,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let t = ${times};
	var cnt = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			var p = 0;
			while p < t {
				g.res[k] = g.res[k] * f;
				p++;
			}
			cnt++;
		}
	}
	g.steps += g.n * t;
	out.i = cnt;
	out.s.clear();
	format(out.s, "scaled odds: ", cnt);
	out
}
@end
