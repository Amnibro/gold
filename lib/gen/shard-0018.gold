code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		var streak_len = j - i;
		if streak_len > lim { streak_len = lim; }
		pairs += streak_len / 2;
		i = j;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "streaks paired: ", pairs);
	out
}
@end
