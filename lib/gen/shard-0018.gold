fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[256];
	var alt_n = 0;
	var i = 0;
	while i < g.n {
		alt[alt_n] = g.res[i];
		alt_n++;
		i += 2;
	}
	var dups = 0;
	for j in alt_n {
		for k in j {
			if alt[k] == alt[j] { dups++; break; }
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "alternate duplicates: ", dups);
	out
}
@end
