kind: step
verb: merge
noun: head
modifier: while
context: list
phrase: merge head while predicate {cond} holds
phrase: list merge head elements while {cond}
slot: cond pred
test: list=2,4,6,3,8 cond=is_even
expect: => i=12 r=0.0 ok=true s="merged head: 12" errors=0 n=3 res=[12,3,8] cache=0 hits=0
test: list=1,3,5 cond=is_odd
expect: => i=9 r=0.0 ok=true s="merged head: 9" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var sum = 0;
	while count < g.n && ${cond}(g.res[count]) {
		sum += g.res[count];
		count++;
	}
	if count > 0 {
		g.res[0] = sum;
		var i = 1;
		while i + count - 1 < g.n {
			g.res[i] = g.res[i + count - 1];
			i++;
		}
		g.n = g.n - count + 1;
	}
	g.steps += count + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged head: ", sum);
	out
}
@end
@entry 5c3efd87dfc7db5d
kind: step
verb: scan
noun: tally
modifier: sorted
context: list
phrase: scan tally sorted distribution in list
phrase: list scan tally sorted counts
test: list=1,2,2,3,3,3
expect: => i=1 r=0.0 ok=true s="tally sorted" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=1,1,1,2
expect: => i=0 r=0.0 ok=true s="tally unsorted" errors=0 n=4 res=[1,1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = 1;
	var prev_cnt = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var seen_before = false;
		for j in i { if g.res[j] == val { seen_before = true; break; } }
		if !seen_before {
			var cnt = 0;
			for j in g.n { if g.res[j] == val { cnt++; } }
			if cnt < prev_cnt { is_sorted = 0; break; }
			prev_cnt = cnt;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = is_sorted;
	out.s.clear();
	if is_sorted == 1 {
		format(out.s, "tally sorted");
	} else {
		format(out.s, "tally unsorted");
	}
	out
}
@end
