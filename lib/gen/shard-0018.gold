noun: tally
modifier: first
context: aggregate
phrase: drop tally first unique element
phrase: remove first item based on tally
test: list=7,2,2,3
expect: => i=1 r=0.0 ok=true s="drop_tally_first: 1" errors=0 n=3 res=[2,2,3] cache=0 hits=0
test: list=5,5,4,6
expect: => i=1 r=0.0 ok=true s="drop_tally_first: 1" errors=0 n=3 res=[5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var target = -1;
	for i in 0 .. g.n {
		var freq = 0;
		for j in 0 .. g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq == 1 {
			target = i;
			break;
		}
	}
	if target >= 0 {
		for i in target .. g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "drop_tally_first: ", out.i);
	out
}
@end
