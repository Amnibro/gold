expect: 10
expect: 50
expect: 50
code:
fn ${ID}(n int) int {
	// format fn sort range between entry 10
var v = n;
	let lo = 10;
	let hi = 50;
	if v < lo { v = lo; }
	if v > hi { v = hi; }
	v
}
@end
