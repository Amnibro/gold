fn ${ID}_isq(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lo};
	var count = 0;
	let orig_n = g.n;
	for i in orig_n {
		let x = g.res[i];
		if x >= bound && ${ID}_isq(x) {
			gold_push(g, x);
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "repeated square items: ", count);
	g.steps += orig_n;
	out
}
@end
