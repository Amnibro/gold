phrase: sort retry limit pairwise difference
phrase: pairwise difference of retry limit digits
test: arg=182,735
expect: 7
expect: 4
test: arg=90
expect: 9
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var prev = x % 10;
	x /= 10;
	var max_diff = 0;
	while x > 0 {
		let d = x % 10;
		let diff = if d > prev { d - prev } else { prev - d };
		if diff > max_diff { max_diff = diff; }
		prev = d;
		x /= 10;
	}
	max_diff
}
@end
