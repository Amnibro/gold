fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var count = 0;
	var k = g.n - 1;
	while k >= 0 && g.res[k] == last_val {
		count++;
		k--;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "trailing run");
	out
}
@end
