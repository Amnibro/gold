		if i + 3 < n && out.s[i] == out.s[i + 2] && out.s[i + 1] == out.s[i + 3] {
			res.push(out.s[i]);
			res.push(out.s[i + 1]);
			i += 4;
		} else {
			res.push(out.s[i]);
			i++;
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += n;
	out.i = out.s.len;
	out
}
