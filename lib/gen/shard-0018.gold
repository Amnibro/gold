@entry 3d048c783fde5168
kind: step
verb: search
noun: item
modifier: sorted
context: math
slot: target int
phrase: search item sorted using binary lookup for {target}
phrase: find target index in ordered results {target}
test: list=15,3,9,27 target=9
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[3,9,15,27] cache=0 hits=0
test: list=40,10,20 target=25
expect: => i=-1 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var found = -1;
	var lo = 0;
	var hi = g.n - 1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found;
	out
}
@end
