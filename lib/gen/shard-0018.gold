fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let kpu_c = ${ceiling};
	var kpu_sum = 0;
	var kpu_cnt = 0;
	while kpu_cnt < g.n && (kpu_sum + g.res[kpu_cnt]) <= kpu_c {
		kpu_sum += g.res[kpu_cnt];
		kpu_cnt++;
	}
	g.n = kpu_cnt;
	g.steps += kpu_cnt;
	out.i = kpu_cnt;
	out.s.clear();
	format(out.s, "kept prefix: ", kpu_cnt);
	out
}
@end
@entry ac18fd2bde802776
kind: step
verb: scan
noun: average
modifier: recursively
context: core
phrase: scan average recursively across {rounds} passes
phrase: calculate recursive average passes {rounds} times
slot: rounds int
test: list=10,20,30,40 rounds=1
expect: => i=15 r=0.0 ok=true s="recursive average: 15" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=10,20,30,40 rounds=2
expect: => i=20 r=0.0 ok=true s="recursive average: 20" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sar_r = ${rounds};
	if g.n == 0 || sar_r <= 0 {
		out.ok = false;
		return out;
	}
	var sar_iter = 0;
	while sar_iter < sar_r && g.n > 1 {
		for sar_j in (g.n - 1) {
			g.res[sar_j] = (g.res[sar_j] + g.res[sar_j + 1]) / 2;
		}
		g.n--;
		sar_iter++;
	}
	g.steps += sar_iter;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "recursive average: ", out.i);
	out
}
@end
