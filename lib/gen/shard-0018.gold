fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let lim = if k < out.s.len { if k > 0 { k } else { 0 } } else { out.s.len };
	for i in lim {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			out.s[i] = (c - 32) as byte;
		}
	}
	g.steps += lim;
	out.i = lim;
	out
}
