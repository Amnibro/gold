fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var sorted int[256];
		for i in g.n { sorted[i] = g.res[i]; }
		for i in g.n {
			for j in g.n - 1 {
				if sorted[j] > sorted[j + 1] {
					let tmp = sorted[j];
					sorted[j] = sorted[j + 1];
					sorted[j + 1] = tmp;
				}
			}
		}
		let mid = sorted[g.n / 2];
		out.i = mid;
		out.s.clear();
		format(out.s, "median value: ", mid);
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
