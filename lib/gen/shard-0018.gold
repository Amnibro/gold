				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "sorted primes returned: ", w);
	out
}
@end
