test: list=10,20,25,30
expect: => i=3 r=0.0 ok=true s="computed 3 pairwise squared differences" errors=0 n=3 res=[100,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for pairwise squares");
		return out;
	}
	let pairs = g.n - 1;
	for k in pairs {
		let diff = g.res[k + 1] - g.res[k];
		g.res[k] = diff * diff;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "computed ", pairs, " pairwise squared differences");
	out
}
@end
@entry 209db8d7364d7033
kind: step
verb: limit
noun: average
modifier: up_to
context: stats
phrase: limit sample mean up to target ceiling {ceiling}
phrase: trim series until average is up to {ceiling}
slot: ceiling int
test: list=10,20,90 ceiling=30
expect: => i=2 r=0.0 ok=true s="limited average to length 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15 ceiling=20
expect: => i=2 r=0.0 ok=true s="limited average to length 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	while g.n > 0 && sum / g.n > ceil {
		sum -= g.res[g.n - 1];
		g.n--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited average to length ", g.n);
	out
}
@end
