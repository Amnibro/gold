fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un { if u[j] == x { seen = true; break; } }
		if !seen {
			u[un] = x;
			un++;
		}
	}
	gold_clear(g);
	for k in un { gold_push(g, u[k]); }
	out.i = un;
	out.s.clear();
	format(out.s, "tally unique");
	out
}
@end
