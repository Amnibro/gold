fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let n = out.s.len;
	var i = 0;
	var count = 0;
	while i < n {
		let c = out.s[i];
		var run = 1;
		while i + 1 < n && out.s[i + 1] == c {
			run++;
			i++;
		}
		if run <= lim {
