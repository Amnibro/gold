fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if out.s.len > 0 && d > 0 {
		let shift = d % out.s.len;
		var buf byte[..200] = [];
		for k in shift..out.s.len {
			buf.push(out.s[k]);
		}
		for k in shift {
			buf.push(out.s[k]);
		}
		out.s.clear();
		for b in buf {
			out.s.push(b);
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
