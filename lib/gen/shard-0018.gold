test: text="hello" k=1
expect: => i=5 r=0.0 ok=true s="elloh" errors=0 n=0 res=[] cache=0 hits=0
test: text="sort" k=2
expect: => i=4 r=0.0 ok=true s="rtso" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if out.s.len > 1 && k > 0 {
		let shift = k % out.s.len;
		var buf byte[..200] = [];
		for i in shift..out.s.len {
			buf.push(out.s[i]);
		}
		for i in shift {
			buf.push(out.s[i]);
		}
		out.s.clear();
		for b in buf {
			out.s.push(b);
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
