noun: errors
modifier: with_cache
context: math
slot: tolerance int
phrase: return errors count comparing cache threshold {tolerance}
phrase: measure cache divergence errors beyond tolerance {tolerance}
test: list=5,10,15 tolerance=2
expect: => i=3 r=0.0 ok=true s="" errors=3 n=3 res=[5,10,15] cache=0 hits=0
test: list=20,30,40 tolerance=10
expect: => i=3 r=0.0 ok=true s="" errors=3 n=3 res=[20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var errs = 0;
	var i = 0;
	while i < g.n {
		let cached, ok = gold_cache_get(g, i);
		let diff = g.res[i] - cached;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff > tol {
			errs++;
			gold_fail(g, "divergence from cached baseline");
		}
		i++;
	}
	g.steps += g.n;
	out.i = errs;
	out
}
@end
