	let k = ${len_k};
	if k <= 0 || k > g.n { gold_fail(g, "invalid length"); out.ok = false; return out; }
	var is_uniq = true;
	for i in k {
		for j in (i + 1)..k {
			if g.res[i] == g.res[j] { is_uniq = false; break; }
		}
		if !is_uniq { break; }
	}
	g.steps += k;
	out.i = if is_uniq { 1 } else { 0 };
	out.ok = is_uniq;
	out.s.clear();
	format(out.s, "prefix unique: ", is_uniq);
	out
}
@end
