noun: gaps
modifier: between
context: aggregate
phrase: drop gaps between adjacent values
phrase: remove items with excessive gaps
test: list=10,12,30,32
expect: => i=2 r=0.0 ok=true s="drop_gaps_between: 2" errors=0 n=2 res=[10,12] cache=0 hits=0
test: list=1,3,25,27
expect: => i=2 r=0.0 ok=true s="drop_gaps_between: 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var write = 1;
	for i in 1 .. g.n {
		let d = g.res[i] - g.res[write - 1];
		let abs_d = if d < 0 { -d } else { d };
		if abs_d <= 10 {
			g.res[write] = g.res[i];
			write++;
		}
	}
	let dropped = g.n - write;
	g.n = write;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "drop_gaps_between: ", dropped);
	out
}
@end
