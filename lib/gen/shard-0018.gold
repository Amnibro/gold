code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "running series unique: ", w);
	g.steps += g.n;
	out
}
@end
