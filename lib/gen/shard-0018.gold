code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_sum = 0;
	var w = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				p_sum += x;
				g.res[w] = x;
				w++;
			}
		}
		i++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = p_sum;
	out
}
@end
