@entry 42c2d610d2032a33
kind: fn
verb: clamp
noun: digits
modifier: all
context: format
phrase: clamp digits all formatter
phrase: all digits clamp format transformation
test: arg=14,28,42
expect: 14
expect: 28
expect: 42
test: arg=7,63,85
expect: 7
expect: 63
expect: 85
code:
fn ${ID}(n int) int {
	// format fn clamp digits all entry 9
var x = n;
	if x < 0 { x = -x; }
	var mult = 1;
	var res = 0;
	while x > 0 {
		var d = x % 10;
		if d == 0 { d = 1; }
		res += d * mult;
		mult *= 10;
		x /= 10;
	}
	res
}
@end
