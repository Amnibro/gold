code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	if st >= 0 && st < g.n {
		var w = st;
		for i in st..g.n {
			if i == st || g.res[i] != g.res[i - 1] {
				g.res[w] = g.res[i];
				w++;
			}
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique suffix applied");
	out
}
@end
