fn ${ID}_sum_digits(n int) int {
	var x = if n < 0 { -n } else { n };
	var s = 0;
	while x > 0 {
		s += x % 10;
		x /= 10;
	}
	s
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${ID}_sum_digits(g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected digit sums");
	out
}
