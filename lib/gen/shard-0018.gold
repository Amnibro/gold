@entry 3702032b2e557edf
kind: step
verb: merge
noun: head
modifier: up_to
context: list
phrase: merge head up to index {idx} in list
phrase: list merge head up to cutoff {idx}
slot: idx int
test: list=1,2,3,4,5 idx=3
expect: => i=6 r=0.0 ok=true s="merged head up to: 6" errors=0 n=3 res=[6,4,5] cache=0 hits=0
test: list=10,20,30 idx=2
expect: => i=30 r=0.0 ok=true s="merged head up to: 30" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cut = ${idx};
	if cut > g.n { cut = g.n; }
	if cut > 0 {
		var sum = 0;
		for k in cut { sum += g.res[k]; }
		g.res[0] = sum;
		var i = 1;
		while i + cut - 1 < g.n {
			g.res[i] = g.res[i + cut - 1];
			i++;
		}
		g.n = g.n - cut + 1;
		out.i = sum;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "merged head up to: ", out.i);
	out
}
@end
