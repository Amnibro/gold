expect: => i=2 r=0.0 ok=true s="validated history every other: 2" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var ok = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < mv { ok = false; break; }
		i += 2;
	}
	if !ok {
		gold_fail(g, "validate history every other failed");
		out.ok = false;
		return out;
	}
	var m = 0;
	var j = 0;
	while j < g.n {
		if g.res[j] >= mv {
			g.res[m] = g.res[j];
			m++;
		}
		j++;
	}
	g.n = m;
	g.steps += j;
	out.i = m;
	out.s.clear();
	format(out.s, "validated history every other: ", m);
	out
}
@end
