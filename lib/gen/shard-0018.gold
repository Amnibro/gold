fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_diff = 1000000;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			var d = g.res[i] - g.res[i - 1];
			if d < 0 { d = -d; }
			if d < min_diff { min_diff = d; }
			i++;
		}
	} else {
