@entry fd203e43a1f01f03
kind: step
verb: keep
noun: primes
modifier: safely
context: list
phrase: keep primes safely valid numbers in list
phrase: list keep primes safely values
test: list=1,2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="kept primes: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=8,9,10,11,13
expect: => i=2 r=0.0 ok=true s="kept primes: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = false;
		if x >= 2 {
			is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept primes: ", kept);
	out
}
@end
@entry 5af2e168e2796576
kind: step
verb: select
noun: item
modifier: sorted
context: list
phrase: select item sorted rank {k} in list
phrase: list select item sorted order {k}
slot: k int
test: list=5,1,4,2,3 k=1
expect: => i=2 r=0.0 ok=true s="selected rank: 2" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,50,20,40 k=2
expect: => i=40 r=0.0 ok=true s="selected rank: 40" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rank = ${k};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if rank >= 0 && rank < g.n {
		out.i = g.res[rank];
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
		gold_fail(g, "rank out of range");
	}
	g.steps += g.n * g.n;
	out.s.clear();
	format(out.s, "selected rank: ", out.i);
	out
}
@end
@entry 3929d62821515f56
kind: step
verb: retry
noun: sequence
modifier: in_reverse
context: list
phrase: retry sequence in reverse order up to {limit} times
phrase: list retry sequence in reverse attempts {limit}
slot: limit int
test: list=3,2,1 limit=2
expect: => i=1 r=0.0 ok=true s="retry sequence in reverse: 1" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=1,3,2 limit=3
expect: => i=2 r=0.0 ok=true s="retry sequence in reverse: 2" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var attempts = 0;
	var sorted_rev = false;
	while attempts < lim && !sorted_rev {
		attempts++;
		sorted_rev = true;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] < g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted_rev = false;
			}
			i++;
		}
	}
	g.steps += attempts * g.n;
	out.i = attempts;
	out.s.clear();
	format(out.s, "retry sequence in reverse: ", attempts);
	out
}
@end
