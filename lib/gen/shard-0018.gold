@entry b1862a81f3751a8c
kind: step
verb: dedupe
noun: threshold
modifier: sorted
context: filter
slot: thresh int
phrase: dedupe values exceeding threshold {thresh} in sorted order
phrase: filter unique items above threshold {thresh} sorted
test: list=15,20,15,10,30,20 thresh=12
expect: => i=3 r=0.0 ok=true s="deduped sorted threshold count: 3" errors=0 n=3 res=[15,20,30] cache=0 hits=0
test: list=5,8,12,8,25,12 thresh=7
expect: => i=3 r=0.0 ok=true s="deduped sorted threshold count: 3" errors=0 n=3 res=[8,12,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x > th {
			var seen = false;
			var j = 0;
			while j < m {
				if g.res[j] == x { seen = true; }
				j++;
			}
			if !seen {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped sorted threshold count: ", g.n);
	out
}
@end
@entry ca338d72b4c0fa4c
kind: step
verb: trace
noun: tail
modifier: any
context: filter
slot: target int
phrase: trace tail for any match with {target}
phrase: filter tail checking any occurrence of {target}
test: list=1,2,3,4,5,6 target=5
expect: => i=1 r=0.0 ok=true s="traced tail any match: 1" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20,30,40 target=15
expect: => i=0 r=0.0 ok=false s="traced tail any match: 0" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let half = g.n / 2;
	var found = false;
	var m = 0;
	var i = half;
	while i < g.n {
		let x = g.res[i];
		if x == tgt { found = true; }
		g.res[m] = x;
		m++;
		i++;
	}
	g.n = m;
	g.steps += m;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "traced tail any match: ", out.i);
	out
}
@end
@entry ac41cda33a6d66b3
kind: step
verb: search
noun: letters
modifier: nested
context: filter
slot: ch text
phrase: search letters nested matching character {ch}
phrase: filter nested letter occurrences of {ch} in string
test: text="banana" ch="a"
expect: => i=3 r=0.0 ok=true s="nested letters count: 3" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" ch="s"
expect: => i=4 r=0.0 ok=true s="nested letters count: 4" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needle = ${ch};
	var count = 0;
	if needle.len > 0 {
		let c = needle[0];
		for b in out.s {
			if b == c { count++; }
		}
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "nested letters count: ", count);
	out
}
@end
@entry 3f47ff6e480e469e
kind: step
verb: fold
noun: pairs
modifier: at_most
context: filter
slot: cap int
phrase: fold pairs filtering sums at most {cap}
phrase: combine pairs keeping totals at most {cap}
test: list=2,3,5,6,1,4 cap=8
expect: => i=2 r=0.0 ok=true s="folded pairs at most cap: 2" errors=0 n=2 res=[5,5] cache=0 hits=0
test: list=10,12,3,4,8,9 cap=15
expect: => i=1 r=0.0 ok=true s="folded pairs at most cap: 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var m = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s <= limit {
			g.res[m] = s;
			m++;
		}
		i += 2;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "folded pairs at most cap: ", m);
	out
}
@end
