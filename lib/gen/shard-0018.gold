@entry b61880a803525a3b
kind: step
verb: clamp
noun: counter
modifier: pairwise
context: filter
slot: max_gap int
phrase: clamp counter pairwise differences to bound {max_gap}
phrase: filter counter sequence clamping pairwise gaps under {max_gap}
test: list=10,25,12,30 max_gap=8
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise gaps" errors=0 n=4 res=[10,18,12,20] cache=0 hits=0
test: list=5,20,100 max_gap=5
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise gaps" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n <= 1 { return out; }
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let prev = g.res[i - 1];
		let cur = g.res[i];
		if cur - prev > mg {
			g.res[i] = prev + mg;
			clamped++;
		} else if prev - cur > mg {
			g.res[i] = prev - mg;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " pairwise gaps");
	out
}
@end
@entry b2f03d409af307b8
kind: step
verb: dedupe
noun: prefix
modifier: all
context: filter
slot: prefix_len int
phrase: dedupe prefix all elements within length {prefix_len}
phrase: filter results deduping all prefix elements of {prefix_len}
test: list=2,2,3,4,4,5 prefix_len=3
expect: => i=3 r=0.0 ok=true s="deduped prefix all: 3" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=7,8,7,9,9 prefix_len=2
expect: => i=2 r=0.0 ok=true s="deduped prefix all: 2" errors=0 n=2 res=[7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var dup = false;
		var j = 0;
		while j < m {
			if g.res[j] == x { dup = true; break; }
			j++;
		}
		if !dup {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	let plen = ${prefix_len};
	let lim = if m < plen { m } else { plen };
	g.n = if lim > 0 { lim } else { 0 };
	g.steps += m;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped prefix all: ", g.n);
	out
}
@end
@entry 1111f1f3233bf273
kind: step
verb: search
noun: threshold
modifier: running
context: filter
slot: cut int
phrase: search threshold running sum reaching {cut}
phrase: filter entries searching running threshold {cut}
test: list=3,5,2,8,4 cut=10
expect: => i=3 r=0.0 ok=true s="searched running threshold: 3" errors=0 n=3 res=[3,5,2] cache=0 hits=0
test: list=4,6,10,5 cut=15
expect: => i=2 r=0.0 ok=true s="searched running threshold: 2" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cut};
	var m = 0;
	var run = 0;
	var i = 0;
	while i < g.n {
		run += g.res[i];
		if run <= c {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "searched running threshold: ", m);
	out
}
@end
