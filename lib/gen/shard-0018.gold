expect: => i=3 r=0.0 ok=true s="filtered running digits: 3" errors=0 n=3 res=[25,11,41] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var m = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var sum = 0;
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
		if sum <= ms {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "filtered running digits: ", m);
	out
}
@end
