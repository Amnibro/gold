code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if ${p}(g.res[i]) {
			count++;
		} else {
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "trailing condition rank: ", count);
	out
}
@end
