fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, found = gold_cache_get(g, k);
	if found {
		var m = 0;
		var i = 0;
		while i < g.n {
			if g.res[i] >= val {
				g.res[m] = g.res[i];
				m++;
			}
			i++;
		}
		g.n = m;
		out.i = val;
	} else {
		gold_cache_put(g, k, 10);
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "searched cache any: ", out.i);
	out
}
@end
