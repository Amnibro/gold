expect: => i=2 r=0.0 ok=true s="pairs rotated: 2" errors=0 n=4 res=[30,10,40,15] cache=0 hits=0
test: list=20,50,10,25 threshold=55
expect: => i=1 r=0.0 ok=true s="pairs rotated: 1" errors=0 n=4 res=[50,20,10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th < 0 || g.n < 2 { gold_fail(g, "invalid threshold"); out.ok = false; return out; }
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] >= th {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "pairs rotated: ", swaps);
	out
}
@end
