	let ml = ${min_len};
	if g.n >= ml {
		var l = 0;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l++;
			r--;
		}
		out.i = 1;
