test: list=5,40,15 count=1
expect: => i=1 r=0.0 ok=true s="dropped 1 outliers recursively" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var dropped = 0;
	while dropped < c && g.n > 0 {
		var max_idx = 0;
		for i in 1..g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
		}
		for i in max_idx..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
		dropped++;
	}
	g.steps += dropped * g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " outliers recursively");
	out
}
@end
