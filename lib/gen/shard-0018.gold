expect: => i=3 r=0.0 ok=true s="computed run lengths" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=4,4,5,6,6
expect: => i=3 r=0.0 ok=true s="computed run lengths" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		var lens int[512] = [0; 512];
		var m = 0;
		var cur_len = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_len++;
			} else {
				lens[m] = cur_len;
				m++;
				cur_len = 1;
			}
		}
		lens[m] = cur_len;
		m++;
		for k in m {
			g.res[k] = lens[k];
		}
		g.n = m;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed run lengths");
	out
}
@end
