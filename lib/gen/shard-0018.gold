code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${req};
	let n = out.s.len;
	var dcount = 0;
	for b in out.s {
		if b >= '0' && b <= '9' { dcount++; }
	}
	if dcount >= req {
		for i in n {
			if out.s[i] >= '0' && out.s[i] <= '9' {
				for j in (i + 1)..n {
					if out.s[j] >= '0' && out.s[j] <= '9' {
						if out.s[i] > out.s[j] {
							let tmp = out.s[i];
							out.s[i] = out.s[j];
							out.s[j] = tmp;
						}
					}
				}
			}
		}
	}
	g.steps += n;
	out.i = dcount;
	out.ok = (dcount >= req);
	out
}
@end
