test: list=10,2,6,8
expect: => i=26 r=0.0 ok=true s="in place swapped total: 26" errors=0 n=4 res=[10,6,8,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var s = 0;
	for k in g.n { s += g.res[k]; }
	if g.n > 1 {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "in place swapped total: ", s);
	out
}
@end
@entry a543658b28fb7d99
kind: step
verb: retry
noun: suffix
modifier: until
context: sort
slot: ceiling int
phrase: retry shrinking sorted suffix until sum falls under {ceiling}
phrase: shorten sorted suffix until total is below {ceiling}
test: list=6,2,8,4 ceiling=12
expect: => i=8 r=0.0 ok=true s="suffix sum below ceiling: 8" errors=0 n=1 res=[8] cache=0 hits=0
test: list=5,3,9,1 ceiling=10
expect: => i=9 r=0.0 ok=true s="suffix sum below ceiling: 9" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	var start = 0;
	while start < g.n && sum > ceil {
		sum -= g.res[start];
		start++;
	}
	var kept = 0;
	for k in start..g.n {
		g.res[kept] = g.res[k];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "suffix sum below ceiling: ", sum);
	out
}
@end
