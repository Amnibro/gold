context: cache
phrase: trace sequence occurrences at least {min_val}
phrase: record sequence elements at least {min_val} in cache
slot: min_val int
test: list=10,25,10,30,5 min_val=10
expect: => i=3 r=0.0 ok=true s="cached 3 sequence entries" errors=0 n=5 res=[10,25,10,30,5] cache=3 hits=0
test: list=2,4,6 min_val=10
expect: => i=0 r=0.0 ok=true s="cached 0 sequence entries" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: min_val=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_val};
	if g.n == 0 {
		gold_fail(g, "empty sequence");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= limit {
			var seen = false;
			for j in i {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				var freq = 0;
				for k in g.n {
					if g.res[k] == x { freq++; }
				}
				gold_cache_put(g, x, freq);
				count++;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " sequence entries");
	out
}
@end
