fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			if i == 0 || g.res[i] != g.res[i - 1] {
				prime_count++;
			}
		}
	}
	g.steps += g.n;
	out.i = prime_count;
	out.s.clear();
	format(out.s, "unique primes: ", prime_count);
	out
}
@end
