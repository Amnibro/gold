code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mdr_dup_total = 0;
	var mdr_orig int[512] = [0; 512];
	for mdr_k in g.n { mdr_orig[mdr_k] = g.res[mdr_k]; }
	for mdr_i in g.n {
		var mdr_freq = 0;
		for mdr_j in (mdr_i + 1) {
			if mdr_orig[mdr_j] == mdr_orig[mdr_i] { mdr_freq++; }
		}
		if mdr_freq > 1 { mdr_dup_total++; }
		g.res[mdr_i] = mdr_freq;
	}
	g.steps += g.n;
	out.i = mdr_dup_total;
	out.s.clear();
	format(out.s, "running duplicates: ", mdr_dup_total);
	out
}
@end
