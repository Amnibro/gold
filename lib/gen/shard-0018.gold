fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if g.n == 0 || count <= 0 { return out; }
	let actual_k = if count < g.n { count } else { g.n };
	var sum = 0;
	var i = g.n - actual_k;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	out.i = sum / actual_k;
	out.r = (sum as real) / (actual_k as real);
	g.steps += actual_k;
	out
}
@end
