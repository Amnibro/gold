fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var gaps int[512] = [0; 512];
	var gn = g.n - 1;
	var i = 0;
	while i < gn {
		let d = g.res[i + 1] - g.res[i];
		gaps[i] = if d < 0 { -d } else { d };
		i++;
	}
	for idx in gn { g.res[idx] = gaps[idx]; }
	g.n = gn;
	i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
