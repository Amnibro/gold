@entry 28020457bb38e63d
kind: step
verb: dedupe
noun: minimum
modifier: between
context: filter
slot: low int
slot: high int
phrase: dedupe minimum values between {low} and {high}
phrase: filter unique items lying between {low} and {high}
test: list=5,12,15,12,8,15,22 low=10 high=20
expect: => i=2 r=0.0 ok=true s="deduped minimum between: 2" errors=0 n=2 res=[12,15] cache=0 hits=0
test: list=14,25,14,30,25,35 low=12 high=30
expect: => i=3 r=0.0 ok=true s="deduped minimum between: 3" errors=0 n=3 res=[14,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			var j = 0;
			while j < m {
				if g.res[j] == x { seen = true; }
				j++;
			}
			if !seen {
				g.res[m] = x;
				m++;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += m + i;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped minimum between: ", m);
	out
}
@end
@entry 02a853cd3dab0e36
kind: step
verb: repeat
noun: letters
modifier: safely
context: filter
slot: times int
phrase: repeat letters safely {times} times
phrase: duplicate characters safely for {times} rounds
test: text="abc" times=3
expect: => i=9 r=0.0 ok=true s="abcabcabc" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" times=2
expect: => i=10 r=0.0 ok=true s="hellohello" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t > 1 && out.s.len > 0 {
		var orig byte[>..] = [];
		for b in out.s { orig.push(b); }
		out.s.clear();
		var r = 0;
		while r < t {
			for b in orig {
				if out.s.len < 200 { out.s.push(b); }
			}
			r++;
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry 0b13b770f0e5bb99
kind: step
verb: dedupe
noun: histogram
modifier: in_reverse
context: filter
phrase: dedupe histogram in reverse order
phrase: filter duplicate values backwards keeping last seen
test: list=2,3,2,5,3,7
expect: => i=4 r=0.0 ok=true s="deduped in reverse: 4" errors=0 n=4 res=[7,3,5,2] cache=0 hits=0
test: list=10,20,10,30,40,20
expect: => i=4 r=0.0 ok=true s="deduped in reverse: 4" errors=0 n=4 res=[20,40,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp int[512] = [0; 512];
	var tn = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < tn {
			if tmp[j] == x { seen = true; }
			j++;
		}
		if !seen {
			tmp[tn] = x;
			tn++;
		}
		i--;
	}
	for k in tn {
		g.res[k] = tmp[k];
	}
	g.n = tn;
	g.steps += tn + g.n;
	out.i = tn;
	out.s.clear();
	format(out.s, "deduped in reverse: ", tn);
	out
}
@end
