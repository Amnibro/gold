@entry eafcf003d5580a2f
kind: step
verb: rotate
noun: limit
modifier: running
context: math
slot: shift int
slot: limit int
phrase: rotate limit running sum by offset {shift} cap {limit}
phrase: cycle list elements {shift} keeping running sum under {limit}
test: list=10,20,30 shift=1 limit=50
expect: => i=50 r=0.0 ok=true s="" errors=0 n=3 res=[30,10,10] cache=0 hits=0
test: list=5,15,25,35 shift=2 limit=60
expect: => i=60 r=0.0 ok=true s="" errors=0 n=4 res=[25,35,0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	let lim = ${limit};
	if g.n <= 1 { return out; }
	var rot = s % g.n;
	while rot > 0 {
		let last_val = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last_val;
		rot--;
	}
	var run = 0;
	var i = 0;
	while i < g.n {
		run += g.res[i];
		if run > lim {
			g.res[i] = lim - (run - g.res[i]);
			run = lim;
		}
		i++;
	}
	g.steps += g.n;
	out.i = run;
	out
}
@end
