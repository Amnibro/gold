kind: step
verb: dedupe
noun: squares
modifier: none
context: compare
slot: max_val int
phrase: dedupe square comparison values under {max_val}
phrase: remove duplicate square values below {max_val}
test: list=4,9,4,16,25 max_val=20
expect: => i=1 r=0.0 ok=true s="deduped squares: 1" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=1,4,1,9 max_val=10
expect: => i=1 r=0.0 ok=true s="deduped squares: 1" errors=0 n=3 res=[1,4,9] cache=0 hits=0
code:
fn ${ID}_is_square(n int) bool {
	if n < 0 { return false; }
	var r = 0;
	while r * r <= n {
		if r * r == n { return true; }
		r++;
	}
	false
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	if mv < 0 { gold_fail(g, "invalid max_val"); out.ok = false; return out; }
	var w = 0;
	var deduped = 0;
	for i in g.n {
		let x = g.res[i];
		if x < mv && ${ID}_is_square(x) {
			var seen = false;
			for j in w {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen { g.res[w] = x; w++; }
			else { deduped++; }
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += deduped;
	out.i = deduped;
	out.s.clear();
	format(out.s, "deduped squares: ", deduped);
	out
}
@end
