code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	for k in (g.n - 1) {
		g.res[k] = g.res[k] + g.res[k + 1];
	}
	g.n--;
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise filled");
	out
}
@end
