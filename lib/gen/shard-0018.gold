@entry 98bafa77d3f96986
kind: step
verb: sort
noun: tally
modifier: running
context: compare
slot: threshold int
phrase: sort running tally comparisons above {threshold}
phrase: order running tallies exceeding threshold {threshold}
test: list=10,20,5,15 threshold=25
expect: => i=3 r=0.0 ok=true s="running tallies sorted: 3" errors=0 n=4 res=[10,20,5,15] cache=0 hits=0
test: list=5,10,20,30 threshold=30
expect: => i=2 r=0.0 ok=true s="running tallies sorted: 2" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if th < 0 || g.n == 0 { gold_fail(g, "invalid threshold"); out.ok = false; return out; }
	var running = 0;
	var tallies int[64] = [0; 64];
	var tn = 0;
	for i in g.n {
		running += g.res[i];
		if running > th && tn < 64 {
			tallies[tn] = running;
			tn++;
		}
	}
	for i in tn {
		for j in (i + 1)..tn {
			if tallies[i] > tallies[j] {
				let tmp = tallies[i];
				tallies[i] = tallies[j];
			tallies[j] = tmp;
			}
		}
	}
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "running tallies sorted: ", tn);
	out
}
@end
