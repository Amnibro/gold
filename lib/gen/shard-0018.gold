test: list=9,8,7,2,1
expect: => i=2 r=0.0 ok=true s="group_condition_sorted: 2" errors=0 n=5 res=[8,2,9,7,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 64];
	var odds = [0; 64];
	var en = 0;
	var on = 0;
	for i in 0 .. g.n {
		if g.res[i] % 2 == 0 {
			if en < 64 { evens[en] = g.res[i]; en++; }
		} else {
			if on < 64 { odds[on] = g.res[i]; on++; }
		}
	}
	for i in 0 .. en { g.res[i] = evens[i]; }
	for i in 0 .. on { g.res[en + i] = odds[i]; }
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "group_condition_sorted: ", en);
	out
}
@end
@entry dce22cdfbc6d35bf
kind: step
verb: apply
noun: primes
modifier: with_cache
context: aggregate
phrase: apply primes filter with cache
phrase: retain prime numbers using cached lookup
test: list=4,5,6,7,8,9,11
expect: => i=3 r=0.0 ok=true s="apply_primes_with_cache: 3" errors=0 n=3 res=[5,7,11] cache=3 hits=0
test: list=12,13,14,17,19
expect: => i=3 r=0.0 ok=true s="apply_primes_with_cache: 3" errors=0 n=3 res=[13,17,19] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in 0 .. g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, x, 1);
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	g.steps += g.n;
	out.i = write;
	out.s.clear();
	format(out.s, "apply_primes_with_cache: ", write);
	out
}
@end
