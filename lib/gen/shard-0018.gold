fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	if b <= 0 || b > 64 || g.n == 0 { gold_fail(g, "invalid bins"); out.ok = false; return out; }
	var hist int[64] = [0; 64];
	for i in g.n {
		let idx = (g.res[i] / 10) % b;
		if idx >= 0 && idx < b { hist[idx]++; }
	}
	for i in b { g.res[i] = hist[i]; }
	g.n = b;
	g.steps += b;
	out.i = b;
	out.s.clear();
	format(out.s, "histogram bins calculated: ", b);
	out
}
@end
