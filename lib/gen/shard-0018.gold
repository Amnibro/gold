fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for rvc_i in (g.n / 2) {
		let rvc_j = g.n - 1 - rvc_i;
		let rvc_tmp = g.res[rvc_i];
		g.res[rvc_i] = g.res[rvc_j];
		g.res[rvc_j] = rvc_tmp;
	}
	for rvc_k in g.n {
		gold_cache_put(g, rvc_k, g.res[rvc_k]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed with cache: ", g.n);
	out
}
