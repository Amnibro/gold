code:
fn ${ID}(n int) int {
	var tally_n = if n < 1 { 1 } else { n };
	var tally_divs = 0;
	var tally_k = 1;
	while tally_k * tally_k <= tally_n {
		if tally_n % tally_k == 0 {
			tally_divs++;
			if tally_k * tally_k != tally_n { tally_divs++; }
		}
		tally_k++;
	}
	tally_divs * 10
}
@end
