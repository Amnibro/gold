code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var vc = 0;
	var i = 0;
	while i < g.n && i < ml {
		let x = g.res[i];
		let is_v = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 ||
		           x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if is_v { vc++; }
		i++;
	}
	gold_cache_put(g, ml, vc);
	out.i = vc;
	out.s.clear();
	format(out.s, "traced vowels with cache: ", vc);
	out
}
@end
