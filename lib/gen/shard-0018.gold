test: list=2,2,3,4,4,4,5 min_streak=2
expect: => i=5 r=0.0 ok=true s="repeated streak pairwise: 5" errors=0 n=5 res=[2,2,4,4,4] cache=0 hits=0
test: list=1,2,2,2,3,3 min_streak=3
expect: => i=3 r=0.0 ok=true s="repeated streak pairwise: 3" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var j = i;
		while j < g.n && g.res[j] == x { j++; }
		let len = j - i;
		if len >= ms {
			var k = i;
			while k < j {
				g.res[m] = g.res[k];
				m++;
				k++;
			}
		}
		i = j;
	}
	g.n = m;
	g.steps += i;
	out.i = m;
	out.s.clear();
	format(out.s, "repeated streak pairwise: ", m);
	out
}
@end
