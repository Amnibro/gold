code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	var sum = 0;
	while count < g.n && sum + g.res[count] <= c {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "kept total count: ", count);
	out
}
@end
@entry 0857c5f233d927be
kind: step
verb: scan
noun: items
modifier: with_retry
context: list
phrase: scan items with retry seeking {target} attempts {retries}
phrase: list scan items with retry target {target} count {retries}
slot: target int
slot: retries int
test: list=1,2,3 target=2 retries=1
expect: => i=1 r=0.0 ok=true s="found at index: 1" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,5,6 target=9 retries=2
expect: => i=-1 r=0.0 ok=true s="not found after attempts" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	var attempts = 0;
	var found_idx = -1;
	while attempts < r && found_idx < 0 {
		attempts++;
		for k in g.n {
			if g.res[k] == tgt {
				found_idx = k;
				break;
			}
		}
	}
	g.steps += attempts * g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found at index: ", found_idx);
	} else {
		format(out.s, "not found after attempts");
	}
	out
}
@end
