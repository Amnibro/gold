code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let depth = ${layers};
	var res = 0;
	for l in depth {
		for i in g.n {
			let k = (g.res[i] + l) % 100;
			gold_cache_put(g, k, i + 1);
			res += k;
		}
	}
	out.i = res;
	out.s.clear();
	format(out.s, "nested value traced ", res);
	out
}
@end
