kind: step
verb: reverse
noun: tally
modifier: first
context: sort
phrase: reverse sorted list tallying first element frequency
phrase: invert sorted sequence counting occurrences of first value
test: list=2,5,2,8
expect: => i=2 r=0.0 ok=true s="tally of first sorted element: 2" errors=0 n=4 res=[8,5,2,2] cache=0 hits=0
test: list=3,3,3,7
expect: => i=3 r=0.0 ok=true s="tally of first sorted element: 3" errors=0 n=4 res=[7,3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var freq = 0;
	if g.n > 0 {
		let target = g.res[0];
		for k in g.n {
			if g.res[k] == target { freq++; }
		}
	}
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	g.steps += g.n;
	out.i = freq;
	out.s.clear();
	format(out.s, "tally of first sorted element: ", freq);
	out
}
@end
