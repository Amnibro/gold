fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupes = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				dupes++;
				break;
			}
			j++;
