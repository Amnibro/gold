test: list=7,2,5,4 limit=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[2,4,5,7] cache=0 hits=0
test: list=13,3,11,5 limit=12
expect: => i=3 r=0.0 ok=true s="" errors=0 n=4 res=[3,5,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var primes = 0;
	i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 && x <= lim {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
		i++;
	}
	g.steps += g.n;
	out.i = primes;
	out
}
@end
