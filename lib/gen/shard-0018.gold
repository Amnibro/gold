	let n = out.s.len;
	var kept byte[>..] = [];
	var i = 0;
	while i + 1 < n {
		let c1 = out.s[i];
		let c2 = out.s[i + 1];
		var diff = (c1 as int) - (c2 as int);
		if diff < 0 { diff = -diff; }
		if diff >= d {
			kept.push(c1);
			kept.push(c2);
		}
		i += 2;
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	g.steps += n;
	out.i = kept.len;
	out
}
@end
