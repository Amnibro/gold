fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 {
		for k in g.n { gold_cache_put(g, k, g.res[k]); }
	}
	if g.cn > 0 {
		for k in (g.cn - 1) {
			g.ck[k] = g.ck[k + 1];
			g.cv[k] = g.cv[k + 1];
		}
		g.cn--;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "dropped cache");
	out
}
@end
