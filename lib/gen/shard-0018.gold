code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pos = ${idx};
	let def_val = ${fallback};
	if pos >= 0 && pos < g.n {
		out.i = g.res[pos];
		out.ok = true;
	} else {
		out.i = def_val;
		out.ok = false;
		gold_fail(g, "index out of bounds");
	}
	g.steps++;
	out.s.clear();
	format(out.s, "selected: ", out.i);
	out
}
@end
