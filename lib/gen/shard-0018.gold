fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var kept = 0;
	var i = 0;
	while i < g.n && kept < c {
		let code = g.res[i];
		let is_upper = code >= 65 && code <= 90;
		let is_lower = code >= 97 && code <= 122;
		if is_upper || is_lower {
			g.res[kept] = code;
			kept++;
		}
		i++;
	}
	g.steps += i;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected first ", kept, " categorical letter codes");
	out
}
@end
@entry 7178ef7f090b0fac
kind: step
verb: group
noun: results
modifier: at_most
context: stats
phrase: group results into at most {max_groups} aggregate buckets
phrase: partition sample results into at most {max_groups} groups
slot: max_groups int
test: list=10,20,30,40 max_groups=2
expect: => i=2 r=0.0 ok=true s="grouped results into 2 aggregate buckets" errors=0 n=2 res=[30,70] cache=0 hits=0
test: list=5,10,15,20,25,30 max_groups=3
expect: => i=3 r=0.0 ok=true s="grouped results into 3 aggregate buckets" errors=0 n=3 res=[15,35,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_groups};
	if mg <= 0 || g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "cannot group results");
		return out;
	}
	let chunk = (g.n + mg - 1) / mg;
	var num_groups = 0;
	var i = 0;
	while i < g.n {
		var s = 0;
		var j = 0;
		while j < chunk && i + j < g.n {
			s += g.res[i + j];
			j++;
		}
		g.res[num_groups] = s;
		num_groups++;
		i += chunk;
	}
	g.n = num_groups;
	g.steps += g.n;
	out.i = num_groups;
	out.s.clear();
	format(out.s, "grouped results into ", num_groups, " aggregate buckets");
	out
}
@end
