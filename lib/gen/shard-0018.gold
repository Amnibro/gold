fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if f <= 0 || g.n < 2 { gold_fail(g, "invalid factor"); out.ok = false; return out; }
	var dups = 0;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] == g.res[j] { dups++; }
		}
	}
	let scaled = dups * f;
	gold_push(g, scaled);
	g.steps += dups;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled nested duplicates: ", scaled);
	out
}
@end
