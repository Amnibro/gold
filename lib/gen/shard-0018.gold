@entry 978a10eba34e3833
kind: step
verb: select
noun: squares
modifier: with_cache
context: list
phrase: select squares with cache lookups in list
phrase: list select squares with cache memorized
test: list=4,5,9,16,20
expect: => i=3 r=0.0 ok=true s="cached squares selected: 3" errors=0 n=3 res=[4,9,16] cache=5 hits=0
test: list=1,2,3,4,25
expect: => i=3 r=0.0 ok=true s="cached squares selected: 3" errors=0 n=3 res=[1,4,25] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		var is_sq = 0;
		let cached, found = gold_cache_get(g, x);
		if found {
			is_sq = cached;
		} else {
			if x >= 0 {
				var r = 0;
				while r * r < x { r++; }
				if r * r == x { is_sq = 1; }
			}
			gold_cache_put(g, x, is_sq);
		}
		if is_sq == 1 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached squares selected: ", kept);
	out
}
@end
@entry 4bff9d25e2e40e78
kind: step
verb: retry
noun: limit
modifier: sorted
context: list
phrase: retry limit sorted passes {retries} in list
phrase: list retry limit sorted attempts {retries}
slot: retries int
test: list=3,1,4,2 retries=5
expect: => i=3 r=0.0 ok=true s="sorted passes: 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,4,3 retries=2
expect: => i=2 r=0.0 ok=true s="sorted passes: 2" errors=0 n=3 res=[3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_limit = ${retries};
	var pass = 0;
	var sorted = false;
	while pass < r_limit && !sorted {
		pass++;
		sorted = true;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
			i++;
		}
	}
	g.steps += pass * g.n;
	out.i = pass;
	out.s.clear();
	format(out.s, "sorted passes: ", pass);
	out
}
@end
