fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n > 1 && k > 0 {
		let shift = k % g.n;
		var temp int[512] = [0; 512];
		for i in g.n {
			temp[(i + shift) % g.n] = g.res[i];
		}
		for i in g.n {
			g.res[i] = temp[i];
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated elements");
	out
}
@end
