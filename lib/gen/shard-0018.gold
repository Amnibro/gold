phrase: verify nested series step differences under {delta}
test: list=10,12,15 delta=6
expect: => i=1 r=0.0 ok=true s="nested series valid: true" errors=0 n=3 res=[10,12,15] cache=0 hits=0
test: list=5,8,14 delta=10
expect: => i=1 r=0.0 ok=true s="nested series valid: true" errors=0 n=3 res=[5,8,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if d < 0 || g.n < 2 { gold_fail(g, "invalid delta"); out.ok = false; return out; }
	var valid = true;
	for i in g.n {
		for j in (i + 1)..g.n {
			let diff = g.res[j] - g.res[i];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff > d { valid = false; break; }
		}
		if !valid { break; }
	}
	g.steps += g.n;
	out.i = if valid { 1 } else { 0 };
	out.ok = valid;
	out.s.clear();
	format(out.s, "nested series valid: ", valid);
	out
}
@end
