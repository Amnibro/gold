@entry 941045fcadba837e
kind: step
verb: rotate
noun: steps
modifier: first
context: filter
slot: k int
phrase: rotate steps first shifting head by {k}
phrase: filter array rotating first steps by {k}
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="rotated steps first: 2" errors=0 n=5 res=[30,40,50,10,20] cache=0 hits=0
test: list=1,2,3,4 k=1
expect: => i=1 r=0.0 ok=true s="rotated steps first: 1" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = if ${k} > 0 { ${k} } else { 0 };
	if g.n > 1 && cnt > 0 {
		let shift = cnt % g.n;
		var i = 0;
		while i < shift {
			let first = g.res[0];
			var j = 0;
			while j < g.n - 1 {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.res[g.n - 1] = first;
			i++;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "rotated steps first: ", cnt);
	out
}
@end
