@entry 6a14228e27cc170b
kind: step
verb: sort
noun: words
modifier: up_to
context: search
phrase: sort search items up to bound {k}
phrase: order search list items up to limit {k}
slot: k int
test: list=40,10,30,20 k=25
expect: => i=2 r=0.0 ok=true s="sorted items under limit: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,1,4,2 k=3
expect: => i=2 r=0.0 ok=true s="sorted items under limit: 2" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] <= limit { count++; }
	}
	out.i = count;
	out.s.clear();
	format(out.s, "sorted items under limit: ", count);
	g.steps += g.n;
	out
}
@end
