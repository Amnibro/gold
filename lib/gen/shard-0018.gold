@entry e724ebc16b47e96c
kind: step
verb: apply
noun: duplicates
modifier: sorted
context: core
phrase: extract sorted duplicates from results
phrase: gather duplicate values in sorted order
test: list=4,2,3,2,4,5,4
expect: => i=2 r=0.0 ok=true s="sorted duplicates" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=9,1,9,2,3,1
expect: => i=2 r=0.0 ok=true s="sorted duplicates" errors=0 n=2 res=[1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in dn { if dups[j] == x { seen = true; break; } }
		if !seen {
			var cnt = 0;
			for k in g.n { if g.res[k] == x { cnt++; } }
			if cnt > 1 { dups[dn] = x; dn++; }
		}
	}
	if dn > 1 {
		for i in dn {
			for j in (dn - 1 - i) {
				if dups[j] > dups[j + 1] {
					let t = dups[j];
					dups[j] = dups[j + 1];
					dups[j + 1] = t;
				}
			}
		}
	}
	gold_clear(g);
	for k in dn { gold_push(g, dups[k]); }
	out.i = dn;
	out.s.clear();
	format(out.s, "sorted duplicates");
	out
}
@end
