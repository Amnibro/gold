@entry 76dd88c251109bf2
kind: step
verb: swap
noun: budget
modifier: safely
context: sort
slot: limit int
phrase: swap sorted items safely under cost budget {limit}
phrase: exchange sorted pair safely within budget {limit}
test: list=6,2,9 limit=10
expect: => i=8 r=0.0 ok=true s="safely swapped within budget: 8" errors=0 n=3 res=[6,2,9] cache=0 hits=0
test: list=8,5,12 limit=10
expect: => i=13 r=0.0 ok=false s="budget exceeded limit: 10" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n >= 2 {
		let cost = g.res[0] + g.res[1];
		out.i = cost;
		if cost <= lim {
			let tmp = g.res[0];
			g.res[0] = g.res[1];
			g.res[1] = tmp;
			out.ok = true;
			out.s.clear();
			format(out.s, "safely swapped within budget: ", cost);
		} else {
			out.ok = false;
			out.s.clear();
			format(out.s, "budget exceeded limit: ", lim);
		}
	} else {
		out.ok = true;
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
