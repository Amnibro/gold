@entry 9c8c3c6789317136
kind: step
verb: swap
noun: average
modifier: in_place
context: core
phrase: swap elements around average in place
phrase: reorder entries relative to average in place
test: list=10,90,20,80
expect: => i=50 r=0.0 ok=true s="average swapped: 50" errors=0 n=4 res=[10,20,90,80] cache=0 hits=0
test: list=5,15,25,35
expect: => i=20 r=0.0 ok=true s="average swapped: 20" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sai_sum = 0;
	for sai_k in g.n { sai_sum += g.res[sai_k]; }
	let sai_avg = sai_sum / g.n;
	var sai_l = 0;
	var sai_r = g.n - 1;
	while sai_l < sai_r {
		while sai_l < sai_r && g.res[sai_l] <= sai_avg { sai_l++; }
		while sai_l < sai_r && g.res[sai_r] > sai_avg { sai_r--; }
		if sai_l < sai_r {
			let sai_t = g.res[sai_l];
			g.res[sai_l] = g.res[sai_r];
			g.res[sai_r] = sai_t;
			sai_l++;
			sai_r--;
		}
	}
	g.steps += g.n;
	out.i = sai_avg;
	out.s.clear();
	format(out.s, "average swapped: ", sai_avg);
	out
}
@end
@entry d9e1aeb3af8bed07
kind: step
verb: swap
noun: threshold
modifier: at_least
context: core
phrase: swap values meeting threshold at least {thresh}
phrase: interchange values exceeding threshold bound {thresh}
slot: thresh int
test: list=2,15,4,25,3 thresh=10
expect: => i=25 r=0.0 ok=true s="swapped threshold: 25" errors=0 n=5 res=[2,25,4,15,3] cache=0 hits=0
test: list=5,8,9 thresh=20
expect: => i=0 r=0.0 ok=false s="swapped threshold: 0" errors=0 n=3 res=[5,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sta_th = ${thresh};
	var sta_first = -1;
	var sta_last = -1;
	for sta_i in g.n {
		if g.res[sta_i] >= sta_th {
			if sta_first < 0 { sta_first = sta_i; }
			sta_last = sta_i;
		}
	}
	if sta_first >= 0 && sta_last >= 0 && sta_first != sta_last {
		let sta_t = g.res[sta_first];
		g.res[sta_first] = g.res[sta_last];
		g.res[sta_last] = sta_t;
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if sta_first >= 0 { g.res[sta_first] } else { 0 };
	out.s.clear();
	format(out.s, "swapped threshold: ", out.i);
	out
}
@end
