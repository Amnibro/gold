test: list=5,15,25 t=3
expect: => i=3 r=0.0 ok=true s="cache rank score: 3" errors=0 n=3 res=[5,15,25] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let multiplier = ${t};
	if g.n > 0 {
		gold_cache_put(g, 1, g.res[0]);
		gold_cache_get(g, 1);
	}
	let score = g.hits * multiplier;
	out.i = score;
	out.s.clear();
	format(out.s, "cache rank score: ", score);
	g.steps += 1;
	out
}
@end
