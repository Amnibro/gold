fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			g.res[k] = ${x}(g.res[k]);
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped reverse sorted evens: ", count);
	out
}
@end
