@entry 94b1c2d065aeabd8
kind: step
verb: dedupe
noun: item
modifier: in_reverse
context: text
phrase: dedupe text characters scanning in_reverse
phrase: remove later duplicate characters in_reverse
test: text="banana"
expect: => i=3 r=0.0 ok=true s="bna" errors=0 n=0 res=[] cache=0 hits=0
test: text="abracadabra"
expect: => i=5 r=0.0 ok=true s="cdbra" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	var rev byte[>..] = [];
	var i = n - 1;
	while i >= 0 {
		let c = out.s[i];
		var seen = false;
		for b in rev {
			if b == c { seen = true; break; }
		}
		if !seen { rev.push(c); }
		i--;
	}
	out.s.clear();
	var j = rev.len - 1;
	while j >= 0 {
		out.s.push(rev[j]);
		j--;
	}
	g.steps += n;
	out.i = out.s.len;
	out
}
@end
