test: list=2,5,5,8,8,1 min_val=5
expect: => i=4 r=0.0 ok=true s="deduped at least count: 4" errors=0 n=4 res=[2,5,8,1] cache=0 hits=0
test: list=3,10,10,12,3 min_val=8
expect: => i=4 r=0.0 ok=true s="deduped at least count: 4" errors=0 n=4 res=[3,10,12,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${min_val};
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		var dup = false;
		if x >= min_v {
			for j in m {
				if g.res[j] == x { dup = true; break; }
			}
		}
		if !dup {
			g.res[m] = x;
			m++;
		}
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped at least count: ", m);
	out
}
@end
