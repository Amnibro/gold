phrase: aggregate step sum up to ceiling
phrase: accumulate step progression up to bound
test: arg=10,20
expect: 55
expect: 210
test: arg=5
expect: 15
code:
fn ${ID}(n int) int {
	var step_limit = if n < 0 { -n } else { n };
	var step_acc = 0;
	var step_idx = 1;
	while step_idx <= step_limit && step_idx <= 50 {
		step_acc += step_idx;
