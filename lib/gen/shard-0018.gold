code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let exp_tot = ${expected};
	var alt_sum = 0;
	var idx = 0;
	while idx < g.n {
		alt_sum += g.res[idx];
		idx += 2;
	}
	let ok = alt_sum == exp_tot;
	gold_cache_put(g, 0, alt_sum);
	out.ok = ok;
	out.i = alt_sum;
	out.s.clear();
	format(out.s, "alternate total ", alt_sum, " match ", ok);
	out
}
@end
@entry 495b6256d651f099
kind: step
verb: filter
noun: streak
modifier: with_retry
context: cache
phrase: filter streak with retry limit {retries}
phrase: retain consecutive streak entries allowing {retries} retries
slot: retries int
test: list=2,4,6,7,8 retries=1
expect: => i=4 r=0.0 ok=true s="streak length 4" errors=0 n=5 res=[2,4,6,7,8] cache=4 hits=0
test: list=1,3,5,6 retries=2
expect: => i=0 r=0.0 ok=true s="streak length 0" errors=0 n=4 res=[1,3,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var streak = 0;
	var retries_left = max_r;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			streak++;
			gold_cache_put(g, i, streak);
		} else if retries_left > 0 {
			retries_left--;
		} else { break; }
	}
	out.i = streak;
	out.s.clear();
	format(out.s, "streak length ", streak);
	out
}
@end
