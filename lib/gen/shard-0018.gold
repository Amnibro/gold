fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mul};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var count = 0;
	for k in g.n {
		if core_is_square(g.res[k]) {
			g.res[k] = g.res[k] * m;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled sorted squares count: ", count);
	out
}
@end
