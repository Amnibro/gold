expect: => i=1 r=0.0 ok=true s="duplicates zeroed: 1" errors=0 n=4 res=[5,0,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	var modified = 0;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] && g.res[i] >= low && g.res[i] <= high {
				g.res[i] = 0;
				modified++;
			}
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "duplicates zeroed: ", modified);
	out
}
@end
