expect: => i=2 r=0.0 ok=true s="middle unique items 2" errors=0 n=5 res=[10,20,30,20,10] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_count = 0;
	if g.n >= 3 {
		let mid = g.n / 2;
		for i in (mid - 1)..(mid + 2) {
			let x = g.res[i];
			var seen = false;
			for j in (mid - 1)..i { if g.res[j] == x { seen = true; break; } }
			if !seen {
				gold_cache_put(g, u_count, x);
				u_count++;
			}
		}
	}
	out.i = u_count;
	out.s.clear();
	format(out.s, "middle unique items ", u_count);
	out
}
@end
