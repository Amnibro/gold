fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	for i in g.n {
		if rem >= g.res[i] {
			rem -= g.res[i];
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = rem;
	out.s.clear();
	format(out.s, "remaining budget: ", rem);
