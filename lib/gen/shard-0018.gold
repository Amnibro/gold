test: list=12,34,56,78 lo=5 hi=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[12,34,56,78] cache=0 hits=0
test: list=19,23,45,99 lo=4 hi=8
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[19,23,45,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var matches = 0;
	var i = 0;
	while i < g.n {
		var num = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var dsum = 0;
		while num > 0 {
			dsum += num % 10;
			num /= 10;
		}
		if dsum >= low && dsum <= high {
			matches++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = matches;
	out
}
@end
