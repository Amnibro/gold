test: list=1,2,3,2,4,5
expect: => i=4 r=0.0 ok=true s="unique suffix length: 4" errors=0 n=6 res=[1,2,3,2,4,5] cache=0 hits=0
test: list=1,1,2,3
expect: => i=3 r=0.0 ok=true s="unique suffix length: 3" errors=0 n=4 res=[1,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var len_u = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var seen = false;
		var j = i + 1;
		while j < g.n {
			if g.res[j] == val { seen = true; break; }
			j++;
		}
		if seen { break; }
		len_u++;
		i--;
	}
	g.steps += g.n;
	out.i = len_u;
	out.s.clear();
	format(out.s, "unique suffix length: ", len_u);
	out
}
@end
