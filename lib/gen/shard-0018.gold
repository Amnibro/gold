fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for k in 0 .. pairs {
		let d = g.res[k * 2 + 1] - g.res[k * 2];
		g.res[k * 2] = d;
		g.res[k * 2 + 1] = d;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "normalize_counter_pairwise: ", pairs);
	out
}
@end
