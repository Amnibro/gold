expect: => i=2 r=0.0 ok=true s="deduped history elements: 2" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[w] = x;
			w++;
		}
	}
	let dropped = g.n - w;
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped history elements: ", dropped);
	g.steps += g.n;
	out
}
@end
