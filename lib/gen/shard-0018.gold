	let thresh = ${threshold};
	if g.n < sz || sz <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "window larger than sample size");
		return out;
	}
	var max_range = 0;
	let windows = g.n - sz + 1;
	for i in windows {
		var w_min = g.res[i];
		var w_max = g.res[i];
		for j in 1..sz {
			let val = g.res[i + j];
			if val < w_min { w_min = val; }
			if val > w_max { w_max = val; }
		}
		let r = w_max - w_min;
		if r > max_range { max_range = r; }
	}
	let found = max_range > thresh;
	g.steps += windows * sz;
	out.i = max_range;
	out.ok = found;
	out.s.clear();
	format(out.s, "window maximum range ", max_range, " exceeds threshold: ", found);
	out
}
@end
