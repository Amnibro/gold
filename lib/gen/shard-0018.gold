@entry d16949f0924ce87d
kind: step
verb: merge
noun: step
modifier: sorted
context: list
phrase: merge step sorted pairs in list
phrase: list merge step sorted neighbors
test: list=1,2,5,3
expect: => i=3 r=0.0 ok=true s="merged sorted steps: 3" errors=0 n=3 res=[3,5,3] cache=0 hits=0
test: list=4,5,2,3
expect: => i=2 r=0.0 ok=true s="merged sorted steps: 2" errors=0 n=2 res=[9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] <= g.res[i + 1] {
			g.res[kept] = g.res[i] + g.res[i + 1];
			kept++;
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged sorted steps: ", kept);
	out
}
@end
