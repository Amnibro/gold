@entry 1da8fc886d164663
kind: step
verb: normalize
noun: runs
modifier: last
context: stats
phrase: normalize last repeated run with divisor {divisor}
phrase: scale trailing identical sample run using {divisor}
slot: divisor int
test: list=1,2,20,20,20 divisor=10
expect: => i=3 r=0.0 ok=true s="normalized last run of length 3" errors=0 n=5 res=[1,2,2,2,2] cache=0 hits=0
test: list=5,12,12 divisor=4
expect: => i=2 r=0.0 ok=true s="normalized last run of length 2" errors=0 n=3 res=[5,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${divisor};
	if d == 0 {
		gold_fail(g, "divisor cannot be zero");
		out.ok = false;
		return out;
	}
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty sequence for normalize runs");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var start = g.n - 1;
	while start > 0 && g.res[start - 1] == last_val {
		start--;
	}
	let run_len = g.n - start;
	for i in start..g.n {
		g.res[i] /= d;
	}
	g.steps += run_len;
	out.i = run_len;
	out.s.clear();
	format(out.s, "normalized last run of length ", run_len);
	out
}
@end
@entry d800739720aebaf0
kind: step
verb: drop
noun: streak
modifier: up_to
context: stats
phrase: drop short streaks up to length {max_len}
phrase: filter sample streaks up to bound {max_len}
slot: max_len int
test: list=1,1,2,3,3,3 max_len=2
expect: => i=3 r=0.0 ok=true s="kept 3 samples dropping short streaks" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=5,5,5,5,8 max_len=1
expect: => i=4 r=0.0 ok=true s="kept 4 samples dropping short streaks" errors=0 n=4 res=[5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len > ml {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " samples dropping short streaks");
	out
}
@end
