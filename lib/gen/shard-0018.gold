test: list=10,-5,30,40
expect: => i=10 r=0.0 ok=false s="sequence swapped: 10" errors=0 n=4 res=[10,-5,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.ok = false;
		return out;
	}
	var ssn_has_neg = false;
	for ssn_i in g.n {
		if g.res[ssn_i] < 0 { ssn_has_neg = true; }
	}
	if !ssn_has_neg {
		let ssn_t = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = ssn_t;
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sequence swapped: ", out.i);
	out
}
@end
