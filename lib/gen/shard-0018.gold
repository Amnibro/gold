	if g.n > 1 {
		let diff = g.res[1] - g.res[0];
		if diff > max_gap {
			g.res[1] = g.res[0] + max_gap;
		}
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "first gap clamped to: ", max_gap);
	g.steps += g.n;
	out
}
@end
