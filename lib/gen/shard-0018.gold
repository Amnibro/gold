@entry c82eedae60debee8
kind: step
verb: return
noun: budget
modifier: last
context: filter
slot: budget int
phrase: return budget last elements within {budget}
phrase: filter sequence returning last items within budget {budget}
test: list=5,10,15,20 budget=35
expect: => i=2 r=0.0 ok=true s="returned budget last: 2" errors=0 n=2 res=[15,20] cache=0 hits=0
test: list=2,4,6,8 budget=10
expect: => i=1 r=0.0 ok=true s="returned budget last: 1" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var m = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		if x <= rem {
			rem -= x;
			m++;
		} else {
			break;
		}
		i--;
	}
	let start = g.n - m;
	var k = 0;
	var j = start;
	while j < g.n {
		g.res[k] = g.res[j];
		k++;
		j++;
	}
	g.n = k;
	g.steps += g.n + k;
	out.i = k;
	out.s.clear();
	format(out.s, "returned budget last: ", k);
	out
}
@end
