expect: => i=2 r=0.0 ok=true s="longest streak with retry is 2" errors=0 n=4 res=[10,5,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no samples for streak");
		return out;
	}
	var best = 1;
	var cur = 1;
	for k in 1..g.n {
		if g.res[k] >= g.res[k - 1] - tol {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
	}
	g.steps += g.n;
	out.i = best;
	out.s.clear();
	format(out.s, "longest streak with retry is ", best);
	out
}
@end
@entry 0e538d6043f53d2d
kind: fn
