code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] == g.res[i] { dups++; break; }
			j++;
		}
		i++;
	}
	if dups > 0 && g.n > 1 {
		let first = g.res[0];
		var k = 0;
		while k + 1 < g.n {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.res[g.n - 1] = first;
		gold_fail(g, "duplicate values rotated");
	}
	g.steps += g.n;
	out.i = dups;
	out
}
@end
