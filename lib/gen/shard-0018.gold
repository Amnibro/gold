phrase: sort unique word tokens alphabetically
phrase: alphabetize distinct word tokens from text
test: text="cat bat ant cat"
expect: => i=3 r=0.0 ok=true s="bat cat ant" errors=0 n=0 res=[] cache=0 hits=0
