fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq int[512] = [0; 512];
	var non int[512] = [0; 512];
	var sn = 0;
	var nn = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_square(x) {
			sq[sn] = x;
			sn++;
		} else {
			non[nn] = x;
			nn++;
		}
	}
	gold_clear(g);
	for k in sn { gold_push(g, sq[k]); }
	for k in nn { gold_push(g, non[k]); }
	out.i = sn;
	out.s.clear();
	format(out.s, "grouped squares");
	out
}
@end
@entry 1e081ccaa8fb513a
kind: step
verb: shift
noun: numbers
modifier: recursively
context: core
phrase: shift numbers recursively left by {k}
phrase: rotate number list left {k} positions
slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="shifted recursively" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
test: list=10,20,30 k=1
expect: => i=1 r=0.0 ok=true s="shifted recursively" errors=0 n=3 res=[20,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 || ${k} <= 0 {
		out.i = 0;
		return out;
	}
	let shift_amt = ${k} % g.n;
	var tmp int[512] = [0; 512];
	for i in g.n {
		tmp[i] = g.res[(i + shift_amt) % g.n];
	}
	for i in g.n {
		g.res[i] = tmp[i];
	}
	out.i = shift_amt;
	out.s.clear();
	format(out.s, "shifted recursively");
	out
}
@end
