code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i > 0 {
		let last_digit = out.i % 10;
		var temp = out.i / 10;
		var mul = 1;
		while temp > 0 {
			mul *= 10;
			temp /= 10;
		}
		out.i = (out.i / 10) + last_digit * mul;
	}
	g.steps += 1;
	out
}
@end
@entry 3e81e557cd764f7a
kind: step
verb: return
noun: average
modifier: with_cache
context: math
phrase: return average of results using cache storage
phrase: retrieve cached average or store computed mean
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25,35
expect: => i=20 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,25,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let cached, ok = gold_cache_get(g, g.n);
	if ok {
		out.i = cached;
		return out;
	}
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / g.n;
	gold_cache_put(g, g.n, avg);
	g.steps += g.n;
	out.i = avg;
	out
}
@end
@entry 9c115e31c572c25f
kind: step
verb: fold
noun: primes
modifier: at_most
context: math
slot: max_val int
phrase: fold primes at most upper limit {max_val}
phrase: product of prime items at most ceiling {max_val}
test: list=2,3,5,11 max_val=5
expect: => i=30 r=0.0 ok=true s="" errors=0 n=4 res=[2,3,5,11] cache=0 hits=0
test: list=3,7,13,2 max_val=8
expect: => i=42 r=0.0 ok=true s="" errors=0 n=4 res=[3,7,13,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var prod = 1;
	var found = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 && x <= mv {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prod *= x; found++; }
		}
		i++;
	}
	g.steps += g.n;
	out.i = if found > 0 { prod } else { 0 };
	out
}
@end
