slot: high int
test: list=1,2,10,20,30 low=15 high=35
expect: => i=2 r=0.0 ok=true s="tail count between: 2" errors=0 n=5 res=[1,2,10,20,30] cache=0 hits=0
test: list=5,6,7,8 low=10 high=20
expect: => i=0 r=0.0 ok=true s="tail count between: 0" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ctb_lo = ${low};
	let ctb_hi = ${high};
	let ctb_start = g.n / 2;
	var ctb_count = 0;
	for ctb_i in ctb_start..g.n {
		if g.res[ctb_i] >= ctb_lo && g.res[ctb_i] <= ctb_hi {
			ctb_count++;
		}
	}
	g.steps += (g.n - ctb_start);
	out.i = ctb_count;
	out.s.clear();
	format(out.s, "tail count between: ", ctb_count);
	out
}
@end
