code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped pairs: ", swaps);
	out
}
@end
@entry 440058544f74311a
kind: step
verb: merge
noun: runs
modifier: sorted
context: list
phrase: merge runs sorted sequences in list
phrase: list merge runs sorted segments
test: list=1,3,2,4,5
expect: => i=2 r=0.0 ok=true s="merged sorted runs: 2" errors=0 n=2 res=[4,11] cache=0 hits=0
test: list=5,4,3,2,1
expect: => i=5 r=0.0 ok=true s="merged sorted runs: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var run_sum = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] >= g.res[j - 1] {
			run_sum += g.res[j];
			j++;
		}
		g.res[kept] = run_sum;
		kept++;
		i = j;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged sorted runs: ", kept);
	out
}
@end
