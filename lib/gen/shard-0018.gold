fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let salt = ${salt};
	var h = salt;
	for b in out.s {
		h = (h * 31 + b as int) % 10007;
	}
	gold_cache_put(g, salt, h);
	g.steps += out.s.len;
	out.i = h;
	out.s.clear();
	format(out.s, "cache fold: ", h);
	out
}
@end
