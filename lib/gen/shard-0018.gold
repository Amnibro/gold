fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	var max_streak = 0;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
			if cur_streak >= target { break; }
		} else {
			cur_streak = 1;
		}
	}
	gold_cache_put(g, 0, max_streak);
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max run streak ", max_streak);
	out
}
@end
