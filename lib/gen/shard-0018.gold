expect: => img: 16x16 min=0 max=1 sum8=32770 hash=978787
test: img=32 u=5
expect: => i=1024 r=0.0 ok=true s="sand" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0 max=1 sum8=122968 hash=681009
test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 2) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s_buf_2 = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_buf_2[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_buf_2;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var mn = g.img[0];
	var mx = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn { mn = g.img[k]; } if g.img[k] > mx { mx = g.img[k]; } }
	if mx - mn < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn) / (mx - mn); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
