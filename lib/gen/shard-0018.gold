			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	let spread = if g.n >= 2 { g.res[g.n - 1] - g.res[0] } else { 0 };
	gold_cache_put(g, key, spread);
	g.steps += g.n;
	out.i = spread;
	out.s.clear();
	format(out.s, "cached sorted range spread: ", spread);
	out
}
