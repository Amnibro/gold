@entry 6ed32dd0e389ab56
kind: step
verb: search
noun: digits
modifier: running
context: filter
slot: max_digits int
phrase: search digits running length reaching {max_digits}
phrase: filter sequence searching running digits up to {max_digits}
test: list=5,12,345,6 max_digits=4
expect: => i=4 r=0.0 ok=true s="searched running digits: 4" errors=0 n=3 res=[5,12,6] cache=0 hits=0
test: list=100,20,3 max_digits=5
expect: => i=5 r=0.0 ok=true s="searched running digits: 5" errors=0 n=2 res=[100,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var m = 0;
	var digits = 0;
	var i = 0;
	while i < g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var d = 0;
		if x == 0 { d = 1; }
		else { while x > 0 { d++; x /= 10; } }
		if digits + d <= md {
			digits += d;
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = digits;
	out.s.clear();
	format(out.s, "searched running digits: ", digits);
	out
}
@end
