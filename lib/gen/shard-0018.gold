fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sru_lim = ${max_len};
	var sru_count = 0;
	var sru_i = 0;
	while sru_i < g.n {
		var sru_len = 1;
		while sru_i + 1 < g.n && g.res[sru_i] == g.res[sru_i + 1] {
			sru_len++;
			sru_i++;
		}
		if sru_len <= sru_lim {
			sru_count++;
		}
		sru_i++;
	}
	g.steps += g.n;
	out.i = sru_count;
	out.s.clear();
	format(out.s, "runs scanned: ", sru_count);
	out
}
@end
