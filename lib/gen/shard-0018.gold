phrase: scale sorted element frequency counts safely by factor {factor}
phrase: multiply sorted frequency counts safely by scale factor {factor}
test: list=2,5,2,8 factor=3
expect: => i=6 r=0.0 ok=true s="safely scaled frequency: 6" errors=0 n=4 res=[2,2,5,8] cache=0 hits=0
test: list=4,4,4,9 factor=4
expect: => i=12 r=0.0 ok=true s="safely scaled frequency: 12" errors=0 n=4 res=[4,4,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	if g.n > 0 && f > 0 {
		let target = g.res[0];
		var freq = 0;
		for k in g.n {
			if g.res[k] == target { freq++; }
		}
		out.i = freq * f;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "safely scaled frequency: ", out.i);
	out
}
@end
