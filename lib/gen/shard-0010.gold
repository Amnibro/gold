@entry 630c4addddc19966
kind: step
verb: reverse
noun: squares
modifier: running
context: loop
phrase: reverse squares running cap {cap}
phrase: invert running squares under cap {cap}
slot: cap int
test: list=2,3,4 cap=10
expect: => i=3 r=0.0 ok=true s="reversed running squares count 3" errors=0 n=3 res=[4,9,4] cache=0 hits=0
test: list=1,5,2 cap=20
expect: => i=3 r=0.0 ok=true s="reversed running squares count 3" errors=0 n=3 res=[4,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sq = ${cap};
	for i in g.n {
		let x = g.res[i];
		let sq = x * x;
		if sq <= max_sq { g.res[i] = sq; }
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed running squares count ", g.n);
	out
}
@end
