	while x > 0 && len < 16 {
		digits[len] = x % 10;
		x /= 10;
		len++;
	}
	var max_streak = 1;
	var cur_streak = 1;
	var i = len - 2;
	while i >= 0 {
		if digits[i] > digits[i + 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i--;
	}
	max_streak
}
@end
