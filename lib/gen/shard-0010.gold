	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let idx = g.n - 1 - i;
		if g.res[idx] > 0 {
			temp[kept] = g.res[idx];
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, ${label}, ": kept ", kept);
	out
}
