noun: maximum
modifier: safely
context: transform
phrase: apply maximum safe scale with bound {cap}
phrase: scale list by safe maximum bounded {cap}
slot: cap int
test: list=10,20,50 cap=25
expect: => i=50 r=0.0 ok=true s="scaled by safe maximum cap: 25" errors=0 n=3 res=[3,6,16] cache=0 hits=0
test: list=4,8,16 cap=10
expect: => i=16 r=0.0 ok=true s="scaled by safe maximum cap: 10" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let limit = ${cap};
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	if max_val > limit {
		let factor = max_val / limit + 1;
		for i in g.n {
			g.res[i] /= factor;
		}
	}
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "scaled by safe maximum cap: ", limit);
	out
}
@end
@entry de4d51ef4ed2e6f2
kind: step
verb: scale
noun: gaps
modifier: sorted
context: search
phrase: scale sorted search gaps by factor {factor}
phrase: multiply gaps between sorted keys by {factor}
phrase: expand sorted search intervals with factor {factor}
slot: factor int
test: list=30,10,50,20 factor=2
expect: => i=80 r=0.0 ok=true s="scaled gap total 80" errors=0 n=5 res=[10,20,30,50,80] cache=0 hits=0
test: list=15,5,25 factor=3
expect: => i=60 r=0.0 ok=true s="scaled gap total 60" errors=0 n=4 res=[5,15,25,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var total_scaled_gap = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			let gap = (g.res[k+1] - g.res[k]) * f;
			total_scaled_gap += gap;
			k++;
		}
	}
	out.i = total_scaled_gap;
	out.s.clear();
	format(out.s, "scaled gap total ", total_scaled_gap);
	gold_push(g, total_scaled_gap);
	g.steps += g.n + 1;
	out
}
@end
