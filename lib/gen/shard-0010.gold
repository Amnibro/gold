code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var streak = 0;
	for i in g.n {
		if g.res[i] <= b {
			streak++;
		} else {
			break;
		}
	}
	if streak > 1 {
		let last = g.res[streak - 1];
		var i = streak - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = streak;
	out.s.clear();
	format(out.s, "rotated streak of length ", streak);
	out
}
@end
