kind: step
verb: clamp
noun: history
modifier: last
context: search
phrase: clamp last search query history value to {bound}
phrase: restrict last search history item within bound {bound}
slot: bound int
test: list=10,25,90 bound=50
expect: => i=1 r=0.0 ok=true s="clamped last history entry to 50" errors=0 n=3 res=[10,25,50] cache=0 hits=0
test: list=5,15,40 bound=20
expect: => i=1 r=0.0 ok=true s="clamped last history entry to 20" errors=0 n=3 res=[5,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n > 0 && g.res[g.n - 1] > b {
		g.res[g.n - 1] = b;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "clamped last history entry to ", b);
	out
}
@end
@entry 7055c528b03e3c0e
kind: step
verb: return
noun: middle
modifier: unique
context: search
phrase: return unique search items from middle window {window}
phrase: extract unique middle search candidates within window {window}
slot: window int
test: list=1,2,2,3,4,4,5 window=5
expect: => i=3 r=0.0 ok=true s="returned 3 unique middle items" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10,20,20,30,40 window=3
expect: => i=2 r=0.0 ok=true s="returned 2 unique middle items" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid = g.n / 2;
	let half = w / 2;
	let start = if mid > half { mid - half } else { 0 };
	let end = if start + w < g.n { start + w } else { g.n };
	var un = 0;
	for i in start..end {
		var dup = false;
		for j in un {
			if g.res[j] == g.res[i] { dup = true; }
		}
		if !dup {
			g.res[un] = g.res[i];
			un++;
		}
	}
	g.n = un;
	g.steps += un;
	out.i = un;
	out.s.clear();
	format(out.s, "returned ", un, " unique middle items");
	out
}
@end
@entry 62c7b253ce0117ea
kind: step
verb: rotate
noun: threshold
modifier: while
context: search
phrase: rotate search items while head below threshold {threshold}
phrase: cycle search candidate list while first below threshold {threshold}
slot: threshold int
test: list=2,4,10,3 threshold=8
expect: => i=2 r=0.0 ok=true s="rotated 2 items below threshold" errors=0 n=4 res=[10,3,2,4] cache=0 hits=0
test: list=1,3,15,5 threshold=10
expect: => i=2 r=0.0 ok=true s="rotated 2 items below threshold" errors=0 n=4 res=[15,5,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var rotations = 0;
	while g.n > 1 && rotations < g.n && g.res[0] < thresh {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		rotations++;
	}
	g.steps += rotations;
	out.i = rotations;
	out.s.clear();
	format(out.s, "rotated ", rotations, " items below threshold");
	out
}
@end
@entry e869d070bad63298
kind: step
verb: dedupe
noun: tally
modifier: running
context: search
phrase: dedupe running search tally bounded by limit {limit}
phrase: prune running search tally entries under limit {limit}
slot: limit int
test: list=2,2,5,5,8,8 limit=5
expect: => i=2 r=0.0 ok=true s="deduped running tally removed 2" errors=0 n=4 res=[2,2,5,8] cache=0 hits=0
test: list=1,1,3,3,9 limit=4
expect: => i=1 r=0.0 ok=true s="deduped running tally removed 1" errors=0 n=4 res=[1,1,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	var running_sum = 0;
	for i in g.n {
		let is_dup = kept > 0 && g.res[i] == g.res[kept - 1];
		if !is_dup || running_sum < lim {
			g.res[kept] = g.res[i];
			running_sum += g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped running tally removed ", removed);
	out
}
@end
@entry 8961b525b698aa6a
kind: step
verb: validate
noun: vowels
modifier: sorted
context: search
phrase: validate sorted search query vowels above minimum {min_val}
phrase: verify search query vowels are sorted from {min_val}
slot: min_val int
test: text="aeiou" min_val=90
expect: => i=5 r=0.0 ok=true s="aeiou" errors=0 n=0 res=[] cache=0 hits=0
test: text="uoiea" min_val=80
expect: => i=5 r=0.0 ok=false s="uoiea" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var vowels byte[..100] = "";
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels.push(b);
		}
	}
	var sorted = true;
	if vowels.len > 0 && vowels[0] as int < mv { sorted = false; }
	for i in 1..vowels.len {
		if vowels[i] < vowels[i - 1] { sorted = false; }
	}
	out.ok = sorted;
	if !sorted {
		gold_fail(g, "vowels not sorted");
	}
	out.i = vowels.len;
	g.steps += vowels.len;
	out
}
@end
