fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_sz};
	let r = ${retries};
	if s <= 0 || r <= 0 || g.n == 0 {
		gold_fail(g, "invalid step stride or retries");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid stride config");
		return out;
	}
	var total = 0;
	var i = 0;
	var steps_taken = 0;
	while i < g.n && steps_taken < r {
		total += g.res[i];
		steps_taken++;
		i += s;
	}
	g.steps += steps_taken;
	out.i = total;
	out.s.clear();
	format(out.s, "summed ", steps_taken, " stride steps total: ", total);
	out
}
