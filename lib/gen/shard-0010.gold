test: list=2,4,6,3,8 threshold=5
expect: => i=2 r=0.0 ok=true s="traced sorted prefix count 2" errors=0 n=5 res=[2,4,6,3,8] cache=0 hits=0
test: list=10,20,30,40,5 threshold=35
expect: => i=3 r=0.0 ok=true s="traced sorted prefix count 3" errors=0 n=5 res=[10,20,30,40,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var count = 0;
	if g.n > 0 && g.res[0] <= thresh {
		count = 1;
		for i in 1..g.n {
			if g.res[i] >= g.res[i - 1] && g.res[i] <= thresh {
				count++;
			} else {
				break;
			}
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "traced sorted prefix count ", count);
	out
}
@end
