phrase: enforce valid streak of at least {min_len} items
test: list=2,2,2,3 min_len=2
expect: => i=3 r=0.0 ok=true s="valid streak found: 3" errors=0 n=4 res=[2,2,2,3] cache=0 hits=0
test: list=1,2,3 min_len=5
expect: => i=0 r=0.0 ok=false s="error: max streak 1 below min 5" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if ml <= 0 || g.n == 0 {
		gold_fail(g, "invalid minimum streak length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid minimum streak parameter");
		return out;
	}
	var max_streak = 0;
	var cur_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
		} else {
			if cur_streak > max_streak { max_streak = cur_streak; }
			cur_streak = 1;
		}
		i++;
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	g.steps += g.n;
	if max_streak < ml {
		gold_fail(g, "streak below required minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: max streak ", max_streak, " below min ", ml);
	} else {
		out.i = max_streak;
		out.s.clear();
		format(out.s, "valid streak found: ", max_streak);
	}
	out
}
@end
