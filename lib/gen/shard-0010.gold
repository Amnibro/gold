fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf int[512] = [0; 512];
	var runs = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
		} else {
			buf[runs] = cur_len;
			runs++;
			cur_len = 1;
		}
	}
	if g.n > 0 {
		buf[runs] = cur_len;
		runs++;
	}
	for i in runs { g.res[i] = buf[i]; }
	g.n = runs;
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "returned ", runs, " contiguous runs");
	out
}
@end
