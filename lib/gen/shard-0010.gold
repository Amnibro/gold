fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if ceil < 0 {
		gold_fail(g, "negative ceiling limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative ceiling");
		return out;
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] <= ceil {
			g.res[kept] = g.res[i];
			gold_cache_put(g, kept, g.res[i]);
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " numbers up to ceiling");
	out
}
@end
