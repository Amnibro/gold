@entry ea9dd0386cde83dc
kind: step
verb: run
noun: runs
modifier: at_most
context: search
phrase: run runs at_most bounding streak lengths to {cap}
phrase: truncate repeated search runs at_most to {cap}
slot: cap int
test: list=1,1,1,2,2,2,3 cap=2
expect: => i=5 r=0.0 ok=true s="bounded run lengths kept count: 5" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,4,4,4,5 cap=1
expect: => i=2 r=0.0 ok=true s="bounded run lengths kept count: 2" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if limit <= 0 || g.n == 0 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	var cur_streak = 0;
	var prev = g.res[0] + 1;
	for i in g.n {
		let x = g.res[i];
		if x == prev {
			cur_streak++;
		} else {
			prev = x;
			cur_streak = 1;
		}
		if cur_streak <= limit {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "bounded run lengths kept count: ", kept);
	out
}
@end
