test: list=10,20,30 bound=5
expect: => i=10 r=0.0 ok=true s="minimum meets floor 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,8,12 bound=6
expect: => i=4 r=0.0 ok=false s="minimum violates floor 4" errors=1 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var min_val = 999999;
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	out.ok = min_val >= b;
	out.i = min_val;
	g.steps += g.n;
	out.s.clear();
	if out.ok {
		format(out.s, "minimum meets floor ", min_val);
	} else {
		gold_fail(g, "minimum below required floor");
		format(out.s, "minimum violates floor ", min_val);
	}
	out
}
@end
