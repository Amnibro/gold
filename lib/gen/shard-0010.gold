	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > th {
			found = true;
			count++;
		}
	}
	gold_push(g, count);
	g.steps += g.n;
	out.i = count;
	out.ok = found;
	out.s.clear();
	format(out.s, "found ", count, " odd elements above threshold");
	out
}
@end
