code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for i in g.n {
		var x = g.res[i];
		for step in t { x = ${f}(x); }
		g.res[i] = x;
	}
	g.steps += g.n * t;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied function ", t, " times");
	out
}
