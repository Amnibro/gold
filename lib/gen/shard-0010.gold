expect: => i=3 r=0.0 ok=true s="kept 3 square candidates" errors=0 n=3 res=[4,16,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if is_sq {
			g.res[kept] = x;
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " square candidates");
	g.steps += g.n + 1;
	out
}
@end
