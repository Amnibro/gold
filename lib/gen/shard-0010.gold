fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var chars byte[..200] = "";
	var space_count = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			space_count++;
		} else {
			chars.push(out.s[i]);
		}
	}
	let app = if space_count < c { space_count } else { c };
	for k in app { chars.push(' '); }
	out.s = copy(chars);
	g.steps += out.s.len;
	out.i = space_count;
	out
}
@end
@entry 56d9432b28d6d484
kind: step
verb: dedupe
noun: runs
modifier: every_other
context: sort
phrase: dedupe every other repeated run in sorted array
phrase: collapse alternating duplicate runs in sorted list
test: list=1,1,2,2,3,3
expect: => i=4 r=0.0 ok=true s="deduped alternating runs to 4 items" errors=0 n=4 res=[1,2,2,3] cache=0 hits=0
test: list=5,5,5,6,6,7,7
expect: => i=4 r=0.0 ok=true s="deduped alternating runs to 4 items" errors=0 n=4 res=[5,6,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	var run_idx = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			i++;
		}
		if run_idx % 2 == 0 {
			g.res[kept] = val;
			kept++;
		} else {
			for k in run_len {
				g.res[kept] = val;
				kept++;
			}
		}
		run_idx++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped alternating runs to ", kept, " items");
	out
}
@end
