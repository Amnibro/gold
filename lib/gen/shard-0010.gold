expect: => i=1 r=0.0 ok=true s="suffix swaps completed 1" errors=0 n=6 res=[1,2,3,6,5,4] cache=0 hits=0
test: list=10,20,30,40 max_swaps=1
expect: => i=1 r=0.0 ok=true s="suffix swaps completed 1" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_swaps};
	let mid = g.n / 2;
	var left = mid;
	var right = g.n - 1;
	var swaps = 0;
	while left < right && swaps < ms {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
		swaps++;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "suffix swaps completed ", swaps);
	out
}
@end
