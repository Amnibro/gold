@entry f0d44c4a245a86d4
kind: step
verb: fold
noun: budget
modifier: with_retry
context: aggregate
phrase: fold budget with retry bounds up to {budget}
phrase: accumulate items within budget limit {budget} with retry
slot: budget int
test: list=10,20,30,40 budget=50
expect: => i=30 r=0.0 ok=true s="folded 2 items within budget 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35 budget=30
expect: => i=20 r=0.0 ok=true s="folded 2 items within budget 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let cost = g.res[i];
		if spent + cost <= b {
			spent += cost;
			g.res[kept] = cost;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "folded ", kept, " items within budget ", spent);
	out
}
@end
