code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	if pl <= 0 || pl * 2 > g.n {
		gold_fail(g, "invalid prefix length for reverse symmetry");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid prefix length ", pl);
		return out;
	}
	var matched = true;
	for i in pl {
		if g.res[i] != g.res[g.n - 1 - i] {
			matched = false;
			break;
		}
	}
	g.steps += pl;
	out.ok = matched;
	out.i = pl;
	out.s.clear();
	if matched {
		format(out.s, "prefix matched reverse suffix for length ", pl);
	} else {
		gold_fail(g, "symmetry mismatch");
		out.ok = false;
		format(out.s, "error: reverse symmetry mismatch");
	}
	out
}
@end
