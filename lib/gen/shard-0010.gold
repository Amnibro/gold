phrase: consolidate search errors past {tolerance} with cache
slot: tolerance int
test: list=10,25,40,25 tolerance=20
expect: => i=30 r=0.0 ok=true s="merged errors 30 cache hits 1" errors=0 n=5 res=[10,25,40,25,30] cache=2 hits=1
test: list=15,30,15,45 tolerance=10
expect: => i=65 r=0.0 ok=true s="merged errors 65 cache hits 1" errors=0 n=5 res=[15,30,15,45,65] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var err_total = 0;
	for i in g.n {
		let x = g.res[i];
		if x > tol {
			let cached, ok = gold_cache_get(g, x);
			if ok {
				err_total += cached;
			} else {
				gold_cache_put(g, x, x - tol);
				err_total += (x - tol);
			}
		}
	}
	out.i = err_total;
	out.s.clear();
	format(out.s, "merged errors ", err_total, " cache hits ", g.hits);
	gold_push(g, err_total);
	g.steps += g.n + 1;
	out
}
@end
