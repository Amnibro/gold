@entry b79381ce828bbbe7
kind: step
verb: reverse
noun: number
modifier: until
context: retry
phrase: reverse number until stopping target {target}
phrase: invert retry numbers order until encountering target {target}
slot: target int
test: list=10,20,30,40,50 target=30
expect: => i=3 r=0.0 ok=true s="reversed items until target count 3" errors=0 n=5 res=[30,20,10,40,50] cache=0 hits=0
test: list=5,15,25,35 target=25
expect: => i=3 r=0.0 ok=true s="reversed items until target count 3" errors=0 n=4 res=[25,15,5,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var stop_idx = g.n;
	for i in g.n {
		if g.res[i] == tgt {
			stop_idx = i + 1;
			break;
		}
	}
	var left = 0;
	var right = stop_idx - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += stop_idx;
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "reversed items until target count ", stop_idx);
	out
}
@end
