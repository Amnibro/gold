fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 { return out; }
	var cleaned byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		if i + 1 < out.s.len && out.s[i] == out.s[i + 1] {
			i += 2;
		} else {
			cleaned.push(out.s[i]);
			i++;
		}
	}
	out.s.clear();
	out.s.append(cleaned);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
