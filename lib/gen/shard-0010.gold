code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ev_count = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			g.res[ev_count] = g.res[i];
			ev_count++;
		}
		i++;
	}
	g.n = ev_count;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	out.i = ev_count;
	out.s.clear();
	format(out.s, "sorted ", ev_count, " evens");
	g.steps += ev_count + 1;
	out
}
@end
