@entry 2d691fa61532fedf
kind: step
verb: return
noun: streak
modifier: in_place
context: retry
phrase: return longest streak of successful retries in place
phrase: find maximum consecutive retry streak in place
phrase: isolate longest retry streak in place
test: list=1,1,1,0,1,1
expect: => i=3 r=0.0 ok=true s="streak of 3 items in place" errors=0 n=3 res=[1,1,1] cache=0 hits=0
test: list=2,2,3,4,4,4,4
expect: => i=4 r=0.0 ok=true s="streak of 4 items in place" errors=0 n=4 res=[4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var best_len = 1;
	var best_start = 0;
	var cur_len = 1;
	var cur_start = 0;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 1;
			cur_start = k;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	g.steps += g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "streak of ", best_len, " items in place");
	out
}
@end
