	if out.s.len > d {
		for i in 0..(out.s.len - d) {
			if out.s[i] == out.s[i + d] { pairs++; }
		}
	}
	g.steps += out.s.len;
	out.i = pairs;
	out.s.clear();
	format(out.s, "matched letter pairs count ", pairs);
	out
}
@end
