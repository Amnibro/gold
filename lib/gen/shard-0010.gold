fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_sum};
	if g.n < 2 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	var sum_all = 0;
	for i in (g.n - 1) {
		let p = g.res[i] + g.res[i + 1];
		if p >= ms {
			temp[kept] = p;
			sum_all += p;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = sum_all;
	out.s.clear();
	format(out.s, "scanned ", kept, " pairwise sums total ", sum_all);
	out
}
@end
