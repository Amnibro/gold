@entry c6acdf49c1e7e59d
kind: step
verb: shift
noun: primes
modifier: up_to
context: format
phrase: format prime elements shifted up to offset {offset}
phrase: render prime values adjusted by offset {offset}
slot: offset int
test: list=2,3,4,5 offset=10
expect: => i=3 r=0.0 ok=true s="shifted 3 primes up to offset 10" errors=0 n=4 res=[12,13,4,15] cache=0 hits=0
test: list=7,8,9,11 offset=5
expect: => i=2 r=0.0 ok=true s="shifted 2 primes up to offset 5" errors=0 n=4 res=[12,8,9,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var p_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[i] += off;
			p_cnt++;
		}
	}
	g.steps += g.n;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "shifted ", p_cnt, " primes up to offset ", off);
	out
}
@end
@entry fb73a64451fefcf5
kind: step
verb: split
noun: loop
modifier: nested
context: format
phrase: format nested loop split into blocks of {inner_size}
phrase: render sequence segmented into nested chunks of {inner_size}
slot: inner_size int
test: list=1,2,3,4 inner_size=2
expect: => i=2 r=0.0 ok=true s="nested loop chunks of 2: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30,40,50 inner_size=3
expect: => i=2 r=0.0 ok=true s="nested loop chunks of 3: 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let isz = ${inner_size};
	if isz <= 0 { return out; }
	let chunks = (g.n + isz - 1) / isz;
	g.steps += g.n;
	out.i = chunks;
	out.s.clear();
	format(out.s, "nested loop chunks of ", isz, ": ", chunks);
	out
}
@end
