	var primary_bin = 0;
	for i in g.n {
		if (g.res[i] / b) % 2 == 0 { primary_bin++; }
	}
	gold_cache_put(g, b, primary_bin);
	g.steps += g.n;
	out.i = primary_bin;
	out.s.clear();
	format(out.s, "histogram primary count: ", primary_bin);
	out
}
@end
