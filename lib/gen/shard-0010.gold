fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		if !${p}(g.res[i]) {
			break;
		}
		i++;
	}
	g.steps += i;
	out.i = i;
	out.ok = (i == g.n);
	out.s.clear();
	if out.ok {
		format(out.s, "all ", i, " items validated");
	} else {
		gold_fail(g, "validation stopped early");
		format(out.s, "stopped at index ", i);
	}
	out
}
@end
