fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var truncated byte[..200] = "";
	for i in out.s.len {
		if truncated.len < ml {
			truncated.push(out.s[i]);
		}
	}
	out.s = copy(truncated);
	gold_cache_put(g, 0, out.s.len);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
