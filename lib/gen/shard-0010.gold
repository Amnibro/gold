code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var popped = 0;
	while g.n > 0 && ${cond}(g.res[g.n - 1]) {
		g.n--;
		popped++;
	}
	g.steps += popped;
	out.i = popped;
	out.s.clear();
	format(out.s, "tail elements popped: ", popped);
	out
}
@end
