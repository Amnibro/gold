expect: => i=2 r=0.0 ok=true s="reversed prefix length: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var plen = ${prefix_len};
	if plen > g.n { plen = g.n; }
	for i in (plen / 2) {
		let j = plen - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += plen;
	out.i = plen;
	out.s.clear();
	format(out.s, "reversed prefix length: ", plen);
	out
}
@end
