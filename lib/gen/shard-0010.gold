noun: gaps
modifier: between
context: retry
slot: step_val int
phrase: fill gaps between elements by step {step_val}
phrase: interpolate gaps between sequence items with step {step_val}
test: list=1,5,10 step_val=2
expect: => i=2 r=0.0 ok=true s="filled 2 gaps between items" errors=0 n=5 res=[1,5,10,3,7] cache=0 hits=0
test: list=1,5 step_val=-1
expect: => i=0 r=0.0 ok=false s="error: invalid gap fill config" errors=1 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_val};
	if s <= 0 || g.n < 2 {
		gold_fail(g, "invalid step value or insufficient items for gaps");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid gap fill config");
		return out;
	}
	var gaps_filled = 0;
	var i = 0;
	let orig_n = g.n;
	while i + 1 < orig_n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > s && g.n < 500 {
			gold_push(g, g.res[i] + s);
			gaps_filled++;
		}
		i++;
	}
	g.steps += orig_n;
	out.i = gaps_filled;
	out.s.clear();
	format(out.s, "filled ", gaps_filled, " gaps between items");
	out
}
@end
