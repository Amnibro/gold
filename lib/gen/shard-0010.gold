fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var kept = 0;
	for i in g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		let target = if ok { val } else { k };
		if target <= ceil {
			g.res[kept] = target;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " memoized values");
	g.steps += g.n + 1;
	out
}
@end
