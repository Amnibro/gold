		if !${cond}(g.res[i]) { break; }
		count++;
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	g.steps += count;
	out.i = min_val;
	out.s.clear();
	format(out.s, "found minimum while true: ", min_val);
	out
}
@end
