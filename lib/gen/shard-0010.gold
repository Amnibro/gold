phrase: evaluate pairwise frequencies across bins of {bin_size}
slot: bin_size int
test: list=10,12,25,28 bin_size=10
expect: => i=1 r=0.0 ok=true s="pairwise histogram bin transitions: 1" errors=0 n=4 res=[10,12,25,28] cache=0 hits=0
test: list=5,15,25 bin_size=10
expect: => i=2 r=0.0 ok=true s="pairwise histogram bin transitions: 2" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bin_size};
	if bs <= 0 || g.n < 2 { return out; }
	var trans = 0;
	for i in 1..g.n {
		let b0 = g.res[i - 1] / bs;
		let b1 = g.res[i] / bs;
		if b0 != b1 { trans++; }
	}
	g.steps += g.n;
	out.i = trans;
	out.s.clear();
	format(out.s, "pairwise histogram bin transitions: ", trans);
	out
}
@end
@entry 116ce4b121f13b89
kind: step
verb: split
noun: primes
modifier: while
context: stats
phrase: split primes while scanning distribution observations
phrase: separate prime sample points from composite values
test: list=4,2,6,3,8,5
expect: => i=3 r=0.0 ok=true s="partitioned primes count: 3" errors=0 n=6 res=[2,3,5,4,6,8] cache=0 hits=0
test: list=9,7,12,11
expect: => i=2 r=0.0 ok=true s="partitioned primes count: 2" errors=0 n=4 res=[7,11,9,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			temp[p_count] = x;
			p_count++;
		}
	}
	var non_p = p_count;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if !is_p {
			temp[non_p] = x;
			non_p++;
		}
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "partitioned primes count: ", p_count);
	out
}
@end
