@entry a58edd234649862c
kind: step
verb: fold
noun: vowels
modifier: running
context: sort
phrase: fold running checksum over sorted vowels with step {step}
phrase: accumulate sorted vowels into running total using step {step}
slot: step int
test: text="aeiou" step=2
expect: => i=96589 r=0.0 ok=true s="aeiou" errors=0 n=0 res=[] cache=0 hits=0
test: text="eaio" step=1
expect: => i=2990154 r=0.0 ok=true s="eaio" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var vowels byte[..100] = "";
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels.push(b);
		}
	}
	for i in vowels.len {
		for j in i + 1..vowels.len {
			if vowels[i] > vowels[j] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
		}
	}
	var running = 0;
	var k = 0;
	while k < vowels.len {
		running = running * 31 + vowels[k] as int;
		k += s;
	}
	g.steps += vowels.len;
	out.i = running;
	out
}
@end
