code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let f = ${finish};
	var sum = 0;
	var k = s;
	while k <= f && k < g.n {
		sum += g.res[k];
		k++;
	}
	g.steps += f - s + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged range sum total ", sum);
	out
}
@end
