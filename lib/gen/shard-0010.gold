@entry 79220173275747d6
kind: step
verb: dedupe
noun: maximum
modifier: at_least
context: retry
phrase: dedupe maximum retry values occurring at least {k} times
phrase: remove duplicate maximum retry scores appearing at least {k} times
phrase: deduplicate peak retry entries with at least {k} repeats
slot: k int
test: list=5,9,9,9,2 k=2
expect: => i=3 r=0.0 ok=true s="deduped maximum if repeated at least 2 times" errors=0 n=3 res=[5,9,2] cache=0 hits=0
test: list=3,4,4 k=3
expect: => i=3 r=0.0 ok=true s="deduped maximum if repeated at least 3 times" errors=0 n=3 res=[3,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_reps = ${k};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_v = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == max_v { count++; }
	}
	if count >= min_reps {
		var kept = 0;
		var seen_max = false;
		for i in g.n {
			if g.res[i] == max_v {
				if !seen_max {
					g.res[kept] = max_v;
					kept++;
					seen_max = true;
				}
			} else {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped maximum if repeated at least ", min_reps, " times");
	out
}
@end
