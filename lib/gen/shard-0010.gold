phrase: remove duplicate letters up to limit {limit}
slot: limit int
test: text="bookkeeper" limit=6
expect: => i=6 r=0.0 ok=true s="bokepr" errors=0 n=0 res=[] cache=1 hits=0
test: text="committee" limit=5
expect: => i=5 r=0.0 ok=true s="comit" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var buf byte[>..] = [];
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in buf.len {
			if buf[j] == c {
				seen = true;
				break;
			}
		}
		if !seen {
			buf.push(c);
			if buf.len >= lim {
				break;
			}
		}
	}
	gold_cache_put(g, lim, buf.len);
	g.steps += out.s.len;
	out.s.clear();
	out.s.append(buf);
	out.i = buf.len;
	out
}
@end
