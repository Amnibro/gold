		if g.res[i] == tgt {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx < 0 {
		gold_fail(g, "value not found in running scan");
		out.ok = false;
		format(out.s, "error: value ", tgt, " not found");
	} else {
		format(out.s, "found value ", tgt, " at index ", found_idx);
	}
	out
}
@end
