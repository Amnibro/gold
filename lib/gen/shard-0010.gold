@entry 3a1fba6f64ad0927
kind: step
verb: scan
noun: runs
modifier: between
context: transform
phrase: scan consecutive runs across length range {min_len} {max_len}
phrase: detect equal element runs between bounds {min_len} {max_len}
slot: min_len int
slot: max_len int
test: list=1,1,1,2,2,3,3,3,3 min_len=2 max_len=3
expect: => i=2 r=0.0 ok=true s="matching run count: 2" errors=0 n=9 res=[1,1,1,2,2,3,3,3,3] cache=0 hits=0
test: list=5,5,5,5,6,6 min_len=2 max_len=2
expect: => i=1 r=0.0 ok=true s="matching run count: 1" errors=0 n=6 res=[5,5,5,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mn = ${min_len};
	let mx = ${max_len};
	var matching_runs = 0;
	var i = 0;
	while i < g.n {
		var run_len = 1;
		while i + run_len < g.n && g.res[i + run_len] == g.res[i] {
			run_len++;
		}
		if run_len >= mn && run_len <= mx {
			matching_runs++;
		}
		i += run_len;
	}
	g.steps += g.n;
	out.i = matching_runs;
	out.s.clear();
	format(out.s, "matching run count: ", matching_runs);
	out
}
@end
