@entry f00608252ba90839
kind: step
verb: scan
noun: duplicates
modifier: none
context: format
phrase: scan duplicates none verifying distinct elements
phrase: inspect duplicates none ensuring unique values
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="duplicate flag status 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=2,2,3
expect: => i=1 r=0.0 ok=false s="duplicate flag status 1" errors=0 n=3 res=[2,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dups = false;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			for j in (i + 1)..g.n {
				if g.res[i] == g.res[j] {
					has_dups = true;
					break;
				}
			}
			if has_dups { break; }
		}
	}
	g.steps += g.n * g.n;
	out.ok = !has_dups;
	out.i = if has_dups { 1 } else { 0 };
	out.s.clear();
	format(out.s, "duplicate flag status ", out.i);
	out
}
@end
