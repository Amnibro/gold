@entry 465cdc517509fd3d
kind: step
verb: rank
noun: window
modifier: at_most
context: stats
phrase: rank window at_most span {span}
phrase: score window at_most size {span}
slot: span int
test: list=10,20,30,40,50 span=3
expect: => i=120 r=0.0 ok=true s="peak window rank sum 120" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25 span=2
expect: => i=40 r=0.0 ok=true s="peak window rank sum 40" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n < sp {
		out.i = 0;
		return out;
	}
	var max_sum = 0;
	var i = 0;
	while i + sp <= g.n {
		var cur = 0;
		for j in sp { cur += g.res[i + j]; }
		if cur > max_sum { max_sum = cur; }
		i++;
	}
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "peak window rank sum ", max_sum);
	out
}
@end
