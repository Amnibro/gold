kind: step
verb: run
noun: function
modifier: until
context: search
phrase: run function {f} until predicate {cond} succeeds
phrase: iterate search transformation {f} until condition {cond}
slot: f fn
slot: cond pred
test: input=6 f=collatz cond=is_one
expect: => i=1 r=0.0 ok=true s="ran search function 8 steps" errors=0 n=9 res=[6,3,10,5,16,8,4,2,1] cache=0 hits=0
test: input=3 f=double cond=over_100
expect: => i=192 r=0.0 ok=true s="ran search function 6 steps" errors=0 n=7 res=[3,6,12,24,48,96,192] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	gold_push(g, out.i);
	while !${cond}(out.i) {
		out.i = ${f}(out.i);
		gold_push(g, out.i);
		k++;
		if k >= 1000 {
			gold_fail(g, "search stop condition never reached");
			out.ok = false;
			return out;
		}
	}
	g.steps += k;
	out.s.clear();
	format(out.s, "ran search function ", k, " steps");
	out
}
@end
