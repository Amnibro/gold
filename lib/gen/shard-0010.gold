code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tag};
	let val, ok = gold_cache_get(g, k);
	if ok {
		out.i = val;
		out.s.clear();
		format(out.s, "loaded cached minimum: ", val);
		return out;
	}
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	gold_cache_put(g, k, min_val);
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "stored normalized minimum: ", min_val);
	out
}
@end
