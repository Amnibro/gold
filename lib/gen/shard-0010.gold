@entry bfdc3787a659668b
kind: step
verb: rotate
noun: duplicates
modifier: between
context: filter
phrase: rotate duplicates bounded between {low} to {high}
phrase: cycle repeated values lying between {low} through {high}
slot: low int
slot: high int
test: list=1,5,10,15,20 low=4 high=16
expect: => i=3 r=0.0 ok=true s="rotated 3 bounded items" errors=0 n=3 res=[10,15,5] cache=0 hits=0
test: list=2,4,6,8,10 low=3 high=9
expect: => i=3 r=0.0 ok=true s="rotated 3 bounded items" errors=0 n=3 res=[6,8,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			temp[kept] = x;
			kept++;
		}
	}
	if kept > 0 {
		for i in kept {
			let idx = (i + 1) % kept;
			g.res[i] = temp[idx];
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "rotated ", kept, " bounded items");
	out
}
@end
@entry ac2523e3bf94e4a2
kind: step
verb: fold
noun: list
modifier: pairwise
context: filter
phrase: fold list elements into pairwise products
phrase: combine adjacent items across list pairwise
test: list=2,3,4,5
expect: => i=2 r=0.0 ok=true s="folded into 2 pairwise products" errors=0 n=2 res=[6,20] cache=0 hits=0
test: list=10,2,3,4
expect: => i=2 r=0.0 ok=true s="folded into 2 pairwise products" errors=0 n=2 res=[20,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] * g.res[2 * i + 1];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "folded into ", pairs, " pairwise products");
	out
}
@end
