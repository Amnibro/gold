fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var kept = 0;
	for i in g.n {
		if g.res[i] <= avg && g.res[i] <= cut {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filtered average items: ", g.n);
	out
}
@end
