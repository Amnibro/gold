fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = g.n;
	for i in g.n {
		if ${p}(g.res[i]) {
			idx = i;
			break;
		}
	}
	for i in idx {
		for j in i + 1..idx {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	gold_cache_put(g, idx, g.n);
	g.steps += idx * idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "sorted prefix length ", idx);
	out
}
