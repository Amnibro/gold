noun: threshold
modifier: unique
context: format
phrase: join threshold unique items exceeding {threshold}
phrase: concatenate unique values above threshold {threshold}
phrase: format unique items meeting threshold {threshold}
slot: threshold int
test: list=5,10,10,15 threshold=10
expect: => i=2 r=0.0 ok=true s="10,15" errors=0 n=2 res=[10,15] cache=0 hits=0
test: list=2,8,20 threshold=15
expect: => i=1 r=0.0 ok=true s="20" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= th {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	out.s.clear();
	for i in g.n {
		if i > 0 { out.s.push(','); }
		format(out.s, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
