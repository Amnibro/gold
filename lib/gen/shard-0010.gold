@entry ce246aec281da9d6
kind: step
verb: search
noun: average
modifier: in_place
context: sort
phrase: search sorted array in place for average within tolerance {tolerance}
phrase: locate mean value in sorted items using tolerance {tolerance}
slot: tolerance int
test: list=10,20,30 tolerance=5
expect: => i=1 r=0.0 ok=true s="found near average index 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=4,12,20,40 tolerance=1
expect: => i=2 r=0.0 ok=true s="found near average index 2" errors=0 n=4 res=[4,12,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n == 0 {
		out.i = -1;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	var found = -1;
	for i in g.n {
		var diff = g.res[i] - avg;
		if diff < 0 { diff = -diff; }
		if diff <= tol {
			found = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "found near average index ", found);
	out
}
@end
