test: list=19,45,78 passes=1
expect: => i=1 r=0.0 ok=true s="digit sum reduction rounds: 1" errors=0 n=3 res=[10,9,15] cache=0 hits=0
test: list=99,123,456 passes=2
expect: => i=2 r=0.0 ok=true s="digit sum reduction rounds: 2" errors=0 n=3 res=[9,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_rounds = ${passes};
	for round in max_rounds {
		for i in g.n {
			var num = g.res[i];
			if num < 0 { num = -num; }
			var d_sum = 0;
			while num > 0 {
				d_sum += num % 10;
				num /= 10;
			}
			g.res[i] = d_sum;
		}
	}
	g.steps += g.n * max_rounds;
	out.i = max_rounds;
	out.s.clear();
	format(out.s, "digit sum reduction rounds: ", max_rounds);
	out
}
@end
