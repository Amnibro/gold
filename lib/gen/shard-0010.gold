code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var max_run = 0;
	var cur_run = 0;
	for i in g.n {
		if g.res[i] == tgt {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 0;
		}
	}
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest run of target is ", max_run);
	out
}
