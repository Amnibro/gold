fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${target_char};
	var matched = 0;
	var i = 0;
	while i < out.s.len {
		if out.s[i] as int == tc {
			matched++;
		}
		i++;
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "found ", matched, " char matches");
	gold_push(g, matched);
	g.steps += out.s.len + 1;
	out
}
@end
