@entry 0eddad1fae94ac3f
kind: step
verb: fill
noun: gaps
modifier: up_to
context: transform
phrase: fill gaps between items up to step {step_max}
phrase: interpolate gaps up to maximum step {step_max}
slot: step_max int
test: list=2,10,20 step_max=5
expect: => i=5 r=0.0 ok=true s="gaps filled to total: 5" errors=0 n=5 res=[2,7,10,15,20] cache=0 hits=0
test: list=1,12 step_max=4
expect: => i=3 r=0.0 ok=true s="gaps filled to total: 3" errors=0 n=3 res=[1,5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let sm = ${step_max};
	var temp int[512] = [0; 512];
	var count = 0;
	for i in (g.n - 1) {
		temp[count] = g.res[i];
		count++;
		let diff = g.res[i + 1] - g.res[i];
		if diff > sm && count < 500 {
			temp[count] = g.res[i] + sm;
			count++;
		}
	}
	temp[count] = g.res[g.n - 1];
	count++;
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "gaps filled to total: ", count);
	out
}
@end
