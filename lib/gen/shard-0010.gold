fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slot = ${cache_slot};
	var longest = 0;
	var cur = 0;
	for i in g.n {
		if i == 0 || g.res[i] >= g.res[i - 1] {
			cur++;
		} else {
			cur = 1;
		}
		if cur > longest { longest = cur; }
	}
	gold_cache_put(g, slot, longest);
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "cached streak length: ", longest);
	out
}
@end
