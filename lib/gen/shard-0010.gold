expect: => i=0 r=0.0 ok=true s="scaled duplicate count: 0" errors=0 n=5 res=[1,1,2,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_reps};
	let multiplier = ${factor};
	var scaled_items = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] {
				freq++;
			}
		}
		if freq >= thresh {
			g.res[i] = g.res[i] * multiplier;
			scaled_items++;
		}
	}
	g.steps += g.n;
	out.i = scaled_items;
	out.s.clear();
	format(out.s, "scaled duplicate count: ", scaled_items);
	out
}
@end
