@entry 039ea37a4ac84dc2
kind: step
verb: pair
noun: tail
modifier: until
context: aggregate
phrase: pair tail items until sum reaches {target}
phrase: combine trailing elements until reaching sum {target}
slot: target int
test: list=1,2,3,4 target=5
expect: => i=8 r=0.0 ok=true s="paired tail until sum reached 8" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=10,20,30 target=40
expect: => i=80 r=0.0 ok=true s="paired tail until sum reached 80" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n < 2 { return out; }
	var sum_p = 0;
	var pairs = 0;
	var temp int[512] = [0; 512];
	for i in (g.n - 1) {
		if sum_p < tgt {
			let p = g.res[i] + g.res[i + 1];
			temp[pairs] = p;
			sum_p += p;
			pairs++;
		}
	}
	for i in pairs { g.res[i] = temp[i]; }
	g.n = pairs;
	g.steps += pairs;
	out.i = sum_p;
	out.s.clear();
	format(out.s, "paired tail until sum reached ", sum_p);
	out
}
@end
