code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var count = sp;
	if count > g.n { count = g.n; }
	let start = g.n - count;
	for i in count {
		gold_push(g, g.res[start + i]);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated history running span ", count);
	out
}
@end
@entry 2c99a658b9278de3
kind: step
verb: rotate
noun: text
modifier: up_to
context: list
phrase: rotate text up_to limit {limit} shifts {shifts}
phrase: roll text up_to prefix {limit} by {shifts}
slot: limit int
slot: shifts int
test: text="abcdef" limit=4 shifts=1
expect: => i=4 r=0.0 ok=true s="dabcef" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello" limit=3 shifts=2
expect: => i=3 r=0.0 ok=true s="elhlo" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let sh = ${shifts};
	var k = lim;
	if k > out.s.len { k = out.s.len; }
	if k > 1 && sh > 0 {
		let turns = sh % k;
		for step in turns {
			let last = out.s[k - 1];
			var i = k - 1;
			while i > 0 {
				out.s[i] = out.s[i - 1];
				i--;
			}
			out.s[0] = last;
		}
	}
	g.steps += k;
	out.i = k;
	out
}
@end
