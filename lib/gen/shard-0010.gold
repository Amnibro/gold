	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == max_val {
			count++;
		}
	}
	gold_cache_put(g, max_val, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted maximum ", max_val, " frequency ", count);
	out
}
