expect: => i=10 r=0.0 ok=true s="safely swapped maximum item 10" errors=0 n=3 res=[10,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n < 2 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	if g.res[max_idx] <= c {
		let tmp = g.res[0];
		g.res[0] = g.res[max_idx];
		g.res[max_idx] = tmp;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "safely swapped maximum item ", g.res[0]);
	out
}
@end
