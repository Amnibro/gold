kind: step
verb: pair
noun: primes
modifier: between
context: retry
phrase: pair primes between range {low} through {high}
phrase: find adjacent prime retry values between {low} through {high}
slot: low int
slot: high int
test: list=2,3,5,8,11 low=2 high=15
expect: => i=2 r=0.0 ok=true s="found 2 prime pairs" errors=0 n=6 res=[2,3,5,8,11,2] cache=0 hits=0
test: list=4,6,7,9,13 low=1 high=20
expect: => i=0 r=0.0 ok=true s="found 0 prime pairs" errors=0 n=6 res=[4,6,7,9,13,0] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var pairs = 0;
	if g.n >= 2 {
		for i in (g.n - 1) {
			let a = g.res[i];
			let b = g.res[i + 1];
			if a >= lo && a <= hi && b >= lo && b <= hi {
				if ${ID}_is_prime(a) && ${ID}_is_prime(b) {
					pairs++;
				}
			}
		}
	}
	gold_push(g, pairs);
	g.steps += g.n + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " prime pairs");
	out
}
@end
