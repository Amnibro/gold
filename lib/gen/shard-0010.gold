fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n < 2 {
		gold_fail(g, "not enough items for pair limit");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	for i in (g.n - 1) {
		let s = g.res[i] + g.res[i + 1];
		let clamped = if s > b { b } else { s };
		gold_push(g, clamped);
		pairs++;
	}
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " items bounded");
	out
}
@end
