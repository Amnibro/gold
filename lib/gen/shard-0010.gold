code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${stop_val};
	if g.n == 0 { return out; }
	var cur_max = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
		if g.res[i] >= sv { break; }
		i++;
	}
	g.steps += i;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "merged maximum until stop is ", cur_max);
	out
}
@end
