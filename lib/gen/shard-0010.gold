@entry c4ee9fdb0b5134af
kind: step
verb: reverse
noun: condition
modifier: until
context: retry
phrase: reverse condition until predicate {p}
phrase: invert retry elements preceding condition {p}
slot: p pred
test: list=1,3,5,6,7 p=is_even
expect: => i=3 r=0.0 ok=true s="reversed items until condition count 3" errors=0 n=5 res=[5,3,1,6,7] cache=0 hits=0
test: list=2,4,8,9,10 p=is_odd
expect: => i=3 r=0.0 ok=true s="reversed items until condition count 3" errors=0 n=5 res=[8,4,2,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stop_idx = g.n;
	for i in g.n {
		if ${p}(g.res[i]) {
			stop_idx = i;
			break;
		}
	}
	var left = 0;
	var right = stop_idx - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += stop_idx;
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "reversed items until condition count ", stop_idx);
	out
}
@end
