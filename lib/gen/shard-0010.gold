fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid = g.n / 2;
		var i = 0;
		while i < g.n {
			if i != mid {
				let tmp = g.res[i];
				g.res[i] = g.res[mid];
				g.res[mid] = tmp;
			}
			i += 2;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped middle across every other ", g.n);
	out
}
@end
