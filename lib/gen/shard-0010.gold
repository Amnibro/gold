	let off = ${offset};
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var w = 1;
	var removed = 0;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			removed++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n + off;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped adjacent pairs removed ", removed);
	out
}
@end
