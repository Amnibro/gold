@entry 90bfdeb465cb7608
kind: step
verb: fold
noun: budget
modifier: pairwise
context: list
phrase: fold budget pairwise threshold {threshold}
phrase: reduce budget pairwise limit {threshold}
slot: threshold int
test: list=10,15,20,5 threshold=25
expect: => i=2 r=0.0 ok=true s="folded budget into 2 pairs" errors=0 n=2 res=[25,25] cache=0 hits=0
test: list=30,40,50 threshold=100
expect: => i=2 r=0.0 ok=true s="folded budget into 2 pairs" errors=0 n=2 res=[70,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i + 1 < g.n {
		var sum = g.res[i] + g.res[i + 1];
		if sum > th { sum = th; }
		g.res[new_n] = sum;
		new_n++;
		i += 2;
	}
	if i < g.n {
		g.res[new_n] = g.res[i];
		new_n++;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "folded budget into ", new_n, " pairs");
	out
}
@end
