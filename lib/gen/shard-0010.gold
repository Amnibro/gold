kind: step
verb: drop
noun: evens
modifier: while
context: retry
slot: cond pred
phrase: drop evens while condition {cond} remains satisfied
phrase: remove even numbers while matching condition {cond}
test: list=2,4,5,6 cond=is_even
expect: => i=2 r=0.0 ok=true s="dropped 2 leading even items" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=1,3 cond=is_even
expect: => i=0 r=0.0 ok=true s="no leading even items dropped" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for drop evens");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var drop_count = 0;
	while drop_count < g.n {
		let val = g.res[drop_count];
		if val % 2 == 0 && ${cond}(val) {
			drop_count++;
		} else {
			break;
		}
	}
	if drop_count > 0 {
		let remaining = g.n - drop_count;
		for i in remaining {
			g.res[i] = g.res[drop_count + i];
		}
		g.n = remaining;
	}
	g.steps += g.n + drop_count;
	out.i = drop_count;
	out.s.clear();
	if drop_count == 0 {
		format(out.s, "no leading even items dropped");
	} else {
		format(out.s, "dropped ", drop_count, " leading even items");
	}
	out
}
@end
