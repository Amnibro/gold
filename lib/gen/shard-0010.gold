@entry 76388a77582c6686
kind: step
verb: join
noun: threshold
modifier: times
context: sort
phrase: join sorted elements within threshold {threshold} across {times} times
phrase: merge adjacent sorted items below threshold {threshold} across {times} times
slot: threshold int
slot: times int
test: list=10,12,20,22 threshold=5 times=1
expect: => i=2 r=0.0 ok=true s="joined elements leaving count 2" errors=0 n=2 res=[22,42] cache=0 hits=0
test: list=1,3,5,15 threshold=3 times=2
expect: => i=2 r=0.0 ok=true s="joined elements leaving count 2" errors=0 n=2 res=[9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let t = ${times};
	for round in t {
		if g.n < 2 { break; }
		var kept = 0;
		var i = 0;
		while i < g.n {
			if i + 1 < g.n && (g.res[i + 1] - g.res[i]) <= th {
				g.res[kept] = g.res[i] + g.res[i + 1];
				kept++;
				i += 2;
			} else {
				g.res[kept] = g.res[i];
				kept++;
				i++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined elements leaving count ", g.n);
	out
}
@end
