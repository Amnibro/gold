test: list=10,20,30,40,50,60
expect: => i=1 r=0.0 ok=true s="reversed 1 middle pairs" errors=0 n=6 res=[10,40,30,20,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 {
		out.i = 0;
		return out;
	}
	let start = g.n / 4;
	let end = (3 * g.n) / 4;
	var p1 = start;
	var p2 = end - 1;
	var count = 0;
	while p1 < p2 {
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		count++;
		p1 += 2;
		p2 -= 2;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " middle pairs");
	g.steps += count + 1;
	out
}
@end
