code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var vowels byte[..100] = "";
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels.push(b);
		}
	}
	for i in vowels.len {
		for j in i + 1..vowels.len {
			if vowels[i] > vowels[j] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
		}
	}
	let count = if vowels.len < lim { vowels.len } else { lim };
	var res byte[..100] = "";
	for k in count { res.push(vowels[k]); }
	out.s = copy(res);
	g.steps += count;
	out.i = count;
	out
}
@end
