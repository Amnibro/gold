fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var temp int[512] = [0; 512];
	for i in g.n {
		temp[(i + 1) % g.n] = g.res[i];
	}
	var kept = 0;
	for i in g.n {
		let x = temp[i];
		gold_cache_put(g, x, i);
		g.res[kept] = x;
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "rotated ", kept, " cached unique values");
	out
}
@end
@entry 107e86dae1d94d83
kind: step
verb: reverse
noun: prefix
modifier: none
context: filter
phrase: reverse prefix sequence leaving none unreversed
phrase: invert complete prefix ordering across all results
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="reversed prefix of 5 items" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=10,20,30,40
expect: => i=4 r=0.0 ok=true s="reversed prefix of 4 items" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in (g.n / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[g.n - 1 - i];
		g.res[g.n - 1 - i] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed prefix of ", g.n, " items");
	out
}
@end
