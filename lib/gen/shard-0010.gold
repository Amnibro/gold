fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	if ms <= 0 || g.n == 0 {
		gold_fail(g, "invalid streak limit or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid streak grouping parameter");
		return out;
	}
	var streak = 1;
	var i = 1;
	while i < g.n && streak < ms {
		if g.res[i] == g.res[i - 1] {
			streak++;
		} else {
			break;
		}
		i++;
	}
	g.steps += g.n;
	g.n = streak;
	out.i = streak;
	out.s.clear();
	format(out.s, "grouped streak of size ", streak);
	out
}
@end
