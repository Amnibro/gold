	var curr_len = 0;
	for i in g.n {
		if i == 0 || g.res[i] == g.res[i - 1] {
			curr_len++;
		} else {
			runs[rn] = curr_len;
			rn++;
			curr_len = 1;
		}
	}
	if curr_len > 0 { runs[rn] = curr_len; rn++; }
	var total = 0;
	var i = 0;
	while i < rn && i < lim {
		total += runs[i];
		i += 2;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "traced every other run sum ", total);
	out
}
@end
