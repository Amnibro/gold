@entry 8b6ab87b3fa83d91
kind: step
verb: apply
noun: history
modifier: running
context: filter
phrase: apply running history filter keeping elements above running mean
phrase: filter items exceeding cumulative running average history
test: list=10,5,20,15,30
expect: => i=4 r=0.0 ok=true s="kept above running mean count: 4" errors=0 n=4 res=[10,20,15,30] cache=0 hits=0
test: list=2,8,4,16
expect: => i=4 r=0.0 ok=true s="kept above running mean count: 4" errors=0 n=4 res=[2,8,4,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	var run_sum = 0;
	for i in g.n {
		run_sum += g.res[i];
		let mean = run_sum / (i + 1);
		if g.res[i] >= mean {
			temp[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept above running mean count: ", kept);
	out
}
@end
