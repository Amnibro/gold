fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let limit = if g.n + c > 512 { 512 - g.n } else { c };
	for i in limit {
		g.res[g.n] = 2 * (i + 1);
		g.n++;
	}
	g.steps += limit;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled running evens total length: ", g.n);
	out
}
@end
