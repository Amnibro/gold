expect: => i=2 r=0.0 ok=true s="reversed first memo elements: 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = ${count};
	if k > g.n { k = g.n; }
	for i in (k / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[k - 1 - i];
		g.res[k - 1 - i] = tmp;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed first memo elements: ", k);
	out
}
@end
