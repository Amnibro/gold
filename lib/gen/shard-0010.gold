@entry a46f7c8a10ea559c
kind: step
verb: limit
noun: history
modifier: unique
context: cache
phrase: limit history unique capacity bound {max_entries}
phrase: restrict unique history to capacity {max_entries}
slot: max_entries int
test: list=5,5,10,10,15 max_entries=2
expect: => i=2 r=0.0 ok=true s="unique history limit: 2" errors=0 n=2 res=[5,10] cache=1 hits=0
test: list=1,2,2,3,3 max_entries=1
expect: => i=1 r=0.0 ok=true s="unique history limit: 1" errors=0 n=1 res=[1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mx = ${max_entries};
	var uniq = 0;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			if uniq < mx {
				g.res[kept] = g.res[i];
				kept++;
				uniq++;
			}
		}
	}
	g.n = kept;
	gold_cache_put(g, mx, uniq);
	g.steps += g.n;
	out.i = uniq;
	out.s.clear();
	format(out.s, "unique history limit: ", uniq);
	out
}
@end
@entry be001c9f9c523c85
kind: step
verb: normalize
noun: streak
modifier: with_cache
context: cache
phrase: normalize streak with_cache min length {streak_len}
phrase: detect increasing run of length {streak_len}
slot: streak_len int
test: list=2,4,6,1,2 streak_len=3
expect: => i=1 r=0.0 ok=true s="increasing streak found: 1" errors=0 n=5 res=[2,4,6,1,2] cache=1 hits=0
test: list=10,20,30,40,5 streak_len=4
expect: => i=1 r=0.0 ok=true s="increasing streak found: 1" errors=0 n=5 res=[10,20,30,40,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sl = ${streak_len};
	var cur_run = 1;
	var found = false;
	if g.n > 1 {
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				cur_run++;
				if cur_run >= sl { found = true; break; }
			} else {
				cur_run = 1;
			}
		}
	}
	let code = if found { 1 } else { 0 };
	gold_cache_put(g, sl, code);
	g.steps += g.n;
	out.i = code;
	out.s.clear();
	format(out.s, "increasing streak found: ", code);
	out
}
@end
