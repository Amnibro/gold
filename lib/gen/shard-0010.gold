code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for step in d {
		if g.n < 2 { break; }
		for i in (g.n - 1) {
			g.res[i] = g.res[i] - g.res[i + 1];
		}
		g.n--;
	}
	g.steps += d;
	out.i = g.n;
	out.s.clear();
	format(out.s, "compared recursively to depth ", d);
	out
}
@end
