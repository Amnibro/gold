expect: => i=1 r=0.0 ok=false s="error: target appeared 1 times not 5" errors=1 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let t = ${times};
	if t <= 0 || g.n == 0 {
		gold_fail(g, "invalid count parameter or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid parameters");
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] == tgt { count++; }
	}
	g.steps += g.n;
	let matched = count == t;
	out.ok = matched;
	out.i = count;
	out.s.clear();
	if matched {
		format(out.s, "target ", tgt, " appeared exactly ", t, " times");
	} else {
		gold_fail(g, "target count mismatch");
		out.ok = false;
		format(out.s, "error: target appeared ", count, " times not ", t);
	}
	out
}
@end
