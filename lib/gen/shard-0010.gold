expect: => i=20 r=0.0 ok=true s="kept 2 items total 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var run = 0;
	var kept = 0;
	for i in g.n {
		if run + g.res[i] <= b {
			run += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	out.i = run;
	out.s.clear();
	format(out.s, "kept ", kept, " items total ", run);
	g.steps += kept + 1;
	out
}
@end
