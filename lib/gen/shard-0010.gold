@entry de227660931c3015
kind: step
verb: reverse
noun: vowels
modifier: every_other
context: format
phrase: reverse vowels every other in buffer
phrase: invert vowels every other across string
test: text="aeiou"
expect: => i=5 r=0.0 ok=true s="eaoiu" errors=0 n=0 res=[] cache=0 hits=0
test: text="education"
expect: => i=5 r=0.0 ok=true s="udecitaon" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowel_indices int[32] = [0; 32];
	var vn = 0;
	for i in out.s.len {
		let ch = out.s[i];
		if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') && vn < 32 {
			vowel_indices[vn] = i;
			vn++;
		}
	}
	var i = 0;
	while i + 1 < vn {
		let idx1 = vowel_indices[i];
		let idx2 = vowel_indices[i + 1];
		let tmp = out.s[idx1];
		out.s[idx1] = out.s[idx2];
		out.s[idx2] = tmp;
		i += 2;
	}
	g.steps += out.s.len;
	out.i = vn;
	out
}
@end
