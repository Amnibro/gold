kind: step
verb: drop
noun: results
modifier: recursively
context: list
phrase: drop results recursively with depth {depth}
phrase: discard results recursively to depth {depth}
slot: depth int
test: list=10,2,8,1 depth=2
expect: => i=2 r=0.0 ok=true s="dropped recursively, remaining 2" errors=0 n=2 res=[10,8] cache=0 hits=0
test: list=5,15,3 depth=1
expect: => i=2 r=0.0 ok=true s="dropped recursively, remaining 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for step in d {
		if g.n == 0 { break; }
		var min_idx = 0;
		for i in 1..g.n { if g.res[i] < g.res[min_idx] { min_idx = i; } }
		for i in min_idx..(g.n - 1) { g.res[i] = g.res[i + 1]; }
		g.n--;
	}
	g.steps += d;
	out.i = g.n;
	out.s.clear();
	format(out.s, "dropped recursively, remaining ", g.n);
	out
}
@end
