@entry d6d0c549605ef1f2
kind: step
verb: scan
noun: errors
modifier: any
context: compare
phrase: scan errors any bad_val {bad_val}
phrase: search list for any error value {bad_val}
slot: bad_val int
test: list=1,2,99,4 bad_val=99
expect: => i=1 r=0.0 ok=false s="scan for error value result: true" errors=1 n=4 res=[1,2,99,4] cache=0 hits=0
test: list=10,20,30 bad_val=5
expect: => i=0 r=0.0 ok=true s="scan for error value result: false" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bv = ${bad_val};
	var found = false;
	for i in g.n {
		if g.res[i] == bv {
			found = true;
			break;
		}
	}
	if found {
		gold_fail(g, "error value detected in compare results");
		out.ok = false;
	}
	g.steps += g.n;
	out.ok = !found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "scan for error value result: ", found);
	out
}
@end
