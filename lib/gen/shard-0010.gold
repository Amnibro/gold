noun: maximum
modifier: unique
context: transform
phrase: find maximum unique distinct value
phrase: locate unique maximum transforming list
test: list=2,5,8,8,5,7
expect: => i=7 r=0.0 ok=true s="found unique maximum: 7" errors=0 n=1 res=[7] cache=0 hits=0
test: list=10,20,30,30,25
expect: => i=25 r=0.0 ok=true s="found unique maximum: 25" errors=0 n=1 res=[25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var max_val = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq == 1 {
			if !found || x > max_val {
				max_val = x;
				found = true;
			}
		}
	}
	if found {
		g.res[0] = max_val;
		g.n = 1;
		out.i = max_val;
		out.s.clear();
		format(out.s, "found unique maximum: ", max_val);
	} else {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "no unique maximum found");
	}
	g.steps += g.n;
	out
}
@end
