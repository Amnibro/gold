@entry 2bd51fcb2598e7bf
kind: step
verb: shift
noun: primes
modifier: with_retry
context: core
phrase: shift prime values with retry limit {max_retries}
phrase: increment non primes to primes with retry limit {max_retries}
slot: max_retries int
test: list=4,8,9 max_retries=3
expect: => i=6 r=0.0 ok=true s="shifted primes with 6 increments" errors=0 n=3 res=[5,11,11] cache=0 hits=0
test: list=6,14 max_retries=2
expect: => i=3 r=0.0 ok=true s="shifted primes with 3 increments" errors=0 n=2 res=[7,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_retries};
	var shifted = 0;
	for i in g.n {
		var x = g.res[i];
		var attempt = 0;
		while attempt < mr {
			var is_p = true;
			if x < 2 { is_p = false; }
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { break; }
			x++;
			attempt++;
			shifted++;
		}
		g.res[i] = x;
	}
	g.steps += shifted;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted primes with ", shifted, " increments");
	out
}
@end
