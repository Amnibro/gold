@entry 3b11830a54f39d36
kind: step
verb: dedupe
noun: minimum
modifier: in_reverse
context: compare
phrase: dedupe minimum value in reverse order
phrase: remove duplicate minimum values backward
phrase: safely deduplicate minimum elements in reverse direction
test: list=1,2,1,3,1,4
expect: => i=4 r=0.0 ok=true s="deduped minimum in reverse to 4 items" errors=0 n=4 res=[4,1,3,2] cache=0 hits=0
test: list=5,10,5,20
expect: => i=3 r=0.0 ok=true s="deduped minimum in reverse to 3 items" errors=0 n=3 res=[20,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var buf int[512] = [0; 512];
	var kept = 0;
	var min_seen = false;
	var i = g.n;
	while i > 0 {
		i--;
		let x = g.res[i];
		if x == min_val {
			if !min_seen {
				buf[kept] = x;
				kept++;
				min_seen = true;
			}
		} else {
			buf[kept] = x;
			kept++;
		}
	}
	for k in kept { g.res[k] = buf[k]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped minimum in reverse to ", kept, " items");
	out
}
@end
