code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_step};
	var clamped = 0;
	var i = g.n - 1;
	while i > 0 {
		let diff = g.res[i] - g.res[i - 1];
		if diff > ms {
			g.res[i - 1] = g.res[i] - ms;
			clamped++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " backward steps");
	out
}
@end
