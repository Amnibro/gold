fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let count = if k > g.n { g.n } else { if k < 0 { 0 } else { k } };
	var left = 0;
	var right = count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped head in reverse count ", count);
	out
}
@end
