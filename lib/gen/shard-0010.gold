kind: step
verb: retry
noun: minimum
modifier: recursively
context: retry
phrase: retry minimum recursively below floor {floor}
phrase: reduce minimal retry value repeatedly towards {floor}
slot: floor int
test: list=2,10,20 floor=8
expect: => i=8 r=0.0 ok=true s="retried minimum to 8" errors=0 n=3 res=[8,10,20] cache=0 hits=0
test: list=5,30,50 floor=25
expect: => i=25 r=0.0 ok=true s="retried minimum to 25" errors=0 n=3 res=[25,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	if g.n == 0 {
		gold_fail(g, "no retry items for minimum");
		out.ok = false;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var cur = min_val;
	var iters = 0;
	while cur < fl && iters < 5 {
		cur = (cur + fl + 1) / 2;
		iters++;
	}
	g.res[min_idx] = cur;
	g.steps += iters + 1;
	out.i = cur;
	out.s.clear();
	format(out.s, "retried minimum to ", cur);
	out
}
@end
