modifier: any
context: transform
phrase: shift values matching any condition {check} by {offset}
phrase: transform values by shift {offset} if any match {check}
slot: check pred
slot: offset int
test: list=1,2,3,4,5 check=is_even offset=10
expect: => i=2 r=0.0 ok=true s="shifted matching values: 2" errors=0 n=5 res=[1,12,3,14,5] cache=0 hits=0
test: list=5,10,15 check=under_10 offset=5
expect: => i=1 r=0.0 ok=true s="shifted matching values: 1" errors=0 n=3 res=[10,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var shifted = 0;
	for i in g.n {
		if ${check}(g.res[i]) {
			g.res[i] += off;
			shifted++;
		}
	}
	g.steps += shifted;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted matching values: ", shifted);
	out
}
@end
