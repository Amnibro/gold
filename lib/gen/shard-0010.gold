test: list=10,12,15,20 win_size=2
expect: => i=10 r=0.0 ok=true s="total window differences sum 10" errors=0 n=4 res=[10,12,15,20] cache=0 hits=0
test: list=5,8,14,20,30 win_size=3
expect: => i=37 r=0.0 ok=true s="total window differences sum 37" errors=0 n=5 res=[5,8,14,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	if ws <= 0 || g.n < ws { return out; }
	var diff_sum = 0;
	let count = g.n - ws + 1;
	for i in count {
		var d = g.res[i + ws - 1] - g.res[i];
		if d < 0 { d = -d; }
		diff_sum += d;
	}
	g.steps += count;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "total window differences sum ", diff_sum);
	out
}
@end
