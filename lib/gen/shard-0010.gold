expect: => i=75 r=0.0 ok=true s="merged middle run 75" errors=0 n=7 res=[5,15,40,75,45,55,75] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		out.i = 0;
		return out;
	}
	let start = g.n / 4;
	let end = (3 * g.n) / 4;
	var run = 0;
	var i = start;
	while i < end {
		run += g.res[i];
		g.res[i] = run;
		i++;
	}
	out.i = run;
	out.s.clear();
	format(out.s, "merged middle run ", run);
	gold_push(g, run);
	g.steps += (end - start) + 1;
	out
}
@end
