slot: step_size int
test: list=5,2,9,1 step_size=3
expect: => i=4 r=0.0 ok=true s="mapped sorted sequence count 4" errors=0 n=4 res=[1,5,11,18] cache=0 hits=0
test: list=10,4,8 step_size=2
expect: => i=3 r=0.0 ok=true s="mapped sorted sequence count 3" errors=0 n=3 res=[4,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ss = ${step_size};
	if g.n == 0 { return out; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	for i in g.n {
		g.res[i] += ss * i;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped sorted sequence count ", g.n);
	out
}
@end
@entry 286c28443a28ba0f
kind: step
verb: check
noun: steps
modifier: unique
context: loop
phrase: check loop steps unique bound {bound}
phrase: verify loop steps are unique within bound {bound}
slot: bound int
test: list=1,3,6,10 bound=4
expect: => i=3 r=0.0 ok=true s="unique step differences check: true" errors=0 n=4 res=[1,3,6,10] cache=0 hits=0
test: list=2,4,6,8 bound=3
expect: => i=3 r=0.0 ok=false s="unique step differences check: false" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n < 2 { return out; }
	var diffs int[512] = [0; 512];
	var ndiff = 0;
	var all_unique = true;
	let max_check = if g.n - 1 > b { b } else { g.n - 1 };
	for i in max_check {
		let d = g.res[i + 1] - g.res[i];
		for j in ndiff {
			if diffs[j] == d { all_unique = false; }
		}
		diffs[ndiff] = d;
		ndiff++;
	}
	g.steps += ndiff;
	out.ok = all_unique;
	out.i = ndiff;
	out.s.clear();
	format(out.s, "unique step differences check: ", all_unique);
	out
}
@end
@entry c94e8649be56f55a
kind: step
verb: retry
noun: tail
modifier: unique
context: loop
phrase: retry tail unique attempts {max_att}
phrase: modify tail elements until unique attempts {max_att}
slot: max_att int
test: list=1,2,3,2 max_att=5
expect: => i=4 r=0.0 ok=true s="tail unique resolved value 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6 max_att=2
expect: => i=7 r=0.0 ok=true s="tail unique resolved value 7" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_att};
	if g.n < 2 { return out; }
	let last_idx = g.n - 1;
	var att = 0;
	var duplicate = true;
	while duplicate && att < ma {
		duplicate = false;
		for i in last_idx {
			if g.res[i] == g.res[last_idx] {
				duplicate = true;
				break;
			}
		}
		if duplicate {
			g.res[last_idx]++;
			att++;
		}
	}
	g.steps += att;
	out.i = g.res[last_idx];
	out.s.clear();
	format(out.s, "tail unique resolved value ", g.res[last_idx]);
	out
}
@end
