test: list=2,3 f=double mult=10
expect: => i=2 r=0.0 ok=true s="joined nested function across 2 items" errors=0 n=2 res=[28,42] cache=0 hits=0
test: list=4,5 f=inc mult=3
expect: => i=2 r=0.0 ok=true s="joined nested function across 2 items" errors=0 n=2 res=[18,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	for k in g.n {
		let v1 = ${f}(g.res[k]);
		let v2 = ${f}(v1);
		g.res[k] = v2 + (g.res[k] * m);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "joined nested function across ", g.n, " items");
	out
}
@end
