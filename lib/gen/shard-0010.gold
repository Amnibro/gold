@entry 2046f84c27d38dfe
kind: step
verb: select
noun: range
modifier: last
context: loop
phrase: select loop range last count {count}
phrase: slice results choosing last range count {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="selected last elements count 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,6,7,8,9 count=3
expect: => i=3 r=0.0 ok=true s="selected last elements count 3" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 || g.n == 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let take = if k > g.n { g.n } else { k };
	let start = g.n - take;
	for i in take {
		g.res[i] = g.res[start + i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "selected last elements count ", take);
	out
}
@end
