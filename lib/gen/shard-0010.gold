fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step_size};
	out.s.clear();
	var count = 0;
	var i = 0;
	while i < g.n {
		if count > 0 { out.s.push(','); }
		format(out.s, g.res[i]);
		count++;
		i += sz;
	}
	out.i = count;
	g.steps += count;
	out
}
