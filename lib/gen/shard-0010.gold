@entry a761d3ff3b63e794
kind: step
verb: run
noun: evens
modifier: recursively
context: loop
slot: depth int
phrase: run evens recursively dividing by two up to {depth} times
phrase: halve even numbers recursively with recursion depth {depth}
test: list=16,24,9 depth=3
expect: => i=6 r=0.0 ok=true s="recursively halved evens 6 times" errors=0 n=3 res=[2,3,9] cache=0 hits=0
test: list=16 depth=-1
expect: => i=0 r=0.0 ok=false s="error: invalid depth -1" errors=1 n=1 res=[16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || g.n == 0 {
		gold_fail(g, "invalid depth parameter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid depth ", d);
		return out;
	}
	var total_halves = 0;
	for i in g.n {
		var val = g.res[i];
		var k = 0;
		while val > 0 && val % 2 == 0 && k < d {
			val = val / 2;
			k++;
		}
		g.res[i] = val;
		total_halves += k;
	}
	g.steps += total_halves + g.n;
	out.i = total_halves;
	out.s.clear();
	format(out.s, "recursively halved evens ", total_halves, " times");
	out
}
@end
