slot: bias int
test: list=20,10,40,30 bias=5
expect: => i=30 r=0.0 ok=true s="sorted average computed is 30" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=6,2,4 bias=0
expect: => i=4 r=0.0 ok=true s="sorted average computed is 4" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n + b;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "sorted average computed is ", avg);
	out
}
@end
