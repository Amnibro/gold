test: list=8,3,12,5 threshold=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[8,3,12,5] cache=0 hits=0
test: list=20,10 threshold=15
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var valid = true;
	for i in g.n {
		if g.res[i] > th {
			valid = false;
			break;
		}
	}
	if !valid {
		gold_fail(g, "value exceeded safe threshold");
		out.ok = false;
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely sorted ", g.n, " values");
	out
}
@end
