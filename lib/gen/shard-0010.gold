		ranks[i] = r;
		i += 2;
	}
	i = 0;
	while i < g.n {
		g.res[i] = ranks[i];
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked alternating results in transform");
