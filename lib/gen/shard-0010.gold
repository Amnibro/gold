@entry 57254ac3ee1a648a
kind: step
verb: reverse
noun: number
modifier: at_most
context: cache
phrase: reverse number values at most limit {limit}
phrase: invert digits for at most limit {limit} numbers
slot: limit int
test: list=14,25,36 limit=2
expect: => i=2 r=0.0 ok=true s="reversed digits for 2 items" errors=0 n=3 res=[41,52,36] cache=2 hits=0
test: list=12,45 limit=1
expect: => i=1 r=0.0 ok=true s="reversed digits for 1 items" errors=0 n=2 res=[21,45] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let actual = if lim < 0 { 0 } else { if lim > g.n { g.n } else { lim } };
	for i in actual {
		var x = g.res[i];
		let neg = x < 0;
		if neg { x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		let final_val = if neg { -rev } else { rev };
		g.res[i] = final_val;
		gold_cache_put(g, i, final_val);
	}
	g.steps += g.n;
	out.i = actual;
	out.s.clear();
	format(out.s, "reversed digits for ", actual, " items");
	out
}
@end
