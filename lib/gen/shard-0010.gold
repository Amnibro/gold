		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = val;
			hit_count++;
		} else {
			gold_cache_put(g, x, x * 2);
		}
	}
	g.steps += g.n;
	out.i = hit_count;
	out.s.clear();
	format(out.s, "memo in place hits: ", hit_count);
