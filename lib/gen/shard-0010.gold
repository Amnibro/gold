fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mi = ${min};
	let ma = ${max};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var count = 0;
	for i in g.n {
		let val, ok = gold_cache_get(g, i);
		if ok && val >= mi && val <= ma {
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked cache values between count ", count);
	out
}
@end
@entry 9fadd2923bbd523b
kind: step
verb: rotate
noun: digits
modifier: at_most
context: list
phrase: rotate digits at_most cap {cap} shifts {shifts}
phrase: roll digits at_most max {cap} by {shifts}
slot: cap int
slot: shifts int
test: input=4321 cap=3 shifts=1
expect: => i=4213 r=0.0 ok=true s="rotated digits to 4213" errors=0 n=0 res=[] cache=0 hits=0
test: input=987 cap=2 shifts=1
expect: => i=978 r=0.0 ok=true s="rotated digits to 978" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let sh = ${shifts};
	var x = out.i;
	if x < 0 { x = -x; }
	var d = [0; 20];
	var dn = 0;
	if x == 0 {
		d[0] = 0;
		dn = 1;
	} else {
		while x > 0 {
			d[dn] = x % 10;
			dn++;
			x /= 10;
		}
	}
	var k = c;
	if k > dn { k = dn; }
	if k > 1 && sh > 0 {
		let turns = sh % k;
		for step in turns {
			let last = d[k - 1];
			var i = k - 1;
			while i > 0 {
				d[i] = d[i - 1];
				i--;
			}
			d[0] = last;
		}
	}
	var res = 0;
	var i = dn - 1;
	while i >= 0 {
		res = res * 10 + d[i];
		i--;
	}
	out.i = res;
	g.steps += dn;
	out.s.clear();
	format(out.s, "rotated digits to ", res);
	out
}
@end
