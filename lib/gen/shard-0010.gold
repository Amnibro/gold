test: text="query" target=2
expect: => i=8634 r=0.0 ok=true s="folded text into cache hash 8634" errors=0 n=0 res=[] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${target};
	var hash = 0;
	for i in out.s.len {
		hash = (hash * 31 + out.s[i] as int) % 10007;
	}
	gold_cache_put(g, key, hash);
	let cached_val, ok = gold_cache_get(g, key);
	out.i = cached_val;
	g.steps += out.s.len;
	out.s.clear();
	format(out.s, "folded text into cache hash ", cached_val);
	out
}
@end
