phrase: measure suffix search hits meeting {min_score}
slot: min_score int
test: list=10,20,30,40,50 min_score=35
expect: => i=2 r=0.0 ok=true s="counted 2 suffix hits" errors=0 n=6 res=[10,20,30,40,50,2] cache=0 hits=0
test: list=5,15,25,35,45,55 min_score=30
expect: => i=3 r=0.0 ok=true s="counted 3 suffix hits" errors=0 n=7 res=[5,15,25,35,45,55,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_score};
	let half = g.n / 2;
	var cnt = 0;
	var i = half;
	while i < g.n {
		if g.res[i] >= ms { cnt++; }
		i++;
	}
	out.i = cnt;
	out.s.clear();
	format(out.s, "counted ", cnt, " suffix hits");
	gold_push(g, cnt);
	g.steps += (g.n - half) + 1;
	out
}
@end
@entry ba3cedbcaf558bcf
kind: step
verb: run
noun: memo
modifier: with_retry
context: transform
phrase: run memo transform with retry attempts {retries}
phrase: evaluate memoized calculation with retry limit {retries}
slot: retries int
test: list=2,3,2,4 retries=2
expect: => i=3 r=0.0 ok=true s="memoized elements count: 3" errors=0 n=4 res=[18,27,18,36] cache=3 hits=1
test: list=5,5,6 retries=3
expect: => i=2 r=0.0 ok=true s="memoized elements count: 2" errors=0 n=3 res=[135,135,162] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var computed = 0;
	for i in g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if ok {
			g.res[i] = val;
		} else {
			var res_val = x;
			var r = 0;
			while r < r_max {
				res_val = res_val * 3;
				r++;
			}
			gold_cache_put(g, x, res_val);
			g.res[i] = res_val;
			computed++;
		}
	}
	g.steps += g.n;
	out.i = computed;
	out.s.clear();
	format(out.s, "memoized elements count: ", computed);
	out
}
@end
