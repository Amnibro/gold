fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var modified = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] > lim {
			g.res[idx] = lim;
			modified++;
		}
		idx--;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " items in reverse window");
	out
}
@end
