code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
		}
		if !is_sq {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " non square values");
	out
}
