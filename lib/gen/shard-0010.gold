noun: window
modifier: running
context: retry
phrase: scan window running average span {span}
phrase: compute running window average with width {span}
slot: span int
test: list=10,20,30,40,50 span=3
expect: => i=3 r=0.0 ok=true s="scanned window running count 3" errors=0 n=8 res=[10,20,30,40,50,20,30,40] cache=0 hits=0
test: list=4,8,12,16 span=2
expect: => i=3 r=0.0 ok=true s="scanned window running count 3" errors=0 n=7 res=[4,8,12,16,6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${span};
	if w <= 0 || g.n < w {
		gold_fail(g, "window span invalid or exceeds count");
		out.ok = false;
		return out;
	}
	var count = 0;
	for i in (g.n - w + 1) {
		var s = 0;
		for k in w {
			s += g.res[i + k];
		}
		gold_push(g, s / w);
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned window running count ", count);
	out
}
@end
