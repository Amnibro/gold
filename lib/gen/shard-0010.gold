@entry f7f8c45f8e063f6b
kind: step
verb: find
noun: window
modifier: sorted
context: list
phrase: find sorted window of length {len}
phrase: locate sorted subarray of size {len}
slot: len int
test: list=8,3,5,1 len=3
expect: => i=3 r=0.0 ok=true s="sorted window of 3 items" errors=0 n=4 res=[3,5,8,1] cache=0 hits=0
test: list=20,10,30 len=2
expect: => i=2 r=0.0 ok=true s="sorted window of 2 items" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${len};
	let bound = if l < g.n { l } else { g.n };
	for i in bound {
		var min_idx = i;
		for j in (i + 1)..bound {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += bound * bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted window of ", bound, " items");
	out
}
@end
