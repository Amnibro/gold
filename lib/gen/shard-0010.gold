fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var modified = 0;
	for i in g.n {
		let c = g.res[i];
		var is_v = false;
		if c == 65 || c == 69 || c == 73 || c == 79 || c == 85 { is_v = true; }
		else if c == 97 || c == 101 || c == 105 || c == 111 || c == 117 { is_v = true; }
		if is_v && c > limit {
			g.res[i] = limit;
			modified++;
		}
	}
	g.steps += modified;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped vowels count: ", modified);
	out
}
@end
