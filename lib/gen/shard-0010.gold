fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var counts = [0, 0, 0, 0, 0];
	for i in g.n {
		var rem = g.res[i] % 5;
		if rem < 0 { rem += 5; }
		counts[rem]++;
	}
	counts[0] += d;
	gold_clear(g);
	for c in 5 { gold_push(g, counts[c]); }
	g.steps += 5;
	out.i = counts[0];
	out.s.clear();
	format(out.s, "shifted first bin to ", counts[0]);
	out
}
