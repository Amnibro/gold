@entry 8e878712d58e041a
kind: step
verb: check
noun: histogram
modifier: at_most
context: cache
phrase: check histogram at most frequency {max_freq}
phrase: verify histogram counts at most ceiling {max_freq}
slot: max_freq int
test: list=1,2,2,3,4 max_freq=2
expect: => i=2 r=0.0 ok=true s="histogram verified with peak frequency 2" errors=0 n=5 res=[1,2,2,3,4] cache=4 hits=1
test: list=5,5,5,5 max_freq=2
expect: => i=0 r=0.0 ok=false s="error: frequency 4 exceeds limit" errors=1 n=4 res=[5,5,5,5] cache=1 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	var peak_freq = 0;
	for i in g.n {
		let x = g.res[i];
		let cnt, found = gold_cache_get(g, x);
		let new_cnt = if found { cnt + 1 } else { 1 };
		gold_cache_put(g, x, new_cnt);
		if new_cnt > peak_freq {
			peak_freq = new_cnt;
		}
	}
	if peak_freq > mf {
		gold_fail(g, "frequency ceiling exceeded");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: frequency ", peak_freq, " exceeds limit");
	} else {
		out.i = peak_freq;
		out.s.clear();
		format(out.s, "histogram verified with peak frequency ", peak_freq);
	}
	g.steps += g.n;
	out
}
@end
