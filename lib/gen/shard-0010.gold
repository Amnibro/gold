@entry 7af29d8db27e74d0
kind: step
verb: dedupe
noun: limit
modifier: unique
context: sort
phrase: dedupe sorted list retaining at most {limit} unique values
phrase: preserve at most {limit} unique elements from sorted results
slot: limit int
test: list=1,1,2,2,3,3,4 limit=2
expect: => i=2 r=0.0 ok=true s="retained 2 unique elements" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=5,5,6,7,7,8 limit=3
expect: => i=3 r=0.0 ok=true s="retained 3 unique elements" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let is_dup = kept > 0 && g.res[i] == g.res[kept - 1];
		if !is_dup && kept < lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " unique elements");
	out
}
@end
@entry 5bc9504c25e2fdab
kind: step
verb: join
noun: sequence
modifier: times
context: sort
phrase: join sorted sequence pairs across {times} times
phrase: condense adjacent elements in sorted sequence {times} times
slot: times int
test: list=2,4,6,8 times=1
expect: => i=6 r=0.0 ok=true s="joined sequence head 6" errors=0 n=2 res=[6,14] cache=0 hits=0
test: list=1,3,5,7,9,11 times=2
expect: => i=16 r=0.0 ok=true s="joined sequence head 16" errors=0 n=2 res=[16,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for round in t {
		if g.n < 2 { break; }
		let pairs = g.n / 2;
		for i in pairs {
			g.res[i] = g.res[i * 2] + g.res[i * 2 + 1];
		}
		if g.n % 2 != 0 {
			g.res[pairs] = g.res[g.n - 1];
			g.n = pairs + 1;
		} else {
			g.n = pairs;
		}
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "joined sequence head ", g.res[0]);
	out
}
@end
