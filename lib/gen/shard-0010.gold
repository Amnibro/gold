@entry 54d03169926a91ec
kind: step
verb: reverse
noun: loop
modifier: recursively
context: aggregate
phrase: reverse loop recursively for total passes {passes}
phrase: cycle reverse loop recursively count {passes}
slot: passes int
test: list=1,2,3,4 passes=1
expect: => i=4 r=0.0 ok=true s="reversed loop passes done 1" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=10,20,30 passes=2
expect: => i=10 r=0.0 ok=true s="reversed loop passes done 2" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	for k in p {
		for i in (g.n / 2) {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
		}
	}
	g.steps += g.n * p;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "reversed loop passes done ", p);
	out
}
@end
