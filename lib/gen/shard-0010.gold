fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var max_val = -999999;
	var found = false;
	for i in g.n {
		if g.res[i] <= ceiling && g.res[i] > max_val {
			max_val = g.res[i];
			found = true;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	if found {
		out.i = max_val;
		format(out.s, "maximum up to ceiling is ", max_val);
	} else {
		gold_fail(g, "no element under ceiling");
		out.i = -1;
		out.s.append("no element under ceiling");
	}
	out
}
