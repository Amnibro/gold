code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	if mc <= 0 {
		gold_fail(g, "non positive letter minimum count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid letter bound ", mc);
		return out;
	}
	var letters = 0;
	for i in out.s.len {
		let c = out.s[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
			letters++;
		}
	}
	g.steps += out.s.len;
	let valid = letters >= mc;
	out.ok = valid;
	out.i = letters;
	out.s.clear();
	if valid {
		format(out.s, "grouped ", letters, " letters satisfying at least ", mc);
	} else {
		gold_fail(g, "letter count below required minimum");
		out.ok = false;
		format(out.s, "error: found ", letters, " letters below min ", mc);
	}
	out
}
@end
