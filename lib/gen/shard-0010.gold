	var found = false;
	for i in g.n {
		if ${cond}(g.res[i]) {
			found_val = g.res[i];
			found = true;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = found_val;
	out.s.clear();
	if found {
		format(out.s, "found matching number: ", found_val);
	} else {
		gold_fail(g, "no number matched predicate");
		out.ok = false;
		format(out.s, "error: zero matches for condition");
	}
	out
}
@end
