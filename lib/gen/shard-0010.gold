fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n < 2 { return out; }
	let k = s % g.n;
	if k == 0 { return out; }
	var temp int[512] = [0; 512];
	for i in g.n {
		temp[i] = g.res[(i + k) % g.n];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated sequence by offset ", k);
	out
}
@end
