slot: thresh int
test: list=2,15,4,20 thresh=10
expect: => i=15 r=0.0 ok=true s="repeated first item exceeding threshold: 15" errors=0 n=5 res=[2,15,4,20,15] cache=0 hits=0
test: list=50,1,2 thresh=25
expect: => i=50 r=0.0 ok=true s="repeated first item exceeding threshold: 50" errors=0 n=4 res=[50,1,2,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var found = false;
	var val = 0;
	for k in g.n {
		if g.res[k] > t {
			found = true;
			val = g.res[k];
			break;
		}
	}
	if found {
		gold_push(g, val);
		out.i = val;
		out.s.clear();
		format(out.s, "repeated first item exceeding threshold: ", val);
	} else {
		out.i = 0;
		out.s.clear();
		out.s.append("no item exceeded threshold");
	}
	g.steps += g.n;
	out
}
@end
