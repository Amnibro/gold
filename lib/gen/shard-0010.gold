code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var total = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			total += g.res[i];
			count++;
		}
	}
	g.res[0] = total;
	g.n = 1;
	gold_cache_put(g, lo, total);
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "joined steps between bounds to ", total);
	out
}
@end
