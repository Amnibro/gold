expect: => i=3 r=0.0 ok=true s="sorted items under threshold: 3" errors=0 n=5 res=[1,3,9,15,20] cache=0 hits=0
test: list=40,10,25 threshold=30
expect: => i=2 r=0.0 ok=true s="sorted items under threshold: 2" errors=0 n=3 res=[10,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var count = 0;
	for i in g.n {
		if g.res[i] <= th { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted items under threshold: ", count);
	out
}
@end
