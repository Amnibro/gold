test: list=15,28,42
expect: => i=3 r=0.0 ok=true s="merged digits for 3 items" errors=0 n=3 res=[6,10,6] cache=3 hits=0
test: list=9,99,999
expect: => i=3 r=0.0 ok=true s="merged digits for 3 items" errors=0 n=3 res=[9,18,27] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		let neg = x < 0;
		if neg { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		g.res[i] = if neg { -s } else { s };
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "merged digits for ", g.n, " items");
	out
}
@end
