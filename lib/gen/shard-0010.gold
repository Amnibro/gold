expect: => i=3 r=0.0 ok=true s="applied sliding window across 3 steps" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3 window_sz=-1 cond=is_even
expect: => i=0 r=0.0 ok=false s="error: invalid window size -1" errors=1 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wsz = ${window_sz};
	if wsz <= 0 || g.n < wsz {
		gold_fail(g, "invalid window size for loop apply");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid window size ", wsz);
		return out;
	}
	var windows_passed = 0;
	var i = 0;
	while i + wsz <= g.n {
		var all_ok = true;
		for k in wsz {
			if !${cond}(g.res[i + k]) {
				all_ok = false;
				break;
			}
		}
		if !all_ok { break; }
		windows_passed++;
		i++;
	}
	g.steps += g.n;
	out.i = windows_passed;
	out.s.clear();
	format(out.s, "applied sliding window across ", windows_passed, " steps");
	out
}
@end
@entry b6f419d3263a93f3
kind: step
verb: compare
noun: digits
modifier: sorted
context: loop
phrase: compare digits sorted verifying monotonic increase
phrase: check digits in text confirming sorted ascending order
test: text="12489"
expect: => i=9 r=0.0 ok=true s="verified digits sorted in text" errors=0 n=0 res=[] cache=0 hits=0
test: text="153"
expect: => i=5 r=0.0 ok=false s="error: digits not sorted" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text buffer for sorted digits check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text");
		return out;
	}
	var is_sorted = true;
	var last_digit = -1;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			if last_digit >= 0 && d < last_digit {
				is_sorted = false;
				break;
			}
			last_digit = d;
		}
	}
	g.steps += out.s.len;
	out.ok = is_sorted;
	out.i = last_digit;
	out.s.clear();
	if is_sorted {
		format(out.s, "verified digits sorted in text");
	} else {
		gold_fail(g, "digits out of sorted order");
		out.ok = false;
		format(out.s, "error: digits not sorted");
	}
	out
}
@end
