		var is_alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
		if is_alpha {
			temp[kept] = c;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept alphabetic letters count: ", kept);
	out
}
@end
@entry a48b523b92668789
kind: step
verb: fill
noun: step
modifier: pairwise
context: filter
phrase: fill step pairwise gaps inserting midpoint when delta exceeds {max_step}
phrase: filter pairwise step differences filling gaps over {max_step}
slot: max_step int
test: list=10,30,40 max_step=15
expect: => i=4 r=0.0 ok=true s="pairwise filled count: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,12,24 max_step=8
expect: => i=5 r=0.0 ok=true s="pairwise filled count: 5" errors=0 n=5 res=[2,7,12,18,24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let limit = ${max_step};
	var temp int[512] = [0; 512];
	var count = 0;
	for i in (g.n - 1) {
		temp[count] = g.res[i];
		count++;
		let diff = g.res[i + 1] - g.res[i];
		if diff > limit && count < 500 {
			temp[count] = (g.res[i] + g.res[i + 1]) / 2;
			count++;
		}
	}
	temp[count] = g.res[g.n - 1];
	count++;
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise filled count: ", count);
	out
}
@end
