fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${finish};
	if s <= e {
		var cur = s;
		while cur <= e && g.n < 512 {
			gold_push(g, ${f}(cur));
			cur++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled subfunction between range, total ", g.n);
	out
}
