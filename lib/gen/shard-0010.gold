fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top = ${ceiling};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var last_val = g.res[g.n - 1];
	if last_val > top {
		last_val = top;
		g.res[g.n - 1] = top;
	}
	out.i = last_val;
	out.s.clear();
	format(out.s, "clamped last=", last_val);
	out
}
@end
