code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_len = out.s.len;
	if s_len < 2 { return out; }
	gold_clear(g);
	var i = 0;
	while i + 1 < s_len {
		let code = out.s[i] as int + out.s[i + 1] as int;
		gold_push(g, code);
		i += 2;
	}
	out.s.append(${sep});
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
