@entry e07da89e1abf02fd
kind: step
verb: drop
noun: odds
modifier: running
context: loop
phrase: drop odds running loop sequence removing odd values
phrase: filter out running odd elements across loop results
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="dropped 3 running odds in loop" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,3,5
expect: => i=3 r=0.0 ok=false s="error: zero evens retained" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for drop odds running");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var dropped = 0;
	var write_idx = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	if g.n == 0 {
		gold_fail(g, "all running odds dropped");
		out.ok = false;
		format(out.s, "error: zero evens retained");
	} else {
		format(out.s, "dropped ", dropped, " running odds in loop");
	}
	out
}
@end
