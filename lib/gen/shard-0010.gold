code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	for i in g.n {
		let diff = if g.res[i] >= last_val { g.res[i] - last_val } else { last_val - g.res[i] };
		g.res[i] = diff;
	}
	out.i = last_val;
	out.s.clear();
	format(out.s, "mapped from last ", last_val);
	g.steps += g.n + 1;
	out
}
@end
