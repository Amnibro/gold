code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget_cap};
	var running = 0;
	var count = 0;
	while count < g.n && running + g.res[count] <= cap {
		running += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = running;
	out.s.clear();
	format(out.s, "budget items sum: ", running);
	out
}
@end
@entry 7d131f1d817029fd
kind: step
verb: clamp
noun: budget
modifier: none
context: core
phrase: clamp budget none exceeding limit {cap}
phrase: restrict budget total without modifying list {cap}
phrase: bound budget sum to ceiling {cap}
slot: cap int
test: list=20,30,40 cap=50
expect: => i=50 r=0.0 ok=true s="budget clamped to 50" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=10,15 cap=50
expect: => i=25 r=0.0 ok=true s="budget within 25" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top = ${cap};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	out.s.clear();
	if total > top {
		out.i = top;
		format(out.s, "budget clamped to ", top);
	} else {
		out.i = total;
		format(out.s, "budget within ", total);
	}
	g.steps += g.n;
	out
}
@end
