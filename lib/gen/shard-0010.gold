expect: => i=3 r=0.0 ok=true s="selected 3 scaled squares" errors=0 n=3 res=[18,32,50] cache=0 hits=0
test: list=4,8,36 factor=3
expect: => i=2 r=0.0 ok=true s="selected 2 scaled squares" errors=0 n=2 res=[12,108] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[kept] = x * f;
				kept++;
			}
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " scaled squares");
	g.steps += g.n + 1;
	out
}
@end
