phrase: trim duplicate series values up to limit {limit}
slot: limit int
test: list=4,4,4,4,8,8 limit=2
expect: => i=2 r=0.0 ok=true s="deduped series removing 2 items" errors=0 n=4 res=[4,4,8,8] cache=0 hits=0
test: list=1,1,1,3,3 limit=1
expect: => i=3 r=0.0 ok=true s="deduped series removing 3 items" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		var cnt = 0;
		for j in kept {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt < lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped series removing ", removed, " items");
	out
}
@end
