@entry 79caef0c476068f2
kind: step
verb: normalize
noun: cache
modifier: times
context: filter
phrase: normalize cache looking up items at least {reps} times
phrase: filter cached elements repeated at least {reps} times
slot: reps int
test: list=2,2,3,4,4,4 reps=2
expect: => i=2 r=0.0 ok=true s="cached frequent items count: 2" errors=0 n=2 res=[2,4] cache=2 hits=0
test: list=10,20,20,30 reps=1
expect: => i=3 r=0.0 ok=true s="cached frequent items count: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${reps};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq >= limit {
			gold_cache_put(g, x, freq);
			var seen = false;
			for k in kept { if temp[k] == x { seen = true; break; } }
			if !seen {
				temp[kept] = x;
				kept++;
			}
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "cached frequent items count: ", kept);
	out
}
@end
