fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k_items};
	if k < g.n && k >= 0 {
		let start = g.n - k;
		for i in k {
			g.res[i] = g.res[start + i];
		}
		g.n = k;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "tail kept count ", g.n);
	out
}
@end
