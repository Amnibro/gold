	g.n = write_idx;
	g.steps += g.n;
	out.i = odd_count;
	out.s.clear();
	if odd_count == 0 {
		gold_fail(g, "no odd numbers found in sequence");
		out.ok = false;
		format(out.s, "error: zero odds in results");
	} else {
		format(out.s, "found and retained ", odd_count, " odd items in place");
	}
	out
}
@end
