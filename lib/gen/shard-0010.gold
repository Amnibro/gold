code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	let mid = if g.n > 2 { g.n - 2 } else { 0 };
	let total = mid * r;
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "middle collected ", r, " times: ", total);
	out
}
@end
