@entry a56775c20d826add
kind: step
verb: limit
noun: duplicates
modifier: in_reverse
context: format
phrase: format sequence in reverse limiting duplicates to {max_dupes}
phrase: render backward results capping duplicate occurrences at {max_dupes}
slot: max_dupes int
test: list=1,1,1,2,2 max_dupes=1
expect: => i=2 r=0.0 ok=true s="reverse limited duplicates: 2 items" errors=0 n=2 res=[2,1] cache=0 hits=0
test: list=10,10,20,20,20 max_dupes=2
expect: => i=4 r=0.0 ok=true s="reverse limited duplicates: 4 items" errors=0 n=4 res=[20,20,10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dupes};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[g.n - 1 - i];
		var seen = 0;
		for j in kept {
			if temp[j] == x { seen++; }
		}
		if seen < md {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reverse limited duplicates: ", kept, " items");
	out
}
@end
