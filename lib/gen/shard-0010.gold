phrase: discard leading loop items up to {max_steps} steps
test: list=10,20,30,40,50 max_steps=2
expect: => i=2 r=0.0 ok=true s="dropped 2 leading items up to bound 2" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=10,20 max_steps=-1
expect: => i=0 r=0.0 ok=false s="error: invalid step count -1" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_steps};
	if ms <= 0 || g.n == 0 {
		gold_fail(g, "invalid step bound for drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid step count ", ms);
		return out;
	}
	let to_drop = if ms > g.n { g.n } else { ms };
	let rem = g.n - to_drop;
	for i in rem {
		g.res[i] = g.res[to_drop + i];
	}
	g.n = rem;
	g.steps += to_drop;
	out.i = to_drop;
	out.s.clear();
	format(out.s, "dropped ", to_drop, " leading items up to bound ", ms);
	out
}
@end
@entry 10bfbf6130bfabb6
kind: step
verb: limit
noun: value
modifier: unique
context: loop
slot: target int
phrase: limit value unique occurrence of {target} in results
phrase: ensure value {target} appears at most once in loop
test: list=2,5,2,8,2 target=2
expect: => i=2 r=0.0 ok=true s="limited value to unique entry dropping 2 duplicates" errors=0 n=3 res=[2,5,8] cache=0 hits=0
test: list=1,3 target=2
expect: => i=0 r=0.0 ok=true s="target value not present" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results for unique value limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var seen = false;
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] == tgt {
			if !seen {
				seen = true;
				g.res[write_idx] = g.res[i];
				write_idx++;
			} else {
				dropped++;
			}
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	if !seen {
		format(out.s, "target value not present");
	} else {
		format(out.s, "limited value to unique entry dropping ", dropped, " duplicates");
	}
	out
}
@end
