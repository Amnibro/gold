@entry c96b7c5117ac56b5
kind: step
verb: measure
noun: spaces
modifier: every_other
context: compare
phrase: measure spaces every_other stride {stride}
phrase: compare alternating spaces using stride {stride}
slot: stride int
test: list=1,5,10,20,35 stride=1
expect: => i=14 r=0.0 ok=true s="measured alternating spaces sum 14" errors=0 n=5 res=[1,5,10,20,35] cache=0 hits=0
test: list=2,10,12,30 stride=2
expect: => i=52 r=0.0 ok=true s="measured alternating spaces sum 52" errors=0 n=4 res=[2,10,12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if g.n < 2 { return out; }
	var space_sum = 0;
	var count = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		space_sum += diff * st;
		count++;
		i += 2;
	}
	g.steps += count;
	out.i = space_sum;
	out.s.clear();
	format(out.s, "measured alternating spaces sum ", space_sum);
	out
}
@end
