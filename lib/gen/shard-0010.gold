@entry 6f111bf45a801743
kind: step
verb: run
noun: budget
modifier: sorted
context: text
phrase: run character budget sorting frequencies
phrase: compute char code frequencies sorted
test: text="banana"
expect: => i=3 r=0.0 ok=true s="banana" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: text="mississippi"
expect: => i=4 r=0.0 ok=true s="mississippi" errors=0 n=4 res=[1,2,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var counts int[26] = [0; 26];
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			counts[(b - 'a') as! int]++;
		}
	}
	for i in 26 {
		if counts[i] > 0 {
			gold_push(g, counts[i]);
		}
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out
}
@end
