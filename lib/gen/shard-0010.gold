noun: head
modifier: until
context: retry
phrase: sort retry head until predicate {p}
phrase: order leading retry items until condition {p}
phrase: sort initial retry results until {p}
slot: p pred
test: list=9,3,7,2,8,4 p=is_even
expect: => i=3 r=0.0 ok=true s="sorted head of 3 retry items" errors=0 n=6 res=[3,7,9,2,8,4] cache=0 hits=0
