context: search
phrase: shift window until window of size {win_size} reaches {target}
phrase: slide search window of size {win_size} matching sum {target}
slot: win_size int
slot: target int
test: list=1,2,3,4,5 win_size=2 target=5
expect: => i=1 r=0.0 ok=true s="window match index: 1" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 win_size=2 target=50
expect: => i=1 r=0.0 ok=true s="window match index: 1" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	let t = ${target};
	if w <= 0 || g.n < w { return out; }
	var match_idx = -1;
	for i in 0..(g.n - w + 1) {
		var win_sum = 0;
		for j in 0..w {
			win_sum += g.res[i + j];
		}
		if win_sum == t {
			match_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = match_idx;
	out.s.clear();
	format(out.s, "window match index: ", match_idx);
	out
}
@end
