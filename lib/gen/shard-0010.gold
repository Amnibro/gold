fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 0;
	var i = 0;
	while i < g.n && ${cond}(g.res[i]) {
		streak++;
		i++;
	}
	let clamped = if streak > 3 { 3 } else { streak };
	g.n = clamped;
	g.steps += streak;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped streak of ", streak, " to ", clamped);
	out
}
@end
