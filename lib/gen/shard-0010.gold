code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	gold_clear(g);
	var w = 0;
	for i in out.s.len {
		if out.s[i] != ' ' { w++; }
		else {
			if w > 0 {
				var val = w;
				for step in d { val = ${f}(val); }
				gold_push(g, val);
				w = 0;
			}
		}
	}
	if w > 0 {
		var val = w;
		for step in d { val = ${f}(val); }
		gold_push(g, val);
	}
	g.steps += out.s.len * d;
	out.i = g.n;
	out
}
@end
