	let mr = ${max_runs};
	if mr <= 0 || g.n == 0 {
		gold_fail(g, "invalid run count or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid run count ", mr);
		return out;
	}
	var total = 0;
	var runs_seen = 0;
	var i = 0;
	while i < g.n && runs_seen < mr {
		let val = g.res[i];
		while i < g.n && g.res[i] == val {
			total += val;
			i++;
		}
		runs_seen++;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum of ", runs_seen, " runs at most: ", total);
	out
}
@end
