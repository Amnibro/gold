fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = -v;
	}
	if v < 10 {
		return v;
	}
	var rev = 0;
	while v > 0 {
		rev = rev * 10 + (v % 10);
		v /= 10;
	}
	var res = 0;
	var last = -1;
	while rev > 0 {
		var d = rev % 10;
		if d != last {
			res = res * 10 + d;
			last = d;
		}
		rev /= 10;
	}
	return res;
}
@end
