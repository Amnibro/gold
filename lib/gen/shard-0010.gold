fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bench = ${benchmark};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let passes = avg >= bench;
	g.steps += g.n;
	out.ok = passes;
	out.i = avg;
	out.s.clear();
	format(out.s, "average check status ", passes);
	out
}
@end
