code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let num_cycles = ${cycles};
	if num_cycles % 2 != 0 {
		for i in (g.n / 2) {
			let mirror = g.res[i];
			g.res[i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = mirror;
		}
	}
	g.steps += g.n;
	out.i = num_cycles;
	out.s.clear();
	format(out.s, "reversal cycles completed: ", num_cycles);
	out
}
@end
