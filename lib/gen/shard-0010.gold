expect: => i=3 r=0.0 ok=true s="aligned checkpoint count: 3" errors=0 n=3 res=[12,24,36] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var aligned = 0;
	for i in g.n {
		let rem = g.res[i] % s;
		if rem == 0 { aligned++; }
		else { g.res[i] = (g.res[i] / s) * s; }
	}
	gold_cache_put(g, s, aligned);
	g.steps += g.n;
	out.i = aligned;
	out.s.clear();
	format(out.s, "aligned checkpoint count: ", aligned);
	out
}
@end
