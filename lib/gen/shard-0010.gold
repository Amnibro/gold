expect: => i=0 r=0.0 ok=false s="error: no evens below bound 10" errors=1 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	if g.n == 0 {
		gold_fail(g, "empty results for sum evens while");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var total = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= mv { break; }
		if g.res[i] % 2 == 0 {
			total += g.res[i];
			count++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	if count == 0 {
		gold_fail(g, "zero evens met while bound");
		out.ok = false;
		format(out.s, "error: no evens below bound ", mv);
	} else {
		format(out.s, "summed ", count, " evens while under bound: ", total);
	}
	out
}
@end
