code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	for i in g.n {
		var off = 0;
		while off < r {
			g.res[i] += 1;
			off++;
		}
	}
	g.steps += g.n * r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted with retry limit ", r);
	out
}
@end
@entry b3227707f2edcd8f
kind: step
verb: split
noun: threshold
modifier: in_reverse
context: list
phrase: split list at threshold {thresh} in reverse
phrase: partition list from threshold {thresh} backwards
slot: thresh int
test: list=2,4,8,16 thresh=10
expect: => i=1 r=0.0 ok=true s="split in reverse at 1 items" errors=0 n=1 res=[16] cache=0 hits=0
test: list=1,3,9,27 thresh=15
expect: => i=1 r=0.0 ok=true s="split in reverse at 1 items" errors=0 n=1 res=[27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	var cut = g.n;
	for i in g.n {
		if g.res[i] >= th { cut = i + 1; break; }
	}
	g.n = cut;
	g.steps += g.n;
	out.i = cut;
	out.s.clear();
	format(out.s, "split in reverse at ", cut, " items");
	out
}
@end
@entry d6198781dbbd902e
kind: step
verb: run
noun: duplicates
modifier: until
context: list
phrase: run duplicate detection until limit {limit}
phrase: scan list duplicates until reaching limit {limit}
slot: limit int
test: list=2,2,3,3,4,4 limit=2
expect: => i=2 r=0.0 ok=true s="ran duplicates until count 2" errors=0 n=7 res=[2,2,3,3,4,4,2] cache=0 hits=0
test: list=5,5,5,10 limit=1
expect: => i=1 r=0.0 ok=true s="ran duplicates until count 1" errors=0 n=5 res=[5,5,5,10,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dups = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] {
				dups++;
				if dups >= lim { break; }
			}
		}
	}
	gold_push(g, dups);
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "ran duplicates until count ", dups);
	out
}
@end
@entry afdd7058601066e7
kind: step
verb: drop
noun: average
modifier: unique
context: list
phrase: drop elements below unique average
phrase: remove items under average of unique values
test: list=2,2,8,8,10
expect: => i=3 r=0.0 ok=true s="dropped below unique avg, kept 3" errors=0 n=3 res=[8,8,10] cache=0 hits=0
test: list=1,5,5,9
expect: => i=3 r=0.0 ok=true s="dropped below unique avg, kept 3" errors=0 n=3 res=[5,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var uniq int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		var seen = false;
		for j in un { if uniq[j] == g.res[i] { seen = true; break; } }
		if !seen { uniq[un] = g.res[i]; un++; }
	}
	var u_sum = 0;
	for j in un { u_sum += uniq[j]; }
	let avg = u_sum / un;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= avg { g.res[kept] = g.res[i]; kept++; }
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "dropped below unique avg, kept ", kept);
	out
}
@end
@entry fab4cd7ff2a13673
kind: step
verb: limit
noun: range
modifier: with_cache
context: list
phrase: limit range bounds looking up in cache
phrase: clamp list range using cached boundaries
test: list=5,15,25,35
expect: => i=4 r=0.0 ok=true s="limited range with cache for 4 items" errors=0 n=4 res=[10,15,25,30] cache=2 hits=0
test: list=2,8,20,50
expect: => i=4 r=0.0 ok=true s="limited range with cache for 4 items" errors=0 n=4 res=[10,10,20,30] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_b, has_min = gold_cache_get(g, 0);
	if !has_min { min_b = 10; gold_cache_put(g, 0, min_b); }
	var max_b, has_max = gold_cache_get(g, 1);
	if !has_max { max_b = 30; gold_cache_put(g, 1, max_b); }
	for i in g.n {
		if g.res[i] < min_b { g.res[i] = min_b; }
		if g.res[i] > max_b { g.res[i] = max_b; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited range with cache for ", g.n, " items");
	out
}
@end
