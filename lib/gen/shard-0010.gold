code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n > 1 {
		let k = t % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated loop range ", t, " times");
	out
}
@end
