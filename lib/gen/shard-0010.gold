@entry bef8d1ab02f9c386
kind: step
verb: scale
noun: maximum
modifier: until
context: stats
phrase: scale maximum with factor {factor} until cap {cap}
phrase: multiply peak value by {factor} until {cap}
phrase: boost maximum using factor {factor} until reaching {cap}
slot: factor int
slot: cap int
test: list=5,12,8 factor=2 cap=50
expect: => i=96 r=0.0 ok=true s="scaled max 3 iterations" errors=0 n=4 res=[5,96,8,3] cache=0 hits=0
test: list=10,3,7 factor=3 cap=80
expect: => i=90 r=0.0 ok=true s="scaled max 2 iterations" errors=0 n=4 res=[90,3,7,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let target = ${cap};
	if g.n == 0 || f <= 1 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for i in g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var cur = g.res[max_idx];
	var count = 0;
	while cur < target && count < 20 {
		cur *= f;
		count++;
	}
	g.res[max_idx] = cur;
	out.i = cur;
	out.s.clear();
	format(out.s, "scaled max ", count, " iterations");
	gold_push(g, count);
	g.steps += count + 1;
	out
}
@end
