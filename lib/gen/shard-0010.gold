@entry c753192ca50567a1
kind: step
verb: fill
noun: primes
modifier: each
context: loop
slot: count int
phrase: fill primes each prime number up to count {count}
phrase: append list of prime numbers taking count {count}
test: count=4
expect: => i=4 r=0.0 ok=true s="filled 4 prime numbers into results" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: count=-1
expect: => i=0 r=0.0 ok=false s="error: invalid prime count -1" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	if cnt <= 0 || cnt > 20 {
		gold_fail(g, "invalid prime count to fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid prime count ", cnt);
		return out;
	}
	var candidate = 2;
	var added = 0;
	while added < cnt && g.n < 500 {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, candidate);
			added++;
		}
		candidate++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "filled ", added, " prime numbers into results");
	out
}
@end
