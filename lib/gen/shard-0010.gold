fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged_evens = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 == 0 {
			g.res[i + 1] += g.res[i];
			merged_evens++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = merged_evens;
	out.s.clear();
	format(out.s, "merged even elements: ", merged_evens);
	out
}
