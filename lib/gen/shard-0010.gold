		let b = g.res[i + 1];
		if a % 2 == 0 && b % 2 == 0 {
			g.res[count] = a + b;
			count++;
		}
		i += 2;
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "even pair sums count ", count);
	out
}
@end
