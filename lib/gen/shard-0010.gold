slot: target_mean int
test: list=10,20,30 target_mean=25
expect: => i=45 r=0.0 ok=true s="adjusted last to 45" errors=0 n=4 res=[10,20,45,45] cache=0 hits=0
test: list=5,15,40 target_mean=30
expect: => i=70 r=0.0 ok=true s="adjusted last to 70" errors=0 n=4 res=[5,15,70,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tm = ${target_mean};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var prefix_sum = 0;
	for i in g.n - 1 {
		prefix_sum += g.res[i];
	}
	let required_last = tm * g.n - prefix_sum;
	g.res[g.n - 1] = required_last;
	out.i = required_last;
	out.s.clear();
	format(out.s, "adjusted last to ", required_last);
	gold_push(g, required_last);
	g.steps += g.n + 1;
	out
}
@end
