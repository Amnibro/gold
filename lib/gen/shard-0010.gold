slot: cap int
test: list=2,4,6,8 cap=4
expect: => i=4 r=0.0 ok=true s="swapped evens boundary 4" errors=0 n=4 res=[4,2,8,6] cache=0 hits=0
test: list=10,20,30,40 cap=3
expect: => i=3 r=0.0 ok=true s="swapped evens boundary 3" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var limit = if c < g.n { c } else { g.n };
	var i = 0;
	while i + 1 < limit {
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "swapped evens boundary ", limit);
	out
}
@end
