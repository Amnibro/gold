code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped to ", kept, " unique errors");
	out
}
@end
