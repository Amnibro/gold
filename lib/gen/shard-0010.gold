fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need multiple items to fill alternating minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list length under two");
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var replaced = 0;
	var i = 0;
	while i < g.n {
		g.res[i] = min_val;
		replaced++;
		i += 2;
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "filled alternating minimum ", min_val, " into ", replaced, " positions");
	out
}
@end
@entry 4d6fa7dcac085321
kind: step
verb: drop
noun: primes
modifier: first
context: loop
phrase: drop primes first occurrence of prime number in sequence
phrase: remove initial prime element found in loop results
test: list=4,6,7,9,11
expect: => i=7 r=0.0 ok=true s="dropped first prime element 7" errors=0 n=4 res=[4,6,9,11] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="error: zero primes found" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for drop primes first");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var prime_idx = -1;
	for i in g.n {
		let x = g.res[i];
		let is_p = x == 2 || x == 3 || x == 5 || x == 7 || x == 11 || x == 13;
		if is_p {
			prime_idx = i;
			break;
		}
	}
	if prime_idx >= 0 {
		let p_val = g.res[prime_idx];
		for i in (prime_idx + 1)..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.n--;
		g.steps += g.n;
		out.i = p_val;
		out.s.clear();
		format(out.s, "dropped first prime element ", p_val);
	} else {
		gold_fail(g, "no prime numbers found in sequence");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero primes found");
	}
	out
}
@end
