code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${peak};
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var cur = g.res[max_idx];
	var count = 0;
	while cur < target {
		cur++;
		count++;
	}
	g.res[max_idx] = cur;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "steps to reach peak ", count);
	out
}
@end
