fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ceil_val {
			g.res[i] = ceil_val;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " numbers in place");
	out
}
