test: limit=5
expect: => i=5 r=0.0 ok=true s="filled 5 alternating primes" errors=0 n=5 res=[2,5,11,17,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cand = 2;
	var prime_idx = 0;
	while g.n < lim && g.n < 512 {
		var is_p = true;
		var d = 2;
		while d * d <= cand {
			if cand % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if prime_idx % 2 == 0 {
				gold_push(g, cand);
			}
			prime_idx++;
		}
		cand++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "filled ", g.n, " alternating primes");
	out
}
@end
