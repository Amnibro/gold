fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best_start = 0;
	var best_len = 0;
	var cur_start = 0;
	var cur_len = 0;
	for i in g.n {
		if ${test_pred}(g.res[i]) {
			if cur_len == 0 { cur_start = i; }
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_len = 0;
		}
	}
	var temp int[512] = [0; 512];
	for i in best_len {
		temp[i] = g.res[best_start + i];
	}
	for i in best_len { g.res[i] = temp[i]; }
	g.n = best_len;
	g.steps += g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "found matching streak length: ", best_len);
	out
}
@end
