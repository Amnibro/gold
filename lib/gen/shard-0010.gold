code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var buf int[512] = [0; 512];
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		buf[new_n] = if diff < 0 { -diff } else { diff };
		new_n++;
	}
	for i in new_n { g.res[i] = buf[i]; }
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "traced ", new_n, " pairwise differences");
	out
}
@end
