fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for reverse search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	var found_val = -1;
	var found = false;
	var i = g.n - 1;
	while i >= 0 {
		if ${cond}(g.res[i]) {
			found_val = g.res[i];
			found = true;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.ok = found;
	out.i = found_val;
	out.s.clear();
	if found {
		format(out.s, "found matching number in reverse: ", found_val);
	} else {
		gold_fail(g, "predicate not satisfied in reverse");
		out.ok = false;
		format(out.s, "error: no match in reverse");
	}
	out
}
@end
@entry aa0cbb76a21087c5
kind: step
verb: normalize
noun: pairs
modifier: at_least
context: retry
slot: min_diff int
phrase: normalize pairs requiring at least difference {min_diff}
phrase: adjust pair differences to at least {min_diff}
test: list=10,12,20 min_diff=5
expect: => i=1 r=0.0 ok=true s="normalized 1 pairs to meet minimum difference 5" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1 min_diff=5
expect: => i=0 r=0.0 ok=false s="error: invalid normalize pairs config" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_diff};
	if g.n < 2 || md <= 0 {
		gold_fail(g, "insufficient items or invalid pair difference bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid normalize pairs config");
		return out;
	}
	var adjusted = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff < md {
			g.res[i] = g.res[i - 1] + md;
			adjusted++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "normalized ", adjusted, " pairs to meet minimum difference ", md);
	out
}
@end
@entry cee91a88840cb06a
kind: step
verb: run
noun: odds
modifier: while
context: retry
slot: max_val int
phrase: run odds while value remains under {max_val}
phrase: collect odd numbers while bounded by {max_val}
test: list=1,3,5,12,7 max_val=10
expect: => i=3 r=0.0 ok=true s="retained 3 odds while under 10" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=15,20 max_val=10
expect: => i=0 r=0.0 ok=false s="error: zero odds found under bound 10" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	if g.n == 0 {
		gold_fail(g, "empty results for odds while");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var write_idx = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		if val >= mv { break; }
		if val % 2 != 0 {
			g.res[write_idx] = val;
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	if write_idx == 0 {
		gold_fail(g, "no odd numbers met bound");
		out.ok = false;
		format(out.s, "error: zero odds found under bound ", mv);
	} else {
		format(out.s, "retained ", write_idx, " odds while under ", mv);
	}
	out
}
@end
