fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target} * ${factor};
	var found = false;
	var idx = 0;
	for i in g.n {
		if g.res[i] == goal {
			found = true;
			idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	if found {
		out.i = idx;
		format(out.s, "nested prefix target found at index ", idx);
	} else {
		gold_fail(g, "nested prefix target not found");
		out.i = -1;
		out.s.append("nested target not found");
	}
	out
}
