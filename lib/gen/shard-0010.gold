@entry 4518dcfb89a41cd3
kind: step
verb: fold
noun: function
modifier: sorted
context: search
phrase: fold sorted search candidates applying function {f}
phrase: combine sorted search items using function {f}
slot: f fn
test: list=9,3,6 f=square
expect: => i=234 r=0.0 ok=true s="folded sorted items to 234" errors=0 n=1 res=[234] cache=0 hits=0
test: list=25,12,7 f=inc
expect: => i=46 r=0.0 ok=true s="folded sorted items to 46" errors=0 n=1 res=[46] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var acc = g.res[0];
	for i in 1..g.n {
		acc = ${f}(acc) + g.res[i];
	}
	g.res[0] = acc;
	g.n = 1;
	g.steps += g.n * g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded sorted items to ", acc);
	out
}
@end
