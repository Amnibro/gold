fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let last_val = g.res[g.n - 1];
	let second_last = g.res[g.n - 2];
	let combined = ${op}(last_val) + second_last;
	g.res[g.n - 2] = combined;
	g.n = g.n - 1;
	g.steps += 1;
	out.i = combined;
	out.s.clear();
	format(out.s, "paired last elements into ", combined);
	out
}
@end
@entry 6ea9afd3c3347a3a
kind: step
verb: count
noun: tally
modifier: recursively
context: compare
phrase: count tally recursively divisor {divisor}
phrase: calculate recursive tally dividing by {divisor}
slot: divisor int
test: list=10,20,30 divisor=2 input=0
expect: => i=11 r=0.0 ok=true s="recursive tally divisions count 11" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=100,50 divisor=5 input=0
expect: => i=6 r=0.0 ok=true s="recursive tally divisions count 6" errors=0 n=2 res=[100,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var d = ${divisor};
	if d <= 1 { d = 2; }
	var total_divs = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 1 {
			x = x / d;
			total_divs++;
		}
	}
	g.steps += total_divs;
	out.i = total_divs;
	out.s.clear();
	format(out.s, "recursive tally divisions count ", total_divs);
	out
}
@end
