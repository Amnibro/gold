fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum_alt = 0;
	var idx = 0;
	while idx < g.n {
		sum_alt += g.res[idx] * f;
		idx += 2;
	}
	g.steps += (idx / 2);
	out.i = sum_alt;
	out.s.clear();
	format(out.s, "merged alternating results total ", sum_alt);
	out
}
