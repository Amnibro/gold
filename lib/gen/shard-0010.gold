fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var best = 1;
	var cur = 1;
	for i in (g.n - 1) {
		if g.res[i + 1] >= g.res[i] {
			cur++;
			if cur > best { best = cur; }
		} else {
			cur = 1;
		}
	}
	g.steps += g.n;
	out.i = best;
	out.s.clear();
	format(out.s, "longest sorted streak is ", best);
	out
}
