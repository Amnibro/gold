fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let is_err = (i % 2 == 1) && (g.res[i] < 0);
		if !is_err {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered alternating errors leaving ", kept);
	out
}
@end
@entry af0552e9cd8fe9eb
kind: step
verb: select
noun: histogram
modifier: nested
context: filter
phrase: select histogram count for nested bucket size {bucket_size}
phrase: filter items into histogram bins of size {bucket_size}
slot: bucket_size int
test: list=5,15,25,8,30 bucket_size=20
expect: => i=3 r=0.0 ok=true s="histogram first bucket has 3" errors=0 n=5 res=[5,15,25,8,30] cache=0 hits=0
test: list=2,4,8,16,32 bucket_size=10
expect: => i=3 r=0.0 ok=true s="histogram first bucket has 3" errors=0 n=5 res=[2,4,8,16,32] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket_size};
	if b <= 0 { return out; }
	var kept = 0;
	var in_first = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x < b { in_first++; }
		if x != 0 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = in_first;
	out.s.clear();
	format(out.s, "histogram first bucket has ", in_first);
	out
}
@end
