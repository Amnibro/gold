code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var over_count = 0;
	for i in g.n {
		if g.res[i] > th { over_count++; }
	}
	if g.n > 1 && over_count > 0 {
		var shift = over_count % g.n;
		for s in shift {
			let first = g.res[0];
			for i in 1..g.n {
				g.res[i - 1] = g.res[i];
			}
			g.res[g.n - 1] = first;
		}
	}
	g.steps += g.n;
	out.i = over_count;
	out.s.clear();
	format(out.s, "rotated over threshold: ", over_count);
	out
}
@end
