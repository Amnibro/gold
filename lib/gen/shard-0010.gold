test: list=1,20 inner=5 outer=12
expect: => i=2 r=0.0 ok=true s="clamped 2 nested error values" errors=0 n=2 res=[5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${inner};
	let hi = ${outer};
	var modified = 0;
	for k in g.n {
		let x = g.res[k];
		if x < lo {
			g.res[k] = lo;
			modified++;
		} else if x > hi {
			g.res[k] = hi;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " nested error values");
	out
}
@end
