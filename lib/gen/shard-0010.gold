	let tgt = ${target};
	let mid = g.n / 2;
	var found = -1;
	if g.n > 0 && g.res[mid] == tgt {
		found = mid;
	} else {
		for i in g.n {
			if g.res[i] == tgt { found = i; break; }
		}
	}
	gold_cache_put(g, tgt, found);
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "found target at index ", found);
	out
}
@end
@entry bfe35583bc7d8f8d
kind: step
verb: join
noun: evens
modifier: last
context: cache
phrase: join last even cache entries across {count} items
phrase: combine final even cached values across {count} slots
slot: count int
test: list=1,2,4,6 count=2
expect: => i=10 r=0.0 ok=true s="joined last evens sum 10" errors=0 n=1 res=[10] cache=1 hits=0
test: list=3,8,10,12 count=3
expect: => i=30 r=0.0 ok=true s="joined last evens sum 30" errors=0 n=1 res=[30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		}
	}
	let start = if en > c { en - c } else { 0 };
	var sum = 0;
	for i in start..en {
		sum += evens[i];
	}
	gold_cache_put(g, c, sum);
	g.res[0] = sum;
	g.n = 1;
	g.steps += en;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined last evens sum ", sum);
	out
}
@end
