fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_merges = ${times};
	var kept = 0;
	var merges = 0;
	var i = 0;
	while i < out.s.len {
		if kept > 0 && out.s[i] == out.s[kept - 1] && merges < max_merges {
			merges++;
		} else {
			out.s[kept] = out.s[i];
			kept++;
		}
		i++;
	}
	out.s.resize(kept, 0 as byte);
	out.i = merges;
	gold_push(g, merges);
	g.steps += i;
	out
}
