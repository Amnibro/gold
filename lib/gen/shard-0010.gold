code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step_size};
	if s <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		g.res[kept] = g.res[i];
		gold_cache_put(g, kept, g.res[i]);
		kept++;
		i += s;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " recursive checkpoints");
	out
}
@end
