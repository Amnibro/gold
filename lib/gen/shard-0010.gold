fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ts = ${tail_size};
	if ts <= 0 || g.n < ts { return out; }
	let start = g.n - ts;
	var total = 0;
	var i = start;
	while i < g.n {
		total += g.res[i];
		i += 2;
	}
	g.steps += ts;
	out.i = total;
	out.s.clear();
	format(out.s, "alternating tail sum: ", total);
	out
}
@end
