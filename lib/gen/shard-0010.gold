expect: => i=2 r=0.0 ok=true s="closest pair at 2 diff 2" errors=0 n=7 res=[10,25,30,32,50,70,2] cache=0 hits=0
test: list=5,40,12,14,90,100
expect: => i=2 r=0.0 ok=true s="closest pair at 2 diff 2" errors=0 n=7 res=[5,40,12,14,90,100,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_diff = -1;
	var best_pair_idx = -1;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			let diff = if g.res[i+1] >= g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
			if min_diff == -1 || diff < min_diff {
				min_diff = diff;
				best_pair_idx = i;
			}
			i += 2;
		}
	}
	out.i = best_pair_idx;
	out.s.clear();
	format(out.s, "closest pair at ", best_pair_idx, " diff ", min_diff);
	gold_push(g, best_pair_idx);
	g.steps += g.n + 1;
	out
}
@end
