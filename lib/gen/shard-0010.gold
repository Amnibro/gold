	let last = g.res[g.n - 1];
	let eq = last == tgt;
	g.steps += 1;
	out.ok = eq;
	out.i = last;
	out.s.clear();
	if eq {
		format(out.s, "last number matched target ", tgt);
	} else {
		gold_fail(g, "last number did not match target");
		out.ok = false;
		format(out.s, "error: expected ", tgt, " but got ", last);
	}
	out
}
