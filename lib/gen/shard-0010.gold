fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var pairs_count = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			let pair_sum = g.res[i] + g.res[i+1];
			if pair_sum <= ceil {
				g.res[pairs_count] = pair_sum;
				pairs_count++;
			}
			i += 2;
		}
	}
	g.n = pairs_count;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "paired ", pairs_count, " items under ceiling");
	g.steps += g.n + 1;
	out
}
@end
