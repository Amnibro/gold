code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tag};
	let val, ok = gold_cache_get(g, k);
	if ok {
		out.i = val;
		out.s.clear();
		format(out.s, "hit cached metric: ", val);
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let stat = if g.n > 0 { sum / g.n } else { 0 };
	gold_cache_put(g, k, stat);
	g.steps += g.n;
	out.i = stat;
	out.s.clear();
	format(out.s, "stored memo with_retry metric: ", stat);
	out
}
@end
