fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_run};
	if mr <= 0 || g.n == 0 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	var cur_run = 0;
	var prev = g.res[0] + 1;
	for i in g.n {
		let x = g.res[i];
		if x == prev {
			cur_run++;
		} else {
			prev = x;
			cur_run = 1;
		}
		if cur_run <= mr {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "bounded run elements count: ", kept);
	out
}
@end
