code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let f = ${factor};
	var start = if g.n > c { g.n - c } else { 0 };
	while start < g.n {
		g.res[start] *= f;
		start++;
	}
	g.steps += c;
	out.i = f;
	out.s.clear();
	format(out.s, "scaled suffix elements ", c);
	out
}
@end
