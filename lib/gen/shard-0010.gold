kind: step
verb: swap
noun: squares
modifier: recursively
context: format
phrase: swap squares recursively below ceiling {limit}
phrase: exchange squares recursively under bound {limit}
slot: limit int
test: list=4,9,16,25 limit=20
expect: => i=1 r=0.0 ok=true s="swapped square pairs 1" errors=0 n=4 res=[9,4,16,25] cache=0 hits=0
test: list=1,4,10,16 limit=15
expect: => i=1 r=0.0 ok=true s="swapped square pairs 1" errors=0 n=4 res=[4,1,10,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swapped = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a < lim && b < lim {
			g.res[i] = b;
			g.res[i + 1] = a;
			swapped++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped square pairs ", swapped);
	out
}
@end
