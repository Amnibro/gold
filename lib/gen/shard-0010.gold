@entry f246a7e444cd4f4b
kind: step
verb: group
noun: tail
modifier: in_place
context: retry
slot: tail_k int
phrase: group tail in place preserving {tail_k} items
phrase: truncate sequence retaining tail of {tail_k} elements in place
test: list=1,2,3,4,5 tail_k=3
expect: => i=3 r=0.0 ok=true s="retained tail group of 3 elements in place" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=1,2 tail_k=-1
expect: => i=0 r=0.0 ok=false s="error: invalid tail size -1" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tail_k};
	if k <= 0 {
		gold_fail(g, "non positive tail size for in place group");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid tail size ", k);
		return out;
	}
	if k > g.n {
		gold_fail(g, "tail size exceeds current length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: tail size ", k, " exceeds length ", g.n);
		return out;
	}
	let start = g.n - k;
	for i in k {
		g.res[i] = g.res[start + i];
	}
	g.n = k;
	g.steps += k;
