expect: => i=4 r=0.0 ok=true s="cached 4 sorted letters" errors=0 n=4 res=[97,98,99,100] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	for i in out.s.len { gold_push(g, out.s[i] as! int); }
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached ", g.n, " sorted letters");
	out
}
@end
