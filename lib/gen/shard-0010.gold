@entry 8f7026d66cd2d48b
kind: step
verb: dedupe
noun: counter
modifier: any
context: format
phrase: dedupe counter any duplicate frequencies
phrase: format deduplicated counter values across results
phrase: remove repeated counter values any position
test: list=1,1,2,2,3
expect: => i=2 r=0.0 ok=true s="[2][1]" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,5,6
expect: => i=1 r=0.0 ok=true s="[1]" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_count = 0;
	var u_val int[512] = [0; 512];
	var u_freq int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in u_count {
			if u_val[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			u_freq[idx] = u_freq[idx] + 1;
		} else {
			u_val[u_count] = x;
			u_freq[u_count] = 1;
			u_count++;
		}
	}
	out.s.clear();
	var distinct_freqs = 0;
	for i in u_count {
		let f = u_freq[i];
		var seen = false;
		for j in i {
			if u_freq[j] == f { seen = true; break; }
		}
		if !seen {
			format(out.s, "[", f, "]");
			distinct_freqs++;
		}
	}
	out.i = distinct_freqs;
	g.steps += g.n;
	out
}
@end
