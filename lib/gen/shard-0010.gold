fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_val = -999999;
	var count = 0;
	for i in g.n {
		if !${cond}(g.res[i]) { break; }
		if g.res[i] > max_val { max_val = g.res[i]; }
		count++;
	}
	g.steps += count;
	out.i = if count > 0 { max_val } else { 0 };
	out.s.clear();
	format(out.s, "maximum found while true: ", out.i);
	out
}
