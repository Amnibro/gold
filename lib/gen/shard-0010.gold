fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = 0;
	var i = 0;
	while i < g.n {
		let k = g.res[i];
		let val, ok = gold_cache_get(g, k);
		if ok {
			found++;
		} else {
			gold_cache_put(g, k, k * 2);
		}
		i += 2;
	}
	out.i = found;
	out.s.clear();
	format(out.s, "cache hits ", found, " misses ", g.misses);
	g.steps += g.n + 1;
	out
}
