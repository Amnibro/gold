@entry a96ccde413227d98
kind: step
verb: rotate
noun: primes
modifier: safely
context: list
phrase: rotate primes safely turns {turns}
phrase: roll primes safely passes {turns}
slot: turns int
test: list=2,3,5,7 turns=1
expect: => i=4 r=0.0 ok=true s="safely rotated prime list" errors=0 n=4 res=[7,2,3,5] cache=0 hits=0
test: list=11,13,17 turns=2
expect: => i=3 r=0.0 ok=true s="safely rotated prime list" errors=0 n=3 res=[13,17,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${turns};
	var all_primes = true;
	for i in g.n {
		if !core_is_prime(g.res[i]) {
			all_primes = false;
			break;
		}
	}
	if !all_primes {
		gold_fail(g, "non-prime found in list");
		out.ok = false;
		out.i = 0;
		return out;
	}
	if g.n > 1 && t > 0 {
		let k = t % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely rotated prime list");
	out
}
@end
