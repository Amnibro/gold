@entry 343652c47bc5378f
kind: step
verb: dedupe
noun: tail
modifier: each
context: search
phrase: dedupe tail candidates examining each up to {keep_count}
phrase: purge duplicate search items across tail {keep_count}
slot: keep_count int
test: list=1,2,3,3,4,4 keep_count=4
expect: => i=2 r=0.0 ok=true s="deduped tail removing 2 duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=9,9,8,8 keep_count=3
expect: => i=1 r=0.0 ok=true s="deduped tail removing 1 duplicates" errors=0 n=3 res=[9,9,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let kc = ${keep_count};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let start = if g.n > kc { g.n - kc } else { 0 };
	var kept = start;
	for i in start..g.n {
		var duplicate = false;
		for j in start..kept {
			if g.res[j] == g.res[i] { duplicate = true; }
		}
		if !duplicate {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped tail removing ", removed, " duplicates");
	out
}
@end
