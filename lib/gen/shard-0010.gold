code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	var sign = 1;
	var i = g.n;
	while i > 0 {
		i--;
		acc += sign * g.res[i];
		sign = -sign;
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded sequence in reverse: ", acc);
	out
}
@end
