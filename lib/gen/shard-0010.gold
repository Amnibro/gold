@entry b3a0b2e003f2ee32
kind: step
verb: join
noun: average
modifier: last
context: retry
phrase: join average of last {k} retry attempts
phrase: combine average across last {k} retry results
phrase: append average of trailing {k} retry values
slot: k int
test: list=2,4,6,8 k=2
expect: => i=7 r=0.0 ok=true s="appended average 7 of last items" errors=0 n=5 res=[2,4,6,8,7] cache=0 hits=0
test: list=10,20,30 k=3
expect: => i=20 r=0.0 ok=true s="appended average 20 of last items" errors=0 n=4 res=[10,20,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || g.n == 0 {
		gold_fail(g, "invalid count or empty results");
		out.ok = false;
		return out;
	}
	let lim = if count > g.n { g.n } else { count };
	var sum = 0;
	for i in lim {
		sum += g.res[g.n - 1 - i];
	}
	let avg = sum / lim;
	gold_push(g, avg);
	g.steps += lim;
	out.i = avg;
	out.s.clear();
	format(out.s, "appended average ", avg, " of last items");
	out
}
@end
