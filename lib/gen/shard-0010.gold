fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text for reverse word search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text buffer");
		return out;
	}
	var i = out.s.len - 1;
	while i >= 0 && out.s[i] == ' ' { i--; }
	var word_len = 0;
	while i >= 0 && out.s[i] != ' ' {
		word_len++;
		i--;
	}
	g.steps += out.s.len;
	out.i = word_len;
	out.s.clear();
	if word_len == 0 {
		gold_fail(g, "no word characters found");
		out.ok = false;
		format(out.s, "error: zero words found");
	} else {
		format(out.s, "last word has length ", word_len);
	}
	out
}
@end
