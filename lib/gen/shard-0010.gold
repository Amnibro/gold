code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	for i in g.n {
		g.res[i] += off;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " numbers in reverse");
	out
}
@end
