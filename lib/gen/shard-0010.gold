fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 { return out; }
	var max_streak = 1;
	var cur_streak = 1;
	var i = 1;
	while i < out.s.len {
		if out.s[i] > out.s[i - 1] {
			cur_streak++;
			if cur_streak > max_streak { max_streak = cur_streak; }
		} else {
			cur_streak = 1;
		}
		i++;
	}
	gold_cache_put(g, 10, max_streak);
	out.i = max_streak;
	gold_push(g, max_streak);
	g.steps += out.s.len;
	out
}
