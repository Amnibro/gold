expect: => i=1 r=0.0 ok=true s="swapped minimum 1 to last index" errors=0 n=4 res=[50,20,8,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_idx = 0;
	for i in g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_val = g.res[min_idx];
	let last_val = g.res[g.n - 1];
	g.res[min_idx] = last_val;
	g.res[g.n - 1] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "swapped minimum ", min_val, " to last index");
	out
}
@end
@entry cde445499361bef1
kind: step
verb: scale
noun: streak
modifier: sorted
context: aggregate
phrase: scale streak of sorted values by multiplier {factor}
phrase: multiply sorted streak elements by factor {factor}
slot: factor int
test: list=3,1,2 factor=2
expect: => i=3 r=0.0 ok=true s="scaled 3 sorted streak values by 2" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=40,10,20 factor=5
expect: => i=3 r=0.0 ok=true s="scaled 3 sorted streak values by 5" errors=0 n=3 res=[50,100,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	for i in g.n {
		g.res[i] *= f;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled ", g.n, " sorted streak values by ", f);
	out
}
@end
