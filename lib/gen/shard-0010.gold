	let tgt = ${target};
	var found = 0;
	var b_size = 4;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < i + b_size && j < g.n {
			if g.res[j] == tgt { found++; }
			j++;
		}
		i += b_size;
	}
	out.i = found;
	out.s.clear();
	format(out.s, "found target ", found, " times");
	gold_push(g, found);
	g.steps += g.n + 1;
	out
}
