code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_count = 0;
	var d_count = 0;
	var dups int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_count {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[u_count] = x;
			u_count++;
		} else {
			dups[d_count] = x;
			d_count++;
		}
	}
	for k in d_count {
		g.res[u_count + k] = dups[k];
	}
	g.steps += g.n;
	out.i = d_count;
	out.s.clear();
	format(out.s, "duplicates moved last count=", d_count);
	out
}
@end
