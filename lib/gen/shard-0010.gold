@entry d92ff228d2ea9273
kind: step
verb: clamp
noun: suffix
modifier: every_other
context: filter
phrase: clamp alternating suffix elements to upper bound {upper}
phrase: filter every other suffix value capping at {upper}
slot: upper int
test: list=1,15,2,25,3,35 upper=20
expect: => i=3 r=0.0 ok=true s="clamped 3 alternating suffix items" errors=0 n=3 res=[15,20,20] cache=0 hits=0
test: list=10,50,20,60,30 upper=40
expect: => i=2 r=0.0 ok=true s="clamped 2 alternating suffix items" errors=0 n=2 res=[40,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${upper};
	var kept = 0;
	for i in g.n {
		if i % 2 == 1 {
			let x = if g.res[i] > cap { cap } else { g.res[i] };
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped ", kept, " alternating suffix items");
	out
}
@end
