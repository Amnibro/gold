fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${limit};
	var spent = 0;
	for i in g.n {
		if g.res[i] <= rem {
			rem -= g.res[i];
			spent++;
		} else {
			break;
		}
	}
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent allocations count ", spent);
	out
}
