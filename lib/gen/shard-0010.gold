test: list=5,10,15
expect: => i=10 r=0.0 ok=true s="appended pairwise tally diff sum: 10" errors=0 n=4 res=[5,10,15,10] cache=0 hits=0
test: list=5
expect: => i=0 r=0.0 ok=false s="error: need at least pair of results" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need at least pair of results");
		return out;
	}
	let orig_n = g.n;
	var diff_sum = 0;
	var i = 0;
	while i + 1 < orig_n {
		let d = g.res[i + 1] - g.res[i];
		diff_sum += if d < 0 { -d } else { d };
		i++;
	}
	gold_push(g, diff_sum);
	g.steps += orig_n;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "appended pairwise tally diff sum: ", diff_sum);
	out
}
@end
