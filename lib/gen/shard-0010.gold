fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_zero = false;
	for i in g.n {
		if g.res[i] == 0 {
			has_zero = true;
		}
	}
	g.steps += g.n;
	out.ok = !has_zero;
	out.i = if has_zero { 0 } else { 1 };
	out.s.clear();
	if has_zero {
		format(out.s, "check failed zero item found");
	} else {
		format(out.s, "check passed no zero items");
	}
	out
}
@end
