context: error
slot: budget int
phrase: find budget sorted position within limit {budget}
phrase: search sorted results for budget threshold {budget}
test: list=5,10,15,20 budget=12
expect: => i=1 r=0.0 ok=true s="last index within budget 12 is 1" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=20,10,5 budget=15
expect: => i=0 r=0.0 ok=false s="error: list unsorted" errors=1 n=3 res=[20,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n == 0 || b <= 0 {
		gold_fail(g, "invalid budget or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid budget search");
		return out;
	}
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		i++;
	}
	if !is_sorted {
		gold_fail(g, "results not sorted for budget search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list unsorted");
		return out;
	}
	var pos = -1;
	for j in g.n {
		if g.res[j] <= b { pos = j; }
	}
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "last index within budget ", b, " is ", pos);
	out
}
@end
@entry 3b752e058fab46ca
kind: step
verb: limit
noun: gaps
modifier: until
context: error
slot: max_gap int
slot: stop_val int
phrase: limit gaps until reaching value {stop_val} with bound {max_gap}
phrase: inspect element gaps bounded by {max_gap} until {stop_val}
test: list=2,5,8,20 max_gap=4 stop_val=8
expect: => i=2 r=0.0 ok=true s="gaps valid for 2 steps" errors=0 n=4 res=[2,5,8,20] cache=0 hits=0
test: list=10,30 max_gap=-2 stop_val=30
expect: => i=0 r=0.0 ok=false s="error: invalid gap limit configuration" errors=1 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	let sv = ${stop_val};
	if mg <= 0 || g.n < 2 {
		gold_fail(g, "invalid gap bound or short list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid gap limit configuration");
		return out;
	}
	var ok_gaps = true;
	var checked = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > mg { ok_gaps = false; break; }
		checked++;
		if g.res[i + 1] == sv { break; }
		i++;
	}
	g.steps += checked;
	out.ok = ok_gaps;
	out.i = checked;
	out.s.clear();
	if ok_gaps {
		format(out.s, "gaps valid for ", checked, " steps");
	} else {
		gold_fail(g, "gap exceeded threshold");
		out.ok = false;
		format(out.s, "error: gap exceeded bound");
	}
	out
}
@end
