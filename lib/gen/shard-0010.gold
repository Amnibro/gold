expect: => i=4 r=0.0 ok=true s="sorted checkpoint between bounds" errors=0 n=4 res=[1,4,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if l >= 0 && h < g.n && l < h {
		for i in l..h + 1 {
			for j in i + 1..h + 1 {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted checkpoint between bounds");
	out
}
@end
