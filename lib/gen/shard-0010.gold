expect: => i=10 r=0.0 ok=true s="clamped average is 10" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	var clamped = avg;
	if clamped < lo { clamped = lo; }
	if clamped > hi { clamped = hi; }
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped average is ", clamped);
	out
}
@end
