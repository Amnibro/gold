fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var freqs int[512] = [0; 512];
	for i in g.n {
		var c = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { c++; }
		}
		freqs[i] = c;
	}
	var uniq_n = 0;
	for i in g.n {
		let f = freqs[i];
		var seen = false;
		for j in uniq_n {
			if g.res[j] == f { seen = true; break; }
		}
		if !seen {
			g.res[uniq_n] = f;
			uniq_n++;
		}
	}
	for i in uniq_n {
		for j in i + 1..uniq_n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	for i in uniq_n {
		g.res[i] = g.res[i];
	}
	g.n = uniq_n;
	g.steps += g.n;
	out.i = uniq_n;
	out.s.clear();
	format(out.s, "sorted ", uniq_n, " unique histogram values");
	out
}
@end
