@entry 0d408daa1dfc3959
kind: fn
verb: rotate
noun: letters
modifier: sorted
context: text
phrase: rotate letters sorted turns {turns}
phrase: roll letters sorted shifts {turns}
slot: turns int
test: arg=4231,987 turns=2
expect: 1236
expect: 791
test: arg=5 turns=1
expect: 6
code:
fn ${ID}(n int) int {
	let t = ${turns};
	var x = if n < 0 { -n } else { n };
	var d = [0; 16];
	var dn = 0;
	if x == 0 { d[0] = 0; dn = 1; }
	while x > 0 && dn < 16 {
		d[dn] = x % 10;
		dn++;
		x /= 10;
	}
	for i in dn {
		for j in (i + 1)..dn {
			if d[i] > d[j] {
				let tmp = d[i];
				d[i] = d[j];
				d[j] = tmp;
			}
		}
	}
	var res = 0;
	for i in dn {
		res = res * 10 + d[i];
	}
	res + t
}
@end
@entry cf04d7c290837571
kind: step
verb: shift
noun: prefix
modifier: sorted
context: core
phrase: shift sorted prefix by offset {offset}
phrase: adjust sorted prefix values with offset {offset}
slot: offset int
test: list=10,5,8,20 offset=2
expect: => i=7 r=0.0 ok=true s="shifted prefix of 3 items" errors=0 n=4 res=[7,10,12,20] cache=0 hits=0
test: list=4,1,9 offset=5
expect: => i=6 r=0.0 ok=true s="shifted prefix of 3 items" errors=0 n=3 res=[6,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 {
		gold_fail(g, "empty list for prefix sort");
		out.ok = false;
		return out;
	}
	let k = if g.n < 3 { g.n } else { 3 };
	for i in k {
		var min_idx = i;
		for j in (i + 1)..k {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		g.res[i] += off;
	}
	g.steps += k;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "shifted prefix of ", k, " items");
	out
}
@end
