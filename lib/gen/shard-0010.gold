@entry fb33de49dd475c22
kind: step
verb: fold
noun: window
modifier: all
context: loop
phrase: fold entire sliding window of size {size} across loop
phrase: sum all sliding windows of size {size} in loop
phrase: accumulate all window totals of length {size}
slot: size int
test: list=1,2,3,4,5 size=3
expect: => i=3 r=0.0 ok=true s="folded into 3 window sums" errors=0 n=3 res=[6,9,12] cache=0 hits=0
test: list=10,20,30,40 size=2
expect: => i=3 r=0.0 ok=true s="folded into 3 window sums" errors=0 n=3 res=[30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz > g.n {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var buf int[512] = [0; 512];
	for i in (g.n - sz + 1) {
		var w_sum = 0;
		for j in sz {
			w_sum += g.res[i + j];
		}
		buf[new_n] = w_sum;
		new_n++;
	}
	for i in new_n { g.res[i] = buf[i]; }
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "folded into ", new_n, " window sums");
	out
}
@end
