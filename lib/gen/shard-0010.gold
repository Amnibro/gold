@entry 81ef93a57a121652
kind: step
verb: fold
noun: step
modifier: at_most
context: stats
phrase: fold step at_most delta {delta}
phrase: reduce step at_most bound {delta}
slot: delta int
test: list=10,25,30,50 delta=10
expect: => i=25 r=0.0 ok=true s="folded step sum is 25" errors=0 n=4 res=[10,25,30,50] cache=0 hits=0
test: list=2,5,8 delta=4
expect: => i=6 r=0.0 ok=true s="folded step sum is 6" errors=0 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d_max = ${delta};
	var total_step = 0;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > d_max { diff = d_max; }
		total_step += diff;
	}
	g.steps += g.n;
	out.i = total_step;
	out.s.clear();
	format(out.s, "folded step sum is ", total_step);
	out
}
@end
@entry f24b49c39bf6ab89
kind: step
verb: sort
noun: function
modifier: each
context: search
phrase: sort candidates evaluating function {f} on each
phrase: rank search items applying function {f} to each
slot: f fn
test: list=15,4,8 f=square
expect: => i=4 r=0.0 ok=true s="sorted 3 search results" errors=0 n=3 res=[4,8,15] cache=0 hits=0
test: list=35,12,99 f=digit_sum
expect: => i=12 r=0.0 ok=true s="sorted 3 search results" errors=0 n=3 res=[12,35,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no search candidates to sort");
		out.ok = false;
		return out;
	}
	var scores int[512] = [0; 512];
	for i in g.n {
		scores[i] = ${f}(g.res[i]);
	}
	for i in g.n {
		for j in i + 1..g.n {
			if scores[i] > scores[j] {
				let ts = scores[i];
				scores[i] = scores[j];
				scores[j] = ts;
				let tr = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tr;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted ", g.n, " search results");
	out
}
@end
