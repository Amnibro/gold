	if g.n < 2 { return out; }
	var shifts = 0;
	while shifts < g.n && !${cond}(g.res[0]) {
		let first = g.res[0];
		for i in 0..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		shifts++;
	}
	g.steps += shifts;
	out.i = shifts;
	out.s.clear();
	format(out.s, "rotated elements until condition count: ", shifts);
	out
}
@end
