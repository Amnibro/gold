fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var k = 0;
	while k < g.n && ${cond}(g.res[k]) {
		k++;
	}
	for i in k {
		for j in (i + 1)..k {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "sorted leading ", k, " items while matching condition");
	out
}
@end
