fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var total = 0;
	for i in g.n {
		let delta = off * (i + 1);
		g.res[i] += delta;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "mapped ", g.n, " letters running total ", total);
