@entry 71b0aeba0502bfe7
kind: step
verb: measure
noun: value
modifier: sorted
context: compare
phrase: measure value sorted rank {rank}
phrase: find sorted comparison value rank {rank}
slot: rank int
test: list=10,2,8,15 rank=1
expect: => i=8 r=0.0 ok=true s="measured sorted element at rank 8" errors=0 n=4 res=[2,8,10,15] cache=0 hits=0
test: list=30,5,20 rank=2
expect: => i=30 r=0.0 ok=true s="measured sorted element at rank 30" errors=0 n=3 res=[5,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rank};
	if g.n == 0 { return out; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
		}
	}
	let target_idx = if r < 0 { 0 } else if r >= g.n { g.n - 1 } else { r };
	let val = g.res[target_idx];
	g.steps += g.n;
	out.i = val;
	out.s.clear();
	format(out.s, "measured sorted element at rank ", val);
	out
}
@end
