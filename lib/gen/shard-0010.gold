phrase: tally middle up_to distance window {radius}
slot: radius int
test: list=1,2,3,4,5 radius=1
expect: => i=3 r=0.0 ok=true s="elements within radius of middle 3" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20 radius=0
expect: => i=1 r=0.0 ok=true s="elements within radius of middle 1" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${radius};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let mid = g.n / 2;
	var cnt = 0;
	for i in g.n {
		let diff = if i > mid { i - mid } else { mid - i };
		if diff <= r { cnt++; }
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "elements within radius of middle ", cnt);
	out
}
@end
