fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough elements for suffix swap");
		out.ok = false;
		return out;
	}
	let tmp = g.res[g.n - 1];
	g.res[g.n - 1] = g.res[g.n - 2];
	g.res[g.n - 2] = tmp;
	g.steps += 2;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "swapped suffix elements");
	out
}
