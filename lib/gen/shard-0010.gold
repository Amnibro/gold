@entry 6aaeafd127b7fe22
kind: step
verb: clamp
noun: gaps
modifier: times
context: search
phrase: clamp search result gaps dividing excess {times} times
phrase: scale down search interval gaps across {times} times
slot: times int
test: list=2,10,30 times=2
expect: => i=1 r=0.0 ok=true s="clamped gaps with 1 reductions" errors=0 n=3 res=[2,10,20] cache=0 hits=0
test: list=5,25,65 times=1
expect: => i=2 r=0.0 ok=true s="clamped gaps with 2 reductions" errors=0 n=3 res=[5,15,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var clamped = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		for step in t {
			if diff > 10 {
				diff /= 2;
				clamped++;
			}
		}
		g.res[i + 1] = g.res[i] + diff;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped gaps with ", clamped, " reductions");
	out
}
@end
@entry d05bf8f014ae4ee7
kind: step
verb: join
noun: numbers
modifier: recursively
context: search
phrase: recursively combine search numbers scaling by factor {factor}
phrase: join search candidate numbers recursively with factor {factor}
slot: factor int
test: list=4,8,16 factor=2
expect: => i=11 r=0.0 ok=true s="recursively joined numbers across 2 rounds" errors=0 n=1 res=[11] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=10 r=0.0 ok=true s="recursively joined numbers across 1 rounds" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var rounds = 0;
	while g.n > 1 {
		let pairs = g.n / 2;
		for i in pairs {
			g.res[i] = (g.res[i * 2] + g.res[i * 2 + 1]) / f;
		}
		if g.n % 2 != 0 {
			g.res[pairs] = g.res[g.n - 1];
			g.n = pairs + 1;
		} else {
			g.n = pairs;
		}
		rounds++;
	}
	g.steps += rounds;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "recursively joined numbers across ", rounds, " rounds");
	out
}
@end
