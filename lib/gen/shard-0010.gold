code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var chosen = -1;
	let limit = if att < g.n { att } else { g.n };
	for i in limit {
		if g.res[i] > 50 {
			chosen = g.res[i];
			break;
		}
	}
	if chosen == -1 {
		gold_fail(g, "value not found within retry attempts");
		out.ok = false;
		return out;
	}
	g.steps += limit;
	out.i = chosen;
	out.s.clear();
	format(out.s, "selected retry value ", chosen);
	out
}
@end
