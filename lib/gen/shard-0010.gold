		let code = out.s[i] as! int;
		if code % 2 != 0 && code >= lo && code <= hi {
			gold_cache_put(g, i as! int, code);
			cached++;
		}
	}
	g.steps += out.s.len;
	out.i = cached;
	out
}
@end
