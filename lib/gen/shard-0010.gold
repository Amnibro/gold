	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	var total_dev = 0;
	for i in g.n {
		let diff = if g.res[i] >= mean { g.res[i] - mean } else { mean - g.res[i] };
		total_dev += diff;
	}
	out.i = total_dev;
	out.s.clear();
	format(out.s, "total deviation ", total_dev);
	gold_push(g, total_dev);
	g.steps += g.n * 2 + 1;
	out
}
@end
