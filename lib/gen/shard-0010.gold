code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let s0 = ${start_idx};
	let s1 = ${end_idx};
	var temp int[512] = [0; 512];
	var count = 0;
	for i in (g.n - 1) {
		temp[count] = g.res[i];
		count++;
		if i >= s0 && i < s1 && count < 500 {
			let mid = (g.res[i] + g.res[i + 1]) / 2;
			temp[count] = mid;
			count++;
		}
	}
	temp[count] = g.res[g.n - 1];
	count++;
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "split pairs between bounds: ", count);
	out
}
@end
