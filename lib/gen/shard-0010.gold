	let mt = ${min_threshold};
	var dup_rev = 0;
	for i in g.n {
		let idx = g.n - 1 - i;
		let x = g.res[idx];
		if x >= mt {
			var seen = 0;
			for j in g.n {
				if g.res[j] == x { seen++; }
			}
			if seen > 1 { dup_rev++; }
		}
	}
	g.steps += g.n;
	out.i = dup_rev;
	out.s.clear();
	format(out.s, "reverse duplicate occurrences count ", dup_rev);
