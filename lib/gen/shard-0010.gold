expect: => i=9 r=0.0 ok=true s="merged streak of 3 elements sum 9" errors=0 n=2 res=[9,2] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var streak = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			break;
		}
		sum += g.res[i];
		streak++;
	}
	if streak > 0 {
		g.res[0] = sum;
		var kept = 1;
		for i in streak..g.n {
			g.res[kept] = g.res[i];
			kept++;
		}
		g.n = kept;
		gold_cache_put(g, 0, sum);
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged streak of ", streak, " elements sum ", sum);
	out
}
@end
