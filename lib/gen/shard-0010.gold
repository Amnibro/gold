@entry 08adb15ae6fe6595
kind: step
verb: keep
noun: loop
modifier: recursively
context: search
phrase: narrow search loop recursively toward target {target}
phrase: bisect search space recursively for target {target}
phrase: filter search loop recursively finding {target}
slot: target int
test: list=10,20,30,40,50,60,70 target=40
expect: => i=3 r=0.0 ok=true s="search iters 0 found at 3" errors=0 n=8 res=[10,20,30,40,50,60,70,3] cache=0 hits=0
test: list=5,15,25,35,45 target=15
expect: => i=1 r=0.0 ok=true s="search iters 2 found at 1" errors=0 n=6 res=[5,15,25,35,45,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var left = 0;
	var right = g.n - 1;
	var iters = 0;
	var found_idx = -1;
	while left <= right && iters < 20 {
		let mid = left + (right - left) / 2;
		if g.res[mid] == tgt {
			found_idx = mid;
			break;
		} else if g.res[mid] < tgt {
			left = mid + 1;
		} else {
			right = mid - 1;
		}
		iters++;
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "search iters ", iters, " found at ", found_idx);
	gold_push(g, found_idx);
	g.steps += iters + 1;
	out
}
@end
@entry 6c1536d924a1a508
kind: step
verb: compare
noun: prefix
modifier: in_reverse
context: transform
phrase: compare prefix elements backwards in reverse
phrase: reverse prefix order comparing against tail
slot: prefix_len int
test: list=1,2,3,4,5 prefix_len=3
expect: => i=3 r=0.0 ok=true s="reversed prefix length: 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
