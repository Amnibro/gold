code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	var sum_pairs = 0;
	var i = 0;
	while i < n / 2 {
		let left = out.s[i] as int;
		let right = out.s[n - 1 - i] as int;
		let diff = left - right;
		sum_pairs += if diff < 0 { -diff } else { diff };
		i++;
	}
	out.i = sum_pairs;
	gold_push(g, sum_pairs);
	g.steps += n;
	out
}
@end
