code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var attempt = 0;
	while attempt < r && g.n > 0 && g.res[0] < 0 {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		attempt++;
	}
	g.steps += attempt;
	out.i = attempt;
	out.s.clear();
	format(out.s, "rotated with retry taking ", attempt, " steps");
	out
}
@end
