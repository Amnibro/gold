	let limit = ${cap};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		count++;
		i += 2;
	}
	let avg = sum / count;
	let clamped = if avg > limit { limit } else { avg };
	g.steps += count;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped alternating average to ", clamped);
	out
}
