@entry d50bdf65aec75ad2
kind: step
verb: sort
noun: steps
modifier: each
context: list
phrase: sort steps each chunk {chunk}
phrase: order steps each block {chunk}
slot: chunk int
test: list=4,2,7,1,9,5 chunk=2
expect: => i=3 r=0.0 ok=true s="sorted 3 chunks" errors=0 n=6 res=[2,4,1,7,5,9] cache=0 hits=0
test: list=3,1,2 chunk=3
expect: => i=1 r=0.0 ok=true s="sorted 1 chunks" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ch = ${chunk};
	if ch <= 1 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var i = 0;
	while i + ch <= g.n {
		for a in i..(i + ch) {
			for b in (a + 1)..(i + ch) {
				if g.res[a] > g.res[b] {
					let tmp = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = tmp;
				}
			}
		}
	i += ch;
	}
	g.steps += g.n;
	out.i = i / ch;
	out.s.clear();
	format(out.s, "sorted ", i / ch, " chunks");
	out
}
@end
