expect: => i=1 r=0.0 ok=true s="sorted head of 1 retry items" errors=0 n=3 res=[12,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cutoff = g.n;
	for k in g.n {
		if ${p}(g.res[k]) {
			cutoff = k;
			break;
		}
	}
	for i in cutoff {
		for j in i + 1..cutoff {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += cutoff;
	out.i = cutoff;
	out.s.clear();
	format(out.s, "sorted head of ", cutoff, " retry items");
	out
}
@end
