fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_cnt = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = 0;
		for j in g.n {
			if g.res[j] == x { seen++; }
		}
		if seen > 1 {
			g.res[dup_cnt] = x;
			dup_cnt++;
		}
		i++;
	}
	g.n = dup_cnt;
	out.i = dup_cnt;
	out.s.clear();
	format(out.s, "selected ", dup_cnt, " duplicate entries");
	g.steps += g.n * 2 + 1;
	out
}
@end
