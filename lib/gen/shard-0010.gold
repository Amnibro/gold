		if i < d {
			gold_cache_put(g, i, g.res[i]);
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " recursive cache levels");
	out
}
