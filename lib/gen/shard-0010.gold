@entry 45fe9ae82e2b1fc0
kind: step
verb: scale
noun: middle
modifier: unique
context: search
phrase: scale unique items in middle partition by {factor}
phrase: multiply distinct middle results with {factor}
phrase: boost unique middle search candidates factor {factor}
slot: factor int
test: list=10,20,30,30,40,50 factor=2
expect: => i=1 r=0.0 ok=true s="scaled 1 unique middle entries" errors=0 n=7 res=[10,40,30,30,40,50,1] cache=0 hits=0
test: list=5,15,25,35,45,55 factor=3
expect: => i=3 r=0.0 ok=true s="scaled 3 unique middle entries" errors=0 n=7 res=[5,45,75,105,45,55,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 3 {
		out.i = 0;
		return out;
	}
	let start = g.n / 4;
	let end = (3 * g.n) / 4;
	var scaled = 0;
	var i = start;
	while i < end {
		var unique = true;
		var j = start;
		while j < end {
			if i != j && g.res[i] == g.res[j] {
				unique = false;
				break;
			}
			j++;
		}
		if unique {
			g.res[i] *= f;
			scaled++;
		}
		i++;
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " unique middle entries");
	gold_push(g, scaled);
	g.steps += (end - start) + 1;
	out
}
@end
