code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for k in g.n {
		let val = g.res[k];
		if val % 2 != 0 {
			let cached, ok = gold_cache_get(g, val);
			if ok {
				g.res[k] = cached;
			} else {
				let res = ${x}(val);
				gold_cache_put(g, val, res);
				g.res[k] = res;
			}
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "repeated on ", modified, " odd items with cache");
	out
}
@end
