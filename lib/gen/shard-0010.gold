	for i in g.n {
		total += g.res[i];
		attempts++;
		if attempts >= r { break; }
	}
	g.res[0] = total;
	g.n = 1;
	g.steps += attempts;
	out.i = total;
	out.s.clear();
	format(out.s, "joined values with retry sum ", total);
	out
}
@end
@entry 3b0aa3013a9f9960
kind: step
verb: dedupe
noun: tally
modifier: up_to
context: search
phrase: dedupe search tally capping items up to {max_count}
phrase: trim duplicate search tally values up to {max_count}
slot: max_count int
test: list=7,7,7,7,8 max_count=2
expect: => i=2 r=0.0 ok=true s="deduped tally capping occurrences up to 2" errors=0 n=3 res=[7,7,8] cache=0 hits=0
test: list=3,3,3,4,4 max_count=1
expect: => i=3 r=0.0 ok=true s="deduped tally capping occurrences up to 1" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var kept = 0;
	for i in g.n {
		var cnt = 0;
		for j in kept {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt < mc {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped tally capping occurrences up to ", mc);
	out
}
@end
