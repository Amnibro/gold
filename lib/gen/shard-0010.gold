expect: => i=0 r=0.0 ok=true s="kept last run of length 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var run_len = 1;
	var i = g.n - 1;
	while i > 0 && g.res[i] == g.res[i - 1] {
		run_len++;
		i--;
	}
	if run_len >= ml {
		let val = g.res[g.n - 1];
		for k in run_len {
			g.res[k] = val;
		}
		g.n = run_len;
	} else {
		g.n = 0;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept last run of length ", g.n);
	out
}
@end
@entry 0d592494ef604fb6
kind: step
verb: rank
noun: digits
modifier: with_cache
context: search
phrase: rank search key digits with cache radix {base}
phrase: order search candidate digits with cache base {base}
slot: base int
test: list=42,19,35 base=10
expect: => i=3 r=0.0 ok=true s="ranked 3 digit sums with cache" errors=0 n=3 res=[6,10,8] cache=3 hits=0
test: list=105,82 base=10
expect: => i=2 r=0.0 ok=true s="ranked 2 digit sums with cache" errors=0 n=2 res=[6,10] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base};
	var ranked = 0;
	for i in g.n {
		var num = g.res[i];
		var dsum = 0;
		while num > 0 {
			dsum += num % b;
			num /= b;
		}
		gold_cache_put(g, g.res[i], dsum);
		g.res[i] = dsum;
		ranked++;
	}
	g.steps += ranked;
	out.i = ranked;
	out.s.clear();
	format(out.s, "ranked ", ranked, " digit sums with cache");
	out
}
@end
