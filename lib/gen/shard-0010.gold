@entry cb5e2f0ac8f94688
kind: step
verb: swap
noun: average
modifier: until
context: loop
phrase: swap average until target_avg {target_avg}
phrase: exchange elements to improve average until {target_avg}
slot: target_avg int
test: list=2,4 target_avg=5
expect: => i=5 r=0.0 ok=true s="swapped average reached 5" errors=0 n=2 res=[4,7] cache=0 hits=0
test: list=10,20,30 target_avg=25
expect: => i=28 r=0.0 ok=true s="swapped average reached 28" errors=0 n=3 res=[30,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_avg};
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = sum / g.n;
	var swapped = 0;
	while avg < tgt && swapped < g.n {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp + tgt;
		sum += tgt;
		avg = sum / g.n;
		swapped++;
	}
	g.steps += swapped;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped average reached ", avg);
	out
}
@end
