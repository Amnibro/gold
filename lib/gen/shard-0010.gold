@entry ac8b806b9e9576ea
kind: step
verb: cache
noun: vowels
modifier: each
context: format
phrase: format vowel values caching each occurrence
phrase: render character vowels caching each distinct entry
test: list=65,66,69,70
expect: => i=2 r=0.0 ok=true s="cached vowels each: 2" errors=0 n=4 res=[65,66,69,70] cache=2 hits=0
test: list=97,98,101,102
expect: => i=2 r=0.0 ok=true s="cached vowels each: 2" errors=0 n=4 res=[97,98,101,102] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var v_count = 0;
	for i in g.n {
		let c = g.res[i];
		let is_v = (c == 65) || (c == 69) || (c == 73) || (c == 79) || (c == 85) || (c == 97) || (c == 101) || (c == 105) || (c == 111) || (c == 117);
		if is_v {
			gold_cache_put(g, c, v_count);
			v_count++;
		}
	}
	g.steps += g.n;
	out.i = v_count;
	out.s.clear();
	format(out.s, "cached vowels each: ", v_count);
	out
}
@end
