test: list=3,-2,4,-1
expect: => i=16 r=0.0 ok=true s="sorted squares max 16" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
test: list=5,-6,2
expect: => i=36 r=0.0 ok=true s="sorted squares max 36" errors=0 n=3 res=[4,25,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		g.res[i] = x * x;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "sorted squares max ", out.i);
	g.steps += g.n * 2 + 1;
	out
}
@end
@entry acb186a4695728cd
kind: step
verb: pair
noun: digits
modifier: sorted
context: stats
phrase: pair digits modulo base {base} sorted
phrase: group digit pairs with base {base} sorted
phrase: sort paired digit remainders for base {base}
slot: base int
test: list=45,12,89,23 base=10
expect: => i=4 r=0.0 ok=true s="paired 4 digit pairs" errors=0 n=4 res=[12,23,45,89] cache=0 hits=0
test: list=105,32,77 base=10
expect: => i=3 r=0.0 ok=true s="paired 3 digit pairs" errors=0 n=3 res=[5,32,77] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = if ${base} <= 0 { 10 } else { ${base} };
	for i in g.n {
		let val = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		let d1 = (val / b) % b;
		let d2 = val % b;
		g.res[i] = d1 * b + d2;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired ", g.n, " digit pairs");
	g.steps += g.n * 2 + 1;
	out
}
@end
