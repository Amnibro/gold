fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let diff = g.res[g.n - 1] - g.res[g.n - 2];
	if diff > b {
		g.res[g.n - 1] = g.res[g.n - 2] + b;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "clamped last gap result ", g.res[g.n - 1]);
	out
}
@end
