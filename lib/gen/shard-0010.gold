expect: => i=1 r=0.0 ok=true s="reversed 1 alternate points" errors=0 n=5 res=[5,8,12,-14,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${baseline};
	var modified = 0;
	var i = 0;
	while i < g.n {
		if i % 2 == 1 && g.res[i] > b {
			g.res[i] = -g.res[i];
			modified++;
		}
		i++;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "reversed ", modified, " alternate points");
	gold_push(g, modified);
	g.steps += g.n;
	out
}
@end
