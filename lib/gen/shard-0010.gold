expect: => i=12 r=0.0 ok=true s="cached first reversed gap 12" errors=0 n=2 res=[12,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${slot_key};
	var gaps int[>..] = [];
	var i = g.n - 1;
	while i >= 1 {
		gaps.push(g.res[i] - g.res[i - 1]);
		i--;
	}
	for j in gaps.len {
		g.res[j] = gaps[j];
	}
	g.n = gaps.len;
	let lead = if g.n > 0 { g.res[0] } else { 0 };
	gold_cache_put(g, k, lead);
	g.steps += g.n;
	out.i = lead;
	out.s.clear();
	format(out.s, "cached first reversed gap ", lead);
	out
}
@end
