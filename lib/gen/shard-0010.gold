	let pl = ${prefix_len};
	if pl <= 0 || pl > g.n {
		gold_fail(g, "invalid prefix length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid prefix length ", pl);
		return out;
	}
	var is_sorted = true;
	for i in 1..pl {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
	}
	g.steps += pl;
	out.ok = is_sorted;
	out.i = pl;
	out.s.clear();
	if is_sorted {
		g.n = pl;
		format(out.s, "collected sorted prefix of ", pl, " items");
	} else {
		gold_fail(g, "prefix is not in sorted order");
		out.ok = false;
		format(out.s, "error: prefix not sorted");
	}
	out
}
