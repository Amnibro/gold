@entry 95588ba33df54f7e
kind: step
verb: keep
noun: pairs
modifier: all
context: compare
phrase: keep pairs all min_diff {min_diff}
phrase: retain adjacent elements with difference exceeding {min_diff}
slot: min_diff int
test: list=10,12,20,22,35 min_diff=5
expect: => i=3 r=0.0 ok=true s="kept paired differences count 3" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=1,5,6,12 min_diff=3
expect: => i=3 r=0.0 ok=true s="kept paired differences count 3" errors=0 n=3 res=[1,5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_diff};
	if g.n < 2 { return out; }
	var kept = 1;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff >= md {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept paired differences count ", kept);
	out
}
@end
