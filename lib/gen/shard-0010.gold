	let lo = ${low};
	let hi = ${high};
	var matching = 0;
	var i = 0;
	while i < out.s.len {
		var j = i;
		while j < out.s.len && out.s[j] == out.s[i] { j++; }
		let run_len = j - i;
		if run_len >= lo && run_len <= hi { matching++; }
		i = j;
	}
	out.i = matching;
	gold_push(g, matching);
	g.steps++;
	out
}
