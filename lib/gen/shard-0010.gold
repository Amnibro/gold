@entry 5cbee042791b3880
kind: step
verb: retry
noun: errors
modifier: while
context: stats
phrase: retry reducing errors while total exceeds {cap}
phrase: adjust deviations while sum is above {cap}
phrase: dampen errors while exceeding bound {cap}
slot: cap int
test: list=20,40,60 cap=35
expect: => i=30 r=0.0 ok=true s="error reduced to 30 in 2" errors=0 n=4 res=[5,10,15,30] cache=0 hits=0
test: list=100,80,50 cap=60
expect: => i=57 r=0.0 ok=true s="error reduced to 57 in 2" errors=0 n=4 res=[25,20,12,57] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${cap};
	var total_err = 0;
	for i in g.n {
		total_err += if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
	}
	var rounds = 0;
	while total_err > target && rounds < 10 {
		var new_err = 0;
		for i in g.n {
			g.res[i] = g.res[i] / 2;
			new_err += if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		}
		total_err = new_err;
		rounds++;
	}
	out.i = total_err;
	out.s.clear();
	format(out.s, "error reduced to ", total_err, " in ", rounds);
	gold_push(g, total_err);
	g.steps += rounds * g.n + 1;
	out
}
@end
