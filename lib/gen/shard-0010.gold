expect: => i=3 r=0.0 ok=true s="filtered 3 reverse counter items" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var buf int[512] = [0; 512];
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] > 0 {
			buf[kept] = g.res[i];
			kept++;
		}
	}
	for k in kept { g.res[k] = buf[k]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " reverse counter items");
	out
}
@end
