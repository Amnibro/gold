code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_tally};
	if mt <= 0 {
		gold_fail(g, "non positive max tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid max tally");
		return out;
	}
	var count = 0;
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
		count++;
		if count >= mt {
			break;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "safely recorded tally of ", count, " items");
	out
}
@end
