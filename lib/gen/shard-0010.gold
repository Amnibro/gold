fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tail_k};
	if k <= 0 {
		gold_fail(g, "non positive tail size to collect");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid tail size ", k);
		return out;
	}
	if k > g.n {
		gold_fail(g, "requested tail size exceeds results length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cannot collect ", k, " items from ", g.n);
		return out;
	}
	let start = g.n - k;
	for i in k {
		g.res[i] = g.res[start + i];
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "safely collected tail of ", k, " items");
	out
}
@end
