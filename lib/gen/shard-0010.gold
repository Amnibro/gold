		var i = 0;
		while i + 1 < g.n {
			let g_val = if g.res[i+1] >= g.res[i] { g.res[i+1] - g.res[i] } else { g.res[i] - g.res[i+1] };
			if g_val >= lg && g_val <= hg {
				matched_gaps++;
			}
			i++;
		}
	}
	out.i = matched_gaps;
