expect: => i=1 r=0.0 ok=true s="target at 1 after 1 tries" errors=0 n=5 res=[5,15,25,35,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var b = ${bound};
	let tgt = ${target};
	var found_idx = -1;
	var tries = 0;
	while tries < 3 && found_idx == -1 {
		let max_idx = if b < g.n { b } else { g.n };
		for i in max_idx {
			if g.res[i] == tgt {
				found_idx = i;
				break;
			}
		}
		if found_idx == -1 {
			b *= 2;
			tries++;
		}
	}
	out.i = found_idx;
	out.s.clear();
	format(out.s, "target at ", found_idx, " after ", tries, " tries");
	gold_push(g, found_idx);
	g.steps += tries + 1;
	out
}
@end
