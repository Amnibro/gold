phrase: exchange paired numeric words under retry limit {attempts}
slot: attempts int
test: list=40,20,30,10 attempts=2
expect: => i=2 r=0.0 ok=true s="completed word swaps: 2" errors=0 n=4 res=[20,40,10,30] cache=0 hits=0
test: list=50,15,25 attempts=1
expect: => i=1 r=0.0 ok=true s="completed word swaps: 1" errors=0 n=3 res=[15,50,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${attempts};
	var swap_count = 0;
	var p = 0;
	while p + 1 < g.n && swap_count < max_swaps {
		if g.res[p] > g.res[p + 1] {
			let tmp = g.res[p];
			g.res[p] = g.res[p + 1];
			g.res[p + 1] = tmp;
			swap_count++;
		}
		p += 2;
	}
	g.steps += g.n;
	out.i = swap_count;
	out.s.clear();
	format(out.s, "completed word swaps: ", swap_count);
	out
}
@end
