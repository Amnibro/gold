fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	let n = if pl < g.n { pl } else { g.n };
	for i in n {
		for j in i + 1..n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = n;
	g.steps += n * n;
	out.i = n;
	out.s.clear();
	format(out.s, "returned prefix of length ", n);
	out
}
@end
