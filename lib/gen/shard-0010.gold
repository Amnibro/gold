@entry 1cd62e5e4798df5b
kind: step
verb: repeat
noun: primes
modifier: nested
context: sort
phrase: repeat sorted prime values using nested passes {depth}
phrase: duplicate prime numbers in sorted array with depth {depth}
slot: depth int
test: list=2,3,4,5,6 depth=2
expect: => i=8 r=0.0 ok=true s="repeated primes producing 8 entries" errors=0 n=8 res=[2,2,3,3,4,5,5,6] cache=0 hits=0
test: list=7,8,9,11 depth=1
expect: => i=4 r=0.0 ok=true s="repeated primes producing 4 entries" errors=0 n=4 res=[7,8,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var buf int[512] = [0; 512];
	var bn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var div = 2;
		while div * div <= x {
			if x % div == 0 { is_p = false; break; }
			div++;
		}
		let rep = if is_p { d } else { 1 };
		for k in rep {
			if bn < 512 { buf[bn] = x; bn++; }
		}
	}
	for k in bn { g.res[k] = buf[k]; }
	g.n = bn;
	g.steps += bn;
	out.i = bn;
	out.s.clear();
	format(out.s, "repeated primes producing ", bn, " entries");
	out
}
@end
