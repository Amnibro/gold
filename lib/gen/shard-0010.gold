expect: => i=0 r=0.0 ok=false s="error: condition failed on last element" errors=1 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if mv <= 0 || g.n == 0 {
		gold_fail(g, "invalid fill minimum parameters");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid minimum fill");
		return out;
	}
	let last = g.res[g.n - 1];
	var added = 0;
	if ${cond}(last) {
		while g.n < mv && g.n < 500 && added < 20 {
			gold_push(g, last);
			added++;
		}
	}
	g.steps += added + 1;
	if added == 0 && g.n < mv {
		gold_fail(g, "condition did not hold to fill minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: condition failed on last element");
	} else {
		out.i = added;
		out.s.clear();
		format(out.s, "filled ", added, " items to reach minimum");
	}
	out
}
@end
