fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	var u_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			u_cnt++;
			if x < min_val { min_val = x; }
			if x > max_val { max_val = x; }
		}
	}
	let rng = max_val - min_val;
	g.steps += g.n;
	out.i = rng;
	out.s.clear();
	format(out.s, "unique span range: ", rng);
	out
}
@end
