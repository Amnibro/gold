fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var run = 0;
	var split_at = g.n;
	for i in g.n {
		run += g.res[i];
		if run >= lim {
			split_at = i + 1;
			break;
		}
	}
	g.n = split_at;
	g.steps += split_at;
	out.i = split_at;
