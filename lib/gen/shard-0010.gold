noun: average
modifier: unique
context: loop
slot: max_avg int
phrase: limit average unique entries keeping mean below {max_avg}
phrase: constrain loop average across unique results under {max_avg}
test: list=10,20,30 max_avg=15
expect: => i=1 r=0.0 ok=true s="dropped 1 items to keep average under 15" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=10 max_avg=-1
expect: => i=0 r=0.0 ok=false s="error: invalid average limit -1" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_avg};
	if ma <= 0 || g.n == 0 {
		gold_fail(g, "invalid average bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid average limit ", ma);
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var dropped = 0;
	while g.n > 0 && (sum / g.n) > ma {
		sum -= g.res[g.n - 1];
		g.n--;
		dropped++;
	}
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " items to keep average under ", ma);
	out
}
@end
