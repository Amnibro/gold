code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_bound = ${lo};
	let ceil_bound = ${hi};
	var found = false;
	var min_val = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= floor_bound && x <= ceil_bound {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = min_val;
	out.s.clear();
	format(out.s, "bounded minimum found ", min_val);
	out
}
@end
