code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 1;
	if g.n >= 2 {
		let last_val = g.res[g.n - 1];
		var i = g.n - 2;
		while i >= 0 && g.res[i] == last_val {
			streak++;
			i--;
		}
	} else if g.n == 0 {
		streak = 0;
	}
	g.steps += g.n;
	out.i = streak;
	out.s.clear();
	format(out.s, "last streak length ", streak);
	out
}
@end
