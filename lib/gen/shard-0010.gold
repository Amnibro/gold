@entry dd5fc1495cecf52b
kind: step
verb: validate
noun: evens
modifier: unique
context: stats
phrase: validate evens unique ceiling {ceiling}
phrase: verify evens unique bound {ceiling}
slot: ceiling int
test: list=2,4,6,8 ceiling=10
expect: => i=4 r=0.0 ok=true s="validated evens unique ok true" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=2,4,2 ceiling=10
expect: => i=0 r=0.0 ok=false s="validated evens unique ok false" errors=1 n=3 res=[2,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var ok = true;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			if g.res[i] > ceil { ok = false; break; }
			for j in (i + 1)..g.n {
				if g.res[j] == g.res[i] { ok = false; break; }
			}
			if !ok { break; }
		}
	}
	g.steps += g.n;
	out.ok = ok;
	if !ok {
		gold_fail(g, "even observations violated uniqueness or bound");
		out.i = 0;
	} else {
		out.i = g.n;
	}
	out.s.clear();
	format(out.s, "validated evens unique ok ", ok);
	out
}
@end
