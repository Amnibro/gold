fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	if fac <= 0 {
		gold_fail(g, "factor must be positive");
		out.ok = false;
		return out;
	}
	for i in g.n {
		let grp = g.res[i] / fac;
		let prev, ok = gold_cache_get(g, grp);
		gold_cache_put(g, grp, prev + 1);
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "grouped into ", g.cn, " memo buckets");
	out
}
@end
