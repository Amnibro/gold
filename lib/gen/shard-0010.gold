noun: numbers
modifier: unique
context: compare
phrase: clamp numbers unique to upper ceiling {cap}
phrase: restrict unique comparison numbers below limit {cap}
phrase: bind unique numbers within ceiling bound {cap}
slot: cap int
test: list=5,10,15,10,20 cap=12
expect: => i=4 r=0.0 ok=true s="clamped 4 unique numbers" errors=0 n=4 res=[5,10,12,12] cache=0 hits=0
test: list=20,30,40 cap=25
expect: => i=3 r=0.0 ok=true s="clamped 3 unique numbers" errors=0 n=3 res=[20,25,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			let val = if g.res[i] > c { c } else { g.res[i] };
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped ", kept, " unique numbers");
	out
}
@end
