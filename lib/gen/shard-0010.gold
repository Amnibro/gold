fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps_count = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		let gap = if diff < 0 { -diff } else { diff };
		if gap >= sp { gaps_count++; }
	}
	g.steps += g.n;
	out.i = gaps_count;
	out.s.clear();
	format(out.s, "ranked gaps exceeding span count ", gaps_count);
	out
}
@end
