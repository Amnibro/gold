noun: total
modifier: unique
context: loop
phrase: select total unique elements max_sum {max_sum}
phrase: sum unique loop elements up to total {max_sum}
slot: max_sum int
test: list=5,5,10,2,8 max_sum=15
expect: => i=15 r=0.0 ok=true s="selected unique total is 15" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=3,4,4,5,6 max_sum=10
expect: => i=7 r=0.0 ok=true s="selected unique total is 7" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var kept = 0;
	var running_sum = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; break; }
		}
		if !seen && running_sum + x <= ms {
			temp[kept] = x;
			running_sum += x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += g.n;
	out.i = running_sum;
	out.s.clear();
	format(out.s, "selected unique total is ", running_sum);
	out
}
@end
