	var p_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { p_cnt++; }
	}
	g.steps += g.n;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "all primes grouped: ", p_cnt, " of ", g.n);
	out
}
@end
