phrase: store digit sums in cache until reaching {ceiling}
slot: ceiling int
test: list=12,34,56 ceiling=8
expect: => i=2 r=0.0 ok=true s="cached digits for 2 items" errors=0 n=3 res=[12,34,56] cache=2 hits=0
test: list=102,401,999 ceiling=6
expect: => i=2 r=0.0 ok=true s="cached digits for 2 items" errors=0 n=3 res=[102,401,999] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var stored = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		if s > ceil { break; }
		gold_cache_put(g, g.res[i], s);
		stored++;
	}
	g.steps += stored;
	out.i = stored;
	out.s.clear();
	format(out.s, "cached digits for ", stored, " items");
	out
}
@end
@entry f6d4e4f03c717b54
kind: step
verb: compare
noun: primes
modifier: with_cache
context: core
phrase: compare prime counts checking against cache
phrase: verify prime items storing checks in cache
test: list=7,8,7,11
expect: => i=3 r=0.0 ok=true s="found 3 primes with cache" errors=0 n=4 res=[7,8,7,11] cache=3 hits=1
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=true s="found 0 primes with cache" errors=0 n=4 res=[4,6,8,9] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	for i in g.n {
		let x = g.res[i];
		let cv, hit = gold_cache_get(g, x);
		var is_p = false;
		if hit {
			is_p = cv == 1;
		} else {
			if x >= 2 {
				is_p = true;
				var d = 2;
				while d * d <= x {
					if x % d == 0 { is_p = false; break; }
					d++;
				}
			}
			gold_cache_put(g, x, if is_p { 1 } else { 0 });
		}
		if is_p { p_count++; }
	}
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "found ", p_count, " primes with cache");
	out
}
@end
