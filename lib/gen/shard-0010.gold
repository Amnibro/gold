@entry 57f909b90c432f7d
kind: step
verb: merge
noun: histogram
modifier: with_retry
context: transform
phrase: merge frequency counts into histogram with retry threshold {threshold}
phrase: aggregate frequency buckets retrying under limit {threshold}
slot: threshold int
test: list=1,2,2,3,3,3 threshold=2
expect: => i=3 r=0.0 ok=true s="merged histogram buckets: 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: list=5,5,5,6 threshold=4
expect: => i=2 r=0.0 ok=true s="merged histogram buckets: 2" errors=0 n=2 res=[15,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep_limit = ${threshold};
	var unique_count = 0;
	var sums int[16] = [0; 16];
	var vals int[16] = [0; 16];
	for i in g.n {
		var found_pos = -1;
		for j in unique_count {
			if vals[j] == g.res[i] {
				found_pos = j;
				break;
			}
		}
		if found_pos >= 0 {
			sums[found_pos] += g.res[i];
		} else if unique_count < 16 {
			vals[unique_count] = g.res[i];
			sums[unique_count] = g.res[i];
			unique_count++;
		}
	}
	for i in unique_count {
		g.res[i] = sums[i];
	}
	g.n = unique_count;
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "merged histogram buckets: ", unique_count);
	out
}
@end
