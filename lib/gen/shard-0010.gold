expect: => i=3 r=0.0 ok=true s="kept squares count 3" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,4,10 ceiling=5
expect: => i=2 r=0.0 ok=true s="kept squares count 2" errors=0 n=2 res=[1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x > lim { break; }
		if core_is_square(x) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept squares count ", kept);
	out
}
@end
