			if g.res[i] > g.res[i+1] {
				ordered = false;
				inversions++;
			}
			i++;
		}
	}
	out.i = inversions;
	out.ok = ordered;
	out.s.clear();
	format(out.s, "sequence ordered=", ordered, " inversions=", inversions);
	gold_push(g, inversions);
	g.steps += g.n + 1;
