code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pair sorting");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need at least pair of items");
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "shifted and sorted ", swaps, " inverted pairs");
	out
}
@end
@entry 217a034b48d007ea
kind: step
verb: find
noun: vowels
modifier: in_reverse
context: retry
phrase: find vowels in reverse text scanning backwards
phrase: locate last vowel scanning text in reverse order
test: text="hello world"
expect: => i=7 r=0.0 ok=true s="found last vowel at index 7" errors=0 n=0 res=[] cache=0 hits=0
test: text="rhythm"
expect: => i=-1 r=0.0 ok=false s="error: zero vowels in text" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text buffer for reverse vowel search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text");
		return out;
	}
	var last_vowel_idx = -1;
	var i = out.s.len - 1;
	while i >= 0 {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			last_vowel_idx = i;
			break;
		}
		i--;
	}
	g.steps += out.s.len;
	out.i = last_vowel_idx;
	out.s.clear();
	if last_vowel_idx < 0 {
		gold_fail(g, "no vowels found in text");
		out.ok = false;
		format(out.s, "error: zero vowels in text");
	} else {
		format(out.s, "found last vowel at index ", last_vowel_idx);
	}
	out
}
@end
