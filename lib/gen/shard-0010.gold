fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${margin};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n { if g.res[j] == x { freq++; } }
		if freq >= limit {
			var seen = false;
			for k in kept { if temp[k] == x { seen = true; break; } }
			if !seen {
				temp[kept] = x;
				kept++;
			}
