code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var clamped = 0;
	for i in g.n {
		let idx = g.n - 1 - i;
		if g.res[idx] % 2 != 0 && g.res[idx] > c {
			g.res[idx] = c;
			clamped++;
		}
	}
	gold_cache_put(g, c, clamped);
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "reverse clamped odds: ", clamped);
	out
}
@end
