		gold_clear(g);
		out.i = 0;
		return out;
	}
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in (g.n - 2) {
		let x = g.res[i + 1];
		var cnt = 0;
		for j in (g.n - 2) {
			if g.res[j + 1] == x { cnt++; }
		}
		if cnt == 1 {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " unique middle elements");
	out
}
