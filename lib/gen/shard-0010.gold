fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 1;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			if g.res[i] >= g.res[i-1] {
				cur_streak++;
			} else {
				if cur_streak > max_streak { max_streak = cur_streak; }
				cur_streak = 1;
			}
			i++;
		}
	}
	if cur_streak > max_streak { max_streak = cur_streak; }
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest sorted streak ", max_streak);
	gold_push(g, max_streak);
	g.steps += g.n + 1;
	out
}
@end
