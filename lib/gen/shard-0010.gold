test: list=10,20,30,40 count=2
expect: => i=70 r=0.0 ok=true s="tail reverse sum: 70" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20 count=-1
expect: => i=0 r=0.0 ok=false s="error: invalid tail count -1" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 || k > g.n {
		gold_fail(g, "invalid tail count for reverse sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid tail count ", k);
		return out;
	}
	var total = 0;
	var i = g.n - 1;
	var left = k;
	while left > 0 {
		total += g.res[i];
		i--;
		left--;
	}
	g.steps += k;
	out.i = total;
	out.s.clear();
	format(out.s, "tail reverse sum: ", total);
	out
}
@end
