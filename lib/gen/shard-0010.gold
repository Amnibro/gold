@entry 7741370a2ac8a1ef
kind: step
verb: group
noun: primes
modifier: while
context: stats
phrase: group primes while value remains below {limit}
phrase: collect prime observations while bounded by {limit}
slot: limit int
test: list=2,3,4,5,11,13 limit=10
expect: => i=3 r=0.0 ok=true s="grouped primes below limit: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,8,9,11,17 limit=15
expect: => i=2 r=0.0 ok=true s="grouped primes below limit: 2" errors=0 n=2 res=[7,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && x < lim {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped primes below limit: ", kept);
	out
}
@end
