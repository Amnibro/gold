fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[i+1];
			g.res[i+1] = tmp;
			i += 2;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "safely reversed ", g.n / 2, " step pairs");
	g.steps += g.n + 1;
	out
}
@end
