test: list=-5,-10,2 limit=50
expect: => i=17 r=0.0 ok=true s="total with retry: 17" errors=0 n=3 res=[-5,-10,2] cache=0 hits=0
test: list=10,20 limit=40
expect: => i=30 r=0.0 ok=true s="total with retry: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	if total < 0 {
		total = 0;
		for i in g.n {
			let x = g.res[i];
			total += if x < 0 { -x } else { x };
		}
	}
	if total > lim {
		gold_fail(g, "total exceeded limit");
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "total with retry: ", total);
	out
}
@end
