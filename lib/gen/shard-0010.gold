fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var span = k;
	if span > g.n { span = g.n; }
	if span <= 1 {
		out.i = 0;
		return out;
	}
	let start = g.n - span;
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > start {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[start] = last;
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "rotated last ", span, " elements");
	out
}
@end
