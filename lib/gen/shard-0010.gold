	let th = ${threshold};
	var count = 0;
	for i in out.s.len {
		var is_dup = false;
		for j in i {
			if out.s[j] == out.s[i] { is_dup = true; break; }
		}
		if !is_dup { count++; }
	}
	let res = if count >= th { count } else { 0 };
	gold_push(g, res);
	g.steps += out.s.len;
	out.i = res;
	out.s.clear();
	format(out.s, "unique text fold count ", res);
	out
}
@end
@entry a6d4d6295cb860b1
kind: step
