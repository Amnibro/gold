	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 { odds++; }
		g.res[i] = odds;
	}
	g.steps += g.n;
	out.i = odds;
	out.s.clear();
	format(out.s, "running odds total ", odds);
	out
}
@end
@entry d032d5fa3bf4715c
kind: step
verb: retry
noun: maximum
modifier: at_most
context: core
phrase: retry maximum at_most repeat limit {tries}
phrase: bound maximum at_most attempt ceiling {tries}
slot: tries int
test: list=10,5 tries=3
expect: => i=7 r=0.0 ok=true s="reduced maximum value 7" errors=0 n=2 res=[7,5] cache=0 hits=0
test: list=4,4 tries=1
expect: => i=3 r=0.0 ok=true s="reduced maximum value 3" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${tries};
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var count = 0;
	while count < max_tries {
		g.res[max_idx]--;
		count++;
	}
	g.steps += count;
	out.i = g.res[max_idx];
	out.s.clear();
	format(out.s, "reduced maximum value ", out.i);
	out
}
@end
