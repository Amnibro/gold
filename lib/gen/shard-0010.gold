modifier: nested
context: list
phrase: reverse nested interior digits of number
phrase: invert nested interior digits of number
phrase: reverse inner nested digits of number
test: arg=1234,152
expect: 1324
expect: 152
test: arg=12
expect: 12
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 100 { return x; }
	let last_d = x % 10;
	var mid = x / 10;
	var p = 1;
	while mid / p >= 10 { p *= 10; }
	let first_d = mid / p;
	let inner = mid % p;
	var rev_inner = 0;
	var temp = inner;
	var q = 1;
	while temp > 0 {
		rev_inner = rev_inner * 10 + temp % 10;
		temp /= 10;
		q *= 10;
	}
	while q < p {
		rev_inner *= 10;
		q *= 10;
	}
	(first_d * p + rev_inner) * 10 + last_d
}
@end
