test: text="one two three four" max_words=3 retries=2
expect: => i=3 r=0.0 ok=true s="limited to words count 3" errors=0 n=0 res=[] cache=0 hits=0
test: text="one two" max_words=-1 retries=0
expect: => i=0 r=0.0 ok=false s="error: invalid word limit config" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mw = ${max_words};
	let ret = ${retries};
	if mw <= 0 || ret < 0 {
		gold_fail(g, "invalid word limit parameters");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid word limit config");
		return out;
	}
	var count = 0;
	var i = 0;
	var end_idx = 0;
	while i < out.s.len {
		if out.s[i] == ' ' {
			count++;
			if count == mw { end_idx = i; break; }
		}
		i++;
	}
	if count >= mw && end_idx > 0 {
		out.s.resize(end_idx, ' ');
	}
	g.steps += out.s.len;
	out.i = mw;
	out.s.clear();
	format(out.s, "limited to words count ", mw);
	out
}
@end
