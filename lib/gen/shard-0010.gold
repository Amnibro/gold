@entry bdcf2848a76223c5
kind: step
verb: group
noun: primes
modifier: sorted
context: format
phrase: format prime elements grouped into sorted string
phrase: render sorted prime numbers string representation
test: list=4,2,6,3,8,5
expect: => i=3 r=0.0 ok=true s="sorted primes count: 3" errors=0 n=6 res=[4,2,6,3,8,5] cache=0 hits=0
test: list=7,11,4,13,9
expect: => i=3 r=0.0 ok=true s="sorted primes count: 3" errors=0 n=5 res=[7,11,4,13,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept {
		for j in (i + 1)..kept {
			if temp[j] < temp[i] {
				let tmp = temp[i];
				temp[i] = temp[j];
				temp[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted primes count: ", kept);
	out
}
@end
