test: list=50,12,88,23,19
expect: => i=88 r=0.0 ok=true s="swapped peak 88 to last" errors=0 n=5 res=[50,12,19,23,88] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for i in g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let last = g.n - 1;
	let tmp = g.res[max_idx];
	g.res[max_idx] = g.res[last];
	g.res[last] = tmp;
	out.i = tmp;
	out.s.clear();
	format(out.s, "swapped peak ", tmp, " to last");
	g.steps += g.n + 1;
	out
}
@end
