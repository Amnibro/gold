	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_idx = g.n - 1;
	let tmp = g.res[0];
	g.res[0] = g.res[last_idx];
	g.res[last_idx] = tmp;
	gold_cache_put(g, 0, g.res[0]);
	gold_cache_put(g, last_idx, g.res[last_idx]);
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "swapped head value to ", g.res[0]);
	out
}
@end
@entry 9e848d1d504631f9
kind: step
verb: reverse
noun: histogram
modifier: times
context: cache
phrase: reverse histogram items {times} times
phrase: invert frequency histogram order {times} times
slot: times int
test: list=1,2,3 times=1
expect: => i=3 r=0.0 ok=true s="reversed histogram after 1 cycles" errors=0 n=3 res=[3,2,1] cache=3 hits=0
test: list=10,20,30,40 times=2
expect: => i=4 r=0.0 ok=true s="reversed histogram after 2 cycles" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t % 2 != 0 {
		for i in g.n / 2 {
			let j = g.n - 1 - i;
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
		}
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed histogram after ", t, " cycles");
	out
}
@end
@entry 654ad67d42db09d5
kind: step
verb: scale
noun: sequence
modifier: pairwise
context: cache
phrase: scale sequence pairwise by factor {factor}
phrase: multiply pairwise sequence entries with factor {factor}
slot: factor int
test: list=1,2,3,4 factor=3
expect: => i=2 r=0.0 ok=true s="scaled 2 pairwise sequences" errors=0 n=4 res=[3,6,9,12] cache=2 hits=0
test: list=10,20 factor=2
expect: => i=1 r=0.0 ok=true s="scaled 1 pairwise sequences" errors=0 n=2 res=[20,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let prod = (g.res[i] + g.res[i + 1]) * f;
		gold_cache_put(g, pairs, prod);
		g.res[i] = g.res[i] * f;
		g.res[i + 1] = g.res[i + 1] * f;
		pairs++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "scaled ", pairs, " pairwise sequences");
	out
}
@end
