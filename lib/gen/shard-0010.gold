@entry 94ab1d938a145533
kind: step
verb: merge
noun: average
modifier: last
context: aggregate
phrase: merge average of last {count} elements into final value
phrase: combine trailing {count} items into average score
slot: count int
test: list=10,20,30 count=2
expect: => i=25 r=0.0 ok=true s="merged last 2 elements to average 25" errors=0 n=2 res=[10,25] cache=0 hits=0
test: list=5,15,25,35 count=3
expect: => i=25 r=0.0 ok=true s="merged last 3 elements to average 25" errors=0 n=2 res=[5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 { return out; }
	let start = if g.n > c { g.n - c } else { 0 };
	var sum = 0;
	for i in start..g.n {
		sum += g.res[i];
	}
	let len = g.n - start;
	let avg = sum / len;
	g.res[start] = avg;
	g.n = start + 1;
	g.steps += len;
	out.i = avg;
	out.s.clear();
	format(out.s, "merged last ", len, " elements to average ", avg);
	out
}
@end
