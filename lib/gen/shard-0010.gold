expect: => i=10 r=0.0 ok=true s="kept 2 items within budget 10" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "kept ", kept, " items within budget ", spent);
	out
}
@end
@entry 6efc76f60a7d3904
kind: step
verb: trace
noun: primes
modifier: up_to
context: loop
phrase: trace prime numbers in loop up to limit {limit}
phrase: count prime loop items up to value {limit}
phrase: record loop prime numbers up to threshold {limit}
slot: limit int
test: list=2,3,4,5,6,7 limit=6
expect: => i=3 r=0.0 ok=true s="traced 3 primes up to bound" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=10,11,12,13 limit=15
expect: => i=2 r=0.0 ok=true s="traced 2 primes up to bound" errors=0 n=4 res=[10,11,12,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${limit};
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 && x <= bound {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes_count++; }
		}
	}
	g.steps += g.n;
	out.i = primes_count;
	out.s.clear();
	format(out.s, "traced ", primes_count, " primes up to bound");
	out
}
@end
