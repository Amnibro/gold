@entry a1c3df6a14d0f88c
kind: step
verb: merge
noun: streak
modifier: while
context: cache
phrase: merge streak while predicate {p} matches in cache
phrase: combine contiguous streak while condition {p} holds
slot: p pred
test: list=2,4,6,5,8 p=is_even
expect: => i=12 r=0.0 ok=true s="merged streak of 3 elements sum 12" errors=0 n=3 res=[12,5,8] cache=1 hits=0
