kind: step
verb: limit
noun: digits
modifier: running
context: loop
slot: max_digits int
phrase: limit digits running count in text up to {max_digits}
phrase: restrict running numeric digits in string under {max_digits}
test: text="a1b2c3d4" max_digits=2
expect: => i=2 r=0.0 ok=true s="retained 2 digits under limit 2" errors=0 n=0 res=[] cache=0 hits=0
test: text="a1b2" max_digits=-1
expect: => i=0 r=0.0 ok=false s="error: invalid digit bound -1" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	if md <= 0 || out.s.len == 0 {
		gold_fail(g, "invalid digit limit or empty text");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid digit bound ", md);
		return out;
	}
	var digit_count = 0;
	var write_idx = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			if digit_count < md {
				out.s[write_idx] = c;
				write_idx++;
				digit_count++;
			}
		} else {
			out.s[write_idx] = c;
			write_idx++;
		}
	}
	out.s.resize(write_idx, ' ');
	g.steps += out.s.len;
	out.i = digit_count;
	out.s.clear();
	format(out.s, "retained ", digit_count, " digits under limit ", md);
	out
}
@end
