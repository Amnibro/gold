test: list=2,3,5,7,11,13
expect: => i=18 r=0.0 ok=true s="alternate prime sum: 18" errors=0 n=6 res=[2,3,5,7,11,13] cache=0 hits=0
test: list=3,4,5,6,7
expect: => i=15 r=0.0 ok=true s="alternate prime sum: 15" errors=0 n=5 res=[3,4,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { prime_sum += x; }
		i += 2;
	}
	g.steps += g.n;
	out.i = prime_sum;
	out.s.clear();
	format(out.s, "alternate prime sum: ", prime_sum);
	out
}
@end
