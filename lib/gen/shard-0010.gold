test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="rotated elements by offset: 1" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 offset=2
expect: => i=2 r=0.0 ok=true s="rotated elements by offset: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n < 2 || off <= 0 { return out; }
	let k = off % g.n;
	if k == 0 { return out; }
	var temp int[512] = [0; 512];
	for i in g.n {
		let dest = (i + k) % g.n;
		temp[dest] = g.res[i];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated elements by offset: ", k);
	out
}
@end
