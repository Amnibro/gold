expect: => i=16 r=0.0 ok=true s="shifted total by 10: 16" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sa = ${shift_amount};
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let shifted = total + sa;
	g.steps += g.n;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted total by ", sa, ": ", shifted);
	out
}
@end
