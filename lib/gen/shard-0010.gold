test: list=1,3,6,10
expect: => i=0 r=0.0 ok=false s="uniform gap status: false" errors=0 n=4 res=[1,3,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniform = true;
	if g.n > 2 {
		let diff = g.res[1] - g.res[0];
		for i in 1..(g.n - 1) {
			if g.res[i + 1] - g.res[i] != diff {
				uniform = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = uniform;
	out.i = if uniform { 1 } else { 0 };
	out.s.clear();
	format(out.s, "uniform gap status: ", uniform);
	out
}
@end
