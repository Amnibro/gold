fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var run_tally = 0;
	var stopped_at = g.n;
	var i = 0;
	while i < g.n {
		run_tally += if g.res[i] > 0 { 1 } else { 0 };
		if run_tally >= lim {
			stopped_at = i + 1;
			break;
		}
		i++;
	}
	out.i = run_tally;
	out.s.clear();
	format(out.s, "tallied ", run_tally, " at index ", stopped_at);
	gold_push(g, run_tally);
	g.steps += stopped_at + 1;
	out
}
@end
