kind: step
verb: sum
noun: budget
modifier: until
context: cache
phrase: sum budget until capacity limit {budget}
phrase: deplete budget capacity limit {budget}
slot: budget int
test: list=10,15,20,25 budget=30
expect: => i=2 r=0.0 ok=true s="consumed budget items: 2" errors=0 n=4 res=[10,15,20,25] cache=1 hits=0
test: list=5,8,12,18 budget=20
expect: => i=2 r=0.0 ok=true s="consumed budget items: 2" errors=0 n=4 res=[5,8,12,18] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var count = 0;
	for i in g.n {
		if g.res[i] > rem { break; }
		rem -= g.res[i];
		count++;
	}
