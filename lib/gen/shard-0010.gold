	let mg = ${max_gap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gn = g.n - 1;
	for i in gn {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.n = gn;
	let r = if mg > gn { gn } else { mg };
	for s in r {
		let last = g.res[gn - 1];
		var j = gn - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "computed and rotated ", gn, " gaps");
	out
}
@end
