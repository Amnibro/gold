noun: numbers
modifier: with_cache
context: math
phrase: reverse numbers with cache tag {cache_key}
phrase: invert numbers with cache slot {cache_key}
slot: cache_key int
test: list=1,2,3 cache_key=1
expect: => i=3 r=0.0 ok=true s="numbers reversed cached head 3" errors=0 n=3 res=[3,2,1] cache=1 hits=0
test: list=10,20 cache_key=2
expect: => i=20 r=0.0 ok=true s="numbers reversed cached head 20" errors=0 n=2 res=[20,10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${cache_key};
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	let head = if g.n > 0 { g.res[0] } else { 0 };
	gold_cache_put(g, key, head);
	g.steps += g.n;
	out.i = head;
	out.s.clear();
	format(out.s, "numbers reversed cached head ", head);
	out
}
@end
