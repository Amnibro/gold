test: list=5,15 max_att=4
expect: => i=0 r=0.0 ok=true s="checkpoint retry completed at attempt 0" errors=0 n=2 res=[5,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ma = ${max_att};
	var att = 0;
	while att < ma {
		let val, ok = gold_cache_get(g, att);
		if !ok {
			gold_cache_put(g, att, att + 1);
			break;
		}
		att++;
	}
	g.steps += (att + 1);
	out.i = att;
	out.s.clear();
	format(out.s, "checkpoint retry completed at attempt ", att);
	out
}
@end
