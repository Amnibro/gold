fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var val = g.res[g.n - 1];
	if val < 0 { val = -val; }
	var sum = 0;
	while val > 0 {
		sum += val % 10;
		val /= 10;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "traced digits sum of last item: ", sum);
	out
}
