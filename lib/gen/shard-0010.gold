phrase: swap first increasing streak to front of results
phrase: move initial ordered streak to first position
phrase: exchange first streak items to front of list
test: list=10,20,30,5,15
expect: => i=3 r=0.0 ok=true s="first streak length 3" errors=0 n=6 res=[30,20,10,5,15,3] cache=0 hits=0
test: list=2,4,6,8,1,3
expect: => i=4 r=0.0 ok=true s="first streak length 4" errors=0 n=7 res=[8,6,4,2,1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak_end = 0;
	while streak_end + 1 < g.n && g.res[streak_end + 1] >= g.res[streak_end] {
		streak_end++;
	}
	var p1 = 0;
	var p2 = streak_end;
	while p1 < p2 {
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		p1++;
		p2--;
	}
	out.i = streak_end + 1;
	out.s.clear();
	format(out.s, "first streak length ", streak_end + 1);
	gold_push(g, streak_end + 1);
	g.steps += streak_end + 1;
	out
}
@end
