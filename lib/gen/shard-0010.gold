expect: => i=1 r=0.0 ok=true s="deduped running limit to 1 items" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= c {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped running limit to ", kept, " items");
	out
}
@end
