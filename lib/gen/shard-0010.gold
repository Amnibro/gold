test: list=10,20,20,30
expect: => i=1 r=0.0 ok=true s="collected unique middle items: 1" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	var temp int[512] = [0; 512];
	var kept = 0;
	for i in 1..(g.n - 1) {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected unique middle items: ", kept);
	out
}
@end
