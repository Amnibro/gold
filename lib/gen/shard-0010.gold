fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = if ${start_idx} < 0 { 0 } else { ${start_idx} };
	let e = if ${end_idx} >= g.n { g.n - 1 } else { ${end_idx} };
	var sum = 0;
	var count = 0;
	if s <= e && s < g.n {
		var i = s;
		while i <= e {
			sum += g.res[i];
			count++;
			i++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "merged ", count, " items sum ", sum);
	gold_push(g, sum);
	g.steps += count + 1;
	out
}
