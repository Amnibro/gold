@entry e5c550c0b5f01c0f
kind: step
verb: dedupe
noun: values
modifier: until
context: transform
phrase: dedupe values until reaching cap {cap}
phrase: remove duplicate values until size {cap}
phrase: eliminate duplicate values until length {cap}
slot: cap int
test: list=1,2,2,3,3,4,5 cap=3
expect: => i=3 r=0.0 ok=true s="deduped values until cap: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,10,30,40,30 cap=2
expect: => i=2 r=0.0 ok=true s="deduped values until cap: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	let target_cap = ${cap};
	for i in g.n {
		if kept >= target_cap { break; }
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped values until cap: ", kept);
	out
}
@end
