@entry 2b68919a65d90f71
kind: step
verb: retry
noun: middle
modifier: with_retry
context: search
phrase: search middle element for query {query} with retry
phrase: evaluate middle entry against {query} with retry
phrase: inspect middle position for {query} with retry
slot: query int
test: list=10,20,30,40,50 query=30
expect: => i=1 r=0.0 ok=true s="search found=true in 0 tries" errors=0 n=6 res=[10,20,30,40,50,1] cache=0 hits=0
test: list=5,15,25,35,45 query=35
expect: => i=1 r=0.0 ok=true s="search found=true in 1 tries" errors=0 n=6 res=[5,15,25,35,45,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let q = ${query};
	var found = false;
	var offset = 0;
	var iters = 0;
	while iters < 5 && !found {
		let mid = g.n / 2 + offset;
		if mid >= 0 && mid < g.n {
			if g.res[mid] == q {
				found = true;
				break;
			} else if g.res[mid] < q {
				offset++;
			} else {
				offset--;
			}
		}
		iters++;
	}
	out.i = if found { 1 } else { 0 };
	out.ok = found;
	out.s.clear();
	format(out.s, "search found=", found, " in ", iters, " tries");
	gold_push(g, if found { 1 } else { 0 });
	g.steps += iters + 1;
	out
}
@end
@entry 1efcacb2ba444368
kind: step
verb: sum
noun: window
modifier: until
context: transform
phrase: sum sliding window until limit {cap}
phrase: transform window sums until reaching {cap}
slot: cap int
test: list=5,10,15,20 cap=20
expect: => i=15 r=0.0 ok=true s="window sums until cap: 15" errors=0 n=1 res=[15] cache=0 hits=0
test: list=2,4,6,8,10 cap=15
expect: => i=6 r=0.0 ok=true s="window sums until cap: 6" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let limit = ${cap};
	var temp int[512] = [0; 512];
	var count = 0;
	var running = 0;
	for i in (g.n - 1) {
		let wsum = g.res[i] + g.res[i + 1];
		if running + wsum > limit { break; }
		running += wsum;
		temp[count] = wsum;
		count++;
	}
	for i in count { g.res[i] = temp[i]; }
	g.n = count;
	g.steps += count;
	out.i = running;
	out.s.clear();
	format(out.s, "window sums until cap: ", running);
	out
}
@end
@entry 9c71fd96a1306bc5
kind: step
verb: scale
noun: threshold
modifier: while
context: search
phrase: scale search threshold {initial_th} by {factor} while no match
phrase: adjust threshold {initial_th} factor {factor} while searching
phrase: multiply threshold {initial_th} by {factor} while missing target
slot: initial_th int
slot: factor int
test: list=5,12,18,24 initial_th=50 factor=2
expect: => i=1 r=0.0 ok=true s="matched index 1 threshold 12" errors=0 n=5 res=[5,12,18,24,1] cache=0 hits=0
test: list=2,6,10,15 initial_th=80 factor=3
expect: => i=2 r=0.0 ok=true s="matched index 2 threshold 8" errors=0 n=5 res=[2,6,10,15,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var th = ${initial_th};
	let f = if ${factor} <= 1 { 2 } else { ${factor} };
	var rounds = 0;
	var match_idx = -1;
	while rounds < 10 && match_idx == -1 {
		for i in g.n {
			if g.res[i] >= th {
				match_idx = i;
				break;
			}
		}
		if match_idx == -1 {
			th /= f;
			rounds++;
		}
	}
	out.i = match_idx;
	out.s.clear();
	format(out.s, "matched index ", match_idx, " threshold ", th);
	gold_push(g, match_idx);
	g.steps += rounds + 1;
	out
}
@end
