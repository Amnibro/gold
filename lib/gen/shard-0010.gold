fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_vowels};
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_lower_v = (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u');
		if is_lower_v && count < mv {
			out.s[i] = c - 32;
			count++;
		}
	}
	g.steps += count;
	out.i = count;
	out
}
