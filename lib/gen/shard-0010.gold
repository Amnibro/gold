context: aggregate
phrase: count steps recursively from initial {seed}
phrase: aggregate steps recursively starting at {seed}
slot: seed int
test: input=0 seed=5
expect: => i=8 r=0.0 ok=true s="recursive step aggregate 8" errors=0 n=0 res=[] cache=0 hits=0
test: input=0 seed=8
expect: => i=15 r=0.0 ok=true s="recursive step aggregate 15" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${seed};
	var steps_done = 0;
	while s > 0 {
		steps_done += s;
		s /= 2;
	}
	g.steps += steps_done;
	out.i = steps_done;
	out.s.clear();
	format(out.s, "recursive step aggregate ", steps_done);
	out
}
@end
@entry 1be590d648439a44
kind: step
verb: reverse
noun: limit
modifier: at_most
context: aggregate
phrase: reverse limit at most up to count {cap}
phrase: invert limit at most first {cap} elements
slot: cap int
test: list=1,2,3,4,5 cap=3
expect: => i=3 r=0.0 ok=true s="reversed prefix count 3" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 cap=2
expect: => i=2 r=0.0 ok=true s="reversed prefix count 2" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let m = if c < g.n { c } else { g.n };
	for i in (m / 2) {
		let tmp = g.res[i];
		g.res[i] = g.res[m - 1 - i];
		g.res[m - 1 - i] = tmp;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "reversed prefix count ", m);
	out
}
@end
