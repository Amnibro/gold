fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mo = ${max_offset};
	let k = if mo > g.n { g.n } else if mo < 0 { 0 } else { mo };
	if g.n > 1 && k > 0 {
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated budget at most by ", k);
	out
}
@end
