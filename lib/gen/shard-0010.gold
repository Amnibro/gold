fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var last_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > lim {
			last_idx = i;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = last_idx;
	out.ok = last_idx >= 0;
	out.s.clear();
	format(out.s, "last index above cutoff ", last_idx);
	out
}
@end
