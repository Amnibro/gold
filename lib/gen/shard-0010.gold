fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	for i in g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
	}
	let code = if is_sorted { 1 } else { 0 };
	gold_cache_put(g, 0, code);
	out.i = code;
	out.ok = is_sorted;
	out.s.clear();
	if is_sorted {
		format(out.s, "cache confirmed sorted");
	} else {
		format(out.s, "cache confirmed unsorted");
	}
	g.steps += g.n;
	out
}
@end
