@entry d323fe1198496f63
kind: step
verb: sum
noun: threshold
modifier: in_reverse
context: format
phrase: format reverse elements exceeding threshold {threshold}
phrase: render backward sequence above threshold {threshold} into text
slot: threshold int
test: list=5,15,25,8 threshold=10
expect: => i=40 r=0.0 ok=true s="reverse sum above 10 is 40" errors=0 n=4 res=[5,15,25,8] cache=0 hits=0
test: list=1,20,30,2 threshold=15
expect: => i=50 r=0.0 ok=true s="reverse sum above 15 is 50" errors=0 n=4 res=[1,20,30,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var total = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[g.n - 1 - i];
		if x >= th {
			total += x;
			count++;
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "reverse sum above ", th, " is ", total);
	out
}
@end
@entry 16b30a326cd3f11d
kind: step
verb: find
noun: number
modifier: with_cache
context: format
phrase: format search result finding number {target} with cache
phrase: render lookup status for value {target} using cache
slot: target int
test: list=10,20,30 target=20
expect: => i=20 r=0.0 ok=true s="find number 20 with cache: true" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=1,2,3 target=5
expect: => i=5 r=0.0 ok=false s="find number 5 with cache: false" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	for i in g.n {
		if g.res[i] == tgt {
			found = true;
			gold_cache_put(g, tgt, i);
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = tgt;
	out.s.clear();
	format(out.s, "find number ", tgt, " with cache: ", found);
	out
}
@end
@entry af0e0c1a436c9de9
kind: step
verb: split
noun: function
modifier: unique
context: format
phrase: format distinct results after applying function {sub}
phrase: render unique sequence values transformed with {sub}
slot: sub fn
test: list=1,1,2 sub=double
expect: => i=2 r=0.0 ok=true s="split function unique count: 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=10,10,20 sub=inc
expect: => i=2 r=0.0 ok=true s="split function unique count: 2" errors=0 n=2 res=[11,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var kept = 0;
	for i in g.n {
		let y = ${sub}(g.res[i]);
		var seen = false;
		for j in kept {
			if temp[j] == y { seen = true; }
		}
		if !seen {
			temp[kept] = y;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "split function unique count: ", kept);
	out
}
@end
