fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		var att = 0;
		while x % 2 != 0 && att < max_att {
			x = x * 2;
			att++;
		}
		if x % 2 == 0 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "evens preserved after retries ", kept);
	out
}
@end
