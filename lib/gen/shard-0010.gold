code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var matching = 0;
	if g.n >= 2 {
		for i in 0..(g.n - 1) {
			let s = g.res[i] + g.res[i + 1];
			if s >= lo && s <= hi { matching++; }
		}
	}
	g.steps += g.n;
	out.i = matching;
	out.s.clear();
	format(out.s, "pairs in bounds count ", matching);
	out
}
@end
