test: list=1,1,1,2,2,3,4,4,4,4 length=3
expect: => i=2 r=0.0 ok=true s="traced nested runs count 2" errors=0 n=10 res=[1,1,1,2,2,3,4,4,4,4] cache=0 hits=0
test: list=10,20,30 length=2
expect: => i=0 r=0.0 ok=true s="traced nested runs count 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${length};
	if g.n == 0 || min_len <= 1 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var run = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			run++;
		} else {
			if run >= min_len { count++; }
			run = 1;
		}
	}
	if run >= min_len { count++; }
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "traced nested runs count ", count);
	out
}
@end
