@entry 6077c564c4aaa060
kind: step
verb: find
noun: checkpoint
modifier: sorted
context: error
slot: target int
phrase: find checkpoint sorted in sequence matching {target}
phrase: locate target {target} within sorted checkpoint results
test: list=2,4,6,8,10 target=6
expect: => i=2 r=0.0 ok=true s="found checkpoint 6 at sorted index 2" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
test: list=10,8,6 target=6
expect: => i=0 r=0.0 ok=false s="error: list is unsorted" errors=1 n=3 res=[10,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results for sorted checkpoint");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		i++;
	}
	if !is_sorted {
		gold_fail(g, "results not sorted in ascending order");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list is unsorted");
		return out;
	}
	var found_idx = -1;
	for j in g.n {
		if g.res[j] == tgt { found_idx = j; break; }
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx < 0 {
		gold_fail(g, "checkpoint target not found in sorted results");
		out.ok = false;
		format(out.s, "error: target ", tgt, " missing");
	} else {
		format(out.s, "found checkpoint ", tgt, " at sorted index ", found_idx);
	}
	out
}
@end
