expect: => i=30 r=0.0 ok=true s="found last duplicate value 30" errors=0 n=5 res=[10,20,20,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var found = -1;
	var i = g.n - 1;
	while i >= 0 {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt >= mc {
			found = g.res[i];
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "found last duplicate value ", found);
	out
}
@end
