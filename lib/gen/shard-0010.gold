expect: => i=2 r=0.0 ok=true s="dropped 2 occurrences of 3" errors=0 n=2 res=[5,7] cache=0 hits=0
test: list=1,2 target=9 retries=-1
expect: => i=0 r=0.0 ok=false s="error: invalid drop parameters" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	if r <= 0 || g.n == 0 {
		gold_fail(g, "invalid retry count or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid drop parameters");
		return out;
	}
	var dropped = 0;
	var write_idx = 0;
	for i in g.n {
		if g.res[i] == tgt && dropped < r {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	if dropped == 0 {
		gold_fail(g, "value not found within retries");
		out.ok = false;
		format(out.s, "error: target ", tgt, " not found");
	} else {
		format(out.s, "dropped ", dropped, " occurrences of ", tgt);
	}
	out
}
@end
