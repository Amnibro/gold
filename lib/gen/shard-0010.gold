expect: => i=4 r=0.0 ok=true s="computed running difference series length: 4" errors=0 n=4 res=[5,3,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var prev = g.res[0];
	for i in 1..g.n {
		let cur = g.res[i];
		g.res[i] = cur - prev;
		prev = cur;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed running difference series length: ", g.n);
	out
}
@end
