code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results for reverse search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	var found_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			found_idx = i;
			break;
		}
		i--;
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx < 0 {
		gold_fail(g, "target not found in series");
		out.ok = false;
		format(out.s, "error: target ", tgt, " not found in reverse");
	} else {
		format(out.s, "found target ", tgt, " at reverse index ", found_idx);
	}
	out
}
@end
