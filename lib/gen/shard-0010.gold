fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_letters = 0;
	for b in out.s {
		let is_lower = (b >= 'a' && b <= 'z');
		let is_upper = (b >= 'A' && b <= 'Z');
		let is_digit = (b >= '0' && b <= '9');
		if !is_lower && !is_upper && !is_digit {
			non_letters++;
		}
	}
	out.i = non_letters;
	out.s.clear();
	format(out.s, "counted ", non_letters, " non letter symbols");
	gold_push(g, non_letters);
	g.steps += out.s.len + 1;
	out
}
@end
@entry 3e3f6ba752712285
kind: step
verb: apply
noun: primes
modifier: between
context: transform
phrase: apply prime factor transformation between bounds {pmin} to {pmax}
phrase: transform prime numbers between {pmin} to {pmax}
slot: pmin int
slot: pmax int
test: list=2,3,4,5,6,7 pmin=3 pmax=6
expect: => i=2 r=0.0 ok=true s="transformed primes between bounds: 2" errors=0 n=6 res=[2,6,4,10,6,7] cache=0 hits=0
test: list=10,11,12,13,14 pmin=10 pmax=15
expect: => i=2 r=0.0 ok=true s="transformed primes between bounds: 2" errors=0 n=5 res=[10,22,12,26,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${pmin};
	let hi = ${pmax};
	var modified = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var is_p = x >= 2;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				g.res[i] = x * 2;
				modified++;
			}
		}
	}
	g.steps += modified;
	out.i = modified;
	out.s.clear();
	format(out.s, "transformed primes between bounds: ", modified);
	out
}
@end
