fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let elem = g.res[mid];
	if ${cond}(elem) {
		out.ok = true;
		out.i = elem;
		g.res[0] = elem;
		g.n = 1;
	} else {
		out.ok = false;
		g.n = 0;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "selected middle ", elem);
	out
}
