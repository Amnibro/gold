fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${finish};
	if s < 0 || e > out.s.len || s >= e {
		out.s.clear();
		out.i = 0;
		return out;
	}
	var buf byte[>..] = [];
	for i in s..e {
		buf.push(out.s[i]);
	}
	out.s.clear();
	out.s.append(buf);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
