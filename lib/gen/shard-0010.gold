expect: => i=0 r=0.0 ok=false s="error: low bound exceeds high bound" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo > hi {
		gold_fail(g, "invalid bounds for list caching");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: low bound exceeds high bound");
		return out;
	}
	var cached_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			gold_cache_put(g, x, x * 2);
			cached_count++;
		}
	}
	g.steps += g.n;
	out.i = cached_count;
	out.s.clear();
	format(out.s, "cached ", cached_count, " list items in range");
	out
}
@end
