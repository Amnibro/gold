test: list=1,2,2,3,3,3 reps=2
expect: => i=1 r=0.0 ok=true s="matching frequency patterns: 1" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=4,4,4,4 reps=4
expect: => i=1 r=0.0 ok=true s="matching frequency patterns: 1" errors=0 n=4 res=[4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let expected_reps = ${reps};
	var matched_patterns = 0;
	for i in g.n {
		var seen_before = false;
		for k in i {
			if g.res[k] == g.res[i] {
				seen_before = true;
				break;
			}
		}
		if !seen_before {
			var occ = 0;
			for j in g.n {
				if g.res[j] == g.res[i] {
					occ++;
				}
			}
			if occ == expected_reps {
				matched_patterns++;
			}
		}
	}
	g.steps += g.n;
	out.i = matched_patterns;
	out.s.clear();
	format(out.s, "matching frequency patterns: ", matched_patterns);
	out
}
@end
