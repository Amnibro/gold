code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let pairs = g.n / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " checkpoints leaving none");
	out
}
@end
