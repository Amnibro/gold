slot: cond pred
test: list=2,3,4,5 cond=is_even
expect: => i=2 r=0.0 ok=true s="shifted last condition index: 2" errors=0 n=4 res=[2,3,5,4] cache=0 hits=0
test: list=1,6,7,8 cond=is_odd
expect: => i=2 r=0.0 ok=true s="shifted last condition index: 2" errors=0 n=4 res=[1,6,8,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var last_idx = -1;
	for i in g.n {
		if ${cond}(g.res[i]) { last_idx = i; }
	}
	if last_idx >= 0 && last_idx < g.n - 1 {
		let val = g.res[last_idx];
		for i in last_idx..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = val;
	}
	g.steps += g.n;
	out.i = last_idx;
	out.s.clear();
	format(out.s, "shifted last condition index: ", last_idx);
	out
}
@end
