@entry 7c79205cfebad291
kind: step
verb: rotate
noun: limit
modifier: with_retry
context: search
phrase: rotate search limit with retry limit {retries}
phrase: cycle search boundary with retry attempts {retries}
slot: retries int
test: list=-2,5,10 retries=2
expect: => i=1 r=0.0 ok=true s="rotated with retry taking 1 steps" errors=0 n=3 res=[5,10,-2] cache=0 hits=0
test: list=-4,-1,8,12 retries=3
