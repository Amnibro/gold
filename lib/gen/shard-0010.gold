kind: step
verb: apply
noun: head
modifier: sorted
context: loop
phrase: apply head sorted sorting first three elements
phrase: order head elements into ascending sorted sequence
test: list=30,10,20,5
expect: => i=10 r=0.0 ok=true s="sorted head of sequence minimum is 10" errors=0 n=4 res=[10,20,30,5] cache=0 hits=0
test: list=10,20
expect: => i=0 r=0.0 ok=false s="error: insufficient items for head sort" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least three elements for head sorting");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items for head sort");
		return out;
	}
	// Sort first 3 elements with simple bubble sort
	for i in 3 {
		var j = 0;
		while j + 1 < 3 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	g.steps += 3;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted head of sequence minimum is ", g.res[0]);
	out
}
@end
@entry ba7b7e563e0b752f
kind: step
verb: group
noun: range
modifier: any
context: loop
slot: range_span int
phrase: group range any elements spanning at most {range_span}
phrase: cluster loop items into any group within span {range_span}
test: list=2,4,5,10,12 range_span=3
expect: => i=2 r=0.0 ok=true s="grouped items into 2 range clusters" errors=0 n=5 res=[2,4,5,10,12] cache=0 hits=0
test: list=2,4 range_span=-1
expect: => i=0 r=0.0 ok=false s="error: invalid range span -1" errors=1 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let span = ${range_span};
	if span <= 0 || g.n == 0 {
		gold_fail(g, "invalid range span");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid range span ", span);
		return out;
	}
	var groups = 0;
	var i = 0;
	while i < g.n {
		let start_val = g.res[i];
		var j = i + 1;
		while j < g.n {
			let d = g.res[j] - start_val;
			let abs_d = if d < 0 { -d } else { d };
			if abs_d > span { break; }
			j++;
		}
		groups++;
		i = j;
	}
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped items into ", groups, " range clusters");
	out
}
@end
