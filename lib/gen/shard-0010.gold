expect: => i=1 r=0.0 ok=true s="kept 1 gaps meeting threshold" errors=0 n=1 res=[7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var kept = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let abs_d = if diff < 0 { -diff } else { diff };
			if abs_d >= mg {
				g.res[kept] = abs_d;
				kept++;
			}
		}
	}
	gold_cache_put(g, mg, kept);
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " gaps meeting threshold");
	out
}
@end
