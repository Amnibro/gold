test: list=10,20,30 thresh=15 times=3
expect: => i=3 r=0.0 ok=true s="average comparison successes: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: thresh=20 times=-1
expect: => i=0 r=0.0 ok=false s="error: invalid average compare" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	let th = ${thresh};
	if g.n == 0 || t <= 0 {
		gold_fail(g, "invalid comparison parameters");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid average compare");
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var count = 0;
	for k in t {
		if avg >= th { count++; }
	}
	g.steps += g.n + t;
	out.i = count;
	out.s.clear();
	format(out.s, "average comparison successes: ", count);
	out
}
@end
