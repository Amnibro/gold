expect: => i=10 r=0.0 ok=true s="clamped cached mean: 10" errors=0 n=3 res=[5,10,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var mean = sum / g.n;
	if mean > c { mean = c; }
	gold_cache_put(g, c, mean);
	g.steps += g.n;
	out.i = mean;
	out.s.clear();
	format(out.s, "clamped cached mean: ", mean);
	out
}
@end
