@entry cc11022c24fbf08a
kind: step
verb: dedupe
noun: subfunction
modifier: running
context: cache
phrase: dedupe running items with subfunction {f}
phrase: filter consecutive values using subfunction {f}
slot: f fn
test: list=2,-2,3,-3 f=square
expect: => i=2 r=0.0 ok=true s="deduped to 2 running items" errors=0 n=2 res=[2,3] cache=1 hits=0
test: list=5,5,10,10,20 f=inc
expect: => i=3 r=0.0 ok=true s="deduped to 3 running items" errors=0 n=3 res=[5,10,20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_n = 0;
	var last_mapped = -999999;
	for i in g.n {
		let mapped = ${f}(g.res[i]);
		if i == 0 || mapped != last_mapped {
			g.res[new_n] = g.res[i];
			new_n++;
			last_mapped = mapped;
		}
	}
	g.n = new_n;
	gold_cache_put(g, 0, new_n);
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped to ", new_n, " running items");
	out
}
@end
@entry 4be31d7ca83a9a49
kind: step
verb: join
noun: gaps
modifier: times
context: cache
phrase: join cache gaps repeated {multiplier} times
phrase: multiply adjacent gaps by factor {multiplier}
slot: multiplier int
test: list=2,5,9,14 multiplier=3
expect: => i=36 r=0.0 ok=true s="joined scaled gaps sum 36" errors=0 n=3 res=[9,12,15] cache=1 hits=0
test: list=10,20,35,55 multiplier=2
expect: => i=90 r=0.0 ok=true s="joined scaled gaps sum 90" errors=0 n=3 res=[20,30,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var total_gap = 0;
	for i in g.n - 1 {
		let diff = (g.res[i + 1] - g.res[i]) * m;
		g.res[i] = diff;
		total_gap += diff;
	}
	g.n = g.n - 1;
	gold_cache_put(g, m, total_gap);
	g.steps += g.n;
	out.i = total_gap;
	out.s.clear();
	format(out.s, "joined scaled gaps sum ", total_gap);
	out
}
@end
