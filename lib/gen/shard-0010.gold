@entry 5a694daa462a1cc0
kind: step
verb: measure
noun: streak
modifier: last
context: filter
phrase: measure streak length of last value in results
phrase: filter results keeping trailing streak of identical elements
test: list=1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="last streak length is 3" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=10,20,20,20,20
expect: => i=4 r=0.0 ok=true s="last streak length is 4" errors=0 n=4 res=[20,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	var streak = 0;
	var idx = g.n;
	while idx > 0 && g.res[idx - 1] == last_val {
		streak++;
		idx--;
	}
	for i in streak { g.res[i] = last_val; }
	g.n = streak;
	g.steps += streak;
	out.i = streak;
	out.s.clear();
	format(out.s, "last streak length is ", streak);
	out
}
@end
