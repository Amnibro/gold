test: text="queries" max_len=4
expect: => i=4 r=0.0 ok=true s="quer" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var filtered byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		let is_alpha = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
		if is_alpha && filtered.len < ml {
			filtered.push(b);
		}
	}
	out.s = copy(filtered);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
