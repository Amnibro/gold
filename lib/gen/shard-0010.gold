noun: memo
modifier: unique
context: math
phrase: reverse memo unique cache records
phrase: invert memo unique cached entries
test: list=1,2,2,3
expect: => i=3 r=0.0 ok=true s="memo unique reversed cached 3" errors=0 n=4 res=[1,2,2,3] cache=3 hits=0
test: list=5,10
expect: => i=2 r=0.0 ok=true s="memo unique reversed cached 2" errors=0 n=2 res=[5,10] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_cnt = 0;
	var i = g.n - 1;
	while i >= 0 {
		var seen = false;
		for j in (i + 1)..g.n {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			gold_cache_put(g, unique_cnt, g.res[i]);
			unique_cnt++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = unique_cnt;
	out.s.clear();
	format(out.s, "memo unique reversed cached ", unique_cnt);
	out
}
@end
