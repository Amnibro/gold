@entry a83c80fd6314f8fa
kind: step
verb: limit
noun: duplicates
modifier: in_reverse
context: filter
phrase: limit duplicates in reverse keeping last occurrence of each
phrase: filter distinct elements backwards in reverse preserving tail
test: list=1,2,1,3,2,4
expect: => i=4 r=0.0 ok=true s="distinct elements reverse count: 4" errors=0 n=4 res=[1,3,2,4] cache=0 hits=0
test: list=5,10,5,20,10
expect: => i=3 r=0.0 ok=true s="distinct elements reverse count: 3" errors=0 n=3 res=[5,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in kept { if temp[j] == x { seen = true; break; } }
		if !seen {
			temp[kept] = x;
			kept++;
		}
		if i == 0 { break; }
		i--;
	}
	for j in (kept / 2) {
		let k = kept - 1 - j;
		let tmp = temp[j];
		temp[j] = temp[k];
		temp[k] = tmp;
	}
	for j in kept { g.res[j] = temp[j]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "distinct elements reverse count: ", kept);
	out
}
@end
