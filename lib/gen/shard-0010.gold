code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	g.steps += g.n;
	if g.steps > b {
		gold_fail(g, "search budget overrun");
		out.ok = false;
		out.i = 0;
	} else {
		out.i = b - g.steps;
	}
	out.s.clear();
	format(out.s, "remaining budget ", out.i);
	out
}
