fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let k = if c > g.n { g.n } else if c < 0 { 0 } else { c };
	var buf int[512] = [0; 512];
	let start = g.n - k;
	for i in k { buf[i] = g.res[start + i]; }
	for i in k {
		for j in i + 1..k {
			if buf[i] > buf[j] {
				let tmp = buf[i];
				buf[i] = buf[j];
				buf[j] = tmp;
			}
		}
	}
	for i in k { gold_push(g, buf[i]); }
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "repeated sorted suffix of ", k, " items");
	out
}
@end
