code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_rot};
	if g.n <= 1 || mr <= 0 {
		out.i = 0;
		return out;
	}
	let r = if mr > g.n { g.n } else { mr };
	for step in r {
		let last_val = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last_val;
	}
	g.steps += r * g.n;
	out.i = r;
	out.s.clear();
	format(out.s, "rotated numbers by ", r, " steps");
	out
}
@end
