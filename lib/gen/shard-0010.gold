fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${size};
	if g.n == 0 || limit <= 0 {
		out.i = 0;
		return out;
	}
	var k = limit;
	if k > g.n {
		k = g.n;
	}
	var max_val = g.res[0];
	for i in 1..k {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "head maximum=", max_val);
	out
}
@end
