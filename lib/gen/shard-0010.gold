	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		if g.res[i] > b { g.res[i] = b; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted clamped items: ", g.n);
	out
}
@end
