fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	let t = ${times};
	if t <= 0 || g.n == 0 {
		gold_fail(g, "invalid times count or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid drop parameters");
		return out;
	}
