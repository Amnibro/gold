@entry 018101fb8647bd87
kind: step
verb: scan
noun: range
modifier: recursively
context: stats
phrase: scan range recursively to depth {depth}
phrase: evaluate range across partitions to {depth} levels
phrase: inspect range recursively with depth {depth}
slot: depth int
test: list=10,30,5,25 depth=2
expect: => i=80 r=0.0 ok=true s="recursive span 80" errors=0 n=5 res=[10,30,5,25,80] cache=0 hits=0
test: list=1,8,2,9 depth=1
expect: => i=14 r=0.0 ok=true s="recursive span 14" errors=0 n=5 res=[1,8,2,9,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var total_span = 0;
	var step_size = g.n;
	var level = 0;
	while level < d && step_size > 1 {
		var idx = 0;
		while idx + 1 < g.n {
			let diff = if g.res[idx+1] >= g.res[idx] { g.res[idx+1] - g.res[idx] } else { g.res[idx] - g.res[idx+1] };
			total_span += diff;
			idx += 2;
		}
		step_size /= 2;
		level++;
	}
	out.i = total_span;
	out.s.clear();
	format(out.s, "recursive span ", total_span);
	gold_push(g, total_span);
	g.steps += level * 4 + 1;
	out
}
@end
