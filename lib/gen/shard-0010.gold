expect: => i=2 r=0.0 ok=true s="safely paired numbers count 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_bound};
	if g.n < 2 { return out; }
	var temp int[512] = [0; 512];
	let new_n = g.n / 2;
	for i in new_n {
		let sum = g.res[i * 2] + g.res[i * 2 + 1];
		temp[i] = if sum > mb { mb } else { sum };
	}
	for i in new_n { g.res[i] = temp[i]; }
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "safely paired numbers count ", new_n);
	out
}
@end
