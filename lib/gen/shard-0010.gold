@entry 9405df228ce6aa19
kind: step
verb: rank
noun: average
modifier: recursively
context: list
phrase: rank average recursively span {span}
phrase: evaluate average recursively window {span}
slot: span int
test: list=10,20,30,40,50 span=3
expect: => i=2 r=0.0 ok=true s="recursive average ranked count 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,10,15 span=2
expect: => i=1 r=0.0 ok=true s="recursive average ranked count 1" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n < sp {
		out.i = 0;
		return out;
	}
	var count = 0;
	var prev_avg = 0;
	var i = 0;
	while i + sp <= g.n {
		var sum = 0;
		for j in sp {
			sum += g.res[i + j];
		}
		let cur_avg = sum / sp;
		if i > 0 && cur_avg >= prev_avg {
			count++;
		}
		prev_avg = cur_avg;
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "recursive average ranked count ", count);
	out
}
@end
