			unique++;
			if unique >= c {
				break;
			}
		}
	}
	g.n = unique;
	gold_cache_put(g, 0, unique);
	g.steps += g.n;
	out.i = unique;
	out.s.clear();
	format(out.s, "deduped list to first ", unique, " items");
	out
}
