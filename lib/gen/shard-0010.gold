fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var i = mid;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n - mid;
	out.i = g.n - mid;
	out.s.clear();
	format(out.s, "reversed tail portion length ", out.i);
	out
}
@end
