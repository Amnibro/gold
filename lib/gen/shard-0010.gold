code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let mid = g.n / 2;
		let m1 = g.res[mid - 1];
		let m2 = g.res[mid];
		gold_push(g, m1);
		gold_push(g, m2);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated middle pair in loop");
	out
}
@end
