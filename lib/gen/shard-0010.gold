fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var evens int[512] = [0; 512];
	var o_cnt = 0;
	var e_cnt = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[o_cnt] = g.res[i];
			o_cnt++;
		} else {
			evens[e_cnt] = g.res[i];
			e_cnt++;
		}
	}
	for i in o_cnt { g.res[i] = odds[i]; }
	for i in e_cnt { g.res[o_cnt + i] = evens[i]; }
	g.steps += g.n;
	out.i = o_cnt;
	out.s.clear();
	format(out.s, "odds ranked first count=", o_cnt);
	out
}
@end
