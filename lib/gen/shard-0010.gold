fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bucket_size};
	if bs <= 0 { return out; }
	var b0 = 0;
	var b1 = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x < bs { b0++; }
		else if x >= bs && x < 2 * bs { b1++; }
	}
	g.steps += g.n;
	out.i = b0 + b1;
	out.s.clear();
	format(out.s, "histogram safely: b0=", b0, " b1=", b1);
	out
}
@end
