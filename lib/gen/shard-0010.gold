code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${limit};
	let r = ${rounds};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		if g.res[i] > thresh {
			temp[kept] = g.res[i];
			kept++;
		}
	}
	if r % 2 != 0 {
		for i in kept { g.res[i] = temp[kept - 1 - i]; }
	} else {
		for i in kept { g.res[i] = temp[i]; }
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "threshold filtered ", kept, " items");
	out
}
@end
