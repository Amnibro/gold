phrase: unique odd values rotate aggregate
test: list=1,2,3,3,5,6
expect: => i=9 r=0.0 ok=true s="unique odds sum=9" errors=0 n=6 res=[1,2,3,3,5,6] cache=0 hits=0
test: list=7,7,8,9,11
expect: => i=27 r=0.0 ok=true s="unique odds sum=27" errors=0 n=5 res=[7,7,8,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var seen int[64] = [0; 64];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var exists = false;
			for j in count {
				if seen[j] == x { exists = true; }
			}
			if !exists && count < 64 {
				seen[count] = x;
				count++;
				total += x;
			}
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "unique odds sum=", total);
	out
}
@end
