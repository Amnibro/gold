modifier: until
context: format
phrase: join errors until ceiling {limit}
phrase: accumulate items until errors reach {limit}
phrase: format joined items until errors cap {limit}
slot: limit int
test: list=10,-1,20,-2,30 limit=1
expect: => i=1 r=0.0 ok=true s="10" errors=1 n=5 res=[10,-1,20,-2,30] cache=0 hits=0
test: list=5,-3,15,-4,25 limit=2
expect: => i=3 r=0.0 ok=true s="5,-3,15" errors=2 n=5 res=[5,-3,15,-4,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	out.s.clear();
	var count = 0;
	for i in g.n {
		if g.res[i] < 0 {
			gold_fail(g, "negative value");
		}
		if g.errors >= lim {
			break;
		}
		if count > 0 {
			out.s.push(',');
		}
		format(out.s, g.res[i]);
		count++;
	}
	out.i = count;
	g.steps += count;
	out
}
@end
@entry aca3bd2822d14ff7
kind: step
verb: measure
noun: window
modifier: every_other
context: search
phrase: measure every other search window of size {window_size}
phrase: evaluate alternate windows of width {window_size}
phrase: inspect alternate search windows with span {window_size}
slot: window_size int
test: list=10,20,30,40,50,60,70,80 window_size=2
expect: => i=4 r=0.0 ok=true s="best window at 4 sum 110" errors=0 n=9 res=[10,20,30,40,50,60,70,80,4] cache=0 hits=0
test: list=5,15,25,35,45,55 window_size=3
expect: => i=0 r=0.0 ok=true s="best window at 0 sum 45" errors=0 n=7 res=[5,15,25,35,45,55,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = if ${window_size} <= 0 { 2 } else { ${window_size} };
	var windows_checked = 0;
	var best_sum = 0;
	var best_idx = -1;
	var i = 0;
	while i + ws <= g.n {
		var w_sum = 0;
		for k in ws { w_sum += g.res[i + k]; }
		if windows_checked == 0 || w_sum > best_sum {
			best_sum = w_sum;
			best_idx = i;
		}
		windows_checked++;
		i += 2 * ws;
	}
	out.i = best_idx;
	out.s.clear();
	format(out.s, "best window at ", best_idx, " sum ", best_sum);
	gold_push(g, best_idx);
	g.steps += windows_checked + 1;
	out
}
@end
@entry a49dbe8fa91a86f3
kind: step
verb: retry
noun: odds
modifier: with_retry
context: search
phrase: search odd keys with retry below {max_val}
phrase: filter odd candidates with retry under {max_val}
phrase: test odd numbers with retry limit {max_val}
slot: max_val int
test: list=15,22,45,80,63 max_val=30
expect: => i=3 r=0.0 ok=true s="matched 3 odd keys" errors=0 n=3 res=[15,22,15] cache=0 hits=0
test: list=7,14,35,90 max_val=20
expect: => i=2 r=0.0 ok=true s="matched 2 odd keys" errors=0 n=2 res=[7,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var matched = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var cur = x;
			var retries = 0;
			while cur > mv && retries < 4 {
				cur /= 2;
				retries++;
			}
			if cur <= mv {
				g.res[matched] = cur;
				matched++;
			}
		}
		i++;
	}
	g.n = matched;
	out.i = matched;
	out.s.clear();
	format(out.s, "matched ", matched, " odd keys");
	g.steps += g.n + 1;
	out
}
@end
