expect: => i=2 r=0.0 ok=true s="swapped 2 suffix elements" errors=0 n=6 res=[5,15,35,25,25,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	let half = g.n / 2;
	var swaps = 0;
	var i = half;
	while i + 1 < g.n {
		if g.res[i] == g.res[i+1] {
			let tmp = g.res[i];
			g.res[i] = g.res[g.n - 1];
			g.res[g.n - 1] = tmp;
			swaps++;
		}
		i++;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " suffix elements");
	gold_push(g, swaps);
	g.steps += g.n + 1;
	out
}
@end
@entry 97f58ae5a4658718
kind: step
verb: merge
noun: digits
modifier: recursively
context: search
phrase: merge digits recursively for search keys
phrase: reduce candidate digits recursively to root
phrase: compute recursive digital root across results
test: list=38,19,95,72
expect: => i=17 r=0.0 ok=true s="digital roots sum 17" errors=0 n=5 res=[2,1,5,9,17] cache=0 hits=0
test: list=45,99,28
expect: => i=19 r=0.0 ok=true s="digital roots sum 19" errors=0 n=4 res=[9,9,1,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_roots = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while x >= 10 {
			var d_sum = 0;
			while x > 0 {
				d_sum += x % 10;
				x /= 10;
			}
			x = d_sum;
		}
		g.res[i] = x;
		total_roots += x;
	}
	out.i = total_roots;
	out.s.clear();
	format(out.s, "digital roots sum ", total_roots);
	gold_push(g, total_roots);
	g.steps += g.n + 1;
	out
}
@end
