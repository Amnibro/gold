phrase: shift histogram in place with offset {shift}
phrase: cycle histogram in place by count {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=5 r=0.0 ok=true s="rotated histogram in place by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=3 r=0.0 ok=true s="rotated histogram in place by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 {
		let k = s % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated histogram in place by ", s);
	out
}
@end
