fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		if g.res[i] < 0 {
			g.res[i] = 0;
		} else {
			total += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "summed positive series total: ", total);
	out
}
