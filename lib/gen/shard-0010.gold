@entry d79af3c398a3bb50
kind: step
verb: sum
noun: total
modifier: sorted
context: core
phrase: sum total of sorted elements
phrase: calculate sorted total accumulation
test: list=8,3,5,1
expect: => i=17 r=0.0 ok=true s="sorted total sum 17" errors=0 n=5 res=[1,3,5,8,17] cache=0 hits=0
test: list=12,4,7
expect: => i=23 r=0.0 ok=true s="sorted total sum 23" errors=0 n=4 res=[4,7,12,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	gold_push(g, total);
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sorted total sum ", total);
	out
}
@end
