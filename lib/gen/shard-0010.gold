fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_score};
	let max_c = ${count};
	var kept = 0;
	var i = 0;
	while i < g.n && kept < max_c {
		if g.res[i] >= ms {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected first ", kept, " search items");
	g.steps += i + 1;
	out
}
@end
@entry ba20a66bce0ccc99
kind: step
verb: shift
noun: threshold
modifier: recursively
context: transform
phrase: shift threshold recursively with decay {decay}
phrase: transform threshold shifting recursively by {decay}
slot: decay int
test: list=10,20,30 decay=5
expect: => i=9 r=0.0 ok=true s="shifted threshold recursively total: 9" errors=0 n=3 res=[5,5,5] cache=0 hits=0
test: list=15,25 decay=4
expect: => i=9 r=0.0 ok=true s="shifted threshold recursively total: 9" errors=0 n=2 res=[3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${decay};
	var total_shifts = 0;
	for i in g.n {
		var x = g.res[i];
		var shifts = 0;
		while x > d && shifts < 100 {
			x -= d;
			shifts++;
			total_shifts++;
		}
		g.res[i] = x;
	}
	g.steps += total_shifts;
	out.i = total_shifts;
	out.s.clear();
	format(out.s, "shifted threshold recursively total: ", total_shifts);
	out
}
@end
