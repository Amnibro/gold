	let r = ${retries};
	var changes = 0;
	for i in g.n {
		var val = g.res[i];
		var attempt = 0;
		while val > 50 && attempt < r {
			val /= 2;
			attempt++;
			changes++;
		}
		g.res[i] = val;
	}
	g.steps += changes;
	out.i = changes;
	out.s.clear();
	format(out.s, "normalized with ", changes, " retries");
	out
}
