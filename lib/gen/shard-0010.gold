test: list=10,20,15,30 budget=30
expect: => i=3 r=0.0 ok=true s="partitioned into 3 budget groups" errors=0 n=4 res=[10,20,15,30] cache=1 hits=0
test: list=10,20 budget=-1
expect: => i=0 r=0.0 ok=false s="error: invalid budget -1" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 || g.n == 0 {
		gold_fail(g, "invalid budget or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid budget ", b);
		return out;
	}
	var groups = 0;
	var cur_sum = 0;
	for i in g.n {
		if cur_sum + g.res[i] > b {
			groups++;
			cur_sum = g.res[i];
		} else {
			cur_sum += g.res[i];
		}
	}
	if cur_sum > 0 { groups++; }
	gold_cache_put(g, 0, groups);
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "partitioned into ", groups, " budget groups");
	out
}
@end
