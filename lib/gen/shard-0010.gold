slot: max_rot int
test: list=1,2,3,4,5 max_rot=2
expect: => i=2 r=0.0 ok=true s="rotated checkpoint at most by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 max_rot=1
expect: => i=1 r=0.0 ok=true s="rotated checkpoint at most by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_rot};
	let k = if mr > g.n { g.n } else if mr < 0 { 0 } else { mr };
	if g.n > 1 && k > 0 {
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated checkpoint at most by ", k);
	out
}
@end
