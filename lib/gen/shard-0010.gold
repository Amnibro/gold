expect: => i=2 r=0.0 ok=true s="filtered sorted tally to 2 items" errors=0 n=2 res=[7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var kept = 0;
	for i in g.n {
		if g.res[i] > fl {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept {
		for j in i + 1..kept {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered sorted tally to ", kept, " items");
	out
}
@end
