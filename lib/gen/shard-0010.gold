expect: => i=4 r=0.0 ok=true s="items within limit count 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			count++;
		}
	}
	if g.n > 1 && count > 0 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "items within limit count ", count);
	out
}
@end
