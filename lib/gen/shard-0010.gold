code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mi = ${max_items};
	if mi < 0 {
		gold_fail(g, "negative max items for tail normalization");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative item limit ", mi);
		return out;
	}
	var trimmed = 0;
	if g.n > mi {
		trimmed = g.n - mi;
		let start = trimmed;
		for i in mi {
			g.res[i] = g.res[start + i];
		}
		g.n = mi;
	}
	g.steps += g.n + trimmed;
	out.i = trimmed;
	out.s.clear();
	format(out.s, "normalized tail retaining ", g.n, " items");
	out
}
@end
