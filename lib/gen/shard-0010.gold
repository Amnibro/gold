fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_count};
	var valid = 0;
	var invalid = 0;
	for i in g.n {
		if g.res[i] <= mc {
			valid++;
		} else {
			invalid++;
		}
	}
	if invalid > 0 {
		g.errors++;
		out.ok = false;
	} else {
		out.ok = true;
	}
	gold_cache_put(g, mc, valid);
	g.steps += g.n;
	out.i = valid;
	out.s.clear();
	format(out.s, "validated counter valid ", valid, " invalid ", invalid);
	out
}
@end
