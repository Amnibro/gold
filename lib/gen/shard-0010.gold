fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let count = if g.n < 4 { g.n } else { 4 };
	for i in count {
		for j in i + 1..count {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	gold_cache_put(g, b, count);
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted head ", count, " items");
	out
}
@end
