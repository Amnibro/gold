code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let min_val = g.res[min_idx];
	for i in min_idx..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "shifted minimum value to end: ", min_val);
	out
}
@end
