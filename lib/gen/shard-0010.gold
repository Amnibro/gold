@entry d3490a81eb486c57
kind: step
verb: limit
noun: primes
modifier: in_place
context: list
phrase: limit primes in place to ceiling {ceiling}
phrase: clamp prime items in place to bound {ceiling}
slot: ceiling int
test: list=3,7,13,23 ceiling=10
expect: => i=2 r=0.0 ok=true s="clamped 2 primes in place" errors=0 n=4 res=[3,7,10,10] cache=0 hits=0
test: list=2,5,11,17 ceiling=6
expect: => i=2 r=0.0 ok=true s="clamped 2 primes in place" errors=0 n=4 res=[2,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 { is_p = false; }
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if g.res[i] > ceil { g.res[i] = ceil; count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped ", count, " primes in place");
	out
}
@end
