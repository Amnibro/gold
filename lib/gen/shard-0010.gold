phrase: prune list recursively ceiling {limit}
slot: limit int
test: list=10,20,10,30,20,40 limit=15
expect: => i=1 r=0.0 ok=true s="recursively deduped removed 1" errors=0 n=5 res=[10,20,30,20,40] cache=0 hits=0
test: list=5,5,5 limit=10
expect: => i=2 r=0.0 ok=true s="recursively deduped removed 2" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var w = 0;
	var removed = 0;
	for i in g.n {
		var is_dup = false;
		if g.res[i] <= lim {
			for j in w {
				if g.res[j] == g.res[i] { is_dup = true; break; }
			}
		}
		if is_dup {
			removed++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "recursively deduped removed ", removed);
	out
}
@end
