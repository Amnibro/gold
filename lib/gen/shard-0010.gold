code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${prefix};
	let d = ${depth};
	var matched = 0;
	let lim = if out.s.len < p.len { out.s.len } else { p.len };
	for step in d {
		matched = 0;
		for i in lim {
			if out.s[i] == p[i] { matched++; } else { break; }
		}
	}
	g.steps += d * lim;
	out.i = matched;
	out.ok = (matched == p.len);
	out
}
@end
