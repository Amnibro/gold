@entry 4a3b75c1ef5a0862
kind: step
verb: dedupe
noun: suffix
modifier: recursively
context: search
phrase: dedupe search suffix recursively starting from depth {depth}
phrase: purge duplicate search suffix items recursively past {depth}
slot: depth int
test: list=1,2,3,3,4,4 depth=2
expect: => i=2 r=0.0 ok=true s="deduped suffix removing 2 duplicates" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6,7,7 depth=1
expect: => i=2 r=0.0 ok=true s="deduped suffix removing 2 duplicates" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let start = if d > g.n { g.n } else { d };
	var kept = start;
	for i in start..g.n {
		var seen = false;
		for j in start..kept {
			if g.res[j] == g.res[i] { seen = true; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped suffix removing ", removed, " duplicates");
	out
}
@end
