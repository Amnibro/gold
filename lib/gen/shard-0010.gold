code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			total += g.res[i];
			if total >= lim { break; }
		}
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded primes sum=", total);
	out
}
@end
