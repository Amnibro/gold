noun: range
modifier: times
context: loop
phrase: rotate loop range right by {times} steps
phrase: shift loop elements forward {times} times
phrase: cycle loop range {times} positions
slot: times int
test: list=1,2,3,4,5 times=2
expect: => i=5 r=0.0 ok=true s="rotated loop range 2 times" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
