@entry dc9d097ab01e60a7
kind: step
verb: reverse
noun: tail
modifier: while
context: compare
phrase: reverse tail while floor_val {floor_val}
phrase: invert tail elements while exceeding {floor_val}
slot: floor_val int
test: list=2,8,12,15 floor_val=5
expect: => i=3 r=0.0 ok=true s="reversed qualified tail count 3" errors=0 n=4 res=[2,15,12,8] cache=0 hits=0
test: list=1,3,10,20 floor_val=8
expect: => i=2 r=0.0 ok=true s="reversed qualified tail count 2" errors=0 n=4 res=[1,3,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fv = ${floor_val};
	if g.n < 2 { return out; }
	var start = g.n - 1;
	while start >= 0 && g.res[start] >= fv {
		start--;
	}
	start++;
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	let rev_count = g.n - start;
	g.steps += rev_count;
	out.i = rev_count;
	out.s.clear();
	format(out.s, "reversed qualified tail count ", rev_count);
	out
}
@end
