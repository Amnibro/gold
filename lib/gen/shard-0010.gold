@entry e439c23987a94c08
kind: step
verb: rotate
noun: number
modifier: all
context: sort
phrase: rotate all sorted numbers by shift {shift}
phrase: cycle all sorted array elements by offset {shift}
slot: shift int
test: list=1,2,3,4,5 shift=2
expect: => i=2 r=0.0 ok=true s="rotated all numbers by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 shift=1
expect: => i=1 r=0.0 ok=true s="rotated all numbers by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	if g.n <= 1 || sh <= 0 {
		out.i = 0;
		return out;
	}
	let eff = sh % g.n;
	for step in eff {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	g.steps += eff * g.n;
	out.i = eff;
	out.s.clear();
	format(out.s, "rotated all numbers by ", eff);
	out
}
@end
