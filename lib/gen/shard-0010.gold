test: list=5,10,15,20 max_budget=20
expect: => i=15 r=0.0 ok=true s="joined nested items using budget 15" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${max_budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let cost = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		if spent + cost <= b {
			spent += cost;
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "joined nested items using budget ", spent);
	out
}
@end
@entry cb8a05114294211d
kind: step
verb: reverse
noun: primes
modifier: any
context: filter
phrase: reverse prime values located anywhere in sequence
phrase: filter sequence reversing any prime elements
test: list=4,2,6,3,8,5
expect: => i=3 r=0.0 ok=true s="reversed 3 prime elements" errors=0 n=3 res=[5,3,2] cache=0 hits=0
test: list=7,11,4,13,9
expect: => i=3 r=0.0 ok=true s="reversed 3 prime elements" errors=0 n=3 res=[13,11,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[kept - 1 - i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reversed ", kept, " prime elements");
	out
}
@end
