code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mk = ${max_key};
	let valid = (mk >= 0);
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "memo keys valid");
	} else {
		gold_fail(g, "invalid memo bound");
		format(out.s, "memo keys invalid");
	}
	g.steps += g.n;
	out
}
@end
