code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = g.n - 1;
		var kept = 0;
		for i in g.n {
			if i == 0 || g.res[i] != g.res[i - 1] {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped reverse spaces count=", g.n);
	out
}
@end
