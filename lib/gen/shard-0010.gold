code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped = false;
	if g.n >= 2 {
		let last = g.res[g.n - 1];
		let prev = g.res[g.n - 2];
		if last != prev {
			g.res[g.n - 1] = prev;
			g.res[g.n - 2] = last;
			swapped = true;
		}
	}
	g.steps += g.n;
	out.ok = swapped;
	out.i = if swapped { 1 } else { 0 };
	out.s.clear();
	format(out.s, "swapped unique suffix ", swapped);
	out
}
@end
