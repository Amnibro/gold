noun: window
modifier: last
context: list
phrase: return window last span {span}
phrase: extract window last size {span}
slot: span int
test: list=10,20,30,40,50 span=3
expect: => i=3 r=0.0 ok=true s="kept last window size 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2 span=1
expect: => i=1 r=0.0 ok=true s="kept last window size 1" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var count = sp;
	if count > g.n { count = g.n; }
	if count <= 0 {
		g.n = 0;
		out.i = 0;
		return out;
	}
	let start = g.n - count;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept last window size ", count);
	out
}
@end
@entry 0f7c7414a7c411f2
kind: step
verb: validate
noun: condition
modifier: between
context: list
phrase: validate condition between low {low} high {high}
phrase: verify condition between min {low} max {high}
slot: low int
slot: high int
test: list=12,15,18,22 low=10 high=25
expect: => i=4 r=0.0 ok=true s="condition between validated true" errors=0 n=4 res=[12,15,18,22] cache=0 hits=0
test: list=5,30,15 low=10 high=20
expect: => i=0 r=0.0 ok=false s="condition between validated false" errors=1 n=3 res=[5,30,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var ok = true;
	for i in g.n {
		if g.res[i] < lo || g.res[i] > hi {
			ok = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = ok;
	if !ok {
		gold_fail(g, "element outside valid condition range");
		out.i = 0;
	} else {
		out.i = g.n;
	}
	out.s.clear();
	format(out.s, "condition between validated ", ok);
	out
}
@end
