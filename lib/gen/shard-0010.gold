@entry f305e93fbae86800
kind: step
verb: normalize
noun: duplicates
modifier: until
context: filter
phrase: normalize duplicate occurrences up to {max_dupes}
phrase: filter duplicate items until reaching {max_dupes} repeats
slot: max_dupes int
test: list=1,1,1,2,2,3 max_dupes=2
expect: => i=5 r=0.0 ok=true s="normalized duplicates to 5 items" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5,10,10 max_dupes=1
expect: => i=2 r=0.0 ok=true s="normalized duplicates to 2 items" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_dupes};
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if temp[j] == x { seen++; }
		}
		if seen < lim {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "normalized duplicates to ", kept, " items");
	out
}
@end
