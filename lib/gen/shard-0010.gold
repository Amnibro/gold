fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200] = "";
	var others byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		let is_v = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		            b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U');
		if is_v { vowels.push(b); } else { others.push(b); }
	}
	out.s.clear();
	out.s.append(vowels);
	out.s.append(others);
	g.steps += out.s.len;
	out.i = vowels.len;
	out
}
