code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	var idx = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if g.res[i] == tgt {
			found = true;
			idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.s.clear();
	if found {
		out.i = idx;
		format(out.s, "first suffix match at index ", idx);
	} else {
		gold_fail(g, "suffix match not found");
		out.i = -1;
		out.s.append("suffix match not found");
	}
	out
}
@end
