fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		if kept >= lim { break; }
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "normalized runs to ", kept, " elements");
	out
}
@end
