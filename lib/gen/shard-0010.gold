code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 {
		let rot = s % g.n;
		var tmp int[512] = [0; 512];
		for i in g.n {
			tmp[i] = g.res[(i + rot) % g.n];
		}
		for i in g.n {
			g.res[i] = tmp[i];
		}
	}
	gold_cache_put(g, s, g.n);
	g.steps += g.n;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated digits in place by ", s);
	out
}
@end
