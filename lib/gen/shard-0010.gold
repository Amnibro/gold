@entry 256d5a7196735086
kind: step
verb: check
noun: maximum
modifier: until
context: compare
phrase: check maximum until ceiling {ceiling}
phrase: verify running maximum remains until {ceiling}
slot: ceiling int
test: list=2,5,8,12 ceiling=10
expect: => i=12 r=0.0 ok=true s="running maximum until ceiling reached 12" errors=0 n=4 res=[2,5,8,12] cache=0 hits=0
test: list=1,4,7 ceiling=15
expect: => i=7 r=0.0 ok=false s="running maximum until ceiling reached 7" errors=0 n=3 res=[1,4,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if g.n == 0 { return out; }
	var cur_max = g.res[0];
	var steps = 0;
	while steps < g.n {
		if g.res[steps] > cur_max { cur_max = g.res[steps]; }
		if cur_max >= ceil { break; }
		steps++;
	}
	g.steps += steps;
	out.ok = (cur_max >= ceil);
	out.i = cur_max;
	out.s.clear();
	format(out.s, "running maximum until ceiling reached ", cur_max);
	out
}
@end
