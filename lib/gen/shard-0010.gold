code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 || g.n < w {
		out.i = 0;
		return out;
	}
	var count = 0;
	for i in (g.n - w + 1) {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[count] = sum;
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "window running count ", count);
	out
}
@end
