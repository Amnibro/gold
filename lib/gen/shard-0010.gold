fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	var buf int[512] = [0; 512];
	var bn = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		for s in st {
			if bn < 512 {
				buf[bn] = val;
				bn++;
			}
		}
		i += 2;
	}
	for k in bn { g.res[k] = buf[k]; }
	g.n = bn;
	g.steps += bn;
	out.i = bn;
	out.s.clear();
	format(out.s, "repeated checkpoints producing ", bn, " items");
	out
}
