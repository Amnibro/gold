code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var space_idx = -1;
	for i in out.s.len {
		if out.s[i] == ' ' {
			space_idx = i;
			break;
		}
	}
	if space_idx >= 0 {
		out.s.resize(space_idx, 0 as byte);
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
