fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var tot = 0;
	for i in g.n { tot += g.res[i]; }
	if tot > lim {
		gold_fail(g, "total exceeds ceiling limit");
		out.ok = false;
	} else {
		gold_cache_put(g, lim, tot);
		out.ok = true;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "cached total aggregate ", tot);
	out
}
