@entry 2ff8bcfd21eafddd
kind: step
verb: map
noun: spaces
modifier: sorted
context: loop
phrase: map loop spaces sorted width {width}
phrase: format sorted spacing intervals width {width}
slot: width int
test: list=10,2,8 width=3
expect: => i=2 r=0.0 ok=true s="mapped sorted spaces count 2" errors=0 n=2 res=[18,6] cache=0 hits=0
test: list=20,5,15 width=2
expect: => i=2 r=0.0 ok=true s="mapped sorted spaces count 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if g.n < 2 { return out; }
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var temp int[512] = [0; 512];
	for i in (g.n - 1) {
		temp[i] = (g.res[i + 1] - g.res[i]) * w;
	}
	g.n = g.n - 1;
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped sorted spaces count ", g.n);
	out
}
@end
