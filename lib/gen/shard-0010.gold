fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ta = ${target_avg};
	if ta <= 0 || g.n == 0 {
		gold_fail(g, "invalid target average or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid average target");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var added = 0;
	while (sum / g.n) < ta && g.n < 500 && added < 10 {
		let nxt = ta * 2;
		gold_push(g, nxt);
		sum += nxt;
		added++;
	}
	g.steps += added + g.n;
	out.i = added;
	out.s.clear();
	format(out.s, "filled ", added, " items towards average ", ta);
	out
}
@end
