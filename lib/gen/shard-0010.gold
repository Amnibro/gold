code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${max_chars};
	var seen byte[256] = [0; 256];
	var temp byte[..200] = [];
	var i = out.s.len;
	while i > 0 && temp.len < mc {
		i--;
		let c = out.s[i];
		let idx = c as int;
		if idx >= 0 && idx < 256 && seen[idx] == 0 {
			seen[idx] = 1;
			temp.push(c);
		}
	}
	out.s = temp;
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry 7ee884a9261401c9
kind: step
verb: measure
noun: step
modifier: while
context: loop
phrase: measure step while max_delta {max_delta}
phrase: count valid steps while differences under {max_delta}
slot: max_delta int
test: list=2,4,7,15,18 max_delta=3
expect: => i=2 r=0.0 ok=true s="measured consecutive steps under delta: 2" errors=0 n=5 res=[2,4,7,15,18] cache=0 hits=0
test: list=10,12,14,20 max_delta=2
expect: => i=2 r=0.0 ok=true s="measured consecutive steps under delta: 2" errors=0 n=4 res=[10,12,14,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_delta};
	if g.n < 2 { return out; }
	var steps = 0;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff <= md { steps++; }
		else { break; }
	}
	g.steps += steps;
	out.i = steps;
	out.s.clear();
	format(out.s, "measured consecutive steps under delta: ", steps);
	out
}
@end
