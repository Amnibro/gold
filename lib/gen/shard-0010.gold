code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${spacing};
	var gaps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = -diff; }
			if diff >= sp { gaps++; }
		}
	}
	gold_cache_put(g, sp, gaps);
	g.steps += g.n;
	out.i = gaps;
	out.s.clear();
	format(out.s, "pairwise gap count: ", gaps);
	out
}
@end
