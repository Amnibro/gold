code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	for i in g.n {
		if g.res[i] < lo { g.res[i] = lo; }
		if g.res[i] > hi { g.res[i] = hi; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped all values to range");
	out
}
@end
