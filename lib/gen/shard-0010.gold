	let lim = ${limit};
	let bound = if lim > g.n { g.n } else { lim };
	var sum = 0;
	for k in bound {
		sum += g.res[k];
	}
	gold_push(g, sum);
	g.steps += bound;
	out.i = sum;
	out.s.clear();
	format(out.s, "joined steps up to limit: ", sum);
