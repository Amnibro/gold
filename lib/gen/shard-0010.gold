fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
	}
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	out.s.clear();
	format(out.s, "maximum moved to end ", out.i);
	out
}
@end
