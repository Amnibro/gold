code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "prime items count=", g.n);
	out
}
@end
