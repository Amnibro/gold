code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		var seen = false;
		for j in kept {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped list to ", kept, " elements");
	out
}
@end
@entry 8797e70aaaa7e866
kind: step
verb: clamp
noun: average
modifier: none
context: loop
phrase: clamp average of loop results to bounds {lo} with {hi}
phrase: restrict loop average between values {lo} to {hi}
phrase: bind loop average within limits {lo} through {hi}
slot: lo int
slot: hi int
test: list=10,20,30 lo=15 hi=25
expect: => i=20 r=0.0 ok=true s="clamped loop average to 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=2,4,6 lo=10 hi=20
expect: => i=10 r=0.0 ok=true s="clamped loop average to 10" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var clamped = avg;
	if clamped < l { clamped = l; }
	if clamped > h { clamped = h; }
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped loop average to ", clamped);
	out
}
@end
