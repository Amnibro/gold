fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let t = ${turns};
	var k = lim;
	if k > g.n { k = g.n; }
	if k > 1 && t > 0 {
		let turns = t % k;
		for step in turns {
			let last = g.res[k - 1];
			var i = k - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated prefix of size ", k);
	out
}
