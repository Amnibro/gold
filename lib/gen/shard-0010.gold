@entry 69f2b6643bf5e606
kind: step
verb: rotate
noun: primes
modifier: each
context: compare
phrase: rotate primes each time prime count exceeds zero
phrase: shift primes each cycle by prime count
phrase: cycle comparison array by count of each prime
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="rotated by 3 prime elements" errors=0 n=5 res=[4,5,6,2,3] cache=0 hits=0
test: list=1,4,6,8,9
expect: => i=0 r=0.0 ok=true s="rotated by 0 prime elements" errors=0 n=5 res=[1,4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { p_count++; }
		}
	}
	if g.n > 1 && p_count > 0 {
		let k = p_count % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = p_count;
	out.s.clear();
	format(out.s, "rotated by ", p_count, " prime elements");
	out
}
@end
