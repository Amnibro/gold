@entry 9f0cd3503b4ccbfe
kind: step
verb: merge
noun: gaps
modifier: up_to
context: cache
phrase: merge gaps up to threshold {max_gap}
phrase: combine adjacent entries with gap up to {max_gap}
slot: max_gap int
test: list=1,2,5,6 max_gap=2
expect: => i=2 r=0.0 ok=true s="merged gaps into 2 elements" errors=0 n=2 res=[3,11] cache=2 hits=0
test: list=10,30,35 max_gap=10
expect: => i=2 r=0.0 ok=true s="merged gaps into 2 elements" errors=0 n=2 res=[10,65] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var kept = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n {
			let diff = g.res[i + 1] - g.res[i];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff <= mg {
				let sum = g.res[i] + g.res[i + 1];
				g.res[kept] = sum;
				gold_cache_put(g, kept, sum);
				kept++;
				i += 2;
				continue;
			}
		}
		g.res[kept] = g.res[i];
		gold_cache_put(g, kept, g.res[i]);
		kept++;
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged gaps into ", kept, " elements");
	out
}
@end
