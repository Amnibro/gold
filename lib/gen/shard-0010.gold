@entry afb5978e0cbf38d8
kind: step
verb: pair
noun: suffix
modifier: at_most
context: filter
phrase: filter paired suffix items up to at most {max_items}
phrase: pair trailing elements keeping at most {max_items}
slot: max_items int
test: list=1,2,3,4,5 max_items=2
expect: => i=2 r=0.0 ok=true s="paired suffix into 2 elements" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=10,20,30,40 max_items=3
expect: => i=3 r=0.0 ok=true s="paired suffix into 3 elements" errors=0 n=3 res=[30,50,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_items};
	if g.n < 2 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in (g.n - 1) {
		if kept < lim {
			temp[kept] = g.res[i] + g.res[i + 1];
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "paired suffix into ", kept, " elements");
	out
}
@end
@entry eaa8737f9ddc938c
kind: step
verb: rank
noun: cache
modifier: unique
context: filter
phrase: rank cached values filtering out duplicate entries
phrase: filter unique cache entries ranking distinct keys
test: list=1,2,1,3,2,4
expect: => i=4 r=0.0 ok=true s="ranked 4 unique cached items" errors=0 n=4 res=[1,2,3,4] cache=4 hits=2
test: list=5,5,5,10,10
expect: => i=2 r=0.0 ok=true s="ranked 2 unique cached items" errors=0 n=2 res=[5,10] cache=2 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked ", kept, " unique cached items");
	out
}
@end
