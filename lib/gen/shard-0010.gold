@entry 21df922ba785afed
kind: step
verb: merge
noun: minimum
modifier: sorted
context: stats
phrase: merge minimum into sorted observations
phrase: blend lowest score into sorted results
phrase: incorporate minimum value across sorted sample
test: list=9,3,7,1
expect: => i=1 r=0.0 ok=true s="merged min 1" errors=0 n=4 res=[2,4,8,10] cache=0 hits=0
test: list=12,5,8
expect: => i=5 r=0.0 ok=true s="merged min 5" errors=0 n=3 res=[10,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty stats");
		g.steps++;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in g.n {
		g.res[k] += min_val;
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "merged min ", min_val);
	g.steps += g.n * 2;
	out
}
@end
