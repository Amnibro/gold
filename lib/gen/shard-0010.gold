@entry 2efc03491ecc13fd
kind: step
verb: reverse
noun: spaces
modifier: until
context: format
phrase: reverse spaces until count reaches {max_spaces}
phrase: invert spaces until limit of {max_spaces}
slot: max_spaces int
test: text="one two three four" max_spaces=2
expect: => i=7 r=0.0 ok=true s="owt eno three four" errors=0 n=0 res=[] cache=0 hits=0
test: text="a b c d" max_spaces=1
expect: => i=1 r=0.0 ok=true s="a b c d" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_spaces};
	var sp = 0;
	var end_idx = out.s.len;
	for i in out.s.len {
		if out.s[i] == ' ' {
			sp++;
			if sp == ms {
				end_idx = i;
				break;
			}
		}
	}
	for i in (end_idx / 2) {
		let tmp = out.s[i];
		out.s[i] = out.s[end_idx - 1 - i];
		out.s[end_idx - 1 - i] = tmp;
	}
	g.steps += out.s.len;
	out.i = end_idx;
	out
}
@end
