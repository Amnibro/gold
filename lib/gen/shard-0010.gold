test: list=10,20,30,40 chunk_sz=2
expect: => i=30 r=0.0 ok=true s="grouped first prefix of 2 items into sum 30" errors=0 n=3 res=[30,30,40] cache=0 hits=0
test: list=10 chunk_sz=5
expect: => i=0 r=0.0 ok=false s="error: invalid chunk size 5" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_sz};
	if sz <= 0 || g.n < sz {
		gold_fail(g, "invalid prefix chunk size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid chunk size ", sz);
		return out;
	}
	var prefix_sum = 0;
	for i in sz { prefix_sum += g.res[i]; }
	g.res[0] = prefix_sum;
	let new_n = 1 + (g.n - sz);
	for i in 1..new_n {
		g.res[i] = g.res[sz - 1 + i];
	}
	g.n = new_n;
	g.steps += g.n + sz;
	out.i = prefix_sum;
	out.s.clear();
	format(out.s, "grouped first prefix of ", sz, " items into sum ", prefix_sum);
	out
}
@end
