@entry 92a0696b93211273
kind: step
verb: scan
noun: step
modifier: unique
context: transform
phrase: scan unique step increments across sequence
phrase: count distinct step differences between adjacent elements
test: list=1,3,5,7,10
expect: => i=2 r=0.0 ok=true s="distinct steps count: 2" errors=0 n=5 res=[1,3,5,7,10] cache=0 hits=0
test: list=2,4,6,8
expect: => i=1 r=0.0 ok=true s="distinct steps count: 1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var diffs int[16] = [0; 16];
	var num_diffs = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let d = g.res[i + 1] - g.res[i];
			var seen = false;
			for j in num_diffs {
				if diffs[j] == d {
					seen = true;
					break;
				}
			}
			if !seen && num_diffs < 16 {
				diffs[num_diffs] = d;
				num_diffs++;
			}
		}
	}
	g.steps += g.n;
	out.i = num_diffs;
	out.s.clear();
	format(out.s, "distinct steps count: ", num_diffs);
	out
}
@end
