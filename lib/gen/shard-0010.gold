@entry 46b111dc821b3c50
kind: step
verb: scan
noun: text
modifier: between
context: core
phrase: scan text between delimiters start char {start_ch} to stop char {stop_ch}
phrase: locate text between marker byte {start_ch} across terminal byte {stop_ch}
slot: start_ch int
slot: stop_ch int
test: text="foo[bar]baz" start_ch=91 stop_ch=93
expect: => i=3 r=0.0 ok=true s="between span length 3" errors=0 n=0 res=[] cache=0 hits=0
test: text="<sample>" start_ch=60 stop_ch=62
expect: => i=6 r=0.0 ok=true s="between span length 6" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_ch = ${start_ch} as! byte;
	let e_ch = ${stop_ch} as! byte;
	var p1 = -1;
	var p2 = -1;
	for i in out.s.len {
		if p1 < 0 && out.s[i] == s_ch { p1 = i; }
		else if p1 >= 0 && out.s[i] == e_ch { p2 = i; break; }
	}
	g.steps += out.s.len;
	if p1 >= 0 && p2 > p1 {
		let span = p2 - p1 - 1;
		out.i = span;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "between span length ", out.i);
	out
}
@end
