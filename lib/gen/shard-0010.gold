fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for finding odds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var odd_count = 0;
	var write_idx = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[write_idx] = g.res[i];
			write_idx++;
			odd_count++;
		}
