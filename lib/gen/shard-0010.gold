test: list=10,12,25,30 min_gap=10
expect: => i=1 r=0.0 ok=true s="returned 1 qualifying cache gaps" errors=0 n=1 res=[13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= mg {
			g.res[kept] = diff;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " qualifying cache gaps");
	out
}
@end
