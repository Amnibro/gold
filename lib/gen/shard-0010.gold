fn ${ID}_digits(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var c = 0;
	while x > 0 {
		c++;
		x /= 10;
	}
	c
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total_digits = 0;
	for i in g.n {
		total_digits += ${ID}_digits(g.res[i]);
	}
	let result = total_digits * f;
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "counted ", total_digits, " digits scaled to ", result);
	out
}
