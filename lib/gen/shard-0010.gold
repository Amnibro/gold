test: list=1,1,2,3,3,4
expect: => i=2 r=0.0 ok=true s="dropped 2 adjacent duplicates in place" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="no duplicates found in place" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "no duplicates found in place");
		return out;
	}
	var write_idx = 1;
	var dropped = 0;
	for i in 1..g.n {
		if g.res[i] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[i];
			write_idx++;
		} else {
			dropped++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	if dropped == 0 {
		format(out.s, "no duplicates found in place");
	} else {
		format(out.s, "dropped ", dropped, " adjacent duplicates in place");
	}
	out
}
@end
