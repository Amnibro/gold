test: list=10,20,30,35
expect: => i=2 r=0.0 ok=true s="found 2 unique spaces" errors=0 n=2 res=[10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var diffs int[512] = [0; 512];
	var dn = 0;
	for i in (g.n - 1) {
		let d = g.res[i + 1] - g.res[i];
		var seen = false;
		for j in dn { if diffs[j] == d { seen = true; break; } }
		if !seen { diffs[dn] = d; dn++; }
	}
	gold_clear(g);
	for i in dn { gold_push(g, diffs[i]); }
	g.steps += dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "found ", dn, " unique spaces");
	out
}
@end
