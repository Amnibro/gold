expect: => i=12 r=0.0 ok=true s="alternating series product: 12" errors=0 n=3 res=[2,4,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var alt = 0;
	for i in g.n {
		if i % 2 == 0 { alt += g.res[i]; }
		else { alt -= g.res[i]; }
	}
	let res = alt * m;
	gold_cache_put(g, m, res);
	g.steps += g.n;
	out.i = res;
	out.s.clear();
	format(out.s, "alternating series product: ", res);
	out
}
@end
