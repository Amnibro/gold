fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	for i in g.n {
		var attempts = 0;
		while g.res[i] > 25 && attempts < r {
			g.res[i] /= 2;
			attempts++;
		}
	}
	g.steps += g.n * r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized memo with ", r, " retries");
	out
}
@end
