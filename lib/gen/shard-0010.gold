fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var count = 0;
	var i = 0;
	while i < out.s.len && count < ml {
		if out.s[i] >= 'a' && out.s[i] <= 'z' {
			count++;
		}
		i++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned text up_to count ", count);
	out
}
@end
