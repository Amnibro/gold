@entry a8d23dc4b6cdbc29
kind: step
verb: clamp
noun: average
modifier: recursively
context: sort
phrase: recursively clamp sorted values toward average using tolerance {tolerance}
phrase: clamp sorted elements toward mean recursively with tolerance {tolerance}
slot: tolerance int
test: list=10,30,50 tolerance=10
expect: => i=2 r=0.0 ok=true s="clamped 2 elements toward average" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=2,8,20 tolerance=5
expect: => i=2 r=0.0 ok=true s="clamped 2 elements toward average" errors=0 n=3 res=[5,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let avg = total / g.n;
	var adjustments = 0;
	for i in g.n {
		if g.res[i] > avg + tol {
			g.res[i] = avg + tol;
			adjustments++;
		} else if g.res[i] < avg - tol {
			g.res[i] = avg - tol;
			adjustments++;
		}
	}
	g.steps += g.n;
	out.i = adjustments;
	out.s.clear();
	format(out.s, "clamped ", adjustments, " elements toward average");
	out
}
@end
