code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${min_budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= mb {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "budget spent preserving items: ", spent);
	out
}
@end
