fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tag = ${slot_tag};
	let cached, ok = gold_cache_get(g, tag);
	let thresh = if ok { cached } else { tag };
	var found_idx = -1;
	for i in g.n {
		if g.res[i] >= thresh {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "threshold found at index ", found_idx);
	out
}
