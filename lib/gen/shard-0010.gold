fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_retries};
	var total_retries = 0;
	for i in g.n {
		var x = g.res[i];
		var r = 0;
		while r < limit {
			x = ${step_fn}(x);
			r++;
			total_retries++;
