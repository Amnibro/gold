	for i in 1..(g.n - 1) {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; break; }
		}
		if !seen && kept < lim {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected middle unique elements ", kept);
	out
}
@end
