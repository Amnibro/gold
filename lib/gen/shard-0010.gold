phrase: reduce search streak safely respecting upper bound {bound}
slot: bound int
test: list=3,3,3,1 bound=10
expect: => i=3 r=0.0 ok=true s="folded streak safely with max length 3" errors=0 n=4 res=[3,3,3,1] cache=0 hits=0
test: list=4,4,4,4 bound=20
expect: => i=4 r=0.0 ok=true s="folded streak safely with max length 4" errors=0 n=4 res=[4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var max_streak = 0;
	var curr_streak = 0;
	var streak_sum = 0;
	for i in g.n {
		if i == 0 || g.res[i] == g.res[i - 1] {
			curr_streak++;
			streak_sum += g.res[i];
		} else {
			curr_streak = 1;
			streak_sum = g.res[i];
		}
		if curr_streak > max_streak && streak_sum <= b {
			max_streak = curr_streak;
		}
	}
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "folded streak safely with max length ", max_streak);
	out
}
@end
@entry 3a3124cea4bde9e3
kind: step
verb: rotate
noun: odds
modifier: up_to
context: search
phrase: rotate odd search candidates up to limit {max_rot}
phrase: cycle odd search items up to limit {max_rot}
slot: max_rot int
test: list=1,3,5,7 max_rot=1
expect: => i=4 r=0.0 ok=true s="rotated 4 odd numbers" errors=0 n=4 res=[7,1,3,5] cache=0 hits=0
test: list=9,11,13,15 max_rot=2
expect: => i=4 r=0.0 ok=true s="rotated 4 odd numbers" errors=0 n=4 res=[13,15,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_rot};
	var odds int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[on] = g.res[i];
			on++;
		}
	}
	if on > 1 && mr > 0 {
		let r = if mr > on { on } else { mr };
		for s in r {
			let last = odds[on - 1];
			var j = on - 1;
			while j > 0 {
				odds[j] = odds[j - 1];
				j--;
			}
			odds[0] = last;
		}
	}
	var o_idx = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] = odds[o_idx];
			o_idx++;
		}
	}
	g.steps += on;
	out.i = on;
	out.s.clear();
	format(out.s, "rotated ", on, " odd numbers");
	out
}
@end
