expect: => i=2 r=0.0 ok=true s="clamped nested squares count: 2" errors=0 n=4 res=[4,16,20,20] cache=0 hits=0
test: list=3,5,7 threshold=30
expect: => i=1 r=0.0 ok=true s="clamped nested squares count: 1" errors=0 n=3 res=[9,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var clamped = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq > limit {
			g.res[i] = limit;
			clamped++;
		} else {
			g.res[i] = sq;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped nested squares count: ", clamped);
	out
}
@end
