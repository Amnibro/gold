slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="rotated history until target turns 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=1,2,3 target=9
expect: => i=3 r=0.0 ok=true s="rotated history until target turns 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var turns = 0;
	while turns < g.n && g.res[0] != tg {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
		turns++;
	}
	g.steps += g.n * turns;
	out.i = turns;
	out.s.clear();
	format(out.s, "rotated history until target turns ", turns);
	out
}
@end
