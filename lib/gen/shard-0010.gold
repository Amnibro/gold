	for i in g.n {
		if g.res[i] >= b {
			ok = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = ok;
	if !ok {
		gold_fail(g, "observation exceeded allowable error bound");
		out.i = 0;
	} else {
		out.i = g.n;
	}
	out.s.clear();
	format(out.s, "validated errors status ", ok);
	out
}
@end
@entry f3136e20de4fc2ac
kind: step
verb: swap
noun: squares
modifier: times
context: retry
phrase: swap squares times scaling factor {factor}
phrase: replace elements with squared differences multiplied by {factor}
slot: factor int
test: list=2,5,9 factor=2
expect: => i=2 r=0.0 ok=true s="computed 2 squared gaps" errors=0 n=5 res=[2,5,9,18,32] cache=0 hits=0
test: list=1,4,8 factor=3
expect: => i=2 r=0.0 ok=true s="computed 2 squared gaps" errors=0 n=5 res=[1,4,8,27,48] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n < 2 {
		gold_fail(g, "not enough items for square swap");
		out.ok = false;
		return out;
	}
	var pushed = 0;
	for i in (g.n - 1) {
		let d = g.res[i + 1] - g.res[i];
		let sq = (d * d) * f;
		gold_push(g, sq);
		pushed++;
	}
	g.steps += pushed;
	out.i = pushed;
	out.s.clear();
	format(out.s, "computed ", pushed, " squared gaps");
	out
}
@end
