slot: k int
test: list=1,2,2,3,3 k=4
expect: => i=2 r=0.0 ok=true s="unique tail observations: 2" errors=0 n=5 res=[1,2,2,3,3] cache=0 hits=0
test: list=5,6,7,8,8 k=3
expect: => i=2 r=0.0 ok=true s="unique tail observations: 2" errors=0 n=5 res=[5,6,7,8,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || g.n < k { return out; }
	let start = g.n - k;
	var u_cnt = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in start..i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen { u_cnt++; }
	}
	g.steps += k;
	out.i = u_cnt;
	out.s.clear();
	format(out.s, "unique tail observations: ", u_cnt);
	out
}
@end
