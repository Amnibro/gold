fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n <= 1 || c <= 0 {
		out.i = 0;
		return out;
	}
	let r = if c > g.n { g.n } else { c };
	for step in r {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += r * g.n;
	out.i = r;
	out.s.clear();
	format(out.s, "moved ", r, " head items to end");
	out
}
@end
