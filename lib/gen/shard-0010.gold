test: list=10,20,30,40 threshold=50
expect: => i=100 r=0.0 ok=true s="rotated series sum is 100" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=5,10 threshold=30
expect: => i=15 r=0.0 ok=true s="rotated series sum is 15" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum >= th && g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated series sum is ", sum);
	out
}
@end
