@entry 07a90d1e29d56154
kind: step
verb: validate
noun: budget
modifier: last
context: cache
phrase: validate budget against last cached balance {balance}
phrase: verify operational budget with last record {balance}
slot: balance int
test: list=10,20,30 balance=100
expect: => i=40 r=0.0 ok=true s="budget valid remaining 40" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=50,60,70 balance=120
expect: => i=60 r=0.0 ok=false s="budget exceeded by 60" errors=1 n=3 res=[50,60,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${balance};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	if sum <= b {
		gold_cache_put(g, 0, b - sum);
		out.ok = true;
		out.i = b - sum;
		out.s.clear();
		format(out.s, "budget valid remaining ", b - sum);
	} else {
		g.errors++;
		out.ok = false;
		out.i = sum - b;
		out.s.clear();
		format(out.s, "budget exceeded by ", sum - b);
	}
	g.steps += g.n;
	out
}
@end
