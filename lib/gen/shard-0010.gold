expect: => i=0 r=0.0 ok=false s="mid 30 in range=false" errors=0 n=6 res=[5,12,30,80,100,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if g.n == 0 {
		out.i = 0;
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	let val = g.res[mid];
	let in_range = (val >= l && val <= h);
	out.i = if in_range { 1 } else { 0 };
	out.ok = in_range;
	out.s.clear();
	format(out.s, "mid ", val, " in range=", in_range);
	gold_push(g, val);
	g.steps += 2;
	out
}
@end
@entry 79b34f65497ec85d
kind: step
verb: drop
noun: gaps
modifier: each
context: transform
phrase: drop gap differences larger than threshold {gap_max}
phrase: filter out items exceeding gap limit {gap_max}
slot: gap_max int
test: list=2,4,15,18 gap_max=5
expect: => i=3 r=0.0 ok=true s="kept within gap items count: 3" errors=0 n=3 res=[2,4,18] cache=0 hits=0
test: list=1,3,5,20,22 gap_max=4
expect: => i=4 r=0.0 ok=true s="kept within gap items count: 4" errors=0 n=4 res=[1,3,5,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let limit = ${gap_max};
	var temp int[512] = [0; 512];
	temp[0] = g.res[0];
	var kept = 1;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff <= limit {
			temp[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept within gap items count: ", kept);
	out
}
@end
