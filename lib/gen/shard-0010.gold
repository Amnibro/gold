noun: window
modifier: unique
context: core
phrase: count window unique items within span {width}
phrase: tally window unique entries inside frame {width}
slot: width int
test: list=1,2,2,3,4 width=3
expect: => i=2 r=0.0 ok=true s="unique items in window 2" errors=0 n=5 res=[1,2,2,3,4] cache=0 hits=0
test: list=5,5,5,6 width=2
expect: => i=1 r=0.0 ok=true s="unique items in window 1" errors=0 n=4 res=[5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	let limit = if w < g.n { w } else { g.n };
	var unique_count = 0;
	for i in limit {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen { unique_count++; }
	}
	g.steps += limit;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "unique items in window ", unique_count);
	out
}
@end
