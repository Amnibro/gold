fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	out.s.clear();
	var u_count = 0;
	var u_val int[512] = [0; 512];
	var u_freq int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in u_count {
			if u_val[j] == x { idx = j; break; }
		}
		if idx >= 0 {
			u_freq[idx] = u_freq[idx] + 1;
		} else {
			u_val[u_count] = x;
			u_freq[u_count] = 1;
			u_count++;
		}
