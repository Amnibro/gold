noun: average
modifier: any
context: cache
phrase: find average any discrepancy target {target}
phrase: measure deviation of mean from target {target}
slot: target int
test: list=10,20,30 target=20
expect: => i=0 r=0.0 ok=true s="average target delta: 0" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15,25 target=12
expect: => i=3 r=0.0 ok=true s="average target delta: 3" errors=0 n=3 res=[5,15,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var diff = avg - tgt;
	if diff < 0 { diff = -diff; }
	gold_cache_put(g, tgt, diff);
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "average target delta: ", diff);
	out
}
@end
