@entry 271c7f0df4948c42
kind: step
verb: compare
noun: streak
modifier: with_retry
context: transform
phrase: compare streak lengths with retry allowance {tries}
phrase: transform streak comparisons allowing retry count {tries}
slot: tries int
test: list=1,3,2,4,5,1 tries=1
expect: => i=5 r=0.0 ok=true s="longest streak with retry: 5" errors=0 n=6 res=[1,3,2,4,5,1] cache=0 hits=0
test: list=10,8,7,9 tries=2
expect: => i=3 r=0.0 ok=true s="longest streak with retry: 3" errors=0 n=4 res=[10,8,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let allowed = ${tries};
	var longest = 0;
	for start in g.n {
		var cur_len = 1;
		var drops = 0;
		var last = g.res[start];
		var idx = start + 1;
		while idx < g.n {
			if g.res[idx] >= last {
				cur_len++;
				last = g.res[idx];
			} else if drops < allowed {
				drops++;
				cur_len++;
			} else {
				break;
			}
			idx++;
		}
		if cur_len > longest { longest = cur_len; }
	}
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "longest streak with retry: ", longest);
	out
}
@end
