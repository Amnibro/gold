	var i = s;
	while i <= e && i < out.s.len {
		let ch = out.s[i];
		if ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' { count++; }
		i++;
	}
	g.steps += e - s + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "vowels in span count ", count);
	out
}
