slot: cap int
slot: retries int
test: list=1,1,1,2,2,3 cap=2 retries=1
expect: => i=1 r=0.0 ok=true s="clamped duplicates removing 1" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=4,4,4,4,5 cap=1 retries=2
expect: => i=3 r=0.0 ok=true s="clamped duplicates removing 3" errors=0 n=2 res=[4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let r = ${retries};
	var kept = 0;
	for i in g.n {
		var cnt = 0;
		for j in kept {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt < c {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n * r;
	out.i = removed;
	out.s.clear();
	format(out.s, "clamped duplicates removing ", removed);
	out
}
@end
