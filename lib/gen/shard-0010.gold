fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var i = 1;
	while i < g.n {
		g.res[i] = min_val;
		i += 2;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "filled alternate elements with min: ", min_val);
	out
}
