fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var odds = 0;
	var idx = 0;
	while idx < g.n && odds < lim {
		if g.res[idx] % 2 != 0 {
			odds++;
		}
		idx++;
	}
	g.steps += idx;
	out.i = odds;
	out.s.clear();
	format(out.s, "ranked ", odds, " odds until limit");
	out
}
