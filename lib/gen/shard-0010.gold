code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prime_cnt++; }
		}
	}
	out.i = prime_cnt;
	out.s.clear();
	format(out.s, "primes ", prime_cnt, " of ", g.n);
	gold_push(g, prime_cnt);
	g.steps += g.n + prime_cnt + 1;
	out
}
@end
