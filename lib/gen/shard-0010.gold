	let b = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "returned budget of ", spent, " across ", kept, " items");
	out
}
