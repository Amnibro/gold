noun: average
modifier: first
context: filter
phrase: measure average of first elements filtering below
phrase: filter items falling below initial average threshold
test: list=10,20,30,5,15,40
expect: => i=20 r=0.0 ok=true s="filtered against initial average 20" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=50,10,20,30,5
expect: => i=26 r=0.0 ok=true s="filtered against initial average 26" errors=0 n=2 res=[50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let sample = if g.n < 3 { g.n } else { 3 };
	var sum = 0;
	for i in sample { sum += g.res[i]; }
	let avg = sum / sample;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = avg;
	out.s.clear();
	format(out.s, "filtered against initial average ", avg);
	out
}
@end
