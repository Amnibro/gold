	let mf = ${max_freq};
	var buf byte[200] = [0; 200];
	var kept = 0;
	for i in out.s.len {
		let b = out.s[i];
		var c = 0;
		for j in kept {
			if buf[j] == b { c++; }
		}
		if c < mf {
			buf[kept] = b;
			kept++;
		}
	}
	out.s.clear();
	for i in kept { out.s.push(buf[i]); }
	g.steps += kept;
	out.i = kept;
	out
}
