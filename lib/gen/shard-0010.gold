		gold_fail(g, "negative key for number cache");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid cache key ", k);
		return out;
	}
	gold_cache_put(g, k, n);
	g.steps += 1;
	out.i = n;
	out.s.clear();
	format(out.s, "cached number ", n, " at key ", k);
	out
}
@end
