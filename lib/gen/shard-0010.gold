@entry d4c38ce664225c42
kind: step
verb: return
noun: average
modifier: sorted
context: list
phrase: return average sorted bias {bias}
phrase: compute average sorted offset {bias}
slot: bias int
test: list=10,4,8,2 bias=1
expect: => i=7 r=0.0 ok=true s="sorted average result is 7" errors=0 n=4 res=[2,4,8,10] cache=0 hits=0
test: list=5,15 bias=0
expect: => i=10 r=0.0 ok=true s="sorted average result is 10" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n + b;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "sorted average result is ", avg);
	out
}
@end
