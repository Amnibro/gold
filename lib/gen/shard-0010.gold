fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if g.n < 2 { return out; }
	for i in 1..g.n {
		g.res[i] = g.res[i - 1] + g.res[i] + d;
	}
	g.steps += g.n;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "paired numbers in place final value ", g.res[g.n - 1]);
	out
}
