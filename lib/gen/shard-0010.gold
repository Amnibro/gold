expect: => i=2 r=0.0 ok=true s="scaled sorted run length 2" errors=0 n=3 res=[15,30,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${ratio};
	var run_len = 0;
	if g.n > 0 {
		run_len = 1;
		while run_len < g.n {
			if g.res[run_len] < g.res[run_len - 1] {
				break;
			}
			run_len++;
		}
	}
	for i in run_len {
		g.res[i] *= factor;
	}
	g.steps += run_len;
	out.i = run_len;
	out.s.clear();
	format(out.s, "scaled sorted run length ", run_len);
	out
}
@end
