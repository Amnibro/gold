fn ${ID}(n int) int {
	var v = n;
	if v < 0 {
		v = -v;
	}
	var asc = 0;
	var d = 0;
	while d <= 9 {
		var temp = v;
		while temp > 0 {
			if temp % 10 == d {
				asc = asc * 10 + d;
			}
			temp /= 10;
		}
		d++;
	}
	var desc = 0;
	d = 9;
	while d >= 0 {
		var temp = v;
		while temp > 0 {
			if temp % 10 == d {
				desc = desc * 10 + d;
			}
			temp /= 10;
		}
		d--;
	}
	return desc - asc;
}
@end
