expect: => i=6 r=0.0 ok=true s="unique error sum: 6 across 3 codes" errors=0 n=5 res=[3,1,3,2,1] cache=0 hits=0
test: list=5
expect: => i=5 r=0.0 ok=true s="unique error sum: 5 across 1 codes" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for unique error sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no results");
		return out;
	}
	var total = 0;
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			total += x;
			unique_count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "unique error sum: ", total, " across ", unique_count, " codes");
	out
}
@end
