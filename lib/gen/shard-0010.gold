	if g.n > 0 && lim > 0 {
		g.res[0] = g.res[0];
		kept = 1;
		var i = 1;
		while i < g.n && kept < lim {
			if g.res[i] >= g.res[kept - 1] {
				g.res[kept] = g.res[i];
				kept++;
			}
			i++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept sequence of ", kept, " items");
	g.steps += g.n + 1;
	out
}
