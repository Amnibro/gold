@entry fb9148f695f01690
kind: step
verb: group
noun: primes
modifier: nested
context: search
phrase: group primes nested prime counts in search space
phrase: collect nested prime elements from search distribution
test: list=4,2,6,3,8,5
expect: => i=3 r=0.0 ok=true s="grouped nested primes count: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,11,4,13,9
expect: => i=3 r=0.0 ok=true s="grouped nested primes count: 3" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped nested primes count: ", kept);
	out
}
@end
@entry e708b6708114cd41
kind: step
verb: shift
noun: pairs
modifier: any
context: search
phrase: shift pairs any adjacent values matching delta {target}
phrase: swap any adjacent search pairs with difference {target}
slot: target int
test: list=1,3,2,5 target=2
expect: => i=1 r=0.0 ok=true s="swapped matching pairs count: 1" errors=0 n=4 res=[3,1,2,5] cache=0 hits=0
test: list=10,13,11,15 target=3
expect: => i=1 r=0.0 ok=true s="swapped matching pairs count: 1" errors=0 n=4 res=[13,10,11,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${target};
	var swapped = 0;
	for i in 0..(g.n - 1) {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff == t {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped++;
		}
	}
	g.steps += g.n;
	out.i = swapped;
	out.s.clear();
	format(out.s, "swapped matching pairs count: ", swapped);
	out
}
@end
