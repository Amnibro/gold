slot: offset int
test: list=10,20,30,40,50 offset=0
expect: => i=2 r=0.0 ok=true s="filtered above average count 2" errors=0 n=2 res=[40,50] cache=1 hits=0
test: list=5,10,15,20,50 offset=0
expect: => i=1 r=0.0 ok=true s="filtered above average count 1" errors=0 n=1 res=[50] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] > avg + off {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	gold_cache_put(g, avg, kept);
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered above average count ", kept);
	out
}
@end
