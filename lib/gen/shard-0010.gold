@entry 76c574cbf233e734
kind: step
verb: scan
noun: digits
modifier: while
context: cache
phrase: scan digits while condition {p} holds
phrase: inspect digits while predicate {p} passes
slot: p pred
test: list=246,135,248 p=is_even
expect: => i=6 r=0.0 ok=true s="scanned 6 matching digits" errors=0 n=3 res=[246,135,248] cache=3 hits=0
test: list=135,246 p=is_odd
expect: => i=3 r=0.0 ok=true s="scanned 3 matching digits" errors=0 n=2 res=[135,246] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matching_count = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var match_digits = 0;
		while x > 0 {
			let d = x % 10;
			if ${p}(d) {
				match_digits++;
			}
			x /= 10;
		}
		gold_cache_put(g, i, match_digits);
		matching_count += match_digits;
	}
	g.steps += g.n;
	out.i = matching_count;
	out.s.clear();
	format(out.s, "scanned ", matching_count, " matching digits");
	out
}
@end
