fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let l = ${lo};
	let h = ${hi};
	var kept = 0;
	for i in g.n {
		let err = if g.res[i] >= tgt { g.res[i] - tgt } else { tgt - g.res[i] };
		if err >= l && err <= h {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
