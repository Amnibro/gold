@entry 78e883fcf9459e4a
kind: step
verb: select
noun: primes
modifier: unique
context: retry
phrase: select primes unique set filter
phrase: retain unique prime numbers from retry list
test: list=2,3,4,2,5,6,3
expect: => i=3 r=0.0 ok=true s="selected 3 unique primes" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=7,11,7,13,15,11
expect: => i=3 r=0.0 ok=true s="selected 3 unique primes" errors=0 n=3 res=[7,11,13] cache=0 hits=0
code:
fn ${ID}_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64];
	var kp = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_prime(x) {
			var exists = false;
			for k in kp {
				if kept[k] == x { exists = true; }
			}
			if !exists && kp < 64 {
				kept[kp] = x;
				kp++;
			}
		}
	}
	gold_clear(g);
	for k in kp {
		gold_push(g, kept[k]);
	}
	g.steps += kp + 1;
	out.i = kp;
	out.s.clear();
	format(out.s, "selected ", kp, " unique primes");
	out
}
@end
