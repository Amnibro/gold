fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 4 {
		let mid = g.n / 2;
		let tmp = g.res[mid - 1];
		g.res[mid - 1] = g.res[mid];
		g.res[mid] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped middle elements");
	out
}
@end
