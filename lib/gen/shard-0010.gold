code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shifts};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	if g.n > 1 && sh > 0 {
		let turns = sh % g.n;
		for step in turns {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated tally count ", g.n);
	out
}
@end
