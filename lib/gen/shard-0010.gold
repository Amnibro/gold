test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="dropped 3 running duplicate items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="no running duplicates found" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for running duplicate drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var write_idx = 1;
	var dropped = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
		i++;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	if dropped == 0 {
		format(out.s, "no running duplicates found");
	} else {
		format(out.s, "dropped ", dropped, " running duplicate items");
	}
	out
}
@end
@entry 77946e95f5740427
kind: step
verb: normalize
noun: gaps
modifier: any
context: error
slot: max_gap int
phrase: normalize gaps any difference exceeding bound {max_gap}
phrase: adjust any gaps between adjacent items bounded by {max_gap}
test: list=1,10,12 max_gap=4
expect: => i=2 r=0.0 ok=true s="normalized 2 excessive gaps" errors=0 n=3 res=[1,5,9] cache=0 hits=0
test: list=1,2 max_gap=-1
expect: => i=0 r=0.0 ok=false s="error: invalid gap limit -1" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if mg <= 0 || g.n < 2 {
		gold_fail(g, "invalid gap bound or short results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid gap limit ", mg);
		return out;
	}
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
			clamped++;
		} else if diff < -mg {
			g.res[i] = g.res[i - 1] - mg;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "normalized ", clamped, " excessive gaps");
	out
}
@end
