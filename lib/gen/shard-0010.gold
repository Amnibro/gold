slot: size int
test: list=4,2,4,3,1 size=3
expect: => i=2 r=0.0 ok=true s="sorted 2 unique window items" errors=0 n=5 res=[2,4,4,3,1] cache=0 hits=0
test: list=9,5,5,2 size=4
expect: => i=3 r=0.0 ok=true s="sorted 3 unique window items" errors=0 n=4 res=[2,5,9,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	let lim = if sz > g.n { g.n } else { sz };
	var uniq = 0;
	for i in lim {
		var seen = false;
		for j in i {
			if g.res[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			g.res[uniq] = g.res[i];
			uniq++;
		}
	}
	for i in uniq {
		for j in i + 1..uniq {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += lim;
	out.i = uniq;
	out.s.clear();
	format(out.s, "sorted ", uniq, " unique window items");
	out
}
@end
