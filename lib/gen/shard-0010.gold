code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_val = ${ceiling};
	var reductions = 0;
	for i in g.n {
		while g.res[i] > ceil_val {
			g.res[i] /= 2;
			reductions++;
		}
	}
	g.steps += reductions;
	out.i = reductions;
	out.s.clear();
	format(out.s, "clamped counter recursively with ", reductions, " reductions");
	out
}
@end
@entry dab3a7a0edea9d0d
kind: step
verb: sort
noun: window
modifier: any
context: search
phrase: sort any search candidate window of width {width}
phrase: order elements inside search window of width {width}
slot: width int
test: list=9,3,7,2,8 width=3
expect: => i=3 r=0.0 ok=true s="sorted window of width 3" errors=0 n=5 res=[3,7,9,2,8] cache=0 hits=0
test: list=20,10,40,30 width=4
expect: => i=4 r=0.0 ok=true s="sorted window of width 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	let limit = if w > g.n { g.n } else { w };
	for i in limit {
		for j in i + 1..limit {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += limit * limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted window of width ", limit);
	out
}
@end
@entry 7c76b3558089ac53
kind: step
verb: join
noun: checkpoint
modifier: first
context: search
phrase: join first search checkpoint results using step {step}
phrase: condense initial search checkpoint items with step {step}
slot: step int
test: list=2,4,6,8,10 step=2
expect: => i=18 r=0.0 ok=true s="joined checkpoint with total 18" errors=0 n=1 res=[18] cache=0 hits=0
test: list=1,3,5,7,9 step=3
expect: => i=8 r=0.0 ok=true s="joined checkpoint with total 8" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n == 0 || s <= 0 {
		out.i = 0;
		return out;
	}
	var count = 0;
	var total = 0;
	var i = 0;
	while i < g.n {
		total += g.res[i];
		count++;
		i += s;
	}
	g.res[0] = total;
	g.n = 1;
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "joined checkpoint with total ", total);
	out
}
@end
