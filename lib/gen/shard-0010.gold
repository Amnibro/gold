expect: => i=70 r=0.0 ok=true s="nested middle sum 70" errors=0 n=9 res=[2,5,10,15,20,25,30,40,70] cache=0 hits=0
test: list=1,4,8,12,16,20 trim_count=1
expect: => i=40 r=0.0 ok=true s="nested middle sum 40" errors=0 n=7 res=[1,4,8,12,16,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${trim_count};
	if g.n <= 2 * tc {
		out.i = 0;
		return out;
	}
	var mid_sum = 0;
	var mid_cnt = 0;
	var i = tc;
	while i < g.n - tc {
		var j = i;
		var local_acc = 0;
		while j < g.n - tc && j < i + 2 {
			local_acc += g.res[j];
			j++;
		}
		mid_sum += local_acc;
		mid_cnt++;
		i += 2;
	}
	out.i = mid_sum;
	out.s.clear();
	format(out.s, "nested middle sum ", mid_sum);
	gold_push(g, mid_sum);
	g.steps += mid_cnt + 1;
	out
}
@end
