phrase: group adjacent gaps bounded at most by {max_gap}
phrase: filter consecutive gaps at most {max_gap}
slot: max_gap int
test: list=10,13,20,22 max_gap=4
expect: => i=2 r=0.0 ok=true s="grouped 2 gaps within threshold" errors=0 n=2 res=[3,2] cache=0 hits=0
test: list=5,15,18,25 max_gap=5
expect: => i=1 r=0.0 ok=true s="grouped 1 gaps within threshold" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "need at least two items for gaps");
		out.ok = false;
		return out;
	}
	var kept = 0;
	for i in (g.n - 1) {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff <= mg {
			g.res[kept] = diff;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " gaps within threshold");
	out
}
@end
