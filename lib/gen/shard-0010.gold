code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let el = ${exp_len};
	if el <= 0 || g.n == 0 {
		gold_fail(g, "invalid expected length or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid unique streak comparison");
		return out;
	}
	var unique_len = 0;
	var i = 0;
	while i < g.n {
		var is_uniq = true;
		for j in i {
			if g.res[j] == g.res[i] { is_uniq = false; break; }
		}
		if is_uniq { unique_len++; } else { break; }
		i++;
	}
	g.steps += g.n * g.n;
	let matches = unique_len == el;
	out.ok = matches;
	out.i = unique_len;
	out.s.clear();
	if matches {
		format(out.s, "unique streak length matched expected ", el);
	} else {
		gold_fail(g, "unique streak length mismatch");
		out.ok = false;
		format(out.s, "error: expected streak ", el, " but got ", unique_len);
	}
	out
}
@end
