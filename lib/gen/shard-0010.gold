fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	while count < g.n && g.res[count] <= lim {
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "items before threshold: ", count);
	out
}
