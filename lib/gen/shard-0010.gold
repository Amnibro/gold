	if v < 10 {
		return 0;
	}
	var max_diff = 0;
	while v >= 10 {
		var d1 = v % 10;
		v /= 10;
		var d2 = v % 10;
		var diff = d1 - d2;
		if diff < 0 {
			diff = -diff;
