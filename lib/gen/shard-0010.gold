fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let tgt = ${target};
	var passed = 0;
	var inspected = 0;
	for i in g.n {
		inspected++;
		if g.res[i] > th {
			passed++;
			if passed == tgt {
				break;
			}
		}
	}
	g.steps += inspected;
	out.i = passed;
	out.s.clear();
	format(out.s, "threshold count reached: ", passed);
	out
}
@end
