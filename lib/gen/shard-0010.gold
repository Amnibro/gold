fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let limit = if d < g.n { d } else { g.n };
	if limit == 0 {
		out.i = 0;
		return out;
	}
	var max_val = g.res[0];
	for i in 1..limit {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	gold_cache_put(g, limit, max_val);
	g.steps += limit;
	out.i = max_val;
	out.s.clear();
	format(out.s, "found nested maximum ", max_val);
	out
}
@end
