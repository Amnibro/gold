	let goal = ${target_sum};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let reached = sum >= goal;
	g.steps += g.n;
	out.ok = reached;
	out.i = sum;
	out.s.clear();
	format(out.s, "series sum reached goal ", reached);
	out
}
@end
