	let s = ${step_size};
	if s <= 0 { return out; }
	var total = 0;
	var i = 0;
	while i < g.n {
		total += g.res[i];
		i += s;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "sum of stepped values: ", total);
	out
}
