code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var curr_len = g.n;
	while curr_len > 1 {
		var new_len = 0;
		var i = 0;
		while i + 1 < curr_len {
			g.res[new_len] = g.res[i] + g.res[i + 1];
			new_len++;
			i += 2;
		}
		if i < curr_len {
			g.res[new_len] = g.res[i];
			new_len++;
		}
		curr_len = new_len;
	}
	g.n = curr_len;
	g.steps += g.n;
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	out.s.clear();
	format(out.s, "recursively reduced pairs: ", out.i);
	out
}
@end
