phrase: prune value sorted threshold {cutoff}
slot: cutoff int
test: list=15,5,30,10 cutoff=12
expect: => i=2 r=0.0 ok=true s="sorted filtered count 2" errors=0 n=2 res=[15,30] cache=0 hits=0
test: list=8,2,6 cutoff=5
expect: => i=2 r=0.0 ok=true s="sorted filtered count 2" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var w = 0;
	for i in g.n {
		if g.res[i] >= cut {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "sorted filtered count ", w);
	out
}
@end
