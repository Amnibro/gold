code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	for i in g.n { g.res[i] -= mean; }
	g.steps += g.n;
	out.i = mean;
	out.s.clear();
	format(out.s, "centered distribution with mean: ", mean);
	out
}
@end
