code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list to reverse apply");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results list");
		return out;
	}
	for i in g.n {
		g.res[i] = ${sub}(g.res[i]);
	}
	var i = 0;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed transformed list of size ", g.n);
	out
}
@end
