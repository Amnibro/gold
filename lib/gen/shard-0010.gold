	let hi = ${high};
	if g.n < 2 { return out; }
	var swaps = 0;
	for i in (g.n - 1) {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a >= lo && a <= hi && b >= lo && b <= hi && a > b {
			g.res[i] = b;
			g.res[i + 1] = a;
			swaps++;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " swaps between bounds");
	out
}
@end
