code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dp = ${depth};
	var words = 0;
	var in_word = false;
	for i in out.s.len {
		if out.s[i] == 32 as byte {
			if in_word { words++; in_word = false; }
		} else {
			in_word = true;
		}
	}
	if in_word { words++; }
	let val = words * dp;
	gold_push(g, val);
	g.steps += out.s.len;
	out.i = val;
	out.s.clear();
	format(out.s, "folded words depth value ", val);
	out
}
@end
