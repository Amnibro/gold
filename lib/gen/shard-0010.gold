code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = if ${step_size} <= 1 { 2 } else { ${step_size} };
	var rev_count = 0;
	var i = 0;
	while i + bs <= g.n {
		var p1 = i;
		var p2 = i + bs - 1;
		while p1 < p2 {
			let tmp = g.res[p1];
			g.res[p1] = g.res[p2];
			g.res[p2] = tmp;
			p1++;
			p2--;
		}
		rev_count++;
		i += bs;
	}
	out.i = rev_count;
	out.s.clear();
	format(out.s, "reversed ", rev_count, " search blocks");
	gold_push(g, rev_count);
	g.steps += g.n + 1;
	out
}
@end
