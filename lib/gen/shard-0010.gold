kind: step
verb: drop
noun: streak
modifier: running
context: search
phrase: drop streak running identical consecutive values
phrase: eliminate running consecutive duplicate search items
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="dropped consecutive duplicates count: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,7,7
expect: => i=2 r=0.0 ok=true s="dropped consecutive duplicates count: 2" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped consecutive duplicates count: ", dropped);
	out
}
@end
