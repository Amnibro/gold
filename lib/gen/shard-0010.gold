code:
fn ${ID}(n int) int {
	var v = n;
	if v <= 1 {
		return 0;
	}
	var count = 0;
	var d = 2;
	while d * d <= v {
		if v % d == 0 {
			count++;
			while v % d == 0 {
				v /= d;
			}
		}
		d++;
	}
	if v > 1 {
		count++;
	}
	return count;
}
@end
