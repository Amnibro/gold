@entry bae0cdb8825bf3ed
kind: step
verb: dedupe
noun: maximum
modifier: until
context: stats
phrase: dedupe maximum until ceiling {ceiling}
phrase: purge maximum until bound {ceiling}
slot: ceiling int
test: list=5,10,10,10,8 ceiling=1
expect: => i=2 r=0.0 ok=true s="deduped maximum removed 2" errors=0 n=3 res=[5,10,8] cache=0 hits=0
test: list=3,7,7 ceiling=2
expect: => i=0 r=0.0 ok=true s="deduped maximum removed 0" errors=0 n=3 res=[3,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if g.n == 0 { out.i = 0; return out; }
	var max_v = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_v { max_v = g.res[i]; }
	}
	var w = 0;
	var max_seen = 0;
	for i in g.n {
		if g.res[i] == max_v {
			max_seen++;
			if max_seen <= ceil {
				g.res[w] = g.res[i];
				w++;
			}
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped maximum removed ", removed);
	out
}
@end
