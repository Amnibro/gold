	var write_idx = 0;
	for i in g.n {
		if g.res[i] == target && dropped < t {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " occurrences of value ", target);
	out
}
