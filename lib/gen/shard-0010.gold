@entry c1f6b0ead09ffe38
kind: step
verb: filter
noun: average
modifier: any
context: list
phrase: filter average any bias {bias}
phrase: prune average any margin {bias}
slot: bias int
test: list=2,4,6,8,10 bias=0
expect: => i=2 r=0.0 ok=true s="filtered below average removed 2" errors=0 n=3 res=[6,8,10] cache=0 hits=0
test: list=10,20,30 bias=5
expect: => i=1 r=0.0 ok=true s="filtered below average removed 1" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n - b;
	var w = 0;
	for i in g.n {
		if g.res[i] >= avg {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered below average removed ", removed);
	out
}
@end
