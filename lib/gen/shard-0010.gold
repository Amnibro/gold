@entry df3f3f005e907a94
kind: step
verb: check
noun: histogram
modifier: last
context: cache
phrase: check histogram last bucket meets minimum {min_count}
phrase: verify last element frequency meets {min_count}
slot: min_count int
test: list=1,2,3,3,3 min_count=2
expect: => i=3 r=0.0 ok=true s="last element meets minimum count with 3" errors=0 n=5 res=[1,2,3,3,3] cache=1 hits=0
test: list=1,2,3 min_count=5
expect: => i=1 r=0.0 ok=false s="last element count 1 below required" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	let last_val = g.res[g.n - 1];
	var freq = 0;
	for i in g.n {
		if g.res[i] == last_val {
			freq++;
		}
	}
	gold_cache_put(g, last_val, freq);
	let meets = freq >= mc;
	out.i = freq;
	out.ok = meets;
	out.s.clear();
	if meets {
		format(out.s, "last element meets minimum count with ", freq);
	} else {
		format(out.s, "last element count ", freq, " below required");
	}
	g.steps += g.n;
	out
}
@end
