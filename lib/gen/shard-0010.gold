@entry 051c0a37505e20cc
kind: step
verb: reverse
noun: gaps
modifier: safely
context: aggregate
phrase: reverse gaps safely exceeding span {threshold}
phrase: invert gaps safely with difference over {threshold}
slot: threshold int
test: list=1,10,2,20 threshold=5
expect: => i=2 r=0.0 ok=true s="reversed gap pairs count 2" errors=0 n=4 res=[10,1,20,2] cache=0 hits=0
test: list=5,6,20,22 threshold=10
expect: => i=1 r=0.0 ok=true s="reversed gap pairs count 1" errors=0 n=4 res=[5,20,6,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > th || diff < -th {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed gap pairs count ", count);
	out
}
@end
