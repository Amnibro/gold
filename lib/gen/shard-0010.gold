code:
fn ${ID}(n int) int {
	let b = ${bound};
	var x = if n < 0 { -n } else { n };
	var seen = [false; 10];
	var count = 0;
	if x == 0 { count = 1; }
	while x > 0 {
		let d = x % 10;
		if !seen[d] {
			seen[d] = true;
			count++;
		}
		x /= 10;
	}
	if count > b { b } else { count }
}
@end
