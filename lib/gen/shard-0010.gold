@entry 6759eeea16d31bfd
kind: step
verb: rotate
noun: number
modifier: unique
context: search
phrase: rotate unique search numbers by shift {shift}
phrase: cycle unique search candidate numbers by offset {shift}
slot: shift int
test: list=1,2,2,3,4 shift=1
expect: => i=4 r=0.0 ok=true s="rotated 4 unique numbers" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=5,5,6,7,8 shift=2
expect: => i=4 r=0.0 ok=true s="rotated 4 unique numbers" errors=0 n=4 res=[7,8,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shift};
	var un = 0;
	for i in g.n {
		var dup = false;
		for j in un {
			if g.res[j] == g.res[i] { dup = true; }
		}
		if !dup {
			g.res[un] = g.res[i];
			un++;
		}
	}
	g.n = un;
	if un > 1 && sh > 0 {
		let eff = sh % un;
		for s in eff {
			let last = g.res[un - 1];
			var j = un - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	g.steps += un;
	out.i = un;
	out.s.clear();
	format(out.s, "rotated ", un, " unique numbers");
	out
}
@end
