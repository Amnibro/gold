test: list=12,4,8,15 cutoff=5
expect: => i=1 r=0.0 ok=true s="purged trailing count: 1" errors=0 n=3 res=[12,8,15] cache=1 hits=0
test: list=20,3,10,6 cutoff=4
expect: => i=1 r=0.0 ok=true s="purged trailing count: 1" errors=0 n=3 res=[20,10,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var kept = 0;
	for i in g.n {
		if g.res[i] >= cut {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	gold_cache_put(g, cut, dropped);
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "purged trailing count: ", dropped);
	out
}
@end
