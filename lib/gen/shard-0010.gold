fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var total = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			total += x;
			count++;
			if total >= lim { break; }
		}
	}
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "sum of odds reached: ", total);
	out
}
@end
