expect: => i=3 r=0.0 ok=true s="sorted last 3 items" errors=0 n=4 res=[100,2,5,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${tail_count};
	let start = if g.n > tc { g.n - tc } else { 0 };
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n - start;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "sorted last ", g.n - start, " items");
	out
}
@end
