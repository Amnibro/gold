@entry a49e88be4007f21b
kind: step
verb: trace
noun: gaps
modifier: none
context: compare
phrase: trace gaps none directly between comparison steps
phrase: compute gaps none across adjacent comparison values
phrase: record difference gaps none between elements
test: list=2,5,9,14
expect: => i=3 r=0.0 ok=true s="traced 3 gaps between items" errors=0 n=3 res=[3,4,5] cache=0 hits=0
test: list=10,20,50
expect: => i=2 r=0.0 ok=true s="traced 2 gaps between items" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var buf int[512] = [0; 512];
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		buf[i] = if diff < 0 { -diff } else { diff };
	}
	for i in g.n - 1 { g.res[i] = buf[i]; }
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced ", g.n, " gaps between items");
	out
}
@end
