fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	g.steps += g.n;
	if min_val < b {
		out.i = b;
	} else {
		out.i = min_val;
	}
	out.s.clear();
	format(out.s, "bounded minimum statistic: ", out.i);
	out
}
@end
