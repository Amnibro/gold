fn ${ID}(n int) bool {
	let cd = ${code};
	var x = if n < 0 { -n } else { n };
	var found = false;
	if x == 0 && cd == 0 { found = true; }
	while x > 0 {
		if x % 10 == cd {
			found = true;
			break;
		}
		x /= 10;
	}
	!found
}
@end
