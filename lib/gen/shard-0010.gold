slot: lim int
test: list=5,15,8,25 lim=10
expect: => i=2 r=0.0 ok=true s="rotated by 2 threshold items" errors=0 n=4 res=[8,25,5,15] cache=0 hits=0
test: list=30,40,10,5 lim=20
expect: => i=2 r=0.0 ok=true s="rotated by 2 threshold items" errors=0 n=4 res=[10,5,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var count = 0;
	for i in g.n {
		if g.res[i] > limit { count++; }
	}
	if g.n > 1 && count > 0 {
		let k = count % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated by ", count, " threshold items");
	out
}
@end
