@entry 1b236e8c069e4c08
kind: step
verb: rotate
noun: errors
modifier: unique
context: aggregate
phrase: rotate unique negative error codes through results
phrase: cycle distinct error values across sequence
test: list=-1,-2,-3
expect: => i=3 r=0.0 ok=true s="rotated 3 unique error items" errors=0 n=3 res=[-2,-3,-1] cache=0 hits=0
test: list=-10,-20,-30,-40
expect: => i=4 r=0.0 ok=true s="rotated 4 unique error items" errors=0 n=4 res=[-20,-30,-40,-10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var kept = 0;
	for i in g.n {
		if g.res[i] < 0 {
			var seen = false;
			for j in kept {
				if temp[j] == g.res[i] { seen = true; }
			}
			if !seen {
				temp[kept] = g.res[i];
				kept++;
			}
		}
	}
	if kept > 1 {
		let first = temp[0];
		for i in (kept - 1) {
			temp[i] = temp[i + 1];
		}
		temp[kept - 1] = first;
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "rotated ", kept, " unique error items");
	out
}
@end
