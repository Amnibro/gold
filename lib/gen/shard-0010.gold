code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		let total_gaps = g.n - 1;
		var kept = 0;
		for i in total_gaps {
			let gap = g.res[i];
			if i == 0 || gap != g.res[i - 1] || gap > mg {
				g.res[kept] = gap;
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped spaces count=", g.n);
	out
}
@end
