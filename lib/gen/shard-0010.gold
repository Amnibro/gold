fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered out ", removed, " negative values");
	out
}
@end
