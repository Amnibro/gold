fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_val = lo;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if !found || x > max_val {
				max_val = x;
				found = true;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum between bounds is ", max_val);
	out
}
