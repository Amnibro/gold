@entry b3fdc8fb880a0649
kind: step
verb: sum
noun: odds
modifier: every_other
context: format
phrase: format sum of odd values at every other index
phrase: render total of alternating odd elements
test: list=1,2,3,4,5
expect: => i=9 r=0.0 ok=true s="alternating odd sum: 9" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,11,13,14,15
expect: => i=28 r=0.0 ok=true s="alternating odd sum: 28" errors=0 n=5 res=[10,11,13,14,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		if (i % 2 == 0) && (g.res[i] % 2 != 0) {
			sum += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "alternating odd sum: ", sum);
	out
}
@end
