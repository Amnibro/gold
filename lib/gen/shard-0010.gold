@entry 7c711128b133a394
kind: step
verb: repeat
noun: steps
modifier: safely
context: cache
phrase: repeat cache steps safely within budget {budget}
phrase: cycle cached step count safely under budget {budget}
slot: budget int
test: list=10,20,30 budget=40
expect: => i=21 r=0.0 ok=true s="repeated steps safely adding 21 items" errors=0 n=24 res=[10,20,30,10,20,30,10,20,30,10,20,30,10,20,30,10,20,30,10,20,30,10,20,30] cache=1 hits=0
test: list=5,15 budget=25
expect: => i=14 r=0.0 ok=true s="repeated steps safely adding 14 items" errors=0 n=16 res=[5,15,5,15,5,15,5,15,5,15,5,15,5,15,5,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var added = 0;
	while g.steps + g.n <= b && g.n < 256 {
		let curr_n = g.n;
		for i in curr_n {
			if g.n < 512 {
				g.res[g.n] = g.res[i];
				g.n++;
				added++;
			}
		}
		g.steps += curr_n;
	}
	gold_cache_put(g, 0, g.steps);
	out.i = added;
	out.s.clear();
	format(out.s, "repeated steps safely adding ", added, " items");
	out
}
@end
@entry 1fdde8ab57b76f4e
kind: step
verb: dedupe
noun: errors
modifier: running
context: cache
phrase: dedupe running cache error entries bounded by {limit}
phrase: prune duplicate running errors under limit {limit}
slot: limit int
test: list=-1,-1,5,-2,-2,8 limit=4
expect: => i=2 r=0.0 ok=true s="deduped running errors removing 2" errors=0 n=4 res=[-1,5,-2,8] cache=0 hits=0
test: list=-3,-3,10,-5 limit=2
expect: => i=1 r=0.0 ok=true s="deduped running errors removing 1" errors=0 n=3 res=[-3,10,-5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let is_dup = kept > 0 && g.res[i] < 0 && g.res[kept - 1] == g.res[i];
		if !is_dup || kept >= lim {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped running errors removing ", removed);
	out
}
@end
