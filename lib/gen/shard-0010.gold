fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_val};
	var count = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sq > limit { break; }
