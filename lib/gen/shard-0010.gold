		while j + 1 < g.n && swaps < ms {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "histogram sorted with ", swaps, " swaps");
	gold_push(g, swaps);
	g.steps += swaps + 1;
	out
}
