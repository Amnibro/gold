@entry 6f09dc8c2b8a9a47
kind: step
verb: swap
noun: threshold
modifier: in_reverse
context: math
phrase: swap threshold in_reverse exceeding cutoff {floor_val}
phrase: invert threshold in_reverse beyond barrier {floor_val}
slot: floor_val int
test: list=2,10,20,5 floor_val=8
expect: => i=2 r=0.0 ok=true s="swapped threshold count 2" errors=0 n=4 res=[2,20,10,5] cache=0 hits=0
test: list=1,2,3 floor_val=5
expect: => i=0 r=0.0 ok=true s="swapped threshold count 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${floor_val};
	var matched int[>..] = [];
	for i in g.n {
		if g.res[i] > cutoff { matched.push(i); }
	}
	var l = 0;
	var r = matched.len - 1;
	while l < r {
		let idx_a = matched[l];
		let idx_b = matched[r];
		let tmp = g.res[idx_a];
		g.res[idx_a] = g.res[idx_b];
		g.res[idx_b] = tmp;
		l++;
		r--;
	}
	g.steps += g.n;
	out.i = matched.len;
	out.s.clear();
	format(out.s, "swapped threshold count ", matched.len);
	out
}
@end
