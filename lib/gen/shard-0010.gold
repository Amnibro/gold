fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if b <= 0 || g.n == 0 {
		gold_fail(g, "invalid budget or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid budget limit ", b);
		return out;
	}
	var spent = 0;
	var collected = 0;
	for i in g.n {
		if spent + g.res[i] <= b {
			spent += g.res[i];
			gold_cache_put(g, collected, g.res[i]);
			collected++;
		}
	}
	g.steps += g.n;
	out.i = collected;
	out.s.clear();
	format(out.s, "collected ", collected, " items within budget into cache");
	out
}
