code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ta = ${target_avg};
	if ta <= 0 || g.n == 0 {
		gold_fail(g, "invalid target average for loop fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid target average ", ta);
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var added = 0;
	while (sum / g.n) < ta && g.n < 500 && added < 8 {
		gold_push(g, 0);
		gold_push(g, ta * 2);
		sum += ta * 2;
		added += 2;
	}
	g.steps += g.n + added;
	out.i = added;
	out.s.clear();
	format(out.s, "filled ", added, " alternating items to reach average");
	out
}
@end
