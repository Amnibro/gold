@entry 0dc7fe4897c44882
kind: step
verb: merge
noun: streak
modifier: first
context: transform
phrase: merge initial contiguous streak into single sum
phrase: collapse first streak of identical values into sum
test: list=3,3,3,4,5
expect: => i=3 r=0.0 ok=true s="collapsed initial streak length: 3" errors=0 n=3 res=[9,4,5] cache=0 hits=0
test: list=7,7,8,9,9
expect: => i=2 r=0.0 ok=true s="collapsed initial streak length: 2" errors=0 n=4 res=[14,8,9,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak_len = 1;
	if g.n > 1 {
		while streak_len < g.n && g.res[streak_len] == g.res[0] {
			streak_len++;
		}
		if streak_len > 1 {
			let streak_val = g.res[0] * streak_len;
			g.res[0] = streak_val;
			var write_idx = 1;
			for read_idx in streak_len..g.n {
			g.res[write_idx] = g.res[read_idx];
			write_idx++;
			}
			g.n = write_idx;
		}
	}
	g.steps += g.n;
	out.i = streak_len;
	out.s.clear();
	format(out.s, "collapsed initial streak length: ", streak_len);
	out
}
@end
