fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let hs = if ${head_size} < g.n { ${head_size} } else { g.n };
	let f = ${factor};
	var scaled = 0;
	var i = 0;
	while i < hs {
		var unique = true;
		var j = 0;
		while j < hs {
			if i != j && g.res[i] == g.res[j] {
				unique = false;
				break;
			}
			j++;
		}
		if unique {
			g.res[i] *= f;
			scaled++;
		}
		i++;
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " unique head items");
	gold_push(g, scaled);
	g.steps += hs + 1;
	out
}
@end
@entry ea8499983dd5d64f
kind: step
