@entry c5f525af4fbb6428
kind: step
verb: repeat
noun: tail
modifier: any
context: sort
phrase: repeat any sorted tail elements above threshold {threshold}
phrase: duplicate any sorted tail entries exceeding threshold {threshold}
slot: threshold int
test: list=10,20,30,40 threshold=25
expect: => i=2 r=0.0 ok=true s="repeated tail adding 2 duplicates" errors=0 n=6 res=[10,20,30,30,40,40] cache=0 hits=0
test: list=5,15,25,35 threshold=30
expect: => i=1 r=0.0 ok=true s="repeated tail adding 1 duplicates" errors=0 n=5 res=[5,15,25,35,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var buf int[512] = [0; 512];
	var bn = 0;
	for i in g.n {
		buf[bn] = g.res[i];
		bn++;
		if g.res[i] > thresh && bn < 512 {
			buf[bn] = g.res[i];
			bn++;
		}
	}
	for k in bn { g.res[k] = buf[k]; }
	let added = bn - g.n;
	g.n = bn;
	g.steps += bn;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated tail adding ", added, " duplicates");
	out
}
@end
@entry 3eb0ba192aebd8cd
kind: step
verb: search
noun: middle
modifier: with_retry
context: sort
phrase: search middle of sorted array for {target} with retries {retries}
phrase: locate target {target} from median with retry limit {retries}
slot: target int
slot: retries int
test: list=10,20,30,40,50 target=30 retries=2
expect: => i=2 r=0.0 ok=true s="search middle result index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35 target=35 retries=3
expect: => i=3 r=0.0 ok=true s="search middle result index 3" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	var found = -1;
	var low = 0;
	var high = g.n - 1;
	var attempt = 0;
	while low <= high && attempt < r {
		let mid = (low + high) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			low = mid + 1;
		} else {
			high = mid - 1;
		}
		attempt++;
	}
	g.steps += attempt + 1;
	out.i = found;
	out.s.clear();
	format(out.s, "search middle result index ", found);
	out
}
@end
