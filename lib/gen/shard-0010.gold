@entry b39db13829c0ce43
kind: step
verb: search
noun: primes
modifier: at_most
context: cache
phrase: search cache for primes gathering at most {limit} items
phrase: collect prime cache keys at most up to {limit}
slot: limit int
test: list=2,3,4,5,6,7 limit=3
expect: => i=3 r=0.0 ok=true s="found 3 cached primes" errors=0 n=3 res=[2,3,5] cache=3 hits=0
test: list=9,10,11,12,13 limit=2
expect: => i=2 r=0.0 ok=true s="found 2 cached primes" errors=0 n=2 res=[11,13] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && kept < lim {
			gold_cache_put(g, x, 1);
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " cached primes");
	out
}
@end
