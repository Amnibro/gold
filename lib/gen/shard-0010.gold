slot: cap int
test: list=10,20,30,40 cap=25
expect: => i=2 r=0.0 ok=true s="clamped 2 items in reverse list" errors=0 n=4 res=[25,25,20,10] cache=0 hits=0
test: list=5,15,25 cap=10
expect: => i=2 r=0.0 ok=true s="clamped 2 items in reverse list" errors=0 n=3 res=[10,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ceiling {
			g.res[i] = ceiling;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " items in reverse list");
	out
}
@end
