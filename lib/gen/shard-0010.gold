	if found >= 0 {
		out.i = found;
		out.s.clear();
		format(out.s, "found target at ", found);
	} else {
		gold_fail(g, "target missing");
		out.i = -1;
		out.s.clear();
		format(out.s, "target not found");
	}
	g.steps += g.n;
	out
}
