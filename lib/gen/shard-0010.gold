expect: => i=0 r=0.0 ok=true s="tail elements in range: 0" errors=0 n=5 res=[1,2,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${low};
	let upper = ${high};
	var tail_hits = 0;
	var inspect_len = 3;
	if inspect_len > g.n { inspect_len = g.n; }
	for i in inspect_len {
		let v_elem = g.res[g.n - 1 - i];
		if v_elem >= lower && v_elem <= upper {
			tail_hits++;
		}
	}
	g.steps += inspect_len;
	out.i = tail_hits;
	out.s.clear();
	format(out.s, "tail elements in range: ", tail_hits);
	out
}
@end
