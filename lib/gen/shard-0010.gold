fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gv = ${gap_val};
	if g.n < 2 { return out; }
	var temp int[512] = [0; 512];
	temp[0] = g.res[0];
	for i in (g.n - 1) {
		temp[2 * i + 1] = gv;
		temp[2 * i + 2] = g.res[i + 1];
	}
	let new_len = 2 * g.n - 1;
	for i in new_len { g.res[i] = temp[i]; }
	g.n = new_len;
	g.steps += new_len;
	out.i = new_len;
	out.s.clear();
	format(out.s, "filled all gaps giving length ", new_len);
	out
}
@end
