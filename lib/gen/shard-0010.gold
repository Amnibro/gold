expect: => i=0 r=0.0 ok=true s="budget pairs in range 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var valid_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if sum >= lo && sum <= hi {
			valid_pairs++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = valid_pairs;
	out.s.clear();
	format(out.s, "budget pairs in range ", valid_pairs);
	out
}
@end
