	if m <= 0 { out.i = 0; return out; }
	var zeros = 0;
	for i in g.n {
		if g.res[i] % m == 0 { zeros++; }
	}
	g.steps += g.n;
	out.i = zeros;
	out.s.clear();
	format(out.s, "function modulus zero count ", zeros);
	out
}
@end
@entry 5c36ac51060da839
kind: step
verb: scale
noun: sequence
modifier: in_reverse
context: retry
phrase: scale sequence in reverse multiplier {factor}
phrase: scale retry sequence elements in reverse with {factor}
slot: factor int
test: list=2,4,6 factor=3
expect: => i=3 r=0.0 ok=true s="scaled sequence in reverse count 3" errors=0 n=3 res=[18,12,6] cache=0 hits=0
test: list=1,3,5,7 factor=2
expect: => i=4 r=0.0 ok=true s="scaled sequence in reverse count 4" errors=0 n=4 res=[14,10,6,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	for i in g.n {
		g.res[i] *= f;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled sequence in reverse count ", g.n);
	out
}
@end
@entry 5d2d3cef8e0d18aa
kind: step
verb: dedupe
noun: head
modifier: up_to
context: stats
phrase: dedupe head up_to count {count}
phrase: prune head up_to span {count}
slot: count int
test: list=5,5,10,10,20 count=4
expect: => i=2 r=0.0 ok=true s="head deduped removed 2" errors=0 n=3 res=[5,10,20] cache=0 hits=0
test: list=1,1,2 count=2
expect: => i=1 r=0.0 ok=true s="head deduped removed 1" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var k = c;
	if k > g.n { k = g.n; }
	var w = 0;
	var removed = 0;
	for i in k {
		var is_dup = false;
		for j in w {
			if g.res[j] == g.res[i] { is_dup = true; break; }
		}
		if is_dup {
			removed++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	for i in k..g.n {
		g.res[w] = g.res[i];
		w++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "head deduped removed ", removed);
	out
}
@end
