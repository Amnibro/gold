code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var cnt = 0;
		for j in g.n {
			if g.res[j] == x { cnt++; }
		}
		if cnt == 1 {
			temp[kept] = x;
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "found ", kept, " strictly unique results");
	out
}
@end
