code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sub int[512] = [0; 512];
	var sn = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			sub[sn] = g.res[i];
			sn++;
		}
	}
	let mid = if sn > 0 { sub[sn / 2] } else { 0 };
	g.steps += g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "traced middle element ", mid);
	out
}
@end
