	var idx = 0;
	while idx < g.n && !${cond}(g.res[idx]) {
		idx++;
	}
	let remaining = g.n - idx;
	for i in remaining {
		g.res[i] = g.res[idx + i];
	}
	g.n = remaining;
	g.steps += idx;
	out.i = idx;
	out.s.clear();
	format(out.s, "dropped ", idx, " items until condition");
	out
}
