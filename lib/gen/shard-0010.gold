code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cur_len = 0;
	var ok = true;
	for i in out.s.len {
		if out.s[i] == 32 as byte {
			if cur_len > lim { ok = false; break; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len > lim { ok = false; }
	g.steps += out.s.len;
	out.ok = ok;
	if !ok {
		gold_fail(g, "word length exceeded limit");
		out.i = 0;
	} else {
		out.i = out.s.len;
	}
	out.s.clear();
	format(out.s, "validated text length ok ", ok);
	out
}
@end
