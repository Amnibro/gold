slot: limit int
test: list=10,20,20,15,30 limit=25
expect: => i=15 r=0.0 ok=true s="maximum unique item under limit: 15" errors=0 n=5 res=[10,20,20,15,30] cache=0 hits=0
test: list=5,5,8,12 limit=10
expect: => i=8 r=0.0 ok=true s="maximum unique item under limit: 8" errors=0 n=4 res=[5,5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_val = 0;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x <= lim {
			var seen = 0;
			for j in g.n {
				if g.res[j] == x { seen++; }
			}
			if seen == 1 {
				if !found || x > max_val {
					max_val = x;
					found = true;
				}
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = max_val;
	out.s.clear();
	format(out.s, "maximum unique item under limit: ", max_val);
	out
}
@end
