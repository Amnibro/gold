code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x > 1 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; }
				d++;
			}
			if is_p { prime_count++; }
		}
	}
	out.i = prime_count;
	out.s.clear();
	format(out.s, "primes count=", prime_count);
	out
}
@end
