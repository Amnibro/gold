fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough history to swap");
		out.ok = false;
		return out;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[1];
	g.res[1] = tmp;
	g.steps += 2;
