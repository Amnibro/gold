code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_allowed = ${ceiling};
	var within_limits = true;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] { freq++; }
		}
		if freq > max_allowed {
			within_limits = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = within_limits;
	out.i = if within_limits { 1 } else { 0 };
	out.s.clear();
	format(out.s, "histogram within ceiling limit: ", within_limits);
	out
}
@end
