fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	var modified = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] + s {
			g.res[i] = g.res[i - 1] + s;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped recursive steps count ", modified);
	out
}
