@entry 3403e479a11482d4
kind: step
verb: scan
noun: tally
modifier: safely
context: filter
phrase: scan tally safely filtering items above {limit}
phrase: safely filter running tally exceeding limit {limit}
slot: limit int
test: list=10,20,30,40 limit=50
expect: => i=30 r=0.0 ok=true s="safely scanned tally to 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35 limit=40
expect: => i=20 r=0.0 ok=true s="safely scanned tally to 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var tally = 0;
	var kept = 0;
	for i in g.n {
		if tally + g.res[i] <= lim {
			tally += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = tally;
	out.s.clear();
	format(out.s, "safely scanned tally to ", tally);
	out
}
@end
@entry 855f3c937e4ac710
kind: step
verb: dedupe
noun: subfunction
modifier: in_place
context: filter
phrase: dedupe items in place after applying {sub}
phrase: apply subfunction {sub} deduping results in place
slot: sub fn
test: list=1,1,2,3 sub=double
expect: => i=3 r=0.0 ok=true s="deduped in place to 3 elements" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=10,10,20,30,30,40 sub=double
expect: => i=4 r=0.0 ok=true s="deduped in place to 4 elements" errors=0 n=4 res=[20,40,60,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	for i in g.n { g.res[i] = ${sub}(g.res[i]); }
	var kept = 1;
	for i in (g.n - 1) {
		let curr = g.res[i + 1];
		if curr != g.res[kept - 1] {
			g.res[kept] = curr;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped in place to ", kept, " elements");
	out
}
@end
@entry 0c82740bc92a4397
kind: step
verb: rotate
noun: value
modifier: with_retry
context: filter
phrase: rotate value positions with retry limit {count}
phrase: cycle results with retry bound {count} positions
slot: count int
test: list=1,2,3,4 count=1
expect: => i=1 r=0.0 ok=true s="rotated 4 values by 1" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="rotated 4 values by 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n < 2 { return out; }
	let shift = k % g.n;
	if shift == 0 { return out; }
	var temp int[512] = [0; 512];
	for i in g.n {
		let idx = (i + shift) % g.n;
		temp[i] = g.res[idx];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated ", g.n, " values by ", shift);
	out
}
@end
@entry 9721f670c1e7d9a4
kind: step
verb: select
noun: counter
modifier: last
context: filter
phrase: select counter tracking last {count} elements
phrase: filter sequence taking counter of last {count} items
slot: count int
test: list=1,-2,3,-4,5 count=3
expect: => i=2 r=0.0 ok=true s="selected counter 2 from last elements" errors=0 n=3 res=[3,-4,5] cache=0 hits=0
test: list=10,20,-30 count=2
expect: => i=1 r=0.0 ok=true s="selected counter 1 from last elements" errors=0 n=2 res=[20,-30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var kept = 0;
	var pos_cnt = 0;
	for i in (g.n - start) {
		let x = g.res[start + i];
		g.res[i] = x;
		if x > 0 { pos_cnt++; }
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = pos_cnt;
	out.s.clear();
	format(out.s, "selected counter ", pos_cnt, " from last elements");
	out
}
@end
@entry b6f42e628bb2c5ba
kind: step
