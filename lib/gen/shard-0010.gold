expect: => i=2 r=0.0 ok=true s="returned 2 unique window elements" errors=0 n=2 res=[1,2] cache=0 hits=0
test: list=10,10,20,30 window=3
expect: => i=2 r=0.0 ok=true s="returned 2 unique window elements" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	let limit = if w < g.n { w } else { g.n };
	var kept = 0;
	for i in limit {
		var dup = false;
		for j in kept {
			if g.res[j] == g.res[i] { dup = true; }
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " unique window elements");
	out
}
@end
