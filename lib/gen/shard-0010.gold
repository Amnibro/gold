fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	if g.n == 0 { return out; }
	var val = g.res[0];
	var k = 0;
	while k < r {
		if val % 2 == 0 { val = val / 2; }
		else { val = val * 3 + 1; }
		k++;
	}
	g.res[0] = val;
	g.steps += k;
	out.i = val;
	out.s.clear();
	format(out.s, "retried first item value is ", val);
	out
}
