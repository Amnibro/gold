expect: => i=2 r=0.0 ok=true s="reversed trailing 2 bins" errors=0 n=6 res=[5,15,25,45,35,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let start = if g.n > c { g.n - c } else { 0 };
	var p1 = start;
	var p2 = g.n - 1;
	while p1 < p2 {
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		p1++;
		p2--;
	}
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "reversed trailing ", out.i, " bins");
	gold_push(g, out.i);
	g.steps += (g.n - start) + 1;
	out
}
@end
