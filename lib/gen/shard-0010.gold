expect: => i=20 r=0.0 ok=true s="summed 2 numbers at least 5 to 20" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var total = 0;
	var kept = 0;
	for i in g.n {
		if g.res[i] >= th {
			total += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = total;
	out.s.clear();
	format(out.s, "summed ", kept, " numbers at least ", th, " to ", total);
	out
}
@end
