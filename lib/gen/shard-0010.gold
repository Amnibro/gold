code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var spent = 0;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let idx = g.n - 1 - i;
		let x = g.res[idx];
		if spent + x <= b {
			spent += x;
			temp[kept] = x;
			gold_cache_put(g, x, kept);
			kept++;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = spent;
	out.s.clear();
	format(out.s, "cached and reversed ", kept, " budget items");
	out
}
@end
