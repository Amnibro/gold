code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let cached_idx, found = gold_cache_get(g, tgt);
	if found {
		out.i = cached_idx;
		return out;
	}
	var pos = -1;
	for i in g.n {
		if g.res[i] == tgt {
			pos = i;
			break;
		}
	}
	gold_cache_put(g, tgt, pos);
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "located target at index ", pos);
	out
}
@end
