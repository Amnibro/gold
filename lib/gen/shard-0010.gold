fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient results for duplicate split");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: not enough items");
		return out;
	}
	var dup_count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			dup_count++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	if dup_count == 0 {
		gold_fail(g, "no adjacent duplicates found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero duplicates present");
	} else {
		out.i = dup_count;
		out.s.clear();
		format(out.s, "safely split ", dup_count, " duplicate pairs");
	}
	out
}
@end
