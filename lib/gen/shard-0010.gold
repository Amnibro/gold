test: list=5,15,25,35,45,55 window_size=3
expect: => i=2 r=0.0 ok=true s="paired 2 windows" errors=0 n=8 res=[5,15,25,35,45,55,15,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = if ${window_size} <= 0 { 2 } else { ${window_size} };
	var pairs_count = 0;
	if g.n >= ws {
		var i = 0;
		while i + ws <= g.n {
			var w_sum = 0;
			var k = 0;
			while k < ws {
				w_sum += g.res[i + k];
				k++;
			}
			let avg = w_sum / ws;
			gold_push(g, avg);
			pairs_count++;
			i += ws;
		}
	}
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "paired ", pairs_count, " windows");
	g.steps += pairs_count + 1;
	out
}
@end
