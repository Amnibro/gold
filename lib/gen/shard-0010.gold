test: list=5,15,25
expect: => i=1 r=0.0 ok=true s="kept 1 items above average" errors=0 n=1 res=[25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.i = 0; return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] > avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " items above average");
	out
}
@end
