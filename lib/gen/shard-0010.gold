expect: => i=6 r=0.0 ok=false s="error: checkpoint 99 missing" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let marker = ${chk};
	let r = ${retries};
	if r <= 0 || g.n == 0 {
		gold_fail(g, "invalid retries or empty results for checkpoint sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid checkpoint sum parameters");
		return out;
	}
	var sum = 0;
	var found = false;
	for i in g.n {
		if g.res[i] == marker {
			found = true;
			break;
		}
		sum += g.res[i];
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	if !found {
		gold_fail(g, "checkpoint not found within attempts");
		out.ok = false;
		format(out.s, "error: checkpoint ", marker, " missing");
	} else {
		format(out.s, "accumulated sum ", sum, " to checkpoint ", marker);
	}
	out
}
@end
