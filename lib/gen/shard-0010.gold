code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let l = ${lo};
	let h = ${hi};
	for i in g.n {
		if g.res[i] < l { g.res[i] = l; }
		if g.res[i] > h { g.res[i] = h; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped sorted checkpoint items");
	out
}
@end
