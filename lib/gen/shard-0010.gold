code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ck = ${cache_key};
	let cval, ok = gold_cache_get(g, ck);
	if ok {
		out.i = cval;
		out.s.clear();
		format(out.s, "loaded cached count: ", cval);
		return out;
	}
	var pos = 0;
	for i in g.n {
		if g.res[i] > 0 { pos++; }
	}
	gold_cache_put(g, ck, pos);
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "cached positive frequency: ", pos);
	out
}
@end
@entry 796da247634b160b
kind: step
verb: group
noun: suffix
modifier: sorted
context: stats
phrase: group suffix sorted statistical elements of size {count}
phrase: sort tail sample observations of length {count}
slot: count int
test: list=10,50,40,30,20 count=3
expect: => i=3 r=0.0 ok=true s="sorted suffix window size: 3" errors=0 n=5 res=[10,50,20,30,40] cache=0 hits=0
test: list=5,9,1,4 count=2
expect: => i=2 r=0.0 ok=true s="sorted suffix window size: 2" errors=0 n=4 res=[5,9,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 1 || g.n < k { return out; }
	let start = g.n - k;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "sorted suffix window size: ", k);
	out
}
@end
