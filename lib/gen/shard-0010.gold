	let mult = ${scale_factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let scaled = avg * mult;
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled average product ", scaled);
	out
}
@end
