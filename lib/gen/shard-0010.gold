kind: step
verb: keep
noun: pairs
modifier: between
context: aggregate
phrase: keep pairs between sum bounds {low} to {high}
phrase: filter pairs between range {low} through {high}
slot: low int
slot: high int
test: list=1,4,2,8,3 low=4 high=7
expect: => i=2 r=0.0 ok=true s="pairs in bounds count 2" errors=0 n=5 res=[1,4,2,8,3] cache=0 hits=0
