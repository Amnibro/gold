@entry d21cb697d5622549
kind: step
verb: fill
noun: limit
modifier: unique
context: transform
phrase: fill limit distinct values up to {limit}
phrase: pad unique list elements reaching limit {limit}
slot: limit int
test: list=3,3,5,5 limit=5
expect: => i=5 r=0.0 ok=true s="filled unique items to limit 5" errors=0 n=5 res=[3,5,6,7,8] cache=0 hits=0
test: list=10,20,10,30 limit=4
expect: => i=4 r=0.0 ok=true s="filled unique items to limit 4" errors=0 n=4 res=[10,20,30,31] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[kept] = x;
			kept++;
		}
	}
	let lim = ${limit};
	var last = 1;
	if kept > 0 { last = temp[kept - 1]; }
	while kept < lim && kept < 500 {
		last++;
		temp[kept] = last;
		kept++;
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filled unique items to limit ", kept);
	out
}
@end
