noun: average
modifier: each
context: core
phrase: swap average each entry differing from mean
phrase: adjust average each item relative to baseline
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="swapped items around average 20" errors=0 n=3 res=[10,20,10] cache=0 hits=0
test: list=2,4
expect: => i=3 r=0.0 ok=true s="swapped items around average 3" errors=0 n=2 res=[2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for i in g.n {
		if g.res[i] > avg {
			g.res[i] = avg - (g.res[i] - avg);
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped items around average ", avg);
	out
}
@end
