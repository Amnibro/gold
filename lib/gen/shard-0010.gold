expect: => i=20 r=0.0 ok=true s="suffix maximums calculated max: 20" errors=0 n=4 res=[20,20,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_max = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
		g.res[i] = cur_max;
		if i == 0 { break; }
		i--;
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "suffix maximums calculated max: ", cur_max);
	out
}
@end
