fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cache_key};
	let val, ok = gold_cache_get(g, k);
	let addend = if ok { val } else { k };
	for i in g.n {
		g.res[i] += addend;
	}
	g.steps += g.n;
	out.i = addend;
	out.s.clear();
	format(out.s, "paired results with cache addend ", addend);
	out
}
