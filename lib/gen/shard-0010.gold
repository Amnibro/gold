noun: results
modifier: last
context: aggregate
phrase: sort last {tail_count} results in ascending order
phrase: arrange trailing {tail_count} elements in sorted order
slot: tail_count int
test: list=1,50,20,10 tail_count=3
expect: => i=3 r=0.0 ok=true s="sorted last 3 items" errors=0 n=4 res=[1,10,20,50] cache=0 hits=0
