phrase: scale last {count} items to scale
slot: count int
test: list=10,20,35,25 count=2
expect: => i=25 r=0.0 ok=true s="normalized last 2 numbers" errors=0 n=4 res=[10,20,10,0] cache=0 hits=0
test: list=5,15,30 count=3
expect: => i=5 r=0.0 ok=true s="normalized last 3 numbers" errors=0 n=3 res=[0,10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 { return out; }
	let start = if g.n > c { g.n - c } else { 0 };
	var min_val = g.res[start];
	for i in (start + 1)..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	for i in start..g.n {
		g.res[i] -= min_val;
	}
	g.steps += g.n - start;
	out.i = min_val;
	out.s.clear();
	format(out.s, "normalized last ", g.n - start, " numbers");
	out
}
@end
