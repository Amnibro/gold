@entry a420eabd11b861bb
kind: step
verb: drop
noun: items
modifier: running
context: format
phrase: format results after dropping {drop_count} running items
phrase: render sequence string dropping {drop_count} running elements
slot: drop_count int
test: list=10,20,30,40 drop_count=2
expect: => i=2 r=0.0 ok=true s="dropped 2 items leaving 2" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15,25 drop_count=1
expect: => i=2 r=0.0 ok=true s="dropped 1 items leaving 2" errors=0 n=2 res=[15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dc = ${drop_count};
	let k = if dc > g.n { g.n } else { dc };
	let remaining = g.n - k;
	for i in remaining {
		g.res[i] = g.res[k + i];
	}
	g.n = remaining;
	g.steps += g.n;
	out.i = remaining;
	out.s.clear();
	format(out.s, "dropped ", k, " items leaving ", remaining);
	out
}
@end
