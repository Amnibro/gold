@entry bcef3c829375ef53
kind: step
verb: trace
noun: gaps
modifier: safely
context: list
phrase: trace gaps safely ceiling {ceiling}
phrase: track gaps safely maximum {ceiling}
slot: ceiling int
test: list=2,5,9,14 ceiling=5
expect: => i=5 r=0.0 ok=true s="trace gaps safely max is 5" errors=0 n=4 res=[2,5,9,14] cache=0 hits=0
test: list=10,30,35 ceiling=10
expect: => i=0 r=0.0 ok=false s="trace gaps safely max is 0" errors=1 n=3 res=[10,30,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var max_gap = 0;
	var safe = true;
	for i in 1..g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff > ceil {
			safe = false;
			break;
		}
		if diff > max_gap {
			max_gap = diff;
		}
	}
	g.steps += g.n;
	out.ok = safe;
	if !safe {
		gold_fail(g, "gap exceeded safe ceiling");
		out.i = 0;
	} else {
		out.i = max_gap;
	}
	out.s.clear();
	format(out.s, "trace gaps safely max is ", out.i);
	out
}
@end
@entry f6a6414a6f006eb4
kind: step
verb: rotate
noun: average
modifier: running
context: list
phrase: rotate average running offset {offset}
phrase: roll average running bias {offset}
slot: offset int
test: list=10,20,30,40 offset=5
expect: => i=2 r=0.0 ok=true s="rotated running average by 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=2,4,6 offset=0
expect: => i=1 r=0.0 ok=true s="rotated running average by 1" errors=0 n=3 res=[6,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	let k = (avg + off) % g.n;
	for step in k {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n * k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated running average by ", k);
	out
}
@end
