code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let k = if b > g.n { g.n } else if b < 0 { 0 } else { b };
	if k > 1 {
		let last = g.res[k - 1];
		var i = k - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated values up to index ", k);
	out
}
@end
