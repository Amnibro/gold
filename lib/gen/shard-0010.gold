			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "split duplicates every other: ", kept, " items");
	out
}
@end
@entry 29e5004e6ca8aa53
kind: step
verb: drop
noun: sequence
modifier: while
context: format
phrase: format sequence after dropping elements while {cond} holds
phrase: render remaining items dropping prefix matching {cond}
slot: cond pred
test: list=2,4,5,6 cond=is_even
expect: => i=2 r=0.0 ok=true s="dropped while matching: 2 remaining" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=1,3,6,7 cond=is_odd
expect: => i=2 r=0.0 ok=true s="dropped while matching: 2 remaining" errors=0 n=2 res=[6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n && ${cond}(g.res[idx]) {
		idx++;
	}
	let remaining = g.n - idx;
	for i in remaining {
		g.res[i] = g.res[idx + i];
	}
	g.n = remaining;
	g.steps += remaining;
	out.i = remaining;
	out.s.clear();
	format(out.s, "dropped while matching: ", remaining, " remaining");
	out
}
@end
@entry 6cd902d2aa5ae27b
kind: step
verb: shift
noun: total
modifier: times
context: format
phrase: format total sum shifted by {shift_amount}
phrase: render sequence total adjusted by offset {shift_amount}
slot: shift_amount int
test: list=10,20,30 shift_amount=5
expect: => i=65 r=0.0 ok=true s="shifted total by 5: 65" errors=0 n=3 res=[10,20,30] cache=0 hits=0
