code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let check_len = if ml > g.n { g.n } else { ml };
	var is_sorted = true;
	for i in 1..check_len {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
	}
	g.steps += check_len;
	out.ok = is_sorted;
	out.i = check_len;
	out.s.clear();
	format(out.s, "results sorted verification: ", is_sorted);
	out
}
@end
