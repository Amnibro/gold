expect: => i=15 r=0.0 ok=true s="folded unique values to sum 15" errors=0 n=7 res=[1,2,2,3,4,4,5] cache=0 hits=0
test: list=10,20,10,30
expect: => i=60 r=0.0 ok=true s="folded unique values to sum 60" errors=0 n=4 res=[10,20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var seen_buf int[512] = [0; 512];
	var seen_count = 0;
	for i in g.n {
		var seen = false;
		for j in seen_count {
			if seen_buf[j] == g.res[i] { seen = true; break; }
		}
		if !seen {
			seen_buf[seen_count] = g.res[i];
			seen_count++;
			sum += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded unique values to sum ", sum);
	out
}
@end
