kind: step
verb: pair
noun: counter
modifier: sorted
context: stats
phrase: build sorted frequency counter pairs from sample
phrase: group observations into sorted count pairs
phrase: tally sample values into paired sorted counters
test: list=5,2,5,3,2,5
expect: => i=3 r=0.0 ok=true s="distinct classes 3" errors=0 n=9 res=[2,2,3,5,5,5,202,301,503] cache=0 hits=0
test: list=10,20,10,30,20
expect: => i=3 r=0.0 ok=true s="distinct classes 3" errors=0 n=8 res=[10,10,20,20,30,1002,2002,3001] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let orig_n = g.n;
	var distinct = 0;
	var idx = 0;
	while idx < orig_n {
		let val = g.res[idx];
		var run = 0;
		while idx < orig_n && g.res[idx] == val {
			run++;
			idx++;
		}
		gold_push(g, val * 100 + run);
		distinct++;
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "distinct classes ", distinct);
	g.steps += g.n + distinct + 1;
	out
}
@end
