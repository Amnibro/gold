@entry 012f9b46f6730099
kind: step
verb: sort
noun: prefix
modifier: unique
context: stats
phrase: sort prefix unique span {span}
phrase: order prefix unique window {span}
slot: span int
test: list=30,10,30,20,40 span=4
expect: => i=4 r=0.0 ok=true s="unique prefix sorted count 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,2 span=3
expect: => i=2 r=0.0 ok=true s="unique prefix sorted count 2" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var k = sp;
	if k > g.n { k = g.n; }
	for i in k {
		for j in (i + 1)..k {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var w = 0;
	for i in k {
		if i == 0 || g.res[i] != g.res[i - 1] {
			g.res[w] = g.res[i];
			w++;
		}
	}
	for i in k..g.n {
		g.res[w] = g.res[i];
		w++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "unique prefix sorted count ", w);
	out
}
@end
