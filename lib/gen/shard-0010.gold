		return out;
	}
	if out.s.len > ml {
		out.s.resize(ml, ' ');
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out.s.clear();
	format(out.s, "limited text length to ", out.i);
	out
}
@end
@entry 926b5ae81ff26f61
kind: step
