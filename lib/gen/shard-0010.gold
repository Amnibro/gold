context: loop
slot: max_times int
phrase: limit cache times repeating loop up to {max_times}
phrase: restrict cache lookup times bounded by {max_times}
test: list=10,20,30 max_times=2
expect: => i=2 r=0.0 ok=true s="queried cache 2 times in loop" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10 max_times=-1
expect: => i=0 r=0.0 ok=false s="error: invalid cache times limit -1" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${max_times};
	if mt <= 0 || g.n == 0 {
		gold_fail(g, "invalid loop cache times limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid cache times limit ", mt);
		return out;
	}
	var queried = 0;
	for i in g.n {
		if queried >= mt { break; }
		let val, ok = gold_cache_get(g, i);
		queried++;
	}
	g.steps += queried;
	out.i = queried;
	out.s.clear();
	format(out.s, "queried cache ", queried, " times in loop");
	out
}
@end
@entry 263066ab180bd547
kind: step
verb: drop
noun: evens
modifier: all
context: loop
phrase: drop evens all occurrences throughout loop
phrase: remove all even values across loop sequence
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="dropped all 3 evens throughout loop" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=2,4,6
expect: => i=3 r=0.0 ok=false s="dropped all 3 evens leaving none" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for drop evens all");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var dropped = 0;
	var write_idx = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			dropped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.s.clear();
	if g.n == 0 {
		gold_fail(g, "all values dropped");
		out.ok = false;
		format(out.s, "dropped all ", dropped, " evens leaving none");
	} else {
		format(out.s, "dropped all ", dropped, " evens throughout loop");
	}
	out
}
@end
@entry 8ac136fd9c9de608
kind: step
verb: compare
noun: value
modifier: none
context: loop
slot: target int
phrase: compare value none of elements equal to {target}
phrase: verify none of loop items match value {target}
test: list=1,3,5 target=2
expect: => i=0 r=0.0 ok=true s="verified none equal to 2" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=1,2,3 target=2
expect: => i=1 r=0.0 ok=false s="error: found 1 instances of 2" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty results for compare value none");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var match_count = 0;
	for i in g.n {
		if g.res[i] == tgt { match_count++; }
	}
	g.steps += g.n;
	let none_matched = match_count == 0;
	out.ok = none_matched;
	out.i = match_count;
	out.s.clear();
	if none_matched {
		format(out.s, "verified none equal to ", tgt);
	} else {
		gold_fail(g, "matching value found");
		out.ok = false;
		format(out.s, "error: found ", match_count, " instances of ", tgt);
	}
	out
}
@end
