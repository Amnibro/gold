@entry 60ca0593155c49b4
kind: step
verb: repeat
noun: number
modifier: until
context: aggregate
phrase: repeat sequence numbers until reaching sum {target}
phrase: duplicate elements until total accumulates to {target}
slot: target int
test: list=2,3 target=10
expect: => i=10 r=0.0 ok=true s="repeated numbers until sum reached 10" errors=0 n=4 res=[2,3,2,3] cache=0 hits=0
test: list=5,10 target=25
expect: => i=30 r=0.0 ok=true s="repeated numbers until sum reached 30" errors=0 n=4 res=[5,10,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var idx = 0;
	while sum < tgt && g.n < 500 {
		let next_val = g.res[idx];
		g.res[g.n] = next_val;
		g.n++;
		sum += next_val;
		idx++;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "repeated numbers until sum reached ", sum);
	out
}
@end
