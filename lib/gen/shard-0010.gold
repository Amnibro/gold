fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	var seen int[64] = [0; 64];
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in distinct {
			if seen[j] == x { exists = true; }
		}
		if !exists && distinct < 64 {
			seen[distinct] = x;
			distinct++;
		}
	}
	out.i = distinct;
	out.s.clear();
	format(out.s, "unique count=", distinct);
	out
}
