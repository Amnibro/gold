code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${thresh};
	if th <= 0 || g.n >= 500 {
		gold_fail(g, "invalid threshold for recursive fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid fill threshold ", th);
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var added = 0;
	while sum < th && g.n < 500 && added < 20 {
		let nxt = if g.n > 0 { g.res[g.n - 1] + 1 } else { 1 };
		gold_push(g, nxt);
		sum += nxt;
		added++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "recursively filled ", added, " items");
	out
}
@end
