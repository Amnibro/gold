slot: count int
test: list=1,2,3,4,5 count=2
expect: => i=2 r=0.0 ok=true s="kept 2 tail items in place" errors=0 n=2 res=[4,5] cache=0 hits=0
test: list=10,20,30 count=1
expect: => i=1 r=0.0 ok=true s="kept 1 tail items in place" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative count");
		out.ok = false;
		return out;
	}
	let keep = if k > g.n { g.n } else { k };
	let start = g.n - keep;
	for i in keep {
		g.res[i] = g.res[start + i];
	}
	g.n = keep;
	g.steps += keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "kept ", keep, " tail items in place");
	out
}
@end
