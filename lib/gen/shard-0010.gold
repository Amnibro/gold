@entry 8043bdec23c0248e
kind: step
verb: dedupe
noun: evens
modifier: in_place
context: list
phrase: dedupe evens in_place threshold {threshold}
phrase: filter evens in_place bound {threshold}
slot: threshold int
test: list=2,4,2,6,4,8 threshold=10
expect: => i=2 r=0.0 ok=true s="deduped in place removed 2" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,5 threshold=10
expect: => i=0 r=0.0 ok=true s="deduped in place removed 0" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var w = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		var is_dup_even = false;
		if x % 2 == 0 && x <= th {
			for j in w {
				if g.res[j] == x {
					is_dup_even = true;
					break;
				}
			}
		}
		if is_dup_even {
			removed++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped in place removed ", removed);
	out
}
@end
