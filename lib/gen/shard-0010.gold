@entry de9599c6211c958b
kind: step
verb: rotate
noun: total
modifier: between
context: list
phrase: rotate total between lower {lower} upper {upper}
phrase: roll total between min {lower} max {upper}
slot: lower int
slot: upper int
test: list=1,2,3,4,5 lower=1 upper=3
expect: => i=9 r=0.0 ok=true s="rotated total subrange with sum 9" errors=0 n=5 res=[1,4,2,3,5] cache=0 hits=0
test: list=10,20,30,40 lower=0 upper=2
expect: => i=60 r=0.0 ok=true s="rotated total subrange with sum 60" errors=0 n=4 res=[30,10,20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	if lo < 0 || hi >= g.n || lo >= hi {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in lo..(hi + 1) {
		sum += g.res[i];
	}
	let last = g.res[hi];
	var i = hi;
	while i > lo {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[lo] = last;
	g.steps += (hi - lo + 1);
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated total subrange with sum ", sum);
	out
}
@end
