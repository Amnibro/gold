fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n < 2 { return out; }
	var matches = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff <= lim && diff >= 0 { matches++; }
	}
	gold_push(g, matches);
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "found ", matches, " space gaps up to limit");
	out
}
@end
