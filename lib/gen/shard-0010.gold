code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_non_space = out.s.len;
	for i in out.s.len {
		if out.s[i] != ' ' {
			first_non_space = i;
			break;
		}
	}
	var trimmed byte[..200] = [];
	for i in first_non_space..out.s.len {
		trimmed.push(out.s[i]);
	}
	out.s.clear();
	for i in trimmed.len { out.s.push(trimmed[i]); }
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
