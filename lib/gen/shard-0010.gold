@entry 44e4f6d21605c462
kind: step
verb: group
noun: total
modifier: safely
context: retry
slot: chunk_sz int
phrase: group total safely in chunks of {chunk_sz}
phrase: aggregate running totals safely in size {chunk_sz} groups
test: list=1,2,3,4 chunk_sz=2
expect: => i=2 r=0.0 ok=true s="computed 2 chunk totals safely" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,2 chunk_sz=-1
expect: => i=0 r=0.0 ok=false s="error: invalid chunk size for total" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_sz};
	if sz <= 0 || g.n == 0 {
		gold_fail(g, "invalid chunk size or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid chunk size for total");
		return out;
	}
	var write_idx = 0;
	var i = 0;
	while i + sz <= g.n {
		var chunk_sum = 0;
		for k in sz {
			chunk_sum += g.res[i + k];
		}
		g.res[write_idx] = chunk_sum;
		write_idx++;
		i += sz;
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "computed ", write_idx, " chunk totals safely");
	out
}
@end
