code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
		i++;
	}
	out.i = primes;
	out.s.clear();
	format(out.s, "primes measured: ", primes);
	g.steps += g.n;
	out
}
@end
