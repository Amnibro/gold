kind: step
verb: swap
noun: tally
modifier: with_retry
context: list
phrase: swap inverted signs with retry bound {retries}
phrase: reorder positive negative tally using up to {retries} retries
phrase: balance tally order with retry limit {retries}
slot: retries int
test: list=-1,2,-3,4,5 retries=2
expect: => i=5 r=0.0 ok=true s="performed 5 tally adjustment swaps" errors=0 n=5 res=[2,4,5,-1,-3] cache=0 hits=0
test: list=-5,-2,10,20 retries=1
expect: => i=2 r=0.0 ok=true s="performed 2 tally adjustment swaps" errors=0 n=4 res=[-5,10,20,-2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var swaps = 0;
	var attempts = 0;
	while attempts < r && swaps < g.n - 1 {
		var did_swap = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] < 0 && g.res[i + 1] > 0 {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps += 1;
				did_swap = true;
			}
			i += 1;
		}
		attempts += 1;
		if !did_swap { break; }
	}
	g.steps += attempts;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " tally adjustment swaps");
	out
}
@end
