expect: => i=2 r=0.0 ok=true s="performed 2 pairwise conditional swaps" errors=0 n=4 res=[5,15,10,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			if ${p}(g.res[i]) && g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed ", swaps, " pairwise conditional swaps");
	out
}
@end
