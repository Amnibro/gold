code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var is_sorted = true;
	for i in g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
		}
	}
	if !is_sorted {
		gold_fail(g, "suffix unsorted error");
		out.ok = false;
	} else {
		while g.n < lim {
			let last = if g.n > 0 { g.res[g.n - 1] } else { 0 };
			gold_push(g, last + 1);
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
@entry bff541327e4eb26a
