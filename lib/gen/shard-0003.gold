fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = v.i;
	var gaps int[64] = [0; 64];
	var n_g = 0;
	var p = 0;
	while p + 1 < g.n {
		let diff = g.res[p + 1] - g.res[p];
		if diff <= bound {
			if n_g < 64 { gaps[n_g] = diff; n_g++; }
		}
		p++;
	}
	for i in n_g {
		var j = i + 1;
		while j < n_g {
			if gaps[i] > gaps[j] {
				let t = gaps[i];
				gaps[i] = gaps[j];
				gaps[j] = t;
			}
			j++;
		}
	}
	gold_clear(g);
	for k in n_g { gold_push(g, gaps[k]); }
	out.i = n_g;
	g.steps += n_g;
	out.s.clear();
	format(out.s, "ranked bounded gaps ", n_g);
	out
}
@end
