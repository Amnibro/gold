fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_indices int[512] = [0; 512];
	var en = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			even_indices[en] = k;
			en++;
		}
	}
	var i = 0;
	var j = en - 1;
	while i < j {
		let p1 = even_indices[i];
		let p2 = even_indices[j];
		let tmp = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = tmp;
		i++;
		j--;
	}
	out.i = en;
	g.steps += g.n;
	out
}
@end
