	let lo = ${min_bound};
	let hi = ${max_bound};
	var filtered int[512] = [0; 512];
	var fil_n = 0;
	var min_sel = 999999;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
