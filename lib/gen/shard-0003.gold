@entry 0134969cd500ed9e
kind: step
verb: trace
noun: runs
modifier: at_least
context: cache
phrase: trace consecutive duplicate runs of length at least {min_len}
phrase: record runs reaching at least length {min_len} in cache
slot: min_len int
test: list=2,2,2,3,4,4,4 min_len=3
expect: => i=2 r=0.0 ok=true s="traced 2 long runs" errors=0 n=7 res=[2,2,2,3,4,4,4] cache=2 hits=0
test: list=5,5,6,6,6,6 min_len=4
expect: => i=1 r=0.0 ok=true s="traced 1 long runs" errors=0 n=6 res=[5,5,6,6,6,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_len};
	var runs_found = 0;
	if g.n >= req {
		var i = 0;
		while i < g.n {
			let val = g.res[i];
			var run_len = 0;
			while i + run_len < g.n && g.res[i + run_len] == val {
				run_len++;
			}
			if run_len >= req {
				gold_cache_put(g, val, run_len);
				runs_found++;
			}
			i += run_len;
		}
	}
	g.steps += g.n;
	out.i = runs_found;
	out.s.clear();
	format(out.s, "traced ", runs_found, " long runs");
	out
}
@end
