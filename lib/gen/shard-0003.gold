@entry e1e1e18b98fde1a8
kind: step
verb: retry
noun: limit
modifier: last
context: cache
phrase: retry limit lookup on last cache entry {limit}
phrase: query last cache entry within retry limit {limit}
slot: limit int
test: list=7,8,9 limit=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[7,8,9] cache=3 hits=1
test: list=11,22 limit=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[11,22] cache=2 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		gold_cache_put(g, g.res[i], i);
	}
	if g.cn == 0 {
		out.ok = false;
		return out;
	}
	let last_k = g.ck[g.cn - 1];
	var attempts = 0;
	var found = false;
	while attempts < lim {
		let _, ok = gold_cache_get(g, last_k);
		if ok {
			found = true;
			break;
		}
		attempts++;
	}
	out.ok = found;
	out.i = g.hits;
	g.steps += g.n;
	out
}
@end
