fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var d int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	var drops = 0;
	for i in len {
		let curr = d[len - 1 - i];
		let nxt = d[len - 1 - ((i + 1) % len)];
		if curr > nxt { drops++; }
	}
	drops <= 1
}
@end
@entry 611808421d32a63d
kind: step
verb: clamp
noun: values
modifier: at_least
context: cache
phrase: clamp cached values to at least {min_val}
phrase: bound cache values from below by {min_val}
slot: min_val int
test: list=1,5,10 min_val=5
expect: => i=3 r=0.0 ok=true s="clamped 3 cache values" errors=0 n=3 res=[1,5,10] cache=3 hits=0
test: list=20,30,40 min_val=25
expect: => i=3 r=0.0 ok=true s="clamped 3 cache values" errors=0 n=3 res=[20,30,40] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${min_val};
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] < floor {
			g.cv[i] = floor;
			clamped++;
		}
	}
	for i in g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if ok && val < floor {
			gold_cache_put(g, x, floor);
		} else if !ok {
			let new_val = if x < floor { floor } else { x };
			gold_cache_put(g, x, new_val);
			clamped++;
		}
	}
	g.steps += g.n + g.cn;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " cache values");
	out
}
@end
