code:
fn ${ID}_is_p(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var modified = 0;
	for k in g.n {
		if ${ID}_is_p(g.res[k]) {
			g.res[k] *= m;
			modified++;
		}
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "scaled ", modified, " prime retry codes");
	g.steps += g.n;
	out
}
@end
