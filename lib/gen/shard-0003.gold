expect: => i=20 r=0.0 ok=true s="reverse alternating tally: 20" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < g.n { lim } else { g.n };
	var tally = 0;
	var sign = 1;
	var i = 0;
	while i < count {
		let idx = g.n - 1 - i;
		tally += sign * g.res[idx];
		sign = -sign;
		i += 1;
	}
	g.steps += count;
	out.i = tally;
	out.s.clear();
	format(out.s, "reverse alternating tally: ", tally);
	out
}
@end
