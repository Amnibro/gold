expect: => i=0 r=0.0 ok=true s="swapped search violator at index 0" errors=0 n=3 res=[6,4,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	var idx = -1;
	var i = 0;
	while i < g.n && idx < 0 {
		if g.res[i] > limit {
			idx = i;
		}
		i += 1;
	}
	if idx >= 0 && g.n > 0 {
		let tmp = g.res[idx];
		g.res[idx] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += i;
	out.i = idx;
	out.s.clear();
	format(out.s, "swapped search violator at index ", idx);
	out
}
@end
