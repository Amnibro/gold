@entry 3567b63fa5cf98e0
kind: step
verb: group
noun: histogram
modifier: between
context: aggregate
phrase: count frequencies falling between {lo} to {hi}
phrase: aggregate histogram counts between {lo} with {hi}
phrase: tally frequency bins within bounds {lo} to {hi}
slot: lo int
slot: hi int
test: list=1,1,2,2,2,3,4,4,4,4 lo=2 hi=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=10 res=[1,1,2,2,2,3,4,4,4,4] cache=0 hits=0
test: list=5,5,5,6,6,7 lo=1 hi=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=6 res=[5,5,5,6,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var counts int[64] = [0; 64];
	var distinct int[64] = [0; 64];
	var nd = 0;
	for i in g.n {
		let val = g.res[i];
		var found = -1;
		for j in nd {
			if distinct[j] == val {
				found = j;
				break;
			}
		}
		if found >= 0 {
			counts[found]++;
		} else if nd < 64 {
			distinct[nd] = val;
			counts[nd] = 1;
			nd++;
		}
	}
	var matched = 0;
	for j in nd {
		if counts[j] >= l && counts[j] <= h {
			matched++;
		}
	}
	out.i = matched;
	out
}
@end
