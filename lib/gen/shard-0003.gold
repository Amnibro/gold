@entry f25888a1611926c3
kind: step
verb: dedupe
noun: runs
modifier: up_to
context: list
phrase: dedupe contiguous runs up to limit {cap}
phrase: compress identical runs up to bound {cap}
slot: cap int
test: list=1,1,1,2,2,3 cap=2
expect: => i=1 r=0.0 ok=true s="deduped runs removed 1 elements" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5,6,7,7 cap=1
expect: => i=4 r=0.0 ok=true s="deduped runs removed 4 elements" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_cnt = 0;
		while i < g.n && g.res[i] == val {
			if run_cnt < limit {
				g.res[kept] = val;
				kept++;
			}
			run_cnt++;
			i++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n * 2;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped runs removed ", removed, " elements");
	out
}
@end
