	var min_diff = 999999;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff < min_diff { min_diff = diff; }
		i++;
	}
	gold_cache_put(g, r, min_diff);
	out.i = min_diff;
	g.steps += g.n;
	out
}
@end
