code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_len = 1;
	while run_len < g.n && g.res[run_len] <= g.res[run_len - 1] {
		run_len++;
	}
	for x in run_len {
		var y = 0;
		while y + 1 < run_len - x {
			if g.res[y] > g.res[y + 1] {
				let t = g.res[y];
				g.res[y] = g.res[y + 1];
				g.res[y + 1] = t;
			}
			y++;
		}
	}
	out.i = run_len;
	g.steps += run_len;
	out.s.clear();
	format(out.s, "sorted first run of length ", run_len);
	out
}
@end
