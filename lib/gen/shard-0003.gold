code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${min_len};
	if g.n < k {
		out.i = 0;
		return out;
	}
	let start = g.n - k;
	var kept int[64] = [0; 64];
	for i in k { kept[i] = g.res[start + i]; }
	gold_clear(g);
	for i in k { gold_push(g, kept[i]); }
	out.i = k;
	out
}
@end
