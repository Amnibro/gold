code:
fn ${ID}(g Gold&, v Val) Val {
	let count = ${k};
	var out = v;
	var limit = if count > g.n { g.n } else { count };
	var i = 0;
	var j = limit - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
		j--;
	}
	out.i = limit;
	g.steps += limit;
	out
}
@end
