kind: step
verb: keep
noun: vowels
modifier: times
context: list
phrase: keep vowel character codes repeating each {times} times
phrase: retain vowel entries replicating values {times} iterations
phrase: filter vowel items duplicating each {times} occurrences
slot: times int
test: list=65,66,69 times=2
expect: => i=4 r=0.0 ok=true s="kept 2 vowels repeated 2 times" errors=0 n=4 res=[65,69,65,69] cache=0 hits=0
test: list=97,98,101 times=3
expect: => i=6 r=0.0 ok=true s="kept 2 vowels repeated 3 times" errors=0 n=6 res=[97,101,97,101,97,101] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var temp: int[64] = [0; 64];
	var vowel_count = 0;
	for i in g.n {
		let c = g.res[i];
		if ${ID}_is_vowel(c) && vowel_count < 64 {
			temp[vowel_count] = c;
			vowel_count += 1;
		}
	}
	gold_clear(g);
	for round in t {
		for k in vowel_count {
			gold_push(g, temp[k]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", vowel_count, " vowels repeated ", t, " times");
	out
}

fn ${ID}_is_vowel(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
@end
