fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "loop limit non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid loop limit");
		return out;
	}
	let count = if lim < g.n { lim } else { g.n };
	var run_sum = 0;
	for i in count {
		run_sum += g.res[i];
		g.res[i] = run_sum;
	}
	g.n = count;
	g.steps += count;
	out.i = run_sum;
	out.s.clear();
	format(out.s, "running sum is ", run_sum);
	out
}
