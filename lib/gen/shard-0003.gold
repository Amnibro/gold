				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "sequence cached");
	out
}
@end
