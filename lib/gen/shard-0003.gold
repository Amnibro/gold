fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_idx = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
		i++;
	}
	var l = 0;
	var r = max_idx;
	while l < r {
		let t = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = t;
		l++;
		r--;
	}
	out.i = max_idx;
	g.steps += max_idx;
	out
}
@end
