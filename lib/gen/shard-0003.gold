code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var inversions = 0;
	var i = lo;
	while i <= hi && i < g.n {
		var j = i + 1;
		while j <= hi && j < g.n {
			if g.res[i] > g.res[j] { inversions++; }
			j++;
		}
		i++;
	}
	out.i = inversions;
	g.steps += g.n;
	out
}
@end
