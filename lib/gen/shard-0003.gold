	}
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "normalized to ", kept, " unique values");
	out
}
@end
