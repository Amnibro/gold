code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[..200] = "";
	var spaces = 0;
	var last_was_space = false;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			spaces++;
			if !last_was_space && buf.len < 200 {
				buf.push(' ');
				last_was_space = true;
			}
		} else {
			if buf.len < 200 { buf.push(b); }
			last_was_space = false;
		}
	}
	out.s.clear();
	for i in buf.len { out.s.push(buf[i]); }
	out.i = spaces;
	g.steps += out.s.len;
	out
}
@end
