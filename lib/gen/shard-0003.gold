fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${count};
	let tail_len = if cnt < g.n { cnt } else { g.n };
	let start = g.n - tail_len;
	if tail_len > 1 {
		var l = start;
		var r = g.n - 1;
		while l < r {
			let tmp = g.res[l];
			g.res[l] = g.res[r];
			g.res[r] = tmp;
			l += 1;
			r -= 1;
		}
	}
	for k in tail_len {
		gold_cache_put(g, k, g.res[start + k]);
	}
	g.steps += tail_len;
	out.i = tail_len;
	out.s.clear();
	format(out.s, "reversed tail of ", tail_len, " items with cache");
	out
}
@end
@entry dd2fa20505df4e78
kind: step
verb: merge
noun: vowels
modifier: running
context: list
phrase: merge running vowel codes capped at {cap}
phrase: combine contiguous vowel characters under cap {cap}
phrase: sum running vowel sequences with ceiling {cap}
slot: cap int
test: list=65,69,88,79,85 cap=200
expect: => i=2 r=0.0 ok=true s="merged 2 running vowel sequences" errors=0 n=3 res=[134,88,164] cache=0 hits=0
test: list=97,101,105,98 cap=250
expect: => i=1 r=0.0 ok=true s="merged 1 running vowel sequences" errors=0 n=2 res=[250,98] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_v = ${cap};
	var w = 0;
	var running = 0;
	var in_run = false;
	var merged = 0;
	for i in g.n {
		let c = g.res[i];
		let is_v = ${ID}_is_vowel(c);
		if is_v {
			running += c;
			if running > max_v { running = max_v; }
			in_run = true;
		} else {
			if in_run {
				g.res[w] = running;
				w += 1;
				merged += 1;
				running = 0;
				in_run = false;
			}
			g.res[w] = c;
			w += 1;
		}
	}
	if in_run {
		g.res[w] = running;
		w += 1;
		merged += 1;
	}
	g.n = w;
	g.steps += g.n;
	out.i = merged;
	out.s.clear();
	format(out.s, "merged ", merged, " running vowel sequences");
	out
}

fn ${ID}_is_vowel(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
@end
