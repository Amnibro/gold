expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=-3,5,5,-1,6
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq_count = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		if val > 0 {
			var seen = false;
			var j = 0;
			while j < uniq_count {
				if g.res[j] == val { seen = true; break; }
				j++;
			}
			if !seen {
				g.res[uniq_count] = val;
				uniq_count++;
			}
		}
		i++;
	}
	g.n = uniq_count;
	out.i = uniq_count;
	g.steps += g.n;
	out
}
@end
@entry 5e52540e47e3cb3c
kind: step
verb: map
noun: window
modifier: each
context: math
phrase: map each element to window average sum
phrase: compute local window sum for each entry
test: list=1,2,3,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[3,6,9,7] cache=0 hits=0
test: list=5,10,15
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[15,30,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var win_buf int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		if i > 0 { sum += g.res[i - 1]; }
		if i + 1 < g.n { sum += g.res[i + 1]; }
		win_buf[i] = sum;
		i++;
	}
	var k = 0;
	while k < g.n {
		g.res[k] = win_buf[k];
		k++;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
