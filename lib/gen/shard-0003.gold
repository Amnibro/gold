@entry 652990f1ad66bad3
kind: step
verb: filter
noun: limit
modifier: nested
context: cache
phrase: cache nested pair products below limit {limit}
phrase: record pairs under threshold {limit} in memo store
slot: limit int
test: list=2,3,5 limit=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[2,3,5] cache=1 hits=0
test: list=4,6 limit=30
expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[4,6] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_lim = ${limit};
	var valid_pairs = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			let prod = g.res[i] * g.res[j];
			if prod < max_lim {
				gold_cache_put(g, valid_pairs, prod);
				valid_pairs++;
			}
			j++;
		}
		i++;
	}
	out.i = valid_pairs;
	g.steps += g.n * g.n;
	out
}
@end
