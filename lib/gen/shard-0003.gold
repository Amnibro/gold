@entry 22e0dbba444aa78c
kind: step
verb: swap
noun: errors
modifier: safely
context: search
phrase: swap search outlier errors safely to tail
phrase: reorder items exceeding {thresh} safely to end
slot: thresh int
test: list=50,10,60,20 thresh=40
expect: => i=1 r=0.0 ok=true s="safely moved 1 outlier errors to tail" errors=0 n=4 res=[20,10,60,50] cache=0 hits=0
test: list=100,5,10,15 thresh=50
expect: => i=1 r=0.0 ok=true s="safely moved 1 outlier errors to tail" errors=0 n=4 res=[15,5,10,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var left = 0;
	var right = g.n - 1;
	var moved = 0;
	while left < right {
		while left < right && g.res[left] <= limit {
			left++;
		}
		while left < right && g.res[right] > limit {
			right--;
		}
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			moved++;
			left++;
			right--;
		}
	}
	g.steps += g.n;
	out.i = moved;
	out.s.clear();
	format(out.s, "safely moved ", moved, " outlier errors to tail");
	out
}
@end
