test: list=10,5,20 f=inc
expect: => i=3 r=0.0 ok=true s="sorted mapping" errors=0 n=3 res=[6,11,21] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	// Bubble sort
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "sorted mapping");
	out
}
@end
