fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${times};
	if f <= 0 {
		gold_fail(g, "non-positive repeat times");
		out.ok = false;
		out.i = 0;
		return out;
	}
	out.i = g.n * f;
	g.steps += g.n;
	out
}
