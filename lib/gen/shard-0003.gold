fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	let mid = g.res[g.n / 2];
	out.ok = (mid > avg);
	out.i = mid;
	g.steps += g.n;
	out
}
