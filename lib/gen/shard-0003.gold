@entry a1c4e1b3dd2e293b
kind: step
verb: drop
noun: gaps
modifier: at_most
context: stats
phrase: drop small gaps at most {threshold}
phrase: filter interval gaps at most {threshold}
slot: threshold int
test: list=10,12,25,27,50 threshold=3
expect: => i=2 r=0.0 ok=true s="filtered gaps" errors=0 n=3 res=[10,25,50] cache=0 hits=0
test: list=1,2,10,12,20 threshold=2
expect: => i=2 r=0.0 ok=true s="filtered gaps" errors=0 n=3 res=[1,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		return out;
	}
	var kept = 1;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		if gap > th {
			g.res[kept] = g.res[i + 1];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += kept;
	out.i = dropped;
	gold_text(out, "filtered gaps");
	out
}
@end
@entry fc77758c4c95588b
