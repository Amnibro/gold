kind: step
verb: drop
noun: tally
modifier: while
context: error
phrase: drop tally while {cond} satisfies
phrase: decrement tally sequence while {cond} holds
slot: cond pred
test: list=2,4,7,8 cond=is_even
expect: => i=2 r=0.0 ok=true s="dropped 2 tally items" errors=0 n=2 res=[7,8] cache=0 hits=0
test: list=1,3,5 cond=is_even
expect: => i=0 r=0.0 ok=false s="error: initial condition failed" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "tally results are empty");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty tally");
		return out;
	}
	var dropped = 0;
	while dropped < g.n {
		if !${cond}(g.res[dropped]) {
			break;
		}
		dropped++;
	}
	if dropped == 0 {
		gold_fail(g, "first tally item failed condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: initial condition failed");
		return out;
	}
	var kept = 0;
	for i in dropped..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " tally items");
	out
}
@end
