fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
		}
		i += 2;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "pairwise condition sorted");
	g.steps += g.n;
	out
}
