phrase: count primes within sorted results
test: list=9,4,2,7,11
expect: => i=3 r=0.0 ok=true s="primes counted" errors=0 n=5 res=[2,4,7,9,11] cache=0 hits=0
test: list=15,10,3,5
expect: => i=2 r=0.0 ok=true s="primes counted" errors=0 n=4 res=[3,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { prime_count++; }
	}
	g.steps += g.n;
	out.i = prime_count;
	gold_text(out, "primes counted");
	out
}
@end
