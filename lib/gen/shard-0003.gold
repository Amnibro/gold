noun: history
modifier: between
context: sort
phrase: measure sorting swap history between indices {low} to {high}
phrase: count inversions in sort history between positions {low} to {high}
slot: low int
slot: high int
test: list=9,3,7,1,5 low=0 high=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[9,3,7,1,5] cache=0 hits=0
