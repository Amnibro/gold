fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var avgs int[512] = [0; 512];
	var an = 0;
	var k = 0;
	while k + 1 < g.n {
		let avg = (g.res[k] + g.res[k + 1]) / 2;
		var found = false;
		for j in an {
			if avgs[j] == avg { found = true; break; }
		}
		if !found {
			avgs[an] = avg;
			an++;
		}
		k++;
	}
	gold_clear(g);
	for j in an { gold_push(g, avgs[j]); }
	out.i = an;
	g.steps += g.n;
	out
}
@end
