			if alt[n] > alt[n + 1] {
				let tmp = alt[n];
				alt[n] = alt[n + 1];
				alt[n + 1] = tmp;
			}
		}
	}
	var k = 0;
	var j = 0;
	while k < out.s.len {
		out.s[k] = alt[j];
		j++;
		k += 2;
	}
	out.i = alt.len;
	g.steps += out.s.len;
	out
}
@end
@entry d10a9b60cca83098
kind: step
verb: pair
noun: range
modifier: unique
context: sort
phrase: pair unique sorted values within range span {span}
phrase: group unique sorted elements within range window {span}
slot: span int
test: list=4,2,2,7,1,4 span=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,4,7] cache=0 hits=0
test: list=5,1,1,9,5 span=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[1,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var write_idx = 0;
	var k = 0;
	while k < g.n {
		if write_idx == 0 || g.res[k] != g.res[write_idx - 1] {
			g.res[write_idx] = g.res[k];
			write_idx++;
		}
		k++;
	}
	g.n = write_idx;
	var pairs = 0;
	var p = 0;
	while p + 1 < g.n {
		if g.res[p + 1] - g.res[p] <= sp { pairs++; }
		p++;
	}
	out.i = pairs;
	g.steps += g.n;
	out
}
@end
