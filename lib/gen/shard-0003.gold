fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var evens = 0;
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens++; }
		else { odds++; }
	}
	let ok = odds <= retries;
	out.ok = ok;
	out.i = evens;
	out.s.clear();
	format(out.s, "evens trace ", evens);
	g.steps += g.n;
	out
}
@end
