@entry 2d9f0553ebe278e7
kind: step
verb: find
noun: middle
modifier: every_other
context: search
phrase: find middle element among alternating search items
phrase: locate median of every other observation in search
test: list=10,50,20,80,30
expect: => i=20 r=0.0 ok=true s="found alternating middle element 20" errors=0 n=5 res=[10,50,20,80,30] cache=0 hits=0
test: list=5,90,15,40,25,70,35
expect: => i=25 r=0.0 ok=true s="found alternating middle element 25" errors=0 n=7 res=[5,90,15,40,25,70,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[512] = [0; 512];
	var an = 0;
	var k = 0;
	while k < g.n {
		alt[an] = g.res[k];
		an++;
		k += 2;
	}
	if an >= 2 {
		for i in an {
			for j in an - 1 {
				if alt[j] > alt[j + 1] {
					let tmp = alt[j];
					alt[j] = alt[j + 1];
					alt[j + 1] = tmp;
				}
			}
		}
	}
	let mid_val = if an > 0 { alt[an / 2] } else { 0 };
	g.steps += g.n + an * an;
	out.i = mid_val;
	out.s.clear();
	format(out.s, "found alternating middle element ", mid_val);
	out
}
@end
@entry 1af9f9402b5d3fa8
kind: step
verb: swap
noun: list
modifier: up_to
context: search
phrase: swap opposite ends of list up to {k} pairs
phrase: invert outer elements of search list up to {k}
slot: k int
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="swapped 2 outer pairs" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
test: list=1,2,3,4,5,6 k=1
expect: => i=1 r=0.0 ok=true s="swapped 1 outer pairs" errors=0 n=6 res=[6,2,3,4,5,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	var left = 0;
	var right = g.n - 1;
	var count = 0;
	while left < right && count < limit {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
		count++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped ", count, " outer pairs");
	out
}
@end
