		return out;
	}
	var cur_max = g.res[0];
	for i in 1..g.n {
		if g.res[i] > cur_max {
			cur_max = g.res[i];
		} else {
			g.res[i] = cur_max;
		}
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "running maximum is ", cur_max);
	out
}
@end
