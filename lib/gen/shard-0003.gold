test: list=2,4,7,9,10 p=is_even
expect: => i=10 r=0.0 ok=true s="" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_idx = -1;
	for i in g.n {
		if ${p}(g.res[i]) {
			last_idx = i;
		}
	}
	if last_idx >= 0 {
		g.res[0] = g.res[last_idx];
		g.n = 1;
		out.i = g.res[0];
	} else {
		g.n = 0;
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
