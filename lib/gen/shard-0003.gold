expect: => i=0 r=0.0 ok=true s="search errors found 0" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var err_count = 0;
	var attempts = 0;
	while attempts < r {
		for k in g.n {
			if g.res[k] < 0 {
				err_count++;
			}
		}
		attempts++;
		if err_count > 0 { break; }
	}
	out.i = err_count;
	out.ok = err_count == 0;
	out.s.clear();
	format(out.s, "search errors found ", err_count);
	g.steps += attempts * g.n + 1;
	out
}
@end
