expect: => i=1 r=0.0 ok=true s="sorted prefix up to 1" errors=0 n=5 res=[10,6,8,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stop_idx = g.n;
	for i in g.n {
		if ${p}(g.res[i]) { stop_idx = i; break; }
	}
	var i = 0;
	while i < stop_idx {
		var j = i + 1;
		while j < stop_idx {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = stop_idx;
	out.s.clear();
	format(out.s, "sorted prefix up to ", stop_idx);
	g.steps += stop_idx * stop_idx + 1;
	out
}
@end
