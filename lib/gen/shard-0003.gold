fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	if len > 1 {
		for i in len {
			for j in i + 1..len {
				if out.s[i] > out.s[j] {
					let tmp = out.s[i];
					out.s[i] = out.s[j];
					out.s[j] = tmp;
				}
			}
		}
	}
	gold_cache_put(g, len, if len > 0 { out.s[0] as int } else { 0 });
	g.steps += len * len;
	out.i = len;
	out
}
