fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	var sum_match = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			count++;
			sum_match += x;
		}
	}
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "found ", count, " between");
	out
}
@end
