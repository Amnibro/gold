fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		var r = 0;
		while r * r <= x {
			if r * r == x {
				is_sq = true;
				break;
			}
			r++;
		}
		if is_sq && x > limit {
			g.res[i] = limit;
			count++;
		}
	}
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped ", count, " square numbers to ", limit);
	out
}
