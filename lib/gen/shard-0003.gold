@entry df12506f265374fb
kind: step
verb: clamp
noun: memo
modifier: recursively
context: cache
phrase: clamp cached values to maximum threshold {max_val}
phrase: bound memo entries from above by {max_val}
slot: max_val int
test: list=10,25,40 max_val=20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[10,25,40] cache=3 hits=0
test: list=5,12 max_val=8
expect: => i=1 r=0.0 ok=true s="" errors=0 n=2 res=[5,12] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let high = ${max_val};
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] > high {
			g.cv[i] = high;
			clamped++;
		}
	}
	out.i = clamped;
	g.steps += g.cn;
	out
}
@end
@entry a6cb3dcb094dbba8
