		g.res[g.n - 1] = tmp;
		out.i = tmp;
		out.s.clear();
		format(out.s, "moved maximum value ", tmp, " to end");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty search list");
	}
	g.steps += g.n;
	out
}
