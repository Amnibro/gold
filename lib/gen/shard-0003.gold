code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_pos = true;
	for i in g.n {
		if g.res[i] <= 0 { all_pos = false; break; }
	}
	if !all_pos {
		gold_fail(g, "counter has non-positive value");
		out.ok = false;
		out.i = 0;
	} else {
		out.ok = true;
		out.i = g.n;
	}
