@entry 112551edb3dc38ff
kind: step
verb: map
noun: runs
modifier: at_least
context: search
phrase: map identical search runs with length at least {min_len}
phrase: transform repeated search runs meeting at least {min_len}
phrase: amplify search duplicate streaks of at least {min_len}
slot: min_len int
test: list=3,3,3,5,8,8 min_len=2
expect: => i=5 r=0.0 ok=true s="mapped 5 run items" errors=0 n=6 res=[6,6,6,5,16,16] cache=0 hits=0
test: list=1,2,2,2,4 min_len=3
expect: => i=3 r=0.0 ok=true s="mapped 3 run items" errors=0 n=5 res=[1,4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_len = ${min_len};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j += 1;
		}
		let run_len = j - i;
		if run_len >= floor_len {
			var k = i;
			while k < j {
				g.res[k] = g.res[k] * 2;
				k += 1;
			}
			modified += run_len;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped ", modified, " run items");
	out
}
@end
