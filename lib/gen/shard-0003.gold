@entry 94c060a73762e2f5
kind: step
verb: swap
noun: primes
modifier: with_cache
context: core
phrase: swap primes using cached status
phrase: exchange prime values with cache memo
test: list=2,4,3,6
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[3,4,2,6] cache=0 hits=0
test: list=7,8,11,12
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[11,8,7,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_p = -1;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var isp = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { isp = false; break; }
				d++;
			}
			if isp {
				if first_p == -1 {
					first_p = i;
				} else {
					let tmp = g.res[first_p];
					g.res[first_p] = g.res[i];
					g.res[i] = tmp;
					break;
				}
			}
		}
		i++;
	}
	out.i = first_p;
	g.steps += g.n;
	out
}
@end
