test: list=10,20,30,40,50 steps=2
expect: => i=2 r=0.0 ok=true s="rotated list by 2 positions" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3,4 steps=1
expect: => i=1 r=0.0 ok=true s="rotated list by 1 positions" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${steps};
	if g.n >= 2 && k > 0 {
		let shift = k % g.n;
		var tmp int[512] = [0; 512];
		for i in g.n {
			tmp[(i + shift) % g.n] = g.res[i];
		}
		for i in g.n {
			g.res[i] = tmp[i];
		}
	}
	g.steps += g.n * 2;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated list by ", k, " positions");
	out
}
@end
