fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged int[512] = [0; 512];
	var mn = 0;
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			sum += g.res[i + 1];
			i++;
		}
		merged[mn] = sum;
		mn++;
		i++;
	}
	for k in mn {
		g.res[k] = merged[k];
	}
	g.n = mn;
	g.steps += g.n;
	out.i = mn;
	out.s.clear();
	format(out.s, "merged duplicate items into ", mn, " elements");
	out
}
