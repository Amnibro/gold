code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let count = if g.n < limit { g.n } else { limit };
	var pairs = 0;
	var idx = 0;
	while idx + 1 < count {
		let pair_sum = g.res[idx] + g.res[idx + 1];
		gold_cache_put(g, idx, pair_sum);
		pairs++;
		idx++;
	}
	out.i = pairs;
	g.steps += count;
	out
}
@end
