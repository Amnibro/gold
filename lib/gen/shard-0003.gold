fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "list empty");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var greater = 0;
	for i in g.n - 1 {
		if g.res[i] > last_val {
			greater++;
		}
	}
	g.steps += g.n;
	out.i = greater;
	out.s.clear();
	format(out.s, "found ", greater, " items greater than last");
	out
}
