fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var tally = 0;
	for i in g.n {
		if g.res[i] >= low && g.res[i] <= high {
			tally++;
		}
	}
	gold_cache_put(g, low, tally);
	g.steps += g.n;
	out.i = tally;
	out.s.clear();
	format(out.s, "cached tally of ", tally, " items between bounds");
	out
}
@end
