@entry e30258a761a8cdf9
kind: step
verb: join
noun: checkpoint
modifier: while
context: error
phrase: join checkpoint totals while below limit {limit}
phrase: accumulate checkpoint values bounded by {limit}
slot: limit int
test: list=10,20,30 limit=50
expect: => i=30 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20 limit=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 || g.res[0] > lim {
		gold_fail(g, "initial value exceeds limit");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n {
		if sum + g.res[k] <= lim {
			sum += g.res[k];
		} else {
			break;
		}
	}
	out.i = sum;
	g.steps += g.n;
	out
}
@end
@entry 16b58d5d1b47dab3
kind: step
verb: join
noun: suffix
modifier: unique
context: error
phrase: collect unique suffix elements of length {k}
phrase: join distinct trailing items of count {k}
slot: k int
test: list=1,2,2,3 k=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,2 k=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if limit < 0 || limit > g.n {
		gold_fail(g, "suffix length out of range");
		out.ok = false;
		out.i = 0;
		return out;
	}
	let start = g.n - limit;
	var kept int[512] = [0; 512];
	var kn = 0;
	for i in limit {
		let x = g.res[start + i];
		var seen = false;
		for p in kn { if kept[p] == x { seen = true; break; } }
		if !seen { kept[kn] = x; kn++; }
	}
	gold_clear(g);
	for p in kn { gold_push(g, kept[p]); }
	out.i = kn;
	g.steps += limit;
	out
}
@end
