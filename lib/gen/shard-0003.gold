code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	var buf int[64] = [0; 64];
	var n_buf = 0;
	for idx in g.n {
		let x = g.res[idx];
		if n_buf < 64 { buf[n_buf] = x; n_buf++; }
		var is_sq = false;
		var r = 1;
		while r * r <= x {
			if r * r == x { is_sq = true; break; }
			r++;
		}
		if is_sq {
			if n_buf < 64 { buf[n_buf] = x; n_buf++; }
			dup_count++;
		}
	}
	gold_clear(g);
	for k in n_buf { gold_push(g, buf[k]); }
	out.i = dup_count;
	g.steps += dup_count;
	out.s.clear();
	format(out.s, "duplicated squares count ", dup_count);
	out
}
@end
