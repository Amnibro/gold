@entry b7ec456533a083db
kind: step
verb: join
noun: threshold
modifier: at_most
context: filter
phrase: join adjacent items while sum at most threshold {threshold}
phrase: combine neighbor pairs while at most threshold {threshold}
slot: threshold int
test: list=2,3,10,4,5 threshold=6
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,10,4,5] cache=0 hits=0
test: list=1,1,1,10 threshold=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n >= 2 {
		var w = 0;
		var i = 0;
		while i < g.n {
			if i + 1 < g.n && (g.res[i] + g.res[i + 1] <= th) {
				g.res[w] = g.res[i] + g.res[i + 1];
				w++;
				i += 2;
			} else {
				g.res[w] = g.res[i];
				w++;
				i++;
			}
		}
		g.n = w;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
