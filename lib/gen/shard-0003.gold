fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wsz = ${win_size};
	var valid_windows = 0;
	var i = 0;
	var win_idx = 0;
	while i + wsz <= g.n {
		if win_idx % 2 == 0 {
			var wsum = 0;
			for k in wsz {
				wsum += g.res[i + k];
			}
			if wsum > 0 {
				valid_windows += 1;
			}
		}
		win_idx += 1;
		i += 1;
	}
	g.steps += win_idx;
	out.i = valid_windows;
	out.s.clear();
	format(out.s, "counted ", valid_windows, " positive alternate windows");
	out
}
