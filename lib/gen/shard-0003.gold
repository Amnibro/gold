test: list=10,20,30 delta=5
expect: => i=3 r=0.0 ok=true s="shifted 3 items using cache" errors=0 n=3 res=[15,25,35] cache=3 hits=0
test: list=1,2,3 delta=10
expect: => i=3 r=0.0 ok=true s="shifted 3 items using cache" errors=0 n=3 res=[11,12,13] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fallback = ${delta};
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		let shift = if ok { cached } else { fallback };
		g.res[i] = x + shift;
		gold_cache_put(g, x, shift + 1);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " items using cache");
	out
}
@end
@entry a893a4b144259955
kind: step
verb: split
noun: window
modifier: every_other
context: search
phrase: split list into alternating windows of size {w}
phrase: extract every other chunk of width {w} from search
slot: w int
test: list=1,2,3,4,5,6,7,8 w=2
expect: => i=4 r=0.0 ok=true s="split into 4 elements across alternating windows" errors=0 n=4 res=[1,2,5,6] cache=0 hits=0
test: list=10,20,30,40,50,60,70,80,90 w=3
expect: => i=6 r=0.0 ok=true s="split into 6 elements across alternating windows" errors=0 n=6 res=[10,20,30,70,80,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let width = ${w};
	if width <= 0 || g.n == 0 {
		return out;
	}
	var kept int[512] = [0; 512];
	var kn = 0;
	var i = 0;
	var take = true;
	while i < g.n {
		let end = if i + width < g.n { i + width } else { g.n };
		if take {
			var j = i;
			while j < end {
				kept[kn] = g.res[j];
				kn++;
				j++;
			}
		}
		take = !take;
		i += width;
	}
	for k in kn {
		g.res[k] = kept[k];
	}
	g.n = kn;
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "split into ", kn, " elements across alternating windows");
	out
}
@end
