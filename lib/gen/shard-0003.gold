fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${pad};
	if p <= 0 {
		gold_fail(g, "invalid padding size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid padding size");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results for padding");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	for i in g.n {
		g.res[i] += p;
	}
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "applied padding ", p);
	out
}
@end
