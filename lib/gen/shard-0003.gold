		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_count += 1;
			} else {
				g.res[streaks] = cur_count;
				streaks += 1;
				cur_count = 1;
			}
			i += 1;
		}
		g.res[streaks] = cur_count;
		streaks += 1;
	}
	g.n = streaks;
	g.steps += streaks;
	out.i = streaks;
	out.s.clear();
	format(out.s, "compressed into ", streaks, " distinct streaks");
