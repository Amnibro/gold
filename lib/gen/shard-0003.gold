code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	let start = if sz < g.n { g.n - sz } else { 0 };
	let num = g.n - start;
	for i in num {
		g.res[i] = g.res[start + i];
	}
	g.n = num;
	g.steps += num;
	out.i = num;
	gold_text(out, "suffix isolated");
	out
}
@end
