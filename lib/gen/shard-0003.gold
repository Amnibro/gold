code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var dupes = 0;
	var i = g.n - 1;
	while i > 0 {
		if g.res[i] == g.res[i - 1] {
			g.res[i] += 1;
			dupes++;
		}
		i--;
	}
	g.steps += g.n;
	out.i = dupes;
	gold_text(out, "duplicates shifted");
	out
}
@end
