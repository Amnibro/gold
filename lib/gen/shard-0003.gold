	for i in g.n - 1 {
		g.res[i] = (g.res[i] + g.res[i + 1]) / 2;
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "smoothed");
	out
}
@end
