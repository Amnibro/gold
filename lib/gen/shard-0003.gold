fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	let sp = ${step};
	let cnt = ${count};
	gold_clear(g);
	var k = 0;
	while k < cnt && g.n < 512 {
		gold_push(g, st + k * sp);
		k++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "generated series size ", g.n);
	g.steps += k;
	out
}
@end
@entry 88a0339f2a8b6c51
kind: step
verb: sort
noun: sequence
modifier: with_retry
context: core
phrase: sort sequence elements with retry pass limit {tries}
phrase: order sequence values with retry attempts {tries}
slot: tries int
test: list=9,3,7,1 tries=3
expect: => i=3 r=0.0 ok=true s="sort passes 3" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
test: list=5,4,3,2,1 tries=2
expect: => i=2 r=0.0 ok=true s="sort passes 2" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_passes = ${tries};
	var pass = 0;
	while pass < max_passes {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		pass++;
		if !swapped { break; }
	}
	out.i = pass;
	out.s.clear();
	format(out.s, "sort passes ", pass);
	g.steps += pass * g.n;
	out
}
@end
