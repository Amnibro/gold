@entry fefbd7602cca13b3
kind: step
verb: merge
noun: streak
modifier: at_least
context: math
phrase: merge streak sequences of length at least two
phrase: combine consecutive streak of at least two items
test: list=2,2,2,3,4,4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[6,3,8] cache=0 hits=0
test: list=1,1,2,3,3,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,2,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var merged_buf int[512] = [0; 512];
	var m_cnt = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let streak_len = j - i;
		if streak_len >= 2 {
			merged_buf[m_cnt] = g.res[i] * streak_len;
		} else {
			merged_buf[m_cnt] = g.res[i];
		}
		m_cnt++;
		i = j;
	}
	var k = 0;
	while k < m_cnt {
		g.res[k] = merged_buf[k];
		k++;
	}
	g.n = m_cnt;
	out.i = m_cnt;
	g.steps += g.n;
	out
}
@end
