verb: dedupe
noun: minimum
modifier: none
context: cache
phrase: cache minimum unique value from results
phrase: record smallest distinct element in memo store
test: list=8,3,5,3,9
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[8,3,5,3,9] cache=1 hits=0
test: list=20,10,10,30
expect: => i=10 r=0.0 ok=true s="" errors=0 n=4 res=[20,10,10,30] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	gold_cache_put(g, 0, min_val);
	out.i = min_val;
	g.steps += g.n;
	out
}
@end
@entry 1cb1a7071da9b7d4
kind: step
verb: rotate
noun: words
modifier: in_reverse
context: cache
phrase: cache word counts reversed from text
phrase: record word lengths in reverse order in memo
test: text="apple banana cherry"
expect: => i=3 r=0.0 ok=true s="apple banana cherry" errors=0 n=0 res=[] cache=3 hits=0
test: text="cat dog"
expect: => i=2 r=0.0 ok=true s="cat dog" errors=0 n=0 res=[] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lens int[512] = [0; 512];
	var ln = 0;
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == 32 {
			if cur > 0 { lens[ln] = cur; ln++; cur = 0; }
		} else {
			cur++;
		}
	}
	if cur > 0 { lens[ln] = cur; ln++; }
	var k = ln;
	var stored = 0;
	while k > 0 {
		k--;
		gold_cache_put(g, stored, lens[k]);
		stored++;
	}
	out.i = stored;
	g.steps += out.s.len;
	out
}
@end
