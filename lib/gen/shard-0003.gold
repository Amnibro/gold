fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${bound};
	var n = out.i;
	if n < 0 { n = -n; }
	var dsum = 0;
	while n > 0 {
		dsum += n % 10;
		n /= 10;
	}
	let clamped = if dsum > max_d { max_d } else { dsum };
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped digit sum ", clamped);
	g.steps += dsum + 1;
	out
}
@end
