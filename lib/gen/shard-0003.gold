fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_vowel = -1;
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		   b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U' {
			last_vowel = i;
		}
	}
	if last_vowel > 0 && out.s.len > 0 {
		let tmp = out.s[0];
		out.s[0] = out.s[last_vowel];
		out.s[last_vowel] = tmp;
		out.ok = true;
	} else {
		out.ok = false;
	}
	out.i = last_vowel;
	g.steps += out.s.len;
	out
}
