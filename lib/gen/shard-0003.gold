	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if g.n < 2 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	for i in g.n - 1 {
