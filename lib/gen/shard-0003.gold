code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = g.n;
	var passes = 0;
	var p = 0;
	while p < n {
		var q = 0;
		while q + 1 < n - p {
			if g.res[q] > g.res[q + 1] {
				let tmp = g.res[q];
				g.res[q] = g.res[q + 1];
				g.res[q + 1] = tmp;
				passes++;
			}
			q++;
		}
		p++;
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "sorted comparisons with swaps ", passes);
	out
}
@end
