expect: => i=2 r=0.0 ok=true s="removed minimum 2" errors=0 n=3 res=[5,8,9] cache=0 hits=0
test: list=14,3,20,30
expect: => i=3 r=0.0 ok=true s="removed minimum 3" errors=0 n=3 res=[14,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list");
		return out;
	}
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_val = g.res[min_idx];
	for i in min_idx..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.n -= 1;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "removed minimum ", min_val);
	out
}
@end
@entry 0a792d9780d514a4
kind: step
verb: compare
noun: step
modifier: first
context: math
phrase: compare step first offset {step}
phrase: verify step stride from first {step}
slot: step int
test: list=5,11,17,23 step=6
expect: => i=1 r=0.0 ok=true s="all items align with step" errors=0 n=4 res=[5,11,17,23] cache=0 hits=0
test: list=10,15,25 step=5
expect: => i=1 r=0.0 ok=true s="all items align with step" errors=0 n=3 res=[10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	if g.n <= 1 || s <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "trivial step check");
		return out;
	}
	let first = g.res[0];
	var valid = true;
	for i in 1..g.n {
		if (g.res[i] - first) % s != 0 {
			valid = false;
			break;
		}
	}
	g.steps += g.n;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "all items align with step");
	} else {
		format(out.s, "items do not align with step");
	}
	out
}
@end
