expect: => i=1 r=0.0 ok=true s="oducatien" errors=0 n=0 res=[] cache=0 hits=0
test: text="sequoia"
expect: => i=1 r=0.0 ok=true s="saquoie" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_v = -1;
	var last_v = -1;
	for i in out.s.len {
		let c = out.s[i];
		let is_v = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
		if is_v {
			if first_v < 0 { first_v = i; }
			last_v = i;
		}
	}
	if first_v >= 0 && last_v > first_v {
		let tmp = out.s[first_v];
		out.s[first_v] = out.s[last_v];
		out.s[last_v] = tmp;
	}
	out.i = if first_v >= 0 { 1 } else { 0 };
	g.steps += out.s.len;
	out
}
@end
