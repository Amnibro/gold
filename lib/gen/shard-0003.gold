code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var i = 0;
	while i < g.n && rem > 0 {
		var j = i + 1;
		while j < g.n && rem > 0 {
			rem--;
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = rem;
	out.s.clear();
	format(out.s, "remaining budget ", rem);
	g.steps += g.n;
	out
}
@end
