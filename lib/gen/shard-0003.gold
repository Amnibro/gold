expect: => i=2 r=0.0 ok=true s="filtered between bounds retained 2" errors=0 n=2 res=[8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${lo};
	let max_v = ${hi};
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= min_v && x <= max_v {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered between bounds retained ", kept);
	out
}
@end
@entry ddf6cd6fa278cb0b
kind: step
verb: validate
noun: letters
modifier: every_other
context: list
phrase: validate every other item is letter ASCII code
phrase: check alternate values represent alphabetic characters
test: list=65,10,66,20,67
expect: => i=1 r=0.0 ok=true s="alternate letters validated true" errors=0 n=5 res=[65,10,66,20,67] cache=0 hits=0
test: list=10,65,20,66
expect: => i=0 r=0.0 ok=false s="non-letter found at alternate position" errors=0 n=4 res=[10,65,20,66] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	var i = 0;
	while i < g.n {
		let c = g.res[i];
		let is_letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
		if !is_letter {
			valid = false;
			break;
		}
		i += 2;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	if valid {
		format(out.s, "alternate letters validated true");
	} else {
		format(out.s, "non-letter found at alternate position");
	}
	g.steps += g.n;
	out
}
@end
