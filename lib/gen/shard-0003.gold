context: stats
phrase: count items exceeding threshold {thresh} up to limit {cap}
phrase: tally observations above threshold {thresh} up to {cap}
slot: thresh int
slot: cap int
test: list=10,25,30,45,50 thresh=20 cap=2
expect: => i=2 r=0.0 ok=true s="tallied 2 items above threshold" errors=0 n=5 res=[10,25,30,45,50] cache=0 hits=0
