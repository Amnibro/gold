fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
	}
	var folded_diff = 0;
	var k = 0;
	while k + 1 < g.n {
		folded_diff += g.res[k + 1] - g.res[k];
		k++;
	}
	out.i = folded_diff;
	g.steps += folded_diff;
	out.s.clear();
	format(out.s, "folded sorted span ", folded_diff);
	out
}
@end
