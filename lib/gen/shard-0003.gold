code:
fn ${ID}_is_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			prime_count++;
			g.res[i] = 1;
		} else {
			g.res[i] = 0;
		}
	}
	out.i = prime_count;
	out
}
@end
