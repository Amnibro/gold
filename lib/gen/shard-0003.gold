@entry f52acf7e546eecc4
kind: step
verb: drop
noun: squares
modifier: first
context: cache
phrase: drop initial square values from cached sequence
phrase: remove leading square numbers from cache
test: list=4,9,7,12
expect: => i=2 r=0.0 ok=true s="squares dropped" errors=0 n=2 res=[7,12] cache=2 hits=0
test: list=16,25,36,5
expect: => i=3 r=0.0 ok=true s="squares dropped" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { is_sq = true; }
		}
		if !is_sq { break; }
		idx++;
	}
	var kept = 0;
	var i = idx;
	while i < g.n {
		g.res[kept] = g.res[i];
		gold_cache_put(g, kept, g.res[i]);
		kept++;
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = idx;
	gold_text(out, "squares dropped");
	out
}
@end
