code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var min_idx = 0;
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
		i++;
	}
	if min_idx > 0 {
		let swap_tmp = g.res[0];
		g.res[0] = g.res[min_idx];
		g.res[min_idx] = swap_tmp;
	}
	out.i = min_val;
	g.steps += g.n;
	out
}
@end
