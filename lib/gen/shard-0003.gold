fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var k = 0;
	while k < g.n {
		g.res[k] = (k + 1) * 10;
		k++;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
