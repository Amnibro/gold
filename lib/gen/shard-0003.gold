@entry 463461b4dc207f04
kind: step
verb: filter
noun: checkpoint
modifier: pairwise
context: search
phrase: filter pairwise differences larger than checkpoint {cp}
phrase: retain consecutive jumps surpassing checkpoint {cp}
slot: cp int
test: list=10,15,35,40,65 cp=10
expect: => i=2 r=0.0 ok=true s="filtered 2 pairwise jumps past checkpoint" errors=0 n=2 res=[20,25] cache=0 hits=0
test: list=1,5,7,15,18 cp=5
expect: => i=1 r=0.0 ok=true s="filtered 1 pairwise jumps past checkpoint" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let checkpoint = ${cp};
	var count = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d > checkpoint {
				g.res[count] = diff;
				count++;
			}
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered ", count, " pairwise jumps past checkpoint");
	out
}
@end
