code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = if g.n > 0 { sum / g.n } else { 0 };
	if avg < lo { avg = lo; }
	else if avg > hi { avg = hi; }
	out.i = avg;
	out.s.clear();
	format(out.s, "clamped average ", avg);
	g.steps += g.n;
	out
}
@end
