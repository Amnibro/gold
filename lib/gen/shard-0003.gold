fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${floor};
	let mult = ${factor};
	var count = 0;
	for i in g.n {
		if g.res[i] >= min_v {
			g.res[i] = g.res[i] * mult;
			count += 1;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped ", count, " items meeting floor");
	out
}
@end
