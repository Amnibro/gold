@entry d6bd76ad38abd966
kind: step
verb: split
noun: words
modifier: pairwise
context: search
phrase: search text splitting adjacent word lengths pairwise
phrase: compare consecutive word spans pairwise in text
test: text="search find locate inspect"
expect: => i=3 r=0.0 ok=true s="split 3 pairwise word spans" errors=0 n=3 res=[-2,2,1] cache=0 hits=0
test: text="alpha beta gamma"
expect: => i=2 r=0.0 ok=true s="split 2 pairwise word spans" errors=0 n=2 res=[-1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var lens int[512] = [0; 512];
	var ln = 0;
	var cur = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if cur > 0 {
				lens[ln] = cur;
				ln++;
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 {
		lens[ln] = cur;
		ln++;
	}
	if ln >= 2 {
		for i in ln - 1 {
			let diff = lens[i + 1] - lens[i];
			gold_push(g, diff);
		}
	}
	g.steps += out.s.len + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "split ", g.n, " pairwise word spans");
	out
}
@end
