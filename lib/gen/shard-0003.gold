fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var longest = 0;
	var curr = 0;
	for i in g.n {
		if i == 0 || g.res[i] >= g.res[i - 1] {
			curr += 1;
		} else {
			curr = 1;
		}
		if curr > longest {
			longest = curr;
		}
	}
	if longest > lim {
		longest = lim;
	}
	g.steps += g.n;
	out.i = longest;
	out.s.clear();
	format(out.s, "longest streak found is ", longest);
	out
}
@end
