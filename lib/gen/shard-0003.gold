fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	var i = 0;
	var j = n - 1;
	while i < j {
		let tmp = out.s[i];
		out.s[i] = out.s[j];
		out.s[j] = tmp;
		i++;
		j--;
	}
	g.steps += n;
	out.i = n;
	out
}
