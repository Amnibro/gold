fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no primes to group");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty primes");
		return out;
	}
	if !${cond}(g.res[0]) {
		gold_fail(g, "initial prime fails condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: start condition failed");
		return out;
	}
	var count = 0;
	while count < g.n {
		if !${cond}(g.res[count]) { break; }
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "grouped ", count, " primes");
	out
}
