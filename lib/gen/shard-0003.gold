fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	let lim = ${limit};
	var cur_sum = 0;
	var kn = 0;
	while kn < g.n && kn < lim {
		if cur_sum + g.res[kn] >= ms { break; }
		cur_sum += g.res[kn];
		kn++;
	}
	g.n = kn;
	out.i = kn;
	g.steps += kn;
	out
}
@end
