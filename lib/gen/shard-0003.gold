test: list=5,1,2,3,0,4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=10,20,5,6,7,8,1
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	var j = 0;
	while j < best_len {
		g.res[j] = g.res[best_start + j];
		j++;
	}
	g.n = best_len;
	out.i = best_len;
	g.steps += g.n;
	out
}
@end
