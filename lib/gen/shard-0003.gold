test: list=10,20,30
expect: => i=60 r=0.0 ok=true s="" errors=0 n=3 res=[60,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	var k = 0;
	while k < g.n {
		acc += g.res[k];
		g.res[k] = acc;
		k++;
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let rev_tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = rev_tmp;
		left++;
		right--;
	}
	out.i = acc;
	g.steps += g.n;
	out
}
@end
