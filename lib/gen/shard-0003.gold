fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var factor = 2;
	var retry_needed = false;
	var i = 0;
	while i < g.n {
		if g.res[i] * factor > 100 {
			retry_needed = true;
			break;
		}
		i++;
	}
	if retry_needed { factor = 1; }
	var j = 0;
	while j < g.n {
		g.res[j] *= factor;
		j++;
	}
	out.i = factor;
	g.steps += g.n;
	out
}
@end
