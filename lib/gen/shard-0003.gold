fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct_errs int[64] = [0; 64];
	var n_errs = 0;
	var pruned = 0;
	for idx in g.n {
		let code = g.res[idx];
		var seen = false;
		for k in n_errs {
			if distinct_errs[k] == code { seen = true; break; }
		}
		if !seen {
			if n_errs < 64 { distinct_errs[n_errs] = code; n_errs++; }
		} else {
			pruned++;
		}
	}
	gold_clear(g);
	for a in n_errs { gold_push(g, distinct_errs[a]); }
	out.i = pruned;
	g.steps += pruned;
	out.s.clear();
	format(out.s, "pruned duplicate error count ", pruned);
	out
}
@end
