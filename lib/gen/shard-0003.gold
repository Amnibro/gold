@entry 86631bec64c20c51
kind: step
verb: pair
noun: series
modifier: at_most
context: stats
phrase: pair series adjacent differences at most {cap}
phrase: compute adjacent series differences up to {cap}
slot: cap int
test: list=10,15,25,40 cap=2
expect: => i=2 r=0.0 ok=true s="paired 2 differences" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=1,3,7,12,20 cap=3
expect: => i=3 r=0.0 ok=true s="paired 3 differences" errors=0 n=3 res=[2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n < 2 || limit <= 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var pairs = g.n - 1;
	if pairs > limit {
		pairs = limit;
	}
	for k in pairs {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " differences");
	out
}
@end
@entry 96545e6f6978f61c
kind: step
verb: apply
noun: tail
modifier: every_other
context: stats
phrase: apply function {f} to alternating elements of tail of length {count}
phrase: transform every other item in tail {count} using {f}
slot: count int
slot: f fn
test: list=10,20,30,40,50 count=4 f=inc
expect: => i=2 r=0.0 ok=true s="applied function to 2 tail elements" errors=0 n=5 res=[10,21,30,41,50] cache=0 hits=0
test: list=1,2,3,4,5,6 count=3 f=double
expect: => i=2 r=0.0 ok=true s="applied function to 2 tail elements" errors=0 n=6 res=[1,2,3,8,5,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let start = if c < g.n { g.n - c } else { 0 };
	var k = start;
	var applied = 0;
	while k < g.n {
		g.res[k] = ${f}(g.res[k]);
		applied++;
		k += 2;
	}
	g.steps += g.n;
	out.i = applied;
	out.s.clear();
	format(out.s, "applied function to ", applied, " tail elements");
	out
}
@end
@entry b574558d6838fbd3
kind: step
verb: normalize
noun: letters
modifier: up_to
context: stats
phrase: normalize letter case up to {max_chars} characters
phrase: standardize text letters up to limit {max_chars}
slot: max_chars int
test: text="hello WORLD" max_chars=5
expect: => i=0 r=0.0 ok=true s="hello WORLD" errors=0 n=0 res=[] cache=0 hits=0
test: text="Foo BAR Baz" max_chars=7
expect: => i=4 r=0.0 ok=true s="foo bar Baz" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_chars};
	var modified = 0;
	let end = if limit < out.s.len { limit } else { out.s.len };
	for k in end {
		let c = out.s[k];
		if c >= 'A' && c <= 'Z' {
			out.s[k] = c + 32;
			modified++;
		}
	}
	g.steps += out.s.len;
	out.i = modified;
	out
}
@end
@entry dfb185aa40541c43
kind: step
verb: count
noun: budget
modifier: times
context: stats
phrase: count items fitting budget {limit}
phrase: tally observations within budget {limit} threshold
slot: limit int
test: list=10,20,30,40 limit=45
expect: => i=2 r=0.0 ok=true s="counted 2 items under budget 45" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25,35 limit=30
expect: => i=2 r=0.0 ok=true s="counted 2 items under budget 30" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${limit};
	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] > budget {
			break;
		}
		sum += g.res[k];
		count++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted ", count, " items under budget ", budget);
	out
}
@end
@entry 0f6290378f98500a
kind: step
verb: rank
noun: errors
modifier: in_place
context: stats
phrase: rank absolute error deviations from target {target} in place
phrase: compute error distances from {target} in place
slot: target int
test: list=10,25,30,5 target=20
expect: => i=40 r=0.0 ok=true s="total error distance 40" errors=0 n=4 res=[10,5,10,15] cache=0 hits=0
test: list=100,105,95 target=100
expect: => i=10 r=0.0 ok=true s="total error distance 10" errors=0 n=3 res=[0,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var total_err = 0;
	for k in g.n {
		let diff = g.res[k] - tgt;
		let err = if diff < 0 { -diff } else { diff };
		g.res[k] = err;
		total_err += err;
	}
	g.steps += g.n;
	out.i = total_err;
	out.s.clear();
	format(out.s, "total error distance ", total_err);
	out
}
@end
