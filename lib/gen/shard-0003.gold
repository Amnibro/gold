expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var diffs int[64] = [0; 64];
	var nd = 0;
	var i = 1;
	while i < g.n && nd < 64 {
		var d = g.res[i] - g.res[i - 1];
		if d < 0 { d = -d; }
		diffs[nd] = d;
		nd++;
		i++;
	}
	gold_clear(g);
	for j in nd { gold_push(g, diffs[j]); }
	out.i = nd;
	out
}
@end
