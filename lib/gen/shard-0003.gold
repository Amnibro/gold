context: search
phrase: reverse search loop prefix {count} times
phrase: invert first {count} search loop items
phrase: reverse order of initial {count} search entries
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed 3 search loop items" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="reversed 2 search loop items" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var valid_k = k;
	if valid_k > g.n { valid_k = g.n; }
	let mid = valid_k / 2;
	for i in mid {
		let j = valid_k - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += valid_k;
	out.i = valid_k;
	out.s.clear();
	format(out.s, "reversed ", valid_k, " search loop items");
	out
}
@end
@entry 9ac65e8c1a93ac82
kind: step
verb: scale
noun: duplicates
modifier: first
context: search
phrase: scale first duplicate search hit by factor {factor}
phrase: multiply initial repeated search value by {factor}
phrase: amplify first duplicated item with multiplier {factor}
slot: factor int
test: list=3,7,3,9 factor=5
expect: => i=0 r=0.0 ok=true s="scaled first duplicate search hit" errors=0 n=4 res=[15,7,3,9] cache=0 hits=0
test: list=1,2,3,4 factor=2
expect: => i=0 r=0.0 ok=false s="no duplicate search hits" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var found = false;
	var i = 0;
	while i < g.n && !found {
		var j = i + 1;
		while j < g.n && !found {
			if g.res[i] == g.res[j] {
				g.res[i] = g.res[i] * mult;
				found = true;
			}
			j += 1;
		}
		i += 1;
	}
	g.steps += i;
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "scaled first duplicate search hit");
	} else {
		format(out.s, "no duplicate search hits");
	}
	out
}
@end
@entry c2377d7025d045b1
kind: step
verb: measure
noun: tail
modifier: unique
context: search
phrase: measure unique search items in tail of size {len}
phrase: count distinct values within trailing {len} search hits
phrase: evaluate unique elements across tail window {len}
slot: len int
test: list=5,10,20,10,20 len=4
expect: => i=2 r=0.0 ok=true s="found 2 unique trailing items" errors=0 n=5 res=[5,10,20,10,20] cache=0 hits=0
test: list=1,2,3,4 len=2
expect: => i=2 r=0.0 ok=true s="found 2 unique trailing items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	var valid_k = k;
	if valid_k > g.n { valid_k = g.n; }
	let start = g.n - valid_k;
	var count = 0;
	for i in valid_k {
		let x = g.res[start + i];
		var seen = false;
		for j in i {
			if g.res[start + j] == x { seen = true; }
		}
		if !seen {
			count += 1;
		}
	}
	g.steps += valid_k;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " unique trailing items");
	out
}
@end
