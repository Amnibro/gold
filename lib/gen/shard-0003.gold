code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = g.n;
	for i in m / 2 {
		let j = m - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += m;
	out.i = m;
	out.s.clear();
	format(out.s, "reversed ", m, " items");
	out
}
@end
@entry a501457758a3ab50
kind: step
verb: group
noun: gaps
modifier: up_to
context: math
phrase: group gaps up to ceiling {max_gap}
phrase: tally adjacent gaps under {max_gap}
slot: max_gap int
test: list=2,5,8,20,23 max_gap=4
expect: => i=3 r=0.0 ok=true s="found 3 small gaps" errors=0 n=5 res=[2,5,8,20,23] cache=0 hits=0
test: list=1,10,12,30 max_gap=3
expect: => i=1 r=0.0 ok=true s="found 1 small gaps" errors=0 n=4 res=[1,10,12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient elements");
		return out;
	}
	var matches = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= limit {
			matches++;
		}
	}
	g.steps += g.n;
	out.i = matches;
	out.s.clear();
	format(out.s, "found ", matches, " small gaps");
	out
}
@end
