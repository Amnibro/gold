fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var sum = 0;
	var count = 0;
	for k in g.n {
		if sum + g.res[k] <= limit {
			sum += g.res[k];
			count++;
		} else {
