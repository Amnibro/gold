fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	var k = 0;
	while k < d && g.n * 2 <= 512 {
		let orig = g.n;
		for i in orig {
			gold_push(g, g.res[i]);
		}
		k++;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
