fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	for i in g.n - 1 {
		let d1 = g.res[i] % 10;
		let d2 = g.res[i + 1] % 10;
		g.res[i] += (d2 - d1);
	}
	g.steps += g.n;
	out.i = g.n - 1;
	gold_text(out, "pairwise digits shifted");
	out
}
@end
