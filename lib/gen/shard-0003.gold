expect: => i=2 r=0.0 ok=true s="reversed 2 items in place" errors=0 n=4 res=[6,5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < g.n { lim } else { g.n };
	if count > 1 {
		var left = 0;
		var right = count - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left += 1;
			right -= 1;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " items in place");
	out
}
@end
