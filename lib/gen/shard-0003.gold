code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_gap = 0;
	var i = 1;
	while i < g.n {
		let gap = if g.res[i] > g.res[i - 1] { g.res[i] - g.res[i - 1] } else { g.res[i - 1] - g.res[i] };
		if gap > max_gap { max_gap = gap; }
		i++;
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "maximum gap: ", max_gap);
	g.steps += g.n;
	out
}
@end
