fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		s += diff;
		i++;
	}
	out.i = s;
	out
}
