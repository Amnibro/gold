fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_pairs = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let a = g.res[i - 1];
			let b = g.res[i];
			var ca = 0;
			var cb = 0;
			for k in g.n {
				if g.res[k] == a { ca++; }
				if g.res[k] == b { cb++; }
			}
			let prod = ca * cb;
			gold_cache_put(g, i, prod);
			total_pairs++;
		}
	}
	g.steps += g.n * g.n;
	out.i = total_pairs;
	out.s.clear();
	format(out.s, "paired ", total_pairs, " histogram values");
	out
}
