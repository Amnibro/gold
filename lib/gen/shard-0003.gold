code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tk = ${target_key};
	if g.cn == 0 {
		gold_cache_put(g, 10, 100);
		gold_cache_put(g, 20, 200);
	}
	let val, found = gold_cache_get(g, tk);
	if !found {
		gold_cache_put(g, tk, 999);
		out.ok = true;
		out.i = 0;
	} else {
		out.ok = false;
		out.i = val;
	}
	g.steps += g.cn;
	out
}
@end
