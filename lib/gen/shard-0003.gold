test: list=1,3,5,9,11
expect: => i=2 r=0.0 ok=true s="grouped 2 unique pairwise differences" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_diffs int[512] = [0; 512];
	var un = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			var found = false;
			for j in un {
				if u_diffs[j] == d {
					found = true;
					break;
				}
			}
			if !found {
				u_diffs[un] = d;
				un++;
			}
		}
	}
	for k in un {
		g.res[k] = u_diffs[k];
	}
	g.n = un;
	g.steps += g.n + un * un;
	out.i = un;
	out.s.clear();
	format(out.s, "grouped ", un, " unique pairwise differences");
	out
}
@end
