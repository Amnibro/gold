code:
fn ${ID}(n int) bool {
	let max_dist = ${span};
	var x = if n < 0 { -n } else { n };
	var d int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	for i in len {
		for j in 1..max_dist + 1 {
			if i + j < len {
				let left = d[len - 1 - i];
				let right = d[len - 1 - (i + j)];
				if left > right { return true; }
			}
		}
	}
	false
}
@end
