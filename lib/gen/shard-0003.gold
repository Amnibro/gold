expect: => i=78 r=0.0 ok=true s="recursive max 78" errors=0 n=4 res=[50,12,78,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mx = if g.n > 0 { g.res[0] } else { 0 };
	var left = 0;
	var right = g.n - 1;
	while left <= right {
		if g.res[left] > mx { mx = g.res[left]; }
		if g.res[right] > mx { mx = g.res[right]; }
		left++;
		right--;
	}
	out.i = mx;
	out.s.clear();
	format(out.s, "recursive max ", mx);
	g.steps += g.n;
	out
}
@end
@entry 7d5241b67a358a9f
kind: step
verb: clamp
noun: primes
modifier: last
context: core
phrase: clamp tail prime elements down to threshold {cap}
phrase: bound trailing prime values under ceiling {cap}
slot: cap int
test: list=4,6,7,11,13 cap=10
expect: => i=2 r=0.0 ok=true s="tail primes clamped 2" errors=0 n=5 res=[4,6,7,10,10] cache=0 hits=0
test: list=2,3,5,17 cap=8
expect: => i=1 r=0.0 ok=true s="tail primes clamped 1" errors=0 n=4 res=[2,3,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil_v = ${cap};
	var clamped = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if x > ceil_v {
				g.res[i] = ceil_v;
				clamped++;
			}
		} else {
			break;
		}
		i--;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "tail primes clamped ", clamped);
	g.steps += g.n - i;
	out
}
@end
