code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty sequence to run");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty sequence");
		return out;
	}
	let count = if lim < g.n { lim } else { g.n };
	var running = 0;
	for i in count {
		running += g.res[i];
		g.res[i] = running;
	}
	g.n = count;
	g.steps += count;
	out.i = running;
	out.s.clear();
	format(out.s, "running sequence sum is ", running);
	out
}
@end
