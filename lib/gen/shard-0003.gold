expect: => i=1 r=0.0 ok=true s="expanded prefix by 1 items" errors=0 n=3 res=[10,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step_val = ${inc};
	let target = ${target_len};
	var added = 0;
	while g.n < target && g.n < 512 {
		var next_val = step_val;
		if g.n > 0 {
			next_val = g.res[g.n - 1] + step_val;
		}
		g.res[g.n] = next_val;
		g.n += 1;
		added += 1;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "expanded prefix by ", added, " items");
	out
}
@end
