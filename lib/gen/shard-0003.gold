@entry 696a070a5d9301b9
kind: step
verb: sum
noun: streak
modifier: none
context: sort
phrase: sum elements in longest increasing streak
phrase: accumulate longest sorted contiguous run
test: list=5,1,2,3,0,4
expect: => i=6 r=0.0 ok=true s="streak summed" errors=0 n=6 res=[5,1,2,3,0,4] cache=0 hits=0
test: list=10,2,4,6,1,3
expect: => i=12 r=0.0 ok=true s="streak summed" errors=0 n=6 res=[10,2,4,6,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var best_sum = g.res[0];
	var best_len = 1;
	var cur_sum = g.res[0];
	var cur_len = 1;
	for i in g.n - 1 {
		if g.res[i] <= g.res[i + 1] {
			cur_sum += g.res[i + 1];
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_sum = cur_sum;
			}
		} else {
			cur_sum = g.res[i + 1];
			cur_len = 1;
		}
	}
	g.steps += g.n;
	out.i = best_sum;
	gold_text(out, "streak summed");
	out
}
@end
@entry 53ef4b96b496fad2
kind: step
verb: shift
noun: primes
modifier: with_retry
context: sort
phrase: shift prime numbers to sorted front
phrase: move primes forward in sorted order
test: list=4,2,9,3,8,5
expect: => i=3 r=0.0 ok=true s="primes shifted" errors=0 n=6 res=[2,3,5,4,8,9] cache=0 hits=0
test: list=10,7,6,11,4
expect: => i=2 r=0.0 ok=true s="primes shifted" errors=0 n=5 res=[7,11,4,6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// Sort entire list first
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	// Shift primes to front
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			let val = g.res[i];
			var k = i;
			while k > primes_count {
				g.res[k] = g.res[k - 1];
				k--;
			}
			g.res[primes_count] = val;
			primes_count++;
		}
	}
	g.steps += g.n;
	out.i = primes_count;
	gold_text(out, "primes shifted");
	out
}
@end
