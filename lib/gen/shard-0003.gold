test: list=3,1,2,1,3,3
expect: => i=3 r=0.0 ok=true s="sorted histogram unique bins 3" errors=0 n=6 res=[1,1,2,3,3,3] cache=0 hits=0
test: list=4,5,4,6,6,6
expect: => i=3 r=0.0 ok=true s="sorted histogram unique bins 3" errors=0 n=6 res=[4,4,5,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var u_vals: int[512] = [0; 512];
	var u_cnts: int[512] = [0; 512];
	var u_n = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var cnt = 0;
		while i < g.n && g.res[i] == val {
			cnt++;
			i++;
		}
		u_vals[u_n] = val;
		u_cnts[u_n] = cnt;
		u_n++;
	}
	var new_idx = 0;
	for a in u_n {
		for c in u_cnts[a] {
			g.res[new_idx] = u_vals[a];
			new_idx++;
		}
	}
	g.steps += g.n * 2;
	out.i = u_n;
	out.s.clear();
	format(out.s, "sorted histogram unique bins ", u_n);
	out
}
@end
