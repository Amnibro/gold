@entry f2d9a9f0fd02b809
kind: step
verb: count
noun: minimum
modifier: at_most
context: cache
phrase: count minimum occurrences at most limit {limit}
phrase: tally minimum entries at most limit {limit}
slot: limit int
test: list=2,2,5,2,7 limit=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,2,5,2,7] cache=5 hits=0
test: list=3,1,1,1,4 limit=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[3,1,1,1,4] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
		gold_cache_put(g, i, g.res[i]);
	}
	var count = 0;
	for i in g.cn {
		if g.cv[i] == min_val {
			count++;
			if count == lim {
				break;
			}
		}
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
