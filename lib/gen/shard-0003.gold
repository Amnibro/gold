@entry 8b514b7dd02adda5
kind: step
verb: find
noun: window
modifier: none
context: stats
phrase: find optimal window of width {width}
phrase: locate maximal sum window {width}
slot: width int
test: list=1,4,2,8,3,1 width=3
expect: => i=14 r=0.0 ok=true s="max window found" errors=0 n=6 res=[1,4,2,8,3,1] cache=0 hits=0
test: list=10,5,2,20,1 width=2
expect: => i=22 r=0.0 ok=true s="max window found" errors=0 n=5 res=[10,5,2,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${width};
	if w <= 0 || w > g.n {
		out.i = 0;
		return out;
	}
	var max_sum = 0;
	for i in w {
		max_sum += g.res[i];
	}
	var cur_sum = max_sum;
	var i = w;
	while i < g.n {
		cur_sum = cur_sum + g.res[i] - g.res[i - w];
		if cur_sum > max_sum {
			max_sum = cur_sum;
		}
		i++;
	}
	g.steps += g.n;
	out.i = max_sum;
	gold_text(out, "max window found");
	out
}
@end
