@entry 8467c66ecfafca88
kind: step
verb: fold
noun: runs
modifier: between
context: core
phrase: fold contiguous run lengths between index {st} to index {en}
phrase: accumulate run lengths between indices {st} through {en}
slot: st int
slot: en int
test: list=1,1,2,2,2,3 st=0 en=5
expect: => i=6 r=0.0 ok=true s="folded 3 runs sum 6" errors=0 n=6 res=[1,1,2,2,2,3] cache=0 hits=0
test: list=4,4,5,6,6,6,6 st=1 en=6
expect: => i=6 r=0.0 ok=true s="folded 3 runs sum 6" errors=0 n=7 res=[4,4,5,6,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${st};
	let end = ${en};
	var total_runs = 0;
	var sum_len = 0;
	if start >= 0 && end < g.n && start <= end {
		var i = start;
		while i <= end {
			var rlen = 1;
			while i + 1 <= end && g.res[i] == g.res[i + 1] {
				rlen++;
				i++;
			}
			total_runs++;
			sum_len += rlen;
			i++;
		}
	}
	out.i = sum_len;
	out.s.clear();
	format(out.s, "folded ", total_runs, " runs sum ", sum_len);
	g.steps += total_runs + sum_len;
	out
}
@end
@entry 5f74d002f1035772
kind: step
verb: clamp
noun: gaps
modifier: times
context: core
phrase: clamp adjacent gaps scaled {mult} times
phrase: restrict pairwise gaps multiplied by factor {mult}
slot: mult int
test: list=10,25,30 mult=2
expect: => i=0 r=0.0 ok=true s="clamped gaps 0" errors=0 n=3 res=[10,25,30] cache=0 hits=0
test: list=5,15,40 mult=3
expect: => i=1 r=0.0 ok=true s="clamped gaps 1" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${mult};
	var adjusted = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			let gap = (g.res[i] - g.res[i - 1]) * factor;
			if gap > 30 {
				g.res[i] = g.res[i - 1] + (30 / factor);
				adjusted++;
			}
			i++;
		}
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped gaps ", adjusted);
	g.steps += g.n;
	out
}
@end
