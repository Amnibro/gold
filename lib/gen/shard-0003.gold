@entry 0572be52e52e254e
kind: step
verb: dedupe
noun: item
modifier: first
context: list
phrase: dedupe first occurrence of target item {target}
phrase: remove initial duplicate of value {target}
slot: target int
test: list=5,10,5,20,5 target=5
expect: => i=1 r=0.0 ok=true s="deduped first duplicate of 5" errors=0 n=4 res=[5,10,20,5] cache=0 hits=0
test: list=1,2,3,4 target=2
expect: => i=0 r=0.0 ok=false s="no duplicate removed for 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var first_seen = false;
	var removed = false;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x == tgt {
			if !first_seen {
				first_seen = true;
				g.res[kept] = x;
				kept++;
			} else if !removed {
				removed = true;
			} else {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.ok = removed;
	out.i = if removed { 1 } else { 0 };
	out.s.clear();
	if removed {
		format(out.s, "deduped first duplicate of ", tgt);
	} else {
		format(out.s, "no duplicate removed for ", tgt);
	}
	out
}
@end
