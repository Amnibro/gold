noun: histogram
modifier: while
context: cache
phrase: pair histogram frequencies while caching below limit {limit}
phrase: compute histogram pairs while storing cache under limit {limit}
slot: limit int
test: list=2,2,3,3,3 limit=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,2,3,3,3] cache=2 hits=3
test: list=4,4,4,4 limit=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[4,4,4,4] cache=1 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		let k = g.res[i];
		let count, ok = gold_cache_get(g, k);
		if ok {
			gold_cache_put(g, k, count + 1);
		} else {
			gold_cache_put(g, k, 1);
		}
	}
	var pairs = 0;
	var idx = 0;
	while idx < g.cn && pairs < lim {
		if g.cv[idx] >= 2 {
			pairs++;
		}
		idx++;
	}
	out.i = pairs;
	g.steps += g.n;
	out
}
@end
