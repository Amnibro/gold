@entry dc8b6ef5ade4792d
kind: step
verb: retry
noun: evens
modifier: at_most
context: sort
phrase: retry sorting even elements at most limit {limit}
phrase: attempt sort of even items at most passes {limit}
slot: limit int
test: list=8,3,2,5,4 limit=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,4,5,8] cache=0 hits=0
test: list=10,7,6,1,2 limit=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[6,7,2,1,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var passes = 0;
	while passes < lim {
		var swapped = false;
		for i in g.n {
			if g.res[i] % 2 == 0 {
				var j = i + 1;
				while j < g.n {
					if g.res[j] % 2 == 0 {
						if g.res[i] > g.res[j] {
							let tmp = g.res[i];
							g.res[i] = g.res[j];
							g.res[j] = tmp;
							swapped = true;
						}
						break;
					}
					j++;
				}
			}
		}
		passes++;
		if !swapped { break; }
	}
	out.i = passes;
	g.steps += g.n;
	out
}
@end
