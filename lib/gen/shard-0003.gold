fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let k = v.i % g.n;
	var buf int[64] = [0; 64];
	for i in g.n {
		if i < 64 { buf[i] = g.res[i]; }
	}
	for idx in g.n {
		let src = (idx + g.n - k) % g.n;
		if src < 64 { g.res[idx] = buf[src]; }
	}
	out.i = k;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated right by offset ", k);
	out
}
@end
