code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${max_retries};
	var r = 0;
	if g.n > 1 {
		var w = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[w - 1] && r < retries {
				r++;
			} else {
				g.res[w] = g.res[i];
				w++;
			}
			i++;
		}
		g.n = w;
	}
	out.i = r;
	g.steps += g.n;
	out
}
@end
