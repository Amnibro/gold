code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		gold_fail(g, "empty list to search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var found = false;
	var last_idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found = true;
			last_idx = i;
		}
	}
	if !found {
		gold_fail(g, "target not found in list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target missing");
		return out;
	}
	g.steps += g.n;
	out.i = last_idx;
	out.s.clear();
	format(out.s, "found last match at ", last_idx);
	out
}
@end
