code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = g.n - 1;
	while i >= 1 {
		let tmp = g.res[i];
		g.res[i] = g.res[i - 1];
		g.res[i - 1] = tmp;
		swaps += 1;
		i -= 2;
	}
	g.steps += swaps;
	out.i = swaps;
	out.s.clear();
	format(out.s, "backward swapped ", swaps, " steps");
	out
}
@end
