expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[50,40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${from_idx};
	let t = ${to_idx};
	if f >= 0 && t < g.n && f < t {
		var i = f;
		var j = t;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		out.i = t - f + 1;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
