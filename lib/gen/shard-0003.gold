fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tail = ${count};
	var k = max_tail;
	if k > g.n { k = g.n; }
	let start = g.n - k;
	for i in k {
		g.res[i] = g.res[start + i];
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "retained ", k, " search tail items");
