fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var run_len = 1;
	var runs_found = 0;
	for i in g.n - 1 {
		if g.res[i] == g.res[i + 1] {
			run_len++;
		} else {
			gold_cache_put(g, runs_found, run_len);
			runs_found++;
			run_len = 1;
		}
	}
	gold_cache_put(g, runs_found, run_len);
	runs_found++;
	g.steps += g.n;
	out.i = runs_found;
	gold_text(out, "runs cached");
