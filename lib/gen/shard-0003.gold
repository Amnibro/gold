@entry 763deff7b9de9490
kind: step
verb: rank
noun: pairs
modifier: pairwise
context: list
phrase: rank adjacent pairs pairwise by comparison
phrase: compute pairwise relative ranks of neighbors
test: list=3,5,2,8,8
expect: => i=4 r=0.0 ok=true s="ranked 4 pairs pairwise" errors=0 n=4 res=[1,-1,1,0] cache=0 hits=0
test: list=10,4,7,3,9
expect: => i=4 r=0.0 ok=true s="ranked 4 pairs pairwise" errors=0 n=4 res=[-1,1,-1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let pairs_count = g.n - 1;
	var ranks: int[512] = [0; 512];
	for k in pairs_count {
		if g.res[k] < g.res[k + 1] {
			ranks[k] = 1;
		} else if g.res[k] > g.res[k + 1] {
			ranks[k] = -1;
		} else {
			ranks[k] = 0;
		}
	}
	for k in pairs_count {
		g.res[k] = ranks[k];
	}
	g.n = pairs_count;
	g.steps += pairs_count;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "ranked ", pairs_count, " pairs pairwise");
	out
}
@end
