fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var max_len = 1;
	var cur_len = 1;
	for i in g.n - 1 {
		if g.res[i] <= g.res[i + 1] {
			cur_len++;
			if cur_len > max_len { max_len = cur_len; }
		} else {
			cur_len = 1;
		}
	}
	g.steps += g.n;
	out.i = max_len;
	gold_text(out, "sorted run measured");
	out
}
@end
