fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept = 0;
	for k in g.n {
		let c = g.res[k];
		if c >= 32 && c <= 126 && kept < limit {
			g.res[kept] = c;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered text codes to ", kept);
	out
}
@end
@entry 3daf61a0add48a09
kind: step
verb: search
noun: primes
modifier: up_to
context: list
phrase: search prime numbers in list up to index {limit}
phrase: count primes within boundary index {limit}
slot: limit int
test: list=4,7,11,14,17 limit=3
expect: => i=2 r=0.0 ok=true s="found primes up to index bound 2" errors=0 n=5 res=[4,7,11,14,17] cache=0 hits=0
test: list=1,4,6,8,9 limit=4
expect: => i=0 r=0.0 ok=false s="found primes up to index bound 0" errors=0 n=5 res=[1,4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let bound = if lim < g.n { lim } else { g.n };
	var primes_count = 0;
	var i = 0;
	while i < bound {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			primes_count++;
		}
		i++;
	}
	out.i = primes_count;
	out.ok = primes_count > 0;
	out.s.clear();
	format(out.s, "found primes up to index bound ", primes_count);
	g.steps += bound * 2;
	out
}
@end
