test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty results" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for digit sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var tot = 0;
	for i in g.n {
		var x = abs(g.res[i]);
		while x > 0 {
			tot += x % 10;
			x /= 10;
		}
	}
	g.res[0] = tot;
	g.n = 1;
	g.steps += 1;
	out.i = tot;
	out.s.clear();
	format(out.s, "total digit sum is ", tot);
	out
}
@end
