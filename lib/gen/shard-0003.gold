	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_prime(x) {
			var dup = false;
			for j in kept {
				if g.res[j] == x { dup = true; break; }
			}
			if !dup {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "recursively deduped primes ", kept);
	g.steps += g.n;
	out
}
