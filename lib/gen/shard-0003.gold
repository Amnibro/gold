fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dropped = 0;
	var i = 0;
	var kept = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			dropped += 2;
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " pairwise sequence elements");
	g.steps += i + 1;
	out
}
