fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var gaps int[64] = [0; 64];
	let num_gaps = min(g.n - 1, 64);
	for i in num_gaps {
		gaps[i] = g.res[i + 1] - g.res[i];
	}
	var ranked_gaps int[64] = [0; 64];
	for a in num_gaps {
		var rank = 0;
		for b in num_gaps {
			if gaps[b] < gaps[a] { rank++; }
		}
		ranked_gaps[a] = rank;
	}
	gold_clear(g);
	for k in num_gaps { gold_push(g, ranked_gaps[k]); }
	out.i = num_gaps;
	g.steps += num_gaps;
	out.s.clear();
	format(out.s, "ranked gaps count ", num_gaps);
	out
}
@end
