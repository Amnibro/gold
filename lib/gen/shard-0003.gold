fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var max_diff = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		if diff > max_diff { max_diff = diff; }
		k++;
	}
	out.i = max_diff;
	g.steps += g.n;
	out
}
@end
