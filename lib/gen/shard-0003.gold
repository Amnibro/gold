expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,5,10] cache=0 hits=0
test: list=4,3 thresh=20
expect: => i=-1 r=0.0 ok=false s="" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let limit = ${thresh};
	var sum = 0;
	var found = false;
	var idx = -1;
	for k in g.n {
		sum += g.res[k];
		if sum > limit {
			found = true;
			idx = k;
			break;
		}
	}
	out.ok = found;
	out.i = idx;
	g.steps += g.n;
	out
}
@end
