expect: => i=4 r=0.0 ok=true s="clamped in reverse 4 values" errors=0 n=4 res=[3,10,20,5] cache=0 hits=0
test: list=50,15,2 lo=5 hi=30
expect: => i=3 r=0.0 ok=true s="clamped in reverse 3 values" errors=0 n=3 res=[30,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${lo};
	let max_v = ${hi};
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] < min_v {
			g.res[idx] = min_v;
		} else if g.res[idx] > max_v {
			g.res[idx] = max_v;
		}
		idx--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped in reverse ", g.n, " values");
	out
}
@end
@entry 2559346f1711397b
kind: step
verb: clamp
noun: streak
modifier: nested
context: math
phrase: clamp nested run streaks to ceiling {cap}
phrase: bound consecutive equal streaks by maximum {cap}
slot: cap int
test: list=2,2,2,2,3,3,3 cap=2
expect: => i=4 r=0.0 ok=true s="clamped streaks to 4 elements" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=5,5,5,5,5 cap=3
expect: => i=3 r=0.0 ok=true s="clamped streaks to 3 elements" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var streak_len = 0;
		while i < g.n && g.res[i] == val {
			if streak_len < limit {
				g.res[kept] = val;
				kept++;
			}
			streak_len++;
			i++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped streaks to ", kept, " elements");
	out
}
@end
@entry 957be16f533e8709
kind: step
verb: fold
noun: suffix
modifier: in_place
context: math
phrase: fold trailing suffix of {count} numbers in place
phrase: sum suffix items of size {count} directly
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=12 r=0.0 ok=true s="folded suffix to 12" errors=0 n=3 res=[1,2,12] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=70 r=0.0 ok=true s="folded suffix to 70" errors=0 n=3 res=[10,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let k = if c < g.n { c } else { g.n };
	if k <= 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	let start = g.n - k;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.res[start] = sum;
	g.n = start + 1;
	g.steps += k;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded suffix to ", sum);
	out
}
@end
@entry 5c510241b8e65d3b
kind: step
verb: dedupe
noun: threshold
modifier: up_to
context: math
phrase: dedupe elements within threshold {thresh} up to limit {cap}
phrase: filter adjacent values within distance {thresh} up to {cap}
slot: thresh int
slot: cap int
test: list=10,11,15,16,20 thresh=2 cap=3
expect: => i=2 r=0.0 ok=true s="threshold deduped 2 items" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,2,3,4,10 thresh=1 cap=2
expect: => i=2 r=0.0 ok=true s="threshold deduped 2 items" errors=0 n=3 res=[1,3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	let limit = ${cap};
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	var removed = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[kept - 1];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff <= t && removed < limit {
			removed++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "threshold deduped ", removed, " items");
	out
}
@end
