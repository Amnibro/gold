code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	let count = if slen < g.n { slen } else { g.n };
	let start = g.n - count;
	var total = 0;
	var i = start;
	while i < g.n {
		total += g.res[i];
		i += 1;
	}
	g.steps += count;
	out.i = total;
	out.s.clear();
	format(out.s, "measured suffix sum ", total, " over ", count, " items");
	out
}
@end
