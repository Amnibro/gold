fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	let start = out.i;
	var cur = start;
	while cur >= 1 && g.n < 512 {
		gold_push(g, cur);
		cur--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "counter generated ", g.n, " steps in reverse");
	out
}
@end
