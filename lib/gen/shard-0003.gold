kind: step
verb: repeat
noun: history
modifier: each
context: list
phrase: repeat historical values for each item {times} times
phrase: duplicate previous list history {times} occurrences
slot: times int
test: list=1,2,3 times=2
expect: => i=6 r=0.0 ok=true s="repeated each item 2 times to 6" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=10,20 times=3
expect: => i=6 r=0.0 ok=true s="repeated each item 3 times to 6" errors=0 n=6 res=[10,10,10,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if g.n == 0 || t <= 0 {
		out.i = 0;
		return out;
	}
	var new_res: int[512] = [0; 512];
	var new_n = 0;
	for k in g.n {
		let val = g.res[k];
		var c = 0;
		while c < t && new_n < 512 {
			new_res[new_n] = val;
			new_n++;
			c++;
		}
	}
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
