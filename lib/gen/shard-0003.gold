	if g.n == 0 {
		gold_fail(g, "empty results for cache rotation");
		out.ok = false;
		out.i = 0;
		return out;
	}
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	if g.cn > 1 {
		let last = g.cv[g.cn - 1];
		var i = g.cn - 1;
		while i > 0 { g.cv[i] = g.cv[i - 1]; i--; }
		g.cv[0] = last;
	}
	out.i = if g.cn > 0 { g.cv[0] } else { 0 };
	g.steps += g.cn;
	out
}
@end
