noun: spaces
modifier: in_reverse
context: search
phrase: repeat search interval spaces in reverse order
phrase: duplicate spacing gaps backward across search data
test: list=10,15,25
expect: => i=2 r=0.0 ok=true s="repeated 2 spaces in reverse" errors=0 n=5 res=[10,15,25,10,5] cache=0 hits=0
test: list=1,4,10,12
expect: => i=3 r=0.0 ok=true s="repeated 3 spaces in reverse" errors=0 n=7 res=[1,4,10,12,2,6,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	var gaps int[512] = [0; 512];
	let gn = g.n - 1;
	for i in gn {
		gaps[i] = g.res[i + 1] - g.res[i];
	}
	var k = gn;
	while k > 0 {
		k--;
		gold_push(g, gaps[k]);
	}
	g.steps += g.n;
	out.i = gn;
	out.s.clear();
	format(out.s, "repeated ", gn, " spaces in reverse");
	out
}
@end
@entry f9e73037acc1f5c0
kind: step
verb: search
noun: total
modifier: each
context: search
phrase: search total sum of each chunk of size {chunk}
phrase: compute block totals across windows of size {chunk}
slot: chunk int
test: list=10,20,30,40,50,60 chunk=2
expect: => i=3 r=0.0 ok=true s="computed 3 block totals" errors=0 n=3 res=[30,70,110] cache=0 hits=0
test: list=1,2,3,4,5,6,7,8 chunk=3
expect: => i=3 r=0.0 ok=true s="computed 3 block totals" errors=0 n=3 res=[6,15,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	if sz <= 0 || g.n == 0 {
		return out;
	}
	var totals int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var cur_sum = 0;
		let end = if i + sz < g.n { i + sz } else { g.n };
		var j = i;
		while j < end {
			cur_sum += g.res[j];
			j++;
		}
		totals[tn] = cur_sum;
		tn++;
		i += sz;
	}
	for k in tn {
		g.res[k] = totals[k];
	}
	g.n = tn;
	g.steps += g.n;
	out.i = tn;
	out.s.clear();
	format(out.s, "computed ", tn, " block totals");
	out
}
@end
