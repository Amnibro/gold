			kept[nk] = g.res[i];
			nk++;
		} else {
			gold_cache_put(g, c, g.res[i]);
			c++;
		}
	}
	gold_clear(g);
	for j in nk { gold_push(g, kept[j]); }
	out.i = nk;
	out
}
@end
