fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		gold_cache_put(g, i, g.res[i]);
		i++;
	}
	var j = 0;
	while j < g.n {
		let rev_idx = g.n - 1 - j;
		let v_cached, found = gold_cache_get(g, rev_idx);
		if found {
			g.res[j] = v_cached;
		}
		j++;
	}
	out.i = g.hits;
	g.steps += g.n;
	out
}
@end
