fn ${ID}(g Gold&, v Val) Val {
	let m = ${mult};
	var out = v;
	var streak = 1;
	var max_s = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[i - 1] {
			streak++;
			if streak > max_s { max_s = streak; }
		} else {
			streak = 1;
		}
		i++;
	}
	let scaled = max_s * m;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled streak: ", scaled);
	g.steps += g.n;
	out
}
@end
