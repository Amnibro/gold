@entry a8a0d4f39e55e905
kind: step
verb: scale
noun: counter
modifier: up_to
context: sort
phrase: scale counter of sort swaps up to limit {limit}
phrase: multiply sort inversion counter up to ceiling {limit}
slot: limit int
test: list=5,1,4,2 limit=10
expect: => i=8 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
test: list=9,3,7,1 limit=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				swaps++;
			}
		}
	}
	let scaled = swaps * 2;
	out.i = if scaled > lim { lim } else { scaled };
	g.steps += g.n;
	out
}
@end
