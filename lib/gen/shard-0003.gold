fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var s = 0;
	var i = 0;
	while i < g.n {
		if s + g.res[i] > th { break; }
		s += g.res[i];
		i++;
	}
	g.n = i;
	out.i = s;
	g.steps += i;
	out
}
