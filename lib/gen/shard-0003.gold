test: list=1,1,1,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,1,1,2,3] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_run = 0;
	if g.n > 0 {
		var cur_run = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
			} else {
				if cur_run > max_run { max_run = cur_run; }
				cur_run = 1;
			}
			i++;
		}
		if cur_run > max_run { max_run = cur_run; }
	}
	if max_run <= 1 {
		out.i = 0;
	} else {
		out.i = max_run;
	}
	g.steps += g.n;
	out
}
@end
@entry c69b4352a8044b76
kind: step
verb: join
noun: gaps
modifier: every_other
context: filter
phrase: insert gap fill value {gap_fill} at every other gap
phrase: join alternating gaps with filler item {gap_fill}
slot: gap_fill int
test: list=10,20,30,40 gap_fill=0
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[10,0,20,30,0,40] cache=0 hits=0
test: list=5,15,25 gap_fill=-1
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,-1,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let filler = ${gap_fill};
	if g.n > 1 {
		var temp: int[512] = [0; 512];
		var tn = 0;
		for i in g.n {
			temp[tn] = g.res[i];
			tn++;
			if i + 1 < g.n && i % 2 == 0 {
				temp[tn] = filler;
				tn++;
			}
		}
		for i in tn {
			g.res[i] = temp[i];
		}
		g.n = tn;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
