fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk};
	if sz <= 0 {
		gold_fail(g, "invalid chunk size");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid chunk");
		return out;
	}
	if out.s.len == 0 {
		gold_fail(g, "empty text to split");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty text");
		return out;
	}
	let num_chunks = (out.s.len + sz - 1) / sz;
	g.steps += out.s.len;
	out.i = num_chunks;
	out.s.clear();
	format(out.s, "split into ", num_chunks, " chunks");
	out
}
@end
