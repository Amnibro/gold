fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	var below = 0;
	for k in g.n {
		if g.res[k] < avg { below++; }
	}
	out.i = below;
	g.steps += g.n;
	out
}
@end
