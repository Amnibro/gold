code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${min_part};
	if mp <= 0 {
		gold_fail(g, "minimum part non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid minimum part");
		return out;
	}
	var tot = 0;
	for i in g.n { tot += g.res[i]; }
	if tot < mp {
		gold_fail(g, "total is less than minimum part");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: total below minimum");
		return out;
	}
	let parts = tot / mp;
	g.res[0] = parts;
	g.n = 1;
	g.steps += 1;
	out.i = parts;
	out.s.clear();
	format(out.s, "split total into ", parts, " parts");
	out
}
@end
