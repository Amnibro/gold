@entry d776c38b810f6192
kind: step
verb: drop
noun: counter
modifier: while
context: error
phrase: drop counter while below threshold {threshold}
phrase: remove initial counter items below threshold {threshold}
slot: threshold int
test: list=1,2,5,6 threshold=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,6] cache=0 hits=0
test: list=1,2,3 threshold=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var idx = 0;
	while idx < g.n && g.res[idx] < th {
		idx++;
	}
	if idx == g.n {
		gold_fail(g, "all elements dropped error");
		out.ok = false;
		g.n = 0;
	} else {
		var write_idx = 0;
		for i in g.n - idx {
			g.res[write_idx] = g.res[idx + i];
			write_idx++;
		}
		g.n = write_idx;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
