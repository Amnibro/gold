fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var clamped = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > limit {
				gold_cache_put(g, i, limit);
				g.res[i] = g.res[i - 1] + limit;
				clamped++;
			} else {
				gold_cache_put(g, i, diff);
			}
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " spacing gaps");
	out
}
