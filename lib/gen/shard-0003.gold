fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_nums int[64] = [0; 64];
	var u_count = 0;
	var u_sum = 0;
	for idx in g.n {
		let val = g.res[idx];
		var seen = false;
		for k in u_count {
			if unique_nums[k] == val { seen = true; break; }
		}
		if !seen {
			if u_count < 64 { unique_nums[u_count] = val; u_count++; }
			u_sum += val;
		}
	}
	gold_clear(g);
	for a in u_count { gold_push(g, unique_nums[a]); }
	out.i = u_sum;
	g.steps += u_sum;
	out.s.clear();
	format(out.s, "unique numbers sum ", u_sum);
	out
}
@end
