fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${amount};
	if g.n == 0 {
		return out;
	}
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	let share = b / g.n;
	for i in g.n {
		g.res[i] += share;
	}
	g.steps += g.n;
	out.i = share;
	gold_text(out, "budget added");
