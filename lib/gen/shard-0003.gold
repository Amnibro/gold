@entry dfe2b2090ba7b505
kind: step
verb: swap
noun: history
modifier: recursively
context: cache
phrase: swap history recursively up to depth {depth}
phrase: invert cache history recursively for depth {depth}
slot: depth int
test: list=1,2,3,4 depth=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=4 hits=0
test: list=10,20,30 depth=1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var swaps = 0;
	var step = 0;
	while step < d && step < g.cn / 2 {
		let tmp = g.cv[step];
		g.cv[step] = g.cv[g.cn - 1 - step];
		g.cv[g.cn - 1 - step] = tmp;
		swaps++;
		step++;
	}
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
