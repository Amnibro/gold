	let t = ${times};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	var added = 0;
	while added < t && g.n < 512 {
		gold_push(g, min_val);
		added++;
	}
	g.steps += g.n + added;
	out.i = added;
	out.s.clear();
	format(out.s, "safely repeated minimum ", min_val, " ", added, " times");
	out
}
