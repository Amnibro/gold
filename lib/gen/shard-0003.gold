test: list=5,1,8,2,9 limit=4
expect: => i=4 r=0.0 ok=true s="reverse sorted 4 entries" errors=0 n=5 res=[8,5,2,1,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < g.n { lim } else { g.n };
	if count > 1 {
		var i = 0;
		while i < count {
			var max_k = i;
			var j = i + 1;
			while j < count {
				if g.res[j] > g.res[max_k] { max_k = j; }
				j += 1;
			}
			let tmp = g.res[i];
			g.res[i] = g.res[max_k];
			g.res[max_k] = tmp;
			i += 1;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "reverse sorted ", count, " entries");
	out
}
@end
