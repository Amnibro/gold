fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_k = ${key};
	let val, ok = gold_cache_get(g, target_k);
	if ok && g.n < 512 {
		g.res[g.n] = val;
		g.n += 1;
		out.i = val;
		out.ok = true;
		out.s.clear();
		format(out.s, "found cached entry ", val);
	} else {
		out.i = 0;
		out.ok = false;
		out.s.clear();
		format(out.s, "cache key not found");
	}
	g.steps += 1;
	out
}
@end
