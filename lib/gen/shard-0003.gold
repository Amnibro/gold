@entry e647ef32bb169a90
kind: step
verb: dedupe
noun: head
modifier: up_to
context: compare
phrase: dedupe head elements up to limit
phrase: remove duplicate prefix items up to count
test: list=2,2,3,3,4,4,5 input=4
expect: => i=2 r=0.0 ok=true s="head unique items 2" errors=0 n=5 res=[2,3,4,4,5] cache=0 hits=0
test: list=7,7,7,8,9 input=3
expect: => i=1 r=0.0 ok=true s="head unique items 1" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = min(v.i, g.n);
	var seen_head int[64] = [0; 64];
	var head_len = 0;
	var w = 0;
	for r in limit {
		let item = g.res[r];
		var already = false;
		for h in head_len {
			if seen_head[h] == item { already = true; break; }
		}
		if !already {
			if head_len < 64 { seen_head[head_len] = item; head_len++; }
			g.res[w] = item;
			w++;
		}
	}
	var tail_start = limit;
	while tail_start < g.n {
		g.res[w] = g.res[tail_start];
		w++;
		tail_start++;
	}
	g.n = w;
	out.i = head_len;
	g.steps += head_len;
	out.s.clear();
	format(out.s, "head unique items ", head_len);
	out
}
@end
