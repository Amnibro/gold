code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var dup_count = 0;
	for i in g.n {
		var is_dup = false;
		if i > 0 && g.res[i] == g.res[i - 1] { is_dup = true; }
		if i + 1 < g.n && g.res[i] == g.res[i + 1] { is_dup = true; }
		if is_dup {
			g.res[i] *= f;
			dup_count++;
		}
	}
	g.steps += g.n;
	out.i = dup_count;
	gold_text(out, "duplicates scaled");
	out
}
@end
