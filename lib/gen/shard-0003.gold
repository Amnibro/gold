fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let orig = g.n;
	if orig > 0 {
		while g.n < lim && g.n < 512 {
			let src_idx = (g.n - orig) % orig;
			gold_push(g, g.res[src_idx]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated up to limit ", g.n);
	out
}
@end
