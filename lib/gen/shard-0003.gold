expect: => i=4 r=0.0 ok=true s="clamped sorted count 4" errors=0 n=4 res=[20,30,80,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${lo};
	let max_v = ${hi};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for k in g.n {
		if g.res[k] < min_v {
			g.res[k] = min_v;
		} else if g.res[k] > max_v {
			g.res[k] = max_v;
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "clamped sorted count ", g.n);
	out
}
@end
@entry 9dbc39c558d24dbe
kind: step
verb: repeat
noun: spaces
modifier: while
context: math
phrase: repeat space intervals while difference exceeds {min_gap}
phrase: insert gap intervals while span exceeds {min_gap}
slot: min_gap int
test: list=1,10,20 min_gap=5
expect: => i=2 r=0.0 ok=true s="inserted space gaps 2" errors=0 n=5 res=[1,5,10,15,20] cache=0 hits=0
test: list=2,15 min_gap=4
expect: => i=1 r=0.0 ok=true s="inserted space gaps 1" errors=0 n=3 res=[2,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var new_res: int[512] = [0; 512];
	var new_n = 0;
	var insertions = 0;
	for k in g.n - 1 {
		new_res[new_n] = g.res[k];
		new_n++;
		let diff = g.res[k + 1] - g.res[k];
		if diff > mg && new_n < 510 {
			new_res[new_n] = g.res[k] + diff / 2;
			new_n++;
			insertions++;
		}
	}
	new_res[new_n] = g.res[g.n - 1];
	new_n++;
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = insertions;
	out.s.clear();
	format(out.s, "inserted space gaps ", insertions);
	out
}
@end
