code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
		i++;
	}
	let span = mx - mn;
	out.i = span;
	out.s.clear();
	format(out.s, "range span: ", span);
	g.steps += g.n;
	out
}
@end
