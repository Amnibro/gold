code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	gold_cache_put(g, g.n, max_val);
	var kept = 0;
	for i in g.n {
		if g.res[i] == max_val {
			g.res[kept] = max_val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = max_val;
	out.s.clear();
	format(out.s, "filtered to peak value ", max_val);
	out
}
@end
