@entry bcc581adbca2a3dd
kind: step
verb: rotate
noun: primes
modifier: nested
context: search
phrase: rotate prime search elements cyclically in list
phrase: cyclic shift prime values within search results
test: list=4,3,6,5,8,7
expect: => i=3 r=0.0 ok=true s="rotated 3 prime items" errors=0 n=6 res=[4,7,6,3,8,5] cache=0 hits=0
test: list=10,2,15,11,20,13
expect: => i=3 r=0.0 ok=true s="rotated 3 prime items" errors=0 n=6 res=[10,13,15,2,20,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_pos int[512] = [0; 512];
	var p_vals int[512] = [0; 512];
	var pn = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			p_pos[pn] = i;
			p_vals[pn] = x;
			pn++;
		}
	}
	if pn >= 2 {
		for i in pn {
			let next_val = p_vals[(i + pn - 1) % pn];
			g.res[p_pos[i]] = next_val;
		}
	}
	g.steps += g.n * 2;
	out.i = pn;
	out.s.clear();
	format(out.s, "rotated ", pn, " prime items");
	out
}
@end
