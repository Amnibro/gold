code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if g.n > 1 {
		var new_n = g.n - 1;
		for i in new_n {
			var diff = g.res[i + 1] - g.res[i];
			if diff < lo { diff = lo; }
			if diff > hi { diff = hi; }
			g.res[i] = diff;
		}
		g.n = new_n;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
