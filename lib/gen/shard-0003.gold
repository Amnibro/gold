@entry 086652b9c7bef8e2
kind: step
verb: drop
noun: primes
modifier: in_reverse
context: cache
phrase: drop prime values in reverse updating cache
phrase: filter reverse primes caching count
test: list=4,7,8,11,12
expect: => i=2 r=0.0 ok=true s="primes dropped to cache" errors=0 n=3 res=[4,8,12] cache=2 hits=0
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="primes dropped to cache" errors=0 n=2 res=[4,6] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var primes_dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_cache_put(g, primes_dropped, x);
			primes_dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = primes_dropped;
	gold_text(out, "primes dropped to cache");
	out
}
@end
