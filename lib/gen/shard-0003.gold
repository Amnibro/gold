@entry fdc575db26839fb1
kind: step
verb: filter
noun: errors
modifier: pairwise
context: cache
phrase: cache pairwise differences exceeding error bound {tol}
phrase: record adjacent gaps above tolerance {tol} in memo
slot: tol int
test: list=10,25,30,50 tol=10
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,25,30,50] cache=2 hits=0
test: list=2,4,6 tol=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tolerance = ${tol};
	var count = 0;
	var k = 0;
	while k + 1 < g.n {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		if diff > tolerance {
			gold_cache_put(g, k, diff);
			count++;
		}
		k++;
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
@entry 53c861a6dc001631
kind: step
verb: repeat
noun: checkpoint
modifier: running
context: cache
phrase: cache running total at checkpoint interval {step}
phrase: record cumulative sum at checkpoint step {step}
slot: step int
test: list=2,4,6,8,10 step=2
