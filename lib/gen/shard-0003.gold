code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n && g.res[idx] == 0 {
		idx++;
	}
	let dropped = idx;
	var kept = 0;
	while idx < g.n {
		g.res[kept] = g.res[idx];
		kept++;
		idx++;
	}
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " leading items in loop");
	g.steps += dropped + 1;
	out
}
@end
