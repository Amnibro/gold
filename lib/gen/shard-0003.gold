				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let f = ${factor};
	let limit = ${cap};
	for k in g.n {
		var v = g.res[k] * f;
		if v > limit { v = limit; }
		g.res[k] = v;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
