		let b = g.res[i * 2 + 1];
		g.res[i] = (a + b) * factor;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " streak items");
	out
}
@end
