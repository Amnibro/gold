code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${min_val};
	var primes = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= floor && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	if primes == 0 {
		gold_fail(g, "no primes found meeting threshold");
		out.ok = false;
		out.i = 0;
		return out;
	}
	out.i = primes;
	g.steps += g.n;
	out
}
@end
