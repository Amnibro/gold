fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty window results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty window");
		return out;
	}
	gold_cache_put(g, 0, g.res[0]);
	gold_cache_put(g, 1, g.res[g.n - 1]);
	g.steps += g.n;
	out.i = g.res[g.n - 1] - g.res[0];
	out.s.clear();
	format(out.s, "cached window bounds");
	out
}
