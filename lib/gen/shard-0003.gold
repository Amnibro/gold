expect: => i=3 r=0.0 ok=true s="applied digit sums safely" errors=0 n=3 res=[6,10,7] cache=0 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty results" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no items for digit calculation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	for i in g.n {
		var x = abs(g.res[i]);
		var sum = 0;
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
		g.res[i] = sum;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied digit sums safely");
	out
}
@end
