fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	var odds = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			g.res[k] = g.res[k] * fac * (odds + 1);
			odds++;
		}
	}
	out.i = odds;
	g.steps += g.n;
	out
}
@end
