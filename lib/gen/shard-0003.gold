fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i] * 3);
	}
	gold_clear(g);
	for i in g.cn {
		let val, ok = gold_cache_get(g, i);
		if ok {
			gold_push(g, val);
		}
	}
	g.steps += g.cn;
	out.i = g.n;
	gold_text(out, "cache split into results");
	out
}
@end
