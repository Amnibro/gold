@entry 5e1f733ee3b7cd10
kind: step
verb: sort
noun: squares
modifier: until
context: sort
phrase: sort square values until threshold {cap}
phrase: order perfect squares bounded by {cap}
slot: cap int
test: list=16,7,4,25,9 cap=20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=36,49 cap=40
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var kept int[512] = [0; 512];
	var kn = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 && x <= limit {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				kept[kn] = x;
				kn++;
			}
		}
	}
	var i = 0;
	while i < kn {
		var j = i + 1;
		while j < kn {
			if kept[i] > kept[j] {
				let tmp = kept[i];
				kept[i] = kept[j];
				kept[j] = tmp;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
