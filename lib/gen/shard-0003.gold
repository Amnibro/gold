	out.i = last_idx;
	out.ok = last_idx >= 0;
	out.s.clear();
	format(out.s, "last occurrence found at ", last_idx);
	g.steps += g.n - i;
	out
}
@end
@entry 6adf4e74fba2387a
kind: step
verb: dedupe
noun: gaps
modifier: recursively
context: list
phrase: dedupe repeated gap differences recursively across list
phrase: filter adjacent interval gaps recursively
test: list=1,3,5,10,15
expect: => i=2 r=0.0 ok=true s="recursively deduped gaps to 2" errors=0 n=2 res=[2,5] cache=0 hits=0
test: list=2,4,6,8,12
expect: => i=2 r=0.0 ok=true s="recursively deduped gaps to 2" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps: int[512] = [0; 512];
	let gap_count = g.n - 1;
	for k in gap_count {
		gaps[k] = g.res[k + 1] - g.res[k];
	}
	var kept_gaps = 1;
	var i = 1;
	while i < gap_count {
		if gaps[i] != gaps[kept_gaps - 1] {
			gaps[kept_gaps] = gaps[i];
			kept_gaps++;
		}
		i++;
	}
	for k in kept_gaps {
		g.res[k] = gaps[k];
	}
	g.n = kept_gaps;
	g.steps += gap_count * 2;
	out.i = kept_gaps;
	out.s.clear();
	format(out.s, "recursively deduped gaps to ", kept_gaps);
	out
}
@end
@entry dd1dad3057a3261b
kind: step
verb: rotate
noun: sequence
modifier: with_cache
context: list
phrase: rotate sequence cyclically recording state in cache by {shift}
phrase: shift list elements with cache update by {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=4 r=0.0 ok=true s="rotated sequence and cached 4 items" errors=0 n=4 res=[40,10,20,30] cache=4 hits=0
test: list=1,2,3,4,5 shift=2
expect: => i=5 r=0.0 ok=true s="rotated sequence and cached 5 items" errors=0 n=5 res=[4,5,1,2,3] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		let actual_s = s % g.n;
		for step in actual_s {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated sequence and cached ", g.n, " items");
	out
}
@end
