code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let half = g.n / 2;
	for i in half {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in count {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[count] = x;
			count += 1;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed into ", count, " unique search items");
	out
}
@end
