kind: step
verb: find
noun: number
modifier: at_most
context: search
phrase: find search number at most target {cap}
phrase: locate largest observation bounded by {cap}
slot: cap int
test: list=10,25,50,40,15 cap=30
expect: => i=25 r=0.0 ok=true s="found best number 25 at most 30" errors=0 n=5 res=[10,25,50,40,15] cache=0 hits=0
test: list=100,200,150,80 cap=120
expect: => i=100 r=0.0 ok=true s="found best number 100 at most 120" errors=0 n=4 res=[100,200,150,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var found = false;
	var best = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= ceiling {
			if !found || x > best {
				best = x;
				found = true;
			}
		}
	}
	g.steps += g.n;
	out.i = best;
	out.ok = found;
	out.s.clear();
	format(out.s, "found best number ", best, " at most ", ceiling);
	out
}
@end
