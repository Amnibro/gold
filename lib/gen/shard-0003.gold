code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	if g.n == 0 {
		gold_fail(g, "empty list error");
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	if max_val >= ceil {
		gold_fail(g, "maximum reaches ceiling error");
		out.ok = false;
	} else {
		gold_push(g, max_val + 1);
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
