code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let window = min(max(2, v.i), g.n);
	let start = g.n - window;
	let first_elem = g.res[start];
	var p = start;
	while p + 1 < g.n {
		g.res[p] = g.res[p + 1];
		p++;
	}
	g.res[g.n - 1] = first_elem;
	out.i = window;
	g.steps += window;
	out.s.clear();
	format(out.s, "left rotated tail window ", window);
	out
}
@end
