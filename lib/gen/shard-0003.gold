noun: errors
modifier: unique
context: math
phrase: dedupe negative error codes to unique set
phrase: filter unique error indicators from results
test: list=-1,-2,-1,-3,-2
expect: => i=3 r=0.0 ok=true s="unique errors kept 3" errors=0 n=3 res=[-1,-2,-3] cache=0 hits=0
test: list=-5,-10,-5,-20
expect: => i=3 r=0.0 ok=true s="unique errors kept 3" errors=0 n=3 res=[-5,-10,-20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x < 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique errors kept ", kept);
	out
}
@end
