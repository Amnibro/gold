@entry b543c25b5c061e5e
kind: step
verb: join
noun: loop
modifier: each
context: list
phrase: join loop segments of size {step} each
phrase: combine sequence chunks of length {step} iteratively
slot: step int
test: list=1,2,3,4,5,6 step=2
expect: => i=3 r=0.0 ok=true s="joined loop into 3 chunk sums" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40,50 step=3
expect: => i=2 r=0.0 ok=true s="joined loop into 2 chunk sums" errors=0 n=2 res=[60,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${step};
	if sz <= 0 || g.n == 0 {
		out.i = 0;
		return out;
	}
	var new_res: int[512] = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var chunk_sum = 0;
		var c = 0;
		while c < sz && i < g.n {
			chunk_sum += g.res[i];
			c++;
			i++;
		}
		new_res[new_n] = chunk_sum;
		new_n++;
	}
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	g.steps += g.n * 2;
	out.i = new_n;
	out.s.clear();
	format(out.s, "joined loop into ", new_n, " chunk sums");
	out
}
@end
