test: list=10,20,30,40,50 count=2
expect: => i=2 r=0.0 ok=true s="series split" errors=0 n=2 res=[40,50] cache=0 hits=0
test: list=1,2,3,4 count=3
expect: => i=3 r=0.0 ok=true s="series split" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let start = if c < g.n { g.n - c } else { 0 };
	let num = g.n - start;
	for i in num {
		g.res[i] = g.res[start + i];
	}
	g.n = num;
	g.steps += num;
	out.i = num;
	gold_text(out, "series split");
	out
}
@end
