fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var sum = 0;
	var i = 0;
	while i < g.n {
		sum += g.res[i];
		let avg = sum / (i + 1);
		if avg > limit { break; }
		i++;
	}
	g.n = i;
	out.i = i;
	out.s.clear();
	format(out.s, "filtered average count ", i);
	g.steps += g.n;
	out
}
@end
