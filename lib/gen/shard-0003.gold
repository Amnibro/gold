phrase: remove search prefix until finding jump larger than {min_gap}
slot: min_gap int
test: list=10,12,14,25,30 min_gap=5
expect: => i=2 r=0.0 ok=true s="dropped 2 items before qualifying gap" errors=0 n=3 res=[14,25,30] cache=0 hits=0
test: list=1,2,3,10,12 min_gap=4
expect: => i=2 r=0.0 ok=true s="dropped 2 items before qualifying gap" errors=0 n=3 res=[3,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_gap = ${min_gap};
	var cut = 0;
	if g.n >= 2 {
		while cut < g.n - 1 {
			let gap = g.res[cut + 1] - g.res[cut];
			let abs_gap = if gap < 0 { -gap } else { gap };
			if abs_gap > target_gap {
				break;
			}
			cut++;
		}
	}
	var kept = 0;
	for i in cut..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = cut;
	out.s.clear();
	format(out.s, "dropped ", cut, " items before qualifying gap");
	out
}
@end
