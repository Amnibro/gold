fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var steps_to_chk = 0;
	var found = false;
	for k in g.n {
		steps_to_chk++;
		if g.res[k] == tgt {
			found = true;
			break;
		}
	}
	out.ok = found;
	out.i = steps_to_chk;
	out.s.clear();
	if found {
		format(out.s, "reached checkpoint in ", steps_to_chk, " steps");
	} else {
		format(out.s, "checkpoint not found after ", steps_to_chk, " steps");
	}
	g.steps += steps_to_chk;
	out
}
@end
