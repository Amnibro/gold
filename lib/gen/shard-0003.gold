code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_prime = false;
					break;
				}
				d++;
			}
			if is_prime {
				gold_cache_put(g, x, 1);
				prime_count++;
			}
		}
	}
	out.i = prime_count;
	out.ok = prime_count > 0;
	g.steps += g.n;
	out
}
@end
