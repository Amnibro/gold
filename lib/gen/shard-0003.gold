fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var write_idx = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if i < lim {
			if x % 2 != 0 {
				g.res[write_idx] = x;
				write_idx += 1;
				kept += 1;
			}
		} else {
			g.res[write_idx] = x;
			write_idx += 1;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " odd values from first ", lim);
	out
}
