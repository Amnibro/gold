fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	let first = g.res[0];
	var max_rest = g.res[1];
	for i in 1..g.n {
		if g.res[i] > max_rest {
			max_rest = g.res[i];
		}
	}
	let diff = first - max_rest;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "difference between head and max remaining is ", diff);
	out
}
@end
@entry f687804013076692
kind: step
verb: find
noun: minimum
modifier: each
context: stats
phrase: find minimum of each consecutive block of size {w}
phrase: compute block minimum across chunks of size {w}
slot: w int
test: list=10,5,20,8,15,3 w=2
expect: => i=3 r=0.0 ok=true s="computed 3 block minimums" errors=0 n=3 res=[5,8,3] cache=0 hits=0
test: list=30,12,45,20,15,50 w=3
expect: => i=2 r=0.0 ok=true s="computed 2 block minimums" errors=0 n=2 res=[12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let width = ${w};
	if width <= 0 || g.n == 0 {
		return out;
	}
	var out_n = 0;
	var i = 0;
	while i < g.n {
		var block_min = g.res[i];
		let end = if i + width < g.n { i + width } else { g.n };
		var j = i;
		while j < end {
			if g.res[j] < block_min {
				block_min = g.res[j];
			}
			j++;
		}
		g.res[out_n] = block_min;
		out_n++;
		i += width;
	}
	g.n = out_n;
	g.steps += g.n;
	out.i = out_n;
	out.s.clear();
	format(out.s, "computed ", out_n, " block minimums");
	out
}
@end
@entry f1ab7675ffa1a436
kind: step
verb: select
noun: budget
modifier: up_to
context: stats
phrase: select smallest observations within total budget {budget}
phrase: choose lowest values fitting under budget {budget}
slot: budget int
test: list=30,10,20,5,40 budget=40
expect: => i=35 r=0.0 ok=true s="selected 3 items total sum 35" errors=0 n=3 res=[5,10,20] cache=0 hits=0
test: list=25,15,50,10 budget=30
expect: => i=25 r=0.0 ok=true s="selected 2 items total sum 25" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	if g.n >= 2 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	var sum = 0;
	var kept = 0;
	for i in g.n {
		if sum + g.res[i] > b {
			break;
		}
		sum += g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "selected ", kept, " items total sum ", sum);
	out
}
@end
