@entry 4c9652a834bd0f2f
kind: step
verb: sort
noun: head
modifier: with_retry
context: format
phrase: sort head elements with retry passes {passes}
phrase: order leading items using retry passes {passes}
slot: passes int
test: list=9,3,7,1,5 passes=2
expect: => i=4 r=0.0 ok=true s="sorted head of 4" errors=0 n=5 res=[3,1,7,9,5] cache=0 hits=0
test: list=4,2,8,1 passes=1
expect: => i=4 r=0.0 ok=true s="sorted head of 4" errors=0 n=4 res=[2,4,1,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	let bound = if g.n < 4 { g.n } else { 4 };
	for pass in p {
		var i = 0;
		while i + 1 < bound {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
			}
			i++;
		}
	}
	out.i = bound;
	out.s.clear();
	format(out.s, "sorted head of ", bound);
	g.steps += bound;
	out
}
@end
