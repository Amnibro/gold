@entry 8e16989780948c9d
kind: step
verb: count
noun: memo
modifier: at_least
context: stats
phrase: count memo entries with frequency at least {min_hits}
phrase: evaluate elements appearing at least {min_hits} times
phrase: tally repeated memo numbers meeting {min_hits}
slot: min_hits int
test: list=4,4,4,7,7,9 min_hits=3
expect: => i=1 r=0.0 ok=true s="counted 1 items meeting min hits" errors=0 n=6 res=[4,4,4,7,7,9] cache=0 hits=0
test: list=2,2,3,3,5 min_hits=2
expect: => i=2 r=0.0 ok=true s="counted 2 items meeting min hits" errors=0 n=5 res=[2,2,3,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_hits = ${min_hits};
	var qual = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; }
		}
		if !seen_before {
			var tally = 0;
			for k in g.n {
				if g.res[k] == x { tally += 1; }
			}
			if tally >= floor_hits {
				qual += 1;
			}
		}
	}
	g.steps += g.n;
	out.i = qual;
	out.s.clear();
	format(out.s, "counted ", qual, " items meeting min hits");
	out
}
@end
