slot: ceiling int
test: list=10,15,18 floor=1 ceiling=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[10,15,18] cache=0 hits=0
test: list=10,30 floor=1 ceiling=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let cl = ${ceiling};
	var valid = true;
	for i in g.n - 1 {
		let delta = g.res[i + 1] - g.res[i];
		if delta < fl || delta > cl {
			valid = false;
			gold_fail(g, "step delta out of bounds error");
		}
	}
	if !valid {
		out.ok = false;
	}
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
