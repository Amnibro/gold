	if g.n == 0 {
		gold_fail(g, "cannot shift empty results error");
		out.ok = false;
		out.i = 0;
		return out;
	}
	let last = g.res[g.n - 1];
	for i in g.n - 1 {
		let idx = g.n - 1 - i;
		g.res[idx] = g.res[idx - 1];
	}
	g.res[0] = last;
	out.i = g.n;
	g.steps += g.n;
	out
}
