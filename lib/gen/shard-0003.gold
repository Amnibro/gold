@entry 4095deaf855aea75
kind: step
verb: filter
noun: suffix
modifier: running
context: format
phrase: filter suffix elements keeping running sum below {max_sum}
phrase: retain trailing items while running sum under {max_sum}
slot: max_sum int
test: list=10,20,5,15 max_sum=25
expect: => i=2 r=0.0 ok=true s="suffix count 2" errors=0 n=2 res=[5,15] cache=0 hits=0
test: list=2,4,6,8 max_sum=15
expect: => i=2 r=0.0 ok=true s="suffix count 2" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_sum};
	var sum = 0;
	var count = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if sum + g.res[i] > cap { break; }
		sum += g.res[i];
		count++;
	}
	let start = g.n - count;
	for k in count { g.res[k] = g.res[start + k]; }
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "suffix count ", count);
	g.steps += g.n;
	out
}
@end
