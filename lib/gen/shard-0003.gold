	if g.n > 1 {
		let first_val = g.res[0];
		for k in 1..g.n {
			g.res[k - 1] = g.res[k];
		}
		g.res[g.n - 1] = first_val;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "cyclically shifted ", g.n, " retry results");
	g.steps += g.n;
	out
}
@end
