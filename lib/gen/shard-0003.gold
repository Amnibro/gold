code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var count = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			break;
		}
		g.res[i] -= max_val;
		count++;
	}
	g.steps += g.n * 2;
	out.i = max_val;
	out.s.clear();
	format(out.s, "normalized ", count, " items relative to max ", max_val);
	out
}
@end
