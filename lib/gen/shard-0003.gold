test: list=9,1,5,3,7 f=double
expect: => i=10 r=0.0 ok=true s="" errors=0 n=5 res=[1,3,10,7,9] cache=0 hits=0
test: list=10,2,4,8,6 f=square
expect: => i=36 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,36,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var j = 0;
		while j + 1 < g.n - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	if g.n >= 3 {
		let mid = g.n / 2;
		g.res[mid] = ${f}(g.res[mid]);
		out.i = g.res[mid];
	} else {
		out.i = 0;
	}
	g.steps += g.n * g.n;
	out
}
@end
@entry 221b82a264f3105f
kind: step
verb: reverse
noun: function
modifier: up_to
context: filter
phrase: reverse first slice up to {limit} items transformed by {f}
phrase: apply function {f} reversing sequence up to {limit} elements
slot: f fn
slot: limit int
test: list=1,2,3,4,5 f=double limit=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[6,4,2,4,5] cache=0 hits=0
