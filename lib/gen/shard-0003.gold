fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p1 = 0;
	var p2 = g.n - 1;
	while p1 < p2 {
		let swap_v = g.res[p1];
		g.res[p1] = g.res[p2];
		g.res[p2] = swap_v;
		p1++;
		p2--;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
