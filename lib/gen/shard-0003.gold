fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	let baseline = g.res[0];
	var total_diff = 0;
	for idx in g.n {
		let diff = if g.res[idx] >= baseline { g.res[idx] - baseline } else { baseline - g.res[idx] };
		g.res[idx] = diff;
		total_diff += diff;
	}
	out.i = total_diff;
	g.steps += total_diff;
	out.s.clear();
	format(out.s, "total delta to first ", total_diff);
	out
}
@end
