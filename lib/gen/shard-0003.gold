fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var processed = 0;
	if g.n > 1 {
		var idx = g.n - 1;
		while idx > 0 && processed < cap {
			let diff = g.res[idx] - g.res[idx - 1];
			gold_cache_put(g, idx, diff);
			processed++;
			idx--;
		}
	}
	g.steps += processed;
	out.i = processed;
	out.s.clear();
	format(out.s, "limited tail pairwise to ", processed);
	out
}
@end
