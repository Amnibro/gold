code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if g.n < lim { g.n } else { lim };
	if count > 1 {
		var i = 0;
		var j = count - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	for k in count {
		g.res[k] = ${f}(g.res[k]);
	}
	out.i = count;
	g.steps += count;
	out
}
@end
@entry 180385854428fde7
kind: step
