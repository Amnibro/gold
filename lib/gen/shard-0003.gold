@entry 22eb9049ae5fc2f7
kind: step
verb: validate
noun: gaps
modifier: between
context: cache
phrase: validate cache key gaps within bounds {lo} through {hi}
phrase: verify interval between cached entries within {lo} through {hi}
slot: lo int
slot: hi int
test: list=10,20,30 lo=5 hi=15
