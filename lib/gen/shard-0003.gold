expect: => i=3 r=0.0 ok=true s="sorted sequence span is 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var max_scan = if lim < g.n { lim } else { g.n };
	var sorted_len = if max_scan > 0 { 1 } else { 0 };
	var i = 1;
	while i < max_scan {
		if g.res[i] >= g.res[i - 1] {
			sorted_len += 1;
		} else {
			break;
		}
		i += 1;
	}
	g.steps += max_scan;
	out.i = sorted_len;
	out.s.clear();
	format(out.s, "sorted sequence span is ", sorted_len);
	out
}
@end
