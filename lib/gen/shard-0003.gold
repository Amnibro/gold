@entry 9c572b7ce48b1fd7
kind: pred
verb: filter
noun: primes
modifier: pairwise
context: text
phrase: character code is prime number
phrase: ASCII value has prime factor property
test: arg=7,9
expect: true
expect: false
test: arg=11,13
expect: true
expect: true
code:
fn ${ID}(n int) bool {
	let p = n;
	if p <= 1 || p == 4 || p == 6 || p == 8 || p == 9 || p == 10 {
		return false;
	}
	if p == 2 || p == 3 || p == 5 || p == 7 {
		return true;
	}
	var k = 2;
	var is_prime = true;
	while k * k <= p {
		if p % k == 0 {
			is_prime = false;
			break;
		}
		k++;
	}
	is_prime
}
@end
