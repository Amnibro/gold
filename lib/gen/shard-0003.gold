fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens += 1;
		}
	}
	if evens > ceiling {
		evens = ceiling;
	}
	g.steps += g.n;
	out.i = evens;
	out.s.clear();
	format(out.s, "measured ", evens, " even search items");
	out
}
@end
