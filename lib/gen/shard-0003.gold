fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "streak limit non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results for streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var streak = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			streak++;
			if streak == lim { break; }
		} else {
			break;
		}
	}
	g.steps += streak;
	out.i = streak;
	out.s.clear();
	format(out.s, "found streak of ", streak);
	out
}
