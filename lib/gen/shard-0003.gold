@entry 138ed2fd6d6cbf1e
kind: step
verb: dedupe
noun: odds
modifier: every_other
context: list
phrase: dedupe alternate odd numbers across results
phrase: filter duplicate odd values in every other position
test: list=1,2,1,4,3,6
expect: => i=1 r=0.0 ok=true s="deduped odd values removed 1" errors=0 n=5 res=[1,2,4,3,6] cache=0 hits=0
test: list=3,5,3,7,5,9
expect: => i=2 r=0.0 ok=true s="deduped odd values removed 2" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 != 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n * 2;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped odd values removed ", removed);
	out
}
@end
