expect: => i=3 r=0.0 ok=true s="recursive binary search index 3" errors=0 n=6 res=[10,20,30,40,50,60] cache=0 hits=0
test: list=1,3,5,7,9 input=6
expect: => i=-1 r=0.0 ok=false s="recursive binary search index -1" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let needle = v.i;
	var lo = 0;
	var hi = g.n - 1;
	var found_idx = -1;
	var compares = 0;
	while lo <= hi {
		compares++;
		let mid = (lo + hi) / 2;
		let val = g.res[mid];
		if val == needle {
			found_idx = mid;
			break;
		} else if val < needle {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	g.steps += compares;
	out.s.clear();
	format(out.s, "recursive binary search index ", found_idx);
	out
}
@end
