@entry b96e741b64adcd5b
kind: step
verb: shift
noun: text
modifier: unique
context: error
phrase: shift text unique characters flagging duplicates
phrase: rotate unique characters checking duplicate errors
test: list=1 text="abcdef"
expect: => i=6 r=0.0 ok=true s="bcdefa" errors=0 n=1 res=[1] cache=0 hits=0
test: list=1 text="banana"
expect: => i=6 r=0.0 ok=false s="banana" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dup = false;
	for i in out.s.len {
		for j in out.s.len - 1 - i {
			let idx = i + 1 + j;
			if out.s[i] == out.s[idx] {
				has_dup = true;
			}
		}
	}
	if has_dup {
		gold_fail(g, "duplicate character error");
		out.ok = false;
	} else {
		if out.s.len > 1 {
			let first = out.s[0];
			for i in out.s.len - 1 {
				out.s[i] = out.s[i + 1];
			}
			out.s[out.s.len - 1] = first;
		}
	}
	out.i = out.s.len;
	g.steps += out.s.len;
	out
}
@end
