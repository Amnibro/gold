@entry 638cc270ac91c665
kind: step
verb: rank
noun: cache
modifier: any
context: stats
phrase: rank any series items by cache values
phrase: score observations using cached frequencies
test: list=10,20,10,30
expect: => i=5 r=0.0 ok=true s="scored series with total rank 5" errors=0 n=4 res=[1,1,2,1] cache=3 hits=1
test: list=5,5,8,9
expect: => i=5 r=0.0 ok=true s="scored series with total rank 5" errors=0 n=4 res=[1,2,1,1] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_score = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		let score = if ok { cached + 1 } else { 1 };
		gold_cache_put(g, x, score);
		g.res[i] = score;
		total_score += score;
	}
	g.steps += g.n;
	out.i = total_score;
	out.s.clear();
	format(out.s, "scored series with total rank ", total_score);
	out
}
@end
