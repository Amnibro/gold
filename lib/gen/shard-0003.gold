code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, g.res[i], i);
	}
	let cap = ${max_count};
	if g.cn > cap {
		let excess = g.cn - cap;
		g.cn = cap;
		out.i = excess;
	} else {
		out.i = 0;
	}
	g.steps += g.cn + g.n;
	out.s.clear();
	format(out.s, "limited cache storage to ", g.cn);
	out
}
@end
