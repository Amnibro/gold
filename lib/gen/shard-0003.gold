@entry d8c2642e1db71101
kind: step
verb: check
noun: counter
modifier: with_retry
context: filter
phrase: check filter counter with retry attempts {retries} for {target}
phrase: evaluate filter count using retry allowance {retries} seeking {target} matches
slot: target int
slot: retries int
test: list=12,15,3,8,20 target=2 retries=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[12,15,3,8,20] cache=0 hits=0
test: list=2,4,6 target=4 retries=2
expect: => i=1 r=0.0 ok=false s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var r = 0;
	var count = 0;
	var th = 10;
	while r < max_r {
		count = 0;
		for k in g.n {
			if g.res[k] >= th { count++; }
		}
		if count >= tgt { break; }
		th /= 2;
		r++;
	}
	out.i = count;
	out.ok = (count >= tgt);
	g.steps += (r + 1) * g.n;
	out
}
@end
