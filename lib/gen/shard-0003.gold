expect: => i=1 r=0.0 ok=true s="validated within maximum bound true" errors=0 n=3 res=[5,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = v.i;
	var valid = true;
	var p = g.n - 1;
	while p >= 0 {
		if g.res[p] > ceiling {
			valid = false;
			g.res[p] = ceiling;
		}
		p--;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "validated within maximum bound ", valid);
	out
}
@end
