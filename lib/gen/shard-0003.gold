expect: => i=4 r=0.0 ok=true s="shifted 4 items circularly" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,15,25
expect: => i=3 r=0.0 ok=true s="shifted 3 items circularly" errors=0 n=3 res=[15,25,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "single element range");
		return out;
	}
	let first = g.res[0];
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " items circularly");
	out
}
@end
