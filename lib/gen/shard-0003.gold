@entry 8f37a9daa1e4c56c
kind: step
verb: apply
noun: vowels
modifier: sorted
context: cache
phrase: cache sorted vowel occurrences from results list
phrase: record sorted count of vowel ascii values in cache
test: list=65,66,69,70
expect: => i=2 r=0.0 ok=true s="found 2 sorted vowels" errors=0 n=4 res=[65,66,69,70] cache=1 hits=0
test: list=97,100,101,105
expect: => i=3 r=0.0 ok=true s="found 3 sorted vowels" errors=0 n=4 res=[97,100,101,105] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels int[512] = [0; 512];
	var v_len = 0;
	for i in g.n {
		let x = g.res[i];
		if x == 65 || x == 69 || x == 73 || x == 79 || x == 85 ||
		   x == 97 || x == 101 || x == 105 || x == 111 || x == 117 {
			vowels[v_len] = x;
			v_len++;
		}
	}
	for i in v_len {
		for j in i + 1..v_len {
			if vowels[i] > vowels[j] {
				let tmp = vowels[i];
				vowels[i] = vowels[j];
				vowels[j] = tmp;
			}
		}
	}
	gold_cache_put(g, v_len, if v_len > 0 { vowels[0] } else { 0 });
	g.steps += g.n + v_len * v_len;
	out.i = v_len;
	out.s.clear();
	format(out.s, "found ", v_len, " sorted vowels");
