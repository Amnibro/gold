expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3,4 count=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 {
		gold_fail(g, "negative count");
		out.ok = false;
		return out;
	}
	if k < g.n {
		let shift = g.n - k;
		for i in k {
			g.res[i] = g.res[i + shift];
		}
		g.n = k;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
