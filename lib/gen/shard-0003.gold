fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mt = ${min_tally};
	if mt <= 0 {
		gold_fail(g, "threshold must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid threshold");
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] > 0 { count++; }
	}
	if count < mt {
		gold_fail(g, "tally below minimum requirement");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: tally ", count, " below ", mt);
		return out;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found positive tally ", count);
	out
}
@end
@entry 1275705ea7ef0e4b
kind: step
verb: run
noun: number
modifier: until
context: retry
phrase: run number until {stop}
phrase: execute number step until {stop}
slot: stop pred
test: list=2,4,6,1 stop=is_one
expect: => i=3 r=0.0 ok=true s="ran number through 3 steps" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=1,2,3 stop=is_one
expect: => i=0 r=0.0 ok=false s="error: stopped at start" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for run");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	if ${stop}(g.res[0]) {
		gold_fail(g, "stop condition met at start");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: stopped at start");
		return out;
	}
	var count = 0;
	while count < g.n {
		if ${stop}(g.res[count]) {
			break;
		}
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "ran number through ", count, " steps");
	out
}
@end
