@entry 22c442b5173e9321
kind: step
verb: rotate
noun: threshold
modifier: safely
context: list
phrase: rotate list safely when size exceeds threshold {thresh}
phrase: shift sequence cyclically bounded by threshold {thresh}
slot: thresh int
test: list=1,2,3,4,5 thresh=3
expect: => i=5 r=0.0 ok=true s="safely rotated list of size 5" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
test: list=10,20 thresh=3
expect: => i=2 r=0.0 ok=false s="threshold not met list untouched" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	var rotated = false;
	if g.n > t && g.n > 1 {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
		rotated = true;
	}
	g.steps += g.n;
	out.ok = rotated;
	out.i = g.n;
	out.s.clear();
	if rotated {
		format(out.s, "safely rotated list of size ", g.n);
	} else {
		format(out.s, "threshold not met list untouched");
	}
	out
}
@end
