@entry 2d8fa64569be412f
kind: step
verb: rotate
noun: loop
modifier: at_most
context: math
phrase: rotate sequence in circular loop at most {max_rot} positions
phrase: shift results cyclically at most {max_rot} places
slot: max_rot int
test: list=10,20,30,40 max_rot=2
expect: => i=4 r=0.0 ok=true s="rotated loop at most 2 shifts" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=1,2,3,4,5 max_rot=1
expect: => i=5 r=0.0 ok=true s="rotated loop at most 1 shifts" errors=0 n=5 res=[5,1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_rot};
	if g.n > 1 && m > 0 {
		let shift = m % g.n;
		for step in shift {
			let last = g.res[g.n - 1];
			var j = g.n - 1;
			while j > 0 {
				g.res[j] = g.res[j - 1];
				j--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n + m;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated loop at most ", m, " shifts");
	out
}
@end
