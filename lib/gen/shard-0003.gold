@entry ba4d940db82bc4b0
kind: step
verb: apply
noun: evens
modifier: while
context: retry
phrase: apply evens while {cond} satisfies
phrase: process even elements while {cond} holds
slot: cond pred
test: list=2,4,6,1 cond=is_even
expect: => i=3 r=0.0 ok=true s="applied evens to 3 items" errors=0 n=4 res=[4,8,12,1] cache=0 hits=0
test: list=1,2,3 cond=is_even
expect: => i=0 r=0.0 ok=false s="error: start condition failed" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for evens");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	if !${cond}(g.res[0]) {
		gold_fail(g, "initial element does not satisfy condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: start condition failed");
		return out;
	}
	var count = 0;
	while count < g.n {
		if !${cond}(g.res[count]) { break; }
		if g.res[count] % 2 == 0 {
			g.res[count] *= 2;
		}
		count++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "applied evens to ", count, " items");
	out
}
@end
