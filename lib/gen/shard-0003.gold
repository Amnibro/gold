code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_flags int[64] = [0; 64];
	var dup_count = 0;
	for i in g.n {
		var is_dup = false;
		for j in i {
			if g.res[j] == g.res[i] { is_dup = true; break; }
		}
		if is_dup {
			if i < 64 { dup_flags[i] = 1; }
			dup_count++;
		}
	}
	for k in g.n { if k < 64 { g.res[k] = dup_flags[k]; } }
	out.i = dup_count;
	out.ok = dup_count == 0;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "running duplicate count ", dup_count);
	out
}
@end
