fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if g.n > 0 {
		let mid = g.res[g.n / 2];
		var occurrences = 0;
		for i in g.n {
			if g.res[i] == mid { occurrences++; }
		}
		out.i = occurrences * f;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
