code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = false;
	var pass = 0;
	while !sorted && pass < g.n {
		sorted = true;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let t = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = t;
				sorted = false;
			}
			i++;
		}
		pass++;
	}
	out.i = pass;
	g.steps += pass;
	out
}
@end
