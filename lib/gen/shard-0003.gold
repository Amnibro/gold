@entry a7a2af1c05de041d
kind: step
verb: fold
noun: checkpoint
modifier: at_least
context: sort
phrase: fold sorted elements at least checkpoint {checkpoint}
phrase: sum ordered values exceeding checkpoint {checkpoint}
slot: checkpoint int
test: list=15,3,9,20,5 checkpoint=10
expect: => i=35 r=0.0 ok=true s="" errors=0 n=5 res=[3,5,9,15,20] cache=0 hits=0
test: list=1,2,3 checkpoint=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	// Sort g.res ascending
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let cp = ${checkpoint};
	var total = 0;
	for k in g.n {
		if g.res[k] >= cp {
			total += g.res[k];
		}
	}
	out.i = total;
	g.steps += g.n;
	out
}
