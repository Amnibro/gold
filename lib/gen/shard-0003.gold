fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let x = ${val};
	if x < 0 {
		gold_fail(g, "invalid negative streak fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative value");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty streak results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty streak");
		return out;
