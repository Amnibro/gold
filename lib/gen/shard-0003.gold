fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_letters};
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		let is_letter = (x >= 65 && x <= 90) || (x >= 97 && x <= 122);
		if is_letter {
			count++;
		}
	}
	out.ok = count >= req;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " letter codes");
	g.steps += g.n;
	out
}
@end
@entry 91117d1a911a654f
kind: step
verb: rotate
noun: gaps
modifier: running
context: math
phrase: rotate running gap differences across results cyclically
phrase: shift running adjacent intervals of sequence
test: list=2,5,10,17
expect: => i=3 r=0.0 ok=true s="rotated running gaps 3" errors=0 n=3 res=[7,3,5] cache=0 hits=0
test: list=1,4,9,16,25
expect: => i=4 r=0.0 ok=true s="rotated running gaps 4" errors=0 n=4 res=[9,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var gaps: int[512] = [0; 512];
	let count = g.n - 1;
	for k in count {
		gaps[k] = g.res[k + 1] - g.res[k];
	}
	let last = gaps[count - 1];
	var j = count - 1;
	while j > 0 {
		gaps[j] = gaps[j - 1];
		j--;
	}
	gaps[0] = last;
	for k in count {
		g.res[k] = gaps[k];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated running gaps ", count);
	out
}
@end
