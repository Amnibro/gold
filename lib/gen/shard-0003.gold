@entry 76937fd3fcd17418
kind: step
verb: fill
noun: primes
modifier: until
context: sort
phrase: fill sorted primes until cap {limit}
phrase: insert primes sorted up to cap {limit}
slot: limit int
test: limit=10
expect: => i=4 r=0.0 ok=true s="primes filled" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: limit=15
expect: => i=6 r=0.0 ok=true s="primes filled" errors=0 n=6 res=[2,3,5,7,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	gold_clear(g);
	var candidate = 2;
	while candidate <= lim {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, candidate);
		}
		candidate++;
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "primes filled");
	out
}
@end
