code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	if g.n == 0 {
		gold_fail(g, "no values to search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty values");
		return out;
	}
	var found = false;
	var matched = 0;
	for i in g.n {
		if g.res[i] >= mv {
			found = true;
			matched = g.res[i];
			break;
		}
	}
	if !found {
		gold_fail(g, "no value meets minimum bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: bound not met");
		return out;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "found value ", matched);
	out
}
@end
