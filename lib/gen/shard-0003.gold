test: list=10,20,50,30,40,10 input=3
expect: => i=3 r=0.0 ok=true s="sorted last segment size 3" errors=0 n=6 res=[10,20,50,10,30,40] cache=0 hits=0
test: list=1,9,8,7,6 input=2
expect: => i=2 r=0.0 ok=true s="sorted last segment size 2" errors=0 n=5 res=[1,9,8,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tail_count = min(max(1, v.i), g.n);
	let start = g.n - tail_count;
	for a in tail_count {
		var b = a + 1;
		while b < tail_count {
			if g.res[start + a] > g.res[start + b] {
				let t = g.res[start + a];
				g.res[start + a] = g.res[start + b];
				g.res[start + b] = t;
			}
			b++;
		}
	}
	out.i = tail_count;
	g.steps += tail_count;
	out.s.clear();
	format(out.s, "sorted last segment size ", tail_count);
	out
}
@end
@entry 05c7eb3a278a8cf3
kind: step
verb: dedupe
noun: sequence
modifier: recursively
context: transform
phrase: dedupe sequence elements recursively
phrase: recursively compress duplicate sequence runs
test: list=1,1,2,2,2,3,4,4 input=0
expect: => i=4 r=0.0 ok=true s="compressed sequence size 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,6,7,7,8 input=0
expect: => i=4 r=0.0 ok=true s="compressed sequence size 4" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var w = 1;
	var r = 1;
	while r < g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
		r++;
	}
	let removed = g.n - w;
	g.n = w;
	out.i = w;
	g.steps += removed;
	out.s.clear();
	format(out.s, "compressed sequence size ", w);
	out
}
@end
