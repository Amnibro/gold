@entry 9cffed8a2034e5a9
kind: step
verb: reverse
noun: tail
modifier: until
context: filter
phrase: reverse sequence tail starting after encountering barrier {stop_val}
phrase: invert trailing elements backwards until matching stop value {stop_val}
slot: stop_val int
test: list=1,0,5,6,7 stop_val=0
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[1,0,7,6,5] cache=0 hits=0
test: list=9,8,2,3,4 stop_val=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[9,8,2,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let barrier = ${stop_val};
	var start_idx = -1;
	for k in g.n {
		if g.res[k] == barrier { start_idx = k + 1; }
	}
	if start_idx >= 0 && start_idx < g.n {
		var i = start_idx;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
		out.i = g.n - start_idx;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
