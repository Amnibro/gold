fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let val = g.res[idx];
		let cached, hit = gold_cache_get(g, val);
		if !hit {
			gold_cache_put(g, val, 1);
			unique_count++;
		}
		idx--;
	}
	out.i = unique_count;
	g.steps += unique_count;
	out.s.clear();
	format(out.s, "unique cache entries backward ", unique_count);
	out
}
@end
