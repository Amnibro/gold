code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n == 0 {
		gold_fail(g, "empty results on threshold shift error");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	if last > b {
		gold_fail(g, "last element exceeds threshold bound error");
		out.ok = false;
	} else {
		for i in g.n - 1 {
			let idx = g.n - 1 - i;
			g.res[idx] = g.res[idx - 1];
		}
		g.res[0] = last;
	}
	out.i = g.res[0];
	g.steps += g.n;
	out
}
@end
