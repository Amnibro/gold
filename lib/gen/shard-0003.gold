@entry 12fffa898389b0d5
kind: step
verb: dedupe
noun: maximum
modifier: in_reverse
context: transform
phrase: dedupe maximum occurrences in reverse order
phrase: remove duplicate peaks scanning backward
test: list=10,50,20,50,30,50 input=0
expect: => i=50 r=0.0 ok=true s="deduped max peak 50" errors=0 n=4 res=[10,50,20,30] cache=0 hits=0
test: list=9,9,5,9,3 input=0
expect: => i=9 r=0.0 ok=true s="deduped max peak 9" errors=0 n=3 res=[9,5,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var write_idx = 0;
	var seen_peak = false;
	for idx in g.n {
		if g.res[idx] == max_val {
			if !seen_peak {
				g.res[write_idx] = g.res[idx];
				write_idx++;
				seen_peak = true;
			}
		} else {
			g.res[write_idx] = g.res[idx];
			write_idx++;
		}
	}
	let removed = g.n - write_idx;
	g.n = write_idx;
	out.i = max_val;
	g.steps += removed;
	out.s.clear();
	format(out.s, "deduped max peak ", max_val);
	out
}
@end
