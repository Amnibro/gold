fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let interval = ${step};
	var running = 0;
	var checkpoints = 0;
	for k in g.n {
		running += g.res[k];
		if (k + 1) % interval == 0 {
			gold_cache_put(g, k + 1, running);
			checkpoints++;
		}
	}
	out.i = running;
	g.steps += g.n;
	out
}
@end
@entry 19aa2389f5943e98
kind: step
verb: filter
noun: head
modifier: pairwise
context: cache
phrase: cache pairwise sum of initial head elements up to {k}
phrase: store adjacent pair totals from prefix in memo up to {k}
slot: k int
test: list=3,5,7,9 k=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[3,5,7,9] cache=2 hits=0
test: list=10,20,30,40 k=2
