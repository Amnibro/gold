fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos int[64] = [0; 64];
	var npos = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n { if g.res[j] == x { count++; } }
		if count == 1 && npos < 64 {
			pos[npos] = i;
			npos++;
		}
	}
	var l = 0;
	var r = npos - 1;
	while l < r {
		let pl = pos[l];
		let pr = pos[r];
		let t = g.res[pl];
		g.res[pl] = g.res[pr];
		g.res[pr] = t;
		l++;
		r--;
	}
	out.i = npos;
	out
}
@end
