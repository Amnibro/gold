expect: => i=1 r=0.0 ok=true s="merged 1 consecutive even pairs" errors=0 n=4 res=[30,3,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var merges = 0;
	var i = 0;
	var w = 0;
	while i < g.n {
		if i + 1 < g.n && merges < lim && g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			g.res[w] = g.res[i] + g.res[i + 1];
			w += 1;
			i += 2;
			merges += 1;
		} else {
			g.res[w] = g.res[i];
			w += 1;
			i += 1;
		}
	}
	g.n = w;
	g.steps += i;
	out.i = merges;
	out.s.clear();
	format(out.s, "merged ", merges, " consecutive even pairs");
	out
}
@end
