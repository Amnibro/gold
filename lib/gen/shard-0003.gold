fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[64] = [0; 64];
	var uniq = true;
	for k in g.n {
		let v_k = g.res[k];
		for j in k {
			if g.res[j] == v_k { uniq = false; break; }
		}
		if !uniq { break; }
	}
	out.ok = uniq;
	out.s.clear();
	if uniq {
		format(out.s, "checkpoints all unique");
	} else {
		format(out.s, "duplicate checkpoint detected");
		gold_fail(g, "duplicate checkpoint");
	}
	g.steps += g.n;
	out
}
