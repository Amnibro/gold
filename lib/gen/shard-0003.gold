@entry a791b09a3474b89c
kind: step
verb: merge
noun: limit
modifier: times
context: list
phrase: merge adjacent pairs below limit {limit} repeating {times} passes
phrase: combine neighboring elements under limit {limit} across {times} iterations
phrase: collapse small adjacent values under limit {limit} repeated {times} cycles
slot: limit int
slot: times int
test: list=2,3,4,1 limit=6 times=1
expect: => i=2 r=0.0 ok=true s="merged 2 small pairs below limit 6" errors=0 n=2 res=[5,5] cache=0 hits=0
test: list=1,1,1,1 limit=4 times=2
expect: => i=3 r=0.0 ok=true s="merged 3 small pairs below limit 4" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let t = ${times};
	var total_merges = 0;
	for round in t {
		var w = 0;
		var i = 0;
		var merged_in_round = 0;
		while i < g.n {
			if i + 1 < g.n && g.res[i] + g.res[i + 1] <= lim {
				g.res[w] = g.res[i] + g.res[i + 1];
				w += 1;
				i += 2;
				merged_in_round += 1;
			} else {
				g.res[w] = g.res[i];
				w += 1;
				i += 1;
			}
		}
		g.n = w;
		total_merges += merged_in_round;
		if merged_in_round == 0 { break; }
	}
	g.steps += total_merges;
	out.i = total_merges;
	out.s.clear();
	format(out.s, "merged ", total_merges, " small pairs below limit ", lim);
	out
}
@end
