expect: => i=2 r=0.0 ok=true s="processed 2 words across list" errors=0 n=6 res=[10,20,30,60,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var chunk_idx = 0;
	var i = 0;
	while i < g.n {
		let chunk_end = if i + sz < g.n { i + sz } else { g.n };
		if chunk_idx % 2 == 1 && chunk_end - i > 1 {
			var left = i;
			var right = chunk_end - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left += 1;
				right -= 1;
			}
		}
		chunk_idx += 1;
		i += sz;
	}
	g.steps += g.n;
	out.i = chunk_idx;
	out.s.clear();
	format(out.s, "processed ", chunk_idx, " words across list");
	out
}
@end
