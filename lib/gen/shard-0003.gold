fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let window = ${w};
	if window <= 0 || window > g.n {
		gold_fail(g, "invalid window size");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var wins int[512] = [0; 512];
	var wn = 0;
	var i = 0;
	while i + window <= g.n {
		var sum = 0;
		for p in window { sum += g.res[i + p]; }
		wins[wn] = sum;
		wn++;
		i++;
	}
	gold_clear(g);
	for p in wn { gold_push(g, wins[p]); }
	out.i = wn;
	g.steps += g.n;
	out
}
@end
