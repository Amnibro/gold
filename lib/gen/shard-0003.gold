	if g.n == 0 {
		gold_fail(g, "series empty");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty series");
		return out;
	}
	var found_idx = -1;
	for i in g.n {
		if ${stop}(g.res[i]) {
			found_idx = i;
			break;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "stop condition not found in series");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: stop not found");
		return out;
	}
	g.n = found_idx;
	g.steps += found_idx + 1;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "split series at index ", found_idx);
	out
}
@end
