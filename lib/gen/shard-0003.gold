code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var is_first = true;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				is_first = false;
				break;
			}
			j += 1;
		}
		if is_first {
			unique_count += 1;
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "counted ", unique_count, " unique items");
	out
}
@end
@entry a00f9d169fd13a8d
kind: step
verb: reverse
noun: limit
modifier: every_other
context: list
phrase: reverse alternate chunks of limit {limit} in list
phrase: invert every other block of size {limit}
phrase: flip alternating sections of length {limit}
slot: limit int
test: list=1,2,3,4,5,6,7,8 limit=2
expect: => i=4 r=0.0 ok=true s="processed 4 alternating chunks" errors=0 n=8 res=[2,1,3,4,6,5,7,8] cache=0 hits=0
test: list=10,20,30,40,50,60 limit=3
expect: => i=2 r=0.0 ok=true s="processed 2 alternating chunks" errors=0 n=6 res=[30,20,10,40,50,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var block_idx = 0;
	var i = 0;
	while i < g.n {
		let bend = if i + lim < g.n { i + lim } else { g.n };
		if block_idx % 2 == 0 && bend - i > 1 {
			var left = i;
			var right = bend - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left += 1;
				right -= 1;
			}
		}
		block_idx += 1;
		i += lim;
	}
	g.steps += g.n;
	out.i = block_idx;
	out.s.clear();
	format(out.s, "processed ", block_idx, " alternating chunks");
	out
}
@end
