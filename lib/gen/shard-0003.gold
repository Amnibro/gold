kind: step
verb: rotate
noun: condition
modifier: nested
context: list
phrase: rotate elements matching condition with nested passes
phrase: shift conditional values through nested rotation
test: list=1,4,3,6,5,8
expect: => i=3 r=0.0 ok=true s="rotated 3 conditional elements" errors=0 n=6 res=[1,8,3,4,5,6] cache=0 hits=0
test: list=2,1,4,3,6,5
expect: => i=3 r=0.0 ok=true s="rotated 3 conditional elements" errors=0 n=6 res=[6,1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens: int[512] = [0; 512];
	var ev_count = 0;
	for k in g.n {
		if g.res[k] % 2 == 0 {
			evens[ev_count] = g.res[k];
			ev_count++;
		}
	}
	if ev_count > 1 {
		let last = evens[ev_count - 1];
		var j = ev_count - 1;
		while j > 0 {
			evens[j] = evens[j - 1];
			j--;
		}
		evens[0] = last;
		var cur = 0;
		for k in g.n {
			if g.res[k] % 2 == 0 {
				g.res[k] = evens[cur];
				cur++;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = ev_count;
	out.s.clear();
	format(out.s, "rotated ", ev_count, " conditional elements");
	out
}
@end
