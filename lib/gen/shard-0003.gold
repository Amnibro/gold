@entry fcc1280f9e58da69
kind: step
verb: dedupe
noun: list
modifier: any
context: math
phrase: dedupe any repeated numbers across list
phrase: remove any duplicate values from sequence
test: list=3,1,3,2,1,4
expect: => i=2 r=0.0 ok=true s="deduped list removed 2" errors=0 n=4 res=[3,1,2,4] cache=0 hits=0
test: list=5,5,5,10,20,10
expect: => i=3 r=0.0 ok=true s="deduped list removed 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n * 2;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped list removed ", removed);
	out
}
@end
