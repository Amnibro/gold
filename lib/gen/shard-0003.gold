code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let tmp = g.res[g.n - 1];
	g.res[g.n - 1] = g.res[g.n - 2];
	g.res[g.n - 2] = tmp;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "reversed last pair: ", out.i);
	g.steps += 2;
	out
}
@end
