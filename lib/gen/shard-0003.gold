noun: counter
modifier: unique
context: math
phrase: pair counter frequencies of unique items
phrase: pair frequency counts of unique entries
test: list=1,2,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,2,2,3,1] cache=0 hits=0
test: list=10,10,20
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,2,20,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_vals int[256] = [0; 256];
	var u_cnts int[256] = [0; 256];
	var u_n = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var found_pos = -1;
		var j = 0;
		while j < u_n {
			if u_vals[j] == x { found_pos = j; break; }
			j++;
		}
		if found_pos >= 0 {
			u_cnts[found_pos]++;
		} else {
			u_vals[u_n] = x;
			u_cnts[u_n] = 1;
			u_n++;
		}
		i++;
	}
	var w = 0;
	var k = 0;
	while k < u_n {
		g.res[w] = u_vals[k];
		g.res[w + 1] = u_cnts[k];
		w += 2;
		k++;
	}
	g.n = w;
	out.i = u_n;
	g.steps += g.n;
	out
}
@end
