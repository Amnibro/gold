code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_delta = ${limit};
	var ok = true;
	var i = 0;
	while i + 1 < g.n {
		let delta = g.res[i + 1] - g.res[i];
		if delta > max_delta || delta < 0 { ok = false; break; }
		i++;
	}
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "steps valid while bound ", ok);
	g.steps += g.n;
	out
}
@end
