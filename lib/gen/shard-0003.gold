@entry 65e3d8515ed5b771
kind: step
verb: retry
noun: results
modifier: with_cache
context: math
phrase: retry calculating results using cached values
phrase: recompute results with cache assistance
test: list=2,4,2,6
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[6,12,6,18] cache=3 hits=1
test: list=5,10,15
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[15,30,45] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = 0;
	while idx < g.n {
		let orig = g.res[idx];
		let cv, hit = gold_cache_get(g, orig);
		if hit {
			g.res[idx] = cv;
		} else {
			let computed = orig * 3;
			gold_cache_put(g, orig, computed);
			g.res[idx] = computed;
		}
		idx++;
	}
	out.i = g.hits;
	g.steps += g.n;
	out
}
@end
@entry d2114ede67d7ef43
kind: step
verb: select
noun: condition
modifier: unique
context: math
phrase: select unique elements satisfying condition
phrase: filter distinct numbers meeting criteria
