fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	var base_sum = 0;
	for k in g.n {
		let x = g.res[k];
		if (x >= 65 && x <= 90) || (x >= 97 && x <= 122) {
			base_sum += x;
		}
	}
	var acc = 0;
	var i = 0;
	while i < t {
		acc += base_sum;
		i++;
	}
	g.steps += g.n + t;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded letters ", t, " times to ", acc);
	out
}
@end
