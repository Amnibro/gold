expect: => i=1 r=0.0 ok=true s="safely retried 1 negative windows" errors=0 n=4 res=[5,8,10,20] cache=0 hits=0
test: list=1,-10,2,3 win_size=2 safe_offset=15
expect: => i=1 r=0.0 ok=true s="safely retried 1 negative windows" errors=0 n=4 res=[16,5,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wsz = ${win_size};
	let offset = ${safe_offset};
	var adjusted = 0;
	var i = 0;
	while i + wsz <= g.n {
		var wsum = 0;
		for k in wsz {
			wsum += g.res[i + k];
		}
		if wsum < 0 {
			for k in wsz {
				g.res[i + k] += offset;
			}
			adjusted += 1;
		}
		i += wsz;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "safely retried ", adjusted, " negative windows");
	out
}
@end
