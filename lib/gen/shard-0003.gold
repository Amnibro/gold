fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${size};
	var windows = 0;
	if w > 0 && g.n >= w {
		for i in 0..g.n - w + 1 {
			var sum = 0;
			for j in w { sum += g.res[i + j]; }
			let cnt, ok = gold_cache_get(g, sum);
			gold_cache_put(g, sum, if ok { cnt + 1 } else { 1 });
			windows++;
		}
	}
	g.steps += g.n * w;
	out.i = windows;
	out.s.clear();
	format(out.s, "tallied ", windows, " window sums");
	out
}
@end
