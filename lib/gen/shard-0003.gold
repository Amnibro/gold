fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let lim = if k > g.n { g.n } else { k };
	for i in lim {
		let x = g.res[i];
		gold_cache_put(g, x, x * 2);
	}
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "cached ", lim, " head items");
	out
}
@end
@entry b6462905b5f32b57
kind: step
verb: collect
noun: minimum
modifier: with_retry
context: math
phrase: collect minimum with retry filter
phrase: gather minimum items with retry
test: list=8,3,5,3,9,3
expect: => i=3 r=0.0 ok=true s="collected 3 minimum items" errors=0 n=3 res=[3,3,3] cache=0 hits=0
test: list=12,7,12,7
expect: => i=7 r=0.0 ok=true s="collected 2 minimum items" errors=0 n=2 res=[7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty list");
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] == min_val {
			g.res[kept] = min_val;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = min_val;
	out.s.clear();
	format(out.s, "collected ", kept, " minimum items");
	out
}
@end
