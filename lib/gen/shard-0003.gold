code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if limit <= 0 {
		gold_fail(g, "non-positive histogram cap");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var total = 0;
	for k in g.n {
		let x = g.res[k];
		let val, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, val + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
		total++;
		if total >= limit { break; }
	}
	out.i = total;
	g.steps += total;
	out
}
@end
