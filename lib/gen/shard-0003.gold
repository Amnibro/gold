fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = 10;
	let hi = 30;
	var modified = 0;
	for i in 0..g.n {
		var x = g.res[i];
		if x < lo {
			g.res[i] = lo;
			modified++;
		} else if x > hi {
			g.res[i] = hi;
			modified++;
		}
	}
	out.i = modified;
