expect: => i=5 r=0.0 ok=true s="histogram total count 5" errors=0 n=3 res=[2,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = v.i;
	var bins int[16] = [0; 16];
	var total_binned = 0;
	var pos = 0;
	while pos < g.n {
		let item = g.res[pos];
		if item > cap { break; }
		if item >= 0 && item < 16 {
			bins[item]++;
			total_binned++;
		}
		pos++;
	}
	gold_clear(g);
	for b in 16 {
		if bins[b] > 0 {
			gold_push(g, bins[b]);
		}
	}
	out.i = total_binned;
	g.steps += total_binned;
	out.s.clear();
	format(out.s, "histogram total count ", total_binned);
	out
}
@end
