test: list=65,66,67,69,70 limit=2
expect: => i=2 r=0.0 ok=true s="selected 2 vowel codes from list" errors=0 n=2 res=[65,69] cache=0 hits=0
test: list=97,98,99,101,105 limit=1
expect: => i=1 r=0.0 ok=true s="selected 1 vowel codes from list" errors=0 n=1 res=[97] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var w = 0;
	var kept = 0;
	for i in g.n {
		let c = g.res[i];
		let is_v = ${ID}_is_vowel(c);
		if is_v && kept < lim {
			g.res[w] = c;
			w += 1;
			kept += 1;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected ", kept, " vowel codes from list");
	out
}

fn ${ID}_is_vowel(c int) bool {
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85 || c == 97 || c == 101 || c == 105 || c == 111 || c == 117
}
@end
