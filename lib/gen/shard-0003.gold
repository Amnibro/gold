fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_v = ${min_val};
	if g.cn == 0 {
		gold_cache_put(g, 1, 20);
		gold_cache_put(g, 2, 100);
		gold_cache_put(g, 3, 300);
	}
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] < floor_v {
			g.cv[i] = floor_v;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped cache entries ", clamped);
	g.steps += g.cn;
	out
}
@end
