fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${shift};
	var sp_idx = -1;
	for i in out.s.len {
		if out.s[i] == ' ' { sp_idx = i; break; }
	}
	if sp_idx > 0 && k > 0 {
		var buf byte[>..] = [];
		var p = sp_idx + 1;
		while p < out.s.len { buf.push(out.s[p]); p++; }
		buf.push(' ');
		var q = 0;
		while q < sp_idx { buf.push(out.s[q]); q++; }
		out.s.clear();
		format(out.s, buf);
	}
	out.i = k;
	g.steps += k + 1;
	out
}
