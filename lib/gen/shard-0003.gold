fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var matched = 0;
	for i in g.n {
		if matched >= ceiling {
			break;
		}
		let x = g.res[i];
		gold_cache_put(g, i, x);
		matched++;
	}
	g.n = matched;
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "limited memo matches to ceiling ", matched);
	out
}
@end
@entry 7852768e78ab4bdc
kind: step
verb: compare
noun: checkpoint
modifier: recursively
context: search
phrase: compare search values against midpoint checkpoint recursively
phrase: evaluate deviations from central checkpoint recursively
test: list=10,20,50,40
expect: => i=60 r=0.0 ok=true s="compared against midpoint checkpoint 50 diff 60" errors=0 n=4 res=[10,20,50,40] cache=0 hits=0
test: list=1,5,15,25
expect: => i=34 r=0.0 ok=true s="compared against midpoint checkpoint 15 diff 34" errors=0 n=4 res=[1,5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		return out;
	}
	let mid = g.n / 2;
	let cp = g.res[mid];
	var left_sum = 0;
	var right_sum = 0;
	for i in mid {
		left_sum += g.res[i];
	}
	for i in mid..g.n {
		right_sum += g.res[i];
	}
	let diff = right_sum - left_sum;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "compared against midpoint checkpoint ", cp, " diff ", diff);
	out
}
@end
