@entry c4674d146a39c86e
kind: step
verb: find
noun: window
modifier: each
context: stats
phrase: find moving average across each window of size {k}
phrase: compute rolling mean for each window {k}
slot: k int
test: list=10,20,30,40,50 k=3
expect: => i=3 r=0.0 ok=true s="moving window done" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=2,4,6,8 k=2
expect: => i=3 r=0.0 ok=true s="moving window done" errors=0 n=3 res=[3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${k};
	if w <= 0 || w > g.n {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let num = g.n - w + 1;
	for i in num {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[i] = sum / w;
	}
	g.n = num;
	g.steps += num;
	out.i = num;
	gold_text(out, "moving window done");
	out
}
@end
