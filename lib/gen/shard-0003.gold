@entry c0d357a8fd0da82f
kind: fn
verb: merge
noun: streak
modifier: sorted
context: aggregate
phrase: merge sorted streaks of digits
phrase: aggregate ascending digit streaks sorted
test: arg=12534,9123
expect: 23
expect: 13
test: arg=54321
expect: 11111
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var d int[32] = [0; 32];
	var len = 0;
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	if len == 0 { return 0; }
	var streaks int[32] = [0; 32];
	var slen = 0;
	var cur = 1;
	var k = len - 2;
	while k >= 0 {
		if d[k] >= d[k + 1] {
			cur++;
		} else {
			streaks[slen] = cur;
			slen++;
			cur = 1;
		}
		k--;
	}
	streaks[slen] = cur;
	slen++;
	// sort streaks
	var i = 0;
	while i < slen {
		var j = i + 1;
		while j < slen {
			if streaks[i] > streaks[j] {
				let t = streaks[i];
				streaks[i] = streaks[j];
				streaks[j] = t;
			}
			j++;
		}
		i++;
	}
	var out = 0;
	var idx = 0;
	while idx < slen {
		out = out * 10 + streaks[idx];
		idx++;
	}
	out
}
@end
