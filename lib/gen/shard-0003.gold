code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if d == 0 {
		gold_fail(g, "zero delta invalid");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero delta");
		return out;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		let r = sqrt(x as real) as int;
		if r * r == x && x >= 0 {
			g.res[i] += d;
			count++;
