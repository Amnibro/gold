fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
				i += 2;
			} else {
				i++;
			}
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "pair swaps ", swaps);
	g.steps += g.n + swaps;
	out
}
