phrase: aggregate longest ascending streak using {retry}
phrase: compute total of best streak retry {retry}
slot: retry int
test: list=1,2,3,1,2 retry=2
expect: => i=12 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,1,2] cache=0 hits=0
test: list=5,6,2,3,4 retry=1
expect: => i=9 r=0.0 ok=true s="" errors=0 n=5 res=[5,6,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retry};
	if g.n == 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len {
		best_len = cur_len;
		best_start = cur_start;
	}
	var s = 0;
	for j in best_len { s += g.res[best_start + j]; }
	out.i = s * r;
	out
}
@end
@entry f61435d224dd37e0
kind: step
verb: find
noun: maximum
modifier: unique
context: aggregate
phrase: find maximum among unique elements
phrase: aggregate highest unique sequence value
phrase: compute maximum of distinct items
test: list=1,5,5,3,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[1,5,5,3,4] cache=0 hits=0
test: list=10,20,20,15
expect: => i=15 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var counts int[64] = [0; 64];
	var distinct int[64] = [0; 64];
	var nd = 0;
	for i in g.n {
		let val = g.res[i];
		var found = -1;
		for j in nd {
			if distinct[j] == val {
				found = j;
				break;
			}
		}
		if found >= 0 {
			counts[found]++;
		} else if nd < 64 {
			distinct[nd] = val;
			counts[nd] = 1;
			nd++;
		}
	}
	var max_uniq = -999999;
	for j in nd {
		if counts[j] == 1 {
			if distinct[j] > max_uniq { max_uniq = distinct[j]; }
		}
	}
	if max_uniq == -999999 {
		max_uniq = g.res[0];
		for i in g.n { if g.res[i] > max_uniq { max_uniq = g.res[i]; } }
	}
	out.i = max_uniq;
	out
}
@end
