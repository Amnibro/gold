phrase: sort contiguous monotonic runs in results sequence
phrase: order any consecutive increasing segments
test: list=3,1,2,5,4,6
expect: => i=2 r=0.0 ok=true s="sorted runs count 2" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=5,4,3,2,1
expect: => i=0 r=0.0 ok=true s="sorted runs count 0" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var runs_sorted = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j] <= g.res[j + 1] {
			j++;
		}
		if j > i {
			runs_sorted++;
		}
		i = j + 1;
	}
	for a in g.n {
		for b in g.n - 1 {
			if g.res[b] > g.res[b + 1] {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = runs_sorted;
	out.s.clear();
	format(out.s, "sorted runs count ", runs_sorted);
	out
}
@end
@entry c71de0f09918879b
kind: step
verb: sort
noun: condition
modifier: pairwise
context: math
phrase: sort adjacent elements satisfying pairwise condition
phrase: reorder neighboring results by pairwise parity condition
test: list=4,1,8,3,2
expect: => i=2 r=0.0 ok=true s="pairwise condition swaps 2" errors=0 n=5 res=[1,4,3,8,2] cache=0 hits=0
test: list=9,2,7,4,6
expect: => i=0 r=0.0 ok=true s="pairwise condition swaps 0" errors=0 n=5 res=[9,2,7,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	for pass in g.n {
		var i = 0;
		while i + 1 < g.n {
			let cond = (g.res[i] % 2 == 0) && (g.res[i + 1] % 2 != 0);
			if cond || (g.res[i] > g.res[i + 1] && g.res[i] % 2 == g.res[i + 1] % 2) {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
			i += 2;
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "pairwise condition swaps ", swaps);
	out
}
@end
@entry 7abc508ba9e94bbc
