fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let fac = ${factor};
	let cnt = ${times};
	var modified = 0;
	for k in g.n {
		if g.res[k] > th {
			var x = g.res[k];
			for t in cnt { x *= fac; }
			g.res[k] = x;
			modified++;
		}
	}
	out.i = modified;
	g.steps += g.n * (cnt + 1);
	out
}
@end
