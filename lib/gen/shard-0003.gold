@entry cea31e60dd3016a0
kind: step
verb: return
noun: vowels
modifier: every_other
context: math
phrase: return every other vowel ASCII code from sequence
phrase: extract alternate vowel character values from numbers
test: list=65,66,69,70,73,80
expect: => i=2 r=0.0 ok=true s="returned 2 alternate vowels" errors=0 n=2 res=[65,73] cache=0 hits=0
test: list=97,98,101,102,105,106,111
expect: => i=2 r=0.0 ok=true s="returned 2 alternate vowels" errors=0 n=2 res=[97,105] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var v_idx = 0;
	for k in g.n {
		let x = g.res[k];
		let is_v = x == 65 || x == 69 || x == 73 || x == 79 || x == 85 ||
		           x == 97 || x == 101 || x == 105 || x == 111 || x == 117;
		if is_v {
			if v_idx % 2 == 0 {
				g.res[kept] = x;
				kept++;
			}
			v_idx++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "returned ", kept, " alternate vowels");
	g.steps += g.n + 1;
	out
}
@end
