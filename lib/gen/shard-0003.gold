@entry e217658849f153ee
kind: step
verb: collect
noun: value
modifier: between
context: retry
phrase: collect value between range limits of {bound}
phrase: gather elements bounded between limits of {bound}
slot: bound int
test: list=3,15,4,20 bound=10
expect: => i=2 r=0.0 ok=true s="collected 2 bounded values" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=15,20 bound=10
expect: => i=0 r=0.0 ok=false s="error: no bounded values" errors=1 n=2 res=[15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b <= 0 {
		gold_fail(g, "bound must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bound");
		return out;
	}
	var kept = 0;
	for i in g.n {
		if abs(g.res[i]) <= b {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 {
		gold_fail(g, "no values bounded by threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no bounded values");
		return out;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " bounded values");
	out
}
@end
