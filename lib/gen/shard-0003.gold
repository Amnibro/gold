@entry 58250f04f56346c3
kind: step
verb: limit
noun: total
modifier: sorted
context: stats
phrase: limit sorted sample total to {cap}
phrase: cap total of sorted distribution {cap}
slot: cap int
test: list=30,10,20 cap=45
expect: => i=30 r=0.0 ok=true s="limited" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25 cap=20
expect: => i=20 r=0.0 ok=true s="limited" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	// Sort ascending
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var sum = 0;
	var count = 0;
	for i in g.n {
		if sum + g.res[i] <= limit {
			sum += g.res[i];
			count++;
		} else {
			break;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = sum;
	gold_text(out, "limited");
	out
}
@end
