phrase: apply search subfunction {sub} with {reps} retries
phrase: transform search items using {sub} across {reps} attempts
slot: sub fn
slot: reps int
test: list=2,3 reps=2 sub=double
expect: => i=2 r=0.0 ok=true s="applied subfunction across 2 retry rounds" errors=0 n=2 res=[8,12] cache=0 hits=0
test: list=10,20 reps=3 sub=inc
expect: => i=2 r=0.0 ok=true s="applied subfunction across 3 retry rounds" errors=0 n=2 res=[13,23] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	for round in r {
		for i in g.n {
			g.res[i] = ${sub}(g.res[i]);
		}
	}
	g.steps += g.n * r;
	out.i = g.n;
	out.s.clear();
	format(out.s, "applied subfunction across ", r, " retry rounds");
	out
}
@end
