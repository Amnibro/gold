kind: step
verb: rank
noun: maximum
modifier: between
context: core
phrase: rank maximum value situated between bounds {low} to {high}
phrase: score largest element situated between limits {low} through {high}
slot: low int
slot: high int
test: list=12,45,23,67,19 low=20 high=50
expect: => i=45 r=0.0 ok=true s="bounded max 45" errors=0 n=5 res=[12,45,23,67,19] cache=0 hits=0
test: list=5,90,30,80 low=10 high=85
expect: => i=80 r=0.0 ok=true s="bounded max 80" errors=0 n=4 res=[5,90,30,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var max_v = -1000000;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if !found || x > max_v {
				max_v = x;
				found = true;
			}
		}
	}
	let res_val = if found { max_v } else { 0 };
	out.i = res_val;
	out.ok = found;
	out.s.clear();
	format(out.s, "bounded max ", res_val);
	g.steps += g.n;
	out
}
@end
