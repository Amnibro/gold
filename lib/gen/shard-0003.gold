fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var num = g.res[0];
	var digits int[64] = [0; 64];
	var dn = 0;
	while num > 0 {
		digits[dn] = num % 10;
		dn++;
		num /= 10;
	}
	var i = 0;
	while i < dn {
		var j = i + 1;
		while j < dn {
			if digits[i] > digits[j] {
				let tmp = digits[i];
				digits[i] = digits[j];
				digits[j] = tmp;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in dn { gold_push(g, digits[k]); }
	out.i = dn;
	g.steps += dn;
	out
}
@end
