fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var s = 0;
	let start = if g.n > k { g.n - k } else { 0 };
	var i = start;
	while i < g.n {
		s += g.res[i];
		i++;
	}
	out.i = s;
	g.steps += g.n;
	out
}
