phrase: sum gaps across first {k} sorted digits
slot: k int
test: arg=195,123 k=2
expect: 4
expect: 1
test: arg=905 k=3
expect: 9
code:
fn ${ID}(n int) int {
	let span = ${k};
	var x = if n < 0 { -n } else { n };
	var d int[20] = [0; 20];
	var len = 0;
	if x == 0 { return 0; }
	while x > 0 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	for i in len {
		for j in i + 1..len {
			if d[i] > d[j] {
				let tmp = d[i];
				d[i] = d[j];
				d[j] = tmp;
			}
		}
	}
	var total_spaces = 0;
	let limit = if span < len { span } else { len };
	if limit > 1 {
		for i in 1..limit {
			total_spaces += d[i] - d[i - 1];
		}
	}
	total_spaces
}
@end
