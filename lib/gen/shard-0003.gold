@entry 0f65e96514d6a727
kind: step
verb: dedupe
noun: gaps
modifier: pairwise
context: error
phrase: deduplicate pairwise differences across result array
phrase: record unique adjacent gaps in results
test: list=1,3,5,7
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[2] cache=0 hits=0
test: list=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise gaps");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var gaps int[512] = [0; 512];
	var gn = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		var seen = false;
		for p in gn { if gaps[p] == diff { seen = true; break; } }
		if !seen { gaps[gn] = diff; gn++; }
		k++;
	}
	gold_clear(g);
	for p in gn { gold_push(g, gaps[p]); }
	out.i = gn;
	g.steps += g.n;
	out
}
@end
