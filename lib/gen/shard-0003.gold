fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items to sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n - 1 {
		g.res[kept] = g.res[i] + g.res[i + 1];
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "summed into ", kept, " pairs");
	out
}
