modifier: recursively
context: stats
phrase: limit sample middle range recursively by {depth}
phrase: trim towards distribution middle recursively {depth} times
slot: depth int
test: list=1,2,3,4,5,6 depth=1
expect: => i=4 r=0.0 ok=true s="middle trimmed" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=10,20,30,40,50,60,70 depth=2
expect: => i=3 r=0.0 ok=true s="middle trimmed" errors=0 n=3 res=[30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if g.n <= 2 * d {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	let new_n = g.n - 2 * d;
	for i in new_n {
		g.res[i] = g.res[d + i];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	gold_text(out, "middle trimmed");
	out
}
@end
