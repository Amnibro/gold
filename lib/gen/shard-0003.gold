context: error
phrase: shift threshold checking last element against bound {bound}
phrase: test last element threshold under bound {bound}
slot: bound int
test: list=10,20,30 bound=50
expect: => i=30 r=0.0 ok=true s="" errors=0 n=3 res=[30,10,20] cache=0 hits=0
