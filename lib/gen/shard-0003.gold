code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in 0..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let min_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in 0..g.n {
		g.res[i] -= min_val;
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "sorted and subtracted minimum ", min_val);
	g.steps += g.n * g.n + 1;
	out
}
@end
