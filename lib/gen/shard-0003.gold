kind: step
verb: scale
noun: maximum
modifier: times
context: retry
phrase: scale maximum element {times} times by factor {factor}
phrase: multiply maximum value {times} times using factor {factor}
slot: times int
slot: factor int
test: list=2,5,3 times=2 factor=3
expect: => i=45 r=0.0 ok=true s="" errors=0 n=3 res=[2,45,3] cache=0 hits=0
test: list=10,20 times=1 factor=2
expect: => i=40 r=0.0 ok=true s="" errors=0 n=2 res=[10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	for i in g.n {
		if g.res[i] > g.res[max_idx] {
			max_idx = i;
		}
	}
	for step in t {
		g.res[max_idx] = g.res[max_idx] * f;
	}
	out.i = g.res[max_idx];
	g.steps += g.n + t;
	out
}
@end
