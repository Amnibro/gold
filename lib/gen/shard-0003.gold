	var out = v;
	if g.n == 0 { return out; }
	var running_max = g.res[0];
	var total_excess = 0;
	for idx in g.n {
		let cur = g.res[idx];
		if cur > running_max {
			total_excess += cur - running_max;
			running_max = cur;
		}
	}
	out.i = total_excess;
	g.steps += total_excess;
	out.s.clear();
	format(out.s, "running peak excess folded ", total_excess);
	out
}
@end
