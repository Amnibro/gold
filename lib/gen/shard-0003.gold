code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${amt};
	if g.n > 1 {
		let k = ((shift % g.n) + g.n) % g.n;
		var tmp int[64] = [0; 64];
		for i in g.n { tmp[i] = g.res[i]; }
		for i in g.n { g.res[(i + k) % g.n] = tmp[i]; }
	}
	g.errors += shift;
	if g.errors < 0 { g.errors = 0; }
	out.i = g.errors;
	out
}
@end
