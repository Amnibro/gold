code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200] = [];
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels.push(b);
		}
	}
	for i in vowels.len {
		for j in vowels.len - 1 - i {
			if vowels[j] > vowels[j + 1] {
				let tmp = vowels[j];
				vowels[j] = vowels[j + 1];
				vowels[j + 1] = tmp;
			}
		}
	}
	out.s.clear();
	for i in vowels.len {
		out.s.push(vowels[i]);
	}
	out.i = vowels.len;
	g.steps += out.s.len;
	out
}
@end
