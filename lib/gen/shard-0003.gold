phrase: adjust first {count} observations using their local minimum
slot: count int
test: list=15,20,10,30 count=3
expect: => i=10 r=0.0 ok=true s="subtracted minimum 10 across 3 head items" errors=0 n=4 res=[5,10,0,30] cache=0 hits=0
test: list=50,70,40,60 count=4
expect: => i=40 r=0.0 ok=true s="subtracted minimum 40 across 4 head items" errors=0 n=4 res=[10,30,0,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if g.n == 0 || c <= 0 {
		return out;
	}
	let end = if c < g.n { c } else { g.n };
	var min_val = g.res[0];
	for k in end {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	for k in end {
		g.res[k] -= min_val;
	}
	g.steps += end * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "subtracted minimum ", min_val, " across ", end, " head items");
	out
}
@end
@entry 0a5615519fc64355
kind: step
verb: swap
noun: spaces
modifier: pairwise
context: stats
phrase: swap observation spaces pairwise
phrase: exchange adjacent interval spaces pairwise
test: list=10,12,20,23
expect: => i=1 r=0.0 ok=true s="swapped 1 spaces pairwise" errors=0 n=3 res=[8,2,3] cache=0 hits=0
test: list=1,10,12,25,30
expect: => i=2 r=0.0 ok=true s="swapped 2 spaces pairwise" errors=0 n=4 res=[2,9,5,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for pairwise spaces");
		return out;
	}
	let m = g.n - 1;
	var spaces int[512] = [0; 512];
	for k in m {
		spaces[k] = g.res[k + 1] - g.res[k];
	}
	var swaps = 0;
	var k = 0;
	while k + 1 < m {
		let tmp = spaces[k];
		spaces[k] = spaces[k + 1];
		spaces[k + 1] = tmp;
		swaps++;
		k += 2;
	}
	for i in m {
		g.res[i] = spaces[i];
	}
	g.n = m;
	g.steps += m * 2;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " spaces pairwise");
	out
}
@end
@entry 765b63ac14aef266
kind: step
verb: rotate
noun: series
modifier: every_other
context: stats
phrase: rotate alternating elements across series
phrase: shift every other series value cyclically
test: list=10,20,30,40,50,60
expect: => i=6 r=0.0 ok=true s="rotated alternating elements across 6 items" errors=0 n=6 res=[50,20,10,40,30,60] cache=0 hits=0
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="rotated alternating elements across 5 items" errors=0 n=5 res=[5,2,1,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 4 {
		var last_idx = if (g.n - 1) % 2 == 0 { g.n - 1 } else { g.n - 2 };
		let saved = g.res[last_idx];
		var k = last_idx;
		while k >= 2 {
			g.res[k] = g.res[k - 2];
			k -= 2;
		}
		g.res[0] = saved;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated alternating elements across ", g.n, " items");
	out
}
@end
@entry 70225713fa09233d
kind: step
verb: rotate
noun: checkpoint
modifier: none
context: stats
phrase: rotate series around middle checkpoint
phrase: cyclic rotate series data about midpoint
test: list=10,20,30,40,50
expect: => i=2 r=0.0 ok=true s="rotated series around checkpoint 2" errors=0 n=5 res=[30,40,50,10,20] cache=0 hits=0
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="rotated series around checkpoint 2" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let mid = g.n / 2;
		var tmp int[512] = [0; 512];
		for i in g.n {
			tmp[i] = g.res[(i + mid) % g.n];
		}
		for i in g.n {
			g.res[i] = tmp[i];
		}
	}
	g.steps += g.n * 2;
	out.i = g.n / 2;
	out.s.clear();
	format(out.s, "rotated series around checkpoint ", out.i);
	out
}
@end
@entry 0141faf94f8d33fb
kind: step
verb: check
noun: step
modifier: times
context: stats
phrase: check if series steps exceed {diff} at least {k} times
phrase: verify consecutive jumps larger than {diff} happen {k} times
slot: diff int
slot: k int
test: list=10,20,35,40 diff=8 k=2
expect: => i=2 r=0.0 ok=true s="found 2 steps larger than 8" errors=0 n=4 res=[10,20,35,40] cache=0 hits=0
test: list=5,10,12,14 diff=6 k=1
expect: => i=0 r=0.0 ok=false s="found 0 steps larger than 6" errors=0 n=4 res=[5,10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_jump = ${diff};
	let needed = ${k};
	var jumps = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let d = g.res[i + 1] - g.res[i];
			let abs_d = if d < 0 { -d } else { d };
			if abs_d > min_jump {
				jumps++;
			}
		}
	}
	g.steps += g.n;
	out.i = jumps;
	out.ok = jumps >= needed;
	out.s.clear();
	format(out.s, "found ", jumps, " steps larger than ", min_jump);
	out
}
@end
