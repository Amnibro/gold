test: list=1,2,3,1,4,2 max_lookback=3
expect: => i=1 r=0.0 ok=true s="found 1 history repetitions within 3" errors=0 n=6 res=[1,2,3,1,4,2] cache=0 hits=0
test: list=5,6,7,5,8 max_lookback=2
expect: => i=0 r=0.0 ok=true s="found 0 history repetitions within 2" errors=0 n=5 res=[5,6,7,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lookback = ${max_lookback};
	var dup_count = 0;
	for i in g.n {
		let start = if i > lookback { i - lookback } else { 0 };
		var j = start;
		while j < i {
			if g.res[j] == g.res[i] {
				dup_count += 1;
				break;
			}
			j += 1;
		}
	}
	g.steps += g.n;
	out.i = dup_count;
	out.s.clear();
	format(out.s, "found ", dup_count, " history repetitions within ", lookback);
	out
}
@end
