fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = v.i;
	var running = 0;
	var found_idx = -1;
	var p = g.n - 1;
	while p >= 0 {
		running += g.res[p];
		if running >= threshold {
			found_idx = p;
			break;
		}
		p--;
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	g.steps += g.n - p;
	out.s.clear();
	format(out.s, "reverse total threshold index ", found_idx);
	out
}
@end
