@entry ff25723939f0d02c
kind: step
verb: drop
noun: gaps
modifier: each
context: cache
phrase: drop large gaps exceeding {limit} caching count
phrase: filter gaps over {limit} recording dropped in cache
slot: limit int
test: list=10,12,30,32 limit=5
expect: => i=1 r=0.0 ok=true s="gaps dropped and cached" errors=0 n=3 res=[10,12,32] cache=1 hits=0
test: list=1,2,10,11 limit=3
expect: => i=1 r=0.0 ok=true s="gaps dropped and cached" errors=0 n=3 res=[1,2,11] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var dropped = 0;
	var kept = 1;
	if g.n >= 2 {
		for i in g.n - 1 {
			let gap = g.res[i + 1] - g.res[i];
			if gap > lim {
				gold_cache_put(g, dropped, gap);
				dropped++;
			} else {
				g.res[kept] = g.res[i + 1];
				kept++;
			}
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = dropped;
	gold_text(out, "gaps dropped and cached");
	out
}
@end
