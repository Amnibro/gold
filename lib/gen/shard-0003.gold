test: list=2,4,6 val=10
expect: => i=10 r=0.0 ok=true s="filled range in reverse with 10" errors=0 n=4 res=[6,4,2,10] cache=0 hits=0
test: list=2,4 val=-1
expect: => i=0 r=0.0 ok=false s="error: negative value" errors=1 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let x = ${val};
	if x < 0 {
		gold_fail(g, "invalid negative fill value");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative value");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty range results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty range");
		return out;
	}
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	gold_push(g, x);
	g.steps += g.n;
	out.i = x;
	out.s.clear();
	format(out.s, "filled range in reverse with ", x);
	out
}
@end
