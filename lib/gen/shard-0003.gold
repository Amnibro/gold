fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var errs = 0;
	for i in g.n {
		let res_val = ${f}(g.res[i]);
		g.res[i] = res_val;
		if ${bad}(res_val) {
			errs += 1;
		}
	}
	if errs > lim {
		gold_fail(g, "mapped errors exceeded threshold");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = errs;
	out.s.clear();
	format(out.s, "mapped list with ", errs, " errors");
	out
}
