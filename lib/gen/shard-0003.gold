test: list=5,10,15,20
expect: => i=4 r=0.0 ok=true s="filtered with cache 4 items" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let cached_val, found = gold_cache_get(g, x);
		if found {
			g.res[kept] = cached_val;
			kept++;
		} else {
			let computed = x * 2;
			gold_cache_put(g, x, computed);
			g.res[kept] = computed;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered with cache ", kept, " items");
	g.steps += kept;
	out
}
@end
