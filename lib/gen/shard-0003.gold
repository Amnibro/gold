code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lens int[512] = [0; 512];
	var ln = 0;
	var cur = 0;
	for i in out.s.len {
		if out.s[i] == 32 {
			if cur > 0 {
				lens[ln] = cur;
				ln++;
				cur = 0;
			}
		} else {
			cur++;
		}
	}
	if cur > 0 {
		lens[ln] = cur;
		ln++;
	}
	var i = 0;
	while i < ln {
		var j = i + 1;
		while j < ln {
			if lens[i] > lens[j] {
				let tmp = lens[i];
				lens[i] = lens[j];
				lens[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let f = ${factor};
	gold_clear(g);
	for k in ln { gold_push(g, lens[k] * f); }
	out.i = ln;
	g.steps += out.s.len;
	out
}
@end
@entry a36a7368e01f6a99
kind: step
verb: sort
noun: loop
modifier: in_place
context: sort
phrase: sort result array strictly in place
phrase: order elements ascending using loop in place
test: list=9,1,8,2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,8,9] cache=0 hits=0
test: list=15,3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 1;
	while i < g.n {
		let key = g.res[i];
		var j = i - 1;
		while j >= 0 && g.res[j] > key {
			g.res[j + 1] = g.res[j];
			j--;
		}
		g.res[j + 1] = key;
		i++;
	}
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
