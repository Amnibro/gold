code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wlen = ${word_len};
	let t = ${times};
	let effective_len = if wlen < g.n { wlen } else { g.n };
	var temp: int[64] = [0; 64];
	for k in effective_len {
		if k < 64 { temp[k] = g.res[k]; }
	}
	gold_clear(g);
	for round in t {
		for k in effective_len {
			gold_push(g, temp[k]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected word of length ", effective_len, " repeated ", t, " times");
	out
}
