expect: 1
expect: 2
code:
fn ${ID}(n int) int {
	if n <= 0 {
		return 0;
	}
	var val = n;
	var max_run = 1;
	var cur_run = 1;
	var prev = val % 10;
	val /= 10;
	while val > 0 {
		var curr = val % 10;
		if curr == prev {
			cur_run++;
		} else {
			if cur_run > max_run {
				max_run = cur_run;
			}
			cur_run = 1;
			prev = curr;
		}
		val /= 10;
	}
	if cur_run > max_run {
		max_run = cur_run;
	}
	var cap = ${max_len};
	if max_run > cap {
		return cap;
	}
	return max_run;
}
@end
