kind: step
verb: reverse
noun: subfunction
modifier: between
context: retry
phrase: reverse subfunction between start {start} to stop {stop}
phrase: invert retry window between {start} to {stop}
slot: start int
slot: stop int
test: list=10,20,30,40,50 start=1 stop=3
expect: => i=1 r=0.0 ok=true s="reversed 1 subfunction retry slots" errors=0 n=5 res=[10,40,30,20,50] cache=0 hits=0
test: list=1,2,3,4,5 start=0 stop=2
expect: => i=1 r=0.0 ok=true s="reversed 1 subfunction retry slots" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var l = ${start};
	var r = ${stop};
	if l < 0 { l = 0; }
	if r >= g.n { r = g.n - 1; }
	var count = 0;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
		count++;
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed ", count, " subfunction retry slots");
	g.steps += count + 1;
	out
}
@end
@entry 819eeb9272be5b77
kind: step
verb: dedupe
noun: step
modifier: unique
context: retry
phrase: dedupe step unique retry delay entries
phrase: remove duplicate retry delay steps
