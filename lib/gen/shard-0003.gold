@entry 97f7d469952ea206
kind: step
verb: sort
noun: histogram
modifier: every_other
context: filter
phrase: sort alternating histogram buckets every other index
phrase: order every other bucket in histogram series
test: list=5,1,8,2,3,9
expect: => i=2 r=0.0 ok=true s="" errors=0 n=6 res=[3,1,5,2,8,9] cache=0 hits=0
test: list=10,4,30,2,20,1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=6 res=[10,4,20,2,30,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var changed = true;
	while changed {
		changed = false;
		var i = 0;
		while i + 2 < g.n {
			if g.res[i] > g.res[i + 2] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 2];
				g.res[i + 2] = tmp;
				swaps++;
				changed = true;
			}
			i += 2;
		}
	}
	out.i = swaps;
	g.steps += swaps + g.n;
	out
}
@end
