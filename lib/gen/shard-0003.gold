expect: => i=30 r=0.0 ok=true s="swapped middle item" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
test: list=1,2,3,4
expect: => i=3 r=0.0 ok=true s="swapped middle item" errors=0 n=4 res=[1,2,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough elements to swap");
		return out;
	}
	let mid = g.n / 2;
	let last = g.n - 1;
	let tmp = g.res[mid];
	g.res[mid] = g.res[last];
	g.res[last] = tmp;
	g.steps += 1;
	out.i = tmp;
	out.s.clear();
	format(out.s, "swapped middle item");
	out
}
@end
@entry 57c0b1d540a00f92
kind: step
verb: group
noun: budget
modifier: each
context: math
phrase: group budget each bucket size {size}
phrase: partition into blocks of size {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=3 r=0.0 ok=true s="grouped into 3 block sums" errors=0 n=3 res=[3,7,11] cache=0 hits=0
test: list=10,20,30,40 size=3
expect: => i=2 r=0.0 ok=true s="grouped into 2 block sums" errors=0 n=2 res=[60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 {
		out.ok = false;
		gold_fail(g, "invalid bucket size");
		return out;
	}
	var blocks = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var j = 0;
		while j < sz && (i + j) < g.n {
			sum += g.res[i + j];
			j++;
		}
		g.res[blocks] = sum;
		blocks++;
		i += sz;
	}
	g.steps += g.n;
	g.n = blocks;
	out.i = blocks;
	out.s.clear();
	format(out.s, "grouped into ", blocks, " block sums");
	out
}
@end
