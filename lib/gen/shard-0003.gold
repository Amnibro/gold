fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if b <= 0 {
		gold_fail(g, "invalid bound value");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bound");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty values to compare");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty values");
		return out;
	}
	for i in g.n {
		if abs(g.res[i]) > b {
			gold_fail(g, "value exceeds bound limit");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: value ", g.res[i], " exceeds ", b);
			return out;
		}
	}
	g.steps += g.n;
	out.i = b;
	out.s.clear();
	format(out.s, "all values bounded by ", b);
	out
}
@end
