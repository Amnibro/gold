fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let count = if lim < g.n { lim } else { g.n };
	var total = 0;
	for i in count {
		total += g.res[i];
	}
	out.i = total;
	if count > 0 {
		out.r = (total as real) / (count as real);
	} else {
		out.r = 0.0;
	}
	g.steps += count;
	out.s.clear();
	format(out.s, "measured sum ", total, " across ", count, " results");
	out
}
@end
