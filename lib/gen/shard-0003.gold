@entry 7237d623db2bf772
kind: step
verb: rank
noun: list
modifier: unique
context: list
phrase: rank unique elements of list by magnitude
phrase: order distinct values with unique ranks
test: list=4,2,2,8,4
expect: => i=3 r=0.0 ok=true s="ranked unique elements count 3" errors=0 n=3 res=[2,4,8] cache=0 hits=0
test: list=10,5,10,20
expect: => i=3 r=0.0 ok=true s="ranked unique elements count 3" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	for a in kept {
		for b in kept - 1 {
			if g.res[b] > g.res[b + 1] {
				let tmp = g.res[b];
				g.res[b] = g.res[b + 1];
				g.res[b + 1] = tmp;
			}
		}
	}
	g.n = kept;
	g.steps += g.n * 2;
	out.i = kept;
	out.s.clear();
	format(out.s, "ranked unique elements count ", kept);
	out
}
@end
