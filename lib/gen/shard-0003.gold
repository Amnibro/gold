code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	format(out.s, "sorted ", g.n, " items");
	out.i = g.n;
	g.steps += g.n * g.n;
	out
}
@end
@entry b034928d16fe81c0
kind: step
verb: dedupe
noun: range
modifier: at_least
context: format
phrase: dedupe range of items keeping frequency at least {min_freq}
phrase: retain deduplicated values appearing at least {min_freq} times
slot: min_freq int
test: list=2,2,3,4,4,4 min_freq=2
expect: => i=2 r=0.0 ok=true s="deduped count 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=1,1,1,2,3 min_freq=3
expect: => i=1 r=0.0 ok=true s="deduped count 1" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for k in g.n { if g.res[k] == x { freq++; } }
			if freq >= mf {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped count ", w);
	g.steps += g.n;
	out
}
@end
