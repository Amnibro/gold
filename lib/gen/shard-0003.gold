code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${req_runs};
	var runs = 0;
	var i = 0;
	while i < g.n {
		runs++;
		var j = i;
		while j + 1 < g.n && g.res[j] <= g.res[j + 1] {
			j++;
		}
		i = j + 1;
	}
	out.ok = runs >= req;
	out.i = runs;
	out.s.clear();
	format(out.s, "validated ", runs, " monotonic runs");
	g.steps += g.n;
	out
}
@end
