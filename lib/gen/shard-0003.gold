code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${min_prime};
	if mp < 2 {
		gold_fail(g, "threshold under two for primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid threshold");
		return out;
	}
	var found = false;
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= mp {
			found = true;
			matched = x;
			break;
		}
	}
	if !found {
		gold_fail(g, "no primes meet threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no match");
		return out;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "prime meets threshold ", matched);
	out
}
@end
