@entry 84fb09b8969bc003
kind: step
verb: repeat
noun: spaces
modifier: times
context: cache
phrase: scale adjacent element spacing by factor {times}
phrase: expand consecutive gaps by multiplier {times} in cache
slot: times int
test: list=1,2,4,7 times=2
expect: => i=4 r=0.0 ok=true s="scaled spaces across 4 items" errors=0 n=4 res=[1,3,7,13] cache=3 hits=0
test: list=10,12,15 times=3
expect: => i=3 r=0.0 ok=true s="scaled spaces across 3 items" errors=0 n=3 res=[10,16,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${times};
	if g.n > 1 {
		var prev = g.res[0];
		for i in 1..g.n {
			let curr = g.res[i];
			let diff = curr - prev;
			let new_diff = diff * mult;
			gold_cache_put(g, i, new_diff);
			g.res[i] = g.res[i - 1] + new_diff;
			prev = curr;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled spaces across ", g.n, " items");
	out
}
@end
