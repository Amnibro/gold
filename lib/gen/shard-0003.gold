fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var allowed_zeroes = ${retries};
	var valid = 0;
	for i in g.n {
		if g.res[i] != 0 {
			valid += 1;
		} else if allowed_zeroes > 0 {
			allowed_zeroes -= 1;
		}
	}
	g.steps += g.n;
	out.i = valid;
	out.s.clear();
	format(out.s, "counted ", valid, " valid values");
	out
}
