	if g.n == 0 {
		return out;
	}
	let head_val = ${f}(g.res[0]);
	var kept = 0;
	for i in g.n {
		if ${f}(g.res[i]) == head_val {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " items matching head target ", head_val);
	out
}
@end
