expect: => i=13 r=0.0 ok=true s="" errors=0 n=7 res=[11,12,13,14,15,16,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var s = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { s += x; }
		}
	}
	if s == 0 { s = 1; }
	out.i = s;
	out
}
@end
