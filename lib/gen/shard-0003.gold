fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_pairs = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			let val, ok = gold_cache_get(g, diff);
			if !ok {
				gold_cache_put(g, diff, 1);
				unique_pairs++;
			} else {
				gold_cache_put(g, diff, val + 1);
			}
		}
	}
	g.steps += g.n;
	out.i = unique_pairs;
	out.s.clear();
	format(out.s, "scanned ", unique_pairs, " unique pair differences");
	out
}
