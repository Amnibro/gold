code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	var capped = 0;
	var k = 0;
	while k < g.n {
		if g.res[k] % 2 != 0 && g.res[k] > ceiling {
			g.res[k] = ceiling;
			capped++;
		}
		k += 2;
	}
	g.steps += g.n;
	out.i = capped;
	out.s.clear();
	format(out.s, "capped ", capped, " alternating odd items");
	out
}
@end
