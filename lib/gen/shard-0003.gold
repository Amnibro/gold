expect: => i=3 r=0.0 ok=true s="preserved 3 items within gap" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_g = ${max_gap};
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "no gaps to check");
		return out;
	}
	var kept = 1;
	while kept < g.n {
		let gap = g.res[kept] - g.res[kept - 1];
		if gap > max_g {
			break;
		}
		kept++;
	}
	g.steps += kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "preserved ", kept, " items within gap");
	out
}
@end
