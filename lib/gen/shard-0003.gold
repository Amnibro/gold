code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${thresh};
	let limit = ${cap};
	var count = 0;
	for i in g.n {
		if g.res[i] > t {
			count++;
			if count == limit {
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "tallied ", count, " items above threshold");
	out
}
@end
@entry aa8dc31fa69a18a4
kind: step
verb: limit
noun: series
modifier: sorted
context: stats
phrase: limit series to smallest {k} sorted items
phrase: extract first {k} values from sorted series
slot: k int
test: list=40,10,30,20 k=2
expect: => i=2 r=0.0 ok=true s="limited to 2 sorted items" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=50,15,35,5 k=3
expect: => i=3 r=0.0 ok=true s="limited to 3 sorted items" errors=0 n=3 res=[5,15,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if g.n >= 2 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	if limit >= 0 && limit < g.n {
		g.n = limit;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited to ", g.n, " sorted items");
	out
}
@end
