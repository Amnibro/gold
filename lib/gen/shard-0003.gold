	if g.n > 1 {
		let base = g.res[0];
		var i = 1;
		while i < g.n {
			g.res[i] += base;
			i++;
		}
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	g.steps += g.n;
	out
}
@end
