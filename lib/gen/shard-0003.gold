code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var kept = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "pairwise history kept ", kept);
	out
}
@end
