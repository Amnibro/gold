test: list=10,50,20 limit=100
expect: => i=50 r=0.0 ok=true s="cached maximum 50" errors=0 n=3 res=[10,50,20] cache=1 hits=0
test: list=10,50 limit=20
expect: => i=0 r=0.0 ok=false s="error: maximum 50 exceeds 20" errors=1 n=2 res=[10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "cannot find maximum in empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] > mx {
			mx = g.res[i];
		}
	}
	if mx > lim {
		gold_fail(g, "maximum exceeds threshold limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: maximum ", mx, " exceeds ", lim);
		return out;
	}
	gold_cache_put(g, 0, mx);
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
	format(out.s, "cached maximum ", mx);
	out
}
@end
