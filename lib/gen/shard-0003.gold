	let limit = ${floor};
	var run = 0;
	while run < g.n && g.res[run] >= limit {
		run += 1;
	}
	g.steps += run;
	out.i = run;
	out.s.clear();
	format(out.s, "running length above threshold is ", run);
	out
}
