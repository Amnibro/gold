fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var write_idx = 0;
	for i in g.n {
		var seen = false;
		for j in write_idx {
			if g.res[j] == g.res[i] {
				seen = true;
			}
		}
		if !seen {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = write_idx;
	g.steps += g.n + r;
	out
}
@end
