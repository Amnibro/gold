fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[32] = [0; 32];
	var ulen = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var j = 0;
		while j < ulen {
			if uniq[j] == g.res[i] { seen = true; break; }
			j++;
		}
		if !seen { uniq[ulen] = g.res[i]; ulen++; }
		i++;
	}
	var sum = 0;
	var k = 0;
	while k + 1 < ulen {
		sum += uniq[k] + uniq[k + 1];
		k += 2;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "unique pairs sum: ", sum);
	g.steps += ulen;
	out
}
@end
