fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_drop = 3;
	var dropped = 0;
	if g.n >= min_drop {
		dropped = min_drop;
		for i in 0..(g.n - min_drop) {
			g.res[i] = g.res[i + min_drop];
		}
		g.n -= min_drop;
	}
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped at least ", dropped, " letter codes");
	g.steps += dropped + 1;
	out
}
@end
