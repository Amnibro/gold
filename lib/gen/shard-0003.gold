	var kept int[512] = [0; 512];
	var kn = 0;
	for k in g.n {
		let x = g.res[k];
		kept[kn] = x;
		kn++;
		if x > limit {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
