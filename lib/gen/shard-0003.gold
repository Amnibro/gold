expect: => i=2 r=0.0 ok=true s="histogram max frequency 2" errors=0 n=4 res=[10,10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	var max_freq = 0;
	var attempts = 0;
	while attempts < r {
		for i in g.n {
			var freq = 0;
			for j in g.n {
				if g.res[j] == g.res[i] {
					freq++;
				}
			}
			if freq > max_freq {
				max_freq = freq;
			}
		}
		attempts++;
	}
	g.steps += attempts * g.n;
	out.i = max_freq;
	out.s.clear();
	format(out.s, "histogram max frequency ", max_freq);
	out
}
@end
@entry 1aa7d0c9a9c82614
kind: step
verb: validate
noun: items
modifier: with_cache
context: math
phrase: validate result items through cache verification
phrase: check sequence elements against cached values
test: list=2,4,6
expect: => i=1 r=0.0 ok=true s="all items verified in cache" errors=0 n=3 res=[2,4,6] cache=3 hits=0
test: list=1,3,5
expect: => i=0 r=0.0 ok=false s="cache verification found invalid item" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_valid = true;
	for k in g.n {
		let x = g.res[k];
		let is_even = x % 2 == 0;
		if is_even {
			gold_cache_put(g, x, 1);
		} else {
			all_valid = false;
		}
	}
	out.ok = all_valid;
	out.i = if all_valid { 1 } else { 0 };
	out.s.clear();
	if all_valid {
		format(out.s, "all items verified in cache");
	} else {
		format(out.s, "cache verification found invalid item");
	}
	g.steps += g.n;
	out
}
@end
@entry 885e9a3b876db0fe
kind: step
verb: sort
noun: histogram
modifier: all
context: math
phrase: sort complete histogram frequencies ascending
phrase: order all histogram counts of sequence
test: list=3,1,2,3,2,3
expect: => i=3 r=0.0 ok=true s="sorted histogram unique bins 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=9,9,5,7,7,7
expect: => i=3 r=0.0 ok=true s="sorted histogram unique bins 3" errors=0 n=3 res=[5,9,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var u_vals: int[512] = [0; 512];
	var u_cnts: int[512] = [0; 512];
	var u_n = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var cnt = 0;
		while i < g.n && g.res[i] == val {
			cnt++;
			i++;
		}
		u_vals[u_n] = val;
		u_cnts[u_n] = cnt;
		u_n++;
	}
	for a in u_n {
		for b in u_n - 1 {
			if u_cnts[b] > u_cnts[b + 1] {
				let tc = u_cnts[b];
				u_cnts[b] = u_cnts[b + 1];
				u_cnts[b + 1] = tc;
				let tv = u_vals[b];
				u_vals[b] = u_vals[b + 1];
				u_vals[b + 1] = tv;
			}
		}
	}
	for k in u_n {
		g.res[k] = u_vals[k];
	}
	g.n = u_n;
	g.steps += g.n * 2;
	out.i = u_n;
	out.s.clear();
	format(out.s, "sorted histogram unique bins ", u_n);
	out
}
@end
@entry e0f4eb7086afb23b
kind: step
verb: fold
noun: head
modifier: first
context: math
phrase: fold head of {count} numbers into sum
phrase: accumulate initial head segment of {count} values
slot: count int
test: list=10,20,30,40 count=2
expect: => i=30 r=0.0 ok=true s="folded head sum 30" errors=0 n=3 res=[30,30,40] cache=0 hits=0
test: list=5,15,25,35 count=3
expect: => i=45 r=0.0 ok=true s="folded head sum 45" errors=0 n=2 res=[45,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let limit = if c < g.n { c } else { g.n };
	if limit <= 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for k in limit {
		sum += g.res[k];
	}
	var new_n = 1;
	g.res[0] = sum;
	var j = limit;
	while j < g.n {
		g.res[new_n] = g.res[j];
		new_n++;
		j++;
	}
	g.n = new_n;
	g.steps += limit;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded head sum ", sum);
	out
}
@end
