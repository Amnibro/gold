test: list=5,5,8,9,9
expect: => i=2 r=0.0 ok=true s="pairs dropped and cached" errors=0 n=1 res=[8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	var i = 0;
	while i < g.n {
		if i + 1 < g.n && g.res[i] == g.res[i + 1] {
			gold_cache_put(g, dropped, g.res[i]);
			dropped++;
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	gold_text(out, "pairs dropped and cached");
	out
}
@end
