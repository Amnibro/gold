expect: => i=-40 r=0.0 ok=true s="reversed numbers total backward diff -40" errors=0 n=4 res=[50,35,20,10] cache=0 hits=0
test: list=5,15,30
expect: => i=-25 r=0.0 ok=true s="reversed numbers total backward diff -25" errors=0 n=3 res=[30,15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	var diff_sum = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			diff_sum += g.res[i + 1] - g.res[i];
		}
	}
	g.steps += g.n * 2;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "reversed numbers total backward diff ", diff_sum);
	out
}
@end
