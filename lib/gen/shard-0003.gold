fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var tn = 0;
	var match_idx = 0;
	for i in g.n {
		let x = g.res[i];
		temp[tn] = x;
		tn++;
		if ${p}(x) {
			if match_idx % 2 == 0 && tn < 512 {
				temp[tn] = x;
				tn++;
			}
			match_idx++;
		}
	}
	for j in tn { g.res[j] = temp[j]; }
	g.n = tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "every other repeated size ", tn);
	g.steps += tn;
	out
}
@end
