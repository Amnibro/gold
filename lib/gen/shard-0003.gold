slot: threshold int
test: list=5,8,20,24,50 threshold=10
expect: => i=2 r=0.0 ok=true s="gaps recorded" errors=0 n=2 res=[12,26] cache=0 hits=0
test: list=1,2,15,16 threshold=5
expect: => i=1 r=0.0 ok=true s="gaps recorded" errors=0 n=1 res=[13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.n < 2 {
		gold_clear(g);
		out.i = 0;
		return out;
	}
	var gaps_count = 0;
	for i in g.n - 1 {
		let gap = g.res[i + 1] - g.res[i];
		if gap >= th {
			g.res[gaps_count] = gap;
			gaps_count++;
		}
	}
	g.n = gaps_count;
	g.steps += gaps_count;
	out.i = gaps_count;
	gold_text(out, "gaps recorded");
	out
}
@end
@entry 1d946a31bf5ffaa0
kind: step
verb: drop
noun: squares
modifier: unique
context: stats
phrase: drop square measurements from results
phrase: remove squared values from distribution
test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="squares dropped" errors=0 n=2 res=[7,12] cache=0 hits=0
test: list=2,3,25,30,36
expect: => i=2 r=0.0 ok=true s="squares dropped" errors=0 n=3 res=[2,3,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0;
			while r * r < x {
				r++;
			}
			if r * r == x {
				is_sq = true;
			}
		}
		if !is_sq {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += kept;
	out.i = dropped;
	gold_text(out, "squares dropped");
	out
}
@end
