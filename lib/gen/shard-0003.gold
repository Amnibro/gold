code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${st};
	let end = ${en};
	var w = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if i > start && i <= end && x == g.res[i - 1] {
			dropped++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped between dropped ", dropped);
	g.steps += g.n;
	out
}
@end
