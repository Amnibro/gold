fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let count = g.n - 1;
		for i in count {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			g.res[i] = diff;
		}
		g.n = count;
		out.i = count;
		out.s.clear();
		format(out.s, "computed ", count, " search gap intervals");
	} else {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient search entries");
	}
	g.steps += g.n;
	out
}
@end
