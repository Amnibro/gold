@entry d53dedef14bb1b30
kind: step
verb: rotate
noun: average
modifier: in_reverse
context: cache
phrase: rotate cached values in reverse updating average
phrase: cycle memo entries backwards computing mean
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15
expect: => i=10 r=0.0 ok=true s="" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	if g.cn > 1 {
		let last = g.cv[g.cn - 1];
		var i = g.cn - 1;
		while i > 0 {
			g.cv[i] = g.cv[i - 1];
			i--;
		}
		g.cv[0] = last;
	}
	var total = 0;
	for i in g.cn { total += g.cv[i]; }
	let avg = if g.cn > 0 { total / g.cn } else { 0 };
	out.i = avg;
	g.steps += g.cn;
	out
}
@end
