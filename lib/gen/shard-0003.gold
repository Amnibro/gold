		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero offset");
		return out;
	}
	g.res[g.n - 1] += off;
	g.steps += 1;
	out.i = g.res[g.n - 1];
	out.s.clear();
	format(out.s, "shifted last range to ", out.i);
	out
}
@end
