fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	var valid_steps = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff >= min_gap {
			valid_steps += 1;
		}
		i += 1;
	}
	g.steps += i;
	out.i = valid_steps;
	out.s.clear();
	format(out.s, "counted ", valid_steps, " steps above gap");
	out
}
