phrase: sum memo taking every other entry
phrase: accumulate alternate memo values
test: list=1,2,3,4,5
expect: => i=9 r=0.0 ok=true s="alternate memo sum is 9" errors=0 n=1 res=[9] cache=0 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty memo" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty memo to sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty memo");
		return out;
	}
	var tot = 0;
	var i = 0;
	while i < g.n {
		tot += g.res[i];
		i += 2;
	}
	g.res[0] = tot;
	g.n = 1;
	g.steps += 1;
	out.i = tot;
	out.s.clear();
	format(out.s, "alternate memo sum is ", tot);
	out
}
@end
