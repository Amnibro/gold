@entry fa6be1669b25605b
kind: step
verb: rotate
noun: value
modifier: each
context: cache
phrase: rotate each cached value forward
phrase: cycle memo entries one position ahead
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15
expect: => i=15 r=0.0 ok=true s="" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	if g.cn > 1 {
		let first = g.cv[0];
		var i = 0;
		while i + 1 < g.cn {
			g.cv[i] = g.cv[i + 1];
			i++;
		}
		g.cv[g.cn - 1] = first;
	}
	out.i = if g.cn > 0 { g.cv[0] } else { 0 };
	g.steps += g.cn;
	out
}
@end
@entry 8ae25c7277953744
kind: step
verb: clamp
noun: runs
modifier: recursively
context: cache
phrase: clamp consecutive run lengths in cache to {cap}
phrase: bound repeated run counts in memo by {cap}
slot: cap int
test: list=1,1,1,2,2,3 cap=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[1,1,1,2,2,3] cache=3 hits=0
test: list=5,5,5,5,5 cap=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=5 res=[5,5,5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var runs = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			if cur_len > limit { cur_len = limit; }
			gold_cache_put(g, runs, cur_len);
			runs++;
			cur_len = 1;
		}
	}
	if g.n > 0 {
		if cur_len > limit { cur_len = limit; }
		gold_cache_put(g, runs, cur_len);
		runs++;
	}
	out.i = runs;
	g.steps += g.n;
	out
}
@end
@entry 49aa798c6e263642
kind: step
verb: trace
noun: primes
modifier: with_cache
context: cache
phrase: trace prime status of results using cache
phrase: check memoizing prime numbers from list
test: list=7,11,14
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[7,11,14] cache=3 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[4,6,8] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		gold_cache_put(g, x, if is_p { 1 } else { 0 });
		if is_p { primes++; }
	}
	out.i = primes;
	g.steps += g.n;
	out
}
@end
@entry f61005ca905b3f2f
kind: step
verb: filter
noun: budget
modifier: every_other
context: cache
phrase: cache alternate items while under budget {b}
phrase: store every other result bounded by budget {b}
slot: b int
test: list=10,5,20,15,30 b=40
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[10,5,20,15,30] cache=2 hits=0
test: list=5,2,8,3 b=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[5,2,8,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${b};
	var spent = 0;
	var stored = 0;
	var k = 0;
	while k < g.n {
		let x = g.res[k];
		if spent + x <= limit {
			gold_cache_put(g, stored, x);
			spent += x;
			stored++;
		} else {
			break;
		}
		k += 2;
	}
	out.i = stored;
	g.steps += g.n;
	out
}
@end
