fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stp = ${steps};
	if g.n > 1 && stp > 0 {
		for s in stp {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
