phrase: measure window occurrences for size {win_size} with ceiling {cap}
slot: win_size int
slot: cap int
test: list=1,2,-3,4,5 win_size=3 cap=2
expect: => i=2 r=0.0 ok=true s="window positive count capped at 2" errors=0 n=5 res=[1,2,-3,4,5] cache=0 hits=0
test: list=-1,5,6,7 win_size=2 cap=3
expect: => i=2 r=0.0 ok=true s="window positive count capped at 2" errors=0 n=4 res=[-1,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wsz = ${win_size};
	let max_c = ${cap};
	var max_found = 0;
	var i = 0;
	while i + wsz <= g.n {
		var cnt = 0;
		for k in wsz {
			if g.res[i + k] > 0 { cnt += 1; }
		}
		if cnt > max_found { max_found = cnt; }
		i += 1;
	}
	if max_found > max_c { max_found = max_c; }
	g.steps += g.n;
	out.i = max_found;
	out.s.clear();
	format(out.s, "window positive count capped at ", max_found);
	out
}
@end
