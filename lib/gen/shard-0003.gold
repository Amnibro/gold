code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var max_idx = 0;
	var max_val = -999999;
	var any_exceeds = false;
	for k in g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			max_idx = k;
		}
		if g.res[k] > th { any_exceeds = true; }
	}
	if any_exceeds && g.n > 0 {
		let tmp = g.res[max_idx];
		g.res[max_idx] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	out.i = max_val;
	out.ok = any_exceeds;
	g.steps += g.n;
	out
}
@end
