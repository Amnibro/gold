@entry f52dae3eab48c33c
kind: step
verb: run
noun: maximum
modifier: in_reverse
context: stats
phrase: run cumulative maximum in reverse order
phrase: calculate reverse running maximum across series
test: list=1,5,3,8,2
expect: => i=8 r=0.0 ok=true s="reverse max computed" errors=0 n=5 res=[8,8,8,8,2] cache=0 hits=0
test: list=10,4,7,3
expect: => i=10 r=0.0 ok=true s="reverse max computed" errors=0 n=4 res=[10,7,7,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var cur_max = g.res[g.n - 1];
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > cur_max {
			cur_max = g.res[i];
		}
		g.res[i] = cur_max;
		i--;
	}
	g.steps += g.n;
	out.i = cur_max;
	gold_text(out, "reverse max computed");
	out
}
@end
