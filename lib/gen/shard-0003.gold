fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	var count = 0;
	for i in g.n {
		count++;
		if g.res[i] == tgt {
			found = true;
			break;
		}
	}
	if !found {
		gold_fail(g, "termination target not found error");
		out.ok = false;
		out.i = -1;
	} else {
		out.i = count;
	}
	g.steps += g.n;
	out
}
@end
@entry 4aaaa70cd40cc040
kind: step
verb: drop
noun: squares
modifier: with_cache
context: error
phrase: drop squares with cache key {key}
phrase: purge square values matching cache key {key}
slot: key int
test: list=4,9,16 key=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[4,16] cache=3 hits=1
test: list=4,9,16 key=99
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[4,9,16] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	for i in g.n {
		let x = g.res[i];
		if x == 4 { gold_cache_put(g, 2, 4); }
		if x == 9 { gold_cache_put(g, 3, 9); }
		if x == 16 { gold_cache_put(g, 4, 16); }
	}
	let sq, ok = gold_cache_get(g, k);
	if !ok {
		gold_fail(g, "cache key missing error");
		out.ok = false;
		out.i = 0;
	} else {
		var write_idx = 0;
		for i in g.n {
			if g.res[i] != sq {
				g.res[write_idx] = g.res[i];
				write_idx++;
			}
		}
		g.n = write_idx;
		out.i = g.n;
	}
	g.steps += g.n;
	out
}
@end
