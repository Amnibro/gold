@entry 2d0ce5db2fbd8a07
kind: step
verb: scan
noun: condition
modifier: with_cache
context: stats
phrase: scan condition {cond} with cache on series
phrase: filter series matching condition {cond} with cache
slot: cond pred
test: list=2,3,4,5,6 cond=is_even
expect: => i=3 r=0.0 ok=true s="scanned 3 matches" errors=0 n=3 res=[2,4,6] cache=5 hits=0
test: list=9,16,20,25 cond=is_square
expect: => i=3 r=0.0 ok=true s="scanned 3 matches" errors=0 n=3 res=[9,16,25] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		let cached, ok = gold_cache_get(g, x);
		var matches = false;
		if ok {
			matches = cached == 1;
		} else {
			matches = ${cond}(x);
			gold_cache_put(g, x, if matches { 1 } else { 0 });
		}
		if matches {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "scanned ", kept, " matches");
	out
}
@end
