fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let steps_count = g.n - 1;
		for i in steps_count {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = steps_count;
		out.i = steps_count;
		out.s.clear();
		format(out.s, "merged ", steps_count, " successive steps");
	} else {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient elements for step merge");
	}
	g.steps += g.n;
	out
}
