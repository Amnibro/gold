	while p + 1 < g.n {
		let pair_sum = g.res[p] + g.res[p + 1];
		g.res[p] = pair_sum;
		agg += pair_sum;
		p++;
	}
	g.n = g.n - 1;
	out.i = agg;
	g.steps += g.n;
	out
}
