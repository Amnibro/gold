fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let d = g.res[i] % 10;
		var seen = false;
		for j in w {
			if g.res[j] % 10 == d { seen = true; break; }
		}
		if !seen {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "unique digits ", w);
	g.steps += g.n;
	out
}
