@entry 613a1aca248d8b5d
kind: step
verb: rotate
noun: step
modifier: between
context: cache
phrase: rotate cache entries cyclically between indices {start} to {end}
phrase: shift cached step values between bounds {start} to {end}
slot: start int
slot: end int
test: list=10,20,30,40 start=0 end=2
expect: => i=3 r=0.0 ok=true s="rotated 3 cache steps" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,10,15,20,25 start=1 end=3
expect: => i=3 r=0.0 ok=true s="rotated 3 cache steps" errors=0 n=5 res=[5,10,15,20,25] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	let s = ${start};
	let e = ${end};
	if g.cn > 1 && s >= 0 && e < g.cn && s < e {
		let last_k = g.ck[e];
		let last_v = g.cv[e];
		var idx = e;
		while idx > s {
			g.ck[idx] = g.ck[idx - 1];
			g.cv[idx] = g.cv[idx - 1];
			idx--;
		}
		g.ck[s] = last_k;
		g.cv[s] = last_v;
		out.i = e - s + 1;
	} else {
		out.i = 0;
	}
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "rotated ", out.i, " cache steps");
	out
}
@end
