fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${padding};
	for i in out.s.len {
		for j in out.s.len - 1 {
			if out.s[j] > out.s[j + 1] {
				let tmp = out.s[j];
				out.s[j] = out.s[j + 1];
				out.s[j + 1] = tmp;
			}
		}
	}
	var added = 0;
