	var runs int[512] = [0; 512];
	var rn = 0;
	var i = 0;
	while i < g.n {
		var cur_len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			cur_len++;
			i++;
		}
		runs[rn] = cur_len;
		rn++;
		i++;
	}
	for k in rn {
		g.res[k] = runs[k];
	}
	g.n = rn;
	g.steps += g.n;
	out.i = rn;
	out.s.clear();
	format(out.s, "mapped search into ", rn, " run lengths");
	out
}
