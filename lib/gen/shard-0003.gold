kind: step
verb: rotate
noun: limit
modifier: with_cache
context: format
phrase: rotate formatted results bounded by limit {lim} with cache
phrase: apply cached rotation up to limit {lim} across items
slot: lim int
test: list=10,20,30,40 lim=2
expect: => i=2 r=0.0 ok=true s="rotated limit 2" errors=0 n=4 res=[30,40,10,20] cache=1 hits=0
test: list=1,2,3,4,5 lim=1
expect: => i=1 r=0.0 ok=true s="rotated limit 1" errors=0 n=5 res=[2,3,4,5,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	let eff = if limit < g.n { limit } else { g.n };
	if eff > 0 && g.n > 1 {
		for s in eff {
			let first = g.res[0];
			for k in g.n - 1 { g.res[k] = g.res[k + 1]; }
			g.res[g.n - 1] = first;
		}
		gold_cache_put(g, eff, g.res[0]);
	}
	out.i = eff;
	out.s.clear();
	format(out.s, "rotated limit ", eff);
	g.steps += g.n;
	out
}
@end
