code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${last_n};
	let start = if g.n > k { g.n - k } else { 0 };
	var s = 0;
	var i = start;
	while i < g.n {
		s += g.res[i];
		i++;
	}
	g.steps += s;
	out.i = s;
	out
}
