fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = v.i;
	var kept = 0;
	for r in g.n {
		if g.res[r] >= threshold {
			g.res[kept] = g.res[r];
			kept++;
		}
	}
	g.n = kept;
	for a in kept {
		var b = a + 1;
		while b < kept {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
	}
	out.i = kept;
	g.steps += kept;
	out.s.clear();
	format(out.s, "filtered and sorted elements ", kept);
	out
}
