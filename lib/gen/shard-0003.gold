expect: => i=9 r=0.0 ok=true s="" errors=0 n=3 res=[5,9,2] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for maximum dedupe");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var mx = g.res[0];
	for k in 1..g.n { if g.res[k] > mx { mx = g.res[k]; } }
	var kept int[512] = [0; 512];
	var kn = 0;
	var saw_max = false;
	for k in g.n {
		if g.res[k] == mx {
			if !saw_max { kept[kn] = mx; kn++; saw_max = true; }
		} else {
			kept[kn] = g.res[k];
			kn++;
		}
	}
	gold_clear(g);
	for p in kn { gold_push(g, kept[p]); }
	out.i = mx;
	g.steps += g.n;
	out
}
@end
@entry 1551b9ceb3c07de8
kind: step
verb: dedupe
noun: condition
modifier: none
context: error
phrase: deduplicate elements matching condition {p}
phrase: remove duplicate items satisfying predicate {p}
slot: p pred
test: list=2,2,4,4,5 p=is_even
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=1,3,5 p=is_even
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[512] = [0; 512];
	var kn = 0;
	for k in g.n {
		let x = g.res[k];
		if ${p}(x) {
			var seen = false;
			for p in kn { if kept[p] == x { seen = true; break; } }
			if !seen { kept[kn] = x; kn++; }
		}
	}
	if kn == 0 {
		gold_fail(g, "no elements matched predicate");
		out.ok = false;
		out.i = 0;
		return out;
	}
	gold_clear(g);
	for p in kn { gold_push(g, kept[p]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
