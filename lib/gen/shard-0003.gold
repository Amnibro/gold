fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var packed = 0;
	var kept = 0;
	for i in g.n {
		let num = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == num { seen = true; break; }
		}
		if !seen {
			g.res[kept] = num;
			kept++;
			packed = packed * 10 + num;
		}
	}
	g.n = kept;
	out.i = packed;
	out.s.clear();
	format(out.s, "joined unique retry numbers into ", packed);
	g.steps += g.n;
	out
}
@end
