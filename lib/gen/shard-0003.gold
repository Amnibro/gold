expect: => i=2 r=0.0 ok=false s="target item 5 count is 2" errors=0 n=3 res=[5,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for k in g.n {
		if g.res[k] == tgt {
			count++;
		}
	}
	let is_unique = count == 1;
	out.ok = is_unique;
	out.i = count;
	out.s.clear();
	if is_unique {
		format(out.s, "target item ", tgt, " is unique");
	} else {
		format(out.s, "target item ", tgt, " count is ", count);
	}
	g.steps += g.n;
	out
}
@end
@entry 0c738d5733699f06
kind: step
verb: sort
noun: gaps
modifier: between
context: list
phrase: sort gap intervals between adjacent elements
phrase: order distances between consecutive items ascending
test: list=1,10,12,25
expect: => i=3 r=0.0 ok=true s="sorted adjacent gaps count 3" errors=0 n=3 res=[2,9,13] cache=0 hits=0
test: list=5,30,35,40
expect: => i=3 r=0.0 ok=true s="sorted adjacent gaps count 3" errors=0 n=3 res=[5,5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let count = g.n - 1;
	for k in count {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	for i in count {
		for j in count - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.n = count;
	g.steps += count * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted adjacent gaps count ", count);
	out
}
@end
