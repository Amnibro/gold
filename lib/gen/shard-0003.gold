code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var word_start = 0;
	var in_word = false;
	for i in out.s.len {
		let c = out.s[i];
		if c != 32 && !in_word {
			in_word = true;
			word_start = i;
		} else if c == 32 && in_word {
			gold_push(g, (i - word_start));
			in_word = false;
		}
	}
	if in_word {
		gold_push(g, (out.s.len - word_start));
	}
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "words sorted");
	out
}
@end
