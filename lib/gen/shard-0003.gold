@entry e5d29bba73775767
kind: step
verb: pair
noun: primes
modifier: at_least
context: search
phrase: pair adjacent primes summing to at least {min_sum}
phrase: locate consecutive prime pairs exceeding {min_sum}
slot: min_sum int
test: list=2,3,5,7,11 min_sum=8
expect: => i=3 r=0.0 ok=true s="found 3 qualifying prime pairs" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=3,5,10,13,17 min_sum=15
expect: => i=1 r=0.0 ok=true s="found 1 qualifying prime pairs" errors=0 n=5 res=[3,5,10,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_sum};
	var count = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let a = g.res[i];
			let b = g.res[i + 1];
			var pa = a >= 2;
			var d = 2;
			while d * d <= a {
				if a % d == 0 { pa = false; break; }
				d++;
			}
			var pb = b >= 2;
			d = 2;
			while d * d <= b {
				if b % d == 0 { pb = false; break; }
				d++;
			}
			if pa && pb && (a + b) >= thresh {
				count++;
			}
		}
	}
	g.steps += g.n * 2;
	out.i = count;
