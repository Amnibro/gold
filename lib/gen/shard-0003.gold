@entry a0ca80c224b67439
kind: step
verb: find
noun: gaps
modifier: at_least
context: format
phrase: format gaps finding step differences at least {min_gap}
phrase: count adjacent gaps with size at least {min_gap}
phrase: tally steps having differences of at least {min_gap}
slot: min_gap int
test: list=1,5,7,15,18 min_gap=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[1,5,7,15,18] cache=0 hits=0
test: list=10,25,30,50 min_gap=10
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,25,30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_gap};
	var c = 0;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 { diff = -diff; }
		if diff >= limit { c++; }
		i++;
	}
	out.i = c;
	out
}
@end
@entry 69e3eb02e3e09f0e
kind: step
verb: normalize
noun: prefix
modifier: in_reverse
context: format
phrase: format prefix by reversing first {k} elements
phrase: reverse leading prefix of {k} items
phrase: invert order of initial {k} prefix elements
slot: k int
test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
test: list=10,20,30,40 k=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[40,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = ${k};
	if count > g.n { count = g.n; }
	if count < 0 { count = 0; }
	var left = 0;
	var right = count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = count;
	out
}
@end
