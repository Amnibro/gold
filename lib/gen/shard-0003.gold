code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var adjustments = 0;
	let pairs = g.n / 2;
	for i in pairs {
		let idx = i * 2;
		if g.res[idx] > g.res[idx + 1] {
			let tmp = g.res[idx];
			g.res[idx] = g.res[idx + 1];
			g.res[idx + 1] = tmp;
			adjustments += 1;
		}
	}
	g.steps += pairs;
	out.i = adjustments;
	out.s.clear();
	format(out.s, "adjusted ", adjustments, " pairwise values");
	out
}
@end
