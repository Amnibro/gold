@entry afe806a568156c14
kind: step
verb: drop
noun: histogram
modifier: in_place
context: filter
phrase: drop bins below threshold {thresh} in place
phrase: filter histogram counts with threshold {thresh} in place
phrase: prune small histogram bins under {thresh} in place
slot: thresh int
test: list=1,1,2,2,2,3 thresh=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=4,4,4,5,5 thresh=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var counts int[64] = [0; 64];
	var distinct int[64] = [0; 64];
	var nd = 0;
	for i in g.n {
		let val = g.res[i];
		var found = -1;
		for j in nd {
			if distinct[j] == val {
				found = j;
				break;
			}
		}
		if found >= 0 {
			counts[found]++;
		} else if nd < 64 {
			distinct[nd] = val;
			counts[nd] = 1;
			nd++;
		}
	}
	gold_clear(g);
	var nk = 0;
	for j in nd {
		if counts[j] >= limit {
			gold_push(g, counts[j]);
			nk++;
		}
	}
	out.i = nk;
	out
}
@end
@entry fa098019fe2226d1
kind: step
verb: collect
noun: streak
modifier: sorted
context: filter
phrase: collect longest sorted non decreasing streak
phrase: extract sorted contiguous run of items
phrase: isolate longest ascending streak
test: list=1,3,2,4,5,6,3
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,4,5,6] cache=0 hits=0
test: list=5,4,3,2,1
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
			cur_start = i;
			cur_len = 1;
		}
		i++;
	}
	if cur_len > best_len {
		best_len = cur_len;
		best_start = cur_start;
	}
	var kept int[64] = [0; 64];
	for j in best_len { kept[j] = g.res[best_start + j]; }
	gold_clear(g);
	for j in best_len { gold_push(g, kept[j]); }
	out.i = best_len;
	out
}
@end
