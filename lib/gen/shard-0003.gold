fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_w = ${limit};
	if out.s.len == 0 {
		gold_fail(g, "empty text for word ranking");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var words = 0;
	var in_word = false;
	for i in out.s.len {
		if out.s[i] == 32 {
			in_word = false;
		} else {
			if !in_word {
				words++;
				in_word = true;
				if words >= max_w { break; }
			}
		}
	}
	out.i = words;
	g.steps += out.s.len;
	out
}
@end
