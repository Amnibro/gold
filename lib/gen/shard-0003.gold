slot: lo int
slot: hi int
test: list=2,8,15,25 lo=5 hi=20
expect: => i=2 r=0.0 ok=true s="clamped 2 items into range" errors=0 n=4 res=[5,8,15,20] cache=2 hits=0
test: list=1,3,10 lo=2 hi=8
expect: => i=2 r=0.0 ok=true s="clamped 2 items into range" errors=0 n=3 res=[2,3,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lower = ${lo};
	let upper = ${hi};
	var modified = 0;
	for i in g.n {
		let x = g.res[i];
		var clamped = x;
		if clamped < lower { clamped = lower; }
		if clamped > upper { clamped = upper; }
		if clamped != x {
			gold_cache_put(g, x, clamped);
			g.res[i] = clamped;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " items into range");
	out
}
@end
