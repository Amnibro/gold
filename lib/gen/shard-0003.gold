expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[2,0,4,0,8,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vals int[64] = [0; 64];
	var nv = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for k in nv { if vals[k] == x { seen = true; break; } }
		if !seen && nv < 64 { vals[nv] = x; nv++; }
	}
	// sort vals
	var a = 0;
	while a < nv {
		var b = a + 1;
		while b < nv {
			if vals[a] > vals[b] {
				let t = vals[a];
				vals[a] = vals[b];
				vals[b] = t;
			}
			b++;
		}
		a++;
	}
	gold_clear(g);
	for k in nv {
		let x = vals[k];
		var count = 0;
		for i in g.n { if g.res[i] == x { count++; } }
		gold_push(g, x);
		gold_push(g, count);
	}
	out.i = g.n;
	out
}
@end
