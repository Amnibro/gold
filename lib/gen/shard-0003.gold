code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drop = ${limit};
	var dropped = 0;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var should_drop = false;
		if ${p}(x) && dropped < max_drop {
			for j in w {
				if g.res[j] == x { should_drop = true; break; }
			}
		}
		if should_drop {
			dropped++;
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = dropped;
	out.s.clear();
	format(out.s, "function deduped dropped ", dropped);
	g.steps += g.n * g.n;
	out
}
@end
