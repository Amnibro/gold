test: list=5,10,15,15,15 f=inc
expect: => i=2 r=0.0 ok=true s="subfunction tail deduped 2" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var removed = 0;
	while g.n > 1 {
		let v1 = ${f}(g.res[g.n - 1]);
		let v2 = ${f}(g.res[g.n - 2]);
		if v1 == v2 {
			g.n--;
			removed++;
		} else {
			break;
		}
	}
	out.i = removed;
	out.s.clear();
	format(out.s, "subfunction tail deduped ", removed);
	g.steps += removed + 1;
	out
}
@end
@entry 03a414317c788f93
kind: step
verb: search
noun: subfunction
modifier: last
context: core
phrase: search from tail for element matching transformed value {f}
phrase: find last index where subfunction {f} produces match {target}
slot: f fn
slot: target int
test: list=1,2,3,4 f=double target=6
expect: => i=2 r=0.0 ok=true s="last subfunction match at 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30 f=inc target=21
expect: => i=1 r=0.0 ok=true s="last subfunction match at 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	var i = g.n - 1;
	while i >= 0 {
		if ${f}(g.res[i]) == tgt {
			found_idx = i;
			break;
		}
		i--;
	}
	out.i = found_idx;
	out.ok = found_idx >= 0;
	out.s.clear();
	format(out.s, "last subfunction match at ", found_idx);
	g.steps += g.n - i;
	out
}
@end
