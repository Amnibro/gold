@entry 3e1c1845e33a69dd
kind: step
verb: collect
noun: total
modifier: unique
context: aggregate
phrase: calculate sum of unique values
phrase: aggregate unique sequence elements
phrase: compute total of distinct items
test: list=1,2,2,3,1,4
expect: => i=10 r=0.0 ok=true s="" errors=0 n=6 res=[1,2,2,3,1,4] cache=0 hits=0
test: list=5,5,10,10,15
expect: => i=30 r=0.0 ok=true s="" errors=0 n=5 res=[5,5,10,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64] = [0; 64];
	var nk = 0;
	var s = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in nk {
			if kept[j] == x { found = true; break; }
		}
		if !found && nk < 64 {
			kept[nk] = x;
			nk++;
			s += x;
		}
	}
	out.i = s;
	out
}
@end
