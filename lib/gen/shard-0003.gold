@entry 3c255a5aef6e15ee
kind: step
verb: dedupe
noun: checkpoint
modifier: between
context: cache
phrase: dedupe results falling between bounds {low} to {high} with cache
phrase: remove duplicate items within range {low} to {high} tracking cache
slot: low int
slot: high int
test: list=1,5,5,9,9,20 low=4 high=10
expect: => i=2 r=0.0 ok=true s="deduped 2 checkpoint items" errors=0 n=4 res=[1,5,9,20] cache=2 hits=2
test: list=2,2,3,3,4 low=1 high=3
expect: => i=2 r=0.0 ok=true s="deduped 2 checkpoint items" errors=0 n=3 res=[2,3,4] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept = 0;
	var removed = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			let c, ok = gold_cache_get(g, x);
			if !ok {
				gold_cache_put(g, x, 1);
				g.res[kept] = x;
				kept++;
			} else {
				gold_cache_put(g, x, c + 1);
				removed++;
			}
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " checkpoint items");
	out
}
@end
@entry 5c9cbacd91abc203
kind: step
verb: sort
noun: average
modifier: at_most
context: cache
phrase: sort initial results up to at most {cap} items with average cache
phrase: order prefix of at most {cap} results caching averages
slot: cap int
test: list=40,10,30,20 cap=3
expect: => i=26 r=0.0 ok=true s="sorted 3 items average 26" errors=0 n=4 res=[10,30,40,20] cache=1 hits=0
test: list=9,8,7,6,5 cap=4
expect: => i=7 r=0.0 ok=true s="sorted 4 items average 7" errors=0 n=5 res=[6,7,8,9,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let count = if limit < g.n { limit } else { g.n };
	for i in count {
		for j in i + 1..count {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var total = 0;
	for i in count { total += g.res[i]; }
	let avg = if count > 0 { total / count } else { 0 };
	gold_cache_put(g, count, avg);
	g.steps += count * count;
	out.i = avg;
	out.s.clear();
	format(out.s, "sorted ", count, " items average ", avg);
	out
}
@end
@entry aa9e29e87ecbf71e
kind: step
verb: keep
noun: spaces
modifier: at_least
context: cache
phrase: keep items with adjacent spacing at least {min_space}
phrase: filter results preserving gaps of at least {min_space} to cache
slot: min_space int
test: list=1,2,5,6,10 min_space=3
expect: => i=2 r=0.0 ok=true s="dropped 2 spaced items" errors=0 n=3 res=[1,5,10] cache=1 hits=0
test: list=10,20,22,35 min_space=5
expect: => i=1 r=0.0 ok=true s="dropped 1 spaced items" errors=0 n=3 res=[10,20,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_space};
	if g.n <= 1 { return out; }
	var kept = 1;
	var dropped = 0;
	var prev = g.res[0];
	for i in 1..g.n {
		let curr = g.res[i];
		let diff = if curr > prev { curr - prev } else { prev - curr };
		if diff >= req {
			g.res[kept] = curr;
			kept++;
			prev = curr;
		} else {
			dropped++;
		}
	}
	gold_cache_put(g, req, dropped);
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " spaced items");
	out
}
@end
