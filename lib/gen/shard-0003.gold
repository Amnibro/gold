context: list
phrase: check word chunks of size {chunk_size} over {times} rounds
phrase: evaluate slice segments of size {chunk_size} repeated {times} passes
phrase: inspect list words of length {chunk_size} across {times} iterations
slot: chunk_size int
slot: times int
test: list=1,2,-1,3,4,0 chunk_size=2 times=1
expect: => i=3 r=0.0 ok=true s="checked 3 positive word chunks" errors=0 n=6 res=[1,2,-1,3,4,0] cache=0 hits=0
test: list=5,-2,3,8 chunk_size=2 times=2
expect: => i=4 r=0.0 ok=true s="checked 4 positive word chunks" errors=0 n=4 res=[5,-2,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${chunk_size};
	let t = ${times};
	var valid_chunks = 0;
	for round in t {
		var i = 0;
		while i < g.n {
			let chunk_end = if i + sz < g.n { i + sz } else { g.n };
			var sum_val = 0;
			var k = i;
			while k < chunk_end {
				sum_val += g.res[k];
				k += 1;
			}
			if sum_val > 0 {
				valid_chunks += 1;
			}
			i += sz;
		}
	}
	g.steps += t * g.n;
	out.i = valid_chunks;
	out.s.clear();
	format(out.s, "checked ", valid_chunks, " positive word chunks");
	out
}
@end
@entry 6d35af1d5e99372a
kind: step
verb: pair
noun: odds
modifier: nested
context: list
phrase: pair adjacent odds nested up to {limit} times
phrase: multiply consecutive odd pairs up to {limit} count
phrase: combine nested pairs of odds up to {limit} limit
slot: limit int
test: list=1,3,5,7,2,9 limit=2
expect: => i=2 r=0.0 ok=true s="paired 2 nested odd groups" errors=0 n=4 res=[3,35,2,9] cache=0 hits=0
test: list=3,5,4,7,9,11 limit=1
expect: => i=1 r=0.0 ok=true s="paired 1 nested odd groups" errors=0 n=5 res=[15,4,7,9,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = 0;
	var i = 0;
	var w = 0;
	while i < g.n {
		if i + 1 < g.n && pairs < lim && g.res[i] % 2 != 0 && g.res[i + 1] % 2 != 0 {
			g.res[w] = g.res[i] * g.res[i + 1];
			w += 1;
			i += 2;
			pairs += 1;
		} else {
			g.res[w] = g.res[i];
			w += 1;
			i += 1;
		}
	}
	g.n = w;
	g.steps += i;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " nested odd groups");
	out
}
@end
