code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let max_val = ${cap};
	if limit < 0 || limit > g.n {
		gold_fail(g, "suffix out of bounds");
		out.ok = false;
		out.i = 0;
		return out;
	}
	let start = g.n - limit;
	for i in limit {
		if g.res[start + i] > max_val {
			g.res[start + i] = max_val;
		}
	}
	out.i = limit;
	g.steps += limit;
	out
}
@end
