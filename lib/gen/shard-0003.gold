expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[2,2,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window_size};
	let max_s = ${max_sum};
	var windows = 0;
	if w > 0 && g.n >= w {
		var i = 0;
		while i + w <= g.n {
			var cur_s = 0;
			for j in w {
				cur_s += g.res[i + j];
			}
			if cur_s > max_s { break; }
			windows++;
			i++;
		}
	}
	out.i = windows;
	g.steps += g.n;
	out
}
@end
