fn ${ID}(n int) int {
	if n <= 0 {
		return 0;
	}
	var mask = 0;
	var count = 0;
	var temp = n;
	while temp > 0 {
		var d = temp % 10;
		var bit = 1;
		var i = 0;
		while i < d {
			bit *= 2;
			i++;
		}
		if (mask / bit) % 2 == 0 {
			mask += bit;
			count++;
		}
		temp /= 10;
	}
	return count;
}
@end
