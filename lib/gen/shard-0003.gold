fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	let orig = g.n;
	if orig == 0 || t <= 1 {
		return out;
	}
	var iter = 1;
	while iter < t {
		for i in orig {
			gold_push(g, g.res[i]);
		}
		iter++;
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "tally replicated");
	out
}
@end
