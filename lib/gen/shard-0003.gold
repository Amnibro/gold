expect: => i=2 r=0.0 ok=true s="paired into 2 safe values" errors=0 n=2 res=[15,25] cache=0 hits=0
test: list=6,12,18,24 cap=15
expect: => i=2 r=0.0 ok=true s="paired into 2 safe values" errors=0 n=2 res=[9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	let count = g.n / 2;
	for i in count {
		let a = g.res[i * 2];
		let b = g.res[i * 2 + 1];
		var avg = (a + b) / 2;
		if avg > ceiling {
			avg = ceiling;
		}
		g.res[i] = avg;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "paired into ", count, " safe values");
	out
}
@end
@entry a3930c2b0f91958d
kind: step
