phrase: check duplicates first appearing in sequence
phrase: locate leading duplicate item occurrence
phrase: scan first duplicate in numbers
test: list=7,4,9,4,2
expect: => i=4 r=0.0 ok=true s="first duplicate value is 4" errors=0 n=5 res=[7,4,9,4,2] cache=0 hits=0
test: list=10,20,30,40
expect: => i=-1 r=0.0 ok=true s="no duplicates found" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_dup = -1;
	var found = false;
	var i = 0;
	while i < g.n && !found {
		var j = i + 1;
		while j < g.n && !found {
			if g.res[i] == g.res[j] {
				first_dup = g.res[i];
				found = true;
			}
			j += 1;
		}
		i += 1;
	}
	g.steps += i;
	out.i = first_dup;
	out.s.clear();
	if found {
		format(out.s, "first duplicate value is ", first_dup);
	} else {
		format(out.s, "no duplicates found");
	}
	out
}
@end
