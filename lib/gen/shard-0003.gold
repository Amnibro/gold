expect: => i=31 r=0.0 ok=true s="nested pairwise product sum 31" errors=0 n=3 res=[2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			total += g.res[i] * g.res[j];
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "nested pairwise product sum ", total);
	out
}
@end
@entry 970b564a7eaeb6d0
