@entry 8e44dd80331c62a3
kind: step
verb: select
noun: duplicates
modifier: times
context: transform
phrase: select duplicate items repeating {times} times
phrase: pick duplicate elements {times} times
phrase: keep duplicate entries {times} times
slot: times int
test: list=1,2,2,3,4,4,5 times=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,2,4,4] cache=0 hits=0
test: list=7,8,7,9,9,9 times=1
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[64] = [0; 64];
	var nd = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		for d in nd { if dups[d] == x { seen = true; break; } }
		if !seen {
			var count = 0;
			for j in g.n { if g.res[j] == x { count++; } }
			if count > 1 && nd < 64 {
				dups[nd] = x;
				nd++;
			}
		}
		i++;
	}
	gold_clear(g);
	let reps = if ${times} <= 0 { 1 } else { ${times} };
	for d in nd {
		for r in reps { gold_push(g, dups[d]); }
	}
	out.i = g.n;
	out
}
@end
