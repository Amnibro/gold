code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stp = ${step};
	if g.n >= 2 && stp > 0 {
		let start = g.res[0];
		let end = g.res[1];
		g.n = 0;
		var curr = start;
		while curr <= end {
			gold_push(g, curr);
			curr += stp;
		}
	}
	out.i = g.n;
