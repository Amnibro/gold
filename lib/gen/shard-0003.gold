@entry d3937d311c8661d4
kind: step
verb: measure
noun: primes
modifier: in_reverse
context: stats
phrase: measure prime numbers in reverse order
phrase: count prime observations backward through series
test: list=2,4,5,6,7,8
expect: => i=3 r=0.0 ok=true s="measured 3 primes in reverse" errors=0 n=6 res=[2,4,5,6,7,8] cache=0 hits=0
test: list=10,11,12,13,14
expect: => i=2 r=0.0 ok=true s="measured 2 primes in reverse" errors=0 n=5 res=[10,11,12,13,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	var k = g.n;
	while k > 0 {
		k--;
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			primes++;
		}
	}
	g.steps += g.n;
	out.i = primes;
	out.s.clear();
	format(out.s, "measured ", primes, " primes in reverse");
	out
}
@end
