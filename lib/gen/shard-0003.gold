	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	gold_push(g, x);
	g.steps += g.n;
	out.i = x;
	out.s.clear();
	format(out.s, "filled streak with ", x);
	out
}
@end
