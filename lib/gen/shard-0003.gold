fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = min(max(1, v.i), 3);
	var prime_copies int[64] = [0; 64];
	var n_copies = 0;
	for idx in g.n {
		let x = g.res[idx];
		var p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { p = false; break; }
			d++;
		}
		if p {
			for rep in cap {
				if n_copies < 64 { prime_copies[n_copies] = x; n_copies++; }
			}
		}
	}
	gold_clear(g);
	for k in n_copies { gold_push(g, prime_copies[k]); }
	out.i = n_copies;
	g.steps += n_copies;
	out.s.clear();
	format(out.s, "repeated primes count ", n_copies);
	out
}
@end
