expect: true
code:
fn ${ID}(n int) bool {
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + x % 10;
		x /= 10;
	}
	var r = 0;
	while r * r < rev {
		r++;
	}
	r * r == rev
}
@end
