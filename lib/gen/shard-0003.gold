kind: step
verb: dedupe
noun: number
modifier: with_retry
context: format
phrase: dedupe target number {target_num} with retry limit {max_drops}
phrase: remove duplicates of number {target_num} up to limit {max_drops}
slot: target_num int
slot: max_drops int
test: list=5,5,5,10 target_num=5 max_drops=2
expect: => i=2 r=0.0 ok=true s="dropped duplicates 2" errors=0 n=2 res=[5,10] cache=0 hits=0
test: list=2,2,2,2 target_num=2 max_drops=1
expect: => i=1 r=0.0 ok=true s="dropped duplicates 1" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_num};
	let limit = ${max_drops};
	var drops = 0;
	var w = 0;
	var seen = false;
	for i in g.n {
		if g.res[i] == tgt {
			if !seen {
				seen = true;
				g.res[w] = g.res[i];
				w++;
			} else if drops < limit {
				drops++;
			} else {
				g.res[w] = g.res[i];
				w++;
			}
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = drops;
	out.s.clear();
	format(out.s, "dropped duplicates ", drops);
	g.steps += g.n;
	out
}
@end
