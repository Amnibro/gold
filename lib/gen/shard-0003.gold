fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = 0;
	var i = 0;
	var w = 0;
	while i + 1 < g.n && pairs < lim {
		g.res[w] = g.res[i] + g.res[i + 1];
		w += 1;
		pairs += 1;
		i += 1;
	}
	while i < g.n {
		g.res[w] = g.res[i];
		w += 1;
		i += 1;
	}
	g.n = w;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "calculated ", pairs, " running pairs");
	out
}
@end
