noun: step
modifier: with_cache
context: list
phrase: validate step progression against cached transitions
phrase: verify sequence step increments with cache lookup
test: list=1,2,3,4
expect: => i=1 r=0.0 ok=true s="validated increasing steps in cache" errors=0 n=4 res=[1,2,3,4] cache=3 hits=0
test: list=5,4,3,2
expect: => i=0 r=0.0 ok=false s="steps validation failed condition" errors=0 n=4 res=[5,4,3,2] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var strictly_increasing = true;
	if g.n > 1 {
		for k in g.n - 1 {
			let diff = g.res[k + 1] - g.res[k];
			if diff <= 0 {
				strictly_increasing = false;
			}
			gold_cache_put(g, k, diff);
		}
	}
	out.ok = strictly_increasing;
	out.i = if strictly_increasing { 1 } else { 0 };
	out.s.clear();
	if strictly_increasing {
		format(out.s, "validated increasing steps in cache");
	} else {
		format(out.s, "steps validation failed condition");
	}
	g.steps += g.n;
	out
}
@end
