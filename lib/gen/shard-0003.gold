code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_pos};
	let e = ${end_pos};
	if s >= 0 && e < g.n && s < e {
		var max_idx = s;
		var max_val = g.res[s];
		var k = s + 1;
		while k <= e {
			if g.res[k] > max_val {
				max_val = g.res[k];
				max_idx = k;
			}
			k++;
		}
		let tmp = g.res[s];
		g.res[s] = g.res[max_idx];
		g.res[max_idx] = tmp;
		out.i = max_val;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
