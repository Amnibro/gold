@entry 635baec12126d693
kind: step
verb: dedupe
noun: suffix
modifier: unique
context: filter
phrase: dedupe suffix elements keeping unique tail length {length}
phrase: filter suffix values to unique items with length {length}
slot: length int
test: list=1,2,3,3,4,4 length=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6,6 length=3
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,5,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = ${length};
	let start = if g.n > len { g.n - len } else { 0 };
	var w = start;
	var i = start;
	while i < g.n {
		var seen = false;
		for j in w {
			if j >= start && g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[w] = g.res[i];
			w++;
		}
		i++;
	}
	g.n = w;
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
