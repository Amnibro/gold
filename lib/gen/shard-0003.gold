fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = 10;
	var scaled = 0;
	for i in 0..g.n {
		if g.res[i] < threshold {
			g.res[i] *= 2;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " elements up to threshold");
	g.steps += g.n + 1;
	out
}
