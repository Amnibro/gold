expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64] = [0; 64];
	var nk = 0;
	let max_items = if ${budget} <= 0 { 0 } else { ${budget} };
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for k in nk { if kept[k] == x { seen = true; break; } }
		if !seen && nk < max_items && nk < 64 {
			kept[nk] = x;
			nk++;
		}
		i--;
	}
	gold_clear(g);
	var j = nk - 1;
	while j >= 0 {
		gold_push(g, kept[j]);
		j--;
	}
	out.i = g.n;
	out
}
@end
