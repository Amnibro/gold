fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let max_val = g.res[g.n - 1];
	var kept int[512] = [0; 512];
	var kn = 0;
	var saw_max = false;
	for k in g.n {
		if g.res[k] == max_val {
			if !saw_max {
				kept[kn] = g.res[k];
				kn++;
				saw_max = true;
			}
		} else {
			kept[kn] = g.res[k];
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
