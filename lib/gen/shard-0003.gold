expect: => i=2 r=0.0 ok=true s="joined 2 cached items to head" errors=0 n=4 res=[30,60,10,20] cache=2 hits=0
test: list=5,15,25
expect: => i=3 r=0.0 ok=true s="joined 3 cached items to head" errors=0 n=6 res=[15,45,75,5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i] * 3); }
	let old_n = g.n;
	let to_add = g.cn;
	if old_n + to_add <= 512 {
		var idx = old_n - 1;
		while idx >= 0 {
			g.res[idx + to_add] = g.res[idx];
			idx--;
		}
		for i in to_add {
			g.res[i] = g.cv[i];
		}
		g.n = old_n + to_add;
		out.i = to_add;
	} else {
		out.i = 0;
	}
	g.steps += old_n + to_add;
	out.s.clear();
	format(out.s, "joined ", out.i, " cached items to head");
	out
}
@end
