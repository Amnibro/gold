expect: => i=5 r=0.0 ok=true s="deduped above average 5" errors=0 n=4 res=[2,4,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var total = 0;
	for j in g.n { total += g.res[j]; }
	let avg = total / g.n;
	var write_pos = 0;
	var seen_above int[64] = [0; 64];
	var n_above = 0;
	for cur in g.n {
		let item = g.res[cur];
		if item > avg {
			var dup = false;
			for s in n_above {
				if seen_above[s] == item { dup = true; break; }
			}
			if !dup {
				if n_above < 64 { seen_above[n_above] = item; n_above++; }
				g.res[write_pos] = item;
				write_pos++;
			}
		} else {
			g.res[write_pos] = item;
			write_pos++;
		}
	}
	g.n = write_pos;
	out.i = avg;
	g.steps += write_pos;
	out.s.clear();
	format(out.s, "deduped above average ", avg);
	out
}
@end
