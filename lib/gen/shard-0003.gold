fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if s <= 0 {
		gold_fail(g, "steps must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid steps");
		return out;
	}
	if s > g.n {
		gold_fail(g, "steps exceed results length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: steps exceed length");
		return out;
	}
	for i in g.n - s..g.n {
		g.res[i] *= 10;
	}
	g.steps += s;
	out.i = s;
	out.s.clear();
	format(out.s, "ran loop on last ", s, " items");
	out
}
@end
