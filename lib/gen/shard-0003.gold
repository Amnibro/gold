fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	var matched = 0;
	var idx = 0;
	while idx < g.n {
		let val = g.res[idx];
		if !${cond}(val) {
			break;
		}
		var temp = if val < 0 { -val } else { val };
		if temp == 0 {
			total_digits += 1;
		} else {
			while temp > 0 {
				total_digits += 1;
				temp /= 10;
			}
		}
		matched += 1;
		idx += 1;
	}
	out.i = total_digits;
	g.steps += idx;
	out.s.clear();
	format(out.s, "counted ", total_digits, " digits across ", matched, " items");
	out
}
@end
