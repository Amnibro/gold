slot: target int
test: list=5,1,9,3,7 target=7
expect: => i=3 r=0.0 ok=true s="target search finished" errors=0 n=5 res=[1,3,5,7,9] cache=0 hits=0
test: list=20,10,30 target=25
expect: => i=-1 r=0.0 ok=true s="target search finished" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var found = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found = i;
			break;
		}
	}
