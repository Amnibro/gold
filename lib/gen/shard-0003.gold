@entry b814c001bae83c1f
kind: step
verb: limit
noun: subfunction
modifier: nested
context: math
phrase: limit subfunction nested multiplier {factor}
phrase: scale elements capping product at {factor}
slot: factor int
test: list=2,5,10,12 factor=20
expect: => i=1 r=0.0 ok=true s="scaled and clamped 1 values" errors=0 n=4 res=[4,10,20,20] cache=0 hits=0
test: list=3,8,15 factor=12
expect: => i=2 r=0.0 ok=true s="scaled and clamped 2 values" errors=0 n=3 res=[6,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${factor};
	var clamped = 0;
	for i in g.n {
		let prod = g.res[i] * 2;
		if prod > cap {
			g.res[i] = cap;
			clamped++;
		} else {
			g.res[i] = prod;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "scaled and clamped ", clamped, " values");
	out
}
@end
