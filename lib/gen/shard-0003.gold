@entry 322fcb24aa866b6b
kind: step
verb: sort
noun: average
modifier: while
context: transform
phrase: sort elements while exceeding sequence average
phrase: order subset while values remain above mean
test: list=2,10,8,12,4 input=0
expect: => i=3 r=0.0 ok=true s="sorted items above mean 3" errors=0 n=3 res=[8,10,12] cache=0 hits=0
test: list=5,20,15,30,10 input=0
expect: => i=2 r=0.0 ok=true s="sorted items above mean 2" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for s in g.n { sum += g.res[s]; }
	let mean = sum / g.n;
	var above int[64] = [0; 64];
	var n_above = 0;
	for i in g.n {
		if g.res[i] > mean {
			if n_above < 64 { above[n_above] = g.res[i]; n_above++; }
		}
	}
	for a in n_above {
		var b = a + 1;
		while b < n_above {
			if above[a] > above[b] {
				let t = above[a];
				above[a] = above[b];
				above[b] = t;
			}
			b++;
		}
	}
	gold_clear(g);
	for k in n_above { gold_push(g, above[k]); }
	out.i = n_above;
	g.steps += n_above;
	out.s.clear();
	format(out.s, "sorted items above mean ", n_above);
	out
}
@end
