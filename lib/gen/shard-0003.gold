			if kept[j] == x { seen++; }
		}
		if seen < mc {
			kept[kn] = x;
			kn++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
@entry 4274af5b85ceaab3
kind: step
verb: merge
noun: results
modifier: recursively
context: filter
phrase: merge adjacent pairs recursively when sum exceeds {threshold}
phrase: filter sequence recursively merging neighbors surpassing threshold {threshold}
slot: threshold int
test: list=3,8,2,4 threshold=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[8,2,4] cache=0 hits=0
test: list=10,12,5,6 threshold=15
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[12,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var merges = 0;
	var i = 0;
	var kept int[512] = [0; 512];
	var kn = 0;
	while i < g.n {
		if i + 1 < g.n && (g.res[i] + g.res[i + 1] > th) {
			let mx = if g.res[i] > g.res[i + 1] { g.res[i] } else { g.res[i + 1] };
			kept[kn] = mx; kn++;
			merges++;
			i += 2;
		} else {
			kept[kn] = g.res[i]; kn++;
			i++;
		}
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	out.i = merges;
	g.steps += g.n;
	out
}
@end
