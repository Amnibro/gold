@entry d1c0091b5f465966
kind: step
verb: compare
noun: range
modifier: safely
context: error
phrase: compare range safely against {max_range}
phrase: verify span safely bounded by {max_range}
slot: max_range int
test: list=2,8,12 max_range=15
expect: => i=10 r=0.0 ok=true s="range span 10 is safe" errors=0 n=3 res=[2,8,12] cache=0 hits=0
test: list=2,8,25 max_range=15
expect: => i=0 r=0.0 ok=false s="error: span 23 exceeds 15" errors=1 n=3 res=[2,8,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${max_range};
	if mr <= 0 {
		gold_fail(g, "max range must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid max range");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "insufficient elements to calculate range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var mn = g.res[0];
	var mx = g.res[0];
	for i in 1..g.n {
		if g.res[i] < mn { mn = g.res[i]; }
		if g.res[i] > mx { mx = g.res[i]; }
	}
	let span = mx - mn;
	if span > mr {
		gold_fail(g, "span exceeds maximum range");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: span ", span, " exceeds ", mr);
		return out;
	}
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	format(out.s, "range span ", span, " is safe");
	out
}
@end
