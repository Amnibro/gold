code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var unique_count = 0;
	for i in 0..g.n {
		var is_first = true;
		for j in 0..i {
			if g.res[i] == g.res[j] {
				is_first = false;
				break;
			}
		}
		if is_first {
			sum += g.res[i];
			unique_count++;
		}
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of ", unique_count, " unique numbers is ", sum);
	g.steps += g.n + 1;
	out
}
@end
