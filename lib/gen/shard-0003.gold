code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = 0;
	var i = g.n - 1;
	var sign = 1;
	while i >= 0 {
		s += g.res[i] * sign;
		sign = -sign;
		i--;
	}
	out.i = s;
	out
}
@end
