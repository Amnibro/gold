noun: suffix
modifier: between
context: math
phrase: shift suffix between range {start_pos}
phrase: rotate suffix items from {start_pos}
slot: start_pos int
test: list=1,2,3,4,5 start_pos=2
expect: => i=3 r=0.0 ok=true s="shifted suffix of 3 items" errors=0 n=5 res=[1,2,4,5,3] cache=0 hits=0
test: list=10,20,30,40 start_pos=1
expect: => i=3 r=0.0 ok=true s="shifted suffix of 3 items" errors=0 n=4 res=[10,30,40,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pos = ${start_pos};
	if pos < 0 || pos >= g.n - 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "suffix unchanged");
		return out;
	}
	let first = g.res[pos];
	for i in pos..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n - pos;
	out.i = g.n - pos;
	out.s.clear();
	format(out.s, "shifted suffix of ", g.n - pos, " items");
	out
}
@end
