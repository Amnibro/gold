@entry 7e2ed15f79fc918f
kind: step
verb: retry
noun: duplicates
modifier: none
context: format
phrase: retry duplicates removal without cache
phrase: format deduplicated results without memo
test: list=1,1,2,3
expect: => i=3 r=0.0 ok=true s="deduped count: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,5,6
expect: => i=3 r=0.0 ok=true s="deduped count: 3" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var r = 0;
	while r < g.n {
		var dup = false;
		var j = 0;
		while j < w {
			if g.res[j] == g.res[r] { dup = true; break; }
			j++;
		}
		if !dup {
			g.res[w] = g.res[r];
			w++;
		}
		r++;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped count: ", w);
	g.steps += r;
	out
}
@end
@entry 83ba31d0f1d74ec8
kind: step
verb: swap
noun: maximum
modifier: in_place
context: format
phrase: swap maximum element in place directly
phrase: format in place maximum swap result
test: list=1,9,3
expect: => i=9 r=0.0 ok=true s="maximum moved to head: 9" errors=0 n=3 res=[9,1,3] cache=0 hits=0
test: list=10,2,4
expect: => i=10 r=0.0 ok=true s="maximum moved to head: 10" errors=0 n=3 res=[10,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_idx = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
		i++;
	}
	let tmp = g.res[0];
	g.res[0] = g.res[max_idx];
	g.res[max_idx] = tmp;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "maximum moved to head: ", out.i);
	g.steps += g.n;
	out
}
@end
