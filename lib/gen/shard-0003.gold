@entry c127c9ce5acd15cb
kind: step
verb: compare
noun: budget
modifier: pairwise
context: cache
phrase: compare adjacent cache values against budget {cap}
phrase: evaluate pairwise cache differences under budget {cap}
slot: cap int
test: list=10,20,35,45 cap=15
expect: => i=3 r=0.0 ok=true s="budget compared" errors=0 n=4 res=[10,20,35,45] cache=4 hits=6
test: list=5,15,25 cap=20
expect: => i=2 r=0.0 ok=true s="budget compared" errors=0 n=3 res=[5,15,25] cache=3 hits=4
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${cap};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var under = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let v1, ok1 = gold_cache_get(g, i);
			let v2, ok2 = gold_cache_get(g, i + 1);
			if ok1 && ok2 {
				let diff = if v2 > v1 { v2 - v1 } else { v1 - v2 };
				if diff <= b { under++; }
			}
		}
	}
	g.steps += g.n;
	out.i = under;
	gold_text(out, "budget compared");
	out
}
@end
