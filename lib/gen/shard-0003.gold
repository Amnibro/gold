@entry 47aa99ac148808a8
kind: step
verb: search
noun: value
modifier: nested
context: sort
phrase: search value position in sorted array {target}
phrase: binary search location of target {target}
slot: target int
test: list=20,10,30 target=20
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 target=10
expect: => i=-1 r=0.0 ok=false s="" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let tgt = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = false;
	var idx = -1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == tgt {
			found = true;
			idx = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	out.ok = found;
	out.i = idx;
	g.steps += g.n;
	out
}
@end
