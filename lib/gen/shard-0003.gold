code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var x = g.res[i];
		var s = 0;
		while x > 0 { s += x % 10; x /= 10; }
		g.res[i] = s;
		total += s;
	}
	out.i = total;
	out
}
