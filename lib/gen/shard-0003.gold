@entry d4b9d14ee4f31d4e
kind: step
verb: split
noun: primes
modifier: up_to
context: retry
phrase: split primes up to limit {limit}
phrase: partition prime numbers up to {limit}
slot: limit int
test: limit=10
expect: => i=4 r=0.0 ok=true s="found 4 primes" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: limit=1
expect: => i=0 r=0.0 ok=false s="error: limit under two" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim < 2 {
		gold_fail(g, "limit under two for primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: limit under two");
		return out;
	}
	var count = 0;
	var num = 2;
	while num <= lim {
		var is_p = true;
		var d = 2;
		while d * d <= num {
			if num % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, num);
			count++;
		}
		num++;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " primes");
	out
}
@end
