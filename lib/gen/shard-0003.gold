noun: streak
modifier: in_place
context: list
phrase: dedupe consecutive streaks in place
phrase: remove repeated streak elements in place
test: list=1,1,2,3,3,4
expect: => i=2 r=0.0 ok=true s="deduped streaks removed 2 values" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6,7,7
expect: => i=3 r=0.0 ok=true s="deduped streaks removed 3 values" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	var removed = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[kept - 1] {
			removed++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped streaks removed ", removed, " values");
	out
}
@end
