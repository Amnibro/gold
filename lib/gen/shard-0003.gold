code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var pairs = 0;
	for i in g.n {
		for j in g.n {
			if i < j {
				let diff = if g.res[j] > g.res[i] { g.res[j] - g.res[i] } else { g.res[i] - g.res[j] };
				total += diff;
				pairs++;
			}
		}
	}
	let avg = if pairs > 0 { total / pairs } else { 0 };
	gold_cache_put(g, 0, avg);
	g.steps += pairs;
	out.i = avg;
	gold_text(out, "nested avg cached");
	out
}
@end
