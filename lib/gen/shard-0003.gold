code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if g.n > 1 && s > 0 {
		for rep in s {
			let last = g.res[g.n - 1];
			var idx = g.n - 1;
			while idx > 0 {
				g.res[idx] = g.res[idx - 1];
				idx--;
			}
			g.res[0] = last;
		}
	}
	out.i = s;
	out.s.clear();
	format(out.s, "cycled retry history by ", s, " positions");
	g.steps += g.n * (s + 1);
	out
}
@end
