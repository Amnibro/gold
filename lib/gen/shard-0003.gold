fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			g.res[w] = x;
			w += 1;
		} else {
			break;
		}
	}
	g.n = w;
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "selected prefix of ", w, " items between bounds");
	out
}
