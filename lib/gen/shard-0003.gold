expect: => i=8 r=0.0 ok=true s="middle sorted element is 8" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mid_val = 0;
	if g.n > 0 {
		for i in g.n {
			var j = i;
			while j > 0 && g.res[j - 1] > g.res[j] {
				let tmp = g.res[j];
				g.res[j] = g.res[j - 1];
				g.res[j - 1] = tmp;
				j -= 1;
			}
		}
		let mid_idx = g.n / 2;
		mid_val = g.res[mid_idx];
	}
	g.steps += g.n;
	out.i = mid_val;
	out.s.clear();
	format(out.s, "middle sorted element is ", mid_val);
	out
}
@end
