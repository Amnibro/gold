test: list=2,7,4,9,6
expect: => i=3 r=0.0 ok=true s="rotated 3 evens" errors=0 n=5 res=[4,7,6,9,2] cache=1 hits=0
test: list=10,3,20,5
expect: => i=2 r=0.0 ok=true s="rotated 2 evens" errors=0 n=4 res=[20,3,10,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[en] = g.res[i];
			en++;
		}
	}
	if en > 1 {
		let first = evens[0];
		for i in en - 1 { evens[i] = evens[i + 1]; }
		evens[en - 1] = first;
		var idx = 0;
		for i in g.n {
			if g.res[i] % 2 == 0 {
				g.res[i] = evens[idx];
				idx++;
			}
		}
		gold_cache_put(g, en, first);
	}
	out.i = en;
	out.s.clear();
	format(out.s, "rotated ", en, " evens");
	g.steps += g.n;
	out
}
@end
