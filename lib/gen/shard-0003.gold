test: list=1,3,2,5
expect: => i=4 r=0.0 ok=false s="sorted" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
test: list=2,4,6,8
expect: => i=4 r=0.0 ok=true s="already" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i - 1] { is_sorted = false; break; }
		i++;
	}
	if !is_sorted {
		var a = 0;
		while a < g.n {
			var b = a + 1;
			while b < g.n {
				if g.res[a] > g.res[b] {
					let t = g.res[a];
					g.res[a] = g.res[b];
					g.res[b] = t;
				}
				b++;
			}
			a++;
		}
		out.ok = false;
		out.s.clear();
		out.s.append("sorted");
	} else {
		out.ok = true;
		out.s.clear();
		out.s.append("already");
	}
	out.i = g.n;
	out
}
@end
