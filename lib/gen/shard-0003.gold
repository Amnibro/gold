fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let val = g.res[i];
		let cur_cnt, ok = gold_cache_get(g, val);
		let nxt = if ok { cur_cnt + 1 } else { 1 };
		gold_cache_put(g, val, nxt);
	}
	g.steps += g.n;
	out.i = g.cn;
	gold_text(out, "histogram cached");
	out
}
