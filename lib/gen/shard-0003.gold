code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var kept int[64] = [0; 64];
	var nk = 0;
	var total = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff <= limit && nk < 64 {
			kept[nk] = diff;
			nk++;
			total += diff;
		}
		i++;
	}
	gold_clear(g);
	for j in nk { gold_push(g, kept[j]); }
	out.i = total;
	out
}
@end
