fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var steps = 0;
	while steps < 10 {
		var cur = x;
		var mn = 9;
		var mx = 0;
		while cur > 0 {
			let d = cur % 10;
			if d < mn { mn = d; }
			if d > mx { mx = d; }
			cur /= 10;
		}
		let next_val = (mn + mx) / 2;
		if next_val == x { break; }
		x = next_val;
		steps++;
	}
	x
}
@end
