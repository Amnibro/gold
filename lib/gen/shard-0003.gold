@entry d686a044577d5e06
kind: step
verb: reverse
noun: primes
modifier: at_least
context: filter
phrase: reverse prime elements if sequence contains at least {min_count} primes
phrase: invert positions of primes having at least {min_count} matches
slot: min_count int
test: list=4,2,6,3,8,5 min_count=2
expect: => i=3 r=0.0 ok=true s="" errors=0 n=6 res=[4,5,6,3,8,2] cache=0 hits=0
test: list=10,7,12,11 min_count=3
expect: => i=2 r=0.0 ok=false s="" errors=0 n=4 res=[10,7,12,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var prime_indices int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		let x = g.res[k];
		var is_prime = (x >= 2);
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_prime = false; break; }
			d++;
		}
		if is_prime {
			prime_indices[pn] = k;
			pn++;
		}
	}
	if pn >= mc {
		var i = 0;
		var j = pn - 1;
		while i < j {
			let p1 = prime_indices[i];
			let p2 = prime_indices[j];
			let tmp = g.res[p1];
			g.res[p1] = g.res[p2];
			g.res[p2] = tmp;
			i++;
			j--;
		}
		out.ok = true;
	} else {
		out.ok = false;
	}
	out.i = pn;
	g.steps += g.n;
	out
}
@end
