expect: => i=5 r=0.0 ok=true s="longest run length is 5" errors=0 n=5 res=[5,5,5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_run = 0;
	if g.n > 0 {
		var cur_run = 1;
		max_run = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run += 1;
				if cur_run > max_run {
					max_run = cur_run;
				}
			} else {
				cur_run = 1;
			}
			i += 1;
		}
	}
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest run length is ", max_run);
	out
}
@end
