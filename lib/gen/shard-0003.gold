code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for i in g.n {
		let x = g.res[i];
		let val, ok = gold_cache_get(g, x);
		if ok {
			hits++;
		} else {
			gold_cache_put(g, x, i);
		}
	}
	g.steps += g.n;
	out.i = hits;
	out.s.clear();
	format(out.s, "observed ", hits, " cache hits");
	out
}
@end
