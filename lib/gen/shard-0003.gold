fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${times};
	var counts int[64] = [0; 64];
	var distinct int[64] = [0; 64];
	var nd = 0;
	for i in g.n {
		let val = g.res[i];
		var found = -1;
		for j in nd {
			if distinct[j] == val {
				found = j;
				break;
			}
		}
		if found >= 0 {
			counts[found]++;
		} else if nd < 64 {
			distinct[nd] = val;
			counts[nd] = 1;
			nd++;
		}
	}
	var c = 0;
	for j in nd {
		if counts[j] == target { c++; }
	}
	out.i = c;
	out
}
