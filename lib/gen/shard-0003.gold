	var out = v;
	let lim = ${cutoff};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var drop = false;
		if x > lim {
			for j in w {
				if g.res[j] == x { drop = true; break; }
			}
		}
		if !drop {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "threshold deduped size ", w);
	g.steps += g.n * g.n;
	out
}
@end
