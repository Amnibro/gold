fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = v.i;
	let half = g.n / 2;
	var tail_sum = 0;
	var idx = half;
	while idx < g.n {
		let val = min(g.res[idx], cap);
		g.res[idx] = val;
		tail_sum += val;
		idx++;
	}
	out.i = tail_sum;
	g.steps += tail_sum;
	out.s.clear();
	format(out.s, "tail capped sum ", tail_sum);
	out
}
@end
