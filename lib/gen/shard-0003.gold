test: list=5,25 lo=2 hi=10
expect: => i=0 r=0.0 ok=false s="" errors=0 n=2 res=[5,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	for k in g.n {
		gold_cache_put(g, g.res[k], k);
	}
	var valid = true;
	var i = 0;
	while i + 1 < g.cn {
		let gap = g.ck[i + 1] - g.ck[i];
		if gap < low || gap > high {
			valid = false;
			break;
		}
		i++;
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.cn;
	out
}
@end
