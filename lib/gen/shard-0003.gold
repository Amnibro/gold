code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let code = g.res[i];
		let is_upper = code >= 65 && code <= 90;
		let is_lower = code >= 97 && code <= 122;
		if is_upper || is_lower {
			g.res[kept] = code;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += kept;
	out.s.clear();
	format(out.s, "filtered letters count ", kept);
	out
}
@end
