slot: bound int
test: list=10,20,30 bound=25
expect: => i=25 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,25] cache=0 hits=0
test: list=5,10,15 bound=50
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var any_exceed = false;
	for i in g.n {
		if g.res[i] > b {
			any_exceed = true;
			break;
		}
	}
	if any_exceed {
		for i in g.n {
			if g.res[i] > b { g.res[i] = b; }
		}
		out.i = b;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
