fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let bound = if k < g.n { k } else { g.n };
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = bound;
	g.steps += bound;
	out
}
@end
