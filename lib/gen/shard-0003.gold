code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let start = if lo < 0 { 0 } else { lo };
	let end = if hi < g.n { hi } else { g.n - 1 };
	var dups = 0;
	if start < end {
		var i = start;
		while i <= end {
			var j = i + 1;
			while j <= end {
				if g.res[i] == g.res[j] {
					dups += 1;
					break;
				}
				j += 1;
			}
			i += 1;
		}
	}
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	format(out.s, "found ", dups, " duplicate occurrences");
	out
}
