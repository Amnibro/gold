fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n > 1 {
		let first = g.res[0];
		var k = 0;
		while k + 1 < g.n {
			g.res[k] = g.res[k + 1];
			k++;
		}
		g.res[g.n - 1] = first;
	}
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	g.steps += g.n;
	out
}
