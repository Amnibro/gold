fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seq_count = 0;
	var cur = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur++;
		} else {
			gold_cache_put(g, seq_count, cur);
			seq_count++;
			cur = 1;
		}
	}
	if g.n > 0 {
		gold_cache_put(g, seq_count, cur);
		seq_count++;
	}
	out.i = seq_count;
	g.steps += g.n;
	out
}
@end
@entry 9f13a0fdd4c1bbf3
kind: step
verb: dedupe
noun: total
modifier: times
context: cache
phrase: cache sum of distinct elements scaled by {factor}
phrase: record unique total multiplied by {factor} in memo
slot: factor int
test: list=2,2,3,4,4 factor=2
expect: => i=18 r=0.0 ok=true s="" errors=0 n=5 res=[2,2,3,4,4] cache=4 hits=2
test: list=5,5,10 factor=3
expect: => i=45 r=0.0 ok=true s="" errors=0 n=3 res=[5,5,10] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var unique_sum = 0;
	for k in g.n {
		let x = g.res[k];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			unique_sum += x;
		}
	}
	let total = unique_sum * f;
	gold_cache_put(g, 9999, total);
	out.i = total;
	g.steps += g.n;
	out
}
@end
@entry fb5a53ffc258f2be
kind: step
verb: filter
noun: condition
modifier: last
context: cache
phrase: cache last element satisfying condition {p}
phrase: store final item matching predicate {p} in cache
slot: p pred
test: list=1,2,3,4,5 p=is_even
expect: => i=4 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,4,5] cache=1 hits=0
test: list=2,4,7,9 p=is_even
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,4,7,9] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var last_val = 0;
	var k = g.n;
	while k > 0 {
		k--;
		if ${p}(g.res[k]) {
			found = true;
			last_val = g.res[k];
			break;
		}
	}
	if found {
		gold_cache_put(g, last_val, 1);
	}
	out.ok = found;
	out.i = last_val;
	g.steps += g.n;
	out
}
@end
@entry eaa368c8a41f6291
kind: step
verb: dedupe
noun: cache
modifier: up_to
context: cache
phrase: deduplicate cache keys up to limit {lim}
phrase: prune redundant entries in memo store bounded by {lim}
slot: lim int
test: list=10,20,30,10,20 lim=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[10,20,30,10,20] cache=3 hits=0
test: list=5,5,5 lim=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[5,5,5] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var added = 0;
	for k in g.n {
		if added >= limit { break; }
		let x = g.res[k];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, added);
			added++;
		}
	}
	out.i = added;
	g.steps += g.n;
	out
}
@end
