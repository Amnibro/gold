fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var running = 0;
	var kept = 0;
	var overflow = 0;
	for i in g.n {
		let x = g.res[i];
		if running + x <= limit {
			running += x;
			g.res[kept] = x;
			kept++;
		} else {
			gold_cache_put(g, i, x);
			overflow++;
		}
	}
	g.n = kept;
	g.steps += g.n + overflow;
	out.i = overflow;
	out.s.clear();
	format(out.s, "split results with ", overflow, " overflow items");
	out
}
@end
