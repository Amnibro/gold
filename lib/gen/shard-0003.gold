expect: => i=1 r=0.0 ok=true s="dropped 1 infrequent observations" errors=0 n=5 res=[5,5,9,9,9] cache=0 hits=0
test: list=1,2,2,3,4,4,4 min_freq=2
expect: => i=2 r=0.0 ok=true s="dropped 2 infrequent observations" errors=0 n=5 res=[2,2,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${min_freq};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq >= mf {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += g.n * g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " infrequent observations");
	out
}
@end
