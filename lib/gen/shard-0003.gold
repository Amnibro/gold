fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for i in g.n {
		let candidate = g.res[i];
		var is_p = candidate >= 2;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			g.res[prime_count] = candidate;
			prime_count++;
		}
	}
	g.n = prime_count;
	out.i = prime_count;
	g.steps += prime_count;
	out.s.clear();
	format(out.s, "ranked primes found ", prime_count);
	out
}
@end
