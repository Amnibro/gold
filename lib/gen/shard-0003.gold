	if count == 0 {
		gold_fail(g, "no squares found to shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no squares");
		return out;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " square values");
	out
}
@end
