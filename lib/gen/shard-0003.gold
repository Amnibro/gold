expect: => i=3 r=0.0 ok=true s="values grouped" errors=0 n=4 res=[5,15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let bs = ${bin_size};
	if bs <= 0 {
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] <= limit {
			g.res[i] = (g.res[i] / bs) * bs;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	gold_text(out, "values grouped");
	out
}
@end
@entry 4ee77f43ce71196a
