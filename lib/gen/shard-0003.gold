@entry f67d47af307af721
kind: step
verb: clamp
noun: digits
modifier: at_least
context: transform
phrase: clamp number digits to at least {floor}
phrase: bound individual digits to at least {floor}
phrase: adjust digits ensuring at least {floor}
slot: floor int
test: list=124,305 floor=3
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[334,335] cache=0 hits=0
test: list=19,82 floor=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[59,85] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${floor};
	for i in g.n {
		var x = g.res[i];
		var sign = 1;
		if x < 0 { sign = -1; x = -x; }
		var digits int[16] = [0; 16];
		var nd = 0;
		if x == 0 {
			digits[0] = if 0 < f { f } else { 0 };
			nd = 1;
		} else {
			while x > 0 {
				let d = x % 10;
				digits[nd] = if d < f { f } else { d };
				nd++;
				x /= 10;
			}
		}
		var rebuilt = 0;
		var j = nd - 1;
		while j >= 0 {
			rebuilt = rebuilt * 10 + digits[j];
			j--;
		}
		g.res[i] = rebuilt * sign;
	}
	out.i = g.n;
	out
}
@end
