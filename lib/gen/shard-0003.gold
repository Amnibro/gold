expect: => i=0 r=0.0 ok=true s="unique duplicates: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dupe_count = 0;
	var i = 0;
	while i < g.n {
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] { seen_before = true; break; }
			j++;
		}
		if !seen_before {
			var occurrences = 0;
			var k = 0;
			while k < g.n {
				if g.res[k] == g.res[i] { occurrences++; }
				k++;
			}
			if occurrences > 1 { dupe_count++; }
		}
		i++;
	}
	out.i = dupe_count;
	out.s.clear();
	format(out.s, "unique duplicates: ", dupe_count);
	g.steps += g.n;
	out
}
@end
