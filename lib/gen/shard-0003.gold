fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "limit non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i < g.n - 1 && pairs < lim {
		g.res[pairs] = g.res[i] + g.res[i + 1];
		pairs++;
		i += 2;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "grouped ", pairs, " pairs");
	out
}
@end
