fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var m = g.res[0];
	for i in g.n {
		if g.res[i] < m { m = g.res[i]; }
	}
	for i in g.n {
		g.res[i] = g.res[i] - m;
	}
	out.i = m;
	out
}
@end
