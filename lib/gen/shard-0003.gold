fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	var start = if g.n > limit { g.n - limit } else { 0 };
	var is_sorted = true;
	var i = start;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
		i++;
	}
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
@entry 9305776efcff4b32
kind: step
verb: filter
noun: threshold
modifier: pairwise
context: sort
phrase: sort pairwise differences exceeding threshold {thresh}
phrase: order adjacent gaps larger than threshold {thresh}
slot: thresh int
test: list=2,10,3,20 thresh=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[7,10] cache=0 hits=0
test: list=1,2,3 thresh=5
expect: => i=0 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let limit = ${thresh};
	var gaps int[512] = [0; 512];
	var gn = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		if diff >= limit {
			gaps[gn] = diff;
			gn++;
		}
		k++;
	}
	gold_clear(g);
	for p in gn { gold_push(g, gaps[p]); }
	out.i = gn;
	g.steps += g.n;
	out
}
@end
