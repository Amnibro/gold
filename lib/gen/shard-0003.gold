fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var budget = 30;
	var kept = 0;
	for k in g.n {
		if budget >= g.res[k] {
			budget -= g.res[k];
			g.res[kept] = g.res[k];
			kept++;
		}
	}
	g.n = kept;
	out.i = budget;
	out.s.clear();
	format(out.s, "budget remaining times ", budget);
	g.steps += g.n;
	out
}
