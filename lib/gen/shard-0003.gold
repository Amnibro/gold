phrase: adjust series scores using recursive digit shift
test: list=15,28,34
expect: => i=23 r=0.0 ok=true s="digits shifted" errors=0 n=3 res=[21,38,41] cache=0 hits=0
test: list=9,19,99
expect: => i=37 r=0.0 ok=true s="digits shifted" errors=0 n=3 res=[18,29,117] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_shift = 0;
	for i in g.n {
		var x = g.res[i];
		var sum = 0;
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
		g.res[i] += sum;
		total_shift += sum;
	}
	g.steps += g.n;
	out.i = total_shift;
	gold_text(out, "digits shifted");
	out
}
@end
