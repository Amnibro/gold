@entry bba15bfd06fb9e62
kind: step
verb: split
noun: maximum
modifier: any
context: stats
phrase: split series removing any maximum values
phrase: filter out maximum observations across series
test: list=10,50,20,50,30
expect: => i=2 r=0.0 ok=true s="removed 2 maximum observations" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,8,15
expect: => i=2 r=0.0 ok=true s="removed 2 maximum observations" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var kept = 0;
	for i in g.n {
		if g.res[i] < max_val {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n * 2;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " maximum observations");
	out
}
@end
@entry eaecacfe53134aa6
kind: step
verb: cache
noun: errors
modifier: at_most
context: stats
phrase: cache at most {lim} deviation errors from {target}
phrase: store up to {lim} residual errors from {target} in cache
slot: target int
slot: lim int
test: list=10,25,30,40 target=20 lim=2
expect: => i=2 r=0.0 ok=true s="cached 2 deviation errors" errors=0 n=4 res=[10,25,30,40] cache=2 hits=0
test: list=5,12,18 target=10 lim=1
expect: => i=1 r=0.0 ok=true s="cached 1 deviation errors" errors=0 n=3 res=[5,12,18] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_c = ${lim};
	var cached = 0;
	for i in g.n {
		if cached >= max_c {
			break;
		}
		let diff = g.res[i] - tgt;
		let err = if diff < 0 { -diff } else { diff };
		gold_cache_put(g, i, err);
		cached++;
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " deviation errors");
	out
}
@end
