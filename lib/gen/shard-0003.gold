code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty list");
		return out;
	}
	var runs = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			runs++;
		}
	}
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "detected ", runs, " consecutive runs");
	out
}
@end
