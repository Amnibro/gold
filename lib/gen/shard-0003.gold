@entry 277fea02f799f286
kind: step
verb: sum
noun: primes
modifier: times
context: sort
phrase: sort primes summing values multiplied by {factor}
phrase: accumulate sorted prime elements times {factor}
slot: factor int
test: list=4,2,9,3,7 factor=2
expect: => i=24 r=0.0 ok=true s="prime sum computed" errors=0 n=5 res=[4,2,9,3,7] cache=0 hits=0
test: list=10,5,11,8 factor=3
expect: => i=48 r=0.0 ok=true s="prime sum computed" errors=0 n=4 res=[10,5,11,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			sum += x;
		}
	}
	g.steps += g.n;
	out.i = sum * f;
	gold_text(out, "prime sum computed");
	out
}
@end
@entry 77fb54ddb3c1e7ed
kind: step
verb: shift
noun: item
modifier: times
context: sort
phrase: rotate sorted array items {times} positions
phrase: circular shift ordered elements {times} times
slot: times int
test: list=5,1,4,2,3 times=1
expect: => i=5 r=0.0 ok=true s="shifted items" errors=0 n=5 res=[2,3,4,5,1] cache=0 hits=0
test: list=30,10,20 times=2
expect: => i=3 r=0.0 ok=true s="shifted items" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if g.n > 1 {
		var rot = t % g.n;
		while rot > 0 {
			let first = g.res[0];
			for i in g.n - 1 {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
			rot--;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	gold_text(out, "shifted items");
	out
}
@end
