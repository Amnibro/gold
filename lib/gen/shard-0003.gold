@entry 709abed6081668d3
kind: step
verb: check
noun: squares
modifier: sorted
context: cache
phrase: check if cached values represent sorted squares
phrase: verify cache contents are ascending perfect squares
test: list=1,2,3
expect: => i=3 r=0.0 ok=true s="checked 3 square entries" errors=0 n=3 res=[1,2,3] cache=3 hits=0
test: list=4,5
expect: => i=2 r=0.0 ok=true s="checked 2 square entries" errors=0 n=2 res=[4,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, i, g.res[i] * g.res[i]);
	}
	var all_sq = true;
	for i in g.cn {
		let x = g.cv[i];
		var r = 0;
		while r * r < x { r++; }
		if x < 0 || r * r != x { all_sq = false; break; }
		if i > 0 && g.cv[i - 1] > x { all_sq = false; break; }
	}
	g.steps += g.cn + g.n;
	out.ok = all_sq;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "checked ", g.cn, " square entries");
	out
}
@end
