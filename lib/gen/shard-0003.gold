modifier: any
context: retry
phrase: shift any odd numbers by {delta}
phrase: adjust odd elements by delta {delta}
slot: delta int
test: list=2,3,4,5 delta=10
expect: => i=2 r=0.0 ok=true s="shifted 2 odd numbers" errors=0 n=4 res=[2,13,4,15] cache=0 hits=0
test: list=2,4,6 delta=10
expect: => i=0 r=0.0 ok=false s="error: no odds" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if d == 0 {
		gold_fail(g, "delta cannot be zero");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero delta");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results for odds shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			g.res[i] += d;
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no odd numbers found to shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no odds");
		return out;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " odd numbers");
	out
}
@end
