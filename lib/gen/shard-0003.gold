@entry 91d97f413fc2653b
kind: step
verb: merge
noun: window
modifier: safely
context: stats
phrase: merge moving window of size {size} safely
phrase: compute safe moving window averages of span {size}
phrase: smooth series with safe window of width {size}
slot: size int
test: list=10,20,30,40,50 size=2
expect: => i=4 r=0.0 ok=true s="merged 4 safe window blocks" errors=0 n=4 res=[15,25,35,45] cache=0 hits=0
test: list=4,8,12,16 size=2
expect: => i=3 r=0.0 ok=true s="merged 3 safe window blocks" errors=0 n=3 res=[6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${size};
	if k > 0 && g.n >= k {
		let out_count = g.n - k + 1;
		for i in out_count {
			var sum = 0;
			for j in k {
				sum += g.res[i + j];
			}
			g.res[i] = sum / k;
		}
		g.n = out_count;
		out.i = out_count;
		out.s.clear();
		format(out.s, "merged ", out_count, " safe window blocks");
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "window larger than data length");
	}
	g.steps += g.n;
	out
}
@end
