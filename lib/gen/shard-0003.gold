@entry d4d3c4db93efa253
kind: step
verb: reverse
noun: step
modifier: times
context: sort
phrase: reverse sorted segments step times by length {step}
phrase: perform segment reversal step times of size {step}
slot: step int
test: list=6,1,5,2,4,3 step=3
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=8,2,6,4 step=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[4,2,8,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${step};
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	if s > 1 {
		var i = 0;
		while i < g.n {
			let end_idx = if i + s < g.n { i + s } else { g.n };
			var left = i;
			var right = end_idx - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			i += s;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
