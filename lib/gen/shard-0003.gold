fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let prefix = min(max(2, v.i), g.n);
	let head_val = g.res[0];
	var pos = 0;
	while pos + 1 < prefix {
		g.res[pos] = g.res[pos + 1];
		pos++;
	}
	g.res[prefix - 1] = head_val;
	out.i = prefix;
	g.steps += prefix;
	out.s.clear();
	format(out.s, "rotated initial segment ", prefix);
	out
}
@end
