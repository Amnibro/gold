fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = g.n;
	if len <= 1 { return out; }
	let shift = v.i % len;
	var buf int[64] = [0; 64];
	for a in len {
		if a < 64 { buf[a] = g.res[a]; }
	}
	for b in len {
		let src_idx = (b + shift) % len;
		if src_idx < 64 { g.res[b] = buf[src_idx]; }
	}
	out.i = shift;
	g.steps += len;
	out.s.clear();
	format(out.s, "rotated entries by shift ", shift);
	out
}
@end
