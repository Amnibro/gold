context: format
slot: times int
phrase: reverse loop sequence {times} times
phrase: format looped reverse output {times} times
test: list=1,2,3 times=1
expect: => i=1 r=0.0 ok=true s="reversed times: 1" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=4,5,6 times=2
expect: => i=2 r=0.0 ok=true s="reversed times: 2" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	let t = ${times};
	var out = v;
	if t % 2 != 0 && g.n > 1 {
		var i = 0;
		var j = g.n - 1;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	out.i = t;
	out.s.clear();
	format(out.s, "reversed times: ", t);
	g.steps += t;
	out
}
@end
