fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = max(2, v.i);
	var runs_found = 0;
	var cur_run = 1;
	var p = 1;
	while p < g.n {
		if g.res[p] > g.res[p - 1] {
			cur_run++;
		} else {
			if cur_run >= min_len { runs_found++; }
			cur_run = 1;
		}
		p++;
	}
	if cur_run >= min_len { runs_found++; }
	out.i = runs_found;
	g.steps += runs_found;
	out.s.clear();
