fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = v.i;
	var reversed int[64] = [0; 64];
	var count = 0;
	var p = g.n - 1;
	while p >= 0 {
		let item = g.res[p];
		if count < 64 { reversed[count] = item; count++; }
		if item > threshold && count < 64 { reversed[count] = item; count++; }
		p--;
	}
	gold_clear(g);
	for k in count { gold_push(g, reversed[k]); }
	out.i = count;
	g.steps += count;
	out.s.clear();
	format(out.s, "reverse repeated count ", count);
