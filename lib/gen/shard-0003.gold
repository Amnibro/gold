slot: lo int
slot: hi int
test: list=2,3,4,5,6,7,8,9,10 lo=3 hi=7
expect: => i=15 r=0.0 ok=true s="" errors=0 n=9 res=[2,3,4,5,6,7,8,9,10] cache=0 hits=0
