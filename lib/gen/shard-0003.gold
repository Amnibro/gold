code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = ${allowance};
	var failed = 0;
	for i in g.n {
		if g.res[i] < 0 { failed++; }
	}
	if failed > budget {
		gold_fail(g, "negative numbers exceeded allowance");
		out.ok = false;
		out.i = 0;
	} else {
		out.ok = true;
		out.i = g.n - failed;
	}
	out.s.clear();
	format(out.s, "valid status ", out.ok);
	g.steps += g.n;
	out
}
@end
