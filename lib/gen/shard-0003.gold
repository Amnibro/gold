noun: digits
modifier: up_to
context: filter
phrase: merge digit values up to limit {limit} across filtered items
phrase: sum digits of elements up to limit threshold {limit}
slot: limit int
test: list=12,34,56 limit=3
expect: => i=7 r=0.0 ok=true s="" errors=0 n=3 res=[12,34,56] cache=0 hits=0
test: list=123,456 limit=4
expect: => i=12 r=0.0 ok=true s="" errors=0 n=2 res=[123,456] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var digit_sum = 0;
	var digits_count = 0;
	for k in g.n {
		var x = if g.res[k] < 0 { -g.res[k] } else { g.res[k] };
		if x == 0 && digits_count < lim {
			digits_count++;
		}
		while x > 0 && digits_count < lim {
			digit_sum += x % 10;
			x /= 10;
			digits_count++;
		}
		if digits_count >= lim { break; }
	}
	out.i = digit_sum;
	g.steps += digits_count;
	out
}
@end
