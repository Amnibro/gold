	while r < g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
		r++;
	}
	let removed = g.n - w;
	g.n = w;
	out.i = removed;
	g.steps += removed;
	out.s.clear();
	format(out.s, "deduped adjacent items removed ", removed);
	out
}
