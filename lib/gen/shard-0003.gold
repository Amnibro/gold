		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let tail_val = g.res[g.n - 1];
	if tail_val != exp {
		gold_fail(g, "tail element mismatch");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: expected ", exp, " found ", tail_val);
		return out;
	}
	g.steps += 1;
	out.i = tail_val;
	out.s.clear();
	format(out.s, "tail matched ", exp);
	out
}
