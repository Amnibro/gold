code:
fn ${ID}_check_prime(n int) bool {
	if n <= 1 { return false; }
	if n <= 3 { return true; }
	if n % 2 == 0 || n % 3 == 0 { return false; }
	var i = 5;
	while i * i <= n {
		if n % i == 0 || n % (i + 2) == 0 { return false; }
		i += 6;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_primes = true;
	var primes_count = 0;
	for i in g.n {
		if ${ID}_check_prime(g.res[i]) {
			primes_count++;
		} else {
			all_primes = false;
		}
	}
	out.ok = all_primes;
	out.i = primes_count;
	out
}
@end
