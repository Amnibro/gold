				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if count > 1 {
		let first = g.res[0];
		var p = 0;
		while p + 1 < count {
			g.res[p] = g.res[p + 1];
			p++;
		}
		g.res[count - 1] = first;
	}
	out.i = count;
	g.steps += count;
	out
}
