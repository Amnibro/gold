	var k = 0;
	while k < g.n {
		g.res[kept] = g.res[k];
		kept++;
		k += sz;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collected ", kept, " chunk heads");
