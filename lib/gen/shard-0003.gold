kind: step
verb: collect
noun: runs
modifier: times
context: stats
phrase: collect lengths of identical runs at least {min_len} long
phrase: identify consecutive matching runs at least {min_len} items
slot: min_len int
test: list=1,1,1,2,3,3,3,3 min_len=3
expect: => i=2 r=0.0 ok=true s="collected 2 qualifying run lengths" errors=0 n=2 res=[3,4] cache=0 hits=0
test: list=5,5,6,7,7,7 min_len=2
expect: => i=2 r=0.0 ok=true s="collected 2 qualifying run lengths" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var runs int[512] = [0; 512];
	var rn = 0;
	var i = 0;
	while i < g.n {
		var cur_len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			cur_len++;
			i++;
		}
		if cur_len >= ml {
			runs[rn] = cur_len;
			rn++;
		}
		i++;
	}
	for k in rn {
		g.res[k] = runs[k];
	}
	g.n = rn;
	g.steps += g.n;
	out.i = rn;
	out.s.clear();
	format(out.s, "collected ", rn, " qualifying run lengths");
	out
}
@end
