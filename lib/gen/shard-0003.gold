fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_group = 0;
	var cur_group = 1;
	if g.n == 0 { cur_group = 0; }
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_group++;
		} else {
			if cur_group > max_group { max_group = cur_group; }
			cur_group = 1;
		}
	}
	if cur_group > max_group { max_group = cur_group; }
	out.i = max_group;
	out.s.clear();
	format(out.s, "largest retry group size ", max_group);
	g.steps += g.n;
	out
}
