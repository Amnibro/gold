	let max_s = ${ceiling};
	var count = 0;
	let pairs = g.n / 2;
	for i in pairs {
		let s = g.res[i * 2] + g.res[i * 2 + 1];
		if s < max_s {
			g.res[count] = s;
			count += 1;
		}
	}
	g.n = count;
	g.steps += pairs;
	out.i = count;
	out.s.clear();
	format(out.s, "formed ", count, " search pairs below ceiling");
	out
}
@end
