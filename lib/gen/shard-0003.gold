@entry 82f606d9e0bc83a7
kind: step
verb: split
noun: squares
modifier: last
context: cache
phrase: split square numbers placing squares last in cache
phrase: partition square results to tail with cached roots
test: list=4,3,9,5
expect: => i=2 r=0.0 ok=true s="split 2 squares to last" errors=0 n=4 res=[3,5,4,9] cache=2 hits=0
test: list=16,25,2
expect: => i=2 r=0.0 ok=true s="split 2 squares to last" errors=0 n=3 res=[2,16,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_count = 0;
	var non_sq int[512] = [0; 512];
	var non_len = 0;
	var sq int[512] = [0; 512];
	var sq_len = 0;
	for i in g.n {
		let x = g.res[i];
		var r = 0;
		while r * r < x { r++; }
		if x >= 0 && r * r == x {
			gold_cache_put(g, x, r);
			sq[sq_len] = x;
			sq_len++;
			sq_count++;
		} else {
			non_sq[non_len] = x;
			non_len++;
		}
	}
	for i in non_len { g.res[i] = non_sq[i]; }
	for i in sq_len { g.res[non_len + i] = sq[i]; }
	g.steps += g.n * 2;
	out.i = sq_count;
	out.s.clear();
