code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig = g.n;
	for k in orig {
		if g.n < 512 {
			gold_push(g, g.res[k]);
		}
	}
	g.steps += orig * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "duplicated sequence without budget limit to ", g.n);
	out
}
@end
@entry d274d9aec5c851ef
kind: step
verb: fold
noun: value
modifier: nested
context: list
phrase: fold list values using nested pairwise products
phrase: accumulate nested pairwise products of results
