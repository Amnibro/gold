fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var squares_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 0 {
			var root = 0;
			while (root + 1) * (root + 1) <= x {
				root++;
			}
			if root * root == x {
				squares_count++;
			}
		}
		i++;
	}
	out.i = squares_count;
	out.ok = (squares_count == g.n);
	g.steps += g.n;
	out
}
