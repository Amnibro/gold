code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_val = g.res[0];
	var min_pos = 0;
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_pos = i;
		}
	}
	var temp int[64] = [0; 64];
	for k in g.n { if k < 64 { temp[k] = g.res[k]; } }
	for idx in g.n {
		let src = (idx + min_pos) % g.n;
		if src < 64 { g.res[idx] = temp[src]; }
	}
	out.i = min_pos;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated until min at head shift ", min_pos);
	out
}
@end
