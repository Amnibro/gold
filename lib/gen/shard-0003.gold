test: arg=123,159 bound=2
expect: true
expect: false
test: arg=19 bound=3
expect: false
code:
fn ${ID}(n int) bool {
	let max_gap = ${bound};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return true; }
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		let diff = if curr > prev { curr - prev } else { prev - curr };
		if diff > max_gap { return false; }
		prev = curr;
		x /= 10;
	}
	true
}
@end
