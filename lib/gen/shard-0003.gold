@entry 620fccbe7268bc84
kind: step
verb: cache
noun: history
modifier: sorted
context: retry
phrase: cache history in sorted order
phrase: store sorted history into cache memory
test: list=30,10,20
expect: => i=10 r=0.0 ok=true s="cached sorted history bounds" errors=0 n=3 res=[10,20,30] cache=2 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty history" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no history items to cache");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty history");
		return out;
	}
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	gold_cache_put(g, 0, g.res[0]);
	gold_cache_put(g, 1, g.res[g.n - 1]);
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "cached sorted history bounds");
	out
}
@end
