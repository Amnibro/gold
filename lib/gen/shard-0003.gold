code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var run = 0;
	var count = 0;
	while count < g.n && run + g.res[count] <= limit {
		run += g.res[count];
		count += 1;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "scanned ", count, " series items up to sum limit");
	out
}
@end
