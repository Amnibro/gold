code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var isp = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { isp = false; break; }
				d++;
			}
			if isp { prime_count++; }
		}
		i++;
	}
	let pairs = prime_count / 2;
	out.i = pairs;
	out.s.clear();
	format(out.s, "prime pairs: ", pairs);
	g.steps += g.n;
	out
}
@end
