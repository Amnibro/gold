fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let upper = v.i;
	let lower = 10;
	var seen_mid int[64] = [0; 64];
	var mid_count = 0;
	var w = 0;
	for r in g.n {
		let val = g.res[r];
		if val >= lower && val <= upper {
			var dup = false;
			for m in mid_count {
				if seen_mid[m] == val { dup = true; break; }
			}
			if !dup {
				if mid_count < 64 { seen_mid[mid_count] = val; mid_count++; }
				g.res[w] = val;
				w++;
			}
		} else {
			g.res[w] = val;
			w++;
		}
	}
	g.n = w;
	out.i = mid_count;
	g.steps += mid_count;
	out.s.clear();
	format(out.s, "deduped between bounds count ", mid_count);
	out
}
@end
