			g.res[w] = g.res[i];
			w += 1;
			kept += 1;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " elements at least ", bnd);
