slot: min_digits int
test: list=5,23,105,42 min_digits=2
expect: => i=170 r=0.0 ok=true s="folded 3 items total 170" errors=0 n=4 res=[5,23,105,42] cache=0 hits=0
test: list=1,2,304,500 min_digits=3
expect: => i=804 r=0.0 ok=true s="folded 2 items total 804" errors=0 n=4 res=[1,2,304,500] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_digits};
	var total = 0;
	var matched = 0;
	for i in g.n {
		var num = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var d = 0;
		if num == 0 { d = 1; }
		while num > 0 { d++; num /= 10; }
		if d >= req {
			total += g.res[i];
			matched++;
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "folded ", matched, " items total ", total);
	g.steps += g.n;
	out
}
@end
