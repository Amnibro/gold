@entry 2fccc191dd92e2e4
kind: step
verb: swap
noun: primes
modifier: sorted
context: math
phrase: swap prime elements into sorted order
phrase: reorder prime numbers in sorted order
test: list=7,4,3,2,9
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,3,7,9] cache=0 hits=0
test: list=5,8,2,6,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,8,3,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes_arr int[512] = [0; 512];
	var p_cnt = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = (x >= 2);
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			primes_arr[p_cnt] = x;
			p_cnt++;
		}
		i++;
	}
	var a = 0;
	while a < p_cnt {
		var b = a + 1;
		while b < p_cnt {
			if primes_arr[a] > primes_arr[b] {
				let tmp = primes_arr[a];
				primes_arr[a] = primes_arr[b];
				primes_arr[b] = tmp;
			}
			b++;
		}
		a++;
	}
	var p_read = 0;
	var j = 0;
	while j < g.n {
		let y = g.res[j];
		var is_p2 = (y >= 2);
		var d2 = 2;
		while d2 * d2 <= y {
			if y % d2 == 0 { is_p2 = false; break; }
			d2++;
		}
		if is_p2 {
			g.res[j] = primes_arr[p_read];
			p_read++;
		}
		j++;
	}
	out.i = p_cnt;
	g.steps += g.n;
	out
}
@end
