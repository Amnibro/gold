fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let offset = ${times};
	if offset < 0 || g.n == 0 {
		gold_fail(g, "invalid rotation times");
		out.ok = false;
		out.i = 0;
		return out;
	}
	if g.n > 1 {
		for t in offset {
			let last = g.res[g.n - 1];
			var k = g.n - 1;
			while k > 0 { g.res[k] = g.res[k - 1]; k--; }
			g.res[0] = last;
		}
	}
	out.i = g.n;
	g.steps += g.n * (offset + 1);
	out
}
@end
