@entry 423fbe4e2a290762
kind: step
verb: clamp
noun: range
modifier: unique
context: error
phrase: clamp unique elements to range {lo} through {hi}
phrase: bound distinct items within limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=2,2,8,10 lo=3 hi=7
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=2,8 lo=10 hi=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if low > high {
		gold_fail(g, "inverted clamp range");
		out.ok = false;
		out.i = 0;
		return out;
	}
	var kept int[512] = [0; 512];
	var kn = 0;
	for k in g.n {
		var x = g.res[k];
		if x < low { x = low; }
		else if x > high { x = high; }
		var seen = false;
		for p in kn { if kept[p] == x { seen = true; break; } }
		if !seen { kept[kn] = x; kn++; }
	}
	gold_clear(g);
	for p in kn { gold_push(g, kept[p]); }
	out.i = kn;
	g.steps += g.n;
	out
}
@end
