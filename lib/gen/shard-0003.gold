fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_len = 1;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] >= g.res[k - 1] {
			cur_len++;
			if cur_len > max_len { max_len = cur_len; }
		} else {
			cur_len = 1;
		}
	}
	out.i = max_len;
	g.steps += g.n;
	out
}
@end
