	if g.n < 2 { return out; }
	var max_gap = 0;
	for k in 1..g.n {
		let gap = core_abs_val(g.res[k] - g.res[k - 1]);
		if gap > max_gap { max_gap = gap; }
	}
	out.i = max_gap;
	out.s.clear();
	format(out.s, "maximum gap ranked ", max_gap);
	g.steps += g.n;
	out
}
