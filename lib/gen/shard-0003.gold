			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var sum_sq = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		sum_sq += diff * diff;
		k++;
	}
	out.i = sum_sq;
	g.steps += g.n;
	out
}
@end
