expect: => i=0 r=18.75 ok=true s="clamped 0 values toward average" errors=0 n=4 res=[5,15,25,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var adjusted = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			break;
		}
		if g.res[i] > avg {
			g.res[i] = avg;
			adjusted++;
		}
	}
	g.steps += g.n * 2;
	out.i = adjusted;
	out.r = (sum as real) / (g.n as real);
	out.s.clear();
	format(out.s, "clamped ", adjusted, " values toward average");
	out
}
@end
