@entry 5cecb78c2754a80e
kind: step
verb: scan
noun: duplicates
modifier: between
context: list
phrase: scan duplicate values occurring between index {low} to {high}
phrase: count repeating elements between range bounds {low} to {high}
phrase: inspect slice between indices {low} to {high} for duplicates
slot: low int
slot: high int
test: list=1,2,2,3,1 low=0 high=3
expect: => i=1 r=0.0 ok=true s="found 1 duplicate occurrences" errors=0 n=5 res=[1,2,2,3,1] cache=0 hits=0
