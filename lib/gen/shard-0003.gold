fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	var sorted = true;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
		i++;
	}
	let res_val = if sorted { 1 } else { 0 };
	gold_cache_put(g, k, res_val);
	out.i = res_val;
	out.ok = sorted;
	g.steps += g.n;
	out
}
@end
