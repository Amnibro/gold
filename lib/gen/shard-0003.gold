@entry dbbc08dce42da735
kind: step
verb: measure
noun: steps
modifier: in_place
context: search
phrase: measure cumulative step distance in place
phrase: evaluate total step interval across search entries in place
phrase: calculate aggregate search step differences in place
test: list=2,7,4,10
expect: => i=14 r=0.0 ok=true s="total step distance is 14" errors=0 n=1 res=[14] cache=0 hits=0
test: list=5,15,8
expect: => i=17 r=0.0 ok=true s="total step distance is 17" errors=0 n=1 res=[17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dist = 0;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			var d = g.res[i] - g.res[i - 1];
			if d < 0 { d = -d; }
			dist += d;
			i += 1;
		}
	}
	g.res[0] = dist;
	g.n = 1;
	g.steps += 1;
	out.i = dist;
	out.s.clear();
	format(out.s, "total step distance is ", dist);
	out
}
@end
