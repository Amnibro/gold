expect: => i=3 r=0.0 ok=true s="retained 3 distinct retry delays" errors=0 n=3 res=[100,200,300] cache=0 hits=0
test: list=50,50,50
expect: => i=1 r=0.0 ok=true s="retained 1 distinct retry delays" errors=0 n=1 res=[50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let item = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == item { seen = true; break; }
		}
		if !seen {
			g.res[kept] = item;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " distinct retry delays");
	g.steps += g.n;
	out
}
@end
