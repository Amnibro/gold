phrase: group odd search values to front of list
phrase: partition odd numbers before evens in search results
test: list=2,3,4,5,6,7
expect: => i=3 r=0.0 ok=true s="grouped 3 odd values to front" errors=0 n=6 res=[3,5,7,2,4,6] cache=0 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="grouped 2 odd values to front" errors=0 n=4 res=[11,13,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var evens int[512] = [0; 512];
	var on = 0;
	var en = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[on] = g.res[i];
			on++;
		} else {
			evens[en] = g.res[i];
			en++;
		}
	}
	for i in on {
		g.res[i] = odds[i];
	}
	for i in en {
		g.res[on + i] = evens[i];
	}
	g.steps += g.n;
	out.i = on;
	out.s.clear();
	format(out.s, "grouped ", on, " odd values to front");
	out
}
@end
