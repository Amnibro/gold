noun: primes
modifier: in_place
context: search
phrase: select prime search numbers in place
phrase: filter prime candidates in place
phrase: retain prime values from search in place
test: list=4,7,8,11,15,17
expect: => i=3 r=0.0 ok=true s="selected 3 prime search items" errors=0 n=3 res=[7,11,17] cache=0 hits=0
test: list=2,9,13,16
expect: => i=2 r=0.0 ok=true s="selected 2 prime search items" errors=0 n=2 res=[2,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = false;
		if x >= 2 {
			is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
				}
				d += 1;
			}
		}
		if is_p {
			g.res[count] = x;
			count += 1;
		}
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "selected ", count, " prime search items");
	out
}
@end
@entry 87c793ad417c5a93
kind: step
verb: keep
noun: gaps
modifier: with_cache
context: search
phrase: keep search items with gaps above {min_gap} storing sum in cache
phrase: filter search values with gap exceeding {min_gap} with cache
phrase: retain search entries with step gap above {min_gap} with cache
slot: min_gap int
test: list=10,12,20,22,35 min_gap=5
expect: => i=3 r=0.0 ok=true s="retained 3 items with cache sum 25" errors=0 n=3 res=[10,20,35] cache=1 hits=0
test: list=1,2,3 min_gap=5
expect: => i=1 r=0.0 ok=true s="retained 1 items with cache sum 0" errors=0 n=1 res=[1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_gap};
	var gap_sum = 0;
	var count = 0;
	if g.n > 0 {
		var last = g.res[0];
		count = 1;
		var i = 1;
		while i < g.n {
			var d = g.res[i] - last;
			if d < 0 { d = -d; }
			if d >= threshold {
				g.res[count] = g.res[i];
				last = g.res[i];
				count += 1;
				gap_sum += d;
			}
			i += 1;
		}
		g.n = count;
	}
	gold_cache_put(g, 0, gap_sum);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "retained ", count, " items with cache sum ", gap_sum);
	out
}
@end
