expect: => i=3 r=0.0 ok=true s="rotated head span 3" errors=0 n=5 res=[1,3,4,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${st};
	let end = ${en};
	if start >= 0 && end < g.n && start < end {
		let first_elem = g.res[start];
		var p = start;
		while p < end {
			g.res[p] = g.res[p + 1];
			p++;
		}
		g.res[end] = first_elem;
	}
	out.i = end - start;
	out.s.clear();
	format(out.s, "rotated head span ", end - start);
	g.steps += g.n;
	out
}
@end
