fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_total};
	var running = 0;
	var kn = 0;
	for k in g.n {
		if running + g.res[k] <= limit {
			running += g.res[k];
			g.res[kn] = g.res[k];
			kn++;
		} else {
			break;
		}
	}
	g.n = kn;
	out.i = running;
	g.steps += g.n;
	out
}
