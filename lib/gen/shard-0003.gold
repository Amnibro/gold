			matched[mn] = g.res[k];
			mn++;
		}
	}
	var i = 0;
	while i < mn {
		var j = i + 1;
		while j < mn {
			if matched[i] > matched[j] {
				let tmp = matched[i];
				matched[i] = matched[j];
				matched[j] = tmp;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in mn { gold_push(g, matched[k]); }
	out.i = mn;
	g.steps += g.n;
	out
}
@end
