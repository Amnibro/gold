@entry 86f51539d793b4ea
kind: step
verb: scale
noun: minimum
modifier: with_retry
context: list
phrase: scale minimum element with factor {factor} targeting {threshold}
phrase: multiply minimum repeatedly by {factor} until threshold {threshold}
phrase: boost lowest list value by {factor} towards {threshold}
slot: factor int
slot: threshold int
test: list=10,2,8 factor=2 threshold=15
expect: => i=16 r=0.0 ok=true s="scaled minimum to 16 in 3 attempts" errors=0 n=3 res=[10,16,8] cache=0 hits=0
test: list=50,3,99 factor=3 threshold=20
expect: => i=27 r=0.0 ok=true s="scaled minimum to 27 in 2 attempts" errors=0 n=3 res=[50,27,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	let thresh = ${threshold};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	var retries = 0;
	while min_val < thresh && retries < 10 {
		min_val *= fac;
		retries += 1;
	}
	g.res[min_idx] = min_val;
	g.steps += retries;
	out.i = min_val;
	out.s.clear();
	format(out.s, "scaled minimum to ", min_val, " in ", retries, " attempts");
	out
}
@end
@entry 44979a214f989526
kind: step
verb: scale
noun: middle
modifier: sorted
context: list
phrase: sort middle section scaling values by factor {factor}
phrase: order middle elements multiplying items by {factor}
phrase: scale sorted middle subarray by factor {factor}
slot: factor int
test: list=9,8,5,2,7,1 factor=2
expect: => i=2 r=0.0 ok=true s="sorted and scaled 2 middle items" errors=0 n=6 res=[9,8,4,10,7,1] cache=0 hits=0
test: list=10,30,20,50,40,60 factor=3
expect: => i=2 r=0.0 ok=true s="sorted and scaled 2 middle items" errors=0 n=6 res=[10,30,60,150,40,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fac = ${factor};
	let third = g.n / 3;
	let start = third;
	let end = g.n - third;
	if end > start {
		var i = start;
		while i < end {
			var min_k = i;
			var j = i + 1;
			while j < end {
				if g.res[j] < g.res[min_k] { min_k = j; }
				j += 1;
			}
			let tmp = g.res[i];
			g.res[i] = g.res[min_k];
			g.res[min_k] = tmp;
			g.res[i] *= fac;
			i += 1;
		}
	}
	g.steps += g.n;
	out.i = end - start;
	out.s.clear();
	format(out.s, "sorted and scaled ", out.i, " middle items");
	out
}
@end
