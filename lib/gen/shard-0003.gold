code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	let pairs = g.n / 2;
	for i in pairs {
		var a = g.res[i * 2];
		var b = g.res[i * 2 + 1];
		if a > ceiling { a = ceiling; }
		if b > ceiling { b = ceiling; }
		g.res[i] = a + b;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired ", pairs, " items under nested limit");
	out
}
@end
