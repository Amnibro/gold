test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="centered around mean 20" errors=0 n=3 res=[-10,0,10] cache=0 hits=0
test: list=5,15,25,35
expect: => i=20 r=0.0 ok=true s="centered around mean 20" errors=0 n=4 res=[-15,-5,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 {
        out.i = 0;
        return out;
    }
    var sum = 0;
    for i in g.n { sum += g.res[i]; }
    let mean = sum / g.n;
    for i in g.n {
        g.res[i] = g.res[i] - mean;
    }
    g.steps += g.n;
    out.i = mean;
    out.s.clear();
    format(out.s, "centered around mean ", mean);
    out
}
@end
