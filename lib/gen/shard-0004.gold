code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt int[512] = [0; 512];
	var alt_cnt = 0;
	var i = 0;
	while i < g.n {
		alt[alt_cnt] = g.res[i];
		alt_cnt++;
		i += 2;
	}
	if alt_cnt > 1 {
		let first = alt[0];
		for j in 1..alt_cnt {
			alt[j - 1] = alt[j];
		}
		alt[alt_cnt - 1] = first;
		var w = 0;
		var pos = 0;
		while pos < g.n {
			g.res[pos] = alt[w];
			gold_cache_put(g, pos, alt[w]);
			w++;
			pos += 2;
		}
	}
	g.steps += alt_cnt + 1;
	out.i = alt_cnt;
	out.s.clear();
	format(out.s, "rotated ", alt_cnt, " alternating cached values");
	out
}
@end
