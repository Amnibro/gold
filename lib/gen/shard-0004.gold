code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_count = 0;
	var cur_run = 0;
	var prev = -999999;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x == prev {
			cur_run++;
		} else {
			if cur_run >= 2 { run_count++; }
			cur_run = 1;
			prev = x;
		}
		i += 2;
	}
	if cur_run >= 2 { run_count++; }
	g.steps += g.n + 1;
	out.i = run_count;
	out.s.clear();
	format(out.s, "found ", run_count, " alternating runs");
	out
}
@end
