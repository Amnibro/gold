kind: step
verb: normalize
noun: suffix
modifier: all
context: text
phrase: normalize all suffix characters to lowercase {count}
phrase: convert trailing text characters to lowercase {count}
slot: count int
test: text="helloWORLD" count=5
expect: => i=5 r=0.0 ok=true s="helloworld" errors=0 n=0 res=[] cache=0 hits=0
test: text="ABCdefGHI" count=3
expect: => i=3 r=0.0 ok=true s="ABCdefghi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let k = ${count};
    if k <= 0 {
        gold_fail(g, "non-positive suffix count");
        out.ok = false;
        return out;
    }
    let lim = if k > out.s.len { out.s.len } else { k };
    let start = out.s.len - lim;
    var normalized = 0;
    for i in lim {
        let ch = out.s[start + i];
        if ch >= 'A' && ch <= 'Z' {
            let offset = (ch as int) - ('A' as int);
            out.s[start + i] = (('a' as int) + offset) as! byte;
            normalized++;
        }
    }
    g.steps += lim;
    out.i = normalized;
    out
}
@end
