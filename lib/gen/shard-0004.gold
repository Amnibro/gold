noun: streak
modifier: in_place
context: aggregate
phrase: merge consecutive equal streaks in place
phrase: compress duplicate streaks into sum in place

test: list=2,2,2,5,5,7
expect: => i=3 r=0.0 ok=true s="merged streaks into count 3" errors=0 n=3 res=[6,10,7] cache=0 hits=0
test: list=3,3,4,4
expect: => i=2 r=0.0 ok=true s="merged streaks into count 2" errors=0 n=2 res=[6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			sum += g.res[j];
			j++;
		}
		g.res[kept] = sum;
		kept++;
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "merged streaks into count ", kept);
	out
}
@end
