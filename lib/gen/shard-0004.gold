code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_cost = ${budget};
	var spent = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			if spent + x <= max_cost {
				spent += x;
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("scanned unique budget items");
	out
}
@end
