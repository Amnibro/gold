noun: middle
modifier: nested
context: transform
phrase: validate middle element between endpoints
phrase: verify central item bounded by ends
test: list=2,5,9
expect: => i=5 r=0.0 ok=true s="validated middle element bounded 5" errors=0 n=3 res=[2,5,9] cache=0 hits=0
test: list=10,2,8
expect: => i=0 r=0.0 ok=false s="error: middle not bounded" errors=1 n=3 res=[10,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	let mid = g.n / 2;
	let val = g.res[mid];
	let first = g.res[0];
	let last = g.res[g.n - 1];
	var ok = false;
	if (val >= first && val <= last) || (val >= last && val <= first) {
		ok = true;
	}
	g.steps += g.n;
	if !ok {
		gold_fail(g, "middle element not between endpoints");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: middle not bounded");
	} else {
		out.i = val;
		out.s.clear();
		format(out.s, "validated middle element bounded ", val);
	}
	out
}
@end
