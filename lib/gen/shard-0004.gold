code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let cap = ${times};
    if cap <= 0 {
        gold_fail(g, "non-positive limit times");
        out.ok = false;
        return out;
    }
    var counts byte[256] = [0; 256];
    var res byte[..200] = "";
    for i in out.s.len {
        let ch = out.s[i];
        let idx = ch as int;
        if (counts[idx] as int) < cap {
            counts[idx]++;
            if res.len < 200 { res.push(ch); }
        }
    }
    g.steps += out.s.len;
    out.i = res.len;
    out.s.clear();
    for b in res { out.s.push(b); }
    out
}
@end
