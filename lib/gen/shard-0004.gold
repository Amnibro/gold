fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = if ${length} > g.n { g.n } else { ${length} };
	for i in len {
		for j in len - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	var l = 0;
	var r = len - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += len * 2;
	out.i = len;
	out.s.clear();
	out.s.append("sorted and reversed prefix");
	out
}
