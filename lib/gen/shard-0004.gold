fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens += g.res[i]; }
		else { odds += g.res[i]; }
	}
	g.res[0] = ${f}(evens);
	g.res[1] = ${f}(odds);
	g.n = 2;
	g.steps += 1;
	out.i = 2;
	out.s.clear();
	out.s.append("aggregated parity groups safely");
	out
}
@end
@entry f3b8b2daa94a7e49
kind: step
verb: shift
noun: digits
modifier: sorted
context: aggregate
phrase: shift digits sorted into ascending list
phrase: aggregate sorted digits from results
test: list=42,19
expect: => i=4 r=0.0 ok=true s="aggregated sorted digits" errors=0 n=4 res=[1,2,4,9] cache=0 hits=0
test: list=305
expect: => i=3 r=0.0 ok=true s="aggregated sorted digits" errors=0 n=3 res=[0,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits int[512] = [0; 512];
	var d_cnt = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		if x == 0 {
			digits[d_cnt] = 0;
			d_cnt++;
		} else {
			while x > 0 {
				digits[d_cnt] = x % 10;
				d_cnt++;
				x /= 10;
			}
		}
	}
	for i in d_cnt {
		for j in d_cnt - 1 - i {
			if digits[j] > digits[j + 1] {
				let tmp = digits[j];
				digits[j] = digits[j + 1];
				digits[j + 1] = tmp;
			}
		}
	}
	for i in d_cnt { g.res[i] = digits[i]; }
	g.n = d_cnt;
	g.steps += d_cnt;
	out.i = d_cnt;
	out.s.clear();
	out.s.append("aggregated sorted digits");
	out
}
@end
