code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var grand = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		while x > 0 {
			grand += x % 10;
			x /= 10;
		}
	}
	out.i = grand;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "digit sum ", grand);
	out
}
@end
@entry e4cd0b90b8cc7cde
kind: step
verb: drop
noun: middle
modifier: up_to
context: compare
phrase: drop middle comparison items up to count {limit}
phrase: remove central elements up to limit {limit}
slot: limit int
test: list=1,2,3,4,5 limit=2
expect: => i=2 r=0.0 ok=true s="dropped middle items: 2" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=10,20,30 limit=1
expect: => i=1 r=0.0 ok=true s="dropped middle items: 1" errors=0 n=2 res=[10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drop = ${limit};
	var dropped = 0;
	while dropped < max_drop && g.n > 2 {
		let mid = g.n / 2;
		for i in mid..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.n--;
		dropped++;
	}
	g.steps += dropped * g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped middle items: ", dropped);
	out
}
@end
@entry 68f71bc1c7f6e29d
kind: step
