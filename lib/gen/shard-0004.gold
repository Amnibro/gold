fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var count = 0;
    for i in g.n {
        let x = g.res[i];
        var seen_count = 0;
        for j in g.n {
            if g.res[j] == x { seen_count++; }
        }
        if seen_count == 1 {
            g.res[i] = ${f}(g.res[i]);
            count++;
        }
    }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "transformed ", count, " strictly unique elements");
    out
}
