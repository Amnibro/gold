		return out;
	}
	let span = min(c, g.n);
	let start = g.n - span;
	out.s.clear();
	for i in start..g.n {
		if i > start { out.s.push('/'); }
		format(out.s, g.res[i]);
	}
	g.steps += span + 1;
	out.i = span;
	out
}
@end
@entry ac125c5b410d7b42
kind: step
