code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = g.n;
	while kept > 0 && !${check}(g.res[kept - 1]) {
		kept--;
	}
	let dropped = g.n - kept;
	g.steps += g.n;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " trailing items");
	out
}
@end
@entry 1abff03cf82cbb58
kind: step
verb: compare
noun: runs
modifier: with_cache
context: core
phrase: compare runs of {key} with cache
phrase: check streak count of {key} against cached score
slot: key int
test: list=5,5,5,2,5 key=5
expect: => i=3 r=0.0 ok=false s="max run of 5 is 3" errors=0 n=5 res=[5,5,5,2,5] cache=1 hits=0
test: list=7,7,3,7,7,7 key=7
expect: => i=3 r=0.0 ok=false s="max run of 7 is 3" errors=0 n=6 res=[7,7,3,7,7,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${key};
	var max_run = 0;
	var cur_run = 0;
	for i in g.n {
		if g.res[i] == target {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 0;
		}
	}
	let prev, ok = gold_cache_get(g, target);
	out.ok = ok && (prev == max_run);
	gold_cache_put(g, target, max_run);
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "max run of ", target, " is ", max_run);
	out
}
@end
