fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var removed = 0;
	var last_odd = -999999;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			if x == last_odd {
				removed++;
				continue;
			}
			last_odd = x;
		}
		g.res[w] = x;
		w++;
	}
	g.n = w;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped sorted odds, removed ", removed);
	out
}
@end
