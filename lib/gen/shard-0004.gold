fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_prime};
	var cur = out.i;
	var count = 0;
	while cur <= cap {
		if ${ID}_is_prime(cur) {
			gold_push(g, cur);
			count++;
		}
		cur++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "collected primes up to limit ", count);
	out
}
@end
