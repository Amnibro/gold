code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var kept = 0;
    var dropped = 0;
    for i in g.n {
        let x = g.res[i];
        if x % 2 == 0 {
            gold_cache_put(g, dropped, x);
            dropped++;
        } else {
            g.res[kept] = x;
            kept++;
        }
    }
    g.steps += g.n;
    g.n = kept;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " evens to cache");
    out
}
@end
