@entry ff42860f119600fa
kind: step
verb: rotate
noun: errors
modifier: while
context: loop
phrase: rotate errors while predicate {cond} holds
phrase: shift error records while condition {cond}
slot: cond pred
test: list=2,4,6,3 cond=is_even
expect: => i=3 r=0.0 ok=true s="rotated errors while count 3" errors=0 n=4 res=[3,2,4,6] cache=0 hits=0
test: list=1,2,3 cond=is_even
expect: => i=0 r=0.0 ok=false s="error: condition not met at start" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for rotate while");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var count = 0;
	while count < g.n && ${cond}(g.res[0]) {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		count++;
	}
	if count == 0 {
		gold_fail(g, "initial condition failed for rotate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: condition not met at start");
		return out;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated errors while count ", count);
	out
}
@end
