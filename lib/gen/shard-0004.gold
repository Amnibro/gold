code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for pairwise mapping");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = ${op}(g.res[i] + g.res[i + 1]);
	}
	g.steps += g.n - 1;
	g.n -= 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped pairwise items ", g.n);
	out
}
@end
