test: list=1,2,2,3,3,3
expect: => i=2 r=0.0 ok=true s="kept reversed duplicates count 2" errors=0 n=2 res=[3,2] cache=0 hits=0
test: list=5,6,7,7
expect: => i=1 r=0.0 ok=true s="kept reversed duplicates count 1" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
		}
		if count > 1 {
			var exists = false;
			for k in dn {
				if dups[k] == g.res[i] {
					exists = true;
				}
			}
			if !exists {
				dups[dn] = g.res[i];
				dn++;
			}
		}
	}
	for i in dn {
		g.res[i] = dups[dn - 1 - i];
	}
	g.n = dn;
	out.i = dn;
	g.steps += dn + 1;
	out.s.clear();
	format(out.s, "kept reversed duplicates count ", dn);
	out
}
@end
