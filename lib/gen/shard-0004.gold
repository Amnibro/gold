@entry 1f1477af22c64d9a
kind: step
verb: cache
noun: gaps
modifier: unique
context: math
phrase: cache unique gap sizes between adjacent items
phrase: store distinct step differences to cache
test: list=10,15,17,22,24
expect: => i=2 r=0.0 ok=true s="cached 2 unique gaps" errors=0 n=5 res=[10,15,17,22,24] cache=2 hits=2
test: list=1,4,7,12,15
expect: => i=2 r=0.0 ok=true s="cached 2 unique gaps" errors=0 n=5 res=[1,4,7,12,15] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var cached = 0;
    for i in g.n - 1 {
        let diff = g.res[i + 1] - g.res[i];
        let gap = if diff < 0 { -diff } else { diff };
        let _, ok = gold_cache_get(g, gap);
        if !ok {
            gold_cache_put(g, gap, 1);
            cached++;
        }
    }
    g.steps += g.n;
    out.i = cached;
    out.s.clear();
    format(out.s, "cached ", cached, " unique gaps");
    out
}
@end
