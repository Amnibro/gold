fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let max_pairs = ${cap};
    if max_pairs <= 0 {
        gold_fail(g, "non-positive pairs limit");
        out.ok = false;
        return out;
    }
    var pairs = 0;
    var idx = 0;
    while idx + 1 < out.s.len {
        if pairs >= max_pairs { break; }
        gold_push(g, (out.s[idx] as int) + (out.s[idx + 1] as int));
        pairs++;
        idx += 2;
    }
    g.steps += pairs;
    out.i = pairs;
    out.s.clear();
    format(out.s, "recorded ", pairs, " nested pairs");
    out
}
