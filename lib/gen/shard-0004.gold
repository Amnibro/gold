fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${floor_val};
	var adjusted = 0;
	for i in g.n {
		let val = ${func}(g.res[i]);
		if val < floor {
			g.res[i] = floor;
			adjusted++;
		} else {
			g.res[i] = val;
		}
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped function values count ", adjusted);
	out
}
