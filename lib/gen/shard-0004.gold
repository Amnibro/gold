fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for gap differences");
		out.ok = false;
		return out;
	}
	for i in g.n - 1 {
		g.res[i] = g.res[i + 1] - g.res[i];
	}
	g.steps += g.n - 1;
	g.n -= 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "computed gaps list count ", g.n);
	out
}
