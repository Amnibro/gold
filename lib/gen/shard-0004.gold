test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="reverse distinct count is 3" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
test: list=4,4,5,6,6
expect: => i=3 r=0.0 ok=true s="reverse distinct count is 3" errors=0 n=5 res=[4,4,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var distinct = 0;
    var i = g.n - 1;
    while i >= 0 {
        let x = g.res[i];
        var seen = false;
        var j = g.n - 1;
        while j > i {
            if g.res[j] == x { seen = true; break; }
            j--;
        }
        if !seen { distinct++; }
        i--;
    }
    g.steps += g.n;
    out.i = distinct;
    out.s.clear();
    format(out.s, "reverse distinct count is ", distinct);
    out
}
@end
