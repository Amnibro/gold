expect: => i=90 r=0.0 ok=true s="unique values sum is 90" errors=0 n=5 res=[10,20,30,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var sum = 0;
    for i in g.n {
        let x = g.res[i];
        var count = 0;
        for j in g.n {
            if g.res[j] == x { count++; }
        }
        if count == 1 {
            sum += x;
        }
    }
    g.steps += g.n * g.n;
    out.i = sum;
    out.s.clear();
    format(out.s, "unique values sum is ", sum);
    out
}
@end
@entry 77f22e59456fe45b
kind: step
verb: fill
noun: digits
modifier: unique
context: list
phrase: fill list with unique digits from input
phrase: extract distinct decimal digits into results
test: input=122334
expect: => i=4 r=0.0 ok=true s="filled 4 unique digits" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: input=98877
expect: => i=3 r=0.0 ok=true s="filled 3 unique digits" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var x = if out.i < 0 { -out.i } else { out.i };
    gold_clear(g);
    while x > 0 {
        let d = x % 10;
        var seen = false;
        for i in g.n {
            if g.res[i] == d { seen = true; break; }
        }
        if !seen {
            gold_push(g, d);
        }
        x /= 10;
    }
    g.steps += g.n;
    out.i = g.n;
    out.s.clear();
    format(out.s, "filled ", g.n, " unique digits");
    out
}
@end
