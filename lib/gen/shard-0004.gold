expect: => i=0 r=0.0 ok=false s="samples within interval count 0" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var in_range_count = 0;
	var sum_in_range = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= low && x <= high {
			in_range_count++;
			sum_in_range += x;
		}
	}
	out.i = in_range_count;
	out.ok = in_range_count > 0;
	out.s.clear();
	format(out.s, "samples within interval count ", in_range_count);
	g.steps += g.n + 1;
	out
}
@end
