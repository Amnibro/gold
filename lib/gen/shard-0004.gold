@entry 60ba71ed48b0f3e3
kind: step
verb: validate
noun: loop
modifier: times
context: stats
phrase: validate sample stability loop across {times} iterations
phrase: check statistical convergence loop over {times} cycles
slot: times int
test: list=10,12,14,16 times=3
expect: => i=6 r=0.0 ok=true s="loop validated stable variation 6" errors=0 n=4 res=[10,12,14,16] cache=0 hits=0
test: list=10,50,20,80 times=3
expect: => i=130 r=0.0 ok=false s="loop unstable high variation 130" errors=0 n=4 res=[10,50,20,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let iters = ${times};
	if g.n <= 1 {
		out.ok = false;
		return out;
	}
	var total_delta = 0;
	for t in iters {
		var step_delta = 0;
		for i in g.n - 1 {
			var d = g.res[i + 1] - g.res[i];
			if d < 0 {
				d = -d;
			}
			step_delta += d;
		}
		total_delta += step_delta;
	}
	let avg_delta = total_delta / iters;
	out.i = avg_delta;
	out.ok = avg_delta <= 10;
	out.s.clear();
	if avg_delta <= 10 {
		format(out.s, "loop validated stable variation ", avg_delta);
	} else {
		format(out.s, "loop unstable high variation ", avg_delta);
	}
	g.steps += iters * g.n + 1;
	out
}
@end
@entry 261a3e7c265b500c
kind: step
verb: clamp
noun: number
modifier: running
context: stats
phrase: clamp running sample accumulation under ceiling {cap}
phrase: restrict running observation total to cap {cap}
slot: cap int
test: list=20,30,40,50 cap=60
expect: => i=60 r=0.0 ok=true s="clamped running sum total 60" errors=0 n=4 res=[20,30,10,0] cache=0 hits=0
test: list=5,10,15 cap=60
expect: => i=30 r=0.0 ok=false s="clamped running sum total 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var running_sum = 0;
	var clamped_steps = 0;
	for i in g.n {
		running_sum += g.res[i];
		if running_sum > limit {
			let excess = running_sum - limit;
			g.res[i] -= excess;
			running_sum = limit;
			clamped_steps++;
		}
	}
	out.i = running_sum;
	out.ok = clamped_steps > 0;
	out.s.clear();
	format(out.s, "clamped running sum total ", running_sum);
	g.steps += g.n + 1;
	out
}
@end
@entry 3d07a07d3640fb9c
kind: step
verb: trace
noun: condition
modifier: between
context: stats
phrase: trace sample points spanning range from {lo} to {hi}
