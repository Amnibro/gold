fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_sum = g.res[0];
	var cur_sum = g.res[0];
	for i in 1..g.n {
		let x = g.res[i];
		cur_sum = if cur_sum + x > x { cur_sum + x } else { x };
		if cur_sum > max_sum {
			max_sum = cur_sum;
		}
	}
	g.steps += g.n;
	out.i = max_sum;
	out.s.clear();
	out.s.append("found maximum sum window");
	out
}
@end
