			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
		}
	}
	g.steps += g.n;
	out.i = max_run;
	out.s.clear();
	format(out.s, "longest sorted run ", max_run);
