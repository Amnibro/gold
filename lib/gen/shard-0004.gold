code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let m = ${min_chars};
    if m <= 0 {
        gold_fail(g, "non-positive minimum count");
        out.ok = false;
        return out;
    }
    if out.s.len < m {
        gold_fail(g, "insufficient text length");
        out.ok = false;
        return out;
    }
    let start = out.s.len - m;
    var cached = 0;
    for i in m {
        let ch = out.s[start + i] as int;
        gold_cache_put(g, i, ch);
        cached++;
    }
    g.steps += cached;
    out.i = cached;
    out.s.clear();
    format(out.s, "cached ", cached, " tail bytes");
    out
}
@end
