fn ${ID}_is_letter(b byte) bool {
	(b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var highest byte = 0;
	var found = false;
	for b in out.s {
		if ${ID}_is_letter(b) {
			if !found || b > highest {
				highest = b;
				found = true;
			}
		}
	}
	g.steps += out.s.len + 1;
	out.i = highest as! int;
	out.s.clear();
	if found {
		format(out.s, "last letter by sort order: ", highest);
	} else {
		format(out.s, "no letters found");
	}
	out
}
@end
