code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while x > 0 {
			total += x % 10;
			x /= 10;
		}
	}
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "merged all digits safely ", total);
	out
}
@end
