@entry 4b585a1bcbca4f32
kind: step
verb: rank
noun: runs
modifier: with_retry
context: stats
phrase: rank maximum identical run length with {retries} retry checks
phrase: compute peak observation run duration over {retries} passes
slot: retries int
test: list=10,10,10,20,30,30 retries=2
expect: => i=3 r=0.0 ok=true s="longest observation run length 3" errors=0 n=6 res=[10,10,10,20,30,30] cache=0 hits=0
test: list=1,2,3,4,5 retries=2
expect: => i=1 r=0.0 ok=false s="longest observation run length 1" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var longest_run = 0;
	var p = 0;
	while p < max_r {
		var current_run = 1;
		var best_run = 1;
		if g.n <= 1 {
			longest_run = g.n;
			break;
		}
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				current_run++;
				if current_run > best_run {
					best_run = current_run;
				}
			} else {
				current_run = 1;
			}
			i++;
		}
		longest_run = best_run;
		p++;
		if longest_run > 1 {
			break;
		}
	}
	out.i = longest_run;
	out.ok = longest_run > 1;
	out.s.clear();
	format(out.s, "longest observation run length ", longest_run);
	g.steps += p * g.n + 1;
	out
}
@end
@entry c249bab9ef0ab2a5
kind: step
verb: sort
noun: digits
modifier: at_least
context: stats
phrase: sort digit observations having at least count {min_digits}
phrase: order numerical digit characters when exceeding threshold {min_digits}
slot: min_digits int
test: list=57,65,50,66,49 min_digits=3
expect: => i=3 r=0.0 ok=true s="sorted digit metrics count 3" errors=0 n=5 res=[49,65,50,66,57] cache=0 hits=0
test: list=57,65,50 min_digits=3
expect: => i=2 r=0.0 ok=false s="" errors=0 n=3 res=[57,65,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_req = ${min_digits};
	var digit_count = 0;
	for i in g.n {
		let c = g.res[i];
		if c >= 48 && c <= 57 {
			digit_count++;
		}
	}
	if digit_count < min_req {
		out.i = digit_count;
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		let ci = g.res[i];
		if ci >= 48 && ci <= 57 {
			var j = i + 1;
			while j < g.n {
				let cj = g.res[j];
				if cj >= 48 && cj <= 57 && g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
		}
		i++;
	}
	out.i = digit_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted digit metrics count ", digit_count);
	g.steps += digit_count * digit_count + 1;
	out
}
@end
