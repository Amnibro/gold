kind: step
verb: drop
noun: threshold
modifier: every_other
context: transform
phrase: drop threshold {threshold} on every other element
phrase: filter threshold {threshold} every other position
slot: threshold int
test: list=10,50,20,80,30 threshold=40
expect: => i=2 r=0.0 ok=true s="dropped every other" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,30,40 threshold=50
expect: => i=0 r=0.0 ok=true s="dropped every other" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if i % 2 == 1 && g.res[i] > thresh {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = dropped;
	out.s.clear();
