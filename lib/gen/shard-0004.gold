@entry 2ac508c21dbcfbab
kind: step
verb: reverse
noun: runs
modifier: between
context: sort
phrase: reverse sorted runs between limits {start} to {stop}
phrase: invert run order between boundaries {start} to {stop}
slot: start int
slot: stop int
test: list=1,2,3,4,5 start=1 stop=3
expect: => i=3 r=0.0 ok=true s="reversed run between bounds" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20,30,40,50 start=2 stop=4
expect: => i=3 r=0.0 ok=true s="reversed run between bounds" errors=0 n=5 res=[10,20,50,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${stop};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	if s < e {
		var i = s;
		var j = e;
		while i < j {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		}
	}
	g.steps += (e - s + 1);
	out.i = e - s + 1;
	out.s.clear();
	format(out.s, "reversed run between bounds");
	out
}
@end
