@entry 8d01158c88077afd
kind: step
verb: clamp
noun: results
modifier: sorted
context: loop
phrase: clamp results sorted by upper ceiling {cap}
phrase: bound sorted loop results under {cap}
slot: cap int
test: list=30,10,50,20 cap=25
expect: => i=2 r=0.0 ok=true s="clamped sorted results count 2" errors=0 n=4 res=[10,20,25,25] cache=0 hits=0
test: list=5,10 cap=0
expect: => i=0 r=0.0 ok=false s="error: invalid cap" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid cap");
		return out;
	}
	for i in g.n {
		var j = 0;
		while j + 1 < g.n - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	var clamped = 0;
	for k in g.n {
		if g.res[k] > c {
			g.res[k] = c;
			clamped++;
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped sorted results count ", clamped);
	out
}
@end
