code:
fn ${ID}_is_sq(n int) bool {
    if n < 0 { return false; }
    var r = 0;
    while r * r < n { r++; }
    r * r == n
}
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let threshold = ${stop};
    var kept = 0;
    for i in g.n {
        if g.res[i] >= threshold { break; }
        if ${ID}_is_sq(g.res[i]) {
            g.res[kept] = g.res[i];
            kept++;
        }
    }
    g.steps += g.n;
    g.n = kept;
    out.i = kept;
    out.s.clear();
    format(out.s, "grouped ", kept, " squares");
    out
}
@end
