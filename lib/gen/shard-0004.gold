phrase: compare item costs until budget {budget} exhausted
slot: budget int
test: list=10,20,30,40 budget=50
expect: => i=2 r=0.0 ok=true s="budget checked within limit" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 budget=15
expect: => i=1 r=0.0 ok=true s="budget checked within limit" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${budget};
	var spent = 0;
	var count = 0;
	while count < g.n && spent + g.res[count] <= limit {
		spent += g.res[count];
		count++;
	}
	out.s.clear();
	if spent <= limit {
		out.i = count;
		out.s.append("budget checked within limit");
	} else {
		out.i = 0;
		out.s.append("budget exceeded");
	}
	g.steps += count + 1;
	out
}
@end
