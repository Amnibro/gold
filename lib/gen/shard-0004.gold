fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_bound = ${peak};
	var kept = 0;
	for k in g.n {
		if g.res[k] > max_bound {
			gold_fail(g, "element exceeded maximum bound");
			break;
		}
		g.res[kept] = g.res[k];
		kept++;
	}
	g.steps += kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	if g.errors > 0 {
		out.s.append("stopped at ceiling violation");
	} else {
		out.s.append("all entries within maximum");
	}
	out
}
@end
