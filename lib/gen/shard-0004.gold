expect: => i=1 r=0.0 ok=true s="min 7 count 1" errors=0 n=3 res=[7,10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty");
		return out;
	}
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var count = 0;
	for i in 0..g.n {
		if g.res[i] == min_val {
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "min ", min_val, " count ", count);
	out
}
@end
