		let b = g.res[k * 2 + 1];
		g.res[k] = a * a + b * b;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	out.s.append("summed squares pairwise");
	out
}
