@entry c3f6ca51c836b341
kind: step
verb: fold
noun: results
modifier: until
context: loop
phrase: fold loop results until condition {stop}
phrase: accumulate iteration results until predicate {stop}
slot: stop pred
test: list=2,4,6,1 stop=is_one
expect: => i=12 r=0.0 ok=true s="folded results until condition 12" errors=0 n=1 res=[12] cache=0 hits=0
test: list=1,2,3 stop=is_one
expect: => i=0 r=0.0 ok=false s="error: stopped at start" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for fold until");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	if ${stop}(g.res[0]) {
		gold_fail(g, "stop condition met at start");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: stopped at start");
		return out;
	}
	var sum = 0;
	var count = 0;
	while count < g.n {
		if ${stop}(g.res[count]) { break; }
		sum += g.res[count];
		count++;
	}
	gold_clear(g);
	gold_push(g, sum);
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded results until condition ", sum);
	out
}
@end
