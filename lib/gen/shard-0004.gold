@entry dd39c16658f938ba
kind: step
verb: map
noun: errors
modifier: recursively
context: stats
phrase: record observation variance deviations recursively
phrase: compute absolute deviations from baseline {baseline}
slot: baseline int
test: list=10,25,30 baseline=20
expect: => i=25 r=0.0 ok=true s="total deviation: 25" errors=0 n=3 res=[10,5,10] cache=0 hits=0
test: list=100,105 baseline=100
expect: => i=5 r=0.0 ok=true s="total deviation: 5" errors=0 n=2 res=[0,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let base = ${baseline};
	var total_dev = 0;
	for i in g.n {
		var dev = g.res[i] - base;
		if dev < 0 { dev = 0 - dev; }
		g.res[i] = dev;
		total_dev += dev;
	}
	g.steps += g.n;
	out.i = total_dev;
	out.ok = true;
	out.s.clear();
	format(out.s, "total deviation: ", total_dev);
	out
}
@end
