fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${lo};
	let end_idx = ${hi};
	let lo_bound = if start < 0 { 0 } else { start };
	let hi_bound = if end_idx > out.s.len { out.s.len } else { end_idx };
	var vowel_count = 0;
	for i in lo_bound..hi_bound {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowel_count++;
		}
	}
	g.steps += hi_bound - lo_bound;
	out.i = vowel_count;
	out.s.clear();
	format(out.s, "vowels in range: ", vowel_count);
	out
}
@end
