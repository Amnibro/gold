fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[64] = [0; 64];
	var dc = 0;
	for i in g.n {
		var cnt = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { cnt++; }
		}
		if cnt > 1 {
			var already = false;
			for k in dc { if dups[k] == g.res[i] { already = true; } }
			if !already && dc < 64 { dups[dc] = g.res[i]; dc++; }
		}
	}
	if dc == 0 && g.n > 0 {
		dups[0] = g.res[0];
		dc = 1;
	}
	gold_clear(g);
	for m in dc { gold_push(g, dups[m]); }
	g.steps += g.n;
	out.i = dc;
	out.s.clear();
	format(out.s, "ranked duplicates with retry count ", dc);
	out
}
@end
