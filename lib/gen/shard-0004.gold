code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for step in t {
		let half = g.n / 2;
		for k in half {
			let tmp = g.res[k];
			g.res[k] = g.res[g.n - 1 - k];
			g.res[g.n - 1 - k] = tmp;
		}
	}
	g.steps += t * g.n;
	out.i = t;
	out.s.clear();
	format(out.s, "reversed runs times: ", t);
	out
}
@end
