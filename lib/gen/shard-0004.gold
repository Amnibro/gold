test: list=5,15,10
expect: => i=1 r=0.0 ok=true s="aggregated split around last" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let pivot = g.res[g.n - 1];
	var lower = 0;
	var higher = 0;
	for i in g.n - 1 {
		if g.res[i] < pivot { lower++; }
		else if g.res[i] > pivot { higher++; }
	}
	g.res[0] = lower;
	g.res[1] = higher;
	g.n = 2;
	g.steps += 1;
	out.i = lower;
	out.s.clear();
	out.s.append("aggregated split around last");
	out
}
@end
