		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bound");
		return out;
	}
	if b < g.n {
		g.n = b;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "limited list to size ", g.n);
	out
}
@end
