fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted_ok = true;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] {
			sorted_ok = false;
			break;
		}
	}
	if !sorted_ok {
		gold_fail(g, "list order verification failed");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: list unsorted");
		return out;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "traced all ", g.n, " items in order");
	out
}
@end
