code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var count = 0;
	for i in g.n {
		if g.res[i] <= c {
			gold_cache_put(g, count, g.res[i]);
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no items within cap");
