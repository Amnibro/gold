fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var changed = true;
		while changed {
			changed = false;
			for j in (g.n - 1) {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
					changed = true;
				}
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted series of length ", g.n);
	out
}
