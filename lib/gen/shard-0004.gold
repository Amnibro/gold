fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = g.n;
	var cached = 0;
	while i > 0 {
		let x = g.res[i - 1];
		if ${stop}(x) { break; }
		gold_cache_put(g, i - 1, x);
		cached++;
		i--;
	}
	g.steps += cached + 1;
	out.i = cached;
	out.s.clear();
	out.s.append("cached suffix until condition");
	out
}
