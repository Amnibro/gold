fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	if l > h {
		gold_fail(g, "low bound exceeds high bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: inverted bounds");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let code = g.res[i];
		if code >= l && code <= h {
			if code == 65 || code == 69 || code == 73 || code == 79 || code == 85 {
				g.res[kept] = code;
				kept++;
			}
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined vowel codes count ", kept);
	out
}
