fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let start = g.n / 2;
	var modified = 0;
	for i in start..g.n {
		if g.res[i] < fl {
			g.res[i] = fl;
			modified++;
		}
	}
	g.steps += g.n - start;
	out.i = modified;
	out.s.clear();
	format(out.s, "normalized ", modified, " tail items");
	out
}
@end
