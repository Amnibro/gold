kind: step
verb: shift
noun: range
modifier: with_retry
context: compare
phrase: shift values within range {low} to {high} forward
phrase: move elements between {low} through {high} to front
slot: low int
slot: high int
test: list=5,20,10,30 low=15 high=25
expect: => i=1 r=0.0 ok=true s="shifted in range: 1" errors=0 n=4 res=[20,5,10,30] cache=0 hits=0
test: list=1,10,5,8 low=4 high=7
expect: => i=1 r=0.0 ok=true s="shifted in range: 1" errors=0 n=4 res=[5,1,10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var in_range int[512] = [0; 512];
	var out_range int[512] = [0; 512];
	var in_cnt = 0;
	var out_cnt = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			in_range[in_cnt] = g.res[i];
			in_cnt += 1;
		} else {
			out_range[out_cnt] = g.res[i];
			out_cnt += 1;
		}
	}
	for i in in_cnt { g.res[i] = in_range[i]; }
	for i in out_cnt { g.res[in_cnt + i] = out_range[i]; }
	g.steps += g.n;
	out.i = in_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted in range: ", in_cnt);
	out
}
@end
