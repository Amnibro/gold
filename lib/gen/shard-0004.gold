fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var unique_gaps int[64] = [0; 64];
	var gc = 0;
	var i = 0;
	while i < g.n - 1 {
		let diff = g.res[i+1] - g.res[i];
		let cached, ok = gold_cache_get(g, diff);
		if !ok {
			gold_cache_put(g, diff, 1);
			if gc < 64 { unique_gaps[gc] = diff; gc++; }
		}
		i++;
	}
	gold_clear(g);
	for k in gc { gold_push(g, unique_gaps[k]); }
	g.steps += g.n;
	out.i = gc;
	out.s.clear();
	format(out.s, "deduped unique gaps count ", gc);
	out
}
@end
@entry c7d15a3687223940
kind: step
verb: rotate
noun: loop
modifier: sorted
context: transform
phrase: rotate sorted sequence elements in loop
phrase: shift sorted sequence by one position
test: list=4,1,3,2
expect: => i=4 r=0.0 ok=true s="rotated sorted sequence head 4" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=9,5
expect: => i=9 r=0.0 ok=true s="rotated sorted sequence head 9" errors=0 n=2 res=[9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n {
		var j = 0;
		while j < g.n - 1 {
			if g.res[j] > g.res[j+1] {
				let t = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = t;
			}
			j++;
		}
	}
	let last_val = g.res[g.n - 1];
	var k = g.n - 1;
	while k > 0 {
		g.res[k] = g.res[k-1];
		k--;
	}
	g.res[0] = last_val;
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "rotated sorted sequence head ", g.res[0]);
	out
}
@end
