kind: step
verb: limit
noun: pairs
modifier: nested
context: transform
phrase: limit pairs nested product to {limit}
phrase: cap nested pairs with bound {limit}
slot: limit int
test: list=4,5,10,20 limit=50
expect: => i=1 r=0.0 ok=true s="limited nested pairs" errors=0 n=4 res=[4,5,25,25] cache=0 hits=0
test: list=2,3,4,5 limit=100
expect: => i=0 r=0.0 ok=true s="limited nested pairs" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let pairs = g.n / 2;
	var capped = 0;
	for k in pairs {
		let idx1 = k * 2;
		let idx2 = idx1 + 1;
		let prod = g.res[idx1] * g.res[idx2];
		if prod > lim {
			g.res[idx1] = lim / 2;
			g.res[idx2] = lim / 2;
			capped++;
		}
	}
	g.steps += pairs;
	out.i = capped;
	out.s.clear();
	out.s.append("limited nested pairs");
	out
}
@end
