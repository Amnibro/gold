	let k = g.n - 1;
	for i in k / 2 {
		let j = k - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "reversed prefix count ", k);
	out
}
@end
