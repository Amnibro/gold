fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${bound};
	let max_i = if lim > g.n { g.n } else { lim };
	var k = 0;
	while k + 1 < max_i {
		let t = g.res[k];
		g.res[k] = g.res[k + 1];
		g.res[k + 1] = t;
		k += 2;
	}
	g.steps += max_i;
	out.i = max_i;
	out.s.clear();
	out.s.append("swapped adjacent values up to limit");
	out
}
