fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var trailing_spaces = 0;
	var i = out.s.len - 1;
	while i >= 0 && out.s[i] == ' ' {
		trailing_spaces++;
		i--;
	}
	gold_cache_put(g, 0, trailing_spaces);
	if trailing_spaces > 1 {
		let remove_cnt = trailing_spaces - 1;
		out.s.resize(out.s.len - remove_cnt, 0);
	}
	g.steps += out.s.len + 1;
	out.i = trailing_spaces;
	out
}
@end
