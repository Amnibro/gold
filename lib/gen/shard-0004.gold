fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let w = ${win};
    if w <= 0 || w > out.s.len {
        gold_fail(g, "invalid window size");
        out.ok = false;
        return out;
    }
    var steps = 0;
    var idx = 0;
    while idx + w <= out.s.len {
        var sum = 0;
        for j in w {
            sum += out.s[idx + j] as int;
        }
        gold_push(g, sum);
        steps++;
        idx++;
    }
    g.steps += steps;
    out.i = steps;
    out.s.clear();
    format(out.s, "applied window to ", steps, " positions");
    out
}
@end
