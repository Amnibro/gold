code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let f = g.res[0];
		for i in 1..g.n { g.res[i - 1] = g.res[i]; }
		g.res[g.n - 1] = f;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "new first checkpoint ", out.i);
	out
}
