fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	if g.n > 0 {
		count = 1;
		for i in 1..g.n {
			if g.res[i] >= g.res[i - 1] {
				count += 1;
			} else {
				break;
			}
		}
	}
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted prefix: ", count);
	out
}
@end
@entry ff91fb56942b23d1
kind: step
verb: check
noun: cache
modifier: at_most
context: stats
phrase: verify cached metric is at most {limit}
phrase: check cache entry does not exceed {limit}
slot: limit int
test: input=5 limit=10
expect: => i=5 r=0.0 ok=true s="cache check: true" errors=0 n=0 res=[] cache=1 hits=1
test: input=25 limit=10
expect: => i=25 r=0.0 ok=false s="cache check: false" errors=0 n=0 res=[] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.cn == 0 {
		gold_cache_put(g, 1, out.i);
	}
	let val, found = gold_cache_get(g, 1);
	let ok = found && val <= lim;
	out.ok = ok;
	out.i = val;
	g.steps += 1;
	out.s.clear();
	format(out.s, "cache check: ", ok);
	out
}
@end
@entry 5ae80f7422d89785
