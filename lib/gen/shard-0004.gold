fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let cached, found = gold_cache_get(g, k);
	if found {
		out.i = cached;
	} else {
		let computed = ${sub}(out.i);
		gold_cache_put(g, k, computed);
		out.i = computed;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "cached subfunction result ", out.i);
	out
}
@end
