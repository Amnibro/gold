code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "results empty for subfunction scale");
		out.ok = false;
		return out;
	}
	let idx = g.n - 1;
	g.res[idx] = ${sub}(g.res[idx]) * ${factor};
	out.i = g.res[idx];
	g.steps += 1;
	out.s.clear();
	format(out.s, "scaled last result to ", out.i);
	out
}
@end
