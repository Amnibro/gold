code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_len};
	var count = 0;
	var w_start = 0;
	while w_start < out.s.len {
		while w_start < out.s.len && out.s[w_start] == ' ' { w_start++; }
		if w_start >= out.s.len { break; }
		var w_end = w_start;
		while w_end < out.s.len && out.s[w_end] != ' ' { w_end++; }
		if w_end - w_start >= lim { count++; }
		w_start = w_end;
	}
	g.steps += 1;
	out.i = count;
	out.s.clear();
	out.s.append("aggregated words of minimum length");
	out
}
@end
@entry 2fab43e0972ed367
kind: step
verb: group
noun: words
modifier: pairwise
context: aggregate
phrase: group words pairwise into length pairs
phrase: aggregate adjacent word lengths pairwise
test: text="one two three four"
expect: => i=2 r=0.0 ok=true s="aggregated pairwise word lengths" errors=0 n=2 res=[6,9] cache=0 hits=0
test: text="hello world"
expect: => i=1 r=0.0 ok=true s="aggregated pairwise word lengths" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lens int[512] = [0; 512];
	var l_cnt = 0;
	var w_start = 0;
	while w_start < out.s.len {
		while w_start < out.s.len && out.s[w_start] == ' ' { w_start++; }
		if w_start >= out.s.len { break; }
		var w_end = w_start;
		while w_end < out.s.len && out.s[w_end] != ' ' { w_end++; }
		lens[l_cnt] = w_end - w_start;
		l_cnt++;
		w_start = w_end;
	}
	let pairs = l_cnt / 2;
	for k in pairs {
		gold_push(g, lens[k * 2] + lens[k * 2 + 1]);
	}
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	out.s.append("aggregated pairwise word lengths");
	out
}
@end
