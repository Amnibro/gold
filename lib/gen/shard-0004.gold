test: list=1,3,2
expect: => i=3 r=0.0 ok=false s="inner sum 3 is odd" errors=1 n=3 res=[1,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient elements");
		return out;
	}
	var sum = 0;
	for k in 1..(g.n - 1) {
		sum += g.res[k];
	}
	out.i = sum;
	if sum % 2 == 0 {
		out.ok = true;
		out.s.clear();
		format(out.s, "inner sum ", sum, " is even");
	} else {
		gold_fail(g, "inner sum is odd");
		out.ok = false;
		out.s.clear();
		format(out.s, "inner sum ", sum, " is odd");
	}
	g.steps += g.n;
	out
}
@end
