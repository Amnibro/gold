@entry 7a5f04f797ad5a18
kind: step
verb: reverse
noun: histogram
modifier: up_to
context: error
phrase: reverse error histogram counts up to limit {cap}
phrase: invert histogram distribution up to bound {cap}
slot: cap int
test: list=1,2,2,3,3,3 cap=2
expect: => i=2 r=0.0 ok=true s="reversed histogram up to 2" errors=0 n=6 res=[2,1,2,3,3,3] cache=0 hits=0
test: list=5,5,10 cap=1
expect: => i=1 r=0.0 ok=true s="reversed histogram up to 1" errors=0 n=3 res=[5,5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var bound = limit;
	if bound > g.n { bound = g.n; }
	if bound > 1 {
		let half = bound / 2;
		for k in half {
			let t = g.res[k];
			g.res[k] = g.res[bound - 1 - k];
			g.res[bound - 1 - k] = t;
		}
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "reversed histogram up to ", bound);
	out
}
@end
