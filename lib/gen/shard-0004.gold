code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = out.i;
	var win_sum = 0;
	var idx = 0;
	while idx + w <= g.n {
		var sub = 0;
		for k in w { sub += g.res[idx + k]; }
		gold_cache_put(g, idx, sub);
		win_sum += sub;
		idx++;
	}
	g.steps += idx;
	out.i = win_sum;
	out.s.clear();
	format(out.s, "win ", win_sum);
	out
}
@end
