code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var adjusted = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > lim {
			g.res[i] = g.res[i - 1] + lim;
			adjusted++;
		}
	}
	g.steps += g.n + 1;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped ", adjusted, " pairwise steps");
	out
}
@end
