fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for i in g.n {
		var first_seen = true;
		for j in i {
			if g.res[j] == g.res[i] { first_seen = false; break; }
		}
		if first_seen { unique_count++; }
	}
	gold_cache_put(g, 100, unique_count);
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "distinct elements memoized ", unique_count);
	out
}
@end
