phrase: filter duplicate values located inside range {low} to {high}
slot: low int
slot: high int
test: list=5,15,15,25,25,50 low=10 high=30
expect: => i=4 r=0.0 ok=true s="budgeted 4" errors=0 n=4 res=[5,15,25,50] cache=0 hits=0
test: list=2,2,2 low=10 high=20
expect: => i=3 r=0.0 ok=true s="budgeted 3" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var w = 0;
	for i in 0..g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			var seen = false;
			for j in 0..w {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[w] = x;
				w++;
			}
		} else {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "budgeted ", w);
	out
}
@end
