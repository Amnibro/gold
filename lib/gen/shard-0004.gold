fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${max_steps};
	if g.steps <= bound {
		out.ok = true;
		out.i = bound - g.steps;
		out.s.clear();
		format(out.s, "under budget");
	} else {
		out.ok = false;
		out.i = g.steps - bound;
		out.s.clear();
		format(out.s, "exceeded budget");
	}
	out
}
