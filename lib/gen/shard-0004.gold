test: list=2,3,4,4
expect: => i=2 r=0.0 ok=true s="found pairwise match at 2" errors=0 n=4 res=[2,3,4,4] cache=0 hits=0
test: list=1,2,3,5
expect: => i=-1 r=0.0 ok=true s="no pairwise match found" errors=0 n=4 res=[1,2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let tail = g.res[g.n - 1];
	var found_idx = -1;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] == tail && g.res[i+1] == tail && found_idx == -1 {
			found_idx = i;
		}
		i++;
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found pairwise match at ", found_idx);
	} else {
		format(out.s, "no pairwise match found");
	}
	out
}
@end
