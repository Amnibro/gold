fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res_s byte[..200] = "";
	var in_space = false;
	for k in out.s.len {
		let b = out.s[k];
		if b == ' ' {
			if !in_space {
				if res_s.len < 200 { res_s.push(b); }
				in_space = true;
			}
		} else {
			if res_s.len < 200 { res_s.push(b); }
			in_space = false;
		}
	}
	out.s.clear();
	for b in res_s { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out.ok = true;
	out
}
@end
