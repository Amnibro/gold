@entry 12dd2bc6e1225646
kind: step
verb: validate
noun: primes
modifier: all
context: stats
phrase: validate whether all sample observations are prime factors
phrase: check that every metric in distribution is a prime number
test: list=2,3,5,7,11
expect: => i=5 r=0.0 ok=true s="all sample values are prime count 5" errors=0 n=5 res=[2,3,5,7,11] cache=0 hits=0
test: list=2,4,5,7
expect: => i=3 r=0.0 ok=false s="non prime values found in distribution" errors=0 n=4 res=[2,4,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var all_primes = true;
	var prime_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
				}
				d++;
			}
		}
		if is_p {
			prime_count++;
		} else {
			all_primes = false;
		}
	}
	out.i = prime_count;
	out.ok = all_primes;
	out.s.clear();
	if all_primes {
		format(out.s, "all sample values are prime count ", prime_count);
	} else {
		format(out.s, "non prime values found in distribution");
	}
	g.steps += g.n;
	out
}
@end
@entry 46b2e3b8d77ed74f
kind: step
verb: clamp
noun: value
modifier: first
context: stats
phrase: clamp first sample observation value between bounds {lo} to {hi}
phrase: restrict initial distribution value from lower {lo} up to {hi}
slot: lo int
slot: hi int
test: list=150,20,30 lo=10 hi=100
expect: => i=100 r=0.0 ok=true s="clamped initial sample value to 100" errors=0 n=3 res=[100,20,30] cache=0 hits=0
test: list=50,20,30 lo=10 hi=100
expect: => i=50 r=0.0 ok=false s="clamped initial sample value to 50" errors=0 n=3 res=[50,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let low = ${lo};
	let high = ${hi};
	let old_v = g.res[0];
	var clamped_v = old_v;
	if clamped_v < low {
		clamped_v = low;
	} else if clamped_v > high {
		clamped_v = high;
	}
	g.res[0] = clamped_v;
	out.i = clamped_v;
	out.ok = clamped_v != old_v;
	out.s.clear();
	format(out.s, "clamped initial sample value to ", clamped_v);
	g.steps += 1;
	out
}
@end
@entry d5b6ba39a98dca00
kind: step
verb: trace
noun: total
modifier: pairwise
context: stats
phrase: trace pairwise totals across adjacent sample variations
phrase: record cumulative pairwise total variation in distribution
test: list=10,25,15,40
expect: => i=50 r=16.666666666666668 ok=true s="pairwise total variation is 50" errors=0 n=4 res=[10,25,15,40] cache=0 hits=0
test: list=2,4,6,8
expect: => i=6 r=2.0 ok=true s="pairwise total variation is 6" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = false;
		return out;
	}
	var total_var = 0;
	for i in g.n - 1 {
		var diff = g.res[i + 1] - g.res[i];
		if diff < 0 {
			diff = -diff;
		}
		total_var += diff;
	}
	out.i = total_var;
	out.r = (total_var as real) / ((g.n - 1) as real);
	out.ok = true;
	out.s.clear();
	format(out.s, "pairwise total variation is ", total_var);
	g.steps += g.n;
	out
}
@end
