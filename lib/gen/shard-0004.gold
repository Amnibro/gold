@entry cc95b2d3fb8f22d8
kind: step
verb: scan
noun: cache
modifier: until
context: compare
phrase: scan cache until matching target {target}
phrase: compare cache items until target {target} found
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="target found in cache scan" errors=0 n=4 res=[10,20,30,40] cache=4 hits=3
test: list=5,15,25 target=99
expect: => i=-1 r=0.0 ok=true s="target not in cache" errors=0 n=3 res=[5,15,25] cache=3 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var found = false;
	var idx = 0;
	while idx < g.cn && !found {
		let val, ok = gold_cache_get(g, idx);
		if ok && val == goal { found = true; }
		else { idx++; }
	}
	out.s.clear();
	if found {
		out.i = idx;
		out.s.append("target found in cache scan");
	} else {
		out.i = -1;
		out.s.append("target not in cache");
	}
	g.steps += idx + 1;
	out
}
@end
@entry 562f3f7f33a59a28
kind: step
verb: pair
noun: primes
modifier: unique
context: compare
phrase: pair primes unique prime values in list
phrase: form unique prime pairs from values
test: list=2,3,4,5,5,7,8
expect: => i=2 r=0.0 ok=true s="paired unique primes" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,13,13,17,19
expect: => i=2 r=0.0 ok=true s="paired unique primes" errors=0 n=4 res=[11,13,17,19] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = [0; 512];
	var pcount = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x > 1;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; }
			d++;
		}
		if is_p {
			var seen = false;
			for j in pcount {
				if primes[j] == x { seen = true; }
			}
			if !seen {
				primes[pcount] = x;
				pcount++;
			}
		}
	}
	let pair_len = (pcount / 2) * 2;
	for i in pair_len { g.res[i] = primes[i]; }
	g.n = pair_len;
	g.steps += pair_len + 1;
	out.i = pair_len / 2;
	out.s.clear();
	out.s.append("paired unique primes");
	out
}
@end
