code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let item = ${fill_val};
    let cap = ${target};
    var added = 0;
    while g.n < cap && g.n < 500 {
        gold_push(g, item);
        added++;
    }
    g.steps += added;
    out.i = added;
    out.s.clear();
    format(out.s, "filled ", added, " items");
    out
}
@end
