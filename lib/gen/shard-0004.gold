		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var k = 0;
	while k < t && g.n < 512 {
		gold_push(g, last_val);
		k++;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "repeated tail ", k, " times");
	out
}
