verb: retry
noun: function
modifier: up_to
context: sort
phrase: retry sort function up to limit {max_passes}
phrase: repeat sorting pass up to bound {max_passes}
slot: max_passes int
test: list=4,3,2,1 max_passes=2
expect: => i=2 r=0.0 ok=true s="retried sort function 2 passes" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
