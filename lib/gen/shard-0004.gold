fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let count = ${sp};
    var res byte[..200] = "";
    var space_idx = 0;
    for c in out.s {
        if c == ' ' {
            if space_idx % 2 == 0 {
                for k in count {
                    if res.len < 195 { res.push(' '); }
