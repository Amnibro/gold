fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_keys = 0;
	for i in g.n {
		let x = g.res[i];
		let prev, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, prev + 1);
			if prev == 1 { dup_keys++; }
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	g.steps += g.n;
	out.i = dup_keys;
	out.s.clear();
	format(out.s, "duplicate keys grouped in cache ", dup_keys);
	out
}
@end
