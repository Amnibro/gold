code:
fn ${ID}_is_sq(n int) bool {
	if n < 0 { return false; }
	var s = 0;
	while s * s <= n {
		if s * s == n { return true; }
		s++;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_val = -1;
	var found_idx = -1;
	for i in g.n {
		if ${ID}_is_sq(g.res[i]) {
			found_val = g.res[i];
			found_idx = i;
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = found_val;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "first square ", found_val, " at position ", found_idx);
	} else {
		format(out.s, "no square found");
	}
	out
}
@end
