code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 || k > g.n {
		gold_fail(g, "invalid drop tally count");
		out.ok = false;
		out.s.clear();
		out.s.append("invalid drop count");
		return out;
	}
	let rem = g.n - k;
	for i in rem {
		g.res[i] = g.res[k + i];
	}
	g.n = rem;
	g.steps += rem;
	out.i = rem;
	out.s.clear();
	out.s.append("dropped first items");
	out
}
@end
