noun: window
modifier: while
context: transform
phrase: group window of size {win} while {keep_going}
phrase: cluster window {win} elements while {keep_going}
slot: win int
slot: keep_going pred
test: list=1,2,3,4,5,6 win=2 keep_going=under_10
expect: => i=2 r=0.0 ok=true s="grouped window while condition" errors=0 n=2 res=[3,7] cache=0 hits=0
