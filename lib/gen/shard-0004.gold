fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 {
        out.i = 0;
        return out;
    }
    var max_idx = 0;
    for i in 1..g.n {
        if g.res[i] > g.res[max_idx] { max_idx = i; }
    }
    let peak = g.res[max_idx];
    for i in max_idx..g.n - 1 {
        g.res[i] = g.res[i + 1];
    }
    g.n = g.n - 1;
    g.steps += g.n;
    out.i = peak;
    out.s.clear();
    format(out.s, "dropped first maximum ", peak);
    out
}
@end
