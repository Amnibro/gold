fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	let pairs = g.n / 2;
	for k in pairs {
		let i = k * 2;
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
	}
	g.steps += pairs;
	out.i = swaps;
	out.s.clear();
	out.s.append("normalized pairs nested");
	out
}
@end
