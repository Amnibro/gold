test: list=30,10,50 cap=25
expect: => i=25 r=0.0 ok=true s="clamped 3 items" errors=0 n=3 res=[10,25,25] cache=0 hits=0
test: list=5,8 cap=25
expect: => i=8 r=0.0 ok=true s="clamped 2 items" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	for k in g.n {
		if g.res[k] > c {
			g.res[k] = c;
		}
	}
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "clamped ", g.n, " items");
	out
}
@end
