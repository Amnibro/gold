fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_gap = ${gap};
	var matches = 0;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			let diff = core_abs_val(g.res[i + 1] - g.res[i]);
			if diff == target_gap {
				matches++;
			}
		}
	}
	out.i = matches;
	out.s.clear();
	format(out.s, "matches ", matches);
	out
}
