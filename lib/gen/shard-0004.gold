code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var target = out.i;
	var val, found = gold_cache_get(g, target);
	if !found {
		for i in g.n {
			if g.res[i] == target {
				gold_cache_put(g, target, i);
				found = true;
				val = i;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = val;
	out.s.clear();
	format(out.s, "memo ", found);
	out
}
@end
