@entry 50296f4e59d6b428
kind: step
verb: compare
noun: tail
modifier: until
context: compare
phrase: compare trailing items until exceeding {limit}
phrase: scan tail backwards until passing {limit}
slot: limit int
test: list=5,30,10,15 limit=20
expect: => i=30 r=0.0 ok=true s="inspected: 3" errors=0 n=4 res=[5,30,10,15] cache=0 hits=0
test: list=50,10,5 limit=25
expect: => i=50 r=0.0 ok=true s="inspected: 3" errors=0 n=3 res=[50,10,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var inspected = 0;
	var found_val = 0;
	var ok = false;
	var i = g.n;
	while i > 0 {
		i -= 1;
		inspected += 1;
		if g.res[i] > lim {
			found_val = g.res[i];
			ok = true;
			break;
		}
	}
	g.steps += inspected;
	out.ok = ok;
	out.i = found_val;
	out.s.clear();
	format(out.s, "inspected: ", inspected);
	out
}
@end
