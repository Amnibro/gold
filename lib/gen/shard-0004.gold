	let min_c = ${min_count};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt = 0;
		for j in g.n {
			if g.res[j] == x { cnt++; }
		}
		if cnt >= min_c {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "retained ", w, " items meeting count");
	out
}
@end
