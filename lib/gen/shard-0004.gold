code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_digits int[64] = [0; 64];
	let count = min(g.n, 64);
	for i in count {
		var x = g.res[i];
		if x < 0 { x = -x; }
		last_digits[i] = x % 10;
	}
	var ranks int[64] = [0; 64];
	for a in count {
		var r = 1;
		for b in count {
			if last_digits[b] < last_digits[a] { r++; }
		}
		ranks[a] = r;
	}
	gold_clear(g);
	for k in count { gold_push(g, ranks[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked by last digit count ", count);
	out
}
@end
