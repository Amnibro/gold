code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var changes = 0;
	for i in 0..g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
			changes++;
		} else if g.res[i] > hi {
			g.res[i] = hi;
			changes++;
		}
	}
	out.i = changes;
	out.s.clear();
	format(out.s, "clamped ", changes);
	out
}
@end
