fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let half = g.n / 2;
	var count = half;
	var i = half;
	while i < g.n {
		g.res[count] = g.res[i];
		count += 1;
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "suffix pruned: ", count);
	out
}
@end
