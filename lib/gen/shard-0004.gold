@entry b5dfb0def70fe01c
kind: step
verb: normalize
noun: middle
modifier: with_retry
context: math
phrase: normalize middle element with retry limit {retries}
phrase: adjust median value within {retries} iterations
slot: retries int
test: list=10,80,20 retries=3
expect: => i=23 r=0.0 ok=true s="normalized middle to 23" errors=0 n=3 res=[10,23,20] cache=0 hits=0
test: list=5,50,15 retries=2
expect: => i=20 r=0.0 ok=true s="normalized middle to 20" errors=0 n=3 res=[5,20,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n < 3 {
        out.i = 0;
        return out;
    }
    let mid = g.n / 2;
    let target = (g.res[0] + g.res[g.n - 1]) / 2;
    let max_iter = ${retries};
    var iter = 0;
    while iter < max_iter {
        if g.res[mid] > target {
            g.res[mid] = (g.res[mid] + target) / 2;
        } else if g.res[mid] < target {
            g.res[mid] = (g.res[mid] + target + 1) / 2;
        } else {
            break;
        }
        iter++;
    }
    g.steps += iter;
    out.i = g.res[mid];
    out.s.clear();
    format(out.s, "normalized middle to ", g.res[mid]);
    out
}
@end
