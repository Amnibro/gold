code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pairs = g.n / 2;
	for i in pairs {
		let a = g.res[i * 2];
		let b = g.res[i * 2 + 1];
		g.res[i] = if a < b { a } else { b };
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise minimums kept ", pairs);
	out
}
@end
