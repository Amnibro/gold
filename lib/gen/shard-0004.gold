fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var k = ml;
	if k > g.n { k = g.n; }
	let start = g.n - k;
	var temp int[512] = [0; 512];
	for i in k { temp[i] = g.res[start + i]; }
	gold_clear(g);
	for i in k { gold_push(g, temp[i]); }
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "selected suffix at most length: ", k);
	out
}
@end
