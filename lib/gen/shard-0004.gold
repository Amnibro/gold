code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_val = ${limit};
	var i = 0;
	while i < g.n && g.res[i] < max_val {
		g.res[i] = g.res[i] * 2;
		i++;
	}
	g.steps += i + 1;
	out.i = i;
	out.s.clear();
	out.s.append("scaled steps while below limit");
	out
}
@end
