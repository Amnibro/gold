code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for gap scaling");
		out.ok = false;
		return out;
	}
	var scaled_count = 0;
	for i in g.n - 1 {
		var gap = g.res[i + 1] - g.res[i];
		if ${cond}(gap) {
			gap *= ${multiplier};
			scaled_count++;
		}
		g.res[i] = gap;
	}
	g.steps += g.n - 1;
	g.n -= 1;
	out.i = scaled_count;
	out.s.clear();
	format(out.s, "scaled gaps count ", scaled_count);
	out
}
@end
