test: list=9,2
expect: => i=1 r=0.0 ok=true s="returned 1 pairwise minimums" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "need pairs for minimum");
		return out;
	}
	let pairs = g.n / 2;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		g.res[k] = min(a, b);
	}
	g.n = pairs;
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "returned ", pairs, " pairwise minimums");
	out
}
@end
