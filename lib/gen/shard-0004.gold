slot: head_size int

test: list=1,2,2,3,4 head_size=4
expect: => i=3 r=0.0 ok=true s="reversed unique head count 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
test: list=5,5,5 head_size=3
expect: => i=1 r=0.0 ok=true s="reversed unique head count 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var limit = ${head_size};
	if limit > g.n { limit = g.n; }
	var kept = 0;
	for i in limit {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	for i in kept / 2 {
		let j = kept - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += limit;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reversed unique head count ", kept);
	out
}
@end
