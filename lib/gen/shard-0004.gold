test: list=1,2,2,3,1
expect: => i=3 r=0.0 ok=true s="deduped reverse errors count 3" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=5
expect: => i=1 r=0.0 ok=true s="deduped reverse errors count 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "deduped reverse errors count ", g.n);
		return out;
	}
	var kept int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		let val = g.res[i];
		var seen = false;
		for j in count {
			if kept[j] == val {
				seen = true;
				break;
			}
		}
		if !seen {
			kept[count] = val;
			count++;
		}
		i--;
	}
	gold_clear(g);
	var k = count - 1;
	while k >= 0 {
		gold_push(g, kept[k]);
		k--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "deduped reverse errors count ", count);
	out
}
@end
