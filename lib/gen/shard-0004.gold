expect: => i=0 r=0.0 ok=true s="empty reverse suffix join" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty reverse suffix join");
		return out;
	}
	let span = min(c, g.n);
	let start = g.n - span;
	out.s.clear();
	var i = g.n - 1;
	var emitted = 0;
	while i >= start {
		if emitted > 0 { out.s.push(';'); }
		format(out.s, g.res[i]);
		emitted++;
		i--;
	}
	g.steps += span + 1;
	out.i = span;
	out
}
@end
