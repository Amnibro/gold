code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var violations = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			let diff = core_abs_val(g.res[k + 1] - g.res[k]);
			if diff > lim { violations++; }
		}
	}
	if violations > 0 { gold_fail(g, "pairwise limit exceeded"); }
	g.steps += g.n;
	out.i = violations;
	out.s.clear();
	format(out.s, "pairwise limit violations: ", violations);
	out
}
@end
