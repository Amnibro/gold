test: list=10,4,20,3
expect: => i=2 r=0.0 ok=true s="mapped pairwise maximum values" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp = [0; 512];
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		temp[kept] = if a > b { a } else { b };
		kept++;
		i += 2;
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("mapped pairwise maximum values");
	out
}
@end
