test: list=8,2,3,1
expect: => i=1 r=0.0 ok=true s="safely rotated sequence 1" errors=0 n=4 res=[2,3,1,8] cache=0 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="safely rotated sequence 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "sequence too small to rotate");
		return out;
	}
	var rotated = false;
	if g.res[0] > g.res[g.n-1] {
		let first = g.res[0];
		for i in g.n - 1 {
			g.res[i] = g.res[i+1];
		}
		g.res[g.n-1] = first;
		rotated = true;
	}
	g.steps += g.n;
	out.i = if rotated { 1 } else { 0 };
	out.s.clear();
	format(out.s, "safely rotated sequence ", out.i);
	out
}
@end
