code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var streak = 1;
	var mapped = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				streak++;
			} else {
				if streak >= out.i {
					gold_cache_put(g, mapped, streak);
					mapped++;
				}
				streak = 1;
			}
		}
	}
	if streak >= out.i {
		gold_cache_put(g, mapped, streak);
		mapped++;
	}
	g.steps += g.n;
	out.i = mapped;
	out.s.clear();
	format(out.s, "streaks within bounds mapped to cache ", mapped);
	out
}
@end
