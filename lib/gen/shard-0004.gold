fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	for i in g.n {
		if g.res[i] < tgt { g.res[i] = -1; }
		else if g.res[i] > tgt { g.res[i] = 1; }
		else { g.res[i] = 0; }
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "compared against: ", tgt);
	out
}
