code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if out.s.len == 0 {
        gold_fail(g, "empty text");
        out.ok = false;
        return out;
    }
    let n = out.s.len;
    let half = n / 2;
    var count = 0;
    for i in n - half {
        let ch = out.s[half + i];
        gold_push(g, ch as int);
        count++;
    }
    g.steps += count;
    out.i = count;
    out.s.clear();
    format(out.s, "grouped ", count, " tail bytes");
    out
}
@end
