fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let ceiling = ${lim};
    if g.n == 0 {
        out.i = 0;
        return out;
    }
    var min_val = g.res[0];
    for i in 1..g.n {
        if g.res[i] < min_val { min_val = g.res[i]; }
    }
    var count = 0;
    for i in g.n {
        if g.res[i] == min_val && g.res[i] < ceiling {
            g.res[i] = ceiling;
            count++;
        }
    }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "shifted ", count, " minimum items to ", ceiling);
    out
}
