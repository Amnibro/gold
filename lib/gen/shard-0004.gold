fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gaps int[512] = [0; 512];
	let gn = if g.n > 1 { g.n - 1 } else { 0 };
	for k in gn {
		gaps[k] = g.res[k + 1] - g.res[k];
	}
	gold_clear(g);
	for k in gn {
		gold_push(g, gaps[gn - 1 - k]);
	}
	g.steps += gn;
	out.i = gn;
	out.s.clear();
	format(out.s, "reversed ", gn, " spaces in reverse");
	out
}
