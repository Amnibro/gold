fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = [false; 256];
	var unique_chars = 0;
	for i in out.s.len {
		let c = out.s[i] as int;
		if c >= 0 && c < 256 && !seen[c] {
			seen[c] = true;
			unique_chars++;
		}
	}
	g.steps += out.s.len;
	out.i = unique_chars;
	out.s.clear();
	format(out.s, "unique query characters ", unique_chars);
	out
}
@end
