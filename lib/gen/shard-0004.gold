noun: total
modifier: every_other
context: sort
phrase: clamp alternating total to {max_total}
phrase: bound every other cumulative total at {max_total}
slot: max_total int
test: list=10,5,20,5,30 max_total=45
expect: => i=45 r=0.0 ok=true s="clamped alternating total to 45" errors=0 n=5 res=[10,5,20,5,15] cache=0 hits=0
test: list=4,1,6,2 max_total=50
expect: => i=10 r=0.0 ok=true s="clamped alternating total to 10" errors=0 n=4 res=[4,1,6,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_total};
	var running = 0;
	var i = 0;
	while i < g.n {
		if running + g.res[i] > ceiling {
			let allowed = max(0, ceiling - running);
			g.res[i] = allowed;
			running = ceiling;
			break;
		} else {
			running += g.res[i];
		}
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "clamped alternating total to ", running);
	out
}
@end
