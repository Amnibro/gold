test: list=5,10,15 input=99
expect: => i=-1 r=0.0 ok=false s="search number primary result -1" errors=0 n=3 res=[5,10,15] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 14, 1);
	let hit_val, hit = gold_cache_get(g, out.i);
	var loc = -1;
	if hit {
		loc = 0;
	} else {
		for i in g.n {
			if g.res[i] == out.i { loc = i; break; }
		}
	}
	g.steps += g.n;
	out.i = loc;
	out.ok = loc >= 0;
	out.s.clear();
	format(out.s, "search number primary result ", loc);
	out
}
@end
