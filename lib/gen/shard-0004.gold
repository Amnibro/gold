test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="compacted 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.s.clear();
		format(out.s, "len ", g.n);
		return out;
	}
	var w = 1;
	for r in 1..g.n {
		if g.res[r] != g.res[w - 1] {
			g.res[w] = g.res[r];
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "compacted ", w);
	out
}
@end
