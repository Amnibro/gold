phrase: compress consecutive runs in all results
test: list=3,3,3,7,7
expect: => i=2 r=0.0 ok=true s="grouped runs all" errors=0 n=4 res=[3,3,7,2] cache=0 hits=0
test: list=9
expect: => i=1 r=0.0 ok=true s="grouped runs all" errors=0 n=2 res=[9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var out_n = 0;
	var cur_val = g.res[0];
	var cur_cnt = 1;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_cnt++;
		} else {
			g.res[out_n] = cur_val;
			g.res[out_n + 1] = cur_cnt;
			out_n += 2;
			cur_val = g.res[i];
			cur_cnt = 1;
		}
	}
	g.res[out_n] = cur_val;
	g.res[out_n + 1] = cur_cnt;
	out_n += 2;
	g.n = out_n;
	g.steps += 1;
	out.i = out_n / 2;
	out.s.clear();
	out.s.append("grouped runs all");
	out
}
@end
