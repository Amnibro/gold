fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean byte[..200] = "";
	var spaces_found = 0;
	for c in out.s {
		if c == ' ' {
			spaces_found++;
		} else {
			clean.push(c);
		}
	}
	if spaces_found == 0 {
		gold_fail(g, "no spaces found to drop");
		out.s.clear();
		out.s.append("no spaces error");
	} else {
		out.s.clear();
		for c in clean { out.s.push(c); }
	}
	g.steps += out.s.len;
	out.i = spaces_found;
	out
}
@end
