expect: => i=10 r=0.0 ok=true s="suffix delta sum: 10" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var sum_delta = 0;
	if count <= g.n && count > 1 {
		let start = g.n - count;
		for i in 1..count {
			let delta = g.res[start + i] - g.res[start + i - 1];
			sum_delta += if delta < 0 { -delta } else { delta };
		}
	}
	g.steps += count;
	out.i = sum_delta;
	out.s.clear();
	format(out.s, "suffix delta sum: ", sum_delta);
	out
}
@end
