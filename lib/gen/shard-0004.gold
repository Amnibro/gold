fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let flr = ${floor};
	for i in g.n {
		var sq = g.res[i] * g.res[i];
		if sq < flr { sq = flr; }
		g.res[i] = sq;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized squares: ", g.n);
	out
}
@end
