fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_pairs = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			let s = g.res[i] + g.res[i - 1];
			if s == 5 || s == 7 || s == 11 || s == 13 || s == 17 { prime_pairs++; }
		}
	}
	g.steps += g.n;
	out.i = prime_pairs;
	out.s.clear();
	format(out.s, "prime sum pairs found ", prime_pairs);
	out
}
@end
