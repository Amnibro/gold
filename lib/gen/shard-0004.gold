fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items to clamp spaces");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	for i in g.n {
		var j = 0;
		while j + 1 < g.n - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	var adjusted = 0;
	var k = 1;
	while k < g.n {
		let space = g.res[k] - g.res[k - 1];
		if space > 10 {
			g.res[k] = g.res[k - 1] + 10;
			adjusted++;
		}
		k++;
	}
	g.steps += g.n + adjusted;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped spaces count ", adjusted);
	out
}
@end
