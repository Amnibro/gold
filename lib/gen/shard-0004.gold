fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var cached = 0;
    for i in g.n {
        for j in i + 1..g.n {
            let p = g.res[i] * g.res[j];
            gold_cache_put(g, cached, p);
            cached++;
        }
    }
    g.steps += cached;
