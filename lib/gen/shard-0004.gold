expect: => i=0 r=0.0 ok=true s="pairwise step found at 0" errors=0 n=4 res=[1,4,7,12] cache=0 hits=0
test: list=10,15,20,30 target=10
expect: => i=2 r=0.0 ok=true s="pairwise step found at 2" errors=0 n=4 res=[10,15,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let goal = ${target};
    var found_idx = -1;
    for i in g.n - 1 {
        let diff = g.res[i + 1] - g.res[i];
        if diff == goal {
            found_idx = i;
            break;
        }
    }
    g.steps += if found_idx >= 0 { found_idx + 1 } else { g.n };
    out.i = found_idx;
    out.ok = (found_idx >= 0);
    out.s.clear();
    format(out.s, "pairwise step found at ", found_idx);
    out
}
@end
