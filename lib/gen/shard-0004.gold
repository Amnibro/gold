test: list=10,5,20,2
expect: => i=2 r=0.0 ok=true s="shifted minimum forward" errors=0 n=4 res=[2,10,5,20] cache=0 hits=0
test: list=1,3,2
expect: => i=1 r=0.0 ok=true s="shifted minimum forward" errors=0 n=3 res=[1,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] {
			min_idx = i;
		}
	}
	let min_val = g.res[min_idx];
	var j = min_idx;
	while j > 0 {
		g.res[j] = g.res[j - 1];
		j--;
	}
	g.res[0] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	out.s.append("shifted minimum forward");
	out
}
@end
