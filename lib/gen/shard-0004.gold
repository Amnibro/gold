test: list=1,2,2,3,1
expect: => i=3 r=0.0 ok=true s="unique history count: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,4
expect: => i=1 r=0.0 ok=true s="unique history count: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique history count: ", kept);
	out
}
@end
