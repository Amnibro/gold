code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let last_val = g.res[g.n - 1];
	let limit = if ${span} > g.n { g.n } else { ${span} };
	var changed = 0;
	for i in limit {
		if g.res[i] < last_val {
			g.res[i] = last_val;
			changed++;
		}
	}
	g.steps += limit + 1;
	out.i = changed;
	out.s.clear();
	out.s.append("mapped prefix comparing with last item");
	out
}
@end
