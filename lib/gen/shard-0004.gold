fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot sort empty list");
		out.ok = false;
		out.s.clear();
		out.s.append("empty list error");
		return out;
	}
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] {
			min_idx = k;
		}
	}
	let tmp = g.res[0];
	g.res[0] = g.res[min_idx];
	g.res[min_idx] = tmp;
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	out.s.append("placed minimum at start");
	out
}
