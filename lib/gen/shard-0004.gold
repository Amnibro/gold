phrase: filter longest increasing streak with retry
test: list=5,1,2,3,0,4
expect: => i=3 r=0.0 ok=true s="filtered longest increasing streak" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,3,2,1
expect: => i=1 r=0.0 ok=true s="filtered longest increasing streak" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] > g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = i;
			cur_len = 1;
		}
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	g.steps += 1;
	out.i = best_len;
	out.s.clear();
	out.s.append("filtered longest increasing streak");
	out
}
@end
