fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	let thresh = min_val + ${delta};
	var count = 0;
	for i in g.n {
		if g.res[i] > thresh { count++; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	out.s.append("aggregated above minimum margin");
	out
}
