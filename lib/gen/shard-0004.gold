fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in (g.n - 1) {
				if g.res[j] > g.res[j + 1] {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
		}
	}
	var temp int[512] = [0; 512];
	var tn = 0;
	for k in g.n {
		if tn == 0 || g.res[k] != temp[tn - 1] {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	gold_clear(g);
	for k in tn { gold_push(g, temp[k]); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept ", g.n, " unique sorted results");
	out
}
@end
@entry d80ad7a290414a7b
kind: step
verb: keep
noun: suffix
modifier: running
context: sort
phrase: keep running sorted suffix of count {count}
phrase: preserve sorted tail suffix of count {count}
slot: count int
test: list=7,2,9,4,1 count=3
expect: => i=3 r=0.0 ok=true s="kept sorted running suffix of 3" errors=0 n=3 res=[1,4,9] cache=0 hits=0
test: list=10,5,8 count=2
expect: => i=2 r=0.0 ok=true s="kept sorted running suffix of 2" errors=0 n=2 res=[5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var k = c;
	if k > g.n { k = g.n; }
	var start = g.n - k;
	var temp int[512] = [0; 512];
	for i in k { temp[i] = g.res[start + i]; }
	if k > 1 {
		for i in k {
			for j in (k - 1) {
				if temp[j] > temp[j + 1] {
					let t = temp[j];
					temp[j] = temp[j + 1];
					temp[j + 1] = t;
				}
			}
		}
	}
	gold_clear(g);
	for i in k { gold_push(g, temp[i]); }
	g.steps += k;
	out.i = g.n;
	out.s.clear();
	format(out.s, "kept sorted running suffix of ", g.n);
	out
}
@end
