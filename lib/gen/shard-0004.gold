expect: => i=2 r=0.0 ok=true s="reversed tail elements" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = if ${span} > g.n { g.n } else { ${span} };
	let start = g.n - sz;
	var l = start;
	var r = g.n - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += sz + 1;
	out.i = sz;
	out.s.clear();
	out.s.append("reversed tail elements");
	out
}
@end
