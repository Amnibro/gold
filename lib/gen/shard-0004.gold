fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_avg};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		let next_sum = sum + g.res[i];
		let avg = next_sum / (kept + 1);
		if avg <= limit {
			sum = next_sum;
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered window by average");
