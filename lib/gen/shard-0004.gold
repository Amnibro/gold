test: list=30,30,5
expect: => i=35 r=0.0 ok=true s="traced unique budget spent 35" errors=0 n=2 res=[30,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int[64] = [0; 64];
	var sc = 0;
	var cur_budget = 40;
	var spent = 0;
	for i in g.n {
		let x = g.res[i];
		var already = false;
		for j in sc { if seen[j] == x { already = true; } }
		if !already {
			if spent + x <= cur_budget {
				spent += x;
				if sc < 64 { seen[sc] = x; sc++; }
			}
		}
	}
	gold_clear(g);
	for k in sc { gold_push(g, seen[k]); }
	g.steps += g.n;
	out.i = spent;
	out.s.clear();
	format(out.s, "traced unique budget spent ", spent);
	out
}
@end
