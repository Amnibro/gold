fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cache_key};
	let val, found = gold_cache_get(g, k);
	if found {
		out.i = val;
	} else {
		gold_cache_put(g, k, out.i);
	}
	g.steps += ${retries};
	out.s.clear();
	format(out.s, "cache kept value ", out.i);
	out
}
@end
