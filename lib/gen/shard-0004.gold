	let limit = ${threshold};
	var running = 0;
	var found_idx = -1;
	for i in g.n {
		running += g.res[i];
		if running > limit && found_idx < 0 {
			found_idx = i;
		}
	}
	out.s.clear();
	if found_idx >= 0 {
		out.i = found_idx;
		out.s.append("running total exceeded threshold");
	} else {
		out.i = -1;
		out.s.append("running total remained within threshold");
	}
	g.steps += g.n + 1;
	out
}
