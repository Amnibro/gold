fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		out.s.clear();
		out.s.append("no items dropped");
		return out;
	}
	if c >= g.n {
		g.n = 0;
	} else {
		let rem = g.n - c;
		for i in rem {
			g.res[i] = g.res[i + c];
		}
		g.n = rem;
	}
	g.steps += 1;
	out.i = c;
	out.s.clear();
	format(out.s, "dropped ", c, " items");
	out
}
@end
