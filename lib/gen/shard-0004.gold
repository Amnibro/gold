		g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
	}
	if g.n % 2 != 0 {
		g.res[pairs] = g.res[g.n - 1];
		pairs++;
	}
	g.steps += g.n;
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired items count ", pairs);
	out
}
@end
