code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_sum = 0;
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if core_is_odd(x) {
			odd_sum += x;
			count++;
		}
		idx--;
	}
	out.i = odd_sum;
	out.s.clear();
	format(out.s, "odd sum ", odd_sum, " count ", count);
	out
}
@end
