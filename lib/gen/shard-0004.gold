fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${limit};
	var idx = -1;
	for i in g.n {
		if g.res[i] >= thresh && idx < 0 {
			idx = i;
		}
	}
	out.s.clear();
	if idx >= 0 {
		out.i = idx;
		out.s.append("element meeting threshold found");
	} else {
		out.i = -1;
		out.s.append("no element reached threshold");
	}
	g.steps += g.n + 1;
	out
}
@end
