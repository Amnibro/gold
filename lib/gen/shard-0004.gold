expect: => i=0 r=0.0 ok=true s="grouped window while condition" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	if w <= 0 || g.n == 0 { return out; }
	var out_n = 0;
	var i = 0;
	while i + w <= g.n {
		var win_sum = 0;
		for j in w {
			win_sum += g.res[i + j];
		}
		if !${keep_going}(win_sum) { break; }
		g.res[out_n] = win_sum;
		out_n++;
		i += w;
	}
	g.n = out_n;
	g.steps += 1;
	out.i = out_n;
	out.s.clear();
	out.s.append("grouped window while condition");
	out
}
@end
