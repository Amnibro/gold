fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found = i;
			break;
		}
	}
	if found > 0 {
		var j = found;
		while j > 0 {
			let tmp = g.res[j];
			g.res[j] = g.res[j - 1];
			g.res[j - 1] = tmp;
			j--;
		}
	}
	g.steps += g.n + 1;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found item ", tgt, " moved to head");
	} else {
		format(out.s, "item ", tgt, " not found");
	}
	out
}
@end
