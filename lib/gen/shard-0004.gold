code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${rem};
	var dropped = 0;
	while g.n > target_len && g.n > 0 {
		g.n--;
		dropped++;
	}
	g.steps += dropped;
	out.i = g.n;
	out.s.clear();
	format(out.s, "dropped down to length: ", g.n);
	out
}
@end
