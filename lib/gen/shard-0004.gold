code:
fn ${ID}_has_match(n int) bool {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return ${pred_check}(0); }
	while x > 0 {
		if ${pred_check}(x % 10) { return true; }
		x /= 10;
	}
	false
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if ${ID}_has_match(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "matched items count ", kept);
	out
}
@end
