@entry 2ac90a225e9ad978
kind: step
verb: rotate
noun: number
modifier: with_retry
context: format
phrase: rotate single number digits with retry {attempts}
phrase: shift number digits circularly with retry {attempts}
slot: attempts int
test: input=123 attempts=2
expect: => i=312 r=0.0 ok=true s="rotated number 312" errors=0 n=0 res=[] cache=0 hits=0
test: input=45 attempts=1
expect: => i=54 r=0.0 ok=true s="rotated number 54" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${attempts};
	var x = out.i;
	if x < 0 { x = -x; }
	if x >= 10 {
		var rev int[20] = [0; 20];
		var len = 0;
		while x > 0 {
			rev[len] = x % 10;
			len++;
			x /= 10;
		}
		let last = rev[0];
		var res = last;
		var i = len - 1;
		while i > 0 {
			res = res * 10 + rev[i];
			i--;
		}
		out.i = res;
	}
	g.steps += max_tries;
	out.s.clear();
	format(out.s, "rotated number ", out.i);
	out
}
@end
