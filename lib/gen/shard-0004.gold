fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_odd = true;
	var k = 0;
	while k < g.n {
		if g.res[k] % 2 == 0 {
			all_odd = false;
			gold_fail(g, "even value at every other position");
			break;
		}
		k += 2;
	}
	g.steps += g.n;
	out.ok = all_odd;
	out.i = if all_odd { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked odds every other: ", all_odd);
	out
}
@end
