@entry 0064e327d75d8470
kind: step
verb: group
noun: head
modifier: between
context: transform
phrase: group head between index {start} to {finish}
phrase: aggregate head between offsets {start} to {finish}
slot: start int
slot: finish int
test: list=1,2,3,4,5 start=1 finish=3
expect: => i=9 r=0.0 ok=true s="grouped head between indices" errors=0 n=3 res=[1,9,5] cache=0 hits=0
test: list=10,20,30 start=0 finish=1
expect: => i=30 r=0.0 ok=true s="grouped head between indices" errors=0 n=2 res=[30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let f = ${finish};
	if s < 0 || f >= g.n || s > f { return out; }
	var sum = 0;
	for i in s..(f + 1) {
		sum += g.res[i];
	}
	g.res[s] = sum;
	let remove_count = f - s;
	for i in (s + 1)..(g.n - remove_count) {
		g.res[i] = g.res[i + remove_count];
	}
	g.n -= remove_count;
	g.steps += 1;
	out.i = sum;
	out.s.clear();
	out.s.append("grouped head between indices");
	out
}
@end
