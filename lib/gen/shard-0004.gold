expect: => i=2 r=0.0 ok=true s="kept alternate squares exceeding floor" errors=0 n=2 res=[16,36] cache=0 hits=0
test: list=1,2,3,4 floor=5
expect: => i=1 r=0.0 ok=true s="kept alternate squares exceeding floor" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_sq = ${floor};
	var kept = 0;
	var temp = [0; 512];
	var i = 0;
	while i < g.n {
		let sq = g.res[i] * g.res[i];
		if sq >= min_sq {
			temp[kept] = sq;
			kept++;
		}
		i += 2;
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("kept alternate squares exceeding floor");
	out
}
@end
