expect: => i=2 r=0.0 ok=true s="applied factor to 2 nested pairs" errors=0 n=2 res=[6,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let factor = ${mult};
    let pairs = g.n / 2;
    for p in pairs {
        let prod = g.res[2 * p] * g.res[2 * p + 1] * factor;
        g.res[p] = prod;
    }
    g.n = pairs;
    g.steps += pairs;
    out.i = pairs;
    out.s.clear();
    format(out.s, "applied factor to ", pairs, " nested pairs");
    out
}
@end
