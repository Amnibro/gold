code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid cap");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "pairwise clamp needs two entries");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > c { g.res[i] = c; count++; }
		if g.res[i + 1] > c { g.res[i + 1] = c; count++; }
		i += 2;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped memo pairwise count ", count);
	out
}
@end
