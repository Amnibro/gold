code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi && ${ID}_is_prime(x) {
			gold_cache_put(g, x, count + 1);
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " primes in range");
	out
}
@end
