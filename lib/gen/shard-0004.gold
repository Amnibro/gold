expect: => i=2 r=0.0 ok=true s="reversed values until target encountered" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	var stop_idx = -1;
	for i in g.n {
		if g.res[i] == goal && stop_idx < 0 {
			stop_idx = i;
		}
	}
	let limit = if stop_idx >= 0 { stop_idx + 1 } else { g.n };
	var l = 0;
	var r = limit - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += limit + 1;
	out.i = limit;
	out.s.clear();
	out.s.append("reversed values until target encountered");
	out
}
@end
