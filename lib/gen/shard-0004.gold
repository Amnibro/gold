slot: max_words int
test: text="one two three four" max_words=2
expect: => i=2 r=0.0 ok=true s="one two" errors=0 n=0 res=[] cache=0 hits=0
test: text="alpha beta" max_words=5
expect: => i=2 r=0.0 ok=true s="alpha beta" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_words};
	var res_s byte[..200] = "";
	var w_start = 0;
	var words_count = 0;
	while w_start < out.s.len && words_count < lim {
		while w_start < out.s.len && out.s[w_start] == ' ' {
			w_start++;
		}
		if w_start >= out.s.len { break; }
		var w_end = w_start;
		while w_end < out.s.len && out.s[w_end] != ' ' {
			w_end++;
		}
		if words_count > 0 { res_s.push(' '); }
		for k in w_start..w_end {
			res_s.push(out.s[k]);
		}
		words_count++;
		w_start = w_end;
	}
	out.s = res_s;
	g.steps += 1;
	out.i = words_count;
	out
}
@end
