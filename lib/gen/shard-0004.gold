noun: steps
modifier: up_to
context: sort
phrase: search sorting steps up to limit threshold
phrase: tally comparison steps up to boundary
test: list=1,4,2,3 input=5
expect: => i=5 r=0.0 ok=true s="executed steps count 5" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20 input=2
expect: => i=2 r=0.0 ok=true s="executed steps count 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var steps_taken = 0;
	for i in g.n {
		for j in g.n - 1 {
			if steps_taken >= out.i { break; }
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = t;
			}
			steps_taken++;
		}
		if steps_taken >= out.i { break; }
	}
	g.steps += steps_taken;
	out.i = steps_taken;
	out.s.clear();
	format(out.s, "executed steps count ", steps_taken);
	out
}
@end
