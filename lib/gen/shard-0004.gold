code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var prev = g.res[0];
	g.res[0] = 0;
	for i in 1..g.n {
		let cur = g.res[i];
		var diff = cur - prev;
		if diff < 0 { diff = 0 - diff; }
		g.res[i] = diff;
		prev = cur;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "gaps calculated: ", g.n);
	out
}
@end
@entry 52c0deb7e987103a
kind: step
verb: dedupe
noun: primes
modifier: until
context: aggregate
phrase: dedupe prime values until count reaches {limit}
phrase: filter unique primes until threshold {limit}
slot: limit int
test: list=2,3,2,5,4,7 limit=3
expect: => i=3 r=0.0 ok=true s="collected 3 primes" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=4,6,8 limit=2
expect: => i=0 r=0.0 ok=true s="collected 0 primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n {
		orig[k] = g.res[k];
	}
	gold_clear(g);
	var count = 0;
	for k in old_n {
		if count >= lim { break; }
		let x = orig[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				var exists = false;
				for j in g.n {
					if g.res[j] == x { exists = true; break; }
				}
				if !exists {
					gold_push(g, x);
					count++;
				}
			}
		}
	}
	out.i = count;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "collected ", count, " primes");
	out
}
@end
