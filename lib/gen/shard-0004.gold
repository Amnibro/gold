test: list=1,2,4,5,6 p=is_even
expect: => i=4 r=0.0 ok=true s="last match index: 4" errors=0 n=5 res=[1,2,4,5,6] cache=0 hits=0
test: list=2,3,5,7,8 p=is_odd
expect: => i=3 r=0.0 ok=true s="last match index: 3" errors=0 n=5 res=[2,3,5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var found_idx = -1;
    var i = g.n - 1;
    while i >= 0 {
        if ${p}(g.res[i]) {
            found_idx = i;
            break;
        }
        i--;
    }
    g.steps += g.n;
    out.i = found_idx;
    out.ok = (found_idx >= 0);
    out.s.clear();
    format(out.s, "last match index: ", found_idx);
    out
}
@end
