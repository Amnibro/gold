test: list=5
expect: => i=5 r=0.0 ok=true s="repeated elements above average 5" errors=0 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for repeat average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept int[64] = [0; 64];
	var kc = 0;
	for j in g.n {
		if kc < 64 { kept[kc] = g.res[j]; kc++; }
		if g.res[j] >= avg && kc < 64 {
			kept[kc] = g.res[j];
			kc++;
		}
	}
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += kc;
	out.i = avg;
	out.s.clear();
	format(out.s, "repeated elements above average ", avg);
	out
}
@end
