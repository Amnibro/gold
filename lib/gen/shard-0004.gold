fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	var kept = 0;
	for i in g.n {
