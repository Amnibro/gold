code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let ceiling = ${cap};
    var clamped = 0;
    var i = g.n - 1;
    while i >= 0 {
        if g.res[i] > ceiling {
            g.res[i] = ceiling;
            clamped++;
        }
        i--;
    }
    g.steps += g.n;
    out.i = clamped;
    out.s.clear();
    format(out.s, "clamped ", clamped, " tallies in reverse");
    out
}
@end
