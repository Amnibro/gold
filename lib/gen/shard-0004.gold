expect: => i=3 r=3.0 ok=true s="aggregated average between range" errors=0 n=3 res=[2,4,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= low && g.res[i] <= high {
			sum += g.res[i];
			count++;
		}
	}
	if count > 0 {
		out.i = sum / count;
		out.r = (sum as real) / (count as real);
	}
	g.steps += g.n;
	out.s.clear();
	out.s.append("aggregated average between range");
	out
}
@end
