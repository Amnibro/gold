noun: duplicates
modifier: safely
context: math
phrase: select duplicate values safely into results
phrase: filter distinct repeated elements safely

test: list=3,5,3,7,5,8
expect: => i=2 r=0.0 ok=true s="selected duplicate count 2" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="no duplicate values found" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dn = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				count++;
			}
		}
		if count > 1 {
			var exists = false;
			for k in dn {
				if dups[k] == g.res[i] {
					exists = true;
				}
			}
			if !exists {
				dups[dn] = g.res[i];
				dn++;
			}
		}
	}
	for i in dn {
		g.res[i] = dups[i];
	}
	g.n = dn;
	out.i = dn;
	g.steps += dn + 1;
	if dn == 0 {
		out.s.clear();
		format(out.s, "no duplicate values found");
	} else {
		out.s.clear();
		format(out.s, "selected duplicate count ", dn);
	}
	out
}
@end
