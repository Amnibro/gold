fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for head last comparison");
		out.ok = false;
		return out;
	}
	let matches = g.res[0] == g.res[g.n - 1];
	g.steps += 1;
	if !matches {
		gold_fail(g, "head does not match last");
		out.ok = false;
	}
	out.i = if matches { 1 } else { 0 };
	out.s.clear();
	format(out.s, "head matches last ", matches);
	out
}
@end
