fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let limit = ${min_streak};
	var kept = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let len = j - i;
		if len >= limit {
			for k in i..j {
				g.res[kept] = g.res[k];
				kept++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "streak items kept ", kept);
	out
}
@end
