fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var valid = true;
	for k in g.n {
		if g.res[k] < mv {
			valid = false;
			gold_fail(g, "element below threshold");
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked numbers at least: ", valid);
	out
}
@end
