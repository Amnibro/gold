fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var halving_steps = 0;
	for i in g.n {
		var x = g.res[i];
		while x > 1 { x /= 2; halving_steps++; }
	}
	g.steps += halving_steps;
	out.i = halving_steps;
	out.s.clear();
	format(out.s, "total halving search steps ", halving_steps);
	out
}
