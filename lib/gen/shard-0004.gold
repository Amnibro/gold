@entry 1d501f821615f331
kind: step
verb: rotate
noun: series
modifier: between
context: cache
phrase: rotate cache series between {from_pos} to {to_pos}
phrase: cycle series elements between {from_pos} through {to_pos} in cache
slot: from_pos int
slot: to_pos int
test: list=1,2,3,4,5 from_pos=1 to_pos=3
expect: => i=3 r=0.0 ok=true s="rotated series of span 3" errors=0 n=5 res=[1,3,4,2,5] cache=3 hits=0
test: list=10,20 from_pos=0 to_pos=0
expect: => i=0 r=0.0 ok=true s="rotate series skipped" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fp = max(0, ${from_pos});
	let tp = min(g.n - 1, ${to_pos});
	if fp >= tp || g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "rotate series skipped");
		return out;
	}
	let first = g.res[fp];
	for i in fp..tp {
		g.res[i] = g.res[i + 1];
	}
	g.res[tp] = first;
	for i in fp..(tp + 1) {
		gold_cache_put(g, i, g.res[i]);
	}
	let span = tp - fp + 1;
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "rotated series of span ", span);
	out
}
@end
