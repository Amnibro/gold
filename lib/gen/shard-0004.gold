fn ${ID}_is_vowel(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
	b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var v_cnt = 0;
	for i in out.s.len {
		let b = out.s[i];
		if ${ID}_is_vowel(b) {
			gold_cache_put(g, v_cnt, b as! int);
			v_cnt++;
			if v_cnt >= lim { break; }
		}
	}
	g.steps += out.s.len + 1;
	out.i = v_cnt;
	out.s.clear();
	format(out.s, "traced ", v_cnt, " vowels into cache");
	out
}
@end
