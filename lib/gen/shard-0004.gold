fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	for i in 1..g.n - 1 {
		for j in i..g.n - 1 {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let mid_len = g.n - 2;
	for i in mid_len / 2 {
		let j = mid_len - 1 - i;
		let tmp = g.res[1 + i];
		g.res[1 + i] = g.res[1 + j];
		g.res[1 + j] = tmp;
	}
	g.steps += g.n * g.n;
	out.i = mid_len;
	out.s.clear();
	format(out.s, "reversed sorted middle count ", mid_len);
	out
}
@end
