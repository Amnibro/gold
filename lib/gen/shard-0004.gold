kind: step
verb: rank
noun: window
modifier: sorted
context: transform
phrase: rank sliding window elements in sorted order
phrase: order window items selecting median value
test: list=5,1,9,3,7
expect: => i=3 r=0.0 ok=true s="ranked window medians count 3" errors=0 n=3 res=[5,3,7] cache=0 hits=0
test: list=4,8,2
expect: => i=1 r=0.0 ok=true s="ranked window medians count 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 { return out; }
	var medians int[64] = [0; 64];
	var mc = 0;
	var i = 0;
	while i <= g.n - 3 {
		var a = g.res[i];
		var b = g.res[i+1];
		var c = g.res[i+2];
		if a > b { let t = a; a = b; b = t; }
		if b > c { let t = b; b = c; c = t; }
		if a > b { let t = a; a = b; b = t; }
		if mc < 64 { medians[mc] = b; mc++; }
		i++;
	}
	gold_clear(g);
