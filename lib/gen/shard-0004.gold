phrase: trim {depth} items from each edge
slot: depth int
test: list=1,2,3,4,5,6 depth=1
expect: => i=4 r=0.0 ok=true s="selected middle region trimming edges" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
