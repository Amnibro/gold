fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	if m <= 0 {
		gold_fail(g, "multiplier must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid multiplier");
		return out;
	}
	var buf int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		var k = 0;
		while k < m && count < 512 {
			buf[count] = g.res[i];
			count++;
			k++;
		}
	}
	gold_clear(g);
	for j in count { gold_push(g, buf[j]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated items each count ", count);
	out
}
@end
