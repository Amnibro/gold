    for c in out.s {
        var found = false;
        for f in ${filter} {
            if c == f { found = true; break; }
        }
        if found {
            removed++;
        } else {
            if buf.len < 195 { buf.push(c); }
        }
    }
    g.steps += out.s.len;
    out.s.clear();
    out.s.append(buf);
    out.i = removed;
    out
}
@end
@entry 5afea7560cce4967
kind: step
verb: normalize
noun: primes
modifier: last
context: core
phrase: normalize last prime element with {f}
phrase: map final prime in list using {f}
slot: f fn
test: list=4,7,9,11,14 f=double
expect: => i=22 r=0.0 ok=true s="normalized prime at 3" errors=0 n=5 res=[4,7,9,22,14] cache=0 hits=0
test: list=6,8,13,15 f=inc
expect: => i=14 r=0.0 ok=true s="normalized prime at 2" errors=0 n=4 res=[6,8,14,15] cache=0 hits=0
code:
fn ${ID}_is_p(n int) bool {
    if n < 2 { return false; }
    var d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d++;
    }
    true
}
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var target = -1;
    for i in g.n {
        let idx = g.n - 1 - i;
        if ${ID}_is_p(g.res[idx]) {
            target = idx;
            break;
        }
    }
    if target >= 0 {
        let orig = g.res[target];
        g.res[target] = ${f}(orig);
        out.i = g.res[target];
        out.s.clear();
        format(out.s, "normalized prime at ", target);
    } else {
        out.i = 0;
        out.s.clear();
        format(out.s, "no prime found");
    }
    g.steps += g.n;
    out
}
@end
