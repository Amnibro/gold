fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var run_cnt = 0;
	var cur_len = 0;
	var cur_val = if g.n > 0 { g.res[0] } else { 0 };
	for i in g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			if cur_len <= ml {
				gold_cache_put(g, cur_val, cur_len);
				run_cnt++;
			}
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	if cur_len <= ml && g.n > 0 {
		gold_cache_put(g, cur_val, cur_len);
		run_cnt++;
	}
	g.steps += g.n + 1;
	out.i = run_cnt;
	out.s.clear();
	format(out.s, "ranked ", run_cnt, " short runs in cache");
	out
}
@end
