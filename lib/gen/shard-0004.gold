code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = min(${size_w}, g.n);
	var is_sorted = true;
	for i in 1..w {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
	}
	if !is_sorted {
		gold_fail(g, "cache window out of order");
		out.ok = false;
		out.s.clear();
		format(out.s, "validation error: window unsorted");
		return out;
	}
	for i in w {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += w + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "cache window sorted ok: ", w);
	out
}
@end
