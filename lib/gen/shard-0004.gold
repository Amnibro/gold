test: list=10,14,19
expect: => i=4 r=0.0 ok=true s="minimum nested gap 4" errors=0 n=4 res=[10,14,19,4] cache=0 hits=0
test: list=2,10
expect: => i=8 r=0.0 ok=true s="minimum nested gap 8" errors=0 n=3 res=[2,10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "not enough items for gap comparison");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: not enough items");
		return out;
	}
	var min_gap = 1000000;
	for i in g.n {
		for j in g.n {
			if i != j {
				var diff = g.res[i] - g.res[j];
				if diff < 0 { diff = -diff; }
				if diff < min_gap { min_gap = diff; }
			}
		}
	}
	gold_push(g, min_gap);
	g.steps += g.n * g.n;
	out.i = min_gap;
	out.s.clear();
	format(out.s, "minimum nested gap ", min_gap);
	out
}
@end
