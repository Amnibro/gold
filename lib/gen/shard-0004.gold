	while i < g.n {
		if i + 1 < g.n && g.res[i] + g.res[i + 1] == 0 {
			i += 2;
		} else {
			g.res[kept] = g.res[i];
			kept++;
			i++;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered non zero adjacent sums");
