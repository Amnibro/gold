noun: squares
modifier: with_cache
context: compare
phrase: fold squares using cached comparisons
phrase: accumulate square values with cache lookup
test: list=2,3,2
expect: => i=17 r=0.0 ok=true s="folded squares with cache total 17" errors=0 n=4 res=[2,3,2,17] cache=2 hits=1
test: list=4,5
expect: => i=41 r=0.0 ok=true s="folded squares with cache total 41" errors=0 n=3 res=[4,5,41] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			total += cached;
		} else {
			let sq = x * x;
			gold_cache_put(g, x, sq);
			total += sq;
		}
	}
	g.steps += g.n;
	gold_push(g, total);
	out.i = total;
	out.s.clear();
	format(out.s, "folded squares with cache total ", total);
	out
}
@end
