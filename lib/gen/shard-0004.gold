code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${stop_char} as byte;
	var cut_len = out.s.len;
	for i in out.s.len {
		if out.s[i] == target {
			cut_len = i;
			break;
		}
	}
	while out.s.len > cut_len {
		out.s.pop();
	}
	g.steps += cut_len;
	out.i = cut_len;
	out
}
@end
