fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var w = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[w - 1] {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n;
	out.i = w;
	out.s.clear();
	format(out.s, "deduped count ", w);
	out
}
@end
