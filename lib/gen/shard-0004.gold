test: list=9,5,4,16,2
expect: => i=3 r=0.0 ok=true s="selected 3 sorted squares" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=25,7,1,36
expect: => i=3 r=0.0 ok=true s="selected 3 sorted squares" errors=0 n=3 res=[1,25,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sqs int[512] = [0; 512];
	var sn = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_square(x) {
			sqs[sn] = x;
			sn++;
		}
	}
	if sn > 1 {
		for i in sn {
			for j in (sn - 1) {
				if sqs[j] > sqs[j + 1] {
					let t = sqs[j];
					sqs[j] = sqs[j + 1];
					sqs[j + 1] = t;
				}
			}
		}
	}
	gold_clear(g);
