code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty prefix join");
		return out;
	}
	let span = min(c, g.n);
	out.s.clear();
	for i in span {
		if i > 0 { out.s.push('|'); }
		format(out.s, g.res[i]);
	}
	g.steps += span + 1;
	out.i = span;
	out
}
@end
