    while idx + 1 < n {
        let diff = (out.s[idx + 1] as int) - (out.s[idx] as int);
        gold_push(g, diff);
        count++;
        idx++;
    }
    g.steps += count;
    out.i = count;
    out.s.clear();
    format(out.s, "applied pairwise to ", count, " tail pairs");
    out
}
