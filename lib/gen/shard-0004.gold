code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var w = 0;
	for idx in g.n {
		let x = g.res[idx];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= lo && freq <= hi {
			g.res[w] = x;
			w++;
		}
	}
	g.n = w;
	g.steps += g.n + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "filtered counter to ", w, " entries");
	out
}
@end
