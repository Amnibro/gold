code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let initial_n = g.n;
	var duped = 0;
	for i in 0..initial_n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			gold_push(g, x);
			duped++;
		}
	}
	out.i = duped;
	out.s.clear();
	format(out.s, "duplicated ", duped);
	out
}
@end
