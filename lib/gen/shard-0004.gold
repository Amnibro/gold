code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for k in g.n {
		let x = g.res[k];
		if x != 0 {
			g.res[kept] = x;
			kept++;
		}
	}
	if kept == 0 {
		gold_fail(g, "no non-zero counters found");
		out.ok = false;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected counter all: ", kept);
	out
}
@end
@entry e736f09ba163add5
kind: step
verb: swap
noun: histogram
modifier: running
context: retry
phrase: swap running histogram bins across retry cycles
phrase: exchange adjacent running histogram bins on retry
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="swapped histogram running: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
test: list=5,15
expect: => i=1 r=0.0 ok=true s="swapped histogram running: 1" errors=0 n=2 res=[15,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			if g.res[k] < g.res[k + 1] {
				let t = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = t;
				swaps++;
			}
			k += 2;
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped histogram running: ", swaps);
	out
}
@end
