slot: floor_val int
test: list=1,8,3,10,2 floor_val=4
expect: => i=2 r=0.0 ok=true s="filtered 2" errors=0 n=2 res=[10,8] cache=0 hits=0
test: list=5,12 floor_val=20
expect: => i=0 r=0.0 ok=true s="filtered 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	var tmp int[512] = [0; 512];
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if g.res[idx] >= fl {
			tmp[count] = g.res[idx];
			count++;
		}
		idx--;
	}
	for i in 0..count {
		g.res[i] = tmp[i];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered ", count);
	out
}
@end
