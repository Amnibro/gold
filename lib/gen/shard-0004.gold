code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	gold_push(g, orig[0]);
	for k in 1..old_n {
		if orig[k] != orig[k - 1] {
			gold_push(g, orig[k]);
		}
	}
	out.i = g.n;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "collapsed to ", g.n, " items");
	out
}
@end
