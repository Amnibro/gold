fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	for i in g.n {
		if g.res[i] == tgt {
			found = true;
			break;
		}
	}
	if !found {
		gold_fail(g, "target item not found in search results");
		out.ok = false;
		out.s.clear();
		format(out.s, "validation failed: missing ", tgt);
		return out;
	}
	g.steps += g.n + 1;
	out.i = tgt;
	out.s.clear();
	format(out.s, "validated presence of ", tgt);
	out
}
