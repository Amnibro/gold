fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor_val};
	let ce = ${ceil_val};
	var adjusted = 0;
	for i in g.n {
		let x = g.res[i];
		var clamped = x;
		if clamped < fl { clamped = fl; adjusted++; }
		else if clamped > ce { clamped = ce; adjusted++; }
		g.res[i] = clamped;
		gold_cache_put(g, i, clamped);
	}
	g.steps += g.n + 1;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped ", adjusted, " cached results in range");
	out
}
