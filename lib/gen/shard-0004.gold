fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n >= 2 {
		for k in 1..g.n {
			let a = g.res[k];
			let b = g.res[k - 1];
			let diff = if a > b { a - b } else { b - a };
			total += diff;
		}
	}
	out.i = total;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "folded pairwise ", total);
	out
}
@end
@entry 14a9d9e7463cc4b0
kind: step
verb: rotate
noun: sequence
modifier: unique
context: format
phrase: rotate unique results sequence forward
phrase: dedupe results circularly shifting sequence
test: list=10,20,10,30
expect: => i=3 r=0.0 ok=true s="rotated unique 3" errors=0 n=3 res=[30,10,20] cache=0 hits=0
test: list=5,5
expect: => i=1 r=0.0 ok=true s="rotated unique 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	for k in old_n {
		let x = orig[k];
		var exists = false;
		for j in g.n {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists { gold_push(g, x); }
	}
	if g.n >= 2 {
		let last = g.res[g.n - 1];
		var idx = g.n - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last;
	}
	out.i = g.n;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated unique ", g.n);
	out
}
@end
