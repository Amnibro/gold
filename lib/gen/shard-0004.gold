fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
		}
		gold_cache_put(g, i, g.res[i]);
		gold_cache_put(g, i + 1, g.res[i + 1]);
		i += 2;
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "sorted history pairwise: ", swaps, " swaps");
	out
}
@end
