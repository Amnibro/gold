@entry 7d3b4f0f356bd350
kind: step
verb: scan
noun: suffix
modifier: sorted
context: stats
phrase: verify suffix of {len} items is sorted
phrase: check trailing sample slice of {len} is sorted
slot: len int
test: list=10,5,20,30 len=3
expect: => i=3 r=0.0 ok=true s="suffix sorted: true" errors=0 n=4 res=[10,5,20,30] cache=0 hits=0
test: list=10,5,30,20 len=3
expect: => i=3 r=0.0 ok=false s="suffix sorted: false" errors=0 n=4 res=[10,5,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let length = ${len};
	var ok = true;
	if length > 1 && g.n >= length {
		let start = g.n - length;
		for i in (start + 1)..g.n {
			if g.res[i] < g.res[i - 1] {
				ok = false;
				break;
			}
		}
	}
	g.steps += length;
	out.ok = ok;
	out.i = length;
	out.s.clear();
	format(out.s, "suffix sorted: ", ok);
	out
}
@end
