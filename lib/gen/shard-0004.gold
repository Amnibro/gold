fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var prod = 1;
	var count = 0;
	for k in g.n {
		prod *= g.res[k];
		count++;
		if prod >= limit {
			break;
		}
	}
	out.i = prod;
	g.steps += count;
	out.s.clear();
	format(out.s, "folded product ", prod);
	out
}
@end
