fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot average empty sequence");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = sum / g.n;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "scanned recursive average: ", avg);
	out
}
