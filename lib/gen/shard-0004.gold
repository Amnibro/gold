	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	g.steps += g.n;
	out.i = g.res[max_idx];
	out.s.clear();
	format(out.s, "maximum nested value found ", g.res[max_idx]);
	out
}
@end
