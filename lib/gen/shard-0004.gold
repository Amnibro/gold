            } else {
                if res.len < 195 { res.push(' '); }
            }
            space_idx++;
        } else {
            if res.len < 195 { res.push(c); }
        }
    }
    g.steps += out.s.len;
    out.s.clear();
    out.s.append(res);
    out.i = res.len;
    out
}
