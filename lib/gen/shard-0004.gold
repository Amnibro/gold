code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = 0;
	var neg = 0;
	for i in g.n {
		if g.res[i] > 0 { pos++; }
		if g.res[i] < 0 { neg++; }
	}
	if neg > pos {
		for j in g.n { g.res[j] = -g.res[j]; }
		pos = 0;
		for k in g.n { if g.res[k] > 0 { pos++; } }
	}
	g.steps += g.n * 2;
	out.i = pos;
	out.s.clear();
	format(out.s, "validated tally with retry positive count ", pos);
	out
}
@end
