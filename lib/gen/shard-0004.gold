@entry 0b129e10184b5888
kind: step
verb: filter
noun: tail
modifier: pairwise
context: stats
phrase: filter tail sample observations with pairwise spread exceeding {min_diff}
phrase: retain distribution tail points having pairwise step above {min_diff}
slot: min_diff int
test: list=10,12,30,32,50 min_diff=10
expect: => i=3 r=0.0 ok=true s="tail pairwise filtered kept 3" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=10,12,14 min_diff=10
expect: => i=1 r=0.0 ok=true s="tail pairwise filtered kept 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${min_diff};
	if g.n <= 1 {
		out.ok = false;
		return out;
	}
	var write_idx = 1;
	var kept = 1;
	var i = 1;
	while i < g.n {
		var diff = g.res[i] - g.res[i - 1];
		if diff < 0 {
			diff = -diff;
		}
		if diff >= threshold {
			g.res[write_idx] = g.res[i];
			write_idx++;
			kept++;
		}
		i++;
	}
	let dropped = g.n - write_idx;
	g.n = write_idx;
	out.i = kept;
	out.ok = dropped > 0;
	out.s.clear();
	format(out.s, "tail pairwise filtered kept ", kept);
	g.steps += i + 1;
	out
}
@end
