fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	if len > 1 {
		for i in (len / 2) {
			let j = len - 1 - i;
			let tmp = out.s[i];
			out.s[i] = out.s[j];
			out.s[j] = tmp;
		}
	}
	g.steps += len;
	out.i = len;
	out.ok = true;
	out
}
