code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	for i in 1..g.n {
		if g.res[i] < g.res[i - 1] {
			is_sorted = false;
			break;
		}
	}
	if !is_sorted {
		gold_fail(g, "sequence is not monotonically increasing");
		out.ok = false;
		out.s.clear();
		format(out.s, "validation failed: sequence unsorted");
		return out;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sequence safely validated: ", g.n, " items");
	out
}
@end
