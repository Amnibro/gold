code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	var dropped = 0;
	var idx = 0;
	while idx < g.cn {
		if g.cv[idx] < out.i {
			g.cv[idx] = 0;
			dropped++;
		}
		idx++;
	}
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "entries cleared under loop condition ", dropped);
	out
}
@end
