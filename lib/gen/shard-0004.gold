phrase: remove alternating duplicates from sorted checkpoints
test: list=2,2,4,4,6,6
expect: => i=0 r=0.0 ok=true s="deduped 0 checkpoints" errors=0 n=6 res=[2,2,4,4,6,6] cache=0 hits=0
test: list=1,2,3,4,5,6
expect: => i=0 r=0.0 ok=true s="deduped 0 checkpoints" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	var removed = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var exists = false;
		for j in w {
			if g.res[j] == x { exists = true; break; }
		}
		if exists {
			removed++;
		} else {
			g.res[w] = x;
			w++;
		}
		if i + 1 < g.n {
			g.res[w] = g.res[i + 1];
			w++;
		}
		i += 2;
	}
	g.n = w;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " checkpoints");
	out
}
@end
@entry a4817c334367dcd2
