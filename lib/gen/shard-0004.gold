@entry e36249851e4619ef
kind: step
verb: reverse
noun: budget
modifier: running
context: aggregate
phrase: reverse running budget starting at {start}
phrase: invert running budget balance from {start}
slot: start int

test: list=10,20,5 start=100
expect: => i=65 r=0.0 ok=true s="remaining budget 65" errors=0 n=3 res=[65,70,90] cache=0 hits=0
test: list=4,8 start=50
expect: => i=38 r=0.0 ok=true s="remaining budget 38" errors=0 n=2 res=[38,46] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var bal = ${start};
	for i in g.n {
		bal -= g.res[i];
		g.res[i] = bal;
	}
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += g.n * 2;
	out.i = bal;
	out.s.clear();
	format(out.s, "remaining budget ", bal);
	out
}
@end
