code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "series too short to swap");
		out.ok = false;
		return out;
	}
	let t = g.res[0];
	g.res[0] = g.res[g.n - 1];
	g.res[g.n - 1] = t;
	out.i = g.res[0];
	g.steps += 1;
	out.s.clear();
	format(out.s, "swapped series bounds ", out.i);
	out
}
@end
