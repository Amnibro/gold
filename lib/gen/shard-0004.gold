code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = core_abs_val(out.i);
	var d int[16] = [0; 16];
	var len = 0;
	while n > 0 {
		d[len] = n % 10;
		len++;
		n /= 10;
	}
	var min_d = 9;
	for i in len {
		if d[i] < min_d { min_d = d[i]; }
	}
	var res = 0;
	var k = len;
	while k > 0 {
		k--;
		res = res * 10 + (d[k] - min_d);
	}
	g.steps += len;
	out.i = res;
	out.s.clear();
	format(out.s, "normalized number: ", res);
	out
}
@end
