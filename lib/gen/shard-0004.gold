fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_len};
	let hi = ${max_len};
	let ws = words(out.s);
	var count = 0;
	gold_clear(g);
	for w in ws {
		if w.len >= lo && w.len <= hi {
			gold_push(g, w.len);
			count++;
		}
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " words in range");
	out
}
@end
