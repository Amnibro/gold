    let cap = ${max_run};
    if cap <= 0 {
        gold_fail(g, "non-positive run limit");
        out.ok = false;
        return out;
    }
    var res byte[..200] = "";
    var current_run = 0;
    var prev byte = 0;
    for i in out.s.len {
        let ch = out.s[i];
        if i == 0 || ch == prev {
            current_run++;
        } else {
            current_run = 1;
        }
        prev = ch;
        if current_run <= cap && res.len < 200 {
            res.push(ch);
        }
    }
    g.steps += out.s.len;
    out.i = res.len;
    out.s.clear();
    for b in res { out.s.push(b); }
    out
}
@end
