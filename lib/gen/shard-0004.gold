fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in u {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists {
			g.res[u] = x;
			u++;
		}
	}
	for i in u {
		for j in (i + 1)..u {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = u;
	g.steps += u * 2 + 1;
	out.i = u;
	out.s.clear();
	format(out.s, "sorted ", u, " unique items");
	out
}
@end
