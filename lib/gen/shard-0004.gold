test: list=19,34,82
expect: => i=21 r=0.0 ok=true s="merged maximum digits for each item" errors=0 n=3 res=[9,4,8] cache=0 hits=0
test: list=41,56,92
expect: => i=19 r=0.0 ok=true s="merged maximum digits for each item" errors=0 n=3 res=[4,6,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum_max = 0;
	for i in g.n {
		var n = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		var max_d = 0;
		while n > 0 {
			let d = n % 10;
			if d > max_d { max_d = d; }
			n /= 10;
		}
		g.res[i] = max_d;
		sum_max += max_d;
	}
	g.steps += g.n * 3 + 1;
	out.i = sum_max;
	out.s.clear();
	out.s.append("merged maximum digits for each item");
	out
}
@end
