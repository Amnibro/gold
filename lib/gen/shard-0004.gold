expect: => i=4 r=0.0 ok=true s="deduped to 4 unique" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="deduped to 1 unique" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	for k in old_n {
		let x = orig[k];
		var exists = false;
		for j in g.n {
			if g.res[j] == x {
				exists = true;
				break;
			}
		}
		if !exists {
			gold_push(g, x);
		}
	}
	out.i = g.n;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "deduped to ", g.n, " unique");
	out
}
@end
