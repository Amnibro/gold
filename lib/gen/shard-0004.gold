fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var sum = 0;
	for i in g.n {
		g.res[i] = g.res[i] * f;
		sum += g.res[i];
	}
	g.steps += g.n;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "series sum: ", sum);
	out
}
@end
@entry f55ef7b515ba98d4
kind: step
verb: reverse
noun: pairs
modifier: unique
context: stats
phrase: invert consecutive unique observation pairs
phrase: swap adjacent unique statistics pairs
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="swapped pairs: 2" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
test: list=5,5,10,20
expect: => i=1 r=0.0 ok=true s="swapped pairs: 1" errors=0 n=4 res=[5,5,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] != g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps += 1;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.ok = true;
	out.s.clear();
	format(out.s, "swapped pairs: ", swaps);
	out
}
@end
@entry c937073e33acc91f
kind: step
verb: keep
noun: subfunction
modifier: running
context: stats
phrase: keep observations exceeding running mean
phrase: filter data points beating current average
test: list=2,6,4,10
expect: => i=2 r=0.0 ok=true s="kept: 2" errors=0 n=2 res=[6,10] cache=0 hits=0
test: list=5,5,20
expect: => i=1 r=0.0 ok=true s="kept: 1" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	var count = 0;
	for i in g.n {
		if g.res[i] > mean {
			g.res[count] = g.res[i];
			count += 1;
		}
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "kept: ", count);
	out
}
@end
@entry edad377f484377d1
kind: step
verb: check
noun: threshold
modifier: last
context: stats
phrase: check if final observation exceeds cutoff {cutoff}
phrase: verify trailing point meets threshold {cutoff}
slot: cutoff int
test: list=10,20,35 cutoff=30
expect: => i=35 r=0.0 ok=true s="threshold passed: 35" errors=0 n=3 res=[10,20,35] cache=0 hits=0
test: list=5,10,15 cutoff=20
expect: => i=15 r=0.0 ok=false s="threshold failed: 15" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	let passed = last >= cut;
	g.steps += 1;
	out.ok = passed;
	out.i = last;
	out.s.clear();
	if passed {
		format(out.s, "threshold passed: ", last);
	} else {
		format(out.s, "threshold failed: ", last);
	}
	out
}
@end
