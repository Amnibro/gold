code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j]; g.res[j] = g.res[j + 1]; g.res[j + 1] = t;
			}
		}
	}
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] <= out.i {
			total += g.res[i];
			count++;
		} else { break; }
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "budget accommodated items ", count);
	out
}
@end
