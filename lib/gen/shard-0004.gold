context: search
phrase: dedupe search range between {low} to {high}
phrase: remove duplicate items spanning {low} through {high} in range
slot: low int
slot: high int
test: list=2,5,5,9,5,12 low=4 high=10
expect: => i=2 r=0.0 ok=true s="deduped 2 items in range" errors=0 n=4 res=[2,5,9,12] cache=0 hits=0
test: list=1,2,3,4,5 low=10 high=20
expect: => i=0 r=0.0 ok=true s="deduped 0 items in range" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var w = 0;
	var removed = 0;
	for r in g.n {
		let item = g.res[r];
		if item >= lo && item <= hi {
			var exists = false;
			for j in w {
				if g.res[j] == item { exists = true; break; }
			}
			if exists {
				removed++;
				continue;
			}
		}
		g.res[w] = item;
		w++;
	}
	g.n = w;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " items in range");
	out
}
@end
