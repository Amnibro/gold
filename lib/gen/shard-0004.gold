code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_v = g.res[0];
	for i in 1..g.n { if g.res[i] < min_v { min_v = g.res[i]; } }
	for i in g.n { g.res[i] -= min_v; }
	g.steps += g.n;
	out.i = min_v;
	out.s.clear();
	format(out.s, "normalized min subtracted ", min_v);
	out
}
@end
