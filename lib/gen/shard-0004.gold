fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = -1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] == tgt {
			found = i;
			break;
		}
		i--;
	}
	g.steps += g.n + 1;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found target in reverse at index ", found);
	} else {
		format(out.s, "target not found in reverse");
	}
	out
}
@end
