			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = 0 - diff; }
			total_diff += diff;
		}
	}
	g.steps += g.n;
	out.i = total_diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "pair diff sum: ", total_diff);
	out
}
