fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let factor = g.res[0];
	let lim = ${k};
	var sum = 0;
	for i in g.n {
		if i < lim { sum += g.res[i] * factor; }
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	out.s.append("aggregated scaled prefix");
	out
}
@end
