		out.i = 0;
		out.s.clear();
		format(out.s, "rotate loop skipped");
		return out;
	}
	let rot = k % g.n;
	for r in rot {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += rot * g.n + 1;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated sorted loop by ", rot);
	out
}
@end
