expect: => i=2 r=0.0 ok=true s="traced gaps in place, max 2" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient elements for gaps");
		return out;
	}
	var max_gap = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		if diff > max_gap { max_gap = diff; }
		g.res[i] = diff;
	}
	g.n--;
	g.steps += g.n + 1;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "traced gaps in place, max ", max_gap);
	out
}
@end
