fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var running = 0;
	for i in g.n {
		if running + g.res[i] <= out.i {
			running += g.res[i];
			count++;
		} else { break; }
	}
	gold_cache_put(g, out.i, count);
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "budget items counted ", count);
	out
}
@end
