	let tgt = ${target};
	var found = false;
	for i in g.n {
		if g.res[i] == tgt { found = true; break; }
	}
	g.steps += g.n + ${max_retries};
	if !found {
		gold_fail(g, "target not found in history");
		out.ok = false;
	}
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "history target found ", found);
	out
}
@end
