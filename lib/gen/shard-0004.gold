			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { gold_push(g, x); }
		}
	}
	out.i = g.n;
	g.steps += max_tries;
	out.s.clear();
	format(out.s, "found ", g.n, " primes");
	out
}
@end
