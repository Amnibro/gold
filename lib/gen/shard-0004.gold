code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = max(0, ${count});
	let span = min(c, g.n);
	let start = g.n - span;
	for i in span {
		g.res[i] = g.res[start + i];
	}
	g.n = span;
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "returned tail in place size ", span);
	out
}
@end
