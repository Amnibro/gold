test: list=2,4,1,3
expect: => i=2 r=0.0 ok=true s="grouped sequence in place" errors=0 n=4 res=[2,4,1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var e_cnt = 0;
	var o_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			evens[e_cnt] = x;
			e_cnt++;
		} else {
			odds[o_cnt] = x;
			o_cnt++;
		}
	}
	for i in e_cnt { g.res[i] = evens[i]; }
	for i in o_cnt { g.res[e_cnt + i] = odds[i]; }
	g.steps += g.n;
	out.i = e_cnt;
	out.s.clear();
	out.s.append("grouped sequence in place");
	out
}
@end
