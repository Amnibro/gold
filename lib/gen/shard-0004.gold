fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_dist = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = 0 - diff; }
			total_dist += diff;
		}
	}
	g.steps += g.n;
	out.i = total_dist;
	out.ok = true;
	out.s.clear();
	format(out.s, "total distance: ", total_dist);
	out
}
