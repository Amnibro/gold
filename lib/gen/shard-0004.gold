fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${cap};
    var sum = 0;
    for i in g.n { sum += g.res[i]; }
    if sum > limit {
        for i in g.n {
            g.res[i] = g.res[i] / 2;
        }
        out.ok = true;
    } else {
        out.ok = false;
    }
    g.steps += g.n;
    out.i = sum;
    out.s.clear();
    format(out.s, "original total was ", sum);
    out
}
