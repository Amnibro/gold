		for i in g.n {
			if g.res[i] < cur_min { cur_min = g.res[i]; }
			gold_cache_put(g, i, cur_min);
		}
		out.i = cur_min;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "final running minimum cached ", out.i);
	out
}
@end
