test: list=10,12,14
expect: => i=0 r=0.0 ok=true s="sorted 0 primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			g.res[w] = x;
			w++;
		}
	}
	for i in w {
		for j in (i + 1)..w {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = w;
	g.steps += w * 2 + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "sorted ", w, " primes");
	out
}
@end
