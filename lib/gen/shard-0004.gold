code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var pos = 0;
	while pos + 1 < g.n && g.res[pos] > g.res[pos + 1] {
		let tmp = g.res[pos];
		g.res[pos] = g.res[pos + 1];
		g.res[pos + 1] = tmp;
		pos++;
	}
	g.steps += pos + 1;
	out.i = pos;
	out.s.clear();
	format(out.s, "shifted head by ", pos, " slots");
	out
}
@end
