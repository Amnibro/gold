phrase: sort odd values until index limit {limit}
phrase: order odd elements in cache up to {limit}
slot: limit int
test: list=9,2,7,4,5,6 limit=4
expect: => i=2 r=0.0 ok=true s="sorted 2 odds until limit" errors=0 n=6 res=[9,2,7,4,5,6] cache=2 hits=0
test: list=3,1 limit=1
expect: => i=1 r=0.0 ok=true s="sorted 1 odds until limit" errors=0 n=2 res=[3,1] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = min(${limit}, g.n);
	var odds int[512] = [0; 512];
	var o_cnt = 0;
	for i in lim {
		let x = g.res[i];
		if x % 2 != 0 {
			odds[o_cnt] = x;
			o_cnt++;
		}
	}
	for i in o_cnt {
		for j in (i + 1)..o_cnt {
			if odds[j] < odds[i] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
		}
	}
	for i in o_cnt {
		gold_cache_put(g, i, odds[i]);
	}
	g.steps += lim + o_cnt + 1;
	out.i = o_cnt;
	out.s.clear();
	format(out.s, "sorted ", o_cnt, " odds until limit");
	out
}
@end
