fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			let t = g.res[k];
			g.res[k] = g.res[k + 1];
			g.res[k + 1] = t;
			count++;
			k += 2;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "swapped history each count: ", count);
	out
}
@end
