fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	var all_match = true;
	for i in pairs {
		if !${cond}(g.res[2 * i]) || !${cond}(g.res[2 * i + 1]) {
			all_match = false;
		}
	}
	g.steps += pairs;
	if !all_match {
		gold_fail(g, "pairwise step condition failed");
		out.ok = false;
	}
	out.i = pairs;
	out.s.clear();
	format(out.s, "pairwise checked count ", pairs);
	out
}
@end
