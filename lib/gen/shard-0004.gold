@entry 56b1d63fa6c760a4
kind: step
verb: sum
noun: number
modifier: recursively
context: filter
phrase: sum number recursively matching target {target}
phrase: filter items with recursive digit sum {target}
slot: target int
test: list=12,25,30,102 target=3
expect: => i=3 r=0.0 ok=true s="filtered by digit sum" errors=0 n=3 res=[12,30,102] cache=0 hits=0
test: list=45,90 target=8
expect: => i=0 r=0.0 ok=true s="filtered by digit sum" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_dsum(x) == tgt {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered by digit sum");
	out
}

fn ${ID}_dsum(n int) int {
	var x = if n < 0 { -n } else { n };
	var s = 0;
	while x > 0 {
		s += x % 10;
		x /= 10;
	}
	s
}
@end
