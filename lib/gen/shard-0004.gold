test: list=10,20,30,40
expect: => i=20 r=0.0 ok=true s="half average difference is 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5
expect: => i=0 r=0.0 ok=false s="error: too few items" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	let half = g.n / 2;
	var sum1 = 0;
	for i in half { sum1 += g.res[i]; }
	var sum2 = 0;
	for i in half..g.n { sum2 += g.res[i]; }
	let diff = (sum2 / (g.n - half)) - (sum1 / half);
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "half average difference is ", diff);
	out
}
@end
