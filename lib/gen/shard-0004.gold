fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let multiplier = ${k};
    let offset, ok = gold_cache_get(g, 0);
    let shift = if ok { offset } else { 1 };
    for i in g.n {
        g.res[i] = g.res[i] * multiplier + shift;
    }
    gold_cache_put(g, 0, shift + 1);
    g.steps += g.n;
    out.i = g.n;
    out.s.clear();
    format(out.s, "applied multiplier ", multiplier, " with offset ", shift);
    out
}
@end
