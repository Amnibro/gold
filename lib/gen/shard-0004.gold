code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	var added = 0;
	for i in orig_n {
		let x = g.res[i];
		if ${ID}_is_prime(x) && g.n < 512 {
			gold_push(g, x);
			added++;
		}
	}
	g.steps += g.n + 1;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated ", added, " primes safely");
	out
}
@end
@entry c3e809a22c3681bb
kind: step
verb: search
noun: average
modifier: sorted
context: sort
phrase: search average value in sorted items
phrase: locate item closest to sorted average
test: list=10,20,30,40
expect: => i=20 r=25.0 ok=true s="closest to average 25 is 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,3,9
expect: => i=3 r=4.666666666666667 ok=true s="closest to average 4 is 3" errors=0 n=3 res=[2,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty results for average");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var best_diff = 999999;
	var best_val = g.res[0];
	for i in g.n {
		let diff = abs(g.res[i] - avg);
		if diff < best_diff {
			best_diff = diff;
			best_val = g.res[i];
		}
	}
	g.steps += g.n + 1;
	out.i = best_val;
	out.r = (sum as real) / (g.n as real);
	out.s.clear();
	format(out.s, "closest to average ", avg, " is ", best_val);
	out
}
@end
