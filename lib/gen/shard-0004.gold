test: list=7
expect: => i=7 r=0.0 ok=true s="merged maximum in place: 7" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for max merge");
		out.ok = false;
		return out;
	}
	var max_v = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_v { max_v = g.res[k]; }
	}
	gold_clear(g);
	gold_push(g, max_v);
	g.steps += g.n;
	out.i = max_v;
	out.s.clear();
	format(out.s, "merged maximum in place: ", max_v);
	out
}
@end
