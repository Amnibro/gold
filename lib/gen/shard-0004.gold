expect: => i=2 r=0.0 ok=true s="grouped 1 pairs" errors=0 n=2 res=[15,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let floor_val = ${thresh};
    let pairs_count = g.n / 2;
    var kept = 0;
    for p in pairs_count {
        let a = g.res[2 * p];
        let b = g.res[2 * p + 1];
        let m = if a > b { a } else { b };
        if m >= floor_val {
            g.res[kept] = a;
            g.res[kept + 1] = b;
            kept += 2;
        }
    }
    g.steps += g.n;
    g.n = kept;
    out.i = kept;
    out.s.clear();
    format(out.s, "grouped ", kept / 2, " pairs");
    out
}
@end
