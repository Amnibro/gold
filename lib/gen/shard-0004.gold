code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_digits};
	var d_cnt = 0;
	for b in out.s {
		if b >= '0' && b <= '9' { d_cnt++; }
	}
	if d_cnt < req {
		gold_fail(g, "insufficient digits in text");
		out.ok = false;
		out.s.clear();
		format(out.s, "validation failed: digits below required");
		return out;
	}
	g.steps += out.s.len + 1;
	out.i = d_cnt;
	out.s.clear();
	format(out.s, "digits validated: ", d_cnt);
	out
}
@end
