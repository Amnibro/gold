code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 || d > g.n {
		gold_fail(g, "depth out of range for tally rank");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid depth");
		return out;
	}
	let start = g.n - d;
	var ranks int[64] = [0; 64];
	let count = min(d, 64);
	for i in count {
		let val = g.res[start + i];
		var freq = 0;
		for j in count {
			if g.res[start + j] == val { freq++; }
		}
		ranks[i] = freq;
	}
	gold_clear(g);
	for k in count { gold_push(g, ranks[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked trailing tally count ", count);
	out
}
@end
@entry 6388a26e0fcf24de
kind: step
verb: clamp
noun: digits
modifier: with_cache
context: loop
phrase: clamp digits with cache lookups for bounds
phrase: bound digit totals with cached ceiling
test: list=189,456,23
expect: => i=3 r=0.0 ok=true s="clamped digits with cache count 3" errors=0 n=3 res=[155,455,23] cache=3 hits=0
test: list=5
expect: => i=0 r=0.0 ok=true s="clamped digits with cache count 0" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for clamp digits");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var total_clamped = 0;
	for i in g.n {
		let orig = g.res[i];
		let cached, ok = gold_cache_get(g, orig);
		if ok {
			g.res[i] = cached;
			total_clamped++;
		} else {
			var n = orig;
			var sign = 1;
			if n < 0 { sign = -1; n = -n; }
			var mult = 1;
			var res = 0;
			while n > 0 {
				var d = n % 10;
				if d > 5 { d = 5; total_clamped++; }
				res += d * mult;
				mult *= 10;
				n /= 10;
			}
			let clamped_val = res * sign;
			gold_cache_put(g, orig, clamped_val);
			g.res[i] = clamped_val;
		}
	}
	g.steps += g.n;
	out.i = total_clamped;
	out.s.clear();
	format(out.s, "clamped digits with cache count ", total_clamped);
	out
}
@end
