code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wt = ${step_weight};
	var score = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		score += g.res[idx] * (g.n - idx) * wt;
		idx--;
	}
	out.i = score;
	out.s.clear();
	format(out.s, "score ", score);
	out
}
@end
