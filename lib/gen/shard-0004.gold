code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var rotations = 0;
	while g.res[0] % 2 != 0 && rotations < g.n {
		let first = g.res[0];
		for i in g.n - 1 { g.res[i] = g.res[i+1]; }
		g.res[g.n - 1] = first;
		rotations++;
	}
	g.steps += rotations;
	out.i = rotations;
	out.s.clear();
	format(out.s, "rotated series until even head steps ", rotations);
	out
}
@end
@entry f186f8919634ff20
kind: step
