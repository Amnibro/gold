fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if ${cond}(x) {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	out.s.append("collected matching condition sorted");
	out
}
