@entry e27d750441487c07
kind: step
verb: filter
noun: squares
modifier: pairwise
context: format
phrase: filter pairwise adjacent square differences
phrase: retain pairs with square difference in results
test: list=10,14,23
expect: => i=2 r=0.0 ok=true s="square diffs 2" errors=0 n=2 res=[4,9] cache=0 hits=0
test: list=1,3,6
expect: => i=0 r=0.0 ok=true s="square diffs 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	if old_n >= 2 {
		for k in 1..old_n {
			let a = orig[k - 1];
			let b = orig[k];
			let diff = if a > b { a - b } else { b - a };
			var root = 0;
			while root * root < diff { root++; }
			if root * root == diff {
				gold_push(g, diff);
			}
		}
	}
	out.i = g.n;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "square diffs ", g.n);
	out
}
@end
