code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var diff_sum = 0;
	var count = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n && count < max_att {
			let diff = g.res[i + 1] - g.res[i];
			diff_sum += if diff < 0 { -diff } else { diff };
			count++;
			i++;
		}
	}
	g.steps += count + 1;
	out.i = diff_sum;
	out.s.clear();
	out.s.append("measured historical differences");
	out
}
@end
