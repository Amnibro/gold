@entry e6df72c910aba4a8
kind: step
verb: find
noun: average
modifier: with_retry
context: core
phrase: find average value retrying within deviation {tol}
phrase: compute average of elements within tolerance {tol}
slot: tol int
test: list=10,12,14,30,50 tol=5
expect: => i=12 r=0.0 ok=true s="average of 3 items is 12" errors=0 n=5 res=[10,12,14,30,50] cache=0 hits=0
test: list=20,22,24,25 tol=3
expect: => i=21 r=0.0 ok=true s="average of 2 items is 21" errors=0 n=4 res=[20,22,24,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 {
        out.i = 0;
        out.ok = false;
        return out;
    }
    let margin = ${tol};
    let ref_val = g.res[0];
    var sum = 0;
    var count = 0;
    for i in g.n {
        let diff = if g.res[i] > ref_val { g.res[i] - ref_val } else { ref_val - g.res[i] };
        if diff <= margin {
            sum += g.res[i];
            count++;
        }
    }
    let avg = if count > 0 { sum / count } else { 0 };
    g.steps += g.n;
    out.i = avg;
    out.ok = (count > 0);
    out.s.clear();
    format(out.s, "average of ", count, " items is ", avg);
    out
}
@end
