kind: step
verb: limit
noun: value
modifier: unique
context: text
phrase: limit unique character values in text to {max_unique}
phrase: restrict unique character count to {max_unique}
slot: max_unique int
test: text="banana" max_unique=2
expect: => i=2 r=0.0 ok=true s="ba" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi" max_unique=3
expect: => i=3 r=0.0 ok=true s="mississi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let cap = ${max_unique};
    if cap <= 0 {
        gold_fail(g, "non-positive unique limit");
        out.ok = false;
        return out;
    }
    var seen byte[..256] = "";
    var res byte[..200] = "";
    for i in out.s.len {
        let ch = out.s[i];
        var found = false;
        for j in seen.len {
            if seen[j] == ch { found = true; break; }
        }
        if !found {
            if seen.len >= cap {
                break;
            }
            if seen.len < 256 { seen.push(ch); }
        }
        if res.len < 200 { res.push(ch); }
    }
    g.steps += out.s.len;
    out.i = seen.len;
    out.s.clear();
    for b in res { out.s.push(b); }
    out
}
@end
