code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let tail = g.res[g.n - 1];
	var kept int[64] = [0; 64];
	var kc = 0;
	for i in g.n - 1 {
		if g.res[i] != tail {
			if kc < 64 { kept[kc] = g.res[i]; kc++; }
		}
	}
	if kc < 64 { kept[kc] = tail; kc++; }
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kc;
	out.s.clear();
	format(out.s, "deduped tail value from prefix count ", kc);
	out
}
@end
