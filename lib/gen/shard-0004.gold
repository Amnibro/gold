code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${range_len};
	if r <= 1 { return out; }
	var i = 0;
	var swaps = 0;
	while i + r <= g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + r - 1];
		g.res[i + r - 1] = tmp;
		swaps++;
		i += r;
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped range endpoints ", swaps);
	out
}
@end
