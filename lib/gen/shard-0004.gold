@entry 7e5ce079f6090f33
kind: step
verb: dedupe
noun: threshold
modifier: unique
context: retry
phrase: dedupe retry items above threshold {cutoff} preserving unique
phrase: eliminate duplicate values exceeding cutoff {cutoff}
slot: cutoff int
test: list=5,15,15,20,20 cutoff=10
expect: => i=3 r=0.0 ok=true s="deduped threshold unique to 3" errors=0 n=3 res=[5,15,20] cache=0 hits=0
test: list=10,20 cutoff=-1
expect: => i=0 r=0.0 ok=false s="error: invalid cutoff" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cutoff};
	if c < 0 {
		gold_fail(g, "cutoff cannot be negative");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid cutoff");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var dup = false;
		if g.res[i] > c {
			var j = 0;
			while j < kept {
				if g.res[j] == g.res[i] {
					dup = true;
					break;
				}
				j++;
			}
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
		i++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped threshold unique to ", kept);
	out
}
@end
