@entry d01e98783d6113b4
kind: step
verb: sum
noun: words
modifier: unique
context: aggregate
phrase: sum words unique counting distinct lengths
phrase: aggregate count of unique word lengths
test: text="to be or not to be"
expect: => i=2 r=0.0 ok=true s="counted unique word lengths" errors=0 n=0 res=[] cache=0 hits=0
test: text="one four seven"
expect: => i=3 r=0.0 ok=true s="counted unique word lengths" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lens int[512] = [0; 512];
	var l_cnt = 0;
	var w_start = 0;
	while w_start < out.s.len {
		while w_start < out.s.len && out.s[w_start] == ' ' { w_start++; }
		if w_start >= out.s.len { break; }
		var w_end = w_start;
		while w_end < out.s.len && out.s[w_end] != ' ' { w_end++; }
		let cur_len = w_end - w_start;
		var seen = false;
		for j in l_cnt { if lens[j] == cur_len { seen = true; break; } }
		if !seen {
			lens[l_cnt] = cur_len;
			l_cnt++;
		}
		w_start = w_end;
	}
	g.steps += 1;
	out.i = l_cnt;
	out.s.clear();
	out.s.append("counted unique word lengths");
	out
}
@end
