fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 1 {
		var passes = out.s.len;
		while passes > 0 {
			for i in 0..(out.s.len - 1) {
				if out.s[i] > out.s[i + 1] {
					let tmp = out.s[i];
					out.s[i] = out.s[i + 1];
					out.s[i + 1] = tmp;
				}
			}
			passes--;
		}
	}
	out.i = out.s.len;
	out
}
@end
