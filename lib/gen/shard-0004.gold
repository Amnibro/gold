fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos = -1;
	for i in g.n { if g.res[i] == out.i { pos = i; break; } }
	if pos > 0 {
		var lo = 0;
		var hi = pos;
		while lo < hi {
			let t = g.res[lo];
			g.res[lo] = g.res[hi];
			g.res[hi] = t;
			lo++;
			hi--;
		}
	}
	g.steps += g.n;
	out.i = pos;
	out.s.clear();
	format(out.s, "reversed until position ", pos);
	out
}
@end
