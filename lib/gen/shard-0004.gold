code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var start = g.n;
	while start > 0 && g.res[start - 1] >= thresh {
		start--;
	}
	let count = g.n - start;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += 1;
	out.i = count;
	out.s.clear();
	out.s.append("found suffix");
	out
}
@end
