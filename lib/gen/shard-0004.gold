code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept byte[>..] = [];
	for b in out.s {
		let _, hit = gold_cache_get(g, b as! int);
		if !hit {
			gold_cache_put(g, b as! int, 1);
			kept.push(b);
		}
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
