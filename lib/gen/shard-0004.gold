expect: => i=1 r=0.0 ok=true s="retried sort function 1 passes" errors=0 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_passes};
	var p = 0;
	while p < lim {
		if g.n > 1 {
			for j in (g.n - 1) {
				if g.res[j] > g.res[j + 1] {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
		}
		p++;
	}
	g.steps += p * g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "retried sort function ", p, " passes");
	out
}
@end
