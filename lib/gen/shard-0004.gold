code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	if g.n > 0 {
		var idx = g.n;
		while idx > 0 {
			idx--;
			if g.res[idx] <= lim { count++; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "counted limit in reverse: ", count);
	out
}
@end
