test: list=10,8,6,3,15 stop_val=3
expect: => i=3 r=0.0 ok=true s="10,8,6,3" errors=0 n=5 res=[10,8,6,3,15] cache=0 hits=0
test: list=5,4,2 stop_val=99
expect: => i=2 r=0.0 ok=true s="5,4,2" errors=0 n=3 res=[5,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_val};
	if g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty results for minimum");
		return out;
	}
	var cur_min = g.res[0];
	var count = 0;
	out.s.clear();
	for i in g.n {
		let x = g.res[i];
		if x < cur_min { cur_min = x; }
		if count > 0 { out.s.push(','); }
		format(out.s, cur_min);
		count++;
		if x == stop { break; }
	}
	g.steps += count;
	out.i = cur_min;
	out
}
@end
