@entry 3b52e61305a620f4
kind: step
verb: map
noun: spaces
modifier: at_most
context: stats
phrase: map series spacing capped at most {cap}
phrase: transform data spacing bounding at most {cap}
slot: cap int
test: list=10,25,30,60 cap=10
expect: => i=25 r=0.0 ok=true s="total mapped space: 25" errors=0 n=3 res=[10,5,10] cache=0 hits=0
test: list=2,5,9,20 cap=15
expect: => i=18 r=0.0 ok=true s="total mapped space: 18" errors=0 n=3 res=[3,4,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n < 2 {
		gold_fail(g, "need at least two points");
		out.ok = false;
		return out;
	}
	var prev = g.res[0];
	var count = 0;
	var total = 0;
	for i in 1..g.n {
		var diff = g.res[i] - prev;
		if diff < 0 { diff = 0 - diff; }
		if diff > limit { diff = limit; }
		g.res[count] = diff;
		count++;
		total += diff;
		prev = g.res[i];
	}
	g.n = count;
	g.steps += count;
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "total mapped space: ", total);
	out
}
@end
