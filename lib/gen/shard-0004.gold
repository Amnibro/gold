fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var fixed = 0;
	for k in g.n {
		if fixed >= lim { break; }
		if g.res[k] < 0 {
			g.res[k] = 0;
			fixed++;
		}
	}
	g.steps += fixed;
	out.i = fixed;
	out.s.clear();
	format(out.s, "retried sequence until limit fixed ", fixed);
	out
}
@end
