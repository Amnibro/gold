code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 2 { return out; }
	var changed = 0;
	for i in 1..g.n - 1 {
		if i % 2 == 1 {
			g.res[i] = ${transform}(g.res[i]);
			changed++;
		}
	}
	g.steps += g.n - 2;
	out.i = changed;
	out.s.clear();
	format(out.s, "mapped middle elements count ", changed);
	out
}
@end
