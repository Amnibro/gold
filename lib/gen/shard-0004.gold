fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results to filter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	let target = g.res[0];
	var kept = 0;
	for i in g.n {
		if g.res[i] != target {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.n = kept;
	g.steps += dropped;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " matching items");
	out
}
@end
