code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${target_count};
	var counts int[256] = [0; 256];
	for i in out.s.len {
		let b = out.s[i] as int;
		counts[b]++;
	}
	var matched = 0;
	for i in 256 {
		if counts[i] == tc && tc > 0 {
			matched++;
		}
	}
	if matched == 0 {
		gold_fail(g, "no characters match frequency");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no match");
		return out;
	}
	g.steps += out.s.len;
	out.i = matched;
	out.s.clear();
	format(out.s, "found ", matched, " letters matching count");
	out
}
@end
