fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	if slen <= g.n {
		let start_idx = g.n - slen;
		for i in 0..slen {
			g.res[i] = g.res[start_idx + i];
		}
		g.n = slen;
		out.ok = true;
	} else {
		g.errors++;
		out.ok = false;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "suffix len ", g.n);
	out
}
@end
