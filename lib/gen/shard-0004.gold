fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var total = 0;
    var count = 0;
    var idx = 0;
    while idx < out.s.len {
        let ch = out.s[idx] as int;
        let val, ok = gold_cache_get(g, idx);
        if ok {
            total += val;
        } else {
            gold_cache_put(g, idx, ch);
            total += ch;
        }
        count++;
        idx += 2;
    }
    g.steps += count;
    out.i = total;
    out.s.clear();
    format(out.s, "summed ", count, " memoized alternating bytes");
    out
}
