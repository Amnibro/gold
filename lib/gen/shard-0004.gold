test: input=123
expect: => i=312 r=0.0 ok=true s="computed and cached rotation" errors=0 n=0 res=[] cache=1 hits=0
test: input=-50
expect: => i=-50 r=0.0 ok=false s="negative number error" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.i < 0 {
		gold_fail(g, "negative input rejected");
		out.ok = false;
		out.s.clear();
		out.s.append("negative number error");
		return out;
	}
	let cached, ok = gold_cache_get(g, out.i);
	if ok {
		out.i = cached;
		out.s.clear();
		out.s.append("retrieved from cache");
		return out;
	}
	let rotated = (out.i % 10) * 100 + out.i / 10;
	gold_cache_put(g, out.i, rotated);
	g.steps++;
	out.i = rotated;
	out.s.clear();
	out.s.append("computed and cached rotation");
	out
}
@end
