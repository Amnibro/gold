expect: => i=3 r=0.0 ok=true s="mapped histogram recursively: 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var freq = 0;
		let val = g.res[k];
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		g.res[k] = freq;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped histogram recursively: ", g.n);
	out
}
@end
