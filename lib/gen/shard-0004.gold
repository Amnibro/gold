		total += g.res[i];
		count++;
	}
	g.steps += count + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "folded ", count, " items under limit ", lim);
	out
}
@end
@entry d4d536610d7118a2
kind: step
verb: search
noun: item
modifier: nested
context: sort
phrase: search item nested with binary lookup {target}
phrase: locate target item nested with binary search {target}
slot: target int
test: list=2,4,6,8,10,12 target=8
expect: => i=3 r=0.0 ok=true s="found target at index 3" errors=0 n=6 res=[2,4,6,8,10,12] cache=0 hits=0
test: list=1,3,5,7 target=4
expect: => i=-1 r=0.0 ok=true s="target not found" errors=0 n=4 res=[1,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	var steps_taken = 0;
	while lo <= hi {
		steps_taken++;
		let mid = lo + (hi - lo) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	g.steps += steps_taken + 1;
	out.i = found;
	out.s.clear();
	if found >= 0 {
		format(out.s, "found target at index ", found);
	} else {
		format(out.s, "target not found");
	}
	out
}
@end
