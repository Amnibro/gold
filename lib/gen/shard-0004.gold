expect: => i=10 r=0.0 ok=true s="running digit sum 10" errors=0 n=2 res=[3,10] cache=0 hits=0
test: list=5,6
expect: => i=11 r=0.0 ok=true s="running digit sum 11" errors=0 n=2 res=[5,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var running = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var dsum = 0;
		while x > 0 {
			dsum += x % 10;
			x /= 10;
		}
		running += dsum;
		g.res[k] = running;
	}
	out.i = running;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "running digit sum ", running);
	out
}
@end
