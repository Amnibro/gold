fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let s = ${start};
    let e = ${fin};
    var kept = 0;
    for i in g.n {
        if !(i >= s && i <= e) {
            g.res[kept] = g.res[i];
            kept++;
        }
    }
    let dropped = g.n - kept;
    g.steps += g.n;
    g.n = kept;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " middle elements");
    out
}
@end
