fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${lim};
	if bound < 0 {
		gold_fail(g, "negative bound");
		out.ok = false;
		return out;
	}
	let max_k = if bound > g.n { g.n } else { bound };
	var valid = 0;
	var failed = false;
	for i in max_k {
		if core_is_odd(g.res[i]) {
			failed = true;
			gold_fail(g, "odd element fails condition");
		} else {
			valid++;
		}
	}
	g.steps += max_k;
	out.i = valid;
	out.s.clear();
	if failed {
		out.s.append("condition failed during scan");
	} else {
		out.s.append("all scanned entries valid");
	}
	out
}
@end
