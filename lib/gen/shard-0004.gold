noun: budget
modifier: any
context: search
phrase: clamp search budget any exceeding {budget}
phrase: constrain items to budget {budget} for any search
slot: budget int
test: list=10,20,30,40 budget=45
expect: => i=45 r=0.0 ok=true s="clamped budget total 45" errors=0 n=4 res=[10,20,15,0] cache=0 hits=0
test: list=5,10,15 budget=100
expect: => i=30 r=0.0 ok=true s="clamped budget total 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bud = ${budget};
	var running = 0;
	var clamped_cnt = 0;
	for i in g.n {
		if running + g.res[i] > bud {
			let allowed = max(0, bud - running);
			g.res[i] = allowed;
			running = bud;
			clamped_cnt++;
		} else {
			running += g.res[i];
		}
	}
	g.steps += g.n + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "clamped budget total ", running);
	out
}
@end
