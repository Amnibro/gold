fn ${ID}_digit_count(n int) int {
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 1; }
	var c = 0;
	while x > 0 { c++; x /= 10; }
	c
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
