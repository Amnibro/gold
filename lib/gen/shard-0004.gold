fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sym = ${symbol};
	let fill_byte = if sym.len > 0 { sym[0] } else { '*' };
	var masked = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			out.s[i] = fill_byte;
			masked++;
		}
	}
	g.steps += masked;
	out.i = masked;
	out
}
@end
