@entry 08a8831293167ea3
kind: step
verb: merge
noun: maximum
modifier: with_retry
context: stats
phrase: record maximum observation with fallback {fallback}
phrase: compute peak statistic falling back to {fallback}
slot: fallback int
test: list=10,40,25 fallback=5
expect: => i=40 r=0.0 ok=true s="peak: 40" errors=0 n=3 res=[10,40,25] cache=0 hits=0
test: list= fallback=15
expect: => i=15 r=0.0 ok=false s="fallback used: 15" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	if g.n == 0 {
		out.ok = false;
		out.i = fb;
		out.s.clear();
		format(out.s, "fallback used: ", fb);
		return out;
	}
	var cur_max = g.res[0];
	for i in 1..g.n {
		if g.res[i] > cur_max { cur_max = g.res[i]; }
	}
	g.steps += g.n;
	out.ok = true;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "peak: ", cur_max);
	out
}
@end
