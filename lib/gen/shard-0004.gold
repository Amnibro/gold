noun: runs
modifier: at_least
context: aggregate
phrase: fold runs of results at least {min_run}
phrase: aggregate run streaks of length at least {min_run}
slot: min_run int
test: list=1,1,1,2,3,3 min_run=2
expect: => i=2 r=0.0 ok=true s="matched 2 runs" errors=0 n=6 res=[1,1,1,2,3,3] cache=0 hits=0
test: list=1,2,3 min_run=2
expect: => i=0 r=0.0 ok=true s="matched 0 runs" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_run};
	if g.n == 0 || thresh <= 0 {
		out.i = 0;
		return out;
	}
	var qualified = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			if cur_len >= thresh {
				qualified++;
			}
			cur_len = 1;
		}
	}
	if cur_len >= thresh {
		qualified++;
	}
	out.i = qualified;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "matched ", qualified, " runs");
	out
}
@end
