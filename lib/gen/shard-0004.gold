	var sum = 0;
	var kept = 0;
	for i in g.n {
		if sum + g.res[i] <= max_sum {
			sum += g.res[i];
			g.res[kept] = g.res[i];
			kept++;
		} else {
			break;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = sum;
	out.s.clear();
	out.s.append("limited sequence by running sum");
	out
}
@end
