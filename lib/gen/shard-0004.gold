code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d <= 0 {
		gold_fail(g, "depth must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid depth");
		return out;
	}
	var vowels int[64] = [0; 64];
	var count = 0;
	for i in g.n {
		let c = g.res[i];
		if c == 65 || c == 69 || c == 73 || c == 79 || c == 85 {
			if count < 64 { vowels[count] = c; count++; }
		}
	}
	let take = min(d, count);
	let start = count - take;
	gold_clear(g);
	for k in take { gold_push(g, vowels[start + k]); }
	g.steps += count;
	out.i = take;
	out.s.clear();
	format(out.s, "filtered last vowels count ", take);
	out
}
@end
