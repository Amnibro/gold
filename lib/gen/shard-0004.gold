code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	for k in g.n {
		total += g.res[k];
	}
	out.i = total;
	if total <= b {
		out.ok = true;
		out.s.clear();
		format(out.s, "sum ", total, " within budget ", b);
	} else {
		gold_fail(g, "budget exceeded");
		out.ok = false;
		out.s.clear();
		format(out.s, "sum ", total, " exceeds budget ", b);
	}
	g.steps += g.n;
	out
}
@end
