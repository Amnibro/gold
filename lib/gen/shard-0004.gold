fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = false;
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] < g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				swaps++;
			}
			j++;
		}
		i++;
	}
	out.i = g.res[0];
	out.ok = swaps > 0;
	out.s.clear();
	format(out.s, "sorted maximum in reverse peak is ", g.res[0]);
	g.steps += g.n * g.n + 1;
	out
}
