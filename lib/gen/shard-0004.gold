@entry 53c8cdd9ab42f036
kind: step
verb: split
noun: items
modifier: with_retry
context: compare
phrase: split items comparing against midpoint tolerance {tol}
phrase: partition series around mean with tolerance {tol}
slot: tol int
test: list=10,20,30,40 tol=5
expect: => i=40 r=0.0 ok=false s="split delta: 40" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,12,11,13 tol=5
expect: => i=4 r=0.0 ok=true s="split delta: 4" errors=0 n=4 res=[10,12,11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tolerance = ${tol};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let mean = sum / g.n;
	var low_sum = 0;
	var hi_sum = 0;
	for i in g.n {
		if g.res[i] <= mean { low_sum += g.res[i]; }
		else { hi_sum += g.res[i]; }
	}
	var diff = hi_sum - low_sum;
	if diff < 0 { diff = 0 - diff; }
	let balanced = diff <= tolerance;
	g.steps += g.n;
	out.ok = balanced;
	out.i = diff;
	out.s.clear();
	format(out.s, "split delta: ", diff);
	out
}
@end
