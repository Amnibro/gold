test: list=3,3,3,4,4,5,5,5,5,6
expect: => i=5 r=0.0 ok=true s="cached streak value 5 length 4" errors=0 n=10 res=[3,3,3,4,4,5,5,5,5,6] cache=1 hits=0
test: list=8,8,9,10,10,10,11
expect: => i=10 r=0.0 ok=true s="cached streak value 10 length 3" errors=0 n=7 res=[8,8,9,10,10,10,11] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty results");
		return out;
	}
	var best_len = 1;
	var best_val = g.res[0];
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_val = g.res[i];
			}
		} else {
			cur_len = 1;
		}
	}
	gold_cache_put(g, best_val, best_len);
	g.steps += g.n;
	out.i = best_val;
	out.s.clear();
	format(out.s, "cached streak value ", best_val, " length ", best_len);
	out
}
@end
