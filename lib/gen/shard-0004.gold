@entry b59ea3bba7eea90f
kind: step
verb: rank
noun: checkpoint
modifier: safely
context: compare
phrase: rank checkpoint safely across elements
phrase: safely assign ranks relative to checkpoint value
test: list=10,5,20,15
expect: => i=2 r=0.0 ok=true s="safely ranked checkpoint rank 2" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=42
expect: => i=1 r=0.0 ok=true s="safely ranked checkpoint rank 1" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for checkpoint ranking");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var ranks int[64] = [0; 64];
	let count = min(g.n, 64);
	for i in count {
		var r = 1;
		for j in count {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks[i] = r;
	}
	gold_clear(g);
