test: text="abcde"
expect: => i=5 r=0.0 ok=true s="acegi" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello"
expect: => i=5 r=0.0 ok=true s="hfnos" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    for i in out.s.len {
        let b = out.s[i];
        if b >= 'a' && b <= 'z' {
            let n = b as! int - 'a' as! int;
            let shifted = (n + i) % 26;
            out.s[i] = ('a' as! int + shifted) as! byte;
        }
    }
    g.steps += out.s.len;
    out.i = out.s.len;
    out
}
@end
