		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "sort last steps skipped");
		return out;
	}
	let span = min(k, g.n);
	let start = g.n - span;
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
