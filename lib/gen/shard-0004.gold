test: list=10,2 floor_val=8
expect: => i=1 r=0.0 ok=true s="paired bounded minimums count 1" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_min = ${floor_val};
	let pairs = g.n / 2;
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		var m = if a < b { a } else { b };
		if m < floor_min { m = floor_min; }
		g.res[i] = m;
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired bounded minimums count ", pairs);
	out
}
@end
