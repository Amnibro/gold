slot: step_op fn
slot: max_steps int

test: input=1 step_op=double max_steps=4
expect: => i=5 r=0.0 ok=true s="unique loop values count 5" errors=0 n=5 res=[1,2,4,8,16] cache=0 hits=0
test: input=3 step_op=inc max_steps=3
expect: => i=4 r=0.0 ok=true s="unique loop values count 4" errors=0 n=4 res=[3,4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let steps_lim = ${max_steps};
	var cur = out.i;
	gold_push(g, cur);
	for i in steps_lim {
		cur = ${step_op}(cur);
		var seen = false;
		for j in g.n {
			if g.res[j] == cur { seen = true; }
		}
		if !seen { gold_push(g, cur); }
	}
	g.steps += steps_lim;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique loop values count ", g.n);
	out
}
@end
