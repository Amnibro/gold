@entry f3a874b69da5fda8
kind: step
verb: rotate
noun: range
modifier: in_place
context: cache
phrase: rotate cache range in place by {span} positions
phrase: cycle cached range in place with span {span}
slot: span int
test: list=10,20,30,40 span=1
expect: => i=1 r=0.0 ok=true s="rotated cache range in place by 1" errors=0 n=4 res=[20,30,40,10] cache=4 hits=0
test: list=5,15 span=0
expect: => i=0 r=0.0 ok=true s="rotate cache range skipped" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "rotate cache range skipped");
		return out;
	}
	let rot = sp % g.n;
	for r in rot {
		let first = g.res[0];
		for i in 1..g.n {
			g.res[i - 1] = g.res[i];
		}
		g.res[g.n - 1] = first;
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += rot * g.n + 1;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated cache range in place by ", rot);
	out
}
@end
@entry 645ad27efe8561a7
kind: step
verb: rotate
noun: history
modifier: between
context: cache
phrase: rotate cache history between {start_idx} to {end_idx}
phrase: shift history between {start_idx} through {end_idx} in cache
slot: start_idx int
slot: end_idx int
test: list=10,20,30,40,50 start_idx=1 end_idx=3
expect: => i=3 r=0.0 ok=true s="rotated history segment size 3" errors=0 n=5 res=[10,40,30,20,50] cache=3 hits=0
test: list=1,2,3 start_idx=0 end_idx=0
expect: => i=0 r=0.0 ok=true s="history rotation skipped" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = max(0, ${start_idx});
	let e = min(g.n - 1, ${end_idx});
	if s >= e || g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "history rotation skipped");
		return out;
	}
	var lo = s;
	var hi = e;
	while lo < hi {
		let tmp = g.res[lo];
		g.res[lo] = g.res[hi];
		g.res[hi] = tmp;
		lo++;
		hi--;
	}
	for i in s..(e + 1) {
		gold_cache_put(g, i, g.res[i]);
	}
	let span = e - s + 1;
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "rotated history segment size ", span);
	out
}
@end
