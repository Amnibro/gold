noun: numbers
modifier: sorted
context: search
phrase: reverse search numbers if sorted
phrase: invert order of sorted search numbers
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="sorted status was true" errors=0 n=4 res=[4,3,2,1] cache=0 hits=0
test: list=4,2,3,1
expect: => i=0 r=0.0 ok=false s="sorted status was false" errors=0 n=4 res=[4,2,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var is_sorted = true;
	for i in 1..g.n { if g.res[i] < g.res[i - 1] { is_sorted = false; break; } }
	if is_sorted {
		var lo = 0;
		var hi = g.n - 1;
		while lo < hi {
			let t = g.res[lo];
			g.res[lo] = g.res[hi];
			g.res[hi] = t;
			lo++;
			hi--;
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.s.clear();
	format(out.s, "sorted status was ", is_sorted);
	out
}
@end
