code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var i = 0;
	var scaled = 0;
	while i + 1 < g.n {
		if g.res[i] >= g.res[i + 1] {
			g.res[i] = g.res[i] * mult;
		} else {
			g.res[i + 1] = g.res[i + 1] * mult;
		}
		scaled++;
		i += 2;
	}
	g.steps += scaled + 1;
	out.i = scaled;
	out.s.clear();
	out.s.append("scaled larger element in pairs");
	out
}
@end
