fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i] > g.res[i - 1] {
				cur_streak++;
				if cur_streak > max_streak { max_streak = cur_streak; }
			} else {
				cur_streak = 0;
			}
		}
	}
	gold_cache_put(g, 500, max_streak);
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "maximum streak length in cache ", max_streak);
	out
}
@end
