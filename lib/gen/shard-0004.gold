expect: => i=2 r=0.0 ok=true s="shifted by 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift_steps};
	if g.n > 1 && s > 0 {
		let shift = s % g.n;
		for _ in 0..shift {
			let first = g.res[0];
			for i in 0..(g.n - 1) {
				g.res[i] = g.res[i + 1];
			}
			g.res[g.n - 1] = first;
		}
		out.i = shift;
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "shifted by ", out.i);
	out
}
@end
