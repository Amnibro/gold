			if diff <= max_gap {
				g.res[i] = g.res[i] * 2;
				scaled++;
			} else {
				break;
			}
		}
	}
	g.steps += scaled + 1;
	out.i = scaled;
	out.s.clear();
	out.s.append("scaled items until gap limit");
	out
}
