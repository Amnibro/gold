fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var limit = 100;
	var valid = true;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if ok {
			if cached == 0 { valid = false; }
		} else {
			if x > limit {
				gold_cache_put(g, x, 0);
				valid = false;
			} else {
				gold_cache_put(g, x, 1);
			}
		}
	}
	g.steps += g.n;
	if !valid {
		gold_fail(g, "value exceeds limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: limit exceeded");
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "validated elements within limit count ", g.n);
	}
	out
}
@end
