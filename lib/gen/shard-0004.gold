@entry 2c3e7c11dba5a175
kind: step
verb: collect
noun: gaps
modifier: sorted
context: transform
phrase: collect gaps sorted ascending
phrase: gather sorted gaps between entries
test: list=10,25,27
expect: => i=2 r=0.0 ok=true s="collected gaps sorted" errors=0 n=5 res=[10,25,27,2,15] cache=0 hits=0
test: list=1,5,6,10
expect: => i=3 r=0.0 ok=true s="collected gaps sorted" errors=0 n=7 res=[1,5,6,10,1,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	let count = g.n - 1;
	for i in count {
		let gap = g.res[i + 1] - g.res[i];
		gold_push(g, gap);
	}
	let base = g.n - count;
	for i in count {
		for j in count - 1 - i {
			let idx1 = base + j;
			let idx2 = idx1 + 1;
			if g.res[idx1] > g.res[idx2] {
				let tmp = g.res[idx1];
				g.res[idx1] = g.res[idx2];
				g.res[idx2] = tmp;
			}
		}
	}
	g.steps += count * 2;
	out.i = count;
	out.s.clear();
	out.s.append("collected gaps sorted");
	out
}
@end
