code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		let last = g.res[g.n - 1];
		var idx = g.n - 1;
		while idx > 0 {
			g.res[idx] = g.res[idx - 1];
			idx--;
		}
		g.res[0] = last;
		out.i = last;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated array");
	out
}
@end
@entry 57b0fca2aa063473
kind: step
verb: search
noun: primes
modifier: all
context: format
phrase: search all prime numbers in results
phrase: count prime items across entire results
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="primes found 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="primes found 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prime_count++; }
		}
	}
	out.i = prime_count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "primes found ", prime_count);
	out
}
@end
