@entry c52a2595138e3fa0
kind: step
verb: dedupe
noun: limit
modifier: safely
context: core
phrase: dedupe elements keeping safe limit of uniques {max_unique}
phrase: condense results safely retaining unique ceiling {max_unique}
slot: max_unique int
test: list=5,3,5,2,3,8 max_unique=2
expect: => i=2 r=0.0 ok=true s="uniques 2" errors=0 n=2 res=[5,3] cache=0 hits=0
test: list=1,1,1 max_unique=3
expect: => i=1 r=0.0 ok=true s="uniques 1" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_unique};
	var w = 0;
	for i in 0..g.n {
		let x = g.res[i];
		var seen = false;
		for j in 0..w {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			if w < lim {
				g.res[w] = x;
				w++;
			}
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "uniques ", w);
	out
}
@end
