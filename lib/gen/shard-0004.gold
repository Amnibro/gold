noun: tail
modifier: in_place
context: sort
phrase: return tail in place of size {count}
phrase: keep sorted tail in place with span {count}
slot: count int
test: list=10,20,30,40,50 count=3
expect: => i=3 r=0.0 ok=true s="returned tail in place size 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
