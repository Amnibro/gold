code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${floor};
	var first_idx = -1;
	var last_idx = -1;
	for i in g.n {
		if g.res[i] >= min_val {
			if first_idx < 0 { first_idx = i; }
			last_idx = i;
		}
	}
	var swapped = 0;
	if first_idx >= 0 && last_idx > first_idx {
		let tmp = g.res[first_idx];
		g.res[first_idx] = g.res[last_idx];
		g.res[last_idx] = tmp;
		swapped = 1;
	}
	g.steps += g.n + 1;
	out.i = swapped;
	out.s.clear();
	out.s.append("swapped boundary elements matching floor");
	out
}
@end
