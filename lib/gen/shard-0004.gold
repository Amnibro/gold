test: list=10,20 retries=1
expect: => i=2 r=0.0 ok=true s="reversed 2 items" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${retries};
	if g.n == 0 {
		g.steps += limit;
		gold_fail(g, "cannot reverse empty list");
		out.ok = false;
		return out;
	}
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += g.n + limit;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " items");
	out
}
@end
