code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_a = false;
	var has_e = false;
	var has_i = false;
	var has_o = false;
	var has_u = false;
	for i in out.s.len {
		let b = out.s[i];
		if b == 'a' as byte { has_a = true; }
		if b == 'e' as byte { has_e = true; }
		if b == 'i' as byte { has_i = true; }
		if b == 'o' as byte { has_o = true; }
		if b == 'u' as byte { has_u = true; }
	}
	var total = 0;
	if has_a { total++; }
	if has_e { total++; }
	if has_i { total++; }
	if has_o { total++; }
	if has_u { total++; }
	g.steps += out.s.len;
	out.i = total;
	out.s.clear();
	format(out.s, "distinct vowels count ", total);
	out
}
@end
