code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${klen};
	var bound = p;
	if bound > g.n { bound = g.n; }
	var is_sorted = true;
	if bound > 1 {
		for k in (bound - 1) {
			if g.res[k] > g.res[k + 1] {
				is_sorted = false;
			}
		}
	}
	gold_cache_put(g, bound, if is_sorted { 1 } else { 0 });
	g.steps += bound;
	out.ok = is_sorted;
	out.i = bound;
	out.s.clear();
	format(out.s, "prefix of len ", bound, " sorted: ", is_sorted);
	out
}
@end
@entry b36787905624fba4
kind: step
verb: reverse
noun: cache
modifier: between
context: sort
phrase: reverse cached sort keys between limits {low} to {high}
phrase: invert cache entries between range {low} to {high}
slot: low int
slot: high int
test: list=10,20,30,40 low=0 high=2
expect: => i=4 r=0.0 ok=true s="reversed cache values in range" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,15,25,35 low=1 high=3
expect: => i=4 r=0.0 ok=true s="reversed cache values in range" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var l = ${low};
	var h = ${high};
	if l < 0 { l = 0; }
	if h >= g.cn { h = g.cn - 1; }
	while l < h {
		let tmp = g.cv[l];
		g.cv[l] = g.cv[h];
		g.cv[h] = tmp;
		l++;
		h--;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed cache values in range");
	out
}
@end
