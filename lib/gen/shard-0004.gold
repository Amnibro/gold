code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var tn = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_square(x) {
			gold_cache_put(g, x, 1);
			temp[tn] = x;
			tn++;
		}
	}
	if tn == 0 {
		gold_fail(g, "no squares found error");
		out.ok = false;
	}
	gold_clear(g);
	for k in tn { gold_push(g, temp[k]); }
	g.steps += tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "selected ", tn, " squares with cache");
	out
}
@end
