@entry 3ecd9e232bdff60d
kind: step
verb: reverse
noun: tail
modifier: last
context: error
phrase: reverse tail segment across last {count} entries
phrase: flip trailing slice across last {count} items
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=3 r=0.0 ok=true s="reversed tail items" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=1,2 count=5
expect: => i=0 r=0.0 ok=false s="invalid reverse count" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k < 0 || k > g.n {
		gold_fail(g, "out of bounds tail reverse");
		out.ok = false;
		out.s.clear();
		out.s.append("invalid reverse count");
		return out;
	}
	let start = g.n - k;
	for i in k / 2 {
		let idx1 = start + i;
		let idx2 = start + k - 1 - i;
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
	}
	g.steps += k;
	out.i = k;
	out.s.clear();
	out.s.append("reversed tail items");
	out
}
@end
