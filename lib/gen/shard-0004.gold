code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	var found = false;
	var idx = -1;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n && !found {
			if g.res[i] + g.res[i + 1] == goal {
				found = true;
				idx = i;
			}
			i++;
		}
	}
	out.s.clear();
	if found {
		out.i = idx;
		out.s.append("window matching target sum found");
	} else {
		out.i = -1;
		out.s.append("no window matched target sum");
	}
	g.steps += g.n + 1;
	out
}
@end
