code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${attempts};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	for k in old_n {
		gold_push(g, orig[k]);
		gold_push(g, orig[k]);
	}
	out.i = old_n;
	g.steps += max_tries;
	out.s.clear();
	format(out.s, "duplicated ", old_n, " items");
	out
}
@end
