expect: => i=3 r=0.0 ok=true s="sorted items between range 3" errors=0 n=5 res=[10,30,50,90,80] cache=0 hits=0
test: list=10,20 low=3 high=1
expect: => i=0 r=0.0 ok=false s="error: invalid range" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	if l < 0 || h >= g.n || l >= h {
		gold_fail(g, "invalid bounds for between sort");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid range");
		return out;
	}
	let span = h - l + 1;
	for i in span {
		var j = l;
		while j < h - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted items between range ", span);
	out
}
@end
@entry f09f3d7435dde703
kind: step
verb: rotate
noun: errors
modifier: in_place
context: retry
phrase: rotate error records in place by offset {shift}
phrase: shift error entries in place by distance {shift}
slot: shift int
test: list=1,2,3,4 shift=1
expect: => i=1 r=0.0 ok=true s="rotated errors in place by 1" errors=0 n=4 res=[2,3,4,1] cache=0 hits=0
test: list=5,6 shift=-1
expect: => i=0 r=0.0 ok=false s="error: invalid shift" errors=1 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if s < 0 || g.n == 0 {
		gold_fail(g, "invalid shift or empty errors");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid shift");
		return out;
	}
	let k = s % g.n;
	var count = 0;
	while count < k {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		count++;
	}
	g.steps += count + 1;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated errors in place by ", k);
	out
}
@end
