@entry 85a91b06ba611727
kind: step
verb: sum
noun: threshold
modifier: with_retry
context: list
phrase: sum elements meeting threshold with retry bound {retries}
phrase: accumulate numbers above threshold within {retries} attempts
slot: retries int
test: list=5,15,25,35 retries=2
expect: => i=75 r=0.0 ok=true s="threshold sum with retry is 75" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
test: list=10,20,30,40 retries=3
expect: => i=100 r=0.0 ok=true s="threshold sum with retry is 100" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let max_tries = ${retries};
    var threshold = 10;
    var total = 0;
    for t in max_tries {
        total = 0;
        for i in g.n {
            if g.res[i] >= threshold {
                total += g.res[i];
            }
        }
        if total > 50 { break; }
        threshold = threshold / 2;
    }
    g.steps += max_tries * g.n;
    out.i = total;
    out.s.clear();
    format(out.s, "threshold sum with retry is ", total);
    out
}
@end
