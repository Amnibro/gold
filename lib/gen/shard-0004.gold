@entry 0c7e1b39a6447655
kind: step
verb: rotate
noun: threshold
modifier: recursively
context: stats
phrase: rotate sample values above threshold {threshold} recursively
phrase: cycle distribution metrics exceeding cutoff {threshold} recursively
slot: threshold int
test: list=10,50,20,80,90,5 threshold=30
expect: => i=3 r=0.0 ok=true s="rotated threshold elements 3" errors=0 n=6 res=[10,80,20,90,50,5] cache=0 hits=0
test: list=10,20,25 threshold=30
expect: => i=0 r=0.0 ok=false s="" errors=0 n=3 res=[10,20,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var first_idx = -1;
	var last_idx = -1;
	var count = 0;
	for i in g.n {
		if g.res[i] > th {
			if first_idx < 0 {
				first_idx = i;
			}
			last_idx = i;
			count++;
		}
	}
	if count <= 1 {
		out.i = count;
		out.ok = false;
		return out;
	}
	let first_val = g.res[first_idx];
	var prev_idx = first_idx;
	var i = first_idx + 1;
	while i < g.n {
		if g.res[i] > th {
			g.res[prev_idx] = g.res[i];
			prev_idx = i;
		}
		i++;
	}
	g.res[last_idx] = first_val;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated threshold elements ", count);
	g.steps += g.n;
	out
}
@end
