fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_pairs = ${count};
	var pairs = g.n / 2;
	if pairs > max_pairs { pairs = max_pairs; }
	for k in pairs {
		g.res[k] = g.res[k * 2] + g.res[k * 2 + 1];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	out.s.append("summed pairs up to count");
	out
}
