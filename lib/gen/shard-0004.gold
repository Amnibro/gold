@entry 51cd732ae50b494f
kind: step
verb: collect
noun: runs
modifier: at_least
context: math
phrase: collect elements from runs of length at least {min_run}
phrase: preserve values from streaks meeting length {min_run}
slot: min_run int
test: list=1,1,1,2,3,3,4,4,4,4 min_run=3
expect: => i=7 r=0.0 ok=true s="collected 7 elements in valid runs" errors=0 n=7 res=[1,1,1,4,4,4,4] cache=0 hits=0
test: list=5,5,6,7,7,7,8 min_run=2
expect: => i=5 r=0.0 ok=true s="collected 5 elements in valid runs" errors=0 n=5 res=[5,5,7,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let req = ${min_run};
    var kept = 0;
    var i = 0;
    while i < g.n {
        var j = i;
        while j < g.n && g.res[j] == g.res[i] { j++; }
        let len = j - i;
        if len >= req {
            for k in i..j {
                g.res[kept] = g.res[k];
                kept++;
            }
        }
        i = j;
    }
    g.steps += g.n;
    g.n = kept;
    out.i = kept;
    out.s.clear();
    format(out.s, "collected ", kept, " elements in valid runs");
    out
}
@end
