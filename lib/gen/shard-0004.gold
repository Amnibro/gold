fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sum = ${limit};
	var sum = 0;
	var kept = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		if sum + sq <= max_sum {
			sum += sq;
			g.res[kept] = sq;
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept + 1;
	out.i = sum;
	out.s.clear();
	out.s.append("scaled squares until limit");
