fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var limit = ${prefix_len};
	if limit > g.n { limit = g.n; }
	var kept = 0;
	for i in limit {
		if i % 2 == 0 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in kept / 2 {
		let j = kept - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += limit;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reversed alternating prefix count ", kept);
	out
}
