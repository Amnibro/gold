test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="collapsed equal runs count 1" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var kept = 0;
	var i = 0;
	while i < g.n {
		var sum = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			sum += g.res[j];
			j++;
		}
		g.res[kept] = sum;
		kept++;
		i = j;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "collapsed equal runs count ", kept);
	out
}
@end
