code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var kept = 0;
    for i in g.n {
        let x = g.res[i];
        var seen = false;
        for j in kept {
            if g.res[j] == x { seen = true; break; }
        }
        if !seen {
            g.res[kept] = x;
            kept++;
        }
    }
    g.steps += g.n;
    g.n = kept;
    out.i = kept;
    out.s.clear();
    format(out.s, "grouped ", kept, " unique numbers");
    out
}
@end
@entry 4da8a63de66a1517
kind: step
verb: shift
noun: streak
modifier: in_place
context: math
phrase: shift longest equal streak to head in place
phrase: relocate peak streak to start of results
test: list=1,2,2,2,3,4
expect: => i=3 r=0.0 ok=true s="shifted streak of length 3" errors=0 n=6 res=[2,2,2,1,3,4] cache=0 hits=0
test: list=5,6,7,7,7,7,8
expect: => i=4 r=0.0 ok=true s="shifted streak of length 4" errors=0 n=7 res=[7,7,7,7,5,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n <= 1 {
        out.i = 0;
        return out;
    }
    var best_len = 1;
    var best_start = 0;
    var cur_len = 1;
    var cur_start = 0;
    for i in 1..g.n {
        if g.res[i] == g.res[i - 1] {
            cur_len++;
            if cur_len > best_len {
                best_len = cur_len;
                best_start = cur_start;
            }
        } else {
            cur_len = 1;
            cur_start = i;
        }
    }
    for s in best_len {
        let val = g.res[best_start + s];
        var j = best_start + s;
        while j > s {
            g.res[j] = g.res[j - 1];
            j--;
        }
        g.res[s] = val;
    }
    g.steps += g.n;
    out.i = best_len;
    out.s.clear();
    format(out.s, "shifted streak of length ", best_len);
    out
}
@end
