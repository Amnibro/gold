fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${key};
	let val, ok = gold_cache_get(g, k);
	if ok {
		out.i = val;
		out.s.clear();
		format(out.s, "cache hit for key ", k, " val ", val);
	} else {
		let computed = k * 10;
		gold_cache_put(g, k, computed);
		out.i = computed;
		out.s.clear();
		format(out.s, "cache miss for key ", k, " cached ", computed);
	}
	g.steps += 1;
	out
}
@end
