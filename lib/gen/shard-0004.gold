		for i in 0..(w - 1) {
			for j in (i + 1)..w {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = w;
	out.s.clear();
	if w > 0 {
		format(out.s, "min ", g.res[0], " max ", g.res[w - 1]);
	} else {
		format(out.s, "empty window");
	}
	out
}
@end
