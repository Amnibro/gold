fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 {
		return x;
	}
	if x < 100 {
		let d1 = x / 10;
		let d0 = x % 10;
		return d0 * 10 + d1;
	}
	let head = x / 1000;
	let tail = x % 1000;
	let d2 = tail / 100;
	let d1 = (tail / 10) % 10;
	let d0 = tail % 10;
	let rot = d0 * 100 + d2 * 10 + d1;
	head * 1000 + rot
}
@end
