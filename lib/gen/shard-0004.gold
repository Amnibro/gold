test: list=10,25,30 max_gap=5
expect: => i=20 r=0.0 ok=true s="gaps clamped" errors=0 n=3 res=[10,15,20] cache=0 hits=0
test: list=1,2 max_gap=5
expect: => i=2 r=0.0 ok=true s="gaps clamped" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_gap};
	if g.n >= 2 && limit > 0 {
		for k in 1..g.n {
			if g.res[k] - g.res[k - 1] > limit {
				g.res[k] = g.res[k - 1] + limit;
			}
		}
	}
	out.i = if g.n > 0 { g.res[g.n - 1] } else { 0 };
	g.steps += g.n;
	out.s.clear();
	format(out.s, "gaps clamped");
	out
}
@end
