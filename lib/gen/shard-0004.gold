code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = 0;
	var hi = g.n - 1;
	while lo < hi {
		let t = g.res[lo];
		g.res[lo] = g.res[hi];
		g.res[hi] = t;
		lo++;
		hi--;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "reversed head element ", out.i);
	out
}
@end
