fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for fold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty values");
		return out;
	}
	var total = 0;
	for i in g.n {
		let val, ok = gold_cache_get(g, g.res[i]);
		if ok {
			total += val;
		} else {
			gold_cache_put(g, g.res[i], g.res[i] * 2);
			total += g.res[i];
		}
	}
	gold_clear(g);
	gold_push(g, total);
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded values with cache to ", total);
	out
}
@end
