kind: step
verb: check
noun: prefix
modifier: nested
context: loop
phrase: check prefix nested up to span {span}
phrase: verify nested prefix sequence up to span {span}
slot: span int
test: list=2,4,6,8 span=3
expect: => i=3 r=0.0 ok=true s="nested prefix valid" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=9,4,6 span=3
expect: => i=0 r=0.0 ok=true s="nested prefix broken" errors=0 n=3 res=[9,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${span};
	var valid = true;
	var count = 0;
	for i in g.n {
		if i + 1 < limit && i + 1 < g.n {
			if g.res[i] >= g.res[i + 1] { valid = false; }
			else { count++; }
		}
	}
	out.s.clear();
	if valid {
		out.i = count + 1;
		out.s.append("nested prefix valid");
	} else {
		out.i = 0;
		out.s.append("nested prefix broken");
	}
	g.steps += count + 1;
	out
}
@end
@entry 51f406fa96691af0
kind: step
verb: select
noun: tally
modifier: any
context: loop
phrase: select tally any elements exceeding threshold {threshold}
phrase: gather items with tally count above {threshold}
slot: threshold int
test: list=2,3,2,4,2,5 threshold=2
expect: => i=1 r=0.0 ok=true s="selected items matching tally threshold" errors=0 n=1 res=[2] cache=0 hits=0
test: list=7,7,8,8,8 threshold=1
expect: => i=2 r=0.0 ok=true s="selected items matching tally threshold" errors=0 n=2 res=[7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_tally = ${threshold};
	var kept = 0;
	var temp = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if temp[j] == x { seen = true; }
		}
		if !seen {
			var count = 0;
			for j in g.n {
				if g.res[j] == x { count++; }
			}
			if count >= min_tally {
				temp[kept] = x;
				kept++;
			}
		}
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("selected items matching tally threshold");
	out
}
@end
