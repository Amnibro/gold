code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	var i = 1;
	while i < g.n {
		if g.res[i] < g.res[i-1] { sorted = false; }
		i++;
	}
	g.steps += g.n;
	if !sorted {
		gold_fail(g, "streak is not sorted");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: streak not sorted");
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "validated sorted streak of length ", g.n);
	}
	out
}
@end
