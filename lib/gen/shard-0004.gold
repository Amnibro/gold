code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 1 || g.n == 0 { return out; }
	var orig int[512] = [0; 512];
	let orig_n = g.n;
	for i in orig_n { orig[i] = g.res[i]; }
	var dest = 0;
	for i in orig_n {
		for rep in t {
			if dest < 512 {
				g.res[dest] = orig[i];
				dest += 1;
			}
		}
	}
	g.n = dest;
	g.steps += dest;
	out.i = dest;
	out.ok = true;
	out.s.clear();
	format(out.s, "expanded size: ", g.n);
	out
}
@end
