@entry dce44f4c74658553
kind: step
verb: limit
noun: runs
modifier: none
context: core
phrase: limit consecutive runs removing any with none matching {chk}
phrase: prune adjacent runs satisfying none of {chk}
slot: chk pred
test: list=2,2,3,3,3,4,5,5 chk=is_even
expect: => i=3 r=0.0 ok=true s="kept 3 elements in valid runs" errors=0 n=3 res=[2,2,4] cache=0 hits=0
test: list=1,1,2,3,3,4,4,4 chk=is_odd
expect: => i=4 r=0.0 ok=true s="kept 4 elements in valid runs" errors=0 n=4 res=[1,1,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var kept = 0;
    var i = 0;
    while i < g.n {
        var j = i;
        var has_match = false;
        while j < g.n && g.res[j] == g.res[i] {
            if ${chk}(g.res[j]) { has_match = true; }
            j++;
        }
        if has_match {
            for k in i..j {
                g.res[kept] = g.res[k];
                kept++;
            }
        }
        i = j;
    }
    g.steps += g.n;
    g.n = kept;
    out.i = kept;
    out.s.clear();
    format(out.s, "kept ", kept, " elements in valid runs");
    out
}
@end
