expect: => i=3 r=0.0 ok=true s="split 3 memo items" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${cap};
    if g.cn == 0 {
        gold_cache_put(g, 1, out.i);
        gold_cache_put(g, 2, out.i * 2);
        gold_cache_put(g, 3, out.i * 3);
    }
    gold_clear(g);
    let bound = if limit < g.cn { limit } else { g.cn };
    for i in bound {
        gold_push(g, g.cv[i]);
    }
    g.steps += bound;
    out.i = bound;
    out.s.clear();
    format(out.s, "split ", bound, " memo items");
    out
}
@end
