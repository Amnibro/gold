@entry 6f9f258f7722e923
kind: step
verb: merge
noun: words
modifier: sorted
context: retry
phrase: merge words sorted with retry budget {limit}
phrase: combine sorted word counts within limit {limit}
slot: limit int
test: list=10,20,30 limit=3
expect: => i=60 r=0.0 ok=true s="merged words sorted: 60" errors=0 n=1 res=[60] cache=0 hits=0
test: list=50,20 limit=1
expect: => i=70 r=0.0 ok=false s="merged words sorted: 70" errors=1 n=1 res=[70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var passes = 0;
	var sorted = false;
	while passes < lim && !sorted {
		sorted = true;
		for k in (g.n - 1) {
			if g.res[k] > g.res[k + 1] {
				let tmp = g.res[k];
				g.res[k] = g.res[k + 1];
				g.res[k + 1] = tmp;
				sorted = false;
			}
		}
		passes++;
	}
	if !sorted {
		gold_fail(g, "not sorted within retry limit");
		out.ok = false;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	gold_clear(g);
	gold_push(g, sum);
	g.steps += passes + g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged words sorted: ", sum);
	out
}
@end
