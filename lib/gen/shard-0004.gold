fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp = [0; 512];
	var kept = 0;
	if g.n > 1 {
		var j = g.n - 1;
		while j > 0 {
			let diff = g.res[j] - g.res[j - 1];
			temp[kept] = diff;
			kept++;
			j--;
		}
	}
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("recomputed differences in reverse");
