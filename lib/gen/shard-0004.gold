fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var count = 0;
    for i in g.n {
        if g.res[i] > 0 { count++; }
        g.res[i] = count;
    }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "running positive tally is ", count);
    out
}
