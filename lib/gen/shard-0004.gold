fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for i in pairs {
		let a = g.res[2 * i];
		let b = g.res[2 * i + 1];
		var sum = a + b;
		if ${cond}(a) || ${cond}(b) {
			sum = sum * sum;
		}
		g.res[i] = sum;
	}
	g.steps += pairs;
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired square elements count ", pairs);
	out
}
