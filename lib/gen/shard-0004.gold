code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	for i in g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			is_sorted = false;
			break;
		}
	}
	var cnt = ${counter};
	if is_sorted {
		while cnt > 0 {
			cnt--;
			g.steps++;
		}
	} else {
		cnt = 0;
	}
	out.i = cnt;
	out.s.clear();
	if is_sorted {
		out.s.append("counter dropped completely");
	} else {
		out.s.append("results unsorted");
	}
	out
}
@end
