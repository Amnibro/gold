test: list=5,10
expect: => i=0 r=0.0 ok=false s="error: too few elements" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least three elements for middle clamp");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few elements");
		return out;
	}
	var left = 1;
	var right = g.n - 2;
	var count = 0;
	while left <= right {
		if g.res[left] > 25 {
			g.res[left] = 25;
			count++;
		}
		if left != right && g.res[right] > 25 {
			g.res[right] = 25;
			count++;
		}
		left++;
		right--;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped middle elements ", count);
	out
}
@end
