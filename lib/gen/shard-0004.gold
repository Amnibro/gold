fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var kept = 0;
	for i in g.n {
		if g.res[i] > avg {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n * 2;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "above average items count ", kept);
	out
}
@end
