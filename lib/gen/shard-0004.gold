code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap_val};
	if out.i <= cap && out.i >= 10 {
		let tens = (out.i / 10) % 10;
		let ones = out.i % 10;
		out.i = (out.i / 100) * 100 + ones * 10 + tens;
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "swapped digit result ", out.i);
	out
}
@end
