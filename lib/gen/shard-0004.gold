code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len == 0 {
		gold_fail(g, "empty text string");
		out.ok = false;
		return out;
	}
	var seen byte[256] = [0; 256];
	var u = 0;
	for i in out.s.len {
		let b = out.s[i] as int;
		if b >= 0 && b < 256 {
			if seen[b] == 0 { seen[b] = 1; u++; }
		}
	}
	var clamped = u;
	if clamped > 4 { clamped = 4; }
	g.steps += u;
	gold_push(g, clamped);
	out.i = clamped;
	out.s.clear();
	format(out.s, "unique character count clamped to ", clamped);
	out
}
@end
