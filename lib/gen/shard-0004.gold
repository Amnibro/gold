fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_seen = 0;
	for i in g.n {
		let key = g.res[i];
		let count, found = gold_cache_get(g, key);
		if found {
			gold_cache_put(g, key, count + 1);
		} else {
			gold_cache_put(g, key, 1);
			unique_seen++;
		}
	}
	g.steps += g.n;
	out.i = unique_seen;
	out.s.clear();
	format(out.s, "unique tally keys cached ", unique_seen);
	out
}
@end
