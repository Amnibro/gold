@entry 7aa759f71248c6da
kind: step
verb: repeat
noun: primes
modifier: in_reverse
context: cache
phrase: repeat cached primes in reverse order
phrase: duplicate prime numbers backwards in cache
test: list=2,4,5,6,7
expect: => i=3 r=0.0 ok=true s="repeated 3 primes in reverse" errors=0 n=8 res=[2,4,5,6,7,7,5,2] cache=3 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="repeated 0 primes in reverse" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_buf int[512] = [0; 512];
	var p_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) {
			p_buf[p_cnt] = x;
			gold_cache_put(g, x, p_cnt + 1);
			p_cnt++;
		}
	}
	var rev = p_cnt - 1;
	while rev >= 0 {
		if g.n < 512 { gold_push(g, p_buf[rev]); }
		rev--;
	}
	g.steps += g.n + 1;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "repeated ", p_cnt, " primes in reverse");
	out
}
@end
@entry 7c6b53370f5f5c88
kind: step
verb: join
noun: checkpoint
modifier: last
context: cache
phrase: join last cached checkpoints of size {count}
phrase: combine tail checkpoints from cache with count {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="30@40" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5 count=0
expect: => i=0 r=0.0 ok=true s="empty checkpoint join" errors=0 n=1 res=[5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	if c <= 0 || g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty checkpoint join");
		return out;
	}
	let span = min(c, g.n);
	let start = g.n - span;
	out.s.clear();
	for i in start..g.n {
		if i > start { out.s.push('@'); }
		format(out.s, g.res[i]);
	}
	g.steps += span + 1;
	out.i = span;
	out
}
@end
@entry 83255bcee3a576c6
kind: step
verb: sort
noun: odds
modifier: until
