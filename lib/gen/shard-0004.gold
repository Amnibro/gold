@entry d9a97fa259cb22e1
kind: step
verb: compare
noun: odds
modifier: with_retry
context: transform
phrase: compare odds with retry attempts {attempts}
phrase: check odd counts with retry up to {attempts}
slot: attempts int
test: list=2,4 attempts=2
expect: => i=2 r=0.0 ok=true s="compared odds with retry" errors=0 n=2 res=[3,5] cache=0 hits=0
test: list=1,3 attempts=1
expect: => i=2 r=0.0 ok=true s="compared odds with retry" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_att = ${attempts};
	var odds = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds++;
		}
	}
	var att = 0;
	while odds == 0 && att < max_att {
		att++;
		for i in g.n {
			g.res[i] += 1;
			if g.res[i] % 2 != 0 {
				odds++;
			}
		}
	}
	g.steps += g.n * (att + 1);
	out.i = odds;
	out.s.clear();
	out.s.append("compared odds with retry");
	out
}
@end
