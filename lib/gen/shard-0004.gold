code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var start = 0;
	while start < g.n && g.res[start] < thresh {
		start += 1;
	}
	let new_n = g.n - start;
	for i in new_n {
		g.res[i] = g.res[start + i];
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted size: ", new_n);
	out
}
@end
