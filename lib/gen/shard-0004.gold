fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	if g.n > 0 {
		let mid = g.res[g.n / 2];
		out.i = mid;
		out.s.clear();
		format(out.s, "median ", mid);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "none");
	}
	out
}
