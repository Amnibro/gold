fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if core_is_odd(g.n) {
		gold_fail(g, "cannot pair merge odd list length");
		out.ok = false;
		out.s.clear();
		out.s.append("odd list length error");
		return out;
	}
	let pairs = g.n / 2;
	for k in pairs {
		g.res[k] = g.res[2 * k] + g.res[2 * k + 1];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	out.s.append("merged adjacent pairs in place");
	out
}
@end
