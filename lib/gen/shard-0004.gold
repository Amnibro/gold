code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		g.n = 0;
		return out;
	}
	var count = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		var sign = 0;
		if diff > 0 { sign = 1; }
		else if diff < 0 { sign = -1; }
		g.res[count] = sign;
		count += 1;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized steps: ", count);
	out
}
@end
