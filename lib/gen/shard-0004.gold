code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "max gap 0");
		return out;
	}
	var max_gap = 0;
	for k in 1..g.n {
		let d1 = g.res[k];
		let d0 = g.res[k - 1];
		let diff = if d1 > d0 { d1 - d0 } else { d0 - d1 };
		if diff > max_gap {
			max_gap = diff;
		}
	}
	out.i = max_gap;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "max gap ", max_gap);
	out
}
@end
