fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prod = 1;
	var found = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			prod *= g.res[i];
			g.res[i] = prod;
			found++;
		}
	}
	out.i = prod;
	g.steps += g.n + 1;
	if found == 0 {
		out.s.clear();
		format(out.s, "no odd numbers mapped");
	} else {
		out.s.clear();
		format(out.s, "running odd product ", prod);
	}
	out
}
