phrase: run space collapse between tokens using {delim}
phrase: replace inner spaces between words with {delim}
slot: delim text
test: text="alpha   beta   gamma" delim="-"
expect: => i=16 r=0.0 ok=true s="alpha-beta-gamma" errors=0 n=0 res=[] cache=0 hits=0
test: text="one  two three" delim=":"
expect: => i=13 r=0.0 ok=true s="one:two:three" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[..200] = "";
	var in_space = false;
	for c in out.s {
		if c == ' ' {
			in_space = true;
		} else {
			if in_space && buf.len > 0 {
				for d in ${delim} {
					if buf.len < 195 { buf.push(d); }
				}
			}
			if buf.len < 195 { buf.push(c); }
			in_space = false;
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	out.s.append(buf);
	out.i = buf.len;
	out
}
@end
