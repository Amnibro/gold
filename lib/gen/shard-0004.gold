	if ${p}(g.res[0]) {
		g.res[0] = ${f}(g.res[0]);
		out.s.clear();
		out.s.append("applied function to head");
	} else {
		gold_fail(g, "head element failed predicate");
		out.s.clear();
		out.s.append("predicate failed on head");
	}
	g.steps++;
	out.i = g.res[0];
	out
}
