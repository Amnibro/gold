fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let d = ${offset};
    let thresh = 20;
    var count = 0;
    for i in g.n {
        if g.res[i] >= thresh {
            g.res[i] = g.res[i] + d;
            count++;
        }
    }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "shifted ", count, " threshold items");
    out
}
