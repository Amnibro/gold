fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	var i = 0;
	var cached = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= min_l {
			gold_cache_put(g, g.res[i], run_len);
			cached++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " qualifying runs");
	out
}
@end
