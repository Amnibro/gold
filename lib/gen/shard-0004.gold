@entry 5bdd744d871b1aa2
kind: step
verb: fold
noun: function
modifier: safely
context: stats
phrase: fold sample distribution safely with scale factor {scale}
phrase: combine statistical moments safely using scaling {scale}
slot: scale int
test: list=10,20,30 scale=2
expect: => i=120 r=40.0 ok=true s="safely folded stat sum 120" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15,25 scale=3
expect: => i=135 r=45.0 ok=true s="safely folded stat sum 135" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var acc = 0;
	var safe_count = 0;
	for i in g.n {
		let val = g.res[i];
		let scaled = val * sc;
		if scaled >= 0 {
			acc += scaled;
			safe_count++;
		} else {
			acc -= scaled;
			safe_count++;
		}
	}
	out.i = acc;
	out.r = (acc as real) / (g.n as real);
	out.ok = safe_count > 0;
	out.s.clear();
	format(out.s, "safely folded stat sum ", acc);
	g.steps += safe_count;
	out
}
@end
@entry b582ed18fbdd33ee
kind: step
verb: clamp
noun: errors
modifier: with_retry
context: stats
phrase: clamp statistical residuals under tolerance {tol} across {retries} retries
phrase: restrict distribution errors within bound {tol} with {retries} attempts
slot: tol int
slot: retries int
test: list=15,-20,5,30,-5 tol=10 retries=2
expect: => i=3 r=0.0 ok=true s="clamped statistical errors count 3" errors=0 n=5 res=[10,-10,5,10,-5] cache=0 hits=0
test: list=2,-3,4,-5 tol=10 retries=2
expect: => i=0 r=0.0 ok=false s="clamped statistical errors count 0" errors=0 n=4 res=[2,-3,4,-5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${tol};
	let max_r = ${retries};
	var passes = 0;
	var clamped_total = 0;
	while passes < max_r {
		var round_clamped = 0;
		for i in g.n {
			if g.res[i] > limit {
				g.res[i] = limit;
				round_clamped++;
			} else if g.res[i] < -limit {
				g.res[i] = -limit;
				round_clamped++;
			}
		}
		clamped_total += round_clamped;
		passes++;
		if round_clamped == 0 {
			break;
		}
	}
	out.i = clamped_total;
	out.ok = clamped_total > 0;
	out.s.clear();
	format(out.s, "clamped statistical errors count ", clamped_total);
	g.steps += passes * g.n + 1;
	out
}
@end
