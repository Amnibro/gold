fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_p};
	let hi = ${max_p};
	var cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi && core_is_prime(x) {
			cnt++;
		}
	}
	g.steps += g.n;
	out.i = cnt;
	out.s.clear();
	format(out.s, "primes in sort range: ", cnt);
