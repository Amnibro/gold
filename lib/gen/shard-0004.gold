expect: => i=1 r=0.0 ok=true s="grouped lines: 1" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	let w = words(out.s);
	var line_cnt = 0;
	var cur_len = 0;
	for word in w {
		if cur_len == 0 {
			cur_len = word.len;
			line_cnt += 1;
		} else if cur_len + 1 + word.len <= limit {
			cur_len += 1 + word.len;
		} else {
			cur_len = word.len;
			line_cnt += 1;
		}
	}
	g.steps += line_cnt;
	out.i = line_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped lines: ", line_cnt);
	out
}
@end
