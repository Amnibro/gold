expect: => i=0 r=0.0 ok=true s="no digits" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_digit(b byte) bool {
	b >= '0' as byte && b <= '9' as byte
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i + 1 < out.s.len {
		if ${ID}_is_digit(out.s[i]) && ${ID}_is_digit(out.s[i + 1]) {
			let tmp = out.s[i];
			out.s[i] = out.s[i + 1];
			out.s[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += out.s.len + 1;
	out.i = swaps;
	out
}
@end
