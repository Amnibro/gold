code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let target = ${needle};
    var found_idx = -1;
    for i in g.n {
        if g.res[i] == target {
            found_idx = i;
            break;
        }
    }
    g.steps += if found_idx >= 0 { found_idx + 1 } else { g.n };
    out.i = found_idx;
    out.ok = (found_idx >= 0);
    out.s.clear();
    format(out.s, "matched at index ", found_idx);
    out
}
@end
@entry c27b6f6336b39f7d
kind: step
verb: drop
noun: average
modifier: times
context: core
phrase: drop below average items count {rounds} times
phrase: remove sub average entries repeating {rounds} cycles
slot: rounds int
test: list=10,20,30,40,50 rounds=1
expect: => i=2 r=0.0 ok=true s="dropped 2 below average items" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,10,20,30 rounds=2
expect: => i=4 r=0.0 ok=true s="dropped 4 below average items" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let cycles = ${rounds};
    var dropped = 0;
    for c in cycles {
        if g.n == 0 { break; }
        var sum = 0;
        for i in g.n { sum += g.res[i]; }
        let avg = sum / g.n;
        var kept = 0;
        for i in g.n {
            if g.res[i] >= avg {
                g.res[kept] = g.res[i];
                kept++;
            } else {
                dropped++;
            }
        }
        g.n = kept;
    }
    g.steps += g.n + dropped;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " below average items");
    out
}
@end
@entry 3fad85a4361c5da8
