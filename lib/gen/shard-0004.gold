				g.res[j] = g.res[j+1];
				g.res[j+1] = t;
			}
			j++;
		}
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted numbers minimum ", g.res[0]);
	out
}
