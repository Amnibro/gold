test: list=10,20,30 max_limit=100
expect: => i=60 r=0.0 ok=true s="total tested for swap 60" errors=0 n=3 res=[30,20,10] cache=0 hits=0
test: list=40,50 max_limit=50
expect: => i=90 r=0.0 ok=true s="total tested for swap 90" errors=0 n=2 res=[40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum <= ${max_limit} {
		let tmp = g.res[0];
		g.res[0] = g.res[g.n - 1];
		g.res[g.n - 1] = tmp;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "total tested for swap ", sum);
	out
}
@end
