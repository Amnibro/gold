@entry 2368c0fe4e90b965
kind: step
verb: reverse
noun: window
modifier: between
context: retry
phrase: reverse retry window between positions {start} to {stop}
phrase: invert window elements between indices {start} to {stop}
slot: start int
slot: stop int
test: list=1,2,3,4,5 start=1 stop=3
expect: => i=5 r=0.0 ok=true s="reversed window between: 5" errors=0 n=5 res=[1,4,3,2,5] cache=0 hits=0
test: list=10,20 start=0 stop=1
expect: => i=2 r=0.0 ok=true s="reversed window between: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${stop};
	if s < 0 { s = 0; }
	if e >= g.n { e = g.n - 1; }
	if s >= e || g.n == 0 {
		gold_fail(g, "invalid window range");
		out.ok = false;
		return out;
	}
	while s < e {
		let t = g.res[s];
		g.res[s] = g.res[e];
		g.res[e] = t;
		s++;
		e--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed window between: ", g.n);
	out
}
@end
