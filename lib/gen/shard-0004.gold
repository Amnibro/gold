fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${k};
    let pairs = if limit < g.n - 1 { limit } else { g.n - 1 };
    var total_gap = 0;
    for i in pairs {
        let diff = g.res[i + 1] - g.res[i];
        total_gap += if diff < 0 { -diff } else { diff };
    }
    g.steps += pairs;
    out.i = total_gap;
    out.s.clear();
    format(out.s, "summed ", pairs, " gaps to ", total_gap);
    out
}
@end
