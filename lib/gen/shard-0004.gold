test: list=1,5,6,12
expect: => i=1 r=0.0 ok=true s="swapped gaps with cache" errors=0 n=4 res=[1,5,6,12] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	if g.n > 1 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			gold_cache_put(g, i, diff);
		}
		var i = 0;
		while i + 1 < g.n - 1 {
			let g1, _ = gold_cache_get(g, i);
			let g2, _ = gold_cache_get(g, i + 1);
			gold_cache_put(g, i, g2);
			gold_cache_put(g, i + 1, g1);
			count++;
			i += 2;
		}
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	out.s.append("swapped gaps with cache");
	out
}
@end
