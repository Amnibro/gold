@entry 18d4e9915b7d2bfe
kind: step
verb: cache
noun: duplicates
modifier: with_retry
context: retry
phrase: cache duplicates with retry count {retries}
phrase: record duplicate items with retry limit {retries}
slot: retries int
test: list=2,3,2,5,3 retries=2
expect: => i=2 r=0.0 ok=true s="cached 2 duplicates" errors=0 n=5 res=[2,3,2,5,3] cache=2 hits=0
test: list=1,2,3 retries=2
expect: => i=0 r=0.0 ok=false s="error: no duplicates" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if r <= 0 {
		gold_fail(g, "retry count must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid retries");
		return out;
	}
	var dups = 0;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] == g.res[j] {
				gold_cache_put(g, dups, g.res[i]);
				dups++;
				break;
			}
		}
	}
	if dups == 0 {
		gold_fail(g, "no duplicate elements found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no duplicates");
		return out;
	}
	g.steps += dups;
	out.i = dups;
	out.s.clear();
	format(out.s, "cached ", dups, " duplicates");
	out
}
@end
@entry 66611cec92672738
kind: step
verb: fill
noun: step
modifier: pairwise
context: retry
phrase: fill step pairwise using delta {delta}
phrase: interpolate pairwise steps by delta {delta}
slot: delta int
test: list=2,6,10 delta=2
expect: => i=2 r=0.0 ok=true s="filled pairwise steps by 2" errors=0 n=3 res=[4,8,10] cache=0 hits=0
test: list=5 delta=2
expect: => i=0 r=0.0 ok=false s="error: too few items" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	if d <= 0 {
		gold_fail(g, "delta must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid delta");
		return out;
	}
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	for i in g.n - 1 {
		g.res[i] += d;
	}
	g.steps += g.n;
	out.i = d;
	out.s.clear();
	format(out.s, "filled pairwise steps by ", d);
	out
}
@end
@entry 004982d709d7e744
kind: step
verb: dedupe
noun: memo
modifier: pairwise
context: stats
phrase: dedupe pairwise memo values across sample window
phrase: collapse adjacent duplicate memo entries in sample distribution
test: list=10,10,20,30,30,30,40
expect: => i=3 r=0.0 ok=true s="pairwise duplicates removed 3" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,10,15,20
expect: => i=0 r=0.0 ok=false s="pairwise duplicates removed 0" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.ok = true;
		return out;
	}
	var write_idx = 1;
	var dup_pairs = 0;
	var read_idx = 1;
	while read_idx < g.n {
		if g.res[read_idx] == g.res[read_idx - 1] {
			dup_pairs++;
		} else {
			g.res[write_idx] = g.res[read_idx];
			write_idx++;
		}
		read_idx++;
	}
	g.n = write_idx;
	out.i = dup_pairs;
	out.ok = dup_pairs > 0;
	out.s.clear();
	format(out.s, "pairwise duplicates removed ", dup_pairs);
	g.steps += read_idx;
	out
}
@end
@entry a9721b54786a67cb
kind: step
verb: search
noun: loop
modifier: first
context: stats
phrase: search for first repeated observation in sample distribution
phrase: find first recurrent value loop within sample sequence
test: list=12,24,36,24,50
expect: => i=24 r=0.0 ok=true s="first repeated value found 24" errors=0 n=5 res=[12,24,36,24,50] cache=0 hits=0
test: list=10,20,30,40
expect: => i=0 r=0.0 ok=false s="no repeating loop found in samples" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var loop_val = 0;
	var first_idx = -1;
	var i = 0;
	while i < g.n && !found {
		var j = i + 1;
		while j < g.n && !found {
			if g.res[i] == g.res[j] {
				found = true;
				loop_val = g.res[i];
				first_idx = i;
			}
			j++;
		}
		i++;
	}
	out.i = loop_val;
	out.ok = found;
	out.s.clear();
	if found {
		format(out.s, "first repeated value found ", loop_val);
	} else {
		format(out.s, "no repeating loop found in samples");
	}
	g.steps += i;
	out
}
@end
@entry 4c4f1436d47a0017
kind: step
verb: filter
noun: evens
modifier: each
context: stats
phrase: filter even observations scaling each by factor {factor}
phrase: retain even statistics multiplying each entry by {factor}
slot: factor int
test: list=2,5,8,11,14 factor=3
expect: => i=3 r=0.0 ok=true s="filtered even entries scaled 3" errors=0 n=3 res=[6,24,42] cache=0 hits=0
test: list=1,3,5 factor=3
expect: => i=0 r=0.0 ok=false s="filtered even entries scaled 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var write_idx = 0;
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			g.res[write_idx] = x * mult;
			write_idx++;
			matched++;
		}
	}
	g.n = write_idx;
	out.i = matched;
	out.ok = matched > 0;
	out.s.clear();
	format(out.s, "filtered even entries scaled ", matched);
	g.steps += g.n + 1;
	out
}
@end
@entry 25f56ab549ccb0c5
kind: step
verb: clamp
noun: duplicates
modifier: nested
context: stats
phrase: clamp duplicate sample occurrences to limit {cap}
phrase: restrict duplicate metric occurrences under threshold {cap}
slot: cap int
test: list=5,5,5,5,8,8 cap=2
expect: => i=2 r=0.0 ok=true s="nested duplicates clamped 2" errors=0 n=6 res=[5,5,0,0,8,8] cache=0 hits=0
test: list=1,2,3,4 cap=2
expect: => i=0 r=0.0 ok=false s="nested duplicates clamped 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_dup = ${cap};
	var clamped_dups = 0;
	for i in g.n {
		var count = 0;
		for j in i {
			if g.res[j] == g.res[i] {
				count++;
			}
		}
		if count >= max_dup {
			g.res[i] = 0;
			clamped_dups++;
		}
	}
	out.i = clamped_dups;
	out.ok = clamped_dups > 0;
	out.s.clear();
	format(out.s, "nested duplicates clamped ", clamped_dups);
	g.steps += g.n * g.n;
	out
}
@end
@entry e29e86f37f24ac41
kind: step
verb: search
noun: results
modifier: last
context: stats
phrase: search for last sample result exceeding cutoff {cutoff}
phrase: locate final observation result above threshold {cutoff}
slot: cutoff int
test: list=10,45,20,60,15 cutoff=30
expect: => i=60 r=0.0 ok=true s="last result above cutoff found at 3" errors=0 n=5 res=[10,45,20,60,15] cache=0 hits=0
test: list=5,12,18 cutoff=30
expect: => i=0 r=0.0 ok=false s="no results found exceeding cutoff" errors=0 n=3 res=[5,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${cutoff};
	var last_pos = -1;
	var last_val = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > bound {
			last_pos = i;
			last_val = g.res[i];
		}
		i++;
	}
	out.i = last_val;
	out.ok = last_pos >= 0;
	out.s.clear();
	if last_pos >= 0 {
		format(out.s, "last result above cutoff found at ", last_pos);
	} else {
		format(out.s, "no results found exceeding cutoff");
	}
	g.steps += g.n + 1;
	out
}
@end
@entry 51400432c13bfb52
kind: step
verb: filter
noun: maximum
modifier: none
context: stats
phrase: filter peak values leaving none of maximum outliers
phrase: remove maximum distribution outliers preserving remaining values
test: list=10,50,30,50,20
expect: => i=50 r=0.0 ok=true s="removed maximum outliers count 2" errors=0 n=3 res=[10,30,20] cache=0 hits=0
test: list=5,15,25
expect: => i=25 r=0.0 ok=true s="removed maximum outliers count 1" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
		}
	}
	var write_idx = 0;
	var removed = 0;
	for i in g.n {
		if g.res[i] == max_val {
			removed++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	out.i = max_val;
	out.ok = removed > 0;
	out.s.clear();
	format(out.s, "removed maximum outliers count ", removed);
	g.steps += g.n + write_idx;
	out
}
@end
@entry a9c1bc9b6eee2b87
kind: step
verb: join
noun: prefix
modifier: until
context: stats
phrase: join prefix distribution until cumulative sum reaches {cap}
phrase: accumulate prefix statistics until total reaches {cap}
slot: cap int
test: list=10,20,30,40,50 cap=50
expect: => i=60 r=0.0 ok=true s="joined prefix total reached 60" errors=0 n=3 res=[10,30,60] cache=0 hits=0
test: list=5,10,15 cap=100
expect: => i=30 r=0.0 ok=false s="joined prefix total reached 30" errors=0 n=3 res=[5,15,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var prefix_sum = 0;
	var idx = 0;
	while idx < g.n {
		prefix_sum += g.res[idx];
		g.res[idx] = prefix_sum;
		idx++;
		if prefix_sum >= limit {
			break;
		}
	}
	g.n = idx;
	out.i = prefix_sum;
	out.ok = prefix_sum >= limit;
	out.s.clear();
	format(out.s, "joined prefix total reached ", prefix_sum);
	g.steps += idx;
	out
}
@end
@entry e0473e4e6c4e337c
kind: step
verb: clamp
noun: budget
modifier: unique
context: stats
phrase: clamp unique statistical observations under budget {budget}
phrase: restrict unique metric elements to allocation budget {budget}
slot: budget int
test: list=10,20,30,40,50 budget=3
expect: => i=3 r=0.0 ok=true s="budget unique items retained 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=10,20,10,20 budget=3
expect: => i=2 r=0.0 ok=false s="budget unique items retained 2" errors=0 n=4 res=[10,20,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_unique = ${budget};
	var unique_seen = 0;
	var write_idx = 0;
	for i in g.n {
		var seen = false;
		for j in write_idx {
			if g.res[j] == g.res[i] {
				seen = true;
			}
		}
		if !seen {
			if unique_seen < max_unique {
				g.res[write_idx] = g.res[i];
				write_idx++;
				unique_seen++;
			}
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	let dropped = g.n - write_idx;
	g.n = write_idx;
	out.i = unique_seen;
	out.ok = dropped > 0;
	out.s.clear();
	format(out.s, "budget unique items retained ", unique_seen);
	g.steps += g.n + 1;
	out
}
@end
@entry 89b0c9bf480c8a36
kind: step
verb: fold
noun: budget
modifier: all
context: stats
phrase: fold all sample values deducting from budget {total}
phrase: deduct all distribution observations against budget {total}
slot: total int
test: list=15,25,30 total=100
expect: => i=30 r=0.0 ok=true s="budget remaining after folding 30" errors=0 n=3 res=[15,25,30] cache=0 hits=0
test: list=20,40,50 total=50
expect: => i=-60 r=0.0 ok=false s="budget exhausted negative balance -60" errors=0 n=3 res=[20,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${total};
	var processed = 0;
	for i in g.n {
		rem -= g.res[i];
		processed++;
	}
	out.i = rem;
	out.ok = rem >= 0;
	out.s.clear();
	if rem >= 0 {
		format(out.s, "budget remaining after folding ", rem);
	} else {
		format(out.s, "budget exhausted negative balance ", rem);
	}
	g.steps += processed;
	out
}
@end
@entry 2095a5c58d8fe142
kind: step
verb: clamp
noun: words
modifier: in_place
context: stats
phrase: clamp word frequency stats in place between bounds {floor} to {ceil}
phrase: restrict corpus word counts in place from {floor} up to {ceil}
slot: floor int
slot: ceil int
test: list=2,15,50,5,80 floor=10 ceil=40
expect: => i=4 r=0.0 ok=true s="clamped word counts in place 4" errors=0 n=5 res=[10,15,40,10,40] cache=0 hits=0
test: list=12,20,35 floor=10 ceil=40
expect: => i=0 r=0.0 ok=false s="clamped word counts in place 0" errors=0 n=3 res=[12,20,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${floor};
	let c = ${ceil};
	var clamped = 0;
	for k in g.n {
		let x = g.res[k];
		if x < f {
			g.res[k] = f;
			clamped++;
		} else if x > c {
			g.res[k] = c;
			clamped++;
		}
	}
	out.i = clamped;
	out.ok = clamped > 0;
	out.s.clear();
	format(out.s, "clamped word counts in place ", clamped);
	g.steps += g.n;
	out
}
@end
@entry ec44ee03e6205a61
kind: step
verb: rank
noun: text
modifier: first
context: stats
phrase: rank first character metric frequency across text stats
phrase: compute rank of first observation code in text distribution
test: list=65,66,65,67,65,66
expect: => i=1 r=0.0 ok=true s="first text metric rank is 1" errors=0 n=6 res=[65,66,65,67,65,66] cache=0 hits=0
test: list=68,69,69,69,70
expect: => i=4 r=0.0 ok=true s="first text metric rank is 4" errors=0 n=5 res=[68,69,69,69,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	let first_elem = g.res[0];
	var first_freq = 0;
	for i in g.n {
		if g.res[i] == first_elem {
			first_freq++;
		}
	}
	var rank = 1;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] {
				freq++;
			}
		}
		if freq > first_freq {
			rank++;
		}
	}
	out.i = rank;
	out.ok = true;
	out.s.clear();
	format(out.s, "first text metric rank is ", rank);
	g.steps += g.n * g.n;
	out
}
@end
@entry 51cc4872c81d00af
kind: step
verb: search
noun: squares
modifier: running
context: stats
phrase: search for running square values in variance samples
phrase: scan running sample sequence detecting perfect square metrics
test: list=10,16,25,30,49
expect: => i=49 r=0.0 ok=true s="running square metrics count 3" errors=0 n=5 res=[10,16,25,30,49] cache=0 hits=0
test: list=11,15,20,33
expect: => i=0 r=0.0 ok=false s="running square metrics count 0" errors=0 n=4 res=[11,15,20,33] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found_squares = 0;
	var last_square = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x {
				r++;
			}
			if r * r == x {
				found_squares++;
				last_square = x;
			}
		}
	}
	out.i = last_square;
	out.ok = found_squares > 0;
	out.s.clear();
	format(out.s, "running square metrics count ", found_squares);
	g.steps += g.n + 1;
	out
}
@end
