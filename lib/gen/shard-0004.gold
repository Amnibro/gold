fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i-1];
		if diff > 5 {
			g.res[i] = g.res[i-1] + 5;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped step differences count ", clamped);
	out
}
@end
