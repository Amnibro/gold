@entry a6f4c6e7858e2c31
kind: step
verb: shift
noun: duplicates
modifier: last
context: compare
phrase: shift duplicate values to end of series
phrase: move repeated elements to tail positions
test: list=1,2,2,3
expect: => i=1 r=0.0 ok=true s="duplicates shifted: 1" errors=0 n=4 res=[1,2,3,2] cache=0 hits=0
test: list=4,4,5,6
expect: => i=1 r=0.0 ok=true s="duplicates shifted: 1" errors=0 n=4 res=[4,5,6,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var uniq int[512] = [0; 512];
	var dups int[512] = [0; 512];
	var u_count = 0;
	var d_count = 0;
	for i in g.n {
		var is_dup = false;
		for j in u_count {
			if g.res[i] == uniq[j] { is_dup = true; break; }
		}
		if is_dup {
			dups[d_count] = g.res[i];
			d_count += 1;
		} else {
			uniq[u_count] = g.res[i];
			u_count += 1;
		}
	}
	for i in u_count { g.res[i] = uniq[i]; }
	for i in d_count { g.res[u_count + i] = dups[i]; }
	g.steps += g.n;
	out.i = d_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "duplicates shifted: ", d_count);
	out
}
@end
