@entry b8fb802fe25c67e1
kind: step
verb: filter
noun: steps
modifier: with_retry
context: core
phrase: filter high cost steps using retry attempts {max_cost}
phrase: prune step items exceeding cost ceiling {max_cost}
slot: max_cost int
test: list=10,50,20,80,30 max_cost=40
expect: => i=3 r=0.0 ok=true s="retained 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=100,200,300 max_cost=50
expect: => i=0 r=0.0 ok=false s="retained 0" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_cost};
	var w = 0;
	let old_n = g.n;
	for i in 0..old_n {
		if g.res[i] <= ceiling {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = old_n - w;
	if removed > w {
		g.errors++;
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "retained ", w);
	out
}
@end
