test: list=5,3
expect: => i=3 r=0.0 ok=true s="sorted sequence minimum 3" errors=0 n=2 res=[3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence to sort");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty sequence");
		return out;
	}
	for i in g.n {
		var j = 0;
		while j < g.n - 1 {
			if g.res[j] > g.res[j+1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j+1];
				g.res[j+1] = tmp;
			}
			j++;
		}
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "sorted sequence minimum ", g.res[0]);
	out
}
@end
