fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_prime = 0;
	for i in g.n {
		if core_is_prime(g.res[i]) {
			first_prime = g.res[i];
			break;
		}
	}
	if first_prime > 0 {
		for i in g.n {
			if core_is_prime(g.res[i]) {
				g.res[i] -= first_prime;
			}
		}
	}
	g.steps += g.n;
	out.i = first_prime;
	out.s.clear();
	format(out.s, "first prime baseline: ", first_prime);
	out
}
@end
