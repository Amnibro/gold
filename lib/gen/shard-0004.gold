code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		let res = g.res[i] * 2;
		gold_cache_put(g, g.res[i], res);
		total += res;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "function trace cumulative total ", total);
	out
}
@end
