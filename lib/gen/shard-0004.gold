fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	let orig_n = g.n;
	let start = if orig_n > 2 { orig_n - 2 } else { 0 };
	var i = start;
	while i < orig_n {
		let x = g.res[i];
		if x >= 10 && x <= 100 {
			gold_push(g, x);
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
