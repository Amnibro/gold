fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 {
        out.i = 0;
        return out;
    }
    var kept = 1;
    var max_val = g.res[0];
    for i in 1..g.n {
        if g.res[i] >= max_val {
            max_val = g.res[i];
            g.res[kept] = g.res[i];
            kept++;
        }
    }
    let dropped = g.n - kept;
    g.steps += g.n;
    g.n = kept;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " unsorted numbers");
    out
}
