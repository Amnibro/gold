test: list=7,7,7
expect: => i=1 r=0.0 ok=true s="aggregated histogram in reverse" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var t_cnt = 0;
	var i = g.n;
	while i > 0 {
		let x = g.res[i - 1];
		var seen = false;
		for j in t_cnt { if temp[j] == x { seen = true; break; } }
		if !seen {
			temp[t_cnt] = x;
			t_cnt++;
		}
		i--;
	}
	for j in t_cnt {
		let target = temp[j];
		var freq = 0;
		for k in g.n { if g.res[k] == target { freq++; } }
		g.res[j] = freq;
	}
	g.n = t_cnt;
	g.steps += g.n;
	out.i = t_cnt;
	out.s.clear();
	out.s.append("aggregated histogram in reverse");
	out
}
@end
