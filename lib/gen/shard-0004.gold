fn ${ID}_is_alpha(b byte) bool {
	(b >= 'a' as byte && b <= 'z' as byte) || (b >= 'A' as byte && b <= 'Z' as byte)
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var filtered byte[..200] = [];
	var i = 0;
	while i + 1 < out.s.len {
		if ${ID}_is_alpha(out.s[i]) && ${ID}_is_alpha(out.s[i + 1]) {
			filtered.push(out.s[i]);
			filtered.push(out.s[i + 1]);
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += out.s.len + 1;
	out.s.clear();
	format(out.s, filtered);
	out.i = out.s.len;
	out
}
@end
