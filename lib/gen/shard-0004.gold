fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lim};
	var count = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			let sum = g.res[k] + g.res[k + 1];
			if sum <= l {
				gold_cache_put(g, k, sum);
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "cached ", count, " pairs within limit");
	out
}
