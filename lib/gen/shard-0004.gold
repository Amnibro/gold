slot: max_sum int
test: list=10,20,30,40 max_sum=50
expect: => i=2 r=0.0 ok=true s="10+20" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=100 max_sum=50
expect: => i=0 r=0.0 ok=true s="empty join under cap" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var running = 0;
	var count = 0;
	out.s.clear();
	for i in g.n {
		let x = g.res[i];
		if running + x > ms { break; }
		running += x;
		gold_cache_put(g, i, running);
		if count > 0 { out.s.push('+'); }
		format(out.s, x);
		count++;
	}
