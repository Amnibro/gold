fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg_i = sum / g.n;
	let avg_r = (sum as real) / (g.n as real);
	gold_cache_put(g, 0, avg_i);
	g.steps += g.n;
	out.i = avg_i;
	out.r = avg_r;
	out.s.clear();
	out.s.append("cached running average");
	out
}
