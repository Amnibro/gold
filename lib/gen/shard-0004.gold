	for i in g.n {
		let k = g.res[i];
		let cached, ok = gold_cache_get(g, k);
		if ok {
			g.res[i] = cached;
		} else {
			let res = ${f}(k);
			gold_cache_put(g, k, res);
			g.res[i] = res;
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	out.s.append("applied sequence with cache");
	out
}
@end
