fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let pairs = g.n / 2;
	var count = 0;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		if a * b <= limit { count++; }
	}
	g.steps += pairs;
	out.i = count;
	out.s.clear();
	out.s.append("found pairs under product limit");
	out
}
