code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid = g.n / 2;
		if g.res[mid - 1] > g.res[mid] {
			let t = g.res[mid - 1];
			g.res[mid - 1] = g.res[mid];
			g.res[mid] = t;
		}
	}
	g.steps += 3;
	out.i = g.res[g.n / 2];
	out.s.clear();
	format(out.s, "swapped middle inversion: ", out.i);
	out
}
@end
