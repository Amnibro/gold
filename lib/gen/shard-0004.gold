fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	var total = 0;
	for i in g.n {
		let inner = g.res[i] * mult;
		total += inner;
		g.res[i] = inner;
	}
	g.steps += g.n + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "nested fold total ", total);
