fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var w = ${win_len};
	if w > g.n { w = g.n; }
	if w >= 2 {
		let tmp = g.res[0];
		g.res[0] = g.res[w - 1];
		g.res[w - 1] = tmp;
	}
	g.steps += w;
	out.i = w;
	out.s.clear();
	format(out.s, "swapped window endpoints of size ", w);
	out
}
@end
