code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var uniq = 0;
	for i in g.n {
		var matches = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { matches++; }
		}
		if matches == 1 && !found {
			uniq = g.res[i];
			found = true;
		}
	}
	g.steps += g.n;
	if found {
		out.i = uniq;
		gold_push(g, uniq);
		out.s.clear();
		format(out.s, "found unique element ", uniq);
	} else {
		out.i = -1;
		out.s.clear();
		format(out.s, "no unique element found");
	}
	out
}
@end
