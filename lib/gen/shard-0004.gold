fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let k = ${lim};
    if k <= 0 {
        gold_fail(g, "non-positive prefix limit");
        out.ok = false;
        return out;
    }
    let actual_lim = if k < out.s.len { k } else { out.s.len };
    var count = 0;
    var idx = 0;
    while idx < actual_lim {
        let code = out.s[idx] as int;
        gold_push(g, code);
        count++;
        idx += 2;
    }
    g.steps += count;
    out.i = count;
    out.s.clear();
    format(out.s, "found ", count, " alternating head bytes");
    out
}
