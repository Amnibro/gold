phrase: pair items having tally up to limit {cap}
slot: cap int
test: list=1,1,2,2,3,3,3 cap=2
expect: => i=2 r=0.0 ok=true s="paired elements by tally threshold" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,6,7,7 cap=1
expect: => i=0 r=0.0 ok=true s="paired elements by tally threshold" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tally = ${cap};
	var temp = [0; 512];
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq <= max_tally {
			temp[kept] = x;
			kept++;
		}
	}
	let pair_len = (kept / 2) * 2;
	for i in pair_len { g.res[i] = temp[i]; }
	g.n = pair_len;
	g.steps += pair_len + 1;
	out.i = pair_len / 2;
	out.s.clear();
	out.s.append("paired elements by tally threshold");
	out
}
@end
