@entry a980824de9f7303a
kind: step
verb: group
noun: item
modifier: any
context: filter
phrase: group item matching any of first {count}
phrase: filter items appearing in initial {count}
slot: count int
test: list=1,2,3,2,1,5,4 count=2
expect: => i=4 r=0.0 ok=true s="filtered items matching initial set" errors=0 n=4 res=[1,2,2,1] cache=0 hits=0
test: list=10,20,30,10 count=1
expect: => i=2 r=0.0 ok=true s="filtered items matching initial set" errors=0 n=2 res=[10,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n == 0 { return out; }
	var valid_cnt = if c > g.n { g.n } else { c };
	var temp int[512] = [0; 512];
	for i in valid_cnt { temp[i] = g.res[i]; }
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var matched = false;
		for j in valid_cnt {
			if temp[j] == x {
				matched = true;
				break;
			}
		}
		if matched {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered items matching initial set");
	out
}
@end
