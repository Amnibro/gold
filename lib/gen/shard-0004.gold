fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let rounds = ${depth};
    for i in g.n {
        var x = g.res[i];
        for r in rounds {
            x = ${f}(x);
        }
        g.res[i] = x;
    }
    g.steps += g.n * rounds;
    out.i = g.n;
    out.s.clear();
    format(out.s, "recursively applied across ", g.n, " items");
    out
}
@end
