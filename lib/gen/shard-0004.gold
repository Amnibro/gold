fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			if g.res[i - 1] > g.res[i] {
				let t = g.res[i - 1]; g.res[i - 1] = g.res[i]; g.res[i] = t;
				swaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "single pass swaps ", swaps);
	out
}
