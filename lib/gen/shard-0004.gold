			if kc < 64 { kept[kc] = g.res[i]; kc++; }
		}
	}
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kc;
	out.s.clear();
	format(out.s, "filtered history count ", kc);
	out
}
