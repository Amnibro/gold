code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let orig_n = g.n;
	var added = 0;
	for i in orig_n {
		let x = g.res[i];
		if x >= th && ${ID}_is_prime(x) && g.n < 512 {
			gold_push(g, x);
			added++;
		}
	}
	g.steps += g.n + 1;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated ", added, " prime items");
	out
}
@end
