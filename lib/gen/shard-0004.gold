code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bud = ${budget};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var taken = 0;
	var cost = 0;
	while taken < g.n && cost + g.res[taken] <= bud {
		cost += g.res[taken];
		taken++;
	}
	g.n = taken;
	g.steps += g.n + 1;
	out.i = cost;
	out.s.clear();
	format(out.s, "ranked ", taken, " items cost ", cost);
	out
}
@end
