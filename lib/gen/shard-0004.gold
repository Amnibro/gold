code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let reps = ${times};
	var tmp int[512] = [0; 512];
	var w = 0;
	for i in 0..g.n {
		let x = g.res[i];
		if x >= lo && x <= hi && reps > 0 {
			for _ in 0..reps {
				if w < 512 { tmp[w] = x; w++; }
			}
		} else {
			if w < 512 { tmp[w] = x; w++; }
		}
	}
	for i in 0..w { g.res[i] = tmp[i]; }
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "expanded ", w);
	out
}
@end
