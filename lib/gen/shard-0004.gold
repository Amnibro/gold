fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	out.s.clear();
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			gold_cache_put(g, count, x);
			if count > 0 { out.s.push(','); }
			format(out.s, x);
			count++;
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	if count == 0 { format(out.s, "none in range"); }
