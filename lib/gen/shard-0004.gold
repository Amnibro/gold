		if x < 0 {
			gold_fail(g, "negative number cannot be square");
			out.ok = false;
		} else if core_is_square(x) {
			sq_count++;
		}
	}
	g.steps += g.n;
	out.i = sq_count;
	out.s.clear();
	format(out.s, "scanned any squares: ", sq_count);
	out
}
