@entry 63f3aacace85af7c
kind: step
verb: compare
noun: spaces
modifier: at_least
context: filter
phrase: compare spaces keeping words at least {min_chars}
phrase: filter words separated by spaces at least {min_chars}
slot: min_chars int
test: text="a big elephant" min_chars=3
expect: => i=2 r=0.0 ok=true s="big elephant" errors=0 n=0 res=[] cache=0 hits=0
test: text="it is on" min_chars=3
expect: => i=0 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_c = ${min_chars};
	var res_s byte[..200] = "";
	var w_start = 0;
	var kept_words = 0;
	while w_start < out.s.len {
		while w_start < out.s.len && out.s[w_start] == ' ' {
			w_start++;
		}
		if w_start >= out.s.len { break; }
		var w_end = w_start;
		while w_end < out.s.len && out.s[w_end] != ' ' {
			w_end++;
		}
		let len = w_end - w_start;
		if len >= min_c {
			if kept_words > 0 { res_s.push(' '); }
			for k in w_start..w_end {
				res_s.push(out.s[k]);
			}
			kept_words++;
		}
		w_start = w_end;
	}
	out.s = res_s;
	g.steps += 1;
	out.i = kept_words;
	out
}
@end
