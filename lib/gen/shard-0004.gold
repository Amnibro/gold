@entry 7fa1a17314e0600a
kind: step
verb: dedupe
noun: head
modifier: recursively
context: cache
phrase: dedupe head elements recursively into cache
phrase: remove matching head duplicates recursively with cache lookup
test: list=3,3,3,5,6
expect: => i=2 r=0.0 ok=true s="deduped 2 recursive head items" errors=0 n=3 res=[3,5,6] cache=1 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="deduped 0 recursive head items" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for head dedupe");
		return out;
	}
	let head_val = g.res[0];
	gold_cache_put(g, 0, head_val);
	var w = 1;
	var removed = 0;
	for i in 1..g.n {
		if g.res[i] == head_val {
			removed++;
		} else {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " recursive head items");
	out
}
@end
