kind: step
verb: drop
noun: pairs
modifier: at_least
context: text
phrase: drop duplicate character pairs with distance at least {min_dist}
phrase: remove adjacent character pairs at least {min_dist} apart
slot: min_dist int
test: text="azbycx" min_dist=20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
test: text="abcdef" min_dist=5
expect: => i=0 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let thresh = ${min_dist};
    if thresh <= 0 {
        gold_fail(g, "non-positive distance");
        out.ok = false;
        return out;
    }
    var res byte[..200] = "";
    var dropped = 0;
    var idx = 0;
    while idx < out.s.len {
        if idx + 1 < out.s.len {
            let diff = core_abs_val((out.s[idx + 1] as int) - (out.s[idx] as int));
            if diff >= thresh {
                dropped++;
                idx += 2;
                continue;
            }
        }
        if res.len < 200 { res.push(out.s[idx]); }
        idx++;
    }
    g.steps += out.s.len;
    out.i = dropped;
    out.s.clear();
    for b in res { out.s.push(b); }
    out
}
@end
