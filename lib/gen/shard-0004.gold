@entry a1d5b474d94d42b1
kind: step
verb: shift
noun: streak
modifier: between
context: transform
phrase: shift streak between length {lo} to {hi}
phrase: adjust streak between limits {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,3,5,5,5 lo=2 hi=2
expect: => i=2 r=0.0 ok=true s="shifted streak between limits" errors=0 n=5 res=[6,6,5,5,5] cache=0 hits=0
test: list=1,1,1,2,2 lo=3 hi=4
expect: => i=3 r=0.0 ok=true s="shifted streak between limits" errors=0 n=5 res=[2,2,2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var modified = 0;
	var start = 0;
	while start < g.n {
		var end = start + 1;
		while end < g.n && g.res[end] == g.res[start] {
			end++;
		}
		let len = end - start;
		if len >= low && len <= high {
			for k in len {
				g.res[start + k] *= 2;
			}
			modified += len;
		}
		start = end;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	out.s.append("shifted streak between limits");
	out
}
@end
