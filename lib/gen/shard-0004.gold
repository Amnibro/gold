code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${stop_val};
	var count = 0;
	while count < g.n && g.res[count] != target {
		count++;
	}
	if count < g.n {
		gold_fail(g, "hit error marker value");
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " numbers until stop");
	out
}
@end
