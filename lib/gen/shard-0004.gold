expect: => i=2 r=0.0 ok=true s="multiplied 2 duplicate pairs" errors=0 n=5 res=[4,0,4,0,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var count = 0;
    var i = 0;
    while i + 1 < g.n {
        if g.res[i] == g.res[i + 1] {
            g.res[i] = g.res[i] * g.res[i + 1];
            g.res[i + 1] = 0;
            count++;
            i += 2;
        } else {
            i++;
        }
    }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "multiplied ", count, " duplicate pairs");
    out
}
@end
