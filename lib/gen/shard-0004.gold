	b == 'a' as byte || b == 'e' as byte || b == 'i' as byte || b == 'o' as byte || b == 'u' as byte
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_vowels};
	var vowels byte[..200] = [];
	for i in out.s.len {
		if ${ID}_is_vowel(out.s[i]) && vowels.len < limit {
			vowels.push(out.s[i]);
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	format(out.s, vowels);
	out.i = out.s.len;
	out
}
@end
