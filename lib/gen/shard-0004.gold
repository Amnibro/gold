fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_idx = 0;
	for k in 1..g.n {
		if g.res[k] < g.res[min_idx] { min_idx = k; }
	}
	let min_val = g.res[min_idx];
	for i in min_idx..g.n - 1 {
		g.res[i] = g.res[i + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "filtered minimum: ", min_val);
	out
}
@end
