fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var sum = 0;
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			g.res[count] = g.res[i];
			sum += g.res[i];
			count += 1;
		}
	}
	g.n = count;
	g.steps += count;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "merged sum: ", sum);
	out
}
@end
@entry 9239172a9657035d
kind: step
verb: check
noun: duplicates
modifier: any
context: stats
phrase: check if series contains any duplicate observations
phrase: verify presence of duplicate entries
test: list=1,2,3,2,5
expect: => i=1 r=0.0 ok=true s="duplicates found" errors=0 n=5 res=[1,2,3,2,5] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=false s="no duplicates" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dup = false;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] == g.res[j] {
					has_dup = true;
					break;
				}
			}
			if has_dup { break; }
		}
	}
	g.steps += g.n;
	out.ok = has_dup;
	out.i = if has_dup { 1 } else { 0 };
	out.s.clear();
	if has_dup {
		format(out.s, "duplicates found");
	} else {
		format(out.s, "no duplicates");
	}
	out
}
@end
@entry 42b9ea39fa36e18b
kind: step
verb: select
noun: prefix
modifier: safely
context: stats
phrase: select initial prefix of {count} points safely
phrase: extract leading sample prefix of size {count}
slot: count int
test: list=10,20,30,40 count=2
expect: => i=2 r=0.0 ok=true s="prefix size: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15 count=5
expect: => i=2 r=0.0 ok=true s="prefix size: 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var target = c;
	if target > g.n { target = g.n; }
	if target < 0 { target = 0; }
	g.n = target;
	g.steps += target;
	out.i = target;
	out.ok = true;
	out.s.clear();
	format(out.s, "prefix size: ", target);
	out
}
@end
@entry e5e427ce9116e0e2
kind: step
verb: scan
noun: results
modifier: with_retry
context: stats
phrase: scan result metrics with retry target {target}
phrase: inspect results list seeking value {target}
slot: target int
test: list=4,8,12,16 target=12
expect: => i=2 r=0.0 ok=true s="found at index: 2" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
test: list=1,2,3 target=9
expect: => i=-1 r=0.0 ok=false s="value not found" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found_idx = -1;
	for i in g.n {
		if g.res[i] == tgt {
			found_idx = i;
			break;
		}
	}
	g.steps += g.n;
	out.ok = (found_idx >= 0);
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found at index: ", found_idx);
	} else {
		format(out.s, "value not found");
	}
	out
}
@end
@entry 343e24763ec97fc1
kind: step
verb: map
noun: limit
modifier: times
context: stats
phrase: clamp observation extremes {times} times
phrase: apply limit capping iteratively {times} times
slot: times int
test: list=50,150,200 times=1
expect: => i=3 r=0.0 ok=true s="clamped count: 3" errors=0 n=3 res=[50,100,100] cache=0 hits=0
test: list=10,20 times=2
expect: => i=2 r=0.0 ok=true s="clamped count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	for rep in t {
		for i in g.n {
			if g.res[i] > 100 { g.res[i] = 100; }
		}
	}
	g.steps += g.n * t;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped count: ", g.n);
	out
}
@end
