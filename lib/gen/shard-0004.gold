expect: => i=2 r=0.0 ok=true s="capped consecutive duplicates" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var temp = [0; 512];
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run = 0;
		while i < g.n && g.res[i] == val {
			if run < limit {
				temp[kept] = val;
				kept++;
				run++;
			}
			i++;
		}
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("capped consecutive duplicates");
	out
}
@end
