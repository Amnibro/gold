fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var rest int[512] = [0; 512];
	var pn = 0;
	var rn = 0;
	for k in g.n {
		let x = g.res[k];
		if core_is_prime(x) { primes[pn] = x; pn++; }
		else { rest[rn] = x; rn++; }
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	for k in rn { gold_push(g, rest[k]); }
	g.steps += g.n;
	out.i = pn;
	out.s.clear();
	format(out.s, "merged ", pn, " primes first");
	out
}
@end
