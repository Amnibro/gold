fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient items for first gap");
		return out;
	}
	let orig_gap = g.res[1] - g.res[0];
	if orig_gap > mg {
		g.res[1] = g.res[0] + mg;
	}
	g.steps += 2;
	out.i = g.res[1] - g.res[0];
	out.s.clear();
	format(out.s, "first gap set to ", out.i);
	out
}
@end
