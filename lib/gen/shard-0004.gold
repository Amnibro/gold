expect: => i=1 r=0.0 ok=true s="shifted min from 1" errors=0 n=3 res=[10,50,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	if min_idx > 0 && g.n > 0 {
		let m = g.res[min_idx];
		var j = min_idx;
		while j > 0 { g.res[j] = g.res[j - 1]; j--; }
		g.res[0] = m;
	}
	g.steps += g.n;
	out.i = min_idx;
	out.s.clear();
	format(out.s, "shifted min from ", min_idx);
	out
}
@end
