test: list=7,39
expect: => i=12 r=0.0 ok=true s="merged last digits into 12" errors=0 n=3 res=[7,39,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for digit merge");
		out.ok = false;
		return out;
	}
	var x = g.res[g.n - 1];
	if x < 0 { x = -x; }
	var dsum = 0;
	while x > 0 {
		dsum += x % 10;
		x /= 10;
	}
	gold_push(g, dsum);
	g.steps += 1;
	out.i = dsum;
	out.s.clear();
	format(out.s, "merged last digits into ", dsum);
	out
}
@end
