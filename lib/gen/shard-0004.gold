slot: min_val int

test: list=2,5,8 factor=2 min_val=10
expect: => i=2 r=0.0 ok=true s="scaled filtered items 2" errors=0 n=2 res=[10,16] cache=0 hits=0
test: list=3,4 factor=3 min_val=10
expect: => i=1 r=0.0 ok=true s="scaled filtered items 1" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${factor};
	let floor_lim = ${min_val};
	var kept = 0;
	for i in g.n {
		let scaled = g.res[i] * mul;
		if scaled >= floor_lim {
			g.res[kept] = scaled;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "scaled filtered items ", kept);
	out
}
@end
