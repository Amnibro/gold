expect: => i=12 r=0.0 ok=true s="recomputed range on last items" errors=0 n=4 res=[15,3,8,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = if ${span} > g.n { g.n } else { ${span} };
	let start = g.n - k;
	var min_val = g.res[start];
	var max_val = g.res[start];
	for i in start..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let diff = max_val - min_val;
	g.steps += k + 1;
	out.i = diff;
	out.s.clear();
	out.s.append("recomputed range on last items");
	out
}
@end
