fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_avg = ${max_avg};
	var sum = 0;
	var count = 0;
	for i in g.n {
		sum += g.res[i];
		count++;
		if sum / count > limit_avg { break; }
	}
	g.steps += count + 1;
	out.i = count;
	out.r = if count > 0 { (sum as real) / (count as real) } else { 0.0 };
	out.s.clear();
	format(out.s, "traced average across ", count, " items");
	out
}
@end
