code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	if g.n < 2 {
		gold_fail(g, "need multiple items to search spaces");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var matches = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= s { matches++; }
		i++;
	}
	g.steps += g.n - 1;
	out.i = matches;
	out.s.clear();
	format(out.s, "found spaces at least threshold ", matches);
	out
}
@end
