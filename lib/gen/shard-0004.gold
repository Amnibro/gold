test: list=4,7,9,12,16
expect: => i=3 r=0.0 ok=true s="dropped 3 square numbers" errors=0 n=2 res=[7,12] cache=0 hits=0
test: list=1,5,10,25
expect: => i=2 r=0.0 ok=true s="dropped 2 square numbers" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}_is_sq(n int) bool {
    if n < 0 { return false; }
    var r = 0;
    while r * r < n { r++; }
    r * r == n
}
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var kept = 0;
    for i in g.n {
        if !${ID}_is_sq(g.res[i]) {
            g.res[kept] = g.res[i];
            kept++;
        }
    }
    let dropped = g.n - kept;
    g.steps += g.n;
    g.n = kept;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " square numbers");
    out
}
@end
