fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = max(1, ${step_size});
	gold_clear(g);
	var cur = 0;
	while cur <= out.i && g.n < 512 {
		gold_push(g, cur);
		cur += sz;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "generated recursive range of ", g.n, " items");
	out
}
