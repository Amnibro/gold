phrase: verify digits fall up to bound {max_d}
slot: max_d int
test: list=12,34,56 max_d=6
expect: => i=0 r=0.0 ok=true s="bad digits count: 0" errors=0 n=3 res=[12,34,56] cache=0 hits=0
test: list=18,29 max_d=7
expect: => i=2 r=0.0 ok=false s="bad digits count: 2" errors=1 n=2 res=[18,29] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_d};
	var bad = 0;
	for k in g.n {
		var x = core_abs_val(g.res[k]);
		while x > 0 {
			if (x % 10) > md { bad++; }
			x /= 10;
		}
	}
	if bad > 0 {
		gold_fail(g, "digit exceeded ceiling bound");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = bad;
	out.s.clear();
	format(out.s, "bad digits count: ", bad);
	out
}
@end
