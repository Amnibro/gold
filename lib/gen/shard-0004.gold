		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid limit");
		return out;
	}
	let target = g.res[0];
	var count = 0;
	for i in lim {
		if g.res[i] == target {
			count++;
		}
	}
	g.steps += lim;
	out.i = count;
	out.s.clear();
	format(out.s, "tallied first occurrences ", count);
	out
}
@end
@entry 507b287f8ed9d889
kind: step
verb: rotate
noun: function
modifier: with_cache
context: retry
phrase: rotate function evaluations using cache with step {shift}
phrase: shift transformed elements with cache by {shift}
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="rotated cached function results by 1" errors=0 n=4 res=[20,30,40,10] cache=4 hits=0
test: list=5,10 shift=-1
expect: => i=0 r=0.0 ok=false s="error: invalid shift" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	if s < 0 || g.n == 0 {
		gold_fail(g, "invalid shift or empty results");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid shift");
		return out;
	}
	for i in g.n {
		let cached, ok = gold_cache_get(g, g.res[i]);
		if !ok {
			gold_cache_put(g, g.res[i], g.res[i] * 2);
		}
	}
	let rot = s % g.n;
	var k = 0;
	while k < rot {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		k++;
	}
	g.steps += g.n + rot;
	out.i = rot;
	out.s.clear();
	format(out.s, "rotated cached function results by ", rot);
	out
}
@end
@entry 86171da0920049f6
kind: step
verb: repeat
noun: odds
modifier: nested
context: retry
phrase: repeat odd values nested within factor {reps}
phrase: duplicate odd retry entries by multiplier {reps}
slot: reps int
test: list=1,2,3 reps=2
expect: => i=5 r=0.0 ok=true s="repeated odd entries to count 5" errors=0 n=5 res=[1,1,2,3,3] cache=0 hits=0
test: list=4,6 reps=2
expect: => i=0 r=0.0 ok=false s="error: no odd entries" errors=1 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	if r <= 0 {
		gold_fail(g, "reps must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid reps");
		return out;
	}
	var new_buf int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		let times = if val % 2 != 0 { r } else { 1 };
		var k = 0;
		while k < times && count < 512 {
			new_buf[count] = val;
			count++;
		k++;
		}
	}
	if count == g.n {
		gold_fail(g, "no odd numbers to repeat");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no odd entries");
		return out;
	}
	gold_clear(g);
	for i in count {
		gold_push(g, new_buf[i]);
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "repeated odd entries to count ", count);
	out
}
@end
