test: list=9,8,7,6,5,4 start_idx=1 end_idx=4
expect: => i=4 r=0.0 ok=true s="sorted range of 4 items" errors=0 n=6 res=[9,5,6,7,8,4] cache=0 hits=0
test: list=1,2,3,4 start_idx=0 end_idx=1
expect: => i=2 r=0.0 ok=true s="sorted range of 2 items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = max(0, ${start_idx});
	let e = min(g.n, ${end_idx} + 1);
	if s >= e || g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "range sort skipped");
		return out;
	}
	for i in s..e {
		for j in (i + 1)..e {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	let span = e - s;
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "sorted range of ", span, " items");
	out
}
@end
@entry 844f221f1cbfc4fb
kind: step
verb: dedupe
noun: text
modifier: in_reverse
context: search
phrase: dedupe query text in reverse order
phrase: eliminate duplicate characters in reverse text
test: text="banana"
expect: => i=3 r=0.0 ok=true s="bna" errors=0 n=0 res=[] cache=0 hits=0
test: text="mississippi"
expect: => i=4 r=0.0 ok=true s="mspi" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen byte[256] = [0; 256];
	var kept byte[>..] = [];
	var idx = out.s.len - 1;
	while idx >= 0 {
		let b = out.s[idx];
		let b_idx = b as! int;
		if seen[b_idx] == 0 {
			seen[b_idx] = 1;
			kept.push(b);
		}
		idx--;
	}
	out.s.clear();
	var k = kept.len - 1;
	while k >= 0 {
		out.s.push(kept[k]);
		k--;
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
@entry 624b13b8af6b40ad
kind: step
verb: fold
noun: sequence
modifier: running
context: search
phrase: fold running sequence differences in search
phrase: calculate running sequence delta over items
test: list=10,25,32,50
expect: => i=40 r=0.0 ok=true s="total running delta 40" errors=0 n=3 res=[15,7,18] cache=0 hits=0
test: list=5,12
expect: => i=7 r=0.0 ok=true s="total running delta 7" errors=0 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "sequence too short for deltas");
		return out;
	}
	var sum_delta = 0;
	var prev = g.res[0];
	for i in 1..g.n {
		let cur = g.res[i];
		let diff = cur - prev;
		sum_delta += diff;
		g.res[i - 1] = diff;
		prev = cur;
	}
	g.n--;
	g.steps += g.n + 1;
	out.i = sum_delta;
	out.s.clear();
	format(out.s, "total running delta ", sum_delta);
	out
}
@end
