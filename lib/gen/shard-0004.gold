fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no range");
		out.ok = false;
		out.s.clear();
		out.s.append("empty list error");
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	let span = max_val - min_val;
	if min_val < 0 {
		gold_fail(g, "negative minimum in range calculation");
	}
	g.steps += g.n;
	out.i = span;
	out.s.clear();
	out.s.append("range evaluated in place");
	out
}
