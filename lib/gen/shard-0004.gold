fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	var kept = 0;
	for i in pairs {
		let val = g.res[2 * i] + g.res[2 * i + 1];
		var seen = false;
		for j in kept {
			if g.res[j] == val { seen = true; }
		}
		if !seen {
			g.res[kept] = val;
			kept++;
		}
	}
	g.steps += pairs;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique pair sums count ", kept);
	out
}
@end
