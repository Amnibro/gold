fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		gold_fail(g, "no tail to merge error");
		out.ok = false;
		return out;
	}
	var sum = 0;
	for k in 1..g.n { sum += g.res[k]; }
	let first = g.res[0];
	gold_clear(g);
	gold_push(g, first);
	gold_push(g, sum);
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged tail any sum: ", sum);
	out
}
@end
