@entry f6947f0cafa4a8c7
kind: step
verb: retry
noun: runs
modifier: any
context: cache
phrase: retry caching runs for any matching sequence
phrase: repeat run cache insertion for any sequence
test: list=5,5,5,2,2
expect: => i=2 r=0.0 ok=true s="runs registered in cache 2" errors=0 n=5 res=[5,5,5,2,2] cache=2 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=true s="runs registered in cache 0" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_stored = 0;
	if g.n > 0 {
		var cur_run = 1;
		for i in 1..g.n {
			if g.res[i] == g.res[i - 1] {
				cur_run++;
			} else {
				if cur_run >= 2 {
					gold_cache_put(g, g.res[i - 1], cur_run);
					run_stored++;
				}
				cur_run = 1;
			}
		}
		if cur_run >= 2 {
			gold_cache_put(g, g.res[g.n - 1], cur_run);
			run_stored++;
		}
	}
	g.steps += g.n;
	out.i = run_stored;
	out.s.clear();
	format(out.s, "runs registered in cache ", run_stored);
	out
}
@end
@entry 07130ff66871151d
kind: step
verb: sort
noun: runs
modifier: last
context: cache
phrase: sort cached runs at the last stage
phrase: order cached run lengths in final pass
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="maximum run length sorted in cache 3" errors=0 n=6 res=[1,1,2,2,2,3] cache=6 hits=0
test: list=4,4,5
expect: => i=5 r=0.0 ok=true s="maximum run length sorted in cache 5" errors=0 n=3 res=[4,4,5] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n { gold_cache_put(g, i, g.res[i]); }
	if g.cn >= 2 {
		for i in g.cn {
			for j in g.cn - 1 {
				if g.cv[j] < g.cv[j + 1] {
					let t = g.cv[j]; g.cv[j] = g.cv[j + 1]; g.cv[j + 1] = t;
				}
			}
		}
	}
	g.steps += g.cn;
	out.i = if g.cn > 0 { g.cv[0] } else { 0 };
	out.s.clear();
	format(out.s, "maximum run length sorted in cache ", out.i);
	out
}
@end
