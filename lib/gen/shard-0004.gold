@entry 64ddec3997132945
kind: step
verb: repeat
noun: head
modifier: all
context: search
phrase: repeat search head all across {times} copies
phrase: duplicate head result all {times} instances
slot: times int
test: list=42,99 times=3
expect: => i=3 r=0.0 ok=true s="repeated head 3 times" errors=0 n=5 res=[42,99,42,42,42] cache=0 hits=0
test: list=7 times=0
expect: => i=0 r=0.0 ok=false s="error: invalid repeat head" errors=1 n=1 res=[7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cnt = ${times};
	if g.n == 0 || cnt <= 0 {
		gold_fail(g, "cannot repeat head of empty search");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid repeat head");
		return out;
	}
	let head_val = g.res[0];
	var added = 0;
	while added < cnt && g.n < 512 {
		gold_push(g, head_val);
		added++;
	}
	g.steps += added;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated head ", added, " times");
	out
}
@end
@entry b74fcf56a1d0811b
kind: step
verb: repeat
noun: gaps
modifier: any
context: search
phrase: repeat gaps any larger than {gap}
phrase: duplicate any gaps exceeding {gap} in series
slot: gap int
test: list=1,10,12,30 gap=8
expect: => i=2 r=0.0 ok=true s="found 2 large gaps" errors=0 n=4 res=[1,10,12,30] cache=0 hits=0
test: list=2,3,4 gap=10
expect: => i=0 r=0.0 ok=true s="found 0 large gaps" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_gap = ${gap};
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "not enough items for gaps");
		return out;
	}
	var gap_count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = abs(g.res[i + 1] - g.res[i]);
		if diff >= min_gap {
			gap_count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = gap_count;
	out.s.clear();
	format(out.s, "found ", gap_count, " large gaps");
	out
}
@end
