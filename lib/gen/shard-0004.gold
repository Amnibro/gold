phrase: test primes up to bound {limit}
slot: limit int
test: list=2,3,4,5,11 limit=10
expect: => i=3 r=0.0 ok=true s="compared primes up to limit" errors=0 n=5 res=[2,3,4,5,11] cache=0 hits=0
test: list=1,4,6,8 limit=20
expect: => i=0 r=0.0 ok=true s="compared primes up to limit" errors=0 n=4 res=[1,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var primes_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= lim && ${ID}_prime(x) {
			primes_count++;
		}
	}
	g.steps += g.n;
	out.i = primes_count;
	out.s.clear();
	out.s.append("compared primes up to limit");
	out
}

fn ${ID}_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
@end
