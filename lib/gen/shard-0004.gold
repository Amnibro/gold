@entry 69ffc91c8ef27318
kind: step
verb: reverse
noun: cache
modifier: recursively
context: stats
phrase: invert order of cached observation metrics
phrase: reverse sequence of values in cache
test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="reversed cache entries: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15
expect: => i=2 r=0.0 ok=true s="reversed cache entries: 2" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 && g.n > 0 {
		for i in g.n {
			gold_cache_put(g, i + 1, g.res[i]);
		}
	}
	if g.cn > 1 {
		for i in (g.cn / 2) {
			let j = g.cn - 1 - i;
			let tmp = g.cv[i];
			g.cv[i] = g.cv[j];
			g.cv[j] = tmp;
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed cache entries: ", g.cn);
	out
}
@end
