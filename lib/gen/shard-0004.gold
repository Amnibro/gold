fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_unique = true;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] == g.res[j] { is_unique = false; }
			}
		}
	}
	if !is_unique {
		gold_fail(g, "duplicate values found");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = if is_unique { 1 } else { 0 };
	out.s.clear();
	format(out.s, "unique condition: ", is_unique);
	out
}
@end
