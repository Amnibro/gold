fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = g.res[k] * g.res[k];
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "squared and sorted");
