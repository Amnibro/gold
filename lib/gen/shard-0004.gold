test: list=9,5,7 factor=3
expect: => i=3 r=0.0 ok=true s="scaled sorted series" errors=0 n=3 res=[15,21,27] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	for i in g.n {
		for j in g.n - 1 {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	for i in g.n {
		g.res[i] = g.res[i] * mult;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	out.s.append("scaled sorted series");
	out
}
@end
@entry 1025b0be462315c5
kind: step
verb: pair
noun: runs
modifier: safely
context: loop
phrase: pair runs safely across adjacent slots
phrase: group equal runs safely into paired counts
test: list=2,2,3,3,3,4,4
expect: => i=3 r=0.0 ok=true s="paired runs safely" errors=0 n=6 res=[2,2,3,3,4,2] cache=0 hits=0
test: list=1,1,1,5,5
expect: => i=2 r=0.0 ok=true s="paired runs safely" errors=0 n=4 res=[1,3,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp = [0; 512];
	var i = 0;
	var runs = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			i++;
		}
		temp[kept] = val;
		temp[kept + 1] = run_len;
		kept += 2;
		runs++;
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = runs;
	out.s.clear();
	out.s.append("paired runs safely");
	out
}
@end
