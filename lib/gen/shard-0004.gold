fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var sum = 0;
	var actual = c;
	if actual > g.n { actual = g.n; }
	let start = g.n - actual;
	for i in start..g.n {
		sum += g.res[i];
	}
	g.steps += actual;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "tail sum: ", sum);
	out
}
@end
