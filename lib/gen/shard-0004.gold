code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	// simple bubble sort descending
	if g.n > 1 {
		for i in g.n {
			for j in 0..(g.n - 1) {
				if g.res[j] < g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	if g.n > c { g.n = c; }
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "retained: ", g.n);
	out
}
@end
