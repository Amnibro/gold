@entry 822a0003555d0f69
kind: step
verb: dedupe
noun: suffix
modifier: with_retry
context: stats
phrase: dedupe suffix window of {suffix_len} items across {retries} passes
phrase: remove duplicate suffix statistics within {suffix_len} elements over {retries} attempts
slot: suffix_len int
slot: retries int
test: list=10,20,30,40,40,50 suffix_len=4 retries=2
expect: => i=1 r=0.0 ok=true s="deduped suffix elements count 1" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=10,20,30,40,50 suffix_len=3 retries=2
expect: => i=0 r=0.0 ok=false s="deduped suffix elements count 0" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	let max_r = ${retries};
	if g.n <= slen || slen <= 1 {
		out.ok = false;
		return out;
	}
	let start = g.n - slen;
	var deduped = 0;
	for r in max_r {
		var write_p = start;
		var i = start;
		while i < g.n {
			var seen = false;
			var j = start;
			while j < write_p {
				if g.res[j] == g.res[i] {
					seen = true;
				}
				j++;
			}
			if !seen {
				g.res[write_p] = g.res[i];
				write_p++;
			} else {
				deduped++;
			}
			i++;
		}
		g.n = write_p;
		if deduped > 0 {
			break;
		}
	}
	out.i = deduped;
	out.ok = deduped > 0;
	out.s.clear();
	format(out.s, "deduped suffix elements count ", deduped);
	g.steps += g.n + max_r;
	out
}
@end
