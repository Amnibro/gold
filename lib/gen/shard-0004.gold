kind: step
verb: return
noun: maximum
modifier: up_to
context: cache
phrase: return maximum cached value up to {ceiling}
phrase: find highest cached element up to ceiling {ceiling}
slot: ceiling int
test: list=10,50,30,70 ceiling=40
expect: => i=30 r=0.0 ok=true s="maximum cached up to 40 is 30" errors=0 n=4 res=[10,50,30,70] cache=4 hits=0
test: list=80,90 ceiling=50
expect: => i=0 r=0.0 ok=true s="none found up to ceiling" errors=0 n=2 res=[80,90] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var best = -999999;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		gold_cache_put(g, i, x);
		if x <= c && (!found || x > best) {
			best = x;
			found = true;
		}
	}
	g.steps += g.n + 1;
	out.i = if found { best } else { 0 };
	out.s.clear();
	if found {
		format(out.s, "maximum cached up to ", c, " is ", best);
	} else {
		format(out.s, "none found up to ceiling");
	}
	out
}
@end
@entry 813d7912b5648372
kind: step
verb: clamp
noun: budget
modifier: until
context: cache
phrase: clamp cache budget until reaching {max_cap}
phrase: bound running cache budget until total {max_cap}
slot: max_cap int
test: list=10,20,30,40 max_cap=50
expect: => i=50 r=0.0 ok=true s="budget clamped until cap: 50" errors=0 n=4 res=[10,20,20,40] cache=3 hits=0
test: list=100 max_cap=20
expect: => i=20 r=0.0 ok=true s="budget clamped until cap: 20" errors=0 n=1 res=[20] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_cap};
	var running = 0;
	for i in g.n {
		if running + g.res[i] > cap {
			let rem = max(0, cap - running);
			g.res[i] = rem;
			running = cap;
			gold_cache_put(g, i, rem);
			break;
		} else {
			running += g.res[i];
			gold_cache_put(g, i, g.res[i]);
		}
	}
	g.steps += g.n + 1;
	out.i = running;
	out.s.clear();
	format(out.s, "budget clamped until cap: ", running);
	out
}
@end
@entry 79c4ecb6e36bbd97
kind: step
verb: trace
noun: runs
modifier: until
context: cache
phrase: trace cached runs until streak length {target_len}
phrase: record matching runs in cache until length {target_len}
slot: target_len int
test: list=1,1,1,2,2 target_len=3
expect: => i=3 r=0.0 ok=true s="reached run target length 3" errors=0 n=5 res=[1,1,1,2,2] cache=3 hits=0
test: list=5,6,7 target_len=2
expect: => i=1 r=0.0 ok=true s="max run observed: 1" errors=0 n=3 res=[5,6,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${target_len};
	var cur_run = 0;
	var last_val = -999999;
	var target_reached = false;
	for i in g.n {
		let x = g.res[i];
		if x == last_val {
			cur_run++;
		} else {
			cur_run = 1;
			last_val = x;
		}
		gold_cache_put(g, i, cur_run);
		if cur_run >= req {
			target_reached = true;
			break;
		}
	}
	g.steps += g.n + 1;
	out.i = cur_run;
	out.s.clear();
	if target_reached {
		format(out.s, "reached run target length ", req);
	} else {
		format(out.s, "max run observed: ", cur_run);
	}
	out
}
@end
@entry c96b86da5d3e7e70
kind: step
verb: dedupe
noun: streak
modifier: while
context: cache
phrase: dedupe streak while below cache limit {max_removals}
phrase: remove duplicate streaks while under limit {max_removals}
