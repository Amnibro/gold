code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n {
		let x = g.res[k];
		orig[k] = if x > c { c } else { x };
	}
	gold_clear(g);
	for k in old_n {
		let v_val = orig[k];
		var exists = false;
		for j in g.n {
			if g.res[j] == v_val { exists = true; break; }
		}
		if !exists { gold_push(g, v_val); }
	}
	out.i = g.n;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "deduped ", g.n, " items");
	out
}
@end
