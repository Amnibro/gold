fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp = [0; 512];
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		temp[kept] = if a > b { a } else { b };
		kept++;
		i += 2;
	}
	for k in kept { g.res[k] = temp[k]; }
	g.n = kept;
	g.steps += kept + 1;
	out.i = kept;
	out.s.clear();
	out.s.append("selected pairwise max values");
	out
}
