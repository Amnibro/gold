fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${key_id};
	let cached, found = gold_cache_get(g, key);
	if found {
		out.i = cached;
	} else {
		gold_cache_put(g, key, out.i);
	}
	g.steps += 1;
	out.s.clear();
	format(out.s, "nested memo key ", key, " val ", out.i);
	out
}
@end
