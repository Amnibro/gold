code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for sort limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty items");
		return out;
	}
	var count = 0;
	while count < g.n && ${cond}(g.res[count]) {
		count++;
	}
	if count < 2 {
		g.steps += 1;
		out.i = count;
		out.s.clear();
		format(out.s, "sorted limit while items ", count);
		return out;
	}
	for i in count {
		var j = 0;
		while j + 1 < count - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
			j++;
		}
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted limit while items ", count);
	out
}
@end
