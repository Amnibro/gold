@entry 47eb3244175d44dd
kind: step
verb: group
noun: item
modifier: at_most
context: compare
phrase: group item clusters differing at most {max_diff}
phrase: group adjacent items within tolerance {max_diff}
slot: max_diff int
test: list=1,3,10,12 max_diff=3
expect: => i=2 r=0.0 ok=true s="grouped into 2 clusters" errors=0 n=4 res=[1,3,10,12] cache=0 hits=0
test: list=1,3 max_diff=-1
expect: => i=0 r=0.0 ok=false s="error: invalid tolerance" errors=1 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if md < 0 {
		gold_fail(g, "tolerance cannot be negative");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid tolerance");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty items for group");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty items");
		return out;
	}
	var groups = 1;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		let d = if diff < 0 { -diff } else { diff };
		if d > md {
			groups++;
		}
	}
	g.steps += g.n;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped into ", groups, " clusters");
	out
}
@end
