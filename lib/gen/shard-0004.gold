phrase: rotate duplicates safely to tail
phrase: shift duplicate entries safely to end
test: list=1,2,2,3,4,4,5
expect: => i=2 r=0.0 ok=true s="rotated 2 duplicates to tail" errors=0 n=7 res=[1,2,3,4,5,2,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="rotated 0 duplicates to tail" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[512] = [0; 512];
	var dups int[512] = [0; 512];
	var u_cnt = 0;
	var d_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_cnt {
			if unique[j] == x { seen = true; break; }
		}
		if seen {
			dups[d_cnt] = x;
			d_cnt++;
		} else {
			unique[u_cnt] = x;
			u_cnt++;
		}
	}
	for i in u_cnt { g.res[i] = unique[i]; }
	for j in d_cnt { g.res[u_cnt + j] = dups[j]; }
	g.steps += g.n + 1;
	out.i = d_cnt;
	out.s.clear();
	format(out.s, "rotated ", d_cnt, " duplicates to tail");
	out
}
@end
