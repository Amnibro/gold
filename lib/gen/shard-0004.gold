code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let num_pairs = ${k};
	let total_pairs = g.n / 2;
	if num_pairs >= total_pairs { return out; }
	let start_idx = (total_pairs - num_pairs) * 2;
	let count = num_pairs * 2;
	for i in count {
		g.res[i] = g.res[start_idx + i];
	}
	g.n = count;
	g.steps += 1;
	out.i = num_pairs;
	out.s.clear();
	out.s.append("kept last pairs");
	out
}
@end
