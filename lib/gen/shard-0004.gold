code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	let e = ${end};
	if s >= 0 && e < g.n && s < e {
		let tmp = g.res[s];
		g.res[s] = g.res[e];
		g.res[e] = tmp;
		out.i = 1;
		out.s.clear();
		format(out.s, "swapped range ", s, " to ", e);
	} else {
		out.i = 0;
		out.s.clear();
		format(out.s, "invalid range");
	}
	g.steps += 1;
	out
}
@end
@entry 8a9b465c628afa2a
kind: step
verb: split
noun: text
modifier: sorted
context: compare
phrase: split text sorting words by length
phrase: order words from shortest to longest
test: text="elephant cat dog"
expect: => i=3 r=0.0 ok=true s="cat dog elephant" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana fig apple"
expect: => i=3 r=0.0 ok=true s="fig apple banana" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = words(out.s);
	var word_list byte[..64][>..] = [];
	for word in w {
		var s byte[..64] = "";
		for b in word { if s.len < 64 { s.push(b); } }
		word_list.push(s);
	}
	let n = word_list.len;
	if n > 1 {
		for i in n {
			for j in 0..(n - 1) {
				if word_list[j].len > word_list[j + 1].len {
					let tmp = word_list[j];
					word_list[j] = word_list[j + 1];
					word_list[j + 1] = tmp;
				}
			}
		}
	}
	out.s.clear();
	for i in n {
		if i > 0 { out.s.push(' '); }
		for b in word_list[i] {
			if out.s.len < 200 { out.s.push(b); }
		}
	}
	g.steps += n;
	out.i = n;
	out.ok = true;
	out
}
@end
