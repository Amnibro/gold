code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty sequence to compare");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty sequence");
		return out;
	}
	var symmetric = true;
	for i in g.n / 2 {
		if g.res[i] != g.res[g.n - 1 - i] {
			symmetric = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = symmetric;
	out.i = if symmetric { 1 } else { 0 };
	out.s.clear();
	format(out.s, if symmetric { "sequence is symmetric" } else { "sequence is asymmetric" });
	out
}
@end
