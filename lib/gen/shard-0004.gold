fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_diff};
	let pairs = g.n / 2;
	var kept = 0;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let diff = if a > b { a - b } else { b - a };
		if diff <= limit {
			g.res[kept * 2] = a;
			g.res[kept * 2 + 1] = b;
			kept++;
		}
	}
	g.n = kept * 2;
	g.steps += pairs;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered pairs within difference");
	out
}
@end
