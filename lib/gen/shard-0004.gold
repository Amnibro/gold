test: list=7,8,9,10
expect: => i=2 r=0.0 ok=true s="placed 2 evens first" errors=0 n=4 res=[8,10,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
	var en = 0;
	var on = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 { evens[en] = x; en++; }
		else { odds[on] = x; on++; }
	}
	gold_clear(g);
	for k in en { gold_push(g, evens[k]); }
	for k in on { gold_push(g, odds[k]); }
	g.steps += g.n;
	out.i = en;
	out.s.clear();
	format(out.s, "placed ", en, " evens first");
	out
}
@end
