code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let ceiling = ${bound};
    var count = 0;
    var i = g.n - 1;
    while i >= 0 && g.res[i] <= ceiling {
        count++;
        i--;
    }
    g.steps += g.n - 1 - i;
    out.i = count;
    out.s.clear();
    format(out.s, "tail items up to bound: ", count);
