	let mult = ${factor};
	var scaled = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] <= g.res[i + 1] {
			g.res[i] = g.res[i] * mult;
		} else {
			g.res[i + 1] = g.res[i + 1] * mult;
		}
		scaled++;
		i += 2;
	}
	g.steps += scaled + 1;
	out.i = scaled;
	out.s.clear();
	out.s.append("scaled smaller elements in pairs");
	out
}
@end
