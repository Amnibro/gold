fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 || g.n == 0 {
		gold_fail(g, "empty search head to join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty head");
		return out;
	}
	let count = min(lim, g.n);
	out.s.clear();
	for i in count {
		if i > 0 { out.s.push('-'); }
		format(out.s, g.res[i]);
	}
	g.steps += count;
	out.i = count;
	out
}
