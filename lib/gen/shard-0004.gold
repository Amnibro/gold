kind: step
verb: split
noun: primes
modifier: each
context: math
phrase: split each prime into two smaller parts
phrase: decompose each prime number into halves
test: list=4,7,9,11
expect: => i=2 r=0.0 ok=true s="split 2 primes" errors=0 n=6 res=[4,3,4,9,5,6] cache=0 hits=0
test: list=5,8,13
expect: => i=2 r=0.0 ok=true s="split 2 primes" errors=0 n=5 res=[2,3,8,6,7] cache=0 hits=0
code:
fn ${ID}_chk_p(n int) bool {
    if n < 2 { return false; }
    var d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d++;
    }
    true
}
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var buf int[..64] = [];
    var count = 0;
    for i in g.n {
        let x = g.res[i];
        if ${ID}_chk_p(x) && buf.len + 2 < 64 {
            let half = x / 2;
            buf.push(half);
            buf.push(x - half);
            count++;
        } else if buf.len < 64 {
            buf.push(x);
        }
    }
    gold_clear(g);
    for x in buf { gold_push(g, x); }
    g.steps += g.n;
    out.i = count;
    out.s.clear();
    format(out.s, "split ", count, " primes");
    out
}
@end
