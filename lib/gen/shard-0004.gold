test: list=10,20,10,30,20 input=50
expect: => i=2 r=0.0 ok=true s="unique budget items merged in cache 2" errors=0 n=5 res=[10,20,10,30,20] cache=2 hits=2
test: list=5,5,10 input=8
expect: => i=1 r=0.0 ok=true s="unique budget items merged in cache 1" errors=0 n=3 res=[5,5,10] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cost = 0;
	var inserted = 0;
	for i in g.n {
		let x = g.res[i];
		let _, seen = gold_cache_get(g, x);
		if !seen {
			if cost + x <= out.i {
				gold_cache_put(g, x, cost);
				cost += x;
				inserted++;
			}
		}
	}
	g.steps += g.n;
	out.i = inserted;
	out.s.clear();
	format(out.s, "unique budget items merged in cache ", inserted);
	out
}
@end
