        if g.res[i] % 2 == 0 && evens.len < 16 {
            evens.push(g.res[i]);
        }
    }
    var cached = 0;
    for i in evens.len / 2 {
        let prod = evens[2 * i] * evens[2 * i + 1];
        gold_cache_put(g, i, prod);
        cached++;
    }
    g.steps += g.n;
    out.i = cached;
    out.s.clear();
    format(out.s, "cached ", cached, " even pairs");
    out
}
