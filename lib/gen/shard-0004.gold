phrase: keep elements with no duplicates in aggregate

test: list=1,2,2,3,4,4,5
expect: => i=3 r=0.0 ok=true s="unique non duplicate items 3" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=7,7,8
expect: => i=1 r=0.0 ok=true s="unique non duplicate items 1" errors=0 n=1 res=[8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if count == 1 {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n * g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique non duplicate items ", kept);
	out
}
@end
@entry 09015b78f999ce5d
kind: step
verb: check
noun: counter
modifier: with_retry
context: aggregate
phrase: check aggregate counter reaching {target} with {attempts} retries
phrase: verify counter target {target} allowing {attempts} retries
slot: target int
slot: attempts int

test: input=5 target=8 attempts=5
expect: => i=8 r=0.0 ok=true s="counter reached 8" errors=0 n=0 res=[] cache=0 hits=0
test: input=10 target=12 attempts=1
expect: => i=11 r=0.0 ok=false s="counter reached 11" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_att = ${attempts};
	var tries = 0;
	while out.i < tgt && tries < max_att {
		out.i++;
		tries++;
	}
	g.steps += tries;
	if out.i < tgt {
		gold_fail(g, "counter retry target not reached");
		out.ok = false;
	}
	out.s.clear();
	format(out.s, "counter reached ", out.i);
	out
}
@end
@entry aa1ed4098003ba09
kind: step
verb: cache
noun: duplicates
modifier: unique
context: aggregate
phrase: cache duplicates unique count
phrase: record unique duplicate tally in cache
test: list=1,2,2,3,4,4,4
expect: => i=2 r=0.0 ok=true s="cached unique duplicates count" errors=0 n=7 res=[1,2,2,3,4,4,4] cache=1 hits=0
test: list=1,2,3
expect: => i=0 r=0.0 ok=true s="cached unique duplicates count" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups = 0;
	var temp int[512] = [0; 512];
	var seen_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var already = false;
		for j in seen_cnt {
			if temp[j] == x { already = true; break; }
		}
		if !already {
			temp[seen_cnt] = x;
			seen_cnt++;
			var c = 0;
			for k in g.n { if g.res[k] == x { c++; } }
			if c > 1 { dups++; }
		}
	}
	gold_cache_put(g, 0, dups);
	g.steps += g.n;
	out.i = dups;
	out.s.clear();
	out.s.append("cached unique duplicates count");
	out
}
@end
