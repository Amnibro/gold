context: transform
phrase: reverse values until target {target} reached
phrase: invert prefix values stopping when target {target} encountered
slot: target int
test: list=1,2,3,4,5 target=3
expect: => i=3 r=0.0 ok=true s="reversed values until target encountered" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
