@entry d54793a1b428d981
kind: step
verb: repeat
noun: runs
modifier: safely
context: sort
phrase: repeat runs safely with span {min_len}
phrase: duplicate contiguous runs safely meeting span {min_len}
slot: min_len int
test: list=1,1,1,2,3,3,3 min_len=3
expect: => i=2 r=0.0 ok=true s="repeated 2 runs safely" errors=0 n=9 res=[1,1,1,2,3,3,3,1,3] cache=0 hits=0
test: list=1,2,3 min_len=2
expect: => i=0 r=0.0 ok=true s="repeated 0 runs safely" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var run_vals int[512] = [0; 512];
	var r_cnt = 0;
	var cur_val = if g.n > 0 { g.res[0] } else { 0 };
	var cur_len = 0;
	for i in g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			if cur_len >= ml {
				run_vals[r_cnt] = cur_val;
				r_cnt++;
			}
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	if cur_len >= ml {
		run_vals[r_cnt] = cur_val;
		r_cnt++;
	}
	for i in r_cnt {
		if g.n < 512 { gold_push(g, run_vals[i]); }
	}
	g.steps += g.n + 1;
	out.i = r_cnt;
	out.s.clear();
	format(out.s, "repeated ", r_cnt, " runs safely");
	out
}
@end
@entry 0e67f9306a993979
kind: step
verb: rotate
noun: average
modifier: each
context: sort
phrase: rotate average offset across each item
phrase: cycle elements adjusting each by average
test: list=10,20,30,40
expect: => i=25 r=0.0 ok=true s="rotated items offset by average 25" errors=0 n=4 res=[-5,5,15,-15] cache=0 hits=0
test: list=5,15,25
expect: => i=15 r=0.0 ok=true s="rotated items offset by average 15" errors=0 n=3 res=[0,10,-10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "rotate average skipped");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let first = g.res[0] - avg;
	for i in 1..g.n {
		g.res[i - 1] = g.res[i] - avg;
	}
	g.res[g.n - 1] = first;
	g.steps += g.n + 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "rotated items offset by average ", avg);
	out
}
@end
@entry 2c831681506b2165
kind: step
verb: join
noun: suffix
modifier: unique
context: sort
phrase: join unique suffix elements from span {span}
phrase: combine distinct items in suffix of size {span}
slot: span int
test: list=1,2,3,4,4,5,5 span=4
expect: => i=2 r=0.0 ok=true s="4-5" errors=0 n=7 res=[1,2,3,4,4,5,5] cache=0 hits=0
test: list=10,20 span=0
expect: => i=0 r=0.0 ok=true s="empty suffix join" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	if sp <= 0 || g.n == 0 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "empty suffix join");
		return out;
	}
	let k = min(sp, g.n);
	let start = g.n - k;
	var u int[512] = [0; 512];
	var u_cnt = 0;
	for i in start..g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_cnt {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[u_cnt] = x;
			u_cnt++;
		}
	}
	out.s.clear();
	for i in u_cnt {
		if i > 0 { out.s.push('-'); }
		format(out.s, u[i]);
	}
	g.steps += k + 1;
	out.i = u_cnt;
	out
}
@end
@entry 07cce461d2a73acf
kind: step
verb: dedupe
noun: window
modifier: in_reverse
context: sort
phrase: dedupe window in reverse of size {win_size}
phrase: remove duplicate items within reverse window {win_size}
slot: win_size int
test: list=1,1,2,2,3,4 win_size=3
expect: => i=1 r=0.0 ok=true s="deduped reverse window, removed 1" errors=0 n=5 res=[1,1,2,3,4] cache=0 hits=0
test: list=5,10,15 win_size=2
expect: => i=0 r=0.0 ok=true s="deduped reverse window, removed 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = max(1, ${win_size});
	var removed = 0;
	var i = g.n - 1;
	while i > 0 && i >= g.n - ws {
		if g.res[i] == g.res[i - 1] {
			for j in i..(g.n - 1) {
				g.res[j] = g.res[j + 1];
			}
			g.n--;
			removed++;
		}
		i--;
	}
	g.steps += ws + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped reverse window, removed ", removed);
	out
}
@end
