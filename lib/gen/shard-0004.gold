	var out = v;
	if out.s.len < 2 { return out; }
	for i in out.s.len {
		var j = 0;
		while j < out.s.len - 1 {
			if out.s[j] > out.s[j+1] {
				let t = out.s[j];
				out.s[j] = out.s[j+1];
				out.s[j+1] = t;
			}
			j++;
		}
	}
	let first = out.s[0];
	for k in out.s.len - 1 {
		out.s[k] = out.s[k+1];
	}
	out.s[out.s.len - 1] = first;
	g.steps += out.s.len;
	gold_push(g, out.s.len);
	out.i = out.s.len;
	format(out.s, " rotated");
	out
}
