    let cap = ${max_val};
    if cap <= 0 || cap > 255 {
        gold_fail(g, "invalid byte cap");
        out.ok = false;
        return out;
    }
    var clamped = 0;
    for i in out.s.len {
        let code = out.s[i] as int;
        if code > cap {
            out.s[i] = cap as! byte;
            clamped++;
        }
    }
    g.steps += out.s.len;
    out.i = clamped;
    out
}
