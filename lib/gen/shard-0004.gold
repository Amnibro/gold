fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64] = [0; 64];
	var kc = 0;
	for i in g.n {
		let x = g.res[i];
		let cached, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			if kc < 64 { kept[kc] = x; kc++; }
		}
	}
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kc;
	out.s.clear();
	format(out.s, "deduped condition with cache count ", kc);
	out
}
