@entry 732d7dd2ccd9d4a0
kind: step
verb: retry
noun: minimum
modifier: times
context: sort
phrase: retry minimum extraction across count {k} times
phrase: repeat minimum selection pass {k} times
slot: k int
test: list=8,3,5,1,9 k=2
expect: => i=2 r=0.0 ok=true s="extracted minimum 2 times" errors=0 n=5 res=[1,3,5,8,9] cache=0 hits=0
test: list=12,4,7 k=1
expect: => i=1 r=0.0 ok=true s="extracted minimum 1 times" errors=0 n=3 res=[4,12,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${k};
	var bound = times;
	if bound > g.n { bound = g.n; }
	for step in bound {
		var min_idx = step;
		for j in (step + 1)..g.n {
			if g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
		}
		let t = g.res[step];
		g.res[step] = g.res[min_idx];
		g.res[min_idx] = t;
	}
	g.steps += bound * g.n;
	out.i = bound;
	out.s.clear();
	format(out.s, "extracted minimum ", bound, " times");
	out
}
@end
