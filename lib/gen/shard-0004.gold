fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last_even = -1000000;
	var sorted_evens = true;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			if x < last_even { sorted_evens = false; }
			last_even = x;
		}
	}
	g.steps += g.n;
	out.ok = sorted_evens;
	out.s.clear();
	format(out.s, "running evens sorted: ", sorted_evens);
	out
}
@end
@entry 8b00cefd7239e6ac
kind: step
verb: swap
noun: average
modifier: unique
context: sort
phrase: swap sort items around unique values average
phrase: partition elements about average of unique sort numbers
test: list=2,2,4,8,8
expect: => i=4 r=0.0 ok=true s="unique elements average: 4" errors=0 n=5 res=[2,2,4,8,8] cache=0 hits=0
test: list=1,3,3,9
expect: => i=4 r=0.0 ok=true s="unique elements average: 4" errors=0 n=4 res=[1,3,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var cnt = 0;
	for k in g.n {
		if k == 0 || g.res[k] != g.res[k - 1] {
			sum += g.res[k];
			cnt++;
		}
	}
	let avg = if cnt > 0 { sum / cnt } else { 0 };
	if g.n > 1 {
		if g.res[0] > avg && g.res[g.n - 1] < avg {
			let t = g.res[0];
			g.res[0] = g.res[g.n - 1];
			g.res[g.n - 1] = t;
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "unique elements average: ", avg);
	out
}
@end
