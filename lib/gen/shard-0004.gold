fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len_suf};
	if k <= 0 || k > g.n {
		gold_fail(g, "invalid suffix length");
		out.ok = false;
		out.s.clear();
		out.s.append("invalid suffix length error");
		return out;
	}
	var sum = 0;
	let start = g.n - k;
	for i in k {
		sum += g.res[start + i];
	}
	gold_cache_put(g, k, sum);
	g.steps += k;
	out.i = sum;
	out.s.clear();
	out.s.append("collected suffix and cached sum");
	out
}
@end
