code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for square check");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		let r = sqrt(x as real) as int;
		if r * r == x && x >= 0 {
			count++;
			gold_cache_put(g, count, x);
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " cached squares");
	out
}
@end
