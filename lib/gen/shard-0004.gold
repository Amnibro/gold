test: text="education"
expect: => i=5 r=0.0 ok=true s="unique vowels count: 5" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana"
expect: => i=1 r=0.0 ok=true s="unique vowels count: 1" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[5] = ['a', 'e', 'i', 'o', 'u'];
	var seen int = 0;
	for i in out.s.len {
		let c = out.s[i];
		for v_idx in 5 {
			if c == vowels[v_idx] {
				seen = seen | (1 << v_idx);
			}
		}
	}
	var count = 0;
	for v_idx in 5 {
		if (seen & (1 << v_idx)) != 0 { count++; }
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "unique vowels count: ", count);
	out
}
@end
