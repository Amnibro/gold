expect: => i=0 r=0.0 ok=false s="error: insufficient items" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 3 {
		gold_fail(g, "need at least three items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	let mid = g.n / 2;
	let avg = (g.res[mid - 1] + g.res[mid + 1]) / 2;
	g.res[mid] = avg;
	g.steps += 1;
	out.i = avg;
	out.s.clear();
	format(out.s, "shifted middle to ", avg);
	out
}
@end
