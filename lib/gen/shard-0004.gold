fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = min(g.n, 4);
	var seen int[64] = [0; 64];
	var sc = 0;
	var i = limit - 1;
	while i >= 0 {
		let x = g.res[i];
		var already = false;
		for j in sc { if seen[j] == x { already = true; } }
		if !already && sc < 64 { seen[sc] = x; sc++; }
		i--;
	}
	gold_clear(g);
	for k in sc { gold_push(g, seen[k]); }
	g.steps += limit;
	out.i = sc;
	out.s.clear();
	format(out.s, "deduped head backwards count ", sc);
	out
}
@end
