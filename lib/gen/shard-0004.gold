code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "no runs to join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty runs");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		var run_sum = g.res[i];
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			run_sum += g.res[j];
			j++;
		}
		g.res[kept] = run_sum;
		kept++;
		i = j;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "joined nested runs to ", kept);
	out
}
@end
