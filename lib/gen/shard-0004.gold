phrase: compute recursive sliding window byte sums {win}
slot: win int
test: text="abcdef" win=2
expect: => i=5 r=0.0 ok=true s="applied window to 5 positions" errors=0 n=5 res=[195,197,199,201,203] cache=0 hits=0
