fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = last;
	}
	g.steps += g.n * 2;
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated with running sum: ", sum);
	out
}
