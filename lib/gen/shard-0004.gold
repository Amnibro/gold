expect: => i=2 r=0.0 ok=true s="halted sort on negative" errors=1 n=4 res=[2,4,-1,3] cache=0 hits=0
test: list=9,3,7,1
expect: => i=4 r=0.0 ok=true s="sorted all valid values" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid_len = 0;
	for k in g.n {
		if g.res[k] < 0 {
			gold_fail(g, "negative value breaks sorting");
			break;
		}
		valid_len++;
	}
	for i in valid_len {
		for j in i + 1..valid_len {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += valid_len;
	out.i = valid_len;
	out.s.clear();
	if g.errors > 0 {
		out.s.append("halted sort on negative");
	} else {
		out.s.append("sorted all valid values");
	}
	out
}
@end
