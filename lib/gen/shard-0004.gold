noun: subfunction
modifier: pairwise
context: sort
phrase: clamp subfunction {sub} pairwise to ceiling {cap}
phrase: apply subfunction {sub} across pairs bounded at {cap}
slot: sub fn
slot: cap int
test: list=10,20,30,40 sub=double cap=35
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise results" errors=0 n=2 res=[35,35] cache=0 hits=0
test: list=5,15 sub=inc cap=10
expect: => i=1 r=0.0 ok=true s="clamped 1 pairwise results" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${cap};
	let pairs = g.n / 2;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let applied = ${sub}(a + b);
		g.res[k] = min(applied, ceiling);
	}
	g.n = pairs;
	g.steps += pairs + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "clamped ", pairs, " pairwise results");
	out
}
@end
