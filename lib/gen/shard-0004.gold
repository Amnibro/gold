code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d += 1;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var count = 0;
	var i = g.n;
	while i > 0 {
		i -= 1;
		if ${ID}_is_prime(g.res[i]) {
			primes[count] = g.res[i];
			count += 1;
		}
	}
	for j in count { g.res[j] = primes[j]; }
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
