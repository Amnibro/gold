fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let retries = ${retry_count};
	var total = 0;
	for i in 0..g.n {
		total += g.res[i];
	}
	if total == 0 && retries > 0 {
		g.errors++;
		total += retries;
		out.ok = false;
	} else {
		out.ok = true;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "sum ", total);
	out
}
@end
