expect: => i=3 r=0.0 ok=true s="reversed items before limit 3" errors=0 n=3 res=[3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cut = g.n;
	for i in g.n {
		if g.res[i] == ${stop_val} { cut = i; break; }
	}
	for i in cut / 2 {
		let j = cut - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += cut + 1;
	out.i = cut;
	out.s.clear();
	format(out.s, "reversed items before limit ", cut);
	out
}
@end
