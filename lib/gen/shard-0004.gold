code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lo = ${lo_idx};
	var hi = ${hi_idx};
	if lo < 0 { lo = 0; }
	if hi >= g.n { hi = g.n - 1; }
	var kept = 0;
	if lo <= hi && g.n > 0 {
		for i in lo..hi + 1 {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected middle slice count ", kept);
	out
}
@end
