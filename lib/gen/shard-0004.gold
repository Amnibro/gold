code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || c > g.n {
		gold_fail(g, "invalid count for average clamp");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid count");
		return out;
	}
	let start = g.n - c;
	var sum = 0;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	let avg = sum / c;
	var clamped = 0;
	i = start;
	while i < g.n {
		if g.res[i] > avg {
			g.res[i] = avg;
			clamped++;
		}
		i++;
	}
	g.steps += c;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped trailing average count ", clamped);
	out
}
