	g.steps += idx + 1;
	out.i = idx;
	out.s.clear();
	if found {
		out.s.append("checkpoint error reached");
	} else {
		gold_fail(g, "no checkpoint error found");
		out.s.append("no checkpoint error in scan");
	}
	out
}
