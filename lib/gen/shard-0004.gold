code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	for i in g.n {
		if core_is_square(g.res[i]) {
			var exists = false;
			for j in u {
				if g.res[j] == g.res[i] {
					exists = true;
				}
			}
			if !exists {
				g.res[u] = g.res[i];
				u++;
			}
		}
	}
	var pairs = u / 2;
	for i in pairs {
		g.res[i] = g.res[2 * i] + g.res[2 * i + 1];
	}
	g.n = pairs;
	out.i = pairs;
	g.steps += u + 1;
	out.s.clear();
	format(out.s, "paired unique squares ", pairs);
	out
}
@end
