@entry f8b731e3390836d0
kind: step
verb: normalize
noun: streak
modifier: up_to
context: transform
phrase: normalize streak up to {max_streak} items
phrase: cap repeating streak up to {max_streak}
slot: max_streak int
test: list=1,1,1,2,2,2,2 max_streak=2
expect: => i=4 r=0.0 ok=true s="normalized streak" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,5,5,5 max_streak=1
expect: => i=1 r=0.0 ok=true s="normalized streak" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_streak};
	if g.n == 0 { return out; }
	var write_idx = 0;
	var current_streak = 0;
	var prev = g.res[0] + 1;
	for i in g.n {
		let x = g.res[i];
		if x == prev {
			current_streak++;
		} else {
			prev = x;
			current_streak = 1;
		}
		if current_streak <= lim {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += 1;
	out.i = write_idx;
	out.s.clear();
	out.s.append("normalized streak");
	out
}
@end
