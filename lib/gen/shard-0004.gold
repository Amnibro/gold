fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let budget = 50;
	var cur = 0;
	var kept int[64] = [0; 64];
	var kc = 0;
	for i in g.n {
		if cur + g.res[i] <= budget {
			cur += g.res[i];
			if kc < 64 { kept[kc] = g.res[i]; kc++; }
		} else {
			break;
		}
	}
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = cur;
	out.s.clear();
	format(out.s, "filtered items under budget total ", cur);
	out
}
