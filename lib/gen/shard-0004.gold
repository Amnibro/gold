fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_len};
	if out.s.len > lim && lim >= 0 {
		var truncated byte[..200] = "";
		for i in lim {
			truncated.push(out.s[i]);
		}
		out.s.clear();
		out.s.append(truncated);
	}
	out.i = out.s.len;
	g.steps += 1;
	out
}
