kind: step
verb: run
noun: letters
modifier: pairwise
context: text
phrase: run pairwise check on letter characters
phrase: examine adjacent letter pairs in text
test: text="ab cd ef"
expect: => i=5 r=0.0 ok=true s="ran 5 letter pairs" errors=0 n=5 res=[1,1,1,1,1] cache=0 hits=0
test: text="x1y2z3"
expect: => i=2 r=0.0 ok=true s="ran 2 letter pairs" errors=0 n=2 res=[1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var letters byte[..200] = "";
    for i in out.s.len {
        let ch = out.s[i];
        let is_letter = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
        if is_letter && letters.len < 200 {
            letters.push(ch);
        }
    }
    if letters.len < 2 {
        out.i = 0;
        return out;
    }
    var pairs = 0;
    for i in letters.len - 1 {
        let diff = (letters[i + 1] as int) - (letters[i] as int);
        gold_push(g, diff);
        pairs++;
    }
    g.steps += pairs;
    out.i = pairs;
    out.s.clear();
    format(out.s, "ran ", pairs, " letter pairs");
    out
}
@end
