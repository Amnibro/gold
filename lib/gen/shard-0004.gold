code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			odds[count] = g.res[i];
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no odd numbers to join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no odd items");
		return out;
	}
	gold_clear(g);
	var k = count - 1;
	while k >= 0 {
		gold_push(g, odds[k]);
		k--;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "joined reverse odds count ", count);
	out
}
@end
