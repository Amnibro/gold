fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	var dup_count = 0;
	for k in old_n {
		gold_push(g, orig[k]);
		if k % 2 == 0 {
			gold_push(g, orig[k]);
			dup_count++;
		}
	}
	out.i = dup_count;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "duplicated alternating");
	out
}
@end
