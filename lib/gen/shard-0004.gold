fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while x >= 10 {
			var s = 0;
			while x > 0 { s += x % 10; x /= 10; }
			x = s;
		}
		gold_cache_put(g, i, x);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	out.s.append("cached digital roots");
	out
}
@end
