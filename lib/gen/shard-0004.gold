code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[64] = [0; 64];
	var oc = 0;
	var has_dup = false;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			let x = g.res[i];
			for j in oc { if odds[j] == x { has_dup = true; } }
			if oc < 64 { odds[oc] = x; oc++; }
		}
	}
	g.steps += g.n;
	if has_dup {
		gold_fail(g, "duplicate odd value found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: duplicate odd");
	} else {
		out.i = oc;
		out.s.clear();
		format(out.s, "validated unique odd count ", oc);
	}
	out
}
@end
