code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for rank squares");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty squares");
		return out;
	}
	var ranks int[64] = [0; 64];
	let count = min(g.n, 64);
	for i in count {
		var r = 1;
		for j in count {
			if g.res[j] < g.res[i] { r++; }
		}
		ranks[i] = r;
	}
	gold_clear(g);
	for k in count { gold_push(g, ranks[k]); }
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked square values count ", g.n);
	out
}
@end
