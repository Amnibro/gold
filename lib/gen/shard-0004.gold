fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sorted = true;
	if g.n >= 2 {
		for k in 1..g.n {
			if g.res[k] < g.res[k - 1] {
				sorted = false;
				break;
			}
		}
	}
	if sorted {
		out.ok = true;
		out.i = 1;
		out.s.clear();
		format(out.s, "condition satisfied");
	} else {
		gold_fail(g, "sort condition failed");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		format(out.s, "condition violated");
	}
	g.steps += g.n;
	out
}
@end
