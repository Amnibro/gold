@entry 503226e9101e7a9f
kind: step
verb: dedupe
noun: limit
modifier: each
context: format
phrase: dedupe results limiting each to bound {cap}
phrase: retain unique items capping each at {cap}
slot: cap int
test: list=10,30,40,30 cap=25
expect: => i=2 r=0.0 ok=true s="deduped 2 items" errors=0 n=2 res=[10,25] cache=0 hits=0
test: list=5,5 cap=20
