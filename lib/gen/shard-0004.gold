fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	if limit <= 0 || limit > g.n {
		gold_fail(g, "invalid rank limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid rank limit");
		return out;
	}
	var ranks int[64] = [0; 64];
	let n_eval = min(g.n, 64);
	for i in n_eval {
		var r = 1;
		for j in n_eval {
			if g.res[j] < g.res[i] {
				r++;
			}
		}
		ranks[i] = r;
	}
	gold_clear(g);
	for i in min(limit, n_eval) {
		gold_push(g, ranks[i]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked first items count ", g.n);
	out
}
