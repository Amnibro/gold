code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 2;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j += 2;
		}
		i += 2;
	}
	var count = 0;
	var k = 0;
	while k < g.n {
		count++;
		k += 2;
	}
	out.i = count;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "sorted alternating");
	out
}
@end
