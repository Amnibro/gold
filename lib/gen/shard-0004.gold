fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var drop_count = 0;
	while drop_count < g.n && g.res[drop_count] < cut {
		drop_count += 1;
	}
	let new_n = g.n - drop_count;
	for i in new_n {
		g.res[i] = g.res[drop_count + i];
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = drop_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "prefix dropped: ", drop_count);
	out
}
