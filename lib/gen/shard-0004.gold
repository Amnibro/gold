fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${req_letter} as byte;
	var found = false;
	for i in out.s.len {
		if out.s[i] == target { found = true; break; }
	}
	g.steps += out.s.len + ${retries};
	if !found {
		gold_fail(g, "letter not found in text");
		out.ok = false;
	}
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "letter found status ", found);
	out
}
@end
