code:
fn ${ID}_chk_prime(n int) bool {
    if n < 2 { return false; }
    var d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d++;
    }
    true
}
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var cached = 0;
    for i in g.n {
        let x = g.res[i];
        if ${ID}_chk_prime(x) {
            gold_cache_put(g, cached, x);
            cached++;
        }
    }
    g.steps += g.n;
    out.i = cached;
    out.s.clear();
    format(out.s, "cached ", cached, " prime elements");
    out
}
@end
