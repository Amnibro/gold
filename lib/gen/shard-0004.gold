fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var tn = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x <= 9 {
			var count = 0;
			for j in g.n {
				if g.res[j] == x { count++; }
			}
			if count == 1 {
				temp[tn] = x;
				tn++;
			}
		}
	}
	if tn == 0 {
		gold_fail(g, "no unique digits found");
		out.ok = false;
	}
	gold_clear(g);
	for k in tn { gold_push(g, temp[k]); }
	g.steps += g.n + tn;
	out.i = tn;
	out.s.clear();
	format(out.s, "selected unique digits: ", tn);
	out
}
@end
