@entry b275e53cacdfd58a
kind: step
verb: clamp
noun: digits
modifier: recursively
context: retry
phrase: clamp digits recursively to maximum {digit_cap}
phrase: constrain digit values recursively under {digit_cap}
slot: digit_cap int
test: list=189,456 digit_cap=5
expect: => i=3 r=0.0 ok=true s="clamped digits count 3" errors=0 n=2 res=[155,455] cache=0 hits=0
test: list=12,34 digit_cap=0
expect: => i=0 r=0.0 ok=false s="error: invalid digit cap" errors=1 n=2 res=[12,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${digit_cap};
	if cap <= 0 || cap > 9 {
		gold_fail(g, "digit cap must be between one and nine");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid digit cap");
		return out;
	}
	var total_clamped = 0;
	for i in g.n {
		var n = g.res[i];
		var sign = 1;
		if n < 0 { sign = -1; n = -n; }
		var mult = 1;
		var res = 0;
		while n > 0 {
			var d = n % 10;
			if d > cap {
				d = cap;
				total_clamped++;
			}
			res += d * mult;
			mult *= 10;
			n /= 10;
		}
		g.res[i] = res * sign;
	}
	g.steps += total_clamped + 1;
	out.i = total_clamped;
	out.s.clear();
	format(out.s, "clamped digits count ", total_clamped);
	out
}
@end
@entry 4ae09e93730ddd65
