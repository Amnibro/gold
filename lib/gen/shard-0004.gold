	var found_idx = -1;
	for i in g.n {
		if g.res[i] >= fl {
			found_idx = i;
			break;
		}
	}
	if found_idx < 0 {
		gold_fail(g, "no head item meets floor condition");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: floor not reached");
		return out;
	}
	g.steps += found_idx + 1;
	out.i = g.res[found_idx];
	out.s.clear();
	format(out.s, "found head item at least floor ", g.res[found_idx]);
	out
}
@end
@entry 70f3d293c229473b
kind: step
verb: dedupe
noun: head
modifier: any
context: loop
phrase: dedupe head prefix matching any target {val}
phrase: remove duplicate occurrences of head value {val}
slot: val int
test: list=3,3,3,5,6 val=3
expect: => i=3 r=0.0 ok=true s="deduped head target to 3" errors=0 n=3 res=[3,5,6] cache=0 hits=0
test: list=1,2,3 val=9
expect: => i=0 r=0.0 ok=false s="error: target missing" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${val};
	var seen = false;
	var kept = 0;
	for i in g.n {
		if g.res[i] == target {
			if !seen {
				g.res[kept] = g.res[i];
				kept++;
				seen = true;
			}
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if !seen {
		gold_fail(g, "target value not found in head");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target missing");
		return out;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped head target to ", kept);
	out
}
@end
