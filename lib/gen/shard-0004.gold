code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = core_abs_val(out.i);
	var non_zeros = 0;
	var has_zero = false;
	if n == 0 {
		has_zero = true;
		gold_fail(g, "zero number supplied");
	}
	while n > 0 {
		let d = n % 10;
		if d == 0 {
			has_zero = true;
			gold_fail(g, "zero digit encountered");
		} else {
			non_zeros++;
		}
		n /= 10;
	}
	g.steps++;
	out.i = non_zeros;
	out.s.clear();
	if has_zero {
		out.s.append("contains zero digit error");
	} else {
		out.s.append("all digits non zero");
	}
	out
}
@end
