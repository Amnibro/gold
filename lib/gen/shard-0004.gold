@entry 2987ee5c181d1188
kind: step
verb: sort
noun: condition
modifier: unique
context: cache
phrase: sort unique items satisfying condition {p} into cache
phrase: order distinct elements meeting condition {p} in cache
slot: p pred
test: list=5,2,8,2,5,1,8 p=is_even
expect: => i=2 r=0.0 ok=true s="cached 2 unique sorted items" errors=0 n=2 res=[2,8] cache=2 hits=0
test: list=3,5,7 p=is_even
expect: => i=0 r=0.0 ok=true s="cached 0 unique sorted items" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var u_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if ${p}(x) {
			var exists = false;
			for j in u_cnt {
				if u[j] == x { exists = true; break; }
			}
			if !exists {
				u[u_cnt] = x;
				u_cnt++;
			}
		}
	}
	for i in u_cnt {
		for j in (i + 1)..u_cnt {
			if u[j] < u[i] {
				let tmp = u[i];
				u[i] = u[j];
				u[j] = tmp;
			}
		}
	}
	for i in u_cnt {
		gold_cache_put(g, i, u[i]);
		g.res[i] = u[i];
	}
	g.n = u_cnt;
	g.steps += u_cnt * 2 + 1;
	out.i = u_cnt;
	out.s.clear();
	format(out.s, "cached ", u_cnt, " unique sorted items");
	out
}
@end
