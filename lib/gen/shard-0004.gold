@entry e656ae0225fa2fef
kind: step
verb: fill
noun: letters
modifier: sorted
context: text
phrase: fill sorted letter bytes into results
phrase: collect sorted alphabetic characters into results
test: text="banana"
expect: => i=6 r=0.0 ok=true s="filled 6 sorted letters" errors=0 n=6 res=[97,97,97,98,110,110] cache=0 hits=0
test: text="fedcba"
expect: => i=6 r=0.0 ok=true s="filled 6 sorted letters" errors=0 n=6 res=[97,98,99,100,101,102] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var letters byte[..200] = "";
    for i in out.s.len {
        let ch = out.s[i];
        let is_letter = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
        if is_letter && letters.len < 200 {
            letters.push(ch);
        }
    }
    for i in letters.len {
        gold_push(g, letters[i] as int);
    }
    for i in letters.len {
        for j in letters.len - 1 - i {
            if g.res[j] > g.res[j + 1] {
                let tmp = g.res[j];
                g.res[j] = g.res[j + 1];
                g.res[j + 1] = tmp;
            }
        }
    }
    g.steps += letters.len;
    out.i = letters.len;
    out.s.clear();
    format(out.s, "filled ", letters.len, " sorted letters");
    out
}
@end
