@entry 21d7afa9401d06ad
kind: step
verb: compare
noun: gaps
modifier: at_most
context: compare
phrase: compare gaps to at most ceiling {max_gap}
phrase: verify consecutive gaps do not exceed {max_gap}
slot: max_gap int
test: list=10,13,15,18 max_gap=4
expect: => i=1 r=0.0 ok=true s="gaps within limit" errors=0 n=4 res=[10,13,15,18] cache=0 hits=0
test: list=10,20 max_gap=5
expect: => i=0 r=0.0 ok=false s="gap exceeded limit" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 {
		gold_fail(g, "need at least two items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var ok_gap = true;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d > mg {
			ok_gap = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = ok_gap;
	out.i = if ok_gap { 1 } else { 0 };
	out.s.clear();
	format(out.s, if ok_gap { "gaps within limit" } else { "gap exceeded limit" });
	out
}
@end
