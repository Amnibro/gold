@entry 8e1d1b13a3c59cd8
kind: step
verb: cache
noun: streak
modifier: all
context: list
phrase: cache all equal streak lengths in sequence
phrase: record lengths of all streaks to cache
test: list=1,1,2,3,3,3,4
expect: => i=4 r=0.0 ok=true s="cached 4 distinct streaks" errors=0 n=7 res=[1,1,2,3,3,3,4] cache=4 hits=0
test: list=5,5,5,6,6,7
expect: => i=3 r=0.0 ok=true s="cached 3 distinct streaks" errors=0 n=6 res=[5,5,5,6,6,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var streak_idx = 0;
    var i = 0;
    while i < g.n {
        var j = i;
        while j < g.n && g.res[j] == g.res[i] { j++; }
        let len = j - i;
        gold_cache_put(g, streak_idx, len);
        streak_idx++;
        i = j;
    }
    g.steps += g.n;
    out.i = streak_idx;
    out.s.clear();
    format(out.s, "cached ", streak_idx, " distinct streaks");
    out
}
@end
