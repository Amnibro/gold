slot: high int
test: list=2,15,8,12,3 low=10 high=20
expect: => i=1 r=0.0 ok=true s="swapped matching runs between limits" errors=0 n=5 res=[2,12,8,15,3] cache=0 hits=0
test: list=25,5,18,9 low=10 high=20
expect: => i=0 r=0.0 ok=true s="swapped matching runs between limits" errors=0 n=4 res=[25,5,18,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var idx1 = -1;
	var idx2 = -1;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			if idx1 < 0 { idx1 = i; }
			else if idx2 < 0 { idx2 = i; }
		}
	}
	var swaps = 0;
	if idx1 >= 0 && idx2 >= 0 {
		let tmp = g.res[idx1];
		g.res[idx1] = g.res[idx2];
		g.res[idx2] = tmp;
		swaps = 1;
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	out.s.append("swapped matching runs between limits");
	out
}
@end
