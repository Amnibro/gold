		j--;
	}
	out.s.clear();
	if odds > 0 {
		out.i = odds;
		out.s.append("odd numbers found in reverse scan");
	} else {
		out.i = 0;
		out.s.append("no odd numbers found");
	}
	g.steps += g.n + 1;
	out
}
@end
