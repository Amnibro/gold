modifier: while
context: math
phrase: find equal adjacent pairs while condition {chk} holds
phrase: count matching consecutive pairs while meeting {chk}
slot: chk pred
test: list=2,2,4,4,5,5,8 chk=is_even
expect: => i=2 r=0.0 ok=true s="found 2 qualifying pairs" errors=0 n=7 res=[2,2,4,4,5,5,8] cache=0 hits=0
test: list=1,1,3,3,6,6 chk=is_odd
expect: => i=2 r=0.0 ok=true s="found 2 qualifying pairs" errors=0 n=6 res=[1,1,3,3,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var pairs = 0;
    var i = 0;
    while i + 1 < g.n {
        if !${chk}(g.res[i]) { break; }
        if g.res[i] == g.res[i + 1] {
            pairs++;
            i += 2;
        } else {
            i++;
        }
    }
    g.steps += g.n;
    out.i = pairs;
    out.s.clear();
    format(out.s, "found ", pairs, " qualifying pairs");
    out
}
@end
