fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen { uniq++; }
	}
	g.steps += g.n;
	out.i = uniq;
	out.s.clear();
	out.s.append("found unique history count");
	out
}
@end
