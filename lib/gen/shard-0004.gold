code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let half = g.n / 2;
		for k in half {
			let tmp = g.res[k];
			g.res[k] = g.res[g.n - 1 - k];
			g.res[g.n - 1 - k] = tmp;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "swapped sequence of ", g.n, " items in reverse");
	out
}
@end
