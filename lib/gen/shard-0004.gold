fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var temp = [0; 512];
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { freq++; }
		}
		if freq == 1 {
