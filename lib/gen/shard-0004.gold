fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx = -1;
	for i in g.n {
		if g.res[i] == out.i {
			idx = i;
			break;
		}
	}
	if idx >= 0 {
		var lo = 0;
		var hi = idx;
		while lo < hi {
			let tmp = g.res[lo];
			g.res[lo] = g.res[hi];
			g.res[hi] = tmp;
			lo++;
			hi--;
		}
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "reversed up to index ", idx);
	out
}
@end
