fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = min(g.n, 4);
	var maxs int[64] = [0; 64];
	var mc = 0;
	var i = 0;
	while i < limit - 1 {
		let m = if g.res[i] >= g.res[i+1] { g.res[i] } else { g.res[i+1] };
		if mc < 64 { maxs[mc] = m; mc++; }
		i++;
	}
	gold_clear(g);
	for k in mc { gold_push(g, maxs[k]); }
	g.steps += limit;
	out.i = mc;
	out.s.clear();
	format(out.s, "joined maximums count ", mc);
	out
}
@end
