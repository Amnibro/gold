fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 == 0 {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	for i in kept / 2 {
		let j = kept - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "reversed unique evens ", kept);
	out
}
@end
