code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var found = false;
	var gap = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > thresh {
				gap = diff;
				found = true;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = gap;
	out.s.clear();
	if found {
		format(out.s, "first gap: ", gap);
	} else {
		format(out.s, "no gap exceeding threshold");
	}
	out
}
@end
