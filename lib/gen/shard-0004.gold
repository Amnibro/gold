fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = if g.n > 0 { g.res[0] } else { 0 };
		out.s.clear();
		format(out.s, "single");
		return out;
	}
	var max_sum = g.res[0] + g.res[1];
	for k in 1..(g.n - 1) {
		let s = g.res[k] + g.res[k + 1];
		if s > max_sum {
			max_sum = s;
		}
	}
	out.i = max_sum;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "max window sum ", max_sum);
	out
}
@end
