fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty totals to rank");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty totals");
		return out;
	}
	var totals int[64] = [0; 64];
	var cur = 0;
	let count = min(g.n, 64);
	for i in count {
		cur += g.res[i];
		totals[i] = cur;
	}
	var ranks int[64] = [0; 64];
	for a in count {
		var r = 1;
		for b in count {
			if totals[b] < totals[a] { r++; }
		}
		ranks[a] = r;
	}
	gold_clear(g);
	for k in count { gold_push(g, ranks[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "ranked cumulative totals count ", count);
	out
}
@end
