	var out = v;
	var sum = 0;
	var stopped = false;
	for k in g.n {
		let x = g.res[k];
		if !core_is_prime(x) {
			stopped = true;
			gold_fail(g, "composite number encountered");
			break;
		}
		sum += x;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	if stopped {
		out.s.append("stopped at composite element");
	} else {
		out.s.append("folded entire prime sequence");
	}
	out
}
