test: list=10,10
expect: => i=1 r=0.0 ok=true s="aggregated runs in place" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var cur_val = g.res[0];
	var cur_sum = cur_val;
	var kept = 0;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_sum += g.res[i];
		} else {
			g.res[kept] = cur_sum;
			kept++;
			cur_val = g.res[i];
			cur_sum = cur_val;
		}
	}
	g.res[kept] = cur_sum;
	kept++;
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("aggregated runs in place");
	out
}
@end
