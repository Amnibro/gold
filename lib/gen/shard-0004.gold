code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	var bound = lim;
	if bound > g.n { bound = g.n; }
	if bound > 1 {
		for i in bound {
			for j in (bound - 1) {
				if g.res[j] > g.res[j + 1] {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
		}
	}
	g.steps += bound;
	out.i = bound;
	out.s.clear();
	format(out.s, "merged prefix sequence until ", bound);
	out
}
@end
