fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var adjusted = 0;
	var p = 0;
	while p + 1 < g.n {
		if g.res[p] == g.res[p + 1] {
			g.res[p + 1] = g.res[p] + 1;
			adjusted++;
		}
		p += 2;
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted pairs ", adjusted);
	out
}
