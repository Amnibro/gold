fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = false;
		return out;
	}
	var cum = 0;
	var i = g.n - 1;
	while i >= 0 {
		cum += g.res[i];
		g.res[i] = cum;
		i--;
	}
	out.i = cum;
	out.ok = true;
	out.s.clear();
	format(out.s, "joined reversed tally total ", cum);
	g.steps += g.n;
	out
}
@end
@entry 86285430d0b7b936
kind: step
verb: sort
noun: evens
modifier: safely
context: stats
phrase: sort even sample statistics safely preserving odd positions
phrase: order even observation tallies safely within distribution
test: list=8,3,4,1,2
expect: => i=3 r=0.0 ok=true s="safely sorted even metrics 3" errors=0 n=5 res=[2,3,4,1,8] cache=0 hits=0
test: list=10,5,6,7
expect: => i=2 r=0.0 ok=true s="safely sorted even metrics 2" errors=0 n=4 res=[6,5,10,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			even_count++;
		}
	}
	if even_count <= 1 {
		out.i = even_count;
		out.ok = false;
		return out;
	}
	var i = 0;
	while i < g.n {
		if g.res[i] % 2 == 0 {
			var j = i + 1;
			while j < g.n {
				if g.res[j] % 2 == 0 && g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
		}
		i++;
	}
	out.i = even_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "safely sorted even metrics ", even_count);
	g.steps += even_count * even_count;
	out
}
@end
@entry 6d6e811d16f5c81e
kind: step
verb: dedupe
noun: histogram
modifier: safely
context: stats
phrase: dedupe histogram bin counts safely in distribution
phrase: remove duplicate histogram frequencies safely from sample bins
test: list=10,20,10,30,20,40
expect: => i=4 r=0.0 ok=true s="safely deduped histogram bins 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,5,5
expect: => i=1 r=0.0 ok=true s="safely deduped histogram bins 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		out.ok = true;
		return out;
	}
	var unique_bins = 0;
	var write_pos = 0;
	for i in g.n {
		var seen = false;
		for j in write_pos {
			if g.res[j] == g.res[i] {
				seen = true;
			}
		}
		if !seen {
			g.res[write_pos] = g.res[i];
			write_pos++;
			unique_bins++;
		}
	}
	let removed = g.n - unique_bins;
	g.n = write_pos;
	out.i = unique_bins;
	out.ok = removed > 0;
	out.s.clear();
	format(out.s, "safely deduped histogram bins ", unique_bins);
	g.steps += g.n * g.n;
	out
}
@end
