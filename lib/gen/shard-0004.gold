fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	for j in g.n {
		g.res[j] = g.res[j] - avg;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "centered elements by average ", avg);
	out
}
