test: list=1,1,2,2,3,3 max_removals=2
expect: => i=2 r=0.0 ok=true s="deduped streak: removed 2" errors=0 n=4 res=[1,2,3,3] cache=4 hits=0
test: list=4,4,4 max_removals=0
expect: => i=0 r=0.0 ok=true s="deduped streak: removed 0" errors=0 n=3 res=[4,4,4] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_removals};
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "dedupe streak skipped");
		return out;
	}
	var w = 1;
	var removed = 0;
	gold_cache_put(g, 0, g.res[0]);
	for i in 1..g.n {
		let x = g.res[i];
		if x == g.res[w - 1] && removed < limit {
			removed++;
		} else {
			g.res[w] = x;
			gold_cache_put(g, w, x);
			w++;
		}
	}
	g.n = w;
	g.steps += g.n + removed + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped streak: removed ", removed);
	out
}
@end
