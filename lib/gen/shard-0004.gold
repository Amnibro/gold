expect: => i=10 r=0.0 ok=true s="errors 10 reaches threshold: true" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: list=1,3,2 threshold=2
expect: => i=1 r=0.0 ok=false s="errors 1 reaches threshold: false" errors=0 n=3 res=[1,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var inv = 0;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] { inv++; }
			}
		}
	}
	let reaches = inv >= th;
	g.steps += g.n;
	out.i = inv;
	out.ok = reaches;
	out.s.clear();
	format(out.s, "errors ", inv, " reaches threshold: ", reaches);
	out
}
@end
