fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if t <= 0 {
		gold_fail(g, "times must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid times");
		return out;
	}
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	let shift = t % g.n;
	var k = 0;
	while k < shift {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		k++;
	}
	g.steps += g.n + shift;
	out.i = shift;
	out.s.clear();
	format(out.s, "rotated cache times ", shift);
	out
}
@end
