fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	if g.n >= 2 {
		let tail = g.res[g.n - 1];
		for i in g.n - 1 {
			if g.res[i] > tail { is_sorted = false; break; }
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.s.clear();
	format(out.s, "tail dominance confirmed ", is_sorted);
	out
}
