phrase: cap identical consecutive items at limit {cap}
slot: cap int
test: list=1,1,1,2,2,3 cap=2
expect: => i=5 r=0.0 ok=true s="capped consecutive duplicates" errors=0 n=5 res=[1,1,2,2,3] cache=0 hits=0
