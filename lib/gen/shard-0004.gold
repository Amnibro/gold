fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let padding = ${pad};
    var res byte[..200] = "";
    for c in out.s {
        if c == ' ' {
            for k in padding {
                if res.len < 195 { res.push(' '); }
            }
        } else {
            if res.len < 195 { res.push(c); }
        }
    }
    g.steps += out.s.len;
    out.s.clear();
    out.s.append(res);
    out.i = res.len;
    out
}
@end
