kind: step
verb: reverse
noun: window
modifier: nested
context: loop
phrase: reverse window nested blocks of size {span}
phrase: invert each subwindow with length {span}
slot: span int
test: list=1,2,3,4,5,6 span=3
expect: => i=6 r=0.0 ok=true s="reversed nested window blocks" errors=0 n=6 res=[3,2,1,6,5,4] cache=0 hits=0
test: list=10,20,30,40 span=2
expect: => i=4 r=0.0 ok=true s="reversed nested window blocks" errors=0 n=4 res=[20,10,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${span};
	if sz > 1 {
		var i = 0;
		while i + sz <= g.n {
			var l = i;
			var r = i + sz - 1;
			while l < r {
				let tmp = g.res[l];
				g.res[l] = g.res[r];
				g.res[r] = tmp;
				l++;
				r--;
			}
			i += sz;
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	out.s.append("reversed nested window blocks");
	out
}
@end
