@entry 6f82e4cb7fdff2df
kind: step
verb: scan
noun: streak
modifier: at_most
context: stats
phrase: scan consecutive positive streak at most {limit}
phrase: measure positive streak capped at {limit}
slot: limit int
test: list=1,2,3,-1,4 limit=5
expect: => i=3 r=0.0 ok=true s="streak: 3" errors=0 n=5 res=[1,2,3,-1,4] cache=0 hits=0
test: list=1,2,3,4,5 limit=2
expect: => i=2 r=0.0 ok=true s="streak: 2" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var cur = 0;
	var max_streak = 0;
	for i in g.n {
		if g.res[i] > 0 {
			cur += 1;
			if cur > max_streak { max_streak = cur; }
		} else {
			cur = 0;
		}
	}
	if max_streak > lim { max_streak = lim; }
	g.steps += g.n;
	out.i = max_streak;
	out.ok = true;
	out.s.clear();
	format(out.s, "streak: ", max_streak);
	out
}
@end
