code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_val};
	if g.n == 0 {
		gold_fail(g, "empty results to validate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty results");
		return out;
	}
	var valid = true;
	for i in g.n {
		if g.res[i] < m {
			valid = false;
			break;
		}
	}
	if !valid {
		gold_fail(g, "number below minimum requirement");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: validation failed");
		return out;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "validated items at least ", m);
	out
}
@end
