fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "none: list too short for gaps");
		return out;
	}
	var max_gap = 0;
	var all_zero = true;
	for i in (g.n - 1) {
