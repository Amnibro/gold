fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${bound};
	var w = 0;
	for i in 0..g.n {
		let val = g.res[i];
		if val <= ceiling && core_is_prime(val) {
			g.res[w] = val;
			w++;
		}
	}
	g.n = w;
	if w > 1 {
		for i in 0..(w - 1) {
			for j in (i + 1)..w {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = w;
	out
}
@end
