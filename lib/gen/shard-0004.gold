noun: histogram
modifier: with_retry
context: core
phrase: normalize histogram peaks within retry limit {retries}
phrase: balance distribution heights using budget {retries}
slot: retries int
test: list=40,80,120,60 retries=3
expect: => i=3 r=0.0 ok=true s="histogram retries executed 3" errors=0 n=4 res=[40,40,30,60] cache=0 hits=0
test: list=15,25,30 retries=2
expect: => i=2 r=0.0 ok=true s="histogram retries executed 2" errors=0 n=3 res=[15,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${retries};
    var rounds = 0;
    while rounds < limit {
        var max_idx = 0;
        for i in 1..g.n {
            if g.res[i] > g.res[max_idx] { max_idx = i; }
        }
        if g.res[max_idx] <= 20 { break; }
        g.res[max_idx] = g.res[max_idx] / 2;
        rounds++;
    }
    g.steps += rounds;
    out.i = rounds;
    out.s.clear();
    format(out.s, "histogram retries executed ", rounds);
    out
}
@end
