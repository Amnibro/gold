code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for nested sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var tot = 0;
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		tot += if diff < 0 { -diff } else { diff };
	}
	g.res[0] = tot;
	g.n = 1;
	g.steps += 1;
	out.i = tot;
	out.s.clear();
	format(out.s, "nested step sum is ", tot);
	out
}
@end
@entry 5e17beef6c04dedd
kind: step
verb: rotate
noun: tail
modifier: in_place
context: search
phrase: rotate search tail in place by {count} elements
phrase: cyclically rotate tail in place with span {count}
slot: count int
test: list=10,20,30,40 count=3
expect: => i=3 r=0.0 ok=true s="rotated tail span 3" errors=0 n=4 res=[10,40,20,30] cache=0 hits=0
test: list=5,15 count=1
expect: => i=0 r=0.0 ok=true s="tail rotation skipped" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 1 || g.n < 2 {
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "tail rotation skipped");
		return out;
	}
	let span = min(k, g.n);
	let start = g.n - span;
	let last_val = g.res[g.n - 1];
	var j = g.n - 1;
	while j > start {
		g.res[j] = g.res[j - 1];
		j--;
	}
	g.res[start] = last_val;
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "rotated tail span ", span);
	out
}
@end
@entry d6111b97f879687f
kind: step
verb: rank
noun: primes
modifier: at_least
context: search
phrase: rank prime candidates at least {threshold}
phrase: order prime search items at least {threshold}
slot: threshold int
test: list=2,3,4,5,6,7 threshold=4
expect: => i=2 r=0.0 ok=true s="ranked 2 primes" errors=0 n=2 res=[7,5] cache=0 hits=0
test: list=10,12,15 threshold=2
expect: => i=0 r=0.0 ok=true s="ranked 0 primes" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var w = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= th && ${ID}_is_prime(x) {
			g.res[w] = x;
			w++;
		}
	}
	for i in w {
		for j in (i + 1)..w {
			if g.res[j] > g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.n = w;
	g.steps += w * 2 + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "ranked ", w, " primes");
	out
}
@end
