test: list=1,3,6 cycles=4
expect: => i=10 r=0.0 ok=true s="final 10" errors=0 n=3 res=[1,3,10] cache=0 hits=0
test: list=2,5 cycles=3
expect: => i=5 r=0.0 ok=false s="final 5" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${cycles};
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		let is_even = (last_val % 2 == 0);
		out.ok = is_even;
		if is_even {
			g.res[g.n - 1] = last_val + k;
		}
		out.i = g.res[g.n - 1];
	} else {
		out.ok = false;
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "final ", out.i);
	out
}
@end
