@entry 03d11f5fa4f73f68
kind: step
verb: map
noun: budget
modifier: safely
context: sort
phrase: map sort operations safely within step budget {budget}
phrase: apply sorting passes safely bounded by budget {budget}
slot: budget int
test: list=4,2,3,1 budget=10
expect: => i=4 r=0.0 ok=true s="safely completed passes: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,1 budget=2
expect: => i=2 r=0.0 ok=true s="safely completed passes: 2" errors=0 n=2 res=[1,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var passes = 0;
	if g.n > 1 {
		for i in g.n {
			if passes >= b { break; }
			for j in (g.n - 1) {
				if g.res[j] > g.res[j + 1] {
					let t = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = t;
				}
			}
			passes++;
		}
	}
	g.steps += passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "safely completed passes: ", passes);
	out
}
@end
