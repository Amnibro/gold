@entry 2b510e2f8339201c
kind: step
verb: clamp
noun: average
modifier: until
context: retry
phrase: clamp retry average until condition {stop}
phrase: bound average attempt delay until {stop}
slot: stop pred
test: list=10,20,30,40 stop=is_even
expect: => i=0 r=0.0 ok=true s="clamped average until condition 0" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5 stop=over_100
expect: => i=0 r=0.0 ok=true s="clamped average until condition 0" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty results for clamp average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no retry items");
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	var clamped = 0;
	var i = 0;
	while i < g.n && !${stop}(g.res[i]) {
		if g.res[i] > avg {
			g.res[i] = avg;
			clamped++;
		}
		i++;
	}
	g.steps += clamped + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped average until condition ", clamped);
	out
}
@end
@entry 38811024469ecb11
kind: step
verb: fold
noun: limit
modifier: unique
context: retry
phrase: fold limit unique values up to bound {max_sum}
phrase: accumulate unique retry values within bound {max_sum}
slot: max_sum int
test: list=2,2,3,4 max_sum=10
expect: => i=9 r=0.0 ok=true s="folded unique sum 9" errors=0 n=1 res=[9] cache=0 hits=0
test: list=5,10 max_sum=0
expect: => i=0 r=0.0 ok=false s="error: invalid bound" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${max_sum};
	if bound <= 0 {
		gold_fail(g, "bound must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bound");
		return out;
	}
	var total = 0;
	var seen int[64] = [0; 64];
	var seen_count = 0;
	for i in g.n {
		var is_dup = false;
		for j in seen_count {
			if seen[j] == g.res[i] {
				is_dup = true;
				break;
			}
		}
		if !is_dup && seen_count < 64 {
			seen[seen_count] = g.res[i];
			seen_count++;
			if total + g.res[i] <= bound {
				total += g.res[i];
			}
		}
	}
	gold_clear(g);
	gold_push(g, total);
	g.steps += seen_count;
	out.i = total;
	out.s.clear();
	format(out.s, "folded unique sum ", total);
	out
}
@end
