expect: => i=4 r=0.0 ok=true s="filtered pairwise subfunction count 4" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3 pred_check=is_even
expect: => i=2 r=0.0 ok=true s="filtered pairwise subfunction count 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need multiple items for pairwise subfunction filter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: too few items");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		if ${pred_check}(sum) {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
		}
		i += 2;
	}
	if kept == 0 {
		gold_fail(g, "no pairs satisfied predicate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no matching pairs");
		return out;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered pairwise subfunction count ", kept);
	out
}
@end
