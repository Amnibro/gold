code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block_size};
	if b <= 1 || b > g.n {
		gold_fail(g, "invalid block size for rotation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid block size");
		return out;
	}
	var i = 0;
	while i + b <= g.n {
		let first = g.res[i];
		var j = i;
		while j + 1 < i + b {
			g.res[j] = g.res[j + 1];
			j++;
		}
		g.res[i + b - 1] = first;
		i += b;
	}
	g.steps += g.n;
	out.i = b;
	out.s.clear();
	format(out.s, "rotated nested blocks of size ", b);
	out
}
@end
