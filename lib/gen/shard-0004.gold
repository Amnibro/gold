fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var error_idx = -1;
    var idx = out.s.len - 1;
    while idx >= 0 {
        let ch = out.s[idx];
        let is_lower = ch >= 'a' && ch <= 'z';
        let is_upper = ch >= 'A' && ch <= 'Z';
        if !is_lower && !is_upper {
            error_idx = idx;
            break;
        }
        idx--;
    }
    g.steps += out.s.len;
    out.i = error_idx;
    out.s.clear();
    if error_idx >= 0 {
        format(out.s, "last error at index ", error_idx);
    } else {
        format(out.s, "no error characters found");
    }
    out
}
@end
