code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var max_d = 0;
	let pairs = g.n - 1;
	for i in pairs {
		let diff = g.res[i + 1] - g.res[i];
		let d = if diff < 0 { -diff } else { diff };
		if d > max_d { max_d = d; }
	}
	g.steps += pairs;
	out.i = max_d;
	out.s.clear();
	out.s.append("aggregated maximum running delta");
	out
}
@end
