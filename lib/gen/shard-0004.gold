	let avg = sum / g.n;
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	for k in old_n {
		if orig[k] <= avg { gold_push(g, orig[k]); }
	}
	for k in old_n {
		if orig[k] > avg { gold_push(g, orig[k]); }
	}
	out.i = avg;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "partitioned around avg ", avg);
	out
}
@end
