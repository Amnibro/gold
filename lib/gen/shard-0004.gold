fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var transformed = 0;
	for i in g.n {
		if g.res[i] >= 10 && g.res[i] <= 99 {
			let tens = g.res[i] / 10;
			let units = g.res[i] % 10;
			if tens > units {
				g.res[i] = units * 10 + tens;
				transformed++;
			}
		}
	}
	g.steps += g.n;
	out.i = transformed;
	out.s.clear();
	format(out.s, "sorted digits of elements count ", transformed);
	out
}
@end
