fn ${ID}_order(arr const int[:], idx int) bool {
	if idx + 1 >= arr.len { return true; }
	if arr[idx] > arr[idx + 1] { return false; }
	${ID}_order(arr, idx + 1)
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ok = ${ID}_order(g.res[..g.n], 0);
	if !ok {
		gold_fail(g, "recursive order failure detected");
		out.ok = false;
		out.s.clear();
		out.s.append("disordered list error");
	} else {
		out.s.clear();
		out.s.append("list order verified recursively");
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
