fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var count = 0;
	if g.n > 1 {
		for i in 1..g.n {
			var diff = g.res[i] - g.res[i - 1];
			if diff < 0 { diff = 0 - diff; }
			if diff > thresh { count += 1; }
		}
	}
	g.steps += g.n;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "gaps exceeding: ", count);
