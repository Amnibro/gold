fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 4 {
		for i in 1..(g.n - 1) {
			for j in (i + 1)..(g.n - 1) {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		out.i = g.n - 2;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "middle sorted");
	out
}
@end
