fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn < 2 {
		if g.n >= 2 {
			gold_cache_put(g, 1, g.res[0]);
			gold_cache_put(g, 2, g.res[1]);
		} else {
			gold_cache_put(g, 1, out.i);
			gold_cache_put(g, 2, 0);
		}
	}
	let v1, f1 = gold_cache_get(g, 1);
	let v2, f2 = gold_cache_get(g, 2);
	out.ok = (f1 && f2);
	out.i = v1 + v2;
	g.steps += 2;
	out.s.clear();
	format(out.s, "pair sum: ", out.i);
	out
}
@end
