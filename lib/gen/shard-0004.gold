fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	var running = 0;
	for k in old_n {
		if running + orig[k] > ceil {
			break;
		}
		running += orig[k];
		gold_push(g, orig[k]);
	}
	out.i = running;
	g.steps += old_n;
	out.s.clear();
	format(out.s, "retained ", g.n, " items");
