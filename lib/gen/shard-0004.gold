code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var res byte[..200] = "";
    var in_space = false;
    for c in out.s {
        if c == ' ' {
            if !in_space {
                for d in ${sep} {
                    if res.len < 195 { res.push(d); }
                }
                in_space = true;
            }
        } else {
            if res.len < 195 { res.push(c); }
            in_space = false;
        }
    }
    g.steps += out.s.len;
    out.s.clear();
    out.s.append(res);
    out.i = res.len;
    out
}
@end
