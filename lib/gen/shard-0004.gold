expect: => i=0 r=0.0 ok=true s="sorted window 0" errors=0 n=2 res=[15,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${bound};
	var l = 0;
	while l < g.n && g.res[l] < ceiling {
		l++;
	}
	if l > 1 {
		for i in 0..(l - 1) {
			for j in (i + 1)..l {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = l;
	out.s.clear();
	format(out.s, "sorted window ", l);
	out
}
@end
