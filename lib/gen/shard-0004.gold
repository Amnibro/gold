fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[evens] = g.res[i];
			evens++;
		}
	}
	if evens == 0 {
		gold_fail(g, "no even elements found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no evens");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < evens {
		g.res[kept] = g.res[i];
		kept++;
		i += 2;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " alternate evens");
	out
}
@end
