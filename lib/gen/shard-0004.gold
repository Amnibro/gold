expect: => i=0 r=0.0 ok=false s="reverse matches: 0" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    var matches = 0;
    var i = g.n - 1;
    while i >= 0 {
        let x = g.res[i];
        if x == g.res[g.n - 1 - i] {
            matches++;
        }
        i--;
    }
    g.steps += g.n;
    out.i = matches;
    out.ok = (matches == g.n);
    out.s.clear();
    format(out.s, "reverse matches: ", matches);
    out
}
@end
