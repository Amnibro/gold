@entry 6d432c4a864c4a6f
kind: pred
verb: filter
noun: histogram
modifier: between
context: filter
phrase: filter histogram peak frequency between {low} to {high}
phrase: verify histogram counts fall between {low} to {high}
slot: low int
slot: high int
test: arg=11222,5 low=2 high=4
expect: true
expect: false
test: arg=33333 low=2 high=4
expect: false
code:
fn ${ID}(n int) bool {
	let lo = ${low};
	let hi = ${high};
	var counts int[10] = [0; 10];
	var x = if n < 0 { -n } else { n };
	if x == 0 {
		counts[0] = 1;
	} else {
		while x > 0 {
			let d = x % 10;
			counts[d] = counts[d] + 1;
			x /= 10;
		}
	}
	var max_c = 0;
	for i in 10 {
		if counts[i] > max_c {
			max_c = counts[i];
		}
	}
