code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var pairs = 0;
	if g.n > 1 {
		var k = 0;
		while k + 1 < g.n {
			let sum = g.res[k] + g.res[k + 1];
			if sum <= lim { pairs++; }
			k += 2;
		}
	}
	if pairs == 0 {
		gold_fail(g, "zero pairs within limit");
		out.ok = false;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired limit sorted: ", pairs);
	out
}
@end
