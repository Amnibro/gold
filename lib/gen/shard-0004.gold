code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var num = out.i;
	if num < 0 { num = 0 - num; }
	var sum = 0;
	while num > 0 {
		sum += num % 10;
		num /= 10;
	}
	let ok = sum <= lim;
	g.steps += 1;
	out.ok = ok;
	out.i = sum;
	out.s.clear();
	format(out.s, "digit sum: ", sum);
	out
}
@end
