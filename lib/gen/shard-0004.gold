expect: => i=2 r=0.0 ok=true s="selected middle region trimming edges" errors=0 n=2 res=[30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	if d * 2 >= g.n {
		g.n = 0;
	} else {
		let new_len = g.n - d * 2;
		for i in new_len {
			g.res[i] = g.res[d + i];
		}
		g.n = new_len;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	out.s.append("selected middle region trimming edges");
	out
}
@end
