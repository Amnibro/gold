@entry 8acec12dbb041c0a
kind: step
verb: collect
noun: value
modifier: last
context: compare
phrase: collect last value exceeding cutoff {cutoff}
phrase: find trailing observation greater than {cutoff}
slot: cutoff int
test: list=10,40,20,50,5 cutoff=25
expect: => i=50 r=0.0 ok=true s="last match: 50" errors=0 n=5 res=[10,40,20,50,5] cache=0 hits=0
test: list=5,12,18 cutoff=15
expect: => i=18 r=0.0 ok=true s="last match: 18" errors=0 n=3 res=[5,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var found_val = 0;
	var found = false;
	var i = g.n;
	while i > 0 {
		i -= 1;
		if g.res[i] > cut {
			found_val = g.res[i];
			found = true;
			break;
		}
	}
	g.steps += g.n;
	out.ok = found;
	out.i = found_val;
	out.s.clear();
	if found { format(out.s, "last match: ", found_val); }
	else { format(out.s, "no match found"); }
	out
}
@end
@entry 5aff19dee0fee298
kind: step
verb: search
noun: head
modifier: with_retry
context: aggregate
phrase: search leading item with retry count {attempts}
phrase: locate first element with retry limit {attempts}
slot: attempts int
test: list=0,0,7,8 attempts=5
expect: => i=7 r=0.0 ok=true s="found 7 at step 3" errors=0 n=4 res=[0,0,7,8] cache=0 hits=0
test: list=0,0 attempts=2
expect: => i=-1 r=0.0 ok=false s="search head failed" errors=1 n=2 res=[0,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_tries = ${attempts};
	var idx = 0;
	var found = false;
	while idx < g.n && idx < max_tries {
		if g.res[idx] > 0 {
			out.i = g.res[idx];
			out.s.clear();
			format(out.s, "found ", out.i, " at step ", idx + 1);
			found = true;
			break;
		}
		idx++;
	}
	if !found {
		gold_fail(g, "search head failed");
		out.ok = false;
		out.i = -1;
		out.s.clear();
		format(out.s, "search head failed");
	}
	g.steps += idx + 1;
	out
}
@end
