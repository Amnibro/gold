@entry 7c613e0d0975bb09
kind: step
verb: run
noun: runs
modifier: in_reverse
context: transform
phrase: run runs in reverse order
phrase: invert consecutive runs in reverse
test: list=1,1,2,2
expect: => i=4 r=0.0 ok=true s="runs inverted in reverse" errors=0 n=4 res=[2,2,1,1] cache=0 hits=0
test: list=4,5,6
expect: => i=3 r=0.0 ok=true s="runs inverted in reverse" errors=0 n=3 res=[6,5,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var start = 0;
	while start < g.n {
		var end = start + 1;
		while end < g.n && g.res[end] == g.res[start] {
			end++;
		}
		let len = end - start;
		for i in len / 2 {
			let a = start + i;
			let b = end - 1 - i;
			let tmp = g.res[a];
			g.res[a] = g.res[b];
			g.res[b] = tmp;
		}
		start = end;
	}
	let half = g.n / 2;
	for i in half {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	out.s.append("runs inverted in reverse");
	out
}
@end
