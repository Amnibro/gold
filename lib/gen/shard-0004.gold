fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64] = [0; 64];
	var kc = 0;
	for i in g.n {
		let n = g.res[i];
		if n >= 2 {
			var is_prime = true;
			var d = 2;
			while d * d <= n {
				if n % d == 0 { is_prime = false; break; }
				d++;
			}
			if is_prime && kc < 64 {
				kept[kc] = n;
				kc++;
			}
		}
	}
	gold_clear(g);
	for k in kc { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kc;
	out.s.clear();
	format(out.s, "found primes count ", kc);
	out
}
