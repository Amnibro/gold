code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let limit = ${max_err};
    var errs = 0;
    var idx = 1;
    while idx < out.s.len {
        let ch = out.s[idx];
        let is_letter = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
        if !is_letter {
            errs++;
            if errs >= limit {
                gold_fail(g, "error limit exceeded on alternating step");
                break;
            }
        }
        idx += 2;
    }
    g.steps += idx;
    out.i = errs;
    out.s.clear();
    format(out.s, "counted ", errs, " alternating errors");
    out
}
@end
