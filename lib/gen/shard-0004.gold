fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var words = 0;
	var in_word = false;
	for i in out.s.len {
		if words >= lim { break; }
		let c = out.s[i];
		if c != ' ' && c != '\t' && c != '\n' {
			if !in_word {
				words++;
				in_word = true;
			}
		} else {
			in_word = false;
		}
	}
	g.steps += words;
	out.i = words;
	gold_push(g, words);
	out
}
