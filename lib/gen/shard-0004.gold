context: search
phrase: filter first {k} elements of tail
phrase: keep initial {k} tail elements in search
slot: k int
test: list=1,2,3,4,5,6 k=3
expect: => i=3 r=0.0 ok=true s="kept 3 tail elements" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20 k=10
expect: => i=2 r=0.0 ok=true s="kept 2 tail elements" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || g.n == 0 {
		gold_clear(g);
		g.steps += 1;
		out.i = 0;
		out.s.clear();
		format(out.s, "filtered entire tail to empty");
		return out;
	}
	let span = min(k, g.n);
	let start = g.n - span;
	for i in span {
		g.res[i] = g.res[start + i];
	}
	g.n = span;
	g.steps += span + 1;
	out.i = span;
	out.s.clear();
	format(out.s, "kept ", span, " tail elements");
	out
}
@end
@entry f01d7c5579270a39
kind: step
verb: clamp
noun: threshold
modifier: with_retry
context: search
phrase: clamp threshold to {limit} with {retries} retries
phrase: adjust threshold limit {limit} with retry count {retries}
slot: limit int
slot: retries int
test: list=50,60,70 limit=40 retries=2
expect: => i=3 r=0.0 ok=true s="clamped with 2 retries, changes 3" errors=0 n=3 res=[40,40,40] cache=0 hits=0
test: list=10,20 limit=30 retries=1
expect: => i=0 r=0.0 ok=true s="clamped with 1 retries, changes 0" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let ret = max(1, ${retries});
	var clamped = 0;
	var attempt = 0;
	while attempt < ret {
		attempt++;
		for i in g.n {
			if g.res[i] > lim {
				g.res[i] = lim;
				clamped++;
			}
		}
	}
	g.steps += g.n * attempt + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped with ", attempt, " retries, changes ", clamped);
	out
}
@end
