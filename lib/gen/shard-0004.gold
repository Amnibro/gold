fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let limit_occ = ${times};
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var kept = 0;
	var seen_max = 0;
	for i in g.n {
		if g.res[i] == max_val {
			if seen_max < limit_occ {
				g.res[kept] = g.res[i];
				kept++;
				seen_max++;
			}
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered maximum times");
	out
}
@end
