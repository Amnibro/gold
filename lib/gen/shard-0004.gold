fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matches = [0; 512];
	var count = 0;
	for i in g.n {
		if ${pred}(g.res[i]) {
			matches[count] = i;
			count++;
		}
	}
	if count > 1 {
		var l = 0;
		var r = count - 1;
		while l < r {
			let idx_l = matches[l];
			let idx_r = matches[r];
			let tmp = g.res[idx_l];
			g.res[idx_l] = g.res[idx_r];
			g.res[idx_r] = tmp;
			l++;
			r--;
		}
	}
	g.steps += g.n + count;
	out.i = count;
	out.s.clear();
	out.s.append("reversed matching condition items");
	out
}
@end
