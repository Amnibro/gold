slot: min_sum int
test: list=2,2,2,5,1,1 min_sum=5
expect: => i=2 r=0.0 ok=true s="filtered run sums" errors=0 n=2 res=[6,5] cache=0 hits=0
test: list=3,3,10 min_sum=8
expect: => i=1 r=0.0 ok=true s="filtered run sums" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let floor_sum = ${min_sum};
	var kept = 0;
	var cur_val = g.res[0];
	var cur_sum = cur_val;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_sum += g.res[i];
		} else {
			if cur_sum >= floor_sum {
				g.res[kept] = cur_sum;
				kept++;
			}
			cur_val = g.res[i];
			cur_sum = cur_val;
		}
	}
	if cur_sum >= floor_sum {
		g.res[kept] = cur_sum;
		kept++;
	}
	g.n = kept;
	g.steps += 1;
	out.i = kept;
	out.s.clear();
	out.s.append("filtered run sums");
	out
}
@end
