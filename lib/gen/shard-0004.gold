fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var exists = false;
		for j in u {
			if g.res[j] == x { exists = true; break; }
		}
		if !exists {
			g.res[u] = x;
			u++;
		}
	}
	let orig = g.n;
	g.n = u;
	g.steps += orig + 1;
	out.i = u;
	out.s.clear();
	format(out.s, "deduped tally ", u, " distinct from ", orig);
	out
}
@end
