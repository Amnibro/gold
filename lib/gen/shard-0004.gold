test: list=1,2,3,10,11,12,13
expect: => i=7 r=0.0 ok=true s="kept streak with cache: 7" errors=0 n=7 res=[1,2,3,10,11,12,13] cache=1 hits=0
test: list=5,4,3
expect: => i=1 r=0.0 ok=true s="kept streak with cache: 1" errors=0 n=3 res=[5,4,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	if g.n > 0 {
		cur_streak = 1;
		max_streak = 1;
		for k in (g.n - 1) {
			if g.res[k + 1] >= g.res[k] {
				cur_streak++;
				if cur_streak > max_streak { max_streak = cur_streak; }
			} else {
				cur_streak = 1;
			}
		}
	}
	gold_cache_put(g, g.n, max_streak);
	g.steps += g.n;
	out.i = max_streak;
	out.s.clear();
	format(out.s, "kept streak with cache: ", max_streak);
	out
}
@end
@entry 2a81fc8250b77de9
kind: step
verb: reverse
noun: condition
modifier: running
context: retry
phrase: reverse elements while running condition holds {p}
phrase: invert running items satisfying condition {p}
slot: p pred
test: list=2,4,6,3,5 p=is_even
expect: => i=3 r=0.0 ok=true s="reversed condition running: 3" errors=0 n=5 res=[6,4,2,3,5] cache=0 hits=0
test: list=1,3 p=is_even
expect: => i=0 r=0.0 ok=false s="reversed condition running: 0" errors=1 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prefix_len = 0;
	while prefix_len < g.n && ${p}(g.res[prefix_len]) {
		prefix_len++;
	}
	if prefix_len > 1 {
		let half = prefix_len / 2;
		for k in half {
			let t = g.res[k];
			g.res[k] = g.res[prefix_len - 1 - k];
			g.res[prefix_len - 1 - k] = t;
		}
	} else if prefix_len == 0 {
		gold_fail(g, "zero elements satisfied condition");
		out.ok = false;
	}
	g.steps += prefix_len;
	out.i = prefix_len;
	out.s.clear();
	format(out.s, "reversed condition running: ", prefix_len);
	out
}
@end
