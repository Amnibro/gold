code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var w = 0;
	var cur_val = if g.n > 0 { g.res[0] } else { 0 };
	var cur_len = 0;
	for i in g.n {
		if g.res[i] == cur_val {
			cur_len++;
		} else {
			if cur_len >= ml {
				g.res[w] = cur_val;
				w++;
				g.res[w] = cur_len;
				w++;
			}
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	if cur_len >= ml {
		g.res[w] = cur_val;
		w++;
		g.res[w] = cur_len;
		w++;
	}
	g.n = w;
	g.steps += g.n + 1;
	out.i = w / 2;
	out.s.clear();
	format(out.s, "returned ", w / 2, " matching runs");
	out
}
@end
