slot: cond pred

test: list=2,4,6 cond=is_even
expect: => i=1 r=0.0 ok=true s="all matched reverse status true" errors=0 n=3 res=[6,4,2] cache=0 hits=0
test: list=2,3,4 cond=is_even
expect: => i=0 r=0.0 ok=true s="all matched reverse status false" errors=0 n=3 res=[2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var all_match = true;
	for i in g.n {
		if !${cond}(g.res[i]) { all_match = false; break; }
	}
	if all_match {
		for i in g.n / 2 {
			let j = g.n - 1 - i;
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
		}
	}
	g.steps += g.n + 1;
	out.i = if all_match { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all matched reverse status ", all_match);
	out
}
@end
