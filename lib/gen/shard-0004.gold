fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_budget = ${ceiling};
	var sum = 0;
	var count = 0;
	while count < g.n && sum + g.res[count] <= max_budget {
		sum += g.res[count];
		count++;
	}
	g.n = count;
	g.steps += count + 1;
	out.i = sum;
	out.s.clear();
	out.s.append("merged budget while under ceiling");
	out
}
@end
