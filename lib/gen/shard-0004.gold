fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var adjusted = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > md {
			g.res[i] = g.res[i - 1] + md;
			adjusted++;
		}
		gold_cache_put(g, i, g.res[i]);
	}
	g.steps += g.n + 1;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "clamped pairs sorted: ", adjusted, " adjusted");
	out
}
@end
