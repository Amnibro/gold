code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var below int[512] = [0; 512];
	var above int[512] = [0; 512];
	var b_cnt = 0;
	var a_cnt = 0;
	for i in g.n {
		if g.res[i] <= lim {
			below[b_cnt] = g.res[i];
			b_cnt += 1;
		} else {
			above[a_cnt] = g.res[i];
			a_cnt += 1;
		}
	}
	for i in b_cnt { g.res[i] = below[i]; }
	for i in a_cnt { g.res[b_cnt + i] = above[i]; }
	g.steps += g.n;
	out.i = b_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "partitioned below: ", b_cnt);
	out
}
@end
