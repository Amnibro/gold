code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let prev, found = gold_cache_get(g, 1);
	gold_cache_put(g, 1, sum);
	let diff = if found { sum - prev } else { sum };
	g.steps += g.n + 1;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "sum: ", sum, " delta: ", diff);
	out
}
@end
