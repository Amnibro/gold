@entry 8554b956b7ec261c
kind: step
verb: pair
noun: threshold
modifier: with_cache
context: math
phrase: pair elements exceeding threshold {cutoff} using cache
phrase: form cached pairs above threshold value {cutoff}
slot: cutoff int

test: list=10,20,5,30,40 cutoff=8
expect: => i=2 r=0.0 ok=true s="computed threshold pairs 2" errors=0 n=5 res=[10,20,5,30,40] cache=1 hits=0
test: list=1,2,3 cutoff=8
expect: => i=0 r=0.0 ok=true s="computed threshold pairs 0" errors=0 n=3 res=[1,2,3] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	let cached, ok = gold_cache_get(g, cut);
	if ok {
		out.i = cached;
		out.s.clear();
		format(out.s, "cached threshold pairs ", cached);
		g.steps += 1;
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > cut && g.res[i + 1] > cut {
			pairs++;
			i += 2;
		} else {
			i++;
		}
	}
	gold_cache_put(g, cut, pairs);
	out.i = pairs;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "computed threshold pairs ", pairs);
	out
}
@end
