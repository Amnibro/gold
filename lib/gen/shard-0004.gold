fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let target = ${val};
    var match_count = 0;
    var even_idx = 0;
    for i in g.n {
        if g.res[i] % 2 == 0 {
            if even_idx % 2 == 0 && g.res[i] == target {
                match_count++;
            }
            even_idx++;
        }
    }
    g.steps += g.n;
    out.i = match_count;
    out.ok = (match_count > 0);
    out.s.clear();
    format(out.s, "matched alternate evens count: ", match_count);
    out
}
@end
