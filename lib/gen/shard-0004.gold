phrase: verify historical results within {tries} attempts
slot: tries int
test: list=50,20,40,10 tries=3
expect: => i=3 r=0.0 ok=true s="sorted history in 3 passes" errors=0 n=4 res=[10,20,40,50] cache=0 hits=0
test: list=30,10,20 tries=2
expect: => i=2 r=0.0 ok=true s="sorted history in 2 passes" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    let max_passes = ${tries};
    var passes = 0;
    while passes < max_passes {
        var sorted = true;
        for i in g.n - 1 {
            if g.res[i] > g.res[i + 1] {
                let tmp = g.res[i];
                g.res[i] = g.res[i + 1];
                g.res[i + 1] = tmp;
                sorted = false;
            }
        }
        passes++;
        if sorted { break; }
    }
    g.steps += passes * g.n;
    out.i = passes;
    out.s.clear();
    format(out.s, "sorted history in ", passes, " passes");
    out
}
@end
