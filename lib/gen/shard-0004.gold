code:
fn ${ID}(g Gold&, v Val) Val {
    var out = v;
    if g.n == 0 {
        out.i = 0;
        return out;
    }
    var min_val = g.res[0];
    for i in 1..g.n {
        if g.res[i] < min_val { min_val = g.res[i]; }
    }
    var kept = 0;
    for i in g.n {
        if g.res[i] != min_val {
            g.res[kept] = g.res[i];
            kept++;
        }
    }
    let dropped = g.n - kept;
    g.steps += g.n;
    g.n = kept;
    out.i = dropped;
    out.s.clear();
    format(out.s, "dropped ", dropped, " minimum items");
    out
}
@end
