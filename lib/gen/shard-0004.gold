code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	var total = 0;
	for k in pairs {
		let a = g.res[k * 2];
		let b = g.res[k * 2 + 1];
		let diff = if a > b { a - b } else { b - a };
		total += diff;
	}
	g.steps += pairs;
	out.i = total;
	out.s.clear();
	out.s.append("aggregated pairwise differences");
	out
}
@end
