code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowel_pos int[..200] = [];
	for i in out.s.len {
		let c = out.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		   c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' {
			vowel_pos.push(i);
		}
	}
	let vlen = vowel_pos.len;
	for k in vlen / 2 {
		let p1 = vowel_pos[k];
		let p2 = vowel_pos[vlen - 1 - k];
		let tmp = out.s[p1];
		out.s[p1] = out.s[p2];
		out.s[p2] = tmp;
	}
	g.steps += vlen;
	out.i = vlen;
	out
}
@end
