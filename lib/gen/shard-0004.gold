fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	let fill_val = ${val};
	var actual = c;
	if actual > g.n { actual = g.n; }
	let start = g.n - actual;
	for i in start..g.n {
		g.res[i] = fill_val;
	}
	g.steps += actual;
	out.i = actual;
	out.ok = true;
	out.s.clear();
	format(out.s, "suffix filled: ", actual);
	out
}
@end
