fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	gold_cache_put(g, 20, 100);
	var found_val = -1;
	for i in g.n {
		let cached, ok = gold_cache_get(g, g.res[i]);
		if ok && found_val == -1 {
			found_val = cached;
		}
	}
	g.steps += g.n;
	out.i = found_val;
	out.s.clear();
	if found_val >= 0 {
		gold_push(g, found_val);
		format(out.s, "found cached memo value ", found_val);
	} else {
		format(out.s, "no cached element found");
	}
	out
}
@end
@entry 26a6250f53de5efb
kind: step
verb: validate
noun: steps
modifier: pairwise
context: transform
phrase: validate steps between adjacent elements pairwise
phrase: verify step transitions between consecutive pairs
test: list=1,5,8,12
expect: => i=4 r=0.0 ok=true s="validated pairwise steps count 4" errors=0 n=4 res=[1,5,8,12] cache=0 hits=0
test: list=1,20,3
expect: => i=0 r=0.0 ok=false s="error: step limit exceeded" errors=1 n=3 res=[1,20,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	var i = 0;
	while i < g.n - 1 {
		var diff = g.res[i+1] - g.res[i];
		if diff < 0 { diff = -diff; }
		if diff > 10 { valid = false; }
		i++;
	}
	g.steps += g.n;
	if !valid {
		gold_fail(g, "pairwise step difference exceeds threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: step limit exceeded");
	} else {
		out.i = g.n;
		out.s.clear();
		format(out.s, "validated pairwise steps count ", g.n);
	}
	out
}
@end
