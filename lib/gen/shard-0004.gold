@entry 1c1e77ec97468c47
kind: step
verb: search
noun: value
modifier: with_cache
context: core
phrase: search target value utilizing cached lookup table {query}
phrase: find target entry leveraging cache query {query}
slot: query int
test: list=10,20,30 query=20
expect: => i=1 r=0.0 ok=true s="stored at 1" errors=0 n=3 res=[10,20,30] cache=1 hits=0
test: list=5,15 query=99
expect: => i=-1 r=0.0 ok=false s="not found" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${query};
	let cached_idx, found = gold_cache_get(g, target);
	if found {
		out.i = cached_idx;
		out.ok = true;
		out.s.clear();
		format(out.s, "cache hit at ", cached_idx);
	} else {
		var found_idx = -1;
		for i in 0..g.n {
			if g.res[i] == target {
				found_idx = i;
				break;
			}
		}
		if found_idx >= 0 {
			gold_cache_put(g, target, found_idx);
			out.i = found_idx;
			out.ok = true;
			out.s.clear();
			format(out.s, "stored at ", found_idx);
		} else {
			out.i = -1;
			out.ok = false;
			out.s.clear();
			format(out.s, "not found");
		}
	}
	out
}
@end
