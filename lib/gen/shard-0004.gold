	var orig int[512] = [0; 512];
	let old_n = g.n;
	for k in old_n { orig[k] = g.res[k]; }
	gold_clear(g);
	var seen int[10] = [0; 10];
	for k in old_n {
		var rem = orig[k] % 10;
