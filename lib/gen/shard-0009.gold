fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${k};
	gold_clear(g);
	var count = 0;
	for i in out.s.len {
		if count >= req { break; }
		if out.s[i] != ' ' {
			gold_push(g, out.s[i] as int);
			count++;
		}
	}
	g.steps += out.s.len;
	out.i = count;
	out.s.clear();
	format(out.s, "returned ", count, " visible values");
	out
}
