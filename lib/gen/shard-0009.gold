code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var span = k;
	if span > g.n { span = g.n; }
	let start = g.n - span;
	var num = 0;
	for i in start..g.n {
		let digit = g.res[i] % 10;
		num = num * 10 + digit;
	}
	g.steps += span;
	out.i = num;
	out.s.clear();
	format(out.s, "joined last digits to ", num);
	out
}
@end
@entry b631a61f4f453eb5
kind: step
verb: sort
noun: duplicates
modifier: first
context: math
phrase: sort duplicates first limit {limit}
phrase: order duplicates first boundary {limit}
slot: limit int
test: list=2,5,2,8,5 limit=10
expect: => i=5 r=0.0 ok=true s="sorted duplicates first" errors=0 n=5 res=[2,2,5,8,5] cache=0 hits=0
test: list=1,2,3,4 limit=5
expect: => i=4 r=0.0 ok=true s="sorted duplicates first" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	for i in g.n {
		var is_dup = false;
		for j in g.n {
			if i != j && g.res[i] == g.res[j] {
				is_dup = true;
				break;
			}
		}
		if is_dup {
			for k in (i + 1)..g.n {
				var other_dup = false;
				for j in g.n {
					if k != j && g.res[k] == g.res[j] {
						other_dup = true;
						break;
					}
				}
				if other_dup && g.res[i] > g.res[k] {
					let tmp = g.res[i];
					g.res[i] = g.res[k];
					g.res[k] = tmp;
				}
			}
		}
	}
	g.steps += g.n + lim;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted duplicates first");
	out
}
@end
