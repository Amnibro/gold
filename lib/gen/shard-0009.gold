fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var buf byte[>..] = [];
	var count = 0;
	for idx in out.s.len {
		let c = out.s[idx];
		let is_letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
		if is_letter && count < limit {
			buf.push(c);
			count++;
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len + 1;
	out.i = count;
	out
}
@end
