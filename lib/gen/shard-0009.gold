code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let item = g.res[k];
		let c, hit = gold_cache_get(g, item);
		if hit { gold_cache_put(g, item, c + 1); }
		else { gold_cache_put(g, item, 1); }
	}
	let target = ${val};
	let last_freq = if g.cn > 0 { g.cv[g.cn - 1] } else { 0 };
	let diff = last_freq - target;
	g.steps += g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "histogram diff ", diff);
	out
}
@end
