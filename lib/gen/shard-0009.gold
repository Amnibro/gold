fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_space = -1;
	for b, i in out.s {
		if b == ' ' { first_space = i; break; }
	}
	if first_space != -1 {
		let rest = out.s[(first_space + 1)..];
		let tmp = copy(rest);
		out.s.clear();
		out.s.append(tmp);
	} else {
		out.s.clear();
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
