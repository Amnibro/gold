@entry 763cf2f79394f339
kind: step
verb: compare
noun: primes
modifier: while
context: cache
phrase: compare cached primes while condition {cond} holds
phrase: evaluate prime cache hits while predicate {cond}
phrase: verify cached prime entries while {cond} is true
slot: cond pred
test: list=2,3,5,8,11 cond=is_prime
expect: => i=3 r=0.0 ok=true s="verified 3 cached primes" errors=0 n=5 res=[2,3,5,8,11] cache=5 hits=0
test: list=7,11,13,15 cond=is_odd
expect: => i=3 r=0.0 ok=true s="verified 3 cached primes" errors=0 n=4 res=[7,11,13,15] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var prime_cnt = 0;
	for i in g.cn {
		if !${cond}(g.cv[i]) { break; }
		let n = g.cv[i];
		var is_p = n >= 2;
		var d = 2;
		while d * d <= n {
			if n % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p { prime_cnt++; }
	}
	g.steps += g.cn;
	out.i = prime_cnt;
	out.s.clear();
	format(out.s, "verified ", prime_cnt, " cached primes");
	out
}
@end
