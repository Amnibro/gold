@entry fbbfc45e1492316d
kind: step
verb: split
noun: sequence
modifier: times
context: sort
phrase: split sequence into {count} sorted chunks
phrase: partition array into {count} sorted segments
phrase: divide sequence into {count} sorted blocks
slot: count int
test: list=8,2,6,1,9,3 count=2
expect: => i=2 r=0.0 ok=true s="split into 2 sorted segments" errors=0 n=6 res=[2,6,8,1,3,9] cache=0 hits=0
test: list=10,4,7,1,5,2 count=3
expect: => i=3 r=0.0 ok=true s="split into 3 sorted segments" errors=0 n=6 res=[4,10,1,7,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let chunks = ${count};
	if chunks <= 0 { return out; }
	let chunk_sz = (g.n + chunks - 1) / chunks;
	var c = 0;
	while c < chunks {
		let start = c * chunk_sz;
		let end_idx = if start + chunk_sz > g.n { g.n } else { start + chunk_sz };
		for i in start..end_idx {
			for j in (i + 1)..end_idx {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		c++;
	}
	g.steps += g.n * g.n;
	out.i = chunks;
	out.s.clear();
	format(out.s, "split into ", chunks, " sorted segments");
	out
}
@end
