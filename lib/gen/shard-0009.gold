code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var acc = 0;
	var i = g.n;
	while i > 0 {
		i--;
		acc += g.res[i];
		g.res[i] = acc;
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "tally in reverse ", acc);
	out
}
@end
@entry 141a435673cf1dac
kind: step
verb: dedupe
noun: minimum
modifier: last
context: compare
phrase: dedupe repeated minimum elements placing last
phrase: eliminate duplicate minimums shifting to last
phrase: remove recurring minimums positioning at end
test: list=2,5,2,8,2
expect: => i=2 r=0.0 ok=true s="deduped minimum last 2" errors=0 n=3 res=[5,8,2] cache=0 hits=0
test: list=1,4,1,9
expect: => i=1 r=0.0 ok=true s="deduped minimum last 1" errors=0 n=3 res=[4,9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
	}
	var others int[64];
	var o = 0;
	for i in g.n {
		if g.res[i] != min_val && o < 64 { others[o] = g.res[i]; o++; }
	}
	gold_clear(g);
	for k in o { gold_push(g, others[k]); }
	gold_push(g, min_val);
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "deduped minimum last ", min_val);
	out
}
@end
