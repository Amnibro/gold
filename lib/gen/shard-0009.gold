code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	let lo = ${low};
	let hi = ${high};
	let half = g.cn / 2;
	var found = 0;
	for k in half {
		if g.ck[k] >= lo && g.ck[k] <= hi { found++; }
	}
	g.steps += half;
	out.i = found;
	out.s.clear();
	format(out.s, "head cache keys in range ", found);
	out
}
@end
