fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		g.res[count] = diff * diff;
		count++;
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "squared pairs calculated: ", count);
	out
}
@end
