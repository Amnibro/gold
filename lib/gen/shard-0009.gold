code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var trailing = 0;
	var idx = g.n - 1;
	while idx >= 0 && g.res[idx] == 32 && trailing < c {
		trailing++;
		idx--;
	}
	g.steps += g.n;
	out.i = trailing;
	out.s.clear();
	format(out.s, "filtered ", trailing, " trailing spaces");
	out
}
@end
