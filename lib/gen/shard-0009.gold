fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if g.res[i] <= 25 { count++; }
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted budget items ", count);
	out
}
@end
