@entry d5f7454f6b66ac27
kind: step
verb: apply
noun: primes
modifier: at_most
context: sort
phrase: sort prime values clamping at most {ceiling}
phrase: cap prime values at most {ceiling} during sort
phrase: clamp prime elements to ceiling {ceiling} in sort
slot: ceiling int
test: list=7,2,11,4,13 ceiling=10
expect: => i=2 r=0.0 ok=true s="sorted and clamped 2 primes" errors=0 n=5 res=[2,4,7,10,10] cache=0 hits=0
test: list=3,15,5,19 ceiling=6
expect: => i=1 r=0.0 ok=true s="sorted and clamped 1 primes" errors=0 n=4 res=[3,5,6,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${ceiling};
	var modified = 0;
	for k in g.n {
		let n = g.res[k];
		var is_p = n >= 2;
		var d = 2;
		while d * d <= n {
			if n % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && g.res[k] > limit {
			g.res[k] = limit;
			modified++;
		}
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "sorted and clamped ", modified, " primes");
	out
}
@end
