noun: runs
modifier: at_most
context: compare
phrase: join elements from at most two runs
phrase: combine run values taking at most two segments
phrase: merge increasing runs comparing at most count
test: list=1,2,10,1,2,3,20,30
expect: => i=8 r=0.0 ok=true s="runs joined at most 8" errors=0 n=8 res=[1,2,10,1,2,3,20,30] cache=0 hits=0
test: list=5,6,7,8
expect: => i=4 r=0.0 ok=true s="runs joined at most 4" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var runs = 1;
	var cutoff = g.n;
	for i in (g.n - 1) {
		if g.res[i + 1] < g.res[i] {
			runs++;
			if runs > 2 { cutoff = i + 1; break; }
		}
	}
	var kept int[64];
	var p = 0;
	for i in cutoff {
		if p < 64 { kept[p] = g.res[i]; p++; }
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += p;
	out.i = p;
	out.s.clear();
	format(out.s, "runs joined at most ", p);
	out
}
@end
