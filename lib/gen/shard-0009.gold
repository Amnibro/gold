@entry be1276517b302f1e
kind: step
verb: sort
noun: gaps
modifier: all
context: format
phrase: format sorted differences between all consecutive items
phrase: render all consecutive gap values sorted
phrase: display all sorted gap differences string
test: list=10,25,30,50
expect: => i=3 r=0.0 ok=true s="sorted all gaps count: 3" errors=0 n=3 res=[5,15,20] cache=0 hits=0
test: list=5,12,14
expect: => i=2 r=0.0 ok=true s="sorted all gaps count: 2" errors=0 n=2 res=[2,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	var gap_cnt = g.n - 1;
	for idx in gap_cnt {
		g.res[idx] = g.res[idx + 1] - g.res[idx];
	}
	g.n = gap_cnt;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let t = g.res[a]; g.res[a] = g.res[b]; g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted all gaps count: ", g.n);
