@entry eb28ba05e354a2e9
kind: step
verb: join
noun: primes
modifier: until
context: cache
phrase: join prime cache keys until bound {lim}
phrase: collect prime keys into results until {lim}
phrase: gather prime cache entries until ceiling {lim}
slot: lim int
test: list=4,5,6,7,9 lim=8
expect: => i=2 r=0.0 ok=true s="joined prime cache keys 2" errors=0 n=2 res=[5,7] cache=5 hits=0
test: list=2,3,4,11 lim=5
expect: => i=2 r=0.0 ok=true s="joined prime cache keys 2" errors=0 n=2 res=[2,3] cache=4 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	let limit = ${lim};
	var count = 0;
	gold_clear(g);
	for k in g.cn {
		if g.ck[k] <= limit && ${ID}_is_prime(g.ck[k]) {
			gold_push(g, g.ck[k]);
			count++;
		}
	}
	g.steps += g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "joined prime cache keys ", count);
	out
}
@end
