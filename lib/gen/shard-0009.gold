expect: => i=15 r=0.0 ok=true s="range spread under bound is 15" errors=0 n=5 res=[4,12,8,19,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	if g.n == 0 { return out; }
	var min_val = 1000000;
	var max_val = -1000000;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x <= bound {
			if x < min_val { min_val = x; }
			if x > max_val { max_val = x; }
			count++;
		}
		g.steps++;
	}
	let spread = if count > 0 { max_val - min_val } else { 0 };
	out.i = spread;
	out.s.clear();
	format(out.s, "range spread under bound is ", spread);
	out
}
@end
