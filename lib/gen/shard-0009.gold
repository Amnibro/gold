@entry f520b7003079a1bc
kind: step
verb: drop
noun: maximum
modifier: with_retry
context: error
phrase: drop maximum with_retry threshold {limit}
phrase: remove maximum with_retry ceiling {limit}
slot: limit int
test: list=5,20,8 limit=15
expect: => i=20 r=0.0 ok=true s="dropped maximum value 20" errors=0 n=2 res=[5,8] cache=0 hits=0
test: list=5,8,3 limit=15
expect: => i=0 r=0.0 ok=false s="error: max below threshold" errors=1 n=3 res=[5,8,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no maximum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let lim = ${limit};
	var max_idx = 0;
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	if max_val <= lim {
		gold_fail(g, "maximum below drop threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: max below threshold");
		return out;
	}
	for i in max_idx..(g.n - 1) {
		g.res[i] = g.res[i + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "dropped maximum value ", max_val);
	out
}
@end
