expect: 3
expect: 4
test: arg=9999
expect: 1
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1; }
	var prev = x % 10;
	x /= 10;
	var runs = 1;
	while x > 0 {
		let cur = x % 10;
		if cur != prev {
			runs++;
			prev = cur;
		}
		x /= 10;
	}
	runs
}
@end
