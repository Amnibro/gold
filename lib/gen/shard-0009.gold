fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var singleton_count = 0;
	for i in g.n {
		var freq = 0;
		for j in g.n {
			if g.res[i] == g.res[j] {
				freq++;
			}
		}
		if freq == 1 {
			singleton_count++;
		}
	}
	g.steps += g.n * g.n;
	out.i = singleton_count;
	out.s.clear();
	format(out.s, "counted ", singleton_count, " non duplicate items");
	out
}
@end
