fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var normalized = 0;
	var start = g.n / 2;
	for k in start..g.n {
		if g.res[k] > cap {
			g.res[k] = cap;
			normalized++;
		}
	}
	g.steps += g.n;
	out.i = normalized;
	out.s.clear();
	format(out.s, "normalized ", normalized, " suffix elements");
	out
}
@end
