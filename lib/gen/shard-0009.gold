@entry 8495779d5e7eb603
kind: step
verb: compare
noun: sequence
modifier: with_retry
context: math
phrase: compare sequence sum against target {target} with retry
phrase: evaluate sequence against target {target} using retry
slot: target int
test: list=10,20 target=30
expect: => i=30 r=0.0 ok=true s="compared sequence with retry sum 30" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,10 target=17
expect: => i=17 r=0.0 ok=true s="compared sequence with retry sum 17" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let goal = ${target};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var matched = sum == goal;
	var tries = 0;
	while tries < 3 && !matched {
		sum += 1;
		if sum == goal { matched = true; break; }
		tries++;
	}
	out.ok = matched;
	out.i = sum;
	g.steps += tries + 1;
	out.s.clear();
	format(out.s, "compared sequence with retry sum ", sum);
	out
}
@end
@entry 546f31add70fb295
kind: step
verb: limit
noun: maximum
modifier: between
context: math
phrase: clamp maximum value between bounds {low} to {high}
phrase: limit sequence maximum between range {low} through {high}
slot: low int
slot: high int
test: list=10,60,20 low=15 high=50
expect: => i=50 r=0.0 ok=true s="clamped maximum value to 50" errors=0 n=3 res=[10,50,20] cache=0 hits=0
test: list=2,5 low=10 high=20
expect: => i=10 r=0.0 ok=true s="clamped maximum value to 10" errors=0 n=2 res=[2,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_v = ${low};
	let max_v = ${high};
	var max_idx = 0;
	if g.n > 0 {
		for i in 1..g.n {
			if g.res[i] > g.res[max_idx] { max_idx = i; }
		}
		if g.res[max_idx] < min_v {
			g.res[max_idx] = min_v;
		} else if g.res[max_idx] > max_v {
			g.res[max_idx] = max_v;
		}
		out.i = g.res[max_idx];
	} else {
		gold_push(g, min_v);
		out.i = min_v;
	}
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "clamped maximum value to ", out.i);
	out
}
@end
