test: list=2,3,5 factor=2
expect: => i=2 r=0.0 ok=true s="scaled pairs: 2" errors=0 n=2 res=[10,16] cache=0 hits=0
test: list=10,20 factor=3
expect: => i=1 r=0.0 ok=true s="scaled pairs: 1" errors=0 n=1 res=[90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var m = 0;
	if g.n > 1 {
		m = g.n - 1;
		var sums = [0; 64];
		for i in m {
			sums[i] = (g.res[i] + g.res[i + 1]) * f;
		}
		for i in m {
			g.res[i] = sums[i];
		}
		g.n = m;
	}
	out.s.clear();
	format(out.s, "scaled pairs: ", m);
	out.i = m;
	g.steps += g.n;
	out
}
@end
