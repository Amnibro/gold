fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var max_idx = 0;
		for idx in 1..g.n {
			if g.res[idx] > g.res[max_idx] { max_idx = idx; }
		}
		let max_val = g.res[max_idx];
		for idx in max_idx..(g.n - 1) {
			g.res[idx] = g.res[idx + 1];
		}
		g.res[g.n - 1] = max_val;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated max to end: ", g.n);
	out
}
@end
