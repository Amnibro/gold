@entry 76d23f597bedb22d
kind: step
verb: dedupe
noun: gaps
modifier: times
context: text
phrase: dedupe character gaps repeated {times} times
phrase: remove duplicate code gaps repeating {times} times
slot: times int
test: text="aceg" times=2
expect: => i=1 r=0.0 ok=true s="deduped to 1 unique gaps repeated 2 times" errors=0 n=2 res=[2,2] cache=0 hits=0
test: text="abdf" times=1
expect: => i=2 r=0.0 ok=true s="deduped to 2 unique gaps repeated 1 times" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	if out.s.len <= 1 {
		out.i = 0;
		return out;
	}
	var u_gaps int[512] = [0; 512];
	var un = 0;
	for i in out.s.len - 1 {
		let gap = (out.s[i + 1] as int) - (out.s[i] as int);
		var seen = false;
		for j in un {
			if u_gaps[j] == gap { seen = true; }
		}
		if !seen {
			u_gaps[un] = gap;
			un++;
		}
	}
	gold_clear(g);
	for _ in t {
		for j in un {
			gold_push(g, u_gaps[j]);
		}
	}
	g.steps += out.s.len + un * t;
	out.i = un;
	out.s.clear();
	format(out.s, "deduped to ", un, " unique gaps repeated ", t, " times");
	out
}
@end
@entry 63290e7c9e9d81cc
kind: step
verb: filter
noun: duplicates
modifier: with_retry
context: text
phrase: filter duplicate characters with retry fallback
phrase: retain recurring characters in text using retry
test: text="banana"
expect: => i=2 r=0.0 ok=true s="an" errors=0 n=0 res=[] cache=0 hits=0
test: text="cat"
expect: => i=6 r=0.0 ok=true s="ccaatt" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i];
		var count = 0;
		for j in out.s.len {
			if out.s[j] == c { count++; }
		}
		if count > 1 {
			var seen = false;
			for k in dups.len {
				if dups[k] == c { seen = true; break; }
			}
			if !seen { dups.push(c); }
		}
	}
	if dups.len == 0 && out.s.len > 0 {
		var retried byte[..200] = "";
		for i in out.s.len {
			retried.push(out.s[i]);
			retried.push(out.s[i]);
		}
		out.s.clear();
		for b in retried { out.s.push(b); }
		g.steps += out.s.len * 2;
		out.i = out.s.len;
		return out;
	}
	out.s.clear();
	for b in dups { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
