expect: => i=20 r=0.0 ok=true s="minimum up to index is 20" errors=0 n=4 res=[50,30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit_idx};
	if g.n == 0 { return out; }
	var end = lim;
	if end >= g.n { end = g.n - 1; }
	var min_val = g.res[0];
	for k in 0..(end + 1) {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	g.steps += end + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum up to index is ", min_val);
	out
}
@end
