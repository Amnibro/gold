code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_sum = 0;
	if g.n > 0 {
		var i = g.n - 1;
		loop {
			run_sum += g.res[i];
			g.res[i] = run_sum;
			if i == 0 { break; }
			i--;
		}
	}
	g.steps += g.n;
	out.i = run_sum;
	out.s.clear();
	format(out.s, "suffix sum total: ", run_sum);
	out
}
@end
