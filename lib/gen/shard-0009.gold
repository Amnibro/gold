fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
					swaps++;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "pairwise sorted search numbers ", swaps);
	out
}
@end
