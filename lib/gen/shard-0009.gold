fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[64];
	var others int[64];
	var nd = 0;
	var no = 0;
	for i in g.n {
		let x = g.res[i];
		var is_dup = false;
		for j in g.n {
			if i != j && g.res[j] == x { is_dup = true; break; }
		}
		if is_dup {
			if nd < 64 { dups[nd] = x; nd++; }
		} else {
			if no < 64 { others[no] = x; no++; }
		}
	}
	gold_clear(g);
	for k in nd { gold_push(g, dups[k]); }
	for k in no { gold_push(g, others[k]); }
	g.steps += g.n;
	out.i = nd;
	out.s.clear();
	format(out.s, "duplicates first ", nd);
	out
}
@end
