fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bins};
	if b <= 0 {
		gold_fail(g, "invalid bin count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bin count");
		return out;
	}
	var hist int[256] = [0; 256];
	for i in g.n {
		let x = g.res[i];
		if x < 0 || x >= b {
			gold_fail(g, "value exceeds bin count");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: out of bin range");
			return out;
		}
		hist[x]++;
	}
	for k in b {
		g.res[k] = hist[k];
	}
	g.n = b;
	g.steps += g.n;
	out.i = b;
	out.s.clear();
	format(out.s, "histogram grouped into ", b, " bins");
	out
}
@end
