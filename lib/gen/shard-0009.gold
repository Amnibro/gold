fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let m = g.n / 2;
	for k in m {
		var s = g.res[k * 2] + g.res[k * 2 + 1];
		if s > b { s = b; }
		g.res[k] = s;
	}
	g.n = m;
	out.i = m;
	g.steps += m;
	out
}
