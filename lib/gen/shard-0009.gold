expect: => i=5 r=0.0 ok=true s="validated 5 letters in text" errors=0 n=0 res=[] cache=0 hits=0
test: text="abc 12"
expect: => i=3 r=0.0 ok=false s="invalid character at index 3" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	for i in n {
		let c = out.s[i] as int;
		let is_lower = c >= 97 && c <= 122;
		let is_upper = c >= 65 && c <= 90;
		if !is_lower && !is_upper {
			gold_fail(g, "non-letter character");
			out.ok = false;
			out.i = i;
			out.s.clear();
			format(out.s, "invalid character at index ", i);
			return out;
		}
	}
	g.steps += n;
	out.ok = true;
	out.i = n;
	out.s.clear();
	format(out.s, "validated ", n, " letters in text");
	out
}
@end
