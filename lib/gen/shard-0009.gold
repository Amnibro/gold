kind: step
verb: measure
noun: value
modifier: with_retry
context: sort
phrase: measure sorted distance to target value {target} with retries {retries}
phrase: evaluate gap from target {target} allowing {retries} retries
slot: target int
slot: retries int
test: list=10,20,30 target=25 retries=2
expect: => i=5 r=0.0 ok=true s="closest gap to target is 5" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,15 target=50 retries=1
expect: => i=35 r=0.0 ok=true s="closest gap to target is 35" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let r = ${retries};
	var min_gap = 999999;
	for k in g.n {
		var diff = g.res[k] - tgt;
		if diff < 0 { diff = -diff; }
		if diff < min_gap {
			min_gap = diff;
		}
	}
	g.steps += g.n * (r + 1);
	out.i = min_gap;
	out.s.clear();
	format(out.s, "closest gap to target is ", min_gap);
	out
}
@end
