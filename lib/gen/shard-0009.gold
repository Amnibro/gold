fn ${ID}_is_sq(x int) bool {
	if x < 0 { return false; }
	if x == 0 { return true; }
	var r = 1;
	while r * r <= x {
		if r * r == x { return true; }
		r++;
	}
	false
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		if ${ID}_is_sq(g.res[i]) {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.s.clear();
	format(out.s, "squares kept: ", kept);
	out.i = kept;
	g.steps += g.n;
	out
}
@end
