expect: => i=4 r=0.0 ok=true s="recorded 4 unique items in memo" errors=0 n=6 res=[2,2,4,6,6,8] cache=4 hits=0
test: list=10,10,10,20
expect: => i=2 r=0.0 ok=true s="recorded 2 unique items in memo" errors=0 n=4 res=[10,10,10,20] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_count = 0;
	for k in g.n {
		let x = g.res[k];
		var exists = false;
		for i in g.cn {
			if g.ck[i] == x { exists = true; break; }
		}
		if !exists {
			gold_cache_put(g, x, 1);
			unique_count++;
		}
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "recorded ", unique_count, " unique items in memo");
	out
}
@end
