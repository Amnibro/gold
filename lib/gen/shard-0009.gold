@entry 6a997c144af21848
kind: step
verb: drop
noun: squares
modifier: sorted
context: cache
phrase: drop square numbers from cache in sorted order
phrase: remove perfect squares from cached entries
phrase: purge square values from cache storage
test: list=4,7,9,12
expect: => i=2 r=0.0 ok=true s="dropped 2 square items" errors=0 n=4 res=[4,7,9,12] cache=2 hits=0
test: list=16,20,25
expect: => i=2 r=0.0 ok=true s="dropped 2 square items" errors=0 n=3 res=[16,20,25] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var kept = 0;
	for i in g.cn {
		let n = g.cv[i];
		var is_sq = false;
		if n >= 0 {
			var r = 0;
			while r * r < n { r++; }
			if r * r == n { is_sq = true; }
		}
		if !is_sq {
			g.ck[kept] = g.ck[i];
			g.cv[kept] = g.cv[i];
			kept++;
		}
	}
	let dropped = g.cn - kept;
	g.cn = kept;
	g.steps += g.cn;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " square items");
	out
}
@end
