code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	var sorted = true;
	if g.cn > 1 {
		for k in g.cn - 1 {
			if g.ck[k] > g.ck[k + 1] {
				sorted = false;
				break;
			}
		}
	}
	g.steps += g.cn;
	out.ok = sorted;
	out.i = if sorted { g.cn } else { 0 };
	out.s.clear();
	format(out.s, "sorted cache verification ", out.i);
	out
}
@end
@entry b72247aa33f84d45
kind: step
verb: dedupe
noun: gaps
modifier: nested
context: cache
phrase: deduplicate gaps between cache keys in nested loop
phrase: collect unique gaps across cache keys
phrase: dedupe spacing gaps between cache entries
test: list=10,20,30,50
expect: => i=2 r=0.0 ok=true s="unique cache key gaps 2" errors=0 n=4 res=[10,20,30,50] cache=4 hits=0
test: list=5,15,30
expect: => i=2 r=0.0 ok=true s="unique cache key gaps 2" errors=0 n=3 res=[5,15,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	var gaps int[256] = [0; 256];
	var gn = 0;
	if g.cn > 1 {
		for k in g.cn - 1 {
			let diff = g.ck[k + 1] - g.ck[k];
			var seen = false;
			for j in gn {
				if gaps[j] == diff { seen = true; break; }
			}
			if !seen {
				gaps[gn] = diff;
				gn++;
			}
		}
	}
	g.steps += g.cn;
	out.i = gn;
	out.s.clear();
	format(out.s, "unique cache key gaps ", gn);
	out
}
@end
