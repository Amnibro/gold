@entry ace6701bbeb89ef8
kind: step
verb: repeat
noun: runs
modifier: while
context: error
phrase: repeat error runs while below threshold
phrase: duplicate error runs while under limit
slot: limit int
test: list=2,4 limit=15
expect: => i=18 r=0.0 ok=true s="repeated error runs sum 18" errors=0 n=5 res=[2,4,4,4,4] cache=0 hits=0
test: list=5,6 limit=25
expect: => i=29 r=0.0 ok=true s="repeated error runs sum 29" errors=0 n=5 res=[5,6,6,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var added = 0;
	while sum < lim && g.n < 500 && added < 10 {
		let val = if g.n > 0 { g.res[g.n - 1] } else { 1 };
		gold_push(g, val);
		sum += val;
		added++;
	}
	g.steps += added;
	out.i = sum;
	out.s.clear();
	format(out.s, "repeated error runs sum ", sum);
	out
}
@end
