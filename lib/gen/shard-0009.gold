	for i in g.n {
		if g.res[i] % 2 != 0 { break; }
		if prev >= 0 && g.res[i] < prev { valid = false; }
		prev = g.res[i];
	}
	g.steps += g.n;
	out.ok = valid;
	out.s.clear();
	format(out.s, "evens until valid ", valid);
	out
}
