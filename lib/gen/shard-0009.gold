@entry 59a04c0a1db89e97
kind: step
verb: check
noun: total
modifier: any
context: stats
phrase: check total any matches target {target}
phrase: verify prefix total equals {target}
slot: target int
test: list=1,2,3,4 target=6
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,10,15 target=50
expect: => i=0 r=0.0 ok=false s="" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var matched = false;
	for k in g.n {
		sum += g.res[k];
		if sum == tgt { matched = true; break; }
	}
	out.ok = matched;
	out.i = if matched { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
@entry d078836a07bb4538
kind: step
verb: map
noun: window
modifier: with_retry
context: stats
phrase: map window with retry size {size}
phrase: smooth window averages of span {size}
slot: size int
test: list=10,20,30,40 size=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[15,25,35,40] cache=0 hits=0
test: list=4,8,12,16,20 size=3
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[8,12,16,18,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sz = ${size};
	if sz <= 0 { sz = 1; }
	if sz > g.n { sz = g.n; }
	for i in g.n {
		var sum = 0;
		var count = 0;
		var j = i;
		while j < g.n && count < sz {
			sum += g.res[j];
			count++;
			j++;
		}
		g.res[i] = if count > 0 { sum / count } else { 0 };
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
