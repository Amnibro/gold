expect: => i=5 r=0.0 ok=true s="filled checkpoints to 5 points" errors=0 n=5 res=[10,15,20,30,40] cache=0 hits=0
test: list=0,100
expect: => i=3 r=0.0 ok=true s="filled checkpoints to 3 points" errors=0 n=3 res=[0,50,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("need points to interpolate");
		return out;
	}
	var filled int[512] = [0; 512];
	var fp = 0;
	for k in 0..(g.n - 1) {
		filled[fp] = g.res[k];
		fp++;
		filled[fp] = (g.res[k] + g.res[k + 1]) / 2;
		fp++;
	}
	filled[fp] = g.res[g.n - 1];
	fp++;
	gold_clear(g);
	for i in fp { gold_push(g, filled[i]); }
	g.steps += fp;
	out.i = fp;
	out.s.clear();
	format(out.s, "filled checkpoints to ", fp, " points");
	out
}
@end
