expect: => i=2 r=0.0 ok=true s="kept 2 spaced elements" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let g_req = ${gap};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	var last_val = g.res[0];
	for i in 1..g.n {
		let diff = g.res[i] - last_val;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= g_req {
			g.res[kept] = g.res[i];
			last_val = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept ", kept, " spaced elements");
	out
}
@end
