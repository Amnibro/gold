code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${slen};
	let start = if s < g.n { g.n - s } else { 0 };
	let orig_n = g.n;
	for k in start..orig_n {
		if (k - start) % 2 == 1 {
			gold_push(g, g.res[k]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "expanded search suffix to ", g.n);
	out
}
@end
