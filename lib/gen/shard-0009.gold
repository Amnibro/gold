@entry 1a93d810bfe6e337
kind: step
verb: retry
noun: minimum
modifier: recursively
context: sort
phrase: retry minimum recursively with attempt limit {limit}
phrase: find minimum recursively trying up to {limit} passes
slot: limit int
test: list=7,3,9,1 limit=3
expect: => i=1 r=0.0 ok=true s="found recursive minimum 1" errors=0 n=4 res=[1,3,9,7] cache=0 hits=0
test: list=12,5,8 limit=-1
expect: => i=0 r=0.0 ok=false s="error: retry limit must be positive" errors=1 n=3 res=[12,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "invalid retry limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry limit must be positive");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty results list");
		out.ok = false;
		return out;
	}
	var min_val = g.res[0];
	var min_idx = 0;
	for i in 1..g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
	}
	let tmp = g.res[0];
	g.res[0] = min_val;
	g.res[min_idx] = tmp;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "found recursive minimum ", min_val);
	out
}
@end
