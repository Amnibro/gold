@entry 04774f8aca676ab3
kind: step
verb: select
noun: streak
modifier: in_place
context: sort
phrase: select longest sorted streak in place
phrase: isolate longest ascending streak in place
test: list=3,1,2,5,4,6
expect: => i=3 r=0.0 ok=true s="selected streak length 3" errors=0 n=3 res=[1,2,5] cache=0 hits=0
test: list=9,8,1,2,3,4
expect: => i=4 r=0.0 ok=true s="selected streak length 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] >= g.res[i - 1] {
			cur_len++;
		} else {
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
			cur_start = i;
			cur_len = 1;
		}
	}
	if cur_len > best_len {
		best_len = cur_len;
		best_start = cur_start;
	}
	for i in best_len {
		g.res[i] = g.res[best_start + i];
	}
	g.n = best_len;
	g.steps += g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "selected streak length ", best_len);
	out
}
@end
