code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		g.res[count] = if diff < 0 { -diff } else { diff };
		count++;
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise digit gaps: ", count);
	out
}
@end
@entry ef4a6ca9216b3b26
kind: step
