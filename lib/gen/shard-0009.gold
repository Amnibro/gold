code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odd_pos int[200] = [0; 200];
	var odd_cnt = 0;
	for i in out.s.len {
		if (out.s[i] as int) % 2 != 0 {
			odd_pos[odd_cnt] = i;
			odd_cnt++;
		}
	}
	if odd_cnt > 1 {
		let last_b = out.s[odd_pos[odd_cnt - 1]];
		var k = odd_cnt - 1;
		while k > 0 {
			out.s[odd_pos[k]] = out.s[odd_pos[k - 1]];
			k--;
		}
		out.s[odd_pos[0]] = last_b;
	}
	g.steps += out.s.len + odd_cnt;
	out.i = odd_cnt;
	out
}
@end
