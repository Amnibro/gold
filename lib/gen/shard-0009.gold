@entry 8756ae774e521b0c
kind: step
verb: limit
noun: checkpoint
modifier: recursively
context: stats
phrase: limit outlier checkpoints recursively to cap {cap}
phrase: cap extreme checkpoint values recursively below {cap}
slot: cap int
test: list=50,120,40,200 cap=60
expect: => i=3 r=0.0 ok=true s="performed 3 reductions" errors=0 n=4 res=[50,60,40,50] cache=0 hits=0
test: list=15,25,80 cap=30
expect: => i=2 r=0.0 ok=true s="performed 2 reductions" errors=0 n=3 res=[15,25,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	if c <= 0 {
		out.ok = false;
		out.s.clear();
		out.s.append("invalid cap");
		return out;
	}
	var reductions = 0;
	for k in g.n {
		while g.res[k] > c {
			g.res[k] = g.res[k] / 2;
			reductions++;
		}
	}
	g.steps += g.n + reductions;
	out.i = reductions;
	out.s.clear();
	format(out.s, "performed ", reductions, " reductions");
	out
}
@end
@entry 6e319d16af063734
kind: step
verb: find
noun: evens
modifier: unique
context: stats
phrase: find unique even measurements in data
phrase: collect distinct even sample observations
test: list=2,4,2,6,7,8
expect: => i=4 r=0.0 ok=true s="found 4 unique evens" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=1,3,5,6,6,10
expect: => i=2 r=0.0 ok=true s="found 2 unique evens" errors=0 n=2 res=[6,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var up = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			var seen = false;
			for j in up {
				if u[j] == x { seen = true; break; }
			}
			if !seen { u[up] = x; up++; }
		}
	}
	gold_clear(g);
	for i in up { gold_push(g, u[i]); }
	g.steps += g.n;
	out.i = up;
	out.s.clear();
	format(out.s, "found ", up, " unique evens");
	out
}
@end
@entry 433a4c9db8064274
kind: step
verb: reverse
noun: runs
modifier: times
context: stats
phrase: reverse observation runs occurring at least {min_len} times
phrase: invert sample sequences spanning at least {min_len} times
slot: min_len int
test: list=1,2,3,10,4,5,6 min_len=3
expect: => i=2 r=0.0 ok=true s="reversed 2 runs" errors=0 n=7 res=[10,3,2,1,6,5,4] cache=0 hits=0
test: list=8,9,1,2,3,4 min_len=4
expect: => i=1 r=0.0 ok=true s="reversed 1 runs" errors=0 n=6 res=[8,9,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n < ml || ml < 2 {
		out.s.clear();
		out.s.append("data too short");
		return out;
	}
	var runs_reversed = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j + 1] >= g.res[j] { j++; }
		let run_len = j - i + 1;
		if run_len >= ml {
			var l = i;
			var r = j;
			while l < r {
				let tmp = g.res[l];
				g.res[l] = g.res[r];
				g.res[r] = tmp;
				l++;
				r--;
			}
			runs_reversed++;
		}
		i = j + 1;
	}
	g.steps += g.n;
	out.i = runs_reversed;
	out.s.clear();
	format(out.s, "reversed ", runs_reversed, " runs");
	out
}
@end
@entry a80f9369a590c428
kind: step
verb: rank
noun: runs
modifier: at_least
context: stats
phrase: rank sample runs spanning at least {min_run} observations
phrase: score consecutive runs of at least {min_run} elements
slot: min_run int
test: list=1,2,3,0,5,6,7,8 min_run=3
expect: => i=34 r=0.0 ok=true s="ranked 2 runs with score 34" errors=0 n=8 res=[1,2,3,0,5,6,7,8] cache=0 hits=0
test: list=10,20,5,6,7 min_run=2
expect: => i=13 r=0.0 ok=true s="ranked 2 runs with score 13" errors=0 n=5 res=[10,20,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_run};
	var score = 0;
	var matching_runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j + 1 < g.n && g.res[j + 1] >= g.res[j] { j++; }
		let len = j - i + 1;
		if len >= mr {
			score += len * len;
			matching_runs++;
		}
		i = j + 1;
	}
	g.steps += g.n;
	out.i = score;
	out.s.clear();
	format(out.s, "ranked ", matching_runs, " runs with score ", score);
	out
}
@end
@entry 57f2af35fef47308
kind: step
verb: repeat
noun: average
modifier: between
context: stats
phrase: repeat average of observations between {low} to {high} exactly {count} times
phrase: duplicate mean of samples between limits {low} to {high} count {count} times
slot: low int
slot: high int
slot: count int
test: list=5,10,20,30,40 low=10 high=30 count=3
expect: => i=20 r=0.0 ok=true s="appended average 20 count 3" errors=0 n=8 res=[5,10,20,30,40,20,20,20] cache=0 hits=0
test: list=2,8,12,18,50 low=5 high=20 count=2
expect: => i=12 r=0.0 ok=true s="appended average 12 count 2" errors=0 n=7 res=[2,8,12,18,50,12,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let reps = ${count};
	var sum = 0;
	var num = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			sum += x;
			num++;
		}
	}
	if num == 0 || reps <= 0 {
		out.s.clear();
		out.s.append("no samples in range");
		return out;
	}
	let avg = sum / num;
	for r in reps { gold_push(g, avg); }
	g.steps += g.n + reps;
	out.i = avg;
	out.s.clear();
	format(out.s, "appended average ", avg, " count ", reps);
	out
}
@end
