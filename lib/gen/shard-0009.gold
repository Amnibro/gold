code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	for i in g.n {
		g.res[i] -= avg;
	}
	out.i = avg;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "normalized running counter mean ", avg);
	out
}
@end
