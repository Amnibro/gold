@entry c55ebccc246ea5d1
kind: step
verb: clamp
noun: items
modifier: pairwise
context: math
phrase: clamp items pairwise with maximum delta {delta}
phrase: bound items pairwise using limit delta {delta}
slot: delta int
test: list=10,30,35,70 delta=15
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise differences" errors=0 n=4 res=[10,25,35,50] cache=0 hits=0
test: list=5,5,5 delta=5
expect: => i=0 r=0.0 ok=true s="clamped 0 pairwise differences" errors=0 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	var modified = 0;
	for i in 1..g.n {
		let prev = g.res[i - 1];
		let cur = g.res[i];
		if cur > prev + d {
			g.res[i] = prev + d;
			modified++;
		} else if cur < prev - d {
			g.res[i] = prev - d;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped ", modified, " pairwise differences");
	out
}
@end
