@entry f113b8ee5347b7f5
kind: step
verb: filter
noun: odds
modifier: times
context: error
phrase: filter odd error codes repeated times
phrase: remove odd error markers multiple times
slot: rounds int
test: list=1,2,3,4,5 rounds=1
expect: => i=3 r=0.0 ok=true s="filtered odd errors 3" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=7,9,11,12 rounds=2
expect: => i=3 r=0.0 ok=true s="filtered odd errors 3" errors=0 n=1 res=[12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	var count = 0;
	for step in r {
		var kept = 0;
		for i in g.n {
			if g.res[i] % 2 == 0 {
				g.res[kept] = g.res[i];
				kept++;
			} else {
				count++;
			}
		}
		g.n = kept;
	}
	g.steps += r * 3;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered odd errors ", count);
	out
}
@end
