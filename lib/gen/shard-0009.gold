fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[..200] = "";
	var collapsed = 0;
	var last_was_space = false;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			if last_was_space {
				collapsed++;
			} else {
				res.push(' ');
				last_was_space = true;
			}
		} else {
			res.push(c);
			last_was_space = false;
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = collapsed;
	out
}
@end
