code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let last_idx = g.n - 1;
		let sq = g.res[last_idx] * g.res[last_idx];
		g.res[last_idx] = sq;
		out.s.clear();
		format(out.s, "squared last: ", sq);
		out.i = sq;
	} else {
		out.s.clear();
		out.s.append("squared last: none");
		out.i = 0;
	}
	g.steps++;
	out
}
@end
