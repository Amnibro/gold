fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var runs = 0;
	var cur_run = 0;
	for i in g.n {
		if g.res[i] < 0 { break; }
		if i > 0 && g.res[i] > g.res[i - 1] {
			cur_run++;
		} else {
			if cur_run > 0 { runs++; }
			cur_run = 1;
		}
	}
	if cur_run > 1 { runs++; }
	g.steps += g.n;
	out.i = runs;
	out.s.clear();
	format(out.s, "runs ", runs);
	out
}
