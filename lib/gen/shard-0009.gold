test: list=10,20,30,40 times=2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[20,10,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lim = ${times};
	if lim > g.n { lim = g.n; }
	var i = 0;
	while i < lim / 2 {
		let j = lim - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
		i++;
	}
	out.i = lim;
	g.steps += lim;
	out
}
@end
