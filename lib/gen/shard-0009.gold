fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var total = 0;
	let start = if g.n > 3 { g.n - 3 } else { 0 };
	for i in start..g.n {
		if g.res[i] >= low && g.res[i] <= high { total += g.res[i]; }
	}
	out.s.clear();
	format(out.s, "suffix sum: ", total);
	out.i = total;
	g.steps += g.n;
	out
}
@end
