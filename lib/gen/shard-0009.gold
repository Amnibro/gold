fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			g.res[count] = g.res[i];
			count++;
		}
	}
	let removed = g.n - count;
	g.n = count;
	g.steps += count;
	out.i = removed;
	out.s.clear();
	format(out.s, "purged sorted odd retries: ", removed);
	out
}
@end
