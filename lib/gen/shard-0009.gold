context: filter
phrase: merge middle elements recursively depth {depth}
phrase: recursively sum center elements depth {depth}
slot: depth int
test: list=1,10,20,2 depth=1
expect: => i=30 r=0.0 ok=true s="merged middle recursively sum 30" errors=0 n=1 res=[30] cache=0 hits=0
test: list=2,5,15,3 depth=2
expect: => i=40 r=0.0 ok=true s="merged middle recursively sum 40" errors=0 n=1 res=[40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${depth};
	let lo = g.n / 4;
	let hi = g.n - lo;
	var total = 0;
	for i in lo..hi {
		total += g.res[i];
	}
	let final_val = total * d;
	gold_clear(g);
	gold_push(g, final_val);
	g.steps += (hi - lo) * d;
	out.i = final_val;
	out.s.clear();
	format(out.s, "merged middle recursively sum ", final_val);
	out
}
@end
