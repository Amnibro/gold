@entry b40f902825bb4fcf
kind: step
verb: sort
noun: history
modifier: last
context: error
phrase: sort last error history items ascending
phrase: order trailing error history entries
slot: k int
test: list=9,8,7,6,5 k=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[9,8,5,6,7] cache=0 hits=0
test: list=10,40,30,20 k=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = if ${k} < g.n { ${k} } else { g.n };
	let start = g.n - count;
	if count > 1 {
		for i in count {
			for j in (i + 1)..count {
				if g.res[start + i] > g.res[start + j] {
					let t = g.res[start + i];
					g.res[start + i] = g.res[start + j];
					g.res[start + j] = t;
				}
			}
		}
	}
	g.steps += count;
	out.i = count;
	out
}
@end
@entry d996e81fda27d5a3
kind: step
verb: return
noun: digits
modifier: in_reverse
context: error
phrase: return error digits in reverse order
