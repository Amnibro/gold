test: list=10,20,30
expect: => i=3 r=0.0 ok=true s="cached frequency for 3 distinct items" errors=0 n=3 res=[10,20,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		let cnt, found = gold_cache_get(g, x);
		if found {
			gold_cache_put(g, x, cnt + 1);
		} else {
			gold_cache_put(g, x, 1);
			distinct++;
		}
	}
	g.steps += g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "cached frequency for ", distinct, " distinct items");
	out
}
@end
@entry 8b19d929f6249a24
kind: step
verb: retry
noun: errors
modifier: unique
context: sort
phrase: retry errors unique deduplication attempt {retries}
phrase: deduplicate sorted results allowing up to {retries} passes
slot: retries int
test: list=1,1,2,3,3 retries=2
expect: => i=2 r=0.0 ok=true s="unique pass removed 2 duplicates" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,4 retries=-1
expect: => i=0 r=0.0 ok=false s="error: retries exhausted" errors=1 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${retries};
	if r <= 0 {
		gold_fail(g, "retry limit non positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retries exhausted");
		return out;
	}
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[kept - 1] {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	let removed = g.n - kept;
	g.n = kept;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "unique pass removed ", removed, " duplicates");
	out
}
@end
