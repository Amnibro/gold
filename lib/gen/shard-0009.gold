@entry 907659ba4c1e0ff3
kind: step
verb: apply
noun: average
modifier: in_reverse
context: retry
phrase: apply average in_reverse prefix differences
phrase: compute average in_reverse baseline differences
test: list=10,20,30
expect: => i=20 r=0.0 ok=true s="reversed with average 20" errors=0 n=3 res=[10,0,-10] cache=0 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: retry with data" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for average calculation");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry with data");
		return out;
	}
	var tot = 0;
	for i in g.n { tot += g.res[i]; }
	let avg = tot / g.n;
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right] - avg;
		g.res[right] = tmp - avg;
		left++;
		right--;
	}
	if left == right {
		g.res[left] = g.res[left] - avg;
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "reversed with average ", avg);
	out
}
@end
