expect: => i=0 r=0.0 ok=true s="large gaps: 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${gap_size};
	var gaps = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d >= lim { gaps++; }
		}
	}
	out.s.clear();
	format(out.s, "large gaps: ", gaps);
	out.i = gaps;
	g.steps += g.n;
	out
}
@end
