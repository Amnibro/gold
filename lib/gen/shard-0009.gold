@entry 94592cd86ec970f9
kind: step
verb: drop
noun: primes
modifier: running
context: math
phrase: drop prime numbers encountered while running sequence
phrase: remove running prime values from result list
test: list=2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="dropped running primes count 3" errors=0 n=2 res=[4,6] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="dropped running primes count 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var is_prime = false;
		if x >= 2 {
			is_prime = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_prime = false; break; }
				d++;
			}
		}
		if is_prime {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = dropped;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "dropped running primes count ", dropped);
	out
}
@end
