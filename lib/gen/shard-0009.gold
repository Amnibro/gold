noun: middle
modifier: first
context: math
phrase: filter middle first count {count} values
phrase: prune middle first span {count} entries
slot: count int
test: list=10,20,30,40,50 count=2
expect: => i=2 r=0.0 ok=true s="filtered first 2 middle items" errors=0 n=3 res=[10,40,50] cache=0 hits=0
test: list=1,2,3,4 count=1
expect: => i=1 r=0.0 ok=true s="filtered first 1 middle items" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if g.n <= 2 || k <= 0 {
		out.i = 0;
		return out;
	}
	var skipped = 0;
	var write_idx = 1;
	for i in 1..(g.n - 1) {
		if skipped < k {
			skipped++;
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.res[write_idx] = g.res[g.n - 1];
	g.n = write_idx + 1;
	g.steps += g.n;
	out.i = skipped;
	out.s.clear();
	format(out.s, "filtered first ", skipped, " middle items");
	out
}
@end
