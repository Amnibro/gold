kind: step
verb: swap
noun: gaps
modifier: between
context: filter
phrase: swap elements across gaps between {lo} inclusive {hi}
phrase: exchange items over gap falling between {lo} upper {hi}
slot: lo int
slot: hi int
test: list=10,2,30,4 lo=5 hi=25
expect: => i=1 r=0.0 ok=true s="swapped gaps count 1" errors=0 n=4 res=[30,2,10,4] cache=0 hits=0
test: list=1,8,3,15 lo=4 hi=12
expect: => i=0 r=0.0 ok=true s="swapped gaps count 0" errors=0 n=4 res=[1,8,3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var swaps = 0;
	var i = 0;
	while i + 2 < g.n {
		let diff = g.res[i + 2] - g.res[i];
		let span = if diff < 0 { -diff } else { diff };
		if span >= low && span <= high {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 2];
			g.res[i + 2] = tmp;
			swaps++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped gaps count ", swaps);
	out
}
@end
