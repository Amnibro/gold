expect: => i=7 r=0.0 ok=true s="grouped terminal series sum is 7" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sp = ${span};
	var start = g.n - sp;
	if start < 0 { start = 0; }
	var sum = 0;
	for k in start..g.n {
		sum += g.res[k];
	}
	let count = g.n - start;
	g.steps += count;
	out.i = sum;
	out.s.clear();
	format(out.s, "grouped terminal series sum is ", sum);
	out
}
@end
@entry 92d7af6ae6452727
kind: step
verb: find
noun: history
modifier: with_retry
context: sort
phrase: find element {target} in sort history allowing {retries} retry attempts
phrase: locate target value {target} in history with retry bound {retries}
slot: target int
slot: retries int
test: list=10,20,30,40 target=30 retries=2
expect: => i=2 r=0.0 ok=true s="found target at index 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25 target=99 retries=3
expect: => i=-1 r=0.0 ok=true s="target not found after 4 attempts" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let max_r = ${retries};
	var found_idx = -1;
	var attempts = 0;
	while attempts <= max_r && found_idx < 0 {
		for k in g.n {
			if g.res[k] == tgt {
				found_idx = k;
				break;
			}
		}
		attempts++;
	}
	g.steps += g.n * attempts;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "found target at index ", found_idx);
	} else {
		format(out.s, "target not found after ", attempts, " attempts");
	}
	out
}
@end
