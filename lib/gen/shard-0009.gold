fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	var cur_len = 1;
	for i in (g.n - 1) {
		if g.res[i + 1] == g.res[i] {
			cur_len++;
		} else {
			if cur_len < 2 { valid = false; }
			cur_len = 1;
		}
	}
	if cur_len < 2 { valid = false; }
	g.steps += g.n;
	out.ok = valid;
	out.s.clear();
	format(out.s, "runs each valid ", valid);
	out
}
