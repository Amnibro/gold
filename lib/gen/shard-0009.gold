fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var best = -1000000;
	for i in g.n {
		if g.res[i] > best {
			best = g.res[i];
		}
	}
	if best < lo { best = lo; }
	if best > hi { best = hi; }
	g.steps += g.n;
	out.i = best;
	out.s.clear();
	format(out.s, "normalized maximum between bounds to ", best);
	out
}
@end
