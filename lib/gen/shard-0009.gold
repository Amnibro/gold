fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n < c {
		gold_fail(g, "invalid range size for merge");
		out.ok = false;
		return out;
	}
	let keep_prefix = g.n - c;
	var sum = 0;
	for k in keep_prefix..g.n {
		sum += g.res[k];
	}
	g.n = keep_prefix;
	gold_push(g, sum);
	out.i = sum;
	g.steps += c;
	out
}
@end
