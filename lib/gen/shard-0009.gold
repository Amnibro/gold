@entry 2c5c7b5ad237dfc5
kind: step
verb: rotate
noun: total
modifier: with_cache
context: compare
phrase: rotate elements if total exceeds cache comparison
phrase: cycle results when total crosses cached threshold
phrase: shift array if sum compares above cached limit
test: list=20,30,40
expect: => i=90 r=0.0 ok=true s="total cached compare 90" errors=0 n=3 res=[30,40,20] cache=1 hits=1
test: list=5,10,15
expect: => i=30 r=0.0 ok=true s="total cached compare 30" errors=0 n=3 res=[5,10,15] cache=1 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 99, 50);
	var total = 0;
	for i in g.n { total += g.res[i]; }
	let limit, found = gold_cache_get(g, 99);
	let threshold = if found { limit } else { 100 };
	if total > threshold && g.n > 1 {
		let first = g.res[0];
		for i in (g.n - 1) { g.res[i] = g.res[i + 1]; }
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "total cached compare ", total);
	out
}
@end
