@entry f142668a3160967f
kind: step
verb: reverse
noun: history
modifier: up_to
context: core
phrase: reverse history up to limit {cap}
phrase: invert history prefix up to size {cap}
slot: cap int
test: list=1,2,3,4 cap=3
expect: => i=3 r=0.0 ok=true s="reversed: 3" errors=0 n=4 res=[3,2,1,4] cache=0 hits=0
test: list=10,20 cap=2
expect: => i=2 r=0.0 ok=true s="reversed: 2" errors=0 n=2 res=[20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	let k = if g.n < limit { g.n } else { limit };
	for i in k / 2 {
		let j = k - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	out.s.clear();
	format(out.s, "reversed: ", k);
	out.i = k;
	g.steps += k;
	out
}
@end
