expect: => i=2 r=0.0 ok=true s="kept 2 items exceeding threshold" errors=0 n=2 res=[25,35] cache=0 hits=0
test: list=10,20 threshold=50
expect: => i=0 r=0.0 ok=true s="kept 0 items exceeding threshold" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var write_idx = 0;
	for i in g.n {
		if g.res[i] > th {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = write_idx;
	out.s.clear();
	format(out.s, "kept ", write_idx, " items exceeding threshold");
	out
}
@end
