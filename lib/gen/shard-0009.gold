fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var valid = true;
	for i in g.n {
		let scaled = g.res[i] * m;
		if scaled > 50 {
			valid = false;
			gold_fail(g, "scaled item out of bounds");
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, if valid { "range check ok" } else { "range check failed" });
	out
}
@end
