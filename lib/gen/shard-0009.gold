fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inv = 0;
	if out.s.len > 1 {
		for i in out.s.len {
			for j in (i + 1)..out.s.len {
				if out.s[i] > out.s[j] { inv++; }
			}
		}
	}
	g.steps += out.s.len * out.s.len;
	out.i = inv;
	out.s.clear();
	format(out.s, "pairwise letter inversions ", inv);
	out
}
