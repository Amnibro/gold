fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var consonants = 0;
	for b in out.s {
		let is_v = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
		            b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U');
