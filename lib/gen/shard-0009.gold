code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var swaps = 0;
	var k = 0;
	while k + 1 < g.n && swaps < lim {
		if g.res[k] % 2 == 0 && g.res[k + 1] % 2 == 0 {
			let tmp = g.res[k];
			g.res[k] = g.res[k + 1];
			g.res[k + 1] = tmp;
			swaps++;
			k += 2;
		} else {
			k++;
		}
	}
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
