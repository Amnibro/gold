code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 || !${p}(g.res[0]) {
		gold_fail(g, "predicate false at start");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: start condition unmet");
		return out;
	}
	var tot = 0;
	var count = 0;
	for i in g.n {
		if !${p}(g.res[i]) {
			break;
		}
		tot += g.res[i];
		count++;
	}
	g.steps += count;
	out.i = tot;
	out.s.clear();
	format(out.s, "total ", tot, " over ", count, " items");
	out
}
@end
