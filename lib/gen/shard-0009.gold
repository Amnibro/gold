code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var c = 0;
	for i in 1..g.n {
		if g.res[i] % 2 == 0 && g.res[i - 1] % 2 == 0 {
			if g.res[i] + g.res[i - 1] <= th {
				c++;
			}
		}
	}
	g.steps += g.n;
	out.i = c;
	out.s.clear();
	format(out.s, "traced ", c, " even pairs below threshold");
	out
}
@end
@entry 5e4897d2b1558e80
kind: step
verb: sort
noun: average
modifier: any
context: math
phrase: sort average any margin {margin}
phrase: order average any bias {margin}
slot: margin int
test: list=10,2,8,4 margin=0
expect: => i=6 r=0.0 ok=true s="partitioned around average 6" errors=0 n=4 res=[2,4,8,10] cache=0 hits=0
test: list=20,10,30 margin=5
expect: => i=25 r=0.0 ok=true s="partitioned around average 25" errors=0 n=3 res=[20,10,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n + m;
	for i in g.n {
		for j in (i + 1)..g.n {
			let cond_i = g.res[i] >= avg;
			let cond_j = g.res[j] >= avg;
			if cond_i && !cond_j {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "partitioned around average ", avg);
	out
}
@end
