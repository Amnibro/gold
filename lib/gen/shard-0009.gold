expect: => i=2 r=0.0 ok=true s="dropped 2 occurrences of 2" errors=0 n=3 res=[1,3,4] cache=0 hits=0
test: list=1,3,5 target=2
expect: => i=0 r=0.0 ok=false s="error: retry drop target" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var kept = 0;
	var dropped = 0;
	for i in g.n {
		if g.res[i] == tgt {
			dropped++;
		} else {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if dropped == 0 {
		gold_fail(g, "target value not found to drop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry drop target");
		return out;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " occurrences of ", tgt);
	out
}
@end
