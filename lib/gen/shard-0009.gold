code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_spaces};
	var spaces = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			spaces++;
		}
	}
	g.steps += out.s.len;
	out.i = spaces;
	if spaces < req {
		gold_fail(g, "not enough spaces");
		out.ok = false;
		out.s.clear();
		format(out.s, "retry needed spaces ", spaces);
	} else {
		out.ok = true;
		out.s.clear();
		format(out.s, "kept valid spaces ", spaces);
	}
	out
}
@end
@entry 47944b6182dda31e
kind: step
verb: dedupe
noun: condition
modifier: in_place
context: compare
phrase: dedupe condition in place matching {target}
phrase: prune condition in place equal to {target}
slot: target int
test: list=5,10,5,20,5 target=5
expect: => i=2 r=0.0 ok=true s="deduped condition in place removed 2" errors=0 n=3 res=[5,10,20] cache=0 hits=0
test: list=1,2,3 target=9
expect: => i=0 r=0.0 ok=true s="deduped condition in place removed 0" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var seen = false;
	var write_idx = 0;
	var removed = 0;
	for i in g.n {
		if g.res[i] == tgt {
			if !seen {
				seen = true;
				g.res[write_idx] = g.res[i];
				write_idx++;
			} else {
				removed++;
			}
		} else {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped condition in place removed ", removed);
	out
}
@end
