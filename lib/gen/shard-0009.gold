code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var res byte[..200] = "";
	for i in out.s.len {
		let c = out.s[i] as int;
		let _, hit = gold_cache_get(g, c);
		if !hit {
			gold_cache_put(g, c, 1);
			res.push(out.s[i]);
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
