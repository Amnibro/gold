fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for split loop");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry with data");
		return out;
	}
	var evens int[512] = [0; 512];
	var odds int[512] = [0; 512];
