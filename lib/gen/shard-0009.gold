expect: => i=4 r=0.0 ok=true s="primes filtered 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="primes filtered 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[64];
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && p < 64 { primes[p] = x; p++; }
		}
	}
	gold_clear(g);
	for k in p { gold_push(g, primes[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "primes filtered ", p);
	out
}
@end
