code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_cnt = 0;
	for idx in g.n {
		let num = g.res[idx];
		if num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { p_cnt++; }
		}
	}
	gold_cache_put(g, 999, p_cnt);
	g.steps += g.n + p_cnt + 1;
	out.i = p_cnt;
	out.s.clear();
	format(out.s, "primes count cached: ", p_cnt);
	out
}
@end
