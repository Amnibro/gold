noun: histogram
modifier: last
context: cache
phrase: compare last cached frequency bin with threshold {val}
phrase: evaluate final cache histogram entry against {val}
phrase: check trailing cached frequency count with {val}
slot: val int
test: list=1,1,2,2,2 val=2
expect: => i=1 r=0.0 ok=true s="histogram diff 1" errors=0 n=5 res=[1,1,2,2,2] cache=2 hits=3
