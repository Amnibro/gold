fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	for k in g.n {
		if g.res[k] < 0 {
			valid = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { g.n } else { 0 };
	if valid {
		gold_text(out, "search steps valid");
	} else {
		gold_fail(g, "negative search step detected");
		gold_text(out, "search steps invalid");
	}
	out
}
