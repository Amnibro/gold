fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	let mid = g.n / 2;
	let last_idx = g.n - 1;
	let tmp = g.res[mid];
	g.res[mid] = g.res[last_idx];
	g.res[last_idx] = tmp;
	g.steps += 2;
	out.i = tmp;
	out.s.clear();
	format(out.s, "swapped middle item ", tmp, " to end");
	out
}
