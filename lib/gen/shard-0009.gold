code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_len};
	var cached_runs = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= target {
			gold_cache_put(g, cached_runs, g.res[i]);
			cached_runs++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = cached_runs;
	out.s.clear();
	format(out.s, "cached ", cached_runs, " runs");
	out
}
@end
