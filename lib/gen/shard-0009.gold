test: list=8,4,12,6
expect: => i=2 r=0.0 ok=true s="merged into 2 minimums" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("not enough points");
		return out;
	}
	var merged int[512] = [0; 512];
	var mp = 0;
	var k = 0;
	while k < g.n {
		if k + 1 < g.n {
			let a = g.res[k];
			let b = g.res[k + 1];
			merged[mp] = if a < b { a } else { b };
			mp++;
			k += 2;
		} else {
			merged[mp] = g.res[k];
			mp++;
			k++;
		}
	}
	gold_clear(g);
	for i in mp { gold_push(g, merged[i]); }
	g.steps += g.n;
	out.i = mp;
	out.s.clear();
	format(out.s, "merged into ", mp, " minimums");
	out
}
@end
