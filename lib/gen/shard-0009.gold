expect: => i=4 r=0.0 ok=true s="deduped primes count: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,11,13
expect: => i=2 r=0.0 ok=true s="deduped primes count: 2" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_p int[>..] = [];
	for idx in g.n {
		let num = g.res[idx];
		if num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				var seen = false;
				for p in unique_p {
					if p == num { seen = true; break; }
				}
				if !seen { unique_p.push(num); }
			}
		}
	}
	gold_clear(g);
	for p in unique_p { gold_push(g, p); }
	g.steps += g.n + unique_p.len + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped primes count: ", g.n);
	out
}
@end
