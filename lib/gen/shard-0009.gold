@entry 0b8b154afbc92882
kind: step
verb: sort
noun: maximum
modifier: unique
context: core
phrase: sort sequence extracting unique items ending at maximum
phrase: order unique items ascending towards maximum
phrase: sort distinct elements preserving maximum last
test: list=50,10,30,10,50,20
expect: => i=4 r=0.0 ok=true s="unique sorted count: 4" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=4,1,4,3
expect: => i=3 r=0.0 ok=true s="unique sorted count: 3" errors=0 n=3 res=[1,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[>..] = [];
	for idx in g.n {
		let val = g.res[idx];
		var seen = false;
		for item in u {
			if item == val { seen = true; break; }
		}
		if !seen { u.push(val); }
	}
	gold_clear(g);
	for item in u { gold_push(g, item); }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique sorted count: ", g.n);
	out
}
@end
