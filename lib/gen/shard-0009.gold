@entry a7ff3784cbe7f2fc
kind: step
verb: search
noun: number
modifier: recursively
context: sort
phrase: binary search sorted list for target number {target}
phrase: search sorted numbers recursively for target {target}
phrase: find target number {target} in sorted list
slot: target int
test: list=10,20,30,40,50 target=30
expect: => i=2 r=0.0 ok=true s="recursively found at index 2" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=5,15,25,35 target=40
expect: => i=-1 r=0.0 ok=true s="recursively found at index -1" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var lo = 0;
	var hi = g.n - 1;
	var found = -1;
	while lo <= hi {
		let mid = (lo + hi) / 2;
		if g.res[mid] == tgt {
			found = mid;
			break;
		} else if g.res[mid] < tgt {
			lo = mid + 1;
		} else {
			hi = mid - 1;
		}
	}
	g.steps += g.n;
	out.i = found;
	out.s.clear();
	format(out.s, "recursively found at index ", found);
	out
}
@end
