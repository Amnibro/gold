@entry b6d7227384b0fa42
kind: step
verb: merge
noun: tail
modifier: last
context: stats
phrase: merge tail last {count} observations
phrase: sum trailing tail last {count} items
slot: count int
test: list=1,2,3,4,5 count=3
expect: => i=12 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,12] cache=0 hits=0
test: list=10,20,30,40 count=2
expect: => i=70 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 || g.n < c {
		gold_fail(g, "invalid tail size");
		out.ok = false;
		return out;
	}
	let prefix_len = g.n - c;
	var sum = 0;
	for k in prefix_len..g.n { sum += g.res[k]; }
	g.n = prefix_len;
	gold_push(g, sum);
	out.i = sum;
	g.steps += c;
	out
}
@end
