phrase: purge memo all duplicate entries using bias {bias}
slot: bias int
test: list=4,4,5,6,6,7 bias=10
expect: => i=2 r=0.0 ok=true s="deduped memo removed 2" errors=0 n=4 res=[4,5,6,7] cache=4 hits=0
test: list=1,2,3 bias=5
expect: => i=0 r=0.0 ok=true s="deduped memo removed 0" errors=0 n=3 res=[1,2,3] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var w = 0;
	for i in g.n {
		let item = g.res[i];
		var exists = false;
		for j in w {
			if g.res[j] == item {
				exists = true;
				break;
			}
		}
		if !exists {
			g.res[w] = item;
			gold_cache_put(g, item, item + b);
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped memo removed ", removed);
	out
}
@end
