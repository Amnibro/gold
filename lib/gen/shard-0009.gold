expect: => i=3 r=0.0 ok=true s="memoized 3 value counts" errors=0 n=5 res=[1,2,3,1,2] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var distinct = 0;
	for k in g.n {
		let x = g.res[k];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		var seen = false;
		for i in g.cn {
			if g.ck[i] == x { seen = true; break; }
		}
		if !seen {
			gold_cache_put(g, x, freq);
			distinct++;
		}
	}
	g.steps += g.n * g.n;
	out.i = distinct;
	out.s.clear();
	format(out.s, "memoized ", distinct, " value counts");
	out
}
@end
