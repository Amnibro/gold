@entry 988080d9d6b5b40d
kind: step
verb: scale
noun: range
modifier: unique
context: search
phrase: scale range unique by multiplier {factor}
phrase: multiply span between extremes by factor {factor}
slot: factor int
test: list=5,15,3,20 factor=2
expect: => i=34 r=0.0 ok=true s="" errors=0 n=5 res=[5,15,3,20,34] cache=0 hits=0
test: list=10,30 factor=3
expect: => i=60 r=0.0 ok=true s="" errors=0 n=3 res=[10,30,60] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var lo = g.res[0];
	var hi = g.res[0];
	for k in 1..g.n {
		if g.res[k] < lo { lo = g.res[k]; }
		if g.res[k] > hi { hi = g.res[k]; }
	}
	let spread = (hi - lo) * f;
	gold_push(g, spread);
	out.i = spread;
	g.steps += g.n;
	out
}
@end
