fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var lengths: int[10];
	var count = 0;
	var cur = 0;
	var i = 0;
	while i < out.s.len && count < 10 {
		if out.s[i] == ' ' {
			if cur > 0 {
				lengths[count] = cur;
				count++;
				cur = 0;
			}
		} else {
			cur++;
		}
		i++;
	}
	if cur > 0 && count < 10 {
		lengths[count] = cur;
		count++;
	}
	var a = 0;
	while a < count {
		var b = a + 1;
		while b < count {
			if lengths[b] < lengths[a] {
				let t = lengths[a];
				lengths[a] = lengths[b];
				lengths[b] = t;
			}
			b++;
		}
		a++;
	}
	for k in 0..count {
		gold_push(g, lengths[k]);
	}
	out.i = count;
	g.steps += 1;
	out
}
@end
