code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 1;
	if g.n > 0 {
		max_streak = 1;
		for i in (g.n - 1) {
			if g.res[i] == g.res[i + 1] {
				cur_streak++;
			} else {
				cur_streak = 1;
			}
			if cur_streak > max_streak { max_streak = cur_streak; }
		}
	}
	out.s.clear();
	format(out.s, "streak: ", max_streak);
	out.i = max_streak;
	g.steps += g.n;
	out
}
@end
