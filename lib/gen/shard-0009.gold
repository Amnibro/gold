code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let limit = ${cap};
	if g.cn > 0 {
		let mid = g.cn / 2;
		if g.cv[mid] > limit { g.cv[mid] = limit; }
		out.i = g.cv[mid];
	} else {
		out.i = 0;
	}
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "middle cache value ", out.i);
	out
}
