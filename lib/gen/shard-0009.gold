@entry cef3699abad18779
kind: step
verb: pair
noun: range
modifier: between
context: filter
phrase: pair range differences between {lo} inclusive {hi}
phrase: group adjacent differences falling between {lo} upper {hi}
slot: lo int
slot: hi int
test: list=1,5,8,20 lo=2 hi=6
expect: => i=2 r=0.0 ok=true s="paired range between count 2" errors=0 n=2 res=[4,3] cache=0 hits=0
test: list=10,25,30 lo=10 hi=20
expect: => i=1 r=0.0 ok=true s="paired range between count 1" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	for i in (g.n - 1) {
		let diff = g.res[i + 1] - g.res[i];
		let span = if diff < 0 { -diff } else { diff };
		if span >= low && span <= high {
			g.res[kept] = span;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "paired range between count ", kept);
	out
}
@end
