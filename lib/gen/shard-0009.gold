code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${ceiling};
	var tot = 0;
	var idx = 0;
	while idx < g.n && tot + g.res[idx] <= cap {
		tot += g.res[idx];
		idx++;
		g.steps++;
	}
	g.n = idx;
	out.i = tot;
	out.s.clear();
	format(out.s, "summed sequence to ", tot);
	out
}
@end
