noun: window
modifier: sorted
context: error
phrase: sum window sorted checking monotonic
phrase: add window sorted verifying order
slot: size int
test: list=1,2,3,4 size=2
expect: => i=3 r=0.0 ok=true s="computed 3 window sums" errors=0 n=3 res=[3,5,7] cache=0 hits=0
test: list=1,2 size=4
expect: => i=0 r=0.0 ok=false s="error: invalid window size" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || sz > g.n {
		gold_fail(g, "window size larger than list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid window size");
		return out;
	}
	let num_windows = g.n - sz + 1;
	for i in num_windows {
		var sum = 0;
		for j in sz {
			sum += g.res[i + j];
		}
		g.res[i] = sum;
	}
	g.n = num_windows;
	g.steps += num_windows;
	out.i = num_windows;
	out.s.clear();
	format(out.s, "computed ", num_windows, " window sums");
	out
}
@end
@entry a5654f56f683ea5e
kind: step
verb: collect
noun: streak
modifier: at_most
context: error
phrase: collect streak at_most length {max_len}
phrase: take streak at_most cap {max_len}
slot: max_len int
test: list=5,5,5,5,2 max_len=2
expect: => i=2 r=0.0 ok=true s="collected streak of length 2" errors=0 n=2 res=[5,5] cache=0 hits=0
test: list=5,5 max_len=0
expect: => i=0 r=0.0 ok=false s="error: nonpositive streak limit" errors=1 n=2 res=[5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	if ml <= 0 {
		gold_fail(g, "invalid streak cap");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: nonpositive streak limit");
		return out;
	}
	if g.n == 0 {
		gold_fail(g, "empty list has no streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let val = g.res[0];
	var count = 0;
	while count < g.n && g.res[count] == val && count < ml {
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected streak of length ", count);
	out
}
@end
