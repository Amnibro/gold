fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_digits = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		while x > 0 {
			total_digits += x % 10;
			x /= 10;
		}
	}
	out.s.clear();
	format(out.s, "digit sum: ", total_digits);
	out.i = total_digits;
	g.steps += g.n;
	out
}
@end
