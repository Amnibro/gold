@entry 2bc72f80734d321c
kind: step
verb: repeat
noun: errors
modifier: sorted
context: stats
phrase: repeat residual errors sorted by magnitude with count {count}
phrase: duplicate sample errors sorted ascending with count {count}
slot: count int
test: list=-5,3,-8,2 count=2
expect: => i=8 r=0.0 ok=true s="repeated 4 errors" errors=0 n=8 res=[2,2,3,3,5,5,8,8] cache=0 hits=0
test: list=-10,7,-2 count=1
expect: => i=3 r=0.0 ok=true s="repeated 3 errors" errors=0 n=3 res=[2,7,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${count};
	if g.n == 0 || rep <= 0 {
		out.s.clear();
		out.s.append("no errors");
		return out;
	}
	let m = g.n;
	var errs int[512] = [0; 512];
	for k in m {
		let x = g.res[k];
		errs[k] = if x < 0 { -x } else { x };
	}
	for i in m {
		var min_idx = i;
		for j in (i + 1)..m {
			if errs[j] < errs[min_idx] { min_idx = j; }
		}
		if min_idx != i {
			let tmp = errs[i];
			errs[i] = errs[min_idx];
			errs[min_idx] = tmp;
		}
	}
	gold_clear(g);
	for i in m {
		for r in rep {
			gold_push(g, errs[i]);
		}
	}
	g.steps += m * rep;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated ", m, " errors");
	out
}
@end
