fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	var valid_squares = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 && x <= 10000 {
			let sq = x * x;
			if sq <= lim { valid_squares++; }
		}
		g.steps++;
	}
	out.i = valid_squares;
	out.s.clear();
	format(out.s, "found ", valid_squares, " squares below limit");
	out
}
