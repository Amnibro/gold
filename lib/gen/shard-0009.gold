code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let cached_val, found = gold_cache_get(g, i);
		if found {
			g.res[i] = g.res[i] + cached_val;
		} else {
			gold_cache_put(g, i, g.res[i]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "paired ", g.n, " items with cache");
	out
}
@end
