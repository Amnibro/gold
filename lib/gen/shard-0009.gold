code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var reversed_streaks = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i > 1 {
			var left = i;
			var right = j - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			reversed_streaks++;
		}
		i = j;
	}
	g.steps += g.n + 1;
	out.i = reversed_streaks;
	out.s.clear();
	format(out.s, "reversed ", reversed_streaks, " streaks");
	out
}
@end
