expect: => i=18 r=0.0 ok=true s="" errors=0 n=4 res=[10,25,18,30] cache=0 hits=0
test: list=5,12,8 cap=15
expect: => i=12 r=0.0 ok=true s="" errors=0 n=3 res=[5,12,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	var found = false;
	var max_val = -999999;
	for k in g.n {
		if g.res[k] <= c {
			if !found || g.res[k] > max_val {
				max_val = g.res[k];
				found = true;
			}
		}
	}
	if found {
		out.i = max_val;
	} else {
		gold_fail(g, "no element under cap");
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
