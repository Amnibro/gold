fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_span = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			total_span += if diff < 0 { -diff } else { diff };
		}
	}
	g.steps += g.n;
	out.i = total_span;
	out.s.clear();
	format(out.s, "measured pairwise delta sum ", total_span);
	out
}
