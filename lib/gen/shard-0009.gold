code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let expected_times = ${target_times};
	var found_delta = -1;
	if g.n > 1 {
		let d = g.res[1] - g.res[0];
		var occurrences = 0;
		for i in 1..g.n {
			if g.res[i] - g.res[i - 1] == d {
				occurrences++;
			}
		}
		if occurrences >= expected_times {
			found_delta = d;
		}
	}
	g.steps += g.n;
	out.i = found_delta;
	out.s.clear();
	format(out.s, "found step delta ", found_delta);
	out
}
@end
