fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var gaps = [0; 512];
	var count = 0;
	var idx = g.n - 1;
	while idx > 0 {
		let diff = g.res[idx] - g.res[idx - 1];
		gaps[count] = diff;
		count++;
		idx--;
		g.steps++;
	}
	gold_clear(g);
	for k in count { gold_push(g, gaps[k]); }
	out.i = count;
	out.s.clear();
	format(out.s, "computed ", count, " reverse gaps");
	out
}
