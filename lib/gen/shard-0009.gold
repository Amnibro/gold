		if x < 0 { break; }
		while x > 0 {
			sum_digits += x % 10;
			x /= 10;
		}
	}
	g.steps += g.n;
	out.i = sum_digits;
	out.s.clear();
	format(out.s, "digits sum ", sum_digits);
	out
}
