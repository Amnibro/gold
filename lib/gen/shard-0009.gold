test: list=10,20,50,40,30
expect: => i=3 r=0.0 ok=true s="sorted last window 3" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=9,8,7
expect: => i=3 r=0.0 ok=true s="sorted last window 3" errors=0 n=3 res=[7,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	let w_start = if g.n > 3 { g.n - 3 } else { 0 };
	var i = w_start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += (g.n - w_start) * 2 + 1;
	out.i = g.n - w_start;
	out.s.clear();
	format(out.s, "sorted last window ", out.i);
	out
}
@end
