test: list=1,2,2,3,1,4
expect: => i=2 r=0.0 ok=true s="recursive deduplication removed 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30
expect: => i=0 r=0.0 ok=true s="recursive deduplication removed 0" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var new_n = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in 0..new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		}
	}
	let removed = g.n - new_n;
	g.n = new_n;
	out.i = removed;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "recursive deduplication removed ", removed);
	out
}
@end
