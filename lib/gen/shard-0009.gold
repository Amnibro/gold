fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	if g.cn >= 2 {
		let avg = (g.cv[0] + g.cv[g.cn - 1]) / 2;
		g.cv[0] = avg;
		g.cv[g.cn - 1] = avg;
		out.i = avg;
	} else {
		out.i = 0;
	}
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "normalized endpoints to ", out.i);
	out
}
