fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tg = ${target};
	var run = 0;
	var found_idx = -1;
	for i in g.n {
		run += g.res[i];
		if run >= tg && found_idx < 0 {
			found_idx = i;
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "target reached at index ", found_idx);
	} else {
		format(out.s, "target not reached");
	}
	out
}
@end
