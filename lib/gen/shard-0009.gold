expect: => i=2 r=0.0 ok=true s="close pairs: 2" errors=0 n=4 res=[10,12,15,25] cache=0 hits=0
test: list=10,50,90 margin=3
expect: => i=0 r=0.0 ok=true s="close pairs: 0" errors=0 n=3 res=[10,50,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	var close_pairs = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let adiff = if diff < 0 { -diff } else { diff };
			if adiff <= m { close_pairs++; }
		}
	}
	out.s.clear();
	format(out.s, "close pairs: ", close_pairs);
	out.i = close_pairs;
	g.steps += g.n;
	out
}
@end
