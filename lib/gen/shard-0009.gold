@entry 6646ea92612163e5
kind: step
verb: return
noun: middle
modifier: all
context: compare
phrase: return middle element after comparing all items
phrase: extract median value across all compared elements
phrase: find middle ranking number from all items
test: list=10,50,20,40,30
expect: => i=30 r=0.0 ok=true s="middle all 30" errors=0 n=5 res=[10,50,20,40,30] cache=0 hits=0
test: list=1,9,4
expect: => i=4 r=0.0 ok=true s="middle all 4" errors=0 n=3 res=[1,9,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var sorted int[64];
	for i in g.n {
		if i < 64 { sorted[i] = g.res[i]; }
	}
	var i = 0;
	while i < g.n && i < 64 {
		var j = i + 1;
		while j < g.n && j < 64 {
			if sorted[j] < sorted[i] {
				let t = sorted[i]; sorted[i] = sorted[j]; sorted[j] = t;
			}
			j++;
		}
		i++;
	}
	let mid = sorted[g.n / 2];
	g.steps += g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "middle all ", mid);
	out
}
@end
