fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	out.s.append("reversed: [");
	for i in g.n {
		if i > 0 { out.s.append(", "); }
		format(out.s, g.res[i]);
	}
	out.s.append("]");
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
