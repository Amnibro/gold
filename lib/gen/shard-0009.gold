test: text="core  gold   helium"
expect: => i=16 r=0.0 ok=true s="core gold helium" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[>..] = [];
	var last_was_space = false;
	for idx in out.s.len {
		let c = out.s[idx];
		if c == ' ' {
			if !last_was_space {
				buf.push(' ');
				last_was_space = true;
			}
		} else {
			buf.push(c);
			last_was_space = false;
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
