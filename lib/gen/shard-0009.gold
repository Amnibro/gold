code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let orig_n = g.n;
	var split_arr int[512] = [0; 512];
	var sn = 0;
	for k in orig_n {
		let h = g.res[k] / 2;
		split_arr[sn] = h;
		split_arr[sn + 1] = g.res[k] - h;
		sn += 2;
		g.steps++;
	}
	gold_clear(g);
	for k in sn { gold_push(g, split_arr[k]); }
	out.i = sn;
	out.s.clear();
	format(out.s, "split values in place ", sn);
	out
}
@end
