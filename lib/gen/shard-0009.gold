		while idx > 0 {
			var diff = g.res[idx] - g.res[idx - 1];
			if diff < 0 { diff = -diff; }
			if diff > allowed {
				valid = false;
				break;
			}
			idx--;
		}
	}
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reverse gap validation ", out.i);
	out
}
@end
