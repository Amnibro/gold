code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var max_idx = 0;
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] > max_val {
			max_val = g.res[i];
			max_idx = i;
		}
	}
	let last = g.n - 1;
	let tmp = g.res[last];
	g.res[last] = max_val;
	g.res[max_idx] = tmp;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "safely moved maximum ", max_val, " to end");
	out
}
@end
