expect: => i=4 r=0.0 ok=true s="cached 4 sorted elements" errors=0 n=4 res=[1,2,4,5] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "cached ", g.n, " sorted elements");
	out
}
@end
