phrase: perform sorting pass across items {repeats} times
slot: repeats int
test: list=5,2,4,1 repeats=1
expect: => i=3 r=0.0 ok=true s="scanned items with 3 swaps" errors=0 n=4 res=[2,4,1,5] cache=0 hits=0
test: list=5,2,4,1 repeats=3
expect: => i=5 r=0.0 ok=true s="scanned items with 5 swaps" errors=0 n=4 res=[1,2,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	var total_swaps = 0;
	for rep in r {
		for i in g.n - 1 {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				total_swaps++;
			}
		}
	}
	g.steps += r * g.n;
	out.i = total_swaps;
	out.s.clear();
	format(out.s, "scanned items with ", total_swaps, " swaps");
	out
}
@end
