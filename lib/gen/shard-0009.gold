fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = if g.n > 3 { g.n - 3 } else { 0 };
	var kept int[64];
	var p = 0;
	var i = start;
	while i < g.n {
		if g.res[i] >= 10 {
			if p < 64 { kept[p] = g.res[i]; p++; }
		}
		i++;
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "filtered tail at least ", p);
	out
}
@end
