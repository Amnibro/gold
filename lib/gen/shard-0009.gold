fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	for k in g.n - 1 {
		g.res[k] = g.res[k + 1] - g.res[k];
	}
	g.n--;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "returned search gaps ", out.i);
	out
}
