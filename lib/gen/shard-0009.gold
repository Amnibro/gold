test: list=20,30,5,8 cutoff=15
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[30,20,5,8] cache=0 hits=0
test: list=10,25,35,40 cutoff=20
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[10,35,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var swaps = 0;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] >= cut && g.res[k + 1] >= cut {
			let tmp = g.res[k];
			g.res[k] = g.res[k + 1];
			g.res[k + 1] = tmp;
			swaps++;
			k += 2;
		} else {
			k++;
		}
	}
	out.i = swaps;
	g.steps += g.n;
	out
}
@end
