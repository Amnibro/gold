kind: step
verb: return
noun: range
modifier: up_to
context: format
phrase: return range formatting bounds up to {lim}
phrase: format range description up to ceiling {lim}
phrase: display value range bounded up to {lim}
slot: lim int
test: list=10,25,50,40 lim=60
expect: => i=40 r=0.0 ok=true s="range: [10..50]" errors=0 n=4 res=[10,25,50,40] cache=0 hits=0
test: list=5,15,35,80 lim=40
expect: => i=30 r=0.0 ok=true s="range: [5..35]" errors=0 n=4 res=[5,15,35,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if g.n == 0 { return out; }
	var min_val = 1000000;
	var max_val = -1000000;
	for k in g.n {
		let x = g.res[k];
		if x <= lim {
			if x < min_val { min_val = x; }
			if x > max_val { max_val = x; }
		}
		g.steps++;
	}
	out.s.clear();
	format(out.s, "range: [", min_val, "..", max_val, "]");
	out.i = max_val - min_val;
	out
}
@end
