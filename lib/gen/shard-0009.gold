fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_items};
	var tmp int[512] = [0; 512];
	let old_n = g.n;
	for i in old_n { tmp[i] = g.res[i]; }
	gold_clear(g);
	for i in old_n {
		if g.n < cap { gold_push(g, tmp[i]); }
		if g.n < cap { gold_push(g, tmp[i]); }
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated list to at most ", g.n, " items");
	out
}
@end
