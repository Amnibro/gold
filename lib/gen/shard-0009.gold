fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	let mk = ${max_keep};
	var kept: int[64] = [0; 64];
	var kn = 0;
	for k in g.n {
		if g.res[k] > fl && kn < mk && kn < 64 {
			kept[kn] = g.res[k];
			kn++;
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "kept ", kn, " numbers above floor");
	out
}
