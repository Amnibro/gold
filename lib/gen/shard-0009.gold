fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	let count = if limit < g.n { limit } else { g.n };
	var valid = true;
	for k in count {
		if g.res[k] <= 0 {
			valid = false;
			break;
		}
	}
	g.steps += count;
	out.ok = valid;
	out.i = count;
	if valid {
		gold_text(out, "search scores positive");
	} else {
		gold_fail(g, "non-positive search score found");
		gold_text(out, "invalid search scores");
	}
	out
}
@end
