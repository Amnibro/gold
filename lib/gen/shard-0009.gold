code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniques = [0; 512];
	var u_count = 0;
	out.s.clear();
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for u in u_count {
			if uniques[u] == x { seen = true; break; }
		}
		if !seen {
			uniques[u_count] = x;
			if u_count > 0 { out.s.append(" "); }
			format(out.s, "#", u_count, "=", x);
			u_count++;
		}
		g.steps++;
	}
	out.i = u_count;
	out
}
@end
