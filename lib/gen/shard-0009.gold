expect: => i=0 r=0.0 ok=true s="applied: []" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	out.s.clear();
	out.s.append("applied: [");
	var first = true;
	var count = 0;
	for i in g.n {
		if g.res[i] >= b {
			let v_mod = ${fn_op}(g.res[i]);
			if !first { out.s.append(", "); }
			format(out.s, v_mod);
			first = false;
			count++;
		}
	}
	out.s.append("]");
	out.i = count;
	g.steps += g.n;
	out
}
@end
