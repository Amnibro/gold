fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var rev int[64];
	var p = 0;
	var i = g.n - 1;
	while i >= 0 {
		if i == g.n - 1 || g.res[i] != g.res[i + 1] {
			if p < 64 { rev[p] = g.res[i]; p++; }
		}
		i--;
	}
	gold_clear(g);
	var k = p;
	while k > 0 {
		k--;
		gold_push(g, rev[k]);
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped in reverse ", g.n);
	out
}
@end
