	var in_word = false;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			in_word = false;
		} else if !in_word {
			in_word = true;
			words++;
		}
	}
	let alternate = (words + 1) / 2;
	g.steps += words;
	out.i = alternate;
	out.s.clear();
	format(out.s, "alternate word count ", alternate);
	out
}
@end
