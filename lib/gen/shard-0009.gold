fn ${ID}_is_vowel(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
	b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = false;
	if out.s.len > 0 {
		let last_b = out.s[out.s.len - 1];
		valid = ${ID}_is_vowel(last_b);
	}
	gold_cache_put(g, 0, if valid { 1 } else { 0 });
	g.steps += out.s.len;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	if valid {
		gold_text(out, "last char is vowel");
	} else {
		gold_fail(g, "last char not a vowel");
		gold_text(out, "last char invalid");
	}
	out
}
