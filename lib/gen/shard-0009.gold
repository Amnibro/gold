@entry 7ee2146139a88f8c
kind: step
verb: select
noun: pairs
modifier: unique
context: filter
phrase: select unique adjacent pairs from results
phrase: filter distinct neighbor pairs removing duplicates
test: list=2,2,3,4,4,5
expect: => i=3 r=0.0 ok=true s="selected unique pairs count 3" errors=0 n=6 res=[2,2,3,4,4,5] cache=0 hits=0
test: list=1,1,1,2
expect: => i=2 r=0.0 ok=true s="selected unique pairs count 2" errors=0 n=4 res=[1,1,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var seen = false;
		var j = 0;
		while j < kept {
			if g.res[j] == a && g.res[j + 1] == b { seen = true; break; }
			j += 2;
		}
		if !seen {
			g.res[kept] = a;
			g.res[kept + 1] = b;
			kept += 2;
		}
		i += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept / 2;
	out.s.clear();
	format(out.s, "selected unique pairs count ", kept / 2);
	out
}
@end
