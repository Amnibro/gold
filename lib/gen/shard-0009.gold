				valid = false;
				break;
			}
		}
	}
	g.steps += g.cn;
	out.ok = valid;
	out.i = if valid { g.cn } else { 0 };
	if valid {
		gold_text(out, "pairwise cache keys valid");
	} else {
		gold_fail(g, "unordered pairwise cache keys");
		gold_text(out, "pairwise cache keys invalid");
	}
	out
}
