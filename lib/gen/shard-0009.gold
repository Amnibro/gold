@entry 40f272ac7f130d5b
kind: step
verb: measure
noun: subfunction
modifier: unique
context: format
phrase: format measure subfunction {fn_op} unique values
phrase: render distinct transformed values applying {fn_op}
slot: fn_op fn
test: list=2,4,2 fn_op=double
expect: => i=2 r=0.0 ok=true s="unique mapped: 2" errors=0 n=3 res=[2,4,2] cache=0 hits=0
test: list=1,2,3 fn_op=square
expect: => i=3 r=0.0 ok=true s="unique mapped: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var outputs = [0; 64];
	var out_n = 0;
	var unique_cnt = 0;
	for i in g.n {
		if out_n >= 64 { break; }
		let transformed = ${fn_op}(g.res[i]);
		var seen = false;
		for j in out_n {
			if outputs[j] == transformed { seen = true; break; }
		}
		if !seen {
			outputs[out_n] = transformed;
			out_n++;
			unique_cnt++;
		}
	}
	out.s.clear();
	format(out.s, "unique mapped: ", unique_cnt);
	out.i = unique_cnt;
	g.steps += g.n;
	out
}
@end
