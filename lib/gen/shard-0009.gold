fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var sq int[512] = [0; 512];
	var sn = 0;
	for k in 0..(g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		sq[sn] = diff * diff;
		sn++;
		g.steps++;
	}
	gold_clear(g);
	for k in sn { gold_push(g, sq[k]); }
	out.i = sn;
	out.s.clear();
	format(out.s, "applied pairwise squares ", sn);
	out
}
