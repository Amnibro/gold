		var cur_len = 1;
		for i in 1..g.n {
			if g.res[i] == cur_val {
				cur_len++;
			} else {
				if cur_len > 1 { streak_sum += cur_len * mult; }
				cur_val = g.res[i];
				cur_len = 1;
			}
		}
		if cur_len > 1 { streak_sum += cur_len * mult; }
	}
	out.i = streak_sum;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "joined nested streak total ", streak_sum);
	out
}
