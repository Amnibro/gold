expect: => i=3 r=0.0 ok=true s="gooo" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t_len = ${tail_len};
	let t = ${times};
	let n = out.s.len;
	let act_len = if t_len > n { n } else if t_len < 0 { 0 } else { t_len };
	let start = n - act_len;
	var added = 0;
	if t > 1 {
		for _ in 1..t {
			for j in act_len {
				if out.s.len < 200 {
					out.s.push(out.s[start + j]);
					added++;
				}
			}
		}
	}
	g.steps += added;
	out.i = added + act_len;
	out
}
@end
