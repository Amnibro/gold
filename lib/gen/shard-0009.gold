test: list=10,20,30,40,50 min_len=2
expect: => i=90 r=0.0 ok=true s="split suffix at least sum 90" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=1,2 min_len=5
expect: => i=0 r=0.0 ok=false s="suffix length error" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	if g.n < ml {
		gold_fail(g, "list too short for suffix");
		out.ok = false;
		out.s.clear();
		format(out.s, "suffix length error");
		return out;
	}
	let start = g.n - ml;
	var sum = 0;
	var i = start;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += ml;
	out.i = sum;
	out.s.clear();
	format(out.s, "split suffix at least sum ", sum);
	out
}
@end
