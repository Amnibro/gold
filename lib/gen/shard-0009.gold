	if g.n > 1 {
		let fst = g.res[0] * g.res[0];
		for idx in (g.n - 1) {
			g.res[idx] = g.res[idx + 1] * g.res[idx + 1];
		}
		g.res[g.n - 1] = fst;
	} else if g.n == 1 {
		g.res[0] = g.res[0] * g.res[0];
