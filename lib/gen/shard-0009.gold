code:
fn is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_pairs = 0;
	var i = 1;
	while i < g.n {
		if is_prime(g.res[i - 1]) && is_prime(g.res[i]) {
			prime_pairs++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = prime_pairs;
	out.s.clear();
	format(out.s, "pairwise prime comparisons found ", prime_pairs);
	out
}
@end
