@entry 1c3c6b6edb9d9a1c
kind: step
verb: sort
noun: digits
modifier: with_retry
context: math
phrase: sort digits with_retry rounds {rounds}
phrase: arrange digits with_retry passes {rounds}
slot: rounds int
test: input=5381 rounds=2
expect: => i=1358 r=0.0 ok=true s="sorted digits to 1358" errors=0 n=0 res=[] cache=0 hits=0
test: input=924 rounds=1
expect: => i=249 r=0.0 ok=true s="sorted digits to 249" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rnd = ${rounds};
	var x = out.i;
	if x < 0 { x = -x; }
	var d = [0; 20];
	var dn = 0;
	if x == 0 {
		d[0] = 0;
		dn = 1;
	} else {
		while x > 0 {
			d[dn] = x % 10;
			dn++;
			x /= 10;
		}
	}
	for i in dn {
		for j in (i + 1)..dn {
			if d[i] > d[j] {
				let tmp = d[i];
				d[i] = d[j];
				d[j] = tmp;
			}
		}
	}
	var res = 0;
	for i in dn {
		res = res * 10 + d[i];
	}
	out.i = res;
	g.steps += dn * rnd;
	out.s.clear();
	format(out.s, "sorted digits to ", res);
	out
}
@end
