code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var evens = 0;
	for i in g.n {
		var x = g.res[i];
		var r = 0;
		while !core_is_even(x) && r < r_max {
			x++;
			r++;
		}
		if core_is_even(x) { evens++; }
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = evens;
	out.s.clear();
	format(out.s, "loop count with retry ", evens);
	out
}
@end
