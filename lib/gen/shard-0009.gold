@entry 8ab333d8f951ada7
kind: step
verb: swap
noun: limit
modifier: nested
context: search
phrase: swap limit nested boundaries exceeding {limit}
phrase: exchange first with last values exceeding limit {limit}
slot: limit int
test: list=5,20,30,8 limit=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[5,30,20,8] cache=0 hits=0
test: list=15,2,3,25 limit=10
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[25,2,3,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var first = -1;
	var last = -1;
	for k in g.n {
		if g.res[k] > lim {
			if first == -1 { first = k; }
			last = k;
		}
	}
	if first >= 0 && last >= 0 && first != last {
		let tmp = g.res[first];
		g.res[first] = g.res[last];
		g.res[last] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
