fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let s = ${shift};
	if g.cn > 1 {
		let off = s % g.cn;
		var tk int[256] = [0; 256];
		var tv int[256] = [0; 256];
		for k in g.cn {
			tk[(k + off) % g.cn] = g.ck[k];
			tv[(k + off) % g.cn] = g.cv[k];
		}
		for k in g.cn {
			g.ck[k] = tk[k];
			g.cv[k] = tv[k];
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "rotated cache loop each ", g.cn);
	out
}
