kind: step
verb: find
noun: limit
modifier: sorted
context: math
phrase: find index where sorted sequence exceeds {bound}
phrase: locate threshold cutoff in sorted list {bound}
slot: bound int
test: list=30,10,20 bound=20
expect: => i=1 r=0.0 ok=true s="found sorted limit index 1" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,8,12 bound=50
expect: => i=-1 r=0.0 ok=true s="found sorted limit index -1" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${bound};
	if g.n > 1 {
		for i in g.n {
			for j in 0..g.n-1 {
				if g.res[j] > g.res[j+1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j+1];
					g.res[j+1] = tmp;
				}
			}
		}
	}
	var idx = -1;
	for i in g.n {
		if g.res[i] >= cutoff {
			idx = i;
			break;
		}
	}
	out.i = idx;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "found sorted limit index ", idx);
	out
}
@end
