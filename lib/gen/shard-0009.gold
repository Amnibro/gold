fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	for k in 1..g.n {
		let diff = g.res[k] - g.res[k - 1];
		g.res[k] += diff;
		g.steps++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted running sequence ", g.n);
	out
}
