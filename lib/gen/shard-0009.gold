test: list=10,20,50 delta=15
expect: => i=30 r=0.0 ok=false s="step diff is 30" errors=0 n=3 res=[10,20,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let expected = ${delta};
	if g.n < 2 {
		out.ok = false;
		out.s.clear();
		out.s.append("not enough points");
		return out;
	}
	let last_diff = g.res[g.n - 1] - g.res[g.n - 2];
	let abs_diff = if last_diff < 0 { -last_diff } else { last_diff };
	let matches = abs_diff == expected;
	g.steps += 1;
	out.i = abs_diff;
	out.ok = matches;
	out.s.clear();
	if matches {
		out.s.append("step matches delta");
	} else {
		format(out.s, "step diff is ", abs_diff);
	}
	out
}
@end
@entry 3588cd63cb4c6c2e
kind: step
verb: find
noun: loop
modifier: between
context: stats
phrase: find cyclical loop between bounds {low} to {high}
phrase: locate periodic loop between limits {low} to {high}
slot: low int
slot: high int
test: list=10,20,30,10,20,30 low=5 high=35
expect: => i=3 r=0.0 ok=true s="found loop length 3" errors=0 n=6 res=[10,20,30,10,20,30] cache=0 hits=0
test: list=4,8,12,16 low=0 high=20
expect: => i=0 r=0.0 ok=true s="no loop found" errors=0 n=4 res=[4,8,12,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.n < 2 {
		out.s.clear();
		out.s.append("not enough samples");
		return out;
	}
	var best_p = 0;
	let max_p = g.n / 2;
	for p in 1..(max_p + 1) {
		var ok = true;
		for k in 0..(g.n - p) {
			if g.res[k] != g.res[k + p] { ok = false; break; }
			if g.res[k] < lo || g.res[k] > hi { ok = false; break; }
		}
		if ok { best_p = p; break; }
	}
	g.steps += g.n;
	out.i = best_p;
	out.s.clear();
	if best_p > 0 {
		format(out.s, "found loop length ", best_p);
	} else {
		out.s.append("no loop found");
	}
	out
}
@end
