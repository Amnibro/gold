code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_len};
	var res byte[..200] = "";
	var word_len = 0;
	var word_cnt = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c == ' ' {
			res.push(' ');
			word_len = 0;
		} else {
			if word_len == 0 { word_cnt++; }
			if word_len < limit {
				res.push(c);
			}
			word_len++;
		}
	}
	g.steps += out.s.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = word_cnt;
	out
}
@end
