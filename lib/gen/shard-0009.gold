code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[64];
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= 2 {
			var seen = false;
			for k in p {
				if dups[k] == x { seen = true; break; }
			}
			if !seen && p < 64 { dups[p] = x; p++; }
		}
	}
	gold_clear(g);
	for k in p { gold_push(g, dups[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "duplicates at least count ", p);
	out
}
@end
