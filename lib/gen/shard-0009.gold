@entry b7acd125f808e8f6
kind: step
verb: compare
noun: primes
modifier: with_cache
context: transform
phrase: compare items against cached prime flags
phrase: check primes using cached lookup table
phrase: identify prime elements with cache assistance
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="counted prime elements 4" errors=0 n=6 res=[2,3,4,5,6,7] cache=6 hits=0
test: list=10,11,12,13,14,15
expect: => i=2 r=0.0 ok=true s="counted prime elements 2" errors=0 n=6 res=[10,11,12,13,14,15] cache=6 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		let p_val = if is_p { 1 } else { 0 };
		gold_cache_put(g, x, p_val);
		if is_p { prime_cnt++; }
		g.steps++;
	}
	out.i = prime_cnt;
	out.s.clear();
	format(out.s, "counted prime elements ", prime_cnt);
	out
}
@end
