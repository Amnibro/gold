fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	for i in g.n {
		let orig = g.res[i];
		let next = ${f}(orig);
		if next >= -10000 && next <= 10000 {
			g.res[i] = next;
			modified++;
