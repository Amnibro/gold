phrase: rotate sequence squares until reaching maximum value {lim}
phrase: cycle square items until value exceeds boundary {lim}
slot: lim int
test: list=4,9,25 lim=20
expect: => i=2 r=0.0 ok=true s="rotated squares count 2" errors=0 n=3 res=[8,18,25] cache=0 hits=0
test: list=1,16 lim=10
expect: => i=1 r=0.0 ok=true s="rotated squares count 1" errors=0 n=2 res=[2,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop_bound = ${lim};
	var rotated = 0;
	for i in g.n {
		let x = g.res[i];
		var is_sq = false;
		if x >= 0 {
			var r = 0; while r * r < x { r++; }
			if r * r == x { is_sq = true; }
		}
		if is_sq {
			if x >= stop_bound { break; }
			g.res[i] = x * 2;
			rotated++;
		}
	}
	out.i = rotated;
	g.steps += rotated + 1;
	out.s.clear();
	format(out.s, "rotated squares count ", rotated);
	out
}
@end
