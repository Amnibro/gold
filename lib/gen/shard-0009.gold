@entry 0e89ac38f39d061f
kind: step
verb: cache
noun: odds
modifier: sorted
context: transform
phrase: cache odd numbers in sorted order
phrase: sort odd values into cache storage
phrase: collect sorted odd items into cache
test: list=9,2,5,4,1,8
expect: => i=3 r=0.0 ok=true s="cached sorted odds 3" errors=0 n=6 res=[9,2,5,4,1,8] cache=3 hits=0
test: list=15,6,3,8,7
expect: => i=3 r=0.0 ok=true s="cached sorted odds 3" errors=0 n=5 res=[15,6,3,8,7] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var on = 0;
	for k in g.n {
		if g.res[k] % 2 != 0 {
			odds[on] = g.res[k];
			on++;
		}
		g.steps++;
	}
	if on > 1 {
		for i in on {
			for j in 0..(on - 1 - i) {
				if odds[j] > odds[j + 1] {
					let tmp = odds[j];
					odds[j] = odds[j + 1];
					odds[j + 1] = tmp;
				}
			}
		}
	}
	for k in on {
		gold_cache_put(g, k, odds[k]);
	}
	out.i = on;
	out.s.clear();
	format(out.s, "cached sorted odds ", on);
	out
}
@end
