expect: => i=1 r=0.0 ok=true s="scaled 1 pairwise streak matches" errors=0 n=3 res=[14,14,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var scaled = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			g.res[i] *= f;
			g.res[i + 1] *= f;
			scaled++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " pairwise streak matches");
	out
}
@end
