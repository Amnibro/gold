fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var total = 0;
	var count = 0;
	for i in g.n {
		if total + g.res[i] > b { break; }
		total += g.res[i];
		count++;
	}
	out.s.clear();
	format(out.s, "budget used: ", total);
	out.i = count;
	g.steps += count;
	out
}
@end
