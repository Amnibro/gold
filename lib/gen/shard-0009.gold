	for _ in max_idx {
		let first = g.res[0];
		for j in (g.n - 1) { g.res[j] = g.res[j + 1]; }
		g.res[g.n - 1] = first;
	}
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "peak rotated to front ", g.res[0]);
	out
}
