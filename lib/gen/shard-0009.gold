fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_len};
	var matches = 0;
	var cur_len = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if cur_len == target {
				matches++;
			}
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len == target {
		matches++;
	}
	g.steps += out.s.len;
	out.i = matches;
	out.s.clear();
	format(out.s, "matched ", matches, " words with target length");
	out
}
