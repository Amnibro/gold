expect: => i=3 r=0.0 ok=true s="filtered to 3 elements" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	let lim = ${limit};
	var kept: int[64] = [0; 64];
	var kn = 0;
	var above_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x > th {
			if above_count < lim && kn < 64 {
				kept[kn] = x;
				kn++;
				above_count++;
			}
		} else {
			if kn < 64 {
				kept[kn] = x;
				kn++;
			}
		}
	}
	gold_clear(g);
	for i in kn { gold_push(g, kept[i]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "filtered to ", kn, " elements");
	out
}
@end
