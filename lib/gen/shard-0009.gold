code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let b = ${bound};
	var min_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
		}
	}
	if min_val < b {
		gold_fail(g, "minimum below bound");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: minimum below floor");
		return out;
	}
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum ", min_val, " meets bound ", b);
	out
}
@end
