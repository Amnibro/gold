code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_sp = ${limit};
	var clean byte[..200] = [];
	var sp_count = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b == ' ' {
			if sp_count < max_sp {
				clean.push(b);
			}
			sp_count++;
		} else {
			sp_count = 0;
			clean.push(b);
		}
	}
	out.s.clear();
	for b in clean { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
@entry 8e705a0128ce8f04
kind: step
verb: search
noun: range
modifier: last
context: error
phrase: search last error code in valid range
phrase: find last error within range bounds
slot: low int
slot: high int
test: list=100,200,500,300 low=150 high=350
expect: => i=300 r=0.0 ok=true s="" errors=0 n=4 res=[100,200,500,300] cache=0 hits=0
test: list=50,60,70,80 low=40 high=65
expect: => i=60 r=0.0 ok=true s="" errors=0 n=4 res=[50,60,70,80] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var found = false;
	var res = 0;
	var i = g.n - 1;
	while i >= 0 && !found {
		if g.res[i] >= lo && g.res[i] <= hi {
			res = g.res[i];
			found = true;
		}
		i--;
	}
	if found {
		out.i = res;
		out.ok = true;
	} else {
		out.i = 0;
		out.ok = false;
		gold_fail(g, "error not found in range");
	}
	g.steps += g.n;
	out
}
@end
