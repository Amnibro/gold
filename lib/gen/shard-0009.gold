kind: step
verb: normalize
noun: duplicates
modifier: up_to
context: retry
phrase: normalize duplicates up_to occurrence count {k}
phrase: cap duplicates up_to frequency threshold {k}
slot: k int
test: list=2,2,2,3,3,3,3 k=2
expect: => i=4 r=0.0 ok=true s="capped duplicates to 4 items" errors=0 n=4 res=[2,2,3,3] cache=0 hits=0
test: list=1,2,3 k=0
expect: => i=0 r=0.0 ok=false s="error: retry positive cap" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${k};
	if cap <= 0 {
		gold_fail(g, "frequency cap must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry positive cap");
		return out;
	}
	var kept int[512] = [0; 512];
	var nk = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in nk {
			if kept[j] == x { freq++; }
		}
		if freq < cap {
			kept[nk] = x;
			nk++;
		}
	}
	for i in nk { g.res[i] = kept[i]; }
	g.n = nk;
	g.steps += g.n;
	out.i = nk;
	out.s.clear();
	format(out.s, "capped duplicates to ", nk, " items");
	out
}
@end
