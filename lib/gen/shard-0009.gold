fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 { return out; }
	var buf byte[>..] = [];
	buf.push(out.s[0]);
	for i in (out.s.len - 1) {
		if out.s[i + 1] != out.s[i] {
			buf.push(out.s[i + 1]);
		}
	}
	out.s.clear();
	out.s.append(buf);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
