fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	var sum = 0;
	var count = 0;
	var pos = g.n - 1;
	while pos >= 0 {
		sum += g.res[pos];
		count++;
		pos -= 2;
	}
	g.steps += count + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "rank suffix every other ", sum);
	out
}
