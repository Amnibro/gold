code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${lo};
	let high = ${hi};
	var cached = 0;
	for k in g.n {
		if g.res[k] >= low && g.res[k] <= high {
			gold_cache_put(g, k, g.res[k]);
			cached++;
		}
	}
	out.i = cached;
	g.steps += cached;
	out
}
@end
