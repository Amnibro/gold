@entry 69948cb35ed7d75b
kind: step
verb: shift
noun: duplicates
modifier: between
context: sort
phrase: remove duplicates between range index {s0} to {s1}
phrase: deduplicate elements between indices {s0} to {s1}
phrase: prune duplicate items between boundaries {s0} to {s1}
slot: s0 int
slot: s1 int
test: list=1,2,2,3,4,4,5 s0=1 s1=4
expect: => i=1 r=0.0 ok=true s="dropped 1 duplicates in range" errors=0 n=6 res=[1,2,3,4,4,5] cache=0 hits=0
test: list=10,10,10,20 s0=0 s1=2
expect: => i=2 r=0.0 ok=true s="dropped 2 duplicates in range" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = ${s0};
	var end_idx = ${s1};
	if start < 0 { start = 0; }
	if end_idx >= g.n { end_idx = g.n - 1; }
	var temp: int[512] = [0; 512];
	var tn = 0;
	for k in g.n {
		if k >= start && k <= end_idx {
			var seen = false;
			for j in start..k {
				if g.res[j] == g.res[k] { seen = true; break; }
			}
			if !seen { temp[tn] = g.res[k]; tn++; }
		} else {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	let dropped = g.n - tn;
	g.n = tn;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " duplicates in range");
	out
}
@end
