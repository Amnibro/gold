code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tot = 0;
	var found = false;
	for i in g.n {
		if ${p}(g.res[i]) {
			found = true;
			break;
		}
		tot += g.res[i];
	}
	if !found {
		gold_fail(g, "stop condition never reached");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: predicate not met");
		return out;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "head sum until stop is ", tot);
	out
}
@end
