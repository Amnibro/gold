fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mw = ${max_words};
	var words = 0;
	var cut_idx = out.s.len;
	for b, i in out.s {
		if b == ' ' {
			words++;
			if words >= mw {
				cut_idx = i;
				break;
			}
		}
	}
	out.s.resize(cut_idx, ' ');
	g.steps += out.s.len;
	out.i = words;
	out
}
