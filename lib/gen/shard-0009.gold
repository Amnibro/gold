kind: step
verb: fold
noun: total
modifier: sorted
context: search
phrase: fold total sorted search elements with factor {factor}
phrase: reduce total sorted search candidates using factor {factor}
slot: factor int
test: list=4,1,3,2 factor=2
expect: => i=20 r=0.0 ok=true s="folded sorted total is 20" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,2 factor=3
expect: => i=21 r=0.0 ok=true s="folded sorted total is 21" errors=0 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let folded = sum * f;
	g.steps += g.n * g.n;
	out.i = folded;
	out.s.clear();
	format(out.s, "folded sorted total is ", folded);
	out
}
@end
