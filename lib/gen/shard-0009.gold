code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 1;
	while count < g.n {
		if g.res[count] <= g.res[count - 1] {
			break;
		}
		count++;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "kept ", count, " strictly increasing steps");
	out
}
@end
