kind: step
verb: dedupe
noun: limit
modifier: sorted
context: search
phrase: deduplicate sorted search results to limit {lim}
phrase: dedupe sorted search hits within limit {lim}
phrase: filter sorted search duplicates to ceiling {lim}
slot: lim int
test: list=10,10,20,30,30,40 lim=3
expect: => i=3 r=0.0 ok=true s="deduped sorted search results 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=5,5,5,15,15 lim=2
expect: => i=2 r=0.0 ok=true s="deduped sorted search results 2" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	if g.n > 0 {
		var write = 1;
		for i in 1..g.n {
			if g.res[i] != g.res[write - 1] {
				g.res[write] = g.res[i];
				write++;
			}
		}
		g.n = if write < limit { write } else { limit };
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped sorted search results ", g.n);
	out
}
@end
