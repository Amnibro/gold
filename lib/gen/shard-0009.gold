code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	if g.n == 0 {
		gold_push(g, limit);
		out.i = limit;
		return out;
	}
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let old_max = g.res[max_idx];
	let reduction = if old_max > limit { limit } else { old_max };
	g.res[max_idx] -= reduction;
	out.i = reduction;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "shifted maximum by ", reduction);
	out
}
@end
