test: list=4,2,7,10 budget=10
expect: => i=2 r=0.0 ok=true s="budget sorted up to 2" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=15,3,2 budget=5
expect: => i=0 r=0.0 ok=true s="budget sorted up to 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${budget};
	var total = 0;
	var count = 0;
	while count < g.n && total + g.res[count] <= cap {
		total += g.res[count];
		count++;
	}
	var a = 0;
	while a < count {
		var b = a + 1;
		while b < count {
			if g.res[b] < g.res[a] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.n = count;
	g.steps += count * count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "budget sorted up to ", count);
	out
}
@end
