	while idx >= 0 {
		if ${p}(g.res[idx]) {
			tail_len++;
		} else {
			break;
		}
		idx--;
	}
	let start = g.n - tail_len;
	for i in tail_len {
		g.res[i] = g.res[start + i];
	}
	g.n = tail_len;
	out.i = tail_len;
	g.steps += tail_len + 1;
	out.s.clear();
	format(out.s, "returned tail while count ", tail_len);
	out
}
