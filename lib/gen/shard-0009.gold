fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 0 {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "selected 0 values");
		return out;
	}
	let take = if k > g.n { g.n } else { k };
	for i in take {
		g.res[i] = g.res[g.n - 1 - i];
	}
	g.n = take;
	g.steps += take;
	out.i = take;
	out.s.clear();
	format(out.s, "selected ", take, " values in reverse");
	out
}
@end
