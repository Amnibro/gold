@entry 3836882f1a2a73a7
kind: step
verb: collect
noun: duplicates
modifier: with_retry
context: sort
phrase: collect duplicate values appearing at least {min_rep} times
phrase: gather repeated values occurring at least {min_rep} times
phrase: find duplicates with multiplicity at least {min_rep}
slot: min_rep int
test: list=1,2,2,3,3,3 min_rep=2
expect: => i=2 r=0.0 ok=true s="collected 2 frequent duplicates" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=5,5,5,5,6,6 min_rep=3
expect: => i=1 r=0.0 ok=true s="collected 1 frequent duplicates" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_rep};
	var temp: int[512] = [0; 512];
	var tn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= req {
			temp[tn] = g.res[i];
			tn++;
		}
		i = j;
	}
	for k in tn { g.res[k] = temp[k]; }
	g.n = tn;
	g.steps += g.n;
	out.i = tn;
	out.s.clear();
	format(out.s, "collected ", tn, " frequent duplicates");
	out
}
@end
