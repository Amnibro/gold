fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${len};
	let count = if m < g.n { m } else { g.n };
	if count > 1 {
		let first = g.res[0];
		for k in count - 1 {
			g.res[k] = g.res[k + 1];
		}
		g.res[count - 1] = first;
	}
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "rotated leading range of ", count);
	out
}
@end
