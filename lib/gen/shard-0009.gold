@entry 8b40c83911024f24
kind: step
verb: scan
noun: digits
modifier: unique
context: core
phrase: scan digits unique set in results
phrase: tally distinct digits appearing in values
test: list=12,23,34
expect: => i=4 r=0.0 ok=true s="unique digits: 4" errors=0 n=3 res=[12,23,34] cache=0 hits=0
test: list=111
expect: => i=1 r=0.0 ok=true s="unique digits: 1" errors=0 n=1 res=[111] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = 0;
	for i in g.n {
		var x = if g.res[i] < 0 { -g.res[i] } else { g.res[i] };
		if x == 0 { seen |= 1; }
		while x > 0 {
			let d = x % 10;
			seen |= (1 << d);
			x /= 10;
		}
	}
	var unique_digits = 0;
	for d in 10 {
		if (seen & (1 << d)) != 0 { unique_digits++; }
	}
	out.s.clear();
	format(out.s, "unique digits: ", unique_digits);
	out.i = unique_digits;
	g.steps += g.n;
	out
}
@end
