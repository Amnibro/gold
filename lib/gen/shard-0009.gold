fn ${ID}_is_vowel(b byte) bool {
	b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' ||
	b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U'
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels = 0;
	for b in out.s {
		if ${ID}_is_vowel(b) { vowels++; }
	}
	gold_cache_put(g, 0, vowels);
	g.steps += out.s.len;
	out.i = vowels;
	out.s.clear();
	format(out.s, "safely ranked vowels in cache ", vowels);
	out
}
