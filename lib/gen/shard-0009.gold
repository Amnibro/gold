code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var count = 0;
	for i in out.s.len {
		if (out.s[i] as int) > tgt { count++; }
	}
	out.s.clear();
	if count == 0 && out.s.len == 0 {
		let half_tgt = tgt / 2;
		for i in v.s.len {
			if (v.s[i] as int) > half_tgt { count++; }
		}
		g.steps += v.s.len * 2;
		out.i = count;
		format(out.s, "retry found ", count, " results above ", half_tgt);
		return out;
	}
	g.steps += out.s.len;
	out.i = count;
	format(out.s, "found ", count, " results above ", tgt);
	out
}
@end
