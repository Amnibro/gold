kind: step
verb: fill
noun: histogram
modifier: sorted
context: compare
phrase: record sorted comparison frequencies into results
phrase: compute sorted frequency counts of comparison values
test: list=10,10,20,30,30,30
expect: => i=3 r=0.0 ok=true s="histogram bins filled: 3" errors=0 n=3 res=[2,1,3] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="histogram bins filled: 1" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var freqs int[512] = [0; 512];
	var f_count = 0;
	var cur_run = 1;
	for i in g.n - 1 {
		if g.res[i + 1] == g.res[i] {
			cur_run++;
		} else {
			freqs[f_count] = cur_run;
			f_count++;
			cur_run = 1;
		}
	}
	freqs[f_count] = cur_run;
	f_count++;
	for k in f_count {
		g.res[k] = freqs[k];
	}
	g.n = f_count;
	g.steps += g.n;
	out.i = f_count;
	out.s.clear();
	format(out.s, "histogram bins filled: ", f_count);
	out
}
@end
