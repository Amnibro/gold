fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = true;
		out.i = 1;
		return out;
	}
	let head = g.res[0];
	var count = 0;
	for k in g.n {
		if g.res[k] == head { count++; }
	}
	let uniq = count == 1;
	out.ok = uniq;
	out.i = if uniq { 1 } else { 0 };
	g.steps += g.n;
	out
}
