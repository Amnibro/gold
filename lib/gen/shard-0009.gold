test: arg=1,2
expect: 1
expect: 2
test: arg=3,4
expect: 3
expect: 4
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var counts: int[10];
	for i in 0..10 { counts[i] = 0; }
	while x > 0 {
		counts[x % 10]++;
		x /= 10;
	}
	var res = 0;
	for d in 0..10 {
		while counts[d] > 0 {
			res = res * 10 + d;
			counts[d]--;
		}
	}
	res
}
@end
