	let ws = ${window_size};
	let mv = ${max_val};
	var start = g.n - ws;
	if start < 0 { start = 0; }
	var clamped = 0;
	for k in start..g.n {
		if g.res[k] > mv {
			g.res[k] = mv;
			clamped++;
		}
	}
	g.steps += g.n - start;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " elements in last window");
	out
}
