fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var odds int[256] = [0; 256];
	var on = 0;
	for i in out.s.len {
		let c = out.s[i] as int;
		if c % 2 != 0 {
			var seen = false;
			for j in on {
				if odds[j] == c { seen = true; break; }
			}
			if !seen {
				odds[on] = c;
				on++;
			}
		}
	}
	for j in on { gold_push(g, odds[j]); }
	g.steps += out.s.len + on;
	out.i = on;
	out.s.clear();
	format(out.s, "traced ", on, " unique odd character codes");
	out
}
