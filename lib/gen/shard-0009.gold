test: list=12,34,56
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[21,43,65] cache=0 hits=0
test: list=105,230
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[501,32] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		let neg = x < 0;
		if neg { x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + x % 10;
			x /= 10;
		}
		g.res[k] = if neg { -rev } else { rev };
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
