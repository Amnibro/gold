@entry 64428ff719cf20b9
kind: step
verb: rotate
noun: steps
modifier: recursively
context: math
phrase: rotate steps recursively cycles {cycles}
phrase: roll steps recursively passes {cycles}
slot: cycles int
test: list=1,2,3,4 cycles=2
expect: => i=2 r=0.0 ok=true s="rotated steps recursively by 2" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=10,20,30 cycles=1
expect: => i=1 r=0.0 ok=true s="rotated steps recursively by 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cyc = ${cycles};
	if g.n <= 1 || cyc <= 0 {
		out.i = 0;
		return out;
	}
	let k = cyc % g.n;
	for c in k {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n * k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated steps recursively by ", k);
	out
}
@end
