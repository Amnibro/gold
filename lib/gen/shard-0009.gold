	var min_val = g.res[0];
	var i = 0;
	while i < g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		i += 2;
	}
	var count = 0;
	i = 0;
	while i < g.n {
		if g.res[i] == min_val {
			g.res[i] = g.res[i] * f;
			count++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " alternate minimums");
	out
}
