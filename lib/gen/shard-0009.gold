phrase: group duplicate values up to at most {max_grp} copies
phrase: cap duplicate repetitions at most {max_grp} each
slot: max_grp int
test: list=5,5,5,5,2,2 max_grp=2
expect: => i=2 r=0.0 ok=true s="grouped duplicates dropped 2" errors=0 n=4 res=[5,5,2,2] cache=0 hits=0
test: list=1,1,1,1 max_grp=1
expect: => i=3 r=0.0 ok=true s="grouped duplicates dropped 3" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_grp};
	var new_n = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in 0..new_n {
			if g.res[j] == x { seen++; }
		}
		if seen < limit {
			g.res[new_n] = x;
			new_n++;
		} else {
			dropped++;
		}
	}
	g.n = new_n;
	out.i = dropped;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "grouped duplicates dropped ", dropped);
	out
}
@end
