fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var hits = 0;
	for k in g.n {
		let key = g.res[k];
		let val, ok = gold_cache_get(g, key);
		if ok {
			g.res[k] = val;
			hits++;
		} else {
			gold_cache_put(g, key, key * 2);
		}
	}
	out.i = hits;
	g.steps += g.n;
	out
}
