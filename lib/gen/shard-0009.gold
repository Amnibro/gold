code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${max_avg};
	gold_cache_put(g, 0, ceiling);
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var adjusted = 0;
	if avg > ceiling {
		let diff = avg - ceiling;
		for i in g.n {
			g.res[i] -= diff;
			adjusted++;
		}
	}
	out.i = adjusted;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "average capped adjustments ", adjusted);
	out
}
@end
