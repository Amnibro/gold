expect: => i=1 r=0.0 ok=true s="safely unique items: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var u_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_cnt {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen {
			uniq[u_cnt] = x;
			u_cnt++;
		}
	}
	for i in u_cnt { g.res[i] = uniq[i]; }
	g.n = u_cnt;
	g.steps += g.n;
	out.i = u_cnt;
	out.s.clear();
	format(out.s, "safely unique items: ", u_cnt);
	out
}
@end
