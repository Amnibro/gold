code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var words_cnt = 0;
	var in_w = false;
	for c in out.s {
		if c != ' ' {
			if !in_w {
				words_cnt++;
				in_w = true;
			}
		} else {
			in_w = false;
		}
	}
	if out.s.len > lim {
		out.s.resize(lim, 0);
	}
	out.i = words_cnt;
	g.steps++;
	out
}
@end
