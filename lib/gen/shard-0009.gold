expect: => i=1 r=0.0 ok=true s="rotated to budget index 1" errors=0 n=4 res=[15,25,35,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_b};
	var idx = -1;
	for k in g.n {
		if g.res[k] >= req {
			idx = k;
			break;
		}
	}
	if idx > 0 {
		var tmp int[512] = [0; 512];
		for k in g.n { tmp[k] = g.res[(k + idx) % g.n]; }
		for k in g.n { g.res[k] = tmp[k]; }
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "rotated to budget index ", idx);
	out
}
@end
