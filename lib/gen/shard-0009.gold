code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	var primes = 0;
	for i in g.n {
		var x = g.res[i];
		var r = 0;
		while !core_is_prime(x) && r < r_max {
		x++;
		r++;
		}
		if core_is_prime(x) {
			primes++;
			g.res[i] = x;
		}
	}
	g.steps += g.n;
	out.i = primes;
	out.ok = (primes == g.n);
	if !out.ok { gold_fail(g, "non-prime elements remaining"); }
	out.s.clear();
	format(out.s, "primes filtered count ", primes);
	out
}
@end
