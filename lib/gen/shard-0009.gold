kind: step
verb: reverse
noun: tail
modifier: with_retry
context: search
phrase: reverse tail segment of size {tail_len} with retry
phrase: invert trailing elements of size {tail_len} with retry
slot: tail_len int
test: list=1,2,3,4,5 tail_len=3
expect: => i=3 r=0.0 ok=true s="reversed search tail of 3 elements" errors=0 n=5 res=[1,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40 tail_len=2
expect: => i=2 r=0.0 ok=true s="reversed search tail of 2 elements" errors=0 n=4 res=[10,20,40,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	var start = g.n - tl;
	if start < 0 { start = 0; }
	var left = start;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	let len = g.n - start;
	g.steps += len;
	out.i = len;
	out.s.clear();
	format(out.s, "reversed search tail of ", len, " elements");
	out
}
@end
