code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) {
			p[pn] = g.res[k];
			pn++;
		}
	}
	for k in pn {
		g.res[k] = p[pn - 1 - k];
	}
	g.n = pn;
	g.steps += pn;
	out.i = pn;
	out.s.clear();
	format(out.s, "reversed search primes ", pn);
	out
}
@end
