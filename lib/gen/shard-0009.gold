fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	let limit = g.res[g.n - 1];
	var count = 0;
	for i in (g.n - 1) {
		if g.res[i] > limit {
			g.res[i] = limit;
			count++;
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "clamped head ", count);
	out
}
