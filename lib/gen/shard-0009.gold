fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	for i in g.n {
		let x = g.res[i];
		if x < lo || x > hi {
			gold_fail(g, "item out of range");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "item at ", i, " exceeded bound in place");
			return out;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated ", g.n, " items in place");
	out
}
@end
