@entry 0f67aa13bd29ca39
kind: step
verb: sort
noun: range
modifier: in_place
context: text
phrase: sort characters in range from {start} to {end_idx} in place
phrase: order text slice between indices {start} to {end_idx} in place
slot: start int
slot: end_idx int
test: text="dcba" start=0 end_idx=3
expect: => i=4 r=0.0 ok=true s="abcd" errors=0 n=0 res=[] cache=0 hits=0
test: text="axzya" start=1 end_idx=3
expect: => i=3 r=0.0 ok=true s="axyza" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var s = ${start};
	var e = ${end_idx};
	if s < 0 { s = 0; }
	if e >= out.s.len { e = out.s.len - 1; }
	if s < e {
		for a in s..e + 1 {
			for b in a + 1..e + 1 {
				if out.s[a] > out.s[b] {
					let tmp = out.s[a];
					out.s[a] = out.s[b];
					out.s[b] = tmp;
				}
			}
		}
	}
	let sorted_len = if e >= s { e - s + 1 } else { 0 };
	g.steps += sorted_len * sorted_len;
	out.i = sorted_len;
	out
}
@end
