code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
		g.steps++;
	}
	let key = g.n;
	let cached, ok = gold_cache_get(g, key);
	if !ok {
		gold_cache_put(g, key, min_val);
	}
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum value is ", min_val);
	out
}
@end
