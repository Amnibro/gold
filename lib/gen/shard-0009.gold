slot: s1 int
test: list=10,20,30,40,50 s0=1 s1=3
expect: => i=2 r=0.0 ok=true s="shifted range of size 2" errors=0 n=5 res=[10,30,40,20,50] cache=0 hits=0
test: list=5,15,25,35 s0=0 s1=2
expect: => i=2 r=0.0 ok=true s="shifted range of size 2" errors=0 n=4 res=[15,25,5,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start = ${s0};
	var end_idx = ${s1};
	if start < 0 { start = 0; }
	if end_idx >= g.n { end_idx = g.n - 1; }
	if start < end_idx {
		let tmp = g.res[start];
		for i in start..end_idx {
			g.res[i] = g.res[i + 1];
		}
		g.res[end_idx] = tmp;
	}
	g.steps += g.n;
	out.i = end_idx - start;
	out.s.clear();
	format(out.s, "shifted range of size ", end_idx - start);
	out
}
@end
