kind: step
verb: clamp
noun: words
modifier: safely
context: text
phrase: clamp length of words safely to {max_len}
phrase: truncate each word safely to maximum length {max_len}
slot: max_len int
test: text="hello world" max_len=3
expect: => i=2 r=0.0 ok=true s="hel wor" errors=0 n=0 res=[] cache=0 hits=0
test: text="a big elephant" max_len=4
