fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[64];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			if count < 64 { evens[count] = g.res[i]; count++; }
		}
	}
	var i = 0;
	while i < count {
		var j = i + 1;
		while j < count {
			if evens[j] < evens[i] {
				let t = evens[i]; evens[i] = evens[j]; evens[j] = t;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in count { gold_push(g, evens[k]); }
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted ", count, " evens");
	out
}
@end
