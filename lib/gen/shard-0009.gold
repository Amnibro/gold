code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let t = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * g.n + 1;
