code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var matched = 0;
	var i = 0;
	var kept = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		g.res[kept] = a + b;
		if a == b {
			matched++;
		}
		kept++;
		i += 2;
	}
	if i < g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "paired tally with ", matched, " duplicates");
	out
}
@end
