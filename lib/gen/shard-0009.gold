@entry 328daa3719762b6b
kind: step
verb: dedupe
noun: cache
modifier: sorted
context: sort
phrase: deduplicate sorted cache entries
phrase: remove duplicate sorted entries in cache
phrase: dedupe cache table preserving sorted order
test: list=10,10,20,20,30
expect: => i=3 r=0.0 ok=true s="deduped sorted cache size 3" errors=0 n=5 res=[10,10,20,20,30] cache=3 hits=0
test: list=5,5,15,15,25
expect: => i=3 r=0.0 ok=true s="deduped sorted cache size 3" errors=0 n=5 res=[5,5,15,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	if g.cn > 1 {
		var write = 1;
		for i in 1..g.cn {
			if g.ck[i] != g.ck[write - 1] {
				g.ck[write] = g.ck[i];
				g.cv[write] = g.cv[i];
				write++;
			}
		}
		g.cn = write;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "deduped sorted cache size ", g.cn);
	out
}
@end
