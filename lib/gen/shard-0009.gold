	let lim = ${last_idx};
	if g.n == 0 || lim < 0 {
		out.s.clear();
		out.s.append("empty prefix");
		return out;
	}
	let end = if lim + 1 < g.n { lim + 1 } else { g.n };
	var max_val = g.res[0];
	for k in 0..end {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	g.steps += end;
	out.i = max_val;
	out.s.clear();
	format(out.s, "scanned prefix peak is ", max_val);
	out
}
@end
