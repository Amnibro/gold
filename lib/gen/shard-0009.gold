modifier: up_to
context: transform
phrase: drop items up to index {cutoff}
phrase: discard elements up to position {cutoff}
phrase: remove items up to index boundary {cutoff}
slot: cutoff int
test: list=10,20,30,40,50 cutoff=2
expect: => i=3 r=0.0 ok=true s="dropped items up to 2" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=7,14,21,28 cutoff=3
expect: => i=1 r=0.0 ok=true s="dropped items up to 3" errors=0 n=1 res=[28] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if cut <= 0 { return out; }
	let drop_cnt = if cut < g.n { cut } else { g.n };
	let rem = g.n - drop_cnt;
	for i in rem {
		g.res[i] = g.res[drop_cnt + i];
		g.steps++;
	}
	g.n = rem;
	out.i = rem;
	out.s.clear();
	format(out.s, "dropped items up to ", drop_cnt);
	out
}
@end
