fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${count};
	if out.s.len > 1 && times > 0 {
		for t in times {
			let first = out.s[0];
			for i in 0..(out.s.len - 1) {
				out.s[i] = out.s[i + 1];
			}
			out.s[out.s.len - 1] = first;
			g.steps++;
		}
	}
	out.i = out.s.len;
	out
}
@end
