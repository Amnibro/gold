fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = g.n;
	if m == 0 {
		out.s.clear();
		out.s.append("empty dataset");
		return out;
	}
	var sums int[512] = [0; 512];
	var run = 0;
	var k = m - 1;
	while k >= 0 {
		run += g.res[k];
		sums[k] = run;
		if k == 0 { break; }
		k--;
	}
	gold_clear(g);
	for i in m { gold_push(g, sums[i]); }
	g.steps += m;
	out.i = run;
	out.s.clear();
	format(out.s, "reverse sum is ", run);
	out
}
@end
@entry ba30ca2b191c59f8
kind: step
verb: collect
noun: squares
modifier: times
context: stats
phrase: collect squared deviations scaled {factor} times
phrase: accumulate squared deviations multiplied {factor} times
slot: factor int
test: list=2,4,6 factor=2
expect: => i=16 r=0.0 ok=true s="collected squares total 16" errors=0 n=6 res=[2,4,6,8,0,8] cache=0 hits=0
test: list=1,3,5 factor=3
expect: => i=24 r=0.0 ok=true s="collected squares total 24" errors=0 n=6 res=[1,3,5,12,0,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.s.clear();
		out.s.append("no observations");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let mean = sum / g.n;
	var total_sq = 0;
	for k in g.n {
		let diff = g.res[k] - mean;
		let sq = diff * diff * f;
		total_sq += sq;
		gold_push(g, sq);
	}
	g.steps += g.n * 2;
	out.i = total_sq;
	out.s.clear();
	format(out.s, "collected squares total ", total_sq);
	out
}
@end
