fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor = ${lo};
	let ceil = ${hi};
	let plen = if g.n > 3 { 3 } else { g.n };
	var count = 0;
	for idx in plen {
		if g.res[idx] < floor { g.res[idx] = floor; count++; }
		else if g.res[idx] > ceil { g.res[idx] = ceil; count++; }
	}
	g.steps += plen + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "prefix clamped ", count);
	out
}
@end
