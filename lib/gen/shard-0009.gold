		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x { sq_count++; }
		}
	}
	g.steps += g.n;
	out.i = sq_count;
	out.ok = sq_count > 0;
	out.s.clear();
	format(out.s, "squares found ", sq_count);
	out
}
@end
