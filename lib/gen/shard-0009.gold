test: list=5,15
expect: => i=2 r=0.0 ok=true s="reversed cache: 2" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		gold_cache_put(g, g.res[i], i);
	}
	for i in g.cn / 2 {
		let j = g.cn - 1 - i;
		let tk = g.ck[i];
		let tv = g.cv[i];
		g.ck[i] = g.ck[j];
		g.cv[i] = g.cv[j];
		g.ck[j] = tk;
		g.cv[j] = tv;
	}
	out.s.clear();
	format(out.s, "reversed cache: ", g.cn);
	out.i = g.cn;
	g.steps += g.cn;
	out
}
@end
