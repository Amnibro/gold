	while idx >= 0 {
		if g.res[idx] == target {
			last_pos = idx;
			break;
		}
		idx--;
	}
	g.steps += g.n;
	out.i = last_pos;
	out.s.clear();
	if last_pos >= 0 {
		format(out.s, "last occurrence of letter at index ", last_pos);
	} else {
		out.s.append("letter code not found");
	}
	out
}
@end
