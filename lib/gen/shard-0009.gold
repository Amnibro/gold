fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var s = 0;
		while x > 0 {
			s += x % 10;
			x /= 10;
		}
		g.res[k] = s;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
