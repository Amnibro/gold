fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${turns};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	gold_push(g, sum);
	if g.n > 1 && t > 0 {
		let k = t % g.n;
		for step in k {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated tally with sum ", sum);
	out
}
@end
