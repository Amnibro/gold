test: list=65,10,66,20,67
expect: => i=3 r=0.0 ok=true s="validated 3 alternate uppercase letter codes" errors=0 n=5 res=[65,10,66,20,67] cache=0 hits=0
test: list=65,10,97
expect: => i=0 r=0.0 ok=false s="item at index 2 is not uppercase code" errors=1 n=3 res=[65,10,97] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid_cnt = 0;
	var idx = 0;
	while idx < g.n {
		let c = g.res[idx];
		if !(c >= 65 && c <= 90) {
			gold_fail(g, "not uppercase code");
			out.ok = false;
			out.i = 0;
			out.s.clear();
			format(out.s, "item at index ", idx, " is not uppercase code");
			return out;
		}
		valid_cnt++;
		idx += 2;
	}
	g.steps += valid_cnt;
	out.i = valid_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "validated ", valid_cnt, " alternate uppercase letter codes");
	out
}
@end
