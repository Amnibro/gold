@entry b34e0ef09c146d4c
kind: step
verb: sort
noun: squares
modifier: until
context: cache
phrase: sort squares in cache until limit {cap}
phrase: order squared cache values until bound {cap}
phrase: sort squared cache items until ceiling {cap}
slot: cap int
test: list=5,2,4 cap=20
expect: => i=2 r=0.0 ok=true s="sorted squares under limit 2" errors=0 n=3 res=[5,2,4] cache=3 hits=0
test: list=6,3,1 cap=15
expect: => i=2 r=0.0 ok=true s="sorted squares under limit 2" errors=0 n=3 res=[6,3,1] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k] * g.res[k]); }
	let limit = ${cap};
	for i in g.cn {
		for j in g.cn - 1 {
			if g.cv[j] > g.cv[j + 1] {
				let tmp = g.cv[j];
				g.cv[j] = g.cv[j + 1];
				g.cv[j + 1] = tmp;
			}
		}
	}
	var count = 0;
	for k in g.cn {
		if g.cv[k] <= limit { count++; }
		else { break; }
	}
	g.steps += g.cn * g.cn;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted squares under limit ", count);
	out
}
@end
