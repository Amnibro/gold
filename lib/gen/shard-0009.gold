fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results for running average");
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	let scaled = avg * sc;
	g.steps += g.n;
	out.i = scaled;
	out.s.clear();
	format(out.s, "running average scaled is ", scaled);
	out
}
@end
