expect: => i=2 r=0.0 ok=true s="rotated cache to index 2" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let tgt = ${target};
	var idx = -1;
	for k in g.cn {
		if g.cv[k] == tgt {
			idx = k;
			break;
		}
	}
	if idx > 0 {
		var tk int[256] = [0; 256];
		var tv int[256] = [0; 256];
		for k in g.cn {
			tk[k] = g.ck[(k + idx) % g.cn];
			tv[k] = g.cv[(k + idx) % g.cn];
		}
		for k in g.cn {
			g.ck[k] = tk[k];
			g.cv[k] = tv[k];
		}
	}
	g.steps += g.cn;
	out.i = idx;
	out.s.clear();
	format(out.s, "rotated cache to index ", idx);
	out
}
@end
@entry 91fd5a64b0ddebdf
kind: step
verb: dedupe
noun: prefix
modifier: last
context: cache
phrase: deduplicate cache prefix keeping last occurrence
phrase: remove duplicate prefix entries retaining last
phrase: dedupe cache prefix with last occurrence
test: list=10,10,20,30
expect: => i=3 r=0.0 ok=true s="deduped prefix keeping last 3" errors=0 n=4 res=[10,10,20,30] cache=3 hits=0
test: list=5,5,15
expect: => i=2 r=0.0 ok=true s="deduped prefix keeping last 2" errors=0 n=3 res=[5,5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var uniq int[256] = [0; 256];
	var un = 0;
	var k = g.cn - 1;
	while k >= 0 {
		let v_item = g.cv[k];
		var seen = false;
		for j in un {
			if uniq[j] == v_item { seen = true; break; }
		}
		if !seen {
			uniq[un] = v_item;
			un++;
		}
		k--;
	}
	g.cn = un;
	for i in un {
		g.cv[i] = uniq[un - 1 - i];
		g.ck[i] = i;
	}
	g.steps += g.cn;
	out.i = un;
	out.s.clear();
	format(out.s, "deduped prefix keeping last ", un);
	out
}
@end
