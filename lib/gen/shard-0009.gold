expect: => i=2 r=0.0 ok=true s="found 2 unique items in suffix" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slen = ${suffix_len};
	var start = g.n - slen;
	if start < 0 { start = 0; }
	var unique_count = 0;
	for i in start..g.n {
		var first = true;
		for j in start..i {
			if g.res[j] == g.res[i] { first = false; break; }
		}
		if first { unique_count++; }
	}
	g.steps += g.n;
	out.i = unique_count;
	out.s.clear();
	format(out.s, "found ", unique_count, " unique items in suffix");
	out
}
@end
@entry ba1bf8614ebaf403
kind: step
verb: group
noun: gaps
modifier: nested
context: search
phrase: group nested search gaps exceeding jump {jump}
phrase: identify nested gap jumps larger than {jump}
slot: jump int
test: list=1,5,6,12,13 jump=3
expect: => i=2 r=0.0 ok=true s="found 2 nested gaps exceeding threshold" errors=0 n=5 res=[1,5,6,12,13] cache=0 hits=0
test: list=2,10,20 jump=5
expect: => i=2 r=0.0 ok=true s="found 2 nested gaps exceeding threshold" errors=0 n=3 res=[2,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let threshold = ${jump};
	var gaps = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff > threshold || diff < -threshold {
				gaps++;
			}
		}
	}
	g.steps += g.n;
	out.i = gaps;
	out.s.clear();
	format(out.s, "found ", gaps, " nested gaps exceeding threshold");
	out
}
@end
