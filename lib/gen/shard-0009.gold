expect: => i=3 r=0.0 ok=true s="mapped 3 items to sorted ranks" errors=0 n=3 res=[2,0,1] cache=0 hits=0
test: list=5,2,8,1
expect: => i=4 r=0.0 ok=true s="mapped 4 items to sorted ranks" errors=0 n=4 res=[2,1,3,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ranks int[512] = [0; 512];
	for i in g.n {
		var r = 0;
		for j in g.n {
			if g.res[j] < g.res[i] || (g.res[j] == g.res[i] && j < i) {
				r++;
			}
		}
		ranks[i] = r;
	}
	for i in g.n {
		g.res[i] = ranks[i];
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped ", g.n, " items to sorted ranks");
	out
}
@end
