code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${shift_val};
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[i] += sv;
		g.res[i + 1] += sv;
		pairs++;
		i += 2;
	}
	g.steps += g.n;
	out.i = pairs;
	out.s.clear();
	format(out.s, "shifted nested pairs: ", pairs);
	out
}
@end
