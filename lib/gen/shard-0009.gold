kind: step
verb: merge
noun: window
modifier: unique
context: stats
phrase: merge sliding window into unique values of size {win_size}
phrase: consolidate window samples into unique observations of size {win_size}
slot: win_size int
test: list=1,1,2,2,3,3 win_size=2
expect: => i=3 r=0.0 ok=true s="merged 3 unique items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
