expect: => i=2 r=0.0 ok=true s="pairwise sequence sums: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
test: list=5,15
expect: => i=1 r=0.0 ok=true s="pairwise sequence sums: 1" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		g.res[count] = g.res[i] + g.res[i + 1];
		count++;
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "pairwise sequence sums: ", count);
	out
}
@end
