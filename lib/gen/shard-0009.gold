phrase: cap trailing memo cache value to bound {cap}
phrase: restrict final memo cache value to limit {cap}
slot: cap int
test: list=10,20,50 cap=35
expect: => i=35 r=0.0 ok=true s="clamped last memo value 35" errors=0 n=3 res=[10,20,50] cache=3 hits=0
test: list=5,15,30 cap=20
expect: => i=20 r=0.0 ok=true s="clamped last memo value 20" errors=0 n=3 res=[5,15,30] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let limit = ${cap};
	if g.cn > 0 {
		let last_idx = g.cn - 1;
		if g.cv[last_idx] > limit {
			g.cv[last_idx] = limit;
		}
		out.i = g.cv[last_idx];
	}
	g.steps += g.cn;
	out.s.clear();
	format(out.s, "clamped last memo value ", out.i);
	out
}
@end
