code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_size};
	var parts = 0;
	if cap > 0 && g.n > 0 {
		parts = (g.n + cap - 1) / cap;
	}
	out.i = parts;
	g.steps += parts + 1;
	out.s.clear();
	format(out.s, "safely grouped sequence parts ", parts);
	out
}
