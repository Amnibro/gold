kind: step
verb: drop
noun: total
modifier: between
context: loop
phrase: drop total between bounds {low} to {high}
phrase: exclude total between thresholds {low} through {high}
slot: low int
slot: high int
test: list=5,15,25,35 low=10 high=30
expect: => i=2 r=0.0 ok=true s="dropped 2 total between bounds" errors=0 n=2 res=[5,35] cache=0 hits=0
test: list=1,2,3 low=10 high=20
expect: => i=0 r=0.0 ok=true s="dropped 0 total between bounds" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var write_idx = 0;
	var dropped = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			dropped++;
		} else {
			g.res[write_idx] = x;
			write_idx++;
		}
	}
	g.n = write_idx;
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " total between bounds");
	out
}
@end
