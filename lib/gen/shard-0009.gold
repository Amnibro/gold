code:
fn ${ID}_is_prime(x int) bool {
	if x < 2 { return false; }
	var d = 2;
	while d * d <= x {
		if x % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_pairs = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if ${ID}_is_prime(g.res[i]) && ${ID}_is_prime(g.res[i + 1]) {
				prime_pairs++;
			}
		}
	}
	out.s.clear();
	format(out.s, "prime pairs: ", prime_pairs);
	out.i = prime_pairs;
	g.steps += g.n;
	out
}
@end
