@entry 6fa3d2e916c3bc03
kind: step
verb: dedupe
noun: window
modifier: nested
context: error
phrase: dedupe nested window of error codes
phrase: remove duplicate errors in nested window
slot: wlen int
test: list=1,1,2,2,3,3 wlen=4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,3] cache=0 hits=0
test: list=4,4,4,5,5 wlen=3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = if ${wlen} < g.n { ${wlen} } else { g.n };
	if w > 1 {
		var kept = 0;
		for i in w {
			var dup = false;
			for j in kept {
				if g.res[j] == g.res[i] {
					dup = true;
				}
			}
			if !dup {
				g.res[kept] = g.res[i];
				kept++;
			}
		}
		for i in w..g.n {
			g.res[kept] = g.res[i];
			kept++;
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = g.n;
	out
}
@end
