fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	var start = 0;
	if g.n > tl { start = g.n - tl; }
	var k = 0;
	while start < g.n {
		g.res[k] = g.res[start];
		k++;
		start++;
	}
	g.n = k;
	g.steps += k;
	out.i = k;
	out.s.clear();
	format(out.s, "retained tail numbers: ", k);
	out
}
