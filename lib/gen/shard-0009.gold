phrase: divide elements into segments spanning at most {max_span}
slot: max_span int
test: list=10,15,30,35 max_span=10
expect: => i=2 r=0.0 ok=true s="split range segments count 2" errors=0 n=4 res=[10,15,30,35] cache=0 hits=0
test: list=5,6,7 max_span=10
expect: => i=1 r=0.0 ok=true s="split range segments count 1" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${max_span};
	var segments = 0;
	if g.n > 0 {
		segments = 1;
		var start_val = g.res[0];
		for i in 1..g.n {
			var diff = g.res[i] - start_val;
			if diff < 0 { diff = -diff; }
			if diff > bound {
				segments++;
				start_val = g.res[i];
			}
		}
	}
	out.i = segments;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "split range segments count ", segments);
	out
}
@end
