fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		while left < right && g.res[left] <= lim { left++; }
		while left < right && g.res[right] > lim { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
