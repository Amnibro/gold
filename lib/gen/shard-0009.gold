code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_streak = 0;
	var cur_streak = 0;
	var last_val = -999999;
	for k in g.n {
		let x = g.res[k];
		if x == last_val {
			cur_streak++;
		} else {
			last_val = x;
			cur_streak = 1;
		}
		if cur_streak > max_streak { max_streak = cur_streak; }
		gold_cache_put(g, x, cur_streak);
		g.steps++;
	}
	out.i = max_streak;
	out.s.clear();
	format(out.s, "max streak was ", max_streak);
	out
}
