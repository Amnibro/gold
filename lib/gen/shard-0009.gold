fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	let count = g.n;
	let valid = count >= lo && count <= hi;
	g.steps += count;
	out.ok = valid;
	out.i = count;
	if valid {
		gold_text(out, "sort counter valid");
	} else {
		gold_fail(g, "sort counter out of bounds");
		gold_text(out, "sort counter invalid");
	}
	out
}
@end
