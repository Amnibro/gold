expect: => i=0 r=0.0 ok=true s="scale range boosted by 0" errors=0 n=2 res=[5,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${floor};
	if g.n < 2 {
		gold_push(g, target);
		out.i = target;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let current_range = max_val - min_val;
	var scaled = 0;
	if current_range < target {
		let diff = target - current_range;
		g.res[g.n - 1] += diff;
		scaled = diff;
	}
	out.i = scaled;
	g.steps += 1;
	out.s.clear();
	format(out.s, "scale range boosted by ", scaled);
	out
}
@end
