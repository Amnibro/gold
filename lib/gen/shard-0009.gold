fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var small_gaps = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let d = if diff < 0 { -diff } else { diff };
			if d <= mg { small_gaps++; }
		}
	}
	out.s.clear();
	format(out.s, "small gaps: ", small_gaps);
	out.i = small_gaps;
	g.steps += g.n;
	out
}
@end
