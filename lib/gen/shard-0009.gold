fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var big_gaps = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let diff = g.res[i + 1] - g.res[i];
			let gap = if diff < 0 { -diff } else { diff };
		if gap > 3 { big_gaps++; }
		}
	}
	g.steps += g.n;
	out.i = big_gaps;
	out.s.clear();
	format(out.s, "scanned gaps in place count ", big_gaps);
	out
}
@end
