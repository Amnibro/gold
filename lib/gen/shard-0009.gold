code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = out.i;
	let lim = ${limit};
	if start > lim {
		gold_fail(g, "range start exceeds limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: inverted range");
		return out;
	}
	gold_clear(g);
	var cur = start;
	while cur <= lim {
		gold_push(g, cur);
		cur++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected range of ", g.n, " numbers");
	out
}
@end
