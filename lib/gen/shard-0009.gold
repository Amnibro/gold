slot: max_diff int
test: text="az" max_diff=5
expect: => i=1 r=0.0 ok=true s="af" errors=0 n=0 res=[] cache=0 hits=0
test: text="abc" max_diff=2
expect: => i=0 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_diff};
	var clamped = 0;
	if out.s.len > 1 {
		for i in out.s.len - 1 {
			let a = out.s[i] as int;
			let b = out.s[i + 1] as int;
			if b - a > limit {
				out.s[i + 1] = (a + limit) as byte;
				clamped++;
			}
		}
	}
	g.steps += out.s.len;
	out.i = clamped;
	out
}
@end
