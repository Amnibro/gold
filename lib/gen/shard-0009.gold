	var i = 0;
	while i + 1 < g.n {
		let pair_sum = g.res[i] + g.res[i + 1];
		if pair_sum >= flr {
			g.res[count] = pair_sum;
			count++;
		}
		i += 2;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "qualifying pairs count: ", count);
	out
}
