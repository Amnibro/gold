	let w = ${width};
	if g.n < w {
		gold_fail(g, "list smaller than window width");
		out.ok = false;
		return out;
	}
	let start = (g.n - w) / 2;
	for k in w {
		g.res[k] = g.res[start + k];
	}
	g.n = w;
	out.i = w;
	g.steps += w;
	out
}
@end
