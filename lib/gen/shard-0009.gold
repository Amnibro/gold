@entry 28443dc8f0040210
kind: step
verb: rotate
noun: squares
modifier: pairwise
context: core
phrase: rotate consecutive paired square numbers in sequence
phrase: swap adjacent pairs when both are perfect squares
test: list=4,9,16,25
expect: => i=2 r=0.0 ok=true s="pairwise square swaps 2" errors=0 n=4 res=[9,4,25,16] cache=0 hits=0
test: list=2,3,4,5
expect: => i=0 r=0.0 ok=true s="pairwise square swaps 0" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	var i = 0;
	while i < g.n - 1 {
		let a = g.res[i];
		let b = g.res[i + 1];
		var sq_a = false;
		var sq_b = false;
		if a >= 0 {
			var r = 0; while r * r < a { r++; }
			if r * r == a { sq_a = true; }
		}
		if b >= 0 {
			var r = 0; while r * r < b { r++; }
			if r * r == b { sq_b = true; }
		}
		if sq_a && sq_b {
			g.res[i] = b;
			g.res[i + 1] = a;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = swaps;
	g.steps += swaps + 1;
	out.s.clear();
	format(out.s, "pairwise square swaps ", swaps);
	out
}
@end
