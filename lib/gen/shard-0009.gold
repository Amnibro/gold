code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var start = g.n;
	for k in g.n {
		if g.res[k] == tgt {
			start = k;
			break;
		}
	}
	let rem = g.n - start;
	for i in rem {
		g.res[i] = g.res[start + i];
		g.steps++;
	}
	g.n = rem;
	out.i = rem;
	out.s.clear();
	format(out.s, "dropped until found remaining ", rem);
	out
}
@end
