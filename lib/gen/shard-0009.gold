fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	if n <= 1 { return out; }
	let d = (${depth} % n + n) % n;
	var tmp byte[..200] = "";
	for i in n {
		let src = (i + d) % n;
		tmp.push(out.s[src]);
	}
	out.s.clear();
	for b in tmp { out.s.push(b); }
	g.steps += n;
	out.i = d;
	out
}
@end
