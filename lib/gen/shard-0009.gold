fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	let f = ${factor};
	if g.cn == 0 {
		gold_cache_put(g, 1, 10);
		gold_cache_put(g, 2, 20);
		gold_cache_put(g, 3, 50);
	}
	var scaled = 0;
	for i in g.cn {
		if g.cv[i] <= mv {
			g.cv[i] *= f;
			scaled++;
		}
	}
	g.steps += g.cn;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " memo values at most limit");
	out
}
@end
