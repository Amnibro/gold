noun: runs
modifier: at_least
context: sort
phrase: trace sorted runs having length at least {min_len}
phrase: record sorted duplicate runs of length at least {min_len}
slot: min_len int
test: list=1,1,1,2,3,3,3,3 min_len=3
expect: => i=2 r=0.0 ok=true s="traced 2 runs reaching minimum length" errors=0 n=8 res=[1,1,1,2,3,3,3,3] cache=0 hits=0
test: list=4,4,5,6,6 min_len=2
expect: => i=2 r=0.0 ok=true s="traced 2 runs reaching minimum length" errors=0 n=5 res=[4,4,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var run_count = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if j - i >= ml {
			run_count++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = run_count;
	out.s.clear();
	format(out.s, "traced ", run_count, " runs reaching minimum length");
	out
}
@end
