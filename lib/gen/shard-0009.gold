	let orig = g.n;
	if orig > 0 {
		var k = 0;
		while g.n < lim && g.n < 512 {
			gold_push(g, g.res[k % orig]);
			k++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated search items to ", g.n);
