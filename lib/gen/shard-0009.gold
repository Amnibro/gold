fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { out.ok = false; return out; }
	var valid_count = 0;
	for idx in (g.n - 1) {
		let avg = (g.res[idx] + g.res[idx + 1]) / 2;
		if avg >= 10 { valid_count++; }
	}
	g.steps += g.n + 1;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "pairwise avg valid: ", valid_count);
	out
}
