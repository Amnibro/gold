fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let key = g.res[k];
		let val, ok = gold_cache_get(g, key);
		if ok {
			gold_cache_put(g, key, val + 1);
		} else {
			gold_cache_put(g, key, 1);
		}
	}
	g.steps += g.n;
	out.i = g.hits;
	out.s.clear();
	format(out.s, "running cache hits ", g.hits);
	out
}
