	let b = ${baseline};
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var adjusted = 0;
	for k in g.n {
		if g.res[k] >= b {
			g.res[k] -= avg;
			adjusted++;
		}
		g.steps++;
	}
	out.i = adjusted;
	out.s.clear();
	format(out.s, "normalized elements at least baseline ", adjusted);
