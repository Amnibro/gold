@entry 8d2b8706a5ad6112
kind: step
verb: check
noun: primes
modifier: sorted
context: sort
phrase: check sorted elements for primes filtering composite
phrase: verify sorted primes sequence retaining only primes
test: list=2,3,4,5,6,7,8,9
expect: => i=4 r=0.0 ok=true s="retained 4 prime numbers" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=10,11,12,13
expect: => i=2 r=0.0 ok=true s="retained 2 prime numbers" errors=0 n=2 res=[11,13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 {
				is_p = false;
				break;
			}
			d++;
		}
		if is_p {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "retained ", kept, " prime numbers");
	out
}
@end
