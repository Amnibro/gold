fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp = [0; 512];
	var count_even = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			temp[count_even] = g.res[i];
			count_even++;
		}
	}
	var count_odd = count_even;
	for i in g.n {
		if g.res[i] % 2 != 0 {
			temp[count_odd] = g.res[i];
			count_odd++;
		}
	}
	for i in g.n { g.res[i] = temp[i]; }
	out.i = count_even;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "split evens first count ", count_even);
	out
}
@end
