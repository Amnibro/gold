test: list=5,15,25,35,45 mn=10 mx=40
expect: => i=3 r=0.0 ok=true s="grouped 3 bounded cache steps" errors=0 n=5 res=[5,15,25,35,45] cache=5 hits=0
test: list=2,8,14,20 mn=5 mx=15
expect: => i=2 r=0.0 ok=true s="grouped 2 bounded cache steps" errors=0 n=4 res=[2,8,14,20] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let low = ${mn};
	let high = ${mx};
	var matched = 0;
	for i in g.cn {
		if g.cv[i] >= low && g.cv[i] <= high { matched++; }
	}
	g.steps += g.cn;
	out.i = matched;
	out.s.clear();
	format(out.s, "grouped ", matched, " bounded cache steps");
	out
}
@end
@entry 53aedaafee6c6ca7
kind: step
verb: drop
noun: limit
modifier: at_least
context: cache
phrase: drop cached values reaching at least {threshold}
phrase: purge cache entries with values at least {threshold}
phrase: remove cached items greater equal to {threshold}
slot: threshold int
test: list=10,50,30,80 threshold=40
expect: => i=2 r=0.0 ok=true s="dropped 2 cache items reaching limit" errors=0 n=4 res=[10,50,30,80] cache=2 hits=0
test: list=5,25,15 threshold=20
expect: => i=1 r=0.0 ok=true s="dropped 1 cache items reaching limit" errors=0 n=3 res=[5,25,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var kept = 0;
	for i in g.cn {
		if g.cv[i] < limit {
			g.ck[kept] = g.ck[i];
			g.cv[kept] = g.cv[i];
			kept++;
		}
	}
	let dropped = g.cn - kept;
	g.cn = kept;
	g.steps += g.cn;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " cache items reaching limit");
	out
}
@end
