code:
fn is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	return true;
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes_found = 0;
	for i in g.n {
		if is_prime(g.res[i]) {
			gold_cache_put(g, g.res[i], 1);
			primes_found++;
		}
	}
	g.steps += g.n;
	out.i = primes_found;
	out.s.clear();
	format(out.s, "cached ", primes_found, " running primes");
	out
}
@end
@entry 5e3393e3341cac21
kind: step
verb: shift
noun: condition
modifier: safely
context: loop
phrase: shift condition safely by offset {offset}
phrase: rotate condition safely by amount {offset}
slot: offset int
test: list=10,20,30,40 offset=1
expect: => i=1 r=0.0 ok=true s="shifted safely by 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=5,15 offset=5
expect: => i=0 r=0.0 ok=false s="shift safely bounds error" errors=1 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 || off <= 0 || off >= g.n {
		gold_fail(g, "shift offset out of bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "shift safely bounds error");
		return out;
	}
	let first = g.res[0];
	for i in 1..g.n {
		g.res[i - 1] = g.res[i];
	}
	g.res[g.n - 1] = first;
	g.steps += g.n;
	out.i = off;
	out.s.clear();
	format(out.s, "shifted safely by ", off);
	out
}
@end
