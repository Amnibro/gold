test: text="format strings"
expect: => i=11 r=0.0 ok=true s="frmt strngs" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var buf byte[>..] = [];
	for idx in out.s.len {
		let c = out.s[idx];
		if !(c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
			buf.push(c);
		}
	}
	out.s.clear();
	for b in buf { out.s.push(b); }
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
