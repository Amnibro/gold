fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${times};
	gold_clear(g);
	var sq int[200] = [0; 200];
	var sn = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			let d = (c as int) - 48;
			sq[sn] = d * d;
			sn++;
		}
	}
	for _ in t {
		for j in sn {
			gold_push(g, sq[j]);
		}
	}
	g.steps += out.s.len + sn * t;
	out.i = sn;
	out.s.clear();
	format(out.s, "joined ", sn, " digit squares repeated ", t, " times");
	out
}
@end
