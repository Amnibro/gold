kind: step
verb: dedupe
noun: results
modifier: at_least
context: stats
phrase: dedupe sample values repeated at least {min_repeats} times
phrase: filter observations duplicated at least {min_repeats} times
slot: min_repeats int
test: list=5,5,5,10,10,20 min_repeats=3
expect: => i=2 r=0.0 ok=true s="deduped 2 repeated items" errors=0 n=4 res=[5,10,10,20] cache=0 hits=0
test: list=4,4,8,8,12 min_repeats=2
expect: => i=2 r=0.0 ok=true s="deduped 2 repeated items" errors=0 n=3 res=[4,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_repeats};
	var deduped int[512] = [0; 512];
	var dp = 0;
	var removed = 0;
	for k in g.n {
		let x = g.res[k];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= mr {
			var already_kept = false;
			for i in dp {
				if deduped[i] == x { already_kept = true; break; }
			}
			if already_kept {
				removed++;
				continue;
			}
		}
		deduped[dp] = x;
		dp++;
	}
	gold_clear(g);
	for i in dp { gold_push(g, deduped[i]); }
	g.steps += g.n * g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " repeated items");
	out
}
@end
