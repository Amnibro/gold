fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var word_cnt = 0;
	while i < out.s.len {
		if out.s[i] == ' ' {
			i++;
		} else {
			var j = i;
			while j < out.s.len && out.s[j] != ' ' { j++; }
			for a in i..j {
				for b in a + 1..j {
					if out.s[a] > out.s[b] {
						let tmp = out.s[a];
						out.s[a] = out.s[b];
						out.s[b] = tmp;
					}
				}
			}
			word_cnt++;
			i = j;
		}
	}
	g.steps += out.s.len * 2;
	out.i = word_cnt;
	out
}
@end
