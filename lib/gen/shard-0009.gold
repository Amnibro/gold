fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	for i in g.n {
		total += g.res[i];
	}
	let max_val = ${max_tally};
	if total > max_val {
		gold_fail(g, "error tally exceeded limit");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps += g.n;
	out.i = total;
	out
}
