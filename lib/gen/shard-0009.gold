fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	let rounds = ${times};
	var clamped = 0;
	for r in rounds {
		for idx in g.n {
			if g.res[idx] > limit {
				g.res[idx] = limit;
				clamped++;
			}
		}
	}
	g.steps += g.n * rounds + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "threshold clamped times: ", clamped);
	out
}
@end
