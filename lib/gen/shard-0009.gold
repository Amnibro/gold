test: list=2,3,4,5 f=square
expect: => i=2 r=0.0 ok=true s="safely paired 2 items" errors=0 n=2 res=[25,81] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		let combined = g.res[i] + g.res[i + 1];
		g.res[kept] = ${f}(combined);
		kept++;
		i += 2;
	}
	if i < g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "safely paired ", kept, " items");
	out
}
@end
