code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for k in g.n {
		if count >= lim { break; }
		gold_cache_put(g, k, g.res[k]);
		count++;
	}
	out.i = count;
	g.steps += count;
	out
}
@end
