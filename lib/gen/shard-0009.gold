@entry a4b2fd015953e0f4
kind: step
verb: sort
noun: threshold
modifier: each
context: error
phrase: sort error codes exceeding each threshold
phrase: partition error list around each threshold
slot: threshold int
test: list=450,200,500,100,300 threshold=350
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[200,100,300,450,500] cache=0 hits=0
test: list=50,10,60,20,40 threshold=30
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[10,20,50,60,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${threshold};
	var left int[512] = [0; 512];
	var right int[512] = [0; 512];
	var ln = 0;
	var rn = 0;
	for i in g.n {
		if g.res[i] <= limit {
			left[ln] = g.res[i];
			ln++;
		} else {
			right[rn] = g.res[i];
			rn++;
		}
	}
	for i in ln { g.res[i] = left[i]; }
	for i in rn { g.res[ln + i] = right[i]; }
	g.steps += g.n;
	out.i = ln;
	out
}
@end
