code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for _ in 2 {
		if g.n > 1 {
			for i in (g.n - 1) {
				if g.res[i + 1] > g.res[i] { g.res[i + 1] -= 2; }
			}
		}
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated reduction times two");
	out
}
@end
