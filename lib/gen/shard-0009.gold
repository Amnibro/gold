code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				g.res[k] += off;
				count++;
			}
		}
	}
	g.steps += g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "shifted ", count, " square values");
	out
}
@end
