fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	var i = 0;
	var word_cnt = 0;
	while i < out.s.len {
		if out.s[i] == ' ' {
			i++;
		} else {
			var min_c = out.s[i] as int;
			while i < out.s.len && out.s[i] != ' ' {
				let c = out.s[i] as int;
				if c < min_c { min_c = c; }
				i++;
			}
			gold_push(g, min_c);
			word_cnt++;
		}
	}
	g.steps += out.s.len + word_cnt;
