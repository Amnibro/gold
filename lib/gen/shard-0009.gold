code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var streak = 1;
	var truncated = 0;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			streak++;
			if streak > ml {
				g.res[i] = 0;
				truncated++;
			}
		} else {
			streak = 1;
		}
		i++;
	}
	g.steps += g.n;
	out.i = truncated;
	out.s.clear();
	format(out.s, "limited streak truncated ", truncated);
	out
}
@end
