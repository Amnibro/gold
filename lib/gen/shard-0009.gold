	var out = v;
	var s = 0;
	let k = if g.n > 3 { 3 } else { g.n };
	var i = k - 1;
	while i >= 0 {
		s += g.res[i];
		i--;
	}
	out.s.clear();
	format(out.s, "head sum: ", s);
	out.i = s;
	g.steps += k;
	out
}
