fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	if s <= 0 {
		gold_fail(g, "countdown start must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry positive start");
		return out;
	}
	gold_clear(g);
	var cur = s;
	while cur > 0 {
		gold_push(g, cur);
		cur--;
	}
	g.steps += s;
