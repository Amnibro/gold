fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var words byte[..10][..20] = [];
	var cur byte[..20] = "";
	var i = 0;
	while i < out.s.len {
		if out.s[i] == ' ' {
			if cur.len > 0 {
				words.push(cur);
				cur.clear();
			}
		} else {
			cur.push(out.s[i]);
		}
		i++;
	}
	if cur.len > 0 { words.push(cur); }
	out.s.clear();
	var w = words.len - 1;
	while w >= 0 {
		if out.s.len > 0 { out.s.push(' '); }
		format(out.s, words[w]);
		w--;
	}
	out.i = words.len;
	g.steps += 1;
	out
}
@end
@entry 33c6aab7ea6b81d9
