code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tail_start = if g.n > 3 { g.n - 3 } else { 0 };
	var i = tail_start;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i]; g.res[i] = g.res[j]; g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += (g.n - tail_start) * 2 + 1;
	out.i = g.n - tail_start;
	out.s.clear();
	format(out.s, "sorted last histogram items: ", out.i);
	out
}
@end
