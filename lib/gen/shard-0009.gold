code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var sum = 0;
	var valid = true;
	for k in g.n {
		sum += g.res[k];
		if sum > b {
			valid = false;
			break;
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = sum;
	out.s.clear();
	if valid {
		out.s.append("nested prefixes within bound");
	} else {
		out.s.append("prefix exceeded bound");
	}
	out
}
@end
