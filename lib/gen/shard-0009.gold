fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${limit};
	var over = 0;
	if g.n > 1 {
		for i in 0 .. g.n - 1 {
			var diff = g.res[i + 1] - g.res[i];
			if diff < 0 { diff = -diff; }
			if diff > thresh { over++; }
		}
	}
	out.i = over;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "pairwise gaps over threshold ", over);
	out
}
