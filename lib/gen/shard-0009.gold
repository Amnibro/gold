@entry 9a51499847449612
kind: step
verb: dedupe
noun: series
modifier: until
context: error
phrase: dedupe error series until target value
phrase: remove duplicates in series until stop token
slot: stop int
test: list=2,2,3,3,99,4,4 stop=99
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,99,4,4] cache=0 hits=0
test: list=5,5,6,0,7,7 stop=0
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[5,6,0,7,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark = ${stop};
	var stop_idx = 0;
	while stop_idx < g.n && g.res[stop_idx] != mark {
		stop_idx++;
	}
	var kept = 0;
	for i in stop_idx {
		var found = false;
		for j in kept {
			if g.res[j] == g.res[i] {
				found = true;
			}
		}
		if !found {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	for i in stop_idx..g.n {
		g.res[kept] = g.res[i];
		kept++;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out
}
@end
