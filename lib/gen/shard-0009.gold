	let min_bound = ${low};
	let max_bound = ${high};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var clamped = 0;
	for i in g.cn {
		if g.cv[i] < min_bound {
			g.cv[i] = min_bound;
			clamped++;
		} else if g.cv[i] > max_bound {
			g.cv[i] = max_bound;
			clamped++;
		}
	}
	out.i = clamped;
	g.steps += g.cn + 1;
	out.s.clear();
	format(out.s, "clamped memo between bounds ", clamped);
	out
}
