noun: duplicates
modifier: last
context: core
phrase: move all duplicate items to end of results
phrase: rotate duplicate elements to last positions
test: list=3,1,3,2,1
expect: => i=2 r=0.0 ok=true s="rotated duplicates to last 2" errors=0 n=5 res=[3,1,2,3,1] cache=0 hits=0
test: list=4,5,6
expect: => i=0 r=0.0 ok=true s="rotated duplicates to last 0" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_arr = [0; 512];
	var dup_arr = [0; 512];
	var u_count = 0;
	var d_count = 0;
	for i in g.n {
		let x = g.res[i];
		var is_dup = false;
		for j in 0..u_count {
			if unique_arr[j] == x { is_dup = true; break; }
		}
		if is_dup {
			dup_arr[d_count] = x;
			d_count++;
		} else {
			unique_arr[u_count] = x;
			u_count++;
		}
	}
	for i in u_count { g.res[i] = unique_arr[i]; }
	for i in d_count { g.res[u_count + i] = dup_arr[i]; }
	out.i = d_count;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "rotated duplicates to last ", d_count);
	out
}
@end
