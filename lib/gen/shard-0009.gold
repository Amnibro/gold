		let b = out.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			vowels++;
		}
	}
	let target = ${min_vowels};
	while vowels < target && out.s.len < 200 {
		out.s.push('e');
