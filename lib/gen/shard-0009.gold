phrase: trim tail with_cache preserving {k}
slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="limited tail to 2 sum 9" errors=0 n=2 res=[4,5] cache=1 hits=0
test: list=1,2 k=-1
expect: => i=0 r=0.0 ok=false s="error: negative count" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count < 0 {
		gold_fail(g, "negative tail count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative count");
		return out;
	}
	let lim = if count < g.n { count } else { g.n };
	let start = g.n - lim;
	var sum = 0;
	for i in lim {
		g.res[i] = g.res[start + i];
		sum += g.res[i];
	}
	g.n = lim;
	gold_cache_put(g, lim, sum);
	g.steps += lim;
	out.i = lim;
	out.s.clear();
	format(out.s, "limited tail to ", lim, " sum ", sum);
	out
}
@end
