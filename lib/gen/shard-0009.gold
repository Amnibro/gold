fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_space = -1;
	for i in out.s.len {
		if out.s[i] == ' ' { first_space = i; break; }
	}
	if first_space > 0 {
		var new_s byte[..200] = "";
		for i in (first_space + 1)..out.s.len { new_s.push(out.s[i]); }
		new_s.push(' ');
		for i in 0..first_space { new_s.push(out.s[i]); }
		out.s.clear();
		for i in new_s.len { out.s.push(new_s[i]); }
	}
	g.steps += out.s.len;
	out.i = first_space;
	out
}
@end
