@entry 7d4d23164c95fdee
kind: step
verb: sort
noun: window
modifier: until
context: format
phrase: format sorted window elements until threshold {cutoff}
phrase: render window sorted items up to limit {cutoff}
phrase: display sorted initial window until bound {cutoff}
slot: cutoff int
test: list=25,10,15,50,8 cutoff=30
expect: => i=3 r=0.0 ok=true s="window sorted until limit: 3" errors=0 n=5 res=[10,15,25,50,8] cache=0 hits=0
test: list=12,5,8,40 cutoff=20
expect: => i=3 r=0.0 ok=true s="window sorted until limit: 3" errors=0 n=4 res=[5,8,12,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var w = 0;
	while w < g.n && g.res[w] <= limit { w++; }
	var i = 0;
	while i < w {
		var j = i + 1;
		while j < w {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += w * w + 1;
	out.i = w;
	out.s.clear();
	format(out.s, "window sorted until limit: ", w);
	out
}
@end
