code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let limit = ${cap};
	for k in g.cn {
		var sq = g.cv[k] * g.cv[k];
		if sq > limit { sq = limit; }
		g.cv[k] = sq;
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "clamped squared cache entries ", g.cn);
	out
}
@end
