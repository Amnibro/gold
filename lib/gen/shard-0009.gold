kind: step
verb: rank
noun: gaps
modifier: between
context: stats
phrase: rank measurement gaps falling between {min_gap} to {max_gap}
phrase: score observation differences between {min_gap} to {max_gap}
slot: min_gap int
slot: max_gap int
test: list=10,15,30,35,45 min_gap=4 max_gap=8
expect: => i=10 r=0.0 ok=true s="ranked 2 gaps score 10" errors=0 n=5 res=[10,15,30,35,45] cache=0 hits=0
test: list=1,10,12,25 min_gap=10 max_gap=20
expect: => i=13 r=0.0 ok=true s="ranked 1 gaps score 13" errors=0 n=4 res=[1,10,12,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_gap};
	let hi = ${max_gap};
	if g.n < 2 {
		out.s.clear();
		out.s.append("need two points");
		return out;
	}
	var total_score = 0;
	var count = 0;
	for k in 0..(g.n - 1) {
		let diff = g.res[k + 1] - g.res[k];
		let gap = if diff < 0 { -diff } else { diff };
		if gap >= lo && gap <= hi {
			total_score += gap;
			count++;
		}
	}
	g.steps += g.n;
	out.i = total_score;
	out.s.clear();
	format(out.s, "ranked ", count, " gaps score ", total_score);
	out
}
@end
@entry f6c6d9889a990e6c
kind: step
verb: rank
noun: digits
modifier: none
context: stats
phrase: rank observations by statistical digit distribution
phrase: order sample values by digit sums
test: list=19,21,12,45
expect: => i=4 r=0.0 ok=true s="ranked 4 items by digit sum" errors=0 n=4 res=[21,12,45,19] cache=0 hits=0
test: list=99,101,15,30
expect: => i=4 r=0.0 ok=true s="ranked 4 items by digit sum" errors=0 n=4 res=[101,30,15,99] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("no sort needed");
		return out;
	}
	for i in g.n {
		var min_idx = i;
		for j in (i + 1)..g.n {
			let sj = core_digit_sum(g.res[j]);
			let sm = core_digit_sum(g.res[min_idx]);
			if sj < sm { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "ranked ", g.n, " items by digit sum");
	out
}
@end
