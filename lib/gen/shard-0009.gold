fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept int[64];
	var p = 0;
	kept[0] = g.res[0];
	p = 1;
	for i in (g.n - 1) {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff <= 20 {
			if p < 64 { kept[p] = g.res[i + 1]; p++; }
		}
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += p;
	out.i = p;
	out.s.clear();
	format(out.s, "gaps filtered count ", p);
	out
}
@end
