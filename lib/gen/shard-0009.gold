expect: => i=3 r=0.0 ok=true s="reversed 3 odd items" errors=0 n=3 res=[5,3,1] cache=0 hits=0
test: list=2,4,6
expect: => i=0 r=0.0 ok=false s="error: no odds" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var no = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] % 2 != 0 {
			odds[no] = g.res[i];
			no++;
		}
		i--;
	}
	if no == 0 {
		gold_fail(g, "no odd values found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no odds");
		return out;
	}
	g.n = no;
	for k in no {
		g.res[k] = odds[k];
	}
	g.steps += g.n;
	out.i = no;
	out.s.clear();
	format(out.s, "reversed ", no, " odd items");
	out
}
@end
