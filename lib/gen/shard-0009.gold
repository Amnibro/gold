@entry f38ff51a7b6170cc
kind: step
verb: split
noun: counter
modifier: each
context: aggregate
phrase: split counter each {step} elements
phrase: partition stream each {step} steps
phrase: divide entries every {step} intervals
slot: step int
test: list=1,2,3,4,5,6,7,8,9 step=3
expect: => i=3 r=0.0 ok=true s="split into 3 chunks" errors=0 n=3 res=[6,15,24] cache=0 hits=0
test: list=10,20,30,40,50,60 step=2
expect: => i=3 r=0.0 ok=true s="split into 3 chunks" errors=0 n=3 res=[30,70,110] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${step};
	if step <= 0 { return out; }
	var chunks = [0; 512];
	var chunk_count = 0;
	var cur_sum = 0;
	var in_chunk = 0;
	for k in g.n {
		cur_sum += g.res[k];
		in_chunk++;
		if in_chunk == step {
			chunks[chunk_count] = cur_sum;
			chunk_count++;
			cur_sum = 0;
			in_chunk = 0;
		}
		g.steps++;
	}
	if in_chunk > 0 {
		chunks[chunk_count] = cur_sum;
		chunk_count++;
	}
	gold_clear(g);
	for k in chunk_count { gold_push(g, chunks[k]); }
	out.i = chunk_count;
	out.s.clear();
	format(out.s, "split into ", chunk_count, " chunks");
	out
}
@end
