@entry a98630c3fe0e987d
kind: step
verb: rotate
noun: number
modifier: in_reverse
context: math
phrase: rotate number in_reverse shifts {shifts}
phrase: shift number in_reverse turns {shifts}
slot: shifts int
test: list=10,20,30,40 shifts=1
expect: => i=1 r=0.0 ok=true s="rotated in reverse by 1" errors=0 n=4 res=[20,30,40,10] cache=0 hits=0
test: list=1,2,3,4,5 shifts=2
expect: => i=2 r=0.0 ok=true s="rotated in reverse by 2" errors=0 n=5 res=[3,4,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sh = ${shifts};
	if g.n <= 1 || sh <= 0 {
		out.i = 0;
		return out;
	}
	let k = sh % g.n;
	for step in k {
		let first = g.res[0];
		for i in 0..(g.n - 1) {
			g.res[i] = g.res[i + 1];
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n * k;
	out.i = k;
	out.s.clear();
	format(out.s, "rotated in reverse by ", k);
	out
}
@end
