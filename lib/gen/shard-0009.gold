	var modified = 0;
	for k in g.cn {
		if g.cv[k] >= thr {
			g.cv[k] += offset;
			modified++;
		}
		g.steps++;
	}
	out.i = modified;
	out.s.clear();
	format(out.s, "shifted ", modified, " cache values");
	out
}
