	let hi, found_hi = gold_cache_get(g, 20);
	let min_val = if found_lo { lo } else { 0 };
	let max_val = if found_hi { hi } else { 100 };
	var changed = 0;
	for i in g.n {
		if g.res[i] < min_val { g.res[i] = min_val; changed++; }
		else if g.res[i] > max_val { g.res[i] = max_val; changed++; }
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "cached clamped in place ", changed);
	out
}
@end
