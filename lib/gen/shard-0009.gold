fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = -1;
	var idx = g.n - 1;
	while idx >= 0 {
		let x = g.res[idx];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				found = x;
				break;
			}
		}
		idx--;
	}
	out.i = found;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "found reverse square value ", found);
	out
}
@end
