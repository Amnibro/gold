code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	var acc = 0;
	for k in g.n {
		acc += g.res[k];
		g.res[k] = acc;
	}
	g.steps += g.n * g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "sorted tally total ", acc);
	out
}
