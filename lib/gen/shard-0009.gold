test: list=2,3,4,5,6 scale=3
expect: => i=3 r=0.0 ok=true s="cached 3 scaled even values" errors=0 n=5 res=[2,3,4,5,6] cache=3 hits=0
test: list=1,3,5 scale=3
expect: => i=0 r=0.0 ok=false s="error: zero evens cached" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${scale};
	var cached = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			gold_cache_put(g, g.res[i], g.res[i] * sc);
			cached++;
		}
	}
	if cached == 0 {
		gold_fail(g, "no even values to cache");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero evens cached");
		return out;
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " scaled even values");
	out
}
@end
@entry 0f0cd8092a1f82d7
kind: step
verb: split
noun: primes
modifier: with_retry
context: retry
phrase: split primes with_retry threshold {limit}
phrase: partition primes with_retry ceiling {limit}
slot: limit int
test: list=2,3,4,5,6 limit=4
expect: => i=2 r=0.0 ok=true s="split 2 primes under threshold 4" errors=0 n=5 res=[2,3,4,5,6] cache=0 hits=0
test: list=4,6,8,9 limit=10
expect: => i=0 r=0.0 ok=false s="error: retry split primes" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var primes int[512] = [0; 512];
	var non_primes int[512] = [0; 512];
	var np = 0;
	var nnp = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && x <= lim {
			primes[np] = x;
			np++;
		} else {
			non_primes[nnp] = x;
			nnp++;
		}
	}
	if np == 0 {
		gold_fail(g, "no primes under threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry split primes");
		return out;
	}
	for k in np { g.res[k] = primes[k]; }
	for k in nnp { g.res[np + k] = non_primes[k]; }
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "split ", np, " primes under threshold ", lim);
	out
}
@end
