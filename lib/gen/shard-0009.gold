	for k in g.n {
		let cond = if g.res[k] > th { 1 } else { 0 };
		gold_cache_put(g, k, cond);
		if cond == 1 { matches++; }
		g.steps++;
	}
	out.i = matches;
	out.s.clear();
	format(out.s, "cached condition matches ", matches);
	out
}
@end
