test: list=10,20,30,40 cutoff=25
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=2,4,6,8,10 cutoff=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[2,4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var s = 0;
	for k in g.n { s += g.res[k]; }
	let avg = s / g.n;
	var count = 0;
	for k in g.n {
		if g.res[k] >= avg && g.res[k] >= cut { count++; }
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
