test: list=3,4,5
expect: => i=3 r=0.0 ok=true s="normalized in reverse 3 items" errors=0 n=3 res=[-5,-4,-3] cache=0 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for normalization");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = -g.res[right];
		g.res[right] = -tmp;
		left++;
		right--;
	}
	if left == right {
		g.res[left] = -g.res[left];
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized in reverse ", g.n, " items");
	out
}
@end
