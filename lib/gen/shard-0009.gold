code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digit_count = 0;
	for k in out.s.len {
		let c = out.s[k];
		if c >= '0' && c <= '9' {
			let d = (c - '0') as int;
			let prev, ok = gold_cache_get(g, d);
			if ok {
				gold_cache_put(g, d, prev + 1);
			} else {
				gold_cache_put(g, d, 1);
			}
			digit_count++;
		}
		g.steps++;
	}
	out.i = digit_count;
	out.s.clear();
	format(out.s, "cached ", digit_count, " digits");
	out
}
@end
