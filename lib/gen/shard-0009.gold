kind: step
verb: sort
noun: function
modifier: times
context: stats
phrase: sort samples by transformed metric {f} scaled {factor} times
phrase: order observations by function {f} scaled {factor} times
slot: f fn
slot: factor int
test: list=3,1,4,2 f=square factor=2
expect: => i=4 r=0.0 ok=true s="sorted 4 items by function" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
test: list=10,5,20 f=inc factor=3
expect: => i=3 r=0.0 ok=true s="sorted 3 items by function" errors=0 n=3 res=[5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sc = ${factor};
	if g.n < 2 {
		out.s.clear();
		out.s.append("already sorted");
		return out;
	}
	for i in g.n {
		var min_idx = i;
		let v_min = ${f}(g.res[i]) * sc;
		for j in (i + 1)..g.n {
			let v_cur = ${f}(g.res[j]) * sc;
			if v_cur < v_min { min_idx = j; }
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " items by function");
	out
}
@end
