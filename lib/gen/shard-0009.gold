@entry 4cf83fd17b2d8fd2
kind: step
verb: rotate
noun: memo
modifier: any
context: search
phrase: rotate search memo cache entries by {offset}
phrase: shift search memo cache by {offset}
phrase: cycle search memo table by {offset}
slot: offset int
test: list=10,20,30 offset=1
expect: => i=3 r=0.0 ok=true s="rotated search cache size 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15,25,35 offset=2
expect: => i=4 r=0.0 ok=true s="rotated search cache size 4" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	if g.cn > 1 {
		let off = ${offset} % g.cn;
		var tk int[256] = [0; 256];
		var tv int[256] = [0; 256];
		for k in g.cn {
			tk[(k + off) % g.cn] = g.ck[k];
			tv[(k + off) % g.cn] = g.cv[k];
		}
		for k in g.cn {
			g.ck[k] = tk[k];
			g.cv[k] = tv[k];
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "rotated search cache size ", g.cn);
	out
}
@end
