@entry c889af23077b8eb7
kind: step
verb: normalize
noun: history
modifier: between
context: transform
phrase: normalize history values between {low} through {high}
phrase: scale history entries between range bounds {low} to {high}
phrase: fit history between {low} through {high}
slot: low int
slot: high int
test: list=10,20,30,40 low=0 high=100
expect: => i=4 r=0.0 ok=true s="normalized history entries 4" errors=0 n=4 res=[0,33,66,100] cache=0 hits=0
test: list=2,4,6,8 low=10 high=50
expect: => i=4 r=0.0 ok=true s="normalized history entries 4" errors=0 n=4 res=[10,23,36,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	if g.n == 0 || l >= h { return out; }
	var mn = g.res[0];
	var mx = g.res[0];
	for k in 1..g.n {
		if g.res[k] < mn { mn = g.res[k]; }
		if g.res[k] > mx { mx = g.res[k]; }
	}
	let span = mx - mn;
	for k in g.n {
		if span > 0 {
			let norm = l + ((g.res[k] - mn) * (h - l)) / span;
			g.res[k] = norm;
		} else {
			g.res[k] = l;
		}
		g.steps++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "normalized history entries ", g.n);
	out
}
@end
@entry 1b68619c46dc1699
kind: step
verb: cache
noun: counter
modifier: last
context: transform
phrase: cache counter value for last {k} results
phrase: record frequency counter of last {k} entries
phrase: store counter for trailing {k} items in cache
slot: k int
test: list=5,10,15,20,25 k=3
expect: => i=3 r=0.0 ok=true s="cached last counter items 3" errors=0 n=5 res=[5,10,15,20,25] cache=3 hits=0
test: list=1,2,3,4 k=2
expect: => i=2 r=0.0 ok=true s="cached last counter items 2" errors=0 n=4 res=[1,2,3,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	var start = g.n - count;
	if start < 0 { start = 0; }
	var cached = 0;
	for i in start..g.n {
		gold_cache_put(g, i, g.res[i]);
		cached++;
		g.steps++;
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "cached last counter items ", cached);
	out
}
@end
