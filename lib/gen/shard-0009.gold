fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens int[>..] = [];
	var odds int[>..] = [];
	for idx in g.n {
		if g.res[idx] % 2 == 0 {
			evens.push(g.res[idx]);
		} else {
			odds.push(g.res[idx]);
		}
