	if total < tgt {
		gold_fail(g, "total below target");
		out.ok = false;
		out.s.clear();
		format(out.s, "retry needed for total ", total);
	} else {
		out.ok = true;
		out.s.clear();
		format(out.s, "selected total reached ", total);
	}
	out
}
@end
