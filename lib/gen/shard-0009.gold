@entry 69b8ca6a197b06a6
kind: step
verb: sort
noun: prefix
modifier: unique
context: text
phrase: sort unique characters in prefix {k}
phrase: collect sorted distinct prefix characters of length {k}
slot: k int
test: text="cbaacde" k=4
expect: => i=3 r=0.0 ok=true s="abccde" errors=0 n=0 res=[] cache=0 hits=0
test: text="fedcba" k=3
expect: => i=3 r=0.0 ok=true s="defcba" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let p_len = if limit > out.s.len { out.s.len } else if limit < 0 { 0 } else { limit };
	var u_pref byte[..200] = "";
	for i in p_len {
		let c = out.s[i];
		var seen = false;
		for j in u_pref.len {
			if u_pref[j] == c { seen = true; break; }
		}
		if !seen { u_pref.push(c); }
	}
	for i in u_pref.len {
		for j in i + 1..u_pref.len {
			if u_pref[i] > u_pref[j] {
				let tmp = u_pref[i];
				u_pref[i] = u_pref[j];
				u_pref[j] = tmp;
			}
		}
	}
	var res byte[..200] = "";
	for b in u_pref { res.push(b); }
	for i in p_len..out.s.len { res.push(out.s[i]); }
	let un = u_pref.len;
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = un;
	out
}
@end
