fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var ranked = 0;
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		gold_cache_put(g, i, diff);
		if diff > off {
			ranked++;
		}
	}
	g.steps += g.n;
	out.i = ranked;
	out.s.clear();
	format(out.s, "ranked ", ranked, " cache entries");
	out
}
@end
