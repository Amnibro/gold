	while i < out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			counts[(c - 'a') as int]++;
		}
		i++;
	}
	for k in 0..26 {
		if counts[k] > 0 {
			gold_push(g, counts[k]);
		}
	}
	out.i = g.n;
	g.steps += 1;
	out
}
