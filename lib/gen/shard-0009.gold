expect: => i=3 r=0.0 ok=true s="collected 3 words in range" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${mn};
	let max_l = ${mx};
	var words_kept = 0;
	var cur_len = 0;
	for i in out.s.len {
		if out.s[i] == ' ' {
			if cur_len >= min_l && cur_len <= max_l { words_kept++; }
			cur_len = 0;
		} else {
			cur_len++;
		}
	}
	if cur_len >= min_l && cur_len <= max_l { words_kept++; }
	g.steps += out.s.len;
	out.i = words_kept;
	out.s.clear();
	format(out.s, "collected ", words_kept, " words in range");
	out
}
@end
@entry 1c4e78ea29d8fe7f
kind: step
verb: compare
noun: errors
modifier: between
context: sort
phrase: compare error counts between two sort buckets
phrase: evaluate misordered pairs between sort halves
phrase: measure order errors between halves of list
test: list=4,1,2,3
expect: => i=1 r=0.0 ok=true s="error difference 1" errors=0 n=4 res=[4,1,2,3] cache=0 hits=0
test: list=1,4,3,2
expect: => i=1 r=0.0 ok=true s="error difference 1" errors=0 n=4 res=[1,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mid = g.n / 2;
	var left_err = 0;
	for i in 0..mid {
		for j in (i + 1)..mid {
			if g.res[i] > g.res[j] { left_err++; }
		}
	}
	var right_err = 0;
	for i in mid..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] { right_err++; }
		}
	}
	let diff = if left_err > right_err { left_err - right_err } else { right_err - left_err };
	g.steps += g.n * g.n;
	out.i = diff;
	out.s.clear();
	format(out.s, "error difference ", diff);
	out
}
@end
