expect: => i=0 r=0.0 ok=true s="pairwise rotate thresh: 0" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var rotated = 0;
	if g.n > 1 {
		let diff = g.res[1] - g.res[0];
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= limit {
			let lead = g.res[0];
			for idx in (g.n - 1) {
				g.res[idx] = g.res[idx + 1];
			}
			g.res[g.n - 1] = lead;
			rotated = 1;
		}
	}
	g.steps += g.n + rotated;
	out.i = rotated;
	out.s.clear();
	format(out.s, "pairwise rotate thresh: ", rotated);
	out
}
@end
