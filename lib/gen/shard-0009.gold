test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for run caching");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var i = 0;
	var run_count = 0;
	while i < g.n {
		var len = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			len++;
			i++;
		}
		gold_cache_put(g, run_count, len);
		run_count++;
		i++;
	}
	g.steps += g.n;
	out.i = run_count;
	out.s.clear();
	format(out.s, "cached ", run_count, " runs");
	out
}
@end
