fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 100, 120);
	let limit, found = gold_cache_get(g, 100);
	let max_code = if found { limit } else { 122 };
	var valid = true;
	for i in out.s.len {
		if out.s[i] > max_code { valid = false; }
	}
	g.steps += out.s.len;
	out.ok = valid;
	out.s.clear();
	format(out.s, "letters valid ", valid);
	out
}
@end
@entry 99bae066bb209305
kind: step
verb: rotate
noun: evens
modifier: at_least
context: compare
phrase: rotate elements if having at least two evens
phrase: cycle array when even numbers meet threshold
phrase: shift values if evens count satisfies minimum
test: list=10,20,30,5
expect: => i=3 r=0.0 ok=true s="evens rotated 3" errors=0 n=4 res=[5,10,20,30] cache=0 hits=0
test: list=3,5,7,8
expect: => i=1 r=0.0 ok=true s="evens rotated 1" errors=0 n=4 res=[3,5,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 { evens++; }
	}
	if evens >= 2 && g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = evens;
	out.s.clear();
	format(out.s, "evens rotated ", evens);
	out
}
@end
