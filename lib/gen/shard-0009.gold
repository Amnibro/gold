fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${limit};
	var runs = 0;
	if g.n > 0 {
		runs = 1;
		for i in 1..g.n {
			if g.res[i] != g.res[i - 1] {
				runs++;
			}
		}
	}
	let tracked = if runs > cap { cap } else { runs };
	g.steps += g.n;
	out.i = tracked;
	out.s.clear();
	format(out.s, "traced error runs ", tracked);
	out
}
@end
