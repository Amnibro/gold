code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_pal = true;
	var left = 0;
	var right = out.s.len - 1;
	while left < right {
		if out.s[left] != out.s[right] {
			is_pal = false;
			gold_fail(g, "text not palindrome");
			break;
		}
		left++;
		right--;
	}
	g.steps += out.s.len;
	out.ok = is_pal;
	out.i = if is_pal { 1 } else { 0 };
	out.s.clear();
	format(out.s, if is_pal { "text palindrome in reverse" } else { "text unsymmetric in reverse" });
	out
}
@end
