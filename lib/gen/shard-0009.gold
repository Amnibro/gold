	if g.n < 2 { return out; }
	var max_gap = -1;
	var max_idx = 0;
	for i in (g.n - 1) {
		let diff = if g.res[i + 1] > g.res[i] { g.res[i + 1] - g.res[i] } else { g.res[i] - g.res[i + 1] };
		if diff > max_gap { max_gap = diff; max_idx = i; }
	}
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "max gap first ", max_gap);
	out
}
