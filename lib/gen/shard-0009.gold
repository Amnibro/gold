code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var space_sum = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff <= lim {
				space_sum += diff;
			}
		}
	}
	g.steps += g.n;
	out.i = space_sum;
	out.s.clear();
	format(out.s, "folded space sum is ", space_sum);
	out
}
@end
