@entry 07bab9671b847e2a
kind: step
verb: repeat
noun: vowels
modifier: none
context: error
phrase: repeat vowels none for error text
phrase: strip repeated vowels from error message
test: text="faailuurre"
expect: => i=8 r=0.0 ok=true s="failurre" errors=0 n=0 res=[] cache=0 hits=0
test: text="cooordinaate"
expect: => i=9 r=0.0 ok=true s="cordinate" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clean byte[..200] = [];
	for i in out.s.len {
		let b = out.s[i];
		let is_vowel = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u');
		if is_vowel && clean.len > 0 && clean[clean.len - 1] == b {
			g.steps++;
		} else {
			clean.push(b);
		}
	}
	out.s.clear();
	for b in clean {
		out.s.push(b);
	}
	out.i = out.s.len;
	out
}
@end
@entry 7b436c8c97d09aba
kind: step
verb: return
noun: gaps
modifier: recursively
context: error
phrase: return error gaps recursively from trace
phrase: calculate gaps recursively between error events
test: list=10,25,30,50
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[15,5,20] cache=0 hits=0
test: list=5,9,20,40
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[4,11,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var gaps int[512] = [0; 512];
		let num = g.n - 1;
		for i in num {
			gaps[i] = g.res[i + 1] - g.res[i];
		}
		for i in num {
			g.res[i] = gaps[i];
		}
		g.n = num;
		out.i = num;
	} else {
		g.n = 0;
		out.i = 0;
	}
	g.steps += g.n;
	out
}
@end
