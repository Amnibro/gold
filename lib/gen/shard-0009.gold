@entry 7568beaea4f35c5b
kind: step
verb: map
noun: average
modifier: at_least
context: stats
phrase: map deviations from average exceeding at least {min_diff}
phrase: filter sample offsets from mean of at least {min_diff}
slot: min_diff int
test: list=10,20,30,40,50 min_diff=15
expect: => i=2 r=0.0 ok=true s="kept 2 deviations at least 15" errors=0 n=2 res=[10,50] cache=0 hits=0
test: list=2,4,6,8 min_diff=3
expect: => i=2 r=0.0 ok=true s="kept 2 deviations at least 3" errors=0 n=2 res=[2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${min_diff};
	if g.n == 0 {
		out.s.clear();
		out.s.append("empty observations");
		return out;
	}
	var sum = 0;
	for k in g.n { sum += g.res[k]; }
	let mean = sum / g.n;
	var kept int[512] = [0; 512];
	var kp = 0;
	for k in g.n {
		let diff = g.res[k] - mean;
		let abs_diff = if diff < 0 { -diff } else { diff };
		if abs_diff >= md {
			kept[kp] = g.res[k];
			kp++;
		}
	}
	gold_clear(g);
	for i in kp { gold_push(g, kept[i]); }
	g.steps += g.n * 2;
	out.i = kp;
	out.s.clear();
	format(out.s, "kept ", kp, " deviations at least ", md);
	out
}
@end
