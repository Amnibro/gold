verb: dedupe
noun: cache
modifier: first
context: cache
phrase: deduplicate cache preserving first occurrence
phrase: remove duplicate cache values keeping first
phrase: dedupe cache entries keeping first match
test: list=10,20,10,30,20
expect: => i=3 r=0.0 ok=true s="deduped cache first unique size 3" errors=0 n=5 res=[10,20,10,30,20] cache=3 hits=0
test: list=5,5,15,5
expect: => i=2 r=0.0 ok=true s="deduped cache first unique size 2" errors=0 n=4 res=[5,5,15,5] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var uniq int[256] = [0; 256];
	var un = 0;
	for k in g.cn {
		let v_item = g.cv[k];
		var seen = false;
		for j in un {
			if uniq[j] == v_item { seen = true; break; }
		}
		if !seen {
			uniq[un] = v_item;
			un++;
		}
	}
	g.cn = un;
	for k in un {
		g.cv[k] = uniq[k];
		g.ck[k] = k;
	}
	g.steps += g.cn;
	out.i = un;
	out.s.clear();
	format(out.s, "deduped cache first unique size ", un);
	out
}
@end
