@entry 5eb343cd77f4e35f
kind: step
verb: check
noun: window
modifier: any
context: stats
phrase: check if any sliding window {win_size} exceeds average {target}
phrase: verify whether any window {win_size} surpasses target {target}
slot: win_size int
slot: target int
test: list=10,20,30,40 win_size=2 target=25
expect: => i=1 r=0.0 ok=true s="window exceeds target" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,5,10,15 win_size=3 target=20
expect: => i=0 r=0.0 ok=false s="no window exceeds target" errors=0 n=4 res=[5,5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	let tgt = ${target};
	if g.n < w || w <= 0 {
		out.ok = false;
		out.s.clear();
		out.s.append("window too large");
		return out;
	}
	var found = false;
	let num_win = g.n - w + 1;
	for i in num_win {
		var sum = 0;
		for j in 0..w { sum += g.res[i + j]; }
		let avg = sum / w;
		if avg > tgt {
			found = true;
			break;
		}
	}
	g.steps += num_win * w;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	if found {
		out.s.append("window exceeds target");
	} else {
		out.s.append("no window exceeds target");
	}
	out
}
@end
