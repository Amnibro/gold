code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = if g.n < 4 { g.n } else { 4 };
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += limit * limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted up to limit ", limit);
	out
}
@end
