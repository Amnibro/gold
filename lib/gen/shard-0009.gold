fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${bound};
	var diff = 0;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		diff = last_val - lim;
		out.ok = last_val >= lim;
	} else {
		gold_push(g, lim);
		out.ok = true;
	}
	out.i = diff;
	g.steps += 1;
	out.s.clear();
	format(out.s, "compared last item limit diff ", diff);
	out
}
@end
