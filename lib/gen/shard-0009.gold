fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty list");
		return out;
	}
	var u int[512] = [0; 512];
	var up = 0;
	var sum = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for j in up {
			if u[j] == x { seen = true; break; }
		}
		if !seen {
			u[up] = x;
			up++;
			sum += x;
		}
	}
	let avg = sum / up;
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "average of unique is ", avg);
	out
}
