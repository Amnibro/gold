code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var clamped = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && x > 17 { g.res[i] = 17; clamped++; }
		}
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "primes clamped ", clamped);
	out
}
@end
