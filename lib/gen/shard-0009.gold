fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if count <= 0 || g.n < count {
		gold_fail(g, "count exceeds list elements");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: count too large");
		return out;
	}
	let start = (g.n - count) / 2;
	for i in count {
		g.res[i] = g.res[start + i];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "collected ", count, " middle elements");
	out
}
@end
