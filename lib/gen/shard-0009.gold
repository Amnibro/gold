code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${floor};
	var found = false;
	var min_val = 999999;
	for k in g.n {
		if g.res[k] >= f {
			if !found || g.res[k] < min_val {
				min_val = g.res[k];
				found = true;
			}
		}
	}
	if found {
		out.i = min_val;
	} else {
		gold_fail(g, "no match above floor");
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
