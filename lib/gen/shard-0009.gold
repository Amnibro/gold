@entry 8287d896c6a79a30
kind: step
verb: map
noun: digits
modifier: any
context: format
phrase: format map digits any hyphenated view
phrase: render separated digits formatted representation
test: input=482
expect: => i=3 r=0.0 ok=true s="digits: 4-8-2" errors=0 n=0 res=[] cache=0 hits=0
test: input=7
expect: => i=1 r=0.0 ok=true s="digits: 7" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var x = if out.i < 0 { -out.i } else { out.i };
	out.s.clear();
	out.s.append("digits: ");
	var d = [0; 16];
	var len = 0;
	while x > 0 && len < 16 {
		d[len] = x % 10;
		len++;
		x /= 10;
	}
	if len == 0 {
		out.s.append("0");
		out.i = 1;
	} else {
		var j = len - 1;
		while j >= 0 {
			if j < len - 1 { out.s.append("-"); }
			format(out.s, d[j]);
			j--;
		}
		out.i = len;
	}
	g.steps += out.i;
	out
}
@end
