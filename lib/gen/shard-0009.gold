fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var word_count = 0;
	var in_w = false;
	for i in out.s.len {
		if out.s[i] == ' ' {
			in_w = false;
		} else if !in_w {
			word_count++;
			in_w = true;
		}
	}
	let total = word_count * f;
	g.steps += out.s.len;
	out.i = total;
	out.s.clear();
	format(out.s, "folded words times factor gives ", total);
	out
}
@end
