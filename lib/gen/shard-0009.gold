fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${count};
	var total_runs = 0;
	if g.n > 0 {
		var cur = g.res[g.n - 1];
		total_runs = 1;
		var idx = g.n - 2;
		while idx >= 0 {
			if g.res[idx] != cur {
				total_runs++;
				cur = g.res[idx];
			}
			idx--;
		}
	}
	let result = total_runs * mult;
	out.i = result;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "reverse runs repeated total ", result);
	out
}
