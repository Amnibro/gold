fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let mid = (min_val + max_val) / 2;
	if g.n < 64 { gold_push(g, mid); }
	g.steps += g.n;
	out.i = mid;
	out.s.clear();
	format(out.s, "joined between value ", mid);
	out
}
@end
