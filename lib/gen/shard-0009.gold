	var out = v;
	let max_sum = ${cap};
	var total = 0;
	for i in g.n {
		if total + g.res[i] <= max_sum {
			total += g.res[i];
		} else {
			break;
		}
	}
	out.i = total;
	g.steps += g.n + 1;
	out.s.clear();
	format(out.s, "checkpoint sum at most ", total);
	out
}
@end
