noun: duplicates
modifier: until
context: format
phrase: format select duplicates until limit {cap}
phrase: render duplicate elements until maximum {cap}
slot: cap int
test: list=1,2,2,3,3,3 cap=5
expect: => i=3 r=0.0 ok=true s="duplicates: 3" errors=0 n=6 res=[1,2,2,3,3,3] cache=0 hits=0
