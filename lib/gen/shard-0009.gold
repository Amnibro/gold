code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var dupes = 0;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] {
				dupes++;
				break;
			}
		}
		if dupes >= limit { break; }
	}
	out.s.clear();
	format(out.s, "duplicates: ", dupes);
	out.i = dupes;
	g.steps += g.n;
	out
}
@end
