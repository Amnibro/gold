@entry 5e609cfd677479e0
kind: step
verb: return
noun: vowels
modifier: with_retry
context: math
phrase: return vowels with_retry attempts {attempts}
phrase: extract vowels with_retry budget {attempts}
slot: attempts int
test: text="mathematics" attempts=3
expect: => i=4 r=0.0 ok=true s="aeai" errors=0 n=0 res=[] cache=0 hits=0
test: text="xyz" attempts=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let att = ${attempts};
	var buf byte[>..] = [];
	for i in v.s.len {
		let b = v.s[i];
		if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
			buf.push(b);
		}
	}
	out.s.clear();
	out.s.append(buf);
	out.i = out.s.len;
	g.steps += att;
	if out.s.len == 0 {
		gold_fail(g, "no vowels found in text");
		out.ok = false;
	}
	out
}
@end
