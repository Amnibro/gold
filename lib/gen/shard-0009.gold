test: list=10,50,30,20
expect: => i=50 r=0.0 ok=true s="reverse max value 50" errors=0 n=4 res=[10,50,30,20] cache=0 hits=0
test: list=15,25,45,35
expect: => i=45 r=0.0 ok=true s="reverse max value 45" errors=0 n=4 res=[15,25,45,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mx = g.res[g.n - 1];
	var pos = g.n - 1;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] > mx {
			mx = g.res[i];
			pos = i;
		}
		g.steps++;
		i--;
	}
	out.i = mx;
	out.s.clear();
	format(out.s, "reverse max value ", mx);
	out
}
@end
