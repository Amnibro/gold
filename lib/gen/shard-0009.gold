				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted up to ", limit);
	out
}
