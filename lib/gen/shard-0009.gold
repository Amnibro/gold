@entry 56768408f6df162c
kind: step
verb: sort
noun: series
modifier: unique
context: compare
phrase: sort unique elements across compared series
phrase: order unique items from result series
phrase: extract unique series elements sorted
test: list=5,2,8,2,5,9
expect: => i=4 r=0.0 ok=true s="sorted unique series 4" errors=0 n=4 res=[2,5,8,9] cache=0 hits=0
test: list=10,4,10,4,1
expect: => i=3 r=0.0 ok=true s="sorted unique series 3" errors=0 n=3 res=[1,4,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique int[64];
	var u = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u {
			if unique[j] == x { seen = true; break; }
		}
		if !seen && u < 64 { unique[u] = x; u++; }
	}
	var i = 0;
	while i < u {
		var j = i + 1;
		while j < u {
			if unique[j] < unique[i] {
				let t = unique[i]; unique[i] = unique[j]; unique[j] = t;
			}
			j++;
		}
		i++;
	}
	gold_clear(g);
	for k in u { gold_push(g, unique[k]); }
	g.steps += u;
	out.i = u;
	out.s.clear();
	format(out.s, "sorted unique series ", u);
	out
}
@end
