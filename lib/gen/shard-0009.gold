modifier: last
context: filter
phrase: scan step values keeping last {count} items
phrase: filter trailing sequence retaining last {count} elements
slot: count int
test: list=1,2,3,4,5,6 count=3
expect: => i=3 r=0.0 ok=true s="scanned last 3 elements" errors=0 n=3 res=[4,5,6] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="scanned last 2 elements" errors=0 n=2 res=[20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if g.n > k { g.n - k } else { 0 };
	var kept = 0;
	for i in (g.n - start) {
		g.res[i] = g.res[start + i];
		kept++;
	}
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "scanned last ", kept, " elements");
	out
}
@end
@entry 02f514e3769585b0
kind: step
verb: sum
noun: errors
modifier: none
context: filter
phrase: filter sequence ensuring sum has no errors
phrase: keep positive items leaving no error values
test: list=10,-5,20,-3,30
expect: => i=60 r=0.0 ok=true s="sum of 3 non error items is 60" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=-1,-2,5,15
expect: => i=20 r=0.0 ok=true s="sum of 2 non error items is 20" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var sum = 0;
	for i in g.n {
		if g.res[i] >= 0 {
			g.res[kept] = g.res[i];
			sum += g.res[i];
			kept++;
		}
	}
	g.n = kept;
	g.steps += kept;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of ", kept, " non error items is ", sum);
	out
}
@end
