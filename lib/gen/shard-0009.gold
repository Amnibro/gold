code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d_target = ${delta};
	var found_idx = -1;
	if g.n >= 2 {
		for k in 1..g.n {
			let diff = g.res[k] - g.res[k - 1];
			let abs_d = if diff < 0 { -diff } else { diff };
			if abs_d >= d_target {
				found_idx = k;
				break;
			}
		}
	}
	g.steps += g.n;
	out.i = found_idx;
	out.s.clear();
	if found_idx >= 0 {
		format(out.s, "first step at ", found_idx);
	} else {
		out.s.append("no step found");
	}
	out
}
@end
