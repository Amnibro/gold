test: text="err404code5"
expect: => i=4 r=0.0 ok=true s="5404" errors=0 n=0 res=[] cache=0 hits=0
test: text="warn12code8"
expect: => i=3 r=0.0 ok=true s="821" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits byte[..200] = [];
	for i in out.s.len {
		let b = out.s[i];
		if b >= '0' && b <= '9' {
			digits.push(b);
		}
	}
	out.s.clear();
	var idx = digits.len - 1;
	while idx >= 0 {
		out.s.push(digits[idx]);
		idx--;
	}
	g.steps += digits.len;
	out.i = digits.len;
	out
}
@end
