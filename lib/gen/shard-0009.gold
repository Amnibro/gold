test: list=30,40,10,20
expect: => i=2 r=0.0 ok=true s="rotated to min step index 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=15,25,5,10
expect: => i=2 r=0.0 ok=true s="rotated to min step index 2" errors=0 n=4 res=[5,10,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var min_idx = 0;
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	if min_idx > 0 {
		var tmp int[512] = [0; 512];
		for k in g.n { tmp[k] = g.res[(k + min_idx) % g.n]; }
		for k in g.n { g.res[k] = tmp[k]; }
	}
	g.steps += g.n;
	out.i = min_idx;
	out.s.clear();
	format(out.s, "rotated to min step index ", min_idx);
	out
}
@end
