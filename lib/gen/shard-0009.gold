	for i in g.n {
		if sum_val < 80 {
			if g.res[i] > 25 { g.res[i] = 25; clamped++; }
		}
		sum_val += g.res[i];
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "threshold clamped ", clamped);
	out
}
@end
