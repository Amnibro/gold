test: list=5,4,3,2,1 window=1
expect: => i=1 r=0.0 ok=true s="sorted tail elements count 1" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 {
		gold_fail(g, "invalid window");
		out.ok = false;
		return out;
	}
	var start = g.n - w;
	if start < 0 { start = 0; }
	for i in start..g.n {
		for j in (i + 1)..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "sorted tail elements count ", g.n - start);
	out
}
@end
