fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var write = 0;
	for k in g.n {
		if g.res[k] >= lo && g.res[k] <= hi {
			g.res[write] = g.res[k];
			write++;
		}
	}
	g.n = write;
	g.steps += g.n;
	out.i = write;
	out.s.clear();
	format(out.s, "filtered search steps in range ", write);
	out
}
@end
