code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digit_idx = 0;
	var changed = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= '0' && c <= '9' {
			if digit_idx % 2 == 0 {
				if c == '9' {
					out.s[i] = '0';
				} else {
					out.s[i] = (c + 1) as byte;
				}
				changed++;
			}
			digit_idx++;
		}
	}
	g.steps += out.s.len;
	out.i = changed;
	out
}
@end
