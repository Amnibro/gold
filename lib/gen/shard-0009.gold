@entry 1d184763ae53c3b9
kind: step
verb: rank
noun: primes
modifier: in_reverse
context: transform
phrase: rank prime elements sorting them in reverse order
phrase: sort prime numbers backward from largest to smallest
phrase: order primes in reverse within results
test: list=2,4,7,9,5
expect: => i=3 r=0.0 ok=true s="primes reversed count 3" errors=0 n=5 res=[7,4,5,9,2] cache=0 hits=0
test: list=3,8,11,12
expect: => i=2 r=0.0 ok=true s="primes reversed count 2" errors=0 n=4 res=[11,8,3,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[64];
	var indices int[64];
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p && p < 64 {
				primes[p] = x;
				indices[p] = i;
				p++;
			}
		}
	}
	var a = 0;
	while a < p {
		var b = a + 1;
		while b < p {
			if primes[b] > primes[a] {
				let t = primes[a]; primes[a] = primes[b]; primes[b] = t;
			}
			b++;
		}
		a++;
	}
	for k in p { g.res[indices[k]] = primes[k]; }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "primes reversed count ", p);
	out
}
@end
