code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 10, 1);
	gold_cache_put(g, 30, 1);
	var kept int[64];
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		var attempt = 0;
		while attempt < 2 {
			let v_chk, ok = gold_cache_get(g, x);
			if ok { found = true; break; }
			attempt++;
		}
		if found && p < 64 { kept[p] = x; p++; }
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "memo filtered with retry ", p);
	out
}
@end
