test: list=15,8,22,60,5,1
expect: => i=3 r=0.0 ok=true s="sorted until 3" errors=0 n=6 res=[8,15,22,60,5,1] cache=0 hits=0
test: list=12,4,30,10
expect: => i=4 r=0.0 ok=true s="sorted until 4" errors=0 n=4 res=[4,10,12,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cutoff = g.n;
	for i in g.n {
		if g.res[i] > 50 { cutoff = i; break; }
	}
	var i = 0;
	while i < cutoff {
		var j = i + 1;
		while j < cutoff {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += cutoff;
	out.i = cutoff;
	out.s.clear();
	format(out.s, "sorted until ", cutoff);
	out
}
@end
