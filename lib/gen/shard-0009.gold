code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var qualified = 0;
	var i = 0;
	while i < g.n {
		var freq = 1;
		while i + 1 < g.n && g.res[i + 1] == g.res[i] {
			freq++;
			i++;
		}
		if freq >= th {
			qualified++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = qualified;
	out.s.clear();
	format(out.s, "measured ", qualified, " buckets meeting threshold");
	out
}
@end
