code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var count = 0;
	var k = 0;
	while k + 1 < g.n {
		let s = g.res[k] + g.res[k + 1];
		if s > b {
			g.res[k + 1] = b - g.res[k];
			count++;
		}
		k += 2;
	}
	out.i = count;
	g.steps += g.n;
	out
}
@end
