fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var matched = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			found = true;
			matched = g.res[i];
			break;
		}
	}
	if !found {
		gold_fail(g, "predicate never satisfied");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no match");
		return out;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "found matching item ", matched);
	out
}
