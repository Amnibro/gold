code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var tot = 0;
	for i in g.n {
		tot += g.res[i];
	}
	if tot > b {
		gold_fail(g, "total exceeds budget");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: budget exceeded");
		return out;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "total ", tot, " within budget ", b);
	out
}
@end
