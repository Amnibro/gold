@entry 2b33efc1bb227c19
kind: step
verb: return
noun: histogram
modifier: sorted
context: error
phrase: return sorted error histogram counts
phrase: order error frequency histogram ascending
test: list=1,1,2,2,2,3
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=4,4,4,4,5,5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var counts int[512] = [0; 512];
	var cn = 0;
	var vals int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var idx = -1;
		for j in cn {
			if vals[j] == x {
				idx = j;
			}
		}
		if idx >= 0 {
			counts[idx]++;
		} else {
			vals[cn] = x;
			counts[cn] = 1;
			cn++;
		}
	}
	if cn > 1 {
		for i in cn {
			for j in (i + 1)..cn {
				if counts[i] > counts[j] {
					let tc = counts[i];
					counts[i] = counts[j];
					counts[j] = tc;
				}
			}
		}
	}
	for i in cn {
		g.res[i] = counts[i];
	}
	g.n = cn;
	g.steps += g.n;
	out.i = cn;
	out
}
@end
