	let min_span = ${min_gap};
	if g.n < 2 { out.ok = false; return out; }
	var large_gaps = 0;
	for idx in (g.n - 1) {
		let diff = g.res[idx + 1] - g.res[idx];
		if diff >= min_span { large_gaps++; }
	}
	g.steps += g.n + 1;
	out.i = large_gaps;
	out.s.clear();
	format(out.s, "gaps at least count: ", large_gaps);
	out
}
