slot: retries int
test: list=2,5,8,11 retries=2
expect: => i=2 r=0.0 ok=true s="paired prefix with retry count 2" errors=0 n=2 res=[11,19] cache=0 hits=0
test: list=1,4,7,10 retries=1
expect: => i=2 r=0.0 ok=true s="paired prefix with retry count 2" errors=0 n=2 res=[7,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_max = ${retries};
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let p = (g.n / 2) * 2;
	var pairs = 0;
	var i = 0;
	while i < p {
		var s = g.res[i] + g.res[i + 1];
		var r = 0;
		while s < 10 && r < r_max {
			s += 2;
			r++;
		}
		g.res[pairs] = s;
		pairs++;
		i += 2;
	}
	g.n = pairs;
	g.steps += p;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired prefix with retry count ", pairs);
	out
}
@end
