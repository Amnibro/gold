fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 || g.n == 0 { return out; }
	var avgs = [0; 512];
	var a_count = 0;
	var cur_sum = 0;
	var in_chunk = 0;
	for k in g.n {
		cur_sum += g.res[k];
		in_chunk++;
		if in_chunk == cap {
			avgs[a_count] = cur_sum / cap;
			a_count++;
			cur_sum = 0;
			in_chunk = 0;
		}
		g.steps++;
	}
	if in_chunk > 0 {
		avgs[a_count] = cur_sum / in_chunk;
		a_count++;
	}
	gold_clear(g);
	for k in a_count { gold_push(g, avgs[k]); }
	out.i = a_count;
	out.s.clear();
	format(out.s, "grouped into ", a_count, " chunk averages");
	out
}
@end
@entry 4c6428acffce8d1e
kind: step
verb: fill
noun: runs
modifier: up_to
context: aggregate
phrase: fill run counts up to limit {lim}
phrase: record streak lengths up to {lim}
phrase: populate consecutive runs up to {lim}
slot: lim int
test: list=2,2,2,3,3,4,4,4,4 lim=3
expect: => i=3 r=0.0 ok=true s="filled 3 capped runs" errors=0 n=3 res=[3,2,3] cache=0 hits=0
test: list=7,7,8,8,8,8,9 lim=2
expect: => i=3 r=0.0 ok=true s="filled 3 capped runs" errors=0 n=3 res=[2,2,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if g.n == 0 || lim <= 0 { return out; }
	var runs = [0; 512];
	var r_count = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] == g.res[k - 1] {
			cur_len++;
		} else {
			let capped = if cur_len > lim { lim } else { cur_len };
			runs[r_count] = capped;
			r_count++;
			cur_len = 1;
		}
		g.steps++;
	}
	let final_capped = if cur_len > lim { lim } else { cur_len };
	runs[r_count] = final_capped;
	r_count++;
	gold_clear(g);
	for k in r_count { gold_push(g, runs[k]); }
	out.i = r_count;
	out.s.clear();
	format(out.s, "filled ", r_count, " capped runs");
	out
}
@end
