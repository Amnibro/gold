@entry 616c79834a872785
kind: step
verb: filter
noun: gaps
modifier: each
context: cache
phrase: filter cache keys removing gaps larger than {max_g}
phrase: restrict spacing gaps between each cache key to {max_g}
phrase: clamp adjacent cache key gaps to {max_g}
slot: max_g int
test: list=10,25,30 max_g=12
expect: => i=1 r=0.0 ok=true s="adjusted cache key gaps 1" errors=0 n=3 res=[10,25,30] cache=3 hits=0
test: list=5,20,25 max_g=10
expect: => i=1 r=0.0 ok=true s="adjusted cache key gaps 1" errors=0 n=3 res=[5,20,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	let limit = ${max_g};
	var adjusted = 0;
	if g.cn > 1 {
		for k in 1..g.cn {
			let diff = g.ck[k] - g.ck[k - 1];
			if diff > limit {
				g.ck[k] = g.ck[k - 1] + limit;
				adjusted++;
			}
		}
	}
	g.steps += g.cn;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted cache key gaps ", adjusted);
	out
}
@end
