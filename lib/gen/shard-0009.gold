phrase: shift search items until target {target} at front
slot: target int
test: list=10,20,30,40 target=30
expect: => i=2 r=0.0 ok=true s="rotated target search item from 2" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
test: list=5,15,25,35 target=25
expect: => i=2 r=0.0 ok=true s="rotated target search item from 2" errors=0 n=4 res=[25,35,5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	for k in g.n {
		if g.res[k] == tgt {
			idx = k;
			break;
		}
	}
	if idx > 0 {
		var tmp int[512] = [0; 512];
		for k in g.n { tmp[k] = g.res[(k + idx) % g.n]; }
		for k in g.n { g.res[k] = tmp[k]; }
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "rotated target search item from ", idx);
	out
}
@end
