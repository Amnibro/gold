@entry 90de6632944805fb
kind: step
verb: pair
noun: middle
modifier: until
context: list
phrase: pair middle elements until condition {p}
phrase: combine middle pairs until {p} holds
slot: p pred
test: list=1,2,3,4,5 p=is_even
expect: => i=1 r=0.0 ok=true s="" errors=0 n=4 res=[1,5,4,5] cache=0 hits=0
test: list=10,20,30,40 p=over_100
expect: => i=3 r=0.0 ok=true s="" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ops = 0;
	while g.n >= 2 {
		let mid = g.n / 2;
		if ${p}(g.res[mid]) { break; }
		g.res[mid - 1] = g.res[mid - 1] + g.res[mid];
		for k in (mid + 1)..g.n {
			g.res[k - 1] = g.res[k];
		}
		g.n--;
		ops++;
	}
	out.i = ops;
	g.steps += ops;
	out
}
@end
