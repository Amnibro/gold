@entry 6e42da8aaef89839
kind: step
verb: reverse
noun: squares
modifier: with_cache
context: sort
phrase: reverse squares with cache acceleration
phrase: invert order of cached squared elements
test: list=2,3,4
expect: => i=3 r=0.0 ok=true s="reversed 3 squared elements" errors=0 n=3 res=[16,9,4] cache=3 hits=0
test: list=5,1
expect: => i=2 r=0.0 ok=true s="reversed 2 squared elements" errors=0 n=2 res=[1,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let sq_cached, found = gold_cache_get(g, x);
		let sq = if found { sq_cached } else {
			let val = x * x;
			gold_cache_put(g, x, val);
			val
		};
		g.res[i] = sq;
	}
	for i in g.n / 2 {
		let j = g.n - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed ", g.n, " squared elements");
	out
}
@end
