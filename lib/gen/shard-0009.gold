@entry d56009eab13cec29
kind: step
verb: find
noun: gaps
modifier: between
context: loop
phrase: find maximum step gap between consecutive loop values
phrase: calculate peak interval gap between loop elements
test: list=10,15,35,40
expect: => i=20 r=0.0 ok=true s="maximum gap between elements: 20" errors=0 n=4 res=[10,15,35,40] cache=0 hits=0
test: list=2,4,6
expect: => i=2 r=0.0 ok=true s="maximum gap between elements: 2" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_gap = 0;
	if g.n >= 2 {
		for i in g.n - 1 {
			let diff = g.res[i + 1] - g.res[i];
			let abs_diff = if diff < 0 { -diff } else { diff };
			if abs_diff > max_gap { max_gap = abs_diff; }
		}
	}
	g.steps += g.n;
	out.i = max_gap;
	out.s.clear();
	format(out.s, "maximum gap between elements: ", max_gap);
	out
}
@end
