code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_cache_put(g, 0, 3);
	let win_size, found = gold_cache_get(g, 0);
	let w = if found && win_size <= g.n { win_size } else { g.n };
	var i = 0;
	while i < w {
		var j = i + 1;
		while j < w {
			if g.res[j] < g.res[i] {
				let t = g.res[i]; g.res[i] = g.res[j]; g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += w * w;
	out.i = w;
	out.s.clear();
	format(out.s, "sorted window with cache ", w);
	out
}
@end
