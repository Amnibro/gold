fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		if running + val <= b {
			g.res[kept] = val;
			running += val;
			kept++;
		}
		i += 2;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = running;
	out.s.clear();
	format(out.s, "budget scan spent ", running, " on ", kept, " items");
	out
}
