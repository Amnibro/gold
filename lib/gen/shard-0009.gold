	let r_max = ${retries};
	var adjusted = 0;
	var i = 0;
	while i < g.n {
		var r = 0;
		while g.res[i] < 6 && r < r_max {
			g.res[i] += 2;
			r++;
			adjusted++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "retried every other sequence count ", adjusted);
	out
}
@end
