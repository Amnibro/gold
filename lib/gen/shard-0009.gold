@entry abc6436391d1f813
kind: step
verb: sort
noun: tail
modifier: safely
context: cache
phrase: sort trailing cache values safely from {start}
phrase: order tail cache entries safely after {start}
phrase: safely sort cache tail beyond {start}
slot: start int
test: list=10,50,40,20 start=1
expect: => i=3 r=0.0 ok=true s="sorted cache tail safely 3" errors=0 n=4 res=[10,50,40,20] cache=4 hits=0
test: list=5,35,15,25 start=1
expect: => i=3 r=0.0 ok=true s="sorted cache tail safely 3" errors=0 n=4 res=[5,35,15,25] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let st = ${start};
	let count = g.cn - st;
	if count > 1 {
		for i in count {
			for j in count - 1 {
				let p1 = st + j;
				let p2 = st + j + 1;
				if g.cv[p1] > g.cv[p2] {
					let tmp = g.cv[p1];
					g.cv[p1] = g.cv[p2];
					g.cv[p2] = tmp;
				}
			}
		}
	}
	g.steps += count * count;
	out.ok = true;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted cache tail safely ", count);
	out
}
@end
