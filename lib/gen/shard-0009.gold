test: list=4,8
expect: => i=1 r=0.0 ok=true s="collected gaps count: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	for i in g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		g.res[i] = if diff < 0 { -diff } else { diff };
	}
	g.n = g.n - 1;
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "collected gaps count: ", g.n);
	out
}
@end
