expect: => i=0 r=0.0 ok=false s="indices error" errors=1 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let a = ${idx_a};
	let b = ${idx_b};
	if a < 0 || a >= g.n || b < 0 || b >= g.n {
		gold_fail(g, "swap indices out of bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "indices error");
		return out;
	}
	let tmp = g.res[a];
	g.res[a] = g.res[b];
	g.res[b] = tmp;
	g.steps += 1;
	out.i = g.res[a] - g.res[b];
	out.s.clear();
	format(out.s, "swapped positions comparison diff ", out.i);
	out
}
@end
