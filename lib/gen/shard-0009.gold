@entry 4e46795a51560bfb
kind: step
verb: fill
noun: duplicates
modifier: at_most
context: search
phrase: fill duplicate search entries at most {limit} times with value {filler}
phrase: replace duplicate search candidates at most {limit} occurrences with {filler}
slot: limit int
slot: filler int
test: list=7,7,7,7,8 limit=2 filler=0
expect: => i=2 r=0.0 ok=true s="filled 2 duplicate entries" errors=0 n=5 res=[7,0,0,7,8] cache=0 hits=0
test: list=3,3,5 limit=1 filler=9
expect: => i=1 r=0.0 ok=true s="filled 1 duplicate entries" errors=0 n=3 res=[3,9,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_fill = ${limit};
	let fill_val = ${filler};
	var replaced = 0;
	for i in g.n {
		if replaced >= max_fill { break; }
		var seen_before = false;
		for j in 0..i {
			if g.res[j] == g.res[i] {
				seen_before = true;
				break;
			}
		}
		if seen_before {
			g.res[i] = fill_val;
			replaced++;
		}
	}
	g.steps += g.n;
	out.i = replaced;
	out.s.clear();
	format(out.s, "filled ", replaced, " duplicate entries");
	out
}
@end
@entry 9d9b5b2dc479d57d
kind: step
verb: map
noun: streak
modifier: at_least
context: search
phrase: map streak values having length at least {min_len} by scale {factor}
phrase: transform contiguous search streak of length at least {min_len} by factor {factor}
slot: min_len int
slot: factor int
test: list=4,4,4,1,2 min_len=3 factor=2
expect: => i=3 r=0.0 ok=true s="mapped streak of 3 items" errors=0 n=5 res=[8,8,8,1,2] cache=0 hits=0
test: list=5,5,9 min_len=2 factor=3
expect: => i=2 r=0.0 ok=true s="mapped streak of 2 items" errors=0 n=3 res=[15,15,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let f = ${factor};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len >= ml {
			for k in i..j {
				g.res[k] *= f;
				modified++;
			}
		}
		i = j;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "mapped streak of ", modified, " items");
	out
}
@end
