code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "trivial pairwise check");
		return out;
	}
	for i in out.s.len - 1 {
		if out.s[i + 1] < out.s[i] {
			gold_fail(g, "decreasing adjacent pair");
			out.ok = false;
			out.i = i + 1;
			out.s.clear();
			format(out.s, "pairwise check failed at index ", i + 1);
			return out;
		}
	}
	let pairs = out.s.len - 1;
	g.steps += pairs;
	out.ok = true;
	out.i = pairs;
	out.s.clear();
	format(out.s, "validated ", pairs, " pairwise character transitions");
	out
}
@end
