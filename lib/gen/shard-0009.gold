fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	var count = 0;
	while count < g.n && total + g.res[count] < 100 {
		total += g.res[count];
		count++;
	}
	g.steps += count + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "checkpoint sum while: ", total);
	out
}
@end
