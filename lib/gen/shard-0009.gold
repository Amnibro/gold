fn ${ID}(n int) int {
	let cap = ${max_steps};
	var x = if n < 0 { -n } else { n };
	var mask = 0;
	if x == 0 { mask = 1; }
	while x > 0 {
		mask |= (1 << (x % 10));
		x /= 10;
	}
	var count = 0;
	for i in 10 {
		if (mask & (1 << i)) != 0 { count++; }
	}
	if count > cap { cap } else { count }
}
@end
