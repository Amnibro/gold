test: list=10,12,14
expect: => i=0 r=0.0 ok=true s="unique primes count: 0" errors=0 n=3 res=[10,12,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_cnt = 0;
	for idx in g.n {
		let num = g.res[idx];
		if num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { prime_cnt++; }
		}
	}
	g.steps += g.n + prime_cnt + 1;
	out.i = prime_cnt;
	out.s.clear();
	format(out.s, "unique primes count: ", prime_cnt);
	out
}
@end
