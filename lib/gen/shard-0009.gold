fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	while out.s.len > 0 {
		let c = out.s[out.s.len - 1];
		let is_vowel = (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		                c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U');
		if is_vowel {
			out.s.pop();
		} else {
			break;
		}
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
