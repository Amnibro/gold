noun: gaps
modifier: all
context: core
phrase: reverse gaps all differences in results
phrase: compute reversed adjacent gaps across all items
test: list=10,30,50,90
expect: => i=3 r=0.0 ok=true s="gaps: 3" errors=0 n=3 res=[40,20,20] cache=0 hits=0
test: list=1,5
expect: => i=1 r=0.0 ok=true s="gaps: 1" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var gaps = [0; 64];
		var m = g.n - 1;
		for i in m {
			let diff = g.res[i + 1] - g.res[i];
			gaps[i] = if diff < 0 { -diff } else { diff };
		}
		for i in m {
			g.res[i] = gaps[m - 1 - i];
		}
		g.n = m;
	}
	out.s.clear();
	format(out.s, "gaps: ", g.n);
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
