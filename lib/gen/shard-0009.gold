code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var ok = false;
	for i in g.n {
		if g.res[i] > thresh {
			ok = true;
			break;
		}
	}
	out.ok = ok;
	out.s.clear();
	format(out.s, "exceeds: ", ok);
	out.i = if ok { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
