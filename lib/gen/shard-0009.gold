@entry aed7c55186ec016b
kind: step
verb: fold
noun: tally
modifier: nested
context: sort
phrase: fold nested tallies of duplicate values with weight {weight}
phrase: reduce nested frequency counts using weighting factor {weight}
slot: weight int
test: list=1,1,2,3,3,3 weight=2
expect: => i=12 r=0.0 ok=true s="folded nested tally sum is 12" errors=0 n=6 res=[1,1,2,3,3,3] cache=0 hits=0
test: list=4,4,5,5 weight=3
expect: => i=12 r=0.0 ok=true s="folded nested tally sum is 12" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${weight};
	var weighted_tally = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		weighted_tally += run_len * w;
		i = j;
	}
	g.steps += g.n;
	out.i = weighted_tally;
	out.s.clear();
	format(out.s, "folded nested tally sum is ", weighted_tally);
	out
}
@end
