@entry 597ecab583256b66
kind: step
verb: return
noun: primes
modifier: unique
context: core
phrase: return unique prime elements in sequence
phrase: yield distinct prime numbers found
phrase: extract unique primes list into results
test: list=2,3,4,5,2,3,7
expect: => i=4 r=0.0 ok=true s="unique primes: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,13,11,17
expect: => i=3 r=0.0 ok=true s="unique primes: 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[>..] = [];
	for idx in g.n {
		let num = g.res[idx];
		if num >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				var already = false;
				for p in primes {
					if p == num { already = true; break; }
				}
				if !already { primes.push(num); }
			}
		}
	}
	gold_clear(g);
	for p in primes { gold_push(g, p); }
	g.steps += g.n + primes.len + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "unique primes: ", g.n);
	out
}
@end
