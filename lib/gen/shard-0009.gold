code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var k = g.n - 1;
	while k >= 0 {
		if ${ID}_is_prime(g.res[k]) { sum += g.res[k]; }
		k--;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded reversed search primes ", sum);
	out
}
@end
