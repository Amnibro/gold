expect: => i=2 r=0.0 ok=true s="merged 2 unique items" errors=0 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if g.n < w || w <= 0 {
		out.s.clear();
		out.s.append("invalid window size");
		return out;
	}
	var merged int[512] = [0; 512];
	var mp = 0;
	var k = 0;
	while k < g.n {
		let chunk_end = if k + w < g.n { k + w } else { g.n };
		for i in k..chunk_end {
			let val = g.res[i];
			var exists = false;
			for j in mp {
				if merged[j] == val { exists = true; break; }
			}
			if !exists { merged[mp] = val; mp++; }
		}
		k += w;
	}
	gold_clear(g);
	for i in mp { gold_push(g, merged[i]); }
	g.steps += g.n;
	out.i = mp;
	out.s.clear();
	format(out.s, "merged ", mp, " unique items");
	out
}
@end
