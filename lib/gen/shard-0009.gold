code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_cnt = 0;
	var i = g.n - 1;
	while i >= 0 {
		var has_prior = false;
		for j in 0..i {
			if g.res[j] == g.res[i] { has_prior = true; break; }
		}
		if has_prior { dup_cnt++; }
		g.steps++;
		i--;
	}
	out.i = dup_cnt;
	out.s.clear();
	format(out.s, "found duplicates in reverse ", dup_cnt);
	out
}
@end
