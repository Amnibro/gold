context: search
phrase: retry loop nested search with fallback {fallback}
phrase: nested retry loop returning fallback {fallback} if empty
slot: fallback int
test: fallback=42
expect: => i=42 r=0.0 ok=true s="" errors=0 n=1 res=[42] cache=0 hits=0
test: list=10,20,30 fallback=0
expect: => i=60 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	if g.n == 0 {
		gold_push(g, fb);
		out.i = fb;
	} else {
		var s = 0;
		for k in g.n { s += g.res[k]; }
		out.i = s;
	}
	g.steps += 1;
	out
}
@end
@entry d4d152fcac1a01d9
kind: step
verb: keep
noun: values
modifier: times
context: search
phrase: keep values times occurrences equal to {reps}
phrase: filter entries appearing exactly {reps} times
slot: reps int
test: list=1,2,2,3,3,3 reps=2
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[2] cache=0 hits=0
test: list=4,4,5,6 reps=1
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${reps};
	var kept = 0;
	for i in g.n {
		var count = 0;
		for j in g.n {
			if g.res[j] == g.res[i] { count++; }
		}
		if count == r {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n;
	out
}
@end
@entry 3e98ce92c39dba04
kind: step
verb: pair
noun: cache
modifier: at_least
context: search
phrase: pair cache at least threshold {cutoff}
phrase: cache adjacent pair sums at least {cutoff}
slot: cutoff int
test: list=10,20,5,15 cutoff=25
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,20,5,15] cache=2 hits=0
test: list=1,2,3,4 cutoff=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var stored = 0;
	if g.n >= 2 {
		for k in 0..(g.n - 1) {
			let s = g.res[k] + g.res[k + 1];
			if s >= cut {
				gold_cache_put(g, k, s);
				stored++;
			}
		}
	}
	out.i = stored;
	g.steps += g.n;
	out
}
@end
