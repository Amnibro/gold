@entry 6a50df9b80819d48
kind: step
verb: group
noun: primes
modifier: running
context: transform
phrase: group running prime count into results
phrase: extract running prime numbers into list
phrase: isolate primes into running output group
test: list=2,3,4,5,6,7,8
expect: => i=4 r=0.0 ok=true s="grouped primes count 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,12,13,14,15,16,17
expect: => i=3 r=0.0 ok=true s="grouped primes count 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var pn = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
		}
		if is_p {
			primes[pn] = x;
			pn++;
		}
		g.steps++;
	}
	gold_clear(g);
	for k in pn { gold_push(g, primes[k]); }
	out.i = pn;
	out.s.clear();
	format(out.s, "grouped primes count ", pn);
	out
}
@end
