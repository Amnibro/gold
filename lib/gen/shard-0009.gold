code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if out.s.len > 1 && count > 1 && count <= out.s.len {
		let start = out.s.len - count;
		let first = out.s[start];
		for i in start..(out.s.len - 1) {
			out.s[i] = out.s[i + 1];
		}
		out.s[out.s.len - 1] = first;
	}
	gold_cache_put(g, 0, out.s.len);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
