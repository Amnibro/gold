	for k in ne { g.res[k] = evens[k]; }
	for k in no { g.res[ne + k] = odds[k]; }
	g.steps += g.n;
	out.i = ne;
	out.s.clear();
	format(out.s, "split all into ", ne, " evens and ", no, " odds");
	out
}
@end
