code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var count = 0;
	for k in g.n {
		let x = g.res[k];
		let val, ok = gold_cache_get(g, x);
		if !ok {
			gold_cache_put(g, x, 1);
			count++;
		}
		g.steps++;
	}
	out.s.clear();
	format(out.s, "stored ", count, " unique tail items");
	out.i = count;
	out
}
@end
