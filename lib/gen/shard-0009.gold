@entry 58a8a0b1eb5c62a0
kind: step
verb: compare
noun: words
modifier: sorted
context: aggregate
phrase: compare words checking sorted order
phrase: verify words are sorted lexicographically
phrase: check word sequence sorted order
test: text="alpha beta gamma zeta"
expect: => i=4 r=0.0 ok=true s="words sorted order is true" errors=0 n=0 res=[] cache=0 hits=0
test: text="delta gamma beta alpha"
expect: => i=4 r=0.0 ok=false s="words sorted order is false" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_chars = [0; 64];
	var w_count = 0;
	var in_word = false;
	for k in out.s.len {
		let c = out.s[k];
		if c != ' ' && c != '\t' {
			if !in_word {
				in_word = true;
				if w_count < 64 {
					first_chars[w_count] = c as int;
					w_count++;
				}
			}
		} else {
			in_word = false;
		}
		g.steps++;
	}
	var is_sorted = true;
	for k in 0..(w_count - 1) {
		if first_chars[k] > first_chars[k + 1] {
			is_sorted = false;
			break;
		}
	}
	out.ok = is_sorted;
	out.i = w_count;
	out.s.clear();
	format(out.s, "words sorted order is ", is_sorted);
	out
}
@end
