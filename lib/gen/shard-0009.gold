fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pairs = g.n / 2;
	for i in pairs {
		let idx1 = g.n - 1 - i * 2;
		let idx2 = idx1 - 1;
		g.res[i] = g.res[idx1] + g.res[idx2];
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired in reverse count ", pairs);
	out
}
@end
