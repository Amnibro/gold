fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	out.s.clear();
	out.s.append("primes:");
	var p_count = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lim && x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				format(out.s, " ", x);
				p_count++;
			}
		}
		g.steps++;
	}
	out.i = p_count;
	out
}
@end
