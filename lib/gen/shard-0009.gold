fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var unique_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		let val, hit = gold_cache_get(g, x);
		if !hit {
			gold_cache_put(g, x, 1);
			unique_cnt++;
		}
	}
	out.s.clear();
	format(out.s, "unique memo: ", unique_cnt);
	out.i = unique_cnt;
	g.steps += g.n;
	out
}
