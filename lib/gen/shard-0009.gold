fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var lim = k;
	if lim > out.s.len { lim = out.s.len; }
	for i in (lim / 2) {
		let j = lim - 1 - i;
		let tmp = out.s[i];
		out.s[i] = out.s[j];
		out.s[j] = tmp;
	}
	g.steps += lim;
	out.i = lim;
	out
}
