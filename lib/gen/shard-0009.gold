@entry 4c46a9def737e23a
kind: step
verb: apply
noun: histogram
modifier: running
context: sort
phrase: apply running histogram bin counts scaled by factor {factor}
phrase: calculate running frequency distribution with scaling factor {factor}
slot: factor int
test: list=1,1,2,3,3,3 factor=2
expect: => i=6 r=0.0 ok=true s="running histogram scaled value is 6" errors=0 n=6 res=[1,1,2,3,3,3] cache=0 hits=0
test: list=4,4,5,5 factor=3
expect: => i=6 r=0.0 ok=true s="running histogram scaled value is 6" errors=0 n=4 res=[4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var distinct_bins = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		distinct_bins++;
		i = j;
	}
	let result = distinct_bins * f;
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "running histogram scaled value is ", result);
	out
}
@end
@entry 7d73dd11e94815b0
kind: step
verb: collect
noun: memo
modifier: between
context: sort
phrase: collect memo table values between bounds {low} to {high}
phrase: gather memo results falling between limits {low} to {high}
slot: low int
slot: high int
test: list=1,2 low=5 high=25
expect: => i=30 r=0.0 ok=true s="collected 2 memo items summing to 30" errors=0 n=2 res=[1,2] cache=3 hits=0
test: list=10,20 low=30 high=60
expect: => i=50 r=0.0 ok=true s="collected 1 memo items summing to 50" errors=0 n=2 res=[10,20] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if g.cn == 0 {
		gold_cache_put(g, 1, 10);
		gold_cache_put(g, 2, 20);
		gold_cache_put(g, 3, 50);
	}
	var total = 0;
	var count = 0;
	for i in g.cn {
		if g.cv[i] >= lo && g.cv[i] <= hi {
			total += g.cv[i];
			count++;
		}
	}
	g.steps += g.cn;
	out.i = total;
	out.s.clear();
	format(out.s, "collected ", count, " memo items summing to ", total);
	out
}
@end
