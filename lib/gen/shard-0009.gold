phrase: locate square numbers meeting at least {sq_limit}
phrase: collect square entries surpassing threshold {sq_limit}
slot: sq_limit int
test: list=4,9,16,25,30 sq_limit=10
expect: => i=2 r=0.0 ok=true s="squares found 2" errors=0 n=2 res=[16,25] cache=0 hits=0
test: list=1,4,9 sq_limit=5
expect: => i=1 r=0.0 ok=true s="squares found 1" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cutoff = ${sq_limit};
	var valid = 0;
	for idx in g.n {
		let num = g.res[idx];
		if num >= cutoff {
			var r = 0;
			while r * r < num { r++; }
			if r * r == num {
				g.res[valid] = num;
				valid++;
			}
		}
	}
	g.n = valid;
	g.steps += g.n + valid + 1;
	out.i = valid;
	out.s.clear();
	format(out.s, "squares found ", valid);
	out
}
@end
