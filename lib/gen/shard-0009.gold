	gold_clear(g);
	for e in evens { gold_push(g, e); }
	for o in odds { gold_push(g, o); }
	g.steps += g.n + 1;
	out.i = odds.len;
	out.s.clear();
	format(out.s, "odds rotated: ", odds.len);
	out
}
