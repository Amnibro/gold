@entry 352dfed8196026c5
kind: step
verb: reverse
noun: steps
modifier: any
context: list
phrase: reverse steps any chunk size {block}
phrase: invert list blocks by steps of {block}
slot: block int
test: list=1,2,3,4,5,6 block=2
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[2,1,4,3,6,5] cache=0 hits=0
test: list=1,2,3,4,5,6,7,8 block=4
expect: => i=8 r=0.0 ok=true s="" errors=0 n=8 res=[4,3,2,1,8,7,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${block};
	if b <= 1 || g.n == 0 {
		out.i = g.n;
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + b - 1;
		if j >= g.n { j = g.n - 1; }
		var left = i;
		var right = j;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
		i += b;
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
