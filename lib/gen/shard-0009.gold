fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${times};
	let orig = g.n;
	for k in orig {
		if ${ID}_is_prime(g.res[k]) {
			for r in rep {
				gold_push(g, g.res[k]);
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated primes list size ", g.n);
	out
}
@end
