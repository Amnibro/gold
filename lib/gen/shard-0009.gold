code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var toggled = 0;
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			out.s[i] = (b - 32) as byte;
			toggled++;
		} else if b >= 'A' && b <= 'Z' {
			out.s[i] = (b + 32) as byte;
			toggled++;
		}
	}
	g.steps += out.s.len;
	out.i = toggled;
	out
}
@end
