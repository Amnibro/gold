fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	let count = if w < g.n { w } else { g.n };
	var diff_sum = 0;
	if count > 1 {
		for k in count - 1 {
			diff_sum += g.res[k + 1] - g.res[k];
		}
	}
	g.steps += count;
	out.i = diff_sum;
	out.s.clear();
	format(out.s, "pairwise folded window sum ", diff_sum);
	out
}
@end
