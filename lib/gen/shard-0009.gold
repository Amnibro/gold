fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		return out;
	}
	let pairs = g.n / 2;
	var run = 0;
	for i in pairs {
		let s = g.res[i * 2] + g.res[i * 2 + 1];
		run += s;
		g.res[i] = run;
	}
	g.n = pairs;
	g.steps += pairs;
	out.i = run;
	out.s.clear();
	format(out.s, "running pair sum ", run);
	out
}
