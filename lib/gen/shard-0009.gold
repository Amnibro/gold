expect: => i=1 r=0.0 ok=false s="suffix rank freq 1" errors=0 n=4 res=[1,4,4,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req_freq = ${freq};
	if g.n == 0 { out.ok = false; return out; }
	let suffix_val = g.res[g.n - 1];
	var occ = 0;
	for i in g.n {
		if g.res[i] == suffix_val { occ++; }
	}
	let passes = (occ >= req_freq);
	g.steps += g.n;
	out.ok = passes;
	out.i = occ;
	out.s.clear();
	format(out.s, "suffix rank freq ", occ);
	out
}
@end
