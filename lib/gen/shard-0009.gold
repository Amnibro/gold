fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let actual = if count > g.n { g.n } else { count };
	let start = g.n - actual;
	var sum = 0;
	for i in start..g.n { sum += g.res[i]; }
	g.n = start;
	g.steps += actual;
	out.i = sum;
	out.s.clear();
