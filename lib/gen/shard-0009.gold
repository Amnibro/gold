kind: step
verb: dedupe
noun: range
modifier: between
context: stats
phrase: dedupe sample values falling between {low} to {high}
phrase: remove duplicate observations between limits {low} to {high}
slot: low int
slot: high int
test: list=5,10,10,12,10,30 low=8 high=15
expect: => i=2 r=0.0 ok=true s="deduped 2 values in range" errors=0 n=4 res=[5,10,12,30] cache=0 hits=0
test: list=2,4,4,4,6,8 low=3 high=5
expect: => i=2 r=0.0 ok=true s="deduped 2 values in range" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var kept int[512] = [0; 512];
	var kp = 0;
	var removed = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= lo && x <= hi {
			var seen = false;
			for j in kp {
				if kept[j] == x { seen = true; break; }
			}
			if seen { removed++; continue; }
		}
		kept[kp] = x;
		kp++;
	}
	gold_clear(g);
	for i in kp { gold_push(g, kept[i]); }
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped ", removed, " values in range");
	out
}
@end
