noun: duplicates
modifier: recursively
context: text
phrase: find duplicates recursively
phrase: recursively find duplicate characters
phrase: detect repeated duplicate letters recursively
test: text="programming"
expect: => i=3 r=0.0 ok=true s="programming" errors=0 n=0 res=[] cache=0 hits=0
test: text="bookkeeper"
expect: => i=3 r=0.0 ok=true s="bookkeeper" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen = 0;
	var dup = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let bit = 1 << ((c - 'a') as int);
			if (seen & bit) != 0 {
				dup |= bit;
			} else {
				seen |= bit;
			}
		}
		i++;
	}
	var count = 0;
	for k in 0..26 {
		if (dup & (1 << k)) != 0 { count++; }
	}
	out.i = count;
	g.steps += 1;
	out
}
@end
