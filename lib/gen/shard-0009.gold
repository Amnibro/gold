code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept int[64];
	var p = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in p {
			if kept[j] == x { seen = true; break; }
		}
		if !seen && p < 64 { kept[p] = x; p++; }
		i--;
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "deduped backward unique ", p);
	out
}
