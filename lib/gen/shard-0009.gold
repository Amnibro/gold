@entry 1236d58df1097960
kind: step
verb: reverse
noun: total
modifier: up_to
context: stats
phrase: reverse total up to bound {max_val}
phrase: invert entries bounded below {max_val}
slot: max_val int
test: list=20,5,8,30 max_val=15
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[20,8,5,30] cache=0 hits=0
test: list=10,2,4,50 max_val=20
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[4,2,10,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_val};
	var left = 0;
	var right = g.n - 1;
	while left < right {
		while left < right && g.res[left] > mv { left++; }
		while left < right && g.res[right] > mv { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
