fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var max_sum = 0;
	var i = 0;
	while i < out.s.len {
		if out.s[i] == ' ' {
			i++;
		} else {
			var cur_sum = 0;
			while i < out.s.len && out.s[i] != ' ' {
				cur_sum += out.s[i] as int;
				i++;
			}
			if cur_sum > max_sum { max_sum = cur_sum; }
		}
	}
	g.steps += out.s.len;
	out.i = max_sum;
	out.s.clear();
	format(out.s, "highest word total is ", max_sum);
	out
}
