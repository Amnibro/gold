code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var start = 0;
	if g.n > sz { start = g.n - sz; }
	var pos = 0;
	while start < g.n {
		g.res[pos] = g.res[start];
		pos++;
		start++;
	}
	g.n = pos;
	g.steps += pos;
	out.i = pos;
	out.s.clear();
	format(out.s, "tail elements retained: ", pos);
	out
}
@end
