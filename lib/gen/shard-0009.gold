kind: step
verb: find
noun: minimum
modifier: until
context: search
phrase: find minimum search value until stopping index {stop_idx}
phrase: compute minimum search element up until index {stop_idx}
slot: stop_idx int
test: list=40,20,50,10,80 stop_idx=2
expect: => i=20 r=0.0 ok=true s="minimum until index is 20" errors=0 n=5 res=[40,20,50,10,80] cache=0 hits=0
test: list=15,8,30 stop_idx=1
expect: => i=8 r=0.0 ok=true s="minimum until index is 8" errors=0 n=3 res=[15,8,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_idx};
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		out.s.append("empty results");
		return out;
	}
	var min_val = g.res[0];
	var limit = stop;
	if limit >= g.n { limit = g.n - 1; }
	for k in 0..(limit + 1) {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	g.steps += limit + 1;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum until index is ", min_val);
	out
}
@end
