code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var stored = 0;
	var i = 0;
	while i < g.n {
		gold_cache_put(g, stored, g.res[i]);
		stored++;
		i += 2;
	}
	if stored == 0 {
		gold_cache_put(g, 0, out.i);
		stored = 1;
	}
	out.i = stored;
	g.steps += stored;
	out.s.clear();
	format(out.s, "cached every other history count ", stored);
	out
}
@end
