fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	if lo > hi {
		gold_fail(g, "invalid bounds for retry interval");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: inverted bounds");
		return out;
	}
	var matched = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			g.res[i] = g.res[i] * 2;
			matched++;
		}
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "updated ", matched, " numbers in interval");
	out
}
@end
