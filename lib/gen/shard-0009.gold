code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${count};
	var dropped = 0;
	var new_s byte[..200] = "";
	for i in out.s.len {
		let b = out.s[i];
		if b >= '0' && b <= '9' && dropped < limit {
			dropped++;
		} else {
			new_s.push(b);
		}
	}
	out.s.clear();
	for i in new_s.len { out.s.push(new_s[i]); }
	g.steps += out.s.len;
	out.i = dropped;
	out
}
@end
