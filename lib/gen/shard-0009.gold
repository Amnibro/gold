fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${cap};
	let sz = if c > g.n { g.n } else { c };
	for i in sz / 2 {
		let j = sz - 1 - i;
		let tmp = g.res[i];
		g.res[i] = g.res[j];
		g.res[j] = tmp;
	}
	out.s.clear();
	format(out.s, "reversed count: ", sz);
	out.i = sz;
	g.steps += sz;
	out
}
@end
