@entry 82dbd929e9d4b88c
kind: step
verb: measure
noun: average
modifier: with_cache
context: sort
phrase: measure sort average with cache into val
phrase: compute cached average of sorted elements
test: list=2,4,6
expect: => i=4 r=4.0 ok=true s="measured sort average 4" errors=0 n=3 res=[2,4,6] cache=1 hits=0
test: list=10,20,30,40
expect: => i=25 r=25.0 ok=true s="measured sort average 25" errors=0 n=4 res=[10,20,30,40] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for average");
		out.ok = false;
		return out;
	}
	let cached_val, found = gold_cache_get(g, g.n);
	if found {
		out.i = cached_val;
		out.r = cached_val as real;
		out.s.clear();
		format(out.s, "cached sort average ", cached_val);
		return out;
	}
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = sum / g.n;
	gold_cache_put(g, g.n, avg);
	g.steps += g.n;
	out.i = avg;
	out.r = avg as real;
	out.s.clear();
	format(out.s, "measured sort average ", avg);
	out
}
@end
