phrase: isolate leading items of nested pair blocks
test: list=10,20,30,40,50,60
expect: => i=3 r=0.0 ok=true s="nested prefixes 3" errors=0 n=3 res=[10,30,50] cache=0 hits=0
test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="nested prefixes 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prefix_items int[64];
	var p = 0;
	var i = 0;
	while i < g.n {
		if p < 64 { prefix_items[p] = g.res[i]; p++; }
		i += 2;
	}
	gold_clear(g);
	for k in p { gold_push(g, prefix_items[k]); }
	g.steps += p;
	out.i = p;
	out.s.clear();
	format(out.s, "nested prefixes ", p);
	out
}
@end
