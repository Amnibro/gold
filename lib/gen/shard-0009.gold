@entry a501c61a8d427242
kind: step
verb: sort
noun: letters
modifier: each
context: list
phrase: sort letter code values across each list item
phrase: order each letter code in list ascending
test: list=67,65,66
expect: => i=3 r=0.0 ok=true s="sorted 3 letter codes" errors=0 n=3 res=[65,66,67] cache=0 hits=0
test: list=90,65,80,68
expect: => i=4 r=0.0 ok=true s="sorted 4 letter codes" errors=0 n=4 res=[65,68,80,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in i + 1..g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted ", g.n, " letter codes");
	out
}
@end
@entry ae4ccc593b250693
kind: step
verb: search
noun: budget
modifier: in_reverse
context: list
phrase: search reverse item count fitting inside budget {budget}
phrase: find items in reverse within total budget {budget}
slot: budget int
test: list=10,20,30,40 budget=80
expect: => i=2 r=0.0 ok=true s="found 2 items in reverse under budget 80" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=100 budget=50
expect: => i=0 r=0.0 ok=true s="found 0 items in reverse under budget 50" errors=0 n=1 res=[100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var count = 0;
	for i in g.n {
		let x = g.res[g.n - 1 - i];
		if running + x <= b {
			running += x;
			count++;
		} else {
			break;
		}
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " items in reverse under budget ", b);
	out
}
@end
@entry a9ef6a9647d0318e
kind: step
verb: rotate
noun: pairs
modifier: sorted
context: list
phrase: rotate adjacent pairs into sorted order
phrase: sort each consecutive pair in sequence
test: list=20,10,50,30
expect: => i=2 r=0.0 ok=true s="sorted 2 adjacent pairs" errors=0 n=4 res=[10,20,30,50] cache=0 hits=0
test: list=5,2,8
expect: => i=1 r=0.0 ok=true s="sorted 1 adjacent pairs" errors=0 n=3 res=[2,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swapped_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swapped_pairs++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = swapped_pairs;
	out.s.clear();
	format(out.s, "sorted ", swapped_pairs, " adjacent pairs");
	out
}
@end
