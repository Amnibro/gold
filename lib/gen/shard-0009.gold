code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept int[64];
	var p = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq <= 2 && p < 64 { kept[p] = x; p++; }
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "histogram filtered ", p);
	out
}
@end
