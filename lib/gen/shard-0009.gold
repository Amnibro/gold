slot: target int
test: list=123,456 target=5
expect: => i=5 r=0.0 ok=true s="scanned digits count 5" errors=0 n=2 res=[123,456] cache=0 hits=0
test: list=12,34 target=9
expect: => i=4 r=0.0 ok=false s="scanned digits count 4" errors=0 n=2 res=[12,34] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop_val = ${target};
	var digits_seen = 0;
	var found = false;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		while x > 0 {
			let d = x % 10;
			digits_seen++;
			if d == stop_val {
				found = true;
				break;
			}
			x /= 10;
		}
		if found { break; }
	}
	out.ok = found;
	out.i = digits_seen;
	g.steps += digits_seen + 1;
	out.s.clear();
	format(out.s, "scanned digits count ", digits_seen);
	out
}
@end
