test: list=5,5,5,6
expect: => i=2 r=0.0 ok=true s="deduped pairs 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept int[64];
	var p = 0;
	kept[0] = g.res[0];
	p = 1;
	for i in (g.n - 1) {
		if g.res[i + 1] != g.res[i] {
			if p < 64 { kept[p] = g.res[i + 1]; p++; }
		}
	}
	gold_clear(g);
	for k in p { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = p;
	out.s.clear();
	format(out.s, "deduped pairs ", p);
	out
}
@end
