fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var kept = 0;
	var temp int[512] = [0; 512];
	for i in (g.n - 1) {
		if (g.res[i] % 2 != 0) || (g.res[i + 1] % 2 != 0) {
			temp[kept] = g.res[i];
			kept++;
		}
	}
	temp[kept] = g.res[g.n - 1];
	kept++;
	for i in kept { g.res[i] = temp[i]; }
	g.n = kept;
	g.steps += kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "filtered ", kept, " pairwise odd items");
	out
}
