@entry e0f943ad3eedfd0f
kind: step
verb: reverse
noun: range
modifier: while
context: compare
phrase: reverse range while positive prefix
phrase: invert range while elements stay positive
test: list=1,2,3,-1,5
expect: => i=3 r=0.0 ok=true s="reversed positive range count 3" errors=0 n=5 res=[3,2,1,-1,5] cache=0 hits=0
test: list=-5,2,3
expect: => i=0 r=0.0 ok=true s="reversed positive range count 0" errors=0 n=3 res=[-5,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pos_count = 0;
	while pos_count < g.n && g.res[pos_count] > 0 {
		pos_count++;
	}
	var left = 0;
	var right = pos_count - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += pos_count;
	out.i = pos_count;
	out.s.clear();
	format(out.s, "reversed positive range count ", pos_count);
	out
}
@end
