	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let s = ${slen};
	let count = if s < g.cn { s } else { g.cn };
	let start = g.cn - count;
	for i in count {
		g.ck[i] = g.ck[start + i];
		g.cv[i] = g.cv[start + i];
	}
	g.cn = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "filtered nested cache suffix ", count);
	out
}
