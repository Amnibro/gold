code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${max_v};
	var vowels = 0;
	var i = out.s.len;
	while i > 0 {
		i--;
		let b = out.s[i];
		let is_v = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u');
		if is_v {
			vowels++;
			if vowels > mv {
				out.s[i] = '_';
			}
		}
	}
	g.steps += out.s.len;
	out.i = vowels;
	out
}
@end
