kind: step
verb: normalize
noun: list
modifier: unique
context: retry
phrase: normalize list unique values deduplicating
phrase: clean list unique items removing duplicates
test: list=1,2,2,3,3,4
expect: => i=4 r=0.0 ok=true s="deduplicated to 4 unique items" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: input=0
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list for unique normalization");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var unique int[512] = [0; 512];
	var nu = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in nu {
			if unique[j] == x { found = true; break; }
		}
		if !found {
			unique[nu] = x;
			nu++;
		}
	}
	for k in nu { g.res[k] = unique[k]; }
	g.n = nu;
	g.steps += g.n;
	out.i = nu;
	out.s.clear();
	format(out.s, "deduplicated to ", nu, " unique items");
	out
}
@end
