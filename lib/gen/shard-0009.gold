fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var j = g.n - 1;
		while j > 0 {
			g.res[j] = g.res[j - 1];
			j--;
		}
		g.res[0] = last;
	}
	out.s.clear();
	out.s.append("rotated: [");
	for i in g.n {
		if i > 0 { out.s.append(", "); }
		format(out.s, g.res[i]);
	}
	out.s.append("]");
	out.i = if g.n > 0 { g.res[0] } else { 0 };
	g.steps += g.n;
	out
}
