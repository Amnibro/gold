@entry cd9f10d0f1433c96
kind: step
verb: reverse
noun: histogram
modifier: nested
context: sort
phrase: reverse nested frequency histogram bins within threshold {cutoff}
phrase: invert frequency counts of elements bounded below cutoff {cutoff}
slot: cutoff int
test: list=1,1,2,2,3,3,3 cutoff=2
expect: => i=4 r=0.0 ok=true s="reversed 4 nested histogram items" errors=0 n=7 res=[1,1,2,2,3,3,3] cache=0 hits=0
test: list=4,4,4,5,5 cutoff=5
expect: => i=5 r=0.0 ok=true s="reversed 5 nested histogram items" errors=0 n=5 res=[4,4,4,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var modified = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let freq = j - i;
		if freq <= cut {
			var left = i;
			var right = j - 1;
			while left < right {
				let tmp = g.res[left];
				g.res[left] = g.res[right];
				g.res[right] = tmp;
				left++;
				right--;
			}
			modified += freq;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "reversed ", modified, " nested histogram items");
	out
}
@end
