expect: => i=0 r=0.0 ok=false s="error: zero matches" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let repl = ${val};
	var matched = 0;
	for i in g.n {
		if ${p}(g.res[i]) {
			g.res[i] = repl;
			matched++;
		}
	}
	if matched == 0 {
		gold_fail(g, "no items matched predicate");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero matches");
		return out;
	}
	g.steps += g.n;
	out.i = matched;
	out.s.clear();
	format(out.s, "filled ", matched, " matching elements");
	out
}
@end
