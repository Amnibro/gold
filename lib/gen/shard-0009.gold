				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
	}
	g.steps += p * g.n;
	out.i = swaps;
	out.s.clear();
	format(out.s, "performed in place passes with ", swaps, " swaps");
	out
}
