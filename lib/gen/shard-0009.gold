@entry 32042720051ead6b
kind: step
verb: join
noun: squares
modifier: nested
context: sort
phrase: join nested squares of sort keys
phrase: compute nested sorted squares of values
phrase: collect squares into nested sorted order
test: list=3,1,4,2
expect: => i=4 r=0.0 ok=true s="nested sorted squares 4" errors=0 n=4 res=[1,4,9,16] cache=0 hits=0
test: list=5,2,3
expect: => i=3 r=0.0 ok=true s="nested sorted squares 3" errors=0 n=3 res=[4,9,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		g.res[k] = g.res[k] * g.res[k];
	}
	if g.n > 1 {
		for i in g.n {
			for j in g.n - 1 {
				if g.res[j] > g.res[j + 1] {
					let tmp = g.res[j];
					g.res[j] = g.res[j + 1];
					g.res[j + 1] = tmp;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested sorted squares ", g.n);
	out
}
@end
