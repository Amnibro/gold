kind: step
verb: shift
noun: memo
modifier: nested
context: cache
phrase: shift memo cache values right by {offset}
phrase: rotate cached memo values by position {offset}
phrase: cycle memo entries forward by {offset}
slot: offset int
test: list=10,20,30 offset=1
expect: => i=1 r=0.0 ok=true s="shifted memo by 1" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15,25,35 offset=2
expect: => i=2 r=0.0 ok=true s="shifted memo by 2" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	if g.cn == 0 { return out; }
	let sh = ${offset} % g.cn;
	var temp: int[256] = [0; 256];
	for i in g.cn {
		let new_pos = (i + sh) % g.cn;
		temp[new_pos] = g.cv[i];
	}
	for i in g.cn { g.cv[i] = temp[i]; }
	g.steps += g.cn;
	out.i = sh;
	out.s.clear();
	format(out.s, "shifted memo by ", sh);
	out
}
@end
