fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 1 {
		let m = out.s.len - 1;
		for i in m {
			let diff = (out.s[i + 1] as int) - (out.s[i] as int);
			g.res[i] = if diff < 0 { -diff } else { diff };
		}
		g.n = m;
	}
	out.s.clear();
	format(out.s, "pairwise deltas: ", g.n);
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
