test: list=1,5,3,8
expect: => i=0 r=0.0 ok=false s="running order contains inversions" errors=0 n=4 res=[1,5,3,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var is_sorted = true;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			if g.res[i] > g.res[i + 1] {
				is_sorted = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.s.clear();
	if is_sorted {
		out.i = 1;
		out.s.append("running order is fully sorted");
	} else {
		out.i = 0;
		out.s.append("running order contains inversions");
	}
	out
}
@end
@entry aca523b3e96e3793
kind: step
verb: sort
noun: suffix
modifier: at_least
context: sort
phrase: sort suffix elements starting from at least index {start_idx}
phrase: order trailing items from minimum start position {start_idx}
slot: start_idx int
test: list=10,9,8,4,2 start_idx=2
expect: => i=3 r=0.0 ok=true s="sorted 3 suffix elements" errors=0 n=5 res=[10,9,2,4,8] cache=0 hits=0
test: list=5,4,3,2,1 start_idx=3
expect: => i=2 r=0.0 ok=true s="sorted 2 suffix elements" errors=0 n=5 res=[5,4,3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${start_idx};
	var s = start;
	if s < 0 { s = 0; }
	if s < g.n {
		for i in s..g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	let sorted_count = if s < g.n { g.n - s } else { 0 };
	g.steps += sorted_count * sorted_count;
	out.i = sorted_count;
	out.s.clear();
	format(out.s, "sorted ", sorted_count, " suffix elements");
	out
}
@end
