		let a = g.res[i];
		let b = g.res[i + 1];
		let c = g.res[i + 2];
		var u = a;
		if b != a { u += b; }
		if c != a && c != b { u += c; }
		total += u;
		i++;
	}
	g.steps += i;
	out.i = total;
	out.s.clear();
	format(out.s, "window fold ", total);
