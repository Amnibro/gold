code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			even_count++;
		}
	}
	if even_count == 0 {
		gold_fail(g, "no even numbers to normalize");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero evens");
		return out;
	}
	var sum = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			sum += g.res[i];
			g.res[i] = sum;
		}
	}
	g.steps += g.n;
	out.i = even_count;
	out.s.clear();
	format(out.s, "running evens count ", even_count);
	out
}
@end
