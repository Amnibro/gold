fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${lim};
	var sum = 0;
	var keep = 0;
	for k in g.n {
		if sum + g.res[k] <= limit {
			sum += g.res[k];
			g.res[keep] = g.res[k];
			keep++;
		} else { break; }
