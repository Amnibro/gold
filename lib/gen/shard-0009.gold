@entry de287a593c458ece
kind: step
verb: sum
noun: histogram
modifier: sorted
context: aggregate
phrase: sum top {top} sorted histogram frequencies
phrase: accumulate {top} highest histogram counts
phrase: aggregate {top} sorted histogram bins
slot: top int
test: list=12,50,5,30,22 top=2
expect: => i=80 r=0.0 ok=true s="sum of top sorted bins is 80" errors=0 n=5 res=[12,50,5,30,22] cache=0 hits=0
test: list=15,45,25,35,55 top=3
expect: => i=135 r=0.0 ok=true s="sum of top sorted bins is 135" errors=0 n=5 res=[15,45,25,35,55] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let top = ${top};
	var vals = [0; 512];
	for k in g.n { vals[k] = g.res[k]; }
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if vals[j] < vals[j + 1] {
				let t = vals[j];
				vals[j] = vals[j + 1];
				vals[j + 1] = t;
			}
			g.steps++;
		}
	}
	var total = 0;
	let limit = if top < g.n { top } else { g.n };
	for k in limit {
		total += vals[k];
		g.steps++;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "sum of top sorted bins is ", total);
	out
}
@end
