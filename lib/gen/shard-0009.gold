code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid = true;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k] > g.res[k + 1] {
				valid = false;
				break;
			}
		}
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	if valid {
		gold_text(out, "search list valid");
	} else {
		gold_fail(g, "search list unordered");
		gold_text(out, "search list invalid");
	}
	out
}
@end
