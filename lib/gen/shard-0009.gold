test: list=10,20,30,40 win=2
expect: => i=35 r=0.0 ok=true s="trailing search average rank 35" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=5,15,25,35,45 win=3
expect: => i=35 r=0.0 ok=true s="trailing search average rank 35" errors=0 n=5 res=[5,15,25,35,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	let count = if w < g.n { w } else { g.n };
	var sum = 0;
	if count > 0 {
		for k in (g.n - count)..g.n { sum += g.res[k]; }
		out.i = sum / count;
	}
	g.steps += count;
	out.s.clear();
	format(out.s, "trailing search average rank ", out.i);
	out
}
@end
