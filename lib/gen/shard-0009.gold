@entry 2b9fdb3122130dd4
kind: step
verb: scale
noun: minimum
modifier: any
context: stats
phrase: scale any minimum observation by factor {factor}
phrase: multiply any smallest measurement by ratio {factor}
slot: factor int
test: list=12,4,8,4,16 factor=3
expect: => i=2 r=0.0 ok=true s="scaled 2 minimum values" errors=0 n=5 res=[12,12,8,12,16] cache=0 hits=0
test: list=20,10,30 factor=2
expect: => i=1 r=0.0 ok=true s="scaled 1 minimum values" errors=0 n=3 res=[20,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	if g.n == 0 {
		out.s.clear();
		out.s.append("empty dataset");
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	var count = 0;
	for k in g.n {
		if g.res[k] == min_val {
			g.res[k] = g.res[k] * f;
			count++;
		}
	}
	g.steps += g.n * 2;
	out.i = count;
	out.s.clear();
	format(out.s, "scaled ", count, " minimum values");
	out
}
@end
