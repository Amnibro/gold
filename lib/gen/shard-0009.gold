@entry 81b8b12ccd5000a0
kind: step
verb: clamp
noun: runs
modifier: each
context: text
phrase: clamp length of each identical character run to {max_run}
phrase: restrict consecutive repeating character runs to {max_run}
slot: max_run int
test: text="aaaaabbc" max_run=2
expect: => i=3 r=0.0 ok=true s="aabbc" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxxx" max_run=1
expect: => i=1 r=0.0 ok=true s="x" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_run};
	var res byte[..200] = "";
	var i = 0;
	var runs = 0;
	while i < out.s.len {
		var j = i + 1;
		while j < out.s.len && out.s[j] == out.s[i] { j++; }
		let run_len = j - i;
		let keep_len = if run_len > cap { cap } else { run_len };
		for _ in keep_len { res.push(out.s[i]); }
		runs++;
		i = j;
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = runs;
	out
}
@end
