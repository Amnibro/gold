@entry 81bedbeb53d347e2
kind: step
verb: run
noun: head
modifier: between
context: sort
phrase: run sorting on leading head between bounds {low} to {high}
phrase: order initial head items within interval {low} to {high}
slot: low int
slot: high int
test: list=30,20,10,40,50 low=10 high=35
expect: => i=3 r=0.0 ok=true s="sorted 3 head items in range" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=8,4,2,12 low=3 high=10
expect: => i=2 r=0.0 ok=true s="sorted 2 head items in range" errors=0 n=4 res=[4,8,2,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var count = 0;
	for i in g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			count++;
		}
	}
	for i in g.n {
		for j in (i + 1)..g.n {
			if g.res[i] >= lo && g.res[i] <= hi && g.res[j] >= lo && g.res[j] <= hi {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted ", count, " head items in range");
	out
}
@end
@entry 551b02e6e1b944bb
kind: step
verb: rotate
noun: squares
modifier: until
context: sort
phrase: rotate perfect squares in sorted array until bound {bound}
phrase: cycle square numbers in sorted sequence until reaching {bound}
slot: bound int
test: list=1,4,9,16,25 bound=15
expect: => i=3 r=0.0 ok=true s="rotated 3 squares" errors=0 n=5 res=[4,9,1,16,25] cache=0 hits=0
test: list=4,9,20 bound=10
expect: => i=2 r=0.0 ok=true s="rotated 2 squares" errors=0 n=3 res=[9,4,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var square_indices: int[64] = [0; 64];
	var sn = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= b { break; }
		var r = 0;
		while r * r < x { r++; }
		if r * r == x && sn < 64 {
			square_indices[sn] = k;
			sn++;
		}
	}
	if sn > 1 {
		let first_val = g.res[square_indices[0]];
		for i in 0..(sn - 1) {
			g.res[square_indices[i]] = g.res[square_indices[i + 1]];
		}
		g.res[square_indices[sn - 1]] = first_val;
	}
	g.steps += g.n;
	out.i = sn;
	out.s.clear();
	format(out.s, "rotated ", sn, " squares");
	out
}
@end
@entry 25f13da6cd77adb8
kind: step
verb: fold
noun: runs
modifier: each
context: sort
phrase: fold each equal sorted run into unique value with count multiplier {mult}
phrase: collapse each duplicate sorted run using scaling multiplier {mult}
slot: mult int
test: list=1,1,2,3,3,3 mult=2
expect: => i=3 r=0.0 ok=true s="folded into 3 unique runs" errors=0 n=3 res=[5,4,9] cache=0 hits=0
test: list=5,5,5,9 mult=3
expect: => i=2 r=0.0 ok=true s="folded into 2 unique runs" errors=0 n=2 res=[14,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${mult};
	var kept: int[64] = [0; 64];
	var kn = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if kn < 64 {
			kept[kn] = g.res[i] + (run_len * m);
			kn++;
		}
		i = j;
	}
	gold_clear(g);
	for k in kn { gold_push(g, kept[k]); }
	g.steps += g.n;
	out.i = kn;
	out.s.clear();
	format(out.s, "folded into ", kn, " unique runs");
	out
}
@end
