code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let dm = ${default_min};
	if g.n == 0 {
		gold_push(g, dm);
		out.i = dm;
		return out;
	}
	var min_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] < min_val { min_val = g.res[k]; }
	}
	for k in g.n {
		g.res[k] = min_val;
	}
	out.i = min_val;
	g.steps += g.n;
	out
}
@end
