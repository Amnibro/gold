@entry 66994d767c29eb28
kind: step
verb: sort
noun: cache
modifier: running
context: error
phrase: sort error cache by running keys
phrase: order cached error records in running order
test: list=500,404,403
expect: => i=3 r=0.0 ok=true s="sorted error cache running 3" errors=0 n=3 res=[500,404,403] cache=3 hits=0
test: list=200,503,400
expect: => i=3 r=0.0 ok=true s="sorted error cache running 3" errors=0 n=3 res=[200,503,400] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, g.res[k], k);
	}
	if g.cn > 1 {
		for i in g.cn {
			for j in (i + 1)..g.cn {
				if g.ck[i] > g.ck[j] {
					let tk = g.ck[i];
					let tv = g.cv[i];
					g.ck[i] = g.ck[j];
					g.cv[i] = g.cv[j];
					g.ck[j] = tk;
					g.cv[j] = tv;
				}
			}
		}
	}
	g.steps += g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "sorted error cache running ", g.cn);
	out
}
@end
