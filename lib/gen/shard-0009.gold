code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_idx = ${max_idx};
	let goal = ${target};
	var found = false;
	let bound = if g.n < limit_idx { g.n } else { limit_idx };
	for i in bound {
		if g.res[i] >= goal {
			found = true;
			break;
		}
	}
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	g.steps += bound + 1;
	out.s.clear();
	format(out.s, "threshold found status ", out.i);
	out
}
@end
