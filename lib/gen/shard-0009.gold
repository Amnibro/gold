fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.ok = false; return out; }
	let last_item = g.res[g.n - 1];
	var found = false;
	for idx in g.cn {
		if g.ck[idx] == last_item { found = true; }
	}
	if !found {
		gold_cache_put(g, last_item, g.n);
	}
	g.steps += g.n + g.cn + 1;
	out.ok = !found;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "suffix cache size ", g.cn);
	out
}
