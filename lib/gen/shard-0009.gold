code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${start};
	let count = g.n - st;
	if count > 1 {
		for i in count {
			for j in count - 1 {
				let p1 = st + j;
				let p2 = st + j + 1;
				if g.res[p1] > g.res[p2] {
					let tmp = g.res[p1];
					g.res[p1] = g.res[p2];
					g.res[p2] = tmp;
				}
			}
		}
	}
	g.steps += count * count;
	out.i = count;
	out.s.clear();
	format(out.s, "sorted tail items count ", count);
	out
}
@end
