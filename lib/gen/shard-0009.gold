@entry 7d5e13a7edd34dd1
kind: step
verb: dedupe
noun: tally
modifier: last
context: format
phrase: dedupe tally formatting unique count at end
phrase: format unique item tally at last
phrase: display unique count summary trailing
test: list=2,2,3,4,4,5
expect: => i=4 r=0.0 ok=true s="distinct: 4 of 6" errors=0 n=6 res=[2,2,3,4,4,5] cache=0 hits=0
test: list=10,10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="distinct: 3 of 6" errors=0 n=6 res=[10,10,10,20,30,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniques = [0; 512];
	var u_count = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for u in u_count {
			if uniques[u] == x { seen = true; break; }
		}
		if !seen { uniques[u_count] = x; u_count++; }
		g.steps++;
	}
	out.s.clear();
	format(out.s, "distinct: ", u_count, " of ", g.n);
	out.i = u_count;
	out
}
@end
