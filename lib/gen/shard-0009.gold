@entry 0de81e8669c25b13
kind: step
verb: dedupe
noun: number
modifier: nested
context: compare
phrase: dedupe identical numbers within nested pairs
phrase: eliminate duplicate numbers in nested chunks
phrase: purge matching number pairs in nested blocks
test: list=5,5,8,8,9,1
expect: => i=2 r=0.0 ok=true s="deduped nested numbers 2" errors=0 n=6 res=[5,6,8,9,9,1] cache=0 hits=0
test: list=2,2,3,4
expect: => i=1 r=0.0 ok=true s="deduped nested numbers 1" errors=0 n=4 res=[2,3,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	var changed = 0;
	while i + 1 < g.n {
		if g.res[i] == g.res[i + 1] {
			g.res[i + 1] = g.res[i + 1] + 1;
			changed++;
		}
		i += 2;
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "deduped nested numbers ", changed);
	out
}
@end
@entry a67f3fefbbefc38a
kind: step
verb: sort
noun: maximum
modifier: in_place
context: compare
phrase: swap maximum element to front in place
phrase: position largest value first in place
phrase: place maximum element first during comparison
test: list=10,40,25,15
expect: => i=40 r=0.0 ok=true s="maximum in place 40" errors=0 n=4 res=[40,10,25,15] cache=0 hits=0
test: list=5,12,8
expect: => i=12 r=0.0 ok=true s="maximum in place 12" errors=0 n=3 res=[12,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var max_idx = 0;
	for i in g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	let t = g.res[0];
	g.res[0] = g.res[max_idx];
	g.res[max_idx] = t;
	g.steps += g.n;
	out.i = g.res[0];
	out.s.clear();
	format(out.s, "maximum in place ", g.res[0]);
	out
}
@end
