@entry d27b0bc6749a1d61
kind: step
verb: reverse
noun: total
modifier: at_most
context: list
phrase: reverse total at most {max_sum} elements
phrase: invert prefix with total at most {max_sum}
slot: max_sum int
test: list=2,4,6,8,10 max_sum=15
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[6,4,2,8,10] cache=0 hits=0
test: list=1,2,3,4,5 max_sum=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[3,2,1,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var running = 0;
	var k = 0;
	while k < g.n && running + g.res[k] <= ms {
		running += g.res[k];
		k++;
	}
	var left = 0;
	var right = k - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	out.i = k;
	g.steps += k;
	out
}
@end
@entry ffd323dfa757f4e3
kind: step
verb: keep
noun: series
modifier: unique
context: list
phrase: keep series unique elements in list
phrase: filter unique series items from sequence
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5,6,7,6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var kept = 1;
	for i in 1..g.n {
		var dup = false;
		for j in kept {
			if g.res[j] == g.res[i] { dup = true; break; }
		}
		if !dup {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	g.steps += g.n;
	out
}
@end
