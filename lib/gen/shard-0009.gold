fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniques = [0; 512];
	var u_count = 0;
	for k in g.n {
		let x = g.res[k];
		var seen = false;
		for u in u_count {
			if uniques[u] == x { seen = true; break; }
		}
		if !seen {
			uniques[u_count] = x;
			u_count++;
		}
		g.steps++;
	}
	gold_clear(g);
	for k in u_count { gold_push(g, uniques[k]); }
	out.i = u_count;
	out.s.clear();
	format(out.s, "retained ", u_count, " unique sequence items");
	out
}
@end
