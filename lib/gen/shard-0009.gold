test: list=12,45
expect: => i=2 r=0.0 ok=true s="reversed nested digits for 2 items" errors=0 n=2 res=[21,54] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		var x = g.res[i];
		let neg = x < 0;
		if neg { x = -x; }
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		g.res[i] = if neg { -rev } else { rev };
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed nested digits for ", g.n, " items");
	out
}
@end
