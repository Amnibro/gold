@entry 9799ff28226e3706
kind: step
verb: validate
noun: primes
modifier: running
context: error
phrase: validate running prime error markers
phrase: check running prime status of error codes
test: list=2,3,5,7
expect: => i=0 r=0.0 ok=true s="" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=2,4,6,8
expect: => i=3 r=0.0 ok=false s="" errors=1 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_primes = 0;
	for i in g.n {
		let x = g.res[i];
		var is_prime = true;
		if x < 2 {
			is_prime = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_prime = false;
				}
				d++;
			}
		}
		if !is_prime {
			non_primes++;
		}
	}
	if non_primes > 0 {
		gold_fail(g, "non prime error marker detected");
		out.ok = false;
	} else {
		out.ok = true;
	}
	g.steps += g.n;
	out.i = non_primes;
	out
}
@end
