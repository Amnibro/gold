kind: step
verb: filter
noun: condition
modifier: sorted
context: format
phrase: format sorted elements matching condition {cond}
phrase: render ordered items satisfying filter condition {cond}
phrase: display sorted sequence filtered by condition {cond}
slot: cond pred
test: list=5,2,8,1,9 cond=is_odd
expect: => i=3 r=0.0 ok=true s="sorted filtered count: 3" errors=0 n=3 res=[1,5,9] cache=0 hits=0
test: list=4,7,2,6 cond=is_even
expect: => i=3 r=0.0 ok=true s="sorted filtered count: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for idx in g.n {
		if ${cond}(g.res[idx]) {
			g.res[kept] = g.res[idx];
			kept++;
		}
	}
	g.n = kept;
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let t = g.res[a]; g.res[a] = g.res[b]; g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted filtered count: ", g.n);
	out
}
@end
