noun: values
modifier: unique
context: retry
phrase: deduplicate retry values keeping unique entries
phrase: fill results with unique retry values
test: list=1,2,2,3,3,3,4
expect: => i=4 r=0.0 ok=true s="retained unique items: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,5,5
expect: => i=1 r=0.0 ok=true s="retained unique items: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq int[512] = [0; 512];
	var u_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_count {
			if uniq[j] == x { seen = true; break; }
		}
		if !seen {
			uniq[u_count] = x;
			u_count++;
		}
	}
	for i in u_count {
		g.res[i] = uniq[i];
	}
	let dupes = g.n - u_count;
	g.n = u_count;
	g.steps += g.n + u_count;
	out.i = u_count;
	out.s.clear();
	format(out.s, "retained unique items: ", u_count);
	out
}
@end
