fn ${ID}_is_p(x int) bool {
	if x < 2 { return false; }
	var d = 2;
	while d * d <= x {
		if x % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var prime_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if ${ID}_is_p(x) {
			gold_cache_put(g, x, 1);
			prime_cnt++;
		}
	}
	let ok = prime_cnt > 0;
	out.ok = ok;
	out.s.clear();
	format(out.s, "primes found: ", prime_cnt);
	out.i = prime_cnt;
	g.steps += g.n;
	out
}
@end
