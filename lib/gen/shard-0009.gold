test: list=5,10,15 ceiling=50
expect: => i=30 r=0.0 ok=true s="total clamped in place to 30" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var run = 0;
	var clamped = false;
	for i in g.n {
		if clamped {
			g.res[i] = 0;
		} else if run + g.res[i] > c {
			g.res[i] = c - run;
			run = c;
			clamped = true;
		} else {
			run += g.res[i];
		}
	}
	g.steps += g.n;
	out.i = run;
	out.s.clear();
	format(out.s, "total clamped in place to ", run);
	out
}
@end
@entry 007ff67f100f72df
kind: step
verb: fold
noun: average
modifier: nested
context: math
phrase: fold average nested groups of size {size}
phrase: aggregate average nested blocks with size {size}
slot: size int
test: list=2,4,6,8 size=2
expect: => i=2 r=0.0 ok=true s="nested fold produced 2 averages" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=10,20,30 size=3
expect: => i=1 r=0.0 ok=true s="nested fold produced 1 averages" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n == 0 {
		gold_fail(g, "invalid group size");
		out.ok = false;
		return out;
	}
	var new_n = 0;
	var i = 0;
	while i + sz <= g.n {
		var sum = 0;
		for j in sz {
			sum += g.res[i + j];
		}
		g.res[new_n] = sum / sz;
		new_n++;
		i += sz;
	}
	g.n = new_n;
	g.steps += g.n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "nested fold produced ", new_n, " averages");
	out
}
@end
