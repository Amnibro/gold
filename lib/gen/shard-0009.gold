code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dn = 0;
	if g.n > 1 {
		for k in g.n - 1 {
			if g.res[k] == g.res[k + 1] {
				dups[dn] = g.res[k];
				dn++;
			}
		}
	}
	for k in dn {
		g.res[k] = dups[dn - 1 - k];
	}
	g.n = dn;
	g.steps += dn;
	out.i = dn;
	out.s.clear();
	format(out.s, "reversed sorted duplicates ", dn);
	out
}
@end
@entry ea08174898e94ded
kind: step
verb: rotate
noun: histogram
modifier: at_most
context: sort
phrase: rotate sort histogram in cache at most {cap} steps
phrase: shift cached sort histogram at most {cap} positions
phrase: cycle sort frequency counts at most {cap} places
slot: cap int
test: list=10,20,30 cap=1
expect: => i=1 r=0.0 ok=true s="rotated cache histogram by 1" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=5,15,25,35 cap=2
expect: => i=2 r=0.0 ok=true s="rotated cache histogram by 2" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	let c = ${cap};
	let s = if g.cn > 0 { c % g.cn } else { 0 };
	if g.cn > 1 && s > 0 {
		var tk int[256] = [0; 256];
		var tv int[256] = [0; 256];
		for k in g.cn {
			tk[(k + s) % g.cn] = g.ck[k];
			tv[(k + s) % g.cn] = g.cv[k];
		}
		for k in g.cn {
			g.ck[k] = tk[k];
			g.cv[k] = tv[k];
		}
	}
	g.steps += g.cn;
	out.i = s;
	out.s.clear();
	format(out.s, "rotated cache histogram by ", s);
	out
}
@end
