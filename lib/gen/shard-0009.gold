code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for i in g.n {
		if g.cn >= limit { break; }
		gold_cache_put(g, g.res[i], i);
	}
	out.s.clear();
	format(out.s, "cached: ", g.cn);
	out.i = g.cn;
	g.steps += g.cn;
	out
