code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_clear(g);
	if out.s.len == 0 {
		out.i = 0;
		return out;
	}
	var i = 0;
	var run_cnt = 0;
	while i < out.s.len {
		var j = i + 1;
		while j < out.s.len && out.s[j] == out.s[i] { j++; }
		gold_push(g, j - i);
		run_cnt++;
		i = j;
	}
	g.steps += out.s.len;
	out.i = run_cnt;
	out.s.clear();
	format(out.s, "safely traced ", run_cnt, " character runs");
	out
}
@end
