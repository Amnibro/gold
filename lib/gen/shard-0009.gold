phrase: count sample frequencies into memo table
phrase: tally observation counts using memo cache
test: list=5,5,10,5,20
expect: => i=3 r=0.0 ok=true s="memoized 3 value counts" errors=0 n=5 res=[5,5,10,5,20] cache=3 hits=0
