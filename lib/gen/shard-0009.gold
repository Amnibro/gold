expect: => i=5 r=0.0 ok=true s="sorted evens across 5 items" errors=0 n=5 res=[2,1,6,3,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] % 2 != 0 { continue; }
		var min_idx = i;
		for j in (i + 1)..g.n {
			if g.res[j] % 2 == 0 && g.res[j] < g.res[min_idx] {
				min_idx = j;
			}
		}
		if min_idx != i {
			let tmp = g.res[i];
			g.res[i] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted evens across ", g.n, " items");
	out
}
@end
