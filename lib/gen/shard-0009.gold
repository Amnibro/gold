code:
fn count_vowels_rec(s const byte[:], idx int) int {
	if idx >= s.len { return 0; }
	let b = s[idx];
	let is_v = b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' || b == 'A' || b == 'E' || b == 'I' || b == 'O' || b == 'U';
	return (if is_v { 1 } else { 0 }) + count_vowels_rec(s, idx + 1);
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let vowels = count_vowels_rec(out.s, 0);
	g.steps += out.s.len;
	out.i = vowels;
	out.s.clear();
	format(out.s, "recursive vowels count ", vowels);
	out
}
@end
