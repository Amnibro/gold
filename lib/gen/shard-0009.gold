code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	if k <= 1 || g.n <= 1 {
		out.i = 0;
		out.s.clear();
		format(out.s, "reversed 0 items");
		return out;
	}
	let span = if k > g.n { g.n } else { k };
	let start = g.n - span;
	for i in span / 2 {
		let a = start + i;
		let b = g.n - 1 - i;
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
	}
	g.steps += span;
	out.i = span;
	out.s.clear();
	format(out.s, "reversed last series of ", span, " items");
	out
}
@end
