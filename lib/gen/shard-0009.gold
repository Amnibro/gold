@entry 21a2151a29d4c98e
kind: step
verb: drop
noun: pairs
modifier: between
context: stats
phrase: drop adjacent pairs between difference {min_diff} to {max_diff}
phrase: remove sample pairs between spread {min_diff} to {max_diff}
slot: min_diff int
slot: max_diff int
test: list=10,12,30,35,40 min_diff=1 max_diff=3
expect: => i=1 r=0.0 ok=true s="dropped 1 pairs" errors=0 n=3 res=[30,35,40] cache=0 hits=0
test: list=5,15,20,50 min_diff=4 max_diff=6
expect: => i=1 r=0.0 ok=true s="dropped 1 pairs" errors=0 n=2 res=[5,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_diff};
	let hi = ${max_diff};
	if g.n < 2 {
		out.s.clear();
		out.s.append("insufficient data");
		return out;
	}
	var keep int[512] = [0; 512];
	var kp = 0;
	var k = 0;
	var dropped = 0;
	while k < g.n {
		if k + 1 < g.n {
			let d = g.res[k + 1] - g.res[k];
			let diff = if d < 0 { -d } else { d };
			if diff >= lo && diff <= hi {
				dropped++;
				k += 2;
				continue;
			}
		}
		keep[kp] = g.res[k];
		kp++;
		k++;
	}
	gold_clear(g);
	for i in kp { gold_push(g, keep[i]); }
	g.steps += g.n;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " pairs");
	out
}
@end
