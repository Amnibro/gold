kind: step
verb: validate
noun: runs
modifier: up_to
context: search
phrase: validate search score runs up to length {max_run}
phrase: check identical search result runs up to {max_run}
phrase: verify search score run length up to {max_run}
slot: max_run int
test: list=5,5,10,10,10 max_run=3
expect: => i=3 r=0.0 ok=true s="search runs valid" errors=0 n=5 res=[5,5,10,10,10] cache=0 hits=0
test: list=2,2,2,2 max_run=3
expect: => i=4 r=0.0 ok=false s="search runs invalid" errors=1 n=4 res=[2,2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_len = ${max_run};
	var max_found = 0;
	if g.n > 0 {
		var cur = 1;
		max_found = 1;
		for k in 1..g.n {
			if g.res[k] == g.res[k - 1] {
				cur++;
				if cur > max_found { max_found = cur; }
			} else {
				cur = 1;
			}
		}
	}
	g.steps += g.n;
	out.i = max_found;
	if max_found <= max_len {
		out.ok = true;
		gold_text(out, "search runs valid");
	} else {
		gold_fail(g, "search run exceeded max length");
		out.ok = false;
		gold_text(out, "search runs invalid");
	}
	out
}
@end
