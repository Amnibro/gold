@entry bc6a78f2dc2b5a49
kind: step
verb: fill
noun: steps
modifier: with_retry
context: sort
phrase: fill step differences with retry padding
phrase: pad step gaps between sorted elements with retry
phrase: interpolate missing steps in sequence
test: list=10,14,20
expect: => i=1 r=0.0 ok=true s="padded 1 steps" errors=0 n=4 res=[10,14,17,20] cache=0 hits=0
test: list=5,15,30
expect: => i=2 r=0.0 ok=true s="padded 2 steps" errors=0 n=5 res=[5,10,15,22,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp: int[512] = [0; 512];
	var tn = 0;
	for k in g.n {
		if k > 0 && g.res[k] - g.res[k - 1] > 5 && tn < 511 {
			temp[tn] = (g.res[k] + g.res[k - 1]) / 2;
			tn++;
		}
		if tn < 512 {
			temp[tn] = g.res[k];
			tn++;
		}
	}
	for k in tn { g.res[k] = temp[k]; }
	let added = tn - g.n;
	g.n = tn;
	g.steps += tn;
	out.i = added;
	out.s.clear();
	format(out.s, "padded ", added, " steps");
	out
}
@end
