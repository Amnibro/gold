code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_iter = ${attempts};
	for k in g.n {
		var val = g.res[k];
		var iter = 0;
		while iter < max_iter {
			val = val * val;
			iter++;
		}
		g.res[k] = val;
	}
	g.steps += g.n * max_iter;
	out.i = g.n;
	out.s.clear();
	format(out.s, "recursively squared ", g.n, " items");
	out
}
@end
