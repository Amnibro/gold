slot: max_gap int
test: list=10,35,40 max_gap=15
expect: => i=1 r=0.0 ok=true s="adjusted 1 cache key gaps" errors=0 n=3 res=[10,35,40] cache=3 hits=0
test: list=5,25 max_gap=10
expect: => i=1 r=0.0 ok=true s="adjusted 1 cache key gaps" errors=0 n=2 res=[5,25] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${max_gap};
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	var adjusted = 0;
	for i in 1..g.cn {
		let diff = g.ck[i] - g.ck[i - 1];
		if diff > max_d {
			g.ck[i] = g.ck[i - 1] + max_d;
			adjusted++;
		}
	}
	g.steps += g.cn;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "adjusted ", adjusted, " cache key gaps");
	out
}
@end
