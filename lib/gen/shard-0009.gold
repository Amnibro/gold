kind: step
verb: swap
noun: cache
modifier: at_least
context: sort
phrase: swap cache values exceeding at least threshold {threshold}
phrase: exchange cached entries having value at least {threshold}
slot: threshold int
test: list=1,2 threshold=15
expect: => i=1 r=0.0 ok=true s="swapped 1 cache entries" errors=0 n=2 res=[1,2] cache=3 hits=0
test: list=3,4 threshold=50
expect: => i=0 r=0.0 ok=true s="swapped 0 cache entries" errors=0 n=2 res=[3,4] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	if g.cn == 0 {
		gold_cache_put(g, 1, 20);
		gold_cache_put(g, 2, 40);
		gold_cache_put(g, 3, 10);
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.cn {
		if g.cv[i] >= th && g.cv[i + 1] >= th {
			let tmp = g.cv[i];
			g.cv[i] = g.cv[i + 1];
			g.cv[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.cn;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " cache entries");
	out
}
@end
