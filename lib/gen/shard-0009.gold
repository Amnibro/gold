fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var groups = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		if !${cond}(g.res[i]) { break; }
		groups++;
		i = j;
	}
	g.steps += i;
	out.i = groups;
	out.s.clear();
	format(out.s, "grouped ", groups, " streaks");
	out
}
