	var u_cnt = 0;
	var d_cnt = 0;
	for i in g.n {
		var is_first = true;
		for j in 0..i {
			if g.res[j] == g.res[i] { is_first = false; break; }
		}
		if is_first {
			temp[u_cnt] = g.res[i];
			u_cnt++;
		}
	}
	for i in g.n {
		var is_first = true;
		for j in 0..i {
			if g.res[j] == g.res[i] { is_first = false; break; }
		}
		if !is_first {
			temp[u_cnt + d_cnt] = g.res[i];
			d_cnt++;
		}
	}
	for k in g.n { g.res[k] = temp[k]; }
	g.steps += g.n * g.n;
	out.i = d_cnt;
	out.s.clear();
	format(out.s, "split ", d_cnt, " duplicates");
	out
}
@end
