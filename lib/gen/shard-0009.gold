	let thresh = ${cutoff};
	out.s.clear();
	out.s.append("kept: [");
	var kept = 0;
	var first = true;
	for i in g.n {
		if g.res[i] >= thresh {
			if !first { out.s.append(", "); }
			format(out.s, g.res[i]);
			first = false;
			kept++;
		}
	}
	out.s.append("]");
	out.i = kept;
	g.steps += g.n;
	out
}
