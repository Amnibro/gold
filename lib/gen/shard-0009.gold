phrase: aggregate repeated runs in sequence
test: list=2,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="grouped runs count 3" errors=0 n=3 res=[2,3,1] cache=0 hits=0
test: list=1,1,1,2,5,5
expect: => i=3 r=0.0 ok=true s="grouped runs count 3" errors=0 n=3 res=[3,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var run_counts int[512] = [0; 512];
	var rn = 0;
	var cur = g.res[0];
	var count = 1;
	for k in 1..g.n {
		if g.res[k] == cur {
			count++;
		} else {
			run_counts[rn] = count;
			rn++;
			cur = g.res[k];
			count = 1;
		}
	}
	run_counts[rn] = count;
	rn++;
	gold_clear(g);
	for k in rn { gold_push(g, run_counts[k]); }
	g.steps += g.n;
	out.i = rn;
	out.s.clear();
	format(out.s, "grouped runs count ", rn);
	out
}
@end
