code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sums: int[64] = [0; 64];
	var sn = 0;
	var i = 0;
	while i + 1 < g.n {
		if sn < 64 {
			sums[sn] = g.res[i] + g.res[i + 1];
			sn++;
		}
		i += 2;
	}
	gold_clear(g);
	for k in sn { gold_push(g, sums[k]); }
	g.steps += g.n;
	out.i = sn;
	out.s.clear();
	format(out.s, "summed ", sn, " pairwise series elements");
	out
}
@end
