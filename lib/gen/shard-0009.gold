@entry 4e51c92071284ed0
kind: step
verb: fold
noun: item
modifier: unique
context: search
phrase: fold unique search items with multiplier {factor}
phrase: aggregate distinct search items using factor {factor}
slot: factor int
test: list=2,2,3,4,4 factor=3
expect: => i=27 r=0.0 ok=true s="folded unique item sum is 27" errors=0 n=5 res=[2,2,3,4,4] cache=0 hits=0
test: list=10,10,20 factor=2
expect: => i=60 r=0.0 ok=true s="folded unique item sum is 60" errors=0 n=3 res=[10,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var unique_sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in 0..i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			unique_sum += x;
		}
	}
	let result = unique_sum * f;
	g.steps += g.n;
	out.i = result;
	out.s.clear();
	format(out.s, "folded unique item sum is ", result);
	out
}
@end
