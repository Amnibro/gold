@entry 2a04c9b0a0c6fe05
kind: step
verb: collect
noun: primes
modifier: running
context: error
phrase: collect primes running filter
phrase: gather prime values running scan
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="collected 4 prime numbers" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="error: zero primes" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes int[512] = [0; 512];
	var np = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				primes[np] = x;
				np++;
			}
		}
	}
	if np == 0 {
		gold_fail(g, "no primes found");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: zero primes");
		return out;
	}
	for k in np { g.res[k] = primes[k]; }
	g.n = np;
	g.steps += g.n;
	out.i = np;
	out.s.clear();
	format(out.s, "collected ", np, " prime numbers");
	out
}
@end
