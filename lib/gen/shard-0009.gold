noun: head
modifier: between
context: cache
phrase: trace head cache keys between range {low} to {high}
phrase: log leading cache keys between limits {low} to {high}
phrase: record head cache keys between bounds {low} to {high}
slot: low int
slot: high int
test: list=5,15,25,35 low=10 high=30
expect: => i=1 r=0.0 ok=true s="head cache keys in range 1" errors=0 n=4 res=[5,15,25,35] cache=4 hits=0
