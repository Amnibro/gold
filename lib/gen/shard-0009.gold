@entry 29d1a2f871d86e67
kind: step
verb: validate
noun: streak
modifier: at_least
context: sort
phrase: validate sorted duplicate streak of at least {min_streak}
phrase: verify sorted streak length is at least {min_streak}
phrase: check identical sorted streak at least {min_streak}
slot: min_streak int
test: list=10,20,20,20,30 min_streak=3
expect: => i=3 r=0.0 ok=true s="streak length valid" errors=0 n=5 res=[10,20,20,20,30] cache=0 hits=0
test: list=5,10,10,15 min_streak=3
expect: => i=2 r=0.0 ok=false s="streak length invalid" errors=1 n=4 res=[5,10,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_streak};
	var max_streak = 0;
	if g.n > 0 {
		var cur = 1;
		max_streak = 1;
		for k in 1..g.n {
			if g.res[k] == g.res[k - 1] {
				cur++;
				if cur > max_streak { max_streak = cur; }
			} else {
				cur = 1;
			}
		}
	}
	g.steps += g.n;
	let valid = max_streak >= req;
	out.ok = valid;
	out.i = max_streak;
	if valid {
		gold_text(out, "streak length valid");
	} else {
		gold_fail(g, "streak below required length");
		gold_text(out, "streak length invalid");
	}
	out
}
@end
