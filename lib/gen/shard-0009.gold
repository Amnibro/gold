fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for idx in g.n {
		let val = g.res[idx];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val { freq++; }
		}
		if freq >= 2 {
			g.res[kept] = val;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "nested tally count: ", kept);
	out
}
@end
