@entry 34a4269521bc9615
kind: step
verb: apply
noun: window
modifier: every_other
context: loop
phrase: apply window every other stride {size}
phrase: stride window every other block {size}
slot: size int
test: list=1,2,3,4,5,6 size=2
expect: => i=2 r=0.0 ok=true s="applied window every other stride 2" errors=0 n=6 res=[2,3,3,4,6,7] cache=0 hits=0
