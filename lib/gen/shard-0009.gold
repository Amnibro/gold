fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inv = 0;
	if g.n > 1 {
		for i in g.n {
			for j in (i + 1)..g.n {
				if g.res[i] > g.res[j] { inv++; }
			}
		}
	}
	g.steps += g.n * g.n;
	out.i = inv;
	out.s.clear();
	format(out.s, "nested loop inversion rank ", inv);
	out
}
