	var all_pos = true;
	if g.n > 2 {
		for i in 1..(g.n - 1) {
			if g.res[i] < 0 {
				all_pos = false;
				break;
			}
		}
	} else if g.n > 0 {
		all_pos = (g.res[0] >= 0);
	}
	out.ok = all_pos;
	out.s.clear();
	format(out.s, "middle positive: ", all_pos);
	out.i = if all_pos { 1 } else { 0 };
	g.steps += g.n;
	out
}
