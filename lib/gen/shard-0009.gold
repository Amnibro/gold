test: text="cache memory fast"
expect: => i=15 r=0.0 ok=true s="total reverse word length 15" errors=0 n=0 res=[] cache=1 hits=0
test: text="hit miss"
expect: => i=7 r=0.0 ok=true s="total reverse word length 7" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total_len = 0;
	var cur = 0;
	var i = out.s.len - 1;
	while i >= 0 {
		if out.s[i] == ' ' {
			total_len += cur;
			cur = 0;
		} else {
			cur++;
		}
		i--;
	}
	total_len += cur;
	gold_cache_put(g, 0, total_len);
	g.steps += out.s.len;
	out.i = total_len;
	out.s.clear();
	format(out.s, "total reverse word length ", total_len);
	out
}
@end
