	var orig byte[..200] = "";
	orig.append(out.s);
	out.s.clear();
	for k in t {
		if out.s.len + orig.len <= 200 {
			out.s.append(orig);
		}
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
