code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	if c <= 0 {
		gold_fail(g, "nonpositive tail count");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry positive count");
		return out;
	}
	let lim = if c < g.n { c } else { g.n };
	let start = g.n - lim;
	var sum = 0;
	for i in lim {
		g.res[i] = g.res[start + i];
		sum += g.res[i];
	}
	g.n = lim;
	g.steps += lim;
	out.i = sum;
	out.s.clear();
	format(out.s, "running tail sum ", sum);
	out
}
@end
