kind: step
verb: fill
noun: step
modifier: any
context: error
phrase: fill step any matching {p} with {val}
phrase: replace any step satisfying {p} with {val}
slot: p pred
slot: val int
test: list=1,2,3 p=is_even val=9
expect: => i=1 r=0.0 ok=true s="filled 1 matching elements" errors=0 n=3 res=[1,9,3] cache=0 hits=0
