fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var min_idx = 0;
	for i in g.n {
		if g.res[i] < g.res[min_idx] { min_idx = i; }
	}
	let min_val = g.res[min_idx];
	var i = min_idx;
	while i + 1 < g.n {
		g.res[i] = g.res[i + 1];
		i++;
	}
	g.res[g.n - 1] = min_val;
	g.steps += g.n;
	out.i = min_val;
	out.s.clear();
	format(out.s, "minimum last ", min_val);
	out
}
@end
