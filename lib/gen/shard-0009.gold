code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items to shift");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry with more elements");
		return out;
	}
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = last;
	out.s.clear();
	format(out.s, "shifted last item ", last, " to front");
	out
}
@end
