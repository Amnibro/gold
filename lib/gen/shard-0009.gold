code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var run_sum = 0;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		run_sum += x;
		let avg = run_sum / (i + 1);
		if x >= avg {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "selected running average count ", kept);
	out
}
@end
