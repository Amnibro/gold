code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var write = 1;
		for i in 1..g.n {
			if i % 2 == 1 && g.res[i] == g.res[i - 1] {
				continue;
			}
			g.res[write] = g.res[i];
			write++;
		}
		g.n = write;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "deduped alternate search range ", g.n);
	out
}
@end
