fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	var pair_idx = -1;
	var i = 0;
	while i + 1 < g.n {
		if ${p}(g.res[i]) && ${p}(g.res[i + 1]) {
			found = true;
			pair_idx = i;
			break;
		}
		i++;
	}
	if !found {
		gold_fail(g, "pair condition never met");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry pair search");
		return out;
	}
	g.steps += g.n;
	out.i = pair_idx;
	out.s.clear();
	format(out.s, "found matching pair at index ", pair_idx);
	out
}
@end
