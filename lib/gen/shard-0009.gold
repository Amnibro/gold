@entry 419ebcbe70e024a1
kind: step
verb: dedupe
noun: maximum
modifier: last
context: text
phrase: dedupe maximum character occurrences keeping only last
phrase: remove duplicate occurrences of peak character before last
test: text="banana"
expect: => i=1 r=0.0 ok=true s="baana" errors=0 n=0 res=[] cache=0 hits=0
test: text="abaca"
expect: => i=0 r=0.0 ok=true s="abaca" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len <= 1 { return out; }
	var max_c = out.s[0];
	for i in 1..out.s.len {
		if out.s[i] > max_c { max_c = out.s[i]; }
	}
	var last_idx = -1;
	for i in out.s.len {
		if out.s[i] == max_c { last_idx = i; }
	}
	var res byte[..200] = "";
	var removed = 0;
	for i in out.s.len {
		if out.s[i] == max_c && i != last_idx {
			removed++;
		} else {
			res.push(out.s[i]);
		}
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	g.steps += out.s.len;
	out.i = removed;
	out
}
@end
