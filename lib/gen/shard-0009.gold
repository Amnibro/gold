@entry 587f3e52a52b28bc
kind: step
verb: reverse
noun: maximum
modifier: unique
context: sort
phrase: reverse sorted list up to index of maximum unique element
phrase: invert prefix leading to greatest distinct sorted value
test: list=1,3,5,2,4
expect: => i=2 r=0.0 ok=true s="reversed prefix of length 3" errors=0 n=5 res=[5,3,1,2,4] cache=0 hits=0
test: list=10,30,20,5
expect: => i=1 r=0.0 ok=true s="reversed prefix of length 2" errors=0 n=4 res=[30,10,20,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val {
			max_val = g.res[k];
			max_idx = k;
		}
	}
	var left = 0;
	var right = max_idx;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += max_idx + 1;
	out.i = max_idx;
	out.s.clear();
	format(out.s, "reversed prefix of length ", max_idx + 1);
	out
}
@end
@entry 9b516d3e302248b1
kind: step
verb: repeat
noun: cache
modifier: at_least
context: sort
phrase: repeat caching sorted entries with count at least {min_count}
phrase: store sorted values occurring at least {min_count} times in cache
slot: min_count int
test: list=2,2,3,4,4,4 min_count=2
expect: => i=2 r=0.0 ok=true s="cached 2 frequent sorted values" errors=0 n=6 res=[2,2,3,4,4,4] cache=2 hits=0
test: list=5,6,7,7,7,7 min_count=3
expect: => i=1 r=0.0 ok=true s="cached 1 frequent sorted values" errors=0 n=6 res=[5,6,7,7,7,7] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var cached = 0;
	var i = 0;
	while i < g.n {
		var j = i;
		while j < g.n && g.res[j] == g.res[i] { j++; }
		let run_len = j - i;
		if run_len >= mc {
			gold_cache_put(g, g.res[i], run_len);
			cached++;
		}
		i = j;
	}
	g.steps += g.n;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " frequent sorted values");
	out
}
@end
