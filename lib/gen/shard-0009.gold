	for k in g.n {
		if g.res[k] == target { matches_count++; }
		g.steps++;
	}
	let total_scaled = matches_count * rep;
	out.i = total_scaled;
	out.s.clear();
	format(out.s, "target count multiplied gives ", total_scaled);
	out
}
@end
