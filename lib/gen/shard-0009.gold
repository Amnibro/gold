@entry 243456c106c790b7
kind: step
verb: swap
noun: sequence
modifier: until
context: format
phrase: format swap sequence until value reaches {stop_val}
phrase: render swapped sequence until item exceeds {stop_val}
slot: stop_val int
test: list=1,2,3,4 stop_val=3
expect: => i=2 r=0.0 ok=true s="swapped seq: [2, 1, 4, 3]" errors=0 n=4 res=[2,1,4,3] cache=0 hits=0
test: list=5,6 stop_val=2
expect: => i=1 r=0.0 ok=true s="swapped seq: [6, 5]" errors=0 n=2 res=[6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let stop = ${stop_val};
	var swaps = 0;
	if g.n > 1 {
		var i = 0;
		while i + 1 < g.n {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			if g.res[i] >= stop || g.res[i + 1] >= stop { break; }
			i += 2;
		}
	}
	out.s.clear();
	out.s.append("swapped seq: [");
	for i in g.n {
		if i > 0 { out.s.append(", "); }
		format(out.s, g.res[i]);
	}
	out.s.append("]");
	out.i = swaps;
	g.steps += swaps * 2;
	out
}
@end
