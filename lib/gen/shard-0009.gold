@entry 92aa37578cb803fe
kind: step
verb: split
noun: budget
modifier: until
context: retry
phrase: split retry budget until exhausted {cost}
phrase: consume retry budget allocations until {cost}
slot: cost int
test: list=10,20,30 input=45 cost=15
expect: => i=0 r=0.0 ok=true s="budget split count: 3" errors=0 n=6 res=[10,20,30,15,15,15] cache=0 hits=0
test: list=5 input=10 cost=20
expect: => i=10 r=0.0 ok=true s="budget split count: 0" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fee = ${cost};
	var rem = out.i;
	var used = 0;
	while rem >= fee && g.n < 512 {
		rem -= fee;
		gold_push(g, fee);
		used++;
	}
	g.steps += used;
	out.i = rem;
	out.s.clear();
	format(out.s, "budget split count: ", used);
	out
}
@end
