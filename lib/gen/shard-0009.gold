@entry 42b5c9df5c48eac1
kind: step
verb: validate
noun: item
modifier: with_cache
context: sort
phrase: validate sort item with cache lookup at index {idx}
phrase: check sort element presence with cache at {idx}
phrase: verify sort item with cache lookup at {idx}
slot: idx int
test: list=10,20,30 idx=1
expect: => i=1 r=0.0 ok=true s="item verified in cache" errors=0 n=3 res=[10,20,30] cache=3 hits=1
test: list=5,15,25 idx=0
expect: => i=1 r=0.0 ok=true s="item verified in cache" errors=0 n=3 res=[5,15,25] cache=3 hits=1
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n { gold_cache_put(g, g.res[k], k); }
	let index = ${idx};
	var valid = false;
	if index >= 0 && index < g.n {
		let key = g.res[index];
		let val, ok = gold_cache_get(g, key);
		if ok && val == index { valid = true; }
	}
	g.steps += g.n;
	out.ok = valid;
	out.i = if valid { 1 } else { 0 };
	if valid {
		gold_text(out, "item verified in cache");
	} else {
		gold_fail(g, "cache verification failed");
		gold_text(out, "item missing in cache");
	}
	out
}
@end
@entry 1876660c4abdc86e
kind: step
verb: trace
noun: minimum
modifier: pairwise
context: sort
phrase: trace minimum pairwise difference across sorted items
phrase: find smallest gap between adjacent sorted elements
phrase: measure minimum pairwise sorted spacing
test: list=10,18,22,35
expect: => i=4 r=0.0 ok=true s="minimum pairwise gap 4" errors=0 n=4 res=[10,18,22,35] cache=0 hits=0
test: list=5,15,20,32
expect: => i=5 r=0.0 ok=true s="minimum pairwise gap 5" errors=0 n=4 res=[5,15,20,32] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_gap = -1;
	if g.n > 1 {
		min_gap = g.res[1] - g.res[0];
		for k in 1..(g.n - 1) {
			let gap = g.res[k + 1] - g.res[k];
			if gap < min_gap { min_gap = gap; }
		}
	}
	g.steps += g.n;
	out.i = min_gap;
	out.s.clear();
	format(out.s, "minimum pairwise gap ", min_gap);
	out
}
@end
