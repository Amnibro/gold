phrase: remove cache values above limit {cap} safely
phrase: purge cached elements beyond threshold {cap} safely
slot: cap int
test: list=50,120,80 cap=100
expect: => i=1 r=0.0 ok=true s="safely dropped 1 cache items" errors=0 n=3 res=[50,120,80] cache=2 hits=0
test: list=30,90,40 cap=50
expect: => i=1 r=0.0 ok=true s="safely dropped 1 cache items" errors=0 n=3 res=[30,90,40] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var kept = 0;
	for i in g.cn {
		if g.cv[i] <= limit {
			g.ck[kept] = g.ck[i];
			g.cv[kept] = g.cv[i];
			kept++;
		}
	}
	let dropped = g.cn - kept;
	g.cn = kept;
	g.steps += g.cn;
	out.i = dropped;
	out.s.clear();
	format(out.s, "safely dropped ", dropped, " cache items");
	out
}
@end
