@entry abc6b82ec7c7f66f
kind: step
verb: scale
noun: primes
modifier: while
context: format
phrase: format scale primes while counting primes
phrase: render prime values count formatted view
test: list=2,3,4,5
expect: => i=3 r=0.0 ok=true s="primes count: 3" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="primes count: 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { primes++; }
		}
	}
	out.s.clear();
	format(out.s, "primes count: ", primes);
	out.i = primes;
	g.steps += g.n;
	out
}
@end
@entry ab274a4f83661a4a
kind: step
verb: scale
noun: primes
modifier: any
context: format
phrase: format scale primes any factor {multiplier}
phrase: render scaled results when any prime {multiplier}
slot: multiplier int
test: list=3,4 multiplier=2
expect: => i=1 r=0.0 ok=true s="prime scaled: true" errors=0 n=2 res=[6,8] cache=0 hits=0
test: list=4,6 multiplier=2
expect: => i=0 r=0.0 ok=true s="prime scaled: false" errors=0 n=2 res=[4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${multiplier};
	var has_prime = false;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p { has_prime = true; break; }
		}
	}
	if has_prime {
		for i in g.n { g.res[i] *= m; }
	}
	out.s.clear();
	format(out.s, "prime scaled: ", has_prime);
	out.i = if has_prime { 1 } else { 0 };
	g.steps += g.n;
	out
}
@end
