expect: => i=1 r=0.0 ok=true s="scanned middle 1 items" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if m < 0 || 2 * m >= g.n {
		gold_clear(g);
		out.i = 0;
		out.s.clear();
		format(out.s, "trimmed all items");
		return out;
	}
	let new_len = g.n - 2 * m;
	for i in new_len {
		g.res[i] = g.res[m + i];
	}
	g.n = new_len;
	g.steps += g.n;
	out.i = new_len;
	out.s.clear();
	format(out.s, "scanned middle ", new_len, " items");
	out
}
@end
