@entry 31c0d5262d152997
kind: step
verb: validate
noun: tally
modifier: first
context: text
phrase: validate letter tally within first {k} items reaches {min_tally}
phrase: verify initial {k} characters contain at least {min_tally} letters
slot: k int
slot: min_tally int
test: text="a1b2c3" k=4 min_tally=2
expect: => i=2 r=0.0 ok=true s="validated tally of 2 letters in first 4 chars" errors=0 n=0 res=[] cache=0 hits=0
test: text="1234" k=4 min_tally=1
expect: => i=0 r=0.0 ok=false s="letter tally 0 below requirement 1" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${k};
	let req = ${min_tally};
	let count = if limit > out.s.len { out.s.len } else if limit < 0 { 0 } else { limit };
	var tally = 0;
	for i in count {
		let c = out.s[i] as int;
		let is_letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
		if is_letter { tally++; }
	}
	g.steps += count;
	out.i = tally;
	out.s.clear();
	if tally >= req {
		out.ok = true;
		format(out.s, "validated tally of ", tally, " letters in first ", count, " chars");
	} else {
		gold_fail(g, "insufficient letter tally");
		out.ok = false;
		format(out.s, "letter tally ", tally, " below requirement ", req);
	}
	out
}
@end
