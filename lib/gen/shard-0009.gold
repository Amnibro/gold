code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		let m = g.n - 1;
		for i in m / 2 {
			let j = m - 1 - i;
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
		}
	}
	out.s.clear();
	format(out.s, "prefix reversed: ", g.n);
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
