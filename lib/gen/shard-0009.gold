@entry 879f042d7963f288
kind: step
verb: search
noun: histogram
modifier: in_reverse
context: list
phrase: search most frequent histogram value in reverse
phrase: find peak frequency item scanning in reverse order
test: list=2,5,3,5,2,2
expect: => i=2 r=0.0 ok=true s="peak frequency value 2 found" errors=0 n=6 res=[2,5,3,5,2,2] cache=0 hits=0
test: list=10,20,20,10
expect: => i=10 r=0.0 ok=true s="peak frequency value 10 found" errors=0 n=4 res=[10,20,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty histogram search");
		return out;
	}
	var best_val = g.res[g.n - 1];
	var max_c = 0;
	for i in g.n {
		let x = g.res[g.n - 1 - i];
		var c = 0;
		for j in g.n {
			if g.res[j] == x { c++; }
		}
		if c > max_c {
			max_c = c;
			best_val = x;
		}
	}
	g.steps += g.n * g.n;
	out.i = best_val;
	out.s.clear();
	format(out.s, "peak frequency value ", best_val, " found");
	out
}
@end
@entry f186c538cf7fd4f1
kind: step
verb: rotate
noun: text
modifier: with_retry
context: list
phrase: rotate list elements by {shift} with retry fallback
phrase: shift sequence by offset {shift} using retry
slot: shift int
test: list=10,20,30,40 shift=1
expect: => i=1 r=0.0 ok=true s="rotated sequence by 1 offsets" errors=0 n=4 res=[40,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5 shift=8
expect: => i=2 r=0.0 ok=true s="retry rotated sequence by 2 offsets" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var s = ${shift};
	var retried = false;
	if s >= g.n {
		s = s / 4;
		retried = true;
	}
	let off = (s % g.n + g.n) % g.n;
	var tmp int[512] = [0; 512];
	for i in g.n { tmp[i] = g.res[i]; }
	for i in g.n {
		let d = (i + off) % g.n;
		g.res[d] = tmp[i];
	}
	g.steps += g.n * 2;
	out.i = off;
	out.s.clear();
	if retried {
		format(out.s, "retry rotated sequence by ", off, " offsets");
	} else {
		format(out.s, "rotated sequence by ", off, " offsets");
	}
	out
}
@end
@entry 35bcfcb061e572fa
kind: step
verb: fold
noun: window
modifier: while
context: list
phrase: fold window sums of size {win} while below cap {cap}
phrase: accumulate window blocks of {win} while under {cap}
slot: win int
slot: cap int
test: list=2,3,5,10,50 win=2 cap=15
expect: => i=2 r=0.0 ok=true s="folded 2 windows while under cap" errors=0 n=2 res=[5,8] cache=0 hits=0
test: list=10,20 win=2 cap=15
expect: => i=0 r=0.0 ok=true s="folded 0 windows while under cap" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win};
	let limit = ${cap};
	var kept = 0;
	var tmp int[512] = [0; 512];
	if w > 0 && g.n >= w {
		for i in g.n - w + 1 {
			var sum = 0;
			for k in w { sum += g.res[i + k]; }
			if sum >= limit { break; }
			tmp[kept] = sum;
			kept++;
		}
	}
	gold_clear(g);
	for i in kept { gold_push(g, tmp[i]); }
	g.steps += g.n + 1;
	out.i = kept;
	out.s.clear();
	format(out.s, "folded ", kept, " windows while under cap");
	out
}
@end
