	var write_idx = 1;
	var removed = 0;
	for i in 1..(g.n - 1) {
		if g.res[i] != t {
			g.res[write_idx] = g.res[i];
			write_idx++;
		} else {
			removed++;
		}
	}
	g.res[write_idx] = g.res[g.n - 1];
	g.n = write_idx + 1;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered ", removed, " middle values");
	out
}
@end
