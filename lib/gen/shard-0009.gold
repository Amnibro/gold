expect: => i=10 r=0.0 ok=true s="normalized to maximum scale 50" errors=0 n=4 res=[10,25,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if g.n == 0 || lim <= 0 { return out; }
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
		g.steps++;
	}
	if max_val > 0 {
		for k in g.n {
			g.res[k] = (g.res[k] * lim) / max_val;
			g.steps++;
		}
	}
	out.i = max_val;
	out.s.clear();
	format(out.s, "normalized to maximum scale ", lim);
	out
}
@end
