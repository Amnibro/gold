code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var min_val = 999999;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if !${p}(x) {
			break;
		}
		if !found || x < min_val {
			min_val = x;
			found = true;
		}
	}
	g.steps += g.n;
	if found {
		out.i = min_val;
		out.s.clear();
		format(out.s, "minimum found while matching is ", min_val);
	} else {
		out.i = -1;
		out.s.clear();
		format(out.s, "no items matched predicate");
	}
	out
}
@end
