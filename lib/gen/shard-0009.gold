code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var ok = false;
	var span = 0;
	if g.n > 0 {
		var mn = g.res[0];
		var mx = g.res[0];
		for i in 1..g.n {
			if g.res[i] < mn { mn = g.res[i]; }
			if g.res[i] > mx { mx = g.res[i]; }
		}
		span = mx - mn;
		ok = (span <= lim);
	}
	out.ok = ok;
	out.s.clear();
	format(out.s, "range span: ", span);
	out.i = span;
	g.steps += g.n;
	out
}
@end
