fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_len};
	var words byte[..16][>..] = [];
	var cur byte[..16] = "";
	for k in out.s.len {
		let c = out.s[k];
		if c != ' ' {
			if cur.len < 16 { cur.push(c); }
