@entry 8239e256a722a08b
kind: step
verb: rotate
noun: primes
modifier: at_least
context: search
phrase: rotate search hits until prime at least {min_p}
phrase: cycle search ranks to prime at least {min_p}
phrase: shift search results until prime at least {min_p}
slot: min_p int
test: list=4,6,7,9,11 min_p=5
expect: => i=2 r=0.0 ok=true s="rotated prime hit at 2" errors=0 n=5 res=[7,9,11,4,6] cache=0 hits=0
test: list=8,9,10,13,15 min_p=11
expect: => i=3 r=0.0 ok=true s="rotated prime hit at 3" errors=0 n=5 res=[13,15,8,9,10] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${min_p};
	var idx = -1;
	for k in g.n {
		if ${ID}_is_prime(g.res[k]) && g.res[k] >= target {
			idx = k;
			break;
		}
	}
	if idx > 0 {
		var tmp int[512] = [0; 512];
		for k in g.n { tmp[k] = g.res[(k + idx) % g.n]; }
		for k in g.n { g.res[k] = tmp[k]; }
	}
	g.steps += g.n;
	out.i = idx;
	out.s.clear();
	format(out.s, "rotated prime hit at ", idx);
	out
}
@end
