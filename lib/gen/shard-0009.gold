code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need two points for gaps");
		out.ok = false;
		return out;
	}
	for k in (g.n - 1) {
		var diff = g.res[k + 1] - g.res[k];
		if diff < 0 { diff = -diff; }
		g.res[k] = diff;
	}
	g.n--;
	out.i = g.n;
	g.steps += g.n;
	out
}
@end
