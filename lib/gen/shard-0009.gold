code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two histogram bins to merge");
		out.ok = false;
		return out;
	}
	let m = g.n / 2;
	for k in m {
		g.res[k] = g.res[k * 2] + g.res[k * 2 + 1];
	}
	g.n = m;
	out.i = m;
	g.steps += m;
	out
}
@end
