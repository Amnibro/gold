fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low};
	let hi = ${high};
	var cached = 0;
	var i = lo;
	while i <= hi && i < g.n {
		if i >= 0 {
			gold_cache_put(g, i, g.res[i]);
			cached++;
		}
		i++;
	}
	g.steps += cached;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached history between interval ", cached);
	out
}
@end
