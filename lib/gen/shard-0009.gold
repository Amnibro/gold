fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_val = g.res[0];
	var best_freq = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq > best_freq {
			best_freq = freq;
			best_val = x;
		}
	}
	g.steps += g.n * g.n;
	out.i = best_val;
	out.s.clear();
	format(out.s, "histogram mode ", best_val);
	out
}
