code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r_limit = ${retries};
	var attempts = 0;
	var valid = false;
	var final_val = 0;
	for k in g.n {
		if attempts >= r_limit { break; }
		let val = ${f}(g.res[k]);
		attempts++;
		if val > 0 {
			valid = true;
			final_val = val;
			break;
		}
	}
	g.steps += attempts;
	out.ok = valid;
	out.i = final_val;
	out.s.clear();
	if valid {
		format(out.s, "validated in ", attempts, " attempts");
	} else {
		out.s.append("validation failed");
	}
	out
}
@end
