fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${len};
	var total = 0;
	let count = if g.n > k { k } else { g.n };
	let start = g.n - count;
	for i in count {
		total += g.res[start + i];
	}
	out.i = total;
	g.steps += count + 1;
	out.s.clear();
	format(out.s, "sum all suffix values ", total);
	out
}
