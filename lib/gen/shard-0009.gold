fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var ok = false;
	if g.n > 0 {
		var mn = g.res[0];
		for i in 1..g.n {
			if g.res[i] < mn { mn = g.res[i]; }
		}
		ok = (mn >= thresh);
		out.i = mn;
	} else {
		out.i = 0;
	}
	out.ok = ok;
	out.s.clear();
	format(out.s, "min check: ", ok);
	g.steps += g.n;
	out
}
@end
