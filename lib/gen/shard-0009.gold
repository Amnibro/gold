fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len < 2 {
		gold_fail(g, "insufficient text for pairwise swap");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: short text");
		return out;
	}
	var i = 0;
	while i + 1 < out.s.len {
		let tmp = out.s[i];
		out.s[i] = out.s[i + 1];
		out.s[i + 1] = tmp;
		i += 2;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
