	var freq = [0; 10];
	for i in g.n {
		let x = g.res[i];
		if x >= 0 && x < 10 { freq[x]++; }
	}
	out.s.clear();
	out.s.append("hist: [");
	var total_pos = 0;
	for d in 10 {
