@entry 4e9ce798bc00c597
kind: step
verb: pair
noun: suffix
modifier: nested
context: sort
phrase: pair suffix nested entries with span {span}
phrase: fold suffix nested pairs using span {span}
slot: span int
test: list=1,2,3,4,5,6 span=4
expect: => i=2 r=0.0 ok=true s="paired 2 nested suffix items" errors=0 n=4 res=[1,2,9,9] cache=0 hits=0
test: list=10,20,30,40,50 span=2
expect: => i=1 r=0.0 ok=true s="paired 1 nested suffix items" errors=0 n=4 res=[10,20,30,90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${span};
	let actual_span = if s > g.n { g.n } else { if s < 0 { 0 } else { s } };
	let start = g.n - actual_span;
	let half = actual_span / 2;
	for i in half {
		let a = start + i;
		let b = g.n - 1 - i;
		g.res[a] = g.res[a] + g.res[b];
	}
	g.n = g.n - half;
	g.steps += actual_span;
	out.i = half;
	out.s.clear();
	format(out.s, "paired ", half, " nested suffix items");
	out
}
@end
@entry 1ae5d51dd569bcd1
