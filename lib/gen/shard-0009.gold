fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		for j in 0..(g.n - 1 - i) {
			if g.res[j] > g.res[j + 1] {
				let t = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = t;
			}
			g.steps++;
		}
	}
	out.s.clear();
	out.s.append("<");
	for k in g.n {
		if k > 0 { out.s.append(" "); }
		format(out.s, g.res[k]);
	}
	out.s.append(">");
	out.i = g.n;
	out
}
@end
@entry faad66231ffccbea
kind: step
verb: normalize
noun: range
modifier: times
context: core
phrase: normalize range times factor {factor}
phrase: rescale elements over range by factor {factor}
slot: factor int
test: list=10,20,30 factor=2
expect: => i=20 r=0.0 ok=true s="normalized range span 20" errors=0 n=3 res=[0,20,40] cache=0 hits=0
test: list=5,15 factor=3
expect: => i=10 r=0.0 ok=true s="normalized range span 10" errors=0 n=2 res=[0,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${factor};
	if g.n == 0 {
		gold_push(g, mult);
		out.i = mult;
		return out;
	}
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		if g.res[i] < min_val { min_val = g.res[i]; }
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	let span = max_val - min_val;
	for i in g.n {
		g.res[i] = (g.res[i] - min_val) * mult;
	}
	out.i = span;
	g.steps += g.n;
	out.s.clear();
	format(out.s, "normalized range span ", span);
	out
}
@end
