kind: step
verb: fold
noun: middle
modifier: first
context: math
phrase: fold middle first take {take} entries
phrase: reduce middle first window {take} values
slot: take int
test: list=1,5,10,15,20 take=2
expect: => i=15 r=0.0 ok=true s="folded middle prefix sum is 15" errors=0 n=4 res=[1,15,15,20] cache=0 hits=0
test: list=10,20,30,40 take=1
expect: => i=20 r=0.0 ok=true s="folded middle prefix sum is 20" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${take};
	if g.n <= 2 || k <= 0 {
		out.i = 0;
		return out;
	}
	var mid_end = 1 + k;
	if mid_end > g.n - 1 { mid_end = g.n - 1; }
	var sum = 0;
	for i in 1..mid_end {
		sum += g.res[i];
	}
	g.res[1] = sum;
	var w = 2;
	for i in mid_end..g.n {
		g.res[w] = g.res[i];
		w++;
	}
	g.n = w;
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded middle prefix sum is ", sum);
	out
}
@end
