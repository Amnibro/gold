context: stats
phrase: measure sample range over window size at most {max_win}
phrase: calculate observation spread using windows of at most {max_win}
slot: max_win int
test: list=10,25,5,40,15 max_win=3
expect: => i=35 r=0.0 ok=true s="maximum range at most window is 35" errors=0 n=5 res=[10,25,5,40,15] cache=0 hits=0
test: list=2,8,4,12,6 max_win=2
expect: => i=8 r=0.0 ok=true s="maximum range at most window is 8" errors=0 n=5 res=[2,8,4,12,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mw = ${max_win};
	if g.n == 0 || mw <= 0 {
		out.s.clear();
		out.s.append("empty dataset");
		return out;
	}
	var max_spread = 0;
	for i in g.n {
		let lim = if i + mw < g.n { i + mw } else { g.n };
		var cur_min = g.res[i];
		var cur_max = g.res[i];
		for j in i..lim {
			if g.res[j] < cur_min { cur_min = g.res[j]; }
			if g.res[j] > cur_max { cur_max = g.res[j]; }
			let spread = cur_max - cur_min;
			if spread > max_spread { max_spread = spread; }
		}
	}
	g.steps += g.n * mw;
	out.i = max_spread;
	out.s.clear();
	format(out.s, "maximum range at most window is ", max_spread);
	out
}
@end
