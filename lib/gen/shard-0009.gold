code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var x = g.res[0];
	var count = 0;
	while count < limit && x <= 0 {
		x = ${f}(x);
		count++;
	}
	g.res[0] = x;
	out.i = x;
	g.steps += count;
	out
}
@end
