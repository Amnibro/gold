kind: step
verb: group
noun: digits
modifier: at_least
context: retry
phrase: group digits at_least count threshold {k}
phrase: cluster digits at_least minimum size {k}
slot: k int
test: list=10,205,33,4000 k=2
expect: => i=4 r=0.0 ok=true s="grouped 4 numbers with at least 2 digits" errors=0 n=4 res=[10,205,33,4000] cache=0 hits=0
test: list=1,2,3 k=3
expect: => i=0 r=0.0 ok=false s="error: retry with smaller threshold" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_d = ${k};
	if min_d <= 0 {
		gold_fail(g, "invalid digit threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: nonpositive threshold");
		return out;
	}
	var kept = 0;
	for i in g.n {
		var x = g.res[i];
		if x < 0 { x = -x; }
		var digits = 0;
		while x > 0 {
			digits++;
			x /= 10;
		}
		if digits == 0 { digits = 1; }
		if digits >= min_d {
			g.res[kept] = g.res[i];
			kept++;
		}
	}
	if kept == 0 {
		gold_fail(g, "no items meeting digit requirement");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry with smaller threshold");
		return out;
	}
	g.n = kept;
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "grouped ", kept, " numbers with at least ", min_d, " digits");
	out
}
@end
