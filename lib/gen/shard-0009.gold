code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write_idx = 0;
	for i in g.n {
		var seen = false;
		for j in write_idx {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
		}
		if !seen {
			g.res[write_idx] = g.res[i];
			write_idx++;
		}
	}
	let removed = g.n - write_idx;
	g.n = write_idx;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "deduped list first removed ", removed);
	out
}
@end
