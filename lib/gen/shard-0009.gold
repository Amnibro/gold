test: list=30,10,20
expect: => i=3 r=0.0 ok=true s="sorted memo entries: 3" errors=0 n=3 res=[10,20,30] cache=3 hits=0
test: list=50,40
expect: => i=2 r=0.0 ok=true s="sorted memo entries: 2" errors=0 n=2 res=[40,50] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for idx in g.n {
		gold_cache_put(g, idx, g.res[idx]);
	}
	gold_clear(g);
	for idx in g.cn { gold_push(g, g.cv[idx]); }
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[b] < g.res[a] {
				let t = g.res[a]; g.res[a] = g.res[b]; g.res[b] = t;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted memo entries: ", g.n);
	out
}
@end
