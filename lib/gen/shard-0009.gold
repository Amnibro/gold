fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${diff};
	if g.n <= 1 {
		out.i = 0;
		return out;
	}
	var w = 1;
	for i in 1..g.n {
		var diff_val = g.res[i] - g.res[i - 1];
		if diff_val < 0 { diff_val = -diff_val; }
		if diff_val != d {
			g.res[w] = g.res[i];
			w++;
		}
	}
	let removed = g.n - w;
	g.n = w;
	g.steps += g.n;
	out.i = removed;
	out.s.clear();
	format(out.s, "filtered ", removed, " values by pairwise difference");
	out
}
@end
