fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${repeat_count};
	var splits = 0;
	var i = 1;
	while i < g.n && splits < rep {
		if g.res[i] != g.res[i - 1] {
			splits++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = splits;
	out.s.clear();
	format(out.s, "split ", splits, " search runs");
	out
}
