		var exists = false;
		for j in un {
			if uniq[j] == x { exists = true; break; }
		}
		if !exists {
			uniq[un] = x;
			un++;
		}
	}
	for i in un { g.res[i] = uniq[i]; }
	g.n = un;
	g.steps += g.n;
	out.i = un;
	out.s.clear();
	format(out.s, "unique search results ", un);
	out
}
@end
