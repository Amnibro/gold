fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen byte[256] = [0; 256];
	var u byte[..200] = [];
	for b in out.s {
		let idx = b as int;
		if idx >= 0 && idx < 256 {
			if seen[idx] == 0 {
				seen[idx] = 1;
				u.push(b);
			}
		}
	}
	out.s.clear();
	for b in u { out.s.push(b); }
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
