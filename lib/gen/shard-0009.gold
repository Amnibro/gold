@entry fe1f49e41066dbeb
kind: step
verb: check
noun: letters
modifier: in_place
context: format
phrase: check letters formatting uppercase in place
phrase: format alphabetic characters to uppercase in place
phrase: capitalize letters in place across text
test: text="hello world"
expect: => i=10 r=0.0 ok=true s="HELLO WORLD" errors=0 n=0 res=[] cache=0 hits=0
test: text="amni lang"
expect: => i=8 r=0.0 ok=true s="AMNI LANG" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	var res byte[..200] = "";
	for k in out.s.len {
		var c = out.s[k];
		if c >= 'a' && c <= 'z' {
			c = (c - 'a' + 'A') as byte;
			modified++;
		}
		if res.len < 200 { res.push(c); }
		g.steps++;
	}
	out.s.clear();
	for b in res { out.s.push(b); }
	out.i = modified;
	out
}
@end
