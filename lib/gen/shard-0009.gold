code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	var temp byte[..200] = "";
	for b in out.s {
		let is_v = (b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u');
		if is_v {
			for j in k {
				if temp.len < 200 { temp.push(b); }
			}
		} else {
			if temp.len < 200 { temp.push(b); }
		}
	}
	out.s.clear();
	out.s.append(temp);
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
