expect: => i=0 r=0.0 ok=true s="applied window every other stride 0" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	var applied = 0;
	var i = 0;
	while i + sz <= g.n {
		for j in sz {
			g.res[i + j] += 1;
		}
		applied++;
		i += sz * 2;
	}
	g.steps += applied;
	out.i = applied;
	out.s.clear();
	format(out.s, "applied window every other stride ", applied);
	out
}
@end
