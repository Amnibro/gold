fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup = false;
	var i = 0;
	while i < g.n && !dup {
		var j = i + 2;
		while j < g.n {
			if g.res[i] == g.res[j] { dup = true; break; }
			j += 2;
		}
		i += 2;
	}
	out.ok = !dup;
	out.i = if dup { 0 } else { 1 };
	g.steps += g.n;
	out
}
@end
