kind: step
verb: swap
noun: streak
modifier: in_place
context: stats
phrase: swap longest monotonic streak in place
phrase: reverse peak streak in place across observations
test: list=1,2,3,4,1,2
expect: => i=4 r=0.0 ok=true s="swapped streak length 4" errors=0 n=6 res=[4,3,2,1,1,2] cache=0 hits=0
test: list=5,1,2,3,0
expect: => i=3 r=0.0 ok=true s="swapped streak length 3" errors=0 n=5 res=[5,3,2,1,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.s.clear();
		out.s.append("streak too short");
		return out;
	}
	var best_start = 0;
	var best_len = 1;
	var cur_start = 0;
	var cur_len = 1;
	for k in 1..g.n {
		if g.res[k] > g.res[k - 1] {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_start = cur_start;
			}
		} else {
			cur_start = k;
			cur_len = 1;
		}
	}
	var l = best_start;
	var r = best_start + best_len - 1;
	while l < r {
		let tmp = g.res[l];
		g.res[l] = g.res[r];
		g.res[r] = tmp;
		l++;
		r--;
	}
	g.steps += g.n + best_len;
	out.i = best_len;
	out.s.clear();
	format(out.s, "swapped streak length ", best_len);
	out
}
@end
