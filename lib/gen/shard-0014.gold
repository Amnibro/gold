code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var even_idx: int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			even_idx[count] = i;
			count++;
		}
	}
	if count > 1 {
		for i in count {
			for j in (i + 1)..count {
				let idx_i = even_idx[i];
				let idx_j = even_idx[j];
				if g.res[idx_j] < g.res[idx_i] {
					let tmp = g.res[idx_i];
					g.res[idx_i] = g.res[idx_j];
					g.res[idx_j] = tmp;
				}
			}
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "sorted evens count: ", count);
	out
}
@end
