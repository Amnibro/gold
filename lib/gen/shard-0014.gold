fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start = ${start_idx};
	let s = if start < 0 { 0 } else if start >= g.n { g.n } else { start };
	var i = s;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let sorted_span = g.n - s;
	g.steps += g.n + sorted_span * sorted_span;
	out.i = sorted_span;
	out.s.clear();
	format(out.s, "sorted suffix elements count: ", sorted_span);
	out
}
