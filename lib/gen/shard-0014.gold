@entry a5475a01ead39774
kind: step
verb: normalize
noun: runs
modifier: running
context: loop
phrase: normalize run lengths calculating running differences
phrase: replace elements with running differences in loop
test: list=10,12,15,19
expect: => i=3 r=0.0 ok=true s="computed 3 running differences" errors=0 n=3 res=[2,3,4] cache=0 hits=0
test: list=10
expect: => i=0 r=0.0 ok=false s="error: need at least two items" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for running diffs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need at least two items");
		return out;
	}
	var diffs = [0; 512];
	var i = 0;
	while i + 1 < g.n {
		diffs[i] = g.res[i + 1] - g.res[i];
		i++;
	}
	let count = g.n - 1;
	for k in count {
		g.res[k] = diffs[k];
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "computed ", count, " running differences");
	out
}
@end
