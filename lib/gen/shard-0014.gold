@entry 75e2677117a9001d
kind: step
verb: sort
noun: loop
modifier: until
context: error
slot: max_passes int
phrase: sort loop until fully ordered bounded by {max_passes}
phrase: bubble sort loop until ordered within passes {max_passes}
test: list=4,2,3,1 max_passes=5
expect: => i=4 r=0.0 ok=true s="sorted loop within passes: 4" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=4,3,2,1 max_passes=1
expect: => i=0 r=0.0 ok=false s="error: sort passes exceeded without completion" errors=1 n=4 res=[3,2,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_passes};
	var pass = 0;
	while pass < mp {
		var swapped = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swapped = true;
			}
			i++;
		}
		pass++;
		if !swapped { break; }
	}
	var is_sorted = true;
	var k = 0;
	while k + 1 < g.n {
		if g.res[k] > g.res[k + 1] {
			is_sorted = false;
			break;
		}
		k++;
	}
	if !is_sorted {
		gold_fail(g, "sort passes exceeded without completion");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: sort passes exceeded without completion");
		return out;
	}
	g.steps += g.n * pass;
	out.i = pass;
	out.s.clear();
