phrase: rotate values in reverse by count {steps}
phrase: cyclically rotate values backward by {steps} positions
test: list=1,2,3,4,5 steps=2
expect: => i=2 r=0.0 ok=true s="rotated in reverse: 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=10,20,30 steps=1
expect: => i=1 r=0.0 ok=true s="rotated in reverse: 1" errors=0 n=3 res=[30,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let raw = ${steps};
		let shift = if raw < 0 { 0 } else { raw % g.n };
		for s in shift {
			let last = g.res[g.n - 1];
			var i = g.n - 1;
			while i > 0 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[0] = last;
		}
		out.i = shift;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated in reverse: ", out.i);
	out
}
@end
