slot: min_val int
test: list=10,20,30,40 min_val=22
expect: => i=2 r=0.0 ok=true s="items above average: 2" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,15,25 min_val=10
expect: => i=1 r=0.0 ok=true s="items above average: 1" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var sum = 0;
	for i in g.cn {
		sum += g.cv[i];
	}
	let avg = if g.cn > 0 { sum / g.cn } else { 0 };
	let floor = ${min_val};
	var count = 0;
	for i in g.cn {
		let val = g.cv[i];
		if val > avg && val >= floor {
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "items above average: ", count);
	out
}
@end
@entry 5056b4b4b0085954
kind: step
verb: reverse
noun: duplicates
modifier: first
context: cache
phrase: reverse initial duplicated cache cluster values
phrase: invert first duplicate group in cache
test: list=5,5,5,8,9
expect: => i=3 r=0.0 ok=true s="first duplicate cluster length: 3" errors=0 n=5 res=[5,5,5,8,9] cache=5 hits=0
test: list=3,3,7,7,9
expect: => i=2 r=0.0 ok=true s="first duplicate cluster length: 2" errors=0 n=5 res=[3,3,7,7,9] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var dup_start = -1;
	var dup_len = 0;
	var i = 0;
	while i < g.cn {
		var len = 1;
		while i + len < g.cn && g.cv[i + len] == g.cv[i] {
			len++;
		}
		if len > 1 {
			dup_start = i;
			dup_len = len;
			break;
		}
		i++;
	}
	if dup_len > 1 {
		var left = dup_start;
		var right = dup_start + dup_len - 1;
		while left < right {
			let tk = g.ck[left];
			let tv = g.cv[left];
			g.ck[left] = g.ck[right];
			g.cv[left] = g.cv[right];
			g.ck[right] = tk;
			g.cv[right] = tv;
			left++;
			right--;
		}
	}
	out.i = dup_len;
	out.s.clear();
	format(out.s, "first duplicate cluster length: ", dup_len);
	out
}
@end
