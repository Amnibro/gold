code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idxs int[..32] = [];
	for i in out.s.len {
		if idxs.len < ${limit} {
			let b = out.s[i];
			if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
				idxs.push(i);
			}
		}
	}
	for i in idxs.len / 2 {
		let a = idxs[i];
		let b = idxs[idxs.len - 1 - i];
		let tmp = out.s[a];
		out.s[a] = out.s[b];
		out.s[b] = tmp;
	}
	out.i = idxs.len;
	out
}
@end
