fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 2 {
		var running = 0;
		for i in 1..g.n {
			let pair_sum = g.res[i - 1] + g.res[i];
			running += pair_sum;
			g.res[i - 1] = running;
		}
		g.n -= 1;
		out.i = running;
	}
	g.steps += g.n + 1;
	out
}
@end
