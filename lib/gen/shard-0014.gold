slot: min_val int
slot: max_val int
test: list=15,25,35,45 min_val=10 max_val=40
expect: => i=1 r=0.0 ok=true s="swapped bounded elements: 1" errors=0 n=4 res=[25,15,35,45] cache=0 hits=0
test: list=10,20 min_val=50 max_val=20
expect: => i=0 r=0.0 ok=false s="invalid bound range" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${min_val};
	let high = ${max_val};
	if low >= high {
		gold_fail(g, "lower bound must be less than upper bound");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid bound range");
		return out;
	}
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		let in_range_1 = g.res[i] >= low && g.res[i] <= high;
		let in_range_2 = g.res[i + 1] >= low && g.res[i + 1] <= high;
		if in_range_1 && in_range_2 {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	out.i = swaps;
	out.ok = true;
	out.s.clear();
	format(out.s, "swapped bounded elements: ", swaps);
	out
}
@end
