fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if lo > hi || g.n == 0 {
		gold_fail(g, "invalid bounds for clamp sequence");
		out.ok = false;
		return out;
	}
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
		} else if g.res[i] > hi {
			g.res[i] = hi;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped ", g.n, " sequence elements");
	out
}
@end
