test: list=10,20,40,50 fill_val=30
expect: => i=30 r=0.0 ok=true s="filled middle with 30" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list= fill_val=30
expect: => i=0 r=0.0 ok=false s="error: cannot fill middle" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fill_val = ${fill_val};
	if g.n == 0 || g.n >= 512 {
		gold_fail(g, "cannot fill middle");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cannot fill middle");
		return out;
	}
	let mid = g.n / 2;
	var k = g.n;
	while k > mid {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[mid] = fill_val;
	g.n++;
	g.steps++;
	out.i = fill_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled middle with ", fill_val);
	out
}
@end
