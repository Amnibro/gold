noun: histogram
modifier: in_reverse
context: list
phrase: pair histogram counts sorted in reverse order
phrase: construct paired frequency histogram in reverse
test: list=2,3,2,4,4,4
expect: => i=3 r=0.0 ok=true s="paired reverse histogram classes: 3" errors=0 n=6 res=[4,3,3,1,2,2] cache=0 hits=0
test: list=10,20,10,30,30,30
expect: => i=3 r=0.0 ok=true s="paired reverse histogram classes: 3" errors=0 n=6 res=[30,3,20,1,10,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_vals int[256] = [0; 256];
	var u_cnts int[256] = [0; 256];
	var u_len = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in u_len {
			if u_vals[j] == x {
				u_cnts[j]++;
				found = true;
				break;
			}
		}
		if !found && u_len < 256 {
			u_vals[u_len] = x;
			u_cnts[u_len] = 1;
			u_len++;
		}
	}
	for i in u_len {
		var j = i + 1;
		while j < u_len {
			if u_vals[j] > u_vals[i] {
				let tv = u_vals[i]; u_vals[i] = u_vals[j]; u_vals[j] = tv;
				let tc = u_cnts[i]; u_cnts[i] = u_cnts[j]; u_cnts[j] = tc;
			}
			j++;
		}
	}
	gold_clear(g);
	for i in u_len {
		gold_push(g, u_vals[i]);
		gold_push(g, u_cnts[i]);
	}
	g.steps += g.n;
	out.i = u_len;
	out.s.clear();
	format(out.s, "paired reverse histogram classes: ", u_len);
	out
}
@end
