expect: => i=3 r=0.0 ok=true s="reversed items at least threshold: 3" errors=0 n=5 res=[90,12,70,8,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var idxs int[256] = [0; 256];
	var count = 0;
	for i in g.n {
		if g.res[i] >= thresh && count < 256 {
			idxs[count] = i;
			count++;
		}
	}
	var i = 0;
	while i < count / 2 {
		let i1 = idxs[i];
		let i2 = idxs[count - 1 - i];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
		i++;
	}
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "reversed items at least threshold: ", count);
	out
}
@end
