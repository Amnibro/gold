fn ${ID}(n int) bool {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	if x < 10 { return 1 <= lim; }
	var max_run = 1;
	var cur_run = 1;
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let cur = x % 10;
		if cur == prev {
			cur_run++;
			if cur_run > max_run { max_run = cur_run; }
		} else {
			cur_run = 1;
			prev = cur;
		}
		x /= 10;
	}
	max_run <= lim
}
@end
