@entry 0f3b210dc0657e37
kind: step
verb: merge
noun: average
modifier: up_to
context: cache
phrase: merge elements under average up to limit {cap} into cache
phrase: cache items below average up to maximum {cap} entries
slot: cap int
test: list=10,20,30,40 cap=2
expect: => i=2 r=0.0 ok=true s="merged below average count: 2" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=5,15,25,35 cap=1
expect: => i=1 r=0.0 ok=true s="merged below average count: 1" errors=0 n=4 res=[5,15,25,35] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	let max_merge = ${cap};
	var merged = 0;
	for k in g.n {
		if g.res[k] <= avg && merged < max_merge {
			gold_cache_put(g, k, g.res[k]);
			merged++;
		}
	}
	out.i = merged;
	out.s.clear();
	format(out.s, "merged below average count: ", merged);
	out
}
@end
