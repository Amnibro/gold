@entry 8f04427e6ebaf726
kind: step
verb: rotate
noun: squares
modifier: each
context: list
phrase: rotate each perfect square value cyclically
phrase: shift perfect square positions for each match
test: list=4,7,9,11,16
expect: => i=3 r=0.0 ok=true s="rotated squares count: 3" errors=0 n=5 res=[16,7,4,11,9] cache=0 hits=0
test: list=1,2,25,3,36
expect: => i=3 r=0.0 ok=true s="rotated squares count: 3" errors=0 n=5 res=[36,2,1,3,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_idx: int[512] = [0; 512];
	var sq_val: int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		var r = 0;
		while r * r < x {
			r++;
		}
		if r * r == x && count < 512 {
			sq_idx[count] = i;
			sq_val[count] = x;
			count++;
		}
	}
	if count > 1 {
		for j in count {
			let src = (j - 1 + count) % count;
			g.res[sq_idx[j]] = sq_val[src];
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "rotated squares count: ", count);
	out
}
@end
