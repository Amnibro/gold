@entry e2ccd0dfd8dc2c6b
kind: step
verb: compare
noun: words
modifier: unique
context: sort
slot: min_len int
phrase: sort compare words unique length {min_len}
phrase: tally distinct words unique length {min_len}
test: text="cat elephant dog elephant bird" min_len=4
expect: => i=2 r=0.0 ok=true s="found 2 unique word lengths" errors=0 n=2 res=[4,8] cache=0 hits=0
test: text="a an the" min_len=4
expect: => i=0 r=0.0 ok=true s="found 0 unique word lengths" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var lengths int[512] = [0; 512];
	var ln = 0;
	var cur_len = 0;
	var i = 0;
	while i <= v.s.len {
		let c = if i < v.s.len { v.s[i] } else { ' ' };
		if c == ' ' {
			if cur_len >= ml {
				var seen = false;
				for k in ln {
					if lengths[k] == cur_len { seen = true; break; }
				}
				if !seen {
					lengths[ln] = cur_len;
					ln++;
				}
			}
			cur_len = 0;
		} else {
			cur_len++;
		}
		i++;
	}
	i = 0;
	while i < ln {
		var j = i + 1;
		while j < ln {
			if lengths[i] > lengths[j] {
				let tmp = lengths[i];
				lengths[i] = lengths[j];
				lengths[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in ln { gold_push(g, lengths[k]); }
	g.steps += v.s.len + ln * ln + 1;
	out.i = ln;
	out.s.clear();
	format(out.s, "found ", ln, " unique word lengths");
	out
}
@end
