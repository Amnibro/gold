expect: => i=0 r=0.0 ok=false s="value out of range at index: 0" errors=0 n=3 res=[2,8,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	var all_in = true;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x < lo || x > hi {
			all_in = false;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	out.ok = all_in;
	out.i = if all_in { g.n } else { i };
	out.s.clear();
	if all_in {
		format(out.s, "all nested values in range");
	} else {
		format(out.s, "value out of range at index: ", i);
	}
	out
}
@end
