	let lim = ${max_vowels};
	var count = 0;
	if out.s.len > 0 {
		var i = out.s.len - 1;
		while i >= 0 {
			if count >= lim { break; }
			let ch = out.s[i];
			if ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' {
				count++;
			}
			if i == 0 { break; }
			i--;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out
}
