noun: middle
modifier: at_least
context: search
slot: margin int
phrase: search sort middle at least border {margin}
phrase: order interior items at least border {margin}
test: list=100,50,20,80,10 margin=1
expect: => i=5 r=0.0 ok=true s="sorted middle span with margin 1" errors=0 n=5 res=[100,20,50,80,10] cache=0 hits=0
test: list=10,5,2 margin=1
expect: => i=3 r=0.0 ok=true s="sorted middle span with margin 1" errors=0 n=3 res=[10,5,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	if g.n > (2 * m) {
		var start = m;
		var end = g.n - m;
		var i = start;
		while i < end {
			var j = i + 1;
			while j < end {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted middle span with margin ", m);
	out
}
@end
