@entry 11032fb1dd2affd4
kind: step
verb: scale
noun: series
modifier: recursively
context: math
phrase: scale series recursively multiplying by {factor} across mathematical sequence
phrase: multiply mathematical series recursively by scale {factor}
slot: factor int
test: list=1,2,3 factor=3
expect: => i=18 r=0.0 ok=true s="scaled mathematical series total 18" errors=0 n=3 res=[3,6,9] cache=0 hits=0
test: list=10,20 factor=2
expect: => i=60 r=0.0 ok=true s="scaled mathematical series total 60" errors=0 n=2 res=[20,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var total = 0;
	for i in g.n {
		g.res[i] *= f;
		total += g.res[i];
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "scaled mathematical series total ", total);
	out
}
@end
@entry 999ae5740bb27b31
kind: step
verb: fill
noun: threshold
modifier: up_to
context: transform
phrase: fill threshold up to {limit}
phrase: pad elements reaching threshold up to {limit}
slot: limit int
test: list=3,8,2 limit=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=3 res=[5,8,5] cache=0 hits=0
test: list=10,1,6 limit=4
expect: => i=1 r=0.0 ok=true s="" errors=0 n=3 res=[10,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var count = 0;
	for i in g.n {
		if g.res[i] < lim {
			g.res[i] = lim;
			count++;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out
}
@end
