kind: step
verb: shift
noun: values
modifier: until
context: loop
phrase: shift values left until first element meets {target}
phrase: rotate values until leading element equals {target}
slot: target int
test: list=1,2,3,4 target=3
expect: => i=2 r=0.0 ok=true s="shifted values until target after 2 rotations" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=1,2,3 target=99
expect: => i=0 r=0.0 ok=false s="target not found" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	var found_pos = -1;
	for k in g.n {
		if g.res[k] == target {
			found_pos = k;
			break;
		}
	}
	if found_pos < 0 {
		gold_fail(g, "target not found");
		out.ok = false;
		out.s.clear();
		format(out.s, "target not found");
		return out;
	}
	var rotated = [0; 512];
	for i in g.n {
		rotated[i] = g.res[(found_pos + i) % g.n];
	}
	for i in g.n {
		g.res[i] = rotated[i];
	}
	g.steps += found_pos + 1;
	out.i = found_pos;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted values until target after ", found_pos, " rotations");
	out
}
@end
