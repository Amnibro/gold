fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_val};
	let hi = ${max_val};
	var ok = true;
	var valid_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x < lo || x > hi {
			ok = false;
			break;
		}
		valid_count++;
	}
	out.ok = ok;
	out.i = valid_count;
	out.s.clear();
	format(out.s, "valid checkpoints: ", valid_count);
	out
}
@end
