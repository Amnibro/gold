phrase: restrict numbers recursively with ceiling limit {bound}
slot: bound int
test: list=20,40,80,10 bound=25
expect: => i=2 r=0.0 ok=true s="recursively clamped count: 2" errors=0 n=4 res=[20,20,20,10] cache=0 hits=0
test: list=100,50,200 bound=75
expect: => i=2 r=0.0 ok=true s="recursively clamped count: 2" errors=0 n=3 res=[50,50,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${bound};
	var clamped = 0;
	for i in g.n {
		var x = g.res[i];
		var modified = false;
		while x > lim {
			x /= 2;
			modified = true;
		}
		if modified {
			g.res[i] = x;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "recursively clamped count: ", clamped);
	out
}
@end
