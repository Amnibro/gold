fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var max_diff = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > max_diff { max_diff = gap; }
		if gap > b {
			gold_fail(g, "pairwise difference exceeds budget");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: pairwise difference exceeds budget");
			return out;
		}
		i++;
	}
	g.steps += g.n + max_diff;
	out.i = max_diff;
	out.s.clear();
	format(out.s, "all pairwise diffs within budget max: ", max_diff);
	out
}
@end
