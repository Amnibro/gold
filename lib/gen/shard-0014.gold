@entry d7d138aa7eb10ec3
kind: step
verb: compare
noun: digits
modifier: every_other
context: retry
phrase: compare alternate digits every other position with modulus {m}
phrase: check every other digit equality under mod {m}
slot: m int
test: list=2,7,4,9,6 m=2
expect: => i=3 r=0.0 ok=true s="matched every other digit" errors=0 n=5 res=[2,7,4,9,6] cache=0 hits=0
test: list=2,7,5 m=2
expect: => i=0 r=0.0 ok=false s="mismatched every other digit" errors=1 n=3 res=[2,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${m};
	if m <= 0 || g.n == 0 {
		gold_fail(g, "invalid modulus or empty buffer");
		out.ok = false;
		out.s.clear();
		format(out.s, "invalid modulus or empty buffer");
		return out;
	}
	let target_rem = (g.res[0] % m + m) % m;
	var matched = true;
	var count = 0;
	var i = 0;
	while i < g.n {
		let rem = (g.res[i] % m + m) % m;
		if rem != target_rem {
			matched = false;
			break;
		}
		count++;
		i += 2;
	}
	g.steps += count;
	out.s.clear();
	if matched {
		out.i = count;
		out.ok = true;
		format(out.s, "matched every other digit");
	} else {
		gold_fail(g, "mismatched every other digit");
		out.i = 0;
		out.ok = false;
		format(out.s, "mismatched every other digit");
	}
	out
}
@end
