expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: peak3 cone -3,2,0 -3,2,8 r4.8 m:matte #78787d
expect: => doc: peak4 cone 3,-2,0 3,-2,8 r4.8 m:matte #78787d
test: n=0 h=12.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${h} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
		let px = (q as real - (${n} as real - 1.0) * 0.5) * 6.0;
		let py = if q % 2 == 0 { 2.0 } else { -2.0 };
		o.clear();
		gold_dnews(g, "peak", "", o);
		o.append(" cone ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",0 ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, ${h});
		o.append(" r");
		gold_fnum(o, ${h} * 0.6);
		o.append(" m:matte ");
		gold_hex(o, 120, 120, 125);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "sparse mountain peaks");
	out
}
@end
