	while i < g.n {
		if !${test_cond}(g.res[i]) {
			break;
		}
		count++;
		i++;
	}
	g.steps += i + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "prefix matched ", count, " items");
	out
}
@end
