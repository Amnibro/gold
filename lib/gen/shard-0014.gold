@entry 363a3c46732425c3
kind: step
verb: rotate
noun: evens
modifier: recursively
context: math
phrase: rotate even values recursively by count {times}
phrase: cyclically shift even elements recursively {times} steps
slot: times int
test: list=2,5,4,7,6 times=1
expect: => i=3 r=0.0 ok=true s="rotated evens count: 3" errors=0 n=5 res=[6,5,2,7,4] cache=0 hits=0
test: list=10,3,20,5,30,7 times=2
expect: => i=3 r=0.0 ok=true s="rotated evens count: 3" errors=0 n=6 res=[20,3,30,5,10,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let shift = ${times};
	var even_idx: int[512] = [0; 512];
	var even_val: int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 && count < 512 {
			even_idx[count] = i;
			even_val[count] = g.res[i];
			count++;
		}
	}
	if count > 1 {
		let eff = ((shift % count) + count) % count;
		for i in count {
			let src = (i - eff + count) % count;
			g.res[even_idx[i]] = even_val[src];
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "rotated evens count: ", count);
	out
}
@end
