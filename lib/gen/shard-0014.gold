kind: step
verb: clamp
noun: results
modifier: in_reverse
context: compare
phrase: clamp results in_reverse bounds {lo} {hi}
phrase: restrict results in_reverse order {lo} {hi}
slot: lo int
slot: hi int
test: list=1,10,25 lo=5 hi=20
expect: => i=3 r=0.0 ok=true s="clamped and reversed 3 results" errors=0 n=3 res=[20,10,5] cache=0 hits=0
test: list=1,2 lo=20 hi=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if lo > hi || g.n == 0 {
		gold_fail(g, "invalid bounds or empty list");
		out.ok = false;
		return out;
	}
	for i in g.n {
		if g.res[i] < lo {
			g.res[i] = lo;
		} else if g.res[i] > hi {
			g.res[i] = hi;
		}
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "clamped and reversed ", g.n, " results");
	out
}
@end
@entry fbadb69c9853f990
kind: step
verb: dedupe
noun: odds
modifier: up_to
context: compare
phrase: dedupe odds up_to threshold {limit}
phrase: remove duplicate odds up_to bound {limit}
slot: limit int
test: list=3,5,3,7,5,9 limit=6
expect: => i=4 r=0.0 ok=true s="deduped odds up to limit, count 4" errors=0 n=4 res=[3,5,7,9] cache=0 hits=0
test: list=2,4,6 limit=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var temp int[512] = [0; 512];
	var seen int[512] = [0; 512];
	var s_cnt = 0;
	var m = 0;
	var odd_count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			odd_count++;
			if x <= limit {
				var already = false;
				for j in s_cnt {
					if seen[j] == x {
						already = true;
						break;
					}
				}
				if !already {
					seen[s_cnt] = x;
					s_cnt++;
					temp[m] = x;
					m++;
				}
			} else {
				temp[m] = x;
				m++;
			}
		} else {
			temp[m] = x;
			m++;
		}
	}
	if odd_count == 0 {
		gold_fail(g, "no odd numbers present");
		out.ok = false;
		return out;
	}
	for j in m {
		g.res[j] = temp[j];
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "deduped odds up to limit, count ", m);
	out
}
@end
