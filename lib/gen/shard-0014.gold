@entry 65d5d88ac0c3b436
kind: step
verb: split
noun: maximum
modifier: first
context: core
phrase: split first maximum element into halves
phrase: divide highest value into two parts
test: list=10,25,8
expect: => i=25 r=0.0 ok=true s="" errors=0 n=4 res=[10,12,13,8] cache=0 hits=0
test: list=4,2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=3 res=[2,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 && g.n < 512 {
		var max_idx = 0;
		var max_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
				max_idx = i;
			}
		}
		let h1 = max_val / 2;
		let h2 = max_val - h1;
		g.res[max_idx] = h1;
		var i = g.n;
		while i > max_idx + 1 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[max_idx + 1] = h2;
		g.n++;
		out.i = max_val;
	}
	g.steps += g.n + 1;
	out
}
@end
@entry d748206bfac091b4
kind: step
verb: sum
noun: step
modifier: sorted
context: core
phrase: sum adjacent steps across sorted elements
phrase: compute total step difference in sorted order
test: list=10,2,7
expect: => i=8 r=0.0 ok=true s="" errors=0 n=3 res=[2,7,10] cache=0 hits=0
test: list=20,5,12
expect: => i=15 r=0.0 ok=true s="" errors=0 n=3 res=[5,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
		var diff_sum = 0;
		for i in 1..g.n {
			diff_sum += g.res[i] - g.res[i - 1];
		}
		out.i = diff_sum;
	}
	g.steps += g.n + 1;
	out
}
@end
