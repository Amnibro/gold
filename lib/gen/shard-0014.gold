kind: step
verb: pair
noun: digits
modifier: unique
context: list
phrase: pair unique single digits extracted from list items
phrase: assemble unique digits into paired list representation
test: list=12,23,34
expect: => i=4 r=0.0 ok=true s="paired unique digits count: 4" errors=0 n=4 res=[2,1,3,4] cache=0 hits=0
test: list=505,71,17
expect: => i=4 r=0.0 ok=true s="paired unique digits count: 4" errors=0 n=4 res=[5,0,1,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen bool[10] = [false; 10];
	var u_digits int[10] = [0; 10];
	var u_count = 0;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		if n == 0 {
			if !seen[0] { seen[0] = true; u_digits[u_count] = 0; u_count++; }
		}
		while n > 0 {
			let d = n % 10;
			if !seen[d] {
				seen[d] = true;
				u_digits[u_count] = d;
				u_count++;
			}
			n /= 10;
		}
	}
	gold_clear(g);
	for i in u_count {
		gold_push(g, u_digits[i]);
	}
	g.steps += g.n;
	out.i = u_count;
	out.s.clear();
	format(out.s, "paired unique digits count: ", u_count);
	out
}
@end
