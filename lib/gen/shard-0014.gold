expect: => i=4 r=0.0 ok=true s="running series matches: 4" errors=0 n=4 res=[1,3,5,8] cache=0 hits=0
test: list=10,5,20,15,30
expect: => i=3 r=0.0 ok=true s="running series matches: 3" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty search series");
		return out;
	}
	var kept = 1;
	var cur_max = g.res[0];
	var i = 1;
	while i < g.n {
		let x = g.res[i];
		if x > cur_max {
			g.res[kept] = x;
			cur_max = x;
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "running series matches: ", kept);
	out
}
@end
