code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	var seen = [0; 10];
	var temp = if num < 0 { -num } else { num };
	if temp == 0 { seen[0] = 1; }
	while temp > 0 {
		let d = temp % 10;
		seen[d] = 1;
		temp /= 10;
	}
	out.s.clear();
	out.s.append("digits:{");
	var count = 0;
	for d in 10 {
		if seen[d] == 1 {
			if count > 0 { out.s.push(','); }
			format(out.s, d);
			count++;
		}
	}
	out.s.push('}');
	out.i = count;
	g.steps += count + 1;
	out
}
@end
