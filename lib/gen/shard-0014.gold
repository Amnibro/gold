				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	var count = 0;
	for k in g.n {
		if ${cond}(g.res[k]) {
			sum += g.res[k];
			count++;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "summed ", count, " condition matches: ", sum);
	out
}
@end
