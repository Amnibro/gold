	let max_sum = ${max_sum};
	if max_sum <= 0 {
		gold_fail(g, "max sum must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: max sum must be positive");
		return out;
	}
	var sum = 0;
	var count = 0;
	while count < g.n && sum + g.res[count] <= max_sum {
		sum += g.res[count];
		count++;
	}
	if count == 0 {
		gold_fail(g, "first item exceeds ceiling");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: first item exceeds ceiling");
		return out;
	}
	g.n = count;
	g.steps += count;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "limited total up to ceiling: ", sum);
	out
}
