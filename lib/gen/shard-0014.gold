@entry a08eb44720a5291a
kind: step
verb: run
noun: prefix
modifier: unique
context: aggregate
phrase: run unique collection over prefix of {k} items
phrase: filter duplicate elements across initial {k} values
slot: k int
test: list=2,2,3,4,4,5 k=4
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[2,3,4,4,5] cache=0 hits=0
test: list=10,10,20,20,30 k=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let limit = if g.n < k { g.n } else { k };
	var write = 0;
	for i in limit {
		let x = g.res[i];
		var seen = false;
		for j in write {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[write] = x;
			write++;
		}
	}
	for i in limit..g.n {
		g.res[write] = g.res[i];
		write++;
	}
	g.n = write;
	out.i = write;
	g.steps += g.n + 1;
	out
}
@end
