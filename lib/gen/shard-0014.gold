@entry c6d7a84af99b2277
kind: step
verb: rotate
noun: primes
modifier: at_most
context: math
slot: k int
phrase: rotate primes at most {k} positions in list
phrase: cyclically shift primes at most {k} places
test: list=2,3,5,7,11 k=2
expect: => i=2 r=0.0 ok=true s="rotated primes at most: 2" errors=0 n=5 res=[5,7,11,2,3] cache=0 hits=0
test: list=7,11,13,17 k=1
expect: => i=1 r=0.0 ok=true s="rotated primes at most: 1" errors=0 n=4 res=[11,13,17,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let raw = ${k};
		let shift = if raw < 0 { 0 } else { raw % g.n };
		for s in shift {
			let first = g.res[0];
			var i = 0;
			while i + 1 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 1] = first;
		}
		out.i = shift;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated primes at most: ", out.i);
	out
}
@end
