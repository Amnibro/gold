kind: step
verb: rank
noun: limit
modifier: unique
context: math
phrase: rank unique elements up to rank limit {max_rank}
phrase: score distinct items bounded by maximum rank {max_rank}
slot: max_rank int
test: list=10,20,20,30,40 max_rank=2
expect: => i=2 r=0.0 ok=true s="ranked unique count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list=5,15,25,35,45 max_rank=4
expect: => i=4 r=0.0 ok=true s="ranked unique count: 4" errors=0 n=4 res=[5,15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_rank};
	var uniq: int[512] = [0; 512];
	var u_count = 0;
	for i in g.n {
		let val = g.res[i];
		var seen = false;
		for j in u_count {
			if uniq[j] == val {
				seen = true;
				break;
			}
		}
		if !seen && u_count < 512 {
			uniq[u_count] = val;
			u_count++;
		}
	}
	gold_clear(g);
	let write_limit = if lim > u_count { u_count } else { lim };
	for i in write_limit {
		gold_push(g, uniq[i]);
	}
	out.i = write_limit;
	out.s.clear();
	format(out.s, "ranked unique count: ", write_limit);
	out
}
@end
