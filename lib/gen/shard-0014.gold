code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if g.n == 0 {
		gold_fail(g, "empty list for threshold dedupe");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var temp int[512] = [0; 512];
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lim {
			var seen = false;
			for j in m { if temp[j] == x { seen = true; break; } }
			if !seen { temp[m] = x; m++; }
		} else {
			temp[m] = x;
			m++;
		}
	}
	for i in m { g.res[i] = temp[i]; }
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "deduped above threshold: ", m);
	out
}
@end
