code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let scale = ${scale};
	let key = ${key};
	if g.n == 0 {
		gold_fail(g, "empty list has no average");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	let avg = sum / g.n;
	let scaled = avg * scale;
	gold_cache_put(g, key, scaled);
	g.steps += g.n;
	out.i = scaled;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached average scaled ", scale, " times value ", scaled);
	out
}
@end
