@entry 5d515d56aa8fdea8
kind: step
verb: join
noun: loop
modifier: in_place
context: search
slot: sep int
phrase: search join loop in place separator {sep}
phrase: interleave query loop in place delimiter {sep}
test: list=2,4,6 sep=0
expect: => i=5 r=0.0 ok=true s="joined loop in place to 5 elements" errors=0 n=5 res=[2,0,4,0,6] cache=0 hits=0
test: list=10 sep=9
expect: => i=1 r=0.0 ok=true s="joined loop trivial: 1" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${sep};
	if g.n <= 1 {
		g.steps += 1;
		out.i = g.n;
		out.s.clear();
		format(out.s, "joined loop trivial: ", g.n);
		return out;
	}
	var old_n = g.n;
	var new_n = old_n + (old_n - 1);
	if new_n > 512 { new_n = 512; }
	var src = old_n - 1;
	var dst = new_n - 1;
	while src >= 0 && dst >= 0 {
		g.res[dst] = g.res[src];
		dst--;
		if src > 0 && dst >= 0 {
			g.res[dst] = s;
			dst--;
		}
		src--;
	}
	g.n = new_n;
	g.steps += new_n + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "joined loop in place to ", new_n, " elements");
	out
}
@end
