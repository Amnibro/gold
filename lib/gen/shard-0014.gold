test: list=2,5,10,18,30
expect: => i=4 r=0.0 ok=true s="reversed gap count: 4" errors=0 n=4 res=[12,8,5,3] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var write = 0;
	var idx = 0;
	while idx + 1 < g.cn {
		g.res[write] = g.cv[idx + 1] - g.cv[idx];
		write++;
		idx++;
	}
	g.n = write;
	if g.n > 1 {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed gap count: ", g.n);
	out
}
@end
