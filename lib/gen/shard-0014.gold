code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var stored = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= ceil {
			gold_cache_put(g, stored, x);
			stored++;
		}
	}
	out.i = stored;
	g.steps += stored + 1;
	out
}
@end
