modifier: unique
context: loop
phrase: loop counting unique numbers in sequence
phrase: count unique number occurrences across data loop
test: list=1,2,2,3,1,4,5
expect: => i=5 r=0.0 ok=true s="unique numbers detected: 5" errors=0 n=7 res=[1,2,2,3,1,4,5] cache=0 hits=0
test: list=10,20,30,10,40
expect: => i=4 r=0.0 ok=true s="unique numbers detected: 4" errors=0 n=5 res=[10,20,30,10,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == x { seen = true; break; }
			j++;
		}
		if !seen { u_count++; }
		i++;
	}
	g.steps += g.n;
	out.i = u_count;
	out.s.clear();
	format(out.s, "unique numbers detected: ", u_count);
	out
}
@end
