fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no counter");
		out.ok = false;
		return out;
	}
	var sorted = true;
	for i in (g.n - 1) {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
	}
	if !sorted {
		gold_fail(g, "elements are not sorted");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "list is sorted of size ", g.n);
	out
}
@end
