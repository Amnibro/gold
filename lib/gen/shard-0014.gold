test: list=
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let first = g.res[0];
	var streak = 0;
	while streak < g.n && g.res[streak] == first {
		streak++;
	}
	var temp int[512] = [0; 512];
	var idx = 0;
	for i in (g.n - streak) {
		temp[idx] = g.res[streak + i];
		idx++;
	}
	for i in streak {
		temp[idx] = g.res[i];
		idx++;
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = streak;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated streak of ", streak);
	out
}
@end
