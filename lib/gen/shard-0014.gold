fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if k > g.n { 0 } else { g.n - k };
	var sum = 0;
	for i in start..g.n {
		sum += g.res[i];
	}
	out.i = sum;
	gold_push(g, sum);
	out.s.clear();
