fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_tries = ${min_tries};
	let max_tries = ${max_tries};
	if min_tries > max_tries || min_tries <= 0 {
		gold_fail(g, "invalid retry bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid retry bounds");
		return out;
	}
	var k = min_tries;
	var sum = 0;
	while k <= max_tries {
