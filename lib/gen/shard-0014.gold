@entry f78999cf9cff2ea8
kind: step
verb: fold
noun: duplicates
modifier: at_least
context: list
phrase: fold duplicated items appearing at least {min_reps} times
phrase: sum elements having multiplicity at least {min_reps}
slot: min_reps int
test: list=2,2,2,3,4,4 min_reps=2
expect: => i=6 r=0.0 ok=true s="folded duplicates sum: 6" errors=0 n=7 res=[2,2,2,3,4,4,6] cache=0 hits=0
test: list=5,5,5,5,6,7 min_reps=3
expect: => i=5 r=0.0 ok=true s="folded duplicates sum: 5" errors=0 n=7 res=[5,5,5,5,6,7,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_reps};
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq >= limit {
			var first = -1;
			for k in g.n {
				if g.res[k] == x {
					first = k;
					break;
				}
			}
			if first == i {
				sum += x;
			}
		}
	}
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "folded duplicates sum: ", sum);
	out
}
@end
@entry 001477d3cc29ae79
kind: step
verb: rotate
noun: range
modifier: in_reverse
context: list
phrase: rotate list range in reverse direction by {steps}
phrase: cyclically shift elements in reverse by {steps} steps
slot: steps int
test: list=1,2,3,4,5 steps=1
expect: => i=5 r=0.0 ok=true s="rotated in reverse count: 5" errors=0 n=5 res=[2,3,4,5,1] cache=0 hits=0
test: list=10,20,30,40 steps=2
expect: => i=4 r=0.0 ok=true s="rotated in reverse count: 4" errors=0 n=4 res=[30,40,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${steps};
	if g.n > 1 {
		let shift = ((s % g.n) + g.n) % g.n;
		var tmp: int[512] = [0; 512];
		for i in g.n {
			tmp[i] = g.res[i];
		}
		for i in g.n {
			let src = (i + shift) % g.n;
			g.res[i] = tmp[src];
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated in reverse count: ", g.n);
	out
}
@end
