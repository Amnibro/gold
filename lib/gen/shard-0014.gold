expect: => i=3 r=0.0 ok=true s="ranked squares count: 3" errors=0 n=5 res=[1,2,2,3,5] cache=0 hits=0
test: list=1,3,25,7,36,49
expect: => i=4 r=0.0 ok=true s="ranked squares count: 4" errors=0 n=6 res=[1,3,2,7,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sq_count = 0;
	var sq_idx: int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		var r = 0;
		while r * r < x {
			r++;
		}
		if r * r == x {
			sq_idx[sq_count] = i;
			sq_count++;
		}
	}
	for k in sq_count {
		let orig = g.res[sq_idx[k]];
		var rank = 1;
		for j in sq_count {
			if g.res[sq_idx[j]] < orig {
				rank++;
			}
		}
		g.res[sq_idx[k]] = rank;
	}
	out.i = sq_count;
	out.s.clear();
	format(out.s, "ranked squares count: ", sq_count);
	out
}
@end
