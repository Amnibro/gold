@entry 9e0b57bcf032d428
kind: fn
verb: limit
noun: budget
modifier: all
context: transform
phrase: limit budget all digits sum {budget}
phrase: constrain all digits within budget {budget}
slot: budget int
test: arg=4531,234 budget=7
expect: 4030
expect: 230
test: arg=1111,8 budget=3
expect: 1110
expect: 0
code:
fn ${ID}(n int) int {
	let max_b = ${budget};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0; }
	var digits int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		digits[len] = x % 10;
		len++;
		x /= 10;
	}
	var res = 0;
	var spent = 0;
	var i = len - 1;
	while i >= 0 {
		let d = digits[i];
		if spent + d <= max_b {
			spent += d;
			res = res * 10 + d;
		} else {
			res = res * 10;
		}
		i--;
	}
	if n < 0 { -res } else { res }
}
@end
