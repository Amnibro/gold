@entry 35fe099696d186fb
kind: step
verb: retry
noun: primes
modifier: until
context: loop
slot: target_count int
phrase: retry prime search loop until finding {target_count} primes
phrase: keep looping primes search until {target_count} reached
test: input=10 target_count=3
expect: => i=17 r=0.0 ok=true s="found primes up to: 17" errors=0 n=3 res=[11,13,17] cache=0 hits=0
test: input=20 target_count=4
expect: => i=37 r=0.0 ok=true s="found primes up to: 37" errors=0 n=4 res=[23,29,31,37] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${target_count};
	var found = 0;
	var candidate = out.i;
	gold_clear(g);
	while found < tc {
		candidate++;
		var is_p = candidate >= 2;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, candidate);
			found++;
		}
	}
	g.steps += found * 2;
	out.i = candidate;
	out.s.clear();
	format(out.s, "found primes up to: ", candidate);
	out
}
@end
