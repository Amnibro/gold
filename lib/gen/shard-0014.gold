expect: => i=2 r=0.0 ok=true s="found 2 items with at most 2 digits" errors=0 n=4 res=[5,25,100,5000] cache=0 hits=0
test: list=1000,2000 max_digits=2
expect: => i=0 r=0.0 ok=true s="found 0 items with at most 2 digits" errors=0 n=2 res=[1000,2000] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_digits};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var count = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 { x = -x; }
		var d = 0;
		if x == 0 { d = 1; }
		while x > 0 {
			d++;
			x /= 10;
		}
		if d <= md {
			count++;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "found ", count, " items with at most ", md, " digits");
	out
}
@end
