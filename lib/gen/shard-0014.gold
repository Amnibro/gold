expect: => i=0 r=0.0 ok=false s="error: tally threshold not reached" errors=1 n=4 res=[10,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var new_n = 0;
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		for j in new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
			sum += x;
			if sum >= th { break; }
		}
		i++;
	}
	if sum < th {
		gold_fail(g, "tally threshold not reached");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: tally threshold not reached");
		return out;
	}
	g.n = new_n;
	g.steps += g.n + sum;
	out.i = sum;
	out.s.clear();
	format(out.s, "deduped tally sum: ", sum);
	out
}
@end
