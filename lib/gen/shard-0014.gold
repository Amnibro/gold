	if g.n == 0 { return out; }
	var cur_max = g.res[0];
	for i in g.n {
		if g.res[i] > cur_max {
			cur_max = g.res[i];
		}
		g.res[i] = cur_max;
	}
	g.steps += g.n;
	out.i = cur_max;
	out.s.clear();
	format(out.s, "running maximum peak: ", cur_max);
	out
}
