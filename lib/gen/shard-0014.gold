expect: => i=0 r=0.0 ok=true s="dropped 0 even elements" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_drop};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var kept = 0;
	var dropped = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 && dropped < md {
			dropped++;
		} else {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	g.steps += g.n * g.n + 1;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " even elements");
	out
}
@end
