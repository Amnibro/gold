phrase: accumulate tail items using function {fn_slot}
test: list=1,2,3,4 fn_slot=double
expect: => i=14 r=0.0 ok=true s="folded last items with function: 14" errors=0 n=3 res=[1,2,14] cache=0 hits=0
test: list=10,20,30 fn_slot=inc
expect: => i=51 r=0.0 ok=true s="folded last items with function: 51" errors=0 n=2 res=[10,51] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		let a = g.res[g.n - 2];
		let b = g.res[g.n - 1];
		let r = ${fn_slot}(a + b);
		g.n--;
		g.res[g.n - 1] = r;
		out.i = r;
	} else if g.n == 1 {
		out.i = g.res[0];
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "folded last items with function: ", out.i);
	out
}
@end
