@entry a493e5b3f077dffe
kind: step
verb: split
noun: primes
modifier: sorted
context: aggregate
phrase: split primes sorted ascending order
phrase: aggregate prime numbers sorted ascending
test: list=9,2,7,4,5,3
expect: => i=17 r=0.0 ok=true s="sorted primes sum 17" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="sorted primes sum 0" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var temp int[512] = [0; 512];
	var m = 0;
	var tot = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 { is_p = false; break; }
				d++;
			}
			if is_p {
				temp[m] = x;
				tot += x;
				m++;
			}
		}
	}
	for i in m {
		var j = 0;
		while j + 1 < m - i {
			if temp[j] > temp[j + 1] {
				let t = temp[j];
				temp[j] = temp[j + 1];
				temp[j + 1] = t;
			}
			j++;
		}
	}
	for k in m { g.res[k] = temp[k]; }
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "sorted primes sum ", tot);
	out
}
@end
