fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	let th = ${threshold};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let res_val = if avg <= th { avg } else { th };
	g.steps += g.n;
	out.i = res_val;
	out.s.clear();
	format(out.s, "average capped at most: ", res_val);
	out
}
@end
