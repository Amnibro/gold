fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cutoff};
	var high_rank = 0;
	for i in g.n {
		let x = g.res[i];
		var score, ok = gold_cache_get(g, x);
		if !ok {
			score = if x >= lim { 2 } else { 1 };
			gold_cache_put(g, x, score);
		}
		g.res[i] = score;
		if score == 2 { high_rank++; }
	}
	g.steps += g.n + 1;
	out.i = high_rank;
	out.s.clear();
	format(out.s, "ranked ", high_rank, " elements above cutoff");
	out
}
