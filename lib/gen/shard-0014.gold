noun: subfunction
modifier: unique
context: core
phrase: scale subfunction unique results by factor {factor}
phrase: multiply distinct result values by {factor}
slot: factor int
test: list=2,3,2,4 factor=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[20,30,40] cache=0 hits=0
test: list=5,5,5 factor=3
expect: => i=1 r=0.0 ok=true s="" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var out_res int[..64] = [];
	for i in g.n {
		var dup = false;
		for j in out_res.len {
			if g.res[i] * ${factor} == out_res[j] {
				dup = true;
				break;
			}
		}
		if !dup {
			out_res.push(g.res[i] * ${factor});
		}
	}
	g.n = out_res.len;
	for i in g.n {
		g.res[i] = out_res[i];
	}
	out.i = g.n;
	out
}
@end
