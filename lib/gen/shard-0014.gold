expect: => i=3 r=0.0 ok=true s="nested prefix comparisons: 3" errors=0 n=5 res=[6,2,8,3,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${plen};
	let bound = if k < g.n { k } else { g.n };
	var comparisons = 0;
	var i = 0;
	while i < bound {
		var j = i + 1;
		while j < bound {
			if g.res[i] < g.res[j] {
				comparisons++;
			}
			j++;
		}
		i++;
	}
	g.steps += bound * bound;
	out.i = comparisons;
	out.s.clear();
	format(out.s, "nested prefix comparisons: ", comparisons);
	out
}
@end
