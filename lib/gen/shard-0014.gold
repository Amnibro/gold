fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var greater_pairs = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				greater_pairs++;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = greater_pairs;
	out.s.clear();
	format(out.s, "inversions measured in series: ", greater_pairs);
	out
}
@end
