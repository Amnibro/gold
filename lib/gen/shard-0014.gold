	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var pairs = 0;
	var k = 0;
	while k + 1 < g.n {
		let diff = g.res[k + 1] - g.res[k];
		g.res[pairs] = diff;
		pairs++;
		k += 2;
	}
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "paired steps count: ", pairs);
	out
}
@end
