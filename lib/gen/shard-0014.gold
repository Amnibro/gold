fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for pairwise join");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: not enough items");
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let sum = g.res[i] + g.res[i + 1];
		gold_push(g, sum);
		pairs++;
		i += 2;
	}
	g.steps += pairs;
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "joined ", pairs, " sequence pairs");
	out
}
@end
