fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${threshold};
	var u_vals int[256] = [0; 256];
	var u_cnts int[256] = [0; 256];
	var u_len = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in u_len {
			if u_vals[j] == x {
				u_cnts[j]++;
				found = true;
				break;
			}
		}
		if !found && u_len < 256 {
			u_vals[u_len] = x;
			u_cnts[u_len] = 1;
			u_len++;
		}
	}
	gold_clear(g);
	for i in u_len {
		if u_cnts[i] >= thresh {
			gold_push(g, u_vals[i]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "selected duplicates count: ", g.n);
	out
}
@end
