fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var prime_count = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_cache_put(g, x, x * f);
			prime_count++;
		}
	}
	out.i = prime_count;
	out.s.clear();
	format(out.s, "scaled primes in cache: ", prime_count);
	out
}
@end
@entry feca5c167a76bf34
kind: step
verb: swap
noun: tail
modifier: until
context: cache
phrase: swap tail cache entries until condition {cond} holds
phrase: exchange trailing cache items until predicate {cond} succeeds
slot: cond pred
test: list=10,20,30,40 cond=is_even
expect: => i=0 r=0.0 ok=true s="tail swaps: 0" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,7,9,11 cond=over_100
expect: => i=5 r=0.0 ok=true s="tail swaps: 5" errors=0 n=4 res=[5,7,9,11] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var swaps = 0;
	while g.cn >= 2 {
		let last_val = g.cv[g.cn - 1];
		if ${cond}(last_val) || swaps >= 5 {
			break;
		}
		let tk = g.ck[g.cn - 1];
		let tv = g.cv[g.cn - 1];
		g.ck[g.cn - 1] = g.ck[g.cn - 2];
		g.cv[g.cn - 1] = g.cv[g.cn - 2];
		g.ck[g.cn - 2] = tk;
		g.cv[g.cn - 2] = tv;
		swaps++;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "tail swaps: ", swaps);
	out
}
@end
@entry 42f73f251a4190d4
kind: step
