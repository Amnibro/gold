test: list=10,2,3,4,20 shift=1
expect: => i=1 r=0.0 ok=true s="rotated middle interior items: 1" errors=0 n=5 res=[10,3,4,2,20] cache=0 hits=0
test: list=100,5,6,7,8,200 shift=2
expect: => i=2 r=0.0 ok=true s="rotated middle interior items: 2" errors=0 n=6 res=[100,7,8,5,6,200] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 3 {
		let mid_len = g.n - 2;
		let raw = ${shift};
		let s = if raw < 0 { 0 } else { raw % mid_len };
		for step in s {
			let first_mid = g.res[1];
			var i = 1;
			while i + 2 < g.n {
				g.res[i] = g.res[i + 1];
				i++;
			}
			g.res[g.n - 2] = first_mid;
		}
		out.i = s;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated middle interior items: ", out.i);
	out
}
@end
