phrase: bound list numbers under ceiling {bound} with retries {retries}
slot: bound int
slot: retries int
test: list=20,35,50,15 bound=30 retries=2
expect: => i=2 r=0.0 ok=true s="clamped with retry: 2" errors=0 n=4 res=[20,30,30,15] cache=0 hits=0
test: list=10,60,80,90 bound=50 retries=1
expect: => i=3 r=0.0 ok=true s="clamped with retry: 3" errors=0 n=4 res=[10,50,50,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${bound};
	let max_r = ${retries};
	var clamped = 0;
	for i in g.n {
		if g.res[i] > ceil {
			g.res[i] = ceil;
			clamped++;
		}
	}
	var r = 0;
	while clamped > max_r && r < 3 {
		r++;
		g.steps += r;
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped with retry: ", clamped);
	out
}
@end
