code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let floor_val = ${min_val};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= floor_val {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	g.steps += g.n + kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped above minimum count: ", kept);
	out
}
@end
@entry 9e11d1806177a3e4
kind: step
verb: rotate
noun: minimum
modifier: up_to
context: search
phrase: rotate search minimum up to limit {limit}
phrase: shift search results placing minimum up to {limit} first
slot: limit int
test: list=30,50,10,40,20 limit=4
expect: => i=10 r=0.0 ok=true s="rotated minimum value: 10" errors=0 n=5 res=[10,40,20,30,50] cache=0 hits=0
test: list=8,15,3,9,12 limit=3
expect: => i=3 r=0.0 ok=true s="rotated minimum value: 3" errors=0 n=5 res=[3,9,12,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	let span = if lim < g.n { lim } else { g.n };
	if span <= 1 {
		out.i = 0;
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	var i = 1;
	while i < span {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
		i++;
	}
	var temp int[256] = [0; 256];
	for k in g.n { temp[k] = g.res[k]; }
	for k in g.n {
		let src = (k + min_idx) % g.n;
		g.res[k] = temp[src];
	}
	g.steps += g.n + span;
	out.i = min_val;
	out.s.clear();
	format(out.s, "rotated minimum value: ", min_val);
	out
}
@end
