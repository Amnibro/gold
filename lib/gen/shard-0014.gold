code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let limit = if k < g.n - 1 { k } else { g.n - 1 };
	var gap_sum = 0;
	var i = 0;
	while i < limit {
		let diff = g.res[i + 1] - g.res[i];
		gap_sum += if diff < 0 { -diff } else { diff };
		i++;
	}
	g.steps += limit + 1;
	out.i = gap_sum;
	out.s.clear();
	format(out.s, "folded initial spaces sum: ", gap_sum);
	out
}
@end
