fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var write_idx = 0;
	var errors = 0;
	for idx in g.cn {
		let val = g.cv[idx];
		if val < 0 {
			gold_fail(g, "negative cache entry in place");
			errors++;
		} else {
			g.ck[write_idx] = g.ck[idx];
			g.cv[write_idx] = val;
			write_idx++;
		}
	}
	g.cn = write_idx;
	out.i = errors;
	out.ok = errors == 0;
	out.s.clear();
	format(out.s, "kept cache entries: ", write_idx);
	out
}
@end
