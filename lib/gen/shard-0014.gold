expect: => i=3 r=0.0 ok=true s="histogram pairs: 3" errors=0 n=6 res=[5,2,8,2,9,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var temp int[512] = [0; 512];
	var count = 0;
	var k = 0;
	while k < g.n {
		var run = 1;
		while k + run < g.n && g.res[k + run] == g.res[k] {
			run++;
		}
		temp[count] = g.res[k];
		temp[count + 1] = run;
		count += 2;
		k += run;
	}
	for idx in count {
		g.res[idx] = temp[idx];
	}
	g.n = count;
	out.i = count / 2;
	out.s.clear();
	format(out.s, "histogram pairs: ", count / 2);
	out
}
@end
