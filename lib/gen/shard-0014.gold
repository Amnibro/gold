test: list=1,2,2,3,4,4,4 min_repeats=2
expect: => i=2 r=0.0 ok=true s="dropped 2 unique history entries" errors=0 n=5 res=[2,2,4,4,4] cache=0 hits=0
test: list=10,20,30 min_repeats=2
expect: => i=3 r=0.0 ok=true s="dropped 3 unique history entries" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mr = ${min_repeats};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= mr {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.steps += g.n * g.n + 1;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "dropped ", dropped, " unique history entries");
	out
}
@end
