fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var kept int[512] = [0; 512];
	var kc = 0;
	var running_sum = 0;
	var i = 0;
	while i < g.n {
		running_sum += g.res[i];
		let avg = running_sum / (i + 1);
		if avg >= th {
			kept[kc] = g.res[i];
			kc++;
		}
		i++;
	}
	for k in kc {
		g.res[k] = kept[k];
	}
	g.n = kc;
	g.steps += g.n + 1;
	out.i = kc;
	out.s.clear();
	format(out.s, "selected running values: ", kc);
