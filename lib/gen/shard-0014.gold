code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start_idx = ${start_idx};
	let end_idx = ${end_idx};
	if start_idx < 0 || end_idx >= g.n || start_idx > end_idx {
		gold_fail(g, "invalid index bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bounds");
		return out;
	}
	var sum = 0;
	var i = start_idx;
	while i <= end_idx {
		sum += g.res[i];
		i++;
	}
	g.steps += end_idx - start_idx + 1;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed prefix between indices giving ", sum);
	out
}
