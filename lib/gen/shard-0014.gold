fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	if n > 2 {
		var i = 1;
		while i < n - 1 {
			var j = i + 1;
			while j < n - 1 {
				if out.s[j] < out.s[i] {
					let tmp = out.s[i];
					out.s[i] = out.s[j];
					out.s[j] = tmp;
				}
				j++;
			}
			i++;
		}
	}
	g.steps += n;
	out.i = n;
	out
}
