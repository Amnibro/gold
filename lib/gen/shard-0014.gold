code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var m = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_diff = if diff >= 0 { diff } else { -diff };
		if abs_diff >= mg {
			g.res[m] = g.res[i];
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = m;
	out.s.clear();
	format(out.s, "found gaps count: ", m);
	out
}
@end
