expect: => i=4 r=0.0 ok=true s="flooded trees around center" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: tree1 cone 3.371,-0.158,.5 3.371,-0.158,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree2 cone 0.872,-2.336,.5 0.872,-2.336,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree3 cone 1.333,1.129,.5 1.333,1.129,3 r.8 nz.05:.3 m:matte #2f5f3a
