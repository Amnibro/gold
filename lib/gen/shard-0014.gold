fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mb = ${max_budget};
	var u int[512] = [0; 512];
	var un = 0;
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < un {
			if u[j] == x { seen = true; break; }
			j++;
		}
		if !seen {
			if sum + x <= mb {
				u[un] = x;
				un++;
				sum += x;
			} else {
				break;
			}
		}
