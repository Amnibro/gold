fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${ceiling};
	var clamped = 0;
	if out.s.len > 1 {
		for i in 0..(out.s.len - 1) {
			let pair_sum = (out.s[i] as int) + (out.s[i + 1] as int);
			gold_cache_put(g, i, pair_sum);
			if pair_sum > lim {
				clamped++;
			}
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped pairs: ", clamped);
	out
}
