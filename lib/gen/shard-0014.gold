@entry 62eded15d73b07cb
kind: step
verb: sum
noun: minimum
modifier: while
context: retry
phrase: sum minimum values while accumulated total is under {ceiling}
phrase: accumulate min elements while sum remains below {ceiling}
slot: ceiling int
test: list=5,3,8,2 ceiling=8
expect: => i=5 r=0.0 ok=true s="summed min values under ceiling" errors=0 n=4 res=[5,3,8,2] cache=0 hits=0
test: list=10,20 ceiling=5
expect: => i=0 r=0.0 ok=false s="ceiling reached immediately" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceiling = ${ceiling};
	var sorted = [0; 512];
	for k in g.n {
		sorted[k] = g.res[k];
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if sorted[j] < sorted[i] {
				let tmp = sorted[i];
				sorted[i] = sorted[j];
				sorted[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var sum = 0;
	var count = 0;
	var idx = 0;
	while idx < g.n {
		if sum + sorted[idx] >= ceiling {
			break;
		}
		sum += sorted[idx];
		count++;
		idx++;
	}
	if count == 0 {
		gold_fail(g, "ceiling reached immediately");
		out.ok = false;
		out.s.clear();
		format(out.s, "ceiling reached immediately");
		return out;
	}
	g.steps += count;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed min values under ceiling");
	out
}
@end
@entry 7d86134a9e796724
kind: step
verb: compare
noun: squares
modifier: while
context: retry
phrase: compare squares while indices remain under {bound}
phrase: verify square relations while index is below {bound}
slot: bound int
test: list=2,4,3,9 bound=4
expect: => i=2 r=0.0 ok=true s="verified square relations" errors=0 n=4 res=[2,4,3,9] cache=0 hits=0
test: list=2,5 bound=2
expect: => i=0 r=0.0 ok=false s="square relation mismatch" errors=1 n=2 res=[2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${bound};
	if g.n < 2 {
		gold_fail(g, "need at least two items");
		out.ok = false;
		out.s.clear();
		format(out.s, "need at least two items");
		return out;
	}
	var count = 0;
	var i = 0;
	var ok_squares = true;
	while i + 1 < g.n && i + 1 < bound {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a * a != b {
			ok_squares = false;
			break;
		}
		count++;
		i += 2;
	}
	g.steps += count;
	out.s.clear();
	if ok_squares && count > 0 {
		out.i = count;
		out.ok = true;
		format(out.s, "verified square relations");
	} else {
		gold_fail(g, "square relation mismatch");
		out.i = 0;
		out.ok = false;
		format(out.s, "square relation mismatch");
	}
	out
}
@end
