test: list=4,3,2,1 times=10
expect: => i=6 r=0.0 ok=true s="budgeted swaps completed: 6" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_swaps = ${times};
	var done_swaps = 0;
	var pass = 0;
	while pass < g.n && done_swaps < max_swaps {
		var j = 0;
		while j + 1 < g.n && done_swaps < max_swaps {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
				done_swaps++;
			}
			j++;
		}
		pass++;
	}
	out.i = done_swaps;
	out.s.clear();
	format(out.s, "budgeted swaps completed: ", done_swaps);
	out
}
@end
