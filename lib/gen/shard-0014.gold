fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "need at least two items for pairwise sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "need at least two items for pairwise sum");
		return out;
	}
	var sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		if a > b {
			sum += a;
		} else {
			sum += b;
		}
		i += 2;
	}
	g.steps += g.n / 2;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed maximum pairwise");
	out
}
@end
