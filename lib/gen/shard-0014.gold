fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	var v_count = 0;
	for i in v.s.len {
		let c = v.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			let upper = (c as int - 'a' + 'A') as byte;
			out.s.push(upper);
			v_count++;
		} else {
			out.s.push(c);
		}
	}
	out.i = v_count;
	g.steps += out.s.len + 1;
	out
}
@end
