fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var min_val = g.res[0];
	var max_val = g.res[0];
	for i in 1..g.n {
		let x = g.res[i];
		if x < min_val { min_val = x; }
		if x > max_val { max_val = x; }
	}
	let span = max_val - min_val;
	out.i = span;
	g.steps += g.n + 1;
	out
}
@end
