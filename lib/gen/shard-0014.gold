fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	var start = if g.n > tl { g.n - tl } else { 0 };
	var swaps = 0;
	var i = start;
	while (i + 1) < g.n {
		let tmp = g.res[i];
		g.res[i] = g.res[i + 1];
		g.res[i + 1] = tmp;
		swaps++;
		i += 2;
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "rotated tail pairwise with ", swaps, " swaps");
	out
}
@end
