				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var gap = 0;
	if g.n >= 2 {
		gap = g.res[g.n - 1] - g.res[g.n - 2];
	}
	out.i = gap;
	out.s.clear();
	format(out.s, "last checkpoint gap: ", gap);
	out
}
@end
@entry b14a14950646d0be
kind: step
verb: retry
noun: total
modifier: in_place
context: sort
phrase: retry total in place sort passes up to {max_tries}
phrase: repeat in place sorting passes at most {max_tries} times
slot: max_tries int
test: list=6,5,4,3,2,1 max_tries=4
expect: => i=4 r=0.0 ok=true s="in place passes: 4" errors=0 n=6 res=[2,1,3,4,5,6] cache=0 hits=0
test: list=10,8,6,4 max_tries=8
expect: => i=4 r=0.0 ok=true s="in place passes: 4" errors=0 n=4 res=[4,6,8,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var passes = 0;
	while passes < limit {
		var clean = true;
		var idx = 0;
		while idx + 1 < g.n {
			if g.res[idx] > g.res[idx + 1] {
				let tmp = g.res[idx];
				g.res[idx] = g.res[idx + 1];
				g.res[idx + 1] = tmp;
				clean = false;
			}
			idx++;
		}
		passes++;
		if clean {
			break;
		}
	}
	out.i = passes;
	out.s.clear();
	format(out.s, "in place passes: ", passes);
	out
}
@end
