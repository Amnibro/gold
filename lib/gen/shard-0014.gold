@entry 186e04d46ec8b7ac
kind: step
verb: repeat
noun: window
modifier: unique
context: math
phrase: duplicate unique values within sliding window {k}
phrase: repeat distinct elements in window size {k}
slot: k int
test: list=1,2,2,3,4 k=3
expect: => i=4 r=0.0 ok=true s="window unique added: 4" errors=0 n=9 res=[1,2,2,3,4,1,2,3,4] cache=0 hits=0
test: list=5,5,6,7 k=2
expect: => i=3 r=0.0 ok=true s="window unique added: 3" errors=0 n=7 res=[5,5,6,7,5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let win = ${k};
	var added = 0;
	let orig_n = g.n;
	var i = 0;
	while i < orig_n {
		let end = if i + win > orig_n { orig_n } else { i + win };
		for j in i..end {
			let val = g.res[j];
			var seen = false;
			for m in i..j {
				if g.res[m] == val {
					seen = true;
					break;
				}
			}
			if !seen {
				gold_push(g, val);
				added++;
			}
		}
		i += win;
	}
	out.i = added;
	out.s.clear();
	format(out.s, "window unique added: ", added);
	out
}
@end
