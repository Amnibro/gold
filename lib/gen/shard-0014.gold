fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${prefix_k};
	var limit = if k < g.n { k } else { g.n };
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += limit * limit + 1;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted first ", limit, " items");
	out
}
