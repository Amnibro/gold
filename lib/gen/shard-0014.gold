@entry 6c276f82f4f675f3
kind: step
verb: fill
noun: number
modifier: pairwise
context: core
phrase: fill pairwise sums between adjacent elements
phrase: insert intermediate pairwise sum values
test: list=1,3,5
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,4,3,8,5] cache=0 hits=0
test: list=10,20
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 && g.n * 2 - 1 <= 512 {
		let new_n = g.n * 2 - 1;
		var src = g.n - 1;
		var dst = new_n - 1;
		while src > 0 {
			g.res[dst] = g.res[src];
			g.res[dst - 1] = g.res[src] + g.res[src - 1];
			dst -= 2;
			src--;
		}
		g.n = new_n;
		out.i = new_n;
	}
	g.steps += g.n + 1;
	out
}
@end
