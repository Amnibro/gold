fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var swaps = 0;
	if out.s.len >= 2 {
		var i = out.s.len - 1;
		while i >= 1 {
			let tmp = out.s[i];
			out.s[i] = out.s[i - 1];
			out.s[i - 1] = tmp;
			swaps++;
			if i >= 2 { i -= 2; } else { break; }
		}
	}
	g.steps += swaps + 1;
	out.i = swaps;
	out
}
