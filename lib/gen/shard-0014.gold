test: list=5,15 max_tries=1
expect: => i=2 r=0.0 ok=true s="merged history items: 2" errors=0 n=2 res=[5,15] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var added = 0;
	for k in g.n {
		let x = g.res[k];
		var tries = 0;
		while tries < limit {
			let val, ok = gold_cache_get(g, x);
			if ok {
				break;
			} else {
				gold_cache_put(g, x, k);
				added++;
				break;
			}
			tries++;
		}
	}
	out.i = added;
	out.s.clear();
	format(out.s, "merged history items: ", added);
	out
}
@end
@entry 4257a49953b64a31
kind: step
verb: reverse
noun: runs
modifier: in_place
context: cache
phrase: reverse contiguous cache run segments in place
phrase: invert cache runs directly in place
test: list=1,2,3,4,5,6
expect: => i=3 r=0.0 ok=true s="reversed run length: 3" errors=0 n=6 res=[3,2,1,4,5,6] cache=6 hits=0
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="reversed run length: 2" errors=0 n=4 res=[20,10,30,40] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let mid = g.cn / 2;
	if mid > 1 {
		var left = 0;
		var right = mid - 1;
		while left < right {
			let tk = g.ck[left];
			let tv = g.cv[left];
			g.ck[left] = g.ck[right];
			g.cv[left] = g.cv[right];
			g.ck[right] = tk;
			g.cv[right] = tv;
			left++;
			right--;
		}
	}
	for i in g.cn {
		g.res[i] = g.cv[i];
	}
	g.n = g.cn;
	out.i = mid;
	out.s.clear();
	format(out.s, "reversed run length: ", mid);
	out
}
@end
