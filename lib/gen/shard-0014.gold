@entry a8fa1e20e7085e0b
kind: step
verb: validate
noun: spaces
modifier: sorted
context: search
phrase: validate search spaces are sorted
phrase: verify sorted order of search gaps
test: list=2,5,9,15
expect: => i=1 r=0.0 ok=true s="search gaps sorted: 1" errors=0 n=4 res=[2,5,9,15] cache=0 hits=0
test: list=10,20,25,40
expect: => i=0 r=0.0 ok=false s="search gaps sorted: 0" errors=0 n=4 res=[10,20,25,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 1;
		out.ok = true;
		out.s.clear();
		format(out.s, "trivially sorted spaces");
		return out;
	}
	var is_sorted = true;
	var prev_gap = g.res[1] - g.res[0];
	var i = 1;
	while i < g.n - 1 {
		let cur_gap = g.res[i + 1] - g.res[i];
		if cur_gap < prev_gap {
			is_sorted = false;
			break;
		}
		prev_gap = cur_gap;
		i++;
	}
	g.steps += g.n;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "search gaps sorted: ", out.i);
	out
}
@end
