code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var temp int[512] = [0; 512];
	var count = 0;
	var i = g.n - 1;
	while i >= 0 {
		if g.res[i] <= lim {
			temp[count] = g.res[i];
			count++;
		}
		i--;
	}
	for j in count {
		g.res[j] = temp[j];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "limited value in reverse: ", count);
	out
}
@end
