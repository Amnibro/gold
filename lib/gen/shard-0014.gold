@entry 6e0376e396c91015
kind: step
verb: run
noun: streak
modifier: with_cache
context: loop
phrase: run longest streak check with cache slot {slot_idx}
phrase: track max streak with cache recording in slot {slot_idx}
slot: slot_idx int
test: list=1,1,2,2,2,3 slot_idx=12
expect: => i=3 r=0.0 ok=true s="max streak was 3 saved to cache 12" errors=0 n=6 res=[1,1,2,2,2,3] cache=1 hits=0
test: list= slot_idx=12
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slot_idx = ${slot_idx};
	if g.n == 0 {
		gold_fail(g, "empty list has no streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_streak = 1;
	var curr_streak = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == g.res[i - 1] {
			curr_streak++;
			if curr_streak > max_streak {
				max_streak = curr_streak;
			}
		} else {
			curr_streak = 1;
		}
		i++;
	}
	gold_cache_put(g, slot_idx, max_streak);
	g.steps += g.n;
	out.i = max_streak;
	out.ok = true;
	out.s.clear();
	format(out.s, "max streak was ", max_streak, " saved to cache ", slot_idx);
	out
}
@end
@entry 45b0e9926235c0ce
kind: step
verb: apply
noun: digits
modifier: between
context: loop
phrase: apply offset {delta} to digits between bounds {low} to {high}
phrase: modify digits between value bounds {low} to {high} by {delta}
slot: low int
slot: high int
slot: delta int
test: list=2,5,8,12 low=3 high=9 delta=10
expect: => i=2 r=0.0 ok=true s="modified 2 items between bounds" errors=0 n=4 res=[2,15,18,12] cache=0 hits=0
test: list=1,2,3 low=10 high=2 delta=5
expect: => i=0 r=0.0 ok=false s="error: invalid bounds" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	let delta = ${delta};
	if low > high {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bounds");
		return out;
	}
	var modified = 0;
	for k in g.n {
		if g.res[k] >= low && g.res[k] <= high {
			g.res[k] = g.res[k] + delta;
			modified++;
		}
	}
	g.steps += g.n;
	out.i = modified;
	out.ok = true;
	out.s.clear();
	format(out.s, "modified ", modified, " items between bounds");
	out
}
@end
