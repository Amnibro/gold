@entry 7300ca5088a7260a
kind: step
verb: reverse
noun: vowels
modifier: times
context: text
phrase: reverse vowel characters in text {repeats} times
phrase: invert vowel positions in text string {repeats} times
slot: repeats int
test: text="hello world" repeats=1
expect: => i=3 r=0.0 ok=true s="hollo werld" errors=0 n=0 res=[] cache=0 hits=0
test: text="education" repeats=2
expect: => i=5 r=0.0 ok=true s="education" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	var v_idxs int[200] = [0; 200];
	var v_cnt = 0;
	for i in out.s.len {
		let c = out.s[i];
		let is_v = c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
		           c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
		if is_v && v_cnt < 200 {
			v_idxs[v_cnt] = i;
			v_cnt++;
		}
	}
	if r % 2 != 0 {
		var i = 0;
		while i < v_cnt / 2 {
			let idx1 = v_idxs[i];
			let idx2 = v_idxs[v_cnt - 1 - i];
			let tmp = out.s[idx1];
			out.s[idx1] = out.s[idx2];
			out.s[idx2] = tmp;
			i++;
		}
	}
	g.steps += v_cnt + 1;
	out.i = v_cnt;
	out
}
@end
