noun: list
modifier: with_retry
context: cache
phrase: swap cache list order with retry limit {max_tries}
phrase: exchange cache elements to match list with retry {max_tries}
slot: max_tries int
test: list=10,20,30,40 max_tries=2
expect: => i=2 r=0.0 ok=true s="swapped cache list items: 2" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5,15,25 max_tries=1
expect: => i=1 r=0.0 ok=true s="swapped cache list items: 1" errors=0 n=3 res=[5,15,25] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let limit = ${max_tries};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.cn && swaps < limit {
		let tk = g.ck[i];
		let tv = g.cv[i];
		g.ck[i] = g.ck[i + 1];
		g.cv[i] = g.cv[i + 1];
		g.ck[i + 1] = tk;
		g.cv[i + 1] = tv;
		swaps++;
		i += 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped cache list items: ", swaps);
	out
}
@end
