test: list=1,2,3,4
expect: => i=2 r=0.0 ok=true s="rotated tally running remainder: 2" errors=0 n=4 res=[3,4,1,2] cache=0 hits=0
test: list=5,10,15
expect: => i=0 r=0.0 ok=true s="rotated tally running remainder: 0" errors=0 n=3 res=[5,10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		var total = 0;
		var i = 0;
		while i < g.n {
			total += g.res[i];
			i++;
		}
		let shift = ((total % g.n) + g.n) % g.n;
		for s in shift {
			let first = g.res[0];
			var j = 0;
			while j + 1 < g.n {
				g.res[j] = g.res[j + 1];
				j++;
			}
			g.res[g.n - 1] = first;
		}
		out.i = shift;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated tally running remainder: ", out.i);
	out
}
@end
