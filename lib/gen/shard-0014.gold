code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var collisions = 0;
	var inserted = 0;
	for k in g.n {
		let val = g.res[k];
		var exists = false;
		for j in g.cn {
			if g.cv[j] == val {
				exists = true;
				break;
			}
		}
		if exists {
			gold_fail(g, "duplicate cache value conflict");
			collisions++;
		} else {
			gold_cache_put(g, inserted, val);
			inserted++;
		}
	}
	out.i = inserted;
	out.ok = collisions == 0;
	out.s.clear();
	format(out.s, "unique cache entries: ", inserted);
	out
}
@end
