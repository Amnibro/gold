fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var mb = ${min_bin};
	var count = 0;
	var retried = false;
	for i in g.n {
		if g.res[i] >= mb { count++; }
	}
	if count == 0 && mb > 1 {
		mb /= 2;
		retried = true;
		for i in g.n {
			if g.res[i] >= mb { count++; }
		}
	}
	g.steps += g.n + 1;
	out.i = count;
	out.ok = (count > 0);
	out.s.clear();
	format(out.s, "histogram returned ", count, " matches");
	out
}
@end
