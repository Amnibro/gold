code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		if !${p}(gap) { break; }
		g.res[count] = gap;
		count++;
		i++;
	}
	g.n = count;
	g.steps += count + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "measured valid gaps: ", count);
	out
}
@end
