fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let start = if count < g.n { g.n - count } else { 0 };
	var total = 0;
	var i = start;
	while i < g.n {
		total += g.res[i];
		i++;
	}
	g.steps += g.n - start + 1;
	out.i = total;
	out.s.clear();
	format(out.s, "scanned last items total: ", total);
	out
}
@end
