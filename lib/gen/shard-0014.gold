noun: threshold
modifier: between
context: text
phrase: rotate characters falling between bounds {min_ch} to {max_ch}
phrase: cyclically shift letters within range {min_ch} to {max_ch}
slot: min_ch text
slot: max_ch text
test: text="azbycxdw" min_ch="b" max_ch="y"
expect: => i=6 r=0.0 ok=true s="azwbycxd" errors=0 n=0 res=[] cache=0 hits=0
test: text="mnoplk" min_ch="l" max_ch="o"
expect: => i=4 r=0.0 ok=true s="lmnpok" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_min = ${min_ch};
	let s_max = ${max_ch};
	var lo: byte = 'a';
	var hi: byte = 'z';
	for b in s_min { lo = b; break; }
	for b in s_max { hi = b; break; }
	var idx: int[512] = [0; 512];
	var val: byte[512] = [' '; 512];
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= lo && c <= hi && count < 512 {
			idx[count] = i;
			val[count] = c;
			count++;
		}
	}
	if count > 1 {
		for j in count {
			let src = (j - 1 + count) % count;
			out.s[idx[j]] = val[src];
		}
	}
	out.i = count;
	out
}
@end
