				max_val = g.res[i];
				max_idx = i;
			}
		}
		gold_cache_put(g, 0, max_val);
		g.res[max_idx] -= d;
		out.i = g.res[max_idx];
	}
	g.steps += g.n + 1;
	out
}
@end
