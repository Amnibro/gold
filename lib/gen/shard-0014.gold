fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let divisor = ${divisor};
	if divisor <= 0 {
		gold_fail(g, "divisor must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid divisor");
		return out;
	}
	g.steps = g.steps / divisor;
	for k in g.n {
		g.res[k] = g.res[k] / divisor;
	}
	out.i = g.steps;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized steps each by ", divisor);
	out
}
@end
