slot: multiplier int
phrase: search scale spaces running factor {multiplier}
phrase: expand whitespace spaces running factor {multiplier}
test: text="a b" multiplier=2
expect: => i=1 r=0.0 ok=true s="a  b" errors=0 n=0 res=[] cache=0 hits=0
test: text="word" multiplier=3
expect: => i=0 r=0.0 ok=true s="word" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mul = ${multiplier};
	var new_s byte[..200] = "";
	var spaces_scaled = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == ' ' {
			var k = 0;
			while k < mul && new_s.len < 190 {
				new_s.push(' ');
				k++;
			}
			spaces_scaled++;
		} else {
			if new_s.len < 199 {
				new_s.push(c);
			}
		}
		i++;
	}
	g.steps += v.s.len + 1;
	out.s = new_s;
	out.i = spaces_scaled;
	out
}
@end
@entry 45a5c83cf7b7b622
kind: step
verb: merge
noun: streak
modifier: nested
context: search
slot: min_streak int
phrase: search merge streak nested length {min_streak}
phrase: compress equal streak nested span {min_streak}
test: list=2,2,2,5,3,3 min_streak=2
expect: => i=3 r=0.0 ok=true s="merged streaks into 3 elements" errors=0 n=3 res=[6,5,6] cache=0 hits=0
test: list=1,2,3 min_streak=2
expect: => i=3 r=0.0 ok=true s="merged streaks into 3 elements" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	if g.n == 0 { return out; }
	var new_n = 0;
	var cur_val = g.res[0];
	var cur_cnt = 1;
	var i = 1;
	while i < g.n {
		if g.res[i] == cur_val {
			cur_cnt++;
		} else {
			if cur_cnt >= ms {
				g.res[new_n] = cur_val * cur_cnt;
			} else {
				for k in cur_cnt { g.res[new_n + k] = cur_val; }
				new_n += (cur_cnt - 1);
			}
			new_n++;
			cur_val = g.res[i];
			cur_cnt = 1;
		}
		i++;
	}
	if cur_cnt >= ms {
		g.res[new_n] = cur_val * cur_cnt;
	} else {
		for k in cur_cnt { g.res[new_n + k] = cur_val; }
		new_n += (cur_cnt - 1);
	}
	new_n++;
	g.steps += g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged streaks into ", new_n, " elements");
	out
}
@end
