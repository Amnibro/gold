kind: step
verb: retry
noun: condition
modifier: pairwise
context: compare
slot: max_gap int
phrase: retry pairwise comparison adjusting elements under gap {max_gap}
phrase: compare adjacent elements retrying adjustments for gap {max_gap}
test: list=1,10,12,25 max_gap=5
expect: => i=3 r=0.0 ok=true s="pairwise gap adjustments: 3" errors=0 n=4 res=[1,6,11,16] cache=0 hits=0
test: list=2,15,18 max_gap=8
expect: => i=1 r=0.0 ok=true s="pairwise gap adjustments: 1" errors=0 n=3 res=[2,10,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var adjustments = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff > mg {
			g.res[i + 1] = g.res[i] + mg;
			adjustments++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjustments;
	out.s.clear();
	format(out.s, "pairwise gap adjustments: ", adjustments);
	out
}
@end
