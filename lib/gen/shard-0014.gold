	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let low = ${lo};
	let high = ${hi};
	var count = 0;
	for i in g.cn {
		let val = g.cv[i];
		if val >= low && val <= high {
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "cached steps in range: ", count);
	out
}
@end
