code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var sum = 0;
	var count = 0;
	while count < g.n && sum + g.res[count] <= limit {
		sum += g.res[count];
		count++;
	}
	if count == 0 {
		gold_fail(g, "limit exceeded at first item");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: limit exceeded");
		return out;
	}
	g.steps += count;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed while under limit: ", sum);
	out
}
@end
