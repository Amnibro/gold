code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var write = 1;
	for i in 1..g.n {
		let x = g.res[i];
		if ${p}(x) {
			for j in i..g.n {
				g.res[write] = g.res[j];
				write++;
			}
			break;
		}
		if x != g.res[i - 1] {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
