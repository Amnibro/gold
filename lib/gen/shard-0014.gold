code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if g.n == 0 {
		gold_fail(g, "empty list has no elements");
		out.ok = false;
		return out;
	}
	var min_val = 1000000000;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no element found between bounds");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	out.i = min_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "minimum between bounds is ", min_val);
	out
}
@end
@entry ec3e9e2c1af8310e
kind: step
verb: rotate
noun: evens
modifier: pairwise
context: compare
phrase: rotate evens pairwise in list
phrase: shift evens pairwise order
test: list=1,2,3,4,5,6
expect: => i=1 r=0.0 ok=true s="rotated 1 even pairs" errors=0 n=6 res=[1,4,3,2,5,6] cache=0 hits=0
test: list=1,3,5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idx int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			idx[count] = i;
			count++;
		}
	}
	if count < 2 {
		gold_fail(g, "not enough even numbers to rotate pairwise");
		out.ok = false;
		return out;
	}
	var pairs = 0;
	var k = 0;
	while k + 1 < count {
		let i1 = idx[k];
		let i2 = idx[k + 1];
		let tmp = g.res[i1];
		g.res[i1] = g.res[i2];
		g.res[i2] = tmp;
		pairs++;
		k += 2;
	}
	g.steps += pairs;
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated ", pairs, " even pairs");
	out
}
@end
