fn ${ID}(n int) int {
	let b = ${budget};
	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	var res = 0;
	var sum = 0;
	while rev > 0 {
		let d = rev % 10;
