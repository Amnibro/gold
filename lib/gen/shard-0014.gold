fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let py = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * 8.0;
		let px = if q % 2 == 0 { 3.5 } else { -3.5 };
		o.clear();
