expect: => i=1 r=0.0 ok=true s="window match found: true" errors=0 n=5 res=[1,2,4,6,3] cache=0 hits=0
test: list=1,2,3,4,5 win_size=2 test_fn=is_even
expect: => i=0 r=0.0 ok=false s="window match found: false" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	var found = false;
	if w > 0 && g.n >= w {
		var i = 0;
		while (i + w) <= g.n {
			var all_match = true;
			var j = 0;
			while j < w {
				if !${test_fn}(g.res[i + j]) {
					all_match = false;
					break;
				}
				j++;
			}
			if all_match {
				found = true;
				break;
			}
			i++;
		}
	}
	g.steps += g.n + 1;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "window match found: ", found);
	out
}
@end
