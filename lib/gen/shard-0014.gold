@entry 81333a7a57202531
kind: step
verb: sum
noun: suffix
modifier: at_least
context: format
phrase: format suffix elements summing to at least {target}
phrase: render trailing elements reaching sum of at least {target}
slot: target int
test: list=1,2,3,4,5,6 target=10
expect: => i=11 r=0.0 ok=true s="suffix_sum=11:[5,6]" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=2,4,6,8 target=12
expect: => i=14 r=0.0 ok=true s="suffix_sum=14:[6,8]" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var sum = 0;
	var start = g.n;
	var i = g.n - 1;
	while i >= 0 {
		sum += g.res[i];
		start = i;
		if sum >= tgt { break; }
		i--;
	}
	out.s.clear();
	format(out.s, "suffix_sum=", sum, ":[");
	for k in start..g.n {
		if k > start { out.s.push(','); }
		format(out.s, g.res[k]);
	}
	out.s.push(']');
	out.i = sum;
	g.steps += g.n + 1;
	out
}
@end
