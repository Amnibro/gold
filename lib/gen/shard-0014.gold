fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var letters = 0;
	var i = g.n - 1;
	while i >= 0 {
		let c = g.res[i];
		let is_alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
		if is_alpha { letters++; }
		i--;
	}
	g.steps += g.n;
	out.i = letters;
	out.s.clear();
	format(out.s, "counted letters in reverse: ", letters);
	out
}
