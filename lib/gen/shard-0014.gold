code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	var avg = sum / g.n;
	if avg < l { avg = l; }
	else if avg > h { avg = h; }
	out.i = avg;
	g.steps += g.n + 1;
	out
}
@end
