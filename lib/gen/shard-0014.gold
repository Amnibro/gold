@entry 2f63ace1b9566554
kind: step
verb: collect
noun: window
modifier: with_retry
context: format
phrase: format sliding window collection with retry
phrase: render window partitions with retry check
slot: win_size int
test: list=1,2,3,4,5 win_size=3
expect: => i=3 r=0.0 ok=true s="windows:(1,2,3)->(2,3,4)->(3,4,5)" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 win_size=2
expect: => i=3 r=0.0 ok=true s="windows:(10,20)->(20,30)->(30,40)" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	out.s.clear();
	out.s.append("windows:");
	var count = 0;
	if ws > 0 && g.n >= ws {
		var i = 0;
		while i <= g.n - ws {
			if count > 0 { out.s.append("->"); }
			out.s.push('(');
			for j in ws {
				if j > 0 { out.s.push(','); }
				format(out.s, g.res[i + j]);
			}
			out.s.push(')');
			count++;
			i++;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out
}
@end
