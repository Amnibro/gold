expect: => i=0 r=0.0 ok=true s="found 0 runs of length at least 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_len};
	var qual_runs = 0;
	if g.n > 0 {
		var cur_len = 1;
		var i = 1;
		while i < g.n {
			if g.res[i] == g.res[i - 1] {
				cur_len++;
			} else {
				if cur_len >= m { qual_runs++; }
				cur_len = 1;
			}
			i++;
		}
		if cur_len >= m { qual_runs++; }
	}
	g.steps += g.n + 1;
	out.i = qual_runs;
	out.s.clear();
	format(out.s, "found ", qual_runs, " runs of length at least ", m);
	out
}
@end
@entry ea1b25fb98ac010b
kind: step
verb: clamp
noun: pairs
modifier: pairwise
context: stats
slot: max_diff int
phrase: stats clamp pairs pairwise difference {max_diff}
phrase: bound consecutive pairs pairwise delta {max_diff}
test: list=10,30,35,70 max_diff=15
expect: => i=2 r=0.0 ok=true s="clamped 2 pairwise deltas" errors=0 n=4 res=[10,25,35,50] cache=0 hits=0
test: list=5,8,12 max_diff=10
expect: => i=0 r=0.0 ok=true s="clamped 0 pairwise deltas" errors=0 n=3 res=[5,8,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var clamped = 0;
	var i = 1;
	while i < g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > md {
			g.res[i] = g.res[i - 1] + md;
			clamped++;
		} else if diff < -md {
			g.res[i] = g.res[i - 1] - md;
			clamped++;
		}
		i++;
	}
	g.steps += g.n + 1;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped ", clamped, " pairwise deltas");
	out
}
@end
