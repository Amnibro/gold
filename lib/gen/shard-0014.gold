code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${r} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
		let frac = q as real * (6.283 / ${n} as real);
		let px = ${r} * cos(frac);
		let py = ${r} * sin(frac);
		o.clear();
		gold_dnews(g, "crater", "", o);
		o.append(" ellipsoid ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",-0.2 ");
		o.append("1.5,");
		o.append("1.5,");
		o.append("0.4 ");
		o.append("~1.1 m:matte ");
		gold_hex(o, 110, 105, 100);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "satellite craters");
	out
}
@end
