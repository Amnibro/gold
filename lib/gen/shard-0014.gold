fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_val = g.res[g.n - 1];
	var best_len = 1;
	var cur_val = g.res[g.n - 1];
	var cur_len = 1;
	var i = g.n - 2;
	while i >= 0 {
		if g.res[i] == cur_val {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_val = cur_val;
			}
		} else {
			cur_val = g.res[i];
			cur_len = 1;
		}
		i--;
	}
	gold_clear(g);
	for k in best_len {
		gold_push(g, best_val);
	}
	g.steps += g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "reverse streak length: ", best_len);
	out
}
@end
