@entry 0302a3abe5203fe7
kind: step
verb: fill
noun: minimum
modifier: sorted
context: transform
phrase: fill minimum values in sorted sequence up to {floor}
phrase: ensure minimum threshold {floor} across sorted items
slot: floor int
test: list=8,2,6,1 floor=4
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[4,4,6,8] cache=0 hits=0
test: list=15,3,9,12 floor=10
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[10,10,12,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fl = ${floor};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var filled = 0;
	for k in g.n {
		if g.res[k] < fl {
			g.res[k] = fl;
			filled++;
		}
	}
	out.i = filled;
	g.steps += g.n + 1;
	out
}
@end
@entry 819354818a38005c
kind: step
verb: apply
noun: step
modifier: none
context: transform
phrase: apply step transformation {f} to all items
phrase: map step function {f} over elements
slot: f fn
test: list=1,2,3 f=double
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=4,5,6 f=square
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[16,25,36] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var modified = 0;
	var idx = 0;
	while idx < g.n {
		let orig = g.res[idx];
		let updated = ${f}(orig);
		g.res[idx] = updated;
		if updated != orig { modified++; }
		idx++;
	}
	out.i = modified;
	g.steps += modified + 1;
	out
}
@end
