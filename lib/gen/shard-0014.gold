@entry 4c7b7105ce278630
kind: step
verb: dedupe
noun: items
modifier: pairwise
context: math
phrase: remove adjacent duplicate items across results
phrase: dedupe consecutive pairwise elements in list
test: list=1,1,2,3,3,3,4
expect: => i=3 r=0.0 ok=true s="removed pairwise duplicates: 3" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6,7,8,8
expect: => i=2 r=0.0 ok=true s="removed pairwise duplicates: 2" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 {
		out.i = g.n;
		return out;
	}
	var write = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[write - 1] {
			g.res[write] = g.res[i];
			write++;
		}
	}
	let removed = g.n - write;
	g.n = write;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed pairwise duplicates: ", removed);
	out
}
@end
