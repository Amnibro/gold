code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	let reps = ${min_reps};
	var matched int[256] = [0; 256];
	var match_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi && match_cnt < 256 {
			matched[match_cnt] = x;
			match_cnt++;
		}
	}
	var r = 1;
	while r < reps {
		var j = 0;
		while j < match_cnt && g.n < 256 {
			gold_push(g, matched[j]);
			j++;
		}
		r++;
	}
	g.steps += g.n + match_cnt;
	out.i = g.n;
	out.s.clear();
	format(out.s, "range repeated items total: ", g.n);
	out
}
@end
