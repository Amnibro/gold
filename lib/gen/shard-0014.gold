expect: => i=3 r=0.0 ok=true s="scanned gaps count: 3" errors=0 n=3 res=[2,3,3] cache=0 hits=0
test: list=20,5,10 max_gap=6
expect: => i=1 r=0.0 ok=true s="scanned gaps count: 1" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let limit = ${max_gap};
	var write = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let gap = g.res[idx + 1] - g.res[idx];
		if gap <= limit {
			g.res[write] = gap;
			write++;
		}
		idx++;
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "scanned gaps count: ", write);
	out
}
@end
