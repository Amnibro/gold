code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let limit = if k < g.n { k } else { g.n };
	var i = 0;
	while i < limit / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[limit - 1 - i];
		g.res[limit - 1 - i] = tmp;
		i++;
	}
	g.steps += limit + 1;
	out.i = limit;
	out.s.clear();
	format(out.s, "reversed leading history items: ", limit);
	out
}
@end
