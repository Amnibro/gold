@entry e6063b82442637aa
kind: step
verb: drop
noun: pairs
modifier: every_other
context: retry
phrase: drop every other adjacent pair from retry list
phrase: remove alternating pairs every other step in history
test: list=1,2,3,4,5,6
expect: => i=0 r=0.0 ok=true s="dropped every other pair leaving 4 items" errors=0 n=4 res=[1,2,5,6] cache=0 hits=0
test: list=10,20
expect: => i=0 r=0.0 ok=true s="dropped every other pair leaving 2 items" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot drop from empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var new_res = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n {
		// drop items at odd pairs (e.g. index 2,3 in pairs (0,1), (2,3), (4,5))
		let pair_idx = i / 2;
		if pair_idx % 2 == 0 {
			new_res[new_n] = g.res[i];
			new_n++;
		}
		i++;
	}
	var k = 0;
	while k < new_n {
		g.res[k] = new_res[k];
		k++;
	}
	g.n = new_n;
	g.steps++;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped every other pair leaving ", new_n, " items");
	out
}
@end
