expect: => i=6 r=0.0 ok=true s="nested repeated items: 6" errors=0 n=6 res=[10,10,10,20,20,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rep = ${count};
	if rep <= 1 || g.n == 0 {
		out.i = g.n;
		return out;
	}
	var temp int[256] = [0; 256];
	let orig = if g.n < 100 { g.n } else { 100 };
	for k in orig { temp[k] = g.res[k]; }
	g.n = 0;
	for k in orig {
		var r = 0;
		while r < rep && g.n < 256 {
			gold_push(g, temp[k]);
			r++;
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "nested repeated items: ", g.n);
	out
}
@end
