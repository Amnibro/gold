fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var idxs int[..64] = [];
	for i in out.s.len {
		let b = out.s[i];
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			idxs.push(i);
		}
	}
	for i in idxs.len / 2 {
		let a = idxs[i];
		let b = idxs[idxs.len - 1 - i];
		let tmp = out.s[a];
		out.s[a] = out.s[b];
		out.s[b] = tmp;
	}
	out.i = idxs.len;
	out
}
@end
