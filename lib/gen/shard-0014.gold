test: list=3,7,1,9
expect: => i=5 r=0.0 ok=true s="pairwise min sum 5" errors=0 n=3 res=[3,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var temp int[512] = [0; 512];
	var m = 0;
	var tot = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		let min_v = if a < b { a } else { b };
		temp[m] = min_v;
		tot += min_v;
		m++;
		i++;
	}
	for k in m { g.res[k] = temp[k]; }
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "pairwise min sum ", tot);
	out
}
@end
