phrase: subtract running minimum plus offset {offset} from list
slot: offset int
test: list=5,8,3,10 offset=2
expect: => i=4 r=0.0 ok=true s="applied running minimum shift" errors=0 n=4 res=[0,3,-2,5] cache=0 hits=0
test: list= offset=2
expect: => i=0 r=0.0 ok=false s="empty list cannot shift running minimum" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let offset = ${offset};
	if g.n == 0 {
		gold_fail(g, "empty list cannot shift running minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "empty list cannot shift running minimum");
		return out;
	}
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	let sub = min_val + offset;
	for k in g.n {
		g.res[k] = g.res[k] - sub;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied running minimum shift");
	out
}
@end
