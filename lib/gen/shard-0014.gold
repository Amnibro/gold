fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if !gold_img_square(g, 4) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = gold_vnoise(x, y, 4, g.iw / 4, ${u});
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.3 + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * 6.0) as! int;
		if t > 5 { t = 5; }
		g.img[k] = (t as real) / 5.0;
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
