noun: primes
modifier: unique
context: compare
phrase: return primes unique list
phrase: extract primes unique values
test: list=2,3,4,2,5,6,7,7
expect: => i=4 r=0.0 ok=true s="found 4 unique primes" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no primes");
		out.ok = false;
		return out;
	}
	var temp int[512] = [0; 512];
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				var seen = false;
				for j in m {
					if temp[j] == x {
						seen = true;
						break;
					}
				}
				if !seen {
					temp[m] = x;
					m++;
				}
			}
		}
	}
	if m == 0 {
		gold_fail(g, "no primes found in list");
		out.ok = false;
		return out;
	}
	for j in m {
		g.res[j] = temp[j];
	}
	g.n = m;
	g.steps += m;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "found ", m, " unique primes");
	out
}
@end
