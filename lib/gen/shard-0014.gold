kind: step
verb: clamp
noun: threshold
modifier: pairwise
context: math
slot: th int
phrase: clamp threshold pairwise comparing adjacent items with {th}
phrase: pairwise clamp values across threshold {th}
test: list=10,20,30,40 th=35
expect: => i=2 r=0.0 ok=true s="clamped threshold pairwise: 2" errors=0 n=4 res=[10,20,15,20] cache=0 hits=0
test: list=5,50,5,50 th=25
expect: => i=2 r=0.0 ok=true s="clamped threshold pairwise: 2" errors=0 n=4 res=[5,20,5,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${th};
	var modified = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] + g.res[i + 1] > limit {
			g.res[i + 1] = limit - g.res[i];
			modified++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = modified;
	out.s.clear();
	format(out.s, "clamped threshold pairwise: ", modified);
	out
}
@end
