code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var ucount = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			sum += x;
			ucount++;
		}
	}
	out.i = if ucount > 0 { sum / ucount } else { 0 };
	g.steps += g.n + 1;
	out
}
@end
