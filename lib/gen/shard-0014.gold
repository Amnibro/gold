expect: => i=3 r=0.0 ok=true s="sorted streak length: 3" errors=0 n=5 res=[10,5,15,20,30] cache=0 hits=0
test: list=1,8,6,4,2 count=4
expect: => i=4 r=0.0 ok=true s="sorted streak length: 4" errors=0 n=5 res=[1,2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if k > g.n { 0 } else { g.n - k };
	if g.n - start > 1 {
		for i in start..g.n {
			for j in (i + 1)..g.n {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	let len = g.n - start;
	out.i = len;
	out.s.clear();
	format(out.s, "sorted streak length: ", len);
	out
}
@end
