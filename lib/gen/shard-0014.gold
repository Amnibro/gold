test: list=5,1,3
expect: => i=4 r=0.0 ok=true s="sorted and measured streak span 4" errors=0 n=3 res=[1,3,5] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list cannot fill streak");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let span = g.res[g.n - 1] - g.res[0];
	g.steps += g.n;
	out.i = span;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted and measured streak span ", span);
	out
}
@end
