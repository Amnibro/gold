kind: step
verb: dedupe
noun: values
modifier: with_cache
context: error
slot: max_duplicates int
phrase: dedupe values with cache allowing at most {max_duplicates} errors
phrase: compact duplicate values with cache error bound {max_duplicates}
test: list=1,1,2,2,3,4 max_duplicates=5
expect: => i=2 r=0.0 ok=true s="deduped values within error allowance: 2" errors=0 n=4 res=[1,2,3,4] cache=4 hits=2
test: list=1,1,1,1,2,2 max_duplicates=2
expect: => i=0 r=0.0 ok=false s="error: duplicate count exceeds error allowance" errors=1 n=6 res=[1,2,1,1,2,2] cache=2 hits=4
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_duplicates};
	var new_n = 0;
	var dups = 0;
	for i in g.n {
		let x = g.res[i];
		let _, found = gold_cache_get(g, x);
		if found {
			dups++;
		} else {
			gold_cache_put(g, x, 1);
			g.res[new_n] = x;
			new_n++;
		}
	}
	if dups > md {
		gold_fail(g, "duplicate count exceeds error allowance");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: duplicate count exceeds error allowance");
		return out;
	}
	g.n = new_n;
	g.steps += g.n + dups;
	out.i = dups;
	out.s.clear();
	format(out.s, "deduped values within error allowance: ", dups);
	out
}
@end
