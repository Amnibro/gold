test: arg=53421,789
expect: 534
expect: 789
test: arg=9876,12
expect: 9
expect: 12
code:
fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var changed = true;
	while changed && x >= 10 {
		let last = x % 10;
		let prev = (x / 10) % 10;
		if last < prev {
			x /= 10;
		} else {
			changed = false;
		}
	}
	if n < 0 { -x } else { x }
}
@end
