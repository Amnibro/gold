noun: squares
modifier: sorted
context: compare
slot: factor int
phrase: compare squared values scaling elements in sorted order by {factor}
phrase: scale squares of elements producing sorted sequence with factor {factor}
test: list=3,1,4,2 factor=2
expect: => i=4 r=0.0 ok=true s="scaled sorted squares count: 4" errors=0 n=4 res=[2,8,18,32] cache=0 hits=0
