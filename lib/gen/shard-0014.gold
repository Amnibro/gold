code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 0 {
		let last = g.res[g.n - 1];
		var rank = 1;
		for i in g.n {
			if g.res[i] < last {
				rank++;
			}
		}
		out.i = rank;
		gold_push(g, rank);
	} else {
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "last element rank: ", out.i);
	out
}
@end
