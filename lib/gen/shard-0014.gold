@entry e458e7caee6e0594
kind: step
verb: group
noun: primes
modifier: in_reverse
context: loop
phrase: group prime numbers arranged in reverse order
phrase: collect primes ordered in reverse across loop
test: list=2,4,3,6,5,8,7
expect: => i=4 r=0.0 ok=true s="grouped 4 primes in reverse" errors=0 n=4 res=[7,5,3,2] cache=0 hits=0
test: list=4,6,8,9
expect: => i=0 r=0.0 ok=false s="no primes found" errors=1 n=4 res=[4,6,8,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = [0; 512];
	var pn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				primes[pn] = x;
				pn++;
			}
		}
		i++;
	}
	if pn == 0 {
		gold_fail(g, "no primes found");
		out.ok = false;
		out.s.clear();
		format(out.s, "no primes found");
		return out;
	}
	for k in pn {
		g.res[k] = primes[pn - 1 - k];
	}
	g.n = pn;
	g.steps += pn;
	out.i = pn;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped ", pn, " primes in reverse");
	out
}
@end
