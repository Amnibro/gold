phrase: order checkpoint entries recording error state to cache
test: list=40,10,30,20
expect: => i=4 r=0.0 ok=true s="sorted checkpoint count: 4" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
test: list=5
expect: => i=0 r=0.0 ok=false s="error: cannot sort trivial checkpoint" errors=1 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "cannot sort trivial checkpoint");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cannot sort trivial checkpoint");
		return out;
	}
	for k in g.n { gold_cache_put(g, k, g.res[k]); }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted checkpoint count: ", g.n);
	out
}
@end
@entry 09c130b0b2c47f13
kind: step
verb: rotate
noun: budget
modifier: with_retry
context: error
slot: budget int
slot: attempts int
phrase: rotate budget elements with retry count {attempts} ceiling {budget}
phrase: cycle budget positions with retry limit {attempts} checking {budget}
test: list=10,20,30,40 budget=50 attempts=2
expect: => i=0 r=0.0 ok=false s="error: budget exceeded" errors=1 n=4 res=[10,20,30,40] cache=0 hits=0
test: list=10,20 budget=100 attempts=0
expect: => i=0 r=0.0 ok=false s="error: retry attempts exhausted" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	let att = ${attempts};
	if att <= 0 {
		gold_fail(g, "retry attempts exhausted");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry attempts exhausted");
		return out;
	}
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	if sum > b {
		gold_fail(g, "budget exceeded");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: budget exceeded");
		return out;
	}
	if g.n > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "rotated within budget total: ", sum);
	out
}
@end
