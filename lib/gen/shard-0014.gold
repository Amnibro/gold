@entry 849d41034167b103
kind: step
verb: compare
noun: duplicates
modifier: none
context: loop
phrase: compare elements verifying none are duplicates
phrase: check that no duplicate items exist in loop
test: list=1,2,3,4,5
expect: => i=5 r=0.0 ok=true s="all items unique none are duplicates" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=1,2,3,2,5
expect: => i=0 r=0.0 ok=false s="duplicate found in loop" errors=1 n=5 res=[1,2,3,2,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_dups = false;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] == g.res[j] {
				has_dups = true;
				break;
			}
			j++;
		}
		if has_dups {
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.s.clear();
	if !has_dups {
		out.i = g.n;
		out.ok = true;
		format(out.s, "all items unique none are duplicates");
	} else {
		gold_fail(g, "duplicate found in loop");
		out.i = 0;
		out.ok = false;
		format(out.s, "duplicate found in loop");
	}
	out
}
@end
