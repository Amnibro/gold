fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sv = ${shift_val};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n > 0 {
		let mid = g.n / 2;
		g.res[mid] += sv;
		out.i = g.res[mid];
	} else {
		out.ok = false;
	}
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "shifted median to ", out.i);
	out
}
@end
