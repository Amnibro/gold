code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var min_val = 1000000000;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		if x <= cap {
			if !found || x < min_val {
				min_val = x;
				found = true;
			}
		}
	}
	if !found {
		gold_fail(g, "no element found at or below cap");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	out.i = min_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "minimum at most cap is ", min_val);
	out
}
@end
@entry 93cea0fe18c5dca9
kind: step
verb: rotate
noun: limit
modifier: nested
context: compare
phrase: rotate limit nested bound {lim}
phrase: shift limit nested threshold {lim}
slot: lim int
test: list=1,2,3,4,5 lim=3
expect: => i=3 r=0.0 ok=true s="rotated prefix of size 3" errors=0 n=5 res=[3,1,2,4,5] cache=0 hits=0
test: list=1,2 lim=0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if lim <= 1 || g.n < 2 {
		gold_fail(g, "invalid limit or not enough elements to rotate");
		out.ok = false;
		return out;
	}
	var m = lim;
	if m > g.n {
		m = g.n;
	}
	let last = g.res[m - 1];
	var i = m - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += m;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated prefix of size ", m);
	out
}
@end
