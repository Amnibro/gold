@entry a36ab0bc3962f8a0
kind: step
verb: shift
noun: items
modifier: between
context: loop
phrase: shift items between index {start_pos} to {end_pos} by offset {delta}
phrase: add delta {delta} to items between positions {start_pos} to {end_pos}
slot: start_pos int
slot: end_pos int
slot: delta int
test: list=1,2,3,4,5 start_pos=1 end_pos=3 delta=10
expect: => i=3 r=0.0 ok=true s="shifted 3 items between positions" errors=0 n=5 res=[1,12,13,14,5] cache=0 hits=0
test: list=1,2 start_pos=2 end_pos=1 delta=10
expect: => i=0 r=0.0 ok=false s="error: invalid bounds" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let start_pos = ${start_pos};
	let end_pos = ${end_pos};
	let delta = ${delta};
	if start_pos < 0 || end_pos >= g.n || start_pos > end_pos {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bounds");
		return out;
	}
	var i = start_pos;
	while i <= end_pos {
		g.res[i] = g.res[i] + delta;
		i++;
	}
	let count = end_pos - start_pos + 1;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "shifted ", count, " items between positions");
	out
}
@end
