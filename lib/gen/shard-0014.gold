code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_space byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let ch = out.s[i];
		if ch != 32 {
			non_space.push(ch);
		}
		i++;
	}
	out.s.clear();
	var j = non_space.len - 1;
	while j >= 0 {
		out.s.push(non_space[j]);
		j--;
	}
	g.steps += out.s.len;
	out.i = out.s.len;
	out
}
@end
