fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lower};
	let hi = ${upper};
	for i in g.n {
		gold_cache_put(g, i, g.res[i]);
	}
	var all_valid = true;
	for i in g.cn {
		let val = g.cv[i];
		if val < lo || val > hi {
			all_valid = false;
			break;
		}
	}
	g.steps += g.cn;
	out.ok = all_valid;
	out.i = if all_valid { 1 } else { 0 };
	out.s.clear();
	format(out.s, "memo values within bounds: ", out.i);
	out
}
@end
