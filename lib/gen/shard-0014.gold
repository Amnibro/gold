fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list cannot sort tally");
		out.ok = false;
		return out;
	}
	for i in g.n {
		for j in (g.n - 1 - i) {
			if g.res[j] < g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted tally descending of size ", g.n);
	out
}
@end
