expect: => i=5 r=0.0 ok=true s="uniq:[1,2,3,4,5]" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,10,20,30,30
expect: => i=3 r=0.0 ok=true s="uniq:[10,20,30]" errors=0 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("uniq:[");
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			if write > 0 { out.s.push(','); }
			format(out.s, x);
			g.res[write] = x;
			write++;
		}
	}
	out.s.push(']');
	g.n = write;
	out.i = write;
	g.steps += g.n + 1;
	out
}
@end
