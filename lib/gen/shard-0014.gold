expect: => i=5 r=0.0 ok=true s="filtered histogram count: 5" errors=0 n=5 res=[1,1,3,3,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	var kept int[512] = [0; 512];
	var km = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var freq = 0;
		var j = 0;
		while j < g.n {
			if g.res[j] == x { freq++; }
			j++;
		}
		if freq >= mc {
			kept[km] = x;
			km++;
		}
		i++;
	}
	for idx in km {
		g.res[idx] = kept[idx];
	}
	g.n = km;
	g.steps += g.n * 2;
	out.i = km;
	out.s.clear();
	format(out.s, "filtered histogram count: ", km);
	out
}
@end
