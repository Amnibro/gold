fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let start = if count > g.n { 0 } else { g.n - count };
	let orig_n = g.n;
	var added = 0;
	for i in start..orig_n {
		if g.n + 2 <= 512 {
			let val = g.res[i];
			gold_push(g, val);
			gold_push(g, val);
			added += 2;
		}
	}
	out.i = added;
	out.s.clear();
	format(out.s, "repeated suffix pairs: ", added);
	out
}
@end
