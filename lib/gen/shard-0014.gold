@entry 628725132af39c34
kind: step
verb: dedupe
noun: counter
modifier: last
context: loop
phrase: dedupe counter last keeping final occurrences
phrase: keep last occurrence dedupe counter in loop
test: list=1,2,1,3,2
expect: => i=3 r=0.0 ok=true s="deduped keeping last: 3" errors=0 n=3 res=[1,3,2] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no counter elements");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var temp int[512] = [0; 512];
	var m = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		for j in m { if temp[j] == x { seen = true; break; } }
		if !seen { temp[m] = x; m++; }
		i--;
	}
	for j in m { g.res[j] = temp[m - 1 - j]; }
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "deduped keeping last: ", m);
	out
}
@end
