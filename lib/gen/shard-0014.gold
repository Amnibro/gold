expect: => i=4 r=0.0 ok=true s="filtered duplicates in reverse: 4" errors=0 n=4 res=[3,2,1,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var un = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < un {
			if u[j] == x { seen = true; break; }
			j++;
		}
		if !seen {
			u[un] = x;
			un++;
		}
		i--;
	}
	for k in un {
		g.res[k] = u[un - 1 - k];
	}
	g.n = un;
	g.steps += g.n + un;
	out.i = un;
	out.s.clear();
	format(out.s, "filtered duplicates in reverse: ", un);
	out
}
@end
