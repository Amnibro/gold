@entry b2d1df2f840b39e5
kind: step
verb: drop
noun: minimum
modifier: times
context: text
phrase: drop lowest ascii character up to limit {times} occurrences
phrase: remove minimum byte occurrences capped at limit {times}
slot: times int
test: text="banana" times=2
expect: => i=2 r=0.0 ok=true s="bnna" errors=0 n=0 res=[] cache=0 hits=0
test: text="cba" times=1
expect: => i=1 r=0.0 ok=true s="cb" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${times};
	if out.s.len == 0 || lim <= 0 { g.steps++; return out; }
	var min_c = out.s[0];
	for i in 1..out.s.len {
		if out.s[i] < min_c { min_c = out.s[i]; }
	}
	var kept byte[..200] = "";
	var dropped = 0;
	for i in out.s.len {
		if out.s[i] == min_c && dropped < lim {
			dropped++;
		} else {
			if kept.len < 200 { kept.push(out.s[i]); }
		}
	}
	out.s.clear();
	for b in kept { out.s.push(b); }
	out.i = dropped;
	g.steps += out.s.len + 1;
	out
}
@end
