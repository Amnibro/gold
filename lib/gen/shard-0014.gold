code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in g.n {
			for j in i + 1..g.n {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	var total = 0;
	for i in g.n { total += g.res[i]; }
	out.i = total;
	g.steps += g.n + 1;
	out
}
@end
