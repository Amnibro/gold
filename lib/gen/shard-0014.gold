code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("tally:[");
	var unique_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var count = 0;
			for k in g.n {
				if g.res[k] == x { count++; }
			}
			if unique_count > 0 { out.s.push(','); }
			format(out.s, x, ":", count);
			unique_count++;
		}
	}
	out.s.push(']');
	out.i = unique_count;
	g.steps += g.n + 1;
	out
}
@end
