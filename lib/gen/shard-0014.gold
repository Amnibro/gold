code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	let limit = if b < g.n { b } else { g.n };
	var i = 0;
	while i < limit / 2 {
		let tmp = g.res[i];
		g.res[i] = g.res[limit - 1 - i];
		g.res[limit - 1 - i] = tmp;
		i++;
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "reversed sequence prefix: ", limit);
	out
}
@end
