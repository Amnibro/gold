fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${start};
	let from_idx = if req < 0 { 0 } else { req };
	if from_idx < g.n {
		var i = from_idx;
		while i < g.n {
			var j = i + 1;
			while j < g.n {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
				j++;
			}
			i++;
		}
		out.i = g.n - from_idx;
	} else {
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "sorted tail elements count: ", out.i);
	out
}
@end
@entry 82e66166cb85f856
kind: step
verb: validate
noun: maximum
modifier: nested
context: math
slot: ceiling int
phrase: validate maximum nested confirming values remain below {ceiling}
phrase: check maximum nested items stay under bound {ceiling}
test: list=5,12,18,9 ceiling=20
expect: => i=18 r=0.0 ok=true s="maximum nested within ceiling: 18" errors=0 n=4 res=[5,12,18,9] cache=0 hits=0
test: list=10,25,15 ceiling=20
expect: => i=25 r=0.0 ok=false s="maximum exceeds ceiling: 25" errors=0 n=3 res=[10,25,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var max_v = 0;
	if g.n > 0 {
		max_v = g.res[0];
		var i = 1;
		while i < g.n {
			if g.res[i] > max_v {
				max_v = g.res[i];
			}
			i++;
		}
	}
	let ok = max_v <= ceil;
	g.steps += g.n;
	out.ok = ok;
	out.i = max_v;
	out.s.clear();
	if ok {
		format(out.s, "maximum nested within ceiling: ", max_v);
	} else {
		format(out.s, "maximum exceeds ceiling: ", max_v);
	}
	out
}
@end
