code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u int[512] = [0; 512];
	var un = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in un {
			if u[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			u[un] = x;
			un++;
		}
	}
	if un == 0 {
		out.ok = false;
		return out;
	}
	let mid = u[un / 2];
	gold_clear(g);
	gold_push(g, mid);
	out.i = mid;
	out.s.clear();
	format(out.s, "normalized middle unique: ", mid);
	out
}
@end
