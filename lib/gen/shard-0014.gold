fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_count = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq > 1 {
			var first = -1;
			for k in g.n {
				if g.res[k] == x {
					first = k;
					break;
				}
			}
			if first == i {
				dup_count++;
				gold_push(g, x);
			}
		}
	}
	out.i = dup_count;
	out.s.clear();
	format(out.s, "duplicates found: ", dup_count);
	out
}
@end
