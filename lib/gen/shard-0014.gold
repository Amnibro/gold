code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_attempts = ${max_attempts};
	if g.n == 0 || max_attempts <= 0 {
		gold_fail(g, "cannot normalize minimum of empty buffer");
		out.ok = false;
		out.s.clear();
		format(out.s, "cannot normalize minimum of empty buffer");
		return out;
	}
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
		}
	}
	for k in g.n {
		g.res[k] = g.res[k] - min_val;
	}
	g.steps += g.n;
	out.i = min_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized minimum with retry attempts");
	out
}
@end
