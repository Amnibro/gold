@entry 101af19027023548
kind: step
verb: clamp
noun: duplicates
modifier: last
context: math
phrase: clamp last duplicate occurrence under ceiling {ceiling}
phrase: bound final duplicate item with ceiling {ceiling}
slot: ceiling int
test: list=10,20,10,30 ceiling=5
expect: => i=5 r=0.0 ok=true s="clamped last duplicate: 5" errors=0 n=4 res=[10,20,5,30] cache=0 hits=0
test: list=50,60,70,60 ceiling=40
expect: => i=40 r=0.0 ok=true s="clamped last duplicate: 40" errors=0 n=4 res=[50,60,70,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var last_dup_idx = -1;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x {
				freq++;
			}
		}
		if freq > 1 {
			last_dup_idx = i;
		}
	}
	if last_dup_idx >= 0 {
		if g.res[last_dup_idx] > ceil {
			g.res[last_dup_idx] = ceil;
		}
		out.i = g.res[last_dup_idx];
	} else {
		out.i = -1;
	}
	out.s.clear();
	format(out.s, "clamped last duplicate: ", out.i);
	out
}
@end
