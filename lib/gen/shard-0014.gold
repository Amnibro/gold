code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${min_gap};
	var adjusted = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff < mg {
			g.res[i + 1] = g.res[i] + mg;
			adjusted++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = adjusted;
	out.s.clear();
	format(out.s, "expanded spaces: ", adjusted);
	out
}
@end
