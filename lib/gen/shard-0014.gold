fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${interval};
	var write = 0;
	var i = 0;
	let eff = if step < 1 { 1 } else { step };
	while i < g.n {
		g.res[write] = g.res[i];
		write++;
		i += eff;
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "checkpoints count: ", write);
	out
}
@end
