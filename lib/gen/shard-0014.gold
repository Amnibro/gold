@entry e5f342ee5c4a74ae
kind: step
verb: split
noun: list
modifier: in_reverse
context: format
phrase: format list split elements in reverse
phrase: render reversed split partitions of list
slot: part_len int
test: list=1,2,3,4,5,6 part_len=2
expect: => i=3 r=0.0 ok=true s="[5,6]|[3,4]|[1,2]" errors=0 n=6 res=[1,2,3,4,5,6] cache=0 hits=0
test: list=10,20,30,40 part_len=2
expect: => i=2 r=0.0 ok=true s="[30,40]|[10,20]" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${part_len};
	out.s.clear();
	if pl <= 0 || g.n == 0 { return out; }
	var i = g.n;
	var parts = 0;
	while i > 0 {
		let start = if i >= pl { i - pl } else { 0 };
		if parts > 0 { out.s.push('|'); }
		out.s.push('[');
		for k in start..i {
			if k > start { out.s.push(','); }
			format(out.s, g.res[k]);
		}
		out.s.push(']');
		parts++;
		i = start;
	}
	out.i = parts;
	g.steps += parts + 1;
	out
}
@end
