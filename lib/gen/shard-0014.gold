fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i + 1 < g.n {
		let prod = g.res[i] * g.res[i + 1];
		gold_cache_put(g, i, prod);
		g.res[i] = prod;
		i += 2;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled list pairs with cache");
	out
}
@end
