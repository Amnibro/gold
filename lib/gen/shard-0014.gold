expect: => i=3 r=0.0 ok=true s="reversed square items count: 3" errors=0 n=5 res=[49,8,25,30,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	var sq_idx int[256] = [0; 256];
	var sq_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var rt = 0;
			while rt * rt < x { rt++; }
			if rt * rt == x && sq_cnt < 256 {
				sq_idx[sq_cnt] = i;
				sq_cnt++;
			}
		}
	}
	if r % 2 != 0 {
		var i = 0;
		while i < sq_cnt / 2 {
			let idx1 = sq_idx[i];
			let idx2 = sq_idx[sq_cnt - 1 - i];
			let tmp = g.res[idx1];
			g.res[idx1] = g.res[idx2];
			g.res[idx2] = tmp;
			i++;
		}
	}
	g.steps += sq_cnt + 1;
	out.i = sq_cnt;
	out.s.clear();
	format(out.s, "reversed square items count: ", sq_cnt);
	out
}
@end
