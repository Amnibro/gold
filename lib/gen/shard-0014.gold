kind: step
verb: pair
noun: middle
modifier: at_most
context: error
phrase: pair middle error elements at most {max_pairs} times
phrase: form adjacent middle pairs under limit {max_pairs}
slot: max_pairs int
test: list=1,2,3,4,5,6 max_pairs=2
expect: => i=1 r=0.0 ok=true s="paired middle elements: 1" errors=0 n=5 res=[1,2,7,5,6] cache=0 hits=0
test: list=1,2 max_pairs=1
expect: => i=0 r=0.0 ok=false s="middle range error" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_pairs};
	if g.n < 3 || limit <= 0 {
		gold_fail(g, "insufficient elements to pair middle or invalid limit");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("middle range error");
		return out;
	}
	let mid = g.n / 2;
	var paired = 0;
	if mid > 0 && mid < g.n && paired < limit {
		let sum = g.res[mid - 1] + g.res[mid];
		g.res[mid - 1] = sum;
		for k in mid .. g.n - 1 {
			g.res[k] = g.res[k + 1];
		}
		g.n--;
		paired++;
	}
	out.i = paired;
	out.ok = true;
	out.s.clear();
	format(out.s, "paired middle elements: ", paired);
	out
}
@end
@entry 1e15225a47949bf5
kind: step
verb: keep
noun: threshold
modifier: pairwise
context: error
phrase: keep adjacent pairs satisfying threshold {min_diff}
phrase: filter pairwise elements meeting difference threshold {min_diff}
slot: min_diff int
test: list=10,15,30,45 min_diff=10
expect: => i=1 r=0.0 ok=true s="kept valid pairs: 1" errors=0 n=2 res=[30,45] cache=0 hits=0
test: list=10 min_diff=5
expect: => i=0 r=0.0 ok=false s="insufficient elements for pairwise check" errors=1 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let diff = ${min_diff};
	if g.n < 2 {
		gold_fail(g, "pairwise threshold filter requires at least two elements");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("insufficient elements for pairwise check");
		return out;
	}
	var kept_pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		let d = g.res[i + 1] - g.res[i];
		let abs_d = if d < 0 { -d } else { d };
		if abs_d >= diff {
			g.res[kept_pairs * 2] = g.res[i];
			g.res[kept_pairs * 2 + 1] = g.res[i + 1];
			kept_pairs++;
		}
		i += 2;
	}
	g.n = kept_pairs * 2;
	out.i = kept_pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "kept valid pairs: ", kept_pairs);
	out
}
@end
