expect: => i=1 r=0.0 ok=true s="clamped numbers sorted: 1" errors=0 n=4 res=[3,5,10,20] cache=0 hits=0
test: list=50,30,10 floor_val=5 ceil_val=40
expect: => i=0 r=0.0 ok=false s="clamped numbers sorted: 0" errors=0 n=3 res=[40,30,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${floor_val};
	let hi = ${ceil_val};
	for i in g.n {
		var x = g.res[i];
		if x < lo { x = lo; }
		if x > hi { x = hi; }
		g.res[i] = x;
	}
	var sorted = true;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			sorted = false;
			break;
		}
		i++;
	}
	g.steps += g.n;
	out.ok = sorted;
	out.i = if sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "clamped numbers sorted: ", out.i);
	out
}
@end
