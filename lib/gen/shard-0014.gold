test: u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var c0 = 4;
	for o in 2 { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = 4;
			for o in 2 { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	var s_slp = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s_slp[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s_slp;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(g.img[k] * 0.9); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
