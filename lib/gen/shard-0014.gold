code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let take = ${take};
	if take <= 0 || take > g.n {
		gold_fail(g, "take exceeds list size");
		out.ok = false;
		out.s.clear();
		format(out.s, "take exceeds list size");
		return out;
	}
	var sum = 0;
	var i = g.n - take;
	while i < g.n {
		sum += g.res[i];
		i++;
	}
	g.steps += take;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "processed last tail items");
	out
}
