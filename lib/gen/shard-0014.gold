code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	var w = 0;
	for i in g.n {
		if g.res[i] <= lim {
			g.res[w] = g.res[i];
			w++;
		}
	}
	g.n = w;
	out.i = w;
	out.s.clear();
	format(out.s, "limited series none exceeding: ", w);
	out
}
@end
