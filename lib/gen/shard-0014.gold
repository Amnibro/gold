		gold_fail(g, "target key cannot be negative");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: negative target");
		return out;
	}
	let val, found = gold_cache_get(g, target);
	if !found {
		gold_cache_put(g, target, g.n);
	}
	g.steps++;
	out.i = if found { val } else { g.n };
	out.ok = true;
	out.s.clear();
	format(out.s, "cache search complete for: ", target);
	out
}
