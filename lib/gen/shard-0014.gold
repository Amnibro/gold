				pairs++;
				gold_push(g, i);
				i += 2;
			} else {
				i++;
			}
		}
	}
	g.steps += v.s.len + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "found ", pairs, " vowel pairs up to limit");
	out
}
