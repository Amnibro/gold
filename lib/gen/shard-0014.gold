fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pat = ${needle};
	var found = -1;
	if pat.len > 0 && pat.len <= out.s.len {
		for i in (out.s.len - pat.len + 1) {
			var ok = true;
			for j in pat.len {
				if out.s[i + j] != pat[j] {
					ok = false;
					break;
				}
			}
			if ok {
				found = i;
				break;
			}
		}
	}
	out.i = found;
	gold_push(g, found);
	out.s.clear();
	format(out.s, "search text offset: ", found);
	out
}
@end
