fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_occ};
	var counts: int[256] = [0; 256];
	for i in out.s.len {
		let c = out.s[i] as int;
		if c < 256 {
			counts[c]++;
		}
	}
	var write = 0;
	for i in out.s.len {
		let c = out.s[i] as int;
		if c < 256 && counts[c] >= lim {
			gold_cache_put(g, c, counts[c]);
			out.s[write] = out.s[i];
			write++;
		}
	}
	out.s.resize(write, ' ');
	out.i = write;
	out
}
@end
