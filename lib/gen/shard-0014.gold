@entry a91e3063c88aba0b
kind: step
verb: limit
noun: gaps
modifier: pairwise
context: aggregate
phrase: limit pairwise gaps to maximum {max_gap}
phrase: restrict adjacent difference to {max_gap}
slot: max_gap int
test: list=2,10,25 max_gap=5
expect: => i=12 r=0.0 ok=true s="" errors=0 n=3 res=[2,7,12] cache=0 hits=0
test: list=4,20,40 max_gap=8
expect: => i=20 r=0.0 ok=true s="" errors=0 n=3 res=[4,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n < 2 { return out; }
	for i in 1..g.n {
		let diff = g.res[i] - g.res[i - 1];
		if diff > mg {
			g.res[i] = g.res[i - 1] + mg;
		}
	}
	out.i = g.res[g.n - 1];
	g.steps += g.n + 1;
	out
}
@end
