expect: => i=2 r=0.0 ok=true s="helllo" errors=0 n=0 res=[] cache=0 hits=0
test: text="aaabbb" tail_len=3
expect: => i=2 r=0.0 ok=true s="aaab" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tail_len};
	let start = if k > out.s.len { 0 } else { out.s.len - k };
	var write = start;
	for i in start..out.s.len {
		if write == start || out.s[i] != out.s[write - 1] {
			out.s[write] = out.s[i];
			write++;
		}
	}
	let removed = out.s.len - write;
	out.s.resize(write, ' ');
	out.i = removed;
	out
}
@end
