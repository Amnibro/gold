fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${count};
	var matches = 0;
	if g.n > 0 {
		let last_val = g.res[g.n - 1];
		let start = if g.n > c { g.n - c } else { 0 };
