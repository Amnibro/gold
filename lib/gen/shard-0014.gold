code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var retries = 0;
	var start = if g.n > 3 { g.n - 3 } else { 0 };
	var i = start;
	while i < g.n {
		var res = ${op_fn}(g.res[i]);
		if res < 0 {
			res = -res;
			retries++;
		}
		g.res[i] = res;
		i++;
	}
	g.steps += (g.n - start) + 1;
	out.i = retries;
	out.s.clear();
	format(out.s, "ran suffix with ", retries, " retry fixes");
	out
}
@end
