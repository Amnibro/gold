@entry 8afba9eb65fd9198
kind: pred
verb: check
noun: limit
modifier: pairwise
context: aggregate
phrase: check limit pairwise bounded {limit}
phrase: pairwise limit difference check {limit}
slot: limit int
test: arg=1234,159 limit=2
expect: true
expect: false
test: arg=5 limit=1
expect: true
code:
fn ${ID}(n int) bool {
	let lim = ${limit};
	var x = if n < 0 { -n } else { n };
	var prev = x % 10;
	x /= 10;
	while x > 0 {
		let curr = x % 10;
		let diff = if curr > prev { curr - prev } else { prev - curr };
		if diff > lim {
			return false;
		}
		prev = curr;
		x /= 10;
	}
	true
}
@end
