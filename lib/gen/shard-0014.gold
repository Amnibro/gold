expect: => i=1 r=0.0 ok=true s="clamped items count: 1" errors=0 n=3 res=[5,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let d = ${delta};
	let lo = out.i - d;
	let hi = out.i + d;
	var changed = 0;
	for i in g.n {
		let orig = g.res[i];
		var x = orig;
		if x < lo { x = lo; }
		if x > hi { x = hi; }
		if x != orig { changed++; }
		g.res[i] = x;
	}
	g.steps += g.n;
	out.i = changed;
	out.s.clear();
	format(out.s, "clamped items count: ", changed);
	out
}
@end
