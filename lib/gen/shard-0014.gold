fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid_gaps = 0;
	if g.n >= 2 {
		for i in 1..g.n {
			let d = g.res[i] - g.res[i - 1];
			let ad = if d < 0 { -d } else { d };
			if ad <= mg { valid_gaps++; }
		}
	}
	out.i = valid_gaps;
	g.steps += g.n + 1;
	out
}
