fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${tail_count};
	let k = if tc > g.n { g.n } else { tc };
	let start = g.n - k;
	var temp int[512] = [0; 512];
	for i in k {
		temp[i] = g.res[start + i];
	}
	var a = 0;
	while a < k {
		var b = a + 1;
		while b < k {
			if temp[b] < temp[a] {
				let tmp = temp[a];
				temp[a] = temp[b];
				temp[b] = tmp;
			}
			b++;
		}
		a++;
	}
	for i in k {
		g.res[i] = temp[i];
	}
	g.n = k;
	g.steps += g.n;
	out.i = k;
	out.s.clear();
	format(out.s, "extracted sorted tail items: ", k);
	out
}
