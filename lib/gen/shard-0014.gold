code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let b = ${budget};
	let count = ${ID}_rec(g, 0, b);
	out.i = count;
	out.s.clear();
	format(out.s, "recursive budget count: ", count);
	out
}

recursive fn ${ID}_rec(g Gold&, idx int, rem int) int {
	if idx >= g.n { return 0; }
	if g.res[idx] > rem { return 0; }
	1 + ${ID}_rec(g, idx + 1, rem - g.res[idx])
}
@end
