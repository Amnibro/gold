expect: => i=0 r=0.0 ok=false s="rotated memo at least check: 0" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${min_len};
	if g.n >= bound && g.n > 1 {
		let first = g.res[0];
		var i = 0;
		while i + 1 < g.n {
			g.res[i] = g.res[i + 1];
			i++;
		}
		g.res[g.n - 1] = first;
		out.ok = true;
		out.i = 1;
	} else {
		out.ok = false;
		out.i = 0;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "rotated memo at least check: ", out.i);
	out
}
@end
