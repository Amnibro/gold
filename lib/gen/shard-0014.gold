code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let me = ${max_entries};
	for i in g.n {
		let x = g.res[i];
		let cur, found = gold_cache_get(g, x);
		let next_c = if found { cur + 1 } else { 1 };
		gold_cache_put(g, x, next_c);
	}
	if g.cn > me {
		gold_fail(g, "counter exceeds cache limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: counter exceeds cache limit");
		return out;
	}
	g.steps += g.n + g.cn;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "counter tracked within limit: ", g.cn);
	out
}
@end
@entry 281ca4e04fed3d0d
kind: step
verb: dedupe
noun: digits
modifier: running
context: error
slot: max_len int
phrase: dedupe digits running progression bounded by {max_len}
