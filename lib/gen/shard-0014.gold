code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fv = ${fill_val};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var filled = 0;
	if g.n > 1 {
		var orig int[512] = [0; 512];
		for k in g.n { orig[k] = g.res[k]; }
		let orig_n = g.n;
		var new_n = 0;
		for k in orig_n {
			g.res[new_n] = orig[k];
			new_n++;
			if k + 1 < orig_n && orig[k + 1] > orig[k] + 1 && new_n < 512 {
				g.res[new_n] = fv;
				new_n++;
				filled++;
			}
		}
		g.n = new_n;
	}
	g.steps += g.n + 1;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " spaces in sorted order");
	out
}
@end
