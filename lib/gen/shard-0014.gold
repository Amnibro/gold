expect: => i=6 r=0.0 ok=true s="abcdef" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello"
expect: => i=3 r=0.0 ok=true s="hel" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var seen int = 0;
	var cut = out.s.len;
	for i in out.s.len {
		let bit = 1 << ((out.s[i] as int) % 32);
		if (seen & bit) != 0 {
			cut = i;
			break;
		}
		seen |= bit;
	}
	out.s.resize(cut, ' ');
	out.i = cut;
	g.steps += out.s.len + 1;
	out
}
@end
