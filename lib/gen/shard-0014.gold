			s_blur[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_blur;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * ${a} + 0.5); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
