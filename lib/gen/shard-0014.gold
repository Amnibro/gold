@entry e768b23b7a9c9fe8
kind: step
verb: reverse
noun: runs
modifier: each
context: compare
slot: min_len int
phrase: compare monotonic runs reversing each segment exceeding length {min_len}
phrase: reverse each identified run within sequence based on length {min_len}
test: list=1,2,3,2,1,0 min_len=2
expect: => i=1 r=0.0 ok=true s="reversed runs: 1" errors=0 n=6 res=[3,2,1,2,1,0] cache=0 hits=0
test: list=5,6,7,4,3,2 min_len=3
expect: => i=1 r=0.0 ok=true s="reversed runs: 1" errors=0 n=6 res=[7,6,5,4,3,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_l = ${min_len};
	var runs_reversed = 0;
	var start = 0;
	while start < g.n {
		var end = start + 1;
		while end < g.n && g.res[end] >= g.res[end - 1] {
			end++;
		}
		let len = end - start;
		if len >= min_l {
			var l = start;
			var r = end - 1;
			while l < r {
				let tmp = g.res[l];
				g.res[l] = g.res[r];
				g.res[r] = tmp;
				l++;
				r--;
			}
			runs_reversed++;
		}
		start = end;
	}
	g.steps += g.n + runs_reversed;
	out.i = runs_reversed;
	out.s.clear();
	format(out.s, "reversed runs: ", runs_reversed);
	out
}
@end
