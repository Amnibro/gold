code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	g.steps++;
	if g.errors > 0 {
		out.ok = false;
		out.i = g.errors;
		out.s.clear();
		format(out.s, "errors detected: ", g.errors);
	} else {
		out.ok = true;
		out.i = 0;
		out.s.clear();
		format(out.s, "no math errors");
	}
	out
}
@end
@entry 2e5c2b531cb4b504
kind: step
verb: trace
noun: histogram
modifier: with_cache
context: math
phrase: trace histogram with cache recording frequency counts
phrase: record histogram frequencies using cache store
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="histogram cached distinct items: 3" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=3
test: list=5,5,6,7,7
expect: => i=3 r=0.0 ok=true s="histogram cached distinct items: 3" errors=0 n=5 res=[5,5,6,7,7] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		let count, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, count + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
		i++;
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "histogram cached distinct items: ", g.cn);
	out
}
@end
