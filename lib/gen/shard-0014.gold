fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mult = ${count};
	let orig_n = g.n;
	var temp int[256];
	var i = 0;
	while i < orig_n && i < 256 {
		temp[i] = g.res[i];
		i++;
	}
	gold_clear(g);
	var j = 0;
	while j < orig_n {
		var run_len = 1;
		while j + run_len < orig_n && temp[j + run_len] == temp[j] {
			run_len++;
		}
		let total_reps = run_len * mult;
		for r in total_reps {
			gold_push(g, temp[j]);
		}
		j += run_len;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated runs any count: ", g.n);
	out
}
