		return out;
	}
	let memo = g.res[g.n - 1] * factor;
	gold_cache_put(g, slot_idx, memo);
	g.steps += g.n;
	out.i = memo;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached memo scaled ", factor, " times value ", memo);
	out
}
@end
