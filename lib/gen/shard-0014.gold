kind: step
verb: find
noun: digits
modifier: sorted
context: aggregate
phrase: find digits sorted from text string
phrase: aggregate digit characters sorted into sequence
test: text="item 42 and 17"
expect: => i=14 r=0.0 ok=true s="sorted digits sum 14" errors=0 n=4 res=[1,2,4,7] cache=0 hits=0
test: text="test 905"
expect: => i=14 r=0.0 ok=true s="sorted digits sum 14" errors=0 n=3 res=[0,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var digits int[512] = [0; 512];
	var m = 0;
	var tot = 0;
	for b in out.s {
		if b >= '0' && b <= '9' {
			let d = (b - '0') as int;
			digits[m] = d;
			tot += d;
			m++;
		}
	}
	for i in m {
		var j = 0;
		while j + 1 < m - i {
			if digits[j] > digits[j + 1] {
				let t = digits[j];
				digits[j] = digits[j + 1];
				digits[j + 1] = t;
			}
			j++;
		}
	}
