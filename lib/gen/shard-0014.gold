expect: => i=1 r=0.0 ok=true s="clamped items until threshold count: 1" errors=0 n=3 res=[50,55,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	let th = ${threshold};
	if c <= 0 {
		gold_fail(g, "invalid clamp ceiling");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid clamp ceiling");
		return out;
	}
	var clamped = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > th { break; }
		if g.res[i] > c {
			g.res[i] = c;
			clamped++;
		}
		i++;
	}
	g.steps += i + clamped;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped items until threshold count: ", clamped);
	out
}
@end
