fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var tries = 0;
	while tries < limit {
		var sorted = true;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				sorted = false;
			}
			i++;
		}
		tries++;
		if sorted {
			break;
		}
	}
	g.steps += tries;
	out.i = tries;
	out.s.clear();
	format(out.s, "sort step passes: ", tries);
