@entry defaf9fd433432e6
kind: step
verb: reverse
noun: odds
modifier: all
context: stats
slot: modulus int
phrase: stats reverse odds all modulus {modulus}
phrase: invert odd parity all modulus {modulus}
test: list=1,2,3,4,5 modulus=100
expect: => i=3 r=0.0 ok=true s="reversed 3 odd elements" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=2,4,6 modulus=100
expect: => i=0 r=0.0 ok=true s="reversed 0 odd elements" errors=0 n=3 res=[2,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${modulus};
	var odds_count = 0;
	var odd_indices int[512] = [0; 512];
	var odd_vals int[512] = [0; 512];
	var on = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			odd_indices[on] = i;
			odd_vals[on] = x;
			on++;
			odds_count++;
		}
	}
	for k in on {
		let idx = odd_indices[k];
		g.res[idx] = odd_vals[on - 1 - k] % m;
	}
	g.steps += g.n + on + 1;
	out.i = odds_count;
	out.s.clear();
	format(out.s, "reversed ", odds_count, " odd elements");
	out
}
@end
