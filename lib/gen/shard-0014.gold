test: list=18,4,12,30,8 min_streak=5 max_streak=25
expect: => i=3 r=0.0 ok=true s="sorted items in streak bounds: 3" errors=0 n=5 res=[4,8,12,18,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_streak};
	let hi = ${max_streak};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	var in_range = 0;
	i = 0;
	while i < g.n {
		if g.res[i] >= lo && g.res[i] <= hi {
			in_range++;
		}
		i++;
	}
	g.steps += g.n * g.n;
	out.i = in_range;
	out.s.clear();
	format(out.s, "sorted items in streak bounds: ", in_range);
	out
}
@end
