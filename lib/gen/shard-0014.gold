test: list= max_retry=2
expect: => i=0 r=0.0 ok=false s="no items to run digit sum" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_retry = ${max_retry};
	if g.n == 0 || max_retry <= 0 {
		gold_fail(g, "no items to run digit sum");
		out.ok = false;
		out.s.clear();
		format(out.s, "no items to run digit sum");
		return out;
	}
	var sum = 0;
	for k in g.n {
		var x = g.res[k];
		if x < 0 {
			x = -x;
		}
		while x > 0 {
			sum += x % 10;
			x /= 10;
		}
	}
	g.steps += g.n;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "summed digits with retry budget");
	out
}
@end
