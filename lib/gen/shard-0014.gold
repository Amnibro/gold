fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	let start = if l < 0 { 0 } else { l };
	let end = if h >= g.n { g.n - 1 } else { h };
	if start <= end && start < g.n {
		var max_val = g.res[start];
		for i in start..(end + 1) {
			if g.res[i] > max_val {
				max_val = g.res[i];
			}
		}
		for i in start..(end + 1) {
			g.res[i] = max_val;
		}
		out.i = max_val;
		out.s.clear();
		format(out.s, "normalized maximum between: ", max_val);
	}
	out
}
@end
