test: list=1,1,1,1,2,2,2 max_len=2 retries=3
expect: => i=4 r=0.0 ok=true s="clamped streak with retry count: 4" errors=0 n=4 res=[1,1,2,2] cache=0 hits=0
test: list=5,5,5 max_len=1 retries=-1
expect: => i=0 r=0.0 ok=false s="error: retry count exhausted" errors=1 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	let r_max = ${retries};
	if r_max <= 0 {
		gold_fail(g, "retry count exhausted");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: retry count exhausted");
		return out;
	}
	var new_n = 0;
	var cur_run = 0;
	var cur_val = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if i == 0 || x == cur_val {
			cur_run++;
		} else {
			cur_run = 1;
			cur_val = x;
		}
		if cur_run <= ml {
			g.res[new_n] = x;
			new_n++;
		}
		cur_val = x;
		i++;
	}
	g.n = new_n;
	g.steps += g.n + r_max;
	out.i = new_n;
	out.s.clear();
	format(out.s, "clamped streak with retry count: ", new_n);
	out
}
@end
