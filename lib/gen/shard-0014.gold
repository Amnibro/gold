expect: => i=1 r=0.0 ok=true s="swapped cache suffix: 1" errors=0 n=4 res=[10,20,30,40] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let max_swaps = ${limit};
	var swaps = 0;
	var idx = g.cn - 1;
	while idx > 0 && swaps < max_swaps {
		let tmp_k = g.ck[idx];
		let tmp_v = g.cv[idx];
		g.ck[idx] = g.ck[idx - 1];
		g.cv[idx] = g.cv[idx - 1];
		g.ck[idx - 1] = tmp_k;
		g.cv[idx - 1] = tmp_v;
		swaps++;
		idx -= 2;
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped cache suffix: ", swaps);
	out
}
@end
