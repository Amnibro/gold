test: list=1,5,3,9 tail_cnt=2 delta=10
expect: => i=2 r=0.0 ok=true s="shifted 2 tail items" errors=0 n=4 res=[1,3,15,19] cache=0 hits=0
test: list=10,20 tail_cnt=1 delta=-5
expect: => i=1 r=0.0 ok=true s="shifted 1 tail items" errors=0 n=2 res=[10,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tc = ${tail_cnt};
	let d = ${delta};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var start = if g.n > tc { g.n - tc } else { 0 };
	var k = start;
	while k < g.n {
		g.res[k] += d;
		k++;
	}
	g.steps += g.n * g.n + (g.n - start) + 1;
	out.i = g.n - start;
	out.s.clear();
	format(out.s, "shifted ", out.i, " tail items");
	out
}
@end
