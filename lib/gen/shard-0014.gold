noun: list
modifier: running
context: list
phrase: filter list keeping items below running sum {cap}
phrase: retain elements while running total stays under {cap}
slot: cap int
test: list=2,4,6,8,10 cap=15
expect: => i=3 r=0.0 ok=true s="running filter count: 3" errors=0 n=3 res=[2,4,6] cache=0 hits=0
test: list=10,20,30,40 cap=35
expect: => i=2 r=0.0 ok=true s="running filter count: 2" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cap};
	var running = 0;
	var write = 0;
	for i in g.n {
		if running + g.res[i] <= limit {
			running += g.res[i];
			g.res[write] = g.res[i];
			write++;
		} else {
			break;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "running filter count: ", write);
	out
}
@end
