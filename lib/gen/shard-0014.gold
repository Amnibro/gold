code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk_len};
	if c <= 0 || g.n == 0 { return out; }
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum_sq = 0;
		var j = 0;
		while j < c && (i + j) < g.n {
			let x = g.res[i + j];
			sum_sq += x * x;
			j++;
		}
		g.res[new_n] = sum_sq;
		new_n++;
		i += c;
	}
	g.steps += i + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "merged squares into ", new_n, " nested blocks");
	out
}
@end
