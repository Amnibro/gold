@entry 857dfd2c5fa13da1
kind: step
verb: split
noun: maximum
modifier: at_most
context: math
phrase: split maximum element when exceeding limit {cap}
phrase: divide highest value if above threshold {cap}
slot: cap int
test: list=10,30,8 cap=20
expect: => i=30 r=0.0 ok=true s="" errors=0 n=4 res=[10,15,15,8] cache=0 hits=0
test: list=4,8 cap=6
expect: => i=8 r=0.0 ok=true s="" errors=0 n=3 res=[4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${cap};
	if g.n > 0 && g.n < 512 {
		var max_idx = 0;
		var max_val = g.res[0];
		for i in 1..g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
				max_idx = i;
			}
		}
		if max_val > lim {
			let h1 = max_val / 2;
			let h2 = max_val - h1;
			g.res[max_idx] = h1;
			var i = g.n;
			while i > max_idx + 1 {
				g.res[i] = g.res[i - 1];
				i--;
			}
			g.res[max_idx + 1] = h2;
			g.n++;
		}
		out.i = max_val;
	}
	g.steps += g.n + 1;
	out
}
@end
