fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${bound};
	var clamped = 0;
	for i in g.n {
		let val = g.res[i];
		if !${cond}(val) {
			break;
		}
		if val % 2 == 0 && val > limit {
			g.res[i] = limit;
			clamped++;
		}
	}
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped evens: ", clamped);
	out
}
@end
