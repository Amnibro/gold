fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_streak};
	var buf: byte[512] = [' '; 512];
	var blen = 0;
	var i = 0;
	while i < out.s.len {
		let c = out.s[i];
		var run = 0;
		while i < out.s.len && out.s[i] == c {
			run++;
			i++;
		}
		let target = if run < req { req } else { run };
		for k in target {
			if blen < 512 {
				buf[blen] = c;
				blen++;
			}
		}
	}
	out.s.resize(blen, ' ');
	for k in blen {
		out.s[k] = buf[k];
	}
	out.i = blen;
	out
}
