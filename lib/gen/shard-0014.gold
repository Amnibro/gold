fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniform_gaps = true;
	if g.n > 1 {
		let expected = g.res[1] - g.res[0];
		var i = 1;
		while i + 1 < g.n {
			if g.res[i + 1] - g.res[i] != expected {
				uniform_gaps = false;
				break;
