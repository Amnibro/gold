code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p_lo = ${min_p};
	let p_hi = ${max_p};
	var sum = 0;
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if ${ID}_is_prime(x) && x >= p_lo && x <= p_hi {
			sum += x;
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n + m;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded primes sum: ", sum);
	out
}
@end
