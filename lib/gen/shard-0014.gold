fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s_lo = ${lo_char};
	let s_hi = ${hi_char};
	var lo: byte = 'a';
	var hi: byte = 'z';
	for b in s_lo { lo = b; break; }
	for b in s_hi { hi = b; break; }
	var count = 0;
	for i in out.s.len {
		let c = out.s[i];
		if c >= lo && c <= hi {
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "letters between bounds: ", count);
	out
}
@end
