@entry 5f5f3f5c207d6ae0
kind: step
verb: merge
noun: primes
modifier: pairwise
context: list
phrase: merge prime numbers pairwise by summation
phrase: combine adjacent prime pairs into sums
test: list=2,3,5,7,8,11
expect: => i=2 r=0.0 ok=true s="merged prime pairs count: 2" errors=0 n=2 res=[5,12] cache=0 hits=0
test: list=13,17,19,23
expect: => i=2 r=0.0 ok=true s="merged prime pairs count: 2" errors=0 n=2 res=[30,42] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_buf int[256] = [0; 256];
	var p_len = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = (x >= 2);
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p && p_len < 256 {
			p_buf[p_len] = x;
			p_len++;
		}
	}
	let pairs = p_len / 2;
	gold_clear(g);
	for i in pairs {
		gold_push(g, p_buf[2 * i] + p_buf[2 * i + 1]);
	}
	g.steps += g.n + 1;
	out.i = pairs;
	out.s.clear();
	format(out.s, "merged prime pairs count: ", pairs);
	out
}
@end
