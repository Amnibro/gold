@entry 48b81f6287e60d31
kind: step
verb: split
noun: streak
modifier: at_least
context: format
phrase: split text streaks having length at least {min_len}
phrase: partition streaks matching at least {min_len}
slot: min_len int
test: text="aaabbccccd" min_len=3
expect: => i=2 r=0.0 ok=true s="aaa|cccc" errors=0 n=0 res=[] cache=0 hits=0
test: text="wwxxxyyyy" min_len=3
expect: => i=2 r=0.0 ok=true s="xxx|yyyy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	out.s.clear();
	var streak_count = 0;
	var i = 0;
	while i < v.s.len {
		var j = i;
		while j < v.s.len && v.s[j] == v.s[i] {
			j++;
		}
		let len = j - i;
		if len >= ml {
			if streak_count > 0 { out.s.push('|'); }
			for k in i..j {
				out.s.push(v.s[k]);
			}
			streak_count++;
		}
		i = j;
	}
	out.i = streak_count;
	g.steps += v.s.len + 1;
	out
}
@end
