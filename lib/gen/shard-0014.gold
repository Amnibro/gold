phrase: count elements divided by threshold {threshold}
slot: threshold int
test: list=1,10,3,20 threshold=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=2 res=[2,2] cache=0 hits=0
test: list=7,8,9 threshold=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=2 res=[0,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var below = 0;
	var above = 0;
	for i in g.n {
		if g.res[i] <= ${threshold} {
			below++;
		} else {
			above++;
		}
	}
	g.n = 0;
	gold_push(g, below);
	gold_push(g, above);
	out.i = above;
	out
}
@end
@entry 24b7fc8d4c74dc97
kind: step
verb: reverse
noun: memo
modifier: running
context: core
phrase: reverse memo cache keys order
phrase: invert order of cached key entries
test: list=10,20
expect: => i=2 r=0.0 ok=true s="reversed 2 cache" errors=0 n=2 res=[10,20] cache=2 hits=0
test: list=100,200,300
expect: => i=3 r=0.0 ok=true s="reversed 3 cache" errors=0 n=3 res=[100,200,300] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 && g.n > 0 {
		for i in g.n {
			gold_cache_put(g, i, g.res[i]);
		}
	}
	for i in g.cn / 2 {
		let j = g.cn - 1 - i;
		let tk = g.ck[i];
		g.ck[i] = g.ck[j];
		g.ck[j] = tk;
		let tv = g.cv[i];
		g.cv[i] = g.cv[j];
		g.cv[j] = tv;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "reversed ", g.cn, " cache");
	out
}
@end
@entry 9a7df2cbc7a47f64
kind: step
verb: merge
noun: errors
modifier: sorted
context: core
phrase: merge errors count into results sorted
phrase: record sorted error count to results
test: list=5,2
expect: => i=0 r=0.0 ok=true s="" errors=0 n=3 res=[0,2,5] cache=0 hits=0
test: list=8
expect: => i=0 r=0.0 ok=true s="" errors=0 n=2 res=[0,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	gold_push(g, g.errors);
	for i in g.n {
		for j in g.n - 1 - i {
			if g.res[j] > g.res[j + 1] {
				let tmp = g.res[j];
				g.res[j] = g.res[j + 1];
				g.res[j + 1] = tmp;
			}
		}
	}
	out.i = g.errors;
	out
}
@end
@entry c9f3909e2f7f31b0
kind: step
verb: swap
noun: vowels
modifier: up_to
context: core
phrase: swap vowels within limit {limit}
phrase: exchange vowel positions within {limit}
slot: limit int
test: text="bait" limit=4
expect: => i=1 r=0.0 ok=true s="biat" errors=0 n=0 res=[] cache=0 hits=0
test: text="team" limit=4
expect: => i=1 r=0.0 ok=true s="taem" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first = -1;
	var second = -1;
	for i in out.s.len {
		if i < ${limit} {
			let b = out.s[i];
			if b == 'a' || b == 'e' || b == 'i' || b == 'o' || b == 'u' {
				if first < 0 {
					first = i;
				} else if second < 0 {
					second = i;
				}
			}
		}
	}
	if first >= 0 && second >= 0 {
		let tmp = out.s[first];
		out.s[first] = out.s[second];
		out.s[second] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out
}
@end
