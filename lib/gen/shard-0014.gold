expect: => i=2 r=0.0 ok=true s="split into halves of size 2" errors=0 n=2 res=[1,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let half = g.n / 2;
	g.n = half;
	g.steps += g.n * g.n + 1;
	out.i = half;
	out.s.clear();
	format(out.s, "split into halves of size ", half);
	out
}
@end
