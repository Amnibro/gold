	let limit = ${retries};
	var cached = 0;
	for i in g.n {
		let x = g.res[i];
		var first = true;
		for k in i {
			if g.res[k] == x {
				first = false;
				break;
			}
		}
		if first {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x {
					freq++;
				}
			}
			if freq >= limit {
				gold_cache_put(g, x, freq);
				cached++;
			}
		}
	}
	out.i = cached;
	out.s.clear();
	format(out.s, "cached counter with retry: ", cached);
	out
}
@end
