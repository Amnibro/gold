fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bound = ${stop};
	gold_clear(g);
	var cur = out.i;
	gold_push(g, cur);
	while cur > bound && g.n < 50 {
		cur = cur / 2;
		gold_push(g, cur);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "split counter until: ", g.n);
	out
}
