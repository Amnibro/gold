code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let key = ${key};
	if g.n == 0 {
		gold_fail(g, "empty list has no counter");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	gold_cache_put(g, key, g.n);
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "cached counter after sorting count 4");
	out
}
@end
