		for i in (g.n - 1) {
			if ${p}(g.res[i]) && ${p}(g.res[i + 1]) {
				gold_cache_put(g, g.res[i], g.res[i + 1]);
				count++;
			}
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "cached condition pairwise: ", count);
