fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let low = ${low};
	let high = ${high};
	if low > high {
		gold_fail(g, "invalid bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bounds");
		return out;
	}
	for k in g.n {
