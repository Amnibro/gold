@entry d6cfa356832df6fa
kind: step
verb: fold
noun: streak
modifier: until
context: error
slot: min_streak int
phrase: fold streak values until reaching error threshold {min_streak}
phrase: sum streak sequence until streak span exceeds {min_streak}
test: list=5,5,5,2,3 min_streak=3
expect: => i=15 r=0.0 ok=true s="folded streak sum: 15" errors=0 n=5 res=[5,5,5,2,3] cache=0 hits=0
test: list=1,2,3,4 min_streak=5
expect: => i=0 r=0.0 ok=false s="error: streak length insufficient" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${min_streak};
	if ms <= 1 {
		gold_fail(g, "invalid streak threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid streak threshold");
		return out;
	}
	var max_streak = 0;
	var cur_streak = 0;
	var cur_val = 0;
	var streak_sum = 0;
	var i = 0;
	while i < g.n {
		if i == 0 || g.res[i] == cur_val {
			cur_streak++;
			streak_sum += g.res[i];
		} else {
			if cur_streak >= ms { break; }
			cur_streak = 1;
			streak_sum = g.res[i];
		}
		cur_val = g.res[i];
		i++;
	}
	if cur_streak < ms {
		gold_fail(g, "streak length insufficient");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: streak length insufficient");
		return out;
	}
	g.steps += i;
	out.i = streak_sum;
	out.s.clear();
	format(out.s, "folded streak sum: ", streak_sum);
	out
}
@end
