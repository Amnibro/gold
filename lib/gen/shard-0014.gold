fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pl = ${prefix_len};
	var limit = if pl < g.n { pl } else { g.n };
	var needed_sort = false;
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
				needed_sort = true;
			}
			j++;
		}
		i++;
	}
	g.steps += limit * limit + 1;
	out.i = if needed_sort { 1 } else { 0 };
	out.s.clear();
	format(out.s, "prefix sorted required adjustment: ", needed_sort);
	out
}
@end
