		i++;
	}
	let avg = if count > 0 { sum / count } else { 0 };
	var above_avg = 0;
	var j = start;
	while j < g.n {
		if g.res[j] > avg { above_avg++; }
		j++;
	}
	g.steps += count * 2;
	out.i = above_avg;
	out.s.clear();
	format(out.s, "elements above tail average: ", above_avg);
	out
}
@end
