expect: => doc: dune5 sphere -5.02,4.028,0.5 r1 nz.04:.2 m:matte #d2b48c
test: n=30 r=8.0 h=1.5 u=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 20 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let dist = ${r} * (0.8 + gold_hash01(q, 1, ${u}) * 0.4);
		let px = dist * (gold_hash01(q, 2, ${u}) * 2.0 - 1.0);
		let py = dist * (gold_hash01(q, 3, ${u}) * 2.0 - 1.0);
		o.clear();
		gold_dnews(g, "dune", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, ${h} * 0.5);
		o.append(" r");
		gold_fnum(o, ${h});
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 210, 180, 140);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "ringed ridge dunes");
	out
}
@end
