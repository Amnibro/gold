@entry a0e6c7b7303be1f8
kind: step
verb: count
noun: streak
modifier: between
context: sort
phrase: count longest sorted streak between limits {lo} to {hi}
phrase: tally consecutive sorted run between values {lo} through {hi}
slot: lo int
slot: hi int
test: list=15,3,4,5,20,6 lo=2 hi=8
expect: => i=4 r=0.0 ok=true s="longest streak count: 4" errors=0 n=6 res=[3,4,5,6,15,20] cache=0 hits=0
test: list=10,1,2,8,9 lo=0 hi=5
expect: => i=2 r=0.0 ok=true s="longest streak count: 2" errors=0 n=5 res=[1,2,8,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let low = ${lo};
	let high = ${hi};
	var max_streak = 0;
	var current = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= low && x <= high {
			current++;
			if current > max_streak {
				max_streak = current;
			}
		} else {
			current = 0;
		}
	}
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak count: ", max_streak);
	out
}
@end
