fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cap must be positive");
		return out;
	}
	let groups = (g.n + cap - 1) / cap;
	g.steps++;
	out.i = groups;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped series into ", groups, " groups of at most ", cap);
