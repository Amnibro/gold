fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 {
		out.ok = false;
		gold_fail(g, "empty list in compare first");
		return out;
	}
	let first = g.res[0];
	var diff = first - tgt;
	out.i = diff;
	g.steps++;
	out.s.clear();
	if diff > 0 {
		format(out.s, "first element greater by ", diff);
	} else if diff < 0 {
		format(out.s, "first element smaller by ", -diff);
	} else {
		format(out.s, "first element equal");
	}
	out
}
@end
