fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wl = ${win_len};
	let start = if g.n > wl { g.n - wl } else { 0 };
	var comparisons = 0;
	var i = start;
	while i + 1 < g.n {
		if g.res[i] < g.res[i + 1] {
			comparisons++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = comparisons;
	out.s.clear();
	format(out.s, "ascending pairs in last window: ", comparisons);
	out
}
@end
