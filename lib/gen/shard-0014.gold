expect: => doc: peak2 cone 0,-2,0 0,-2,12 r7.2 m:matte #78787d
expect: => doc: peak3 cone 6,2,0 6,2,12 r7.2 m:matte #78787d
test: n=2 h=8.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=4 r=0.0 ok=true s="sparse mountain peaks" errors=0 n=0 res=[] cache=0 hits=0
