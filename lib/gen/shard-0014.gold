fn ${ID}_is_vowel(c byte) bool {
	c == 97 || c == 101 || c == 105 || c == 111 || c == 117 ||
	c == 65 || c == 69 || c == 73 || c == 79 || c == 85
}
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var vowels byte[..200] = "";
	var i = 0;
	while i < out.s.len {
		let ch = out.s[i];
		if ${ID}_is_vowel(ch) {
			vowels.push(ch);
			gold_cache_put(g, vowels.len, ch as int);
		}
		i++;
	}
	out.s.clear();
	for b in vowels {
		out.s.push(b);
	}
	g.steps += out.s.len;
	out.i = vowels.len;
	out
}
@end
