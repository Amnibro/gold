code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	var tot = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			g.res[m] = x;
			tot += x;
			m++;
		}
		i += 2;
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "alternate odds sum ", tot);
	out
}
@end
