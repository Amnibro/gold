code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var idx = -1;
	var sum = 0;
	if g.n > 0 {
		var i = g.n - 1;
		while i >= 0 {
			sum += g.res[i];
			if sum > tgt {
				idx = i;
				break;
			}
			if i == 0 { break; }
			i--;
		}
	}
	out.i = idx;
	g.steps += g.n + 1;
	out
}
@end
