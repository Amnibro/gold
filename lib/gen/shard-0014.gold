code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_retries};
	var retries = 0;
	var sum = 0;
	for i in out.s.len {
		let code = out.s[i] as int;
		var term = code / (i + 1);
		if term == 0 {
			if retries < limit {
				retries++;
				term = 1;
			}
		}
		sum += term;
		gold_push(g, sum);
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "series sum: ", sum);
	out
}
@end
