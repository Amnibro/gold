fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 20 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let p = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${r};
		let pick = gold_hash01(q, 2, ${u});
		var px = p;
		var py = ${r};
		if pick > 0.5 { px = ${r}; py = p; }
		let hrad = 1.5 + gold_hash01(q, 3, ${u}) * 1.0;
		o.clear();
		gold_dnews(g, "hill", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("5");
		o.append(" r");
		gold_fnum(o, hrad);
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 107, 143, 78);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "edge hills");
	out
}
@end
