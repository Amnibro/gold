		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var scaled = 0;
	for k in g.n {
		while g.res[k] > mv && g.res[k] > 0 {
			g.res[k] /= 10;
			scaled++;
		}
	}
	g.steps += g.n * g.n + scaled + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled digits recursively with ", scaled, " divisions");
	out
}
@end
