slot: k int
test: list=1,2,3,4,5 k=2
expect: => i=2 r=0.0 ok=true s="rotated array by 2" errors=0 n=5 res=[4,5,1,2,3] cache=0 hits=0
test: list=1 k=2
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if g.n < 2 || k <= 0 {
		gold_fail(g, "not enough elements or invalid shift");
		out.ok = false;
		return out;
	}
	let shift = k % g.n;
	if shift == 0 {
		g.steps += 1;
		out.i = 0;
		out.ok = true;
		return out;
	}
	var temp int[512] = [0; 512];
	for i in g.n {
		let new_pos = (i + shift) % g.n;
		temp[new_pos] = g.res[i];
	}
	for i in g.n {
		g.res[i] = temp[i];
	}
	g.steps += g.n;
	out.i = shift;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated array by ", shift);
	out
}
@end
