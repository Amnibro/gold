expect: => i=3 r=0.0 ok=true s="deduped gaps all items: 3" errors=0 n=3 res=[2,8,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let gap = ${min_gap};
	var m = 0;
	if g.n > 0 {
		m = 1;
		var i = 1;
		while i < g.n {
			let diff = g.res[i] - g.res[m - 1];
			let pos_diff = if diff < 0 { -diff } else { diff };
			if pos_diff >= gap {
				g.res[m] = g.res[i];
				m++;
			}
			i++;
		}
	}
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.s.clear();
	format(out.s, "deduped gaps all items: ", m);
	out
}
@end
