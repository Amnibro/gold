@entry 9118f18aae550186
kind: step
verb: drop
noun: gaps
modifier: while
context: aggregate
phrase: drop gaps while difference under {max_gap}
phrase: aggregate prefix while step gap below {max_gap}
slot: max_gap int
test: list=1,2,4,10,12 max_gap=2
expect: => i=7 r=0.0 ok=true s="small gap prefix sum 7" errors=0 n=3 res=[1,2,4] cache=0 hits=0
test: list=5,6,20 max_gap=3
expect: => i=11 r=0.0 ok=true s="small gap prefix sum 11" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	if g.n == 0 { return out; }
	var m = 1;
	var tot = g.res[0];
	while m < g.n {
		let prev = g.res[m - 1];
		let curr = g.res[m];
		let d = if curr > prev { curr - prev } else { prev - curr };
		if d > mg { break; }
		tot += curr;
		m++;
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "small gap prefix sum ", tot);
	out
}
@end
