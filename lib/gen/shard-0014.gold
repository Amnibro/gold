test: text="a   b    c" max_spaces=1
expect: => i=2 r=0.0 ok=true s="a b c" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world" max_spaces=2
expect: => i=0 r=0.0 ok=true s="hello world" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_spaces};
	var new_s byte[..200] = "";
	var space_cnt = 0;
	var clamped_runs = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == ' ' {
			space_cnt++;
			if space_cnt <= m {
				new_s.push(c);
			} else if space_cnt == m + 1 {
				clamped_runs++;
			}
		} else {
			space_cnt = 0;
			new_s.push(c);
		}
		i++;
	}
	g.steps += v.s.len + 1;
	out.s = new_s;
	out.i = clamped_runs;
	out
}
@end
