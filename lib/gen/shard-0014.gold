code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var max_streak = 1;
	var cur_streak = 1;
	for i in 1..g.n {
		if g.res[i] == g.res[i - 1] {
			cur_streak++;
			if cur_streak > max_streak {
				max_streak = cur_streak;
			}
		} else {
			cur_streak = 1;
		}
	}
	gold_clear(g);
	gold_push(g, max_streak);
	out.i = max_streak;
	out.s.clear();
	format(out.s, "longest streak safely: ", max_streak);
	out
}
@end
