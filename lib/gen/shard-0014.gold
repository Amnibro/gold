expect: => i=1 r=0.0 ok=true s="reversed initial window of 1 items" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let wl = ${win_len};
	var limit = if wl < g.n { wl } else { g.n };
	var left = 0;
	var right = limit - 1;
	while left < right {
		let tmp = g.res[left];
		g.res[left] = g.res[right];
		g.res[right] = tmp;
		left++;
		right--;
	}
	g.steps += limit + 1;
	out.i = limit;
	out.s.clear();
	format(out.s, "reversed initial window of ", limit, " items");
	out
}
@end
