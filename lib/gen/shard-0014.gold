code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_d = ${diff};
	if g.n < 2 { return out; }
	var write = 1;
	for i in 1..g.n {
		let d = g.res[i] - g.res[i - 1];
		let ad = if d < 0 { -d } else { d };
		if ad <= max_d {
			g.res[write] = g.res[i];
			write++;
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
