fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${a};
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * ${a};
		let sz = 0.5 + gold_hash01(q, 3, ${u}) * 0.5;
		o.clear();
		gold_dnews(g, "boulder", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, sz * 0.4);
		o.append(" r");
		gold_fnum(o, sz);
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "sparse wind boulders");
	out
}
@end
