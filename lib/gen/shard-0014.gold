phrase: aggregate total of last {count} history items
slot: count int
test: list=10,20,30,40 count=2
expect: => i=70 r=0.0 ok=true s="last history sum 70" errors=0 n=2 res=[30,40] cache=0 hits=0
test: list=5,15,25 count=3
expect: => i=45 r=0.0 ok=true s="last history sum 45" errors=0 n=3 res=[5,15,25] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let take = if k < g.n { k } else { g.n };
	let start = g.n - take;
	var tot = 0;
	for i in take {
		let x = g.res[start + i];
		g.res[i] = x;
		tot += x;
	}
	g.n = take;
	g.steps += take;
	out.i = tot;
	out.s.clear();
	format(out.s, "last history sum ", tot);
	out
}
@end
