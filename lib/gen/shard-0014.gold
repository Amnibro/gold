noun: range
modifier: at_most
context: search
slot: ceiling int
phrase: search normalize range at most ceiling {ceiling}
phrase: scale query range at most bound {ceiling}
test: list=10,20,50 ceiling=10
expect: => i=1 r=0.0 ok=true s="range normalized under ceiling: true" errors=0 n=3 res=[2,4,10] cache=0 hits=0
test: list=2,4 ceiling=10
expect: => i=0 r=0.0 ok=true s="range normalized under ceiling: false" errors=0 n=2 res=[2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	if g.n == 0 { return out; }
	var max_val = g.res[0];
	for i in g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
	}
	var normalized = false;
	if max_val > c {
		for i in g.n {
			g.res[i] = (g.res[i] * c) / max_val;
		}
		normalized = true;
	}
	g.steps += g.n * 2 + 1;
	out.i = if normalized { 1 } else { 0 };
	out.s.clear();
	format(out.s, "range normalized under ceiling: ", normalized);
	out
}
@end
