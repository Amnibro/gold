test: list=1,2,3,4,5 k=3
expect: => i=12 r=0.0 ok=true s="folded tail into sum 12" errors=0 n=3 res=[1,2,12] cache=0 hits=0
test: list=1,2 k=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k <= 0 || k > g.n {
		gold_fail(g, "invalid tail size for fold");
		out.ok = false;
		return out;
	}
	var sum = 0;
	let start = g.n - k;
	for i in k {
		sum += g.res[start + i];
	}
	g.n = start;
	g.res[g.n] = sum;
	g.n++;
	g.steps += k;
	out.i = sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "folded tail into sum ", sum);
	out
}
@end
