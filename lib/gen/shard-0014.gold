fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var dupe_count = 0;
	var shifted = 0;
	if g.n > 1 {
		var k = 1;
		while k < g.n {
			if g.res[k] == g.res[k - 1] {
				dupe_count++;
				if dupe_count % 2 == 0 {
					g.res[k] += off;
					shifted++;
				}
			}
			k++;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = shifted;
	out.s.clear();
	format(out.s, "shifted ", shifted, " alternating duplicates");
	out
}
@end
