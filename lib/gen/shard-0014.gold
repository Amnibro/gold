expect: => i=2 r=0.0 ok=true s="aabcde" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxyyzz"
expect: => i=2 r=0.0 ok=true s="xxyyzz" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_dup = -1;
	for i in 1..out.s.len {
		if out.s[i] == out.s[i - 1] {
			first_dup = i - 1;
			break;
		}
	}
	if first_dup >= 0 {
		var j = first_dup;
		while j < out.s.len && out.s[j] == out.s[first_dup] {
			j++;
		}
		let len = j - first_dup;
		if len > 1 {
			let tmp = out.s[j - 1];
			var k = j - 1;
			while k > first_dup {
				out.s[k] = out.s[k - 1];
				k--;
			}
			out.s[first_dup] = tmp;
		}
		out.i = len;
	} else {
		out.i = 0;
	}
	out
}
@end
