fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var evens = [0; 50];
	var e_cnt = 0;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			evens[e_cnt] = g.res[i];
			e_cnt++;
		}
	}
	var cur = e_cnt - 1;
	for j in g.n {
		if g.res[j] % 2 == 0 {
			g.res[j] = evens[cur];
			cur--;
		}
	}
	g.steps += g.n + 1;
	out.i = e_cnt;
	out.s.clear();
	format(out.s, "even elements reversed count: ", e_cnt);
	out
}
@end
