test: text="999888777" max_len=2
expect: => i=0 r=0.0 ok=false s="error: digits stream exceeds length" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	var new_len = 0;
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		var seen = false;
		for j in new_len {
			if out.s[j] == b { seen = true; break; }
		}
		if !seen {
			out.s[new_len] = b;
			new_len++;
		}
		i++;
	}
	while out.s.len > new_len {
		out.s.pop();
	}
	if new_len > ml {
		gold_fail(g, "digits stream exceeds length");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: digits stream exceeds length");
		return out;
	}
	g.steps += out.s.len + 1;
	out.i = new_len;
	out
}
@end
