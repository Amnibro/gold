		gold_fail(g, "invalid count for total first");
		out.ok = false;
		return out;
	}
	var total = 0;
	for i in k {
		total += g.res[i];
	}
	g.steps += k;
	out.i = total;
	out.ok = true;
	out.s.clear();
	format(out.s, "total of first ", k, " items is ", total);
	out
}
@end
