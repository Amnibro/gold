fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${baseline};
	var tot = 0;
	for i in g.n {
		let x = g.res[i];
		let diff = if x > b { x - b } else { b - x };
		g.res[i] = diff;
		tot += diff;
	}
	g.steps += g.n;
	out.i = tot;
	out.s.clear();
	format(out.s, "total deviation ", tot);
	out
}
@end
