	if g.n > 0 {
		let mid = g.res[g.n / 2];
		for i in g.n {
			if g.res[i] < mid {
				count++;
			}
		}
	}
	gold_clear(g);
	gold_push(g, count);
	out.i = count;
	out.s.clear();
	format(out.s, "compared middle nested: ", count);
	out
}
@end
