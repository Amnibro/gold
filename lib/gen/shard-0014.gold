noun: maximum
modifier: safely
context: search
phrase: check maximum safely bounded by ceiling {ceiling}
phrase: verify maximum search value does not exceed {ceiling}
slot: ceiling int
test: list=10,20,30 ceiling=50
expect: => i=30 r=0.0 ok=true s="maximum check within ceiling: true" errors=0 n=3 res=[10,20,30] cache=0 hits=0
test: list=40,80,10 ceiling=60
expect: => i=80 r=0.0 ok=false s="maximum check within ceiling: false" errors=0 n=3 res=[40,80,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.ok = true;
		return out;
	}
	let ceil = ${ceiling};
	var mx = g.res[0];
	for i in g.n {
		if g.res[i] > mx { mx = g.res[i]; }
	}
	out.ok = mx <= ceil;
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
