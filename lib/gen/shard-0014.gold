@entry b17837f16c366b6f
kind: fn
verb: retry
noun: duplicates
modifier: nested
context: aggregate
phrase: retry duplicates nested pass iterations {max_iter}
phrase: nested duplicates retry passes {max_iter}
slot: max_iter int
test: arg=11223,456 max_iter=2
expect: 123
expect: 456
test: arg=777 max_iter=1
expect: 7
code:
fn ${ID}(n int) int {
	let iter = ${max_iter};
	var x = if n < 0 { -n } else { n };
	for k in iter {
		var seen bool[10] = [false; 10];
		var rev = 0;
		while x > 0 {
			rev = rev * 10 + (x % 10);
			x /= 10;
		}
		var clean = 0;
		while rev > 0 {
			let d = rev % 10;
			if !seen[d] {
				seen[d] = true;
				clean = clean * 10 + d;
			}
			rev /= 10;
		}
		x = clean;
	}
	x
}
@end
@entry c637ee77bd551d3f
kind: fn
