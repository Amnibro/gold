fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let num = if k < g.n { k } else { g.n };
	let start = g.n - num;
	var kept = 0;
	var i = start;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.steps += kept + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "trailing subfunction items kept: ", kept);
	out
}
