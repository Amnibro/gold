fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var found = false;
	var head_len = if g.n > 3 { 3 } else { g.n };
	for k in head_len {
		if g.res[k] == tgt { found = true; break; }
	}
	if !found {
		for k in g.n {
			if g.res[k] == tgt { found = true; break; }
		}
	}
	g.steps += g.n * g.n + 1;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "found head element: ", found);
	out
}
@end
