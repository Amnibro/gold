code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${budget};
	var running = 0;
	var kept = 0;
	while kept < g.n {
		let x = g.res[kept];
		if running + x > b { break; }
		running += x;
		kept++;
	}
	g.steps += kept + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "prefix items kept under budget: ", kept);
	out
}
@end
