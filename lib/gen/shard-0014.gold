code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${base_val};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var acc = b;
	for k in g.n {
		acc += g.res[k];
	}
	g.steps += g.n * g.n + 1;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded sorted values to ", acc);
	out
}
@end
