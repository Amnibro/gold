test: list=2,2,3,4,2,3 freq=2
expect: => i=5 r=0.0 ok=true s="kept matching frequency items: 5" errors=0 n=5 res=[2,2,3,2,3] cache=0 hits=0
test: list=1,2,3 freq=0
expect: => i=0 r=0.0 ok=false s="invalid frequency parameter" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${freq};
	if target <= 0 {
		gold_fail(g, "frequency threshold must be positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid frequency parameter");
		return out;
	}
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var count = 0;
		for j in g.n {
			if g.res[j] == x { count++; }
		}
		if count >= target {
			g.res[kept] = x;
			kept++;
		}
	}
	g.n = kept;
	out.i = kept;
	out.ok = true;
	out.s.clear();
	format(out.s, "kept matching frequency items: ", kept);
	out
}
@end
