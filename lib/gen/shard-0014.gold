kind: step
verb: sort
noun: value
modifier: every_other
context: text
phrase: sort alternating character values in text string
phrase: order every other letter in string ascending
test: text="dcbaz"
expect: => i=3 r=0.0 ok=true s="bcdaz" errors=0 n=0 res=[] cache=0 hits=0
test: text="fedcba"
expect: => i=3 r=0.0 ok=true s="bedcfa" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt_idx: int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < out.s.len {
		alt_idx[count] = i;
		count++;
		i += 2;
	}
	if count > 1 {
		for j in count {
			for k in (j + 1)..count {
				let idx_j = alt_idx[j];
				let idx_k = alt_idx[k];
				if out.s[idx_k] < out.s[idx_j] {
					let tmp = out.s[idx_j];
					out.s[idx_j] = out.s[idx_k];
					out.s[idx_k] = tmp;
				}
			}
		}
	}
	out.i = count;
	out
}
@end
