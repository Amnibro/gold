code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var has_pos = false;
	for i in g.n {
		if g.res[i] > 0 {
			has_pos = true;
			break;
		}
	}
	if has_pos {
		var s = 0;
		for i in g.n {
			s += g.res[i];
			g.res[i] = s;
		}
		out.i = s;
		out.s.clear();
		format(out.s, "collected total any: ", s);
	}
	out
}
@end
