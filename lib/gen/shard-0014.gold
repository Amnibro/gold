kind: step
verb: map
noun: suffix
modifier: in_reverse
context: error
phrase: map suffix elements in reverse checking length {tail_len}
phrase: transform tail sequence backwards checking bound {tail_len}
slot: tail_len int
test: list=1,2,3,4,5 tail_len=3
expect: => i=3 r=0.0 ok=true s="reversed suffix mapped: 3" errors=0 n=5 res=[1,2,10,8,6] cache=0 hits=0
test: list=1,2 tail_len=4
expect: => i=0 r=0.0 ok=false s="suffix length error" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${tail_len};
	if k <= 0 || k > g.n {
		gold_fail(g, "requested suffix length exceeds list boundary or is non positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("suffix length error");
		return out;
	}
	let start = g.n - k;
	var i = start;
	var j = g.n - 1;
	while i < j {
		let tmp = g.res[i];
		g.res[i] = g.res[j] * 2;
		g.res[j] = tmp * 2;
		i++;
		j--;
	}
	if i == j {
		g.res[i] = g.res[i] * 2;
	}
	out.i = k;
	out.ok = true;
	out.s.clear();
	format(out.s, "reversed suffix mapped: ", k);
	out
}
@end
