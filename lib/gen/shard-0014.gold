		o.append(",0 ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",3 r");
		o.append("1.1 nz.");
		o.append("05:.");
		o.append("3 m:matte ");
		gold_hex(o, 40, 100, 40);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
