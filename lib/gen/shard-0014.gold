@entry a82b15d1edf1ec56
kind: step
verb: count
noun: histogram
modifier: nested
context: loop
slot: bucket_size int
phrase: loop counting histogram bins with nested bucket {bucket_size}
phrase: count frequency histogram using nested loop bins {bucket_size}
test: list=2,5,7,12,14,19 bucket_size=5
expect: => i=4 r=0.0 ok=true s="active histogram bins: 4" errors=0 n=6 res=[2,5,7,12,14,19] cache=0 hits=0
test: list=10,25,30,45 bucket_size=10
expect: => i=4 r=0.0 ok=true s="active histogram bins: 4" errors=0 n=4 res=[10,25,30,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${bucket_size};
	var max_val = 0;
	var i = 0;
	while i < g.n {
		if g.res[i] > max_val { max_val = g.res[i]; }
		i++;
	}
	var num_buckets = (max_val / bs) + 1;
	if num_buckets > 64 { num_buckets = 64; }
	var non_empty = 0;
	var b = 0;
	while b < num_buckets {
		var in_bucket = 0;
		var k = 0;
		while k < g.n {
			if g.res[k] / bs == b { in_bucket++; }
			k++;
		}
		if in_bucket > 0 { non_empty++; }
		b++;
	}
	g.steps += g.n * num_buckets + 1;
	out.i = non_empty;
	out.s.clear();
	format(out.s, "active histogram bins: ", non_empty);
	out
}
@end
