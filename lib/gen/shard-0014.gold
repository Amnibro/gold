fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var left = 0;
	var right = g.n - 1;
	var count = 0;
	while left < right {
		while left < right && !${cond}(g.res[left]) { left++; }
		while left < right && !${cond}(g.res[right]) { right--; }
		if left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			count++;
			left++;
			right--;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "reversed conditional items: ", count);
	out
}
@end
