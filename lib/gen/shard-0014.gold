code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let reps = ${times};
	if g.n == 0 || reps <= 1 {
		out.i = g.n;
		return out;
	}
	let orig = g.n;
	var r = 1;
	while r < reps {
		var j = 0;
		while j < orig && g.n < 256 {
			gold_push(g, g.res[j]);
			j++;
		}
		r++;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated loop total items: ", g.n);
	out
}
@end
