fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	if limit <= 0 {
		gold_fail(g, "cutoff value must be positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid cutoff parameter");
		return out;
	}
	var scanned = 0;
	var found = false;
	for k in g.n {
		if g.res[k] >= limit {
			found = true;
			break;
		}
		scanned++;
	}
	if !found {
		gold_fail(g, "cutoff threshold was never reached");
	}
	out.i = scanned;
	out.ok = found;
	out.s.clear();
	format(out.s, "scanned prefix length: ", scanned);
	out
}
@end
