fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var best_val = g.res[0];
	var best_len = 1;
	var cur_val = g.res[0];
	var cur_len = 1;
	for i in 1..g.n {
		if g.res[i] == cur_val {
			cur_len++;
			if cur_len > best_len {
				best_len = cur_len;
				best_val = cur_val;
			}
		} else {
			cur_val = g.res[i];
			cur_len = 1;
		}
	}
	gold_clear(g);
	for i in best_len {
		gold_push(g, best_val);
	}
	g.steps += g.n;
	out.i = best_len;
	out.s.clear();
	format(out.s, "kept longest streak: ", best_len);
	out
}
@end
