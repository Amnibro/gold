code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var found = false;
	var cached_val, ok = gold_cache_get(g, tgt);
	if ok {
		found = (cached_val == 1);
	} else {
		var start = if g.n > 4 { g.n - 4 } else { 0 };
		var i = start;
		while i < g.n {
			if g.res[i] == tgt {
				found = true;
				break;
			}
			i++;
		}
		gold_cache_put(g, tgt, if found { 1 } else { 0 });
	}
	g.steps += 1;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "suffix contains target: ", found);
	out
}
@end
