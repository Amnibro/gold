	let f = ${factor};
	let lo = ${min_val};
	let hi = ${max_val};
	var scaled = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && x >= lo && x <= hi {
			g.res[i] = x * f;
			scaled++;
		}
	}
	g.steps += g.n + 1;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled ", scaled, " odd values between range");
