fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var gaps int[512] = [0; 512];
	var gc = 0;
	var i = 0;
	while i + 1 < g.n {
		gaps[gc] = g.res[i + 1] - g.res[i];
		gc++;
		i++;
	}
	for k in gc {
		g.res[k] = gaps[k];
	}
	g.n = gc;
	g.steps += g.n + 1;
	out.i = gc;
	out.s.clear();
	format(out.s, "mapped all adjacent gaps: ", gc);
	out
}
@end
