fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sm = ${scale_mul};
	var running_tally = 0;
	var i = g.n - 1;
	while i >= 0 {
		running_tally = (running_tally + g.res[i]) * sm;
		i--;
	}
	g.steps += g.n;
	out.i = running_tally;
	out.s.clear();
	format(out.s, "scaled reverse tally: ", running_tally);
	out
}
@end
@entry d0b03a93ef27e203
kind: step
verb: keep
noun: vowels
modifier: last
context: loop
phrase: loop keeping vowel characters placed last in text
phrase: reorder string loop keeping vowels at the last positions
test: text="cat"
expect: => i=1 r=0.0 ok=true s="cta" errors=0 n=0 res=[] cache=0 hits=0
test: text="helium"
expect: => i=3 r=0.0 ok=true s="hlmeiu" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var consonants byte[>..] = [];
	var vowels byte[>..] = [];
	var i = 0;
	while i < out.s.len {
		let b = out.s[i];
		let is_v = b == 97 || b == 101 || b == 105 || b == 111 || b == 117 || b == 65 || b == 69 || b == 73 || b == 79 || b == 85;
		if is_v { vowels.push(b); }
		else { consonants.push(b); }
		i++;
	}
	out.s.clear();
	for b in consonants { out.s.push(b); }
	for b in vowels { out.s.push(b); }
	g.steps += out.s.len;
	out.i = vowels.len;
	out
}
@end
