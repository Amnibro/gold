expect: => i=3 r=0.0 ok=true s="mapped nested minimums count: 3" errors=0 n=3 res=[4,2,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${size};
	if sz <= 0 || g.n < sz { return out; }
	let count = g.n - sz + 1;
	for i in count {
		var min_val = g.res[i];
		for j in 1..sz {
			if g.res[i + j] < min_val {
				min_val = g.res[i + j];
			}
		}
		g.res[i] = min_val;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.s.clear();
	format(out.s, "mapped nested minimums count: ", count);
	out
}
@end
