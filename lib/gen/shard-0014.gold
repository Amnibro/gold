slot: cutoff int
test: list=2,4,8,1,3 cutoff=5
expect: => i=12 r=0.0 ok=true s="suffix aggregate sum 12" errors=0 n=3 res=[8,1,3] cache=0 hits=0
test: list=10,2,3 cutoff=2
expect: => i=15 r=0.0 ok=true s="suffix aggregate sum 15" errors=0 n=3 res=[10,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${cutoff};
	var idx = 0;
	while idx < g.n && g.res[idx] <= limit {
		idx++;
	}
	var m = 0;
	var tot = 0;
	while idx + m < g.n {
		let x = g.res[idx + m];
		g.res[m] = x;
		tot += x;
		m++;
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "suffix aggregate sum ", tot);
	out
}
@end
