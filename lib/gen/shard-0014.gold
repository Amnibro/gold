kind: step
verb: filter
noun: numbers
modifier: unique
context: loop
phrase: filter numbers unique to eliminate duplicates
phrase: keep only unique numbers during loop filter
test: list=1,2,2,3,1,4
expect: => i=4 r=0.0 ok=true s="filtered to 4 unique numbers" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=
expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no numbers");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var temp int[512] = [0; 512];
	var m = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in m {
			if temp[j] == x { seen = true; break; }
		}
		if !seen {
			temp[m] = x;
			m++;
		}
	}
	for i in m { g.res[i] = temp[i]; }
	g.n = m;
	g.steps += g.n;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "filtered to ", m, " unique numbers");
	out
}
@end
