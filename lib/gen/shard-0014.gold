expect: => i=2 r=0.0 ok=true s="selected valid pairs: 2" errors=0 n=4 res=[2,5,3,9] cache=0 hits=0
test: list=5,2,3,1
expect: => i=0 r=0.0 ok=false s="decreasing step pair error" errors=2 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errors = 0;
	var kept = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] > g.res[i + 1] {
			gold_fail(g, "pairwise step is not increasing");
			errors++;
		} else {
			g.res[kept] = g.res[i];
			g.res[kept + 1] = g.res[i + 1];
			kept += 2;
		}
		i += 2;
	}
	g.n = kept;
	out.i = kept / 2;
	out.ok = errors == 0;
	out.s.clear();
	if errors > 0 {
		out.s.append("decreasing step pair error");
	} else {
		format(out.s, "selected valid pairs: ", kept / 2);
	}
	out
}
@end
@entry 606a39179ec3beab
kind: step
verb: scale
noun: odds
modifier: pairwise
context: error
phrase: scale odd values pairwise checking factor {scale}
phrase: multiply odd pairs safely with scale {scale}
slot: scale int
test: list=1,3,2,4 scale=2
expect: => i=1 r=0.0 ok=true s="scaled odd pairs: 1" errors=0 n=4 res=[2,6,2,4] cache=0 hits=0
test: list=1,3,5 scale=-1
expect: => i=0 r=0.0 ok=false s="invalid negative scale factor" errors=1 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let factor = ${scale};
	if factor <= 0 {
		gold_fail(g, "scale factor must be strictly positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid negative scale factor");
		return out;
	}
	var pairs = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 != 0 && g.res[i + 1] % 2 != 0 {
			g.res[i] = g.res[i] * factor;
			g.res[i + 1] = g.res[i + 1] * factor;
			pairs++;
		}
		i += 2;
	}
	out.i = pairs;
	out.ok = true;
	out.s.clear();
	format(out.s, "scaled odd pairs: ", pairs);
	out
}
@end
