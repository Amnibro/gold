@entry 456d228a04834c1c
kind: step
verb: limit
noun: streak
modifier: each
context: retry
phrase: limit consecutive run streak for each value to {max_run}
phrase: cap repeat streak for each retry entry at {max_run}
slot: max_run int
test: list=1,1,1,2,2,3,3,3,3 max_run=2
expect: => i=0 r=0.0 ok=true s="limited each value streak to 2 keeping 6 items" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=5,5,5 max_run=0
expect: => i=0 r=0.0 ok=false s="error: max streak must be positive" errors=1 n=3 res=[5,5,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_run = ${max_run};
	if max_run <= 0 {
		gold_fail(g, "max streak must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: max streak must be positive");
		return out;
	}
	if g.n == 0 {
		out.ok = true;
		out.s.clear();
		format(out.s, "streak limited on empty list");
		return out;
	}
	var new_res = [0; 512];
	var new_n = 0;
	var i = 0;
	var curr_val = g.res[0];
	var curr_cnt = 0;
	while i < g.n {
		if g.res[i] == curr_val {
			curr_cnt++;
		} else {
			curr_val = g.res[i];
			curr_cnt = 1;
		}
		if curr_cnt <= max_run {
			new_res[new_n] = g.res[i];
			new_n++;
		}
		i++;
	}
	var k = 0;
	while k < new_n {
		g.res[k] = new_res[k];
		k++;
	}
	g.n = new_n;
	g.steps++;
	out.ok = true;
	out.s.clear();
	format(out.s, "limited each value streak to ", max_run, " keeping ", new_n, " items");
	out
}
@end
@entry 7802f93f7f710d5b
kind: step
verb: fill
noun: middle
modifier: unique
context: retry
phrase: fill middle position with unique value {fill_val}
phrase: insert unique value {fill_val} into middle of list
slot: fill_val int
test: list=10,20,40,50 fill_val=30
expect: => i=30 r=0.0 ok=true s="filled middle with unique value 30" errors=0 n=5 res=[10,20,30,40,50] cache=0 hits=0
test: list=10,20,30 fill_val=20
expect: => i=0 r=0.0 ok=false s="error: value already present" errors=1 n=3 res=[10,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fill_val = ${fill_val};
	var i = 0;
	while i < g.n {
		if g.res[i] == fill_val {
			gold_fail(g, "value not unique");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: value already present");
			return out;
		}
		i++;
	}
	if g.n >= 512 {
		gold_fail(g, "results full");
		out.ok = false;
		return out;
	}
	let mid = g.n / 2;
	var k = g.n;
	while k > mid {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[mid] = fill_val;
	g.n++;
	g.steps++;
	out.i = fill_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "filled middle with unique value ", fill_val);
	out
}
@end
@entry 8b30c5a1929798a8
kind: step
verb: group
noun: range
modifier: sorted
context: retry
phrase: group sorted range of values with bucket size {bucket_size}
phrase: partition sorted retry range using bucket size {bucket_size}
slot: bucket_size int
test: list=5,12,3,25 bucket_size=10
expect: => i=3 r=0.0 ok=true s="grouped sorted range into 3 buckets" errors=0 n=4 res=[3,5,12,25] cache=0 hits=0
test: list=1,2,3 bucket_size=0
expect: => i=0 r=0.0 ok=false s="error: invalid bucket size" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bucket_size = ${bucket_size};
	if bucket_size <= 0 || g.n == 0 {
		gold_fail(g, "invalid bucket size or empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid bucket size");
		return out;
	}
	// Sort g.res
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let span = g.res[g.n - 1] - g.res[0];
	let num_buckets = span / bucket_size + 1;
	g.steps++;
	out.i = num_buckets;
	out.ok = true;
	out.s.clear();
	format(out.s, "grouped sorted range into ", num_buckets, " buckets");
	out
}
@end
