fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${margin};
	var sum = 0;
	var items = 0;
	if g.n > (2 * m) {
		var i = m;
		while i < (g.n - m) {
			sum += g.res[i];
			items++;
			i++;
		}
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "sum of ", items, " middle entries: ", sum);
