			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	if g.n > 0 {
		gold_cache_put(g, 0, g.res[0]);
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed with cache: ", g.n);
	out
}
