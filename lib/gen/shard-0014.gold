	var out = v;
	if out.s.len > 1 {
		for i in out.s.len {
			for j in (i + 1)..out.s.len {
				if out.s[j] < out.s[i] {
					let tmp = out.s[i];
					out.s[i] = out.s[j];
					out.s[j] = tmp;
