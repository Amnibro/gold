@entry 742c36a14595f16b
kind: step
verb: normalize
noun: squares
modifier: unique
context: sort
slot: cap_val int
phrase: sort normalize squares unique limit {cap_val}
phrase: scale distinct squares unique ceiling {cap_val}
test: list=-2,2,3,-3,4 cap_val=20
expect: => i=3 r=0.0 ok=true s="normalized 3 unique squares" errors=0 n=3 res=[4,9,16] cache=0 hits=0
test: list=1,1,1 cap_val=10
expect: => i=1 r=0.0 ok=true s="normalized 1 unique squares" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap_val};
	var sq int[512] = [0; 512];
	var sn = 0;
	for i in g.n {
		let s = g.res[i] * g.res[i];
		var seen = false;
		for k in sn {
			if sq[k] == s {
				seen = true;
				break;
			}
		}
		if !seen {
			sq[sn] = if s > cap { cap } else { s };
			sn++;
		}
	}
	var i = 0;
	while i < sn {
		var j = i + 1;
		while j < sn {
			if sq[i] > sq[j] {
				let tmp = sq[i];
				sq[i] = sq[j];
				sq[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in sn { g.res[k] = sq[k]; }
	g.n = sn;
	g.steps += g.n + sn * sn + 1;
	out.i = sn;
	out.s.clear();
	format(out.s, "normalized ", sn, " unique squares");
	out
}
@end
