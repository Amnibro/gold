@entry 03f5ca6b6978aa82
kind: step
verb: fold
noun: gaps
modifier: until
context: math
phrase: sum adjacent gaps until predicate {stop}
phrase: accumulate step differences until condition {stop}
slot: stop pred
test: list=10,14,19,25,30 stop=over_100
expect: => i=20 r=0.0 ok=true s="gap sum: 20" errors=0 n=5 res=[10,14,19,25,30] cache=0 hits=0
test: list=1,5,10,20 stop=is_even
expect: => i=4 r=0.0 ok=true s="gap sum: 4" errors=0 n=4 res=[1,5,10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var total = 0;
	if g.n > 1 {
		for i in 1..g.n {
			let diff = g.res[i] - g.res[i - 1];
			let d = if diff < 0 { -diff } else { diff };
			total += d;
			if ${stop}(total) {
				break;
			}
		}
	}
	out.i = total;
	out.s.clear();
	format(out.s, "gap sum: ", total);
	out
}
@end
@entry 527c2805ff099ccb
kind: step
verb: fold
noun: number
modifier: in_place
context: math
phrase: fold digits of number in place using {f}
phrase: reduce number value in place with function {f}
slot: f fn
test: input=1234 f=double
expect: => i=20 r=0.0 ok=true s="folded number: 20" errors=0 n=0 res=[] cache=0 hits=0
test: input=5678 f=halve
expect: => i=12 r=0.0 ok=true s="folded number: 12" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var n = out.i;
	var sum = 0;
	if n < 0 { n = -n; }
	while n > 0 {
		let d = n % 10;
		sum += ${f}(d);
		n /= 10;
	}
	out.i = sum;
	out.s.clear();
	format(out.s, "folded number: ", sum);
	out
}
@end
@entry a7f90e798d09c39d
kind: step
verb: sort
noun: loop
modifier: between
context: math
phrase: sort results in loop between index {start_idx} through index {end_idx}
phrase: order elements within range between {start_idx} to {end_idx}
slot: start_idx int
slot: end_idx int
test: list=9,8,7,6,5 start_idx=1 end_idx=4
expect: => i=3 r=0.0 ok=true s="sorted range length: 3" errors=0 n=5 res=[9,6,7,8,5] cache=0 hits=0
test: list=10,30,20,50,40 start_idx=0 end_idx=3
expect: => i=3 r=0.0 ok=true s="sorted range length: 3" errors=0 n=5 res=[10,20,30,50,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start_idx};
	let e = ${end_idx};
	let lo = if s < 0 { 0 } else { s };
	let hi = if e > g.n { g.n } else { e };
	if lo < hi {
		for i in lo..hi {
			for j in (i + 1)..hi {
				if g.res[j] < g.res[i] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
				}
			}
		}
	}
	out.i = hi - lo;
	out.s.clear();
	format(out.s, "sorted range length: ", out.i);
	out
}
@end
