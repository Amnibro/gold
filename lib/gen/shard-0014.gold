test: list=2,2,3,4,4,5
expect: => i=14 r=0.0 ok=true s="unique search total: 14" errors=0 n=4 res=[2,3,4,5] cache=0 hits=0
test: list=10,10,10,20
expect: => i=30 r=0.0 ok=true s="unique search total: 30" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	var total = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[kept] = x;
			total += x;
			kept++;
		}
	}
	g.steps += g.n + kept;
	g.n = kept;
	out.i = total;
	out.s.clear();
	format(out.s, "unique search total: ", total);
	out
}
@end
