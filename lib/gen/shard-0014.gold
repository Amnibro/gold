fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 24 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let pos = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * 10.0;
		let edge_pick = gold_hash01(q, 2, ${u});
		var px = pos;
		var py = 9.0;
		if edge_pick > 0.5 { px = 9.0; py = pos; }
		o.clear();
		gold_dnews(g, "dune", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, ${s} * 0.4);
		o.append(" r");
		gold_fnum(o, ${s});
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 210, 180, 140);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "dunes along edge");
	out
}
@end
