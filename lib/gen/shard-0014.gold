code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var a = -1;
	var b = -1;
	for i in g.n {
		if g.res[i] <= ${max_val} {
			if a < 0 {
				a = i;
			}
			b = i;
		}
	}
	if a >= 0 && b >= 0 && a != b {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out
}
@end
@entry dd347c602db41b68
kind: step
verb: pair
noun: duplicates
modifier: first
context: core
phrase: pair duplicates moving first duplicate to front
phrase: move first duplicate element to head of results
test: list=1,2,3,2
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[2,1,2,3,2] cache=0 hits=0
test: list=5,6,5
expect: => i=5 r=0.0 ok=true s="" errors=0 n=4 res=[5,5,6,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_val = 0;
	var found = false;
	for i in g.n {
		for j in i {
			if g.res[j] == g.res[i] {
				dup_val = g.res[i];
				found = true;
				break;
			}
		}
		if found {
			break;
		}
	}
	if found {
		gold_push(g, 0);
		var k = g.n - 1;
		while k > 0 {
			g.res[k] = g.res[k - 1];
			k--;
		}
		g.res[0] = dup_val;
		out.i = dup_val;
	} else {
		out.i = 0;
	}
	out
}
@end
