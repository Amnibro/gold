fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let w = i + 1;
		gold_cache_put(g, i, w);
		g.res[i] = g.res[i] * w;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped series with cache: ", g.n);
	out
}
@end
