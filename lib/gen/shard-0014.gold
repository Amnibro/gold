fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${r} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
		let px = (q as real - (${n} as real - 1.0) * 0.5) * (${r} * 0.4);
		let py = if q % 2 == 0 { 0.5 } else { -0.5 };
		o.clear();
		gold_dnews(g, "bush", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",0.5 r");
		o.append("0.6 nz.");
		o.append("05:.");
		o.append("3 m:matte ");
		gold_hex(o, 45, 115, 40);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "island shrub cluster");
	out
}
@end
