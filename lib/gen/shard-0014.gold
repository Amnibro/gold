fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 0 {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	if m > 0 {
		let k = s % m;
		var temp int[512] = [0; 512];
		for j in m {
			temp[j] = g.res[(j + k) % m];
		}
		for j in m {
			g.res[j] = temp[j];
		}
	}
	g.steps += m * 2;
	out.i = m;
	out.s.clear();
	format(out.s, "rotated steps count: ", m);
	out
}
@end
