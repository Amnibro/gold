expect: => i=0 r=0.0 ok=false s="error: empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no unique total");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var uniq_count = 0;
	var i = 0;
	while i < g.n {
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == g.res[i] {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			uniq_count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = uniq_count;
	out.ok = true;
	out.s.clear();
	format(out.s, "split total unique count: ", uniq_count);
	out
}
@end
