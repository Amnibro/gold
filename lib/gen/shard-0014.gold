code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_streak};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var run_cnt = 0;
		while (idx + run_cnt) < g.n && g.res[idx + run_cnt] == x {
			run_cnt++;
		}
		var take = if run_cnt < ms { run_cnt } else { ms };
		for k in take {
			g.res[new_n] = x;
			new_n++;
		}
		idx += run_cnt;
	}
	let removed = g.n - new_n;
	g.n = new_n;
	g.steps += g.n * g.n + 1;
	out.i = removed;
	out.s.clear();
	format(out.s, "removed ", removed, " excess streak entries");
	out
}
@end
