		out.ok = false;
		out.s.clear();
		format(out.s, "error: memo size exceeds safety bound");
		return out;
	}
	if g.n > 1 {
		let last = g.res[g.n - 1];
		var i = g.n - 1;
		while i > 0 {
			g.res[i] = g.res[i - 1];
			i--;
		}
		g.res[0] = last;
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "rotated memo safely count: ", g.n);
	out
}
