fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${max_val};
	var clamped = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 != 0 && x > ceil {
			g.res[i] = ceil;
			clamped++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = clamped;
	out.s.clear();
	format(out.s, "clamped odd numbers count: ", clamped);
	out
}
@end
