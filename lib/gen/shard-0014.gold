test: list=1,5,2,8
expect: => i=2 r=0.0 ok=true s="ran tail pairwise comparison count 2" errors=0 n=4 res=[1,5,2,8] cache=0 hits=0
test: list=1
expect: => i=0 r=0.0 ok=false s="error: insufficient items" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient items for pairwise compare");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient items");
		return out;
	}
	var pairs = g.n / 2;
	var count = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] < g.res[i + 1] {
			count++;
		}
		i += 2;
	}
	g.steps += pairs;
	out.i = count;
	out.ok = true;
