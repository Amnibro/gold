slot: ceiling_limit int
phrase: loop reversing each element capped at limit {ceiling_limit}
phrase: reverse sequence while limiting each item to {ceiling_limit}
test: list=10,25,50,5 ceiling_limit=20
expect: => i=4 r=0.0 ok=true s="reversed items with limit: 4" errors=0 n=4 res=[5,20,20,10] cache=0 hits=0
test: list=15,40,30,8 ceiling_limit=25
expect: => i=4 r=0.0 ok=true s="reversed items with limit: 4" errors=0 n=4 res=[8,25,25,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let clim = ${ceiling_limit};
	var limited int[512] = [0; 512];
	for i in g.n {
		let x = g.res[i];
		limited[i] = if x > clim { clim } else { x };
	}
	var left = 0;
	var right = g.n - 1;
	while left < right {
		let tmp = limited[left];
		limited[left] = limited[right];
		limited[right] = tmp;
		left++;
		right--;
	}
	for i in g.n {
		g.res[i] = limited[i];
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "reversed items with limit: ", g.n);
	out
}
@end
