fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var found = false;
	for i in g.n {
		let x = g.res[i];
		var cv, ok = gold_cache_get(g, x);
		if !ok {
			cv = if ${test_cond}(x) { 1 } else { 0 };
			gold_cache_put(g, x, cv);
		}
		if cv == 1 {
			found = true;
			break;
		}
	}
	g.steps += g.n + 1;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "scan memo match: ", found);
	out
}
@end
