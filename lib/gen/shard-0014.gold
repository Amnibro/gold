code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let mid = g.cn / 2;
	let start = if mid > 1 { mid - 1 } else { 0 };
	let end = if mid + 2 <= g.cn { mid + 2 } else { g.cn };
	var write = 0;
	var idx = start;
	while idx < end {
		let val = g.cv[idx];
		var seen = false;
		for j in write {
			if g.res[j] == val { seen = true; break; }
		}
		if !seen {
			g.res[write] = val;
			write++;
		}
		idx++;
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "unique middle items: ", write);
	out
}
@end
@entry 2456bea947ec5b6e
kind: step
