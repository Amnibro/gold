	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let max_items = ${limit};
	var total = 0;
	var count = 0;
	for i in g.cn {
		if count >= max_items {
			break;
		}
		total += g.cv[i];
		count++;
	}
	out.i = total;
	out.s.clear();
	format(out.s, "partial cache series total: ", total);
	out
}
@end
@entry e2e5f58ece93640b
kind: step
verb: swap
noun: histogram
modifier: last
context: cache
phrase: swap last histogram peak in cache store
phrase: exchange trailing cache entry with histogram mode
test: list=2,5,5,8,9
expect: => i=4 r=0.0 ok=true s="swapped peak with tail: 4" errors=0 n=5 res=[2,5,5,8,9] cache=4 hits=1
test: list=3,7,7,7,12
expect: => i=3 r=0.0 ok=true s="swapped peak with tail: 3" errors=0 n=5 res=[3,7,7,7,12] cache=3 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cur, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cur + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	var max_idx = 0;
	for i in g.cn {
		if g.cv[i] > g.cv[max_idx] {
			max_idx = i;
		}
	}
	if g.cn > 0 && max_idx != g.cn - 1 {
		let last = g.cn - 1;
		let tk = g.ck[max_idx];
		let tv = g.cv[max_idx];
		g.ck[max_idx] = g.ck[last];
		g.cv[max_idx] = g.cv[last];
		g.ck[last] = tk;
		g.cv[last] = tv;
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "swapped peak with tail: ", g.cn);
	out
}
@end
