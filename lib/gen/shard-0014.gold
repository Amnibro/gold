fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var u_vals int[256] = [0; 256];
	var u_cnts int[256] = [0; 256];
	var u_len = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in u_len {
