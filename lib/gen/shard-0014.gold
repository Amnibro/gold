test: list=10,20,30,40 cp=2
expect: => i=30 r=0.0 ok=true s="repeated checkpoint: 30" errors=0 n=4 res=[10,20,30,30] cache=0 hits=0
test: list=5,15,25,35,45 cp=3
expect: => i=35 r=0.0 ok=true s="repeated checkpoint: 35" errors=0 n=5 res=[5,15,25,35,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${cp};
	if idx >= 0 && idx < g.n {
		let val = g.res[idx];
		var m = 0;
		var i = 0;
		while i <= idx {
			g.res[m] = g.res[i];
			m++;
			i++;
		}
		if m < 512 {
			g.res[m] = val;
			m++;
		}
		g.n = m;
		out.i = val;
		out.s.clear();
		format(out.s, "repeated checkpoint: ", val);
	} else {
		gold_fail(g, "checkpoint out of range");
		out.ok = false;
	}
	g.steps += g.n;
	out
}
@end
