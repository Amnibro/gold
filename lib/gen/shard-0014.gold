fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mi = ${max_inversions};
	var inversions = 0;
	if v.s.len > 1 {
		var i = 0;
		while (i + 1) < v.s.len {
			if v.s[i] > v.s[i + 1] {
				inversions++;
			}
			i++;
		}
	}
	g.steps += v.s.len + 1;
	out.ok = (inversions <= mi);
	out.i = inversions;
	out.s.clear();
	format(out.s, "pairwise inversions: ", inversions);
	out
}
@end
