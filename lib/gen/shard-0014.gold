phrase: exchange trailing cache items up to {limit} swaps
slot: limit int
test: list=1,2,3,4,5 limit=2
expect: => i=2 r=0.0 ok=true s="swapped cache suffix: 2" errors=0 n=5 res=[1,2,3,4,5] cache=5 hits=0
