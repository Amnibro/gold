fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.ih < 2 { gold_fail(g, "texture height too small"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (y as real) / ((g.ih - 1) as real);
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * ${c} + 0.5); }
	for k in g.iw * g.ih {
		var t = (g.img[k] * 5.0) as! int;
		if t > 4 { t = 4; }
		g.img[k] = (t as real) / 4.0;
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
