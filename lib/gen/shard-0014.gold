code:
fn ${ID}_sub(x int) int, bool {
	if x < 0 {
		return 0, false;
	}
	return x * 2, true;
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errors = 0;
	for k in g.n {
		let res, ok = ${ID}_sub(g.res[k]);
		if !ok {
			gold_fail(g, "subfunction rejected negative input");
			errors++;
		} else {
			g.res[k] = res;
		}
	}
	out.i = errors;
	out.ok = errors == 0;
	out.s.clear();
	format(out.s, "subfunction errors encountered: ", errors);
	out
}
@end
