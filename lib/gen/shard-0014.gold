fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let n = out.s.len;
	if n < 2 {
		out.i = 0;
		return out;
	}
	var match_count = 0;
	var i = 0;
	while i < n - 1 {
		if out.s[i] == out.s[i + 1] {
			match_count++;
		}
		i++;
	}
	g.steps += n;
