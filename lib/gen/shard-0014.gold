fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let req = ${min_count};
	var u_vals int[256] = [0; 256];
	var u_cnts int[256] = [0; 256];
	var u_len = 0;
	for i in g.n {
		let x = g.res[i];
		var found = false;
		for j in u_len {
			if u_vals[j] == x {
				u_cnts[j]++;
				found = true;
				break;
			}
		}
		if !found && u_len < 256 {
			u_vals[u_len] = x;
			u_cnts[u_len] = 1;
			u_len++;
		}
	}
	gold_clear(g);
	for i in u_len {
		if u_cnts[i] >= req {
			gold_push(g, u_vals[i]);
		}
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "qualifying histogram items: ", g.n);
	out
}
@end
