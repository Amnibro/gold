code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var is_prime = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_prime = false; break; }
			d++;
		}
		if is_prime {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "prime search matches count: ", kept);
	out
}
@end
