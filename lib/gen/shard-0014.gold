@entry 1d10c2e1fac147e0
kind: step
verb: select
noun: suffix
modifier: all
context: search
phrase: select all suffix elements starting from index {start}
phrase: retain suffix from start offset {start}
slot: start int
test: list=10,20,30,40,50 start=2
expect: => i=3 r=0.0 ok=true s="suffix items selected: 3" errors=0 n=3 res=[30,40,50] cache=0 hits=0
test: list=1,2,3 start=1
expect: => i=2 r=0.0 ok=true s="suffix items selected: 2" errors=0 n=2 res=[2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${start};
	if s >= g.n || s < 0 {
		g.n = 0;
		out.i = 0;
		out.s.clear();
		format(out.s, "suffix start out of bounds");
		return out;
	}
	var kept = 0;
	var i = s;
	while i < g.n {
		g.res[kept] = g.res[i];
		kept++;
		i++;
	}
	g.steps += kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "suffix items selected: ", kept);
	out
}
@end
