code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${low};
	let h = ${high};
	var cached = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			let a = g.res[i];
			let b = g.res[i + 1];
			if a >= l && a <= h && b >= l && b <= h {
				gold_cache_put(g, i, a + b);
				cached++;
			}
		}
	}
	g.steps += g.n + 1;
	out.i = cached;
	out.s.clear();
	format(out.s, "cached ", cached, " adjacent pairs between bounds");
	out
}
@end
