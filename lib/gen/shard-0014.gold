fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fb = ${fallback};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var total_diff = 0;
	if g.n > 1 {
		for k in (g.n - 1) {
			var diff = g.res[k + 1] - g.res[k];
			if diff <= 0 { diff = fb; }
			total_diff += diff;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = total_diff;
	out.s.clear();
	format(out.s, "total difference sum: ", total_diff);
	out
}
@end
