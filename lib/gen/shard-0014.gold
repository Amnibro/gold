phrase: compute mean element value with retry attempts {max_retry}
slot: max_retry int
test: list=10,20,30 max_retry=2
expect: => i=20 r=0.0 ok=true s="average trace: 20" errors=0 n=4 res=[10,20,30,20] cache=0 hits=0
test: list=5,15,25,35 max_retry=3
expect: => i=20 r=0.0 ok=true s="average trace: 20" errors=0 n=5 res=[5,15,25,35,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${max_retry};
	var sum = 0;
	for i in g.n {
		sum += g.res[i];
	}
	let avg = if g.n > 0 { sum / g.n } else { 0 };
	var r = 0;
	while g.n == 0 && r < max_r {
		r++;
		g.steps += r;
	}
	out.i = avg;
	gold_push(g, avg);
	out.s.clear();
	format(out.s, "average trace: ", avg);
	out
}
@end
