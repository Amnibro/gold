		} else {
			max_sum += b;
		}
		i += 2;
	}
	g.steps += pairs;
	out.i = max_sum;
	out.ok = true;
	out.s.clear();
	format(out.s, "compared ", pairs, " pairwise maximums total: ", max_sum);
	out
}
