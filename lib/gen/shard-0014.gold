context: compare
phrase: rotate suffix between limits {lo} {hi}
phrase: rotate suffix elements between bounds {lo} {hi}
slot: lo int
slot: hi int
test: list=1,2,3,4,5 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="rotated suffix slice of size 3" errors=0 n=5 res=[1,4,2,3,5] cache=0 hits=0
test: list=1,2 lo=5 hi=10
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if lo < 0 || hi >= g.n || lo >= hi {
		gold_fail(g, "invalid slice bounds for rotation");
		out.ok = false;
		return out;
	}
	let last = g.res[hi];
	var i = hi;
	while i > lo {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[lo] = last;
	g.steps += (hi - lo + 1);
	out.i = hi - lo + 1;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated suffix slice of size ", out.i);
	out
}
@end
