test: list=10,2,30 fill_val=5
expect: => i=5 r=0.0 ok=true s="replaced minimum with unique value 5" errors=0 n=3 res=[10,5,30] cache=0 hits=0
test: list=10,2,30 fill_val=10
expect: => i=0 r=0.0 ok=false s="error: value not unique" errors=1 n=3 res=[10,2,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let fill_val = ${fill_val};
	if g.n == 0 {
		gold_fail(g, "empty list cannot fill");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	for k in g.n {
		if g.res[k] == fill_val {
			gold_fail(g, "value not unique");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: value not unique");
			return out;
		}
	}
	var min_idx = 0;
	var min_val = g.res[0];
	for k in g.n {
		if g.res[k] < min_val {
			min_val = g.res[k];
			min_idx = k;
		}
	}
	g.res[min_idx] = fill_val;
	g.steps += g.n;
	out.i = fill_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "replaced minimum with unique value ", fill_val);
	out
}
@end
@entry 0fa5e4d81ddebf02
kind: step
verb: limit
noun: primes
modifier: safely
context: compare
phrase: limit prime numbers safely to cap {cap}
phrase: filter to cap primes safely at {cap} items
slot: cap int
test: list=2,3,4,5,6,7 cap=2
expect: => i=2 r=0.0 ok=true s="safely limited primes to 2" errors=0 n=2 res=[2,3] cache=0 hits=0
test: list=1,4,6 cap=2
expect: => i=0 r=0.0 ok=false s="no primes found" errors=1 n=3 res=[1,4,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	if cap <= 0 {
		gold_fail(g, "cap must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: cap must be positive");
		return out;
	}
	var primes = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n && count < cap {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				primes[count] = x;
				count++;
			}
		}
		i++;
	}
	if count == 0 {
		gold_fail(g, "no primes found");
		out.ok = false;
		out.s.clear();
		format(out.s, "no primes found");
		return out;
	}
	for k in count {
		g.res[k] = primes[k];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "safely limited primes to ", count);
	out
}
@end
