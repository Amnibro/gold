@entry 205d6c9fbbbc01c1
kind: step
verb: rank
noun: middle
modifier: unique
context: text
phrase: rank unique characters in middle text segment
phrase: score distinct letters within central string section
test: text="aedcbaz"
expect: => i=5 r=0.0 ok=true s="unique middle ranked: 5" errors=0 n=5 res=[5,4,3,2,1] cache=0 hits=0
test: text="banana"
expect: => i=2 r=0.0 ok=true s="unique middle ranked: 2" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq: byte[512] = [' '; 512];
	var u_count = 0;
	if out.s.len > 2 {
		for i in 1..(out.s.len - 1) {
			let c = out.s[i];
			var seen = false;
			for j in u_count {
				if uniq[j] == c {
					seen = true;
					break;
				}
			}
			if !seen {
				uniq[u_count] = c;
				u_count++;
			}
		}
	}
	for i in u_count {
		var rank = 1;
		for j in u_count {
			if uniq[j] < uniq[i] {
				rank++;
			}
		}
