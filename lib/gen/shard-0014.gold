test: list=10,20,30
expect: => i=80 r=0.0 ok=true s="pairwise grand total 80" errors=0 n=2 res=[30,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n <= 1 { return out; }
	var temp int[512] = [0; 512];
	var m = 0;
	var grand_sum = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		temp[m] = s;
		grand_sum += s;
		m++;
		i++;
	}
	for k in m { g.res[k] = temp[k]; }
	g.n = m;
	g.steps += m;
	out.i = grand_sum;
	out.s.clear();
	format(out.s, "pairwise grand total ", grand_sum);
	out
}
@end
