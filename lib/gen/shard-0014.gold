fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let rd = ${recursion_depth};
	var current_len = g.n;
	var d = 0;
	while d < rd && current_len > 1 {
		current_len /= 2;
		d++;
	}
	g.n = current_len;
	g.steps += d + 1;
	out.i = current_len;
	out.s.clear();
	format(out.s, "recursively reduced length: ", current_len);
	out
}
@end
