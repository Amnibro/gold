code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in out.s.len {
		gold_cache_put(g, i, out.s[i] as int);
	}
	var sum = 0;
	var i = g.cn;
	while i > 0 {
		i--;
		let val, ok = gold_cache_get(g, i);
		if ok {
			sum += val;
		}
	}
	out.i = sum;
	gold_push(g, sum);
	out.s.clear();
	format(out.s, "reversed cache sum: ", sum);
	out
}
@end
