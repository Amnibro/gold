fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	let delta = ${delta};
	var count = 0;
	for k in g.n {
		if g.res[k] < cap {
			g.res[k] = g.res[k] + delta;
			count++;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if count > 0 {
		out.i = count;
		out.ok = true;
		format(out.s, "shifted ", count, " items while below cap");
	} else {
		gold_fail(g, "no elements below cap");
		out.i = 0;
		out.ok = false;
		format(out.s, "no elements below cap");
	}
	out
}
@end
