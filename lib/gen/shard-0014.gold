noun: digits
modifier: nested
context: list
phrase: check digit sums across nested list items with {p}
phrase: verify nested element digit sums using predicate {p}
slot: p pred
test: list=12,34,56 p=is_even
expect: => i=0 r=0.0 ok=false s="checked nested digits ok: false" errors=0 n=3 res=[12,34,56] cache=0 hits=0
