fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 1 {
		for i in 0..(g.n - 1) {
			g.res[i] = g.res[i + 1] - g.res[i];
		}
		g.n = g.n - 1;
		out.i = g.n;
	} else {
		gold_clear(g);
		out.i = 0;
	}
	out.s.clear();
	format(out.s, "nested gaps count: ", out.i);
	out
}
@end
