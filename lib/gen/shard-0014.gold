fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var current_total = 0;
	var i = 0;
	while i < g.n {
		current_total += g.res[i];
		i++;
	}
	let cached_val, has_cached = gold_cache_get(g, 0);
	if !has_cached || current_total > cached_val {
		gold_cache_put(g, 0, current_total);
		out.ok = true;
	} else {
		out.ok = false;
	}
	g.steps += g.n + 1;
	out.i = current_total;
	out.s.clear();
	format(out.s, "evaluated total with cache: ", current_total);
