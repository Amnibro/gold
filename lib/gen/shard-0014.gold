expect: => img: 32x32 min=0 max=1 sum8=130560 hash=788726
test: q=4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.iw < 2 { gold_fail(g, "texture too narrow"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (x as real) / ((g.iw - 1) as real);
		}
	}
	for k in g.iw * g.ih { g.img[k] = gold_clamp01((g.img[k] - 0.5) * 1.5 + 0.5); }
	if ${q} < 2 || ${q} > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (${q} as real)) as! int;
		if t > ${q} - 1 { t = ${q} - 1; }
		g.img[k] = (t as real) / ((${q} - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "stone");
	out
}
@end
