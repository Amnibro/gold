noun: duplicates
modifier: while
context: loop
phrase: apply duplicates while total elements under limit {limit}
phrase: duplicate each value while size remains below {limit}
slot: limit int
test: list=1,2,3 limit=10
expect: => i=6 r=0.0 ok=true s="applied duplicates while under limit keeping 6" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=1,2 limit=2
expect: => i=0 r=0.0 ok=true s="size already at or above limit" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	if g.n >= limit || g.n == 0 {
		out.ok = true;
		out.s.clear();
		format(out.s, "size already at or above limit");
		return out;
	}
	var new_res = [0; 512];
	var new_n = 0;
	var i = 0;
	while i < g.n && new_n + 1 < limit && new_n + 1 < 512 {
		new_res[new_n] = g.res[i];
		new_n++;
		new_res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	while i < g.n && new_n < 512 {
		new_res[new_n] = g.res[i];
		new_n++;
		i++;
	}
	for idx in new_n {
		g.res[idx] = new_res[idx];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied duplicates while under limit keeping ", new_n);
	out
}
@end
