fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${min_lim};
	let hi = ${max_lim};
	var m = 0;
	var tot = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			g.res[m] = x;
			tot += x;
			m++;
		}
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "bounded values sum ", tot);
	out
}
@end
