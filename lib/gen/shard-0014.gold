@entry 9647c7cbbc4aef21
kind: step
verb: rotate
noun: duplicates
modifier: until
context: math
phrase: rotate duplicated elements until predicate {stop} matches
phrase: shift repeated values cyclically until condition {stop}
slot: stop pred
test: list=1,2,2,3,4,4,5 stop=is_even
expect: => i=1 r=0.0 ok=true s="duplicate shifts: 1" errors=0 n=7 res=[1,4,2,3,2,4,5] cache=0 hits=0
test: list=7,7,8,9,9,10 stop=over_100
expect: => i=4 r=0.0 ok=true s="duplicate shifts: 4" errors=0 n=6 res=[7,7,8,9,9,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_idx: int[512] = [0; 512];
	var dup_val: int[512] = [0; 512];
	var count = 0;
	for i in g.n {
		let val = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == val {
				freq++;
			}
		}
		if freq > 1 && count < 512 {
			dup_idx[count] = i;
			dup_val[count] = val;
			count++;
		}
	}
	var shifts = 0;
	if count > 1 {
		while shifts < count {
			shifts++;
			for i in count {
				let src = (i - 1 + count) % count;
				g.res[dup_idx[i]] = dup_val[src];
			}
			for i in count {
				dup_val[i] = g.res[dup_idx[i]];
			}
			if ${stop}(g.res[dup_idx[0]]) {
				break;
			}
		}
	}
	out.i = shifts;
	out.s.clear();
	format(out.s, "duplicate shifts: ", shifts);
	out
}
@end
