		for x in g.iw {
			g.img[y * g.iw + x] = gold_worley(x, y, 8, g.iw / 8, ${u});
		}
	}
	var s_r = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_r[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_r;
	for k in g.iw * g.ih { g.img[k] = gold_clamp01(0.2 + 0.6 * g.img[k]); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "roughness");
	out
}
@end
