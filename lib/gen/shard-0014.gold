@entry d92fdc21e52fd35e
kind: step
verb: select
noun: primes
modifier: while
context: sort
phrase: select sorted prime numbers while below sum {limit}
phrase: gather sorted primes while cumulative total stays under {limit}
slot: limit int
test: list=10,2,7,4,3,5 limit=10
expect: => i=3 r=0.0 ok=true s="selected primes count: 3" errors=0 n=3 res=[2,3,5] cache=0 hits=0
test: list=13,11,2,8 limit=5
expect: => i=1 r=0.0 ok=true s="selected primes count: 1" errors=0 n=1 res=[2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	let max_sum = ${limit};
	var write = 0;
	var current_sum = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			if current_sum + x <= max_sum {
				g.res[write] = x;
				write++;
				current_sum += x;
			} else {
				break;
			}
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "selected primes count: ", write);
	out
}
@end
