code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var valid_prefix = 0;
	var i = 0;
	while i < g.n {
		if !${check_pred}(g.res[i]) { break; }
		valid_prefix++;
		i++;
	}
	g.steps += i + 1;
	out.i = valid_prefix;
	out.s.clear();
	format(out.s, "prefix length matching condition: ", valid_prefix);
	out
}
@end
