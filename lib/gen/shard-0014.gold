@entry e8d5bc5a4f3587de
kind: step
verb: fold
noun: limit
modifier: unique
context: math
slot: max_sum int
phrase: fold limit unique summing distinct items under {max_sum}
phrase: accumulate unique values up to bound {max_sum}
test: list=2,2,3,4,4,5 max_sum=10
expect: => i=9 r=0.0 ok=true s="folded unique up to limit: 9" errors=0 n=6 res=[2,2,3,4,4,5] cache=0 hits=0
test: list=1,1,2,3,5 max_sum=6
expect: => i=6 r=0.0 ok=true s="folded unique up to limit: 6" errors=0 n=5 res=[1,1,2,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_sum};
	var total = 0;
	var count = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen = false;
		var j = 0;
		while j < i {
			if g.res[j] == x {
				seen = true;
				break;
			}
			j++;
		}
		if !seen {
			if total + x > limit {
				break;
			}
			total += x;
			count++;
		}
		i++;
	}
	g.steps += g.n;
	out.i = total;
	out.s.clear();
	format(out.s, "folded unique up to limit: ", total);
	out
}
@end
