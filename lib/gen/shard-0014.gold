@entry 1bfb7a4b4159157a
kind: step
verb: clamp
noun: series
modifier: safely
context: search
phrase: clamp search series safely to step limit {max_step}
phrase: restrict series transitions safely within {max_step}
slot: max_step int
test: list=10,50,20,90 max_step=15
expect: => i=2 r=0.0 ok=true s="safely clamped series points: 2" errors=0 n=4 res=[10,25,20,35] cache=0 hits=0
test: list=5,30,10 max_step=10
expect: => i=1 r=0.0 ok=true s="safely clamped series points: 1" errors=0 n=3 res=[5,15,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_step};
	var clamped_cnt = 0;
	var i = 1;
	while i < g.n {
		let prev = g.res[i - 1];
		var cur = g.res[i];
		if cur > prev + limit {
			cur = prev + limit;
			clamped_cnt++;
		} else if cur < prev - limit {
			cur = prev - limit;
			clamped_cnt++;
		}
		g.res[i] = cur;
		i++;
	}
	g.steps += g.n;
	out.i = clamped_cnt;
	out.s.clear();
	format(out.s, "safely clamped series points: ", clamped_cnt);
	out
}
@end
@entry eb7eaba7d88011d7
kind: step
verb: sort
noun: squares
modifier: unique
context: search
phrase: sort unique square numbers from search
phrase: order distinct search squares in ascending sequence
test: list=16,9,25,9,4,16
expect: => i=4 r=0.0 ok=true s="sorted unique squares count: 4" errors=0 n=4 res=[4,9,16,25] cache=0 hits=0
test: list=36,49,4,25,4
expect: => i=4 r=0.0 ok=true s="sorted unique squares count: 4" errors=0 n=4 res=[4,25,36,49] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		if core_is_square(x) {
			var seen = false;
			for j in kept {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[kept] = x;
				kept++;
			}
		}
	}
	var i = 0;
	while i < kept {
		var j = i + 1;
		while j < kept {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n + kept * kept;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "sorted unique squares count: ", kept);
	out
}
@end
