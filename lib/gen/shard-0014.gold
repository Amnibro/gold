expect: => i=4 r=0.0 ok=true s="recursive comparison passes: 4" errors=0 n=5 res=[1,3,6,7,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var passes = 0;
	var changed = true;
	while changed && passes < 10 {
		changed = false;
		var i = 0;
		while i + 1 < g.n {
			if g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				changed = true;
			}
			i++;
		}
		passes++;
	}
	g.steps += g.n * passes;
	out.i = passes;
	out.s.clear();
	format(out.s, "recursive comparison passes: ", passes);
	out
}
@end
