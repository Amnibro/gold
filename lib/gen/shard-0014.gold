fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let max_sq = ${limit};
	var sq_count = 0;
	for i in g.cn {
		let x = g.cv[i];
		if x >= 0 {
			var is_sq = false;
			var r = 0;
			while r * r <= x {
				if r * r == x { is_sq = true; break; }
				r++;
			}
			if is_sq {
				sq_count++;
				if sq_count >= max_sq {
					break;
				}
			}
		}
	}
	out.i = sq_count;
	out.s.clear();
	format(out.s, "squares found in cache: ", sq_count);
