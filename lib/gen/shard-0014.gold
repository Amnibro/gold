expect: => i=1 r=0.0 ok=true s="checked nested digits ok: true" errors=0 n=3 res=[21,43,65] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var ok = true;
	for i in g.n {
		var n = g.res[i];
		if n < 0 { n = -n; }
		var dsum = 0;
		while n > 0 {
			dsum += n % 10;
			n /= 10;
		}
		if !${p}(dsum) {
			ok = false;
			break;
		}
	}
	g.steps += g.n + 1;
	out.ok = ok;
	out.i = if ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "checked nested digits ok: ", ok);
	out
}
@end
