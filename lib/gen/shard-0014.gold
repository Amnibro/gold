code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_len};
	let cp = ${copies};
	if cp <= 0 || g.n * cp > ml || g.n * cp > 512 {
		gold_fail(g, "repeated length exceeds maximum limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: repeated length exceeds maximum limit");
		return out;
	}
	let orig_n = g.n;
	for c in (cp - 1) {
		for i in orig_n {
			gold_push(g, g.res[i]);
		}
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "repeated array within limit: ", g.n);
	out
}
