expect: => i=5 r=0.0 ok=true s="rotated to minimum: 5" errors=0 n=5 res=[5,40,10,15,25] cache=0 hits=0
test: list=30,8,12,20
expect: => i=8 r=0.0 ok=true s="rotated to minimum: 8" errors=0 n=4 res=[8,12,20,30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "rotated empty");
		return out;
	}
	var min_idx = 0;
	var min_val = g.res[0];
	var i = 1;
	while i < g.n {
		if g.res[i] < min_val {
			min_val = g.res[i];
			min_idx = i;
		}
		i++;
	}
	var temp int[512] = [0; 512];
	for j in g.n {
		temp[j] = g.res[(j + min_idx) % g.n];
	}
	for j in g.n {
		g.res[j] = temp[j];
	}
	g.steps += g.n * 2;
	out.i = min_val;
	out.s.clear();
	format(out.s, "rotated to minimum: ", min_val);
	out
}
@end
