test: list=5,17,19,23 max_prime=15
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,15,15,15] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mp = ${max_prime};
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) && g.res[i] > mp {
			g.res[i] = mp;
		}
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
