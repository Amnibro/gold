kind: step
verb: reverse
noun: number
modifier: times
context: compare
slot: num_times int
phrase: compare sequence reversing items repeat {num_times} times
phrase: reverse numbers {num_times} times during comparison
test: list=1,2,3,4 num_times=2
expect: => i=2 r=0.0 ok=true s="reversed number times: 2" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=10,20,30 num_times=3
expect: => i=3 r=0.0 ok=true s="reversed number times: 3" errors=0 n=3 res=[30,20,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let nt = ${num_times};
	for t in nt {
		var left = 0;
		var right = g.n - 1;
		while left < right {
			let tmp = g.res[left];
			g.res[left] = g.res[right];
			g.res[right] = tmp;
			left++;
			right--;
		}
	}
	g.steps += g.n * nt + 1;
	out.i = nt;
	out.s.clear();
	format(out.s, "reversed number times: ", nt);
	out
}
@end
@entry 23fb03f9044737e3
kind: step
verb: merge
noun: primes
modifier: up_to
context: compare
slot: prime_bound int
phrase: compare sequence merging prime values up to {prime_bound}
phrase: merge primes up to bound {prime_bound} into results
test: list=4,6,8,9 prime_bound=10
expect: => i=4 r=0.0 ok=true s="primes merged up to limit: 4" errors=0 n=8 res=[4,6,8,9,2,3,5,7] cache=0 hits=0
test: list=1,15,20 prime_bound=7
expect: => i=4 r=0.0 ok=true s="primes merged up to limit: 4" errors=0 n=7 res=[1,15,20,2,3,5,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let pb = ${prime_bound};
	var merged = 0;
	var candidate = 2;
	while candidate <= pb {
		var is_p = true;
		var d = 2;
		while d * d <= candidate {
			if candidate % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, candidate);
			merged++;
		}
		candidate++;
	}
	g.steps += merged * 2;
	out.i = merged;
	out.s.clear();
	format(out.s, "primes merged up to limit: ", merged);
	out
}
@end
