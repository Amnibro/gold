@entry f15d5b49964fe35b
kind: step
verb: dedupe
noun: list
modifier: until
context: list
phrase: dedupe list items until predicate {stop} matches
phrase: remove duplicate values stopping when condition {stop} met
slot: stop pred
test: list=1,1,2,2,3,3,4 stop=is_even
expect: => i=6 r=0.0 ok=true s="deduped count: 6" errors=0 n=6 res=[1,2,2,3,3,4] cache=0 hits=0
test: list=5,5,6,6,7,7 stop=over_100
expect: => i=3 r=0.0 ok=true s="deduped count: 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	var stopped = false;
	for i in g.n {
		let x = g.res[i];
		if !stopped {
			var seen = false;
			for j in write {
				if g.res[j] == x {
					seen = true;
					break;
				}
			}
			if !seen {
				g.res[write] = x;
				write++;
			}
			if ${stop}(x) {
				stopped = true;
			}
		} else {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "deduped count: ", write);
	out
}
@end
