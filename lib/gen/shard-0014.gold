code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cv = ${char_val};
	if cv.len == 0 { return out; }
	let target_char = cv[0];
	var new_s byte[..200] = "";
	var dropped = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == target_char {
			dropped++;
		} else {
			if new_s.len < 199 {
				new_s.push(c);
			}
		}
		i++;
	}
	g.steps += v.s.len + 1;
	out.s = new_s;
	out.i = dropped;
	out
}
@end
