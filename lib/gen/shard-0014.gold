fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${r} <= 0.0 || ${h} <= 0.0 { gold_fail(g, "dimensions must be positive"); out.ok = false; return out; }
	for q in 4 {
		let px = if q == 0 { ${r} } else if q == 2 { 0.0 - ${r} } else { 0.0 };
		let py = if q == 1 { ${r} } else if q == 3 { 0.0 - ${r} } else { 0.0 };
		o.clear();
		gold_dnews(g, "shrub", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, ${h});
		o.append(" r0.8 ");
		o.append("nz.05");
		o.append(":.3 m:matte ");
		gold_hex(o, 50, 120, 45);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "cliff rim shrubs");
	out
}
