fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let drop_k = ${count};
	let start = if drop_k < g.n { drop_k } else { g.n };
	var m = 0;
	var tot = 0;
	var i = start;
	while i < g.n {
		let x = g.res[i];
		g.res[m] = x;
		tot += x;
		m++;
		i += 2;
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "dropped prefix alternate sum ", tot);
	out
}
@end
