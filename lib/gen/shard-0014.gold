test: list=10,5,5,15
expect: => i=1 r=0.0 ok=true s="unique minimum pairs: 1" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var write = 0;
	for k in g.n {
		if write == 0 || g.res[k] != g.res[write - 1] {
			g.res[write] = g.res[k];
			write++;
		}
	}
	g.n = write;
	var pairs = 0;
	var idx = 0;
	while idx + 1 < g.n {
		g.res[pairs] = g.res[idx] + g.res[idx + 1];
		pairs++;
		idx += 2;
	}
	g.n = pairs;
	out.i = pairs;
	out.s.clear();
	format(out.s, "unique minimum pairs: ", pairs);
	out
}
@end
