fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${repeats};
	let orig_n = g.n;
	var added = 0;
	var rep = 1;
	while rep < r && g.n < 512 {
		for i in orig_n {
			if g.n < 512 {
				gold_push(g, g.res[i]);
				added++;
			}
		}
		rep++;
	}
	g.steps += added + 1;
	out.i = added;
	out.s.clear();
	format(out.s, "repeated window added ", added, " items");
	out
}
