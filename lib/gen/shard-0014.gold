fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let len = out.s.len;
	if len == 0 { return out; }
	var i = 0;
	while i < len / 2 {
		let tmp = out.s[i];
		out.s[i] = out.s[len - 1 - i];
		out.s[len - 1 - i] = tmp;
		i++;
	}
	gold_cache_put(g, 0, len);
	g.steps += len;
	out.i = len;
	out
}
@end
