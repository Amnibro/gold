fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var orig: int[512] = [0; 512];
	for i in g.n {
		orig[i] = g.res[i];
	}
	for i in g.n {
		var rank = 1;
		for j in g.n {
			if orig[j] < orig[i] {
				rank++;
