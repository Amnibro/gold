fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var max_idx = 0;
	for i in 1..g.n {
		if g.res[i] > g.res[max_idx] { max_idx = i; }
	}
	var cur = g.res[max_idx];
	var attempts = 0;
	while !${p}(cur) && attempts < 10 {
		cur *= 2;
		attempts++;
	}
	g.res[max_idx] = cur;
	g.steps += attempts + 1;
	out.ok = ${p}(cur);
	out.i = cur;
	out.s.clear();
	format(out.s, "retried maximum value: ", cur);
	out
}
@end
@entry d438ee0875f0d23e
kind: step
verb: merge
noun: checkpoint
modifier: at_most
context: list
phrase: merge elements into checkpoint buckets of at most {max_size}
phrase: partition list into checkpoint chunks at most size {max_size}
slot: max_size int
test: list=1,2,3,4,5,6,7 max_size=3
expect: => i=3 r=0.0 ok=true s="merged checkpoints count: 3" errors=0 n=3 res=[6,15,7] cache=0 hits=0
test: list=10,20,30,40 max_size=2
expect: => i=2 r=0.0 ok=true s="merged checkpoints count: 2" errors=0 n=2 res=[30,70] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let sz = ${max_size};
	if sz <= 0 || g.n == 0 { return out; }
	var chunks = 0;
	var i = 0;
	while i < g.n {
		var chunk_sum = 0;
		var j = 0;
		while j < sz && i + j < g.n {
			chunk_sum += g.res[i + j];
			j++;
		}
		g.res[chunks] = chunk_sum;
		chunks++;
		i += sz;
	}
	g.n = chunks;
	g.steps += chunks;
	out.i = chunks;
	out.s.clear();
	format(out.s, "merged checkpoints count: ", chunks);
	out
}
@end
@entry f1c7b601e3f17e13
kind: step
verb: swap
noun: average
modifier: sorted
context: list
phrase: swap elements across average boundary maintaining sorted order
phrase: partition sorted list swapping values around mean
test: list=2,4,6,8,10
expect: => i=6 r=0.0 ok=true s="swapped around average: 6" errors=0 n=5 res=[10,8,6,4,2] cache=0 hits=0
test: list=1,3,7,9,15
expect: => i=7 r=0.0 ok=true s="swapped around average: 7" errors=0 n=5 res=[15,9,7,3,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	var i = 0;
	var j = g.n - 1;
	while i < j {
		if g.res[i] < avg && g.res[j] > avg {
			let tmp = g.res[i];
			g.res[i] = g.res[j];
			g.res[j] = tmp;
			i++;
			j--;
		} else {
			if g.res[i] >= avg { i++; }
			if g.res[j] <= avg { j--; }
		}
	}
	g.steps += g.n;
	out.i = avg;
	out.s.clear();
	format(out.s, "swapped around average: ", avg);
	out
}
@end
