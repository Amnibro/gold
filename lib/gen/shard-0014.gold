expect: => i=0 r=0.0 ok=true s="prefix matched 0 times" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${prefix_letter};
	if p.len == 0 { return out; }
	let p_char = p[0];
	var count = 0;
	var is_start = true;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == ' ' {
			is_start = true;
		} else {
			if is_start {
				if c == p_char { count++; }
				is_start = false;
			}
		}
		i++;
	}
	g.steps += v.s.len + 1;
	out.i = count;
	out.s.clear();
	format(out.s, "prefix matched ", count, " times");
	out
}
@end
