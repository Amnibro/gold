expect: => i=2 r=0.0 ok=true s="unique above threshold: 2" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var write = 0;
	for k in g.n {
		if write == 0 || g.res[k] != g.res[write - 1] {
			g.res[write] = g.res[k];
			write++;
		}
	}
	g.n = write;
	let limit = ${threshold};
	var count = 0;
	for k in g.n {
		if g.res[k] > limit {
			count++;
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "unique above threshold: ", count);
	out
}
@end
