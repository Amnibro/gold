fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${win};
	var count = 0;
	if k > 0 && g.n >= k {
		for i in 0..(g.n - k + 1) {
			var sum = 0;
			for j in 0..k {
