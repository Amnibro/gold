@entry 22fbb86df42fc360
kind: step
verb: select
noun: duplicates
modifier: running
context: loop
phrase: select running duplicate values encountered during loop
phrase: loop selecting duplicate entries from running sequence
test: list=1,2,3,2,1,4
expect: => i=2 r=0.0 ok=true s="running duplicates found: 2" errors=0 n=2 res=[2,1] cache=0 hits=0
test: list=5,5,6,7,6,8
expect: => i=2 r=0.0 ok=true s="running duplicates found: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dups int[512] = [0; 512];
	var dc = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var seen = false;
		var k = 0;
		while k < idx {
			if g.res[k] == x { seen = true; break; }
			k++;
		}
		if seen {
			dups[dc] = x;
			dc++;
		}
		idx++;
	}
	for k in dc {
		g.res[k] = dups[k];
	}
	g.n = dc;
	g.steps += g.n;
	out.i = dc;
	out.s.clear();
	format(out.s, "running duplicates found: ", dc);
	out
}
@end
