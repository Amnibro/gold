@entry cfa8671938ace974
kind: step
verb: filter
noun: tail
modifier: safely
context: error
slot: tail_len int
slot: min_val int
phrase: filter tail safely of length {tail_len} with floor {min_val}
phrase: prune tail safely taking size {tail_len} filtering below {min_val}
test: list=10,20,5,30 tail_len=3 min_val=10
expect: => i=2 r=0.0 ok=true s="filtered tail safely count: 2" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=5,10 tail_len=5 min_val=20
expect: => i=0 r=0.0 ok=false s="error: tail length out of bounds" errors=1 n=2 res=[5,10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tl = ${tail_len};
	let mv = ${min_val};
	if tl <= 0 || tl > g.n {
		gold_fail(g, "tail length out of bounds");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: tail length out of bounds");
		return out;
	}
	let start = g.n - tl;
	var new_n = 0;
	var i = start;
	while i < g.n {
		if g.res[i] >= mv {
			g.res[new_n] = g.res[i];
			new_n++;
		}
		i++;
	}
	g.n = new_n;
	g.steps += tl + new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "filtered tail safely count: ", new_n);
	out
}
@end
