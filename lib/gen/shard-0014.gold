test: list=4,-4,0,3
expect: => i=3 r=0.0 ok=true s="unique squares count: 3" errors=0 n=3 res=[0,9,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		g.res[k] = x * x;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var write = 0;
	for k in g.n {
		if write == 0 || g.res[k] != g.res[write - 1] {
			g.res[write] = g.res[k];
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "unique squares count: ", write);
	out
}
@end
