@entry 02c56bd9184d17d1
kind: step
verb: shift
noun: average
modifier: up_to
context: transform
phrase: shift elements so average reaches up to {target}
phrase: adjust values moving average up to {target}
slot: target int
test: list=2,4,6 target=10
expect: => i=6 r=0.0 ok=true s="" errors=0 n=3 res=[8,10,12] cache=0 hits=0
test: list=10,20,30 target=25
expect: => i=5 r=0.0 ok=true s="" errors=0 n=3 res=[15,25,35] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	if g.n == 0 { return out; }
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	let avg = sum / g.n;
	let diff = tgt - avg;
	for i in g.n { g.res[i] += diff; }
	out.i = diff;
	g.steps += g.n + 1;
	out
}
@end
