@entry f3cefe70d799c3e4
kind: step
verb: filter
noun: primes
modifier: nested
context: math
phrase: filter prime values into nested results list
phrase: retain only prime numbers from results
test: list=2,3,4,5,6,7,8,9,10
expect: => i=4 r=0.0 ok=true s="primes count: 4" errors=0 n=4 res=[2,3,5,7] cache=0 hits=0
test: list=11,12,13,14,15,16,17
expect: => i=3 r=0.0 ok=true s="primes count: 3" errors=0 n=3 res=[11,13,17] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "primes count: ", write);
	out
}
@end
