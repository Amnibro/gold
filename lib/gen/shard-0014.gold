noun: runs
modifier: while
context: search
phrase: clamp consecutive search runs while exceeding {max_len}
phrase: truncate repeated search runs to length {max_len}
slot: max_len int
test: list=1,1,1,1,2,2,3,3,3 max_len=2
expect: => i=6 r=0.0 ok=true s="clamped runs total length: 6" errors=0 n=6 res=[1,1,2,2,3,3] cache=0 hits=0
test: list=5,5,5,5,5,6 max_len=1
expect: => i=2 r=0.0 ok=true s="clamped runs total length: 2" errors=0 n=2 res=[5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit_run = ${max_len};
	if g.n == 0 {
		out.i = 0;
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n {
		let val = g.res[i];
		var run_len = 0;
		while i < g.n && g.res[i] == val {
			run_len++;
			if run_len <= limit_run {
				g.res[kept] = val;
				kept++;
			}
			i++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped runs total length: ", kept);
	out
}
@end
