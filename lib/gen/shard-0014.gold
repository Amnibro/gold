kind: step
verb: clamp
noun: duplicates
modifier: all
context: search
phrase: clamp duplicate search occurrences to {max_count}
phrase: restrict all duplicate search hits to {max_count}
slot: max_count int
test: list=4,4,4,4,5,5,6 max_count=2
expect: => i=5 r=0.0 ok=true s="clamped duplicate items: 5" errors=0 n=5 res=[4,4,5,5,6] cache=0 hits=0
test: list=1,1,1,2,2,3 max_count=1
expect: => i=3 r=0.0 ok=true s="clamped duplicate items: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${max_count};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < cap {
			g.res[kept] = x;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "clamped duplicate items: ", kept);
	out
}
@end
@entry 243ec2b6c221dc8d
kind: step
verb: rank
noun: values
modifier: last
context: search
phrase: rank search values relative to last match
phrase: compute distance rank from last search value
test: list=10,25,50,40
expect: => i=55 r=0.0 ok=true s="ranked distance sum to last: 55" errors=0 n=4 res=[30,15,10,0] cache=0 hits=0
test: list=5,12,30,20
expect: => i=33 r=0.0 ok=true s="ranked distance sum to last: 33" errors=0 n=4 res=[15,8,10,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "empty search values");
		return out;
	}
	let last_val = g.res[g.n - 1];
	var sum_dist = 0;
	for i in g.n {
		let diff = g.res[i] - last_val;
		let d = if diff < 0 { -diff } else { diff };
		g.res[i] = d;
		sum_dist += d;
	}
	g.steps += g.n;
	out.i = sum_dist;
	out.s.clear();
	format(out.s, "ranked distance sum to last: ", sum_dist);
	out
}
@end
