phrase: count distinct characters saving memo for each
test: text="banana"
expect: => i=3 r=0.0 ok=true s="memoized unique: 3" errors=0 n=0 res=[] cache=3 hits=0
test: text="mississippi"
expect: => i=4 r=0.0 ok=true s="memoized unique: 4" errors=0 n=0 res=[] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq = 0;
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in i {
			if out.s[j] == c {
				seen = true;
				break;
			}
		}
		if !seen {
			gold_cache_put(g, c as int, 1);
			uniq++;
		}
	}
	out.i = uniq;
	out.s.clear();
	format(out.s, "memoized unique: ", uniq);
	out
}
@end
@entry 5354364fe2cf86fc
kind: step
verb: dedupe
noun: threshold
modifier: first
context: text
phrase: dedupe first characters exceeding frequency threshold {thresh}
phrase: remove leading duplicate characters exceeding count {thresh}
slot: thresh int
test: text="aaabbbccc" thresh=2
expect: => i=3 r=0.0 ok=true s="abc" errors=0 n=0 res=[] cache=0 hits=0
test: text="xxxxxy" thresh=3
expect: => i=2 r=0.0 ok=true s="xy" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${thresh};
	var write = 0;
	for i in out.s.len {
		let c = out.s[i];
		var freq = 0;
		for j in out.s.len {
			if out.s[j] == c {
				freq++;
			}
		}
		if freq >= lim {
			var already = false;
			for k in write {
				if out.s[k] == c {
					already = true;
					break;
				}
			}
			if !already {
				out.s[write] = c;
				write++;
			}
		} else {
			out.s[write] = c;
			write++;
		}
	}
	out.s.resize(write, ' ');
	out.i = write;
	out
}
@end
