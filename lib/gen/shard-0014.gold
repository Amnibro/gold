context: compare
phrase: compare adjacent gaps swapping recursively until ordered
phrase: swap sequence gaps through recursive comparison passes
test: list=5,1,4,2,8
expect: => i=3 r=0.0 ok=true s="recursive comparison passes: 3" errors=0 n=5 res=[1,2,4,5,8] cache=0 hits=0
