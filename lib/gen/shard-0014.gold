@entry 766dff07fdf85e59
kind: step
verb: sum
noun: value
modifier: recursively
context: format
phrase: format recursive digit value sum
phrase: render digital sum recursively formatted
test: input=493
expect: => i=7 r=0.0 ok=true s="root=7 (iter=2)" errors=0 n=0 res=[] cache=0 hits=0
test: input=87
expect: => i=6 r=0.0 ok=true s="root=6 (iter=2)" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var num = out.i;
	var iterations = 0;
	while num >= 10 {
		var sum = 0;
		var temp = num;
		while temp > 0 {
			sum += temp % 10;
			temp /= 10;
		}
		num = sum;
		iterations++;
	}
	out.s.clear();
	format(out.s, "root=", num, " (iter=", iterations, ")");
	out.i = num;
	g.steps += iterations + 1;
	out
}
@end
