code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	gold_clear(g);
	if lim >= 2 {
		for num in 2..(lim + 1) {
			var is_p = true;
			var d = 2;
			while d * d <= num {
				if num % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				gold_push(g, num);
			}
		}
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "found primes up to: ", g.n);
	out
}
@end
