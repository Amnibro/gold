code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no middle element");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let mid_idx = g.n / 2;
	let mid_val = g.res[mid_idx];
	var i = mid_idx;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = mid_val;
	g.steps += g.n;
	out.i = mid_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "brought middle element to front: ", mid_val);
	out
}
@end
