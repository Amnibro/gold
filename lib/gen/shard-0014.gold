fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var rem = ${budget};
	var applied = 0;
	for i in g.n {
		let cost = g.res[i];
		if cost <= rem {
			rem -= cost;
			applied++;
		} else {
