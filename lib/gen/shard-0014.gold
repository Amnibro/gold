fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = ${stride};
	if st <= 0 { return out; }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		g.res[new_n] = g.res[idx];
		new_n++;
		idx += st;
	}
	g.steps += g.n * g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "collected ", new_n, " checkpoints");
	out
}
@end
