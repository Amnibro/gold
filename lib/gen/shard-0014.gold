fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var retried = false;
	if g.n > 0 {
		var res = g.res[0] * f;
		if res == 0 {
			res = 1;
			retried = true;
		}
		g.res[0] = res;
		out.i = res;
	} else {
		out.ok = false;
	}
	g.steps += g.n * g.n + 1;
	out.s.clear();
	format(out.s, "first item updated to ", out.i);
	out
}
@end
