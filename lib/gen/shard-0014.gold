fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	if x < 10 { return x; }
	var digits int[16] = [0; 16];
	var len = 0;
	while x > 0 {
		let d = x % 10;
		if d > 0 {
			digits[len] = d;
			len++;
		}
		x /= 10;
	}
	for i in len {
		for j in (i + 1)..len {
			if digits[j] < digits[i] {
				let tmp = digits[i];
				digits[i] = digits[j];
				digits[j] = tmp;
			}
		}
	}
	var res = 0;
	for i in len {
		res = res * 10 + digits[i];
	}
	res
}
@end
