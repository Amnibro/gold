@entry 3eb6b7123c5ef900
kind: step
verb: dedupe
noun: gaps
modifier: first
context: math
slot: gap int
phrase: dedupe gaps first matching separation {gap}
phrase: remove first duplicate difference matching {gap}
test: list=1,3,7,9,12 gap=2
expect: => i=1 r=0.0 ok=true s="deduped first gap: 1" errors=0 n=4 res=[1,7,9,12] cache=0 hits=0
test: list=2,7,12,18 gap=5
expect: => i=1 r=0.0 ok=true s="deduped first gap: 1" errors=0 n=3 res=[2,12,18] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${gap};
	var skip_idx = -1;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		let abs_d = if diff < 0 { -diff } else { diff };
		if abs_d == target {
			skip_idx = i + 1;
			break;
		}
		i++;
	}
	if skip_idx >= 0 {
		var m = skip_idx;
		while m + 1 < g.n {
			g.res[m] = g.res[m + 1];
			m++;
		}
		g.n--;
		out.i = skip_idx;
	} else {
		out.i = -1;
	}
	g.steps += g.n;
	out.s.clear();
	format(out.s, "deduped first gap: ", out.i);
	out
}
@end
