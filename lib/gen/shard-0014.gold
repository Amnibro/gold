code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let prev, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, prev + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	out.i = g.cn;
	out.s.clear();
	format(out.s, "cached ", g.cn, " keys");
	out
}
@end
