expect: => i=3 r=0.0 ok=true s="merged range count: 3" errors=0 n=3 res=[6,10,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${low_val};
	let hi = ${high_val};
	var matched = 0;
	var temp int[512] = [0; 512];
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= lo && x <= hi {
			temp[matched] = x;
			matched++;
		}
		i++;
	}
	for k in matched {
		g.res[k] = temp[k];
	}
	g.n = matched;
	g.steps += g.n + 1;
	out.i = matched;
	out.s.clear();
	format(out.s, "merged range count: ", matched);
	out
}
@end
