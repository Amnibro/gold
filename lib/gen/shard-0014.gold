code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${max_levels};
	var level = 0;
	while level < ml && out.s.len > 1 {
		out.s.pop();
		level++;
	}
	g.steps += level;
	out.i = out.s.len;
	out
}
