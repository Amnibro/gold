noun: average
modifier: running
context: stats
slot: window int
phrase: stats measure average running window {window}
phrase: compute moving average running span {window}
test: list=10,20,30,40 window=2
expect: => i=3 r=0.0 ok=true s="measured 3 running averages" errors=0 n=3 res=[15,25,35] cache=0 hits=0
test: list=5,15 window=1
expect: => i=2 r=0.0 ok=true s="measured 2 running averages" errors=0 n=2 res=[5,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${window};
	if w <= 0 || g.n == 0 { return out; }
	var new_n = 0;
	var i = 0;
	while (i + w) <= g.n {
		var sum = 0;
		for j in w {
			sum += g.res[i + j];
		}
		g.res[new_n] = sum / w;
		new_n++;
		i++;
	}
	g.steps += g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "measured ", new_n, " running averages");
	out
}
@end
@entry ecd0797794377022
kind: step
verb: merge
noun: vowels
modifier: with_retry
context: stats
slot: max_dupes int
phrase: stats merge vowels with retry duplicate cap {max_dupes}
phrase: consolidate text vowels with retry tolerance {max_dupes}
test: text="baaaad" max_dupes=1
expect: => i=3 r=0.0 ok=true s="bad" errors=0 n=0 res=[] cache=0 hits=0
test: text="tree" max_dupes=2
expect: => i=0 r=0.0 ok=true s="tree" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_dupes};
	var new_s byte[..200] = "";
	var merged = 0;
	var last_vowel: byte = 0;
	var repeat_cnt = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		let is_v = (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u');
		if is_v {
			if c == last_vowel {
				repeat_cnt++;
			} else {
				last_vowel = c;
				repeat_cnt = 1;
			}
			if repeat_cnt <= m {
				new_s.push(c);
			} else {
				merged++;
			}
		} else {
			last_vowel = 0;
			repeat_cnt = 0;
			new_s.push(c);
		}
		i++;
	}
	g.steps += v.s.len + 1;
	out.s = new_s;
	out.i = merged;
	out
}
@end
