@entry 3f8752d7970b71ae
kind: step
verb: measure
noun: limit
modifier: with_retry
context: error
phrase: measure limit threshold with retry attempts {retries}
phrase: evaluate limit value retrying up to {retries} times
slot: retries int
test: list=10,25,40 retries=3
expect: => i=40 r=0.0 ok=true s="measured maximum limit: 40" errors=0 n=3 res=[10,25,40] cache=0 hits=0
test: list= retries=2
expect: => i=0 r=0.0 ok=false s="retry attempts exhausted for empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_r = ${retries};
	var attempts = 0;
	var success = false;
	var max_val = 0;
	while attempts < max_r {
		attempts++;
		if g.n > 0 {
			max_val = g.res[0];
			for k in 1 .. g.n {
				if g.res[k] > max_val { max_val = g.res[k]; }
			}
			success = true;
			break;
		}
	}
	if !success {
		gold_fail(g, "failed to measure limit after retry attempts");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("retry attempts exhausted for empty list");
		return out;
	}
	out.i = max_val;
	out.ok = true;
	out.s.clear();
	format(out.s, "measured maximum limit: ", max_val);
	out
}
@end
@entry 97370ad538a44bb9
kind: step
verb: count
noun: values
modifier: times
context: error
phrase: count values appearing exactly {target_count} times
phrase: tally elements repeating {target_count} times checking errors
slot: target_count int
test: list=2,3,2,4,2,5 target_count=3
expect: => i=1 r=0.0 ok=true s="values meeting occurrence count: 1" errors=0 n=6 res=[2,3,2,4,2,5] cache=0 hits=0
test: list=1,2,3 target_count=0
expect: => i=0 r=0.0 ok=false s="invalid frequency target" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target_count};
	if target <= 0 {
		gold_fail(g, "target frequency must be strictly positive");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid frequency target");
		return out;
	}
	var matched = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = false;
		for prev in i {
			if g.res[prev] == x { seen_before = true; break; }
		}
		if !seen_before {
			var freq = 0;
			for j in g.n {
				if g.res[j] == x { freq++; }
			}
			if freq == target {
				matched++;
			}
		}
	}
	out.i = matched;
	out.ok = true;
	out.s.clear();
	format(out.s, "values meeting occurrence count: ", matched);
	out
}
@end
