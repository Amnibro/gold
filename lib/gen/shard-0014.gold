fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		let cur_count, found = gold_cache_get(g, x);
		if found {
			gold_cache_put(g, x, cur_count + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	g.steps += g.n;
	out.i = g.cn;
	out.s.clear();
	format(out.s, "unique cache entries ranked: ", g.cn);
	out
}
@end
