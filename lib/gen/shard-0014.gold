@entry cb96cddf2848161b
kind: step
verb: scale
noun: duplicates
modifier: until
context: loop
slot: factor int
slot: max_limit int
phrase: loop scaling duplicate values by {factor} until limit {max_limit}
phrase: scale repeated items by {factor} until reaching {max_limit}
test: list=2,2,3,3 factor=2 max_limit=10
expect: => i=3 r=0.0 ok=true s="scaled duplicate iterations: 3" errors=0 n=4 res=[8,2,6,3] cache=0 hits=0
test: list=5,5,1,2 factor=3 max_limit=20
expect: => i=1 r=0.0 ok=true s="scaled duplicate iterations: 1" errors=0 n=4 res=[15,5,1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	let lim = ${max_limit};
	var scaled = 0;
	var i = 0;
	while i < g.n {
		var is_dup = false;
		var j = 0;
		while j < g.n {
			if i != j && g.res[i] == g.res[j] { is_dup = true; break; }
			j++;
		}
		if is_dup {
			var cur = g.res[i];
			while cur * f <= lim {
				cur *= f;
				scaled++;
			}
			g.res[i] = cur;
		}
		i++;
	}
	g.steps += g.n + scaled;
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled duplicate iterations: ", scaled);
	out
}
@end
