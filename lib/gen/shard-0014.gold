code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	if g.n == 0 {
		gold_fail(g, "cannot rotate empty tally");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty tally");
		return out;
	}
	var temp int[512] = [0; 512];
	let shift = (off % g.n + g.n) % g.n;
	for i in g.n {
		let target = (i + shift) % g.n;
		temp[target] = g.res[i];
	}
	for i in g.n { g.res[i] = temp[i]; }
	g.steps += g.n;
	out.i = shift;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated tally by ", shift);
	out
}
@end
