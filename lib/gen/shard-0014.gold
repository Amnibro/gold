noun: window
modifier: in_reverse
context: cache
phrase: reverse cache window of size {win_size} backwards
phrase: invert cache window of span {win_size} in reverse
slot: win_size int
test: list=1,2,3,4,5,6 win_size=3
expect: => i=3 r=0.0 ok=true s="reversed cache window: 3" errors=0 n=6 res=[1,2,3,6,5,4] cache=6 hits=0
test: list=10,20,30,40 win_size=2
expect: => i=2 r=0.0 ok=true s="reversed cache window: 2" errors=0 n=4 res=[10,20,40,30] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	let w = ${win_size};
	if w > 1 && w <= g.cn {
		var left = g.cn - w;
		var right = g.cn - 1;
		while left < right {
			let tk = g.ck[left];
			let tv = g.cv[left];
			g.ck[left] = g.ck[right];
			g.cv[left] = g.cv[right];
			g.ck[right] = tk;
			g.cv[right] = tv;
			left++;
			right--;
		}
	}
	for i in g.cn {
		g.res[i] = g.cv[i];
	}
	g.n = g.cn;
	out.i = w;
	out.s.clear();
	format(out.s, "reversed cache window: ", w);
	out
}
@end
