@entry 80bee012391d4bd8
kind: step
verb: scale
noun: duplicates
modifier: with_retry
context: cache
phrase: scale duplicate cache counts by factor {factor} with retry
phrase: multiply repeated cache frequencies by {factor} with retry
slot: factor int
test: list=4,4,8,4 factor=2
expect: => i=1 r=0.0 ok=true s="scaled duplicate frequencies: 1" errors=0 n=4 res=[4,4,8,4] cache=2 hits=2
test: list=10,10,20,20 factor=3
expect: => i=2 r=0.0 ok=true s="scaled duplicate frequencies: 2" errors=0 n=4 res=[10,10,20,20] cache=2 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		let x = g.res[k];
		let cur, ok = gold_cache_get(g, x);
		if ok {
			gold_cache_put(g, x, cur + 1);
		} else {
			gold_cache_put(g, x, 1);
		}
	}
	let f = ${factor};
	var scaled = 0;
	for i in g.cn {
		if g.cv[i] > 1 {
			g.cv[i] = g.cv[i] * f;
			scaled++;
		}
	}
	out.i = scaled;
	out.s.clear();
	format(out.s, "scaled duplicate frequencies: ", scaled);
	out
}
@end
