@entry ab6049a77f4dfa6b
kind: step
verb: split
noun: primes
modifier: every_other
context: loop
phrase: split alternate primes every other step
phrase: partition every other prime across loop iterations
test: list=2,3,5,7,11,13
expect: => i=3 r=0.0 ok=true s="split every other prime count 3" errors=0 n=3 res=[2,5,11] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=false s="no primes found" errors=1 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var primes = [0; 512];
	var pn = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= 2 {
			var is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
			if is_p {
				primes[pn] = x;
				pn++;
			}
		}
		i++;
	}
	if pn == 0 {
		gold_fail(g, "no primes found");
		out.ok = false;
		out.s.clear();
		format(out.s, "no primes found");
		return out;
	}
	var new_res = [0; 512];
	var new_n = 0;
	var k = 0;
	while k < pn {
		if k % 2 == 0 {
			new_res[new_n] = primes[k];
			new_n++;
		}
		k++;
	}
	for idx in new_n {
		g.res[idx] = new_res[idx];
	}
	g.n = new_n;
	g.steps += pn;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "split every other prime count ", new_n);
	out
}
@end
