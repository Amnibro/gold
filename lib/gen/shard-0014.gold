expect: => i=4 r=0.0 ok=true s="suffix length: 4" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var start_idx = 0;
	var i = g.n;
	while i > 0 {
		i--;
		if ${stop}(g.res[i]) {
			start_idx = i;
			break;
		}
	}
	let count = g.n - start_idx;
	for j in count {
		g.res[j] = g.res[start_idx + j];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "suffix length: ", count);
	out
}
@end
