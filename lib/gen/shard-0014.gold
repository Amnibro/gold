noun: threshold
modifier: first
context: search
phrase: retry search until first element meets threshold {threshold}
phrase: drop elements before first hit exceeding {threshold}
slot: threshold int
test: list=5,8,15,20,3 threshold=10
expect: => i=3 r=0.0 ok=true s="items after threshold: 3" errors=0 n=3 res=[15,20,3] cache=0 hits=0
test: list=1,2,30 threshold=25
expect: => i=1 r=0.0 ok=true s="items after threshold: 1" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let th = ${threshold};
	var first_idx = -1;
	for i in g.n {
		if g.res[i] >= th {
			first_idx = i;
			break;
		}
	}
	if first_idx >= 0 {
		var kept = 0;
		var j = first_idx;
		while j < g.n {
			g.res[kept] = g.res[j];
			kept++;
			j++;
		}
		g.n = kept;
	} else {
		g.n = 0;
	}
	g.steps += g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "items after threshold: ", g.n);
	out
}
@end
