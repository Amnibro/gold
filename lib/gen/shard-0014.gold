			break;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if !any_neg {
		out.i = g.n;
		out.ok = true;
		format(out.s, "none are negative count ", g.n);
	} else {
		gold_fail(g, "negative item found");
		out.i = 0;
		out.ok = false;
		format(out.s, "negative item found");
	}
	out
}
@end
@entry ae4e7b278f851ca4
kind: step
verb: compare
noun: middle
modifier: until
context: compare
phrase: compare middle elements until difference exceeds {margin}
phrase: inspect middle outward until margin {margin} breached
slot: margin int
test: list=1,2,3,4,5 margin=5
expect: => i=3 r=0.0 ok=true s="middle comparison within margin 5" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=1,20,3,40,5 margin=5
expect: => i=0 r=0.0 ok=false s="margin breached" errors=1 n=5 res=[1,20,3,40,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let margin = ${margin};
	if g.n < 3 {
		gold_fail(g, "need at least three items");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: need at least three items");
		return out;
	}
	let mid = g.n / 2;
	let mid_val = g.res[mid];
	var ok_margin = true;
	for k in g.n {
		var diff = g.res[k] - mid_val;
		if diff < 0 {
			diff = -diff;
		}
		if diff > margin {
			ok_margin = false;
			break;
		}
	}
	g.steps += g.n;
	out.s.clear();
	if ok_margin {
		out.i = mid_val;
		out.ok = true;
		format(out.s, "middle comparison within margin ", margin);
	} else {
		gold_fail(g, "margin breached");
		out.i = 0;
		out.ok = false;
		format(out.s, "margin breached");
	}
	out
}
@end
