code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n > 2 {
		var write = 1;
		for i in 1..g.n - 1 {
			let x = g.res[i];
			var seen = false;
			for j in 1..write {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[write] = x;
				write++;
			}
		}
		g.res[write] = g.res[g.n - 1];
		write++;
		g.n = write;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
