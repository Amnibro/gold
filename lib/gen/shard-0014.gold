code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_len};
	if g.n == 0 || tgt <= g.n {
		out.i = g.n;
		return out;
	}
	let orig = g.n;
	var i = 0;
	while g.n < tgt && g.n < 256 {
		gold_push(g, g.res[i % orig]);
