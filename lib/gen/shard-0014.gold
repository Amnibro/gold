phrase: position {n} ringed megalith boulders radius {r}
slot: n int
slot: r real
test: n=4 r=6.0
expect: => i=4 r=0.0 ok=true s="ringed stone circle" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: megalith1 sphere 6,0,0.8 r0.8 nz.04:.2 m:matte #7d7d82
expect: => doc: megalith2 sphere 0,6,0.8 r0.8 nz.04:.2 m:matte #7d7d82
expect: => doc: megalith3 sphere -6,0.001,0.8 r0.8 nz.04:.2 m:matte #7d7d82
expect: => doc: megalith4 sphere -0.001,-6,0.8 r0.8 nz.04:.2 m:matte #7d7d82
test: n=3 r=4.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=5 r=0.0 ok=true s="ringed stone circle" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: megalith3 sphere 4,0,0.8 r0.8 nz.04:.2 m:matte #7d7d82
expect: => doc: megalith4 sphere -2,3.464,0.8 r0.8 nz.04:.2 m:matte #7d7d82
expect: => doc: megalith5 sphere -2,-3.464,0.8 r0.8 nz.04:.2 m:matte #7d7d82
test: n=0 r=6.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 || ${r} <= 0.0 { gold_fail(g, "invalid parameters"); out.ok = false; return out; }
	for q in ${n} {
		let frac = q as real * (6.283 / ${n} as real);
		let px = ${r} * cos(frac);
		let py = ${r} * sin(frac);
		o.clear();
		gold_dnews(g, "megalith", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",0.8 r");
		o.append("0.8 nz.");
		o.append("04:.");
		o.append("2 m:matte ");
		gold_hex(o, 125, 125, 130);
		gold_doc(g, o);
	}
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ringed stone circle");
	out
}
@end
