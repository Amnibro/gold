@entry b706709dc5c7c4e9
kind: step
verb: filter
noun: primes
modifier: with_cache
context: list
phrase: filter prime numbers storing results in cache
phrase: keep prime elements caching each validated number
test: list=2,3,4,5,6,7,8
expect: => i=4 r=0.0 ok=true s="cached primes: 4" errors=0 n=4 res=[2,3,5,7] cache=4 hits=0
test: list=10,11,12,13,14,15
expect: => i=2 r=0.0 ok=true s="cached primes: 2" errors=0 n=2 res=[11,13] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var is_p = true;
		if x < 2 {
			is_p = false;
		} else {
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			gold_cache_put(g, x, 1);
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "cached primes: ", write);
	out
}
@end
