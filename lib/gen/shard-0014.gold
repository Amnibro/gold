test: list=5,5,5,1
expect: => i=2 r=0.0 ok=true s="cached duplicates: 2" errors=0 n=4 res=[1,5,5,5] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var dupes = 0;
	var k = 0;
	while k < g.n {
		var run = 1;
		while k + run < g.n && g.res[k + run] == g.res[k] {
			run++;
		}
		if run > 1 {
			dupes += run - 1;
			gold_cache_put(g, g.res[k], run);
		}
		k += run;
	}
	out.i = dupes;
	out.s.clear();
	format(out.s, "cached duplicates: ", dupes);
	out
}
@end
