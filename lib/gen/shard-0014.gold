expect: => i=3 r=0.0 ok=true s="flooded trees around center" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: tree3 cone 2.006,0.923,.5 2.006,0.923,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree4 cone 1.933,1.803,.5 1.933,1.803,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree5 cone -0.099,1.016,.5 -0.099,1.016,3 r.8 nz.05:.3 m:matte #2f5f3a
test: n=0 r=8.0 u=5
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 24 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let dist = ${r} * (0.3 + gold_hash01(q, 2, ${u}) * 0.7);
		let px = dist * (gold_hash01(q, 3, ${u}) * 2.0 - 1.0);
		let py = dist * (gold_hash01(q, 4, ${u}) * 2.0 - 1.0);
		o.clear();
		gold_dnews(g, "tree", "", o);
		o.append(" cone ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("5");
		o.append(" ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		o.append("3");
		o.append(" r.");
		o.append("8");
		o.append(" nz.");
		o.append("05");
		o.append(":.");
		o.append("3");
		o.append(" m:matte ");
		gold_hex(o, 47, 95, 58);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "flooded trees around center");
	out
}
@end
