@entry 4f2275dc1a25b98b
kind: step
verb: sort
noun: threshold
modifier: safely
context: search
slot: threshold int
phrase: search sort threshold safely cutoff {threshold}
phrase: partition query results safely threshold {threshold}
test: list=10,50,20,80,5 threshold=20
expect: => i=3 r=0.0 ok=true s="sorted 3 items above threshold" errors=0 n=5 res=[20,50,80,10,5] cache=0 hits=0
test: list=1,2,3 threshold=20
expect: => i=0 r=0.0 ok=true s="sorted 0 items above threshold" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let t = ${threshold};
	var high int[512] = [0; 512];
	var low int[512] = [0; 512];
	var hn = 0;
	var ln = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= t {
			high[hn] = x;
			hn++;
		} else {
			low[ln] = x;
			ln++;
		}
	}
	var i = 0;
	while i < hn {
		var j = i + 1;
		while j < hn {
			if high[i] > high[j] {
				let tmp = high[i];
				high[i] = high[j];
				high[j] = tmp;
			}
			j++;
		}
		i++;
	}
	for k in hn { g.res[k] = high[k]; }
	for k in ln { g.res[hn + k] = low[k]; }
	g.steps += g.n + hn * hn + 1;
	out.i = hn;
	out.s.clear();
	format(out.s, "sorted ", hn, " items above threshold");
	out
}
@end
