@entry dcdd7045c585a1fb
kind: step
verb: keep
noun: average
modifier: sorted
context: cache
phrase: keep sorted results exceeding cache average
phrase: retain sorted values at least cache average
test: list=10,20,30,40
expect: => i=2 r=0.0 ok=true s="retained above cache average: 2" errors=0 n=2 res=[30,40] cache=4 hits=0
test: list=5,15,25,35,45
expect: => i=3 r=0.0 ok=true s="retained above cache average: 3" errors=0 n=3 res=[25,35,45] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var sum = 0;
	for i in g.cn {
		sum += g.cv[i];
	}
	let avg = if g.cn > 0 { sum / g.cn } else { 0 };
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var write = 0;
	for k in g.n {
		if g.res[k] >= avg {
			g.res[write] = g.res[k];
			write++;
		}
	}
	g.n = write;
	out.i = write;
	out.s.clear();
	format(out.s, "retained above cache average: ", write);
	out
}
@end
