fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${limit};
	var count = 0;
	while count < g.n && g.res[count] <= limit {
		count++;
	}
	if count == 0 {
		gold_fail(g, "streak starts above limit");
		out.ok = false;
		return out;
	}
	g.n = count;
	g.steps += count;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "streak of size ", count);
	out
}
@end
