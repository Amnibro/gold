expect: => i=6 r=0.0 ok=true s="repeated numbers added: 6" errors=0 n=8 res=[7,8,7,8,7,8,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let times = ${reps};
	let max_r = ${max_retry};
	let orig_n = g.n;
	var added = 0;
	for t in times {
		for i in orig_n {
			if g.n < 512 {
				gold_push(g, g.res[i]);
				added++;
			}
		}
	}
	var r = 0;
	while added == 0 && r < max_r {
		r++;
		g.steps += r;
	}
	out.i = added;
	out.s.clear();
	format(out.s, "repeated numbers added: ", added);
	out
}
@end
