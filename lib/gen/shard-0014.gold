fn ${ID}(n int) int {
	var lo = ${floor};
	var hi = ${ceiling};
	if lo > hi {
		let tmp = lo;
		lo = hi;
		hi = tmp;
	}
	if n < lo { return lo; }
	if n > hi { return hi; }
	n
}
