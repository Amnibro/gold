slot: max_retry int
test: list=5,10,15,20 cutoff=12 max_retry=2
expect: => i=2 r=0.0 ok=true s="search index: 2" errors=0 n=4 res=[5,10,15,20] cache=0 hits=0
test: list=2,4,6,8 cutoff=50 max_retry=3
expect: => i=-1 r=0.0 ok=false s="search index: -1" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var thresh = ${cutoff};
	let retries = ${max_retry};
	var found_idx = -1;
	var r = 0;
	while r <= retries && found_idx < 0 {
		for i in g.n {
			if g.res[i] > thresh {
				found_idx = i;
				break;
			}
		}
		if found_idx < 0 {
			thresh -= 10;
			r++;
		}
	}
	out.ok = found_idx >= 0;
	out.i = found_idx;
	out.s.clear();
	format(out.s, "search index: ", found_idx);
	out
}
@end
