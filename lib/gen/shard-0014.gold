@entry 62f6ede5dca6fbc8
kind: step
verb: return
noun: pairs
modifier: unique
context: error
phrase: return pairs unique difference values aborting duplicates
phrase: collect unique adjacent pair deltas flagging collisions
test: list=1,3,7,12
expect: => i=3 r=0.0 ok=true s="unique pair deltas count: 3" errors=0 n=4 res=[1,3,7,12] cache=0 hits=0
test: list=1,3,5,9
expect: => i=0 r=0.0 ok=false s="error: duplicate pair difference detected" errors=1 n=4 res=[1,3,5,9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		gold_fail(g, "insufficient elements for pairs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: insufficient elements for pairs");
		return out;
	}
	var deltas_n = 0;
	var deltas = [0; 64];
	var has_dup = false;
	var i = 0;
	while i + 1 < g.n && deltas_n < 64 {
		let diff = g.res[i + 1] - g.res[i];
		for j in deltas_n {
			if deltas[j] == diff { has_dup = true; break; }
		}
		if has_dup { break; }
		deltas[deltas_n] = diff;
		deltas_n++;
		i++;
	}
	if has_dup {
		gold_fail(g, "duplicate pair difference detected");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: duplicate pair difference detected");
		return out;
	}
	g.steps += deltas_n * deltas_n;
	out.i = deltas_n;
	out.s.clear();
	format(out.s, "unique pair deltas count: ", deltas_n);
	out
}
@end
