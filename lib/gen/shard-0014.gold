test: list=4,6 bias=0
expect: => i=2 r=0.0 ok=true s="shifted 2 items by average bias" errors=0 n=2 res=[-1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bias};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	if g.n > 0 {
		var sum = 0;
		for k in g.n { sum += g.res[k]; }
		let avg = sum / g.n;
		for k in g.n {
			g.res[k] = (g.res[k] - avg) + b;
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = g.n;
	out.s.clear();
	format(out.s, "shifted ", g.n, " items by average bias");
	out
}
@end
