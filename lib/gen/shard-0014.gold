code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient search items for pairwise");
		return out;
	}
	var kept = 0;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] == g.res[i + 1] {
			g.res[kept] = g.res[i + 1];
			kept++;
		}
		i++;
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "pairwise suffix matches kept: ", kept);
	out
}
@end
