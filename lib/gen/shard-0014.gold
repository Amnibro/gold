code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let passes = ${times};
	var count = 0;
	for step in passes {
		for i in out.s.len {
			let c = out.s[i];
			if c == 'a' { out.s[i] = 'e'; count++; }
			else if c == 'e' { out.s[i] = 'i'; count++; }
			else if c == 'i' { out.s[i] = 'o'; count++; }
			else if c == 'o' { out.s[i] = 'u'; count++; }
			else if c == 'u' { out.s[i] = 'a'; count++; }
		}
	}
	out.i = count;
	out
}
@end
