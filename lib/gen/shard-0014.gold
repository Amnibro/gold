kind: step
verb: dedupe
noun: total
modifier: with_cache
context: error
slot: max_distinct int
phrase: dedupe total results with cache limit {max_distinct}
phrase: compact total distinct entries with cache threshold {max_distinct}
test: list=1,1,2,2,3 max_distinct=5
expect: => i=3 r=0.0 ok=true s="deduped total within limit: 3" errors=0 n=3 res=[1,2,3] cache=3 hits=2
test: list=1,2,3,4 max_distinct=2
expect: => i=0 r=0.0 ok=false s="error: distinct total exceeds limit" errors=1 n=4 res=[1,2,3,4] cache=4 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_distinct};
	var new_n = 0;
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		let _, found = gold_cache_get(g, x);
		if !found {
			gold_cache_put(g, x, 1);
			g.res[new_n] = x;
			new_n++;
			distinct++;
		}
	}
	if distinct > md {
		gold_fail(g, "distinct total exceeds limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: distinct total exceeds limit");
		return out;
	}
	g.n = new_n;
	g.steps += g.n + distinct;
	out.i = distinct;
	out.s.clear();
