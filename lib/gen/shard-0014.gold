kind: step
verb: sum
noun: histogram
modifier: with_cache
context: format
phrase: format histogram frequency summary with cache
phrase: render frequency counts with cache accumulation
test: list=1,2,2,3,3,3
expect: => i=3 r=0.0 ok=true s="hist:[1x1, 2x2, 3x3]" errors=0 n=6 res=[1,2,2,3,3,3] cache=3 hits=0
test: list=5,5,8,8,8,8
expect: => i=2 r=0.0 ok=true s="hist:[5x2, 8x4]" errors=0 n=6 res=[5,5,8,8,8,8] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	out.s.clear();
	out.s.append("hist:[");
	var distinct = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			var freq = 0;
			for k in g.n {
				if g.res[k] == x { freq++; }
			}
			gold_cache_put(g, distinct, freq);
			if distinct > 0 { out.s.append(", "); }
			format(out.s, x, "x", freq);
			distinct++;
		}
	}
	out.s.push(']');
	out.i = distinct;
	g.steps += g.n + 1;
	out
}
@end
