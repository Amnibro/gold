context: math
phrase: bucket results into bins of size {bin_width}
phrase: group items into histogram using width {bin_width}
slot: bin_width int
test: list=2,5,12,18,22 bin_width=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[0,0,1,1,2] cache=0 hits=0
test: list=15,25 bin_width=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${bin_width};
	var max_bin = 0;
	if w > 0 {
		for i in g.n {
			let b = g.res[i] / w;
			g.res[i] = b;
			if b > max_bin {
				max_bin = b;
			}
		}
	}
	out.i = max_bin + 1;
	g.steps += g.n + 1;
	out
}
@end
