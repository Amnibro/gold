expect: => i=0 r=0.0 ok=true s="filled 0 items up to bound" errors=0 n=1 res=[10] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bound};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var filled = 0;
	if g.n > 0 {
		var cur = g.res[0];
		while cur < b && g.n < 512 {
			cur++;
			var found = false;
			for k in g.n {
				if g.res[k] == cur { found = true; break; }
			}
			if !found {
				gold_push(g, cur);
				filled++;
			}
		}
	}
	g.steps += g.n * g.n + 1;
	out.i = filled;
	out.s.clear();
	format(out.s, "filled ", filled, " items up to bound");
	out
}
@end
