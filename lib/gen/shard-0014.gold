code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n >= 3 {
		let mid = g.n / 2;
		let last = g.n - 1;
		g.res[mid] = ${f}(g.res[mid]);
		g.res[last] = ${f}(g.res[last]);
	}
	out.i = g.n;
	g.steps += 3;
	out
}
@end
