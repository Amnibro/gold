fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	var sum = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[write] = x;
			write++;
			sum += x;
		}
	}
	g.n = write;
	out.i = sum;
	g.steps += write + 1;
	out
}
@end
