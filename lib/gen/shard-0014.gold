@entry b76c04a8dc04f151
kind: step
verb: reverse
noun: window
modifier: unique
context: loop
slot: win_size int
phrase: reverse unique elements within sliding window {win_size}
phrase: loop reversing window {win_size} of unique values
slot: win_size int
test: list=1,2,2,3,4,5 win_size=3
expect: => i=1 r=0.0 ok=true s="reversed unique windows: 1" errors=0 n=6 res=[1,2,2,5,4,3] cache=0 hits=0
test: list=10,20,30,40,40,50 win_size=4
expect: => i=1 r=0.0 ok=true s="reversed unique windows: 1" errors=0 n=6 res=[40,30,20,10,40,50] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var rev_count = 0;
	if ws > 1 && g.n >= ws {
		var left = 0;
		while left + ws <= g.n {
			var is_uniq = true;
			var i = 0;
			while i < ws {
				var j = i + 1;
				while j < ws {
					if g.res[left + i] == g.res[left + j] { is_uniq = false; break; }
					j++;
				}
				if !is_uniq { break; }
				i++;
			}
			if is_uniq {
				var p = 0;
				while p < ws / 2 {
					let tmp = g.res[left + p];
					g.res[left + p] = g.res[left + ws - 1 - p];
					g.res[left + ws - 1 - p] = tmp;
					p++;
				}
				rev_count++;
			}
			left += ws;
		}
	}
	g.steps += g.n;
	out.i = rev_count;
	out.s.clear();
	format(out.s, "reversed unique windows: ", rev_count);
	out
}
@end
