			g.img[y * g.iw + x] = gold_vnoise(x, y, 2, g.iw / 2, ${u});
		}
	}
	for k in g.iw * g.ih { if g.img[k] >= 0.4 { g.img[k] = 1.0; } else { g.img[k] = 0.0; } }
	for k in g.iw * g.ih { g.img[k] = 1.0 - g.img[k]; }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "sand");
	out
}
@end
