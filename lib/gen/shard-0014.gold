	let w = ${window_size};
	let off = ${offset};
	var write = 0;
	if off < g.n {
		var i = off;
		while i < g.n && write < w {
			g.res[write] = g.res[i];
			write++;
			i++;
		}
		g.n = write;
	} else {
		g.n = 0;
	}
	out.i = write;
	g.steps += write + 1;
	out
}
