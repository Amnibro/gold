	var x = if n < 0 { -n } else { n };
	var rev = 0;
	while x > 0 {
		rev = rev * 10 + (x % 10);
		x /= 10;
	}
	var w = 1;
	var sum = 0;
	while rev > 0 {
		sum += (rev % 10) * w;
		w++;
		rev /= 10;
	}
	sum
}
