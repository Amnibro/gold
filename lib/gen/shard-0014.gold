		i++;
	}
	var temp int[512] = [0; 512];
	var count = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if ${pred_cond}(g.res[idx]) {
			temp[count] = g.res[idx];
			count++;
		}
		idx--;
	}
	for k in count {
		g.res[k] = temp[k];
	}
	g.n = count;
	out.i = count;
	out.s.clear();
	format(out.s, "reverse selected count: ", count);
	out
}
