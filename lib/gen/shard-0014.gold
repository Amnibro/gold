			if out.s[j] == out.s[i] {
				found = true;
				dup_code = out.s[i] as int;
				break;
			}
			j++;
		}
		if found { break; }
		i--;
	}
	g.steps += n + 1;
	out.ok = found;
	out.i = dup_code;
	out
}
