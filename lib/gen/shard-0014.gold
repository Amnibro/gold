@entry 8bb508f5e90be421
kind: step
verb: retry
noun: gaps
modifier: sorted
context: cache
phrase: calculate sorted cache gaps with retry verification
phrase: check adjacent gaps across sorted cache values with retry
test: list=15,3,9,20
expect: => i=17 r=0.0 ok=true s="sorted cache gap total: 17" errors=0 n=4 res=[15,3,9,20] cache=4 hits=0
test: list=2,10,4
expect: => i=8 r=0.0 ok=true s="sorted cache gap total: 8" errors=0 n=3 res=[2,10,4] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, k, g.res[k]);
	}
	var i = 0;
	while i < g.cn {
		var j = i + 1;
		while j < g.cn {
			if g.cv[i] > g.cv[j] {
				let tmp = g.cv[i];
				g.cv[i] = g.cv[j];
				g.cv[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var total_gap = 0;
	var idx = 0;
	while idx + 1 < g.cn {
		total_gap += g.cv[idx + 1] - g.cv[idx];
		idx++;
	}
	out.i = total_gap;
	out.s.clear();
	format(out.s, "sorted cache gap total: ", total_gap);
	out
}
@end
