fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let r = ${rounds};
	for round in r {
		var write = 0;
		for i in g.n {
			if ${p}(g.res[i]) {
				g.res[write] = g.res[i];
				write++;
			}
		}
		g.n = write;
	}
	out.i = g.n;
	g.steps += r + 1;
	out
}
@end
