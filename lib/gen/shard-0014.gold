fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	var paired = 0;
	var i = 0;
	while i + 1 < g.n {
		let s = g.res[i] + g.res[i + 1];
		if s > ms { break; }
		paired++;
		i += 2;
	}
	g.steps += i + 1;
	out.i = paired;
	out.s.clear();
	format(out.s, "consecutive pairs bounded: ", paired);
	out
}
@end
@entry d29c98c595d08e61
kind: step
verb: reverse
noun: primes
modifier: in_reverse
context: loop
phrase: loop reversing prime numbers backward through results
phrase: reverse primes backward in sequence loop
test: list=2,3,4,5,6,7
expect: => i=4 r=0.0 ok=true s="primes reversed in place: 4" errors=0 n=6 res=[7,5,4,3,6,2] cache=0 hits=0
test: list=11,12,13,14,15,17
expect: => i=3 r=0.0 ok=true s="primes reversed in place: 3" errors=0 n=6 res=[17,12,13,14,15,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var p_indices int[512] = [0; 512];
	var pc = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			p_indices[pc] = i;
			pc++;
		}
		i++;
	}
	var left = 0;
	var right = pc - 1;
	while left < right {
		let idx_l = p_indices[left];
		let idx_r = p_indices[right];
		let tmp = g.res[idx_l];
		g.res[idx_l] = g.res[idx_r];
		g.res[idx_r] = tmp;
		left++;
		right--;
	}
	g.steps += g.n + pc;
	out.i = pc;
	out.s.clear();
	format(out.s, "primes reversed in place: ", pc);
	out
}
@end
