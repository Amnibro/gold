	format(out.s, "step: ", prev, " + ", sv, " -> ", g.steps);
	out.i = g.steps;
	out
}
@end
@entry a61da26bde67b62d
kind: step
verb: limit
noun: duplicates
modifier: up_to
context: format
phrase: format items limiting duplicates up to {max_dups}
phrase: render sequence capping duplicate occurrences at {max_dups}
slot: max_dups int
test: list=1,1,1,2,2,3 max_dups=2
expect: => i=5 r=0.0 ok=true s="capped:[1,1,2,2,3]" errors=0 n=6 res=[1,1,1,2,2,3] cache=0 hits=0
test: list=5,5,5,5,8 max_dups=1
expect: => i=2 r=0.0 ok=true s="capped:[5,8]" errors=0 n=5 res=[5,5,5,5,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_dups};
	out.s.clear();
	out.s.append("capped:[");
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen_before = 0;
		for j in i {
			if g.res[j] == x { seen_before++; }
		}
		if seen_before < md {
			if kept > 0 { out.s.push(','); }
			format(out.s, x);
			kept++;
		}
	}
	out.s.push(']');
	out.i = kept;
	g.steps += g.n + 1;
	out
}
@end
