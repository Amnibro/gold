@entry c9b49c3bb6e67b9f
kind: step
verb: check
noun: text
modifier: running
context: compare
slot: max_diff int
phrase: compare running text characters checking step transitions within {max_diff}
phrase: check text continuity ensuring running difference stays under {max_diff}
test: text="abcde" max_diff=2
expect: => i=1 r=0.0 ok=true s="abcde" errors=0 n=0 res=[] cache=0 hits=0
test: text="aceg" max_diff=1
expect: => i=2 r=0.0 ok=false s="aceg" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	var compliant = true;
	var max_seen = 0;
	if out.s.len >= 2 {
		var i = 0;
		while i + 1 < out.s.len {
			let d = if out.s[i + 1] >= out.s[i] {
				out.s[i + 1] - out.s[i]
			} else {
				out.s[i] - out.s[i + 1]
			};
			if d as int > max_seen { max_seen = d as int; }
			if d as int > md {
				compliant = false;
				break;
			}
			i++;
		}
	}
	g.steps += out.s.len;
	out.ok = compliant;
	out.i = max_seen;
	out
}
@end
