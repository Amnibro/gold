code:
fn ${ID}_check(val int) bool {
	return val >= 0;
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errors = 0;
	var successes = 0;
	var idx = g.n - 1;
	while idx >= 0 {
		if !${ID}_check(g.res[idx]) {
			gold_fail(g, "subfunction failed in reverse traversal");
			errors++;
		} else {
			successes++;
		}
		idx--;
	}
	out.i = successes;
	out.ok = errors == 0;
	out.s.clear();
	format(out.s, "reverse subfunction successes: ", successes);
	out
}
@end
