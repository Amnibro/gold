fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	let lim = if k < g.n { k } else { g.n };
	for i in lim {
		for j in (i + 1)..lim {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
		}
	}
	out.i = lim;
	out.s.clear();
	format(out.s, "grouped prefix in place: ", lim);
	out
}
@end
