@entry 423f9f26adebc4cb
kind: step
verb: apply
noun: spaces
modifier: until
context: compare
phrase: apply zero spaces until reaching target length {target_len}
phrase: pad buffer with spaces until size {target_len}
slot: target_len int
test: list=10,20 target_len=4
expect: => i=4 r=0.0 ok=true s="applied zero spaces until length 4" errors=0 n=4 res=[10,20,0,0] cache=0 hits=0
test: list=10,20 target_len=1
expect: => i=2 r=0.0 ok=true s="buffer already at target length" errors=0 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target_len = ${target_len};
	if target_len <= g.n {
		out.i = g.n;
		out.ok = true;
		out.s.clear();
		format(out.s, "buffer already at target length");
		return out;
	}
	if target_len > 512 {
		gold_fail(g, "target length exceeds capacity");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: target exceeds capacity");
		return out;
	}
	let orig_n = g.n;
	var i = orig_n;
	while i < target_len {
		gold_push(g, 0);
		i++;
	}
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied zero spaces until length ", g.n);
	out
}
@end
@entry f5706b18ba3aafe9
kind: step
verb: split
noun: item
modifier: safely
context: compare
phrase: split item safely at index {idx} in two parts
phrase: divide item safely at position {idx}
slot: idx int
test: list=10,20,30,40 idx=2
expect: => i=30 r=0.0 ok=true s="split item safely into 15 and 15" errors=0 n=5 res=[10,20,15,15,40] cache=0 hits=0
test: list=10,20 idx=5
expect: => i=0 r=0.0 ok=false s="error: invalid index" errors=1 n=2 res=[10,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let idx = ${idx};
	if idx < 0 || idx >= g.n || g.n >= 511 {
		gold_fail(g, "invalid index");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid index");
		return out;
	}
	let val = g.res[idx];
	let half1 = val / 2;
	let half2 = val - half1;
	g.res[idx] = half1;
	var k = g.n;
	while k > idx + 1 {
		g.res[k] = g.res[k - 1];
		k--;
	}
	g.res[idx + 1] = half2;
	g.n++;
	g.steps++;
	out.i = val;
	out.ok = true;
	out.s.clear();
	format(out.s, "split item safely into ", half1, " and ", half2);
	out
}
@end
