	let req = ${w};
	let limit = if req < g.n { if req > 0 { req } else { 0 } } else { g.n };
	var i = 0;
	while i < limit {
		var j = i + 1;
		while j < limit {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	g.steps += limit;
	out.i = limit;
	out.s.clear();
	format(out.s, "sorted window in place: ", limit);
