code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_sum};
	var running = 0;
	var write = 0;
	for i in out.s.len {
		let b = out.s[i] as int;
		if running + b <= lim {
			running += b;
			out.s[write] = out.s[i];
			write++;
		} else {
			break;
		}
	}
	out.s.resize(write, ' ');
	out.i = write;
	out
}
@end
