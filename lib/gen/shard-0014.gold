@entry 58f2b0958aad857e
kind: step
verb: rotate
noun: tail
modifier: first
context: filter
slot: k int
phrase: rotate tail elements to first positions {k} under filter
phrase: filter sequence rotating tail {k} to first
test: list=10,20,30,40,50 k=2
expect: => i=2 r=0.0 ok=true s="rotated tail to first: 2" errors=0 n=5 res=[40,50,10,20,30] cache=0 hits=0
test: list=1,2,3,4,5,6 k=3
expect: => i=3 r=0.0 ok=true s="rotated tail to first: 3" errors=0 n=6 res=[4,5,6,1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	if g.n == 0 || count <= 0 {
		out.i = 0;
		out.s.clear();
		format(out.s, "rotated 0");
		return out;
	}
	let t_len = if count < g.n { count } else { g.n };
	let split = g.n - t_len;
	var temp int[512] = [0; 512];
	var j = 0;
	var i = split;
	while i < g.n {
		temp[j] = g.res[i];
		j++;
		i++;
	}
	i = 0;
	while i < split {
		temp[j] = g.res[i];
		j++;
		i++;
	}
	for idx in g.n {
		g.res[idx] = temp[idx];
	}
	g.steps += g.n * 2;
	out.i = t_len;
	out.s.clear();
	format(out.s, "rotated tail to first: ", t_len);
	out
}
@end
