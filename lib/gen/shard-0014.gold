	var has_a = 0;
	var has_e = 0;
	var has_i = 0;
	var has_o = 0;
	var has_u = 0;
	for k in v.s.len {
		let c = v.s[k];
		if c == 'a' { has_a = 1; }
		else if c == 'e' { has_e = 1; }
		else if c == 'i' { has_i = 1; }
		else if c == 'o' { has_o = 1; }
		else if c == 'u' { has_u = 1; }
	}
	let total_vowels = has_a + has_e + has_i + has_o + has_u;
	out.s.clear();
	format(out.s, "vowels: ", total_vowels, "/5");
	out.i = total_vowels;
	g.steps += v.s.len + 1;
	out
}
@end
@entry 8478c6700fe411a1
kind: step
verb: split
noun: list
modifier: safely
context: format
phrase: format split list safely with delimiter
phrase: render list split safely into chunks
slot: chunk_size int
test: list=1,2,3,4,5 chunk_size=2
expect: => i=3 r=0.0 ok=true s="(1,2)|(3,4)|(5)" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=10,20,30,40 chunk_size=3
expect: => i=2 r=0.0 ok=true s="(10,20,30)|(40)" errors=0 n=4 res=[10,20,30,40] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cs = ${chunk_size};
	out.s.clear();
	if cs <= 0 { return out; }
	var i = 0;
	var chunk_idx = 0;
	while i < g.n {
		if chunk_idx > 0 { out.s.push('|'); }
		out.s.push('(');
		var j = 0;
		while j < cs && i + j < g.n {
			if j > 0 { out.s.push(','); }
			format(out.s, g.res[i + j]);
			j++;
		}
		out.s.push(')');
		chunk_idx++;
		i += cs;
	}
	out.i = chunk_idx;
	g.steps += g.n + 1;
	out
}
@end
