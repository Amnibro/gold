code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var sum = 0;
	var uniq_count = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in i {
			if g.res[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			sum += ${sub}(x);
			uniq_count++;
		}
	}
	out.i = sum;
	gold_push(g, sum);
	out.s.clear();
	format(out.s, "folded unique sum: ", sum);
	out
}
@end
