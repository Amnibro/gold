@entry 68e2c8d035555f7f
kind: step
verb: drop
noun: vowels
modifier: at_least
context: stats
slot: min_count int
phrase: stats drop vowels at least count {min_count}
phrase: remove stats vowels meeting threshold {min_count}
test: text="aeiou" min_count=2
expect: => i=5 r=0.0 ok=true s="" errors=0 n=0 res=[] cache=0 hits=0
test: text="bcd" min_count=2
expect: => i=0 r=0.0 ok=true s="bcd" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_count};
	var vowels = 0;
	var i = 0;
	while i < v.s.len {
		let c = v.s[i];
		if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' {
			vowels++;
		}
		i++;
	}
	if vowels >= m {
		var new_s byte[..200] = "";
		i = 0;
		while i < v.s.len {
			let c = v.s[i];
			if !(c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
				new_s.push(c);
			}
			i++;
		}
		out.s = new_s;
	}
	out.i = vowels;
	g.steps += v.s.len + 1;
	out
}
@end
@entry 26465628819f7bc5
kind: step
verb: group
noun: memo
modifier: nested
context: stats
slot: bucket_size int
phrase: stats group memo nested partition {bucket_size}
phrase: cluster sample memo nested size {bucket_size}
test: list=2,4,6,8,10 bucket_size=2
expect: => i=3 r=0.0 ok=true s="grouped memo into 3 buckets" errors=0 n=3 res=[3,7,10] cache=3 hits=0
test: list=5,15 bucket_size=3
expect: => i=1 r=0.0 ok=true s="grouped memo into 1 buckets" errors=0 n=1 res=[10] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let b = ${bucket_size};
	if b <= 0 || g.n == 0 { return out; }
	var new_n = 0;
	var i = 0;
	while i < g.n {
		var sum = 0;
		var cnt = 0;
		var j = 0;
		while j < b && (i + j) < g.n {
			sum += g.res[i + j];
			cnt++;
			j++;
		}
		let avg = sum / cnt;
		g.res[new_n] = avg;
		gold_cache_put(g, new_n, avg);
		new_n++;
		i += b;
	}
	g.n = new_n;
	g.steps += i + 1;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped memo into ", new_n, " buckets");
	out
}
@end
