fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${max_total};
	var sum = 0;
	for i in g.n { sum += g.res[i]; }
	while g.n > 0 && sum > lim {
		sum -= g.res[g.n - 1];
		g.n--;
	}
	out.i = sum;
	g.steps += g.n + 1;
	out
}
