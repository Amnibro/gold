@entry d070dc46ee952e9d
kind: step
verb: check
noun: streak
modifier: until
context: search
phrase: check streak of matches until gap exceeds {max_gap}
phrase: verify consecutive match gaps remain below {max_gap}
slot: max_gap int
test: list=2,4,6,8 max_gap=3
expect: => i=3 r=0.0 ok=true s="streak check valid: true" errors=0 n=4 res=[2,4,6,8] cache=0 hits=0
test: list=10,12,20 max_gap=5
expect: => i=1 r=0.0 ok=false s="streak check valid: false" errors=0 n=3 res=[10,12,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var valid = true;
	var i = 0;
	while i + 1 < g.n {
		let gap = g.res[i + 1] - g.res[i];
		let abs_gap = if gap < 0 { -gap } else { gap };
		if abs_gap > mg {
			valid = false;
			break;
		}
		i++;
	}
	out.ok = valid;
	g.steps += i + 1;
	out.i = i;
	out.s.clear();
	format(out.s, "streak check valid: ", valid);
	out
}
@end
