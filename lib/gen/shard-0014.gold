@entry 6e8ce47b0c17b43a
kind: step
verb: dedupe
noun: counter
modifier: at_least
context: error
slot: min_count int
phrase: dedupe counter elements at least threshold {min_count}
phrase: purge counter duplicates appearing at least {min_count} times
test: list=1,2,2,3,3,3 min_count=2
expect: => i=3 r=0.0 ok=true s="deduped counter items count: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,7 min_count=5
expect: => i=1 r=0.0 ok=true s="deduped counter items count: 1" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mc = ${min_count};
	if mc <= 1 {
		gold_fail(g, "invalid dedupe threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: invalid dedupe threshold");
		return out;
	}
	var new_n = 0;
	var deduped = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		var seen_before = false;
		for j in i {
			if g.res[j] == x { seen_before = true; break; }
		}
		if seen_before {
			deduped++;
		} else {
			g.res[new_n] = x;
			new_n++;
		}
		i++;
	}
	g.n = new_n;
	g.steps += g.n + deduped;
	out.i = deduped;
	out.s.clear();
	format(out.s, "deduped counter items count: ", deduped);
	out
}
@end
@entry 0c48d7081e07f0c9
kind: step
verb: dedupe
noun: results
modifier: while
context: error
slot: ceiling int
phrase: dedupe results while elements stay under ceiling {ceiling}
phrase: remove duplicate results while bounded by {ceiling}
test: list=1,1,2,2,3,10 ceiling=5
expect: => i=3 r=0.0 ok=true s="deduped results while under ceiling: 3" errors=0 n=3 res=[1,2,3] cache=0 hits=0
test: list=5,5,6,6 ceiling=4
expect: => i=0 r=0.0 ok=false s="error: no elements under ceiling limit" errors=1 n=4 res=[5,5,6,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${ceiling};
	var new_n = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= c { break; }
		var seen = false;
		for j in new_n {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[new_n] = x;
			new_n++;
		}
		i++;
	}
	if new_n == 0 {
		gold_fail(g, "no elements under ceiling limit");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: no elements under ceiling limit");
		return out;
	}
	g.n = new_n;
	g.steps += g.n + i;
	out.i = new_n;
	out.s.clear();
	format(out.s, "deduped results while under ceiling: ", new_n);
	out
}
@end
