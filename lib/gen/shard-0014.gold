code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${gap};
	var found_idx = -1;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i + 1] - g.res[i] == target {
			found_idx = i;
			break;
		}
		i++;
	}
	g.steps += i + 1;
	if found_idx >= 0 {
		out.ok = true;
		out.i = found_idx;
		out.s.clear();
		format(out.s, "gap found at index: ", found_idx);
	} else {
		out.ok = false;
		out.i = -1;
		out.s.clear();
		format(out.s, "no matching gap");
	}
	out
}
@end
