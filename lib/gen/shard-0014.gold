expect: => i=3 r=0.0 ok=true s="scaled sorted squares count: 3" errors=0 n=3 res=[3,12,75] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let f = ${factor};
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		g.res[i] = sq * f;
	}
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let t = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = t;
			}
			j++;
		}
		i++;
	}
	g.steps += g.n * 2;
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled sorted squares count: ", g.n);
	out
}
@end
