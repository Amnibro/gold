code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = [0; 512];
	var evens = [0; 512];
	var on = 0;
	var en = 0;
	for k in g.n {
		let x = g.res[k];
		if x % 2 == 0 {
			evens[en] = x;
			en++;
		} else {
			odds[on] = x;
			on++;
		}
	}
	for i in on {
		g.res[i] = odds[i];
	}
	for j in en {
		g.res[on + j] = evens[j];
	}
	g.steps += g.n;
	out.i = en;
	out.ok = true;
	out.s.clear();
	if en > 0 {
		format(out.s, "shifted evens to last positions count=", en);
	} else {
		format(out.s, "no evens to shift to last positions");
	}
	out
}
@end
