kind: step
verb: validate
noun: runs
modifier: at_least
context: loop
phrase: validate runs at least minimum length {min_len}
phrase: ensure run lengths are at least {min_len}
slot: min_len int
test: list=1,1,1,2,2,2 min_len=2
expect: => i=6 r=0.0 ok=true s="all runs at least 2" errors=0 n=6 res=[1,1,1,2,2,2] cache=0 hits=0
test: list=1,2,3 min_len=2
expect: => i=0 r=0.0 ok=false s="error: run too short" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_len = ${min_len};
	if g.n == 0 {
		gold_fail(g, "empty list has no runs");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var cur_run = 1;
	for i in (g.n - 1) {
		if g.res[i + 1] == g.res[i] {
			cur_run++;
		} else {
			if cur_run < min_len {
				gold_fail(g, "run shorter than minimum");
				out.ok = false;
				out.s.clear();
				format(out.s, "error: run too short");
				return out;
			}
			cur_run = 1;
		}
	}
	if cur_run < min_len {
		gold_fail(g, "final run shorter than minimum");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: run too short");
		return out;
	}
	g.steps += g.n;
	out.i = g.n;
	out.ok = true;
	out.s.clear();
	format(out.s, "all runs at least ", min_len);
	out
}
@end
