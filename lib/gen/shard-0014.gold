code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let thresh = ${min_sum};
	var matched = 0;
	if out.s.len > 1 {
		for i in 0..(out.s.len - 1) {
			let pair_val = (out.s[i] as int) + (out.s[i + 1] as int);
			gold_cache_put(g, i, pair_val);
			if pair_val >= thresh {
				matched++;
			}
		}
	}
	out.i = matched;
	out.s.clear();
	format(out.s, "matched pairs: ", matched);
	out
}
@end
