			let c1 = v.s[i];
			let c2 = v.s[i + 1];
			let v1 = c1 == 'a' || c1 == 'e' || c1 == 'i' || c1 == 'o' || c1 == 'u';
			let v2 = c2 == 'a' || c2 == 'e' || c2 == 'i' || c2 == 'o' || c2 == 'u';
			if v1 && v2 {
				count++;
			}
		}
	}
	gold_clear(g);
	gold_push(g, count);
	out.i = count;
	out.s.clear();
	format(out.s, "vowel pairs counted: ", count);
