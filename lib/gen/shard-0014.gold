@entry dcfa7ec5a34f8279
kind: step
verb: fold
noun: runs
modifier: any
context: list
phrase: fold consecutive runs of any length exceeding {min_len}
phrase: sum adjacent runs of identical items over {min_len}
slot: min_len int
test: list=2,2,2,5,6,6,6 min_len=2
expect: => i=24 r=0.0 ok=true s="folded runs sum: 24" errors=0 n=8 res=[2,2,2,5,6,6,6,24] cache=0 hits=0
test: list=1,1,3,4,4,4,4 min_len=3
expect: => i=16 r=0.0 ok=true s="folded runs sum: 16" errors=0 n=8 res=[1,1,3,4,4,4,4,16] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${min_len};
	var sum = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len > lim {
			sum += g.res[i] * len;
		}
		i = j;
	}
	out.i = sum;
	gold_push(g, sum);
	out.s.clear();
	format(out.s, "folded runs sum: ", sum);
	out
}
@end
