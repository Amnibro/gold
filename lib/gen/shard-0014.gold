fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_req = ${min_attempts};
	if min_req <= 0 {
		gold_fail(g, "required minimum attempts must be greater than zero");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("attempt threshold error");
		return out;
	}
	var attempts = 0;
	while attempts < min_req {
		attempts++;
		g.steps++;
	}
	out.i = attempts;
	out.ok = true;
	out.s.clear();
	format(out.s, "completed retries: ", attempts);
	out
}
