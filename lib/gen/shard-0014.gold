test: arg=12345,678 count=3
expect: 123
expect: 678
test: arg=98 count=1
expect: 9
code:
fn ${ID}(n int) int {
	let c = ${count};
	var x = if n < 0 { -n } else { n };
	var len = 0;
	var temp = x;
	while temp > 0 {
		len++;
		temp /= 10;
	}
	if len <= c {
		return x;
	}
	var shift = len - c;
	while shift > 0 {
		x /= 10;
		shift--;
	}
	x
}
@end
