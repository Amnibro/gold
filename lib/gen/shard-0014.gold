@entry cf96f2f91cc7e0be
kind: step
verb: drop
noun: digits
modifier: at_most
context: compare
phrase: drop at most {max_drop} single digits from buffer
phrase: remove single digits capping removals at most {max_drop}
slot: max_drop int
test: list=1,2,3,15,16 max_drop=2
expect: => i=2 r=0.0 ok=true s="dropped at most 2 digits count 2" errors=0 n=3 res=[3,15,16] cache=0 hits=0
test: list=1,2 max_drop=0
expect: => i=0 r=0.0 ok=false s="error: max drop must be positive" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_drop = ${max_drop};
	if max_drop <= 0 {
		gold_fail(g, "max drop must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: max drop must be positive");
		return out;
	}
	var kept = [0; 512];
	var kept_n = 0;
	var dropped = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 && x <= 9 && dropped < max_drop {
			dropped++;
		} else {
			kept[kept_n] = x;
			kept_n++;
		}
	}
	for i in kept_n {
		g.res[i] = kept[i];
	}
	g.n = kept_n;
	g.steps += g.n + dropped;
	out.i = dropped;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped at most ", max_drop, " digits count ", dropped);
	out
}
@end
@entry 7330af06e20d363a
kind: step
verb: drop
noun: primes
modifier: each
context: compare
phrase: drop each prime number from comparison list
phrase: filter out each prime element in buffer
test: list=2,4,5,6,7,8
expect: => i=3 r=0.0 ok=true s="dropped each prime count 3" errors=0 n=3 res=[4,6,8] cache=0 hits=0
test: list=4,6,8
expect: => i=0 r=0.0 ok=true s="dropped each prime count 0" errors=0 n=3 res=[4,6,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var non_primes = [0; 512];
	var np_n = 0;
	var dropped_p = 0;
	for k in g.n {
		let x = g.res[k];
		var is_p = false;
		if x >= 2 {
			is_p = true;
			var d = 2;
			while d * d <= x {
				if x % d == 0 {
					is_p = false;
					break;
				}
				d++;
			}
		}
		if is_p {
			dropped_p++;
		} else {
			non_primes[np_n] = x;
			np_n++;
		}
	}
	for i in np_n {
		g.res[i] = non_primes[i];
	}
	g.n = np_n;
	g.steps += g.n + dropped_p;
	out.i = dropped_p;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped each prime count ", dropped_p);
	out
}
@end
