	if g.n == 0 {
		gold_fail(g, "empty list has no elements");
		out.ok = false;
		return out;
	}
	let last = g.res[g.n - 1];
	var dup = false;
	for i in (g.n - 1) {
		if g.res[i] == last {
			dup = true;
			break;
		}
	}
	if dup {
		gold_fail(g, "last element has duplicates");
		out.ok = false;
		return out;
	}
	g.steps += g.n;
	out.i = last;
	out.ok = true;
	out.s.clear();
	format(out.s, "last element ", last, " is unique");
	out
}
