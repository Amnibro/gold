@entry c95d23f498559ac6
kind: step
verb: fill
noun: list
modifier: unique
context: transform
phrase: fill list with unique numbers up to size {target_len}
phrase: expand list to unique length {target_len}
slot: target_len int
test: list=1,2 target_len=5
expect: => i=5 r=0.0 ok=true s="" errors=0 n=5 res=[1,2,3,4,5] cache=0 hits=0
test: list=3,4,5 target_len=6
expect: => i=6 r=0.0 ok=true s="" errors=0 n=6 res=[3,4,5,1,2,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target_len};
	var next_val = 1;
	while g.n < tgt && g.n < 500 {
		var found = false;
		for i in g.n {
			if g.res[i] == next_val { found = true; break; }
		}
		if !found {
			gold_push(g, next_val);
		}
		next_val++;
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
