fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lk = ${limit_k};
	var limit = if lk < g.n { lk } else { g.n };
	var is_sorted = true;
	if limit > 1 {
		for i in (limit - 1) {
			if g.res[i] > g.res[i + 1] {
				is_sorted = false;
				break;
			}
		}
	}
	g.steps += limit + 1;
	out.ok = is_sorted;
	out.i = if is_sorted { 1 } else { 0 };
	out.s.clear();
	format(out.s, "sequence sorted up to limit: ", is_sorted);
	out
}
@end
@entry 5389999e3f25be69
kind: step
verb: fill
noun: runs
modifier: at_least
context: sort
slot: min_len int
slot: pad_val int
phrase: sort fill runs at least span {min_len} with {pad_val}
phrase: extend equal runs at least length {min_len} using {pad_val}
test: list=1,1,2,3 min_len=2 pad_val=0
expect: => i=2 r=0.0 ok=true s="filled runs with 2 pad elements" errors=0 n=6 res=[1,1,2,0,3,0] cache=0 hits=0
test: list=5,6,7 min_len=2 pad_val=0
expect: => i=3 r=0.0 ok=true s="filled runs with 3 pad elements" errors=0 n=6 res=[5,0,6,0,7,0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	let pv = ${pad_val};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var new_n = 0;
	var temp int[512] = [0; 512];
	var idx = 0;
	var added = 0;
	while idx < g.n {
		let val = g.res[idx];
		var run_len = 0;
		while idx < g.n && g.res[idx] == val {
			temp[new_n] = val;
			new_n++;
			run_len++;
			idx++;
		}
		while run_len < ml && new_n < 512 {
			temp[new_n] = pv;
			new_n++;
			run_len++;
			added++;
		}
	}
	for k in new_n { g.res[k] = temp[k]; }
	g.n = new_n;
	g.steps += g.n * g.n + 1;
	out.i = added;
	out.s.clear();
	format(out.s, "filled runs with ", added, " pad elements");
	out
}
@end
