code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no primes");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let orig = g.n;
	var primes = 0;
	for i in orig {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		if is_p {
			gold_push(g, x);
			primes++;
		}
	}
	g.steps += orig;
	out.i = primes;
	out.ok = true;
	out.s.clear();
	format(out.s, "repeated ", primes, " primes");
	out
}
@end
