fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 {
		out.i = 0;
		out.s.clear();
		format(out.s, "insufficient window elements");
		return out;
	}
	var acc = 0;
	var i = 0;
	while i < g.n - 1 {
		let diff = g.res[i + 1] - g.res[i];
		acc += if diff < 0 { -diff } else { diff };
		i++;
	}
	g.steps += g.n;
	out.i = acc;
	out.s.clear();
	format(out.s, "folded window span: ", acc);
	out
}
@end
