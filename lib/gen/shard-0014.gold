fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${limit};
	if lim <= 0 {
		gold_fail(g, "limit must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: non-positive limit");
		return out;
	}
	var traced = 0;
	var i = 0;
	while i < g.n && traced < lim {
		g.res[i] += 1;
		traced++;
		i++;
	}
	g.steps += traced;
	out.i = traced;
	out.ok = true;
	out.s.clear();
	format(out.s, "traced ", traced, " steps while under limit");
	out
}
@end
