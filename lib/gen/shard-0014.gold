fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 16 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let progress = (q as real) / (${n} as real) * 2.0 - 1.0;
		let px = progress * ${a};
		let py = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * 4.0;
		let rad = 1.2 + gold_hash01(q, 2, ${u}) * 0.8;
		o.clear();
		gold_dnews(g, "island", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("4");
		o.append(" r");
		gold_fnum(o, rad);
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 107, 143, 78);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "winding wind islands");
	out
}
@end
