fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var alt_idx: int[512] = [0; 512];
	var alt_val: int[512] = [0; 512];
	var count = 0;
	var i = 0;
	while i < g.n {
		alt_idx[count] = i;
		alt_val[count] = g.res[i];
		count++;
		i += 2;
	}
	if count > 1 {
		for j in count {
			let src = (j - 1 + count) % count;
			g.res[alt_idx[j]] = alt_val[src];
		}
	}
	out.i = count;
	out.s.clear();
	format(out.s, "alternating count: ", count);
	out
}
@end
