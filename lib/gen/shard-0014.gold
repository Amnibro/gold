code:
fn ${ID}(n int) int {
	let fv = ${target};
	var x = if n < 0 { -n } else { n };
	if x == 0 { return 0; }
	var digits int[20] = [0; 20];
	var len = 0;
	while x > 0 {
		let d = x % 10;
		digits[len] = if d != 0 { fv } else { 0 };
		len++;
		x /= 10;
	}
	var res = 0;
	var i = len - 1;
	while i >= 0 {
		res = res * 10 + digits[i];
		i--;
	}
	if n < 0 { -res } else { res }
}
@end
