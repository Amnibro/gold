@entry aa64ad9d6ea77a94
kind: step
verb: find
noun: limit
modifier: unique
context: transform
phrase: find unique results below limit {cap}
phrase: extract distinct items below limit {cap}
slot: cap int
test: list=2,5,2,7,5,1 cap=6
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[2,5,1] cache=0 hits=0
test: list=10,3,10,4,3,2 cap=5
expect: => i=3 r=0.0 ok=true s="" errors=0 n=3 res=[3,4,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cap = ${cap};
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		if x <= cap {
			var seen = false;
			for j in write {
				if g.res[j] == x { seen = true; break; }
			}
			if !seen {
				g.res[write] = x;
				write++;
			}
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
@entry 6e29395187141278
kind: step
verb: normalize
noun: middle
modifier: recursively
context: transform
phrase: normalize middle items recursively for {passes} passes
phrase: smooth central values recursively over {passes} iterations
slot: passes int
test: list=2,10,4,8 passes=1
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[2,5,5,8] cache=0 hits=0
test: list=1,20,30,5 passes=2
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,11,11,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let p = ${passes};
	for round in p {
		if g.n >= 3 {
			for i in 1..(g.n - 1) {
				g.res[i] = (g.res[i - 1] + g.res[i] + g.res[i + 1]) / 3;
			}
		}
	}
	out.i = g.n;
	g.steps += p + 1;
	out
}
@end
