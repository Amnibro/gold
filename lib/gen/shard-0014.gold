fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let cut = ${cutoff};
	var u_vals int[256] = [0; 256];
	var u_len = 0;
	for i in g.n {
		let x = g.res[i];
		if x > cut {
			var seen = false;
			for j in u_len {
				if u_vals[j] == x { seen = true; break; }
			}
			if !seen && u_len < 256 {
				u_vals[u_len] = x;
				u_len++;
			}
		}
	}
	gold_clear(g);
	var sum = 0;
	for i in u_len {
		gold_push(g, u_vals[i]);
		sum += u_vals[i];
	}
	g.steps += g.n + 1;
	out.i = sum;
	out.s.clear();
	format(out.s, "merged unique threshold sum: ", sum);
	out
}
@end
