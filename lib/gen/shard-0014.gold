test: list=1,1,1,2,2,3 max_dupes=2
expect: => i=5 r=0.0 ok=true s="deduped runs keeping 5 values" errors=0 n=5 res=[1,1,2,2,3] cache=3 hits=3
test: list=5,5,5,5 max_dupes=1
expect: => i=1 r=0.0 ok=true s="deduped runs keeping 1 values" errors=0 n=1 res=[5] cache=1 hits=3
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_dupes};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt, ok = gold_cache_get(g, x);
		if !ok { cnt = 0; }
		if cnt < m {
			g.res[kept] = x;
			kept++;
			gold_cache_put(g, x, cnt + 1);
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped runs keeping ", kept, " values");
	out
}
@end
@entry 982155a81c92bd9b
kind: step
