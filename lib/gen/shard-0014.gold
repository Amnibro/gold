fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mgt = ${max_gap_tol};
	var kept = 1;
	if g.n > 1 {
		var i = 1;
		while i < g.n {
			let diff = g.res[i] - g.res[i - 1];
			if diff <= mgt {
				g.res[kept] = g.res[i];
				kept++;
			}
			i++;
		}
		g.n = kept;
	}
	g.steps += g.n;
	out.i = kept;
	out.s.clear();
	format(out.s, "kept elements within gap: ", kept);
