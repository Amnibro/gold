@entry 0581457dacee2fa9
kind: step
verb: group
noun: tally
modifier: first
context: transform
phrase: group tally of first {k} elements
phrase: count frequency distribution for first {k} items
slot: k int
test: list=5,5,7,5,9 k=4
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[5,5,7,5,9] cache=0 hits=0
test: list=3,4,3,4,4 k=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=5 res=[3,4,3,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let count = ${k};
	let limit = if count < g.n { count } else { g.n };
	var matches = 0;
	if limit > 0 {
		let target = g.res[0];
		for i in limit {
			if g.res[i] == target { matches++; }
		}
	}
	out.i = matches;
	g.steps += limit + 1;
	out
}
@end
@entry b3e6da84dfd8c7fc
kind: step
verb: shift
noun: primes
modifier: all
context: transform
phrase: shift all prime items by {offset}
phrase: adjust all prime values with offset {offset}
slot: offset int
test: list=2,3,4,5,6 offset=10
expect: => i=3 r=0.0 ok=true s="" errors=0 n=5 res=[12,13,4,15,6] cache=0 hits=0
test: list=7,8,9,11 offset=5
expect: => i=2 r=0.0 ok=true s="" errors=0 n=4 res=[12,8,9,16] cache=0 hits=0
code:
fn ${ID}_is_prime(n int) bool {
	if n < 2 { return false; }
	var d = 2;
	while d * d <= n {
		if n % d == 0 { return false; }
		d++;
	}
	true
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let off = ${offset};
	var shifted = 0;
	for i in g.n {
		if ${ID}_is_prime(g.res[i]) {
			g.res[i] += off;
			shifted++;
		}
	}
	out.i = shifted;
	g.steps += shifted + 1;
	out
}
@end
@entry b13abdd894b04c14
kind: step
verb: drop
noun: pairs
modifier: all
context: transform
phrase: drop all duplicate adjacent pairs
phrase: eliminate all consecutive duplicate pairs
test: list=1,1,2,3,3,4
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=5,6,6,7,8,8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,6,7,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 2 { return out; }
	var write = 1;
	for i in 1..g.n {
		if g.res[i] != g.res[i - 1] {
			g.res[write] = g.res[i];
			write++;
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
@entry 072ccfb99d9968dd
kind: step
verb: shift
noun: words
modifier: with_cache
context: transform
phrase: shift text words with cache using offset {shift}
phrase: rotate characters across words with cache by {shift}
slot: shift int
test: text="hello" shift=1
expect: => i=5 r=0.0 ok=true s="ifmmp" errors=0 n=0 res=[] cache=4 hits=0
test: text="world" shift=3
expect: => i=5 r=0.0 ok=true s="zruog" errors=0 n=0 res=[] cache=5 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let s = ${shift};
	for i in out.s.len {
		let b = out.s[i];
		if b >= 'a' && b <= 'z' {
			let shifted = ((b as int - 'a' + s) % 26) + 'a';
			out.s[i] = shifted as byte;
			gold_cache_put(g, b as int, shifted);
		}
	}
	g.steps += out.s.len + 1;
	out.i = out.s.len;
	out
}
@end
