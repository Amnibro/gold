kind: step
verb: merge
noun: window
modifier: recursively
context: error
phrase: merge recursive window segments validating size {win_size}
phrase: combine window partitions recursively checking span {win_size}
slot: win_size int
test: list=1,2,3,4 win_size=2
expect: => i=2 r=0.0 ok=true s="recursively merged windows: 2" errors=0 n=2 res=[3,7] cache=0 hits=0
test: list=1,2,3 win_size=0
expect: => i=0 r=0.0 ok=false s="invalid window size error" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
recursive fn ${ID}_sum_rec(res int[:], start int, count int) int {
	if count <= 0 { return 0; }
	return res[start] + ${ID}_sum_rec(res, start + 1, count - 1);
}

fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let w = ${win_size};
	if w <= 0 || w > g.n {
		gold_fail(g, "window size must be positive and within bounds");
		out.ok = false;
		out.i = 0;
		out.s.clear();
		out.s.append("invalid window size error");
		return out;
	}
	let windows = g.n / w;
	for idx in windows {
		let s = ${ID}_sum_rec(g.res[..], idx * w, w);
		g.res[idx] = s;
	}
	g.n = windows;
	out.i = windows;
	out.ok = true;
	out.s.clear();
	format(out.s, "recursively merged windows: ", windows);
	out
}
@end
