@entry a40521e7773d62ac
kind: step
verb: collect
noun: streak
modifier: at_least
context: sort
slot: min_len int
phrase: sort collect streak at least count {min_len}
phrase: gather equal streaks at least span {min_len}
test: list=1,2,2,3,4,4,4 min_len=2
expect: => i=2 r=0.0 ok=true s="collected 2 streak values" errors=0 n=2 res=[2,4] cache=0 hits=0
test: list=1,2,3,4 min_len=2
expect: => i=0 r=0.0 ok=true s="collected 0 streak values" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var run_cnt = 0;
		while (idx + run_cnt) < g.n && g.res[idx + run_cnt] == x {
			run_cnt++;
		}
		if run_cnt >= ml {
			g.res[new_n] = x;
			new_n++;
		}
		idx += run_cnt;
	}
	g.steps += g.n * g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "collected ", new_n, " streak values");
	out
}
@end
