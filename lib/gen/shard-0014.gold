expect: => i=1 r=0.0 ok=true s="head placed in tries: 1" errors=0 n=3 res=[2,10,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_tries};
	var tries = 0;
	while tries < limit {
		var min_idx = 0;
		for idx in g.n {
			if g.res[idx] < g.res[min_idx] {
				min_idx = idx;
			}
		}
		if min_idx != 0 {
			let tmp = g.res[0];
			g.res[0] = g.res[min_idx];
			g.res[min_idx] = tmp;
		}
		tries++;
		var head_min = true;
		for idx in g.n {
			if g.res[0] > g.res[idx] {
				head_min = false;
				break;
			}
		}
		if head_min {
			break;
		}
	}
	out.i = tries;
	out.s.clear();
	format(out.s, "head placed in tries: ", tries);
	out
}
@end
