fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let l = ${lo};
	let h = ${hi};
	var m = 0;
	var tot = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= l && x <= h {
			g.res[m] = x;
			tot += x;
			m++;
		}
	}
	g.n = m;
	g.steps += m;
	out.i = tot;
	out.s.clear();
	format(out.s, "range sum ", tot);
	out
}
@end
