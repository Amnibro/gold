fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len >= 2 {
		let c0 = out.s[0];
		var j = -1;
		for k in out.s.len {
			if out.s[k] != c0 {
				j = k;
				break;
			}
		}
		if j > 0 {
			let tmp = out.s[0];
			out.s[0] = out.s[j];
			out.s[j] = tmp;
			out.i = 1;
		} else {
			out.i = 0;
		}
	} else {
		out.i = 0;
	}
	out
}
@end
