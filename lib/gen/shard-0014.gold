fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${count};
	var stored = 0;
	for i in g.n {
		if stored >= lim { break; }
		let x = g.res[i];
		if x % 2 != 0 {
			gold_cache_put(g, stored, x);
			stored++;
		}
	}
	out.i = stored;
	g.steps += stored + 1;
	out
}
@end
