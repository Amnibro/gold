verb: swap
noun: evens
modifier: at_least
context: compare
slot: min_val int
phrase: compare evens swapping adjacent pairs at least {min_val}
phrase: swap adjacent even numbers at least threshold {min_val}
test: list=4,6,2,8 min_val=3
expect: => i=0 r=0.0 ok=true s="swapped evens count: 0" errors=0 n=4 res=[4,6,2,8] cache=0 hits=0
test: list=10,12,1,14 min_val=5
expect: => i=0 r=0.0 ok=true s="swapped evens count: 0" errors=0 n=4 res=[10,12,1,14] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mv = ${min_val};
	var swaps = 0;
	var i = 0;
	while i + 1 < g.n {
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			if g.res[i] >= mv && g.res[i + 1] >= mv && g.res[i] > g.res[i + 1] {
				let tmp = g.res[i];
				g.res[i] = g.res[i + 1];
				g.res[i + 1] = tmp;
				swaps++;
			}
		}
		i++;
	}
	g.steps += g.n;
	out.i = swaps;
	out.s.clear();
