fn ${ID}(n int) int {
	var x = if n < 0 { -n } else { n };
	var memo int[8] = [1, 2, 4, 8, 16, 32, 64, 128];
	if x < 8 {
		return memo[x];
	}
	var acc = 0;
	while x > 0 {
		let idx = (x % 10) % 8;
		acc += memo[idx];
		x /= 10;
	}
	acc
}
@end
