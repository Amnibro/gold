	let last = g.res[g.n - 1];
	var m = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x >= last {
			g.res[m] = x;
			m++;
		}
		i++;
	}
	g.n = m;
	g.steps += g.n;
	out.i = last;
	out.s.clear();
	format(out.s, "traced last item: ", last);
	out
}
@end
