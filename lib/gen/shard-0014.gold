@entry 7af658655d3cbf19
kind: step
verb: dedupe
noun: histogram
modifier: at_least
context: math
phrase: dedupe elements having histogram frequency at least {thresh}
phrase: filter duplicate occurrences with counts at least {thresh}
slot: thresh int
test: list=1,2,2,2,3,3,4 thresh=3
expect: => i=2 r=0.0 ok=true s="histogram deduped: 2" errors=0 n=5 res=[1,2,3,3,4] cache=0 hits=0
test: list=5,5,6,7,7,7 thresh=2
expect: => i=3 r=0.0 ok=true s="histogram deduped: 3" errors=0 n=3 res=[5,6,7] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${thresh};
	var counts: int[512] = [0; 512];
	for i in g.n {
		let val = g.res[i];
		var c = 0;
		for j in g.n {
			if g.res[j] == val {
				c++;
			}
		}
		counts[i] = c;
	}
	var write = 0;
	var deduped = 0;
	for i in g.n {
		let val = g.res[i];
		if counts[i] >= limit {
			var already_written = false;
			for k in write {
				if g.res[k] == val {
					already_written = true;
					break;
				}
			}
			if !already_written {
				g.res[write] = val;
				write++;
			} else {
				deduped++;
			}
		} else {
			g.res[write] = val;
			write++;
		}
	}
	g.n = write;
	out.i = deduped;
	out.s.clear();
	format(out.s, "histogram deduped: ", deduped);
	out
}
@end
