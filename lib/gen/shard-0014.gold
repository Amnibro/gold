@entry b2a163342c56ce7d
kind: step
verb: collect
noun: tail
modifier: at_least
context: loop
phrase: collect tail items meeting at least threshold {min_val}
phrase: filter tail elements with values of at least {min_val}
slot: min_val int
test: list=1,10,2,20,3,30 min_val=15
expect: => i=2 r=0.0 ok=true s="collected 2 tail items of at least 15" errors=0 n=2 res=[20,30] cache=0 hits=0
test: list=1,2,3 min_val=10
expect: => i=0 r=0.0 ok=false s="no items met threshold" errors=1 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let min_val = ${min_val};
	var matched = [0; 512];
	var count = 0;
	for k in g.n {
		if g.res[k] >= min_val {
			matched[count] = g.res[k];
			count++;
		}
	}
	if count == 0 {
		gold_fail(g, "no tail items met threshold");
		out.ok = false;
		out.s.clear();
		format(out.s, "no items met threshold");
		return out;
	}
	for i in count {
		g.res[i] = matched[i];
	}
	g.n = count;
	g.steps += g.n;
	out.i = count;
	out.ok = true;
	out.s.clear();
	format(out.s, "collected ", count, " tail items of at least ", min_val);
	out
}
@end
@entry cee775724bdf2b4e
kind: step
verb: drop
noun: digits
modifier: with_cache
context: loop
phrase: drop digit elements saving count with cache slot {slot_idx}
phrase: filter single digits with cache recording in slot {slot_idx}
slot: slot_idx int
test: list=3,15,7,25 slot_idx=8
expect: => i=2 r=0.0 ok=true s="dropped digits count 2 with cache slot 8" errors=0 n=2 res=[15,25] cache=1 hits=0
test: list=5,8 slot_idx=8
expect: => i=2 r=0.0 ok=true s="dropped digits count 2 with cache slot 8" errors=0 n=0 res=[] cache=1 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let slot_idx = ${slot_idx};
	var kept = [0; 512];
	var kept_n = 0;
	var dropped_cnt = 0;
	for k in g.n {
		let x = g.res[k];
		if x >= 0 && x <= 9 {
			dropped_cnt++;
		} else {
			kept[kept_n] = x;
			kept_n++;
		}
	}
	gold_cache_put(g, slot_idx, dropped_cnt);
	for i in kept_n {
		g.res[i] = kept[i];
	}
	g.n = kept_n;
	g.steps += g.n + dropped_cnt;
	out.i = dropped_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped digits count ", dropped_cnt, " with cache slot ", slot_idx);
	out
}
@end
