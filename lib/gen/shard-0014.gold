fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap};
	var pairs_count = 0;
	var retries_used = 0;
	var i = 0;
	while i + 1 < g.n {
		let diff = g.res[i + 1] - g.res[i];
		if diff <= mg && diff >= -mg {
			pairs_count++;
			i += 2;
		} else if i + 2 < g.n {
			retries_used++;
			i++;
		} else {
			i++;
		}
	}
	g.steps += pairs_count + retries_used;
	out.i = pairs_count;
	out.s.clear();
	format(out.s, "counted pairs: ", pairs_count);
	out
}
@end
