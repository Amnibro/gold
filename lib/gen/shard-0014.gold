code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let max_words = ${count};
	var i = 0;
	var words_found = 0;
	while i < out.s.len && words_found < max_words {
		while i < out.s.len && out.s[i] == ' ' { i++; }
		var len = 0;
		while i < out.s.len && out.s[i] != ' ' { len++; i++; }
		if len > 0 {
			gold_push(g, len);
			words_found++;
		}
	}
	out.i = words_found;
	g.steps += out.s.len + 1;
	out
}
@end
