code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var kept = 0;
	for i in g.n {
		let sq = g.res[i] * g.res[i];
		var seen = false;
		for j in kept {
			if g.res[j] == sq { seen = true; break; }
		}
		if !seen {
			g.res[kept] = sq;
			kept++;
		}
	}
	g.steps += g.n;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "unique squares count: ", kept);
	out
}
@end
@entry fcefbb4807b2faa2
kind: step
verb: map
noun: primes
modifier: each
context: search
phrase: map each search element to nearest prime flag
phrase: mark prime status for each search match
test: list=4,5,6,7,8,9,10
expect: => i=7 r=0.0 ok=true s="mapped prime flags: 7" errors=0 n=7 res=[0,1,0,1,0,0,0] cache=0 hits=0
test: list=2,3,11,13
expect: => i=4 r=0.0 ok=true s="mapped prime flags: 4" errors=0 n=4 res=[1,1,1,1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		let x = g.res[i];
		var is_p = x >= 2;
		var d = 2;
		while d * d <= x {
			if x % d == 0 { is_p = false; break; }
			d++;
		}
		g.res[i] = if is_p { 1 } else { 0 };
	}
	g.steps += g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "mapped prime flags: ", g.n);
	out
}
@end
@entry 6469280d12258007
kind: step
verb: reverse
noun: suffix
modifier: last
context: search
phrase: reverse last {count} suffix elements of search
phrase: invert trailing suffix slice of size {count}
slot: count int
test: list=1,2,3,4,5,6 count=3
expect: => i=3 r=0.0 ok=true s="reversed suffix count: 3" errors=0 n=6 res=[1,2,3,6,5,4] cache=0 hits=0
test: list=10,20,30 count=2
expect: => i=2 r=0.0 ok=true s="reversed suffix count: 2" errors=0 n=3 res=[10,30,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let num = if k < g.n { k } else { g.n };
	if num > 1 {
		let start = g.n - num;
		var i = 0;
		while i < num / 2 {
			let tmp = g.res[start + i];
			g.res[start + i] = g.res[g.n - 1 - i];
			g.res[g.n - 1 - i] = tmp;
			i++;
		}
	}
	g.steps += num + 1;
	out.i = num;
	out.s.clear();
	format(out.s, "reversed suffix count: ", num);
	out
}
@end
