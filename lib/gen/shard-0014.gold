code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if out.s.len > 1 {
		var write = 1;
		for i in 1..out.s.len {
			if out.s[i] != out.s[write - 1] {
				out.s[write] = out.s[i];
				write++;
			}
		}
		out.s.resize(write, ' ');
	}
	out.i = out.s.len;
	out
}
@end
@entry ccdbe383b01e3fda
kind: step
verb: fold
noun: runs
modifier: at_least
context: list
phrase: fold runs of identical elements at least {min_run}
phrase: sum identical consecutive items having length at least {min_run}
slot: min_run int
test: list=3,3,3,4,5,5,5 min_run=3
expect: => i=24 r=0.0 ok=true s="folded runs sum: 24" errors=0 n=8 res=[3,3,3,4,5,5,5,24] cache=0 hits=0
test: list=1,1,2,2,2,2 min_run=4
expect: => i=8 r=0.0 ok=true s="folded runs sum: 8" errors=0 n=7 res=[1,1,2,2,2,2,8] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${min_run};
	var sum = 0;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n && g.res[j] == g.res[i] {
			j++;
		}
		let len = j - i;
		if len >= limit {
			sum += g.res[i] * len;
		}
		i = j;
	}
	gold_push(g, sum);
	out.i = sum;
	out.s.clear();
	format(out.s, "folded runs sum: ", sum);
	out
}
@end
@entry 5898b261c3bdab91
kind: step
verb: clamp
noun: maximum
modifier: recursively
context: list
phrase: clamp maximum value recursively below limit {ceiling}
phrase: restrict maximum item recursively to ceiling {ceiling}
slot: ceiling int
test: list=5,20,40,15 ceiling=25
expect: => i=1 r=0.0 ok=true s="clamped maximum iterations: 1" errors=0 n=4 res=[5,20,20,15] cache=0 hits=0
test: list=100,50,20 ceiling=45
expect: => i=3 r=0.0 ok=true s="clamped maximum iterations: 3" errors=0 n=3 res=[25,25,20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ceil = ${ceiling};
	var iterations = 0;
	while iterations < 50 {
		var max_idx = -1;
		var max_val = ceil;
		for i in g.n {
			if g.res[i] > max_val {
				max_val = g.res[i];
				max_idx = i;
			}
		}
		if max_idx >= 0 {
			g.res[max_idx] /= 2;
			iterations++;
		} else {
			break;
		}
	}
	out.i = iterations;
	out.s.clear();
	format(out.s, "clamped maximum iterations: ", iterations);
	out
}
@end
