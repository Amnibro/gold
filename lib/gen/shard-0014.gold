fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var pair_count = 0;
	var sums int[512] = [0; 512];
	var i = 0;
	while i + 1 < g.n {
		sums[pair_count] = g.res[i] + g.res[i + 1];
		pair_count++;
		i += 2;
	}
	var a = 0;
	while a < pair_count {
		var b = a + 1;
		while b < pair_count {
			if sums[b] < sums[a] {
				let tmp = sums[a];
				sums[a] = sums[b];
				sums[b] = tmp;
			}
			b++;
		}
		a++;
	}
	for k in pair_count {
		g.res[k] = sums[k];
	}
	g.n = pair_count;
	g.steps += g.n;
	out.i = pair_count;
	out.s.clear();
	format(out.s, "sorted pair totals: ", pair_count);
	out
}
@end
