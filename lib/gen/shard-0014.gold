code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_swaps};
	var swaps = 0;
	var i = 0;
	while (i + 1) < g.n && swaps < ms {
		if g.res[i] % 2 == 0 && g.res[i + 1] % 2 == 0 {
			let tmp = g.res[i];
			g.res[i] = g.res[i + 1];
			g.res[i + 1] = tmp;
			swaps++;
			i += 2;
		} else {
			i++;
		}
	}
	g.steps += g.n + 1;
	out.i = swaps;
	out.s.clear();
	format(out.s, "swapped ", swaps, " even pairs");
	out
}
@end
