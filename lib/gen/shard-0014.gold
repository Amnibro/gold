fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var inversions = 0;
	var i = 0;
	while i < g.n - 1 {
		if g.res[i] > g.res[i + 1] {
			inversions++;
		}
		i++;
	}
	g.steps += g.n + 1;
	out.i = inversions;
	out.s.clear();
	format(out.s, "found ", inversions, " unsorted adjacent pairs");
	out
}
