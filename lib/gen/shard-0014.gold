expect: => img: 32x32 min=0 max=1 sum8=130592 hash=885189
test: n=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = ((x / 8 + y / 8) % 2) as real;
		}
	}
	var s_ts = g.img;
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			for dy in 3 { for dx in 3 { t += gold_img_wrap(g, x + dx - 1, y + dy - 1); } }
			s_ts[y * g.iw + x] = t / 9.0;
		}
	}
	g.img = s_ts;
	if ${n} < 2 || ${n} > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (${n} as real)) as! int;
		if t > ${n} - 1 { t = ${n} - 1; }
		g.img[k] = (t as real) / ((${n} - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "tiles");
	out
}
@end
