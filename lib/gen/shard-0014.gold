fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let left = if ${lo} < 0 { 0 } else { ${lo} };
	let right = if ${hi} >= g.n { g.n - 1 } else { ${hi} };
	var swaps = 0;
	if left < right && right < g.n {
		var i = left;
		while i <= right {
			var j = i + 1;
			while j <= right {
				if g.res[i] > g.res[j] {
					let tmp = g.res[i];
					g.res[i] = g.res[j];
					g.res[j] = tmp;
					swaps++;
				}
				j++;
			}
			i++;
		}
	}
	out.i = swaps;
	out.s.clear();
	format(out.s, "subrange swaps: ", swaps);
	out
}
@end
