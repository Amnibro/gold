fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var a = -1;
	var b = -1;
	for i in g.n {
		if g.res[i] < ${limit} {
			if a < 0 {
				a = i;
			} else if b < 0 {
				b = i;
			}
		}
	}
	if a >= 0 && b >= 0 {
		let tmp = g.res[a];
		g.res[a] = g.res[b];
		g.res[b] = tmp;
		out.i = 1;
	} else {
		out.i = 0;
	}
	out
}
@end
