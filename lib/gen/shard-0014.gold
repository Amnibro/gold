@entry d59c51687b07a64f
kind: step
verb: repeat
noun: condition
modifier: unique
context: text
phrase: repeat unique characters satisfying condition {req}
phrase: duplicate distinct letters passing predicate {req}
slot: req pred
test: text="banana" req=is_even
expect: => i=5 r=0.0 ok=true s="bbann" errors=0 n=0 res=[] cache=0 hits=0
test: text="banana" req=is_odd
expect: => i=4 r=0.0 ok=true s="baan" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var uniq: byte[256] = [' '; 256];
	var u_len = 0;
	for i in out.s.len {
		let c = out.s[i];
		var seen = false;
		for j in u_len {
			if uniq[j] == c {
				seen = true;
				break;
			}
		}
		if !seen {
			uniq[u_len] = c;
			u_len++;
		}
	}
	var res: byte[512] = [' '; 512];
	var rlen = 0;
	for i in u_len {
		let c = uniq[i];
		res[rlen] = c;
		rlen++;
		if ${req}(c as int) && rlen < 512 {
			res[rlen] = c;
			rlen++;
		}
	}
	out.s.resize(rlen, ' ');
	for i in rlen {
		out.s[i] = res[i];
	}
	out.i = rlen;
	out
}
@end
