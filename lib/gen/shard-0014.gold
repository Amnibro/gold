fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tol = ${tolerance};
	var is_sorted = true;
	var inversions = 0;
	if g.n > 1 {
		for i in (g.n - 1) {
			if g.res[i] > g.res[i + 1] + tol {
				is_sorted = false;
				inversions++;
			}
		}
	}
	g.steps += g.n + 1;
	out.ok = is_sorted;
	out.i = inversions;
	out.s.clear();
	format(out.s, "sequence inversions: ", inversions);
	out
}
@end
