test: list=1,2,3,4,5 k=3
expect: => i=3 r=0.0 ok=true s="rotated tail window of size 3" errors=0 n=5 res=[1,2,5,3,4] cache=0 hits=0
test: list=1 k=3
expect: => i=0 r=0.0 ok=false s="" errors=1 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${k};
	if k < 2 || g.n < 2 {
		gold_fail(g, "not enough elements to rotate tail");
		out.ok = false;
		return out;
	}
	var m = k;
	if m > g.n {
		m = g.n;
	}
	let start = g.n - m;
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > start {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[start] = last;
	g.steps += m;
	out.i = m;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated tail window of size ", m);
	out
}
@end
