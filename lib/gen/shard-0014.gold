code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot rotate empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	let last = g.res[g.n - 1];
	var i = g.n - 1;
	while i > 0 {
		g.res[i] = g.res[i - 1];
		i--;
	}
	g.res[0] = last;
	g.steps += g.n;
	out.i = last;
	out.ok = true;
	out.s.clear();
	format(out.s, "rotated last checkpoint: ", last);
	out
}
@end
