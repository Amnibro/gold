code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var errors = 0;
	var unique_evens = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			gold_fail(g, "odd number encountered in even merge");
			errors++;
		} else {
			var exists = false;
			for j in unique_evens {
				if g.res[j] == x { exists = true; break; }
			}
			if !exists {
				g.res[unique_evens] = x;
				unique_evens++;
			}
		}
	}
	g.n = unique_evens;
	out.i = unique_evens;
	out.ok = errors == 0;
	out.s.clear();
	format(out.s, "merged unique evens: ", unique_evens);
	out
}
@end
