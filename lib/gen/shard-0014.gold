test: list=1,2,3,2,4
expect: => i=2 r=0.0 ok=true s="found duplicate in reverse: 2" errors=0 n=5 res=[1,2,3,2,4] cache=0 hits=0
test: list=1,2,3,4
expect: => i=0 r=0.0 ok=false s="no duplicates found" errors=1 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var dup_val = 0;
	var found = false;
	var i = g.n - 1;
	while i >= 0 && !found {
		var j = i - 1;
		while j >= 0 {
			if g.res[i] == g.res[j] {
				dup_val = g.res[i];
				found = true;
				break;
			}
			j--;
		}
		i--;
	}
	g.steps += g.n;
	out.s.clear();
	if found {
		out.i = dup_val;
		out.ok = true;
		format(out.s, "found duplicate in reverse: ", dup_val);
	} else {
		gold_fail(g, "no duplicates found");
		out.i = 0;
		out.ok = false;
		format(out.s, "no duplicates found");
	}
	out
}
@end
