code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mg = ${max_gap_size};
	var violations = 0;
	var idx = 0;
	while idx + 1 < g.n {
		let diff = g.res[idx + 1] - g.res[idx];
		let gap = if diff < 0 { -diff } else { diff };
		if gap > mg {
			violations++;
		}
		idx++;
	}
	g.steps += g.n;
	out.ok = violations == 0;
	out.i = violations;
	out.s.clear();
	format(out.s, "gap violations detected: ", violations);
	out
}
@end
