@entry abd777007b10bd68
kind: step
verb: split
noun: duplicates
modifier: in_reverse
context: search
slot: marker int
phrase: search split duplicates in reverse tag {marker}
phrase: isolate duplicate items in reverse marker {marker}
test: list=1,2,3,2,1 marker=0
expect: => i=2 r=0.0 ok=true s="split 2 duplicates in reverse scan" errors=0 n=5 res=[1,2,3,0,0] cache=0 hits=0
test: list=4,5,6 marker=0
expect: => i=0 r=0.0 ok=true s="split 0 duplicates in reverse scan" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mark = ${marker};
	var dupes = 0;
	var i = g.n - 1;
	while i >= 0 {
		let x = g.res[i];
		var seen_before = false;
		var j = 0;
		while j < i {
			if g.res[j] == x {
				seen_before = true;
				break;
			}
			j++;
		}
		if seen_before {
			g.res[i] = mark;
			dupes++;
		}
		i--;
	}
	g.steps += g.n * g.n + 1;
	out.i = dupes;
	out.s.clear();
	format(out.s, "split ", dupes, " duplicates in reverse scan");
	out
}
@end
