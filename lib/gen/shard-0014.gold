fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		g.res[i] = ${f}(g.res[i]);
	}
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in write {
			if g.res[j] == x { seen = true; break; }
		}
		if !seen {
			g.res[write] = x;
			write++;
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
