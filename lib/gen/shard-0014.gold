context: stats
slot: min_repeats int
phrase: stats split duplicates in place threshold {min_repeats}
phrase: partition duplicates in place cutoff {min_repeats}
test: list=1,2,2,3,2,1 min_repeats=2
expect: => i=5 r=0.0 ok=true s="partitioned 5 duplicate instances" errors=0 n=6 res=[1,2,2,2,1,3] cache=0 hits=0
test: list=4,5,6 min_repeats=2
expect: => i=0 r=0.0 ok=true s="partitioned 0 duplicate instances" errors=0 n=3 res=[4,5,6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${min_repeats};
	var dupes_count = 0;
	var dupes int[512] = [0; 512];
	var non_dupes int[512] = [0; 512];
	var dn = 0;
	var ndn = 0;
	for i in g.n {
		let x = g.res[i];
		var freq = 0;
		for j in g.n {
			if g.res[j] == x { freq++; }
		}
		if freq >= m {
			dupes[dn] = x;
			dn++;
			dupes_count++;
		} else {
			non_dupes[ndn] = x;
			ndn++;
		}
	}
	for i in dn { g.res[i] = dupes[i]; }
	for i in ndn { g.res[dn + i] = non_dupes[i]; }
	g.steps += g.n * g.n + 1;
	out.i = dupes_count;
	out.s.clear();
	format(out.s, "partitioned ", dupes_count, " duplicate instances");
	out
}
@end
@entry f5bde12ad85c32d6
kind: step
verb: dedupe
noun: histogram
modifier: with_cache
context: search
slot: max_count int
phrase: search dedupe histogram with cache bound {max_count}
phrase: prune query histogram with cache limit {max_count}
test: list=10,20,10,10,30 max_count=2
expect: => i=4 r=0.0 ok=true s="deduped histogram kept 4 bins" errors=0 n=4 res=[10,20,10,30] cache=3 hits=2
test: list=5,5,5 max_count=1
expect: => i=1 r=0.0 ok=true s="deduped histogram kept 1 bins" errors=0 n=1 res=[5] cache=1 hits=2
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let m = ${max_count};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var cnt, ok = gold_cache_get(g, x);
		if !ok { cnt = 0; }
		if cnt < m {
			g.res[kept] = x;
			kept++;
			gold_cache_put(g, x, cnt + 1);
		}
	}
	g.steps += g.n + 1;
	g.n = kept;
	out.i = kept;
	out.s.clear();
	format(out.s, "deduped histogram kept ", kept, " bins");
	out
}
@end
