@entry af0e96fb2afae42a
kind: step
verb: apply
noun: pairs
modifier: up_to
context: compare
phrase: apply pair diffs up to limit {lim} pairs
phrase: process pairs up to count {lim} recording differences
slot: lim int
test: list=10,12,20,25,30,38 lim=2
expect: => i=7 r=0.0 ok=true s="applied pairs up to limit diffs sum 7" errors=0 n=6 res=[10,12,20,25,30,38] cache=0 hits=0
test: list=10,12 lim=0
expect: => i=0 r=0.0 ok=false s="error: lim must be positive" errors=1 n=2 res=[10,12] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lim = ${lim};
	if lim <= 0 {
		gold_fail(g, "lim must be positive");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: lim must be positive");
		return out;
	}
	let avail = g.n / 2;
	var take = lim;
	if take > avail {
		take = avail;
	}
	var sum_diff = 0;
	var i = 0;
	while i < take {
		let a = g.res[i * 2];
		let b = g.res[i * 2 + 1];
		sum_diff += b - a;
		i++;
	}
	g.steps += take;
	out.i = sum_diff;
	out.ok = true;
	out.s.clear();
	format(out.s, "applied pairs up to limit diffs sum ", sum_diff);
	out
}
@end
@entry b3aff13eba57e7d0
kind: step
verb: find
noun: duplicates
modifier: in_reverse
context: compare
phrase: find duplicates scanning in reverse order
