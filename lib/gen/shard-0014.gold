fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let limit = ${max_total};
	var run_sum = 0;
	var m = 0;
	var i = 0;
	while i < g.n {
		if i % 2 == 0 {
			let x = g.res[i];
			if run_sum + x <= limit {
				run_sum += x;
				g.res[m] = x;
				m++;
			} else {
				break;
			}
		}
		i++;
	}
	g.n = m;
	g.steps += i;
	out.i = run_sum;
	out.s.clear();
	format(out.s, "validated every other total: ", run_sum);
	out
}
