code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var write = 0;
	for i in g.n {
		let x = g.res[i];
		if x >= 0 {
			var r = 0;
			while r * r < x { r++; }
			if r * r == x {
				var seen = false;
				for j in write {
					if g.res[j] == x { seen = true; break; }
				}
				if !seen {
					g.res[write] = x;
					write++;
				}
			}
		}
	}
	g.n = write;
	out.i = write;
	g.steps += write + 1;
	out
}
@end
