fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[j] < g.res[i] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var count = 0;
	for k in g.n {
		if g.res[k] < tgt {
			g.res[k] = tgt;
			count++;
		}
	}
	out.i = count;
	g.steps += count + 1;
	out
}
