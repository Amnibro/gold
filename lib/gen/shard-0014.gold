@entry 73443fa16d3a684b
kind: step
verb: sort
noun: odds
modifier: safely
context: error
phrase: sort odds safely checking odd parity on all items
phrase: order odd numbers safely reporting even errors
test: list=9,3,7,1
expect: => i=4 r=0.0 ok=true s="sorted odds count: 4" errors=0 n=4 res=[1,3,7,9] cache=0 hits=0
test: list=9,4,3
expect: => i=0 r=0.0 ok=false s="error: even element detected in odds" errors=1 n=3 res=[9,4,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for i in g.n {
		if g.res[i] % 2 == 0 {
			gold_fail(g, "even element detected in odds");
			out.ok = false;
			out.s.clear();
			format(out.s, "error: even element detected in odds");
			return out;
		}
	}
	var a = 0;
	while a < g.n {
		var b = a + 1;
		while b < g.n {
			if g.res[a] > g.res[b] {
				let tmp = g.res[a];
				g.res[a] = g.res[b];
				g.res[b] = tmp;
			}
			b++;
		}
		a++;
	}
	g.steps += g.n * g.n;
	out.i = g.n;
	out.s.clear();
	format(out.s, "sorted odds count: ", g.n);
	out
}
@end
