expect: => i=0 r=0.0 ok=true s="found 0 runs meeting threshold" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ml = ${min_len};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var runs_found = 0;
	var idx = 0;
	while idx < g.n {
		let x = g.res[idx];
		var run_cnt = 0;
		while (idx + run_cnt) < g.n && g.res[idx + run_cnt] == x {
			run_cnt++;
		}
		if run_cnt >= ml {
			runs_found++;
		}
		idx += run_cnt;
	}
	g.steps += g.n * g.n + 1;
	out.i = runs_found;
	out.s.clear();
	format(out.s, "found ", runs_found, " runs meeting threshold");
	out
}
@end
