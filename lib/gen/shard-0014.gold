fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds int[512] = [0; 512];
	var on = 0;
	var sum = 0;
	var i = 0;
	while i < g.n {
		let x = g.res[i];
		if x % 2 != 0 {
			var seen = false;
			var j = 0;
			while j < on {
				if odds[j] == x { seen = true; break; }
				j++;
			}
			if !seen {
				odds[on] = x;
				on++;
				sum += x;
			}
		}
		i++;
	}
	for k in on {
		g.res[k] = odds[k];
	}
	g.n = on;
	g.steps += g.n + on;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded unique odds sum: ", sum);
	out
}
