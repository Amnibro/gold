@entry a91473dcec98bd92
kind: step
verb: limit
noun: letters
modifier: last
context: transform
phrase: limit text to last {keep} letters
phrase: retain trailing {keep} letters of text
slot: keep int
test: text="abcdef" keep=3
expect: => i=3 r=0.0 ok=true s="def" errors=0 n=0 res=[] cache=0 hits=0
test: text="transform" keep=4
expect: => i=4 r=0.0 ok=true s="form" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${keep};
	if out.s.len > k {
		let start = out.s.len - k;
		var write = 0;
		for i in start..out.s.len {
			out.s[write] = out.s[i];
			write++;
		}
		out.s.resize(write, 0 as byte);
	}
	out.i = out.s.len;
	g.steps += 1;
	out
}
@end
