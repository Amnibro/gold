fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let step = ${offset};
	for i in out.s.len {
		let c = out.s[i];
		if c >= 'a' && c <= 'z' {
			let base = (c - 'a') as int;
			let shifted = (base + i * step) % 26;
			out.s[i] = ('a' + shifted) as byte;
		}
	}
	out.i = out.s.len;
	out
}
