kind: step
verb: dedupe
noun: values
modifier: times
context: stats
slot: max_freq int
phrase: stats dedupe values times frequency {max_freq}
phrase: prune sample values times frequency {max_freq}
test: list=1,2,2,2,3,3 max_freq=2
expect: => i=1 r=0.0 ok=true s="deduped values dropped 1 excess entries" errors=0 n=5 res=[1,2,2,3,3] cache=0 hits=0
test: list=4,4,4,4 max_freq=1
expect: => i=3 r=0.0 ok=true s="deduped values dropped 3 excess entries" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let mf = ${max_freq};
	var kept = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = 0;
		for j in kept {
			if g.res[j] == x { seen++; }
		}
		if seen < mf {
			g.res[kept] = x;
			kept++;
		}
	}
	let dropped = g.n - kept;
	g.steps += g.n * g.n + 1;
	g.n = kept;
	out.i = dropped;
	out.s.clear();
	format(out.s, "deduped values dropped ", dropped, " excess entries");
	out
}
@end
@entry e9e7cd18688898d5
kind: step
verb: sum
noun: squares
modifier: nested
context: stats
slot: chunk int
phrase: stats sum squares nested partition {chunk}
phrase: calculate nested sum of squares chunk {chunk}
test: list=1,2,3,4 chunk=2
expect: => i=30 r=0.0 ok=true s="summed 2 groups" errors=0 n=2 res=[5,25] cache=0 hits=0
test: list=2,3 chunk=3
expect: => i=13 r=0.0 ok=true s="summed 1 groups" errors=0 n=1 res=[13] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let c = ${chunk};
	if c <= 0 || g.n == 0 { return out; }
	var total_sum = 0;
	var i = 0;
	var new_n = 0;
	while i < g.n {
		var sub = 0;
		var j = 0;
		while j < c && (i + j) < g.n {
			let x = g.res[i + j];
			sub += x * x;
			j++;
		}
		total_sum += sub;
		g.res[new_n] = sub;
		new_n++;
		i += c;
	}
	g.n = new_n;
	g.steps += i + 1;
	out.i = total_sum;
	out.s.clear();
	format(out.s, "summed ", new_n, " groups");
	out
}
@end
