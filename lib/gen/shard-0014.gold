context: core
phrase: keep cache keys below maximum {max_key}
phrase: filter cache entries with key below {max_key}
slot: max_key int
test: list=10,20,30,40 max_key=2
expect: => i=2 r=0.0 ok=true s="kept 2 entries" errors=0 n=4 res=[10,20,30,40] cache=2 hits=0
test: list=5,6 max_key=5
expect: => i=2 r=0.0 ok=true s="kept 2 entries" errors=0 n=2 res=[5,6] cache=2 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.cn == 0 && g.n > 0 {
		for i in g.n {
			gold_cache_put(g, i, g.res[i]);
		}
	}
	var keep = 0;
	for i in g.cn {
		if g.ck[i] < ${max_key} {
			g.ck[keep] = g.ck[i];
			g.cv[keep] = g.cv[i];
			keep++;
		}
	}
	g.cn = keep;
	out.i = keep;
	out.s.clear();
	format(out.s, "kept ", keep, " entries");
	out
}
@end
