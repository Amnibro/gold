@entry e73363d4fcaab348
kind: step
verb: scale
noun: numbers
modifier: sorted
context: cache
phrase: scale sorted cache numbers by factor {factor}
phrase: multiply sorted cache keys by factor {factor}
slot: factor int
test: list=15,3,9 factor=2
expect: => i=3 r=0.0 ok=true s="scaled sorted cache items: 3" errors=0 n=3 res=[6,18,30] cache=3 hits=0
test: list=20,5,10 factor=3
expect: => i=3 r=0.0 ok=true s="scaled sorted cache items: 3" errors=0 n=3 res=[15,30,60] cache=3 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for k in g.n {
		gold_cache_put(g, g.res[k], k);
	}
	let f = ${factor};
	for i in g.cn {
		let k = g.ck[i];
		g.res[i] = k * f;
	}
	g.n = g.cn;
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.i = g.n;
	out.s.clear();
	format(out.s, "scaled sorted cache items: ", g.n);
	out
}
@end
