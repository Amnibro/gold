@entry 835cfab0907a110a
kind: step
verb: run
noun: window
modifier: any
context: sort
slot: win_size int
slot: check_fn pred
phrase: sort run window any match span {win_size} with {check_fn}
phrase: evaluate sliding window any match span {win_size} via {check_fn}
test: list=1,3,2,4,6 win_size=2 check_fn=is_even
expect: => i=1 r=0.0 ok=true s="sorted window match: true" errors=0 n=5 res=[1,2,3,4,6] cache=0 hits=0
test: list=1,3,5 win_size=2 check_fn=is_even
expect: => i=0 r=0.0 ok=false s="sorted window match: false" errors=0 n=3 res=[1,3,5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ws = ${win_size};
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var found = false;
	if ws > 0 && g.n >= ws {
		var idx = 0;
		while (idx + ws) <= g.n {
			var all_match = true;
			for k in ws {
				if !${check_fn}(g.res[idx + k]) {
					all_match = false;
					break;
				}
			}
			if all_match {
				found = true;
				break;
			}
			idx++;
		}
	}
	g.steps += g.n * g.n + 1;
	out.ok = found;
	out.i = if found { 1 } else { 0 };
	out.s.clear();
	format(out.s, "sorted window match: ", found);
	out
}
@end
@entry f7ced3c6995abec8
kind: step
verb: group
noun: series
modifier: none
context: sort
slot: block_size int
phrase: sort group series none partition {block_size}
phrase: cluster sorted series none size {block_size}
test: list=5,1,8,2,9,3 block_size=2
expect: => i=3 r=0.0 ok=true s="grouped series into 3 blocks" errors=0 n=3 res=[3,8,17] cache=0 hits=0
test: list=4,2 block_size=3
expect: => i=1 r=0.0 ok=true s="grouped series into 1 blocks" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let bs = ${block_size};
	if bs <= 0 || g.n == 0 { return out; }
	var i = 0;
	while i < g.n {
		var j = i + 1;
		while j < g.n {
			if g.res[i] > g.res[j] {
				let tmp = g.res[i];
				g.res[i] = g.res[j];
				g.res[j] = tmp;
			}
			j++;
		}
		i++;
	}
	var new_n = 0;
	var idx = 0;
	while idx < g.n {
		var sum = 0;
		var cnt = 0;
		while cnt < bs && (idx + cnt) < g.n {
			sum += g.res[idx + cnt];
			cnt++;
		}
		g.res[new_n] = sum;
		new_n++;
		idx += bs;
	}
	g.steps += g.n * g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "grouped series into ", new_n, " blocks");
	out
}
@end
