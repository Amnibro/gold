fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var mx = g.res[0];
	for i in g.n { if g.res[i] > mx { mx = g.res[i]; } }
	let cur, hit = gold_cache_get(g, 0);
	if hit {
		if mx > cur { gold_cache_put(g, 0, mx); }
	} else {
		gold_cache_put(g, 0, mx);
	}
	g.steps += g.n;
	out.i = mx;
	out.s.clear();
	format(out.s, "peak maximum ", mx);
	out
}
@end
