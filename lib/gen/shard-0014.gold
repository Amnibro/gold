@entry 10026be4ccad250b
kind: step
verb: drop
noun: pairs
modifier: unique
context: compare
phrase: drop duplicate adjacent pairs leaving unique pairs
phrase: remove identical consecutive pairs to preserve unique order
test: list=1,2,1,2,3,4
expect: => i=2 r=0.0 ok=true s="dropped duplicate pairs leaving 2 pairs" errors=0 n=4 res=[1,2,3,4] cache=0 hits=0
test: list=1,2
expect: => i=1 r=0.0 ok=true s="pairs already unique count 1" errors=0 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n < 4 {
		out.i = g.n / 2;
		out.ok = true;
		out.s.clear();
		format(out.s, "pairs already unique count ", g.n / 2);
		return out;
	}
	var new_res = [0; 512];
	var new_n = 0;
	var i = 0;
	while i + 1 < g.n {
		let a = g.res[i];
		let b = g.res[i + 1];
		var is_dup = false;
		if new_n >= 2 {
			if new_res[new_n - 2] == a && new_res[new_n - 1] == b {
				is_dup = true;
			}
		}
		if !is_dup {
			new_res[new_n] = a;
			new_n++;
			new_res[new_n] = b;
			new_n++;
		}
		i += 2;
	}
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n / 2;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped duplicate pairs leaving ", new_n / 2, " pairs");
	out
}
@end
