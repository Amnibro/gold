expect: => i=8 r=0.0 ok=true s="tally joined: 8" errors=0 n=8 res=[4,4,4,4,4,4,4,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let tgt = ${target};
	let lim = ${retry_limit};
	var tally = 0;
	for i in g.n {
		if g.res[i] == tgt {
			tally++;
		}
	}
	var retries = 0;
	while tally < lim && retries < 3 {
		retries++;
		gold_push(g, tgt);
		tally++;
	}
	out.i = tally;
	out.s.clear();
	format(out.s, "tally joined: ", tally);
	out
}
@end
