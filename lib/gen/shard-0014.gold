expect: => i=3 r=0.0 ok=true s="ranked suffix count: 3" errors=0 n=4 res=[10,3,2,1] cache=0 hits=0
test: list=100,5,25,15,35 count=4
expect: => i=4 r=0.0 ok=true s="ranked suffix count: 4" errors=0 n=5 res=[100,1,3,2,4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let k = ${count};
	let start = if k > g.n { 0 } else { g.n - k };
	let len = g.n - start;
	var orig: int[512] = [0; 512];
	for i in len {
		orig[i] = g.res[start + i];
	}
	for i in len {
		var rank = 1;
		for j in len {
			if orig[j] < orig[i] {
				rank++;
			}
		}
		g.res[start + i] = rank;
	}
	out.i = len;
	out.s.clear();
	format(out.s, "ranked suffix count: ", len);
	out
}
@end
@entry ada339122bcc9546
kind: step
verb: limit
noun: digits
modifier: pairwise
context: aggregate
phrase: limit pairwise digit differences to {max_diff}
phrase: clamp adjacent item differences to {max_diff}
slot: max_diff int
test: list=10,25,28,45 max_diff=5
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[10,15,20,25] cache=0 hits=0
test: list=5,20,35,40 max_diff=8
expect: => i=4 r=0.0 ok=true s="" errors=0 n=4 res=[5,13,21,29] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let md = ${max_diff};
	if g.n < 2 { return out; }
	for i in 1..g.n {
		let prev = g.res[i - 1];
		let cur = g.res[i];
		let diff = cur - prev;
		if diff > md {
			g.res[i] = prev + md;
		} else if diff < -md {
			g.res[i] = prev - md;
		}
	}
	out.i = g.n;
	g.steps += g.n + 1;
	out
}
@end
