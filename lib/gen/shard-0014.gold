	}
	for k in new_n {
		g.res[k] = new_res[k];
	}
	g.n = new_n;
	g.steps += new_n;
	out.i = new_n;
	out.ok = true;
	out.s.clear();
	format(out.s, "dropped alternate pairs leaving ", new_n);
	out
}
