	var sum = 0;
	var i = 0;
	while i < count {
		sum += g.res[i];
		i++;
	}
	if count > 0 {
		g.res[0] = sum;
		var j = count;
		var w = 1;
		while j < g.n {
			g.res[w] = g.res[j];
			w++;
			j++;
		}
		g.n = w;
	}
	g.steps += g.n;
	out.i = sum;
	out.s.clear();
	format(out.s, "folded head nested sum: ", sum);
	out
}
