@entry b0345389bbd2a662
kind: step
verb: sum
noun: runs
modifier: safely
context: search
slot: max_sum int
phrase: search sum runs safely limit {max_sum}
phrase: accumulate equal query runs safely ceiling {max_sum}
test: list=5,5,5,2,2 max_sum=12
expect: => i=2 r=0.0 ok=true s="summed runs into 2 bounded items" errors=0 n=2 res=[12,4] cache=0 hits=0
test: list=1,2,3 max_sum=10
expect: => i=3 r=0.0 ok=true s="summed runs into 3 bounded items" errors=0 n=3 res=[1,2,3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let ms = ${max_sum};
	if g.n == 0 { return out; }
	var new_n = 0;
	var cur_val = g.res[0];
	var cur_sum = cur_val;
	var i = 1;
	while i < g.n {
		if g.res[i] == cur_val {
			cur_sum += cur_val;
		} else {
			if cur_sum > ms { cur_sum = ms; }
			g.res[new_n] = cur_sum;
			new_n++;
			cur_val = g.res[i];
			cur_sum = cur_val;
		}
		i++;
	}
	if cur_sum > ms { cur_sum = ms; }
	g.res[new_n] = cur_sum;
	new_n++;
	g.steps += g.n + 1;
	g.n = new_n;
	out.i = new_n;
	out.s.clear();
	format(out.s, "summed runs into ", new_n, " bounded items");
	out
}
@end
