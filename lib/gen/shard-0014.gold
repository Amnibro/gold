slot: lo int
slot: hi int
test: list=5,4,3,2,1 lo=1 hi=3
expect: => i=3 r=0.0 ok=true s="sorted 3 items between indices" errors=0 n=5 res=[5,2,3,4,1] cache=0 hits=0
test: list=1,2 lo=2 hi=4
expect: => i=0 r=0.0 ok=false s="" errors=1 n=2 res=[1,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let lo = ${lo};
	let hi = ${hi};
	if lo < 0 || hi >= g.n || lo >= hi {
		gold_fail(g, "invalid bounds for sorting");
		out.ok = false;
		return out;
	}
	for i in (hi - lo + 1) {
		for j in (hi - lo - i) {
			let idx = lo + j;
			if g.res[idx] > g.res[idx + 1] {
				let tmp = g.res[idx];
				g.res[idx] = g.res[idx + 1];
				g.res[idx + 1] = tmp;
			}
		}
	}
	g.steps += (hi - lo + 1);
	out.i = hi - lo + 1;
	out.ok = true;
	out.s.clear();
	format(out.s, "sorted ", out.i, " items between indices");
	out
}
@end
