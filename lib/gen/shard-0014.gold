expect: => i=6 r=0.0 ok=true s="top_diff: 15 - 9 = 6" errors=0 n=4 res=[4,9,9,15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var first_max = -1;
	var second_max = -1;
	for i in g.n {
		let x = g.res[i];
		if x > first_max {
			second_max = first_max;
			first_max = x;
		} else if x < first_max && x > second_max {
			second_max = x;
		}
	}
	let diff = first_max - second_max;
	out.s.clear();
	format(out.s, "top_diff: ", first_max, " - ", second_max, " = ", diff);
	out.i = diff;
	g.steps += g.n + 1;
	out
}
@end
@entry e8bcc7ed9b5aa9a3
kind: step
verb: normalize
noun: odds
modifier: sorted
context: format
phrase: format sorted odd numbers string
phrase: render odd elements in sorted order
test: list=9,2,5,3,8,1
expect: => i=4 r=0.0 ok=true s="odds:[1,3,5,9]" errors=0 n=6 res=[9,2,5,3,8,1] cache=0 hits=0
test: list=11,4,7,15,2
expect: => i=3 r=0.0 ok=true s="odds:[7,11,15]" errors=0 n=5 res=[11,4,7,15,2] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var odds = [0; 64];
	var count = 0;
	for i in g.n {
		let x = g.res[i];
		if x % 2 != 0 && count < 64 {
			odds[count] = x;
			count++;
		}
	}
	var i = 0;
	while i < count {
		var j = i + 1;
		while j < count {
			if odds[j] < odds[i] {
				let tmp = odds[i];
				odds[i] = odds[j];
				odds[j] = tmp;
			}
			j++;
		}
		i++;
	}
	out.s.clear();
	out.s.append("odds:[");
	for k in count {
		if k > 0 { out.s.push(','); }
		format(out.s, odds[k]);
	}
	out.s.push(']');
	out.i = count;
	g.steps += count + 1;
	out
}
@end
