expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "empty list has no histogram");
		out.ok = false;
		return out;
	}
	var uniq int[512] = [0; 512];
	var u_cnt = 0;
	for i in g.n {
		let x = g.res[i];
		var seen = false;
		for j in u_cnt {
			if uniq[j] == x {
				seen = true;
				break;
			}
		}
		if !seen {
			uniq[u_cnt] = x;
			u_cnt++;
		}
	}
	for j in u_cnt {
		g.res[j] = uniq[j];
	}
	g.n = u_cnt;
	g.steps += u_cnt;
	out.i = u_cnt;
	out.ok = true;
	out.s.clear();
	format(out.s, "retained ", u_cnt, " unique values");
	out
}
@end
