@entry cb97a008e1db6135
kind: step
verb: normalize
noun: average
modifier: until
context: retry
phrase: normalize average until mean drops below {target}
phrase: scale down average until below target value {target}
slot: target int
test: list=20,40 target=25
expect: => i=15 r=0.0 ok=true s="normalized average to target" errors=0 n=2 res=[10,20] cache=0 hits=0
test: list= target=25
expect: => i=0 r=0.0 ok=false s="cannot normalize average of empty list" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let target = ${target};
	if g.n == 0 {
		gold_fail(g, "cannot normalize average of empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "cannot normalize average of empty list");
		return out;
	}
	var sum = 0;
	for k in g.n {
		sum += g.res[k];
	}
	var avg = sum / g.n;
	var loops = 0;
	while avg >= target && loops < 10 {
		sum = 0;
		for k in g.n {
			g.res[k] = g.res[k] / 2;
			sum += g.res[k];
		}
		avg = sum / g.n;
		loops++;
	}
	g.steps += loops;
	out.i = avg;
	out.ok = true;
	out.s.clear();
	format(out.s, "normalized average to target");
	out
}
@end
