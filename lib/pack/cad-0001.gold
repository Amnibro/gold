@entry c0e48e92628eda7e
kind: step
verb: bevel
noun: part
modifier: edges
context: cad
phrase: bevel the last item edges by {a}
phrase: chamfer the edges of the last item {a}
slot: a real
test: a=0.01 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=2 r=0.0 ok=true s="bevel" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1 b0.01
test: a=0.002 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=2 r=0.0 ok=true s="bevel" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1 b0.002
test: a=1.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	let k = gold_dfind(g);
	if k < 0 { gold_fail(g, "no item yet"); out.ok = false; return out; }
	o.push(' ');
	o.append("b");
	gold_fnum(o, ${a});
	gold_dappend(g, k, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "bevel");
	out
}
@end

