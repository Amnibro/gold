@entry 20e4546a8e88152c
kind: step
verb: drill
noun: part
modifier: hole row
context: cad
phrase: drill a row of {n} holes spaced {a} radius {r}
phrase: line of {n} holes every {a} with radius {r}
slot: n int
slot: a real
slot: r real
test: n=5 a=0.2 r=0.05 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="holerow" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: holes3 cyl 0,0,-1 0,0,1 r0.05 - a5:0.2,0,0
test: n=3 a=0.5 r=0.1 doc="rock sphere -2,1,.4 r.4|post cyl 0,0,0 0,0,2 r.1"
expect: => i=3 r=0.0 ok=true s="holerow" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock sphere -2,1,.4 r.4
expect: => doc: post cyl 0,0,0 0,0,2 r.1
expect: => doc: holes3 cyl 0,0,-1 0,0,1 r0.1 - a3:0.5,0,0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "holes", "", o);
	o.append(" cyl ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",-");
	o.append("1");
	o.append(" ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	o.append("1");
	o.append(" r");
	gold_fnum(o, ${r});
	o.append(" - a");
	format(o, ${n});
	o.append(":");
	gold_fnum(o, ${a});
	o.append(",");
	o.append("0");
	o.append(",");
	o.append("0");
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "holerow");
	out
}
@end

