expect: => i=0 r=0.0 ok=true s="subk prime" errors=0 n=9 res=[-2,9,-15,36,100,7,1,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if core_is_prime(x) { g.res[q] = x - ${k}; }
	}
	out.s.clear();
	format(out.s, "subk prime");
	out
}
@end

@entry dfb5c28e2665342d
kind: step
verb: sign
noun: results
modifier: square
context: list
phrase: replace the perfect square results with their signs
phrase: take the sign of only numbers that are perfect squares
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="sign square" errors=0 n=9 res=[3,-4,10,7,1,0,1,8,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="sign square" errors=0 n=9 res=[2,1,-15,1,1,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if core_is_square(x) { g.res[q] = if x > 0 { 1 } else if x < 0 { -1 } else { 0 }; }
	}
	out.s.clear();
	format(out.s, "sign square");
	out
}
@end

