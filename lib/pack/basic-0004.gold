@entry ff2f7e015358aee2
kind: step
verb: first
noun: results
modifier: above
context: aggregate
phrase: first of results above {t}
phrase: earliest of the numbers greater than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=121 r=0.0 ok=true s="first above" errors=0 n=1 res=[121] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=9 r=0.0 ok=true s="first above" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 > ${t} {
			let x = x0;
			if cnt == 0 { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "first above none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "first above");
	out
}
@end

@entry ff521c7bbceb4a7a
kind: step
verb: range
noun: results
modifier: mult5
context: aggregate
phrase: range of results divisible by five
phrase: spread of the numbers that are multiples of five
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=25 r=0.0 ok=true s="range mult5" errors=0 n=1 res=[25] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=115 r=0.0 ok=true s="range mult5" errors=0 n=1 res=[115] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 5 == 0 {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range mult5 none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range mult5");
	out
}
@end

