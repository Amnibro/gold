@entry f194426715e8d7c2
kind: step
verb: sort
noun: words
modifier: wsort
context: words
phrase: sort the words
phrase: alphabetize the word list
test: words=apple,kiwi,banana,kiwi
expect: => i=0 r=0.0 ok=true s="wsort" errors=0 n=0 res=[] cache=0 hits=0
expect: => words=[apple,banana,kiwi,kiwi]
test: words=zeta,alpha,mu
expect: => i=0 r=0.0 ok=true s="wsort" errors=0 n=0 res=[] cache=0 hits=0
expect: => words=[alpha,mu,zeta]
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.wn { for b in g.wn - 1 - a {
		let p = g.wl[b];
		let r = g.wl[b + 1];
		var d = 0;
		while d < p.len && d < r.len && p[d] == r[d] { d++; }
		let sw = if d < p.len && d < r.len { p[d] > r[d] } else { p.len > r.len };
		if sw { g.wl[b] = r; g.wl[b + 1] = p; }
	} }
	out.s.clear();
	format(out.s, "wsort");
	out
}
@end

@entry f194f0d9a4b95bfd
kind: step
verb: median
noun: results
modifier: overhundred
context: aggregate
phrase: median of results over a hundred
phrase: middle value of the numbers greater than one hundred
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=121 r=121.0 ok=true s="median overhundred" errors=0 n=1 res=[121] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=false s="median overhundred none" errors=1 n=9 res=[2,9,-15,36,100,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 > 100 {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "median overhundred none"); return out; }
	for a in cnt { for b in cnt - 1 - a { if tmp[b] > tmp[b + 1] { let s = tmp[b]; tmp[b] = tmp[b + 1]; tmp[b + 1] = s; } } }
	acc = tmp[(cnt - 1) / 2];
	out.r = if cnt % 2 == 1 { tmp[cnt / 2] as real } else { (tmp[cnt / 2 - 1] + tmp[cnt / 2]) as real / 2.0 };
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "median overhundred");
	out
}
@end

