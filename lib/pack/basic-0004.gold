code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var at = -1;
	for q in g.n { let x = g.res[q]; if at < 0 && x % 2 == 0 { at = q; } }
	gold_clear(g);
	gold_push(g, at);
	out.i = at;
	out.s.clear();
	format(out.s, "index even");
	out
}
@end

@entry e000edd7ccaf5d00
kind: step
verb: max
noun: results
modifier: zero digitsum
context: aggregate
phrase: maximum of digit summed zero results
phrase: largest of the digit summed values of the numbers equal to zero
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="max digitsum zero" errors=0 n=1 res=[0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=false s="max digitsum zero none" errors=1 n=9 res=[2,9,-15,36,100,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 == 0 {
			let x = core_digit_sum(x0);
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max digitsum zero none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max digitsum zero");
	out
}
@end

