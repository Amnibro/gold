@entry e47dbde5272b9098
kind: step
verb: median
noun: results
modifier: square
context: aggregate
phrase: median of perfect square results
phrase: middle value of the numbers that are perfect squares
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=25 r=25.0 ok=true s="median square" errors=0 n=1 res=[25] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=9 r=22.5 ok=true s="median square" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if core_is_square(x0) {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "median square none"); return out; }
	for a in cnt { for b in cnt - 1 - a { if tmp[b] > tmp[b + 1] { let s = tmp[b]; tmp[b] = tmp[b + 1]; tmp[b + 1] = s; } } }
	acc = tmp[(cnt - 1) / 2];
	out.r = if cnt % 2 == 1 { tmp[cnt / 2] as real } else { (tmp[cnt / 2 - 1] + tmp[cnt / 2]) as real / 2.0 };
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "median square");
	out
}
@end

