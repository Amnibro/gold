fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${k} == 0 { gold_fail(g, "divide by zero"); out.ok = false; return out; }
	for q in g.n {
		let x = g.res[q];
		if core_is_palindrome(x) { g.res[q] = x % ${k}; }
	}
	out.s.clear();
	format(out.s, "modk palindrome");
	out
}
@end

