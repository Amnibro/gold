code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = 0;
	for q in g.n { let x = g.res[q]; if x > 100 { c++; } }
	out.ok = c == g.n;
	out.i = if out.ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all overhundred");
	out
}
@end

