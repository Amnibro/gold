@entry df85d7baa18e018f
kind: step
verb: replace
noun: results
modifier: below
context: query
phrase: replace results below {t} with {k}
phrase: set numbers less than {t} to {k}
slot: k int
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 k=3 t=10
expect: => i=0 r=0.0 ok=true s="replace below" errors=0 n=9 res=[3,3,10,3,121,3,25,3,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 k=4 t=7
expect: => i=0 r=0.0 ok=true s="replace below" errors=0 n=9 res=[4,9,4,36,100,11,4,4,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n { let x = g.res[q]; if x < ${t} { g.res[q] = ${k}; } }
	out.s.clear();
	format(out.s, "replace below");
	out
}
@end

@entry df97d2779c4e3b79
