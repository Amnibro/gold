expect: => doc: crown2 sphere 2,1,3 r1.05 nz.05:.3 m:matte #3f7f3a
test: x=-3.0 y=4.0 h=5.0 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=4 r=0.0 ok=true s="tree" errors=0 n=0 res=[] cache=0 hits=0
