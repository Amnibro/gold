@entry 0ae39a9ad77d06cb
kind: step
verb: scatter
noun: terrain
modifier: trees
context: env
phrase: scatter {n} trees over {a} meters with seed {u}
phrase: plant a grove of {n} trees across {a} meters seed {u}
slot: n int
slot: a real
slot: u int
test: n=5 a=10.0 u=3
expect: => i=5 r=0.0 ok=true s="forest" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: tree1 cone -1.206,-7.92,.5 -1.206,-7.92,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree2 cone 2.621,-0.783,.5 2.621,-0.783,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree3 cone -3.175,-3.269,.5 -3.175,-3.269,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree4 cone 1.405,4.621,.5 1.405,4.621,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree5 cone -3.638,2.887,.5 -3.638,2.887,3 r.8 nz.05:.3 m:matte #2f5f3a
test: n=8 a=15.0 u=9 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=8 r=0.0 ok=true s="forest" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: tree3 cone 9.124,-7.858,.5 9.124,-7.858,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree4 cone 0.853,-11.164,.5 0.853,-11.164,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree5 cone 8.147,1.095,.5 8.147,1.095,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree6 cone 1.005,-1.082,.5 1.005,-1.082,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree7 cone 9.429,12.306,.5 9.429,12.306,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree8 cone 3.416,11.258,.5 3.416,11.258,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree9 cone 12.969,-4.224,.5 12.969,-4.224,3 r.8 nz.05:.3 m:matte #2f5f3a
expect: => doc: tree10 cone 8.086,-4.143,.5 8.086,-4.143,3 r.8 nz.05:.3 m:matte #2f5f3a
test: n=0 a=1.0 u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 24 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${a};
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * ${a};
		o.clear();
		gold_dnews(g, "tree", "", o);
		o.append(" cone ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",.");
		o.append("5");
		o.append(" ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		o.append("3");
		o.append(" r.");
		o.append("8");
		o.append(" nz.");
		o.append("05");
		o.append(":.");
		o.append("3");
		o.append(" m:matte ");
		gold_hex(o, 47, 95, 58);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "forest");
	out
}
@end

