phrase: scatter {n} rocks of size {r} over {a} meters with seed {u}
phrase: strew {n} stones radius {r} across {a} meters seed {u}
slot: n int
slot: r real
slot: a real
slot: u int
test: n=4 r=0.3 a=5.0 u=7
expect: => i=4 r=0.0 ok=true s="rocks" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: rock1 sphere 4.499,2.939,0.15 r0.3 nz.04:.2 m:matte #8a8580
expect: => doc: rock2 sphere -0.035,0.061,0.15 r0.3 nz.04:.2 m:matte #8a8580
expect: => doc: rock3 sphere 0.62,2.371,0.15 r0.3 nz.04:.2 m:matte #8a8580
expect: => doc: rock4 sphere -3.537,-0.131,0.15 r0.3 nz.04:.2 m:matte #8a8580
test: n=6 r=0.2 a=8.0 u=11 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=6 r=0.0 ok=true s="rocks" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: rock3 sphere 3.591,3.972,0.1 r0.2 nz.04:.2 m:matte #8a8580
expect: => doc: rock4 sphere 2.022,5.051,0.1 r0.2 nz.04:.2 m:matte #8a8580
expect: => doc: rock5 sphere -7.245,-1.568,0.1 r0.2 nz.04:.2 m:matte #8a8580
expect: => doc: rock6 sphere 7.789,0.113,0.1 r0.2 nz.04:.2 m:matte #8a8580
expect: => doc: rock7 sphere -0.877,-5.904,0.1 r0.2 nz.04:.2 m:matte #8a8580
expect: => doc: rock8 sphere -1.241,-3.621,0.1 r0.2 nz.04:.2 m:matte #8a8580
test: n=40 r=0.3 a=5.0 u=7
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 24 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	for q in ${n} {
		let px = (gold_hash01(q, 1, ${u}) * 2.0 - 1.0) * ${a};
		let py = (gold_hash01(q, 2, ${u}) * 2.0 - 1.0) * ${a};
		o.clear();
		gold_dnews(g, "rock", "", o);
		o.append(" sphere ");
		gold_fnum(o, px);
		o.append(",");
		gold_fnum(o, py);
		o.append(",");
		gold_fnum(o, ${r} * 0.5);
		o.append(" r");
		gold_fnum(o, ${r});
		o.append(" nz.");
		o.append("04");
		o.append(":.");
		o.append("2");
		o.append(" m:matte ");
		gold_hex(o, 138, 133, 128);
		gold_doc(g, o);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "rocks");
	out
}
@end

