expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: trunk3 cyl -3,4,0 -3,4,5 r0.25 m:matte #6b4a2b
expect: => doc: crown4 sphere -3,4,5 r1.75 nz.05:.3 m:matte #3f7f3a
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "trunk", "", o);
	o.append(" cyl ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	o.append("0");
	o.append(" ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${h} * 0.05);
	o.append(" m:matte ");
	gold_hex(o, 107, 74, 43);
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "crown", "", o);
	o.append(" sphere ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" r");
	gold_fnum(o, ${h} * 0.35);
	o.append(" nz.");
	o.append("05");
	o.append(":.");
	o.append("3");
	o.append(" m:matte ");
	gold_hex(o, 63, 127, 58);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "tree");
	out
}
@end

