fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 <= ${t} {
			let x = x0;
			if cnt == 0 { acc = x; } else { acc *= x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { acc = 1; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "product atmost");
	out
}
@end

