code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.vn == 0 { return out; }
	var lo = g.vl[0];
	var hi = g.vl[0];
	for q in g.vn { let p = g.vl[q]; lo = gold_v3(min(lo.x, p.x), min(lo.y, p.y), min(lo.z, p.z)); hi = gold_v3(max(hi.x, p.x), max(hi.y, p.y), max(hi.z, p.z)); }
	g.vl[0] = lo;
	g.vl[1] = hi;
	g.vn = 2;
	out.s.clear();
	format(out.s, "vbbox");
	out
}
@end

