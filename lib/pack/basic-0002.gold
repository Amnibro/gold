fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${k} < 0 || ${k} > g.n || g.n >= 512 { gold_fail(g, "position out of range"); out.ok = false; out.s.clear(); format(out.s, "insertat out of range"); return out; }
	var q = g.n;
	while q > ${k} { g.res[q] = g.res[q - 1]; q--; }
	g.res[${k}] = ${t};
	g.n++;
	out.s.clear();
	format(out.s, "insertat");
	out
}
@end

