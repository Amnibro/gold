@entry 585a3f79c3a609d4
kind: step
verb: average
noun: results
modifier: below
context: aggregate
phrase: average of results below {t}
phrase: mean of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=2 r=2.8 ok=true s="average below" errors=0 n=1 res=[2] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=-1 r=-1.75 ok=true s="average below" errors=0 n=1 res=[-1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average below none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average below");
	out
}
@end

