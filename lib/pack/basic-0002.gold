@entry 68aff07ed1f37290
kind: step
verb: average
noun: results
modifier: between digitsum
context: aggregate
phrase: average of digit summed results between {lo} and {hi}
phrase: mean of the digit summed values of the numbers from {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=3 r=3.8333333333333335 ok=true s="average digitsum between" errors=0 n=1 res=[3] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 lo=5 hi=40
expect: => i=6 r=6.25 ok=true s="average digitsum between" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 >= ${lo} && x0 <= ${hi} {
			let x = core_digit_sum(x0);
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average digitsum between none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average digitsum between");
	out
}
@end

