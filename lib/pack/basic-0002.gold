		if ${t} != 0 && x0 % ${t} == 0 {
			let x = x0 * x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average square divby none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average square divby");
	out
}
@end

@entry 96fa3a52eaf91e7c
kind: step
