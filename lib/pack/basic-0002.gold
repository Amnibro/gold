@entry 4cfa921f2c8a8eb6
kind: step
verb: dec
noun: results
modifier: single
context: list
phrase: decrement the single digit results
phrase: subtract one from only numbers with one digit
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="dec single" errors=0 n=9 res=[2,-5,10,6,121,-1,25,7,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="dec single" errors=0 n=9 res=[1,8,-15,36,100,11,4,0,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if x > -10 && x < 10 { g.res[q] = x - 1; }
	}
	out.s.clear();
	format(out.s, "dec single");
	out
}
@end

@entry 4d058b6c8e5a052c
kind: step
verb: min
noun: results
modifier: negative cube
context: aggregate
phrase: minimum of cubed negative results
phrase: smallest of the cubed values of the numbers below zero
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=-64 r=0.0 ok=true s="min cube negative" errors=0 n=1 res=[-64] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=-3375 r=0.0 ok=true s="min cube negative" errors=0 n=1 res=[-3375] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < 0 {
			let x = x0 * x0 * x0;
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min cube negative none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min cube negative");
	out
}
@end

