@entry 8a9869224bf49ede
kind: step
verb: normalize
noun: results
modifier: results
context: list
phrase: normalize results between {lo} and {hi}
phrase: rescale the numbers from {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=0 r=0.0 ok=true s="normalize" errors=0 n=9 res=[1,0,2,1,20,0,4,1,2] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 lo=5 hi=40
expect: => i=0 r=0.0 ok=true s="normalize" errors=0 n=9 res=[10,12,5,20,40,12,11,9,22] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { out.s.clear(); format(out.s, "normalize"); return out; }
	var mx = g.res[0];
	var mn = g.res[0];
	for q in g.n { if g.res[q] > mx { mx = g.res[q]; } if g.res[q] < mn { mn = g.res[q]; } }
	for q in g.n { g.res[q] = if mx == mn { ${lo} } else { ${lo} + (g.res[q] - mn) * (${hi} - ${lo}) / (mx - mn) }; }
	out.s.clear();
	format(out.s, "normalize");
	out
}
@end

