@entry 8dc1898d37494159
kind: step
verb: median
noun: results
modifier: below
context: aggregate
phrase: median of results below {t}
phrase: middle value of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=3 r=3.0 ok=true s="median below" errors=0 n=1 res=[3] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=1 r=1.5 ok=true s="median below" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "median below none"); return out; }
	for a in cnt { for b in cnt - 1 - a { if tmp[b] > tmp[b + 1] { let s = tmp[b]; tmp[b] = tmp[b + 1]; tmp[b + 1] = s; } } }
	acc = tmp[(cnt - 1) / 2];
	out.r = if cnt % 2 == 1 { tmp[cnt / 2] as real } else { (tmp[cnt / 2 - 1] + tmp[cnt / 2]) as real / 2.0 };
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "median below");
	out
}
@end

