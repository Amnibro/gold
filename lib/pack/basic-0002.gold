@entry 87c8d470bda4fe39
kind: step
verb: min
noun: results
modifier: between cube
context: aggregate
phrase: minimum of cubed results between {lo} and {hi}
phrase: smallest of the cubed values of the numbers from {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=0 r=0.0 ok=true s="min cube between" errors=0 n=1 res=[0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 lo=5 hi=40
expect: => i=125 r=0.0 ok=true s="min cube between" errors=0 n=1 res=[125] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 >= ${lo} && x0 <= ${hi} {
			let x = x0 * x0 * x0;
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min cube between none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min cube between");
	out
}
@end

