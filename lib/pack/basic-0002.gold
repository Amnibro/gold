@entry 83b89feadbe0940c
kind: step
verb: max
noun: results
modifier: mult3 double
context: aggregate
phrase: maximum of doubled results divisible by three
phrase: largest of the doubled values of the numbers that are multiples of three
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=6 r=0.0 ok=true s="max double mult3" errors=0 n=1 res=[6] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=72 r=0.0 ok=true s="max double mult3" errors=0 n=1 res=[72] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 3 == 0 {
			let x = x0 * 2;
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max double mult3 none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max double mult3");
	out
}
@end

