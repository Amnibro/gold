fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 >= ${lo} && x0 <= ${hi} {
			let x = core_digit_sum(x0);
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max digitsum between none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max digitsum between");
	out
}
@end

