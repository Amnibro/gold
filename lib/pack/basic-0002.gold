code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.kn { if !(g.kl[q].tag == ${w}) { g.kl[m] = g.kl[q]; m++; } }
	g.kn = m;
	out.s.clear();
	format(out.s, "ktagdrop");
	out
}
@end

