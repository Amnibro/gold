kind: step
verb: range
noun: results
modifier: prime
context: aggregate
phrase: range of prime results
phrase: spread of the numbers that are prime
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=10 r=0.0 ok=true s="range prime" errors=0 n=1 res=[10] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=9 r=0.0 ok=true s="range prime" errors=0 n=1 res=[9] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if core_is_prime(x0) {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range prime none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range prime");
	out
}
@end

