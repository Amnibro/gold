expect: => i=0 r=0.0 ok=true s="firstk above" errors=0 n=4 res=[9,36,100,11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n { let x = g.res[q]; if m < ${k} && x > ${t} { g.res[m] = x; m++; } }
	g.n = m;
	out.s.clear();
	format(out.s, "firstk above");
	out
}
@end

