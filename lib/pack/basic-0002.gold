fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if x > 0 { g.res[q] = core_abs_val(x); }
	}
	out.s.clear();
	format(out.s, "abs positive");
	out
}
@end

