@entry 6a78e68c5c4fa7d3
kind: step
verb: min
noun: results
modifier: even double
context: aggregate
phrase: minimum of doubled even results
phrase: smallest of the doubled values of the numbers that are even
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=-8 r=0.0 ok=true s="min double even" errors=0 n=1 res=[-8] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=4 r=0.0 ok=true s="min double even" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 2 == 0 {
			let x = x0 * 2;
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min double even none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min double even");
	out
}
@end

