fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = min(max(${k}, 0), g.n);
	for q in g.n - st { g.res[q] = g.res[q + st]; }
	g.n = g.n - st;
	out.s.clear();
	format(out.s, "dropfirst");
	out
}
@end

