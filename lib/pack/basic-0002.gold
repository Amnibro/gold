@entry 7084f3f3957974cd
kind: step
verb: range
noun: results
modifier: all cube
context: aggregate
phrase: range of cubed results
phrase: spread of the cubed values of the numbers
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=1771625 r=0.0 ok=true s="range cube" errors=0 n=1 res=[1771625] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=1003375 r=0.0 ok=true s="range cube" errors=0 n=1 res=[1003375] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if true {
			let x = x0 * x0 * x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range cube none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range cube");
	out
}
@end

