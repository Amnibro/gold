fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var last = 0;
	for c in g.mn { var best = -1; for i in 128 { if g.mu[i] && (c == 0 || g.mk[i] > last) && (best < 0 || g.mk[i] < g.mk[best]) { best = i; } } if best >= 0 { gold_push(g, g.mk[best]); last = g.mk[best]; } }
	out.s.clear();
	format(out.s, "mkeys");
	out
}
@end

