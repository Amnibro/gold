code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.n { for b in g.n - 1 - a { if core_digit_sum(g.res[b]) > core_digit_sum(g.res[b + 1]) { let s = g.res[b]; g.res[b] = g.res[b + 1]; g.res[b + 1] = s; } } }
	out.s.clear();
	format(out.s, "sortdigits");
	out
}
@end

