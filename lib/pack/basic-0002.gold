code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let x = v.i;
	if x % 3 == 0 { out.i = x * 4; }
	out.s.clear();
	format(out.s, "value quadruple mult3");
	out
}
@end

@entry 4d63d17534b90dec
kind: step
verb: min
noun: results
modifier: palindrome abs
context: aggregate
phrase: minimum of absolute palindromic results
phrase: smallest of the absolute values of the numbers that read the same reversed
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="min abs palindrome" errors=0 n=1 res=[0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=1 r=0.0 ok=true s="min abs palindrome" errors=0 n=1 res=[1] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if core_is_palindrome(x0) {
			let x = core_abs_val(x0);
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min abs palindrome none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min abs palindrome");
	out
}
@end

@entry 4d95db082af8b940
kind: step
verb: firstk
noun: results
modifier: above
context: query
phrase: take the first {k} results above {t}
phrase: keep the first {k} of the numbers greater than {t}
slot: k int
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 k=3 t=10
expect: => i=0 r=0.0 ok=true s="firstk above" errors=0 n=3 res=[121,25,13] cache=0 hits=0
