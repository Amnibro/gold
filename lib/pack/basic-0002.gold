expect: => i=0 r=0.0 ok=true s="removeat" errors=0 n=8 res=[3,-4,10,121,0,25,8,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 k=4
expect: => i=0 r=0.0 ok=true s="removeat" errors=0 n=8 res=[2,9,-15,36,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if ${k} < 0 || ${k} >= g.n { gold_fail(g, "position out of range"); out.ok = false; out.s.clear(); format(out.s, "removeat out of range"); return out; }
	for q in g.n - 1 - ${k} { g.res[${k} + q] = g.res[${k} + q + 1]; }
	g.n--;
	out.s.clear();
	format(out.s, "removeat");
	out
}
@end

