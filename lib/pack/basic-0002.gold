expect: => i=0 r=0.0 ok=true s="minmax" errors=0 n=2 res=[-15,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { gold_fail(g, "no results"); out.ok = false; return out; }
	var mx = g.res[0];
	var mn = g.res[0];
	for q in g.n { if g.res[q] > mx { mx = g.res[q]; } if g.res[q] < mn { mn = g.res[q]; } }
	gold_clear(g);
	gold_push(g, mn);
	gold_push(g, mx);
	out.s.clear();
	format(out.s, "minmax");
	out
}
@end

