code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n { if g.res[q] != ${k} { g.res[m] = g.res[q]; m++; } }
	g.n = m;
	out.s.clear();
	format(out.s, "removeall");
	out
}
@end

