@entry c81439bcf21b705d
kind: step
verb: dedupe
noun: results
modifier: results
context: list
phrase: remove duplicates
phrase: dedupe results
phrase: keep only unique values
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="dedupe" errors=0 n=9 res=[3,-4,10,7,121,0,25,8,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="dedupe" errors=0 n=9 res=[2,9,-15,36,100,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n {
		var dup = false;
		for p in m { if g.res[p] == g.res[q] { dup = true; } }
		if !dup { g.res[m] = g.res[q]; m++; }
	}
	g.n = m;
	out.s.clear();
	format(out.s, "dedupe");
	out
}
@end

