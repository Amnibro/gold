@entry b88e3ff4ab555eb1
kind: step
verb: range
noun: results
modifier: below
context: aggregate
phrase: range of results below {t}
phrase: spread of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=12 r=0.0 ok=true s="range below" errors=0 n=1 res=[12] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=20 r=0.0 ok=true s="range below" errors=0 n=1 res=[20] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range below none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range below");
	out
}
@end

