fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.rn / 2 { let s = g.rl[a]; g.rl[a] = g.rl[g.rn - 1 - a]; g.rl[g.rn - 1 - a] = s; }
	out.s.clear();
	format(out.s, "rrev");
	out
}
@end

