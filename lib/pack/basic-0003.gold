@entry 982de52fc5010dc4
kind: step
verb: product
noun: results
modifier: nonzero
context: aggregate
phrase: product of nonzero results
phrase: multiply together the numbers that are not zero
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=-264264000 r=0.0 ok=true s="product nonzero" errors=0 n=1 res=[-264264000] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=-2352240000 r=0.0 ok=true s="product nonzero" errors=0 n=1 res=[-2352240000] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 != 0 {
			let x = x0;
			if cnt == 0 { acc = x; } else { acc *= x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { acc = 1; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "product nonzero");
	out
}
@end

