@entry b5a22625ba038bce
kind: step
verb: min
noun: results
modifier: below double
context: aggregate
phrase: minimum of doubled results below {t}
phrase: smallest of the doubled values of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=-8 r=0.0 ok=true s="min double below" errors=0 n=1 res=[-8] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=-30 r=0.0 ok=true s="min double below" errors=0 n=1 res=[-30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = x0 * 2;
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min double below none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min double below");
	out
}
@end

