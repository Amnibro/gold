@entry c1d87ed3e9665707
kind: step
verb: average
noun: results
modifier: mult5
context: aggregate
phrase: average of results divisible by five
phrase: mean of the numbers that are multiples of five
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=11 r=11.666666666666666 ok=true s="average mult5" errors=0 n=1 res=[11] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=30 r=30.0 ok=true s="average mult5" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 5 == 0 {
			let x = x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average mult5 none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average mult5");
	out
}
@end

