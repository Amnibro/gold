test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="adjsum" errors=0 n=8 res=[11,-6,21,136,111,16,6,45] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var tmp = [0; 512];
	var m = 0;
	for q in g.n { if q > 0 { tmp[m] = g.res[q] + g.res[q - 1]; m++; } }
	for q in m { g.res[q] = tmp[q]; }
	g.n = m;
	out.s.clear();
	format(out.s, "adjsum");
	out
}
@end

