expect: => i=30 r=30.5 ok=true s="average double between" errors=0 n=1 res=[30] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 >= ${lo} && x0 <= ${hi} {
			let x = x0 * 2;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average double between none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average double between");
	out
}
@end

