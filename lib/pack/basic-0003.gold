@entry a8a4412c1ae0f05e
kind: step
verb: min
noun: results
modifier: between
context: aggregate
phrase: minimum of results between {lo} and {hi}
phrase: smallest of the numbers from {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=0 r=0.0 ok=true s="min between" errors=0 n=1 res=[0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 lo=5 hi=40
expect: => i=5 r=0.0 ok=true s="min between" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 >= ${lo} && x0 <= ${hi} {
			let x = x0;
			if cnt == 0 || x < acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "min between none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "min between");
	out
}
@end

@entry a8b31e7079bfcfac
kind: step
verb: range
noun: results
modifier: under10
context: aggregate
phrase: range of results under ten
phrase: spread of the numbers less than ten
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=12 r=0.0 ok=true s="range under10" errors=0 n=1 res=[12] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=24 r=0.0 ok=true s="range under10" errors=0 n=1 res=[24] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 < 10 {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range under10 none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range under10");
	out
}
@end

