@entry cd5dd5b575343f6a
kind: step
verb: average
noun: results
modifier: even double
context: aggregate
phrase: average of doubled even results
phrase: mean of the doubled values of the numbers that are even
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=7 r=7.0 ok=true s="average double even" errors=0 n=1 res=[7] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=91 r=91.0 ok=true s="average double even" errors=0 n=1 res=[91] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 2 == 0 {
			let x = x0 * 2;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average double even none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average double even");
	out
}
@end

