code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.rn { if g.rl[q] < 0.0 { gold_fail(g, "negative real"); out.ok = false; out.s.clear(); format(out.s, "rsqrt negative"); return out; } }
	for q in g.rn { g.rl[q] = sqrt(g.rl[q]); }
	out.s.clear();
	format(out.s, "rsqrt");
	out
}
@end

