@entry b184fb6b1f51c2f1
kind: step
verb: average
noun: results
modifier: between double
context: aggregate
phrase: average of doubled results between {lo} and {hi}
phrase: mean of the doubled values of the numbers from {lo} to {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=13 r=13.666666666666666 ok=true s="average double between" errors=0 n=1 res=[13] cache=0 hits=0
