code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.rn == 0 { return out; }
	var mx = g.rl[0];
	var mn = g.rl[0];
	for q in g.rn { if g.rl[q] > mx { mx = g.rl[q]; } if g.rl[q] < mn { mn = g.rl[q]; } }
	for q in g.rn { g.rl[q] = if mx == mn { 0.0 } else { (g.rl[q] - mn) / (mx - mn) }; }
	out.s.clear();
	format(out.s, "rnorm");
	out
}
@end

