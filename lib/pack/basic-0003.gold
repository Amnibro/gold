}
@end

@entry a39763bbf81b65d4
kind: step
verb: average
noun: results
modifier: below digitsum
context: aggregate
phrase: average of digit summed results below {t}
phrase: mean of the digit summed values of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=4 r=4.4 ok=true s="average digitsum below" errors=0 n=1 res=[4] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=3 r=3.5 ok=true s="average digitsum below" errors=0 n=1 res=[3] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = core_digit_sum(x0);
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average digitsum below none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average digitsum below");
	out
}
@end

