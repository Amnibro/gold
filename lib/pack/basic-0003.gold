code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if x % 2 == 0 { g.res[q] = core_digit_sum(x); }
	}
	out.s.clear();
	format(out.s, "digitsum even");
	out
}
@end

