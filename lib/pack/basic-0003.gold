expect: => i=3309 r=3309.0 ok=true s="average square even" errors=0 n=1 res=[3309] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 2 == 0 {
			let x = x0 * x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average square even none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average square even");
	out
}
@end

