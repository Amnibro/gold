fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var t byte[>..] = [];
	for b in v.s { if b != ' ' { t.push(if b >= 'A' && b <= 'Z' { b + 32 } else { b }); } }
	var same = true;
	for q in t.len / 2 { if t[q] != t[t.len - 1 - q] { same = false; } }
	out.ok = same;
	out.i = if same { 1 } else { 0 };
	out
}
@end

