fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n { let x = g.res[q]; if m < ${k} && x % 2 == 0 { g.res[m] = x; m++; } }
	g.n = m;
	out.s.clear();
	format(out.s, "firstk even");
	out
}
@end

@entry c4ec53cd9d198521
kind: step
verb: range
noun: results
modifier: mult10
context: aggregate
phrase: range of results divisible by ten
phrase: spread of the numbers that are multiples of ten
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=10 r=0.0 ok=true s="range mult10" errors=0 n=1 res=[10] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="range mult10" errors=0 n=1 res=[0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 10 == 0 {
			let x = x0;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range mult10 none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range mult10");
	out
}
@end

