fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var q = 0;
	while q + 1 < g.n { let s = g.res[q]; g.res[q] = g.res[q + 1]; g.res[q + 1] = s; q += 2; }
	out.s.clear();
	format(out.s, "swappairs");
	out
}
@end

