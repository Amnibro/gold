@entry a31b4b847e619ec1
kind: step
verb: all
noun: results
modifier: between
context: query
phrase: are all results between {lo} and {hi}
phrase: check whether every number is between {lo} and {hi}
slot: lo int
slot: hi int
test: list=3,-4,10,7,121,0,25,8,13 lo=0 hi=20
expect: => i=0 r=0.0 ok=false s="all between" errors=0 n=9 res=[3,-4,10,7,121,0,25,8,13] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 lo=5 hi=40
expect: => i=0 r=0.0 ok=false s="all between" errors=0 n=9 res=[2,9,-15,36,100,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = 0;
	for q in g.n { let x = g.res[q]; if x >= ${lo} && x <= ${hi} { c++; } }
	out.ok = c == g.n;
	out.i = if out.ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all between");
	out
}
@end

