fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = 0;
	for q in g.n { let x = g.res[q]; if x == 0 { c++; } }
	out.ok = c == g.n;
	out.i = if out.ok { 1 } else { 0 };
	out.s.clear();
	format(out.s, "all zero");
	out
}
@end

@entry 9788fafb89dd4d23
kind: step
verb: sum
noun: results
modifier: divby abs
context: aggregate
phrase: sum of absolute results divisible by {t}
phrase: add up the absolute values of the numbers that are multiples of {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=10 r=0.0 ok=true s="sum abs divby" errors=0 n=1 res=[10] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=0 r=0.0 ok=true s="sum abs divby" errors=0 n=1 res=[0] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if ${t} != 0 && x0 % ${t} == 0 {
			let x = core_abs_val(x0);
			acc += x;
			tot += x;
			cnt++;
		}
	}
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "sum abs divby");
	out
}
@end

