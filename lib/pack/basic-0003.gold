expect: => i=3 r=0.0 ok=true s="the" errors=0 n=0 res=[] cache=0 hits=0
test: text="hello world"
expect: => i=5 r=0.0 ok=true s="hello" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best byte[>..] = [];
	var have = false;
	for w in words(v.s) { if w.len > 0 && (!have || w.len < best.len) { best.clear(); best.append(w); have = true; } }
	gold_text(out, best);
	out.i = best.len;
	out
}
@end

