expect: => i=1 r=0.0 ok=true s="value sign palindrome" errors=0 n=0 res=[] cache=0 hits=0
test: input=12
expect: => i=12 r=0.0 ok=true s="value sign palindrome" errors=0 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let x = v.i;
	if core_is_palindrome(x) { out.i = if x > 0 { 1 } else if x < 0 { -1 } else { 0 }; }
	out.s.clear();
	format(out.s, "value sign palindrome");
	out
}
@end

