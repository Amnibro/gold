code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.vn == 0 { gold_fail(g, "no vectors"); out.ok = false; return out; }
	var t = gold_v3(0.0, 0.0, 0.0);
	for q in g.vn { t = t + g.vl[q]; }
	let n = g.vn as real;
	g.vl[0] = gold_v3(t.x / n, t.y / n, t.z / n);
	g.vn = 1;
	out.s.clear();
	format(out.s, "vcentroid");
	out
}
@end

