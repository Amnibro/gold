@entry 98893d6585765813
kind: step
verb: average
noun: results
modifier: under10 abs
context: aggregate
phrase: average of absolute results under ten
phrase: mean of the absolute values of the numbers less than ten
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=4 r=4.4 ok=true s="average abs under10" errors=0 n=1 res=[4] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=6 r=6.4 ok=true s="average abs under10" errors=0 n=1 res=[6] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < 10 {
			let x = core_abs_val(x0);
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average abs under10 none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average abs under10");
	out
}
@end

