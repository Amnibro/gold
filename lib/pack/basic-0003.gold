expect: => i=4 r=4.222222222222222 ok=true s="average digitsum" errors=0 n=1 res=[4] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=4 r=4.777777777777778 ok=true s="average digitsum" errors=0 n=1 res=[4] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if true {
			let x = core_digit_sum(x0);
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average digitsum none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average digitsum");
	out
}
@end

