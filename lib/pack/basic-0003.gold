fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 != 0 {
			let x = core_digit_sum(x0);
			acc += x;
			tot += x;
			cnt++;
		}
	}
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "sum digitsum nonzero");
	out
}
@end

