verb: max
noun: results
modifier: overhundred cube
context: aggregate
phrase: maximum of cubed results over a hundred
phrase: largest of the cubed values of the numbers greater than one hundred
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=1771561 r=0.0 ok=true s="max cube overhundred" errors=0 n=1 res=[1771561] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=false s="max cube overhundred none" errors=1 n=9 res=[2,9,-15,36,100,11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 > 100 {
			let x = x0 * x0 * x0;
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max cube overhundred none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max cube overhundred");
	out
}
@end

@entry cacb87074387134f
