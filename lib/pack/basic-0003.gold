fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n { let x = g.res[q]; if ${t} != 0 && x % ${t} == 0 { g.res[q] = ${k}; } }
	out.s.clear();
	format(out.s, "replace divby");
	out
}
@end

@entry df6dffb6171196ef
kind: step
verb: average
noun: results
modifier: square square
context: aggregate
phrase: average of squared perfect square results
phrase: mean of the squared values of the numbers that are perfect squares
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=5088 r=5088.666666666667 ok=true s="average square square" errors=0 n=1 res=[5088] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=2844 r=2844.5 ok=true s="average square square" errors=0 n=1 res=[2844] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if core_is_square(x0) {
			let x = x0 * x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average square square none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average square square");
	out
}
@end

