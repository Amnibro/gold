fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.wn { var dup = false; for p in m { if g.wl[p] == g.wl[q] { dup = true; } } if !dup { g.wl[m] = g.wl[q]; m++; } }
	g.wn = m;
	out.s.clear();
	format(out.s, "wdedupe");
	out
}
@end

