@entry 1b8393cd9c3c27fc
kind: step
verb: rotate
noun: results
modifier: right
context: list
phrase: rotate results right by {k}
phrase: shift the list right {k} places
slot: k int
test: list=3,-4,10,7,121,0,25,8,13 k=3
expect: => i=0 r=0.0 ok=true s="rotr" errors=0 n=9 res=[25,8,13,3,-4,10,7,121,0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 k=4
expect: => i=0 r=0.0 ok=true s="rotr" errors=0 n=9 res=[11,5,1,44,2,9,-15,36,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 { return out; }
	var tmp = [0; 512];
	let n = g.n;
	for q in n { tmp[(q + ${k}) % n] = g.res[q]; }
	for q in n { g.res[q] = tmp[q]; }
	out.s.clear();
	format(out.s, "rotr");
	out
}
@end

