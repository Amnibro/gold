fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.rn { for b in g.rn - 1 - a { if g.rl[b] > g.rl[b + 1] { let s = g.rl[b]; g.rl[b] = g.rl[b + 1]; g.rl[b + 1] = s; } } }
	out.s.clear();
	format(out.s, "rsort");
	out
}
@end

