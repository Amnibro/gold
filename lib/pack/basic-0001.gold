noun: results
modifier: ascending
context: list
phrase: sort results
phrase: sort the numbers ascending
phrase: sort in ascending order
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="sortasc" errors=0 n=9 res=[-4,0,3,7,8,10,13,25,121] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=0 r=0.0 ok=true s="sortasc" errors=0 n=9 res=[-15,1,2,5,9,11,36,44,100] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.n { for b in g.n - 1 - a { if g.res[b] > g.res[b + 1] { let s = g.res[b]; g.res[b] = g.res[b + 1]; g.res[b + 1] = s; } } }
	out.s.clear();
	format(out.s, "sortasc");
	out
}
@end

