	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if ${t} != 0 && x0 % ${t} == 0 {
			let x = x0 * 2;
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max double divby none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max double divby");
	out
}
@end

