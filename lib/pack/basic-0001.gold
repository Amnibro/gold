@entry 33d5f615b640837b
kind: step
verb: max
noun: results
modifier: below abs
context: aggregate
phrase: maximum of absolute results below {t}
phrase: largest of the absolute values of the numbers less than {t}
slot: t int
test: list=3,-4,10,7,121,0,25,8,13 t=10
expect: => i=8 r=0.0 ok=true s="max abs below" errors=0 n=1 res=[8] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44 t=7
expect: => i=15 r=0.0 ok=true s="max abs below" errors=0 n=1 res=[15] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < ${t} {
			let x = core_abs_val(x0);
			if cnt == 0 || x > acc { acc = x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "max abs below none"); return out; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "max abs below");
	out
}
@end

