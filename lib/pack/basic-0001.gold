	for q in g.n {
		let x0 = g.res[q];
		if x0 < 0 {
			let x = x0;
			if cnt == 0 { acc = x; } else { acc *= x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { acc = 1; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "product negative");
	out
}
@end

