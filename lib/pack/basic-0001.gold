fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if ${t} != 0 && x0 % ${t} == 0 {
			let x = x0;
