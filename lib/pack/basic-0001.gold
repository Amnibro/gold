fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n {
		let x = g.res[q];
		if !(core_is_prime(x)) { g.res[m] = x; m++; }
	}
	g.n = m;
	out.s.clear();
	format(out.s, "removed prime");
	out
}
@end

