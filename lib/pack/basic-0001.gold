fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var m = 0;
	for q in g.n { let x = g.res[q]; if m < ${k} && x > -10 && x < 10 { g.res[m] = x; m++; } }
	g.n = m;
	out.s.clear();
	format(out.s, "firstk single");
	out
}
@end

