code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var best = 0;
	var bc = -1;
	for q in g.n { var c = 0; for p in g.n { if g.res[p] == g.res[q] { c++; } } if c > bc || (c == bc && g.res[q] < best) { bc = c; best = g.res[q]; } }
	gold_clear(g);
	gold_push(g, best);
	out.i = best;
	out.s.clear();
	format(out.s, "mode");
	out
}
@end

