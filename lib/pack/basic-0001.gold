code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var c = 0;
	for q in g.n { var a = core_abs_val(c); var b = core_abs_val(g.res[q]); while b != 0 { let t = a % b; a = b; b = t; } c = a; }
	gold_clear(g);
	gold_push(g, c);
	out.i = c;
	out.s.clear();
	format(out.s, "gcd");
	out
}
@end

