fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for q in g.n {
		let x = g.res[q];
		if core_abs_val(x) >= 10 && core_abs_val(x) <= 99 { g.res[q] = x + ${k}; }
	}
	out.s.clear();
	format(out.s, "addk twodigit");
	out
}
@end

