expect: => i=0 r=0.0 ok=true s="takelast" errors=0 n=4 res=[11,5,1,44] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	let st = if g.n > ${k} { g.n - ${k} } else { 0 };
	for q in g.n - st { g.res[q] = g.res[q + st]; }
	g.n = g.n - st;
	out.s.clear();
	format(out.s, "takelast");
	out
}
@end

