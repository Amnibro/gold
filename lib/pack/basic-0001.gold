context: aggregate
phrase: range of digit summed results
phrase: spread of the digit summed values of the numbers
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=8 r=0.0 ok=true s="range digitsum" errors=0 n=1 res=[8] cache=0 hits=0
test: list=150,-7,22,49,6,33,101,-20
expect: => i=11 r=0.0 ok=true s="range digitsum" errors=0 n=1 res=[11] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if true {
			let x = core_digit_sum(x0);
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range digitsum none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range digitsum");
	out
}
@end

