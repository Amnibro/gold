context: aggregate
phrase: product of palindromic results
phrase: multiply together the numbers that read the same reversed
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=0 r=0.0 ok=true s="product palindrome" errors=0 n=1 res=[0] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=43560 r=0.0 ok=true s="product palindrome" errors=0 n=1 res=[43560] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if core_is_palindrome(x0) {
			let x = x0;
			if cnt == 0 { acc = x; } else { acc *= x; }
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { acc = 1; }
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "product palindrome");
	out
}
@end

