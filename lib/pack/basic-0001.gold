phrase: average of squared odd results
phrase: mean of the squared values of the numbers that are odd
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=3098 r=3098.6 ok=true s="average square odd" errors=0 n=1 res=[3098] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=90 r=90.6 ok=true s="average square odd" errors=0 n=1 res=[90] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 % 2 != 0 {
			let x = x0 * x0;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average square odd none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average square odd");
	out
}
@end

