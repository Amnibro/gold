fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	for a in g.n / 2 { let s = g.res[a]; g.res[a] = g.res[g.n - 1 - a]; g.res[g.n - 1 - a] = s; }
	out.s.clear();
	format(out.s, "reverse");
	out
}
@end

