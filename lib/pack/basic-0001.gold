expect: => i=57 r=0.0 ok=true s="range halve" errors=0 n=1 res=[57] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	var tmp = [0; 512];
	for q in g.n {
		let x0 = g.res[q];
		if true {
			let x = x0 / 2;
			tmp[cnt] = x;
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "range halve none"); return out; }
	var mx = tmp[0];
	var mn = tmp[0];
	for a in cnt { if tmp[a] > mx { mx = tmp[a]; } if tmp[a] < mn { mn = tmp[a]; } }
	acc = mx - mn;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "range halve");
	out
}
@end

