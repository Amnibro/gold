context: list
phrase: take the last {k}
phrase: keep the last {k} results
slot: k int
test: list=3,-4,10,7,121,0,25,8,13 k=3
expect: => i=0 r=0.0 ok=true s="takelast" errors=0 n=3 res=[25,8,13] cache=0 hits=0
