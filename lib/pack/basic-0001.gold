fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if x0 < 10 {
			let x = core_digit_sum(x0);
			tot += x;
			cnt++;
		}
