@entry 0b42133f345e8505
kind: step
verb: average
noun: results
modifier: square digitsum
context: aggregate
phrase: average of digit summed perfect square results
phrase: mean of the digit summed values of the numbers that are perfect squares
test: list=3,-4,10,7,121,0,25,8,13
expect: => i=3 r=3.6666666666666665 ok=true s="average digitsum square" errors=0 n=1 res=[3] cache=0 hits=0
test: list=2,9,-15,36,100,11,5,1,44
expect: => i=5 r=5.0 ok=true s="average digitsum square" errors=0 n=1 res=[5] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var cnt = 0;
	var acc = 0;
	var tot = 0;
	for q in g.n {
		let x0 = g.res[q];
		if core_is_square(x0) {
			let x = core_digit_sum(x0);
			tot += x;
			cnt++;
		}
	}
	if cnt == 0 { gold_fail(g, "no matching results"); out.ok = false; out.s.clear(); format(out.s, "average digitsum square none"); return out; }
	acc = tot / cnt;
	out.r = tot as real / cnt as real;
	gold_clear(g);
	gold_push(g, acc);
	out.i = acc;
	out.s.clear();
	format(out.s, "average digitsum square");
	out
}
@end

