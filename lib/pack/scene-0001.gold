test: d=10.0 h=0.8 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=3 r=0.0 ok=true s="camfront" errors=0 n=0 res=[] cache=0 hits=0
