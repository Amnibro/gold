expect: => doc: key light point 2,-2,3 w300
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	o.push(' ');
	gold_hex(o, ${cr}, ${cg}, ${cb});
	var c = 0;
	for k in g.dn { if gold_dshape(g, k) { gold_dappend(g, k, o); c++; } }
	if c == 0 { gold_fail(g, "no shapes yet"); out.ok = false; return out; }
	out.i = c;
	out.s.clear();
	format(out.s, "allcolor");
	out
}
@end

