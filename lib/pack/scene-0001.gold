code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	var names byte[>..] = [];
	var c = 0;
	for k in g.dn { if gold_dshape(g, k) { if c > 0 { names.push(','); } gold_dword(g, k, names); c++; } }
	if c == 0 { gold_fail(g, "no shapes yet"); out.ok = false; return out; }
	gold_dnew(g, "grp", o);
	o.append(" group ");
	o.append(names);
	gold_doc(g, o);
	out.i = c;
	out.s.clear();
	format(out.s, "group");
	out
}
@end

