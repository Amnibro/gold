expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: front3 camera 0,-10,0.8 0,0,0.8
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "front", "", o);
	o.append(" camera ");
	o.append("0");
	o.append(",-");
	gold_fnum(o, ${d});
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" ");
	o.append("0");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h});
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "camfront");
	out
}
@end

