phrase: posterize the texture into {n} levels
phrase: reduce the texture to {n} grey steps
slot: n int
test: img=16 n=4
expect: => i=256 r=0.0 ok=true s="quantize" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=30855 hash=545176
test: img=8 n=2
expect: => i=64 r=0.0 ok=true s="quantize" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 8x8 min=0 max=1 sum8=7395 hash=943393
test: img=8 n=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => img: 8x8 min=0 max=0.941 sum8=7530 hash=130440
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if ${n} < 2 || ${n} > 16 { gold_fail(g, "levels must be in range"); out.ok = false; return out; }
	for k in g.iw * g.ih {
		var t = (g.img[k] * (${n} as real)) as! int;
		if t > ${n} - 1 { t = ${n} - 1; }
		g.img[k] = (t as real) / ((${n} - 1) as real);
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "quantize");
	out
}
@end

