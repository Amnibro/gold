slot: n int
slot: c int
slot: u int
test: img=32 n=3 c=16 u=5
expect: => i=1024 r=0.0 ok=true s="fbm" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 32x32 min=0.239 max=0.566 sum8=101313 hash=128181
test: img=16 n=2 c=8 u=9
expect: => i=256 r=0.0 ok=true s="fbm" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0.128 max=0.739 sum8=31628 hash=327632
test: img=16 n=6 c=8 u=1
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.941 sum8=30810 hash=58780
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if ${n} < 1 || ${n} > 5 { gold_fail(g, "octaves must be in range"); out.ok = false; return out; }
	var c0 = ${c};
	for o in ${n} { if !gold_img_square(g, c0) { out.ok = false; return out; } c0 = c0 / 2; }
	for y in g.ih {
		for x in g.iw {
			var t = 0.0;
			var amp = 1.0;
			var norm = 0.0;
			var cc = ${c};
			for o in ${n} { t += amp * gold_vnoise(x, y, cc, g.iw / cc, ${u} + o); norm += amp; amp *= 0.5; cc = cc / 2; }
			g.img[y * g.iw + x] = t / norm;
		}
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "fbm");
	out
}
@end

