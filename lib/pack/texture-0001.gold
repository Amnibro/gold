test: img=16
expect: => i=256 r=0.0 ok=true s="normalize" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=1 sum8=32743 hash=802508
test: img=4
expect: => i=16 r=0.0 ok=true s="normalize" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 4x4 min=0 max=1 sum8=1960 hash=70551
test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var mn = g.img[0];
	var mx = g.img[0];
	for k in g.iw * g.ih { if g.img[k] < mn { mn = g.img[k]; } if g.img[k] > mx { mx = g.img[k]; } }
	if mx - mn < 0.000001 { gold_fail(g, "flat texture"); out.ok = false; return out; }
	for k in g.iw * g.ih { g.img[k] = (g.img[k] - mn) / (mx - mn); }
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "normalize");
	out
}
@end

