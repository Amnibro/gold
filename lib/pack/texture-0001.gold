@entry fb57edf77ce3092b
kind: step
verb: measure
noun: texture
modifier: seam
context: texture
phrase: measure the texture seam
phrase: check how well the texture tiles
test: img=16
expect: => i=94 r=0.0 ok=true s="seam" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 16x16 min=0 max=0.941 sum8=30810 hash=58780
test: img=8
expect: => i=92 r=0.0 ok=true s="seam" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 8x8 min=0 max=0.941 sum8=7530 hash=130440
test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var e = 0.0;
	var ne = 0;
	var inn = 0.0;
	var ni = 0;
	for y in g.ih {
		for x in g.iw {
			let p = g.img[y * g.iw + x];
			let r = gold_img_wrap(g, x + 1, y);
			let d = gold_img_wrap(g, x, y + 1);
			if x == g.iw - 1 { e += gold_absr(r - p); ne++; } else { inn += gold_absr(r - p); ni++; }
			if y == g.ih - 1 { e += gold_absr(d - p); ne++; } else { inn += gold_absr(d - p); ni++; }
		}
	}
	var t = 0.0;
	if inn > 0.0 { t = (e / (ne as real)) / (inn / (ni as real)); }
	out.i = round(t * 10.0 * 10.0) as! int;
	out.s.clear();
	format(out.s, "seam");
	return out;
}
@end

