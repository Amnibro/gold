test: img=8
expect: => i=64 r=0.0 ok=true s="slope" errors=0 n=0 res=[] cache=0 hits=0
expect: => img: 8x8 min=0.294 max=0.706 sum8=6858 hash=856105
test:
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	var s2 = g.img;
	for y in g.ih {
		for x in g.iw {
			let gx = gold_absr(gold_img_wrap(g, x + 1, y) - gold_img_wrap(g, x - 1, y));
			let gy = gold_absr(gold_img_wrap(g, x, y + 1) - gold_img_wrap(g, x, y - 1));
			s2[y * g.iw + x] = gold_clamp01((gx + gy) * 0.5);
		}
	}
	g.img = s2;
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "slope");
	out
}
@end

