fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	if !gold_img_ok(g) { out.ok = false; return out; }
	if g.iw < 2 { gold_fail(g, "texture too narrow"); out.ok = false; return out; }
	for y in g.ih {
		for x in g.iw {
			g.img[y * g.iw + x] = (x as real) / ((g.iw - 1) as real);
		}
	}
	out.i = g.iw * g.ih;
	out.s.clear();
	format(out.s, "hgrad");
	out
}
@end

