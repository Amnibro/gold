@entry 0f2cbf9638bb7958
kind: step
verb: add
noun: bone
modifier: leg
context: char
phrase: add a leg chain at hip height {h}
phrase: build a left leg from hip height {h}
slot: h real
test: h=1.0
expect: => i=2 r=0.0 ok=true s="leg" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: thigh1L bone .12,0,1 .12,0,0.5
expect: => doc: shin2L bone .12,0,0.5 .12,0,.05 ^thigh1L
test: h=0.8 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=4 r=0.0 ok=true s="leg" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: thigh3L bone .12,0,0.8 .12,0,0.4
expect: => doc: shin4L bone .12,0,0.4 .12,0,.05 ^thigh3L
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	gold_dnews(g, "thigh", "L", o);
	o.append(" bone .");
	o.append("12");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h});
	o.append(" .");
	o.append("12");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.5);
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "shin", "L", o);
	o.append(" bone .");
	o.append("12");
	o.append(",");
	o.append("0");
	o.append(",");
	gold_fnum(o, ${h} * 0.5);
	o.append(" .");
	o.append("12");
	o.append(",");
	o.append("0");
	o.append(",.");
	o.append("05");
	o.append(" ^");
	o.append("thigh"); format(o, g.dn);
	o.push('L');
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "leg");
	out
}
@end

