	o.append(" empty ");
	gold_fnum(o, ${x});
	o.append(",");
	gold_fnum(o, ${y});
	o.append(",");
	gold_fnum(o, ${z});
	gold_doc(g, o);
	o.clear();
	gold_dnews(g, "ik", "", o);
	o.append(" ik ");
	o.append(last);
	o.append(" ");
	o.append(g.dname);
	gold_doc(g, o);
	out.i = g.dn;
	out.s.clear();
	format(out.s, "ikgoal");
	out
}
@end

