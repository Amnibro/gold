@entry 450eaa8930c97af4
kind: step
verb: build
noun: bone
modifier: spine
context: char
phrase: build a spine of {n} bones from height {a} to {b}
phrase: stack {n} spine bones between {a} and {b}
slot: n int
slot: a real
slot: b real
test: n=3 a=1.0 b=1.6
expect: => i=3 r=0.0 ok=true s="spine" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: spine1 bone 0,0,1 0,0,1.2
expect: => doc: spine2 bone 0,0,1.2 0,0,1.4 ^spine1
expect: => doc: spine3 bone 0,0,1.4 0,0,1.6 ^spine2
test: n=4 a=0.8 b=1.6 doc="ground box 0,0,-.5 20,20,1|crate box 1,2,.5 1,1,1"
expect: => i=4 r=0.0 ok=true s="spine" errors=0 n=0 res=[] cache=0 hits=0
expect: => doc: ground box 0,0,-.5 20,20,1
expect: => doc: crate box 1,2,.5 1,1,1
expect: => doc: spine3 bone 0,0,0.8 0,0,1
expect: => doc: spine4 bone 0,0,1 0,0,1.2 ^spine3
expect: => doc: spine5 bone 0,0,1.2 0,0,1.4 ^spine4
expect: => doc: spine6 bone 0,0,1.4 0,0,1.6 ^spine5
test: n=0 a=1.0 b=2.0
expect: => i=0 r=0.0 ok=false s="" errors=1 n=0 res=[] cache=0 hits=0
code:
fn ${ID}(g Gold&, v Val) Val {
	var out = v;
	var o byte[>..] = [];
	if ${n} < 1 || ${n} > 12 { gold_fail(g, "count out of range"); out.ok = false; return out; }
	var prev byte[>..] = [];
	for q in ${n} {
		let z0 = ${a} + (${b} - ${a}) * q as real / ${n} as real;
		let z1 = ${a} + (${b} - ${a}) * (q + 1) as real / ${n} as real;
		o.clear();
		gold_dnews(g, "spine", "", o);
		o.append(" bone ");
		o.append("0");
		o.append(",");
		o.append("0");
		o.append(",");
		gold_fnum(o, z0);
		o.append(" ");
		o.append("0");
		o.append(",");
		o.append("0");
		o.append(",");
		gold_fnum(o, z1);
		if q > 0 { o.append(" ^"); o.append(prev); }
		gold_doc(g, o);
		prev.clear();
		prev.append(g.dname);
	}
	out.i = ${n};
	out.s.clear();
	format(out.s, "spine");
	out
}
@end

