fn math_gcd(a int, b int) int { var x = if a < 0 { -a } else { a }; var y = if b < 0 { -b } else { b }; while y != 0 { let t = y; y = x % y; x = t; } x }
fn math_lcm(a int, b int) int { if a == 0 || b == 0 { 0 } else { (a * b) / math_gcd(a, b) } }
fn math_fibonacci(n int) int { if n <= 0 { 0 } else if n == 1 { 1 } else { var a = 0; var b = 1; for i in 2..(n + 1) { let c = a + b; a = b; b = c; } b } }
fn math_factorial(n int) int { if n <= 1 { 1 } else { var r = 1; for i in 2..(n + 1) { r *= i; } r } }
fn math_sum_digits(n int) int { var v = if n < 0 { -n } else { n }; var s = 0; while v > 0 { s += v % 10; v /= 10; } s }
fn math_clamp(v int, lo int, hi int) int { if v < lo { lo } else if v > hi { hi } else { v } }
