fn binary_search(xs int[:], target int) int { var lo = 0; var hi = xs.len - 1; var ans = -1; while lo <= hi { let mid = lo + (hi - lo) / 2; if xs[mid] == target { ans = mid; break; } else if xs[mid] < target { lo = mid + 1; } else { hi = mid - 1; } } ans }
fn linear_search(xs int[:], target int) int { var ans = -1; for x, i in xs { if x == target { ans = i; break; } } ans }
