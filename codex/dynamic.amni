fn gcd(a int, b int) int {
	var x = a;
	var y = b;
	while y != 0 {
		let t = x % y;
		x = y;
		y = t;
	}
	x
}
fn lcm(a int, b int) int { a / gcd(a, b) * b }
fn main() {
	print(gcd(1071, 462), " ", lcm(21, 6));
	print(gcd(123456789, 987654321));
}

fn main() {
	let s = "the quick brown fox jumps over the lazy dog";
	var out byte[>..] = [];
	var end = s.len;
	var i = s.len;
	while i > 0 {
		if s[i - 1] == ' ' {
			if out.len > 0 { out.push(' '); }
			out.append(s[i..end]);
			end = i - 1;
		}
		i -= 1;
	}
	if out.len > 0 { out.push(' '); }
	out.append(s[0..end]);
	print(out);
}

